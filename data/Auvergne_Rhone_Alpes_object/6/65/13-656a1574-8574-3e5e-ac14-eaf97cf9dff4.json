  "rdfs:comment": {
    "de": [
      "Schöne Brasserie mit traditionellen Speisen. Ein einziges Motto: frisch und hausgemacht!\r\nGenießen Sie das einzigartige Menu Libre, bei dem Sie eine Vorspeise, ein Hauptgericht und ein Dessert zum kleinen Preis frei wählen können!"
    ],
    "en": [
      "Beautiful brasserie, with traditional catering. Our watchwords are fresh and homemade!\r\nTake advantage of our unique Menu Libre, where you are free to choose a starter, main course and dessert at a low price!"
    ],
    "it": [
      "Bella brasserie, con ristorazione tradizionale. Le nostre parole d'ordine sono: fresco e fatto in casa!\r\nApprofittate del nostro unico Menu Libre, dove potete scegliere un antipasto, un piatto principale e un dessert a un prezzo contenuto!"
    ],
    "fr": [
      "Belle brasserie, avec une restauration traditionnelle. Un seul mot d'ordre : le frais et le fait-maison !\r\nProfitez d'un Menu Libre, Unique en son genre, où vous choisissez librement, une entrée, un plat et un dessert à petit prix !"
    ],
    "es": [
      "Preciosa brasserie, con restauración tradicional. Nuestras consignas son la frescura y la elaboración casera\r\nAproveche nuestro exclusivo Menú Libre, en el que puede elegir un entrante, un plato principal y un postre a bajo precio"
    ],
    "nl": [
      "Mooie brasserie, met traditionele catering. Vers en huisgemaakt zijn onze sleutelwoorden!\r\nProfiteer van ons unieke Menu Libre, waarbij je voor een lage prijs een voor-, hoofd- en nagerecht kunt kiezen!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Lutèce"
    ]
  },
