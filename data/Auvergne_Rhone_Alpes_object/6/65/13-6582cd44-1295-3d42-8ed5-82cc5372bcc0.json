  "rdfs:comment": {
    "de": [
      "Tauchen Sie ein in das Aquariaz, unser Erlebnisbad im Herzen von Avoriaz. Freuen Sie sich auf ein einzigartiges Erlebnis mit wilden Strömungen, einem Außen-Whirlpool mit Bergblick, einem großzügigen Becken und vielen Spielmöglichkeiten für Kinder."
    ],
    "en": [
      "Dive into Aquariaz, our water park in the heart of Avoriaz. Enjoy a unique experience with wild water rivers, an outdoor hot tub with mountain views, a spacious pool, and plenty of fun activities for children."
    ],
    "it": [
      "Venite a fare un tuffo all'Aquariaz, il nostro centro acquatico nel cuore di Avoriaz. Godetevi un'esperienza unica con i nostri fiumi selvaggi, la jacuzzi all'aperto con vista sulle montagne, l'ampia piscina e le numerose attrezzature per bambini."
    ],
    "fr": [
      "Venez plonger à l’Aquariaz, notre centre aqualudique, au cœur d’Avoriaz. Profitez d’une expérience unique avec nos rivières sauvages, notre jacuzzi extérieur avec vue sur la montagne, un bassin spacieux et de nombreux jeux pour enfants."
    ],
    "es": [
      "Ven a zambullirte en Aquariaz, nuestro centro acuático en el corazón de Avoriaz. Disfrute de una experiencia única con nuestros ríos salvajes, jacuzzi al aire libre con vistas a la montaña, amplia piscina y un montón de juegos infantiles."
    ],
    "nl": [
      "Duik in Aquariaz, ons waterpark in het hart van Avoriaz. Geniet van een unieke ervaring met wilde rivieren, een buitenjacuzzi met uitzicht op de bergen, een ruim zwembad en tal van speeltoestellen voor kinderen."
    ]
  },
  "rdfs:label": {
    "en": [
      "Aquariaz Tropical Paradise"
    ],
    "fr": [
      "Aquariaz espace aqualudique"
    ],
    "nl": [
      "Aquariaz watercentrum"
    ]
  },
