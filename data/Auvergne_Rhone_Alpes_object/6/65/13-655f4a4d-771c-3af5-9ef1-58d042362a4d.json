  "rdfs:comment": {
    "de": [
      "Blindtest-Abende in Valence: Treffen Sie uns im L'Esprit M - Bar Resto moto am letzten Donnerstag jedes Monats um 18.00 Uhr, um Ihr Gehör rund um so unterschiedliche Themen wie Filmmusik, Werbung oder auch komische Sketche zu testen..."
    ],
    "en": [
      "Blind test evenings in Valence: join us at L'Esprit M - Bar Resto moto, on the last Thursday of each month at 6:00 pm to test your ears around themes as varied as film music, commercials and comedy sketches..."
    ],
    "it": [
      "Serate blind test a Valence: l'ultimo giovedì di ogni mese alle 18.00, presso L'Esprit M - Bar Resto moto, mettete alla prova le vostre orecchie su una vasta gamma di temi, tra cui musica da film, pubblicità e sketch comici..."
    ],
    "fr": [
      "Soirées blind test à Valence : retrouvez-nous, L'Esprit M - Bar Resto moto, le dernier jeudi de chaque mois à18h00 pour tester votre oreille autour de thématique aussi variée que les musiques de films, les publicités ou encore les sketches comiques..."
    ],
    "es": [
      "Veladas a ciegas en Valence: únase a nosotros en L'Esprit M - Bar Resto moto, el último jueves de cada mes a las 18:00 para poner a prueba sus oídos con una amplia gama de temas, incluyendo música de películas, anuncios y sketches cómicos..."
    ],
    "nl": [
      "Blinde testavonden in Valence: kom op de laatste donderdag van elke maand om 18.00 uur naar L'Esprit M - Bar Resto moto om je oren te testen op verschillende thema's zoals filmmuziek, reclamespots en komische sketches..."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Blind test L'Esprit M (Les jeudis M)"
    ]
  },
