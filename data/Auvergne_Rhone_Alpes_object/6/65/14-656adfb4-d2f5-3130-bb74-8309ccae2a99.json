  "rdfs:comment": {
    "de": [
      "Eine bistronomische Küche in unmittelbarer Nähe des Stadtzentrums von Lens. Ein außergewöhnlicher Rahmen mit einem 3000 m² großen Garten, der für Empfänge im Freien genutzt werden kann. Empfangssäle mit einer Kapazität von 20 bis 250 Gedecken."
    ],
    "en": [
      "A bistronomic cuisine just a step away from the city center of Lens. An exceptional setting with a 3000 m² garden for outdoor receptions. Reception rooms with a capacity of 20 to 250 covers."
    ],
    "it": [
      "Una cucina bistronomica a due passi dal centro di Lens. Un ambiente eccezionale con un giardino di 3.000 m² per ricevimenti all'aperto. Sale per ricevimenti con capacità da 20 a 250 coperti."
    ],
    "fr": [
      "Une cuisine bistronomique à deux pas du centre-ville de  Lens. Un cadre exceptionnel avec un jardin de 3000 m² pouvant recevoir des réceptions de plein air. Salons de réceptions d'une capacité de 20 à 250 couverts."
    ],
    "es": [
      "Una cocina bistronómica a un paso del centro de Lens. Un entorno excepcional con un jardín de 3.000 m² para recepciones al aire libre. Salas de recepción con capacidad de 20 a 250 cubiertos."
    ],
    "nl": [
      "Een bistronomische keuken op een steenworp afstand van het centrum van Lens. Een uitzonderlijk kader met een tuin van 3.000 m² voor recepties in de open lucht. Receptiezalen met een capaciteit van 20 tot 250 couverts."
    ]
  },
