  "rdfs:comment": {
    "de": [
      "Charpey war das Zentrum eines alten, bedeutenden Mandats, zu dem auch das Priorat Saint-Didier, die Komturei Saint-Vincent und das Bauerndorf Bésayes gehörten. Zerstört 1345 während des Bischofskriegs."
    ],
    "en": [
      "Charpey was the center of an important ancient mandement that also included the priory of Saint-Didier, the commandery of Saint-Vincent and the farming village of Bésayes. Destroyed in 1345 during the Episcopal War."
    ],
    "it": [
      "Charpey era il centro di un importante mandement antico che comprendeva anche il priorato di Saint-Didier, la commenda di Saint-Vincent e il villaggio agricolo di Bésayes. Distrutto nel 1345 durante la guerra episcopale."
    ],
    "fr": [
      "Charpey était le centre d’un ancien mandement important comprenant également le prieuré de Saint-Didier, la commanderie de Saint-Vincent et le village agricole de Bésayes. Détruit en 1345 pendant la guerre des épiscopaux."
    ],
    "es": [
      "Charpey era el centro de un importante mandamiento antiguo que incluía también el priorato de Saint-Didier, la comandancia de Saint-Vincent y el pueblo agrícola de Bésayes. Destruido en 1345 durante la guerra episcopal."
    ],
    "nl": [
      "Charpey bestaat uit twee dorpen: het cirkelvormige dorp Charpey op de heuvel en St-Didier. De straatjes slingeren in kringen rond de heuvel naar het uitzichtpunt op de top, waar men een mooi uitzicht heeft op de vlakte en de Monts du Matin."
    ]
  },
