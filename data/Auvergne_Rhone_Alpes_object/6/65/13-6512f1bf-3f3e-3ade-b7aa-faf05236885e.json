  "rdfs:comment": {
    "de": [
      "Herbulathêkê bietet Ihnen Animationen zum Thema Wildpflanzen an: immersive und partizipative Aktivitäten, die das pflanzliche Erbe feiern, das Bewusstsein für die biologische Vielfalt schärfen und das Gebiet aufwerten."
    ],
    "en": [
      "Herbulathêkê offers activities on the theme of wild plants: immersive, participatory activities that celebrate plant heritage, raise awareness of biodiversity and enhance the value of the region."
    ],
    "it": [
      "Herbulathêkê offre una serie di attività sul tema delle piante selvatiche: attività coinvolgenti e partecipative che celebrano il nostro patrimonio vegetale, sensibilizzano alla biodiversità e promuovono la regione."
    ],
    "fr": [
      "Herbulathêkê vous propose des animations sur le thème des plantes sauvages : des activités immersives et participatives qui célèbrent le patrimoine végétal, sensibilisent à la biodiversité et valorisent le territoire."
    ],
    "es": [
      "Herbulathêkê ofrece una serie de actividades sobre el tema de las plantas silvestres: actividades inmersivas y participativas que celebran nuestro patrimonio vegetal, sensibilizan sobre la biodiversidad y promocionan la región."
    ],
    "nl": [
      "Herbulathêkê biedt een reeks activiteiten rond het thema wilde planten: meeslepende, participatieve activiteiten die ons plantenerfgoed vieren, het bewustzijn over biodiversiteit vergroten en de regio promoten."
    ]
  },
