  "rdfs:comment": {
    "de": [
      "Diese befestigte Kirche ist von April bis Oktober an Wochenenden und Feiertagen geöffnet. Sie ist ganz aus Backstein und hat an den Ecken der Fassade zwei imposante Türmchen mit Schießscharten."
    ],
    "en": [
      "Fortified church open on weekends and holidays from April to October. It is made of brick and has two imposing towers with loopholes at the corners of the façade."
    ],
    "it": [
      "Chiesa fortificata aperta nei fine settimana e nei giorni festivi da aprile a ottobre. Realizzata in mattoni, presenta due imponenti torrette con feritoie agli angoli della facciata."
    ],
    "fr": [
      "Église fortifiée ouverte les week-ends et jours fériés d'Avril à Octobre. Toute de briques, elle comprend aux angles de la façade : deux imposantes tourelles avec meurtrières."
    ],
    "nl": [
      "Versterkte kerk open in het weekend en op feestdagen van april tot oktober. Het is gemaakt van baksteen en heeft twee imposante torentjes met schietgaten op de hoeken van de gevel."
    ],
    "es": [
      "Iglesia fortificada abierta los fines de semana y los días festivos de abril a octubre. De ladrillo, tiene dos imponentes torretas con aspilleras en las esquinas de la fachada."
    ]
  },
  "rdfs:label": {
    "fr": [
