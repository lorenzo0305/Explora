  "rdfs:comment": {
    "de": [
      "Unser talentierter Küchenchef stellt Ihnen leckere Rezepte aus marktfrischen Produkten zusammen. Er wird Sie mit kreativen und regionalen Gerichten überraschen.\nIm Sommer Restauration am Pool."
    ],
    "en": [
      "Our talented chef prepares tasty recipes using fresh market produce. He will surprise you with creative, regional dishes."
    ],
    "it": [
      "Il nostro talentuoso chef prepara ricette gustose utilizzando prodotti freschi del mercato. Vi sorprenderà con piatti regionali creativi.\nIn estate è possibile cenare a bordo piscina."
    ],
    "fr": [
      "Notre talentueux chef de cuisine vous compose de savoureuses recettes à base de produits frais du marché. Il vous surprendra avec des plats créatifs et régionaux.\nEn été restauration au bord de la piscine."
    ],
    "nl": [
      "Onze getalenteerde chef bereidt smakelijke recepten met verse producten van de markt. Hij zal je verrassen met creatieve, regionale gerechten."
    ],
    "es": [
      "Nuestro talentoso chef prepara sabrosas recetas con productos frescos del mercado. Le sorprenderá con creativos platos regionales.\nEn verano, podrá cenar junto a la piscina."
    ]
  },
