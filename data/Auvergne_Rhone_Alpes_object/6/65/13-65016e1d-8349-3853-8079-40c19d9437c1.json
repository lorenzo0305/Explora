  "rdfs:comment": {
    "de": [
      "Das Hotel les Cimes ist ein kleines, charmantes Boutique-Hotel im Herzen des hübschen Dorfes Megève. Es ist ein \"Familienhotel\" mit einer gemütlichen, kuscheligen Atmosphäre und persönlichen Akzenten. Sie werden sich wie zu Hause fühlen. Home from home!"
    ],
    "en": [
      "Hotel les Cimes is a small, charming boutique hotel in the heart of the pretty village of Megève. It's a “family” hotel with a welcoming, cosy atmosphere and personal touches. You'll feel right at home. Home from home!"
    ],
    "it": [
      "L'hotel les Cimes è un piccolo albergo di fascino situato nel cuore del grazioso borgo di Megève. È un hotel \"familiare\" con un'atmosfera accogliente e confortevole e qualche tocco personale. Vi sentirete come a casa vostra. Home from home!"
    ],
    "fr": [
      "L'hôtel les Cimes est un petit boutique hôtel charmant en plein coeur du joli village de Megève. C'est un hôtel \"familial\" avec une atmosphère accueillante et douillette et des touches personnelles. Vous serez comme chez vous. Home from home!"
    ],
    "nl": [
      "Hotel les Cimes is een klein, charmant boetiekhotel in het hart van het mooie dorpje Megève. Het is een 'familie' hotel met een gastvrije, gezellige sfeer en persoonlijke accenten. Je voelt je er meteen thuis. Thuis van huis!"
    ],
    "es": [
      "El Hotel les Cimes es un pequeño y encantador hotel boutique situado en el corazón del bonito pueblo de Megève. Es un hotel \"familiar\" con un ambiente acogedor y toques personales. Se sentirá como en casa. Como en casa"
    ]
  },
