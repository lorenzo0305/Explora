  "rdfs:comment": {
    "de": [
      "Hermillon genießt ein ausgezeichnetes Klima, dessen beste Zeugen die Weinberge sind, die sich an den Hängen des Châtel hinaufziehen."
    ],
    "en": [
      "Hermillon enjoys an excellent climate, best exemplified by the vines that climb the slopes of Châtel."
    ],
    "it": [
      "Hermillon gode di un clima eccellente, esemplificato al meglio dalle viti che si arrampicano sui pendii di Châtel."
    ],
    "fr": [
      "Hermillon bénéficie d’un excellent climat dont les meilleurs témoins sont les vignes qui grimpent le long des pentes du Châtel."
    ],
    "es": [
      "Hermillon se beneficia de un clima excelente, cuya mejor prueba son las vides que trepan por las laderas del Châtel."
    ],
    "nl": [
      "Hermillon geniet van een uitstekend klimaat, dat het best wordt geïllustreerd door de wijnstokken die de hellingen van Châtel beklimmen."
    ]
  },
