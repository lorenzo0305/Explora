  "rdfs:comment": {
    "de": [
      "Das Hôtel des Sables ist die ideale Wahl für Gäste, die Ruhe mit einer günstigen Lage verbinden möchten, um das Beaujolais zu erkunden."
    ],
    "en": [
      "The Hôtel des Sables is the ideal choice for guests who want to combine tranquillity with a convenient location to discover the Beaujolais region."
    ],
    "it": [
      "L'Hôtel des Sables è la scelta ideale per gli ospiti che desiderano combinare la tranquillità con una posizione comoda per scoprire la regione del Beaujolais."
    ],
    "fr": [
      "L'Hôtel des Sables représente le choix idéal pour des clients qui veulent allier la tranquillité à un emplacement pratique pour découvrir le Beaujolais."
    ],
