  "rdfs:comment": {
    "de": [
      "Mehrere lokale Bauernhöfe organisieren die Abholung einer Bio-Kiste, die jede Woche bestellt und jeden Freitag in der Brasserie de la Matheysine abgeholt werden kann."
    ],
    "en": [
      "Several local farms organize collect of an organic crate to be ordered each week and to pick up every friday at La Brasserie Matheysine"
    ],
    "it": [
      "Diverse fattorie organizzano la raccolta di una cassa bio da ordinare ogni settimane e da ritirare ogni martedi alla birreria \"la Brasserie Matheysine\""
    ],
    "fr": [
      "Plusieurs  fermes locales organisent le retrait d'une cagette bio, à commander chaque semaine et à venir récupérer tous les vendredis, à la Brasserie de la Matheysine."
    ],
    "es": [
      "Varias granjas locales organizan la recogida de una caja de productos ecológicos, que se encargará cada semana y se recogerá todos los viernes en la Brasserie de la Matheysine."
    ],
    "nl": [
      "Een aantal lokale boerderijen organiseren de inzameling van een krat biologische producten, die elke week worden besteld en elke vrijdag worden opgehaald in de Brasserie de la Matheysine."
    ]
  },
