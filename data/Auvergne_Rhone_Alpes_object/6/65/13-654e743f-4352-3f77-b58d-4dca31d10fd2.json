  "rdfs:comment": {
    "de": [
      "VAN-AWAY Drôme bietet das Ferienhaus auf 4 Rädern! Erleben Sie das Abenteuer in der Natur, in aller Freiheit und zu jeder Jahreszeit!\r\nReisen Sie in Ihrem eigenen Rhythmus an Bord unserer Vans, umgebauten Kastenwagen und Dachzelte, zu zweit, mit der Familie oder mit Freunden!"
    ],
    "en": [
      "VAN-AWAY Drôme offers vacation homes on 4 wheels! Experience adventure in the great outdoors, in complete freedom, whatever the season!\r\nTravel at your own pace aboard our vans, converted vans and roof tents, with your partner, family or friends!"
    ],
    "it": [
      "VAN-AWAY Drôme propone la casa delle vacanze su 4 ruote! Vivete l'avventura in mezzo alla natura, in totale libertà, in qualsiasi stagione!\r\nViaggiate al vostro ritmo nei nostri furgoni, nei furgoni trasformati e nelle tende sul tetto, in coppia, con la famiglia o con gli amici!"
    ],
    "fr": [
      "VAN-AWAY Drôme propose la maison de vacances sur 4 roues ! Vivez l’aventure en pleine nature, en toute liberté, en toute saison !\r\nVoyagez à votre rythme à bord de nos vans, fourgons aménagés et tentes de toit, en couple, en famille et entre amis !"
    ],
    "es": [
      "¡VAN-AWAY Drôme propone la casa de vacaciones sobre 4 ruedas! ¡Vive la aventura en plena naturaleza, en total libertad, en cualquier estación del año!\r\nViaje a su ritmo en nuestras furgonetas, furgonetas transformadas y tiendas de campaña, en pareja, en familia o con amigos"
    ],
    "nl": [
      "VAN-AWAY Drôme biedt vakantiehuizen op 4 wielen! Beleef het avontuur in de vrije natuur, in alle vrijheid, ongeacht het seizoen!\r\nReis op je eigen tempo in onze busjes, omgebouwde busjes en daktenten, met je partner, familie of vrienden!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Van-Away Drôme"
    ]
  },
