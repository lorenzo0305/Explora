  "rdfs:comment": {
    "de": [
      "In diesem Café mit Bistro-Atmosphäre, auf der Veranda oder an sonnigen Tagen auf der Holzterrasse können Sie das Herz des Dorfes entdecken, in dem sich Einheimische und Besucher treffen."
    ],
    "en": [
      "A true heart of the village where locals and visitors mingle, sit down in this café with its bistro atmosphere, on the veranda or on the wooden terrace in fine weather."
    ],
    "it": [
      "Cuore del villaggio, dove si mescolano abitanti e visitatori, questo caffè offre un'atmosfera da bistrot, nella veranda o sulla terrazza in legno nella bella stagione."
    ],
    "fr": [
      "Véritable cœur du village où se mêlent les habitants du village et visiteurs, installez vous dans ce café à l'ambiance bistrot, la véranda ou sur la terrasse en bois aux beaux jours."
    ],
    "es": [
      "En el corazón del pueblo, donde se mezclan lugareños y visitantes, este café ofrece un ambiente de bistró, en la veranda o en la terraza de madera cuando hace buen tiempo."
    ],
    "nl": [
      "Dit café is het hart van het dorp, waar plaatselijke bewoners en bezoekers elkaar ontmoeten, en heeft een bistrosfeer, op de veranda of op het houten terras bij mooi weer."
    ]
  },
