  "rdfs:comment": {
    "de": [
      "In Allègre findet ein Rennen oder eher mehrere Rennen statt (Wandern, Reiten, Canicross, Trail Off, Bike & Run, Mountainbike, Straßenradsport). Aber Rennen der etwas anderen Art: ohne Zeitmessung oder Rangliste, Entspannung pur."
    ],
    "en": [
      "In Allègre, a race, or rather a series of races (hiking, equestrian, canicross, trail off, bike & run, mountain biking, road cycling). But these races are a bit special: no timing, no rankings, just pure relaxation."
    ],
    "it": [
      "Ad Allègre, una gara, o meglio una serie di gare (escursionismo, equitazione, canicross, trail off, bike & run, mountain bike, ciclismo su strada). Ma queste gare sono un po' speciali: niente tempi, niente classifiche, solo puro relax."
    ],
    "fr": [
      "À Allègre, une course ou plutôt des courses (randonnée pédestre, randonnée équestre, canicross, trail off, bike & run, VTT, cyclisme sur route). Mais des courses un peu particulières : sans chronométrage ni classement, de la détente pure."
    ],
    "nl": [
      "In Allègre, een race, of eigenlijk een reeks races (wandelen, paardrijden, canicross, trail off, bike & run, mountainbiken, wielrennen op de weg). Maar deze wedstrijden zijn een beetje speciaal: geen timing, geen klassementen, gewoon pure ontspanning."
    ],
    "es": [
      "En Allègre, una carrera, o más bien una serie de carreras (senderismo, equitación, canicross, trail off, bike & run, bicicleta de montaña, ciclismo de carretera). Pero estas carreras son un poco especiales: no hay cronometraje, no hay clasificaciones, solo pura relajación."
    ]
  },
  "rdfs:label": {
    "fr": [
      "« La Cool & Verte », journée sportive à Allègre"
    ]
  },
