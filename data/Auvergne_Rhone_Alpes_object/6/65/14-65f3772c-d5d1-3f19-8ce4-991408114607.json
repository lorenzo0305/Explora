      "dc:description": {
        "de": [
          "Lust auf eine andere Art zu malen? Dieser Workshop lädt Kinder und Erwachsene dazu ein, die Kunst mit den Farben und Pinseln der Natur zu erforschen!"
        ],
        "en": [
          "Want to paint differently? This workshop invites children and adults to explore art with the colors and brushes of nature!"
        ],
        "it": [
          "Volete dipingere in modo diverso? Questo laboratorio invita bambini e adulti a esplorare l'arte con i colori e i pennelli della natura!"
        ],
        "fr": [
          "Envie de peindre autrement ? Cet atelier invite enfants et adultes à explorer l’art avec les couleurs et les pinceaux de la nature !"
        ],
        "es": [
          "¿Quieres pintar de otra manera? Este taller invita a niños y adultos a explorar el arte con los colores y pinceles de la naturaleza"
        ],
        "nl": [
          "Wil je op een andere manier schilderen? Deze workshop nodigt kinderen en volwassenen uit om kunst te ontdekken met de kleuren en penselen van de natuur!"
        ]
      },
