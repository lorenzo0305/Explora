  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/87935181-567c-32f1-82b2-632135cae798",
      "dc:description": {
        "de": [
          "Spezialisiert auf Fahrzeugreparaturen.\n\nInformationen:\n\nTage der Öffnung:\nTäglich von 9:30 bis 12:30 Uhr und von 14:00 bis 19:00 Uhr\n\nReservierung:\nKostenvoranschlag und Terminvereinbarung per Telefon unter 03 21 16 49 13 oder 06 19 31 40 81 oder per E-Mail an: ddrepar@outlook.fr\n "
        ],
        "en": [
          "Specialized in vehicle repairs.\n\nFor further information:\n\nOpening days:\nDaily from 9:30 to 12:30 and from 14:00 to 19:00\n\nBookings:\nQuotations and appointments by telephone on 03 21 16 49 13 or 06 19 31 40 81 or by e-mail at the following address: ddrepar@outlook.fr\n "
        ],
        "it": [
          "Specializzato nella riparazione di veicoli.\n\nPer ulteriori informazioni:\n\nGiorni di apertura:\nTutti i giorni dalle 9.30 alle 12.30 e dalle 14.00 alle 19.00\n\nPrenotazioni:\nPreventivi e appuntamenti per telefono al numero 03 21 16 49 13 o 06 19 31 40 81 o per e-mail all'indirizzo ddrepar@outlook.fr\n "
        ],
        "fr": [
          "Spécialisé dans les réparations de véhicule.\n\nInformations:\n\nJours d'ouverture:\nTous les jours de 9h30 à 12h30 et de 14h à 19h\n\nRéservation:\nDevis et rendez-vous par téléphone au 03 21 16 49 13 ou au 06 19 31 40 81 ou par mail à l'adresse suivante: ddrepar@outlook.fr\n "
        ],
        "nl": [
          "Gespecialiseerd in autoreparaties.\n\nVoor meer informatie:\n\nOpeningsdagen:\nElke dag van 9.30 tot 12.30 uur en van 14.00 tot 19.00 uur\n\nBoekingen:\nOffertes en afspraken per telefoon op 03 21 16 49 13 of 06 19 31 40 81 of per e-mail op het volgende adres: ddrepar@outlook.fr\n "
        ],
        "es": [
          "Especializada en la reparación de vehículos.\n\nPara más información:\n\nDías de apertura:\nTodos los días de 9.30 a 12.30 y de 14.00 a 19.00\n\nReservas:\nPresupuestos y citas por teléfono en el 03 21 16 49 13 o en el 06 19 31 40 81 o por correo electrónico en la siguiente dirección: ddrepar@outlook.fr\n "
        ]
      },
