  "rdfs:comment": {
    "de": [
      "Diese Route, die in Maillet - Haut-Bocage beginnt, bietet eine technisch anspruchsvollere Wanderung, bei der sich Feldwege, Passagen über Felder und bewaldete Gebiete abwechseln. Diese dynamische Route ist ideal für sportliche Wanderer."
    ],
    "en": [
      "Leaving from Maillet - Haut-Bocage, this route offers a more technical walk alternating dirt tracks, field passages and wooded areas. A dynamic itinerary, it is ideal for sporty hikers."
    ],
    "it": [
      "Partendo da Maillet - Haut-Bocage, si tratta di un percorso più tecnico che alterna sentieri sterrati, attraversamenti di campi e boschi. Questo percorso dinamico è ideale per gli escursionisti sportivi."
    ],
    "fr": [
      "Ce parcours au départ de Maillet - Haut-Bocage, propose une balade plus technique qui alterne chemins de terre, passages en champs et zone boisée. Itinéraire dynamique, il est idéal pour les randonneurs sportifs."
    ],
    "nl": [
      "Vertrekkend vanuit Maillet - Haut-Bocage, is dit een meer technische route die onverharde paden, veldovergangen en bossen afwisselt. Deze dynamische route is ideaal voor sportieve wandelaars."
    ],
    "es": [
      "Partiendo de Maillet - Haut-Bocage, se trata de una ruta más técnica que alterna pistas de tierra, cruces de campos y bosques. Esta ruta dinámica es ideal para los senderistas deportistas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "PR7 Sur le Chemin de Montavent - Maillet"
    ]
  },
