  "rdfs:comment": {
    "de": [
      "Traditionelle Restauration, Tagesmenü von Montag bis Freitag, kein À-la-carte-Service außer auf Bestellung.\r\nUnabhängige Gästezimmer mit privatem Zugang und Verpflegung vor Ort möglich.\r\nTerrasse und privater Parkplatz.\r\nBlick auf die Loire."
    ],
    "en": [
      "Traditional restaurant, daily menu from Monday to Friday, no à la carte service except on order. \r\nIndependent guest rooms with private access and catering possible. \r\nTerrace and private parking.\r\nView on the Loire River."
    ],
    "it": [
      "Ristorante tradizionale, menu giornaliero dal lunedì al venerdì, senza servizio à la carte se non su ordinazione.\r\nDisponibilità di camere indipendenti con accesso privato e ristorazione in loco.\r\nTerrazza e parcheggio privato.\r\nVista sulla Loira."
    ],
    "fr": [
      "Restauration traditionnelle, menu du jour du lundi au vendredi, pas de service à la carte sauf sur commande. \r\nChambres d'hôtes indépendantes avec accès privé et restauration possible sur place. \r\nTerrasse et Parking privé.\r\nVue sur la Loire."
    ],
    "nl": [
      "Traditioneel restaurant, dagmenu van maandag tot vrijdag, geen à la carte service behalve op bestelling.\r\nOnafhankelijke gastenkamers met privétoegang en catering ter plaatse beschikbaar.\r\nTerras en privé parkeerplaats.\r\nUitzicht over de Loire."
    ],
    "es": [
      "Restaurante tradicional, menú diario de lunes a viernes, sin servicio a la carta salvo por encargo.\r\nHabitaciones independientes con acceso privado y servicio de restauración in situ.\r\nTerraza y aparcamiento privado.\r\nVistas al Loira."
    ]
  },
  "rdfs:label": {
    "en": [
      "Auberge du Barrage"
    ],
    "fr": [
      "Auberge du Barrage"
    ]
  },
