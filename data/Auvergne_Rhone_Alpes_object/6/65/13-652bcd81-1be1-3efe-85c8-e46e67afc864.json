  "rdfs:comment": {
    "de": [
      "Pasta Ugo empfängt Sie mit einem Lächeln in einem gemütlichen Rahmen, um Ihnen Gerichte mit italienischem Geschmack zu präsentieren. Vor Ort oder zum Mitnehmen."
    ],
    "en": [
      "Pasta Ugo welcomes you with a smile in a warm setting to help you discover dishes with the flavors of Italy. On the spot or to take away."
    ],
    "it": [
      "Pasta Ugo vi accoglie con un sorriso e un caloroso benvenuto per scoprire piatti dal sapore italiano. Sul posto o da asporto."
    ],
    "fr": [
      "Pasta Ugo vous accueille avec le sourire dans un cadre chaleureux afin de vous faire découvrir des plats aux saveurs d'Italie. Sur place ou à emporter."
    ],
    "nl": [
      "Pasta Ugo verwelkomt je met een glimlach en een warm welkom om gerechten met een Italiaans tintje te ontdekken. Ter plaatse of om mee te nemen."
    ],
    "es": [
      "Pasta Ugo le recibe con una sonrisa y una cálida bienvenida para descubrir platos con sabor italiano. En el momento o para llevar."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant Pasta Ugo"
    ]
  },
