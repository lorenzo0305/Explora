  "rdfs:comment": {
    "de": [
      "Das Museum wird heute vollständig von Freiwilligen des Verbands für Naturgeschichte geführt. In den Mauern des Museums befinden sich Tausende von Arten: Tiere, Insekten, Mollusken ..., die von begeisterten Amateuren gesammelt werden.\r\nKostenlose Führungen."
    ],
    "en": [
      "The Museum is now run entirely by volunteers from the Fédération d'Histoire Naturelle. Within its walls are thousands of species: animals, insects, molluscs - all collected by enthusiastic amateurs.\r\nFree guided tours."
    ],
    "it": [
      "Il Museo è oggi interamente gestito dai volontari della Federazione di storia naturale. Migliaia di specie all'interno del Museo: animali, insetti, molluschi... collezionati da appassionati.\r\nVisite guidate gratuite."
    ],
    "fr": [
      "Le Museum est aujourd'hui entièrement géré par des bénévoles de la Fédération d'histoire naturelle. Dans les murs du musée, des milliers d'espèces : animaux, insectes, mollusques ... collectionnées par des amateurs passionnés.\r\nVisites guidées gratuites."
    ],
    "nl": [
      "Het museum wordt nu volledig gerund door vrijwilligers van de Natuurhistorische Federatie. Binnen de muren van het museum, duizenden soorten: dieren, insecten, weekdieren ... verzameld door gepassioneerde amateurs.\r\nGratis rondleidingen."
    ],
    "es": [
      "En la actualidad, el Museo está gestionado íntegramente por voluntarios de la Federación de Historia Natural. Entre las paredes del museo, miles de especies: animales, insectos, moluscos... recogidos por aficionados apasionados.\r\nVisitas guiadas gratuitas."
    ]
  },
