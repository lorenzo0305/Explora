  "rdfs:comment": {
    "de": [
      "Dies ist der Restaurantbereich im Park La Fontaine Minérale. Aperitifbretter, Pommes frites, Braséro (Gerichte zum Teilen oder für Einzelpersonen), Salate, Eis und Waffeln. Eine gesellige Küche, die man frei im Park mit seinen Bäumen genießen kann."
    ],
    "en": [
      "This is the dining area of La Fontaine Minérale park. Appetiser platters, chips, brazier (dishes to share or individual portions), salads, ice cream and waffles. Friendly cuisine to enjoy at your leisure in the wooded park."
    ],
    "it": [
      "È il punto di ristoro del parco La Fontaine Minérale. Tavoli da aperitivo, patatine, brasero (piatti da condividere o individuali), insalate, gelati e cialde. Una cucina conviviale da gustare liberamente nel parco alberato."
    ],
    "fr": [
      "C’est l’espace de restauration du parc de La Fontaine Minérale. Planches apéritives, friterie, braséro (plats à partager ou individuels), salades, glaces et gaufres. Une cuisine conviviale à savourer librement dans le parc arboré."
    ],
    "es": [
      "Se trata del patio de comidas del parque de La Fontaine Minérale. Tablas de aperitivos, chip shop, brasero (platos para compartir o individuales), ensaladas, helados y gofres. Una cocina acogedora para disfrutar libremente en el parque arbolado."
    ],
    "nl": [
      "Dit is het eetplein in het park La Fontaine Minérale. Aperitiefplanken, frietkraam, brasero (gerechten om te delen of individueel), salades, ijsjes en wafels. Een gezellige keuken om vrij van te genieten in het bosrijke park."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Halle gourmande du parc de la fontaine Minérale"
    ]
  },
