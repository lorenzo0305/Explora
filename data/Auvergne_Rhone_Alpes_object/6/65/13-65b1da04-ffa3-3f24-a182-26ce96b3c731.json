  "rdfs:comment": {
    "de": [
      "Besichtigung der Ziegenzucht und Verkauf von Käse auf dem Bauernhof nach Vereinbarung. La Ferme des Vérités züchtet Anglo-Nubische und Alpine Ziegen und produziert reinen Ziegenkäse. Auf dem Markt von Lapalisse vertreten. Tag der offenen Tür am 14. Juni 2026."
    ],
    "en": [
      "Farm visit and sale of cheeses by appointment. The Truths Farm breeds anglo-nubienne and alpine goats, and produces goat's cheese. On Lapalisse market. Open day on June 15th."
    ],
    "it": [
      "Visite alla fattoria e vendita di formaggi su appuntamento. La Ferme des Vérités alleva capre anglo-nubiane e alpine e produce formaggio di puro latte di capra. Presente al mercato di Lapalisse. Apertura il 14 giugno 2026."
    ],
    "fr": [
      "Visite de l'élevage et vente de fromage à la ferme sur rendez-vous. La Ferme des Vérités élève des chèvres anglo-nubiennes et alpines, et produit des fromages pur chèvre. Présent sur le marché de Lapalisse. Portes ouvertes le 14 juin 2026."
    ],
    "es": [
      "Visitas a la granja y venta de queso con cita previa. La Ferme des Vérités cría cabras anglo-nubias y alpinas y produce queso puro de leche de cabra. Presente en el mercado de Lapalisse. Jornada de puertas abiertas el 14 de junio de 2026."
    ],
    "nl": [
      "Bezoek aan de boerderij en verkoop van kaas op afspraak. La Ferme des Vérités fokt Anglo-Nubische en Alpine geiten en produceert zuivere geitenkaas. Aanwezig op de markt van Lapalisse. Open huis op 14 juni 2026."
    ]
  },
  "rdfs:label": {
    "en": [
      "Truths Farm"
    ],
    "fr": [
      "Ferme des Vérités"
    ]
  },
