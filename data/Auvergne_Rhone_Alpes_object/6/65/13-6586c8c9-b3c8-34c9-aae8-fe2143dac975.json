  "rdfs:comment": {
    "de": [
      "Die Kirche Saint-Jean-la-Salvetat wurde im 12. Jahrhundert wieder aufgebaut und ist der Überrest einer alten Komturei der Malteserritter."
    ],
    "en": [
      "The church of Saint-Jean-la-Salvetat, rebuilt in the 12th century, is part of a former Commandery of the Knights of Malta."
    ],
    "it": [
      "La chiesa di Saint-Jean-la-Salvetat, ricostruita nel XII secolo, è ciò che resta di un'antica commenda dei Cavalieri di Malta."
    ],
    "fr": [
      "L’église Saint-Jean-la-Salvetat, reconstruite au XIIe siècle, est le vestige d'une ancienne commanderie des Chevaliers de Malte."
    ],
    "es": [
      "La iglesia de Saint-Jean-la-Salvetat, reconstruida en el siglo XII, son los restos de una antigua encomienda de los Caballeros de Malta."
    ],
    "nl": [
      "De kerk Saint-Jean la Salvetat, herbouwd in de 12e eeuw, maakt deel uit van een voormalige commanderij van de Orde van Malta."
    ]
  },
