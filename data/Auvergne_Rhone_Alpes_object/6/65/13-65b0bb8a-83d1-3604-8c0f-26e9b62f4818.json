  "rdfs:comment": {
    "de": [
      "Qualitätsgrillfleisch, leckere Rezepte, um den Geschmack eines legendären Amerikas wiederzufinden. Menüs zu erschwinglichen Preisen. Eine Karte mit Burgergerichten. Ein Spielzimmer für Kinder."
    ],
    "en": [
      "Quality grilling, tasty recipes for a taste of legendary America. Menus at affordable prices. A burger menu. A children's playroom."
    ],
    "it": [
      "Carni alla griglia di qualità, ricette gustose per un assaggio della leggendaria America. Menu a prezzi accessibili. Un menu di hamburger. Una sala giochi per bambini."
    ],
    "fr": [
      "La grillade de qualité, des recettes savoureuses pour retrouver le goût d'une Amérique de légende. Des menus à des prix accessibles. Une carte de burgers. Une salle de jeux pour les enfants."
    ],
    "nl": [
      "Kwaliteitsgegrild vlees, smakelijke recepten voor een voorproefje van het legendarische Amerika. Menu's tegen betaalbare prijzen. Een hamburgermenu. Een speelkamer voor kinderen."
    ],
    "es": [
      "Carnes a la parrilla de calidad, sabrosas recetas para saborear la América legendaria. Menús a precios asequibles. Una carta de hamburguesas. Una sala de juegos para niños."
    ]
  },
  "rdfs:label": {
