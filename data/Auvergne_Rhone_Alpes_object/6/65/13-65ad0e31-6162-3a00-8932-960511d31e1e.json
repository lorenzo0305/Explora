  "rdfs:comment": {
    "de": [
      "Chez mémé, die wiedergefundene Vergangenheit. Wir lieben es, eine neu konzipierte, schmackhafte und großzügige traditionelle Küche zu teilen."
    ],
    "en": [
      "Chez mémé, the past rediscovered. Magnified tastes, respected products, revisited recipes, we like to share a traditional cuisine rethought, tasty and generous."
    ],
    "it": [
      "Chez mémé, il passato ritrovato. Gusti amplificati, prodotti rispettati, ricette rivisitate, ci piace condividere una cucina tradizionale ripensata, gustosa e generosa."
    ],
    "fr": [
      "Chez mémé, le passé retrouvé. Goûts magnifiés, produits respectés, recettes revisitées, on aime partager une cuisine traditionnelle repensée, savoureuse et généreuse."
    ],
    "nl": [
      "Chez mémé, het verleden herontdekt. Vergrote smaken, gerespecteerde producten, herziene recepten, wij delen graag een heroverwogen traditionele keuken, smakelijk en genereus."
    ],
    "es": [
      "Chez mémé, el pasado redescubierto. Gustos magnificados, productos respetados, recetas revisitadas, nos gusta compartir una cocina tradicional repensada, sabrosa y generosa."
    ]
  },
  "rdfs:label": {
