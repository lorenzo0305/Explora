  "rdfs:comment": {
    "de": [
      "Neues Restaurant des Sushi-Meisters Dai Hosaka, ehemaliger Chefkoch des Tonkin in Valence.\r\nSushi, Maki, Poke Bowls und japanisches Bier werden Ihren Gaumen erfreuen! Alles wird am selben Tag vor Ort gekocht und ist nur zum Mitnehmen erhältlich."
    ],
    "en": [
      "New restaurant from Sushi Master Dai Hosaka, former head chef at Le Tonkin in Valence.\r\nSushi, maki, poke bowls and Japanese beer to delight your taste buds! Everything is cooked the same day on site and available to take away only."
    ],
    "it": [
      "Il nuovo ristorante del maestro di sushi Dai Hosaka, ex capo chef di Le Tonkin a Valence.\r\nSushi, maki, poke bowl e birra giapponese per deliziare il vostro palato! Tutto viene cucinato il giorno stesso sul posto ed è disponibile solo per l'asporto."
    ],
    "fr": [
      "Nouveau restaurant du Maître Sushi Dai Hosaka, ancien chef cuisinier du Tonkin à Valence. \r\nDes sushis, des makis, des poke bowls et de la bière japonaise pour ravir vos papilles ! Tout est cuisiné le jour même sur place et uniquement à emporter."
    ],
    "es": [
      "Nuevo restaurante del maestro del sushi Dai Hosaka, antiguo jefe de cocina de Le Tonkin en Valence.\r\nSushi, makis, poke bowls y cerveza japonesa para deleitar su paladar. Todo se cocina el mismo día en el mismo local y sólo está disponible para llevar."
    ],
    "nl": [
      "Nieuw restaurant van sushimeester Dai Hosaka, voormalig chef-kok bij Le Tonkin in Valence.\r\nSushi, maki's, poke bowls en Japans bier om uw smaakpapillen te verwennen! Alles wordt dezelfde dag ter plekke bereid en is alleen beschikbaar om mee te nemen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Sushi Ozaka"
    ]
  },
