  "rdfs:comment": {
    "de": [
      "Hausgemachte Gerichte aus lokalen Produkten. Die Burgerbrötchen werden von unserem Handwerksbäcker hergestellt\r\nCatering-Service und Koch zu Hause zusätzlich zum Foodtruck."
    ],
    "en": [
      "Home-cooked meals using local produce. Burger buns made by our artisan baker\r\nCatering and home chef service in addition to the food truck."
    ],
    "it": [
      "Piatti fatti in casa con prodotti locali. I panini per gli hamburger sono prodotti dal nostro panettiere artigianale\r\nServizio di catering e chef a domicilio oltre al food truck."
    ],
    "fr": [
      "Plats faits maison avec produits locaux. Les buns à burger sont réalisés par notre artisan boulanger \r\nService de traiteur et de chef à domicile en plus du Food truck."
    ],
    "es": [
      "Platos caseros con productos locales. Los panecillos de las hamburguesas los elabora nuestro panadero artesano\r\nServicio de catering y chef a domicilio además del food truck."
    ],
    "nl": [
      "Huisgemaakte gerechten met lokale producten. De hamburgerbroodjes worden gemaakt door onze ambachtelijke bakker\r\nCatering en thuiskokservice naast de foodtruck."
    ]
  },
