  "rdfs:comment": {
    "de": [
      "Dieses bistronomische Restaurant im Herzen des historischen Zentrums bietet eine qualitativ hochwertige Küche. Wir arbeiten mit lokalen Lieferanten und saisonalen Produkten."
    ],
    "en": [
      "This bistronomic restaurant located in the heart of the historic centre, offers quality cuisine. We work with local suppliers and seasonal products."
    ],
    "it": [
      "Questo ristorante bistronomico, situato nel cuore del centro storico, offre una cucina di qualità. Lavoriamo con fornitori locali e prodotti di stagione."
    ],
    "fr": [
      "Ce restaurant bistronomique situé dans le cœur du centre historique, propose une cuisine de qualité. Nous travaillons avec des fournisseurs locaux et des produits de saison."
    ],
    "es": [
      "Este restaurante bistronómico, situado en el corazón del centro histórico, ofrece una cocina de calidad. Trabajamos con proveedores locales y productos de temporada."
    ],
    "nl": [
      "Dit bistronomische restaurant in het hart van het historische centrum biedt een kwaliteitskeuken. Wij werken met lokale leveranciers en seizoensgebonden producten."
    ]
