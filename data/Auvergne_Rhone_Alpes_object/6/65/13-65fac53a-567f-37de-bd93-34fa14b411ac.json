  "rdfs:comment": {
    "de": [
      "Nach dem Skifahren, Wandern, Einkaufen? Das Sherpa ist der ideale Ort im Herzen von Val Thorens, um sich zu treffen und in einer gemütlichen Atmosphäre bei einem Drink zu entspannen!"
    ],
    "en": [
      "After skiing, hiking, or shopping, Le Sherpa is the ideal place at the heart of Val Thorens for meeting up and spending moments of relaxation around a drink within a warm and friendly environment."
    ],
    "it": [
      "Dopo lo sci, le escursioni, lo shopping... Lo Sherpa è il luogo ideale nel cuore di Val Thorens per ritrovarsi e condividere momenti di relax davanti a un drink in un'atmosfera conviviale e accogliente!"
    ],
    "fr": [
      "Après le ski, les randonnées, le shopping… Le Sherpa est l’endroit idéal au cœur de Val Thorens pour se retrouver et partager des moments de détente autour d’un verre dans une ambiance conviviale et chaleureuse !"
    ],
    "nl": [
      "Na het skiën, wandelen, winkelen... Le Sherpa is de ideale plek in het hart van Val Thorens om samen te komen en te ontspannen onder het genot van een drankje in een gezellige en warme sfeer!"
    ],
    "es": [
      "Después de esquiar, hacer senderismo, ir de compras... Le Sherpa es el lugar ideal en el corazón de Val Thorens para reunirse y compartir momentos de relax tomando una copa en un ambiente acogedor y agradable."
    ]
  },
