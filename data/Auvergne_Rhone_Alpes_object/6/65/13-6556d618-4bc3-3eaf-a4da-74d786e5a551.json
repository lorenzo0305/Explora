  "rdfs:comment": {
    "de": [
      "Marylène und Didier bieten keine Menüs mehr im Speisesaal an, aber sie empfangen Sie weiterhin mit Gerichten zum Mitnehmen, kalten Buffets, Paella, Entremets, Pizzas und süßen Kuchen."
    ],
    "en": [
      "Marylène and Didier no longer offer menus in the restaurant, but they continue to welcome you with takeaways, cold buffets, paëlla, entremets, pizzas and sweet tarts."
    ],
    "it": [
      "Marylène e Didier non propongono più menu nel ristorante, ma continueranno ad accogliervi con piatti da asporto, buffet freddi, paëlla, dessert, pizze e crostate dolci."
    ],
    "fr": [
      "Marylène et Didier ne proposent plus de menus en salle de restaurant mais ils continuent à vous accueillir avec des plats à emporter, buffets froids, paëlla, entremets, pizzas et tartes sucrées."
    ],
    "es": [
      "Marylène y Didier ya no ofrecen menús en el restaurante, pero seguirán acogiéndole con comida para llevar, bufés fríos, paëlla, postres, pizzas y tartas dulces."
    ],
    "nl": [
      "Marylène en Didier bieden geen menu's meer aan in het restaurant, maar ze blijven je verwelkomen met meeneemgerechten, koude buffetten, paëlla, desserts, pizza's en zoete taartjes."
    ]
  },
