  "rdfs:comment": {
    "de": [
      "Das Maison Ose&Vous ist ein Ort der Ressourcen für alle, die auf andere Weise unternehmerisch tätig sein wollen. 500 m², die in Roanne dem Unternehmertum und der finanziellen Bildung gewidmet sind."
    ],
    "en": [
      "La Maison Ose&Vous is a resource center for people who want to do business differently. 500 m² dedicated to entrepreneurship and financial education in Roanne."
    ],
    "it": [
      "La Maison Ose&Vous è un centro di risorse per chi vuole fare impresa in modo diverso. 500 m² dedicati all'imprenditorialità e all'educazione finanziaria a Roanne."
    ],
    "fr": [
      "La Maison Ose&Vous est un lieu ressource pour celles et ceux qui veulent entreprendre autrement. 500 m² dédiés à l'entrepreneuriat et à l’éducation financière à Roanne."
    ],
    "es": [
      "La Maison Ose&Vous es un centro de recursos para personas que quieren hacer negocios de otra manera. 500 m² dedicados al espíritu empresarial y la educación financiera en Roanne."
    ],
    "nl": [
      "Het Maison Ose&Vous is een informatiecentrum voor mensen die anders willen ondernemen. 500 m² gewijd aan ondernemerschap en financiële educatie in Roanne."
