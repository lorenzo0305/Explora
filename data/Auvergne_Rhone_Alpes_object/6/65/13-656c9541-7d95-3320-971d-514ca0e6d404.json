  "rdfs:comment": {
    "de": [
      "Das Selcius empfängt alle Nachtschwärmer von Donnerstag- bis Samstagabend und bietet Ihnen musikalische & thematische Afterworks sowie Drunch&Club-Abende am Wochenende bis 4 Uhr morgens. Musik von Dj Aurélien Ronco."
    ],
    "en": [
      "The Selcius Club welcomes night birds from Thursday to Saturday evening and offers musical & thematic afterworks and Drunch&Club evenings at the weekend until 4 in the morning. Music by DJ Aurélien Ronco."
    ],
    "it": [
      "Il Selcius accoglie tutti i nottambuli dal giovedì al sabato sera e offre afterwork musicali e tematici, nonché serate Drunch&Club nel fine settimana fino alle 4 del mattino. Musica di Dj Aurélien Ronco."
    ],
    "fr": [
      "Le Selcius accueille tous les noctambules du jeudi au samedi soir et vous propose des afterworks musicaux & thématiques ainsi que des soirées Drunch&Club le week-end jusqu'à 4h du matin. Musique par le Dj Aurélien Ronco."
    ],
    "es": [
      "El Selcius acoge a todos los noctámbulos de jueves a sábado por la noche y ofrece afterworks musicales y temáticos, así como noches de Drunch&Club los fines de semana hasta las 4 de la madrugada. Música de Dj Aurélien Ronco."
    ],
    "nl": [
      "De Selcius verwelkomt alle nachtbrakers van donderdag- tot zaterdagnacht en biedt muzikale en thematische afterworks en Drunch&Club-avonden in het weekend tot 4 uur 's nachts. Muziek van Dj Aurélien Ronco."
    ]
  },
