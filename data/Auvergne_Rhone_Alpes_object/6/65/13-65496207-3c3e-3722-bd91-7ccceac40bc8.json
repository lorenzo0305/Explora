  "rdfs:comment": {
    "de": [
      "Anfängerlift, um mit Ihren Kindern sicher auf der Schneckenpiste zu fahren und dabei die \"Mini-Zone elements park\" und ihre zahlreichen Spielmodule zu nutzen."
    ],
    "en": [
      "Beginner skilift to learn skiing on the Escargot slope with your children, to enjoy the \"elements park mini-zone\" with numerous fun modules."
    ],
    "it": [
      "Skilift per principianti per sciare in sicurezza sulla pista dell'Escargot con i vostri bambini, approfittando del \"mini-parco degli elementi\" e dei suoi numerosi moduli di gioco."
    ],
    "fr": [
      "Téléski débutant pour skier en toute sécurité sur la piste de l'Escargot avec vos enfants, en profitant de la \"mini-zone elements park\" et de ses nombreux modules ludiques."
    ],
    "es": [
      "Remonte para principiantes para esquiar con seguridad en la pista de Escargot con sus hijos, aprovechando el \"miniparque\" y sus numerosos módulos de juego."
    ],
    "nl": [
      "Beginnerslift om veilig met uw kinderen op de Escargot-piste te skiën, waarbij u gebruik kunt maken van het \"mini-elementenpark\" en de vele speelmodules."
    ]
  },
