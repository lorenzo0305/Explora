  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/446353d7-a342-34af-8f0b-9fdc933d9fe1",
      "dc:description": {
        "de": [
          "Treffpunkt für einen Moment der Entdeckung von Büchern und Musik für Kinder und ihre Eltern. Im Laufe dieser besonderen Märchenstunde werden die Lesungen von Valérie diesmal von Sandras Musiknoten begleitet, um noch mehr Spaß zu bereiten."
        ],
        "en": [
          "An opportunity for children and their parents to discover books and music. During this special story time, Valérie's readings will be accompanied this time by Sandra's musical notes for even more pleasure."
        ],
        "it": [
          "Un'occasione per i bambini e i loro genitori di scoprire i libri e la musica. Durante questo speciale momento di lettura, le letture di Valérie saranno accompagnate questa volta dalle note musicali di Sandra, per un divertimento ancora maggiore."
        ],
        "fr": [
          "Rendez-vous pour un moment de découverte du livre et de la musique pour les enfants et leurs parents. Au cours de cette heure du conte particulière, les lectures de Valérie seront accompagnées cette fois-ci des notes de musique de Sandra pour encore plus de plaisir."
        ],
        "es": [
          "Una oportunidad para que los niños y sus padres descubran los libros y la música. Durante esta hora especial de cuentos, las lecturas de Valérie estarán acompañadas esta vez por las notas musicales de Sandra para divertirse aún más."
        ],
        "nl": [
          "Een gelegenheid voor kinderen en hun ouders om boeken en muziek te ontdekken. Tijdens deze speciale voorleesuurtjes worden Valérie's voordrachten dit keer begeleid door Sandra's muzieknoten voor nog meer plezier."
        ]
      },
      "@type": [
        "Description"
