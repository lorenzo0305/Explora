  "rdfs:comment": {
    "de": [
      "GESCHLOSSEN FÜR ARBEITEN Dieses Museum, das im Haus Bonnevie gegenüber der Kirche untergebracht ist, zeigt die Geschichte und die Traditionen der Bewohner des Allues-Tals: traditionelles Wohnen, Werkzeuge und Techniken von früher, lokale Geschichte, Archive, Ausstellungen."
    ],
    "ru": [
      "В четырех залах музея представлены экспонаты, знакомящие с историей и традициями Долины Les Allues (Лез Аллю). Вход свободный."
    ],
    "en": [
      "CLOSED FOR WORK \r\nLocated in an old village house, it recounts the valley's history and traditions."
    ],
    "it": [
      "Situato in un edificio di più di 100 anni, questo museo racconta il passato e le tradizioni degli abitanti della valle degli Allues: habitat, utensili, storia locale, foto, esposizione sull'evoluzione dello sci..."
    ],
    "fr": [
      "FERME POUR TRAVAUX Installé dans la maison Bonnevie, face à l'église, ce musée présente l'histoire et les traditions des habitants de la vallée des Allues : habitat traditionnel, outils et techniques d'autrefois, histoire locale, archives, exposition."
    ],
    "nl": [
      "GESLOTEN VOOR WERKZAAMHEDEN Geïnstalleerd in het huis Bonnevie, tegenover de kerk, presenteert dit museum de geschiedenis en tradities van de bewoners van het Allues-dal: traditionele leefomgeving, gereedschappen en technieken uit het verleden, plaatselijke geschiedenis, archieven, tentoonstelling."
    ],
    "es": [
      "CERRADO POR OBRAS Instalado en la Maison Bonnevie, frente a la iglesia, este museo presenta la historia y las tradiciones de los habitantes del Vallée des Allues: viviendas tradicionales, herramientas y técnicas de antaño, historia local, archivos, exposición."
    ]
  },
