  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/ae37cbf9-6a5d-3a21-86fd-733beffa14f1",
      "dc:description": {
        "de": [
          "Kleiner Weihnachtsmarkt\n-Samstag, 13. Dezember von 10 bis 20 Uhr\n-Sonntag, 14. Dezember von 11h bis 17h\nPorte de France - Montreuil\n--------------------------\nMit zahlreichen Kunsthandwerkern, die Ihnen ihre schönsten Kreationen präsentieren!\n\nUm einen Stand zu bekommen, rufen Sie uns bitte unter 03 21 06 01 89 an\n\nOrt: In der Nähe des Place du Général de Gaulle\nCredit: Pixabay"
        ],
        "en": [
          "Little Christmas Market\n-Saturday December 13 from 10am to 8pm\n-Sunday, December 14, 11am to 5pm\nPorte de France - Montreuil\n--------------------------\nWith a host of artisans showcasing their finest creations!\n\nTo reserve a stand, please call 03 21 06 01 89\n\nLocation: Near Place du Général de Gaulle\nCredit : Pixabay"
        ],
        "it": [
          "Piccolo mercatino di Natale\n-Sabato 13 dicembre dalle 10.00 alle 20.00\n-Domenica 14 dicembre dalle 11.00 alle 17.00\nPorta di Francia - Montreuil\n--------------------------\nCon una serie di artigiani che mettono in mostra le loro migliori creazioni!\n\nPer prenotare uno stand, chiamare il numero 03 21 06 01 89\n\nPosizione: Vicino a Place du Général de Gaulle\nCredito : Pixabay"
        ],
        "fr": [
          "Petit Marché de Noël\n-Samedi 13 décembre de 10h à 20h\n-Dimanche 14 décembre de 11h à 17h\nPorte de France - Montreuil\n--------------------------\nAvec de nombreux artisans qui vous présenteront leurs plus belles créations !\n\nPour obtenir un stand n’hésitez pas à appeler le 03 21 06 01 89\n\nLieu : Près de la Place du Général de Gaulle\nCrédit : Pixabay"
        ],
        "es": [
          "Pequeño mercado navideño\n-Sábado 13 de diciembre de 10:00 a 20:00\n-Domingo 14 de diciembre de 11h a 17h\nPuerta de Francia - Montreuil\n--------------------------\nNumerosos artesanos expondrán sus mejores creaciones\n\nPara reservar un stand, llame al 03 21 06 01 89\n\nLocalización: Cerca de la Place du Général de Gaulle\nCrédito: Pixabay"
        ],
        "nl": [
          "Kleine kerstmarkt\n-Zaterdag 13 december van 10 tot 20 uur\n-Zondag 14 december van 11 tot 17 uur\nFranse poort - Montreuil\n--------------------------\nMet een groot aantal ambachtslieden die hun mooiste creaties laten zien!\n\nOm een stand te reserveren, bel 03 21 06 01 89\n\nLocatie: Vlakbij Place du Général de Gaulle\nKrediet: Pixabay"
        ]
      },
