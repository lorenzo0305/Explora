  "rdfs:comment": {
    "de": [
      "Patronatsfest von Josat am 15. August. Messe um 11 Uhr, gefolgt von einem Pétanque-Wettbewerb um 14:30 Uhr. Am späten Abend Konzertmahl ab 19 Uhr und Feuerwerk, das vom Bürgermeisteramt angeboten wird.\r\nReservierung Essen: 06 30 87 40 04"
    ],
    "en": [
      "Josat patron saint's day on August 15. Mass at 11am followed by a pétanque competition at 2:30pm. At the end of the evening, concert dinner from 7pm and fireworks offered by the town hall.\r\nDinner reservations: 06 30 87 40 04"
    ],
    "it": [
      "Festa patronale di Josat il 15 agosto. Messa alle 11, seguita da una gara di bocce alle 14.30. A fine serata, cena concerto dalle 19.00 e fuochi d'artificio offerti dal municipio.\r\nPrenotazioni per la cena: 06 30 87 40 04"
    ],
    "fr": [
      "Fête patronale de Josat le 15 août. Messe à 11H suivi d'un concours de pétanque à 14h30. En fin de soirée Repas concert à partir de 19h et feux d'artifice offert par la mairie. \r\nRéservation repas : 06 30 87 40 04"
    ],
    "nl": [
      "Patroonsdag van Josat op 15 augustus. Mis om 11 uur, gevolgd door een petanquewedstrijd om 14.30 uur. Aan het eind van de avond een concertdiner vanaf 19.00 uur en vuurwerk aangeboden door het gemeentehuis.\r\nReserveringen voor de maaltijd: 06 30 87 40 04"
    ],
    "es": [
      "Fiesta patronal de Josat el 15 de agosto. Misa a las 11h, seguida de un concurso de petanca a las 14h30. Al final de la velada, cena concierto a partir de las 19h y fuegos artificiales ofrecidos por el ayuntamiento.\r\nReservas para la cena: 06 30 87 40 04"
    ]
  },
