  "rdfs:comment": {
    "de": [
      "Kleines Restaurant mit 35 Sitzplätzen, das eine traditionelle Küche und hausgemachte Gerichte aus frischen Produkten anbietet.\r\nWarme und einladende Umgebung.\r\nTreffen Sie uns dort!"
    ],
    "en": [
      "Small, 35-seat restaurant serving traditional cuisine and homemade dishes made with fresh produce.\r\nWarm and welcoming setting.\r\nCome and meet us!"
    ],
    "it": [
      "Piccolo ristorante con 35 coperti, che propone una cucina tradizionale e piatti fatti in casa con prodotti freschi.\r\nAmbiente caldo e accogliente.\r\nVenite a conoscerci!"
    ],
    "fr": [
      "Petit restaurant de 35 couverts, proposant une cuisine traditionnelle et des plats fait maison élaborés à partir de produits frais. \r\nCadre chaleureux et accueillant. \r\nVenez nous y rencontrer !"
    ],
    "es": [
      "Pequeño restaurante con 35 cubiertos, que sirve cocina tradicional y platos caseros elaborados con productos frescos.\r\nAmbiente cálido y acogedor.\r\n¡Venga a conocernos!"
    ],
    "nl": [
      "Klein restaurant met 35 couverts, waar traditionele gerechten en huisgemaakte gerechten met verse producten worden geserveerd.\r\nWarm en gastvrij kader.\r\nKom en ontmoet ons!"
    ]
  },
  "rdfs:label": {
