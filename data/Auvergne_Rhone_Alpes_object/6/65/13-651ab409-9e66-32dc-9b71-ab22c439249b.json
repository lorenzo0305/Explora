  "rdfs:comment": {
    "de": [
      "Der Jazz Club Saint-Pourcinois feiert den Frühling mit seiner Big Band, der Saint Pourswing. Und was gibt es Besseres als einen großen Swing-Ball, um sich in die unbeschwerte Stimmung der Saison zu versetzen? Tanzfläche, Getränkestand, Bretter auf Vorbestellung."
    ],
    "en": [
      "The Jazz Club Saint-Pourcinois celebrates spring with its big band, the Saint Pourswing. And what better way to get into the carefree spirit of the season than with a big swing ball? Dance floor, refreshment bar and planks available on reservation."
    ],
    "it": [
      "Il Jazz Club Saint-Pourcinois festeggia la primavera con la sua big band, la Saint Pourswing. E quale modo migliore per entrare nello spirito spensierato della stagione se non con un grande ballo swing? Pista da ballo, bar, tavole su prenotazione."
    ],
    "fr": [
      "Le Jazz Club Saint-Pourcinois célèbre le printemps avec sa formation big band, le Saint Pourswing. Et quoi de mieux qu'un grand bal swing pour se mettre dans l'ambiance insouciante de la saison? Piste de danse, buvette, planches sur réservation."
    ],
    "es": [
      "El Jazz Club Saint-Pourcinois celebra la primavera con su big band, la Saint Pourswing. ¿Y qué mejor manera de entrar en el espíritu desenfadado de la estación que con un gran baile de swing? Pista de baile, bar de refrescos, tablas en la reserva."
    ],
    "nl": [
      "De Jazz Club Saint-Pourcinois viert de lente met zijn big band, de Saint Pourswing. En wat is een betere manier om in de zorgeloze sfeer van het seizoen te komen dan met een grote swingdans? Dansvloer, bar, planken op reservering."
    ]
  },
  "rdfs:label": {
    "fr": [
      "SAINT POURSWING fête le printemps"
    ]
  },
