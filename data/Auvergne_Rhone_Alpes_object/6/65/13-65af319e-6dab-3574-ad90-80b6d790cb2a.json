  "rdfs:comment": {
    "de": [
      "Eine Küche mit Aromen von hier und anderswo, überraschende Rezepte zwischen bodenständig und modern, wobei wir die Jahreszeiten und unsere Produzentinnen und Produzenten respektieren.\r\nUnser Restaurant ist mit einem Bib Gourmand im Guide Michelin ausgezeichnet."
    ],
    "en": [
      "A mixed cuisine with flavors from here and elsewhere, surprising recipes between local and modern.\r\nOur restaurant is distinguished by a bib gourmand in the Michelin guide."
    ],
    "it": [
      "Una cucina con sapori di qui e di altrove, ricette sorprendenti che uniscono il locale e il moderno, nel rispetto delle stagioni e dei nostri produttori\r\nIl nostro ristorante è stato premiato dalla Guida Michelin con il Bib Gourmand."
    ],
    "fr": [
      "Une cuisine aux saveurs d'ici et d'ailleurs, des recettes surprenantes entre terroir et modernité tout en respectant les saisons et nos productrices et producteurs \r\nNotre restaurant est distinguée par un bib gourmand au guide Michelin."
    ],
    "es": [
      "Una cocina con sabores de aquí y de allá, recetas sorprendentes que combinan lo local y lo moderno, respetando las estaciones y a nuestros productores\r\nNuestro restaurante ha sido galardonado con un Bib Gourmand de la Guía Michelin."
    ],
    "nl": [
      "Een keuken met smaken van hier en elders, verrassende recepten die het lokale en het moderne combineren, met respect voor de seizoenen en onze producenten\r\nOns restaurant is bekroond met een Bib Gourmand door de Michelingids."
    ]
  },
