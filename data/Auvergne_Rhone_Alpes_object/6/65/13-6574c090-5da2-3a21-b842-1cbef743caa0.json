  "rdfs:comment": {
    "de": [
      "Als gelernter Koch, Metzger und Traiteur bietet Ihnen David je nach Jahreszeit und lokaler Versorgung \"hausgemachte\" Menüs an. Dieses Familienrestaurant bietet einen lächelnden Empfang, herzhafte Gerichte mit der originellen Note des Küchenchefs!"
    ],
    "en": [
      "David, a professional cook, butcher and caterer, serves seasonal homemade menus based on local produces. In this family restaurant, expect a warm welcome, generous servings and the chef's unique touch !"
    ],
    "it": [
      "Cuoco, macellaio e ristoratore di professione, David propone menu casalinghi basati sulle stagioni e sulle forniture locali. Questo ristorante a conduzione familiare offre un'accoglienza calorosa, piatti sostanziosi e il tocco originale dello chef!"
    ],
    "fr": [
      "Cuisinier, charcutier et traiteur de métier, David  vous propose, au gré des saisons et des approvisionnements locaux, des menus concoctés « maison ». Ce restaurant familial offre un accueil souriant, des plats copieux avec la touche originale du chef !"
    ],
    "es": [
      "Cocinero, charcutero y restaurador de profesión, David propone menús caseros basados en las estaciones y los productos locales. Este restaurante familiar ofrece una cálida bienvenida, platos abundantes y el toque original del chef"
    ],
    "nl": [
      "Als chef-kok, varkensslager en traiteur van beroep biedt David huisgemaakte menu's op basis van de seizoenen en lokale voorraden. Dit familierestaurant biedt een warm welkom, stevige gerechten en de originele toets van de chef!"
    ]
  },
  "rdfs:label": {
    "de": [
