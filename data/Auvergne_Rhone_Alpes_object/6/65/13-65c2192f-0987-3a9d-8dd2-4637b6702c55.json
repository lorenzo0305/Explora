  "rdfs:comment": {
    "de": [
      "Im Rahmen des Tages des Kinderbuchs lädt Fabienne von der Mediathek Sie, Eltern und Kinder von 0 bis 6 Jahren, zu einer geräuschvollen Lesung in Zusammenarbeit mit dem Zentrum für Spielressourcen Lud'Agglo ein.\r\nKostenlos, ohne Reservierung."
    ],
    "en": [
      "As part of Children's Book Day, Fabienne from the mediatheque invites parents and children aged 0-6 to a noisy reading in collaboration with the Lud'Agglo games resource center.\r\nFree, no reservation required."
    ],
    "it": [
      "Nell'ambito della Giornata del libro per ragazzi, Fabienne della biblioteca multimediale invita genitori e bambini da 0 a 6 anni a una lettura rumorosa in collaborazione con il centro risorse Lud'Agglo.\r\nGratuito, non è necessaria la prenotazione."
    ],
    "fr": [
      "Dans le cadre de la journée du livre pour enfant, Fabienne de la médiathèque vous invite, parents et enfants de 0 à 6 ans, à une lecture bruitée en collaboration avec le centre ressources jeux Lud'Agglo.\r\nGratuit, sans réservation."
    ],
    "nl": [
      "In het kader van Kinderboekendag nodigt Fabienne van de mediatheek ouders en kinderen van 0 tot 6 jaar uit voor een luidruchtige lezing in samenwerking met het Lud'Agglo spelcentrum.\r\nGratis, reserveren niet nodig."
    ],
    "es": [
      "En el marco del Día del Libro Infantil, Fabienne, de la biblioteca multimedia, invita a padres y niños de 0 a 6 años a una lectura ruidosa en colaboración con el centro de recursos lúdicos Lud'Agglo.\r\nGratuito, sin reserva previa."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Lecture bruitée au Cyprès"
    ]
  },
