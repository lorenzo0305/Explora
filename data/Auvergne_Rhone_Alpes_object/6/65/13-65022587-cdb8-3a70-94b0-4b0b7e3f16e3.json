  "rdfs:comment": {
    "de": [
      "Das Restaurant liegt im Herzen eines malerischen Dorfes in den Cevennen und bietet hausgemachte Gerichte aus lokalen und saisonalen Produkten."
    ],
    "en": [
      "Located in the heart of a picturesque village, the restaurant offers homemade cuisine made with local and seasonal products."
    ],
    "it": [
      "Situato nel cuore di un pittoresco villaggio delle Cévennes, il ristorante serve piatti fatti in casa con prodotti locali e di stagione."
    ],
    "fr": [
      "Situé au cœur d'un village pittoresque cévenol, le restaurant propose une cuisine maison à base de produits locaux et de saison."
    ],
    "es": [
      "Situado en el corazón de un pintoresco pueblo de las Cevenas, el restaurante sirve platos caseros elaborados con productos locales de temporada."
    ],
    "nl": [
      "Het restaurant ligt in het hart van een pittoresk dorpje in de Cevennen en serveert huisgemaakte maaltijden met lokale, seizoensgebonden producten."
    ]
  },
