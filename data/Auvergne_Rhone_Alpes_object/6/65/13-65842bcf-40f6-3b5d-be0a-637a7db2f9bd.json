  "rdfs:comment": {
    "de": [
      "Wasserskilift im Natural Wake Park: Einführung in das seilgezogene Gleiten mit verschiedenen Medien (Kneeboard, Ski, Wakeboard, Bi-Poulies) für alle Niveaus. Weitere Wassersportaktivitäten, Restaurants und Camping vor Ort."
    ],
    "en": [
      "Water-skiing at the Natural Wake Park: introduction to cable-drawn water-skiing, with a range of equipment (kneeboard, ski, wakeboard, bi-poulies) for all levels. Other water activities, catering and camping on site."
    ],
    "it": [
      "Sci nautico al Natural Wake Park: introduzione allo sci nautico su fune, con una gamma di attrezzature (kneeboard, sci, wakeboard, bipattini) per tutti i livelli. Altre attività acquatiche, ristoranti e campeggio in loco."
    ],
    "fr": [
      "Téléski nautique au Natural Wake Park : initiation à la glisse tractée par câble, avec différents supports (kneeboard, ski, wakeboard, bi-poulies) pour tous les niveaux. Autres activités aquatiques, restauration et camping sur place."
    ],
    "nl": [
      "Prachtige plek om te waterskiën.\r\nNieuwigheid 2022 : waterpark met waterfiets verhuur en peddelen"
    ],
    "es": [
      "Esquí náutico en el Parque Natural de las Estelas: iniciación al esquí náutico por cable, con material variado (kneeboard, esquí, wakeboard, biplaza) para todos los niveles. Otras actividades acuáticas, restaurantes y camping in situ."
    ]
  },
