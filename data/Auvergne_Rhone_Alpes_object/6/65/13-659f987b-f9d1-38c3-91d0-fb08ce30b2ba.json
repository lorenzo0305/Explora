  "rdfs:comment": {
    "de": [
      "Ein 1 Hektar großer Teich am Dorfausgang in Richtung Feurs, der zahlreiche Arten in großer Zahl enthält. Angelkarten sind in der Bäckerei, im Lebensmittelgeschäft und im Restaurant von Saint-Martin-Lestra erhältlich. Nur zum Angeln, Baden verboten."
    ],
    "en": [
      "A 1 hectare pond on the outskirts of the village in the direction of Feurs, containing numerous species. Fishing cards on sale at the Saint-Martin-Lestra bakery, grocery store and restaurant. Fishing only, swimming prohibited."
    ],
    "it": [
      "Stagno di 1 ettaro situato alla periferia del villaggio in direzione di Feurs, contenente numerose specie. Carte di pesca in vendita presso la panetteria, il negozio di alimentari e il ristorante di Saint-Martin-Lestra. Solo pesca, vietata la balneazione."
    ],
    "fr": [
      "Un étang de 1 hectare situé à la sortie du village en direction de Feurs, contenant de nombreuses espèces en quantité. Cartes de pêche en vente à la boulangerie, l'épicerie et le restaurant de Saint-Martin-Lestra. Réservé à la pêche, baignade interdite."
    ],
    "es": [
      "Estanque de 1 hectárea situado a las afueras del pueblo en dirección a Feurs, con numerosas especies. Venta de tarjetas de pesca en la panadería, la tienda de comestibles y el restaurante de Saint-Martin-Lestra. Sólo pesca, prohibido bañarse."
    ],
    "nl": [
      "Een vijver van 1 hectare aan de rand van het dorp in de richting van Feurs, met talrijke vissoorten. Viskaarten te koop bij de bakker, de kruidenier en het restaurant in Saint-Martin-Lestra. Alleen vissen, zwemmen verboden."
    ]
  },
