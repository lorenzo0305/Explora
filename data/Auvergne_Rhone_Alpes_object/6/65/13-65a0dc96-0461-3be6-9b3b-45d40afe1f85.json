  "rdfs:comment": {
    "de": [
      "Das ganze Jahr über geöffnet. Sportbecken und Freizeitbecken + überdachter Pentagliss. Sommer: Außenbecken + Pentagliss + Snack + Familienbereich (Spielplätze, Rutsche, Picknickbereich). Wassergymnastik, Aquabike, Schwimmkurse. Entspannungsbereich (Sauna, Hammam)."
    ],
    "en": [
      "Undercover athlete pool and leisure pool. Outdoor heated pool and snackbar in summer. Facilities : relaxation area (sauna, spa, hammam and hydro-massaging showers) and wifi."
    ],
    "it": [
      "Aperto tutto l'anno. Piscine sportive e ricreative coperte + pentagliss. Estate: piscina esterna + Pentagliss + snack bar + area per famiglie (aree gioco, area picnic). Aquagym, aquabike, corsi di nuoto. Area relax (sauna, hammam)."
    ],
    "fr": [
      "Ouvert toute l'année. Bassin sportif et bassins loisirs + pentagliss couverts. Été: bassin extérieur+ Pentagliss + snack + espace famille (aires de jeux, aire pique-nique). Aquagym, aquabike, cours de natation. Espace détente (sauna, hammam)."
    ],
    "nl": [
      "Het hele jaar geopend. Overdekte sport- en recreatiebaden + pentagliss. Zomer: buitenzwembad + Pentagliss + snackbar + familiezone (speeltuinen, glijbaan, picknickplaats). Aquagym, aquafiets, zwemlessen. Ontspanningsruimte (sauna, hammam)."
    ],
    "es": [
      "Abierto todo el año. Piscinas deportivas y lúdicas cubiertas + pentagliss. Verano: piscina exterior + Pentagliss + snack bar + zona familiar (áreas de juego, merendero). Aquagym, aquabike, clases de natación. Zona de relajación (sauna, hammam)."
    ]
  },
  "rdfs:label": {
    "en": [
      "Aquatic center Bleu Rive"
    ],
    "fr": [
      "Centre Aquatique Bleu Rive"
    ]
  },
