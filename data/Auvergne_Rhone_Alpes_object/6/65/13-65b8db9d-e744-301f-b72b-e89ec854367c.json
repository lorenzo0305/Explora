  "rdfs:comment": {
    "de": [
      "Die 6H de Montmeyran sind ein Staffellauf für Teams, der vom Club Running Montmeyran organisiert wird und ein geselliges, sportliches und zugängliches Format hat.\r\nSechs Stunden lang treten die Teams auf einer 3 km langen Schleife gegeneinander an."
    ],
    "en": [
      "The 6H de Montmeyran is a team relay race organized by the Running Montmeyran club, in a friendly, sporty and accessible format.\r\nFor 6 hours, teams compete over a 3 km loop."
    ],
    "it": [
      "La 6H de Montmeyran è una staffetta a squadre organizzata dal club Running Montmeyran, in un formato amichevole, sportivo e accessibile.\r\nPer 6 ore, le squadre si sfidano su un percorso di 3 km."
    ],
    "fr": [
      "Les 6H de Montmeyran sont une course en relais par équipes, organisée par le club Running Montmeyran, sur un format convivial, sportif et accessible.\r\nPendant 6 heures, les équipes s’affrontent sur une boucle de 3 km."
    ],
    "es": [
      "La 6H de Montmeyran es una carrera de relevos por equipos organizada por el club Running Montmeyran, en un formato amistoso, deportivo y accesible.\r\nDurante 6 horas, los equipos compiten en un bucle de 3 km."
    ],
    "nl": [
      "De 6H de Montmeyran is een estafetteloop voor teams georganiseerd door de Running Montmeyran club, in een gezellige, sportieve en toegankelijke vorm.\r\nGedurende 6 uur strijden de teams over een lus van 3 km."
    ]
  },
