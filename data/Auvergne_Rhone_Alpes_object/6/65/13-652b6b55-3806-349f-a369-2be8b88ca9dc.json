  "rdfs:comment": {
    "de": [
      "das Konzept: eine Street-Food-Ecke mit thailändischer Sauce, die stark ist, eine Bar, die viel schickt und Partys jedes Wochenende... Das Hauptquartier ist ein Ort, an den man kommt, um zu leben, zu lachen und neu anzufangen!"
    ],
    "en": [
      "the concept: a corner street food with Thai sauce that hits hard, a bar that sends heavy and parties every weekend... The HQ is a place where you come to live, laugh and start over!"
    ],
    "it": [
      "il concetto: un angolo di street food con un tocco thailandese, un bar con una vera carica e feste ogni weekend... Le Qg è un luogo dove si viene per vivere, ridere e rifare tutto!"
    ],
    "fr": [
      "le concept : un corner street food à la sauce thailandaise qui tape fort, un bar qui envoie du lourd et des soirées tous les week-ends... Le Qg c'est un lieu où tu viens pour vivre, rire et recommencer !"
    ],
    "nl": [
      "het concept: een hoekstraat eten met Thaise saus die hard slaat, een bar die zwaar stuurt en elk weekend feesten ... Het hoofdkantoor is een plek waar je komt wonen, lachen en opnieuw begint!"
    ],
    "es": [
      "el concepto: un rincón de comida callejera con un toque tailandés, un bar con mucha marcha y fiestas todos los fines de semana... Le Qg es un lugar al que se viene para vivir, reír y volver a hacerlo todo"
    ]
  },
