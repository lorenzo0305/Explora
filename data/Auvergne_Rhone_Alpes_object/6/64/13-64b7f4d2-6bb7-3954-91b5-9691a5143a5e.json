  "rdfs:comment": {
    "de": [
      "Ein Verkaufsraum, in dem Sie 30 unserer talentiertesten Winzer der Appellation in einem außergewöhnlichen Rahmen treffen können. Ein symbolträchtiger Ort für den Notourismus, eine Touristeninformationsstelle und eine Boutique mit süßen und salzigen Produkten aus der Region!"
    ],
    "en": [
      "A boutique where you can meet 30 of the appellation's most talented winemakers in an exceptional setting. An emblematic venue for wine tourism, a tourist information centre and a shop selling sweet and savoury local produce!"
    ],
    "it": [
      "Un'area di vendita dove potrete incontrare 30 dei più talentuosi viticoltori della denominazione in un ambiente eccezionale. Un luogo emblematico per l'enoturismo, un centro di informazione turistica e un negozio di prodotti locali dolci e salati!"
    ],
    "fr": [
      "Un espace de vente où vous pourrez rencontrer 30 de nos vignerons les plus talentueux de l'appellation dans un cadre exceptionnel. Lieu emblématique de l'œnotourisme, relais d'informations touristiques et boutique de produits du terroir sucrés et salés !"
    ],
    "es": [
      "Un espacio de venta donde podrá conocer a 30 de los viticultores con más talento de la denominación en un marco excepcional. Un lugar emblemático para el enoturismo, un centro de información turística y una tienda de productos locales dulces y salados"
    ],
    "nl": [
      "Een verkoopruimte waar je 30 van de meest getalenteerde wijnmakers van de appellation kunt ontmoeten in een uitzonderlijk kader. Een emblematische plek voor wijntoerisme, een toeristisch informatiecentrum en een winkel met zoete en hartige streekproducten!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Maison du Cru Chiroubles"
    ]
  },
