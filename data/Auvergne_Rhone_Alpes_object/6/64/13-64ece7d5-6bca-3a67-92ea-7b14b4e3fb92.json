  "rdfs:comment": {
    "de": [
      "Verkauf von Ziegen- und Kuhmilchkäse, Eiern und Wurstwaren.\r\nHofladen: Verkauf von Käse.\r\nAuf dem Markt am Samstag in Tain l'Hermitage, Saint Félicien und Lamastre am Dienstagmorgen."
    ],
    "en": [
      "Sale of goat cheeses, cows, eggs, cold meats.\r\nFarm shop: sale of cheese\r\nOn the market on Saturday in Tain l'Hermitage"
    ],
    "it": [
      "Vendita di formaggi di capra e di mucca, uova e salumi.\r\nNegozio in fattoria: vendita di formaggi\r\nIl mercato del sabato a Tain l'Hermitage, Saint Félicien e Lamastre il martedì mattina."
    ],
    "fr": [
      "Vente de fromages de chèvre et de vache, d'œufs et de charcuterie.\r\nMagasin à la ferme : vente de fromages\r\nSur le marché le samedi à Tain l'Hermitage, Saint Félicien et Lamastre le mardi matin."
    ],
    "nl": [
      "Verkoop van geiten- en koeienkazen, eieren en vleeswaren.\r\nBoerderijwinkel: kaasverkoop\r\nOp zaterdagmarkten in Tain l'Hermitage, Saint Félicien en Lamastre op dinsdagochtend."
    ],
    "es": [
      "Venta de quesos de cabra y vaca, huevos y embutidos.\r\nTienda en la granja: venta de quesos\r\nEn el mercado de los sábados en Tain l'Hermitage, Saint Félicien y Lamastre el martes por la mañana."
    ]
  },
  "rdfs:label": {
    "en": [
      "Fromagerie du Roule"
    ],
