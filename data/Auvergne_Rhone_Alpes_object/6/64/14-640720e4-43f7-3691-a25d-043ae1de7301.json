  "rdfs:comment": {
    "de": [
      "Nehmen Sie an dieser ungewöhnlichen zweistimmigen Führung durch die Kirche Saint Léger teil, bei der Sie in Begleitung eines Fremdenführers und eines Organisten die Geschichte des Ortes, aber auch die der Orgeln kennen lernen."
    ],
    "en": [
      "Join a guide and organist on a unique two-voice tour of Saint Léger church, to discover the history of the church and its organs."
    ],
    "it": [
      "Unitevi a una guida e a un organista in questo tour unico a due voci della chiesa di Saint Léger per scoprire la storia dell'edificio e dei suoi organi."
    ],
    "fr": [
      "Participez à cette visite inédite et à deux voix de l’église Saint Léger, en compagnie d’un guide conférencier et d’un organiste, pour découvrir l’histoire du lieu mais aussi celle des orgues."
    ],
    "nl": [
      "Ga mee met een gids en een organist op deze unieke rondleiding met twee stemmen door de kerk Saint Léger om de geschiedenis van het gebouw en de orgels te ontdekken."
    ],
    "es": [
      "Acompañe a un guía y a un organista en este recorrido único a dos voces por la iglesia de Saint Léger para descubrir la historia del edificio y de sus órganos."
    ]
  },
  "rdfs:label": {
