  "rdfs:comment": {
    "de": [
      "Sie wurde nach den Plänen des Architekten Hugues Imbert aus Arkose erbaut. Ihre neuromanische Architektur zeugt von der Wiederentdeckung dieses Stils im 19. Jahrhundert und bildet den Grundriss der großen Pilgerkirchen der Auvergne nach."
    ],
    "en": [
      "Built in arkose to designs by architect Hugues Imbert, its neo-Romanesque architecture bears witness to the 19th-century rediscovery of this style, and reproduces the layout of the great pilgrimage churches of Auvergne."
    ],
    "it": [
      "Costruita in arkose su progetto dell'architetto Hugues Imbert, la sua architettura neoromanica testimonia la riscoperta di questo stile nel XIX secolo e riproduce la pianta delle grandi chiese di pellegrinaggio dell'Alvernia."
    ],
    "fr": [
      "Construite en arkose sur les plans de l’architecte Hugues Imbert, son architecture néo-romane témoigne de la redécouverte de ce style au 19e  siècle et reproduit le plan des grandes églises de pèlerinages auvergnates."
    ],
    "nl": [
      "De neoromaanse architectuur, gebouwd in arkose naar een ontwerp van de architect Hugues Imbert, getuigt van de herontdekking van deze stijl in de 19e eeuw en reproduceert de indeling van de grote bedevaartskerken van de Auvergne."
    ],
    "es": [
      "Construida en arcosa según los planos del arquitecto Hugues Imbert, su arquitectura neorrománica atestigua el redescubrimiento de este estilo en el siglo XIX y reproduce el trazado de las grandes iglesias de peregrinación de Auvernia."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Eglise Notre-Dame de l'Assomption"
    ]
  },
