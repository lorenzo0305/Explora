  "rdfs:comment": {
    "de": [
      "Die Fotokünstlerin, Malerin und Dichterin bietet ihren Blick, ihre Fähigkeiten als Fotografin und Spaziergänge an, um Techniken\r\nund Komposition zu erlernen."
    ],
    "en": [
      "A photographer, painter and poet, she offers her perspective, her skills as a photographer and walks to learn\r\ntechniques and composition."
    ],
    "it": [
      "Fotografa, pittrice e poetessa, mette a disposizione il suo occhio, le sue capacità fotografiche e le passeggiate per imparare le tecniche e la composizione del suo lavoro\r\ntecniche e composizione."
    ],
    "fr": [
      "Artiste photographe, peintre et poète, elle propose son regard, ses compétences de photographe et des balades pour apprendre les\r\ntechniques et la composition."
    ],
    "es": [
      "Fotógrafa, pintora y poeta, nos ofrece su ojo, sus habilidades fotográficas y paseos para aprender las técnicas y la composición de su obra\r\ntécnicas y composición."
    ],
    "nl": [
      "Als fotograaf, schilder en dichter biedt ze haar oog, haar fotografische vaardigheden en wandelingen aan om de technieken en compositie van haar werk te leren\r\ntechnieken en compositie."
    ]
  },
