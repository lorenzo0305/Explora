  "rdfs:comment": {
    "de": [
      "Bim Bam Buzz! Quizspiele zum Buzzen wie auf einem TV-Set in Clermont-Ferrand!\r\nDas erste immersive Quiz, bei dem jeder gewinnen kann und du 100 Mal mehr lachen wirst als auf deiner Couch."
    ],
    "en": [
      "Bim Bam Buzz! Quiz games to buzz like on a TV set in Clermont-Ferrand!\r\nThe first immersive quiz where everyone can win, and where you'll laugh 100 times more than on your couch."
    ],
    "it": [
      "Bim Bam Buzz! Giochi a quiz per ridere come su un set televisivo a Clermont-Ferrand!\r\nIl primo quiz immersivo dove tutti possono vincere e si ride 100 volte di più che sul divano di casa."
    ],
    "fr": [
      "Bim Bam Buzz ! Des jeux de quiz pour buzzer comme sur un plateau TV à Clermont-Ferrand !\r\nLe premier quiz immersif où tout le monde peut gagner et où tu rigoleras 100 fois plus que dans ton canap'."
    ],
    "es": [
      "Bim Bam ¡Buzz! ¡Juegos de preguntas para zumbar como en un plató de televisión en Clermont-Ferrand!\r\nEl primer quiz inmersivo en el que todos pueden ganar y en el que te reirás 100 veces más que en tu sofá."
    ],
    "nl": [
      "Bim Bam Zoem! Quizspellen om te zoemen als op een tv-toestel in Clermont-Ferrand!\r\nDe eerste meeslepende quiz waarbij iedereen kan winnen en je 100 keer harder zult lachen dan op je bank."
    ]
  },
