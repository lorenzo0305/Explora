  "rdfs:comment": {
    "de": [
      "Dieses Restaurant ist auf regionale Küche spezialisiert : hechtklöße"
    ],
    "en": [
      "A typical setting (wood and stone decor) with a wood-fired oven for excellent homemade pizzas. Other specialities: pike quenelle with Nantua sauce au gratin, crayfish tail and quenelle gratin, perch fillet"
    ],
    "it": [
      "Ambiente tipico (arredamento in legno e pietra) con forno a legna per ottime pizze fatte in casa. Altre specialità: quenelle di luccio con salsa Nantua gratinata, coda di gambero e quenelle gratinate, filetto di pesce persico, ecc"
    ],
    "fr": [
      "Un cadre typique (décoration bois et pierre) avec son four à bois pour déguster d'excellentes pizzas maison. Autres spécialités : quenelle de brochet sauce Nantua gratinée, gratin de queues d'écrevisses et de quenelle, filet de perche"
    ],
    "es": [
      "Un marco típico (decoración de madera y piedra) con un horno de leña para excelentes pizzas caseras. Otras especialidades: quenelle de lucio con salsa Nantua gratinada, cola de cangrejo de río y quenelle gratinada, filete de perca, etc"
    ],
    "nl": [
      "Een typisch decor (hout en steen) met een houtoven voor uitstekende zelfgemaakte pizza's. Andere specialiteiten: quenelle van snoek met gegratineerde Nantua-saus, rivierkreeftstaart en quenelle gegratineerd, baarsfilet, enz"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant No Limit"
    ]
  },
