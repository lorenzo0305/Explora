  "rdfs:comment": {
    "de": [
      "Machen Sie eine Pause in der Bäckerei und Konditorei Massardier. Gutes Brot, Gebäck, Feinkost und Konditoreiwaren. Hier gibt es für jede Tageszeit etwas!\r\nSie können auch von einer kleinen Terrasse profitieren."
    ],
    "en": [
      "Take a break at the Massardier bakery and patisserie. Good bread, viennoiserie, delicatessen and patisserie... There's something for every hour of the day!\r\nYou can also enjoy a small terrace."
    ],
    "it": [
      "Venite a fare una pausa nella panetteria e pasticceria Massardier. Buon pane, pasticceria viennese, specialità gastronomiche e dolci. C'è qualcosa per ogni ora del giorno!\r\nÈ inoltre possibile usufruire di una piccola terrazza."
    ],
    "fr": [
      "Venez prendre un pause à la boulangerie patisserie Massardier. Bon pain, viennoiserie, traiteur et pâtisserie.. Il y en aura pour chaque heure de la journée !\r\nVous pourrez, également profitez d'un petite terrasse."
    ],
    "es": [
      "Venga a hacer una pausa en la panadería y pastelería Massardier. Buen pan, bollería, delicatessen y pastelería. ¡Hay algo para cada hora del día!\r\nTambién podrá disfrutar de una pequeña terraza."
    ],
    "nl": [
      "Kom en neem een pauze bij bakkerij en patisserie Massardier. Lekker brood, Weens gebak, delicatessen en gebak. Er is iets voor elk uur van de dag!\r\nU kunt ook genieten van een klein terras."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Boulangerie pâtisserie MASSARDIER"
    ]
  },
