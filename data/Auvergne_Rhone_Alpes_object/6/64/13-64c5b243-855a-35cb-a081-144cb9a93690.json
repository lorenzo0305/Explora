  "rdfs:comment": {
    "de": [
      "Haben Sie eine Frisbee? Der Disc-Golf-Parcours in Les Ozières ist für alle zugänglich und kostengünstig. Bei diesem Spiel wird eine Scheibe in Richtung eines korbförmigen Ziels geworfen."
    ],
    "en": [
      "Got a Frisbee? The disc golf course at Les Ozières is accessible to all and inexpensive. You throw a disc towards a basket-shaped target."
    ],
    "it": [
      "Avete un frisbee? Il campo da disc golf di Les Ozières è accessibile a tutti e poco costoso. Si lancia un disco verso un bersaglio a forma di cesto."
    ],
    "fr": [
      "Vous avez un frisbee ? Le parcours de disc golf des Ozières est accessible à tous et peu onéreux. Il se pratique en lançant un disque en direction d’une cible en forme de panier."
    ],
    "es": [
      "¿Tienes un frisbee? El campo de disc golf de Les Ozières es accesible a todos y barato. Se lanza un disco hacia una diana en forma de cesta."
    ],
    "nl": [
      "Heb je een frisbee? De disc golfbaan in Les Ozières is voor iedereen toegankelijk en niet duur. Je gooit een disc naar een mandvormig doel."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Disc golf"
    ]
  },
