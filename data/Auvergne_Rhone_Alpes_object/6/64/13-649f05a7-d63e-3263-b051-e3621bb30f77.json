  "rdfs:comment": {
    "de": [
      "Tauchen Sie ein in die faszinierende Welt des Mittelalters und erleben Sie ein spannendes Abenteuer bei unserem Escape Game, das vom legendären Fest des Vogelkönigs inspiriert ist."
    ],
    "en": [
      "Immerse yourself in the fascinating world of the Middle Ages and experience a thrilling adventure in our escape game inspired by the legendary feast of the Bird King."
    ],
    "it": [
      "Immergetevi nell'affascinante mondo del Medioevo e vivete un'emozionante avventura nel nostro gioco di fuga ispirato alla leggendaria festa del Re degli Uccelli."
    ],
    "fr": [
      "Plongez dans l'univers fascinant du Moyen Âge et vivez une aventure palpitante lors de notre escape game inspiré de la légendaire fête du Roi de l'oiseau."
    ],
    "es": [
      "Sumérjase en el fascinante mundo de la Edad Media y viva una emocionante aventura en nuestro juego de escape inspirado en la legendaria fiesta del Rey de los Pájaros."
    ],
    "nl": [
      "Dompel je onder in de fascinerende wereld van de Middeleeuwen en beleef een spannend avontuur in ons ontsnappingsspel dat is geïnspireerd op het legendarische festival van de Koning der Vogels."
    ]
  },
