  "rdfs:comment": {
    "de": [
      "Muriel Rosset bildhauert in Marmor, Stein und Holz und wechselt je nach Ausdrucksbedürfnis fröhlich von figurativ zu abstrakt und umgekehrt. Entdecken Sie nach Vereinbarung ihre Welt und ihre Arbeit in ihrem Atelier im Chalet Shambhala."
    ],
    "en": [
      "Muriel Rosset sculpts marble, stone and wood, moving cheerfully from figurative to abstract and vice versa, according to the needs of her expression. Come and discover her world and her work in her studio at Chalet Shambhala, by appointment only."
    ],
    "it": [
      "Muriel Rosset scolpisce marmo, pietra e legno, passando allegramente dal figurativo all'astratto e viceversa, come meglio crede. Venite a scoprire il suo mondo e il suo lavoro nel suo studio allo Chalet Shambhala, solo su appuntamento."
    ],
    "fr": [
      "Muriel Rosset sculpte le marbre, la pierre, le bois, en passant allègrement du figuratif à l'abstrait et inversement selon les besoins de son expression. Venez découvrir, sur rendez-vous, son univers et son travail dans son atelier du Chalet Shambhala."
    ],
    "es": [
      "Muriel Rosset esculpe mármol, piedra y madera, pasando alegremente de lo figurativo a lo abstracto y viceversa según le parece. Venga a descubrir su mundo y su obra en su taller del Chalet Shambhala, con cita previa."
    ],
    "nl": [
      "Muriel Rosset beeldhouwt marmer, steen en hout, waarbij ze naar eigen inzicht vrolijk beweegt van figuratief naar abstract en vice versa. Kom en ontdek haar wereld en haar werk in haar atelier in Chalet Shambhala, alleen op afspraak."
    ]
  },
  "rdfs:label": {
    "en": [
      "Mu\" movement sculptor workshop"
    ],
    "fr": [
      "Atelier \"Mu\" sculptrice du mouvement"
    ]
  },
