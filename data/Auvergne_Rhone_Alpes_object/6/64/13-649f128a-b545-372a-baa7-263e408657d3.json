  "rdfs:comment": {
    "de": [
      "Produzent von biologischer Spirulina mit Sitz in der Combe de Savoie. Die Aquakulturfarm besteht aus 3 Zuchtbecken mit einer Gesamtfläche von 800m². Wir empfangen Gruppen und Einzelpersonen für pädagogische Besichtigungen und veranstalten regelmäßig Tage der offenen Tür."
    ],
    "en": [
      "Organic spirulina producer located in Combe de Savoie. The farm consists of 3 cultivation basins totaling 800m². We welcome groups and individuals for educational visits, and organize regular open-house events."
    ],
    "it": [
      "Produttore di spirulina biologica situato a Combe de Savoie. L'azienda è composta da 3 stagni di coltivazione per un totale di 800 m². Accogliamo gruppi e singoli per visite didattiche e organizziamo regolarmente giornate di apertura."
    ],
    "fr": [
      "Producteur de spiruline biologique  situé en Combe de Savoie. La ferme aquacole est composée de 3 bassins de culture totalisant 800m². Nous accueillons groupes et particuliers pour des visites pédagogiques et organisons des portes ouvertes régulièrement."
    ],
    "es": [
      "Productor de espirulina ecológica situado en Combe de Savoie. La explotación consta de 3 estanques de cultivo que suman 800 m². Acogemos a grupos y particulares para visitas pedagógicas y organizamos regularmente jornadas de puertas abiertas."
    ],
    "nl": [
      "Biologische spirulina producent gevestigd in Combe de Savoie. De boerderij bestaat uit 3 kweekvijvers van in totaal 800m². We ontvangen groepen en individuen voor educatieve bezoeken en organiseren regelmatig open dagen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Spiruline des Alpes"
    ]
  },
