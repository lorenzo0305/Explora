  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/128706c5-133d-3a10-abdc-e5fa923d4854",
      "dc:description": {
        "de": [
          "Freitag, 1. September 2023\n\nÖffentliches Training der englischen Rugby-Nationalmannschaft.\n15 Uhr - Sportzentrum\nBegrenzte Plätze, Anmeldung erforderlich.\n\nNoch ein wenig Geduld... in Kürze Online-Ticketing."
        ],
        "en": [
          "Friday, September 1, 2023\n\nEngland Rugby public training session.\n3pm - Sports Center\nLimited places, registration required.\n\nPlease be patient... online ticketing coming soon."
        ],
        "it": [
          "Venerdì 1 settembre 2023\n\nAllenamento pubblico dell'Inghilterra Rugby.\nore 15:00 - Centro sportivo\nI posti sono limitati, è richiesta la registrazione.\n\nSi prega di essere pazienti... presto sarà possibile acquistare i biglietti online."
        ],
        "fr": [
          "Vendredi 1er septembre 2023\n\nEntraînement public de l'équipe d'Angleterre de Rugby.\n15h - Centre sportif\nPlaces limitées, sur inscription.\n\nEncore un peu de patience... prochainement, billetterie en ligne."
        ],
        "nl": [
          "Vrijdag 1 september 2023\n\nOpenbare training Engeland Rugby.\n15.00 uur - Sportcentrum\nPlaatsen zijn beperkt, registratie verplicht.\n\nNog even geduld... online kaartverkoop binnenkort."
        ],
        "es": [
          "Viernes 1 de septiembre de 2023\n\nSesión de entrenamiento pública de Inglaterra Rugby.\n15.00 h - Polideportivo\nPlazas limitadas, inscripción obligatoria.\n\nPor favor, sea paciente ... venta de entradas en línea muy pronto."
        ]
      },
