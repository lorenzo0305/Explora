  "rdfs:comment": {
    "de": [
      "Mietservice für Fahrräder + Ausrüstung (Carbon-Rennen, Reisen, Ausflüge, Mountainbikes, Kinderfahrräder und Anhänger oder Babysitze) mit persönlichem Lieferservice an jeden Ort (Bahnhöfe, Grüne Wege, Unterkünfte, große markierte Routen usw.)"
    ],
    "en": [
      "Bike rental service + equipment (carbon racing, travel, touring, mountain bikes, children's bikes and trailers or baby seats) with personalized delivery service to all points (train stations, greenways, accommodation, major marked routes, etc.)"
    ],
    "it": [
      "Servizio di noleggio bici + attrezzatura (bici da corsa in carbonio, da turismo, mountain bike, bici per bambini e rimorchi o seggiolini) con servizio di consegna personalizzato in tutti i punti (stazioni, greenways, alloggi, grandi itinerari segnalati, ecc.)"
    ],
    "fr": [
      "Service de location de vélos + équipement (course carbone, voyage, balade, VTT, vélos enfants et remorques ou sièges bébés) avec service de livraison personnalisée en tous points (gares, voies vertes, hébergements, grands itinéraires balisés, etc.)"
    ],
    "es": [
      "Servicio de alquiler de bicicletas + material (carbono racing, paseo, BTT, bicicletas para niños y remolques o sillas para bebés) con servicio de entrega personalizado en todos los puntos (estaciones, vías verdes, alojamientos, grandes rutas señalizadas, etc.)"
    ],
    "nl": [
      "Fietsverhuur + uitrusting (carbon racefietsen, toerfietsen, mountainbikes, kinderfietsen en aanhangers of babyzitjes) met gepersonaliseerde leveringsservice naar alle punten (stations, groene wegen, accommodaties, grote bewegwijzerde routes, enz.)"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Véloglobe - Location de vélos"
    ]
  },
