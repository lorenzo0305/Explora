  "rdfs:comment": {
    "de": [
      "Plan7 © ist eine 2018 gegründete Marke für handgefertigte Skateboards. Sie werden in unserem Atelier (Atelier Temps Libre ©ATL) in der Ardèche aus 100% französischem Holz hergestellt und können nach starken ökologisch-verantwortlichen Prinzipien personalisiert werden."
    ],
    "en": [
      "Plan7 © is a brand of artisanal skateboard decks created in 2018. Made in Ardèche in our workshop (Atelier Temps Libre © ATL) in 100% French wood, customizable around strong eco-responsible principles."
    ],
    "it": [
      "Plan7 © è un marchio di skateboard artigianale creato nel 2018. Realizzato in Ardèche nel nostro laboratorio (Atelier Temps Libre ©ATL) con legno 100% francese, personalizzabile secondo principi fortemente eco-responsabili."
    ],
    "fr": [
      "Plan7 © est une marque de planche de skateboard artisanale créée en 2018. Fabriquées en Ardèche au sein de notre atelier (Atelier Temps Libre ©ATL) en bois d'essence 100% française, personnalisables autour de principe éco-responsables forts."
    ],
    "nl": [
      "Plan7 © is een ambachtelijk skateboardmerk opgericht in 2018. Gemaakt in de Ardèche in ons atelier (Atelier Temps Libre ©ATL) van 100% Frans hout, aanpasbaar rond sterke eco-verantwoordelijke principes."
    ],
    "es": [
      "Plan7 © es una marca de monopatines artesanales creada en 2018. Fabricado en Ardèche en nuestro taller (Atelier Temps Libre ©ATL) a partir de madera 100% francesa, personalizable en torno a fuertes principios eco-responsables."
    ]
  },
