  "rdfs:comment": {
    "de": [
      "Die Mediathek im Dorfzentrum bietet eine große Auswahl an Jugend- und Erwachsenenliteratur (Romane, Krimis, Biografien, Dokumentarfilme, Comics....) sowie 6 Computer mit Internetzugang. Sie ist auch ein Ort für Ausstellungen und Workshops."
    ],
    "en": [
      "The media library in the village center offers a wide choice of books for young people and adults (novels, thrillers, biographies, documentaries, comics....), as well as 6 computers with Internet access. It is also a venue for exhibitions and workshops."
    ],
    "it": [
      "La mediateca nel centro del paese offre un'ampia gamma di libri per giovani e adulti (romanzi, thriller, biografie, documentari, fumetti....) e 6 computer con accesso a Internet. È anche sede di mostre e laboratori."
    ],
    "fr": [
      "La médiathèque située dans le centre du village propose un large choix d'ouvrages jeunesse et adulte (romans, polars, biographies, documentaires, BD…) ainsi que 6 ordinateurs avec accès internet. C'est aussi un lieu d'accueil d'expositions et ateliers."
    ],
    "es": [
      "La mediateca del centro del pueblo ofrece una amplia gama de libros para jóvenes y adultos (novelas, thrillers, biografías, documentales, cómics, etc.), así como 6 ordenadores con acceso a Internet. También acoge exposiciones y talleres."
    ],
    "nl": [
      "De mediatheek in het dorpscentrum biedt een breed scala aan boeken voor jongeren en volwassenen (romans, thrillers, biografieën, documentaires, stripboeken ....) en 6 computers met internettoegang. Er worden ook tentoonstellingen en workshops gehouden."
    ]
  },
