  "rdfs:comment": {
    "de": [
      "Schnelle Verpflegung\nherzhaft oder süß\nsandwiches Panini Frite Kebab ( am Spieß und halal) Amerikanische Hamburger....\neiscreme Waffeln Paninis....\nmehrere Menüs, darunter ein Kindermenü\nmöglichkeit eines Picknickmenüs\nangepasstes Menü für Gruppen oder verschiedene Veranstaltungen"
    ],
    "en": [
      "Fast food\nsavoury or sweet\npanini sandwiches fried kebab (spit-roasted and halal) american hamburger....\nice creams waffles paninis....\nseveral menus including a children's menu\npicnic menu available\nmenu adapted for groups or various events"
    ],
    "it": [
      "Cibo veloce\nsalato o dolce\npanini panini kebab fritto (allo spiedo e halal) hamburger americano....\ngelati waffle panini....\ndiversi menu, compreso un menu per bambini\nmenu per picnic disponibile\nmenu adattato per gruppi o eventi vari"
    ],
    "fr": [
      "Restauration rapide\nsalé ou sucré \nsandwiches paninis frite kebab ( en broche et halal) hamburger américain....\nglaces gaufres paninis....\nplusieurs menus dont un menu enfants \npossibilité de menu pique nique\nmenu adapté pour groupe ou divers manifestations"
    ],
    "nl": [
      "Snel eten\nhartig of zoet\nbroodjes panini gebakken kebab (aan het spit geroosterd en halal) Amerikaanse hamburger....\nijs wafels panini's....\nverschillende menu's waaronder een kindermenu\npicknickmenu beschikbaar\naangepast menu voor groepen of diverse evenementen"
    ],
    "es": [
      "Comida rápida\nsalada o dulce\nsándwiches panini kebab frito (asado y halal) hamburguesa americana....\nhelados gofres paninis....\nvarios menús, incluido un menú infantil\nmenú picnic disponible\nmenú adaptado para grupos o eventos diversos"
    ]
  },
