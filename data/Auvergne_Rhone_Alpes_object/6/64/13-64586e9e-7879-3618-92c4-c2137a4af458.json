  "rdfs:comment": {
    "de": [
      "Der Gedenkweg \"Marx Dormoy\" in Montluçon besteht aus 10 erklärenden Tafeln mit QR-Code, die gescannt werden müssen, und ermöglicht es, die Leistungen des ehemaligen Bürgermeisters der Stadt zu entdecken. Eine Initiative des Vereins Montluçon Patrimoine."
    ],
    "en": [
      "The \"Marx Dormoy\" memorial trail in Montluçon consists of 10 explanatory plaques with QR codes to scan, enabling visitors to discover the achievements of the town?s former mayor. An initiative of the Montluçon Patrimoine association."
    ],
    "it": [
      "Composto da 10 targhe esplicative con codici QR da scansionare, il percorso commemorativo \"Marx Dormoy\" di Montluçon rivela le imprese dell'ex sindaco della città. Un'iniziativa dell'associazione Montluçon Patrimoine."
    ],
    "fr": [
      "Composé de 10 plaques explicatives avec QR code à scanner, le parcours mémoriel \"Marx Dormoy\" à Montluçon permet de découvrir les réalisations effectuées par l’ancien maire de la ville. Une initiative de l'association Montluçon Patrimoine."
    ],
    "nl": [
      "Het gedenkpad \"Marx Dormoy\" in Montluçon bestaat uit 10 borden met uitleg en QR-codes om te scannen en laat de prestaties van de voormalige burgemeester van Montluçon zien. Een initiatief van de vereniging Montluçon Patrimoine."
    ],
    "es": [
      "Con 10 placas explicativas con códigos QR para escanear, el sendero conmemorativo \"Marx Dormoy\" de Montluçon revela los logros del antiguo alcalde de la ciudad. Una iniciativa de la asociación Montluçon Patrimoine."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parcours mémoriel : Marx Dormoy"
    ]
  },
