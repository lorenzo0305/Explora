  "rdfs:comment": {
    "de": [
      "Das Restaurant le So'Chris, ehemals La Ruche, wechselt in Cordon seinen Namen und den Besitzer.\r\nLe So'Chris bietet Ihnen eine hausgemachte und saisonale Speisekarte mit der lang ersehnten Rückkehr der Pizzen."
    ],
    "en": [
      "The So'Chris restaurant, formerly La Ruche, changes name and owner in Cordon.\r\nLe So'Chris offers a home-made, seasonal menu, with the long-awaited return of pizzas."
    ],
    "it": [
      "Il ristorante So'Chris, precedentemente noto come La Ruche, cambia nome e proprietario a Cordon.\r\nSo'Chris offre un menu casalingo e stagionale, con il tanto atteso ritorno della pizza."
    ],
    "fr": [
      "Le restaurant le So'Chris anciennement La Ruche, change de nom et de propriétaire à Cordon. \r\nLe So'Chris vous propose une carte faite maison et de saison, avec le retour tant attendu des pizzas."
    ],
    "nl": [
      "Restaurant So'Chris, voorheen bekend als La Ruche, verandert van naam en eigenaar in Cordon.\r\nSo'Chris biedt een huisgemaakt, seizoensgebonden menu, met de langverwachte terugkeer van pizza's."
    ],
    "es": [
      "El restaurante So'Chris, antes conocido como La Ruche, cambia de nombre y de propietario en Cordon.\r\nSo'Chris ofrece un menú casero y de temporada, con el esperado regreso de las pizzas."
    ]
  },
