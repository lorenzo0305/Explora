  "rdfs:comment": {
    "de": [
      "Einführung für Anfänger und freies Spiel für Fortgeschrittene.\r\nKommen Sie und entdecken Sie die Welt des Schachs! Schachsitzungen mit dem Verein L'échiquier montluçonnais.\r\nAb 6 Jahren, Reservierung empfohlen."
    ],
    "en": [
      "Initiation for beginners and free play for advanced players.\r\nCome and discover the world of chess! Chess sessions with the association L'échiquier montluçonnais.\r\nAges 6 and up, booking recommended."
    ],
    "it": [
      "Iniziazione per i principianti e gioco libero per i giocatori esperti.\r\nVenite a scoprire il mondo degli scacchi! Sessioni di scacchi con l'associazione L'échiquier montluçonnais.\r\nA partire dai 6 anni, prenotazione consigliata."
    ],
    "fr": [
      "Initiation pour débutants et jeu libre pour confirmés.\r\nVenez découvrir le monde des échecs ! Séances d'échecs avec l'association L'échiquier montluçonnais.\r\nDès 6 ans, réservation conseillée."
    ],
    "nl": [
      "Initiatie voor beginners en vrij spelen voor gevorderden.\r\nKom en ontdek de wereld van het schaken! Schaaksessies met de vereniging L'échiquier montluçonnais.\r\nVanaf 6 jaar, reserveren aanbevolen."
    ],
    "es": [
      "Iniciación para principiantes y juego libre para jugadores avanzados.\r\n¡Ven a descubrir el mundo del ajedrez! Sesiones de ajedrez con la asociación L'échiquier montluçonnais.\r\nA partir de 6 años, se recomienda reservar."
    ]
  },
  "rdfs:label": {
