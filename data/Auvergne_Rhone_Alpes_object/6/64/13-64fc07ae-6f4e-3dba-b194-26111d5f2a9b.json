  "rdfs:comment": {
    "de": [
      "Entdecken Sie Dunières mit Michel Haudiquez, einem leidenschaftlichen Anhänger der Lokal- und Eisenbahngeschichte. Anekdoten, Kulturerbe und die Entwicklung der Züge (SNCF, CFD, VFV) erwarten Sie bei diesem einzigartigen Rundgang. Reservierung Office de Tourisme: 04 71 59 95 73."
    ],
    "en": [
      "Discover Dunières with Michel Haudiquez, passionate about local and railway history. Anecdotes, heritage and the evolution of trains (SNCF, CFD, VFV) await you on this unique tour. Tourist Office booking: 04 71 59 95 73."
    ],
    "it": [
      "Scoprite Dunières con Michel Haudiquez, appassionato di storia locale e ferroviaria. Aneddoti, patrimonio e l'evoluzione dei treni (SNCF, CFD, VFV) vi aspettano in questo tour unico. Prenotazione all'Ufficio del Turismo: 04 71 59 95 73."
    ],
    "fr": [
      "Découvrez Dunières avec Michel Haudiquez, passionné d'histoire locale et ferroviaire. Anecdotes, patrimoine et évolution des trains (SNCF, CFD, VFV) vous attendent lors de cette visite unique. Réservation Office de Tourisme : 04 71 59 95 73."
    ],
    "nl": [
      "Ontdek Dunières met Michel Haudiquez, die gepassioneerd is door de plaatselijke en spoorweggeschiedenis. Anekdotes, erfgoed en de evolutie van treinen (SNCF, CFD, VFV) wachten op je tijdens deze unieke rondleiding. Reservering bij het toeristenbureau: 04 71 59 95 73."
    ],
    "es": [
      "Descubra Dunières de la mano de Michel Haudiquez, un apasionado de la historia local y ferroviaria. Anécdotas, patrimonio y evolución de los trenes (SNCF, CFD, VFV) le esperan en este recorrido único. Reservas en la Oficina de Turismo: 04 71 59 95 73."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ambassadeurs de territoire: chemin de fer et histoire de Dunières"
    ]
  },
