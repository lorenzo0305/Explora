  "rdfs:comment": {
    "de": [
      "Les Sources du Bien-être bedeutet, sich Zeit zu gönnen, um sich zu verwöhnen, zu entspannen, sich selbst zu finden...\r\nWellness-Massagen allein oder zu zweit, Gesichtsbehandlungen, Wellness-Kuren. Privater Balneo-Bereich und Aqua-Entspannungspool."
    ],
    "en": [
      "Les Sources du Bien-être is all about taking time out to pamper yourself, relax and rediscover yourself...\r\nWellness massages (solo or duo), facial treatments, wellness cures. Private balneotherapy area and aqua relax pool."
    ],
    "it": [
      "Les Sources du Bien-être si propongono di prendersi del tempo per coccolarsi, rilassarsi e riscoprirsi...\r\nMassaggi benessere (da soli o in coppia), trattamenti viso, cure benessere. Area privata per la balneoterapia e piscina aqua relax."
    ],
    "fr": [
      "Les Sources du Bien-être, c'est s'accorder du temps pour se faire plaisir, se détendre, se retrouver...\r\nMassages bien-être en solo, duo, soins du visage, cure bien-être. Espace balnéo et piscine aqua relax privatisés."
    ],
    "es": [
      "En Les Sources du Bien-être se trata de tomarse un tiempo para mimarse, relajarse y redescubrirse...\r\nMasajes de bienestar (solo o en pareja), tratamientos faciales, curas de bienestar. Zona de balneoterapia privada y piscina aqua relax."
    ],
    "nl": [
      "Bij Les Sources du Bien-être gaat het erom tijd vrij te maken om jezelf te verwennen, te ontspannen en te herontdekken...\r\nWellnessmassages (solo of duo), gezichtsbehandelingen, wellnesskuren. Privé balneoruimte en aqua relax zwembad."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Spa Les Sources du Bien-Être"
    ]
  },
