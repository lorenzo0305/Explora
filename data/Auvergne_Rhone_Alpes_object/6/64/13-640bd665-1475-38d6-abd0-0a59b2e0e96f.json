  "rdfs:comment": {
    "de": [
      "Ein Concept Store, in dem man sich Zeit nehmen kann, mit Spezialitätenkaffee (geröstet in Crest), Konditoreiwaren von Maison Mathi, lokalem Fruchtsaft, Kleidung, Deko, Schreibwaren und Schmuck..."
    ],
    "en": [
      "A concept store, where you can take your time with specialty coffees (roasted in Crest), Maison Mathi pastries, local fruit juice, clothes, decoration, stationery and jewelry..."
    ],
    "it": [
      "Un concept store in cui ci si può prendere tutto il tempo necessario, con caffè speciali (tostati a Crest), pasticceria Maison Mathi, succhi di frutta locali, vestiti, decorazioni, cancelleria e gioielli..."
    ],
    "fr": [
      "Un concept store, où prendre le temps avec des cafés de spécialité (torréfié à Crest), de la pâtisserie Maison Mathi, du jus de fruits local, des fringues, de la déco, de la papeterie et des bijoux..."
    ],
    "es": [
      "Un concept store donde podrá tomarse su tiempo, con especialidades de café (tostado en Crest), bollería de la Maison Mathi, zumos de frutas locales, ropa, decoración, papelería y joyería..."
    ],
    "nl": [
      "Een conceptwinkel waar je de tijd kunt nemen, met koffiespecialiteiten (gebrand in Crest), gebak van Maison Mathi, lokale vruchtensappen, kleding, decoraties, schrijfwaren en sieraden..."
    ]
  },
