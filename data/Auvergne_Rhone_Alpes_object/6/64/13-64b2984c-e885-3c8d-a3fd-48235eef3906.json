  "rdfs:comment": {
    "de": [
      "Der zentrale Platz des Hauptortes der Gemeinde Albiez-Montrond ist der Treffpunkt des Dorfes und mit einer Skulptur ausgestattet, die von dem gleichnamigen Messer inspiriert ist. Er ist das Ziel der touristischen Opinel-Route und der Ort zahlreicher Veranstaltungen."
    ],
    "en": [
      "The central square in the village of Albiez-Montrond is the focal point of the village and features a sculpture inspired by the knife of the same name. It is the arrival point for the Opinel tourist route and the venue for numerous events."
    ],
    "it": [
      "La piazza centrale del villaggio di Albiez-Montrond è il punto focale del paese e presenta una scultura ispirata all'omonimo coltello. È il punto di arrivo dell'itinerario turistico Opinel e sede di numerosi eventi."
    ],
    "fr": [
      "Point de ralliement du village, la place centrale du Chef-lieu de la commune d’Albiez-Montrond est dotée d’une sculpture inspirée par le couteau du même nom. Elle est l'arrivée de la route touristique de l'Opinel et le lieu de nombreuses animations."
    ],
    "es": [
      "La plaza central del pueblo de Albiez-Montrond es el punto neurálgico de la localidad y cuenta con una escultura inspirada en el cuchillo del mismo nombre. Es el punto de llegada de la ruta turística Opinel y sede de numerosos eventos."
    ],
    "nl": [
      "Het centrale plein in het dorp Albiez-Montrond is het middelpunt van het dorp en heeft een sculptuur die geïnspireerd is op het mes met dezelfde naam. Het is het aankomstpunt van de toeristische route van Opinel en de locatie voor talrijke evenementen."
    ]
  },
