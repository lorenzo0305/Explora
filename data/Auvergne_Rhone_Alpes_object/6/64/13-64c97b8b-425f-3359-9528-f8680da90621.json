  "rdfs:comment": {
    "de": [
      "Schenken Sie ein originelles Erlebnis an einem einzigartigen Ort und privatisieren Sie dieses Schloss aus dem 19. Jahrhundert, das 2009 aufgrund seiner Architektur, seiner Terrassen, seines Parks und seiner Perspektiven zum historischen Monument erklärt wurde..."
    ],
    "en": [
      "Offer an original experience in a unique location, by privatizing this 19th-century château, listed as a Historic Monument in 2009 for its architecture, terraces, park and views..."
    ],
    "it": [
      "Concedetevi un'esperienza originale in un luogo unico, con una visita privata di questo castello del XIX secolo, classificato come Monumento Storico nel 2009 per la sua architettura, le sue terrazze, il suo parco e la sua vista..."
    ],
    "fr": [
      "Offrez une expérience originale dans un lieu unique, en privatisant ce château du XIXe, classé Monument Historique en 2009 pour son architecture, ses terrasses, son parc et ses perspectives…"
    ],
    "nl": [
      "Trakteer uzelf op een originele ervaring op een unieke locatie, met een privérondleiding door dit 19e-eeuwse kasteel, dat in 2009 op de monumentenlijst is geplaatst vanwege zijn architectuur, terrassen, park en uitzicht..."
    ],
    "es": [
      "Regálese una experiencia original en un entorno único, con una visita privada a este castillo del siglo XIX, declarado Monumento Histórico en 2009 por su arquitectura, sus terrazas, su parque y sus vistas.."
    ]
  },
