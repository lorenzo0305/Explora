  "rdfs:comment": {
    "de": [
      "Markus: seit 20 Jahren Vorreiter für handwerklich gebrautes Bier in der Drôme.\r\nDie Brauerei Markus befindet sich im Herzen der provenzalischen Drôme in Cléon d'Andran, zwischen Montélimar und Dieulefit, nur einen Katzensprung vom Vercors und der sonnigen Provence entfernt."
    ],
    "en": [
      "Markus : forerunner of the craft beer in the Drôme since 20 years.\r\nThe Markus Brewery is located in the heart of the Drôme provençale in Cléon d'Andran, between Montélimar and Dieulefit, a stone's throw from the Vercors and the sun of Provence."
    ],
    "it": [
      "La Brasserie Markus, precursore della birra artigianale nella Drôme, è il luogo dove la convivialità regna sovrana!"
    ],
    "fr": [
      "La Brasserie Markus, précurseur de la bière artisanale dans la Drôme, c’est l’adresse où la convivialité règne en maître !"
    ],
    "nl": [
      "Markus: al 20 jaar voorloper van het ambachtelijke bier in de Drôme.\r\nDe brouwerij Markus ligt in het hart van de Drôme provençale in Cléon d'Andran, tussen Montélimar en Dieulefit, op een steenworp afstand van de Vercors en de zon van de Provence."
    ],
    "es": [
      "La Brasserie Markus, precursora de la cerveza artesanal en la Drôme, es el lugar donde reina la convivencia"
    ]
  },
