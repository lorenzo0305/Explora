  "rdfs:comment": {
    "de": [
      "Die unumgänglichen Sehenswürdigkeiten des Plateau d'Hauteville!\r\nEine Route für Wanderer, die reich an Natur und großen, bemerkenswerten Räumen ist, in denen das Wasser eine wesentliche Rolle in der Landschaft und bei der Freizeitgestaltung spielt."
    ],
    "en": [
      "The must-sees of the Hauteville plateau!\r\nAn itinerary for backpackers, rich in nature and remarkable wide-open spaces, where water plays an essential role in landscapes and leisure activities."
    ],
    "it": [
      "I luoghi imperdibili dell'altopiano di Hauteville!\r\nUn itinerario per viaggiatori zaino in spalla, ricco di natura e di notevoli spazi aperti, dove l'acqua gioca un ruolo essenziale nel paesaggio e nelle attività di svago."
    ],
    "fr": [
      "Les incontournables du plateau d'Hauteville !\r\nUn itinéraire pour les baroudeurs riche de nature, de grands espaces remarquables où l’eau joue un rôle essentiel dans les paysages et les loisirs."
    ],
    "es": [
      "¡Los imprescindibles de la meseta de Hauteville!\r\nUn itinerario para mochileros, rico en naturaleza y notables espacios abiertos donde el agua desempeña un papel esencial en el paisaje y las actividades de ocio."
    ],
    "nl": [
      "De must-sees van het plateau van Hauteville!\r\nEen route voor rugzaktoeristen, rijk aan natuur en opmerkelijke open ruimten waar water een essentiële rol speelt in het landschap en de vrijetijdsbesteding."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Circuit Jurassic Vélo Tours n°44 - Entre Cascade de Charabotte et Marais de Vaux"
    ]
  },
