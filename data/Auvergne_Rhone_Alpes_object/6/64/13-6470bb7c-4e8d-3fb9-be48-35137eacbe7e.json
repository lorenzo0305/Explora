  "rdfs:comment": {
    "de": [
      "Probieren Sie die von unserem leidenschaftlichen Team angebotenen Köstlichkeiten auf unserer großen Terrasse mit 40 Plätzen und verbringen Sie unvergessliche Momente mit Ihren Freunden, Kollegen oder Ihrer Familie."
    ],
    "en": [
      "Taste the delights offered by our passionate team on our large 40-seat terrace and enjoy unforgettable moments in the company of friends, colleagues or family."
    ],
    "it": [
      "Assaporate le delizie offerte dal nostro team di appassionati sulla nostra grande terrazza da 40 posti e trascorrete momenti indimenticabili in compagnia dei vostri amici, colleghi o familiari."
    ],
    "fr": [
      "Dégustez les délices proposés par notre équipe passionnée sur notre grande terrasse de 40 places et venez passer des moments inoubliables en compagnie de vos amis, vos collègues, ou votre famille."
    ],
    "es": [
      "Saboree las delicias que le ofrece nuestro apasionado equipo en nuestra amplia terraza de 40 plazas y pase unos momentos inolvidables en compañía de sus amigos, colegas o familiares."
    ],
    "nl": [
      "Proef de lekkernijen van ons gepassioneerde team op ons grote terras met 40 zitplaatsen en breng onvergetelijke momenten door in het gezelschap van je vrienden, collega's of familie."
    ]
  },
