  "rdfs:comment": {
    "de": [
      "Die Galerie Momie ist eine unkonventionelle Galerie, in der Originalwerke aus dem Bereich Comics ausgestellt und zum Verkauf angeboten werden. Sie gehört zum Netzwerk der unabhängigen Buchhandlungen Momie, die sich auf Comics, Comicbücher und Mangas spezialisiert haben."
    ],
    "en": [
      "An unconventional gallery, Galerie Momie sells and exhibits original comics-related works in a setting conducive to sharing. It is part of the Momie network of independent bookshops specializing in comics, graphic novels and manga."
    ],
    "it": [
      "Galleria non convenzionale, la Galerie Momie vende ed espone opere originali a fumetti in un ambiente che incoraggia la condivisione. Fa parte della rete Momie di librerie indipendenti specializzate in fumetti, graphic novel e manga."
    ],
    "fr": [
      "Galerie peu conventionnelle, la Galerie Momie propose à la vente et expose des œuvres originales liées à la bande-dessinée dans un cadre propice au partage. Elle fait partie du réseau de librairies indépendantes Momie spécialisées en BD, comics et mangas."
    ],
    "nl": [
      "Galerie Momie, een onconventionele galerie, verkoopt en exposeert originele stripgerelateerde werken in een omgeving die aanzet tot delen. Ze maakt deel uit van het Momie-netwerk van onafhankelijke boekhandels die gespecialiseerd zijn in strips, graphic novels en manga."
    ],
    "es": [
      "Galería poco convencional, Galerie Momie vende y expone obras originales relacionadas con el cómic en un entorno propicio para compartir. Forma parte de la red Momie de librerías independientes especializadas en cómics, novelas gráficas y manga."
    ]
  },
  "rdfs:label": {
    "fr": [
      "la Galerie Momie"
    ]
  },
