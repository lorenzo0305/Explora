  "rdfs:comment": {
    "de": [
      "Das Amphidice ist eine kulturelle Einrichtung der Université Grenoble Alpes. Dieses große und klassische Universitäts-Amphitheater hat verschiedene Wandlungen durchgemacht, bevor es sich in einen echten Veranstaltungssaal mit professionellen Standards verwandelt hat."
    ],
    "en": [
      "Amphidice is a cultural venue at Grenoble Alpes University. This vast, classic university amphitheatre has undergone a number of transformations before being transformed into a fully-fledged, professional-standard auditorium."
    ],
    "it": [
      "L'Amphidice è uno spazio culturale dell'Università di Grenoble Alpes. Questo vasto e classico anfiteatro universitario ha subito diverse trasformazioni prima di essere trasformato in una vera e propria sala per spettacoli di livello professionale."
    ],
    "fr": [
      "L’Amphidice est un lieu culturel de l’Université Grenoble Alpes. Ce vaste et classique amphithéâtre d’université a connu différentes mues avant de se transformer en une véritable salle de spectacle aux normes professionnelles."
    ],
    "es": [
      "El Anfídice es un espacio cultural de la Universidad de Grenoble Alpes. Este inmenso anfiteatro universitario clásico ha sufrido varias transformaciones antes de convertirse en un auditorio de pleno derecho y de nivel profesional."
    ],
    "nl": [
      "De Amphidice is een cultureel centrum van de Universiteit van Grenoble Alpes. Dit grote en klassieke universiteitsamfitheater heeft verschillende transformaties ondergaan voordat het werd omgevormd tot een echte voorstellingszaal van professioneel niveau."
    ]
  },
  "rdfs:label": {
    "fr": [
      "L' Amphidice - salle de spectacle Université Grenoble Alpes"
    ]
  },
