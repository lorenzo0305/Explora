  "rdfs:comment": {
    "de": [
      "Bei fläder finden Sie in einem schlichten Dekor und einer gemütlichen Atmosphäre ein Feinkostgeschäft, einen Teesalon mit hausgemachten Patisserien und originellen salzigen Vorschlägen, die Sie vor Ort genießen oder mitnehmen können."
    ],
    "en": [
      "At fläder, you'll find a delicatessen, a tea room with home-made pastries and original savoury offerings to eat in or take away."
    ],
    "it": [
      "Al fläder troverete una gastronomia, una sala da tè con dolci fatti in casa e originali piatti salati da mangiare o da portare via."
    ],
    "fr": [
      "Chez fläder dans un décors épuré et une ambiance cosy, vous trouverez une épicerie fine, un salon de thé avec des pâtisseries maison et des propositions salés originales à déguster sur place ou à emporter."
    ],
    "es": [
      "En fläder encontrarás una charcutería, un salón de té con repostería casera y originales platos salados para comer en casa o para llevar."
    ],
    "nl": [
      "Bij fläder vind je een delicatessenwinkel, een theesalon met zelfgemaakt gebak en originele hartige gerechten om ter plekke te eten of mee te nemen."
    ]
  },
  "rdfs:label": {
