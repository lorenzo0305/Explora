  "rdfs:comment": {
    "de": [
      "Kampfkunst, die es ermöglicht, Aggressionen zu beherrschen, und Respekt vor dem Abend und dem anderen. Eine Disziplin, die Koordination und Geschicklichkeit fördert. Kampf- und Selbstverteidigungstechnik."
    ],
    "en": [
      "A fighting art that enables you to control aggression and respect yourself and others. Discipline that develops coordination and skill. A fighting and self-defence technique."
    ],
    "it": [
      "Un'arte di combattimento che permette di controllare l'aggressività e di rispettare se stessi e gli altri. Disciplina che sviluppa coordinazione e abilità. Tecnica di combattimento e autodifesa."
    ],
    "fr": [
      "Art de combat qui permet de maîtriser l'agressivité et respect de soir et de l'autre. Discipline qui développe la coordination et l'habileté. Technique de combat et d'auto-défense."
    ],
    "es": [
      "Un arte de lucha que permite controlar la agresividad y respetarse a sí mismo y a los demás. Disciplina que desarrolla la coordinación y la habilidad. Técnica de combate y defensa personal."
    ],
    "nl": [
      "Een vechtkunst die je helpt je agressie te beheersen en jezelf en anderen te respecteren. Een discipline die coördinatie en vaardigheid ontwikkelt. Een vecht- en zelfverdedigingstechniek."
    ]
  },
