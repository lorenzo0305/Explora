  "rdfs:comment": {
    "de": [
      "Das Höhenrestaurant ZIG ZAG, Snack, Bar und Skibar befindet sich direkt auf den Pisten am Fuße der Sessellifte in Auris-en-Oisans. Le Zig Zag bietet eine Austernbar aus dem Arcachon-Becken, der Heimatregion von Guillaume und Ludivine, den Betreibern."
    ],
    "en": [
      "ZIG ZAG mountain restaurant, snack bar, bar and ski bar located right on the slopes, at the foot of the chairlifts in Auris-en-Oisans."
    ],
    "it": [
      "ZIG ZAG ristorante di montagna, snack bar, bar e ski bar situato direttamente sulle piste, ai piedi delle seggiovie di Auris-en-Oisans. Le Zig Zag dispone di un bar di ostriche del bacino di Arcachon, la regione di provenienza di Guillaume e Ludivine, i gestori."
    ],
    "fr": [
      "Restaurant d’altitude du ZIG ZAG, snack, bar et ski bar situé directement sur les pistes, au pied des télésièges à Auris-en-Oisans. Le Zig Zag propose un bar à huitres venant du bassin d'arcachon, région natale de Guillaume et Ludivine, les gérants."
    ],
    "es": [
      "ZIG ZAG restaurante de montaña, snack bar, bar y ski bar situado directamente en las pistas, al pie de los telesillas en Auris-en-Oisans. Le Zig Zag dispone de un bar de ostras de la cuenca de Arcachon, región natal de Guillaume y Ludivine, los gerentes."
    ],
    "nl": [
      "ZIG ZAG bergrestaurant, snackbar, bar en skibar direct aan de piste, aan de voet van de stoeltjesliften."
    ]
  },
  "rdfs:label": {
    "en": [
      "ZIG ZAG - High altitude restaurant"
    ],
    "fr": [
      "ZIG ZAG - Restaurant d'altitude"
    ],
    "nl": [
      "ZIG ZAG - Restaurant op grote hoogte"
    ]
  },
