  "rdfs:comment": {
    "de": [
      "Dieser botanische Garten, der als Jardin remarquable klassifiziert ist, wurde 1906 von Marie-Louise Cognacq-Jaÿ, der Gründerin von La Samaritaine, angelegt."
    ],
    "en": [
      "This botanical garden classified as a remarkable garden was created in 1906 by Marie-Louise Cognacq-Jaÿ, founder of La Samaritaine."
    ],
    "it": [
      "Magnifico giardino creato nel 1906 da Marie Louise Cognac Jaÿ, fondatrice dei grandi magazzini La Samaritaine."
    ],
    "fr": [
      "Ce jardin botanique classé Jardin remarquable a été créé en 1906 par Marie-Louise Cognacq-Jaÿ, fondatrice de La Samaritaine."
    ],
    "es": [
      "Este jardín botánico, catalogado como Jardín Notable, fue creado en 1906 por Marie-Louise Cognacq-Jaÿ, fundadora de La Samaritaine."
    ],
