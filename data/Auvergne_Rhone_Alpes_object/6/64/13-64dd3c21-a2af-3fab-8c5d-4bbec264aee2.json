  "rdfs:comment": {
    "de": [
      "Dieses Spielkasino wurde 1912 von dem Architekten J. A. Hébrard (leitender Architekt der Trinkhalle Cachat und des Hôtel Royal) auf dem Anwesen des Château de Blonay, das 1877 für die Einrichtung eines Spielhauses der Stadt überlassen wurde, errichtet."
    ],
    "en": [
      "Today's casino was designed and built by Albert Hébrard in 1912 in place of the Blonay barons' castle which burned down the year before"
    ],
    "it": [
      "L'attuale casinò fu costruito nel 1912 dall'architetto Albert Hébrard al posto del castello dei baroni di Blonay, distrutto l'anno precedente."
    ],
    "fr": [
      "L’actuel casino est construit en 1912 par l’architecte Albert Hébrard à la place du château des barons de Blonay, détruit l’année précédente."
    ],
    "nl": [
      "Het huidige casino werd in 1912 gebouwd door architect Albert Hébrard op de plek van het Château des Barons de Blonay, dat het jaar daarvoor was afgebroken."
    ],
    "es": [
      "El actual casino fue construido en 1912 por el arquitecto Albert Hébrard en lugar del castillo de los barones de Blonay, que había sido destruido el año anterior."
    ]
  },
