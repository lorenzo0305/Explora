  "rdfs:comment": {
    "de": [
      "Sonntag 15. März\n 15h ? 17h\n 12 rue des Sources St Louis, 60700 ? Pontpoint\nVeranstaltung nur für Frauen\n\nKreativer und leckerer Workshop, in dem Sie lernen, Ihren eigenen Bento Cake zu dekorieren.\nWorkshop unter der Leitung von Marbre Pâtisserie.\n\n Anmeldung erforderlich: https://www.billetweb.fr/bento-cake-but-make-it-girly"
    ],
    "en": [
      "Sunday, March 15\n 15h ? 17h\n 12 rue des Sources St Louis, 60700 ? Pontpoint\nWomen-only event\n\nA creative, gourmet workshop to learn how to decorate your own bento cake, in a friendly atmosphere.\nWorkshop led by Marbre Pâtisserie.\n\n Registration required: https://www.billetweb.fr/bento-cake-but-make-it-girly"
    ],
    "it": [
      "Domenica 15 marzo\n 15h ? 17h\n 12 rue des Sources St Louis, 60700 ? Pontpoint\nEvento per sole donne\n\nUn laboratorio creativo e delizioso per imparare a decorare la propria torta bento, in un'atmosfera amichevole.\nCondotto da Marbre Pâtisserie.\n\n Iscrizione obbligatoria: https://www.billetweb.fr/bento-cake-but-make-it-girly"
    ],
    "fr": [
      "Dimanche 15 mars\n 15h – 17h\n 12 rue des Sources St Louis, 60700 – Pontpoint\nÉvénement réservé aux femmes\n\nAtelier créatif et gourmand pour apprendre à décorer son propre bento cake, dans une ambiance conviviale.\nAtelier animé par Marbre Pâtisserie.\n\n Inscription obligatoire : https://www.billetweb.fr/bento-cake-but-make-it-girly"
    ],
    "nl": [
      "Zondag 15 maart\n 15h ? 17h\n 12 rue des Sources St Louis, 60700 ? Pontpoint\nAlleen voor vrouwen\n\nEen creatieve en heerlijke workshop om je eigen bentotaart te leren versieren, in een gezellige sfeer.\nOnder leiding van Marbre Pâtisserie.\n\n Registratie verplicht: https://www.billetweb.fr/bento-cake-but-make-it-girly"
    ],
    "es": [
      "Domingo 15 de marzo\n 15h ? 17h\n 12 rue des Sources St Louis, 60700 ? Pontpoint\nEvento sólo para mujeres\n\nUn taller creativo y delicioso para aprender a decorar su propio pastel bento, en un ambiente agradable.\nImpartido por Marbre Pâtisserie.\n\n Inscripción obligatoria: https://www.billetweb.fr/bento-cake-but-make-it-girly"
    ]
  },
