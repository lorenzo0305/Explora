  "rdfs:comment": {
    "de": [
      "Im Restaurant wird familiär gekocht. Genießen Sie Froschschenkel mit Petersilie, Kartoffelraspeln und andere Spezialitäten des Hauses.\r\nMittags gibt es ein Tagesmenü mit einem Buffet aus Vorspeisen, warmen Gerichten und Desserts."
    ],
    "en": [
      "At the restaurant, you'll enjoy family-style cooking, including frogs' legs with parsley, potato gratin and other house specialties.\r\nDaily lunch menu with a buffet of starters, hot dishes and desserts."
    ],
    "it": [
      "Il ristorante propone una cucina familiare, tra cui cosce di rana con prezzemolo, patate grattugiate e altre specialità della casa.\r\nMenu giornaliero per il pranzo con buffet di antipasti, piatti caldi e dessert."
    ],
    "fr": [
      "Au restaurant, la cuisine est familiale et vous dégusterez les cuisses de grenouilles persillées, les râpées de pomme de terre et autres spécialités de la maison.\r\nMenu du jour le midi avec un buffet d'entrées, plats chauds et desserts."
    ],
    "nl": [
      "Het restaurant serveert gerechten in familiestijl, waaronder kikkerbilletjes met peterselie, geraspte aardappelen en andere specialiteiten van het huis.\r\nDagelijks lunchmenu met een buffet van voorgerechten, warme gerechten en desserts."
    ],
    "es": [
      "El restaurante sirve cocina familiar, como ancas de rana con perejil, patatas ralladas y otras especialidades de la casa.\r\nMenú diario de mediodía con buffet de entrantes, platos calientes y postres."
    ]
  },
  "rdfs:label": {
