  "rdfs:comment": {
    "de": [
      "Als intimer und erholsamer Ort lädt Sie unser Spa zu einem Moment der puren Entspannung ein. Entspannen Sie sich in der Sauna, erholen Sie sich bei einer Signature-Massage oder entdecken Sie exklusiv die natürlichen Pflegeprodukte von Grown Alchemist als Pflege oder zum Kauf."
    ],
    "en": [
      "This cosy, restful spa, in the heart of Megève, is the perfect place for a spot of relaxation. Enjoy a variety of face and body treatments and discover the range of Tata Harper organic products."
    ],
    "it": [
      "Luogo intimo e riposante, la spa del cuore di Megève vi invita a un momento di puro relax. Scoprite i trattamenti biologici di Tata Harper attraverso una selezione di trattamenti per il viso e il corpo."
    ],
    "fr": [
      "Lieu intimiste et reposant, notre spa vous invite à un moment de pure relaxation. Détendez-vous au sauna, relaxez-vous avec un massage signature, ou découvrez en exclusivité les soins naturels Grown Alchemist en soin ou à la vente."
    ],
    "es": [
      "Un lugar íntimo y relajante, nuestro spa le invita a disfrutar de un momento de pura relajación. Relájese en la sauna, desconecte con un masaje de autor o descubra los exclusivos productos naturales Grown Alchemist para el cuidado de la piel que tiene a la venta."
    ],
    "nl": [
      "Onze intieme en ontspannende spa nodigt je uit om te genieten van een moment van pure ontspanning. Ontspan in de sauna, kom tot rust met een kenmerkende massage of ontdek de exclusieve natuurlijke huidverzorgingsproducten van Grown Alchemist die je kunt kopen."
    ]
  },
