  "rdfs:comment": {
    "de": [
      "Monval Shop bietet Ihnen eine Auswahl an Delikatessen, handgemachtem Eis, Kaffee & Tee, Weinen & Spirituosen, Geschenkideen und vielen anderen guten Dingen... Also, warten Sie nicht länger, sondern kommen Sie zu uns!"
    ],
    "en": [
      "Monval Shop offers you a selection of fine products, artisanal ice creams, coffee & tea, wines & spirits, gift ideas and lots of goodies...so don't wait any longer! come and see us!"
    ],
    "it": [
      "Monval Shop vi offre una selezione di prodotti pregiati, gelati artigianali, caffè e tè, vini e liquori, idee regalo e tante altre cose belle... Non aspettate oltre, venite a trovarci!"
    ],
    "fr": [
      "Monval Shop vous propose une sélections de produits fins, glaces artisanales, café & thé, vins & spiritueux, idées cadeaux et plein de bonnes choses…alors, n’attendez plus! venez nous voir!"
    ],
    "es": [
      "Monval Shop le ofrece una selección de productos finos, helados artesanales, café y té, vinos y licores, ideas para regalos y muchas otras cosas buenas... ¡así que no espere más y venga a vernos!"
    ],
    "nl": [
      "Monval Shop biedt een selectie van fijne producten, ambachtelijk ijs, koffie & thee, wijnen & sterke dranken, cadeau-ideeën en nog veel meer lekkers... dus wacht niet langer en kom langs!"
    ]
  },
