  "rdfs:comment": {
    "de": [
      "Die Union des commerçants et des artisans de Dieulefit hat sich zum Ziel gesetzt, die privaten Akteure des Wirtschaftsgefüges von Dieulefit zu vereinen und Veranstaltungen rund um 2 Pole anzubieten."
    ],
    "en": [
      "The Union des commerçants et des artisans de Dieulefit aims to unite the private players in Dieulefit's economic fabric and offer events based on 2 themes."
    ],
    "it": [
      "L'obiettivo dell'Unione Commercianti e Artigiani di Dieulefit è quello di unire gli attori privati del tessuto economico di Dieulefit e di proporre attività intorno a 2 poli."
    ],
    "fr": [
      "L'Union des commerçants et des artisans de Dieulefit a pour but de fédérer les acteurs privés du tissu économique de Dieulefit et  de proposer des animations autour de 2 pôles ."
    ],
    "es": [
      "El objetivo de la Unión de Comerciantes y Artesanos de Dieulefit es reunir a los agentes privados del tejido económico de Dieulefit y proponer actividades en torno a 2 polos."
    ],
    "nl": [
      "De Union des commerçants et des artisans de Dieulefit (Unie van handelaars en ambachtslieden van Dieulefit) heeft als doel de privéspelers van het economische weefsel van Dieulefit samen te brengen en evenementen rond 2 thema's te organiseren."
    ]
  },
  "rdfs:label": {
    "fr": [
      "UCA de Dieulefit"
    ]
  },
