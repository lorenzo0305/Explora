  "rdfs:comment": {
    "de": [
      "In der städtischen Mediathek können Sie verschiedene Medien ausleihen. Zugang zu den Computern für max. 5 Personen in der gesamten Mediathek und im Multimediazentrum. Individuelle Termine können per E-Mail oder Telefon vereinbart werden."
    ],
    "en": [
      "The municipal media library offers a variety of materials and media available for loan. Computer access is available for up to five people throughout the media library and multimedia centre. Individual appointments can be made by email or telephone."
    ],
    "it": [
      "La biblioteca multimediale comunale dispone di una serie di supporti disponibili per il prestito. Accesso al computer per un massimo di 5 persone in tutta la biblioteca e nel centro multimediale. Appuntamenti individuali via e-mail o telefono."
    ],
    "fr": [
      "La médiathèque municipale vous propose divers supports et médias disponibles au prêt. Accès aux ordinateurs possible pour 5 pers. max. dans tout le local médiathèque et centre multimédia. Proposition de rdv individuels par mail ou par téléphone."
    ],
    "es": [
      "La biblioteca multimedia municipal dispone de diversos soportes disponibles para préstamo. Acceso a ordenadores para un máximo de 5 personas en toda la biblioteca y el centro multimedia. Citas individuales por correo electrónico o teléfono."
    ],
    "nl": [
      "In de gemeentelijke mediatheek kun je verschillende media lenen. Computertoegang voor maximaal 5 personen in de hele bibliotheek en het multimediacentrum. Individuele afspraken per e-mail of telefoon."
    ]
  },
