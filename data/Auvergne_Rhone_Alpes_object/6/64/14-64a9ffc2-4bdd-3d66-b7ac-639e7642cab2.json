  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/406d805f-2f2d-3b87-9466-7ef123303618",
      "dc:description": {
        "de": [
          " Informationen :\n\nProdukte :\n\nAlle Produkte der SARL Le Petit Dieu (Käse, Torten, Quark, Fässer...) sind bei ihren Händlern erhältlich.\n\n\n "
        ],
        "en": [
          " Information :\n\nProducts :\n\nAll SARL Le Petit Dieu products (cheeses, tarts, fromage blanc, faisselles...) are available from their retailers.\n\n\n "
        ],
        "it": [
          " Ulteriori informazioni :\n\nProdotti :\n\nTutti i prodotti della SARL Le Petit Dieu (formaggi, crostate, fromage blanc, faisselles...) sono disponibili presso i loro rivenditori.\n\n\n "
        ],
        "fr": [
          " Informations : \n\nProduits :\n\nTous les produits de la SARL Le Petit Dieu (fromages, tartes, fromage blanc, faisselles...) sont disponibles auprès de leurs revendeurs.\n\n\n "
        ],
        "nl": [
          " Meer informatie :\n\nProducten :\n\nAlle producten van SARL Le Petit Dieu (kazen, taarten, fromage blanc, faisselles...) zijn verkrijgbaar bij hun handelaars.\n\n\n "
        ],
        "es": [
          " Más información :\n\nProductos :\n\nTodos los productos de SARL Le Petit Dieu (quesos, tartas, fromage blanc, faisselles...) están disponibles en sus puntos de venta.\n\n\n "
        ]
      },
