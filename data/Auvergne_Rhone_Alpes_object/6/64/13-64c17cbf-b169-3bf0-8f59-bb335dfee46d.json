  "rdfs:comment": {
    "de": [
      "Mikro-Bio-Gemüsebauernhof.\r\nIch versorge meinen Boden mit organischem Material, damit er fruchtbar ist und mir schmackhaftes und gesundes Saisongemüse liefert."
    ],
    "en": [
      "Organic vegetable micro-farm.\r\nI feed my soil with organic matter to make it fertile and give me tasty, healthy seasonal vegetables."
    ],
    "it": [
      "Microagricoltura biologica a orto.\r\nNutro il mio terreno con materia organica per renderlo fertile e darmi ortaggi di stagione gustosi e sani."
    ],
    "fr": [
      "Micro ferme maraîchère bio. \r\nJe nourris mon sol de matière organique pour qu'il soit fécond et me donne des légumes de saison goûteux et sains."
    ],
    "es": [
      "Microgranja de huerta ecológica.\r\nAlimento mi suelo con materia orgánica para que sea fértil y me proporcione verduras de temporada sabrosas y sanas."
    ],
    "nl": [
      "Microboerderij voor biologische tuinderijen.\r\nIk voed mijn grond met organisch materiaal om hem vruchtbaar te maken en me smakelijke, gezonde seizoensgroenten te geven."
    ]
  },
