  "rdfs:comment": {
    "de": [
      "Willkommen im Hochseilgarten von Giron!\r\nEin Parcours mit 10 Werkstätten im Wald, wo Sie sich amüsieren und träumen können.\r\nFür Ihre Picknickpausen stehen Ihnen Tische zur Verfügung."
    ],
    "en": [
      "Welcome to the Giron high-net park!\r\nA course of 10 workshops in the forest where you can have fun and dream.\r\nTables are available for picnic breaks."
    ],
    "it": [
      "Benvenuti al parco di rete alta di Giron!\r\nUn percorso di 10 laboratori nel bosco dove divertirsi e sognare.\r\nSono disponibili tavoli per le pause picnic."
    ],
    "fr": [
      "Bienvenue au parc filet en hauteur de Giron ! \r\nUn parcours de 10 ateliers en forêt où vous pourrez vous amusez et rêver.\r\nDes tables sont mis à votre disposition pour vos pauses pique-niques."
    ],
    "es": [
      "¡Bienvenido al parque de alta red Girón!\r\nUn recorrido de 10 talleres en el bosque donde podrás divertirte y soñar.\r\nMesas disponibles para hacer un picnic."
    ],
    "nl": [
      "Welkom in het Giron high net park!\r\nEen parcours van 10 workshops in het bos waar je plezier kunt hebben en dromen.\r\nEr zijn tafels beschikbaar voor picknickpauzes."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parc filet en hauteur"
    ]
  },
