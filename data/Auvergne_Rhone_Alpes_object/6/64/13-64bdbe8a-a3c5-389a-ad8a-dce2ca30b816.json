  "rdfs:comment": {
    "de": [
      "Als zertifizierter Drohnen-Telepilot biete ich Ihnen die technische Inspektion von Gebäuden, Luftaufnahmen und die Erstellung von Foto- und Videoinhalten für Kommunen, Immobilien, Tourismus und lokale Unternehmen."
    ],
    "en": [
      "As a certified drone pilot, I offer technical building inspection, aerial photography and photo & video content creation for local authorities, real estate, tourism and businesses."
    ],
    "it": [
      "In qualità di pilota di droni certificato, offro ispezioni tecniche di edifici, riprese aeree e creazione di contenuti fotografici e video per enti locali, settore immobiliare, turismo e imprese locali."
    ],
    "fr": [
      "Télépilote de drone certifié, je vous propose l'inspection technique de bâtiments, des prises de vues aériennes et la création de contenus photo & vidéo pour collectivités, immobilier, tourisme et entreprises locales."
    ],
    "es": [
      "Como piloto certificado de drones, ofrezco inspecciones técnicas de edificios, fotografía aérea y creación de contenidos fotográficos y de vídeo para autoridades locales, inmobiliarias, turísticas y empresas locales."
    ],
    "nl": [
      "Als gecertificeerd dronepiloot bied ik technische inspecties van gebouwen, luchtfotografie en de creatie van foto- en videocontent voor lokale overheden, vastgoed, toerisme en lokale bedrijven."
    ]
  },
  "rdfs:label": {
