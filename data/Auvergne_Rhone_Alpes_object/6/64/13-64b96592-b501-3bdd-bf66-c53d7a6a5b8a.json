  "rdfs:comment": {
    "de": [
      "Hinter den Tanks und Amphoren können Sie unter Sonnenschirmen und im Schatten von Mauerbäumen die Seele baumeln lassen und in einer Lounge-Atmosphäre ein Stückchen Paradies mit Blick auf den Sonnenuntergang schlürfen."
    ],
    "en": [
      "Behind the vats and amphorae, come and relax under the parasols, in the shade of the mulberry trees, and sip a little piece of paradise as the sun sets in a lounge atmosphere."
    ],
    "it": [
      "Dietro ai tini e alle anfore, venite a rilassarvi sotto gli ombrelloni, all'ombra dei gelsi, sorseggiando un piccolo angolo di paradiso mentre il sole tramonta in un'atmosfera lounge."
    ],
    "fr": [
      "Derrière les cuves et les amphores, venez décompresser sous les parasols, à l’ombre des muriers, siroter un p’tit coin de paradis face au coucher de soleil, dans une ambiance Lounge."
    ],
    "nl": [
      "Kom achter de vaten en amforen ontspannen onder de parasols, in de schaduw van de moerbeibomen, nippend aan een stukje paradijs terwijl de zon ondergaat in een loungesfeer."
    ],
    "es": [
      "Detrás de las cubas y las ánforas, venga a relajarse bajo las sombrillas, a la sombra de las moreras, saboreando un trocito de paraíso mientras el sol se pone en un ambiente lounge."
    ]
  },
