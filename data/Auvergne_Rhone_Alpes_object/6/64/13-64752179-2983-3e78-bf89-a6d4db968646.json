  "rdfs:comment": {
    "de": [
      "Dieses neue Gebäude mit einer Fläche von 1600m2 beherbergt 8 lange Kugelspiele, 10 Pétanque-Spiele, gemeinsam mit dem Bogenschießclub genutzte Einrichtungen und einen geselligen Bereich, der von den Vereinen, die die Räumlichkeiten nutzen, verwaltet wird."
    ],
    "en": [
      "The new 1,600m2 building houses 8 long boules sets, 10 petanque sets, shared facilities with the Archery Club and a social area managed by the associations using the premises."
    ],
    "it": [
      "Questo nuovo edificio di 1.600 m2 ospita 8 campi da bocce lunghe, 10 campi da bocce, strutture condivise con il Club di tiro con l'arco e un'area sociale gestita dalle associazioni che utilizzano i locali."
    ],
    "fr": [
      "Ce nouveau bâtiment de 1 600m2 accueille 8 jeux de boules de longue, 10 jeux de pétanque, des infrastructures mutualisées avec le club de Tir à l’Arc et un espace de convivialité géré par les associations utilisatrices des lieux."
    ],
    "es": [
      "Este nuevo edificio de 1.600 m2 alberga 8 juegos de bolos largos, 10 juegos de petanca, instalaciones compartidas con el Club de Tiro con Arco y un área social gestionada por las asociaciones usuarias de los locales."
    ],
    "nl": [
      "Dit nieuwe gebouw van 1.600 m2 huisvest 8 lange jeu de boules banen, 10 jeu de boules banen, gedeelde faciliteiten met de boogschietclub en een sociale ruimte die wordt beheerd door de verenigingen die het gebouw gebruiken."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Espace sportif des Jacquins - Pétanque, Boule lyonnaise et Espace de tir à l'arc"
    ]
  },
