  "rdfs:comment": {
    "de": [
      "Die Bruderschaft der Ritter des Olivenbaums setzt sich für die traditionsreichen Produkte Oliven und Olivenöl ein und fördert den Anbau und die Verehrung des Olivenbaums."
    ],
    "en": [
      "\"La confrérie des Chevaliers de l'Olivier\" defends the high tradition products that are olive and olive oil and it works for the promotion of the olive tree culture."
    ],
    "it": [
      "La Confraternita dei Cavalieri dell'Olivo difende i prodotti tradizionali dell'oliva e dell'olio e promuove la cultura e il culto dell'olivo."
    ],
    "fr": [
      "La confrérie des Chevaliers de l'Olivier défend les produits de haute tradition que sont l'olive et l'huile d'olive et elle promeut la culture et le culte de l'olivier."
    ],
    "es": [
      "La hermandad de los Caballeros del Olivo defiende los productos tradicionales de la aceituna y el aceite de oliva y promueve la cultura y el culto al olivo."
    ],
    "nl": [
      "De confrerie van RIdders van de olijf beschermt de belangrijke producten traditie van de olijf en de olijfolie en ze promoot de cultuur en de roem van de olijf."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Confrérie des Chevaliers de l'Olivier"
    ]
  },
