  "rdfs:comment": {
    "de": [
      "Entdecken Sie den Canal de Savière, den Lac du Bourget und die kanalisierte Rhône mit Schleusendurchfahrt an Bord der Savoyard 2, einem komfortablen und geräumigen Panoramaschiff mit Oberdeck, oder der Solely, einem Elektro-Solarboot."
    ],
    "en": [
      "Discover the Canal de Savière and the Lac du Bourget and transit the River Rhone canal through a lock on board comfortable and spacious boats, with upper decks (accessible to people with reduced mobility)."
    ],
    "it": [
      "Partite alla scoperta del Canal de Savière, del Lago del Bourget e del Rodano incanalato con un passaggio da una chiusa a bordo di imbarcazioni panoramiche, comode e spaziose, con il ponte superiore (accessibile alle persone a mobilità ridotta)."
    ],
    "fr": [
      "Partez à la découverte du Canal de Savière, du Lac du Bourget et du Rhône canalisé avec passage d'une écluse à bord du Savoyard 2, bateau panoramique, confortable et spacieux, avec pont supérieur ou du Solely, bateau électro-solaire."
    ],
    "nl": [
      "Ontdek het Canal de Savière, het Lac du Bourget en de gekanaliseerde Rhône met een sluisovertocht aan boord van de Savoyard 2, een comfortabele en ruime panoramaboot met een bovendek of de Solely, een elektro-zonneboot."
    ],
    "es": [
      "Descubra el Canal de Savière, el Lac du Bourget y el Ródano canalizado con una travesía de esclusas a bordo del Savoyard 2, un barco panorámico cómodo y espacioso con cubierta superior, o del Solely, un barco electrosolar."
    ]
  },
