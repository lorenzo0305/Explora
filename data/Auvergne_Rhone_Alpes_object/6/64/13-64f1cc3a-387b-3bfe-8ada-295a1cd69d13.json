  "rdfs:comment": {
    "de": [
      "Die Brasserie liegt ideal gegenüber der Fontaine Monumentale an den Boulevards und bietet eine traditionelle Speisekarte, Gourmetmenüs und eine große Auswahl an Gerichten à la carte. Hier können Sie gute Biere und eine große Auswahl an Cocktails genießen."
    ],
    "en": [
      "Ideally located opposite the Fontaine Monumentale on the boulevards, the brasserie offers a traditional menu, gourmet menus and a wide choice of à la carte dishes. Enjoy fine beers and a wide range of cocktails."
    ],
    "it": [
      "Situata in posizione ideale, di fronte alla Fontana Monumentale sui viali, la brasserie offre un menu tradizionale, menu gourmet e un'ampia scelta di piatti à la carte. Potrete gustare ottime birre e una vasta gamma di cocktail."
    ],
    "fr": [
      "Idéalement située face à la Fontaine Monumentale sur les boulevards, la brasserie propose une carte traditionnelle, des menus gourmets, un grand choix de plats à la carte. Vous y dégusterez  de bonnes bières et une large gamme de cocktails."
    ],
    "es": [
      "Idealmente situada frente a la Fuente Monumental en los bulevares, la brasserie ofrece una carta tradicional, menús gourmet y una amplia selección de platos a la carta. Podrá disfrutar de buenas cervezas y una amplia gama de cócteles."
    ],
    "nl": [
      "De brasserie is ideaal gelegen tegenover de Fontaine Monumentale aan de boulevards en biedt een traditionele kaart, gastronomische menu's en een ruime keuze aan à la carte gerechten. U kunt er ook genieten van goede bieren en een breed scala aan cocktails."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Grand Café"
    ]
  },
