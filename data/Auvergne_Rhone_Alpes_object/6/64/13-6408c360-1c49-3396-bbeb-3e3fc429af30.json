  "rdfs:comment": {
    "de": [
      "Murmuration Level 2, die neue Version von Sadeck Berrabahs Phänomen, vereint 50 Tänzer in hypnotischen Choreografien, die Hip-Hop, Kampfsport, Ballett und zeitgenössischen Tanz miteinander verbinden. Nach ausverkauften Tourneen erleben Sie diese einzigartige Show im Jahr 2026!"
    ],
    "en": [
      "Murmuration Level 2, a new version of Sadeck Berrabah's phenomenon, brings together 50 dancers in hypnotic choreography blending hip-hop, martial arts, ballet and contemporary dance. After sold-out tours, experience this unique show in 2026!"
    ],
    "it": [
      "Murmuration Level 2, una nuova versione del fenomeno di Sadeck Berrabah, riunisce 50 ballerini in una coreografia ipnotica che combina hip-hop, arti marziali, balletto e danza contemporanea. Dopo i tour che hanno registrato il tutto esaurito, venite a provare questo spettacolo unico nel 2026!"
    ],
    "fr": [
      "Murmuration Level 2, nouvelle version du phénomène de Sadeck Berrabah, réunit 50 danseurs dans des chorégraphies hypnotiques mêlant hip-hop, arts martiaux, ballet et danse contemporaine. Après des tournées sold-out, vivez ce spectacle unique en 2026 !"
    ],
    "es": [
      "Murmuration Level 2, una nueva versión del fenómeno de Sadeck Berrabah, reúne a 50 bailarines en una coreografía hipnótica que combina hip-hop, artes marciales, ballet y danza contemporánea. Después de giras con entradas agotadas, ¡ven a vivir este espectáculo único en 2026!"
    ],
    "nl": [
      "Murmuration Level 2, een nieuwe versie van Sadeck Berrabah's fenomeen, brengt 50 dansers samen in een hypnotiserende choreografie die hiphop, martial arts, ballet en hedendaagse dans combineert. Na uitverkochte tournees kun je deze unieke show in 2026 beleven!"
    ]
  },
