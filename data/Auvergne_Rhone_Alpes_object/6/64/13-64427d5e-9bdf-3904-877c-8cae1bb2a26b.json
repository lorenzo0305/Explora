  "rdfs:comment": {
    "de": [
      "Das Triple Five (ehemals Urban Resto) ist eine Afterwork-Bar, die regelmäßig neue Biere, Fruchtsäfte und selbstgemachte Cocktails mit und ohne Alkohol anbietet."
    ],
    "en": [
      "Triple Five (formerly Urban Resto) is an afterwork bar regularly offering new beers, fruit juices and homemade cocktails, both alcoholic and non-alcoholic."
    ],
    "it": [
      "Triple Five (ex Urban Resto) è un bar per il dopo lavoro che offre regolarmente nuove birre, succhi di frutta e cocktail fatti in casa, sia alcolici che analcolici."
    ],
    "fr": [
      "Le Triple Five (ex Urban Resto) est un bar afterwork proposant régulièrement des nouvelles bières, des jus de fruits, des cocktails fait maison avec et sans alcool."
    ],
    "nl": [
      "Triple Five (voorheen Urban Resto) is een bar waar je na het werk regelmatig nieuwe bieren, vruchtensappen en zelfgemaakte cocktails kunt drinken, zowel alcoholisch als non-alcoholisch."
    ],
    "es": [
      "Triple Five (antes Urban Resto) es un bar afterwork que ofrece regularmente nuevas cervezas, zumos de frutas y cócteles caseros, tanto con alcohol como sin alcohol."
    ]
  },
