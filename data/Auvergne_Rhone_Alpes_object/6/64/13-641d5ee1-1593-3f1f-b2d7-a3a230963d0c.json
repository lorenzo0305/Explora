  "rdfs:comment": {
    "de": [
      "Im Herzen der Gemeinde, in einer angenehmen und hellen Umgebung, stehen in der Mediathek mehr als 15 000 Bücher zur Verfügung. Romane, Comics, Biografien, Jugendbücher, aber auch CDs, DVDs und Lesegeräte."
    ],
    "en": [
      "Right in the heart of the town, in a pleasant, bright setting, over 15,000 books are available at the media library. Novels, comics, biographies, children's books, as well as CDs, DVDs and e-readers."
    ],
    "it": [
      "Nel cuore della città, in un ambiente piacevole e luminoso, la biblioteca multimediale mette a disposizione oltre 15.000 libri. Romanzi, fumetti, biografie, libri per bambini, oltre a CD, DVD ed e-reader."
    ],
    "fr": [
      "En plein coeur de la commune, dans un cadre agréable et lumineux, plus de 15 000 livres sont disponibles à la médiathèque. Romans, BD, biographies, ouvrages jeunesse, mais aussi des CD, des DVD et des liseuses."
    ],
    "nl": [
      "In het hart van de stad, in een aangename, lichte omgeving, zijn meer dan 15.000 boeken beschikbaar in de mediatheek. Romans, strips, biografieën, kinderboeken, maar ook cd's, dvd's en e-readers."
    ],
    "es": [
      "En pleno centro de la ciudad, en un entorno agradable y luminoso, la biblioteca multimedia ofrece más de 15.000 libros. Novelas, cómics, biografías, libros infantiles, así como CD, DVD y lectores electrónicos."
    ]
  },
