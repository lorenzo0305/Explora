  "rdfs:comment": {
    "de": [
      "Begegnen Sie der Natur, indem Sie die Landschaft, die Bäume, die Pflanzen, das Licht, den Wind, den Klang, das Wasser, die Stille... mithilfe unserer fünf Sinne erleben."
    ],
    "en": [
      "Encounter Nature by experiencing the landscape, trees, plants, light, wind, sound, water, silence... through our 5 senses."
    ],
    "it": [
      "Incontrare la natura sperimentando il paesaggio, gli alberi, le piante, la luce, il vento, i suoni, l'acqua, il silenzio... attraverso i nostri 5 sensi."
    ],
    "fr": [
      "A la rencontre de la Nature en  éprouvant le paysage, les arbres, les végétaux, la lumière, le vent, le son, l'eau, le silence.. par l'intermédiaire de nos 5 sens."
    ],
    "nl": [
      "Ontmoet de natuur door het landschap, bomen, planten, licht, wind, geluid, water, stilte... te ervaren via onze 5 zintuigen."
    ],
    "es": [
      "Encontrar la naturaleza experimentando el paisaje, los árboles, las plantas, la luz, el viento, el sonido, el agua, el silencio... a través de nuestros 5 sentidos."
    ]
  },
