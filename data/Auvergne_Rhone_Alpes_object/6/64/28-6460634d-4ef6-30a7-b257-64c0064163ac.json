  "rdfs:comment": {
    "de": [
      "Entdecken Sie das P'tit Bouchon Restaurant mit seiner französischen Küche, die aus frischen Zutaten zubereitet wird.\nAlle unsere Gerichte sind hausgemacht, ebenso wie die Desserts.\nWir empfangen Sie in einer herzlichen und sympathischen Atmosphäre..."
    ],
    "en": [
      "Come and discover the P'tit Bouchon restaurant with a French cuisine made with fresh products.\nAll our dishes are homemade as well as the desserts.\nWe welcome you in a warm and friendly atmosphere..."
    ],
    "it": [
      "Venite a scoprire il ristorante P'tit Bouchon con una cucina francese a base di prodotti freschi.\nTutti i nostri piatti sono fatti in casa, così come i dolci.\nVi diamo il benvenuto in un'atmosfera calda e amichevole..."
    ],
    "fr": [
      "Venez découvrir le P'tit Bouchon restaurant avec une cuisine française élaborée à base de produits frais.\nTout nos plats sont faits maison ainsi que les desserts.\nNous vous accueillons dans une ambiance chaleureuse et sympathique..."
    ],
    "es": [
      "Venga a descubrir el restaurante P'tit Bouchon con una cocina francesa elaborada con productos frescos.\nTodos nuestros platos son caseros, así como los postres.\nLe damos la bienvenida en un ambiente cálido y acogedor..."
    ],
    "nl": [
      "Kom en ontdek het restaurant P'tit Bouchon met een Franse keuken op basis van verse producten.\nAl onze gerechten zijn huisgemaakt, evenals de desserts.\nWij verwelkomen u in een warme en vriendelijke sfeer..."
    ]
  },
