  "rdfs:comment": {
    "de": [
      "Benötigen Sie ein Coworking-Büro oder einen Besprechungsraum? Es stehen Ihnen 3 Räume zur Verfügung, die Sie mit Zugang zur Küche mieten können.\r\n\r\nIm Zentrum von Romans-sur-Isère, an der Ausstattung des Stadtzentrums."
    ],
    "en": [
      "Whether you need a coworking office or a meeting room, 3 spaces are available for rent with access to the kitchen.\r\n\r\nRight in the center of Romans-sur-Isère, on the downtown equipment road."
    ],
    "it": [
      "Se avete bisogno di un ufficio in coworking o di una sala riunioni, sono disponibili 3 spazi in affitto con accesso alla cucina.\r\n\r\nNel pieno centro di Romans-sur-Isère, sulle attrezzature del centro."
    ],
    "fr": [
      "Besoin d'un bureaux de coworking ou d'une salle de réunion, 3 espaces vous sont proposés à la location avec accès à la cuisine.\r\n\r\nEn plein centre de Romans-sur-Isère, sur la équipements du centre-ville."
    ],
    "es": [
      "Necesita una oficina de coworking o una sala de reuniones, hay 3 espacios disponibles para alquilar con acceso a la cocina.\r\n\r\nEn pleno centro de Romans-sur-Isère, en el equipamiento del centro de la ciudad."
    ],
    "nl": [
      "Als je een coworkingkantoor of een vergaderruimte nodig hebt, zijn er 3 ruimtes te huur met toegang tot de keuken.\r\n\r\nMidden in het centrum van Romans-sur-Isère, op de uitrusting van het stadscentrum."
    ]
  },
