  "rdfs:comment": {
    "de": [
      "Die Veranstaltung ist ein dreitägiges Oldtimer-Skifestival der 1930er, 60er und 80er Jahre in Vallorcine. Skirennen in historischen Kleidern, Sammeln von Skimaterial und Oldtimern, Konzerte, Abendessen, Treffen mit Skilegenden"
    ],
    "en": [
      "The event is a ski festival of the 1930s, 60s and 80s taking place in Vallorcine for 3 days. Ski events in vintage outfits, gathering of old ski equipment and cars, concerts, dinner, meetings with ski legends"
    ],
    "it": [
      "L'evento è un festival di sci vintage degli anni '30, '60 e '80 che si tiene a Vallorcine per 3 giorni. Eventi sciistici in costumi d'epoca, attrezzature da sci e auto d'epoca, concerti, cene, incontri con leggende dello sci, ecc"
    ],
    "fr": [
      "L'événement, est un festival de ski d'époque, années 1930, 60 et 80 se déroulant à Vallorcine pendant 3 jours. Epreuves de ski en tenues d'époque, rassemblement de matériel de ski et voitures anciennes, concerts, dîner, rencontres avec des légendes du ski"
    ],
    "es": [
      "Se trata de un festival de esquí de época de los años 30, 60 y 80 que se celebra en Vallorcine durante 3 días. Eventos de esquí con trajes de época, material de esquí y coches de época, conciertos, cenas, encuentros con leyendas del esquí, etc"
    ],
    "nl": [
      "Het evenement is een 3-daags vintage skifestival uit de jaren '30, '60 en '80 in Vallorcine. Ski-evenementen in historische kostuums, skiuitrusting en oldtimers, concerten, diners, ontmoetingen met skilegendes, enz"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Comptoir des Légendes du Ski"
    ]
  },
