  "rdfs:comment": {
    "de": [
      "Wir sind seit 1998 Erzeuger von Beerenfrüchten in der Haute-Loire. Unser Bauernhof, La Thuile des Fées, betreibt eine biologische, biodynamische und umweltfreundliche Landwirtschaft, um Ihnen natürlich reichhaltige Produkte anbieten zu können."
    ],
    "en": [
      "Producers of red berries in the Haute-Loire since 1998, our farm, La Thuile des Fées, uses organic, biodynamic and environmentally-friendly farming methods to offer you naturally rich products."
    ],
    "it": [
      "Coltivatori di bacche rosse nell'Alta Loira dal 1998, la nostra azienda agricola, La Thuile des Fées, utilizza metodi di coltivazione biologici, biodinamici e rispettosi dell'ambiente per offrirvi prodotti naturalmente ricchi."
    ],
    "fr": [
      "Producteurs de petits fruits rouges en Haute-Loire depuis 1998, notre ferme, la Thuile des Fées, pratique une agriculture biologique, biodynamique et respectueuse de l’environnement pour vous offrir des produits naturellement riches."
    ],
    "nl": [
      "Onze boerderij, La Thuile des Fées, kweekt sinds 1998 rode bessen in de Haute-Loire en maakt gebruik van biologische, biodynamische en milieuvriendelijke landbouwmethoden om u natuurlijke producten te bieden."
    ],
    "es": [
      "Cultivadores de bayas rojas en el Alto Loira desde 1998, nuestra explotación, La Thuile des Fées, utiliza métodos de cultivo biológicos, biodinámicos y respetuosos con el medio ambiente para ofrecerle productos naturalmente ricos."
    ]
  },
  "rdfs:label": {
