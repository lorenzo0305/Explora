  "rdfs:comment": {
    "de": [
      "Das von der Communauté d'Agglomération du Bassin d'Aurillac errichtete Le Prisme ist eine 2.500 m2 große Halle für wirtschaftliche und kulturelle Zwecke."
    ],
    "en": [
      "Le Prisme, created by the Community of Agglomeration of the Basin of Aurillac, is a room with economic and cultural vocation of 2 500 m2, which can accomodate up to 2 290 persons in version \"all seated\" or 4,300 people in \"all standing\".\r\nIt allows the organization of fairs, fairs and congresses and a program of shows / concerts of national scope."
    ],
    "it": [
      "Le Prisme, costruito dalla Communauté d'Agglomération du Bassin d'Aurillac, è uno spazio economico e culturale di 2.500 m2 ."
    ],
    "fr": [
      "Le Prisme, réalisé par la Communauté d’Agglomération du Bassin d’Aurillac, est une salle à vocation économique et culturelle de 2 500 m2."
    ],
    "nl": [
      "Le Prisme, gebouwd door de Communauté d'Agglomération du Bassin d'Aurillac, is een economisch en cultureel centrum van 2.500 m2."
    ],
    "es": [
      "Le Prisme, construido por la Communauté d'Agglomération du Bassin d'Aurillac, es un recinto económico y cultural de 2.500 m2."
    ]
  },
