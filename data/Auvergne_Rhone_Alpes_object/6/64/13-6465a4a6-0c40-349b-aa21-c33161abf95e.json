  ],
  "rdfs:comment": {
    "de": [
      "Honig (Kastanie, Akazie, alle Blumen, Lavendel, Tanne, Rosmarin, Berg), weißer Nougat, Lebkuchen, Walnüsse, Walnussöl, Kastanienkonfitüre und Rindfleisch. Met.\r\nVerkauf und Verkostung auf dem Bauernhof.\r\nSammeln von Walnüssen im Oktober."
    ],
    "en": [
      "Honey (chestnut, acacia, all flowers, lavender, fir, rosemary, mountain), white nougat, gingerbread, walnuts, walnut oil, chestnut jam and beef. Mead.\r\nSale and tasting at the farm.\r\nWalnut picking in October."
    ],
    "it": [
      "Mieli (castagno, acacia, tutti i fiori, lavanda, abete, rosmarino, montagna), torrone bianco, pan di zenzero, noci, olio di noci, marmellata di castagne e manzo. Idromele.\r\nVendita e degustazione in fattoria.\r\nRaccolta di noci in ottobre."
    ],
    "fr": [
      "Miels (châtaignier, acacia, toutes fleurs, lavande, sapin, romarin, montagne), nougat blanc, pain d'épices, noix, huile de noix, confiture de châtaignes et viande bovine. Hydromel.\r\nVente et dégustation à la ferme.\r\nRamassage des noix en octobre."
    ],
    "es": [
      "Mieles (castaña, acacia, todas las flores, lavanda, abeto, romero, montaña), turrón blanco, pan de especias, nueces, aceite de nuez, mermelada de castaña y ternera. Hidromiel.\r\nVenta y degustación en la granja.\r\nRecogida de nueces en octubre."
    ],
    "nl": [
      "Honing (kastanje, acacia, alle bloemen, lavendel, spar, rozemarijn, berg), witte nougat, peperkoek, walnoten, walnootolie, kastanjejam en rundvlees. Mede.\r\nVerkoop en proeverij op de boerderij.\r\nWalnoten plukken in oktober."
    ]
  },
  "rdfs:label": {
    "en": [
      "Miellerie de Boissy"
    ],
    "fr": [
      "Miellerie de Boissy"
    ]
  },
