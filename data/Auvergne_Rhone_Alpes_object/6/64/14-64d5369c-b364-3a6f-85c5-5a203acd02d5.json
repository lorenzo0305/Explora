      "dc:description": {
        "de": [
          "Freitag, 23. Mai um 18.30 Uhr im Centre Phénix\nKindervorstellung der Compagnie On Imagine\ndauer 40 Minuten ab 03 Jahren\nKostenlos mit Reservierung bei der Kulturabteilung unter 03 21 80 49 53"
        ],
        "en": [
          "Friday, May 23 at 6:30pm at Centre Phénix\nChildren's show by Compagnie On Imagine\nduration 40 minutes from 03 years\nFree with reservation at the cultural service 03 21 80 49 53"
        ],
        "it": [
          "Venerdì 23 maggio alle 18.30 presso il Centro Phénix\nSpettacolo per bambini della Compagnie On Imagine\ndurata 40 minuti a partire da 03 anni\nGratuito con prenotazione al servizio culturale al numero 03 21 80 49 53"
        ],
        "fr": [
          "Vendredi 23 Mai à 18h30 au Centre Phénix \nSpectacle pour enfant par la Compagnie On Imagine\ndurée 40 minutes dès 03 ans\nGratuit sur réservation au service culturel au 03 21 80 49 53"
        ],
        "nl": [
          "Vrijdag 23 mei om 18.30 uur in het Centre Phénix\nVoorstelling voor kinderen door Compagnie On Imagine\nduur 40 minuten vanaf 03 jaar\nGratis op reservering bij de culturele dienst op 03 21 80 49 53"
        ],
        "es": [
          "Viernes 23 de mayo a las 18.30 h en el Centre Phénix\nEspectáculo para niños de la Compagnie On Imagine\nduración 40 minutos a partir de 03 años\nGratis con reserva en el servicio cultural al 03 21 80 49 53"
        ]
