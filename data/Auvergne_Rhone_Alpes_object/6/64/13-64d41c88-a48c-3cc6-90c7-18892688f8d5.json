  "rdfs:comment": {
    "de": [
      "Als Holzliebhaber setzt sich Thierry Andrieux dafür ein, Alltagsgegenstände in einer nachhaltigen und verantwortungsvollen Version zu präsentieren."
    ],
    "en": [
      "Wood lover, Thierry Andrieux strives to enhance everyday objects, creating them in a sustainable and responsible version."
    ],
    "it": [
      "Amante del legno, Thierry Andrieux si propone di valorizzare gli oggetti di uso quotidiano creandoli in modo sostenibile e responsabile."
    ],
    "fr": [
      "Amoureux du bois, Thierry Andrieux s'attache à mettre en valeur les objets du quotidien, en les créant dans une version durable et responsable."
    ],
    "nl": [
      "Thierry Andrieux is een liefhebber van hout en wil alledaagse voorwerpen mooier maken door ze op een duurzame en verantwoorde manier te creëren."
    ],
    "es": [
      "Amante de la madera, Thierry Andrieux se propone realzar los objetos cotidianos creándolos de forma sostenible y responsable."
    ]
  },
