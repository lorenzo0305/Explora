  "rdfs:comment": {
    "de": [
      "La Raviol'adie ist ein Handwerksbetrieb, der in der Gemeinde Montmiral in der Region Drôme des Collines angesiedelt ist.\r\nWir bieten Ravioles an, die mit frischem, pasteurisiertem Kuhmilchkäse ohne Eier, Pflanzenöle und Konservierungsstoffe zubereitet werden."
    ],
    "en": [
      "La Raviol'adie is an artisanal company based in the commune of Montmiral in the Drôme des Collines region.\r\nWe offer Ravioles made from fresh pasteurized cow's milk cheese, with no eggs, vegetable oils or preservatives."
    ],
    "it": [
      "La Raviol'adie è un'azienda artigianale con sede nel comune di Montmiral, nella regione della Drôme des Collines.\r\nI nostri Ravioles sono prodotti con formaggio fresco di mucca pastorizzato e non contengono uova, oli vegetali o conservanti."
    ],
    "fr": [
      "La Raviol'adie est une entreprise artisanale installée sur la commune de Montmiral en Drôme des Collines.\r\nNous proposons des Ravioles préparées avec du fromage de vache frais pasteurisées sans œufs, sans huile végétale et sans conservateur."
    ],
    "nl": [
      "Raviol'adie is een ambachtelijk bedrijf uit Montmiral in de Drôme des Collines.\r\nOnze Ravioles zijn gemaakt van verse gepasteuriseerde koemelkse kaas en bevatten geen eieren, plantaardige oliën of conserveringsmiddelen."
    ],
    "es": [
      "La Raviol'adie es una empresa artesanal situada en el municipio de Montmiral, en la Drôme des Collines.\r\nNuestros raviolis se elaboran con queso de vaca fresco pasteurizado y no contienen huevo, aceites vegetales ni conservantes."
    ]
  },
  "rdfs:label": {
