  "rdfs:comment": {
    "de": [
      "Nima SARKECHIK, virtuoser Pianist / PANDIT-03 & GODESHA, Electro Dj: Das klassische Recital oder der Acid Tribe als Zeremonie, ein Ritual, das ein freies und wohlwollendes Heiliges feiert. Der Abend des 19. März ist eine Einladung, das Teilen und die Einheit zu feiern."
    ],
    "en": [
      "Nima SARKECHIK, virtuoso pianist / PANDIT-03 & GODESHA, electro DJ: the classical recital or the Acid Tribe as a ceremony, a ritual that celebrates a free and benevolent sacred. The evening of March 19 is an invitation to celebrate sharing and unity."
    ],
    "it": [
      "Nima SARKECHIK, pianista virtuoso / PANDIT-03 & GODESHA, electro DJ: il recital classico o l'Acid Tribe come cerimonia, un rituale che celebra un sacro libero e benevolo. La serata del 19 marzo è un invito a celebrare la condivisione e l'unità."
    ],
    "fr": [
      "Nima SARKECHIK, pianiste virtuose / PANDIT-03 & GODESHA, Dj electro : le récital classique ou l'Acid Tribe comme une cérémonie, un rituel qui célèbre un sacré libre et bienveillant. La soirée du 19 mars est une invitation à célébrer le partage et l’unité."
    ],
    "nl": [
      "Nima SARKECHIK, virtuoos pianist / PANDIT-03 & GODESHA, electro DJ: het klassieke recital of de Acid Tribe als een ceremonie, een ritueel dat een vrij en welwillend heiligdom viert. De avond van 19 maart is een uitnodiging om het delen en de eenheid te vieren."
    ],
    "es": [
      "Nima SARKECHIK, pianista virtuoso / PANDIT-03 & GODESHA, electro DJ: el recital clásico o la Acid Tribe como ceremonia, ritual de celebración de un sagrado libre y benévolo. La velada del 19 de marzo es una invitación a celebrar el compartir y la unidad."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Acid Symphony - Piano / Acid Techno"
    ]
  },
