  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/6ca62f19-59d7-33f9-b70a-e3fcb49a7dbb",
      "dc:description": {
        "de": [
          "Touche Terre : Sportliche Animation im Freien!\nAlter: 12-17 Jahre\n\nWann: 14:30 - 16:30 Uhr\n\nWas: Komm und tob dich an der frischen Luft mit einer Vielzahl von sportlichen Aktivitäten aus!"
        ],
        "en": [
          "Touche Terre: Outdoor sports activities!\nAge: 12-17\n\nWhen: 2:30 pm - 4:30 pm\n\nWhat: Come and let off steam in the great outdoors with a maximum of sporting activities!"
        ],
        "it": [
          "Touche Terre: attività sportive all'aperto!\nEtà: 12-17 anni\n\nQuando: 14.30-16.30\n\nCosa succede: Venite a sfogarvi all'aria aperta con una serie di attività sportive!"
        ],
        "fr": [
          "Touche Terre : Animation Sportive en Plein Air !\nÂge: 12-17 ans\n\nQuand: 14h30 - 16h30\n\nQuoi: Viens te défouler en plein air avec un max d'activités sportives !"
        ],
        "es": [
          "Touche Terre: ¡Actividades deportivas al aire libre!\nEdad: 12-17 años\n\nCuándo: 14h30 - 16h30\n\nActividades: Ven a desahogarte al aire libre con un montón de actividades deportivas"
        ],
        "nl": [
          "Touche Terre: Buitensportactiviteiten!\nLeeftijd: 12-17 jaar\n\nWanneer: 14.30 - 16.30 uur\n\nWat is er te doen? Kom je uitleven in de buitenlucht met een heleboel sportieve activiteiten!"
        ]
      },
