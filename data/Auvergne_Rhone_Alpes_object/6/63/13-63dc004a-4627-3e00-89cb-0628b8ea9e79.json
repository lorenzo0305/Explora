  "rdfs:comment": {
    "de": [
      "Die Auberge Fleurie ist eine charmante Zwischenstation an der Grenze zwischen Lot und Truyère in Montsalvy, 800 m über dem Meeresspiegel, in der Nähe von Conques, Salers, den Monts d'Aubrac und den Monts du Cantal."
    ],
    "en": [
      "L’Auberge Fleurie is a charming Cantal stopover in the area of the River Lot and the River Truyère, at an altitude of 800 m."
    ],
    "it": [
      "L'Auberge Fleurie è un'incantevole sosta ai confini dei fiumi Lot e Truyère, a Montsalvy, a 800 metri di altitudine, vicino a Conques, Salers, ai monti Aubrac e ai monti del Cantal."
    ],
    "fr": [
      "L'Auberge Fleurie est une charmante étape aux confins du Lot et de la Truyère, à Montsalvy, à 800 mètres d'altitude, près de Conques, de Salers, des monts d'Aubrac et des monts du Cantal."
    ],
    "nl": [
      "L’Auberge Fleurie is een charmante Cantal tussenstop in de omgeving van de Lot en de Truyère, op een hoogte van 800 meter."
    ],
    "es": [
      "El Auberge Fleurie es una encantadora parada en la frontera de los ríos Lot y Truyère, en Montsalvy, a 800 metros de altitud, cerca de Conques, Salers, los montes Aubrac y los montes Cantal."
    ]
  },
