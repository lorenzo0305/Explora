  "rdfs:comment": {
    "de": [
      "La Petite Chartreuse bietet Ihnen eine Bistroküche, in der frische, gut zubereitete Produkte französischer Herkunft verwendet werden. Die Weinkarte bietet viel Savoyen, aber auch hübsche Appellationen aus anderen Regionen, die für jeden Geschmack etwas zu bieten haben."
    ],
    "en": [
      "La Petite Chartreuse propose to you a \"bistronomique\" cuisine, made with fresh products, made in France. A home-made cuisine to discover. Wine menu is composed by Savoie wine for the local touch but also Rhone Valley with outstanding names, for all people."
    ],
    "it": [
      "La Petite Chartreuse offre una cucina bistronomica, con prodotti freschi e ben cucinati di origine francese. La carta dei vini presenta vini della Savoia e di altre regioni, per soddisfare tutti i gusti."
    ],
    "fr": [
      "La Petite Chartreuse vous propose une cuisine bistronomique, utilisant des produits frais, d'origine française et bien cuisinés. La carte des vins fait la part belle à la Savoie mais également de jolies appellations d'autres régions, pour tous les goûts."
    ],
    "es": [
      "La Petite Chartreuse ofrece una cocina bistronómica, con productos frescos y bien cocinados de origen francés. La carta de vinos incluye vinos de Saboya y de otras regiones, para todos los gustos."
    ],
    "nl": [
      "La Petite Chartreuse biedt een bistronomische keuken, met verse, goed gekookte producten van Franse oorsprong. Op de wijnkaart staan wijnen uit de Savoie en andere regio's, voor elk wat wils."
    ]
  },
  "rdfs:label": {
