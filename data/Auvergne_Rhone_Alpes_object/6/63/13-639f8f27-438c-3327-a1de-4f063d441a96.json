  "rdfs:comment": {
    "de": [
      "Kleines Restaurant mit korsischen Spezialitäten, das am 20. Juni 2020 eröffnet wurde.\r\nL'Alant ist eine Mischung aus Alexia und Antoine und das Ergebnis einer Begegnung in der Nähe von Propriano zwischen zwei leidenschaftlichen Restaurantbesitzern."
    ],
    "en": [
      "Small restaurant of Corsican specialities, opened since June 20th, 2020.\r\nMixture of Alexia and Antoine, l'Alant is the fruit of a meeting on the side of Propriano, between two passionate persons of the restoration."
    ],
    "it": [
      "Piccolo ristorante di specialità corse, aperto dal 20 giugno 2020.\r\nNata dall'unione di Alexia e Antoine, l'Alant è il frutto dell'incontro, sul versante di Propriano, tra due appassionati di ristorazione."
    ],
    "fr": [
      "Petit restaurant de spécialités corses, ouvert depuis le 20 Juin 2020.\r\nMélange d'Alexia et Antoine, l'Alant est le fruit d'une rencontre du côté de Propriano, entre deux passionnés de la restauration."
    ],
    "es": [
      "Pequeño restaurante de especialidades corsas, abierto desde el 20 de junio de 2020.\r\nMezcla de Alexia y Antoine, l'Alant es el fruto de un encuentro en el lado de Propriano, entre dos entusiastas de la restauración."
    ],
    "nl": [
      "Klein restaurant met Corsicaanse specialiteiten, geopend sinds 20 juni 2020.\r\nL'Alant, een mix van Alexia en Antoine, is het resultaat van een ontmoeting aan de kant van Propriano tussen twee restaurantliefhebbers."
    ]
  },
  "rdfs:label": {
    "fr": [
