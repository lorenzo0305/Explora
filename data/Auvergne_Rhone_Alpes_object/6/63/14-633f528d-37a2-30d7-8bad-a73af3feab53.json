  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/20a77642-0a14-3f07-9b18-cc672268ed6f",
      "dc:description": {
        "de": [
          "Eine fröhliche Abrechnung.......Zwischen unbequemen Wahrheiten und wohlwollenden Lügen reiht sich ein Lacher an den anderen! für einen Abend, der die Zygomatiken zum Glühen bringt."
        ],
        "en": [
          "A joyful settlement of accounts.......Between inconvenient truths and benevolent lies, the laughs keep coming! for an evening that gets the zygomatic muscles firing."
        ],
        "it": [
          "Un gioioso regolamento di conti.......Tra scomode verità e benevole bugie, le risate non mancano! per una serata che mette in moto i muscoli zigomatici."
        ],
        "fr": [
          "Un joyeux règlement de compte.......Entre vérités qui dérangent et mensonges bienveillants, les rires s’enchaînent ! pour une soirée qui fait chauffer les zygomatiques."
        ],
        "es": [
          "Un alegre ajuste de cuentas.......Entre verdades incómodas y mentiras benévolas, ¡las risas no cesan! para una velada que pone en marcha los músculos cigomáticos."
        ],
        "nl": [
          "Een vrolijke afrekening van scores.......Tussen ongemakkelijke waarheden en welwillende leugens blijft het lachen! voor een avond die de zygomatische spieren doet werken."
        ]
      },
