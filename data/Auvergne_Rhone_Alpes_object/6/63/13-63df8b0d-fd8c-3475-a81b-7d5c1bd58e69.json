  "rdfs:comment": {
    "de": [
      "Die Pumptrack-Strecke in Yenne ist eine Einladung zum Reiten für alle, die Fahrräder, Skateboards, Roller oder Inlineskates benutzen! Vom Kind mit Draisine bis zum Mountainbiker hat hier jeder seinen Spaß und fährt auf seine Weise."
    ],
    "en": [
      "Bikers, skateboarders, scooters, rollerbladers... the pumptrack track in Yenne is an invitation to ride! From children on draisienne bikes to good mountain bikers, everyone can have fun and ride in their own way."
    ],
    "it": [
      "Motociclisti, skateboarder, monopattini, rollerbladers... la pista di pumptrack di Yenne è un invito a pedalare! Dai bambini in sella alla draisienne agli appassionati di mountain bike, tutti possono divertirsi e pedalare a modo loro."
    ],
    "fr": [
      "Avis aux utilisateurs de vélos, skateboards, trottinettes, rollers... la piste de pumptrack de Yenne est une invitation à rider ! De l’enfant en draisienne au bon vététiste chacun s’amuse et roule à sa manière."
    ],
    "nl": [
      "Fietsers, skateboarders, scooters, skeeleraars... de pumptrackbaan in Yenne is een uitnodiging om te rijden! Van kinderen op draisienne-fietsen tot serieuze mountainbikers, iedereen kan zich vermaken en op zijn eigen manier rijden."
    ],
    "es": [
      "Ciclistas, patinadores, patinetes, patinadores... ¡la pista de pumptrack de Yenne es una invitación a rodar! Desde los niños con sus bicicletas draisienne hasta los ciclistas de montaña más serios, todo el mundo puede divertirse y pedalear a su manera."
    ]
  },
