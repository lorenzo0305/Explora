  "rdfs:comment": {
    "de": [
      "Vier Informationsbüros sind das ganze Jahr über oder in der Hochsaison in den Combrailles geöffnet, um Besucher und Einwohner der Region bestmöglich zu betreuen."
    ],
    "en": [
      "Four information offices are open all year round or in high season, throughout the Combrailles, in order to welcome visitors and inhabitants of the territory."
    ],
    "it": [
      "Quattro uffici informazioni sono aperti tutto l'anno o in alta stagione, in tutte le Combrailles, per accogliere i visitatori e gli abitanti della zona."
    ],
    "fr": [
      "Quatre bureaux d’information sont ouverts à l’année ou en haute saison, à travers les Combrailles, afin d’accueillir au mieux les visiteurs et habitants du territoire."
    ],
    "nl": [
      "Vier informatiekantoren zijn het hele jaar door of in het hoogseizoen in de hele Combrailles geopend om bezoekers en inwoners van het gebied te ontvangen."
    ],
    "es": [
      "Cuatro oficinas de información están abiertas todo el año o en temporada alta, en todas las Combrailles, para acoger a los visitantes y habitantes de la zona."
    ]
  },
