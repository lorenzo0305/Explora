  "rdfs:comment": {
    "de": [
      "Organisation von Veranstaltungen für Unternehmen. Hervorhebung der Vorzüge der Region. Organisation von Erlebnissen für die breite Öffentlichkeit, z. B. Abendessen im Dunkeln, ein Gourmet-Spaziergang durch die Weinberge..."
    ],
    "en": [
      "Organization of events for companies. Highlighting the region’s assets. Organization of experiences for the general public such as dinners in the dark, a gourmet stroll in the vineyards..."
    ],
    "it": [
      "Organizzazione di eventi aziendali. Promozione dei beni della regione. Organizzazione di esperienze per il grande pubblico, come cene al buio, passeggiate gastronomiche tra i vigneti, ecc."
    ],
    "fr": [
      "Organisation d'évènements pour les entreprises. Mise en avant des atouts de la région. Organisation d'expériences pour le grand public comme des diners dans le noir, une balade gourmande dans les vignes..."
    ],
    "es": [
      "Organización de actos corporativos. Puesta en valor de los activos de la región. Organización de experiencias para el gran público, como cenas en la oscuridad, paseos gastronómicos por los viñedos, etc."
    ],
    "nl": [
      "Organisatie van bedrijfsevenementen. Benadrukken van de troeven van de regio. Organisatie van ervaringen voor het grote publiek, zoals diners in het donker, gastronomische wandelingen door de wijngaarden, enz."
    ]
  },
