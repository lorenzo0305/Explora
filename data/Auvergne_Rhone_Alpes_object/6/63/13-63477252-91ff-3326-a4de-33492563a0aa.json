  "rdfs:comment": {
    "de": [
      "Das Petit Marcel empfängt Sie mit Geselligkeit in einem gemütlichen Rahmen. Seine Küche bietet \"hausgemachte\" Gerichte sowie Pizzas."
    ],
    "en": [
      "Le Petit Marcel offers a warm welcome in a cosy setting. The kitchen offers homemade dishes and pizzas."
    ],
    "it": [
      "Le Petit Marcel offre un'accoglienza calorosa in un ambiente accogliente. La cucina serve piatti fatti in casa e pizze."
    ],
    "fr": [
      "Le Petit Marcel vous accueille avec convivialité dans un cadre cosy. Sa cuisine propose des plats \"fait maison\", ainsi que des pizzas."
    ],
    "es": [
      "Le Petit Marcel ofrece una cálida bienvenida en un entorno acogedor. La cocina sirve platos caseros y pizzas."
    ],
    "nl": [
      "Le Petit Marcel biedt een warm welkom in een gezellige omgeving. De keuken serveert huisgemaakte gerechten en pizza's."
    ]
  },
