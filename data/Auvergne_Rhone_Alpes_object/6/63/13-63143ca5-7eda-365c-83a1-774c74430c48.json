  "rdfs:comment": {
    "de": [
      "Die Bienen übernehmen die Macht, um den Planeten zu retten!\r\nDiese Bewegung vereint professionelle \"Bienen\" in ganz Frankreich um pädagogische Workshops zur Vermittlung von Werten und Zusammenhalt."
    ],
    "en": [
      "Bees take power to save the planet!\r\nThis movement gathers professional \"Bees\" in all France around educational workshops of transmission of values and cohesion."
    ],
    "it": [
      "Le api prendono il potere per salvare il pianeta!\r\nQuesto movimento riunisce \"api\" professionali in tutta la Francia attorno a laboratori educativi per trasmettere valori e coesione."
    ],
    "fr": [
      "Les abeilles prennent le pouvoir pour sauver la planète !\r\nCe mouvement rassemble des « Abeilles » professionnelles dans toute la France autour d’ateliers pédagogiques de transmission de valeurs et de cohésion."
    ],
    "es": [
      "Las abejas toman el poder para salvar el planeta\r\nEste movimiento reúne a las \"abejas\" profesionales de toda Francia en torno a talleres educativos para transmitir valores y cohesión."
    ],
    "nl": [
      "Bijen nemen de macht om de planeet te redden!\r\nDeze beweging brengt professionele \"bijen\" in heel Frankrijk samen rond educatieve workshops om waarden en cohesie over te brengen."
    ]
  },
