  "rdfs:comment": {
    "de": [
      "Ein Restaurant direkt an der Schneefront mit großen Glasfenstern in einem großen Chalet aus Holz und Stein mit Ethanol-Kamin. es werden 2 Arten von Restaurants angeboten: Snackformel am Mittag, Spezialitäten und Gourmetformel am Abend."
    ],
    "en": [
      "A restaurant located at the foot of the slopes, with large windows in a large wooden chalet with etahnol fireplace. Enjoy a snack at lunch and gourmet specialities at night. Before skiing, start your day with an unilimited breakfast buffet."
    ],
    "it": [
      "Un ristorante direttamente sul fronte neve con ampie vetrate, in un grande chalet in legno e pietra con camino a etanolo. vengono offerti 2 tipi di ristorazione: formula snack a pranzo, specialità e formula gourmet la sera."
    ],
    "fr": [
      "Un restaurant directement placé sur le front de neige avec de grandes baies vitrées, dans un grand chalet en bois et pierre avec cheminée à l'éthanol. 2 types de restauration sont proposés : formule snack le midi, spécialités et formule gourmande le soir."
    ],
    "es": [
      "Un restaurante directamente en el frente de la nieve con grandes ventanas, en un gran chalet de madera y piedra con chimenea de etanol. se ofrecen 2 tipos de restauración: fórmula de aperitivo a la hora de comer, y especialidades y fórmula gourmet por la noche."
    ],
    "nl": [
      "Een restaurant direct geplaatst op de sneeuw voorzijde, met grote ramen in een grote houten chalet en natuurstenen schouw met ethanol. 2 soorten voedsel worden aangeboden: Formule snack lunch, gastronomische specialiteiten en 's avonds formule."
    ]
  },
