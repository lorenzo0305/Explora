  "rdfs:comment": {
    "de": [
      "O' Brasseurs, ein neues Restaurant in Brignais, bietet Ihnen an sieben Tagen in der Woche nach oder vor Ihrem Kinobesuch oder einfach nur für einen gemütlichen Moment mit Freunden etwas zu essen an. Lassen Sie sich unser gegrilltes Fleisch und unsere hausgemachten Desserts schmecken!"
    ],
    "en": [
      "O' Brasseurs, a new restaurant in Brignais, offers you a restaurant 7 days a week after or before your cinema session, or simply for a convivial moment with friends. Enjoy our grilled meats and homemade desserts!"
    ],
    "it": [
      "O' Brasseurs, un nuovo ristorante di Brignais, vi offre un ristorante 7 giorni su 7 dopo o prima della vostra sessione di cinema, o semplicemente per un momento conviviale con gli amici. Gustate le nostre carni alla griglia e i nostri dolci fatti in casa!"
    ],
    "fr": [
      "O' Brasseurs, nouveau restaurant à Brignais vous propose une restauration 7 jours sur 7 après ou avant votre séance de cinéma, ou simplement pour un moment convivial entre amis. Régalez-vous de nos viandes grillées et de nos desserts maison !"
    ],
    "es": [
      "O' Brasseurs, un nuevo restaurante en Brignais, le ofrece un restaurante los 7 días de la semana después o antes de su sesión de cine, o simplemente para un momento de convivencia con los amigos. ¡Disfruta de nuestras carnes a la parrilla y postres caseros!"
    ],
    "nl": [
      "O' Brasseurs, een nieuw restaurant in Brignais, biedt u 7 dagen per week een restaurant na of voor uw bioscoopsessie, of gewoon voor een gezellig moment met vrienden. Geniet van onze gegrilde vleeswaren en huisgemaakte desserts!"
    ]
  },
  "rdfs:label": {
