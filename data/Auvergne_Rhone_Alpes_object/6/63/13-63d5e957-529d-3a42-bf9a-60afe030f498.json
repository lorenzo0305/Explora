  "rdfs:comment": {
    "de": [
      "Als Familienbetrieb stellt die Domaine des Mûres heute Mehl, Getreide, Öle und aromatisierte Weinspezialitäten her. Erfahren Sie mehr über unsere Tätigkeit, unsere Bio-Produkte und besuchen Sie uns auf unserem Betrieb!\r\nLabel \"Goûtez l'Ardèche\""
    ],
    "en": [
      "A family-run business, Domaine des Mûres now produces flours, cereals, oils and aromatized wine specialties. Find out more about our business, our organic products and visit us on our farm!\r\nLabel Goûtez l'Ardèche."
    ],
    "it": [
      "Azienda a conduzione familiare, il Domaine des Mûres produce oggi farina, cereali e oli. Scoprite di più sulla nostra attività, sui nostri prodotti biologici e venite a trovarci in azienda!\r\nEtichetta Goûtez l'Ardèche."
    ],
    "fr": [
      "Exploitation familiale, le Domaine des Mûres produit aujourd’hui des farines, des céréales, des huiles. Découvrez notre activité, nos produits bio et  retrouvez nous sur notre exploitation !\r\nLabel  Goûtez l’Ardèche."
    ],
    "es": [
      "Empresa familiar, la Domaine des Mûres produce actualmente harina, cereales y aceites. Descubra nuestra empresa, nuestros productos ecológicos y visítenos en nuestra granja\r\nEtiqueta Goûtez l'Ardèche."
    ],
    "nl": [
      "Domaine des Mûres is een familiebedrijf dat nu meel, granen en oliën produceert. Kom meer te weten over ons bedrijf, onze biologische producten en bezoek ons op onze boerderij!\r\nLabel Goûtez l?Ardèche."
    ]
  },
