  "rdfs:comment": {
    "de": [
      "Am Samstag, den 14. Juni, öffnet das 9-9bis seine geheimen Gärten und ... geht in den Kirmesmodus über!"
    ],
    "en": [
      "With the scent of summer just around the corner, 9-9bis opens its secret gardens to you on Saturday June 14th, and? goes into party mode!"
    ],
    "it": [
      "Con l'estate alle porte, il 9-9bis aprirà i suoi giardini segreti sabato 14 giugno e si metterà in modalità festa!"
    ],
    "fr": [
      "Comme un parfum d’été avant l’heure, le 9-9bis vous ouvre ses jardins secrets le samedi 14 juin et… passe en mode kermesse !"
    ],
    "nl": [
      "Met de zomer voor de deur stelt 9-9bis op zaterdag 14 juni zijn geheime tuinen voor je open en gaan we in feestmodus!"
    ],
    "es": [
      "Con el verano a la vuelta de la esquina, 9-9bis te abre sus jardines secretos el sábado 14 de junio y... ¡se pone de fiesta!"
    ]
  },
