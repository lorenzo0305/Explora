  "rdfs:comment": {
    "de": [
      "Willkommen bei Delphine und Ludovic, zwei leidenschaftlichen Landwirten, die mit Sorgfalt das Beste aus der Natur anbauen. In Les Hurtirêves gedeihen Kräuter, Heilpflanzen und Obstgärten in einer geschützten Umgebung, unterstützt von unseren Bienen, die den Rhythmus des Hofes bestimmen."
    ],
    "en": [
      "Welcome to Delphine and Ludovic, two enthusiasts who carefully cultivate the very best of nature. At Les Hurtirêves, aromatic and medicinal plants and orchards flourish in an unspoilt setting, aided by our bees who give rhythm to the farm."
    ],
    "it": [
      "Benvenuti da Delphine e Ludovic, due appassionati che coltivano con cura il meglio della natura. A Les Hurtirêves, piante aromatiche e medicinali e frutteti fioriscono in un ambiente incontaminato, aiutati dalle nostre api che danno il ritmo alla fattoria."
    ],
    "fr": [
      "Bienvenue chez Delphine et Ludovic, deux passionnés qui cultivent avec soin le meilleur de la nature. Aux Hurtirêves, les plantes aromatiques, médicinales et les vergers s'épanouissent dans un cadre préservé, aidés par nos abeilles qui rythment la ferme."
    ],
    "nl": [
      "Welkom bij Delphine en Ludovic, twee enthousiastelingen die met zorg het beste van de natuur cultiveren. Op Les Hurtirêves bloeien aromatische en geneeskrachtige planten en boomgaarden in een ongerepte omgeving, geholpen door onze bijen die ritme geven aan de boerderij."
    ],
    "es": [
      "Bienvenidos a Delphine y Ludovic, dos apasionados que cultivan con esmero lo mejor de la naturaleza. En Les Hurtirêves, las plantas aromáticas y medicinales y los huertos florecen en un entorno virgen, ayudados por nuestras abejas que dan ritmo a la granja."
    ]
  },
  "rdfs:label": {
