  "rdfs:comment": {
    "de": [
      "Seit 22 Jahren verwöhnt Sie Alex mit köstlichen, handgemachten Pizzen. Für die Feinschmecker unter Ihnen gibt es eine besondere Spezialität: die Doppelpizza!"
    ],
    "en": [
      "For 22 years, Alex has been treating you to tasty homemade pizzas. For those with a sweet tooth, discover the speciality: double pizza!"
    ],
    "it": [
      "Da 22 anni, Alex vi delizia con gustose pizze fatte in casa. Per i più golosi, scoprite la specialità: la doppia pizza!"
    ],
    "fr": [
      "Depuis 22 ans, Alex vous régale avec de savoureuses pizzas artisanales. Pour les gourmands, découvrez la spécialité : la pizza double!"
    ],
    "es": [
      "Desde hace 22 años, Alex te deleita con sabrosas pizzas caseras. Para los más golosos, descubra la especialidad: ¡la pizza doble!"
    ],
    "nl": [
      "Al 22 jaar vermaakt Alex u met lekkere zelfgemaakte pizza's. Voor de zoetekauwen: ontdek de specialiteit: de dubbele pizza!"
    ]
