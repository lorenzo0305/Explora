  "rdfs:comment": {
    "de": [
      "Das Atelier Partagé de Vienne ist ein Verein, der Kurse und Workshops für visuelle Kunst organisiert, Kunstausstellungen veranstaltet und an kulturellen Veranstaltungen teilnimmt."
    ],
    "en": [
      "A panel of paintings of great quality are to be appreciated by passers-by and future students curious to try their hand at the various disciplines on offer: sketching, academic drawing, directed painting based on various themes..."
    ],
    "it": [
      "L'Atelier Partagé di Vienne è un'associazione che organizza corsi e laboratori di arti visive, mostre d'arte ed eventi culturali."
    ],
    "fr": [
      "L'Atelier Partagé de Vienne est une association qui organise des cours et ateliers d'arts visuels, des expositions d'arts et participe à des évènements culturels."
    ],
    "nl": [
      "L'Atelier Partagé de Vienne is een vereniging die cursussen en workshops in beeldende kunst, kunsttentoonstellingen en culturele evenementen organiseert."
    ],
    "es": [
      "L'Atelier Partagé de Vienne es una asociación que organiza cursos y talleres de artes visuales, exposiciones de arte y actos culturales."
    ]
  },
