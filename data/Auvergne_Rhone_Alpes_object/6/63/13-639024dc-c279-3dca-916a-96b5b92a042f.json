  "rdfs:comment": {
    "de": [
      "Kleines Restaurant im Herzen des Dorfes Salettes, das eine traditionelle regionale Küche mit frischen Produkten anbietet. Es werden auch Themenabende veranstaltet."
    ],
    "en": [
      "Small restaurant in the heart of the village of Salettes, serving traditional local cuisine with fresh produce. Theme evenings are also organized."
    ],
    "it": [
      "Piccolo ristorante nel cuore del villaggio di Salettes, che propone una cucina tradizionale locale a base di prodotti freschi. Si organizzano anche serate a tema."
    ],
    "fr": [
      "Petit restaurant au cœur du village de Salettes, qui propose une cuisine traditionnelle de terroir avec des produits frais. Des soirées à thème sont également organisées."
    ],
    "es": [
      "Pequeño restaurante en el corazón del pueblo de Salettes, que sirve cocina tradicional local elaborada con productos frescos. También se organizan veladas temáticas."
    ],
    "nl": [
      "Klein restaurant in het hart van het dorp Salettes, waar traditionele lokale gerechten met verse producten worden geserveerd. Er worden ook thema-avonden georganiseerd."
    ]
  },
  "rdfs:label": {
