      "@id": "https://data.datatourisme.fr/3e775eff-56df-3609-bda4-8459a0aa472b",
      "dc:description": {
        "de": [
          "Picknickplatz am Rande des Staatsforstes von Hez und entlang des Radwegs. Verschiedene Ausstattungen: 3 Picknicktische, Parkplatz und Mülleimer."
        ],
        "en": [
          "Picnic area located at the edge of the Hez National Forest and along the cycle path. Various equipment: 3 picnic tables, car park and bins."
        ],
        "it": [
          "Area picnic ai margini della foresta di Hez e lungo la pista ciclabile. Varie strutture: 3 tavoli da picnic, parcheggio e cestini per i rifiuti."
        ],
        "fr": [
          "Aire de pique-nique se situant au bord de la Forêt Domaniale de Hez et le long de la piste cyclable. Divers équipement : 3 tables de pique-nique, parking et poubelles."
        ],
        "es": [
          "Zona de picnic en el borde del bosque de Hez y a lo largo del carril bici. Diversas instalaciones: 3 mesas de picnic, aparcamiento y papeleras."
        ],
        "nl": [
          "Picknickplaats aan de rand van het bos van Hez en langs het fietspad. Diverse voorzieningen: 3 picknicktafels, parkeerplaats en afvalbakken."
        ]
      },
