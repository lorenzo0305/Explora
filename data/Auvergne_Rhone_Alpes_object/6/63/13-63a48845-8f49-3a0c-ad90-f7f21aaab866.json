  "rdfs:comment": {
    "de": [
      "Für Menschen, die grafische Künste und manuelles Gestalten lieben, bietet Albane die Möglichkeit, Ihr Bild unter der Presse zu gravieren und zu drucken."
    ],
    "en": [
      "For those who love graphic arts and manual creation, Albane can engrave and print your image on the press."
    ],
    "it": [
      "Per chi ama le arti grafiche e la creazione manuale, Albane offre la possibilità di incidere e stampare la propria immagine sulla macchina da stampa."
    ],
    "fr": [
      "Pour les personnes qui aiment les arts graphiques et la création manuelle, Albane vous propose de graver et d’imprimer votre image sous la presse."
    ],
    "nl": [
      "Voor liefhebbers van grafische kunst en handmatige creatie biedt Albane de mogelijkheid om je afbeelding te graveren en af te drukken op de pers."
    ],
    "es": [
      "Para los amantes de las artes gráficas y la creación manual, Albane le propone grabar e imprimir su imagen en la prensa."
    ]
  },
