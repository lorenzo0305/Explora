  "rdfs:comment": {
    "de": [
      "Julie, eine Illustratorin mit Aquarellfarben, malt originelle Illustrationen im Laufe der Jahreszeiten. Entdecken Sie ihre Briefpapier- und Kartenkollektion. Poster, Geburtstagskarten, Grußkarten, Geburtsgeschenke, personalisierte Aquarelle."
    ],
    "en": [
      "Julie, watercolor illustrator, paints original illustrations with the seasons. Discover her collection of stationery and cards. Posters, birthday cards, greeting cards, baby gifts, personalized watercolors."
    ],
    "it": [
      "Julie, illustratrice ad acquerello, dipinge illustrazioni originali durante tutte le stagioni. Scoprite la sua collezione di articoli di cartoleria e biglietti. Poster, biglietti di compleanno, biglietti d'auguri, regali per bambini, acquerelli personalizzati."
    ],
    "fr": [
      "Julie, illustratrice à l'aquarelle peint des illustrations originales au fil des saisons. Découvrez sa collection de papeterie et de carterie. Affiches, cartes d'anniversaire, cartes de vœux, cadeaux de naissance, aquarelles personnalisées."
    ],
    "es": [
      "Julie, ilustradora acuarelista, pinta originales ilustraciones a lo largo de las estaciones. Descubra su colección de papelería y tarjetas. Pósteres, tarjetas de cumpleaños, felicitaciones, regalos para bebés y acuarelas personalizadas."
    ],
    "nl": [
      "Julie, aquarelillustrator, schildert originele illustraties door de seizoenen heen. Ontdek haar collectie papierwaren en kaarten. Posters, verjaardagskaarten, wenskaarten, kraamcadeaus, gepersonaliseerde aquarellen."
    ]
  },
