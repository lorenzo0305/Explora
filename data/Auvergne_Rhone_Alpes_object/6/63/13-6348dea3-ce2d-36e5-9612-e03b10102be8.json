  "rdfs:comment": {
    "de": [
      "Die Sophrologin Gaelle Jullien bietet Sophrologie für Kinder von 6 bis 11 Jahren an.\r\nSie bietet auch andere Themen (Sophro complicité, Sophro contes, kollektive Sophrologie...) an anderen Orten an."
    ],
    "en": [
      "Sophrologist Gaelle Jullien offers sophrology for children aged 6 to 11.\r\nShe also offers other themes (sophro complicity, sophro storytelling, group sophrology...) in other locations."
    ],
    "it": [
      "La sofrologa Gaelle Jullien propone la sofrologia per bambini dai 6 agli 11 anni.\r\nIn altri luoghi propone altri temi (la complicità dei sofisti, la narrazione dei sofisti, la sofrologia di gruppo...)."
    ],
    "fr": [
      "Gaelle Jullien sophrologue propose de la sophrologie pour enfants de 6 à 11 ans.\r\nElle propose d'autres thèmes (sophro complicité, sophro contes, sophrologie collective...) dans d'autres lieux."
    ],
    "nl": [
      "Sofrologiste Gaelle Jullien biedt sofrologie aan voor kinderen van 6 tot 11 jaar.\r\nZe biedt ook andere thema's aan (sophro complicity, sophro storytelling, groepsdemonrologie, etc.) op andere locaties."
    ],
    "es": [
      "La sofróloga Gaelle Jullien ofrece sofrología para niños de 6 a 11 años.\r\nOfrece otros temas (complicidad sofista, narración sofista, sofrología de grupo...) en otros lugares."
    ]
  },
