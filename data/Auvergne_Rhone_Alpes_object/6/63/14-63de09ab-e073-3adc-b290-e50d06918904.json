  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/dcad90c3-307e-3980-bf89-7e712915fbce",
      "dc:description": {
        "de": [
          "Zimmer mit einem Doppelbett und Fernseher.\nEin Teil der Zimmer hat Seeblick, die anderen verfügen über eine private Terrasse mit einem kleinen Garten."
        ],
        "en": [
          "Rooms composed of a double bed with television.\nEstablishment located in an atypical setting with some of the rooms have a view of the lake and the others have a private terrace with a small garden."
        ],
        "it": [
          "Camere con letto matrimoniale e televisione.\nLa struttura si trova in un ambiente atipico, con alcune camere che si affacciano sul lago e altre che dispongono di una terrazza privata con un piccolo giardino."
        ],
        "fr": [
          "Chambres composées d'un lit 2 personnes avec télévision.\nEtablissement situé dans un cadre atypique avec une partie des chambres ont vue sur le lac et les autres possèdent une terrasse privative avec jardinet."
        ],
        "nl": [
          "Kamers met een tweepersoonsbed en televisie.\nHet etablissement ligt in een atypische omgeving: sommige kamers kijken uit op het meer en de andere hebben een eigen terras met een kleine tuin."
        ],
        "es": [
          "Habitaciones con cama doble y televisión.\nEl establecimiento está situado en un entorno atípico, ya que algunas de las habitaciones tienen vistas al lago y las otras disponen de una terraza privada con un pequeño jardín."
        ]
      },
      "@type": [
        "Description"
