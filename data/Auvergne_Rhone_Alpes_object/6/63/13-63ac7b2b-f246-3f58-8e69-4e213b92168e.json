  "rdfs:comment": {
    "de": [
      "Das Hotel Mercure Arc 1800**** befindet sich im Herzen des Charmettoger-Waldes und genießt eine einzigartige Lage zwischen Tälern und Gipfeln von seltener Schönheit. Skifahren bis vor die Haustür, 5 Minuten vom Zentrum von Les Villards entfernt, genießen Sie eine ideale Umgebung!"
    ],
    "en": [
      "Right in the heart of the Charmettoger forest, the Mercure Les Arcs 1800 4-star hotel enjoys a unique position between valleys and peaks of rare beauty. Ski-in-ski-out, 5 minutes from the centre of les Villards; you can enjoy an ideal setting."
    ],
    "it": [
      "Nel cuore della foresta di Charmettoger, il Mercure Arc 1800 hotel**** gode di una posizione unica tra valli e cime di rara bellezza. Ski in, ski out, a 5 minuti dal centro di Les Villards, godetevi un ambiente ideale!"
    ],
    "fr": [
      "En plein cœur de la foret de Charmettoger, l'hotel Mercure Arc 1800**** bénéficie d'une situation unique entre vallées et cimes d'une rare beauté. Ski au pied, à 5 min du centre des Villards, profitez d'un cadre idéal!"
    ],
    "es": [
      "Located in a pine and larg forest at the foot of the charmettoger chairlift, this quality hotel offers an excellent standard of services."
    ],
    "nl": [
      "Het Mercure Arc 1800 hotel **** ligt midden in het bos van Charmettoger, op een unieke locatie tussen zeldzaam mooie valleien en bergtoppen. Ski in, ski out, 5 minuten van het centrum van Les Villards, geniet van een ideale omgeving!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant de l'Hôtel Mercure"
    ]
  },
