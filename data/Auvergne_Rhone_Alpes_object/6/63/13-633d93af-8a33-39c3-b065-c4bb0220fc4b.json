  "rdfs:comment": {
    "de": [
      "Das 4* Hotel Novotel Clermont-Ferrand liegt am Stadtrand, in der Nähe der wichtigsten Verkehrsachsen, mit einem schönen Park, Freibad und Parkplatz."
    ],
    "en": [
      "The Novotel Clermont-Ferrand 4* hotel is located on the outskirts of the city, close to the main roads, with a lovely park, outdoor swimming pool and parking lot."
    ],
    "it": [
      "L'hotel 4 stelle Novotel Clermont-Ferrand si trova alla periferia della città, vicino ai principali collegamenti di trasporto, con un grazioso parco, una piscina all'aperto e un parcheggio."
    ],
    "fr": [
      "L'hôtel Novotel Clermont-Ferrand 4*, est situé en bordure de ville, proche des principaux axes de communication, doté d'un jolie parc, piscine extérieure et parking."
    ],
    "nl": [
      "Het viersterrenhotel Novotel Clermont-Ferrand ligt aan de rand van de stad, dicht bij de belangrijkste vervoersverbindingen, met een mooi park, buitenzwembad en parkeerplaats."
    ],
    "es": [
      "El hotel de 4 estrellas Novotel Clermont-Ferrand está situado a las afueras de la ciudad, cerca de los principales enlaces de transporte, con un bonito parque, piscina al aire libre y aparcamiento."
    ]
  },
