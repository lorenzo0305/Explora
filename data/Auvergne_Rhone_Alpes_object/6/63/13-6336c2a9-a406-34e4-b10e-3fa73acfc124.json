  "rdfs:comment": {
    "de": [
      "Geselliges Restaurant, das Gourmetgerichte aus frischen Produkten anbietet. Abends wechselt das Lokal in den Afterwork-Modus, Happy Hour von 17 bis 19 Uhr, Tapas- und Wurstkarte. Gastronomie vor Ort, abends möglich."
    ],
    "en": [
      "Friendly restaurant serving gourmet dishes made with fresh produce. In the evening, the atmosphere changes to Afterwork mode, with Happy Hour from 5pm to 7pm, and a tapas and charcuterie menu. On-site catering available in the evening."
    ],
    "it": [
      "Un ristorante accogliente che serve piatti gourmet preparati con prodotti freschi. La sera, il ristorante cambia atmosfera e passa alla modalità Afterwork, con Happy Hour dalle 17.00 alle 19.00 e un menu di tapas e salumi. La sera è disponibile un servizio di catering in loco."
    ],
    "fr": [
      "Restaurant convivial proposant des plats gourmands à base de produits frais. Le soir, l’établissement change d’ambiance pour se mettre en mode Afterwork, Happy Hour de 17h à 19h, carte de tapas et charcuteries. Restauration sur place,  possible en soirée."
    ],
    "es": [
      "Un restaurante acogedor que sirve platos gourmet elaborados con productos frescos. Por la noche, el restaurante cambia de ambiente y se pone en modo Afterwork, con Happy Hour de 17:00 a 19:00 y un menú de tapas y embutidos. Por la noche, servicio de catering in situ."
    ],
    "nl": [
      "Een vriendelijk restaurant dat gastronomische gerechten serveert, bereid met verse producten. S Avonds verandert het restaurant van sfeer en gaat het over in Afterwork-modus, met Happy Hour van 17.00 tot 19.00 uur en een tapas- en vleeswarenmenu. Catering op locatie is 's avonds beschikbaar."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La FAK"
    ]
  },
