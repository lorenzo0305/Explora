  "rdfs:comment": {
    "de": [
      "Initiative, die den französischen und deutschen Künstlern gewidmet ist, die während des Zweiten Weltkriegs als Flüchtlinge und Widerstandskämpfer in Dieulefit lebten."
    ],
    "en": [
      "Tour dedicated to French and Germans artists who were refugees and resistant fighters during WWII in Dieulefit.\r\nDuration : approx. 1 hour & 15 minutes + 30 minutes."
    ],
    "it": [
      "Iniziativa dedicata agli artisti francesi e tedeschi rifugiati e resistenti a Dieulefit durante la Seconda Guerra Mondiale."
    ],
    "fr": [
      "Initiative dédiée aux artistes français et allemands réfugiés et résistants, à Dieulefit, pendant la Deuxième Guerre."
    ],
    "nl": [
      "Initiatief gewijd aan Franse en Duitse kunstenaars die tijdens de Tweede Wereldoorlog in Dieulefit vluchtten en zich verzetten."
    ],
    "es": [
      "Iniciativa dedicada a los artistas franceses y alemanes refugiados y resistentes en Dieulefit durante la Segunda Guerra Mundial."
    ]
  },
