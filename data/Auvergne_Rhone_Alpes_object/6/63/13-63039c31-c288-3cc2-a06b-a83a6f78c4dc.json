  "rdfs:comment": {
    "de": [
      "Tauchen Sie ein in die bezaubernde Welt des Orients: Seidenstoffe, Gold, Mysterien und Sinnlichkeit. Orientalische Tänzerinnen, Performerinnen, die in Lichter gehüllt sind, berauschende Musik und Dekorationen wie in den Palästen vergangener Zeiten."
    ],
    "en": [
      "Immerse yourself in the bewitching world of the Orient, with its silks, gilding, mystery and sensuality. Oriental dancers, performers veiled in lights, intoxicating music and palace decor of yesteryear."
    ],
    "it": [
      "Immergetevi nel mondo ammaliante dell'Oriente, con le sue sete, le sue dorature, il suo mistero e la sua sensualità. Danzatrici orientali, artisti velati di luci, musica inebriante e l'arredamento dei palazzi di un tempo."
    ],
    "fr": [
      "Plongez dans l’univers envoutant de l’Orient, soieries, dorures, mystère et sensualité. Danseuses orientales, performeuses voilées de lumières, musiques enivrantes et décors des palais d’antan."
    ],
    "es": [
      "Sumérjase en el hechizante mundo de Oriente, con sus sedas, dorados, misterio y sensualidad. Bailarinas orientales, artistas envueltos en luces, música embriagadora y la decoración de los palacios de antaño."
    ],
    "nl": [
      "Dompel jezelf onder in de betoverende wereld van het Oosten, met zijn zijde, verguldsel, mysterie en sensualiteit. Oriëntaalse dansers, in licht gehulde artiesten, bedwelmende muziek en het decor van de paleizen van weleer."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Dîner spectacle au Casino - Mille et une nuits"
    ]
  },
