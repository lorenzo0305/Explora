  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/7a909b3a-f311-3c38-9ba5-092d2f3fe032",
      "dc:description": {
        "de": [
          "Von 10.00 bis 17.00 Uhr werden in der Mediathek Bücher und Zeitschriften, die keinen Platz in den Sammlungen finden, ab 0,20 ? zugunsten einer Solidaritätsaktion verkauft."
        ],
        "en": [
          "From 10.00 am to 5.00 pm at the media library, books and magazines that don't fit in the collections will be sold for 0.20 ? to raise money for a charity."
        ],
        "it": [
          "Dalle 10.00 alle 17.00 presso la biblioteca multimediale, i libri e le riviste che non rientrano nelle collezioni saranno venduti a 0,20€ per raccogliere fondi per un'associazione di beneficenza."
        ],
        "fr": [
          "De 10h00 à 17h00 à la médiathèque les livres et revues ne trouvant pas leur place dans les collections seront vendus à partir de 0.20 € au profit d'une action de solidarité."
        ],
        "nl": [
          "Van 10.00 tot 17.00 uur worden in de mediatheek boeken en tijdschriften die niet in de collecties passen verkocht voor € 0,20 om geld in te zamelen voor een goed doel."
        ],
        "es": [
          "De 10.00 a 17.00 horas, en la biblioteca multimedia, los libros y revistas que no quepan en las colecciones se venderán a 0,20 euros para recaudar fondos para una organización benéfica."
        ]
      },
