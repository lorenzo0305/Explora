  "rdfs:comment": {
    "de": [
      "6-stündige Bootsfahrt auf dem Kanal von Pont-de-Vaux, der Saône und der Seille bis nach Ratenelle und zurück. Durchfahrt durch die Schleusen. Mahlzeiten an Bord. Geführte Besichtigung des als sensibler Naturraum eingestuften Gebiets Les Charmes in Sermoyer bei einem Zwischenstopp von 14:30 bis 15:30 Uhr."
    ],
    "en": [
      "Departing from the port of Pont-de-Vaux, lunch cruise on the Canal de Pont-de-Vaux, the Saône and the Seille to Ratenelle and back. Passage of locks. Lunch on board. Guided tour of the Charmes site in Sermoyer."
    ],
    "it": [
      "Con partenza dal porto di Pont-de-Vaux, crociera con pranzo sul Canal de Pont-de-Vaux, la Saona e la Seille fino a Ratenelle e ritorno. Passaggio delle chiuse. Pranzo a bordo. Visita guidata del sito di Charmes a Sermoyer, classificato come area naturale sensibile."
    ],
    "fr": [
      "Au départ du port de Pont-de-VAux, croisière déjeuner sur le Canal de Pont-de-Vaux, la Saône et la Seille jusqu'à Ratenelle et retour. Passage d'écluses. Repas à bord. Visite guidée du site classé espace naturel sensible des Charmes à Sermoyer en escale."
    ],
    "nl": [
      "Vertrek vanuit de haven van Pont-de-Vaux, lunch op het Canal de Pont-de-Vaux, de Saône en de Seille naar Ratenelle en terug. Passage van sluizen. Lunch aan boord. Rondleiding door de Charmes site in Sermoyer, geclassificeerd als kwetsbaar natuurgebied."
    ],
    "es": [
      "Salida del puerto de Pont-de-Vaux, almuerzo crucero por el Canal de Pont-de-Vaux, el Saona y el Seille hasta Ratenelle y regreso. Paso de las esclusas. Almuerzo a bordo. Visita guiada del sitio de Charmes en Sermoyer, clasificado como espacio natural sensible."
    ]
  },
  "rdfs:label": {
    "de": [
      "Kreuzfahrt Seille und Dünen"
    ],
    "en": [
      "Seille and dunes cruise"
    ],
    "fr": [
      "Croisière Seille et dunes"
    ],
    "nl": [
      "Seille en duinen cruise"
    ]
  },
