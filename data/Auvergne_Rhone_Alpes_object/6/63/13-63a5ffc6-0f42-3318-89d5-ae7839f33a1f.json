  "rdfs:comment": {
    "de": [
      "Das in Valaurie im Herzen der Drôme Provençale ansässige Unternehmen Eyguebelle stellt mit Leidenschaft Sirupe und Aperitifs aus Früchten und Pflanzen her.\r\nErfahren Sie mehr über die Geschichte des Unternehmens und die Produktionsstätten. Besichtigung und Verkostung sind kostenlos."
    ],
    "en": [
      "Based in Valaurie, in the heart of the Drôme Provençale region, Eyguebelle is a passionate producer of fruit and plant syrups and aperitifs.\r\nCome and discover the company's history and production workshops. Free visit and tasting."
    ],
    "it": [
      "Con sede a Valaurie, nel cuore della Drôme Provençale, Eyguebelle produce con passione sciroppi di frutta e piante e aperitivi.\r\nVenite a scoprire la storia dell'azienda e i laboratori di produzione. Visita e degustazione gratuita."
    ],
    "fr": [
      "Implantée à Valaurie, au cœur de la Drôme Provençale, Eyguebelle élabore avec passion des sirops et apéritifs de fruits et plantes.\r\nVenez découvrir l'histoire de l'entreprise et les ateliers de fabrication. Visite et dégustation gratuites."
    ],
    "nl": [
      "Eyguebelle, gevestigd in Valaurie, in het hart van de Drôme Provençale, is gepassioneerd door het maken van fruit- en plantensiropen en aperitieven.\r\nKom de geschiedenis van het bedrijf en de productieateliers ontdekken. Gratis bezoek en proeverij."
    ],
    "es": [
      "Con sede en Valaurie, en el corazón de la Drôme provenzal, Eyguebelle es un apasionado de la fabricación de siropes y aperitivos de frutas y plantas.\r\nVenga a descubrir la historia de la empresa y los talleres de producción. Visita y degustación gratuitas."
    ]
  },
