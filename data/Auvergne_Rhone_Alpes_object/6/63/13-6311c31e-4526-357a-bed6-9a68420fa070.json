  "rdfs:comment": {
    "de": [
      "Dieser mittelalterliche Garten liegt direkt gegenüber der Abteikirche von Saint-Chef und beherbergt ein Quadrat, das aus Heilpflanzen besteht. Er wird durch Rosenbeete und eine Feldhecke ergänzt. Dieser Bereich lädt zum Ausruhen und Meditieren ein."
    ],
    "en": [
      "Situated just opposite the abbey church of Saint-Chef, this medieval garden features a square of medicinal plants. \r\nIt is complemented by rose beds and a country hedge. It's an inviting place to rest and meditate."
    ],
    "it": [
      "Situato proprio di fronte alla chiesa abbaziale di Saint-Chef, questo giardino medievale presenta un quadrato di piante medicinali. È completato da aiuole di rose e da una siepe di campagna. È un luogo invitante per riposare e meditare."
    ],
    "fr": [
      "Situé juste en face de l'abbatiale de Saint-Chef, ce jardin médiéval abrite un carré composé de plantes médicinales. Il est complété de parterres de rosiers et d'une haie champêtre. Cet espace invite au repos et à la méditation."
    ],
    "es": [
      "Situado justo enfrente de la iglesia abacial de Saint-Chef, este jardín medieval presenta un cuadrado de plantas medicinales. Se complementa con parterres de rosas y un seto campestre. Es un lugar acogedor para descansar y meditar."
    ],
    "nl": [
      "Deze middeleeuwse tuin ligt recht tegenover de abdijkerk van Saint-Chef en heeft een plein met geneeskrachtige planten. Hij wordt aangevuld met rozenperken en een landelijke haag. Het is een uitnodigende plek om uit te rusten en te mediteren."
    ]
  },
  "rdfs:label": {
    "en": [
      "Medieval Garden"
    ],
    "fr": [
      "Jardin médiéval"
    ]
  },
