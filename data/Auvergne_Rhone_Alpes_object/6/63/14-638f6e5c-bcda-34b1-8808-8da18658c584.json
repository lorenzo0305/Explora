  "rdfs:comment": {
    "de": [
      "Im Rahmen der Europäischen Tage des Kulturerbes öffnet Ihnen die Stadt Lens die Türen ihrer städtischen Kultureinrichtungen für ein unerwartetes Programm."
    ],
    "en": [
      "As part of the European Heritage Days, the City of Lens is opening the doors of its municipal cultural structures to an unexpected program."
    ],
    "it": [
      "Nell'ambito delle Giornate Europee del Patrimonio, la città di Lens apre le porte delle sue strutture culturali comunali a un programma inaspettato."
    ],
    "fr": [
      "Dans le cadre des Journées Européennes du Patrimoine, la Ville de Lens vous ouvre les portes de ses structures municipales culturelles pour un programme inattendu."
    ],
    "nl": [
      "In het kader van de Europese Erfgoeddagen opent de stad Lens de deuren van haar gemeentelijke culturele voorzieningen voor een onverwacht programma."
    ],
    "es": [
      "En el marco de las Jornadas Europeas del Patrimonio, la ciudad de Lens abre las puertas de sus instalaciones culturales municipales a un programa inesperado."
    ]
  },
