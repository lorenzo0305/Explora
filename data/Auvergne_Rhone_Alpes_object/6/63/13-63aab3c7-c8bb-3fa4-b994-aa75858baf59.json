  "rdfs:comment": {
    "de": [
      "Bergbegleiter, Spezialist für Wanderungen und Schneeschuhwanderungen. Wir stehen Ihnen für alle Ihre Wünsche zur Verfügung! RandArc ist ein Experte für das Lauzière-Massiv und das Dorf Montsapey und führt Sie durch eine geschützte Natur."
    ],
    "en": [
      "Mountain leader, specialist in hiking and snowshoeing. We're here to help you get away from it all! An expert in the Lauzière massif and the village of Montsapey, RandArc guides you into the heart of unspoilt nature."
    ],
    "it": [
      "Guida alpina, specialista in escursioni a piedi e con le racchette da neve. Per aiutarvi a staccare la spina! RandArc è un esperto del massiccio della Lauzière e del villaggio di Montsapey, che vi guiderà nel cuore della natura incontaminata."
    ],
    "fr": [
      "Accompagnateur en montagne, spécialiste des randonnées pédestres et en raquettes à neige. À votre service pour toutes vos envies d’évasion ! Expert du massif de la Lauzière et du village de Montsapey, RandArc vous guide au cœur d’une nature préservée."
    ],
    "es": [
      "Guía de montaña, especialista en senderismo y raquetas de nieve. Le ayudamos a evadirse RandArc es un experto en el macizo de Lauzière y el pueblo de Montsapey, que le guiará en el corazón de la naturaleza virgen."
    ],
    "nl": [
      "Berggids, specialist in wandelen en sneeuwschoenwandelen. Hier om u te helpen er even helemaal uit te zijn! RandArc is een expert op het gebied van het Lauzière massief en het dorp Montsapey, en begeleidt je naar het hart van de ongerepte natuur."
    ]
  },
  "rdfs:label": {
    "fr": [
      "RandArc - Accompagnateur en montagne"
    ]
  },
