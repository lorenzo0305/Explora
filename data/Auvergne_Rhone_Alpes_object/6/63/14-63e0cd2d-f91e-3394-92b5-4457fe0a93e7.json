  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/c32cfbca-1206-3b80-a949-b1678cd190ce",
      "dc:description": {
        "de": [
          "Informationen :\n\nProdukte: Brot und Pizza\n\nTage der Öffnung :\nFür Brot:\nTäglich von 7:00 bis 12:00 Uhr\n\nFür Pizzas zum Mitnehmen:\nFreitags zwischen 18:30 und 20:30 Uhr\nEs ist unbedingt erforderlich, dass Sie freitags vor 11 Uhr unter der Nummer 06 63 93 96 07 bestellen\n\nAbholung:\nZum Mitnehmen während der Öffnungszeiten\n\n "
        ],
        "en": [
          "Information :\n\nProducts: bread and pizza\n\nOpening days :\nFor bread:\nEvery day from 7am to 12pm\n\nFor takeaway pizzas:\nFridays between 6:30pm and 8:30pm\nIt is imperative to order by calling 06 63 93 96 07 on Fridays before 11am\n\nPick-up :\nTakeaway during opening hours\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nProdotti: pane e pizza\n\nGiorni di apertura :\nPer il pane:\nTutti i giorni dalle 7 alle 12\n\nPer le pizze da asporto:\nIl venerdì tra le 18.30 e le 20.30\nLe ordinazioni devono essere effettuate telefonando al numero 06 63 93 96 07 il venerdì prima delle 11.00\n\nRitiro :\nDa asporto durante gli orari di apertura\n\n "
        ],
        "fr": [
          "Informations :\n\nProduits: pains et pizza\n\nJours d'ouverture : \nPour le pain:\nTous les jours de 7h à 12h \n\nPour les pizzas à emporter:\nLe vendredi entre 18h30 et 20h30\nIl est impératif de commander en appelant au 06 63 93 96 07 le vendredi avant 11h\n\nRetrait :\nÀ emporter aux horaires d'ouverture\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nProducten: brood en pizza\n\nOpeningsdagen :\nVoor brood:\nElke dag van 7u tot 12u\n\nVoor afhaalpizza's:\nVrijdag tussen 18.30 en 20.30 uur\nBestellingen moeten worden doorgegeven door te bellen naar 06 63 93 96 07 op vrijdag voor 11 uur\n\nAfhalen :\nAfhalen tijdens openingstijden\n\n "
        ],
        "es": [
          "Más información :\n\nProductos: pan y pizza\n\nDías de apertura :\nPara el pan:\nTodos los días de 7h a 12h\n\nPizzas para llevar:\nViernes de 18h30 a 20h30\nLos pedidos deben hacerse llamando al 06 63 93 96 07 los viernes antes de las 11h\n\nRecogida :\nPara llevar durante el horario de apertura\n\n "
        ]
      },
