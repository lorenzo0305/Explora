  "rdfs:comment": {
    "de": [
      "Tauchen Sie mit diesem lebendigen Fest, das Kunsthandwerk und historische Gastronomie miteinander verbindet, in die antike gallische Kultur ein. Besuchen Sie ein lebhaftes gallisches Lager, nehmen Sie an einem typischen Bankett teil und lernen Sie die Tradition von Beltane am Feuer kennen. Mahlzeiten auf Vorbestellung."
    ],
    "en": [
      "Immerse yourself in ancient Gaulish culture with this lively celebration of historic crafts and gastronomy. Visit a lively Gallic camp, take part in a typical banquet, and discover the tradition of Beltane around the fire. Meals on reservation."
    ],
    "it": [
      "Immergetevi nell'antica cultura gallica con questo vivace festival che unisce artigianato e gastronomia storica. Visitate un vivace accampamento gallico, partecipate a un banchetto tipico e scoprite la tradizione di Beltane intorno al fuoco. Pasti su prenotazione."
    ],
    "fr": [
      "Plongez dans la culture antique gauloise avec cette fête vivante mêlant artisanat et gastronomie historique. Visitez un camp gaulois animé, participez à un banquet typique, et découvrez la tradition de Beltane autour du feu. Repas sur réservation."
    ],
    "es": [
      "Sumérjase en la antigua cultura gala con esta animada fiesta que combina artesanía y gastronomía histórica. Visite un animado campamento galo, participe en un banquete típico y descubra la tradición de Beltane alrededor del fuego. Comidas previa reserva."
    ],
    "nl": [
      "Dompel jezelf onder in de oude Gallische cultuur met dit levendige festival dat ambachten en historische gastronomie combineert. Bezoek een levendig Gallisch kamp, neem deel aan een typisch banket en ontdek de traditie van Beltane rond het vuur. Maaltijden op reservering."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Fête Gauloise de Beltane"
    ]
  },
