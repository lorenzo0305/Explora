  "rdfs:comment": {
    "de": [
      "Ideal gelegen im Osten von Lyon, zwischen dem Flughafen, dem Ausstellungszentrum Eurexpo, dem Parc OL und der LDLC Arena, bietet das Hotel Mercure Lyon Genas Eurexpo alle Vorteile für geschäftliche und private Veranstaltungen."
    ],
    "en": [
      "Ideally located in the East of Lyon, between the airport, the Eurexpo Exhibition Centre, the OL stadium and the LDLC Arena, the Mercure Lyon Genas Eurexpo Hotel has all the facilities necessary to cater for business and private events."
    ],
    "it": [
      "Situato in posizione ideale a est di Lione, tra l'aeroporto, il centro espositivo Eurexpo, il Parc OL e l'Arena LDLC, l'Hôtel Mercure Lyon Genas Eurexpo ha tutto ciò che serve per eventi aziendali e privati."
    ],
    "fr": [
      "Idéalement situé dans l'Est de Lyon, entre l'aéroport, le centre d'expositions Eurexpo, le Parc OL et la LDLC Arena, l'Hôtel Mercure Lyon Genas Eurexpo dispose de tous les atouts pour les événements professionnels et privés."
    ],
    "es": [
      "Idealmente situado al este de Lyon, entre el aeropuerto, el centro de exposiciones Eurexpo, el Parc OL y el LDLC Arena, el Hôtel Mercure Lyon Genas Eurexpo tiene todo lo que necesita para eventos de negocios y privados."
    ],
    "nl": [
      "Hôtel Mercure Lyon Genas Eurexpo is ideaal gelegen in het oosten van Lyon, tussen de luchthaven, het expositiecentrum Eurexpo, het Parc OL en de LDLC Arena, en biedt alles wat u nodig hebt voor zakelijke en privé-evenementen."
    ]
  },
