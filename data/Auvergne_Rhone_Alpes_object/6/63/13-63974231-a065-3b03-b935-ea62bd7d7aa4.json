  "rdfs:comment": {
    "de": [
      "Bar und Brasserie mit einer schattigen Terrasse, die unsere Kunden in einer warmen und freundlichen Atmosphäre im Herzen der mittelalterlichen Stadt empfängt.\r\nUnser dynamisches und freundliches Team wird Sie mit lokalen und regionalen Köstlichkeiten verwöhnen."
    ],
    "en": [
      "Bar and brasserie with a shaded terrace welcoming you in a warm and friendly atmosphere in the medieval city center. Our dynamic and smiling team will be delighted to let you discover the local and regional flavors."
    ],
    "it": [
      "Bar e brasserie con terrazza ombreggiata che accoglie i clienti in un'atmosfera calda e accogliente nel cuore della città medievale.\r\nIl nostro team dinamico e sorridente vi farà scoprire i sapori locali e regionali."
    ],
    "fr": [
      "Bar et brasserie avec un terrasse ombragée accueillant dans une ambiance chaleureuse et conviviale notre clientèle en plein cœur de la cité médiévale.\r\nNotre équipe dynamique et souriante, saura vous faire découvrir les saveurs locales et régionales."
    ],
    "nl": [
      "Een bar en brasserie met een schaduwrijk terras die een warm en vriendelijk onthaal biedt aan onze klanten in het hart van de middeleeuwse stad.\r\nOns dynamische en goedlachse team helpt je de lokale en regionale smaken te ontdekken."
    ],
    "es": [
      "Bar y brasserie con terraza a la sombra que acoge a nuestros clientes en un ambiente cálido y acogedor en el corazón de la ciudad medieval.\r\nNuestro dinámico y sonriente equipo le hará descubrir los sabores locales y regionales."
    ]
  },
  "rdfs:label": {
    "en": [
      "Brasserie Le Donjon"
    ],
    "fr": [
      "Brasserie Le Donjon"
    ]
  },
