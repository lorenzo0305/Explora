  "rdfs:comment": {
    "de": [
      "Die Kirche St. Georg stammt aus dem 12. bis 15. Jahrhundert und besitzt einen Glockenturm mit einer Mauer mit vier Buchten. Dieser wurde im 15. Jahrhundert umgebaut, das Innere ist gotisch."
    ],
    "en": [
      "Dedicated to St. Georges, part of the interior of the church (12th-15th c.) is Gothic, whereas the main part is Romanesque, with a 19th c. bell cote replacing the original one."
    ],
    "it": [
      "Risalente al XII-XV secolo, la chiesa di Saint-Georges ha un campanile a quattro campate. La chiesa è stata ristrutturata nel XV secolo e l'interno è in stile gotico."
    ],
    "fr": [
      "Datée du 12ème-15ème siècles, l'église saint-Georges est dotée d'un clocher-mur à quatre baies. Celle-ci a été remaniée au 15ème, l'intérieur est gothique."
    ],
    "es": [
      "La iglesia de Saint-Georges data de los siglos XII-XV y tiene un campanario de cuatro cuerpos. La iglesia fue remodelada en el siglo XV, y el interior es gótico."
    ],
    "nl": [
      "De kerk Saint-Georges dateert uit de 12e-15e eeuw en heeft een klokkentoren met vier traveeën. De kerk werd in de 15e eeuw verbouwd en het interieur is gotisch."
    ]
  },
  "rdfs:label": {
    "en": [
      "Saint-Georges church"
    ],
    "fr": [
      "Eglise saint-Georges"
    ]
  },
