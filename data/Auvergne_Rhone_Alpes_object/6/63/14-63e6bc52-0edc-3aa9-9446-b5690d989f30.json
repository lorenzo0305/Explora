      "openingDetails": {
        "de": [
          "Schulferien: Mo > Fr 10h-13h/14h-20h. Sa 10h15-13h/14h-18h. So 10h15-13h.\nSchulzeit: Mo und Do 12h-14h/17h-20h. Di und Fr 12h-14h/17h-21h. Mi 12h-20h. Sam 10h15-13h/14h-18h. So 10h15-13h.\nAn Feiertagen geschlossen außer am 14.07. und 15.08. (10-13 Uhr / 14-17 Uhr)."
        ],
        "en": [
          "School vacations: Mon > Fri 10h-13h/14h-20h. Sat 10h15-13h/14h-18h. Sun 10h15-13h.\nSchool holidays: Mon and Thu 12pm-2pm/17pm-8pm. Tue and Fri 12h-14h/17h-21h. Wed 12h-20h. Sat 10h15-13h/14h-18h. Sun 10h15-13h.\nClosed on public holidays except 14/07 and 15/08 (10h-13h / 14h-17h)."
        ],
        "it": [
          "Vacanze scolastiche: lun > ven 10h-13h/14h-20h. Sab 10h15-13h/14h-18h. Domenica 10.15-13.00.\nVacanze scolastiche: lun e gio 12.00-14.00/15.00-20.00. Mar e ven 12.00-14.00/5.00-21.00. Mer 12.00-20.00. Sab 10h15-13h/14h-18h. Domenica 10h15-13h.\nChiuso nei giorni festivi tranne il 14/07 e il 15/08 (10-13 / 14-17)."
        ],
        "fr": [
          "Vacances scolaires : lun > ven 10h-13h/14h-20h. Sam 10h15-13h/14h-18h. Dim 10h15-13h. \nPériode scolaire : lun et jeu 12h-14h/17h-20h. Mar et ven 12h-14h/17h-21h. Mer 12h-20h. Sam 10h15-13h/14h-18h. Dim 10h15-13h. \nFermé les jours fériés sauf le 14/07 et le 15/08 (10h-13h / 14h-17h)."
