  "rdfs:comment": {
    "de": [
      "Les Sorbiers empfängt Sie in einem alten, typisch auvergnatischen Schuppen, der unter Beibehaltung der lokalen Architektur vollständig renoviert wurde."
    ],
    "en": [
      "House with a typical architecture recently restored. Traditional furniture and decoration. Traditional and regional cooking."
    ],
    "it": [
      "Les Sorbiers vi accoglie in una tipica carrozza d'epoca dell'Alvernia, interamente ristrutturata nel rispetto dell'architettura locale."
    ],
    "fr": [
      "Les Sorbiers vous accueillent dans une ancienne remise typiquement auvergnate, entièrement rénovée conservant l'architecture locale."
    ],
    "nl": [
      "Les Sorbiers ontvangt u in een typisch oud Auvergne koetshuis, geheel gerenoveerd met behoud van de plaatselijke architectuur."
    ],
    "es": [
      "Les Sorbiers le da la bienvenida en una antigua cochera típica de Auvernia, totalmente renovada conservando la arquitectura local."
    ]
  },
