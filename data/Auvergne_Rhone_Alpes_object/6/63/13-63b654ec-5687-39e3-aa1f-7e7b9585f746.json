  "rdfs:comment": {
    "de": [
      "Kommen Sie und genießen Sie eine Speisekarte, die sich den Jahreszeiten anpasst, in einer warmen und freundlichen Atmosphäre.\r\nEinfache und qualitativ hochwertige Küche, die mit frischen und lokalen Produkten zubereitet wird."
    ],
    "en": [
      "Come and enjoy a menu that adapts to the seasons, in a warm and friendly atmosphere.\r\nSimple, high-quality cuisine prepared with fresh, local produce."
    ],
    "it": [
      "Venite a gustare un menu che si adatta alle stagioni, in un'atmosfera calda e accogliente.\r\nUna cucina semplice e di qualità, preparata con prodotti freschi e locali."
    ],
    "fr": [
      "Venez profitez d'une carte qui s'adapte aux saisons, dans une ambiance chaleureuse et conviviale.\r\nCuisine simple et de qualité, préparée avec des produits frais et locaux."
    ],
    "es": [
      "Venga a disfrutar de un menú que se adapta a las estaciones, en un ambiente cálido y acogedor.\r\nCocina sencilla y de calidad elaborada con productos frescos y locales."
    ],
    "nl": [
      "Kom genieten van een menu dat zich aanpast aan de seizoenen, in een warme en vriendelijke sfeer.\r\nEenvoudige gerechten van hoge kwaliteit, bereid met verse, lokale producten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant-snack : So'leil"
    ]
  },
