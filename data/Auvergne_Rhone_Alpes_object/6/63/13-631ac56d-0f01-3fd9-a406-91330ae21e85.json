  "rdfs:comment": {
    "de": [
      "Entdecken Sie in Begleitung eines staatlich geprüften Lehrers die Freuden des Gleitschirmfliegens. Bewundern Sie die Berge, fliegen Sie wie Ikarus und lernen Sie die Grundlagen des Fliegens kennen. Sie können auch Fotos von Ihrem Flug mit nach Hause nehmen."
    ],
    "en": [
      "Accompanied by a state-qualified instructor, discover the pleasures of paragliding. Admire the mountains, soar like Icarus and learn the rudiments of piloting. You can also take home photos of your flight."
    ],
    "it": [
      "Accompagnati da un istruttore qualificato, scoprite i piaceri del parapendio. Ammirate le montagne, volate come Icaro e imparate i rudimenti del pilotaggio. Potrete anche portare a casa le foto del vostro volo."
    ],
    "fr": [
      "Accompagné d'un moniteur diplômé d'état, découvrez les plaisirs du vol en parapente. Admirez les montagnes, envolez-vous tel Icare et découvrez les rudiments du pilotage. Vous pouvez également repartir avec les photos de votre vol."
    ],
    "nl": [
      "Ontdek onder begeleiding van een gekwalificeerde instructeur het plezier van paragliding. Bewonder de bergen, zweef als Icarus en leer de beginselen van het vliegen. Je kunt ook foto's van je vlucht mee naar huis nemen."
    ],
    "es": [
      "Acompañado por un instructor cualificado, descubra los placeres del parapente. Admire las montañas, vuele como Ícaro y aprenda los rudimentos del pilotaje. También podrá llevarse a casa fotos de su vuelo."
    ]
  },
  "rdfs:label": {
