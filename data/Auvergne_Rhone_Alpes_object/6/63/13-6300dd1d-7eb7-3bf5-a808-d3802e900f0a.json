  "rdfs:comment": {
    "de": [
      "Freie Besichtigung mit Dokument. Die Kirche besitzt ein achteckiges Taufbecken (MH), das mit polychromen Wappen aus dem 15. Jahrhundert verziert ist, die die Initialen des Ave Maria tragen."
    ],
    "en": [
      "Free visit with document. The church has an octagonal baptismal font (MH) decorated with 15th century polychrome coats of arms bearing the initials of the Hail Mary."
    ],
    "it": [
      "Visita autoguidata con documentazione. La chiesa conserva un fonte battesimale ottagonale (MH) decorato con stemmi policromi del XV secolo con le iniziali dell'Ave Maria."
    ],
    "fr": [
      "Visite libre avec document. L'église possède des fonts baptismaux octogonaux (MH) décorés de blasons polychromes du XVe siècle portant les initiales de l'Ave Maria."
    ],
    "nl": [
      "Zelf rondleiding met documentatie. De kerk heeft een achthoekige doopvont (MH) versierd met polychrome wapenschilden uit de 15e eeuw met de initialen van het Ave Maria."
    ],
    "es": [
      "Visita autoguiada con documentación. La iglesia cuenta con una pila bautismal octogonal (MH) decorada con escudos policromados del siglo XV con las iniciales del Ave María."
    ]
  },
