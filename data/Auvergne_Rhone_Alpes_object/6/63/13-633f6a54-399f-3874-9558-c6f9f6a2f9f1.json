  "rdfs:comment": {
    "de": [
      "Cham' Taxi ist stolz darauf, Ihnen sein erfahrenes Know-how für Ihre Fahrten im Chamonix-Tal und seiner Umgebung zur Verfügung zu stellen, von lokalen bis hin zu internationalen Fahrten."
    ],
    "en": [
      "Cham' Taxi will be proud to put in your service its know-how experienced for your trips in the Chamonix valley and its environs, from local to international."
    ],
    "it": [
      "Cham' Taxi sarà orgoglioso di mettere il suo know-how esperto al vostro servizio per tutte le vostre esigenze di viaggio nella valle di Chamonix e dintorni, da quelle locali a quelle internazionali."
    ],
    "fr": [
      "Cham' Taxi sera fière de mettre à votre service son savoir-faire expérimenté pour vos déplacements dans la vallée de Chamonix et ses environs, du local à l'international."
    ],
    "nl": [
      "Cham' Taxi stelt met trots zijn ervaren knowhow tot uw dienst voor al uw reisbehoeften in de vallei van Chamonix en omgeving, van lokaal tot internationaal."
    ],
    "es": [
      "Cham' Taxi se enorgullece de poner su experiencia a su servicio para todas sus necesidades de viaje en el valle de Chamonix y sus alrededores, desde el ámbito local al internacional."
    ]
  },
