  "rdfs:comment": {
    "de": [
      "Durchführung von Natur- und Kreativ-Workshops, um zu mehr Autonomie zu gelangen (wilde Küche, Naturkosmetik, wildes Kunsthandwerk...) und sich vergessene Kenntnisse wieder anzueignen."
    ],
    "en": [
      "We lead nature and creative workshops to encourage self-sustainability (wild cooking, natural beauty products, wild art and crafts) and re-discover and use forgotten skills"
    ],
    "it": [
      "Laboratori naturalistici e creativi per diventare più autosufficienti (cucina selvatica, cosmesi naturale, artigianato selvatico, ecc.) e recuperare abilità dimenticate."
    ],
    "fr": [
      "Animation d'ateliers natures et créatifs pour aller vers plus d'autonomie (cuisine sauvage, cosmétiques naturels, artisanat sauvage...) et se réapproprier des savoirs oubliés."
    ],
    "nl": [
      "Natuur- en creatieve workshops om je te helpen meer zelfvoorzienend te worden (wild koken, natuurlijke cosmetica, wild knutselen, etc.) en vergeten vaardigheden terug te winnen."
    ],
    "es": [
      "Naturaleza y talleres creativos para ayudarle a ser más autosuficiente (cocina salvaje, cosmética natural, artesanía salvaje, etc.) y recuperar habilidades olvidadas."
    ]
  },
  "rdfs:label": {
