  "rdfs:comment": {
    "de": [
      "Ein bemerkenswerter Cupula-Stein mit vielen Inschriften. Von der Ebene aus hat man einen schönen Blick auf das Tal und die Kapelle Saint-Jacques."
    ],
    "en": [
      "A remarkable cupstone rich in inscriptions. The view of the valley and the Saint-Jacques chapel from the plateau is stunning."
    ],
    "it": [
      "Una notevole coppella ricca di iscrizioni. Dall'altopiano, una vista molto bella sulla valle e sulla cappella di Saint-Jacques."
    ],
    "fr": [
      "Une pierre à cupules remarquable et riche en inscriptions. Depuis le replat très joli panorama sur la vallée et la chapelle Saint-Jacques."
    ],
    "es": [
      "Una notable piedra cupular rica en inscripciones. Desde la meseta, una vista muy bonita del valle y de la capilla Saint-Jacques."
    ],
    "nl": [
      "Een opmerkelijke kopsteen rijk aan inscripties. Vanaf het plateau een heel mooi uitzicht op de vallei en de kapel Saint-Jacques."
    ]
  },
  "rdfs:label": {
    "en": [
      "St Marcel's cupule stone"
    ],
    "fr": [
      "Pierre à cupules de Saint Marcel"
    ]
  },
