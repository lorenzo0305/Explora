  "rdfs:comment": {
    "de": [
      "Mit einer Kapazität von 250 Personen ist dieser Saal ein kultureller Veranstaltungsort für sich. Es bietet ein qualitativ hochwertiges Programm, offen für die Vielfalt von Live-Auftritten sowie Vorschläge für ein junges Publikum."
    ],
    "en": [
      "With a capacity of 250 people, this hall is a cultural venue in its own right. It offers quality programming, open to the diversity of live performance as well as proposals dedicated to young audiences."
    ],
    "it": [
      "Con una capacità di 250 persone, questa sala è un luogo culturale a sé stante. Propone una programmazione di qualità, aperta alla diversità dello spettacolo dal vivo e proposte dedicate al giovane pubblico."
    ],
    "fr": [
      "D'une capacité de 250 personnes, La Faïencerie propose une programmation de qualité, ouverte à la diversité du spectacle vivant (théâtre, musique, humour...) ainsi que des propositions dédiées au jeune public."
    ],
    "nl": [
      "Met een capaciteit van 250 personen biedt La Faïencerie een kwaliteitsprogramma dat openstaat voor de diversiteit van podiumkunsten (theater, muziek, komedie, enz.) en evenementen voor een jong publiek."
    ],
    "es": [
      "Con una capacidad de 250 personas, esta sala es un lugar cultural por derecho propio. Propone una programación de calidad, abierta a la diversidad del espectáculo vivo, así como propuestas dedicadas al público joven."
    ]
  },
