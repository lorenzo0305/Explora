  "rdfs:comment": {
    "de": [
      "Das Cordo ehrt die elektronische Musik und die Liebhaber von Drumcomputern und Synthesizern an einem Abend, der der Live-Musik gewidmet ist. Melden Sie sich online an, um an der JAM teilzunehmen!"
    ],
    "en": [
      "La Cordo celebrates electronic music, drum machines and synthesizers for an evening dedicated to live music creation. Register online to take part in the JAM!"
    ],
    "it": [
      "La Cordo celebra la musica elettronica, le drum machine e i sintetizzatori con una serata di creazione musicale dal vivo. Registratevi online per partecipare alla JAM!"
    ],
    "fr": [
      "La Cordo met à l’honneur les musiques électroniques, les passionné·e·s de boîtes à rythmes et de synthétiseurs le temps d’une soirée dédiée à la création musicale live. Inscription en ligne pour participer à la JAM!"
    ],
    "nl": [
      "La Cordo viert elektronische muziek, drummachines en synthesizers met een avond vol live muziekcreatie. Registreer je online om deel te nemen aan de JAM!"
    ],
    "es": [
      "La Cordo celebra la música electrónica, las cajas de ritmos y los sintetizadores con una velada de creación musical en directo. ¡Inscríbete en línea para participar en la JAM!"
    ]
  },
  "rdfs:label": {
