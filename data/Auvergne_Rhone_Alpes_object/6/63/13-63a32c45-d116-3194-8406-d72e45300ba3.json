  "rdfs:comment": {
    "de": [
      "Bar im Chalet Mounier \"Le Tolkien\"\r\nMusikalische Abende in den Salons, im Winter jeden Donnerstagabend\r\nTerrasse am Pool im Sommer\r\nCocktails, Rum-, Whisky- und Weinverkostungen"
    ],
    "en": [
      "Bar of the Chalet Mounier \"Le Tolkien\", musical evenings in the lounges, cocktails, rum, whisky and wine tasting.\r\nPoolside terrace in summer\r\nCocktails, rum, whisky and wine tastings"
    ],
    "it": [
      "Bar dello Chalet Mounier \"Le Tolkien\", serate musicali nei saloni , cocktail, degustazione di rum, whisky e vino.\r\nTerrazza a bordo piscina in estate\r\nDegustazioni di cocktail, rum, whisky e vino"
    ],
    "fr": [
      "Bar du Chalet Mounier \"Le Tolkien\"\r\nSoirées musicales dans les salons, tous les jeudis soirs de l'hiver\r\nTerrasse au bord de la piscine l'été\r\nCocktails, dégustations de rhum, de whiskies et de vins"
    ],
    "nl": [
      "Bar in Chalet Mounier \"Le Tolkien\r\nMuzikale avonden in de lounges elke donderdagavond in de winter\r\nTerras bij het zwembad in de zomer\r\nCocktails, rum, whisky en wijnproeverijen"
    ],
    "es": [
      "Bar del Chalet Mounier \"Le Tolkien\r\nVeladas musicales en los salones todos los jueves por la noche en invierno\r\nTerraza junto a la piscina en verano\r\nCócteles, degustaciones de ron, whisky y vino"
    ]
