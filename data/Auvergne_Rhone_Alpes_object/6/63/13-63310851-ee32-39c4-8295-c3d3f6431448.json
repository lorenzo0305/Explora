  "rdfs:comment": {
    "de": [
      "In einem modernen Rahmen mit Blick auf den See ist das Cocon der ideale Ort sowohl für Ihre Geschäftsessen unter der Woche als auch für Ihre Familientreffen am Wochenende."
    ],
    "en": [
      "A restaurant located in a modern setting with a view across the lake, the Cocon is the perfect place for your business meals in the week or family get-togethers at the weekend."
    ],
    "it": [
      "In uno sfondo moderno con vista sul lago, il Cocon è il posto perfetto sia per i tuoi pranzi di lavoro durante la settimana che per le tue riunioni di famiglia nel week end."
    ],
    "fr": [
      "Dans un cadre moderne avec vue sur le lac, le Cocon est le lieu parfait aussi bien pour vos repas d'affaires en semaine que pour vos réunions de famille le week-end."
    ],
    "es": [
      "Le Cocon, situado en un entorno moderno con vistas al lago, es el lugar perfecto para celebrar comidas de negocios durante la semana o reuniones de familia los fines de semana."
    ],
    "nl": [
      "In een moderne omgeving met uitzicht op het meer is de Cocon de perfecte plek voor uw zakelijke maaltijden door de week en voor uw familiereünies in het weekend."
    ]
  },
