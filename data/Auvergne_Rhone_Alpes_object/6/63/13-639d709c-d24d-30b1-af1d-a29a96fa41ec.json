  "rdfs:comment": {
    "de": [
      "Es ist die Veranstaltung, die Thonon-les-Bains vier Tage lang in eine echte Freilichtbühne verwandelt, einen Ort der Begegnung und der Emotionen zwischen Künstlern und Festivalbesuchern."
    ],
    "en": [
      "It's the event that transforms Thonon-les-Bains into a veritable open-air stage, a 4-day meeting place for artists and festival-goers alike."
    ],
    "it": [
      "È l'evento che trasforma Thonon-les-Bains in un vero e proprio palcoscenico a cielo aperto, un luogo dove artisti e spettatori del festival possono incontrarsi e condividere emozioni per 4 giorni."
    ],
    "fr": [
      "C'est la manifestation qui transforme Thonon-les-Bains en une véritable scène à ciel ouvert, un espace de rencontres et d'émotions entre artistes et festivaliers durant 4 jours."
    ],
    "nl": [
      "Het is het evenement dat Thonon-les-Bains omtovert tot een echt openluchtpodium, een plek waar artiesten en festivalgangers elkaar kunnen ontmoeten en emoties kunnen delen gedurende 4 dagen."
    ],
    "es": [
      "Es el acontecimiento que transforma Thonon-les-Bains en un auténtico escenario al aire libre, un lugar donde artistas y festivaleros pueden encontrarse y compartir emociones durante 4 días."
    ]
  },
