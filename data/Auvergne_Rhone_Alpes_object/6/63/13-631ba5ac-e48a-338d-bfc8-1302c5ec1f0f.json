  "rdfs:comment": {
    "de": [
      "Geselliger und gemütlicher Ort, an dem Sie traditionelle Küche im komplett renovierten Saal oder an schönen Tagen auf der Terrasse genießen können.\r\nSaisonale Speisekarte."
    ],
    "en": [
      "A warm and friendly place where you can enjoy traditional cuisine in the renovated dining room or on the terrace in fine weather.\r\nSeasonal menu."
    ],
    "it": [
      "Un luogo caldo e accogliente dove gustare la cucina tradizionale in una sala da pranzo completamente rinnovata o sulla terrazza quando il tempo lo consente.\r\nMenu stagionale."
    ],
    "fr": [
      "Lieu convivial et chaleureux où vous pourrez déguster une cuisine traditionnelle en salle entièrement rénovée ou en terrasse quand vient les beaux jours.\r\nCarte saisonnière."
    ],
    "es": [
      "Un lugar cálido y acogedor donde disfrutar de la cocina tradicional en un comedor totalmente renovado o en la terraza cuando hace buen tiempo.\r\nMenú de temporada."
    ],
    "nl": [
      "Een warme en vriendelijke plek waar u kunt genieten van traditionele gerechten in een volledig gerenoveerde eetzaal of op het terras bij mooi weer.\r\nSeizoensmenu."
    ]
  },
