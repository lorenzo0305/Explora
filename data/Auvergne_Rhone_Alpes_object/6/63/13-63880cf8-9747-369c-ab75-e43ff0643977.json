  "rdfs:comment": {
    "de": [
      "Kommen Sie in einem modernen Rahmen gegenüber der Monts du Lyonnais eine saisonale Küche, die Lyoner Tradition mit der Kreativität des Küchenchefs vereint, entdecken."
    ],
    "en": [
      "Located opposite the Monts du Lyonnais, in a contemporary setting, come along and tuck into the establishment's delicious seasonal cuisine, combining Lyonnais tradition with the added creative touch of the Chef."
    ],
    "it": [
      "Di fronte ai Monts du Lyonnais, in una cornice contemporanea, vieni a degustare una cucina di stagione che unisce la tradizione lionese alla creatività dello Chef."
    ],
    "fr": [
      "Face aux Monts du Lyonnais, dans un cadre contemporain, venez déguster une cuisine de saison, alliant la tradition lyonnaise à la créativité du Chef."
    ],
    "nl": [
      "Met uitzicht op de Monts du Lyonnais en in een eigentijds kader kunt u genieten van een seizoensgebonden keuken die de traditie van Lyon combineert met de creativiteit van de chef."
    ],
    "es": [
      "Frente a los Monts du Lyonnais, en una atmósfera contemporánea, proponemos una cocina de temporada, que alía la tradición lionesa y la creatividad de nuestro chef."
    ]
  },
