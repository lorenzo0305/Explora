  "rdfs:comment": {
    "de": [
      "Eine Strecke, auf der Sie die Weinberge im Süden des Revermont und die großen Wälder von Vieudrin und Bohas im Herzen des Suran-Tals entdecken können. Passagen durch die Weinberge und Entdeckung typischer Dörfer: Revonnas, Journans, Gravelles, Rignat."
    ],
    "en": [
      "A route to discover the vineyards of the southern Revermont and the large forests of Vieudrin and Bohas in the heart of the Suran valley. Passages through vineyards and typical villages: Revonnas, Journans, Gravelles, Rignat."
    ],
    "it": [
      "Questo itinerario si snoda tra i vigneti del Revermont meridionale e le grandi foreste di Vieudrin e Bohas, nel cuore della valle del Suran. Passaggi attraverso i vigneti e i villaggi tipici: Revonnas, Journans, Gravelles, Rignat."
    ],
    "fr": [
      "Un parcours pour découvrir le vignoble du sud du Revermont et les grandes forêts du Vieudrin et de Bohas au cœur de la vallée du Suran. Des passages dans les vignes et des découvertes de villages typiques : Revonnas, Journans, Gravelles, Rignat."
    ],
    "es": [
      "Esta ruta recorre los viñedos del sur de Revermont y los grandes bosques de Vieudrin y Bohas, en el corazón del valle del Suran. Pasajes por los viñedos y pueblos típicos: Revonnas, Journans, Gravelles, Rignat."
    ],
    "nl": [
      "Deze route voert langs de wijngaarden van het zuidelijke Revermont en de grote bossen van Vieudrin en Bohas in het hart van de Suran-vallei. Passages door de wijngaarden en typische dorpjes: Revonnas, Journans, Gravelles, Rignat."
    ]
  },
  "rdfs:label": {
    "en": [
      "VTTAE circuit n°23 (red) Between vineyards and the Suran gorges"
    ],
    "fr": [
      "Circuit VTTAE n°23 (rouge) Entre vignoble et gorges du Suran"
    ]
  },
