  "rdfs:comment": {
    "de": [
      "Das Manoir de Bellecombe ist ein ehemaliges Schloss aus dem 17. Jahrhundert inmitten eines 2500m² großen Parks mit Bäumen. Es liegt in Bellecombe, am Fuße des Morel-Wasserfalls. Alle unsere Gerichte sind hausgemacht und stammen aus den besten Produkten Savoyens."
    ],
    "en": [
      "Le Manoir de Bellecombe is a 17th-century château set in 2500m² of wooded parkland, located in Bellecombe at the foot of the Morel waterfall. All our dishes are home-made, using the finest Savoy produce."
    ],
    "it": [
      "Il Manoir de Bellecombe è un antico castello del XVII secolo immerso in 2500 m² di parco alberato a Bellecombe, ai piedi della cascata Morel. Tutti i nostri piatti sono fatti in casa, utilizzando solo i migliori prodotti della Savoia."
    ],
    "fr": [
      "Le Manoir de Bellecombe est un ancien château du XVII siècle au coeur d’un parc arboré de 2500m², situé à Bellecombe, au pied de la cascade du Morel. Tous nos plats sont faits maison et issus des meilleurs produits de Savoie."
    ],
    "nl": [
      "Het Manoir de Bellecombe is een voormalig kasteel uit de 17e eeuw, gelegen in een bebost park van 2500 m² in Bellecombe, aan de voet van de waterval van Morel. Al onze gerechten zijn huisgemaakt, met alleen de beste producten uit de Savoie."
    ],
    "es": [
      "El Manoir de Bellecombe es un antiguo castillo del siglo XVII situado en un parque arbolado de 2500 m² en Bellecombe, al pie de la cascada de Morel. Todos nuestros platos son caseros, elaborados con los mejores productos de Saboya."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Manoir de Bellecombe - Restaurant"
    ]
  },
