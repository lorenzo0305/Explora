  "rdfs:comment": {
    "de": [
      "Dieser alpine Erholungsort mit urbanem Flair bietet ausgefallene Getränke, veranstaltet wilde Events und bietet eine freundliche, unprätentiöse und unterhaltsame Atmosphäre."
    ],
    "en": [
      "A relaxed alpine hangout with an urban edge, we serve bold drinks, host fierce events, and keep the vibe friendly, unpretentious, and fun."
    ],
    "it": [
      "Questo rifugio alpino dall'atmosfera urbana offre drink originali, eventi vivaci e un'atmosfera amichevole, senza pretese e divertente."
    ],
    "fr": [
      "Ce lieu de détente alpin à l'ambiance urbaine propose des boissons originales, organise des événements endiablés et offre une atmosphère conviviale, sans prétention et divertissante."
    ],
    "es": [
      "Este refugio alpino con aire urbano ofrece bebidas originales, eventos animados y un ambiente agradable, sin pretensiones y divertido."
    ],
    "nl": [
      "Dit alpine toevluchtsoord met een stedelijke uitstraling biedt originele drankjes, levendige evenementen en een vriendelijke, pretentieloze en onderhoudende sfeer."
    ]
  },
