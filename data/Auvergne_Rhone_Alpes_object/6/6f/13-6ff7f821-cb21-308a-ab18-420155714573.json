  "rdfs:comment": {
    "de": [
      "Das Café auf dem Platz. Vor 18 Jahren hat alles in Talloires begonnen, und wir freuen uns, in Megève eine neue kanaille Seite aufzuschlagen. Dieses neue Restaurant ist eine Mischung aus einem gemütlichen Restaurant, einem Bouchon Lyonnais und einem Pariser Bistro."
    ],
    "en": [
      "Le Café de la Place. It all began in Talloires 18 years ago, and we are delighted to be writing a new chapter in Megève. This new restaurant is a cross between a friendly restaurant, a Lyonnais bouchon, and a Parisian bistro."
    ],
    "it": [
      "Il Café de la place. Tutto è iniziato a Talloires 18 anni fa e siamo lieti di scrivere una nuova pagina ribelle a Megève. Questo nuovo ristorante è una via di mezzo tra un ristorante conviviale, un bouchon lionese e un bistrot parigino."
    ],
    "fr": [
      "Le Café de la place. Tout a commencé à Talloires il y a 18 ans et nous sommes ravis d’écrire une nouvelle page canaille à Megève. Ce nouveau restaurant se situe entre un restaurant convivial, un bouchon Lyonnais et un bistrot parisien."
    ],
    "es": [
      "Le Café de la place. Todo empezó en Talloires hace 18 años y estamos encantados de escribir una nueva página en la historia de Megève. Este nuevo restaurante está a medio camino entre un restaurante acogedor, un bouchon lionés y un bistró parisino."
    ],
    "nl": [
      "Café de la place. Het begon allemaal in Talloires 18 jaar geleden en we zijn verheugd om een nieuwe pagina te schrijven in de geschiedenis van Megève. Dit nieuwe restaurant houdt het midden tussen een gezellig restaurant, een Lyonnais bouchon en een Parijse bistro."
    ]
  },
