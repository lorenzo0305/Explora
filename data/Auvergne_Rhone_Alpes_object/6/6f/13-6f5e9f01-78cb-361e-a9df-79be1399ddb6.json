  "rdfs:comment": {
    "de": [
      "Jérôme, Hervé und Sandrine begrüßen Sie auf ihrem Bauernhof, um Ihnen ihre Produkte aus Ziegenmilch vorzustellen. Sie stellen einen Käse namens \"Le Chevrou\" her."
    ],
    "en": [
      "Jérôme, Hervé and Sandrine welcome you to their farm to show you their goat's milk products. They produce a cheese called \"Le Chevrou\"."
    ],
    "it": [
      "Jérôme, Hervé e Sandrine vi accolgono nella fattoria per mostrarvi i loro prodotti a base di latte di capra. Producono un formaggio chiamato \"Le Chevrou\"."
    ],
    "fr": [
      "Jérôme, Hervé et Sandrine vous accueillent à la ferme pour vous faire découvrir leurs produits au lait de chèvres. Ils produisent un fromage appelé \"Le Chevrou\"."
    ],
    "es": [
      "Jérôme, Hervé y Sandrine le dan la bienvenida a la granja para mostrarle sus productos de leche de cabra. Producen un queso llamado \"Le Chevrou\"."
    ],
    "nl": [
      "Jérôme, Hervé en Sandrine heten je welkom op de boerderij om je hun geitenmelkproducten te laten zien. Ze produceren een kaas genaamd \"Le Chevrou\"."
    ]
  },
  "rdfs:label": {
