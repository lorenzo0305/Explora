  "rdfs:comment": {
    "de": [
      "Kunsthandwerk aus Glas :\r\n- Skulpturen, unveröffentlichte Bestiarien, dekorative Objekte, Wandkunst.\r\n- Religiöse Kunst und Bestattungskunst. Kunsttherapie mit Glas\r\n- Vermittlung von Glaskunst: kreative Freizeitgestaltung, EAC, Berufsausbildung..."
    ],
    "en": [
      "Glass arts and crafts :\r\n- Sculptures, original bestiaries, decorative objects, wall art\r\n- Religious and funerary arts. Glass art therapy\r\n- Passing on glassmaking skills: creative leisure activities, EAC, professional training, etc."
    ],
    "it": [
      "Arti e mestieri del vetro:\r\n- Sculture, bestiari originali, oggetti decorativi, arte murale\r\n- Arte religiosa e funeraria. Arte-terapia del vetro\r\n- Trasmissione delle competenze vetrarie: attività creative per il tempo libero, EAC, formazione professionale, ecc"
    ],
    "fr": [
