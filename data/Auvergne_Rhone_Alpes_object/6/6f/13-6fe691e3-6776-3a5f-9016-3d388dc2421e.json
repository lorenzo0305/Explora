  "rdfs:comment": {
    "de": [
      "In einer angenehmen Umgebung, im Herzen des Mandallaz-Berges, dem letzten Glied im Jura, können Sie die Kletterrouten von La Mandallaz entdecken."
    ],
    "en": [
      "In a pleasant setting, in the heart of the Mandallaz mountain, the last Jura mountain range, come and discover the Mandallaz climbing routes."
    ],
    "it": [
      "In un ambiente piacevole, nel cuore della Mandallaz, l'ultima catena montuosa del Giura, venite a scoprire le vie di arrampicata della Mandallaz."
    ],
    "fr": [
      "Dans un cadre agréable, au coeur de la montagne de la Mandallaz, dernier chaînon jurassien, venez découvrir les voies d'escalade de la Mandallaz."
    ],
    "nl": [
      "Kom in een aangename omgeving, in het hart van de Mandallaz, de laatste bergketen van de Jura, de klimroutes van de Mandallaz ontdekken."
    ],
    "es": [
      "En un entorno agradable, en el corazón del monte Mandallaz, la última cordillera del Jura, venga a descubrir las vías de escalada del Mandallaz."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Voies d'escalade de la Mandallaz"
    ]
  },
