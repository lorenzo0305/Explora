  "rdfs:comment": {
    "de": [
      "Entwurf von Dekorationsobjekten, Leuchten, Tischkultur, Möbeln und Wänden. Maßgeschneiderte Projekte, limitierte Auflagen. Zusammenarbeit mit lokalen Handwerkern, Designern und Architekten. Einführungsworkshops für Kinder und Erwachsene."
    ],
    "en": [
      "Design of decorative objects, lighting, tableware, furniture and walls. Custom projects, limited editions. Collaborations with local craftsmen, designers and architects. Initiation workshops for children and adults."
    ],
    "it": [
      "Design di oggetti decorativi, illuminazione, stoviglie, mobili e pareti. Progetti su misura, edizioni limitate. Collaborazione con artigiani, designer e architetti locali. Laboratori introduttivi per bambini e adulti."
    ],
    "fr": [
      "Conception d'objets décoratifs, luminaires, art de la table, mobiliers et parois. Projets sur-mesure, éditions limitées. Collaborations avec artisans locaux, designers, architectes. Ateliers d'initiations enfants et adultes."
    ],
    "nl": [
      "Ontwerp van decoratieve objecten, verlichting, servies, meubels en muren. Projecten op maat, beperkte edities. Samenwerking met lokale ambachtslieden, ontwerpers en architecten. Inleidende workshops voor kinderen en volwassenen."
    ],
    "es": [
      "Diseño de objetos de decoración, iluminación, vajilla, mobiliario y paredes. Proyectos a medida, ediciones limitadas. Colaboración con artesanos, diseñadores y arquitectos locales. Talleres de iniciación para niños y adultos."
    ]
  },
  "rdfs:label": {
