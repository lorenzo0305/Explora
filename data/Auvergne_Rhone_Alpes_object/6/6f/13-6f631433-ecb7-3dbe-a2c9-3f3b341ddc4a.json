  "rdfs:comment": {
    "de": [
      "Der Gemeindeverband fördert die Entwicklung des öffentlichen Lesens, indem er den Bewohnern des Trièves Mediatheken, Relais-Bibliotheken und mobile Bücherräume in 11 Dörfern des Trièves anbietet."
    ],
    "en": [
      "Relais bibliothèque of the Percy multimedia library"
    ],
    "it": [
      "La Comunità dei Comuni promuove lo sviluppo della lettura pubblica offrendo agli abitanti di Trièves mediateche, biblioteche a staffetta e aree di libri nomadi in 11 villaggi di Trièves."
    ],
    "fr": [
      "La Communauté de communes favorise le développement de la lecture publique en proposant aux habitants du Trièves des médiathèques, des bibliothèques-relais et des espaces livres nomades dans 11 villages du Trièves."
    ],
    "es": [
      "La Comunidad de Municipios fomenta el desarrollo de la lectura pública ofreciendo a los habitantes de Trièves mediatecas, bibliotecas de relevo y zonas de libros nómadas en 11 pueblos de Trièves."
    ],
    "nl": [
      "De Gemeenschap van gemeenten stimuleert de ontwikkeling van openbaar lezen door de inwoners van Trièves mediatheken, relaisbibliotheken en nomadische boekenruimtes in 11 Trièvesdorpen aan te bieden."
    ]
  },
  "rdfs:label": {
    "en": [
      "The book cave"
    ],
    "fr": [
      "La caverne du livre"
    ]
  },
