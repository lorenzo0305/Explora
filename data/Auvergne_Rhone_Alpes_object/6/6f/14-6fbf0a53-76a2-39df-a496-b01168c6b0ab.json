  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/47c6a39c-96cc-3bb7-a83c-b9009b42a005",
      "dc:description": {
        "de": [
          "Le Péché Gourmand ist eine ausgezeichnete Adresse außerhalb von Arras: modernes, gemütliches Ambiente, gut zubereitete saisonale Küche, gepflegter Service und eine Atmosphäre, die mittags entspannt und abends raffiniert ist. Perfekt für ein Feinschmecker-Mittagessen oder ein halb-gastronomisches Abendessen."
        ],
        "en": [
          "Le Péché Gourmand is an excellent address on the outskirts of Arras: modern, cosy surroundings, well-prepared seasonal cuisine, meticulous service and an atmosphere that is both relaxed at lunchtime and refined in the evening. Perfect for a gourmet lunch or semi-gastronomic dinner."
        ],
        "it": [
          "Le Péché Gourmand è un ottimo indirizzo alla periferia di Arras, con un ambiente moderno e accogliente, una cucina stagionale ben preparata, un servizio attento e un'atmosfera rilassata a pranzo e raffinata la sera. Perfetto per un pranzo gourmet o una cena semi-gastronomica."
        ],
        "fr": [
          "Le Péché Gourmand est une excellente adresse à la sortie d’Arras : cadre moderne et cosy, cuisine de saison bien travaillée, service soigné, et ambiance à la fois détendue le midi et raffinée le soir. Parfait pour un déjeuner gourmand ou un dîner semi‑gastronomique."
        ],
        "nl": [
          "Le Péché Gourmand is een uitstekend adres aan de rand van Arras, met zijn moderne, gezellige omgeving, goed bereide seizoensgerechten, attente bediening en een sfeer die zowel ontspannen is tijdens de lunch als verfijnd 's avonds. Perfect voor een gastronomische lunch of een semi-gastronomisch diner."
        ],
        "es": [
          "Le Péché Gourmand es una excelente dirección en las afueras de Arras, con un ambiente moderno y acogedor, una cocina de temporada bien preparada, un servicio atento y un ambiente a la vez relajado al mediodía y refinado por la noche. Ideal para un almuerzo gastronómico o una cena semigastronómica."
        ]
      },
