  "rdfs:comment": {
    "de": [
      "- Frühstück, Buffets, savoyische Spezialitäten oder Tagesgericht (Weltküche), hausgemachte Desserts.\r\n- Bar: kalte oder warme Getränke, Bier, Spirituosen, Weinkarte, Tapas & Aperitifbretter ab 15 Uhr, Abendservice ab 19 Uhr."
    ],
    "en": [
      "- Breakfasts, buffets, Savoyard specialties or dish of the day (world cuisine), homemade desserts.\r\n- Bar: cold or hot drinks, beers, spirits, wine list, tapas & aperitif boards from 3 p.m., evening service from 7 p.m."
    ],
    "it": [
      "- Colazioni, buffet, specialità savoiarde o piatti del giorno (cucina mondiale), dolci fatti in casa.\r\n- Bar: bevande fredde o calde, birre, alcolici, carta dei vini, taglieri di tapas e aperitivi dalle 15.00, servizio serale dalle 19.00."
    ],
    "fr": [
      "- Petits-déjeuners, buffets, spécialités savoyardes ou plat du jour (cuisine du monde), desserts maison.\r\n- Bar : boissons fraîches ou chaudes, bières, alcools, carte de vins, tapas & planches apéro à partir de 15h, service du soir à partir de 19h."
    ],
    "nl": [
      "- Ontbijten, buffetten, Savoyaardse specialiteiten of dagschotel (wereldkeuken), huisgemaakte desserts.\r\n- Bar: koude of warme dranken, bieren, sterke dranken, wijnkaart, tapas & aperitiefplanken vanaf 15.00 uur, avondservice vanaf 19.00 uur."
    ],
    "es": [
      "- Desayunos, buffets, especialidades saboyanas o plato del día (cocina del mundo), postres caseros.\r\n- Bar: bebidas frías o calientes, cervezas, licores, carta de vinos, tablas de tapas y aperitivos a partir de las 15 horas, servicio nocturno a partir de las 19 horas."
    ]
  },
