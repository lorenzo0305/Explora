  "rdfs:comment": {
    "de": [
      "La Vallée Bleue ist eine Freizeitanlage mit mehreren Aktivitäten, die sich in den Balcons du Dauphiné in der Region Auvergne Rhône-Alpes befindet. Es vereint eine Vielzahl von Aktivitäten an den Ufern der Rhône in einer bemerkenswerten natürlichen Umgebung."
    ],
    "en": [
      "La Vallée Bleue is a multi-activity leisure site located in the Balcons du Dauphiné in the Auvergne Rhône-Alpes region. It offers a multitude of activities on the banks of the Rhône, in a remarkable natural setting."
    ],
    "it": [
      "Vallée Bleue è un sito ricreativo multiattività situato nei Balcons du Dauphiné, nella regione Auvergne Rhône-Alpes. Offre una moltitudine di attività sulle rive del Rodano, in un ambiente naturale straordinario."
    ],
    "fr": [
      "La Vallée Bleue est un site de loisirs multi-activités situé aux Balcons du Dauphiné en région Auvergne Rhône-Alpes. Il regroupe une multitude d'activités sur les berges du Rhône, dans un cadre naturel remarquable."
    ],
    "nl": [
      "Vallée Bleue is een multifunctioneel recreatiegebied in de Balcons du Dauphiné in de regio Auvergne Rhône-Alpes. Het biedt een veelheid aan activiteiten aan de oevers van de Rhône, in een opmerkelijke natuurlijke omgeving."
    ],
    "es": [
      "Vallée Bleue es un centro de ocio multiactividades situado en los Balcons du Dauphiné, en la región de Auvernia Ródano-Alpes. Ofrece multitud de actividades a orillas del Ródano, en un entorno natural excepcional."
    ]
  },
  "rdfs:label": {
    "de": [
      "Freizeitzentrum \"La Vallée Bleue\""
    ],
    "en": [
      "La Vallée Bleue outdoor recreational centre"
    ],
    "fr": [
      "Base de loisirs de la Vallée Bleue"
    ]
  },
