  "rdfs:comment": {
    "de": [
      "Brasserie Restaurant. Wir bieten hausgemachte Gerichte aus lokalen und saisonalen Produkten. Vegetarische Gerichte werden angeboten. Ideal auch für eine erfrischende Pause oder eine Kaffeepause. Nutzen Sie unsere Terrasse!"
    ],
    "en": [
      "Beerhouse and restaurant. We offer home-made dishes from local fresh products. Vegetarian dishes available. Have a break with a coffee or a cool drink. Enjoy the terrace!"
    ],
    "it": [
      "Ristorante brasserie. Offriamo piatti fatti in casa con prodotti locali e di stagione. Sono disponibili piatti vegetariani. Ideale anche per una pausa rinfrescante o una pausa caffè. Approfittate della nostra terrazza!"
    ],
    "fr": [
      "Brasserie restaurant. Nous proposons des plats faits maison, à base de produits locaux et de saison. Plats végétariens proposés. Idéal également pour une pause rafraîchissante ou une pause café. Profitez de notre terrasse !"
    ],
    "es": [
      "Restaurante brasería. Ofrecemos platos caseros elaborados con productos locales de temporada. Platos vegetarianos disponibles. También es ideal para una pausa refrescante o para tomar un café. ¡Aproveche nuestra terraza!"
    ],
    "nl": [
      "Brasserie restaurant. We bieden huisgemaakte gerechten van lokale, seizoensgebonden producten. Vegetarische gerechten verkrijgbaar. Ook ideaal voor een verfrissende pauze of een koffiepauze. Profiteer van ons terras!"
    ]
  },
