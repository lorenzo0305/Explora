  "rdfs:comment": {
    "de": [
      "Auf der Straße, die nach Aurec-sur-Loire führt, verläuft das Viadukt der neun Brücken entlang der Loire. Er zeugt von der Ankunft der Eisenbahn im Loiretal im Jahr 1863. Die Strecke Saint-Etienne-Le Puy ermöglichte es, die Fabriken der Haute-Loire mit Kohle zu versorgen."
    ],
    "en": [
      "On the road to Aurec-sur-Loire, the viaduc des neuf-ponts runs alongside the Loire. It bears witness to the arrival of the railroad in the Loire Valley in 1863. The Saint-Etienne-Le Puy line supplied coal to factories in the Haute-Loire region."
    ],
    "it": [
      "Sulla strada per Aurec-sur-Loire, il viadotto Neuf-ponts costeggia la Loira. Testimonia l'arrivo della ferrovia nella Valle della Loira nel 1863. La linea Saint-Etienne-Le Puy forniva carbone alle fabbriche dell'Alta Loira."
    ],
    "fr": [
      "Sur la route qui conduit à Aurec-sur-Loire, le viaduc des neuf-ponts longe la Loire. Il témoigne de l'arrivée en 1863 du chemin de fer dans la vallée de Loire. La ligne Saint-Etienne-Le Puy permettait d'alimenter les usines de Haute-Loire en charbon."
    ],
    "nl": [
      "Op de weg naar Aurec-sur-Loire loopt het viaduct Neuf-Ponts langs de Loire. Het getuigt van de komst van de spoorlijn in de Loirevallei in 1863. De lijn Saint-Etienne-Le Puy leverde steenkool aan de fabrieken in de Haute-Loire."
    ],
    "es": [
      "En la carretera de Aurec-sur-Loire, el viaducto de neuf-ponts bordea el Loira. Es testigo de la llegada del ferrocarril al valle del Loira en 1863. La línea Saint-Etienne-Le Puy suministraba carbón a las fábricas del Alto Loira."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Viaduc des neuf-ponts"
    ]
  },
