  "rdfs:comment": {
    "de": [
      "Passionierte Imker mit einem Bienenstock von etwa 400 Bienenstöcken. Serge, Nadia, Mélanie und Florian bieten Ihnen ihren Honig, Brotaufstriche, Honigbonbons... an. Tauchen Sie mit den kostenlosen Führungen im Juli und August in die Welt der Bienen ein."
    ],
    "en": [
      "Délices au Miel invites you to discover the world of bees, and to taste their delicious honey.\r\nIn July and August : guided tour of the production workshop."
    ],
    "it": [
      "Apicoltori appassionati con un apiario di circa 400 arnie. Serge, Nadia, Mélanie e Florian vi offrono i loro mieli, creme spalmabili, dolci al miele, ecc. Venite a immergervi nel mondo delle api con visite gratuite in luglio e agosto."
    ],
    "fr": [
      "Apiculteurs passionnés avec un rucher d'environ 400 ruches. Serge, Nadia, Mélanie et Florian vous proposent leurs miels, pâtes à tartiner, bonbons au miel... Venez plonger dans le monde des abeilles avec les visites gratuites en juillet et août."
    ],
    "nl": [
      "In juli en augustus nodigt familie Bompard Serge u uit voor een onderdompeling in de wereld van de bijen en honing met: een demonstratie van honingextractie, ontdekking van de wereld van de bij, bezoek aan het transformatie-atelier..."
    ],
    "es": [
      "Apicultores apasionados con un colmenar de unas 400 colmenas. Serge, Nadia, Mélanie y Florian le ofrecen sus mieles, cremas para untar, dulces de miel, etc. Venga a sumergirse en el mundo de las abejas con visitas gratuitas en julio y agosto."
    ]
  },
