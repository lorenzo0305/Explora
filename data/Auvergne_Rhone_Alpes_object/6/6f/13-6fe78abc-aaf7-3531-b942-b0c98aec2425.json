  "rdfs:comment": {
    "de": [
      "Restaurant mit traditioneller und authentischer Küche, die vor Ort in unserem Restaurant mit lokalen Produkten von ausgezeichneter Qualität zubereitet wird, und das alles mit dem Komfort und der Einfachheit eines einzigartigen Ortes, an dem Sie die Natur genießen können."
    ],
    "en": [
      "Traditional, authentic cuisine, prepared on site in our restaurant with local, top-quality produce, all in the comfort and simplicity of a unique place where you can enjoy nature."
    ],
    "it": [
      "Una cucina tradizionale e autentica, preparata nel nostro ristorante con prodotti locali di alta qualità, il tutto nel comfort e nella semplicità di un ambiente unico, dove potrete godervi la vita all'aria aperta."
    ],
    "fr": [
      "Restaurant de cuisine traditionnelle et authentique, effectuée sur place dans notre restaurant avec des produits locaux et d’excellente qualité, le tout dans le confort et la simplicité d’un lieu unique où vous pourrez profiter de la nature."
    ],
    "nl": [
      "Traditionele, authentieke gerechten, bereid in ons restaurant met lokale producten van topkwaliteit, allemaal in het comfort en de eenvoud van een unieke omgeving waar je kunt genieten van het buitenleven."
    ],
    "es": [
      "Cocina tradicional y auténtica, elaborada en nuestro restaurante con productos locales de primera calidad, todo ello en la comodidad y sencillez de un entorno único donde disfrutar al aire libre."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant-bar Le Relais de la Forêt"
    ]
  },
