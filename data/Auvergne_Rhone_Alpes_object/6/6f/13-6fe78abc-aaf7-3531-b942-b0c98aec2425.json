          "additionalInformation": {
            "de": [
              "Restaurant geöffnet:\r\nMontagmittag, Donnerstagmittag, Freitag- und Samstagmittag und -abend sowie Sonntagmittag.\r\nAuf Reservierung.\r\n\r\nBar geöffnet:\r\nMontag, Donnerstag, Freitag und Samstag von 7:30 bis 20:00 Uhr.\r\nDienstag von 7.30 bis 16.00 Uhr\r\nSonntag von 8:00 bis 18:00 Uhr."
            ],
            "en": [
              "Restaurant open:\r\nMonday lunchtime, Thursday lunchtime, Friday and Saturday lunchtime and evening, and Sunday lunchtime.\r\nReservations required.\r\n\r\nBar open :\r\nMonday, Thursday, Friday and Saturday, 7:30am to 8pm.\r\nTuesday 7.30am to 4pm\r\nSunday from 8am to 6pm."
            ],
            "it": [
              "Ristorante aperto:\r\nLunedì a pranzo, giovedì a pranzo, venerdì e sabato a pranzo e sera e domenica a pranzo.\r\nPrenotazione obbligatoria.\r\n\r\nBar aperto:\r\nLunedì, giovedì, venerdì e sabato dalle 7.30 alle 20.00.\r\nMartedì dalle 7.30 alle 16.00\r\nDomenica dalle 8.00 alle 18.00."
            ],
            "fr": [
              "Restaurant ouvert:\r\nLundi midi, jeudi midi, vendredi et samedi midi et soir, ainsi que le dimanche midi.\r\nSur réservation.\r\n\r\nOuverture du bar :\r\nLundi, jeudi, vendredi et samedi de 7h30 à 20h.\r\nMardi de 7h30 à 16h00\r\nDimanche de 8h à 18h."
            ],
            "es": [
              "Restaurante abierto:\r\nLunes al mediodía, jueves al mediodía, viernes y sábados al mediodía y por la noche, y domingos al mediodía.\r\nReserva obligatoria.\r\n\r\nBar abierto :\r\nLunes, jueves, viernes y sábado de 7.30 a 20.00 h.\r\nMartes de 7h30 a 16h00\r\nDomingo de 8h a 18h."
            ],
            "nl": [
              "Restaurant geopend:\r\nMaandag lunchtijd, donderdag lunchtijd, vrijdag en zaterdag lunchtijd en avond, en zondag lunchtijd.\r\nReserveren verplicht.\r\n\r\nBar open :\r\nMaandag, donderdag, vrijdag en zaterdag van 7.30 tot 20.00 uur.\r\nDinsdag van 7.30 tot 16.00 uur\r\nZondag van 8.00 tot 18.00 uur."
            ]
          },
