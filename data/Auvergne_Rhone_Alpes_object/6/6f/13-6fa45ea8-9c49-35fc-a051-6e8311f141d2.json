  "rdfs:comment": {
    "de": [
      "Willkommen in der Welt der unendlichen Sprünge und Hüpfer! Stürzen Sie sich mit unserem Bungee-Trampolin sicher ins Abenteuer und bieten Sie Ihren Kindern ein unvergessliches Spielerlebnis!"
    ],
    "en": [
      "Welcome to the world of infinite bounces and jumps! Dive into adventure in complete safety thanks to our bungee trampoline and give your children an unforgettable play experience!"
    ],
    "it": [
      "Benvenuti nel mondo dei rimbalzi e dei salti infiniti! Tuffatevi nell'avventura in tutta sicurezza grazie al nostro trampolino bungee e regalate ai vostri bambini un'esperienza di gioco indimenticabile!"
    ],
    "fr": [
      "Bienvenue dans le monde des sauts et des rebonds infinis ! Plongez dans l'aventure en toute sécurité grâce à notre trampoline élastique et offrez à vos enfants une expérience de jeu inoubliable !"
    ],
    "es": [
      "¡Bienvenido al mundo de los rebotes y saltos infinitos! Sumérjase en la aventura con total seguridad gracias a nuestro trampolín elástico y regale a sus hijos una experiencia de juego inolvidable"
    ],
    "nl": [
      "Welkom in de wereld van oneindig stuiteren en springen! Duik in het avontuur in alle veiligheid dankzij onze bungee trampoline en geef je kinderen een onvergetelijke speelervaring!"
    ]
  },
