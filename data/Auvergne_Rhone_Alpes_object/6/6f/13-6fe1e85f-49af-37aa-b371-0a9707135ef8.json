  "rdfs:comment": {
    "de": [
      "In einer gedämpften, intimen und doch geselligen Atmosphäre können Sie Gerichte zwischen Gourmandise und Raffinesse genießen und sich auf der prächtigen Panoramaterrasse mit Blick auf den Mont Blanc vergnügen."
    ],
    "en": [
      "In a subdued atmosphere, intimate but friendly, enjoy refined and gourmet dishes. The Jiva offers a warm contemporary decor and a scenic terrace overlooking the Mont Blanc."
    ],
    "it": [
      "In un'atmosfera discreta, intima e amichevole, assaporate piatti deliziosi e raffinati e godetevi la sontuosa terrazza panoramica con vista sul Monte Bianco."
    ],
    "fr": [
      "Dans une ambiance tamisée, intimiste mais conviviale, dégustez des plats entre gourmandise et raffinement et profitez de la somptueuse terrasse panoramique avec vue sur le Mont Blanc."
    ],
    "nl": [
      "Proef in een ingetogen, intieme maar vriendelijke sfeer gerechten die zowel heerlijk als verfijnd zijn, en geniet van het weelderige panoramische terras met uitzicht op de Mont Blanc."
    ],
    "es": [
      "En un ambiente discreto, íntimo pero acogedor, saboree platos a la vez deliciosos y refinados, y disfrute de la suntuosa terraza panorámica con vistas al Mont Blanc."
    ]
  },
  "rdfs:label": {
