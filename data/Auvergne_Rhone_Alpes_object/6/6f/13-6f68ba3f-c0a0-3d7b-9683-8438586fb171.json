  "rdfs:comment": {
    "de": [
      "Wenn eine Pause nötig ist, gibt es Pauze! Pauze ist ein Restaurant, in dem sich Essen auf Qualität reimt. Wir wählen frische, saisonale und lokale Produkte aus, um Gerichte zu zaubern, die ebenso gut wie gesund sind!"
    ],
    "en": [
      "When you need a break, there's Pauze! Pauze is a restaurant where food rhymes with quality. We select fresh, seasonal and local products to concoct dishes that are as good as they are healthy!"
    ],
    "it": [
      "Quando hai bisogno di una pausa, c'è Pauze! Pauze è un ristorante dove il cibo è sinonimo di qualità. Selezioniamo prodotti freschi, stagionali e locali per preparare piatti tanto buoni quanto sani!"
    ],
    "fr": [
      "Quand une pause s'impose, il y a Pauze ! Pauze est un restaurant où nourriture rime avec qualité. Nous sélectionnons des produits frais, de saison et locaux pour concocter des plats aussi bons que sains !"
    ],
    "es": [
      "Cuando necesitas un descanso, ¡está Pauze! Pauze es un restaurante donde la comida es sinónimo de calidad. Seleccionamos productos frescos, de temporada y locales para elaborar platos tan buenos como saludables"
    ],
    "nl": [
      "Als je een pauze nodig hebt, is er Pauze! Pauze is een restaurant waar eten synoniem is met kwaliteit. Wij selecteren verse, seizoensgebonden en lokale producten om gerechten te bereiden die even lekker als gezond zijn!"
    ]
  },
