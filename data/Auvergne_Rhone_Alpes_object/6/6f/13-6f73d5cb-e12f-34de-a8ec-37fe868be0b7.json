  "rdfs:comment": {
    "de": [
      "Auf dieser Route können Sie die schönsten Orte von Courchevel entdecken: die Wiese von Pralin, Praméruel, das Viertel Jardin Alpin, Plan du Vah und die Dörfer Courchevel 1850 und Courchevel Moriond."
    ],
    "en": [
      "This itinerary allows you to discover Courchevel's most beautiful spots: the Pralin meadow, Praméruel, the Jardin Alpin district, Plan du Vah and the villages of Courchevel 1850 and Courchevel Moriond."
    ],
    "it": [
      "Questo itinerario permette di scoprire i luoghi più belli di Courchevel: l'alpe Pralin, Praméruel, il quartiere Jardin Alpin, Plan du Vah e i villaggi di Courchevel 1850 e Courchevel Moriond."
    ],
    "fr": [
      "Cet itinéraire vous permet de découvrir les plus beaux endroits de Courchevel : la prairie de Pralin, Praméruel, le quartier du Jardin Alpin, le Plan du Vah et les villages de Courchevel 1850 et Courchevel Moriond."
    ],
    "nl": [
      "Met deze route ontdek je de mooiste plekjes van Courchevel: de Pralin-weide, Praméruel, de wijk Jardin Alpin, Plan du Vah en de dorpen Courchevel 1850 en Courchevel Moriond."
    ],
    "es": [
      "Este itinerario le permitirá descubrir los lugares más bellos de Courchevel: la pradera de Pralin, Praméruel, el barrio de Jardin Alpin, Plan du Vah y los pueblos de Courchevel 1850 y Courchevel Moriond."
    ]
  },
  "rdfs:label": {
    "en": [
      "E-Bike -Tour of Courchevel 1850 and Moriond"
    ],
    "fr": [
      "E-Bike -Tour de Courchevel 1850 et Moriond"
    ]
  },
