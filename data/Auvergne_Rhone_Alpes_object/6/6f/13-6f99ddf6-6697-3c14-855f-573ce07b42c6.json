  "rdfs:comment": {
    "de": [
      "Die Freizeitanlage von Centron ist ein idealer Ort, um sich mit der Familie oder Freunden zu entspannen. Sie bietet u. a. eine Wasserfläche, Kinderspiele, Picknickplätze mit Grills, einen Multisportplatz..."
    ],
    "en": [
      "Centron leisure park is the perfect place to relax with family or friends, with a small lake, a kids' playground, a picnic area with barbecues, a multisport ground..."
    ],
    "it": [
      "Il centro ricreativo Centron è un luogo ideale per rilassarsi con la famiglia e gli amici, con un lago, aree gioco per bambini, aree picnic con barbecue, un campo polisportivo..."
    ],
    "fr": [
      "La base de loisirs de Centron est un lieu idéal pour se détendre en famille ou entre amis avec notamment un plan d’eau, des jeux pour enfants, aires de pique-nique avec barbecues, un terrain multisports..."
    ],
    "nl": [
      "Het recreatiecentrum van Centron is een ideale plaats om zich te vermaken met familieleden of vrienden met o.a. een recreatievijver, kinderspelen, picknickplaatsen met bbq, een multisportterrein..."
    ],
    "es": [
      "El centro de ocio Centron es un lugar ideal para relajarse con la familia y los amigos, con un lago, zonas de juegos infantiles, áreas de picnic con barbacoas, una pista polideportiva..."
    ]
  },
