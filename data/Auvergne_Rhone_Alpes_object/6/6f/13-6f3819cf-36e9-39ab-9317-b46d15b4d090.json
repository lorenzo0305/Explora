  "rdfs:comment": {
    "de": [
      "Hast du Lust, deinem Alltag zu entfliehen? Eine Pause in einer entspannenden Umgebung zu machen? Dann mach doch einen Abstecher ins Restaurant des Campingplatzes! Hier hast du eine unglaubliche Aussicht. Es gibt Cocktails, Eis, Musik und eine familiäre Atmosphäre."
    ],
    "en": [
      "Want to escape from your daily life? To take a break in a relaxing setting? Come and take a little trip to the campsite restaurant! The view here is incredible. There are cocktails, ice cream, music and a family atmosphere."
    ],
    "it": [
      "Volete staccare la spina? Fare una pausa in un ambiente rilassante? Allora venite a dare un'occhiata al ristorante del campeggio! La vista è incredibile. Ci sono cocktail, gelati, musica e un'atmosfera familiare."
    ],
    "fr": [
      "Envie de t'échapper de ton quotidien ? De faire une pause dans un cadre relaxant ? Viens donc faire un petit tour au restaurant du camping ! Ici, la vue est incroyable. Il y a des cocktails, des glaces, de la musique et une ambiance familiale."
    ],
    "es": [
      "¿Quiere alejarse de todo? ¿Descansar en un entorno relajante? Entonces ven a echar un vistazo al restaurante del camping Aquí las vistas son increíbles. Hay cócteles, helados, música y un ambiente familiar."
    ],
    "nl": [
      "Wil je er even helemaal tussenuit? Er even tussenuit in een ontspannende omgeving? Kom dan een kijkje nemen in het campingrestaurant! Het uitzicht is hier ongelooflijk. Er zijn cocktails, ijsjes, muziek en een gezellige familiesfeer."
    ]
  },
