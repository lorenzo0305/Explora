          "@type": [
            "schema:OpeningHoursSpecification"
          ],
          "additionalInformation": {
            "de": [
              "Vom 03/04 bis zum 01/10/2026 :\r\nDie täglich geöffnete Bar\r\num etwas zu trinken und/oder ein Eis zu essen!\r\n\r\nVom 27.6. bis 29.8.2026 :\r\nVon 8:00 bis 23:00 Uhr geöffnet.\r\nMittags gibt es einen Notdienst mit Salat und Paninis.\r\nAbends ist die Küche geöffnet. Es ist ratsam, zu reservieren."
            ],
            "en": [
              "From 03/04 to 01/10/2026:\r\nThe bar is open every day\r\nfor a drink and/or ice cream!\r\n\r\nFrom 27/6 to 29/8/2026:\r\nOpen from 8am to 11pm.\r\nAt lunchtime, we serve salads and paninis.\r\nIn the evenings, the kitchen is open. Reservations are recommended."
            ],
            "it": [
              "Dal 03/04 al 01/10/2026:\r\nIl bar è aperto tutti i giorni\r\nper un drink e/o un gelato!\r\n\r\nDal 27/6 al 29/8/2026:\r\nAperto dalle 8.00 alle 23.00.\r\nA pranzo serviamo insalate e panini.\r\nLa sera, la cucina è aperta. Si consiglia la prenotazione."
            ],
            "fr": [
              "Du 03/04 au 01/10/2026 :\r\nLe bar ouvert tous les jours \r\npour boire un verre et/ou manger une glace !\r\n\r\nDu 27/6 au 29/8/2026 :\r\nOuvert de 8h à 23h. \r\nA midi, nous faisons du dépannage avec salade et paninis. \r\nLes soirs, la cuisine est ouverte. Il est préférable de réserver."
            ],
            "nl": [
              "Van 03/04 tot 01/10/2026:\r\nDe bar is elke dag open\r\nvoor een drankje en/of een ijsje!\r\n\r\nVan 27/6 tot 29/8/2026:\r\nOpen van 8u tot 23u.\r\nTijdens de lunch serveren we salades en panini's.\r\nS Avonds is de keuken open. Reserveren wordt aanbevolen."
            ],
            "es": [
              "Del 03/04 al 01/10/2026:\r\nEl bar está abierto todos los días\r\npara tomar una copa y/o un helado\r\n\r\nDel 27/6 al 29/8/2026:\r\nAbierto de 8h a 23h.\r\nAl mediodía, servimos ensaladas y paninis.\r\nPor la noche, la cocina está abierta. Se recomienda reservar."
            ]
          },
