  "rdfs:comment": {
    "de": [
      "Nehmen Sie sich Zeit, um eine neu erfundene Küche aus der Nachbarschaft zu genießen. Ein Mutter-Tochter-Duo, das die Liebe zu Produkten und Geschmack pflegt und dabei Familiengeist und Geselligkeit miteinander verbindet."
    ],
    "en": [
      "Come and take the time to enjoy reinvented local cuisine. A mother/daughter duo who cultivate a love of produce and taste that blends family spirit and conviviality."
    ],
    "it": [
      "Venite e prendetevi il tempo per gustare una cucina locale reinventata. Un duo madre-figlia che coltiva l'amore per i prodotti e il gusto, coniugando spirito familiare e convivialità."
    ],
    "fr": [
      "Venez prendre le temps de déguster une cuisine de quartier réinventée. Un duo mère/fille qui cultive l'amour des produits et le goût mêlant esprit de famille et convivialité."
    ],
    "es": [
      "Venga y tómese su tiempo para disfrutar de una cocina local reinventada. Un dúo de madre e hija que cultiva el amor por los productos y el gusto, combinando el espíritu familiar y la convivencia."
    ],
    "nl": [
      "Kom en neem de tijd om te genieten van een heruitgevonden lokale keuken. Een moeder/dochter duo dat liefde voor producten en smaak cultiveert, en familiegeest en gezelligheid combineert."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant Le Quartier"
    ]
  },
