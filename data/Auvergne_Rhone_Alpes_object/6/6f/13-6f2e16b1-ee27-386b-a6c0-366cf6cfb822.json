  "rdfs:comment": {
    "de": [
      "Mit dem Mountainbike, BMX, Trottinett, Skateboard oder Inlineskates... profitieren Sie von der neuen Piste in Hauteluce. Spiel, Spaß, Rutschen, Steilkurven, Tables, Whoops... Spaß für alle Niveaus (vom Anfänger bis zum erfahrenen Rider) ab 4/5 Jahren."
    ],
    "en": [
      "Whether you're on a mountain bike, BMX, scooter, skateboard or rollerblades... take advantage of the new Hauteluce track. Fun, sliding, banked turns, tables, whoops... fun for all levels (from beginner to experienced rider) from 4/5 years upwards."
    ],
    "it": [
      "Che siate in mountain bike, BMX, monopattino, skateboard o rollerblade... approfittate della nuova pista di Hauteluce. Divertimento, scivolate, curve in curva, tabelle, whoops... divertimento per tutti i livelli (dal principiante all'esperto) dai 4/5 anni in su."
    ],
    "fr": [
      "En VTT, BMX, trottinette, skate ou rollers... profitez de la nouvelle piste d'Hauteluce. Du ludique, de la glisse, des virages relevés, des tables, des whoops... du fun pour tous les niveaux (du débutant au rider confirmé) à partir de 4/5 ans."
    ],
    "es": [
      "Ya sea en bicicleta de montaña, BMX, scooter, monopatín o patines... aprovecha la nueva pista de Hauteluce. Diversión, deslizamiento, curvas peraltadas, tablas, whoops... diversión para todos los niveles (de principiante a rider experimentado) a partir de 4/5 años."
    ],
    "nl": [
      "Of je nu op een mountainbike, BMX, step, skateboard of skeelers zit... profiteer van de nieuwe Hauteluce-baan. Fun, glijden, schuine bochten, tables, whoops... plezier voor alle niveaus (van beginner tot ervaren rijder) vanaf 4/5 jaar."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Pumptrail de l'Infernet"
    ]
  },
