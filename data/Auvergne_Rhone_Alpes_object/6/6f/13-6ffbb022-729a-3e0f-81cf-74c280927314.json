  "rdfs:comment": {
    "de": [
      "20.000 m² wunderschöner Garten des Naturhistorischen Museums, seltene Bäume, botanische Gewächshäuser, Wintergarten... Ideal für Familien mit einem Spielplatz, einem Wasserlauf und Rasenflächen, auf denen man sich niederlassen kann."
    ],
    "en": [
      "20,000 m² of magnificent natural history museum gardens, rare trees, botanical greenhouses, winter garden... Ideal for families, with its playground, stream and lawns on which to relax."
    ],
    "it": [
      "20.000 m² di magnifici giardini del Museo di Storia Naturale, alberi rari, serre botaniche, giardino d'inverno... Ideale per le famiglie con il suo parco giochi, il suo corso d'acqua e i suoi prati su cui è possibile sistemarsi."
    ],
    "fr": [
      "20 000 m² de magnifique jardin du Muséum d'histoire naturelle, arbres rares, serres botaniques, jardin d'hiver... Idéal pour les familles avec son aire de jeux, son cours d'eau et ses pelouses sur lesquelles il est possible de s'installer."
    ],
    "nl": [
      "20.000 m² prachtige tuin van het Natuurhistorisch Museum, zeldzame bomen, botanische kassen, wintertuin... Ideaal voor gezinnen met zijn speeltuin, zijn waterloop en zijn grasvelden waarop het mogelijk is zich te vestigen."
    ],
    "es": [
      "20.000 m² de magníficos jardines de museo de historia natural, árboles raros, invernaderos botánicos, jardín de invierno... Ideal para familias, con su parque infantil, arroyo y césped para relajarse."
    ]
  },
