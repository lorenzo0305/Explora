  "rdfs:comment": {
    "de": [
      "Le Bocal d'Art bietet das ganze Jahr über die Produktion lokaler Kunsthandwerker zum Verkauf an: Lederwaren, Holzobjekte, Accessoires und textile Spiele für Kinder, Karten, botanische Drucke, Schmuck, Tischkultur etc."
    ],
    "en": [
      "Le Bocal d'Art offers the products of local artisans for sale all year round: leather goods, wooden objects, textile accessories and games for children, cards, botanical prints, jewelry, tableware, etc."
    ],
    "it": [
      "Le Bocal d'Art vende tutto l'anno i lavori degli artigiani locali, tra cui articoli in pelle, oggetti in legno, accessori tessili e giochi per bambini, cartoline, stampe botaniche, gioielli e oggetti per la tavola."
    ],
    "fr": [
      "Le Bocal d'Art propose à la vente tout au long de l'année la production d'artisans locaux : maroquinerie, objets en bois, accessoires et jeux textiles pour enfants, Cartes, impression botanique, bijoux, art de la table, etc."
    ],
    "nl": [
      "Le Bocal d'Art verkoopt het hele jaar door het werk van plaatselijke ambachtslieden, waaronder lederwaren, houten voorwerpen, textielaccessoires en spelletjes voor kinderen, kaarten, botanische prenten, sieraden en serviesgoed."
    ],
    "es": [
      "Le Bocal d'Art vende durante todo el año las obras de los artesanos locales: marroquinería, objetos de madera, accesorios textiles y juegos infantiles, tarjetas, estampas botánicas, joyas y vajillas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Boutique de créateurs Le Bocal d'art"
    ]
  },
