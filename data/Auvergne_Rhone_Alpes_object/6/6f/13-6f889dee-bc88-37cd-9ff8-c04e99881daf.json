  "rdfs:comment": {
    "de": [
      "Das Restaurant des Hotels Alexander Park Chambéry bietet Ihnen eine einfache und leckere Küche in einem gemütlichen Rahmen: Der Saal ist mit Bildern lokaler Künstler dekoriert. Sie finden hier tägliche Vorschläge, aber auch eine saisonale Karte."
    ],
    "en": [
      "The restaurant at the Alexander Park Chambéry hotel offers simple, gourmet cuisine in a warm setting, with a room decorated with paintings by local artists. You'll find daily suggestions, as well as a seasonal menu."
    ],
    "it": [
      "Il ristorante dell'hotel Alexander Park Chambéry propone una cucina semplice e gourmet in un ambiente accogliente: la sala da pranzo è decorata con dipinti di artisti locali. Troverete proposte giornaliere e un menu stagionale."
    ],
    "fr": [
      "Le restaurant de l’hôtel Alexander Park Chambéry vous propose une cuisine simple et gourmande, dans un cadre chaleureux : salle décorée avec des tableaux d’artistes locaux. Vous y retrouverez des suggestions journalières, mais aussi une carte saisonnière."
    ],
    "nl": [
      "Het restaurant van het Alexander Park Chambéry hotel serveert eenvoudige, gastronomische gerechten in een warme omgeving: de eetzaal is versierd met schilderijen van lokale kunstenaars. Je vindt er zowel dagsuggesties als een seizoensgebonden menu."
    ],
    "es": [
      "El restaurante del hotel Alexander Park Chambéry sirve cocina sencilla y gourmet en un ambiente cálido: el comedor está decorado con cuadros de artistas locales. Encontrará sugerencias diarias, así como un menú de temporada."
    ]
  },
