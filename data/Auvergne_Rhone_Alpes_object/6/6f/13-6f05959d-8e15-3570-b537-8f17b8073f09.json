  "rdfs:comment": {
    "de": [
      "Als Lautenspielerin und Geigerin fabriziert Anita Dongilli mit Stimme und Geige einen hybriden Pop, der alte Gedichte mit elektro-symphonischen Texturen verbindet."
    ],
    "en": [
      "Luthier and violinist Anita Dongilli uses her voice and violin to create a hybrid pop that blends ancient poetry with electro-symphonic textures."
    ],
    "it": [
      "La liutaia e violinista Anita Dongilli usa la sua voce e il suo violino per creare un pop ibrido che fonde poesia antica e tessiture elettro-sinfoniche."
    ],
    "fr": [
      "Luthière et violoniste, Anita Dongilli fabrique à la voix et au violon une pop hybride mêlant poésies anciennes et textures électro-symphoniques."
    ],
    "nl": [
      "Luthier en violiste Anita Dongilli gebruikt haar stem en viool om hybride pop te creëren die oude poëzie mengt met elektro-symfonische texturen."
    ],
    "es": [
      "La luthier y violinista Anita Dongilli utiliza su voz y su violín para crear un pop híbrido que mezcla poesía antigua con texturas electrosinfónicas."
