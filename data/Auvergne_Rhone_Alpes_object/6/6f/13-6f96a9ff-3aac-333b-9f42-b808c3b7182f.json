  "rdfs:comment": {
    "de": [
      "Ein EINZIGARTIGER Ort ... L'Après-Ski Club: Kommen Sie auf den festlichsten Dancefloor von Chamonix!\n\nUnser Club wird vom 21. Dezember 2024 bis zum 6. April 2025 freitags und samstags geöffnet sein (+ donnerstags während der französischen Schulferien)."
    ],
    "en": [
      "A UNIQUE place... L'Après-Ski Club: the most festive dancefloor in Chamonix!\n\nOur club will be open Fridays and Saturdays from December 21, 2024 to April 6, 2025 (+ Thursdays during French school vacations)."
    ],
    "it": [
      "Un luogo unico... L'Après-Ski Club: venite a divertirvi sulla pista da ballo più festosa di Chamonix!\n\nIl nostro club sarà aperto il venerdì e il sabato dal 21 dicembre 2024 al 6 aprile 2025 (+ giovedì durante le vacanze scolastiche francesi)."
    ],
    "fr": [
      "Un lieu UNIQUE... L'Après-Ski Club : Venez sur le dancefloor le plus festif de Chamonix !\n\nNotre club sera ouvert les vendredis et samedis et les jeudis en plus pendant les vacances scolaires françaises"
    ],
    "es": [
      "Un lugar ÚNICO... L'Après-Ski Club: ¡Venga a disfrutar de la pista de baile más festiva de Chamonix!\n\nNuestro club estará abierto los viernes y sábados del 21 de diciembre de 2024 al 6 de abril de 2025 (+ los jueves durante las vacaciones escolares francesas)."
    ],
    "nl": [
      "Een UNIEKE locatie... L'Après-Ski Club: Kom en geniet van de meest feestelijke dansvloer van Chamonix!\n\nOnze club is open op vrijdag en zaterdag en op donderdag tijdens de Franse schoolvakanties"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Club 1969"
    ]
  },
