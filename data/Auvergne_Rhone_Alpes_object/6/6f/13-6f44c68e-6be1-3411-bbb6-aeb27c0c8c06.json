  "rdfs:comment": {
    "de": [
      "Der Guiers, der mythische Fluss des Vorlandes, mäandert über das Plateau von Les Echelles und bietet sehr schöne offene Stellen für das Fliegenfischen."
    ],
    "en": [
      "The Guiers, mythical river of the Avant-Pays, meanders on the plateau of Les Echelles and offers very beautiful open areas for fly fishing."
    ],
    "it": [
      "Il Guiers, il mitico fiume dell'Avant-Pays, serpeggia sull'altopiano delle Echelles e offre bellissime aree aperte per la pesca a mosca."
    ],
    "fr": [
      "Le Guiers, mythique rivière de l’Avant-Pays, méandre sur le plateau des Echelles et offre de très belles zones dégagées pour la pêche à la mouche."
    ],
    "es": [
      "El Guiers, el mítico río de los Avant-Pays, serpentea sobre la meseta de Echelles y ofrece hermosas zonas abiertas para la pesca con mosca."
    ],
    "nl": [
      "De Guiers, de mythische rivier van de Avant-Pays, kronkelt over het plateau van de Echellen en biedt prachtige open gebieden voor het vliegvissen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parcours pêche « Prendre et relâcher » sur le Guiers au pont du Curé"
    ]
  },
