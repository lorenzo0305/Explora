  "rdfs:comment": {
    "de": [
      "Die 52. Ausgabe des Festivals Les Cultures du Monde in Gannat lädt zu einer interkulturellen Reise ein: Aufführungen, Workshops, Paraden und Treffen, um den Reichtum des lebendigen Erbes und der Traditionen aus aller Welt zu entdecken und zu feiern."
    ],
    "en": [
      "The 52nd edition of the Gannat Festival Les Cultures du Monde invites you on an intercultural journey: shows, workshops, parades and encounters to discover and celebrate the richness of living heritage and traditions from all over the world."
    ],
    "it": [
      "La 52ª edizione del Gannat Festival Les Cultures du Monde vi invita a un viaggio interculturale, con spettacoli, laboratori, sfilate e incontri per scoprire e celebrare la ricchezza del patrimonio vivente e delle tradizioni di tutto il mondo."
    ],
    "fr": [
      "La 52ᵉ édition du Festival de Gannat Les Cultures du Monde invite à un voyage interculturel : spectacles, ateliers, défilés et rencontres pour découvrir et célébrer la richesse du patrimoine vivant et des traditions du monde entier."
    ],
    "es": [
      "La 52 edición del Festival Les Cultures du Monde de Gannat le invita a un viaje intercultural, con espectáculos, talleres, desfiles y encuentros para descubrir y celebrar la riqueza del patrimonio vivo y las tradiciones de todo el mundo."
    ],
    "nl": [
      "De 52e editie van het Gannat Festival Les Cultures du Monde nodigt je uit voor een interculturele reis, met voorstellingen, workshops, parades en ontmoetingen om de rijkdom aan levend erfgoed en tradities uit de hele wereld te ontdekken en te vieren."
    ]
  },
  "rdfs:label": {
