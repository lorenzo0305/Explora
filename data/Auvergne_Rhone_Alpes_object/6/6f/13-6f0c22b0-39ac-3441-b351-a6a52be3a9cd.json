  "rdfs:comment": {
    "de": [
      "Die kleine Kapelle eines in den Hang gebauten Bergweilers empfängt Sie: Entdecken Sie hier die Geschichte der Beschützerin der schwangeren Frauen und die Fertigkeiten der Künstler der Barockzeit anhand eines farbenfrohen Altarbildes und Statuen!"
    ],
    "en": [
      "A small chapel, on a slope, in a mountain hamlet awaits you: come and find out about the patron saint of expectant mothers and the expertise of artists from the Baroque period who created the small tabernacle and colourful statues!"
    ],
    "it": [
      "La piccola cappella di una frazione di montagna situata sul pendio ti dà il benvenuto: scopri la storia della protettrice delle donne gravide e il savoir-faire degli artisti dell'epoca barocca attraverso un retablo e statue variopinte!"
    ],
    "fr": [
      "La petite chapelle d'un hameau de montagne construit dans la pente vous accueille : venez y découvrir l'histoire de la protectrice des femmes enceintes et les savoir-faire des artistes de l'époque baroque au travers d'un retable et de statues colorés !"
    ],
    "es": [
      "Venga a descubrir la historia de la patrona de las mujeres embarazadas y las habilidades de los artistas barrocos en un colorido retablo y estatuas"
    ],
    "nl": [
      "De kleine kapel van een berggehucht, ingebouwd in de helling, heet u welkom: kom en ontdek de geschiedenis van de beschermheilige van de zwangere vrouwen en de vaardigheden van de kunstenaars uit de barokperiode aan de hand van een kleurrijk altaarstuk en beelden!"
    ]
  },
  "rdfs:label": {
    "en": [
      "Chapelle Sainte-Marguerite (chapel): open access"
    ],
    "it": [
      "Chapelle Sainte-Marguerite: accesso libero"
    ],
    "fr": [
      "Chapelle Sainte-Marguerite : En accès libre"
    ],
    "nl": [
      "Kapel Sainte-Marguerite: Gratis toegang"
    ]
  },
