  "rdfs:comment": {
    "de": [
      "Restaurant mit Terrasse zwischen Riom und Volvic gelegen\r\nKulinarische Spezialitäten: hausgemachte Foie gras und hausgeräucherter Fisch\r\nAuvergnatische Spezialitäten: Forellenfilet mit Cantal, Schweinefuß-Cassolette mit Saint Nectaire, hausgemachte Hamburger, Trüffel"
    ],
    "en": [
      "Restaurant with terrace located between Riom and Volvic\r\nCulinary specialties: homemade foie gras and smoked fish\r\nAuvergne specialities: trout fillet with cantal, cassolette of pig's trotters with Saint Nectaire cheese, home-made hamburger. truffade"
    ],
    "it": [
      "Ristorante con terrazza situato tra Riom e Volvic\r\nSpecialità culinarie: foie gras e pesce affumicato di produzione propria\r\nSpecialità dell'Alvernia: filetto di trota con cantal, cassolette di zampone con formaggio Saint Nectaire, hamburger fatti in casa, truffade.."
    ],
    "fr": [
      "Restaurant avec terrasse situé  entre Riom et Volvic\r\nSpécialités culinaires: foie gras maison et poissons fumés maison \r\nSpécialités auvergnates : filet de truite au cantal, cassolette de pieds de porc au Saint Nectaire, hamburger maison. truffade"
    ],
    "es": [
      "Restaurante con terraza situado entre Riom y Volvic\r\nEspecialidades culinarias: foie gras casero y pescado ahumado casero\r\nEspecialidades de Auvernia: filete de trucha con cantal, cassolette de manitas de cerdo con queso Saint Nectaire, hamburguesa casera, truffade.."
    ],
    "nl": [
      "Restaurant met terras gelegen tussen Riom en Volvic\r\nCulinaire specialiteiten: huisgemaakte foie gras en huisgemaakte gerookte vis\r\nSpecialiteiten uit de Auvergne: forelfilet met cantal, cassolette van varkenspoot met Saint Nectaire kaas, huisgemaakte hamburger, truffade.."
    ]
  },
