  "rdfs:comment": {
    "de": [
      "Genießen Sie die Authentizität im La Marmotte Blanche in Samoëns! Hausgemachte Küche, savoyische Spezialitäten und traditionelle Gerichte, die mit Leidenschaft zubereitet werden. Eine gesellige und leckere Adresse, ideal, um die Geschmäcker der Berge zu entdecken. Petit futé 2025!"
    ],
    "en": [
      "Enjoy authenticity at La Marmotte Blanche in Samoëns! Home cooking, Savoyard specialities and traditional dishes prepared with passion. A friendly, gourmet address, ideal for discovering the flavors of the mountains. Petit futé 2025!"
    ],
    "it": [
      "Assaporate l'autenticità a La Marmotte Blanche di Samoëns! Cucina casalinga, specialità savoiarde e piatti tradizionali preparati con passione. Un indirizzo accogliente e gastronomico, ideale per scoprire i sapori della montagna. Petit futé 2025!"
    ],
    "fr": [
      "Savourez l’authenticité à La Marmotte Blanche à Samoëns ! Cuisine maison, spécialités savoyardes et plats traditionnels préparés avec passion. Une adresse conviviale et gourmande, idéale pour découvrir les saveurs de la montagne. Petit futé 2025 !"
    ],
    "es": [
      "Saboree la autenticidad en La Marmotte Blanche de Samoëns Cocina casera, especialidades saboyanas y platos tradicionales preparados con pasión. Una dirección gastronómica y acogedora, ideal para descubrir los sabores de la montaña. ¡Petit futé 2025!"
    ],
    "nl": [
      "Proef de authenticiteit bij La Marmotte Blanche in Samoëns! Thuiskeuken, Savoyaardse specialiteiten en traditionele gerechten met passie bereid. Een gezellig gastronomisch adres, ideaal om de smaken van de bergen te ontdekken. Petit futé 2025!"
    ]
  },
