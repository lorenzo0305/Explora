  "rdfs:comment": {
    "de": [
      "Chalet d'Altitude en Alpage, zwei Südterrassen mit Blick auf die Bergkette Belledonne.\r\nSavoyische Öko-Küche, hausgemacht, großzügig und wohlwollend, das ist der Geist der Bergerie du Soleil."
    ],
    "en": [
      "Mountain Chalet Restaurant in the pasture, two delightful sunny terraces opposite the Belledonne mountain range.\r\nCarefully prepared Savoyard Eco-Cuisine, locally produced, generous helpings and home-made resumes the spirit of the Bergerie du Soleil."
    ],
    "it": [
      "Chalet d'Altitude en Alpage, due terrazze esposte a sud con vista sulla catena montuosa di Belledonne.\r\nCucina ecologica savoiarda, casalinga, generosa e amichevole: questo è lo spirito della Bergerie du Soleil."
    ],
    "fr": [
      "Chalet d'Altitude en Alpage, deux terrasses plein sud face à la chaîne de montagne Belledonne.\r\nÉco cuisine Savoyarde, mitonnée maison, généreux et bienveillant, voici l'esprit de la Bergerie du Soleil."
    ],
    "nl": [
      "Wees welkom!\r\nEcokeuken  van Savoye, voor \"locavoren\", liefhebbers van de plaatselijke keuken, een gul huis vol attentie, dat is de essentie van la Bergerie du Soleil."
    ],
    "es": [
      "Chalet d'Altitude en Alpage, dos terrazas orientadas al sur frente a la cordillera Belledonne.\r\nCocina ecológica saboyana, casera, generosa y acogedora: ese es el espíritu de la Bergerie du Soleil."
    ]
  },
  "rdfs:label": {
    "en": [
      "La Bergerie du Soleil restaurant"
    ],
    "fr": [
      "La Bergerie du Soleil"
    ],
    "nl": [
      "La Bergerie du Soleil"
    ]
  },
