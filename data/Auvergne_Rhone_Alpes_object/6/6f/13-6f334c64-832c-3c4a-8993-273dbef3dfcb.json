  "rdfs:comment": {
    "de": [
      "Der Snowpark von La Clusaz, der in Verbindung mit der lokalen Rider-Gruppierung in \"LCZ Park\" umbenannt wurde, bietet allen Freestyle-Fans einen vergnüglichen Bereich!"
    ],
    "en": [
      "The La Clusaz snowpark, renamed ‘LCZ Park’ in association with the local riders' group, offers a fun area for all freestyle fans!"
    ],
    "it": [
      "Lo snowpark di La Clusaz, ribattezzato \"LCZ Park\" in collaborazione con il gruppo di rider locali, offre uno spazio divertente per tutti gli appassionati di freestyle!"
    ],
    "fr": [
      "Le snowpark de La Clusaz rebaptisé « LCZ Park » en lien avec le groupement de riders locaux, propose un espace ludique à tous les amateurs de freestyle !"
    ],
    "nl": [
      "Het snowpark van La Clusaz, dat in samenwerking met de lokale ridersgroep omgedoopt is tot “LCZ Park”, biedt een leuk gebied voor alle freestyle fans!"
    ],
    "es": [
      "El snowpark de La Clusaz, rebautizado \"LCZ Park\" en colaboración con el grupo local de riders, ofrece un espacio de diversión para todos los aficionados al freestyle"
    ]
