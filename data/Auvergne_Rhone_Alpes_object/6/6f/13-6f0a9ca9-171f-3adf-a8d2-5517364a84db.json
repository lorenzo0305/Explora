  "rdfs:comment": {
    "de": [
      "Sie geht auf den Beginn des 15. Jahrhundert. Die Fassade aus weißem Stein aus dem Mâconnais stammt aus dem 18. Das Mobiliar aus dem 18. Jahrhundert stammt aus dem Kartäuserkloster Montmerle. 13 Gemälde von Brenet und Lagrenée aus dem 18. Jahrhundert. Beherbergt das Grab von General Joubert."
    ],
    "en": [
      "It dates back to the early 15th century. 18th-century façade in white Mâconnais stone. Eighteenth-century furniture from the Chartreuse de Montmerle. 13 18th-century paintings by Brenet and Lagrenée. General Joubert's tomb."
    ],
    "it": [
      "Risale agli inizi del XV secolo. La facciata è in pietra bianca del XVIII secolo, proveniente dalla regione del Mâconnais. I mobili del XVIII secolo provengono dalla Chartreuse de Montmerle. 13 dipinti del XVIII secolo di Brenet e Lagrenée. La tomba del generale Joubert."
    ],
    "fr": [
      "Elle remonte au début du XVe siècle. Façade en pierre blanche du mâconnais du XVIIIe siècle. Le mobilier du XVIIIe siècle provient de la Chartreuse de Montmerle. 13 tableaux de Brenet et Lagrenée du XVIIIe siècle. Abrite la tombe du Général Joubert."
    ],
    "nl": [
      "Het dateert uit het begin van de 15e eeuw. De gevel is van witte steen uit de Mâconnais uit de 18e eeuw. Het 18e-eeuwse meubilair komt uit de Chartreuse de Montmerle. 13 18e-eeuwse schilderijen van Brenet en Lagrenée. Het graf van generaal Joubert."
    ],
    "es": [
      "Data de principios del siglo XV. La fachada es de piedra blanca de Mâconnais del siglo XVIII. El mobiliario del siglo XVIII procede de la Chartreuse de Montmerle. 13 cuadros del siglo XVIII de Brenet y Lagrenée. Tumba del general Joubert."
    ]
  },
  "rdfs:label": {
    "en": [
      "Notre Dame Church"
    ],
    "fr": [
      "Eglise Notre Dame"
    ],
    "nl": [
      "Kerk Notre Dame"
    ]
  },
