  "rdfs:comment": {
    "de": [
      "Padel Tennis Club \r\n9 Außenplätze (5 Grensets und 2 Sandplätze), davon 7 beleuchtet, 2 beleuchtete PADELS.\r\n2 beheizte Hallenplätze im Stade Massot.\r\nTenniskurse und -praktika unter Anleitung eines staatlich geprüften Lehrers"
    ],
    "en": [
      "Tennis Padel Club\r\n9 outdoor courts (5 grensets and 2 clay), 7 of which are lighted, 2 lighted PADELS.\r\n2 heated indoor courts at the Massot Stadium.\r\nTennis lessons and training courses supervised by a state-qualified instructor"
    ],
    "it": [
      "Tennis Padel Club \r\n9 campi all'aperto (5 grenset e 2 campi in terra battuta) di cui 7 illuminati, 2 PADELLE illuminate.\r\n2 campi riscaldati al coperto presso lo stadio Massot.\r\nLezioni e corsi di tennis sotto la supervisione di un istruttore qualificato dallo Stato"
    ],
    "fr": [
      "Club de Tennis Padel : \r\n9 terrains extérieurs (5 grensets et 2 en terre battue) dont 7 éclairés, 2 PADELS éclairées.\r\n2 courts couverts chauffés au stade Massot.\r\nCours et stages de tennis encadrés par un moniteur diplômé d'état"
    ],
    "nl": [
      "Tennis Padel Club \r\n9 buitenbanen (5 grensets en 2 gravelbanen) waarvan 7 verlicht, 2 verlichte PADELS.\r\n2 verwarmde binnenbanen in het Massot stadion.\r\nTennislessen en cursussen onder leiding van een gediplomeerde instructeur"
    ],
    "es": [
      "Club de Pádel de Tenis \r\n9 pistas al aire libre (5 grensets y 2 pistas de tierra batida) de las cuales 7 están iluminadas, 2 PADELES iluminados.\r\n2 pistas cubiertas con calefacción en el estadio de Massot.\r\nClases y cursos de tenis supervisados por un instructor calificado por el estado"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Courts de Tennis Le Puy-en-Velay"
    ]
  },
