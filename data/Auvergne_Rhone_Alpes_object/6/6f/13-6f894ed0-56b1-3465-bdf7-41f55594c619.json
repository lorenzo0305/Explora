          "additionalInformation": {
            "de": [
              "Besichtigung der Produktionsstätte und der Reifekeller dienstags und donnerstags um 11 Uhr in der Sommer- und Wintersaison, Reservierung erforderlich (3?50 Erwachsene, 2? Kinder, unter 5 Jahren kostenlos)."
            ],
            "en": [
              "Visits to the cheese-making workshop and maturing cellars on Tuesdays and Thursdays at 11 a.m. during the summer and winter seasons, booking essential (3?50 adults, 2? children, under 5s free)."
            ],
            "it": [
              "Visite al laboratorio di produzione del formaggio e alle cantine di stagionatura il martedì e il giovedì alle 11.00 durante la stagione estiva e invernale, su prenotazione (3,50 adulti, 2? bambini, sotto i 5 anni gratis)."
            ],
            "fr": [
              "Visites de l'atelier de fabrication et des caves d'affinage les mardis et jeudis à 11h en saison d'été et d'hiver, sur réservation obligatoire (3€50 adulte, 2€ enfant, - 5 ans gratuit)."
            ],
            "es": [
              "Visitas al taller de quesería y a las bodegas de maduración los martes y jueves a las 11 h durante las temporadas de verano e invierno, imprescindible reservar (3,50 ¤ adultos, 2,50 ¤ niños, menores de 5 años gratis)."
            ],
            "nl": [
              "Bezoek aan de kaasmakerij en de rijpingskelders op dinsdag en donderdag om 11 uur tijdens het zomer- en winterseizoen, reserveren noodzakelijk (3,50 volwassenen, 2 kinderen, kinderen onder de 5 jaar gratis)."
            ]
          },
