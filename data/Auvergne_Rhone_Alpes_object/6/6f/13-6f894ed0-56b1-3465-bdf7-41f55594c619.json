  "rdfs:comment": {
    "de": [
      "Im Zentrum des Dorfes gelegen, tägliche handwerkliche Herstellung und Reifung von Savoie-Käse: Abondance AOP, Tomme de Savoie IGP, Raclette de Savoie IGP, frische Butter, Sommerkäse \"Le Pissenlit\", Tommes und Tomettes \"Charlotte\"."
    ],
    "en": [
      "Located in the center of the village, daily artisanal production and refining of Savoie cheeses: Abondance AOP, Tomme de Savoie IGP, Raclette de Savoie IGP, fresh butter, summer cheese “Le Pissenlit”, Tommes and Tomettes “Charlotte”."
    ],
    "it": [
      "Nel centro del paese, produzione artigianale e stagionatura quotidiana di formaggi savoiardi: Abondance DOP, Tomme de Savoie IGP, Raclette de Savoie IGP, burro fresco, formaggio estivo \"Le Pissenlit\", Tommes e Tomettes \"Charlotte\"."
    ],
    "fr": [
      "Située au centre du village, fabrication artisanale quotidienne et affinage de fromages de Savoie : Abondance AOP, Tomme de Savoie IGP, Raclette de Savoie IGP, beurre frais, fromage d’été « Le Pissenlit », Tommes et Tomettes « Charlotte »."
    ],
    "es": [
      "Situado en el centro del pueblo, producción y maduración artesanal diaria de quesos de Saboya: Abondance DOP, Tomme de Savoie IGP, Raclette de Savoie IGP, mantequilla fresca, queso de verano \"Le Pissenlit\", Tommes y Tomettes \"Charlotte\"."
    ],
    "nl": [
      "Gelegen in het centrum van het dorp, dagelijkse ambachtelijke productie en rijping van Savoyse kazen: Abondance BOB, Tomme de Savoie BGA, Raclette de Savoie BGA, verse boter, \"Le Pissenlit\" zomerkaas, \"Charlotte\" Tommes en Tomettes."
    ]
  },
