  "rdfs:comment": {
    "de": [
      "18 km von Entraygues entfernt, Richtung Montsalvy (D920), dann D 19. Besuchen Sie den 30 Hektar großen Tierpark von Ostern bis Allerheiligen auf einem 2 km langen Rundweg, wo Sie rund 200 Damhirsche, Damhirsche und Rehkitze antreffen."
    ],
    "en": [
      "At 18 km from Entraygues, direction Montsalvy (D 920), then D 19."
    ],
    "it": [
      "A 18 km da Entraygues, verso Montsalvy (D920), poi D19. Visitate il parco faunistico di 30 ettari da Pasqua a Ognissanti su un circuito di 2 km dove potrete vedere circa 200 daini, cerve e cerbiatti."
    ],
    "fr": [
      "A 18 km d'Entraygues, direction Montsalvy (D920), puis D 19. Visite découverte du parc animalier de 30 hectares, de Pâques à Toussaint sur un circuit de 2 km où vous cotoyez autour de 200 daims, daines et faons."
    ],
    "es": [
      "A 18 km de Entraygues, dirección Montsalvy (D920), luego D19. Visite el parque faunístico de 30 hectáreas desde Pascua hasta Todos los Santos en un circuito de 2 km donde verá unos 200 gamos, ciervas y cervatillos."
    ],
    "nl": [
      "18 km van Entraygues, richting Montsalvy (D920), daarna D19. Bezoek het wildpark van 30 hectare van Pasen tot Allerheiligen via een circuit van 2 km waar je ongeveer 200 damherten, hinden en reekalfjes kunt zien."
    ]
  },
