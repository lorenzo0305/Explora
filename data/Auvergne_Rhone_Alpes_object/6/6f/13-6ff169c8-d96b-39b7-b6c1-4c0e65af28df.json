  "rdfs:comment": {
    "de": [
      "Sites école du domaine de l'Arselle (Village du Bachat).\r\nFelsriegel, der sich aufgrund seiner engen Ausstattung und des Niveaus der Routen (40 Routen von 3 bis 5c/6a) sehr gut für Anfänger eignet."
    ],
    "en": [
      "Arselle school climbing site (Village du Bachat)\r\nRocky ridge appropriate for beginners thanks to its close holds and its routes level (40 routes from 3 to 5c/6a)"
    ],
    "it": [
      "Siti scolastici del dominio di Arselle (villaggio di Bachat)\r\nUna barra rocciosa che si presta molto bene all'iniziazione grazie alla sua attrezzatura ravvicinata e al livello delle vie (40 vie dal 3 al 5c/6a)."
    ],
    "fr": [
      "Sites école du domaine de l'Arselle (Village du Bachat)\r\nBarre rocheuse qui se prête très bien à l'initiation de par son équipement rapproché et le niveau des voies (40 voies du 3 au 5c/6a)."
    ],
    "nl": [
      "Schoolterreinen van het domein Arselle (dorp Bachat)\r\nEen rotsachtige bar die zich zeer goed leent voor initiatie vanwege de nauwe uitrusting en het niveau van de routes (40 routes van 3 tot 5c/6a)."
    ],
    "es": [
      "Lugares escolares del dominio de Arselle (pueblo de Bachat)\r\nUna barra rocosa que se presta muy bien a la iniciación por su equipamiento cercano y el nivel de las rutas (40 rutas de 3 a 5c/6a)."
    ]
  },
  "rdfs:label": {
