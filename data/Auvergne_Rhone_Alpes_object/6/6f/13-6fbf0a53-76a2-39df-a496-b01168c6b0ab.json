  "rdfs:comment": {
    "de": [
      "Seit 2007 ist dieses 300 m² große Spa eine Referenz für Wellness in Villefranche sur Saône. Hier können Sie unsere Sinnesräume (Spa, Hammam, Sauna) und eine Reihe von Behandlungen und Massagen genießen.\r\nEspace d'O verspricht Ihnen einen Moment, der ganz Ihrem Wohlbefinden gewidmet ist."
    ],
    "en": [
      "A benchmark for well-being in Villefranche sur Saône since 2007, this 300 m² spa welcomes you to enjoy our sensory areas (spa, hammam, sauna) and a range of treatments and massages.\r\nEspace d'O promises a moment dedicated to your well-being."
    ],
    "it": [
      "Punto di riferimento per il benessere a Villefranche sur Saône dal 2007, questo centro benessere di 300 m² vi accoglie per farvi godere dei nostri spazi sensoriali (spa, hammam, sauna) e di una gamma di trattamenti e massaggi.\r\nL'Espace d'O è la promessa di un momento dedicato al vostro benessere."
    ],
    "fr": [
      "Référence du bien-être à Villefranche sur Saône depuis 2007, ce spa de 300 m² vous accueille pour profiter de nos espaces sensoriels (spa, hammam, sauna) et une gamme de soins et massages.\r\nEspace d'O, c'est la promesse d'un moment dédié à votre bien-être."
    ],
    "es": [
      "Referencia del bienestar en Villefranche sur Saône desde 2007, este spa de 300 m² le da la bienvenida para que disfrute de nuestros espacios sensoriales (spa, hammam, sauna) y de una gama de tratamientos y masajes.\r\nEspace d'O es la promesa de un momento dedicado a su bienestar."
    ],
    "nl": [
      "Deze spa van 300 m² is sinds 2007 een referentie op het gebied van welzijn in Villefranche sur Saône en verwelkomt je om te genieten van onze zintuiglijke ruimtes (spa, hammam, sauna) en een reeks behandelingen en massages.\r\nEspace d'O is de belofte van een moment gewijd aan uw welzijn."
    ]
  },
