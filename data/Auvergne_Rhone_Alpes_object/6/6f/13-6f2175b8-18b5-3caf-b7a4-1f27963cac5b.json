  "rdfs:comment": {
    "de": [
      "Die Archäosite Randa Ardesca bietet Ihnen die Möglichkeit, in ein im Bau befindliches gallisches Dorf einzutauchen, das nach den Grundlagen der experimentellen Archäologie und der lebendigen Geschichte rekonstruiert wurde. Einzigartig im südöstlichen Teil Frankreichs."
    ],
    "en": [
      "The Randa Ardesca archaeological site proposes an immersive tour of a Gallic village reconstructed according to the principles of experimental archaeology and living history. Unique in the entire south-eastern quarter of France."
    ],
    "it": [
      "L'archeosito di Randa Ardesca offre un'immersione in un villaggio gallico in costruzione, ricostruito secondo i principi dell'archeologia sperimentale e della living history. Unico nel suo genere nel sud-est della Francia."
    ],
    "fr": [
      "L'archéosite Randa Ardesca vous propose une immersion dans un village gaulois en construction, reconstitué selon les principes de l'archéologie expérimentale et de l'histoire vivante. Unique dans le quart sud-est, de la France."
    ],
    "es": [
      "El arcositio de Randa Ardesca le ofrece una inmersión en un pueblo galo en construcción, reconstruido según los principios de la arqueología experimental y la historia viva. Único en el barrio del sureste de Francia."
    ],
    "nl": [
      "Archeologisch centrum Randa Ardesca biedt een bezoek aan een Gallisch dorp herbouwd volgens de methode van experimentele archeologie en levende geschiedenis. Een voor zuidoost Frankrijk unieke plek."
    ]
  },
