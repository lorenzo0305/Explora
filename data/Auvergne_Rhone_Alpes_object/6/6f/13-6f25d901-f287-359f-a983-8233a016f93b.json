  "rdfs:comment": {
    "de": [
      "Im Herzen der Châtaigneraie Cantalienne, zwischen zwei \"Grands Sites de France\", Conques und dem Puy Mary, genießen Sie ein entspannendes und gastronomisches Erlebnis!"
    ],
    "en": [
      "In the heart of the Châtaigneraie Cantalienne, between two 'Grands Sites de France', Conques and Puy Mary, come and enjoy a relaxing gastronomic experience!\r\n\r\nOn SARUTDAY, 4 OCTOBER, L'Auberge de la Tour celebrates its 15th anniversary! Cocktail bar, cooking demonstrations, champagne sabrage, magic show, concert by Les Wipers."
    ],
    "it": [
      "Nel cuore della Châtaigneraie Cantalienne, tra due Grands Sites de France, Conques e Puy Mary, venite a vivere un'esperienza gastronomica rilassante!"
    ],
    "fr": [
      "Au cœur de la Châtaigneraie Cantalienne, entre deux Grands Sites de France, Conques et le puy Mary, venez profiter d’une expérience gastronomique et relaxante !"
    ],
    "nl": [
      "In het hart van de Châtaigneraie Cantalienne, tussen twee 'Grands Sites de France', Conques en Puy Mary, kom genieten van een ontspannende gastronomische ervaring!\r\n\r\nOp ZATERDAG 4 OKTOBER viert L'Auberge de la Tour zijn 15e verjaardag! Cocktailbar, kookdemonstraties, champagne sabreren, goochelshow, concert van Les Wipers."
    ],
    "es": [
      "En el corazón de la Châtaigneraie Cantalienne, entre dos Grands Sites de France, Conques y Puy Mary, venga a disfrutar de una relajante experiencia gastronómica"
    ]
  },
  "rdfs:label": {
    "en": [
      "Restaurant 1 star \"Auberge de la Tour\""
    ],
    "fr": [
      "Auberge de la Tour - La table étoilée - Restaurant 1 étoile Michelin"
    ],
    "nl": [
      "Restaurant 1 ster \"Auberge de la Tour\""
    ]
  },
