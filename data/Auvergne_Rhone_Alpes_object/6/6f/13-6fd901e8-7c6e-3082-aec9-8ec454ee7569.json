  "rdfs:comment": {
    "de": [
      "Das Festival d'Aurillac: Das 1986 ins Leben gerufene Festival, das bewusst in einer ländlichen Gegend veranstaltet wird, hat sich seither als eine der wichtigsten Veranstaltungen für darstellende Künste in Frankreich etabliert,"
    ],
    "en": [
      "The Aurillac Festival: Created in 1986 and deliberately set in a rural area, the Festival has continued to establish itself as one of France?s leading performing arts events,"
    ],
    "it": [
      "Il Festival di Aurillac: creato nel 1986 e volutamente ambientato in una zona rurale, da allora il Festival ha continuato ad affermarsi come uno dei principali eventi francesi di spettacolo dal vivo,"
    ],
    "fr": [
      "Le Festival d’Aurillac : Créé en 1986 et inscrit volontairement dans un territoire rural, il n’a cessé dès lors de s’imposer comme l’une des principales manifestations de spectacle vivant en France,"
    ],
    "nl": [
      "Het Festival van Aurillac: Het festival werd in 1986 opgericht in een landelijke omgeving en heeft zich sindsdien gevestigd als een van de toonaangevende evenementen voor live optredens in Frankrijk,"
    ],
    "es": [
      "El Festival de Aurillac: creado en 1986 y deliberadamente enclavado en una zona rural, el Festival no ha dejado de consolidarse desde entonces como uno de los principales eventos de espectáculos en vivo de Francia,"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Festival International de Théâtre de Rue d'Aurillac"
    ]
  },
