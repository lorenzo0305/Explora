  "rdfs:comment": {
    "de": [
      "Führender Anbieter von Tandemsprüngen in der Region Auvergne! Wir verabreden uns mit Ihnen im Himmel über Livradois-Forez, einer anderen Art, die Region zu entdecken! Unvergleichliche Eindrücke im Herzen der Monts d'Auvergne mit Blick auf die Kette der Puys."
    ],
    "en": [
      "Tandem jumping leader in the Auvergne region! We invite you to the sky of Livradois-Forez, another way to discover the region! Incomparable sensations in the heart of the Monts d'Auvergne with a view of the Puys chain."
    ],
    "it": [
      "Leader del salto in tandem nella regione dell'Alvernia! Vi invitiamo al cielo di Livradois-Forez, un altro modo per scoprire la regione! Sensazioni incomparabili nel cuore dei Monts d'Auvergne con vista sulla catena del Puys."
    ],
    "fr": [
      "Leader du saut en Tandem dans la région Auvergne ! Nous vous donnons rendez-vous dans le ciel du Livradois-Forez, une autre façon de découvrir la région ! Des sensations incomparables au cœur des Monts d'Auvergne en vue de la chaîne des Puys."
    ],
    "nl": [
      "Tandemsprongleider in de Auvergne! Wij nodigen u uit in de hemel van Livradois-Forez, een andere manier om de regio te ontdekken! Onvergelijkbare sensaties in het hart van de Monts d'Auvergne met uitzicht op de Puys-keten."
    ],
    "es": [
      "Líder en saltos en tándem en la región de Auvernia Le invitamos al cielo de Livradois-Forez, ¡otra forma de descubrir la región! Sensaciones incomparables en el corazón de los Montes de Auvernia con vistas a la cadena de los Puys."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Saut en parachute - Auvergne Parachutisme"
    ]
  },
