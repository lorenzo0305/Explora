  "rdfs:comment": {
    "de": [
      "Das Restaurant la Tarine liegt gegenüber der ESF und bietet eine Sonnenterrasse für eine schnelle Mahlzeit oder um eine Spezialität zu probieren."
    ],
    "en": [
      "La Tarine restaurant, opposite the ski school, offers a sunny terrace for a quick meal or to enjoy a speciality dish."
    ],
    "it": [
      "Il ristorante Tarine, situato di fronte all'ESF, offre una terrazza soleggiata per un pasto veloce o per gustare una specialità."
    ],
    "fr": [
      "Le restaurant la Tarine, situé face à l'ESF, propose une terrasse ensoleillée pour un repas rapide ou pour déguster une spécialité."
    ],
    "nl": [
      "Het restaurant la Tarine, gelegen tegenover de ESF (skischool), beschikt over een zonovergoten terras voor een korte maaltijd of om een specialiteit te proeven."
    ],
    "es": [
      "El restaurante Tarine, situado frente al FSE, ofrece una soleada terraza para una comida rápida o para disfrutar de una especialidad."
