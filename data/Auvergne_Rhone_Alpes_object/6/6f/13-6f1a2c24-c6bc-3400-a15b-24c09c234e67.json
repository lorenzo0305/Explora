  "rdfs:comment": {
    "de": [
      "Im Zentrum des Weilers Balmont erhebt sich die Kirche Notre-Dame de l'Assomption mit ihrem Glockenturm aus der ländlichen Landschaft dieses Teils der Gemeinde Seynod. Die ab 1867 wiederaufgebaute Kirche nimmt die neogotische Architektur an."
    ],
    "en": [
      "In the centre of the hamlet of Balmont, the church of Notre-Dame de l'Assomption stands with its bell tower in the rural landscape of this part of the commune of Seynod. Rebuilt from 1867, this church adopts the neo-gothic architecture."
    ],
    "it": [
      "Nel centro della frazione di Balmont, la chiesa di Notre-Dame de l'Assomption si erge con il suo campanile nel paesaggio rurale di questa parte del comune di Seynod. Ricostruita nel 1867, questa chiesa adotta un'architettura neogotica."
    ],
    "fr": [
      "Au centre du hameau de Balmont, l'église Notre-Dame de l'Assomption dresse son clocher dans le paysage rural de cette partie de la commune de Seynod. Reconstruite à partir de 1867, cette église adopte l'architecture néogothique."
    ],
    "nl": [
      "In het centrum van het gehucht Balmont staat de kerk Notre-Dame de l'Assomption met haar klokkentoren in het landelijke landschap van dit deel van de gemeente Seynod. Deze kerk, herbouwd in 1867, heeft een neogotische architectuur."
    ],
    "es": [
      "En el centro de la aldea de Balmont, la iglesia de Notre-Dame de l'Assomption se alza con su campanario en el paisaje rural de esta parte del municipio de Seynod. Reconstruida a partir de 1867, esta iglesia adopta la arquitectura neogótica."
    ]
  },
