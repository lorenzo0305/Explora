  "rdfs:comment": {
    "de": [
      "In seiner Werkstatt arbeitet Ludovic Picard mit Holz, oft mit Abfallholz: Holzspiele, Palettenmöbel, kleine Gegenstände, Drechselarbeiten, Leuchten, Möbel... Entdecken Sie die Werkstatt und/oder nehmen Sie an einem Schnupper- oder Kreativkurs teil."
    ],
    "en": [
      "In his workshop, Ludovic Picard works with wood, often reclaimed wood: wooden games, pallet furniture, small objects, turning, lighting, furniture... Discover the workshop and/or take part in a discovery or creation workshop."
    ],
    "it": [
      "Nel suo laboratorio, Ludovic Picard lavora con il legno, spesso di recupero: giochi in legno, mobili in pallet, piccoli oggetti, tornitura, illuminazione, mobili... Scoprite il laboratorio e/o partecipate a un corso di scoperta o di creazione."
    ],
    "fr": [
      "Dans son atelier, Ludovic Picard travaille le bois, souvent du bois de récupération : jeux en bois, meubles en palettes, petits objets, tournage, luminaires, mobilier... Découvrez l'atelier et/ou participez à un stage de découverte ou de création."
    ],
    "nl": [
      "In zijn atelier werkt Ludovic Picard met hout, vaak teruggewonnen hout: houten spellen, palletmeubelen, kleine voorwerpen, draaiwerk, verlichting, meubels... Ontdek het atelier en/of neem deel aan een ontdekkings- of creatiecursus."
    ],
    "es": [
      "En su taller, Ludovic Picard trabaja la madera, a menudo recuperada: juegos de madera, muebles de palets, pequeños objetos, torneado, iluminación, mobiliario... Descubra el taller y/o participe en un curso de descubrimiento o creación."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Atelier Bois d'oublis - Ludovic Picard"
    ]
  },
