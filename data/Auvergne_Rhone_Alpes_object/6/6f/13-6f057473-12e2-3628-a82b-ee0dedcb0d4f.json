  "rdfs:comment": {
    "de": [
      "Kleiner Familienbetrieb in einem Weiler neben den Türmen von Chignin und gegenüber den Belledonnes. Der Geist des Weinguts besteht darin, ein Betrieb mit menschlicher Größe zu bleiben, der das erhaltene Terroir und seine Umgebung respektiert."
    ],
    "en": [
      "Small, family-run winery located in a hamlet next to the Chignin towers and facing the Belledonnes mountains. The spirit of the domaine is to remain a human-scale operation, respectful of the terroir and its environment."
    ],
    "it": [
      "Piccola tenuta a conduzione familiare situata in un borgo vicino alle torri di Chignin e di fronte alle montagne di Belledonnes. Lo spirito della tenuta è quello di rimanere un'operazione a misura d'uomo, rispettosa del terroir e dell'ambiente."
    ],
    "fr": [
      "Petite exploitation familiale située dans un hameau à coté des tours de Chignin et face aux Belledonnes. L'esprit du domaine est de rester une exploitation à taille humaine, respectueuse du terroir reçu et de son environnement."
    ],
    "es": [
      "Pequeña explotación familiar situada en una aldea junto a las torres de Chignin y frente a los montes Belledonnes. El espíritu de la finca es seguir siendo una explotación a escala humana, respetuosa con el terruño y su entorno."
    ],
    "nl": [
      "Klein familiedomein gelegen in een gehucht naast de torens van Chignin en tegenover de bergen van Belledonnes. De geest van het domein is om een bedrijf op menselijke schaal te blijven, met respect voor het terroir en zijn omgeving."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Domaine Pascal, Annick et Noé Quenard"
    ]
  },
