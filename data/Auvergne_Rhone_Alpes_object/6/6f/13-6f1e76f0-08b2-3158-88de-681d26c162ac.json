  "rdfs:comment": {
    "de": [
      "Magalie und David empfangen Sie in einem warmen und raffinierten Dekor. Die Auberge des Vignerons befindet sich im Herzen der Weinberge in einem kleinen Dorf zwischen Juliénas und Fleurie. Kommen Sie und entdecken Sie eine unserer Spezialitäten: den flambierten Fleischgalgen!"
    ],
    "en": [
      "Magalie and David welcome you in a warm and refined decor. L'Auberge des Vignerons is located in the heart of the vineyards in a small village between Juliénas and Fleurie. Come and discover one of our specialities: the gallows of flambéed meat!"
    ],
    "it": [
      "Magalie e David vi accolgono in un ambiente caldo e raffinato. L'Auberge des Vignerons si trova nel cuore dei vigneti, in un piccolo villaggio tra Juliénas e Fleurie. Venite a scoprire una delle nostre specialità: lo stufato di carne fiammeggiato!"
    ],
    "fr": [
      "Magalie et David vous accueillent dans un décor chaleureux et raffiné. L'Auberge des Vignerons se trouve au coeur des vignes dans un petit village entre Juliénas et Fleurie. Venez découvrir une de nos spécialités : la potence de viande flambée !"
    ],
    "es": [
      "Magalie y David le dan la bienvenida en un ambiente cálido y refinado. El Auberge des Vignerons está situado en el corazón de los viñedos, en un pequeño pueblo entre Juliénas y Fleurie. Venga a descubrir una de nuestras especialidades: ¡el guiso de carne flambeado!"
    ],
    "nl": [
      "Magalie en David verwelkomen u in een warme en verfijnde omgeving. De Auberge des Vignerons ligt in het hart van de wijngaarden in een klein dorpje tussen Juliénas en Fleurie. Kom en ontdek een van onze specialiteiten: de geflambeerde vleesstoofpot!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Auberge des Vignerons"
    ]
  },
