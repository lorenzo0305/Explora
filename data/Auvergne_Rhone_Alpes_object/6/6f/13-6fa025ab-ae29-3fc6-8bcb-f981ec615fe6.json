  "rdfs:comment": {
    "de": [
      "Im Becken des Lac du Bourget wird Sie der Fluss Tillet mit seinem Charme und seinen hübschen Fischen begeistern."
    ],
    "en": [
      "On the Lac du Bourget basin, the Tillet will delight you with its charm and its pretty fish."
    ],
    "it": [
      "Sul bacino del Lac du Bourget, il Tillet vi delizierà con il suo fascino e i suoi bei pesci."
    ],
    "fr": [
      "Sur le bassin du Lac du Bourget, le Tillet vous ravira par son charme et ses jolis poissons."
    ],
    "nl": [
      "In het stroomgebied van het Lac du Bourget zal de Tillet u bekoren met zijn charme en zijn mooie vissen."
    ],
    "es": [
      "En la cuenca del Lac du Bourget, el Tillet le deleitará con su encanto y sus bonitos peces."
    ]
  },
