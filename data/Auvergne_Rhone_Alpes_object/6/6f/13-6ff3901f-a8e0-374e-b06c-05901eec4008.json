  "rdfs:comment": {
    "de": [
      "Handwerkliche Bäckerei und Konditorei, die alle ihre Brote, Gebäcke und Konditoreiwaren in ihren Räumlichkeiten herstellt.\r\nSie bietet auch Dot-Sandwiches und andere Snacks an.\r\nVerkauf nur zum Mitnehmen."
    ],
    "en": [
      "Home made baking and pastry, and also snackings and Diot sandwiches.\r\nTakeaway only."
    ],
    "it": [
      "Una panetteria e pasticceria tradizionale che produce tutti i suoi pani, dolci e torte in loco.\r\nOffre anche panini e altri spuntini.\r\nSolo da asporto."
    ],
    "fr": [
      "Boulangerie pâtisserie artisanale qui réalise la fabrication de tous ses pains, viennoiseries et pâtisseries dans ses locaux.\r\nElle propose également des sandwich aux diots et d'autres snacks.\r\nVente à emporter uniquement."
    ],
    "es": [
      "Una panadería y pastelería tradicional que elabora todos sus panes, pasteles y tartas en sus instalaciones.\r\nTambién ofrece sándwiches diot y otros aperitivos.\r\nSólo para llevar."
    ],
    "nl": [
      "Een traditionele bakkerij en banketbakkerij die alle broden, gebak en taarten ter plaatse maakt.\r\nHet biedt ook diot broodjes en andere snacks.\r\nAlleen afhaalmaaltijden."
    ]
  },
  "rdfs:label": {
    "en": [
      "Le Relais du Pain"
    ],
