  "rdfs:comment": {
    "de": [
      "Im Herzen des Kurortes entdecken Sie das Hotel Helvie, ein Konzentrat aus Wellness und Gastronomie in einer wunderschönen Umgebung. Das Hotel ist das ganze Jahr über geöffnet und verbindet Ihren Aufenthalt mit Gelassenheit, Natur und Entspannung."
    ],
    "en": [
      "In the heart of the spa, discover the Hotel Helvie, a concentrate of well-being and gastronomy in a superb setting. Open all year round, your stay here will be one of serenity, nature and relaxation."
    ],
    "it": [
      "Nel cuore della città termale, scoprite l'Hôtel Helvie, un concentrato di benessere a pochi metri dal parco cittadino e dalla spa Sequoia Redwood. Aperto tutto l'anno, il vostro soggiorno qui sarà all'insegna della serenità, della natura e del relax."
    ],
    "fr": [
      "Au cœur de la station thermale, découvrez l'hôtel Helvie, un concentré de bien-être à quelques mètres du parc de la ville et du spa Sequoia Redwood. Ouvert à l'année, il fait rimer votre séjour avec sérénité, nature et détente."
    ],
    "nl": [
      "Ontdek in het hart van het kuuroord Hotel Helvie, een concentraat van welzijn en gastronomie in een schitterende omgeving. Het hele jaar geopend, uw verblijf zal er een zijn van sereniteit, natuur en ontspanning."
    ],
    "es": [
      "En el corazón de la ciudad termal, descubra el Hôtel Helvie, un concentrado de bienestar a pocos metros del parque de la ciudad y del spa Sequoia Redwood. Abierto todo el año, su estancia aquí será un momento de serenidad, naturaleza y relajación."
    ]
  },
