  "rdfs:comment": {
    "de": [
      "Im geheimen Wald des Widbier empfängt Alice unter den Jahrhundertbäumen die Familientradition. Das Inn Malaterre behält seine bäuerliche und verführerische Identität."
    ],
    "en": [
      "In the secret of the forest of Alloubière, among the hundred-year-old trees, Alice welcomes you and perpetuates the family tradition. The Auberge de Malaterre keeps its peasant and bewitching identity."
    ],
    "it": [
      "Nel segreto della foresta di Alloubière, tra gli alberi centenari, Alice vi accoglie e perpetua la tradizione di famiglia. L'Auberge de Malaterre conserva la sua ammaliante identità di campagna."
    ],
    "fr": [
      "Au secret de la forêt de l’Alloubière, parmi les arbres centenaires, Alice vous reçoit et perpétue la tradition familiale. L’Auberge de Malaterre garde son identité paysanne et ensorcelante."
    ],
    "nl": [
      "In het geheim van het bos van Alloubière, tussen de honderdjarige bomen, ontvangt Alice u en zet de familietraditie voort. De Auberge de Malaterre behoudt zijn betoverende landelijke identiteit."
    ],
    "es": [
      "En el secreto del bosque de Alloubière, entre árboles centenarios, Alice le da la bienvenida y perpetúa la tradición familiar. El Auberge de Malaterre conserva su encantadora identidad campestre."
    ]
  },
