  "rdfs:comment": {
    "de": [
      "Die neuere Bezeichnung \"Schleuseninsel\" hält die Erinnerung an die handwerklichen und industriellen Aktivitäten wach, die sich vom 18. Jahrhundert bis in die 1930er Jahre abwechselten."
    ],
    "en": [
      "The recent name of \"Ile aux vannes\" maintains the memory of the artisanal and industrial activities that took place from the 18th century to the 1930s."
    ],
    "it": [
      "Il recente nome di \"Ile aux vannes\" (Isola delle valvole) mantiene la memoria delle attività artigianali e industriali che si sono svolte dal XVIII secolo agli anni Trenta."
    ],
    "fr": [
      "L'appellation récente d'\"île aux vannes \" maintient la mémoire des activités artisanales et industrielles qui se sont succédé du 18e siècle aux années 1930."
    ],
    "es": [
      "El reciente nombre de \"Ile aux vannes\" (Isla de las Válvulas) mantiene el recuerdo de las actividades artesanales e industriales que se desarrollaron desde el siglo XVIII hasta la década de 1930."
    ],
    "nl": [
      "De recente naam \"Ile aux vannes\" (eiland van kleppen) houdt de herinnering in stand aan de ambachtelijke en industriële activiteiten die plaatsvonden van de 18e eeuw tot de jaren 1930."
    ]
  },
