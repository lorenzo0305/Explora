  "rdfs:comment": {
    "de": [
      "Die Ferme du Champ Rouge ist ein Animationsbauernhof. Sie bietet verschiedene Aktivitäten wie Balad'Alpagas, den Workshop \"Kleiner Bauer\", Geburtstage auf dem Bauernhof, ein Escape Game, Tiervermittlung und Reitaktivitäten."
    ],
    "en": [
      "La ferme du Champ Rouge is an animated farm. It offers a range of activities including Balad'Alpagas, the \"little farmer\" workshop, birthday parties on the farm, an escape game, animal mediation and equestrian activities."
    ],
    "it": [
      "La fattoria Champ Rouge è una fattoria didattica. Offre una serie di attività tra cui il Balad'Alpagas, il laboratorio del \"piccolo contadino\", feste di compleanno in fattoria, un gioco di fuga, la mediazione animale e le attività equestri."
    ],
    "fr": [
      "La ferme du Champ Rouge est une ferme d'animation. Elle propose divers activités telles que la Balad'Alpagas, l'atelier \"petit fermier\", des anniversaires à la ferme, un escape game, de la médiation animale ainsi que des activités équestres."
    ],
    "es": [
      "La granja Champ Rouge es una granja de actividades. Ofrece diversas actividades, como las Balad'Alpagas, el taller del \"pequeño granjero\", fiestas de cumpleaños en la granja, un juego de escape, mediación con animales y actividades ecuestres."
    ],
    "nl": [
      "De boerderij Champ Rouge is een activiteitenboerderij. Het biedt een scala aan activiteiten, waaronder de Balad'Alpagas, de \"kleine boer\" workshop, verjaardagsfeestjes op de boerderij, een ontsnappingsspel, dierenbemiddeling en ruiteractiviteiten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Ferme pédagogique du Champ Rouge"
    ]
  },
