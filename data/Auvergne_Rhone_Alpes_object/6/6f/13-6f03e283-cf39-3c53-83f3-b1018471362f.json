  "rdfs:comment": {
    "de": [
      "Als Verantwortliche für den botanischen Garten des Alten Klosters und als Produzentin und Sammlerin von Heilpflanzen stelle ich auf dem Gelände Produkte auf Pflanzenbasis her. Ich biete Workshops an, um Sie in die Geheimnisse der Pflanzen unserer Region einzuführen."
    ],
    "en": [
      "Responsible for the botanical garden at the Ancien-Monastère, I grow and collect medicinal plants and produce herbal products on site. I offer workshops to introduce you to the secrets of our region's plants."
    ],
    "it": [
      "Responsabile del giardino botanico dell'Ancien-Monastère, produco e raccolgo piante medicinali e produco prodotti erboristici sul sito. Offro laboratori per farvi conoscere i segreti delle piante della nostra regione."
    ],
    "fr": [
      "Responsable du jardin botanique de l’Ancien-Monastère, productrice et cueilleuse de plantes médicinales, je produis sur le site des produits à base de plantes. Je propose des ateliers pour vous initier aux secrets des plantes de notre région."
    ],
    "nl": [
      "Ik ben verantwoordelijk voor de botanische tuin van het Ancien-Monastère en ik kweek en verzamel geneeskrachtige planten en produceer producten op basis van planten op de site. Ik geef workshops om de geheimen van de planten uit onze streek te leren kennen."
    ],
    "es": [
      "Encargado del jardín botánico del Ancien-Monastère, produzco y recojo plantas medicinales y elaboro productos de herboristería en el lugar. Ofrezco talleres para dar a conocer los secretos de las plantas de nuestra región."
    ]
  },
  "rdfs:label": {
    "de": [
      "Lise-May Viment - Entdeckung von Pflanzen und Naturheilkunde"
    ],
    "en": [
      "Lise-May Viment - Discovering plants and naturopathy"
    ],
    "fr": [
      "Lise-May Viment - Découverte des plantes et naturopathie"
    ],
    "nl": [
      "Lise-May Viment - Ontdekking van planten en natuurgeneeskunde"
    ]
  },
