  "rdfs:comment": {
    "de": [
      "Kinderspielplatz neben der Kirche Saint-Jean-Baptiste.\r\nMehrere Spiele mit Rutschen, Federspielgeräten, Picknicktischen und Bänken."
    ],
    "en": [
      "Children's play area next to the Saint-Jean-Baptiste church.\r\nMulti-games with slides, spring-loaded games, picnic tables and benches."
    ],
    "it": [
      "Area giochi per bambini accanto alla chiesa Saint-Jean-Baptiste.\r\nCi sono giochi multipli con scivoli, giochi a molla, tavoli da picnic e panchine."
    ],
    "fr": [
      "Aire de jeux pour enfant à côté de l'église Saint-Jean-Baptiste. \r\nPrésence de multi-jeux avec toboggans, jeu à ressort. tables de pique-nique et bancs."
    ],
    "es": [
      "Zona de juegos infantiles junto a la iglesia Saint-Jean-Baptiste.\r\nHay multijuegos con toboganes, juegos de muelles, mesas de picnic y bancos."
    ],
    "nl": [
      "Kinderspeeltuin naast de kerk Saint-Jean-Baptiste.\r\nEr zijn multi-games met glijbanen, verende spellen, picknicktafels en bankjes."
    ]
