          "additionalInformation": {
            "de": [
              "Verkauf auf dem Bauernhof von 17:30 bis 19:00 Uhr, montags bis freitags.\r\nOnline-Bestellungen auf der Website, mit Abholung vor Ort zu den Verkaufszeiten auf dem Bauernhof.\r\nMittwochs bis 18 Uhr online bestellen."
            ],
            "en": [
              "Sale at the farm from 5:30 to 7:00 pm from Monday to Friday.\r\nOnline orders on the website, with pick-up at the farm during the sales hours.\r\nOnline ordering until 6pm on Wednesdays."
            ],
            "it": [
              "Vendita in azienda dalle 17.30 alle 19.00 dal lunedì al venerdì.\r\nOrdini online sul sito, con ritiro in azienda durante gli orari di vendita.\r\nOrdini online fino alle 18:00 il mercoledì."
            ],
            "fr": [
              "Vente à la ferme de 17 h 30 à 19 h du lundi au vendredi.\r\nCommandes en ligne sur le site internet, avec retrait sur place aux horaires de vente à la ferme.\r\nCommander en ligne jusqu'à 18h le mercredi."
            ],
            "nl": [
              "Verkoop op de boerderij van 17.30 tot 19.00 uur van maandag tot vrijdag.\r\nOnline bestellingen op de website, met afhalen op de boerderij tijdens de verkoopuren.\r\nOnline bestellen tot 18.00 uur op woensdag."
            ],
            "es": [
              "Venta en la granja de 17:30 a 19:00 de lunes a viernes.\r\nPedidos en línea en el sitio web, con recogida en la granja durante el horario de venta.\r\nPedidos en línea hasta las 18:00 horas los miércoles."
            ]
          },
