  "rdfs:comment": {
    "de": [
      "In Eurre, im Tal der Drôme, auf der Spitze eines Hügels und mitten im Wald, gedeiht unser Bauernhof. Seit der Gründung im Jahr 2013 züchten wir Ziegen und Schweine."
    ],
    "en": [
      "It's in Eurre, in the Drôme valley, at the top of a hill and in the middle of the forest, that our farm flourishes. Since its creation in 2013, we've been raising goats and pigs."
    ],
    "it": [
      "È a Eurre, nella valle della Drôme, in cima a una collina e in mezzo alla foresta, che fiorisce la nostra azienda agricola. Dalla sua creazione nel 2013, alleviamo capre e maiali."
    ],
    "fr": [
      "C’est à Eurre, dans la vallée de la Drôme, à la cime d’une colline et au milieu de la forêt, que notre ferme s’épanouit. Depuis sa création en 2013, nous élevons des chèvres et des cochons."
    ],
    "nl": [
      "Het is in Eurre, in de Drôme vallei, op de top van een heuvel en midden in het bos, dat onze boerderij floreert. Sinds de oprichting in 2013 houden we geiten en varkens."
    ],
    "es": [
      "Es en Eurre, en el valle de la Drôme, en lo alto de una colina y en medio del bosque, donde florece nuestra granja. Desde su creación en 2013, criamos cabras y cerdos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Ferme Eurreuse"
    ]
  },
