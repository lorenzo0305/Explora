  "rdfs:comment": {
    "de": [
      "Das Restaurant Le Stou befindet sich im Sport- und Freizeitzentrum von Vaujany. Sie werden eine angenehme Zeit in dem modernen, mit Holz und Stein verkleideten Speisesaal mit einem schönen Kamin oder auf der großen Terrasse verbringen."
    ],
    "en": [
      "The Stou restaurant is located in the heart of the Vaujany Sports & Leisure Centre. You will have a pleasant time in the modern dining room, dressed in wood and stone with a beautiful fireplace."
    ],
    "it": [
      "Il ristorante Le Stou si trova nel cuore del Centro sportivo e ricreativo di Vaujany. Potrete divertirvi nella moderna sala da pranzo, decorata in legno e pietra con un bel camino, o sulla vasta terrazza."
    ],
    "fr": [
      "Le restaurant le Stou est située au sein du Pôle Sports & Loisirs de Vaujany. Vous passerez un moment agréable dans la salle de restauration moderne, habillée de bois et de pierres avec une belle cheminée, ou sur la vaste terrasse."
    ],
    "nl": [
      "Restaurant Le Stou is gelegen in het sport- en ontspanningscentrum van Vaujany.  Hier kunt u genieten van een heerlijke maaltijd in een aangename sfeer.  Het restaurant is modern ingericht met hout en steen en heeft een mooie open haard en een groot terras."
    ],
    "es": [
      "El restaurante Le Stou está situado en el corazón del Centro Deportivo y de Ocio de Vaujany. Lo pasarás en grande en el moderno comedor, decorado en madera y piedra con una hermosa chimenea, o en la amplia terraza."
    ]
  },
