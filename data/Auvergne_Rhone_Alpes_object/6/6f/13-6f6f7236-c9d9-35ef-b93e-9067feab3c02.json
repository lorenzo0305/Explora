  "rdfs:comment": {
    "de": [
      "Kompakter 9-Loch-Golfplatz mit 1282 m Par 29. Schneller und technischer Parcours in einer angenehmen und ruhigen Umgebung. Die Löcher sind 52 bis 301 m lang. Große Driving Range mit einer Länge von 280 m. Unabhängiger Pro auf dem Platz. Grill und Bar vor Ort 7/7."
    ],
    "en": [
      "Compact 9-hole golf course, 1282m par 29. A fast, technical course in pleasant, peaceful surroundings. Holes range from 52 to 301m. Large 280m driving range. Independent pro on site. Grill and bar on site 7/7."
    ],
    "it": [
      "Campo da golf compatto a 9 buche, 1282 m par 29. Un percorso veloce e tecnico in un ambiente piacevole e tranquillo. Buche da 52 a 301 m. Ampio campo pratica lungo 280 m. Professionista indipendente in loco. Grill bar e mini-golf in loco 7/7."
    ],
    "fr": [
      "Golf 9 trous compacts de 1282m par 29. Parcours rapide et technique dans un cadre agréable et calme. Les trous sont de 52 à 301 m. Grand Practice de 280m de long. Pro indépendant sur place. Le grill bar et mini-golf sur place 7/7."
    ],
    "nl": [
      "Compacte 9-holes golfbaan, 1282 m par 29. Een snelle, technische baan in een aangename, rustige omgeving. Gaten van 52 tot 301 m. Grote driving range van 280 m lang. Onafhankelijke pro ter plaatse. Grill en bar ter plaatse 7/7."
    ],
    "es": [
      "Campo de golf compacto de 9 hoyos, 1282m par 29. Un recorrido rápido y técnico en un entorno agradable y tranquilo. Hoyos de 52 a 301 m. Gran campo de prácticas de 280 m de longitud. Profesional independiente in situ. Grill bar y minigolf in situ 7/7."
    ]
  },
