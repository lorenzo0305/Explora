  "rdfs:comment": {
    "de": [
      "In Meillerie wurde im Mittelalter von den Regularkanonikern des Heiligen Augustinus ein Priorat gegründet, das vom Hospiz des Großen Sankt Bernhards abhängig war. Die Anlage ist denkmalgeschützt."
    ],
    "en": [
      "In Meillerie, a priory was founded in the Middle Ages by the Canons Regular of Saint Augustine, under the auspices of the Grand Saint-Bernard hospice. The site is protected as a historic monument."
    ],
    "it": [
      "A Meillerie, un priorato fu fondato nel Medioevo dai Canonici Regolari di Sant'Agostino, come parte dell'ospizio del Grand Saint-Bernard. Il sito è protetto come monumento storico."
    ],
    "fr": [
      "À Meillerie, un prieuré a été fondé au Moyen Âge par les chanoines réguliers de saint Augustin, dépendant de l’hospice du Grand Saint-Bernard. Le site est protégé au titre des monuments historiques."
    ],
    "nl": [
      "In Meillerie werd in de Middeleeuwen een priorij gesticht door de reguliere kanunniken van Saint-Augustine, als onderdeel van het Grand Saint-Bernard hospice. De site is beschermd als historisch monument."
    ],
    "es": [
      "En Meillerie, un priorato fue fundado en la Edad Media por los canónigos regulares de San Agustín, como parte del hospicio Grand Saint-Bernard. El lugar está protegido como monumento histórico."
    ]
  },
