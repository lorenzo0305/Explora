  "rdfs:comment": {
    "de": [
      "Der Wald von Marsanne, mehr als 1100 ha Gemeindefläche, ist einer der ältesten Gemeindewälder Frankreichs. Er ist bekannt für seine wilden Maiglöckchen, Osterglocken und seine zahlreichen Wanderwege."
    ],
    "en": [
      "The Marsanne forest, covering over 1100 hectares, is one of the oldest communal forests in France. It is renowned for its wild lily of the valley, daffodils and numerous hiking trails."
    ],
    "it": [
      "La foresta di Marsanne, con oltre 1100 ettari di terreno comunale, è una delle più antiche foreste comunali di Francia. È rinomata per i suoi mughetti selvatici, i suoi narcisi e i suoi numerosi sentieri escursionistici."
    ],
    "fr": [
      "La forêt de Marsanne, plus de 1100 ha communaux, est une des plus anciennes forêts communales de France. Elle est réputée pour son muguet sauvage, ses jonquilles et ses nombreux chemins de randonnée."
    ],
    "nl": [
      "Het bos van Marsanne, dat meer dan 1100 hectare beslaat, is een van de oudste gemeentelijke bossen van Frankrijk. Het staat bekend om zijn wilde lelietjes-van-dalen, narcissen en talloze wandelpaden."
    ],
    "es": [
      "El bosque de Marsanne, con más de 1100 hectáreas de terreno comunal, es uno de los bosques comunales más antiguos de Francia. Es conocida por su lirio silvestre del valle, sus narcisos y sus numerosas rutas de senderismo."
    ]
  },
  "rdfs:label": {
