  "rdfs:comment": {
    "de": [
      "Ali und sein Team befinden sich in Lormaison, im Süden des Departements Oise, und empfangen Sie in einem raffinierten Ambiente mit geschmackvoller traditioneller Dekoration. Die Atmosphäre ist gleichzeitig raffiniert und authentisch mit schönen Kaminflammen im Herzen des Winters."
    ],
    "en": [
      "Located in Lormaison, in the south of the Oise region, Ali and his team welcome you in a refined atmosphere with tasteful traditional decor. The ambience is both refined and authentic, with beautiful chimney flames in the heart of winter."
    ],
    "it": [
      "Situato a Lormaison, nel sud del dipartimento dell'Oise, Ali e il suo team vi accolgono in un ambiente raffinato con un arredamento tradizionale di buon gusto. L'atmosfera è al tempo stesso raffinata e autentica, con accoglienti caminetti nel cuore dell'inverno."
    ],
    "fr": [
      "Situés à Lormaison, au Sud de l'Oise, Ali et son équipe vous accueillent dans une ambiance raffinée avec une décoration traditionnelle de bon goût. L'ambiance est à la fois raffinée et authentique avec de belles flambées de cheminées au cœur de l'hiver."
    ],
    "es": [
      "Situado en Lormaison, en el sur del departamento de Oise, Ali y su equipo le dan la bienvenida en un ambiente refinado con una decoración tradicional de buen gusto. El ambiente es a la vez refinado y auténtico, con acogedoras chimeneas en pleno invierno."
    ],
    "nl": [
      "Ali en zijn team verwelkomen je in Lormaison, in het zuiden van het departement Oise, in een verfijnde sfeer met een smaakvolle traditionele inrichting. De sfeer is zowel verfijnd als authentiek, met gezellige open haarden in het hart van de winter."
    ]
  },
  "rdfs:label": {
