  "rdfs:comment": {
    "de": [
      "Entdecken Sie Central Pizza im Herzen des Dorfes. Diese Pizzeria bietet leckere Schnellgerichte und eine große Auswahl an hausgemachten Pizzen zum Mitnehmen. Ein Muss für alle Liebhaber von leckeren und authentischen Pizzen!"
    ],
    "en": [
      "Discover Central Pizza in the heart of the village. This pizzeria offers tasty fast food and a wide choice of homemade pizzas to take away. A must for all lovers of authentic, gourmet pizzas!"
    ],
    "it": [
      "Scoprite Central Pizza nel cuore del paese, una pizzeria che offre gustosi fast food e un'ampia scelta di pizze fatte in casa da asporto. Un must per tutti gli amanti dell'autentica pizza gourmet!"
    ],
    "fr": [
      "Découvrez Central Pizza au cœur du village, cette pizzeria offre une restauration rapide savoureuse, un grand choix de pizzas faites maison, à emporter. Un lieu incontournable pour tous les amateurs de pizzas gourmandes et authentiques !"
    ],
    "nl": [
      "Ontdek Central Pizza in het hart van het dorp. Deze pizzeria biedt smakelijke fastfood en een ruime keuze aan zelfgemaakte pizza's om mee te nemen. Een must voor alle liefhebbers van authentieke gourmetpizza's!"
    ],
    "es": [
      "Descubra Central Pizza en el corazón del pueblo. Esta pizzería ofrece sabrosa comida rápida y una amplia selección de pizzas caseras para llevar. Una visita obligada para todos los amantes de las auténticas pizzas gourmet"
    ]
  },
