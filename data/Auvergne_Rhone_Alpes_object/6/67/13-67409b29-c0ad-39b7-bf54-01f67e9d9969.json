  "rdfs:comment": {
    "de": [
      "Haus aus lokalem Stein mit Schieferdach und Inneneinrichtung mit reinem auvergnatischen Charme... ein unumgänglicher Halt auf den Wanderwegen des Puy Mary... eine auvergnatische und traditionelle Küche..."
    ],
    "en": [
      "Nearby paths are good for walking, or climbing the Puy Mary.\r\nRegional cooking."
    ],
    "it": [
      "Una casa in pietra con tetto in ardesia e interni caldi e puramente Auvergnat... una tappa obbligata sui sentieri del Puy Mary... cucina tradizionale Auvergnat..."
    ],
    "fr": [
      "Maison en pierre de pays avec couverture en lauzes et intérieur au charme chaleureux purement auvergnat... une étape incontournable sur les chemins de randonnée du Puy Mary... une cuisine auvergnate et traditionnelle..."
    ],
    "es": [
      "Una casa de piedra con tejado de pizarra y un interior cálido y puramente auvernés... visita obligada en las rutas de senderismo del Puy Mary... cocina tradicional auvernesa..."
    ],
    "nl": [
      "Een stenen huis met een leistenen dak en een warm, puur Auvergnat interieur... een must op de Puy Mary wandelpaden... traditionele Auvergnat keuken..."
    ]
  },
  "rdfs:label": {
