  "rdfs:comment": {
    "de": [
      "Dieser pädagogische Bauernhof, der auf einer Kamelidenzucht basiert, liegt im Herzen des regionalen Naturparks Pilat. Entdecken Sie unsere Tiere mit Höckern, Federn oder Haaren und genießen Sie einen angenehmen Moment auf der Terrasse unserer Guinguette."
    ],
    "en": [
      "An educational farm based on camelid breeding, nestled in the heart of the Pilat regional nature park, come and discover our humpbacked, feathered and furry animals and enjoy a pleasant moment on the terrace of our guinguette."
    ],
    "it": [
      "Una fattoria didattica basata sull'allevamento di camelidi, immersa nel cuore del parco naturale regionale del Pilat. Venite a scoprire i nostri animali gobbi, piumati e pelosi e godetevi un momento piacevole sulla terrazza della nostra guinguette."
    ],
    "fr": [
      "Ferme pédagogique basée sur un élevage de camélidés, niché au cœur du parc naturel régional du Pilat venez découvrir nos animaux à bosses, à plumes ou à poil et profiter d'un agréable moment sur la terrasse de notre guinguette."
    ],
    "es": [
      "Una granja educativa basada en la cría de camélidos, enclavada en el corazón del parque natural regional del Pilat. Venga a descubrir nuestros animales jorobados, emplumados y peludos y disfrute de un agradable momento en la terraza de nuestra guinguette."
    ],
    "nl": [
      "Een educatieve boerderij gebaseerd op het fokken van kameelachtigen, genesteld in het hart van het regionale natuurpark Pilat. Kom onze bultige, gevederde en harige dieren ontdekken en geniet van een aangenaam moment op het terras van onze guinguette."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ferme pédagogique le carré des animaux"
    ]
  },
