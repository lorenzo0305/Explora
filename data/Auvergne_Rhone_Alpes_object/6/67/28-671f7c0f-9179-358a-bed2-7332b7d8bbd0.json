  "rdfs:comment": {
    "de": [
      "Trödelladen, Antiquitäten, Dekoration: Möbel, Leuchten, Nippes, Vinylplatten, Postkarten, Bücher, Gemälde, Comics, Glaswaren, Keramik, Souvenirs und viele andere Schätze, die Sie zu kleinen Preisen finden können!\nGeöffnet jeden Freitag, Samstag und Sonntag von 10:30 bis 18:30 Uhr."
    ],
    "en": [
      "Brocante, antiques and decoration store: furniture, lighting, knick-knacks, vinyl, postcards, books, paintings, comics, glassware, ceramics, souvenirs and many other treasures to bargain for!\nOpen every Friday, Saturday and Sunday from 10.30am to 6.30pm."
    ],
    "it": [
      "Oggetti di seconda mano, antiquariato e oggetti decorativi: mobili, illuminazione, soprammobili, vinili, cartoline, libri, dipinti, fumetti, oggetti in vetro, ceramiche, souvenir e tanti altri tesori da contrattare!\nAperto ogni venerdì, sabato e domenica dalle 10.30 alle 18.30."
    ],
    "fr": [
      "Boutique de brocante, antiquités, décoration : meubles, luminaires, bibelots, vinyles, cartes postales, livres, peintures, bandes dessinées, verrerie, céramique, souvenirs et bien d'autres trésors à chiner à petit prix ! \nOuvert tous les vendredis, samedis et dimanches de 10h30 à 18h30."
    ],
    "nl": [
      "Tweedehands goederen, antiek en decoratieve artikelen: meubels, verlichting, snuisterijen, vinyl, ansichtkaarten, boeken, schilderijen, strips, glaswerk, keramiek, souvenirs en nog veel meer schatten om op te onderhandelen!\nElke vrijdag, zaterdag en zondag geopend van 10.30 tot 18.30 uur."
    ],
    "es": [
      "Artículos de segunda mano, antigüedades y objetos de decoración: muebles, iluminación, chucherías, vinilos, postales, libros, cuadros, cómics, cristalería, cerámica, souvenirs y muchos otros tesoros para regatear\nAbierto todos los viernes, sábados y domingos de 10.30 a 18.30 h."
    ]
  },
