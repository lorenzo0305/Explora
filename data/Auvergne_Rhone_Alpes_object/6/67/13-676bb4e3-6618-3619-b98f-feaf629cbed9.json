  "rdfs:comment": {
    "de": [
      "Empfang, Verkauf, Probe, Sammlung von alten Formen.\r\nVorstellung der Firma : vidéo über die Kakaokultur und über Schokoladeherstellung in unserer Fabrik."
    ],
    "en": [
      "Reception, sales, tasting.\r\nPresentation of the company : video about the culture of cocoa and about the fabrication of chocolate in our craft workshops."
    ],
    "it": [
      "Accoglienza, vendita, degustazione, raccolta di vecchi stampi.\r\nPresentazione dell'azienda: breve video di presentazione sulla coltivazione del cacao nei paesi produttori e sulla fabbricazione del cioccolato nei nostri laboratori."
    ],
    "fr": [
      "Accueil, vente, dégustation, collection de moules anciens.\r\nPrésentation de l'entreprise : petit exposé vidéo sur la culture du cacao dans les pays producteurs et sur la fabrication du chocolat dans nos ateliers."
    ],
    "es": [
      "Recepción, venta, degustación, recogida de moldes antiguos.\r\nPresentación de la empresa: breve vídeo de presentación sobre el cultivo del cacao en los países productores y sobre la fabricación del chocolate en nuestros talleres."
    ],
    "nl": [
      "Ontvangst, verkoop, proeverij, verzameling van oude gietvormen.\r\nPresentatie van het bedrijf: video over de cacaocultuur in de producerende landen en over de productie van chocolade op onze werkplaatsen."
    ]
  },
