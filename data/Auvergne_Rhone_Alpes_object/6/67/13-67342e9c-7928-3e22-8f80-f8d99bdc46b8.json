  "rdfs:comment": {
    "de": [
      "Diesen Winter wird ein Transportservice angeboten, der Sie von Ihrem Urlaubs- oder Wohnort zum Skigebiet Font d'Urle bringt (und wieder zurück)."
    ],
    "en": [
      "This winter, a transport service is available to take you to (and from) the Font d'Urle resort from where you live or vacation."
    ],
    "it": [
      "Quest'inverno è disponibile un servizio di trasporto per raggiungere (e lasciare) il resort Font d'Urle dalla vostra destinazione di vacanza o da casa."
    ],
    "fr": [
      "Cet hiver, un service de transport est proposé pour vous emmener (et vous ramener) sur la station de Font d'Urle depuis votre lieu de vacances ou d'habitation."
    ],
    "es": [
      "Este invierno, ponemos a su disposición un servicio de transporte para llevarle (y traerle) a la estación de Font d'Urle desde su lugar de vacaciones o su domicilio."
    ],
    "nl": [
      "Deze winter is er een transportdienst beschikbaar om je vanaf je vakantiebestemming of huis naar (en van) het resort Font d'Urle te brengen."
    ]
  },
  "rdfs:label": {
