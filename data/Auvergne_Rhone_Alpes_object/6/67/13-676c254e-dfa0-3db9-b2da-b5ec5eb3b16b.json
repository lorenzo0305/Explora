  "rdfs:comment": {
    "de": [
      "Châtillon-Saint-Jean liegt in der Drôme des collines, im Kanton Romans-sur-Isère, und erstreckt sich über 8,82 km2 mit einer Ortschaft und angeschlossenen Weilern."
    ],
    "en": [
      "Located in the Drôme des collines, canton of Romans-sur-Isère, Châtillon-Saint-Jean covers 8.82 km2 with a town and attached hamlets."
    ],
    "it": [
      "Situato nella Drôme des collines, nel cantone di Romans-sur-Isère, Châtillon-Saint-Jean si estende su una superficie di 8,82 km2, con una città mercato e frazioni adiacenti."
    ],
    "fr": [
      "Situé dans la Drôme des collines, canton de Romans-sur-Isère, Châtillon-Saint-Jean s’étend sur 8,82 km2 avec un bourg et des hameaux rattachés."
    ],
    "es": [
      "Situado en la Drôme des collines, en el cantón de Romans-sur-Isère, Châtillon-Saint-Jean tiene una superficie de 8,82 km2, con una ciudad-mercado y aldeas adyacentes."
    ],
    "nl": [
