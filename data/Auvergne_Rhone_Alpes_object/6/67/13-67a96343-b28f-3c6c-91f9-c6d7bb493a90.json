  "rdfs:comment": {
    "de": [
      "Arbeitermenü, Themenwochenenden, hausgemachte Pizzen, gebratene Freilandhühner... Das ist nur ein kleiner Auszug aus dem Angebot von Gaëlle, der Köchin der Auberge Le Relais des Orgues. Alle Gerichte bestehen aus lokalen und saisonalen Produkten!"
    ],
    "en": [
      "Worker's menu, themed weekends, homemade pizzas, roast free-range chicken... here's just a taste of what Gaëlle, cook at Auberge Le Relais des Orgues, has to offer. All dishes are made with local, seasonal produce!"
    ],
    "it": [
      "Menu del lavoratore, weekend a tema, pizze fatte in casa, pollo ruspante arrosto... ecco solo un assaggio di ciò che Gaëlle, cuoca dell'Auberge Le Relais des Orgues, ha da offrire. Tutti i piatti sono realizzati con prodotti locali e di stagione!"
    ],
    "fr": [
      "Menu ouvrier, week-end à thème, pizzas maisons, poulets fermiers rôtis... voilà un aperçu de ce que propose, Gaëlle, cuisinière de l'Auberge Le Relais des Orgues. Tous les plats sont constitués de produits locaux et de saison !"
    ],
    "nl": [
      "Werknemersmenu, themaweekends, huisgemaakte pizza's, gebraden scharrelkip... dit is slechts een voorproefje van wat Gaëlle, kok in Auberge Le Relais des Orgues, te bieden heeft. Alle gerechten zijn bereid met lokale, seizoensgebonden producten!"
    ],
    "es": [
      "Menú obrero, fines de semana temáticos, pizzas caseras, pollo de corral asado... He aquí sólo una muestra de lo que Gaëlle, cocinera del Auberge Le Relais des Orgues, puede ofrecerle. Todos los platos se elaboran con productos locales de temporada"
    ]
  },
