  "rdfs:comment": {
    "de": [
      "David und Cathy werden Sie mit einer Küche aus regionalen Produkten und Spezialitäten mit Fourme d'Ambert verwöhnen."
    ],
    "en": [
      "Valcivières Inn welcomes you to a natural setting, the Hautes-Chaumes du Forez. Local products and specialties made with our famous fourme d’Ambert cheese. Closed Wednesdays and  Christmas holidays."
    ],
    "it": [
      "David e Cathy vi faranno conoscere una cucina basata su prodotti locali e specialità a base di formaggio Fourme d'Ambert."
    ],
    "fr": [
      "David et Cathy vous feront découvrir une cuisine à base de produits du terroir et des spécialités à la fourme d’Ambert."
    ],
    "es": [
      "David y Cathy le presentarán una cocina basada en productos locales y especialidades elaboradas con queso Fourme d'Ambert."
    ],
    "nl": [
      "David en Cathy laten u kennismaken met een keuken op basis van lokale producten en specialiteiten op basis van Fourme d'Ambert kaas."
    ]
  },
