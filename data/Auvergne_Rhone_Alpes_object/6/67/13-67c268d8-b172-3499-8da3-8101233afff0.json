  "rdfs:comment": {
    "de": [
      "Bistro-Küche, Pizzeria und Berggerichte aus frischen und saisonalen Produkten. Verpflegung vor Ort oder zum Mitnehmen.\r\nTagesmenü am Mittag.\r\nQuartier de l'Eclose am Fuße der Odalys-Residenz, eine offene Terrasse mit Blick auf die Berge."
    ],
    "en": [
      "Bistro cuisine, pizzeria and mountain dishes made with fresh seasonal produce. Catering on site or to take away.\r\nDaily lunch menu.\r\nIn the Eclose district, at the foot of the Odalys residence, a terrace overlooking the mountains."
    ],
    "it": [
      "Cucina bistrot, pizzeria e piatti di montagna preparati con prodotti freschi di stagione. Catering in loco o da asporto.\r\nMenu giornaliero a pranzo.\r\nNel quartiere di Eclose, ai piedi della residenza Odalys, terrazza con vista sulle montagne."
    ],
    "fr": [
      "Cuisine bistro, pizzeria et plats montagnards de produits frais et de saison. Restauration sur place ou à emporter.\r\nMenu du jour le midi.\r\nQuartier de l’Eclose au pied de la résidence Odalys, une terrasse ouverte sur les montagnes."
    ],
    "es": [
      "Cocina bistró, pizzería y platos de montaña elaborados con productos frescos de temporada. Servicio de catering in situ o para llevar.\r\nMenú del día.\r\nEn el barrio de Eclose, al pie de la residencia Odalys, terraza con vistas a la montaña."
    ],
    "nl": [
      "Bistrokeuken, pizzeria en berggerechten gemaakt met verse seizoensproducten. Catering ter plaatse of om mee te nemen.\r\nDagelijks lunchmenu.\r\nIn de wijk Eclose, aan de voet van de Odalys-residentie, een terras met uitzicht op de bergen."
    ]
  },
