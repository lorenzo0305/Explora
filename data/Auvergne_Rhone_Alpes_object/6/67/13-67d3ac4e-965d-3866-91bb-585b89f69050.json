  "rdfs:comment": {
    "de": [
      "Genießen Sie eine Gourmetpause bei einer Tasse Kaffee, entdecken Sie die Produkte unseres Ladens und nehmen Sie an unseren kreativen Workshops sowie an unseren Reflexzonenmassagen teil."
    ],
    "en": [
      "Come and enjoy a gourmet break over coffee, discover the products in our boutique and take part in our creative workshops and reflexology sessions."
    ],
    "it": [
      "Venite a godervi una pausa gourmet davanti a un caffè, a scoprire i prodotti della nostra boutique e a partecipare ai nostri laboratori creativi e alle sessioni di riflessologia."
    ],
    "fr": [
      "Venez savourer une pause gourmande autour d'un café, découvrir les produits de notre boutique et participer à nos ateliers créatifs ainsi qu'à nos séances de réflexologie."
    ],
    "es": [
      "Venga a disfrutar de una pausa gastronómica tomando un café, descubra los productos de nuestra boutique y participe en nuestros talleres creativos y sesiones de reflexología."
    ],
    "nl": [
      "Kom genieten van een kopje koffie voor fijnproevers, ontdek de producten in onze boetiek en neem deel aan onze creatieve workshops en reflexologiesessies."
    ]
  },
