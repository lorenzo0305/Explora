  "rdfs:comment": {
    "de": [
      "Dorf Chilhac: Ein mittelalterliches Dorf mit Stadtmauer (14.-16. Jh.), das auf einem der letzten Lavaströme der Devès-Kette über dem Fluss Allier errichtet wurde."
    ],
    "en": [
      "Village of Chilhac: Ancient medieval village surrounded by ramparts (14th-15th-16th centuries), built on one of the last lava flows of the Devès mountain range overlooking the Allier."
    ],
    "it": [
      "Villaggio di Chilhac: antica città medievale circondata da bastioni (XIV-XV-XVI secolo), costruita su una delle ultime colate laviche della catena del Devès e affacciata sull'Allier."
    ],
    "fr": [
      "Village de Chilhac : Ancien bourg médiéval entouré de remparts (XIVe-XVe-XVIe siècles), bâti sur l’une des dernières coulées de lave de la chaîne du Devès dominant l’Allier."
    ],
    "es": [
      "Pueblo de Chilhac: antigua ciudad medieval rodeada de murallas (siglos XIV-XV-XVI), construida sobre una de las últimas coladas de lava de la cordillera de Devès que domina el Allier."
    ],
    "nl": [
      "Dorp Chilhac: Een oude middeleeuwse stad omringd door stadsmuren (14e-15e-16e eeuw), gebouwd op een van de laatste lavastromen in het Devès-gebergte met uitzicht op de Allier."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Village | Chilhac | Petite cité de caractère"
    ]
  },
