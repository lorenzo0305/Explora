  "rdfs:comment": {
    "de": [
      "Saint-Gervais Mont-Blanc sorgt wieder einmal für Aufsehen, indem es rund 20 Fußgängerüberwege im Stadtzentrum in originelle Kunstwerke verwandelt."
    ],
    "en": [
      "Once again, Saint-Gervais Mont-Blanc is creating the event by transforming around twenty pedestrian crossings in its town center into original artistic creations."
    ],
    "it": [
      "Ancora una volta, Saint-Gervais Mont-Blanc sta facendo scalpore trasformando una ventina di attraversamenti pedonali del centro cittadino in originali opere d'arte."
    ],
    "fr": [
      "Une nouvelle fois, Saint-Gervais Mont-Blanc crée l’événement en métamorphosant une vingtaine de passages piétons de son centre-ville en des réalisations artistiques originales."
    ],
    "es": [
      "Una vez más, Saint-Gervais Mont-Blanc causa sensación al transformar una veintena de pasos de peatones del centro de la ciudad en originales obras de arte."
    ],
    "nl": [
      "Saint-Gervais Mont-Blanc zorgt opnieuw voor opschudding door een twintigtal zebrapaden in het stadscentrum om te toveren tot originele kunstwerken."
    ]
  },
  "rdfs:label": {
    "fr": [
      "2KM3 Acte IV"
    ]
  },
