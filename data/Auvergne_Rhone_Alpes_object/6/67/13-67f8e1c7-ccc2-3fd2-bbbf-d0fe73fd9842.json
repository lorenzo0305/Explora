  "rdfs:comment": {
    "de": [
      "Der Sessellift von Chaux Fleurie führt zum Rochasson-Kamm, dem Eingangstor zu den Portes du Soleil: direkter Zugang zum Skiort Châtel und dann zu den Schweizer Skiorten.\r\nZugänglich für Mountainbikes (nur für den Aufstieg) und Fußgänger (Aufstieg und Abfahrt)"
    ],
    "en": [
      "The Chaux Fleurie chairlift provides access to the Rochasson Crest, gateway to the Portes du Soleil: direct access to the Châtel and Swiss resorts.\r\nAccessible to mountain bikes (ascent only) and pedestrians (ascent and descent)."
    ],
    "it": [
      "La seggiovia Chaux Fleurie permette di accedere alla cresta di Rochasson, la porta delle Portes du Soleil: accesso diretto a Châtel e alle località svizzere.\r\nAccessibile alle mountain bike (solo in salita) e ai pedoni (in salita e in discesa)"
    ],
    "fr": [
      "Le télésiège de Chaux Fleurie permet d'accéder à la crête de Rochasson, porte d'entrée des Portes du Soleil : accès direct à la station de Châtel puis aux stations suisses.\r\nAccessible aux vtt (uniquement pour la montée) et aux piétons (montée et descente)"
    ],
    "es": [
      "El telesilla Chaux Fleurie da acceso a la cresta del Rochasson, puerta de entrada a Portes du Soleil: acceso directo a Châtel y a las estaciones suizas.\r\nAccesible para bicicletas de montaña (sólo subida) y peatones (subida y bajada)"
    ],
    "nl": [
      "De stoeltjeslift Chaux Fleurie biedt toegang tot de bergkam van Rochasson, de poort naar de Portes du Soleil: directe toegang tot Châtel en de Zwitserse skioorden.\r\nToegankelijk voor mountainbikes (alleen beklimming) en voetgangers (beklimming en afdaling)"
    ]
  },
  "rdfs:label": {
    "en": [
      "Chaux Fleurie chairlift"
    ],
    "fr": [
      "Télésiège de Chaux Fleurie"
    ]
  },
