  "rdfs:comment": {
    "de": [
      "Christelle Varenne ist in Saint-Didier-en-Velay aufgewachsen. Sie ist ausgebildete Architektin und fühlte sich schon immer von der Kunst in all ihren Formen angezogen."
    ],
    "en": [
      "Christelle Varenne grew up in Saint-Didier-en-Velay. Trained as an architect, she has always been drawn to art in all its forms."
    ],
    "it": [
      "Christelle Varenne è cresciuta a Saint-Didier-en-Velay. Formatasi come architetto, è sempre stata attratta dall'arte in tutte le sue forme."
    ],
    "fr": [
      "Christelle Varenne a grandi à Saint-Didier-en-Velay. Architecte de formation, elle a toujours été attirée par l'art sous toutes ses formes."
    ],
    "nl": [
      "Christelle Varenne groeide op in Saint-Didier-en-Velay. Ze is opgeleid als architect, maar voelde zich altijd aangetrokken tot kunst in al haar vormen."
    ],
    "es": [
      "Christelle Varenne creció en Saint-Didier-en-Velay. Arquitecta de formación, siempre se ha sentido atraída por el arte en todas sus formas."
    ]
