  "rdfs:comment": {
    "de": [
      "Freie Besichtigung der Außenanlagen auf dem angelegten Weg entlang der Wassergräben und des Parks. Geführte Besichtigung der Innenräume nach vorheriger Anmeldung.\r\nGruppentarif ab 7 Personen."
    ],
    "en": [
      "Free visit of the exterior on the path along the moat and the park. Guided tour of the interiors on prior request from 7 people."
    ],
    "it": [
      "Visite autoguidate dell'esterno lungo il percorso tracciato lungo il fossato e il parco. Visite guidate agli interni su prenotazione.\r\nTariffe per gruppi a partire da 7 persone."
    ],
    "fr": [
      "Visite libre des extérieurs sur le chemin aménagé le long des douves et du parc. Visite guidées des intérieurs sur réservation.\r\nTarif groupe à partir de 7 personnes."
    ],
    "nl": [
      "Zelf rondleidingen door de buitenkant langs het pad langs de slotgracht en het park. Rondleidingen door het interieur op afspraak.\r\nGroepstarieven vanaf 7 personen."
    ],
    "es": [
      "Visitas autoguiadas del exterior por el camino trazado a lo largo del foso y el parque. Visitas guiadas de los interiores previa concertación.\r\nTarifas de grupo a partir de 7 personas."
    ]
  },
