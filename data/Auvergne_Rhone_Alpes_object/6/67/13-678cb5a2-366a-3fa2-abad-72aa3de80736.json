  "rdfs:comment": {
    "de": [
      "Gourmetküche und großzügige Küche. Berühmte Trüffel. Gemütliches Ambiente und Rahmen. Maître Restaurateur. 20 Jahre zu Ihren Diensten. Gerichte zum Mitnehmen auf Bestellung.\r\nSeien Sie herzlich willkommen bei uns!"
    ],
    "en": [
      "Gourmet and generous cuisine. Takeaway meals on order. Renowned truffade. Warm atmosphere and setting. Gourmet and generous cuisine. Master Restorer. Takeaway meals on order, renowned Truffade. 20 years at your service."
    ],
    "it": [
      "Cucina gourmet generosa. Famosi tartufi. Atmosfera e ambiente caldi. Maître Restaurateur. 20 anni al vostro servizio. Piatti da asporto su ordinazione.\r\nSaremo lieti di accogliervi!"
    ],
    "fr": [
      "Cuisine gourmande et généreuse. Truffade réputée. Ambiance et cadre chaleureux. Maître Restaurateur. 20 ans à votre service. Plats à emporter sur commande. \r\nSoyez les bienvenus chez nous !"
    ],
    "nl": [
      "Royale gastronomische keuken. Beroemde truffels. Warme sfeer en omgeving. Restaurateur. 20 jaar tot uw dienst. Afhaalgerechten op bestelling.\r\nWe kijken ernaar uit u te verwelkomen!"
    ],
    "es": [
      "Generosa cocina gourmet. Trufas famosas. Ambiente y entorno cálidos. Maître Restaurateur. 20 años a su servicio. Platos para llevar por encargo.\r\nEstaremos encantados de recibirle"
    ]
  },
