  "rdfs:comment": {
    "de": [
      "Das ideal gegenüber dem Jardin Villebœuf und in der Nähe des Kinos Le Camion Rouge gelegene Restaurant Côté Parc bietet Ihnen eine Bistroküche. Der Küchenchef ist ein Fan von frischen Produkten und bereitet Ihnen täglich wechselnde Menüs zu."
    ],
    "en": [
      "Let's head over to Place Villeboeuf, where there's a little place that does quality bistro food. The Côté Parc opens onto the garden on the square, which was all redone recently."
    ],
    "it": [
      "Ci dirigiamo verso Place Villeboeuf dove ci attende un piccolo ristorante che mette in primo piano la cucina bistrot di qualità. Il Côté Parc si affaccia sul giardino della piazza, recentemente completamente rinnovato."
    ],
    "fr": [
      "On file vers la place Villeboeuf où nous attend un petit resto qui met la cuisine de bistrot de qualité à l'honneur. Le Côté Parc donne sur le jardin de la place, récemment refait entièrement."
    ],
    "nl": [
      "We gaan naar de Place Villeboeuf waar een klein restaurant op ons wacht dat de bistrokeuken van hoge kwaliteit in de schijnwerpers zet. Côté Parc kijkt uit op de tuin van het plein, die onlangs volledig is gerenoveerd."
    ],
    "es": [
      "Nos dirigimos a la plaza Villeboeuf, donde nos espera un pequeño restaurante que pone en valor la cocina bistró de calidad. El Côté Parc da al jardín de la plaza, que ha sido recientemente renovado por completo."
    ]
  },
