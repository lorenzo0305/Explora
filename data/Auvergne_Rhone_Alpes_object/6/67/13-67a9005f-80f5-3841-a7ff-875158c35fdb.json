  "rdfs:comment": {
    "de": [
      "Hoch gelegener Familienbauernhof in L'Alpe d'Huez. Im Sommer vor Ort hergestellter Bauernkäse. Bauernhof-Imbiss im Winter: Berg-Sandwiches, hausgemachte Crêpes und heiße Getränke. Lokale, hausgemachte Produkte, gemütliche Atmosphäre."
    ],
    "en": [
      "High altitude family farm in Alpe d'Huez. Farmhouse cheeses made on site in summer. Farm snack bar in winter: mountain sandwiches, homemade crêpes and hot drinks. Local, homemade products, warm atmosphere."
    ],
    "it": [
      "Fattoria familiare d'alta quota nell'Alpe d'Huez. Formaggi di fattoria prodotti in loco in estate. In inverno, snack bar della fattoria: panini di montagna, crêpes fatte in casa e bevande calde. Prodotti locali e fatti in casa, atmosfera accogliente."
    ],
    "fr": [
      "Ferme familiale d’altitude à l’Alpe d’Huez. Fromages fermiers fabriqués sur place l’été. Snack fermier l’hiver : sandwichs montagnards, crêpes maison et boissons chaudes. Produits locaux, faits maison, ambiance chaleureuse."
    ],
    "nl": [
      "Hooggelegen familieboerderij in Alpe d'Huez. Boerenkazen ter plaatse gemaakt in de zomer. Snackbar op de boerderij in de winter: bergbroodjes, zelfgemaakte crêpes en warme dranken. Lokale, zelfgemaakte producten, warme sfeer."
    ],
    "es": [
      "Granja familiar de gran altitud en Alpe d'Huez. Quesos de granja elaborados in situ en verano. Snack-bar en la granja en invierno: bocadillos de montaña, crepes caseros y bebidas calientes. Productos locales y caseros, ambiente cálido."
    ]
  },
  "rdfs:label": {
    "en": [
      "La Ferme des Cimes - Le petit gueuleton"
    ],
    "fr": [
