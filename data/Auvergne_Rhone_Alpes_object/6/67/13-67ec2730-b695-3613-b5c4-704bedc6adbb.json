  "rdfs:comment": {
    "de": [
      "La Source, Musiques Cultures Fontaine, ist eine städtische Einrichtung der Stadt Fontaine, die mit ihrer Eröffnung ein neuartiges und originelles Projekt zur Aufwertung kultureller Praktiken positioniert."
    ],
    "en": [
      "La Source, Musiques Cultures Fontaine, is a municipal facility of the city of Fontaine, which, by opening its doors, is positioning itself as a new and original project for the promotion of cultural practices."
    ],
    "it": [
      "La Source, Musiques Cultures Fontaine, è una struttura municipale della città di Fontaine che, con la sua apertura, mette in campo un nuovo e originale progetto di valorizzazione delle pratiche culturali."
    ],
    "fr": [
      "La Source, Musiques Cultures Fontaine, est un équipement municipal de la Ville de Fontaine, qui, par son ouverture, positionne un projet inédit et original de valorisation des pratiques culturelles."
    ],
    "nl": [
      "La Source, Musiques Cultures Fontaine, is een gemeentelijke voorziening van de stad Fontaine, die door haar opening een nieuw en origineel project van valorisatie van culturele praktijken positioneert."
    ],
    "es": [
      "La Source, Musiques Cultures Fontaine, es un equipamiento municipal de la ciudad de Fontaine que, al abrir sus puertas, se posiciona como un proyecto nuevo y original de promoción de las prácticas culturales."
    ]
  },
