  "rdfs:comment": {
    "de": [
      "Das städtische Schwimmbad von Les Avenières Veyrins-Thuellins befindet sich in unmittelbarer Nähe des Campingplatzes und besteht aus zwei Becken und einem Freiluft-Planschbecken."
    ],
    "en": [
      "The municipal swimming pool at Les Avenières Veyrins-Thuellins, located right next to the campsite, has two pools and an outdoor paddling pool."
    ],
    "it": [
      "La piscina comunale di Les Avenières Veyrins-Thuellins, situata proprio accanto al campeggio, dispone di due vasche e di una piscina per bambini all'aperto."
    ],
    "fr": [
      "La piscine municipale des Avenières Veyrins-Thuellins, située à proximité immédiate du camping, est composée de deux bassins et d'une pateaugeoire en plein-air."
    ],
    "es": [
      "La piscina municipal de Les Avenières Veyrins-Thuellins, situada justo al lado del camping, cuenta con dos piscinas y una piscina infantil al aire libre."
    ],
    "nl": [
      "Het gemeentelijk zwembad van Les Avenières Veyrins-Thuellins, direct naast de camping, heeft twee zwembaden en een buitenzwembad."
    ]
  },
  "rdfs:label": {
