  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/e4b135aa-b076-36a4-9c23-e46cd899186d",
      "dc:description": {
        "de": [
          "In diesem Workshop werden die Kinder zu kleinen Wissenschaftlern, indem sie eine Vielzahl von Experimenten durchführen, um zu spielen und das kostbare Gut Wasser zu entdecken."
        ],
        "en": [
          "During this workshop, children will become little scientists by carrying out a host of experiments to play with and discover a precious commodity: water."
        ],
        "it": [
          "Durante questo laboratorio, i bambini diventeranno piccoli scienziati, realizzando una serie di esperimenti per giocare e scoprire l'acqua, una risorsa preziosa."
        ],
        "fr": [
          "Au cours de cet atelier, les enfants deviendront des petits scientifiques en réalisant un tas d’expériences pour jouer et découvrir un bien précieux, l’eau."
        ],
        "nl": [
          "Tijdens deze workshop worden kinderen kleine wetenschappers terwijl ze allerlei experimenten uitvoeren om te spelen met en ontdekken van een kostbare hulpbron: water."
        ],
        "es": [
          "Durante este taller, los niños se convertirán en pequeños científicos mientras realizan multitud de experimentos para jugar y descubrir un recurso precioso: el agua."
        ]
      },
