  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/6be68677-73cf-3669-93da-142fea5fbe3a",
      "dc:description": {
        "de": [
          "Die Brasserie O'Boulogne bietet am 122 Boulevard Sainte-Beuve eine große Auswahl an Fisch, Fleisch, Wels und Muscheln. Das Restaurant ist dienstags bis samstags von 10 bis 15 Uhr und von 19 bis 21 Uhr sowie sonntags zum Mittagessen geöffnet."
        ],
        "en": [
          "The brasserie O'Boulogne offers a wide choice of fish, meat, welsh and mussels at 122 boulevard Sainte-Beuve. The restaurant is open from Tuesday to Saturday from 10am to 3pm and from 7pm to 9pm as well as on Sunday lunchtime."
        ],
        "it": [
          "La brasserie O'Boulogne offre un'ampia scelta di pesce, carne, gallese e cozze al 122 di boulevard Sainte-Beuve. Il ristorante è aperto dal martedì al sabato dalle 10.00 alle 15.00 e dalle 19.00 alle 21.00, oltre che la domenica a pranzo."
        ],
        "fr": [
          "La brasserie O'Boulogne propose un large choix de poissons, viandes, welshs et moules au 122 boulevard Sainte-Beuve. Le restaurant est ouvert du mardi au samedi de 10h à 15h et de 19h à 21h ainsi que le dimanche midi."
        ],
        "es": [
          "La brasserie O'Boulogne ofrece una amplia selección de pescado, carne, galesa y mejillones en el 122 del bulevar Sainte-Beuve. El restaurante está abierto de martes a sábado de 10:00 a 15:00 y de 19:00 a 21:00, así como el almuerzo del domingo."
        ],
        "nl": [
          "De brasserie O'Boulogne biedt een ruime keuze aan vis, vlees, welsh en mosselen aan de boulevard Sainte-Beuve 122. Het restaurant is geopend van dinsdag tot zaterdag van 10 tot 15 uur en van 19 tot 21 uur, en ook op zondagmiddag."
        ]
      },
      "@type": [
        "Description"
