  "rdfs:comment": {
    "de": [
      "Im Zentrum von Megève befindet sich das Hotel & Spa Le M de Megève, 150 m von den Skiliften Chamois und allen Geschäften entfernt."
    ],
    "en": [
      "In the center of the Village, the M de Megève is located at 150 meters from the cablecar of Le Chamois. Each bedrooms have their unique warm and refined decoration."
    ],
    "it": [
      "Nel centro di Megève, l’hotel Le M de Megève si trova a 100 m dagli impianti di risalita dello Chamois."
    ],
    "fr": [
      "Au centre de Megève, l’hôtel & spa Le M de Megève, est situé à 150 mètres des remontées mécaniques du Chamois et de tous les commerces."
    ],
    "nl": [
      "Hotel & spa Le M de Megève ligt in het centrum van Megève, op slechts 150 meter van de skiliften van Chamois en alle winkels."
    ],
