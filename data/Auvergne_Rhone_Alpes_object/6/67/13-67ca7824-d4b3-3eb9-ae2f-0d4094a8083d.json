  "rdfs:comment": {
    "de": [
      "La Malle Postale bietet die Beförderung von Gepäck, Personen und Fahrrädern auf Fernwanderwegen wie Santiago de Compostela, Stevenson und vielen anderen in Frankreich an."
    ],
    "en": [
      "La Malle Postale transports luggage, people and bicycles on Grande Randonnée trails such as Saint-Jacques-de-Compostelle, Stevenson and many others in France."
    ],
    "it": [
      "La Malle Postale trasporta bagagli, persone e biciclette su sentieri di lunga percorrenza come Saint-Jacques-de-Compostelle, Stevenson e molti altri in Francia."
    ],
    "fr": [
      "La Malle Postale propose le transport de bagages, de personnes et de vélos sur les chemins de Grande Randonnée tels que Saint-Jacques-de-Compostelle, Stevenson et beaucoup d'autres en France."
    ],
    "nl": [
      "La Malle Postale verzorgt het vervoer van bagage, mensen en fietsen op langeafstandswandelpaden zoals Saint-Jacques-de-Compostelle, Stevenson en vele andere in Frankrijk."
    ],
    "es": [
      "La Malle Postale se encarga del transporte de equipajes, personas y bicicletas en senderos de gran recorrido como Saint-Jacques-de-Compostelle, Stevenson y muchos otros en Francia."
    ]
  },
