  "rdfs:comment": {
    "de": [
      "Valséo ist viel mehr als nur ein Wasser-, Fitness- und Wellnesscenter!\r\nDiese Oase der Erfrischung und Vitalität ist der ideale Ort, um Spaß zu haben, sich auszupowern und zu entspannen."
    ],
    "en": [
      "Bellegarde swimming centre has an outdoor pool, two indoor pools, a 34m water chute, sauna and hammam, beverage and snack distributor. Water toy and deckchair hire, swimming lessons. Swim caps must be worn."
    ],
    "it": [
      "Valséo è molto più di un centro acquatico, fitness e benessere!\r\nQuesta oasi di ristoro e vitalità è il luogo ideale per il divertimento, l'esercizio fisico e il relax."
    ],
    "fr": [
      "Valséo est bien plus qu’un centre aquatique, fitness et bien-être ! \r\nCe havre de rafraîchissement et de vitalité est l’endroit idéal pour s’amuser, se dépenser et se détendre."
    ],
    "nl": [
      "Valséo is veel meer dan een water-, fitness- en wellnesscentrum!\r\nDeze oase van verfrissing en vitaliteit is de ideale plek voor plezier, beweging en ontspanning."
    ],
    "es": [
      "Valséo es mucho más que un centro acuático, de fitness y de bienestar\r\nEste remanso de frescor y vitalidad es el lugar ideal para divertirse, hacer ejercicio y relajarse."
    ]
  },
  "rdfs:label": {
    "fr": [
