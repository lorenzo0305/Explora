  "rdfs:comment": {
    "de": [
      "Das Wanderkino in Les Avenières Veyrins-Thuellin zeigt Ihnen jeden Monat aktuelle Filme in den Festsälen von Ciers oder Buvin. Der Ort wird bei jeder Sitzung neu festgelegt. Informieren Sie sich im monatlichen Terminkalender."
    ],
    "en": [
      "Every month, the mobile cinema invites the people of Les Avenières Veyrins-Thuellin to see recently-released films in the village halls of Ciers and Buvin. The venue is specified for each screening. Please check the monthly calendar."
    ],
    "it": [
      "Il cinema itinerante di Les Avenières Veyrins-Thuellin vi propone ogni mese film recenti nelle sale dei villaggi di Ciers o Buvin. La sede viene stabilita a ogni sessione; si veda l'agenda mensile."
    ],
    "fr": [
      "Le cinéma itinérant aux Avenières Veyrins-Thuellin vous propose chaque mois des films récents dans les salles des fêtes de Ciers ou de Buvin. Le lieu est défini à chaque séance, consultez l'agenda mensuel."
    ],
    "es": [
      "El cine itinerante de Les Avenières Veyrins-Thuellin le ofrece cada mes películas recientes en las salas de los pueblos de Ciers o Buvin. El lugar se determina en cada sesión, véase la agenda mensual."
    ],
    "nl": [
      "De reizende bioscoop in Les Avenières Veyrins-Thuellin biedt u elke maand recente films in de dorpszalen van Ciers of Buvin. De locatie wordt bij elke zitting bepaald, zie de maandelijkse agenda."
    ]
  },
  "rdfs:label": {
    "en": [
      "Cinema"
    ],
    "fr": [
      "Cinéma à la salle des fêtes de Ciers"
    ]
  },
