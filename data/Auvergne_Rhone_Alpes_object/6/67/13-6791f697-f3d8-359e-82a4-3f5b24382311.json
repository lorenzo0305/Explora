  "rdfs:comment": {
    "de": [
      "Im Zentrum des Dorfes Les Contamines ist die Einrichtung La Casa Roca ein \"Hort der guten Lebensart\", der Ihnen frische und lokale Produkte in einer warmen und freundlichen Atmosphäre anbietet."
    ],
    "en": [
      "In the center of the village of Les Contamines, La Casa Roca is a \"repaire de bons vivants\" offering fresh local produce in a warm and friendly atmosphere."
    ],
    "it": [
      "Nel centro del villaggio di Les Contamines, La Casa Roca è un \"covo di bon vivants\" che offre prodotti freschi locali in un'atmosfera calda e accogliente."
    ],
    "fr": [
      "Au centre du village des Contamines, l'établissement la Casa Roca est un \"repaire de bons vivants\" qui vous propose des produits frais et locaux dans une ambiance chaleureuse et conviviale."
    ],
    "nl": [
      "La Casa Roca, in het centrum van het dorp Les Contamines, is een \"bon vivants' den\" die verse lokale producten aanbiedt in een warme en vriendelijke sfeer."
    ],
    "es": [
      "En el centro del pueblo de Les Contamines, La Casa Roca es una \"guarida de bon vivants\" que ofrece productos locales frescos en un ambiente cálido y acogedor."
    ]
  },
  "rdfs:label": {
