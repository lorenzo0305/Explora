  "rdfs:comment": {
    "de": [
      "Audrey und Nicolas begrüßen Sie auf diesem alten renovierten Bauernhof und bieten Ihnen traditionelle Küche, die von ihnen mit saisonalen Produkten zubereitet wird."
    ],
    "en": [
      "Audrey et Nicolas welcome you in this renovated old farm and offer you traditional cooking, carefully prepared by them with carefully selected seasonal products."
    ],
    "it": [
      "Audrey e Nicolas vi accolgono in questo antico casale ristrutturato e vi offrono una cucina tradizionale preparata da loro con prodotti selezionati in base alle stagioni."
    ],
    "fr": [
      "Audrey et Nicolas vous accueillent dans cette ancienne ferme rénovée et vous proposent une cuisine traditionnelle préparée par leurs soins avec des produits sélectionnés aux grés des saisons."
    ],
    "nl": [
      "Traditionele keuken van de streek."
    ],
    "es": [
      "Audrey y Nicolas le dan la bienvenida en esta antigua granja renovada y le ofrecen una cocina tradicional preparada por ellos con productos seleccionados según las estaciones."
    ]
  },
