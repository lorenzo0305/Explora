  "rdfs:comment": {
    "de": [
      "Diese charakteristische Crêperie, die in einem Gebäude aus dem 15. Jahrhundert mit typischer Architektur untergebracht ist, bietet Ihnen Crêpes-Spezialitäten zu 100 % aus der Bretagne und nach Art der Auvergne."
    ],
    "en": [
      "Housed in a 15th century building with typical architecture, this creperie of character offers you specialities of crepes 100% Breton and Auvergne style."
    ],
    "it": [
      "Ospitata in un edificio del XV secolo dall'architettura tipica, questa crêperie di carattere offre specialità di crêpe 100% bretoni e d'Alvernia."
    ],
    "fr": [
      "Aménagé dans un bâtiment du XVe siècle à l'architecture typique, cette crêperie de caractère vous propose des spécialités de crêpes 100 % bretonnes et à la mode auvergnate."
    ],
    "es": [
      "Ubicada en un edificio del siglo XV de arquitectura típica, esta crêperie con carácter ofrece especialidades de crêpes 100% bretonas y al estilo de Auvernia."
    ],
    "nl": [
      "Deze karaktervolle crêperie, gevestigd in een 15e-eeuws gebouw met typische architectuur, biedt 100% Bretonse en Auvergne-achtige crêpespecialiteiten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Crêperie Le Coin des Hasards"
    ]
  },
