  "rdfs:comment": {
    "de": [
      "Es hat die Jahrhunderte und Konflikte überdauert und sich im Laufe der Zeit von einem feudalen befestigten Dorf im 12. Jahrhundert zu einem Renaissance-Landsitz entwickelt."
    ],
    "en": [
      "It has weathered centuries and conflicts, transforming itself over time from a feudal fortified village in the 12th century to a Renaissance seigneury."
    ],
    "it": [
      "È sopravvissuta a secoli e conflitti, trasformandosi nel tempo da villaggio feudale fortificato nel XII secolo a signoria rinascimentale."
    ],
    "fr": [
      "Il a traversé les siècles et les conflits, se transformant au fil du temps, d’un village fortifié féodal au 12ème siècle à une seigneurie ‘Renaissance’."
    ],
    "nl": [
      "Het heeft eeuwen en conflicten overleefd en is in de loop der tijd veranderd van een versterkt feodaal dorp in de 12e eeuw in een Renaissance heerlijkheid."
    ],
    "es": [
      "Ha sobrevivido a los siglos y a los conflictos, transformándose con el tiempo de villa feudal fortificada en el siglo XII a señorío renacentista."
    ]
  },
