  "rdfs:comment": {
    "de": [
      "Unser Team freut sich, Sie in einer alten Scheune aus dem Jahr 1881 im Herzen des Ortes begrüßen zu dürfen. Probieren Sie unsere Gänseleberpastete, geräucherten Lachs, Desserts, hausgemachtes Brot am Abend und Spezialitäten aus den Bergen."
    ],
    "en": [
      "Our team will be delighted to welcome you to the heart of the resort, in an old barn dating back to 1881. Come and taste our foie gras, smoked salmon, desserts, homemade bread in the evening and mountain specialities."
    ],
    "it": [
      "Il nostro team sarà lieto di accogliervi nel cuore del resort, in un vecchio fienile del 1881. Venite a gustare il nostro foie gras, il salmone affumicato, i dessert, il pane fatto in casa la sera e le specialità di montagna."
    ],
    "fr": [
      "C'est dans une vieille grange datant de 1881 reconstituée au cœur de la station que notre équipe sera heureuse de vous recevoir. Venez déguster notre foie gras, saumon fumé, desserts, pain maison le soir et les spécialités de montagne."
    ],
    "nl": [
      "Ons team heet u van harte welkom in het hart van het resort, in een oude schuur uit 1881. Kom proeven van onze foie gras, gerookte zalm, desserts, 's avonds zelfgebakken brood en bergspecialiteiten."
    ],
    "es": [
      "Nuestro equipo estará encantado de recibirle en el corazón de la estación, en un antiguo granero que data de 1881. Venga a degustar nuestro foie gras, salmón ahumado, postres, pan casero por la noche y especialidades de montaña."
    ]
  },
