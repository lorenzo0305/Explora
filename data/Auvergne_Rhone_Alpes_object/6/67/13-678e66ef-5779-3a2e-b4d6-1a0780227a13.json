  "rdfs:comment": {
    "de": [
      "\"Angelführer seit 30 Jahren, ich bin auf alle Arten von Techniken spezialisiert. Ich führe mit dem Boot Raubfische und Felchen auf dem Lac du Bourget und auf dem Fluss Rhône Wels und Zander.\"\r\nSpezialisiert auf Angelcamps nur für Teenager"
    ],
    "en": [
      "\"A fishing guide for 25 years, I specialize in all types of techniques. I guide carnivores and whitefish by boat on Lac du Bourget and on the Rhône River for catfish and zander.\"\r\nSpecialized in fishing camps for teenagers"
    ],
    "it": [
      "\"Guida di pesca da 25 anni, sono specializzato in tutti i tipi di tecnica. Guido carnivori e coregoni in barca sul Lac du Bourget e sul fiume Rodano per pesci gatto e luccioperca\".\r\nSpecializzato in campi di pesca per adolescenti"
    ],
    "fr": [
      "\"Guide de pêche depuis 30 ans, je suis spécialisé dans tous types de techniques. Je guide en bateau les carnassiers et corégones sur le lac du  Bourget et sur le fleuve Rhône pour le silure et le sandre.\" \r\nSpécialisé dans les camps pêche réservés aux ados"
    ],
    "es": [
      "\"Soy guía de pesca desde hace 30 años y estoy especializado en todo tipo de técnicas. Guío carnívoros y peces blancos en barco en el Lac du Bourget y en el Ródano para siluro y lucioperca\"\r\nEspecializado en campamentos de pesca para adolescentes"
    ],
    "nl": [
      "\"Ik ben al 25 jaar visgids en gespecialiseerd in alle soorten technieken. Ik begeleid carnivoren en witvis per boot op het Lac du Bourget en op de rivier de Rhône voor meerval en snoekbaars.\"\r\nGespecialiseerd in viskampen voor tieners"
    ]
  },
  "rdfs:label": {
    "en": [
      "Fishing Guide - Joan Guidolin (randopeche.fr)"
    ],
    "it": [
      "Guida di pesca - Joan Guidolin (randopeche.fr)"
    ],
    "fr": [
      "Moniteur guide de Pêche - Joan Guidolin"
    ],
    "nl": [
      "Visgids - Joan Guidolin (randopeche.fr)"
    ]
  },
