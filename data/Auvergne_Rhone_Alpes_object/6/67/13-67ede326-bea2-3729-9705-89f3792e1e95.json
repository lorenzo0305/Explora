  "rdfs:comment": {
    "de": [
      "Cocktailbar, Mocktail, Bierauswahl, Tapas, verschiedene Bretter.\r\nDas Barbacane empfängt Sie in einer gemütlichen Atmosphäre: Live-Musik, Themenabende, Übertragung von Fußballspielen ... Ob Sie mit Freunden oder der Familie unterwegs sind, das Barbacane ist für Sie gemacht."
    ],
    "en": [
      "Cocktail bar, mocktail bar, selection of beers, tapas, various platters.\r\nThe Barbacane welcomes you in a cosy atmosphere: live music, themed evenings, match broadcasts... whether you're with friends or family, the Barbacane is made for you."
    ],
    "it": [
      "Cocktail bar, mocktail, selezione di birre, tapas, piatti vari.\r\nIl Barbacane vi accoglie in un'atmosfera accogliente: musica dal vivo, serate a tema, trasmissioni di partite... che siate con amici o in famiglia, il Barbacane è fatto per voi."
    ],
    "fr": [
      "Bar à cocktail, mocktail, sélection de bières, tapas, planches variées.\r\nLe Barbacane vous accueille dans une ambiance cosy : musique live, soirée à thème, diffusion des matchs ... que vous soyez entre amis ou en famille, le Barbacane est fait pour vous."
    ],
    "nl": [
      "Cocktailbar, mocktail, selectie bieren, tapas, diverse schotels.\r\nDe Barbacane verwelkomt je in een gezellige sfeer: livemuziek, thema-avonden, wedstrijduitzendingen... of je nu met vrienden of familie bent, de Barbacane is voor jou gemaakt."
    ],
    "es": [
      "Cocktail bar, mocktail, selección de cervezas, tapas, platos variados.\r\nEl Barbacane le da la bienvenida en un ambiente acogedor: música en directo, veladas temáticas, retransmisiones de partidos... tanto si está con amigos como en familia, el Barbacane está hecho para usted."
    ]
  },
  "rdfs:label": {
