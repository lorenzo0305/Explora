  "rdfs:comment": {
    "de": [
      "Unterricht im Freien, Spielmöglichkeit das ganze Jahr über. Preis für eine Stunde: 5 ?\r\nIn unmittelbarer Nähe des Schwimmbads, Entdeckung, Minigolf, Abenteuerparcours und Kletterwand."
    ],
    "en": [
      "Outdoor lessons, available all year round. Rates for one hour: 5 ?\r\nIn the immediate vicinity of the swimming pool, mini-golf, adventure course and climbing wall."
    ],
    "it": [
      "Lezioni all'aperto, disponibili tutto l'anno. Prezzi per un'ora: 5?\r\nNelle immediate vicinanze della piscina, mini-golf, percorso avventura e parete di arrampicata."
    ],
    "fr": [
      "Cours extérieur, possibilité de jouer toute l'année. Tarifs pour une heure : 5 €  . \r\nA proximité immédiate de la piscine, découverte, du mini-golf, du parcours aventure et du mur d'escalade."
    ],
    "es": [
      "Clases al aire libre, disponibles todo el año. Precio por hora: 5?\r\nEn las inmediaciones de la piscina, minigolf, recorrido de aventura y rocódromo."
    ],
    "nl": [
      "Buitenlessen, het hele jaar door. Prijzen voor een uur: 5?\r\nIn de directe omgeving van het zwembad, minigolf, avonturenparcours en klimmuur."
    ]
  },
