  "rdfs:comment": {
    "de": [
      "Lucie Ventadour fertigt Zeichnungen und Gemälde an. Sie leitet auch Workshops \"Zeichnen/Malen\" für Kinder, Jugendliche und Erwachsene (ganzjährig, vierteljährlich oder zu besonderen Anlässen während der Schulferien)."
    ],
    "en": [
      "Lucie Ventadour creates drawings and paintings. She also runs drawing/painting workshops for children, teenagers and adults (by the year, by the quarter or for special events during the school holidays)."
    ],
    "it": [
      "Lucie Ventadour crea disegni e dipinti. Tiene anche laboratori di disegno/pittura per bambini, adolescenti e adulti (all'anno, a trimestre o per eventi speciali durante le vacanze scolastiche)."
    ],
    "fr": [
      "Lucie Ventadour crée des dessins et des peintures. Elle anime aussi des ateliers \"dessin/peinture\" pour les enfants, les ados et les adultes (à l' année, au trimestre ou à l'occasion d'événements ponctuels pendant les vacances scolaires)."
    ],
    "nl": [
      "Lucie Ventadour maakt tekeningen en schilderijen. Ze geeft ook teken/schilderworkshops voor kinderen, tieners en volwassenen (per jaar, per kwartaal of voor speciale evenementen tijdens de schoolvakanties)."
    ],
    "es": [
      "Lucie Ventadour crea dibujos y pinturas. También organiza talleres de dibujo y pintura para niños, adolescentes y adultos (por año, por trimestre o para eventos especiales durante las vacaciones escolares)."
    ]
  },
