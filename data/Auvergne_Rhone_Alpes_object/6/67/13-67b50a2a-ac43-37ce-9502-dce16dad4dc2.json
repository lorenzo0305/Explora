  "rdfs:comment": {
    "de": [
      "Im Stadtzentrum von Die können Sie in einer freundlichen orientalischen Atmosphäre einen Tapetenwechsel erleben und Tagines, Couscous, Kebab, Chawirma, marokkanische Salate und orientalisches Gebäck genießen..."
    ],
    "en": [
      "In the center of Die, come and enjoy a change of scenery in a friendly oriental atmosphere with tagines, couscous, kebabs, chawirma, Moroccan salads, oriental pastries..."
    ],
    "it": [
      "Nel centro di Die, venite a cambiare scenario in un'accogliente atmosfera orientale con tagine, couscous, kebab, chawirma, insalate marocchine, pasticceria orientale..."
    ],
    "fr": [
      "En centre ville de Die, venez vous dépayser dans une ambiance orientale conviviale en dégustant tagines, couscous, kebabs, chawirma,s salades marocaines, pâtisseries orientales..."
    ],
    "nl": [
      "Kom in het centrum van Die even helemaal tot rust in een gezellige oosterse sfeer en geniet van tajine royal, couscous, kebab, chawirma, Marokkaanse salades, gebak..."
    ],
    "es": [
      "En el centro de Die, venga y disfrute de un cambio de aires en un agradable ambiente oriental con tagines, cuscús, kebabs, chawirma, ensaladas marroquíes, repostería oriental..."
    ]
  },
