  "rdfs:comment": {
    "de": [
      "Charmantes Hotel-Restaurant im Herzen der kleinen befestigten Stadt Bergues.\nVor Ort können Sie von einem Restaurant mit französischer Küche unter der Ägide eines in der Region bekannten Küchenchefs profitieren.\nDort erwartet Sie ein herzlicher Empfang. Sie können sich auch an der Bar oder in einer der Lounges entspannen."
    ],
    "en": [
      "Charming hotel-restaurant in the heart of the small fortified town of Bergues.\nOn-site, you'll enjoy a restaurant serving French cuisine, under the aegis of a chef renowned in the region.\nA warm welcome awaits you. You can also relax at the bar or in one of the lounges."
    ],
    "it": [
      "Hotel-ristorante di charme nel cuore della piccola città fortificata di Bergues.\nPotrete gustare la cucina francese nel ristorante in loco, sotto l'egida di uno chef rinomato nella regione.\nVi aspetta un caloroso benvenuto. Potrete inoltre rilassarvi nel bar o in uno dei salotti."
    ],
    "fr": [
      "Hôtel-restaurant de charme au cœur de la petite ville fortifiée de Bergues.\nSur place vous pourrez bénéficier d'un restaurant de cuisine française, sous l'égide d'un chef réputé dans la région.\nUn accueil chaleureux vous y attend. Vous pourrez également vous détendre au bar ou dans un des salons."
    ],
    "es": [
      "Hotel-restaurante con encanto en el corazón de la pequeña ciudad fortificada de Bergues.\nEn el restaurante del hotel podrá degustar la cocina francesa bajo la dirección de un chef de renombre en la región.\nLe espera una cálida acogida. También podrá relajarse en el bar o en uno de los salones."
    ],
    "nl": [
      "Charmant hotel-restaurant in het hart van het kleine vestingstadje Bergues.\nU kunt genieten van de Franse keuken in het restaurant ter plaatse, onder leiding van een chef-kok die bekend is in de regio.\nEr wacht u een warm welkom. U kunt ook ontspannen in de bar of in een van de salons."
    ]
  },
