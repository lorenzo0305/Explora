  "rdfs:comment": {
    "de": [
      "Die Cave de Cruet ist eine Mischung aus moderner Ausstattung und traditionellem Know-how, die es ihr ermöglicht, das ganze Jahr über anerkannte Weine aus Savoyen zu produzieren."
    ],
    "en": [
      "The Cave de Cruet winery combines modern facilities with traditional craftsmanship, enabling it to produce renowned Savoie wines all year round."
    ],
    "it": [
      "Attrezzature moderne e metodi tradizionali. È la ricetta dell'azienda vinicola Cave de Creut, produttrice di rinomati vini savoiardi."
    ],
    "fr": [
      "Equipement modernes et savoirs-faire traditionnels: voilà le mélange qu'opère la Cave de Cruet , lui permettant toute l'année de produire des Vins de Savoie reconnus."
    ],
    "nl": [
      "Moderne apparatuur en traditionele knowhow: dit is de mix die de Cave de Cruet hanteert, waardoor zij het hele jaar door erkende Savoyse wijnen kan produceren."
    ],
    "es": [
      "Equipamiento moderno y saber hacer tradicional: esta es la mezcla con la que opera la Cave de Cruet, que le permite producir reconocidos vinos de Saboya durante todo el año."
    ]
  },
