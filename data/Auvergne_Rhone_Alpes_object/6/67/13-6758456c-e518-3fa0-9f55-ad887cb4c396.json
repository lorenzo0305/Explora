  "rdfs:comment": {
    "de": [
      "Eine traditionelle, hausgemachte Küche aus frischen und hochwertigen Produkten. Thierry B., Le Cuisinier En 'Chanteur, seit mehreren Jahren erfolgreicher Solist, organisiert am Samstagabend eine Musikshow."
    ],
    "en": [
      "Traditional homemade cuisine made from fresh, high-quality products. Thierry B., Le Cuisinier En ‘Singer, soloist confirmed for several years, organizes a musical show on Saturday evening."
    ],
    "it": [
      "Cucina tradizionale fatta in casa con prodotti freschi e di qualità. Thierry B., Le Cuisinier En?chanteur, solista confermato da diversi anni, organizza uno spettacolo musicale il sabato sera."
    ],
    "fr": [
      "Une cuisine traditionnelle faite maison à partir de produits frais et de grande qualité. Thierry B., Le Cuisinier En ‘Chanteur, soliste confirmé depuis plusieurs années, organise le samedi soir  un spectacle musical."
    ],
    "nl": [
      "Traditionele huisgemaakte keuken van verse kwaliteitsproducten. Thierry B., Le Cuisinier En 'Chanteur, sinds enkele jaren een bevestigd solist, organiseert een muzikale show op zaterdagavond."
    ],
    "es": [
      "Cocina tradicional y casera con productos frescos y de calidad. Thierry B., Le Cuisinier En 'Chanteur, solista experimentado desde hace varios años, organiza un espectáculo musical los sábados por la noche."
    ]
  },
