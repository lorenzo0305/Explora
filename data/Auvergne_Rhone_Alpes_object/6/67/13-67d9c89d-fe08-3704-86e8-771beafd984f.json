  "rdfs:comment": {
    "de": [
      "Von dem kleinen Männerchor Les Maloni Fipagi. Leitung: Marc Oberlé\r\nSehnsuchtsvolle Melodien oder rhythmische Lieder, poetische Oden, militante Lieder oder Lieder der Hoffnung, Hymnen an Korsika oder geistliche oder weltliche Lieder aus der Welt?"
    ],
    "en": [
      "By the small men?s choir Les Maloni Fipagi. Conductor: Marc Oberlé\r\nLanguorous melodies or rhythmic songs, poetic odes, militant songs or songs of hope, hymns to Corsica or sacred or secular songs of the world?"
    ],
    "it": [
      "A cura del piccolo coro maschile Les Maloni Fipagi. Diretto da Marc Oberlé\r\nMelodie languide o canzoni ritmate, odi poetiche, canti militanti o canti di speranza, inni alla Corsica o canti sacri o profani del mondo?"
    ],
    "fr": [
      "Par le petit chœur d’hommes Les Maloni Fipagi. Direction : Marc Oberlé\r\nMélodies langoureuses ou chansons rythmées, odes poétiques, chants militants ou d’espoir, hymnes à la corse ou chants du monde sacrés ou profanes…"
    ],
    "es": [
      "Por el pequeño coro masculino Les Maloni Fipagi. Dirección: Marc Oberlé\r\nMelodías lánguidas o cantos rítmicos, odas poéticas, cantos militantes o cantos de esperanza, himnos a Córcega o cantos sagrados o profanos del mundo?"
    ],
    "nl": [
      "Door het klein mannenkoor Les Maloni Fipagi. Gedirigeerd door Marc Oberlé\r\nLyrische melodieën of ritmische liederen, poëtische odes, strijdliederen of liederen van hoop, lofzangen op Corsica of gewijde of wereldlijke liederen?"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Concert : chants polyphoniques du monde - Les rendez-vous de Surel"
    ]
  },
