  "rdfs:comment": {
    "de": [
      "Ferme Auberge d'altitude, Familienküche aus der Region, Snacks... Restaurant erreichbar mit dem kostenlosen Pendelbus Linie B ab dem Dorf Val Cenis Bramans. Reservierung empfohlen, Möglichkeit eines vegetarischen Menüs, Käsespezialitäten auf Reservierung."
    ],
    "en": [
      "High altitude farm inn, local family cuisine, snacks... Restaurant accessible by free shuttle bus Line B from the village of Val Cenis Bramans. Reservation recommended, vegetarian menu available, cheese specialities on reservation."
    ],
    "it": [
      "Agriturismo d'alta quota, cucina familiare locale, spuntini... Ristorante raggiungibile con la navetta gratuita Linea B dal villaggio di Val Cenis Bramans. Prenotazione consigliata, menù vegetariano disponibile, specialità di formaggi su prenotazione."
    ],
    "fr": [
      "Ferme Auberge d'altitude, cuisine familiale du terroir, goûter... Restaurant accessible par navette gratuite Ligne B au départ du village de Val Cenis Bramans. Réservation conseillée, possibilité de menu végétarien, spécialités fromagères sur réservation."
    ],
    "es": [
      "Posada agrícola de altura, cocina familiar local, aperitivos... Restaurante accesible con la línea B de autobús gratuito desde el pueblo de Val Cenis Bramans. Se recomienda reservar, menú vegetariano disponible, especialidades de queso bajo reserva."
    ],
    "nl": [
      "Hooggelegen boerenherberg, lokale familiekeuken, snacks... Restaurant bereikbaar met gratis pendelbus Lijn B vanuit het dorp Val Cenis Bramans. Reservering aanbevolen, vegetarisch menu beschikbaar, kaasspecialiteiten op reservering."
    ]
  },
  "rdfs:label": {
    "en": [
      "L'Etoile du Berger Farm Inn"
    ],
    "fr": [
      "Ferme Auberge d'altitude L'Etoile du Berger"
    ],
    "nl": [
      "Ferme Auberge d'Hötte L'Etoile du Berger"
    ]
  },
