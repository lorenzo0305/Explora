  "rdfs:comment": {
    "de": [
      "Florent Pagny wird 2026 mit einer außergewöhnlichen Tournee sein großes Comeback feiern. Er kommt zurück und ist bereit, starke Momente mit seinem Publikum zu teilen, in denen er alle seine Hits interpretieren wird. Wir sehen uns am 18., 19., 21. und 22. März 2026 in der LDLC Arena in Lyon-Décines."
    ],
    "en": [
      "Florent Pagny will be back in 2026 with an exceptional tour. He's back, ready to share some great moments with his fans, where he'll be performing all his hits. See you on March 18, 19, 21 and 22, 2026 at the LDLC Arena in Lyon-Décines."
    ],
    "it": [
      "Florent Pagny tornerà nel 2026 con un tour eccezionale. È tornato, pronto a condividere grandi momenti con i suoi fan, dove eseguirà tutti i suoi successi. Ci vediamo il 18, 19, 21 e 22 marzo 2026 all'Arena LDLC di Lione-Décines."
    ],
    "fr": [
      "Florent Pagny fera son grand retour en 2026 avec une tournée exceptionnelle. Il revient prêt à partager des moments forts avec son public, où il interprétera tous ses tubes. Rendez-vous les 18, 19, 21 et 22 mars 2026 à la LDLC Arena de Lyon-Décines."
    ],
    "es": [
      "Florent Pagny volverá en 2026 con una gira excepcional. Vuelve dispuesto a compartir grandes momentos con sus fans, donde interpretará todos sus éxitos. Nos vemos los días 18, 19, 21 y 22 de marzo de 2026 en el LDLC Arena de Lyon-Décines."
    ],
    "nl": [
      "Florent Pagny komt terug in 2026 met een uitzonderlijke tour. Hij is terug, klaar om mooie momenten te delen met zijn fans, waar hij al zijn hits ten gehore zal brengen. Tot ziens op 18, 19, 21 en 22 maart 2026 in de LDLC Arena in Lyon-Décines."
    ]
  },
