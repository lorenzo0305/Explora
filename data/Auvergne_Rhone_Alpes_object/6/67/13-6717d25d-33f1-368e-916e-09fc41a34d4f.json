  "rdfs:comment": {
    "de": [
      "In der Résidence L?Éclat des Vériaz tauchen Sie in die Welt der Daddy-Pool-Bereiche ein. Hier ist jedes Detail sorgfältig durchdacht, um Ihnen einen einzigartigen Aufenthalt zu ermöglichen."
    ],
    "en": [
      "At the Résidence L’Éclat des Vériaz, you will be immersed in the world of Daddy Pool spaces. Here, every detail has been carefully thought out to ensure you enjoy a unique stay."
    ],
    "it": [
      "All'interno della Résidence L'Éclat des Vériaz, sarete immersi nell'universo degli spazi Daddy Pool. Qui, ogni dettaglio è curato con attenzione per rendere il vostro soggiorno unico."
    ],
    "fr": [
      "Au sein de la Résidence L’Éclat des Vériaz, vous serez immergé dans l'univers des espaces Daddy Pool. Ici, chaque détail est soigneusement pensé pour un séjour unique."
    ],
    "nl": [
      "Op Résidence L?Éclat des Vériaz word je ondergedompeld in de wereld van Daddy Pool. Hier is over elk detail nagedacht om je verblijf uniek te maken."
    ],
    "es": [
      "En la Résidence L'Éclat des Vériaz, se sumergirá en el mundo de Daddy Pool. Aquí, cada detalle está cuidadosamente pensado para que su estancia sea única."
    ]
  },
