  "rdfs:comment": {
    "de": [
      "Das Werk wird 2023 von dem in Oyonnax ansässigen Künstler Laurent CLAVEAU geschaffen und von der Gesellschaft der Mitglieder der Ehrenlegion und großzügigen Spendern finanziert."
    ],
    "en": [
      "Created in 2023 by Oyonnax artist Laurent CLAVEAU, the work is financed by the Société des membres de la Légion d?honneur and generous donors."
    ],
    "it": [
      "Realizzata nel 2023 dall'artista di Oyonnax Laurent CLAVEAU, l'opera è finanziata dalla Société des membres de la Légion d'honneur e da generosi donatori."
    ],
    "fr": [
      "Réalisée en 2023 par l’artiste oyonnaxien Laurent CLAVEAU, l’œuvre est financée par la Société des membres de la Légion d’honneur et de généreux donateurs."
    ],
    "nl": [
      "Het werk, dat in 2023 wordt gemaakt door Laurent CLAVEAU, kunstenaar uit Oyonnax, wordt gefinancierd door de Société des membres de la Légion d'honneur en gulle gevers."
    ],
    "es": [
      "Creada en 2023 por el artista de Oyonnax Laurent CLAVEAU, la obra está financiada por la Société des membres de la Légion d'honneur y generosos donantes."
    ]
  },
