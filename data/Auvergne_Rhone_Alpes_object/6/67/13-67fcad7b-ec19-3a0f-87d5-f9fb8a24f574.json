  "rdfs:comment": {
    "de": [
      "Hotel - Restaurant *** mit 22 Zimmern.\r\nDas Chante-Grelet liegt 50 m vom Thermalbad entfernt und verfügt über eine Entspannungsblase (beheiztes Hallenbad, Sauna und Spa), eine private Terrasse und einen kostenlosen öffentlichen Parkplatz in der Nähe."
    ],
    "en": [
      "22-room *** hotel-restaurant.\r\nLocated 50 meters from the spa, Le Chante-Grelet features a relaxation bubble (heated indoor pool, sauna and spa), a private terrace and free public parking nearby."
    ],
    "it": [
      "Hotel - Ristorante *** con 22 camere.\r\nSituato a 50 metri dalle terme, Le Chante-Grelet dispone di un'area relax (piscina interna riscaldata, sauna e spa), di una terrazza privata e di un parcheggio pubblico gratuito nelle vicinanze."
    ],
    "fr": [
      "Hôtel - Restaurant  *** de 22 chambres.\r\nSitué à 50 mètres de l'établissement thermal, le Chante-Grelet dispose d'une bulle de détente (piscine couverte chauffée, sauna et spa), d'une terrasse privée et d'un parking public gratuit à proximité."
    ],
    "es": [
      "Hotel - Restaurante *** con 22 habitaciones.\r\nSituado a 50 metros del balneario, Le Chante-Grelet dispone de una zona de relajación (piscina cubierta climatizada, sauna y spa), una terraza privada y aparcamiento público gratuito en las inmediaciones."
    ],
    "nl": [
      "Hotel - Restaurant *** met 22 kamers.\r\nLe Chante-Grelet ligt op 50 meter van de spa en heeft een ontspanningsruimte (verwarmd binnenzwembad, sauna en spa), een eigen terras en gratis openbare parkeergelegenheid in de buurt."
    ]
  },
