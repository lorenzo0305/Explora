  "rdfs:comment": {
    "de": [
      "Begeben Sie sich auf eine fantastische Reise durch die Geschichte der Düsenflugzeuge! Auf über 25‘000 Quadratmetern (davon werden 5‘000 Quadratmeter abgedeckt) gibt es eine tolle Sammlung von 80 legendären Flugzeugen."
    ],
    "en": [
      "Embark on a fabulous journey through the history of jet aviation ! On more than 25,000 m² (including 5,000 m² covered), a fabulous collection of 80 legendary aircraft is available to you."
    ],
    "it": [
      "Partite per un favoloso viaggio nella storia dell'aviazione a reazione! Su 25.000 m² (di cui 5.000 coperti), viene offerta una favolosa collezione di quasi 80 aerei leggendari."
    ],
    "fr": [
      "Embarquez pour un fabuleux voyage à travers l'histoire de l'aviation à réaction ! Sur plus de 25 000 m² (dont 5 000 m² couverts), une fabuleuse collection de près de 80 avions de légende s'offre à vous."
    ],
    "nl": [
      "Ga op een fantastische reis door de geschiedenis van de luchtvaart! Op meer dan 25,000 m² (inclusief 5,000 m² overdekt) is een fantastische collectie van 80 legendarische vliegtuigen voor u beschikbaar."
    ],
    "es": [
      "Embárquese en un fabuloso viaje a través de la historia de la aviación a reacción En 25.000 m² (de los cuales 5.000 m² están cubiertos), se ofrece una fabulosa colección de cerca de 80 aviones legendarios."
    ]
  },
