  "rdfs:comment": {
    "de": [
      "Don Charlie ist eine freundliche Pizzeria im Herzen von Fort-Mahon-Plage, 200 m vom Strand entfernt. Spezialisiert auf handgemachte Pizzen und mit einer großen Auswahl an leckeren Rezepten, die mit frischen und hochwertigen Zutaten zubereitet werden.\nAuch zum Mitnehmen erhältlich."
    ],
    "en": [
      "Don Charlie, a friendly pizzeria in the heart of Fort-Mahon-Plage, 200m from the beach. Specializing in artisanal pizzas and offering a wide choice of gourmet recipes, prepared with fresh, quality ingredients.\nTakeaway available."
    ],
    "it": [
      "Don Charlie, un'accogliente pizzeria situata nel cuore di Fort-Mahon-Plage, a 200 metri dalla spiaggia. Specializzata in pizze fatte in casa, offre un'ampia scelta di ricette gourmet, preparate con ingredienti freschi e di qualità.\nPossibilità di asporto."
    ],
    "fr": [
      "Don Charlie, une pizzeria conviviale située au cœur de Fort-Mahon-Plage à 200m de la plage. Spécialisée dans les pizzas artisanales et proposant un large choix de recettes gourmandes, préparées avec des ingrédients frais et de qualité.\nPossibilité de vente à emporter."
    ],
    "es": [
      "Don Charlie, una pizzería acogedora situada en el corazón de Fort-Mahon-Plage, a 200 m de la playa. Especializada en pizzas caseras, ofrece una amplia selección de recetas gourmet elaboradas con ingredientes frescos y de calidad.\nComida para llevar."
    ],
    "nl": [
      "Don Charlie, een gezellige pizzeria in het hart van Fort-Mahon-Plage, op 200 meter van het strand. Gespecialiseerd in huisgemaakte pizza's en met een ruime keuze aan gastronomische recepten, bereid met verse kwaliteitsingrediënten.\nAfhaalmaaltijden beschikbaar."
    ]
  },
  "rdfs:label": {
