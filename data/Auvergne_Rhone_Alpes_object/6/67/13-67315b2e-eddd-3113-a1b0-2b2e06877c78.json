  "rdfs:comment": {
    "de": [
      "Bauernhof Auberge Campagnarde mit Blick auf das Tal. Küche am Holzfeuer (Trüffel und Salers-Fleisch). Züchter, Produzenten und Verarbeiter, Rind- und Kalbfleischwurst, Aligot, Käse vom Bauernhof."
    ],
    "en": [
      "Country inn with view on the valley. Wood-fired cooking (truffade and Salers meat). Breeders, producers and transformers, beef and veal sausages, aligot, farm cheeses."
    ],
    "it": [
      "Locanda di campagna con vista sulla valle. Cucina a legna (truffade e carne di Salers). Allevatori, produttori e trasformatori, salsicce di manzo e di vitello, aligot, formaggi di fattoria."
    ],
    "fr": [
      "Ferme Auberge campagnarde avec vue sur la vallée. Cuisine au feu de bois (truffade et viande Salers). Éleveurs, producteurs et transformateurs, charcuteries de boeuf, de veau, aligot, fromages fermiers."
    ],
    "es": [
      "Posada rural con vistas al valle. Cocina de leña (trufada y carne de Salers). Criadores, productores y transformadores, embutidos de vacuno, aligot, quesos de granja."
    ],
    "nl": [
      "Landelijke herberg met uitzicht op de vallei. Houtgestookt koken (truffade en Salers vlees). Fokkers, producenten en verwerkers, rundvleesworst, aligot, boerenkazen."
    ]
  },
