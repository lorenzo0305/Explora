  "rdfs:comment": {
    "de": [
      "Lust, in Büchern zu schmökern? Die Bibliothek empfängt Sie in einem farbenfrohen und freundlichen Raum. Ein vielfältiges Angebot an Büchern, Zeitschriften, Comics, DVDs und Hörbüchern für jedes Alter.\r\nDrei Bereiche: Kinder, Jugendliche, Erwachsene.\r\nComputer und WLAN stehen zur Verfügung."
    ],
    "en": [
      "Keen for a spot of reading? The library welcomes you into a colourful and friendly space. A variety of books, magazines, comics and DVDs are available for all ages.\r\nThree sections: children, young adult, adult"
    ],
    "it": [
      "Avete voglia di leggere? La biblioteca vi accoglie in uno spazio colorato e accogliente. Una vasta gamma di libri, riviste, fumetti, DVD e audiolibri per tutte le età.\r\nTre aree: bambini, adolescenti, adulti.\r\nComputer e wifi disponibili."
    ],
    "fr": [
      "Envie de bouquiner ? La bibliothèque vous accueille dans un espace coloré et convivial. Une offre variée de livres, magazines, BD, DVD et livres audio pour tout âge.\r\nTrois espaces : enfants, ados, adultes.\r\nOrdinateurs et wifi à disposition."
    ],
    "es": [
      "¿Tienes ganas de leer? La biblioteca le da la bienvenida en un espacio colorido y acogedor. Una amplia gama de libros, revistas, cómics, DVD y audiolibros para todas las edades.\r\nTres áreas: niños, adolescentes y adultos.\r\nOrdenadores y wifi disponibles."
    ],
    "nl": [
      "Zin om te lezen? De bibliotheek verwelkomt u in een kleurrijke en vriendelijke ruimte. Een breed scala aan boeken, tijdschriften, strips, dvd's en luisterboeken voor alle leeftijden.\r\nDrie gebieden: kinderen, tieners, volwassenen.\r\nComputers en wifi beschikbaar."
    ]
  },
