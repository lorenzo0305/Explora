  "rdfs:comment": {
    "de": [
      "Die französische Skischule ESF Notre Dame de Bellecombe bietet Gruppen- und Einzelunterricht für Alpinski und Snowboard. Ein kompetentes Team betreut Kinder ab drei Jahren in sicheren und auf ihre Bedürfnisse zugeschnittenen Kindergärten."
    ],
    "en": [
      "The Notre Dame de Bellecombe ESF offers downhill ski and snowboard lessons (group and private).  Trained staff look after children from the age of three in the specially-adapted and safe Jardins d’Enfants ."
    ],
    "it": [
      "L'ESF di Notre Dame de Bellecombe offre lezioni di gruppo e private di sci alpino e snowboard. I bambini vengono accolti a partire dai 3 anni da un team competente in asili sicuri e adattati."
    ],
    "fr": [
      "L'ESF de Notre Dame de Bellecombe vous propose des cours de ski alpin et de snowboard en cours collectifs ou en cours particuliers. Les enfants sont accueillis dés l'âge de 3 ans par une équipe compétente dans des jardins d'enfants sécurisés et adaptés."
    ],
    "es": [
      "La ESF de Notre Dame de Bellecombe ofrece clases grupales y privadas de esquí alpino y snowboard. Los niños son acogidos a partir de los 3 años por un equipo competente en guarderías seguras y adaptadas."
    ],
    "nl": [
      "De ESF van Notre Dame de Bellecombe biedt groeps- en privélessen in alpineskiën en snowboarden. Kinderen worden vanaf 3 jaar opgevangen door een competent team in beveiligde en aangepaste kleuterscholen."
    ]
  },
