  "rdfs:comment": {
    "de": [
      "Die Crêperie Ambulante Terre Mer verwöhnt Sie auf öffentlichen und privaten Veranstaltungen!\r\n\r\nGeburtstage, Aperitifs, Vereine, Betriebsräte, Festivals, Hochzeiten, Messen, Seminare, usw..."
    ],
    "en": [
      "Pancakes and patties Bio on site or to take away, party and events. Terre Mer has developed a new way to consume your pancakes and patties."
    ],
    "it": [
      "La Crêperie Ambulante Terre Mer vi accoglie per eventi pubblici e privati!\r\n\r\nCompleanni, aperitivi, associazioni, consigli di fabbrica, festival, matrimoni, fiere, seminari..."
    ],
    "fr": [
      "La Crêperie Ambulante Terre Mer vous régale sur les évènements publics et privés !\r\n\r\nAnniversaires, Apéritifs dînatoires, Assotiations, Comités d'entreprise, Festivals, Mariages, Salons, Séminaires, etc..."
    ],
    "es": [
      "La Crêperie Ambulante Terre Mer le invita a eventos públicos y privados\r\n\r\nCumpleaños, Aperitivos, Asociaciones, Comités de Empresa, Festivales, Bodas, Ferias, Seminarios, etc..."
    ],
    "nl": [
