  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Geschichte der Seife und die Etappen ihrer Herstellung. Angeschlossene Boutique, die dem Wohlbefinden gewidmet ist, mit Düften, Produkten aus der Region und Dekoration."
    ],
    "en": [
      "Discover the history of soap and how it is made. A 200m² shop with a large choice of products: wellness, home fragrances, decoration, local products and more."
    ],
    "it": [
      "Scoprite la storia del sapone e le fasi della sua fabbricazione. Negozio dedicato al benessere, con profumi, prodotti locali e decorazioni.\r\nÈ possibile assistere alla produzione attraverso un bovindo, a seconda degli orari di apertura e dell'attività in corso"
    ],
    "fr": [
      "Découvrez l'histoire du savon et les étapes de sa fabrication. Boutique dédiée au bien-être avec senteurs, produits du terroir et décoration.\r\nPossibilité d’observer la production à travers une baie vitrée,en fonction des horaires et de l'activité en cours"
    ],
    "nl": [
      "Zeepfabriek van Nyons: ontdek hoe zeep wordt gemaakt en woon de activiteiten van deze fabriek bij.\r\nEen winkel ernaast met wellnessprodukten, geuren, decoratie en streekproducten,"
    ],
    "es": [
      "Descubra la historia del jabón y las etapas de su fabricación. Tienda dedicada al bienestar, con aromas, productos locales y decoración.\r\nSe puede observar la producción a través de un mirador, según el horario de apertura y la actividad en curso"
    ]
  },
