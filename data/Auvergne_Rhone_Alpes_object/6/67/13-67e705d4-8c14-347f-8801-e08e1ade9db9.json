  "rdfs:comment": {
    "de": [
      "Wenn Sie sich nur einen Katzensprung von Ihrem Zuhause entfernt entspannen möchten, lassen Sie sich von unseren \"Instants Refuge\" im Spa d'Albane verführen."
    ],
    "en": [
      "If you want to relax just a stone's throw from home, let yourself be tempted by our \"Instants Refuge\" at the Spa d'Albane."
    ],
    "it": [
      "Se volete rilassarvi a pochi passi da noi, provate il nostro \"Rifugio Instants\" presso la Spa d'Albane."
    ],
    "fr": [
      "Pour vous relaxer à deux pas de chez vous, laissez vous tenter par nos « Instants Refuge » au Spa d’Albane."
    ],
    "es": [
      "Si desea relajarse a un tiro de piedra, pruebe nuestros \"Instants Refuge\" en el Spa d'Albane."
    ],
    "nl": [
      "Als je op een steenworp afstand wilt ontspannen, probeer dan onze \"Instants Refuge\" in de Spa d'Albane."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Spa d'Albane au Refuge Insolite en Bugey"
    ]
  },
