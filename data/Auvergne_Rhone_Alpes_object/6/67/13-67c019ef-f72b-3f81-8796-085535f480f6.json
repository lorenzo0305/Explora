  "rdfs:comment": {
    "de": [
      "Der junge Küchenchef Maxime Laurenson lädt Sie in sein Restaurant im Herzen der Lyoner Halbinsel ein. Dort bietet er eine gastronomische und zeitgenössische Bauernküche an, die aus saisonalen Rohprodukten von lokalen Erzeugern zubereitet wird."
    ],
    "en": [
      "The young chef Maxime Laurenson invites you to his restaurant in the heart of Lyon's Presqu'île district. He serves contemporary, fine-dining, country cuisine, prepared using raw, seasonal products from local producers."
    ],
    "it": [
      "Il giovane chef Maxime Laurenson vi invita nel suo ristorante nel cuore della Presqu'île di Lione. Propone una cucina contadina gastronomica e contemporanea, preparata con prodotti crudi di stagione provenienti da produttori locali."
    ],
    "fr": [
      "Le jeune Chef Maxime Laurenson vous donne rendez-vous dans son restaurant au cœur de la Presqu'île de Lyon. Il y propose une cuisine paysanne gastronomique et contemporaine, préparée à partir de produits de saison bruts et issus de producteurs locaux."
    ],
    "es": [
      "El joven chef Maxime Laurenson le invita a su restaurante en el corazón de la Presqu'île de Lyon. Propone una cocina de campo gastronómica y contemporánea, elaborada con productos crudos de temporada de productores locales."
    ],
    "nl": [
      "De jonge chef Maxime Laurenson nodigt u uit in zijn restaurant in het hart van het Presqu'île van Lyon. Hij stelt een gastronomische en eigentijdse landelijke keuken voor, bereid met rauwe seizoensproducten van lokale producenten."
    ]
  },
