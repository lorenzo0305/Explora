  "rdfs:comment": {
    "de": [
      "Seit 1926 Restaurant zwischen Dombes und Beaujolais am Ufer der Saône mit schattiger Terrasse, Lounge-Bar, handgemachtem Eis und Freiraum für Kinder. Spezialität: frische Frösche und \"hausgemachte\" Küche mit lokalen Produkten."
    ],
    "en": [
      "Since 1926, restaurant between Dombes and Beaujolais on the banks of the Saône with shaded terrace, lounge bar, artisanal ice creams and free space for children. Specialty : fresh frogs and home-made cooking with local products."
    ],
    "it": [
      "Dal 1926, ristorante tra le Dombes e il Beaujolais sulle rive della Saona con terrazza ombreggiata, lounge bar, gelati fatti in casa e spazio gratuito per i bambini. Specialità: rane fresche e cucina \"casalinga\" con prodotti locali."
    ],
    "fr": [
      "Depuis 1926, restaurant entre la Dombes et le Beaujolais en bord de Saône avec terrasse ombragée, bar lounge, glaces artisanales et espace liberté pour enfants. Spécialité : grenouilles fraîches et cuisine « fait maison»  avec des produits locaux."
    ],
    "nl": [
      "Sinds 1926, restaurant tussen Dombes en Beaujolais aan de oevers van de Saône met schaduwrijk terras, loungebar, huisgemaakt ijs en vrije ruimte voor kinderen. Specialiteit: verse kikkers en \"huisgemaakte\" keuken met lokale producten."
    ],
    "es": [
      "Desde 1926, restaurante entre el Dombes y el Beaujolais a orillas del Saona con terraza a la sombra, bar salón, helados artesanales y un espacio gratuito para los niños. Especialidad: ranas frescas y cocina \"casera\" con productos locales."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant Chez Bibet"
    ]
  },
