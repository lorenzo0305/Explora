  "rdfs:comment": {
    "de": [
      "La Cabane setzt sich mit einem einzigartigen Universum durch. Ein Ort des Lichts mit einer gemütlichen Atmosphäre, einem modernen Bergdekor in einem entspannten Ambiente. La Cabane erfindet die festliche Stimmung und die Gastronomie in der Höhe neu."
    ],
    "en": [
      "La Cabane stands out with a unique atmosphere. A bright venue with a cosy feel, combining modern mountain décor with a relaxed ambiance. La Cabane reinvents the festive spirit and alpine gastronomy at altitude."
    ],
    "it": [
      "La Cabane è un luogo unico. Un luogo di luce con un'atmosfera accogliente, un arredamento moderno di montagna e un ambiente rilassato. La Cabane reinventa lo spirito di festa e la gastronomia in quota."
    ],
    "fr": [
      "La Cabane s’impose avec un univers unique. Lieu de lumière avec une atmosphère cosy, un décor montagne moderne dans une ambiance décontractée. La Cabane réinvente l’esprit festif et la gastronomie en altitude."
    ],
    "nl": [
      "La Cabane onderscheidt zich door een uniek universum. Een lichte locatie met een gezellige sfeer, moderne bergdecoratie en een ontspannen ambiance. La Cabane heruitvindt de feestelijke beleving en de gastronomie in de bergen."
    ],
    "es": [
      "La Cabane es un lugar único. Un lugar de luz con una atmósfera acogedora, una decoración moderna de montaña y un ambiente relajado. La Cabane reinventa el espíritu festivo y la gastronomía de altura."
    ]
  },
  "rdfs:label": {
    "en": [
      "La Cabane Restaurant"
    ],
    "fr": [
      "Restaurant La Cabane"
    ],
    "nl": [
      "Restaurant La Cabane"
    ]
  },
