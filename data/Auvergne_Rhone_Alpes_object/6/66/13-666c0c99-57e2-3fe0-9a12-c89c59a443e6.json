  "rdfs:comment": {
    "de": [
      "Mit Blick auf den See, 2 km vom Stadtzentrum entfernt, eine qualitäts Küche.\r\nBezitzer zeit  drei Generation. Die Zimmer haben einen Blick auf den See oder auf dem Berg und verfügen über einen Flachbild -TV. Einige Zimmer verfügen über einen Balkon."
    ],
    "en": [
      "Facing the lake, 2 km from the city center, fine cuisine, third generation. The rooms have a view on the lake or on the mountain and include a flat-screen TV. Some rooms have a balcony."
    ],
    "it": [
      "Di fronte al lago, a 2 km dal centro città, cucina curata, terza generazione. Le camere hanno vista sul lago o sulle montagne e TV a schermo piatto. Alcune camere sono dotate di balcone."
    ],
    "fr": [
      "Face au lac, à 2 kilomètres du centre ville, cuisine soignée, troisième génération. Les chambres ont une vue  lac ou  montagne et disposent d'une télévision écran plat. Certaines chambres ont un balcon."
    ],
    "nl": [
      "Met uitzicht op het meer, op 2 kilometer van het stadscentrum, biedt dit restaurant van de derde generatie verfijnde gerechten. De kamers bieden uitzicht op het meer of de bergen en een flatscreen-tv. Sommige kamers hebben een balkon."
    ],
    "es": [
      "Frente al lago, a 2 km del centro de la ciudad, cocina bien preparada, tercera generación. Las habitaciones tienen vistas al lago o a la montaña y TV de pantalla plana. Algunas habitaciones tienen balcón."
    ]
  },
