  "rdfs:comment": {
    "de": [
      "Entdecken Sie \"EGGS-TRAORDINAIRE\", Materialdesigns aus Eierschalen (Schmuck und Accessoires). 9 experimentelle Texturen, die von der Biodiversität seiner Hühner inspiriert sind und beim Wettbewerb \"Artinov\" 2024 prämiert wurden!"
    ],
    "en": [
      "Discover \"EGGS-TRAORDINAIRE\", material designs in eggshells (jewelry and accessories). 9 experimental textures inspired by the biodiversity of our hens, winners of the \"Artinov\" 2024 competition!"
    ],
    "it": [
      "Scoprite \"EGGS-TRAORDINAIRE\", design materico in guscio d'uovo (gioielli e accessori). 9 texture sperimentali ispirate alla biodiversità delle sue galline e vincitrici del concorso \"Artinov\" 2024!"
    ],
    "fr": [
      "Découvrez \"EGGS-TRAORDINAIRE\", des designs matière en coquilles d'œuf (bijoux et accessoires). 9 textures expérimentales inspirées de la biodiversité de ses poules et récompensées au concours \"Artinov\" 2024 !"
    ],
    "nl": [
      "Ontdek \"EGGS-TRAORDINAIRE\", materiaalontwerpen in eierschalen (juwelen en accessoires). 9 experimentele texturen geïnspireerd op de biodiversiteit van de kippen en winnaars van de wedstrijd \"Artinov\" 2024!"
    ],
    "es": [
      "Descubra \"EGGS-TRAORDINAIRE\", diseños de materiales en cáscaras de huevo (joyas y accesorios). 9 texturas experimentales inspiradas en la biodiversidad de sus gallinas y ¡ganadoras del concurso \"Artinov\" 2024!"
    ]
  },
