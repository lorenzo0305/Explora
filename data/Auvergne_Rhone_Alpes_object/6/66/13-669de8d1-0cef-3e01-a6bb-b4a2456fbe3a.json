  "rdfs:comment": {
    "de": [
      "Die Halong-Bucht entführt Sie auf eine ganz neue kulinarische Reise. Ihr Know-how und die Frische ihrer Gerichte werden Ihnen ein unvergessliches Erlebnis bescheren."
    ],
    "en": [
      "Halong Bay will take you on a culinary journey of a new kind. Its know-how and the freshness of its dishes will make you live an unforgettable experience."
    ],
    "it": [
      "La Baia di Halong vi porterà in un viaggio culinario di una vita, la sua esperienza e la freschezza dei suoi piatti vi faranno vivere un'esperienza indimenticabile."
    ],
    "fr": [
      "La Baie d'Halong vous transporte dans un voyage culinaire inédit, son savoir-faire et la fraîcheur de ses plats vous feront vivre une expérience inoubliable."
    ],
    "es": [
      "La bahía de Halong le llevará a un viaje culinario de su vida, su experiencia y la frescura de sus platos le harán vivir una experiencia inolvidable."
    ],
    "nl": [
      "Halong Bay neemt u mee op een culinaire reis van uw leven, de expertise en de versheid van de gerechten geven u een onvergetelijke ervaring."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant La Baie d'Halong"
    ]
  },
