  "rdfs:comment": {
    "de": [
      "Entdecken Sie den aromatischen Reichtum der Oliven, die von der Familie Rocheville seit mehr als fünf Generationen produziert werden. Wir begrüßen Sie rund um die Olivenbar zu einer sensorischen Entdeckungsreise durch die auf dem Gut hergestellten Sorten und unsere Spezialitäten."
    ],
    "en": [
      "Come and discover the aromatic richness of the olives produced by the Rocheville family for over 5 generations. We welcome you around the olive bar for a sensory discovery of the varieties grown on the estate and our specialities."
    ],
    "it": [
      "Venite a scoprire la ricchezza aromatica delle olive prodotte dalla famiglia Rocheville da oltre 5 generazioni. Vi diamo il benvenuto intorno al bar delle olive per una scoperta sensoriale delle varietà prodotte nella tenuta e delle nostre specialità."
    ],
    "fr": [
      "Venez découvrir la richesse aromatique des olives produites par la famille Rocheville depuis plus de 5 générations. Nous vous accueillons autour du bar à olives pour une découverte sensorielle des variétés élaborées sur le domaine et de nos spécialités."
    ],
    "es": [
      "Venga a descubrir la riqueza aromática de las aceitunas producidas por la familia Rocheville desde hace más de 5 generaciones. Le damos la bienvenida en torno al bar de aceitunas para un descubrimiento sensorial de las variedades producidas en la finca y de nuestras especialidades."
    ],
    "nl": [
      "Kom en ontdek de aromatische rijkdom van de olijven die al meer dan 5 generaties door de familie Rocheville worden geproduceerd. We verwelkomen je rond de olijvenbar voor een zintuiglijke ontdekking van de variëteiten die op het domein worden geproduceerd en onze specialiteiten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Dégust'olives"
    ]
  },
