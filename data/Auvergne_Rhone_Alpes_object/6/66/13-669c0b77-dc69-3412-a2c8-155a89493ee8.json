  "rdfs:comment": {
    "de": [
      "Das Chalet les Saytels liegt ideal im Zentrum des Dorfes Le Grand-Bornand, in einer natürlichen Umgebung von großer Schönheit. Es ist eine 4-Sterne-Oase der Ruhe im Herzen der Aravis."
    ],
    "en": [
      "Ideally located in the center of the village of Le Grand-Bornand, in a beautiful natural setting, Chalet les Saytels is a 4-star haven of peace in the heart of the Aravis mountains."
    ],
    "it": [
      "Situato in posizione ideale nel centro del villaggio di Le Grand-Bornand, in una splendida cornice naturale, lo Chalet les Saytels è un'oasi di pace a 4 stelle nel cuore dei monti Aravis."
    ],
    "fr": [
      "Idéalement situé au centre du village du Grand-Bornand, dans un cadre naturel d’une grande beauté, le Chalet les Saytels est un havre de paix 4 étoiles au cœur des Aravis."
    ],
    "es": [
      "Idealmente situado en el centro del pueblo de Le Grand-Bornand, en un bello paraje natural, el Chalet les Saytels es un remanso de paz de 4 estrellas en el corazón de los montes Aravis."
    ],
    "nl": [
      "Chalet les Saytels is ideaal gelegen in het centrum van het dorp Le Grand-Bornand, in een prachtige natuurlijke omgeving. Het is een 4-sterren oase van rust in het hart van het Aravis-gebergte."
    ]
  },
