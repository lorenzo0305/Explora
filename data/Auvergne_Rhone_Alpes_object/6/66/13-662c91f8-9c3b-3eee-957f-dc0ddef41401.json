  "rdfs:comment": {
    "de": [
      "Valentin Jullien, diplomierter und unabhängiger Skilehrer, bietet Ihnen für jedes Alter und jedes Niveau in Albiez, Sybelles, Karellis und anderswo in der Maurienne Kurse für Alpinski, Tiefschneefahren, Tourenski, Snowboard sowie Tandem-Skifahren im Rollstuhl an."
    ],
    "en": [
      "Valentin Jullien, a qualified, independent ski instructor, offers alpine, off-piste, touring and snowboarding lessons, as well as tandem wheelchair skiing, for all ages and levels, in Albiez, Sybelles, Karellis and elsewhere in the Maurienne."
    ],
    "it": [
      "Valentin Jullien, maestro di sci qualificato e indipendente, offre lezioni per tutte le età e tutti i livelli ad Albiez, Sybelles, Karellis e altrove nella Maurienne, tra cui discesa, fuori pista, touring, snowboard e sci in tandem su sedia a rotelle."
    ],
    "fr": [
      "Valentin Jullien, moniteur de ski, diplômé et indépendant, vous propose pour tout âge et tout niveau, sur Albiez, Sybelles, Karellis et ailleurs en Maurienne, des cours de ski alpin, hors piste, randonnée, snowboard ainsi que du ski-fauteuil en tandem."
    ],
    "es": [
      "Valentin Jullien, monitor de esquí titulado e independiente, ofrece clases para todas las edades y niveles en Albiez, Sybelles, Karellis y otros lugares de la Maurienne, incluyendo esquí alpino, fuera de pista, de travesía, snowboard y tándem en silla de ruedas."
    ],
    "nl": [
      "Valentin Jullien, een gediplomeerde, onafhankelijke skileraar, biedt lessen voor alle leeftijden en niveaus in Albiez, Sybelles, Karellis en elders in de Maurienne, waaronder afdalingen, off-piste, toerskiën, snowboarden en tandemrolstoelskiën."
    ]
  },
  "rdfs:label": {
