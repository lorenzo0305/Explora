  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/b10b9278-7327-3ab4-a71c-2b6257347140",
      "dc:description": {
        "de": [
          "Oldtimer in Montreuil\nSonntag, 12. Oktober vormittags\nPlace du Général de Gaulle\n---------------------------\nRoute 62 bietet Ihnen ein letztes Treffen vor seiner Einwinterung am 26. desselben Monats.\n\nCredit: Route 62"
        ],
        "en": [
          "Classic cars in Montreuil\nSunday morning, October 12\nPlace du Général de Gaulle\n---------------------------\nRoute 62 invites you to a final gathering before its wintering on October 26.\n\nCredit: Route 62"
        ],
        "it": [
          "Auto d'epoca a Montreuil\nDomenica mattina 12 ottobre\nPiazza del Generale de Gaulle\n---------------------------\nLa Route 62 terrà il suo ultimo incontro prima dello svernamento il 26 ottobre.\n\nCredito: Route 62"
        ],
        "fr": [
          "Voitures anciennes à Montreuil\nDimanche 12 octobre le matin\nPlace du Général de Gaulle \n---------------------------\nRoute 62 vous propose un dernier rassemblement avant son hivernage le 26 du même mois.\n\nCrédit : Route 62"
        ],
        "nl": [
          "Klassieke auto's in Montreuil\nZondagochtend 12 oktober\nPlace du Général de Gaulle\n---------------------------\nRoute 62 houdt op 26 oktober zijn laatste bijeenkomst voor de overwintering.\n\nCredit: Route 62"
        ],
        "es": [
          "Coches clásicos en Montreuil\nDomingo 12 de octubre por la mañana\nPlaza del General de Gaulle\n---------------------------\nLa Ruta 62 celebrará su última reunión antes de invernar el 26 de octubre.\n\nCrédito: Route 62"
        ]
      },
      "@type": [
        "Description"
