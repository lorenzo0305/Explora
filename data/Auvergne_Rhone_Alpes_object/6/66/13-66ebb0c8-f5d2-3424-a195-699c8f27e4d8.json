  "rdfs:comment": {
    "de": [
      "Pierre und Christelle bieten eine Gastronomie mit den Aromen der verschiedenen Regionen, aus denen sie stammen und in denen sie gelebt haben: der Südwesten, Korsika, das Bourbonnais... All dies findet sich auf einer Speisekarte voller Kreativität, Nähe und Großzügigkeit."
    ],
    "en": [
      "Pierre and Christelle offer gastronomy with the flavours of the different regions they come from and have lived in: the South-West, Corsica, Bourbonnais... Their menu is full of creativity, proximity and generosity."
    ],
    "it": [
      "Pierre e Christelle propongono una gastronomia con i sapori delle diverse regioni da cui provengono e in cui hanno vissuto: il Sud-Ovest, la Corsica, il Bourbonnais... Il loro menu è ricco di creatività, vicinanza e generosità."
    ],
    "fr": [
      "Pierre et Christelle proposent une gastronomie aux parfums des différentes régions dont ils sont originaires et où ils ont vécu : le Sud-Ouest, la Corse, le Bourbonnais... Le tout au sein d'une carte pleine de créativité et de proximité et de générosité."
    ],
    "es": [
      "Pierre y Christelle ofrecen una gastronomía con los sabores de las diferentes regiones de las que proceden y en las que han vivido: el Suroeste, Córcega, Bourbonnais... Su carta está llena de creatividad, proximidad y generosidad."
    ],
    "nl": [
      "Pierre en Christelle bieden gastronomie met de smaken van de verschillende regio's waar ze vandaan komen en waar ze hebben gewoond: het zuidwesten, Corsica, Bourbonnais... Hun menu zit vol creativiteit, nabijheid en vrijgevigheid."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant La Table du Poète"
    ]
  },
