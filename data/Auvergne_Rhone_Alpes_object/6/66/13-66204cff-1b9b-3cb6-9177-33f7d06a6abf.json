  "rdfs:comment": {
    "de": [
      "Biologische, vorwiegend lokale Brote, bäuerliche Mehle. Unsere Rezepte werden alle in der Backstube entwickelt und gebacken."
    ],
    "en": [
      "We make organic natural yeast bread with local and organic flour, as well as savouries and sweets. We propose a large range of bread and snacking all made in our workshop, from exclusiely organic supplies, mainly local."
    ],
    "it": [
      "Pani prevalentemente locali e biologici prodotti con farine locali. Tutte le nostre ricette sono sviluppate e cotte nel nostro panificio."
    ],
    "fr": [
      "Pains biologiques essentiellement locaux, farines paysannes. Nos recettes sont toutes élaborées et cuites au fournil."
    ],
    "nl": [
      "Voornamelijk lokale, biologische broden gemaakt van lokaal meel. Al onze recepten worden ontwikkeld en gebakken in onze eigen bakkerij."
    ],
    "es": [
      "Panes mayoritariamente locales y ecológicos elaborados con harinas locales. Todas nuestras recetas se elaboran y hornean en nuestra propia panadería."
    ]
  },
