  "rdfs:comment": {
    "de": [
      "Felsklettern im Nationalpark Vanoise. In der Nähe des Monolithen von Sardières, einer lokalen geologischen Sehenswürdigkeit ersten Ranges. Freie Sicht inmitten einer natürlichen Waldumgebung im PNV."
    ],
    "en": [
      "Rock climbing in the Vanoise National Park. Close to the Sardières monolith, a local geological curiosity of the first order. Unobstructed views in a natural forest environment in the PNV."
    ],
    "it": [
      "Arrampicata"
    ],
    "fr": [
      "Escalade sur rocher dans le Parc National de la Vanoise. Proximité du monolithe de Sardières, une curiosité locale géologique de premier ordre. Vue dégagée au sein d'un environnement forestier naturel dans le PNV."
    ],
    "nl": [
      "Rotsklimmen in het Nationaal Park Vanoise. Vlakbij de monoliet van Sardières, een plaatselijke geologische bezienswaardigheid van de eerste orde. Vrij uitzicht in een natuurlijke bosomgeving in het Nationale Park Vanoise."
    ],
    "es": [
      "Escalada en el Parque Nacional de la Vanoise. Cerca del monolito de Sardières, curiosidad geológica local de primer orden. Vistas despejadas en un entorno forestal natural en el Parque Nacional de la Vanoise."
    ]
  },
  "rdfs:label": {
    "en": [
      "Climbing way La Roche qui pisse"
    ],
    "it": [
      "Via di arrampicata de la Roche qui pisse"
    ],
    "fr": [
      "Voie d'escalade de la Roche qui pisse"
    ],
    "nl": [
      "Klimpad La Roche qui pisse"
    ]
