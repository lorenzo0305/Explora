  "rdfs:comment": {
    "de": [
      "Im Rahmen des Programms Vichy Vitalité bietet Vichy Rando kostenlose Schnupperkurse für Gesundheitswanderungen an.\r\nInformationen und Anmeldung per Telefon."
    ],
    "en": [
      "As part of the Vichy Vitalité program, Vichy Rando offers free Rando Santé discovery sessions.\r\nInformation and registration by telephone."
    ],
    "it": [
      "Nell'ambito del programma Vichy Vitality, Vichy Rando offre sessioni introduttive gratuite di Rando Santé.\r\nInformazioni e iscrizioni telefoniche."
    ],
    "fr": [
      "Dans le cadre du programme Vichy Vitalité, Vichy Rando propose des séances gratuites de découverte de Rando Santé.\r\nRenseignements et inscription par téléphone."
    ],
    "es": [
      "En el marco del programa Vichy Vitalidad, Vichy Rando ofrece sesiones gratuitas de iniciación al Rando Santé.\r\nInformación e inscripciones por teléfono."
    ],
    "nl": [
      "Als onderdeel van het Vichy Vitaliteitsprogramma biedt Vichy Rando gratis kennismakingssessies in Rando Santé.\r\nInformatie en inschrijving per telefoon."
    ]
  },
  "rdfs:label": {
