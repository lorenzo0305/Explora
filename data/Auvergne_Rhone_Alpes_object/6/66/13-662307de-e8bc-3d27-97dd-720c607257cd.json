  "rdfs:comment": {
    "de": [
      "Dieses wunderschöne Karussell wird alle Kinder während Ihres Aufenthalts in Les 2 Alpes begeistern. Nutzen Sie die Gelegenheit, um mit Ihrer Familie eine kleine Zuckerwatte zu genießen!"
    ],
    "en": [
      "This beautiful carousel will delight all the children during your stay in Les 2 Alpes. Enjoy a little candyfloss with the whole family!"
    ],
    "it": [
      "Questo magnifico carosello porterà gioia a tutti i bambini durante il vostro soggiorno a Les 2 Alpes. Approfittatene per gustare uno zucchero filato in famiglia!"
    ],
    "fr": [
      "Ce magnifique carrousel fera la joie de tous les enfants durant votre séjour aux 2 Alpes. Profitez-en pour déguster une petite barbe à papa en famille !"
    ],
    "es": [
      "Este magnífico carrusel hará las delicias de todos los niños durante su estancia en Les 2 Alpes. ¡Disfrute de un pequeño carrusel con toda la familia!"
    ],
    "nl": [
      "Deze prachtige draaimolen zal alle kinderen in verrukking brengen tijdens je verblijf in Les 2 Alpes. Geniet van een suikerspin met het hele gezin!"
    ]
  },
  "rdfs:label": {
