  "rdfs:comment": {
    "de": [
      "Chantal empfängt Sie auf ihrem Bauernhof im Dorfzentrum an der Route des Freinets, wo Sie ihren Käse Abondance AOP und andere Produkte vom Bauernhof kaufen können."
    ],
    "en": [
      "Chantal welcomes you to her farm, located in the centre of the village on the Route des Freinets, where you can buy her Abondance PDO cheese."
    ],
    "it": [
      "Chantal vi dà il benvenuto nella sua fattoria, situata nel centro del paese sulla Route des Freinets, dove potrete acquistare il suo formaggio Abondance DOP e altri prodotti della fattoria."
    ],
    "fr": [
      "Chantal vous accueille à sa ferme, située dans le centre du village sur la route des Freinets, où vous pourrez acheter son fromage Abondance AOP et d'autres produits de la ferme."
    ],
    "es": [
      "Chantal le da la bienvenida a su granja, situada en el centro del pueblo, en la Route des Freinets, donde podrá comprar su queso Abondance DOP y otros productos de la granja."
    ],
    "nl": [
      "Chantal heet u welkom op haar boerderij, gelegen in het centrum van het dorp aan de Route des Freinets, waar u haar Abondance BOB kaas kunt kopen."
    ]
  },
