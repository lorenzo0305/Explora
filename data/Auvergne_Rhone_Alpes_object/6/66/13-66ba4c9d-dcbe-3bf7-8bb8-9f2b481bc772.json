  "rdfs:comment": {
    "de": [
      "Unser passioniertes Team bereitet Ihnen jeden Morgen Qualitätsbrot aus 100% französischem Mehl aus nachhaltiger Landwirtschaft sowie leckere und abwechslungsreiche Rezepte für Ihr Mittagessen zu!"
    ],
    "en": [
      "Every morning, our passionate team prepares quality bread, made with 100% French flours from sustainable agriculture, and a variety of delicious recipes for your breakfast!"
    ],
    "it": [
      "Ogni mattina, il nostro team di appassionati prepara pane di qualità, prodotto con farine 100% francesi provenienti da agricoltura sostenibile, e una varietà di gustose ricette per la vostra colazione!"
    ],
    "fr": [
      "Notre équipe de passionnés vous prépare tous les matins du pain de qualité, fabriqué à base de farines 100% françaises issues de l’agriculture raisonnée et des recettes gourmandes & variées pour votre déjeuner !"
    ],
    "nl": [
      "Elke ochtend bereidt ons team van enthousiastelingen kwaliteitsbrood, gemaakt van 100% Frans meel van duurzame landbouw, en een verscheidenheid aan smakelijke recepten voor je ontbijt!"
    ],
    "es": [
      "Cada mañana, nuestro equipo de entusiastas prepara pan de calidad, elaborado con harinas 100% francesas procedentes de la agricultura sostenible, y una gran variedad de sabrosas recetas para su desayuno"
    ]
  },
