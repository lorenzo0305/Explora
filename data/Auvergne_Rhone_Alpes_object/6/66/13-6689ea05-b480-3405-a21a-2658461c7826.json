  "rdfs:comment": {
    "de": [
      "Bistro-Atmosphäre in einem Gewölbekeller aus dem 16. Jahrhundert mit sichtbaren Steinmauern. Das Restaurant bietet eine regionale und großzügige Küche: Boeuf dauphinois, hausgemachte Pommes frites..."
    ],
    "en": [
      "Bistro atmosphere in a vaulted cellar from the 16th century with exposed stone walls. The restaurant offers regional and generous cuisine: beef from Dauphinois, homemade fries ..."
    ],
    "it": [
      "Atmosfera da bistrot in una cantina a volta del XVI secolo con pareti in pietra a vista. Il ristorante offre un'abbondante cucina regionale: manzo dauphinois, patatine fritte..."
    ],
    "fr": [
      "Ambiance bistrot dans une cave voûtée du XVIe siècle avec murs de pierres apparentes. Le restaurant propose une cuisine régionale et généreuse : bœuf dauphinois, frites maison..."
    ],
    "nl": [
      "Bistrosfeer in een 16e eeuwse gewelfde kelder met zichtbare stenen muren. Het restaurant biedt een royale regionale keuken: rundvlees dauphinois, huisgemaakte frieten..."
    ],
    "es": [
      "Ambiente de bistró en una bodega abovedada del siglo XVI con paredes de piedra vista. El restaurante sirve una generosa cocina regional: ternera Dauphinois, patatas fritas caseras..."
    ]
  },
