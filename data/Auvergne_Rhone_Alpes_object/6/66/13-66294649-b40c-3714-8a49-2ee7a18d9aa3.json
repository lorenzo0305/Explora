  "rdfs:comment": {
    "de": [
      "Flavie Dode Druide und Naturheilpraktikerin, ich bin die Nachfahrin von Kristallzüchtern und um ein Band des Lebens zu knüpfen, stelle ich Schmuck aus echten Kristallen her: Armbänder, Halsketten, Mala und biete echte Kristalle und Silberschmuck zum Verkauf an."
    ],
    "en": [
      "Flavie Dode Druid and Naturopath, I am a descendant of crystal weavers and to weave a link of Life I create Jewelry in genuine Crystals: bracelet, necklace, mala and offer genuine Crystals and Silver Jewelry for sale."
    ],
    "it": [
      "Flavie Dode Druida e Naturopata, sono discendente di tessitori di cristalli e per tessere un legame di Vita creo gioielli in cristalli autentici: bracciale, collana, mala e offro in vendita cristalli autentici e gioielli in argento."
    ],
    "fr": [
      "Flavie Dode Druide et Naturopathe, je suis descendante de cristalliers et pour tisser un lien de Vie je crée des Bijoux en Cristaux véritables : bracelet, collier, mala et propose à la vente des Cristaux véritables et des Bijoux en argent."
    ],
    "es": [
      "Flavie Dode Druida y Naturópata, soy descendiente de tejedores de cristales y para tejer un lazo de Vida creo Joyas en Cristales genuinos: pulsera, collar, mala y ofrezco Cristales genuinos y Joyas de Plata a la venta."
    ],
    "nl": [
      "Flavie Dode Druïde en Natuurgeneeskundige, ik ben een afstammeling van kristalwevers en om een schakel van het Leven te weven maak ik sieraden van echte kristallen: armband, ketting, mala en ik bied echte kristallen en zilveren sieraden te koop aan."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Cristaux & Bijoux Flavie Dode"
    ]
  },
