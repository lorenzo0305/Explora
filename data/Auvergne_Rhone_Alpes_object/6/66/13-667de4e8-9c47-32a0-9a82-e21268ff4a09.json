  "rdfs:comment": {
    "de": [
      "L'Estive du Haut, das sich kurz vor dem Parkplatz Les Ayes am Col du Coq niedergelassen hat, bietet einen kleinen Imbiss im Stil der Berge an: Diots, Bergplatten (Käse und Wurstwaren aus der Chartreuse) Kuchen und handwerklich gebrautes Bier, vor Ort oder zum Mitnehmen."
    ],
    "en": [
      "Located just before Les Ayes car park on the Col du Coq, l'Estive du Haut offers a range of mountain-style snacks: diots, mountain platters (Chartreuse cheese and charcuterie), tarts and traditional beers, available to eat in or take away."
    ],
    "it": [
      "Situato poco prima del parcheggio di Ayes al Col du Coq, l'Estive du Haut offre un piccolo ristorante di montagna: diots, taglieri di montagna (formaggi e salumi di Chartreuse), crostate e birre fatte in casa, sul posto o da asporto."
    ],
    "fr": [
      "Installé juste avant le parking des Ayes au col du Coq, l’Estive du Haut propose une petite restauration de type montagnarde : diots, plateaux montagnards (fromage et charcuterie Chartreuse) tartes et bières artisanales, sur place ou à emporter."
    ],
    "es": [
      "Situado justo antes del aparcamiento de Ayes, en el Col du Coq, el Estive du Haut ofrece un pequeño restaurante de montaña: diots, platos de montaña (quesos y charcutería de Chartreuse), tartas y cervezas artesanales, in situ o para llevar."
    ],
    "nl": [
      "Net voor de parkeerplaats van Ayes op de Col du Coq biedt l'Estive du Haut snacks in bergstijl: diots, bergschotels (Chartreuse kaas en vleeswaren), taarten en traditionele bieren, verkrijgbaar om ter plekke te eten of mee te nemen."
    ]
  },
