  "rdfs:comment": {
    "de": [
      "La Bulle, ein kultureller Dritter, der als einzigartiger Ort konzipiert wurde, wartet nur auf Sie! Gaming, Spielothek, Bibliothek, digitaler Raum, Café, Pressestelle - hier findet jeder sein Glück."
    ],
    "en": [
      "The library is a public amenity and helps meet everybody's needs in terms of education, information, personal development and leisure interests. Please speak to the team to assist them in providing you with the best possible service."
    ],
    "it": [
      "La Bulle, uno spazio culturale di terzi progettato per essere unico nel suo genere, vi aspetta! Ludoteca, ludoteca, biblioteca, spazio digitale, caffè, punto stampa: ce n'è per tutti i gusti."
    ],
    "fr": [
      "La Bulle, tiers-lieu culturel conçu pour être un espace unique en son genre n'attend plus que vous ! Gaming, ludothèque, bibliothèque, espace numérique, café, point presse chacun y trouvera son bonheur."
    ],
    "es": [
      "La biblioteca es un servicio público que contribuye a dar respuesta a las necesidades de todos, en el ámbito de la formación, la información, la cultura personal y el ocio. Nuestro equipo se encuentra a la escucha para dar una mejor respuesta a sus necesidades."
    ],
    "nl": [
      "La Bulle, een unieke culturele ruimte voor derden, wacht op jou! Gaming, spelotheek, bibliotheek, digitale ruimte, café, perspunt - er is voor elk wat wils."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Bulle - Tiers lieu culturel"
    ]
  },
