  "rdfs:comment": {
    "de": [
      "Das Wassersportstadion befindet sich im Herzen von Clermont-Ferrand, im Zentrum des metropolitanen öffentlichen Verkehrsnetzes, und verfügt über ein olympisches Becken sowie ein 25-m-Becken."
    ],
    "en": [
      "Located in the heart of Clermont-Ferrand, at the center of the metropolitan public transport network, the nautical stadium features an Olympic-size pool, as well as a 25 m pool."
    ],
    "it": [
      "Situato nel cuore di Clermont-Ferrand, al centro della rete di trasporti pubblici metropolitani, lo stadio nautico dispone di una piscina olimpionica e di una piscina di 25 metri."
    ],
    "fr": [
      "Situé en plein cœur de Clermont-Ferrand, au centre du réseau de transport en commun métropolitain, le stade nautique dispose d’un bassin olympique, ainsi qu’un un bassin de 25 m."
    ],
    "es": [
      "Situado en el corazón de Clermont-Ferrand, en el centro de la red de transporte público metropolitano, el estadio náutico cuenta con una piscina olímpica y otra de 25 metros."
    ],
    "nl": [
      "Gelegen in het hart van Clermont-Ferrand, in het centrum van het grootstedelijk openbaar vervoer, beschikt het nautisch stadion over een olympisch zwembad en een zwembad van 25 meter."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Stade nautique Pierre-de-Coubertin"
    ]
  },
