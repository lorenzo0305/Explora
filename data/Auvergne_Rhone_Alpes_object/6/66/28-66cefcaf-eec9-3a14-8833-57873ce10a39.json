  "rdfs:comment": {
    "de": [
      "Restaurant mit einem Angebot an traditionellen französischen Speisen, geöffnet von 12:00 bis 14:00 Uhr und von 19:00 bis 22:00 Uhr. Zimmerservice rund um die Uhr verfügbar.\n\nAnzahl der Gedecke: 120\nEmpfang von Gruppen: 120 Personen\nLetzte Dienste: 13.30 Uhr und 22.00 Uhr\nAn Wochenenden und Feiertagen geschlossen"
    ],
    "en": [
      "Restaurant offering traditional French cuisine, open from 12pm to 2pm and 7pm to 10pm. Room service available 24/7.\n\nNumber of seats: 120\nGroups welcome: 120 people\nLast service: 1:30 pm and 10:00 pm\nClosed on weekends and public holidays"
    ],
    "it": [
      "Ristorante di cucina tradizionale francese, aperto dalle 12.00 alle 14.00 e dalle 19.00 alle 22.00. Servizio in camera disponibile 24 ore su 24, 7 giorni su 7.\n\nNumero di coperti: 120\nAccoglienza gruppi: 120 persone\nUltimo servizio: 13.30 e 22.00\nChiuso nei fine settimana e nei giorni festivi"
    ],
    "fr": [
      "Restaurant avec une offre de restauration française traditionnelle, ouvert de 12h à 14h et de 19h à 22h. Room service disponible 24h/24 et 7j/7.\n\nNombre de couverts : 120\nAccueil groupes : 120 personnes \nDerniers services : 13h30 et 22h00\nFermé les weekends et jours feriés"
    ],
    "es": [
      "Restaurante de cocina tradicional francesa, abierto de 12h a 14h y de 19h a 22h. Servicio de habitaciones disponible las 24 horas.\n\nNúmero de cubiertos: 120\nAcogida de grupos: 120 personas\nÚltimo servicio: 13.30 h y 22 h\nCerrado los fines de semana y festivos"
    ],
    "nl": [
      "Restaurant met traditionele Franse keuken, geopend van 12.00 tot 14.00 uur en van 19.00 tot 22.00 uur. Roomservice 24/7 beschikbaar.\n\nAantal couverts: 120\nGroepen welkom: 120 personen\nLaatste dienst: 13.30 en 22.00 uur\nGesloten in het weekend en op feestdagen"
    ]
  },
