  "rdfs:comment": {
    "de": [
      "\"La fournée Langeadoise\" in der Rue du Pont 59 in Langeac bietet Ihnen Brot, Gebäck und Konditoreiwaren, die alle nach handwerklichen Methoden hergestellt werden."
    ],
    "en": [
      "\"La fournée Langeadoise\" at 59 rue du Pont in Langeac offers bread, pastries and cakes, all made by traditional methods."
    ],
    "it": [
      "\"La fournée Langeadoise\", situata al 59 di rue du Pont a Langeac, offre pane, dolci viennesi e torte, tutti preparati in modo tradizionale."
    ],
    "fr": [
      "\"La fournée Langeadoise\" située au 59 rue du Pont a Langeac vous propose pains, viennoiseries et pâtisseries le tout fabriqués de manière artisanale."
    ],
    "es": [
      "\"La fournée Langeadoise\", situada en el 59 rue du Pont de Langeac, ofrece pan, bollería y pastelería, todo ello elaborado de forma tradicional."
    ],
    "nl": [
      "\"La fournée Langeadoise\", gelegen aan 59 rue du Pont in Langeac, biedt brood, Weens gebak en taarten, allemaal gemaakt op de traditionele manier."
    ]
