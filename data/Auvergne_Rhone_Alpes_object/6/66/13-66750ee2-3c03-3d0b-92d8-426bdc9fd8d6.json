  "rdfs:comment": {
    "de": [
      "Regionale und traditionelle Savoyer Küche. Entdecken Sie die Gastlichkeit des Restaurants \"le Grenier\". Die aus Sternerestaurants herkömmliche Küchentruppe bietet Ihnen ihre köstliche Kochkunst basierend auf frischen Zutaten."
    ],
    "en": [
      "Enjoy traditional French and Savoyard cuisine in the welcoming \"Grenier\". The staff, trained in starred restaurants, will serve you delicious dishes made with fresh produce."
    ],
    "it": [
      "Condivisione e convivialità sono le parole d'ordine del ristorante \"le Grenier\"..."
    ],
    "fr": [
      "Partage et convivialité sont les maîtres mots du restaurant \"le Grenier\"..."
    ],
    "nl": [
      "Ontdek de gezelligheid van \"Le Grenier\" die streekgerechten en Savoyaardse specialiteiten serveert. Het team in de keuken, afkomstig van sterrenrestaurants, biedt een smaakvolle kaart gebaseerd op versproducten."
    ],
    "es": [
      "Compartir y convivir son las consignas del restaurante \"le Grenier\"..."
    ]
  },
