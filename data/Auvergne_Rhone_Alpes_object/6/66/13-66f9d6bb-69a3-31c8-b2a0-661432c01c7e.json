  "rdfs:comment": {
    "de": [
      "Vom großen See aus eine Schleife um das Tal der Reyssouze bis zum Plateau der Haute Bresse über die Höhen wie Grand Veyriat, Grand Villard, Montléger, Mons, Châtelet, Croix Noire... für landschaftliche Perspektiven."
    ],
    "en": [
      "From the large lake, a loop around the Reyssouze valley to the Haute Bresse plateau, taking in high points such as Grand Veyriat, Grand Villard, Montléger, Mons, Châtelet, Croix Noire... for panoramic views."
    ],
    "it": [
      "Dal grande lago si percorre un anello intorno alla valle di Reyssouze fino all'altopiano della Haute Bresse, passando per punti elevati come Grand Veyriat, Grand Villard, Montléger, Mons, Châtelet e Croix Noire, per ammirare panorami mozzafiato."
    ],
    "fr": [
      "Depuis le grand lac, une boucle autour de la vallée de la Reyssouze jusqu'au plateau de la Haute Bresse en passant sur les hauts comme le Grand Veyriat, le Grand Villard, le Montléger, Mons, le Châtelet, la Croix Noire... pour des perspectives paysages."
    ],
    "nl": [
      "Maak vanaf het grote meer een lus rond de Reyssouze-vallei naar het plateau van Haute Bresse, langs hoge punten als Grand Veyriat, Grand Villard, Montléger, Mons, Châtelet en Croix Noire, voor een aantal prachtige uitzichten."
    ],
    "es": [
      "Desde el gran lago, rodee el valle de Reyssouze hasta la meseta de Haute Bresse, pasando por puntos elevados como Grand Veyriat, Grand Villard, Montléger, Mons, Châtelet y Croix Noire, para disfrutar de unas vistas impresionantes."
    ]
  },
