  "rdfs:comment": {
    "de": [
      "MOS PUB Bellecour, eine Bar am Abend und ein Restaurant am Mittag, 50 m vom Place Bellecour entfernt, verfügt über eine Eckterrasse, zwei Etagen, eine Bierwand, Dartscheiben und vor allem über zahlreiche, das ganze Jahr über erneuerte Fassbiere."
    ],
    "en": [
      "A bar by night and restaurant at lunchtime, located 50 meters from Place Bellecour, MOS PUB Bellecour boasts a corner terrace, two floors, a beer wall, darts and, above all, a wide range of draught beers that are renewed throughout the year."
    ],
    "it": [
      "Bar di notte e ristorante a pranzo, situato a 50 metri da Place Bellecour, il MOS PUB Bellecour dispone di una terrazza d'angolo, due piani, una parete di birra, freccette e, soprattutto, un'ampia gamma di birre alla spina che vengono rinnovate durante tutto l'anno."
    ],
    "fr": [
      "Bar le soir et restaurant le midi, situé à 50 mètres de la place Bellecour, MOS PUB Bellecour possède une terrasse d'angle, deux étages, un mur à bières, des fléchettes et surtout de nombreuses bières pression renouvelées toute l'année."
    ],
    "nl": [
      "MOS PUB Bellecour is 's avonds een bar en 's middags een restaurant en ligt op 50 meter van Place Bellecour. Het heeft een hoekterras, twee verdiepingen, een biermuur, darts en vooral een ruim assortiment tapbieren dat het hele jaar door wordt vernieuwd."
    ],
    "es": [
      "Bar de noche y restaurante al mediodía, situado a 50 metros de la plaza Bellecour, MOS PUB Bellecour dispone de una terraza esquinera, dos plantas, un muro de cerveza, dardos y, sobre todo, una amplia gama de cervezas de barril que se renuevan a lo largo del año."
    ]
  },
