  "rdfs:comment": {
    "de": [
      "Ein unvergessliches und klassifiziertes Panorama über das Rhône-Tal."
    ],
    "en": [
      "Zoom in on a remarkable view over the Rhone Valley : the “defile” of Saint-Vallier where the river Rhône meanders along a 400-metre deep gorge dug out 6 million years ago following an earthquake. Best seen from the village of Ozon."
    ],
    "it": [
      "Un panorama indimenticabile e classificato della Valle del Rodano: uno dei punti panoramici più belli della zona. Da questo belvedere naturale, i visitatori possono ammirare il maestoso fiume, le colline viticole e persino le Alpi in lontananza."
    ],
    "fr": [
      "Un panorama inoubliable et classé sur la Vallée du Rhône: l’un des plus beaux points de vue du secteur. Depuis ce belvédère naturel, les visiteurs peuvent embrasser d’un seul regard le fleuve majestueux, les coteaux viticoles, et même les Alpes au loin."
    ],
    "es": [
      "Un panorama inolvidable y clasificado del valle del Ródano: uno de los mejores miradores de la zona. Desde este mirador natural, los visitantes pueden contemplar el majestuoso río, las laderas vitícolas e incluso los Alpes a lo lejos."
    ],
    "nl": [
      "Een onvergetelijk, geclassificeerd panorama van de Rhônevallei."
    ]
  },
  "rdfs:label": {
