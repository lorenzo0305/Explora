  "rdfs:comment": {
    "de": [
      "Das Centre d'art Jean-Prouvé zeigt die Werke aus der Schenkung von Kim En Joong, einem international bekannten Künstler, der für seine Gemälde und Keramiken bekannt ist. Diese Kulturstätte beherbergt außerdem 4 Wechselausstellungen zeitgenössischer Kunst."
    ],
    "en": [
      "The Jean Prouvé Centre presents the donation of Kim En Joong, an internationally renowned artist (paintings and ceramics) and hosts a temporary art exhibition every summer (see \"agenda\")."
    ],
    "it": [
      "Il Centre d'art Jean-Prouvé presenta opere donate da Kim En Joong, artista di fama internazionale noto per i suoi dipinti e le sue ceramiche. Questo sito culturale ospita anche 4 mostre temporanee di arte contemporanea."
    ],
    "fr": [
      "Le Centre d'art Jean-Prouvé présente les œuvres de la donation de Kim En Joong, artiste de renommée internationale reconnu pour ses œuvres de peinture et de céramiques. Ce site culturel accueille également 4 expositions temporaires d'art contemporain."
    ],
    "nl": [
      "Het Centre d'art Jean-Prouvé presenteert werken geschonken door Kim En Joong, een internationaal bekende kunstenaar die bekend staat om zijn schilderijen en keramiek. Op deze culturele locatie worden ook 4 tijdelijke tentoonstellingen van hedendaagse kunst gehouden."
    ],
    "es": [
      "El Centre d'art Jean-Prouvé presenta obras donadas por Kim En Joong, artista de fama internacional reconocido por sus pinturas y cerámicas. Este recinto cultural también acoge 4 exposiciones temporales de arte contemporáneo."
    ]
  },
  "rdfs:label": {
    "en": [
      "Jean Prouvé Cultural Centre"
    ],
    "fr": [
      "Centre d'art contemporain Jean Prouvé"
    ]
  },
