  "rdfs:comment": {
    "de": [
      "Als erste Weinkellerei, die sich ganz den Winzern widmet, die der Fédération des Vignerons Indépendants de France angehören, lädt LACVI Sie ein, französische Weine zu entdecken, die mit Liebe und Leidenschaft und mit Respekt für das Terroir hergestellt werden."
    ],
    "en": [
      "The first wine cellar entirely dedicated to members of the Fédération des Vignerons Indépendants de France, LACVI invites you to discover French wines produced with love and passion, respecting the terroir."
    ],
    "it": [
      "LACVI è la prima cantina interamente dedicata ai viticoltori membri della Fédération des Vignerons Indépendants de France e vi invita a scoprire i vini francesi prodotti con amore e passione, nel rispetto del terroir."
    ],
    "fr": [
      "Première cave entièrement dédiée aux vignerons adhérents à la Fédération des Vignerons Indépendants de France, LACVI vous invite à la découverte de vins français produits avec amour et passion, dans le respect du terroir."
    ],
    "nl": [
      "LACVI is de eerste wijnkelder die volledig gewijd is aan de wijnbouwers die lid zijn van de Federatie van Onafhankelijke Wijnbouwers van Frankrijk. LACVI nodigt u uit om Franse wijnen te ontdekken die met liefde en passie worden geproduceerd, met respect voor de bodem."
    ],
    "es": [
      "LACVI es la primera bodega enteramente dedicada a los viticultores miembros de la Fédération des Vignerons Indépendants de France, y le invita a descubrir vinos franceses producidos con amor y pasión, respetando el terruño."
    ]
  },
  "rdfs:label": {
    "de": [
      "LACVI - La Cave des Vignerons Indépendants (Der Weinkeller der unabhängigen Winzer)"
    ],
    "en": [
      "LACVI - La Cave des Vignerons Indépendants"
    ],
    "it": [
      "LACVI - La Grotta dei Vignaioli Indipendenti"
    ],
    "fr": [
      "LACVI - La Cave des Vignerons Indépendants"
    ],
    "es": [
      "LACVI - La Cueva de los Viticultores Independientes"
    ]
  },
