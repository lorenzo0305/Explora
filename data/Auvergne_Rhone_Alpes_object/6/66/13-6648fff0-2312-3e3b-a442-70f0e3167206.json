  "rdfs:comment": {
    "de": [
      "Die Tänzerin und Choreographin Marie-Claude Pietragalla verwandelt sich auf der Bühne in die legendäre Barbara.  Sie wird zum lebenden Echo der Sängerin und lässt das Publikum in die poetische und melancholische Welt der Künstlerin eintauchen."
    ],
    "en": [
      "Dancer-choreographer Marie-Claude Pietragalla transforms herself on stage to embody the legendary Barbara.  She becomes a living echo of the singer, immersing the audience in her melancholy, poetic universe."
    ],
    "it": [
      "La ballerina e coreografa Marie-Claude Pietragalla veste i panni della leggendaria Barbara.  Diventa un'eco vivente della cantante, immergendo il pubblico nel suo mondo poetico e malinconico."
    ],
    "fr": [
      "Marie-Claude Pietragalla, danseuse et chorégraphe, se transforme sur scène pour incarner la mythique Barbara.  Elle devient l’écho vivant de la chanteuse, plongeant le public dans l’univers poétique et empreint de mélancolie de l’artiste."
    ],
    "es": [
      "La bailarina y coreógrafa Marie-Claude Pietragalla sube al escenario como la legendaria Barbara.  Se convierte en un eco vivo de la cantante, sumergiendo al público en su mundo poético y melancólico."
    ],
    "nl": [
      "Danseres en choreografe Marie-Claude Pietragalla betreedt het podium als de legendarische Barbara.  Ze wordt een levende echo van de zangeres en dompelt het publiek onder in haar poëtische, melancholische wereld."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Spectacle de Pietragalla : Barbara"
    ]
  },
