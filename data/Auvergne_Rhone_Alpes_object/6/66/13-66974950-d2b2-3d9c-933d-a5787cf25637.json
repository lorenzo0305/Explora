  "rdfs:comment": {
    "de": [
      "Ein Geldautomat ist an der Fassade des Gebäudes frei zugänglich.\r\nTerminvereinbarungen sind über die Website von Dienstag bis Freitag von 13:30 bis 18:15 Uhr möglich."
    ],
    "en": [
      "A cash dispenser is freely accessible on the front of the building.\r\nAppointments can be made via the website from Tuesday to Friday, 1:30 pm to 6:15 pm."
    ],
    "it": [
      "Un bancomat è liberamente accessibile nella parte anteriore dell'edificio.\r\nÈ possibile fissare un appuntamento tramite il sito web dal martedì al venerdì tra le 13.30 e le 18.15."
    ],
    "fr": [
      "Un distributeur de billets est en libre accès sur la façade du bâtiment.\r\nPossibilité de prise de rendez-vous sur le site internet du mardi au vendredi de 13h30 à 18h15."
    ],
    "es": [
      "En la fachada del edificio hay un cajero automático de libre acceso.\r\nLas citas pueden concertarse a través del sitio web de martes a viernes entre las 13.30 y las 18.15 horas."
    ],
    "nl": [
      "Een geldautomaat is vrij toegankelijk aan de voorkant van het gebouw.\r\nAfspraken kunnen worden gemaakt via de website van dinsdag tot en met vrijdag tussen 13.30 en 18.15 uur."
    ]
  },
