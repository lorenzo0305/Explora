  "rdfs:comment": {
    "de": [
      "Die erste nachfüllbare Make-up-Marke, die zu 100 % natürlich und von Ecocert bio* zertifiziert ist;\r\nFür eine noch konsequentere Vorgehensweise hat ZAO natürliche Verpackungen aus Bambus mit einem modernen und eleganten Design entworfen.\r\n\r\nErhältlich in Boutiquen und im Internet!"
    ],
    "en": [
      "The first refillable make-up brand, 100% natural and certified organic* by Ecocert;\r\nFor an even more consistent approach, ZAO has created natural bamboo packaging, with a modern, elegant design.\r\n\r\nOn sale in boutiques and online!"
    ],
    "it": [
      "Il primo marchio di make-up ricaricabile, 100% naturale e certificato biologico* da Ecocert;\r\nPer un approccio ancora più coerente, ZAO ha creato una confezione in bambù naturale dal design moderno ed elegante.\r\n\r\nIn vendita nei negozi e su Internet!"
    ],
    "fr": [
      "La première marque de maquillage rechargeable, 100 % Naturelle et certifiée Bio* par Ecocert;\r\nPour une démarche encore plus cohérente ZAO a crée des packagings naturels en bambou, au design moderne et élégant.\r\n\r\nEn vente en boutique et sur internet !"
    ],
    "es": [
      "La primera marca de maquillaje rellenable, 100% natural y certificado ecológico* por Ecocert;\r\nPara un enfoque aún más coherente, ZAO ha creado envases de bambú natural con un diseño moderno y elegante.\r\n\r\nA la venta en tiendas y en Internet"
    ],
    "nl": [
      "Het eerste navulbare make-up merk, 100% natuurlijk en biologisch gecertificeerd* door Ecocert;\r\nVoor een nog consequentere aanpak heeft ZAO verpakkingen van natuurlijk bamboe ontworpen met een modern, elegant design.\r\n\r\nTe koop in de winkels en online!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "COSM'ETIKA FRANCE SARL"
    ]
  },
