  "rdfs:comment": {
    "de": [
      "Die am Rande des Boulevard Joseph Vallier errichtete Saint Jean ist mit ihrer originellen, auf Stelzen stehenden Kreisform sicherlich die markanteste neue Kirche in Grenoble."
    ],
    "en": [
      "Built along the Boulevard Joseph Vallier, Saint Jean is certainly, by its original circular shape perched on stilts, the most striking new church in Grenoble."
    ],
    "it": [
      "Costruita lungo il Boulevard Joseph Vallier, Saint Jean è sicuramente, con la sua originale forma circolare arroccata su palafitte, la nuova chiesa più suggestiva di Grenoble."
    ],
    "fr": [
      "Édifiée en bordure du boulevard Joseph Vallier, Saint Jean est certainement, par son originale forme circulaire juchée sur pilotis, l'église nouvelle de Grenoble la plus marquante."
    ],
    "nl": [
      "Saint Jean, gebouwd langs de Boulevard Joseph Vallier, is met zijn oorspronkelijke ronde vorm op palen zeker de meest opvallende nieuwe kerk van Grenoble."
    ],
    "es": [
      "Construida a lo largo del bulevar Joseph Vallier, Saint Jean es sin duda, con su original forma circular encaramada sobre pilotes, la iglesia nueva más llamativa de Grenoble."
    ]
  },
