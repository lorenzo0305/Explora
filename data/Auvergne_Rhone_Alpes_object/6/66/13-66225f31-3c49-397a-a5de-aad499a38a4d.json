  "rdfs:comment": {
    "de": [
      "Erleben Sie eine Entdeckungsreise ins Herz der Berge dank des Schneemobils, sobald die Pisten geschlossen sind.\r\nAuf einem genehmigten und für diese Aktivität gewidmeten Gelände."
    ],
    "en": [
      "Come for a voyage of discovery in the mountains on a snowmobile ride after the slopes have closed.\r\nOn an authorised route specifically for the activity."
    ],
    "it": [
      "Venite a vivere un viaggio di scoperta nel cuore delle montagne con una motoslitta non appena le piste si chiudono.\r\nSu terreni autorizzati e dedicati all'attività."
    ],
    "fr": [
      "Venez vivre un voyage de découverte au cœur de la montagne grâce à la motoneige dès la fermeture des pistes.\r\nSur un terrain autorisé et dédié à l'activité."
    ],
    "es": [
      "Venga a vivir un viaje de descubrimiento en plena montaña con una moto de nieve en cuanto se cierren las pistas.\r\nEn terrenos autorizados dedicados a la actividad."
    ],
    "nl": [
      "Kom een ontdekkingsreis beleven in het hart van de bergen, dank zij de sneeuwscooter, na het sluiten van de skipistes.\r\nOp een geautoriseerde site die gewijd is aan de activiteit."
    ]
  },
