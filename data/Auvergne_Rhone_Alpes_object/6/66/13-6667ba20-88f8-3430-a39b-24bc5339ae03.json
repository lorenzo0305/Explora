  "rdfs:comment": {
    "de": [
      "Dieses Lokal im Zentrum von Lezoux, gegenüber dem Rathaus, bietet Ihnen einen freundlichen Empfang und eine qualitativ hochwertige Küche. Die Chefin \"restauratrice d'Auvergne\" wird Sie mit ihrer regionalen Küche verwöhnen."
    ],
    "en": [
      "Located in the center of Lezoux, opposite the town hall, the restaurant offers a warm welcome and quality cuisine. The \"restaurateur d'Auvergne\" chef will introduce you to her local cuisine."
    ],
    "it": [
      "Situato nel centro di Lezoux, di fronte al municipio, questo ristorante offre un'accoglienza calorosa e una cucina di qualità. Lo chef \"restaurateur d'Auvergne\" vi farà conoscere la sua cucina locale."
    ],
    "fr": [
      "Établissement dans le centre de Lezoux, face à la mairie, où vous sera réservé un accueil convivial, avec une cuisine de qualité. La cheffe « restauratrice d'Auvergne » vous fera découvrir sa cuisine de terroir."
    ],
    "es": [
      "Situado en el centro de Lezoux, frente al ayuntamiento, este restaurante le ofrece una cálida acogida y una cocina de calidad. La chef \"restaurateur d'Auvergne\" le hará descubrir su cocina local."
    ],
    "nl": [
      "Dit restaurant ligt in het centrum van Lezoux, tegenover het gemeentehuis, en biedt een warm onthaal en een kwaliteitskeuken. De chef-kok \"restaurateur d'Auvergne\" laat je kennismaken met haar lokale keuken."
    ]
  },
  "rdfs:label": {
