  "rdfs:comment": {
    "de": [
      "Dieser neue Kulturraum dient mehreren Zwecken: Kunst, Musik, Kulturerbe, Traditionen, lokales Leben. Entdecken Sie einen permanenten Ausstellungsraum für mechanische Musikinstrumente in der Kapelle und einen Raum für temporäre Ausstellungen im Kreuzgang."
    ],
    "en": [
      "This new cultural space has multiple vocations: art, music, heritage, traditions and local life. Discover a permanent exhibition space for mechanical musical instruments in the chapel and a temporary exhibition space in the cloister."
    ],
    "it": [
      "Questo nuovo spazio culturale ha molteplici vocazioni: arte, musica, patrimonio, tradizioni e vita locale. Nella cappella è allestita una mostra permanente di strumenti musicali meccanici e nel chiostro uno spazio espositivo temporaneo."
    ],
    "fr": [
      "Ce nouvel espace culturel est à vocations multiples : art, musique, patrimoine, traditions, vie locale. Découvrez un espace d’exposition permanent d’instruments de musique mécanique dans la chapelle et un espace d’expositions temporaires dans le cloître."
    ],
    "es": [
      "Este nuevo espacio cultural tiene múltiples vocaciones: arte, música, patrimonio, tradiciones y vida local. Hay una exposición permanente de instrumentos musicales mecánicos en la capilla y un espacio de exposiciones temporales en el claustro."
    ],
    "nl": [
      "Deze nieuwe culturele ruimte heeft meerdere roepingen: kunst, muziek, erfgoed, tradities en het lokale leven. Er is een permanente tentoonstelling van mechanische muziekinstrumenten in de kapel en een tijdelijke tentoonstellingsruimte in de kloostergang."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Secret des Temps"
    ]
  },
