  "rdfs:comment": {
    "de": [
      "Er liegt in den Gemeinden Mazeyrat d'Allier (ehemals Saint Eble), Saint-Arcons-d'Allier und Vissac-Auteyrac am Rande der RN 590. Er wird auf 1.920.000 Jahre datiert und überragt mit seinen 1.041 m Höhe das Langeadois und das Becken von Paulhaguet."
    ],
    "en": [
      "Located in the communes of Mazeyrat d'Allier (formerly Saint-Eble), Saint-Arcons-d'Allier and Vissac-Auteyrac, along the RN 590, it dates back 1,920,000 years, and dominates the Langeadois and Paulhaguet basins from its height of 1,041 metres."
    ],
    "it": [
      "Situato nei comuni di Mazeyrat d'Allier (ex Saint-Eble), Saint-Arcons-d'Allier e Vissac-Auteyrac, lungo la RN 590, risale a 1.920.000 anni fa e domina il Langeadois e il bacino del Paulhaguet da un'altitudine di 1.041 metri."
    ],
    "fr": [
      "Situé sur les communes de Mazeyrat d'Allier (ex-Saint-Eble), de Saint-Arcons-d'Allier et de Vissac-Auteyrac, en bordure de la RN 590, il est daté de 1.920.000 ans, et domine le Langeadois et le bassin de Paulhaguet, du haut de ses 1.041 mètres d'altitude."
    ],
    "es": [
      "Situado en los municipios de Mazeyrat d'Allier (antiguo Saint-Eble), Saint-Arcons-d'Allier y Vissac-Auteyrac, junto a la RN 590, data de hace 1.920.000 años y domina el Langeadois y la cuenca del Paulhaguet desde una altitud de 1.041 metros."
    ],
    "nl": [
      "Gelegen in de gemeenten Mazeyrat d'Allier (voorheen Saint-Eble), Saint-Arcons-d'Allier en Vissac-Auteyrac, langs de RN 590, dateert het van 1.920.000 jaar geleden en domineert het de Langeadois en het Paulhaguet bekken vanaf een hoogte van 1.041 meter."
    ]
  },
