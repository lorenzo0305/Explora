  "rdfs:comment": {
    "de": [
      "Entdeckungsflug von 20 min bis 90 min im zweisitzigen Paramotor. Oder 60 Minuten im Heißluftballon mit David (4 Stunden Abenteuer). Zu allen Jahreszeiten. Zugänglich für alle ab 1,40 m (Erfahrung mit Flügen für Menschen mit Behinderungen, Prüfung von Fall zu Fall)."
    ],
    "en": [
      "Discovery flight of 20 min to 90 min in a two-seater paramotor. Or 60 min in a hot-air balloon with David (4h adventure). All seasons. Accessible to all from 1.40m (experience of flights for disabled people, studied on a case-by-case basis)."
    ],
    "it": [
      "Volo di scoperta da 20 a 90 minuti in paramotore biposto. Oppure 60 minuti in mongolfiera con David (4 ore di avventura). Tutte le stagioni. Accessibile a tutti a partire da 1,40 m (esperienza di voli per persone con disabilità, studiata caso per caso)."
    ],
    "fr": [
      "Vol découverte de 20 min à 90 min en paramoteur bi-places. Ou de 60 min en montgolfière avec David (4h d’aventure). Toutes saisons. Accessible à tous à partir de 1.40m (expérience de vols pour personnes en situation de handicap, étude au cas par cas)."
    ],
    "es": [
      "Vuelo de descubrimiento de 20 min a 90 min en paramotor biplaza. O 60 minutos en globo aerostático con David (4 horas de aventura). Todas las temporadas. Accesible a todos a partir de 1,40 m (experiencia de vuelos para personas con discapacidad, estudiada caso por caso)."
    ],
    "nl": [
      "Ultralichte vliegtuigen"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Vol en paramoteur et  montgolfière"
    ]
  },
