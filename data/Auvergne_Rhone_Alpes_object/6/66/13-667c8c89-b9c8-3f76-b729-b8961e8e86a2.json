  "rdfs:comment": {
    "de": [
      "Der Lac de Montriond ist der größte Bergsee in Hochsavoyen und bietet Anglern die Möglichkeit, ihrem Lieblingshobby in einer märchenhaften Umgebung nachzugehen, die zwischen schwindelerregenden Felsen und Nadelwäldern eingebettet ist...."
    ],
    "en": [
      "Montriond Lake is ideal for angling enthusiasts in a fairytale setting, surrounded by stupendous cliffs and thick forest…"
    ],
    "it": [
      "Il più grande lago di montagna dell'Alta Savoia, il Lac de Montriond offre ai pescatori la possibilità di dedicarsi al loro passatempo preferito in un ambiente incantevole, tra imponenti scogliere e foreste di conifere..."
    ],
    "fr": [
      "Plus grand lac de montagne de Haute-Savoie, le lac de Montriond offre aux pêcheurs la possibilité de s'adonner à leur loisirs préférés dans un cadre féerique, encaissé entre falaises vertigineuses et forêts de conifères..."
    ],
    "nl": [
      "Het Lac de Montriond, het grootste bergmeer in de Haute-Savoie, biedt sportvissers de kans hun favoriete tijdverdrijf te beoefenen in een betoverende omgeving, tussen torenhoge kliffen en naaldbossen..."
    ],
    "es": [
      "El lago de montaña más grande de la Alta Saboya, el Lac de Montriond, ofrece a los pescadores la posibilidad de practicar su pasatiempo favorito en un entorno encantador, entre imponentes acantilados y bosques de coníferas..."
    ]
  },
