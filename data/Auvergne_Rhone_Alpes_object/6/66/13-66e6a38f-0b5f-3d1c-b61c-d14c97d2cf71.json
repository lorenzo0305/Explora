  "rdfs:comment": {
    "de": [
      "Vertes Sensations ist eine Multiaktivitätsbasis und Incoming-Agentur, die sich auf Outdoor-Sportarten rund um den Lac d'Aiguebelette, den Fluss Guiers und die wilde Rhône spezialisiert hat."
    ],
    "en": [
      "Vertes Sensations is a multi-activity center and inbound travel agency specializing in outdoor sports around the lac d'Aiguebelette, the Guiers River, and the wild Rhône."
    ],
    "it": [
      "Vertes Sensations è una base multiattività e un'agenzia di incoming specializzata negli sport all'aria aperta intorno al lago di Aiguebelette, al fiume Guiers e al Rodano selvaggio."
    ],
    "fr": [
      "Vertes Sensations est une base multi-activités et agence réceptive, spécialisée dans les sports outdoor autour du lac d’Aiguebelette, de la rivière du Guiers et du Rhône sauvage."
    ],
    "nl": [
      "Vertes Sensations is een multi-activiteitenbasis en incoming agency gespecialiseerd in buitensporten rond het meer van Aiguebelette, de rivier Guiers en de wilde Rhône."
    ],
    "es": [
      "Vertes Sensations es una base multiactividad y una agencia receptiva especializada en deportes al aire libre en torno al lago de Aiguebelette, el río Guiers y el salvaje Ródano."
    ]
  },
  "rdfs:label": {
