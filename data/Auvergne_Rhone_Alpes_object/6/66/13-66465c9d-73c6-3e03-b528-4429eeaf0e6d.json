  "rdfs:comment": {
    "de": [
      "Die Festung von Marcilly Talaru dominiert das Dorf Chalmazel. Seine hohen Rundtürme besitzen noch ihre mittelalterlichen Pechnasen und einen Wehrgang."
    ],
    "en": [
      "Overlooking the village of Chalmazel, the fortified house of Marcilly Talaru's family is surprisingly authentic. Indeed it has kept its high round towers with machicolations and its parapet walk."
    ],
    "it": [
      "Affacciata sul villaggio di Chalmazel, la casa-fortezza di Marcilly Talaru è sorprendentemente autentica\r\nHa conservato le sue alte torri rotonde con caditoie e la sua via coperta."
    ],
    "fr": [
      "Dominant le village de Chalmazel, la maison forte des Marcilly Talaru étonne de par son authenticité. \r\nElle a su en effet conserver ses hautes tours rondes avec mâchicoulis et son chemin de ronde."
    ],
    "es": [
      "La casa fuerte de los Marcilly Talaru, que domina el pueblo de Chalmazel, sorprende por su autenticidad. \r\nHa conservado sus altas torres redondas con matacanes y su adarve."
    ],
    "nl": [
      "Boven het dorpje Chalmazel,bevindt zich het indrukwekkend authentiek versterkt huis Marcilly Talaru. \r\nHet heeft nog zijn oorspronkelijke ronde hoge torens, met kantelen en rondgang."
    ]
  },
  "rdfs:label": {
