      "schema:openingHoursSpecification": [
        {
          "@id": "https://data.datatourisme.fr/1a6ebb1e-b9fb-393c-92df-94b2c79b1f8b",
          "schema:validFrom": "2026-01-01T00:00:00",
          "schema:validThrough": "2026-12-31T23:59:59",
          "@type": [
            "schema:OpeningHoursSpecification"
          ],
          "additionalInformation": {
            "de": [
              "Vom 1. Juli bis zum 31. August :\r\nTäglich von 10:00 bis 19:00 Uhr geöffnet.\r\n\r\nVom 1. September bis zum 30. Juni :\r\nTäglich* von 10:00 bis 13:00 Uhr und von 14:00 bis 18:00 Uhr geöffnet.\r\n\r\nGeschlossen:\r\n- *montagmorgens bis 14 Uhr (außer in den Schulferien und an Feiertagen),\r\n- an Sonntagen im Januar und November,\r\n- Schließung um 17 Uhr am 24. und 31. Dezember,\r\n- am 25. Dezember und am 1. Januar."
            ],
            "en": [
              "From July 1 to August 31:\r\nOpen every day from 10am to 7pm.\r\n\r\nSeptember 1 to June 30:\r\nOpen daily* from 10am to 1pm and from 2pm to 6pm.\r\n\r\nClosed :\r\n- *Monday mornings until 2pm (excluding school vacations and public holidays),\r\n- sundays in January and November,\r\n- Closing at 5pm on December 24th and 31st,\r\n- december 25 and January 1."
            ],
            "it": [
              "Dal 1° luglio al 31 agosto:\r\nAperto tutti i giorni dalle 10.00 alle 19.00.\r\n\r\nDal 1° settembre al 30 giugno:\r\nAperto tutti i giorni* dalle 10.00 alle 13.00 e dalle 14.00 alle 18.00.\r\n\r\nChiuso:\r\n- *lunedì mattina fino alle 14:00 (escluse le vacanze scolastiche e i giorni festivi),\r\n- domenica in gennaio e novembre,\r\n- Chiuso alle 17:00 il 24 e il 31 dicembre,\r\n- 25 dicembre e 1° gennaio."
            ],
            "fr": [
              "Du 1er juillet au 31 août :\r\nOuvert tous les jours de 10h à 19h.\r\n\r\nDu 1er septembre au 30 juin :\r\nOuvert tous les jours* de 10h à 13h et de 14h à 18h.\r\n\r\nFermeture :\r\n- *le lundi matin jusqu’à 14 heures (hors vacances scolaires et jours fériés),\r\n- les dimanches de janvier et novembre,\r\n- Fermeture à 17h les 24 et 31 décembre,\r\n- le 25 décembre et le 1er janvier."
            ],
            "nl": [
              "Van 1 juli tot 31 augustus:\r\nElke dag geopend van 10.00 tot 19.00 uur.\r\n\r\nVan 1 september tot 30 juni:\r\nDagelijks geopend* van 10.00 tot 13.00 uur en van 14.00 tot 18.00 uur.\r\n\r\nGesloten :\r\n- *maandagochtend tot 14u (behalve schoolvakanties en feestdagen),\r\n- zondagen in januari en november,\r\n- Gesloten om 17.00 uur op 24 en 31 december,\r\n- 25 december en 1 januari."
            ],
            "es": [
              "Del 1 de julio al 31 de agosto:\r\nAbierto todos los días de 10.00 a 19.00 h.\r\n\r\nDel 1 de septiembre al 30 de junio:\r\nAbierto todos los días* de 10.00 a 13.00 h. y de 14.00 a 18.00 h.\r\n\r\nCerrado :\r\n- *Lunes por la mañana hasta las 14 h (excepto vacaciones escolares y días festivos),\r\n- domingos de enero y noviembre,\r\n- Cerrado a las 17.00 h los días 24 y 31 de diciembre,\r\n- 25 de diciembre y 1 de enero."
            ]
          },
