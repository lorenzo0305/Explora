  "rdfs:comment": {
    "de": [
      "Das Fremdenverkehrsamt von Clermont-Ferrand befindet sich im Herzen des historischen Zentrums, direkt neben der Kathedrale. Unsere Reiseberater empfangen Besucher das ganze Jahr über an sieben Tagen in der Woche."
    ],
    "en": [
      "The Clermont-Ferrand Tourist Office is in the heart of the historic centre, right next to the cathedral. Our tourist advisors welcome visitors all year round, 7 days a week."
    ],
    "it": [
      "L'Ufficio del Turismo di Clermont-Ferrand si trova nel cuore del centro storico, accanto alla cattedrale. I nostri consulenti turistici accolgono i visitatori tutto l'anno, 7 giorni su 7."
    ],
    "fr": [
      "L'Office de Tourisme de Clermont-Ferrand est au cœur du centre historique, juste à côté de la cathédrale. Nos conseillers en séjours accueillent les visiteurs tout au long de l'année, 7 jours sur 7."
    ],
    "es": [
      "La Oficina de Turismo de Clermont-Ferrand se encuentra en pleno centro histórico, justo al lado de la catedral. Nuestros asesores turísticos reciben a los visitantes todo el año, 7 días a la semana."
    ],
    "nl": [
      "Het toeristenbureau van Clermont-Ferrand ligt in het hart van het historische centrum, vlak naast de kathedraal. Onze toeristische adviseurs verwelkomen bezoekers het hele jaar door, 7 dagen per week."
    ]
  },
