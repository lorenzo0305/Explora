  "rdfs:comment": {
    "de": [
      "Der Sessellift Les Prolays führt vom Plateau des Lindarets in den Skiort Avoriaz.\r\nEr ist für Mountainbiker (Aufstieg) und Fußgänger (Aufstieg und Abfahrt) zugänglich"
    ],
    "en": [
      "The Prolays chairlift provides access to Avoriaz from the Lindarets plateau. \r\nAccessible to mountain bikers (uphill) and pedestrians (uphill and downhill)"
    ],
    "it": [
      "La seggiovia Prolays consente di accedere ad Avoriaz dall'altopiano dei Lindarets.\r\nÈ accessibile alle mountain bike (salita) e ai pedoni (salita e discesa)"
    ],
    "fr": [
      "Le télésiège des Prolays permet d'accéder à la station d'Avoriaz depuis le plateau des Lindarets . \r\nAccessible aux vtt (montée) et piétons (montée et descente)"
    ],
    "es": [
      "El telesilla Prolays da acceso a Avoriaz desde la meseta de Lindarets.\r\nAccesible para bicicletas de montaña (subida) y peatones (subida y bajada)"
    ],
    "nl": [
      "De stoeltjeslift Prolays biedt toegang tot Avoriaz vanaf het plateau van Lindarets.\r\nToegankelijk voor mountainbikes (beklimming) en voetgangers (beklimming en afdaling)"
    ]
  },
  "rdfs:label": {
    "en": [
