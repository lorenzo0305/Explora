  "rdfs:comment": {
    "de": [
      "Die Mediathek bietet eine Sammlung von Druckwerken (Bücher, Zeitschriften, Zeitungen, Noten, Karten, Poster...) und audiovisuellen Dokumenten (CDs, DVDs, Videos) usw. zur Ausleihe und Einsichtnahme an."
    ],
    "en": [
      "The media library offers a collection of printed materials (books, magazines, newspapers, scores, maps, posters, etc.) and audiovisual materials (CDs, DVDs, videos) for loan and consultation."
    ],
    "it": [
      "La mediateca offre collezioni di materiale stampato (libri, riviste, giornali, spartiti, mappe, manifesti, ecc.) e documenti audiovisivi (CD, DVD, video) per il prestito e la consultazione."
    ],
    "fr": [
      "La médiathèque propose au prêt et à la consultation des collections d'imprimés (livres, revues, journaux, partitions, cartes, affiches...) et de documents audiovisuels (CD, DVD, vidéos), etc."
    ],
    "es": [
      "La mediateca ofrece colecciones de material impreso (libros, revistas, periódicos, partituras, mapas, carteles, etc.) y audiovisual (CD, DVD, vídeos) para préstamo y consulta."
    ],
    "nl": [
      "De mediatheek biedt collecties drukwerk (boeken, tijdschriften, kranten, partituren, kaarten, posters, enz.) en audiovisuele documenten (cd's, dvd's, video's) om uit te lenen en te raadplegen."
    ]
  },
