  "rdfs:comment": {
    "de": [
      "Elsa und Oscar stellen Eis aus Milch vom Bauernhof her. Viele verschiedene Geschmacksrichtungen sind erhältlich: Vanille, Kaffee, Schokolade, Erdbeere, Zitrone, Banane, Milchblume, Karamell mit gesalzener Butter, Haselnuss, Rum-Rosinen, Spekulatius."
    ],
    "en": [
      "Elsa and Oscar make ice cream with milk from their farm. Many flavors available: vanilla, coffee, chocolate, strawberry, lemon, banana, fleur de lait, salted butter caramel, hazelnut, rum raisin, speculoos."
    ],
    "it": [
      "Elsa e Oscar preparano il gelato con il latte della fattoria. Molti i gusti disponibili: vaniglia, caffè, cioccolato, fragola, limone, banana, fleur de lait, caramello al burro salato, nocciola, rum e uvetta, speculoos."
    ],
    "fr": [
      "Elsa et Oscar fabriquent des glaces avec lait de la ferme. De nombreux parfums disponibles : vanille, café, chocolat, fraise, citron, banane, fleur de lait, caramel beurre salé, noisette, rhum-raisins, spéculoos."
    ],
    "es": [
      "Elsa y Oscar elaboran helados con leche de la granja. Muchos sabores disponibles: vainilla, café, chocolate, fresa, limón, plátano, flor de lait, caramelo de mantequilla salada, avellana, ron con pasas, speculoos."
    ],
    "nl": [
      "Elsa en Oscar maken ijs met melk van de boerderij. Vele smaken beschikbaar: vanille, koffie, chocolade, aardbei, citroen, banaan, fleur de lait, gezouten boter karamel, hazelnoot, rum rozijn, speculaas."
    ]
  },
  "rdfs:label": {
    "de": [
      "Les glaces du Truchet"
    ],
    "fr": [
      "Les glaces du Truchet"
    ]
  },
