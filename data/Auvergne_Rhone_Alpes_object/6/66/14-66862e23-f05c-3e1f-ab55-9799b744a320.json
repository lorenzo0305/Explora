  "rdfs:comment": {
    "de": [
      "Speziell für das Wochenende des Muschelfestes gibt Ihnen das Maréis-Zentrum die Gelegenheit, sich für einen ermäßigten Preis in die Haut eines Fischerseglers zu versetzen!"
    ],
    "en": [
      "Especially for the Fête de la Coquille weekend, the Maréis center gives you the chance to put yourself in the shoes of a fisherman for a reduced price!"
    ],
    "it": [
      "Specialmente per il fine settimana della Sagra dei molluschi, il centro Maréis vi offre la possibilità di mettervi nei panni di un pescatore a prezzo ridotto!"
    ],
    "fr": [
      "Spécialement pour le week-end de la fête de la Coquille, le centre Maréis vous donne l'occasion de vous mettre dans la peau d'un marin pêcheur pour un prix à tarif réduit !"
    ],
    "nl": [
      "Speciaal voor het weekend van het Shellfish Festival geeft het Maréis-centrum je de kans om voor een gereduceerde prijs in de huid van een visser te kruipen!"
    ],
    "es": [
      "Especialmente para el fin de semana de la Fiesta del Marisco, el centro Maréis le ofrece la oportunidad de ponerse en la piel de un pescador a un precio reducido"
    ]
  },
