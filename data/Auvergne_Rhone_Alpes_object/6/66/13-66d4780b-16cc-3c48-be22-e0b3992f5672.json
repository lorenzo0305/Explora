  "rdfs:comment": {
    "de": [
      "Besuchen Sie diesen typischen Ardèche-Bauernhof, auf dem Heidelbeeren, Kastanien, Beeren, Marmelade, Sirup, Fruchtsaft, Essig, naturbelassene Kastanien, Kastanienmehl... produziert werden."
    ],
    "en": [
      "The Bosc Farm sells blueberries, chestnuts, small fruits, jams, syrups, juice, vinegar, natural chestnuts, and flour. Discover these authentic delights."
    ],
    "it": [
      "Venite a visitare questa tipica fattoria dell'Ardèche dove si producono mirtilli, castagne, frutti di bosco, marmellate, sciroppi, succhi di frutta, aceto, castagne naturali e farina di castagne..."
    ],
    "fr": [
      "Venez visiter cette ferme typique ardéchoise où l'on produit des myrtilles, des châtaignes, des petits fruits, des confitures, des sirops, des jus de fruits, du vinaigre, des châtaignes au naturel, de la farine de châtaigne..."
    ],
    "nl": [
      "Verkoop van producten van de Ferme du Bosc: bosbessen, kastanjes en klein fruit. \r\nU vindt er ook diverse producten: jam, siroop, vruchtensap, natuurlijke kastanjes, kastanjemeel..."
    ],
    "es": [
      "Venga a visitar esta granja típica de Ardèche donde se producen arándanos, castañas, bayas, mermeladas, siropes, zumos de frutas, vinagre, castañas naturales y harina de castañas..."
    ]
  },
  "rdfs:label": {
    "en": [
      "The bosc farm"
    ],
    "fr": [
      "La Ferme du Bosc"
    ],
    "nl": [
      "De boerderij van de bosc"
    ]
  },
