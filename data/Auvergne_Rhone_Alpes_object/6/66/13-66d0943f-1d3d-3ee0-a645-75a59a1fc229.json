  "rdfs:comment": {
    "de": [
      "Virtual Room bietet ein immersives Spielerlebnis mit vielen Rätseln, die es im Team zu lösen gilt. Das Spiel ist eine Mischung aus Escape Game und Kino und bietet ein virtuelles Abenteuer, das Denken, Kommunikation und Teamgeist miteinander verbindet."
    ],
    "en": [
      "The Virtual Room experience Step into a new dimension of entertainment!"
    ],
    "it": [
      "Virtual Room, offre un'esperienza di gioco coinvolgente, piena di enigmi da risolvere in squadra. All'incrocio tra un gioco di fuga e il cinema, intraprendete un'avventura virtuale che unisce riflessione, comunicazione e spirito di squadra."
    ],
    "fr": [
      "Virtual Room, offre une expérience de jeu immersive remplie d’énigmes à relever en équipe. À la croisée des chemins entre l’escape game et le cinéma, embarquez pour une aventure virtuelle alliant réflexion, communication et esprit d’équipe."
    ],
    "es": [
      "Virtual Room, ofrece una experiencia de juego inmersiva llena de enigmas que hay que resolver en equipo. A caballo entre un juego de escape y el cine, embárcate en una aventura virtual que combina reflexión, comunicación y espíritu de equipo."
    ],
    "nl": [
      "Virtual Room biedt een meeslepende spelervaring vol puzzels die je als team moet oplossen. Op het kruispunt tussen een ontsnappingsspel en de bioscoop beleef je een virtueel avontuur dat reflectie, communicatie en teamgeest combineert."
    ]
  },
