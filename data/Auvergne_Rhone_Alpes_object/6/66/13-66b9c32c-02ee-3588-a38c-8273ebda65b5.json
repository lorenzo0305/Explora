  "rdfs:comment": {
    "de": [
      "Auf dem Weg nach Santiago de Compostela, dem GR9 und in der Nähe der ViaRhôna im Herzen der mittelalterlichen Stadt Yenne empfängt Sie das Logis Hôtel Le Fer à Cheval in seinem 12-Zimmer-Haus."
    ],
    "en": [
      "On the route to Santiago de Compostela, the GR9 and close to the ViaRhôna, Logis Hôtel Le Fer à Cheval welcomes you to its 12-room establishment in the heart of Yenne, an ancient medieval town."
    ],
    "it": [
      "Sul cammino di Santiago de Compostela, sul GR9 e vicino alla ViaRhôna, il Logis Hôtel Le Fer à Cheval vi accoglie nella sua struttura con 12 camere da letto nel cuore di Yenne, un'antica città medievale."
    ],
    "fr": [
      "Sur la route de Saint-Jacques-de-Compostelle, du GR9 et à proximité de la ViaRhôna et situé au cœur de Yenne, ancienne cité médiévale, Logis Hôtel Le Fer à Cheval vous accueille dans son établissement de 12 chambres."
    ],
    "nl": [
      "Op de route naar Santiago de Compostela, de GR9 en vlakbij de ViaRhôna, heet Logis Hôtel Le Fer à Cheval je welkom in zijn 12 kamers tellende etablissement in het hart van Yenne, een oude middeleeuwse stad."
    ],
    "es": [
      "En el camino de Santiago de Compostela, el GR9 y cerca de la ViaRhôna, Logis Hôtel Le Fer à Cheval le da la bienvenida a su establecimiento de 12 habitaciones en el corazón de Yenne, una antigua ciudad medieval."
    ]
  },
  "rdfs:label": {
