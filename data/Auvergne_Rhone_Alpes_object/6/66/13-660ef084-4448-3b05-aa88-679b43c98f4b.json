  "rdfs:comment": {
    "de": [
      "Das Viking empfängt Sie jeden Tag am Fuße der Pisten in Le Plan. Schnellrestaurants (Burger, Pommes frites, Paninis...), Wurst- und Käseplatten...  Burger zum Mitnehmen am Abend."
    ],
    "en": [
      "Le Viking welcomes you every day at the foot of the pistes in Le Plan. Fast food (burgers, chips, paninis...), charcuterie/cheese boards...  Burgers in the evening. ."
    ],
    "it": [
      "Les Vikings vi accoglie ogni giorno ai piedi delle piste di Le Plan. Fast food (hamburger, patatine, panini...), taglieri di salumi e formaggi...  Hamburger da asporto la sera."
    ],
    "fr": [
      "Les Vikings vous accueillent tous les jours au pied des pistes au Plan. Restauration rapide (burgers, frites, paninis...), planches charcuterie / fromages...  Burgers à emporter le soir."
    ],
    "nl": [
      "Les Vikings verwelkomt je elke dag aan de voet van de pistes in Le Plan. Fast food (hamburgers, friet, panini's...), vleeswaren/kaasplankjes...  Burgers om 's avonds mee te nemen."
    ],
    "es": [
      "Les Vikings le da la bienvenida todos los días al pie de las pistas de Le Plan. Comida rápida (hamburguesas, patatas fritas, paninis...), tablas de embutidos/quesos...  Hamburguesas para llevar por la noche."
    ]
  },
