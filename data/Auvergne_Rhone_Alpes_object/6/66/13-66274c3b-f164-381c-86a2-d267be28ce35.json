  "rdfs:comment": {
    "de": [
      "Aromagarten im Herzen der provenzalischen Baronnies. Anbau, Verwendung und Verarbeitung von Aroma- und Heilpflanzen. Workshops, Praktika, Austausch von Wissen und Know-how."
    ],
    "en": [
      "Aromatic garden in the heart of the Baronnies of Provence. Cultivation, use and transformation of aromatic and medicinal plants. Workshops, courses, sharing of knowledge and know-how."
    ],
    "it": [
      "Giardino aromatico nel cuore delle Baronie di Provenza. Coltivazione, uso e trasformazione di piante aromatiche e medicinali. Workshop, corsi, condivisione di conoscenze e know-how."
    ],
    "fr": [
      "Jardin aromatique au cœur des Baronnies provençales. Culture, usages et transformations des plantes aromatiques et médicinales. Ateliers, stages, partage de savoirs et savoir-faire."
    ],
    "nl": [
      "Ontdek de planten in een uitzonderlijke omgeving in het hart van de Provençaalse Baronniën. Parfums, geuren, gebruik, eigenschappen...\r\nKamille, hysope, marjolein, salie, thijm, rozemarijn, ijzerkruid, munt, kaasjeskruid.. u onthult al hun geheimen."
    ],
    "es": [
      "Jardín aromático en el corazón de las Baronías de Provenza. Cultivo, uso y transformación de plantas aromáticas y medicinales. Talleres, cursos, intercambio de conocimientos y know-how."
    ]
  },
