  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Domaine Carlindia in Espinasse Vozelle\r\n Ein Ort der Natur: Freizeit, Tierwelt, Wellness vor den Toren von Vichy\r\n\r\nFamilien, Urlauber, Firmengruppen, begeisterte Reiter, Naturliebhaber auf der Suche nach Abwechslung sind hier herzlich willkommen"
    ],
    "en": [
      "Discover Domaine Carlindia in Espinasse Vozelle\r\n A place of nature, leisure, wildlife and well-being on the outskirts of Vichy\r\n\r\nFamilies, holidaymakers, corporate groups, horse-riding enthusiasts and nature lovers in search of a change of scenery are all welcome"
    ],
    "it": [
      "Scoprite il Domaine Carlindia a Espinasse Vozelle\r\n Un luogo di natura, di svago, di fauna selvatica e di benessere alla periferia di Vichy\r\n\r\nFamiglie, vacanzieri, gruppi aziendali, appassionati di ciclismo e amanti della natura in cerca di un cambiamento di scenario sono i benvenuti"
    ],
    "fr": [
      "Découvrez le Domaine Carlindia à Espinasse Vozelle \r\n Lieu nature: loisirs, animalier, bien être aux portes de Vichy \r\n\r\nFamilles, vacanciers, groupes d’entreprises, cavaliers passionnés, amoureux de la nature en quête de dépaysement sont les bienvenus"
    ],
    "nl": [
      "Ontdek Domaine Carlindia in Espinasse Vozelle\r\n Een plek voor natuur, ontspanning, natuur en welzijn aan de rand van Vichy\r\n\r\nGezinnen, vakantiegangers, bedrijfsgroepen, fervente ruiters en natuurliefhebbers op zoek naar een andere omgeving zijn allemaal welkom"
    ],
    "es": [
      "Descubra el Domaine Carlindia en Espinasse Vozelle\r\n Un lugar de naturaleza, ocio, fauna y bienestar a las afueras de Vichy\r\n\r\nFamilias, veraneantes, grupos de empresas, jinetes aficionados y amantes de la naturaleza en busca de un cambio de aires son bienvenidos"
    ]
  },
