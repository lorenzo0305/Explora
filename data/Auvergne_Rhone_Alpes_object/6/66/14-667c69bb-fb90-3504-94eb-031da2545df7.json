      "@id": "https://data.datatourisme.fr/144cb41d-d5fe-3b86-a6a5-35abb2e9b74b",
      "dc:description": {
        "de": [
          "Caviste, Feinkostladen. Verkauf von Getränken (Bier, Wein, Whisky, Rum, Softdrinks und Spirituosen).  \nGeöffnet Dienstag, Mittwoch, Donnerstag, Freitag, Samstag: 8.30 Uhr 12 Uhr / 14 Uhr 18.30 Uhr"
        ],
        "en": [
          "Cavist, delicatessen. Sale of beverages (beer, wine, whisky, rum, soft drinks and spirits).  \nOpen Tuesday, Wednesday, Thursday, Friday, Saturday : 8h30 12h / 14h 18h30"
        ],
        "it": [
          "Cavista, salumeria. Vendita di bevande (birra, vino, whisky, rum, bibite e liquori).  \nAperto martedì, mercoledì, giovedì, venerdì e sabato: 8.30-12.00 / 14.00-18.30"
        ],
        "fr": [
          "Caviste, épicerie Fine. Vente de boissons (bière, vin, whisky, rhum, soft et spiritueux.  \nOuvert mardi, mercredi, jeudi, vendredi, samedi : 8h30 12h / 14h 18h30"
        ],
        "nl": [
          "Cavist, delicatessenzaak. Verkoop van dranken (bier, wijn, whisky, rum, frisdrank en sterke drank).  \nOpen dinsdag, woensdag, donderdag, vrijdag, zaterdag: 8.30-12.00 / 14.00-18.30"
        ],
        "es": [
          "Cavist, delicatessen. Venta de bebidas (cerveza, vino, whisky, ron, refrescos y licores).  \nAbierto martes, miércoles, jueves, viernes y sábado: de 8.30 a 12.00 h. / de 14.00 a 18.30 h"
        ]
      },
