  "rdfs:comment": {
    "de": [
      "Das Haus Forissier lädt Sie ein, die Aromen der Verbene rund um eine Reihe von handwerklich hergestellten Produkten zu genießen, wie den Liqueur de Verveine, Kräutertees und andere Gewürze auf der Basisvon Verbene. Elegant und duftend - die Verbene weckt die Sinne!"
    ],
    "en": [
      "The Maison Forissier invites you to savour the taste of verbena in a range of traditional products such as vervain liqueur, herbal teas and various verbena-based condiments. Verbena is an elegant and fragrant plant that stimulates the senses!"
    ],
    "it": [
      "Con sede nel cuore di Forez, da oltre 100 anni la famiglia Forissier coltiva con cura piante aromatiche e medicinali, in particolare la verbena, per creare liquori eccezionali."
    ],
    "fr": [
      "Implantée au cœur du Forez, la famille Forissier, depuis plus de 100 ans, cultive avec soin des plantes aromatiques et médicinales, notamment la verveine, pour créer des liqueurs d'exception."
    ],
    "es": [
      "Instalada en el corazón de Forez, la familia Forissier cultiva con esmero desde hace más de 100 años plantas aromáticas y medicinales, en particular la verbena, para crear licores excepcionales."
    ],
    "nl": [
      "De familie Forissier, gevestigd in het hart van Forez, cultiveert al meer dan 100 jaar zorgvuldig aromatische en geneeskrachtige planten, met name verbena, om uitzonderlijke likeuren te creëren."
    ]
  },
  "rdfs:label": {
