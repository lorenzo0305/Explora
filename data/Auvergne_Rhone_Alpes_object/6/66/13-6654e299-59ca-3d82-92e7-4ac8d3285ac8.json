  "rdfs:comment": {
    "de": [
      "Verkauf von Weinen, Bieren, Whisky, Rum. Events: Verkostungsabend, Vermietung von Bierzapfanlagen..."
    ],
    "en": [
      "Sale of beers, whiskey, rum. Round events : tasting evenings, draft-beer system on rental…"
    ],
    "it": [
      "Vendita di vini, birre, whisky e rum. Eventi: serate di degustazione, noleggio di spine di birra, ecc.\nNovità del 2026, il cortile, un luogo dove prendersi il tempo necessario per gustare una bottiglia di birra o una birra alla spina, oltre a vini e prodotti analcolici"
    ],
    "fr": [
      "Vente de vins, bières, whisky, Rhum. Evènementiel : soirée dégustation, location de tireuse à bière...\nNouveauté en 2026, le coté cour, espace pour prendre le temps de boire une bière bouteille ou une pression ainsi que du vins et des produits sans alcool"
    ],
    "nl": [
      "Verkoop van wijnen, bieren, whisky en rum. Evenementen: degustatieavonden, verhuur van biertaps, enz."
    ],
    "es": [
      "Venta de vinos, cervezas, whisky y ron. Eventos: veladas de degustación, alquiler de grifos de cerveza, etc.\nNovedad en 2026, el patio, un lugar para tomarse su tiempo y disfrutar de una botella de cerveza o de barril, así como de vinos y productos sin alcohol"
    ]
  },
  "rdfs:label": {
