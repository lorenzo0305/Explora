  "rdfs:comment": {
    "de": [
      "Burger, hochwertige Fleischstücke, die von unseren Teams mit einem Maximum an frischen und hochwertigen Produkten zusammengestellt werden.\r\nEs gibt auch Salate und vegetarische Burger, die mit Leidenschaft und Sympathie serviert werden."
    ],
    "en": [
      "Burgers, pieces of quality meat concocted by our teams with a maximum of fresh and top-of-the-range products.\r\nThey are also salads and vegetarian burgers, all served with passion and sympathy."
    ],
    "it": [
      "Hamburger, pezzi di carne di qualità preparati dai nostri team con un massimo di prodotti freschi e di alta qualità.\r\nOffriamo anche insalate e hamburger vegetariani, il tutto servito con passione e simpatia."
    ],
    "fr": [
      "Des Burgers, des pièces de viandes de qualité concoctés par nos équipes avec un maximum de produits frais et haut de gamme.\r\nCe sont aussi des salades et des burgers végétariens, le tout servi avec passion et sympathie."
    ],
    "es": [
      "Hamburguesas, piezas de carne de calidad elaboradas por nuestros equipos con un máximo de productos frescos y de alta calidad.\r\nTambién ofrecemos ensaladas y hamburguesas vegetarianas, todo ello servido con pasión y simpatía."
    ],
    "nl": [
      "Burgers, stukken kwaliteitsvlees samengesteld door onze teams met een maximum aan verse en hoogwaardige producten.\r\nWe bieden ook salades en vegetarische burgers, allemaal geserveerd met passie en sympathie."
    ]
  },
  "rdfs:label": {
