  "rdfs:comment": {
    "de": [
      "Enduro-Mountainbike-Piste von Lalouvesc nach Vion Nr. 100 über Les Croisières, Val d'Or, Bobigneux, Col du Faux, Le Serre des Vernes, Col du Marchand, Pourchat und dann 102 über Le Grangeon, Montplot, Saint Victor, Corsas, Etables, Crémolières und Lemps."
    ],
    "en": [
      "Enduro MTB trail from Lalouvesc to Vion N°100 via Les Croisières, Val d'Or, Bobigneux, Col du Faux, Le Serre des Vernes, Col du Marchand, Pourchat then 102 via Le Grangeon, Montplot, Saint Victor, Corsas, Etables, Crémolières and Lemps."
    ],
    "it": [
      "Percorso Enduro MTB da Lalouvesc a Vion N°100 via Les Croisières, Val d'Or, Bobigneux, Col du Faux, Le Serre des Vernes, Col du Marchand, Pourchat poi 102 via Le Grangeon, Montplot, Saint Victor, Corsas, Etables, Crémolières e Lemps."
    ],
    "fr": [
      "Piste Enduro VTT de Lalouvesc à Vion N°100 passant par Les Croisières,  Val d'Or,  Bobigneux, Col du Faux, Le Serre des Vernes, Col du Marchand, Pourchat puis 102 par Le Grangeon, Montplot, Saint Victor, Corsas, Etables, Crémolières et Lemps."
    ],
    "es": [
      "Enduro MTB pista de Lalouvesc a Vion N°100 vía Les Croisières, Val d'Or, Bobigneux, Col du Faux, Le Serre des Vernes, Col du Marchand, Pourchat luego 102 vía Le Grangeon, Montplot, Saint Victor, Corsas, Etables, Crémolières y Lemps."
    ],
    "nl": [
