  "rdfs:comment": {
    "de": [
      "Ruhiges Restaurant in der Natur, 600 m vom Dorfzentrum entfernt, am Anfang der Skipisten und der Wanderwege. Im Winter Esszimmer mit Kamin, im Sommer schattiger Park mit Blumen, Terrasse, Swimmingpool."
    ],
    "en": [
      "Quiet restaurant in the countryside, 600m from the village centre, at the start of the ski slopes and hiking trails. There is a dining room with fireplace for the winter and, in the summer, there is a shady, flower-filled park, terrace and swimming pool."
    ],
    "it": [
      "Ristorante tranquillo in campagna, a 600 m dal centro del paese, all'inizio delle piste da sci di fondo in inverno e dei sentieri escursionistici in estate. Sala da pranzo con camino in inverno, parco ombreggiato con fiori in estate, terrazza, piscina riscaldata a 28°C (15/05-15/09)"
    ],
    "fr": [
      "Restaurant calme, dans la nature, à 600 m du centre village, au départ des pistes de ski de fonds l'hiver et des parcours de randonnée l'été. L'hiver salle à manger avec cheminée, l'été parc ombragé et fleuri, terrasse, piscine chauffée 28° (15/05-15/09)"
    ],
    "nl": [
      "Rustig restaurant op het platteland, 600 m van het dorpscentrum, aan het begin van de langlaufloipes in de winter en wandelpaden in de zomer. Eetzaal met open haard in de winter, schaduwrijk park met bloemen in de zomer, terras, verwarmd zwembad 28°C (15/05-15/09)"
    ],
    "es": [
      "Restaurante tranquilo en el campo, a 600 m del centro del pueblo, al comienzo de las pistas de esquí de fondo en invierno y de las rutas de senderismo en verano. Comedor con chimenea en invierno, parque sombreado con flores en verano, terraza, piscina climatizada 28°C (15/05-15/09)"
    ]
  },
  "rdfs:label": {
    "de": [
      "Restaurant Le Vernay"
    ],
