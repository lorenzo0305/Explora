      "rdfs:comment": {
        "de": [
          "Lernen Sie, Ihr eigenes Bier zu brauen und genießen Sie einen Moment des Abschaltens in unseren Gästezimmern (Monts et Merveilles)!"
        ],
        "en": [
          "Come and learn how to brew your own beer and enjoy a moment of relaxation in our Monts et Merveilles B&B!"
        ],
        "it": [
