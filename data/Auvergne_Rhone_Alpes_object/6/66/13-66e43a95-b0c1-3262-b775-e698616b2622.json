  "rdfs:comment": {
    "de": [
      "Im Herzen eines charmanten kleinen Dorfes in der provenzalischen Drôme, wo die Zeit stehen geblieben zu sein scheint, bieten Ihnen Jacques und Raphaële eine traditionelle, hausgemachte Küche mit lokalen Produkten."
    ],
    "en": [
      "In the heart of a charming little village from Drôme Provençale where time where time seems to stand still, Jacques and Raphaële offer you traditional homemade cuisine with local products."
    ],
    "it": [
      "Nel cuore di un incantevole paesino della Drôme Provençale, dove il tempo sembra essersi fermato, Jacques e Raphaële vi offrono una cucina tradizionale fatta in casa con prodotti locali."
    ],
    "fr": [
      "Au cœur d'un charmant petit village de la Drôme provençale où le temps semble s'être arrêté, Jacques et Raphaële vous proposent une cuisine traditionnelle faite maison avec des produits locaux."
    ],
    "nl": [
      "In een klein charmant dorpje in de Provençaalse Drôme waar de tijd stil lijkt te staan, bieden Jacques en Raphaëlle u een traditionele keuken aan bereid met lokale produkten."
    ],
    "es": [
      "En el corazón de un encantador pueblecito de la Drôme provenzal, donde el tiempo parece haberse detenido, Jacques y Raphaële le ofrecen cocina casera tradicional con productos locales."
    ]
  },
