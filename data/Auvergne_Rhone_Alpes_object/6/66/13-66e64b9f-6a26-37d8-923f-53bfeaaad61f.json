  "rdfs:comment": {
    "de": [
      "Josy und Georges bieten frische Produkte an, die sie in einem kurzen Kreislauf gekauft haben. Sie haben auch einen Gemüsegarten vor Ort. Ihre Spezialität ist unter anderem Fisch.\r\nDie Dekoration versetzt Sie zurück in den Stil der Nouvelle vague der 50er Jahre."
    ],
    "en": [
      "Josy and Georges offer fresh produce bought locally. They also have an on-site vegetable garden. Their specialty is fish, among other things.\r\nThe decor will take you back to the New Wave style of the 50s."
    ],
    "it": [
      "Josy e Georges offrono prodotti freschi acquistati in loco. Hanno anche un orto in loco. La loro specialità è il pesce.\r\nL'arredamento ricorda lo stile New Wave degli anni Cinquanta."
    ],
    "fr": [
      "Josy et Georges proposent des produits frais, achetés en circuit court. Ils ont également  un potager sur place. Leur spécialité est le poisson, entre autres. \r\nLa décoration vous ramènera dans le style de la Nouvelle vague des années 50."
    ],
    "es": [
      "Josy y Georges ofrecen productos frescos comprados en la zona. También tienen un huerto. Su especialidad es el pescado.\r\nLa decoración recuerda el estilo New Wave de los años 50."
    ],
    "nl": [
      "Josy en Georges bieden verse producten die lokaal zijn gekocht. Ze hebben ook een moestuin op het terrein. Hun specialiteit is vis.\r\nDe inrichting doet denken aan de New Wave-stijl van de jaren 1950."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Chez Josy et Georges"
    ]
  },
