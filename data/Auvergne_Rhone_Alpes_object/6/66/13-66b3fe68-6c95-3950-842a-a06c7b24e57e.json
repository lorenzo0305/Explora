  "rdfs:comment": {
    "de": [
      "Die Alpage des Besoens liegt im Herzen des Skigebiets und empfängt Sie für eine Essens- oder Getränkepause zwischen zwei Abfahrten oder nach Ihrer Wanderung."
    ],
    "en": [
      "Located in the heart of the ski area, the Besoens mountain pasture welcomes you for a snack or a drink between two descents or after your hike."
    ],
    "it": [
      "Situata nel cuore del comprensorio sciistico, la malga Besoens vi accoglie per uno spuntino o un drink tra due piste o dopo l'escursione."
    ],
    "fr": [
      "Situé au cœur du domaine skiable, l'alpage des Besoens vous accueille pour une pause restauration ou boisson entre deux descentes ou après votre randonnée."
    ],
    "es": [
      "Situado en el corazón de la zona de esquí, el pasto de montaña de Besoens le da la bienvenida para tomar un aperitivo o una bebida entre dos pistas o después de su caminata."
    ],
    "nl": [
      "Gelegen in het hart van het skigebied, verwelkomt de Besoens bergweide u voor een hapje of een drankje tussen twee afdalingen of na uw wandeling."
    ]
  },
  "rdfs:label": {
