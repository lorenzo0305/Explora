  "rdfs:comment": {
    "de": [
      "In der Bäckerei mit Weiß-, Land- und Spezialbrot. In der Konditorei, von Kuchen, über Entremets, bis hin zu Brandteig...Kekse und Snacks auch."
    ],
    "en": [
      "In the bakery, with white, country and special breads... In pastry, from tarts to entremets, including choux pastry... Dry cakes and snacks too."
    ],
    "it": [
      "Nella panetteria, con pane bianco, pane contadino e pane speciale... Pasticceria, dalle crostate agli entremets, compresa la pasta choux... Anche dolci secchi e snack."
    ],
    "fr": [
      "En boulangerie, avec du pain blanc, campagne et spéciaux.. En pâtisserie, de la tarte, à l'entremet, en passant par la pâte à chou...Des gâteaux secs et du snacking aussi."
    ],
    "nl": [
      "In de bakkerij, met wit brood, boerenbrood en speciaal brood... Gebak, van taarten tot tussengerechten, inclusief soezendeeg... Ook droog gebak en snacks."
    ],
    "es": [
      "En la panadería, con pan blanco, pan de payés y pan de especialidad... Pastelería, desde tartas a entremets, pasando por pasta choux... También pasteles secos y bocadillos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Boulangerie | Au Pain de Stevenson"
    ]
  },
