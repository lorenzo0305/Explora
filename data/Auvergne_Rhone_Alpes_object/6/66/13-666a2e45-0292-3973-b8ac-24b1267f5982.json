  "rdfs:comment": {
    "de": [
      "Antropia ist ein Ort, der sich dem Wiederverwenden und der sozialen Innovation widmet und auf 5 Säulen beruht: Ökologie, soziale und solidarische Wirtschaft, kulturelle Offenheit, Lernen, Dinge selbst zu tun und verantwortungsvolle Digitalisierung."
    ],
    "en": [
      "Antropia is a location dedicated to upcycling and social innovation based on 5 pillars: ecology, social economy, cultural openness, learning to do things yourself and responsible digital technology."
    ],
    "it": [
      "Antropia è un luogo dedicato al riuso e all'innovazione sociale basato su 5 pilastri: ecologia, economia sociale e solidale, apertura culturale, imparare a fare da soli e tecnologia digitale responsabile."
    ],
    "fr": [
      "Antropia est un lieu dédié au réemploi et à l'innovation sociale reposant sur 5 piliers : l'écologie, l'économie sociale et solidaire, l'ouverture culturelle, l'apprentissage du faire soi-même et le numérique responsable."
    ],
    "nl": [
      "Antropia is een plek gewijd aan hergebruik en sociale innovatie gebaseerd op 5 pijlers: ecologie, de sociale en solidaire economie, culturele openheid, leren om dingen zelf te doen en verantwoorde digitale technologie."
    ],
    "es": [
      "Antropia es un espacio dedicado a la reutilización y la innovación social basado en 5 pilares: ecología, economía social y solidaria, apertura cultural, aprender a hacer las cosas uno mismo y tecnología digital responsable."
    ]
  },
