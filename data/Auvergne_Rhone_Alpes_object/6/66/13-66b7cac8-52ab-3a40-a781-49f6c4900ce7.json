  "rdfs:comment": {
    "de": [
      "Brasserie, in der das Garen auf offener Flamme die großen französischen Klassiker in einer intimen und eleganten Atmosphäre zu neuem Leben erweckt. Hier findet man eine weit offene Küche und private Bereiche wie den Weinkeller und den Chef's Table."
    ],
    "en": [
      "Brasserie where flame-cooking revives the great French classics, in an intimate and elegant atmosphere. There's a wide-open kitchen and private areas such as the Wine Cellar and Chef's Table."
    ],
    "it": [
      "Una brasserie dove la cucina alla fiamma fa rivivere i grandi classici francesi, in un'atmosfera intima ed elegante. La cucina è a vista e le aree riservate sono la Cantina dei vini e il Tavolo dello chef."
    ],
    "fr": [
      "Brasserie où la cuisson à la flamme réveille les grands classiques français, dans une ambiance intime et élégante. On y retrouve une cuisine grande ouverte et des espaces privatifs comme la Cave à vin et la Table du chef."
    ],
    "es": [
      "Una brasserie donde la cocina a la llama revive los grandes clásicos franceses, en un ambiente íntimo y elegante. Cuenta con una cocina abierta y espacios privados como la Bodega y la Mesa del Chef."
    ],
    "nl": [
      "Een brasserie waar de grote Franse klassiekers herleven in een intieme en elegante sfeer. Er is een open keuken en privégedeeltes zoals de wijnkelder en de chef's table."
    ]
  },
  "rdfs:label": {
