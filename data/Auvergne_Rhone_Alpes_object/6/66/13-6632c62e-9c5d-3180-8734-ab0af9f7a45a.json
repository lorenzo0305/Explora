  "rdfs:comment": {
    "de": [
      "Jahrhundert zwei Burgen, eine verschwundene Kirche, die der Heiligen Katharina gewidmet war, einen protestantischen Tempel, der einen für den Gottesdienst eingerichteten Raum ersetzte und 1684 abgerissen wurde."
    ],
    "en": [
      "The hilltop village of Crupies was home to two castles in the 13th century, a church dedicated to Sainte Catherine that no longer exists, and a Protestant temple that replaced a hall used for worship, demolished in 1684."
    ],
    "it": [
      "Il villaggio di Crupies, situato in cima alla collina, era sede di due castelli nel XIII secolo, di una chiesa dedicata a Santa Caterina, oggi scomparsa, e di un tempio protestante che sostituiva una sala adibita al culto, demolita nel 1684."
    ],
    "fr": [
      "Village perché de Crupies, siège de deux châteaux au 13ème siècle, d'une église disparue dédiée à Sainte Catherine, d'un temple protestant ayant remplacé  d'une salle aménagée pour le culte, démolis en 1684."
    ],
    "nl": [
      "In het op een heuvel gelegen dorp Crupies stonden in de 13e eeuw twee kastelen, een kerk gewijd aan Sainte Catherine die sindsdien is verdwenen en een protestantse tempel die in de plaats kwam van een zaal die voor de eredienst werd gebruikt en die in 1684 werd afgebroken."
    ],
    "es": [
      "El pueblo de Crupies, situado en la cima de una colina, albergó dos castillos en el siglo XIII, una iglesia dedicada a Santa Catalina que ha desaparecido y un templo protestante que sustituyó a una sala destinada al culto, demolida en 1684."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Viale de Crupies"
    ]
  },
