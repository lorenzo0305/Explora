  "rdfs:comment": {
    "de": [
      "Snacks zum Mitnehmen, Burger, Kebab, Tacos, Paninis, Salate und kleine Snacks (Nuggets, P'tit Croque, Tenders, etc.). Wir bieten auch Desserts an!Gelbes Brathähnchen Fermier Label Rouge und Röstkartoffeln sonntags mittags!"
    ],
    "en": [
      "Takeaway snacks, burgers, kebabs, tacos, paninis, salads and snacks (nuggets, p'tit croque, tenders, etc.). We also offer desserts! Label Rouge farm roast yellow chicken with boiled potatoes on Sunday lunchtimes!"
    ],
    "it": [
      "Spuntini da portare via.\r\nHamburger, kebab, tacos, panini, insalate e snack (nuggets, p'tit croque, tender, mozza sticks, nacho cheese, camembert a pezzetti, ecc.) e dessert!"
    ],
    "fr": [
      "Snacking à emporter. \r\nBurger, kebab, tacos, panini, salade et petite faim (nuggets, p'tit croque, tenders, mozza sticks, nachos cheese, bouchées camembert, etc..) mais également des desserts !"
    ],
    "nl": [
      "Snacks om mee te nemen.\r\nBurgers, kebabs, taco's, panini's, salades en snacks (nuggets, p'tit croque, tenders, mozza sticks, nacho cheese, hapklare camembert, enz.) en ook desserts!"
    ],
    "es": [
      "Aperitivos para llevar.\r\nHamburguesas, kebabs, tacos, paninis, ensaladas y aperitivos (nuggets, p'tit croque, tenders, mozza sticks, nacho cheese, bocaditos de camembert, etc.), ¡además de postres!"
    ]
  },
