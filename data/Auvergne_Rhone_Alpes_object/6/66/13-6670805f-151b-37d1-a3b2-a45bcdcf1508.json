  "rdfs:comment": {
    "de": [
      "Tanu Termier, Therapeutin für System- und Familienaufstellungen, Achtsamkeit und meditative Therapie, bietet das ganze Jahr über Retreats im Herzen des Vercors an."
    ],
    "en": [
      "Atit Tanu offers you meditation, full presence, stress reduction and meditative therapies."
    ],
    "it": [
      "Tanu Termier, terapeuta specializzata in costellazioni sistemiche e familiari, mindfulness e terapia meditativa, offre ritiri durante tutto l'anno nel cuore delle montagne del Vercors."
    ],
    "fr": [
      "Tanu Termier, thérapeute en constellations systémiques et familiales, en pleine conscience et en thérapie méditative, propose des retraites tout au long de l’année, au cœur du Vercors."
    ],
    "nl": [
      "Tanu Termier, therapeute gespecialiseerd in systemische en familieopstellingen, mindfulness en meditatieve therapie, biedt het hele jaar door retraites aan in het hart van de Vercors."
    ],
    "es": [
      "Tanu Termier, terapeuta especializada en constelaciones sistémicas y familiares, mindfulness y terapia meditativa, ofrece retiros durante todo el año en el corazón de las montañas del Vercors."
    ]
  },
