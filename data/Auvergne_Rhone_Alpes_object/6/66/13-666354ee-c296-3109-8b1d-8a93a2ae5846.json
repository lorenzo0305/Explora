  "rdfs:comment": {
    "de": [
      "Die Bar-Brasserie des Château des Ayes lädt Sie zu einem geselligen Gourmet-Erlebnis inmitten eines außergewöhnlichen Anwesens ein. Inmitten eines 2 ha großen Parks gelegen, vereint dieser Ort die zeitlose Eleganz des Schlosses mit einer entspannten und herzlichen Atmosphäre."
    ],
    "en": [
      "The Château des Ayes Bar-Brasserie invites you to enjoy a gourmet & convivial experience in the heart of an exceptional estate. Nestled in 2 hectares of verdant parkland, it combines the timeless elegance of the château with a warm, relaxed atmosphere."
    ],
    "it": [
      "Il Château des Ayes Bar-Brasserie vi invita a vivere un'esperienza gastronomica conviviale nel cuore di una tenuta eccezionale. Immerso in 2 ettari di parco verdeggiante, questo locale combina l'eleganza senza tempo del castello con un'atmosfera calda e rilassata."
    ],
    "fr": [
      "Le Bar-Brasserie du Château des Ayes vous invite à une expérience gourmande & conviviale au cœur d’un domaine d’exception. Niché dans un parc verdoyant de 2 ha, ce lieu allie l’élégance intemporelle du château à une atmosphère décontractée et chaleureuse."
    ],
    "es": [
      "El Bar-Brasserie del Château des Ayes le invita a disfrutar de una agradable experiencia gastronómica en el corazón de una finca excepcional. Ubicado en 2 hectáreas de verde parque, este lugar combina la elegancia atemporal del castillo con un ambiente cálido y relajado."
    ],
    "nl": [
      "De Bar-Brasserie van Château des Ayes nodigt je uit om te genieten van een gezellige gastronomische ervaring in het hart van een uitzonderlijk domein. Deze locatie, genesteld in 2 hectare groen park, combineert de tijdloze elegantie van het kasteel met een warme, ontspannen sfeer."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Brasserie du 133 jungle bar"
    ]
  },
