  "rdfs:comment": {
    "de": [
      "Mit ihrem Engagement in den Bereichen Kultur, Freizeit, Humanität und Solidarität bringt sie Menschen zusammen, die die Leidenschaft für Zweiräder und Kinder teilen."
    ],
    "en": [
      "With its strong commitment to culture, leisure, humanitarian action and solidarity, it brings together people who share a passion for two-wheelers and childhood."
    ],
    "it": [
      "Con un forte impegno per la cultura, il tempo libero, l'azione umanitaria e la solidarietà, riunisce persone che condividono la passione per le due ruote e i bambini."
    ],
    "fr": [
      "Forte de son engagement culturel, de loisirs, humanitaire et de solidarité, elle rassemble des personnes qui partagent la passion des deux-roues et de l'enfance."
    ],
    "nl": [
      "Met een sterke betrokkenheid bij cultuur, vrije tijd, humanitaire actie en solidariteit, brengt het mensen samen die een passie delen voor tweewielers en kinderen."
    ],
    "es": [
      "Con un fuerte compromiso con la cultura, el ocio, la acción humanitaria y la solidaridad, reúne a personas que comparten la pasión por las dos ruedas y los niños."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Une moto un jouet"
