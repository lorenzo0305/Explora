  "rdfs:comment": {
    "de": [
      "Das Levrette Café, der ehemalige Wachposten der Militärkaserne, empfängt Sie in einem Vintage- und Industrieambiente für Ihre Afterworks, Familienabende oder Partys mit Freunden."
    ],
    "en": [
      "Formerly the guardhouse of the Caserne Militaire, the Levrette Café welcomes you in a vintage and industrial atmosphere for your afterworks, your evenings with family or friends."
    ],
    "it": [
      "Ex sala di guardia della Caserma Militare, il Levrette Café vi accoglie in un'atmosfera vintage e industriale per il vostro dopolavoro, le vostre serate in famiglia o con gli amici."
    ],
    "fr": [
      "Ancien poste de garde de la Caserne Militaire, le Levrette Café vous accueille dans un ambiance vintage et industrielle pour vos afterworks, vos soirées en famille ou entre amis."
    ],
    "nl": [
      "Het Levrette Café, vroeger de wachtkamer van de militaire kazerne, verwelkomt je in een vintage en industriële sfeer voor je nawerk, je avonden met familie of vrienden."
    ],
    "es": [
      "Antiguo cuerpo de guardia del Cuartel Militar, el Café Levrette le acoge en un ambiente vintage e industrial para sus afterworks, sus veladas en familia o entre amigos."
    ]
  },
