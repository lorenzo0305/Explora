  "rdfs:comment": {
    "de": [
      "René, ein intimes und gemütliches Bistronomierestaurant in der Mitte der Mangard-Piste, überblickt das Fornet-Tal und bietet Ihnen eine gepflegte und leckere Küche."
    ],
    "en": [
      "René, an intimate and warm bistronomic restaurant, located in the middle of the Mangard slope, overlooks the Fornet valley and offers you a neat and gourmet cuisine."
    ],
    "it": [
      "René, un ristorante bistronomico intimo e caldo, situato al centro del pendio Mangard, si affaccia sulla valle del Fornet e vi offre una cucina curata e gourmet."
    ],
    "fr": [
      "René, restaurant bistronomique intimiste et chaleureux, situé au milieu de la piste Mangard, surplombe la vallée du Fornet et vous propose une cuisine soignée et gourmande."
    ],
    "nl": [
      "René, een warm en intiem bistronomisch restaurant midden op de Mangard piste, kijkt uit over de Fornet vallei en biedt een gastronomische keuken."
    ],
    "es": [
      "René, cálido e íntimo restaurante bistronómico situado en plena pista de Mangard, domina el valle del Fornet y ofrece una cocina gastronómica."
    ]
  },
