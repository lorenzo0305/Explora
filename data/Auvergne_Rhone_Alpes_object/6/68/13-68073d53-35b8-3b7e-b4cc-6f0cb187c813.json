  "rdfs:comment": {
    "de": [
      "Entdecken Sie zwischen hochgelegenen Dörfern und lokaler Landwirtschaft das Ennuyé-Tal mit seinen überraschenden Aussichtspunkten und verborgenen Schätzen!"
    ],
    "en": [
      "Between hilltop villages and local agriculture, discover the Vallée de l'Ennuyé, its surprising viewpoints and hidden treasures!"
    ],
    "it": [
      "Tra villaggi collinari e agricoltura locale, scoprite la Vallée de l'Ennuyé, i suoi sorprendenti punti panoramici e i suoi tesori nascosti!"
    ],
    "fr": [
      "Entres villages perchés et agriculture locale, découvrez la Vallée de l'Ennuyé, ses points de vues surprenants et ses trésors cachés !"
    ],
    "nl": [
      "Ontdek de Vallée de l'Ennuyé, tussen dorpjes op heuveltoppen en lokale landbouw, met zijn verrassende uitkijkpunten en verborgen schatten!"
    ],
    "es": [
      "Entre pueblos de montaña y agricultura local, descubra el Valle del Ennuyé, sus sorprendentes miradores y sus tesoros ocultos"
    ]
  },
  "rdfs:label": {
