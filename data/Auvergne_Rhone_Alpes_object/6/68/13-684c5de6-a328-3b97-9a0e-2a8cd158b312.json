  "rdfs:comment": {
    "de": [
      "Die Domaine Harmonia bietet Ihnen einen privaten Wellnessbereich für bis zu 4 Personen, der sich in einem 1 Hektar großen Park im Dorfzentrum befindet. Spa und Sauna laden Sie zu einer entspannenden Auszeit im Departement Isère ein."
    ],
    "en": [
      "Domaine Harmonia offers a private wellness center for up to 4 people, located in a 1 ha park in the heart of the village. Spa and sauna invite for a delightful resting moment in Isère."
    ],
    "it": [
      "Il Domaine Harmonia offre un'area benessere privata per un massimo di 4 persone, immersa in un ettaro di parco nel centro del paese. Spa e sauna per una pausa di relax in Isère."
    ],
    "fr": [
      "Le Domaine Harmonia vous propose un espace bien-être privatif jusqu’à 4 personnes, situé dans un parc d’un hectare en centre de village. Spa et sauna vous invitent à une parenthèse de détente en Isère."
    ],
    "es": [
      "Domaine Harmonia ofrece un espacio de bienestar privado para un máximo de 4 personas, situado en una hectárea de parque en el centro del pueblo. Spa y sauna para un descanso relajante en Isère."
    ],
    "nl": [
      "Domaine Harmonia biedt een privé wellnessruimte voor maximaal 4 personen, gelegen in een hectare park in het centrum van het dorp. Spa en sauna voor een ontspannende vakantie in Isère."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Domaine Harmonia - Spa & sauna"
    ]
  },
