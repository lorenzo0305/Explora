  "rdfs:comment": {
    "de": [
      "Die Seilbahn von La Perdrix bringt Sie auf 1800 m Höhe und ermöglicht Ihnen den Zugang zum gesamten Skigebiet und ein 360°-Panorama!"
    ],
    "en": [
      "The Perdrix cable car takes you up to an altitude of 1800 m; access to the entire ski area: 360° panorama."
    ],
    "it": [
      "La funivia di La Perdrix vi porta a 1800 m di altitudine, dandovi accesso all'intero comprensorio sciistico e a un panorama a 360°!"
    ],
    "fr": [
      "Le téléphérique de la Perdrix vous monte à 1800 m d’altitude, il vous permet l’accès à l’ensemble du domaine skiable et un panorama à 360° !"
    ],
    "es": [
      "El teleférico de La Perdrix le llevará a 1.800 m de altitud y le dará acceso a todo el dominio esquiable y a un panorama de 360°"
    ],
    "nl": [
      "De La Perdrix kabelbaan brengt je naar een hoogte van 1800 m, waardoor je toegang hebt tot het hele skigebied en een 360° panorama!"
    ]
  },
