  "rdfs:comment": {
    "de": [
      "Nutzen Sie diese unumgängliche Wanderung, um den Weiler Les Prés Plans und den friedlichen Ort, an dem mehrere Wasserläufe zusammenfließen, zu entdecken."
    ],
    "en": [
      "Take advantage of this not-to-be-missed walk to discover the hamlet of Prés Plans and the peaceful confluence of several rivers."
    ],
    "it": [
      "Approfittate di questa passeggiata da non perdere per scoprire il borgo di Prés Plans e la tranquilla confluenza di diversi fiumi."
    ],
    "fr": [
      "Profitez de cette balade incontournable pour découvrir hameau des Prés Plans et le paisible lieu de confluence de plusieurs cours d'eau."
    ],
    "nl": [
      "Profiteer van deze niet te missen wandeling om het gehucht Prés Plans en de vredige samenloop van verschillende rivieren te ontdekken."
    ],
    "es": [
      "Aproveche este paseo ineludible para descubrir la aldea de Prés Plans y la apacible confluencia de varios ríos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les deux ponts"
    ]
  },
