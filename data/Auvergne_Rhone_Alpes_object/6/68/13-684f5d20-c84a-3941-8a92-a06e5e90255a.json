  "rdfs:comment": {
    "de": [
      "Pitbull wird die LDLC Arena in Lyon-Décines am 11. November 2026 für einen Zwischenstopp auf seiner gigantischen \"I?M BACK\"-Tour in Flammen setzen. Machen Sie sich bereit für einen unvergesslichen Abend voller Energie und Welthits."
    ],
    "en": [
      "Pitbull will set the LDLC Arena in Lyon-Décines alight on 11 November 2026 as part of his massive ‘I'M BACK’ tour. Get ready for an unforgettable evening full of energy and global hits."
    ],
    "it": [
      "Pitbull infiammerà l'Arena LDLC di Lione-Décines l'11 novembre 2026 nell'ambito del suo mastodontico tour \"I?M BACK\". Preparatevi a una serata indimenticabile all'insegna dell'energia e delle hit mondiali."
    ],
    "fr": [
      "Pitbull enflammera la LDLC Arena de Lyon-Décines, le 11 novembre 2026 pour un arrêt dans sa gigantesque tournée « I’M BACK ». Préparez-vous à vivre une soirée inoubliable pleine d’énergie et de hits planétaires."
    ],
    "nl": [
      "Pitbull zet op 11 november 2026 de LDLC Arena in Lyon-Décines in vuur en vlam als onderdeel van zijn gigantische \"I?M BACK\"-tournee. Bereid je voor op een onvergetelijke avond vol energie en wereldwijde hits."
    ],
    "es": [
      "Pitbull incendiará el LDLC Arena de Lyon-Décines el 11 de noviembre de 2026 en el marco de su gigantesca gira \"I'M BACK\". Prepárate para una noche inolvidable de energía y éxitos mundiales."
    ]
  },
