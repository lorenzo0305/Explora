  "rdfs:comment": {
    "de": [
      "Im Herzen des Dorfes Meys laden wir Sie ein, eine gepflegte und herzhafte Küche zu genießen, die mit Produkten aus der Region zubereitet wird. Lebensmittelgeschäft, Café und Brotverkauf."
    ],
    "en": [
      "In the heart of the village of Meys, we invite you to come and enjoy our carefully prepared, hearty cuisine, made with local produce. Grocery, café and bread depot."
    ],
    "it": [
      "Nel cuore del villaggio di Meys, vi invitiamo a venire a gustare la nostra cucina gustosa e sostanziosa a base di prodotti locali. Negozio di alimentari, caffè e deposito di pane."
    ],
    "fr": [
      "Au coeur du village de Meys, nous vous invitons à venir déguster une cuisine soignée et copieuse, réalisée avec les produits du terroir. Epicerie, café et dépôt de pain."
    ],
    "nl": [
      "In het hart van het dorp Meys nodigen we je uit om te komen genieten van onze smakelijke, stevige keuken gemaakt met lokale producten. Kruidenierswinkel, café en brooddepot."
    ],
    "es": [
      "En el corazón del pueblo de Meys, le invitamos a disfrutar de nuestra cocina sabrosa y abundante, elaborada con productos locales. Tienda de comestibles, cafetería y panadería."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant Les Moissons"
    ]
  },
