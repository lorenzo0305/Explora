  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/d87a5db3-2927-3482-a5f6-5c8645512e2f",
      "dc:description": {
        "de": [
          "Als Spezialisten für die Vermietung von Immobilien begleiten wir Sie dabei, die richtige Immobilie für Sie zu finden. Egal, welche Immobilie Sie vermieten möchten, wir sind für Sie da."
        ],
        "en": [
          "As property rental specialists, we can help you find the right property for you. Whatever you're looking to rent, we're here to help."
        ],
        "it": [
          "In qualità di specialisti dell'affitto, possiamo aiutarvi a trovare la proprietà giusta per voi. Qualunque sia la proprietà che state cercando di affittare, siamo qui per aiutarvi."
        ],
        "fr": [
          "Spécialistes de la location immobilière, nous vous accompagnons pour trouver le bien immobilier qu'il vous faut. Quel que soit le bien que vous souhaitez louer, nous sommes à votre écoute."
        ],
        "es": [
          "Como especialistas en alquiler de propiedades, podemos ayudarle a encontrar la propiedad adecuada para usted. Sea cual sea la propiedad que desea alquilar, estamos aquí para ayudarle."
        ],
        "nl": [
          "Als verhuurspecialisten kunnen we je helpen de juiste woning te vinden. Welke woning je ook wilt huren, wij zijn er om je te helpen."
        ]
      },
      "@type": [
        "Description"
