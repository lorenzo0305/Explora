  "rdfs:comment": {
    "de": [
      "Das Museum wurde 1899 in einer ehemaligen Textilfabrik mit Sheddach und einer großen Halle gegründet, in der es sich befindet. Es zeigt eine bedeutende Sammlung antiker, mittelalterlicher, Renaissance- und moderner Moulagen: etwa 2000 Stücke."
    ],
    "en": [
      "Created in 1899 in a former shed-roofed textile factory with a large depot in which it is housed, the museum exhibits a large collection of ancient, medieval, renaissance and modern castings:  approx. 2000 items."
    ],
    "it": [
      "Creato nel 1899 in un'ex fabbrica tessile con tetto a capannoni e una grande sala in cui si trova, il museo presenta un'importante collezione di calchi antichi, medievali, rinascimentali e moderni: circa 2000 pezzi."
    ],
    "fr": [
      "Créé en 1899 dans une ancienne usine textile à toiture en sheds avec une grande halle où il se trouve, le musée présente une collection importante de moulages antiques, médiévaux, renaissance et modernes : environ 2000 pièces."
    ],
    "nl": [
      "Het museum, dat in 1899 werd opgericht in een voormalige textielfabriek met een schuurdak en een grote hal waarin het is gevestigd, presenteert een belangrijke collectie antieke, middeleeuwse, renaissance- en moderne afgietsels: ongeveer 2000 stuks."
    ],
    "es": [
      "Creado en 1899 en una antigua fábrica textil con techo de cobertizo y una gran sala donde se ubica, el museo presenta una importante colección de yesos antiguos, medievales, renacentistas y modernos: unas 2000 piezas."
    ]
  },
