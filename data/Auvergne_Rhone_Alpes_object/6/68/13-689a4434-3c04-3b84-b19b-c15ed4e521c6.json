  "rdfs:comment": {
    "de": [
      "Die Käserei Rochas wurde vor 50 Jahren als Familienunternehmen gegründet und hatte ihren Sitz in der Region Isère, ist nun aber auch in der Region Drôme angesiedelt."
    ],
    "en": [
      "Founded 50 years ago as a family business, the Rochas cheese dairy was originally located in Isère, but is now also established in the Drôme region."
    ],
    "it": [
      "Fondato 50 anni fa come azienda familiare, il caseificio Rochas aveva sede nell'Isère, ma ora è presente anche nella Drôme."
    ],
    "fr": [
      "Entreprise familiale fondée il y a 50 ans, la fromagerie Rochas était située en Isère mais elle est désormais implantée également dans la Drôme."
    ],
    "es": [
      "Fundada hace 50 años como empresa familiar, la quesería Rochas tenía su sede en Isère, pero ahora también está establecida en la Drôme."
