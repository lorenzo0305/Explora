  "rdfs:comment": {
    "de": [
      "Serge Vovk hat sich auf die Aufzucht von Geflügel alter französischer Rassen spezialisiert. Er arbeitet in Schulen, Freizeitzentren, Behindertenheimen und Altenheimen, um Küken mithilfe eines Brutkastens aufzuziehen."
    ],
    "en": [
      "Serge Vovk is specialized in the breeding of old French breeds of poultry. He intervenes in schools, leisure centres, with handicapped people and retirement homes in order to give birth to chicks with the help of an incubator."
    ],
    "it": [
      "Serge Vovk è specializzato nell'allevamento di vecchie razze francesi di pollame. Lavora nelle scuole, nei centri ricreativi, con i disabili e nelle case di riposo per allevare i pulcini con un'incubatrice."
    ],
    "fr": [
      "Serge Vovk est spécialisé dans l’élevage de volailles de races françaises anciennes. Il intervient au sein des écoles, des centres de loisirs, auprès de personnes handicapées et maison de retraite afin de faire naitre des poussins à l'aide d'une couveuse."
    ],
    "nl": [
      "Serge Vovk is gespecialiseerd in het fokken van oude Franse pluimveerassen. Hij werkt in scholen, recreatiecentra, met gehandicapten en bejaardentehuizen om kuikens groot te brengen met behulp van een broedmachine."
    ],
    "es": [
      "Serge Vovk está especializado en la cría de antiguas razas francesas de aves de corral. Trabaja en escuelas, centros de ocio, con personas discapacitadas y residencias de ancianos para criar pollos con una incubadora."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La ferme du Langot"
    ]
  },
