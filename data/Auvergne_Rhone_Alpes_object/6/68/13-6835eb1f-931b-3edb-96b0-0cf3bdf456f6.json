  "rdfs:comment": {
    "de": [
      "Reisen Sie mit Pizza Planète in Moulins in das Land der italienischen Aromen! Seit 1999 sind wir auf Pizza zum Mitnehmen spezialisiert. Entdecken Sie unsere köstlichen Kreationen, denen Sie garantiert verfallen werden."
    ],
    "en": [
      "Travel to the land of Italian flavors with Pizza Planet in Moulins! Specialized in pizza to go since 1999, discover gourmet creations that will make you succumb for sure."
    ],
    "it": [
      "Viaggiate nella terra dei sapori italiani con Pizza Planète a Moulins! Specializzati in pizza da asporto dal 1999, scoprite le creazioni gourmet che vi piaceranno sicuramente."
    ],
    "fr": [
      "Voyagez au pays des saveurs italiennes avec Pizza Planète à Moulins ! Spécialiste de la pizza à emporter depuis 1999, découvrez des créations gourmandes qui vous feront succomber à coup sûr."
    ],
    "es": [
      "Viaje al país de los sabores italianos con Pizza Planète en Moulins Especialistas en pizzas para llevar desde 1999, descubra creaciones gourmet que le encantarán."
    ],
    "nl": [
      "Reis naar het land van de Italiaanse smaken met Pizza Planète in Moulins! Specialisten in afhaalpizza's sinds 1999, ontdek gastronomische creaties die zeker zullen bevallen."
    ]
  },
