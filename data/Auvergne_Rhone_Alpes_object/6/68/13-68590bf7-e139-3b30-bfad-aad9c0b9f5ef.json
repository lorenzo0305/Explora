  "rdfs:comment": {
    "de": [
      "Die ECHTE handgemachte neapolitanische Pizza mit dem Geheimnis ihres Teigs, der in unseren neapolitanischen Kupferöfen gebacken wird! Aber auch ein qualitativ hochwertiges Angebot an italienischem Streetfood...\r\nVor Ort, zum Mitnehmen oder als Lieferservice."
    ],
    "en": [
      "The REAL handmade Neapolitan pizza, with all the secret of its dough cooked in our Neapolitan copper ovens! But also a qualitative range of Italian street food...\r\nOn the spot, to take away or for delivery."
    ],
    "it": [
      "La VERA pizza napoletana fatta a mano, con tutto il segreto del suo impasto cotto nei nostri forni napoletani in rame! Ma anche un'offerta qualitativa di street food italiano...\r\nSul posto, da portare via o da consegnare."
    ],
    "fr": [
      "La VÉRITABLE pizza napolitaine artisanale, avec tout le secret de sa pâte cuite dans nos fours napolitains en cuivre ! Mais aussi une gamme qualitative de street food italienne...\r\nSur place, à emporter ou en livraison."
    ],
    "es": [
      "¡La VERDADERA pizza napolitana hecha a mano, con todo el secreto de su masa cocinada en nuestros hornos napolitanos de cobre! Pero también una gama cualitativa de comida callejera italiana...\r\nEn el acto, para llevar o para entregar."
    ],
    "nl": [
      "De ECHTE handgemaakte Napolitaanse pizza, met al het geheim van het deeg gebakken in onze Napolitaanse koperen ovens! Maar ook een kwalitatief aanbod van Italiaans straatvoedsel...\r\nTer plaatse, om mee te nemen of om te bezorgen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant Il Gusto di Napoli"
    ]
  },
