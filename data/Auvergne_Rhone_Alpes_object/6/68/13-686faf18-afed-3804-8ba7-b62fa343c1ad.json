  "rdfs:comment": {
    "de": [
      "Klettern in völliger Freiheit...ohne Seil, ohne Einschränkungen, ohne Voraussetzungen, ohne besondere Kenntnisse, und das alles in völliger Sicherheit!\r\nVom Anfänger bis zum Fortgeschrittenen...kein Problem, es ist für jeden etwas dabei!"
    ],
    "en": [
      "Bloc à Brac is a bouldering gym, accessible to all and great fun for children."
    ],
    "it": [
      "Arrampicare in totale libertà... senza corda, senza vincoli, senza prerequisiti, senza conoscenze particolari, il tutto in totale sicurezza!\r\nDal principiante all'avanzato... non c'è problema, ce n'è per tutti i gusti!"
    ],
    "fr": [
      "L'escalade en toute liberté...sans corde, sans contraintes, sans prérequis, sans connaissances particulières, le tout en toute sécurité ! \r\nDu débutant au confirmé...pas de problème il y en a pour tout le monde !"
    ],
    "nl": [
      "Klimmen in alle vrijheid... zonder touw, zonder beperkingen, zonder vereisten, zonder speciale kennis, en dat alles in alle veiligheid!\r\nVan beginner tot gevorderde...geen probleem, er is voor elk wat wils!"
    ],
    "es": [
      "Escalada en total libertad... sin cuerda, sin limitaciones, sin requisitos previos, sin conocimientos especiales, ¡todo con total seguridad!\r\nDesde principiantes hasta avanzados... no hay problema, ¡hay algo para todos!"
    ]
  },
