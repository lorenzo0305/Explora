  "rdfs:comment": {
    "de": [
      "Ganzjährig geöffnet in der ehemaligen Hostellerie der Abtei, auf der Ebene des Kreuzgangs: Zugang über eine überdachte Treppe auf der rechten Seite der Abteikirche (große Glastüren) oder über einen Innenaufzug (links von der Treppe)"
    ],
    "en": [
      "Open all year round in the former hostelry of the abbey, on the cloister level: access by a covered staircase located on the right of the abbey church (large glass doors) or by an interior elevator (on the left of the staircase)"
    ],
    "it": [
      "Aperto tutto l'anno nell'antica locanda dell'abbazia, al livello del chiostro: accesso tramite una scala coperta a destra della chiesa abbaziale (grandi porte a vetri) o tramite un ascensore interno (a sinistra della scala)"
    ],
    "fr": [
      "Ouvert toute l'année dans l'ancienne hostellerie de l'abbaye, au niveau du cloître : accès par un escalier couvert situé sur la droite de l'église abbatiale (grandes portes vitrées) ou par ascenseur intérieur (à gauche de l'escalier)"
    ],
    "nl": [
      "Het hele jaar geopend in de voormalige herberg van de abdij, op kloosterniveau: toegang via een overdekte trap rechts van de abdijkerk (grote glazen deuren) of via een binnenlift (links van de trap)"
    ],
    "es": [
      "Abierto todo el año en la antigua hospedería de la abadía, en el nivel del claustro: acceso por una escalera cubierta a la derecha de la iglesia abacial (grandes puertas de cristal) o por un ascensor interior (a la izquierda de la escalera)"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Bureau d'Information Touristique"
    ]
  },
