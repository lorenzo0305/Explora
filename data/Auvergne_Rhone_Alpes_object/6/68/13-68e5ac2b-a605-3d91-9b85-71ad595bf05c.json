  "rdfs:comment": {
    "de": [
      "Machen Sie einen einstündigen Ausritt oder ein mehrtägiges Biwak mit unseren tapferen kleinen Pferden, die ohne Gebiss und ohne Eisen geritten werden. Lassen Sie sich von ihrer Anwesenheit inspirieren, um die wilden Landschaften des Haut-Diois zu genießen. Das Plus: Ausflüge in kleinen Gruppen von max. 4/5 Personen."
    ],
    "en": [
      "Set off on a 1-hour ride or a several-day bivouac with our valiant little horses, ridden without bits or shoes. Let their presence inspire you to savor the wild landscapes of the Haut-Diois region. Small group outings for up to 4/5 people."
    ],
    "it": [
      "Partite per una cavalcata di un'ora o per un bivacco di più giorni con i nostri valorosi cavallini, cavalcati senza morsi né scarpe. Lasciatevi ispirare dalla loro presenza per assaporare i paesaggi selvaggi dell'Haut-Diois. Il vantaggio: uscite in piccoli gruppi di 4/5 persone al massimo."
    ],
    "fr": [
      "Partez en balade d'1h ou en bivouac de plusieurs jours avec nos vaillants petits chevaux, montés sans mors et sans fers. Inspirez-vous de leur présence pour savourer les paysages sauvages du haut-Diois. Le + les sorties en petit groupe de 4/5 pers. max."
    ],
    "nl": [
      "Vertrek voor een tocht van 1 uur of een bivak van meerdere dagen met onze dappere paardjes, bereden zonder bitten of schoenen. Laat je inspireren door hun aanwezigheid om te genieten van de wilde landschappen van de Haut-Diois. De bonus: uitstapjes in kleine groepen van max. 4/5 personen."
    ],
    "es": [
      "Participe en un paseo de una hora o en un vivac de varios días con nuestros valientes caballitos, montados sin bocados ni herraduras. Déjese inspirar por su presencia para saborear los paisajes salvajes del Haut-Diois. El plus: salidas en pequeños grupos de 4/5 personas como máximo."
    ]
  },
