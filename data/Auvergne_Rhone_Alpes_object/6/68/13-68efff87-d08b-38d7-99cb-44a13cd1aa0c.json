  "rdfs:comment": {
    "de": [
      "Gemütliches savoyisches Restaurant, das großzügige Bergspezialitäten anbietet, darunter die unumgängliche Valaisanne. Gemütliche Bar mit PMU (Rennen auf Großbildschirm) und FDJ (Rubbelspiele, Sportwetten, AMIGO). Ein authentischer Ort, um Savoyen zu genießen!"
    ],
    "en": [
      "A welcoming Savoyard restaurant offering generous mountain specialities, including the unmissable Valaisanne. A friendly bar with PMU (horse racing on giant screens) and FDJ (scratch cards, Parions Sport, AMIGO). An authentic place to savour the Savoie region!"
    ],
    "it": [
      "Accogliente ristorante savoiardo con abbondanti specialità di montagna, tra cui l'imperdibile Valaisanne. Bar accogliente con PMU (gare su schermo gigante) e FDJ (gratta e vinci, Parions Sport, AMIGO). Un luogo autentico per assaporare la Savoia!"
    ],
    "fr": [
      "Restaurant savoyard chaleureux, proposant de généreuses spécialités de montagne, dont l’incontournable Valaisanne. Bar convivial avec PMU (courses sur écran géant) et FDJ (jeux à gratter, Parions Sport, AMIGO). Un lieu authentique pour savourer la Savoie!"
    ],
    "nl": [
      "Gezellig restaurant in Savoye, met royale bergspécialiteiten, waaronder de onmisbare Valaisanne. Gezellige bar met PMU (paardenraces op groot scherm) en FDJ (krasloten, Parions Sport, AMIGO). Een authentieke plek om van Savoye te genieten!"
    ],
    "es": [
      "Acogedor restaurante saboyano que sirve generosas especialidades de montaña, entre ellas la ineludible Valaisanne. Bar acogedor con PMU (carreras en pantalla gigante) y FDJ (tarjetas de rascar, Parions Sport, AMIGO). Un lugar auténtico para saborear Saboya"
    ]
  },
