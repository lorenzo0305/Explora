  "rdfs:comment": {
    "de": [
      "Herstellung von Bio-Sauerteigbroten, die in einem Holzofen in Barnave gebacken werden. Landbrot, Roggenbrot, Dinkelbrot; Brote mit Samen: Walnüsse, Haselnüsse, Sesam etc."
    ],
    "en": [
      "Production of organic leavened bread, cooked in a wood-fired oven in Barnave village. Farmhouse, rye, Einkorn-flour bread ; wholegrain bread with walnut, hazelnut, sesame..."
    ],
    "it": [
      "Pane biologico a lievitazione naturale, cotto nel forno a legna di Barnave. Pane rustico, pane di segale, piccolo pane di farro, pane con semi: noci, nocciole, sesamo, ecc."
    ],
    "fr": [
      "Fabrication de pains bio au levain, cuits dans un four à bois à Barnave. Pain de campagne, de seigle, de petit épeautre,  pains aux graines : noix, noisettes, sésame ..."
    ],
    "nl": [
      "Productie van biologisch brood met zuurdesem, gebakken in een houtoven in Barnave. Pain de campagne, roggebrood, speltbrood, meergranenbrood: noten, hazelnoten, sesam, etc..."
    ],
    "es": [
      "Pan de masa madre ecológico, cocido en horno de leña en Barnave. Pan de campo, pan de centeno, pan pequeño de espelta, panes con semillas: nuez, avellana, sésamo, etc."
    ]
  },
