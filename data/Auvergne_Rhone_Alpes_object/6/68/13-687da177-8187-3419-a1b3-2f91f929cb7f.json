  "rdfs:comment": {
    "de": [
      "Das in Neuville-les-Dames im Viertel des alten Bahnhofs gelegene Les Glycines bietet Ihnen eine traditionelle Küche mit hausgemachten Gerichten und Spezialitäten aus dem Departement Ain: frische Frösche, Huhn.fermier de l'Ain."
    ],
    "en": [
      "Proprietors Genevieve and Bruno Chatelet will be happy to welcome to their charming restaurant in Neuville-les-Dames.  Being located between the regions of Dombes & Saône and Bresse the menu is full of local specialities."
    ],
    "it": [
      "Situato a Neuville-les-Dames, nella zona della vecchia stazione ferroviaria, Les Glycines offre una cucina tradizionale, con piatti fatti in casa e specialità dell'Ain: rane fresche, pollo di fattoria dell'Ain."
    ],
    "fr": [
      "Situé à Neuville-les-Dames, dans le quartier de l’ancienne gare, Les Glycines vous propose une cuisine traditionnelle, avec des plats faits maison et des spécialités de l’Ain : grenouilles fraîches, poulet.fermier de l'Ain."
    ],
    "es": [
      "Situado en Neuville-les-Dames, en la zona de la antigua estación de tren, Les Glycines ofrece una cocina tradicional, con platos caseros y especialidades del Ain: ranas frescas, pollo de granja del Ain."
    ],
    "nl": [
      "Les Glycines, gelegen in Neuville-les-Dames, in de oude stationsbuurt, biedt een traditionele keuken, met huisgemaakte gerechten en specialiteiten uit de Ainstreek: verse kikkers, boerenkip uit de Ain."
    ]
  },
