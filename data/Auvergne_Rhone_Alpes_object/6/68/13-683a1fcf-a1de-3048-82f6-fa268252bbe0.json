  "rdfs:comment": {
    "de": [
      "Der Fades-Besserve-See ist ein Ort der Entspannung und Abwechslung und lädt zum Baden ein.\r\nSchwimmen unter Aufsicht vom 05.07. bis 29.08.\r\n\r\nVORÜBERGEHEND GESCHLOSSEN – AUS GESUNDHEITLICHEN GRÜNDEN"
    ],
    "en": [
      "A place of relaxation and a change of scenery, the Fades-Besserve lake will allow you to have a good time while swimming... Swimming supervised from 05/07 to 29/08.\r\n\r\nTEMPORARILY CLOSED - HEALTH REASONS"
    ],
    "it": [
      "Un luogo per rilassarsi e staccare la spina, il Lac des Fades-Besserve è il posto perfetto per godersi una nuotata rinfrescante. Nuoto sorvegliato dal 05/07 al 29/08."
    ],
    "fr": [
      "Lieu de détente et de dépaysement, le lac des Fades-Besserve vous permettra de passer un agréable moment à l'occasion d'une baignade. Baignade surveillée du 05/07 au 29/08."
    ],
    "nl": [
      "Het Lac des Fades-Besserve is een plek om te ontspannen en er even helemaal uit te zijn. Het is de perfecte plek om te genieten van een verfrissende duik. Zwemmen onder toezicht van 05/07 tot 29/08."
    ],
    "es": [
      "El lago de Fades-Besserve es el lugar ideal para relajarse y desconectar de la rutina. Natación vigilada del 05/07 al 29/08."
    ]
  },
  "rdfs:label": {
    "en": [
      "Swimming - La Chazotte"
    ],
    "fr": [
      "Baignade - La Chazotte"
    ]
  },
