  "rdfs:comment": {
    "de": [
      "Ein zweieinhalbtägiger Intensivkurs, der speziell für Jugendliche zwischen 12 und 17 Jahren konzipiert wurde.\r\nAuf dem Programm stehen Improvisation, Erkundung der Werkzeuge des Schauspielers, Arbeit auf der Bühne, gemeinsame Kreationen?"
    ],
    "en": [
      "An immersive two-and-a-half-day workshop specially designed for teenagers aged 12 to 17.\r\nOn the program: improvisation, exploration of the actor?s tools, stage work, collective creations?"
    ],
    "it": [
      "Un corso immersivo di due giorni e mezzo pensato appositamente per gli adolescenti dai 12 ai 17 anni.\r\nIn programma: improvvisazione, esplorazione degli strumenti dell'attore, lavoro scenico, creazioni collettive?"
    ],
    "fr": [
      "Un stage immersif de deux jours et demi, spécialement conçus pour les adolescents de 12 à 17 ans.\r\nAu programme: improvisation, exploration des outils de l’acteur, travail sur scène, créations collectives…"
    ],
    "es": [
      "Un curso de inmersión de dos días y medio especialmente diseñado para adolescentes de 12 a 17 años.\r\nEn el programa: improvisación, exploración de las herramientas del actor, trabajo escénico, creaciones colectivas.."
    ],
    "nl": [
      "Een meeslepende cursus van tweeënhalve dag, speciaal ontworpen voor tieners van 12 tot 17 jaar.\r\nOp het programma: improvisatie, verkenning van het gereedschap van de acteur, toneelwerk, collectieve creaties?"
    ]
  },
