  "rdfs:comment": {
    "de": [
      "Produktion von Gemüse, einigen Früchten und Kräutern im Freiland und im Gewächshaus im ökologischen Landbau - Fruchtsäfte, Konserven, Laktofermentationen und Gewürze - Wöchentliche Saisonkörbe oder Einzelhandel"
    ],
    "en": [
      "Organic production of vegetables, some fruits and herbs in open fields and greenhouses - Fruit juices, preserves, lacto-ferments and condiments - Weekly seasonal baskets or retail sales"
    ],
    "it": [
