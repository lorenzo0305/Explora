  "rdfs:comment": {
    "de": [
      "In der Halle aux artistes werden im Ausstellungsraum der Grenette die Werke mehrerer Künstler mit unterschiedlichen Ausdrucksformen präsentiert.\r\nEs werden sowohl Stammgäste als auch Neuankömmlinge zu sehen sein."
    ],
    "en": [
      "La Halle aux Artistes presents the work of a wide range of artists at the Grenette exhibition hall.\r\nThere will be both regulars and newcomers."
    ],
    "it": [
      "La Halle aux Artistes presenta le opere di una vasta gamma di artisti nella sala espositiva della Grenette.\r\nSaranno presenti sia gli artisti abituali che i nuovi arrivati."
    ],
    "fr": [
      "La Halle aux artistes, c'est la présentation de travaux de plusieurs artistes d’expression variée à la salle d’expositions de la Grenette. \r\nOn retrouvera des habitués et aussi des nouveaux venus."
    ],
    "es": [
      "La Halle aux Artistes presenta la obra de un amplio abanico de artistas en la sala de exposiciones de la Grenette.\r\nHabrá tanto habituales como recién llegados."
    ],
    "nl": [
      "De Halle aux Artistes toont het werk van een breed scala aan kunstenaars in de expositiehal Grenette.\r\nEr zijn zowel vaste gasten als nieuwkomers."
    ]
  },
  "rdfs:label": {
