  "rdfs:comment": {
    "de": [
      "Kindergarten der französischen Skischule im Waldsektor neben den Residenzen Belambra, le Hameau du Beaufortain, Amaya. Bietet eine erste Einführung in den Skisport für Kinder von 3 bis 4,5 Jahren und ist mit einem überdachten Teppich ausgestattet."
    ],
    "en": [
      "French Ski School kindergarten located in the forest area next to the Belambra, Hameau du Beaufortain and Amaya residences. Offers a first introduction to skiing for children aged 3 to 4 and a half, and is equipped with a covered carpet."
    ],
    "it": [
      "Scuola di sci francese situata nell'area forestale vicino ai residence Belambra, Hameau du Beaufortain e Amaya. Offre una prima introduzione allo sci per bambini dai 3 ai 4 anni e mezzo ed è dotato di un tappeto coperto."
    ],
    "fr": [
      "Jardin d'enfants de l'Ecole de Ski Français situé dans le secteur de la forêt à côté des résidences Belambra, le Hameau du Beaufortain, Amaya. Propose une première initiation au ski pour les enfants de 3 à 4 ans et demi et est équipé d'un tapis couvert."
    ],
    "nl": [
      "Kleuterschool van de Franse skischool gelegen in het bosgebied naast de Belambra, Hameau du Beaufortain en Amaya residenties. Biedt een eerste kennismaking met skiën voor kinderen van 3 tot 4 en een half jaar en is uitgerust met een overdekt tapijt."
    ],
    "es": [
      "Guardería de la Escuela Francesa de Esquí situada en la zona forestal junto a las residencias Belambra, Hameau du Beaufortain y Amaya. Ofrece una primera iniciación al esquí para niños de 3 a 4 años y medio y está equipada con una alfombra cubierta."
    ]
  },
  "rdfs:label": {
    "en": [
      "ESF Les Saisies forest area kinder garden"
    ],
    "it": [
      "Asilo ESF della foresta"
    ],
    "fr": [
      "Jardin d'enfants ESF Belambra"
    ],
    "nl": [
