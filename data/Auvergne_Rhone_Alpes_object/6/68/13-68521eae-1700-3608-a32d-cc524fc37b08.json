  "rdfs:comment": {
    "de": [
      "Gegenüber dem Schloss können Sie eine Pause einlegen und sich mit unseren lokalen Produkten verwöhnen lassen. Eine Reservierung wird empfohlen. Themenabende (siehe soziale Netzwerke)."
    ],
    "en": [
      "In front of the castle, have a break and feast with our local products. Reservation advised. Theme evenings (see social networks)."
    ],
    "it": [
      "Di fronte al castello, fate una pausa e gustate i nostri prodotti locali. Si consiglia la prenotazione. Serate a tema (vedi social network)."
    ],
    "fr": [
      "Face au château, faites une pause et régalez-vous avec nos produits locaux. Réservation conseillée. Soirées à thème (voir réseaux sociaux)."
    ],
    "nl": [
      "Neem tegenover het kasteel een pauze en trakteer jezelf op onze lokale producten. Reserveren aanbevolen. Thema-avonden (zie sociale netwerken)."
    ],
    "es": [
      "Frente al castillo, tómese un respiro y deléitese con nuestros productos locales. Se recomienda reservar. Veladas temáticas (ver redes sociales)."
    ]
  },
  "rdfs:label": {
