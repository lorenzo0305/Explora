  "rdfs:comment": {
    "de": [
      "La Ferme de Coucou ist ein familiengeführter Bio-Bauernhof mit gemischter Landwirtschaft und Viehzucht.\r\nWir freuen uns, Ihnen Ziegenkäse, Kirschen, Aprikosen, Nektar und Konfitüre aus unseren Früchten sowie unsere ätherischen Lavendelöle zum Verkauf anbieten zu können."
    ],
    "en": [
      "La Ferme de Coucou is a family-run, organic, mixed-crop farm.\r\nWe are pleased to offer you goat's cheese, cherries, apricots, nectar and jam made from our fruit, as well as our lavender essential oils."
    ],
    "it": [
      "La Ferme de Coucou è un'azienda agricola biologica e mista a conduzione familiare.\r\nSiamo lieti di offrirvi formaggio di capra, ciliegie, albicocche, nettare e marmellata prodotti con la nostra frutta, nonché i nostri oli essenziali di lavanda."
    ],
    "fr": [
      "La Ferme de Coucou est une ferme familiale bio en polyculture élevage.\r\nNous avons le plaisir de vous proposer à la vente fromages de chèvre, cerises, abricots, nectar et confiture, issus de nos fruits, ainsi que nos huiles essentielles de lavande."
    ],
    "nl": [
      "La Ferme de Coucou is een biologisch familiebedrijf met gemengde bedrijven.\r\nWe zijn blij dat we je geitenkaas, kersen, abrikozen, nectar en jam van ons fruit kunnen aanbieden, evenals onze essentiële lavendeloliën."
    ],
    "es": [
      "La Ferme de Coucou es una explotación familiar de agricultura ecológica mixta.\r\nEstamos encantados de ofrecerle queso de cabra, cerezas, albaricoques, néctar y mermelada de nuestra fruta, así como nuestros aceites esenciales de lavanda."
    ]
  },
  "rdfs:label": {
