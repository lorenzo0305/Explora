  "rdfs:comment": {
    "de": [
      "Schleifwerkstatt, Verkauf von Töpferwaren, Verkauf von handwerklichen Produkten (Honig, Terrinen, Kekse, Kräutertees, Messer), die von uns ausgewählt wurden, an einem Ort, den wir warm, offen und günstig für schöne Begegnungen gestalten wollen...."
    ],
    "en": [
      "Sharpening workshop, sale of pottery, sale of handcrafted products (honeys, terrines, cookies, herbal teas, knives) selected by us, in a place that we want to be warm, open and conducive to beautiful encounters...."
    ],
    "it": [
      "Laboratorio di affilatura, vendita di ceramiche, vendita di prodotti artigianali (mieli, terrine, biscotti, tisane, coltelli) selezionati da noi, in un luogo che vogliamo sia caldo, aperto e favorevole ai grandi incontri...."
    ],
    "fr": [
      "Atelier d'affûtage, vente de poteries, vente de produits artisanaux (miels, terrines, biscuits, tisanes, couteaux) sélectionnés par nos soins, dans un lieu que nous voulons chaleureux, ouvert et propice aux belles rencontres...."
    ],
    "es": [
      "Taller de afilado, venta de cerámica, venta de productos artesanales (mieles, terrinas, galletas, tisanas, cuchillos) seleccionados por nosotros, en un lugar que queremos que sea cálido, abierto y propicio para grandes encuentros...."
    ],
    "nl": [
      "Slijpatelier, verkoop van aardewerk, verkoop van handgemaakte producten (honing, terrines, koekjes, kruidenthee, messen) geselecteerd door ons, in een plek die we willen warm, open en bevorderlijk zijn voor grote ontmoetingen ...."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Atelier boutique Sauve qui coupe - L'Ame de Mailhat"
    ]
  },
