  "rdfs:comment": {
    "de": [
      "Ein kulinarisches Abenteuer auf der Entdeckung kreativer und köstlicher Geschmäcker, eine saisonale Speisekarte mit frischen und lokalen Produkten, um das Wohlbefinden durch das Erwecken aller Sinne im Restaurant und im Teesalon zu verlängern."
    ],
    "en": [
      "A culinary adventure to discover creative and seasonal flavours, all home-cooked. \r\nChristine Jeantet, master restaurateur, and Steven, concoct dishes with a thousand flavours for your enjoyment, using fresh and regional products."
    ],
    "it": [
      "Un'avventura culinaria alla scoperta di sapori creativi e gourmet, un menu stagionale con prodotti freschi e locali, per prolungare il senso di benessere nel ristorante e nella sala da tè."
    ],
    "fr": [
      "Une aventure culinaire à la découverte de saveurs créatives et gourmandes, un carte de saison avec des produits frais et locaux, pour prolonger le bien-être par l'éveil de tous les sens au restaurant et au salon de thé."
    ],
    "es": [
      "Una aventura culinaria para descubrir sabores creativos y gastronómicos, una carta de temporada con productos frescos y locales, para prolongar su sensación de bienestar en el restaurante y el salón de té."
    ],
    "nl": [
      "Een culinair avontuur om creatieve, gastronomische smaken te ontdekken, een seizoensgebonden menu met verse, lokale producten, om je gevoel van welzijn te vergroten in het restaurant en de tearoom."
    ]
  },
