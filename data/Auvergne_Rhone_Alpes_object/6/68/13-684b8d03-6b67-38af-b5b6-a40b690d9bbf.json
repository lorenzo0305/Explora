  "rdfs:comment": {
    "de": [
      "Sie verspüren das Bedürfnis nach Erholung, Freizeit, Zeit für sich, Entspannung? Ein Team von Fachleuten erwartet Sie mit einem À-la-carte-Wellnessprogramm."
    ],
    "en": [
      "Need to relax, want to have fun, wish to recharge your batteries? Come and meet our team to enjoy a unique, customised treatment in line with your expectations."
    ],
    "it": [
      "Avete bisogno di rilassarvi, di concedervi un po' di relax, di ricaricare le batterie? Unitevi al nostro team per un trattamento unico e su misura che soddisfi ogni vostra esigenza."
    ],
    "fr": [
      "Besoin de vous détendre, envie de vous faire plaisir, souhait de vous ressourcer ? Venez retrouver notre équipe pour profiter d’un soin unique, sur-mesure, en phase avec vos attentes du moment."
    ],
    "es": [
      "¿Necesita relajarse, darse un capricho o recargar las pilas? Únase a nuestro equipo para disfrutar de un tratamiento único y personalizado que satisfaga todas sus necesidades."
    ],
    "nl": [
      "Behoefte om te ontspannen, jezelf te verwennen, nieuwe energie op te doen? Kom naar ons team voor een unieke behandeling op maat die aan al je behoeften voldoet."
    ]
  },
  "rdfs:label": {
    "de": [
      "Wellnesszentrum \"Ô des Cimes\""
    ],
    "en": [
      "Beauty center Ô des Cimes - CGH Le Village de Lessy Residence"
    ],
    "fr": [
      "Spa d’altitude Ô des Cimes – Résidence CGH Le Village de Lessy"
    ]
  },
