  "rdfs:comment": {
    "de": [
      "Eine gemütliche Bar, in der Sie unsere Cocktails, Biere, Weine und viele andere Elixiere von den einfachsten bis zu den wertvollsten entdecken können."
    ],
    "en": [
      "A friendly bar where you can discover our cocktails, beers, wines and many other elixirs, from the simplest to the most precious."
    ],
    "it": [
      "Un bar accogliente dove scoprire i nostri cocktail, birre, vini e molti altri elisir, dai più semplici ai più preziosi."
    ],
    "fr": [
      "Un bar convivial où vous pourrez y découvrir nos cocktails, bières, vins et de nombreux autres élixirs des plus simples aux plus précieux."
    ],
    "es": [
      "Un bar acogedor donde podrá descubrir nuestros cócteles, cervezas, vinos y muchos otros elixires, desde los más sencillos hasta los más preciosos."
    ],
    "nl": [
      "Een gezellige bar waar je onze cocktails, bieren, wijnen en vele andere elixers kunt ontdekken, van de meest eenvoudige tot de meest kostbare."
    ]
  },
