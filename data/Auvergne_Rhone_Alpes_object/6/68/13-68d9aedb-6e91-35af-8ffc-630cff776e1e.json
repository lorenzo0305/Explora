  "rdfs:comment": {
    "de": [
      "Aïga Resort Thermal & Spa empfängt Sie für jede Art von Veranstaltung mit bis zu 450 Personen, von halbtägigen Meetings bis zu mehrtägigen Seminaren mit integrierter Unterkunft und Aktivitäten."
    ],
    "en": [
      "Aïga Resort Thermal & Spa welcomes all types of events for up to 450 people, from half-day meetings to multi-day seminars with integrated accommodation and activities."
    ],
    "it": [
      "L'Aïga Resort Thermal & Spa accoglie tutti i tipi di eventi fino a 450 persone, da riunioni di mezza giornata a seminari di più giorni con alloggio e attività integrate."
    ],
    "fr": [
      "Aïga Resort Thermal & Spa vous accueille pour tout type d’événement jusqu’à 450 personnes, de la réunion d’une demi-journée aux séminaires de plusieurs jours avec hébergement intégré et activités."
    ],
    "nl": [
      "Aïga Resort Thermal & Spa verwelkomt alle soorten evenementen voor maximaal 450 personen, van vergaderingen van een halve dag tot meerdaagse seminars met geïntegreerde accommodatie en activiteiten."
    ],
    "es": [
      "Aïga Resort Thermal & Spa acoge todo tipo de eventos para un máximo de 450 personas, desde reuniones de media jornada hasta seminarios de varios días con alojamiento y actividades integradas."
    ]
  },
  "rdfs:label": {
