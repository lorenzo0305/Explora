  "rdfs:comment": {
    "de": [
      "Kaffee und Tee gibt es am Morgen, dann 100 % hausgemachte Küche, frische Produkte zum Mittag- und Abendessen, Weinbar und Cocktails mit Tapas zum Aperitif!"
    ],
    "en": [
      "Coffee and tea in the morning, then 100% home cooking, fresh produce for lunch and dinner, wine bar and cocktails with tapas for aperitifs!"
    ],
