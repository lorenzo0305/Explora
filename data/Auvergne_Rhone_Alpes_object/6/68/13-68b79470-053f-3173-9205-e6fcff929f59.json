  "rdfs:comment": {
    "de": [
      "Wandern oder Schneeschuhwandern, Trail, Trekking, Biwak, alle Ansätze sind gut, um in die Berge zu kommen und diese außergewöhnliche natürliche Umgebung zu erkunden."
    ],
    "en": [
      "Hiking, snowshoeing, trail walking, trekking, bivouacking - there's no better way to explore the mountains and discover this extraordinary natural environment."
    ],
    "it": [
      "Escursioni, ciaspolate, passeggiate, trekking, bivacchi: non c'è modo migliore per esplorare le montagne e scoprire questo straordinario ambiente naturale."
    ],
    "fr": [
      "Randonnée pédestre ou en raquette, trail, trek, bivouac, toutes les approches sont bonnes pour venir explorer la montagne et découvrir cet environnement naturel hors du commun."
    ],
    "nl": [
      "Wandelen, sneeuwschoenwandelen, trektochten maken, bivakkeren - er is geen betere manier om de bergen te verkennen en deze buitengewone natuurlijke omgeving te ontdekken."
    ],
    "es": [
      "Senderismo, raquetas de nieve, senderismo, trekking, vivac... no hay mejor manera de explorar las montañas y descubrir este extraordinario entorno natural."
    ]
  },
