  "rdfs:comment": {
    "de": [
      "Wagen Sie den Schritt zum Schneeschuhwandern! Entdecken Sie die Magie des Schnees und tanken Sie neue Energie in einer unberührten Natur, 1/2 Tag, ganztägig oder bei Nacht.\r\nGanztägige Wanderungen mit unterschiedlichen Themen bei jedem Ausflug."
    ],
    "en": [
      "Dare to snowshoe! Discover the magic of the snow and recharge your batteries in unspoilt natural surroundings, for 1/2 day, full day or night outings.\r\nDay hikes with different themes on each outing."
    ],
    "it": [
      "Andate con le racchette da neve! Scoprite la magia della neve e fate il pieno di energia in un ambiente naturale incontaminato, per escursioni di mezza giornata, giornata intera o notturna.\r\nEscursioni giornaliere con temi diversi per ogni uscita."
    ],
    "fr": [
      "Osez la raquette à neige ! Découvrez la magie de la neige, et ressourcez-vous dans une nature préservée, en 1/2 journée, en journée, ou en nocturne.\r\nRandonnée à la journée avec des thématiques différentes à chaque sortie."
    ],
    "nl": [
      "Raquett'Evasion een groep bergleiders met passie voor de bergen"
    ],
    "es": [
      "Raquetas de nieve Descubra la magia de la nieve y recargue las pilas en un entorno natural intacto, en salidas de 1/2 día, de día completo o nocturnas.\r\nExcursiones de un día con temas diferentes en cada salida."
    ]
  },
