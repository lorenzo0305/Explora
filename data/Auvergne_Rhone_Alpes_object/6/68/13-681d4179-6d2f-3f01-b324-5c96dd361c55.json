  "rdfs:comment": {
    "de": [
      "Les Assembleurs ist eine tolle Weinbar, aber nicht nur! Die Küche ist großzügig und authentisch, die Biere werden sorgfältig ausgewählt und das Team freut sich, seine Leidenschaft mit Ihnen teilen zu können."
    ],
    "en": [
      "Les Assembleurs is a great wine bar, but not the only one! The food is generous and authentic, the beers are carefully selected and the team are delighted to share their passion with you."
    ],
    "it": [
      "Les Assembleurs è un ottimo wine bar, ma non l'unico! Il cibo è generoso e autentico, le birre sono selezionate con cura e il team è lieto di condividere la propria passione con voi."
    ],
    "fr": [
      "Les Assembleurs, c’est un super bar à vin, mais pas que ! La cuisine se veut généreuse et authentique, les bières sont sélectionnées avec soin et l'équipe est ravie de pouvoir partager avec vous sa passion."
    ],
    "nl": [
      "Les Assembleurs is een geweldige wijnbar, maar niet de enige! Het eten is royaal en authentiek, de bieren zijn zorgvuldig geselecteerd en het team deelt graag hun passie met je."
    ],
    "es": [
      "Les Assembleurs es un gran bar de vinos, ¡pero no el único! La comida es generosa y auténtica, las cervezas están cuidadosamente seleccionadas y el equipo está encantado de compartir su pasión con usted."
    ]
  },
