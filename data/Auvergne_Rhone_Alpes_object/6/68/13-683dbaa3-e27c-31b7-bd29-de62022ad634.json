  "rdfs:comment": {
    "de": [
      "Quercus und Co. ist :\r\nEine Reise durch das Tierreich und die Welt der Bäume.\r\nEine (Wieder-)Entdeckung der Natur, die uns umgibt, die Natur des Alltags.\r\nEine Möglichkeit, sich für die Schönheit des Lebendigen zu sensibilisieren."
    ],
    "en": [
      "Quercus et Cie is :\r\nA journey to the heart of the animal kingdom and the world of trees.\r\nA (re)discovery of the Nature that surrounds us, the Nature of everyday life.\r\nA way to appreciate the beauty of life."
    ],
    "it": [
      "Quercus et Cie è :\r\nUn viaggio nel cuore del regno animale e del mondo degli alberi.\r\nUna (ri)scoperta della Natura che ci circonda, quella che vediamo ogni giorno.\r\nUn modo per apprezzare la bellezza della vita."
    ],
    "fr": [
      "Quercus et Cie c’est :\r\nUn voyage au cœur du règne animal et du monde des arbres.\r\nUne (re)découverte de cette Nature qui nous entoure, celle de tous les jours.\r\nUne façon de se sensibiliser à la beauté du Vivant."
    ],
    "nl": [
      "Quercus et Cie is :\r\nEen reis naar het hart van het dierenrijk en de wereld van de bomen.\r\nEen (her)ontdekking van de natuur die ons omringt, de natuur die we elke dag zien.\r\nEen manier om de schoonheid van het leven te waarderen."
    ],
    "es": [
      "Quercus et Cie es :\r\nUn viaje al corazón del reino animal y al mundo de los árboles.\r\nUn (re)descubrimiento de la Naturaleza que nos rodea, la que vemos cada día.\r\nUna forma de apreciar la belleza de la vida."
    ]
  },
  "rdfs:label": {
