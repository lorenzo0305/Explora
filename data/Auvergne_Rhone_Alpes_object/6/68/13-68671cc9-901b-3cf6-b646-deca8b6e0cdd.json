  "rdfs:comment": {
    "de": [
      "Restaurant mit Bar. Erfinderische französisch-belgische Küche mit einer Spezialität aus hausgemachten Burgern.\r\nIn der Bar finden Sie vor allem lokale Biere aus der Dauphiné, und im Feinkostladen werden lokale Spezialitäten angeboten."
    ],
    "en": [
      "Restaurant and bar. Inventive Franco-Belgian cuisine with a speciality of homemade burgers.\r\nThe bar features local Dauphiné beers, and the delicatessen offers local specialities."
    ],
    "it": [
      "Ristorante e bar. Cucina franco-belga inventiva con una specialità di hamburger fatti in casa.\r\nAl bar troverete birre locali del Delfinato, mentre la gastronomia offre specialità locali."
    ],
    "fr": [
      "Restaurant bar. Cuisine inventive franco belge avec une spécialité de burgers faits maison.\r\nAu bar vous trouverez notamment des bières locales du Dauphiné, et l'épicerie fine vous propose des spécialités locales."
    ],
    "es": [
      "Restaurante y bar. Cocina franco-belga inventiva con especialidad en hamburguesas caseras.\r\nEn el bar encontrará cervezas locales del Dauphiné, y la charcutería ofrece especialidades locales."
    ],
    "nl": [
      "Restaurant en bar. Inventieve Frans-Belgische keuken met als specialiteit huisgemaakte hamburgers.\r\nAan de bar vindt u lokale bieren uit de Dauphiné, en de delicatessenwinkel biedt lokale specialiteiten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Comptoir des Géants"
    ]
  },
