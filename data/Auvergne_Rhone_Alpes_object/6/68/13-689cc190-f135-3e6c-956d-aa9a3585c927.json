  "rdfs:comment": {
    "de": [
      "Eiscreme, Speiseeis, Sorbets, Eisdesserts, Dessertcremes, Milch und Joghurt aus Vercors-Milch.\r\nProdukte vom Bauernhof, die mit der guten Milch unserer Kühe hergestellt werden."
    ],
    "en": [
      "Ice creams, sorbets, frozen desserts, cream desserts, milk and yoghurts made from Vercors milk. Farm products made with the good milk of our cows."
    ],
    "it": [
      "Gelati, sorbetti, dessert congelati, creme da dessert, latte e yogurt prodotti con latte del Vercors.\r\nDessert congelati su ordinazione\r\nProdotti della fattoria realizzati con il buon latte delle nostre mucche.\r\nVisite in fattoria durante le vacanze scolastiche su prenotazione."
    ],
    "fr": [
      "Crèmes glacées, glaces, sorbets, dessert glacés, crèmes dessert, lait et yaourts au lait du Vercors.\r\nDessert glacé sur commande\r\nProduits de la ferme réalisés avec le bon lait de nos vaches.\r\nVisite de ferme pendant les vacances scolaires sur réservation."
    ],
    "nl": [
      "IJs, sorbets, diepvriesdesserts, dessertroom, melk en yoghurt gemaakt met Vercors melk.\r\nDiepvriesdesserts op bestelling\r\nBoerderijproducten gemaakt met de goede melk van onze koeien.\r\nBezoek aan de boerderij tijdens schoolvakanties op afspraak."
    ],
    "es": [
      "Helados, sorbetes, postres congelados, cremas de postre, leche y yogures elaborados con leche de Vercors.\r\nPostres congelados por encargo\r\nProductos de granja elaborados con la buena leche de nuestras vacas.\r\nVisitas a la granja durante las vacaciones escolares previa concertación."
    ]
  },
