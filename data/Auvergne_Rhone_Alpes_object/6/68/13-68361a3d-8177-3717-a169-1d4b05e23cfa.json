  "rdfs:comment": {
    "de": [
      "Wir sind eine handwerkliche Brennerei, die sich im Parc du Pilat niedergelassen hat. Wir destillieren fröhliche und lokale Bio-Spirituosen und Aperitifgetränke, die das Leben respektieren."
    ],
    "en": [
      "An artisan distillery based in the Parc du Pilat, we distill spirits and aperitifs that are organic, joyful, local and respectful of the living world."
    ],
    "it": [
      "Distilleria artigianale con sede nel Parc du Pilat, distilliamo liquori e aperitivi biologici, allegri, locali e rispettosi dell'ambiente."
    ],
    "fr": [
      "Distillerie Artisanale installée dans le Parc du Pilat, nous distillons des spiritueux et boissons apéritives bio, joyeuses et locales, respectueuses du vivant."
    ],
    "es": [
      "Destilería artesanal situada en el Parque del Pilat, destilamos espirituosos y aperitivos ecológicos, alegres, locales y respetuosos con el medio ambiente."
    ],
    "nl": [
      "Als ambachtelijke distilleerderij in het Parc du Pilat distilleren we biologische, vrolijke en lokale likeuren en aperitieven met respect voor het milieu."
    ]
  },
