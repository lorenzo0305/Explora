  "rdfs:comment": {
    "de": [
      "Entdecken Sie die wunderschönen Schluchten des Chassezac in völliger Freiheit. Mieten Sie Ihr Boot so lange Sie wollen (von 2 Stunden bis zu einem ganzen Tag) und genießen Sie den Charme des Flusses in vollen Zügen. Buchen Sie schnell online!"
    ],
    "en": [
      "Come and discover the beautiful Gorges du Chassezac in complete freedom. Rent your boat for as long as you want (2 hours to the day) and enjoy the charm of the river. Book online and get 10% discount!"
    ],
    "it": [
      "Venite a scoprire le magnifiche Gole dello Chassezac in piena libertà. Noleggiate la vostra barca per tutto il tempo che volete (da 2 ore a un giorno intero) e approfittate del fascino del fiume. Prenotate subito online!"
    ],
    "fr": [
      "Venez découvrir les magnifiques Gorges du Chassezac en toute liberté. Louez votre embarcation aussi longtemps que vous le désirez (de 2h à la journée) et profitez pleinement du charme de la rivière. Réservez-vite en ligne !"
    ],
    "es": [
      "Venga a descubrir las magníficas Gargantas del Chassezac con total libertad. Alquile su barco durante el tiempo que desee (de 2 horas a un día entero) y aproveche al máximo el encanto del río. ¡Reserve ahora online!"
    ],
    "nl": [
      "Kom en ontdek de prachtige Gorges du Chassezac in alle vrijheid. Huur je boot zo lang als je wilt (van 2 uur tot een hele dag) en profiteer optimaal van de charme van de rivier. Boek nu online!"
    ]
  },
