  "rdfs:comment": {
    "de": [
      "Auf der Straße nach Saint-Nectaire, komfortable, renovierte Zimmer mit Schallschutzverglasung. In der Nähe der wichtigsten Sehenswürdigkeiten. Park am Ufer des Flusses. Empfohlen vom Petit Futé."
    ],
    "en": [
      "On the road to Saint-Nectaire, comfortable, renovated rooms with soundproof glazing. Close to the main sites to visit. Park by the river. Recommended by Le Petit Futé."
    ],
    "it": [
      "Sulla strada per Saint-Nectaire, camere confortevoli, rinnovate con insonorizzazione. Vicino ai principali siti da visitare. Parco vicino al fiume. Raccomandato dal Petit Futé."
    ],
    "fr": [
      "Sur la route de Saint-Nectaire, chambres confortables, rénovées avec vitrage phonique. Proche des principaux sites à visiter. Parc au bord de la rivière. Recommandé par le Petit Futé."
    ],
    "nl": [
      "Op de weg naar Saint-Nectaire, comfortabele kamers, gerenoveerd met geluidsisolatie. Dicht bij de belangrijkste bezienswaardigheden. Parkeer bij de rivier. Aanbevolen door de Petit Futé."
    ],
    "es": [
      "En la carretera de Saint-Nectaire, habitaciones confortables, renovadas e insonorizadas. Cerca de los principales sitios para visitar. Aparca junto al río. Recomendado por el Petit Futé."
    ]
  },
