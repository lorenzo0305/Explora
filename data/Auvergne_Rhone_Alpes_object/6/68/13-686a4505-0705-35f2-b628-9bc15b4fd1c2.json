  "rdfs:comment": {
    "de": [
      "In den ehemaligen Stallungen des Schlosses von Villars gelegen, öffnet unser bistronomisches Restaurant \"L'Oliveraie\" seine Türen für Sie. Entdecken Sie unsere kreative Küche, in der alles hausgemacht und mit lokalen Produkten zubereitet wird."
    ],
    "en": [
      "Located in the former stables of the Château de Villars, our bistronomic restaurant \"L'Oliveraie\" opens its doors to you. Come and discover our creative cuisine, where everything is homemade with local produce."
    ],
    "it": [
      "Situato nelle ex scuderie del Castello di Villars, il nostro ristorante bistronomico \"L'Oliveraie\" vi apre le porte. Venite a scoprire la nostra cucina creativa, dove tutto è fatto in casa con prodotti locali."
    ],
    "fr": [
      "Situé dans les anciennes écuries du Château de Villars, notre restaurant bistronomique \"L'Oliveraie\" vous ouvre ses portes. Venez découvrir notre cuisine créative où tout est fait maison avec des produits locaux."
    ],
    "es": [
      "Situado en las antiguas caballerizas del Château de Villars, nuestro restaurante bistronómico \"L'Oliveraie\" le abre sus puertas. Venga a descubrir nuestra cocina creativa, donde todo se elabora en casa con productos locales."
    ],
    "nl": [
      "Gelegen in de voormalige stallen van het Château de Villars, opent ons bistronomisch restaurant \"L'Oliveraie\" zijn deuren voor u. Kom en ontdek onze creatieve keuken, waar alles huisgemaakt is met lokale producten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'Oliveraie"
    ]
  },
