  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Toskana der Auvergne einmal anders! Machen Sie sich mit einem Moped aus den 50er und 80er Jahren auf den Weg und entdecken Sie mit der Unbeschwertheit Ihrer 15 Jahre die einfachen Freuden der Ausflüge mit Freunden und Freundinnen wieder."
    ],
    "en": [
      "Discover the Tuscany of Auvergne in a whole new way! Take to the road on a moped from the 50s and 80s, and rediscover the carefree pleasures of riding with friends, just as you did when you were 15."
    ],
    "it": [
      "Scoprite la Toscana dell'Alvernia in un modo completamente nuovo! Percorrete la strada su un ciclomotore degli anni '50 e '80 e riscoprite i semplici piaceri della guida in compagnia, con lo spirito spensierato dei vostri 15 anni."
    ],
    "fr": [
      "Découvrez la Toscane auvergnate autrement ! Prenez la route avec une mobylette des années 50/80 et redécouvrez avec l’insouciance de vos 15 ans, les plaisirs simples des balades entre copains et copines."
    ],
    "es": [
      "¡Descubra la Toscana de Auvernia de una forma totalmente nueva! Salga a la carretera en un ciclomotor de los años 50 y 80 y redescubra los placeres sencillos de conducir con amigos, con el espíritu despreocupado de sus 15 años."
    ],
    "nl": [
      "Ontdek het Toscane van de Auvergne op een geheel nieuwe manier! Ga de weg op met een brommer uit de jaren 50 en 80 en herontdek het eenvoudige plezier van het rijden met vrienden, met de zorgeloze geest van je 15 jaar."
    ]
  },
