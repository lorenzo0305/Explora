  "rdfs:comment": {
    "de": [
      "Vollpension vom Anreisetag (inklusive Abendessen) bis zum Abreisetag (inklusive Frühstück). Wein zu den Mahlzeiten inbegriffen. Verpflegung in Form eines All-you-can-eat-Buffets. Thematische Abendessen und Bergmahlzeiten einmal pro Woche. Familienrestaurantbereich."
    ],
    "en": [
      "Full pension from the day of arrival - dinner included - till the day of departure, breakfast included. Wine for meals. Buffet. Thematic dinner and typical mountain meal once a week. Family zone in the restaurant."
    ],
    "it": [
      "Pensione completa dal giorno di arrivo (cena inclusa) al giorno di partenza (colazione inclusa). Vino ai pasti incluso. Buffet a volontà. Cene a tema e pasti di montagna una volta alla settimana. Area ristorante per famiglie."
    ],
    "fr": [
      "Pension complète du jour d'arrivée (diner inclus)  au jour de départ (petit déjeuner inclus). Vin aux repas compris. Restauration en buffet à volonté. Dîners thématiques et repas montagnard une fois par semaine. Espace restaurant famille."
    ],
    "nl": [
      "Volpension vanaf de dag van aankomst (diner inbegrepen) tot de dag van vertrek (ontbijt inbegrepen). Wijn bij de maaltijden inbegrepen. All-you-can-eat buffet. Themadiners en bergmaaltijden één keer per week. Familierestaurant."
    ],
    "es": [
      "Pensión completa desde el día de llegada (cena incluida) hasta el día de salida (desayuno incluido). Vino con las comidas incluido. Buffet libre. Cenas temáticas y comidas de montaña una vez a la semana. Zona de restaurante familiar."
    ]
  },
