  "rdfs:comment": {
    "de": [
      "Das Restaurant CHEZ BANOI empfängt Sie in einem gemütlichen Ambiente, um Ihnen eine abwechslungsreiche asiatische Küche anzubieten. Liebhaber des asiatischen Geschmacks kommen hier mit Gerichten der vietnamesischen, japanischen, thailändischen und koreanischen Küche auf ihre Kosten."
    ],
    "en": [
      "French restaurant with a warm welcome in all simplicity, copious and refined dishes. Come and taste their traditional frog's legs!"
    ],
    "it": [
      "Il ristorante CHEZ BANOI offre un'accoglienza calorosa e una vasta gamma di piatti asiatici. Gli amanti dei sapori asiatici saranno deliziati da piatti della cucina vietnamita, giapponese, tailandese e coreana."
    ],
    "fr": [
      "Le restaurant CHEZ BANOI vous accueille dans un lieu chaleureux afin de vous proposer une cuisine asiatique variée. Les amateurs de saveurs d’Asie y trouvent leur bonheur à travers des plats des cuisines vietnamienne, japonaise, thaïe et coréenne."
    ],
    "nl": [
      "Het restaurant CHEZ BANOI biedt een warm welkom en een breed scala aan Aziatische gerechten. Liefhebbers van Aziatische smaken kunnen hun hart ophalen met gerechten uit de Vietnamese, Japanse, Thaise en Koreaanse keuken."
    ],
    "es": [
      "El restaurante CHEZ BANOI ofrece una cálida bienvenida y una amplia gama de cocina asiática. Los amantes de los sabores asiáticos se deleitarán con platos de la cocina vietnamita, japonesa, tailandesa y coreana."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Chez Banoï - Wok & Sushi"
    ]
  },
