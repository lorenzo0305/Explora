  "rdfs:comment": {
    "de": [
      "Wir freuen uns darauf, Ihnen unsere traditionelle Küche mit frischen und hausgemachten Produkten in einer angenehmen Umgebung zu präsentieren. Service nur mittags. Möglichkeit der Privatisierung für alle Arten von Veranstaltungen."
    ],
    "en": [
      "We'll be delighted to introduce you to our traditional cuisine based on fresh, homemade ingredients in a pleasant setting. Lunchtime service only. Privatization available for all types of events."
    ],
    "it": [
      "Saremo lieti di presentarvi la nostra cucina tradizionale a base di prodotti freschi e fatti in casa in un ambiente piacevole. Servizio solo a pranzo. Possibilità di privatizzazione per tutti i tipi di eventi."
    ],
    "fr": [
      "Nous serons ravis de vous faire découvrir notre cuisine traditionnelle réalisé à base de produits frais et fait maison dans un cadre agréable. Service de midi uniquement. Possibilité de privatisation pour tout types d'événements."
    ],
    "nl": [
      "We laten je graag onze traditionele keuken zien op basis van verse, zelfgemaakte producten in een aangename omgeving. Alleen lunchservice. Mogelijkheid tot privatisering voor alle soorten evenementen."
    ],
    "es": [
      "Estaremos encantados de mostrarle nuestra cocina tradicional basada en productos frescos y caseros en un entorno agradable. Servicio sólo a mediodía. Posibilidad de privatización para todo tipo de eventos."
    ]
  },
