  "rdfs:comment": {
    "de": [
      "Dieses Familienrestaurant empfängt Sie in einem freundlichen und herzlichen Rahmen, um Ihnen eine traditionelle, hausgemachte Küche zu servieren. Im Zentrum von Uriage, entlang der Geschäftsallee, genießen Sie die Terrasse mit Blick auf den Thermalpark."
    ],
    "en": [
      "This restaurant, a family business, welcomes you in a warm and friendly atmosphere to enjoy traditional, home-cooked cuisine. In the center of Uriage, along the shopping alley, enjoy its terrace overlooking the spa park."
    ],
    "it": [
      "Questo ristorante a conduzione familiare offre un'accoglienza calorosa e amichevole e una cucina tradizionale e casalinga. Nel centro di Uriage, lungo la via dello shopping, la sua terrazza si affaccia sul parco termale."
    ],
    "fr": [
      "Ce restaurant familial vous accueille dans un cadre convivial et chaleureux pour vous faire profiter d’une cuisine traditionnelle faite maison. Au centre d'Uriage, le long de l'allée commerçante, profitez de sa terrasse avec vue sur le parc thermal."
    ],
    "es": [
      "Este restaurante familiar ofrece una cálida acogida y una cocina tradicional y casera. En el centro de Uriage, junto a la calle comercial, disfrute de su terraza con vistas al parque del balneario."
    ],
    "nl": [
      "Dit familierestaurant biedt een warm, vriendelijk welkom en traditionele, huisgemaakte gerechten. Geniet van het terras in het centrum van Uriage, aan de winkelstraat, met uitzicht op het kuurpark."
    ]
  },
