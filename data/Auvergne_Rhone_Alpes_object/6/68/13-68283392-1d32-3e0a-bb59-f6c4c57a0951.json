  "rdfs:comment": {
    "de": [
      "Nicht weit vom grünen Tal der Bouble entfernt, führt diese Wanderung\r\nwanderung um Monestier verbindet die Staatswälder von Giverzat und Monestier und bietet unterwegs weite Ausblicke."
    ],
    "en": [
      "Not far from the verdant Bouble valley, this walk around Monestier\r\naround Monestier links the state-owned forests of Giverzat and Monestier, offering broad views along the way."
    ],
    "it": [
      "Non lontano dalla verdeggiante valle del Bouble, questa passeggiata intorno a Monestier\r\nquesta passeggiata intorno a Monestier collega le foreste demaniali di Giverzat e Monestier e offre ampie vedute lungo il percorso."
    ],
    "fr": [
      "Non loin du vallon verdoyant de la Bouble, cette\r\nbalade autour de Monestier relie les forêts domaniales de Giverzat et de Monestier et offre, en chemin, de larges perspectives."
    ],
    "es": [
      "No muy lejos del verde valle del Bouble, este paseo por Monestier\r\neste paseo alrededor de Monestier une los bosques estatales de Giverzat y Monestier y ofrece amplias vistas a lo largo del camino."
    ],
    "nl": [
      "Niet ver van de groene Bouble-vallei ligt deze wandeling rond Monestier\r\ndeze wandeling rond Monestier verbindt de staatsbossen van Giverzat en Monestier en biedt onderweg weidse uitzichten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les bois de Monestier - 11 km"
    ]
  },
