  "rdfs:comment": {
    "de": [
      "Die Auberge de Lucinges,\r\nGourmet-Tisch, ein Stern im Guide Michelin, empfängt Sie von Donnerstagabend bis Samstagabend und am Sonntagmittag."
    ],
    "en": [
      "The Auberge de Lucinges,\r\nGastronomic restaurant, one star in the Michelin Guide, welcomes you from Thursday evening to Saturday evening and Sunday lunchtime."
    ],
    "it": [
      "L'Auberge de Lucinges,\r\nRistorante gastronomico, una stella della Guida Michelin, vi accoglie dal giovedì sera al sabato sera e la domenica a pranzo."
    ],
    "fr": [
      "L'auberge de Lucinges, \r\nTable gastronomique, une étoile au Guide Michelin,  vous accueille du Jeudi Soir au Samedi Soir et le Dimanche midi"
    ],
    "es": [
      "El Auberge de Lucinges,\r\nRestaurante gastronómico, una estrella en la Guía Michelin, le da la bienvenida del jueves por la noche al sábado por la noche y el domingo al mediodía."
    ],
    "nl": [
      "De Auberge de Lucinges,\r\nGastronomisch restaurant, één ster in de Michelingids, verwelkomt je van donderdagavond tot zaterdagavond en zondagmiddag"
    ]
  },
