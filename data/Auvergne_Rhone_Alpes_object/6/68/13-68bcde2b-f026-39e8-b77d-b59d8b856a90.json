  "rdfs:comment": {
    "de": [
      "In Paillettes lädt der geschiedene Fred seinen Freund Hugo zu Weihnachten zu sich ein, sehr zum Missfallen von Hugos Frau Corine. Die Ankunft von Nadia, der Nachbarin, beschleunigt einen Abend voller Spannungen, Enthüllungen und Missverständnisse. Eine explosive und menschliche Komödie."
    ],
    "en": [
      "In Paillettes, divorced Fred invites himself to his friend Hugo?s house for Christmas, much to the annoyance of Hugo?s wife Corine. The arrival of neighbor Nadia precipitates an evening of tension, revelations and misunderstandings. An explosive, human comedy."
    ],
    "it": [
      "In Paillettes, Fred, divorziato, si autoinvita a casa dell'amico Hugo per Natale, con grande disappunto della moglie Corine. L'arrivo di Nadia, la vicina di casa, fa precipitare una serata piena di tensioni, rivelazioni ed equivoci. Una commedia esplosiva e umana."
    ],
    "fr": [
      "Dans Paillettes, Fred, divorcé, s’invite chez son ami Hugo pour Noël, au grand dam de Corine, l’épouse d’Hugo. L’arrivée de Nadia, la voisine, précipite une soirée pleine de tensions, révélations et malentendus. Une comédie explosive et humaine."
    ],
    "nl": [
      "In Paillettes nodigt de gescheiden Fred zijn vriend Hugo uit voor Kerstmis, tot grote ergernis van Hugo's vrouw Corine. De komst van Nadia, de buurvrouw, zorgt voor een avond vol spanning, onthullingen en misverstanden. Een explosieve, menselijke komedie."
    ],
    "es": [
      "En Paillettes, Fred, divorciado, se invita a pasar las Navidades en casa de su amigo Hugo, para disgusto de Corine, la mujer de éste. La llegada de Nadia, la vecina, precipita una velada llena de tensión, revelaciones y malentendidos. Una comedia explosiva y humana."
    ]
  },
  "rdfs:label": {
    "fr": [
