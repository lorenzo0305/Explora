  "rdfs:comment": {
    "de": [
      "Die Villa du Prieuré, die von ihren prächtigen Gärten umgeben ist, verfügt über mehrere Räume, die gemietet werden können, darunter der Magnolia-Saal im Erdgeschoss, und bietet einen idyllischen Rahmen für erfolgreiche und unvergessliche Veranstaltungen!"
    ],
    "en": [
      "The Villa du Prieuré, surrounded by its sumptuous gardens, has several rooms available for hire, including the Salle Magnolia on the ground floor, and offers an idyllic setting for successful and unforgettable events!"
    ],
    "it": [
      "La Villa du Prieuré, circondata dai suoi sontuosi giardini, dispone di diverse sale disponibili per il noleggio, tra cui la Salle Magnolia al piano terra, e offre una cornice idilliaca per eventi di successo e indimenticabili!"
    ],
    "fr": [
      "La Villa du Prieuré, entourée par ses somptueux Jardins, dispose de plusieurs salles disponibles à la location, dont la Salle Magnolia au rez-de-chaussée, et offre un cadre idyllique que pour des événements réussis et inoubliables !"
    ],
    "es": [
      "La Villa du Prieuré, rodeada de suntuosos jardines, dispone de varias salas de alquiler, entre ellas la Sala Magnolia en la planta baja, y ofrece un marco idílico para celebrar eventos inolvidables"
    ],
    "nl": [
      "De Villa du Prieuré, omringd door prachtige tuinen, heeft verschillende zalen te huur, waaronder de Salle Magnolia op de begane grond, en biedt een idyllische omgeving voor succesvolle en onvergetelijke evenementen!"
    ]
  },
