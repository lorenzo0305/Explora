  "rdfs:comment": {
    "de": [
      "Die Resto'Bar le TranKilou empfängt Sie jeden Abend von Montag bis Freitag mit einem abwechslungsreichen Programm an zwei Abenden pro Woche: Aufführungen, Theater, DJs, Konzerte, Vorträge, Vernissagen."
    ],
    "en": [
      "The Resto'Bar le TranKilou welcomes you every evening from Monday to Friday, with a varied program of shows, theater, DJs, concerts, conferences and art openings on about 2 evenings a week."
    ],
    "it": [
      "Il TranKilou Resto'Bar vi accoglie tutte le sere dal lunedì al venerdì, con un programma vario di spettacoli, teatro, DJ, concerti, conferenze e inaugurazioni di mostre circa 2 sere a settimana."
    ],
    "fr": [
      "Le Resto'Bar le TranKilou vous accueille tous les soirs du lundi au vendredi avec une programmation variée sur environ 2 soirées par semaines: spectacles, théâtres, DJ, concerts, conférences, vernissages."
    ],
    "es": [
      "El TranKilou Resto'Bar le da la bienvenida todas las noches de lunes a viernes, con una variada programación de espectáculos, teatro, DJs, conciertos, conferencias e inauguraciones de exposiciones unas 2 noches por semana."
    ],
    "nl": [
      "De TranKilou Resto'Bar verwelkomt je elke avond van maandag tot vrijdag, met een gevarieerd programma van shows, theater, dj's, concerten, conferenties en openingen van tentoonstellingen op ongeveer 2 avonden per week."
    ]
  },
