  "rdfs:comment": {
    "de": [
      "Jeden Mittag ein anderes Tagesgericht und am Wochenende Gericht à la carte, Themenabende jeden Monat und ein Raum, der für jede Veranstaltung zur Verfügung steht."
    ],
    "en": [
      "Every lunchtime a different dish of the day and on weekends a la carte, theme evenings every month, and room available for any event."
    ],
    "it": [
      "Ogni pranzo un piatto del giorno diverso e nel fine settimana un menu à la carte, serate a tema ogni mese e una sala a disposizione per qualsiasi evento."
    ],
    "fr": [
      "Tous les midis un plat du jour différent et le week end plat à la carte, soirées à thème tous les mois, et salle à disposition pour tout événement."
    ],
    "nl": [
      "Elke middag een andere dagschotel en in het weekend een à la carte menu, elke maand thema-avonden en een zaal voor elk evenement."
    ],
    "es": [
      "Cada mediodía un plato diferente del día y los fines de semana un menú a la carta, noches temáticas cada mes y una sala disponible para cualquier evento."
    ]
  },
  "rdfs:label": {
