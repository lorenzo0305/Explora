  "rdfs:comment": {
    "de": [
      "Private Ausflüge mit einem Lotsen als Reiseführer in einem Lounge-Boot zur Erkundung des Lac d'Annecy. Gestalten Sie Ihre private Tour ganz nach Ihren Wünschen mit Optionen für Aperitifs, Mahlzeiten, Routen und Programme."
    ],
    "en": [
      "Private excursions with a pilot guide on a lounge boat to discover Lake Annecy. Customise your private trip with aperitif options, meals, itineraries and programmes according to your wishes."
    ],
    "it": [
      "Escursioni private con una guida pilota su una lounge boat per scoprire il lago di Annecy. Personalizzate il vostro tour privato con opzioni per aperitivi, pasti, itinerari e programmi su misura per voi."
    ],
    "fr": [
      "Excursions privatives avec pilote guide en bateau lounge boat à la découverte du lac d'Annecy. Personnalisez votre balade privatisée avec des options apéritives, repas, itinéraires et programmes selon vos envies."
    ],
    "nl": [
      "Privé-excursies met een gids op een loungeboot om het meer van Annecy te ontdekken. Personaliseer je privétour met aperitiefopties, maaltijden, routes en programma's die bij jou passen."
    ],
    "es": [
      "Excursiones privadas con un guía piloto en un barco salón para descubrir el lago de Annecy. Personalice su excursión privada con opciones de aperitivo, comidas, itinerarios y programas a su medida."
    ]
  },
