  "rdfs:comment": {
    "de": [
      "Dieser schöne Anstieg ermöglicht es Ihnen, Saint-Jean-de-Maurienne mit La Toussuire über Le Corbier auf einer rollenden, wilden, verflochtenen und panoramareichen Piste zu verbinden!"
    ],
    "en": [
      "This beautiful ascent will take you from Saint-Jean-de-Maurienne to La Toussuire via Le Corbier on a rolling, wild, interlaced and panoramic trail!"
    ],
    "it": [
      "Questa bella salita vi porterà da Saint-Jean-de-Maurienne a La Toussuire passando per Le Corbier su un percorso ondulato, selvaggio, intrecciato e panoramico!"
    ],
    "fr": [
      "Cette belle ascension vous permettra de relier Saint-Jean-de-Maurienne à la Toussuire en passant par le Corbier sur une piste roulante, sauvage, entrelacée et panoramique !"
    ],
    "es": [
      "Esta hermosa ascensión le llevará de Saint-Jean-de-Maurienne a La Toussuire pasando por Le Corbier por una pista ondulada, salvaje, entrelazada y panorámica"
    ],
    "nl": [
      "Deze prachtige beklimming brengt je van Saint-Jean-de-Maurienne naar La Toussuire via Le Corbier over een glooiend, wild, doorweven en panoramisch parcours!"
    ]
  },
  "rdfs:label": {
    "en": [
      "Ascent of La Toussuire and Le Corbier"
    ],
    "fr": [
      "Montée de la Toussuire et du Corbier"
    ],
    "nl": [
      "Beklimming van La Toussuire en Le Corbier"
    ]
  },
