  "rdfs:comment": {
    "de": [
      "Das Zugangsrecht zum Angeln ist den Mitgliedern der Association de Pêche Nérondoise (Einwohner und Paten) vorbehalten. Der Teich ist für Spaziergänge für alle zugänglich. Baden ist nicht erlaubt. Karte für die ganze Saison. Keine Tageskarte."
    ],
    "en": [
      "Fishing access reserved for members of the Nerondoise Fishing Association (residents and sponsored members). The pond is open to all for walking. Swimming prohibited. Season pass. No day pass."
    ],
    "it": [
      "I diritti di pesca sono riservati ai membri dell'Associazione di pesca Nerondoise (residenti e soci sostenitori). Lo stagno è aperto a tutti per le passeggiate. È vietato nuotare. Abbonamento stagionale. Nessuna tessera giornaliera."
    ],
    "fr": [
      "Droit d’accès pour pêcher réservé aux adhérents de l'Association de Pêche nérondoise (habitants et parrainés). L'étang est accessible à tous pour la balade. Baignade interdite. Carte saison. Pas de carte à la journée."
    ],
    "nl": [
      "Visrechten voorbehouden aan leden van de Nerondoise Fishing Association (bewoners en gesponsorde leden). De vijver is voor iedereen toegankelijk voor wandelingen. Zwemmen verboden. Seizoenkaart. Geen dagkaart."
    ],
    "es": [
      "Derecho de pesca reservado a los miembros de la Asociación de Pesca de Nerondoise (residentes y socios patrocinados). El estanque está abierto a todos para pasear. Prohibido bañarse. Abono de temporada. No hay pase de día."
    ]
  },
