  "rdfs:comment": {
    "de": [
      "Wagen Sie einen Outdoor-Urlaub mit Alpe Sports Loisirs!\r\nUnser Ziel ist es, Ihnen die Oisans zu zeigen, wie Sie sie noch nie zuvor gesehen haben! Paragliding, Klettersteige, Canyoning, Rafting und vieles mehr! Schaffen Sie sich unvergessliche Erinnerungen!"
    ],
    "en": [
      "Dare your outdoor holidays with Alpe Sports Loisirs!\r\nOur goal: to make you discover the Oisans as you've never seen it before! Paragliding, via ferrata, canyoning, rafting, and more! Come and forge unforgettable memories!"
    ],
    "it": [
      "Osate le vostre vacanze all'aria aperta con Alpe Sports Loisirs!\r\nIl nostro obiettivo: farvi scoprire l'Oisans come non l'avete mai visto prima! Parapendio, via ferrata, canyoning, rafting e altro ancora! Venite a creare ricordi indimenticabili!"
    ],
    "fr": [
      "Osez vos vacances plein-air avec Alpe Sports Loisirs!\r\nNotre but: vous faire découvrir l'Oisans comme vous ne l'avez jamais vu! Parapente, via ferrata, canyoning, rafting, et plus encore! Venez vous forger des souvenirs inoubliables!"
    ],
    "es": [
      "¡Atrévase con sus vacaciones al aire libre con Alpe Sports Loisirs!\r\nNuestro objetivo: ¡hacerle descubrir el Oisans como nunca antes lo había visto! Parapente, vía ferrata, barranquismo, rafting y mucho más Venga y cree recuerdos inolvidables"
    ],
    "nl": [
      "Durf een openlucht vakantie met Alpe Sports Loisirs !\r\nOns doel : u het Oisans gebied laten ontdekken op een nieuwe manier !\r\nParagliding, Via Ferrata, canyoning, rafting en nog meer ! Kom onvergetelijke herinneringen maken !!"
    ]
  },
