  "rdfs:comment": {
    "de": [
      "Im Chez Bleu Charrette können Sie den Reichtum unserer Region (wieder)entdecken, der mit Liebe und Großzügigkeit zubereitet wird! Wir bieten eine Feinschmeckerküche ohne Chichi, mittags ein Marktmenü und abends kleine Gerichte zum Teilen."
    ],
    "en": [
      "At Bleu Charrette, come and (re)discover the riches of our land, cooked with love and generosity! We offer a gourmet cuisine, without fuss, declined in a market menu at noon and in small dishes to share in the evening."
    ],
    "it": [
      "A Bleu Charrette, venite a (ri)scoprire le ricchezze della nostra terra, cucinate con amore e generosità! Offriamo una cucina gourmet, senza fronzoli, disponibile in un menu di mercato a pranzo e in piccoli piatti da condividere la sera."
    ],
    "fr": [
      "Chez Bleu Charrette, venez (re)découvrir les richesses de notre terroir, cuisinées avec amour et générosité ! Nous proposons une cuisine gourmande, sans chichi, déclinée en un menu du marché le midi et en petits plats à partager le soir."
    ],
    "nl": [
      "Kom bij Bleu Charrette de rijkdommen van ons land (her)ontdekken, gekookt met liefde en vrijgevigheid! Wij bieden een gastronomische keuken, zonder poespas, beschikbaar in een marktmenu 's middags en in kleine gerechten om te delen 's avonds."
    ],
    "es": [
      "En Bleu Charrette, venga a (re)descubrir las riquezas de nuestra tierra, cocinadas con amor y generosidad Ofrecemos una cocina gourmet, sin aspavientos, disponible en un menú de mercado al mediodía y en pequeños platos para compartir por la noche."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant Bleu Charrette"
    ]
  },
