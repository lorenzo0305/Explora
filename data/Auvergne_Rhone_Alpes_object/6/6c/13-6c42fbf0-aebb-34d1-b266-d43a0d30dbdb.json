  "rdfs:comment": {
    "de": [
      "Genießen Sie ein modernes Restaurant mit einer saisonalen Küche aus frischen und lokalen Produkten. Ideal für ein Geschäftsessen oder ein Abendessen mit der Familie in einer warmen und freundlichen Atmosphäre."
    ],
    "en": [
      "Alone, with family or friends for your holidays or a short stay, come and taste the traditional cuisine of the restaurant le Saint Hubert. The restaurant offers a generous, regional cuisine in a warm and friendly setting."
    ],
    "it": [
      "Godetevi un ristorante moderno che serve una cucina stagionale a base di prodotti freschi e locali. Ideale per un pranzo di lavoro o una cena in famiglia in un'atmosfera calda e accogliente."
    ],
    "fr": [
      "Profitez d'un restaurant moderne proposant une cuisine de saison à base de produits frais et locaux. Idéal pour un déjeuner d'affaires ou un dîner en famille dans une ambiance chaleureuse et conviviale."
    ],
    "nl": [
      "Geniet van een modern restaurant dat seizoensgebonden gerechten serveert op basis van verse, lokale producten. Ideaal voor een zakenlunch of een familiediner in een warme en vriendelijke sfeer."
    ],
    "es": [
      "Disfrute de un restaurante moderno que sirve cocina de temporada basada en productos locales frescos. Ideal para un almuerzo de negocios o una cena familiar en un ambiente cálido y acogedor."
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'Instant Présent"
    ]
  },
