  "rdfs:comment": {
    "de": [
      "Produzentin von kultivierten oder wilden Heilpflanzen, biodynamisch (ohne jegliche Chemikalien, ohne Bodenbearbeitung, ohne Mechanisierung, unter Wahrung der Artenvielfalt). Auf einem 2,5 ha großen Grundstück sammle ich wilde Pflanzen und baue sie auch an."
    ],
    "en": [
      "Grower of cultivated and wild medicinal plants, biodynamically (no chemicals, no tillage, no mechanization, preserving biodiversity). On a 2.5-hectare plot, I pick wild plants and grow my own."
    ],
    "it": [
      "Coltivo piante medicinali selvatiche e coltivate con metodi biodinamici (senza prodotti chimici, senza lavorazione del terreno, senza meccanizzazione, preservando la biodiversità). Su 2,5 ettari di terreno, raccolgo e coltivo piante selvatiche."
    ],
    "fr": [
      "Productrice de plantes médicinales cultivées ou sauvages, en biodynamie (sans aucun produit chimique, sans travail du sol, sans mécanisation, en préservant la biodiversité). Sur un terrain de 2,5 ha, je cueille des plantes sauvages et en cultive aussi."
    ],
    "nl": [
      "Ik kweek wilde en gecultiveerde medicinale planten volgens biodynamische methodes (geen chemicaliën, geen grondbewerking, geen mechanisatie, behoud van biodiversiteit). Op 2,5 hectare land pluk en kweek ik wilde planten."
    ],
    "es": [
      "Cultivo plantas medicinales silvestres y cultivadas con métodos biodinámicos (sin productos químicos, sin labranza, sin mecanización, preservando la biodiversidad). En 2,5 hectáreas de terreno, recolecto y cultivo plantas silvestres."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le jardin de Ma Vie O l’Être"
    ]
  },
