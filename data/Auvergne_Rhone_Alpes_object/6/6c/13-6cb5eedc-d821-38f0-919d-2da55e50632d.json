  "rdfs:comment": {
    "de": [
      "Das Restaurant L'Amarante bietet eine breite saisonale Speisekarte, verfügt über eine Bar und einen Speisesaal, in dem etwa 50 Personen Platz finden."
    ],
    "en": [
      "The restaurant L'Amarante offers a broad seasonal menu, has a bar and a dining room that can accommodate fifty places."
    ],
    "it": [
      "Il ristorante L'Amarante offre un ampio menù stagionale, un bar e una sala ristorante che può ospitare circa 50 persone."
    ],
    "fr": [
      "Le restaurant L'Amarante propose une large carte de saison, dispose d'un bar et une salle de restaurant pouvant accueillir une cinquantaine de places."
    ],
    "nl": [
      "Het restaurant L'Amarante biedt een uitgebreid seizoensmenu, een bar en een eetzaal die plaats biedt aan ongeveer vijftig mensen."
    ],
    "es": [
      "El restaurante L'Amarante ofrece un amplio menú de temporada, un bar y una sala de restauración con capacidad para unas 50 personas."
