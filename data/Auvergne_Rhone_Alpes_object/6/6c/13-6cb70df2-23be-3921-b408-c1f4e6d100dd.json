  "rdfs:comment": {
    "de": [
      "Das Schloss Jonchères war der Sitz einer Baronie des Velay. Sie war eine der 18 diözesanen Baronien, die ihrem Herrn bis zur Revolution das Recht verliehen, in den Ständen des Velay zu sitzen."
    ],
    "en": [
      "Château de Jonchères was the seat of a Velay barony, one of 18 diocesan baronies that gave their lord the right to sit in the States of Velay until the Revolution."
    ],
    "it": [
      "Il castello di Jonchères era la sede di una baronia della regione del Velay, una delle 18 baronie diocesane che davano al loro signore il diritto di sedere negli Stati del Velay fino alla Rivoluzione."
    ],
    "fr": [
      "Le château de Jonchères fut le siège d'une baronnie du Velay, elle fut l'une des 18 baronnies diocésaines qui donnaient à leur seigneur le droit de siéger aux États du Velay jusqu'à la Révolution."
    ],
    "es": [
      "El castillo de Jonchères era la sede de una baronía de la región de Velay, una de las 18 baronías diocesanas que otorgaban a su señor el derecho a sentarse en los Estados de Velay hasta la Revolución."
    ],
    "nl": [
      "Château de Jonchères was de zetel van een baronie van Velay, een van de 18 diocesane baronieën die hun heer het recht gaven om tot de Revolutie zitting te nemen in de Staten van Velay."
    ]
  },
