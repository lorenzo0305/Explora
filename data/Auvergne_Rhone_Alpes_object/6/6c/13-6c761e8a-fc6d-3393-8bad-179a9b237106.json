  "rdfs:comment": {
    "de": [
      "Am oberen Rand der blauen Piste von Chalet-Neuf, die vom gleichnamigen Skilift bedient wird, wird ein spielerischer Boarder gezogen. Lassen Sie sich von den Sensationen berauschen."
    ],
    "en": [
      "You'll find a new boarder cross at the top of the Chalet-Neuf blue ski slope, served by the ski lift of the same name, so let yourself be carried away by the sensations."
    ],
    "it": [
      "Un fun boarder è segnalato sul bordo della parte superiore della pista blu dello Chalet-Neuf, servita dall'omonimo skilift, quindi lasciatevi trasportare dalle sensazioni."
    ],
    "fr": [
      "Un boarder ludique est tracé sur le bord de la partie supérieure de la piste bleue de Chalet-Neuf, desservie par le téléski du même nom, laissez-vous griser par les sensations."
    ],
    "es": [
      "En el borde de la parte superior de la pista azul de Chalet-Neuf, servida por el remonte del mismo nombre, se ha marcado un fun boarder, así que déjese llevar por las sensaciones."
    ],
    "nl": [
      "Aan de rand van het bovenste deel van de blauwe piste Chalet-Neuf, die wordt bediend door de gelijknamige skilift, is een nieuwe boarder cross uitgezet, dus laat u meevoeren door de sensaties."
    ]
  },
  "rdfs:label": {
    "en": [
      "Boarder cross"
    ],
    "fr": [
      "Boarder ludique"
    ],
    "nl": [
      "Boarder cross"
    ]
  },
