  "rdfs:comment": {
    "de": [
      "Das Gebäude steht unter Denkmalschutz. Die Wandmalereien stammen aus dem Jahr 1896 und die Holzvertäfelung und die Vorderseiten aus dem Jahr 1856."
    ],
    "en": [
      "The building is listed as a historic monument, with murals dating from 1896 and wood panelling and fronts dating from 1856."
    ],
    "it": [
      "L'edificio è classificato come monumento, con pitture murali del 1896, falegnameria e facciate dei negozi del 1856."
    ],
    "fr": [
      "Etablissement classé au monument historique peintures murales datant de 1896 et boiseries et devantures datant de1856 ."
    ],
    "nl": [
      "Het gebouw staat op de monumentenlijst met muurschilderingen uit 1896 en houtwerk en winkelpuien uit 1856."
    ],
    "es": [
      "El edificio está catalogado con pinturas murales que datan de 1896 y con carpintería y fachadas de tiendas que datan de 1856."
    ]
