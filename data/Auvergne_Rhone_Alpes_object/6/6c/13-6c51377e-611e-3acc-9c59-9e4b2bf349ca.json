  "rdfs:comment": {
    "de": [
      "Die Boutique des ländlichen Familienhauses in Saint-Léopardin-d?Augy wurde im Rahmen der 2020 eingeführten Ausbildung zum \"bac professionnel technicien conseil vente en alimentation et boissons\" eingerichtet."
    ],
    "en": [
      "The store at the Saint-Léopardin-d?Augy Maison Familiale Rurale was created as part of the vocational baccalaureate in food and beverage sales, which was introduced in 2020."
    ],
    "it": [
      "Il negozio presso la Maison Familiale Rurale di Saint-Léopardin-d'Augy è stato realizzato nell'ambito del diploma di maturità professionale in vendita di alimenti e bevande, introdotto nel 2020."
    ],
    "fr": [
      "La boutique de la maison familiale rurale de Saint-Léopardin-d’Augy a été créée dans le cadre de la formation bac professionnel technicien conseil vente en alimentation et boissons qui a été mis en place en 2020."
    ],
    "es": [
      "La tienda de la Maison Familiale Rurale de Saint-Léopardin-d'Augy se creó en el marco del bachillerato profesional en venta de alimentos y bebidas, que se implantó en 2020."
    ],
    "nl": [
      "De winkel in het Maison Familiale Rurale in Saint-Léopardin-d?Augy werd opgezet in het kader van het beroepsbaccalaureaat in de verkoop van voedingsmiddelen en dranken, dat in 2020 werd ingevoerd."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Boutique école \" AiMer FaiRe \""
    ]
  },
