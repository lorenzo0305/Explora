  "rdfs:comment": {
    "de": [
      "Schnellrestaurants vor Ort oder zum Mitnehmen.\r\nZubereitung und Verkauf von Fertiggerichten, Sandwiches, Salaten, Snacks (süß und salzig) und die Spezialität: Butterbrote!\r\nWechselndes Tagesgericht jeden Mittag!"
    ],
    "en": [
      "Fast food on the spot or to take away.\r\nPreparation and sale of prepared meals, sandwiches, salads, snacks (sweet and savoury) and the speciality: sandwiches!\r\nDish of the day, which changes every lunchtime!"
    ],
    "it": [
      "Fast food sul posto o da asporto.\r\nPreparazione e vendita di piatti pronti, panini, insalate, snack (dolci e salati) e la specialità: i panini!\r\nPiatto del giorno, che cambia ad ogni pranzo!"
    ],
    "fr": [
      "Restauration rapide sur place ou à emporter.\r\nPréparation et vente de plats préparés, sandwichs, salades, snack (sucré et salé) et la spécialité : les tartines !\r\nPlat du jour, qui change, tous les midis !"
    ],
    "nl": [
      "Fast food ter plaatse of om mee te nemen.\r\nBereiding en verkoop van kant-en-klare maaltijden, broodjes, salades, snacks (zoet en hartig) en de specialiteit: broodjes!\r\nSchotel van de dag, die elke middag wisselt!"
    ],
    "es": [
      "Comida rápida en el lugar o para llevar.\r\nPreparación y venta de platos preparados, sándwiches, ensaladas, aperitivos (dulces y salados) y la especialidad: ¡sándwiches!\r\nPlato del día, ¡que cambia cada mediodía!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'Encas - Chez Marie"
    ]
  },
