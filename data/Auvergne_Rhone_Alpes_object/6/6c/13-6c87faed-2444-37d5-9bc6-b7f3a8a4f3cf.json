  "rdfs:comment": {
    "de": [
      "Der Küchenchef serviert eine große Auswahl an Pizzen sowie Spezialitäten, wie zum Beispiel Fondue à la Fourme, frittierte Speisen, Riesenburger."
    ],
    "en": [
      "The chef offers a variety of menus based on local produits as well as traditional dishes (frying, frogs...). You can also choose the plates (fondue à la Fourme). \r\nWorkers' menu at lunchtime during the week."
    ],
    "it": [
      "Lo chef propone un menu del giorno con prodotti freschi e piatti che hanno il sapore di casa"
    ],
    "fr": [
      "Le chef vous propose sa formule menu du jour avec des produits frais et des plats bons comme à la maison"
    ],
    "es": [
      "El chef ofrece un menú del día con productos frescos y platos que saben como en casa"
    ],
    "nl": [
      "De chef biedt een dagmenu met verse producten en gerechten die smaken als thuis"
    ]
  },
