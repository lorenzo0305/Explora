  "rdfs:comment": {
    "de": [
      "Das Anwesen wurde 1982 in einen öffentlichen Park umgewandelt und erhielt 2001 eine umfassende Landschaftsgestaltung. Der Park verfügt über Spielmöglichkeiten für Kinder und einen Sportplatz."
    ],
    "en": [
      "The estate was transformed into a public park in 1982 and was fully landscaped in 2001. The park has games for children as well as a sports field."
    ],
    "it": [
      "La tenuta è stata trasformata in un parco pubblico nel 1982 ed è stata completamente sistemata nel 2001. Il parco dispone di aree gioco per bambini e di un campo sportivo."
    ],
    "fr": [
      "Le domaine est transformé en parc public en 1982 et bénéficie d'un aménagement paysager complet en 2001. Le parc possède des jeux pour les enfants de même qu'un terrain de sport."
    ],
    "es": [
      "La finca se transformó en un parque público en 1982 y se ajardinó por completo en 2001. El parque cuenta con zonas de juego para los niños, así como con un campo de deportes."
    ],
    "nl": [
      "Het landgoed werd in 1982 omgevormd tot een openbaar park en werd in 2001 volledig aangelegd. Het park heeft speelplaatsen voor kinderen en een sportveld."
    ]
  },
