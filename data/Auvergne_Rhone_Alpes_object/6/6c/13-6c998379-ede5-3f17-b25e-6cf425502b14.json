  "rdfs:comment": {
    "de": [
      "Das Gasthaus Les Plantades bietet Ihnen regionale Produkte. Wir laden Sie ein, unsere Spezialitäten aus der Ardèche zu entdecken. Herzlicher und familiärer Empfang."
    ],
    "en": [
      "The Auberge Les Plantades offers local produce. We invite you to come and discover our Ardèche specialties. A warm, friendly welcome awaits."
    ],
    "it": [
      "L'auberge les plantades vi offre prodotti locali. Vi invitiamo a venire a scoprire le nostre specialità dell'Ardèche. Un caloroso benvenuto in famiglia."
    ],
    "fr": [
      "L'auberge les plantades, vous propose des produits du terroir. Nous, vous invitons à venir découvrir nos spécialités Ardéchoises. Accueil chaleureux et familial."
    ],
    "es": [
      "L'auberge les plantades le ofrece productos locales. Le invitamos a descubrir nuestras especialidades de Ardèche. Una cálida bienvenida familiar."
    ],
    "nl": [
      "De Auberge Les Plantades biedt lokale producten. Wij nodigen u uit om onze Ardèche-specialiteiten te komen ontdekken. Warm en familiaal welkom."
    ]
  },
