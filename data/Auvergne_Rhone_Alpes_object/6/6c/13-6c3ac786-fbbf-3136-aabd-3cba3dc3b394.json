  "rdfs:comment": {
    "de": [
      "Entdecken Sie diese unumgängliche Adresse, wo man Ihnen die Geschmäcker Asiens in einer hausgemachten Küche mit frischen Produkten näherbringt. Spezialitäten: vietnamesisches Fondue, Phô-Suppe, Bo-Bun und Nems."
    ],
    "en": [
      "Discover this not-to-be-missed address where you can discover the flavors of Asia in a homemade cuisine based on fresh produce. Specialities: Vietnamese fondue, Phô soup, Bo-Bun and Nems."
    ],
    "it": [
      "Scoprite questo indirizzo imperdibile dove potrete scoprire i sapori dell'Asia in una cucina casalinga a base di prodotti freschi. Specialità: fonduta vietnamita, zuppa Phô, Bo-Bun e Nems."
    ],
    "fr": [
      "Découvrez cette adresse incontournable où l'on vous fait découvrir les saveurs d'Asie dans une cuisine faite maison à base de produits frais. Spécialités : fondue vietnamienne, soupe Phô, Bo-Bun et Nems."
    ],
    "nl": [
      "Ontdek dit niet te missen adres waar je de smaken van Azië kunt ontdekken in huisgemaakte gerechten op basis van verse producten. Specialiteiten: Vietnamese fondue, Phô-soep, Bo-Bun en Nems."
    ],
    "es": [
      "Descubra esta dirección ineludible donde podrá descubrir los sabores de Asia en una cocina casera basada en productos frescos. Especialidades: fondue vietnamita, sopa Phô, Bo-Bun y Nems."
    ]
  },
  "rdfs:label": {
