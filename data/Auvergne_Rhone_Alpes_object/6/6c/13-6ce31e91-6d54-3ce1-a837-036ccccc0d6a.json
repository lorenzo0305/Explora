  "rdfs:comment": {
    "de": [
      "Wählen Sie Ihre Fahrradverleihformel: Citybike, VTC, Gravel, Rennrad oder Mountainbike, halber Tag, ganzer Tag, mehrere Tage, mit oder ohne Zubehör. Buchen Sie im Internet und holen Sie Ihr Fahrrad in Vallon Pont d'Arc ab. Lieferung unter Bedingungen"
    ],
    "en": [
      "Choose your bike hire package: city bike, mountain bike, gravel bike, road bike or mountain bike, half day, full day, several days, with or without accessories. Book online and collect your bike in Vallon Pont d'Arc. Delivery subject to conditions"
    ],
    "it": [
      "Scegliete il vostro pacchetto di noleggio bici: city, mountain, gravel, road o mountain bike, mezza giornata, giornata intera, più giorni, con o senza accessori. Prenotate online e ritirate la vostra bicicletta a Vallon Pont d'Arc. Consegna soggetta a condizioni"
    ],
    "fr": [
      "Choisissez votre formule de location de vélo : vélo de ville, VTC, gravel, route ou VTT, demi-journée, journée, plusieurs jours, avec ou sans accessoires. Réservez sur internet et récupérez votre vélo à Vallon Pont d’Arc. Livraison sous condition"
    ],
    "nl": [
      "Kies je fietsarrangement: stadsfiets, mountainbike, gravelbike, racefiets of mountainbike, halve dag, hele dag, meerdere dagen, met of zonder accessoires. Reserveer online en haal je fiets op in Vallon Pont d'Arc. Levering onder voorwaarden"
    ],
    "es": [
      "Elija su paquete de alquiler de bicicletas: de ciudad, de montaña, de gravilla, de carretera o BTT, de media jornada, de jornada completa, de varios días, con o sin accesorios. Reserve en línea y recoja su bicicleta en Vallon Pont d'Arc. Entrega sujeta a condiciones"
    ]
  },
