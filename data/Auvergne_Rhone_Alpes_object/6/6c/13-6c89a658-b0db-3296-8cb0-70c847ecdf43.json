  "rdfs:comment": {
    "de": [
      "Sie lieben Bier und alte Fahrzeuge? Bière Truck wird Ihre privaten oder öffentlichen Veranstaltungen zu etwas ganz Besonderem machen! Dieser charmante VW-Kombi wird sich gut in die Umgebung einfügen, und die leckeren lokalen Biere werden jeden Durst stillen."
    ],
    "en": [
      "Do you love beer and vintage vehicles? Bière Truck will make your private or public events even more special! This charming VW combi will blend in with the scenery, and the tasty local beers will quench every thirst."
    ],
    "it": [
      "Amate la birra e i veicoli d'epoca? Bière Truck renderà i vostri eventi privati o pubblici ancora più speciali! Questo affascinante VW combi si integrerà con l'arredamento e le gustose birre locali placheranno ogni sete."
    ],
    "fr": [
      "Vous adorez la bière et les véhicules anciens ? Bière Truck saura rendre vos événements privés ou publics encore plus spécial ! Ce charmant combi VW se fondra dans le décor et les savoureuses bières locales étancherons toutes les soifs."
    ],
    "es": [
      "¿Le gusta la cerveza y los vehículos de época? Bière Truck hará que sus eventos privados o públicos sean aún más especiales Esta encantadora combi VW se integrará en la decoración y las sabrosas cervezas locales saciarán cualquier sed."
    ],
    "nl": [
      "Hou je van bier en oldtimers? Bière Truck maakt je privé- of openbare evenementen nog specialer! Deze charmante VW-combi past perfect in het decor en de lekkere lokale bieren zullen elke dorst lessen."
    ]
  },
  "rdfs:label": {
