  "rdfs:comment": {
    "de": [
      "Im historischen Viertel Croix-Rousse gelegen, bietet Ihnen unsere Boutique eine große Auswahl an Artikeln (quadratische Tücher, Krawatten, Schals, Seidenmeterware...) an, darunter im Atelier bedruckte Produkte."
    ],
    "en": [
      "Located in Lyon’s traditional silk-making district on the slopes of the Croix-Rousse hill, our shop offers a huge choice of items, traditionally printed in our workshop including ties, breast pocket handkerchiefs, shawls, headscarves, muslin, scarves."
    ],
    "it": [
      "Collocata nello storico quartiere della Croix-Rousse, la nostra boutique propone una vasta scelta di articoli (quadrati di seta, cravatte, sciarpe, seta al metro...) alcuni dei quali sono stati stampati nel nostro laboratorio."
    ],
    "fr": [
      "Située aux pieds de la Croix-Rousse, site historique de la soierie lyonnaise, la boutique Brochier Soierie est un lieu unique où carrés et écharpes de soie sont imprimés sous vos yeux."
    ],
    "es": [
      "Nuestra tienda, situada en el barrio histórico de Croix-Rousse, ofrece una amplia selección de artículos (pañuelos, corbatas, bufandas, seda al metro…), que incluyen productos estampados en el taller."
    ],
    "nl": [
      "De Brochier Soierie boetiek ligt aan de voet van de Croix-Rousse, het historische zijdecentrum van Lyon, en is een unieke plek waar zijden sjaals en vierkanten voor je ogen worden bedrukt."
    ]
  },
