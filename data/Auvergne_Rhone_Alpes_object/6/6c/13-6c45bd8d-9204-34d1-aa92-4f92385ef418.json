  "rdfs:comment": {
    "de": [
      "Ich bin ein leidenschaftlicher Bergsteiger, staatlich geprüfter Begleiter, Lehrer und lebe im Giffre-Tal rund um Samoëns in Hochsavoyen. Ich biete Ihnen an, die Reichtümer dieses Tals in aller Einfachheit zu entdecken."
    ],
    "en": [
      "I'm a qualified mountain leader and teacher based in the Giffre valley around Samoëns in Haute-Savoie. I invite you to discover the riches of this valley in all simplicity."
    ],
    "it": [
      "Sono un'accompagnatrice e insegnante di montagna qualificata con sede nella valle di Giffre, nei dintorni di Samoëns, in Alta Savoia. Vi invito a scoprire le ricchezze di questa valle in tutta semplicità."
    ],
    "fr": [
      "Passionné de montagne, je suis Accompagnateur Diplômé d'État, enseignant et installé dans la vallée du Giffre autour de Samoëns en Haute-Savoie. Je vous propose de découvrir les richesses de cette vallée en toute simplicité."
    ],
    "es": [
      "Soy monitor de montaña titulado y profesor en el valle del Giffre, en los alrededores de Samoëns, en Alta Saboya. Te invito a descubrir las riquezas de este valle con toda sencillez."
    ],
    "nl": [
      "Ik ben een gediplomeerd bergleider en leraar in de Giffre vallei rond Samoëns in de Haute-Savoie. Ik nodig je uit om de rijkdommen van deze vallei in alle eenvoud te ontdekken."
    ]
  },
  "rdfs:label": {
    "en": [
      "Pascal Girerd - Mountain leader"
    ],
    "fr": [
      "Pascal Girerd - Accompagnateur en moyenne montagne"
    ]
  },
