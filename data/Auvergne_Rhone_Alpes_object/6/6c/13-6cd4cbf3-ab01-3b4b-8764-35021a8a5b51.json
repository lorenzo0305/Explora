  "rdfs:comment": {
    "de": [
      "Bei Pizza Santina finden Sie hausgemachte Pizzen aus frischen und hochwertigen Zutaten. Die Pasta wird von Hand zubereitet und die Pizzen werden im traditionellen Ofen gebacken, um einen authentischen Geschmack und eine knusprige Textur zu garantieren."
    ],
    "en": [
      "At Pizza Santina, you'll find homemade pizzas made with fresh, quality ingredients. Doughs are prepared by hand and pizzas are baked in a traditional oven, guaranteeing authentic flavor and crisp texture."
    ],
    "it": [
      "Da Pizza Santina troverete pizze fatte in casa con ingredienti freschi e di qualità. L'impasto è preparato a mano e le pizze sono cotte in un forno tradizionale, garantendo un sapore autentico e una consistenza croccante."
    ],
    "fr": [
      "Chez Pizza Santina, retrouvez des pizzas faites maison avec des ingrédients frais et de qualité. Les pâtes sont préparées à la main et les pizzas sont cuites au four traditionnel, pour garantir une saveur authentique et une texture croustillante."
    ],
    "es": [
      "En Pizza Santina encontrará pizzas caseras elaboradas con ingredientes frescos y de calidad. La masa se prepara a mano y las pizzas se cuecen en un horno tradicional, lo que garantiza un sabor auténtico y una textura crujiente."
    ],
    "nl": [
      "Bij Pizza Santina vind je huisgemaakte pizza's gemaakt met verse ingrediënten van hoge kwaliteit. Het deeg wordt met de hand bereid en de pizza's worden gebakken in een traditionele oven, wat garant staat voor een authentieke smaak en een knapperige textuur."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Pizza Santina"
    ]
  },
