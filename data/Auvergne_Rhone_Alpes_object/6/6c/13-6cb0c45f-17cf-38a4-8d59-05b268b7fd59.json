  "rdfs:comment": {
    "de": [
      "Nur 100 m vom Grand-Mont-Sessellift entfernt empfängt Sie Intersport Le Val Blanc im Winter für den Verleih von jeglichem Skimaterial und den Verkauf von Zubehör."
    ],
    "en": [
      "Just 100 m from the Grand-Mont chairlift, Intersport Le Val Blanc welcomes you in winter for the rental of all sliding equipment and the sale of accessories."
    ],
    "it": [
      "A soli 100 m dalla seggiovia Grand-Mont, l'Intersport Le Val Blanc offre il noleggio di attrezzature per gli sport invernali e la vendita di accessori."
    ],
    "fr": [
      "À seulement 100 m du télésiège du Grand-Mont, Intersport Le Val Blanc  vous accueille en hiver pour la location de tout matériel de glisse et la vente d’accessoires."
    ],
    "nl": [
      "Op slechts 100 m van de Grand-Mont stoeltjeslift verwelkomt Intersport Le Val Blanc u in de winter voor de verhuur van alle schuifapparatuur en de verkoop van accessoires."
    ],
    "es": [
      "A 100 m del telesilla Grand-Mont, Intersport Le Val Blanc ofrece alquiler de material para deportes de invierno y venta de accesorios."
    ]
  },
  "rdfs:label": {
    "en": [
