  "rdfs:comment": {
    "de": [
      "Entspannungsmassagen nach Maß . Ermöglicht es Ihnen, sich zu entspannen, Spannungen zu lindern und sich zu dynamisieren.\r\nEnergetische Behandlungen\r\nKurse zur Atempraxis und Einführung in die Meditation (in Gruppen oder einzeln)\r\nBeratung zu Ernährung und Lebensweise"
    ],
    "en": [
      "Tailor-made relaxing massages. To relax, relieve tension and energize."
    ],
    "it": [
      "Massaggi rilassanti su misura. Per rilassare, sciogliere le tensioni e dare energia.\r\nTrattamenti energetici\r\nCorsi di tecniche di respirazione e introduzione alla meditazione (di gruppo o individuali)\r\nConsigli su alimentazione e vita sana"
    ],
    "fr": [
      "Massages relaxants sur mesure . Permet de se relaxer, de soulager des tensions, de se dynamiser.\r\nSoins énergétiques \r\nCours sur la pratique de la respiration et initiation à la méditation (en groupe ou en individuel)\r\nConseils en nutrition et hygiène de vie"
    ],
    "nl": [
      "Ontspannende massages op maat. Om te ontspannen, spanningen te verlichten en energie te geven.\r\nEnergetische behandelingen\r\nCursussen in ademhalingstechnieken en inleiding tot meditatie (groep of individueel)\r\nAdvies over voeding en gezond leven"
    ],
    "es": [
      "Masajes relajantes a medida. Para relajarse, aliviar tensiones y revitalizarse.\r\nTratamientos energéticos\r\nCursos de técnicas de respiración e iniciación a la meditación (en grupo o individuales)\r\nConsejos sobre nutrición y vida sana"
    ]
  },
  "rdfs:label": {
    "en": [
      "Ayurvéda et Massages"
    ],
    "fr": [
      "Ayurvéda et Massages"
    ]
  },
