  "rdfs:comment": {
    "de": [
      "Das Gebäude, in dem sich heute das Musée de l'Horlogerie et du Décolletage und das Stadtarchiv befinden, ist eine ehemalige Uhrenfabrik, die im 19. Jahrhundert gegründet und 1993 saniert wurde.\r\nTeilweise Öffnung des Parks auf der Museumsseite"
    ],
    "en": [
      "The building which contains now the Clock-making and Screw-cutting Museum and City Archives is a former clock-making factory created in the XIXth century and refurbished in 1993."
    ],
    "it": [
      "L'edificio che oggi ospita il Musée de l'Horlogerie et du Décolletage e gli Archives Municipales è un'ex fabbrica di orologi creata nel XIX secolo e ristrutturata nel 1993.\r\nApertura parziale del parco, lato museo"
    ],
    "fr": [
      "Le bâtiment qui accueille aujourd'hui le Musée de l'Horlogerie et du Décolletage et les Archives Municipales est une ancienne fabrique d'horlogerie créée au XIXème siècle et réhabilitée en 1993.\r\nOuverture partielle du parc, côté musée"
    ],
    "nl": [
      "Het gebouw waarin nu het Musée de l'Horlogerie et du Décolletage en de Archives Municipales zijn gevestigd, is een voormalige horlogefabriek uit de 19e eeuw die in 1993 werd gerenoveerd.\r\nGedeeltelijke opening van het park, museumkant"
    ],
    "es": [
      "El edificio que alberga actualmente el Musée de l'Horlogerie et du Décolletage y los Archives Municipales es una antigua fábrica de relojería creada en el siglo XIX y renovada en 1993.\r\nApertura parcial del parque, lado museo"
    ]
  },
