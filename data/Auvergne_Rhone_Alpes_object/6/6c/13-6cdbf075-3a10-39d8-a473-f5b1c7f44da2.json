  "rdfs:comment": {
    "de": [
      "Welcome to Brides-les-Bains! Sind Sie neu in unserem Ferienort? Feiern Sie Ihre Ankunft mit Musik und der Gruppe Nico Brun. Ab 17 Uhr wird warmer Rotwein angeboten!"
    ],
    "en": [
      "Welcome to Brides-les-Bains!\r\nHave you just arrived in our resort? Come and celebrate your arrival with Bélier Bleu Trio.\r\nFree mulled red wine from 5:00 pm!"
    ],
    "it": [
      "Benvenuti a Brides-les-Bains! Siete appena arrivati nel nostro resort? Venite a festeggiare il vostro arrivo con la musica del gruppo Nico Brun. Vino rosso in omaggio dalle 17:00!"
    ],
    "fr": [
      "Welcome to Brides-les-Bains ! Vous venez de rejoindre notre station ? Venez fêter votre arrivée en musique avec le groupe Nico Brun. Vin rouge chaud offert à partir de 17h !"
    ],
    "es": [
      "¡Bienvenido a Brides-les-Bains! ¿Acaba de incorporarse a nuestra estación? Venga a celebrar su llegada con la música del grupo Nico Brun. Vino tinto de cortesía a partir de las 17 h"
    ],
    "nl": [
      "Welkom in Brides-les-Bains! Ben je net lid geworden van ons resort? Kom en vier je aankomst met muziek van de groep Nico Brun. Gratis rode wijn vanaf 17.00 uur!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Concert Vin chaud Rouge - Dimanche 22 mars"
    ]
  },
