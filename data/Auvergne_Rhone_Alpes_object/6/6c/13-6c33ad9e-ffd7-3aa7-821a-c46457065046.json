  "rdfs:comment": {
    "de": [
      "Pimang entstand aus dem Wunsch von Lucie Renaud, sich für ein originelles und nachhaltiges Kunsthandwerk einzusetzen. Sie verwendet ruhendes französisches und italienisches Leder, das für große Lederwarenhäuser entworfen wurde."
    ],
    "en": [
      "Pimang was born of Lucie Renaud's commitment to original, sustainable craftsmanship. She uses dormant French and Italian leathers created for leading leather goods manufacturers."
    ],
    "it": [
      "Pimang nasce dal desiderio di Lucie Renaud di promuovere un artigianato originale e sostenibile. Utilizza pelli francesi e italiane in disuso, create per importanti produttori di pelletteria."
    ],
    "fr": [
      "Pimang est né de la volonté de Lucie Renaud de s'engager pour un artisanat original et durable. Elle utilise des cuirs français et italiens en dormance créés pour des grandes maisons de maroquinerie."
    ],
    "es": [
      "Pimang nació del deseo de Lucie Renaud de promover una artesanía original y sostenible. Utiliza pieles latentes francesas e italianas creadas para los principales fabricantes de marroquinería."
    ],
    "nl": [
      "Pimang is ontstaan uit de toewijding van Lucie Renaud aan origineel, duurzaam vakmanschap. Ze gebruikt slapende Franse en Italiaanse leersoorten die zijn gemaakt voor toonaangevende lederwarenfabrikanten."
    ]
  },
