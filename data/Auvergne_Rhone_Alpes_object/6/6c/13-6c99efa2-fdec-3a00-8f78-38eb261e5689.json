  "rdfs:comment": {
    "de": [
      "Malerei auf Holz, auf Leinen, Acryl, Aquarell, Pyrogravur auf handgefertigtem Holz. Isabelle Wieder, seit 40 Jahren Malerin, arbeitet auf Bestellung anhand von Fotos oder einer spezifischen Beschreibung, um Ihr Originalwerk zu realisieren."
    ],
    "en": [
      "Painting on wood, linen canvas, acrylic, watercolor, handmade wood pyrography. Isabelle Wieder, painter for 40 years, works to order from photos or a specific description to create your original work."
    ],
    "it": [
      "Pittura su legno, tela di lino, acrilico, acquerello, pirografia su legno fatta a mano. Isabelle Wieder, pittrice da 40 anni, lavora su commissione a partire da foto o da una descrizione specifica per creare la vostra opera originale."
    ],
    "fr": [
      "Peinture sur bois, sur toile de lin, acrylique, aquarelle, pyrogravure sur bois fait-main. Isabelle Wieder artiste peintre depuis 40 ans travaille sur commande à partir de photos ou d'un descriptif spécifique pour réaliser votre œuvre originale."
    ],
    "nl": [
      "Schilderen op hout, linnen doek, acryl, aquarel, handgemaakte houtpyrografie. Isabelle Wieder schildert al 40 jaar en werkt op bestelling van foto's of een specifieke beschrijving om jouw originele werk te creëren."
    ],
    "es": [
      "Pintura sobre madera, lienzo de lino, acrílico, acuarela, pirograbado artesanal en madera. Isabelle Wieder es pintora desde hace 40 años, trabaja por encargo a partir de fotos o de una descripción específica para crear su obra original."
    ]
  },
  "rdfs:label": {
