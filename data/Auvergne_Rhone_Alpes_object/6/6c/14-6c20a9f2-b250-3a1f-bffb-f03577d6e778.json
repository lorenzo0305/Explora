      "dc:description": {
        "de": [
          "Machen Sie einen Spaziergang durch den Wald und suchen Sie nach den verschiedenen Wildfrüchten, die es hier gibt. Einige sind essbar, andere nicht!"
        ],
        "en": [
          "Stroll through the woods in search of the various wild fruits found on the site. Some are edible, others not!"
        ],
        "it": [
          "Passeggiate nel bosco alla ricerca dei vari frutti selvatici presenti sul sito. Alcuni sono commestibili, altri no!"
        ],
        "fr": [
          "Promenez vous dans les bois à la recherche des différents fruits sauvages présents sur le site. Certains sont comestibles, d’autres non !"
        ],
        "nl": [
          "Wandel door het bos op zoek naar de verschillende wilde vruchten die op het terrein te vinden zijn. Sommige zijn eetbaar, andere niet!"
        ],
        "es": [
          "Dé un paseo por el bosque en busca de los diversos frutos silvestres que se encuentran en el lugar. Algunos son comestibles, otros no"
        ]
      },
