  "rdfs:comment": {
    "de": [
      "Informieren Sie sich! Unsere Haute Maurienne Vanoise wird Ihnen die Geheimnisse eines gelungenen Urlaubs enthüllen. Unser Team aus 70 Personen, darunter 14 Urlaubsberater, steht Ihnen zur Verfügung, um Ihnen bei der Planung Ihres perfekten Urlaubs in den Bergen zu helfen."
    ],
    "en": [
      "Get informed! Haute Maurienne Vanoise will reveal the secrets of a successful vacation. Our team of 70 people, including 14 holiday advisors, is on hand to help you plan the perfect mountain holiday."
    ],
    "it": [
      "Informati! La nostra Haute Maurienne Vanoise vi svelerà i segreti di una vacanza di successo! Il nostro team di 70 persone, tra cui 14 consulenti turistici, è a vostra disposizione per aiutarvi a preparare la vacanza perfetta in montagna."
    ],
    "fr": [
      "Informez-vous ! Notre Haute Maurienne Vanoise va vous révéler les secrets des vacances réussies. Notre équipe de 70 personnes, dont 14 conseillers en séjour, est à votre disposition pour vous aider à préparer le séjour parfait à la montagne."
    ],
    "es": [
      "Más información Haute Maurienne Vanoise le desvelará los secretos de unas vacaciones de éxito. Nuestro equipo de 70 personas, entre ellas 14 asesores de vacaciones, está a su disposición para ayudarle a preparar las vacaciones de montaña perfectas."
    ],
    "nl": [
      "Laat u informeren! Onze Haute Maurienne Vanoise zal u de geheimen van een geslaagde vakantie onthullen! Ons team van 70 mensen, waaronder 14 reisadviseurs, staat tot uw beschikking."
    ]
  },
