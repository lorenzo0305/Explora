  "rdfs:comment": {
    "de": [
      "In einem Schloss auf den Anhöhen von Vizille gelegen, empfängt Sie Le Repère in einer idyllischen Umgebung, 10 Minuten von Grenoble entfernt.\r\nKeine Verpflegung am Sonntagabend und Montag - Kein Frühstück am Montagmorgen."
    ],
    "en": [
      "Located in a château on the heights of Vizille, Le Repère welcomes you to an idyllic setting just 10 minutes from Grenoble.\r\nNo catering on Sunday evenings and Mondays - No breakfast on Monday mornings."
    ],
    "it": [
      "Situato in un castello sulle alture di Vizille, Le Repère vi accoglie in un ambiente idilliaco a soli 10 minuti da Grenoble.\r\nRistorante chiuso la domenica sera e il lunedì"
    ],
    "fr": [
      "Situé dans un château sur les hauteurs de Vizille, le Repère vous accueille dans un cadre idyllique à 10 minutes de Grenoble.\r\nRestaurant fermé le dimanche soir et le lundi"
    ],
    "es": [
      "Situado en un castillo en las alturas de Vizille, Le Repère le da la bienvenida en un entorno idílico a sólo 10 minutos de Grenoble.\r\nNo hay servicio de restauración los domingos por la noche ni los lunes - No hay desayuno los lunes por la mañana."
    ],
    "nl": [
      "Le Repère is gevestigd in een kasteel op de hoogten van Vizille en verwelkomt je in een idyllische omgeving op slechts 10 minuten van Grenoble.\r\nRestaurant gesloten op zondagavond en maandag"
    ]
  },
