  "rdfs:comment": {
    "de": [
      "In ihrem Atelier Galerie Art Zone präsentiert Catherine Médico, Bildhauerin von Recycling-Objekten, neben ihren eigenen Werken eine Auswahl von Designern, die in der Welt des Recyclings und des Designs an einem gemeinsamen künstlerischen und innovativen Ansatz beteiligt sind."
    ],
    "en": [
      "In her workshop-gallery Art Zone, Catherine Medico, sculptor who work with recycled object, shows in addition of her works a selection of designers involved in the same approach: both artistically and innovative in the world of recycling and design."
    ],
    "it": [
      "Nel suo studio Galerie Art Zone, Catherine Médico, scultrice di oggetti riciclati, presenta una selezione di creatori impegnati nello stesso approccio artistico e innovativo nel mondo del riciclo e del design."
    ],
    "fr": [
      "Dans son atelier Galerie Art Zone Catherine Médico, sculpteur d'objets recyclés présente en plus de ses œuvres une sélection de créateurs impliqués dans une même démarche à la fois artistique et novatrice dans le monde du recyclage et du design."
    ],
    "nl": [
      "In haar atelier Galerie Art Zone toont Catherine Médico, een beeldhouwer van gerecyclede voorwerpen, een selectie van haar eigen werk en werk van andere ontwerpers die betrokken zijn bij dezelfde artistieke en innovatieve benadering van de wereld van recycling en design."
    ],
    "es": [
      "En su estudio Galerie Art Zone, Catherine Médico, escultora de objetos reciclados, presenta una selección de creadores involucrados en el mismo enfoque artístico e innovador en el mundo del reciclaje y el diseño."
    ]
  },
  "rdfs:label": {
    "en": [
