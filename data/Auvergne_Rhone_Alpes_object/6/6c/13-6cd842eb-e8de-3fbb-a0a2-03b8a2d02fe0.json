  "rdfs:comment": {
    "de": [
      "Ein seltsamer Meteorit ist auf Albiez gefallen und hat einen Raum-Zeit-Riss verursacht! Nur der Stern der Zeit kann das alles wieder in Ordnung bringen.\r\nEs liegt an dir, durch die Zeiten zu reisen, um den Stern der Zeit zu befreien..."
    ],
    "en": [
      "A strange meteorite has fallen on Albiez, causing a space-time rift! Only the Time Star can put things right.\r\nIt's up to you to cross the ages to deliver the Time Star..."
    ],
    "it": [
      "Uno strano meteorite è caduto su Albiez, causando una frattura nello spazio e nel tempo! Solo la Stella del Tempo può rimettere le cose a posto.\r\nSta a voi viaggiare nel tempo per salvare la Stella del Tempo..."
    ],
    "fr": [
      "Une étrange météorite est tombée sur Albiez provoquant une faille spatio-temporelle ! L'étoile du temps s'est du coup retrouvée enfermée dans un livre en bois conservé à l'office de tourisme.\r\nÀ toi de traverser les époques pour délivrer l'étoile du temps…"
    ],
    "es": [
      "Un extraño meteorito ha caído sobre Albiez, ¡provocando una grieta en el espacio y el tiempo! Como resultado, la Estrella del Tiempo se encuentra encerrada en un libro de madera guardado en la Oficina de Turismo.\r\nTe toca a ti viajar al pasado y rescatar la Estrella del Tiempo?"
    ],
    "nl": [
      "Een vreemde meteoriet is op Albiez gevallen en veroorzaakt een scheur in ruimte en tijd! Alleen de Tijdster kan dit rechtzetten.\r\nHet is aan jou om door de tijd te reizen en de Tijdster te redden..."
    ]
  },
  "rdfs:label": {
    "de": [
      "Die Rätsel von Charlock - Die Zeitreisenden"
    ],
    "ru": [
      "Загадки Чарлока - Путешественники во времени"
    ],
    "en": [
      "Charlock's riddles - Time travelers"
    ],
    "it": [
      "Gli enigmi di Charlock - I viaggiatori del tempo"
    ],
    "fr": [
      "Les énigmes de Charlock - Les voyageurs du temps"
    ],
    "zh": [
      "夏洛克的谜语 - 时间旅行者"
    ],
    "es": [
      "Enigmas de Charlock - Viajeros en el tiempo"
    ],
    "nl": [
      "Charlocks raadsels - Tijdreizigers"
    ]
  },
