  "rdfs:comment": {
    "de": [
      "Dieses Dorf ist reich an Geschichte (gallo-römische Stätte, Burg der Herren von Urre), Kulturerbe (Kirche Saint-Apollinaire) und Natur (in der Nähe der Drôme und des Naturschutzgebiets Réserve des Ramières). Es ist eine aktive Gemeinde mit Landwirtschaft und Weinbau."
    ],
    "en": [
      "This village is rich in history (Gallo-Roman site, castle of the Lords of Urre), heritage (Saint-Apollinaire church) and nature (near the Drôme and the Réserve des Ramières). It is an active agricultural and wine-growing commune."
    ],
    "it": [
      "Questo villaggio è ricco di storia (sito gallo-romano, castello dei Signori d'Urre), patrimonio (chiesa di Saint-Apollinaire) e natura (vicino alla Drôme e alla Réserve des Ramières). È un'attiva comunità agricola e vitivinicola."
    ],
    "fr": [
      "Ce village est riche d'histoire (site gallo-romain, château des Seigneurs d'Urre), de patrimoine (église Saint-Apollinaire) et de nature (près de la Drôme et de la Réserve des Ramières). C'est une commune agricole et viticole active."
    ],
    "es": [
      "Este pueblo es rico en historia (yacimiento galo-romano, castillo de los Señores de Urre), patrimonio (iglesia de Saint-Apollinaire) y naturaleza (cerca de la Drôme y de la Reserva de Ramières). Es una activa comunidad agrícola y vitivinícola."
    ],
    "nl": [
      "Dit dorp is rijk aan geschiedenis (Gallo-Romeinse site, kasteel van de heren van Urre), erfgoed (kerk Saint-Apollinaire) en natuur (vlakbij de Drôme en het Réserve des Ramières). Het is een actieve landbouw- en wijnbouwgemeente."
    ]
  },
