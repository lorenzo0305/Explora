  "rdfs:comment": {
    "de": [
      "Aktivität: Keksfabrik\n\nGeöffnet am Montag von 14:00 bis 17:00 Uhr, Dienstag, Mittwoch, Donnerstag von 9:30 bis 12:00 Uhr und von 14:00 bis 17:00 Uhr und am Freitag von 9:30 bis 17:00 Uhr.\n\nVerkauftes Kunsthandwerk: Kekse, regionale Süßwaren.\n\nWichtigste vorgestellte Marken: Eugène BLOND, Dunkerquoise, Afchain."
    ],
    "en": [
      "Activity: Biscuits\n\nOpen Mondays 2-5pm, Tuesdays, Wednesdays, Thursdays 9:30am-12pm and 2-5pm and Fridays 9:30am-5pm.\n\nArtciles sold: cookies, regional confectionery.\n\nMain brands presented: Eugène BLOND, Dunkerquoise, Afchain."
    ],
    "it": [
      "Attività: Biscotti\n\nAperto il lunedì dalle 14.00 alle 17.00, il martedì, mercoledì e giovedì dalle 9.30 alle 12.00 e dalle 14.00 alle 17.00 e il venerdì dalle 9.30 alle 17.00.\n\nProdotti venduti: biscotti, dolci regionali.\n\nPrincipali marchi presentati: Eugène BLOND, Dunkerquoise, Afchain."
    ],
    "fr": [
      "Activité : Biscuiterie\n\nOuvert le lundi de 14h à 17h, mardi, mercredi, jeudi de 9h30 à 12h et de 14h à 17h et le vendredi de 9h30 à 17h.\n\nArtciles vendus : biscuits, confiseries régionales.\n\nPrincipales marques présentées : Eugène BLOND, Dunkerquoise, Afchain."
    ],
    "nl": [
      "Activiteit: Koekjes\n\nOpen op maandag van 14.00 tot 17.00 uur, dinsdag, woensdag en donderdag van 9.30 tot 12.00 uur en van 14.00 tot 17.00 uur en vrijdag van 9.30 tot 17.00 uur.\n\nVerkochte producten: koekjes, regionale snoepjes.\n\nBelangrijkste gepresenteerde merken: Eugène BLOND, Dunkerquoise, Afchain."
    ],
    "es": [
      "Actividad: Galletas\n\nAbierto los lunes de 14.00 a 17.00 horas, los martes, miércoles y jueves de 9.30 a 12.00 horas y de 14.00 a 17.00 horas y los viernes de 9.30 a 17.00 horas.\n\nProductos vendidos: galletas, dulces regionales.\n\nPrincipales marcas presentadas: Eugène BLOND, Dunkerquoise, Afchain."
    ]
  },
