      "@id": "https://data.datatourisme.fr/6343001b-fba0-3ae9-b1bf-75c7b74b8f30",
      "dc:description": {
        "de": [
          "EHRENGAST Ariane Ascaride\nProgramm der Vorführungen online auf kdiffusion.com: https://www.kdiffusion.com/medias/docs/bloc537/Prog-CINEMONDES2024.pdf\nUnd im Booklet-Format im Office de Tourisme de Berck-sur-Mer\nOrganisiert von Krysalide Diffusion\nInfos beim Cinos unter +33 (0)3 61 85 05 00"
        ],
        "en": [
          "GUEST OF HONOR Ariane Ascaride\nScreening schedule online at kdiffusion.com: https://www.kdiffusion.com/medias/docs/bloc537/Prog-CINEMONDES2024.pdf\nAnd in booklet format at Berck-sur-Mer Tourist Office\nOrganized by Krysalide Diffusion\nInformation from Cinos on +33 (0)3 61 85 05 00"
        ],
        "it": [
          "OSPITE D'ONORE Ariane Ascaride\nProgramma delle proiezioni online su kdiffusion.com: https://www.kdiffusion.com/medias/docs/bloc537/Prog-CINEMONDES2024.pdf\nE in formato opuscolo presso l'Ufficio del Turismo di Berck-sur-Mer\nOrganizzato da Krysalide Diffusion\nInformazioni presso Cinos al +33 (0)3 61 85 05 00"
        ],
        "fr": [
          "INVITÉE D’HONNEUR Ariane Ascaride\nProgrammation des projections en ligne sur kdiffusion.com  : https://www.kdiffusion.com/medias/docs/bloc537/Prog-CINEMONDES2024.pdf\nEt en format livret à l’Office de Tourisme de Berck-sur-Mer\nOrganisé par Krysalide Diffusion\nInfos auprès du Cinos au +33 (0)3 61 85 05 00"
        ],
        "es": [
          "INVITADA DE HONOR Ariane Ascaride\nPrograma de proyecciones en línea en kdiffusion.com: https://www.kdiffusion.com/medias/docs/bloc537/Prog-CINEMONDES2024.pdf\nY en formato folleto en la Oficina de Turismo de Berck-sur-Mer\nOrganizado por Krysalide Diffusion\nInformación en Cinos en el +33 (0)3 61 85 05 00"
        ],
        "nl": [
          "Eregast Ariane Ascaride\nProgramma van de voorstellingen online op kdiffusion.com: https://www.kdiffusion.com/medias/docs/bloc537/Prog-CINEMONDES2024.pdf\nEn in boekje bij het VVV-kantoor van Berck-sur-Mer\nGeorganiseerd door Krysalide Diffusion\nInlichtingen bij Cinos op +33 (0)3 61 85 05 00"
        ]
      },
