  "rdfs:comment": {
    "de": [
      "Mit seiner Panoramaterrasse ist La Ferme d'Hubert der ideale Ort für ein sonniges Mittagessen, mit kostenlosem Zugang zum Wellnessbereich im Freien. Gourmetküche, Sonntagsbrunch."
    ],
    "en": [
      "With its panoramic terrace, La Ferme d'Hubert is the ideal spot for a sunny lunch, with free access to the outdoor wellness area. Gourmet cuisine, Sunday brunch."
    ],
    "it": [
      "Con la sua terrazza panoramica, La Ferme d'Hubert è il luogo ideale per un pranzo al sole, con accesso gratuito all'area benessere esterna. Cucina gourmet, brunch domenicale."
    ],
    "fr": [
      "Avec sa terrasse panoramique, La Ferme d’Hubert est le spot idéal pour un déjeuner ensoleillé, avec accès offert à l’espace bien-être extérieur. Cuisine gourmande, brunch le dimanche."
    ],
    "nl": [
      "Met zijn panoramisch terras is La Ferme d'Hubert de ideale plek voor een zonnige lunch, met gratis toegang tot de outdoor wellnessruimte. Gastronomische keuken, zondag brunch."
    ],
    "es": [
      "Con su terraza panorámica, La Ferme d'Hubert es el lugar ideal para un almuerzo soleado, con acceso gratuito a la zona de bienestar al aire libre. Cocina gastronómica, brunch dominical."
    ]
  },
