  "rdfs:comment": {
    "de": [
      "In einem gemütlichen Rahmen wird Ihnen eine großzügige, leckere und authentische Küche geboten. Foie gras, Froschschenkel, Entenbrust und Confits stehen auf der Speisekarte und den Menüs."
    ],
    "en": [
      "Located in a warm setting, the Regence offers an authentic and gastronomic cuisine. Delicacies such as foie gras, frogs legs, duck magrets and confits adorn the menu."
    ],
    "it": [
      "In un ambiente accogliente, viene offerta una cucina generosa, gourmet e autentica. Foie gras, cosce di rana, petto d'anatra e confit sono tutti presenti nel menu."
    ],
    "fr": [
      "Dans un cadre chaleureux, une cuisine généreuse, gourmande et authentique vous sera proposée. Foie gras, cuisses de grenouilles, magrets et confits se font la part belle sur la carte et les menus."
    ],
    "nl": [
      "In een warm kader wordt een gulle, gastronomische en authentieke keuken aangeboden. Foie gras, kikkerbilletjes, eendenborst en confijt staan allemaal op het menu."
    ],
    "es": [
      "En un ambiente cálido, se ofrece una cocina generosa, gourmet y auténtica. El foie gras, las ancas de rana, el magret de pato y los confites forman parte del menú."
    ]
  },
  "rdfs:label": {
