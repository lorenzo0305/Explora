  "rdfs:comment": {
    "de": [
      "In der wilden Umgebung des Cher-Tals befindet sich der Staudamm von Rochebut, ein 170 Hektar großer Stausee (EDF-Staudamm), der in die zweite Kategorie eingestuft ist. Nicht erschöpfende Liste der Verkaufsstellen für Angelkarten unten."
    ],
    "en": [
      "In the wild setting of the Cher valley, the Rochebut dam is a 170-hectare reservoir (EDF dam) classified as 2nd category. See below for a non-exhaustive list of outlets selling fishing cards."
    ],
    "it": [
      "Nel contesto selvaggio della valle dello Cher, la diga di Rochebut è un bacino artificiale di 170 ettari (diga EDF) classificato di categoria 2. Di seguito è riportato un elenco non esaustivo di punti vendita di carte da pesca."
    ],
    "fr": [
      "Dans le cadre sauvage du val de Cher, le barrage de Rochebut est une retenue de 170 hectares (barrage EDF) classée 2e catégorie. Liste non exhaustive des points de vente de cartes de pêche ci-dessous."
    ],
    "nl": [
      "In de wilde omgeving van de vallei van de Cher is de stuwdam van Rochebut een stuwmeer (EDF-stuwdam) van 170 hectare dat geclassificeerd is als categorie 2. Hieronder vind je een niet-limitatieve lijst van verkooppunten van viskaarten."
    ],
    "es": [
      "En el entorno salvaje del valle del Cher, la presa de Rochebut es un embalse de 170 hectáreas (presa EDF) clasificado de categoría 2. A continuación figura una lista no exhaustiva de puntos de venta de tarjetas de pesca."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Pêche au barrage de Rochebut"
    ]
  },
