  "rdfs:comment": {
    "de": [
      "Dieses von erfahrenen Gastronomen gegründete Unternehmen bietet Ihnen seine Leidenschaft und Kreativität im Dienste Ihrer Geschmacksknospen für Ihre Familien- und Geschäftsveranstaltungen, aber auch für Ihr tägliches Mittagessen."
    ],
    "en": [
      "Created by experienced restaurateurs, this company brings its passion and creativity to your taste buds for family and business events, as well as for your everyday lunches."
    ],
    "it": [
      "Creata da ristoratori esperti, questa azienda vi offre la sua passione e creatività per servire il vostro palato per i vostri eventi familiari e professionali, ma anche per i vostri pranzi quotidiani."
    ],
    "fr": [
      "Créé par des restaurateurs d’expérience, cette entreprise vous propose sa passion et sa créativité au service de vos papilles pour vos événements familiaux et professionnels mais aussi pour vos déjeuners quotidiens."
    ],
    "nl": [
      "Dit bedrijf is opgericht door ervaren restauranthouders en brengt zijn passie en creativiteit naar je smaakpapillen voor familie- en bedrijfsevenementen, maar ook voor je dagelijkse lunches."
    ],
    "es": [
      "Creada por restauradores experimentados, esta empresa le ofrece su pasión y creatividad para servir a su paladar en sus eventos familiares y profesionales, pero también en sus almuerzos diarios."
    ]
  },
  "rdfs:label": {
