  "rdfs:comment": {
    "de": [
      "Im Constant's können Sie Rindersteak, Caesar Salad, Schweinerippchen, Fish and Chips usw. probieren.\r\nAußerhalb der Mittagszeit werden auch Nachos mit Cheddar, Tapas, Wurst- und Käseplatten, Burger und Pizza Romana angeboten."
    ],
    "en": [
      "At Constant's, you'll be able to enjoy beef, Caesar salad, pork ribs, fish and chips...\r\nOutside lunchtime, we also offer cheddar nachos, tapas, charcuterie and cheese boards, burgers and pizza romana."
    ],
    "it": [
      "Al Constant, potrete gustare carne di manzo, insalata Caesar, costine di maiale, fish and chips...\r\nFuori dall'ora di pranzo, si possono gustare anche nachos al cheddar, tapas, taglieri di salumi e formaggi, hamburger e pizza romana."
    ],
    "fr": [
      "Chez Constant, vous pourrez déguster pièce de bœuf, salade Caesar, ribs de porc, fish and chips...\r\nEn dehors du déjeuner seront également proposés nachos au cheddar, tapas, planches de charcuterie et de fromage, des burgers et des pizza romana."
    ],
    "es": [
      "En Constant, puedes disfrutar de ternera, ensalada César, costillas de cerdo, fish and chips...\r\nFuera de la hora de comer, también puedes disfrutar de nachos con queso cheddar, tapas, tablas de embutidos y quesos, hamburguesas y pizza romana."
    ],
    "nl": [
      "Bij Constant kun je genieten van rundvlees, Caesar salad, varkensribbetjes, fish and chips...\r\nBuiten lunchtijd kun je ook genieten van cheddar nacho's, tapas, vleeswaren- en kaasplankjes, burgers en pizza romana."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant Constant, Bar à bière et à manger"
    ]
  },
