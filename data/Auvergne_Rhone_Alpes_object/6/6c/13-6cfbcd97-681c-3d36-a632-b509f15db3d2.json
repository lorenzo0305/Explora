  "rdfs:comment": {
    "de": [
      "Ein kreatives Bistro, das eingerichtet wurde, um einen Ort zu schaffen, an dem gutes Essen, Wein und Kultur gut zusammenpassen. Der junge Küchenchef Yann Gaillard hat zusammen mit seinem Kollegen Olivier Mesnard ein ehemaliges Restaurant am Ufer der Saône übernommen."
    ],
    "en": [
      "A creative bistro designed to create a place where good food, wine and culture go hand in hand. The young chef, Yann Gaillard, has taken over a former restaurant on the banks of the Saône with his partner Olivier Mesnard."
    ],
    "it": [
      "Un bistrot creativo progettato per creare un luogo dove buon cibo, vino e cultura vanno di pari passo. Il giovane chef Yann Gaillard ha rilevato un ex ristorante sulle rive della Saona insieme al collega Olivier Mesnard."
    ],
    "fr": [
      "Un bistrot créatif aménagé pour créer un lieu où la bonne cuisine, le vin et la culture font bon ménage. Le jeune chef, Yann Gaillard, a repris avec son compère Olivier Mesnard, un ancien restaurant des bords de Saône."
    ],
    "es": [
      "Un bistró creativo diseñado para crear un lugar donde la buena comida, el vino y la cultura vayan de la mano. El joven chef Yann Gaillard se ha hecho cargo de un antiguo restaurante a orillas del Saona con su colega Olivier Mesnard."
    ],
    "nl": [
      "Een creatieve bistro ontworpen om een plek te creëren waar goed eten, wijn en cultuur hand in hand gaan. De jonge chef-kok, Yann Gaillard, heeft samen met zijn collega Olivier Mesnard een voormalig restaurant aan de oevers van de Saône overgenomen."
    ]
  },
  "rdfs:label": {
