  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/e80a9032-4ebf-30af-9f8e-f830195f1d86",
      "dc:description": {
        "de": [
          "Besuchen Sie den Betrieb von Jean Jacques Martel und lernen Sie die Milchproduktion kennen: Milch, Butter, Crème fraîche, Quark, Joghurt und Honig - all diese Köstlichkeiten erwarten Sie in unserem Laden."
        ],
        "en": [
          "Visit Jean Jacques Martel's farm for a warm discovery of dairy production: milk, butter, fresh cream, cottage cheese, yoghurts and honey... all these flavours await you at the shop."
        ],
        "it": [
          "Visitate la fattoria di Jean Jacques Martel per una calda scoperta della produzione lattiero-casearia: latte, burro, panna fresca, ricotta, yogurt e miele... tutti questi sapori vi aspettano nel negozio."
        ],
        "fr": [
          "Rendez-vous sur l'exploitation de Jean Jacques Martel pour une chaleureuse découverte de la production laitière : lait, beurre, crème fraîche, fromage blanc, yaourts et miel... toutes ces saveurs vous attendent à la boutique."
        ],
        "es": [
          "Visite la granja de Jean Jacques Martel para descubrir con calidez la producción láctea: leche, mantequilla, nata fresca, requesón, yogures y miel... todos estos sabores le esperan en la tienda."
        ],
        "nl": [
          "Bezoek de boerderij van Jean Jacques Martel voor een warme ontdekking van de zuivelproductie: melk, boter, verse room, kwark, yoghurt en honing... al deze smaken wachten op u in de winkel."
        ]
      },
      "@type": [
        "Description"
