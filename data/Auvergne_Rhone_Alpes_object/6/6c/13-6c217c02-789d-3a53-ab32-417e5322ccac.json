  "rdfs:comment": {
    "de": [
      "Wir empfangen Sie in einer herzlichen Atmosphäre, um eine authentische Küche zu genießen, die zugleich traditionell und familiär ist. Genießen Sie unser Arbeitermenü, das aus einem Vorspeisenbuffet, einem warmen Gericht, Käse und einem Dessertbuffet besteht."
    ],
    "en": [
      "We welcome you in a warm atmosphere to savor authentic cuisine, both traditional and family-style. Enjoy our \"ouvrier\" menu including a buffet of starters, a hot dish, cheese and a dessert buffet."
    ],
    "it": [
      "Vi diamo il benvenuto in un'atmosfera calda per gustare una cucina autentica, tradizionale e familiare. Godetevi il nostro menu \"ouvrier\" che comprende un buffet di antipasti, un piatto caldo, formaggi e un buffet di dolci."
    ],
    "fr": [
      "Nous vous accueillons dans une ambiance chaleureuse pour savourer une cuisine authentique, à la fois traditionnelle et familiale. Profitez de notre menu ouvrier comprenant un buffet d'entrées, un plat chaud, du fromage et un buffet de desserts."
    ],
    "nl": [
      "We verwelkomen je in een warme sfeer om te genieten van een authentieke keuken die zowel traditioneel als huiselijk is. Geniet van ons \"ouvrier\" menu met een buffet van voorgerechten, een warme schotel, kaas en een dessertbuffet."
    ],
    "es": [
      "Le damos la bienvenida en un ambiente cálido para disfrutar de una cocina auténtica, tradicional y casera. Disfrute de nuestro menú \"ouvrier\" que incluye un bufé de entrantes, un plato caliente, quesos y un bufé de postres."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant Chez Cou'tou"
    ]
  },
