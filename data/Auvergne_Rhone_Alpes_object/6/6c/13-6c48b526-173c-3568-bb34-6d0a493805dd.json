  "rdfs:comment": {
    "de": [
      "Der Espace Art et Essai vereint einen Ausstellungsraum und ein Atelier, in dem Kurse und Praktika für Zeichnen und Malen angeboten werden.\r\nDie Ausstellungen zeigen die Arbeit eines oder mehrerer Künstler."
    ],
    "en": [
      "A space combining two proposals: art exhibitions and courses, workshops and courses in drawing, painting.....\r\nA place to explore, open to the outside world and bringing in other artists to offer their teaching."
    ],
    "it": [
      "L'Espace Art et Essai combina uno spazio espositivo con un laboratorio che offre corsi di disegno e pittura.\r\nLe mostre presentano il lavoro di uno o più artisti."
    ],
    "fr": [
      "L'Espace Art et Essai réunit un lieu d'exposition et un atelier proposant des cours et stages de dessin et peinture.\r\nLes expositions présentent le travail d'un ou plusieurs artistes."
    ],
    "es": [
      "El Espace Art et Essai combina un espacio de exposición con un taller que ofrece cursos de dibujo y pintura.\r\nLas exposiciones presentan la obra de uno o varios artistas."
    ],
    "nl": [
      "De Espace Art et Essai combineert een tentoonstellingsruimte met een atelier waar teken- en schildercursussen worden gegeven.\r\nTentoonstellingen tonen het werk van een of meerdere kunstenaars."
    ]
  },
