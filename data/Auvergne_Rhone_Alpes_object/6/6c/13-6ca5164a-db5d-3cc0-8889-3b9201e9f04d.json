  "rdfs:comment": {
    "de": [
      "CortexQuiz ist ein lebensgroßes Quizspiel, das von TV-Spielshows inspiriert ist. Sie tauchen in einen Quizraum ein, der mit Pulten, Buzzern und einem Großbildschirm ausgestattet ist und von unserem Starmoderator Quizy moderiert wird!"
    ],
    "en": [
      "CortexQuiz is a life-size quiz game inspired by TV game shows. You'll be immersed in a quiz room equipped with desks, buzzers and a giant screen, all hosted by our star Quizy!"
    ],
    "it": [
      "CortexQuiz è un gioco a quiz a grandezza naturale ispirato ai game show televisivi. Sarete immersi in una sala quiz attrezzata con banchi, cicalini e uno schermo gigante, il tutto condotto dalla nostra star Quizy!"
    ],
    "fr": [
      "CortexQuiz est un jeu de quiz grandeur nature, inspiré des émissions de jeu TV. Vous serez immergé dans une salle de quiz équipée de pupitres, de buzzers et d'un écran géant, le tout animé par notre animateur vedette Quizy !"
    ],
    "nl": [
      "CortexQuiz is een levensgroot quizspel geïnspireerd op tv-spelshows. Je wordt ondergedompeld in een quizzaal met bureaus, buzzers en een gigantisch scherm, allemaal gepresenteerd door onze ster Quizy!"
    ],
    "es": [
      "CortexQuiz es un juego de preguntas a tamaño real inspirado en los concursos de televisión. Te sumergirás en una sala de concursos equipada con pupitres, zumbadores y una pantalla gigante, ¡todo ello conducido por nuestra estrella Quizy!"
    ]
  },
