  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/73850c95-db9b-318c-8b70-9a8eef3c65f7",
      "dc:description": {
        "de": [
          "Ziehen Sie Ihren Imkeranzug an und machen Sie sich auf den Weg zu den Bienen, um ihre faszinierende Welt in aller Sicherheit zu entdecken."
        ],
        "en": [
          "Put on your beekeeping suit and set off to meet bees and discover their fascinating world in complete safety."
        ],
        "it": [
          "Indossate la vostra tuta da apicoltore e partite per incontrare le api e scoprire il loro affascinante mondo in tutta sicurezza."
        ],
        "fr": [
          "Enfilez votre combinaison d’apiculture et partez à la rencontre des abeilles pour découvrir leur univers fascinant en toute sécurité."
        ],
        "nl": [
          "Trek je imkerpak aan en ga op pad om bijen te ontmoeten en hun fascinerende wereld in alle veiligheid te ontdekken."
        ],
        "es": [
          "Ponte el traje de apicultor y sal al encuentro de las abejas para descubrir su fascinante mundo con total seguridad."
        ]
      },
