  "rdfs:comment": {
    "de": [
      "Unsere Pizzeria liegt im Herzen des kreisförmigen Dorfes Alixan und bietet Ihnen im Holzofen gebackene Pizzas sowie Tagesgerichte.\r\nFinden Sie unsere 40 Plätze in unserem komplett renovierten Restaurant in einem charmanten und entspannenden Dekor."
    ],
    "en": [
      "Located in the heart of the circular village of Alixan, our pizzeria offers wood-fired pizzas and daily specials.\r\nEnjoy our 40 seats in our fully renovated restaurant with its charming and relaxing decor."
    ],
    "it": [
      "Situata nel cuore del villaggio circolare di Alixan, la nostra pizzeria offre pizze cotte a legna e specialità giornaliere.\r\nIl nostro ristorante da 40 posti è stato completamente rinnovato per creare un ambiente affascinante e rilassante."
    ],
    "fr": [
      "Située au coeur du village circulaire d'Alixan, notre pizzéria vous propose des pizzas cuites au feu de bois ainsi que des plats du jour.\r\nRetrouvez nos 40 places dans notre restaurant entièrement rénové dans un décor charmant et relaxant."
    ],
    "es": [
      "Situada en el corazón de la aldea circular de Alixan, nuestra pizzería ofrece pizzas al horno de leña y platos del día.\r\nNuestro restaurante de 40 plazas ha sido completamente renovado para crear un entorno encantador y relajante."
    ],
    "nl": [
      "Onze pizzeria ligt in het hart van het ronde dorp Alixan en biedt houtovenpizza's en dagschotels.\r\nOns restaurant met 40 zitplaatsen is volledig gerenoveerd om een charmante en ontspannende omgeving te creëren."
    ]
  },
