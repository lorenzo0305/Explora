  "rdfs:comment": {
    "de": [
      "Das Team von Sancy' O empfängt Sie täglich, um Ihnen einen Moment des Spiels, des Wohlbefindens oder des Sports zu bieten, allein, mit der Familie oder mit Freunden."
    ],
    "en": [
      "The Sancy O team welcomes you every day to offer you a fun family moment, well-being or sports."
    ],
    "it": [
      "Il team Sancy' O vi accoglie ogni giorno per un momento di divertimento, benessere o sport, da soli, in famiglia o con gli amici."
    ],
    "fr": [
      "L'équipe de Sancy' O vous accueille quotidiennement pour vous offrir un moment ludique, de bien-être ou sportif, seul, en famille ou entre amis."
    ],
    "nl": [
      "Het Sancy' O team verwelkomt je elke dag voor een moment van plezier, welzijn of sport, alleen, met familie of vrienden."
    ],
    "es": [
      "El equipo de Sancy' O le da la bienvenida cada día para un momento de diversión, bienestar o deporte, solo, en familia o con amigos."
    ]
  },
