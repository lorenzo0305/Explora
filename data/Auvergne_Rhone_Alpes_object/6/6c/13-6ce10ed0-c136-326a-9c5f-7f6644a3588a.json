  "rdfs:comment": {
    "de": [
      "Gemeinsame Musik, keltischer Tanz und Gesang. Irisches Essen: Coleslaw, Rindfleisch in Bier, Käse und Schokoladenkuchen mit Sahne. Reservierungen sind möglich."
    ],
    "en": [
      "Music, Celtic dancing and singing all together. Irish meal: coleslaw, beef in beer, cheese and chocolate cake with custard. Reservations now open."
    ],
    "it": [
      "Musica, danze e canti celtici tutti insieme. Pasto irlandese: insalata di cavolo, manzo alla birra, formaggio e torta al cioccolato con crema pasticcera. Le prenotazioni sono aperte."
    ],
    "fr": [
      "Musique, danse celtique et chants tous ensemble. Repas irlandais: coleslaw, beef in beer, cheese and chocolate cake with custard. Les réservations sont ouvertes."
    ],
    "nl": [
      "Muziek, Keltische dans en samenzang. Ierse maaltijd: koolsla, rundvlees in bier, kaas en chocoladetaart met custard. Boekingen zijn nu open."
    ],
    "es": [
      "Música, bailes y cantos celtas todos juntos. Comida irlandesa: ensalada de col, ternera a la cerveza, queso y tarta de chocolate con natillas. Las reservas ya están abiertas."
    ]
  },
