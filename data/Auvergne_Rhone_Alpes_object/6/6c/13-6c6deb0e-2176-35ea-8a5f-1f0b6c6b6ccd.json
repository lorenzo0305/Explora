  "rdfs:comment": {
    "de": [
      "Samoëns empfängt dieses Jahr eine neue Ausgabe des Criou Blues Rock Festival.\r\nEin geselliges und vibrierendes Treffen, das der Entdeckung, dem Austausch und allen Farben des Blues und Rock gewidmet ist.\r\nAuf dem Programm stehen eine Musikmesse und Konzerte."
    ],
    "en": [
      "Samoëns welcomes a new edition of the Criou Blues Rock Festival.\r\nA friendly, vibrant event dedicated to discovery, sharing and all the colors of blues and rock.\r\nOn the program: music fair and concerts."
    ],
    "it": [
      "Samoëns ospita un'altra edizione del Criou Blues Rock Festival.\r\nÈ un evento amichevole e vivace, dedicato alla scoperta e alla condivisione di tutti i colori del blues e del rock.\r\nIn programma: fiera musicale e concerti."
    ],
    "fr": [
      "Samoëns  accueille cette année une nouvelle édition du Criou Blues Rock Festival.\r\nUn rendez-vous convivial et vibrant, dédié à la découverte, au partage et à toutes les couleurs du blues et du rock.\r\nAu programme : salon de la musique et concerts."
    ],
    "nl": [
      "Samoëns organiseert weer een editie van het Criou Blues Rock Festival.\r\nHet is een gezellig, bruisend evenement, gewijd aan het ontdekken en delen van alle kleuren van blues en rock.\r\nOp het programma: muziekbeurs en concerten."
    ],
    "es": [
      "Samoëns acoge una nueva edición del Festival Criou Blues Rock.\r\nSe trata de un acontecimiento amistoso y vibrante, dedicado a descubrir y compartir todos los colores del blues y el rock.\r\nEn el programa: feria musical y conciertos."
    ]
  },
