  "rdfs:comment": {
    "de": [
      "La R'mize ist ein einladender Ort, der eine Kombination aus Ressourcenspeicher, Begegnungsraum, Kreativität, Kultur, Café und Boutique darstellt. Sie stellt die Werte der Solidarität und der Kreislaufwirtschaft durch die Aufwertung von Gegenständen und die Reduzierung von Abfällen in den Vordergrund."
    ],
    "en": [
      "La R'mize is a welcoming place, combining a ressourcerie, a meeting space, creativity, culture, a café and a boutique. It promotes the values of solidarity and the circular economy through the valorization of objects and the reduction of waste."
    ],
    "it": [
      "La R'mize è un luogo accogliente che combina un centro di riciclaggio, un luogo di incontro, creatività, cultura, un caffè e un negozio. Promuove i valori della solidarietà e dell'economia circolare riciclando gli oggetti e riducendo i rifiuti."
    ],
    "fr": [
      "La R'mize est un lieu accueillant, combinant ressourcerie, espace de rencontres, créativité, culture, café, boutique. Elle met en avant des valeurs de solidarité et d'économie circulaire à travers la valorisation des objets et la réduction des déchets."
    ],
    "nl": [
      "La R'mize is een gastvrije plek die een recyclingcentrum, een ontmoetingsplaats, creativiteit, cultuur, een café en een winkel combineert. Het promoot de waarden van solidariteit en de circulaire economie door voorwerpen te recyclen en afval te verminderen."
    ],
    "es": [
      "La R'mize es un lugar acogedor que combina un centro de reciclaje, un lugar de encuentro, creatividad, cultura, un café y una tienda. Promueve los valores de la solidaridad y la economía circular mediante el reciclaje de objetos y la reducción de residuos."
    ]
  },
