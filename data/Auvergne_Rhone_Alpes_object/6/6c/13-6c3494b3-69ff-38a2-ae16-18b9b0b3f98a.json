  "rdfs:comment": {
    "de": [
      "Fluide Glacière startet wieder seinen Montée Infernale!\r\nNach einer legendären zweiten Auflage findet die Organisation erneut in der Rue Docteur Hospital in Clermont-Ferrand statt, um einen verrückten Tag zu erleben."
    ],
    "en": [
      "Fluide Glacière relaunches its Montée Infernale!\r\nAfter a mythical second edition, the association returns to rue Docteur Hospital in Clermont-Ferrand for a day of madness."
    ],
    "it": [
      "Fluide Glacière rilancia la sua Montée Infernale!\r\nDopo una seconda edizione leggendaria, l'associazione torna in rue Docteur Hospital a Clermont-Ferrand per una giornata di follia."
    ],
    "fr": [
      "Fluide Glacière relance sa Montée Infernale !\r\nAprès une deuxième édition mythique, l’association retrouve la rue Docteur Hospital à Clermont-Ferrand pour une journée de folie."
    ],
    "es": [
      "¡Fluide Glacière relanza su Montée Infernale!\r\nTras una segunda edición legendaria, la asociación vuelve a la rue Docteur Hospital de Clermont-Ferrand para una jornada de locura."
    ],
    "nl": [
      "Fluide Glacière herlanceert zijn Montée Infernale!\r\nNa een legendarische tweede editie is de vereniging terug op de rue Docteur Hospital in Clermont-Ferrand voor een dag vol waanzin."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Montée infernale 3"
    ]
  },
