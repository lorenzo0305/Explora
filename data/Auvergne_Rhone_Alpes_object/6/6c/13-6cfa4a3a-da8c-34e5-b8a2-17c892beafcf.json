  "rdfs:comment": {
    "de": [
      "Dieses originelle und überraschende Figurenmuseum, das in Südfrankreich einzigartig ist, zeigt einen breiten historischen Überblick von der Vorgeschichte bis zur Gegenwart sowie Fantasy. Auch eine temporäre Ausstellung. Thema 2026: 100 Jahre Gosciny."
    ],
    "en": [
      "Original and surprising, this figurine museum, the only one of its kind in the south of France, presents a broad historical panorama from prehistory to the present day, as well as fantasy. Also a temporary exhibition. 2026 theme: 100 years of Gosciny."
    ],
    "it": [
      "Originale e sorprendente, questo museo di figurine, unico nel suo genere nel sud della Francia, presenta un'ampia panoramica della storia, dalla preistoria ai giorni nostri, e della fantasia. C'è anche una mostra temporanea. Tema del 2026: 100 anni di Gosciny."
    ],
    "fr": [
      "Original et surprenant, ce musée de figurines, unique dans le sud de la France, présente un large panorama historique de la Préhistoire à nos jours, ainsi que le Fantastique. Egalement une exposition temporaire. Thème 2026 : Les 100 ans de Gosciny."
    ],
    "es": [
      "Original y sorprendente, este museo de figuritas, único en su género en el sur de Francia, presenta un amplio panorama de la historia, desde la prehistoria hasta nuestros días, así como de la fantasía. También hay una exposición temporal. Tema 2026: 100 años de Gosciny."
    ],
    "nl": [
      "Dit originele en verrassende beeldjesmuseum, het enige in zijn soort in Zuid-Frankrijk, presenteert een breed panorama van de geschiedenis van de prehistorie tot nu, maar ook fantasie. Er is ook een tijdelijke tentoonstelling. Thema 2026: 100 jaar Gosciny."
    ]
  },
