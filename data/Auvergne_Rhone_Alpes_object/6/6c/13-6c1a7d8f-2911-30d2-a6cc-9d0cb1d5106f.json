          "additionalInformation": {
            "de": [
              "Sonntagabend geschlossen.\r\nAn allen anderen Tagen: Mittagsservice bis 13:30 Uhr, Abendservice bis 21:30 Uhr.\r\nJährliche Schließung in der 1. Januarwoche und ab dem 30. Juli für 4 Wochen."
            ],
            "en": [
              "Closed Sunday evening.\r\nAll other days: lunch service until 1:30pm, evening service until 9:30pm.\r\nAnnual closure 1st week of January and from July 30 for 4 weeks."
            ],
            "it": [
              "Chiuso la domenica sera.\r\nTutti gli altri giorni: servizio a pranzo fino alle 13.30, servizio serale fino alle 21.30.\r\nChiusura annuale durante la prima settimana di gennaio e per 4 settimane dal 30 luglio."
            ],
            "fr": [
              "Fermé le dimanche soir.\r\nTous les autres jours : Service du midi jusqu'à 13h30h, service du soir jusqu'à 21h30.\r\nFermeture annuelle  la 1ère semaine de janvier et à partir du 30 juillet pour 4 semaines."
            ],
            "nl": [
              "Gesloten op zondagavond.\r\nAlle andere dagen: lunchdienst tot 13.30 uur, avonddienst tot 21.30 uur.\r\nHet hele jaar gesloten in de 1e week van januari en voor 4 weken vanaf 30 juli."
            ],
            "es": [
              "Cerrado los domingos por la noche.\r\nTodos los demás días: servicio de almuerzo hasta las 13.30 h, servicio de noche hasta las 21.30 h.\r\nCerrado todo el año durante la primera semana de enero y durante 4 semanas a partir del 30 de julio."
            ]
          },
