  "rdfs:comment": {
    "de": [
      "Gérald empfängt Sie mit einer großzügigen und qualitativ hochwertigen Hausmannskost, die in Formeln oder à la carte für jeden Geschmack angeboten wird. Besuchen Sie uns von Dienstag bis Sonntag mittags!"
    ],
    "en": [
      "Gérald welcomes you to his generous, high-quality home cooking, available in formulas or à la carte to suit all tastes. Come and see us from Tuesday to Sunday lunchtime!"
    ],
    "it": [
      "Gérald vi accoglie con la sua cucina casalinga, generosa e di qualità, disponibile in formule o alla carta per tutti i gusti. Venite a trovarci dal martedì alla domenica a pranzo!"
    ],
    "fr": [
      "Gérald vous accueille pour une cuisine maison généreuse et de qualité, déclinée en formules ou à la carte pour tous les goûts. Venez nous retrouver du mardi au dimanche midi !"
    ],
    "es": [
      "Gérald le da la bienvenida a su cocina casera, generosa y de calidad, disponible en fórmulas o a la carta para todos los gustos. ¡Venga a vernos de martes a domingo al mediodía!"
    ],
    "nl": [
      "Gérald heet je welkom in zijn gulle thuiskeuken van hoge kwaliteit, verkrijgbaar in formules of à la carte, voor elk wat wils. Kom langs van dinsdag tot zondagmiddag!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Brasserie Pub 47"
    ]
  },
