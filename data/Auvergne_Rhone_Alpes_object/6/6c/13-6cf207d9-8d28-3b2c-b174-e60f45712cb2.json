  "rdfs:comment": {
    "de": [
      "Der Messerschmied Yann Jouan fertigt seine Messer von A bis Z an und lässt sich dabei von der Umgebung, in der er sich bewegt, inspirieren. Jedes Projekt, das die Werkstatt verlässt, ist ein Unikat."
    ],
    "en": [
      "As a blacksmith and cutler, Yann Jouan creates his knives from A to Z, inspired by the environment in which he works. Each project that leaves the workshop is unique."
    ],
    "it": [
      "Come fabbro e coltellinaio, Yann Jouan crea i suoi coltelli dalla A alla Z, ispirandosi all'ambiente in cui lavora. Ogni progetto che lascia il laboratorio è unico."
    ],
    "fr": [
      "Forgeron coutelier, Yann Jouan réalise ses couteaux de A à Z en s’inspirant du cadre dans lequel il évolue. Chaque projet qui sort de l’atelier est unique."
    ],
    "es": [
      "Como herrero y cuchillero, Yann Jouan crea sus cuchillos de la A a la Z, inspirándose en el entorno en el que trabaja. Cada proyecto que sale del taller es único."
    ],
    "nl": [
      "Als smid en slijper creëert Yann Jouan zijn messen van A tot Z, geïnspireerd door de omgeving waarin hij werkt. Elk project dat de werkplaats verlaat is uniek."
    ]
  },
