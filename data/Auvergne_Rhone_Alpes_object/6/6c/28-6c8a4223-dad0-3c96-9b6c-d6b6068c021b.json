  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/59307d38-53e0-3fda-a21a-6daa2749805a",
      "dc:description": {
        "de": [
          "Kommen Sie an Bord der legendären 2 cv, um das landschaftliche, kulturelle und industrielle Erbe dieser kleinen Ecke Frankreichs zu entdecken.\nMehrere geführte Ausflüge sind möglich."
        ],
        "en": [
          "Get on board the mythical 2CV to discover the landscape, cultural and industrial heritage of this small corner of France.\nSeveral guided tours are available."
        ],
        "it": [
          "Salite a bordo della mitica 2CV per scoprire il patrimonio paesaggistico, culturale e industriale di questo piccolo angolo di Francia.\nSono disponibili diverse opzioni di visita guidata."
        ],
        "fr": [
          "Embarquez à bord de la mythique 2 cv afin de découvrir le patrimoine paysagé, culturel et industriel de ce petit coin de France.\nPlusieurs formule de balade guidée possible."
        ],
        "es": [
          "Suba a bordo del mítico 2CV para descubrir el paisaje y el patrimonio cultural e industrial de este pequeño rincón de Francia.\nExisten varias opciones de visitas guiadas."
        ],
        "nl": [
          "Stap aan boord van de mythische 2CV om het landschap en het culturele en industriële erfgoed van dit kleine hoekje van Frankrijk te ontdekken.\nEr zijn verschillende rondleidingen mogelijk."
        ]
      },
