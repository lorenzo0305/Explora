    "de": [
      "Die Pétanque San Paloune organisiert am 26. Juli 2026 einen Pétanque-Wettbewerb. Er findet auf dem Bouleplatz neben dem Fußballstadion statt."
    ],
    "en": [
      "Pétanque San Paloune is organizing a pétanque competition on July 26, 2026. It will take place at the petanque field next to the soccer stadium."
    ],
    "it": [
      "La Pétanque San Paloune organizza una gara di pétanque il 26 luglio 2026. Si svolgerà sul campo da bocce accanto allo stadio di calcio."
    ],
    "fr": [
      "La Pétanque San Paloune organise un concours de pétanque le 26 juillet 2026. Il aura lieu au terrain de pétanque à côté du stade de foot."
    ],
    "es": [
      "Petanca San Paloune organiza una competición de petanca el 26 de julio de 2026. Tendrá lugar en el campo de petanca situado junto al estadio de fútbol."
