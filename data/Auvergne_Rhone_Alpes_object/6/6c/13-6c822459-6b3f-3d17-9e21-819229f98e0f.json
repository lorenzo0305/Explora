  "rdfs:comment": {
    "de": [
      "Das Restaurant mit seinem edlen, eleganten Rahmen bietet Ihnen eine Küche mit verschiedenen Geschmäckern, deren Einflüsse aus den verschiedenen Mischungen stammen."
    ],
    "en": [
      "A restaurant, in a sleek and elegant setting, which offers a cuisine which perfectly blends the different flavours from all different cooking cultures."
    ],
    "it": [
      "Un ristorante dall'ambiente elegante e ordinato, che propone una cucina che gioca su un mix di sapori le cui influenze derivano da incroci culinari."
    ],
    "fr": [
      "Restaurant au cadre élégant et épuré, qui propose une cuisine jouant sur un mélange de saveurs dont les influences sont puisées dans le métissage culinaire."
    ],
    "es": [
      "Restaurante elegante y minimalista que propone una cocina con mezcla de sabores e influencias del mestizaje culinario."
    ],
    "nl": [
      "Een restaurant met een elegant en overzichtelijk kader, dat een keuken aanbiedt die speelt met een mengeling van smaken waarvan de invloeden afkomstig zijn van culinaire kruisingen."
    ]
  },
