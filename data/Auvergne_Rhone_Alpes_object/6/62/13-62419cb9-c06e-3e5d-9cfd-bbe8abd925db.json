  "rdfs:comment": {
    "de": [
      "Als wahre Oase der Ruhe wird diese Lounge Ihnen einen außergewöhnlichen Aufenthalt bieten. Für das Wohlbefinden der Gäste werden die Türen während der Massagen und Behandlungen geschlossen."
    ],
    "en": [
      "A true haven of serenity, this salon provides exceptional service. For the well-being of clients, and all the better to cosset you, the doors will be closed during massage/treatment sessions."
    ],
    "it": [
      "Nathalie Perez, la vostra estetista, vi offre un momento di coccole in un ambiente unico. Un'oasi di serenità, questo salone si trova nel centro di Pierrelatte (Drôme)."
    ],
    "fr": [
      "Nathalie Perez, votre esthéticienne, vous propose un moment cocooning dans un cadre unique en son genre. Véritable havre de sérénité, ce salon est situé en plein centre ville de Pierrelatte (Drôme)."
    ],
    "es": [
      "Nathalie Perez, su esteticista, le ofrece un momento de recogimiento en un marco único. Un remanso de serenidad en pleno centro de Pierrelatte (Drôme)."
    ],
    "nl": [
      "Deze salon is een ware oase van rust en biedt u uitzonderlijke diensten. Voor het welzijn van onze klanten en om u beter te kunnen omhullen, zijn de deuren tijdens de massages en behandelingen gesloten."
    ]
  },
