  "rdfs:comment": {
    "de": [
      "Ausgabe des CSI*** & * Jumping International de Megève wird wieder auf der Esplanade du Palais stattfinden, um das unumgängliche Ereignis des Sommers zu werden. Sportlichkeit, Geselligkeit, Gaumenfreuden und ein großes Spektakel!"
    ],
    "en": [
      "The 2026 Show Jumping Competition will take up residence one more time on the esplanade of the Sports Centre for THE must-see show of the summer. Sport's spirit, friendliness, delight and big show!"
    ],
    "it": [
      "Per la sua 15a edizione, il Jumping International 2024 si svolgerà sul piazzale del Palais di Megève per l'appuntamento dell'estate."
    ],
    "fr": [
      "Pour sa 15ème édition, le CSI*** & * du Jumping International de Megève prendra à nouveau ses quartiers sur l'esplanade du Palais pour LE rendez-vous incontournable de l'été. Sportivité, convivialité, gourmandise et grand spectacle!"
    ],
    "nl": [
      "Voor zijn 15e editie zal de CSI*** & * Jumping International de Megève opnieuw de esplanade du Palais overnemen voor HET niet te missen evenement van de zomer. Sportiviteit, gezelligheid, lekker eten en geweldige shows!"
    ],
    "es": [
      "En su 15ª edición, el CSI*** & * Jumping International de Megève vuelve a tomar la explanada del Palais para celebrar LA cita ineludible del verano. Deportividad, convivencia, buena comida y grandes espectáculos"
    ]
  },
  "rdfs:label": {
    "en": [
