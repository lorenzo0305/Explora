  "rdfs:comment": {
    "de": [
      "Werksatt, Shop, Kunst und Mode.\nAls Modefan und Künstlerin vereint Little Etoile für seine Designerin zwei Leidenschaften. Malerei auf Leinen, Schmuck, Konfektionskleidung, Schuhe, Taschen & Accessoires."
    ],
    "en": [
      "Art and Fashion Boutique Workshop.\nFashion fan and artist, Little Etoile combines two passions for its creator. Paintings on linen, Jewellery, Ready-to-wear, Shoes, Bags & accessories."
    ],
    "it": [
      "Atelier Boutique Art et Mode.\r\nAppassionata di moda e artista, Little Etoile unisce due passioni per la sua creatrice. Dipinti su lino, Gioielli, Prêt-à-porter, Scarpe, Borse e accessori."
    ],
    "fr": [
      "Atelier Boutique Art et Mode.\r\nFan de mode et artiste, Little Etoile allie deux passions pour sa créatrice. Peintures sur lin, Bijoux, Prêt à porter, Chaussures, Sacs  & accessoires."
    ],
    "nl": [
      "Atelier Boutique Art et Mode.\r\nFashion fan en kunstenaar, Little Etoile combineert twee passies voor de maker. Schilderijen op linnen, Juwelen, Ready to wear, Schoenen, Tassen & accessoires."
    ],
    "es": [
      "Atelier Boutique Art et Mode.\r\nAficionada a la moda y artista, Little Etoile combina dos pasiones para su creadora. Pinturas sobre lino, Joyas, Prêt-à-porter, Zapatos, Bolsos y accesorios."
    ]
  },
