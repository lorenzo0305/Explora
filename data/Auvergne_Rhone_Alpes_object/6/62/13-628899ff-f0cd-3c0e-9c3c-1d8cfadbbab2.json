  "rdfs:comment": {
    "de": [
      "Auf einem Rundgang durch die Viertel Ville Gozet und Fours-à-Chaux können Sie einen Teil der von Pierre Diot entworfenen Bauten wiederentdecken."
    ],
    "en": [
      "Take a tour of the Ville Gozet and Fours-à-Chaux neighborhoods, and rediscover some of the buildings designed by Pierre Diot."
    ],
    "it": [
      "Fate un giro nei quartieri Ville Gozet e Fours-à-Chaux e riscoprite alcuni degli edifici progettati da Pierre Diot."
    ],
    "fr": [
      "À travers un parcours entre les quartiers de la Ville Gozet et des Fours-à-Chaux, venez redécouvrir une partie des constructions signées Pierre Diot."
    ],
    "es": [
      "Recorra los barrios de Ville Gozet y Fours-à-Chaux y redescubra algunos de los edificios diseñados por Pierre Diot."
    ],
    "nl": [
      "Maak een rondleiding door de wijken Ville Gozet en Fours-à-Chaux en herontdek enkele gebouwen die door Pierre Diot zijn ontworpen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite guidée : Découverte de l'architecture Pierre Diot"
    ]
  },
