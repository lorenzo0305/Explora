  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Dolce Via! Zugang von Pont de Chervil in Chalencon, im Tal des Eyrieux. Ebenfalls vor Ort: Trockentoilette, Wasserstelle, Picknicktische, Parkplatz, Fahrradbox zum Aufladen Ihrer Fahrräder (2 bis 4 Fahrräder)."
    ],
    "en": [
      "Discover the Dolce Via! Access from Pont de Chervil in Chalencon, in the Eyrieux valley. Also on site: dry toilets, water point, picnic tables, parking, bike box for recharging your bikes (2 to 4 bikes)."
    ],
    "it": [
      "Scoprite la Dolce Via! Accesso da Pont de Chervil a Chalencon, nella valle di Eyrieux. Sul posto: servizi igienici a secco, punto d'acqua, tavoli da picnic, parcheggio, box per ricaricare le biciclette (da 2 a 4 biciclette)."
    ],
    "fr": [
      "Découvrez la Dolce Via ! Accès depuis Pont de Chervil à Chalencon, dans la vallée de l'Eyrieux. Également sur place : toilettes sèches, point d'eau, tables de pique-nique, parking, vélo box pour recharger vos vélos (2 à 4 vélos)."
    ],
    "es": [
      "¡Descubra la Dolce Via! Acceso desde Pont de Chervil en Chalencon, en el valle de Eyrieux. También in situ: aseos secos, punto de agua, mesas de picnic, aparcamiento, buzón para recargar sus bicicletas (de 2 a 4 bicicletas)."
    ],
    "nl": [
      "Ontdek de Dolce Via! Toegang vanaf Pont de Chervil in Chalencon, in de vallei van Eyrieux. Ook ter plaatse: droge toiletten, waterpunt, picknicktafels, parkeerplaats, fietsenstalling om je fietsen op te laden (2 tot 4 fietsen)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Accès principal de la Dolce Via"
    ]
  },
