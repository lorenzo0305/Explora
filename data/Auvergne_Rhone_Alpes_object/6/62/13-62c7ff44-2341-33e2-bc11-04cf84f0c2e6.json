  "rdfs:comment": {
    "de": [
      "Vermietung eines Mehrzweckraums für Einwohner, alle Personen und für Vereine. Schöner Saal mit Erkerfenster, Tische und Stühle auf Anfrage. Ausgestattete Küche verfügbar, die durch einen elektrischen Rollvorhang vom Mehrzwecksaal getrennt ist."
    ],
    "en": [
      "Rental of multi-purpose hall for residents, individuals and associations. Beautiful room with bay window, tables and chairs on request. Equipped kitchen available, separated from the multi-purpose room by an electric roller curtain."
    ],
    "it": [
      "Sala polivalente in affitto per i residenti, tutte le persone e le associazioni. Bella sala con bovindo, tavoli e sedie su richiesta. Cucina attrezzata a disposizione, separata dalla sala polivalente da una tenda elettrica."
    ],
    "fr": [
      "Location de salle polyvalente pour habitants, toutes personnes et pour les associations. Belle salle avec baie vitrée, tables et chaises sur demande. Cuisine équipée disponible séparée de la salle polyvalente par un rideau roulant électrique."
    ],
    "es": [
      "Sala polivalente de alquiler para los residentes, todas las personas y asociaciones. Bonita habitación con ventanal, mesas y sillas a petición. Cocina equipada disponible, separada de la sala polivalente por una cortina eléctrica."
    ],
    "nl": [
      "Multifunctionele zaal te huur voor bewoners, particulieren en verenigingen. Mooie zaal met erker, tafels en stoelen op aanvraag. Ingerichte keuken beschikbaar, afgescheiden van de polyvalente zaal door een elektrisch rolluik."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Salle polyvalente"
    ]
  },
