  "rdfs:comment": {
    "de": [
      "Sie sind 60 Minuten lang eingesperrt und müssen ein Dutzend Rätsel lösen, um Ihre Mission zu erfüllen und die Geschichte zu verändern.\r\nWerden Sie rechtzeitig zurückkehren?"
    ],
    "en": [
      "Locked in for 60 minutes, you must solve a dozen riddles to complete your mission and change history.\r\nWill you make it back in time?"
    ],
    "it": [
      "Rinchiusi per 60 minuti, dovrete risolvere una dozzina di enigmi per completare la vostra missione e cambiare la storia.\r\nRiuscirete a tornare in tempo?"
    ],
    "fr": [
      "Enfermé pendant 60 minutes, vous devez résoudre une dizaine d'énigmes pour accomplir votre mission et changer l'histoire.\r\nAllez-vous revenir à temps ?"
    ],
    "nl": [
      "Je zit 60 minuten opgesloten en moet een dozijn raadsels oplossen om je missie te voltooien en de geschiedenis te veranderen.\r\nLukt het jou om op tijd terug te zijn?"
    ],
    "es": [
      "Encerrado durante 60 minutos, deberá resolver una docena de enigmas para completar su misión y cambiar la historia.\r\n¿Llegarás a tiempo?"
    ]
  },
