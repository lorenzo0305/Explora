  "rdfs:comment": {
    "de": [
      "Das Fremdenverkehrsamt Ardèche des Sources & Volcans empfängt Sie in seinen 3 Büros in den 3 Dörfern mit Charakter: Meyras, Thueyts und Jaujac. Unser Team berät Sie für einen einzigartigen Aufenthalt in der Ardèche 100% Natur."
    ],
    "en": [
      "The Ardèche des Sources & Volcans Tourist Office welcomes you in its 3 offices in the 3 villages of character: Meyras, Thueyts and Jaujac. Our team advises you for a unique stay in Ardèche 100% nature."
    ],
    "it": [
      "L'Ufficio del Turismo Ardèche des Sources & Volcans vi dà il benvenuto nei suoi 3 uffici nei 3 villaggi di carattere: Meyras, Thueyts e Jaujac. Il nostro team sarà lieto di consigliarvi un soggiorno unico in Ardèche, 100% natura."
    ],
    "fr": [
      "L'Office de Tourisme Ardèche des Sources & Volcans vous reçoit dans ses 3 bureaux dans les 3 villages de caractère : Meyras, Thueyts et Jaujac. Notre équipe vous conseille pour un séjour unique en Ardèche 100% nature."
    ],
    "es": [
      "La Oficina de Turismo de Ardèche des Sources & Volcans le da la bienvenida en sus 3 oficinas situadas en los 3 pueblos con carácter: Meyras, Thueyts y Jaujac. Nuestro equipo estará encantado de aconsejarle sobre una estancia única en Ardèche, 100% naturaleza."
    ],
    "nl": [
      "Het Toeristenbureau van de Ardèche des Sources & Volcans heet u welkom in zijn 3 kantoren in de 3 karaktervolle dorpen: Meyras, Thueyts en Jaujac. Ons team adviseert u graag over een uniek verblijf in de Ardèche, 100% natuur."
    ]
  },
