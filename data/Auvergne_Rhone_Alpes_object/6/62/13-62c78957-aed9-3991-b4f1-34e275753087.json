  "rdfs:comment": {
    "de": [
      "Entdecken Sie unsere Burger, Kebab und für die Feinschmecker unsere frischen Pommes frites!!!!\nVerkauf zum Mitnehmen von Pommes frites, Burgern, Kebab mit Broten der Bäckerei Charles aus Taninges."
    ],
    "en": [
      "Come and discover our burgers, kebabs and, for those with a sweet tooth, our fresh French fries!!!!\nTakeaway fries, burgers and kebabs with bread from Charles de Taninges bakery."
    ],
    "it": [
      "Venite a scoprire i nostri hamburger, kebab e, per i più golosi, le nostre patatine fresche!!!!\nPatatine fritte, hamburger e kebab da asporto con pane del panificio Charles de Taninges."
    ],
    "fr": [
      "Venez découvrir nos burgers, kebabs et pour les gourmands nos frites fraîches!!!!\nVente à emporter frites, burgers, kebabs avec pains de la boulangerie Charles de Taninges."
    ],
    "es": [
      "La Valentine, Food Truck du Giffre le propuesta comida simple de calidad.  Amburguesa, kebabs y papas fritas frescas!!!!"
    ],
    "nl": [
      "Kom en ontdek onze burgers, kebabs en, voor de zoetekauwen, onze verse frietjes!!!!\nAfhaalfrietjes, hamburgers en kebab met brood van bakkerij Charles de Taninges."
    ]
  },
