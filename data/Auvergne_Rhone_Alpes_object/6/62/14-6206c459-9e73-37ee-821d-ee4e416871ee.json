  "rdfs:comment": {
    "de": [
      "Das Pays d'art et d'histoire de Lens-Liévin und die Mediathek von Noyelles-sous-Lens laden Sie zu einem entdeckungsreichen Spaziergang durch das Kulturerbe inmitten spektakulärer Landschaften ein."
    ],
    "en": [
      "The Pays d'art et d'histoire de Lens-Liévin and the media library of Noyelles-sous-Lens offer you a heritage walk full of discoveries in the heart of spectacular landscapes."
    ],
    "it": [
      "Il Pays d'art et d'histoire de Lens-Liévin e la mediateca di Noyelles-sous-Lens vi propongono una passeggiata nel patrimonio attraverso paesaggi spettacolari."
    ],
    "fr": [
      "Le Pays d’art et d’histoire de Lens-Liévin et la médiathèque de Noyelles-sous-Lens vous proposent une promenade patrimoniale riche en découvertes au cœur de paysages spectaculaires."
    ],
    "nl": [
      "Het Pays d'art et d'histoire de Lens-Liévin en de mediatheek van Noyelles-sous-Lens bieden je een erfgoedwandeling door spectaculaire landschappen."
    ],
    "es": [
      "El Pays d'art et d'histoire de Lens-Liévin y la mediateca de Noyelles-sous-Lens le proponen un paseo patrimonial por paisajes espectaculares."
    ]
  },
