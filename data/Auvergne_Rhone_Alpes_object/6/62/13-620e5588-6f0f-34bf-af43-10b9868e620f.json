  "rdfs:comment": {
    "de": [
      "Traditionelle Restauration.\r\n1 Tagesmenü, Vorschläge auf dem Schiefertisch, Savoyer Spezialitäten (auf Reservierung) und Froschschenkel (auf Reservierung).\r\nRuhige und sonnige Terrasse."
    ],
    "en": [
      "Traditionnal food.\r\nAuberge near to boulodrome in LA CHAMBRE\r\nOn the outskirts of the village on the Place du champ de foire, our auberge welcomes guests all year round.Traditional cuisine. 1 daily menu, Savoyard specials and frogs legs."
    ],
    "it": [
      "Ristorante tradizionale.\r\n1 menu del giorno, proposte sulla lavagna, specialità savoiarde (su prenotazione) e cosce di rana (su prenotazione).\r\nTerrazza tranquilla e soleggiata."
    ],
    "fr": [
      "Restauration traditionnelle.\r\n1 menu du jour, Suggestions à l'ardoise, Spécialités savoyardes (sur réservation), et Cuisses de Grenouilles (sur réservation).\r\nTerrasse calme et ensoleillée."
    ],
    "nl": [
      "Traditioneel restaurant.\r\n1 menu van de dag, suggesties op de lei, Savoyaardse specialiteiten (op reservering) en Kikkerbilletjes (op reservering).\r\nRustig en zonnig terras."
    ],
    "es": [
      "Restaurante tradicional.\r\n1 menú del día, sugerencias en la pizarra, especialidades saboyanas (bajo reserva) y ancas de rana (bajo reserva).\r\nTerraza tranquila y soleada."
    ]
  },
  "rdfs:label": {
