  "rdfs:comment": {
    "de": [
      "Die Boule Gennetinoise lädt Sie zu einem geselligen Abend ein, bei dem Sie ein köstliches Eisbein mit Kartoffeln genießen können. Aperitif, Quark, Dessert und Kaffee stehen auf dem Programm. Ein herzlicher Moment, den Sie mit der Familie oder mit Freunden teilen können!"
    ],
    "en": [
      "La Boule Gennetinoise invites you to a convivial evening of delicious ham and potatoes. Aperitif, fromage blanc, dessert and coffee are included. A warm moment to share with family and friends!"
    ],
    "it": [
      "La Boule Gennetinoise vi invita a una serata conviviale a base di delizioso prosciutto e patate. Aperitivo, fromage blanc, dessert e caffè sono nel menu. Un momento caldo da condividere con la famiglia e gli amici!"
    ],
    "fr": [
      "La Boule Gennetinoise vous invite à une soirée conviviale autour d’un délicieux jambonneau accompagné de pommes de terre. Apéritif, fromage blanc, dessert et café au programme. Un moment chaleureux à partager en famille ou entre amis !"
    ],
    "es": [
      "La Boule Gennetinoise le invita a una agradable velada en la que degustará un delicioso jamón con patatas. Aperitivo, queso blanco, postre y café. Un momento cálido para compartir con la familia y los amigos"
    ],
    "nl": [
      "De Boule Gennetinoise nodigt je uit voor een gezellige avond met heerlijke ham en aardappelen. Aperitief, fromage blanc, dessert en koffie staan op het menu. Een warm moment om te delen met familie en vrienden!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Soirée conviviale"
    ]
  },
