  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/1b995b52-ac79-3344-88a7-56c9069577aa",
      "dc:description": {
        "de": [
          "ANNULLIERT, auf einen unbestimmten späteren Zeitpunkt verschoben.\nLe Pont de Singe Production präsentiert Jovany et le dernier saltimbanque (Jovany und der letzte Gaukler).\n\nAm 22. November um 20 Uhr im Familia Théâtre in Berck-sur-Mer.\n\nKartenverkauf in der Touristeninformation."
        ],
        "en": [
          "CANCELLED, postponed indefinitely.\nLe Pont de Singe Production presents Jovany et le dernier saltimbanque.\n\nNovember 22 at 8pm at the Familia Théâtre in Berck-sur-Mer.\n\nTickets on sale at the tourist office."
        ],
        "it": [
          "ANNULLATO, rinviato a data imprecisata.\nLe Pont de Singe Production presenta Jovany et le dernier saltimbanque.\n\n22 novembre alle 20.00 al Familia Théâtre di Berck-sur-Mer.\n\nBiglietti in vendita presso l'ufficio turistico."
        ],
        "fr": [
          "ANNULE, reporté à une date ultérieure indéterminée.\nLe Pont de Singe Production présente Jovany et le dernier saltimbanque.\n\nLe 22 novembre à 20h au Familia Théâtre de Berck-sur-Mer.\n\nBillet en vente à l'office de tourisme."
        ],
        "nl": [
          "Geannuleerd, uitgesteld tot een niet nader genoemde datum.\nLe Pont de Singe Production presenteert Jovany et le dernier saltimbanque.\n\n22 november om 20.00 uur in het Familia Théâtre in Berck-sur-Mer.\n\nKaartjes te koop bij het toeristenbureau."
        ],
        "es": [
          "CANCELADO, aplazado a una fecha indeterminada.\nLe Pont de Singe Production presenta Jovany et le dernier saltimbanque.\n\n22 de noviembre a las 20:00 h en el teatro Familia de Berck-sur-Mer.\n\nVenta de entradas en la oficina de turismo."
        ]
      },
