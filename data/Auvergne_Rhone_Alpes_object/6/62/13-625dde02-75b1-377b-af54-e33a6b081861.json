  "rdfs:comment": {
    "de": [
      "Unser junges und dynamisches Team empfängt Sie in einem idyllischen Rahmen am Ufer des Genfersees. Verbindung von Spezialitäten des Sees und italienischen Gerichten. Magischer Ort für einen Sonnenuntergang über dem See."
    ],
    "en": [
      "Our young, dynamic team welcomes you to an idyllic setting on the shores of Lake Geneva. A combination of lake and Italian specialities. A magical setting for a sunset on the lake."
    ],
    "it": [
      "Il nostro team giovane e dinamico vi accoglie in un ambiente idilliaco sulle rive del Lago di Ginevra. Una combinazione di specialità lacustri e italiane. Una cornice magica per un tramonto sul lago."
    ],
    "fr": [
      "Notre équipe jeune et dynamique vous accueille dans un cadre idyllique au bord du Léman. Mariage de spécialités du lac et italiennes. Endroit magique pour un coucher de soleil sur le lac."
    ],
    "nl": [
      "Ons jonge, dynamische team heet u welkom in een idyllische omgeving aan de oevers van het meer van Genève. Een combinatie van specialiteiten uit het meer en Italië. Een magische omgeving voor een zonsondergang over het meer."
    ],
    "es": [
      "Nuestro equipo joven y dinámico le da la bienvenida en un entorno idílico a orillas del lago Lemán. Una combinación de especialidades lacustres e italianas. Un marco mágico para una puesta de sol sobre el lago."
    ]
  },
