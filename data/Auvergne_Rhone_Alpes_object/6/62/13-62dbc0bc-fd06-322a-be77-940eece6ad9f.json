  "rdfs:comment": {
    "de": [
      "Entdeckungsreise zu neuen Geschmackserlebnissen\r\nJack Dupuich, ein namhafter Restaurantbesitzer in der Stadt Annemasse, bereitet in seinem Restaurant Le Bérénice bereits seit einigen Jahren Risottos zu."
    ],
    "en": [
      "In his search for new flavours, Jack Dupuich, a well-known restaurateur in Annemasse has already been cooking risottos in his restaurant 'Le Bérénice' for many years."
    ],
    "it": [
      "Jack&Sarah's Risotteria, un ristorante dove si possono mangiare risotti bistronomici fatti in casa!"
    ],
    "fr": [
      "La Risotteria de Jack&Sarah, un restaurant où on mange des Risottos Bistronomiques fait maison!"
    ],
