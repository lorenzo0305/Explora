  "rdfs:comment": {
    "de": [
      "La Belle du Pirate und Créaly eröffnen ihre Boutique.\r\nBoutique de créateurs, ein Bereich, der dem Kunsthandwerk gewidmet ist: handgefertigter Schmuck und Textilien, die personalisiert werden können, Einzelstücke oder Kleinserien sowie Kinderbücher."
    ],
    "en": [
      "La Belle du Pirate and Créaly open their boutique.\r\nBoutique de créateurs, a space dedicated to crafts: handmade jewelry and textiles, customizable, one-off pieces or small series, and children's books."
    ],
    "it": [
      "La Belle du Pirate e Créaly aprono la loro boutique.\r\nBoutique de créateurs, uno spazio dedicato all'artigianato: gioielli e tessuti fatti a mano, personalizzabili, pezzi unici o piccole serie, e libri per bambini."
    ],
    "fr": [
      "La Belle du Pirate et Créaly ouvrent leur boutique.\r\nBoutique de créateurs, un espace dédié à l'artisanat : bijoux et textile fait-main, personnalisables, pièces uniques ou petites séries, et livres pour enfants."
    ],
    "es": [
      "La Belle du Pirate y Créaly abren su boutique.\r\nBoutique de créateurs, un espacio dedicado a la artesanía: joyas y textiles hechos a mano, personalizables, piezas únicas o pequeñas series, y libros infantiles."
    ],
    "nl": [
      "La Belle du Pirate en Créaly openen hun boetiek.\r\nBoutique de créateurs, een ruimte gewijd aan ambachten: handgemaakte sieraden en textiel, op maat gemaakte, eenmalige stukken of kleine series, en kinderboeken."
    ]
  },
