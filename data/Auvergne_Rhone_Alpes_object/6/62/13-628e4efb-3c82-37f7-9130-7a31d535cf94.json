  "rdfs:comment": {
    "de": [
      "Jean-Sébastien und Anthony begrüßen Sie in ihrem Gourmet-Restaurant mit raffinierter Küche. Terrasse mit Blick auf die Aravis-Kette, gute Weinkarte. Mittagsmenü des Tages."
    ],
    "en": [
      "Jean-Sébastien and Anthony welcome you to their gourmet restaurant, sophisticated cuisine. Terrace overlooking the Aravis mountains, beautiful wine card.Take-away. Daily lunch menu."
    ],
    "it": [
      "Jean-Sébastien e Anthony vi danno il benvenuto nel loro ristorante gourmet dalla cucina raffinata. Terrazza con vista sulla catena montuosa degli Aravis, bella carta dei vini. Pasti da asporto. Menu giornaliero a pranzo."
    ],
    "fr": [
      "Jean-Sébastien et Anthony vous reçoivent dans leur restaurant gourmand, cuisine raffinée. Terrasse avec vue sur la chaîne des Aravis, belle carte de vins. Plats à emporter. Menu du jour les midis."
    ],
    "es": [
      "Jean-Sébastien y Anthony le dan la bienvenida a su restaurante gastronómico de cocina refinada. Terraza con vistas a la cordillera de Aravis, bonita carta de vinos. Comidas para llevar. Menú diario a la hora de comer."
    ],
    "nl": [
      "Jean-Sébastien en Anthony heten u welkom in hun gastronomisch restaurant met zijn verfijnde keuken. Terras met uitzicht op het Aravis-gebergte, mooie wijnkaart. Afhaalmaaltijden. Dagelijks menu tijdens de lunch."
    ]
  },
  "rdfs:label": {
