  "rdfs:comment": {
    "de": [
      "Willkommen bei Marie-Pierre und Jérémy Savel: ein leidenschaftliches Duo, das sich in Polminhac, im Cantal, niedergelassen hat. Jérémy ist Fotograf, Marie-Pierre Rahmenmacherin. Gemeinsam haben sie einen einzigartigen Ort geschaffen, der sich über drei Etagen erstreckt und viel Raum für Inspiration bietet."
    ],
    "en": [
      "Welcome to Marie-Pierre and Jérémy Savel: a passionate duo based in Polminhac, Cantal. Jérémy is a photographer, Marie-Pierre a framer. Together, they have created a unique place that spans 3 floors, offering a vast space for inspiration."
    ],
    "it": [
      "Benvenuti nella casa di Marie-Pierre e Jérémy Savel: un duo di appassionati con sede a Polminhac, nella regione del Cantal, in Francia. Jérémy è un fotografo, Marie-Pierre un corniciaio. Insieme, hanno creato un luogo unico che si estende su 3 piani, offrendo un vasto spazio per l'ispirazione."
    ],
    "fr": [
      "Bienvenue chez Marie-Pierre et Jérémy Savel : un duo de passionnés installés à Polminhac, dans le Cantal. Jérémy photographe, Marie-Pierre encadreuse. Ensemble, ils ont créé un lieu unique qui s’étend sur 3 étages, offrant un vaste espace d’inspiration."
    ],
    "nl": [
      "Welkom bij Marie-Pierre en Jérémy Savel: een gepassioneerd duo uit Polminhac, in de Cantal-streek van Frankrijk. Jérémy is fotograaf, Marie-Pierre lijstenmaker. Samen hebben ze een unieke plek gecreëerd die 3 verdiepingen beslaat en een enorme ruimte voor inspiratie biedt."
    ],
    "es": [
      "Bienvenido a la casa de Marie-Pierre y Jérémy Savel: un dúo apasionado afincado en Polminhac, en la región francesa de Cantal. Jérémy es fotógrafo y Marie-Pierre enmarcadora. Juntos han creado un lugar único que ocupa 3 plantas y ofrece un amplio espacio para la inspiración."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Marie-Pierre & Jérémy SAVEL Photographie et Encadrement"
    ]
  },
