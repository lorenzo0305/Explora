  "rdfs:comment": {
    "de": [
      "Der Jardin de la Baudière empfängt Sie seit 1993 an einem atypischen und entrückten Ort. Probieren Sie unter anderem seine berühmten Pizzas aus dem Holzofen."
    ],
    "en": [
      "Since 1993, the Jardin de la Baudière has been welcoming you to an unusual and exotic setting. Come and sample our famous wood-fired pizzas."
    ],
    "it": [
      "Dal 1993, il Jardin de la Baudière vi accoglie in un ambiente insolito ed esotico. Venite a gustare le nostre famose pizze cotte a legna."
    ],
    "fr": [
      "Le jardin de la Baudière vous accueille depuis 1993 dans un lieu atypique et dépaysant. Venez déguster entre autres ses fameuses Pizzas au feux de bois."
    ],
    "nl": [
      "Sinds 1993 verwelkomt de Jardin de la Baudière je in een ongewone en exotische omgeving. Kom en probeer onze beroemde houtovenpizza's."
    ],
    "es": [
      "Desde 1993, el Jardin de la Baudière le acoge en un marco insólito y exótico. Venga a probar nuestras famosas pizzas al horno de leña."
    ]
  },
