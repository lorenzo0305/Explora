  "rdfs:comment": {
    "de": [
      "Der Besuch von MuséAl, dem Museum und der archäologischen Stätte von Alba-la-Romaine, ist eine wahre Zeitreise in die gallo-römische Epoche und zeigt die Hauptstadt des Volkes der Helvianer."
    ],
    "en": [
      "Travel back in time to Gallo-Roman Ardèche when you visit the museum and the archaeological site in Alba-la-Romaine!"
    ],
    "it": [
      "La visita al MuséAl, il museo e il sito archeologico di Alba-la-Romaine, è un viaggio nel tempo fino all'epoca gallo-romana e alla capitale degli Elvezi."
    ],
    "fr": [
      "La visite de MuséAl, musée et site archéologique d'Alba-la-Romaine, est un véritable voyage pour remonter le temps jusqu'à l'époque gallo-romaine et découvrir la capitale du peuple des Helviens."
    ],
    "es": [
      "La visita al MuséAl, museo y yacimiento arqueológico de Alba-la-Romaine, es un viaje en el tiempo a la época galo-romana y a la capital del pueblo helviano."
    ],
    "nl": [
      "Een bezoek aan het museum en de archeologische site van Alba la Romaine is werkelijk een reis naar het verleden, terug naar de Gallo-Romaanse tijd."
    ]
  },
