  "rdfs:comment": {
    "de": [
      "Das Spa d'Allevard empfängt Sie in seinem ganz der Entspannung gewidmeten Bereich mit einem schlichten Dekor, das von Natürlichkeit geprägt ist. Hier finden Sie einen Entspannungsbereich und einen Fitnessbereich."
    ],
    "en": [
      "Allevard-les-Bains' spa offers a space entirely dedicated to your well-being. You will find relaxation and fitness areas, as well as a jacuzzi, a hammam, and a tearoom where you can unwind with herbal tea while enjoying the view of the Thermal Park."
    ],
    "it": [
      "La Spa d'Allevard vi accoglie in uno spazio interamente dedicato al relax, con un arredamento puro e naturale. Troverete un'area relax e un'area fitness."
    ],
    "fr": [
      "Le spa d'Allevard vous accueille dans son espace entièrement dédié à la détente au décor épuré, empreint de naturalité. Vous y trouverez un Espace Détente et un Espace Forme."
    ],
    "es": [
      "El Spa d'Allevard le da la bienvenida a un espacio totalmente dedicado a la relajación, con una decoración pura y natural. Encontrará una zona de relajación y una zona de fitness."
    ],
    "nl": [
      "De Allevard spa verwelkomt je op 360 m2 volledig gewijd aan je welzijn. Je vindt er een ontspanningsruimte en een fitnessruimte."
    ]
  },
