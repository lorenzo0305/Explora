  "rdfs:comment": {
    "de": [
      "4*-Hotel und Restaurant in einem authentischen und geselligen Rahmen im Herzen von Beaufort. Genießen Sie einen Aufenthalt, der Komfort und qualitativ hochwertige Dienstleistungen verbindet. Ausgestattet mit einem Spa, Hammam, Sauna, Seminarraum, Salon, Bar, um Ihren Aufenthalt so angenehm wie möglich zu gestalten."
    ],
    "en": [
      "Hotel restaurant  in an authentic and friendly setting in the heart of the village of Beaufort. Open in summer and winter. Come and enjoy the spa, hammam, sauna, seminar room, lounge, bar, quality catering. See you soon!"
    ],
    "it": [
      "Hotel e ristorante a 4 stelle in un ambiente autentico e accogliente nel cuore di Beaufort. Godetevi un soggiorno che unisce comfort e servizi di qualità. Dotato di spa, hammam, sauna, sala seminari, lounge e bar per rendere il vostro soggiorno il più piacevole possibile."
    ],
    "fr": [
      "Hôtel 4* et restaurant dans un cadre authentique et convivial au cœur de Beaufort. Profitez d’un séjour alliant confort et services de qualité. Equipé d'un spa, hammam, sauna, salle de séminaire, salon, bar pour rendre votre séjour des plus agréables."
    ],
    "es": [
      "Hotel y restaurante de 4 estrellas en un marco auténtico y acogedor en el corazón de Beaufort. Disfrute de una estancia que combina confort y servicios de calidad. Equipado con spa, hammam, sauna, sala de seminarios, salón y bar para que su estancia sea lo más agradable posible."
    ],
    "nl": [
      "4 * Hotel en restaurant in een authentieke en vriendelijke omgeving in het hart van Beaufort. Geniet van een verblijf dat comfort en kwaliteitsdiensten combineert. Uitgerust met een spa, hamam, sauna, seminarruimte, lounge, bar om uw verblijf zo aangenaam mogelijk te maken."
    ]
  },
