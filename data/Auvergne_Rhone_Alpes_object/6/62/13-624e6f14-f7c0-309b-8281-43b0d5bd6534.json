  "rdfs:comment": {
    "de": [
      "Landwirtschaftlicher Familienbetrieb in den Bergen, der sich auf 1500 m Höhe in dem kleinen Weiler Montdenis befindet. Hier leben Tarine- und Abondance-Kühe glücklich und friedlich in einer atemberaubenden Landschaft."
    ],
    "en": [
      "Family mountain farm nestled high in the small village of Montdenis. The cows live there happily and peacefully. Producer of Beaufort and Savoie IGP raclette."
    ],
    "it": [
      "Un'azienda agricola di montagna a conduzione familiare situata a 1.500 m di altitudine nella piccola frazione di Montdenis. Le mucche Tarine e Abundance vivono lì felici e tranquille in un contesto mozzafiato."
    ],
    "fr": [
      "Exploitation agricole de montagne familiale nichée à 1 500 m d'altitude dans le petit hameau de Montdenis. Vaches tarines et abondances y vivent heureuses et paisibles dans un décor à couper le souffle."
    ],
    "es": [
      "Una granja familiar de montaña situada a 1.500 m de altitud en la pequeña aldea de Montdenis. Las vacas Tarine y Abundance viven allí felices y tranquilas en un entorno impresionante."
    ],
    "nl": [
      "Een familiale bergboerderij genesteld op 1.500 m hoogte in het kleine gehucht Montdenis. Tarine en Overvloed koeien leven hier gelukkig en vredig in een adembenemende omgeving."
    ]
  },
  "rdfs:label": {
