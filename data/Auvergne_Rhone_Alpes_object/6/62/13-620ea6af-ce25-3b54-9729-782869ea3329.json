  "rdfs:comment": {
    "de": [
      "Das als Einladung gedachte Restaurant Epithèque bietet ein originelles polysensorisches Erlebnis, Geschmäcker, Texturen und Empfindungen, die alle Sinne und alle Generationen ansprechen."
    ],
    "en": [
      "Designed as an invitation, the Epithèque restaurant offers an original multi-sensory experience, with flavors, textures and sensations that appeal to all senses and all generations."
    ],
    "it": [
      "Concepito come un invito, il ristorante Epithèque offre un'originale esperienza multisensoriale, con sapori, consistenze e sensazioni che attraggono tutti i sensi e tutte le generazioni."
    ],
    "fr": [
      "Pensé comme une invitation, le restaurant Epithèque propose une expérience polysensorielle originale, des saveurs, des textures, des sensations qui touchent tout les sens et toutes les générations."
    ],
    "nl": [
      "Het restaurant Epithèque is ontworpen als een uitnodiging en biedt een originele multisensoriële ervaring, met smaken, texturen en sensaties die alle zintuigen en alle generaties aanspreken."
    ],
    "es": [
      "Concebido como una invitación, el restaurante Epithèque ofrece una experiencia multisensorial original, con sabores, texturas y sensaciones que apelan a todos los sentidos y a todas las generaciones."
    ]
  },
