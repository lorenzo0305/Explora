  "rdfs:comment": {
    "de": [
      "Das Aux 5 bietet Ihnen eine traditionelle, hausgemachte Küche in einer angenehmen Umgebung. Das Menü ist einfach und lecker und das Preis-Leistungs-Verhältnis ist sehr gut."
    ],
    "en": [
      "Oasis Restaurant offers traditional homemade cuisine in a pleasant setting. The menu is simple and gourmet and the value for money is very good."
    ],
    "it": [
      "Aux 5 offre una cucina casalinga tradizionale in un ambiente piacevole. Il menu è semplice e delizioso e il rapporto qualità-prezzo è molto buono."
    ],
    "fr": [
      "Aux 5 vous propose une cuisine traditionnelle faîte maison dans un cadre agréable. Le menu est simple et gourmand et le rapport qualité prix très correct."
    ],
    "es": [
      "Aux 5 ofrece cocina casera tradicional en un entorno agradable. El menú es sencillo y delicioso, y la relación calidad-precio es muy buena."
    ],
    "nl": [
      "Aux 5 biedt een traditionele keuken in een aangename omgeving. Het menu is eenvoudig en heerlijk, en de prijs-kwaliteitverhouding is erg goed."
    ]
  },
