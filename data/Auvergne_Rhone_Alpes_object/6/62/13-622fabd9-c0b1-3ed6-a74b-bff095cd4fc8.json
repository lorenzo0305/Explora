  "rdfs:comment": {
    "de": [
      "Eine gemütliche und einladende Dorfbar mit Restaurant, in der Sie eine gute Zeit verbringen werden!\r\nHausgemachte Küche mit frischen Produkten, lokale Getränke und eine Auswahl an natürlichen Weinen."
    ],
    "en": [
      "Have a great time in a friendly atmosphere in our town bar-restaurant. Home cooking from fresh products, served with local beverages and a selection of natural wines."
    ],
    "it": [
      "Un bar-ristorante di paese, caldo e accogliente, dove vi divertirete sicuramente!\r\nCucina casalinga con prodotti freschi, bevande locali e una selezione di vini naturali."
    ],
    "fr": [
      "Un bar-restaurant de village, chaleureux et accueillant, où vous passerez un bon moment !\r\nCuisine maison avec des produits frais, boissons locales et sélection de vins naturels."
    ],
    "es": [
      "Un cálido y acogedor bar-restaurante de pueblo donde seguro que lo pasarás en grande\r\nCocina casera con productos frescos, bebidas locales y una selección de vinos naturales."
    ],
    "nl": [
      "Een warm en gastvrij dorpsbar-restaurant waar je het zeker naar je zin zult hebben!\r\nHuisgemaakte gerechten met verse producten, lokale dranken en een selectie natuurlijke wijnen."
    ]
  },
