      "dc:description": {
        "de": [
          "Informationen :\n\nMenü: Besuchen Sie die Facebook-Seite, um zu erfahren, welche Artikel zum Verkauf stehen\n\n\nBestellung:\nVia messenger\n\nAbholung:\nIhr Zeitfenster wird bei der Bestellung festgelegt. Abholung im Geschäft.\n\n "
        ],
        "en": [
          "Information :\n\nMenu: Visit the Facebook page to see what's on sale\n\n\nOrdering:\nVia messenger\n\nCollection:\nYour pick-up slot will be defined when you place your order. In-store pickup.\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nMenu: Visita la pagina Facebook per vedere i prodotti in vendita\n\n\nOrdini:\nTramite messenger\n\nRitiro:\nLa fascia oraria sarà definita al momento dell'ordine. Ritiro in negozio.\n\n "
        ],
        "fr": [
          "Informations :\n\nMenu : Consultez la page Facebook pour connaitre les articles en vente\n\n\nCommande :\nVia messenger\n\nRetrait :\nVotre créneau sera défini lors de la commande. Retrait en magasin.\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nMenu: Bezoek de Facebook-pagina om te zien wat er te koop is\n\n\nBestellen:\nVia messenger\n\nOphalen:\nJe tijdslot wordt bepaald wanneer je bestelt. Afhalen in de winkel.\n\n "
        ],
        "es": [
          "Más información :\n\nMenú: Visita la página de Facebook para ver lo que está a la venta\n\n\nPedidos:\nVía messenger\n\nRecogida:\nSu franja horaria se definirá al realizar el pedido. Recogida en tienda.\n\n "
        ]
      },
