  "rdfs:comment": {
    "de": [
      "Bio-Honig aus den Bergen, andere Honige, Pollen, Lebkuchen... Verkauf beim Erzeuger und in der \"halle fermière\" in Le Mazet-St-Voy."
    ],
    "en": [
      "Organic mountain honey, other honeys, pollen, gingerbread... Sales at the producer's and at the farm hall in Mazet-St-Voy."
    ],
    "it": [
      "Miele di montagna biologico, altri mieli, polline, panpepato... Disponibile presso il produttore e presso la sala della fattoria di Mazet-St-Voy."
    ],
    "fr": [
      "Miel Bio de montagne, autres miels, pollen, pain d'épices... Vente chez le producteur et à la halle fermière au Mazet-St-Voy."
    ],
    "es": [
      "Miel ecológica de montaña, otras mieles, polen, pan de especias... Disponible a través del productor y en el salón de la granja de Mazet-St-Voy."
    ],
    "nl": [
      "Biologische berghoning, andere honingsoorten, stuifmeel, peperkoek... Verkrijgbaar bij de producent en in de boerderijhal in Mazet-St-Voy."
    ]
