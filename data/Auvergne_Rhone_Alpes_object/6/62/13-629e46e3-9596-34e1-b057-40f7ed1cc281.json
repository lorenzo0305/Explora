  "rdfs:comment": {
    "de": [
      "Eine Cross Country-Route durch die Almen von Champagny mit atemberaubender Aussicht auf die Gletscher der Vanoise. \r\nDie Strecke ist für regelmäßige Mountainbiker geeignet."
    ],
    "en": [
      "Departure point: Top of Champagny gondola\r\nA cross-country route through the mountain pastures of Champagny with breathtaking views of the Vanoise glaciers.\r\nSuitable for regular mountain bikers."
    ],
    "it": [
      "Un percorso cross-country attraverso gli alpeggi di Champagny con una vista mozzafiato sui ghiacciai della Vanoise.\r\nAdatto a chi pratica regolarmente la mountain bike."
    ],
    "fr": [
      "Un itinéraire Cross Country à travers les alpages de Champagny avec vue imprenable sur les glaciers de la Vanoise. \r\nCircuit adapté aux pratiquants réguliers de VTT."
    ],
    "es": [
      "Ruta campo a través por los pastos de montaña de Champagny con impresionantes vistas de los glaciares de la Vanoise.\r\nApto para ciclistas de montaña habituales."
    ],
    "nl": [
      "Een Cross Country route door de bergweiden van Champagny met een adembenemend uitzicht op de gletsjers van de Vanoise.\r\nGeschikt voor regelmatige mountainbikers."
    ]
  },
