  "rdfs:comment": {
    "de": [
      "Ein \"offener\" Bauernhof, um Sie zu empfangen! Neben dem Restaurantbetrieb in unserer Bauernherberge können Sie auch unsere verschiedenen Workshops entdecken (Imkerei, Gemüseanbau, Obstgarten, Geflügelzucht, Herberge)."
    ],
    "en": [
      "An \"open\" farm to welcome you! In addition to catering at our country inn, discover our various workshops (beekeeping, market gardening, orchard, poultry farming, inn)."
    ],
    "it": [
      "Una fattoria \"aperta\" per accogliervi! Oltre a mangiare nella nostra locanda di campagna, scoprite i nostri diversi laboratori (apicoltura, orticoltura, frutteto, allevamento di pollame, locanda)."
    ],
    "fr": [
      "Une ferme \"ouverte\" pour vous accueillir ! En plus de l'activité restauration à notre auberge paysanne, découvrez nos divers ateliers (apiculture, maraîchage, verger, élevage de volailles, auberge)."
    ],
    "es": [
      "¡Una granja \"abierta\" para recibirle! Además de comer en nuestra posada rural, descubra nuestros diversos talleres (apicultura, horticultura, huerto, avicultura, posada)."
    ],
    "nl": [
      "Een \"open\" boerderij om u te verwelkomen! Ontdek naast het eten in onze landelijke herberg ook onze verschillende workshops (bijenteelt, tuinieren, boomgaard, pluimveehouderij, herberg)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Table de Vailhac"
    ]
  },
