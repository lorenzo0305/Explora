  "rdfs:comment": {
    "de": [
      "Nach einer Zeit, in der du die Vegetation des Gartens kennen lernst, kannst du kleine Blumengirlanden aus Abfallmaterialien herstellen."
    ],
    "en": [
      "After discovering the garden's vegetation, come and make flower garlands from recycled materials."
    ],
    "it": [
      "Dopo aver scoperto la vegetazione del giardino, venite a creare piccole ghirlande di fiori con materiali riciclati."
    ],
    "fr": [
      "Après un temps de découverte de la végétation du jardin, viens fabriquer des petites guirlandes de fleurs en matériaux de récupération."
    ],
    "nl": [
      "Kom na het ontdekken van de vegetatie in de tuin bloemenslingers maken van gerecycled materiaal."
    ],
