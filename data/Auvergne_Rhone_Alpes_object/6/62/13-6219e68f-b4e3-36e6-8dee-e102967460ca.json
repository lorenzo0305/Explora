  "rdfs:comment": {
    "de": [
      "Im Süden des Puy-de-Dôme gab es in der Auvergne ein bedeutendes Bergbaugebiet. Der Standort Bayard in der Gemeinde Brassac-les-Mines konzentriert ein schönes Zeugnis dieses Bergbauerbes."
    ],
    "en": [
      "In the south of the Puy-de-Dôme, Auvergne has had a large mining basin. The Bayard site in the commune of Brassac-les-Mines is a fine example of this mining heritage."
    ],
    "it": [
      "A sud del Puy-de-Dôme, l'Alvernia ha conosciuto un importante bacino minerario. Il sito di Bayard, nel comune di Brassac-les-Mines, è un ottimo esempio di questo patrimonio minerario."
    ],
    "fr": [
      "Au Sud du Puy-de-Dôme, l'Auvergne a connu un important bassin minier. Le site de Bayard sur la commune de Brassac-les-Mines concentre un beau témoignage de ce patrimoine minier."
    ],
    "nl": [
      "In het zuiden van de Puy-de-Dôme heeft de Auvergne een belangrijk mijnbekken gekend. De site van Bayard in de gemeente Brassac-les-Mines is een mooi voorbeeld van dit mijnbouwerfgoed."
    ],
    "es": [
      "Al sur del Puy-de-Dôme, la Auvernia ha conocido una importante cuenca minera. El yacimiento de Bayard, en el municipio de Brassac-les-Mines, es un buen ejemplo de este patrimonio minero."
    ]
  },
  "rdfs:label": {
    "en": [
      "Bayard Mine Tile"
    ],
    "fr": [
      "Carreau de la mine de Bayard"
    ]
  },
