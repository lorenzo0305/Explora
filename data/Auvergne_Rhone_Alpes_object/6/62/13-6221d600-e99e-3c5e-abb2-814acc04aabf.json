  "rdfs:comment": {
    "de": [
      "Ob mit der Familie, mit Freunden, Kollegen oder Verliebten, wir teilen mit Ihnen eine hausgemachte Küche, die aus frischen Produkten zubereitet wird."
    ],
    "en": [
      "With family, friends, colleagues or lovers, we share with you a home-cooked cuisine, elaborated with fresh products."
    ],
    "it": [
      "Con la famiglia, gli amici, i colleghi o gli amanti, condividiamo con voi una cucina casalinga, preparata con prodotti freschi."
    ],
    "fr": [
      "En famille, entre amis, entre collègues ou en amoureux, nous partageons avec vous une cuisine maison, élaborée avec des produits frais."
    ],
    "nl": [
      "Met familie, vrienden, collega's of geliefden delen wij met u een huisgemaakte keuken, bereid met verse producten."
    ],
    "es": [
      "Con la familia, los amigos, los colegas o los amantes, compartimos con usted una cocina casera, preparada con productos frescos."
    ]
  },
