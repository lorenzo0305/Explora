  "rdfs:comment": {
    "de": [
      "Ein Kokon des Wohlbefindens, der sich zur Wasserwelt des Espace Plage hin öffnet. Hier erwarten Sie drei Whirlpools, drei Saunen und ein Hammam für maximale Entspannung."
    ],
    "en": [
      "A cocoon of well-being opening onto the aquatic world of the Espace Plage. Three jacuzzis, three saunas and a steam room await you for maximum relaxation."
    ],
    "it": [
      "Un bozzolo di benessere aperto sul mondo acquatico dell’Espace Plage. Tre vasche idromassaggio, tre saune e un hammam vi aspettano per il massimo relax."
    ],
    "fr": [
      "Un cocon de bien-être ouvert sur l’univers aquatique de l’Espace Plage. Ce sont trois jacuzzis, trois saunas et un hammam qui vous attendent pour un maximum de relaxation."
    ],
    "es": [
      "Un capullo de bienestar que se abre al mundo acuático del Espace Plage. Tres jacuzzis, tres saunas y un baño turco le esperan para ofrecerle la máxima relajación."
    ],
    "nl": [
      "Een cocon van welzijn die uitkomt op de waterwereld van het Espace Plage. Drie jacuzzi's, drie sauna's en een stoombad wachten op je voor maximale ontspanning."
    ]
  },
  "rdfs:label": {
