  "rdfs:comment": {
    "de": [
      "Eine exklusive Tour, die Ihnen die Türen zu einer Auswahl der schönsten Häuser der Altstadt öffnet. Erfahren Sie mehr über die Geschichte Valencias durch die Entwicklung der architektonischen Stile in diesen schönen Häusern."
    ],
    "en": [
      "An exclusive tour that opens the doors to a selection of the finest residences in the old town. Share the history of Valencia through the evolution of the architectural styles of these beautiful homes."
    ],
    "it": [
      "Un tour esclusivo che vi aprirà le porte di una selezione delle più belle residenze del centro storico. Condividerete la storia di Valencia attraverso l'evoluzione degli stili architettonici di queste splendide case."
    ],
    "fr": [
      "Une visite exclusive qui vous ouvrira les portes d’une sélection de demeures, parmi les plus belles de la vieille ville. Un partage de l’histoire de Valence à travers l’évolution des styles architecturaux de ces belles demeures."
    ],
    "es": [
      "Un recorrido exclusivo que le abrirá las puertas de una selección de las mejores residencias del casco antiguo. Compartirá la historia de Valencia a través de la evolución de los estilos arquitectónicos de estas hermosas casas."
    ],
    "nl": [
      "Een exclusieve tour die de deuren opent naar een selectie van de mooiste woningen in de oude stad. Je deelt de geschiedenis van Valencia door de evolutie van de architectonische stijlen van deze prachtige huizen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite guidée : Les belles demeures"
    ]
  },
