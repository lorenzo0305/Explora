  "rdfs:comment": {
    "de": [
      "Verkauf von kreolischen Lebensmitteln und Tiefkühlprodukten sowie Kunsthandwerk aus Madagaskar\r\nVerkauf zum Mitnehmen oder vor Ort Schalen Samoussas, Bouchons Réunionnais, Chili-Bonbons, überbackenes und amerikanisches Korkenbrot. Verzehr von Getränken vor Ort oder zum Mitnehmen."
    ],
    "en": [
      "Sale of Creole food products and frozen foods and handicrafts from Madagascar\r\nOn-site and takeaway sales of samoussas, Reunion bouchons, pimento sweets, gratinéed and American bread bouchons. On-site consumption or takeaway of drinks."
    ],
    "it": [
      "Vendita di prodotti alimentari creoli, surgelati e artigianali del Madagascar\r\nSamoussas, torte della Reunion, dolci al peperoncino, torte gratinate e torte americane da asporto o da mangiare. Bevande disponibili per il consumo interno o da asporto."
    ],
    "fr": [
      "Vente de produits alimentaires et surgelés créoles et artisanat de Madagascar\r\nVente à emporter ou sur place barquettes samoussas, bouchons réunionnais, bonbons piment, pain bouchon gratiné et américain. Consommation sur place ou à emporter de boissons."
    ],
    "nl": [
      "Verkoop van Creoolse levensmiddelen en diepvriesproducten en kunstnijverheid uit Madagaskar\r\nSamoussas, Reunionese taarten, chilisnoepjes, gegratineerde taarten en Amerikaanse taarten om mee te nemen of om te eten. Drankjes om mee te nemen of om mee te nemen."
    ],
    "es": [
      "Venta de productos alimentarios criollos y congelados y artesanía de Madagascar\r\nVenta para llevar e in situ de samoussas, pasteles de Reunión, dulces de guindilla, gratinados y pasteles americanos. Bebidas disponibles para comer en el establecimiento o para llevar."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ô Ti Soleil"
    ]
  },
