  "rdfs:comment": {
    "de": [
      "Valérie LE METAYER, Fayence-Malerin.\r\nHandwerklich hergestellte Fayence, mit Pinsel auf Rohglasur dekoriert.\r\n1985 gegründetes Atelier, spezialisiert auf die Grand-Feu-Technik. Traditionelle Dekore aus Dauphinois und Kreationen.\r\nHommagen an H.Berlioz und JB Jongkind."
    ],
    "en": [
      "Valérie LE METAYER, earthenware painter.\r\nBrush-decorated earthenware on raw glaze.\r\nWorkshop founded in 1985, specializing in the Grand Feu technique. Traditional Dauphin decorations and creations.\r\nTributes to H.Berlioz and JB Jongkind."
    ],
    "it": [
      "Valérie LE METAYER, pittrice di terracotta.\r\nTerracotta artigianale decorata a pennello su smalto grezzo.\r\nLaboratorio fondato nel 1985, specializzato nella tecnica Grand Feu. Disegni e creazioni tradizionali del Delfinato.\r\nOmaggi a H.Berlioz e JB Jongkind."
    ],
    "fr": [
      "Valérie LE METAYER, peintre en faïence.\r\nFaïence artisanale décorée au pinceau sur émail cru.\r\nAtelier fondé en 1985, spécialisé dans la technique Grand Feu. Décors traditionnels dauphinois, et créations.\r\nHommages à H.Berlioz et JB Jongkind."
    ],
    "nl": [
      "Valérie LE METAYER, schilder van aardewerk.\r\nHandgemaakt aardewerk gedecoreerd met een penseel op onbewerkt glazuur.\r\nAtelier opgericht in 1985, gespecialiseerd in de Grand Feu techniek. Traditionele ontwerpen en creaties uit de Dauphiné.\r\nHommages aan H.Berlioz en JB Jongkind."
    ],
    "es": [
      "Valérie LE METAYER, pintora de loza.\r\nCerámica artesanal decorada con pincel sobre esmalte crudo.\r\nTaller fundado en 1985, especializado en la técnica Grand Feu. Diseños y creaciones tradicionales del Dauphiné.\r\nHomenaje a H. Berlioz y JB Jongkind."
    ]
  },
