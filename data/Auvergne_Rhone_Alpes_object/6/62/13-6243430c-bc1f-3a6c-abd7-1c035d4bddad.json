  "rdfs:comment": {
    "de": [
      "La Breizh Mobile bietet Ihnen Buchweizenpfannkuchen und Gourmet-Crêpes, Eis aus der Ardèche und lokale Produkte, die maximal hausgemacht sind. Besuchen Sie sie und lassen Sie sich an den üblichen Standorten verwöhnen!"
    ],
    "en": [
      "La Breizh Mobile offers you buckwheat pancakes and gourmet crêpes, ice creams from the Ardèche and local products, all home-made. Come and treat yourself at our usual locations!"
    ],
    "it": [
      "La Breizh Mobile vi offre frittelle di grano saraceno e crêpes gourmet, gelati dell'Ardèche e prodotti locali, tutti fatti in casa. Venite a trovarci e a farvi coccolare nei nostri stand abituali!"
    ],
    "fr": [
      "La Breizh Mobile vous propose des galettes de sarrasin et crêpes gourmandes, des glaces de l'Ardèche et  produits locaux,  un maximum fait maison. Venez la retrouver et vous régaler sur ces emplacements habituels !"
    ],
    "es": [
      "La Breizh Mobile le ofrece tortitas de trigo sarraceno y crêpes gourmet, helados de Ardèche y productos locales, todo casero. ¡Venga a vernos y dese un capricho en nuestros puestos habituales!"
    ],
    "nl": [
      "La Breizh Mobile biedt u boekweitpannenkoeken en crêpes voor fijnproevers, ijs uit de Ardèche en lokale producten, allemaal huisgemaakt. Kom langs en verwen jezelf bij onze gebruikelijke kraampjes!"
    ]
  },
