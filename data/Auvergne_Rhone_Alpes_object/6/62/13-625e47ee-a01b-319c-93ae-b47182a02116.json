  "rdfs:comment": {
    "de": [
      "Entdecken Sie unseren traditionellen Gasthof 5 Minuten von Les Vans entfernt, in dem die Familienküche der Ardèche lokale Produkte und französisches Fleisch in den Vordergrund stellt. Einfach, großzügig und erschwinglich, unsere Preise ermöglichen es jedem, diese authentische Erfahrung zu genießen."
    ],
    "en": [
      "Discover our traditional inn 5 minutes from Les Vans, where Ardéchois family cooking features local produce and French meats. Simple, generous and affordable, our prices allow everyone to enjoy this authentic experience."
    ],
    "it": [
      "Scoprite la nostra locanda tradizionale a 5 minuti da Les Vans, dove la cucina familiare dell'Ardèche è caratterizzata da prodotti locali e carne francese. Semplici, generosi e convenienti, i nostri prezzi permettono a tutti di godere di questa esperienza autentica."
    ],
    "fr": [
      "Découvrez notre auberge traditionnelle à 5 minutes des Vans, où la cuisine familiale ardéchoise met en avant produits locaux et  viande française. Simple, généreuse et accessible, nos prix permettent à tous de profiter de cette expérience authentique."
    ],
    "nl": [
      "Ontdek onze traditionele herberg op slechts 5 minuten van Les Vans, waar de familiekeuken uit de Ardèche bestaat uit lokale producten en Frans vlees. Eenvoudig, gul en betaalbaar, onze prijzen laten iedereen genieten van deze authentieke ervaring."
    ],
    "es": [
      "Descubra nuestra posada tradicional a 5 minutos de Les Vans, donde la cocina familiar de Ardèche se caracteriza por los productos locales y la carne francesa. Sencillos, generosos y asequibles, nuestros precios permiten a todos disfrutar de esta auténtica experiencia."
    ]
  },
  "rdfs:label": {
