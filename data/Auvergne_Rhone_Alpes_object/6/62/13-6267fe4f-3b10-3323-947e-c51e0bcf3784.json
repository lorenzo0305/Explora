  "rdfs:comment": {
    "de": [
      "Wenn Sie durch die engen Gassen im Herzen des Dorfes schlendern, entdecken Sie einen viereckigen Turm aus dem Mittelalter..."
    ],
    "en": [
      "Strolling through the narrow streets in the heart of the village, you'll discover a medieval quadrangular tower..."
    ],
    "it": [
      "Passeggiando per le strette vie del cuore del villaggio, scoprirete una torre quadrangolare medievale..."
    ],
    "fr": [
      "En arpentant les ruelles étroites, au cœur du village, vous découvrirez une tour quadrangulaire médiévale..."
    ],
    "es": [
      "Caminando por las estrechas calles del corazón del pueblo, descubrirá una torre cuadrangular medieval..."
    ],
    "nl": [
      "Als je door de smalle straatjes in het hart van het dorp loopt, kom je een middeleeuwse vierhoekige toren tegen..."
    ]
  },
  "rdfs:label": {
