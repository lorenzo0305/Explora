      "dc:description": {
        "de": [
          "Geschäft für den Verleih von Fahrrädern und Rosalien. Reparaturen von Fahrrädern\nTäglich von 10-12 Uhr und 14-18 Uhr geöffnet, außer dienstags und mittwochs"
        ],
        "en": [
          "Bike and rosalia rental store. Bike repairs\nOpen every day from 10am to 12pm and from 2pm to 6pm, except Tuesdays and Wednesdays"
        ],
        "it": [
          "Negozio di noleggio di biciclette e di rosalia. Riparazioni di biciclette\nAperto tutti i giorni dalle 10 alle 12 e dalle 14 alle 18, tranne il martedì e il mercoledì"
        ],
        "fr": [
          "Magasin de location de vélos et rosalies. Réparations de vélos\nOuvert tous les jours de 10h à 12h et de 14h à 18h sauf le mardi et mercredi"
        ],
        "nl": [
          "Verhuur van fietsen en rozalia. Fietsreparaties\nElke dag geopend van 10.00 tot 12.00 uur en van 14.00 tot 18.00 uur, behalve op dinsdag en woensdag"
        ],
        "es": [
          "Tienda de alquiler de bicicletas y rosalia. Reparación de bicicletas\nAbierto todos los días de 10.00 a 12.00 y de 14.00 a 18.00, excepto martes y miércoles"
        ]
