  "rdfs:comment": {
    "de": [
      "Der ideale Halt zwischen Salers und Puy-Mary. Entdecken Sie unsere Küche, unsere regionalen Produkte und unsere Terrasse mit Blick auf das Panorama des Puy Violent und seinen Aussichtspunkt auf das Tal der Maronne."
    ],
    "en": [
      "Perfect halt between Salers and the Puy Mary. \r\nFrom the terrace there is a beautiful view of the Maronne valley. \r\nTraditional cooking with the region’s specialties. Local products."
    ],
    "it": [
      "La sosta ideale tra Salers e Puy-Mary. Venite a scoprire la nostra cucina, i nostri prodotti regionali e la nostra terrazza affacciata sul panorama del Puy Violent e la sua vista sulla Valle della Maronne."
    ],
    "fr": [
      "La halte idéale entre Salers et le Puy-Mary. Venez découvrir notre cuisine, nos produits régionaux, notre terrasse face au panorama du Puy Violent , et son point de vue sur la Vallée de la Maronne."
    ],
    "es": [
      "La parada ideal entre Salers y Puy-Mary. Venga a descubrir nuestra cocina, nuestros productos regionales y nuestra terraza frente al panorama de Puy Violent y su vista sobre el valle del Maronne."
    ],
    "nl": [
      "De ideale tussenstop tussen Salers en Puy-Mary. Kom en ontdek onze keuken, onze regionale producten en ons terras met uitzicht op het panorama van Puy Violent en het uitzicht over de Maronne-vallei."
    ]
  },
  "rdfs:label": {
