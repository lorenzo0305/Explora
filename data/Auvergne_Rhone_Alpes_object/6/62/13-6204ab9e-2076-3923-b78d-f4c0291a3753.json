  "rdfs:comment": {
    "de": [
      "Die 1.000 m² große Stadtbibliothek bietet 22.000 Medien aller Art. Sie ist ausgestattet mit einem Veranstaltungsraum, 2 Werkstätten, 1 digitalen Raum, 2 privaten Innenhöfen, 1 Kornothek, 1 Vinylbar, 3 Rückgabe- und Ausleihautomaten, 1 24-Stunden-Kassette."
    ],
    "en": [
      "Municipal library of 1,000 m² offers 22,000 documents in all media. It is equipped with an animation room, 2 workshops, 1 digital space, 2 private patios, 1 grain library, 1 vinyl bar, 3 return and loan machines, 1 box 24/24."
    ],
    "it": [
      "La biblioteca comunale di 1.000 m² offre 22.000 documenti in tutti i media. È dotata di una sala attività, 2 laboratori, 1 spazio digitale, 2 patii privati, 1 granoteca, 1 vinyl bar, 3 macchine automatiche per la restituzione e il prestito, 1 cassa 24 ore."
    ],
    "fr": [
      "Bibliothèque municipale de 1 000 m² propose 22 000 documents tous supports. Elle est équipée d'une salle d'animation, 2 ateliers, 1 espace numérique, 2 patios privatifs, 1 grainothèque, 1 bar à vinyles, 3 automates de retour et de prêt, 1 boîte 24/24."
    ],
    "es": [
      "La biblioteca municipal de 1.000 m² ofrece 22.000 documentos en todos los soportes. Está equipado con una sala de actividades, 2 talleres, 1 espacio digital, 2 patios privados, 1 granero, 1 bar de vinilos, 3 máquinas automáticas de devolución y préstamo, 1 caja de 24 horas."
    ],
    "nl": [
      "De gemeentelijke bibliotheek van 1.000 m² biedt 22.000 documenten in alle media. Het is uitgerust met een activiteitenruimte, 2 ateliers, 1 digitale ruimte, 2 privé patio's, 1 graanbibliotheek, 1 vinylbar, 3 automatische inlever- en uitleenmachines, 1 24-uurs box."
    ]
  },
