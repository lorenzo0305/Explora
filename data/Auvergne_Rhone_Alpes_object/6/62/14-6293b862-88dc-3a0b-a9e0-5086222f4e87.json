  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/0dc18716-45d8-37c0-ab21-7cd9c97763b4",
      "dc:description": {
        "de": [
          "Boutique mit Prêt-à-porter-Mode für Frauen.\nHier finden Sie auch eine Auswahl an Schuhen, Bademode, Dessous und Modeschmuck.\n\nTäglich von 10:00 bis 13:00 Uhr und von 15:00 bis 19:00 Uhr geöffnet."
        ],
        "en": [
          "Women's ready-to-wear boutique.\nYou'll also find a selection of shoes, swimwear, lingerie and costume jewelry.\n\nOpen daily from 10am to 1pm and from 3pm to 7pm."
        ],
        "it": [
          "Boutique di prêt-à-porter femminile.\nTroverete anche una selezione di scarpe, costumi da bagno, lingerie e bigiotteria.\n\nAperto tutti i giorni dalle 10.00 alle 13.00 e dalle 15.00 alle 19.00."
        ],
        "fr": [
          "Boutique de prêt-à-porter féminin.\nVous y trouverez également une sélection de chaussures, de maillot de bain et de lingerie et de bijoux fantaisie.\n\nOuvert tous les jours de 10h à 13h et de 15h à 19h."
        ],
        "nl": [
          "Confectieboetiek voor dames.\nJe vindt er ook een selectie schoenen, badmode, lingerie en fantasiejuwelen.\n\nElke dag geopend van 10.00 tot 13.00 uur en van 15.00 tot 19.00 uur."
        ],
        "es": [
          "Boutique de prêt-à-porter femenino.\nTambién encontrará una selección de zapatos, trajes de baño, lencería y bisutería.\n\nAbierto todos los días de 10.00 a 13.00 y de 15.00 a 19.00."
        ]
      },
