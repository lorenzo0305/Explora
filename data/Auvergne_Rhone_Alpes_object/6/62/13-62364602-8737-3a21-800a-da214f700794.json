  "rdfs:comment": {
    "de": [
      "Entlang des Flusses Malsanne, durch alpine Weiden, aber auch durch den größten Erlenwald Frankreichs, wechseln sich auf dieser Strecke rollende Wege und technische Pfade im Herzen eines wunderschönen Tals ab."
    ],
    "en": [
      "Along the Malsanne river, through alpine pastures but also the largest alder grove in France, this course alternates rolling paths and technical trails in the heart of a magnificent valley."
    ],
    "it": [
      "Lungo la Malsanne, attraverso pascoli alpini e il più grande ontaneto di Francia, questo percorso alterna sentieri dolci e tecnici nel cuore di una magnifica valle."
    ],
    "fr": [
      "Le long de la Malsanne, à travers pâturages alpins mais aussi la plus grande aulnaie de France, ce parcours alterne chemins roulants et sentiers techniques au cœur d'une magnifique vallée."
    ],
    "nl": [
      "Parcours n°32, rood"
    ],
    "es": [
      "A lo largo del Malsanne, a través de pastos alpinos y del mayor bosque de alisos de Francia, esta ruta alterna caminos ondulados y técnicos en el corazón de un magnífico valle."
    ]
  },
