  "rdfs:comment": {
    "de": [
      "Eine lokale, biologische und saisonale Küche, die von den Produkten des Court Circuit inspiriert ist.\r\nVom kompletten Teller Ribamboule bis hin zu Fleischgerichten oder vegetarischen Gerichten, die Sie vor Ort in einer gemütlichen Atmosphäre wie in einer Kantine genießen oder auch mitnehmen können."
    ],
    "en": [
      "Organic, seasonal cuisine inspired by Court Circuit products.\r\nFrom the complete Ribamboule plate to the meat or vegetarian formula, to enjoy on the premises in a friendly canteen-style atmosphere, or to take away."
    ],
    "it": [
      "Cucina locale, biologica e stagionale, ispirata ai prodotti del Circuito della Corte.\r\nDal piatto completo di Ribamboule all'opzione di carne o vegetariana, da gustare sul posto in un'atmosfera amichevole da mensa o da portare via."
    ],
    "fr": [
      "Une cuisine locale, bio & de saison , inspirée des produits de Court Circuit.\r\nDe l’assiette complète Ribamboule à la formule carnée ou végétarienne, à déguster sur place dans une ambiance conviviale, comme à la cantine, ou à emporter."
    ],
    "es": [
      "Cocina local, ecológica y de temporada, inspirada en los productos del Circuito de la Corte.\r\nDesde el plato completo de Ribamboule hasta la opción de carne o vegetariana, disfrútelo en el local en un ambiente acogedor tipo cantina, o lléveselo para llevar."
    ],
    "nl": [
      "Biologische seizoenskeuken geïnspireerd op producten van het Hofcircuit.\r\nVan het complete Ribamboule-bord tot de vlees- of vegetarische formule, om ter plaatse van te genieten in een gezellige kantinesfeer, of om mee te nemen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Resto/cantine Ribamboule"
    ]
  },
