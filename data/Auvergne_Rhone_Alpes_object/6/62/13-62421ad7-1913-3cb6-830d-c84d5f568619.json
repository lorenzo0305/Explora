  "rdfs:comment": {
    "de": [
      "Das Restaurant l'Alpage ist ein Bergrestaurant auf 1170 m Höhe am Col de Creusaz, am Ausgangspunkt der Wanderungen zum Mont Bénand. Savoyische Spezialitäten, traditionelle Küche, Bankette, Gruppenessen. Reservierung empfohlen."
    ],
    "en": [
      "The Alpage restaurant is a mountain restaurant located at 1170m altitude at the Col de Creusaz, starting hiking Mont Benand. Savoyard specialties, traditional cuisine, banquets, group meals. Reservation recommended."
    ],
    "it": [
      "Il ristorante l'Alpage è un ristorante di montagna situato a 1170 m di altitudine al passo Creusaz, all'inizio delle escursioni del Mont Bénand. Specialità savoiarde, cucina tradizionale, banchetti, pasti di gruppo. Si consiglia la prenotazione."
    ],
    "fr": [
      "Le restaurant l'Alpage est un restaurant de montagne situé à 1170m d'altitude au col de Creusaz, au départ des randonnées du Mont Bénand. Spécialités savoyardes, cuisine traditionnelle, banquets, repas de groupes. Réservation recommandée."
    ],
    "nl": [
      "Restaurant l'Alpage is een bergrestaurant gelegen op 1170m hoogte op de Col de Creusaz, aan het begin van de Mont Bénand wandelpaden. Savoyaardse specialiteiten, traditionele keuken, banketten, groepsmaaltijden. Reserveren aanbevolen."
    ],
    "es": [
      "El restaurante l'Alpage es un restaurante de montaña situado a 1170 m de altitud en el puerto de Creusaz, al inicio de las excursiones del Mont Bénand. Especialidades saboyanas, cocina tradicional, banquetes, comidas para grupos. Se recomienda reservar."
    ]
  },
