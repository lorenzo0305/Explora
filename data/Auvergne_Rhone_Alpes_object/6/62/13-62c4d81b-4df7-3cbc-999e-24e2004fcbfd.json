  "rdfs:comment": {
    "de": [
      "Wer hat nicht schon einmal davon geträumt, den Col du Galibier mit seinen Schneewänden zu erklimmen? Dieser unumgängliche Pass wartet nur auf Sie, mit seinen Postkartenlandschaften, die sich nur wenige Tage nach seiner offiziellen Eröffnung für die Sommersaison enthüllen werden."
    ],
    "en": [
      "Who hasn't dreamed of climbing the Col du Galibier with its walls of snow? This not-to-be-missed pass is waiting for you, with its picture-postcard scenery to be unveiled just a few days after its official opening for the summer season."
    ],
    "it": [
      "Chi non ha mai sognato di scalare il Col du Galibier con i suoi muri di neve? Questo passo imperdibile vi aspetta, con i suoi scenari da cartolina che saranno svelati solo pochi giorni dopo l'apertura ufficiale della stagione estiva."
    ],
    "fr": [
      "Qui n'a jamais rêvé de gravir le col du Galibier avec ses murs de neige ? Ce col incontournable n'attend que vous, avec ses paysages de carte postale qui se dévoileront quelques jours seulement après son ouverture officielle pour la période estivale."
    ],
    "es": [
      "¿Quién no ha soñado alguna vez con escalar el Col du Galibier con sus paredes de nieve? Este puerto ineludible le está esperando, con sus paisajes de postal que se desvelarán pocos días después de su apertura oficial para la temporada de verano."
    ],
    "nl": [
      "Wie heeft er nooit van gedroomd om de Col du Galibier met zijn sneeuwmuren te beklimmen? Deze niet te missen pas ligt op je te wachten, met zijn pittoreske landschappen die al een paar dagen na de officiële opening voor het zomerseizoen worden onthuld."
    ]
  },
