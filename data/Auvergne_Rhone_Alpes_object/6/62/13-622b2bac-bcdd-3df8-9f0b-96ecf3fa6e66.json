  "rdfs:comment": {
    "de": [
      "Ob Geburtstag, Hochzeit, Privatfeier oder Bankett, Seminar oder Arbeitstreffen - der Saal empfängt Sie mit einer maximalen Kapazität von 250 Plätzen, 30 Tischen und 250 Stühlen."
    ],
    "en": [
      "Whether for an anniversary, a wedding, a private party, a banquet, a seminar or a business meeting, the hall has a maximum capacity of 250 places, 30 tables and 250 chairs."
    ],
    "it": [
      "Che si tratti di un compleanno, di un matrimonio, di una festa privata, di un banchetto, di un seminario o di una riunione di lavoro, la sala ha una capacità massima di 250 posti, 30 tavoli e 250 sedie."
    ],
    "fr": [
      "Que ce soit pour un anniversaire, un mariage, une soirée privée ou encore un banquet, un séminaire, une réunion de travail, la salle vous accueille avec une capacité maximale de 250 places, 30 tables et 250 chaises."
    ],
    "es": [
      "Ya sea para un cumpleaños, una boda, una fiesta privada, un banquete, un seminario o una reunión de negocios, la sala tiene una capacidad máxima de 250 plazas, 30 mesas y 250 sillas."
    ],
    "nl": [
      "Of het nu voor een verjaardag, bruiloft, privéfeest, banket, seminar of zakelijke bijeenkomst is, de zaal heeft een maximale capaciteit van 250 plaatsen, 30 tafels en 250 stoelen."
    ]
  },
  "rdfs:label": {
    "fr": [
