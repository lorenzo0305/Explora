  "rdfs:comment": {
    "de": [
      "Entdecken Sie eine traditionelle und raffinierte Küche in der Auberge des rives de l'Arzon, im Herzen des Dorfes Vorey mit einer Terrasse mit Blick auf den Fluss."
    ],
    "en": [
      "Discover traditional and refined cuisine at the Auberge des Rives de l'Arzon, in the heart of the village of Vorey with its terrace overlooking the river."
    ],
    "it": [
      "Scoprite una cucina tradizionale e raffinata all'Auberge des rives de l'Arzon, nel cuore del villaggio di Vorey, con la sua terrazza sul fiume."
    ],
    "fr": [
      "Découvrez une cuisine traditionnelle et raffinée à l'auberge des rives de l'Arzon, au cœur du village de Vorey avec sa terrasse surplombant la rivière."
    ],
    "nl": [
      "Ontdek een traditionele en verfijnde keuken in de Auberge des rives de l'Arzon, in het hart van het dorp Vorey met zijn terras met uitzicht op de rivier."
    ],
    "es": [
      "Descubra una cocina tradicional y refinada en el Auberge des rives de l'Arzon, en el corazón del pueblo de Vorey con su terraza con vistas al río."
    ]
  },
