  "rdfs:comment": {
    "de": [
      "680 m lange Kartbahn, moderne Karts, technische Strecke für Nervenkitzel pur. Große Auswahl an Karts, Zweisitzer mit Beifahrer ab 4 Jahren.\r\nSprint- oder Langstreckenrennen, Fahrschule, Geschenkgutscheine, \r\nJunggesellen-/Junggesellinnenabschiede"
    ],
    "en": [
      "680m karting track, modern karts, technical track for thrills and spills. Wide range of karts, including two-seaters with passengers aged 4 and above.\r\nSprint or endurance race packages, driving school, gift cards,\r\nstag/hen parties."
    ],
    "it": [
      "Karting di 680 m, kart moderni, pista tecnica, per sensazioni forti. Ampia gamma di kart, uno biposto con passeggero a partire da 4 anni.\r\nFormule di gara sprint o endurance, scuola di guida, carte regalo,\r\nFeste di addio al celibato e al nubilato"
    ],
    "fr": [
      "Karting de 680m, Karts modernes, Piste technique, pour des sensations fortes. Large gamme de karts , un biplace avec passager a partir de 4 ans . \r\nFormules course sprint ou endurance, école de pilotage, cartes cadeaux, \r\nEnterrement de vie garçons/filles"
    ],
    "nl": [
      "Karting van 680 m, moderne karts, technische baan, voor sterke sensaties. Ruime keuze aan karts, een tweezitter met passagier vanaf 4 jaar.\r\nFormules voor sprints of enduranceraces, rijschool, cadeaubonnen,\r\nVrijgezellenfeesten voor jongens en meisjes"
    ],
    "es": [
      "Karting de 680m, karts modernos, pista técnica, para sensaciones fuertes. Amplia gama de karts, uno biplaza con pasajero a partir de 4 años.\r\nFórmulas de carreras sprint o de resistencia, escuela de conducción, tarjetas regalo,\r\nDespedidas de soltero/a"
    ]
  },
