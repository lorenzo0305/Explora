  "rdfs:comment": {
    "de": [
      "Ehemalige Kirche Saint Marc 1702, 1806 den Protestanten zugeschrieben. Friedhof am Hang vor der Hauptfassade.halbrunde Apsis, hohe Seitenfenster und ein Okkulus in der Fassade. Bemerkenswerte Innenausstattung: großes Stuhl und Bänke aus Walnussholz."
    ],
    "en": [
      "Former Saint Marc church built in 1702 attributed to the Protestants in 1806. It has Romanesque characteristics."
    ],
    "it": [
      "Ex chiesa di San Marco 1702, assegnata ai protestanti nel 1806. Abside semicircolare, alte finestre laterali e un occulo nella facciata. Notevoli gli interni: grandi carni e panche in noce."
    ],
    "fr": [
      "Ancienne église Saint Marc 1702, attribuée aux protestants en 1806. Cimetière dans la pente devant la façade principale.Abside semi-circulaire, hautes fenêtres latérales et un occulus en façade. Interieur remarquable : grande chair et bancs en noyer."
    ],
    "nl": [
      "Voormalige kerk van Sint Marcus 1702, toegewezen aan de protestanten in 1806. Halfronde apsis, hoge zijramen en een occulus in de gevel. Opmerkelijk interieur: groot vlees en notenhouten banken."
    ],
    "es": [
      "Antigua iglesia de San Marcos 1702, asignada a los protestantes en 1806. Ábside semicircular, ventanas laterales altas y un óculo en la fachada. Notable interior: grandes carnes y bancos de nogal."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Temple des Tonils"
    ]
  },
