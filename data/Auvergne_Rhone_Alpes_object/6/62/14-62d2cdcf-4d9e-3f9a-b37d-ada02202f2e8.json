  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/f32016ca-5517-3df5-b532-e53c18a9500d",
      "dc:description": {
        "de": [
          "Verkauf von lokalen und regionalen Produkten: Käse, Bier, Eingemachtes, Fruchtsäfte, Kekse....und vieles mehr.\nDienstag bis Freitag von 9:30 bis 12:30 Uhr und von 14:00 bis 19:00 Uhr geöffnet. Samstags von 8:30 bis 12:30 Uhr und von 14:00 bis 19:00 Uhr."
        ],
        "en": [
          "Sale of local and regional products: cheeses, beers, preserves, fruit juices, biscuits....and much more.\nOpen Tuesday to Friday, 9:30am to 12:30pm and 2pm to 7pm. Saturday 8.30am to 12.30pm and 2pm to 7pm."
        ],
        "it": [
          "Vendita di prodotti locali e regionali: formaggi, birre, conserve, succhi di frutta, biscotti.... e molto altro.\nAperto dal martedì al venerdì, dalle 9.30 alle 12.30 e dalle 14.00 alle 19.00. Sabato dalle 8.30 alle 12.30 e dalle 14.00 alle 19.00."
        ],
        "fr": [
          "Vente de produits locaux et régionaux : fromages, bières, conserveries, jus de fruits, biscuits....et bien plus encore.\nOuvert du mardi au vendredi de 9h30 à 12h30 et de 14h à 19h. Le samedi de 8h30 à 12h30 et de 14h à 19h."
        ],
        "nl": [
          "Verkoop van lokale en regionale producten: kazen, bieren, conserven, vruchtensappen, koekjes .... en nog veel meer.\nGeopend van dinsdag tot vrijdag van 9.30 tot 12.30 en van 14.00 tot 19.00 uur. Zaterdag van 8.30 tot 12.30 en van 14.00 tot 19.00."
        ],
        "es": [
          "Venta de productos locales y regionales: quesos, cervezas, conservas, zumos de fruta, galletas....y mucho más.\nAbierto de martes a viernes de 9.30 a 12.30 y de 14.00 a 19.00 horas. Sábados de 8.30 a 12.30 y de 14 a 19 h."
        ]
      },
      "@type": [
        "Description"
