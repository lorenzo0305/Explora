  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/0d219e08-d337-3949-898d-249f8e9a0b0c",
      "dc:description": {
        "de": [
          "Tagescafé mit Verpflegung in einer gemütlichen, zeitgenössischen Einrichtung\nSpeisekarte mit frischen, hausgemachten Produkten\nFormule Entrée/Plat oder Plat/Dessert à 19€\nVorspeise/Hauptspeise/Dessert für 25€\nTagesgericht am Mittag unter der Woche zu 11€"
        ],
        "en": [
          "Daytime café with catering in a cosy contemporary decor\nCard based on fresh homemade products\nStarter/Dish or Main Course/Dessert formula at 19€\nEntrance/Main course/Dessert formula at 25€\nDish of the day for lunch on weekdays at 11€"
        ],
        "it": [
          "Caffè diurno con ristorazione in un accogliente ambiente contemporaneo\nMenu a base di prodotti freschi fatti in casa\nAntipasto/primo piatto o secondo piatto/dessert per 19 persone?\nAntipasto/primo piatto/dessert per 25 persone?\nPiatto del giorno a pranzo nei giorni feriali alle 11?"
        ],
        "fr": [
          "Café de jour avec restauration dans une décoration contemporaine cosy\nCarte à base de produit frais faits maison\nFormule Entrée/Plat ou Plat/Dessert à 19€\nFormule Entrée/Plat /Dessert à 25€\nPlat du jour le midi en semaine à 11€"
        ],
        "nl": [
          "Dagcafé met catering in een gezellig hedendaags decor\nMenu gebaseerd op verse huisgemaakte producten\nVoorgerecht/hoofdgerecht of hoofdgerecht/dessert voor 19?\nVoorgerecht/hoofdgerecht/dessert voor 25?\nSchotel van de dag tijdens de lunch op werkdagen om 11 uur?"
        ],
        "es": [
          "Café diurno con servicio de catering en una acogedora decoración contemporánea\nMenú basado en productos frescos caseros\n¿Entremés/plato principal o plato principal/postre para 19?\n¿Entrante/plato principal/postre para 25?\n¿Plato del día a la hora de comer entre semana a las 11?"
        ]
      },
