  "rdfs:comment": {
    "de": [
      "Straßenkunst, Palettenmalerei, Porträts von bekannten oder unbekannten Personen, Rächer des Pop... Arnaud empfängt Sie in seinem Atelier und bietet Zeichenkurse für alle Altersgruppen an."
    ],
    "en": [
      "Street art, paintings on pallets, portraits of famous and unknown people, pop vigilantes... Arnaud welcomes you to his studio and offers drawing classes for all ages."
    ],
    "it": [
      "Arte nata dalla strada, dipinti su bancali, ritratti di personaggi famosi o sconosciuti, vigilantes pop... Arnaud vi accoglie nel suo laboratorio e offre lezioni di disegno per tutti."
    ],
    "fr": [
      "Art né de la rue, peintures sur palettes, portraits personne connues ou inconnues, justiciers de la pop... Arnaud vous reçoit dans son atelier et propose des cours de dessin tout public."
    ],
    "nl": [
      "Straatkunst, schilderijen op pallets, portretten van beroemde of onbekende mensen, popwachten... Arnaud heet je welkom in zijn atelier en biedt tekenlessen voor alle leeftijden."
    ],
    "es": [
      "Arte nacido de la calle, pinturas sobre palés, retratos de famosos o desconocidos, vigilantes del pop... Arnaud le acoge en su taller y le ofrece clases de dibujo para todos."
    ]
  },
  "rdfs:label": {
    "fr": [
