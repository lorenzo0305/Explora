  "rdfs:comment": {
    "de": [
      "Genießen Sie die Geselligkeit an seinem Tisch, probieren Sie seine gute traditionelle Küche und seine regionalen Spezialitäten im Beaufort. Wir bieten Ihnen jeden Tag eine qualitativ hochwertige und saisonale Küche aus frischen Produkten."
    ],
    "en": [
      "Come and enjoy the conviviality of its table, taste its good traditional cuisine and its regional specialties at Beaufort. Every day, we offer you quality, seasonal cuisine made from fresh produces."
    ],
    "it": [
      "Venite a godervi la convivialità della nostra tavola, assaporate la nostra cucina tradizionale e le nostre specialità regionali di Beaufort. Ogni giorno serviamo una cucina stagionale di qualità a base di prodotti freschi."
    ],
    "fr": [
      "Venez savourer la convivialité de sa table, déguster sa bonne cuisine traditionnelle et ses spécialités régionales au Beaufort. Nous vous proposons chaque jour une cuisine de qualité et de saison composée de produits frais."
    ],
    "es": [
      "Venga a disfrutar de la convivencia de nuestra mesa, saboree nuestra cocina tradicional y nuestras especialidades regionales de Beaufort. Todos los días servimos una cocina de temporada de calidad elaborada con productos frescos."
    ],
    "nl": [
      "Kom genieten van de gezelligheid van de tafel, proef de goede traditionele keuken en regionale specialiteiten in Beaufort. Wij bieden u elke dag een kwaliteits- en seizoenskeuken bestaande uit verse producten."
    ]
  },
  "rdfs:label": {
