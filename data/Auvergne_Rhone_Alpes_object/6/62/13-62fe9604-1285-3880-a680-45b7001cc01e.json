  "rdfs:comment": {
    "de": [
      "Eine subtile Mischung aus Erdgeschichten und vergangenen Zivilisationen für zeitgenössischen Schmuck mit symbolischen Akzenten. Célia Taillandier entwirft und fertigt Schmuckstücke aus Gold, Platin oder Silber, die mit den seltensten und wertvollsten Steinen besetzt sind."
    ],
    "en": [
      "A subtle blend of Earth stories and past civilizations, for contemporary jewelry with symbolic accents. Célia Taillandier designs and manufactures jewelry in gold, platinum or silver, set with the rarest and most precious stones."
    ],
    "it": [
      "Una sottile miscela di storie della Terra e civiltà passate, per gioielli contemporanei dall'accento simbolico. Célia Taillandier disegna e realizza gioielli in oro, platino o argento, con le pietre più rare e preziose."
    ],
    "fr": [
      "Mélange subtil d’histoires de la Terre, des civilisations passées, pour des bijoux contemporains aux accents  symboliques. Célia Taillandier conçoit et fabrique des bijoux en or, platine ou argent, sertis de pierres les plus rares et précieuses."
    ],
    "es": [
      "Una sutil mezcla de historias de la Tierra y civilizaciones pasadas, para joyas contemporáneas con un acento simbólico. Célia Taillandier diseña y fabrica joyas en oro, platino o plata, engastadas con las piedras más raras y preciosas."
    ],
    "nl": [
      "Een subtiele mix van aardse verhalen en beschavingen uit het verleden, voor hedendaagse sieraden met een symbolisch accent. Célia Taillandier ontwerpt en maakt sieraden in goud, platina of zilver, bezet met de zeldzaamste en kostbaarste stenen."
    ]
  },
