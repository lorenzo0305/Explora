  "rdfs:comment": {
    "de": [
      "Von der Region, den Märkten und seiner Umgebung inspirierte Küche, in einem intimen und authentischen Ambiente im Herzen von St-Paul Trois Châteaux serviert. Themenmenüs: Trüffel"
    ],
    "en": [
      "Cooking based on locally sourced, farm and market products, served in an intimate, authentic setting at the heart of de St-Paul Trois Châteaux. Themed menus: truffle."
    ],
    "it": [
      "La filosofia del ristorante La Chapelle è quella di lavorare con produttori, artigiani e commercianti locali."
    ],
    "fr": [
      "La philosophie du restaurant La Chapelle est de travailler avec les producteurs, les artisans et commerçants locaux."
    ],
    "es": [
      "La filosofía del restaurante La Chapelle es trabajar con productores, artesanos y comerciantes locales."
    ],
    "nl": [
      "Een keuken geleverd door de streek, de markt en de omgeving, geserveerd in een intieme en authentieke sfeer in het hart van St-Paul-Trois- Châteaux. \r\nThemamenu’s: Truffel."
    ]
  },
