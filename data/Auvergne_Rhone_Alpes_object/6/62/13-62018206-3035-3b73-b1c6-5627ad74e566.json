  "rdfs:comment": {
    "de": [
      "Grüne Meridiane: Wenn Sie mit den Straßen und Auroroutes in unserem Land vertraut sind, haben Sie sich dann nicht schon einmal gefragt, was sich hinter dieser rätselhaften Beschilderung verbirgt?"
    ],
    "en": [
      "La Méridienne verte (\"Green Meridian\"): if you're familiar with our country's roads and motorways, have you ever wondered what's behind this enigmatic signage?"
    ],
    "it": [
      "Il Meridiano Verde: conoscendo le strade e le autostrade del nostro Paese, vi siete mai chiesti cosa ci fosse dietro questa enigmatica segnaletica?"
    ],
    "fr": [
      "La Méridienne verte : familiers des routes et auroroutes de notre pays, ne vous êtes-vous jamais demandé ce qui se cachait derrière cette signalisation énigmatique ?"
    ],
    "nl": [
      "La Méridienne verte (\"Groene Meridiaan\"): als u bekend bent met de wegen en snelwegen van ons land, heeft u zich dan ooit afgevraagd wat er achter deze raadselachtige bewegwijzering schuilgaat?"
    ],
    "es": [
      "El Meridiano Verde: familiarizado con las carreteras y autopistas de nuestro país, ¿alguna vez se ha preguntado qué había detrás de esta enigmática señalización?"
    ]
  },
