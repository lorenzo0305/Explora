  "rdfs:comment": {
    "de": [
      "Unter der Linde neben dem Brunnen bietet Ihnen das Restaurant Bistroquet de l'Hôtel du Dauphiné eine regionale Küche mit vielen Geschmacksrichtungen."
    ],
    "en": [
      "Under the lime trees by the fountain, le Bistroquet Hôtel-Restaurant du Dauphiné offers local terroir cuisine with many flavours."
    ],
    "it": [
      "Sotto il tiglio della fontana, il ristorante Bistroquet de l'Hôtel du Dauphiné propone una cucina locale ricca di sapori."
    ],
    "fr": [
      "Sous le tilleul près de la fontaine, le restaurant du Bistroquet de l'Hôtel du Dauphiné vous propose une cuisine de terroir aux multiples saveurs."
    ],
    "nl": [
      "Onder de lindeboom bij de fontein serveert het restaurant Bistroquet de l'Hôtel du Dauphiné lokale gerechten met een rijkdom aan smaken."
    ],
    "es": [
      "Bajo el tilo, junto a la fuente, el restaurante Bistroquet de l'Hôtel du Dauphiné sirve cocina local con riqueza de sabores."
    ]
  },
