  "rdfs:comment": {
    "de": [
      "Beheizter Swimmingpool im Freien. Wassertemperatur ca. 28°C\r\nBecken mit einer Länge von 25 m.\r\n- verspieltes Planschbecken\r\n- 50 m lange Rutsche mit Auffangbecken\r\n- mineralstrände\r\n- schwimmunterricht, Wassergymnastiksitzungen\r\n- bar, Schnellimbiss"
    ],
    "en": [
      "Heated outdoor swimming pool.\r\n25m pool.\r\n- fun paddling pool\r\n- 50m slide with splash pool\r\n- Mineral beaches\r\n- Swimming lessons, water aerobics sessions\r\n- Bar, fast food"
    ],
    "it": [
      "Piscina riscaldata all'aperto.\r\nVasca di 25m. \r\n- vasca per i piccoli.\r\n- scivolo da 50 m con vasca di ricezione\r\n- spiagge minerali\r\n- corsi di nuoto, aquagym\r\n- bar, punto di ristoro"
    ],
    "fr": [
      "Piscine chauffée en plein-air. Température de l'eau environ 28°C\r\nBassin de 25 m.\r\n- pataugeoire ludique\r\n- toboggan de 50 m avec bassin de réception \r\n- plages minérales\r\n- leçons de natation, séances d'aquagym \r\n- bar, restauration rapide"
    ],
    "nl": [
      "Verwarmd zwembad in de buitenlucht.\r\nBad van 25 m.\r\n- leuk peuterbad\r\n- tobogan van 50 m met ontvangstbad\r\n- minerale stranden\r\n- zwemlessen, aquagym\r\n- bar, snackbar"
    ],
    "es": [
      "Piscina exterior climatizada. Temperatura del agua aprox. 28°C\r\nPiscina de 25 m.\r\n- piscina infantil\r\n- tobogán de 50 m con piscina de aterrizaje\r\n- playas minerales\r\n- clases de natación, sesiones de aquagym\r\n- bar, comida rápida"
    ]
  },
