  "rdfs:comment": {
    "de": [
      "Kirche im neogotischen Stil, die von dem ehemaligen Priester Jean d'Auferville und den Einwohnern zum Thema der vier Jahreszeiten restauriert wurde. Ungewöhnlich für eine Kirche. Zu besichtigen."
    ],
    "en": [
      "Neo-Gothic church tastefully restored by former priest Jean d'Auferville and villagers, on the theme of the four seasons. Unusual. Worth a visit."
    ],
    "it": [
      "Chiesa neogotica restaurata dall'ex sacerdote Jean d'Auferville e dagli abitanti del luogo, sul tema delle quattro stagioni. Insolita. Merita una visita."
    ],
    "fr": [
      "Eglise de style néo-gothique restaurée par l'ancien prêtre Jean d'Auferville et les habitants, sur le thème des quatre saisons. Inhabituel. A visiter."
    ],
    "nl": [
      "Neogotische kerk gerestaureerd door de voormalige priester Jean d'Auferville en de plaatselijke bewoners, met als thema de vier seizoenen. Ongewoon. Een bezoek waard."
    ],
    "es": [
      "Iglesia neogótica restaurada por el antiguo párroco Jean d'Auferville y los vecinos de la zona, sobre el tema de las cuatro estaciones. Insólito. Merece la pena visitarla."
    ]
  },
