  "rdfs:comment": {
    "de": [
      "Der perfekte Ort für Eltern, aber nicht nur! Ein Café mit biologischen und saisonalen Produkten, eine Secondhand-Boutique für Kinder und Schwangere sowie Workshops für Groß und Klein - hier gibt es alles, was das Familienherz begehrt."
    ],
    "en": [
      "The perfect place for parents, but not only! With a café featuring organic and seasonal produce, a second-hand boutique for children and pregnant women, and workshops for young and old, you'll find something to delight the whole family."
    ],
    "it": [
      "Il luogo ideale per i genitori, ma non solo! Con una caffetteria che offre prodotti biologici e di stagione, un negozio di seconda mano per bambini e donne incinte, e laboratori per grandi e piccini, troverete qualcosa per deliziare tutta la famiglia."
    ],
    "fr": [
      "Le lieu rêvé pour les parents, mais pas que! Café avec des produits bio et de saisons, boutique de seconde main pour enfants et femme enceinte, et ateliers pour petits et grands vous y trouverez de quoi ravir toute la famille."
    ],
    "es": [
      "El lugar perfecto para los padres, ¡pero no sólo! Con una cafetería que ofrece productos ecológicos y de temporada, una tienda de segunda mano para niños y embarazadas, y talleres para grandes y pequeños, encontrará algo para deleitar a toda la familia."
    ],
    "nl": [
      "De perfecte plek voor ouders, maar niet alleen! Met een café met biologische en seizoensgebonden producten, een tweedehandswinkel voor kinderen en zwangere vrouwen, en workshops voor jong en oud, vind je hier iets voor het hele gezin."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Dinette - Le café des Familles"
    ]
  },
