  "rdfs:comment": {
    "de": [
      "Probieren Sie die große Auswahl an Bieren, Weinen, Whiskys und alkoholfreien Getränken in diesem Restaurant in Pont de Beauvoisin. Es bietet Bretter zum Teilen und musikalische Unterhaltung in einer gemütlichen Atmosphäre mit industriellem Flair."
    ],
    "en": [
      "Taste the wide choice of beers, wines, whiskies and soft drinks at this Pont de Beauvoisin restaurant, which offers planks to share and musical entertainment in a cosy, industrial atmosphere."
    ],
    "it": [
      "Assaggiate l'ampia scelta di birre, vini, whisky e bibite in questo ristorante di Pont de Beauvoisin, che offre piatti da condividere e intrattenimento musicale in un'atmosfera accogliente e industriale."
    ],
    "fr": [
      "Goûtez au large choix de bières, vins, whiskys et boissons sans alcool de ce restaurant de Pont de Beauvoisin qui propose des planches à partager et des animations musicales dans une ambiance cosy à l'esprit industriel."
    ],
    "nl": [
      "Proef de ruime keuze aan bieren, wijnen, whisky's en frisdranken in dit restaurant in Pont de Beauvoisin, waar je terecht kunt voor gedeelde schotels en muzikaal entertainment in een gezellige, industriële sfeer."
    ],
    "es": [
      "Deguste la amplia selección de cervezas, vinos, whiskies y refrescos de este restaurante de Pont de Beauvoisin, que ofrece platos para compartir y animación musical en un ambiente acogedor e industrial."
    ]
  },
  "rdfs:label": {
