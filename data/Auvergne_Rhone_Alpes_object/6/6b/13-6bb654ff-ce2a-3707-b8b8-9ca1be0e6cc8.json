  "rdfs:comment": {
    "de": [
      "Eine köstliche Küche aus schön präsentierten saisonalen und qualitativen Produkten, die sich Ihnen anbietet, um mit Ihnen einen einfachen und wahren Moment des Genusses zu teilen."
    ],
    "en": [
      "Enjoy tasty cooking, with attractively prepared seasonal products as you share a simple and unforgettable moment of sheer indulgence."
    ],
    "it": [
      "Una cucina saporita a base di prodotti di stagione e di qualità, perfettamente padroneggiata, che si propone di farti trascorrere un momento semplice e autentico di benessere."
    ],
    "fr": [
      "Une cuisine savoureuse, faite de produits de saison et de qualité, joliment maîtrisée, qui se propose de vous faire partager un simple et vrai moment de délectation."
    ],
    "es": [
      "Una cocina sabrosa, cuidada, elaborada con productos de temporada y de calidad, que se propone compartir con los comensales una verdadera experiencia de placer."
    ],
    "nl": [
      "Een smakelijke keuken, gemaakt van seizoens- en kwaliteitsproducten, prachtig beheerst, die voorstelt om met u een eenvoudig en echt moment van verrukking te delen."
    ]
  },
