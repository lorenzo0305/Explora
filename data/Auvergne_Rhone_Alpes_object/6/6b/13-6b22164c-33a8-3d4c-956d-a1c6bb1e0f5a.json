  "rdfs:comment": {
    "de": [
      "Ziegenzucht von weißen Saanen im Herzen von « Cévenne ardéchois ». Ziegenkäseherstellung und von Picodons (AOP)."
    ],
    "en": [
      "This family-run farm of white Saanen goats in the hills above the pretty village of Ribes produces a delicious range of PDO Picodons, lingots, pyramides, camem'biques and other tommes... But also delicious goat rillettes."
    ],
    "it": [
      "Questa fattoria a conduzione familiare di capre bianche Saanen, situata sulle colline sopra il grazioso villaggio di Ribes, produce una deliziosa gamma di Picodon DOP, lingots, pyramides, camem'biques e altri tommes... oltre a deliziose rillettes di capra."
    ],
    "fr": [
      "Cet élevage familial de chèvres blanches de race Saanen, situé sur les hauteurs du joli village de Ribes, produit une savoureuse gamme de Picodons AOP, lingots, pyramides, camem'biques et autres tommes... ainsi que de délicieuses rillettes de chèvre."
    ],
    "nl": [
      "Geitenhouderij van witte Saanen geiten, uit het hart van de Cévenne Ardéchoise. Producent van geitenkaas en picodon (AOP)."
    ],
    "es": [
      "Esta granja familiar de cabras blancas Saanen, situada en las colinas que dominan el bonito pueblo de Ribes, produce una deliciosa gama de Picodons DOP, lingots, pyramides, camem'biques y otras tommes... así como deliciosas rillettes de cabra."
    ]
  },
