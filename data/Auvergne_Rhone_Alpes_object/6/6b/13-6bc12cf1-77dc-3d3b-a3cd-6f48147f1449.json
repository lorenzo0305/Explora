  "rdfs:comment": {
    "de": [
      "Verfolgen Sie Ihr Streben nach Abenteuer und Spaß mit diplomierten Skilehrern, um Ihre Technik auf der Piste, beim Freeriden, Skitourengehen oder Heliskiing zu perfektionieren. Erleben Sie authentische Erfahrungen mit lokalen, leidenschaftlichen und fürsorglichen Fachleuten."
    ],
    "en": [
      "OriginAlps ski school invites you to continue your quest for adventure and fun with its certified ski instructors (and snowboard) to improve your technique on piste, discover freeride skiing, ski touring or heliskiing."
    ],
    "it": [
      "La scuola di sci OriginAlps ti invita a perseguire la tua ricerca di avventura e divertimento con i suoi maestri di sci e snowboard qualificati per perfezionare la tua tecnica su pista, nello sci freeride, sci alpinismo o heliski."
    ],
    "fr": [
      "Poursuivez votre quête d'aventure et de plaisir avec des moniteurs diplômés pour perfectionner votre technique sur piste, en freeride, ski de randonnée ou héliski. Vivez une expérience authentique avec des professionnels locaux, passionnés, attentionnés."
    ],
    "es": [
      "Persiga su búsqueda de aventura y placer con instructores cualificados para perfeccionar su técnica en las pistas, en freeride, esquí de travesía o heliski. Disfrute de una experiencia auténtica con profesionales locales, apasionados y atentos."
    ],
    "nl": [
      "Ga op zoek naar avontuur en plezier met gekwalificeerde instructeurs om je techniek te perfectioneren op de piste, in freeride, skitouring of heliskiën. Geniet van een authentieke ervaring met lokale, gepassioneerde en attente professionals."
    ]
  },
  "rdfs:label": {
    "en": [
      "Ski and snowboard school OriginAlps"
    ],
    "it": [
      "Scuola di sci e snowboard OriginAlps"
    ],
    "fr": [
      "Ecole de ski et snowboard OriginAlps"
    ]
  },
