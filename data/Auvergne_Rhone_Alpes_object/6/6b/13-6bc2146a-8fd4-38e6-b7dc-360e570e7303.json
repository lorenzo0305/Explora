  "rdfs:comment": {
    "de": [
      "Hersteller von personalisierten Dekorationsartikeln aus Holz: Streckenmarkierungen, Souvenirpfeile usw., die auf Bestellung gefertigt werden.\r\nErhältlich nach Vereinbarung in der Werkstatt und Präsenz auf Kunsthandwerksmärkten während der Saison.\r\nEinige Produkte sind auch in der Savonnerie Doux Voyage und im Fremdenverkehrsbüro erhältlich."
    ],
    "en": [
      "Manufacturer of personalised wooden decorative items: track markers, souvenir arrows, etc. made to order.\r\nAvailable by appointment at the workshop and presence at craft markets in season.\r\nSome products are also available from the Doux Voyage soap factory and the Tourist Office."
    ],
    "it": [
      "Produttore di oggetti decorativi in legno personalizzati: segnavia, frecce ricordo, ecc.\r\nVisite su appuntamento al laboratorio e presenza ai mercati dell'artigianato in stagione. Alcuni prodotti sono disponibili presso la Savonnerie e l'Ufficio del Turismo."
    ],
    "fr": [
      "Fabricant d'objets de décoration personnalisés en bois : balise de piste, flèche souvenir...\r\nAccueil sur rendez-vous à l'atelier et présence sur les marchés des artisans en saison. Certains produits sont disponibles à la Savonnerie et à l'Office."
    ],
    "nl": [
      "Fabrikant van gepersonaliseerde houten decoratieve voorwerpen: trackmarkers, souvenirpijlen, enz.\r\nBezoeken aan het atelier op afspraak en aanwezigheid op ambachtsmarkten in het seizoen. Sommige producten zijn verkrijgbaar bij de Savonnerie en bij het Office du Tourisme."
    ],
    "es": [
      "Fabricante de artículos decorativos de madera personalizados: marcadores de pista, flechas de recuerdo, etc.\r\nVisitas concertadas al taller y presencia en mercadillos de artesanía en temporada. Algunos productos están disponibles en la Savonnerie y en la Oficina de Turismo."
    ]
  },
  "rdfs:label": {
