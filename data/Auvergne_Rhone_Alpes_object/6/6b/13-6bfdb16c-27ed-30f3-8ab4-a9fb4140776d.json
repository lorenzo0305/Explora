  "rdfs:comment": {
    "de": [
      "Eine wahre Oase der Ruhe, um im Sommer wie im Winter am Wasser neue Energie zu tanken. Im Herzen des malerischen Dorfes Pont en Royans mit Blick auf die unter Denkmalschutz stehende Stätte der hängenden Häuser und den Fluss Bourne."
    ],
    "en": [
      "The hotel of the Water Museum, in a old convent, at the edge of the river. Panoramic view near the suspended houses, opposite a waterfall, its restaurant suggests at an outside table or inside, a quality French cooking with local products."
    ],
    "it": [
      "Una vera e propria oasi di pace per ricaricarsi in riva al mare in estate e in inverno. Nel cuore del pittoresco villaggio di Pont en Royans, con vista sul sito protetto delle Hanging Houses e sul fiume Bourne."
    ],
    "fr": [
      "Un véritable havre de paix pour se ressourcer au bord de l'eau en été comme en hiver. Au cœur du village pittoresque de Pont en Royans avec vue sur le site classé des Maisons suspendues et la rivière Bourne."
    ],
    "es": [
      "Un verdadero remanso de paz para recargar las pilas junto al agua en verano y en invierno. En el corazón del pintoresco pueblo de Pont en Royans, con vistas al lugar catalogado de las Casas Colgadas y al río Bourne."
    ],
    "nl": [
      "Een echte oase van rust om zowel in de zomer als in de winter nieuwe energie op te doen aan het water. In het hart van het pittoreske dorpje Pont en Royans met uitzicht op de geklasseerde site van de hangende huizen en de rivier de Bourne."
    ]
  },
