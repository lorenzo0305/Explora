  "rdfs:comment": {
    "de": [
      "Entdecken Sie einen Sportbereich, der ideal zwischen dem Gymnase Roger-François und dem Stade Donnadieu liegt und über den Parkplatz des Collège Debussy und die Rue de la Gloriette erreichbar ist."
    ],
    "en": [
      "Discover a sports area ideally located between the Roger-François gymnasium and the Donnadieu stadium, accessible via the Collège Debussy parking lot and rue de la Gloriette."
    ],
    "it": [
      "Scoprite un impianto sportivo situato in posizione ideale tra la palestra Roger-François e lo stadio Donnadieu, accessibile dal parcheggio del Collège Debussy e da rue de la Gloriette."
    ],
    "fr": [
      "Découvrez un espace sportif idéalement situé entre le gymnase Roger-François et le stade Donnadieu, accessible par le parking du collège Debussy et la rue de la Gloriette."
    ],
    "nl": [
      "Ontdek een sportfaciliteit die ideaal gelegen is tussen het Roger-François gymnasium en het Donnadieu stadion, bereikbaar via de Collège Debussy parkeerplaats en de rue de la Gloriette."
    ],
    "es": [
      "Descubra una instalación deportiva idealmente situada entre el gimnasio Roger-François y el estadio Donnadieu, accesible por el aparcamiento del Collège Debussy y la rue de la Gloriette."
    ]
  },
