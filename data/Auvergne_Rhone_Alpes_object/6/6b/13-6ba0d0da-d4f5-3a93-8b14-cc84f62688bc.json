  "rdfs:comment": {
    "de": [
      "Mel'Evasion befördert Sie in einem Minibus mit 9 Plätzen - Abfahrt vom Tourismusbüro in Varennes-sur-Allier.\r\nKurs auf Saint-Pourçain-sur-Sioule, um in ein lebendiges Terroir einzutauchen."
    ],
    "en": [
      "Mel'Evasion transports you in a 9-seater minibus - Departure from Varennes-sur-Allier tourist office.\r\nHead for Saint-Pourçain-sur-Sioule for an immersion in a living terroir."
    ],
    "it": [
      "Mel'Evasion vi trasporta in un mini-bus da 9 posti - Partenza dall'ufficio turistico di Varennes-sur-Allier.\r\nPartenza per Saint-Pourçain-sur-Sioule per un'immersione in un terroir vivo."
    ],
    "fr": [
      "Mel'Evasion vous transporte en mini-bus 9 places - Départ de l'office de tourisme de Varennes-sur-Allier.\r\nCap sur Saint-Pourçain-sur-Sioule pour une immersion dans un terroir vivant."
    ],
    "nl": [
      "Mel'Evasion vervoert je in een minibus met 9 zitplaatsen - Vertrek vanaf het toeristenbureau van Varennes-sur-Allier.\r\nRijd naar Saint-Pourçain-sur-Sioule voor een onderdompeling in een levend terroir."
    ],
    "es": [
      "Mel'Evasion le transporta en un minibús de 9 plazas - Salida de la oficina de turismo de Varennes-sur-Allier.\r\nDiríjase a Saint-Pourçain-sur-Sioule para sumergirse en un terruño vivo."
    ]
  },
  "rdfs:label": {
    "fr": [
