  "rdfs:comment": {
    "de": [
      "Dieses Duo aus einer virtuosen Pianistin und einem Geigenvirtuosen, das zwischen Musiktheater und animiertem Konzert angesiedelt ist, nimmt sowohl Neulinge als auch Musikliebhaber mit auf eine ebenso spielerische wie unerwartete Klangreise."
    ],
    "en": [
      "Halfway between musical theater and animated concert, this complicit duo between a virtuoso pianist and violinist-artist takes novices and music lovers alike on a journey of sound as playful as it is unexpected."
    ],
    "it": [
      "A metà strada tra il teatro musicale e il concerto d'animazione, questo duetto tra un pianista virtuoso e un violinista-altista accompagna gli amanti della musica e i neofiti in un viaggio sonoro tanto giocoso quanto inaspettato."
    ],
    "fr": [
      "À mi-chemin entre théâtre musical et concert animé, ce duo complice entre une pianiste et un violoniste-altiste virtuoses embarque néophytes comme mélomanes dans un voyage sonore aussi ludique qu’inattendu."
    ],
    "nl": [
      "Dit duet tussen een virtuoze pianist en violist-altist houdt het midden tussen muziektheater en een geanimeerd concert en neemt muziekliefhebbers en beginners mee op een even speelse als onverwachte klankreis."
    ],
    "es": [
      "A medio camino entre el teatro musical y el concierto de animación, este dúo entre un pianista virtuoso y un violinista-artista lleva a melómanos y noveles a un viaje sonoro tan lúdico como inesperado."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Théâtre : L'Abécédaire musicale - Romans"
    ]
  },
