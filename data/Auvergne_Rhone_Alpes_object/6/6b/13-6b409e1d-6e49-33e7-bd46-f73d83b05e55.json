  "rdfs:comment": {
    "de": [
      "Agnès Ramillon konzipiert für Unternehmen Kochworkshops, um die individuellen Fähigkeiten in den Dienst des Kollektivs zu stellen, oder in Form von kulinarischen Herausforderungen.\r\nFür Privatpersonen bietet Agnès maßgeschneiderte Kochworkshops bei Ihnen zu Hause an."
    ],
    "en": [
      "For companies, Agnès Ramillon designs cooking workshops to put individual skills at the service of the collective, or in the form of culinary challenges.\r\nFor individuals, Agnès offers tailor-made in-home cooking workshops."
    ],
    "it": [
      "Agnès Ramillon progetta laboratori di cucina per le aziende, utilizzando le competenze individuali a beneficio del gruppo o sotto forma di sfide culinarie.\r\nPer i singoli, Agnès offre laboratori di cucina su misura a domicilio."
    ],
    "fr": [
      "Agnès Ramillon conçoit pour les entreprises des ateliers cuisine pour mettre les compétences individuelles au service du collectif ou sous forme de défis culinaires. \r\nPour les particuliers Agnès propose des ateliers cuisine sur-mesure à domicile."
    ],
    "nl": [
      "Agnès Ramillon ontwerpt kookworkshops voor bedrijven, waarbij individuele vaardigheden worden ingezet voor de groep of in de vorm van culinaire uitdagingen.\r\nVoor particulieren biedt Agnès kookworkshops op maat aan huis."
    ],
    "es": [
      "Agnès Ramillon diseña talleres de cocina para empresas, utilizando las habilidades individuales en beneficio del grupo o en forma de retos culinarios.\r\nPara los particulares, Agnès ofrece talleres de cocina a domicilio hechos a medida."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les carnets d'Agnès"
    ]
  },
