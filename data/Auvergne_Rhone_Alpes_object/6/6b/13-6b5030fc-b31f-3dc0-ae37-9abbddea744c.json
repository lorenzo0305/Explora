  "rdfs:comment": {
    "de": [
      "Auf einer Fläche von 1000m² erwarten Sie zahlreiche Fahrzeuge aus den Jahren 1920 bis 1980. Jedes Fahrzeug wird in seinen Kontext gestellt, sei es politisch, sozial, kulturell oder sportlich."
    ],
    "en": [
      "Numerous vehicles from the 1920s to the 1980s await you over an area of 1000m². Each vehicle is placed in its political, social, cultural or sporting context."
    ],
    "it": [
      "Su una superficie di 1000m² vi aspettano numerosi veicoli dagli anni '20 agli anni '80. Ogni veicolo è inserito nel suo contesto politico, sociale, culturale o sportivo."
    ],
    "fr": [
      "De nombreux véhicules des années 1920 à 1980 vous attendent sur une surface de 1000m². Chaque véhicule est replacé dans son contexte que ce soit politique, social, culturel ou sportif."
    ],
    "es": [
      "Numerosos vehículos de los años veinte a los ochenta le esperan en una superficie de 1.000 m². Cada vehículo se sitúa en su contexto político, social, cultural o deportivo."
    ],
    "nl": [
      "50 voertuigen uit de jaren 1910 tot 1980 wachten op u. Elk voertuig wordt in zijn context geplaatst, politiek, sociaal, cultureel of sportief."
    ]
  },
