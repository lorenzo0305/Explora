  "rdfs:comment": {
    "de": [
      "Climb Up Saint-Etienne ist ein 1800 m² großes Gelände, das dem Klettern von Routen und Bouldern gewidmet ist! Sport- oder Freizeitklettern für Kinder und Erwachsene, vom Anfänger bis zum erfahrenen Kletterer - klettern Sie!"
    ],
    "en": [
      "Climb Up Saint-Etienne is an 1800m² space dedicated to route and bouldering climbing! Whether for sport or leisure, for children and adults, from beginners to advanced climbers, it's up to you to climb!"
    ],
    "it": [
      "Climb Up Saint-Etienne è uno spazio di 1800 m² dedicato al bouldering e all'arrampicata su vie! Arrampicata sportiva o per il tempo libero per bambini e adulti, da principianti a esperti, sta a voi scalare!"
    ],
    "fr": [
      "Climb Up Saint-Etienne, c'est un espace de 1800m² dédié à l’escalade de voies et de bloc ! Pratique sportive ou loisir pour les enfants et adultes, du débutant aux grimpeurs confirmés, à vous de grimper !"
    ],
    "nl": [
      "Climb Up Saint-Etienne is een ruimte van 1800m² gewijd aan klimroutes en boulderen! Sportief of recreatief klimmen voor kinderen en volwassenen, van beginners tot ervaren klimmers, het is aan jou om te klimmen!"
    ],
    "es": [
      "Climb Up Saint-Etienne es un espacio de 1800m² dedicado a las vías de escalada y al boulder Escalada deportiva o de ocio para niños y adultos, desde principiantes hasta escaladores experimentados, ¡tú decides cómo escalar!"
    ]
  },
  "rdfs:label": {
    "en": [
      "Climb up Saint-Etienne"
    ],
    "fr": [
      "Salle d'escalade Climb up Saint-Etienne"
    ]
  },
