  "rdfs:comment": {
    "de": [
      "Les Étincelles\" sind bereit, die Kohlen für das Festival der Heiligen Barbara auszublasen. \"Les Étincelles\" bieten eine Vielzahl von Veranstaltungen an, die das Erbe des Bergbaus beleuchten."
    ],
    "en": [
      "Les Étincelles are ready to blow on the embers of the Festival de la Sainte-Barbe. \"Les Étincelles\" offer a multitude of events highlighting mining heritage."
    ],
    "it": [
      "Les Étincelles sono pronte a soffiare sulle braci del Festival de la Sainte-Barbe. \"Les Étincelles\" offre una serie di eventi che valorizzano il patrimonio minerario."
    ],
    "fr": [
      "Les Étincelles sont prêtes à souffler sur les braises du Festival de la Sainte-Barbe. \"Les Étincelles\" proposent une multitude d'événements mettant en lumière le patrimoine minier."
    ],
    "nl": [
      "Les Étincelles zijn klaar om de sintels van het Festival de la Sainte-Barbe aan te blazen. \"Les Étincelles' biedt een hele reeks evenementen die het mijnerfgoed in de kijker zetten."
    ],
    "es": [
      "Les Étincelles están listas para soplar las brasas del Festival de la Sainte-Barbe. \"Les Étincelles\" ofrece un sinfín de eventos que ponen de relieve el patrimonio minero."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les étincelles du Festival de la Sainte Barbe - Rencontre littéraire avec Hévan Picavet, auteur de Réduite au silence"
    ]
  },
