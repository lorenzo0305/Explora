  "rdfs:comment": {
    "de": [
      "Die Quellenhalle wurde 1903 von den Architekten Charles Le C?ur und Lucien Woog erbaut und befindet sich an der Stelle, an der die Quellen Chomel und Grande Grille entspringen und wo sich die ersten Badeanstalten befanden."
    ],
    "en": [
      "Located where the Chomel and Grande Grille springs emerge, on the site of the first bathing establishments, the Hall des Sources was built in 1903 by architects Charles Le C?ur and Lucien Woog."
    ],
    "it": [
      "La Hall des Sources fu costruita nel 1903 dagli architetti Charles Le C?ur e Lucien Woog sul sito delle sorgenti Chomel e Grande Grille, dove si trovavano i primi bagni."
    ],
    "fr": [
      "Situé sur le lieu d’émergence des sources Chomel et Grande Grille, à l’emplacement des premiers établissements de bains, le hall des sources a été construit en 1903 par les architectes Charles Le Cœur et Lucien Woog."
    ],
    "es": [
      "El Hall des Sources fue construido en 1903 por los arquitectos Charles Le Cœur y Lucien Woog en el emplazamiento de los manantiales de Chomel y Grande Grille, donde se encontraban los primeros baños."
    ],
    "nl": [
      "De Hall des Sources werd in 1903 gebouwd door architecten Charles Le C?ur en Lucien Woog op de plek van de bronnen van Chomel en Grande Grille, waar zich de eerste baden bevonden."
    ]
  },
