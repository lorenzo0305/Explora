  "rdfs:comment": {
    "de": [
      "In Mexiko ist die Cantina ein beliebter Ort, an dem Essen und Trinken serviert wird, und genau das finden Sie hier! Tacos, Tortas, selbstgebrautes Bier, Brunch. Frische Produkte, die vor Ort gekocht werden. Täglich geöffnet."
    ],
    "en": [
      "In Mexico, a cantina is an unpretentious place where you can get a drink and a bite to eat – and that's exactly what you'll find here! Tacos, tortas, craft beers, brunch. Fresh ingredients cooked on site. Open daily."
    ],
    "it": [
      "In Messico, la Cantina è un luogo popolare per mangiare e bere ed è esattamente quello che troverete qui! Tacos, tortas, birre artigianali, brunch. Cibo fresco cucinato in loco. Aperto tutti i giorni."
    ],
    "fr": [
      "Au Mexique, la Cantina est un lieu populaire où l'on sert à boire et à manger et c'est exactement ce que vous trouverez ici ! Tacos, tortas, bières artisanales, brunch. Produits frais cuisinés sur place. Ouvert tous les jours."
    ],
    "nl": [
      "In Mexico is de Cantina een populaire plek om te eten en te drinken en dat is precies wat je hier zult vinden! Tacos, tortas, ambachtelijke bieren, brunch. Vers voedsel ter plaatse gekookt. Elke dag open."
    ],
    "es": [
      "En México, la cantina es un lugar popular para comer y beber, ¡y eso es exactamente lo que encontrarás aquí! Tacos, tortas, cervezas artesanales, brunch. Comida fresca cocinada in situ. Abierto todos los días."
    ]
  },
