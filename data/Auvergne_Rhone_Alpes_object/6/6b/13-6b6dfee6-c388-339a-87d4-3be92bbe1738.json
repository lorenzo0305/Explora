  "rdfs:comment": {
    "de": [
      "Produzent und Verarbeiter von Heilpflanzen, darunter auch Aktivhanf.\r\nIch verarbeite die Pflanzen zu Sirupen, Kräutertees, Hydrolaten, Aromaten und einem ganzen Sortiment auf Hanfbasis (CBD). - Pädagogischer Bauernhof"
    ],
    "en": [
      "Producer and processor of medicinal plants, including active hemp.\r\nI transform plants into syrups, infusions, hydrolats, aromatics and a whole range of hemp-based products (CBD). - Educational farm"
    ],
    "it": [
      "Produttore e trasformatore di piante medicinali, tra cui la canapa attiva.\r\nTrasformo le piante in sciroppi, infusi, idrolati, aromi e un'intera gamma di prodotti a base di canapa (CBD). - Fattoria didattica"
    ],
    "fr": [
      "Producteur transformateur de plantes médicinales dont le chanvre à actif.\r\nJe transforme les plantes en sirops, infusions, hydrolats, aromates, et tout une gamme à base de chanvre (CBD). - Ferme pédagogique"
    ],
    "es": [
      "Productor y transformador de plantas medicinales, incluido el cáñamo activo.\r\nTransformo las plantas en jarabes, infusiones, hidrolatos, aromatizantes y toda una gama de productos a base de cáñamo (CBD). - Granja educativa"
    ],
    "nl": [
      "Producent en verwerker van medicinale planten, waaronder actieve hennep.\r\nIk verwerk de planten tot siropen, infusies, hydrolaten, aromaten en een hele reeks producten op basis van hennep (CBD). - Educatieve boerderij"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Kanarom - Les Arômes de Genas"
    ]
  },
