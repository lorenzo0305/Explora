  "rdfs:comment": {
    "de": [
      "Das einzige 4-Sterne-Hotel in Val Cenis liegt am Fuße der Pisten und des Mont Cenis-Passes und verbindet Charme und Authentizität. Jedes der 82 Zimmer verfügt über einen Balkon mit Panoramablick auf die Pisten oder die Vanoise."
    ],
    "en": [
      "Only 4 star hotel in Val Cenis, this modern chalet at the foot of the ski slopes and Mont Cenis col belends charm and authenticity. All the rooms offer a balcony with panoramic view over the slopes or the Vanoise mountains."
    ],
    "it": [
      "L'unico hotel a 4 stelle della Val Cenis, situato ai piedi delle piste e del passo del Mont Cenis, unisce fascino e autenticità. Ognuna delle 82 camere dispone di un balcone con vista panoramica sulle piste o sulla Vanoise."
    ],
    "fr": [
      "Seul hôtel 4 étoiles de Val Cenis, situé au pied des pistes et du col du Mont Cenis, il mêle charme et authenticité. Chacune des 82 chambres dispose d’un balcon avec une vue panoramique sur les pistes ou sur la Vanoise."
    ],
    "es": [
      "Único hotel de 4 estrellas de Val Cenis, situado al pie de las pistas y del puerto del Mont Cenis, combina encanto y autenticidad. Cada una de las 82 habitaciones dispone de un balcón con vistas panorámicas a las pistas o a la Vanoise."
    ],
    "nl": [
      "Dit moderne chalet, het enige 4-sterrenhotel in Val Cenis, aan de voet van de hellingen en de Mont Cenis-pas, combineert charme en authenticiteit. Elk van de 84 kamers heeft een balkon met een panoramisch uitzicht op de hellingen of de Vanoise."
    ]
  },
