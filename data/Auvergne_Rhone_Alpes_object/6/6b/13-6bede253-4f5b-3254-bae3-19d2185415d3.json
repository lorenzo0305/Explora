  "rdfs:comment": {
    "de": [
      "Henri Matisse im Abenteuer des Stoffes, 3/7 bis 18/10\r\nLe Doyenné, Erbschatzkästchen für zeitgenössische Kunst, das von der reichen historischen Vergangenheit Brioudes zeugt."
    ],
    "en": [
      "Henri Matisse dans l?aventure du tissu, from 3/7 to 18/10\r\nLe Doyenné, a heritage showcase for contemporary art that bears witness to Brioude?s rich historical past."
    ],
    "it": [
      "Henri Matisse nell'avventura del tessuto, dal 3/7 al 18/10\r\nLe Doyenné, un patrimonio d'arte contemporanea che testimonia il ricco passato storico di Brioude."
    ],
    "fr": [
      "Henri Matisse dans l’aventure du tissu, du 3/7 au 18/10\r\nLe Doyenné, écrin patrimonial d’art contemporain témoin d'un riche passé historique de Brioude."
    ],
    "nl": [
      "Henri Matisse in het avontuur van de stof, van 3/7 tot 18/10\r\nLe Doyenné, een erfgoed voor hedendaagse kunst dat getuigt van het rijke historische verleden van Brioude."
    ],
    "es": [
      "Henri Matisse en la aventura de la tela, del 3/7 al 18/10\r\nLe Doyenné, patrimonio de arte contemporáneo testigo del rico pasado histórico de Brioude."
    ]
  },
