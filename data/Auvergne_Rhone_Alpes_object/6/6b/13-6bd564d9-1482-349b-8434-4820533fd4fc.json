  "rdfs:comment": {
    "de": [
      "Angeln ist von März bis November im Privatsee von Saint-André möglich. Tages-, Monats- und Jahreskarten sind für Kinder unter 12 Jahren kostenlos. Hechte, Forellen, Karpfen, Barsche? Spezielle Quoten und Regeln."
    ],
    "en": [
      "Fishing is open from March to November at the private Saint-André lake. Daily, monthly or yearly passes, free for children under 12. Pike, trout, carp, perch? Specific quotas and regulations."
    ],
    "it": [
      "La pesca è aperta da marzo a novembre sul lago privato di Saint-André. Sono disponibili tessere giornaliere, mensili o annuali, gratuite per i bambini sotto i 12 anni. Luccio, trota, carpa, persico? Quote e regolamenti specifici."
    ],
    "fr": [
      "La pêche est ouverte de mars à novembre au lac privé de Saint-André. Cartes à la journée, au mois ou à l’année, gratuites pour les moins de 12 ans. Brochets, truites, carpes, perches… Quotas et règlement spécifiques."
    ],
    "nl": [
      "Vissen kan van maart tot november op het privémeer van Saint-André. Dag-, maand- of jaarkaarten zijn verkrijgbaar, gratis voor kinderen onder de 12 jaar. Snoek, forel, karper, baars? Specifieke quota en voorschriften."
    ],
    "es": [
      "De marzo a noviembre se puede pescar en el lago privado de Saint-André. Existen abonos diarios, mensuales o anuales, gratuitos para los menores de 12 años. Lucio, trucha, carpa, perca.. Cuotas y reglamentos específicos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Pêche au lac Saint-André"
    ]
  },
