  "rdfs:comment": {
    "de": [
      "Pizzas zum Essen vor Ort oder zum Mitnehmen. Es werden verschiedene Geschmacksrichtungen angeboten:\n- geschmacksrichtungen aus Italien\n- geschmacksrichtungen aus aller Welt\n- pizzas für Feinschmecker\nnicht zu vergessen die :\n- klassische Pizzas\nSie können auch Paninis probieren."
    ],
    "en": [
      "Pizzas to eat in or take away. Different flavours on offer:\n- italian flavours\n- world flavors\n- gourmet pizzas\nnot forgetting :\n- classic pizzas\nYou can also enjoy paninis."
    ],
    "it": [
      "Pizze da mangiare o da portare via. Sono disponibili diversi gusti:\n- gusti italiani\n- sapori da tutto il mondo\n- pizze per buongustai\nsenza dimenticare :\n- pizze classiche\nPotete anche provare i nostri panini."
    ],
    "fr": [
      "Pizzas à manger sur place ou à emporter. Différentes saveurs sont proposées :\n- saveurs d'Italie\n- saveurs du Monde\n- pizzas pour gourmets\nsans oublier les :\n- pizzas classiques\nVous pourrez aussi déguster des paninis."
    ],
    "es": [
      "Pizzas para comer en casa o para llevar. Disponemos de diferentes sabores:\n- sabores italianos\n- sabores de todo el mundo\n- pizzas para gourmets\nsin olvidar :\n- pizzas clásicas\nTambién puede probar nuestros paninis."
    ],
    "nl": [
      "Pizza's om te eten of om mee te nemen. Er zijn verschillende smaken verkrijgbaar:\n- italiaanse smaken\n- smaken uit de hele wereld\n- pizza's voor fijnproevers\nniet te vergeten :\n- klassieke pizza's\nJe kunt ook onze panini's proberen."
    ]
  },
  "rdfs:label": {
