  "rdfs:comment": {
    "de": [
      "Chez Nadia ist eine natürlich schattige Terrasse, wenn Sie zum alten Dorf hinaufgehen. Wir bieten Ihnen eine Küche aus aller Welt, alles hausgemacht!"
    ],
    "en": [
      "Chez Nadia is a naturally shaded terrace on the way up to the old village. We offer world cuisine, all homemade!"
    ],
    "it": [
      "Chez Nadia è una terrazza naturalmente ombreggiata sulla strada che porta al vecchio villaggio. Offriamo una cucina mondiale, tutta fatta in casa!"
    ],
    "fr": [
      "Chez Nadia c'est une terrasse ombragée naturellement en montant vers le vieux village. Nous vous proposons une cuisine du monde, le tout fait maison !"
    ],
    "nl": [
      "Chez Nadia is een natuurlijk schaduwrijk terras op weg naar het oude dorp. We bieden wereldkeuken, allemaal zelfgemaakt!"
    ],
    "es": [
      "Chez Nadia es una terraza con sombra natural en la subida al pueblo viejo. Ofrecemos cocina del mundo, ¡todo casero!"
    ]
  },
  "rdfs:label": {
    "en": [
      "Bar à Thym"
    ],
