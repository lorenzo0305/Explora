  "rdfs:comment": {
    "de": [
      "Im West Angus Saloon werden sowohl alkoholische als auch nichtalkoholische Getränke angeboten. Sie können die Fleischprodukte des Bauernhofs probieren, die an dem in den Speisesaal integrierten Foodtruck serviert werden. Silo Bar. Themenabende und Konzerte. Terrasse mit Außenbar."
    ],
    "en": [
      "The West Angus Saloon offers both alcoholic and non-alcoholic beverages. You can sample farm-fresh meat products served at the Foodtruck integrated into the dining room. Silo bar. Theme evenings and concerts. Terrace with outdoor bar."
    ],
    "it": [
      "Il West Angus Saloon offre bevande alcoliche e analcoliche. È possibile assaggiare i prodotti a base di carne della fattoria serviti al Foodtruck integrato nella sala da pranzo. Bar Silo. Serate a tema e concerti. Terrazza con bar all'aperto."
    ],
    "fr": [
      "Le West Angus  Saloon propose des boissons, alcoolisées ou non. Vous pourrez déguster les produits carnés de la ferme servis au  Foodtruck intégré dans la salle de restauration. Bar silo. Soirées à thème et concerts. Terrasse avec bar extérieur."
    ],
    "es": [
      "El West Angus Saloon ofrece bebidas alcohólicas y no alcohólicas. Puede degustar los productos cárnicos de la granja servidos en el Foodtruck integrado en el comedor. Bar Silo. Veladas temáticas y conciertos. Terraza con bar al aire libre."
    ],
    "nl": [
      "De West Angus Saloon biedt zowel alcoholische als niet-alcoholische drankjes. Je kunt de vleesproducten van de boerderij proeven in de Foodtruck die in de eetzaal is geïntegreerd. Silo bar. Thema-avonden en concerten. Terras met buitenbar."
    ]
  },
