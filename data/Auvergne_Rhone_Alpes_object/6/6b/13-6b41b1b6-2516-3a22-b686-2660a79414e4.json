  "rdfs:comment": {
    "de": [
      "Das Schiff hat seinen Sitz im Jachthafen von Pont-de-Vaux und bietet ganztägige Kreuzfahrten mit oder ohne Mahlzeiten und Schleusendurchfahrten auf dem Kanal von Pont-de-Vaux, der Saône oder der Seille an."
    ],
    "en": [
      "Based at the Pont-de-Vaux marina, this boat offers day cruises with or without meals and lock passages on the Pont-de-Vaux, Saône or Seille canals."
    ],
    "it": [
      "Con base al porto turistico di Pont-de-Vaux, questo battello offre crociere di un giorno con o senza pasti e passaggi di chiusa sui canali di Pont-de-Vaux, Saône o Seille."
    ],
    "fr": [
      "Basé au port de Plaisance de Pont-de-Vaux, ce bateau assure des croisières avec ou sans repas et passage d'écluses à la journée sur le canal de Pont-de- Vaux, la Saône ou la Seille."
    ],
    "nl": [
      "Deze boot ligt in de jachthaven van Pont-de-Vaux en biedt dagtochten met of zonder maaltijden en sluizen op het kanaal Pont-de-Vaux, de Saône of de Seille."
    ],
    "es": [
      "Con base en el puerto deportivo de Pont-de-Vaux, este barco ofrece cruceros de un día con o sin comidas y pases de esclusas por los canales de Pont-de-Vaux, Saône o Seille."
    ]
  },
  "rdfs:label": {
    "de": [
      "Restaurantschiff \"Ville de Pont de Vaux 2\" (Stadt Pont de Vaux 2)"
    ],
    "en": [
      "\"Ville de Pont de Vaux 2\" restaurant boat"
    ],
    "fr": [
      "Bateau restaurant \"Ville de Pont de Vaux 2\""
    ],
    "nl": [
      "Restaurantboot \"Ville de Pont de Vaux 2\""
    ]
  },
