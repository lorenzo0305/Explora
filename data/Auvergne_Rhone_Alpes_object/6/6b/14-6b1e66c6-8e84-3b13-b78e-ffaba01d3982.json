  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/7fd48ab1-3046-3a05-8b0f-5a68c2a96bfd",
      "dc:description": {
        "de": [
          "Verpflegung nach Wahl:\nKeeper, Kartoffeln - Dessert (+ ein optionales Getränk)\n2 gegrillte Heringe - Dessert und 1 Getränk\n\nKonzerte :\n12:00 Uhr Les Vareuses Porteloises (Die Jacken von Portelois)\n14 Uhr Jameson and Power\n16 Uhr Irish Frog"
        ],
        "en": [
          "Choice of catering:\nKeeper, potato and dessert (+ one optional drink)\n2 grilled herring - dessert and 1 drink\n\nConcerts :\n12h Les Vareuses Porteloises\n2pm Jameson and Power\n4pm Irish Frog"
        ],
        "it": [
          "Ristorazione a scelta:\nCestino, patata e dessert (+ una bevanda facoltativa)\n2 aringhe alla griglia - dessert e 1 bevanda\n\nConcerti :\n12:00 Les Vareuses Porteloises\n14:00 Jameson e Power\n16:00 Rana irlandese"
        ],
        "fr": [
          "Restauration au choix:\nFormule keeper, pomme de terre - dessert (+ une boisson en option)\n2 harengs grillés - dessert et 1 boisson \n\nConcerts : \n12h Les Vareuses Porteloises \n14h Jameson and Power \n16h Irish Frog"
        ],
        "es": [
          "Opción de catering:\nConservador, patata y postre (+ una bebida opcional)\n2 arenques a la plancha - postre y 1 bebida\n\nConciertos :\n12h Les Vareuses Porteloises\n14h Jameson y Power\n16h Irish Frog"
        ],
        "nl": [
          "Keuze uit catering:\nKeeper, aardappel en dessert (+ een optioneel drankje)\n2 gegrilde haringen - dessert en 1 drankje\n\nConcerten :\n12u Les Vareuses Porteloises\n14u Jameson en Power\n16u Ierse kikker"
        ]
      },
