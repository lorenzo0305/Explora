  "rdfs:comment": {
    "de": [
      "Entdecken Sie dieses Restaurant am Place des Clercs. Ein Tagesgericht oder einen Rum genießen, hier wird alles getan, damit Sie eine angenehme Zeit verbringen."
    ],
    "en": [
      "Come and discover this restaurant on Place des Clercs. Whether it's a dish of the day or a rum tasting, we'll make sure you have a great time."
    ],
    "it": [
      "Venite a scoprire questo ristorante/pizzeria in Place des Clercs. Che si tratti di un piatto del giorno o di un bicchiere di rum, ci assicuriamo che vi divertiate."
    ],
    "fr": [
      "Venez découvrir ce restaurant/pizzeria de la Place des Clercs. Un plat du jour ou déguster un rhum, tout sera fait pour que vous passiez un agréable moment."
    ],
    "es": [
      "Venga a descubrir este restaurante-pizzería de la Place des Clercs. Ya sea un plato del día o una copa de ron, nos encargaremos de que lo pases en grande."
    ],
    "nl": [
      "Kom en ontdek dit restaurant op Place des Clercs. Of het nu gaat om een dagschotel of een rumproeverij, alles wordt in het werk gesteld om het je naar de zin te maken."
    ]
  },
  "rdfs:label": {
