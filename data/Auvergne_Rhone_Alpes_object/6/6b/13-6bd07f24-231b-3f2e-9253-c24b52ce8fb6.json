  "rdfs:comment": {
    "de": [
      "8 ha großer Teich, reich an Raubfischen, Karpfen und Weißfischen, zugänglich für alle Personen, die einen Bundesfischereischein besitzen. Angelzeit für Nachtkarpfen. 3 Picknicktische."
    ],
    "en": [
      "8-hectare pond with a rich diversity of carnivorous fish, carp and whitefish, open to anyone holding a federal fishing permit. Night carp fishing period. 3 picnic tables."
    ],
    "it": [
      "Questo lago di 8 ettari è ricco di pesci carnivori, carpe e coregoni, ed è aperto a chiunque sia in possesso di una licenza di pesca federale. Periodo di pesca notturna alla carpa. 3 tavoli da picnic."
    ],
    "fr": [
      "Étang de 8 ha riche en carnassiers, carpes et poissons blancs, accessible à toute personne détenant une carte de pêche fédérale. Période de pêche carpe de nuit. 3 tables de pique-nique."
    ],
    "es": [
      "Este lago de 8 hectáreas es rico en peces carnívoros, carpas y peces blancos, y está abierto a cualquier persona que posea una licencia federal de pesca. Periodo de pesca nocturna de carpas. 3 mesas de picnic."
    ],
    "nl": [
      "Dit meer van 8 hectare is rijk aan vleesetende vissen, karper en witvis en is toegankelijk voor iedereen met een federale visvergunning. Nachtelijke periode voor karpervissen. 3 picknicktafels."
    ]
  },
  "rdfs:label": {
    "en": [
      "pond"
    ],
    "fr": [
      "Étang de Gouzolles"
    ]
  },
