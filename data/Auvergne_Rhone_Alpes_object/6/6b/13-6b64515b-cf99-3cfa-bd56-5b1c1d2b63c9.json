  "rdfs:comment": {
    "de": [
      "Ihr Taxi in Drôme des Collines & Umgebung!\r\nFür alle Ihre privaten und beruflichen Fahrten: Bahnhof, Flughafen, alle Entfernungen.\r\nVerfügbar 7/7 &24h/24.\r\nFahrzeug mit 7 Sitzen."
    ],
    "en": [
      "Your cab in and around Drôme des Collines!\r\nFor all your private and business trips: station, airport, all distances.\r\nAvailable 24/7.\r\n7-seater vehicle."
    ],
    "it": [
      "Il vostro taxi nella Drôme des Collines e dintorni!\r\nPer tutti i vostri spostamenti privati e di lavoro: stazione, aeroporto, tutte le distanze.\r\nDisponibile 24 ore su 24, 7 giorni su 7.\r\nVeicolo a 7 posti."
    ],
    "fr": [
      "Votre taxi en Drôme des Collines & alentours ! \r\nPour tous vos trajets privés et professionnels : gare, aéroport, toutes distances.\r\nDisponible 7j/7 &24h/24.\r\nVéhicule 7 places."
    ],
    "es": [
      "¡Su taxi en Drôme des Collines y alrededores!\r\nPara todos sus desplazamientos privados y profesionales: estación, aeropuerto, todas las distancias.\r\nDisponible 24 horas al día, 7 días a la semana.\r\nVehículo de 7 plazas."
    ],
    "nl": [
      "Uw taxi in en rond Drôme des Collines!\r\nVoor al je privé- en zakelijke ritten: station, vliegveld, alle afstanden.\r\n24/7 beschikbaar.\r\nVoertuig met 7 zitplaatsen."
    ]
  },
