  "rdfs:comment": {
    "de": [
      "Familienwanderungen + 5 Jahre 4/5 km ...\r\nLassen Sie sich von der Sanftheit und dem Charme einer gastfreundlichen Region verführen ...\r\nLe Pont d'Arc, gouffre d'Orgnac, Les Gorges de l'Ardèche. Wir führen Sie auch zu den besten Beobachtungspunkten für Raubvögel."
    ],
    "en": [
      "Family-friendly 4/5km tours for over 5s.\r\nSoak up the magic of a warm and friendly region...\r\nThe Pont d'Arc, Gouffre d'Orgnac and Ardèche Gorges. We'll also take you to amazing sites to spot birds of prey."
    ],
    "it": [
      "Gite in famiglia + 5 anni 4/5 km...\r\nLasciatevi sedurre dalla dolcezza e dal fascino di una regione accogliente...\r\nIl Pont d'Arc, la voragine di Orgnac, le gole dell'Ardèche. Vi porteremo anche in alcuni dei luoghi migliori per osservare i rapaci."
    ],
    "fr": [
      "Balades Familiales + 5 ans 4/5 km..\r\nLaissez vous séduire par la douceur et les charmes d'une région accueillante ..\r\nLe Pont d'Arc, gouffre d'Orgnac, Les Gorges de l’Ardèche. Nous vous conduisons aussi sur des points privilégiés d’observation des rapaces."
    ],
    "es": [
      "Paseos en familia + 5 años 4/5 km...\r\nDéjese seducir por la dulzura y los encantos de una región acogedora...\r\nEl Pont d'Arc, la sima de Orgnac, las gargantas del Ardèche. También le llevaremos a algunos de los mejores lugares para observar aves rapaces."
    ],
    "nl": [
      "Gezinsuitstapjes + 5 jaar 4/5 km...\r\nLaat je verleiden door de zachtheid en de charmes van een gastvrije streek...\r\nDe Pont d'Arc, de kloof van Orgnac, de kloven van de Ardèche. We nemen je ook mee naar de beste plekken om roofvogels te kijken."
    ]
  },
