  "rdfs:comment": {
    "de": [
      "Als selbstständige Skilehrerin ist Sandrine auf Kinder im Alter von 4/13 Jahren spezialisiert. Test und Medaille am Ende der Woche. Im Sommer/Frühjahr/Herbst werden 5/6-tägige Trapper-Kurse für 4/13-Jährige angeboten, die von Profis betreut werden."
    ],
    "en": [
      "Sandrine is a freelance ski instructor specialising in children aged 4/13. Test and medal at the end of the week. During the summer/spring/autumn, we offer 5/6 day Trapper courses for 4/13 year olds, supervised by professionals."
    ],
    "it": [
      "Sandrine è una maestra di sci freelance specializzata in bambini dai 4 ai 13 anni. Test e medaglia alla fine della settimana. Durante l'estate/primavera/autunno, offriamo corsi Trapper di 5/6 giorni per bambini di 4/13 anni, sotto la supervisione di professionisti."
    ],
    "fr": [
      "Monitrice de ski indépendante, Sandrine est spécialisée pour les enfants de 4/13 ans. Passage de test et médaille en fin de semaine. Durant l'été/ printemps/ automne, proposition de stages Trappeurs de 5/6 jours, pour les 4/13 ans, encadré par des pros."
    ],
    "nl": [
      "Sandrine is een freelance skilerares gespecialiseerd in kinderen van 4/13 jaar. Test en medaille aan het einde van de week. Tijdens de zomer/voorjaar/herfst bieden we 5/6-daagse Trapper-cursussen voor 4/13-jarigen onder begeleiding van professionals."
    ],
    "es": [
      "Sandrine es monitora de esquí autónoma especializada en niños de 4/13 años. Prueba y medalla al final de la semana. Durante el verano/primavera/otoño, ofrecemos cursos de Trapper de 5/6 días para niños de 4/13 años, supervisados por profesionales."
    ]
  },
  "rdfs:label": {
