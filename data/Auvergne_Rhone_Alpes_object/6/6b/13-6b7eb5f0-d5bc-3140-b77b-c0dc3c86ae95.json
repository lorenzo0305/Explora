  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Abenteuer mit Schlittenhunden auf dem Plateau von Vercors. Gleiten Sie durch märchenhafte Landschaften . Ein einzigartiges Erlebnis in Vassieux-en-Vercors, geführt von passionierten Mushers und ihren Hunden."
    ],
    "en": [
      "Discover the adventure of dog sledding on the Vercors plateau. Glide through magical landscapes. A unique experience in Vassieux-en-Vercors, guided by passionate mushers and their dogs."
    ],
    "it": [
      "Scoprite l'avventura della slitta trainata dai cani sull'altopiano del Vercors. Scivolate attraverso paesaggi magici. Un'esperienza unica a Vassieux-en-Vercors, guidata da appassionati mushers e dai loro cani."
    ],
    "fr": [
      "Découvrez l'aventure en chiens de traîneaux sur le plateau du Vercors. Glissez à travers des paysages féeriques . Une expérience unique à Vassieux-en-Vercors, guidée par des mushers passionnés et leurs chiens."
    ],
    "nl": [
      "Ontdek het avontuur van hondensleeën op het plateau van de Vercors. Glijd door magische landschappen. Een unieke ervaring in Vassieux-en-Vercors, begeleid door gepassioneerde mushers en hun honden."
    ],
    "es": [
      "Descubra la aventura de los trineos tirados por perros en la meseta del Vercors. Deslícese por paisajes mágicos. Una experiencia única en Vassieux-en-Vercors, guiada por apasionados mushers y sus perros."
    ]
  },
