  "rdfs:comment": {
    "de": [
      "Sie wurde 1938 eingeweiht und 1940 fertiggestellt. Seit 2024 ist sie als historisches Denkmal geschützt und dient dem neuen Bahnhofsbereich. \r\nDas Denkmal ist als «Erbe des 20. Jahrhunderts» gekennzeichnet.\r\nSie ist seit 2026 unter Denkmalschutz gestellt"
    ],
    "en": [
      "Consecrated in 1938 and completed in 1940, it has been protected as a Historic Monument since 2024 and serves the new station district. \r\nThe monument is labelled as 'heritage of the 20th century'.\r\nIt has been classified as a Historical Monument since 2026"
    ],
    "it": [
      "Consacrata nel 1938 e completata nel 1940, è protetta come monumento storico dal 2024 e serve il nuovo quartiere della stazione.\r\nIl monumento ha ottenuto il marchio \"Patrimonio del XX secolo\".\r\nÈ stato classificato come Monumento storico dal 2026"
    ],
    "fr": [
      "Consacrée en 1938 et achevée en 1940, elle est depuis 2024, protégée au titre des Monuments Historiques. et dessert le nouveau quartier de la gare. \r\nLe monument est labellisé « patrimoine du XXe siècle ».\r\nElle est classée Monument Historique depuis 2026"
    ],
    "nl": [
      "Gewijd in 1938 en voltooid in 1940, is het sinds 2024 beschermd als historisch monument en bedient het nieuwe stationsdistrict. \r\nHet monument wordt bestempeld als 'erfgoed van de 20e eeuw'.\r\nHet is sinds 2026 geclassificeerd als een historisch monument"
    ],
    "es": [
      "Consagrada en 1938 y terminada en 1940, está protegida como Monumento Histórico desde 2024. y da servicio al distrito de la nueva estación.\r\nEl monumento ha recibido la etiqueta de \"patrimonio del siglo XX\".\r\nEstá clasificado como Monumento Histórico desde 2026"
    ]
  },
