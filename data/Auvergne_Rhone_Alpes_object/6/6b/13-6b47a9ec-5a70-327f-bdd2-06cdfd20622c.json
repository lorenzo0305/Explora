  "rdfs:comment": {
    "de": [
      "Das zwischen 1150 und 1250 auf einem Felsvorsprung über dem Fluss Sioule errichtete Rochefort war Teil des militärischen Dispositivs des Lehens der Herren von Bourbon (ISMH und eingetragene Stätte)."
    ],
    "en": [
      "Built between 1150 and 1250 on a rocky spur overlooking the Sioule River, Rochefort was part of the military structure of the fiefdom of the Lords of Bourbon (ISMH and listed site)."
    ],
    "it": [
      "Costruita tra il 1150 e il 1250 su uno sperone roccioso che domina la Sioule, Rochefort faceva parte della struttura militare del feudo dei signori di Borbone (ISMH e sito classificato)."
    ],
    "fr": [
      "Édifié sur un éperon rocheux dominant la Sioule, Rochefort construit entre 1150 et 1250 faisait partie du dispositif militaire du fief des seigneurs de Bourbon. (ISMH et site inscrit)."
    ],
    "nl": [
      "Rochefort werd tussen 1150 en 1250 gebouwd op een rotsachtige uitloper met uitzicht op de Sioule en maakte deel uit van de militaire structuur van het leengoed van de Heren van Bourbon (ISMH en geklasseerde site)."
    ],
    "es": [
      "Construido entre 1150 y 1250 sobre un espolón rocoso que domina la Sioule, Rochefort formaba parte de la estructura militar del feudo de los señores de Borbón (ISMH y sitio catalogado)."
    ]
  },
