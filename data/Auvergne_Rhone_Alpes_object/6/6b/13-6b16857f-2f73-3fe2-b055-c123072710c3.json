  "rdfs:comment": {
    "de": [
      "Table d'hôte am Ufer der Rhône in einer außergewöhnlichen Umgebung mit einer natürlichen regionalen Küche auf der Grundlage von Wildfischen. Jean-Bernard Buisson ist Berufsfischer am Lac du Bourget und an der Haut-Rhône. Schöne beheizte Terrasse mit herrlichem Blick auf die Rhône."
    ],
    "en": [
      "Table d'hôte on the banks of the Rhône in an exceptional setting offering natural local cuisine based on wild fish.\r\nJean-Bernard Buisson, professional fisherman from Lake Bourget and Haut-Rhône.\r\nBeautiful heated terrace, superb view of the Rhône."
    ],
    "it": [
      "Table d'hôte sulle rive del Rodano in un ambiente eccezionale che offre una cucina naturale e locale a base di pesce selvatico. Jean-Bernard Buisson è un pescatore professionista del Lac du Bourget e dell'Haut-Rhône. Bella terrazza riscaldata, splendida vista sul Rodano."
    ],
    "fr": [
      "Table d’hôte au bord du Rhône dans un cadre exceptionnel proposant une cuisine naturelle du terroir à base de poissons sauvages. Jean-Bernard Buisson pêcheur professionnel du Lac du Bourget et Haut-Rhône. Belle terrasse chauffée, vue superbe sur le Rhône."
    ],
    "nl": [
      "Table d'hôte aan de oevers van de Rhône in een uitzonderlijke omgeving met een natuurlijke, lokale keuken op basis van wilde vis. Jean-Bernard Buisson is een professionele visser uit Lac du Bourget en Haut-Rhône. Prachtig verwarmd terras, prachtig uitzicht op de Rhône."
    ],
    "es": [
      "Table d'hôte a orillas del Ródano en un marco excepcional que ofrece una cocina natural y local a base de pescado salvaje. Jean-Bernard Buisson es pescador profesional de Lac du Bourget y Haut-Rhône. Hermosa terraza climatizada, magnífica vista del Ródano."
    ]
  },
  "rdfs:label": {
    "en": [
      "La Pêcherie"
    ],
