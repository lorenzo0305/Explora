  "rdfs:comment": {
    "de": [
      "Die Schäferei besitzt eine Herde von 80 Schafen der Rasse Lacaune, produziert Käse und Joghurt und verkauft Lämmer auf Beinen.\r\nPräsenz auf dem Markt in Moissieu sur Dolon."
    ],
    "en": [
      "The sheepfold has a flock of 60 Lacaune ewes and produces cheeses and yoghurts."
    ],
    "it": [
      "L'allevamento di pecore ha un gregge di 80 pecore Lacaune, produce formaggio e yogurt e vende agnelli allo zoccolo.\r\nPresenza sul mercato a Moissieu sur Dolon."
    ],
    "fr": [
      "La bergerie possède un troupeau de 80 brebis de race Lacaune, produit des fromages et yaourts et vend des agneaux sur pieds.\r\nPrésence au marché de Moissieu sur Dolon."
    ],
    "es": [
      "La explotación ovina cuenta con un rebaño de 80 ovejas Lacaune, produce queso y yogur y vende corderos de cascos.\r\nPresencia en el mercado de Moissieu sur Dolon."
    ],
    "nl": [
      "De schapenboerderij heeft een kudde van 80 Lacaune ooien, produceert kaas en yoghurt en verkoopt lammeren op de hoef.\r\nAanwezigheid op de markt in Moissieu sur Dolon."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Gaec des petits bergers - La Bergerie aux hirondelles"
    ]
  },
