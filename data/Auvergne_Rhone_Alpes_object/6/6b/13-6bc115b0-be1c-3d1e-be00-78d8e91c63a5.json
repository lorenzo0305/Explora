  "rdfs:comment": {
    "de": [
      "Die Auberge du Pont liegt am Ufer des Allier, in der Nähe des Schlosses Billy und 15 Minuten von Vichy entfernt. Sie empfängt Sie in einer gedämpften und beruhigenden Atmosphäre."
    ],
    "en": [
      "Located on the banks of the Allier, near Billy's castle, 15 minutes from Vichy, the Auberge du Pont welcomes you in a quiet and soothing atmosphere."
    ],
    "it": [
      "Situato sulle rive del fiume Allier, vicino allo Château de Billy, a 15 minuti da Vichy, l'Auberge du Pont vi accoglie in un'atmosfera accogliente e rilassante."
    ],
    "fr": [
      "Située au bord de l'Allier, à proximité du château de Billy, à 15 minutes de Vichy, l'Auberge du Pont vous accueille dans une ambiance feutrée et apaisante."
    ],
    "es": [
      "Situado a orillas del río Allier, cerca del Château de Billy, a 15 minutos de Vichy, el Auberge du Pont le da la bienvenida en un ambiente acogedor y relajante."
    ],
    "nl": [
      "De Auberge du Pont, gelegen aan de oever van de Allier, vlakbij het Château de Billy, op 15 minuten van Vichy, verwelkomt u in een gezellige en rustgevende sfeer."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Auberge du Pont"
    ]
