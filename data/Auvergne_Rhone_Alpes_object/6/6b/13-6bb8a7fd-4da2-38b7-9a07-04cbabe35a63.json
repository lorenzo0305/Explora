  "rdfs:comment": {
    "de": [
      "Ein abgelegenes Restaurant mit einer sehr schönen Aussicht, mitten auf dem Land, ganz in der Nähe des Wasserspiegels von Champagnac-Le-Vieux. Die Küche ist traditionell und der Empfang familiär."
    ],
    "en": [
      "A secluded restaurant with a beautiful view, in the heart of the countryside, close to the Champagnac-Le-Vieux lake. Traditional cuisine and a warm family welcome."
    ],
    "it": [
      "Un ristorante appartato con una splendida vista, nel cuore della campagna, vicino al lago di Champagnac-Le-Vieux. Cucina tradizionale e accoglienza familiare."
    ],
    "fr": [
      "Un restaurant isolé, avec une très belle vue, en pleine campagne, tous près du plan d'eau de Champagnac-Le-Vieux. La cuisine y est traditionnelle et l'accueil familial."
    ],
    "es": [
      "Un restaurante aislado con hermosas vistas, en plena campiña, cerca del lago Champagnac-Le-Vieux. Cocina tradicional y cálida acogida familiar."
    ],
    "nl": [
      "Een afgelegen restaurant met een prachtig uitzicht, in het hart van het platteland, vlakbij het meer van Champagnac-Le-Vieux. Traditionele keuken en een warm familie-ontvangst."
    ]
  },
  "rdfs:label": {
