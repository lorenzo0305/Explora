  "rdfs:comment": {
    "de": [
      "Geodyssée lädt Sie ein, Flaine und seine Umgebung auf spielerische Weise zu erkunden! Nehmen Sie an einer faszinierenden Schnitzeljagd teil, bei der Sie die drei Seen in der Umgebung von Flaine entdecken werden."
    ],
    "en": [
      "Geodyssée invites you to explore Flaine and the surrounding area in a fun way! Take part in an intriguing treasure hunt to discover the three lakes around Flaine."
    ],
    "it": [
      "Geodyssée vi invita a esplorare Flaine e i suoi dintorni in modo divertente! Partecipate a un'intrigante caccia al tesoro per scoprire i tre laghi intorno a Flaine."
    ],
    "fr": [
      "Geodyssée vous invite à explorer Flaine et ses environs de manière ludique ! Participez à un jeu de piste intrigant qui vous fera découvrir les trois lacs aux alentours de Flaine."
    ],
    "nl": [
      "Geodyssée nodigt je uit om Flaine en omgeving op een leuke manier te verkennen! Doe mee aan een intrigerende speurtocht om de drie meren rond Flaine te ontdekken."
    ],
    "es": [
      "Geodyssée le invita a explorar Flaine y sus alrededores de forma divertida Participe en una intrigante búsqueda del tesoro para descubrir los tres lagos que rodean Flaine."
    ]
  },
  "rdfs:label": {
    "en": [
