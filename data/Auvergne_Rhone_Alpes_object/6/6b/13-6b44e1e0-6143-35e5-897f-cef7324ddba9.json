  "rdfs:comment": {
    "de": [
      "Die Bibliothek ist eine Zweigstelle der Médiathèque Départementale de la Loire. Die Ausleihe von Büchern ist kostenlos. Es besteht die Möglichkeit, Reservierungen zu tätigen, die jeden Monat von der Mediathek mitgebracht werden."
    ],
    "en": [
      "The library is a relay of the Departmental Media Library of the Loire. The loan of books is free of charge. Possibility to make reservations which are brought every month by the media library."
    ],
    "it": [
      "La biblioteca è un relè della Médiathèque Départementale de la Loire. Il prestito dei libri è gratuito. Le prenotazioni possono essere effettuate e vengono portate ogni mese dalla mediateca."
    ],
    "fr": [
      "La bibliothèque est un relais de la Médiathèque Départementale de la Loire. Le prêt de livres est gratuit. Possibilité de faire des réservations qui sont apportées chaque mois par la médiathèque."
    ],
    "es": [
      "La biblioteca es un relevo de la Médiathèque Départementale de la Loire. El préstamo de libros es gratuito. Se pueden hacer reservas y la mediateca las trae cada mes."
    ],
    "nl": [
      "De bibliotheek is een relais van de Médiathèque Départementale de la Loire. Het lenen van boeken is gratis. Reserveringen kunnen worden gemaakt en worden elke maand gebracht door de mediatheek."
    ]
  },
