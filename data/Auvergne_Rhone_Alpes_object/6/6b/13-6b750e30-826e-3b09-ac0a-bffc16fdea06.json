  "rdfs:comment": {
    "de": [
      "Die Combrailles à Vélo-Pfade bieten Ihnen lehrreiche, spielerische und für alle Niveaus geeignete Mountainbike-Touren in einer außergewöhnlichen natürlichen Umgebung: den Combrailles (63)."
    ],
    "en": [
      "Les sentiers des Combrailles à Vélo offer fun, educational mountain bike outings for all levels in an exceptional natural setting: the Combrailles (63)."
    ],
    "it": [
      "Les sentiers des Combrailles à Vélo propongono uscite in mountain bike divertenti ed educative per tutti i livelli in un contesto naturale eccezionale: le Combrailles (63)."
    ],
    "fr": [
      "Les sentiers des Combrailles à Vélo vous proposent des sorties VTT éducatives, ludiques et adaptées à tous les niveaux dans un cadre naturel exceptionnel : les Combrailles (63)."
    ],
    "es": [
      "Les sentiers des Combrailles à Vélo proponen salidas en bicicleta de montaña lúdicas y pedagógicas para todos los niveles en un marco natural excepcional: las Combrailles (63)."
    ],
    "nl": [
      "Les sentiers des Combrailles à Vélo bieden leuke, leerzame mountainbike-uitstapjes voor alle niveaus in een uitzonderlijke natuurlijke omgeving: de Combrailles (63)."
    ]
  },
