  "rdfs:comment": {
    "de": [
      "Im Herzen von Montluçon gelegenes Kino mit fünf Sälen, die alle mit Dolby Stereo SR und Digital mit großen Leinwänden ausgestattet sind, digital mit der Möglichkeit zur 3D-Projektion."
    ],
    "en": [
      "Located in the heart of Montluçon, a five-screen cinema all equipped in Dolby stereo SR and Digital with large screens, in digital with the possibility of 3D projection."
    ],
    "it": [
      "Situato nel cuore di Montluçon, un cinema a cinque schermi tutti dotati di Dolby stereo SR e Digital con grandi schermi, in digitale con possibilità di proiezione in 3D."
    ],
    "fr": [
      "Situé au coeur de Montluçon, cinéma de cinq salles toutes équipées en Dolby stéréo SR et Digital avec grands écrans, en numérique avec possibilité de projection en 3D."
    ],
    "es": [
      "Situado en el corazón de Montluçon, un cine de cinco salas, todas ellas equipadas con Dolby stereo SR y Digital con grandes pantallas, en digital con posibilidad de proyección en 3D."
    ],
    "nl": [
      "Gelegen in het hart van Montluçon, een bioscoop met vijf zalen uitgerust met Dolby stereo SR en Digital met grote schermen, in digitale uitvoering met de mogelijkheid van 3D-projectie."
    ]
  },
