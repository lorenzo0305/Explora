  "rdfs:comment": {
    "de": [
      "Raum, in dem etwa 20 Personen für festliche oder geschäftliche Veranstaltungen empfangen werden können.\r\nBei schönem Wetter können bis zu 4 Personen mit dem Außenbereich bewirtet werden."
    ],
    "en": [
      "Room suited to host up to 20 people for professional or private events. If the the weather is sunny, you can host up to 40 people with the external space."
    ],
    "it": [
      "Questa sala può ospitare una ventina di persone per eventi festivi o di lavoro.\r\nNella bella stagione, l'area esterna può ospitare fino a 4 persone."
    ],
    "fr": [
      "Salle permettant de recevoir une vingtaine de personnes pour des évènements festifs ou professionnels. \r\nPar beau temps, il est possible d'avoir jusqu'à 4 personnes avec l'espace extérieur."
    ],
    "es": [
      "Esta sala tiene capacidad para unas veinte personas en actos festivos o de negocios.\r\nCuando hace buen tiempo, la zona exterior puede acoger hasta 4 personas."
    ],
    "nl": [
      "Deze ruimte biedt plaats aan ongeveer twintig personen voor feestelijke of zakelijke evenementen.\r\nBij mooi weer is de buitenruimte geschikt voor maximaal 4 personen."
    ]
  },
  "rdfs:label": {
