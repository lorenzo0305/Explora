  "rdfs:comment": {
    "de": [
      "Speisesaal und Atelier für die Ausstellung von Gemälden. Terrasse mit Blick auf die Berge. Parkplatz, Grünflächen.\r\nPizzas aus dem Holzofen und Bio-Mehl aus dem Trièves (vor Ort oder zum Mitnehmen)."
    ],
    "en": [
      "Restaurant room and painting exhibition workshop. Terrace facing the mountains. Parking, green areas.\r\nPizzas with wood fire and organic flour from the Trièves (on site or to take away)."
    ],
    "it": [
      "Ristorante e sala per mostre di pittura. Terrazza con vista sulle montagne. Parcheggio, spazi verdi.\r\nPizze cotte a legna con farina biologica di Trièves (in loco o da asporto)."
    ],
    "fr": [
      "Salle de restaurant et atelier d'exposition de peinture. Terrasse face aux montagnes. Parking, espaces verts.\r\nPizzas au feu de bois et à la farine bio du Trièves (sur place ou à emporter)."
    ],
    "es": [
      "Restaurante y sala de exposiciones de pintura. Terraza con vistas a las montañas. Aparcamiento, espacios verdes.\r\nPizzas al horno de leña con harina ecológica de las Trièves (en el lugar o para llevar)."
    ],
    "nl": [
      "Restaurant en expositieruimte voor schilderijen. Terras met uitzicht op de bergen. Parkeerplaatsen, groene ruimtes.\r\nHoutgestookte pizza's met biologisch meel uit de Trièves (ter plaatse of om mee te nemen)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Pizz'Art"
    ]
  },
