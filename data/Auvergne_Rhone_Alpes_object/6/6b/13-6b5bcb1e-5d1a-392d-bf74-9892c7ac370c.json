  "rdfs:comment": {
    "de": [
      "Der Drittort in Tarare wird im Herzen seiner Region errichtet, mit der Perspektive, sich den Ambitionen der Region, der Energiewende, der digitalen Entwicklung und der Innovation anzuschließen."
    ],
    "en": [
      "The Tarare third place is built in the heart of its territory, in a perspective of joining the ambitions of the territory, the energy transition, the digital development and the innovation."
    ],
    "it": [
      "Il Centro Terzi di Tarare sta sorgendo nel cuore del suo territorio, con l'obiettivo di unire le ambizioni del territorio, la transizione energetica, lo sviluppo digitale e l'innovazione."
    ],
    "fr": [
      "Le tiers-lieu de Tarare se construit au cœur de son territoire, dans une perspective de rejoindre les ambitions du territoire, la transition énergétique, le développement numérique et l'innovation."
    ],
    "nl": [
      "Het derdencentrum van Tarare wordt gebouwd in het hart van het grondgebied, om de ambities van het grondgebied, de energietransitie, de digitale ontwikkeling en de innovatie te verenigen."
    ],
    "es": [
      "El centro de terceros de Tarare se está construyendo en el corazón de su territorio, con el fin de unir las ambiciones del territorio, la transición energética, el desarrollo digital y la innovación."
    ]
  },
