  "rdfs:comment": {
    "de": [
      "In Le Verger Curieux bauen wir verschiedene Kräuter, Früchte, Gemüsepflanzen und Blumen an.\r\n\r\nWir produzieren, verarbeiten und verkaufen unsere Setzlinge, Sirupe, Kräutertees und Aromaten auf dem Hof.\r\n\r\nWir arbeiten ohne Dünger, Pestizide und Mechanisierung."
    ],
    "en": [
      "At Verger Curieux, we grow a variety of herbs, fruits, vegetable plants and flowers.\r\n\r\nWe produce, process and sell our plants, syrups, herbal teas and aromatics on the farm.\r\n\r\nWe work without fertilizers, pesticides or mechanization."
    ],
    "it": [
      "A Le Verger Curieux coltiviamo una varietà di erbe, frutta, verdura e fiori.\r\n\r\nProduciamo, trasformiamo e vendiamo le nostre piante, gli sciroppi, le tisane e le erbe in azienda.\r\n\r\nLavoriamo senza fertilizzanti, pesticidi o meccanizzazione."
    ],
    "fr": [
      "Au Verger Curieux, nous cultivons des aromates, fruits, plants de légumes et fleurs variés.\r\n\r\nNous produisons, transformons et vendons nos plants, sirops, tisanes et aromates à la ferme.\r\n\r\nNous travaillons sans engrais, sans pesticides, sans mécanisation."
    ],
    "es": [
      "En Le Verger Curieux cultivamos hierbas aromáticas, frutas, verduras y flores.\r\n\r\nProducimos, procesamos y vendemos nuestras plantas, jarabes, tisanas y hierbas en la propia granja.\r\n\r\nTrabajamos sin fertilizantes, pesticidas ni mecanización."
    ],
    "nl": [
      "Bij Le Verger Curieux kweken we een verscheidenheid aan kruiden, fruit, groenten en bloemen.\r\n\r\nWe produceren, verwerken en verkopen onze planten, siropen, kruidenthee en kruiden op de boerderij.\r\n\r\nWe werken zonder kunstmest, pesticiden of mechanisatie."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Au verger curieux"
    ]
  },
