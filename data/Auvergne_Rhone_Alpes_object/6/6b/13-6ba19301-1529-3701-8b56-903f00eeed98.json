  "rdfs:comment": {
    "de": [
      "Der beliebteste Steward Frankreichs kehrt mit einer One-Man-Show und noch nie zuvor gesehenen Anekdoten zurück. Schock der Milieus, Schock der Kulturen, Achtung Turbulenzen in Sicht und Lachen garantiert!"
    ],
    "en": [
      "France's most popular steward returns with a one-man show and a host of new anecdotes. A clash of worlds, a clash of cultures, turbulence and laughter guaranteed!"
    ],
    "it": [
      "Lo steward più popolare di Francia torna con un one-man show e una serie di nuovi aneddoti. Scontro di storie, scontro di culture, turbolenza e risate garantite!"
    ],
    "fr": [
      "Le steward le plus populaire de France revient avec un one-man-show et des anecdotes inédites. Choc des milieux, choc de culture, attention turbulences en vue et rires garantis !"
    ],
    "nl": [
      "Frankrijks populairste steward is terug met een onemanshow en een heleboel nieuwe anekdotes. Een botsing van achtergronden, een botsing van culturen, turbulentie en gelach gegarandeerd!"
    ],
    "es": [
      "El azafato más popular de Francia vuelve con un espectáculo unipersonal y un montón de nuevas anécdotas. Choque de orígenes, choque de culturas, turbulencias y risas garantizadas"
    ]
  },
