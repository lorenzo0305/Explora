  "rdfs:comment": {
    "de": [
      "Früher versorgte er die Mühle Neuf in Messimy-sur-Saône mit Wasser. Als Nebenfluss der Saône bietet Ihnen dieser Fluss eine natürliche und bukolische Umgebung. Er ist eine angenehme kühle Ecke für den Sommer!"
    ],
    "en": [
      "It once fed the Moulin Neuf in Messimy-sur-Saône. Tributary of the Saône, this river offers a natural and bucolic setting. It’s a nice cool spot for summer!"
    ],
    "it": [
      "Un tempo alimentava il Moulin Neuf di Messimy-sur-Saône. Affluente della Saona, questo fiume offre un ambiente naturale e bucolico. È un bel posto fresco per l'estate!"
    ],
    "fr": [
      "Elle alimentait autrefois le moulin Neuf à Messimy-sur-Saône. Affluent de la Saône, cette rivière vous offre un cadre naturel et bucolique. C'est un coin de fraîcheur agréable pour l'été !"
    ],
    "nl": [
      "Het voedde vroeger de Moulin Neuf in Messimy-sur-Saône. Als zijrivier van de Saône biedt deze rivier een natuurlijke en bucolische omgeving. Het is een mooie koele plek voor de zomer!"
    ],
    "es": [
      "Antes alimentaba el Moulin Neuf de Messimy-sur-Saône. Afluente del Saona, este río ofrece un entorno natural y bucólico. Es un lugar muy fresco para el verano"
    ]
  },
  "rdfs:label": {
    "en": [
      "\"La Mâtre\" river"
    ],
    "fr": [
      "Rivière \"La Mâtre\""
    ]
  },
