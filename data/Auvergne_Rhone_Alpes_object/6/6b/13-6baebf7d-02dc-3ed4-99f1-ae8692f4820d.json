  "rdfs:comment": {
    "de": [
      "Erleben Sie mit Freunden oder der Familie eine originelle Erfahrung, indem Sie versuchen, in weniger als einer Stunde aus einem verschlossenen Raum zu entkommen! Schlüsselwörter für den Erfolg: Kooperation, Zuhören und Nachdenken!"
    ],
    "en": [
      "With friends or family, try to escape from the locked room in less than an hour! Key words to succeed: cooperation, listening and thinking!"
    ],
    "it": [
      "Con gli amici o la famiglia, cercate di fuggire dalla stanza chiusa a chiave in meno di un'ora! Le parole chiave per il successo: cooperazione, ascolto e riflessione!"
    ],
    "fr": [
      "Entre amis ou en famille, vivez une expérience originale en tentant de vous échapper de la salle fermée à clef en moins d'une heure ! Mots clés pour réussir : coopération, écoute et réflexion !"
    ],
    "nl": [
      "Geniet met vrienden of familie van een originele ervaring door in minder dan een uur te proberen te ontsnappen uit de afgesloten ruimte! Sleutelwoorden voor succes: samenwerken, luisteren en nadenken!"
    ],
    "es": [
      "Con amigos o familiares, ¡intenta escapar de la habitación cerrada en menos de una hora! Palabras clave para el éxito: ¡cooperación, escucha y pensamiento!"
    ]
  },
  "rdfs:label": {
    "en": [
      "Escape Game - The Door of Secrets"
    ],
    "fr": [
      "Escape Game - La Porte des Secrets"
    ],
    "nl": [
      "Escapespellen - De Poort van Geheimen"
    ]
  },
