  "rdfs:comment": {
    "de": [
      "Fario- und Regenbogenforellen erwarten Sie, sei es in den beiden Seen Plan d'Amont und Plan d'Aval (Höhe 2000 m / öffentlicher Bereich) oder im Fluss Arc, in den Bächen Fond d'Aussois und Saint-Benoît (privater Bereich)."
    ],
    "en": [
      "The fario and Rainbow trouts are waiting for you, either on the two lakes Plan d'Amont and Plan d'Aval (altitude 2000 m / public domain) or the River Arc, streams Fond Aussois and St. Benoît (private domain)."
    ],
    "it": [
      "La trota fario e Rainbow attesa per voi, sia su i due laghi di Plan d'Amonte e del Plan d'Aval (quota 2000 m / pubblico dominio) o il fiume Arc, flussi Fond Aussois e San Benedetto (sfera privata)."
    ],
    "fr": [
      "Les truites Fario et Arc-en-Ciel vous attendent, que ce soit sur les deux lacs de Plan d'Amont et Plan d'Aval (altitude 2000 m / domaine public) ou sur la rivière de l'Arc, les ruisseaux du Fond d'Aussois et du Saint-Benoît (domaine privé)."
    ],
    "es": [
      "Las truchas de Fario y Arc-en-Ciel le esperan, ya sea en los dos lagos de Plan d'Amont y Plan d'Aval (altitud 2000 m / dominio público) o en el río Arc, los arroyos Fond d'Aussois y Saint-Benoît (dominio privado)."
    ],
    "nl": [
      "De beekforel en Arc-en-Ciel wachten op u, of het nu op de twee meren van Plan d'Amont en Plan d'Aval (hoogte 2000m / openbaar domein) of op de rivier de Arc, de stromen Fond d 'Aussois en Saint -Benoît (privédomein)."
    ]
  },
  "rdfs:label": {
    "en": [
      "Fishing in lakes and rivers"
    ],
    "it": [
      "Pesca nei laghi e fiumi"
    ],
    "fr": [
      "Pêche en lacs et rivières"
    ],
    "nl": [
      "Vissen in meren en rivieren"
    ]
  },
