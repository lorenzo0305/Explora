  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/5e12e963-3248-3ef8-8334-bbecf581899e",
      "dc:description": {
        "de": [
          "Die Kinder werden in das Ponyreiten eingeführt\nein Praktikum ist offen :\nmontag Dienstag Mittwoch\nvon 8.45 - 12.00 Uhr\ndonnerstag\n13.30 - 17.00 Uhr\n\nAnmeldungen: bei den Sportpädagogen des Rathauses oder per E-Mail."
        ],
        "en": [
          "Children will be able to learn to ride a pony\na course is open :\nmonday Tuesday Wednesday\n8.45am - 12.00pm\nthursday\n1:30 pm - 5:00 pm\n\nRegistrations: with the sports educators at the Mairie or by e-mail."
        ],
        "it": [
          "I bambini potranno imparare a cavalcare un pony\nil corso è aperto:\nlunedì Martedì Mercoledì\ndalle 8.45 alle 12.00\ngiovedì\ndalle 13.30 alle 17.00\n\nIscrizioni: presso gli istruttori sportivi del Municipio o via e-mail."
        ],
        "fr": [
          "Les enfants vont pouvoir initier au poney \nun stage est ouvert : \nlundi mardi mercredi  \nde 8 h 45 - 12 h 00 \njeudi \n13 h  30 à 17 h 00\n\nLes inscriptions : auprès des éducateurs sportifs de la Mairie ou par E-mail."
        ],
        "es": [
          "Los niños podrán aprender a montar en poni\nel curso está abierto :\nlunes Martes Miércoles\n8h45 - 12h00\njueves\n13.30 h a 17.00 h\n\nInscripciones: con los monitores deportivos en el Ayuntamiento o por correo electrónico."
        ],
        "nl": [
          "Kinderen kunnen leren ponyrijden\neen cursus is geopend :\nmaandag Dinsdag Woensdag\n8.45 - 12.00\ndonderdag\n13.30 - 17.00 uur\n\nAanmeldingen: bij de sportinstructeurs op het stadhuis of per e-mail."
        ]
      },
