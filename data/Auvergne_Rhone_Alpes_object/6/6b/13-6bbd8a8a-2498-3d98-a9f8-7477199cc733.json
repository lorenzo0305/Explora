  "rdfs:comment": {
    "de": [
      "Das Institut Culturel du Judaïsme hat die Aufgabe, das Judentum unter seinen verschiedenen Aspekten - religiös, kulturell und historisch - zu vermitteln. Seine Berufung ist es, Antisemitismus und Vorurteile zu bekämpfen."
    ],
    "en": [
      "The purpose of the ICJ (Institut Culturel du Judaïsme, i.e. cultural institute of Judaism) is to teach people about all the different aspects of Judaism: religious, cultural and historic. It aims to combat antisemitism and prejudice."
    ],
    "it": [
      "La missione dell'Istituto Culturale dell'Ebraismo è far scoprire l'ebraismo nei suoi diversi aspetti: religioso, culturale e storico. La sua vocazione è quella di combattere l'antisemitismo e il pregiudizio."
    ],
    "fr": [
      "L’Institut Culturel du Judaïsme a pour mission de faire découvrir le judaïsme sous ses différents aspects : religieux, culturel et historique. Sa vocation est de lutter contre l’antisémitisme et les préjugés."
    ],
    "es": [
      "La misión del Instituto Cultural del Judaísmo es hacer descubrir el judaísmo en sus diferentes aspectos: religioso, cultural e histórico. Su vocación es luchar contra el antisemitismo y los prejuicios."
    ],
    "nl": [
      "De missie van het Cultureel Instituut voor het Jodendom is het ontdekken van het Jodendom in zijn verschillende aspecten: religieus, cultureel en historisch. Het is haar roeping om antisemitisme en vooroordelen te bestrijden."
    ]
  },
