  "rdfs:comment": {
    "de": [
      "Das einzige Restaurant, in dem es Raclette zum Sattessen gibt!\r\nBedienen Sie sich am Käsebuffet und setzen Sie sich an den Tisch, wo Ihnen Wurst, Kartoffeln und Salat serviert werden.\r\nReservierung per SMS empfohlen."
    ],
    "en": [
      "The only restaurant where raclette is all-you-can-eat!\r\nHelp yourself to the cheese buffet and sit down at the table, where you'll be served charcuterie, potatoes and salad.\r\nSMS reservations recommended."
    ],
    "it": [
      "L'unico ristorante dove si può mangiare tutta la raclette che si vuole!\r\nServitevi al buffet di formaggi e accomodatevi al tavolo, dove vi verranno serviti salumi, patate e insalata.\r\nSi consiglia la prenotazione via SMS."
    ],
    "fr": [
      "Le seul restaurant où la raclette est à volonté !\r\nServez-vous au buffet de fromages et installez-vous à table où vous seront servi charcuterie, pommes de terre et salade.\r\nRéservation par SMS conseillée."
    ],
    "nl": [
      "Het enige restaurant waar je zoveel raclette kunt eten als je wilt!\r\nHelp jezelf aan het kaasbuffet en neem plaats aan tafel, waar je vleeswaren, aardappelen en salade geserveerd krijgt.\r\nReservering per sms aanbevolen."
    ],
    "es": [
      "El único restaurante donde puedes comer toda la raclette que quieras\r\nSírvete el buffet de quesos y toma asiento en la mesa, donde te servirán embutidos, patatas y ensalada.\r\nSe recomienda reservar por SMS."
    ]
  },
