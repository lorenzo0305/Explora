  "rdfs:comment": {
    "de": [
      "Wir fertigen unsere Produkte auf handwerkliche Weise an. Unser Lavendel wird seit Generationen von der Familie angebaut. Wir legen Wert darauf, in kurzen Kreisläufen zu arbeiten, ohne Plastik, aus natürlichen und wiederverwertbaren Materialien."
    ],
    "en": [
      "We make our products by hand. Our lavender has been grown in the family for generations. We emphasize working in short circuits, without plastic, in natural and recyclable materials."
    ],
    "it": [
      "Realizziamo i nostri prodotti a mano. La nostra lavanda è coltivata in famiglia da generazioni. Sottolineiamo il fatto che lavoriamo in un circuito breve, senza plastica, utilizzando materiali naturali e riciclabili."
    ],
    "fr": [
      "Nous confectionnons nos produits de façon artisanale. Notre lavande est cultivée en famille depuis des générations. Nous mettons en avant le fait de travailler en circuit court, sans plastique, en matière naturelle et recyclable."
    ],
    "nl": [
      "We maken onze producten met de hand. Onze lavendel wordt al generaties lang in de familie geteeld. We benadrukken dat we werken in een kort circuit, zonder plastic, met natuurlijke en recyclebare materialen."
    ],
    "es": [
      "Elaboramos nuestros productos a mano. Nuestra lavanda se cultiva en la familia desde hace generaciones. Destacamos el hecho de que trabajamos en circuito corto, sin plástico, utilizando materiales naturales y reciclables."
    ]
  },
  "rdfs:label": {
