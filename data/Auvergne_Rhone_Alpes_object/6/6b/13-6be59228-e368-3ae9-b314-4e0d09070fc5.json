  "rdfs:comment": {
    "de": [
      "Begegnen Sie dem Leben in den Bergen und dem reichen Natur-, Kultur- und Architekturerbe, vorbei an jahrhundertealten Chalets und Kapellen auf über 86 km Schneeschuhrouten und 43 km gespurten Fußgängerwegen."
    ],
    "en": [
      "Discover the mountain life and the richness of the natural, cultural and architectural heritage, as you pass by hundred-year-old chalets and chapels on more than 86 km of snowshoeing itineraries and 43 km of groomed walking trails."
    ],
    "it": [
      "Scoprite la vita di montagna e il ricco patrimonio naturale, culturale e architettonico, passeggiando tra chalet e cappelle secolari su oltre 86 km di percorsi per racchette da neve e 43 km di sentieri battuti."
    ],
    "fr": [
      "Allez à la rencontre de la vie montagnarde et de la richesse du patrimoine naturel, culturel et architectural, au détour de chalets et chapelles centenaires sur plus de 86 km d’itinéraires raquettes et 43 km de pistes piétons damées."
    ],
    "nl": [
      "Ontdek het leven in de bergen en een rijk natuurlijk, cultureel en architectonisch erfgoed terwijl je langs eeuwenoude chalets en kapellen wandelt op meer dan 86 km sneeuwschoenpaden en 43 km geprepareerde wandelpaden."
    ],
    "es": [
      "Descubra la vida en la montaña y un rico patrimonio natural, cultural y arquitectónico, paseando entre chalés y capillas centenarios por más de 86 km de pistas para raquetas de nieve y 43 km de senderos acondicionados."
    ]
  },
  "rdfs:label": {
    "de": [
      "Wandern mit Schneeschuhen: die Wanderrouten"
    ],
    "en": [
      "Snowshoe hikes : routes"
    ],
    "fr": [
      "Randonnées en raquettes à neige : les itinéraires"
    ],
    "es": [
      "Raquetas de nieve : los itinerarios"
    ]
  },
