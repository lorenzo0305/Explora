  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/c9794876-cbe6-35cc-96a5-7205d15c165a",
      "dc:description": {
        "de": [
          "Geführter Rundgang : Pierre Vivien, Architekt des Wiederaufbaus\n\nDauer: 1,5 Stunden ? begrenzte Teilnehmerzahl ? nach Anmeldung\nAuf den Docks, Erzählung über den Wiederaufbau nach dem Krieg und Besuch einer Halle der Buildings."
        ],
        "en": [
          "Guided tour : Pierre Vivien, architect of Reconstruction\n\nDuration: 1h30 ? limited number of participants ? registration required\nOn the quayside, recount the story of post-war Reconstruction and visit one of the Buildings halls."
        ],
        "it": [
          "Visita guidata : Pierre Vivien, architetto della Ricostruzione\n\nDurata: 1 ora e 30 minuti ? capacità limitata ? iscrizione obbligatoria\nSulla banchina, raccontate la storia della Ricostruzione del dopoguerra e visitate una delle sale degli Edifici."
        ],
        "fr": [
          "Circuit guidé : Pierre Vivien, architecte de la Reconstruction\n\nDurée : 1h30 – jauge limitée – sur inscription\nSur les quais, récit de la Reconstruction d’après-guerre et visite d’un hall des Buildings."
        ],
        "es": [
          "Visita guiada : Pierre Vivien, arquitecto de la Reconstrucción\n\nDuración: 1 hora 30 minutos ? aforo limitado ? inscripción obligatoria\nEn el muelle, narre la historia de la Reconstrucción de posguerra y visite una de las salas de los Edificios."
        ],
        "nl": [
          "Rondleiding : Pierre Vivien, architect van de Wederopbouw\n\nDuur: 1 uur 30 minuten ? beperkte capaciteit ? inschrijven verplicht\nVertel op de kade het verhaal van de naoorlogse Wederopbouw en bezoek een van de hallen van de Gebouwen."
        ]
      },
