  "rdfs:comment": {
    "de": [
      "Unser Restaurant in Le Chambon-sur-Lignon, zwischen Auvergne und Ardèche, lädt Sie ein, eine Gourmetküche zu genießen, die für Gastlichkeit, Großzügigkeit und Qualität steht."
    ],
    "en": [
      "Our restaurant in Le Chambon-sur-Lignon, between Auvergne and Ardèche, invites you to share its gastronomic cuisine, synonymous with conviviality, generosity and quality."
    ],
    "it": [
      "Il nostro ristorante a Le Chambon-sur-Lignon, tra l'Alvernia e l'Ardèche, vi invita a condividere la sua cucina gastronomica, sinonimo di convivialità, generosità e qualità."
    ],
    "fr": [
      "Notre restaurant au Chambon-sur-Lignon, entre Auvergne et Ardèche, vous invite à partager une cuisine gastronomique synonyme de convivialité, de générosité et de qualité."
    ],
    "nl": [
      "Ons restaurant in Le Chambon-sur-Lignon, tussen Auvergne en Ardèche, nodigt u uit om te delen in zijn gastronomische keuken, synoniem van gezelligheid, gulheid en kwaliteit."
    ],
    "es": [
      "Nuestro restaurante de Le Chambon-sur-Lignon, entre Auvernia y Ardèche, le invita a compartir su cocina gastronómica, sinónimo de cordialidad, generosidad y calidad."
    ]
  },
