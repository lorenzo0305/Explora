  "rdfs:comment": {
    "de": [
      "Die Brasserie Caquot befindet sich zwischen Aix-les-Bains und Annecy.\r\nSie stellt charaktervolle Bio-Biere her, die vom lokalen Terroir inspiriert und mit Sorgfalt gebraut werden.\r\nIhr Sortiment, die Bières de l'Ours, spiegelt die Authentizität, die Geselligkeit und den Geist der Bergwelt wider."
    ],
    "en": [
      "Brasserie Caquot is located between Aix-les-Bains and Annecy.\r\nIt produces distinctive organic beers, inspired by the local terroir and brewed with care.\r\nIts range, Les Bières de l’Ours, reflects authenticity, conviviality, and the mountain spirit."
    ],
    "it": [
      "La Brasserie Caquot si trova tra Aix-les-Bains e Annecy.\r\nProduce birre biologiche di carattere, ispirate al territorio locale e prodotte con cura.\r\nLa sua gamma, les Bières de l'Ours, riflette l'autenticità, la convivialità e lo spirito montano."
    ],
    "fr": [
      "La Brasserie Caquot est située entre Aix-les-Bains et Annecy.\r\nElle produit des bières bio de caractère, inspirées du terroir local et brassées avec soin.\r\nSa gamme, les Bières de l’Ours, reflète l’authenticité, la convivialité et l’esprit montagnard."
    ],
    "es": [
      "La Brasserie Caquot está situada entre Aix-les-Bains y Annecy.\r\nProduce cervezas ecológicas con carácter, inspiradas en el terruño local y elaboradas con esmero.\r\nSu gama, Bières de l'Ours, refleja la autenticidad, la convivencia y el espíritu de la montaña."
    ],
    "nl": [
      "Brasserie Caquot ligt tussen Aix-les-Bains en Annecy.\r\nHet produceert karaktervolle biologische bieren, geïnspireerd door het lokale terroir en met zorg gebrouwen.\r\nHet assortiment Bières de l'Ours weerspiegelt authenticiteit, gezelligheid en de geest van de bergen."
    ]
  },
