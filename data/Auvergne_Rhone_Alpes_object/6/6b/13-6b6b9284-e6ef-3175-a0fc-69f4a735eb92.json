  "rdfs:comment": {
    "de": [
      "Ausstellung über Ernährung und Gesundheit nach Hildegard von Bingen\r\nVom 8. Januar bis zum 29. März 2026, während der Öffnungszeiten des Geschäfts der Abtei Aiguebelle.\r\n\r\nEine Vernissage findet am Samstag, den 10. Januar 2026, von 14:30 bis 17:30 Uhr statt.\r\nUm 16:30 Uhr gibt es eine Märchenstunde für Kinder."
    ],
    "en": [
      "Exhibition on Food and Health According to Hildegard of Bingen\r\nJanuary 8 to March 29, 2026, during the opening hours of the Aiguebelle Abbey shop.\r\nAn opening reception will take place on Saturday, January 10, 2026, from 2:30 p.m. to 5:30 p.m.\r\nA storytelling session for children will be held at 4:30 p.m."
    ],
    "it": [
      "Mostra sull'alimentazione sana secondo Hildegarde de Bingen dall'08 gennaio al 29 marzo 2026 presso il negozio dell'Abbazia di Aiguebelle. Sabato 10 gennaio 2026 si terrà un vernissage dalle 14.30 alle 17.30, con una storia per bambini alle 16.30."
    ],
    "fr": [
      "Exposition sur l'alimentation-santé selon Hildegarde de Bingen du 08 janvier au 29 mars 2026 aux horaires du magasin de l'Abbaye d'Aiguebelle. Un vernissage aura lieu le samedi 10 janvier 2026 de 14H30 à 17H30, conte pour enfants à 16h30."
    ],
    "nl": [
      "Tentoonstelling over gezonde voeding volgens Hildegarde de Bingen van 08 januari tot 29 maart 2026 in de winkel van de Abdij van Aiguebelle. Er wordt een vernissage gehouden op zaterdag 10 januari 2026 van 14.30 tot 17.30 uur, met een kinderverhaal om 16.30 uur."
    ],
    "es": [
      "Exposición sobre la alimentación sana según Hildegarde de Bingen del 8 de enero al 29 de marzo de 2026 en la tienda de la Abadía de Aiguebelle. El sábado 10 de enero de 2026 se celebrará un vernissage de 14.30 a 17.30 horas, con un cuento infantil a las 16.30 horas."
    ]
  },
