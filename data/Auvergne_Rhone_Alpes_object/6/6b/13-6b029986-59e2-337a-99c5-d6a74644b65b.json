  "rdfs:comment": {
    "de": [
      "Startend beim Eingang des Tales des Encombres, dieser Weg nimmt Sie in der Entdeckung des Hameaux von Planlebon, Priots und von Gittamelon mit. Diese hameaux in der Alm, manchmal zerstört, tragen das Gedächtnis für die intensive agropastorale Aktivität des Tales."
    ],
    "en": [
      "Starting from the entrance to the Encombres Valley, this walk takes you through the hamlets of Planlebon and Les Priots.  These charming Alpine villages, sometimes in ruins, carry memories of farming days gone by."
    ],
    "it": [
      "All'ingresso della Vallée des Encombres, questo itinerario conduce alle frazioni di Planlebon e Les Priots.\r\nQuesti borghi d'alpeggio, talvolta in rovina, testimoniano l'intensa attività agro-pastorale."
    ],
    "fr": [
      "A l'entrée de la Vallée des Encombres, cet itinéraire vous emmène à la découverte des hameaux de Planlebon et des Priots.\r\nCes hameaux d'alpage, parfois en ruines, portent la mémoire de l'intense activité agropastorale."
    ],
    "nl": [
      "Start vanaf de vallei de Encombres, dit pad brengt u naar de gehuchten van Planlebon, de Priots et van Gittamelon. De berggehuchten, soms ruïnes geven uw herinneringen van het oude boerderij leven."
    ],
    "es": [
      "A la entrada de la Vallée des Encombres, esta ruta le lleva a las aldeas de Planlebon y Les Priots.\r\nEstos caseríos de pastos de montaña, a veces en ruinas, son testigos de la intensa actividad agropastoral."
    ]
  },
  "rdfs:label": {
    "de": [
      "Weg von Planlebon"
    ],
    "en": [
      "Planlebon circuit"
    ],
    "fr": [
      "Circuit de Planlebon"
    ],
    "nl": [
      "Parcour Planlebon"
    ]
  },
