  "rdfs:comment": {
    "de": [
      "Alles ist hausgemacht: Alle unsere Brote, Gebäckstücke, Vorspeisen und Konditoreiwaren werden vor Ort von Hand hergestellt (Ausarbeitung der Rezepte, Kneten, Backen), wobei Geschmack und Traditionen respektiert werden."
    ],
    "en": [
      "Everything is entirely home-made: all our breads, pastries, starters and pastries are made on the spot (recipe development, kneading, baking) by hand in the respect of taste and traditions."
    ],
    "it": [
      "Tutto è fatto in casa: tutti i nostri pani, paste, antipasti e pasticcini sono realizzati sul posto (elaborazione della ricetta, impasto, cottura) a mano nel rispetto del gusto e della tradizione."
    ],
    "fr": [
      "Tout est entièrement fait maison: tous nos pains, notre viennoiseries, nos entrées et nos pâtisserie sont fabriqués sur place (élaboration des recettes, pétrissage, cuisson) à la main dans le respect du goût et des traditions."
    ],
    "es": [
      "Todo es casero: todos nuestros panes, pasteles, entrantes y bollería se elaboran en el momento (elaboración de la receta, amasado, cocción) a mano respetando el gusto y la tradición."
    ],
    "nl": [
      "Alles is huisgemaakt: al onze broden, gebakjes, voorgerechten en taarten worden ter plekke met de hand gemaakt (receptontwikkeling, kneden, bakken) met respect voor smaak en traditie."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Boulangerie-Pâtisserie Martin Denis"
    ]
  },
