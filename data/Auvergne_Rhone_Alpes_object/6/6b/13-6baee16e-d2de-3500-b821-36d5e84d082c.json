  "rdfs:comment": {
    "de": [
      "Die Bibliothek ist für Erwachsene und Jugendliche gedacht und bietet ihnen die Möglichkeit, alle drei Wochen drei Bücher aus verschiedenen Bereichen auszuleihen (Romane, Erzählungen, Alben, Comics, Mangas, Dokumentarfilme usw.)."
    ],
    "en": [
      "The library welcomes adults and young people, offering them the chance to borrow 3 books every 3 weeks, in a variety of sectors (novels, stories, albums, comics, manga, documentaries, etc.)."
    ],
    "it": [
      "La biblioteca accoglie adulti e giovani e offre loro la possibilità di prendere in prestito 3 libri ogni 3 settimane, in vari settori (romanzi, racconti, album, fumetti, manga, documentari, ecc.)."
    ],
    "fr": [
      "La Bibliothèque a pour vocation l'accueil des adultes et des jeunes, et de leur offrir la possibilité d'emprunter 3 livres toutes les 3 semaines, dans divers secteurs (romans, contes, albums, BD, mangas, documentaires, etc...)."
    ],
    "es": [
      "La biblioteca acoge a adultos y jóvenes, y les ofrece la posibilidad de tomar prestados 3 libros cada 3 semanas, en diversos sectores (novelas, cuentos, álbumes, cómics, manga, documentales, etc.)."
    ],
    "nl": [
      "De bibliotheek staat open voor volwassenen en jongeren en biedt hen de kans om elke 3 weken 3 boeken te lenen in verschillende sectoren (romans, verhalen, albums, strips, manga, documentaires, enz.)."
    ]
  },
