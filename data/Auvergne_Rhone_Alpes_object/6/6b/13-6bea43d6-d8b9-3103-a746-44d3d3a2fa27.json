  "rdfs:comment": {
    "de": [
      "Die Mediathek in Nantua ist ein geselliger Ort, an dem sich Vergnügen, Entspannung und Kultur vermischen.\r\nSie finden dort 30.000 Dokumente: Romane, Biografien, Comics, Mangas, Bücher in Großdruck, Hörbücher, DVDs, CDs, Tageszeitungen und Zeitschriften."
    ],
    "en": [
      "in a modern atmosphere you ll find the documents you're searching for! 28 000 documents (books, newspaper, magazines, cd and dvd)"
    ],
    "it": [
      "La mediateca di Nantua è un luogo accogliente dove si combinano piacere, relax e cultura.\r\nTroverete 30.000 documenti: Romanzi, biografie, fumetti, manga, libri a caratteri grandi, libri da ascoltare, DVD, CD, giornali e riviste."
    ],
    "fr": [
      "La médiathèque de Nantua est un lieu d'accueil convivial où se mêlent plaisir, détente et culture.\r\nVous y trouverez 30 000 documents : Romans, biographies, BD, mangas, livres en gros caractères, livres à écouter, DVD, CD, quotidiens et magazines."
    ],
    "es": [
      "La mediateca de Nantua es un lugar acogedor donde se combinan el placer, la relajación y la cultura.\r\nEncontrará 30.000 documentos: Novelas, biografías, cómics, mangas, libros de letra grande, libros para escuchar, DVD, CD, periódicos y revistas."
    ],
    "nl": [
      "De mediatheek van Nantua is een gezellige plek waar plezier, ontspanning en cultuur worden gecombineerd.\r\nU vindt 30.000 documenten: Romans, biografieën, strips, manga's, grootletterboeken, luisterboeken, dvd's, cd's, kranten en tijdschriften."
    ]
  },
  "rdfs:label": {
