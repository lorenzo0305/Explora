  "rdfs:comment": {
    "de": [
      "Dieser Park aus dem 19. Jahrhundert besitzt eine bedeutende botanische Sammlung, deren Arten von seinem früheren Besitzer, dem berühmten Wissenschaftler Colonel Aimé Laussedat, gepflanzt wurden."
    ],
    "en": [
      "Dating back to the 19th century, this park boasts an extensive botanical collection, including species planted by its former owner, the famous scientist Colonel Aimé Laussedat."
    ],
    "it": [
      "Risalente al XIX secolo, questo parco vanta un'ampia collezione botanica, che comprende specie piantate dal suo antico proprietario, il famoso scienziato colonnello Aimé Laussedat."
    ],
    "fr": [
      "Ce parc remontant au XIXème siècle possède une collection botanique importante dont les essences qui ont été plantées par son ancien propriétaire le colonel Aimé Laussedat célèbre scientifique."
    ],
    "es": [
      "Este parque, que data del siglo XIX, cuenta con una extensa colección botánica, que incluye especies plantadas por su antiguo propietario, el famoso científico coronel Aimé Laussedat."
    ],
    "nl": [
      "Dit park dateert uit de 19e eeuw en heeft een uitgebreide botanische collectie, waaronder soorten die zijn aangeplant door de voormalige eigenaar, de beroemde wetenschapper kolonel Aimé Laussedat."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parc Laussedat"
    ]
  },
