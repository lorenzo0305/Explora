  "rdfs:comment": {
    "de": [
      "Les Burgers Monin treffen Sie sich jeden Dienstagabend in Porcieu. Foodtruck mit hausgemachten Burgern, Hackfleisch vor Ort. 4 verschiedene Brote, die von einem Bäcker hergestellt werden.\r\nFür mehr Geschmack kommt das Gemüse von einem Erzeuger."
    ],
    "en": [
      "Les Burgers Monin welcomes you every Tuesday evening in Porcieu. Foodtruck homemade burgers, ground meat on site. 4 different breads made by a baker.\r\nFor added flavor, the vegetables come from a local grower."
    ],
    "it": [
      "Les Burgers Monin è aperto ogni martedì sera a Porcieu. Foodtruck di hamburger fatti in casa, carne macinata sul posto. 4 diversi tipi di pane prodotti da un panettiere.\r\nPer dare un tocco di sapore in più, le verdure provengono da un produttore."
    ],
    "fr": [
      "Les Burgers Monin vous donnent rendez-vous le mardi soirà Porcieu. Foodtruck burgers faits maison, viande hachée sur place. 4 pains différents confectionnés par un boulanger. \r\nPour plus de saveur les légumes viennent de chez un  producteur."
    ],
    "nl": [
      "Les Burgers Monin is elke dinsdagavond geopend in Porcieu. Foodtruck huisgemaakte hamburgers, gehakt ter plaatse. 4 verschillende broden gemaakt door een bakker.\r\nVoor extra smaak komen de groenten van een producent."
    ],
    "es": [
      "Les Burgers Monin abre todos los martes por la noche en Porcieu. Foodtruck de hamburguesas caseras, carne picada en el local. 4 panes diferentes elaborados por un panadero.\r\nPara más sabor, las verduras proceden de un productor."
    ]
  },
