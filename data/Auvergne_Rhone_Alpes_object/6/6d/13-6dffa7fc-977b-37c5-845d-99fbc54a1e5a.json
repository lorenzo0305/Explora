  "rdfs:comment": {
    "de": [
      "Boutique mit Kreationen, Seifen und originellen Geschenkideen für Groß und Klein. Eine Auswahl an Lampen, Kronleuchtern, Spiegeln, aber auch allerlei Dekorationen, um das Wohlbefinden zu Hause zu steigern, sowie Sonias handgefertigte Töpferwaren."
    ],
    "en": [
      "A shop of creation, soaps and original gift ideas for young and old. Delivery in the Valentinoise region for a minimum order of 50 €."
    ],
    "it": [
      "Un negozio che offre creazioni originali, saponi e idee regalo per grandi e piccini. Una scelta di lampade, lampadari, specchi e decorazioni per la casa di ogni tipo, oltre alle ceramiche artigianali di Sonia."
    ],
    "fr": [
      "Boutique de créations, de savons et d'idées cadeaux originaux pour petits et grands. Un choix de lampes, lustres, miroirs mais aussi toute sorte de décorations pour agrémenter le bien-être de sa maison et aussi les poteries artisanales de Sonia."
    ],
    "es": [
      "Una tienda que ofrece creaciones originales, jabones e ideas de regalo para grandes y pequeños. Una selección de lámparas, candelabros, espejos y todo tipo de adornos para el hogar, además de la cerámica artesanal de Sonia."
    ],
    "nl": [
      "Een winkel met originele creaties, zeepjes en cadeau-ideeën voor jong en oud. Keuze uit lampen, kroonluchters, spiegels en allerlei woondecoraties, plus Sonia's handgemaakte aardewerk."
    ]
  },
