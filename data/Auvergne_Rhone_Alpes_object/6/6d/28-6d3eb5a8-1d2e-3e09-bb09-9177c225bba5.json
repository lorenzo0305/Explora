  "rdfs:comment": {
    "de": [
      "Die Sipac ist das unumgängliche Treffen der Liebhaber aller Arten des Angelns.\nNach dem Erfolg der dritten Ausgabe im Jahr 2024 kehrt der SIPAC am 7. und 8. November 2026 zurück.\nProfis und Liebhaber werden sich ein Wochenende lang treffen, um ihre gemeinsame Leidenschaft zu teilen und sich darüber auszutauschen."
    ],
    "en": [
      "SIPAC is the must-attend event for fans of all types of spearfishing.\nAfter the success of the 3rd edition in 2024, SIPAC returns on November 07 & 08, 2026.\nProfessionals and enthusiasts will meet for a weekend to share and discuss their common passion."
    ],
    "it": [
      "Il SIPAC è l'evento imperdibile per gli appassionati di tutti i tipi di pesca subacquea.\nDopo il successo della terza edizione nel 2024, il SIPAC torna il 07 e 08 novembre 2026.\nProfessionisti e appassionati si riuniranno per un fine settimana per condividere e discutere la loro passione comune."
    ],
    "fr": [
      "Le sipac est le rendez-vous incontournable des passionnés de toutes les pêches au coup.\nAprès le succès de la 3e édition, en 2024, le SIPAC revient les 07 & 08 novembre 2026.\nProfessionnels et passionnés se retrouveront le temps d’un week-end pour partager et échanger autour de leur passion commune."
    ],
    "nl": [
      "SIPAC is het niet te missen evenement voor fans van alle soorten speervissen.\nNa het succes van de 3e editie in 2024 is SIPAC terug op 07 & 08 november 2026.\nProfessionals en liefhebbers komen een weekend lang samen om hun gezamenlijke passie te delen en te bespreken."
    ],
    "es": [
      "SIPAC es la cita ineludible para los aficionados a todo tipo de pesca submarina.\nTras el éxito de la 3ª edición en 2024, SIPAC vuelve los días 07 y 08 de noviembre de 2026.\nProfesionales y aficionados se reunirán durante un fin de semana para compartir y debatir sobre su pasión común."
    ]
  },
  "rdfs:label": {
    "fr": [
