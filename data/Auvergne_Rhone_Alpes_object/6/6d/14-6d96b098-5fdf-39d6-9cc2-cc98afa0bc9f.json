  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/8cd0570b-0359-3081-9c03-b7dc275c5ac0",
      "dc:description": {
        "de": [
          "Informationen :\n\nProdukte: Sandwiches, Brot, Gebäck und Konditoreiwaren\n\nTage der Öffnung:\n\nMontag bis Sonntag: 7:00-19:30 Uhr\n\nAchtung: Wegen Bauarbeiten vom 9. bis 25. November 2020 geschlossen.\n \n Abholung:\nZum Mitnehmen während der Öffnungszeiten des Geschäfts\n\nBestellungen:\n\nTelefonische Bestellungen unter 03 21 15 72 99 möglich\n\n \n \n\n "
        ],
        "en": [
          "Information :\n\nProducts: sandwiches, breads, pastries and cakes\n\nOpening days:\n\nMonday to Sunday: 7am-7.30pm\n\nPlease note that we will be closed from November 9 to November 25, 2020 for renovation work.\n \n Pick-up :\nTakeaway during store opening hours\n\nOrdering :\n\nOrder by telephone on 03 21 15 72 99\n\n \n \n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nProdotti: panini, pane, pasticceria e dolci\n\nGiorni di apertura:\n\nDa lunedì a domenica: 7.00-19.30\n\nChiusura eccezionale dal 9 al 25 novembre 2020 per lavori.\n \n Ritiro :\nAsporto durante gli orari di apertura del negozio\n\nPer ordinare :\n\nLe ordinazioni possono essere effettuate per telefono al numero 03 21 15 72 99\n\n \n \n\n "
        ],
        "fr": [
          "Informations :\n\nProduits : sandwichs, pains, viennoiseries et pâtisseries\n\nJours d'ouverture:\n\nDu lundi au dimanche: 7h-19h30\n\nAttention,  fermeture exceptionnelle du 9 au 25 novembre 2020 pour travaux.\n \n Retrait :\nÀ emporter aux horaires d'ouverture du magasin\n\nCommandes :\n\nPossibilité de commander par téléphone au  03 21 15 72 99\n\n \n \n\n "
        ],
        "nl": [
          "Meer informatie :\n\nProducten: broodjes, broodjes, gebak en taarten\n\nOpeningsdagen:\n\nMaandag t/m zondag: 7.00-19.30\n\nUitzonderlijke sluiting van 9 tot 25 november 2020 voor werkzaamheden.\n \n Intrekking :\nAfhaalmaaltijden tijdens winkelopeningstijden\n\nOm te bestellen :\n\nBestellingen kunnen telefonisch geplaatst worden op 03 21 15 72 99\n\n \n \n\n "
        ],
        "es": [
          "Más información :\n\nProductos: bocadillos, panes, bollería y pasteles\n\nDías de apertura:\n\nDe lunes a domingo: de 7.00 a 19.30 h\n\nCierre excepcional del 9 al 25 de noviembre de 2020 por obras.\n \n Retirada :\nComida para llevar durante el horario de apertura de la tienda\n\nPara pedir :\n\nLos pedidos pueden hacerse por teléfono llamando al 03 21 15 72 99\n\n \n \n\n "
        ]
      },
