  "rdfs:comment": {
    "de": [
      "Momentum ist ein Design-Store und eine Handwerkswerkstatt, die Möbel und Dekorationen anbietet und sich zum Ziel gesetzt hat, gutes Design für möglichst viele Menschen anzubieten."
    ],
    "en": [
      "Momentum is a design store and artisan workshop offering furniture and decoration, with the ambition of bringing good design to as many people as possible."
    ],
    "it": [
      "Momentum è un negozio di design e un laboratorio artigianale che offre mobili e decorazioni, con l'obiettivo di portare il buon design al maggior numero di persone possibile."
    ],
    "fr": [
      "Momentum est un design store et un atelier artisanal proposant du mobilier et de la décoration, avec pour ambition d'offrir du bon design au plus grand nombre."
    ],
    "nl": [
      "Momentum is een designwinkel en ambachtelijke werkplaats die meubels en decoratie aanbiedt met als doel goed design naar zoveel mogelijk mensen te brengen."
    ],
    "es": [
      "Momentum es una tienda de diseño y taller de artesanía que ofrece muebles y decoración, con el objetivo de acercar el buen diseño al mayor número de personas posible."
    ]
  },
