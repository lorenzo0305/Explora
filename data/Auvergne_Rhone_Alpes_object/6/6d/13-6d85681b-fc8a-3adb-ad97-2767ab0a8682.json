  "rdfs:comment": {
    "de": [
      "La Luciole ist ein Geschäft für Mineralien, Schmuck, Dekoration und esoterische Artikel. Es ist auch ein Ort des Austauschs, an dem regelmäßig Veranstaltungen organisiert werden, Vorträge, Workshops, Konzerte...immer in Verbindung mit unserem Wohlbefinden."
    ],
    "en": [
      "La Luciole is a store selling minerals, jewelry, home decor and esoteric items. It's also a place for sharing, with regular events such as conferences, workshops and concerts... always linked to our well-being."
    ],
    "it": [
      "La Luciole è un negozio di minerali, gioielli, decorazioni e oggetti esoterici. È anche un luogo di condivisione dove vengono regolarmente organizzati eventi, conferenze, workshop, concerti... sempre legati al nostro benessere."
    ],
    "fr": [
      "La Luciole est un magasin de minéraux, de bijoux, de décoration et d'articles ésotériques. C'est aussi un lieu de partage où régulièrement des évènements sont organisés, des conférences, des ateliers, des concerts...toujours en lien avec notre bien-être."
    ],
    "nl": [
      "La Luciole is een winkel met mineralen, sieraden, huisdecoratie en esoterische voorwerpen. Het is ook een plek om te delen, met regelmatige evenementen, conferenties, workshops en concerten, die allemaal verband houden met ons welzijn."
    ],
    "es": [
      "La Luciole es una tienda de minerales, joyas, decoración y artículos esotéricos. También es un lugar para compartir donde se organizan regularmente eventos, conferencias, talleres, conciertos... siempre relacionados con nuestro bienestar."
    ]
  },
