  "rdfs:comment": {
    "de": [
      "Frau Loridan bietet lokale Produkte an (regionale Produkte, Obst und Gemüse der Saison). Sie stellt außerdem verschiedene Geschenkkörbe zusammen, die aus lokalen und regionalen Produkten bestehen."
    ],
    "en": [
      "Mme Loridan offers local products (local produce, seasonal fruit and vegetables). She also makes various gift baskets of local and regional products."
    ],
    "it": [
      "La signora Loridan vende prodotti locali (prodotti locali, frutta e verdura di stagione). Inoltre, mette a punto una serie di cesti regalo con prodotti locali e regionali."
    ],
    "fr": [
      "Mme Loridan propose des produits locaux (produit du terroir, fruits et légumes de saison). Elle confectionne également différents paniers cadeaux composés de produits du terroir et de produits régionaux."
    ],
    "nl": [
      "Mevrouw Loridan verkoopt lokale producten (streekproducten, seizoensfruit en -groenten). Ze stelt ook een assortiment cadeaumanden samen met lokale en regionale producten."
    ],
    "es": [
      "La Sra. Loridan vende productos locales (productos de la tierra, frutas y verduras de temporada). También prepara cestas de regalo con productos locales y regionales."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Panier Fleuri / Au Panier du Terroir"
    ]
  },
