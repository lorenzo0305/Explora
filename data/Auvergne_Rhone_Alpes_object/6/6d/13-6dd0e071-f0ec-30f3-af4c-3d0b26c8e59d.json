  "rdfs:comment": {
    "de": [
      "Probieren Sie eine Küche mit provenzalischen Akzenten und mit einem Maximum an frischen Zutaten. Jean-Marie und sein Team bieten Ihnen eine große Auswahl an Vorschlägen (Burger, Biere und Cocktails), nicht zu vergessen die Spezialitäten aus Savoyen."
    ],
    "en": [
      "Taste a cuisine with the accents of Provence and with a maximum of fresh products. Jean-Marie and his team offer you a wide choice of suggestions (burgers, beers and cocktails), without forgetting the Savoyard specialties."
    ],
    "it": [
      "Assaggiate una cucina dall'accento provenzale e con il massimo dei prodotti freschi. Jean-Marie e il suo team vi offrono un'ampia scelta di proposte (hamburger, birre e cocktail), senza dimenticare le specialità savoiarde."
    ],
    "fr": [
      "Goûtez à une cuisine aux accents de Provence et avec un maximum de produits frais. Jean-Marie et son équipe vous proposent un large choix de suggestions (burgers, bières et cocktails), sans oublier les spécialités savoyardes."
    ],
    "nl": [
      "Proef een keuken met de accenten van de Provence en met een maximum aan verse producten. Jean-Marie en zijn team bieden u een ruime keuze aan suggesties (hamburgers, bieren en cocktails), zonder de Savoyaardse specialiteiten te vergeten."
    ],
    "es": [
      "Deguste una cocina con acento provenzal y un máximo de productos frescos. Jean-Marie y su equipo le ofrecen una amplia selección de sugerencias (hamburguesas, cervezas y cócteles), sin olvidar las especialidades saboyanas."
    ]
  },
