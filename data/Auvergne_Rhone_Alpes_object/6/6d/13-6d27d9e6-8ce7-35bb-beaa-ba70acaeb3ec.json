  "rdfs:comment": {
    "de": [
      "Der Serlin Trail ist ein vereinseigener Bikepark in Saint Martin le Vinoux, oberhalb von Grenoble."
    ],
    "en": [
      "The Serlin Trail is an association bike park in the hills above Grenoble, in Saint Martin le Vinoux, with 5 downhill mountain bike trails for beginners to experts."
    ],
    "it": [
      "Il Serlin Trail è un parco ciclistico associativo sulle colline sopra Grenoble, a Saint Martin le Vinoux, con 5 percorsi di mountain bike downhill per principianti ed esperti."
    ],
    "fr": [
      "Le Serlin Trail est un bike park associatif, situés sur les hauteurs de Grenoble, à Saint Martin le Vinoux, avec 5 pistes de VTT de descente de niveaux débutants à experts."
    ],
    "es": [
      "El Serlin Trail es un bike park asociativo en las colinas de Grenoble, en Saint Martin le Vinoux, con 5 pistas de descenso en bicicleta de montaña para principiantes y expertos."
    ],
    "nl": [
      "De Serlin Trail is een verenigingsfietspark in de heuvels boven Grenoble, in Saint Martin le Vinoux, met 5 downhill mountainbikeroutes voor beginners tot gevorderden."
    ]
  },
