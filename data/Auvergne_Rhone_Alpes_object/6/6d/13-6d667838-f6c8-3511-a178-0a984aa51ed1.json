  "rdfs:comment": {
    "de": [
      "Crémieu, die emblematische mittelalterliche Stadt der Balcons du Dauphiné, besticht durch ihre Markthalle aus dem 15. Jh., ihre Stadtmauern und ihr Augustinerkloster. Am Ausgangspunkt des Grünen Wegs bietet sie ein bewahrtes und lebendiges Kulturerbe inmitten einer Natur, die zum Wandern einlädt."
    ],
    "en": [
      "Crémieu, an iconic medieval town in the Balcons du Dauphiné region, charms visitors with its 15th-century market hall, ramparts and Augustinian convent. Located at the start of the greenway, it offers a well-preserved and vibrant heritage in the heart of a natural setting ideal for hiking."
    ],
    "it": [
      "Crémieu, emblematica cittadina medievale dei Balcons du Dauphiné, vanta una sala del mercato del XV secolo, bastioni e un convento agostiniano. All'inizio della greenway, offre un patrimonio ben conservato e vivace nel cuore di un ambiente naturale perfetto per le passeggiate."
    ],
    "fr": [
      "Crémieu, cité médiévale emblématique des Balcons du Dauphiné, séduit par sa halle du XVe s., ses remparts et son couvent des Augustins. Au départ de la voie verte, elle offre un patrimoine préservé et vivant au coeur d'une nature propice à la randonnée."
    ],
    "es": [
      "Crémieu, emblemática ciudad medieval de los Balcons du Dauphiné, cuenta con un mercado del siglo XV, murallas y un convento agustino. Al inicio de la vía verde, ofrece un patrimonio bien conservado y lleno de vida en el corazón de un entorno natural perfecto para pasear."
    ],
    "nl": [
      "Crémieu, de emblematische middeleeuwse stad van de Balcons du Dauphiné, heeft een markthal uit de 15e eeuw, stadsmuren en een Augustijner klooster op haar naam staan. Aan het begin van de groene route biedt het een goed bewaard en levendig erfgoed in het hart van een natuurlijke omgeving die perfect is om te wandelen."
    ]
  },
