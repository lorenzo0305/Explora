  "rdfs:comment": {
    "de": [
      "Le Comptoir ist die Bergkantine zum Mittagessen, aber NEU ist die Möglichkeit, neben dem schnellen und leckeren Selbstbedienungsrestaurant auch einen Tischservice anzubieten. ALLES ist hausgemacht, und abends verwandelt sich das Comptoir in einen echten Gourmet-Tisch in den Bergen."
    ],
    "en": [
      "Le Comptoir is the Cantine de Montagne at lunchtime, but NEW: the possibility of table service now in addition to the Self rapide et Gourmand. EVERYTHING is homemade, and in the evening Le Comptoir transforms itself into a real gourmet mountain restaurant."
    ],
    "it": [
      "Le Comptoir è la mensa di montagna a pranzo, ma con una NOVITÀ: la possibilità di servizio al tavolo oltre al Self-service veloce e gourmet. TUTTO è fatto in casa e la sera Le Comptoir diventa un vero e proprio ristorante di montagna gourmet."
    ],
    "fr": [
      "Le Comptoir est la Cantine de Montagne au déjeuner mais NOUVEAUTE : la possibilité d'un service a table dorénavant en plus du Self rapide et Gourmand. TOUT est maison, et le soir le Comptoir se transforme en véritable bonne table de Montagne gourmande."
    ],
    "nl": [
      "Le Comptoir is de bergkantine tijdens de lunch, maar NIEUW: de mogelijkheid van bediening aan tafel vanaf nu naast de snelle en gastronomische zelfbediening. ALLES is huisgemaakt en 's avonds wordt Le Comptoir een echt gastronomisch bergrestaurant."
    ],
    "es": [
      "Le Comptoir es la Cantina de Montaña a la hora de comer, pero NOVEDAD: posibilidad de servicio de mesa a partir de ahora además del Autoservicio Rápido y Gourmet. TODO es casero, y por la noche Le Comptoir se convierte en un auténtico restaurante gourmet de montaña."
    ]
  },
