  "rdfs:comment": {
    "de": [
      "Familienrestaurant, traditionelle und raffinierte Küche mit frischen Produkten aus der Region und der Saison. Formel und Tagesmenü nur unter der Woche am Mittag. Am Wochenende und abends Bourbonnais- oder Marktmenü."
    ],
    "en": [
      "Family-run restaurant, traditional and refined cooking based on fresh produce of the region."
    ],
    "it": [
      "Ristorante a conduzione familiare che offre una cucina tradizionale e raffinata basata su prodotti locali freschi e di stagione. Menu fissi e menu del giorno solo a pranzo durante la settimana. Menu Bourbonnais o Marché nel fine settimana e la sera."
    ],
    "fr": [
      "Restaurant familial, cuisine traditionnelle et raffinée à base de produits frais de la région et de saison. Formule et menu du jour uniquement en semaine le midi. Week-end et soirée menu Bourbonnais ou du Marché."
    ],
    "es": [
      "Restaurante familiar que ofrece una cocina tradicional y refinada basada en productos locales, frescos y de temporada. Menús y menús del día sólo al mediodía entre semana. Menú Bourbonnais o Marché los fines de semana y por la noche."
    ],
    "nl": [
      "Familierestaurant, traditionele en verfijnde gerechten op basis van verse producten uit de regio."
    ]
  },
