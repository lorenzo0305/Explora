  "rdfs:comment": {
    "de": [
      "An der Ankunft des Sessellifts von Edelweiss. Traditionelle Küche mit viel Liebe zum Detail, damit Sie zufrieden und glücklich sind. Themenabende, denken Sie an eine Reservierung."
    ],
    "en": [
      "Right near the top station of the Edelweiss chairlift. Traditional and more sophisticated cuisine to regale your tasted buds. Themed evenings Remember to make a reservation."
    ],
    "it": [
      "Alla fine della seggiovia Edelweiss. Cucina tradizionale e ben preparata, per essere felici e soddisfatti. Serate a tema, su prenotazione."
    ],
    "fr": [
      "À l’arrivée du télésiège de l’Edelweiss. Cuisine traditionnelle et travaillée, pour vous apporter satisfaction et bonheur. Soirées à thèmes, pensez à réserver."
    ],
    "nl": [
      "Aan het einde van de Edelweiss stoeltjeslift. Traditionele, goed bereide keuken om je gelukkig en tevreden te houden. Thema-avonden, vooraf reserveren."
    ],
    "es": [
      "A la llegada del telesilla del Edelweiss. Cocina tradicional y trabajada para darte satisfacción y felicidad. Veladas temáticas. Recuerda reservar."
    ]
  },
