  "rdfs:comment": {
    "de": [
      "Im Herzen des K2 Palace bietet das L'Altiplano eine elegante und gewagte peruanische Küche. Die Aromen der Glut, die Produkte der Kunsthandwerker und der Nikkei-Touch vereinen sich zu einer sinnlichen Reise zwischen Tradition und Moderne."
    ],
    "en": [
      "At the heart of Le K2 Palace, L’Altiplano unveils refined Peruvian cuisine. Grilled flavors, artisan produce and Nikkei accents create a vibrant sensory journey, blending tradition with modernity."
    ],
    "it": [
      "Nel cuore del K2 Palace, L'Altiplano offre una cucina peruviana elegante e audace. Sapori di carbone, prodotti artigianali e tocchi Nikkei si combinano per un vibrante viaggio sensoriale, tra tradizione e modernità."
    ],
    "fr": [
      "Au cœur du K2 Palace, L’Altiplano propose une cuisine péruvienne élégante et audacieuse. Saveurs de braise, produits d’artisans et touches Nikkei s’unissent pour un voyage sensoriel vibrant, entre tradition et modernité."
    ],
    "nl": [
      "In het hart van het K2 Palace biedt L'Altiplano een elegante en gedurfde Peruaanse keuken. Houtskoolsmaken, ambachtelijke producten en Nikkei-toetsen zorgen samen voor een levendige zintuiglijke reis tussen traditie en moderniteit."
    ],
    "es": [
      "En el corazón del Palacio K2, L'Altiplano ofrece una cocina peruana elegante y atrevida. Sabores a carbón, productos artesanales y toques nikkei se combinan para un vibrante viaje sensorial, entre tradición y modernidad."
    ]
  },
