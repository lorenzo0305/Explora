  "rdfs:comment": {
    "de": [
      "Unser Restaurant L'Ermitage befindet sich auf den Anhöhen von Le Puy-en-Velay im Département Haute-Loire (Auvergne). Hier entdecken Sie eine authentische französische Küche, die mit Finesse und Eleganz zubereitet wird und dem Zeitgeist entspricht."
    ],
    "en": [
      "Our L'Ermitage restaurant is located on the heights of Le Puy-en-Velay, in the Haute-Loire region (Auvergne). You'll discover authentic French cuisine, prepared with finesse and elegance, in tune with the times."
    ],
    "it": [
      "Il nostro ristorante L'Ermitage si trova sulle alture di Le Puy-en-Velay, nella regione dell'Alta Loira (Alvernia). Scoprirete l'autentica cucina francese, preparata con finezza ed eleganza, al passo con i tempi."
    ],
    "fr": [
      "Notre restaurant L'Ermitage se situe sur les hauteurs du Puy-en-Velay, en Haute-Loire (Auvergne). Vous découvrirez une cuisine française authentique, élaborée avec finesse et élégance, dans l'air du temps."
    ],
    "nl": [
      "Ons restaurant L'Ermitage ligt op de hoogten van Le Puy-en-Velay, in de Haute-Loire streek (Auvergne). U ontdekt er de authentieke Franse keuken, bereid met finesse en elegantie, in harmonie met de tijd."
    ],
    "es": [
      "Nuestro restaurante L'Ermitage está situado en las alturas de Le Puy-en-Velay, en la región del Alto Loira (Auvernia). Descubrirá la auténtica cocina francesa, preparada con finura y elegancia, en sintonía con los tiempos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant L'Ermitage"
    ]
  },
