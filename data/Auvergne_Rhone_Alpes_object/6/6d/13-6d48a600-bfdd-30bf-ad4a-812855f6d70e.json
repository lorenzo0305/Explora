  "rdfs:comment": {
    "de": [
      "Der Jardin Du PARC (Permaculture Autonome Responsable et Consciente) ist ein vielfältiger Bauernhof.\r\nIn einem 2000m² großen, nicht mechanisierten Garten werden Gemüse, Kräuter und Blumen angebaut."
    ],
    "en": [
      "Le Jardin Du PARC (Autonomous Responsible and Conscious Permaculture) is a diversified peasant farm.\r\nA 2000m² non-mechanized garden for vegetables, herbs and flowers."
    ],
    "it": [
      "Le Jardin Du PARC (Permacultura Autonoma Responsabile e Consapevole) è un'azienda agricola contadina diversificata.\r\nUn giardino di 2000 m² non meccanizzato per ortaggi, erbe e fiori."
    ],
    "fr": [
      "Le Jardin Du PARC (Permaculture Autonome Responsable et Consciente) est une ferme paysanne diversifiée.\r\nUn jardin de 2000m² non mécanisé pour les légumes, aromatiques et les fleurs."
    ],
    "es": [
      "Le Jardin Du PARC (Permacultura Autónoma Responsable y Consciente) es una granja campesina diversificada.\r\nUn jardín no mecanizado de 2000 m² para verduras, hierbas y flores."
    ],
    "nl": [
      "Le Jardin Du PARC (Autonome Verantwoordelijke en Bewuste Permacultuur) is een gediversifieerde boerderij.\r\nEen niet-gemechaniseerde tuin van 2000 m² voor groenten, kruiden en bloemen."
    ]
  },
  "rdfs:label": {
