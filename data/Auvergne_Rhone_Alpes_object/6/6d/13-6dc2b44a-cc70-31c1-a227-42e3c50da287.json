  "rdfs:comment": {
    "de": [
      "Handwerkliche Herstellung und Verkauf von Whisky, Rum, Obstbränden und anderen gastronomischen und biologischen Spirituosen. Besuchen Sie die Destillerie und entdecken Sie außergewöhnliche Produkte!"
    ],
    "en": [
      "Home-made production and sale of whisky, rum, fruit brandies, and other gourmet and organic spirits. Come visit the distillery and discover exceptional products!"
    ],
    "it": [
      "Produzione tradizionale e vendita di whisky, rum, acquaviti di frutta e altri liquori gourmet e biologici. Venite a visitare la distilleria e a scoprire prodotti eccezionali!"
    ],
    "fr": [
      "Production artisanale et vente de whisky, rhum, eaux de vie de fruits et autres spiritueux gastronomiques et biologiques. Venez visiter la distillerie et découvrir des produits d'exception !"
    ],
    "nl": [
      "Traditionele productie en verkoop van whisky, rum, vruchtenbrandewijn en andere gastronomische en biologische sterke dranken. Kom de distilleerderij bezoeken en ontdek enkele uitzonderlijke producten!"
    ],
    "es": [
      "Producción tradicional y venta de whisky, ron, aguardientes de frutas y otras bebidas espirituosas gourmet y ecológicas. ¡Venga a visitar la destilería y descubra unos productos excepcionales!"
    ]
  },
