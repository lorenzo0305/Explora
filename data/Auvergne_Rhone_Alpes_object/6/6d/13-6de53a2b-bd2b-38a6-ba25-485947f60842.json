  "rdfs:comment": {
    "de": [
      "Die Plan Lombardie-Hütte liegt im Herzen eines noch unberührten und wilden Tals am Fuße des majestätischen Schwarzen Pferdes.\r\nDie Hütte ist für Menschen mit eingeschränkter Mobilität mit dem Auto erreichbar."
    ],
    "en": [
      "The Plan Lombardie refuge lies at the heart of a wild, unspoilt valley at the foot of the majestic Cheval Noir.\r\nThe refuge is accessible by car for people with reduced mobility."
    ],
    "it": [
      "Il rifugio Plan Lombardie si trova nel cuore di una valle selvaggia e incontaminata, ai piedi del maestoso Cheval Noir.\r\nIl rifugio è accessibile in auto per le persone a mobilità ridotta."
    ],
    "fr": [
      "Le refuge du Plan Lombardie est au cœur d'un vallon encore vierge et sauvage au pied du majestueux Cheval Noir.\r\nLe refuge est accessible en voiture pour les personnes à mobilité réduite."
    ],
    "es": [
      "El refugio de Plan Lombardie se encuentra en el corazón de un valle salvaje y virgen, a los pies del majestuoso Cheval Noir.\r\nEl refugio es accesible en coche para personas con movilidad reducida."
    ],
    "nl": [
      "De Plan Lombardie refuge ligt in het hart van een wilde, ongerepte vallei aan de voet van de majestueuze Cheval Noir.\r\nDe refuge is met de auto toegankelijk voor mensen met beperkte mobiliteit."
    ]
  },
  "rdfs:label": {
    "en": [
      "Refuge de Plan Lombardie"
    ],
    "fr": [
      "Sentier vers le \"Refuge de Plan Lombardie\""
    ]
  },
