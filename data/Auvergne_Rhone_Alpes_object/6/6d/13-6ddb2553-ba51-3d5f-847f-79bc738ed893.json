  "rdfs:comment": {
    "de": [
      "Geblasene Gläser aus Damaskus und Kairo, Glasskulpturen, Mobiles und Dekorationsobjekte, Gemälde, Keramik, die an einem wunderschönen Ort ausgestellt werden (+ Gästezimmer)."
    ],
    "en": [
      "Paintings and sculptures, almost out of glass."
    ],
    "it": [
      "Vetri soffiati di Damasco e del Cairo, sculture in vetro, mobili e oggetti decorativi, dipinti, ceramiche, esposti in un luogo magnifico (+ camere per gli ospiti)."
    ],
    "fr": [
      "Verres soufflés de Damas, du Caire, sculptures de verre, mobiles et objets de décoration, peintures, céramiques, exposés dans un lieu magnifique (+ chambres d'hôtes)."
    ],
    "es": [
      "Vidrio soplado de Damasco, El Cairo, esculturas de vidrio, móviles y objetos decorativos, pinturas, cerámicas, expuestos en un magnífico lugar (+ habitaciones de invitados)."
    ],
    "nl": [
      "Geblazen glas uit Damascus en Caïro, glassculpturen, mobiles en decoratieve voorwerpen, schilderijen en keramiek, allemaal te zien in een prachtige omgeving (+ gastenkamers)."
    ]
  },
