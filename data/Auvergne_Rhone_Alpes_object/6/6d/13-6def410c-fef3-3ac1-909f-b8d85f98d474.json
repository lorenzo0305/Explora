  "rdfs:comment": {
    "de": [
      "Dieses Hotel, Restaurant und Spa liegt ideal am Stadtrand von Chambery. Es empfängt Sie herzlich wie zu Hause und bietet Ihnen drei Zimmertypen: Supérieure, Confort und Cabane für einen unvergesslichen Aufenthalt im Herzen der Savoyen."
    ],
    "en": [
      "Ideally situated on the outskirts of Chambéry, this hotel complex offers comfortable rooms, a restaurant and bar with private facilities for groups and a wellness centre. Easy parking (100 spaces)."
    ],
    "it": [
      "Situato in posizione ideale all'ingresso di Chambéry, questo hotel, ristorante e spa offre un'accoglienza calorosa e familiare in tre tipologie di camere: Superior, Comfort e Cabane, per un soggiorno indimenticabile nel cuore della Savoia."
    ],
    "fr": [
      "Idéalement situé à l'entrée de Chambéry, cet hôtel - restaurant & spa vous accueille chaleureusement comme à la Maison et vous propose trois typologies de chambres, Supérieure, Confort et Cabane, pour un séjour mémorable au cœur de la Savoie."
    ],
    "es": [
      "Idealmente situado a la entrada de Chambéry, este hotel, restaurante y spa ofrece una cálida bienvenida como en casa en tres tipos de habitaciones: Superior, Confort y Cabane, para una estancia memorable en el corazón de Savoie."
    ],
    "nl": [
      "Dit hotel, restaurant en spa heeft een ideale ligging bij de ingang van Chambéry en biedt een warm, huiselijk welkom in drie kamertypes: Superior, Comfort en Cabane, voor een onvergetelijk verblijf in het hart van de Savoie."
    ]
  },
