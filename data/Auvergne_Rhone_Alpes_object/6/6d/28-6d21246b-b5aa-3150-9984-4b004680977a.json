  "rdfs:comment": {
    "de": [
      "Entdecken Sie unseren Shop mit Ersatzteilen und Zubehör für Mobilheime aller Marken! Wir bieten auch den Verkauf von Mobilheimen, Terrassen, Terrassenüberdachungen und Gartenhäusern an. Besuchen Sie uns auf unserem Ausstellungsgelände in Quend."
    ],
    "en": [
      "Discover our store for spare parts and accessories for all brands of mobile homes! We also sell mobile homes, terraces, patio covers and garden sheds. Visit us at our showroom in Quend."
    ],
    "it": [
      "Scoprite il nostro negozio di ricambi e accessori per tutte le marche di case mobili! Vendiamo anche case mobili, terrazze, coperture per patio e capannoni da giardino. Venite a trovarci nel nostro showroom di Quend."
    ],
    "fr": [
      "Découvrez notre magasin de pièces détachées et d'accessoires pour mobil-homes toutes marques ! Nous proposons également la vente de mobil-homes, terrasses, couvertures de terrasses et abris de jardin. Retrouvez-nous sur notre parc d'exposition à Quend."
    ],
    "nl": [
      "Ontdek onze winkel met onderdelen en accessoires voor alle merken stacaravans! We verkopen ook stacaravans, terrassen, terrasoverkappingen en tuinhuisjes. Kom langs in onze showroom in Quend."
    ],
    "es": [
      "Descubra nuestra tienda de recambios y accesorios para todas las marcas de autocaravanas También vendemos mobil-homes, terrazas, cubiertas de terraza y casetas de jardín. Venga a vernos a nuestra sala de exposición de Quend."
    ]
  },
