  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/355dde42-faaf-3950-b9cf-9a37e8f4feaf",
      "dc:description": {
        "de": [
          "Charmantes 25m² großes Chalet, das vollständig ausgestattet und liebevoll dekoriert ist.  Sie können sich auf der Südterrasse, die Ihnen einen freien Blick auf den Wald bietet, sonnen und erholen!\nAbwechslung garantiert!"
        ],
        "en": [
          "Charming 25m² chalet, fully equipped and decorated to a high standard.  Soak up the sun and recharge your batteries on the south-facing terrace, with its unobstructed view of the forest!\nA change of scenery guaranteed!"
        ],
        "it": [
          "Incantevole chalet di 25 m², completamente attrezzato e arredato con gusto.  Potrete prendere il sole e fare il pieno di energia sulla terrazza esposta a sud con vista ininterrotta sulla foresta!\nUn cambiamento di scenario garantito!"
        ],
        "fr": [
          "Charmant chalet de 25m², entièrement équipé et décoré avec soin.  Vous pourrez prendre le soleil et vous ressourcer sur la terrasse plein sud qui  vous offre une vue dégagée sur la forêt ! \nDépaysement assuré !"
        ],
        "es": [
          "Encantador chalet de 25 m², totalmente equipado y decorado con gusto.  Podrá tomar el sol y reponer fuerzas en la terraza orientada al sur, con vistas ininterrumpidas al bosque\nUn cambio de aires garantizado"
        ],
        "nl": [
          "Charmant chalet van 25 m², volledig uitgerust en ingericht volgens een hoge standaard.  Op het terras op het zuiden met ononderbroken uitzicht op het bos kun je van de zon genieten en nieuwe energie opdoen!\nEen verandering van omgeving gegarandeerd!"
        ]
      },
      "@type": [
        "Description"
      ],
