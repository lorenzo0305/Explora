  "rdfs:comment": {
    "de": [
      "In einer grünen Oase, umgeben von den Tieren des Waldes, gibt Ihnen dieses Chalet das Gefühl, ans Ende der Welt zu reisen! Ein garantierter Tapetenwechsel!"
    ],
    "en": [
      "Surrounded by the animals of the forest, this chalet will give you the impression of traveling to the end of the world! A change of scenery guaranteed!"
    ],
    "it": [
      "Circondato dagli animali della foresta, questo chalet vi darà l'impressione di viaggiare alla fine del mondo! Un cambiamento di scenario garantito!"
    ],
    "fr": [
      "Dans un écrin de verdure, entouré des animaux de la forêt, ce chalet vous donnera l’impression de voyager au bout de monde ! Un dépaysement assuré !"
    ],
    "es": [
      "Rodeado de los animales del bosque, este chalet le dará la impresión de viajar al fin del mundo ¡Un cambio de aires garantizado!"
    ],
    "nl": [
      "Omringd door de dieren van het bos, geeft dit chalet je de indruk dat je naar het einde van de wereld reist! Een verandering van omgeving gegarandeerd!"
    ]
