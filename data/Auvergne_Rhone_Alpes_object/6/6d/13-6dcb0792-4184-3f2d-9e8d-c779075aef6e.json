  "rdfs:comment": {
    "de": [
      "Getreidebetrieb, Gemüseanbau, Herstellung von Mehl. Wird biologisch angebaut. Direktverkauf der Produkte des Bauernhofs. Die Bäckerei in Broût-Vernet backt viermal pro Woche Brot mit meinem Mehl."
    ],
    "en": [
      "Cereal farm, market gardening, flour production."
    ],
    "it": [
      "Azienda cerealicola, orticoltura, produzione di farina. Agricoltura biologica. Vendita diretta di prodotti agricoli. Il panificio di Broût-Vernet prepara il pane con la mia farina 4 volte alla settimana."
    ],
    "fr": [
      "Exploitation céréalière, maraichage, production de farine. Agriculture Biologique. Vente directe des produits de la ferme. La boulangerie de Broût-Vernet fait du pain avec ma farine 4 fois par semaine."
    ],
    "es": [
      "Granja de cereales, horticultura, producción de harina. Agricultura ecológica. Venta directa de productos agrícolas. La panadería de Broût-Vernet hace pan con mi harina 4 veces por semana."
    ],
    "nl": [
      "Graanboerderij, tuinbouw, meelproductie. Biologische landbouw. Directe verkoop van producten van de boerderij. De bakkerij in Broût-Vernet bakt 4 keer per week brood met mijn meel."
    ]
  },
