  "rdfs:comment": {
    "de": [
      "Dieser Weiler, der sich an den Südhang des Plomb du Cantal klammert, hat sich seine authentische Seele bewahrt. In 1200 m Höhe scheint er über St Jacques des Blats und das Tal der Cère zu wachen..."
    ],
    "en": [
      "Clinging to the southern slopes of the Plomb du Cantal, this hamlet has retained its authentic soul. At 1200m altitude, it seems to watch over St Jacques des Blats and the Cère valley..."
    ],
    "it": [
      "Aggrappato alle pendici meridionali del Plomb du Cantal, questo borgo ha conservato la sua anima autentica. A 1200 metri di altitudine, sembra vegliare su St Jacques des Blats e sulla valle del Cère..."
    ],
    "fr": [
      "Accroché sur le versant sud du Plomb du Cantal, ce hameau a su garder son âme authentique. A 1200m d'altitude, il semble veiller sur St Jacques des Blats et la vallée de la Cère..."
    ],
    "nl": [
      "Dit gehucht ligt op de zuidelijke hellingen van de Plomb du Cantal en heeft zijn authentieke ziel behouden. Op een hoogte van 1200m lijkt hij te waken over St Jacques des Blats en de vallei van de Cère..."
    ],
    "es": [
      "Aferrada a la ladera sur del Plomb du Cantal, esta aldea ha conservado su alma auténtica. A 1200 m de altitud, parece vigilar St Jacques des Blats y el valle de la Cère..."
    ]
  },
  "rdfs:label": {
    "en": [
      "The hamlet of Les Gardes"
    ],
    "fr": [
      "Le Hameau des Gardes"
    ],
    "es": [
      "Aldea de Gardes"
    ]
  },
