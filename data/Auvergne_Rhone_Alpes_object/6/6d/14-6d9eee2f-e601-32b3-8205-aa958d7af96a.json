      "dc:description": {
        "de": [
          "Informationen :\n\nÖffnungstage:\n\nDienstag bis Samstag von 7:00 bis 20:00 Uhr\nSonntag von 8:00 bis 13:00 Uhr\n\nMontag geschlossen\n \n Abholung :\n\nZu den Öffnungszeiten des Geschäfts\n\n\n "
        ],
        "en": [
          "Information :\n\nOpening days:\n\nTuesday to Saturday, 7am to 8pm\nSunday 8am to 1pm\n\nClosed on Monday\n \n Collection:\n\nDuring store opening hours\n\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura:\n\nDa martedì a sabato dalle 7.00 alle 20.00\nDomenica dalle 8.00 alle 13.00\n\nChiuso il lunedì\n \n Raccolta:\n\nDurante gli orari di apertura del negozio\n\n\n "
        ],
        "fr": [
          "Informations :\n\nJours d'ouverture:\n\nDu mardi au samedi de 7h à 20h\nLe dimanche de 8h à 13h\n\nFermeture le lundi\n \n Retrait :\n\nAux horaires d'ouverture du magasin\n\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen:\n\nDinsdag tot zaterdag van 7u tot 20u\nZondag van 8u tot 13u\n\nMaandag gesloten\n \n Ophalen:\n\nTijdens winkelopeningstijden\n\n\n "
        ],
        "es": [
          "Más información :\n\nDías de apertura:\n\nDe martes a sábado de 7h a 20h\nDomingo de 8h a 13h\n\nLunes cerrado\n \n Recogida:\n\nDurante el horario de apertura de la tienda\n\n\n "
        ]
      },
