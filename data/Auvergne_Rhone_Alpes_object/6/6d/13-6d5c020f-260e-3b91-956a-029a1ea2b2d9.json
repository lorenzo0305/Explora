  "rdfs:comment": {
    "de": [
      "Die Schmuggler des weißen Goldes: Schnitzeljagd in Chanaz! Bewege dich mithilfe des Briefes eines Gefangenen durch das Dorf, um Hinweise zu finden und Rätsel zu lösen, die es dir ermöglichen, den Tresor der Zöllner zu öffnen!"
    ],
    "en": [
      "Treasure Hunt: The Smugglers of White Gold: a treasure hunt in Chanaz! With the help of a prisoner's letter, move around the village to find clues and solve riddles that will enable you to open the customs officers' safe!"
    ],
    "it": [
      "Caccia al tesoro: I Contrabbandieri dell'oro bianco: una caccia al tesoro a Chanaz! Grazie alla lettera di un prigioniero, muoviti nel villaggio per trovare indizi e risolvere enigmi che ti permetteranno di aprire la cassaforte dei doganieri!"
    ],
    "fr": [
      "Les contrebandiers de l'or blanc: jeu de piste à Chanaz ! Grâce à la lettre d'un prisonnier, déplacez vous dans le village pour trouver des indices et résoudre des énigmes qui vous permettront d'ouvrir le coffre fort des douaniers !"
    ],
    "nl": [
      "Smokkelaars van wit goud: een schattenjacht in Chanaz! Zoek aan de hand van een brief van een gevangene in het dorp naar aanwijzingen en los de raadsels op waarmee je de kluis van de douaniers kunt openen!"
    ],
    "es": [
      "Contrabandistas de oro blanco: ¡una búsqueda del tesoro en Chanaz! Gracias a la carta de un prisionero, recorre el pueblo en busca de pistas y resuelve los enigmas que te permitirán abrir la caja fuerte de los aduaneros"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Contrebandiers de l'Or blanc - Team Building"
    ]
  },
