  "rdfs:comment": {
    "de": [
      "Ein außergewöhnliches Panorama: Mont Blanc\nDas Bar-Restaurant ist täglich von 9:00 bis 17:30 Uhr geöffnet. Genießen Sie lokale, hausgemachte Gerichte auf der Terrasse mit Blick auf das Mont-Blanc-Massiv."
    ],
    "en": [
      "An exceptional panorama: Mont Blanc\nThe Bar Restaurant is open daily from 9:00 a.m. to 5:30 p.m. You can enjoy local, homemade dishes from the terrace overlooking the Mont Blanc range."
    ],
    "it": [
      "Un panorama eccezionale: il Monte Bianco\nIl Bar Ristorante è aperto tutti i giorni dalle 9:00 alle 17:30. Potrete gustare piatti locali fatti in casa sulla terrazza con vista sulla catena del Monte Bianco."
    ],
    "fr": [
      "Un panorama d'exception : Le Mont Blanc\nLe Bar Restaurant est ouvert tous les jours de 9h00 à 17h30, vous pourrez savourer des plats locaux et faits maison depuis la terrasse face à la chaîne du Mont Blanc."
    ],
    "es": [
      "Un panorama excepcional: el Mont Blanc\nEl Bar Restaurante abre todos los días de 9:00 a 17:30, donde podrá degustar platos locales y caseros desde la terraza con vistas a la cordillera del Mont Blanc."
    ],
    "nl": [
      "Een uitzonderlijk panorama: de Mont Blanc\nHet Bar Restaurant is dagelijks geopend van 9.00 tot 17.30 uur. U kunt genieten van lokale, huisgemaakte gerechten op het terras met uitzicht op de Mont Blanc."
    ]
  },
