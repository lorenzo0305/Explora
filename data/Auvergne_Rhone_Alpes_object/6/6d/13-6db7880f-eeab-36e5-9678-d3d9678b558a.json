  "rdfs:comment": {
    "de": [
      "Becken mit offenem Boden. Beaufsichtigtes Schwimmen, Liegewiese. Wassergymnastik, Aquabike, Schwimmunterricht. In der Nähe: Campingplatz, Wasserfläche, Tennis, GR3 für Wanderungen."
    ],
    "en": [
      "Outdoor heated pool. Lifeguard on duty, grass space. Aquafit,swimming lessons. Nearby : campsite, pond, minigolf, tennis and hiking."
    ],
    "it": [
      "Piscina all'aperto. Nuoto sorvegliato, prato. Aquagym, Aquabike, corsi di nuoto. Nelle vicinanze: campeggio, lago, campi da tennis, sentieri GR3."
    ],
    "fr": [
      "Bassin découvert. Baignade surveillée, espace pelouse. Aquagym, Aquabike, leçons de natation. À proximité : camping, plan d'eau, tennis, GR3 pour randonnées."
    ],
    "es": [
      "Piscina al aire libre. Natación vigilada, zona de césped. Aquagym, Aquabike, clases de natación. Cerca: camping, lago, pistas de tenis, senderos GR3."
    ],
    "nl": [
      "Openluchtzwembad. Zwemmen onder toezicht, ligweide. Aquagym, Aquabike, zwemlessen. In de omgeving: camping, meer, tennisbanen, GR3 wandelroutes."
    ]
  },
