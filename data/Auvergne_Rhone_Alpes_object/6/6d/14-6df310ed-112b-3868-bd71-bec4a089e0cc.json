  "rdfs:comment": {
    "de": [
      "40. Jahrestag des Todes des beliebtesten Komikers des französischen Kinos!\nAnlässlich des von der Stadt Harnes organisierten Frühlingsfestes lädt CineComedies Sie zu einem Abend im Drive-In-Modus ein."
    ],
    "en": [
      "40th anniversary of the death of the most popular comic actor in French cinema!\nOn the occasion of the Spring Festival organized by the town of Harnes, CineComedies offers you an evening in Drive-In mode."
    ],
    "it": [
      "il 40° anniversario della morte dell'attore comico più popolare del cinema francese!\nNell'ambito della Festa di Primavera organizzata dalla città di Harnes, CineComedies vi propone una serata in modalità Drive-In."
    ],
    "fr": [
      "40ème anniversaire de la disparition de l’acteur comique le plus populaire du cinéma français !\nÀ l’occasion de la Fête de Printemps organisée par la ville de Harnes, CineComedies vous propose une soirée en mode Drive-In."
    ],
    "es": [
      "se cumplen 40 años de la muerte del actor cómico más popular del cine francés\nEn el marco de la Fiesta de la Primavera organizada por la ciudad de Harnes, CineComedies le propone una velada en modo autocine."
    ],
    "nl": [
      "de 40e verjaardag van het overlijden van de populairste komische acteur van de Franse cinema!\nIn het kader van het Lentefeest van de stad Harnes brengt CineComedies een avond in Drive-In stijl."
    ]
  },
  "rdfs:label": {
