  "rdfs:comment": {
    "de": [
      "Inspiriert von seiner direkten Umgebung, übt der handwerkliche Keramiker Jean-Pol seine kreative Freiheit aus, um Ihnen persönliche Kreationen anzubieten, die von einzigartigen Objekten inspiriert sind."
    ],
    "en": [
      "Inspired by his direct environment, artisan ceramicist Jean-Pol expresses his freedom of creativity to offer you personal creations inspired by the unique object."
    ],
    "it": [
      "Ispirato dal suo ambiente diretto, il ceramista Jean-Pol esercita la sua libertà creativa per offrirvi creazioni personali ispirate all'oggetto unico."
    ],
    "fr": [
      "Inspiré par son environnement direct, l'artisan céramiste Jean-Pol exerce sa liberté de créativité pour vous proposer des créations personnelles inspirées par l'objet unique."
    ],
    "es": [
      "Inspirándose en su entorno directo, el ceramista Jean-Pol ejerce su libertad creativa para ofrecerle creaciones personales inspiradas en el objeto único."
    ],
    "nl": [
      "Geïnspireerd door zijn directe omgeving, oefent keramist Jean-Pol zijn creatieve vrijheid uit om je persoonlijke creaties aan te bieden, geïnspireerd door het unieke object."
    ]
  },
