  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/4eaaf80b-8282-32bb-8332-050455973a66",
      "dc:description": {
        "de": [
          "In den Sümpfen von Guînes versteckt sich ein Kokon des Wohlbefindens, in einer grünen Oase. Der Ort garantiert Ihnen eine totale Abwechslung inmitten der Natur."
        ],
        "en": [
          "Located in the marshes of Guînes, this cocoon of well-being is set in lush greenery, providing a complete change of scenery in the heart of nature."
        ],
        "it": [
          "Situato nelle paludi di Guînes, questo bozzolo di benessere è immerso in una vegetazione lussureggiante e offre un completo cambiamento di scenario nel cuore della natura."
        ],
        "fr": [
          "Situé au marais de Guînes, se cache un cocon de bien-être, dans un écrin de verdure, le lieu vous assure un dépaysement total en pleine nature."
        ],
        "es": [
          "Situado en las marismas de Guînes, este capullo de bienestar está rodeado de exuberante vegetación, lo que supone un completo cambio de aires en plena naturaleza."
        ],
        "nl": [
          "Deze cocon van welzijn ligt in de moerassen van Guînes, te midden van weelderig groen, en biedt een complete verandering van omgeving in het hart van de natuur."
        ]
      },
      "@type": [
        "Description"
