  "rdfs:comment": {
    "de": [
      "Bergbegleiter (staatlich geprüft). Philippe, seit 25 Jahren Begleiter im Herzen des Vercors, lädt Sie ein, seine Leidenschaft für die Berge zu teilen und alle Reichtümer seines Massivs zu entdecken."
    ],
    "en": [
      "Philippe is a state-certified mountain guide and has been a guide in the heart of the Vercors for 25 years. He invites you to share his passion for the mountains and to discover all the treasures of the massif."
    ],
    "it": [
      "Guida alpina certificata dallo Stato. Philippe è stato guida alpina nel cuore del Vercors per oltre 25 anni e vi invita a condividere la sua passione per la montagna e a scoprire tutti i tesori del massiccio."
    ],
    "fr": [
      "Accompagnateur en montagne (breveté d'état). Philippe, Accompagnateur au cœur du Vercors depuis plus de 25 ans, vous invite à partager sa passion pour la montagne et à découvrir toutes les richesses de son massif."
    ],
    "es": [
      "Guía de montaña diplomado por el Estado. Philippe, guía de montaña en el corazón del Vercors desde hace más de 25 años, le invita a compartir su pasión por la montaña y a descubrir todos los tesoros del macizo."
    ],
    "nl": [
      "Door de staat gediplomeerd bergleider. Philippe is al meer dan 25 jaar bergleider in het hart van de Vercors en nodigt je uit om zijn passie voor de bergen te delen en alle schatten van het massief te ontdekken."
    ]
  },
  "rdfs:label": {
    "de": [
      "Philippe Maret - Naturwanderungen"
    ],
    "en": [
      "Philippe Maret - Rando Nature"
    ],
    "fr": [
      "Philippe Maret - Rando Nature"
    ]
  },
