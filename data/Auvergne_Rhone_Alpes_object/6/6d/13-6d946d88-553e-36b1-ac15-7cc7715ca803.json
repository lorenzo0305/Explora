  "rdfs:comment": {
    "de": [
      "Anlässlich der Rückkehr der schönen Tage lädt die Mediathek Sie zu einem Moment der Entspannung und Entdeckung rund um Lektüren ein, die die Rückkehr des Frühlings ankündigen!"
    ],
    "en": [
      "As the warm weather returns, the multimedia library invites you to a moment of relaxation and discovery with readings that herald the return of spring!"
    ],
    "it": [
      "Con il ritorno della bella stagione, la biblioteca multimediale vi invita a rilassarvi e a scoprire nuove cose attraverso letture che annunciano il ritorno della primavera!"
    ],
    "fr": [
      "À l'occasion du retour des beaux jours, la médiathèque vous invite à un moment de détente et de découverte autour de lectures qui annoncent le retour du printemps !"
    ],
    "nl": [
      "Nu het weer warmer wordt, nodigt de mediatheek je uit om te ontspannen en nieuwe dingen te ontdekken door middel van lezingen die de terugkeer van de lente inluiden!"
    ],
    "es": [
      "Con la llegada del buen tiempo, la biblioteca multimedia le invita a relajarse y descubrir cosas nuevas a través de lecturas que anuncian el regreso de la primavera"
    ]
  },
  "rdfs:label": {
