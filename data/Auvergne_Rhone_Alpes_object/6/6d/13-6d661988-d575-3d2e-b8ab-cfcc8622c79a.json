  "rdfs:comment": {
    "de": [
      "Von der Cie Perpétuel Détour. Von und mit Vincent Longefay und Karine Michel. Ein Bruder, eine Schwester. Das Haus der Familie. Man sucht danach. Aber... Was suchen wir eigentlich? Dauer: 50 Min. - Für alle ab 6 Jahren."
    ],
    "en": [
      "By Cie Perpétuel Détour. By Vincent Longefay and Karine Michel. A brother, a sister. The family home. The search is on. But what are we looking for? What exactly are we looking for? Running time: 50 min. - For all ages 6 and up."
    ],
    "it": [
      "A cura della compagnia Perpétuel Détour. Di Vincent Longefay e Karine Michel. Un fratello, una sorella. La casa di famiglia. Stiamo cercando. Ma cosa stiamo cercando? Cosa stiamo cercando esattamente? Durata: 50 minuti - Per un pubblico dai 6 anni in su."
    ],
    "fr": [
      "Par la Cie Perpétuel Détour. De et par Vincent Longefay et Karine Michel. Un frère, une sœur. La maison familiale. On cherche. Mais... On cherche quoi, au juste ? Durée : 50 mn - Tout public à partir 6 ans."
    ],
    "es": [
      "Por la compañía Perpétuel Détour. Por Vincent Longefay y Karine Michel. Un hermano, una hermana. La casa familiar. Estamos buscando. Pero, ¿qué buscamos? ¿Qué buscamos exactamente? Duración: 50 minutos - Para todos los públicos a partir de 6 años."
    ],
    "nl": [
      "Door het bedrijf Perpétuel Détour. Door Vincent Longefay en Karine Michel. Een broer, een zus. Het huis van de familie. We zijn op zoek. Maar wat zoeken we? Wat zoeken we precies? Duur: 50 min. - Voor publiek vanaf 6 jaar."
    ]
  },
