  "rdfs:comment": {
    "de": [
      "Workshop zur Herstellung von Objekten aus Laubsägearbeiten. Verwendung zahlreicher regionaler Holzarten. Besichtigung der Werkstatt, Boutique, individuelle Kreationen, Einführungsworkshops für Kinder und Praktika für Erwachsene."
    ],
    "en": [
      "Discover the art of scrollsawing! Demonstrations and conversations with the artisan, Gilles. His designs will inspire you: gingerbread woodwork, games, toys, ornaments… Beginners workshops available."
    ],
    "it": [
      "Laboratorio per la creazione di oggetti in legno smerlato. Utilizzo di molte specie regionali. Visite al laboratorio, al negozio, creazioni personalizzate, laboratori introduttivi per bambini e corsi per adulti."
    ],
    "fr": [
      "Atelier de création d'objets en bois chantourné. Utilisation de nombreuses essences régionales. Visites de l'atelier, boutique, créations personnalisées, ateliers d'initiation enfants et stages adultes."
    ],
    "nl": [
      "Workshop voor het maken van geschulpte houten objecten. Gebruik van vele regionale soorten. Bezoeken aan het atelier, winkel, gepersonaliseerde creaties, kennismakingsworkshops voor kinderen en cursussen voor volwassenen."
    ],
    "es": [
      "Taller de creación de objetos de madera festoneados. Uso de muchas especies regionales. Visitas al taller, tienda, creaciones personalizadas, talleres de iniciación para niños y cursos para adultos."
    ]
  },
