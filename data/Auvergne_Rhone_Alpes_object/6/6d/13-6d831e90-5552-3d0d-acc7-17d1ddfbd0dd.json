  "rdfs:comment": {
    "de": [
      "Willkommen im Lebensmittelladen-Café des Dritten Ortes L'assemblée!\r\n\r\nL'assemblette: ein geselliger und engagierter Ort, der von einem netten Team begeisterter Freiwilliger und den Produzenten selbst betrieben wird, die stolz darauf sind, Ihnen ihre Schätze aus der Region zu zeigen!"
    ],
    "en": [
      "Welcome to the L'assemblée grocery-café!\r\n\r\nL'assemblette: a friendly, committed place, run by a great team of passionate volunteers and by the producers themselves, proud to help you discover their local treasures!"
    ],
    "it": [
      "Benvenuti al bar-drogheria L'Assemblée!\r\n\r\nL'assemblette è un luogo accogliente e impegnato, gestito da una grande squadra di volontari appassionati e dai produttori stessi, che sono orgogliosi di farvi scoprire i loro tesori locali!"
    ],
    "fr": [
      "Bienvenue à l’épicerie-café du tiers-lieu L'assemblée !\r\n\r\nL'assemblette : un lieu convivial et engagé, animé par une belle équipe de bénévoles passionné·es et par les producteur·ices eux-mêmes, fier·es de vous faire découvrir leurs trésors du terroir !"
    ],
    "es": [
      "¡Bienvenido a la tienda-café L'assemblée!\r\n\r\nL'assemblette es un lugar acogedor y comprometido, dirigido por un gran equipo de voluntarios apasionados y por los propios productores, que están orgullosos de ayudarle a descubrir sus tesoros locales"
    ],
    "nl": [
      "Welkom in het kruidenierscafé L'assemblée!\r\n\r\nL'assemblette is een gezellige, geëngageerde plek, gerund door een geweldig team van gepassioneerde vrijwilligers en door de producenten zelf, die er trots op zijn om u hun lokale schatten te laten ontdekken!"
    ]
  },
  "rdfs:label": {
