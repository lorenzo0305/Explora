  "rdfs:comment": {
    "de": [
      "Frei zugänglicher Pumptrack am Ufer des Sees Saint-Clair in Valgelon-La Rochette. Ein spielerischer Parcours für Fahrräder, Roller, Inlineskates und Skateboards, der für alle Niveaus zugänglich ist."
    ],
    "en": [
      "Free-access pumptrack on the shores of Lac Saint-Clair in Valgelon-La Rochette. A fun course for bikes, scooters, rollerblades and skateboards, accessible to all levels."
    ],
    "it": [
      "Pista ad accesso libero sulle rive del lago Saint-Clair a Valgelon-La Rochette. Un percorso divertente per biciclette, monopattini, rollerblade e skateboard, accessibile a tutte le abilità."
    ],
    "fr": [
      "Pumptrack en accès libre au bord du lac Saint-Clair à Valgelon-La Rochette. Parcours ludique pour vélos, trottinettes, rollers et skateboards, accessible à tous les niveaux."
    ],
    "nl": [
      "Vrij toegankelijk pumptrack aan de oever van het Lac Saint-Clair in Valgelon-La Rochette. Een leuk parcours voor fietsen, scooters, skeelers en skateboards, toegankelijk voor alle niveaus."
    ],
    "es": [
      "Pumptrack de acceso libre a orillas del lago Saint-Clair, en Valgelon-La Rochette. Un divertido sendero para bicicletas, patinetes, patines y monopatines, accesible a todos los niveles."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Pumptrack Camp de base du Lac saint-Clair"
    ]
  },
