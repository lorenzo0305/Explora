  "rdfs:comment": {
    "de": [
      "Annie Cotterot wird Ihnen ihre Arbeit als Keramikbildhauerin vorstellen: von der Vorbereitung des Tons über das Modellieren, das Glasieren und die Vorbereitung der Glasuren bis hin zum Biskuit- und Raku-Brand und der Fertigstellung der fertigen Stücke."
    ],
    "en": [
      "Annie Cotterot will introduce you to her work as a ceramic sculptor: from clay preparation to the finishing of finished pieces, including modeling, glazing and glaze preparation, cookie and raku firing."
    ],
    "it": [
      "Annie Cotterot presenterà il suo lavoro di scultrice di ceramica: dalla preparazione dell'argilla alla finitura dei pezzi finiti, passando per la modellazione, la smaltatura e la preparazione degli smalti, la cottura a biscotto e raku."
    ],
    "fr": [
      "Annie Cotterot vous présentera son travail de sculpteur céramiste : de la préparation de la terre à la finition des pièces terminées, en passant par les travaux de modelage, d'émaillage et de préparation des émaux, les cuissons biscuit et raku."
    ],
    "nl": [
      "Annie Cotterot zal haar werk als keramisch beeldhouwer presenteren: van de voorbereiding van de klei tot de afwerking van de afgewerkte stukken, inclusief het boetseren, het glazuren en de bereiding van de glazuren, het biscuit- en raku-stoken."
    ],
    "es": [
      "Annie Cotterot presentará su trabajo como escultora de cerámica: desde la preparación de la arcilla hasta el acabado de las piezas terminadas, pasando por el modelado, el esmaltado y la preparación de los esmaltes, la cocción de galletas y el raku."
    ]
  },
