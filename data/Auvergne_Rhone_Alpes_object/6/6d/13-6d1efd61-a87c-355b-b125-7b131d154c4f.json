  "rdfs:comment": {
    "de": [
      "Tartifles, Kohlrabi, Eisköniginnen? Das wächst in den Bergen! Verwende das Papier, um deinen Miniatur-Gemüsegarten anzulegen."
    ],
    "en": [
      "Tartifles, kohlrabi, ice queens? It all grows in the mountains! Use paper to create your own miniature vegetable garden."
    ],
    "it": [
      "Tartifles, cavolo rapa, regine di ghiaccio? Tutto cresce in montagna! Utilizzate la carta per creare il vostro orto in miniatura."
    ],
    "fr": [
      "Tartifles, choux raves, reines des glaces… Ça pousse à la montagne ! Utilise le papier pour composer ton potager miniature."
    ],
    "nl": [
      "Tartifles, koolrabi, ijskoninginnen? Het groeit allemaal in de bergen! Gebruik het papier om je eigen miniatuur moestuin te maken."
    ],
    "es": [
      "Tartifles, colinabos, reinas de hielo.. ¡Todo crece en las montañas! Utiliza el papel para crear tu propio huerto en miniatura."
    ]
