  "rdfs:comment": {
    "de": [
      "Vom emblematischen Schloss Rochebaron aus bietet sich ein bemerkenswerter Blick auf die Loire, die sich am Fuße des Mont du Malorum sehnsuchtsvoll ausbreitet."
    ],
    "en": [
      "From the emblematic castle of Rochebaron, the view of the Loire River that languidly spreads out at the foot of the Mont du Malorum is remarkable."
    ],
    "it": [
      "Dall'emblematico Château de Rochebaron, la vista sulla Loira, che si estende languidamente ai piedi del Mont du Malorum, è notevole."
    ],
    "fr": [
      "Depuis l’emblématique château de Rochebaron, le point de vue sur la Loire qui s’étale langoureusement au pied du Mont du Malorum est remarquable."
    ],
    "nl": [
      "Vanaf het emblematische Château de Rochebaron is het uitzicht op de Loire, die zich loom uitstrekt aan de voet van de Mont du Malorum, opmerkelijk."
    ],
    "es": [
      "Desde el emblemático castillo de Rochebaron, la vista del Loira, que se extiende lánguidamente al pie del monte du Malorum, es notable."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Table d'orientation Château de Rochebaron"
    ]
  },
