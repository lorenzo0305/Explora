  "rdfs:comment": {
    "de": [
      "Dieses unter Denkmalschutz stehende Renaissanceschloss hat sich eine ganz italienische Eleganz bewahrt. Es trägt die Handschrift seines berühmten Architekten Sebastiano Serlio und seines Auftraggebers, Kardinal François de Tournon, dem persönlichen Berater von Franz I."
    ],
    "en": [
      "This Renaissance château, classified as a Historic Monument, has retained its Italian elegance. It bears the imprint of its illustrious architect Sebastiano Serlio and its sponsor, Cardinal François de Tournon, personal adviser to François I."
    ],
    "it": [
      "Questo castello rinascimentale, classificato come Monumento Storico, ha conservato un'eleganza tutta italiana. Porta l'impronta del suo illustre architetto Sebastiano Serlio e del suo committente, il cardinale François de Tournon, consigliere personale di Francesco I."
    ],
    "fr": [
      "Ce château Renaissance classé Monument Historique a conservé une élégance toute italienne. Il porte l'empreinte de son illustre architecte Sebastiano Serlio et de son commanditaire, le cardinal François de Tournon, conseiller personnel de François 1er."
    ],
    "es": [
      "Este castillo renacentista, catalogado como Monumento Histórico, conserva una elegancia muy italiana. Lleva la huella de su ilustre arquitecto Sebastiano Serlio y de su mecenas, el cardenal François de Tournon, consejero personal de Francisco I."
    ],
    "nl": [
      "Dit Renaissance kasteel, geklasseerd als historisch monument, heeft een zeer Italiaanse elegantie behouden. Het draagt het stempel van zijn illustere architect Sebastiano Serlio en van zijn beschermheer, kardinaal François de Tournon, persoonlijk adviseur van François I."
    ]
  },
