  "rdfs:comment": {
    "de": [
      "Die Krippe bietet tagsüber eine regelmäßige und gelegentliche Gruppenbetreuung für Kinder im Alter von 3 Monaten bis 3 Jahren von Montag bis Freitag von 7:30 bis 18:30 Uhr, auch während der Schulferien."
    ],
    "en": [
      "The day nursery provides collective, regular and occasional care for children aged 3 months to 3 years, from Monday to Friday, from 7.30 am to 6.30 pm, including during school vacations."
    ],
    "it": [
      "L'asilo nido offre assistenza di gruppo regolare e occasionale per bambini dai 3 mesi ai 3 anni dal lunedì al venerdì dalle 7.30 alle 18.30, anche durante le vacanze scolastiche."
    ],
    "fr": [
      "La crèche assure pendant la journée un accueil collectif, régulier et occasionnel pour les enfants de 3 mois à 3 ans du lundi au vendredi de 7h30 à 18h30, y compris pendant les vacances scolaires."
    ],
    "es": [
      "La guardería ofrece atención regular y ocasional en grupo para niños de 3 meses a 3 años de lunes a viernes de 7.30 a 18.30, incluso durante las vacaciones escolares."
    ],
    "nl": [
      "Het kinderdagverblijf biedt collectieve, regelmatige en incidentele opvang voor kinderen van 3 maanden tot 3 jaar, van maandag tot vrijdag van 7.30 tot 18.30 uur, ook tijdens schoolvakanties."
    ]
  },
