  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/5fcd5b83-d5bc-3b46-a9db-63282ce46517",
      "dc:description": {
        "de": [
          "Erleben Sie mit unserer Bestäuber-Rallye ein spannendes Abenteuer im Bois d'Epinoy! Erforschen Sie die faszinierenden Geheimnisse dieser kleinen, für unser Ökosystem wichtigen Lebewesen und entdecken Sie ihre lebenswichtige Rolle."
        ],
        "en": [
          "Come and experience an exciting adventure in the Bois d'Epinoy with our pollinator rally! Explore the fascinating secrets of these small creatures essential to our ecosystem and discover their vital role."
        ],
        "it": [
          "Venite a vivere un'emozionante avventura nel Bois d'Epinoy con il nostro raduno degli impollinatori! Esplorate gli affascinanti segreti di queste piccole creature essenziali per il nostro ecosistema e scoprite il loro ruolo vitale."
        ],
        "fr": [
          "Venez vivre une aventure passionnante au Bois d'Epinoy avec notre rallye pollinisateur  ! Explorez les secrets fascinants de ces petites créatures essentielles à notre écosystème et découvrez leur rôle vital."
        ],
        "es": [
          "¡Venga a disfrutar de una emocionante aventura en el Bois d'Epinoy con nuestro rally de polinizadores! Explore los fascinantes secretos de estas pequeñas criaturas esenciales para nuestro ecosistema y descubra su papel vital."
        ],
        "nl": [
          "Kom en beleef een spannend avontuur in het Bois d'Epinoy met onze bestuiversrally! Ontdek de fascinerende geheimen van deze kleine wezentjes die essentieel zijn voor ons ecosysteem en ontdek hun vitale rol."
        ]
      },
