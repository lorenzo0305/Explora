  "rdfs:comment": {
    "de": [
      "Im Sommer auf der Alm und im Winter mitten auf den Pisten: Entdecken Sie die Spezialitäten aus Haute-Savoyen! Hausgemachte Küche à la carte und Schnellrestaurants."
    ],
    "en": [
      "In the mountain pastures in summer and in the heart of the slopes in winter, come and discover the specialities of Haute-Savoie! Home cooking à la carte and fast food."
    ],
    "it": [
      "Sugli alpeggi in estate e nel cuore delle piste in inverno, venite a scoprire le specialità regionali! Cucina casalinga con prodotti locali, piatti à la carte e fast food."
    ],
    "fr": [
      "En alpage l'été et au cœur des pistes l'hiver, venez découvrir les spécialités régionales ! Cuisine maison avec les produits du terroirs, plats à la carte et restauration rapide."
    ],
    "nl": [
      "Kom in de zomer op de alpenweiden en in de winter midden op de pistes de specialiteiten van de Haute-Savoie ontdekken! Home cooking à la carte en fast food."
    ],
    "es": [
      "En los pastos de montaña en verano y en el corazón de las pistas en invierno, ¡venga a descubrir las especialidades de la Alta Saboya! Comida casera a la carta y comida rápida."
    ]
  },
