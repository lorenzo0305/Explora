  "rdfs:comment": {
    "de": [
      "Sie werden in einem ehemaligen Bauernhaus in der Nähe der Stadtmauern empfangen.\nDer Küchenchef bereitet eine traditionelle, hausgemachte Küche zu und verwendet frische und saisonale Produkte."
    ],
    "en": [
      "You will be welcomed in an old farmhouse near the ramparts.\nThe chef prepares a traditional home-made cuisine and uses fresh and seasonal products."
    ],
    "it": [
      "Sarete accolti in un'antica casa colonica vicino ai bastioni.\nLo chef prepara una cucina tradizionale fatta in casa con prodotti freschi e di stagione."
    ],
    "fr": [
      "Vous serez accueillis dans un ancien corps de ferme près des remparts.\nLe chef réalise une cuisine traditionnelle faite maison et utilise des produits frais et de saison."
    ],
    "nl": [
      "U wordt ontvangen in een oude boerderij bij de stadswallen.\nDe chef bereidt een traditionele huisgemaakte keuken met verse en seizoensgebonden producten."
    ],
    "es": [
      "Le acogerán en una antigua granja cerca de las murallas.\nEl chef prepara una cocina casera tradicional con productos frescos y de temporada."
    ]
  },
