  "rdfs:comment": {
    "de": [
      "Sicherlich eines der ältesten Hotels des Tals, gemütliche Zimmer im Bergstil, gemütliche Lounge und Bar. Restaurant mit Savoyard-Rahmen, traditionelle Küche, die von der Region inspiriert ist. Zu den Gerichten passende Weinkarte."
    ],
    "en": [
      "Certainly one of the oldest hotels in the valley, cosy and mountain rooms, lounge and cosy bar. In the Savoyard restaurant, traditional cuisine inspired by the local area. Wine list matching the dishes."
    ],
    "it": [
      "Sicuramente uno degli hotel più antichi della valle, con camere accoglienti in stile montano e un'accogliente lounge e bar. Nel ristorante savoiardo, cucina tradizionale ispirata ai prodotti locali. Carta dei vini in abbinamento ai piatti."
    ],
    "fr": [
      "Certainement un des plus anciens hôtels de la vallée, chambres douillettes et montagnardes, salon et bar chaleureux. Au restaurant cadre Savoyard, cuisine traditionnelle inspirée du terroir. Carte des vins en adéquation avec les plats."
    ],
    "nl": [
      "Zeker een van de oudste hotels in de vallei, gezellige en bergachtige kamers, warme lounge en bar. In het restaurant, Savoyaards decor, traditionele keuken geïnspireerd door het land. De wijnkaart past bij de gerechten."
    ],
    "es": [
      "Sin duda uno de los hoteles más antiguos del valle, con acogedoras habitaciones de estilo montañés y un cálido salón y bar. En el restaurante saboyano, cocina tradicional inspirada en los productos locales. Carta de vinos a la altura de los platos."
    ]
  },
