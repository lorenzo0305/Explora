  "rdfs:comment": {
    "de": [
      "Erleben Sie mit Ihrer Familie das große Abenteuer von Mary Candies! handgemachte Süßigkeiten mit authentischem Geschmack. Bunte Bonbons, leckere Rezepte und originelle Kreationen für einen süßen und fröhlichen Moment!"
    ],
    "en": [
      "Come and experience the Great Adventure of Mary Candies with your family! handmade sweets with authentic flavors. Colorful candies, gourmet recipes and original creations for a sweet and happy time!"
    ],
    "it": [
      "Venite a vivere con tutta la famiglia la Grande Avventura di Mary Candies, dolci fatti a mano dai sapori autentici. Dolci colorati, ricette deliziose e creazioni originali per un momento di dolcezza e allegria!"
    ],
    "fr": [
      "Venez vivre en famille la Grande Aventure de Mary Candies ! des douceurs artisanales aux saveurs authentiques. Bonbons colorés, recettes gourmandes et créations originales pour un moment sucré et joyeux !"
    ],
    "es": [
      "Ven a vivir la Gran Aventura de Mary Candies con toda la familia! Dulces artesanales con sabores auténticos. ¡Caramelos de colores, recetas deliciosas y creaciones originales para pasar un rato dulce y feliz!"
    ],
    "nl": [
      "Kom met het hele gezin genieten van het Grote Avontuur van Mary Candies! Handgemaakte snoepjes met authentieke smaken. Kleurrijke snoepjes, heerlijke recepten en originele creaties voor een zoete en vrolijke tijd!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Spectacle Mary Candies : La Grande Aventure"
    ]
  },
