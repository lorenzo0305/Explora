  "rdfs:comment": {
    "de": [
      "Sind Sie auf der Suche nach einer netten, geselligen und gemütlichen Ecke, in der Sie in Puy de Dôme essen können? Hier in Courpière, in unserer Pizzeria, freuen wir uns darauf, Sie mit unseren hausgemachten Pizzen oder unseren Salaten aus der Region zu verwöhnen."
    ],
    "en": [
      "Are you looking for a nice, friendly and warm place to eat in the Puy de Dôme? It is here in Courpière, in our pizzeria, that we will be pleased to let you taste our home-made pizzas or our local salads."
    ],
    "it": [
      "Siete alla ricerca di un luogo piacevole, accogliente e caldo dove mangiare nel Puy de Dôme? È qui a Courpière, nella nostra pizzeria, che saremo lieti di farvi assaggiare le nostre pizze fatte in casa o le nostre insalate locali."
    ],
    "fr": [
      "Vous recherchez un coin sympa, convivial et chaleureux où manger dans le Puy de Dôme ? C'est ici à Courpière, dans notre pizzeria, que nous vous ferons un plaisir de vous faire goûter nos pizzas faites maison ou nos salades du pays."
    ],
    "es": [
      "¿Busca un lugar agradable, acogedor y cálido para comer en el Puy de Dôme? Es aquí en Courpière, en nuestra pizzería, donde estaremos encantados de hacerle probar nuestras pizzas caseras o nuestras ensaladas locales."
    ],
    "nl": [
      "Bent u op zoek naar een leuke, gezellige, warme plek om te eten in de Puy de Dôme? Het is hier in Courpière, in onze pizzeria, dat wij u graag onze huisgemaakte pizza's of onze lokale salades laten proeven."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Pause Pizza"
    ]
  },
