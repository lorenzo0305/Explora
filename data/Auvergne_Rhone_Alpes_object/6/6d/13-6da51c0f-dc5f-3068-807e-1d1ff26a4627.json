  "rdfs:comment": {
    "de": [
      "Am Fuß der Monts de la Madeleine liegt das Dorf Ambierle inmitten seiner Weinberge der Côte Roannaise.\r\nDie Geschichte von Ambierle ist gleichzeitig die Geschichte seiner Abtei und seiner im X. Jahrhundert gegründeten Priorei."
    ],
    "en": [
      "Located at the foot of the Monts de la Madeleine mountains, the village of Ambierle is surrounded by the vineyards of the Côte Roannaise. The history of Ambierle is tied up with that of its Abbey and of its Priory founded in the 10th century."
    ],
    "it": [
      "Affacciata sulla pianura di Roanne, Ambierle deve la sua fama a un'abbazia benedettina fondata nel Medioevo. Un villaggio di carattere situato su un promontorio (400 m). Priorato del XIV secolo, chiesa del XV secolo, pala d'altare della Passione di Cristo, tetto in tegole smaltate."
    ],
    "fr": [
      "Dominant la plaine roannaise, Ambierle doit sa renommée à une abbaye bénédictine fondée au Moyen-Age. Village de Caractère établi sur un promontoire (400 m). Prieuré du XIVe, église du XVe, retable de la Passion du Christ, toiture aux tuiles vernissées."
    ],
    "es": [
      "Con vistas a la llanura de Roanne, Ambierle debe su fama a una abadía benedictina fundada en la Edad Media. Un pueblo con carácter establecido en un promontorio (400 m). Priorato del siglo XIV, iglesia del siglo XV, retablo de la Pasión de Cristo, techo de tejas vidriadas."
    ],
    "nl": [
      "Ambierle kijkt uit over de vlakte van Roanne en dankt zijn faam aan een benedictijnenabdij die in de middeleeuwen werd gesticht. Een karaktervol dorp gebouwd op een voorgebergte (400 m). Priorij uit de 14e eeuw, kerk uit de 15e eeuw, altaarstuk met de Passie van Christus, dak met geglazuurde dakpannen."
    ]
  },
  "rdfs:label": {
    "de": [
      "Besuch des Dorfes Ambierle"
    ],
    "en": [
      "Medieval village"
    ],
    "fr": [
      "Village de Caractère - Ambierle"
    ],
    "nl": [
      "Bezoek aan het Dorp Ambierle"
    ]
  },
