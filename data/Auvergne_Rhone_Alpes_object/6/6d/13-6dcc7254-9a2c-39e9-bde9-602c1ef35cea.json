  "rdfs:comment": {
    "de": [
      "In Villeperdrix können Sie den kleinen Laden mit Bio-Produkten der Ferme de Perdicus entdecken. Öl und Oliven aus \"Nyons\", Pestos, Kräutertees, Kosmetika, ätherische Öle und Blütenwasser, Sirupe, Marmeladen und Fruchtsäfte."
    ],
    "en": [
      "In Villeperdrix, come and discover the small shop selling organic products at the Ferme de Perdicus."
    ],
    "it": [
      "A Villeperdrix, venite a scoprire il piccolo negozio di prodotti biologici della Ferme de Perdicus.\r\nOlio e olive di \"Nyons\", miele, pesti, tisane, cosmetici naturali, oli essenziali e acque floreali, tinture madri, sciroppi e marmellate."
    ],
    "fr": [
      "A Villeperdrix, venez découvrir la petite boutique de produits Bio de la Ferme de Perdicus. \r\nHuile et olives de \"Nyons\", miel, pestos, infusions, cosmétiques naturels, huiles essentielles et eaux florales, teintures mères, sirops, confitures."
    ],
    "nl": [
      "Kom in Villeperdrix het winkeltje met biologische producten van de Ferme de Perdicus ontdekken. Nyons\" olie en olijven, pesto's, kruidenthee, cosmetica, essentiële oliën en bloemenwaters, siropen, jam en vruchtensap."
    ],
    "es": [
      "En Villeperdrix, venga a descubrir la pequeña tienda de productos ecológicos de la Ferme de Perdicus.\r\nAceite y aceitunas \"Nyons\", miel, pestos, tisanas, cosmética natural, aceites esenciales y aguas florales, tinturas madre, jarabes y mermeladas."
    ]
  },
  "rdfs:label": {
    "en": [
      "Farm Perdicus"
    ],
    "fr": [
      "Ferme de Perdicus"
    ]
  },
