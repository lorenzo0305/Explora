  "rdfs:comment": {
    "de": [
      "La Grange ist wie ein echtes Berghaus. Die Inneneinrichtung ist von den Scheunen vergangener Zeiten inspiriert: Holz, Stein, sanftes Licht, eine alpine Atmosphäre, in der man sich sofort wohlfühlt."
    ],
    "en": [
      "La Grange is a true mountain retreat. The interior design is inspired by traditional barns: wood, stone, soft lighting, and an alpine atmosphere where you immediately feel at home."
    ],
    "it": [
      "La Grange si impone come una vera e propria casa di montagna. L'arredamento interno si ispira ai fienili di un tempo: legno, pietra, luce soffusa, un'atmosfera alpina in cui ci si sente immediatamente a proprio agio."
    ],
    "fr": [
      "La Grange s’impose comme une véritable maison de montagne. La décoration intérieure est inspirée des granges d’autrefois : bois, pierre, lumière douce, une ambiance alpine où l’on se sent immédiatement bien."
    ],
    "es": [
      "La Grange se impone como una auténtica casa de montaña. La decoración interior se inspira en los graneros de antaño: madera, piedra, luz suave, un ambiente alpino en el que uno se siente inmediatamente a gusto."
    ],
    "nl": [
      "La Grange is een echt berghuis. Het interieur is geïnspireerd op de schuren van weleer: hout, steen, zacht licht, een alpine sfeer waar je je meteen thuis voelt."
    ]
  },
