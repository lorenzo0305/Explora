  "rdfs:comment": {
    "de": [
      "Katharina, André und Laura empfangen Sie in einer gemütlichen Umgebung und bieten Ihnen Menüs mit Fleisch oder vegetarische Gerichte aus den Produkten ihres zertifizierten Bio-Bauernhofs an."
    ],
    "en": [
      "Katharina, André, Lola and Laura offer a warm welcome and a choice of meat or vegetarian menus based on produce from their certified organic farm."
    ],
    "it": [
      "Katharina, Laura, André e Lola offrono un'accoglienza calorosa e una scelta di menu a base di carne o vegetariani con prodotti provenienti dalla loro fattoria biologica certificata."
    ],
    "fr": [
      "Katharina, Laura, André et  Lola vous accueillent dans un cadre chaleureux et vous proposent des menus avec viande ou végétariens élaborés à partir des produits de leur ferme certifiée en Agriculture biologique."
    ],
    "es": [
      "Katharina, Laura, André y Lola ofrecen una cálida bienvenida y una selección de menús de carne o vegetarianos basados en productos de su granja ecológica certificada."
    ],
    "nl": [
      "Katharina, Laura, André en Lola bieden een warm welkom en een keuze uit vlees- of vegetarische menu's op basis van producten van hun gecertificeerde biologische boerderij."
    ]
  },
  "rdfs:label": {
    "de": [
