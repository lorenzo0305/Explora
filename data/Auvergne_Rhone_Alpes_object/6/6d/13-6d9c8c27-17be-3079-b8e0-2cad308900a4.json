  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Talent und die Kreativität der Tänzer des Konservatoriums beim Abend der jungen Choreographen, einer einzigartigen Show, bei der jede Choreographie ein Originalwerk ist! Zelebrieren Sie die Leidenschaft für den Tanz und fördern Sie junge Künstler!"
    ],
    "en": [
      "Discover the talent and creativity of Conservatoire dancers at the Soirée des Jeunes Chorégraphes, a unique show where each choreography is an original work of art! Celebrate your passion for dance and support our young artists!"
    ],
    "it": [
      "Scoprite il talento e la creatività dei ballerini del Conservatorio nella serata dei giovani coreografi, uno spettacolo unico in cui ogni coreografia è un'opera originale! Festeggiate la vostra passione per la danza e sostenete i nostri giovani artisti!"
    ],
    "fr": [
      "Découvrez le talent et la créativité des danseurs du Conservatoire lors de la soirée des Jeunes Chorégraphes, qui est un spectacle unique où chaque chorégraphie est une œuvre originale ! Célébrez la passion de la danse et encouragez les jeunes artistes !"
    ],
    "nl": [
      "Ontdek het talent en de creativiteit van de dansers van het Conservatorium tijdens de avond van de Jonge Choreografen, een unieke show waarin elke choreografie een origineel werk is! Vier je passie voor dans en steun onze jonge artiesten!"
    ],
    "es": [
      "Descubra el talento y la creatividad de los bailarines del Conservatorio en la velada de Jóvenes Coreógrafos, un espectáculo único en el que cada coreografía es una obra original ¡Celebre su pasión por la danza y apoye a nuestros jóvenes artistas!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Soirée des jeunes chorégraphes"
    ]
  },
