  "rdfs:comment": {
    "de": [
      "Ein kleines Dutzend Amateursänger wird Sie mit einem Konzert bulgarischer Lieder erfreuen. Während einer Reise im Jahr 2023 in ein verlorenes Dorf der bulgarischen Rhodopoden haben sie diese Gesänge gesammelt, direkt aus dem Mund der Großmütter dieses Dorfes."
    ],
    "en": [
      "A dozen amateur singers will delight you with a concert of Bulgarian songs. During a trip in 2023 to a remote village in the Bulgarian Rhodopods, they collected these songs directly from the mouths of the village's grandmothers."
    ],
    "it": [
      "Un piccolo gruppo di cantanti dilettanti vi delizierà con un concerto di canzoni bulgare. Durante un viaggio nel 2023 in un remoto villaggio dei Rodopodi bulgari, hanno raccolto queste canzoni direttamente dalla bocca delle nonne del villaggio."
    ],
    "fr": [
      "Une petite dizaine de chanteurs amateurs vont vous régaler avec un concert de chants bulgares. Lors d'un voyage en 2023 dans un village perdu des Rhodopodes bulgares, ils ont collecté ces chants, directement de la bouche des grands-mères de ce village."
    ],
    "es": [
      "Un pequeño grupo de cantantes aficionados le deleitará con un concierto de canciones búlgaras. Durante un viaje en 2023 a un remoto pueblo de los Rodopodios búlgaros, recogieron estas canciones directamente de boca de las abuelas del pueblo."
    ],
    "nl": [
      "Een kleine groep amateurzangers zal je verblijden met een concert van Bulgaarse liedjes. Tijdens een reis in 2023 naar een afgelegen dorp in de Bulgaarse Rhodopoden verzamelden ze deze liedjes rechtstreeks uit de mond van de grootmoeders van het dorp."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Chœur du Chant du Dragon à la Coccinelle"
    ]
  },
