  "rdfs:comment": {
    "de": [
      "Im Flughafen Grenoble Isère gelegen, empfängt Sie das Restaurant Séquoia für Ihre Mittagspause. Vom Speisesaal aus können Sie den Blick auf die Startbahn genießen."
    ],
    "en": [
      "Located within the Grenoble Isere airport terminal, the restaurant welcomes you all day along. You can enjoy your lunch while overlooking the activity on the runway!"
    ],
    "it": [
      "Situato nell'aeroporto di Grenoble Isère, il ristorante Séquoia vi accoglie per la vostra pausa pranzo e dalla sala ristorante potrete ammirare la vista sulla pista di decollo."
    ],
    "fr": [
      "Situé dans l'aéroport de Grenoble Isère, le restaurant Séquoia vous accueille  pour votre pause déjeuner et depuis la salle de restaurant, vous pourrez profiter de la vue sur la piste ."
    ],
    "es": [
      "Situado en el aeropuerto de Grenoble Isère, el restaurante Séquoia le da la bienvenida para su pausa de almuerzo y, desde la sala del restaurante, puede disfrutar de la vista sobre la pista de aterrizaje."
    ],
    "nl": [
      "Het restaurant Séquoia, gelegen op de luchthaven Grenoble Isère, verwelkomt u voor uw lunchpauze en vanuit de restaurantzaal kunt u genieten van het uitzicht op de landingsbaan."
    ]
  },
