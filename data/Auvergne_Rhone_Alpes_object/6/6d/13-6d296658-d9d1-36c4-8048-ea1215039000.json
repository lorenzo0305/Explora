  "rdfs:comment": {
    "de": [
      "Betreuung von Entdeckungs- und Sportwanderungen: zu Fuß und mit Schneeschuhen.\r\nUmwelterziehung, sensibler und spielerischer Ansatz.\r\nWanderungen und Entdeckung von Eseln."
    ],
    "en": [
      "Supervision of discovery and sports hikes: on foot and with snowshoes.\r\nEnvironmental education, sensitive and fun.\r\nStroll and discovery of donkeys."
    ],
    "it": [
      "Supervisione di escursioni di scoperta e sportive: a piedi e con le racchette da neve.\r\nEducazione ambientale, un approccio sensibile e divertente.\r\nPasseggiate e scoperta degli asini."
    ],
    "fr": [
      "Encadrement de randonnées découvertes et sportives : à pied, et en raquettes à neige.\r\nÉducation à l'environnement, approche sensible et ludique.\r\nBalade et découverte des ânes."
    ],
    "es": [
      "Supervisión de excursiones de descubrimiento y deportivas: a pie y con raquetas de nieve.\r\nEducación medioambiental, un enfoque sensible y lúdico.\r\nPaseos y descubrimiento de burros."
    ],
    "nl": [
      "Begeleiding van ontdekkings- en sportwandelingen: te voet en met sneeuwschoenen.\r\nMilieu-educatie, een gevoelige en ludieke aanpak.\r\nWandelingen en ontdekking van ezels."
    ]
  },
