  "rdfs:comment": {
    "de": [
      "Feiern wir den St. Patrick's Day! Live-Musik mit La Session Irlandaise und Kitchen Session, kleine Snacks und eine gemütliche Atmosphäre. Ob mit der Familie oder mit Freunden, holen Sie Ihre grüne Kleidung heraus und feiern Sie Irland in der Auvergne."
    ],
    "en": [
      "Let's celebrate St. Patrick's Day! Live music with La Session Irlandaise and Kitchen Session, snacks and a friendly atmosphere. With family or friends, get out your green clothes and come celebrate Ireland in Auvergne."
    ],
    "it": [
      "Festeggiamo il giorno di San Patrizio! Musica dal vivo con La Session Irlandaise e Kitchen Session, spuntini e un'atmosfera amichevole. Con la famiglia o gli amici, tirate fuori i vostri vestiti verdi e venite a festeggiare l'Irlanda in Alvernia."
    ],
    "fr": [
      "Fêtons la Saint-Patrick ! Musique live avec La Session Irlandaise et Kitchen Session, petite restauration et ambiance conviviale. En famille ou entre amis, sortez vos habits verts et venez célébrer l’Irlande en Auvergne."
    ],
    "es": [
      "¡Celebremos el día de San Patricio! Música en directo con La Session Irlandaise y Kitchen Session, aperitivos y un ambiente agradable. En familia o con amigos, saque su ropa verde y venga a celebrar Irlanda en Auvernia."
    ],
    "nl": [
      "Laten we St Patrick's Day vieren! Live muziek met La Session Irlandaise en Kitchen Session, hapjes en een gezellige sfeer. Met familie of vrienden, trek je groene kleren aan en kom Ierland vieren in de Auvergne."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Pub Irlandais - Saint Patrick"
    ]
  },
