  "rdfs:comment": {
    "de": [
      "Gedenkpark, der nach einer in der Region aktiven jüdischen Widerstandskämpferin benannt wurde. 6190m² Lebensraum im Grünen, um Ihre sonnigen Nachmittage zu verschönern."
    ],
    "en": [
      "Memorial park named in honor of a Jewish resistance fighter active in the region. Living space of 6190m² of greenery to enhance your sunny afternoons."
    ],
    "it": [
      "Parco commemorativo in onore di un combattente della resistenza ebraica attivo nella regione. Uno spazio abitativo di 6190 m² di verde per arricchire i vostri pomeriggi di sole."
    ],
    "fr": [
      "Parc mémoriel nommé en l’honneur d’une résistante juive active dans la région. Espace de vie de 6190m² de verdure pour agrémenté vos après-midi ensoleillé."
    ],
    "es": [
      "Parque conmemorativo que lleva el nombre de un resistente judío activo en la región. Un espacio vital de 6190 m² de vegetación para realzar sus tardes soleadas."
    ],
    "nl": [
      "Herdenkingspark genoemd ter ere van een Joodse verzetsstrijder die actief was in de regio. Leefruimte van 6190m² met veel groen om je zonnige middagen op te fleuren."
    ]
  },
