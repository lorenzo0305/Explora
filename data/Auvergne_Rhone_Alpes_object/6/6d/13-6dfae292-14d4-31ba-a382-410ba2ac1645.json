  "rdfs:comment": {
    "de": [
      "Romans besitzt ein unbestreitbares Flair, das Erbe einer reichen Vergangenheit, mit engen Gassen, in denen verschiedene architektonische Stile nebeneinander existieren."
    ],
    "en": [
      "Romans is endowed with an undeniable cachet, heritage of a rich past, with its narrow streets where various architectural styles are mixed."
    ],
    "it": [
      "Romans ha un innegabile fascino, eredità di un ricco passato, con le sue strade strette dove si trovano diversi stili architettonici."
    ],
    "fr": [
      "Romans est dotée d'un indéniable cachet, héritage d'un riche passé, avec ses ruelles étroites où se cotoient divers styles architecturaux."
    ],
    "es": [
      "Romans tiene un caché innegable, la herencia de un rico pasado, con sus calles estrechas donde se encuentran varios estilos arquitectónicos."
    ],
    "nl": [
      "Romans is een schilderachtig plaatsje met smalle straatjes, waar een mengsel van bouwstijlen getuigt van een rijk verleden. Het leven gaat hier zijn rustige gangetje en u kunt hier uitstekend eten. De specialiteiten van de streek zijn de pogne en ravioli."
    ]
  },
