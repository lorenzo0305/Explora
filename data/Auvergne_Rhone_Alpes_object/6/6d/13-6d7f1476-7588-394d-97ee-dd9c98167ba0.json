  "rdfs:comment": {
    "de": [
      "Dieser Rundweg ist eine Möglichkeit, die Dorfstation Bottières in einer bukolischen Umgebung durch einen naturnahen Rollweg zu entdecken."
    ],
    "en": [
      "This loop is a way of discovering the village resort of Les Bottières in a bucolic environment via a rolling route that is as close to nature as possible."
    ],
    "it": [
      "Questo anello è un modo per scoprire la località di Les Bottières in un ambiente bucolico su un percorso che vi porterà il più vicino possibile alla natura."
    ],
    "fr": [
      "Cette boucle est une manière de découvrir la station village des Bottières dans un environnement bucolique par un parcours roulant au plus près de la nature."
    ],
    "es": [
      "Este bucle es una forma de descubrir la estación de Les Bottières en un entorno bucólico, en un recorrido que le llevará lo más cerca posible de la naturaleza."
    ],
    "nl": [
      "Deze lus is een manier om het dorpscentrum van Les Bottières te ontdekken in een bucolische omgeving op een route die je zo dicht mogelijk bij de natuur brengt."
    ]
  },
  "rdfs:label": {
