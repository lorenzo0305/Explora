  "rdfs:comment": {
    "de": [
      "Die Villa Marlioz empfängt Sie in ihrem Restaurant mit großen Glasfenstern, die sich zum Garten mit Bäumen hin öffnen, und einem herrlichen Blick auf den Gipfel des Dent du Chat als Bonus!"
    ],
    "en": [
      "Villa Marlioz welcomes you to its restaurant, with large bay windows opening onto the wooded garden and a superb view of the Dent du Chat summit !"
    ],
    "it": [
      "Villa Marlioz vi accoglie nel suo ristorante, con grandi vetrate che si aprono sul giardino alberato e una superba vista sulla cima della Dent du Chat !"
    ],
    "fr": [
      "La Villa Marlioz vous accueille dans son restaurant  aux grandes baies vitrées s'ouvrant sur le jardin arboré, une superbe vue sur le sommet de la  Dent du Chat en prime !"
    ],
    "es": [
      "Villa Marlioz le da la bienvenida a su restaurante, con grandes ventanales que dan al jardín arbolado y una magnífica vista de la cima de la Dent du Chat"
    ],
    "nl": [
      "Villa Marlioz heet u welkom in zijn restaurant, met grote erkers die uitkomen op de beboste tuin en een prachtig uitzicht op de top van de Dent du Chat!"
    ]
  },
