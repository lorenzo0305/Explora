  "rdfs:comment": {
    "de": [
      "Saal mit ausgestatteter Küche, 32 Tischen für 6 Personen, 208 Stühlen, Bühne, Bar.\r\nVermietet mit Geschirr + Kaffeemaschine und Bodenwäsche inklusive. Profi-Kochfeld und Profi-Geschirrspüler."
    ],
    "en": [
      "Room with fully-equipped kitchen, 32 tables seating 6, 208 chairs, stage, bar.\r\nRented with crockery + percolator and floor washing included. Professional cooking hob and dishwasher."
    ],
    "it": [
      "Sala con cucina completamente attrezzata, 32 tavoli da 6 posti, 208 sedie, palco, bar.\r\nAffittata con stoviglie + percolatore e lavaggio dei pavimenti inclusi. Piano cottura professionale e lavastoviglie."
    ],
    "fr": [
      "Salle avec cuisine équipée,  32 tables de 6 personnes, 208 chaises, scène, bar.\r\nLouée avec vaisselle + percolateur et lavage sol compris. Piano de cuisson professionnel ainsi que lave vaisselle Pro."
    ],
    "nl": [
      "Zaal met volledig uitgeruste keuken, 32 tafels voor 6 personen, 208 stoelen, podium, bar.\r\nGehuurd met serviesgoed + percolator en vloerwas inbegrepen. Professionele kookplaat en vaatwasser."
    ],
    "es": [
      "Sala con cocina totalmente equipada, 32 mesas para 6 personas, 208 sillas, escenario, bar.\r\nSe alquila con vajilla + percolador y lavado de suelos incluidos. Cocina profesional y lavavajillas."
    ]
  },
