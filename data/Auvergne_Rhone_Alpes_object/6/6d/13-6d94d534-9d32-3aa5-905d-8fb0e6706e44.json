  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Cité des États-Unis, einen Ort, an dem Tony Garniers urbane Utopie zwischen Grün, Modernität und lebendiger Geschichte zum Leben erweckt wird."
    ],
    "en": [
      "Discover the Cité des États-Unis, a place where Tony Garnier?s urban utopia comes to life between greenery, modernity and living history."
    ],
    "it": [
      "Scoprite la Cité des États-Unis, un luogo dove l'utopia urbana di Tony Garnier prende vita tra verde, modernità e storia vivente."
    ],
    "fr": [
      "Découvrez la Cité des États-Unis, un lieu où l’utopie urbaine de Tony Garnier prend vie entre verdure, modernité et histoire vivante."
    ],
    "nl": [
      "Ontdek de Cité des États-Unis, een plek waar de stedelijke utopie van Tony Garnier tot leven komt tussen groen, moderniteit en levende geschiedenis."
