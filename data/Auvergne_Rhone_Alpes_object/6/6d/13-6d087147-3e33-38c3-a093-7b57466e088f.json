  "rdfs:comment": {
    "de": [
      "L'Abri liegt fünfundzwanzig Kilometer von Lyon entfernt im Herzen der goldenen Steine und ist das Ergebnis eines Selbstbaus, der von unseren Reisen inspiriert wurde. Ein kleines Haus in Holzrahmenbauweise: ein privater und intimer Raum, der für Ihr Wohlbefinden gedacht ist."
    ],
    "en": [
      "Located twenty-five kilometres from Lyon in the heart of the golden stones area of Beaujolais, the Abri is the result of a self-construction inspired by our travels. A small wooden frame house: a private and intimate space designed for your well-being."
    ],
    "it": [
      "Situato a venticinque chilometri da Lione, nel cuore delle pietre d'oro, l'Abri è il risultato di un'autocostruzione ispirata ai nostri viaggi. Una piccola casa con struttura in legno: uno spazio privato e intimo pensato per il vostro benessere."
    ],
    "fr": [
      "Situé à vingt-cinq kilomètres de Lyon au coeur des pierres dorées, l'Abri est le fruit d'une auto-construction inspirée de nos voyages. Petite maison en ossature bois : un espace privatif et intimiste pensé pour votre bien être."
    ],
    "es": [
      "Situado a veinticinco kilómetros de Lyon, en el corazón de las piedras doradas, el Abri es el resultado de una autoconstrucción inspirada en nuestros viajes. Una casita de entramado de madera: un espacio privado e íntimo pensado para su bienestar."
    ],
    "nl": [
      "Gelegen op vijfentwintig kilometer van Lyon in het hart van de gouden stenen, is de Abri het resultaat van een zelfbouw geïnspireerd door onze reizen. Een klein houten frame huis: een privé en intieme ruimte ontworpen voor uw welzijn."
    ]
  },
  "rdfs:label": {
    "en": [
      "Spa de l'abri"
    ],
    "fr": [
      "Spa de l'abri"
    ]
  },
