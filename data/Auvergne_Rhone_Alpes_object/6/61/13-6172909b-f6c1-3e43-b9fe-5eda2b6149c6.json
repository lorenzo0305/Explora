  "rdfs:comment": {
    "de": [
      "Der Juwelier und Schmuckhändler in Megève. Kreationen nach Maß. Reparaturen Ihres Schmucks und Ihrer Uhren, Gravuren, Batterien, Piercings. Hersteller des Kreuzes von Megève und Savoyen. Schmuck aus Schneekristall, Edelweiss. Schmuck zur Geburt. Tissot, Lip, Swatch, Zag,"
    ],
    "en": [
      "The jeweller in Megève. Custom-made creations. Jewelry and watch repairs, engravings, batteries, piercings. Creator and manufacturer of the Megève and Savoie Crosses. Snow crystal jewellery, Edelweiss. Birth jewelry. Tissot, Lip, Swatch, Zag,"
    ],
    "it": [
      "Il gioielliere di Megève. Creazioni su misura. Riparazioni di gioielli e orologi, incisioni, pile, piercing. Produttore della Croce di Megève e della Savoia. Gioielli in cristallo di neve, Edelweiss. Gioielli per la nascita. Tissot, Lip, Swatch, Zag,"
    ],
    "fr": [
      "Le bijoutier-joaillier de Megève. Créations sur mesure. Réparations de vos bijoux et montres, gravures, piles, piercings. Fabricant de la Croix de Megève et de Savoie. Bijoux cristal de neige, Edelweiss. Bijoux de naissance. Tissot, Lip, Swatch, Zag,"
    ],
    "es": [
      "El joyero de Megève. Creaciones a medida. Reparación de sus joyas y relojes, grabados, pilas, piercings. Fabricante de la Cruz de Megève y Saboya. Joyas de cristal de nieve, Edelweiss. Joyas de nacimiento. Tissot, Lip, Swatch, Zag,"
    ],
    "nl": [
      "De juwelier in Megève. Creaties op maat. Reparaties van uw sieraden en horloges, gravures, batterijen, piercings. Fabrikant van het kruis van Megève en Savoie. Juwelen van sneeuwkristal, Edelweiss. Geboortejuwelen. Tissot, Lip, Swatch, Zag,"
    ]
  },
