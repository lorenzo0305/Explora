  "rdfs:comment": {
    "de": [
      "Die 1897 erbaute Brasserie des Artistes beherbergte zu dieser Zeit das Café du XXe siècle. Seit der Eröffnung der Oper im Jahr 1901 bewirtete das gegenüberliegende Café bereits viele Gäste und Künstler, wenn sie aus den Vorstellungen kamen."
    ],
    "en": [
      "The Brasserie des Artistes, built in 1897, was then home to the Café du XXe siècle. As soon as the opera house opened in 1901, this café, located opposite, was already welcoming numerous customers and artists as they left the theater."
    ],
    "it": [
      "La Brasserie des Artistes, costruita nel 1897, ospitava allora il Café du XXe siècle. Non appena il teatro dell'opera fu inaugurato nel 1901, questo caffè, situato di fronte, accoglieva già molti clienti e artisti all'uscita dal teatro."
    ],
    "fr": [
      "La Brasserie des Artistes construite en 1897, abrite à cette époque le café du XXe siècle. Dès l’ouverture de l’opéra en 1901, ce café, situé en face, accueille déjà de nombreux clients et artistes à la sortie des spectacles."
    ],
    "es": [
      "La Brasserie des Artistes, construida en 1897, albergaba entonces el Café du XXe siècle. Nada más abrirse la ópera en 1901, este café, situado enfrente, ya recibía a numerosos clientes y artistas a la salida del teatro."
    ],
    "nl": [
      "De Brasserie des Artistes, gebouwd in 1897, was toen de thuisbasis van het Café du XXe siècle. Zodra het operagebouw in 1901 werd geopend, ontving dit tegenoverliggende café al veel klanten en artiesten bij het verlaten van het theater."
    ]
  },
  "rdfs:label": {
    "fr": [
