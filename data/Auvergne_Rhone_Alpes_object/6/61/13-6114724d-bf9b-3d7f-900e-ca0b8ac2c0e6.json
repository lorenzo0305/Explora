  "rdfs:comment": {
    "de": [
      "La Croisée des terroirs lädt Sie in einen gemütlichen und modernen Raum ein, um eine traditionelle Küche voller Aromen zu entdecken! Im Zentrum des Dorfes Poncin."
    ],
    "en": [
      "Situated in the heart of Poncin, an old medieval village, discover a traditional cooking.\r\nPizza area to eat in or take out. Only in the evening."
    ],
    "it": [
      "La Croisée des terroirs vi invita a scoprire una cucina tradizionale ricca di sapori in uno spazio caldo e moderno! Nel centro del villaggio di Poncin."
    ],
    "fr": [
      "La Croisée des terroirs vous invite dans un espace chaleureux et moderne, à découvrir une cuisine traditionnelle et pleine de saveurs ! Au centre du village de Poncin."
    ],
    "nl": [
      "La Croisée des terroirs nodigt u uit om een traditionele keuken vol smaken te ontdekken in een warme en moderne ruimte! In het centrum van het dorp Poncin."
    ],
    "es": [
      "La Croisée des terroirs le invita a descubrir una cocina tradicional llena de sabores en un espacio cálido y moderno En el centro del pueblo de Poncin."
    ]
  },
