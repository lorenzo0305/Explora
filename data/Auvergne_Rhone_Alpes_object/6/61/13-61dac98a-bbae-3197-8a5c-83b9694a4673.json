  "rdfs:comment": {
    "de": [
      "Gehen Sie mit Jooks auf Entdeckungsreise durch Romans! Eine mobile Anwendung, mit der Sie beim Gehen oder Laufen die 11 riesigen Schuhe in der Innenstadt entdecken können.\r\nSetzen Sie Ihre Kopfhörer auf und lassen Sie sich führen!"
    ],
    "en": [
      "Discover Romans with Jooks! A mobile app that lets you walk or run around the 11 giant shoes in the city center.\nPut on your headphones and let us guide you!"
    ],
    "it": [
      "Scoprite Roma con Jooks! Un'applicazione mobile che vi permette di camminare o correre intorno alle 11 scarpe giganti del centro storico.\r\nMettete le cuffie e lasciatevi guidare!"
    ],
    "fr": [
      "Partez à la découverte de Romans avec Jooks ! Une application mobile pour découvrir en marchant ou en courant les 11 chaussures géantes dans le centre ville.\r\nMettez vos écouteurs et laissez vous guider !"
    ],
    "es": [
      "¡Descubre Roma con Jooks! Una aplicación móvil que le permite caminar o correr alrededor de los 11 zapatos gigantes del centro de la ciudad.\r\n¡Ponte los auriculares y déjate guiar!"
    ],
    "nl": [
      "Ontdek Romeinen met Jooks! Een mobiele applicatie waarmee je rond de 11 reuzenschoenen in het stadscentrum kunt wandelen of rennen.\nZet je koptelefoon op en laat je leiden!"
    ]
  },
