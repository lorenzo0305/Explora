  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Vorschläge des Küchenchefs mit einer schmackhaften Küche aus frischen und lokalen Produkten!\r\nMit mehr als 15 Jahren Erfahrung ausgestattet, vereint unser Koch Leidenschaft und Innovation, um Ihnen eine einfallsreiche Küche mit überraschendem Geschmack zu präsentieren."
    ],
    "en": [
      "Come and discover the chef's suggestions for tasty cuisine based on fresh, local produce!\r\nWith over 12 years' experience, our chef combines passion and innovation to bring you inventive cuisine with surprising flavors."
    ],
    "it": [
      "Venite a scoprire i suggerimenti dello chef per una cucina gustosa a base di prodotti freschi e locali!\r\nCon oltre 15 anni di esperienza, il nostro chef unisce passione e innovazione per offrirvi una cucina inventiva dai sapori sorprendenti."
    ],
    "fr": [
      "Venez découvrir les suggestions du chef avec une cuisine savoureuse à base de produits frais et locaux !\r\nDotés de plus de 15 ans d’expériences, notre cuisinier mêle passion et innovation pour vous présenter une cuisine inventive au goût surprenant."
    ],
    "nl": [
      "Kom en ontdek de suggesties van de chef voor smakelijke gerechten op basis van verse, lokale producten!\r\nMet meer dan 12 jaar ervaring combineert onze chef passie en innovatie om je een inventieve keuken met verrassende smaken te brengen."
    ],
    "es": [
      "Descubra las sugerencias del chef para una cocina sabrosa basada en productos frescos y locales\r\nCon más de 15 años de experiencia, nuestro chef combina pasión e innovación para ofrecerle una cocina inventiva con sabores sorprendentes."
    ]
  },
  "rdfs:label": {
