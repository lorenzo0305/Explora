  "rdfs:comment": {
    "de": [
      "Seit 1924 verwöhnt Sie das Haus \"père Craquant\" dank althergebrachter Rezepte mit seinen Craquants oder Kroketten. Entdecken Sie unser gesamtes Sortiment an Keksen in unserem Geschäft in Saillans."
    ],
    "en": [
      "Since 1924 \"Père Craquant\" has indulged its customers with its time-honoured recipes and its \"craquants\"  or \"croquettes\". Discover our full range of biscuits in our shop in Saillans."
    ],
    "it": [
      "Dal 1924, la casa di \"père Craquant\" vi delizia con le sue ricette ancestrali per i suoi cracker o crocchette. Scoprite l'intera gamma di biscotti nel nostro negozio di Saillans."
    ],
    "fr": [
      "Depuis 1924 la maison \"père Craquant\" vous régale grâce à des recettes ancestrales avec ses craquants ou croquettes. Découvrez l'intégralité de notre gamme de biscuits dans notre magasin à Saillans."
    ],
    "nl": [
      "Sinds 1924 is het smullen bij \"père Craquant\", dankzij de oude recepten met biscuits en koek. Ontdek ons volledige assortiment biscuits in onze winkel in Saillans."
    ],
    "es": [
      "Desde 1924, la casa del \"père Craquant\" le deleita con sus recetas ancestrales de sus galletas o croquetas. Descubra toda nuestra gama de galletas en nuestra tienda de Saillans."
    ]
  },
  "rdfs:label": {
    "en": [
      "Biscuiterie le Père Craquant"
    ],
    "fr": [
      "Biscuiterie Le Père Craquant"
    ],
