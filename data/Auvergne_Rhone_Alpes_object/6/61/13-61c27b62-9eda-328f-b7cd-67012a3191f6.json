  "rdfs:comment": {
    "de": [
      "Entdecken Sie 5 km vom Stadtzentrum Montluçons entfernt einen echten landwirtschaftlichen Betrieb mit 100 ha Naturwiesen.\r\nSpazieren Sie auf seinem zwei Kilometer langen Lehrpfad zwischen den Tieren und entdecken Sie die Produkte des Bauernhofs."
    ],
    "en": [
      "Just 5km from Montluçon town center, discover a real farm with 100ha of natural meadows.\r\nStroll along its two-kilometer educational trail, among the animals, and discover the farm's products."
    ],
    "it": [
      "A 5 km dal centro di Montluçon, scoprite una vera fattoria con 100 ettari di prati naturali.\r\nPasseggiate lungo i suoi due chilometri di percorso didattico, tra gli animali, e scoprite i prodotti della fattoria."
    ],
    "fr": [
      "Découvrez, à 5km du centre-ville de Montluçon, une véritable exploitation agricole de 100ha de prairies naturelles. \r\nPromenez-vous sur son parcours pédagogique de deux kilomètres, au milieu des animaux et découvrez les produits de la ferme."
    ],
    "nl": [
      "Ontdek op 5 km van het centrum van Montluçon een echte boerderij met 100 hectare natuurlijke weiden.\r\nWandel over het educatieve pad van twee kilometer tussen de dieren en ontdek de producten van de boerderij."
    ],
    "es": [
      "A 5 km del centro de Montluçon, descubra una auténtica granja con 100 hectáreas de prados naturales.\r\nPasee por su sendero didáctico de dos kilómetros, entre los animales, y descubra los productos de la granja."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Domaine de la Ganne"
    ]
  },
