  "rdfs:comment": {
    "de": [
      "Diese Tour , die in Vogüé beginnt, zeigt Ihnen den Reichtum der Dörfer auf beiden Seiten des Flusses Ardèche"
    ],
    "en": [
      "This tour, starting from Vogüé, will allow you to discover the richness of the villages located on both sides of the Ardèche river"
    ],
    "it": [
      "Questo tour, con partenza da Vogüé, vi porterà a scoprire la ricchezza dei villaggi su entrambe le sponde del fiume Ardèche"
    ],
    "fr": [
      "Ce circuit , au départ de Vogüé, vous fera découvrir les richesses des villages situés sur les deux côtés de la rivière Ardèche"
    ],
    "nl": [
      "Tijdens deze tocht, die begint in Vogüé, ontdek je de rijkdom van de dorpen aan beide kanten van de rivier de Ardèche"
    ],
    "es": [
      "Esta excursión, con salida de Vogüé, le llevará a descubrir la riqueza de los pueblos de ambas orillas del río Ardèche"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Circuit moto \"Les deux rives de l'Ardèche\""
    ]
  },
