  "rdfs:comment": {
    "de": [
      "Die Familie Amri empfängt Sie herzlich in einem orientalischen Ambiente und in einer modernen und gemütlichen Einrichtung. Sie werden hausgemachte Gerichte mit frischen Produkten genießen: Tagines, Couscous und verschiedene orientalische und algerische Spezialitäten."
    ],
    "en": [
      "The Amri family offers a warm welcome, in an oriental atmosphere and modern, cosy décor. You'll enjoy homemade dishes made with fresh produce: tagines, couscous and various Oriental and Algerian specialties."
    ],
    "it": [
      "La famiglia Amri vi accoglie calorosamente in un'atmosfera orientale e in un arredamento moderno e accogliente. Potrete gustare piatti fatti in casa con prodotti freschi: tagine, couscous e varie specialità orientali e algerine."
    ],
    "fr": [
      "La famille Amri vous accueille chaleureusement, dans une ambiance orientale et dans un décor moderne et cosy. Vous dégusterez des plats fait maison avec des produits frais : tagines, couscous et diverses spécialités orientales et algériennes."
    ],
    "es": [
      "La familia Amri le da una cálida bienvenida en un ambiente oriental y en una decoración moderna y acogedora. Podrá disfrutar de platos caseros con productos frescos: tagines, cuscús y diversas especialidades orientales y argelinas."
    ],
    "nl": [
      "De familie Amri biedt een warm welkom in een gezellige, moderne omgeving met een oosterse sfeer. Je kunt er genieten van huisgemaakte gerechten met verse producten: tajines, couscous en verschillende Oosterse en Algerijnse specialiteiten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Familial"
    ]
  },
