  "rdfs:comment": {
    "de": [
      "Ein Ort des Treffens und des Austauschs mit einer Terrasse mit Blick auf den See von Villerest. Sie sind zu jeder Jahreszeit zu einer Verkostung im Freien eingeladen, 7 Minuten von Roanne entfernt. Restaurant, Bar und Eisdiele, ideal für Feinschmeckerpausen."
    ],
    "en": [
      "A place to meet and share, with a terrace overlooking Lake Villerest. You're invited to an open-air tasting in any season, 7 minutes from Roanne. Restaurant, bar and ice cream parlour, ideal for gourmet breaks."
    ],
    "it": [
      "Un luogo di incontro e condivisione, con una terrazza affacciata sul lago di Villerest. Siete invitati a una degustazione all'aperto tutto l'anno, a 7 minuti da Roanne. Ristorante, bar e gelateria, ideale per pause golose."
    ],
    "fr": [
      "Un lieu de rendez-vous et de partage avec une terrasse vue sur le lac de Villerest. Vous êtes invités à une dégustation en plein air en toute saison à 7 min de Roanne. Restaurant, bar et glacier, idéal pour les pauses gourmandes."
    ],
    "es": [
      "Un lugar para reunirse y compartir, con una terraza con vistas al lago Villerest. Le invitamos a una degustación al aire libre durante todo el año, a 7 minutos de Roanne. Restaurante, bar y heladería, ideal para escapadas gastronómicas."
    ],
    "nl": [
      "Een plek om elkaar te ontmoeten en te delen, met een terras dat uitkijkt over het meer van Villerest. Je wordt het hele jaar door uitgenodigd voor een proeverij in de open lucht, op 7 minuten van Roanne. Restaurant, bar en ijssalon, ideaal voor fijnproevers."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Terrasse du Lac"
    ]
  },
