  "rdfs:comment": {
    "de": [
      "Wir stellen der Öffentlichkeit zahlreiche Bücher (Romane, Comics, Zeitschriften...), CDs, gelesene Bücher... zur Verfügung und bieten einen Internetzugang (Internetstation mit freiem Zugang).\r\nEs besteht die Möglichkeit, verschiedene Medien auszuleihen."
    ],
    "en": [
      "We offer the public access to numerous books (novels, comics, magazines...), CDs, audiobooks, and internet access (free internet station).\r\nVarious media are available for borrowing."
    ],
    "it": [
      "Disponiamo di un'ampia gamma di libri (romanzi, fumetti, riviste, ecc.), CD, libri da leggere, ecc. e accesso a Internet (accesso gratuito).\r\nÈ possibile prendere in prestito diversi supporti."
    ],
    "fr": [
      "Nous mettons à disposition du public de nombreux livres (romans, BD, revues...), des CD, des livres lus... et proposons un accès à internet (poste internet en accès libre).\r\nPossibilité d'emprunter différents supports."
    ],
    "nl": [
      "We hebben een ruim aanbod aan boeken (romans, strips, tijdschriften, enz.), cd's, leesboeken, enz. en internettoegang (gratis).\r\nVerschillende media kunnen geleend worden."
    ],
    "es": [
      "Disponemos de una amplia gama de libros (novelas, cómics, revistas, etc.), CD, libros para leer, etc. y acceso a Internet (acceso gratuito a Internet).\r\nSe pueden tomar prestados diversos soportes."
    ]
  },
