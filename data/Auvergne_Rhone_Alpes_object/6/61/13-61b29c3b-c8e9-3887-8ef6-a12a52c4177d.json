  "rdfs:comment": {
    "de": [
      "Die neue Ausstellung des Museums Anne-de-Beaujeu untersucht die Bilder, die mit der Nacht verbunden sind, dem Moment, der zwischen der Abend- und der Morgendämmerung liegt."
    ],
    "en": [
      "The new exhibition at the Musée Anne-de-Beaujeu explores images associated with the night, a suspended moment between evening twilight and morning twilight, based on its 19th-century fine art collections."
    ],
    "it": [
      "La nuova mostra del Musée Anne-de-Beaujeu esplora le immagini associate alla notte, un momento sospeso tra il crepuscolo della sera e il crepuscolo del mattino, basandosi sulle sue collezioni di belle arti del XIX secolo."
    ],
    "fr": [
      "La nouvelle exposition du musée Anne-de-Beaujeu propose d’explorer les images liées à la nuit, moment suspendu entre le crépuscule du soir et le crépuscule du matin, à partir de ses collections beaux-arts du XIXe siècle."
    ],
    "es": [
      "La nueva exposición del museo Anne-de-Beaujeu explora las imágenes asociadas a la noche, un momento suspendido entre el crepúsculo vespertino y el crepúsculo matutino, a partir de sus colecciones de bellas artes del siglo XIX."
    ],
    "nl": [
      "De nieuwe tentoonstelling in het Musée Anne-de-Beaujeu verkent de beelden die geassocieerd worden met de nacht, een moment tussen avondschemering en ochtendschemering, gebaseerd op de 19e-eeuwse kunstcollecties."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Exposition - Imaginer la nuit"
    ]
  },
