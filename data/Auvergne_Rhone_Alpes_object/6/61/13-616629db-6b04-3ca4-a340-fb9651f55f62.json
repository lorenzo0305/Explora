  "rdfs:comment": {
    "de": [
      "Lassen Sie sich von der herzlichen Atmosphäre des Restaurants De Toutes Façons einfangen und genießen Sie die hausgemachte regionale Küche, die mit lokalen Produkten zubereitet wird!"
    ],
    "en": [
      "Come and soak up the warm ambience of the De Toutes Façons restaurant, and enjoy home-cooked local cuisine, concocted with local produce!"
    ],
    "it": [
      "Venite a immergervi nella calda atmosfera del ristorante De Toutes Façons e a gustare una cucina casalinga e regionale a base di prodotti locali!"
    ],
    "fr": [
      "Venez vous imprégner de l'ambiance chaleureuse du restaurant De Toutes Façons et goûtez à une cuisine du terroir faite maison, concoctée avec des produits locaux !"
    ],
    "es": [
      "Venga a impregnarse del cálido ambiente del restaurante De Toutes Façons y disfrute de una cocina casera y regional elaborada con productos locales"
    ],
    "nl": [
      "Kom genieten van de warme sfeer van restaurant De Toutes Façons en geniet van huisgemaakte, regionale gerechten bereid met lokale producten!"
    ]
  },
