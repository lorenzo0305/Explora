  "rdfs:comment": {
    "de": [
      "Bio Lebensmittelgeschäft: Getreide, Live-Gemüse, Obst, Milchprodukte - Non-Food-Produkte und umweltfreundliche Produkte. Brötchenmontagnachmittag, Mittwoch und Freitag Morgen"
    ],
    "en": [
      "Organic Grocery store: cereals, vegetables direct from the farm, fruits, dairy products - non-food products and green products. Bread delivery Monday afternoon, Wednesday and Friday morning."
    ],
    "it": [
      "Negozio di alimentari biologici: cereali, verdure dirette, frutta, latticini - Prodotti non alimentari ed eco-prodotti. Consegna del pane il lunedì pomeriggio, il mercoledì e il venerdì mattina."
    ],
    "fr": [
      "Epicerie biologique : céréales, légumes en direct, fruits, produits laitiers - Produits non alimentaires et écoproduits. Livraison de pain lundi après-midi, mercredi et vendredi matin."
    ],
    "es": [
      "Tienda de comestibles ecológicos: cereales, verduras directas, frutas, productos lácteos - productos no alimentarios y productos ecológicos. Entrega de pan los lunes por la tarde, los miércoles y los viernes por la mañana."
    ],
    "nl": [
      "Biologische kruidenier: granen, groente in directe verkoop, fruit, zuivelproducten - niet-eetbare producten en eco-producten. Levering brood maandagmiddag, woensdag en vrijdagochtend."
    ]
  },
