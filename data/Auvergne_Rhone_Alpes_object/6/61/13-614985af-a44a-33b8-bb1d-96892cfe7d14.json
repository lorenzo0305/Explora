  "rdfs:comment": {
    "de": [
      "Citéa ist der Name des städtischen Nahverkehrsnetzes in den Ballungsräumen Valence und Romans-sur-Isère. Die meisten Gemeinden sind Mitglieder des Gemeindeverbands Valence Romans Agglo, der sich über die Departements Drôme und Ardèche erstreckt."
    ],
    "en": [
      "Citéa is the name of the urban transport network for the Valence and Romans-sur-Isère conurbations, most of whose communes are members of the Valence Romans Agglo conurbation community, which straddles the Drôme and Ardèche départements."
    ],
    "it": [
      "Citéa è il nome della rete di trasporto urbano degli agglomerati di Valence e Romans-sur-Isère, la maggior parte dei cui comuni fa parte della comunità di agglomerati di Valence Romans Agglo, a cavallo tra i dipartimenti della Drôme e dell'Ardèche."
    ],
    "fr": [
      "Citéa est le nom du réseau de transports urbains des agglomérations de Valence et Romans-sur-Isère dont la plupart des communes sont membres de la communauté d'agglomération Valence Romans Agglo, à cheval sur les départements de la Drôme et de l'Ardèche."
    ],
    "nl": [
      "Citéa is de naam van het stedelijk vervoersnetwerk van de agglomeraties Valence en Romans-sur-Isère, waarvan de meeste gemeenten deel uitmaken van de agglomeratie Valence Romans Agglo, die de departementen Drôme en Ardèche omringt."
    ],
    "es": [
      "Citéa es el nombre de la red de transporte urbano de las aglomeraciones de Valence y Romans-sur-Isère, la mayoría de cuyos municipios forman parte de la comunidad de aglomeraciones de Valence Romans Agglo, a caballo entre los departamentos de Drôme y Ardèche."
    ]
  },
