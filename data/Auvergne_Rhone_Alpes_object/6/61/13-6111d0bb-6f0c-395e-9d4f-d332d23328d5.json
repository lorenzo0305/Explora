  "rdfs:comment": {
    "de": [
      "Ausstellung von Werken (Öl, Keramik, Metall...) eines Künstlers \"außerhalb der Normen\", der auch sein Haus mit vielen wiederverwerteten Materialien (Ziegel, Keramik...) gebaut hat."
    ],
    "en": [
      "Exhibition of works (oils, ceramics, metal...) by an \"out of the ordinary\" artist who has also built his house with a number of recycled materials (bricks, ceramics...)."
    ],
    "it": [
      "Mostra di opere (oli, ceramica, metallo...) di un artista \"fuori dal comune\" che ha anche costruito la sua casa con una serie di materiali riciclati (mattoni, ceramica...)"
    ],
    "fr": [
      "Exposition des oeuvres (huiles, céramiques, métal...) un artiste \"hors les normes\" qui a également construit sa maison avec nombre de matériaux de récupération (briques, céramique...)"
    ],
    "nl": [
      "Tentoonstelling van werken (olieverf, keramiek, metaal...) van een \"ongewone\" kunstenaar die ook zijn huis heeft gebouwd met een aantal afgedankte materialen (bakstenen, keramiek...)."
    ],
    "es": [
      "Exposición de obras (óleos, cerámica, metal...) de un artista \"fuera de serie\" que también ha construido su casa con numerosos materiales reciclados (ladrillos, cerámica...)"
    ]
