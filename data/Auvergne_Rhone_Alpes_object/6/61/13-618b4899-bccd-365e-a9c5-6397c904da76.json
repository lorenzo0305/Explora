  "rdfs:comment": {
    "de": [
      "Am Fuße der Pisten von Avoriaz und im Herzen der Portes du Soleil gelegen, bietet dieses 4-Sterne-Hotel eine charmante Bergerfahrung, die Sie dazu einlädt, alle Jahreszeiten zu genießen."
    ],
    "en": [
      "Located at the foot of the Avoriaz slopes and in the heart of the Portes du Soleil, this 4-star hotel offers a charming mountain experience that invites you to enjoy all the seasons."
    ],
    "it": [
      "Situato ai piedi delle piste di Avoriaz e nel cuore delle Portes du Soleil, questo hotel a 4 stelle offre un'affascinante esperienza di montagna che invita a godere di tutte le stagioni."
    ],
    "fr": [
      "Situé au pied des pistes d’Avoriaz et au cœur des Portes du Soleil, cet hôtel 4 étoiles offre une expérience montagnarde charmante qui vous invite à apprécier toutes les saisons."
    ],
    "es": [
      "Situado a los pies de las pistas de Avoriaz y en el corazón de Portes du Soleil, este hotel de 4 estrellas ofrece una encantadora experiencia de montaña que invita a disfrutar de todas las estaciones."
    ],
    "nl": [
      "Gelegen aan de voet van de hellingen van Avoriaz en in het hart van de Portes du Soleil, dit 4-sterrenhotel biedt een charmante bergervaring die u uitnodigt om van alle seizoenen te genieten."
    ]
  },
