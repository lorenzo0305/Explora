  "rdfs:comment": {
    "de": [
      "Handwerkliche Herstellung von Silberschmuck auf Anfrage oder in kleinen Serien.\r\nLokal geschliffene Steine aus der Ardèche und anderen Ländern.\r\nWorkshops zur Herstellung von Schmuck (3 Stunden), mittwochs und samstags vormittags nach Vereinbarung."
    ],
    "en": [
      "Hand made crafted joaillerie. Locally made in Ardèche from silver.\r\nJewelry making workshops (3 hours), Wednesday and Saturday mornings."
    ],
    "it": [
      "Gioielli in argento realizzati a mano su ordinazione o in piccole serie.\r\nPietre dell'Ardèche e non solo, tagliate in loco.\r\nLaboratori di gioielleria (3 ore) il mercoledì e il sabato mattina su appuntamento."
    ],
    "fr": [
      "Création artisanale de bijoux en argent à la demande ou en petite série.\r\nPierres d’Ardèche et d’ailleurs taillées localement.\r\nAteliers de fabrication de bijoux (3h), les mercredis et les samedis matin sur rendez-vous."
    ],
    "es": [
      "Joyas artesanales de plata creadas por encargo o en pequeñas series.\r\nPiedras de Ardèche y de otros lugares, talladas localmente.\r\nTalleres de joyería (3 horas) los miércoles y sábados por la mañana con cita previa."
    ],
    "nl": [
      "Handgemaakte zilveren sieraden op bestelling of in kleine series.\r\nStenen uit de Ardèche en elders, ter plaatse geslepen.\r\nWorkshops sieraden maken (3 uur) op woensdag- en zaterdagochtend op afspraak."
    ]
  },
