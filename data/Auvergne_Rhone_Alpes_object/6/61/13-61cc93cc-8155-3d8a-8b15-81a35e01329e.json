  "rdfs:comment": {
    "de": [
      "Die eigentliche Attraktion dieses Abstiegs ist der Durchgang auf dem Gipfel der C45 durch das \"Loch des Kochtopfes\", das übrigens der Ursprung des Ortsnamens ist."
    ],
    "en": [
      "The real attraction of this descent is the passage at the top of the C45 through the \"trou de la marmite\", the origin of the locality's name."
    ],
    "it": [
      "La vera attrazione di questa discesa è il passaggio in cima alla C45 attraverso il \"trou de la marmite\", da cui deriva il nome della località."
    ],
    "fr": [
      "Le véritable attrait de cette descente est le passage au sommet de la C45 dans le \"trou de la marmite\" qui est d'ailleurs à l'origine du nom du lieu-dit."
    ],
    "es": [
      "El verdadero atractivo de este descenso es el paso en la parte superior de la C45 en el \"trou de la marmite\" que es el origen del nombre del lugar."
    ],
    "nl": [
      "De echte attractie van deze afdaling is de passage bovenaan de C45 door de \"trou de la marmite\", de bron van de naam van de plaats."
    ]
  },
  "rdfs:label": {
    "de": [
      "Wasserfälle des Tour de la Marmite"
    ],
    "en": [
      "Tour de la Marmite waterfalls"
    ],
    "it": [
      "Tour delle cascate della Marmite"
    ],
    "fr": [
      "Cascades du Tour de la Marmite"
    ],
    "nl": [
      "Tour de la Marmite watervallen"
    ]
  },
