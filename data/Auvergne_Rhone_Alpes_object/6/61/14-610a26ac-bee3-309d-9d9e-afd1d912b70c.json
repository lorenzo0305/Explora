      "dc:description": {
        "de": [
          "Hausgemachte Küche. Die Wahl zwischen Fisch und Fleisch, frische Produkte, wunderschöne Umgebung mit Blick auf die Bucht von Authie"
        ],
        "en": [
          "Home-cooked cuisine. Choice of fish and meat, fresh produce, magnificent setting overlooking Authie Bay"
        ],
        "it": [
          "Cucina casalinga. Scelta di pesce e carne, prodotti freschi, ambiente magnifico con vista sulla baia di Authie"
        ],
        "fr": [
          "Cuisine fait maison. Le choix entre poisson et viande, produits frais, cadre magnifique avec vue sur la baie d'Authie"
        ],
        "nl": [
          "Huisgemaakte keuken. Keuze uit vis en vlees, verse producten, prachtige omgeving met uitzicht op de baai van Authie"
        ],
        "es": [
          "Cocina casera. Elección de pescados y carnes, productos frescos, magnífico entorno con vistas a la bahía de Authie"
