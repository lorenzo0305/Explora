  "rdfs:comment": {
    "de": [
      "La Ruche à gîter ist ein Gasthaus, in dem wir Sie für einen Abend mit Freunden oder der Familie, mit Ihren Kollegen, auf dem Rückweg von einer Wanderung oder nach einem faulen Tag in der Sonne begrüßen können. Die Idee ist, eine gute Zeit zu teilen."
    ],
    "en": [
      "The Ruche à gîter is an inn where we can welcome you for a friend or family night, with your colleagues, when you come back from a hike or after lazing in the sun. The idea is to share a good time."
    ],
    "it": [
      "La Ruche à gîter è un ostello dove possiamo accogliervi per una serata con gli amici o la famiglia, con i colleghi, al ritorno da un'escursione o dopo una pigra giornata al sole. L'idea è quella di condividere un buon momento."
    ],
    "fr": [
      "La Ruche à gîter est une auberge où nous pouvons vous accueillir pour une soirée entre amis ou en famille, avec vos collègues, au retour d'une randonnée ou après un farniente au soleil. L'idée est de partager un bon moment."
    ],
    "nl": [
      "La Ruche à gîter is een herberg waar we je kunnen ontvangen voor een avond met vrienden of familie, met je collega's, bij terugkomst van een wandeling of na een luie dag in de zon. Het idee is om een leuke tijd te delen."
    ],
    "es": [
      "La Ruche à gîter es un albergue donde podemos acogerle para pasar una velada con amigos o en familia, con sus colegas, a la vuelta de una excursión o después de un perezoso día al sol. La idea es compartir un buen rato."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Bar La Ruche à gîter"
    ]
  },
