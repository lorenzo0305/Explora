  "rdfs:comment": {
    "de": [
      "Ausgehend vom idealen Palast des Pferdefaktors, vor oder nach der Besichtigung, wäre es eine Schande, die Gelegenheit nicht zu nutzen, um die Umgebung zu erkunden."
    ],
    "en": [
      "Leaving from the ideal palace of the horse factor, before or after the visit, it would be a shame not to take the opportunity to explore the surrounding area."
    ],
    "it": [
      "Partendo dall'ideale palazzo del cavaliere, prima o dopo la visita, sarebbe un peccato non cogliere l'occasione per esplorare i dintorni."
    ],
    "fr": [
      "Au départ du palais idéal du facteur cheval, avant ou après la visite, il serait dommage de ne pas profiter de l'occasion pour découvrir les environs."
    ],
    "nl": [
      "Vertrekkend vanuit het ideale ruiterpaleis, voor of na het bezoek, zou het zonde zijn om niet van de gelegenheid gebruik te maken om de omgeving te verkennen."
    ],
    "es": [
      "Partiendo del ideal palacio del jinete, antes o después de la visita, sería una pena no aprovechar la oportunidad para explorar los alrededores."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le rêve du facteur"
    ]
  },
