  "rdfs:comment": {
    "de": [
      "14 akrobatische Parcours in den Bäumen auf verschiedenen Niveaus mit über 140 Spielen und einer 140 m langen Seilrutsche, alles zugänglich ab 3 Jahren! Elfendorf und Einführungsparcours ohne Ausrüstung für die Ängstlichsten!"
    ],
    "en": [
      "14 acrobatic tree courses at different levels, with over 140 games and a 140-metre zip line, all accessible from age 3! Elf village and equipment-free introductory course for the more timid!"
    ],
    "it": [
      "14 percorsi acrobatici sugli alberi, a diversi livelli, con oltre 140 giochi e una zip line di 140 metri, tutti accessibili a partire dai 3 anni! C'è anche un Villaggio degli Elfi e un percorso introduttivo senza attrezzatura per i più timidi!"
    ],
    "fr": [
      "14 parcours acrobatiques dans les arbres, de différents niveaux avec plus de 140 jeux et une tyrolienne de 140 mètres, le tout accessible à partir de 3 ans ! Village des Elfes et parcours d'initiation sans équipement pour les plus craintifs !"
    ],
    "es": [
      "14 recorridos acrobáticos en los árboles, de diferentes niveles, con más de 140 juegos y una tirolina de 140 metros, ¡todo accesible a partir de los 3 años! También hay una Aldea de los Elfos y un recorrido de iniciación sin equipo para los más tímidos"
    ],
    "nl": [
      "14 acrobatische parcours in de bomen, op verschillende niveaus, met meer dan 140 spelen en een tokkelbaan van 140 meter, allemaal toegankelijk vanaf 3 jaar! Er is ook een Elfendorp en een inleidend parcours zonder uitrusting voor de bangeriken!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Acrobois Pilat"
    ]
  },
