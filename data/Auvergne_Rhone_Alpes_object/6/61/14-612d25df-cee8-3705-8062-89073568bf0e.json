      "dc:description": {
        "de": [
          "MÄRCHEN UND KLEINE MARIONETTEN\nMI 17. DEZEMBER - 10:31| FÜR 2-5 JÄHRIGE LA MENUISERIE\nMit der Note Bleue\nWeihnachtsgeschichten für die Ohren und für die Augen.\nAU POTCH"
        ],
        "en": [
          "STORYTELLING AND PUPPETS\nWED DECEMBER 17 - 10:31 AM| FOR AGES 2-5 LA MENUISERIE\nWith Note Bleue\nChristmas stories for the ears and eyes.\nAT THE POTCH"
        ],
        "it": [
          "NARRAZIONE E BURATTINI\nMERCOLEDÌ 17 DICEMBRE - ORE 10.31| PER I BAMBINI DAI 2 AI 5 ANNI LA MENUISERIE\nCon la Note Bleue\nStorie di Natale per le orecchie e per gli occhi.\nAL POTCH"
        ],
        "fr": [
          "CONTE ET PETITES MARIONNETTES\nMER 17 DÉCEMBRE - 10H31| POUR LES 2-5 ANS LA MENUISERIE\nAvec la Note Bleue\nHistoires de Noël pour les oreilles et pour les yeux.\nAU POTCH"
        ],
        "nl": [
          "VERHALEN EN POPPEN\nWO 17 DECEMBER - 10.31 UUR| VOOR KINDEREN VAN 2-5 JAAR LA MENUISERIE\nMet la Note Bleue\nKerstverhalen voor oren en ogen.\nIN DE POT"
        ],
        "es": [
          "CUENTACUENTOS Y MARIONETAS\nMIER 17 DICIEMBRE - 10.31 H| PARA NIÑOS DE 2 A 5 AÑOS LA MENUISERIE\nCon la Note Bleue\nCuentos de Navidad para los oídos y los ojos.\nEN EL POTCH"
        ]
      },
