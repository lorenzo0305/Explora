  "rdfs:comment": {
    "de": [
      "Wassersportverleih ab dem Strand von Rénac: Tretboote 4 Plätze mit oder ohne Rutsche, Einzel- und Gruppenpaddel (8 Plätze), Kanus 2 Plätze und Kajaks, Jetskis mit Führerschein, Boote mit oder ohne Führerschein."
    ],
    "en": [
      "Nautical rentals from Rénac beach: 4-seater pedalos with or without slide, individual and group paddles (8 seats), 2-seater canoes and kayaks, jet skis with license, boats with or without license."
    ],
    "it": [
      "Noleggio di sport acquatici dalla spiaggia di Rénac: pedalò a 4 posti con o senza scivoli, pagaie individuali e di gruppo (8 posti), canoe e kayak a 2 posti, moto d'acqua con licenza, barche con o senza licenza."
    ],
    "fr": [
      "Location nautique depuis la plage de Rénac : pédalos 4 places avec ou sans toboggan, paddles individuels et collectifs (8 places), canoës 2 place et kayaks, jet skis avec permis, bateaux avec ou sans permis."
    ],
    "nl": [
      "Verhuur van watersporten vanaf het strand van Rénac: waterfietsen met 4 zitplaatsen met of zonder glijbaan, individuele en groepspeddels (8 plaatsen), kano's en kajaks met 2 zitplaatsen, jetski's met vaarbewijs, boten met of zonder vaarbewijs."
    ],
    "es": [
      "Alquiler de deportes náuticos en la playa de Rénac: pedales de 4 plazas con o sin toboganes, remo individual y en grupo (8 plazas), canoas y kayaks de 2 plazas, motos acuáticas con licencia, lanchas con o sin licencia."
    ]
  },
