  "rdfs:comment": {
    "de": [
      "Die Schüler der Trompetenklassen der Musikschule Ardèche Rhône Coiron (Zweigstelle Le Teil) und des Konservatoriums von Montélimar-Agglomération treffen sich zu einem Abend, an dem die Trompete Königin sein wird."
    ],
    "en": [
      "Students from the trumpet classes of the Ardèche Rhône Coiron music school (Le Teil branch) and the Montélimar-Agglomération conservatory come together for an evening where the trumpet will be king."
    ],
    "it": [
      "Gli allievi delle classi di tromba della scuola di musica Ardèche Rhône Coiron (sede di Le Teil) e del conservatorio di Montélimar-Agglomération si riuniscono per una serata in cui la tromba sarà il re."
    ],
    "fr": [
      "Les élèves des classes de trompettes de l'école de musique Ardèche Rhône Coiron (antenne Le Teil) et du conservatoire de Montélimar-Agglomération se réunissent pour une soirée où la trompette sera reine."
    ],
    "es": [
      "Los alumnos de las clases de trompeta de la escuela de música de Ardèche Rhône Coiron (sección Le Teil) y del conservatorio de Montélimar-Agglomération se reúnen para una velada en la que la trompeta será la reina."
    ],
    "nl": [
      "Leerlingen van de trompetklassen van de Ardèche Rhône Coiron muziekschool (afdeling Le Teil) en het Montélimar-Agglomération conservatorium komen samen voor een avond waar de trompet koning zal zijn."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Nos trompettistes en concert !"
    ]
  },
