  "rdfs:comment": {
    "de": [
      "Innerhalb unserer Struktur finden Sie eine Reihe von Kompetenzen: Skilehrer, Bergführer, Begleiter oder Hängegleiterpiloten - unsere Leidenschaften zu Ihren Diensten."
    ],
    "en": [
      "You'll find a wide range of skills within our structure: ski instructors, mountain guides, mountain leaders or hang-gliding pilots... our passions at your service."
    ],
    "it": [
      "All'interno della nostra struttura troverete un'ampia gamma di competenze: maestri di sci, guide alpine, accompagnatori o piloti di deltaplano... le nostre passioni al vostro servizio."
    ],
    "fr": [
      "Vous trouverez, au sein de notre structure, un panel de compétences : moniteurs de ski, guides de haute montagne, accompagnateurs ou pilote de vol libre... nos passions à votre service."
    ],
    "nl": [
      "Je vindt een breed scala aan vaardigheden binnen onze structuur: skileraren, berggidsen, bergleiders of deltavliegers... onze passies tot je dienst."
    ],
    "es": [
      "En nuestra estructura encontrará un amplio abanico de competencias: monitores de esquí, guías de montaña, acompañantes o pilotos de ala delta... nuestras pasiones a su servicio."
    ]
  },
