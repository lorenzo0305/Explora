  "rdfs:comment": {
    "de": [
      "Öffnen Sie die Türen des Bongo und treten Sie ein in eine Welt voller Träume und Magie! Unser Team empfängt Sie im Herzen der Drôme und nur wenige Schritte vom TGV-Bahnhof Valence entfernt in einer festlichen und geselligen Atmosphäre! Erleben Sie mit uns unvergessliche Momente!"
    ],
    "en": [
      "Push open the doors of Le Bongo and enter a world of dreams and magic! Our team welcomes you to the heart of the Drôme region, just a stone's throw from Valence TGV station, in a festive and friendly atmosphere! Experience unforgettable moments with us!"
    ],
    "it": [
      "Aprite le porte del Bongo ed entrate in un mondo di sogni e magia! Il nostro team vi accoglie nel cuore della Drôme e a due passi dalla stazione TGV di Valence in un'atmosfera festosa e amichevole! Vivete con noi momenti indimenticabili!"
    ],
    "fr": [
      "Poussez les portes du Bongo et entrez dans un univers de rêve et de magie ! Notre équipe vous accueillent au cœur de la Drôme et à deux pas de la gare TGV de Valence dans une ambiance festive et conviviale ! Vivez avec nous des moments inoubliables !"
    ],
    "nl": [
      "Open de deuren van Le Bongo en betreed een wereld vol dromen en magie! Ons team heet u welkom in het hart van de Drôme, op een steenworp afstand van het TGV-station van Valence, in een feestelijke en gezellige sfeer! Kom bij ons voor een onvergetelijke ervaring!"
    ],
    "es": [
      "Abra las puertas del Bongo y entre en un mundo de ensueño y magia Nuestro equipo le da la bienvenida en el corazón de la Drôme y a dos pasos de la estación de TGV de Valence, en un ambiente festivo y acogedor ¡Viva momentos inolvidables con nosotros!"
    ]
  },
