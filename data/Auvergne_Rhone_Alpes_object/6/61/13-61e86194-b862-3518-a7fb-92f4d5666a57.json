  "rdfs:comment": {
    "de": [
      "Am Ufer der Saône gelegen, bietet das Restaurant Quai 50 das ganze Jahr über eine Speisekarte mit italienischen Spezialitäten, die aus Produkten der Saison hergestellt werden. Genießen Sie bei schönem Wetter unsere angenehme schattige Terrasse mit Blick auf die Saône."
    ],
    "en": [
      "Facing the banks of the Saône River, the Quai 50 restaurant offers a year-round menu of Italian specialities made with seasonal produce. In fine weather, enjoy our pleasant shaded terrace with a view of the Saône."
    ],
    "it": [
      "Affacciato sulle rive del fiume Saona, il ristorante Quai 50 offre tutto l'anno un menu di specialità italiane con prodotti di stagione. Con il bel tempo, godetevi la nostra piacevole terrazza ombreggiata con vista sulla Saona."
    ],
    "fr": [
      "Face aux berges de la Saône, le restaurant Quai 50 vous propose toute l'année une carte de spécialités italiennes élaborées avec des produits de saison. Aux beaux jours, profitez de l'agréable terrasse ombragée avec vue sur la Saône."
    ],
    "nl": [
      "Restaurant Quai 50 kijkt uit op de oevers van de Saône en biedt het hele jaar door een menu met Italiaanse specialiteiten bereid met seizoensproducten. Bij mooi weer kunt u genieten van het aangename schaduwrijke terras met uitzicht op de Saône."
    ],
    "es": [
      "Frente a las orillas del río Saona, el restaurante Quai 50 ofrece durante todo el año un menú de especialidades italianas hechas con productos de temporada. Cuando haga buen tiempo, disfruten de nuestra agradable terraza sombreada con vistas al Saona. ."
    ]
  },
