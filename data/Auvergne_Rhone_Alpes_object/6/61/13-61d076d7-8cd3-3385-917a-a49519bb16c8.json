      "schema:openingHoursSpecification": [
        {
          "@id": "https://data.datatourisme.fr/97e5a260-7aff-33b1-80d6-932534957334",
          "schema:validFrom": "2026-01-01T00:00:00",
          "schema:validThrough": "2026-12-01T23:59:59",
          "@type": [
            "schema:OpeningHoursSpecification"
          ],
          "additionalInformation": {
            "de": [
              "Geschäft ganzjährig von Dienstag bis Samstag zu den üblichen Öffnungszeiten geöffnet, 9.30-13.30 Uhr und 15-18.30 Uhr\r\nbis zum Frühjahr geöffnet. Während der Sommermonate täglich geöffnet.\r\nKostenlose Workshops mit Verkostungen, Entdeckungen und Spielen rund um unsere 5 AOP der Auvergne das ganze Jahr über."
            ],
            "en": [
              "Store open all year round, Tuesday to Saturday, 9.30am to 1.30pm and 3pm to 6.30pm\r\nuntil spring. Open every day during the summer.\r\nFree tasting workshops, discoveries and games around our 5 Auvergne PDOs all year round."
            ],
            "it": [
              "Negozio aperto tutto l'anno, dal martedì al sabato, dalle 9.30 alle 13.30 e dalle 15.00 alle 18.30\r\nfino alla primavera. Aperto tutti i giorni durante l'estate.\r\nLaboratori di degustazione gratuiti, scoperte e giochi sulle 5 DOP dell'Alvernia durante tutto l'anno."
            ],
            "fr": [
              "Magasin ouvert toute l’année du mardi au samedi aux horaires habituels, 9h30-13h30 et 15h à 18h30\r\njusqu'au printemps. Ouverture tous les jours pendant la période d'été. \r\nAteliers gratuits de dégustation, découvertes et jeux autour de nos 5 AOP d’Auvergne toute l’année."
            ],
            "nl": [
              "Winkel het hele jaar geopend, dinsdag t/m zaterdag van 9.30 tot 13.30 uur en van 15.00 tot 18.30 uur\r\ntot het voorjaar. In de zomer elke dag open.\r\nHet hele jaar door gratis proeverijen, ontdekkingen en spelletjes rond onze 5 BOB's van de Auvergne."
            ],
            "es": [
              "Tienda abierta todo el año, de martes a sábado, de 9.30 a 13.30 h. y de 15.00 a 18.30 h\r\nhasta la primavera. Abierta todos los días durante el verano.\r\nTalleres de degustación gratuitos, descubrimientos y juegos en torno a nuestras 5 DOP de Auvernia durante todo el año."
            ]
          },
