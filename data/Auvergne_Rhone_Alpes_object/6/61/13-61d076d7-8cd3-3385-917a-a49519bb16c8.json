  "rdfs:comment": {
    "de": [
      "Hersteller und Affineure von Käse aus der Auvergne seit 1911.\r\nIn unserem Direktverkaufsladen finden Sie unsere Käsesorten und regionalen Produkte, die aufgrund ihrer Qualität und Authentizität ausgewählt wurden."
    ],
    "en": [
      "Manufacturer and refiner of Auvergne cheeses since 1911.\r\nFind in the heart of our direct sales store, our cheeses and regional products selected for their quality and authenticity."
    ],
    "it": [
      "Produttore e stagionatore di formaggi d'Alvernia dal 1911.\r\nNel cuore del nostro negozio di vendita diretta, troverete i nostri formaggi e prodotti regionali selezionati per la loro qualità e autenticità."
    ],
    "fr": [
      "Fabricant et affineur des fromages d'Auvergne depuis 1911.\r\nRetrouvez au cœur de notre boutique de vente directe, nos fromages et produits régionaux sélectionnés pour leur qualité et leur authenticité."
    ],
    "nl": [
      "Fabrikant en rijper van kazen uit de Auvergne sinds 1911.\r\nIn het hart van onze winkel voor rechtstreekse verkoop vindt u onze kazen en streekproducten die zijn geselecteerd op kwaliteit en authenticiteit."
    ],
    "es": [
      "Fabricante y madurador de quesos de Auvernia desde 1911.\r\nEn el corazón de nuestra tienda de venta directa, encontrará nuestros quesos y productos regionales seleccionados por su calidad y autenticidad."
    ]
  },
  "rdfs:label": {
