  "rdfs:comment": {
    "de": [
      "Ein von Herrn Damien entworfener Rundgang, der selbstständig durchgeführt werden kann, mithilfe von zehn im Dorf verteilten Tafeln, auf denen die Indizien aufgelistet sind, die den Ermittlern die Lösung verraten."
    ],
    "en": [
      "An itinerant investigation trail, created by Monsieur Damien, to be completed on your own via a dozen panels scattered around the village, listing the clues that will help reveal the solution to the investigators."
    ],
    "it": [
      "Un percorso investigativo itinerante, creato dal signor Damien, da completare autonomamente sulla base di una dozzina di cartelli sparsi per il paese, che elencano gli indizi che aiuteranno a svelare la soluzione agli investigatori."
    ],
    "fr": [
      "Parcours enquête itinérant, créé par Monsieur Damien, à réaliser en autonomie à travers une dizaine de panneaux dispersés dans le village et répertoriant les indices qui contribueront à révéler la solution aux enquêteurs."
    ],
    "es": [
      "Una pista de investigación itinerante, creada por el Sr. Damien, que debe completarse de forma independiente a partir de una docena de carteles repartidos por el pueblo, en los que se enumeran las pistas que ayudarán a desvelar la solución a los investigadores."
    ],
    "nl": [
      "Een rondreizend onderzoekspad, gemaakt door Mr Damien, dat zelfstandig moet worden voltooid aan de hand van een dozijn borden verspreid over het dorp, waarop de aanwijzingen staan die de onderzoekers zullen helpen de oplossing te onthullen."
    ]
  },
  "rdfs:label": {
    "en": [
      "Lupicin's Mystery Game"
    ],
    "fr": [
      "Jeu le Mystère de Lupicin"
    ]
  },
