  "rdfs:comment": {
    "de": [
      "Le Chaudron, das im Winter ideal auf den Pisten von Lindarets und im Sommer im Zentrum des Ziegendorfes liegt, bietet Ihnen eine traditionelle Küche. A la carte und zur Stärkung nach einem Vormittag auf der Skipiste: leckere savoyische Gerichte."
    ],
    "en": [
      "In  winter, Le Chaudron is ideally located on the slopes of Les Lindarets, an area that in the summer is transformed to a veritable goat village. It serves traditional cuisine including delicious Savoyard dishes to help recharge your batteries after a morning's skiing."
    ],
    "it": [
      "Le Chaudron, situato in posizione ideale sulle pendici di Les Lindarets in inverno e nel centro del villaggio di capre in estate, offre una cucina tradizionale. Alla carta e per recuperare le forze dopo una mattinata di sci: gustosi piatti savoiardi."
    ],
    "fr": [
      "Le Chaudron, idéalement situé sur les pistes des Lindarets en hiver et au centre du village des chèvres en été, vous propose une cuisine traditionnelle. A la carte et pour reprendre des forces après une matinée de ski : de savoureux plats savoyards."
    ],
    "es": [
      "Le Chaudron, idealmente situado en las laderas de Les Lindarets en invierno y en el centro del pueblo de las cabras en verano, ofrece una cocina tradicional. A la carta y para reponer fuerzas después de una mañana de esquí: sabrosos platos saboyanos."
    ],
    "nl": [
      "Le Chaudron, ideaal gelegen op de pistes van Les Lindarets in de winter en midden in het geitendorpje in de zomer, biedt een traditionele keuken. A la carte en om weer op kracht te komen na een ochtendje skiën: heerlijke gerechten uit de Savoie."
    ]
  },
