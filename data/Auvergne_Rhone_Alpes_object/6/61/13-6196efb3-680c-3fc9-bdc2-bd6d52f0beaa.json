  "rdfs:comment": {
    "de": [
      "Touristische Informationsstelle in einem Dorf mit dem Label Village de Caractère (Dorf mit Charakter), in der Benediktiner-Priorei. Wanderführer, regionale Bücher und Postkarten werden ebenso verkauft wie Kunsthandwerk und Produkte aus der Region."
    ],
    "en": [
      "Tourist information place located in a village labeled Village de Caractère, within the Benedictine Priory. Hiking guides, regional books and postcards are on sale as well as crafts and local products."
    ],
    "it": [
      "Centro di informazione turistica situato in un villaggio con il marchio Village de Caractère, all'interno del Priorato benedettino. Sono in vendita guide escursionistiche, libri regionali e cartoline, oltre a oggetti di artigianato e prodotti locali."
    ],
    "fr": [
      "Lieu d'information touristique situé dans un village labellisé Village de Caractère, au sein du Prieuré bénédictin. Guides de randonnées, livres régionaux et cartes postales sont en vente ainsi que de l'artisanat et des produits du terroir."
    ],
    "nl": [
      "Toeristisch informatiecentrum gelegen in een dorp met het label Village de Caractère, binnen de Benedictijnse Priorij. Wandelgidsen, regionale boeken en ansichtkaarten zijn te koop, evenals handwerk en lokale producten."
    ],
    "es": [
      "Centro de información turística situado en un pueblo con la etiqueta Village de Caractère, dentro del Priorato Benedictino. Se venden guías de senderismo, libros regionales y postales, así como artesanía y productos locales."
    ]
  },
  "rdfs:label": {
