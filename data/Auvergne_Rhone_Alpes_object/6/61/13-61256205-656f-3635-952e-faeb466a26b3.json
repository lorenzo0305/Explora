  "rdfs:comment": {
    "de": [
      "Das Atelier des Créateurs ist eine echte Brutstätte für Kunsthandwerker und soll Kreativen in den Bereichen Textil und Kunsthandwerk im Allgemeinen während ihrer Startphase als Sprungbrett dienen."
    ],
    "en": [
      "The Atelier des Créateurs is a veritable incubator for craftspeople, providing a springboard for creators in the fields of textiles and crafts in general during their start-up phase."
    ],
    "it": [
      "L'Atelier des Créateurs è un vero e proprio incubatore di artigiani, che offre un trampolino di lancio ai designer tessili e agli artigiani in generale nella loro fase di avvio."
    ],
    "fr": [
      "Véritable pépinières d'artisans d'art, l'atelier des créateurs a pour but de servir de tremplin à des créateurs dans les domaines du textile et des métiers d'art en général lors de leur phase de démarrage."
    ],
    "nl": [
      "Het Atelier des Créateurs is een echte broedplaats voor ambachtslieden, die textielontwerpers en ambachtslieden in het algemeen een springplank biedt tijdens hun opstartfase."
    ],
    "es": [
      "El Atelier des Créateurs es una auténtica incubadora de artesanos, que sirve de trampolín a los diseñadores textiles y artesanos en general durante su fase inicial."
    ]
  },
