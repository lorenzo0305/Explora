  "rdfs:comment": {
    "de": [
      "Hausgemachte mexikanische Spezialitäten mit frischen Produkten und vor Ort hergestellten Nudeln: Tacos, Burritos, Quesadillas, Enchiladas, Alitas, Nachos oder auch Guacamole und Cocktails, in einem familiären Geist und einer Latino-Atmosphäre."
    ],
    "en": [
      "Homemade Mexican specialties using fresh produce and pasta made on site: tacos, burritos, quesadillas, enchiladas, alitas, nachos, guacamole and cocktails, in a family-friendly, Latino atmosphere."
    ],
    "it": [
      "Specialità messicane fatte in casa con prodotti freschi e pasta prodotta in loco: tacos, burritos, quesadillas, enchiladas, alitas, nachos, guacamole e cocktail, in un'atmosfera familiare dal sapore latino."
    ],
    "fr": [
      "Spécialités mexicaines faites maison avec des produits frais et des pâtes fabriquées sur place : tacos, burritos, quesadillas, enchiladas, alitas, nachos ou encore guacamole et cocktails, dans un esprit familial et une ambiance latino."
    ],
    "nl": [
      "Huisgemaakte Mexicaanse specialiteiten met verse producten en deegwaren die ter plekke worden gemaakt: taco's, burrito's, quesadillas, enchiladas, alitas, nacho's, guacamole en cocktails, in een familiale sfeer met een Latijns tintje."
    ],
    "es": [
      "Especialidades mexicanas caseras con productos frescos y pastas hechas en el local: tacos, burritos, quesadillas, enchiladas, alitas, nachos, guacamole y cócteles, en un ambiente familiar con sabor latino."
    ]
  },
  "rdfs:label": {
    "fr": [
