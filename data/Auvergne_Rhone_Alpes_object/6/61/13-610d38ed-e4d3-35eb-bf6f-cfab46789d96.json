  "rdfs:comment": {
    "de": [
      "Was gibt es Schöneres, als seine Karriere mit einem Höhepunkt zu beenden? SACRE, von Daniel Larrieu für die Tänzerin Sophie Billon geschrieben, extrahiert in einem strahlenden Solo mit Live-Klavierbegleitung die Essenz der choreografischen Handschrift eines ganzen Lebens."
    ],
    "en": [
      "What better way to end a career than in style? SACRE, written by Daniel Larrieu for dancer Sophie Billon, extracts the essence of a lifetime of choreographic writing in a dazzling solo, accompanied by live piano accompaniment."
    ],
    "it": [
      "Quale modo migliore di chiudere una carriera se non con stile? SACRE, scritto da Daniel Larrieu per la danzatrice Sophie Billon, estrae l'essenza di una vita di coreografie in un assolo folgorante, accompagnato dal vivo dal pianoforte."
    ],
    "fr": [
      "Quoi de mieux que finir sa carrière en beauté ? SACRE, écrit par Daniel Larrieu pour la danseuse Sophie Billon, extrait dans un solo éclatant, accompagné en live au piano, l’essence de l’écriture chorégraphique de toute une vie."
    ],
    "es": [
      "¿Qué mejor manera de poner fin a una carrera que con estilo? SACRE, escrita por Daniel Larrieu para la bailarina Sophie Billon, extrae la esencia de toda una vida coreográfica en un deslumbrante solo, acompañado en directo al piano."
    ],
    "nl": [
      "Wat is een betere manier om een carrière af te sluiten dan in stijl? SACRE, geschreven door Daniel Larrieu voor danseres Sophie Billon, vat de essentie van een leven lang choreograferen samen in een wervelende solo, live begeleid op piano."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Spectacle de danse de Daniel Larrieu \"Sacre\""
    ]
  },
