  "rdfs:comment": {
    "de": [
      "Nach glanzvollen Jahren ist das Kabarett der beiden Brüder Claude (Jérôme Anthony) und Michaël (Nicolas Vitiello) bankrott.\nTrotz der Hilfe von Celeste (Véronique Demonge), einer pensionierten Revueleiterin, haben sie Mühe, das Etablissement wieder zu alter Größe zu führen."
    ],
    "en": [
      "After years of glory, the cabaret run by brothers Claude (Jérôme Anthony) and Michaël (Nicolas Vitiello) has gone bankrupt.\nDespite the help of Celeste (Véronique Demonge), a retired revue leader, they struggle to restore the establishment to its former grandeur."
    ],
    "it": [
      "Dopo anni di gloria, il cabaret gestito dai fratelli Claude (Jérôme Anthony) e Michaël (Nicolas Vitiello) è fallito.\nNonostante l'aiuto di Celeste (Véronique Demonge), leader di una rivista in pensione, i due lottano per riportare il locale al suo antico splendore."
    ],
    "fr": [
      "Après de belles années de gloire, le cabaret des deux frères Claude (Jérôme Anthony) et Michaël (Nicolas Vitiello) est en faillite.\nMalgré l'aide de Celeste (Véronique Demonge), meneuse de revue à la retraite, ils peinent à redonner à l'établissement sa grandeur d'antan."
    ],
    "es": [
      "Tras años de gloria, el cabaret regentado por los hermanos Claude (Jérôme Anthony) y Michaël (Nicolas Vitiello) ha quebrado.\nA pesar de la ayuda de Celeste (Véronique Demonge), una directora de revista retirada, luchan por devolver al establecimiento su antiguo esplendor."
    ],
    "nl": [
      "Na jaren van glorie is het cabaret van de broers Claude (Jérôme Anthony) en Michaël (Nicolas Vitiello) failliet.\nOndanks de hulp van Celeste (Véronique Demonge), een gepensioneerde revueleidster, worstelen ze om het etablissement in zijn oude glorie te herstellen."
    ]
  },
