  "rdfs:comment": {
    "de": [
      "Der Espace Culturel Saint-Roch zeigt Objekte aus gallo-römischen Gräbern sowie Kultgegenstände aus dem 16. und 17. Jahrhundert, die in Lanslevillard entdeckt wurden. Eine Dauerausstellung widmet sich den Berggemeinden des 16"
    ],
    "en": [
      "The Espace Culturel Saint-Roch presents objects from Gallo-Roman tombs as well as religious elements from the 16th and 17th centuries discovered in Lanslevillard. A permanent exhibition is devoted to the mountain communities of the 16th century"
    ],
    "it": [
      "L'Espace Culturel Saint-Roch presenta oggetti provenienti da tombe gallo-romane ed elementi di culto del XVI e XVII secolo scoperti a Lanslevillard. Una mostra permanente è dedicata alle comunità montane del XVI secolo"
    ],
    "fr": [
      "L'Espace Culturel Saint-Roch présente des objets provenant de tombes gallo-romaines ainsi que des éléments de culte des 16ème et 17ème siècles découverts à Lanslevillard. Une exposition permanente est consacrée aux communautés montagnardes du 16ème siècle"
    ],
    "es": [
      "El Espace Culturel Saint-Roch presenta objetos procedentes de tumbas galo-romanas, así como elementos de culto de los siglos XVI y XVII descubiertos en Lanslevillard. Una exposición permanente está dedicada a las comunidades de montaña del siglo XVI"
    ],
    "nl": [
      "De Espace Culturel Saint-Roch presenteert voorwerpen uit Gallo-Romeinse graven en religieuze elementen uit de 16e en 17e eeuw die in Lanslevillard zijn ontdekt. Een permanente tentoonstelling is gewijd aan de berggemeenschappen van de 16e eeuw"
    ]
  },
