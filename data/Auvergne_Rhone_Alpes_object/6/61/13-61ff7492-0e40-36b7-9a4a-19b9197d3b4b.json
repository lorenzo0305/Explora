  "rdfs:comment": {
    "de": [
      "Die Grande Chartreuse, die 1084 von Saint Bruno gegründet wurde, ist ein unumgängliches Ziel. Während das Kloster ein Ort des Gebets bleibt, klärt Sie das Museum über das Leben der Mönche auf, die sich in die Einsamkeit und Stille zurückgezogen haben."
    ],
    "en": [
      "In the heart of the chartreuse mountains, this unique site is just 2 km from the famous monastery founded by Saint Bruno in 1084."
    ],
    "it": [
      "La Grande Chartreuse, fondata da San Bruno nel 1084, è una destinazione da non perdere. Mentre il monastero rimane un luogo di preghiera, il museo fa luce sulla vita dei monaci, che vivevano in solitudine e silenzio."
    ],
    "fr": [
      "La Grande Chartreuse, fondée par Saint Bruno en 1084, est une destination incontournable. Si le monastère reste un lieu de prière, le musée vous éclaire sur la vie des moines retirés dans la solitude et le silence."
    ],
    "es": [
      "La Grande Chartreuse, fundada por San Bruno en 1084, es un destino imprescindible. Aunque el monasterio sigue siendo un lugar de oración, el museo arroja luz sobre la vida de los monjes, que vivían en soledad y silencio."
    ],
    "nl": [
      "De Grande Chartreuse, gesticht door de heilige Bruno in 1084, is een niet te missen bestemming. Terwijl het klooster een plaats van gebed blijft, werpt het museum licht op het leven van de monniken, die in eenzaamheid en stilte leefden."
    ]
  },
  "rdfs:label": {
