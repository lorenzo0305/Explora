  "rdfs:comment": {
    "de": [
      "Das Restaurant befindet sich auf 1720 m Höhe und bietet Ihnen einen Panoramablick auf die Chaine des fiz, die Aravis und den Mont-Joly sowie eine große Sonnenterrasse."
    ],
    "en": [
      "This restaurant, with its large sunny terrace, is located at an altitude of 1,720 metres and offers panoramic views of the Fiz mountain range, the Aravis and Mont Joly."
    ],
    "it": [
      "Il ristorante si trova a 1.720 metri e offre une vista panoramica sulla catena dei Fiz, le Aravis e sul Mont-Joly, oltre a una grande terrazza soleggiata."
    ],
    "fr": [
      "Le restaurant est situé à 1720 mètres d'altitude, il vous offre une vue  panoramique sur la chaine des fiz, les Aravis et le Mont-Joly, ainsi qu'une grande terrasse ensoleillée."
    ],
    "nl": [
      "Het restaurant ligt op 1720 meter hoogte en biedt een panoramisch uitzicht op het Fiz-gebergte, het Aravis-gebergte en de Mont-Joly, en een groot zonneterras."
    ],
    "es": [
      "El restaurante está situado a 1720 metros de altitud y ofrece una vista panorámica de la cordillera de Fiz, los montes Aravis y el Mont-Joly, así como una gran terraza soleada."
    ]
  },
