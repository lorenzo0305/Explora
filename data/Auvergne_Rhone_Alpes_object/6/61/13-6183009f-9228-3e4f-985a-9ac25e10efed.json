  "rdfs:comment": {
    "de": [
      "Herzlich willkommen in einem 6000 m2 großen Indoor-Entspannungsbereich voller Spaß. Ihr Champions Five-Zentrum in Bourgoin-Jallieu ist der einzigartige Ort, an dem Sie Ihren sportlichen Wünschen freien Lauf lassen können.\r\nNeu: Bowling, Lasergame und Arcade-Spiele."
    ],
    "en": [
      "With a warm welcome and 6,000 m2 of pure indoor fun, your Champions Five center in Bourgoin-Jallieu is the place to indulge your sporting desires.\r\nNew: bowling, lasergame and arcade games."
    ],
    "it": [
      "Un'accoglienza calorosa in un'area relax coperta di 6.000 m2 di puro divertimento: il vostro centro Champions Five di Bourgoin-Jallieu è l'unico posto dove dare libero sfogo ai vostri desideri sportivi.\r\nNovità: bowling, lasergame e giochi arcade."
    ],
    "fr": [
      "Chaleureusement accueillis dans un espace détente intérieur  de 6000 m2 de pur fun, votre centre Champions Five à Bourgoin-Jallieu est le lieu unique pour laisser libre cours à vos envies sportives.\r\nNouveau : bowling, lasergame et jeux d'arcades."
    ],
    "es": [
      "Una cálida bienvenida en un espacio interior de relajación de 6.000 m2 de pura diversión, su centro Champions Five de Bourgoin-Jallieu es el único lugar para dar rienda suelta a sus deseos deportivos.\r\nNovedad: bolera, lasergame y juegos arcade."
    ],
    "nl": [
      "Een warm welkom in een overdekte ontspanningsruimte van 6.000 m2 met puur plezier, uw Champions Five centrum in Bourgoin-Jallieu is de enige plek om uw sportieve wensen de vrije loop te laten.\r\nNieuw: bowling, lasergame en arcadespellen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Champions Five & Champions Strike - Complexe Multisports"
    ]
  },
