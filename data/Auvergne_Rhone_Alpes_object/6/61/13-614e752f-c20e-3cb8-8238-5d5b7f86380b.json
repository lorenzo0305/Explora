  "rdfs:comment": {
    "de": [
      "Kleiner Bauernhof mit Mischkultur und Viehzucht in Tréminis - l'Eglise. Etwa zwanzig Ziegen, sechs Kühe, ein Hühnerhof, ein Garten und Unterkunft \"Accueil Paysan\". Besichtigungen des Ziegenstalls, des Stalls, des Hühnerstalls, des Gartens und der Käserei (mit Verkostung!)."
    ],
    "en": [
      "Small polyculture-breeding farm in Tréminis - l'Eglise. About twenty goats, six cows, a farmyard, a garden and accommodation \"Accueil Paysan\". Visits of the goat house, the stable, the hen house, the garden, the cheese factory (with tasting!)."
    ],
    "it": [
      "Piccola azienda agricola e zootecnica mista a Tréminis - l'Eglise. Una ventina di capre, sei mucche, un'aia, un giardino e un alloggio \"Accueil Paysan\". Visite al caprile, alla stalla, al pollaio, all'orto, al caseificio (con degustazione!)."
    ],
    "fr": [
      "Petite ferme polyculture-élevage à Tréminis - l'Eglise. Une vingtaine de chèvres, six vaches, une basse-cour, un jardin et hébergement « Accueil Paysan ». Visites de la chèvrerie, l'étable, le poulailler, le jardin, la fromagerie (avec dégustation !)."
    ],
    "es": [
      "Pequeña explotación agrícola y ganadera mixta en Tréminis - l'Eglise. Una veintena de cabras, seis vacas, un corral, un jardín y un alojamiento \"Accueil Paysan\". Visitas a la cabrera, el establo, el gallinero, el huerto, la quesería (¡con degustación!)."
    ],
    "nl": [
      "Klein gemengd landbouw- en veeteeltbedrijf in Tréminis - l'Eglise. Een twintigtal geiten, zes koeien, een erf, een tuin en accommodatie \"Accueil Paysan\". Bezoeken aan het geitenhuis, de stal, het kippenhok, de tuin, de kaasmakerij (met proeverij!)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Cris-Cath - Ferme, jardin, basse-cour"
    ]
  },
