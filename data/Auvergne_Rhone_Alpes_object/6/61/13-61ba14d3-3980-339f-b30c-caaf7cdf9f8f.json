  "rdfs:comment": {
    "de": [
      "Die Buvette des Mottets ist ein kleines Stück Paradies am Fuße der majestätischen Drus und oberhalb des Endes des Mer de Glace (1h45), daß von Les Planards (Rodelbahn) oder vom Bauernhof Orthaz aus zu erreichen ist."
    ],
    "en": [
      "The Buvette des Mottets is a cosy corner of paradise facing the majestic Drus, and above the end of the Mer de Glace. You will reach it after 1h45 walk, starting point from  Les Planards (4 seasons sledge), or leaving from the ferme d'Orthaz farm."
    ],
    "it": [
      "La Buvette des Mottets è un piccolo angolo di paradiso situato ai piedi del maestoso Drus, e sopra la fine della Mer de Glace a 1h45, alla partenza di Les Planards (slitte estive), o alla partenza della fattoria di Orthaz."
    ],
    "fr": [
      "La Buvette des Mottets est un petit coin de paradis situé face aux  Drus majestueux, et au-dessus de la langue terminale de la Mer de Glace,  à 1h45 de marche depuis Les Planards (luge 4 saisons), ou depuis la ferme d’Orthaz."
    ],
    "es": [
      "La Buvette des Mottets es un pequeño rincón de paraíso situado al pie del majestuoso Drus, y sobre el final de la Mer de Glace a 1h45, a la salida de Les Planards (trineos de verano), o a la salida de la granja de Orthaz."
    ],
    "nl": [
      "De Buvette des Mottets is een klein paradijselijk hoekje tegenover de majestueuze Drus en boven de eindtong van de Mer de Glace, op 1u45 minuten wandelen van Les Planards (4-seizoenen slee), of van de boerderij Orthaz."
    ]
  },
