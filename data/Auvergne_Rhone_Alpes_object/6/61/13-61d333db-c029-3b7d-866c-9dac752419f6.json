  "rdfs:comment": {
    "de": [
      "Anhand einer Sammlung von 40 Fahrzeugen: Char-à-Bancs, Autobusse, Gelenkbusse, Midibusse, Trolleybusse, Diesel- und Elektromotoren sowie zahlreiche Zubehörteile und Poster stellt das Museum unsere öffentlichen Verkehrsmittel von 1865 bis 2020 vor."
    ],
    "en": [
      "Through a collection of 40 vehicles: char-à-bancs, coaches, buses, articulated buses, midibuses, trolleybuses, diesel and electric engines and numerous accessories and posters, the museum presents our public transport from 1865 to 2020."
    ],
    "it": [
      "Attraverso una collezione di 40 veicoli: char-à-bancs, pullman, autobus, autosnodati, midibus, filobus, motori diesel ed elettrici e numerosi accessori e manifesti, il museo presenta il nostro trasporto pubblico dal 1865 al 2020."
    ],
    "fr": [
      "A travers une  collection de 40 véhicules : char-à-bancs, autocars, autobus, autobus articulés, midibus, trolleybus, de moteurs Diesel et électriques et de nombreux accessoires et posters, le musée présente nos transports en commun de 1865 à 2020."
    ],
    "nl": [
      "Via een collectie van 40 voertuigen: char-à-bancs, touringcars, bussen, gelede bussen, midibussen, trolleybussen, diesel- en elektrische motoren en talrijke accessoires en affiches, presenteert het museum ons openbaar vervoer van 1865 tot 2020."
    ],
    "es": [
      "A través de una colección de 40 vehículos: char-à-bancs, autocares, autobuses, autobuses articulados, midibuses, trolebuses, motores diésel y eléctricos y numerosos accesorios y carteles, el museo presenta nuestro transporte público desde 1865 hasta 2020."
    ]
  },
