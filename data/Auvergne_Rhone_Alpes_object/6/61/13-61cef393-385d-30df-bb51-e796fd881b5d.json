  "rdfs:comment": {
    "de": [
      "Entdecken Sie das einzige und einzigartige Tex-Mex-Restaurant in Valmorel :\r\nCocktails, Steakhouse-Tapas & Tex Mex!\r\nLatino-Atmosphäre, Innenschaukel...warme und festliche Stimmung!"
    ],
    "en": [
      "Discover the one and only Tex-Mex restaurant in Valmorel:\r\nCocktail, tapas steakhouse & Tex Mex ! \r\nLatino atmosphere, indoor swing...warm and festive atmosphere !"
    ],
    "it": [
      "Scoprite l'unico ristorante Tex-Mex di Valmorel:\r\nCocktail, tapas steakhouse e Tex Mex!\r\nAtmosfera latina, swing interno... caldo e festoso!"
    ],
    "fr": [
      "Découvrez le seul et l'unique restaurant Tex-Mex de Valmorel :\r\nCocktails, tapas steakhouse & Tex Mex ! \r\nAtmosphère Latino, balançoire intérieur...ambiance chaleureuse et festive !"
    ],
    "nl": [
      "Ontdek het enige echte Tex-Mex restaurant in Valmorel:\r\nCocktail, tapas steakhouse & Tex Mex ! \r\nLatino sfeer, indoor swing...warme en feestelijke sfeer !"
    ],
    "es": [
      "Descubra el único restaurante Tex-Mex de Valmorel:\r\nCócteles, tapas y Tex Mex\r\nAmbiente latino, columpio interior... ¡cálido y festivo!"
    ]
  },
