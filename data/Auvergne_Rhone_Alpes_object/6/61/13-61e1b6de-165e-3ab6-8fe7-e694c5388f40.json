  "rdfs:comment": {
    "de": [
      "Es dominiert seit dem Mittelalter mit seinen vier Rundtürmen das Ailloux-Tal und beherbergt eine schmackhafte Boutique \"Les gourmandises du château de Péchot\". Außergewöhnliche Sonnenuhr. Informationstafeln zum Verständnis des Ortes und des Schlosses."
    ],
    "en": [
      "The castle of Péchot has dominated the Ailloux valley with its 4 round towers since the Middle Ages. Exceptional sundial. Information panels to understand the place and the castle."
    ],
    "it": [
      "Affacciato sulla valle dell'Ailloux dalle sue 4 torri rotonde fin dal Medioevo, ospita un gustoso negozio \"Les gourmandises du château de Péchot\". Meridiana eccezionale. Pannelli informativi per comprendere il luogo e il castello."
    ],
    "fr": [
      "Dominant la vallée de l'Ailloux de ses 4 tours rondes depuis le Moyen-âge, il abrite une savoureuse boutique \"Les gourmandises du château de Péchot\". Cadran solaire exceptionnel. Panneaux d'informations pour comprendre le lieu et le château."
    ],
    "nl": [
      "Met uitzicht op het dal van de Ailloux vanaf zijn 4 ronde torens sinds de middeleeuwen, herbergt het een smakelijke winkel \"Les gourmandises du château de Péchot\". Uitzonderlijke zonnewijzer. Informatiepanelen om de plaats en het kasteel te begrijpen."
    ],
    "es": [
      "Con vistas al valle de Ailloux desde sus 4 torres redondas desde la Edad Media, alberga una sabrosa tienda \"Les gourmandises du château de Péchot\". Excepcional reloj de sol. Paneles informativos para entender el lugar y el castillo."
    ]
  },
