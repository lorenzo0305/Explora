  "rdfs:comment": {
    "de": [
      "Chez Xuân ist in erster Linie ein lebendiger Ort, an dem das gute Leben an erster Stelle steht und die Küche nach asiatischen Aromen duftet. Hier werden die Teller und das Lächeln geteilt!"
    ],
    "en": [
      "Du Côté de chez Xuân serves freshly prepared Asian style dishes to share in a warm and friendly atmosphere."
    ],
    "it": [
      "Chez Xuân è prima di tutto un luogo vivace dove il buon vivere è al primo posto e la cucina è ricca di sapori asiatici. Qui si condividono piatti e sorrisi!"
    ],
    "fr": [
      "Du côté de chez Xuân, c'est un d'abord un lieu vivant où le bon vivre prime avant tout et la cuisine fleure bon les saveurs d'Asie. Ici les assiettes et les sourires se partagent !"
    ],
    "nl": [
      "Chez Xuân is in de eerste plaats een levendige plek waar goed leven voorop staat en de keuken vol Aziatische smaken zit. Hier worden borden en glimlachen gedeeld!"
    ],
    "es": [
      "Chez Xuân es, ante todo, un lugar animado donde prima la buena vida, y la cocina está llena de los sabores de Asia. Aquí se comparten platos y sonrisas"
    ]
  },
