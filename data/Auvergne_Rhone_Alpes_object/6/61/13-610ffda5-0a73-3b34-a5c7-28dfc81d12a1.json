  "rdfs:comment": {
    "de": [
      "Der Lesepunkt von Merlas bietet Ihnen eine Sprechstunde in den Räumlichkeiten unter dem Rathaus an. Sie können sich im Netzwerk der Bibliotheken des Pays en Voironnais anmelden, Reservierungen abholen oder Ihre Bücher, CDs, DVDs... abgeben."
    ],
    "en": [
      "The Merlas reading center is open to you in the premises beneath the town hall. You can register with the Pays en Voironnais library network, pick up book reservations or drop off your books, CDs, DVDs..."
    ],
    "it": [
      "Il centro di lettura Merlas è aperto tutto il giorno nei locali sotto il municipio. È possibile iscriversi alla rete di biblioteche del Voironnais, prenotare libri o consegnare libri, CD, DVD, ecc."
    ],
    "fr": [
      "Le point lecture de Merlas, vous propose une permanence dans les locaux situés sous la mairie. Vous pouvez vous inscrire au réseau des Bibliothèques du Pays en Voironnais, retirer des réservations ou déposer vos livres, CD, DVD..."
    ],
    "nl": [
      "Het leescentrum Merlas is de hele dag geopend in het gebouw onder het gemeentehuis. Je kunt je er inschrijven bij het Voironnais netwerk van bibliotheken, boeken reserveren of boeken, cd's, dvd's enz. afgeven."
    ],
    "es": [
      "El centro de lectura de Merlas está abierto todo el día en los locales situados bajo el ayuntamiento. Puede inscribirse en la red de bibliotecas de Voironnais, recoger reservas de libros o dejar sus libros, CD, DVD, etc."
    ]
  },
  "rdfs:label": {
