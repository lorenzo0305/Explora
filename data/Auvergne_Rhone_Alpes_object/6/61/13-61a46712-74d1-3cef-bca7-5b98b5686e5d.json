  "rdfs:comment": {
    "de": [
      "Ein leidenschaftlicher Koch, der sich in der Auvergne, insbesondere in der Region Ancizes-Comps, niedergelassen hat.\r\nDas Team freut sich darauf, Ihr Essen zu einem maßgeschneiderten Erlebnis zu machen."
    ],
    "en": [
      "A passionate chef based in Auvergne, particularly in the Ancizes-Comps area.\r\nThe team will be delighted to tailor your meal to your specific requirements."
    ],
    "it": [
      "Un cuoco appassionato con sede in Alvernia, in particolare nella zona di Les Ancizes-Comps.\r\nIl team sarà lieto di rendere il vostro pasto un evento \"su misura\"."
    ],
    "fr": [
      "Un cuisinier passionné installé en Auvergne notamment sur le secteur des Ancizes-Comps. \r\nL'équipe se fera un plaisir de faire de votre repas un évènement \"sur-mesure\"."
    ],
    "es": [
      "Un chef apasionado afincado en Auvernia, concretamente en la zona de Les Ancizes-Comps.\r\nEl equipo estará encantado de hacer de su comida un acontecimiento \"a medida\"."
    ],
    "nl": [
      "Een gepassioneerde chef-kok uit de Auvergne, met name uit de streek Les Ancizes-Comps.\r\nHet team maakt van uw maaltijd graag een gebeurtenis \"op maat\"."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Double M"
    ]
  },
