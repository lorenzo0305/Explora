  "rdfs:comment": {
    "de": [
      "Die städtische Biblothek funktioniert dank ihrer ehrenamtlichen Mitarbeiter. Sie ist ein Ort des kulturellen Lebens, der allen offen steht. Die Sammlungen werden entsprechend den Wünschen ihrer Leser erweitert."
    ],
    "en": [
      "The municipal library is run by volunteers. It is a place of cultural life open to all. The collections are enriched according to the desires of its readers."
    ],
    "it": [
      "La biblioteca comunale è gestita da volontari. È un luogo di vita culturale aperto a tutti. Le collezioni si arricchiscono in base ai desideri dei lettori."
    ],
    "fr": [
      "La Biblothèque municipale fonctionne grâce à ses bénévoles. C'est un lieu de vie culturel ouvert à tous. Les collections s'enrichissent selon les désirs de ses lecteurs."
    ],
    "es": [
      "La biblioteca municipal está gestionada por voluntarios. Es un lugar de vida cultural abierto a todos. Las colecciones se enriquecen según los deseos de sus lectores."
    ],
    "nl": [
      "De gemeentelijke bibliotheek wordt gerund door vrijwilligers. Het is een plaats van cultureel leven die voor iedereen toegankelijk is. De collecties worden verrijkt volgens de wensen van de lezers."
    ]
  },
