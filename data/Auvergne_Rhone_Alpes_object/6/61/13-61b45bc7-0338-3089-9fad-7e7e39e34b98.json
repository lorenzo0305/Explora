  "rdfs:comment": {
    "de": [
      "Begleitete Besichtigung: Dokument verfügbar. Die Kirche aus dem 11., 12. und 17. Jahrhundert hat kein Querschiff, sondern ein langes Schiff mit fünf Jochen, das von zwei Seitenschiffen flankiert wird."
    ],
    "en": [
      "Accompanied visit: document available. The church of the 11th, 12th and 17th centuries has no transept but a long ship of five bays flanked by two side aisles."
    ],
    "it": [
      "Visita guidata: documento disponibile. La chiesa, risalente all'XI, XII e XVII secolo, non ha il transetto ma una lunga navata a cinque campate affiancata da due navate laterali."
    ],
    "fr": [
      "Visite accompagnée : document disponible. L'église des XIe, XIIe et XVIIe siècles ne possède pas de transept mais un long vaisseau de cinq travées que flanquent deux collatéraux."
    ],
    "es": [
      "Visita guiada: documento disponible. La iglesia de los siglos XI, XII y XVII no tiene crucero, sino una larga nave de cinco tramos flanqueada por dos naves."
    ],
    "nl": [
      "Rondleiding: document beschikbaar. De kerk uit de 11e, 12e en 17e eeuw heeft geen dwarsschip, maar een lang schip met vijf traveeën, geflankeerd door twee zijbeuken."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Église Sainte-Anne"
    ]
  },
