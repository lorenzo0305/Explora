  "rdfs:comment": {
    "de": [
      "Neu: Mieten Sie unsere Aktivitäten bei Ihnen zu Hause, billiger!\r\nOder Vor Ort mit einem Animateur: Entspannungsbereich mit überdachtem Picknick- und Grillplatz, Zuschauerbereiche.\r\nAktivitäten für Erwachsene/Kinder: Hüpfburgen, Orbeez, Archery tag, Paintball..."
    ],
    "en": [
      "New: rent our activities at home for less!\r\nOr On site with an activity leader: covered picnic and barbecue area, spectator areas.\r\nActivities for adults and children: inflatables, Orbeez, archery tag, paintball..."
    ],
    "it": [
      "Novità: noleggiate le nostre attività a casa vostra a un prezzo inferiore!\r\nOppure in loco con un animatore: area relax con picnic e barbecue coperto, aree per gli spettatori.\r\nAttività per adulti e bambini: strutture gonfiabili, Orbeez, tiro con l'arco, paintball..."
    ],
    "fr": [
      "Nouveauté : louez nos activités chez vous, moins cher !\r\nOu Sur place avec un animateur : zone détente avec pique-nique et barbecue couverts, espaces spectateurs.\r\nActivités adultes/enfants : structures gonflables, Orbeez, archery tag, paintball..."
    ],
    "es": [
      "Novedad: ¡alquile nuestras actividades en casa por menos!\r\nO in situ con un animador: zona de descanso con picnic y barbacoa cubierta, zonas para espectadores.\r\nActividades para adultos y niños: estructuras hinchables, Orbeez, tiro con arco, paintball..."
    ],
    "nl": [
      "Nieuw: huur onze activiteiten goedkoper thuis!\r\nOf ter plaatse met een animator: ontspanningsruimte met picknick en overdekte barbecue, toeschouwerruimtes.\r\nActiviteiten voor volwassenen en kinderen: opblaasbare structuren, Orbeez, boogschieten, paintball..."
    ]
  },
