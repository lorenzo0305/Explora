  "rdfs:comment": {
    "de": [
      "Herstellung von handgefertigten Schmuckstücken und Objekten aus Makramee am Ufer des Violon in Menet.\r\nKreationen zu finden in der Boutique des Office de Tourisme in Riom-ès-Montagnes."
    ],
    "en": [
      "Creation of handmade macramé jewelry and objects on the banks of the Violon river in Menet.\r\nAvailable at the Tourist Office store in Riom-ès-Montagnes."
    ],
    "it": [
      "Creazione di gioielli e oggetti in macramè fatti a mano sulle rive del fiume Violon a Menet.\r\nLe sue creazioni si trovano nel negozio dell'Ufficio del Turismo di Riom-ès-Montagnes."
    ],
    "fr": [
      "Création de bijoux et objets en macramé, fabriqués main, au bord du Violon à Menet. \r\nCréations à retrouver à la boutique de l'Office de Tourisme à Riom-ès-Montagnes."
    ],
    "nl": [
      "Creatie van handgemaakte macramé sieraden en objecten aan de oevers van de rivier de Violon in Menet.\r\nJe vindt haar creaties in de winkel van het Office du Tourisme in Riom-ès-Montagnes."
    ],
    "es": [
      "Creación de joyas y objetos de macramé artesanal a orillas del río Violon, en Menet.\r\nEncontrará sus creaciones en la tienda de la Oficina de Turismo de Riom-ès-Montagnes."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Au Fil du Violon"
    ]
  },
