  "rdfs:comment": {
    "de": [
      "Wochenende der offenen Tür: mit Medaillen ausgezeichnete Bioweine Côtes du Rhône. Besuch und Verkostung mit Führung.\r\nTeller mit Landessen: 20? (Reservierung empfohlen)."
    ],
    "en": [
      "Open house weekend: Côtes du Rhône medal-winning organic wines. Guided tour and tasting.\r\nCountry-style meal: 20? (reservation recommended)."
    ],
    "it": [
      "Fine settimana di apertura: vini biologici premiati con medaglie Côtes du Rhône. Visita guidata e degustazione.\r\nCena in stile rustico: 20 € (si consiglia la prenotazione)."
    ],
    "fr": [
      "Week-end portes-ouvertes : vins bio médaillés Côtes du Rhône. Visite et dégustation commentée.\r\nAssiette repas de campagne : 20€ (réservation conseillée)."
    ],
    "nl": [
      "Open huis weekend: Côtes du Rhône medaillewinnende biologische wijnen. Rondleiding en proeverij.\r\nLandelijke maaltijd: €20 (reserveren aanbevolen)."
    ],
    "es": [
      "Fin de semana de puertas abiertas: vinos ecológicos ganadores de medallas Côtes du Rhône. Visita guiada y degustación.\r\nComida campestre: 20 € (se recomienda reservar)."
    ]
  },
