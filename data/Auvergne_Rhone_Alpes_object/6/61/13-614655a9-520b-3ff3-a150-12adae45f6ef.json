  "rdfs:comment": {
    "de": [
      "Eine familiäre Atmosphäre. Unser Ziel ist es, Ihren Aufenthalt zu einem unvergesslichen Erlebnis zu machen, indem wir unsere Leidenschaft für die Berge mit Ihnen teilen."
    ],
    "en": [
      "Family atmosphere. Our ambition: to make your stay an unforgettable experience by sharing our passion for the mountains."
    ],
    "it": [
      "Atmosfera familiare. La nostra ambizione è quella di rendere il vostro soggiorno un'esperienza indimenticabile, condividendo con voi la nostra passione per la montagna."
    ],
    "fr": [
      "Ambiance familiale. Notre ambition: faire de votre séjour une expérience inoubliable en vous faisant partager notre passion de la montagne."
    ],
    "nl": [
      "Familiale sfeer. Het is onze ambitie om van je verblijf een onvergetelijke ervaring te maken door onze passie voor de bergen met je te delen."
    ],
    "es": [
      "Ambiente familiar. Nuestra ambición es hacer de su estancia una experiencia inolvidable compartiendo con usted nuestra pasión por la montaña."
    ]
