  "rdfs:comment": {
    "de": [
      "Der Chefkoch Grégoire Penelon bietet Ihnen Tagesgerichte, Formeln und Menüs, die Professionalität, Aromen von anderswo, frische, lokale und überwiegend biologische Produkte miteinander verbinden. Dieses Lokal wurde von der Marke \"Goûtez l'Ardèche\" (Schmecken Sie die Ardèche) ausgewählt."
    ],
    "en": [
      "Chef Grégoire Penelon offers daily specials, formulas and menus, combining professionalism, flavors from elsewhere, fresh, local and mostly organic products. This establishment is selected by the Goûtez l'Ardèche brand."
    ],
    "it": [
      "Lo chef Grégoire Penelon propone specialità, formule e menu giornalieri, combinando professionalità, sapori d'altrove, prodotti freschi, locali e per lo più biologici. Questo stabilimento è stato selezionato dal marchio Goûtez l'Ardèche."
    ],
    "fr": [
      "Le chef Grégoire Penelon vous propose des plats du jour, des formules et des menus, alliant professionnalisme, saveurs d’ailleurs, produits frais, locaux et majoritairement Bio. Cet établissement est sélectionné par la marque Goûtez l'Ardèche."
    ],
    "es": [
      "El chef Grégoire Penelon propone especialidades, fórmulas y menús diarios que combinan profesionalidad, sabores de otros lugares, productos frescos, locales y, en su mayoría, ecológicos. Este establecimiento ha sido seleccionado por la marca Goûtez l'Ardèche."
    ],
    "nl": [
      "Chef Grégoire Penelon biedt dagelijkse specials, formules en menu's, die professionaliteit, smaken van elders, verse, lokale en meestal biologische producten combineren. Dit etablissement is geselecteerd door het merk Goûtez l'Ardèche."
    ]
  },
