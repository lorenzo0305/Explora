  "rdfs:comment": {
    "de": [
      "Das Ökomuseum Moulinage de Chirols liegt inmitten einer üppigen grünen Umgebung und lässt Sie in die Geschichte des Seidengarns eintauchen. Entdecken Sie einen szenografischen Rundgang durch dieses uralte Know-how. Führungen auf eigene Faust von Montag bis Donnerstag, kostenlose Audioguides. Gruppen nach vorheriger Absprache."
    ],
    "en": [
      "Set in lush green surroundings, the Moulinage de Chirols eco-museum plunges you into the history of silk thread. Discover a scenographic tour of this ancestral know-how. Self-guided tours Monday to Thursday, free audio guides. Groups by prior arrangement."
    ],
    "it": [
      "Immerso in un ambiente verdeggiante, l'eco-museo Moulinage de Chirols vi immerge nella storia del filo di seta. Scoprite un percorso scenografico di questo sapere ancestrale. Aperto dal lunedì al giovedì, audioguide gratuite. Gruppi su prenotazione."
    ],
    "fr": [
      "Dans un cadre verdoyant, l’écomusée du Moulinage de Chirols vous plonge dans l’histoire du fil de soie. Découvrez un parcours scénographié  sur ce savoir-faire ancestral. Visites libres du lundi au jeudi, audioguides gratuits. Groupes, sur réservation."
    ],
    "es": [
      "Situado en un entorno verde, el ecomuseo Moulinage de Chirols le sumerge en la historia del hilo de seda. Descubra un recorrido escenográfico de este saber hacer ancestral. Abierto de lunes a jueves, audioguías gratuitas. Grupos previa concertación."
    ],
    "nl": [
      "In een groene omgeving dompelt het eco-museum Moulinage de Chirols je onder in de geschiedenis van de zijdedraad. Ontdek een scenografisch bezoek aan deze voorouderlijke knowhow. Open van maandag tot donderdag, gratis audiogidsen. Groepen op afspraak."
    ]
  },
  "rdfs:label": {
