  "rdfs:comment": {
    "de": [
      "Handwerksmeister für Kunstschmiedearbeiten.\r\nKreation.\r\nSkulpturen Allianz Stahl, Kupfer, Messing. Einzigartige Stücke.\r\nBesichtigung nach Vereinbarung möglich.\r\nPräsenz auf verschiedenen Messen und Ausstellungen in der Region."
    ],
    "en": [
      "Master craftsman in wrought iron.\r\nCreation.\r\nSteel, copper and brass alliance sculptures. Unique pieces.\r\nVisits by appointment.\r\nPresent at various shows and exhibitions in the region."
    ],
    "it": [
      "Maestro artigiano della lavorazione del ferro.\r\nCreazione.\r\nSculture in acciaio, rame e ottone. Pezzi unici.\r\nPossibilità di visita su appuntamento.\r\nPresenza in varie fiere e mostre della regione."
    ],
    "fr": [
      "Maître artisan en ferronnerie d'art.\r\nCréation.\r\nSculptures alliance acier, cuivre, laiton. Pièces uniques.\r\nPossibilité de visite sur RDV.\r\nPrésence sur différents salons et expositions de la région."
    ],
    "nl": [
      "Meester in ijzerwerk.\r\nCreatie.\r\nSculpturen in staal, koper en messing. Unieke stukken.\r\nMogelijkheid tot bezoek op afspraak.\r\nAanwezigheid op diverse beurzen en tentoonstellingen in de regio."
    ],
    "es": [
      "Maestro artesano del hierro.\r\nCreación.\r\nEsculturas de alianza de acero, cobre y latón. Piezas únicas.\r\nPosibilidad de visita con cita previa.\r\nPresencia en diversas ferias y exposiciones de la región."
    ]
  },
