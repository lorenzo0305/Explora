  "rdfs:comment": {
    "de": [
      "Le Lieu ist das Restaurant, das Ihnen ein Lächeln ins Gesicht zaubert...\r\nEine kreative bistronomische Küche mit frischen, gesunden und lokalen Produkten, eine warme und farbenfrohe Atmosphäre, ein fröhlicher und wohlwollender Empfang... Hier ist Begeisterung das Schlüsselwort."
    ],
    "en": [
      "Le Lieu is the restaurant that puts a smile on your face...\r\nCreative bistronomic cuisine using fresh, healthy, local produce, a warm, colourful atmosphere and a cheerful, friendly welcome... Enthusiasm is the watchword here."
    ],
    "it": [
      "Le Lieu è il ristorante che ti fa sorridere...\r\nUna cucina bistronomica creativa con prodotti freschi, sani e locali, un'atmosfera calda e colorata, un'accoglienza allegra e cordiale... Qui la parola d'ordine è entusiasmo."
    ],
    "fr": [
      "Le Lieu est le restaurant qui vous donne le sourire...\r\nUne cuisine bistronomique créative avec des produits frais, sains et locaux, une ambiance chaleureuse et colorée, un accueil gai et bienveillant... Ici enthousiasme est le mot d'ordre."
    ],
    "nl": [
      "Le Lieu is het restaurant dat je doet glimlachen...\r\nEen creatieve bistronomische keuken met verse, gezonde en lokale producten, een warme en kleurrijke sfeer, een vrolijk en vriendelijk onthaal... Hier is enthousiasme het sleutelwoord."
    ],
    "es": [
      "Le Lieu es el restaurante que te hace sonreír...\r\nUna cocina bistronómica creativa con productos frescos, sanos y locales, un ambiente cálido y colorido, una acogida alegre y amistosa... Aquí el entusiasmo es la consigna."
    ]
  },
