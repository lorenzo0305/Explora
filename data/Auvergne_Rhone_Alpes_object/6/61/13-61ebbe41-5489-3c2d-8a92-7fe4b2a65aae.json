  "rdfs:comment": {
    "de": [
      "Willkommen in der Auberge Ô Sains Sires. Ein traditionelles Restaurant mit Fröschen als Spezialität. Die Herberge verfügt über einen Barbereich, Tabak und Spiele. Organisation von Themenabenden."
    ],
    "en": [
      "Welcome to the Ô Sains Sires inn. A traditional restaurant specializing in frogs. The inn has a bar, tobacconist, games area... Organization of theme evenings."
    ],
    "it": [
      "Benvenuti alla locanda Ô Sains Sires. Un ristorante tradizionale specializzato in rane. La locanda dispone di bar, tabaccheria, area giochi... Organizzazione di serate a tema."
    ],
    "fr": [
      "Bienvenue à l'auberge Ô Sains Sires. Une restauration traditionnelle avec en spécialité des grenouilles. L'auberge a un espace bar, tabac, jeux... Organisation de soirées à thème."
    ],
    "nl": [
      "Welkom in de herberg Ô Sains Sires. Een traditioneel restaurant gespecialiseerd in kikkers. De herberg heeft een bar, tabakswinkel, speelruimte... Organisatie van thema-avonden."
    ],
    "es": [
      "Bienvenido a la posada Ô Sains Sires. Restaurante tradicional especializado en ranas. La posada dispone de bar, estanco, zona de juegos... Organización de veladas temáticas."
    ]
  },
