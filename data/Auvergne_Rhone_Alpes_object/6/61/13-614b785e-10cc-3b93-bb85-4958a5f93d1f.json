  "rdfs:comment": {
    "de": [
      "Das Restaurant le Taconet bietet eine familiäre und traditionelle Küche. Sie finden hier eine Speisekarte und regionale Spezialitäten.\r\nDas Restaurant verfügt über eine Terrasse mit Blick auf die Bergkette des Mont Blanc."
    ],
    "en": [
      "Le Taconet restaurant serves traditional family cuisine. The menu features regional specialities.\r\nThe restaurant has a terrace overlooking the Mont Blanc range."
    ],
    "it": [
      "Il ristorante Le Taconet propone una cucina tradizionale familiare. Il menu presenta specialità regionali.\r\nIl ristorante dispone di una terrazza affacciata sulla catena del Monte Bianco."
    ],
    "fr": [
      "Le restaurant le Taconet propose une cuisine familiale et traditionnelle. Vous y trouverez une carte et des spécialités régionales.\r\nLe restaurant dispose d'une terrasse face à la chaîne du Mont Blanc."
    ],
    "nl": [
      "Restaurant Le Taconet serveert traditionele familiegerechten. Op het menu staan regionale specialiteiten.\r\nHet restaurant heeft een terras met uitzicht op de Mont Blanc-keten."
    ],
    "es": [
      "El restaurante Le Taconet sirve cocina familiar tradicional. El menú incluye especialidades regionales.\r\nEl restaurante tiene una terraza con vistas a la cadena del Mont Blanc."
    ]
  },
