  "rdfs:comment": {
    "de": [
      "Arvan évasion bietet Betreuung beim Klettern, in der Felswand oder auf langen Routen, in der Via Ferrata oder beim Canyoning. Sein Team besteht aus begeisterten Fachleuten, die jeden Ausflug wohlwollend betreuen, in einer freundlichen und sicheren Atmosphäre."
    ],
    "en": [
      "Arvan évasion offers rock climbing, via-ferrata, canyoning and big-pitch climbing. Our team is made up of passionate professionals, who supervise each outing in a friendly, safe atmosphere."
    ],
    "it": [
      "Arvan évasion offre arrampicata su roccia, via ferrata e canyoning. Il team è composto da professionisti appassionati che supervisionano ogni uscita in un'atmosfera amichevole e sicura."
    ],
    "fr": [
      "Arvan évasion propose un encadrement en escalade, en falaise ou en grande voie, en via-ferrata ou en canyoning. Son équipe est composée de professionnels passionnés qui encadrent chaque sortie avec bienveillance, dans une ambiance conviviale et sécurisée."
    ],
    "es": [
      "Arvan évasion ofrece escalada en roca, vías ferratas y barranquismo. El equipo está formado por profesionales apasionados que supervisan cada salida en un ambiente agradable y seguro."
    ],
    "nl": [
      "Arvan évasion biedt rotsklimmen, klettersteigen en canyoning. Het team bestaat uit gepassioneerde professionals die elk uitstapje begeleiden in een vriendelijke, veilige sfeer."
    ]
  },
