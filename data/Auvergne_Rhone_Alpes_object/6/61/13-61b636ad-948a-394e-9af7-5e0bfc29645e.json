  "rdfs:comment": {
    "de": [
      "Der Caveau des Tontons bietet seinen Gästen ein umfassendes kulinarisches Erlebnis, indem er eine hochwertige traditionelle Küche anbietet, die Produkte aus Land und Meer in den Vordergrund stellt und in einer warmen und freundlichen Atmosphäre serviert wird."
    ],
    "en": [
      "Le Caveau des Tontons offers its customers a complete culinary experience, with traditional, high-quality cuisine featuring products from the land and sea, all in a warm, friendly atmosphere."
    ],
    "it": [
      "Il Caveau des Tontons offre ai suoi clienti un'esperienza culinaria completa, con una cucina tradizionale e di alta qualità con prodotti della terra e del mare, il tutto in un'atmosfera calda e accogliente."
    ],
    "fr": [
      "Le Caveau des Tontons offre à ses clients une expérience culinaire complète en proposant une cuisine traditionnelle de qualité, mettant en avant des produits de la terre et de la mer, le tout dans une atmosphère chaleureuse et conviviale."
    ],
    "es": [
      "El Caveau des Tontons ofrece a sus clientes una experiencia culinaria completa, con una cocina tradicional de alta calidad elaborada con productos de la tierra y del mar, todo ello en un ambiente cálido y acogedor."
    ],
    "nl": [
      "De Caveau des Tontons biedt haar klanten een complete culinaire ervaring, met traditionele gerechten van hoge kwaliteit met producten van het land en de zee, en dat alles in een warme, vriendelijke sfeer."
    ]
  },
  "rdfs:label": {
