  "rdfs:comment": {
    "de": [
      "Das Rond de Carotte ist ein Kellerrestaurant, das Brunch, Mittagessen und Kaffee wie in einem Coffeeshop anbietet! In der Weinhandlung finden Sie über 500 verschiedene Weine (biologisch, biodynamisch und naturbelassen). Am Wochenende ist auch ein Abendessen möglich."
    ],
    "en": [
      "Le Rond de Carotte, a restaurant-wine cellar, coffee shop style, serves brunch, lunch and drinks. Discover more than 500 different wines. Dinner served at weekends."
    ],
    "it": [
      "Le Rond de Carotte è un ristorante-caverna che serve brunch, pranzi e caffè proprio come un coffee-shop! C'è anche un'enoteca dove si possono scoprire oltre 500 vini diversi (biologici, biodinamici e naturali). La cena è disponibile nei fine settimana."
    ],
    "fr": [
      "Le Rond de Carotte est un restau-cave qui propose des brunch, des déjeuners et des cafés comme au coffee-shop! Un espace caviste vous permet de découvrir plus de 500 références de vins (bios, biodynamiques et natures). Le diner est possible le week-end."
    ],
    "nl": [
      "Le Rond de Carotte is een restau-cave die brunch, lunch en koffie serveert, net als een koffiehuis! Er is ook een wijnwinkel waar je meer dan 500 verschillende wijnen (biologisch, biodynamisch en natuurlijk) kunt ontdekken. In het weekend kun je er dineren."
    ],
    "es": [
      "Le Rond de Carotte es un restaurante-cafetería que sirve brunch, almuerzos y café como si fuera una cafetería. También hay una tienda de vinos donde podrá descubrir más de 500 vinos diferentes (ecológicos, biodinámicos y naturales). Los fines de semana se puede cenar."
    ]
  },
