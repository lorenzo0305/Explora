  "rdfs:comment": {
    "de": [
      "Verleih und Verkauf von Ausrüstung (Skier, Snowboards, Schneeschuhe). In der Boutique finden Sie eine Auswahl an Ski-, Berg- und Lifestylebekleidung, damit Sie sich auf den Pisten und im Skigebiet wohlfühlen. Reparaturen und Wartung. Schließfächer für Skier."
    ],
    "en": [
      "Rental and sale of equipment (skis, snowboards, snowshoes). In the boutique, a selection of ski, mountain and lifestyle clothing to keep you comfortable on the slopes and in the resort. Repairs and maintenance. Ski lockers."
    ],
    "it": [
      "Noleggio e vendita di attrezzature (sci, snowboard, racchette da neve). Nel negozio, una selezione di abbigliamento da sci, da montagna e lifestyle per sentirsi a proprio agio sulle piste e nella località. Riparazioni e manutenzione. Armadietti per gli sci."
    ],
    "fr": [
      "Location et vente de matériel (skis, snowboards, raquettes). Côté boutique, une sélection de vêtements de ski, de montagne et lifestyle pour être à l’aise sur les pistes comme en station. Réparations et entretien. Casiers à skis."
    ],
    "nl": [
      "Verhuur en verkoop van materiaal (ski's, snowboards, sneeuwschoenen). In de winkel, een selectie van ski, berg en lifestyle kleding om je comfortabel te houden op de pistes en in het resort. Reparatie en onderhoud. Skilockers."
    ],
    "es": [
      "Alquiler y venta de material (esquís, snowboards, raquetas de nieve). En la tienda, una selección de ropa de esquí, montaña y estilo de vida para mantenerse cómodo en las pistas y en la estación. Reparaciones y mantenimiento. Guardaesquís."
    ]
  },
  "rdfs:label": {
