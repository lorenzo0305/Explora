  "rdfs:comment": {
    "de": [
      "Willkommen in unserem Lyoner Bistro im Stadtzentrum von Roanne! Entdecken Sie zahlreiche Lyoner Spezialitäten: Kalbskopf, Sapeurschürze, Hechtklößchen. Hühnerfrösche im Sommer. Imbiss am Morgen auf Reservierung."
    ],
    "en": [
      "Welcome to our Lyonnais bistro in downtown Roanne! Discover many Lyonnais specialties: tête de veau, tablier de sapeur, quenelle de brochet. Chicken frogs in summer. Morning snacks on reservation."
    ],
    "it": [
      "Benvenuti nel nostro bistrot lionese nel centro di Roanne! Scoprite le numerose specialità di Lione: tête de veau, tablier de sapeur, quenelle de brochet. Rane di pollo in estate. Spuntini mattutini su prenotazione."
    ],
    "fr": [
      "Bienvenue dans notre bistrot lyonnais en centre-ville de Roanne ! Découvertes de nombreuses spécialités lyonnaises : tête de veau, tablier de sapeur, quenelle de brochet. Grenouilles de poulet en été. Casse-croûte du matin sur réservation."
    ],
    "nl": [
      "Welkom in onze bistro Lyonnais in het centrum van Roanne! Ontdek de vele specialiteiten van Lyon: tête de veau, tablier de sapeur, quenelle de brochet. Kippenkikkers in de zomer. Ochtendhapjes op reservering."
    ],
    "es": [
      "Bienvenido a nuestro bistró lionés en el centro de Roanne Descubra las numerosas especialidades lionesas: tête de veau, tablier de sapeur, quenelle de brochet. Ranas de pollo en verano. Aperitivos matinales previa reserva."
    ]
  },
  "rdfs:label": {
