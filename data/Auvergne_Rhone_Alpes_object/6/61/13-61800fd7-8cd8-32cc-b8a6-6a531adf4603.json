  "rdfs:comment": {
    "de": [
      "Dieses Museum zeigt die Geschichte von Moûtiers und der Tarentaise von der Vorgeschichte bis zum 19. Jahrhundert: das Alltagsleben in der Römerzeit, die Rolle der Stadt als Sitz eines Erzbistums, als Provinzhauptstadt und als aktiver Knotenpunkt mit den königlichen Salinen und der Bergbauschule."
    ],
    "en": [
      "This museum traces the history of Moûtiers and Tarentaise, from Prehistory to the 19th century: everyday life in Roman times, role of the city, seat of an archdiocese, provincial capital, active crossroads with the Royal Saltworks and the mining School."
    ],
    "it": [
      "La storia di Moûtiers e della Tarantasia, dalla protostoria al XIX secolo: la vita quotidiana all'epoca romana e il ruolo della cittadella, sede di un arcivescovado, capitale provinciale e importante centro con le sue saline e l'effimero politecnico."
    ],
    "fr": [
      "Ce musée retrace l'histoire de Moûtiers et de la Tarentaise, de la Préhistoire au 19è s : vie quotidienne à l'époque romaine, rôle de la cité, siège d'un archevêché, capitale provinciale, carrefour actif avec les Salines Royales et l'école des mines."
    ],
    "es": [
      "Este museo recorre la historia de Moûtiers y de la región de la Tarentaise, desde la prehistoria hasta el siglo XIX: la vida cotidiana en la época romana, el papel de la ciudad, sede de un arzobispado, capital de provincia, encrucijada activa con las Reales Salinas y la escuela minera."
    ],
    "nl": [
      "Dit museum schetst de geschiedenis van Moûtiers en de Tarentaise regio, van de prehistorie tot de 19e eeuw: het dagelijks leven in de Romeinse tijd, de rol van de stad, zetel van een aartsbisdom, provinciehoofdstad, actief kruispunt met de Koninklijke zoutziederij en de mijnschool."
    ]
  },
