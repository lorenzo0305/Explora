  "rdfs:comment": {
    "de": [
      "Trailrun über die schönsten Wege des Departements Ain. Viel mehr als ein Rennen: eine echte Herausforderung, ein Test der Widerstandsfähigkeit, des Mutes und der Leidenschaft. Der Tiger Balm Ultra 01 bringt Läufer aus aller Welt zusammen, die bereit sind, ihre Grenzen zu erweitern."
    ],
    "en": [
      "Trail race along the most beautiful paths in the Ain. Much more than a race: a real challenge, a test of resilience, courage and passion. The Tiger Balm Ultra 01 brings together runners from all horizons, ready to push back their limits."
    ],
    "it": [
      "Una gara di trail lungo i più bei sentieri dell'Ain. Molto più di una semplice gara: una vera sfida, una prova di resilienza, coraggio e passione. La Tiger Balm Ultra 01 riunisce corridori di tutti gli orizzonti, pronti a superare i propri limiti."
    ],
    "fr": [
      "Course de trail par les plus beaux sentiers de l'Ain. Bien plus qu’une course : un véritable défi, un test de résilience, de courage et de passion. Le Tiger Balm Ultra 01 rassemble des coureurs venus de tous horizons, prêts à repousser leurs limites."
    ],
    "es": [
      "Una carrera de trail por los senderos más bellos de Ain. Mucho más que una carrera: un auténtico desafío, una prueba de resistencia, coraje y pasión. La Tiger Balm Ultra 01 reúne a corredores de todos los horizontes, dispuestos a superar sus límites."
    ],
    "nl": [
      "Een trailrace over de mooiste paden van de Ain. Veel meer dan zomaar een race: een echte uitdaging, een test van veerkracht, moed en passie. De Tiger Balm Ultra 01 brengt lopers van alle horizonten samen, klaar om hun grenzen te verleggen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ultra 01 Tiger Balm"
    ]
  },
