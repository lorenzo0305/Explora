  "rdfs:comment": {
    "de": [
      "Tagungsraum mit einer Fläche von 70m². Maximale Aufnahmekapazität: 60 sitzende Personen. Der Raum kann allein oder als Ergänzung zum Festsaal gemietet werden.\r\n\r\nZielgruppe: Vereine / Unternehmen / Öffentliche Verwaltungen"
    ],
    "en": [
      "70m² meeting room. Maximum capacity: 60 people seated. The room can be rented on its own or in addition to the village hall.\r\n\r\nIntended for: Associations / Companies / Public authorities"
    ],
    "it": [
      "Sala riunioni di 70 m². Capacità massima: 60 persone sedute. La sala può essere affittata da sola o in aggiunta alla sala del villaggio.\r\n\r\nDestinatari: Associazioni / Aziende / Enti pubblici"
    ],
    "fr": [
      "Salle de réunion de 70m². Capacité maximale d'accueil : 60 personnes assises. La salle peut être louée seule ou en complément de la salle des fêtes. \r\n\r\nPublic concerné : Associations / Entreprises / Administrations publiques"
    ],
    "nl": [
