  "rdfs:comment": {
    "de": [
      "Besuchen Sie unsere Farm und lernen Sie die Rentiere kennen! Sie können sie mit Flechten füttern und anschließend eine \"hausgemachte\" Kostprobe in der finnischen Kota genießen.\r\nNur nach vorheriger Reservierung. Privatisierung möglich."
    ],
    "en": [
      "Visit our farm and meet the reindeer in their park.\r\nYou can feed them with lichen and then enjoy a \"homemade\" snack in the Finnisk kota."
    ],
    "it": [
      "Visita la nostra fattoria e incontra le renne nel loro parco.\r\nPuoi dar loro da mangiare con licheni e poi goderti uno spuntino \"fatto in casa\" in finlandese kota."
    ],
    "fr": [
      "Visitez notre élevage et partez à la rencontre des rennes ! Vous pourrez les nourrir avec du lichen puis goûter « maison » dans le kota finlandais.\r\nUniquement sur réservation. Privatisation possible."
    ],
    "es": [
      "Visita nuestra granja de renos y conoce a los renos Podrás darles de comer liquen y luego disfrutar de un tentempié casero en la kota finlandesa.\r\nEs necesario reservar. Posibilidad de privatización."
    ],
    "nl": [
      "Bezoek onze rendierboerderij en ontmoet de rendieren! Je kunt ze korstmossen voeren en daarna genieten van een zelfgemaakte snack in de Finse kota.\r\nReserveren verplicht. Privatisering mogelijk."
    ]
  },
