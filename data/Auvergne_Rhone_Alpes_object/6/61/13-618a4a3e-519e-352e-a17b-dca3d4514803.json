  "rdfs:comment": {
    "de": [
      "Die Muséobar lädt Sie dazu ein, in den Straßen von Modane in den 1930er Jahren Ermittlungen anzustellen.\r\nLaden Sie die kostenlose Baludik-App herunter, orten Sie Ihren Standort und folgen Sie den Anweisungen."
    ],
    "en": [
      "The Museobar invites you to investigate the streets of Modane in the 1930s.\r\nDownload the free Baludik app, geolocate yourself and follow the instructions."
    ],
    "it": [
      "Il Museobar vi invita a indagare nelle strade di Modane negli anni Trenta.\r\nScaricate l'applicazione gratuita Baludik, localizzatevi e seguite le istruzioni."
    ],
    "fr": [
      "Le Muséobar vous invite à mener l'enquête dans les rues de Modane des années 30.\r\nTéléchargez gratuitement l'application Baludik, géolocalisez-vous et suivez les instructions."
    ],
    "es": [
      "El Museobar le invita a investigar las calles de Modane en los años treinta.\r\nDescarga la aplicación gratuita Baludik, sitúate y sigue las instrucciones."
    ],
    "nl": [
      "De Museobar nodigt je uit om de straten van Modane in de jaren 1930 te onderzoeken.\r\nDownload de gratis applicatie Baludik, zoek jezelf op en volg de instructies."
    ]
  },
  "rdfs:label": {
    "en": [
      "Treasure hunt \"Coup de feu à Modane\""
    ],
    "fr": [
      "Jeu de piste \"Coup de feu à Modane\""
    ],
    "nl": [
      "Schattenjacht  \"Coup de feu à Modane\""
    ]
  },
