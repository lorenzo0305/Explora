  "rdfs:comment": {
    "de": [
      "Entdecken Sie eine Vielzahl außergewöhnlicher Rassemeerschweinchen: Shelty, Texel, Peruaner, Alpaka, Lunkarya, Abessinier, Rex und viele andere! Meerschweinchen-Börse und Aussteller-Stände für alle Liebhaber."
    ],
    "en": [
      "Discover a multitude of exceptional pedigree guinea pigs: Shelty, Texel, Peruvian, Alpaca, Lunkarya, Abyssinian, Rex and many more! Guinea pig market and exhibitors' stands for all enthusiasts."
    ],
    "it": [
      "Scoprite una serie di eccezionali cavie di razza: Shelty, Texel, Peruviane, Alpaca, Lunkarya, Abissine, Rex e molte altre! Mercato della cavia e stand di espositori per tutti gli appassionati."
    ],
    "fr": [
      "Découvrez une multitude de cobayes de race exceptionnels : Shelty, Texel, Péruvien, Alpaga, Lunkarya, Abyssinien, Rex et bien d'autres ! Bourse aux cobayes et stands d'exposants pour tous les passionnés."
    ],
    "nl": [
      "Ontdek een groot aantal uitzonderlijke rascavia's: Shelty, Texel, Peruaanse, Alpaca, Lunkarya, Abessijn, Rex en nog veel meer! Caviamarkt en stands voor alle liefhebbers."
    ],
    "es": [
      "Descubra una gran variedad de cobayas de raza excepcional: Shelty, Texel, Peruana, Alpaca, Lunkarya, Abisinia, Rex y muchas más Mercado de cobayas y stands de expositores para todos los aficionados."
