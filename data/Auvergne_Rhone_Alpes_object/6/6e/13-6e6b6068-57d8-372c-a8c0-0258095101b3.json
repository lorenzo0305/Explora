  "rdfs:comment": {
    "de": [
      "Ihr Restaurant in Chabeuil bietet Ihnen eine Speisekarte mit lokalen und saisonalen Produkten, die mit Bedacht verarbeitet werden, um den Geschmack und die Aromen zu bewahren und zu sublimieren. Wir arbeiten mit lokalen Produkten und Lieferanten."
    ],
    "en": [
      "Your restaurant in Chabeuil will offer you a menu featuring local and seasonal produce, carefully prepared to preserve and enhance tastes and flavors. We work with local produce and suppliers."
    ],
    "it": [
      "Il vostro ristorante a Chabeuil vi offrirà un menu a base di prodotti locali e di stagione, preparati con cura per preservare ed esaltare i gusti e i sapori. Lavoriamo con prodotti e fornitori locali."
    ],
    "fr": [
      "Votre restaurant à Chabeuil vous proposera une carte composée de produits locaux et de saison, travaillés avec justesse pour préserver et sublimer les goûts et les saveurs. Nous travaillons avec des produits et des fournisseurs locaux."
    ],
    "es": [
      "Su restaurante en Chabeuil le ofrecerá un menú compuesto por productos locales y de temporada, cuidadosamente elaborados para preservar y realzar los gustos y sabores. Trabajamos con productos y proveedores locales."
    ],
    "nl": [
      "Je restaurant in Chabeuil biedt je een menu dat bestaat uit lokale en seizoensproducten, zorgvuldig bereid om de smaken en aroma's te behouden en te versterken. We werken met lokale producten en leveranciers."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ici et Là - Véore"
    ]
  },
