  "rdfs:comment": {
    "de": [
      "Die „Bar du Sapin“ befindet sich am Fuße der Pisten des Alpinskigebiets von Villard/Corrençon. Sie heißt die Skiläufer zu einer kleinen Imbisspause zwischen zwei Abfahrten willkommen. Musikalisches Ambiente."
    ],
    "en": [
      "The Bar du Sapin is located at the foot of the slopes in the Villard/Corrençon alpine domain. It serves skiers looking for refreshments in between ski runs. Musical atmosphere."
    ],
    "it": [
      "Il Bar du Sapin si trova nel Clos de la Balme, ai piedi del telemix del dominio alpino Villard/Corrençon. Vi accogliamo in modo molto cordiale in un'atmosfera di montagna: dolci e pizze da asporto su ordinazione"
    ],
    "fr": [
      "Le Bar du Sapin est situé au Clos de la Balme, au pied du télémix du domaine alpin Villard/Corrençon. Nous vous accueillons avec beaucoup de convivialité dans une ambiance montagnarde : viennoiseries et pizzas à emporter sur commande"
    ],
    "es": [
      "El Bar du Sapin está situado en el Clos de la Balme, al pie del telemix del dominio alpino de Villard/Corrençon. Le damos la bienvenida de forma muy amable en un ambiente de montaña: bollería y pizzas para llevar por encargo"
    ],
    "nl": [
      "De Bar du Sapin ligt in de Clos de la Balme, aan de voet van de telemix van het alpendomein Villard/Corrençon. Wij ontvangen u op een zeer vriendelijke manier in een bergsfeer: gebak en pizza's om mee te nemen op bestelling"
    ]
  },
