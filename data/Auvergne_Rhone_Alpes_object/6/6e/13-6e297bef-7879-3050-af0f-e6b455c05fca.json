  "rdfs:comment": {
    "de": [
      "Thematischer, spielerischer, sportlicher und künstlerischer Landschaftsbereich rund um den Baum, der sich im Wald befindet. In diesem Bereich finden Sie einen Parcabout, eine Parcadrone, Skulpturen, pädagogische Schilder und viel gute Laune!"
    ],
    "en": [
      "A themed, fun, sporty and artistic tree landscape in the forest, featuring a Parcabout, a Parcadrone, sculptures, educational panels and lots of fun!"
    ],
    "it": [
      "Un paesaggio alberato tematico, divertente, sportivo e artistico nel bosco, dove troverete un Parcabout, un Parcadrone, sculture, pannelli didattici e tanto divertimento!"
    ],
    "fr": [
      "Espace paysager thématique, ludique, sportif et artistique autour de l'arbre, situé dans la forêt, dans lequel vous trouverez un Parcabout, un Parcadrone, des sculptures, des panneaux éducatifs et beaucoup de bonne humeur !"
    ],
    "es": [
      "Un paisaje arbolado temático, divertido, deportivo y artístico en el bosque, donde encontrarás un Parcabout, un Parcadrone, esculturas, paneles educativos y ¡mucha diversión!"
    ],
    "nl": [
      "Een thematisch, leuk, sportief en artistiek bomenlandschap in het bos, waar je een Parcabout, een Parcadrone, sculpturen, educatieve panelen en heel veel plezier vindt!"
    ]
  },
