  "rdfs:comment": {
    "de": [
      "Wir sind handwerkliche Konfitürenhersteller und verarbeiten die von uns angebauten Früchte zu exquisiten Konfitüren, die traditionell im Kessel gekocht werden. Entdecken Sie unsere vielfältigen und originellen Rezepte in unserem Laden. Besichtigung des Betriebs möglich."
    ],
    "en": [
      "We are artisan jam makers. Our preparations are cooked in a cauldron and made with fruits and wild plants from our farm. Discover more than 60 different flavours in our shop. Farm visits and tastings available."
    ],
    "it": [
      "Siamo produttori di marmellate artigianali che trasformano la frutta che coltiviamo in squisite confetture, tradizionalmente cotte in un calderone. Venite a scoprire le nostre ricette varie e originali nel nostro negozio. Potete anche visitare la fattoria."
    ],
    "fr": [
      "Nous sommes artisans confituriers et transformons les fruits cultivés par nos soins en confitures exquises, mijotées traditionnellement au chaudron. Venez découvrir nos recettes variées et originales dans notre boutique. Visite de l'exploitation possible."
    ],
    "nl": [
      "We zijn ambachtelijke confituurmakers die het fruit dat we telen omzetten in heerlijke confituren, traditioneel gestoofd in een ketel. Kom en ontdek onze gevarieerde en originele recepten in onze winkel. Je kunt ook de boerderij bezoeken."
    ],
    "es": [
      "Somos confiteros artesanos y transformamos la fruta que cultivamos en exquisitas mermeladas, cocidas tradicionalmente a fuego lento en un caldero. Venga a descubrir nuestras variadas y originales recetas en nuestra tienda. También puede visitar la granja."
    ]
  },
