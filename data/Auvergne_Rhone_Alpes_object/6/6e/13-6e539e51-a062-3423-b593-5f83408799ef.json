  "rdfs:comment": {
    "de": [
      "Vor den Toren des historischen Viertels Montferrand, 10 Minuten vom Stadtzentrum und dem Flughafen entfernt. In der Nähe der Autobahnzufahrten (A71 / A75), des Marcel-Michelin-Stadions und des Polydôme-Zentrums."
    ],
    "en": [
      "At the gateway to the historic district of Montferrand, 10 minutes from downtown and the airport. Close to motorway access (A71 / A75), Marcel-Michelin stadium and Polydôme Center."
    ],
    "it": [
      "Alle porte del quartiere storico di Montferrand, a 10 minuti dal centro città e dall'aeroporto. Vicino all'accesso all'autostrada (A71 / A75), allo stadio Marcel-Michelin e al Centro Polydôme."
    ],
    "fr": [
      "Aux portes du quartier historique de Montferrand, à 10 minutes du centre-ville et de l'aéroport. Proche des accès autoroutiers (A71 / A75), du stade Marcel-Michelin et du Centre Polydôme."
    ],
    "nl": [
      "Aan de poort van de historische wijk Montferrand, op 10 minuten van het stadscentrum en de luchthaven. Dicht bij de snelweg (A71 / A75), het Marcel-Michelin-stadion en het Polydôme-centrum."
    ],
    "es": [
      "A las puertas del barrio histórico de Montferrand, a 10 minutos del centro de la ciudad y del aeropuerto. Cerca del acceso a la autopista (A71 / A75), del estadio Marcel-Michelin y del Centro Polydôme."
    ]
  },
  "rdfs:label": {
