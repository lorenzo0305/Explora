  "rdfs:comment": {
    "de": [
      "Eine komplette Ausstattung mit Geräten für Kraft- und Kardiotraining (Minderjährige ab 16 Jahren und in Begleitung eines Erwachsenen). Programm der Gruppenfitnesskurse am Empfang des Signal erhältlich."
    ],
    "en": [
      "A full range of weight training and cardio equipment. (Minors aged 16 and over must be accompanied by an adult). Fitness session programme available at reception."
    ],
    "it": [
      "Attrezzatura completa con macchinari per allenamento muscolare e cardio-training. (Minori a partire dai 16 anni accompagnati da un adulto). Programma delle sessioni di fitness disponibile alla reception."
    ],
    "fr": [
      "Un équipement complet avec des appareils de musculation et de cardio-training. (Mineur à partir de 16 ans et accompagné d'un adulte). Programme des cours collectifs de fitness disponible à l'accueil du Signal."
    ],
    "es": [
      "Equipamiento completo de musculación y cardio-training (menores a partir de 16 años acompañados de un adulto). Programa de clases colectivas de fitness disponible en la recepción de Le Signal."
    ],
    "nl": [
      "Een complete uitrusting met apparaten voor krachttraining en cardiotraining. (Minderjarigen vanaf 16 jaar onder begeleiding van een volwassene). Het programma van de fitnesslessen is verkrijgbaar bij de receptie."
    ]
  },
