  "rdfs:comment": {
    "de": [
      "Wir laden Sie ein, unsere Macarons, Schokolade, Nougat, Calissons und andere Leckereien zu probieren. Entdecken Sie eine Welt der Aromen, die olfaktorische und geschmackliche Freuden vereint!"
    ],
    "en": [
      "We invite you to come and taste our macaroons, chocolates, nougats, calissons and other delicacies. Come and discover a world of flavours combining olfactory and gustatory pleasures!"
    ],
    "it": [
      "Vi invitiamo a venire a degustare i nostri macaron, cioccolatini, torroni, calissons e altre prelibatezze. Venite a scoprire un mondo di sapori che combina piaceri olfattivi e gustativi!"
    ],
    "fr": [
      "Nous vous convions à venir déguster nos macarons, chocolats, nougats, calissons et autres gourmandises. Venez découvrir un monde de saveurs alliant plaisirs olfactifs et gustatifs !"
    ],
    "nl": [
      "Wij nodigen u uit om onze macarons, bonbons, nougats, calissons en andere lekkernijen te komen proeven. Kom en ontdek een wereld van smaken die geur en smaak combineren!"
    ],
    "es": [
      "Le invitamos a venir a probar nuestros macarrones, chocolates, turrones, calissons y otras delicias. Venga a descubrir un mundo de sabores que combina los placeres olfativos y gustativos"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Salon de thé : Le Monde du Macaron"
    ]
  },
