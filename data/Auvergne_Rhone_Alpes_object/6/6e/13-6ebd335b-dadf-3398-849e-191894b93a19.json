  "rdfs:comment": {
    "de": [
      "Treffen Sie Emily und Servanne, die aus St. Martin stammen, und entdecken Sie in ihrem Bergchalet eine raffinierte Savoyer Küche. Genießen Sie die Sonnenterrasse oder die Kamine mit Holzfeuer."
    ],
    "en": [
      "Come and meet Emily and Servanne, natives of St Martin, and discover refined Savoyard cuisine in their high-altitude chalet. Enjoy the sunny terrace or the wood-burning fireplaces."
    ],
    "it": [
      "Venite a conoscere Emily e Servanne, originarie di St Martin, e scoprite la raffinata cucina savoiarda nel loro chalet d'alta quota. Godetevi la terrazza soleggiata o i caminetti a legna."
    ],
    "fr": [
      "Venez rencontrer Emily et Servanne, natives de St Martin, et découvrir dans leur chalet d'altitude une cuisine Savoyarde et raffinée. Profitez de la terrasse ensoleillée ou des cheminées au feu de bois."
    ],
    "es": [
      "Venga a conocer a Emily y Servanne, naturales de San Martín, y descubra la refinada cocina saboyana en su chalet de altura. Disfrute de la soleada terraza o de las chimeneas de leña."
    ],
    "nl": [
      "Maak kennis met Emily en Servanne, afkomstig uit Sint Maarten, en ontdek de verfijnde Savoyaardse keuken in hun hooggelegen chalet. Geniet van het zonnige terras of de houtgestookte open haarden."
    ]
  },
