  "rdfs:comment": {
    "de": [
      "Ein lebendiger und multidisziplinärer Ort, der von einem Geist der Ko-Konstruktion und der gegenseitigen Aktionen bewohnt wird und für Künstler und Strukturen zugänglich ist, die in der Region arbeiten und investiert sind: Künstlerische Arbeitszeiten & Bürgerprojekte, wochenweise."
    ],
    "en": [
      "A lively, multi-disciplinary venue, imbued with a spirit of co-construction and cross-fertilization, accessible to artists and organizations working and investing in the local area: weekly artistic work sessions & citizen projects."
    ],
    "it": [
      "Un luogo vivace e multidisciplinare, permeato da uno spirito di co-costruzione e fertilizzazione incrociata, aperto ad artisti e organizzazioni che lavorano e investono nella zona: sessioni di lavoro artistico settimanali e progetti comunitari."
    ],
    "fr": [
      "Un lieu vivant et pluridisciplinaire, habité par un esprit de co-construction et d’actions croisées, accessible aux artistes et structures œuvrant et investies sur le territoire : Temps de travail artistiques & projets citoyens, à la semaine."
    ],
    "es": [
      "Un lugar vivo y multidisciplinar, imbuido de un espíritu de co-construcción y fertilización cruzada, abierto a artistas y organizaciones que trabajan e invierten en la zona: sesiones semanales de trabajo artístico y proyectos comunitarios."
    ],
    "nl": [
      "Een levendige, multidisciplinaire locatie, doordrenkt van een geest van co-constructie en kruisbestuiving, open voor kunstenaars en organisaties die werken en investeren in het gebied: wekelijkse artistieke werksessies & gemeenschapsprojecten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Espace des Forges"
    ]
  },
