  "rdfs:comment": {
    "de": [
      "Farbenfrohes Ambiente, kosmische Bar, Discokugel, tropische Lounge und Musik im Mittelpunkt: Hier wird das Bowling neu erfunden! Mit einem Cocktail in der Hand entdecken Sie einen Spielbereich der neuesten Generation mit 10 vernetzten Bahnen und einem Billardbereich."
    ],
    "en": [
      "Colorful atmosphere, cosmic bar, disco ball, tropical lounge and music at the heart of it all: here, bowling has been reinvented! Cocktails in hand, discover a state-of-the-art gaming zone with 10 connected lanes and a billiards area."
    ],
    "it": [
      "Atmosfera colorata, bar cosmico, palla da discoteca, lounge tropicale e musica al centro di tutto: questo è il bowling reinventato! Cocktail alla mano, scoprite un'area di gioco all'avanguardia con 10 piste collegate e un'area biliardo."
    ],
    "fr": [
      "Ambiance colorée, bar cosmique, boule à facettes, lounge tropical et musique au centre de tout : ici le bowling est réinventé ! Cocktail en main, découvrez une zone de jeux dernière génération avec ses 10 pistes connectées et son espace billard."
    ],
    "nl": [
      "Kleurrijke sfeer, kosmische bar, discobal, tropische lounge en muziek in het middelpunt: dit is bowlen opnieuw uitgevonden! Cocktails in de hand, ontdek een hypermoderne speelruimte met 10 met elkaar verbonden banen en een biljartruimte."
    ],
    "es": [
      "Ambiente colorido, bar cósmico, bola de discoteca, salón tropical y música en el centro de todo: ¡esto es la bolera reinventada! Cóctel en mano, descubra una zona de juego de última generación con 10 pistas conectadas y una zona de billar."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Piste - Bowling"
    ]
  },
