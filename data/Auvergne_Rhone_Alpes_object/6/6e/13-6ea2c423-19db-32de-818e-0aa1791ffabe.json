  "rdfs:comment": {
    "de": [
      "\"Yann Coeuru Photographie\", mit Sitz in Ruoms, steht Ihnen für die Realisierung all Ihrer Projekte zur Verfügung: Hochzeit, Familienreportage, Schwangerschaftssession, Geburt, Studio- oder Außenporträts, Events, Immobilien- oder Industriefotografie."
    ],
    "en": [
      "\"Yann Coeuru Photographie, based in Ruoms, is at your service for all your wedding projects, family reports, pregnancy sessions, births, studio or outdoor portraits, events, property or industrial photography."
    ],
    "it": [
      "\"Yann Coeuru Photographie\", con sede a Ruoms, è al vostro servizio per tutti i progetti di matrimonio, reportage di famiglia, sessioni di gravidanza, nascite, ritratti in studio o all'aperto, eventi, fotografia immobiliare o industriale."
    ],
    "fr": [
      "\"Yann Coeuru Photographie\", situé à Ruoms, est à votre service pour la réalisation de tous vos projets de,  mariage, reportage familial, séance grossesse, naissance, portrait studio ou extérieur, événementiel, photographie immobilière ou industriel."
    ],
    "nl": [
      "\"Yann Coeuru Photographie, gevestigd in Ruoms, staat tot uw dienst voor al uw huwelijksprojecten, familiereportages, zwangerschapssessies, geboortes, portretten in de studio of buiten, evenementen, vastgoed- of industriële fotografie."
    ],
    "es": [
      "\" Yann Coeuru Photographie, con sede en Ruoms, está a su servicio para todos sus proyectos de boda, reportajes familiares, sesiones de embarazo, nacimientos, retratos en estudio o al aire libre, eventos, fotografía inmobiliaria o industrial."
    ]
  },
