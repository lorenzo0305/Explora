  "rdfs:comment": {
    "de": [
      "Als Bergliebhaber und Reisender mit Leib und Seele hatte ich Lust, die Bewohner des Tals zu treffen, um die nepalesische Kultur zu entdecken und zu teilen."
    ],
    "en": [
      "As a mountain lover and traveller at heart, I wanted to go and meet the valley's inhabitants to help them discover and share Nepalese culture."
    ],
    "it": [
      "Da amante della montagna e viaggiatore nel cuore, volevo andare a incontrare la gente della valle per aiutarla a scoprire e condividere la cultura nepalese."
    ],
    "fr": [
      "Amateur de montagnes et voyageur dans l’âme, j’ai eu envie d’aller à la rencontre des habitants de la vallée pour faire découvrir et partager la culture népalaise."
    ],
    "es": [
      "Como amante de la montaña y viajera de corazón, quería ir a conocer a la gente del valle para ayudarles a descubrir y compartir la cultura nepalesa."
    ],
    "nl": [
      "Als bergliefhebber en reiziger in hart en nieren wilde ik de bewoners van de vallei ontmoeten om hen te helpen de Nepalese cultuur te ontdekken en te delen."
    ]
  },
  "rdfs:label": {
