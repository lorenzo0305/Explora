  "rdfs:comment": {
    "de": [
      "In unserer ehemaligen Stallscheune entdecken Sie das ländliche Leben vor der Mechanisierung: die Bearbeitung der Erde, das Melken, die Milchverarbeitung und die Brotherstellung."
    ],
    "en": [
      "You will discover in  this museum,  a transformed barn, the rural life before farm mechanization: working land, milking then  its turning into cheese, bread making…You will also find out spaces that present craftsmen professions and their work tools."
    ],
    "it": [
      "Nella nostra vecchia stalla, scoprirete la vita rurale prima della meccanizzazione: lavorare la terra, mungere, lavorare il latte, fare il pane."
    ],
    "fr": [
      "Vous découvrirez dans notre ancienne grange étable, la vie rurale d'avant la mécanisation : le travail de la terre, la traite, la transformation du lait, la fabrication du pain."
    ],
    "nl": [
      "In onze oude schuur ontdekt u het plattelandsleven van voor de mechanisatie: werken op het land, melken, melk verwerken, brood bakken."
    ],
    "es": [
      "Decubrirás en nuestro antiguo granero-establo, la vida rural antes de la mecanización: la labranza, el ordeño, la transformación de la leche, la fabricación del pan"
    ]
  },
  "rdfs:label": {
    "en": [
      "Eco-Museum of Land and Men"
    ],
    "fr": [
      "Ecomusée de la Terre et des Hommes"
    ],
    "es": [
      "Ecomuseo de la Tierra y des los hombres"
    ]
  },
