  "rdfs:comment": {
    "de": [
      "Das Tropische Aquarium zählt mehrere hundert tropische Fischarten mit schimmernd Farben und mit erstaunlichen Verhältnis, die in 27. Aquariums verteilt sind."
    ],
    "en": [
      "The Tropical Aquarium showcases several hundred species of tropical freshwater fish. Be amazed by the astonishing behaviors and shimmering colors of these fish swimming in 35 aquariums up to 50,000 liters."
    ],
    "it": [
      "L'Aquarium des Tropiques ospita diverse centinaia di specie di pesci tropicali d'acqua dolce. Rimarrete stupiti dal comportamento sorprendente e dai colori scintillanti di questi pesci in 35 acquari che possono raggiungere i 50.000 litri."
    ],
    "fr": [
      "L'Aquarium des Tropiques présente plusieurs centaines d'espèces de poissons tropicaux d'eau douce. Laissez-vous surprendre par les comportements étonnants, et couleurs chatoyantes de ces poissons évoluant dans 35 aquariums jusqu'à 50 000 litres."
    ],
    "es": [
      "El Aquarium des Tropiques cuenta con varios centenares de especies de peces tropicales de agua dulce. En 35 acuarios de hasta 50.000 litros, le sorprenderá el sorprendente comportamiento y los brillantes colores de estos peces."
    ],
    "nl": [
      "Diepglanzende kleuren en verwonderlijke reacties... ziet u bij het observeren van de waterbewoners. Bezoek het waterleven van 4 continenten en ontdek honderden soorten tropische vissen die verdeeld zijn over 27 aquaria van maximaal 50.000 liter."
    ]
  },
