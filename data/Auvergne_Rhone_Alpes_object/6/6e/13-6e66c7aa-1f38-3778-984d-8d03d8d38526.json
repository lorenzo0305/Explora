  "rdfs:comment": {
    "de": [
      "Le Dahu liegt 5 Minuten von Roanne und weniger als 1 Stunde von Lyon, St. Etienne, Clermont und Vichy entfernt. Das Restaurant empfängt Sie in einem atypischen Rahmen, um Ihnen eine regionale Küche zu bieten, die die Produzenten unserer Region in den Vordergrund stellt."
    ],
    "en": [
      "5 minutes from Roanne, in a rural setting, discover the reception room  with  its  700  bygone  objects  and  its  fairground  organ. Shady terrace. Home-cooked traditional food. Three receptions rooms for your family celebrations, or work seminaries."
    ],
    "it": [
      "Situato a 5 minuti da Roanne e a meno di un'ora da Lione, St-Étienne, Clermont e Vichy, Le Dahu vi accoglie in un ambiente insolito per farvi conoscere la cucina locale che valorizza i produttori della nostra regione."
    ],
    "fr": [
      "Situé à 5 min de Roanne et à moins d'1h de Lyon, St-Étienne, Clermont et Vichy, Le Dahu vous accueille dans un cadre atypique pour vous faire découvrir une cuisine de terroir qui met en avant les producteurs de notre région."
    ],
    "es": [
      "Situado a 5 minutos de Roanne y a menos de 1 hora de Lyon, St-Étienne, Clermont y Vichy, Le Dahu le da la bienvenida en un marco insólito para presentarle una cocina local que pone en valor a los productores de nuestra región."
    ],
    "nl": [
      "Le Dahu ligt op 5 minuten van Roanne en op minder dan 1 uur van Lyon, St-Étienne, Clermont en Vichy en verwelkomt je in een ongewone omgeving om je kennis te laten maken met de lokale keuken die de producenten van onze regio in de kijker zet."
    ]
  },
