  "rdfs:comment": {
    "de": [
      "Im Herzen von Clermont gelegenes Restaurant mit modernem Ambiente, das traditionelle und auvergnatische Küche miteinander verbindet. Spezialitäten mit gereiftem Fleisch."
    ],
    "en": [
      "Located in the heart of Clermont, this contemporary restaurant combines traditional and Auvergne cuisine. Matured meat specialties."
    ],
    "it": [
      "Situato nel cuore di Clermont, questo ristorante contemporaneo combina la cucina tradizionale e quella dell'Alvernia. Specialità di carne stagionata."
    ],
    "fr": [
      "Situé au cœur de Clermont, restaurant à l'ambiance contemporaine mêlant cuisine traditionnelle et cuisine auvergnate. Spécialités de viande maturée."
    ],
    "es": [
      "Situado en el corazón de Clermont, este restaurante contemporáneo combina cocina tradicional y de Auvernia. Especialidades de carne madurada."
    ],
    "nl": [
      "Dit eigentijdse restaurant ligt in het hart van Clermont en combineert traditionele gerechten met gerechten uit de Auvergne. Gerijpte vleesspecialiteiten."
    ]
  },
