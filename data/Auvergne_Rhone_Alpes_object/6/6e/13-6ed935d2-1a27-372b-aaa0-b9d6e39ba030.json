  "rdfs:comment": {
    "de": [
      "Die Kirche im romanischen Stil der zweiten Epoche enthält wesentliche Teile aus dem 12. Der Grundriss der Kirche ist in Form eines lateinischen Kreuzes angelegt. Führungen und Gruppenbesuche auf Anfrage oder freie Besichtigungen."
    ],
    "en": [
      "The second-period Romanesque church contains essential parts dating back to the 12th century. The plan of the church is in the shape of a Latin cross. Guided tours and group tours on request, or self-guided tours."
    ],
    "it": [
      "La chiesa romanica del secondo periodo contiene parti essenziali risalenti al XII secolo. La pianta della chiesa è a croce latina. Visite guidate e visite di gruppo su richiesta o visite autogestite."
    ],
    "fr": [
      "L'église de style roman deuxième époque comporte des parties essentielles du XIIe siècle. Le plan de l'église est en forme de croix latine. Visites guidées et groupes sur demande ou visites libres."
    ],
    "es": [
      "La iglesia románica del segundo periodo contiene partes esenciales que datan del siglo XII. La planta de la iglesia tiene forma de cruz latina. Visitas guiadas y para grupos previa petición o visitas autoguiadas."
    ],
    "nl": [
      "De romaanse kerk uit de tweede periode bevat essentiële onderdelen die dateren uit de 12e eeuw. De plattegrond van de kerk heeft de vorm van een Latijns kruis. Rondleidingen en groepsrondleidingen op aanvraag of op eigen gelegenheid."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Église Notre-Dame"
    ]
  },
