  "rdfs:comment": {
    "de": [
      "...Der Verein Efferv'Essence in Suze la Rousse, in der Drôme, ist ein kleines freies Elektron auf einem seltsamen Planeten, das versucht, seinen Teil dazu beizutragen, dass das Leben süßer wird...."
    ],
    "en": [
      "...The Association Efferv'Essence in Suze la Rousse, in the Drôme, is a small free electron on a strange planet which tries to put its grain of salt so that the life is softer...."
    ],
    "it": [
      "...L'Associazione Efferv'Essence di Suze la Rousse, nella Drôme, è un piccolo elettrone libero su uno strano pianeta che cerca di mettere il suo grano di sale affinché la vita sia più morbida...."
    ],
    "fr": [
      "...L'Association Efferv'Essence à Suze la Rousse, dans la Drôme, est un petit électron libre sur une drôle de planète qui essaie de mettre son grain de sel pour que la vie soit plus douce...."
    ],
    "es": [
      "...La Asociación Efferv'Essence en Suze la Rousse, en la Drôme, es un pequeño electrón libre en un planeta extraño que intenta poner su grano de sal para que la vida sea más suave...."
    ],
    "nl": [
      "...De Vereniging Efferv'Essence in Suze la Rousse, in de Drôme, is een kleine vrije elektron op een vreemde planeet die probeert haar steentje bij te dragen om het leven een beetje zoeter te maken...."
    ]
  },
  "rdfs:label": {
