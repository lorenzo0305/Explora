  "rdfs:comment": {
    "de": [
      "Das Restaurant bietet Ihnen eine raffinierte und köstliche Küche an, die die Aromen der Welt in einem einzigen Gericht vermischt. An sonnigen Tagen profitieren Sie von seiner Terrasse mit Privatgarten."
    ],
    "en": [
      "The restaurant proposes a refined and tasty cuisine combining flavours from all around the world in the same dish. On sunny days, dine out on its superb terrace with private garden."
    ],
    "it": [
      "Questo ristorante ti propone una cucina raffinata e saporita, combinazione di sapori dal mondo intero in un solo piatto. Nei giorni di sole approfitta dello spazio all'aperto nel giardino privato."
    ],
    "fr": [
      "Le restaurant vous propose une cuisine raffinée et savoureuse, mélange des saveurs du monde dans un même plat. Les jours ensoleillés, profitez de sa terrasse avec jardin privatif."
    ],
    "nl": [
      "Het restaurant biedt een verfijnde en smakelijke keuken, waarbij smaken uit de hele wereld in hetzelfde gerecht worden vermengd. Op zonnige dagen kunt u genieten van het terras met privétuin."
    ],
    "es": [
      "Este restaurante propone una cocina refinada y sabrosa, una mezcla de sabores del mundo en un mismo plato. Los días de buen tiempo acondicionamos una terraza con jardín privado."
    ]
  },
