  "rdfs:comment": {
    "de": [
      "\"Engagiert für Bio, produzieren wir auf einer kleinen Fläche qualitativ hochwertige saisonale Produkte, die ausschließlich direkt verkauft werden.\""
    ],
    "en": [
      "\"Committed to organic farming, we produce quality seasonal produce in a small area, exclusively for direct sale.\""
    ],
    "it": [
      "\"Impegnati nell'agricoltura biologica, produciamo prodotti stagionali di qualità in una piccola area, esclusivamente per la vendita diretta"
    ],
    "fr": [
      "\"Engagés sur le bio, nous produisons sur une petite surface des produits de saison de qualité, exclusivement en vente directe.\""
    ],
    "nl": [
      "\"Toegewijd aan biologische landbouw, produceren we seizoensgebonden kwaliteitsproducten op een klein gebied, uitsluitend voor directe verkoop"
    ],
    "es": [
      "\"Comprometidos con la agricultura ecológica, producimos productos de temporada de calidad en una pequeña superficie, exclusivamente para la venta directa"
    ]
