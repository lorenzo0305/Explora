  "rdfs:comment": {
    "de": [
      "Die Auberge de la Tour in Seychalles, etwa 20 km von Clermont-Ferrand entfernt, bietet Ihnen traditionelle und regionale Küche, die aus frischen Produkten zubereitet wird."
    ],
    "en": [
      "Ms Bonjean welcomes you to her cosy, friendly restaurant and serves a tradi- tional and regional cuisine, prepared with fresh produce. Her specialities are frogs’ legs, pigs’ trotters, Auvergne pork stew and tripe. Open Monday to Friday, lunchtimes. Evenings and weekend reservation required."
    ],
    "it": [
      "L'Auberge de la Tour, situato a Seychalles, a circa venti chilometri da Clermont-Ferrand, vi offre l'opportunità di scoprire la sua cucina tradizionale e regionale a base di prodotti freschi."
    ],
    "fr": [
      "L'Auberge de la Tour située à Seychalles à une vingtaine de kilomètres de Clermont-Ferrand vous propose de découvrir sa cuisine traditionnelle et régionale élaborée à partir de produits frais."
    ],
    "es": [
      "El Auberge de la Tour, situado en Seychalles, a unos veinte kilómetros de Clermont-Ferrand, le ofrece la oportunidad de descubrir su cocina tradicional y regional elaborada con productos frescos."
    ],
    "nl": [
      "De Auberge de la Tour, gelegen in Seychalles, op een twintigtal kilometer van Clermont-Ferrand, biedt u de mogelijkheid zijn traditionele en regionale keuken op basis van verse producten te ontdekken."
    ]
  },
  "rdfs:label": {
