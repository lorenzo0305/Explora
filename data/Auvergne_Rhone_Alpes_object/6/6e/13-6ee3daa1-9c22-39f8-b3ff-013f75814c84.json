  "rdfs:comment": {
    "de": [
      "Das Conservatoire Hector Berlioz CAPI, ein Konservatorium mit \"Departementsausstrahlung\" (Label des Kulturministeriums), das auch von der Region und dem Departementsrat subventioniert wird, ist das Ergebnis der 2002 erfolgten Fusion von zwei städtischen Musikschulen."
    ],
    "en": [
      "A conservatory with \"departmental influence\" (Ministry of Culture label), also subsidised by the Region and the Departmental Council, the Hector Berlioz CAPI Conservatory is the result of the merger in 2002 of two municipal music schools."
    ],
    "it": [
      "Il Conservatorio Hector Berlioz CAPI è un conservatorio \"dipartimentale\" (etichetta del Ministero della Cultura), sovvenzionato anche dalla Regione e dal Consiglio dipartimentale, ed è il risultato della fusione, avvenuta nel 2002, di due scuole di musica comunali."
    ],
    "fr": [
      "Conservatoire à « rayonnement départemental » (label Ministère de la culture), subventionné également par la Région et le Conseil Départemental, le Conservatoire Hector Berlioz CAPI est le résultat de la fusion en 2002 de 2 écoles municipales de musique."
    ],
    "nl": [
      "Het Hector Berlioz CAPI Conservatorium is een \"departementaal\" conservatorium (label van het Ministerie van Cultuur), dat ook wordt gesubsidieerd door het Gewest en de Departementsraad. Het is het resultaat van de fusie in 2002 van twee gemeentelijke muziekscholen."
    ],
    "es": [
      "El Conservatorio Hector Berlioz CAPI es un conservatorio \"departamental\" (etiqueta del Ministerio de Cultura), que también está subvencionado por la Región y el Consejo Departamental. Es el resultado de la fusión en 2002 de dos escuelas municipales de música."
    ]
  },
  "rdfs:label": {
