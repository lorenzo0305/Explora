  "rdfs:comment": {
    "de": [
      "La Taverne ist 7 Tage die Woche geöffnet und liegt gegenüber dem Bahnhof. Sie empfängt Sie täglich von Montag bis Donnerstag von 12 bis 14 Uhr und von 19 bis 22 Uhr, freitags und samstags von 12 bis 14 Uhr und von 19 bis 23 Uhr und sonntags von 12 bis 14 Uhr und von 19 bis 22 Uhr."
    ],
    "en": [
      "Open 7/7, located opposite the station, La Taverne welcomes you daily from 12pm to 2pm and 7pm to 10pm from Monday to Thursday, from 12pm to 2pm and 7pm to 11pm on Friday and Saturday, and on Sunday from 12pm to 2pm and 7pm to 10pm."
    ],
    "it": [
      "Aperta 7 giorni su 7, di fronte alla stazione, La Taverne vi accoglie tutti i giorni dalle 12:00 alle 14:00 e dalle 19:00 alle 22:00 dal lunedì al giovedì, dalle 12:00 alle 14:00 e dalle 19:00 alle 23:00 il venerdì e il sabato, e la domenica dalle 12:00 alle 14:00 e dalle 19:00 alle 22:00."
    ],
    "fr": [
      "Ouvert 7j/7, situé en face de la gare, La Taverne vous accueille tous les jours de 12h à 14h et de 19h à 22h du lundi au jeudi, de 12h à 14h et de 19h à 23h le vendredi et samedi, et le dimanche de 12h à 14h et de 19h à 22h."
    ],
    "nl": [
      "La Taverne is 7 dagen per week geopend, tegenover het station, en verwelkomt je elke dag van 12.00 tot 14.00 uur en van 19.00 tot 22.00 uur van maandag tot en met donderdag, van 12.00 tot 14.00 uur en van 19.00 tot 23.00 uur op vrijdag en zaterdag, en op zondag van 12.00 tot 14.00 uur en van 19.00 tot 22.00 uur."
    ],
    "es": [
      "Abierta 7 días a la semana, frente a la estación, La Taverne le recibe todos los días de 12:00 a 14:00 y de 19:00 a 22:00 de lunes a jueves, de 12:00 a 14:00 y de 19:00 a 23:00 los viernes y sábados, y los domingos de 12:00 a 14:00 y de 19:00 a 22:00."
    ]
  },
  "rdfs:label": {
    "en": [
      "Les Relais d'Alsace \"Taverne Karlsbräu\""
    ],
    "fr": [
      "La Taverne \"Tables de caractère\""
    ],
    "es": [
      "Les Relais d'Alsace \"Taverne Karlsbräu\""
