  "rdfs:comment": {
    "de": [
      "Bei einem Jazzrhythmus bietet Ihnen dieses Restaurant eine traditionelle Küche an, die mit Qualitätsprodukten zubereitet wird. Die Terrasse empfängt Sie im festlichen Ambiente der Rue Mercière."
    ],
    "en": [
      "Against a backdrop of jazz music, this restaurant proposes traditional cooking made with high-quality products. The terrace offers a festive atmosphere in rue Mercière."
    ],
    "it": [
      "A ritmo di jazz, questo ristorante ti propone una cucina tradizionale elaborata a partire da prodotti di grande qualità. I tavoli all'aperto ti accolgono nell'allegra atmosfera della rue Mercière."
    ],
    "fr": [
      "Sur un rythme de soul et de jazz, ce restaurant vous propose une cuisine traditionnelle élaborée à partir de produits frais. La terrasse vous accueille du 1er mars au 31 octobre dans l’ambiance festive de la rue Mercière !"
    ],
    "nl": [
      "Op het ritme van soul en jazz serveert dit restaurant traditionele gerechten op basis van verse producten. Het terras is geopend van 1 maart tot 31 oktober, in de feestelijke sfeer van de rue Mercière!"
    ],
    "es": [
      "Con un ritmo de jazz, este restaurante propone una cocina tradicional elaborada con productos de gran calidad. La terraza, por su parte, disfruta del ambiente festivo de Rue Mercière."
    ]
  },
