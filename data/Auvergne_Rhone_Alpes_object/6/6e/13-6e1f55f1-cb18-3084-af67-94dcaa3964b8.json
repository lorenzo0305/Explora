  "rdfs:comment": {
    "de": [
      "Villa Rossa bietet Ihnen eine grosse Auswahl an frischen, authentisch italienischen Pizzen und eine Karte mit traditioneller und raffinierter Küche aus abwechslungsreichen Gerichten, aus Produkte der Saison."
    ],
    "en": [
      "At Villa Rossa we use fresh produce to make a wide range of pizzas with the genuine taste of Italy. Also à la carte menu with traditional and sophisticated cuisine, a variety of rich dishes concocted with seasonal produce of the season."
    ],
    "it": [
      "Villa Rossa offre un'ampia scelta di pizze dall'autentico sapore italiano preparate con prodotti freschi, e un menu con una cucina tradizionale e raffinata composta da piatti ricchi e variegati preparati con\r\nprodotti stagionali."
    ],
    "fr": [
      "Villa Rossa vous propose un large choix de pizzas au goût authentique de l’Italie confectionnées à base de produits frais, et une carte avec une cuisine traditionnelle et raffinée composée de plats riches et variés élaborés avec des\r\nproduits de saison."
    ],
    "es": [
      "Villa Rossa ofrece una amplia selección de pizzas con auténtico sabor italiano elaboradas con productos frescos, y una carta con una cocina tradicional y refinada compuesta por platos ricos y variados preparados con productos de temporada\r\nproductos de temporada."
    ],
    "nl": [
      "Villa Rosa biedt u een grote keuze aan pizza's met authentieke Italiaanse smaak bereid met verse producten maar tevens een kaart met een traditionele en geraffineerde keukenproducten bereid volgens seizoen."
    ]
  },
