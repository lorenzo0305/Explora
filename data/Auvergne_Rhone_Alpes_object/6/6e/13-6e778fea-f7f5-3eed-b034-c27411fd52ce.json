  "rdfs:comment": {
    "de": [
      "Das Chalet des 2 Lacs, das 2017 von der Familie Gorini übernommen wurde, ist ein gemütlicher und zugleich gedämpfter Ort im Stil eines typischen Bergbistros."
    ],
    "en": [
      "Taken over in 2017 by the Gorini family, the Chalet des 2 Lacs is a place that is both friendly and cosy, in the style of a typical mountain bistro."
    ],
    "it": [
      "Rilevato nel 2017 dalla famiglia Gorini, lo Chalet des 2 Lacs è accogliente e amichevole, nello stile di un tipico bistrot di montagna."
    ],
    "fr": [
      "Repris en 2017 par la famille Gorini, le Chalet des 2 Lacs est un lieu à la fois convivial et feutré, à la façon d’un bistrot de montagne typique."
    ],
    "es": [
      "Retomado en 2017 por la familia Gorini, el Chalet des 2 Lacs es a la vez acogedor y agradable, al estilo de un típico bistró de montaña."
    ],
    "nl": [
      "Chalet des 2 Lacs werd in 2017 overgenomen door de familie Gorini en is zowel vriendelijk als gezellig, in de stijl van een typische bergbistro."
    ]
