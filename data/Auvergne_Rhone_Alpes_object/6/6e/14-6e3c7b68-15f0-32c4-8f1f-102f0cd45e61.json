  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/cbfe6ce6-0189-3a5a-bd73-cbe88c04a266",
      "dc:description": {
        "de": [
          "Informationen :\n\nÖffnungstage:\n\nMontag bis Freitag von 8:30 bis 20:00 Uhr\nSamstags von 8:30 bis 19:30 Uhr\n\nSonntag geschlossen\n \n Abholung :\n\nZugang zur Parapharmazie während der Öffnungszeiten. Zugang in Selbstbedienung für Kunden geschlossen.\n\nWeitere Neuigkeiten über Ihre Apotheke finden Sie auf ihrer facebook-Seite\n\n\n \n "
        ],
        "en": [
          "Information :\n\nOpening days:\n\nMonday to Friday, 8:30am to 8:00pm\nSaturday 8:30am to 7:30pm\n\nClosed on Sunday\n \n Pick-up :\n\nAccess to parapharmacy during opening hours. Self-service access closed to customers.\n\nFor more news about your pharmacy, visit our facebook page\n\n\n \n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura:\n\nDa lunedì a venerdì dalle 8.30 alle 20.00\nSabato dalle 8.30 alle 19.30\n\nChiuso la domenica\n \n Ritiro:\n\nAccesso alla parafarmacia durante gli orari di apertura. Accesso self-service chiuso ai clienti.\n\nPer ulteriori notizie sulla vostra farmacia, visitate la sua pagina facebook\n\n\n \n "
        ],
        "fr": [
          "Informations :\n\nJours d'ouverture:\n\nDu lundi au vendredi de 8h30 à 20h00\nLe samedi de 8h30 à 19h30\n\nFermeture le dimanche\n \n Retrait :\n\nAccès à la parapharmacie aux horaires d'ouverture. Accès en libre service fermé à la clientèle.\n\nPour plus d'actualités sur votre pharmacie, rendez-vous sur sa page facebook\n\n\n \n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen:\n\nMaandag t/m vrijdag van 8.30 tot 20.00 uur\nZaterdag van 8.30 tot 19.30 uur\n\nZondag gesloten\n \n Ophalen:\n\nToegang tot parafarmacie tijdens openingsuren. Zelfbedieningstoegang gesloten voor klanten.\n\nBezoek voor meer nieuws over uw apotheek de facebookpagina\n\n\n \n "
        ],
        "es": [
          "Más información :\n\nDías de apertura:\n\nDe lunes a viernes de 8h30 a 20h00\nSábado de 8h30 a 19h30\n\nDomingos cerrado\n \n Recogida:\n\nAcceso a parafarmacia en horario de apertura. Acceso autoservicio cerrado a los clientes.\n\nPara más noticias sobre su farmacia, visite su página de facebook\n\n\n \n "
        ]
      },
