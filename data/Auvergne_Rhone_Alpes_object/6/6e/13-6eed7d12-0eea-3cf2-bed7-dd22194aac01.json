  "rdfs:comment": {
    "de": [
      "Das Festival d'un Jour ist ein unumgängliches Treffen des Animationsfilms der Region, das jedes Jahr im März sechs Tage lang stattfindet und ein Familien-, Erwachsenen- und Fachpublikum empfängt."
    ],
    "en": [
      "The Festival d'un Jour is a not-to-be-missed event for the region's animated film industry, taking place every year in March for 6 days and welcoming family, adult and professional audiences."
    ],
    "it": [
      "Il Festival d'un Jour è un appuntamento imperdibile per i film d'animazione della regione, che si svolge ogni anno a marzo per 6 giorni ed è aperto a famiglie, adulti e professionisti."
    ],
    "fr": [
      "Le Festival d'un Jour est un rendez-vous incontournable du cinéma d'animation du territoire qui se déroule chaque année au mois de mars pendant 6 jours et accueille un public familial, adultes et professionnel."
    ],
    "nl": [
      "Het Festival d'un Jour is een niet te missen evenement voor animatiefilms in de regio. Het vindt elk jaar plaats in maart gedurende 6 dagen en is toegankelijk voor gezinnen, volwassenen en professionals."
    ],
    "es": [
      "El Festival d'un Jour es una cita ineludible del cine de animación en la región. Se celebra cada año en marzo durante 6 días y está abierto a familias, adultos y profesionales."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Festival d’un jour au Théâtre de la Ville"
    ]
  },
