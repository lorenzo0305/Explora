  "rdfs:comment": {
    "de": [
      "Neben der Buchhandlung, gegenüber dem Hangar du Premier-Film, empfängt Sie das Café Lumière zu jeder Tageszeit zu einer Gourmetpause."
    ],
    "en": [
      "Located next to the bookshop and opposite the Hangar du Premier-Film, Café Lumière serves food and drink."
    ],
    "it": [
      "Accanto alla libreria, di fronte all'Hangar du Premier-Film, il Café Lumière vi accoglie per una pausa gastronomica a qualsiasi ora del giorno."
    ],
    "fr": [
      "À côté de la librairie, face au Hangar du Premier-Film, le Café Lumière vous accueille pour une pause gourmande à toute heure de la journée."
    ],
    "nl": [
      "Naast de boekwinkel, tegenover de Hangar du Premier-Film, verwelkomt Café Lumière je op elk moment van de dag voor een gastronomische pauze."
    ],
    "es": [
      "Junto a la librería, frente al Hangar du Premier-Film, el Café Lumière le da la bienvenida para una pausa gastronómica a cualquier hora del día."
    ]
  },
