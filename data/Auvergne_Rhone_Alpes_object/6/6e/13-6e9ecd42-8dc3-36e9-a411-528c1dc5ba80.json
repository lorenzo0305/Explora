  "rdfs:comment": {
    "de": [
      "Die Kosmetikerin und Spa-Praktikerin Marie bietet Ihnen in ihrem Schönheitsinstitut verschiedene Pflegeleistungen sowie Bio-Kosmetikprodukte an.\r\nEs besteht die Möglichkeit, online einen Termin zu vereinbaren:\r\nhttps://www.planity.com/belle-et-zen-43170-saugues"
    ],
    "en": [
      "Esthetician and Spa Practitioner Marie offers a range of treatments and organic beauty products in her beauty salon.\r\nOnline appointments available:\r\nhttps://www.planity.com/belle-et-zen-43170-saugues"
    ],
    "it": [
      "Estetista e operatrice termale, Marie offre una gamma di trattamenti e prodotti di bellezza biologici nel suo salone di bellezza.\r\nÈ possibile fissare appuntamenti online:\r\nhttps://www.planity.com/belle-et-zen-43170-saugues"
    ],
    "fr": [
      "Esthéticienne et Spa praticienne, Marie vous propose dans son institut de beauté différentes prestations de soins ainsi que des produits de beauté bio.\r\nPossibilité de prise de rendez-vous en ligne :\r\nhttps://www.planity.com/belle-et-zen-43170-saugues"
    ],
    "nl": [
      "Marie is schoonheidsspecialiste en spa-beoefenaar en biedt een scala aan behandelingen en biologische schoonheidsproducten in haar schoonheidssalon.\r\nOnline afspraken mogelijk:\r\nhttps://www.planity.com/belle-et-zen-43170-saugues"
    ],
    "es": [
      "Esteticista y practicante de spa, Marie ofrece una gama de tratamientos y productos de belleza orgánicos en su salón de belleza.\r\nSe pueden concertar citas en línea:\r\nhttps://www.planity.com/belle-et-zen-43170-saugues"
    ]
  },
