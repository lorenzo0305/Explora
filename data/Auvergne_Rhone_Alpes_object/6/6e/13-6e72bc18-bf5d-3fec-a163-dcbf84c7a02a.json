  "rdfs:comment": {
    "de": [
      "Entdecken Sie den Geschmack unseres Honigs (Akazienhonig, Kastanienhonig, Lavendelhonig, Berghonig usw.) und unserer anderen Produkte aus dem Bienenstock (Gelée Royale, Lebkuchen, Met usw.)\r\nDirektverkauf auf dem Bauernhof nach Vereinbarung."
    ],
    "en": [
      "Discover the flavours of our honeys (acacia honey, chestnut honey, lavender honey, mountain honey...) and our other products from the hive (royal jelly, gingerbread, mead...)\r\nDirect sale at the farm by appointment."
    ],
    "it": [
      "Scoprite i sapori dei nostri mieli (miele di acacia, miele di castagno, miele di lavanda, miele di montagna, ecc.) e degli altri prodotti dell'alveare (pappa reale, panpepato, idromele, ecc.)\r\nVendita diretta in azienda su appuntamento."
    ],
    "fr": [
      "Découvrez les saveurs de nos miels (miel d'acacia, miel de châtaignier, miel de lavande, miel de montagne…) et de nos autres produits issus de la ruche (gelée royale, pains d'épices, hydromel...)\r\nVente directe à la ferme sur rendez-vous."
    ],
    "nl": [
      "Ontdek de smaken van onze honing (acaciahoning, kastanjehoning, lavendelhoning, berghoning, enz.) en onze andere producten uit de bijenkorf (koninginnengelei, peperkoek, honingdrank, enz.)\r\nDirecte verkoop op de boerderij op afspraak."
    ],
    "es": [
      "Descubra los sabores de nuestras mieles (miel de acacia, miel de castaño, miel de lavanda, miel de montaña, etc.) y de nuestros otros productos de la colmena (jalea real, pan de especias, hidromiel, etc.)\r\nVenta directa en la granja con cita previa."
    ]
  },
