  "rdfs:comment": {
    "de": [
      "Verkauf und Verkostung von AOP-Weinen Côtes du Rhône, CDR, Bio-CDR, AOC Brézème und IGP in Flaschen und Bag-in-Box.Herstellung und Verkauf von Gewürzsirup"
    ],
    "en": [
      "Sale and tasting of a large selection of AOP Côtes du Rhône Villages wines, Côtes du Rhône and organic Côtes du Rhône, AOP Brézeme and IGP. Either bottled or in a Bag-in-box package.Production and sale of spicy sirups."
    ],
    "it": [
      "Vendita e degustazione di vini AOP Côtes du Rhône Villages, CDR, CDR bio, AOP Brézème e IGP in bottiglia e bag-in-box."
    ],
