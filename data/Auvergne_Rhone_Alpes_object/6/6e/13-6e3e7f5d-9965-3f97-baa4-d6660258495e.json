  "rdfs:comment": {
    "de": [
      "Das Kohlebecken von Champagnac?Ydes war eines der wichtigsten Zentren des Kohleabbaus im Zentralmassiv. Die Kirche Sainte?Jeanne?d?Arc ist Teil dieser starken demografischen und sozialen Entwicklung im Zusammenhang mit dem Kohlebergbau."
    ],
    "en": [
      "The Champagnac-Ydes coalfield was one of the main coal mining centers in the Massif Central. The church of Sainte-Jeanne d?Arc is part of this context of strong demographic and social development linked to the coal industry."
    ],
    "it": [
      "Il bacino carbonifero di Champagnac-Ydes era uno dei principali centri di estrazione del Massiccio Centrale. La chiesa di Sainte-Jeanne d'Arc si inserisce in questo contesto di forte sviluppo demografico e sociale legato all'industria del carbone."
    ],
    "fr": [
      "Le bassin houiller de Champagnac‑Ydes fut l’un des principaux centres d’exploitation du charbon dans le Massif Central. L’église Sainte‑Jeanne‑d’Arc s’inscrit dans ce contexte de fort développement démographique et social lié à l’industrie houillère."
    ],
    "es": [
      "La cuenca minera de Champagnac-Ydes fue uno de los principales centros mineros del Macizo Central. La iglesia de Sainte-Jeanne d'Arc se inscribe en este contexto de fuerte desarrollo demográfico y social vinculado a la industria del carbón."
    ],
    "nl": [
      "Het steenkoolbekken van Champagnac-Ydes was een van de belangrijkste steenkoolwinningscentra in het Centraal Massief. De kerk Sainte-Jeanne d'Arc maakt deel uit van deze context van sterke demografische en sociale ontwikkeling gekoppeld aan de steenkoolindustrie."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Eglise Sainte-Jeanne-d’Arc"
    ]
  },
