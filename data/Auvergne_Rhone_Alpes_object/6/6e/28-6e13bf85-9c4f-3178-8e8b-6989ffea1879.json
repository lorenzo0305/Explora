      "rdfs:comment": {
        "de": [
          "Holen Sie Ihr Biogemüse, Äpfel, Apfelsaft, Apfelwein, Milchprodukte, Geflügel und Fleisch am Freitag von 17 bis 18 Uhr in Saint-Gobain ab!"
        ],
        "en": [
          "Come pick up your organic vegetables, apples, apple juice, cider, dairy products, poultry and meat on Friday from 5:00 to 6:00 p.m. in Saint-Gobain!"
        ],
        "it": [
          "Venite a ritirare le vostre verdure biologiche, le mele, il succo di mela, il sidro, i latticini, il pollame e la carne venerdì dalle 17.00 alle 18.00 a Saint-Gobain!"
        ],
        "fr": [
          "Venez récupérer vos légumes, pommes, jus de pommes, cidre, produits laitiers, volaille et viande biologiques le vendredi de 17h à 18h à Saint-Gobain !"
        ],
        "es": [
          "Venga a recoger sus verduras ecológicas, manzanas, zumo de manzana, sidra, productos lácteos, aves y carne el viernes de 17 a 18 horas en Saint-Gobain"
        ],
        "nl": [
          "Kom uw biologische groenten, appels, appelsap, cider, zuivelproducten, gevogelte en vlees ophalen op vrijdag van 17 tot 18 uur in Saint-Gobain!"
        ]
      },
