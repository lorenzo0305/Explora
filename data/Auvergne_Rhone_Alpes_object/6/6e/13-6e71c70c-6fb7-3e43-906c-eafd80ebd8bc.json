  "rdfs:comment": {
    "de": [
      "Information 2024: Liebe Anglerfreunde, wir möchten Sie darüber informieren, dass der Étang de la Raza ab dem 01. März 2024 aufgrund von Umbau- und Reinigungsarbeiten nicht mehr zum Angeln zugänglich sein wird. Vielen Dank für Ihr Verständnis."
    ],
    "en": [
      "Information 2024: Fellow anglers, we would like to inform you that the Étang de la Raza will be closed to fishing as of March 01, 2024, due to development and cleaning work. Thank you for your understanding."
    ],
    "it": [
      "Informazioni 2024: Amici pescatori, vi informiamo che l'Étang de la Raza non sarà aperto alla pesca a partire dal 01 marzo 2024 a causa di lavori di sistemazione e pulizia. Vi ringraziamo per la vostra comprensione."
    ],
    "fr": [
      "Information 2024 : Amis pêcheurs, nous vous informons que l'Étang de la Raza ne sera pas accessible à la pêche pour des raisons d'aménagement et de curage à compter du 01 mars 2024. Merci de votre compréhension."
    ],
    "nl": [
      "Informatie 2024: Collega-vissers, we willen jullie informeren dat het Étang de la Raza vanaf 01 maart 2024 niet meer open zal zijn voor vissen vanwege inrichtings- en schoonmaakwerkzaamheden. Bedankt voor uw begrip."
    ],
    "es": [
      "Información 2024: Compañeros pescadores, os informamos que el Étang de la Raza no estará abierto a la pesca a partir del 01 de marzo de 2024 debido a trabajos de acondicionamiento y limpieza. Gracias por su comprensión."
    ]
  },
