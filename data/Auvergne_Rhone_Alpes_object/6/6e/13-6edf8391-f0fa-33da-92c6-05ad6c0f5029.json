  "rdfs:comment": {
    "de": [
      "Hauteluce und sein Tal bieten Anfängern und erfahrenen Anglern gleichermaßen schöne Aussichten."
    ],
    "en": [
      "Hauteluce valley is a very good spot to fish for beginners or experts. Doron river, Infernet lake or Girotte dam are some of the beautiful places to fish around Hauteluce."
    ],
    "it": [
      "Hauteluce e la sua valle offrono grandi prospettive sia per i principianti che per i pescatori più esperti."
    ],
    "fr": [
      "Hauteluce et sa vallée offrent de très belles perspectives pour les pêcheurs qu'ils soient débutants ou plus aguerris."
    ],
    "es": [
      "Hauteluce y su valle ofrecen grandes oportunidades tanto a los principiantes como a los pescadores más experimentados."
    ],
    "nl": [
      "Hauteluce en zijn vallei bieden goede perspectieven voor zowel beginnende als meer ervaren vissers."
    ]
  },
  "rdfs:label": {
