  "rdfs:comment": {
    "de": [
      "Angelaktivität (1. Kategorie = Forellen & Elritzen): Angelschein erforderlich, erhältlich unter www.cartedepeche.fr, in der Bar-PMU Le Phocéen in Montsalvy oder in der Bar-Tabak in Junhac."
    ],
    "en": [
      "Fishing activity (1st category = salmonids & minnows). Fishing license required: Daily (€14), weekly (€36.50) or yearly permits (€87) on sale at www.cartedepeche.fr or from Bar Le Phocéen in Montsalvy or from Junhac bar-tobacconist's + Specific local card (€9/day/adult) on sale at SARL Laroussinie-Lumélec or at Mondor Motoculture in Lafeuillade-en-Vézie.\r\nFishing is permitted all year round (except stocking days: Fridays 26 September, 24 October, 21 November and 19 December 2025).\r\nNo swimming."
    ],
    "it": [
      "Pesca (1ª categoria = trote e pesciolini): è necessario un permesso di pesca, in vendita sul sito www.cartedepeche.fr, presso il bar-PMU Le Phocéen a Montsalvy o presso il bar-tabacchi a Junhac."
    ],
    "fr": [
      "Activité pêche (1e catégorie = truites & vairons) : permis de pêche nécessaire, en vente sur www.cartedepeche.fr, au bar-PMU Le Phocéen à Montsalvy ou au bar-tabac à Junhac."
    ],
    "nl": [
      "Visserijactiviteit (1ste categorie = zalmachtigen & elrits). Visvergunning vereist: Dagelijkse (€ 14), wekelijkse (€ 36,50) of jaarlijkse pas (€ 87) verkrijgbaar op www.cartedepeche.fr of bij de bar Le Phocéen in Montsalvy of bij de bar-tabac in Junhac + Specifiek vergunning (€ 9/dag/volwassene) te koop bij SARL Laroussinie-Lumélec of Mondor Motoculture in Lafeuillade-en-Vézie.\r\nVissen is het hele jaar door toegestaan (behalve op dagen waarop er vis wordt vrijgelaten: vrijdag 26 september, 24 oktober, 21 november en 19 december 2025). \r\nGeen zwemmen."
    ],
    "es": [
      "Pesca (1ª categoría = trucha y pececillos): se requiere permiso de pesca, a la venta en www.cartedepeche.fr, en el bar-PMU Le Phocéen de Montsalvy o en el bar-tabac de Junhac."
    ]
  },
