  "rdfs:comment": {
    "de": [
      "Eine lebensgroße Eierjagd in einer Festung: der Traum eines jeden Kindes! Eiersuche in Lebensgröße in der Festung von Polignac. Mehrere Zonen, die dem Alter der Kinder angepasst sind. Bringen Sie Ihren Korb mit, um die Kieselsteine zu sammeln!"
    ],
    "en": [
      "A life-size egg hunt in a fortified castle: every child's dream! Life-size egg hunt at the Polignac Fortress. Several age-appropriate zones. Bring your own basket to collect the pebbles!"
    ],
    "it": [
      "Una caccia alle uova a grandezza naturale in un castello fortificato: il sogno di ogni bambino! Una caccia alle uova a grandezza naturale nella Fortezza di Polignac. Diverse aree adatte a tutte le età. Portate il vostro cestino per raccogliere i sassolini!"
    ],
    "fr": [
      "Une chasse aux œufs grandeur nature dans un château-fort : le rêve de tous les enfants ! Chasse aux œufs grandeur nature à la Forteresse de Polignac. Plusieurs zones adaptées selon l’âge des enfants. Prévoir son panier pour récolter les galets !"
    ],
    "es": [
      "Una búsqueda de huevos a tamaño natural en un castillo fortificado: ¡el sueño de todo niño! Una búsqueda de huevos a tamaño natural en la Fortaleza de Polignac. Varias zonas para todas las edades. Traiga su propia cesta para recoger los guijarros"
    ],
    "nl": [
      "Levensgroot eieren zoeken in een versterkt kasteel: de droom van elk kind! Levensgroot eieren zoeken in het fort van Polignac. Verschillende gebieden voor alle leeftijden. Neem je eigen mandje mee om de steentjes te verzamelen!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Chasse aux œufs à la Forteresse de Polignac"
    ]
  },
