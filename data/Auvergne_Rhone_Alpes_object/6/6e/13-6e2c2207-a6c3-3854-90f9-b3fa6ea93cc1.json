  "rdfs:comment": {
    "de": [
      "In unserem Reitzentrum, das nur wenige Minuten vom Zentrum entfernt liegt, können Sie zur Freude der Kinder zu einem Ponyausritt an einem Flussufer und eventuell in den Sucs aufbrechen!!!"
    ],
    "en": [
      "In our riding school located a few minutes away from the centre, you can go for a pony ride for the delight of the children on the riverside and possibly in the sucs !"
    ],
    "it": [
      "Nel nostro centro ippico, situato a pochi minuti dal centro, è possibile fare un giro in pony per il massimo piacere dei bambini sulle rive di un fiume e possibilmente nei succhi!"
    ],
    "fr": [
      "Dans notre centre équestre situé à quelques minutes du centre, vous pouvez partir en promenade à poney pour le plus grand bonheur des enfants au bord d'une rivière et éventuellement dans les sucs !!"
    ],
    "nl": [
      "In onze manege op enkele minuten afstand kunt u voor het grootste plezier van de kinderen ponyrijden aan de oever van een rivier en eventueel in de sucs!"
    ],
    "es": [
      "En nuestro centro ecuestre, situado a pocos minutos del centro, podrá dar un paseo en poni para mayor placer de los niños a orillas de un río y, posiblemente, ¡en el sucs!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Ranch le Montana"
    ]
  },
