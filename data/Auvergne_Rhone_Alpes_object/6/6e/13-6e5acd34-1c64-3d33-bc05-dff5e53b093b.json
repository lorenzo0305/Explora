  "rdfs:comment": {
    "de": [
      "Ob mit der Familie oder Geschäftspartnern - das Restaurant Campanile bietet Ihnen jeden Tag eine reichhaltige und ausgeglichene Küche im Rhythmus der Jahreszeiten."
    ],
    "en": [
      "Whether it's for a family meal or business lunch, the Campanile restaurant serves delicious, balanced and seasonal dishes every day."
    ],
    "it": [
      "Che siate in viaggio con la famiglia o per lavoro, il ristorante del Campanile vi offre una cucina gourmet ed equilibrata che segue il ritmo delle stagioni."
    ],
    "fr": [
      "En famille ou dans le cadre des affaires, le restaurant Campanile vous propose chaque jour une cuisine gourmande et équilibrée qui suit le rythme des saisons."
    ],
    "nl": [
      "Voor familie of zaken, het restaurant Campanile biedt dagelijks een gastronomische en evenwichtige keuken die het ritme van de seizoenen volgt."
    ],
    "es": [
      "Tanto si viaja en familia como si lo hace por negocios, el restaurante del Campanile le ofrece una cocina gourmet y equilibrada que sigue el ritmo de las estaciones."
    ]
  },
