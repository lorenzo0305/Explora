  "rdfs:comment": {
    "de": [
      "Pays Lointain ist ein Filmkonzert. Auf der Bühne treten eine Harfe und ein Bass in einen Dialog, spielen mit dem Bild und den Klängen der Landschaft."
    ],
    "en": [
      "Pays Lointain is a cinematic concert. On stage, a harp and a bass converse, playing with the image and sounds of the landscape."
    ],
    "it": [
      "Pays Lointain è un concerto cinematografico. Sul palco, un'arpa e un basso dialogano con le immagini e i suoni del paesaggio."
    ],
    "fr": [
      "Pays Lointain est un concert cinématographique. Sur scène, une harpe et une basse dialoguent, jouent avec l’image et les sons du paysage."
    ],
    "nl": [
      "Pays Lointain is een filmisch concert. Op het podium praten een harp en een bas met elkaar en spelen met de beelden en geluiden van het landschap."
    ],
    "es": [
      "Pays Lointain es un concierto cinematográfico. En el escenario, un arpa y un bajo conversan, jugando con las imágenes y los sonidos del paisaje."
    ]
