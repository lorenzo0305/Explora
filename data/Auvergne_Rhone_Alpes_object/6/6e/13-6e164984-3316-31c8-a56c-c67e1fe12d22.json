  "rdfs:comment": {
    "de": [
      "Der Foodtruck Léti Kréol ist jede Woche in verschiedenen Gemeinden unterwegs. Laëtitia bietet Ihnen die großen Klassiker der reunionesischen Küche an: Samoussas, Bouchons, Rougail saucisse..\r\nReservierung empfohlen."
    ],
    "en": [
      "Léti Kréol foodtruck travels to different towns every week. Laëtitia offers you the great classics of Reunionese food: samoussas, bouchons, rougail saucisse... \r\nReservation recommended."
    ],
    "it": [
      "Il foodtruck di Léti Kréol viaggia ogni settimana in diverse città. Laëtitia vi propone i grandi classici della cucina della Reunion: samoussas, bouchons, rougail saucisse..\r\nSi consiglia la prenotazione."
    ],
    "fr": [
      "Le foodtruck Léti Kréol se déplace dans différentes communes chaque semaine. Laëtitia vous propose de grands classiques de la nourriture réunionnaise : samoussas, bouchons, rougail saucisse... \r\nRéservation recommandée."
    ],
    "es": [
      "El foodtruck Léti Kréol recorre cada semana diferentes ciudades. Laëtitia le ofrece los grandes clásicos de la comida reunionense: samoussas, bouchons, rougail saucisse..\r\nSe recomienda reservar."
    ],
    "nl": [
      "De Léti Kréol foodtruck rijdt elke week naar verschillende steden. Laëtitia biedt u de grote klassiekers van de Reunionese keuken: samoussas, bouchons, rougail saucisse..\r\nReservering aanbevolen."
    ]
  },
