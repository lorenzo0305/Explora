  "rdfs:comment": {
    "de": [
      "Das Hôtel*** Larivaut hieß im 19. Jahrhundert Grand Hôtel Chartron und wurde im 20. Jahrhundert von der Familie Larivaut übernommen. Das Ende der 80er Jahre umgebaute Hotel mit dem Gütesiegel France Tourisme verfügt über 18 klimatisierte Zimmer mit allen modernen Annehmlichkeiten."
    ],
    "en": [
      "The Hôtel*** Larivaut was known as the Grand Hôtel Chartron in the 19th century, and was taken over by the Larivaut family in the 20th century. Rebuilt in the late 80s, this France Tourisme-labeled hotel boasts 18 air-conditioned rooms and all modern comforts."
    ],
    "it": [
      "L'Hôtel*** Larivaut era conosciuto come Grand Hôtel Chartron nel XIX secolo e fu rilevato dalla famiglia Larivaut nel XX secolo. Ricostruito alla fine degli anni '80, questo hotel con marchio France Tourisme dispone di 18 camere climatizzate e di tutti i comfort moderni."
    ],
    "fr": [
      "L’Hôtel*** Larivaut s’appelait au XIXe siècle le Grand Hôtel Chartron et fut repris au XXe siècle par la famille Larivaut. Reconstruit fin des années 80, cet hôtel labellisé France Tourisme dispose de 18 chambres climatisées et de tout le confort moderne."
    ],
    "nl": [
      "Hôtel*** Larivaut stond in de 19e eeuw bekend als Grand Hôtel Chartron en werd in de 20e eeuw overgenomen door de familie Larivaut. Dit hotel met het label France Tourisme werd eind jaren 1980 herbouwd en beschikt over 18 kamers met airconditioning en alle moderne comfort."
    ],
    "es": [
      "El Hôtel*** Larivaut era conocido como Grand Hôtel Chartron en el siglo XIX y pasó a manos de la familia Larivaut en el siglo XX. Reconstruido a finales de los años 80, este hotel con la etiqueta France Tourisme dispone de 18 habitaciones con aire acondicionado y todas las comodidades modernas."
    ]
  },
  "rdfs:label": {
