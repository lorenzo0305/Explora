  "rdfs:comment": {
    "de": [
      "Französisches Restaurant, das der bistronomischen Küche einen Hauch von Modernität und Eleganz verleiht. Eine Dekoration aus Holz, Leder, Samt, Terrakotta- und Nachtblautönen verleiht dem Restaurant eine warme und zugleich zeitgemäße Atmosphäre"
    ],
    "en": [
      "French restaurant, bringing a touch of modernity and elegance to bistronomic cuisine. Decorated with a blend of wood, leather, velvet, terracotta and midnight blue, the restaurant boasts a warm, contemporary ambience."
    ],
    "it": [
      "Ristorante francese che offre un tocco di modernità ed eleganza alla cucina bistronomica. Con un arredamento che combina legno, pelle, velluto, terracotta e blu notte, il ristorante vanta un'atmosfera calda e contemporanea"
    ],
    "fr": [
      "Restaurant Français, apportant une touche de modernité et d'élégance à la cuisine bistronomique. Une décoration mêlant bois, cuir, velours, teintes terracotta et bleu nuit, le restaurant se distingue par une ambiance à la fois chaleureuse et contemporaine"
    ],
    "es": [
      "Restaurante francés que aporta un toque de modernidad y elegancia a la cocina bistronómica. Decorado con una mezcla de madera, cuero, terciopelo, terracota y azul noche, el restaurante presume de un ambiente cálido y contemporáneo"
    ],
    "nl": [
      "Frans restaurant dat een vleugje moderniteit en elegantie toevoegt aan de bistronomische keuken. Met een decor dat hout, leer, fluweel, terracotta en middernachtblauw combineert, heeft het restaurant een warme, eigentijdse sfeer"
    ]
  },
  "rdfs:label": {
