  "rdfs:comment": {
    "de": [
      "Das Snow Institute ist eine etablierte britische Skischule mit Sitz in Morzine, Les Gets und Avoriaz.\r\nTSI ist seit über 17 Jahren in den Skigebieten tätig, was bedeutet, dass wir über einen reichen Erfahrungsschatz und Kenntnisse der Region verfügen."
    ],
    "en": [
      "The Snow Institute is a well established British run Ski School based in Morzine, Les Gets and Avoriaz.\r\nTSI has been operating in resort for over 17yrs, this means that we have got a wealth of experience and knowledge of the area"
    ],
    "it": [
      "The Snow Institute è un'affermata scuola di sci britannica con sede a Morzine, Les Gets e Avoriaz.\r\nTSI è presente nella località da oltre 17 anni, il che significa che abbiamo una grande esperienza e conoscenza della zona."
    ],
    "fr": [
      "Le Snow Institute est une école de ski britannique bien établie basée à Morzine, Les Gets et Avoriaz.\r\nTSI est présent dans la station depuis plus de 17 ans, ce qui signifie que nous avons une riche expérience et connaissance de la région."
    ],
    "nl": [
      "The Snow Institute is een gerenommeerde Britse skischool gevestigd in Morzine en Avoriaz. TSI bestaat al 10 jaar."
    ],
    "es": [
      "The Snow Institute es una escuela de esquí británica bien establecida en Morzine, Les Gets y Avoriaz.\r\nTSI ha estado en la estación durante más de 17 años, lo que significa que tenemos una gran experiencia y conocimiento de la zona."
    ]
  },
