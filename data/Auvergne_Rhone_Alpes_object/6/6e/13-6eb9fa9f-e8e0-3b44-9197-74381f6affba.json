  "rdfs:comment": {
    "de": [
      "Unser familiengeführtes Restaurant - Salon-de-Thé bietet Ihnen eine regionale Küche \"100% hausgemacht\" aus lokalen Qualitätsprodukten, die Sie in einer gemütlichen Atmosphäre vor Ort genießen oder für eine Mahlzeit zu Hause oder anderswo mitnehmen können."
    ],
    "en": [
      "Family cottage surrounded by a garden with a natural- filtering pond."
    ],
    "it": [
      "Il nostro ristorante e sala da tè a conduzione familiare offre una cucina locale al 100% casalinga, a base di prodotti locali di qualità, da gustare nella calda atmosfera del ristorante o da portare via per un pasto a casa o altrove."
    ],
    "fr": [
      "Notre restaurant - salon-de-thé familial vous propose une cuisine de terroir \"100% fait-maison\" à partir de produits locaux de qualité, à déguster sur place dans une ambiance chaleureuse ou à emporter pour un repas chez soi ou ailleurs."
    ],
    "nl": [
      "Ons familierestaurant en theehuis bieden 100% huisgemaakte lokale gerechten van lokale kwaliteitsproducten, om van te genieten in de warme sfeer van het restaurant of om mee te nemen voor een maaltijd thuis of ergens anders."
    ],
    "es": [
      "Nuestro restaurante y salón de té familiar ofrece cocina local 100% casera elaborada con productos locales de calidad, para degustar en el cálido ambiente del restaurante o llevársela para comer en casa o en cualquier otro lugar."
    ]
  },
