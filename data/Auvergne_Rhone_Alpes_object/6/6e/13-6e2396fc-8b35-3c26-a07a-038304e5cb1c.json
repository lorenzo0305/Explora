  "rdfs:comment": {
    "de": [
      "Chez Adèle - eine lokale Kantine - bietet Ihnen hausgemachte Gerichte aus lokalen, überwiegend biologischen Produkten.\r\nEs gibt ein einzigartiges Buffet mit Vorspeisen und Hauptgerichten. Die hausgemachten Desserts sind à la carte. Vegetarier sind willkommen!"
    ],
    "en": [
      "Chez Adèle - local canteen offers you home-made dishes made with local products, mostly organic.\r\nA unique formula in the form of a buffet of starters and main courses is proposed. Homemade desserts are a la carte. Vegetarians welcome!"
    ],
    "it": [
      "Chez Adèle - mensa locale che offre piatti fatti in casa con prodotti locali, per lo più biologici.\r\nÈ disponibile una formula unica sotto forma di buffet di antipasti e piatti principali. I dessert fatti in casa sono à la carte. I vegetariani sono i benvenuti!"
    ],
    "fr": [
      "Chez Adèle - cantine locale vous propose des plats faits maisons réalisés avec des produits locaux majoritairement bio.\r\nUne formule unique sous forme de buffet Entrées/Plats vous est proposée. Les desserts maison sont à la carte. Végétariens bienvenus !"
    ],
    "nl": [
      "Chez Adèle - lokale kantine biedt huisgemaakte gerechten met lokale producten, meestal biologisch.\r\nEen unieke formule in de vorm van een buffet van voor- en hoofdgerechten is beschikbaar. Huisgemaakte desserts zijn à la carte. Vegetariërs welkom!"
    ],
    "es": [
      "Chez Adèle - comedor local que ofrece platos caseros elaborados con productos locales, en su mayoría ecológicos.\r\nSe ofrece una fórmula única en forma de buffet de entrantes y platos principales. Los postres caseros son a la carta. Los vegetarianos son bienvenidos"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Chez Adèle"
    ]
  },
