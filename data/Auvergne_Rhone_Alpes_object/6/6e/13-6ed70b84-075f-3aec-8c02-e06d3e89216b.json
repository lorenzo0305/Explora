  "rdfs:comment": {
    "de": [
      "Schöner Weltladen in Verbindung mit Lebensmitteln aus der Region. Entdecken Sie eine große Vielfalt an Produkten in einem Bistro-Kantinen-Rahmen, in dem Sie mittags eine Mahlzeit zu sich nehmen können."
    ],
    "en": [
      "A beautiful world grocery combined with a local grocery, discover a wide variety of products in a bistro-canteen setting where you can eat at lunchtime."
    ],
    "it": [
      "Una bella combinazione di prodotti alimentari del mondo e di prodotti locali, per scoprire un'ampia gamma di prodotti in un ambiente bistrot-mensa dove è possibile pranzare."
    ],
    "fr": [
      "Belle épicerie du monde alliée à l'épicerie du terroir, découvrez une grande diversité de produits dans un cadre de bistrot-cantine où vous pouvez vous restaurer les midis."
    ],
    "es": [
      "Una hermosa combinación de comestibles del mundo y productos locales, descubra una amplia gama de productos en un ambiente de bistro-cantina donde podrá disfrutar del almuerzo."
    ],
    "nl": [
      "Een mooie combinatie van wereldse kruidenierswaren en lokale producten, ontdek een breed scala aan producten in een bistro-kantinesetting waar je heerlijk kunt lunchen."
    ]
  },
