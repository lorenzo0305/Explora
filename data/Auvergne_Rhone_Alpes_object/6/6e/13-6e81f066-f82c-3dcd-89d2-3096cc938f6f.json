  "rdfs:comment": {
    "de": [
      "Das 180 m² große Hallenbad ist ein Schwimmbecken mit Jaccuzzi, Sauna und Dampfbad.\r\nIn der Sommersaison bietet es Zugang zum Außenbereich mit zwei großen Rutschen und einem Wasserspielbereich für die Kleinsten."
    ],
    "en": [
      "The outdoor recreational pool and the indoor pool are open every day from July to early September from 11 a.m. to 7 p.m."
    ],
    "it": [
      "La piscina coperta di 180 m² è dotata di jaccuzzi, sauna e bagno turco.\r\nIn estate, dà accesso all'area esterna con due grandi scivoli e un'area giochi d'acqua per i più piccoli."
    ],
    "fr": [
      "La piscine intérieure de 180 m² est un bassin de nage avec jaccuzzi, sauna et hammam.\r\nEn saison estivale il donne accès à l'extérieur avec deux grands toboggans et une zone de jeux aquatiques pour les plus petits."
    ],
    "es": [
      "La piscina cubierta de 180 m² cuenta con jacuzzi, sauna y baño turco.\r\nEn verano, da acceso a la zona exterior con dos grandes toboganes y una zona de juegos acuáticos para los más pequeños."
    ],
    "nl": [
      "Het overdekte zwembad van 180 m² heeft een jaccuzzi, sauna en stoombad.\r\nIn de zomer geeft het toegang tot het buitengedeelte met twee grote glijbanen en een waterspeeltuin voor de kleintjes."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Piscine Les Portes du Bien être"
    ]
  },
