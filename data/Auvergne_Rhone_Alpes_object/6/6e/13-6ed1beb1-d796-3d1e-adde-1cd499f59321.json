  "rdfs:comment": {
    "de": [
      "Der Sessellift Arcabulle bringt Sie zum Col de la Chal auf 2600 m, wobei Sie bei schlechtem Wetter durch eine Blase geschützt sind."
    ],
    "en": [
      "The Arcabulle Chairlift will take you to the Col de la Chal and you will be protected by a bubble in case of bad weather."
    ],
    "it": [
      "La seggiovia Arcabulle vi porta al Col de la Chal a 2600 m, protetto da una bolla in caso di maltempo."
    ],
    "fr": [
      "Le télésiège Arcabulle vous emmène au Col de la Chal à 2600m en étant protégé par une bulle en cas d'intempéries."
    ],
    "es": [
      "El telesilla de Arcabulle le lleva al Col de la Chal, a 2.600 m, protegido por una burbuja en caso de mal tiempo."
    ],
    "nl": [
      "De Arcabulle stoeltjeslift brengt u naar de Col de la Chal op 2600m, beschermd door een luchtbel in geval van slecht weer."
    ]
