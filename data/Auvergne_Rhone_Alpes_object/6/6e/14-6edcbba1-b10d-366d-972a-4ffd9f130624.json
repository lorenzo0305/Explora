      "@id": "https://data.datatourisme.fr/a5b92e76-32f7-3d9b-948f-54090c4fd6ef",
      "dc:description": {
        "de": [
          "Metzgerei, die von Cyril Martel, einem ehemaligen Lehrling von Herrn Botte, übernommen wurde.\n\nGeöffnet von Dienstag bis Samstag von 8 bis 13 Uhr und von 14:30 bis 19 Uhr."
        ],
        "en": [
          "Butchery taken over by Cyril Martel, former apprentice to Mr. Botte.\n\nOpen Tuesday to Saturday, 8am to 1pm and 2.30pm to 7pm."
        ],
        "it": [
          "La macelleria viene rilevata da Cyril Martel, ex apprendista del signor Botte.\n\nAperto dal martedì al sabato, dalle 8.00 alle 13.00 e dalle 14.30 alle 19.00."
        ],
        "fr": [
          "Boucherie reprise par Cyril Martel, ancien apprenti de M. Botte.\n\nOuvert du mardi au samedi de 8h à 13h et de 14h30 à 19h."
        ],
        "nl": [
          "Slagerij overgenomen door Cyril Martel, de voormalige leerling van meneer Botte.\n\nGeopend van dinsdag tot zaterdag van 8.00 tot 13.00 en van 14.30 tot 19.00."
        ],
        "es": [
          "Cyril Martel, antiguo aprendiz del Sr. Botte, se hace cargo de la carnicería.\n\nAbierto de martes a sábado, de 8h a 13h y de 14h30 a 19h."
        ]
      },
