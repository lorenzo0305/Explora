  "rdfs:comment": {
    "de": [
      "Ziel des Vereins ist die Durchführung kultureller Aktivitäten durch Animationen, Vermittlungen und Bildungsmaßnahmen in den Bereichen Wissenschaft, Kunst und Medien."
    ],
    "en": [
      "The aim of the association is to carry out cultural activities through events, mediation and educational initiatives in the fields of science, art and media."
    ],
    "it": [
      "Lo scopo dell'associazione è quello di svolgere attività culturali, attraverso animazioni, mediazioni, azioni educative nei campi delle scienze, delle arti e dei media."
    ],
    "fr": [
      "L'association a pour objet de mener des activités culturelles, par le biais d'animations, médiations, actions éducatives dans les domaines des sciences, des arts et des médias."
    ],
    "nl": [
      "Het doel van de vereniging is het uitvoeren van culturele activiteiten door middel van evenementen, bemiddeling en educatieve initiatieven op het gebied van wetenschap, kunst en media."
    ],
    "es": [
      "El objetivo de la asociación es llevar a cabo actividades culturales, a través de animaciones, mediaciones, acciones educativas en el ámbito de las ciencias, las artes y los medios de comunicación."
    ]
  },
