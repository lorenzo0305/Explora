  "rdfs:comment": {
    "de": [
      "Die Kirche Saint-Barthélémy in Séchilienne romanischen Ursprungs mit ihrem Portalglockenturm thront umgeben von ihrem Friedhof im Zentrum des Dorfes."
    ],
    "en": [
      "The church of Saint Barthélémy in Séchilienne has its origins in Roman times and sits impressively in the centre of the village, surrounded by its cemetery."
    ],
    "it": [
      "La chiesa di Saint-Barthélémy a Séchilienne, di origine romanica, con il suo campanile a portico, troneggia al centro del villaggio, circondata dal suo cimitero."
    ],
    "fr": [
      "L'église de Saint-Barthélémy à Séchilienne d'origine romane avec son clocher porche, trône entouré de son cimetière, au centre du village."
    ],
    "es": [
      "La iglesia románica de Saint-Barthélémy en Séchilienne, con su campanario porticado, está entronizada en el centro del pueblo, rodeada por su cementerio."
    ],
    "nl": [
      "De kerk Saint-Barthélémy in Séchilienne, van Romaanse oorsprong, met zijn klokkentoren, troont in het centrum van het dorp, omringd door het kerkhof."
    ]
