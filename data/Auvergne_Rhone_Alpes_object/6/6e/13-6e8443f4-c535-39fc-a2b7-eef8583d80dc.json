  "rdfs:comment": {
    "de": [
      "Eine bildende Künstlerin, ein Tischler, eine Keramikerin, ein Einrahmer, eine Architektin und eine Puppenspielerin haben sich in Monestier-de-Clermont zusammengefunden, um ein Atelier zu teilen und ihre Kreationen auszustellen."
    ],
    "en": [
      "A visual artist, a cabinetmaker, a ceramist, a framer, an architect and a puppeteer came together in Monestier-de-Clermont to share a workshop and exhibit their creations."
    ],
    "it": [
      "Un artista visivo, un ebanista, un ceramista, un corniciaio, un architetto e un burattinaio si sono riuniti a Monestier-de-Clermont per condividere un laboratorio ed esporre le loro creazioni."
    ],
    "fr": [
      "Une artiste plasticienne, un ébéniste, une céramiste, un encadreur, une architecte et une marionnettiste se sont réunis à Monestier-de-Clermont pour partager un atelier et exposer leurs créations."
    ],
    "es": [
      "Un artista plástico, un ebanista, un ceramista, un enmarcador, un arquitecto y un titiritero se reunieron en Monestier-de-Clermont para compartir un taller y exponer sus creaciones."
    ],
    "nl": [
      "Een beeldend kunstenaar, een meubelmaker, een keramist, een lijstenmaker, een architect en een poppenspeler kwamen samen in Monestier-de-Clermont om een workshop te delen en hun creaties tentoon te stellen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Ateliers du chemin"
    ]
  },
