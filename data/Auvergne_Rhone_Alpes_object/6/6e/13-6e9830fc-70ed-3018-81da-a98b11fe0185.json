  "rdfs:comment": {
    "de": [
      "Bernard, Bademeister für die Sommersaison, freut sich, Sie im städtischen Schwimmbad von St-Martin-Valmeroux begrüßen zu dürfen. Das Schwimmbad ist beheizt, aber nicht überdacht."
    ],
    "en": [
      "Open air heated swimming-pool – swimming lessons.\r\nOpen: in July and August."
    ],
    "it": [
      "Bernard, bagnino per la stagione estiva, è lieto di darvi il benvenuto nella piscina comunale di St-Martin-Valmeroux. La piscina è riscaldata ma non coperta."
    ],
    "fr": [
      "Bernard, maître nageur pour la saison estivale est heureux de vous accueillir à la piscine municipale de St-Martin-Valmeroux. La piscine est chauffée mais non couverte."
    ],
    "es": [
      "Bernard, socorrista de la temporada de verano, le da la bienvenida a la piscina municipal de St-Martin-Valmeroux. La piscina está climatizada pero no cubierta."
    ],
    "nl": [
      "Bernard, badmeester voor het zomerseizoen, heet je van harte welkom in het gemeentelijk zwembad van St-Martin-Valmeroux. Het zwembad is verwarmd maar niet overdekt."
    ]
  },
  "rdfs:label": {
    "en": [
