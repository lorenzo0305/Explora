  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/ebab3a39-c9fe-3436-b634-ee3d46853cfd",
      "dc:description": {
        "de": [
          "Benoit Bremer ist freiberuflicher Fotograf. Er ist spezialisiert auf Terroir, Natur, Kulturerbe und Traditionen und wechselt zwischen Aufträgen und persönlichen Arbeiten, sei es fotografisch oder videografisch."
        ],
        "en": [
          "Benoit Bremer is a freelance photographer. Specializing in terroir, nature, heritage and traditions, he alternates between commissions and personal work, whether photographic or video."
        ],
        "it": [
          "Benoit Bremer è un fotografo freelance. Specializzato in terroir, natura, patrimonio e tradizioni, alterna commissioni e lavori personali, sia fotografici che video."
        ],
        "fr": [
          "Benoit Bremer est photographe indépendant. Spécialisé terroir, nature, patrimoines et traditions,  il alterne entre commandes et travaux personnels, que ce soit photographiques ou vidéographiques."
        ],
        "nl": [
          "Benoit Bremer is freelance fotograaf. Hij is gespecialiseerd in terroir, natuur, erfgoed en tradities en werkt afwisselend in opdracht en voor eigen rekening, zowel fotografisch als op video."
        ],
        "es": [
          "Benoit Bremer es fotógrafo independiente. Especializado en terruño, naturaleza, patrimonio y tradiciones, alterna los encargos con el trabajo personal, ya sea fotográfico o en vídeo."
        ]
      },
