  "rdfs:comment": {
    "de": [
      "Probieren Sie die Gourmet-Kebabs von Selena, entdecken Sie die Stücke des Metzgers oder auch den Burger des Monats! Gourmetküche und herzlicher Empfang, hier ist alles hausgemacht, sogar die Brote!"
    ],
    "en": [
      "Come and taste the Selena's gourmet kebabs, discover the butcher's cuts or even the burger of the month! With its gourmet cuisine and warm welcome, everything here is homemade, even the bread!"
    ],
    "it": [
      "Venite a gustare il kebab gourmet del Selena, a scoprire i tagli del macellaio o anche l'hamburger del mese! Con la sua cucina gourmet e la sua calda accoglienza, tutto è fatto in casa, anche il pane!"
    ],
    "fr": [
      "Venez déguster les Kebabs gourmands du Selena, découvrir les pièces du boucher ou encore le burger du mois ! Cuisine gourmande et accueil chaleureux, ici tout est fait maison, même les pains !"
    ],
    "es": [
      "Venga a probar los pinchos gourmet de Selena, a descubrir los cortes de carnicería o incluso la hamburguesa del mes Con su cocina gourmet y su cálida bienvenida, aquí todo es casero, ¡incluso el pan!"
    ],
    "nl": [
      "Kom en proef de gastronomische kebab van Selena, ontdek het vlees van de slager of zelfs de hamburger van de maand! Met zijn gastronomische keuken en warm onthaal is alles hier huisgemaakt, zelfs het brood!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Bar restaurant kebab le Selena"
    ]
  },
