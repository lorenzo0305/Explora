  "rdfs:comment": {
    "de": [
      "Das Fremdenverkehrsamt bietet folgende Dienstleistungen an:\r\n- Touristeninformationen\r\n- Verkauf von Angelscheinen\r\n- Kostenloser Wifi-Zugang\r\n- Verkauf von einigen Artikeln (Bücher, Masken etc.)"
    ],
    "en": [
      "The Tourist Office offers the following services:\r\n- Tourist information\r\n- Fishing permit sales\r\n- Free Wifi access\r\n- Sale of some articles (books, masks etc...)"
    ],
    "it": [
      "L'Ufficio del Turismo offre i seguenti servizi\r\n- Informazioni turistiche\r\n- Vendita di permessi di pesca\r\n- Accesso Wifi gratuito\r\n- Vendita di alcuni articoli (libri, maschere, ecc.)"
    ],
    "fr": [
      "L'Office de Tourisme propose les services suivants :\r\n- Informations touristiques\r\n- Vente de permis de pêche\r\n- Accès Wifi gratuit\r\n- Vente de quelques articles (livres, masques etc...)"
    ],
    "es": [
      "La Oficina de Turismo ofrece los siguientes servicios\r\n- Información turística\r\n- Venta de permisos de pesca\r\n- Acceso Wifi gratuito\r\n- Venta de algunos artículos (libros, máscaras, etc.)"
    ],
    "nl": [
