  "rdfs:comment": {
    "de": [
      "Erleben Sie ein einzigartiges Abenteuer im Herzen des Rudels! Entdecken Sie das Gruppengefühl mit unseren Schlittenhunden auf immersiven kulturellen Touren. Genießen Sie Introspektionsaufenthalte in der Natur und Aktivitäten zu jeder Jahreszeit."
    ],
    "en": [
      "Experience a unique adventure at the heart of the pack! Discover the meaning of group with our sled dogs on immersive cultural tours. Enjoy introspective stays in the wilderness and all-season activities."
    ],
    "it": [
      "Vivete un'avventura unica nel cuore del branco! Scoprite il significato di gruppo con i nostri cani da slitta durante visite culturali immersive. Approfittate di soggiorni introspettivi nel cuore della natura e di attività per tutte le stagioni."
    ],
    "fr": [
      "Vivez une aventure unique au cœur de la meute ! Découvrez le sens du groupe avec nos chiens de traîneau lors de visites culturelles immersives. Profitez de séjours d'introspection en pleine nature et d'activités toutes saisons."
    ],
    "es": [
      "¡Viva una aventura única en el corazón de la manada! Descubra el significado de grupo con nuestros perros de trineo durante visitas culturales inmersivas. Aprovecha las estancias introspectivas en plena naturaleza y las actividades para todas las estaciones."
    ],
    "nl": [
      "Beleef een uniek avontuur in het hart van de roedel! Ontdek de betekenis van groep met onze sledehonden tijdens meeslepende culturele bezoeken. Profiteer van introspectieve verblijven in het hart van de natuur en activiteiten voor alle seizoenen."
    ]
  },
