  "rdfs:comment": {
    "de": [
      "Das Restaurant \"L'Eveil des Sens\" befindet sich im Herzen der Region Forez. Entdecken Sie hier eine großzügige, schmackhafte Küche mit ihren ständig wechselnden Menüs wieder."
    ],
    "en": [
      "The restaurant \"L'Eveil des sens\" is located at the heart of the Forez. \r\nCome and discover or rediscover a generous and tasty cuisine with its constantly renewed menus."
    ],
    "it": [
      "Il ristorante \"L'Eveil des Sens\" si trova nel cuore di Forez. Venite a scoprire o a riscoprire una cucina generosa e gustosa con i suoi menu in continua evoluzione."
    ],
    "fr": [
      "Le restaurant \"L'Eveil des Sens\" est situé au cœur du Forez. Venez y découvrir ou redécouvrir une cuisine généreuse, savoureuse avec ses menus sans cesse renouvelés."
    ],
    "nl": [
      "Het restaurant \"L'Eveil des Sens\" ligt in het hart van Forez. Kom en ontdek of herontdek een genereuze en smakelijke keuken met steeds wisselende menu's."
    ],
    "es": [
      "El restaurante \"L'Eveil des Sens\" está situado en el corazón de Forez. Venga a descubrir o redescubrir una cocina generosa y sabrosa con sus menús que cambian constantemente."
    ]
  },
