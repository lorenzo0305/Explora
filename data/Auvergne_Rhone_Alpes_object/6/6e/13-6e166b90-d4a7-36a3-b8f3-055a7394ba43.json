  "rdfs:comment": {
    "de": [
      "Comic-Fest mit dem MJC, der Mediathek und PGDIS.\r\nAuf dem Programm stehen Treffen und Workshops, Signierstunden, eine Show und eine Ausstellung in der Mediathek, im MJC und bei PGDIS.\r\nSehen Sie sich die Veranstaltungen im pdf-Programm an."
    ],
    "en": [
      "Comic book festival with MJC, Médiathèque and PGDIS.\r\nOn the program: meetings and workshops, book signings, shows and exhibitions at the Médiathèque, MJC and PGDIS.\r\nSee events in the pdf program."
    ],
    "it": [
      "Festival del fumetto con MJC, Médiathèque e PGDIS.\r\nIn programma: incontri e laboratori, firme di libri, mostre ed esposizioni presso la Médiathèque, il MJC e il PGDIS.\r\nVedi il programma degli eventi in pdf."
    ],
    "fr": [
      "Fête de la BD avec la MJC, la médiathèque et PGDIS.\r\nAu programme : rencontres et ateliers, dédicaces, spectacle et exposition à la Médiathèque, à la MJC et chez PGDIS.\r\nVoir les évènements dans le programme en pdf."
    ],
    "nl": [
      "Stripfestival met het MJC, de Médiathèque en PGDIS.\r\nOp het programma: ontmoetingen en workshops, signeersessies, voorstellingen en tentoonstellingen in de Médiathèque, het MJC en PGDIS.\r\nBekijk het programma in pdf."
    ],
    "es": [
      "Festival del cómic con el MJC, la Médiathèque y el PGDIS.\r\nEn el programa: encuentros y talleres, firmas de libros, espectáculos y exposiciones en la Médiathèque, el MJC y el PGDIS.\r\nConsulte el programa de actos en pdf."
    ]
  },
