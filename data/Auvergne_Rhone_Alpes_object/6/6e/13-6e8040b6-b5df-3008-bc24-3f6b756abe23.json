  "rdfs:comment": {
    "de": [
      "Gemütliche Bar-Lounge, täglich geöffnet von 9 Uhr bis 13 Uhr und von 16 Uhr bis Mitternacht, Snacks, Zwischenmahlzeiten, Aperitif, Aperitifbüffet mit Produkten der Region, Lunchbag zum Mitnehmen (am Vortag bestellen), musikalisches Ambiente jeden Freitag."
    ],
    "ru": [
      "Уютный лаунж-бар открыт каждый день с 9:00 до 13:00 и с 16:00 до полуночи и предлагает вам закуски, аперитивы, бранчи, и обеды на вынос (заказывать заранее), а также музыкальные вечера по пятницам."
    ],
    "en": [
      "Cosy lounge bar open daily from 9 am to 1 pm and from 4 pm to midnight, snacking, snacks, aperitifs, appetizers for the local cuisine, lunch bag to take away (order the day before) musical atmosphere every friday"
    ],
    "it": [
      "Accogliente lounge bar aperto tutti i giorni dalle 9.00 alle 13.00 e dalle 16.00 alle 24.00, snack, stuzzichini, aperitivi, cene con aperitivo locale, sacchetti per il pranzo da asporto (ordinare il giorno prima) atmosfera musicale ogni venerdì"
    ],
    "fr": [
      "Bar lounge cosy ouvert tous les jours de 9h à 13h et de 16h à minuit, snacking, gouter, apéritif, apéritif dinatoire du terroir, lunch bag à emporter (commander la veille) ambiance musicale tous les vendredis"
    ],
    "nl": [
      "Gezellige loungebar elke dag geopend van 9.00 tot 13.00 uur en van 16.00 tot middernacht, snacken, snacks, aperitieven, lokale aperitiefdiners, meeneemlunchtassen (de dag ervoor bestellen) muzikale sfeer elke vrijdag"
    ],
    "es": [
      "Acogedor bar salón abierto todos los días de 9.00 a 13.00 y de 16.00 a 24.00 horas, picoteo, snacks, aperitivos, cenas con aperitivos locales, bolsas de almuerzo para llevar (pedir el día anterior) ambiente musical todos los viernes"
    ]
  },
