  "rdfs:comment": {
    "de": [
      "Die Bergführer Anne-Sophie und Rémy führen Sie Schritt für Schritt durch Ihre Wanderungen und bieten Ihnen die Möglichkeit, das authentische und wilde Maurienne-Tal zu entdecken. Geselligkeit, Sicherheit und Wohlbefinden stehen dabei an erster Stelle."
    ],
    "en": [
      "Mountain guides Anne-Sophie and Rémy will guide you step-by-step on your hikes, helping you discover the wild and authentic Maurienne valley. They'll make you feel welcome, safe and at ease."
    ],
    "it": [
      "Anne-Sophie e Rémy, guide alpine, vi guideranno passo dopo passo nelle vostre escursioni e vi faranno scoprire la selvaggia e autentica valle della Maurienne. Un'esperienza amichevole, sicura e divertente."
    ],
    "fr": [
      "Anne-Sophie et Rémy, accompagnateurs en montagne, vous guident pas-à-pas lors de vos randonnées et vous proposent une découverte de la vallée de la Maurienne authentique et sauvage. Convivialité, sécurité et bien-être seront au rendez-vous."
    ],
    "nl": [
      "De berggidsen Anne-Sophie en Rémy begeleiden je stap voor stap op je wandelingen en bieden je de kans om de wilde en authentieke Maurienne-vallei te ontdekken. Een vriendelijke, veilige en aangename manier om de Maurienne-vallei te ontdekken."
    ],
    "es": [
      "Anne-Sophie y Rémy, guías de montaña, le guiarán paso a paso en sus excursiones y le mostrarán el salvaje y auténtico valle de Maurienne. Una experiencia amistosa, segura y agradable."
    ]
  },
