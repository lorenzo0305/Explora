  "rdfs:comment": {
    "de": [
      "In einer gemütlichen Umgebung können Sie die italienischen Spezialitäten des Kolosseums genießen.\r\nVerschiedene Pizzen, die Sie vor Ort genießen oder mitnehmen können!\r\nSehr angenehmer Patio im hinteren Teil des Restaurants."
    ],
    "en": [
      "In a warm Italian setting you can taste delicious traditional Italian specialities, made with fresh quality products. \r\nPizzas on site or to go. \r\nGreat patio at the back of the restaurant."
    ],
    "it": [
      "Godetevi le specialità italiane del Colisée in un'atmosfera amichevole.\r\nUna varietà di pizze da mangiare o da portare via!\r\nPatio molto piacevole sul retro del ristorante."
    ],
    "fr": [
      "C'est dans un cadre chaleureux que vous pourrez déguster les spécialités italiennes du Colisée. \r\nPizzas variées à déguster sur place ou à emporter ! \r\nPatio très agréable à l'arrière du restaurant."
    ],
    "nl": [
      "Geniet van de Italiaanse specialiteiten van Colisée in een gezellige sfeer.\r\nEen verscheidenheid aan pizza's om te eten of mee te nemen!\r\nZeer aangename patio aan de achterkant van het restaurant."
    ],
    "es": [
      "Disfrute de las especialidades italianas del Colisée en un ambiente acogedor.\r\nVariedad de pizzas para comer en el restaurante o para llevar\r\nPatio muy agradable en la parte trasera del restaurante."
    ]
  },
  "rdfs:label": {
    "en": [
      "Restaurant Le Colisée Pizzeria - Trattoria"
    ],
    "fr": [
      "Restaurant Le Colisée Pizzeria - Trattoria"
    ]
  },
