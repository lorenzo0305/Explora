  "rdfs:comment": {
    "de": [
      "David, der reisende Barde, lässt Sie die geheime Drôme durch thematische, aktive oder geschmackliche Ausflüge entdecken. Originelle und ungewöhnliche Märchenführungen durch das Tal der Drôme."
    ],
    "en": [
      "David, the traveling bard, will help you discover the secret Drôme through themed, active or tasty outings. Original and unusual storytelling tours in the Drôme valley."
    ],
    "it": [
      "David, il bardo itinerante, vi aiuterà a scoprire la Drôme segreta, attraverso escursioni tematiche, attive o gustative. Tour di narrazione originali e insoliti nella valle della Drôme."
    ],
    "fr": [
      "David, le barde voyageur vous fait découvrir la Drôme secrète, aux travers de sorties, thématiques, actives ou gustatives. Visites contées originales et insolites dans la vallée de la Drôme."
    ],
    "es": [
      "David, el bardo viajero, le hará descubrir el secreto de la Drôme, a través de salidas temáticas, activas o gustativas. Recorridos originales e insólitos para contar historias en el valle de la Drôme."
    ],
    "nl": [
      "David, de reizende bard, laat je de geheime Drôme ontdekken via thematische, actieve of smakelijke uitstapjes. Originele en ongewone verteltochten in de Drômevallei."
    ]
  },
  "rdfs:label": {
    "fr": [
      "David, le barde voyageur"
    ]
  },
