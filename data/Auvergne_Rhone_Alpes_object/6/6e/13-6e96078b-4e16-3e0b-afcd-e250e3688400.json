  "rdfs:comment": {
    "de": [
      "Adrien Le Roux hat sich weit über Montluçon hinaus einen Namen gemacht, wo er mit Leidenschaft und Talent köstliche Qualitätsschokolade und daraus abgeleitete Süßwaren in lokalen oder exotischen Geschmacksrichtungen herstellt: Tafeln, Brotaufstriche, Süßigkeiten..."
    ],
    "en": [
      "Adrien Le Roux has acquired a reputation well beyond Montluçon, where he makes with passion and talent succulent quality chocolates and derived confectionery, with local or exotic flavors: bars, spreads, sweets..."
    ],
    "it": [
      "Adrien Le Roux ha acquisito una reputazione che va ben oltre Montluçon, dove produce con passione e talento deliziosi cioccolatini di qualità e prodotti dolciari affini, con sapori locali o esotici: barrette, creme spalmabili, caramelle, ecc."
    ],
    "fr": [
      "Adrien Le Roux a acquit une réputation bien au-delà de Montluçon, où il confectionne avec passion et talent de succulents chocolats de qualité et confiseries dérivées, aux saveurs locales ou exotiques : tablettes, pâtes à tartiner, friandises..."
    ],
    "nl": [
      "Adrien Le Roux heeft een reputatie verworven tot ver buiten Montluçon, waar hij met passie en talent heerlijke kwaliteitschocolade en aanverwant snoepgoed maakt, met lokale of exotische smaken: repen, smeersels, snoepjes, enz."
    ],
    "es": [
      "Adrien Le Roux ha adquirido una reputación más allá de Montluçon, donde elabora con pasión y talento deliciosos chocolates de calidad y productos de confitería relacionados, con sabores locales o exóticos: barritas, pastas para untar, caramelos, etc."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Au Bon chocolat"
    ]
  },
