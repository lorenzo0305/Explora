  "rdfs:comment": {
    "de": [
      "Tauchen Sie ein in das Herz des Casa di Mozza, wo Italien seine Arme weit öffnet, in einer entspannten und warmen Atmosphäre, die zum Dolce Vita einlädt."
    ],
    "en": [
      "Dive into the heart of Casa di Mozza, where Italy opens its arms wide to you in a warm, relaxed atmosphere that invites you to la dolce vita."
    ],
    "it": [
      "Immergetevi nel cuore di Casa di Mozza, dove l'Italia vi spalanca le braccia in un'atmosfera rilassata e calda che vi invita alla dolce vita."
    ],
    "fr": [
      "Plongez au cœur de la Casa di Mozza, où l'Italie vous ouvre grand ses bras dans une ambiance décontractée et chaleureuse qui invite à la dolce vita."
    ],
    "es": [
      "Sumérjase en el corazón de Casa di Mozza, donde Italia le abre sus brazos en un ambiente relajado y cálido que le invita a la dolce vita."
    ],
    "nl": [
      "Dompel jezelf onder in het hart van Casa di Mozza, waar Italië zijn armen wijd voor je opent in een ontspannen en warme sfeer die je uitnodigt tot la dolce vita."
    ]
  },
  "rdfs:label": {
