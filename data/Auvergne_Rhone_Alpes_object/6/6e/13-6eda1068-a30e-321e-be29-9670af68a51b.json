  "rdfs:comment": {
    "de": [
      "Der Doron des Allues ist ein echter Gebirgsbach mit kaltem Wasser, das manchmal durch die Gletscherschmelze getrübt wird, und erfordert technisches Angeln."
    ],
    "en": [
      "A real mountain torrent with cold waters sometimes disturbed by melting glaciers, the Doron des Allues requires technical fishing."
    ],
    "it": [
      "Il Doron des Allues è un vero e proprio torrente di montagna dalle acque fredde, talvolta disturbate dallo scioglimento dei ghiacciai."
    ],
    "fr": [
      "Véritable torrent de montagne aux eaux froides et parfois troublées par la fonte des glaciers, le Doron des Allues requiert une pêche technique."
    ],
    "es": [
      "El Doron des Allues es un auténtico torrente de montaña con aguas frías que a veces se ven alteradas por el deshielo de los glaciares."
    ],
    "nl": [
      "De Doron des Allues is een echte bergstroom met koud water dat soms verstoord wordt door smeltende gletsjers."
    ]
  },
