  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/cc448eeb-5dcd-328e-95d5-da39b3fc9e04",
      "dc:description": {
        "de": [
          "Treffpunkt am Sonntag, den 7. September ab 8 Uhr in der Salle Jean-Luc Rougé\nWanderung oder Trail - kostenlos für Kinder unter 7 Jahren\nKirmes ab 11 Uhr - Pommes frites und Getränkestand\nAnmeldung auf helloasso.com unter 06 65 67 12 13 oder vor Ort"
        ],
        "en": [
          "Rendezvous on Sunday, September 7 from 8am at the Salle Jean-Luc Rougé\nWalk or trail - free for children under 7\nFair from 11am - French fries and refreshments\nRegistration on helloasso.com 06 65 67 12 13 or on site"
        ],
        "it": [
          "Appuntamento domenica 7 settembre dalle 8.00 presso la Salle Jean-Luc Rougé\nPasseggiata o percorso - gratuito per i minori di 7 anni\nFiera dalle 11.00 - patatine fritte e rinfresco\nIscrizioni su helloasso.com 06 65 67 12 13 o in loco"
        ],
        "fr": [
          "Rendez-vous le dimanche 7 septembre dès 8h à la Salle Jean-Luc Rougé\nMarche ou trail - gratuit pour les - 7 ans\nKermesse à partir de 11h - friterie et buvette\nInscription sur helloasso.com au 06 65 67 12 13 ou sur place"
        ],
        "es": [
          "Cita el domingo 7 de septiembre a partir de las 8.00 horas en la Sala Jean-Luc Rougé\nPaseo o sendero - gratuito para los menores de 7 años\nFeria a partir de las 11h - patatas fritas y refrescos\nInscripciones en helloasso.com 06 65 67 12 13 o in situ"
        ],
        "nl": [
          "Afspraak op zondag 7 september vanaf 8 uur in de Salle Jean-Luc Rougé\nWandeling of parcours - gratis voor kinderen onder de 7 jaar\nKermis vanaf 11 uur - friet en versnaperingen\nInschrijving op helloasso.com 06 65 67 12 13 of ter plaatse"
        ]
      },
