  "rdfs:comment": {
    "de": [
      "\"Vergänglichen Erkundungen in den Bäumen\"!\r\nGeführtes Klettern, Essen & Bar, Baumkonzerte, Hängende Bibliothek, Biwak in der Baumkrone?"
    ],
    "en": [
      "\"Ephemeral Explorations in the Trees!\r\nSupervised climbing, perched meals & bar, tree concerts, suspended library, bivouac in the canopy?"
    ],
    "it": [
      "\"Esplorazioni effimere sugli alberi!\r\nArrampicata sorvegliata, pasti e bar appollaiati, concerti sugli alberi, biblioteca sospesa, bivacco nella chioma?"
    ],
    "fr": [
      "\"Explorations Éphémères dans les Arbres\" !\r\nGrimpe encadrée, Repas & Bar perchés, Concerts arboricoles, Bibliothèque suspendue, Bivouac dans la canopée…"
    ],
    "es": [
      "\"¡Exploraciones efímeras en los árboles!\r\nEscalada supervisada, comidas y bar encaramados, conciertos en los árboles, biblioteca colgante, vivac en las copas?"
    ],
    "nl": [
      "\"Kortstondige verkenningen in de bomen!\r\nKlimmen onder begeleiding, maaltijden en een bar op de grond, boomconcerten, een hangende bibliotheek, bivakkeren in het bladerdak?"
    ]
  },
