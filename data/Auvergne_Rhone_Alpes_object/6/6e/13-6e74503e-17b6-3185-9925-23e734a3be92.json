  "rdfs:comment": {
    "de": [
      "Entdecken Sie im Herzen der Thermalstadt das Circus Bistro, seinen Rahmen und seine Speisekarte, die sich je nach Jahreszeit ändert. Ob mit der Familie, mit Freunden oder für ein Geschäftsessen, hier werden Sie eine angenehme Zeit verbringen."
    ],
    "en": [
      "In the heart of the spa town, discover the Circus Bistro, its setting and its menu, which changes with the seasons. With family, friends or for a business meal, you're sure to have a great time."
    ],
    "it": [
      "Nel cuore della città termale, scoprite il Circus Bistro, il suo ambiente e il suo menu che cambia a seconda delle stagioni. Con la famiglia, gli amici o per un pranzo di lavoro, trascorrerete un momento piacevole."
    ],
    "fr": [
      "Au cœur de la cité thermale, découvrez le Circus Bistro, son cadre et sa carte qui évolue au fil des saisons. En famille, entre amis ou pour un repas d'affaire, vous passerez un agréable moment."
    ],
    "nl": [
      "Ontdek in het hart van het kuuroord de Circus Bistro, het decor en de menukaart die met de seizoenen mee verandert. Met familie, vrienden of voor een zakendiner, je zult het er zeker naar je zin hebben."
    ],
    "es": [
      "En el corazón de la ciudad balneario, descubra el Circus Bistro, su marco y su carta que cambia con las estaciones. En familia, con amigos o para una comida de negocios, pasará un rato agradable."
    ]
  },
