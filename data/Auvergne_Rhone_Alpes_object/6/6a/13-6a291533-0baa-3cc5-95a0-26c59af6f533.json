  "rdfs:comment": {
    "de": [
      "Als Spezialist für Fliegenfischerei bin ich an den Flüssen Savoyens tätig, insbesondere an der Isère, der Haute-Isère und dem Arc. Die Bergseen sind in der warmen Jahreszeit mein Spielplatz für das Fischen mit Kunstködern und Elritzen."
    ],
    "en": [
      "A fly-fishing specialist, I work on the rivers of Savoie, especially the Isère, Haute-Isère and Arc. The mountain lakes are part of my playground in the summer months for lure and minnow fishing."
    ],
    "it": [
      "Specialista della pesca a mosca, pesco nei fiumi della Savoia, in particolare nell'Isère, nell'Haute-Isère e nell'Arc. I laghi di montagna fanno parte del mio parco giochi nei mesi estivi per la pesca con esche e minnow."
    ],
    "fr": [
      "Spécialiste de la pêche à la mouche, j’interviens sur les rivières de Savoie et plus spécialement l’Isère, la Haute-Isère et l’Arc. Les lacs de montagnes font partis de mon terrain de jeux à la belle saison pour des pêches aux leurres et vairon manié."
    ],
    "es": [
      "Como especialista en pesca con mosca, trabajo en los ríos de Saboya y especialmente en el Isère, el Haute-Isère y el Arc. Los lagos de montaña forman parte de mi patio de recreo en verano para pescar con señuelos y pececillos."
    ],
    "nl": [
      "Als vliegvisspecialist vis ik op de rivieren van de Savoie, vooral op de Isère, de Haute-Isère en de Arc. De bergmeren behoren tot mijn speeltuin in de zomermaanden voor het vissen met kunstaas en minnow."
    ]
  },
  "rdfs:label": {
    "en": [
      "Fishing guide - Hervé GENET"
    ],
    "it": [
      "Guida di pesca - Hervé GENET"
    ],
    "fr": [
      "Moniteur guide de pêche - Hervé GENET"
    ],
    "nl": [
      "Visgids - Hervé GENET"
    ]
  },
