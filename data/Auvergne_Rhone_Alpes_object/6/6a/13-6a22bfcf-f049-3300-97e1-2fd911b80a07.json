  "rdfs:comment": {
    "de": [
      "Die Brauerei Terre de Bières entwickelt und kreiert seit 2008 mit Leidenschaft handwerklich hergestellte Bier- und Limonadenrezepte und hat sich so einen regionalen Bekanntheitsgrad erarbeitet."
    ],
    "en": [
      "Terre de Bières creates with passion beers and limonade's traditional recipes for 2008, acquiring regional renown."
    ],
    "it": [
      "La Brasserie Terre de Bières sviluppa e crea con passione ricette di birre artigianali e limonate dal 2008, costruendosi nel frattempo una reputazione regionale."
    ],
    "fr": [
      "La Brasserie Terre de Bières élabore et crée avec passion des recettes de bières et limonade artisanales depuis 2008 , acquérant ainsi une notoriété régionale."
    ],
    "es": [
      "La Brasserie Terre de Bières lleva desde 2008 desarrollando y creando con pasión recetas de cervezas artesanales y limonadas, labrándose una reputación regional en el proceso."
    ],
    "nl": [
      "De Brasserie Terre de Bières ontwikkelt en creëert sinds 2008 met passie recepten voor ambachtelijke bieren en limonade en heeft daarbij een regionale reputatie opgebouwd."
    ]
  },
