  "rdfs:comment": {
    "de": [
      "Das Musée des ailes wird von einer Vereinigung von Enthusiasten betrieben, die sich seit 1992 für den Erhalt des französischen Luftfahrterbes einsetzt."
    ],
    "en": [
      "The Musée des ailes is run by an association of enthusiasts who have been working to preserve France's aeronautical heritage since 1992."
    ],
    "it": [
      "Il Musée des ailes è gestito da un'associazione di appassionati che dal 1992 lavora per preservare il patrimonio aeronautico francese."
    ],
    "fr": [
      "Le Musée des ailes est tenu par une association de passionnés qui œuvre depuis 1992 à la sauvegarde du patrimoine aéronautique français."
    ],
    "nl": [
      "Het Musée des ailes wordt beheerd door een vereniging van enthousiastelingen die zich sinds 1992 inzetten voor het behoud van het Franse luchtvaarterfgoed."
    ],
    "es": [
      "El Museo de las Alas está dirigido por una asociación de aficionados que trabaja desde 1992 para preservar el patrimonio aeronáutico francés."
    ]
  },
