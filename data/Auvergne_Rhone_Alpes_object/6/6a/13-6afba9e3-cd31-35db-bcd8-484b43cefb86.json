  "rdfs:comment": {
    "de": [
      "W-SCHOOL, die Schule für Wakesurfing, Wakeboarding, Foil und Wasserski in Thonon-les-Bains, am Ufer des Genfer Sees, am Eingang des städtischen Schwimmbads. Seit 2008 unterrichten wir mit einem pädagogischen Ansatz, der Kompetenz und gute Laune vereint."
    ],
    "en": [
      "Discover a full range of water activities for all levels: wakesurfing, wakeboarding, waterskiing, foiling, wing-boarding, and even barefooting. Certified instructor Gregory Charriere will guide you for an unforgettable experience on Lake Geneva."
    ],
    "it": [
      "Scoprite una gamma completa di attività sportive acquatiche per tutti i livelli: wakesurf, wakeboard, sci nautico, foiling, wing e persino a piedi nudi. Gregory Charriere, istruttore qualificato, vi accompagnerà per un'esperienza indimenticabile sul Lago di Ginevra."
    ],
    "fr": [
      "Découvrez une gamme complète d’activités nautiques pour tous les niveaux : wakesurf, wakeboard, ski nautique, foil, wing et même barefoot. Gregory Charriere moniteur diplômé vous accompagne pour une expérience inoubliable sur le lac Léman."
    ],
    "nl": [
      "Ontdek een heel scala aan watersportactiviteiten voor alle niveaus: wakesurfen, wakeboarden, waterskiën, foilen, wing en zelfs op blote voeten. Gregory Charriere, een gediplomeerd instructeur, zal je begeleiden voor een onvergetelijke ervaring op het meer van Genève."
    ],
    "es": [
      "Descubra toda una gama de actividades náuticas para todos los niveles: wakesurf, wakeboard, esquí acuático, foiling, wing e incluso barefoot. Gregory Charriere, instructor cualificado, le acompañará para vivir una experiencia inolvidable en el lago Lemán."
    ]
  },
  "rdfs:label": {
    "de": [
      "Pool Snap - Wasserski - Wakeboarding - Wakesurfing"
    ],
    "en": [
      "Pool Snap - Wake board - Wake surf"
    ],
    "fr": [
      "W-school - école de ski nautique et wakeboard"
    ]
  },
