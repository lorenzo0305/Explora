  "rdfs:comment": {
    "de": [
      "Die Gondelbahn von Pierrafort bringt Sie im Sommer wie im Winter weiter hinauf ins Skigebiet von Valmorel."
    ],
    "en": [
      "The Pierrafort gondola lift is open in summer and winter to take you to the top of the resort, at an altitude of 1900m!"
