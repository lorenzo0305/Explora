  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/6b6a2f7a-0acd-3e7a-92c8-24e3fd96020b",
      "dc:description": {
        "de": [
          "Erdbeeren pflücken und verschiedene Gemüsesorten in 100% natürlicher Landwirtschaft produzieren Einwecken (Marmelade, Suppe usw.) unseres im Freiland angebauten Obstes und Gemüses in Gläser."
        ],
        "en": [
          "Strawberry picking and production of a variety of vegetables using 100% natural methods. Jars (jams, soups, etc.) of our home-grown fruit and vegetables."
        ],
        "it": [
          "Raccogliamo fragole e coltiviamo una varietà di ortaggi con metodi naturali al 100%. Utilizziamo la frutta e la verdura coltivata in casa per preparare marmellate, zuppe e altri piatti."
        ],
        "fr": [
          "Cueillette de fraises et production de légumes divers en agriculture 100% naturelle Mise en bocaux (confiture, soupe etc.) de nos fruits et légumes cultivés en pleine terre."
        ],
        "nl": [
          "We plukken aardbeien en verbouwen een verscheidenheid aan groenten met 100% natuurlijke methoden. We gebruiken ons zelfgekweekte fruit en groenten om jam, soepen en andere gerechten te maken."
        ],
        "es": [
          "Recogemos fresas y cultivamos hortalizas variadas con métodos 100% naturales. Utilizamos nuestras frutas y hortalizas de cosecha propia para hacer mermeladas, sopas y otros platos."
        ]
      },
      "@type": [
        "Description"
