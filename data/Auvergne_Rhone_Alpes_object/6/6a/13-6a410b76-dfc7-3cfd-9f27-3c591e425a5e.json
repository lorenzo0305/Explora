  "rdfs:comment": {
    "de": [
      "Produktion und Verkauf von Produkten aus dem Bienenstock, aber auch von Kastanien, Beeren und aromatischen und medizinischen Pflanzen:"
    ],
    "en": [
      "Production and sale of products from the hive, chestnuts, small fruits and aromatic and medicinal plants: Honey, fresh pollen, propolis, chestnut jams (natural and blends), chestnut flour, fruit jams and syrups, fruit purées, plant syrups and preserves, honey and cider vinegars with plants and fruit, condiments, sweet and savoury spreads, apple juice, candles, etc.\r\nOrganic agriculture certification."
    ],
    "it": [
      "Produzione e vendita di prodotti dell'alveare, castagne, bacche e piante aromatiche e medicinali:"
    ],
    "fr": [
      "Production et vente de produits issus de la ruche, mais aussi de la châtaigne, des petits fruits et de plantes aromatiques et médicinales :"
    ],
    "nl": [
      "Productie en verkoop van producten van de bijenkorf, kastanjes, klein fruit en aromatische en geneeskrachtige planten: Honing, verse pollen, propolis, kastanjepasta (natuurlijk en mengsels), kastanjemeel, vruchtenjam en -siroop, vruchtenmoes, plantensiroop en -conserven, honing en appelazijn met planten en vruchten, specerijen, zoet en hartig broodbeleg, appelsap, kaarsen, enz.\r\nBiologisch landbouwbedrijf."
    ],
    "es": [
      "Producción y venta de productos de la colmena, castañas, bayas y plantas aromáticas y medicinales:"
    ]
  },
