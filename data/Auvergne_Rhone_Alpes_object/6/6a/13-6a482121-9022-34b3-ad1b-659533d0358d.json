  "rdfs:comment": {
    "de": [
      "Für alle Familienmitglieder, Freizeitzentrum mit mehreren Aktivitäten in Vallon Pont d'Arc: Kanufahrten, Hochseilgarten (ab 6 Jahren), Spieldorf (ab 2 Jahren) und Paintball (zugänglich für Kinder ab 8 Jahren)."
    ],
    "en": [
      "For all members of the family, a multi-activity leisure center in Vallon Pont d'Arc: canoeing, accrobranches park (from age 6), play village (from age 2) and paintball (accessible to children from age 8)."
    ],
    "it": [
      "Per tutti i membri della famiglia, un centro ricreativo multiattività a Vallon Pont d'Arc: canoa, arrampicata sugli alberi (a partire da 6 anni), Play Village (a partire da 2 anni) e Paintball (accessibile ai bambini a partire da 8 anni)"
    ],
    "fr": [
      "Pour tous les membres de la famille, centre de loisirs multi-activités sur Vallon Pont d’Arc : Descente en Canoë, Parc accrobranches (dès 6 ans), Village de jeux (dès 2 ans) et Paintball (accessible aux enfants dès 8 ans)"
    ],
    "nl": [
      "Voor het hele gezin, een multifunctioneel recreatiecentrum in Vallon Pont d'Arc: kanoën, boomklimmen (vanaf 6 jaar), speeldorp (vanaf 2 jaar) en paintball (toegankelijk voor kinderen vanaf 8 jaar)."
    ],
    "es": [
      "Para todos los miembros de la familia, un centro de ocio multiactivo en Vallon Pont d'Arc: piragüismo, escalada de árboles (a partir de 6 años), Play Village (a partir de 2 años) y Paintball (accesible para niños a partir de 8 años)"
    ]
  },
