  "rdfs:comment": {
    "de": [
      "Café, das von Vereinen betrieben wird. Konzerte: Siehe Website oder Facebook-Seite.\r\nKeine Parkplätze vor Ort, kommen Sie zu Fuß oder mit dem Fahrrad, das macht mehr Spaß. Parkmöglichkeiten oberhalb der Kirche oder vor dem städtischen Hangar."
    ],
    "en": [
      "Café associatif. Concerts: see website or Facebook page.\r\nNo parking on site, come on foot or by bike, it's more fun. Parking available above the church or in front of the municipal hangar."
    ],
    "it": [
      "Café associatif. Concerti: vedi sito web o pagina Facebook.\r\nNon c'è parcheggio in loco, venite a piedi o in bicicletta, è più divertente. Parcheggio disponibile sopra la chiesa o davanti all'hangar comunale."
    ],
    "fr": [
      "Café associatif. Concerts : consultez site internet ou page Facebook.\r\nPas de parking sur place, venez à pieds ou à vélo, c'est plus rigolo. Parking possible au dessus de l'église ou devant le hangar municipal."
    ],
    "nl": [
      "Gezellig café. Concerten: zie website of Facebookpagina.\r\nGeen parkeergelegenheid op het terrein, kom te voet of met de fiets, dat is leuker. Parkeren kan boven de kerk of voor de gemeentelijke hangar."
    ],
    "es": [
      "Café asociativo. Conciertos: consulte el sitio web o la página de Facebook.\r\nNo hay aparcamiento in situ, venga a pie o en bicicleta, es más divertido. Aparcamiento disponible encima de la iglesia o delante del hangar municipal."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Café associatif \"Le 120\""
    ]
  },
