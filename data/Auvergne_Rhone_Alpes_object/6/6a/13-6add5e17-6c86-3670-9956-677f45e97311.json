  "rdfs:comment": {
    "de": [
      "Die Ecuries de Bissorte eröffnen ihr Reitzentrum und bieten Reitunterricht für alle Niveaustufen, Baby-Ponys (ab 4 Jahren), Ausritte, Praktika und Ponyverleih an."
    ],
    "en": [
      "The Ecuries de Bissorte open their riding center and offer riding lessons for all levels, baby ponies (from age 4), rides, training courses and pony hire."
    ],
    "it": [
      "Le Ecuries de Bissorte hanno aperto il loro centro di equitazione, che offre lezioni di equitazione per tutti i livelli, baby pony (a partire dai 4 anni), passeggiate, corsi e noleggio di pony."
    ],
    "fr": [
      "Les Ecuries de Bissorte ouvre leur centre équestre et propose des cours d'équitation tous niveaux, des baby poneys (à partir de 4 ans), des balades, des stages, de la location de poneys."
    ],
    "es": [
      "Las Ecuries de Bissorte han abierto su centro ecuestre, que ofrece clases de equitación para todos los niveles, ponis bebé (a partir de 4 años), paseos, cursos y alquiler de ponis."
    ],
    "nl": [
      "De Ecuries de Bissorte hebben hun manege geopend, met paardrijlessen voor alle niveaus, babypony's (vanaf 4 jaar), ritten, cursussen en ponyverhuur."
    ]
  },
  "rdfs:label": {
