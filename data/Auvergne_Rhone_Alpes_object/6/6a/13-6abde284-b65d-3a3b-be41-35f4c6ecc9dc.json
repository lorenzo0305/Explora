  "rdfs:comment": {
    "de": [
      "Die Besucher werden Erinnerungen wiederfinden und können ihre Anekdoten rund um Emailleschilder, Ölkanister, Vintage-Tanksäulen, Werbeplakate aus der Zeit, Tankwartanzüge, andere Werbehefte usw. teilen."
    ],
    "en": [
      "Visitors will be able to rediscover their memories and share their anecdotes around enamelled plates, oil cans, vintage petrol pumps, vintage advertising posters, petrol station attendant's overalls, other advertising booklets, etc..."
    ],
    "it": [
      "I visitatori potranno riscoprire i loro ricordi e condividere i loro aneddoti intorno a piatti smaltati, lattine di olio, pompe di benzina d'epoca, manifesti pubblicitari d'epoca, tute da lavoro da benzinaio, altri libretti pubblicitari, ecc."
    ],
    "fr": [
      "Les visiteurs retrouveront des souvenirs et pourront partager leurs anecdotes autour des plaques émaillées, bidons d'huile, pompes à essence vintage, affiches publicitaires d'époque, combinaisons de pompistes, autres livrets publicitaires, etc..."
    ],
    "es": [
      "Los visitantes podrán redescubrir sus recuerdos y compartir sus anécdotas en torno a las placas esmaltadas, latas de aceite, surtidores de gasolina de época, carteles publicitarios de época, monos de gasolinero, otros folletos publicitarios, etc."
    ],
    "nl": [
      "Bezoekers kunnen hun herinneringen ophalen en anekdotes delen rond de geëmailleerde borden, olieblikken, oude benzinepompen, oude reclameposters, overalls van pompbedienden, andere reclameboekjes, enz."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Musée des amis de la Station d'Etoile"
    ]
  },
