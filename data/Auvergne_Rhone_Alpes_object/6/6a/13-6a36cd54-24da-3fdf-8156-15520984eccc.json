  "rdfs:comment": {
    "de": [
      "Das Château des Bachelards ist ein außergewöhnliches, 12 Hektar großes Weingut in Fleurie. Das Château, das seit 2007 auf Chemie verzichtet, war einer der Pioniere des biodynamischen Anbaus in der Region und ist dreifach zertifiziert für biologischen und biodynamischen Anbau."
    ],
    "en": [
      "The Château des Bachelards is an exceptional wine estate of 12ha located in Fleurie. Without any use of chemicals since 2007, the Château was one of the pioneers of Biodynamics in the region; is triple certified in Organic and Biodynamic farming. We have also been awarded the 'Vignobles & Découvertes' label for the quality of our welcome services."
    ],
    "it": [
      "Lo Château des Bachelards è un'eccezionale tenuta vinicola di 12 ettari nella Fleurie. Privo di sostanze chimiche dal 2007, lo Château è stato uno dei pionieri della viticoltura biodinamica nella regione ed è in possesso della tripla certificazione di agricoltura biologica e biodinamica."
    ],
    "fr": [
      "Le Château des Bachelards est un domaine viticole d'exception de 12ha situé à Fleurie. Sans recours à la chimie depuis 2007, le Château fût un des pionnier de la Biodynamie dans la région; est triplement certifié en agriculture Biologique et Biodynamique."
    ],
    "es": [
      "El Château des Bachelards es una finca vinícola excepcional de 12 hectáreas situada en Fleurie. Sin productos químicos desde 2007, el Château fue uno de los pioneros de la viticultura biodinámica en la región, y cuenta con una triple certificación en agricultura ecológica y biodinámica."
    ],
    "nl": [
      "Château des Bachelards is een uitzonderlijk wijndomein van 12 hectare in Fleurie. Het Château, dat sinds 2007 vrij is van chemicaliën, was een van de pioniers van biologisch-dynamische wijnbouw in de regio en is drievoudig gecertificeerd in biologische en biologisch-dynamische landbouw."
    ]
  },
