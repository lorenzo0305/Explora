  "rdfs:comment": {
    "de": [
      "Nach L'après-midi d'un foehn setzt Phia Ménard, die ihrem lebenslangen Onirismus treu bleibt, ihren Zyklus der \"Pièces du Vent\" (Windstücke) mit Nocturne (Parade) fort."
    ],
    "en": [
      "After L'après-midi d'un foehn, Phia Ménard continues her cycle of \"Pièces du Vent\" with Nocturne (Parade)."
    ],
    "it": [
      "Dopo L'après-midi d'un foehn, Phia Ménard, fedele al suo stile onirico di lunga data, continua il suo ciclo di \"Pezzi di vento\" con Nocturne (Parade)."
    ],
    "fr": [
      "Après L'après-midi d'un foehn, Phia Ménard, fidèle à son onirisme de toujours, poursuit son cycle des \"Pièces du Vent\" avec Nocturne (Parade)."
    ],
    "es": [
      "Tras L'après-midi d'un foehn, Phia Ménard, fiel a su estilo onírico de siempre, continúa su ciclo de \"Piezas de viento\" con Nocturne (Desfile)."
    ],
    "nl": [
      "Na L'après-midi d'un foehn vervolgt Phia Ménard, trouw aan haar aloude dromerige stijl, haar cyclus van \"Wind Pieces\" met Nocturne (Parade)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Marionnette/danse : Nocturne (parade)"
    ]
  },
