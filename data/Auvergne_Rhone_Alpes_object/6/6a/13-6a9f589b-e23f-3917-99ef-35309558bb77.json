  "rdfs:comment": {
    "de": [
      "Vom 9. März bis zum 28. April werden die Peintresses, ein Kollektiv von Malerinnen, das aus dem Wunsch heraus entstanden ist, gemeinsam zu kreieren, auszustellen und voranzukommen. das Vergnügen haben, ihre erste Gruppenausstellung, ELLE(S), zu präsentieren."
    ],
    "en": [
      "From March 9 to April 28, the Peintresses, a collective of women painters born of the desire to create, exhibit and move forward together, will be pleased to present their first group show, ELLE(S)."
    ],
    "it": [
      "Dal 9 marzo al 28 aprile, le Peintresses, un collettivo di pittrici nato dal desiderio di creare, esporre e progredire insieme, saranno liete di presentare la loro prima mostra collettiva, ELLE(S)."
    ],
    "fr": [
      "Du 9 mars au 28 avril, les Peintresses, un collectif de femmes peintres né du désir de créer, exposer et avancer ensemble. auront le plaisir de présenter leur première exposition collective, ELLE(S)."
    ],
    "nl": [
      "Van 9 maart tot 28 april presenteren de Peintresses, een collectief van vrouwelijke schilders geboren uit een verlangen om samen te creëren, te exposeren en vooruit te gaan, met veel plezier hun eerste groepstentoonstelling, ELLE(S)."
    ],
    "es": [
      "Del 9 de marzo al 28 de abril, las Peintresses, un colectivo de mujeres pintoras nacido del deseo de crear, exponer y avanzar juntas, tendrán el placer de presentar su primera exposición colectiva, ELLE(S)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Exposition | Elle(s) • Collectif Les Peintresses"
    ]
  },
