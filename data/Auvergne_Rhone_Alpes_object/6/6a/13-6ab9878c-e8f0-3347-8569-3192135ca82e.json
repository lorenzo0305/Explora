  "rdfs:comment": {
    "de": [
      "Die Kunst- und Kunsthandwerksgalerie \"Arts créateurs & Co solidaires\" beherbergt lokale Designer mit einem starken Image für das Recycling von Materialien und originellen, einzigartigen, aber für alle zugänglichen Produkten."
    ],
    "en": [
      "The \"Arts créateurs & Co solidaires\" arts & crafts gallery welcomes local designers with a strong image for recycling materials and original, unique products accessible to all."
    ],
    "it": [
      "La galleria d'arte e artigianato \"Arts créateurs & Co solidaires\" presenta designer locali con una forte attenzione al riciclo dei materiali e alla produzione di prodotti originali e unici, accessibili a tutti."
    ],
    "fr": [
      "La galerie d’arts & d’artisanat « Arts créateurs & Co solidaires »  accueille des créateurs locaux avec une image forte sur le recyclage des matières et des produits originaux, uniques mais accessibles à tous."
    ],
    "es": [
      "La galería de artesanía \"Arts créateurs & Co solidaires\" presenta a diseñadores locales muy centrados en el reciclaje de materiales y la elaboración de productos originales, únicos y accesibles a todos."
    ],
    "nl": [
      "De kunst- en ambachtsgalerie \"Arts créateurs & Co solidaires\" toont lokale ontwerpers met een sterk imago voor het recyclen van materialen en originele, unieke producten die voor iedereen toegankelijk zijn."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Boutique Arts Créateurs & Co Solidaires - Moulins"
    ]
  },
