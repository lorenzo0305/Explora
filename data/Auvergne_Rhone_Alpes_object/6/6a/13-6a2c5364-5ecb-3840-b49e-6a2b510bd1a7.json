  "rdfs:comment": {
    "de": [
      "Court-Circuit vereint Bio- und Umstellungsproduzenten. Wir alle teilen den Wunsch, eine bäuerliche, biologische und lokale Landwirtschaft in Chabeuil in der Drôme zu unterstützen."
    ],
    "en": [
      "Large range of organic and local products according to the seasons and productions.\r\n\r\nExclusively organic and local producers sell:\r\nFruit & Vegetables / Cheeses & dairy products / Meat & fish / Bread / Groceries / Beverages / Cosmetics"
    ],
    "it": [
      "Court-Circuit riunisce produttori biologici e in conversione. Tutti condividono il desiderio di sostenere l'agricoltura locale, biologica e contadina di Chabeuil, nella Drôme."
    ],
    "fr": [
      "Court-Circuit rassemble des producteurs bio ou en conversion. Tous, nous partageons l’envie de soutenir une agriculture paysanne, bio et locale à Chabeuil dans la Drôme."
    ],
    "nl": [
      "Uitgebreid assortiment van biologische en lokale producten op basis van de seizoenen en producties.\r\n\r\nProducenten, uitsluitend biologisch en lokaal, bieden: \r\nGroente & fruit/kaas & zuivelproducten/vlees & vis/brood/kruidenier/drank/cosmeticaproducten"
    ],
    "es": [
      "Court-Circuit reúne a productores ecológicos y en reconversión. Todos compartimos el deseo de apoyar la agricultura local, ecológica y campesina de Chabeuil, en la Drôme."
    ]
  },
