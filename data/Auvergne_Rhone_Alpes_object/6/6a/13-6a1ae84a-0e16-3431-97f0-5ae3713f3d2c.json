  "rdfs:comment": {
    "de": [
      "Gruppenkurse für Skifahren ab 5 Jahren und\r\nsnowboardkurse ab 8 Jahren. Sie\r\nwerden rund um Spiele und Aktivitäten organisiert\r\ndamit sie mit Spaß Fortschritte machen."
    ],
    "en": [
      "Group ski lessons for children aged 5 and over and\r\nsnowboard lessons from age 8. They\r\nare organised around games and activities\r\nto help them progress while having fun."
    ],
    "it": [
      "Lezioni di sci di gruppo per bambini dai 5 anni in su e\r\nlezioni di snowboard a partire dagli 8 anni. Sono\r\nsono organizzati con giochi e attività\r\nper aiutarli a progredire divertendosi."
    ],
    "fr": [
      "Des cours collectifs de ski à partir de 5 ans et\r\ndes cours de snowboard à partir de 8 ans. Ils\r\nsont organisés autour de jeux et d'activités\r\npour qu'ils progressent en s'amusant."
    ],
    "nl": [
      "Groepsskilessen voor kinderen vanaf 5 jaar en\r\nsnowboardlessen vanaf 8 jaar. Ze\r\nworden georganiseerd rond spelletjes en activiteiten\r\nom ze te helpen vooruitgang te boeken terwijl ze plezier maken."
    ],
    "es": [
      "Clases de esquí en grupo para niños a partir de 5 años y\r\nclases de snowboard a partir de 8 años. En\r\nse organizan en torno a juegos y actividades\r\npara que progresen divirtiéndose."
    ]
  },
