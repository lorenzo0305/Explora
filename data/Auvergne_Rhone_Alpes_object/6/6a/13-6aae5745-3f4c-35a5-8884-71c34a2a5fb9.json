  "rdfs:comment": {
    "de": [
      "Gegenüber dem Bahnhof von Le Mastrou bietet Ihnen der \"Table des Négociants\" ein Feinschmeckerpanorama der Spezialitäten der Ardèche. Eine hausgemachte Küche, die mit unseren zahlreichen lokalen Produkten zubereitet wird. Empfang in aller Einfachheit. Sonnige Terrasse."
    ],
    "en": [
      "Enjoy Ardèche specialties at Table des Négociants by Mastrou station: meal salad, entrecote with ceps, ravioli, trout, homemade ice cream. Home-cooked using local products. Warm welcome, sunny terrace."
    ],
    "it": [
      "Di fronte alla stazione di Le Mastrou, La Table des Négociants offre un panorama gastronomico di specialità dell'Ardèche. Cucina casalinga, realizzata con i nostri numerosi prodotti locali. Un'accoglienza calorosa. Terrazza soleggiata."
    ],
    "fr": [
      "Face à la gare du Mastrou, la table des Négociants vous offre un panorama gourmand des spécialités ardéchoises. Une cuisine maison, faite avec nos nombreux produits locaux. Accueil en toute simplicité. Terrasse ensoleillée."
    ],
    "nl": [
      "Table des Négociants: bij Mastrou station, ontdek Ardèche's specialiteiten - maaltijdsalade, eekhoorntjesbrood entrecote, ravioli, forel, huisgemaakt ijs. Lokale producten, authentieke gerechten, zonnig terras."
    ],
    "es": [
      "Frente a la estación de Le Mastrou, La Table des Négociants ofrece un panorama gastronómico de las especialidades de Ardèche. Cocina casera, elaborada con nuestros numerosos productos locales. Una cálida acogida. Terraza soleada."
    ]
  },
