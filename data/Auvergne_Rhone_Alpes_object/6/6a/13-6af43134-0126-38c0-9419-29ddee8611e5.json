  "rdfs:comment": {
    "de": [
      "Im Holzofen gebackene Pizzas nach reinster italienischer Tradition. Frische hausgemachte Nudeln. Gerichte und Tagesmenüs von Montag bis Freitag."
    ],
    "en": [
      "Pizzas cooked over a wood fire, in the purest of Italian traditions. Fresh, homemade pasta. Dishes and menus of the day, homemade tiramisu."
    ],
    "it": [
      "Pizze cotte a legna nella più pura tradizione italiana. Pasta fresca fatta in casa. Piatti e menu giornalieri dal lunedì al venerdì."
    ],
    "fr": [
      "Pizzas cuites au feu de bois dans la plus pure tradition italienne. Pâtes fraîches faites maison. Plats et menus du jour du lundi au vendredi."
    ],
    "es": [
      "Pizzas cocinadas a fuego de leña en la más pura tradición italiana. Pasta fresca casera. Platos y menús diarios de lunes a viernes."
    ],
    "nl": [
      "Pizza's gebakken op houtvuur in de zuiverste Italiaanse traditie. Verse zelfgemaakte pasta. Gerechten en dagmenu's van maandag tot vrijdag."
    ]
  },
