  "rdfs:comment": {
    "de": [
      "Zu Beginn des Monats Juli schließen sich Thé COsi und Chez les coincoins zusammen, um die Smoky Mountain Blues Band am Samstag, den 4. Juli um 19 Uhr auf dem Square René-Bardet zu empfangen."
    ],
    "en": [
      "For the start of July, Thé COsi and Chez les coincoins are teaming up to welcome the Smoky Mountain Blues Band on Saturday July 4 at 7pm in Square René-Bardet."
    ],
    "it": [
      "Per l'inizio di luglio, Thé COsi e Chez les coincoins uniscono le forze per accogliere la Smoky Mountain Blues Band sabato 4 luglio alle 19.00 in piazza René-Bardet."
    ],
    "fr": [
      "Pour ce début du mois de juillet Thé COsi et Chez les coincoins s'associent pour accueillir le groupe Smoky Mountain Blues Band le samedi 4 juillet à 19h sur le square René-Bardet."
    ],
    "es": [
      "Con motivo del inicio del mes de julio, Thé COsi y Chez les coincoins se unen para recibir a la Smoky Mountain Blues Band el sábado 4 de julio a las 19.00 h en la plaza René-Bardet."
    ],
    "nl": [
      "Begin juli verwelkomen Thé COsi en Chez les coincoins samen de Smoky Mountain Blues Band op zaterdag 4 juli om 19.00 uur op het René-Bardetplein."
    ]
  },
