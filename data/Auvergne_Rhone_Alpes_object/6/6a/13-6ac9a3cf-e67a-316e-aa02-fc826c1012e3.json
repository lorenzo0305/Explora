  "rdfs:comment": {
    "de": [
      "Im Herzen von Villefranche sur Saône, der Hauptstadt des Beaujolais, empfängt Sie das Hotel Mercure Villefranche-sur-Saône**** für Ihren Aufenthalt als Tourist oder Geschäftsreisender."
    ],
    "en": [
      "In the heart of Villefranche-sur-Saône, the capital of Beaujolais, the Mercure Hotel Villefranche-sur-Saône**** welcomes you for your tourist or professional stays."
    ],
    "it": [
      "Nel cuore di Villefranche sur Saône, capitale della regione del Beaujolais, l'Hôtel Mercure Villefranche-sur-Saône**** vi accoglie per i vostri soggiorni turistici o di lavoro."
    ],
    "fr": [
      "Au cœur de Villefranche sur Saône, capitale du Beaujolais, l’Hôtel Mercure Villefranche-sur-Saône**** vous accueille pour vos séjours touristiques ou professionnels."
    ],
    "nl": [
      "In het hart van Villefranche-sur-Saône, hoofdstad van de Beaujolais, heet Hôtel Mercure Villefranche-sur-Saône**** u welkom voor uw toeristische of zakelijke verblijven."
    ],
    "es": [
      "En el corazón de Villefranche sur Saône, capital de la región de Beaujolais, el Hôtel Mercure Villefranche-sur-Saône**** le da la bienvenida para sus estancias turísticas o de negocios."
    ]
  },
