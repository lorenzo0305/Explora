  "rdfs:comment": {
    "de": [
      "Lust auf einen zünftigen Après-Ski? Dann besuchen Sie die Bar des RockyPop Flaine!\r\nGenießen Sie diese verrückte Welt mit Familie oder Freunden und probieren Sie eine große Auswahl an Cocktails, Bieren, Weinen, Softdrinks... und dazu süße und salzige Leckereien."
    ],
    "en": [
      "If you're in the mood for some après-ski fun, head to the RockyPop Flaine bar!\r\nCome and enjoy this crazy world with your family or friends, and sample a wide choice of cocktails, beers, wines, soft drinks... accompanied by sweet and savoury treats."
    ],
    "it": [
      "Se avete voglia di divertirvi dopo lo sci, recatevi al bar RockyPop Flaine!\r\nVenite a godervi questo mondo folle con la famiglia o con gli amici e assaggiate un'ampia scelta di cocktail, birre, vini, bevande analcoliche... accompagnate da dolci e salati."
    ],
    "fr": [
      "Envie d’un après-ski qui décoiffe : rendez-vous au bar du RockyPop Flaine !\r\nVenez profitez de cet univers un peu fou en famille ou entre amis, et dégustez un grand choix de cocktails, bières, vins, soft... accompagnés de gourmandises salées/sucrées."
    ],
    "es": [
      "Si le apetece divertirse después de esquiar, vaya al bar RockyPop Flaine\r\nVenga a disfrutar de este mundo de locos con su familia o amigos, y deguste una amplia selección de cócteles, cervezas, vinos, refrescos... acompañados de golosinas dulces y saladas."
    ],
    "nl": [
      "Als je zin hebt in wat après-ski plezier, ga dan naar de RockyPop Flaine bar!\r\nKom samen met je familie of vrienden genieten van deze gekke wereld en proef een ruime keuze aan cocktails, bieren, wijnen, frisdranken... vergezeld van zoete en hartige lekkernijen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Bar du RockyPop Flaine"
    ]
  },
