  "rdfs:comment": {
    "de": [
      "Von den Algorithmen von Google Street View bis hin zu Hightech-Laboren stellen diese Filme die Frage nach dem Platz von Mensch und Tier in einer hypervernetzten Welt. Drei zeitgenössische Fabeln, die an der Grenze zwischen Realität, Virtualität und Imagination navigieren."
    ],
    "en": [
      "From Google Street View algorithms to cutting-edge laboratories, these films question the place of humans and animals in a hyper-connected world. Three contemporary fables that navigate the frontiers of the real, the virtual and the imaginary."
    ],
    "it": [
      "Dagli algoritmi di Google Street View ai laboratori all'avanguardia, questi film esplorano il posto di uomini e animali in un mondo iperconnesso. Tre favole contemporanee che navigano tra i confini del reale, del virtuale e dell'immaginario."
    ],
    "fr": [
      "Des algorithmes de Google Street View aux laboratoires de pointe, ces films interrogent la place de l'humain et de l'animal dans un monde hyper-connecté. Trois fables contemporaines qui naviguent à la frontière du réel, du virtuel et de l’imaginaire."
    ],
    "nl": [
      "Van Google Street View-algoritmen tot geavanceerde laboratoria, deze films onderzoeken de plaats van mens en dier in een hyperverbonden wereld. Drie hedendaagse fabels die navigeren over de grenzen tussen het echte, het virtuele en het denkbeeldige."
    ],
    "es": [
      "Desde los algoritmos de Google Street View hasta los laboratorios de vanguardia, estas películas exploran el lugar de los seres humanos y los animales en un mundo hiperconectado. Tres fábulas contemporáneas que navegan por las fronteras entre lo real, lo virtual y lo imaginario."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Séance Nature 2.0 - Festival du Film Nature"
    ]
  },
