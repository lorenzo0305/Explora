  "rdfs:comment": {
    "de": [
      "Entdecken Sie eine traditionelle französische Brasserie von hoher Qualität, die über eine gemütliche Atmosphäre verfügt. Genießen Sie unsere traditionellen Gerichte, unsere Lyoner Spezialitäten sowie unsere Auswahl an Meeresfrüchten."
    ],
    "en": [
      "Discover a traditional French brasserie of quality, with a warm atmosphere. You will be able to taste our traditional dishes, our specialities from Lyon, as well as our selection of seafood."
    ],
    "it": [
      "Scoprite una brasserie tradizionale francese di qualità, con un'atmosfera accogliente. Potrete gustare i nostri piatti tradizionali, le nostre specialità lionesi e la nostra selezione di frutti di mare."
    ],
    "fr": [
      "Découvrez une brasserie traditionnelle française de qualité, dotée d'une ambiance chaleureuse. Vous pourrez déguster nos plats traditionnels, nos spécialités lyonnaises, ainsi que notre sélection de fruits de mer."
    ],
    "nl": [
      "Ontdek een traditionele Franse brasserie van kwaliteit, met een warme sfeer. U kunt genieten van onze traditionele gerechten, onze specialiteiten uit Lyon en onze selectie zeevruchten."
    ],
    "es": [
      "Descubra una brasserie tradicional francesa de calidad, con un ambiente cálido. Podrá degustar nuestros platos tradicionales, nuestras especialidades de Lyon, así como nuestra selección de mariscos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Bar du Glacier"
    ]
  },
