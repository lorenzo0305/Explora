  "rdfs:comment": {
    "de": [
      "Entdecken Sie den Geschmack der Jahreszeiten durch das Gemüse, das 5 km von Saugues entfernt angebaut wird, neu!\r\nAurélien und Thibault begrüßen Sie in ihrem Laden in Saugues, wo Sie auch eine große Auswahl an lokalen Produkten (Käse, Wurstwaren, Marmeladen...) finden."
    ],
    "en": [
      "Rediscover the taste of the seasons with vegetables grown just 5 km from Saugues!\r\nAurélien and Thibault welcome you to their store in Saugues, where you'll also find a wide range of local products (cheeses, charcuterie, jams...)."
    ],
    "it": [
      "Riscoprite il gusto delle stagioni con le verdure coltivate a soli 5 km da Saugues!\r\nAurélien e Thibault vi danno il benvenuto nel loro negozio di Saugues, dove troverete anche una vasta gamma di prodotti locali (formaggi, salumi, marmellate, ecc.)."
    ],
    "fr": [
      "Redécouvrez le goût des saisons à travers les légumes cultivés à 5 km de Saugues !\r\nAurélien et Thibault vous accueillent dans leur magasin à Saugues, où vous trouverez également une large gamme de produits locaux (fromages, charcuterie, confitures...)."
    ],
    "es": [
      "¡Redescubra el sabor de las estaciones con verduras cultivadas a sólo 5 km de Saugues!\r\nAurélien y Thibault le dan la bienvenida a su tienda de Saugues, donde también encontrará una amplia gama de productos locales (quesos, charcutería, mermeladas, etc.)."
    ],
    "nl": [
      "Herontdek de smaak van de seizoenen met groenten geteeld op slechts 5 km van Saugues!\r\nAurélien en Thibault heten je welkom in hun winkel in Saugues, waar je ook een breed scala aan lokale producten vindt (kazen, vleeswaren, jam, enz.)."
    ]
  },
  "rdfs:label": {
