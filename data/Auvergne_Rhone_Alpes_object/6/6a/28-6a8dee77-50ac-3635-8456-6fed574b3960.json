  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/456a4f81-30b1-352b-be23-cb6911e4dc91",
      "dc:description": {
        "de": [
          "Jahrhunderts ermöglichte es den Einwohnern, das Recht auf eine Glocke zu erhalten, mit der sie sich versammeln, den Rhythmus des Stadtlebens bestimmen oder auch vor Gefahren warnen konnten. Es wurde 2013 in die Liste der historischen Denkmäler aufgenommen."
        ],
        "en": [
          "Dating from the end of the 18th century, this aldermanic building enabled local residents to obtain bell rights, which enabled them to hold meetings, set the pace of town life and warn of danger. It was listed as a historic monument in 2013."
        ],
        "it": [
          "Risalente alla fine del XVIII secolo, questo edificio assessorile permise agli abitanti di ottenere il diritto a una campana, che consentiva loro di riunirsi, di scandire i ritmi di vita della città o di avvisare dei pericoli. Nel 2013 è stato classificato come monumento storico."
        ],
        "fr": [
          "Cet échevinage datant de la fin du XVIIIème siècle permis aux habitants d'obtenir le droit de cloche, qui leur permettait de se réunir, de rythmer la vie de la ville ou encore d'alerter des dangers. Il a été inscrit au titre des monuments historiques en 2013."
        ],
        "nl": [
          "Dit schepengebouw dateert uit het einde van de 18e eeuw en stelde de inwoners in staat om het recht op een klok te verkrijgen, waarmee ze konden vergaderen, het tempo van het leven in de stad konden bepalen of voor gevaar konden waarschuwen. Het werd in 2013 op de monumentenlijst geplaatst."
        ],
        "es": [
          "De finales del siglo XVIII, este edificio concejil permitió a los habitantes obtener el derecho a una campana, que les permitía reunirse, marcar el ritmo de la vida en la ciudad o advertir de un peligro. Fue declarado monumento histórico en 2013."
        ]
      },
