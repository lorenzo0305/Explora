  "rdfs:comment": {
    "de": [
      "Designerin von Kleidung, Brautkleidern, aber auch von Einrichtungsgegenständen und Dekorationen.\r\nKurse für pflanzliche Färbemittel im Atelier.\r\nArtikel zum Verkauf in der Boutique \"Les Voisines\""
    ],
    "en": [
      "Designer of garments and wedding dresses, as well as home furnishings and decorative objects.\r\nVegetable dyeing workshops at the studio.\r\nItems for sale at the \"Les Voisines\" boutique"
    ],
    "it": [
      "Stilista di abiti e vestiti da sposa, oltre che di arredi per la casa e oggetti decorativi.\r\nCorsi di tintura vegetale presso l'atelier.\r\nArticoli in vendita nella boutique \"Les Voisines\""
    ],
    "fr": [
      "Créatrice de vêtements, robes de mariées mais aussi d'objets d’ameublements et de décoration.\r\nStages de teintures végétales à l’atelier.\r\nArticles en vente à la boutique « Les Voisines »"
    ],
    "nl": [
      "Ontwerper van kleding en trouwjurken, maar ook van woninginrichting en decoratieve artikelen.\r\nCursussen plantaardig verven in het atelier.\r\nArtikelen te koop in de boetiek \"Les Voisines\""
    ],
    "es": [
      "Diseñadora de ropa y vestidos de novia, así como de muebles para el hogar y artículos de decoración.\r\nCursos de teñido vegetal en el taller.\r\nArtículos a la venta en la boutique \"Les Voisines\""
    ]
  },
  "rdfs:label": {
