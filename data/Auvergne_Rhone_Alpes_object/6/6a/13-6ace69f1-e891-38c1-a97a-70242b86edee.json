  "rdfs:comment": {
    "de": [
      "Skiaoz, eine kleine, freundliche Skischule mit unabhängigen Skilehrern, bietet Ihnen: Skifahren, Snowboarden, Off-Piste und Skitouren, Anfänger oder Fortgeschrittene!"
    ],
    "en": [
      "Skiaoz is a little school made of independent insctructors based on the initial training regulations. \r\nThe school suggests you ski and snowboard initiation, improvement sessions, off-piste and cross-country skiing."
    ],
    "it": [
      "Skiaoz, una piccola e accogliente scuola di sci con istruttori indipendenti, offre lezioni per principianti e avanzati di sci, snowboard, fuoripista e sci alpinismo!"
    ],
    "fr": [
      "Skiaoz, petite école de ski conviviale composée de moniteurs indépendants, vous propose : ski, snowboard, hors-piste et ski de randonnée, en initiation ou perfectionnement!  ."
    ],
    "es": [
      "Skiaoz, una pequeña y acogedora escuela de esquí con profesores independientes, ofrece clases para principiantes y avanzados de esquí, snowboard, fuera de pista y esquí de travesía."
    ],
    "nl": [
      "Skiaoz is een kleine skischool die wordt bemand door onafhankelijke instructeurs die allemaal in het bezit zijn van staatskwalificaties.\r\nJe kunt bij ons skiën en snowboarden, beginners, gevorderden, off-piste en toerskiën."
    ]
  },
