  "rdfs:comment": {
    "de": [
      "Escape Games Kid's Party: Wenn das Spiel und der Snack direkt zu Ihnen nach Hause kommen!\r\nDas eigenständige Escape Game für zu Hause, das einen kompletten Geburtstagssnack liefert und dabei Spaß macht."
    ],
    "en": [
      "Escape Games Kid's Party: when the game and the snack come straight to your home!\r\nThe stand-alone home escape game that delivers a complete birthday party while having fun."
    ],
    "it": [
      "Escape Games Kid's Party: quando il gioco e la merenda vengono direttamente da te!\r\nIl gioco di fuga a casa indipendente che offre una merenda completa per il compleanno mentre ci si diverte."
    ],
    "fr": [
      "Escape Games Kid's Party : quand le jeu et le goûter viennent directement chez vous !\r\nL’escape game autonome à domicile qui délivre un goûter d'anniversaire complet tout en s’amusant."
    ],
    "nl": [
      "Escape Games Kid's Party: wanneer het spel en de snack rechtstreeks naar je huis komen!\r\nHet stand-alone ontsnappingsspel voor thuis dat een volledige verjaardagssnack oplevert terwijl je plezier hebt."
    ],
    "es": [
      "Escape Games Kid's Party: ¡cuando el juego y la merienda vienen directamente a ti!\r\nEl juego de escape a domicilio que te ofrece una merienda de cumpleaños completa mientras te diviertes."
    ]
  },
