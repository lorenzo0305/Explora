  "rdfs:comment": {
    "de": [
      "Die einzigartig reichhaltige Sammlung, die Umgebung und die kühne Architektur des Museums versetzen einen, dank des beeindruckenden unterirdischen Parcours, in eine andere Zeit."
    ],
    "en": [
      "Unique for the sheer richness of its collections, its environment and its bold architecture, thanks to an astonishing underground exhibition trail, the museum proposes a genuine journey back in time."
    ],
    "it": [
      "Il museo, unico per la ricchezza delle sue collezioni, il luogo e per la sua architettura audace, propone un vero e proprio viaggio nel tempo grazie a un incredibile percorso sotterraneo."
    ],
    "fr": [
      "La Métropole de Lyon, héritière du riche patrimoine gallo-romain de Lugdunum, offre un rendez-vous historique incontournable sur la colline de Fourvière."
    ],
    "es": [
      "Único por la riqueza de sus colecciones, su medio ambiante y su arquitectura osada el museo propone recorrido subterráneo, un viaje a través del tiempo."
    ],
    "nl": [
      "De metropool Lyon, erfgenaam van het rijke Gallo-Romeinse erfgoed van Lugdunum, biedt een niet te missen historisch rendez-vous op de heuvel Fourvière."
    ]
  },
