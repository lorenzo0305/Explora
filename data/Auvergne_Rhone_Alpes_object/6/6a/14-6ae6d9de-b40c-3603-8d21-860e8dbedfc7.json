  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/fdc2c2af-f4c0-387f-b7e0-675d23e0ca52",
      "dc:description": {
        "de": [
          "Samstag, 9. September 2023\n\nVon 10.00 Uhr bis 17.00 Uhr.\nAnimationen und Spiele, aufblasbare Strukturen.\nWir warten auf dich, um Fußball zu spielen und Spaß zu haben!\n\nAn einem Ort namens \"La banane\", links vom Aqualud."
        ],
        "en": [
          "Saturday, September 9, 2023\n\nFrom 10 a.m. to 5 p.m.\nEntertainment and matches, inflatable structures.\nWe're waiting for you to play soccer and have fun!\n\nAt \"La banane\", to the left of Aqualud."
        ],
        "it": [
          "Sabato 9 settembre 2023\n\nDalle 10.00 alle 17.00.\nAnimazione e partite, strutture gonfiabili.\nVi aspettiamo per giocare a calcio e divertirvi!\n\nPresso \"La banane\", a sinistra di Aqualud."
        ],
        "fr": [
          "Samedi 9 septembre 2023\n\nDe 10h à 17h.\nAnimations et matches, structures gonflables.\nOn t'attend pour jouer au foot et t'amuser !\n\nAu lieu dit 'La banane\", à gauche de l'Aqualud."
        ],
        "nl": [
          "Zaterdag 9 september 2023\n\nVan 10.00 tot 17.00 uur.\nAnimatie en wedstrijden, opblaasbare structuren.\nWe wachten op jou om te voetballen en plezier te maken!\n\nBij \"La banane\", links van Aqualud."
        ],
        "es": [
          "Sábado 9 de septiembre de 2023\n\nDe 10.00 a 17.00 horas.\nAnimación y partidos, estructuras hinchables.\n¡Te esperamos para jugar al fútbol y divertirnos!\n\nEn \"La banane\", a la izquierda de Aqualud."
        ]
      },
      "@type": [
        "Description"
