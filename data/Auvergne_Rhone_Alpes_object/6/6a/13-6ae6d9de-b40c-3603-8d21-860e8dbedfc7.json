  "rdfs:comment": {
    "de": [
      "Unabhängiger Designer.\r\nHerstellung von zeitgenössischen Einzelstücken aus Massivholz (Eiche, Esche, Ahorn usw.).\r\nStudie von personalisierten Projekten...Treppen nach Maß"
    ],
    "en": [
      "Independent designer.\r\nRealization of unique contemporary pieces in solid wood (oak, ash, maple, etc.).\r\nStudy of personalized projects...Staircases made to measure"
    ],
    "it": [
      "Progettista indipendente.\r\nCreazione di pezzi unici contemporanei in legno massiccio (rovere, frassino, acero, ecc.).\r\nStudio di progetti personalizzati... Scale su misura"
    ],
    "fr": [
      "Créateur indépendant.\r\nRéalisation de pièces uniques contemporaines en bois massif (Chêne, frêne, érable, etc.).\r\nÉtude de projets personnalisés...Escaliers sur mesures"
    ],
    "es": [
      "Diseñador independiente.\r\nCreación de piezas contemporáneas únicas en madera maciza (roble, fresno, arce, etc.).\r\nEstudio de proyectos personalizados... Escaleras a medida"
    ],
    "nl": [
      "Bernard Bouchault is een onafhankelijk ontwerper die hedendaagse werkstukken (o.a. meubels en trappen) maakt in massief hout. Hij werkt met houtsoorten zoals eik of esdoorn. U kunt steeds contact met hem opnemen om werken op maat te laten uitvoeren."
    ]
  },
