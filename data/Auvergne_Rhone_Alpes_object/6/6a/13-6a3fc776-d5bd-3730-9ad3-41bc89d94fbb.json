  "rdfs:comment": {
    "de": [
      "Bibliothek, CDs, DVDs, Zeitschriften, alte Postkarten, Kriegszeitungen, Erinnerungen an die großen Konflikte 1914/1918 und 1939-1945, Fahnen...\r\nBücher, CDs und DVDs können kostenlos ausgeliehen werden.\r\nWenn Sie sich für Geschichte interessieren, besuchen Sie uns..."
    ],
    "en": [
      "Library, CDs, DVDs, magazines, old postcards, war diaries, souvenirs of the great conflicts of 1914/1918 and 1939-1945, flags...\r\nBooks, CDs and DVDs can be borrowed free of charge.\r\nIf you love history, come and visit us..."
    ],
    "it": [
      "Biblioteca, CD, DVD, riviste, vecchie cartoline, giornali di guerra, souvenir dei grandi conflitti del 1914/1918 e del 1939-1945, bandiere...\r\nLibri, CD e DVD possono essere presi in prestito gratuitamente.\r\nSe vi piace la storia, venite a trovarci..."
    ],
    "fr": [
      "Bibliothèque, CD, DVD, revues, cartes postales anciennes, journaux de guerre, souvenirs des grands conflits 1914/1918 et 1939-1945, drapeaux...\r\nPossibilité d'emprunter gracieusement livres, CD et DVD.\r\nSi vous aimez l'Histoire, venez nous rendre visite..."
    ],
    "nl": [
      "Bibliotheek, cd's, dvd's, tijdschriften, oude ansichtkaarten, oorlogsdagboeken, souvenirs van de grote conflicten van 1914/1918 en 1939-1945, vlaggen, enz.\r\nJe kunt gratis boeken, cd's en dvd's lenen.\r\nAls je van geschiedenis houdt, kom ons dan bezoeken..."
    ],
    "es": [
      "Biblioteca, CDs, DVDs, revistas, postales antiguas, periódicos de guerra, recuerdos de los grandes conflictos de 1914/1918 y 1939-1945, banderas...\r\nLos libros, CDs y DVDs pueden prestarse gratuitamente.\r\nSi le gusta la historia, venga a visitarnos..."
    ]
  },
