  "rdfs:comment": {
    "de": [
      "Solidaritätswanderung Main dans la Main: zu Fuß (6/12/18 km) und mit dem Mountainbike (20/30/50 km) zugunsten von Mali, Elfenbeinküste und Ukraine. Treffpunkt: Bahnhof Oumey, 7:30-15:00 Uhr. Anmeldung vor Ort: 6-10? Erwachsene, kostenlos -10 Jahre. Verpflegung inbegriffen."
    ],
    "en": [
      "Main dans la Main solidarity hike: walking (6/12/18 km) and mountain biking (20/30/50 km) to benefit Mali, Côte d'Ivoire and Ukraine. RDV gare d'Oumey 7h30-15h. On-site registration: 6-10? adults, free for under-10s. Refreshments included."
    ],
    "it": [
      "Camminata solidale Main dans la Main: a piedi (6/12/18 km) e in mountain bike (20/30/50 km) a favore di Mali, Costa d'Avorio e Ucraina. Punto d'incontro: stazione di Oumey, dalle 7.30 alle 15.00. Iscrizioni in loco: 6-10? adulti, gratis per i minori di 10 anni. Ristoro incluso."
    ],
    "fr": [
      "Randonnée solidaire Main dans la Main : pédestre (6/12/18 km) et VTT (20/30/50 km) au profit du Mali, Côte d'Ivoire et Ukraine. RDV gare d'Oumey 7h30-15h. Inscription sur place : 6-10€ adultes, gratuit -10 ans. Ravitaillement inclus."
    ],
    "es": [
      "Marcha solidaria Main dans la Main: senderismo (6/12/18 km) y bicicleta de montaña (20/30/50 km) a favor de Malí, Costa de Marfil y Ucrania. Punto de encuentro: estación de Oumey, de 7.30 a 15.00 h. Inscripción in situ: 6-10? adultos, gratuita para los menores de 10 años. Refrescos incluidos."
    ],
    "nl": [
      "Main dans la Main solidariteitswandeling: wandelen (6/12/18 km) en mountainbiken (20/30/50 km) ten voordele van Mali, Ivoorkust en Oekraïne. Verzamelpunt: station Oumey, 7.30-3.00 uur. Inschrijving ter plaatse: 6-10? volwassenen, gratis voor kinderen onder de 10 jaar. Versnaperingen inbegrepen."
    ]
  },
