  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/f98088ea-4802-36c2-bc89-f130664bf020",
      "dc:description": {
        "de": [
          "Meine kleine Familie\nSpielwarenladen, traditionelles Spielzeug, Geschenke zur Geburt, Holzspielzeug, Strandspielzeug, Plüschtiere: viele kleine niedliche Dinge. Familiäre Atmosphäre."
        ],
        "en": [
          "Ma Petite Famille\nStore for games, traditional toys, baby gifts, wooden toys, beach toys, plush toys: lots of little cuties. Family spirit."
        ],
        "it": [
          "La mia piccola famiglia\nAcquista giochi, giocattoli tradizionali, regali per bambini, giocattoli in legno, giocattoli da spiaggia, peluche: tante piccole chicche. Spirito di famiglia."
        ],
        "fr": [
          "Ma Petite Famille\nBoutique de jeux, jouets traditionnels, cadeaux de naissance, jouets en bois, jouets de plage, peluches : pleins de petites mignonneries. Esprit familial."
        ],
        "nl": [
          "Mijn kleine familie\nShop voor spelletjes, traditioneel speelgoed, geboortecadeaus, houten speelgoed, strandspeelgoed, knuffels: heel veel kleine goodies. Familiegevoel."
        ],
        "es": [
          "Mi pequeña familia\nTienda de juegos, juguetes tradicionales, regalos para bebés, juguetes de madera, juguetes de playa, peluches: un montón de pequeñas golosinas. Espíritu de familia."
        ]
      },
