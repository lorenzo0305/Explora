  "rdfs:comment": {
    "de": [
      "Unter den Sonnenschirmen lässt man sich die Sonne auf den Bauch scheinen, schließt die Augen und genießt ein Bier oder einen lokalen Weißwein: Es ist Zeit für einen Aperitif und niemand kommt zu kurz!"
    ],
    "en": [
      "Under the parasols, let the sun slide in, close your eyes and enjoy a beer or a local white wine: it's aperitif time and no one's missing out!"
    ],
    "it": [
      "Sotto gli ombrelloni, lasciate scivolare il sole, chiudete gli occhi e gustate una birra o un vino bianco locale: è l'ora dell'aperitivo e nessuno se lo perde!"
    ],
    "fr": [
      "Sous les parasols, on laisse le soleil se glisser, on ferme les yeux et on déguste une bière, un petit blanc local : C'est l'heure de l'apéro et personne ne manque à l'appel!"
    ],
    "nl": [
      "Onder de parasols, laat de zon naar binnen glijden, sluit je ogen en geniet van een biertje of een lokale witte wijn: het is aperitieftijd en niemand komt tekort!"
    ],
    "es": [
      "Bajo las sombrillas, déjese deslizar por el sol, cierre los ojos y disfrute de una cerveza o un vino blanco de la tierra: ¡es la hora del aperitivo y nadie se lo pierde!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Café du Midi"
    ]
  },
