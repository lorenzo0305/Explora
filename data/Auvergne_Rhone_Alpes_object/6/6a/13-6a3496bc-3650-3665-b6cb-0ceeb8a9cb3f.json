  "rdfs:comment": {
    "de": [
      "Die neue Mediathek in La Rochette bietet für Groß und Klein alles, was das Herz begehrt:\r\nAlben, Märchen, Romane, Dokumentarfilme, Comics, Mangas, Zeitschriften, Comics, Musik, Dokumentar- und Spielfilme, Hör- und Videostationen und mehrere Internetstationen."
    ],
    "en": [
      "The new media library in La Rochette will satisfy young and old alike:\r\nAlbums, Tales, Novels, Documentaries, Comics, Mangas, Magazines, Comics, Music, Documentary and Fiction Films, Listening and Video stations and several Internet stations."
    ],
    "it": [
      "La nuova mediateca di La Rochette soddisferà grandi e piccini:\r\nAlbum, racconti, romanzi, documentari, fumetti, manga, riviste, fumetti, musica, film documentari e di fiction, stazioni di ascolto e video e diverse stazioni Internet."
    ],
    "fr": [
      "La nouvelle médiathèque de La Rochette contentera petits et grands :\r\nAlbums, Contes, Romans, Documentaires, BD, Mangas, Revues, Bandes dessinées, Comics, Musique, Films documentaires et fictions, Postes d'écoute et vidéo et plusieurs postes Internet."
    ],
    "es": [
      "La nueva mediateca de La Rochette satisfará a grandes y pequeños:\r\nÁlbumes, Cuentos, Novelas, Documentales, Cómics, Mangas, Revistas, Cómics, Música, Películas documentales y de ficción, Estaciones de escucha y vídeo y varias estaciones de Internet."
    ],
    "nl": [
      "De nieuwe mediatheek in La Rochette zal jong en oud tevreden stellen:\r\nAlbums, verhalen, romans, documentaires, strips, manga's, tijdschriften, stripboeken, muziek, documentaire en fictiefilms, luister- en videostations en verschillende internetstations."
    ]
  },
