  "rdfs:comment": {
    "de": [
      "Ein unumgänglicher Spaziergang in Valloire! Auf dieser Strecke mit mittlerem Schwierigkeitsgrad entdecken Sie den Lac du Grand Ban über den Pass und das Militärlager von Rochilles. Bewundern Sie diese drei natürlichen Hochgebirgsseen und die atemberaubende Landschaft!"
    ],
    "en": [
      "A must-do walk in Valloire! This intermediate-level trail will take you over the Lac du Grand Ban, through the Col and the Rochilles military camp. Admire these three natural high-altitude lakes and the breathtaking scenery!"
    ],
    "it": [
      "Un'escursione da non perdere a Valloire! Questo percorso di livello intermedio vi porterà sul Lac du Grand Ban passando per il Col e il campo militare di Rochilles. Ammirate i tre laghi naturali d'alta quota e il paesaggio mozzafiato!"
    ],
    "fr": [
      "Balade incontournable à Valloire ! Ce parcours de niveau intermédiaire vous fera découvrir le Lac du Grand Ban en passant par le col et le camp militaire des Rochilles. Admirez ces trois lacs d'altitude naturels et les paysages à couper le souffle !"
    ],
    "es": [
      "Un paseo imprescindible en Valloire Esta ruta de nivel intermedio le llevará por el Lago del Grand Ban, pasando por el Col y el campamento militar de Rochilles. Admire los tres lagos naturales de gran altitud y los impresionantes paisajes"
    ],
    "nl": [
      "Een niet te missen wandeling in Valloire! Deze route van gemiddeld niveau neemt je mee over het Lac du Grand Ban via de Col en het militaire kamp van Rochilles. Bewonder de drie natuurlijke meren op grote hoogte en het adembenemende landschap!"
    ]
  },
  "rdfs:label": {
    "de": [
