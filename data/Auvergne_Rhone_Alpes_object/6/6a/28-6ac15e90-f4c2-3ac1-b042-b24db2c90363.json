  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/a5a1fdf3-d3eb-3726-a8f1-2ff560d7407e",
      "dc:description": {
        "de": [
          "Die Mediathek in Berteaucourt-les-Dames empfängt Sie :\n- am Dienstag von 14:00 bis 18:00 Uhr ;\n- am Mittwoch von 9:00 bis 12:00 Uhr und von 14:00 bis 18:00 Uhr ;\n- am Freitag von 14:00 bis 17:00 Uhr ;\n- samstags von 9:00 bis 12:00 Uhr und jeden zweiten Samstag von 14:00 bis 16:30 Uhr."
        ],
        "en": [
          "The media library of Berteaucourt-les-Dames welcomes you:\n- tuesday from 14:00 to 18:00;\n- wednesdays from 9:00 to 12:00 and from 14:00 to 18:00;\n- friday from 14:00 to 17:00;\n- saturday from 9:00 am to 12:00 pm and every other Saturday from 2:00 pm to 4:30 pm."
        ],
        "it": [
          "La mediateca di Berteaucourt-les-Dames vi dà il benvenuto:\n- il martedì dalle 14.00 alle 18.00;\n- mercoledì dalle 9.00 alle 12.00 e dalle 14.00 alle 18.00;\n- venerdì dalle 14:00 alle 17:00;\n- sabato dalle 9.00 alle 12.00 e ogni altro sabato dalle 14.00 alle 16.30."
        ],
        "fr": [
          "La médiathèque de Berteaucourt-les-Dames vous accueille :\n- le mardi de 14h00 à 18h00 ;\n- le mercredi de 9h00 à 12h00 et de 14h00 à 18h00 ;\n- le vendredi de 14h00 à 17h00 ;\n- le samedi de 9h00 à 12h00 et un samedi sur deux, de 14h00 à 16h30."
        ],
        "es": [
          "La mediateca de Berteaucourt-les-Dames le da la bienvenida:\n- los martes de 14 a 18 horas;\n- los miércoles de 9 a 12 y de 14 a 18 horas;\n- viernes de 14 a 17 horas;\n- los sábados de 9 a 12 horas y los sábados alternos de 14 a 16.30 horas."
        ],
        "nl": [
          "De mediatheek van Berteaucourt-les-Dames heet u welkom:\n- dinsdags van 14.00 tot 18.00 uur;\n- woensdag van 9 tot 12 uur en van 14 tot 18 uur;\n- vrijdag van 14.00 tot 17.00 uur;\n- op zaterdag van 9 tot 12 uur en om de andere zaterdag van 14 tot 16.30 uur."
        ]
      },
