  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/c667d19a-f70c-32fb-b962-48212a241418",
      "dc:description": {
        "de": [
          "Entdecke auf spielerische Weise den Hafen von Boulogne und die Einrichtungen, die für den Fischfang und die Freizeitschifffahrt notwendig sind.\nRV Villa Huguet, 115 boulevard Eurvin, Boulogne-sur-Mer\nPreis: 4 ?\nEnde des Kartenverkaufs am Vortag um 17 Uhr"
        ],
        "en": [
          "Have fun discovering the port of Boulogne and the facilities essential to its fishing and yachting activities.\nRV Villa Huguet, 115 boulevard Eurvin, Boulogne-sur-Mer\nPrice: 4 ?\nTickets close at 5pm the day before the tour"
        ],
        "it": [
          "Divertitevi a scoprire il porto di Boulogne e le strutture essenziali per le attività di pesca e diportistiche.\nRV Villa Huguet, 115 boulevard Eurvin, Boulogne-sur-Mer\nPrezzo: 4 euro\nI biglietti chiudono alle 17.00 del giorno precedente la visita"
        ],
        "fr": [
          "Découvre en t’amusant le port de Boulogne, les équipements indispensables à son activité de pêche et de plaisance.\nRV Villa Huguet, 115 boulevard Eurvin, Boulogne-sur-Mer\nTarif : 4 €\nClôture de billetterie la veille à 17h"
        ],
        "nl": [
          "Veel plezier met het ontdekken van de haven van Boulogne en de faciliteiten die essentieel zijn voor de visserij- en jachtactiviteiten.\nRV Villa Huguet, 115 boulevard Eurvin, Boulogne-sur-Mer\nPrijs: €4\nTickets sluiten om 17.00 uur de dag voor de tour"
        ],
        "es": [
          "Diviértase descubriendo el puerto de Boulogne y las instalaciones indispensables para sus actividades pesqueras y náuticas.\nRV Villa Huguet, 115 boulevard Eurvin, Boulogne-sur-Mer\nPrecio: 4 euros\nLas entradas se cierran a las 17.00 h del día anterior a la visita"
        ]
      },
