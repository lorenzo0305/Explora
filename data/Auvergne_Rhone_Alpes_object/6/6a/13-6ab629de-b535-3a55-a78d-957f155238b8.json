  "rdfs:comment": {
    "de": [
      "Ich befinde mich in Saint-Marcel-lès-Valence, im Herzen des Ballungsraums Valence Romans Agglo, und biete Ihnen die Entdeckung unseres kulturellen und gastronomischen Erbes durch Besuche von Dörfern, historischen Denkmälern, Weinbergen und Weinkellern an."
    ],
    "en": [
      "Located in Saint-Marcel-lès-Valence, in the heart of the Valence Romans Agglo conurbation, I offer you the discovery of our cultural and gastronomic heritage through visits to villages, historical monuments, vineyards and caves."
    ],
    "it": [
      "Situato a Saint-Marcel-lès-Valence, nel cuore dell'agglomerato di Valence Romans, vi propongo di scoprire il nostro patrimonio culturale e gastronomico attraverso visite a villaggi, monumenti storici, vigneti e cantine."
    ],
    "fr": [
      "Situé à Saint-Marcel-lès-Valence, au cœur de l'agglomération Valence Romans Agglo, je vous propose la découverte de notre patrimoine culturel et gastronomique à travers des visites de villages, monuments historiques, vignobles et caves."
    ],
    "es": [
      "Situado en Saint-Marcel-lès-Valence, en el corazón de la Aglomeración Romana de Valence, le ofrezco el descubrimiento de nuestro patrimonio cultural y gastronómico a través de visitas a pueblos, monumentos históricos, viñedos y bodegas."
    ],
    "nl": [
      "Gelegen in Saint-Marcel-lès-Valence, in het hart van de agglomeratie Valence Romans Agglo, kan ik je helpen ons cultureel en gastronomisch erfgoed te ontdekken door middel van bezoeken aan dorpen, historische monumenten, wijngaarden en wijnkelders."
    ]
  },
