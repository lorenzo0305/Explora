  "rdfs:comment": {
    "de": [
      "Kirche Saint-Jean-Baptiste (12. Jh.) - Ehemalige mittelalterliche Festung mit einem stumpfen Glockenturm, dessen Geheimnis gelüftet ist. Bewundern Sie das Glasfenster des Heiligen Martin, Bischof und Schutzpatron der Pilger."
    ],
    "en": [
      "The Saint-Jean-Baptiste church dates from the XIIth century.  The church has the particularity of having a truncated belfry"
    ],
    "it": [
      "Église Saint-Jean-Baptiste (XII secolo) - Antica fortificazione medievale con un campanile tronco, il cui mistero è stato risolto. Ammirate la vetrata che raffigura San Martino, vescovo e patrono dei pellegrini."
    ],
    "fr": [
      "Église Saint-Jean-Baptiste (XIIe s.) - Ancienne fortification médiévale au clocher tronqué dont le mystère est élucidé. Admirez le vitrail de saint Martin, évêque et patron des pèlerins."
    ],
    "es": [
      "Église Saint-Jean-Baptiste (siglo XII) - Antigua fortificación medieval con un campanario truncado cuyo misterio ha sido resuelto. Admire la vidriera que representa a San Martín, obispo y patrón de los peregrinos."
    ],
    "nl": [
      "Église Saint-Jean-Baptiste (12e eeuw) - Een voormalig middeleeuws fort met een afgeknotte klokkentoren, waarvan het mysterie nu is opgelost. Bewonder het gebrandschilderde raam met de afbeelding van Sint Maarten, bisschop en beschermheilige van de pelgrims."
    ]
  },
  "rdfs:label": {
    "en": [
      "Saint-Jean-Baptiste Church"
    ],
    "fr": [
      "Église Saint-Jean-Baptiste"
    ]
  },
