  "rdfs:comment": {
    "de": [
      "In Donzère errichtete Bauwerke: Staudamm an der Rhône und 3 Wachwehre am Kanal Donzère-Mondragon.\r\nExterne Besichtigungen nach Vereinbarung."
    ],
    "en": [
      "Structures built in Donzère: a weir on the River Rhône and dam and locks on the Donzère-Mondragon canal. Outdoor visit by appointment at this address:  amisduvieuxdonzere@orange.fr or telephone number:+33 (0) 475 516 804. Duration of visit: 1hr15"
    ],
    "it": [
      "Strutture costruite a Donzère: diga di contenimento sul Rodano e 3 dighe di guardia sul canale Donzère-Mondragon\r\nVisita esterna su appuntamento."
    ],
    "fr": [
      "Ouvrages construits à Donzère : barrage de retenue sur le Rhône et 3 barrages de garde sur le canal Donzère-Mondragon. \r\nVisite exterieure sur rendez-vous."
    ],
    "nl": [
      "Installaties gebouwd in Donzère: stuwdam in de Rhône en afsluitende dammen op het kanaal Donzère-Mondragon. Voor een rondleiding buiten dient u een afspraak te maken via: amisduvieuxdonzere@orange.fr of via tel.nr.: 04 75 51 68 04. Duur van het bezoek: 1.15 u"
    ],
    "es": [
      "Estructuras construidas en Donzère: presa de contención en el Ródano y 3 presas de guarda en el canal Donzère-Mondragón\r\nVisita externa con cita previa."
    ]
  },
