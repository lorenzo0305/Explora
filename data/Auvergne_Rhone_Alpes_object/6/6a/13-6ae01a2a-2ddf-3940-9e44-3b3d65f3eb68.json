  "rdfs:comment": {
    "de": [
      "Das Projekt le restaurant c'est la création d'un lieu hétéroclite, composé à la fois d'un restaurant bistronomique et d'une cave de dégustation dans un climat de partage et de convivialité!"
    ],
    "en": [
      "The restaurant project is the creation of a heterogeneous place, comprising both a bistronomic restaurant and a tasting cellar, in a climate of sharing and conviviality!"
    ],
    "it": [
      "Il progetto del ristorante è la creazione di un luogo eterogeneo, che comprende sia un ristorante bistronomico che una cantina di degustazione, in un clima di condivisione e convivialità!"
    ],
    "fr": [
      "Le projet le restaurant c’est la création d’un lieu hétéroclite, composé à la fois d’un restaurant bistronomique et d’une cave de dégustation dans un climat de partage et de convivialité !"
    ],
    "nl": [
      "Het restaurantproject is de creatie van een heterogene plek, bestaande uit zowel een bistronomisch restaurant als een degustatiekelder in een klimaat van delen en gezelligheid!"
    ],
    "es": [
      "El proyecto de restauración es la creación de un lugar heterogéneo, compuesto a la vez por un restaurante bistronómico y una bodega de degustación en un clima de compartir y convivencia"
    ]
