  "rdfs:comment": {
    "de": [
      "Die Guinguette bietet Ihnen Pizzas, Burger, Salate und andere einfache Gerichte an. Sie können sich auf unseren Terrassen niederlassen und die gemütliche Atmosphäre genießen oder sie mitnehmen."
    ],
    "en": [
      "La guinguette offers pizzas, burgers, salads and other simple dishes. You can sit on our terraces and enjoy the cosy atmosphere, or take them away."
    ],
    "it": [
      "La guinguette serve pizze, hamburger, insalate e altri piatti semplici. Potete sedervi sulle nostre terrazze e godervi l'atmosfera accogliente, oppure portarli via con voi."
    ],
    "fr": [
      "La guinguette vous propose ses pizzas, burgers, salades repas et autres plats simples. Vous pouvez vous installer sur nos terrasses et profiter d’une ambiance cosy ou les emporter."
    ],
    "es": [
      "La guinguette sirve pizzas, hamburguesas, ensaladas y otros platos sencillos. Puedes sentarte en nuestras terrazas y disfrutar de un ambiente acogedor, o llevártelas contigo."
    ],
    "nl": [
      "La guinguette serveert pizza's, hamburgers, salades en andere eenvoudige gerechten. Je kunt op onze terrassen zitten en genieten van de gezellige sfeer, of ze meenemen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Guinguette le Trinqualo"
    ]
  },
