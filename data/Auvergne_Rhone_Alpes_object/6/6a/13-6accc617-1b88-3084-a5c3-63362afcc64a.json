  "rdfs:comment": {
    "de": [
      "Stellen Sie sich Fantazio vor, einen Schnulzensänger mit elastischem Stimmumfang, begleitet vom Schlagzeuger Francesco Pastacaldi, einem Dynamiker der schlafenden Jazzszene, und von Yurie Hu, einem Keyboarder mit Klangkräften, die Dick Rivers in Daft Punk verwandeln könnten."
    ],
    "en": [
      "Imagine Fantazio, a crooner with an elastic tessitura, accompanied by drummer Francesco Pastacaldi, a dynamo on the sleepy jazz scene, and Yurie Hu, a keyboardist with sonic powers capable of transforming Dick Rivers into Daft Punk."
    ],
    "it": [
      "Immaginate Fantazio, un crooner dalla gamma elastica, accompagnato dal batterista Francesco Pastacaldi, una dinamo della scena jazz addormentata, e da Yurie Hu, un tastierista dai poteri sonori capaci di trasformare Dick Rivers in Daft Punk."
    ],
    "fr": [
      "Imaginez Fantazio, gueule de crooner doté d’une tessiture élastique, accompagné du batteur  Francesco Pastacaldi, dynamiteur de la scène jazz endormie, et de Yurie Hu, claviériste aux pouvoirs soniques capables de transformer Dick Rivers en Daft Punk."
    ],
    "nl": [
      "Stel je Fantazio voor, een crooner met een elastisch bereik, begeleid door drummer Francesco Pastacaldi, een dynamo in de slapende jazzscene, en Yurie Hu, een toetsenist met sonische krachten die Dick Rivers in Daft Punk kan veranderen."
    ],
    "es": [
      "Imagínese a Fantazio, un crooner con un registro elástico, acompañado por el batería Francesco Pastacaldi, un dínamo en la escena del jazz durmiente, y Yurie Hu, una teclista con poderes sónicos capaces de convertir a Dick Rivers en Daft Punk."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Concert - Fantazio Trio - Festival F(r)iction du réel"
    ]
  },
