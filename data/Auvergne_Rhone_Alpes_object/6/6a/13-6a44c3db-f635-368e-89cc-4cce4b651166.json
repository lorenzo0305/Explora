  "rdfs:comment": {
    "de": [
      "Neulise war eine gallische Gründung und später eine römische Garnison und taucht in den ersten antiken Zitaten unter dem Namen Novalisio auf."
    ],
    "en": [
      "Founded in Gaul and later garrisoned by the Romans, Neulise appears in the earliest references as Novalisio."
    ],
    "it": [
      "Fondata in Gallia e successivamente presidiata dai Romani, Neulise appare nei primi riferimenti come Novalisio."
    ],
    "fr": [
      "De fondation gauloise, puis garnison romaine, Neulise apparaît dans les premières citations anciennes sous le nom de Novalisio."
    ],
    "nl": [
      "Neulise werd gesticht in Gallië en later door de Romeinen belegerd. In vroege verwijzingen komt Neulise voor als Novalisio."
    ],
    "es": [
      "Fundada en la Galia y posteriormente guarnicionada por los romanos, Neulise aparece en las primeras referencias como Novalisio."
    ]
  },
