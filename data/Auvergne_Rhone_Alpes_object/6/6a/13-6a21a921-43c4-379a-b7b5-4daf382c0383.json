  "rdfs:comment": {
    "de": [
      "Im Louvre können Sie mutige Rezepte entdecken, anschauen & probieren. Wir sind die Produzenten einer progressiven Küche. Flexibilität, Präsentation und \"hausgemacht\" stehen im Vordergrund."
    ],
    "en": [
      "At the Louvre restaurant, discover, watch & taste daring recipes. We are the producers of a progressive cuisine. Flexibility, presentation and \"home-made\" are in the spotlight."
    ],
    "it": [
      "Al Louvre, scoprite, guardate e assaggiate ricette audaci. Produciamo una cucina progressista. Flessibilità, presentazione e \"home-made\" sono all'ordine del giorno."
    ],
    "fr": [
      "Au Louvre, découvrez, regardez & dégustez des recettes audacieuses. Nous sommes les producteurs d’une cuisine progressiste. La flexibilité, la présentation et le «fait maison» sont à l’honneur."
    ],
    "nl": [
      "Ontdek, bekijk en proef gewaagde recepten in het louvre. wij zijn de producenten van een vooruitstrevende keuken. flexibiliteit, presentatie en \"huisgemaakt\" staan in de schijnwerpers."
    ],
    "es": [
      "En el Louvre, descubra, observe y deguste recetas atrevidas. Elaboramos una cocina progresista. La flexibilidad, la presentación y el \"hecho en casa\" están a la orden del día."
    ]
  },
  "rdfs:label": {
