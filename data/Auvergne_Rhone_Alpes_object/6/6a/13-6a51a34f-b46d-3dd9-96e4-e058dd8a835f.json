  "rdfs:comment": {
    "de": [
      "Übernachten Sie in den 33 Zimmern & Suiten des Alpeen Hôtel, die 2024 vollständig renoviert wurden und einen atemberaubenden Blick auf die Berge und das Gebiet der 3 Vallées bieten, um völlig einzutauchen."
    ],
    "en": [
      "Stay in one of the 33 fully renovated rooms and suites at Alpeen Hotel in 2024, offering an immersive view of the mountain and the 3 Valleys domain."
    ],
    "it": [
      "Soggiornate nelle 33 camere e suite dell'Alpeen Hôtel, completamente rinnovato nel 2024, con vista ininterrotta sulle montagne e sul comprensorio sciistico delle 3 Vallées per un'esperienza totalmente coinvolgente."
    ],
    "fr": [
      "Séjournez dans les 33 chambres & suites de l’Alpeen Hôtel entièrement rénovées en 2024 offrant une vue imprenable sur la montagne et le domaine des 3 vallées pour une totale immersion."
    ],
    "nl": [
      "Verblijf in de 33 kamers en suites van het Alpeen Hôtel, volledig gerenoveerd in 2024, met ononderbroken uitzicht op de bergen en het 3 Vallées skigebied voor een totaal meeslepende ervaring."
    ],
    "es": [
      "Alójese en las 33 habitaciones y suites del Alpeen Hôtel, completamente renovado en 2024, con vistas ininterrumpidas a las montañas y al dominio esquiable de los 3 Vallées para vivir una experiencia totalmente envolvente."
    ]
  },
