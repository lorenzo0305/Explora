  "rdfs:comment": {
    "de": [
      "Blandine, Davy, Nelly und Victoire begrüßen Sie in La Bouillotte, einer unabhängigen allgemeinen Buchhandlung und einem spielerischen Teesalon. Gesellige Räume und regelmäßige Veranstaltungen sorgen für einen Moment außerhalb der Zeit,"
    ],
    "en": [
      "Blandine, Davy, Nelly and Victoire welcome you to La Bouillotte, an independent general bookshop and playful tearoom. Friendly spaces and regular events for a moment out of time,"
    ],
    "it": [
      "Blandine, Davy, Nelly e Victoire vi danno il benvenuto a La Bouillotte, libreria generale indipendente e sala da tè ludica. Spazi conviviali ed eventi regolari per un momento fuori dal tempo,"
    ],
    "fr": [
      "Blandine, Davy, Nelly et Victoire vous accueillent à La Bouillotte, librairie généraliste indépendante et salon de thé ludique. Des espaces conviviaux et des animations régulières pour un moment hors du temps,"
    ],
    "es": [
      "Blandine, Davy, Nelly y Victoire le dan la bienvenida a La Bouillotte, librería generalista independiente y salón de té lúdico. Espacios acogedores y eventos regulares para un momento fuera del tiempo,"
    ],
    "nl": [
      "Blandine, Davy, Nelly en Victoire heten je welkom in La Bouillotte, een onafhankelijke algemene boekhandel en speelse tearoom. Vriendelijke ruimtes en regelmatige evenementen voor een moment buiten de tijd,"
    ]
  },
