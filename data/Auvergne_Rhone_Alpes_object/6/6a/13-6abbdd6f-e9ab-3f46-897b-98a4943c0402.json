  "rdfs:comment": {
    "de": [
      "Selbstverwalteter Chor, der es sich zum freudigen Ziel gesetzt hat, gemeinsam zu singen, sich etwas Gutes zu tun und auf Veranstaltungen, militante Aktionen, bürgerliche, ökologische und soziale Ansätze zu gehen."
    ],
    "en": [
      "A self-managed choir with the joyful aim of singing together, doing good, and taking part in events, militant actions and citizen, ecological and social initiatives."
    ],
    "it": [
      "Un coro autogestito con l'obiettivo gioioso di cantare insieme, fare del bene e partecipare a eventi, azioni militanti e iniziative cittadine, ecologiche e sociali."
    ],
    "fr": [
      "Chorale autogérée, qui se donne comme joyeux objectifs de chanter ensemble, se faire du bien, et d'aller sur les évènements, actions militantes, les démarches citoyennes, écologiques, sociales."
    ],
    "es": [
      "Un coro autogestionado con el alegre objetivo de cantar juntos, hacer el bien y participar en eventos, acciones militantes e iniciativas ciudadanas, ecológicas y sociales."
    ],
    "nl": [
      "Een koor in eigen beheer met het vreugdevolle doel om samen te zingen, goed te doen en deel te nemen aan evenementen, militante acties en burger-, ecologische en sociale initiatieven."
    ]
  },
