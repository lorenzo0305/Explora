  "rdfs:comment": {
    "de": [
      "Die Kirche geht auf das Jahr 522 zurück und diente bis 1537 dem katholischen Gottesdienst. Der Glockenturm wurde 1843 in seiner heutigen Form repariert."
    ],
    "en": [
      "Dating back to 522, it was used for Catholic worship until 1537. The steeple was repaired in 1843 to its present form."
    ],
    "it": [
      "Risalente al 522, fu utilizzato per il culto cattolico fino al 1537. Il campanile è stato riparato nel 1843 nella sua forma attuale."
    ],
    "fr": [
      "Remontant à 522, elle servit au culte catholique jusqu'en 1537. Le clocher fut réparé en 1843 sous la forme actuelle."
    ],
    "nl": [
      "Het dateert uit 522 en werd tot 1537 gebruikt voor de katholieke eredienst. De klokkentoren werd in 1843 hersteld in zijn huidige vorm."
    ],
    "es": [
      "Data del año 522 y se utilizó para el culto católico hasta 1537. El campanario fue reparado en 1843 para darle su forma actual."
    ]
  },
