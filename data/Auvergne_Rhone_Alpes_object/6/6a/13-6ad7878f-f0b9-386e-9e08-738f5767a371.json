  "rdfs:comment": {
    "de": [
      "Condorcet ist ein Dorf mit etwa 500 Einwohnern. Es liegt etwa 10 km nordöstlich von Nyons und hat ein mildes, gemäßigtes Klima. Da es sich in einem Mittelgebirge (350 m über dem Meeresspiegel) befindet, ist es vor dem Mistral geschützt."
    ],
    "en": [
      "Condorcet is a village with about 500 inhabitants. It is situated at a dozen kilometers northeast of Nyons and benefits from a soft and moderate climate. Situated halfway a mountain (350m height), the village is protected from the Mistral."
    ],
    "it": [
      "Condorcet è un villaggio di circa 500 abitanti. Si trova a circa dieci chilometri a nord-est di Nyons e gode di un clima mite e temperato. Essendo in mezzo alle montagne (350 m di altitudine), è protetto dal maestrale."
    ],
    "fr": [
      "Condorcet est un village d'environ 500 habitants. Il se situe à une dizaine de kilomètres au nord-est de Nyons et bénéficie d'un climat doux et tempéré. Etant en moyenne montagne (350 m d'altitude), il est protégé du mistral."
    ],
    "nl": [
      "Condorcet is een dorp met ongeveer 500 inwoners. Het is gelegen op een tiental kilometers ten noordoosten van Nyons en profiteert van een zacht en gematigd klimaat. Gesitueerd halverwege op een berg (op 350m hoogte), is het dorp beschermd tegen de mistral."
    ],
    "es": [
      "Condorcet es un pueblo de unos 500 habitantes. Se encuentra a unos diez kilómetros al noreste de Nyons y goza de un clima suave y templado. Al estar en medio de las montañas (350 m de altitud), está protegida del mistral."
    ]
  },
