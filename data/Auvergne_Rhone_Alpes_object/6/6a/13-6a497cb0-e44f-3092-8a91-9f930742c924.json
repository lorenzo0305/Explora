  "rdfs:comment": {
    "de": [
      "Medizinischer Transport und Taxi. Zur Verfügung stehen: 2 Krankenwagen für alle Notfälle und Liegendtransporte, 3 leichte Sanitätsfahrzeuge (VSL) für alle personalisierten Sitztransporte und 2 Taxis für alle anderen Fahrten."
    ],
    "en": [
      "Medical transport and cab. At your disposal: 2 ambulances for all emergencies and transport of patients in bed, 3 light medical vehicles (VSL) for all personalized seated transport and 2 cabs for all other journeys."
    ],
    "it": [
      "Trasporto medico e taxi. A vostra disposizione: 2 ambulanze per tutte le emergenze e il trasporto di pazienti a letto, 3 veicoli medici leggeri (VSL) per tutti i trasporti personalizzati seduti e 2 taxi per tutti gli altri spostamenti."
    ],
    "fr": [
      "Transport médical et taxi. A disposition : 2 ambulances pour toutes urgences et le transport de malades couchés, 3 véhicules sanitaires légers (VSL) pour tous transports assis personnalisés et 2 taxis pour tous autres déplacements."
    ],
    "es": [
      "Transporte médico y taxi. A su disposición: 2 ambulancias para todas las urgencias y el transporte de pacientes encamados, 3 vehículos sanitarios ligeros (VSL) para todos los transportes personalizados sentados y 2 taxis para todos los demás desplazamientos."
    ],
    "nl": [
      "Medisch vervoer en taxi's. Beschikbaar: 2 ambulances voor alle noodgevallen en vervoer van patiënten in bed, 3 lichte medische voertuigen (VSL) voor alle persoonlijk zittend vervoer en 2 taxi's voor alle andere ritten."
    ]
  },
