  "rdfs:comment": {
    "de": [
      "Canyon 07, Spezialist für Aktivitäten in der Natur, bietet Ihnen die Möglichkeit, Canyoning, Klettern und Via Corda zu entdecken, ganz nach Ihren Wünschen! Ein Abenteuer, das von einem unabhängigen lokalen Führer angeboten wird, mit kleinen Gruppen und günstigen Preisen!"
    ],
    "en": [
      "Canyon 07, specialist in outdoor activities, offers you the chance to discover canyoning, climbing and via corda, according to your desires! An adventure led by an independent local guide, with small numbers and low prices!"
    ],
    "it": [
      "Canyon 07, specialista in attività outdoor, vi offre la possibilità di scoprire il canyoning, l'arrampicata e la via corda, secondo i vostri desideri! Un'avventura condotta da una guida locale indipendente, con numeri ridotti e prezzi vantaggiosi!"
    ],
    "fr": [
      "Canyon 07, spécialiste des activités de plein nature vous propose de découvrir le canyoning, l'escalade et la via corda, en fonction de vos envies! Une aventure proposée par un guide local indépendant, avec petits effectifs et tarifs avantageux!"
    ],
    "nl": [
      "Canyon 07, specialist in outdoor activiteiten, biedt je de kans om canyoning, klimmen en de via corda te ontdekken, geheel naar jouw wensen! Een avontuur geleid door een onafhankelijke lokale gids, met kleine aantallen en geweldige prijzen!"
    ],
    "es": [
      "Canyon 07, especialista en actividades al aire libre, le propone descubrir el barranquismo, la escalada y la vía corda, ¡según sus deseos! Una aventura dirigida por un guía local independiente, en grupos reducidos y a buen precio"
    ]
  },
