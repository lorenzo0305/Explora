  "rdfs:comment": {
    "de": [
      "Sie benötigen eine Auskunft? Begeben Sie sich in den Espace grand Site de France, wo unsere Empfangsmitarbeiter Ihnen gerne Auskunft geben. Dieser Ort beherbergt wechselnde Ausstellungen, eine Leseecke und einen Projektionsraum."
    ],
    "en": [
      "Need more information? Visit the Espace grand Site de France, where our receptionists are on hand to help. This space houses temporary exhibitions, a reading corner and a projection area."
    ],
    "it": [
      "Avete bisogno di informazioni? Recatevi all'Espace Grand Site de France, dove i nostri addetti all'accoglienza sono a vostra disposizione. Questo spazio ospita mostre temporanee, un angolo di lettura e un'area di proiezione."
    ],
    "fr": [
      "Vous avez besoin d'un renseignement ? Rendez-vous dans l'Espace grand Site de France où nos agents d'accueil sont là pour vous renseigner. Ce lieu abrite des expositions temporaires, un coin lecture et un espace de projection."
    ],
    "es": [
      "¿Necesita información? Diríjase al Espace Grand Site de France, donde le atenderán nuestros recepcionistas. Este espacio alberga exposiciones temporales, un rincón de lectura y una zona de proyección."
    ],
    "nl": [
      "Heeft u informatie nodig? Ga naar de Espace Grand Site de France waar onze receptionisten u graag helpen. In deze ruimte vindt u tijdelijke tentoonstellingen, een leeshoek en een projectieruimte."
    ]
  },
  "rdfs:label": {
    "en": [
      "Grand Site de France area at the summit of Puy de Dôme"
    ],
    "fr": [
      "Espace Grand Site de France du sommet du puy de Dôme"
    ]
  },
