  "rdfs:comment": {
    "de": [
      "Von Le Poët Laval aus nehmen Sie den Hugenottenpfad, um über den Chemin des Vitrouillères nach Dieulefit zu gelangen.\r\nHunde müssen an der Leine gehalten werden."
    ],
    "en": [
      "Leaving Le Poët Laval, take the sentier des Huguenots to reach Dieulefit via the chemin des Vitrouillères.\r\nDogs must be kept on a leash."
    ],
    "it": [
      "Da Le Poët Laval si prende il \"sentier des Huguenots\" per raggiungere Dieulefit attraverso lo \"chemin des Vitrouillères\".\r\nI cani devono essere tenuti al guinzaglio."
    ],
    "fr": [
      "Au départ du Poët Laval vous prendrez le sentier des Huguenots pour rejoindre Dieulefit par le chemin des Vitrouillères.\r\nLes chiens doivent être tenu en laisse."
    ],
    "es": [
      "Desde Le Poët Laval se toma el \"sentier des Huguenots\" para llegar a Dieulefit por el \"chemin des Vitrouillères\".\r\nLos perros deben ir con correa."
    ],
    "nl": [
      "Als je Le Poët Laval verlaat, neem je de sentier des Huguenots om Dieulefit te bereiken via de chemin des Vitrouillères.\r\nHonden moeten aangelijnd zijn."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Dieulefit - Le Poët-Laval par les Vitrouilléres"
    ]
  },
