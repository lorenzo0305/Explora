  "rdfs:comment": {
    "de": [
      "650 m vom TGV-Bahnhof Valence entfernt - Kostenlose Pendelbusse, die Sie vom ersten zum letzten Zug bringen (Reservierung mindestens 2 Stunden vorher erforderlich) - Parkplatz mit Kameras gesichert."
    ],
    "en": [
      "650 m from Valence TGV station - Free shuttles to take you from the 1st to the last train (reservation required at least 2 hours in advance) - camera-secured parking."
    ],
    "it": [
      "650 m dalla stazione TGV di Valence - Bus navetta gratuito per accompagnarvi dal primo all'ultimo treno (prenotazione obbligatoria almeno 2 ore prima) - Parcheggio custodito con telecamere."
    ],
    "fr": [
      "A 650 m de la gare TGV Valence - Navettes gratuites pour vous emmener du 1er au dernier train (sur réservation au moins 2h avant) - parking sécurisé par caméras."
    ],
    "es": [
      "A 650 m de la estación de TGV de Valence - Autobús gratuito para llevarle del primer al último tren (es necesario reservar con al menos 2 horas de antelación) - Aparcamiento vigilado con cámaras."
    ],
    "nl": [
      "650 m van het TGV-station Valence - Gratis pendelbussen om je van de 1e naar de laatste trein te brengen (reserveren minstens 2 uur van tevoren verplicht) - Met camera beveiligde parkeerplaats."
    ]
  },
  "rdfs:label": {
