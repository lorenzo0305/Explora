  "rdfs:comment": {
    "de": [
      "Genuss eines Restaurantmenüs zum Mitnehmen.\r\nJede Woche ein anderes Menü, das sich an drei saisonalen Produkten orientiert. Möglichkeit, verschiedene Formeln zu wählen.\r\nCatering-Service für Ihre Empfänge, Seminare und Familienessen."
    ],
    "en": [
      "The pleasure of a takeaway restaurant menu.\r\nA different menu every week based on 3 seasonal products. Formulas available.\r\nCatering service available for receptions, seminars and family meals."
    ],
    "it": [
      "Il piacere di un menu da asporto o in terrazza da maggio a ottobre.\r\nUn menu basato su 3 prodotti di stagione. Formule disponibili.\r\nServizio di catering disponibile per ricevimenti, seminari e pasti in famiglia."
    ],
    "fr": [
      "Plaisir d'un menu de restaurant à emporter ou en terrasse de mai à octobre.\r\nUn menu orienté autour de 3 produits de saison. Possibilité de formules.\r\nProposition d'un service traiteur pour vos réceptions, séminaires et repas de famille."
    ],
    "nl": [
      "Het plezier van een afhaalrestaurantmenu.\r\nElke week een ander menu op basis van 3 seizoensproducten. Formules beschikbaar.\r\nCatering service beschikbaar voor recepties, seminars en familie maaltijden."
    ],
    "es": [
      "El placer de un menú de restaurante para llevar o en la terraza de mayo a octubre.\r\nUn menú basado en 3 productos de temporada. Fórmulas disponibles.\r\nServicio de catering disponible para recepciones, seminarios y comidas familiares."
    ]
  },
  "rdfs:label": {
