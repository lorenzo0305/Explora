  "rdfs:comment": {
    "de": [
      "PureForm ist ein Ort des Lebens und des Wohlbefindens. Ein Team von Sporttrainern bietet eine breite Palette an Gruppenkursen im Fitness- und Wassersportbereich an. Immersives Biking-Studio, Yoga und Gesundheitssport. Bereich für die Verpflegung. PureSpa ist der Pflegebereich."
    ],
    "en": [
      "PureForm is a place to live and feel good. A team of sports coaches offers a wide range of group fitness and aquatic classes. Immersive biking studio, yoga and health sports. Catering area. PureSpa is the treatment area."
    ],
    "it": [
      "PureForm è un luogo dove vivere e sentirsi bene. Un team di allenatori sportivi offre un'ampia gamma di corsi di fitness e acquatici di gruppo. Studio immersivo di ciclismo, yoga e sport per la salute. Area ristorazione. PureSpa è l'area trattamenti."
    ],
    "fr": [
      "PureForm est un véritable lieu de vie, bien être. Une équipe de coachs sportifs propose une gamme riche de cours collectifs fitness ou aquatiques. Studio de biking immersif, Yoga et Sport santé. Espace Restauration. PureSpa est l'espace de soins."
    ],
    "nl": [
      "PureForm is een plek om te leven en je goed te voelen. Een team van sportcoaches biedt een breed scala aan groepsfitness- en aqualessen. Indringende fietsstudio, yoga en gezondheidssporten. Cateringruimte. PureSpa is de behandelruimte."
    ],
    "es": [
      "PureForm es un lugar para vivir y sentirse bien. Un equipo de entrenadores deportivos ofrece una amplia gama de clases de fitness en grupo y acuáticas. Estudio de ciclismo inmersivo, yoga y deportes de salud. Zona de restauración. PureSpa es la zona de tratamientos."
    ]
  },
