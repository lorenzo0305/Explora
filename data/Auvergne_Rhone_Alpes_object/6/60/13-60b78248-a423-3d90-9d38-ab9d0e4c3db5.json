  "rdfs:comment": {
    "de": [
      "Vom Gipfel des Saulire, einem Michelin-Gipfel mit *** Auszeichnung zwischen Méribel und Courchevel, fahren Sie den Südhang hinunter, der Sie nach Méribel Mottaret führt. Spaß und Sport in einer traumhaften Kulisse."
    ],
    "en": [
      "From the top of the Saulire, top Michelin *** located between Courchevel and Méribel, full zip down the south slope that leads you to Mottaret. Fun and sport in a dream setting."
    ],
    "it": [
      "Dalla cima del Saulire, una cima *** Michelin situata tra Méribel e Courchevel, scendete il pendio esposto a sud che vi porta a Méribel Mottaret. Divertimento e sport in un ambiente da sogno."
    ],
    "fr": [
      "Du sommet de la Saulire, sommet *** au guide Michelin situé entre Méribel et Courchevel, dévalez le versant plein sud qui vous conduit à Méribel Mottaret. Du plaisir et du sport dans un décor de rêve."
    ],
    "nl": [
      "Vanaf de top van de Saulire, een *** Michelin-top gelegen tussen Méribel en Courchevel, daalt u de zuidelijke helling af die u naar Méribel Mottaret brengt. Plezier en sport in een droomomgeving."
    ],
    "es": [
      "Desde la cima de la Saulire, una cima *** Michelin situada entre Méribel y Courchevel, descienda la ladera orientada al sur que le lleva a Méribel Mottaret. Diversión y deporte en un entorno de ensueño."
    ]
  },
  "rdfs:label": {
