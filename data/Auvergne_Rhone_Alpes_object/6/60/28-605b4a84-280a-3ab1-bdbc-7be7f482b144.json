  "rdfs:comment": {
    "de": [
      "An einem der schön renovierten Hafenbecken gelegen, bietet dieses 2-Sterne-Hotel 81 geräumige und komfortable Zimmer mit Blick auf den Hafen und das Meer. Das Gebäude mit zeitgenössischer Architektur verfügt über einen Aufzug, einen Speisesaal, eine Brasserie und 2 Tagungsräume. Das Preis-Leistungs-Verhältnis ist ausgezeichnet."
    ],
    "en": [
      "On one of the port's beautifully renovated docks, this 2-star hotel offers 81 spacious and comfortable rooms with a view of the port and the sea. This building with contemporary architecture has an elevator, a restaurant, a brasserie and 2 meeting rooms. The value for money is excellent."
    ],
    "it": [
      "Su una delle banchine del porto splendidamente ristrutturate, questo hotel a 2 stelle offre 81 camere spaziose e confortevoli con vista sul porto e sul mare. Questo edificio contemporaneo dispone di un ascensore, un ristorante, una brasserie e 2 sale riunioni. Il rapporto qualità-prezzo è eccellente."
    ],
    "fr": [
      "Sur un des bassins joliment rénové du port, cet hôtel 2 étoiles offre 81 chambres spacieuses et confortables avec vue sur le port et la mer. Ce bâtiment à l'architecture contemporaine dispose d'un ascenseur, d'une salle de restaurant, d'une brasserie et 2 salles de réunion. Le rapport qualité prix est excellent."
    ],
    "nl": [
      "Op een van de prachtig gerenoveerde dokken van de haven biedt dit 2-sterrenhotel 81 ruime en comfortabele kamers met uitzicht op de haven en de zee. Dit eigentijdse gebouw heeft een lift, een restaurant, een brasserie en 2 vergaderzalen. De prijs-kwaliteitverhouding is uitstekend."
    ],
    "es": [
      "En uno de los hermosos muelles renovados del puerto, este hotel de 2 estrellas ofrece 81 habitaciones amplias y confortables con vistas al puerto y al mar. Este edificio contemporáneo dispone de ascensor, restaurante, brasserie y 2 salas de reuniones. La relación calidad-precio es excelente."
    ]
  },
