  "rdfs:comment": {
    "de": [
      "Begeben Sie sich auf die Spuren von Guy Chatiliez' Buch \"Alpage de mon enfance\".\r\nFolgen Sie dem Senner und erleben Sie die bewegten Erinnerungen des jungen Guy, wie er das Grüne Tal entdeckt."
    ],
    "en": [
      "Follow in the footsteps of Guy Chatiliez's book \"Alpage de mon enfance\".\r\nFollow the Alpagiste and relive the moving memories of young Guy discovering the Vallée Verte."
    ],
    "it": [
      "Seguite le tracce del libro di Guy Chatiliez \"Alpage de mon enfance\".\r\nSeguite l'alpinista e rivivete gli emozionanti ricordi del giovane Guy alla scoperta della Vallée Verte."
    ],
    "fr": [
      "Partez sur les traces du livre de Guy Chatiliez \"Alpage de mon enfance\". \r\nSuivez l'alpagiste et revivez les souvenirs émus du jeune Guy découvrant la Vallée Verte."
    ],
    "nl": [
      "Treed in de voetsporen van het boek \"Alpage de mon enfance\" van Guy Chatiliez.\r\nVolg de bergbeklimmer en herbeleef de ontroerende herinneringen van de jonge Guy terwijl hij de Vallée Verte ontdekt."
    ],
    "es": [
      "Siga los pasos del libro de Guy Chatiliez \"Alpage de mon enfance\".\r\nSigue al alpinista y revive los emocionantes recuerdos del joven Guy mientras descubre el Vallée Verte."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le chemin de l'alpage - Parcours de découverte"
    ]
  },
