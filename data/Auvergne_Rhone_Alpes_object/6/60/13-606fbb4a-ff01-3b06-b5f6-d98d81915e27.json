  "rdfs:comment": {
    "de": [
      "Créa Bo& Aime bietet Ihnen die Möglichkeit, zu lernen, wie Sie mit Ihren Augen schön gestalten können und Freude am Gestalten haben."
    ],
    "en": [
      "Créa Bo& Aime invites you to learn how to create beauty with your eyes, and to love creating."
    ],
    "it": [
      "Créa Bo& Aime vi offre la possibilità di imparare a creare bellezza con gli occhi e di divertirvi a creare."
    ],
    "fr": [
      "Créa Bo& Aime vous propose d'apprendre à créer beau avec vos yeux et d'aimer créer."
    ],
    "es": [
      "Créa Bo& Aime te ofrece la oportunidad de aprender a crear belleza con los ojos y de disfrutar creando."
    ],
    "nl": [
      "Créa Bo& Aime biedt je de kans om te leren hoe je schoonheid creëert met je ogen en om te genieten van het creëren."
    ]
  },
