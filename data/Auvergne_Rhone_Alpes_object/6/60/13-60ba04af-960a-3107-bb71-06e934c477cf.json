  "rdfs:comment": {
    "de": [
      "Als Begleiter im Mittelgebirge bietet Ihnen Julien Lamelin verschiedene Aktivitäten an, z. B.: Wandern oder Schneeschuhwandern, Wellness-Wanderungen, die Tour du Mont-Blanc, maßgeschneiderte Reisen... Ausflüge auf Anfrage oder kollektiv."
    ],
    "en": [
      "As a mountain leader, Julien Lamelin offers a wide range of activities, including hiking, snowshoeing, \"well-being\" hiking, tours of Mont-Blanc and tailor-made trips... On-demand or group outings."
    ],
    "it": [
      "In qualità di guida alpina, Julien Lamelin propone una gamma di attività che comprendono escursioni a piedi e con le racchette da neve, passeggiate \"benessere\", tour del Monte Bianco e viaggi su misura... Su richiesta o in gruppo."
    ],
    "fr": [
      "Accompagnateur de moyenne montagne, Julien Lamelin vous propose diverses activités comme : la randonnée pédestre ou à raquette, la randonnée \"bien-être\", le tour du Mont-Blanc, des voyages sur mesure... Sortie à la demande ou collectives."
    ],
    "es": [
      "Como monitor de montaña, Julien Lamelin propone diversas actividades: senderismo y raquetas de nieve, paseos \"bienestar\", recorridos por el Mont-Blanc y viajes a medida... Salidas a la carta o en grupo."
    ],
    "nl": [
      "Als bergleider biedt Julien Lamelin verschillende activiteiten aan, zoals wandelen en sneeuwschoenwandelen, \"welzijnswandelingen\", tochten op de Mont-Blanc en tochten op maat... Uitstapjes op aanvraag of in groep."
    ]
  },
  "rdfs:label": {
    "en": [
      "Julien Lamelin - Mountain leader"
    ],
    "it": [
      "Julien Lamelin - Guida alpina"
    ],
    "fr": [
      "Julien Lamelin - Accompagnateur en montagne"
    ]
  },
