  "rdfs:comment": {
    "de": [
      "Das an das Dorf Mijoux angegliederte Skigebiet Valserine bietet drei schöne Pisten.\r\n\r\ndie Piste \"Les Parisettes\" führt am Tal entlang und ist eine totale Flucht aus dem Alltag im Herzen der Valserine."
    ],
    "en": [
      "The Valserine ski area, attached to the village of Mijoux, offers 2 beautiful runs.\r\n\r\nthe \"Les Parisettes\" run skirts the valley, a total escape in the heart of the Valserine."
    ],
    "it": [
      "Il comprensorio sciistico della Valserine, collegato al villaggio di Mijoux, offre 3 grandi piste.\r\n\r\nles Parisettes\" si snoda lungo il bordo della valle, offrendo una fuga totale nel cuore della Valserine."
    ],
    "fr": [
      "Le domaine de la Valserine, rattaché au village de Mijoux propose 3 belles pistes.\r\n\r\nla piste \"Les Parisettes\"  longe la vallée, c'est une évasion totale au coeur de la Valserine."
    ],
    "nl": [
      "Het skigebied Valserine, dat aan het dorp Mijoux ligt, biedt 3 fantastische pistes.\r\n\r\nles Parisettes\" loopt langs de rand van de vallei en biedt een totale ontsnapping in het hart van de Valserine."
    ],
    "es": [
      "El dominio esquiable de Valserine, anexo al pueblo de Mijoux, ofrece 3 magníficas pistas.\r\n\r\nles Parisettes\" discurre por el borde del valle, ofreciendo una escapada total en el corazón de la Valserine."
    ]
  },
  "rdfs:label": {
    "en": [
      "Cross-country ski trail: Les Parisettes"
    ],
    "fr": [
      "Piste de ski de fond : Les Parisettes"
    ]
  },
