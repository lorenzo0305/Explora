  "rdfs:comment": {
    "de": [
      "Entdecken Sie eine Boutique aus 100 % Pays de Gex, in der die Kreativität zum Leben erwacht!\nZwischen Workshops für Groß und Klein und einzigartigen lokalen Kreationen können Sie sich von Kunst und Inspiration mitreißen lassen."
    ],
    "en": [
      "Discover a 100% Pays de Gex boutique where creativity comes to life!\nFrom workshops for young and old to unique local creations, let yourself be carried away by art and inspiration."
    ],
    "it": [
      "Scoprite un negozio 100% Pays de Gex dove la creatività prende vita!\r\nDai laboratori per grandi e piccini alle creazioni locali uniche, lasciatevi trasportare dall'arte e dall'ispirazione."
    ],
    "fr": [
      "Découvrez une boutique 100 % Pays de Gex où la créativité prend vie !\r\nEntre ateliers pour petits et grands et créations locales uniques, laissez-vous emporter par l’art et l’inspiration."
    ],
    "es": [
      "¡Descubra una tienda 100% Pays de Gex donde la creatividad cobra vida!\r\nDesde talleres para grandes y pequeños hasta creaciones locales únicas, déjese llevar por el arte y la inspiración."
    ],
    "nl": [
      "Ontdek een 100% Pays de Gex winkel waar creativiteit tot leven komt!\nVan workshops voor jong en oud tot unieke lokale creaties, laat je meeslepen door kunst en inspiratie."
    ]
  },
  "rdfs:label": {
    "de": [
      "Der kreative Zwischenstopp"
    ],
    "en": [
      "The creative stopover"
    ],
    "fr": [
      "L'escale créative"
    ],
    "nl": [
      "De creatieve tussenstop"
    ]
  },
