  "rdfs:comment": {
    "de": [
      "Baby-Pony, Kinder, Jugendliche, Erwachsene... Freizeit, Wettkampf, Kurse, die dem Niveau und den Wünschen eines jeden angepasst sind. Diplomierte Lehrerinnen und Lehrer. Komplizenschaft und Wohlwollen."
    ],
    "en": [
      "Baby pony, children, teenagers, adults... Leisure, competition, lessons adapted to each individual's level and desires. Qualified teachers. Friendly and caring."
    ],
    "it": [
      "Baby pony, bambini, adolescenti, adulti... Tempo libero, competizione, lezioni adattate al livello e ai desideri di ciascuno. Insegnanti qualificati. Cordiali e premurosi."
    ],
    "fr": [
      "Baby poney, enfants, ados, adultes... Loisirs, compétition, cours adaptés au niveau et aux envies de chacun. Enseignantes diplômées. Complicité et bienveillance."
    ],
    "es": [
      "Baby pony, niños, adolescentes, adultos... Ocio, competición, clases adaptadas al nivel y a los deseos de cada uno. Profesores titulados. Amables y atentos."
    ],
    "nl": [
      "Baby pony, kinderen, tieners, volwassenen... Vrije tijd, wedstrijden, lessen aangepast aan ieders niveau en wensen. Gekwalificeerde leraren. Vriendelijk en zorgzaam."
    ]
  },
