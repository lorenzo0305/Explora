  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Departement Rhône durch ein spielerisches und kostenloses Geocaching-Erlebnis. In Brindas begeben Sie sich auf die Jagd nach Kloche, einer Spezialistin für Märchen und Legenden. Sie und die anderen Gnolus werden Ihnen die Geschichte des Dorfes näher bringen."
    ],
    "en": [
      "Discover the Rhône department through a fun and free geocaching experience. In Brindas, go hunting for Kloche, a specialist of tales and legends. She and the other Gnolus will make you discover the history of the village."
    ],
    "it": [
      "Scoprite il dipartimento del Rodano attraverso un'esperienza di geocaching divertente e gratuita. A Brindas, andate a caccia di Kloche, uno specialista di racconti e leggende. Lei e gli altri Gnolus vi aiuteranno a scoprire la storia del villaggio."
    ],
    "fr": [
      "Découvrez le département du Rhône à travers une expérience ludique et gratuite de géocaching. A Brindas, partez à la chasse de Kloche, spécialiste des contes et légendes. Elle et les autres Gnolus vous feront découvrir l'histoire du village."
    ],
    "nl": [
      "Ontdek het departement Rhône via een leuke en gratis geocaching-ervaring. Ga in Brindas op jacht naar Kloche, een specialist in verhalen en legenden. Zij en de andere Gnolus zullen je helpen de geschiedenis van het dorp te ontdekken."
    ],
    "es": [
      "Descubra el departamento del Ródano a través de una experiencia de geocaching divertida y gratuita. En Brindas, vaya a la caza de Kloche, un especialista en cuentos y leyendas. Ella y los otros Gnolus te ayudarán a descubrir la historia del pueblo."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Gnolus : Brindas ? C'est pas là !"
    ]
  },
