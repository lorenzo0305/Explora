        "de": [
          "Probieren Sie für 1 oder 2 Stunden ein Gyropod auf einer der Strecken aus, die von der Zitadelle aus starten."
        ],
        "en": [
          "For 1 or 2 hours, come and try out a gyropod on one of the circuits departing from the Citadelle."
        ],
        "it": [
          "Per 1 o 2 ore, venite a provare un gyropod su uno dei circuiti che partono dalla Citadelle."
        ],
        "fr": [
          "Pour 1 ou 2 heures, venez essayer un gyropode sur l’un des circuits au départ de la Citadelle."
        ],
        "nl": [
          "Kom gedurende 1 of 2 uur een gyropod uitproberen op een van de circuits die vertrekken vanaf de Citadel."
        ],
        "es": [
          "Durante 1 ó 2 horas, venga a probar un autogiro en uno de los circuitos que salen de la Citadelle."
        ]
