  "rdfs:comment": {
    "de": [
      "Floriane und ihr Team heißen Sie im Reitzentrum willkommen. Eine französische Reitschule, Pony-Club, Pferde-Club und Equi Handi Club. Reiten auf allen Niveaus, für alle in der Maurienne, auf dem Reitplatz, in der Reithalle und in der freien Natur. Zugänglich ab 4 Jahren."
    ],
    "en": [
      "Floriane and her team welcome you to the equestrian center. A French riding school, pony club, horse club and equi handi club. Riding at all levels, for everyone in the Maurienne, in indoor and outdoor arenas. Accessible from age 4."
    ],
    "it": [
      "Floriane e il suo team vi danno il benvenuto nel centro equestre. Una scuola di equitazione francese, un pony club, un horse club e un equi handi club. Equitazione a tutti i livelli, per tutti nella Maurienne, in arene interne ed esterne. Accessibile a partire dai 4 anni."
    ],
    "fr": [
      "Floriane et son équipe vous accueillent au centre équestre. Une école française d’équitation, poney club, cheval club et équi handi club. L’équitation tous niveaux, pour tous en Maurienne, en carrière, manège et pleine nature. Accessible dès 4 ans."
    ],
    "es": [
      "Floriane y su equipo le dan la bienvenida al centro ecuestre. Una escuela de equitación francesa, pony club, club hípico y equi handi club. Equitación a todos los niveles, para todos en la Maurienne, en pistas cubiertas y al aire libre. Accesible a partir de los 4 años."
    ],
    "nl": [
      "Floriane en haar team heten je welkom op de manege. Een Franse manege, ponyclub, paardenclub en equi handi club. Paardrijden op alle niveaus, voor iedereen in de Maurienne, in binnen- en buitenpistes. Toegankelijk vanaf 4 jaar."
    ]
  },
  "rdfs:label": {
    "en": [
      "Le Pied à l'étrier equestrian center"
    ],
