  "rdfs:comment": {
    "de": [
      "Das Kino befindet sich im Stadtzentrum von Bourbon-l'Archambault (im ehemaligen Kasino) und zeigt jede Woche einen anderen Film aus den neuesten Kinostarts."
    ],
    "en": [
      "Located in the centre of Bourbon-l'Archambault (in the old casino), the cinema room screens a different film every week, taken from the latest releases."
    ],
    "it": [
      "Situato nel centro di Bourbon-l'Archambault (nel vecchio casinò), il cinema proietta ogni settimana un film diverso, tra le ultime uscite."
    ],
    "fr": [
      "Installé en centre ville de Bourbon-l'Archambault (dans l'ancien casino), la salle de cinéma projette chaque semaine un film différent, issu des dernières sorties."
    ],
    "es": [
      "Situado en el centro de la ciudad de Bourbon-l'Archambault (en el antiguo casino), el cine proyecta una película diferente cada semana, entre los últimos estrenos."
    ],
    "nl": [
      "Gelegen in het centrum van Bourbon-l'Archambault (in het oude casino), vertoont de bioscoop elke week een andere film uit de nieuwste releases."
