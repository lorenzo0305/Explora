  "rdfs:comment": {
    "de": [
      "Als ehemalige Winzerdörfer und \"Grenzdörfer\", die im Laufe der Geschichte und insbesondere während des Zweiten Weltkriegs gemartert wurden, sind Chevignat und Roissiat heute der Ausgangspunkt für schöne Wanderungen im Revermont."
    ],
    "en": [
      "Former winegrowers' villages, \"frontier\" villages martyred throughout history and in particular during the Second World War, Chevignat and Roissiat are now starting points for beautiful walks in the Revermont."
    ],
    "it": [
      "Ex villaggi di viticoltori, villaggi \"di frontiera\" che sono stati martirizzati nel corso della storia e in particolare durante la Seconda Guerra Mondiale, Chevignat e Roissiat sono oggi il punto di partenza per splendide passeggiate nel Revermont."
    ],
    "fr": [
      "Anciens villages de vignerons, villages \"frontière\" martyrisés au cours de l'Histoire et en particulier pendant la Seconde Guerre mondiale, Chevignat et Roissiat sont aujourd'hui le point de départ de belles balades dans le Revermont."
    ],
    "nl": [
      "Voormalige wijnbouwersdorpen, \"grensdorpen\" die in de loop van de geschiedenis en vooral tijdens de Tweede Wereldoorlog werden gemarteld, Chevignat en Roissiat zijn nu het vertrekpunt voor prachtige wandelingen in de Revermont."
    ],
    "es": [
      "Antiguos pueblos de viticultores, pueblos \"fronterizos\" martirizados a lo largo de la historia y en particular durante la Segunda Guerra Mundial, Chevignat y Roissiat son hoy el punto de partida de hermosos paseos por el Revermont."
    ]
  },
