  "rdfs:comment": {
    "de": [
      "Nehmen Sie an den von der Mediathek angebotenen Gemeinschaftsprojekten teil, teilen Sie einen schönen gemeinsamen Moment bei einer handwerklichen Tätigkeit oder kommen Sie einfach vorbei und lernen Sie: Nähen, Sticken, Häkeln, je nach anwesender Technikerin."
    ],
    "en": [
      "Take part in collective projects proposed by the media library, share a good time together around a manual activity or simply come and learn: sewing, embroidery, crochet, depending on the technicians present."
    ],
    "it": [
      "Partecipare ai progetti collettivi proposti dalla biblioteca multimediale, condividere un momento di svago intorno a un'attività manuale o semplicemente venire a imparare: cucito, ricamo, uncinetto, secondo i tecnici presenti."
    ],
    "fr": [
      "Participez aux projets collectifs proposés par la médiathèque, partagez un bon moment partagé autour d'une activité manuelle ou tout simplement venez vous initier : couture, broderie, crochet, selon les techniciennes présentes."
    ],
    "es": [
      "Participe en los proyectos colectivos propuestos por la mediateca, comparta un buen rato en torno a una actividad manual o simplemente venga a aprender: costura, bordado, ganchillo, según los técnicos presentes."
    ],
    "nl": [
      "Neem deel aan de collectieve projecten die worden voorgesteld door de mediatheek, geniet van een leuke tijd rond een manuele activiteit of kom het gewoon leren: naaien, borduren, haken, volgens de aanwezige technici."
    ]
  },
