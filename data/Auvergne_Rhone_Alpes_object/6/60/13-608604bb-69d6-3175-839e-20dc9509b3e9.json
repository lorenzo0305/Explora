  "rdfs:comment": {
    "de": [
      "Karibou Canyon ist eine Einrichtung in der freien Natur. Sie bietet Canyoning-Touren, aber auch originelle Ausflüge wie Naturanimationen im Herzen des Vercors-Massivs und der Chartreuse an."
    ],
    "en": [
      "Karibou Canyon is a nature organization. It offers canyoning trips as well as original outings such as nature activities in the heart of the Vercors and Chartreuse massifs."
    ],
    "it": [
      "Il Karibou Canyon è un centro naturalistico. Offre escursioni di canyoning e gite originali come attività naturalistiche nel cuore dei massicci del Vercors e della Chartreuse."
    ],
    "fr": [
      "Karibou Canyon est une structure de pleine nature. Elle propose des sorties canyoning mais aussi des sorties originales tel que des animations nature au coeur du massif du Vercors et de la Chartreuse."
    ],
    "nl": [
      "Karibou Canyon is een natuurcentrum. Het biedt canyoningtochten maar ook originele uitstapjes zoals natuuractiviteiten in het hart van het Vercors- en Chartreuse-massief."
    ],
    "es": [
      "El Cañón de Karibou es un centro de naturaleza. Ofrece excursiones de barranquismo y salidas originales, como actividades en la naturaleza en el corazón de los macizos de Vercors y Chartreuse."
    ]
  },
