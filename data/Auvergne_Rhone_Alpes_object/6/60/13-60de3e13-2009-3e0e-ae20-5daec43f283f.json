  "rdfs:comment": {
    "de": [
      "Authentisches Restaurant, das seit Generationen geöffnet ist und eine traditionelle und gesellige Küche anbietet. Mahlzeiten für Gruppen auf Anfrage. Schattige Terrasse. \"Au Bon Repère on y vient, du Bon Repère on en souvenir, au Bon Repère on y revient\" (Zum guten Platz kommt man, zum guten Platz erinnert man sich, zum guten Platz kommt man zurück)."
    ],
    "en": [
      "This is an authentic restaurant which has been open for generations. It offers traditional French cooking, group bookings, as well as a shaded terrace. 'You first come to the Bon Repere, then you remember the Bon Repere, therefore you come back to the Bon Repere!'"
    ],
    "it": [
      "Ristorante autentico aperto da generazioni, che offre una cucina tradizionale e accogliente. Pasti per gruppi su richiesta. Terrazza ombreggiata. \"A Le Bon Repère si viene, a Le Bon Repère si ricorda, a Le Bon Repère si torna\"."
    ],
    "fr": [
      "Authentique restaurant ouvert depuis des générations, proposant une cuisine traditionnelle et conviviale. Repas pour groupe sur demande. Terrasse ombragée. \"Au Bon Repère on y vient, du Bon Repère on s'en souvient, au Bon Repère on y revient\"."
    ],
    "nl": [
      "Authentiek restaurant dat al generaties lang open is en een traditionele en vriendelijke keuken biedt. Maaltijden voor groepen op aanvraag. Schaduwrijk terras. \"Bij Le Bon Repère kom je, bij Le Bon Repère herinner je je, bij Le Bon Repère kom je terug\"."
    ],
    "es": [
      "Auténtico restaurante abierto desde hace generaciones, que ofrece una cocina tradicional y acogedora. Comidas para grupos a petición. Terraza sombreada. \"A Le Bon Repère se viene, a Le Bon Repère se recuerda, a Le Bon Repère se vuelve\"."
    ]
  },
