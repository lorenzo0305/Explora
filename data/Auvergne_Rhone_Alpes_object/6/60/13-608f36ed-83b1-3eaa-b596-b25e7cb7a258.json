  "rdfs:comment": {
    "de": [
      "Restaurant/Bar in der Höhe an der Ankunft des Sessellifts von Sairon. Burger, Tagesgericht, regionale Spezialitäten.\r\nTerrasse an der Sonnenseite. Zugang und Toiletten für Behinderte, Rollstuhl zur Verfügung. In der Winter- und Sommersaison nur mittags geöffnet."
    ],
    "en": [
      "Mountain restaurant/bar at the top of the Sairon chairlift. Burgers, dish of the day, regional specialties.\r\nSun terrace Access and toilets for people with reduced mobility, wheelchair available. Open only for lunch in the winter and summer seasons."
    ],
    "it": [
      "Ristorante e bar in cima alla seggiovia Sairon. Hamburger, piatti del giorno, specialità regionali.\r\nTerrazza soleggiata. Accesso e servizi igienici per persone con mobilità ridotta, possibilità di sedia a rotelle. Aperto solo a pranzo in inverno e in estate."
    ],
    "fr": [
      "Restaurant/Bar d'altitude à l'arrivée du télésiège du Sairon. Burgers, plat du jour, spécialités régionales.\r\nTerrasse ensoleillée. Accès et toilettes PMR, fauteuil roulant à disposition. Ouverture uniquement le midi en saison hiver et d'été."
    ],
    "es": [
      "Restaurante y bar en lo alto del telesilla Sairon. Hamburguesas, plato del día, especialidades regionales.\r\nTerraza soleada. Acceso PMR y aseos, silla de ruedas disponible. Sólo abierto al mediodía en invierno y verano."
    ],
    "nl": [
      "Altitude restaurant/bar bij aankomst van de Sairon stoeltjeslift. Burgers, dagschotel, regionale specialiteiten.\r\nZonneterras Toegang en toiletten voor mensen met beperkte mobiliteit, rolstoel beschikbaar. Alleen 's middags geopend in het winter- en zomerseizoen."
    ]
  },
