  "rdfs:comment": {
    "de": [
      "Stimmungsvolles Bar-Restaurant, zeitgenössische und savoyische Küche, aber auch eine Auswahl an Gerichten, die man bei einem guten Glas Wein oder einem Cocktail gemeinsam genießen kann."
    ],
    "en": [
      "Atmospheric bar-restaurant, contemporary and Savoyard cuisine but also a selection of dishes to share over a good glass of wine or a cocktail."
    ],
    "it": [
      "Bar-ristorante con una cucina contemporanea e savoiarda, ma anche una selezione di piatti da condividere con un buon bicchiere di vino o un cocktail."
    ],
    "fr": [
      "Bar-restaurant d’ambiance, cuisine contemporaine et savoyarde mais aussi une sélection de plats à partager autour d’un bon verre de vin ou d’un cocktail."
    ],
    "es": [
      "Bar-restaurante con una cocina contemporánea y saboyana pero también una selección de platos para compartir con una buena copa de vino o un cóctel."
    ],
    "nl": [
      "Bar-restaurant, hedendaagse en Savoyaardse keuken, maar ook een selectie gerechten om te delen met een goed glas wijn of een cocktail."
    ]
  },
