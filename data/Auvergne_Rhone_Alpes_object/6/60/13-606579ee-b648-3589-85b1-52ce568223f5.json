  "rdfs:comment": {
    "de": [
      "Die Brasserie Le M, Maître Restaurateur, empfängt Sie auf ihrer Südterrasse am Fuße der Skipiste Les Vikings und bietet Ihnen: eine Speisekarte mit lokalen und köstlichen Aromen und hausgemachten Desserts."
    ],
    "en": [
      "The Maître Restaurateur restaurant, ‘Le M’, with its south-facing terrace at the foot of the Viking ski lift slope, offers a brasserie-style lunchtime menu featuring local flavours and homemade desserts."
    ],
    "it": [
      "Il ristorante  \"Le M\", la sua terrazza esposta a sud ai piedi della pista degli impianti di risalita Viking, vi offre: per il pranzo serve il suo menu con sapori locali e gourmet e i suoi dolci fatti in casa."
    ],
    "fr": [
      "La Brasserie Le M, Maître Restaurateur, vous accueille sur sa terrasse plein sud au pied de la piste de ski  des Vikings, et vous propose :  une carte aux saveurs locales et gourmandes et ses desserts maison."
    ],
    "es": [
      "La Brasserie Le M, Maître Restaurateur, le da la bienvenida en su terraza orientada al sur, a los pies de la pista de esquí Vikings, y le propone una carta de sabores locales y postres caseros."
    ],
    "nl": [
      "Brasserie Le M, een Maître Restaurateur, verwelkomt je op het terras op het zuiden aan de voet van de skipiste van Vikings, met een menu met lokale smaken en huisgemaakte desserts."
    ]
  },
