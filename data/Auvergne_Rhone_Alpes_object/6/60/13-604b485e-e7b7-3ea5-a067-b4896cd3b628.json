  "rdfs:comment": {
    "de": [
      "Seit September 2022 bietet \"L'entre-potes\" von Virginie und David eine gesellige und leckere gastronomische Erfahrung, die auf ihrer 20-jährigen Erfahrung in der Drôme und Ardèche basiert. Traditionelle und kreative Küche, lokale Produkte und ein verlockender Weinkeller."
    ],
    "en": [
      "Since September 2022, Virginie and David's \"L'entre-potes\" offers a friendly, gourmet dining experience based on their 20 years of experience in the Drôme and Ardèche regions. Traditional and creative cuisine, local products and a tempting cellar."
    ],
    "it": [
      "Dal settembre 2022, \"L'entre-potes\" di Virginie e David offre un'esperienza culinaria amichevole e gourmet basata sulla loro esperienza ventennale nella Drôme e nell'Ardèche. Cucina tradizionale e creativa, prodotti locali e un'invitante cantina di vini."
    ],
    "fr": [
      "Depuis septembre 2022, \"L'entre-potes\" de Virginie et David offre une expérience gastronomique conviviale et gourmande, basée sur leurs 20 ans d'expérience en Drôme et Ardèche. Cuisine traditionnelle et créative, produits locaux et cave alléchante."
    ],
    "nl": [
      "Sinds september 2022 bieden Virginie en David's \"L'entre-potes\" een vriendelijke, gastronomische eetervaring gebaseerd op hun 20 jaar ervaring in de Drôme en Ardèche. Traditionele en creatieve gerechten, lokale producten en een verleidelijke wijnkelder."
    ],
    "es": [
      "El chef y su equipo te ofrecen una cocina creativa, con un sincero acercamiento a la calidad y al compartir. Ambiente chic y relajado con vista a la bodega que contiene un centenar de referencias."
    ]
  },
