  "rdfs:comment": {
    "de": [
      "Das Rathaus stellt Ihnen unweit der Pré Chapouton zwei Picknicktische zur Verfügung, die im Schatten der Bäume aufgestellt sind."
    ],
    "en": [
      "Not far from the Pré Chapouton, the Mairie provides 2 picnic tables in the shade of the trees."
    ],
    "it": [
      "La Mairie ha allestito 2 tavoli da picnic all'ombra degli alberi non lontano dal Pré Chapouton."
    ],
    "fr": [
      "La Mairie met à votre disposition non loin du Pré Chapouton 2 tables de pique-nique installée à l'ombre des arbres."
    ],
    "es": [
      "La Mairie ha instalado 2 mesas de picnic a la sombra de los árboles, no lejos del Pré Chapouton."
    ],
