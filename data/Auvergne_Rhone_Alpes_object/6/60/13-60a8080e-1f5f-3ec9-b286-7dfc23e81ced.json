  "rdfs:comment": {
    "de": [
      "Erleben Sie die Sinneserfahrung der Berge in unserem authentischen und gemütlichen Spa. Gesichts- und Körperbehandlungen, individuelle Modellagen... Kinder und Erwachsene werden für einen Moment des Wohlbefindens willkommen geheißen."
    ],
    "en": [
      "The authentic mountain spirit with quality services and sense of wellness are the secrets for high emotional experience."
    ],
    "it": [
      "Provate i sensi della montagna nella nostra calda e autentica spa. Trattamenti viso e corpo, modellazione personalizzata... Bambini e adulti sono benvenuti per un momento di benessere."
    ],
    "fr": [
      "Vivez l'expérience sensorielle de la montagne dans notre spa, authentique et chaleureux. Soins du visage et du corps, modelages personnalisés... Enfants et adultes sont accueillis pour un moment de bien-être."
    ],
    "nl": [
      "Ervaar de zintuigen van de bergen in onze warme en authentieke spa. Gezichts- en lichaamsbehandelingen, persoonlijke modellering... Kinderen en volwassenen zijn welkom voor een moment van welzijn."
    ],
    "es": [
      "Disfrute de la experiencia sensorial de la montaña en nuestro cálido y auténtico spa. Tratamientos faciales y corporales, masajes personalizados... Niños y adultos son bienvenidos para un momento de bienestar."
    ]
  },
  "rdfs:label": {
