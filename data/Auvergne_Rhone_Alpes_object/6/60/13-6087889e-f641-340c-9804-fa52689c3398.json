  "rdfs:comment": {
    "de": [
      "Regale für Erwachsene, Kinder und Jugendliche. Comics, Mangas, Presse... Abteilung für Multimedia. Es werden regelmäßig Animationen veranstaltet. Gesellschaftsspiele zum Spielen vor Ort. Kaffeeempfang jeden Samstagvormittag."
    ],
    "en": [
      "Adult, children's and teen sections. Comics, mangas, magazines... Multimedia section. Animations are organized regularly. Board games to play on site. Coffee every Saturday morning."
    ],
    "it": [
      "Sezioni per adulti, bambini e ragazzi. Fumetti, manga, giornali... Sezione multimediale. Vengono organizzati regolarmente eventi. Giochi da tavolo da giocare in loco. Caffè ogni sabato mattina."
    ],
    "fr": [
      "Rayons adulte, enfant, ado. BD, mangas, presse... Rayon multimédia. Des animations sont organisées régulièrement. Jeux de société pour jouer sur place. Accueil café tous les samedis matins."
    ],
    "nl": [
      "Secties voor volwassenen, kinderen en tieners. Strips, manga's, kranten... Sectie multimedia. Er worden regelmatig evenementen georganiseerd. Bordspellen om ter plaatse te spelen. Elke zaterdagochtend koffie."
    ],
    "es": [
      "Secciones para adultos, niños y adolescentes. Cómics, mangas, periódicos... Sección multimedia. Se organizan eventos con regularidad. Juegos de mesa para jugar in situ. Café todos los sábados por la mañana."
    ]
  },
  "rdfs:label": {
