  "rdfs:comment": {
    "de": [
      "Das Hotel Ibis Montélimar Nord liegt in der Nähe der Ardèche-Schlucht im Herzen der Drôme Provençale. A 5 Minuten der Autobahn A7 (Ausfahrt 17)."
    ],
    "en": [
      "The ibis Montélimar Nord hotel is located  in the heart of the Drôme Provençale and close to the Ardèche gorges. It is 5 minutes away from the A7 highway (exit 17)."
    ],
    "it": [
      "L'hotel Ibis Montélimar Nord è situato nel cuore della Drôme Provençale e vicino alle gole dell'Ardèche. A 5 minuti dall'autostrada A7 (uscita 17)."
    ],
    "fr": [
      "L'hôtel Ibis Montélimar Nord se situe au cœur de la Drôme Provençale et  à proximité des gorges de l'Ardèche. A 5 minutes de l'autoroute A7 (Sortie 17)."
    ],
    "nl": [
      "Het ibis Montélimar Nord hotel ligt dicht bij de Gorges de l'Ardèche in het hart van de Drôme Provençale. Het is 5 minuten van de snelweg A7 (afslag 17)."
    ],
    "es": [
      "El hotel Ibis Montélimar Nord está situado en el corazón de la Drôme provenzal y cerca de las gargantas del Ardèche. A 5 minutos de la autopista A7 (salida 17)."
    ]
  },
