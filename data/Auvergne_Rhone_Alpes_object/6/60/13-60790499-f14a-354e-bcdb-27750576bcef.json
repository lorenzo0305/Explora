  "rdfs:comment": {
    "de": [
      "Auch im Winter ist es möglich, mit dem elektrisch unterstützten Mountainbike das besondere Gefühl des Radfahrens auf Schnee zu erleben!"
    ],
    "en": [
      "It's possible in winter too, with the Electrically Assisted Mountain Bike, you can discover the special sensation of cycling on snow!"
    ],
    "it": [
      "È possibile anche in inverno: con la Mountain Bike ad assistenza elettrica, potrete scoprire la sensazione speciale di pedalare sulla neve!"
    ],
    "fr": [
      "En hiver aussi c’est possible, avec le VTT à Assistance Électrique, vous pourrez découvrir la sensation particulière du vélo sur la neige !"
    ],
    "es": [
      "También es posible en invierno, con la bicicleta de montaña asistida eléctricamente podrá descubrir la sensación especial de pedalear sobre la nieve"
    ],
    "nl": [
      "Het kan ook in de winter, met de elektrisch ondersteunde mountainbike kun je de speciale sensatie van fietsen op sneeuw ontdekken!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Aravis VTT sur neige"
    ]
  },
