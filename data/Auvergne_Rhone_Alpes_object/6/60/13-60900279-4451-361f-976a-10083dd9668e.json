  "rdfs:comment": {
    "de": [
      "Bergkirche mit typisch dauphinoisischem Glockenturm und 8 Glasfenstern, die vom Maler Arcabas entworfen und vom Glasermeister Christophe Berthier hergestellt wurden."
    ],
    "en": [
      "Mountain church with a typical Dauphin porch bell tower, featuring 8 stained glass windows, created by the painter Arcabas and realized by the master glass artist Christophe Berthier."
    ],
    "it": [
      "Una chiesa di montagna con un campanile a portico tipicamente Dauphinois, con 8 vetrate disegnate dal pittore Arcabas e realizzate dal maestro vetraio Christophe Berthier."
    ],
    "fr": [
      "Église de montagne au clocher porche typiquement dauphinois, comportant 8 vitraux, créés par le peintre Arcabas et réalisés par le maître-verrier Christophe Berthier."
    ],
    "es": [
      "Iglesia de montaña con un campanario de pórtico típico de Dauphin, con 8 vidrieras, creadas por el pintor Arcabas y realizadas por el maestro vidriero Christophe Berthier."
    ],
    "nl": [
      "Een bergkerk met een typisch Dauphinois portiekklokkentoren, met 8 gebrandschilderde ramen ontworpen door de schilder Arcabas en gemaakt door meester-glasblazer Christophe Berthier."
    ]
  },
