  "rdfs:comment": {
    "de": [
      "Spezialisiert auf Bergreisen, zu Fuß oder mit dem Fahrrad, Trekking oder Halbtageswanderungen, im Herzen von Gebieten und Naturschauplätzen, Ediths Routen werden mit Leidenschaft zusammengestellt."
    ],
    "en": [
      "Specializing in mountain trips, on foot or by bike, trekking or half-day hiking, in the heart of territories and natural sites, Edith's itineraries are concocted with passion."
    ],
    "it": [
      "Specializzata in viaggi in montagna, a piedi o in bicicletta, trekking o escursioni di mezza giornata, nel cuore di territori e siti naturali, gli itinerari di Edith sono concepiti con passione."
    ],
    "fr": [
      "Spécialisée dans les voyages de montagne, à pied ou à vélo, trek ou randonnée à la demi-journée,  au cœur de territoires et des sites naturels, les itinéraires d'Edith sont concoctés avec passion."
    ],
    "es": [
      "Especializada en viajes de montaña, a pie o en bicicleta, trekking o senderismo de media jornada, en el corazón de territorios y parajes naturales, los itinerarios de Edith se elaboran con pasión."
    ],
    "nl": [
      "Edith is gespecialiseerd in bergtochten, te voet of met de fiets, trektochten of halve dagen wandelen, in het hart van gebieden en natuurgebieden, en stelt haar routes met passie samen."
    ]
  },
