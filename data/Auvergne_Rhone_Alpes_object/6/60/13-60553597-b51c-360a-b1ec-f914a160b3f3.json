  "rdfs:comment": {
    "de": [
      "Entdecken Sie diese Crêperie, die von einem Bretonen aus Brest geführt wird, um Ihnen an der Küste einen kleinen Geschmack der Bretagne zu vermitteln! Crêpes, Galettes, Cidre, aber auch gemischte Salate oder Omeletts und Tagesgerichte ohne Galette."
    ],
    "en": [
      "Discover this crêperie run by a Breton from Brest to give you a little taste of Brittany on the Coast! Pancakes, galettes, cider but also mixed salads or omelettes and dishes of the day without galette."
    ],
    "it": [
      "Scoprite questa crêperie gestita da un bretone di Brest per avere un piccolo assaggio della Bretagna sulla costa! Frittelle, galette, sidro ma anche insalate miste o omelette e piatti del giorno senza galette."
    ],
    "fr": [
      "Découvrez cette crêperie tenue par un breton de Brest pour vous donner un petit goût de Bretagne sur la Côtière ! Crêpes, galettes, cidre mais aussi salades composées ou omelettes et plats du jour sans galette."
    ],
    "nl": [
      "Ontdek deze crêperie gerund door een Bretoen uit Brest om u een voorproefje te geven van Bretagne aan de kust! Pannenkoeken, galetten, cider maar ook gemengde salades of omeletten en dagschotels zonder galetten."
    ],
    "es": [
      "Descubra esta crepería regentada por un bretón de Brest que le permitirá saborear la Bretaña de la costa Tortitas, galettes, sidra, pero también ensaladas mixtas o tortillas y platos del día sin galette."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Bouchon Breton"
    ]
  },
