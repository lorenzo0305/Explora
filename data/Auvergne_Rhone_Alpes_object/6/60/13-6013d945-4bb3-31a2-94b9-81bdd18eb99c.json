  "rdfs:comment": {
    "de": [
      "Die Bibliothek von Bagnols befindet sich in der ehemaligen Privatschule und harmoniert perfekt mit der Spielothek. Sie haben Zugang zu einer großen Auswahl an Büchern, CDs, DVDs, Zeitschriften usw. sowie zu einem Computer, der nur für die Öffentlichkeit zugänglich ist."
    ],
    "en": [
      "Located in the former private school, the Bagnols library combines perfectly with the toy library. You can access a wide range of books, CDs, DVDs, magazines, etc., as well as a computer reserved for the public."
    ],
    "it": [
      "Situata nell'ex scuola pubblica, la biblioteca di Bagnols è un perfetto abbinamento con la ludoteca. È possibile accedere a un'ampia gamma di libri, CD, DVD, riviste, ecc. e a un computer riservato al pubblico."
    ],
    "fr": [
      "Située dans l’ancienne école privée, la bibliothèque de Bagnols s’associe parfaitement avec la ludothèque. Vous pouvez accéder à un grand choix de livres, CD, DVD, revues, etc…ainsi qu’à un ordinateur réservé au public."
    ],
    "es": [
      "Ubicada en la antigua escuela pública, la biblioteca de Bagnols es el complemento perfecto de la ludoteca. Podrás acceder a una amplia gama de libros, CD, DVD, revistas, etc., así como a un ordenador reservado al público."
    ],
    "nl": [
      "De bibliotheek van Bagnols is gevestigd in de voormalige openbare school en sluit perfect aan bij de spelotheek. Je hebt er toegang tot een breed scala aan boeken, cd's, dvd's, tijdschriften, enz. en een computer die gereserveerd is voor het publiek."
    ]
  },
