  "rdfs:comment": {
    "de": [
      "Hier finden Sie zahlreiche Biersorten, aber auch Teesorten, Kaffeesorten aus aller Welt, ein Feinkostgeschäft sowie Gläser und Dekoartikel."
    ],
    "en": [
      "You'll find a wide range of beers, as well as original teas, world coffees, a delicatessen, glasses and decorative items."
    ],
    "it": [
      "Trovate molte referenze di birre, ma anche tè d'origine, caffè del mondo, una gastronomia, oltre a bicchieri e articoli decorativi."
    ],
    "fr": [
      "Retrouvez de nombreuses références de bières mais aussi des thés d'origine, cafés du monde, une épicerie fine ainsi que des verres et articles déco."
    ],
    "nl": [
      "Je vindt er een ruim assortiment bieren, maar ook originele theesoorten, wereldkoffie, delicatessen, glazen en decoratieve artikelen."
    ],
    "es": [
      "Encuentre numerosas referencias de cervezas pero también tés de origen, cafés del mundo, una charcutería así como copas y artículos de decoración."
    ]
  },
