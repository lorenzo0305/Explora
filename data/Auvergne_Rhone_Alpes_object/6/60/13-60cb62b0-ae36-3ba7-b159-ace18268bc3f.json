  "rdfs:comment": {
    "de": [
      "Floriane, eine leidenschaftliche Köchin, lädt Sie zu sich nach Hause ein, um Ihnen ein außergewöhnliches Essen zu zaubern. Ob für ein Firmenessen, eine Hochzeit oder einen Geburtstag, ein einzigartiges kulinarisches Erlebnis!"
    ],
    "en": [
      "Floriane, a passionate chef, invites herself into your home to concoct an exceptional meal. Whether it's for a corporate meal, a wedding or a birthday, a unique culinary experience!"
    ],
    "it": [
      "Floriane, chef appassionata, si presenta a casa vostra per preparare un pasto eccezionale. Che sia per un pranzo aziendale, un matrimonio o una festa di compleanno, vi aspetta un'esperienza culinaria unica!"
    ],
    "fr": [
      "Floriane, cheffe passionnée, s'invite chez vous pour vous concocter un repas exceptionnel. Que ce soit pour un repas d'entreprise, un mariage ou un anniversaire, une expérience culinaire unique!"
    ],
    "es": [
      "Floriane, una chef apasionada, se invita a sí misma a su casa para preparar una comida excepcional. Ya sea para una comida de empresa, una boda o una fiesta de cumpleaños, le espera una experiencia culinaria única"
    ],
    "nl": [
      "Floriane, een gepassioneerde chef-kok, nodigt zichzelf bij je thuis uit om een uitzonderlijke maaltijd te bereiden. Of het nu voor een bedrijfsmaaltijd, een bruiloft of een verjaardagsfeestje is, je kunt rekenen op een unieke culinaire ervaring!"
    ]
  },
  "rdfs:label": {
    "de": [
      "Floriane, Köchin \"Ich lade mich bei Ihnen ein\""
    ],
    "en": [
      "Floriane, \"Je m'invite chez vous\" cook"
    ],
    "it": [
      "Floriane, \"Je m'invite chez vous\" cuoco"
    ],
    "fr": [
      "Floriane, Cuisinière \"Je m'invite chez vous\""
    ],
    "nl": [
      "Floriane, \"Je m'invite chez vous\" kok"
    ]
  },
