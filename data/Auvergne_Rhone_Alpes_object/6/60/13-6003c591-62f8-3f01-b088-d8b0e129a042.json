  "rdfs:comment": {
    "de": [
      "Das Hôtel du Dauphiné empfängt Sie im Herzen dieses mittelalterlichen und blumengeschmückten Dorfes, das Ausgangspunkt für zahlreiche Wanderwege ist (GR 91, 95...)."
    ],
    "en": [
      "The Hôtel du Dauphiné welcomes you to the heart of this medieval, flower-filled village, the starting point for many hiking trails (GR 91, 95...)."
    ],
    "it": [
      "L'Hôtel du Dauphiné vi accoglie nel cuore di questo villaggio medievale e fiorito, punto di partenza di numerosi sentieri escursionistici (GR 91, 95...)"
    ],
    "fr": [
      "L’Hôtel du Dauphiné  vous accueille au cœur de ce village médiéval et fleuri, point de départ de nombreux chemins de randonnée (GR 91, 95...)"
    ],
    "nl": [
      "Hôtel du Dauphiné verwelkomt u in het hart van dit bloemrijke middeleeuwse dorp, het startpunt van vele wandelroutes (GR 91, 95...)."
    ],
    "es": [
      "El Hôtel du Dauphiné le da la bienvenida al corazón de este pueblo medieval lleno de flores, punto de partida de numerosas rutas de senderismo (GR 91, 95...)"
    ]
  },
