  "rdfs:comment": {
    "de": [
      "Les Bains des Alpes - Spa Nuxe du Domaine de Marlioz : Wählen Sie zwischen unseren 3 Bereichen: Wasserbereich, Nuxe-Bereich oder Balneotherapie-Bereich für einen Moment purer Entspannung inmitten der Natur mit Blick auf den Park und die Berge"
    ],
    "en": [
      "Choose between our 3 areas: Espace Aqualudique, Espace Nuxe or Espace Balnéothérapie for a moment of pure relaxation in the heart of nature."
    ],
    "it": [
      "Scegliete tra le nostre 3 aree: Espace Aqualudique, Espace Nuxe o Espace Balnéothérapie per un momento di puro relax nel cuore della natura."
    ],
    "fr": [
      "Les Bains des Alpes - Spa Nuxe du Domaine de Marlioz :  Choisissez entre nos 3 espaces : Espace aqualudique, espace Nuxe ou espace Balnéothérapie pour un pur moment de détente au cœur de la nature avec vue sur le parc et les montagnes"
    ],
    "nl": [
      "Les Bains des Alpes - Spa Nuxe du Domaine de Marlioz: Kies tussen onze 3 zones: Aqualudic zone, Nuxe zone of Balneotherapie zone voor een puur moment van ontspanning in het hart van de natuur met uitzicht op het park en de bergen"
    ],
    "es": [
      "Les Bains des Alpes - Spa Nuxe du Domaine de Marlioz: Elija entre nuestras 3 zonas: zona Aqualudic, zona Nuxe o zona Balneoterapia para un momento de pura relajación en plena naturaleza con vistas al parque y a las montañas"
