  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/8aac7c52-5fcc-3bb2-9866-79e21a932098",
      "dc:description": {
        "de": [
          "Schulparade - von allen Schülern von Camus und den großen Klassen von Calmette und Mozart ab 14.00 Uhr , Parade in der Rue des Canadiens, Rue Auguste Comte, Rue Jules Renard, Rue Roland Dorgelès, Rue Carnot, Rue des canadiens, Die Parade wird bei schlechtem Wetter abgesagt."
        ],
        "en": [
          "Parade of schools - by all Camus pupils and Calmette and Mozart kindergarten classes from 2:00 p.m. , parade on rue des Canadiens, rue Auguste Comte, rue Jules Renard, rue Roland Dorgelès, rue Carnot, rue des canadiens, The parade will be cancelled in case of bad weather."
        ],
        "it": [
          "Sfilata delle scuole - da parte di tutti gli alunni di Camus e delle classi della scuola materna di Calmette e Mozart a partire dalle 14.00, sfilata su rue des Canadiens, rue Auguste Comte, rue Jules Renard, rue Roland Dorgelès, rue Carnot, rue des canadiens, La sfilata sarà annullata in caso di maltempo."
        ],
        "fr": [
          "Défilé des écoles - par l'ensemble des élèves de Camus et les classes de grande section de Calmette et Mozart à partir de 14h00 , défilé rue des Canadiens, rue Auguste Comte, rue Jules Renard, rue Roland Dorgelès, rue Carnot, rue des canadiens, Le défilé sera annulé en cas de mauvais temps."
        ],
        "nl": [
          "Optocht van de scholen - door alle leerlingen van Camus en de kleuterklassen van Calmette en Mozart vanaf 14.00 uur, optocht in de rue des Canadiens, rue Auguste Comte, rue Jules Renard, rue Roland Dorgelès, rue Carnot, rue des canadiens, De optocht wordt geannuleerd bij slecht weer."
        ],
        "es": [
          "Desfile de las escuelas - por todos los alumnos de Camus y las clases de parvulario de Calmette y Mozart a partir de las 14.00 horas, desfile por la rue des Canadiens, rue Auguste Comte, rue Jules Renard, rue Roland Dorgelès, rue Carnot, rue des canadiens, El desfile se cancelará en caso de mal tiempo."
        ]
      },
