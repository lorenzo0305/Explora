  "rdfs:comment": {
    "de": [
      "Die halbkreisförmigen Mauern, die sich von einem Ufer des Sees zum anderen erstreckten, schützten das Dorf vor Angriffen vom Land aus. Bis heute sind die Mauern erhalten geblieben"
    ],
    "en": [
      "stretching from one shore of the lake to the other, the semi-circular ramparts protected the village from land-based attacks. The walls still stand today."
    ],
    "it": [
      "Estesi da una sponda all'altra del lago, i bastioni semicircolari proteggevano il villaggio dagli attacchi via terra. Le mura sono ancora oggi in piedi."
    ],
    "fr": [
      "s'étendant d'une berge à l'autre du lac, les remparts en demi-cercle protégeaient le village des attaques terrestres. Ils subsistent encore aujourd'hui cette enceinte"
    ],
    "es": [
      "las murallas semicirculares, que se extendían de una orilla a otra del lago, protegían la aldea de los ataques por tierra. Este muro aún se conserva en la actualidad"
    ],
    "nl": [
      "De halfronde wallen strekten zich uit van de ene oever van het meer tot de andere en beschermden het dorp tegen aanvallen vanaf het land. De muren staan er vandaag de dag nog steeds."
    ]
  },
  "rdfs:label": {
    "de": [
      "Die Stadtmauern"
    ],
    "en": [
      "The ramparts"
    ],
    "it": [
      "I bastioni"
    ],
    "fr": [
      "Les remparts"
    ],
    "nl": [
      "De wallen"
    ]
  },
