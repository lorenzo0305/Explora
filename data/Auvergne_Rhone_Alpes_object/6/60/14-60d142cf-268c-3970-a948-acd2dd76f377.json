      "dc:description": {
        "de": [
          "Einrichtung, Tischkultur, Dekoration.\n\nLust, eine Bestellung aufzugeben?\nFinden Sie die Must-Haves der Boutique, indem Sie auf die Schaltfläche \"Reservieren\" klicken"
        ],
        "en": [
          "Furnishings, tableware, home decor.\n\nWant to place an order?\nClick on the \"Reserve\" button to find out more about the store's must-haves"
        ],
        "it": [
          "Arredi, stoviglie, decorazioni.\n\nVolete fare un ordine?\nCliccate sul pulsante \"Prenota\" per vedere tutti i must del negozio"
        ],
        "fr": [
          "Ameublement, art de la table, déco.\n\nEnvie de passer une commande ? \nRetrouvez les incontournables de la boutique en cliquant sur le bouton \"Réserver\""
        ],
        "es": [
          "Mobiliario, vajilla, decoración.\n\n¿Quiere hacer un pedido?\nHaga clic en el botón \"Reservar\" para ver todos los imprescindibles de la tienda"
        ],
        "nl": [
          "Meubels, servies, decoratie.\n\nWil je een bestelling plaatsen?\nKlik op de knop \"Reserveren\" om alle musthaves van de winkel te bekijken"
        ]
