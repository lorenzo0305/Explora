  "rdfs:comment": {
    "de": [
      "Der M Kid Burger liegt ideal auf der Piste des Vikings und gegenüber dem Gletscher von La Muzelle. Er kann Sie auf seiner nach Süden ausgerichteten Terrasse empfangen. Sandwiches, Hot Dogs, gebratene Würstchen, Paninis, Hamburger..."
    ],
    "en": [
      "Ideally situated on the Vikings' slopes and in front of the Muzelle, the Kid Burger welcomes you on its sunny terrace. Sandwiches, hot dogs, sausages & french fries, paninis, burgers..."
    ],
    "it": [
      "Situato in posizione ideale sulla pista di sci Vikings e di fronte al ghiacciaio della Muzelle, il Kid Burger può accogliervi sulla sua terrazza esposta a sud. Panini, hot dog, salsicce fritte, panini, hamburger ..."
    ],
    "fr": [
      "Idéalement situé sur la piste des Vikings et face au glacier de la Muzelle, le M Kid Burger peut vous accueillir sur sa terrasse orientée sud. Sandwiches, hot dogs, saucisses frites, paninis, hamburgers..."
    ],
    "nl": [
      "M Kid Burger is ideaal gelegen aan het Vikingpad en kijkt uit op de Muzelle-gletsjer. Je bent van harte welkom op het terras op het zuiden. Broodjes, hotdogs, gebakken worstjes, panini's, hamburgers..."
    ],
    "es": [
      "Idealmente situado en el sendero de los vikingos y frente al glaciar de Muzelle, M Kid Burger le da la bienvenida en su terraza orientada al sur. Bocadillos, perritos calientes, salchichas fritas, paninis, hamburguesas..."
    ]
  },
