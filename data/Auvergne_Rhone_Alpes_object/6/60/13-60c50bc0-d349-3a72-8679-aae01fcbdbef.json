  "rdfs:comment": {
    "de": [
      "Spezialitätenkaffee, der vor Ort geröstet wird.\r\nZum Verkauf angebotene Produkte: Kaffeebohnen und gemahlener Kaffee.\r\nLassen Sie sich im Coffeeshop nieder und probieren Sie das Gebäck vor Ort."
    ],
    "en": [
      "Specialty coffee, roasted on site.\r\nProducts available for sale: coffee beans and ground coffee.\r\nTake a seat in the coffee shop and enjoy our pastries."
    ],
    "it": [
      "Specialità di caffè, tostate in loco.\r\nProdotti in vendita: caffè in grani e caffè macinato.\r\nAccomodatevi nella caffetteria e gustate i nostri dolci."
    ],
    "fr": [
      "Café de spécialité, torréfié sur place.\r\nProduits disponibles à la vente : café en grain et moulu.\r\nInstallez vous au coffee shop et dégustez les pâtisseries sur place."
    ],
    "nl": [
      "Specialiteitenkoffie, ter plekke gebrand.\r\nProducten te koop: koffiebonen en gemalen koffie.\r\nNeem plaats in de koffiebar en geniet van ons gebak."
    ],
    "es": [
      "Especialidad de café tostado in situ.\r\nProductos a la venta: café en grano y café molido.\r\nTome asiento en la cafetería y disfrute de nuestra repostería."
    ]
  },
  "rdfs:label": {
