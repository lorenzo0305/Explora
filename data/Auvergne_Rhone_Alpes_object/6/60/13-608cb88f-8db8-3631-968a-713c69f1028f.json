  "rdfs:comment": {
    "de": [
      "Ein reichhaltiges und vielfältiges Dokumentationsangebot: Bücher, Zeitschriften, CDs, DVDs, Kassettenbücher, Dias... auf über 1300 m².\r\nIm Herzen des architektonischen Ensembles Les Etoiles, gegenüber dem Rathaus. Lesepunkt im Viertel Les Vernes."
    ],
    "en": [
      "A rich and diversified documentary offer: books, magazines, CDs, DVDs, books on tape, slides... on more than 1300 m².\r\nIn the heart of the Etoiles architectural complex, facing the City Hall. Reading point in the Vernes district."
    ],
    "it": [
      "Un'offerta documentaria ricca e diversificata: libri, riviste, CD, DVD, cassette, diapositive... su oltre 1300 m².\r\nNel cuore del complesso architettonico delle Etoiles, di fronte al Municipio. Punto di lettura nel quartiere di Vernes."
    ],
    "fr": [
      "Une offre documentaire riche et diversifiée : livres, revues, CD, DVD, livres cassettes, diapos... sur plus de 1300 m².\r\nAu coeur de l'ensemble architectural des Etoiles, face à l'Hôtel de Ville. Point lecture dans le quartier des Vernes."
    ],
    "es": [
      "Una oferta documental rica y diversificada: libros, revistas, CD, DVD, casetes, diapositivas... en más de 1300 m².\r\nEn el corazón del conjunto arquitectónico de las Etoiles, frente al Ayuntamiento. Punto de lectura en el barrio de Vernes."
    ],
    "nl": [
      "Een rijk en gediversifieerd documentair aanbod: boeken, tijdschriften, cd's, dvd's, cassetteboeken, dia's... op meer dan 1300 m².\r\nIn het hart van het architectuurcomplex Etoiles, tegenover het stadhuis. Leespunt in de wijk Vernes."
    ]
  },
  "rdfs:label": {
