  "rdfs:comment": {
    "de": [
      "Willkommen bei Evolution 2, Ihrer Ski- und Abenteuerschule in den Bergen, Sommer wie Winter. Unser Skilehrerteam begleitet und betreut Sie bei all Ihren Aktivitäten, das Ganze in aller Sicherheit und mit einem persönlichen Unterricht."
    ],
    "en": [
      "Welcome to Evolution 2, your ski and adventure school in the mountains, both in summer and winter.\r\nOur team of instructors guides and supports you in all your activities, ensuring safety and providing personalized teaching."
    ],
    "it": [
      "Benvenuti a Evolution 2, la vostra scuola estiva e invernale di sci e avventura in montagna. Il nostro team di istruttori vi guiderà e supervisionerà in tutte le vostre attività, in totale sicurezza e con un insegnamento personalizzato."
    ],
    "fr": [
      "Bienvenue chez Evolution 2, votre école de ski et d’aventures à la montagne, été comme hiver. Notre équipe de moniteurs vous accompagne et vous encadre dans toutes vos activités, le tout en toute sécurité et avec un enseignement personnalisé."
    ],
    "nl": [
      "Welkom bij Evolution 2, uw ski- en avonturenschool in de bergen, zowel in de zomer als in de winter.\r\nOns team van instructeurs begeleidt en ondersteunt u bij al uw activiteiten, met volledige aandacht voor veiligheid en persoonlijk onderwijs."
    ],
    "es": [
      "Bienvenido a Evolution 2, tu escuela de verano e invierno de esquí y aventura en la montaña. Nuestro equipo de monitores te guiará y supervisará en todas tus actividades, con total seguridad y una enseñanza personalizada."
    ]
  },
