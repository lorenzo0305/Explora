  "rdfs:comment": {
    "de": [
      "Teilen und austauschen bei Themenabenden. Das Restaurant bietet Ihnen einfache und originelle Gerichte aus frischen Zutaten."
    ],
    "en": [
      "Share and exchange around themed evenings. The restaurant offers simple and original dishes from fresh products."
    ],
    "it": [
      "Condividere e scambiare intorno a serate a tema. Il ristorante offre piatti semplici e originali a base di prodotti freschi."
    ],
    "fr": [
      "Partager et échanger autour de soirées à thème. Le restaurant vous propose des plats simples et originaux à partir de produits frais."
    ],
    "nl": [
      "Delen en uitwisselen rond thema-avonden. Het restaurant biedt eenvoudige en originele gerechten op basis van verse producten."
    ],
    "es": [
      "Compartir y socializar en veladas temáticas. El restaurante sirve platos sencillos y originales elaborados con productos frescos."
    ]
  },
