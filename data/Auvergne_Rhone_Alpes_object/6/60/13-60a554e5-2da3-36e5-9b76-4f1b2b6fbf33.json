  "rdfs:comment": {
    "de": [
      "Die dem Heiligen Mauritius (Märtyrer) geweihte Kirche bewahrt von dem romanischen Gebäude die ersten drei Joche und eine polychrome Jungfrau aus dem 12.\r\nJahrhundert. Altar aus vergoldetem Holz aus der Renaissance."
    ],
    "en": [
      "The church, dedicated to Saint-Maurice (martyr), retains the first three bays of the Romanesque edifice and a 12th-century polychrome Madonna.\r\nRenaissance gilded wood altar."
    ],
    "it": [
      "La chiesa, dedicata a San Maurizio (martire), conserva le prime tre campate dell'edificio romanico e una Madonna policroma del XII secolo.\r\nAltare rinascimentale in legno dorato."
    ],
    "fr": [
      "L'église, dédiée à Saint-Maurice (martyr) conserve de l'édifice roman les trois premières travées et une vierge polychrome du XIIe siècle.\r\nAutel en bois doré Renaissance."
    ],
    "es": [
      "La iglesia, dedicada a San Mauricio (mártir), conserva las tres primeras naves del edificio románico y una Virgen María policromada del siglo XII.\r\nAltar renacentista de madera dorada."
    ],
    "nl": [
      "De kerk, gewijd aan Saint-Maurice (martelaar), behoudt de eerste drie traveeën van het Romaanse gebouw en een 12e-eeuwse polychrome Maagd Maria.\r\nRenaissance verguld houten altaar."
    ]
  },
