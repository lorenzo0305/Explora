  "rdfs:comment": {
    "de": [
      "Eine Schleife zwischen dem wilden und tief eingeschnittenen Ozon-Tal, dem Plateau und den Hängen von Saint-Joseph vor dem Hintergrund des Rhône-Tals und der Alpen.\r\nEntdecken Sie die App MHIKES."
    ],
    "en": [
      "A walk between the Ozon valley, wild and steep, the plateau and the hillsides of Saint-Joseph with views of the Rhône valley and the Alps.\r\nTo be discovered in the MHIKES application."
    ],
    "it": [
      "Un anello tra l'aspra valle di Ozon e l'altopiano e le colline di Saint Joseph, con la valle del Rodano e le Alpi sullo sfondo.\r\nScoprite l'applicazione MHIKES."
    ],
    "fr": [
      "Une boucle entre la vallée de l’Ozon, sauvage et encaissée, le plateau et les coteaux de saint joseph avec en toile de fond la vallée du Rhône et les Alpes.\r\nA découvrir l'application MHIKES."
    ],
    "es": [
      "Un bucle entre el escarpado valle del Ozon y la meseta y laderas de Saint Joseph, con el valle del Ródano y los Alpes al fondo.\r\nDescubre la aplicación MHIKES."
    ],
    "nl": [
      "Een lus tussen de ruige Ozon vallei en het plateau en de hellingen van Saint Joseph, met de Rhône vallei en de Alpen op de achtergrond.\r\nOntdek de MHIKES-toepassing."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les rives de l'Ozon"
    ]
  },
