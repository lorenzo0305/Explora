  "rdfs:comment": {
    "de": [
      "Der Spa-/Entspannungsbereich umfasst 2 Saunakabinen, ein Dampfbad, einen Whirlpool mit 2 warmen Bädern, einem kalten Bad, Erlebnisduschen und eine große Entspannungslounge.\r\nNach vorheriger Reservierung (vor Ort oder per Telefon 04 79 22 06 75)"
    ],
    "en": [
      "The spa / relaxation area including: 2 sauna cabins, one hammam, one spa with 2 hot baths, a cold bath and a vast relaxation lounge with showers \"experiments\".\r\nBooking required (on site or by telephone + 33 4 79 22 06 75)"
    ],
    "it": [
      "L'area spa/relax comprende 2 cabine sauna, un hammam, una spa con 2 bagni caldi, un bagno freddo, docce \"experience\" e un'ampia sala relax.\r\nPrenotazione obbligatoria (in loco o al telefono 04 79 22 06 75)"
    ],
    "fr": [
      "L'Espace spa / détente comprend 2 cabines de sauna, un hammam, un spa avec 2 bains chauds, un bain froid, douches \"expériences\" et un vaste salon détente.\r\nSur réservation préalable (sur place ou par téléphone 04 79 22 06 75)"
    ],
    "es": [
      "La zona de spa / relajación incluye 2 cabinas de sauna, un hammam, un spa con 2 baños calientes, un baño frío, duchas \"experiencia\" y un gran salón de relajación.\r\nReserva previa (in situ o por teléfono 04 79 22 06 75)"
    ],
    "nl": [
      "De spa / Ontspanningsruimte omvat: 2 saunacabines, een hammam, een spa met 2 warme baden, een koud bad en een grote ontspanningsruimte met \"ervarings\"-douches.\r\nVooraf reserveren verplicht (ter plaatse of telefonisch + 33 4 79 22 06 75)"
    ]
  },
  "rdfs:label": {
