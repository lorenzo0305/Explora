  "rdfs:comment": {
    "de": [
      "Das Schloss Montfleury aus dem 16. bis 18. Jahrhundert befindet sich an der Weinstraße der Auvergne, in der Nähe von Vic-le-Comte und Corrent. Sie werden ein Denkmal entdecken, das stark von südlichen Einflüssen geprägt ist, mit seinem italienischen Hof und seiner Terrasse."
    ],
    "en": [
      "Château de Montfleury, dating from the 16th and 18th centuries, is located on the Auvergne wine route, near Vic-le-Comte and Corrent. You'll discover a monument strongly marked by southern influences, with its Italian courtyard and terrace."
    ],
    "it": [
      "Il castello di Montfleury, risalente al XVI-XVIII secolo, si trova sulla strada del vino dell'Alvernia, vicino a Vic-le-Comte e Corrent. Scoprirete un monumento molto segnato dalle influenze meridionali, con la sua corte italiana e la sua terrazza."
    ],
    "fr": [
      "Le château de Montfleury, datant du XVI-XVIIIème siècle, se trouve sur la route des vins d'Auvergne, près de Vic-le-Comte et Corrent. Vous découvrirez un monument très marqué par les influences méridionales, avec sa cour Italienne et sa terrasse."
    ],
    "nl": [
      "Het kasteel van Montfleury, daterend uit de XVI-XVIIIe eeuw, ligt aan de wijnroute van de Auvergne, in de buurt van Vic-le-Comte en Corrent. U zult een monument ontdekken dat zeer getekend is door de zuidelijke invloeden, met zijn Italiaanse hof en zijn terras."
    ],
    "es": [
      "El castillo de Montfleury, del siglo XVI-XVIII, está situado en la ruta del vino de Auvernia, cerca de Vic-le-Comte y Corrent. Descubrirá un monumento muy marcado por las influencias meridionales, con su patio italiano y su terraza."
    ]
  },
