  "rdfs:comment": {
    "de": [
      "Tauchen Sie ein in die Welt von Michelin durch eine immersive Szenografie, die mehr als ein Jahrhundert an Innovationen, Abenteuern und industriellem Know-how im Herzen von Clermont-Ferrand nachzeichnet."
    ],
    "en": [
      "Immerse yourself in Michelin's world through an immersive scenography retracing more than a century of innovations, adventures and industrial know-how in the heart of Clermont-Ferrand."
    ],
    "it": [
      "Immergetevi nel mondo di Michelin attraverso una scenografia immersiva che ripercorre più di un secolo di innovazione, avventura e know-how industriale nel cuore di Clermont-Ferrand."
    ],
    "fr": [
      "Plongez dans l’univers Michelin à travers une scénographie immersive retraçant plus d’un siècle d’innovations, d’aventures et de savoir‑faire industriel au cœur de Clermont‑Ferrand."
    ],
    "es": [
      "Sumérjase en el universo Michelin a través de una escenografía envolvente que recorre más de un siglo de innovación, aventura y saber hacer industrial en el corazón de Clermont-Ferrand."
    ],
    "nl": [
      "Dompel jezelf onder in de wereld van Michelin via een meeslepende scenografie die meer dan een eeuw innovatie, avontuur en industriële knowhow in het hart van Clermont-Ferrand laat zien."
    ]
  },
