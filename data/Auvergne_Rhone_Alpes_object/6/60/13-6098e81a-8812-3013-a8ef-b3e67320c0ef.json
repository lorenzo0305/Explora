  "rdfs:comment": {
    "de": [
      "Der Mountainbike-Club von Espaly lädt Sie zu seiner traditionellen Mountainbike-Tour \"l'Espaviote\" ein.\r\nSie haben die Wahl zwischen vier Strecken: 20, 30, 42 und 57 km.\r\nDie Einschreibungen erfolgen ab 13 Uhr für einen Massenstart um 14 Uhr.\r\nVerpflegung auf der Strecke."
    ],
    "en": [
      "The Club VTT d'Espaly invites you to its traditional \"Espaviote\" mountain bike ride.\r\nYou can choose between 4 routes: 20, 30, 42 and 57 kms.\r\nRegistration from 1pm for a group start at 2pm.\r\nRefreshments along the route."
    ],
    "it": [
      "Il Club VTT d'Espaly vi invita alla tradizionale passeggiata in mountain bike \"Espaviote\".\r\nCi saranno 4 percorsi tra cui scegliere: 20, 30, 42 e 57 km.\r\nIscrizioni a partire dalle 13.00 per una partenza di gruppo alle 14.00.\r\nRistoro lungo il percorso."
    ],
    "fr": [
      "Le Club VTT d'Espaly vous invite à sa traditionnelle randonnée VTT \"l'Espaviote\".\r\nVous aurez le choix entre 4 parcours : 20, 30, 42 et 57 kms.\r\nLes inscriptions se font à partir de 13h pour un départ groupé à 14h.\r\nRavitaillement sur le parcours."
    ],
    "es": [
      "El Club VTT d'Espaly te invita a su tradicional marcha en bicicleta de montaña \"Espaviote\".\r\nHabrá 4 recorridos a elegir: 20, 30, 42 y 57 kms.\r\nInscripciones a partir de las 13h para una salida en grupo a las 14h.\r\nAvituallamiento a lo largo del recorrido."
    ],
    "nl": [
      "De Club VTT d'Espaly nodigt je uit voor zijn traditionele \"Espaviote\" mountainbiketocht.\r\nJe kunt kiezen uit 4 routes: 20, 30, 42 en 57 km.\r\nInschrijving vanaf 13.00 uur voor een groepsstart om 14.00 uur.\r\nVerfrissingen langs de route."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Randonnée VTT L'Espaviote"
    ]
  },
