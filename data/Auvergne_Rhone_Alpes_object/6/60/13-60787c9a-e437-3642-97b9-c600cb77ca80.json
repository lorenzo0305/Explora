  "rdfs:comment": {
    "de": [
      "Ein spielerisches und leistungsstarkes Mountainbike, das vom Bosh Performance CX-Motor angetrieben wird. Es bietet Ihnen mehr Komfort und Kontrolle auf jeder Art von Weg."
    ],
    "en": [
      "A fun, high-performance mountain bike powered by the Bosh Performance CX engine. It will give you greater comfort and control on all types of trails."
    ],
    "it": [
      "Una mountain bike divertente e performante, alimentata dal motore Bosh Performance CX. Vi garantirà un maggiore comfort e controllo su tutti i tipi di sentieri."
    ],
    "fr": [
      "Un VTT ludique et performant, propulsé par le moteur Bosh Performance CX. Il vous procurera un confort et un contrôle accrus sur tout type de chemin."
    ],
    "es": [
      "Una bicicleta de montaña divertida y de alto rendimiento con el motor Bosh Performance CX. Le proporcionará mayor comodidad y control en todo tipo de senderos."
    ],
    "nl": [
      "Een leuke, krachtige mountainbike die wordt aangedreven door de Bosh Performance CX-motor. Hij geeft je meer comfort en controle op alle soorten trails."
    ]
