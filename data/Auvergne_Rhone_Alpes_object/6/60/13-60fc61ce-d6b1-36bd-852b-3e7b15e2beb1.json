  "rdfs:comment": {
    "de": [
      "La Coccinelle lädt Sie ein, mit dieser Freundesgruppe, die aus drei Gitarren und einer Stimme besteht, einen guten Moment zu Kultmusik von gestern und heute zu teilen."
    ],
    "en": [
      "La Coccinelle invites you to share a good time with this band of friends, made up of 3 guitars and a voice, on cult music from yesterday and today."
    ],
    "it": [
      "La Coccinelle vi invita a condividere un buon momento con questa band di amici, composta da 3 chitarre e una voce, su musiche di culto di ieri e di oggi."
    ],
    "fr": [
      "La Coccinelle vous invite à partager un bon moment avec cette bande de copains, composée de 3 guitares et une voix, sur des musiques cultes d'hier et d'aujourd'hui."
    ],
    "es": [
      "La Coccinelle te invita a compartir un buen rato con esta banda de amigos, formada por 3 guitarras y una voz, en torno a la música de culto de ayer y de hoy."
    ],
    "nl": [
      "La Coccinelle nodigt je uit om een goede tijd te delen met deze band van vrienden, bestaande uit 3 gitaren en een stem, op cult muziek van gisteren en vandaag."
    ]
  },
