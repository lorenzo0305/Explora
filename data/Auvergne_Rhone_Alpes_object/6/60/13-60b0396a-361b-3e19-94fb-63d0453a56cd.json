  "rdfs:comment": {
    "de": [
      "Grafisches und künstlerisches Schaffen, Aquarellmaler und andere Techniken. Erstellung von Berggemälden, Auftragsarbeiten\r\nmöglich und Verkauf von Originalen, Erstellung von grafischen Vorlagen, Illustrationen usw."
    ],
    "en": [
      "Graphic and artistic design, watercolour painter and other techniques. Creation of mountain paintings, commissions available and sale of originals, creation of graphic charters, illustrations, etc. Exhibitions to be found this winter."
    ],
    "it": [
      "Creazione grafica e artistica, pittore di acquerelli e altre tecniche. Creazione di dipinti di montagna, eventuali ordini e vendita di originali, creazione di linee guida grafiche, illustrazioni, ecc."
    ],
    "fr": [
      "Création graphique & artistique, peintre aquarelliste et autres techniques. Réalisation de peintures de montagne, commandes possibles et vente d’originaux, réalisation de charte graphique, d’illustrations, etc...Expositions à retrouver cet hiver."
    ],
    "nl": [
      "Grafische & artistieke creatie, aquarelschilder en andere technieken. Creatie van bergschilderijen, mogelijke bestellingen en verkoop van originelen, creatie van grafische richtlijnen, illustraties, etc. Tentoonstellingen te zien deze winter."
    ],
    "es": [
      "Creación gráfica y artística, pintor acuarelista y otras técnicas. Creación de cuadros de montaña, posibles encargos y venta de originales, creación de pautas gráficas, ilustraciones, etc. Exposiciones que se verán este invierno."
    ]
  },
