  "rdfs:comment": {
    "de": [
      "Das Theater von Châtel-Guyon ist von prächtigen Gebäuden und Villen aus der Zeit um die Jahrhundertwende umgeben, die in ihrem ursprünglichen Zustand erhalten geblieben sind."
    ],
    "en": [
      "The Theatre of Châtel-Guyon is surrounded by sumptuous buildings and villas, dating from the beginning of the last century, preserved as is."
    ],
    "it": [
      "Il Teatro di Châtel-Guyon è circondato da sontuosi edifici e ville risalenti all'inizio del secolo scorso, conservati nel loro stato originale."
    ],
    "fr": [
      "Le Théâtre de Châtel-Guyon est entouré de bâtiments somptueux et de villas, datant du début du siècle dernier, préservés en l’état."
    ],
    "nl": [
      "Het theater van Châtel-Guyon wordt omringd door weelderige gebouwen en villa's uit het begin van de vorige eeuw, die in hun oorspronkelijke staat bewaard zijn gebleven."
    ],
    "es": [
      "El Teatro de Châtel-Guyon está rodeado de suntuosos edificios y villas de principios del siglo pasado, conservados en su estado original."
    ]
