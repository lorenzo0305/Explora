  "rdfs:comment": {
    "de": [
      "Unsere hausgemachten Rezepte sind von der traditionellen libanesisch-armenischen Küche inspiriert. Unsere Produkte werden sorgfältig ausgewählt, um Ihnen lokale Produkte und Qualität zu bieten."
    ],
    "en": [
      "Our homemade recipes are inspired by traditional Lebanese-Armenian cuisine. Our products are carefully selected to offer you local, quality ingredients."
    ],
    "it": [
      "Le nostre ricette casalinghe si ispirano alla cucina tradizionale libanese-armena. I nostri prodotti sono selezionati con cura per offrirvi i migliori prodotti locali e la migliore qualità."
    ],
    "fr": [
      "Nos recettes, faites maison, sont inspirées de la cuisine traditionnelle libano-arménienne. Nos produits sont soigneusement sélectionnés afin de vous proposer du local et de la qualité."
    ],
    "nl": [
      "Onze huisgemaakte recepten zijn geïnspireerd op de traditionele Libanees-Armeense keuken. Onze producten worden zorgvuldig geselecteerd om je de beste lokale producten en kwaliteit te kunnen bieden."
    ],
    "es": [
      "Nuestras recetas caseras se inspiran en la cocina tradicional libanesa-armenia. Nuestros productos se seleccionan cuidadosamente para ofrecerle los mejores productos locales y de calidad."
    ]
  },
  "rdfs:label": {
