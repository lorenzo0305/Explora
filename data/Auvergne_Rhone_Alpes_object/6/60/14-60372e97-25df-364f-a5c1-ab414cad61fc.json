  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/d87cafa6-9523-3bf8-b4ad-15b5a9f6b0b2",
      "dc:description": {
        "de": [
          "informationen:\n\nProdukte: Ethische Kleidung für Männer und Frauen + Werkstatt für die Herstellung von Maßkleidung\n\nBestellungen:\nBestellungen können über die Website, Instagram, Facebook oder telefonisch unter 09 83 48 18 60 aufgegeben werden.\n\nAbholung:\nBestellungen können von Dienstag bis Samstag von 14:00 bis 19:00 Uhr abgeholt werden.\n\n "
        ],
        "en": [
          "information:\n\nProducts: ethical clothing for men and women + custom clothing workshop\n\nOrdering :\nPossibility of ordering via the website, Instagram, Facebook or by phone on 09 83 48 18 60.\n\nCollection:\nOrders can be collected from Tuesday to Saturday, 2pm to 7pm.\n\n "
        ],
        "it": [
          "informazioni:\n\nProdotti: abbigliamento etico per uomo e donna + laboratorio di abbigliamento su misura\n\nOrdini :\nPossibilità di ordinare tramite il sito web, Instagram, Facebook o per telefono allo 09 83 48 18 60.\n\nRitiro:\nGli ordini possono essere ritirati dal martedì al sabato dalle 14.00 alle 19.00.\n\n "
        ],
        "fr": [
          "information: \n\nProduits : vêtements éthiques pour homme et femme + atelier de fabrication de vêtements sur-mesure\n\nCommandes :\nPossibilité de commander par le site internet, Instagram, Facebook ou par téléphone au 09 83 48 18 60.\n\nRetrait : \nLes commandes sont à retirer du mardi au samedi de 14h à 19h.\n\n "
        ],
        "nl": [
          "informatie:\n\nProducten: ethische kleding voor mannen en vrouwen + kledingatelier op maat\n\nBestellingen :\nMogelijkheid tot bestellen via de website, Instagram, Facebook of telefonisch op 09 83 48 18 60.\n\nAfhalen:\nBestellingen kunnen worden afgehaald van dinsdag tot en met zaterdag van 14.00 tot 19.00 uur.\n\n "
        ],
        "es": [
          "información:\n\nProductos: ropa ética para hombre y mujer + taller de confección a medida\n\nPedidos :\nPosibilidad de hacer pedidos a través de la página web, Instagram, Facebook o por teléfono en el 09 83 48 18 60.\n\nRecogida:\nLos pedidos se pueden recoger de martes a sábado de 14:00 a 19:00.\n\n "
        ]
      },
