  "rdfs:comment": {
    "de": [
      "Die privilegierte Lage unseres Restaurants lädt Liebhaber des Guten und Schönen dazu ein, köstliche Momente zu verbringen.\r\nDas Abbaye de Talloires verspricht Ihnen ein schmackhaftes Essen in einer traumhaften Umgebung mit einem Team, das zugleich aufmerksam, warmherzig und diskret ist."
    ],
    "en": [
      "The privileged location of our restaurant invites lovers of the good and the beautiful to spend delicious moments.\r\nL'Abbaye de Talloires promises you a tasty meal in a dream setting, with a team that is attentive, warm and discreet."
    ],
    "it": [
      "Grazie alla sua posizione privilegiata, il nostro ristorante invita gli amanti del buono e del bello a trascorrere momenti stupendi."
    ],
    "fr": [
      "L'emplacement privilégié de notre restaurant invite les amateurs du bon et du beau à passer de délicieux moments.\r\nL'Abbaye de Talloires vous promet un repas savoureux dans un décor de rêve avec une équipe à la fois attentive, chaleureuse et discrète."
    ],
    "es": [
      "La ubicación privilegiada de nuestro restaurante invita a los amantes de lo bueno y lo bello a pasar momentos deliciosos.\r\nLa Abadía de Talloires le promete una comida sabrosa en un entorno de ensueño con un equipo a la vez atento, cálido y discreto."
    ],
    "nl": [
      "De bevoorrechte ligging van ons restaurant nodigt liefhebbers van lekker en mooi uit om heerlijke momenten te beleven."
    ]
  },
