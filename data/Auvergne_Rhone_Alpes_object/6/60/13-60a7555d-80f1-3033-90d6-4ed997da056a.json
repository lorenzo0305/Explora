  "rdfs:comment": {
    "de": [
      "Die romanische Stiftskirche Saint-Laurent d'Auzon, die seit 1906 unter Denkmalschutz steht, enthüllt ein bemerkenswertes Kulturerbe: mittelalterliche Wandmalereien, eine mit romanischen Türbändern geschmückte Tür und ein romanischer Christus machen sie zu einem unumgänglichen Ort, den es zu entdecken gilt"
    ],
    "en": [
      "Listed as a Historic Monument since 1906, the Romanesque collegiate church of Saint-Laurent d'Auzon boasts a remarkable heritage: medieval wall paintings, a door adorned with Romanesque hinges and a Romanesque Christ, making it a must-see place to discover"
    ],
    "it": [
      "Classificata come Monumento Storico dal 1906, la collegiata romanica di Saint-Laurent d'Auzon vanta un patrimonio notevole: pitture murali medievali, una porta ornata di cardini romanici e un Cristo romanico, che la rendono un sito da non perdere"
    ],
    "fr": [
      "Classée Monument Historique depuis 1906, la collégiale romane Saint-Laurent d'Auzon dévoile un patrimoine remarquable : peintures murales médiévales, porte ornée de pentures romanes et Christ roman, qui en font un lieu incontournable à découvrir"
    ],
    "es": [
      "Declarada Monumento Histórico desde 1906, la colegiata románica de Saint-Laurent d'Auzon posee un patrimonio notable: pinturas murales medievales, una puerta adornada con bisagras románicas y un Cristo románico, que la convierten en un lugar de visita obligada"
    ],
    "nl": [
      "De Romaanse collegiale kerk Saint-Laurent d'Auzon, die sinds 1906 op de lijst van historische monumenten staat, heeft een opmerkelijk erfgoed: middeleeuwse muurschilderingen, een deur versierd met Romaanse scharnieren en een Romaanse Christus, waardoor het een bezienswaardigheid is die je niet mag missen"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Collégiale Saint-Laurent"
