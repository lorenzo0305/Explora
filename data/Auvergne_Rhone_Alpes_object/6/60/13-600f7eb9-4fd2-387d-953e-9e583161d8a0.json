  "rdfs:comment": {
    "de": [
      "Die Grande Traversée de l'Ardèche VTT verbindet Annonay und Bourg-Saint-Andéol von Nord nach Süd auf einer Strecke von über 315 km. Sie werden die Berge Mézenc und Gerbier de Jonc, den Wald von Païolive und schließlich die Schluchten der Ardèche entdecken"
    ],
    "en": [
      "The Grande Traversée de l'Ardèche VTT runs north-south from Annonay to Bourg-Saint-Andéol over 315km. You'll discover the Mézenc and Gerbier de Jonc mountains, the Païolive forest and the Ardèche Gorges."
    ],
    "it": [
      "La Grande Traversée de l'Ardèche VTT si snoda in direzione nord-sud da Annonay a Bourg-Saint-Andéol per 315 km. Scoprite le montagne del Mézenc e del Gerbier de Jonc, il bosco di Païolive e le Gole dell'Ardèche"
    ],
    "fr": [
      "La Grande Traversée de l'Ardèche VTT relie du nord au sud Annonay à Bourg-Saint-Andéol sur plus de 315km. Avides de grands espaces vous découvrirez les Monts Mézenc et Gerbier de Jonc, le bois de Païolive et enfin les Gorges de l'Ardèche"
    ],
    "es": [
      "La Grande Traversée de l'Ardèche VTT recorre 315 km de norte a sur, de Annonay a Bourg-Saint-Andéol. Descubra los montes Mézenc y Gerbier de Jonc, el bosque de Païolive y las gargantas del Ardèche"
    ],
    "nl": [
      "De Grande Traversée de l'Ardèche VTT loopt in noord-zuidrichting van Annonay naar Bourg-Saint-Andéol over 315 km. Ontdek de bergen Mézenc en Gerbier de Jonc, het bos van Païolive en de Gorges de l'Ardèche"
    ]
  },
  "rdfs:label": {
    "en": [
      "Grande Traversée de l'Ardèche VTT Stage 5 from Montselgues to Les Vans"
    ],
    "fr": [
      "Grande Traversée de l'Ardèche VTT Etape 5 de Montselgues à Les Vans"
    ]
  },
