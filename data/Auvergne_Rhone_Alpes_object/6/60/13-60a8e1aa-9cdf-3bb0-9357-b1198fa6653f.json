  "rdfs:comment": {
    "de": [
      "Entdecken Sie eine traditionelle Messerschmiede, die sich in einem Gebäude mit einer über 200-jährigen Geschichte befindet. Hier lernen Sie ein Handwerk von gestern und heute kennen."
    ],
    "en": [
      "Come and discover a traditional cutlery workshop housed in a building with over 200 years of history. You'll discover a craft of yesterday and today."
    ],
    "it": [
      "Venite a scoprire un laboratorio di coltelleria tradizionale ospitato in un edificio con oltre 200 anni di storia. Scoprirete un mestiere del passato e del presente."
    ],
    "fr": [
      "Venez à la découverte d'un atelier de coutellerie traditionnel situé au sein d'un bâtiment chargé de plus de 200 ans d'histoire. Vous y découvrirez un métier d'hier et d'aujourd'hui."
    ],
    "es": [
      "Venga a descubrir un taller de cuchillería tradicional ubicado en un edificio con más de 200 años de historia. Descubrirá una artesanía del pasado y del presente."
    ],
    "nl": [
      "Kom en ontdek een traditioneel bestekatelier in een gebouw met meer dan 200 jaar geschiedenis. Je ontdekt een ambacht uit het verleden en het heden."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Atelier La Bonne Trempe"
    ]
  },
