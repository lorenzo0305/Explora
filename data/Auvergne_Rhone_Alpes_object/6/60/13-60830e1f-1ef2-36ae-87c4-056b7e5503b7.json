  "rdfs:comment": {
    "de": [
      "Theke für Snacks und Drinks im Herzen von La Valbonne. Cédric und sein Team begrüßen Sie im Petit Fournil in einem trendigen Ambiente mit einem großen Bildschirm in der Bar und einem weiteren im Freien, auf dem Sie Sportereignisse verfolgen können."
    ],
    "en": [
      "Snack & drinks bar in the heart of La Valbonne. Cédric and his team welcome you to Le Petit Fournil, in a trendy setting, with a big screen in the bar and another outside to follow sporting events."
    ],
    "it": [
      "Snack e drink bar nel cuore di La Valbonne. Cédric e il suo team vi danno il benvenuto a Le Petit Fournil, in un ambiente alla moda, con un grande schermo nel bar e un altro all'esterno per seguire gli eventi sportivi."
    ],
    "fr": [
      "Comptoir snack & drinks au cœur de La Valbonne. Cédric et son équipe vous accueillent au Petit Fournil, dans un cadre branché, avec un grand écran dans le bar et un autre à l’extérieur pour suivre les événements sportifs."
    ],
    "nl": [
      "Snack- en drankbar in het hart van La Valbonne. Cédric en zijn team heten je welkom in Le Petit Fournil, in een trendy omgeving, met een groot scherm in de bar en nog een buiten om sportevenementen te volgen."
    ],
    "es": [
      "Bar de aperitivos y bebidas en el corazón de La Valbonne. Cédric y su equipo le dan la bienvenida a Le Petit Fournil, en un ambiente de moda, con una gran pantalla en el bar y otra en el exterior para seguir los acontecimientos deportivos."
    ]
  },
