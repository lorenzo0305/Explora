  "rdfs:comment": {
    "de": [
      "Der Après Ski Club ist eine Diskothek im Club-Resort 1800 in Les 2 Alpes. Er bietet ein festliches und modernes Ambiente, ideal, um die Energie der Tage in den Bergen bis zum Ende der Nacht zu verlängern."
    ],
    "en": [
      "L’Après Ski Club is a nightclub located in the Village 1800 area of Les 2 Alpes.\r\nIt offers a festive and modern atmosphere, ideal for extending the energy of your mountain days late into the night."
    ],
    "it": [
      "L’Après Ski Club è una discoteca situata nella zona Village 1800 alle 2 Alpes.\r\nPropone un’atmosfera festosa e moderna, ideale per prolungare l’energia delle vostre giornate in montagna fino a tarda notte."
    ],
    "fr": [
      "L’Après Ski Club est une discothèque installée au Village 1800 aux 2 Alpes. Elle propose une ambiance festive et moderne, idéale pour prolonger l’énergie des journées en montagne jusqu’au bout de la nuit."
    ],
    "es": [
      "El Après Ski Club es una discoteca situada en el Village 1800 de Les 2 Alpes. Ofrece un ambiente festivo y moderno, ideal para prolongar la energía de un día en la montaña hasta el final de la noche."
    ],
    "nl": [
      "De Après Ski Club is een nachtclub in Village 1800 in Les 2 Alpes. Het biedt een feestelijke, moderne sfeer, ideaal om de energie van een dag in de bergen te verlengen tot het einde van de nacht."
    ]
  },
