  "rdfs:comment": {
    "de": [
      "Der See von Roybon ist ein See der 1. Kategorie und verfügt über Einrichtungen zum Angeln (Ponton für Behinderte, gemeinsamer Angelplatz). Es werden regelmäßig Forellen ausgesetzt (Termine bei der AAPPMA erfragen)."
    ],
    "en": [
      "Lac de Roybon is a 1st category lake, with fishing facilities (PRM pontoon, shared fishing area). Trout are released regularly (contact the AAPPMA for dates)."
    ],
    "it": [
      "Il Lac de Roybon è un lago di categoria 1, con strutture per la pesca (pontone per disabili, area di pesca comune). Le trote vengono rilasciate regolarmente (contattare l'AAPPMA per le date)."
    ],
    "fr": [
      "Le lac de Roybon est un lac de 1ere catégorie, il dispose d'aménagements pour la pêche (ponton PMR, aire de pêche partagée). Des lachers de truites sont effectués régulièrement (prendre contact avec l'AAPPMA pour les dates)."
    ],
    "nl": [
      "Lac de Roybon is een meer van categorie 1, met voorzieningen om te vissen (ponton voor rolstoelgebruikers, gemeenschappelijk visgedeelte). Er worden regelmatig forellen uitgezet (neem contact op met de AAPPMA voor data)."
    ],
    "es": [
      "El Lac de Roybon es un lago de categoría 1, con instalaciones para la pesca (pontón para usuarios de sillas de ruedas, zona de pesca compartida). Se sueltan truchas con regularidad (para las fechas, póngase en contacto con la AAPPMA)."
    ]
  },
