  "rdfs:comment": {
    "de": [
      "Die Agenturen Tarriotte Immobilier sind seit über 30 Jahren auf dem Markt der Drôme provençale und der südlichen Ardèche aktiv und begleiten Sie dank eines erfahrenen Teams, das den Markt kennt, professionell bei Ihren Immobilienprojekten."
    ],
    "en": [
      "Tarriotte Immobilier has been active in the Drôme Provençale and Ardèche méridionale markets for over 30 years, providing you with professional support for your real estate projects thanks to an experienced, market-savvy team."
    ],
    "it": [
      "Tarriotte Immobilier opera da oltre 30 anni sui mercati della Drôme provençale e dell'Ardèche méridionale, offrendovi un supporto professionale per i vostri progetti immobiliari grazie a un team esperto che conosce a fondo il mercato."
    ],
    "fr": [
      "Actives sur le marché de la Drôme provençale et l'Ardèche méridionale, depuis plus de 30 ans, les agences Tarriotte Immobilier vous accompagnent avec professionnalisme dans vos projets immobiliers grâce à une équipe expérimentée et connaissant le marché."
    ],
    "es": [
      "Tarriotte Immobilier, presente en los mercados de la Drôme provençale y de la Ardèche méridionale desde hace más de 30 años, le acompaña profesionalmente en sus proyectos inmobiliarios gracias a un equipo experimentado que conoce perfectamente el mercado."
    ],
    "nl": [
      "Tarriotte Immobilier is al meer dan 30 jaar actief op de markten van de Drôme provençale en de Ardèche méridionale en biedt u professionele ondersteuning voor uw vastgoedprojecten dankzij een ervaren team dat de markt door en door kent."
    ]
  },
