  "rdfs:comment": {
    "de": [
      "Gesang, Saxophon und Dub: CULTURE DUB ALL STARS betreten die Bühne des L'Atelier, um den Dancefloor zu entflammen! Um AlexDub herum sind seine drei Komplizen von Culture Dub versammelt: Bethsabée, El Fata und Guru Pope."
    ],
    "en": [
      "Singing, Sax and Dub: CULTURE DUB ALL STARS take to the stage at L'Atelier to set the dancefloor alight! AlexDub is joined by his three Culture Dub accomplices: Bethsabée, El Fata and Guru Pope."
    ],
    "it": [
      "Canto, sax e dub: i CULTURE DUB ALL STARS salgono sul palco de L'Atelier per infiammare il dancefloor! AlexDub sarà affiancato dai suoi tre complici di Culture Dub: Bethsabée, El Fata e Guru Pope."
    ],
    "fr": [
      "Du Chant, du Sax et du Dub : CULTURE DUB ALL STARS déboule sur la scène de L’Atelier pour enflammer la dance ! Autour d’AlexDub sont réunis ses trois complices de Culture Dub : Bethsabée, El Fata et Guru Pope."
    ],
    "nl": [
      "Zingen, Saxen en Dub: CULTURE DUB ALL STARS betreden het podium van L'Atelier om de dansvloer in vuur en vlam te zetten! AlexDub wordt vergezeld door zijn drie Culture Dub handlangers: Bethsabée, El Fata en Guru Pope."
    ],
    "es": [
      "Canto, saxo y dub: CULTURE DUB ALL STARS sube al escenario de L'Atelier para hacer arder la pista de baile AlexDub estará acompañado por sus tres cómplices de Culture Dub: Bethsabée, El Fata y Guru Pope."
    ]
  },
  "rdfs:label": {
