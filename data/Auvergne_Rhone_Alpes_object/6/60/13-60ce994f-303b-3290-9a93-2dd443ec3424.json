  "rdfs:comment": {
    "de": [
      "Das La Bouille ist eine kleine Adresse mit sympathischer Atmosphäre, die Sie in einem Geist der Einfachheit und Geselligkeit empfängt. Schöne Terrasse abseits des Zentrums, savoyische Spezialitäten und Pizzas à la carte."
    ],
    "en": [
      "La Bouille welcomes you in a spirit of simplicity and conviviality. A lovely terrace away from the center, Savoyard specialties and à la carte pizzas."
    ],
    "it": [
      "La Bouille è un piccolo ristorante dall'atmosfera amichevole, che vi accoglie in uno spirito di semplicità e convivialità. Una bella terrazza lontana dal centro, con specialità savoiarde e pizze alla carta."
    ],
    "fr": [
      "Petite adresse à l’ambiance sympathique, La Bouille vous accueille dans un esprit de simplicité et de convivialité. Belle terrasse à l’écart du centre, spécialités savoyardes et pizzas à la carte."
    ],
    "nl": [
      "La Bouille is een klein restaurant met een vriendelijke sfeer, waar u wordt ontvangen in een geest van eenvoud en gezelligheid. Met een mooi terras buiten het centrum, Savoyaardse specialiteiten en à la carte pizza's."
    ],
    "es": [
      "La Bouille es un pequeño restaurante de ambiente acogedor, que le recibe con un espíritu de sencillez y cordialidad. Una encantadora terraza alejada del centro, con especialidades saboyanas y pizzas a la carta."
    ]
  },
