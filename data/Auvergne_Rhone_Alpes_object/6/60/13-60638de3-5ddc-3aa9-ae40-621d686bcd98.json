  "rdfs:comment": {
    "de": [
      "Hoshi wird am 5. Februar 2027 in der LDLC Arena in Lyon-Décines zu Gast sein, um einen außergewöhnlichen Termin seiner Bonjour Docteur Tour zu absolvieren, der ein intensives Erlebnis voller Emotionen und Überraschungen verspricht"
    ],
    "en": [
      "Hoshi will be at the LDLC Arena in Lyon-Décines on February 5, 2027 for an exceptional rendez-vous of its Bonjour Docteur Tour, promising an intense moment, full of emotions and surprises?"
    ],
    "it": [
      "Hoshi sarà all'Arena LDLC di Lione-Décines il 5 febbraio 2027 per un evento eccezionale del suo Bonjour Docteur Tour, che promette un momento intenso, ricco di emozioni e di sorprese?"
    ],
    "fr": [
      "Hoshi sera à la LDLC Arena de Lyon-Décines  le 5 février 2027 pour un rendez-vous exceptionnel de sa tournée Bonjour Docteur Tour, promettant un moment intense, chargé d’émotions et de surprises…"
    ],
    "nl": [
      "Hoshi staat op 5 februari 2027 in de LDLC Arena in Lyon-Décines voor een uitzonderlijk evenement in zijn Bonjour Docteur Tour, met de belofte van een intens, emotioneel geladen moment vol verrassingen?"
    ],
    "es": [
      "Hoshi estará en el LDLC Arena de Lyon-Décines el 5 de febrero de 2027 para un evento excepcional de su gira Bonjour Docteur Tour, que promete un momento intenso, cargado de emoción y lleno de sorpresas?"
    ]
  },
