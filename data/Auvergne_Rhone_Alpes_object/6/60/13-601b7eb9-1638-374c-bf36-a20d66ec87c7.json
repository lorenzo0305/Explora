  "rdfs:comment": {
    "de": [
      "In der zauberhaften Umgebung des Lac du Bouchet können Sie Yoga und Pilates auf dem Paddelboot entdecken.\r\nDie 45-minütigen Sitzungen werden von diplomierten Trainerinnen begleitet.\r\nKurse von 4 bis 10 Personen."
    ],
    "en": [
      "In the enchanting setting of Lac du Bouchet, come and discover Yoga & Pilates on a paddle.\r\n45-minute sessions accompanied by qualified coaches.\r\nClasses for 4 to 10 people."
    ],
    "it": [
      "Nell'incantevole cornice del Lac du Bouchet, venite a scoprire lo yoga e il pilates su una pagaia.\r\nSessioni di 45 minuti accompagnate da allenatori qualificati.\r\nClassi da 4 a 10 persone."
    ],
    "fr": [
      "Dans le cadre enchanteur du Lac du Bouchet, venez découvrir le Yoga & le Pilates en paddle.\r\nScéances de 45 minutes accompagnée par des coachs diplômées.\r\nCours de 4 à 10 personnes."
    ],
    "nl": [
      "Kom in de betoverende omgeving van Lac du Bouchet Yoga & Pilates ontdekken op een peddel.\r\nSessies van 45 minuten onder begeleiding van gekwalificeerde coaches.\r\nLessen voor 4 tot 10 personen."
    ],
    "es": [
      "En el encantador entorno del Lago du Bouchet, venga a descubrir el Yoga y el Pilates a remo.\r\nSesiones de 45 minutos acompañados por entrenadores cualificados.\r\nClases de 4 a 10 personas."
    ]
  },
  "rdfs:label": {
