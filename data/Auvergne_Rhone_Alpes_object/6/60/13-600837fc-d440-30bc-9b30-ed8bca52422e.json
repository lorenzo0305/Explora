  "rdfs:comment": {
    "de": [
      "Das interkommunale Schwimmbad verfügt über zwei Becken: ein 25-Meter-Becken mit fünf Schwimmbahnen und ein kleines Freizeitbecken. Eine Schwimmbahn bleibt den ganzen Tag über reserviert, damit Schwimmer die Anlage unter optimalen Bedingungen nutzen können."
    ],
    "en": [
      "The inter-municipal swimming pool has two pools: a 25-metre pool with five lanes and a small leisure pool. A lane rope remains in place throughout the day so that swimmers can enjoy the facilities in the best possible conditions."
    ],
    "it": [
      "La piscina intercomunale dispone di 2 vasche: una vasca da 25 m con 5 corsie e una piccola piscina per il tempo libero. Una linea d'acqua rimane in funzione per tutto il giorno, in modo che i nuotatori possano godere delle strutture nelle migliori condizioni possibili."
    ],
    "fr": [
      "La Piscine intercommunale est composée de 2 bassins : un de 25m avec 5 couloirs de nage et un petit bassin ludique. Une ligne d’eau reste en place toute la journée afin de permettre aux nageurs de profiter des installations dans les meilleures conditions."
    ],
    "es": [
      "La piscina intercomunal cuenta con 2 piscinas: una de 25 m con 5 calles de natación y una pequeña piscina de recreo. Una línea de flotación permanece durante todo el día para que los bañistas puedan disfrutar de las instalaciones en las mejores condiciones."
    ],
    "nl": [
      "Het intercommunale zwembad bestaat uit twee bassins: een bassin van 25 meter met vijf zwembanen en een klein recreatiebassin. Er blijft de hele dag een zwembaan vrij zodat zwemmers onder de beste omstandigheden van de faciliteiten kunnen genieten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Piscine intercommunale de Crest"
    ]
  },
