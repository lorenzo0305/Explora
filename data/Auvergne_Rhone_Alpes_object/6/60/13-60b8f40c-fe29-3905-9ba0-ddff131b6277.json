  "rdfs:comment": {
    "de": [
      "Dieser Strand bietet einen schönen Bade- und Spielplatz für Familien: eine herrliche Liegewiese, Boule- und Beachvolleyballfeld, Tischtennisplatten, Kinderspielgeräte. Snack-Restaurant vor Ort."
    ],
    "en": [
      "This beach offers a lovely swimming and play area for families, with a magnificent lawn, pétanque and beach volleyball courts, ping pong tables and children's games. Snack restaurant on site."
    ],
    "it": [
      "Questa spiaggia offre una bella area balneare e di gioco per le famiglie, con un magnifico prato, un campo da bocce, un campo da beach volley, tavoli da ping pong e giochi per bambini. Ristorante per spuntini in loco."
    ],
    "fr": [
      "Cette plage offre un joli espace de baignade et de jeux pour les familles : une magnifique pelouse, terrain de pétanque, de beach volley, tables de ping pong, jeux pour enfants. Restaurant snacking sur place."
    ],
    "es": [
      "Esta playa ofrece una encantadora zona de baño y juegos para familias, con un magnífico césped, campo de petanca, pista de voley playa, mesas de ping-pong y juegos infantiles. Snack restaurante in situ."
    ],
    "nl": [
      "Dit strand biedt een heerlijk zwem- en speelgebied voor gezinnen, met een prachtig grasveld, jeu de boulesbaan, beachvolleybalveld, tafeltennistafels en kinderspelletjes. Snackrestaurant ter plaatse."
    ]
  },
