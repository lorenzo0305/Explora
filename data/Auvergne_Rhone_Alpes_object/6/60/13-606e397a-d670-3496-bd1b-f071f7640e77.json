  "rdfs:comment": {
    "de": [
      "Der Laden bietet eine große Auswahl an Brillen, Sehtests, die Anpassung von Kontaktlinsen, Reparaturen und Hausbesuche. Ein Hörgeräteakustiker ist donnerstags im Geschäft anwesend."
    ],
    "en": [
      "The store offers a wide selection of glasses, eye exams, contact lens fittings, repairs and home appointments. A hearing aid specialist is present in the store on Thursdays."
    ],
    "it": [
      "Il negozio offre un'ampia scelta di occhiali, test oculistici, applicazione di lenti a contatto, riparazioni e appuntamenti a domicilio. Il giovedì è presente uno specialista in apparecchi acustici."
    ],
    "fr": [
      "Le magasin propose un large choix de lunettes, des examens de la vue, l'adaptation des lentilles de contact, des réparations et des rendez-vous à domicile. Un audioprothésiste est présent le jeudi à la boutique."
    ],
    "es": [
      "La tienda ofrece una amplia selección de gafas, pruebas oftalmológicas, adaptación de lentes de contacto, reparaciones y consultas a domicilio. Los jueves acude a la tienda un especialista en audífonos."
    ],
    "nl": [
      "De winkel biedt een ruime keuze aan brillen, oogtests, contactlensaanpassingen, reparaties en afspraken aan huis. Op donderdag is er een audicien aanwezig in de winkel."
    ]
  },
  "rdfs:label": {
    "fr": [
      "A vue d'oeil"
    ]
  },
