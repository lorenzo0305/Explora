  "rdfs:comment": {
    "de": [
      "Verkostung von rotem Beaujolais-village de garde, weißem Beaujolais-Village, prickelndem Wein und Traubensaft. Besichtigung des Weinguts, der Gebäude, des Parks und der Weinkeller. Empfang von Gruppen. Eine Familiengeschichte seit 1750. Ganzjährig nach Vereinbarung geöffnet."
    ],
    "en": [
      "Beaujolais-village red wine to lay down, Beaujolais village white wine, sparkling wine, grape juice. Visit of the winery, the buildings, the park and the cellars. Group reception- From father to son since 1750; Open all year round by appointment only."
    ],
    "it": [
      "Degustazione di vino rosso Beaujolais-Village, vino bianco Beaujolais-Village, spumante e succo d'uva. Visita della cantina, degli edifici, dei terreni e delle cantine. Gruppi benvenuti. Una storia di famiglia dal 1750. Aperta tutto l'anno su appuntamento."
    ],
    "fr": [
      "Dégustation de Beaujolais-village rouge de garde, Beaujolais-Village blanc, pétillant, jus de raisin. Visite du cuvage, des bâtiments, du parc et des caves. Accueil de groupe. Une histoire de famille depuis 1750. Ouvert toute l'année sur Rendez-vous."
    ],
    "nl": [
      "Proeverij van rode Beaujolais-dorpswijn, witte Beaujolais-dorpswijn, mousserende wijn en druivensap. Bezoek aan de wijnmakerij, de gebouwen, het terrein en de kelders. Groepen zijn welkom. Een familiegeschiedenis sinds 1750. Het hele jaar geopend op afspraak."
    ],
    "es": [
      "Degustación de vino tinto Beaujolais-Village, vino blanco Beaujolais-Village, vino espumoso y zumo de uva. Visita de la bodega, edificios, terrenos y bodegas. Se admiten grupos. Una historia familiar desde 1750. Abierto todo el año con cita previa."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Château de Lacarelle"
    ]
  },
