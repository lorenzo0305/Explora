  "rdfs:comment": {
    "de": [
      "Im Salle Maurice Calloc'h finden zahlreiche Aufführungen und Konzerte statt. Er ist auch ein Ort, an dem Kolloquien, Versammlungen usw. stattfinden können."
    ],
    "en": [
      "The Maurice Calloc'h hall hosts many shows and concerts. It is also a place where colloquiums, meetings, etc... can be held."
    ],
    "it": [
      "La Maurice Calloc'h Hall ospita numerosi spettacoli e concerti. È anche un luogo in cui si possono svolgere colloqui, riunioni, ecc."
    ],
    "fr": [
      "La salle Maurice Calloc'h accueille de nombreux spectacles et concerts. Il s'agit également d'un lieu où peuvent se dérouler des colloques, des réunions etc..."
    ],
    "es": [
      "La sala Maurice Calloc'h acoge numerosos espectáculos y conciertos. También es un lugar donde pueden celebrarse coloquios, reuniones, etc."
    ],
    "nl": [
      "In de Maurice Calloc'h Hall worden veel voorstellingen en concerten gehouden. Het is ook een plaats waar colloquia, vergaderingen, enz. kunnen plaatsvinden."
