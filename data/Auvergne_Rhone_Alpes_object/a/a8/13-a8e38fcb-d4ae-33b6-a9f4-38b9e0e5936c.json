  "rdfs:comment": {
    "de": [
      "Die Verpflegung im Wam Park in Lyon/Condrieu wird Ihnen während der Saison den ganzen Tag über angeboten. Der Restaurantbereich schließt sich an die Wassersportaktivitäten an, um Ihnen ein komplettes Angebot auf unserer Basis zu bieten."
    ],
    "en": [
      "Catering at Wam Park in Lyon/Condrieu is available all day long during the season. The catering section joins the water sports activities to offer you a complete package at our base."
    ],
    "it": [
      "La ristorazione al Wam Park di Lione/Condrieu è disponibile tutto il giorno durante la stagione. La sezione ristorazione si unisce alle attività sportive in acqua per offrirvi un pacchetto completo presso la nostra base."
    ],
    "fr": [
      "La restauration au Wam Park de Lyon/Condrieu vous est proposée toute la journée durant la saison. La partie restauration se joint aux activités nautiques afin de vous proposer une offre complète sur notre base."
    ],
    "es": [
      "La restauración en el Wam Park de Lyon/Condrieu está disponible todo el día durante la temporada. La sección de restauración se une a las actividades náuticas para ofrecerle un paquete completo en nuestra base."
    ],
    "nl": [
      "Catering op Wam Park in Lyon/Condrieu is de hele dag beschikbaar tijdens het seizoen. Het cateringgedeelte sluit aan bij de watersportactiviteiten om je een compleet pakket aan te bieden op onze basis."
    ]
  },
