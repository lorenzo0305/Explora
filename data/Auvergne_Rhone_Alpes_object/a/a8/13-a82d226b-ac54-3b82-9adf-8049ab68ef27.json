  "rdfs:comment": {
    "de": [
      "Entdecken Sie ein altes Straßenviadukt (1866) von 100 m Länge mit 10 Bögen mit 8 m Öffnung und 18 m Höhe und ein Eisenbahnviadukt (1902) von gleicher Länge, das ebenfalls 10 Bögen mit 8 m Öffnung besitzt, aber weniger hoch ist und an der Unterseite angebaut ist."
    ],
    "en": [
      "Discover an old road viaduct (1866) 100 m long with 10 arches of 8 m opening 18 m high and a railway viaduct (1902) of the same length, also with 10 arches of 8 m opening, less high, leaning against the bottom."
    ],
    "it": [
      "Scoprite un vecchio viadotto stradale (1866) lungo 100 m con 10 arcate di 8 m di apertura, alto 18 m e un viadotto ferroviario (1902) della stessa lunghezza, anch'esso con 10 arcate di 8 m di apertura, più basso, adiacente in basso."
    ],
    "fr": [
      "Découvrez un ancien viaduc routier (1866) de 100 m de long avec 10 arches de 8 mètres d’ouverture hautes de 18 m et un viaduc ferroviaire (1902) de même longueur, possédant également 10 arches de 8 m d’ouverture, moins élevées, accolé en contre bas."
    ],
    "nl": [
      "Ontdek een oud wegviaduct (1866) van 100 m lang met 10 bogen van 8 m opening, 18 m hoog en een spoorwegviaduct (1902) van dezelfde lengte, eveneens met 10 bogen van 8 m opening, lager, aangrenzend hieronder."
    ],
    "es": [
      "Descubre un antiguo viaducto de carretera (1866) de 100 m de longitud con 10 arcos de 8 m de abertura, de 18 m de altura y un viaducto ferroviario (1902) de la misma longitud, también con 10 arcos de 8 m de abertura, más bajo, contiguo abajo."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Viaducs de la Chapelette et Pont de l’Enceinte"
    ]
  },
