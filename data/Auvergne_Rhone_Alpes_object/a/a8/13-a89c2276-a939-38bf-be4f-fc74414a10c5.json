  "rdfs:comment": {
    "de": [
      "Die jungen Sängerinnen der Teenager-Workshops freuen sich, Ihnen ihr Konzert vorzustellen, das von französischen Chansons bis hin zu angelsächsischem Pop reicht."
    ],
    "en": [
      "The young singers from the teen workshops are pleased to present their concert, ranging from French chanson to Anglo-Saxon pop."
    ],
    "it": [
      "I giovani cantanti dei laboratori per adolescenti sono lieti di presentare il loro concerto, che spazia dalla chanson francese al pop anglosassone."
    ],
    "fr": [
      "Les jeunes chanteuses des ateliers ados ont le plaisir de vous proposer leur concert, allant de la chanson française à la pop anglo-saxonne."
    ],
    "es": [
      "Los jóvenes cantantes de los talleres para adolescentes están encantados de presentar su concierto, que abarca desde la chanson francesa hasta el pop anglosajón."
    ],
    "nl": [
      "De jonge zangers van de tienerworkshops presenteren met veel plezier hun concert, variërend van Frans chanson tot Angelsaksische pop."
    ]
  },
  "rdfs:label": {
    "fr": [
