  "rdfs:comment": {
    "de": [
      "Schafs-und Ziegenzucht, Milch mit späterer Käsezubereitung. Nussverarbeitung zur Nusscreme oder zur natürlichen Creme."
    ],
    "en": [
      "Goat's and sheep's milk cheese, local products"
    ],
    "it": [
      "Allevatore di pecore e capre da latte, con un'ampia varietà di formaggi prodotti con questi due tipi di latte lavorati in azienda.\r\nProduttore biologico di castagne, bacche e mele, trasformate in succo, marmellata, sciroppo, ecc."
    ],
    "fr": [
      "Eleveur de brebis laitières et  de chèvres, avec transformation à la ferme d’une grande variété de fromages avec ces 2 laits.\r\nProducteur en agriculture biologique de châtaignes, petits fruits, pommes, transformés en jus, confiture, sirop..."
    ],
    "nl": [
      "Geiten- en schapenhouderij. Melk en verwerking tot kaas. Verwerking van kastanjes tot crème en naturel."
    ],
    "es": [
      "Criador de ovejas y cabras lecheras, con una amplia variedad de quesos elaborados a partir de estos 2 tipos de leche procesada en la explotación.\r\nProductor ecológico de castañas, bayas y manzanas, transformadas en zumo, mermelada, sirope, etc."
    ]
  },
