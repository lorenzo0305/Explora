  "rdfs:comment": {
    "de": [
      "Papilles & Camomille baut ihre Pflanzen und Kräuter selbst an und verarbeitet sie, um Ihnen köstliche Kräutertees anzubieten, die für alle Bedürfnisse und sogar für Kinder geeignet sind!\nDieses Produkt ist in der Boutique des Fremdenverkehrsamtes erhältlich."
    ],
    "en": [
      "Papilles & Camomille grows its own plants and herbs and transforms them into succulent herbal teas to suit every need, even children!\nOn sale at the Tourist Office store."
    ],
    "it": [
      "Papilles & Camomille coltiva le proprie piante ed erbe e le trasforma in deliziose tisane adatte ad ogni esigenza, anche dei bambini!\nIn vendita nel negozio dell'Ufficio del Turismo."
    ],
    "fr": [
      "Papilles & Camomille cultive elle-même ses plantes et aromates et les transforme pour vous offrir de succulentes tisanes adaptées à tous les besoins et même pour les enfants !\nProduit en vente à la boutique de l'Office de tourisme."
    ],
    "nl": [
      "Papilles & Camomille kweekt zijn eigen planten en kruiden en verwerkt ze tot heerlijke kruidenthee voor elke behoefte, zelfs voor kinderen!\nTe koop in de winkel van het toeristenbureau."
    ],
    "es": [
      "Papilles & Camomille cultiva sus propias plantas y hierbas y las transforma en deliciosas tisanas para satisfacer todas las necesidades, ¡incluso las de los niños!\nA la venta en la tienda de la Oficina de Turismo."
    ]
  },
  "rdfs:label": {
