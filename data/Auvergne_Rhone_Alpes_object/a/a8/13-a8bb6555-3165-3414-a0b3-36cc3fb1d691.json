  "rdfs:comment": {
    "de": [
      "Eine von einem leidenschaftlichen Chefkoch entwickelte Küche, die nur frische Produkte verarbeitet, je nach Jahreszeit in einem angenehmen Rahmen."
    ],
    "en": [
      "A cuisine elaborated by a passionate chef, working with fresh products only, throughout the seasons in a pleasant setting."
    ],
    "it": [
      "Una cucina preparata da uno chef appassionato, che lavora solo con prodotti freschi, secondo le stagioni, in un ambiente piacevole."
    ],
    "fr": [
      "Une cuisine élaborée par un chef passionné, travaillant des produits frais uniquement, au fil des saisons dans un cadre agréable."
    ],
    "es": [
      "Una cocina preparada por un chef apasionado, que trabaja únicamente con productos frescos, según las estaciones, en un entorno agradable."
    ],
    "nl": [
      "Een keuken bereid door een gepassioneerde chef, uitsluitend werkend met verse producten, volgens de seizoenen in een aangenaam kader."
    ]
