  "rdfs:comment": {
    "de": [
      "Au fil de l'Eau lädt Sie zu einem einzigartigen Wellness- und Entspannungserlebnis im Herzen des Trièves, in Chichilianne, am Fuße des Mont Aiguille, ein. Wellness-Massage, AquaYoga und Hatha Yoga."
    ],
    "en": [
      "Au fil de l'Eau invites you to enjoy a unique experience of well-being and relaxation in the heart of the Trièves, in Chichilianne, at the foot of Mont Aiguille. Wellness massage, AquaYoga and Hatha Yoga."
    ],
    "it": [
      "Au fil de l'Eau vi invita a vivere un'esperienza unica di benessere e relax nel cuore del Trièves, a Chichilianne, ai piedi del Mont Aiguille. Massaggio benessere, AquaYoga e Hatha Yoga."
    ],
    "fr": [
      "Au fil de l’Eau vous invite à vivre une expérience unique de bien-être et de relaxation au cœur du Trièves, à Chichilianne, au pied du Mont Aiguille. Massage bien-être, AquaYoga et Hatha Yoga."
    ],
    "nl": [
      "Au fil de l'Eau nodigt je uit om te genieten van een unieke ervaring van welzijn en ontspanning in het hart van de Trièves, in Chichilianne, aan de voet van de Mont Aiguille. Wellnessmassage, AquaYoga en Hatha Yoga."
    ],
    "es": [
      "Au fil de l'Eau le invita a disfrutar de una experiencia única de bienestar y relajación en el corazón de las Trièves, en Chichilianne, a los pies del Mont Aiguille. Masaje de bienestar, AquaYoga y Hatha Yoga."
    ]
  },
  "rdfs:label": {
