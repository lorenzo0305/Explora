  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/50e8a63a-891f-363b-81db-879d429d30e9",
      "dc:description": {
        "de": [
          "Kommen Sie und amüsieren Sie sich mit den aufblasbaren Strukturen, die auf der Esplanade de Sainte Cécile aufgebaut sind ? Für Kinder von 4 bis 12 Jahren - von 14 bis 18 Uhr ? Anmeldung im Office de Tourisme erforderlich - 30 Minuten lang kostenlos"
        ],
        "en": [
          "Come and have fun with the inflatables set up on the Esplanade de Sainte Cécile ? For children aged 4 to 12 - 2pm to 6pm ? Registration essential at the Tourist Office - Free 30-minute slot"
        ],
        "it": [
          "Venite a divertirvi con i gonfiabili allestiti sull'Esplanade de Sainte Cécile? Per i bambini dai 4 ai 12 anni - dalle 14.00 alle 18.00 ? Iscrizione obbligatoria presso l'Ufficio del Turismo - Tempo libero di 30 minuti"
        ],
        "fr": [
          "Venez -vous amuser avec les structures gonflables installées sur l’Esplanade de Sainte Cécile – Pour les enfants de 4 à 12 ans -  de 14h à 18h – Inscription indispensable à l’Office de Tourisme - Créneau gratuit de 30 minutes"
        ],
        "es": [
          "Ven a divertirte con los hinchables instalados en la explanada de Sainte Cécile ? Para niños de 4 a 12 años - De 14:00 a 18:00 ? Inscripción obligatoria en la Oficina de Turismo - 30 minutos gratuitos"
        ],
        "nl": [
          "Kom en vermaak je met de springkussens op de Esplanade de Sainte Cécile ? Voor kinderen van 4 tot 12 jaar - 14.00 tot 18.00 uur ? Inschrijven noodzakelijk bij het Office du Tourisme - 30 minuten gratis"
        ]
      },
