  "rdfs:comment": {
    "de": [
      "Genießen Sie bei Tiffine eine gemütliche und leckere Auszeit in unserem Teesalon und der Tapas-Bar.\r\nWir bieten Ihnen von 10 bis 22 Uhr einen durchgehenden Service für alle Ihre Wünsche, ob Brunch, Nachmittagssnack oder Tapas."
    ],
    "en": [
      "At Tiffine, enjoy a cosy, gourmet interlude in our tea room and tapas bar.\r\nWe offer continuous service from 10am to 10pm for all your brunch, snack or tapas needs."
    ],
    "it": [
      "Al Tiffine, godetevi un'accogliente parentesi gastronomica nella nostra sala da tè e tapas bar.\r\nOffriamo un servizio continuo dalle 10.00 alle 22.00 per tutte le vostre esigenze di brunch, snack o tapas."
    ],
    "fr": [
      "Chez Tiffine, profitez d'une parenthèse cosy et gourmande dans notre salon de thé et bar à tapas. \r\nNous assurons un service continu de 10h à 22h pour toutes vos envies, de brunch, goûter ou tapas."
    ],
    "nl": [
      "Geniet bij Tiffine van een gezellig, gastronomisch intermezzo in onze theesalon en tapasbar.\r\nWe bieden een doorlopende service van 10.00 tot 22.00 uur voor al je brunch-, snack- of tapasbehoeften."
    ],
    "es": [
      "En Tiffine, disfrute de un interludio acogedor y gourmet en nuestro salón de té y bar de tapas.\r\nOfrecemos servicio continuo de 10:00 a 22:00 para todas sus necesidades de brunch, aperitivos o tapas."
    ]
  },
