  "rdfs:comment": {
    "de": [
      "Das Hotel Le Mont Jorat empfängt Sie im Zentrum des Dorfes Abondance, in der Haute-Savoie.22 Zimmer und ein Bar-Restaurant, es empfängt Gruppen, Familien... Mahlzeiten für Taufen, Geburtstage, Kommunionen..."
    ],
    "en": [
      "Near the Portes du Soleil and Lake Geneva, the hotel restaurant the Mont Jorat in the town center of Abondance. We welcome groups, families, hikers, bikers, skiers in winter. We organize your events: baptism, birthday, communion, meals classes ..."
    ],
    "it": [
      "L'hotel Le Mont Jorat vi accoglie nel centro del villaggio di Abondance, in Alta Savoia, con 22 camere e un bar-ristorante, per gruppi, famiglie... Battesimi, compleanni, comunioni..."
    ],
    "fr": [
      "L'hôtel Le Mont Jorat vous accueille dans le centre du village d'Abondance, en Haute-Savoie.Composé de 22 chambres, et d'un bar-restaurant, il accueille des groupes, familles... Repas de baptêmes, anniversaires, communions..."
    ],
    "nl": [
      "Hotel Le Mont Jorat verwelkomt u in het centrum van het dorp Abondance, in de Haute-Savoie, met 22 kamers en een bar-restaurant, voor groepen, families... Doopfeesten, verjaardagen, communies..."
    ],
    "es": [
      "El hotel Le Mont Jorat le acoge en el centro del pueblo de Abondance, en Alta Saboya, con 22 habitaciones y un bar-restaurante, para grupos, familias... Bautizos, cumpleaños, comuniones..."
    ]
  },
