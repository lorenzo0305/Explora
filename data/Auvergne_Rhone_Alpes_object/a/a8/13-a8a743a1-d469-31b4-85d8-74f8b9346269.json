  "rdfs:comment": {
    "de": [
      "Hallo trotzdem\r\n\r\nHaroun ist der Autor all seiner Texte und liebt es, Neues vorzuschlagen und sein Publikum zu überraschen."
    ],
    "en": [
      "Hello anyway\r\n\r\nAs the author of all his own lyrics, Haroun likes to come up with something new and surprise his audience."
    ],
    "it": [
      "Ciao comunque\r\n\r\nEssendo l'autore di tutti i suoi testi, Haroun ama proporre materiale nuovo e sorprendere il suo pubblico."
    ],
    "fr": [
      "Bonjour quand même\r\n\r\nAuteur de tous ses textes, Haroun aime proposer de la nouveauté et surprendre son public."
    ],
    "es": [
      "Hola de todos modos\r\n\r\nComo autor de todas sus letras, a Haroun le gusta inventar material nuevo y sorprender a su público."
    ],
    "nl": [
      "Hallo toch\r\n\r\nAls auteur van al zijn eigen teksten, houdt Haroun ervan om met nieuw materiaal te komen en zijn publiek te verrassen."
    ]
  },
