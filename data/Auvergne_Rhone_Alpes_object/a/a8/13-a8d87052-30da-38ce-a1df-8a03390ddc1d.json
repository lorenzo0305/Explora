  "rdfs:comment": {
    "de": [
      "Entdecken Sie eine handwerkliche Pizzeria, in der jede Pizza mit frischen und hochwertigen Zutaten in einer freundlichen und herzlichen Atmosphäre zubereitet wird. Vor Ort oder zum Mitnehmen."
    ],
    "en": [
      "Discover an artisanal pizzeria where every pizza is prepared with fresh, quality ingredients, in a warm, friendly atmosphere. On site or to take away."
    ],
    "it": [
      "Scoprite una pizzeria tradizionale dove ogni pizza è preparata con ingredienti freschi e di qualità in un'atmosfera calda e accogliente. Sul posto o da asporto."
    ],
    "fr": [
      "Découvrez une pizzeria artisanale où chaque pizza est préparée avec des ingrédients frais et de qualité, dans une ambiance conviviale et chaleureuse. Sur place ou à emporter."
    ],
    "nl": [
      "Ontdek een traditionele pizzeria waar elke pizza wordt gemaakt met verse kwaliteitsingrediënten in een warme, vriendelijke sfeer. Ter plekke of om mee te nemen."
    ],
    "es": [
      "Descubra una pizzería tradicional donde cada pizza se elabora con ingredientes frescos y de calidad en un ambiente cálido y acogedor. Al momento o para llevar."
    ]
  },
  "rdfs:label": {
