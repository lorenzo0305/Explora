  "rdfs:comment": {
    "de": [
      "La Table (Der Tisch) bietet Ihnen eine der Jahreszeit entsprechende Küche : von\r\nOktober bis März Meeresfrüchteplatten zum Mitnehmen"
    ],
    "en": [
      "La Table provides you with a seasonal cuisine.\r\nFrom October to March, platter of seafood to take away."
    ],
    "it": [
      "La Table offre una cucina stagionale a base di prodotti freschi.\r\nDa ottobre a marzo, piatto di pesce e ostriche sul posto e da asporto."
    ],
    "fr": [
      "La Table vous propose une cuisine de saison à base de produits frais.\r\nD'octobre à mars, plateau de fruits de mer et huîtres sur place et à emporter."
    ],
    "es": [
      "La Table ofrece una cocina de temporada basada en productos frescos.\r\nDe octubre a marzo, bandeja de marisco y ostras en el momento y para llevar."
    ],
    "nl": [
      "La Table biedt een seizoensgebonden keuken op basis van verse producten.\r\nVan oktober tot maart, zeevruchtenschotel en oesters ter plaatse en om mee te nemen."
    ]
  },
