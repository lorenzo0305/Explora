  "rdfs:comment": {
    "de": [
      "Angelfreunde können in den Flüssen, Teichen und öffentlichen Wasserläufen des Pays Voironnais auf Fischfang gehen. Der Verkauf der Karten erfolgt auf der Website www.cartedepeche.fr, aber auch in den Empfangsbüros von Charavines und Voiron."
    ],
    "en": [
      "Come and fish in the rivers, ponds and public streams of the Pays Voironnais. Cards can be purchased at www.cartedepeche.fr and at the Charavines and Voiron reception desks."
    ],
    "it": [
      "Venite a pescare nei fiumi, negli stagni e nei torrenti pubblici del Pays Voironnais. Le tessere possono essere acquistate sul sito www.cartedepeche.fr e presso le reception di Charavines e Voiron."
    ],
    "fr": [
      "Amateurs de pêche, venez taquiner le poisson dans les rivières, étangs et cours d'eau publics du Pays Voironnais. Les ventes des cartes s'effectuent sur le site www.cartedepeche.fr mais aussi dans les bureaux d'accueil de Charavines et de Voiron."
    ],
    "es": [
      "Venga a pescar en los ríos, estanques y arroyos públicos del Pays Voironnais. Las tarjetas se pueden comprar en www.cartedepeche.fr y también en los mostradores de recepción de Charavines y Voiron."
    ],
    "nl": [
      "Kom vissen in de rivieren, vijvers en openbare beken van het Pays Voironnais. Kaarten kunnen worden gekocht op www.cartedepeche.fr en ook bij de receptie in Charavines en Voiron."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Pêche dans les étangs et rivières publics du Pays Voironnais"
    ]
  },
