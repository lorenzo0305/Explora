  "rdfs:comment": {
    "de": [
      "Am Fuße des Fiz-Massivs und mit Blick auf den Mont-Blanc ist die Internationale Messe für Bergbücher ein herausragendes Ereignis des Sommers, ein Höhepunkt der Begegnungen und des Austauschs, der Entdeckungen, des Nervenkitzels oder der geteilten Freude."
    ],
    "en": [
      "At the foot of the Fiz massif and facing Mont Blanc, the International Mountain Book Fair is a key event of the summer, a time for meetings and exchanges, discoveries, thrills and shared joy."
    ],
    "it": [
      "Ai piedi del massiccio del Fiz e di fronte al Monte Bianco, il Salone internazionale del libro di montagna è un evento chiave dell'estate, un momento di incontro e di scambio, di scoperta, di emozione e di gioia condivisa."
    ],
    "fr": [
      "Au pied du massif des Fiz et face au Mont-Blanc, le Salon International du Livre de montagne est un événement phare de l'été, temps fort de rencontres et d’échanges, de découvertes, de frissons ou de joie partagée."
    ],
    "es": [
      "Al pie del macizo del Fiz y frente al Mont Blanc, el Salón Internacional del Libro de Montaña es un acontecimiento clave del verano, un momento de encuentros e intercambios, de descubrimientos, de emociones y de alegría compartida."
    ],
    "nl": [
      "Aan de voet van het Fiz-massief en tegenover de Mont Blanc is de Internationale Beurs voor Bergboeken een belangrijk evenement van de zomer, een tijd voor ontmoetingen en uitwisselingen, ontdekkingen, sensatie en gedeelde vreugde."
    ]
  },
  "rdfs:label": {
