  "rdfs:comment": {
    "de": [
      "Das Besset-Tor war das südliche Tor der befestigten Stadt Pradelles. Es bot neben anderen Routen Zugang zum Chemin de Régordane, der Le Puy-en-Velay mit Saint-Gilles verband."
    ],
    "en": [
      "The Besset gateway was the southern gateway to the fortified town of Pradelles, and provided access to, among other routes, the Chemin de Régordane linking Le Puy-en-Velay to Saint-Gilles."
    ],
    "it": [
      "La porta di Besset era la porta meridionale della città fortificata di Pradelles ed era una delle vie che conducevano allo Chemin de Régordane, che collegava Le Puy-en-Velay a Saint-Gilles."
    ],
    "fr": [
      "Le portail du Besset était la porte sud de la ville forte de Pradelles, il donnait accès, entre autres itinéraires, au Chemin de Régordane qui reliait Le Puy-en-Velay à Saint-Gilles."
    ],
    "es": [
      "La puerta de Besset era la puerta sur de la ciudad fortificada de Pradelles, y era una de las rutas que conducían al Chemin de Régordane, que unía Le Puy-en-Velay con Saint-Gilles."
    ],
    "nl": [
      "De poort van Besset was de zuidelijke toegangspoort tot de versterkte stad Pradelles en was een van de routes naar de Route du Régordane, die Le Puy-en-Velay met Saint-Gilles verbond."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Portail du Besset | Pradelles"
    ]
  },
