  "rdfs:comment": {
    "de": [
      "Jedes Jahr bietet das Festival Valloire baroque eine Woche lang mehr als 15 Barockveranstaltungen (Konzerte, Vorträge, musikalische Spaziergänge), bei denen die größten internationalen Künstler der Barockmusik auftreten."
    ],
    "en": [
      "Every year, the Valloire Baroque Festival offers a week of Baroque events (concerts, lectures, musical walks) featuring the world's leading Baroque artists."
    ],
    "it": [
      "Ogni anno, il Festival Barocco di Valloire offre oltre una settimana di eventi barocchi (concerti, conferenze, passeggiate musicali) con i più grandi artisti barocchi internazionali."
    ],
    "fr": [
      "Chaque année, le Festival Valloire baroque, propose pendant une semaine, plus d'une quinzaine d'évènements baroques (concerts, conférences, promenade musicale) qui rassemblent les plus grands artistes internationaux de la musique baroque."
    ],
    "nl": [
      "Elk jaar biedt het Valloire Baroque Festival meer dan een week aan barokke evenementen (concerten, lezingen, muzikale wandelingen) met de grootste internationale barokartiesten."
    ],
    "es": [
      "Cada año, el Festival Barroco de Valloire ofrece más de una semana de eventos barrocos (conciertos, conferencias, paseos musicales) en los que participan los más grandes artistas barrocos internacionales."
    ]
  },
