  "rdfs:comment": {
    "de": [
      "Ich bin ein Bio-Obstbauer (Äpfel, Pflaumen, Kirschen, Mandeln, Walnüsse und Haselnüsse) und ich entwickle einen Bio-Gemüsegarten (Tomaten, Kartoffeln, Knoblauch, Zwiebeln, Kürbisse ...) Ich praktiziere den Verkauf vor Ort."
    ],
    "en": [
      "I am an organic arboriculturist (apples, plums, cherries, almonds, walnuts and hazelnuts) and I am developing an organic market garden (tomatoes, potatoes, garlic, onions, squash...) I sell on site."
    ],
    "it": [
      "Sono un arboricoltore biologico (mele, prugne, ciliegie, mandorle, noci e nocciole) e sto sviluppando un orto biologico (pomodori, patate, aglio, cipolle, zucche, ecc.)."
    ],
    "fr": [
      "Je suis arboriculteur bio (pommes, prunes,cerises,amandes noix et noisettes et je développe un maraichage bio (tomates, pomme de terre, ail,oignon, courges...) je pratique la vente sur place."
    ],
    "es": [
      "Soy arboricultor ecológico (manzanas, ciruelas, cerezas, almendras, nueces y avellanas) y estoy desarrollando una huerta ecológica (tomates, patatas, ajos, cebollas, calabazas, etc.)."
    ],
    "nl": [
      "Ik ben een biologische boomkweker (appels, pruimen, kersen, amandelen, walnoten en hazelnoten) en ik ontwikkel een biologische tuinderij (tomaten, aardappelen, knoflook, uien, pompoenen, enz.)."
    ]
  },
