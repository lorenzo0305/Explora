  "rdfs:comment": {
    "de": [
      "Le Bon Roy bietet Ihnen unter der Woche jeden Mittag ohne Reservierung sein Tagesgericht und am Wochenende und abends auf Reservierung seine Speisekarte an. Spezielle Mahlzeiten auf Bestellung sind möglich. Die Bar ist jeden Abend geöffnet."
    ],
    "en": [
      "Le Bon Roy offers a daily special during the week when booking is not required, and a full menu in the evening and at the week end when booking is needed. Specific meals are available on order and the bar is open every evening;  a three course meal including wine and coffee costs €13.50."
    ],
    "it": [
      "Le Bon Roy vi offre i suoi piatti del giorno a pranzo nei giorni feriali senza prenotazione e il suo menu nei fine settimana e la sera su prenotazione. È possibile ordinare pasti speciali. Il bar è aperto tutte le sere."
    ],
    "fr": [
      "Le Bon Roy vous propose son plat du jour tous les midis en semaine sans réservation et sa carte le week-end et le soir sur réservation. Repas spéciaux sur commande possibles. Le bar est ouvert tous les soirs."
    ],
    "es": [
      "Le Bon Roy le ofrece sus platos del día todos los mediodías entre semana sin reserva y su menú los fines de semana y por la noche con reserva previa. Se pueden encargar comidas especiales. El bar está abierto todas las noches."
    ],
    "nl": [
      "Le Bon Roy biedt u zijn dagschotels tijdens de lunch op weekdagen zonder reservering en zijn menu in het weekend en 's avonds op reservering. Speciale maaltijden kunnen worden besteld. De bar is elke avond open."
    ]
  },
