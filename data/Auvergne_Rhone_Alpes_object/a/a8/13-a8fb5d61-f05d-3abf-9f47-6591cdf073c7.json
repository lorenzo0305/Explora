  "rdfs:comment": {
    "de": [
      "Wir empfangen Sie an einem warmen Ort, in einer familiären Atmosphäre und mit einer einfachen Küche. Kleine Besonderheit: Vom Speisesaal aus können Sie Tiere sehen! Die Kinder können sie streicheln und füttern gehen..."
    ],
    "en": [
      "We welcome you in a warm place, in a family atmosphere, with a simple kitchen. Small peculiarity: you will be able to see animals from the dining room! the children will be able to pet them and feed them..."
    ],
    "it": [
      "Vi accogliamo in un luogo caldo, in un'atmosfera familiare, con una cucina semplice. Una particolarità: dalla sala da pranzo si possono vedere gli animali, i bambini possono accarezzarli e dar loro da mangiare..."
    ],
    "fr": [
      "Nous vous accueillons dans un lieu chaleureux, dans une ambiance familiale, avec une cuisine simple. Petite particularité : vous pourrez voir des animaux depuis la salle de restauration ! les enfants pourront aller les caresser et les nourrir..."
    ],
    "nl": [
      "Wij ontvangen u op een warme plek, in een familiale sfeer, met een eenvoudige keuken. Een bijzonderheid: u kunt dieren zien vanuit de eetkamer! de kinderen kunnen ze aaien en voeren..."
    ],
    "es": [
      "Le acogemos en un lugar cálido, en un ambiente familiar, con una cocina sencilla. Una característica especial: ¡se pueden ver animales desde el comedor! Los niños pueden ir a acariciarlos y darles de comer..."
    ]
  },
