  "rdfs:comment": {
    "de": [
      "Ein Kollektiv von Fachleuten mit unterschiedlichen Hintergründen, Unternehmern, ehemaligen Managern und Personalverantwortlichen, die sich um gemeinsame Werte versammelt haben und den Menschen wieder in den Mittelpunkt stellen wollen."
    ],
    "en": [
      "A collective of professionals from a variety of backgrounds - entrepreneurs, former managers and HR executives - united around shared values, with a determination to put people back at the center."
    ],
    "it": [
      "Un gruppo di professionisti di diversa estrazione, imprenditori, ex manager e direttori delle risorse umane, uniti da valori comuni, con il desiderio di rimettere al centro le persone."
    ],
    "fr": [
      "Un collectif de professionnels d’horizons variés, entrepreneurs, anciens managers et responsables RH, réunis autours de valeurs communes, avec une volonté de remettre l’humain au centre."
    ],
    "es": [
      "Un grupo de profesionales de orígenes diversos, empresarios, antiguos directivos y directores de RRHH, unidos en torno a unos valores compartidos, con el deseo de volver a poner a las personas en el centro."
    ],
    "nl": [
      "Een groep professionals met verschillende achtergronden, ondernemers, voormalige managers en HR-directeuren, verenigd rond gedeelde waarden, met de wens om mensen weer centraal te stellen."
    ]
  },
