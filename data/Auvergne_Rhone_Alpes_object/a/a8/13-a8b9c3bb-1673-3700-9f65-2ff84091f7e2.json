  "rdfs:comment": {
    "de": [
      "Anne und Sarah erwecken diesen Ort zum Leben und laden Sie ein, eine saisonale, biologische und überwiegend pflanzliche Küche zu entdecken, die sowohl köstlich als auch ausgefeilt ist."
    ],
    "en": [
      "Anne and Sarah bring this place to life, inviting you to discover seasonal, organic and essentially plant-based cuisine that's both gourmet and elaborate."
    ],
    "it": [
      "Anne e Sarah danno vita a questo luogo e vi invitano a scoprire una cucina stagionale, biologica ed essenzialmente vegetale, deliziosa ed elaborata."
    ],
    "fr": [
      "Anne et Sarah, donnent vie à ce lieu et vous invite à découvrir une cuisine de saison, bio et essentiellement végétale à la fois gourmande et élaborée."
    ],
    "es": [
      "Anne y Sarah dan vida a este lugar y le invitan a descubrir una cocina de temporada, ecológica y esencialmente vegetal, a la vez gourmet y elaborada."
    ],
    "nl": [
      "Anne en Sarah brengen deze plek tot leven en nodigen je uit om een seizoensgebonden, biologische en voornamelijk plantaardige keuken te ontdekken die zowel heerlijk als uitgebreid is."
    ]
  },
