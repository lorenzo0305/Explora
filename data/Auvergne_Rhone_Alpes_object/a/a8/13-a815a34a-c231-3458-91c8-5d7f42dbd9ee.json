  "rdfs:comment": {
    "de": [
      "Das Fremdenverkehrsamt von Chamrousse hat seine Marke \"Qualité Tourisme\" erneuert und bietet Ihnen in seinen beiden Informationsbüros einen persönlichen Empfang."
    ],
    "en": [
      "The Chamrousse Tourist Office has renewed its \"Qualité Tourisme / Destination d'excellence\" label and offers a personalized welcome at its two information desks."
    ],
    "it": [
      "L'Ufficio del Turismo di Chamrousse ha rinnovato il suo marchio \"Turismo di qualità / Destinazione d'eccellenza\" e vi offre un'accoglienza personalizzata presso i suoi due sportelli informativi."
    ],
    "fr": [
      "L'Office de Tourisme de Chamrousse a renouvelé sa marque \"Qualité Tourisme / Destination d'excellence\" et vous offre un accueil personnalisé dans ses deux bureaux d'informations."
    ],
    "es": [
      "La Oficina de Turismo de Chamrousse ha renovado su etiqueta \"Calidad Turística / Destino de Excelencia\" y le ofrece una acogida personalizada en sus dos mostradores de información."
    ],
    "nl": [
      "Het VVV-kantoor van Chamrousse heeft zijn label \"Kwaliteitstoerisme/Bestemming van uitmuntendheid\" vernieuwd en biedt u een persoonlijk onthaal bij de twee informatiebalies."
    ]
  },
  "rdfs:label": {
    "de": [
      "Chamrousse Fremdenverkehrsbüro"
    ],
    "en": [
      "Chamrousse Tourist Office"
    ],
    "fr": [
      "Office de Tourisme de Chamrousse"
    ]
  },
