  "rdfs:comment": {
    "de": [
      "Gemeindebibliothek im ersten Stock der Ecole de la Tour in Saint Jean d'Arves.\r\nMehr als 2500 Werke für Kinder und Erwachsene (Romane auf Französisch, in Großdruck, Dokumentarfilme, Comics, Zeitschriften)\r\nWIFI-Zugang"
    ],
    "en": [
      "Town library located on the first floor of the Tour school in Saint Jean d'Arves.\r\nMore than 2,500 books for children and adults (novels in French, large print, documentaries, comics, magazines).\r\nFree Wi-Fi"
    ],
    "it": [
      "Biblioteca comunale situata al primo piano dell'Ecole de la Tour a Saint Jean d'Arves.\r\nPiù di 2.500 libri per bambini e adulti (romanzi in francese, libri a caratteri grandi, documentari, fumetti, riviste)\r\nAccesso WIFI"
    ],
    "fr": [
      "Bibliothèque municipale située au premier étage de l’école de la Tour à Saint Jean d'Arves.\r\nPlus de 2500 ouvrages pour enfants et adultes (romans en français, en gros caractères, documentaires, bandes dessinées, revues) \r\nAccès WIFI"
    ],
    "nl": [
      "Gemeentelijke bibliotheek op de eerste verdieping van de Tour school in Saint Jean d'Arves.\r\nMeer dan 2500 boeken voor kinderen en volwassenen (Franstalige romans, grootletterboeken, documentaires, strips, tijdschriften).\r\nwifi."
    ],
    "es": [
      "Biblioteca municipal situada en la primera planta de la Escuela de la Tour de Saint Jean d'Arves.\r\nMás de 2.500 libros para niños y adultos (novelas en francés, letra grande, documentales, cómics, revistas)\r\nAcceso WIFI"
    ]
  },
