  "rdfs:comment": {
    "de": [
      "In Begleitung einer Botanikerin und eines Fremdenführers können Sie eine Wanderung von Ost nach West entlang des grünen Weges unternehmen, um die vielfältige Vegetation und das reiche lokale Erbe zu entdecken."
    ],
    "en": [
      "Accompanied by a botanist and a guide, set off on a walk from east to west along the greenway, discovering varied vegetation and the rich local heritage."
    ],
    "it": [
      "Accompagnati da un botanico e da una guida, si parte per una passeggiata da est a ovest lungo il percorso verde, alla scoperta della variegata vegetazione e del ricco patrimonio locale."
    ],
    "fr": [
      "Accompagnés d’une botaniste et d’un guide, partez pour une balade d’est en ouest le long de la voie verte, à la découverte d’une végétation variée et du riche patrimoine local."
    ],
    "nl": [
      "Begeleid door een botanicus en een gids maak je een wandeling van oost naar west langs de groene route en ontdek je de gevarieerde vegetatie en het rijke plaatselijke erfgoed."
    ],
    "es": [
      "Acompañado por un botánico y un guía, emprenda un paseo de este a oeste por la vía verde, descubriendo la variada vegetación y el rico patrimonio local."
    ]
  },
  "rdfs:label": {
    "en": [
      "Visite commentée \"Au fil de l'eau, au gré des jardins\""
    ],
    "fr": [
      "Visite commentée \"Au fil de l'eau, au gré des jardins\""
    ]
  },
