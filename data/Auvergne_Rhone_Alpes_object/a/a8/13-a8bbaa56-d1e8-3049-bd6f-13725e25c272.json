  "rdfs:comment": {
    "de": [
      "BASECAMP FITNESS COACHING wächst! Basecamp Studio 2.0 ist da! Jetzt mit noch mehr Trainingseinheiten, Qualität und Spaß! Kleingruppen-Coaching, Gruppencoaching, Musik und Spaß."
    ],
    "en": [
      "BASECAMP FITNESS COACHING is growing! Basecamp Studio 2.0 is here! Now with even more sessions, value and fun! Small group coaching, group coaching, music, and fun."
    ],
    "it": [
      "BASECAMP FITNESS COACHING si espande! È arrivato Basecamp Studio 2.0! Ora con ancora più sessioni, valore e divertimento! Coaching per piccoli gruppi, coaching di gruppo, musica e divertimento."
    ],
    "fr": [
      "BASECAMP FITNESS COACHING s'agrandit ! Basecamp Studio 2.0 est là ! Maintenant avec encore plus de sessions, de valeur et de plaisir ! Coaching en petits groupes, coaching en groupe, musique, et fun."
    ],
    "es": [
      "¡BASECAMP FITNESS COACHING se expande! ¡Basecamp Studio 2.0 ya está aquí! Ahora con más sesiones, valor y diversión Coaching en grupos reducidos, coaching en grupo, música y diversión."
    ],
    "nl": [
      "BASECAMP FITNESS COACHING breidt uit! Basecamp Studio 2.0 is hier! Nu met nog meer sessies, waarde en plezier! Coaching in kleine groepen, groepscoaching, muziek en plezier."
    ]
