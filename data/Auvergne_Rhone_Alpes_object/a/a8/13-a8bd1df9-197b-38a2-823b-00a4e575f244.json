  "rdfs:comment": {
    "de": [
      "Ein traditionelles Hammam (und kein gemischtes Hammam außer donnerstags Familie) zum Entspannen, Meditieren, Ausruhen und Teetrinken. Ein Bereich für Massagen. Ein Institut (biologische und französische Produkte); Nehmen Sie sich im Hammam Café Zeit für sich selbst!"
    ],
    "en": [
      "A traditionnal hammam to relax, meditate, rest, have a cup of tea.. Separated areas for men and women, an area dedicated to massages, an institute (organic and French products); Come take some time for yourself at Hammam Café"
    ],
    "it": [
      "Un hammam tradizionale (non misto, tranne il giovedì delle famiglie) per il relax, la meditazione, il riposo e il tè. Uno spazio per i massaggi. Un istituto (prodotti biologici e francesi); Venite a prendervi un po' di tempo per voi all'Hammam Café!"
    ],
    "fr": [
      "Un hammam traditionnel (et non mixte sauf les jeudis famille) pour se détendre, méditer, se reposer, prendre un thé. Un espace destiné aux massages. Un institut (produits bio et français) ; Venez prendre du temps pour vous au Hammam Café !"
    ],
    "es": [
      "Un hammam tradicional (no mixto, excepto los jueves familiares) para la relajación, la meditación, el descanso y el té. Un espacio para los masajes. Un instituto (productos orgánicos y franceses); ¡Venga a tomarse un tiempo para usted en el Hammam Café!"
    ],
    "nl": [
      "Een traditionele hammam (niet gemengd behalve op familiedonderdag) voor ontspanning, meditatie, rust en thee. Een ruimte voor massages. Een instituut (biologische en Franse producten); Kom en neem wat tijd voor jezelf in het Hammam Café!"
    ]
  },
