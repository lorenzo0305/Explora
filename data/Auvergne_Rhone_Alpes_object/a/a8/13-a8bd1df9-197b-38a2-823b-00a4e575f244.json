          "additionalInformation": {
            "de": [
              "Öffnungszeiten des Hammam:\r\nfür Frauen: Montag, Dienstag, Mittwoch, Freitag von 10:00 bis 22:00 Uhr, Donnerstag von 10:00 bis 17:00 Uhr und Samstag von 9:00 bis 21:00 Uhr\r\nfür Männer: Donnerstag von 17:00 bis 22:00 Uhr.\r\nFamilien-Hammam jeden letzten Donnerstag im Monat von 10:00 bis 22:00 Uhr."
            ],
            "en": [
              "Steam room opening times:\r\nfor women: Monday, Tuesday, Wednesday, Friday from 10am to 10pm, Thursday from 10am to 5pm and Saturday from 9am to 9pm\r\nfor men: Thursday from 5pm to 10pm.\r\nFamily Hammam every last Thursday of the month from 10am to 10pm."
            ],
            "it": [
              "Orari di apertura dell'hammam:\r\nper le donne: lunedì, martedì, mercoledì, venerdì dalle 10.00 alle 22.00, giovedì dalle 10.00 alle 17.00 e sabato dalle 9.00 alle 21.00\r\nper gli uomini: giovedì dalle 17.00 alle 22.00.\r\nHammam per famiglie ogni ultimo giovedì del mese dalle 10.00 alle 22.00."
            ],
            "fr": [
              "Horaires hammam:\r\npour les femmes: lundi, mardi, mercredi, vendredi de 10h à 22h, jeudi de 10h à 17h et samedi de 9h à 21h \r\npour les hommes :  jeudi de 17h à 22h.\r\nHammam Famille tous les derniers jeudis de chaque mois de 10h à 22h."
            ],
            "nl": [
              "Openingstijden Hammam\r\nvoor vrouwen: maandag, dinsdag, woensdag, vrijdag van 10 tot 22 uur, donderdag van 10 tot 17 uur en zaterdag van 9 tot 21 uur\r\nvoor mannen: donderdag van 17.00 tot 22.00 uur.\r\nFamilie Hammam elke laatste donderdag van de maand van 10 tot 22 uur."
            ],
            "es": [
              "Horario de apertura del hammam\r\npara las mujeres: lunes, martes, miércoles y viernes de 10.00 a 22.00 h, jueves de 10.00 a 17.00 h y sábado de 9.00 a 21.00 h\r\npara hombres: jueves de 17.00 a 22.00 h.\r\nHammam familiar el último jueves de cada mes de 10.00 a 22.00 h."
            ]
          },
