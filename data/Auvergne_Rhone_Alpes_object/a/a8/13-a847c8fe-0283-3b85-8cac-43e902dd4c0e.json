  "rdfs:comment": {
    "de": [
      "Unser Chefkoch verwöhnt Ihren Gaumen während Ihres Aufenthalts mit einer großen Auswahl an hausgemachten Pizzen sowie traditionellen französischen Gerichten und Spezialitäten aus Savoyen. An schönen Tagen können Sie die Sonnenterrasse nutzen."
    ],
    "en": [
      "Our Chef will delight your taste buds during your stay with a wide choice of pizzas, as well as traditional French dishes and Savoyard specialties."
    ],
    "it": [
      "Il nostro chef stuzzicherà il vostro palato durante il vostro soggiorno con un'ampia scelta di pizze fatte in casa, oltre a piatti tradizionali francesi e specialità savoiarde. Nelle giornate di sole, approfittate della terrazza soleggiata."
    ],
    "fr": [
      "Notre Chef  vous régalera les papilles durant votre séjour avec un large choix de pizzas faites maison, ainsi que des plats traditionnels français et des spécialités savoyardes. Pour les belles journées, profitez de la terrasse ensoleillée."
    ],
    "nl": [
      "Onze chef-kok zal je smaakpapillen tijdens je verblijf prikkelen met een ruime keuze aan huisgemaakte pizza's, evenals traditionele Franse gerechten en Savoyaardse specialiteiten. Geniet op zonnige dagen van het zonnige terras."
    ],
    "es": [
      "Nuestro chef deleitará su paladar durante su estancia con una amplia selección de pizzas caseras, así como platos tradicionales franceses y especialidades saboyanas. En los días soleados, aproveche al máximo la soleada terraza."
    ]
  },
