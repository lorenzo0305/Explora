  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/e0028a24-1998-34a8-afce-78cd7c00b146",
      "dc:description": {
        "de": [
          "Das Grand Café Hardelot besteht aus einem Saal, zwei Außenterrassen und einer überdachten Terrasse.\nWir haben täglich von 10:00 bis 22:00 Uhr geöffnet.\nWir bieten Ihnen Gerichte à la carte an."
        ],
        "en": [
          "Le Grand Café Hardelot comprises a dining room, 2 outdoor terraces and a covered terrace.\nWe're open every day from 10am to 10pm.\nWe offer à la carte dishes."
        ],
        "it": [
          "Le Grand Café Hardelot dispone di una sala da pranzo, 2 terrazze esterne e una terrazza coperta.\nSiamo aperti tutti i giorni dalle 10.00 alle 22.00.\nOffriamo piatti à la carte."
        ],
        "fr": [
          "Le Grand Café Hardelot se compose d une salle, de 2 terrasses extérieures et une terrasse couverte.\nNous ouvrons tous les jours de 10H à 22H.\nNous vous proposons des plats à la carte."
        ],
        "nl": [
          "Le Grand Café Hardelot heeft een eetzaal, 2 buitenterrassen en een overdekt terras.\nWe zijn elke dag geopend van 10.00 tot 22.00 uur.\nWe bieden à la carte gerechten."
        ],
        "es": [
          "Le Grand Café Hardelot dispone de un comedor, 2 terrazas al aire libre y una terraza cubierta.\nAbrimos todos los días de 10.00 a 22.00 horas.\nOfrecemos platos a la carta."
        ]
      },
