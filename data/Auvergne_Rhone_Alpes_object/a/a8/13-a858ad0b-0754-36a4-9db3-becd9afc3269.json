  "rdfs:comment": {
    "de": [
      "Das Heim befindet sich in der Nähe des Eau d'Olle Express und empfängt Sie den ganzen Winter über. Hier können Sie Ihre Ausrüstung ausleihen: Langlaufski, nordische Ski und auch Schneeschuhe. Das Team des Heims wird Sie je nach Ihrer Sportart über die unumgänglichen Orte beraten."
    ],
    "en": [
      "Located close to Eau d'Olle Express, the foyer welcomes you all winter long. You can rent cross-country, Nordic and snowshoe equipment. The team at the hostel will be happy to advise you on the best sites for your activity."
    ],
    "it": [
      "Situato vicino all'Eau d'Olle Express, il foyer vi accoglie per tutto l'inverno. È possibile noleggiare attrezzature per lo sci di fondo, lo sci nordico e le racchette da neve. Il team dell'ostello saprà consigliarvi i siti indispensabili per la vostra attività."
    ],
    "fr": [
      "Situé à proximité de l'Eau d'Olle Express le foyer vous accueille tout l'hiver. Vous pourrez y louer votre matériel : ski de fond, nordique et aussi des raquettes. L'équipe du foyer saura vous conseiller sur les sites incontournables selon votre pratique."
    ],
    "es": [
      "Situado cerca del Eau d'Olle Express, el vestíbulo le da la bienvenida durante todo el invierno. Podrá alquilar material de esquí de fondo, nórdico y raquetas de nieve. El equipo del albergue podrá aconsejarle sobre los lugares imprescindibles para su actividad."
    ],
    "nl": [
      "De foyer ligt vlak bij de Eau d'Olle Express en verwelkomt je de hele winter. Je kunt er langlauf-, nordic- en sneeuwschoenmateriaal huren. Het team van de herberg kan je adviseren over de plaatsen die essentieel zijn voor jouw activiteit."
    ]
  },
  "rdfs:label": {
