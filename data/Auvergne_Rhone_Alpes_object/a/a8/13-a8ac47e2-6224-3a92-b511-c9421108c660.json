  "rdfs:comment": {
    "de": [
      "In \"Substraction\" schafft Soda ein beeindruckendes Werk, in dem seine abstrakten Schwarz-Weiß-Arbeiten auf die Fassade aus rohem Beton geschrieben werden."
    ],
    "en": [
      "In \"Substraction\", Soda creates a striking work in which his abstract black-and-white work is inscribed on the raw concrete façade."
    ],
    "it": [
      "In \"Substraction\", Soda crea un'opera suggestiva in cui il suo lavoro astratto in bianco e nero è inscritto sulla facciata di cemento grezzo."
    ],
    "fr": [
      "Dans \"Substraction\" Soda réalise une œuvre saisissante où son travail abstrait en en noir et blanc vient s'inscrire sur la façade au béton brut."
    ],
    "nl": [
      "In 'Substraction' creëert Soda een opvallend werk waarin zijn abstracte zwart-wit werk is aangebracht op de ruwe betonnen gevel."
    ],
    "es": [
      "En \"Substraction\", Soda crea una obra impactante en la que su obra abstracta en blanco y negro se inscribe en la fachada de hormigón en bruto."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Street art de SODA - Walls & Love"
    ]
  },
