  "rdfs:comment": {
    "de": [
      "Auf einem steinigen Berghang über dem Fluss Lignon wurden\r\ndie mittelalterliche Festung und das Gotteshaus von Couzan erbaut.\r\nSpektakuläre Aussicht garantiert."
    ],
    "en": [
      "Built on a rocky spur, both the medieval fortress and the chapel offer a grand\r\npanoramically view on the Forez, Lyonnais and Auvergne mountains."
    ],
    "it": [
      "Costruita su uno sperone roccioso sopra il Lignon, la fortezza medievale e la cappella di Couzan offrono un imponente panorama sulla pianura del Forez, sulle montagne del Lyonnais, del Forez e dell'Alvernia."
    ],
    "fr": [
      "Bâties sur un éperon rocheux en à-pic au-dessus du Lignon, la forteresse médiévale et la chapelle de Couzan offrent un panorama grandiose sur la plaine du Forez, les monts du Lyonnais, du Forez et de l'Auvergne."
    ],
    "nl": [
      "Gebouwd op een rotsachtige uitloper boven de Lignon, bieden het middeleeuwse fort en de kapel van Couzan een indrukwekkend panorama over de vlakte van de Forez, de bergen van Lyonnais, de Forez en de Auvergne."
    ],
    "es": [
      "Construida en un espolón rocoso sobre el Lignon, la fortaleza medieval y la capilla de Couzan ofrecen un imponente panorama de la llanura del Forez, los montes del Lyonnais, el Forez y Auvernia."
    ]
  },
  "rdfs:label": {
    "de": [
      "Festung und Kapelle von Couzan"
    ],
    "en": [
      "Fortress and Chapel of Couzan"
    ],
    "fr": [
      "Forteresse Médiévale et Chapelle de Couzan"
    ]
  },
