  "rdfs:comment": {
    "de": [
      "Sie kennen sicher das Restaurant LE PIANO DU LAC am Ufer des Sees von Laffrey?\r\nhier finden zahlreiche Konzerte statt und die Speisekarte ist auf die Jahreszeit abgestimmt. Herrlicher Blick auf den See."
    ],
    "en": [
      "With a beautiful view over Laffrey's lake, the restaurant suggests various concert and a cooking depending on the season."
    ],
    "it": [
      "Avrete sentito parlare del ristorante LE PIANO DU LAC, sulle rive del lago di Laffrey?\r\noffre un'ampia scelta di concerti, con un menu adatto alla stagione. Vista superba sul lago."
    ],
    "fr": [
      "Vous connaissez surement le restaurant LE PIANO DU LAC au bord du lac de laffrey…\r\nà l'affiche une multitude de concert, avec une carte en adéquation avec la saison. Vue superbe sur le lac."
    ],
    "es": [
      "Seguro que ha oído hablar del restaurante LE PIANO DU LAC, situado a orillas del lago Laffrey\r\nofrece una amplia gama de conciertos, con un menú acorde con la temporada. Magníficas vistas del lago."
    ],
    "nl": [
      "Met een prachtig uitzicht op het meer , een ideale plek om van een concert en een seizoensgerichte keuken te genieten."
    ]
  },
