  "rdfs:comment": {
    "de": [
      "Das B.I.T. in Villaroger empfängt Sie von Dezember bis April freundlich und hilft Ihnen, einen angenehmen Urlaub zu verbringen, der Ihren Wünschen entspricht."
    ],
    "en": [
      "The Villaroger B.I.T. offers a warm welcome from December to April to help you enjoy a vacation that's just right for you."
    ],
    "it": [
      "Il B.I.T. di Villaroger vi offre un'accoglienza calorosa da dicembre ad aprile, per farvi trascorrere la vacanza che fa per voi."
    ],
    "fr": [
      "Le B.I.T. de Villaroger vous accueille avec convivialité de décembre à avril pour vous aider à passer d'agréables vacances adaptées à vos envies."
    ],
    "nl": [
      "Het Villaroger B.I.T. biedt een warm welkom van december tot april om je te helpen genieten van een vakantie die helemaal bij jou past."
    ],
    "es": [
      "El B.I.T. Villaroger le ofrece una cálida acogida de diciembre a abril para que disfrute de unas vacaciones a su medida."
    ]
  },
