  "rdfs:comment": {
    "de": [
      "Genießen Sie unsere traditionelle und familiäre Küche in einem gemütlichen Ambiente mit einer hervorragenden Karte und lokalen Weinen. Fleisch- und Fischspezialitäten, wie Tintenfisch à la Plancha. Im Frühling und Sommer: \r\nSonntagnachmittag Crepes, Eis und leckere Desserts."
    ],
    "en": [
      "Come and taste our traditional family cuisine in an intimate setting with a very fine local wine list. Meat and fish specialities, cuttlefish \"à la plancha\". On Sunday \r\nafternoons in spring and summer, crêpes, icecreams and gourmet desserts."
    ],
    "it": [
      "Il ristorante si trova accanto al monumento più bello di tutti: la Cattedrale di San Paolo.\r\nVenite a gustare la nostra cucina tradizionale e familiare in un ambiente accogliente, con un'ottima lista di vini locali."
    ],
    "fr": [
      "Le restaurant est situé à côté du  plus beau monument : la cathédrale de St Paul.\r\nVenez déguster notre cuisine traditionnelle et familiale dans un cadre cosy, avec une très belle carte des vins locaux."
    ],
    "nl": [
      "Kom genieten van onze traditionele en familiale keuken in een gezellig \r\nkader met een zeer mooie lokale wijnkaart. Vlees- en visspecialiteiten, inktvis a la plancha. In het voorjaar en de zomer: zondagmiddag pannenkoeken, ijs en gastronomische desserts."
    ],
    "es": [
      "El restaurante está situado junto al monumento más bello de todos: la catedral de San Pablo.\r\nVenga a disfrutar de nuestra cocina tradicional y familiar en un ambiente acogedor, con una excelente carta de vinos locales."
    ]
  },
