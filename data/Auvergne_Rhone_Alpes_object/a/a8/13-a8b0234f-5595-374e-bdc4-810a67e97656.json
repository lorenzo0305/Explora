  "rdfs:comment": {
    "de": [
      "La Manivelle ist eine Geschichte, die Bestand hat! Seit 2009 brauen wir unsere handwerklichen und biologischen Biere mit Wasser aus dem Vercors. Sie haben die Möglichkeit, unsere Biere vor Ort zu probieren und zu kaufen, wobei Sie aus rund 15 verschiedenen Biersorten wählen können!"
    ],
    "en": [
      "La Manivelle Brewery has been going strong since 2009 ! 14 years already that we have been brewing our organic craft beers with Vercors water.  You have a choice of 15 beers to sample and buy on site!"
    ],
    "it": [
      "La Manivelle è una storia che dura! Dal 2009 produciamo le nostre birre artigianali e biologiche con l'acqua del Vercors. Potrete venire a degustare e acquistare le nostre birre sul posto, con una scelta di circa quindici birre!"
    ],
    "fr": [
      "La Manivelle c’est une histoire qui dure ! Nous brassons nos bières artisanales et bios à l'eau du Vercors depuis 2009. Vous avez la possibilité de venir déguster et acheter nos bières sur place, avec un choix parmi une quinzaine de bières !"
    ],
    "es": [
      "¡La Manivelle es una historia que dura! Desde 2009 elaboramos nuestras cervezas artesanales y ecológicas con agua del Vercors. Puede venir a degustar y comprar nuestras cervezas in situ, con una selección de unas quince cervezas"
    ],
    "nl": [
      "La Manivelle is een robuuste zaak: deze brouwerij uit 2009 bestaat alweer 14 jaar en de passie voor bier is nog altijd intact! Bezoek onze brouwerij (gratis) en ontdek onze verschillende bieren."
    ]
  },
  "rdfs:label": {
    "de": [
