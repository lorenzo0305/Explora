  "rdfs:comment": {
    "de": [
      "Begegnungen, Animationen (Workshops), Autogrammstunden, Aufführungen, Wohlwollen und Lächeln... und nicht zu vergessen das grenzenlose Engagement der Kinder und Lehrer!\r\nDas Programm finden Sie in der Anlage..."
    ],
    "en": [
      "Meetings, activities (workshops), autographs, shows, kindness and smiles? not forgetting the boundless involvement of the children and teachers!\r\nProgram attached in the visuals..."
    ],
    "it": [
      "Incontri, attività (laboratori), presentazioni di libri, spettacoli, buona volontà e sorrisi, senza dimenticare lo sconfinato coinvolgimento di bambini e insegnanti!\r\nProgramma allegato nelle immagini..."
    ],
    "fr": [
      "Rencontres, animations (ateliers), dédicaces, spectacles, bienveillance et sourires… sans oublier une implication sans borne des enfants et des enseignants !\r\nProgramme en pièce jointe dans les visuels..."
    ],
    "es": [
      "Reuniones, actividades (talleres), firmas de libros, espectáculos, buena voluntad y sonrisas... ¡sin olvidar la implicación sin límites de los niños y los profesores!\r\nPrograma adjunto en las imágenes..."
    ],
    "nl": [
      "Ontmoetingen, activiteiten (workshops), signeersessies, shows, goodwill en glimlachen? En niet te vergeten de grenzeloze betrokkenheid van de kinderen en leerkrachten!\r\nProgramma bijgevoegd in de visuals..."
    ]
  },
  "rdfs:label": {
    "fr": [
