  "rdfs:comment": {
    "de": [
      "Ein kreatives Dorfbistro, das originelle Menüs aus frischen, von lokalen Erzeugern bezogenen Produkten anbietet. Eine Küche voller Aromen, die Weltküche und regionale Küche mischt. Frischer Fisch, lokales Fleisch, hausgemachtes Gebäck."
    ],
    "en": [
      "A creative village bistro offering original menus based on fresh produce sourced from local producers. A cuisine of flavors blending world and local cuisine. Fresh fish, local meats, home-made pastries."
    ],
    "it": [
      "Un bistrot creativo di paese che offre menu originali a base di prodotti freschi provenienti da produttori locali. Una cucina saporita che combina cucina mondiale e piatti locali. Pesce fresco, carni locali, dolci fatti in casa."
    ],
    "fr": [
      "Un bistrot de village créatif proposant des menus originaux à partir de produits frais sourcés auprès des producteurs locaux. Une cuisine de saveurs mélangeant cuisine du monde et cuisine du terroir. Poissons frais, viandes locales, pâtisserie maison."
    ],
    "es": [
      "Un bistró de pueblo creativo que ofrece menús originales basados en productos frescos procedentes de productores locales. Cocina sabrosa que combina la cocina del mundo y los platos locales. Pescado fresco, carnes locales, repostería casera."
    ],
    "nl": [
      "Een creatieve dorpsbistro met originele menu's op basis van verse producten van lokale producenten. Smakelijke keuken met een combinatie van wereldkeuken en lokale gerechten. Verse vis, lokaal vlees, huisgemaakt gebak."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Bistro Gourmand"
    ]
  },
