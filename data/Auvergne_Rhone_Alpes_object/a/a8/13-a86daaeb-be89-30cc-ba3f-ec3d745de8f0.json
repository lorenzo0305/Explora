  "rdfs:comment": {
    "de": [
      "Die Pont de Bagarre ist ein sehr großes Bauwerk, vor allem für einen so abgelegenen Ort wie die Stelle unterhalb des Weilers Croix-de-la-Pigne (Gemeinde Pellafol)."
    ],
    "en": [
      "The Pont de Bagarre is a large-scale building, especially for a place as isolated as the location below the hamlet of Croix-de-la-Pigne (commune of Pellafol)."
    ],
    "it": [
      "Il Pont de Bagarre è una struttura di grandi dimensioni, soprattutto per un luogo isolato come il sito sotto la frazione di Croix-de-la-Pigne (comune di Pellafol)."
    ],
    "fr": [
      "Le Pont de Bagarre est un édifice de grande ampleur surtout pour un lieu aussi isolé que l’emplacement en dessous du hameau de la Croix-de-la-Pigne (commune de Pellafol)."
    ],
    "es": [
      "El Puente de Bagarre es una obra de gran envergadura, sobre todo para un lugar tan aislado como el emplazado bajo la aldea de Croix-de-la-Pigne (municipio de Pellafol)."
    ],
    "nl": [
      "De Pont de Bagarre is een groot bouwwerk, zeker voor zo'n geïsoleerde plek als deze onder het gehucht Croix-de-la-Pigne (gemeente Pellafol)."
    ]
  },
