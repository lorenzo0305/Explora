  "rdfs:comment": {
    "de": [
      "La Ferme de Cupelin ist ein zeitloser Ort, der von Lauriane und Florian entworfen wurde, ein gemütliches Nest auf den Höhen von Saint-Gervais. Wenn Sie von einer friedlichen und bezaubernden Erfahrung träumen, sind Sie hier genau richtig"
    ],
    "en": [
      "This charming hotel and restaurant combines authenticity and modernity in peaceful surroundings. Enjoy a culinary experience in the moutains above Saint-Gervais."
    ],
    "it": [
      "Capita che tutto si leghi per offrirvi la vera vita di chalet: travi centenarie, decorazioni calorose, una cucina di montagna franca e sincera, notti tranquille e al risveglio... un panorama grandioso."
    ],
    "fr": [
      "La Ferme de Cupelin est un lieu que Lauriane et Florian ont voulu hors du temps, véritable nid douillet niché sur les hauteurs de Saint-Gervais. Si vous rêvez d’une expérience paisible et enchanteresse, bienvenue chez vous…"
    ],
    "nl": [
      "La Ferme de Cupelin is een plek die Lauriane en Florian hebben ontworpen om tijdloos te zijn, een gezellig nest in de hoogten van Saint-Gervais. Als je droomt van een vredige en betoverende ervaring, welkom thuis?"
    ],
    "es": [
      "La Ferme de Cupelin es un lugar que Lauriane y Florian han diseñado para que sea atemporal, un acogedor nido enclavado en las alturas de Saint-Gervais. Si sueña con una experiencia tranquila y encantadora, bienvenido a casa.."
    ]
  },
