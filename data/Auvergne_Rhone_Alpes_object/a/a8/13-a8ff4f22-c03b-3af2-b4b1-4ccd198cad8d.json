  "rdfs:comment": {
    "de": [
      "Die Tour des Marais ist eine schöne Einführungsschleife für Nordic Walking.\r\nDiese Trailstrecke ist für Menschen mit Behinderungen zugänglich und wurde vom französischen Behindertensportverband mit einem Gütesiegel ausgezeichnet."
    ],
    "en": [
      "The Tour des Marais is a great introductory loop for Nordic walking.\r\nThis trail is accessible to people with disabilities, and has been certified by the French Handisport Federation."
    ],
    "it": [
      "Il Tour des Marais è un'ottima introduzione al nordic walking.\r\nQuesto percorso è accessibile alle persone con disabilità ed è stato certificato dalla Federazione Francese di Handisport."
    ],
    "fr": [
      "Le tour des Marais est une belle boucle d'initiation en marche nordique.\r\nCe parcours de trail est accessible aux personnes en situation de handicap, et a été labelisé par la fédération française Handisport."
    ],
    "es": [
      "El Tour des Marais es una excelente introducción a la marcha nórdica.\r\nEste sendero es accesible para personas con discapacidad y ha sido certificado por la Federación Francesa de Handisport."
    ],
    "nl": [
      "De Tour des Marais is een geweldige introductie tot nordic walking.\r\nDit pad is toegankelijk voor mensen met een handicap en is gecertificeerd door de Franse Handisport Federatie."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La boucle d'initiation du Tour des marais - Parcours marche nordique n°10"
    ]
  },
