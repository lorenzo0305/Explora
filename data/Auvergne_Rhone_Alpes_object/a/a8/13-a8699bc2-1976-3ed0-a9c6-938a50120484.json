  "rdfs:comment": {
    "de": [
      "Im Herzen des Schlossparks von La Chèze bietet diese gemütliche Snackbar Tagesmenüs und Bretter zum Teilen in einer friedlichen und grünen Umgebung"
    ],
    "en": [
      "In the heart of the Château de la Chèze park, this friendly snack-bar offers daily menus and platters to share in a peaceful, leafy setting"
    ],
    "it": [
      "Nel cuore del parco dello Château de la Chèze, questo accogliente snack bar offre specialità giornaliere e piatti da condividere in un ambiente tranquillo e verdeggiante"
    ],
    "fr": [
      "Au cœur du parc du Château de la Chèze, ce snack-bar convivial propose des menus du jour et des planches à partager dans un cadre paisible et verdoyant"
    ],
    "nl": [
      "In het hart van het domein van Château de la Chèze biedt deze vriendelijke snackbar dagschotels en schotels om te delen in een rustige, groene omgeving"
    ],
    "es": [
      "En el corazón del Château de la Chèze, este agradable snack bar ofrece especialidades del día y platos para compartir en un entorno tranquilo y frondoso"
    ]
  },
  "rdfs:label": {
