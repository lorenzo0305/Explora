  "rdfs:comment": {
    "de": [
      "Das Eskis ist eine Bar, ein Restaurant und ein Imbiss.\r\nDas Team empfängt Sie in einem angenehmen und gemütlichen Rahmen, um Ihnen seine savoyischen Spezialitäten, Burger, Salate? zu servieren"
    ],
    "en": [
      ".L'Eskis is a bar-restaurant-snack bar.\r\nThe whole team welcomes you in a pleasant and warm atmosphere to serve you its Savoyard specialities, burgers, salads..."
    ],
    "it": [
      "L'Eskis è un bar-ristorante-snack bar.\r\nL'intero team vi accoglie in un'atmosfera piacevole e calorosa per servirvi le sue specialità savoiarde, hamburger, insalate?"
    ],
    "fr": [
      "L'Eskis est un bar restaurant snack.\r\nToute l'équipe vous accueille  dans un cadre agréable et chaleureux pour vous servir ses spécialités savoyardes, burgers, salades…"
    ],
    "nl": [
      "L'Eskis is een bar-restaurant-snackbar.\r\nHet hele team verwelkomt u in een aangename en warme sfeer om u zijn Savoyaardse specialiteiten, hamburgers, salades?"
    ],
    "es": [
      "L'Eskis es un bar-restaurante-snack bar.\r\nTodo el equipo le recibe en un ambiente agradable y cálido para servirle sus especialidades saboyanas, hamburguesas, ensaladas.."
    ]
