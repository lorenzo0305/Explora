  "rdfs:comment": {
    "de": [
      "Entdecken Sie unsere Weltküche aus aller Herren Länder und probieren Sie neue Geschmacksrichtungen aus. Schneller Service, klimatisierter Saal und angenehme Terrasse."
    ],
    "en": [
      "Come and discover our world cuisine, from all horizons, and enjoy new flavours. Fast service, air-conditioned room and pleasant terrace."
    ],
    "it": [
      "Venite a scoprire la nostra cucina mondiale, proveniente da tutto il mondo, e a gustare nuovi sapori. Servizio rapido, camera climatizzata e piacevole terrazza."
    ],
    "fr": [
      "Venez découvrir notre cuisine du monde, de tous horizons et ainsi apprecier de nouvelles saveurs. Service rapide, salle climatisée et agréable terrasse."
    ],
    "es": [
      "Venga a descubrir nuestra cocina mundial, de todo el mundo, y disfrute de nuevos sabores. Servicio rápido, habitación con aire acondicionado y agradable terraza."
    ],
    "nl": [
      "Kom en ontdek onze wereldkeuken, van over de hele wereld, en geniet van nieuwe smaken. Snelle service, kamer met airconditioning en aangenaam terras."
    ]
  },
