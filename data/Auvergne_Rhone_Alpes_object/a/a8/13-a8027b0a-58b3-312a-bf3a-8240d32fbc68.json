  "rdfs:comment": {
    "de": [
      "Begeben Sie sich auf eine innovative Erfahrung im PlanB Living Saint-Gervais! Mit 37 Zimmern und einem Schlafsaal für Unerschrockene und einem XL-Zimmer für moderne Stämme ist PlanB der ideale Ausgangspunkt für Ihre Ausflüge."
    ],
    "en": [
      "Embark on an innovative experience at PlanB Living Saint-Gervais! With 37 rooms and a dormitory for the intrepid and an XL room for the modern tribe, PlanB is the ideal starting point for your escapades."
    ],
    "it": [
      "Partite per un'esperienza innovativa al PlanB Living Saint-Gervais! Con 37 camere e un dormitorio per gli intrepidi e una sala XL per la tribù moderna, PlanB è il punto di partenza ideale per le vostre fughe."
    ],
    "fr": [
      "Embarquez pour une expérience innovante à PlanB Living Saint-Gervais ! Doté de 37 chambres et d'un dortoir pour les intrépides et d'une chambre XL pour les tribus modernes, PlanB est le point de départ idéal pour vos escapades."
    ],
    "es": [
      "¡Embárcate en una experiencia innovadora en PlanB Living Saint-Gervais! Con 37 habitaciones y un dormitorio para los intrépidos y una habitación XL para la tribu moderna, PlanB es el punto de partida ideal para sus escapadas."
    ],
    "nl": [
      "Beleef een innovatieve ervaring bij PlanB Living Saint-Gervais! Met 37 kamers en een slaapzaal voor de onverschrokkenen en een XL-kamer voor de moderne stam, is PlanB de ideale uitvalsbasis voor je escapades."
    ]
  },
