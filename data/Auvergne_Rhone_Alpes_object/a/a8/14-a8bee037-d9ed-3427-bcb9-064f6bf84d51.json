      "dc:description": {
        "de": [
          "Wir pflegen alle Arten von Gebäuden für Gewerbetreibende, Privatpersonen und Kommunen. Wir pflegen auch die Gemeinschaftsbereiche von Gebäuden."
        ],
        "en": [
          "We maintain all types of buildings for professionals, private individuals and local authorities, as well as the common areas of apartment buildings."
        ],
        "it": [
          "Ci occupiamo della manutenzione di tutti i tipi di edifici per professionisti, privati e autorità locali, nonché delle aree comuni dei condomini."
        ],
        "fr": [
          "Nous entretenons tous types de bâtiments pour les professionnels, les particuliers et les collectivités.Nous entretenons les parties communes d'immeuble également."
        ],
        "nl": [
          "We onderhouden alle soorten gebouwen voor professionals, particulieren en lokale overheden, maar ook de gemeenschappelijke ruimten van appartementencomplexen."
        ],
        "es": [
          "Mantenemos todo tipo de edificios para profesionales, particulares y autoridades locales, así como las zonas comunes de bloques de apartamentos."
        ]
