  "rdfs:comment": {
    "de": [
      "Eine reiche Sammlung von über 200 Marionetten, 2000 Bühnenbildern, Kostümen und Requisiten! Der Theatersaal des Museums bietet ein Programm mit Aufführungen für Erwachsene und junges Publikum."
    ],
    "en": [
      "A rich collection of over 200 puppets, settings, props, costumes and archives is waiting for you ! Stroll through the museum, its shop and library and then, bring some fun memories, sometimes to relish !"
    ],
    "it": [
      "Una ricca collezione di oltre 200 marionette, 2.000 scenografie, costumi e accessori! Il teatro del museo offre un programma di spettacoli per adulti e giovani."
    ],
    "fr": [
      "Une collection riche de plus de 200 marionnettes, 2000 décors, costumes et accessoires ! La salle de théâtre du musée propose une programmation de spectacles pour adultes et jeune public."
    ],
    "es": [
      "Una rica colección de más de 200 marionetas, 2.000 decorados, trajes y accesorios El teatro del museo ofrece un programa de espectáculos para público adulto y joven."
    ],
    "nl": [
      "Een rijke collectie van meer dan 200 poppen, 2000 decors, kostuums en accessoires! Het theater van het museum biedt een programma met voorstellingen voor volwassenen en een jong publiek."
    ]
  },
  "rdfs:label": {
