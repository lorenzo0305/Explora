  "rdfs:comment": {
    "de": [
      "La Folie Douce bietet Ihnen ein einzigartiges Après-Ski-Erlebnis. Ein Konzept, das für alle Kundengruppen, Familien, junge und weniger junge Leute geeignet und zugänglich ist. Zu Fuß oder auf Skiern erreichbar."
    ],
    "en": [
      "The Folie Douce offers you a unique Après-ski experience. A concept suitable and accessible to all customers, families, young and old. Accessible on foot or by ski."
    ],
    "it": [
      "La Folie Douce offre un'esperienza unica per il dopo-sci. Un concetto adattato e accessibile a tutti i tipi di clientela, famiglie, giovani e anziani. Accessibile a piedi o con gli sci."
    ],
    "fr": [
      "La Folie Douce vous offre une expérience unique d'Après-ski. Un concept adapté et accessible à toutes les clientèles, familles, jeunes et moins jeunes. Accessible à pied ou à ski."
    ],
    "es": [
      "La Folie Douce ofrece una experiencia après-ski única. Un concepto adaptado y accesible a todo tipo de clientela, familias, jóvenes y mayores. Accesible a pie o con esquís."
    ],
    "nl": [
      "Folie Douce biedt u een unieke après-ski-ervaring. Een concept dat geschikt en toegankelijk is voor alle klanten, gezinnen, jongeren en ouderen. Te voet of op de ski bereikbaar."
    ]
  },
