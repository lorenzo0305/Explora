  "rdfs:comment": {
    "de": [
      "Zusammenschluss von Wanderführern aus dem Diois, der u. a. die Transdioise organisiert: eine Wandertour, deren Ziel es ist, das Diois zu umrunden. Jedes Jahr im Juni eine neue Etappe und die Entdeckung unbekannter Wanderwege."
    ],
    "en": [
      "A group of Diois guides who organize, among other things, the Transdioise: an itinerant hike around the Diois. Each year in June, a new stage is added, and little-known paths are discovered."
    ],
    "it": [
      "Un gruppo di guide della regione di Diois, che organizza, tra l'altro, la Transdioise: un tour della regione di Diois. Ogni anno, a giugno, si sceglie una nuova tappa e si scoprono percorsi poco conosciuti."
    ],
    "fr": [
      "Regroupement d'accompagnateurs du Diois, qui organise, entre autres, la Transdioise : une randonnée itinérante qui a pour but de faire le tour du Diois. Chaque année au mois de juin une nouvelle étape et la découverte de sentiers méconnus."
    ],
    "es": [
      "Un grupo de guías de la región de Diois, que organiza, entre otras cosas, la Transdioise: un recorrido por la región de Diois. Cada año, en junio, se elige una nueva etapa y se descubren caminos poco conocidos."
    ],
    "nl": [
      "Een groep gidsen uit de Diois die onder andere de Transdioise organiseren: een toertocht rond de Diois. Elk jaar in juni wordt een nieuwe etappe toegevoegd en worden weinig bekende paden ontdekt."
    ]
  },
  "rdfs:label": {
    "en": [
      "Accompagnateurs en Montagne du Diois"
    ],
    "fr": [
      "Accompagnatrices et Accompagnateurs en Montagne du Diois"
    ]
  },
