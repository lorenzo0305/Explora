  "rdfs:comment": {
    "de": [
      "Kämpfer-Parcours inmitten der Natur. Stellen Sie sich auf dem Hindernisparcours einer Vielzahl an Prüfungen auf verschiedenem Niveau."
    ],
    "en": [
      "\"Assault course in the great outdoors.\r\nGet together to tackle the assault course, a multitude of challenges of varying levels, suitable for all.\""
    ],
    "it": [
      "Il percorso a ostacoli in mezzo alla natura.\r\nTrovatevi sul percorso a ostacoli con una moltitudine di eventi di diversi livelli, adatti a tutti."
    ],
    "fr": [
      "Parcours du combattant en pleine nature.\r\nRetrouvez-vous sur le parcours du combattant avec une multitude d'épreuves de différents niveaux pour s'adapter à tous."
    ],
    "es": [
      "La carrera de obstáculos en plena naturaleza.\r\nEncuéntrate en la carrera de obstáculos con una multitud de pruebas de diferentes niveles que se adaptan a todo el mundo."
    ],
    "nl": [
      "De hindernisbaan midden in de natuur.\r\nVind jezelf op de hindernisbaan met een groot aantal evenementen van verschillende niveaus voor iedereen."
    ]
  },
