  "rdfs:comment": {
    "de": [
      "Offen für Einheimische und Urlauber. Internet-Zugang. Leseworkshops für Kinder"
    ],
    "en": [
      "The Médiathèque municipale de Ruoms is a place for young and old alike, where you can consult books and magazines, play board games, discover exhibitions, listen to readings and share your personal favorites."
    ],
    "it": [
      "La biblioteca municipale multimediale Ruoms è un luogo per grandi e piccini, dove si possono consultare libri e riviste, giocare a giochi da tavolo, scoprire mostre, ascoltare letture e condividere i propri beniamini."
    ],
    "fr": [
      "La Médiathèque municipale de Ruoms est un lieu de vie pour petits et grands où vous pouvez consulter des livres, des revues, venir jouer à des jeux de société, découvrir des expositions, écouter des lectures et partager vos coups de cœur."
    ],
    "nl": [
      "Voor de lokale bevolking en de toersten. Toegang tot internet."
    ],
    "es": [
      "La biblioteca multimedia municipal de Ruoms es un lugar para grandes y pequeños, donde podrás consultar libros y revistas, jugar a juegos de mesa, descubrir exposiciones, escuchar lecturas y compartir tus favoritos."
    ]
  },
