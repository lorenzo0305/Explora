  "rdfs:comment": {
    "de": [
      "Die Lehrer und Lehrerinnen unterrichten und betreuen Sie in Gruppenkursen, Einzelunterricht oder Privatunterricht in allen Wintersportarten: Alpinski, Snowboard, Nordic Ski..."
    ],
    "en": [
      "Ski instructors teach all the different snow activities in group lessons or private lessons. Ski, snowboard lessons, nordic ski….."
    ],
    "it": [
      "I nostri istruttori insegnano e supervisionano tutti i tipi di sport sulla neve, in lezioni di gruppo, individuali o private: sci alpino, snowboard, sci nordico?"
    ],
    "fr": [
      "Les moniteurs et monitrices vous enseignent et encadrent toutes les glisses, en cours collectifs, leçons individuelles ou en cours privés : Ski alpin, snowboard, ski nordique…"
    ],
    "nl": [
      "Skileraren geven les in alle verschillende sneeuwactiviteiten in groepslessen of privélessen. Ski- en snowboardlessen, nordic ski ....."
    ],
