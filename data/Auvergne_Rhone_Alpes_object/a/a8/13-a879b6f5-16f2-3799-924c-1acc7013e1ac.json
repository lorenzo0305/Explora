  "rdfs:comment": {
    "de": [
      "Wecken Sie Ihre Sinne, erleben Sie es. Die Villa Cohendier bietet einen einzigartigen Rahmen, um die Natur und das Kulturerbe mithilfe einer immersiven und interaktiven Szenografie zu entdecken."
    ],
    "en": [
      "Awaken your senses, live the experience. Villa Cohendier offers a unique setting for discovering nature and heritage through immersive, interactive scenography."
    ],
    "it": [
      "Risvegliare i sensi, vivere l'esperienza. Villa Cohendier offre un ambiente unico per scoprire la natura e il patrimonio attraverso una scenografia coinvolgente e interattiva."
    ],
    "fr": [
      "Éveillez vos sens, vivez l’expérience. La Villa Cohendier offre un cadre unique pour découvrir la nature et le patrimoine grâce à une scénographie immersive et interactive."
    ],
    "nl": [
      "Prikkel je zintuigen, beleef de ervaring. Villa Cohendier biedt een unieke omgeving om de natuur en het erfgoed te ontdekken via een meeslepende en interactieve scenografie."
    ],
    "es": [
      "Despierte sus sentidos, viva la experiencia. Villa Cohendier ofrece un marco único para descubrir la naturaleza y el patrimonio a través de una escenografía envolvente e interactiva."
    ]
  },
