  "rdfs:comment": {
    "de": [
      "Am Eingang des Naturschutzgebiets Marais de Lavours können Sie auf einem schattigen Spaziergang die Viehzucht und die Tiere des Bauernhofs kennenlernen (Kühe, Schweine, Esel, Pferde, Schafe, Ziegen, Lamas, Ponys)."
    ],
    "en": [
      "At the entrance of the Lavours marshes nature reserve, pretty shaded walk to discover the animals of our farm (cows, pigs, donkeys, horses, sheep, goats...) in complete safety."
    ],
    "it": [
      "All'ingresso della Riserva Naturale della Palude di Lavours, c'è una piacevole passeggiata ombreggiata di 35 minuti per scoprire gli animali della fattoria (mucche, maiali, asini, cavalli, pecore, capre, lama, pony)."
    ],
    "fr": [
      "A l’entrée de la Réserve Naturelle du Marais de Lavours, promenade ombragée pour découvrir l'élevage et les animaux de la ferme (vaches, cochons, ânes, chevaux, moutons, chèvres, lamas, poneys)."
    ],
    "nl": [
      "Maak bij de ingang van het Réserve Naturelle du Marais de Lavours een schaduwrijke wandeling om de dieren van de boerderij te ontdekken (koeien, varkens, ezels, paarden, schapen, geiten, lama's en pony's)."
    ],
    "es": [
      "A la entrada de la Réserve Naturelle du Marais de Lavours, dé un paseo a la sombra para descubrir el ganado y los animales de la granja (vacas, cerdos, burros, caballos, ovejas, cabras, llamas y ponis)."
    ]
  },
  "rdfs:label": {
    "en": [
      "Swamp mini-farm"
    ],
    "it": [
      "Visita di La Ferme du Marais"
    ],
    "fr": [
      "Visite de La Ferme du Marais"
    ]
  },
