  "rdfs:comment": {
    "de": [
      "The Blues Dream Concert / Vortrag über die Geschichte des Blues\r\nDiese von Alexandre Le Nagard (Gesang, Gitarren) konzipierte und erdachte Show führt Sie durch die faszinierende Entwicklung des Blues.\r\nEs ist keine Reservierung erforderlich. Eintritt frei."
    ],
    "en": [
      "The Blues Dream Concert / lecture on the history of the Blues\r\nThis show, conceived and imagined by Alexandre Le Nagard (vocals, guitars), takes you through the fascinating evolution of the Blues.\r\nNo reservation required. Admission free."
    ],
    "it": [
      "Il concerto dei sogni del Blues / conferenza sulla storia del Blues\r\nQuesto spettacolo, ideato e immaginato da Alexandre Le Nagard (voce, chitarre), vi porterà attraverso l'affascinante evoluzione del Blues.\r\nNon è necessaria la prenotazione. Ingresso libero."
    ],
    "fr": [
      "The Blues Dream Concert / conférence sur l’histoire du Blues\r\nCe spectacle conçu et imaginé par Alexandre Le Nagard (chant, guitares) vous conduit à travers l’évolution fascinante du Blues.\r\nSans réservation. Entré sur participation libre."
    ],
    "nl": [
      "The Blues Dream Concert / lezing over de geschiedenis van de Blues\r\nDeze show, bedacht en bedacht door Alexandre Le Nagard (zang, gitaren), neemt je mee door de fascinerende evolutie van de Blues.\r\nReserveren niet nodig. Toegang gratis."
    ],
    "es": [
      "The Blues Dream Concert / conferencia sobre la historia del Blues\r\nEste espectáculo, concebido e imaginado por Alexandre Le Nagard (voz, guitarras), recorre la fascinante evolución del Blues.\r\nNo es necesario reservar. Entrada gratuita."
    ]
  },
