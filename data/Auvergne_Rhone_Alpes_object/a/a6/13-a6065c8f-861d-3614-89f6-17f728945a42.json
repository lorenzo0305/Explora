  "rdfs:comment": {
    "de": [
      "Boutique-Atelier von zwei kreativen Schwestern: Le monde d'Ô stellt Leuchten und Schmuck aus Stoff und japanischem Papier her. Atelier Sakura fertigt Mode- und Deko-Accessoires aus Stoff an. Die Boutique beherbergt auch andere Kunsthandwerker."
    ],
    "en": [
      "Shop-workshop of two designer sisters, Le monde d'Ô makes different kinds of lamps, and Atelier Sakura does kimonos, cushions, bibs, small handbags...\r\nWe also welcome other designers in the shop."
    ],
    "it": [
      "Boutique-laboratorio gestita da due sorelle creative: Le monde d'Ô realizza illuminazione e gioielli in tessuto e carta giapponese. L'Atelier Sakura realizza moda in tessuto e accessori decorativi. La boutique accoglie anche altri artigiani."
    ],
    "fr": [
      "Boutique-atelier de deux sœurs créatrices : Le monde d'Ô fabrique des luminaires et bijoux en tissu et papier japonais. Atelier Sakura confectionne des accessoires Mode&Déco en tissu. La boutique accueille aussi d'autres artisans."
    ],
    "es": [
      "Tienda-taller dirigida por dos creativas hermanas: Le monde d'Ô fabrica lámparas y joyas con telas y papel japoneses. Atelier Sakura fabrica moda textil y accesorios decorativos. La boutique también acoge a otros artesanos."
    ],
    "nl": [
      "Boetiek-atelier gerund door twee creatieve zussen: Le monde d'Ô maakt verlichting en sieraden van Japanse stof en papier. Atelier Sakura maakt stoffen mode en decoratieve accessoires. De boetiek verwelkomt ook andere ambachtslieden."
    ]
  },
  "rdfs:label": {
    "en": [
      "Sôa shop"
    ],
    "fr": [
      "Boutique SÔA"
    ]
  },
