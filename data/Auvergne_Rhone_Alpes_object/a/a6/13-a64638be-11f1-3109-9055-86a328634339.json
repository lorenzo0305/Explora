  "rdfs:comment": {
    "de": [
      "L'écurie des chevaux du Diois ist ein Reitstall von Eigentümern, der Pferdepensionen, Reitunterricht, Praktika und Ausritte im Herzen des Diois anbietet."
    ],
    "en": [
      "L'écurie des chevaux du Diois is an owner-operated stable offering horse boarding, riding lessons, courses and rides in the heart of the Diois region."
    ],
    "it": [
      "L'écurie des chevaux du Diois è una scuderia di proprietà che offre pensione per cavalli, lezioni di equitazione, corsi e passeggiate nel cuore della regione del Diois."
    ],
    "fr": [
      "L'écurie des chevaux du Diois est une écurie de propriétaires proposant des pensions pour chevaux, des cours d'équitation, des stages et des balades au cœur du diois."
    ],
    "nl": [
      "L'écurie des chevaux du Diois is een door de eigenaar geëxploiteerde stal die paardenpensions, paardrijlessen, cursussen en ritten aanbiedt in het hart van de Diois-streek."
    ],
    "es": [
      "L'écurie des chevaux du Diois es un establo gestionado por sus propietarios que ofrece pupilaje, clases de equitación, cursos y paseos a caballo en el corazón de la región de Diois."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ecurie les chevaux du Diois"
    ]
  },
