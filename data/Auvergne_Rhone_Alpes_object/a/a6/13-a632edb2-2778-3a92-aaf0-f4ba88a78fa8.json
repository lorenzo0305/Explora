  "rdfs:comment": {
    "de": [
      "Bewundern Sie mit der 10er-Gondelbahn auf 650 m Höhenunterschied einen herrlichen Panoramablick auf den Nationalpark Vanoise. Profitieren Sie im Sommer von Mountainbike- und Wanderaktivitäten auf 2000 m Höhe."
    ],
    "en": [
      "Admire a magnificent panoramic view of the Vanoise National Park thanks to the brand new cable car. Enjoy mountain biking and hiking at 2000 m of altitude."
    ],
    "it": [
      "Ammirate una magnifica vista panoramica sul Parco Nazionale della Vanoise grazie alla nuovissima funivia. Godetevi la mountain bike e le escursioni a 2000 m di altitudine."
    ],
    "fr": [
      "Admirez un magnifique point de vue panoramique sur le Parc national de la Vanoise sur 650 m de dénivelé grâce à la télécabine 10 places. Profitez des activités VTT et randonnée à 2000 m d'altitude l'été."
    ],
    "nl": [
      "Bewonder een prachtig panoramisch uitzicht op het Vanoise National Park dankzij de gloednieuwe kabelbaan. Geniet van mountainbiken en wandelen op 2000 m hoogte."
    ],
    "es": [
      "Admire una magnífica vista panorámica del Parque Nacional de la Vanoise desde 650 m de altura gracias a la telecabina de 10 plazas. Disfrute del ciclismo de montaña y del senderismo a 2.000 m de altitud en verano."
    ]
  },
  "rdfs:label": {
