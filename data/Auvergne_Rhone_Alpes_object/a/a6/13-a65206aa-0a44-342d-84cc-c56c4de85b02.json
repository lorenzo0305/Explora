  "rdfs:comment": {
    "de": [
      "Das Restaurant, Bar und Eiscafé Le Sougey ist ein altes Gebäude mit Holzbalken und Steinmauern. Es bietet einen atemberaubenden Blick auf den See und den Berg L'Épine. Seine Terrasse bietet eine einzigartige Kulisse und eine ideale Lage nur wenige Meter vom Strand entfernt."
    ],
    "en": [
      "A renovated old barn with restaurant, boasting an impressive view of the lake, just a few meters from the beach. Le Sougey is a Casual Food Restaurant that combines simple, quality cuisine with relaxed service."
    ],
    "it": [
      "Antico edificio con travi a vista e pareti in pietra, il ristorante-bar-ghiacciaio Le Sougey vanta una vista ininterrotta sul lago e sulla Montagne de l'Épine. La sua terrazza offre un ambiente unico e una posizione ideale a pochi metri dalla spiaggia."
    ],
    "fr": [
      "Ancienne bâtisse avec poutres apparentes et murs de pierres, le restaurant-bar-glacier Le Sougey bénéficie d’une vue imprenable sur le lac et la montagne de l’Épine. Sa terrasse offre un décor unique et une situation idéale à quelques mètres de la plage."
    ],
    "nl": [
      "Restaurant-bar-glacier Le Sougey is een oud gebouw met zichtbare balken en stenen muren en biedt een ononderbroken uitzicht op het meer en de Montagne de l'Épine. Het terras biedt een unieke omgeving en een ideale locatie op slechts een paar meter van het strand."
    ],
    "es": [
      "El restaurante-bar-glaciar Le Sougey, un antiguo edificio con vigas a la vista y paredes de piedra, goza de vistas ininterrumpidas al lago y a la Montaña de l'Épine. Su terraza ofrece un marco único y una ubicación ideal a pocos metros de la playa."
    ]
  },
  "rdfs:label": {
    "en": [
