  "rdfs:comment": {
    "de": [
      "Auf dem Gelände des Diözesanhauses von Valence, in einem hellen und freundlichen Raum, finden Sie zahlreiche Bücher, eine Kinderecke sowie die Presse."
    ],
    "en": [
      "On the site of the Valence diocesan house, in a bright, welcoming space, you'll find a wide range of books, a children's area and a press."
    ],
    "it": [
      "Nel sito della casa diocesana di Valence, in uno spazio luminoso e accogliente, troverete molti libri, un'area per bambini e la stampa."
    ],
    "fr": [
      "Sur le site de la maison diocésaine de Valence, dans un espace lumineux et chaleureux, vous y trouverez de nombreux ouvrages, un espace enfants, ainsi que la presse."
    ],
    "nl": [
      "Op de site van het bisschoppelijk centrum van Valence vind je in een lichte en gezellige ruimte een ruim aanbod aan boeken, een ruimte voor kinderen en de pers."
    ],
    "es": [
      "En el recinto de la casa diocesana de Valence, en un espacio luminoso y cálido, encontrará numerosos libros, un espacio para niños, así como la prensa."
    ]
  },
  "rdfs:label": {
