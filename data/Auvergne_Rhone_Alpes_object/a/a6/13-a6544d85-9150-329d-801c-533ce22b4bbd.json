  "rdfs:comment": {
    "de": [
      "2. Ausgabe des Frühlingskarnevals: ein vereinsübergreifendes, familiäres, festliches und farbenfrohes Ereignis! Kostümierter Umzug durch das Dorf mit Carmentran und zu den Klängen der Batucada. Kinderboom und DJ-Abend. Getränke und Speisen vor Ort."
    ],
    "en": [
      "2nd Spring Carnival: an inter-associative, family-friendly, festive and colorful event! Costume parade through the village with Carmentran and the batucada. Children's Boom and DJ night. Refreshments and catering on site."
    ],
    "it": [
      "2° Carnevale di Primavera: un evento interassociativo, familiare, festoso e colorato! Sfilata in costume per il paese con Carmentran e al suono della batucada. Boom per bambini e serata DJ. Ristoro e ristorazione in loco."
    ],
    "fr": [
      "2ème édition du Carnaval de Printemps : évènement inter-associatif, familial, festif et coloré! Défilé costumé dans le village avec Carmentran et au son de la batucada. Boom des enfants et soirée DJ. Buvette et restauration sur place."
    ],
    "nl": [
      "2e Lentecarnaval: een gezellig, gezinsvriendelijk, feestelijk en kleurrijk evenement! Verkleedoptocht door het dorp met Carmentran en op de klanken van de batucada. Kinderboom en DJ-avond. Versnaperingen en catering ter plaatse."
    ],
    "es": [
      "2º Carnaval de Primavera: ¡un acontecimiento interasociativo, familiar, festivo y lleno de color! Desfile de disfraces por el pueblo con Carmentran y al son de la batucada. Boom infantil y noche de DJ. Refrescos y catering in situ."
    ]
  },
