  "rdfs:comment": {
    "de": [
      "Ideal gelegen, 15 Minuten von Issoire entfernt, finden Sie vom Espace VTT n°1 aus zahlreiche markierte Strecken. Vor Ort können Sie Mountainbikes, Elektroroller und Helme mieten. Die Mountainbikes und Helme sind ab 8 Jahren erhältlich."
    ],
    "en": [
      "Ideally located 15 minutes from Issoire, Espace VTT n°1 offers a wide range of marked trails. On-site rental of VAE mountain bikes, electric scooters and helmets. Mountain bikes and helmets are available from age 8."
    ],
    "it": [
      "Situato in posizione ideale a 15 minuti da Issoire, l'Espace VTT n°1 offre un'ampia gamma di percorsi segnalati. È possibile noleggiare mountain bike, scooter elettrici e caschi in loco. Mountain bike e caschi sono disponibili a partire dagli 8 anni."
    ],
    "fr": [
      "Idéalement placé à 15 mn d'Issoire, vous trouverez au départ d'espace VTT n°1 de nombreux circuits balisés. Sur place, location de VTT VAE, trottinette électrique  et casques. Les VTT et casques sont disponibles à partir de 8 ans."
    ],
    "es": [
      "Idealmente situado a 15 minutos de Issoire, el Espace VTT n°1 ofrece una amplia gama de senderos señalizados. Puede alquilar bicicletas de montaña, patinetes eléctricos y cascos in situ. Las bicicletas de montaña y los cascos están disponibles a partir de los 8 años."
    ],
    "nl": [
      "Espace VTT n°1 is ideaal gelegen op 15 minuten van Issoire en biedt een breed scala aan bewegwijzerde routes. Je kunt ter plaatse mountainbikes, elektrische scooters en helmen huren. Mountainbikes en helmen zijn beschikbaar vanaf 8 jaar."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Location de VTT - Espace VTT n°1"
    ]
  },
