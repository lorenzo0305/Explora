  "rdfs:comment": {
    "de": [
      "Burger-Restaurant im Haus der Engländer gelegen. Hausgemachtes Brot, Fleisch aus der Region und vom Charolais-Rind, hausgemachte Pommes frites. Das Wichtigste für uns ist der Geschmack!"
    ],
    "en": [
      "Burger restaurant located in the Maison des Anglais. Homemade bread, local and Charolais meats, homemade fries. For us, taste is everything!"
    ],
    "it": [
      "Ristorante di hamburger situato nella Maison des Anglais. Pane fatto in casa, carne locale e Charolais, patatine fritte fatte in casa. Per noi il gusto è tutto!"
    ],
    "fr": [
      "Restaurant de burger situé dans la maison des Anglais. Pain maison, viande locale et charolaise, frites maison. L'important pour nous, c'est le goût !"
    ],
    "es": [
      "Hamburguesería situada en la Maison des Anglais. Pan casero, carne local y de Charolais, patatas fritas caseras. Para nosotros, ¡el sabor lo es todo!"
    ],
    "nl": [
      "Burgerrestaurant in het Maison des Anglais. Zelfgebakken brood, lokaal en Charolais-vlees, zelfgemaakte frietjes. Voor ons is smaak alles!"
    ]
  },
