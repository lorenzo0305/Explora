  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/a3b4b5a9-3c1a-368c-a918-1cebab72c336",
      "dc:description": {
        "de": [
          "Ob allein oder zu zweit, lernen Sie mit Loïc und Ursula vom Verein Kizomba Lens Kizomba zu tanzen. Ein fröhlicher, festlicher und sonniger Tanz, der gemeinhin als afrikanischer Tango bezeichnet wird."
        ],
        "en": [
          "Alone or in pairs, learn to dance kizomba with Loïc and Ursula from the Kizomba Lens association. A joyful, festive, sunny dance, commonly known as African tango."
        ],
        "it": [
          "Da soli o in coppia, imparate a ballare la kizomba con Loïc e Ursula dell'associazione Kizomba Lens. Una danza gioiosa, festosa e solare, comunemente conosciuta come tango africano."
        ],
        "fr": [
          "Seul ou à deux, apprenez à danser la kizomba avec Loïc et Ursula de l’association Kizomba Lens. Une danse joyeuse, festive, solaire, communément appelée Tango africain."
        ],
        "es": [
          "Solo o en pareja, aprenda a bailar kizomba con Loïc y Ursula, de la asociación Kizomba Lens. Una danza alegre, festiva y soleada, comúnmente conocida como el tango africano."
        ],
        "nl": [
          "Leer alleen of met z'n tweeën kizomba dansen met Loïc en Ursula van de vereniging Kizomba Lens. Een vrolijke, feestelijke, zonnige dans, beter bekend als de Afrikaanse tango."
        ]
      },
