  "rdfs:comment": {
    "de": [
      "Jeden Donnerstagabend bietet das Opus Café abwechslungsreiche Musikabende an! Offene Bühne, akustisches B?uf, musikalische Lesung und trendiges musikalisches B?uf. Gesellige Atmosphäre garantiert."
    ],
    "en": [
      "Every Thursday evening, Opus Café offers a variety of musical evenings! Open stage, acoustic beef, musical readings and trendy musical beef. A friendly atmosphere guaranteed."
    ],
    "it": [
      "Ogni giovedì sera, l'Opus Café propone una serie di serate musicali! Palco aperto, ritmi acustici, letture musicali e ritmi musicali di tendenza. Un'atmosfera amichevole garantita."
    ],
    "fr": [
      "Tous les jeudis soir, l'Opus Café vous propose des soirées musicales variées ! Scène ouverte, bœuf acoustique, lecture musicale et bœuf musical branché. Ambiance conviviale garantie."
    ],
    "es": [
      "Todos los jueves por la noche, Opus Café ofrece diversas veladas musicales Escenario abierto, ritmos acústicos, lecturas musicales y ritmos musicales de moda. Ambiente agradable garantizado."
    ],
    "nl": [
      "Elke donderdagavond biedt Opus Café verschillende muziekavonden! Open podium, akoestische beats, muzieklezingen en hippe muziekbeats. Een gezellige sfeer gegarandeerd."
    ]
  },
