  "rdfs:comment": {
    "de": [
      "LMDES ist ein Verein, der sich für die Rechte von Menschen mit Behinderungen einsetzt und sich an der Entwicklung von Maßnahmen zugunsten von Strukturen für Menschen mit Behinderungen beteiligt."
    ],
    "en": [
      "LMDES is an association that defends the rights of people with disabilities and participates in the development of actions in favor of structures for people with disabilities."
    ],
    "it": [
      "LMDES è un'associazione che difende i diritti delle persone con disabilità e partecipa allo sviluppo di azioni a favore di strutture per persone con disabilità."
    ],
    "fr": [
      "LMDES est une association qui défend les droits des personnes en situation d'handicap et participe au développement des actions en faveur de structure pour les personnes en situation de handicap."
    ],
    "nl": [
      "LMDES is een vereniging die de rechten van mensen met een handicap verdedigt en deelneemt aan de ontwikkeling van acties ten gunste van structuren voor mensen met een handicap."
    ],
    "es": [
      "LMDES es una asociación que defiende los derechos de las personas con discapacidad y participa en el desarrollo de acciones en favor de estructuras para personas con discapacidad."
    ]
  },
