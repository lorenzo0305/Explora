  "rdfs:comment": {
    "de": [
      "Restaurierung aller alten Uhren. Herstellung\r\nhandarbeit aller fehlenden oder zerbrochenen Uhrenteile. Vollständige Garantie auf alle Restaurationen. Kunden in ganz Frankreich und 17 weiteren Ländern."
    ],
    "en": [
      "Restoration of all antique clocks and watches. Manufacture\r\nof all missing or broken timepieces. Full warranty on all restorations. Customers throughout France and 17 other countries."
    ],
    "it": [
      "Restauro di tutti gli orologi antichi. Fabbricazione\r\ndi tutti gli orologi mancanti o rotti. Garanzia totale su tutti i restauri. Clienti in tutta la Francia e in altri 17 paesi."
    ],
    "fr": [
      "Restauration de toutes horlogeries anciennes. Fabrication\r\nà la main de toutes pièces d’horlogerie manquantes ou cassées. Garantie totale de toutes restaurations. Clients dans toute la France et 17 pays."
    ],
    "nl": [
      "Restauratie van alle antieke klokken en horloges. Vervaardiging\r\nvan alle ontbrekende of kapotte uurwerken. Volledige garantie op alle restauraties. Klanten in heel Frankrijk en 17 andere landen."
    ],
    "es": [
      "Restauración de todos los relojes antiguos. Fabricación\r\nde todos los relojes perdidos o rotos. Garantía total en todas las restauraciones. Clientes en toda Francia y en otros 17 países."
    ]
  },
