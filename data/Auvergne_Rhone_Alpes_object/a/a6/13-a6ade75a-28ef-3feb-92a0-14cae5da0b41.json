  "rdfs:comment": {
    "de": [
      "Ein vollständig gesicherter Freizeitpark in freier Natur, der ab 2 Jahren zugänglich ist, in einem Kiefernwald im Herzen der Margeride."
    ],
    "en": [
      "A fully secured outdoor leisure park, accessible from the age of 2, in a pine forest in the heart of the Margeride."
    ],
    "it": [
      "Un parco divertimenti all'aperto completamente sicuro, accessibile a partire dai 2 anni, in una pineta nel cuore della Margeride."
    ],
    "fr": [
      "Un parc de loisirs de pleine nature entièrement sécurisé, accessible dès l’âge de 2 ans, dans une pinède au cœur de la Margeride."
    ],
    "es": [
      "Un parque de ocio al aire libre totalmente seguro, accesible a partir de los 2 años, en un pinar en el corazón de la Margeride."
    ],
    "nl": [
      "Een volledig beveiligd outdoor recreatiepark, toegankelijk vanaf 2 jaar, in een dennenbos in het hart van de Margeride."
    ]
