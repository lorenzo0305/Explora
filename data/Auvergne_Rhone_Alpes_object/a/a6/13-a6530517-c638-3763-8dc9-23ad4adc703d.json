  "rdfs:comment": {
    "de": [
      "Demonstrationsküche, die in einem modernen Design und in geselligem Ambiente rund um eine Kücheninsel angeboten wird, an der die Küchenchefs vor den Augen der Gäste ihre Gerichte zubereiten."
    ],
    "en": [
      "Chef Patrick Henriroux offers you instinctive and elegant market cuisine. He works with local products, bringing out the very best of them right before your eyes in his open-plan kitchen, and then adds a touch of creativity, producing a result that really hits the mark!"
    ],
    "it": [
      "Cucina dimostrativa in un ambiente design, contemporaneo e conviviale, allestito attorno a un'isola centrale presso cui i cuochi operano sotto gli occhi dei commensali."
    ],
    "fr": [
      "Second restaurant du chef Patrick Henriroux, plongez dans un décor singulier et privilégié empreint de quiétude, signé Régis Dho, créateur et designer d’espaces. \r\nDes couleurs vives et une déclinaison de verts, une moquette inédite et originale."
    ],
    "es": [
      "Cocina demostrativa en un marco de diseño contemporáneo y acogedor, organizado en torno a una isla de cocina, donde los chefs trabajan ante los comensales."
    ],
    "nl": [
      "Als tweede restaurant van chef-kok Patrick Henriroux wordt u ondergedompeld in een bijzonder, bevoorrecht decor vol rust, ontworpen door Régis Dho, ontwerper en ontwerper van ruimtes.\r\nHeldere kleuren en groentinten, met een nieuw en origineel tapijt."
    ]
  },
