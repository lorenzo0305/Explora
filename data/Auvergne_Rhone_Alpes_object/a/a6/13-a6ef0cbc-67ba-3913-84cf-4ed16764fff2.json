  "rdfs:comment": {
    "de": [
      "Freeride ist Teil der DNA von La Rosière. Bewundern Sie die besten Freerider der Gegenwart, wie sie die Nordwand des Mont Valaisan auf der Suche nach ihrem Ticket für die Freeride World Tour herausfordern."
    ],
    "en": [
      "Freeriding is part of La Rosière's DNA. Come and admire the best freeriders of the moment as they challenge the North Face of Mont Valaisan, in pursuit of their ticket to the Freeride World Tour."
    ],
    "it": [
      "Il freeride fa parte del DNA di La Rosière. Venite a vedere i migliori freerider del momento sfidare la parete nord del Monte Valaisan alla ricerca di un posto nel Freeride World Tour."
    ],
    "fr": [
      "Le freeride fait partie de l'ADN de La Rosière. Venez admirer les meilleurs freeriders du moment défier la Face nord du Mont Valaisan, dans la quête de leur sésame pour le Freeride World Tour."
    ],
    "nl": [
      "Freeride maakt deel uit van het DNA van La Rosière. Kom kijken hoe de beste freeriders van het moment de noordwand van de Mont Valaisan uitdagen in hun zoektocht naar een plaats in de Freeride World Tour."
    ],
    "es": [
      "El freeride forma parte del ADN de La Rosière. Venga a ver a los mejores freeriders del momento desafiar la cara norte del Mont Valaisan en su búsqueda de una plaza en el Freeride World Tour."
    ]
  },
