    "de": [
      "Restaurant auf dem Plateau von Montfrais, das im Sommer kostenlos mit Fußgängern und Mountainbikes über die Seilbahn und den Telemixte von Clos Giraud erreichbar ist"
    ],
    "en": [
      "Restaurant located on the Montfrais plateau, accessible free of charge by foot and mountain bike during the summer period by the Clos Giraud cable car and telemixte"
    ],
    "it": [
      "Ristorante situato sull'altopiano di Montfrais, accessibile gratuitamente a piedi e in mountain bike durante i mesi estivi tramite la funivia del Clos Giraud e il telemixte"
    ],
    "fr": [
      "Restaurant situé sur le plateau de Montfrais, accessible gratuitement en piéton et VTT pendant la période estivale par le téléphérique et le télémixte de Clos Giraud"
    ],
    "es": [
      "Restaurante situado en la meseta de Montfrais, accesible gratuitamente a pie y en bicicleta de montaña durante los meses de verano a través del teleférico y el telemixto de Clos Giraud"
    ],
    "nl": [
      "Restaurant gelegen op het Montfraisplateau, gratis toegankelijk te voet en met de mountainbike in de zomerperiode via de Clos Giraud-kabelbaan en telemixte"
