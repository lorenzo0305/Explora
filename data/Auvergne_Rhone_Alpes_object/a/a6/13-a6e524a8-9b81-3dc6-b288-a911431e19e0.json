  "rdfs:comment": {
    "de": [
      "Wir bieten begleitete Ausritte von ein bis zwei Stunden Dauer auf den Wegen der Region an. Wanderungen nur für Stammgäste oder Reiter, die alle drei Gangarten beherrschen."
    ],
    "en": [
      "We offer guided rides of one or two hours on the paths of the region. These rides are reserved for regular riders or riders who know the 3 paces."
    ],
    "it": [
      "Offriamo escursioni guidate di una o due ore sui sentieri della regione. Queste corse sono riservate ai corridori abituali o a quelli che conoscono i 3 passi."
    ],
    "fr": [
      "Nous proposons des randonnées accompagnées d'une ou deux heures sur les chemins de la région. Randonnées réservées aux habitués ou aux cavaliers connaissant les 3 allures."
    ],
    "nl": [
      "Wij bieden begeleide tochten van één of twee uur over de paden van de regio. Deze ritten zijn gereserveerd voor regelmatige renners of renners die de 3 tempo's kennen."
    ],
    "es": [
      "Ofrecemos paseos guiados de una o dos horas por los senderos de la región. Estos paseos están reservados a los jinetes regulares o a los jinetes que conocen los 3 pasos."
    ]
  },
  "rdfs:label": {
