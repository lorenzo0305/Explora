  "rdfs:comment": {
    "de": [
      "Der Pump Track ist ein für alle zugängliches Sportgerät, das für BMX, Mountainbikes, Skateboards, Roller oder Inlineskates konzipiert wurde.\r\nEs gibt drei Strecken mit unterschiedlichen Schwierigkeitsgraden, die sowohl für Anfänger als auch für Fortgeschrittene geeignet sind"
    ],
    "en": [
      "The Pump track, a sport equipment accessible to everyone, conceived for the practice of BMX, Moutain bike, Skate, roller.\r\nIt included 3 ways of different levels, adapted from beginners to experienced bikers."
    ],
    "it": [
      "Il Pump track, un'attrezzatura sportiva accessibile ad ognuno, realizzata  per la pratica del BMX, Moutain bike, skate, roller, scooter.\r\nInclude 3 piste di diversi livelli, adattati ai novici fino a praticanti esperimentati."
    ],
    "fr": [
      "Le Pump Track, un équipement sportif accessible à tous, conçu pour la pratique du BMX, VTT, skate, trottinette ou roller. \r\nIl comprend 3 pistes de niveaux différents, adaptées aussi bien aux débutants qu’aux pratiquants expérimentés"
    ],
    "es": [
      "El Pump Track es una instalación deportiva abierta a todos, diseñada para BMX, bicicleta de montaña, monopatín, patinete y patinaje en línea.\r\nCuenta con 3 pistas de diferentes niveles, aptas tanto para principiantes como para ciclistas experimentados"
    ],
    "nl": [
      "De Pump Track is een sportfaciliteit die voor iedereen toegankelijk is, ontworpen voor BMX, mountainbiken, skateboarden, steppen en inline skaten.\r\nHet heeft 3 banen op verschillende niveaus, geschikt voor zowel beginners als ervaren rijders"
    ]
  },
