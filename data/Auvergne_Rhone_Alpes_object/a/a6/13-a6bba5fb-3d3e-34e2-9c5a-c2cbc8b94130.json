  "rdfs:comment": {
    "de": [
      "Die Thermen von Allevard-les-Bains liegen im Herzen der Belledonne-Kette in den französischen Alpen und genießen eine intakte Umwelt und ein privilegiertes Klima, die für Entspannung und Erholung sorgen."
    ],
    "en": [
      "Situated in the heart of the Belledonne mountain range in the French Alps, the Thermes d'Allevard-les-Bains thermal baths boast an unspoilt environment and a unique climate, ideal for relaxation."
    ],
    "it": [
      "Situate nel cuore della catena montuosa di Belledonne, nelle Alpi francesi, le terme di Allevard-les-Bains godono di un ambiente preservato e di un clima privilegiato che favorisce il relax."
    ],
    "fr": [
      "Situés au cœur de la chaîne de Belledonne, dans les Alpes françaises, les Thermes d’Allevard-les-Bains jouissent d’un environnement préservé et d’un climat privilégié propices à la détente et à la relaxation."
    ],
    "es": [
      "Situadas en el corazón de la cordillera de Belledonne, en los Alpes franceses, las termas de Allevard-les-Bains gozan de un entorno preservado y un clima privilegiado propicio para la relajación."
    ],
    "nl": [
      "De Thermen van Allevard-les-Bains, gelegen in het hart van het Belledonne-gebergte in de Franse Alpen, bieden een ongerepte omgeving en een bevoorrecht klimaat, ideaal voor ontspanning."
    ]
  },
