  "rdfs:comment": {
    "de": [
      "Restaurant, Coffeeshop und Konditoreien. Lokale und hausgemachte Bio-Küche. Café, Coworking mit Internetanschluss und Drucker."
    ],
    "en": [
      "Come and discover “la Maison bleue “ : a colourful coffee shop and tea house in Lablachère. Stephanie will give you a warm\r\nwelcome in this renovated cellar where you can find eclectic objects and local art . Try the range of home-made cakes , and taste the local- and organic cooking food with towering plates of gluten-free and vegan options . Open all the year , you will enjoy the warmness of this cosy place ."
    ],
    "it": [
      "Ristorante, caffetteria e pasticceria. Cucina biologica locale e casalinga. Caffè, coworking con connessione internet e stampante."
    ],
    "fr": [
      "Restaurant, coffee shop et pâtisseries. Cuisine bio locale et faite maison. Café, coworking avec connexion internet et imprimante."
    ],
    "es": [
      "Restaurante, cafetería y pastelerías. Cocina local, casera y ecológica. Cafetería, coworking con conexión a internet e impresora."
    ],
    "nl": [
      "Restaurant, koffiebar en patisserie. Lokale, huisgemaakte biologische keuken. Café, coworking met internetverbinding en printer."
    ]
  },
