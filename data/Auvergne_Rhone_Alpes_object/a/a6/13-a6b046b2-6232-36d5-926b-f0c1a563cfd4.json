  "rdfs:comment": {
    "de": [
      "Im Herzen der französischen Alpen, 8 km von Grenoble entfernt, genießt Uriage ein gemäßigtes Klima in einer grünen Umgebung, die von jeglicher Umweltverschmutzung verschont geblieben ist. Das Thermalzentrum bietet die bemerkenswerten Vorteile eines EINZIGARTIGEN WASSERS, das reich an Spurenelementen und Mineralien ist."
    ],
    "en": [
      "In the heart of the French Alps, 8km from Grenoble, Uriage benefits from a temperate climate in a green setting preserved from pollution. The Thermal Center offers the remarkable benefits of a UNIQUE WATER rich in trace elements and minerals."
    ],
    "it": [
      "Nel cuore delle Alpi francesi, a 8 km da Grenoble, Uriage gode di un clima temperato in un ambiente verde e al riparo da ogni inquinamento. La spa offre i notevoli benefici di un'ACQUA UNICA ricca di oligoelementi e minerali."
    ],
    "fr": [
      "Au cœur des Alpes françaises, à 8km de Grenoble, Uriage bénéficie d'un climat tempéré dans un cadre verdoyant et préservé de toute pollution. Le centre Thermal offre les bienfaits remarquables d'une EAU UNIQUE riche en oligo-éléments et en minéraux."
    ],
    "nl": [
      "In het hart van de Franse Alpen, op 8 km van Grenoble, geniet Uriage van een gematigd klimaat in een weelderige omgeving zonder vervuiling. De spa biedt de opmerkelijke voordelen van een UNIEK WATER dat rijk is aan sporenelementen en mineralen."
    ],
    "es": [
      "En el corazón de los Alpes franceses, a 8 km de Grenoble, Uriage se beneficia de un clima templado en un entorno verde preservado de toda contaminación. El balneario ofrece los notables beneficios de un AGUA ÚNICA rica en oligoelementos y minerales."
    ]
  },
  "rdfs:label": {
