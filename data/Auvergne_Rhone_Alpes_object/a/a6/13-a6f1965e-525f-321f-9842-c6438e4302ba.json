  "rdfs:comment": {
    "de": [
      "Es liegt uns am Herzen, mit sorgfältig ausgewählten, lokalen Erzeugern zusammenzuarbeiten. Wir achten auf das Produkt und die Qualität, halten uns an die Jahreszeiten und verarbeiten die Produkte nur wenig."
    ],
    "en": [
      "We are committed to working with carefully selected local producers and local produce. We pay close attention to the product and its quality, respecting the seasons and processing the products as little as possible."
    ],
    "it": [
      "Ci impegniamo a lavorare con produttori locali e prodotti locali accuratamente selezionati. Prestiamo molta attenzione al prodotto e alla sua qualità, rispettando le stagioni e lavorando i prodotti il meno possibile."
    ],
    "fr": [
      "Nous avons à cœur de travailler avec des producteurs locaux, sélectionnés avec soin, et des produits du terroir. Soucieux du produit, de la qualité, nous respectons les saisons et transformons peu les produits."
    ],
    "nl": [
      "We werken met zorgvuldig geselecteerde lokale producenten en lokale producten. We besteden veel aandacht aan het product en de kwaliteit ervan, respecteren de seizoenen en verwerken de producten zo min mogelijk."
    ],
    "es": [
      "Nos comprometemos a trabajar con productores y productos locales cuidadosamente seleccionados. Prestamos mucha atención al producto y a su calidad, respetando las temporadas y procesando los productos lo menos posible."
    ]
  },
  "rdfs:label": {
    "fr": [
