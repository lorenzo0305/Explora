  "rdfs:comment": {
    "de": [
      "Entdecken Sie Ô'Soi, das Familien-Spa in Aussois. Entscheiden Sie sich für Momente, die dem Wohlbefinden gewidmet sind, mit einem atemberaubenden Blick auf die umliegenden Bergmassive. Reservierung per Telefon."
    ],
    "en": [
      "Discover Ô'Soi, the family spa in Aussois. Opt for moments dedicated to well-being with a breathtaking view of the surrounding mountains. Reservations by phone."
    ],
    "it": [
      "Scoprite Ô'Soi, la spa familiare di Aussois. Concedetevi momenti di benessere con una vista mozzafiato sulle montagne circostanti. Prenota per telefono."
    ],
    "fr": [
      "Découvrez Ô'Soi, le spa familial à Aussois. Optez pour des moments dédiés au bien-être avec une vue imprenable sur les massifs environnants. Réservation par téléphone."
    ],
    "nl": [
      "Ontdek Ô'Soi, de familiale spa in Aussois. Trakteer uzelf op momenten van welzijn met een adembenemend uitzicht op de omringende bergen. Reserveer per telefoon."
    ],
    "es": [
      "Descubra Ô'Soi, el spa familiar de Aussois. Regálese momentos de bienestar con una vista impresionante de las montañas circundantes. Reserve por teléfono."
    ]
  },
  "rdfs:label": {
    "en": [
