  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/90bb7f33-0ddb-313b-ac14-146926530ae0",
      "dc:description": {
        "de": [
          "Kleiner Lebensmittelladen mit italienischen Produkten (Bier, Wein, Grissini...)\nVerkauf nur zum Mitnehmen und auch Pizzas, die im Holzofen gebacken und mit frischen Produkten belegt werden.\nÖffnungszeiten: 11:30 bis 22:00 Uhr (im Juli und August) von Montag bis Sonntag"
        ],
        "en": [
          "Small grocery store selling Italian products (beer, wine, breadsticks, etc.)\nTakeaway only and also wood-fired pizzas topped with fresh produce.\nOpening hours: 11:30 a.m. to 10 p.m. (July and August) Monday to Sunday"
        ],
        "it": [
          "Piccolo negozio di alimentari con prodotti italiani (birra, vino, grissini, ecc.)\nSolo da asporto e anche pizze cotte a legna e condite con prodotti freschi.\nOrari di apertura: dalle 11.30 alle 22.00 (luglio e agosto) dal lunedì alla domenica"
        ],
        "fr": [
          "Petite épicerie de produits italien (bière, vin, gressin...)\nVente à emporter uniquement et également pizzas cuites au feu de bois, garnies de produits frais.\nHoraires d'ouverture : 11h30 à 22h (en juillet et août) du lundi au dimanche"
        ],
        "es": [
          "Pequeña tienda de comestibles que vende productos italianos (cerveza, vino, grisines, etc.)\nSólo para llevar y también pizzas al horno de leña con productos frescos.\nHorario: de 11.30 a 22.00 (julio y agosto), de lunes a domingo"
        ],
        "nl": [
          "Kleine kruidenierszaak die Italiaanse producten verkoopt (bier, wijn, broodstengels, enz.)\nAlleen afhaalmaaltijden en ook houtovenpizza's met verse producten.\nOpeningstijden: 11.30 tot 22.00 uur (juli en augustus) van maandag tot zondag"
        ]
      },
      "@type": [
        "Description"
      ],
