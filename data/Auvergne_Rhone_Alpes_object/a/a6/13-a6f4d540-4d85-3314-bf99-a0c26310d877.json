  "rdfs:comment": {
    "de": [
      "Village de Varennes-Saint-Honorat: Kirche mittelalterlichen Ursprungs. Der Glockenturm wurde 1841 erbaut. Kirchenfenster mit der Darstellung von Saint-Honorat, dem Schutzheiligen der Winzer."
    ],
    "en": [
      "Village of Varennes-Saint-Honorat: Church of medieval origin. Bell tower built in 1841. Stained glass window depicting Saint-Honorat, patron saint of winegrowers."
    ],
    "it": [
      "Villaggio di Varennes-Saint-Honorat: chiesa di origine medievale. Campanile costruito nel 1841. Vetrata raffigurante Saint-Honorat, patrono dei viticoltori."
    ],
    "fr": [
      "Village de Varennes-Saint-Honorat : Église d’origine médiévale. Clocher construit en 1841. Vitrail représentant Saint-Honorat, saint patron des vignerons."
    ],
    "es": [
      "Pueblo de Varennes-Saint-Honorat: Iglesia de origen medieval. Campanario construido en 1841. Vidriera que representa a Saint-Honorat, patrón de los viticultores."
    ],
    "nl": [
      "Dorp Varennes-Saint-Honorat: Kerk van middeleeuwse oorsprong. Klokkentoren gebouwd in 1841. Gebrandschilderd raam dat Saint-Honorat voorstelt, beschermheilige van de wijnbouwers."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Village | Varennes-Saint-Honorat"
    ]
  },
