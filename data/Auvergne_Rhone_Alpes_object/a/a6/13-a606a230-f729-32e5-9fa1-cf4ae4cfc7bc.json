  "rdfs:comment": {
    "de": [
      "Camille, die Küchenchefin, wurde von Eltern geboren, die seit zwei Generationen im Gaststättengewerbe tätig sind. Sie wird Sie in ihre Welt der traditionellen und kreativen Küche entführen.\r\nDie Gerichte werden hausgemacht und bestehen hauptsächlich aus lokalen Produkten."
    ],
    "en": [
      "Camille the chef, born of parents who have been restaurateurs for 2 generations, will introduce you to her world of traditional and creative cuisine.\r\nDishes are home-cooked and mainly based on local produce."
    ],
    "it": [
      "Camille, la chef, i cui genitori sono ristoratori da due generazioni, vi introdurrà nel suo mondo di cucina tradizionale e creativa.\r\nI piatti sono fatti in casa e si basano principalmente su prodotti locali."
    ],
    "fr": [
      "Camille la cheffe, née de parents restaurateurs depuis 2 générations vous fera découvrir son univers composé d’une cuisine traditionnelle et créative.\r\nLes plats sont cuisinés maison et sont essentiellement à base de produits locaux."
    ],
    "es": [
      "La chef Camille, cuyos padres han sido propietarios de restaurantes durante 2 generaciones, le introducirá en su mundo de cocina tradicional y creativa.\r\nLos platos son caseros y se basan principalmente en productos locales."
    ],
    "nl": [
      "Camille de chef, wiens ouders al 2 generaties restauranthouders zijn, zal je introduceren in haar wereld van traditionele en creatieve gerechten.\r\nDe gerechten zijn huisgemaakt en voornamelijk gebaseerd op lokale producten."
    ]
  },
