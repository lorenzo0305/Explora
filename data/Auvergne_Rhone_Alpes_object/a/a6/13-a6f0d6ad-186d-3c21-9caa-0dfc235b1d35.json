  "rdfs:comment": {
    "de": [
      "Willkommen im Relais Cyné in Faverges de la Tour. Wir freuen uns, Sie bei einem Picknick oder einer Biwaketappe begrüßen zu dürfen. Bitte kontaktieren Sie uns vor Ihrer Ankunft, damit wir Ihnen das Lokal öffnen können."
    ],
    "en": [
      "Welcome to Relais Cyné de Faverges de la Tour. We'd be delighted to welcome you for a picnic or a bivouac. Please contact us before you arrive so that we can open the premises for you."
    ],
    "it": [
      "Benvenuti al Relais Cyné a Faverges de la Tour. Saremo lieti di accogliervi per un picnic o un bivacco. Vi preghiamo di contattarci prima del vostro arrivo in modo che possiamo venire ad aprire i locali per voi."
    ],
    "fr": [
      "Bienvenue au Relais Cyné de Faverges de la Tour. Nous pouvons vous accueillons avec joie le temps d'un pique nique ou pour une étape en bivouac. Pensez bien à nous contacter préalablement à votre arrivée que l'on puisse venir vous ouvrir le local."
    ],
    "nl": [
      "Welkom bij Relais Cyné in Faverges de la Tour. We verwelkomen je graag voor een picknick of een bivak. Neem van tevoren contact met ons op zodat we het terrein voor je kunnen openen."
    ],
    "es": [
      "Bienvenido al Relais Cyné en Faverges de la Tour. Estaremos encantados de recibirle para un picnic o un vivac. Póngase en contacto con nosotros antes de su llegada para que podamos ir a abrirle las instalaciones."
    ]
  },
