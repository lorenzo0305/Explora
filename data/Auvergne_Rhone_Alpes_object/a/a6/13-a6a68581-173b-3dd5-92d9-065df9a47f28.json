  "rdfs:comment": {
    "de": [
      "Agnès und Hervé bieten Ihnen Sommerobst und -gemüse an (Kirsche, Aprikose, Pfirsich, Tomate,... Zucchini, Salat,...). Schwarze Oliven und Olivenöl werden ebenfalls auf dem Bauernhof produziert."
    ],
    "en": [
      "Agnès and Hervé offer summer fruit and vegetables (cherries, apricots, peaches, tomatoes, zucchinis, lettuce, etc.). Black olives and olive oil are also produced on the farm."
    ],
    "it": [
      "Agnès e Hervé vi propongono frutta e verdura estiva (ciliegie, albicocche, pesche, pomodori, zucchine, insalata,...). In azienda si producono anche olive nere e olio d'oliva."
    ],
    "fr": [
      "Agnès et Hervé vous proposent des fruits et légumes d'été (cerise, abricot, pêche, tomate,... courgette, salade,...). Des olives noires et de l'huile d'olive sont également produits à la ferme."
    ],
    "es": [
      "Agnès y Hervé le ofrecen frutas y verduras de verano (cereza, albaricoque, melocotón, tomate,... calabacín, ensalada,...). En la finca también se producen aceitunas negras y aceite de oliva."
    ],
    "nl": [
      "Agnès en Hervé bieden zomerfruit en -groenten aan (kersen, abrikozen, perziken, tomaten, courgettes, sla, enz.). Op de boerderij worden ook zwarte olijven en olijfolie geproduceerd."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Domaine du Serre de la Casse"
    ]
  },
