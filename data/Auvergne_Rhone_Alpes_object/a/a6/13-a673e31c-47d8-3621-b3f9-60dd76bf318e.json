  "rdfs:comment": {
    "de": [
      "Croque & Nous ist ein fahrender Imbisswagen, der Ihnen verschiedene Croque-Monsieur-Rezepte anbietet.\r\nSeine Lieferanten sind lokale Handwerker, ein Garant für Qualität und Loyalität!"
    ],
    "en": [
      "Croque & Nous is a food truck that offers different recipes of croque-monsieur.\r\nIts suppliers are local craftsmen, a guarantee of quality and loyalty!"
    ],
    "it": [
      "Croque & Nous è un food truck che propone diverse ricette di croque-monsieur.\r\nI suoi fornitori sono artigiani locali, garanzia di qualità e fedeltà!"
    ],
    "fr": [
      "Croque & Nous est un food truck qui vous propose différentes recettes de croque-monsieur.\r\nSes fournisseurs sont des artisans locaux, gage de qualité et de fidélité !"
    ],
    "nl": [
      "Croque & Nous is een foodtruck die verschillende recepten van croque-monsieur aanbiedt.\r\nDe leveranciers zijn lokale ambachtslieden, een garantie voor kwaliteit en loyaliteit!"
    ],
    "es": [
      "Croque & Nous es un food truck que ofrece diferentes recetas de croque-monsieur.\r\nSus proveedores son artesanos locales, ¡una garantía de calidad y fidelidad!"
