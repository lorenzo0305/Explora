  "rdfs:comment": {
    "de": [
      "Kilitt, Änderungsschneiderei und Reparaturen, Maßanfertigungen.\r\nFranzösische Designerin von praktischen, farbenfrohen und ökologisch verantwortungsvollen Textilobjekten für Yoga, Musik und den Alltag\r\nMit Kunst- und Kunsthandwerksladen"
    ],
    "en": [
      "Kilitt, sewing alterations and repairs, made-to-measure creations.\r\nFrench designer of practical, colorful and eco-responsible textile objects for yoga, music and everyday life\r\nWith arts and crafts boutique"
    ],
    "it": [
      "Kilitt, modifiche e riparazioni di cucito, creazioni su misura.\r\nDesigner francese di oggetti tessili pratici, colorati ed eco-responsabili per lo yoga, la musica e la vita quotidiana\r\nCon boutique di artigianato artistico"
    ],
    "fr": [
      "Kilitt, retouches couture et réparations, créations sur mesure.\r\nCréatrice française d'objets textiles pratiques, colorés et éco-responsable pour le yoga, la musique et la vie quotidienne\r\nAvec boutique d'art et d'artisanat"
    ],
    "nl": [
      "Kilitt, naaiwerk en reparaties, creaties op maat.\r\nFranse ontwerper van praktische, kleurrijke en ecologisch verantwoorde textielobjecten voor yoga, muziek en het dagelijks leven\r\nMet kunstnijverheidsboetiek"
    ],
    "es": [
      "Kilitt, arreglos y reparaciones de costura, creaciones a medida.\r\nDiseñador francés de objetos textiles prácticos, coloridos y ecorresponsables para el yoga, la música y la vida cotidiana\r\nCon boutique de artesanía"
    ]
  },
