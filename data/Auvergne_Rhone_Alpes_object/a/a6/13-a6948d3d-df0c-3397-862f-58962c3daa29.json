  "rdfs:comment": {
    "de": [
      "10 Minuten von Die entfernt, in Richtung Col de Rousset, in einer ehemaligen Kirche, großer Saal mit Kamin, Terrasse und Parkplatz. Lokale und traditionelle Küche, Gerichte à la carte."
    ],
    "en": [
      "Just 10 minutes from Die, towards the Col de Rousset, in a former church, dish of the day and à la carte, bedrooms. Local and traditional cuisine, a la carte dishes."
    ],
    "it": [
      "A 10 minuti da Die, sulla strada per il Col de Rousset, in un'ex chiesa, ampia sala da pranzo con camino, terrazza e parcheggio. Cucina locale e tradizionale, piatti à la carte."
    ],
    "fr": [
      "A 10mn de Die, en direction du Col de Rousset, dans une ancienne église, grande salle avec cheminée, terrasse et parking. Cuisine locale et traditionnelle, plats à la carte."
    ],
    "nl": [
      "Op 10 km van Die, in de richting van Col de Rousset, in een oude kerk ligt, een grote zaal met open haard. Dagmenu en à la carte, kamers. Lokale en traditionele keuken, à la carte gerechten."
    ],
    "es": [
      "A 10 minutos de Die, camino del Col de Rousset, en una antigua iglesia, amplio comedor con chimenea, terraza y aparcamiento. Cocina local y tradicional, platos a la carta."
    ]
  },
