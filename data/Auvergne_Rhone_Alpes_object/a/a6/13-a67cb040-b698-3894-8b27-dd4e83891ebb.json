  "rdfs:comment": {
    "de": [
      "Genießen Sie den zeitlosen Charme eines savoyischen Bauernhauses und lassen Sie sich von der atemberaubenden Aussicht auf das Tal von Megève blenden. Eingebettet im Herzen des Mont d'Arbois genießt das Hotel eine außergewöhnliche Lage gegenüber den Skiliften des Mont d'Arbois."
    ],
    "en": [
      "Enjoy the timeless charm of a Savoyard farmhouse and marvel at the breathtaking views of the Megève valley. Nestled in the heart of Mont d'Arbois, the hotel enjoys an exceptional location opposite the Mont d'Arbois ski lifts."
    ],
    "it": [
      "Il fascino senza tempo di una casa colonica savoiarda. Lasciatevi abbagliare dalla vista mozzafiato su Megève e la sua valle. Situato nel cuore del Mont d'Arbois, l'hotel gode di una posizione eccezionale di fronte agli impianti di risalita e alle piste del Mont d'Arbois."
    ],
    "fr": [
      "Bénéficiez du charme intemporel d’une ferme savoyarde et laissez-vous éblouir par une vue imprenable sur la vallée de Megève. Niché au cœur du Mont d'Arbois, l’hôtel jouit d’une situation exceptionnelle en face des remontées mécaniques du Mont d'Arbois."
    ],
    "nl": [
      "Geniet van de tijdloze charme van een Savoyaardse boerderij en laat je verbluffen door het adembenemende uitzicht over de vallei van Megève. Het hotel ligt in het hart van Mont d'Arbois, op een uitzonderlijke locatie tegenover de skiliften van Mont d'Arbois."
    ],
    "es": [
      "Disfrute del encanto intemporal de una granja saboyana y déjese deslumbrar por las impresionantes vistas sobre el valle de Megève. Enclavado en el corazón del Mont d'Arbois, el hotel goza de una ubicación excepcional frente a los remontes del Mont d'Arbois."
    ]
  },
  "rdfs:label": {
    "en": [
      "Hôtel La Ferme du Golf"
    ],
    "it": [
      "Hotel La Ferme du Golf"
    ],
    "fr": [
      "Hôtel - Restaurant La Ferme du Golf"
    ]
  },
