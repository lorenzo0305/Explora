  "rdfs:comment": {
    "de": [
      "Nicht überdachter, nicht videoüberwachter Außen-Park-and-Ride-Parkplatz mit 98 Plätzen\r\nParken mit oder ohne Abonnement\r\nAn sieben Tagen in der Woche rund um die Uhr geöffnet\r\nKostenlos an Wochenenden und Feiertagen\r\nStückpreis: 30 min kostenlos, 0,20 Cent/15min"
    ],
    "en": [
      "Uncovered, non-video-monitored outdoor park-and-ride facility with 98 spaces\r\nParking with or without season ticket\r\nOpen 24/7\r\nFree on weekends and public holidays\r\nPiece rate: 30 min free, 0.20 cents/15min"
    ],
    "it": [
      "Parcheggio all'aperto, non videosorvegliato, con 98 posti auto\r\nParcheggio con o senza abbonamento\r\nAperto 24 ore su 24, 7 giorni su 7\r\nGratuito nei fine settimana e nei giorni festivi\r\nTariffa a pezzo: 30 minuti gratis, 0,20 centesimi/15 minuti"
    ],
    "fr": [
      "Parking relais extérieur non couvert, non vidéo-surveillé de 98 places\r\nStationnement avec ou sans abonnement\r\nOuvert 7j/7, 24/24\r\nGratuit les week-ends et jours fériés\r\nTarif à la pièce : 30 min gratuit, 0,20 cents/15min"
    ],
    "nl": [
      "Onoverdekte, niet-videobewaakte parkeer- en rijfaciliteit in de openlucht met 98 plaatsen\r\nParkeren met of zonder abonnement\r\n24/7 open\r\nGratis in het weekend en op feestdagen\r\nStuktarief: 30 minuten gratis, 0,20 cent/15 minuten"
    ],
    "es": [
      "Aparcamiento exterior descubierto, sin videovigilancia, con 98 plazas\r\nAparcamiento con o sin abono\r\nAbierto 24 horas al día, 7 días a la semana\r\nGratuito los fines de semana y festivos\r\nTarifa por pieza: 30 minutos gratis, 0,20 céntimos/15 minutos"
    ]
  },
