  "rdfs:comment": {
    "de": [
      "Dieses sensible Naturgebiet birgt einen wahren ökologischen, landschaftlichen und kulturellen Reichtum in einem geschützten Rahmen. Möglichkeit einer begleiteten und kommentierten Wanderung. Wegen des Höhenunterschieds sollten Sie gut beschuht sein."
    ],
    "en": [
      "This sensitive natural area contains a true ecological, landscape and cultural richness in a preserved setting. Possibility of guided hikes. It is essential to have good shoes."
    ],
    "it": [
      "Quest'area naturale sensibile contiene una vera e propria ricchezza ecologica, paesaggistica e culturale in un ambiente preservato. Possibilità di escursioni guidate e commentate. Siate ben equipaggiati a causa del dislivello."
    ],
    "fr": [
      "Cet espace naturel sensible renferme une véritable richesse écologique, paysagère et culturelle dans un écrin préservé. Possibilité de randonnée accompagnée et commentée. Etre bien chaussé car dénivelé."
    ],
    "es": [
      "Este sensible espacio natural contiene una verdadera riqueza ecológica, paisajística y cultural en un entorno preservado. Posibilidad de realizar caminatas guiadas y comentadas. Estar bien calzados debido a la diferencia de altitud."
    ],
    "nl": [
      "Dit kwetsbare natuurgebied bevat een echte ecologische, landschappelijke en culturele rijkdom in een beschermde omgeving. Mogelijkheid tot begeleide en becommentarieerde wandelingen. Wees goed geschoeid vanwege het hoogteverschil."
    ]
  },
