  "rdfs:comment": {
    "de": [
      "Angeln auf Karpfen in No-kill\r\nIm Herzen der Dombes können Sie eine exklusive Session an unserem Teich buchen, wo die großzügig bemessenen Karpfen jeden Angler begeistern werden."
    ],
    "en": [
      "No-kill carp fishing\r\nIn the heart of the Dombes region, book an exclusive session on our pond, where generously-sized carp will delight all anglers."
    ],
    "it": [
      "Pesca alla carpa no-kill\r\nNel cuore della regione di Dombes, prenotate una sessione esclusiva nel nostro laghetto, dove carpe di dimensioni generose faranno la gioia di tutti i pescatori."
    ],
    "fr": [
      "Pêche de la carpe en No-kill\r\nAu cœur de la Dombes, réservez pour une session en exclusivité sur notre étang où les carpes aux dimensions généreuses raviront tous les pêcheurs."
    ],
    "es": [
      "Pesca de carpas sin muerte\r\nEn el corazón de la región de Dombes, reserve una sesión exclusiva en nuestro estanque, donde carpas de tamaño generoso harán las delicias de todos los pescadores."
    ],
    "nl": [
      "No-kill karpervissen\r\nBoek in het hart van de Dombes een exclusieve sessie op onze vijver, waar karpers van royale afmetingen alle vissers zullen plezieren."
    ]
  },
  "rdfs:label": {
