  "rdfs:comment": {
    "de": [
      "Direkt neben dem Kinderspielplatz steht Ihnen ein Picknicktisch zur Verfügung.\r\nTennisplätze, Fußballplatz und Stadtpark sind in der Nähe."
    ],
    "en": [
      "Right next to the children's playground, a picnic table is available.\r\nThe tennis courts, the football field and the city park are nearby."
    ],
    "it": [
      "Accanto al parco giochi per bambini è disponibile un tavolo da picnic.\r\nI campi da tennis, da calcio e da cricket si trovano nelle vicinanze."
    ],
    "fr": [
      "Juste a côté de l'aire de jeux pour enfants une table de pique nique vous est mise à disposition. \r\nLes cours de tennis, le terrain de foot et le ctiy park sont à proximité."
    ],
    "es": [
      "Junto al parque infantil hay una mesa de picnic.\r\nLas pistas de tenis, el campo de fútbol y el parque de críquet están cerca."
    ],
    "nl": [
      "Direct naast de kinderspeelplaats staat een picknicktafel tot uw beschikking.\r\nTennisbanen, voetbalveld en ctiy-park zijn vlakbij."
    ]
  },
  "rdfs:label": {
