  "rdfs:comment": {
    "de": [
      "Unter dem beeindruckenden Glasdach mit seinen gedämpften Farben empfängt Sie jeden Abend das romantische Restaurant \"La Table du Clos des Vignes\". Genießen Sie die zauberhafte Umgebung für eine romantische Pause unter einem blühenden Kirschbaum."
    ],
    "en": [
      "Under the impressive glass roof with muted colours, the romantic restaurant \"la Table du Clos des Vignes\" welcomes you every evening. Enjoy a magical setting for a romantic break, under the cherry blossom tree."
    ],
    "it": [
      "Il romantico ristorante \"La Table du Clos des Vignes\" vi accoglie ogni sera sotto l'imponente tetto di vetro dai colori tenui. Godetevi l'ambiente magico per una pausa romantica sotto l'albero di ciliegio in fiore."
    ],
    "fr": [
      "Sous l’impressionnante verrière aux couleurs feutrées, le restaurant romantique « la Table du Clos des Vignes » vous accueille tous les soirs. Profitez d’un cadre magique pour une pause romantique, sous le cerisier en fleur."
    ],
    "nl": [
      "Onder het indrukwekkende glazen dak met zijn gedempte kleuren verwelkomt het romantische restaurant \"La Table du Clos des Vignes\" u elke avond. Profiteer van een magische omgeving voor een romantische pauze, onder de kersenbloesemboom."
    ],
    "es": [
      "El romántico restaurante \"La Table du Clos des Vignes\" le da la bienvenida cada noche bajo el impresionante techo de cristal de colores apagados. Disfrute de un entorno mágico para una escapada romántica bajo el cerezo en flor."
    ]
  },
  "rdfs:label": {
