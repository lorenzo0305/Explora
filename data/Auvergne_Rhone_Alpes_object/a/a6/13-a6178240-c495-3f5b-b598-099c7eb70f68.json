  "rdfs:comment": {
    "de": [
      "An der Ankunft der Seilbahn von Rochebrune und der Gondelbahn von La Caboche empfängt Sie dieses Restaurant mit seiner Panoramaterrasse und seinem Außengrill."
    ],
    "en": [
      "At the arrival point of the Rochebrune cable car and the Caboche cable car, this restaurant welcomes you with its panoramic terrace and outdoor barbecue."
    ],
    "it": [
      "Sempre all'arrivo della funivia dopo la ricostruzione, questo ristorante vi dà il benvenuto sulla sua terrazza panoramica con barbecue esterno."
    ],
    "fr": [
      "A l'arrivée du téléphérique de Rochebrune et de la télécabine de la Caboche, ce restaurant vous accueille avec sa terrasse panoramique et son barbecue extérieur."
    ],
    "nl": [
      "Bij de aankomst van de kabelbaan van Rochebrune en de kabelbaan van Caboche verwelkomt dit restaurant u met zijn panoramisch terras en zijn buitenbarbecue."
    ],
    "es": [
      "A la llegada del teleférico de Rochebrune y del teleférico de Caboche, este restaurante le da la bienvenida con su terraza panorámica y su barbacoa exterior."
    ]
  },
