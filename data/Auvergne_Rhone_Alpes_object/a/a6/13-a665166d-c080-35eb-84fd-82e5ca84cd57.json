  "rdfs:comment": {
    "de": [
      "Entdecken, lernen und perfektionieren Sie die Klöppelspitze. \"Couleurs Dentelle\", ein innovativer, farbenfroher, neugieriger und motivierter Verein, erwartet Sie."
    ],
    "en": [
      "Come discover, learn and improve your bobbin lace skills. \"Couleurs Dentelle\", an innovative, colourful, curious and motivated association awaits you."
    ],
    "it": [
      "Venite a scoprire, imparare e migliorare le vostre abilità con il merletto a fuselli. \"Couleurs Dentelle\", un'associazione innovativa, colorata, curiosa e motivata vi aspetta."
    ],
    "fr": [
      "Venez découvrir, apprendre et vous perfectionner en dentelle aux fuseaux. \"Couleurs Dentelle\", association innovante, colorée, curieuse et motivée vous attend."
    ],
    "es": [
      "Venga a descubrir, aprender y mejorar sus habilidades de encaje de bolillos. \"Couleurs Dentelle\", una asociación innovadora, colorida, curiosa y motivada te está esperando."
    ],
    "nl": [
      "Kom en ontdek, leer en verbeter uw kantklosvaardigheden. \"Couleurs Dentelle\", een innovatieve, kleurrijke, nieuwsgierige en gemotiveerde vereniging wacht op u."
    ]
  },
