  "rdfs:comment": {
    "de": [
      "Das 4-Sterne-Hotel Le Grand Coeur & Spa mit direktem Zugang zu den Skipisten liegt im Zentrum des Ortes. Es ist ein authentisches Savoyer Chalet mit einer gemütlichen und warmen Atmosphäre."
    ],
    "ru": [
      "4-звездочный отель с прямым доступом к лыжным склонам, расположенный в центре курорта, Le Grand Coeur & Spa - это аутентичное шале Savoyard с уютной и теплой атмосферой."
    ],
    "en": [
      "4 stars hotel ski in and out located in the centre of Méribel. La Grand Coeur is an authentic chalet of the French Alps with a cosy and warm atmosphere"
    ],
    "it": [
      "Hotel 4 stelle con accesso diretto alle piste da sci, situato nel centro della località, Le Grand Coeur & Spa è un autentico chalet savoiardo dall'atmosfera accogliente e calorosa."
    ],
    "fr": [
      "Hotel 4 étoiles avec accès direct aux pistes de ski, situé au centre de la station, Le Grand Coeur & Spa est un authentique chalet savoyard à l'ambiance cosy et chaleureuse."
    ],
    "es": [
      "Un hotel de 4 estrellas con acceso directo a las pistas de esquí, situado en el centro de la estación, Le Grand Coeur & Spa es un auténtico chalet saboyano con un ambiente acogedor y cálido."
    ],
    "nl": [
      "Een 4-sterrenhotel met directe toegang tot de skipistes, gelegen in het centrum van het resort, Le Grand Coeur & Spa is een authentiek Savoyaards chalet met een gezellige en warme sfeer."
    ]
  },
