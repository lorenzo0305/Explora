  "rdfs:comment": {
    "de": [
      "Dieses Vereinskino ist als Arthouse-Kino eingestuft und verfügt über einen Saal mit 208 Plätzen. Es bietet Ihnen Filme, Animationsfilme und Live-Shows (Pariser Oper, Varieté). 3D-Projektion."
    ],
    "en": [
      "This community cinema, rated Art et Essai, has a 208-seat auditorium. Offers films, animated features and live shows (Paris Opera, variety shows). 3D projection."
    ],
    "it": [
      "Questo cinema comunitario, classificato Art et Essai, dispone di una sala da 208 posti. Propone film, film d'animazione e spettacoli dal vivo (Opera di Parigi, varietà). Proiezione in 3D."
    ],
    "fr": [
      "Ce cinéma associatif, classé Art et Essai, dispose d'une salle de 208 places. Vous propose des films, films d'animations et spectacles en direct ( Opéra de Paris, variétés). Projection 3D."
    ],
    "es": [
      "Este cine comunitario, calificado de Art et Essai, cuenta con una sala de 208 localidades. Ofrece películas, películas de animación y espectáculos en directo (Ópera de París, espectáculos de variedades). Proyección en 3D."
    ],
    "nl": [
      "Deze gemeenschapsbioscoop met het label Art et Essai heeft een zaal met 208 zitplaatsen. Er worden films, animatiefilms en live shows (Paris Opera, variétéshows) vertoond. 3D-projectie."
    ]
  },
  "rdfs:label": {
