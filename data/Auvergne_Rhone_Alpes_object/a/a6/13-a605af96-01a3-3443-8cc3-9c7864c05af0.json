  "rdfs:comment": {
    "de": [
      "Von Abenteuer bis Cocooning, von Sport bis Entspannung: Loréleï, Gründerin des Reisebüros Manalaya, professionelle Begleiterin in den Bergen und im Gesundheitssport, führt Sie mit Leidenschaft durch all Ihre Abenteuer- und Transformationswünsche."
    ],
    "en": [
      "From adventure to cocooning, from sport to relaxation, Loréleï, founder of the Manalaya travel agency and a professional in mountain and health-sports coaching, passionately guides you in your quest for adventure and transformation."
    ],
    "it": [
      "Dall'avventura al benessere, dallo sport al relax, Loréleï, fondatrice dell'agenzia di viaggi Manalaya e professionista del coaching di montagna e degli sport salutari, vi guida con passione attraverso tutti i vostri impulsi di avventura e trasformazione."
    ],
    "fr": [
      "De l'aventure au cocooning, du sport à la détente, Loréleï, fondatrice de l'agence de voyage Manalaya, professionnelle de l'accompagnement en montagne et en sport-santé, vous guide avec passion dans tous vos élans d'aventure et de transformation."
    ],
    "nl": [
      "Van avontuur tot cocooning, van sport tot ontspanning, Loréleï, oprichtster van het reisbureau Manalaya en professional in berg- en gezondheidscoaching, begeleidt je met passie doorheen al je impulsen voor avontuur en transformatie."
    ],
    "es": [
      "De la aventura al cocooning, del deporte a la relajación, Loréleï, fundadora de la agencia de viajes Manalaya y profesional del coaching deportivo de montaña y salud, le guía con pasión a través de todos sus impulsos de aventura y transformación."
    ]
  },
