  "rdfs:comment": {
    "de": [
      "Freie Besichtigung, kostenlos, seit 1969, La Cristallière ist in Gebäuden mit typischer Bourbonnaise-Architektur untergebracht und bietet eine Ausstellung von Mineralien, Fossilien, Natursteinobjekten, Silber- und Modeschmuck mit Edelsteinen."
    ],
    "en": [
      "Free to visit since 1969, La Cristallière, housed in buildings with typical Bourbonnais architecture, offers an exhibition of minerals, fossils, natural stone objects, silver and costume jewelry adorned with fine stones."
    ],
    "it": [
      "Visitabile gratuitamente dal 1969, La Cristallière, ospitata in edifici dalla tipica architettura Bourbonnais, offre un'esposizione di minerali, fossili, oggetti in pietra naturale e oggetti di argenteria e bigiotteria impreziositi da pietre pregiate."
    ],
    "fr": [
      "Visite libre, gratuite, depuis 1969, La Cristallière, aménagée dans des bâtiments d'architecture typiquement bourbonnaise, propose une exposition de minéraux, fossiles, objets en pierre naturelles, des bijoux en argent et fantaisie ornés de pierres fines."
    ],
    "nl": [
      "La Cristallière, dat sinds 1969 gratis te bezoeken is en gehuisvest is in gebouwen met een typische Bourbonnais-architectuur, biedt een tentoonstelling van mineralen, fossielen, voorwerpen van natuursteen en zilveren en kostuumjuwelen versierd met fijne stenen."
    ],
    "es": [
      "De visita libre desde 1969, La Cristallière, albergada en edificios de arquitectura típicamente bourbonnais, ofrece una exposición de minerales, fósiles, objetos de piedra natural y joyas de plata y bisutería adornadas con piedras finas."
    ]
  },
  "rdfs:label": {
