  "rdfs:comment": {
    "de": [
      "Der Standort Pié du Roi erstreckt sich über 0,66 Hektar auf einer Höhe von 639 Metern. Dieses Feuchtgebiet zeichnet sich durch seine Formation aus Jonc des tonneliers aus, die einen Teil des Standorts besiedelt. Hier sind mehrere Blumen-, Vogel- und Amphibienarten zu finden."
    ],
    "en": [
      "The Pié du Roi site covers 0.66 hectares at an altitude of 639 meters. This wetland is characterized by its formation of Cooper's rush, which colonizes part of the site. Several species of flowers, birds and amphibians can be found here."
    ],
    "it": [
      "Il sito Pié du Roi si estende per 0,66 ettari a un'altitudine di 639 metri. Questa zona umida è caratterizzata dalla formazione del giunco di Cooper, che colonizza parte del sito. Qui si trovano diverse specie di fiori, uccelli e anfibi."
    ],
    "fr": [
      "Le site du Pié du Roi s'étend sur 0,66 hectares à une altitude de 639 mètres. Cette zone humide est caractérisée par sa formation à Jonc des tonneliers qui colonise une partie du site. On y recense plusieurs espèces florales, d'oiseaux et d'amphibiens."
    ],
    "es": [
      "El paraje de Pié du Roi ocupa 0,66 hectáreas a 639 metros de altitud. Este humedal se caracteriza por su formación de junco de Cooper, que coloniza parte del lugar. Aquí se pueden encontrar varias especies de flores, aves y anfibios."
    ],
    "nl": [
      "De site Pié du Roi beslaat 0,66 hectare op een hoogte van 639 meter. Dit watergebied wordt gekenmerkt door de vorming van Kuiperbies, die een deel van de site koloniseert. Er komen verschillende soorten bloemen, vogels en amfibieën voor."
    ]
  },
  "rdfs:label": {
