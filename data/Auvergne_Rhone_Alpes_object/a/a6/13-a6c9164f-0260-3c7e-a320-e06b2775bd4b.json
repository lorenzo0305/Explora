  "rdfs:comment": {
    "de": [
      "Wiederaufnahme der Yogakurse ab dem 5. September 2022 in Bouchet, La Garde-Adhémar und Pont-St-Esprit.\r\nAnmeldung das ganze Jahr über per Telefon, E-Mail oder über die Website http://www.yoga-solune.fr möglich.\r\nHatha-Yoga- und Yoga-Nidra-Sitzungen online."
    ],
    "en": [
      "Yoga classes resume on September 5, 2022 in Bouchet, La Garde-Adhémar and Pont-St-Esprit.\r\nRegistration possible throughout the year by telephone, e-mail or via the http://www.yoga-solune.fr website.\r\nOnline hatha yoga and yoga-nidra sessions."
    ],
    "it": [
      "Ripresa dei corsi di yoga dal 5 settembre 2022 a Bouchet, La Garde-Adhémar e Pont-St-Esprit.\r\nL'iscrizione è possibile durante tutto l'anno per telefono, e-mail o tramite il sito web http://www.yoga-solune.fr\r\nSessioni online di hatha yoga e yoga-nidra."
    ],
    "fr": [
      "Reprise des cours de yoga à compter du 5 septembre 2022 à Bouchet, La Garde-Adhémar et Pont-St-Esprit.\r\nInscription possible tout au long de l'année par téléphone, mail ou via le site http://www.yoga-solune.fr \r\nSéances de hatha-yoga et yoga-nidra en ligne."
    ],
    "nl": [
      "Yogalessen worden hervat vanaf 5 september 2022 in Bouchet, La Garde-Adhémar en Pont-St-Esprit.\r\nInschrijven kan het hele jaar door per telefoon, e-mail of via de website http://www.yoga-solune.fr\r\nOnline hatha yoga en yoga-nidra sessies."
    ],
    "es": [
      "Reanudación de las clases de yoga a partir del 5 de septiembre de 2022 en Bouchet, La Garde-Adhémar y Pont-St-Esprit.\r\nPosibilidad de inscripción durante todo el año por teléfono, correo electrónico o a través de la página web http://www.yoga-solune.fr\r\nSesiones de hatha yoga y yoga-nidra en línea."
    ]
  },
  "rdfs:label": {
