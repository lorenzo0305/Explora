  "rdfs:comment": {
    "de": [
      "Atelier und Laden für Kunsthandwerker, die Glas blasen. Tauchen Sie in das Herz der Werkstatt ein, spüren Sie die Hitze des Ofens und handhaben Sie das geschmolzene Glas dank unserer Kurse und Einführungen. Entdecken Sie unsere einzigartigen Kreationen: Dekoration, Leuchten..."
    ],
    "en": [
      "Workshop - boutique of glass blowers. Immerse yourself in the heart of the workshop, feel the heat of the oven and handle the molten glass during our courses and initiations and come discover our unique creations: decoration, lighting..."
    ],
    "it": [
      "Laboratorio/negozio per soffiatori di vetro. Immergetevi nel cuore del laboratorio, sentite il calore del forno e maneggiate il vetro fuso grazie ai nostri corsi e alle nostre iniziazioni e venite a scoprire le nostre creazioni uniche nel negozio: decorazione, illuminazione..."
    ],
    "fr": [
      "Atelier/Boutique d'artisans d'art souffleurs de verre. Plongez au cœur de l'atelier, ressentez la chaleur du four et manipulez le verre en fusion grâce à nos stages et initiations et venez découvrir nos créations uniques en boutique : déco, luminaires..."
    ],
    "es": [
      "Taller/tienda para sopladores de vidrio. Sumérjase en el corazón del taller, sienta el calor del horno y manipule el vidrio fundido gracias a nuestros cursos e iniciaciones y venga a descubrir nuestras creaciones únicas en la tienda: decoración, iluminación..."
    ],
    "nl": [
      "Glasblazerij en boetiek. Dompel je onder in het hart van het atelier, voel de hitte van de oven en hanteer het gesmolten glas dankzij onze cursussen en initiaties en kom onze unieke creaties ontdekken: decoratie, verlichting..."
    ]
  },
  "rdfs:label": {
