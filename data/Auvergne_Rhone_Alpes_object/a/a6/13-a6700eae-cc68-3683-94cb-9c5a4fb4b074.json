  "rdfs:comment": {
    "de": [
      "Originelles Höhen-Café-Konzept: eine Bar, ein Coffeeshop, kleine Restaurants, ein Feinkostladen, ein Weinkeller und eine Boutique, in der alles verkauft wird, sogar die Möbel!\r\nGemütlicher Lounge-Bereich und Terrasse mit atemberaubendem Blick auf die Chaîne des Aravis."
    ],
    "en": [
      "Original high-altitude café-concept: a bar, coffee shop, snack bar, delicatessen, wine cellar and boutique, where everything is for sale, even the furniture!\r\nCosy lounge area and terrace with breathtaking views of the Aravis mountain range."
    ],
    "it": [
      "Un originale concetto di caffè d'alta quota: bar, caffetteria, snack bar, gastronomia, cantina e boutique, dove tutto è in vendita, anche i mobili!\r\nAccogliente area lounge e terrazza con vista mozzafiato sulla catena degli Aravis."
    ],
    "fr": [
      "Café-concept d’altitude original : un bar, coffee shop, petite restauration, épicerie fine, cave à vins et boutique, où tout est vente, même le mobilier !\r\nEspace lounge cosy et terrasse avec une vue imprenable sur la Chaîne des Aravis."
    ],
    "es": [
      "Un original concepto de cafetería de altura: bar, cafetería, snack bar, delicatessen, bodega y boutique, donde todo está a la venta, ¡incluso los muebles!\r\nAcogedora sala de estar y terraza con impresionantes vistas de la cordillera de Aravis."
    ],
    "nl": [
      "Een origineel café-concept op grote hoogte: een bar, koffiebar, snackbar, delicatessenwinkel, wijnkelder en boetiek, waar alles te koop is, zelfs de meubels!\r\nGezellige zithoek en terras met adembenemend uitzicht op het Aravisgebergte."
    ]
  },
