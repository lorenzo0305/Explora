  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/48c0dd7d-aad5-3200-8109-2dcb87e2a74d",
      "dc:description": {
        "de": [
          "Freitag, den 10. April 2026\nKonferenz \"China und die Beziehungen zwischen der Europäischen Union und China\" von Caroline PUEL.\n18:30 Uhr - Haus der Vereine.\nFreier Eintritt.\n\nMontag, 11. Mai 2026\nVortrag von Quentin DICKINSON\n18.15 Uhr - Haus der Vereinigungen.\nFreier Eintritt.\n\nMontag, 8. Juni 2026\nKonferenz Jacques FAVIN LEVEQUE\n18.15 Uhr - Haus der Vereinigungen.\nFreier Eintritt.\n\nMontag, 22. Juni 2026\nVortrag \"Das Europa der Mythen und Legenden\" von Thomas VOLATIER.\n18.15 Uhr - Haus der Vereinigungen.\nFreier Eintritt.\n\nMontag, 17. August 2026\nIm Rahmen der \"Pianos Folies\"\nVortrag \"Die erste Wiener Schule und die Entstehung eines universellen europäischen Geschmacks\" von Jérôme BLOCH\n15h\nFreier Eintritt."
        ],
        "en": [
          "Friday April 10, 2026\nConference \"China and European Union-China relations\" by Caroline PUEL.\n6:30pm - Maison des associations.\nFree admission.\n\nMonday May 11, 2026\nQuentin DICKINSON Conference\n6:15pm - Maison des associations.\nFree admission.\n\nMonday June 8, 2026\nJacques FAVIN LEVEQUE lecture\n18h15 - Maison des associations.\nFree admission.\n\nMonday June 22nd 2026\nConference \"L'Europe des Mythes et des Légendes\" by Thomas VOLATIER.\n6:15pm - Maison des associations.\nFree admission.\n\nMonday, August 17, 2026\nAs part of the \"Pianos Folies\" festival\nLecture \"The first Vienna School and the birth of a universal European taste\" by Jérôme BLOCH\n15h\nFree admission."
        ],
        "it": [
          "Venerdì 10 aprile 2026\nConferenza \"Cina e relazioni UE-Cina\" di Caroline PUEL.\n18.30 - Maison des associations.\nIngresso libero.\n\nLunedì 11 maggio 2026\nConferenza di Quentin DICKINSON\n18.15 - Maison des associations.\nIngresso libero.\n\nLunedì 8 giugno 2026\nConferenza di Jacques FAVIN LEVEQUE\nore 18.15 - Maison des associations.\nIngresso libero.\n\nLunedì 22 giugno 2026\nConferenza \"L'Europe des Mythes et des Légendes\" di Thomas VOLATIER.\nore 18.15 - Maison des associations.\nIngresso libero.\n\nLunedì 17 agosto 2026\nNell'ambito del festival \"Pianos Folies\"\nConferenza \"La prima scuola di Vienna e la nascita di un gusto europeo universale\" di Jérôme BLOCH\n15h\nIngresso libero."
        ],
        "fr": [
          "Vendredi 10 avril 2026\nConférence \"La Chine et les relations Union Européenne Chine\" par Caroline PUEL.\n18h30 - Maison des associations.\nEntrée libre.\n\nLundi 11 mai 2026\nConférence Quentin DICKINSON\n18h15 - Maison des associations.\nEntrée libre.\n\nLundi 8 juin 2026\nConférence Jacques FAVIN LEVEQUE\n18h15 - Maison des associations.\nEntrée libre.\n\nLundi 22 juin 2026\nConférence \"L'Europe des Mythes et des Légendes\" par Thomas VOLATIER.\n18h15 - Maison des associations.\nEntrée libre.\n\nLundi 17 août 2026\nDans le cade des \"Pianos Folies\"\nConférence \"La première école de Vienne et la naissance d'un goût européen universel\" par Jérôme BLOCH\n15h\nEntrée libre."
        ],
        "nl": [
          "Vrijdag 10 april 2026\nConferentie \"China en de betrekkingen tussen de EU en China\" door Caroline PUEL.\n18.30 uur - Maison des associations.\nGratis toegang.\n\nMaandag 11 mei 2026\nLezing door Quentin DICKINSON\n18u15 - Maison des associations.\nGratis toegang.\n\nMaandag 8 juni 2026\nLezing Jacques FAVIN LEVEQUE\n18u15 - Maison des associations.\nGratis toegang.\n\nMaandag 22 juni 2026\nLezing \"L'Europe des Mythes et des Légendes\" door Thomas VOLATIER.\n18u15 - verenigingsgebouw.\nGratis toegang.\n\nMaandag 17 augustus 2026\nIn het kader van het festival \"Pianos Folies\nLezing \"De eerste school van Wenen en de geboorte van een universele Europese smaak\" door Jérôme BLOCH\n15h\nGratis toegang."
        ],
        "es": [
          "Viernes 10 de abril de 2026\nConferencia \"China y las relaciones UE-China\" por Caroline PUEL.\n18h30 - Casa de las Asociaciones.\nEntrada gratuita.\n\nLunes 11 de mayo de 2026\nConferencia de Quentin DICKINSON\n18.15 h - Casa de las asociaciones.\nEntrada libre.\n\nLunes 8 de junio de 2026\nConferencia de Jacques FAVIN LEVEQUE\n18.15 h - Casa de las asociaciones.\nEntrada libre.\n\nLunes 22 de junio de 2026\nConferencia \"L'Europe des Mythes et des Légendes\" de Thomas VOLATIER.\n18.15 h - Casa de las asociaciones.\nEntrada gratuita.\n\nLunes 17 de agosto de 2026\nEn el marco del festival \"Pianos Folies\nConferencia \"La primera escuela de Viena y el nacimiento de un gusto europeo universal\" por Jérôme BLOCH\n15h\nEntrada gratuita."
        ]
      },
