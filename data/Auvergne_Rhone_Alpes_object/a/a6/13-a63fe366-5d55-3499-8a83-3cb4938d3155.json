  "rdfs:comment": {
    "de": [
      "Geselliges und familiäres Restaurant, in dem Sie mittags( Sonntag bis Freitag) oder abends (Freitag nur mit Reservierung) traditionell mit lokalen Spezialitäten sowie Froschschenkeln und Kalbsbries mit Morcheln speisen können."
    ],
    "en": [
      "Friendly, family-run restaurant where you can enjoy lunch( Sunday to Friday) or dinner (Fridays by reservation only) featuring traditional local specialties such as frogs' legs and sweetbreads with morel mushrooms."
    ],
    "it": [
      "Un accogliente ristorante a conduzione familiare dove potrete gustare un pranzo tradizionale (dalla domenica al venerdì) o una cena (il venerdì su prenotazione) con specialità locali come le cosce di rana e le animelle con le spugnole."
    ],
    "fr": [
      "Restaurant convivial et familial où vous pouvez déjeuner( du dimanche au vendredi) ou dîner (vendredi sur réservation uniquement) traditionnellement avec des spécialités locales ainsi que des cuisses de grenouilles et ris de veau aux morilles."
    ],
    "es": [
      "Un restaurante familiar y acogedor donde podrá disfrutar de un almuerzo tradicional (de domingo a viernes) o una cena (los viernes sólo con reserva) con especialidades locales como ancas de rana y mollejas con colmenillas."
    ],
    "nl": [
      "Een gezellig familierestaurant waar je kunt genieten van een traditionele lunch (zondag tot vrijdag) of diner (vrijdag alleen op reservering) met lokale specialiteiten zoals kikkerbilletjes en zwezerik met morilles."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant Bar des Copains"
    ]
  },
