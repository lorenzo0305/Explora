  "rdfs:comment": {
    "de": [
      "Von Béatrice PECOUT, Acryl auf Kraft\r\nVon den Pfaden des Vercors bis zum malerischen Werk, manchmal auch über das Schreiben, fängt das Auge die Unermesslichkeit ein, die Zeichnung fixiert ein Detail, eine Linie, Kontraste, um die Schönheit der Orte zu übertragen..."
    ],
    "en": [
      "By Béatrice PECOUT, Acrylics on kraft\r\nFrom the trails of the Vercors to her pictorial work, and sometimes to her writing, the eye captures the immensity, the drawing fixes a detail, a line, contrasts to transcribe the beauty of the places..."
    ],
    "it": [
      "Di Béatrice PECOUT, Acrilici su kraft\r\nDai sentieri del Vercors ai suoi dipinti, e talvolta alla sua scrittura, l'occhio cattura l'immensità, il disegno fissa un dettaglio, una linea, dei contrasti per trascrivere la bellezza del luogo..."
    ],
    "fr": [
      "Par Béatrice PECOUT, Acryliques sur kraft\r\nDes sentiers du Vercors à l'oeuvre picturale, en passant parfois par l'écriture,, l'oeil capte l'immensité, le dessin fixe un détail, une ligne, des contrastes pour transcrire la beauté des lieux..."
    ],
    "es": [
      "Por Béatrice PECOUT, Acrílicos sobre kraft\r\nDe los caminos del Vercors a sus cuadros, y a veces a sus escritos, el ojo capta la inmensidad, el dibujo fija un detalle, una línea, los contrastes para transcribir la belleza del lugar..."
    ],
    "nl": [
      "Door Béatrice PECOUT, Acryl op kraft\r\nVan de paden van de Vercors naar haar schilderijen, en soms naar haar schrijven, het oog vangt de onmetelijkheid, de tekening fixeert een detail, een lijn, contrasten om de schoonheid van de plaats te transcriberen ..."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Exposition : Espaces de silence"
    ]
  },
