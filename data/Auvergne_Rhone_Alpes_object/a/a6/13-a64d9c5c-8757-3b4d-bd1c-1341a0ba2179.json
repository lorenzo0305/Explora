  "rdfs:comment": {
    "de": [
      "Willkommen in meiner Atelier-Boutique in Yenne. Ich bin seit 10 Jahren kreativ tätig und biete Schmuck aus Natursteinen und Accessoires an, die durch Lasergravur personalisiert werden. Ein handwerkliches und authentisches Universum für einzigartige Geschenke, die Ihnen ähneln."
    ],
    "en": [
      "Come and visit my workshop and shop in Yenne, where you will find natural stone jewellery and handcrafted creations. Combining traditional craftsmanship with laser engraving, I can personalise your gifts and souvenirs on the spot to create unique items that truly reflect your personality."
    ],
    "it": [
      "Benvenuti nel mio Atelier-Boutique di Yenne. Designer da 10 anni, propongo gioielli realizzati con pietre naturali e accessori personalizzati con incisioni laser. Un mondo di autentica artigianalità per regali unici che riflettono la vostra personalità."
    ],
    "fr": [
      "Bienvenue dans mon Atelier-Boutique à Yenne. Créatrice depuis 10 ans, je propose des bijoux en pierres naturelles et des accessoires personnalisés par gravure laser. Un univers artisanal et authentique pour des cadeaux uniques qui vous ressemblent."
    ],
    "nl": [
      "Welkom in mijn Atelier-Boetiek in Yenne. Ik ben al 10 jaar ontwerper en bied sieraden van natuursteen en accessoires die gepersonaliseerd zijn door middel van lasergravure. Een wereld van authentiek vakmanschap voor unieke cadeaus die je persoonlijkheid weerspiegelen."
    ],
    "es": [
      "Bienvenido a mi Atelier-Boutique en Yenne. Diseñadora desde hace 10 años, propongo joyas de piedras naturales y accesorios personalizados mediante grabado láser. Un mundo de auténtica artesanía para regalos únicos que reflejan su personalidad."
    ]
  },
  "rdfs:label": {
    "en": [
      "Les Créations de Maman"
    ],
    "fr": [
      "Les Créations de Maman"
    ]
  },
