  "rdfs:comment": {
    "de": [
      "Ausstellungsraum oberhalb des Fremdenverkehrsamtes, ein Raum, der hauptsächlich der zeitgenössischen Kunst gewidmet ist.\r\nAusstellungen, die von der Kulturkommission der Stadt Grignan und dem IAC in Villeurbanne organisiert werden."
    ],
    "en": [
      "Art gallery : temporary exhibitions (contemporary art)."
    ],
    "it": [
      "Sala espositiva situata sopra l'Ufficio del Turismo, dedicata principalmente all'arte contemporanea.\r\nMostre organizzate dalla Commissione Cultura della città di Grignan e dall'IAC di Villeurbanne."
    ],
    "fr": [
      "Salle d'exposition située au dessus de l'Office de Tourisme, espace dédié principalement à l'art contemporain.\r\nExpositions organisées par la Commission Culture de la ville de Grignan et l'IAC de Villeurbanne."
    ],
    "nl": [
      "Tentoonstellingsruimte boven het Office du Tourisme, voornamelijk gewijd aan hedendaagse kunst.\r\nTentoonstellingen georganiseerd door de Cultuurcommissie van de stad Grignan en het IAC in Villeurbanne."
    ],
    "es": [
      "Sala de exposiciones situada encima de la Oficina de Turismo, dedicada principalmente al arte contemporáneo.\r\nExposiciones organizadas por la Comisión de Cultura de la ciudad de Grignan y el IAC de Villeurbanne."
    ]
  },
