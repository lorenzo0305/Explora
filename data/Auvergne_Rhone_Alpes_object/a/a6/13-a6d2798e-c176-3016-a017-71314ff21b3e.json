  "rdfs:comment": {
    "de": [
      "FBKT-La Fabrikathé ist ein handwerklicher Zusammensteller von Tees, Kräutertees, Gewürzen und Kakao. Seine Besonderheit: Er ist einer der einzigen handwerklichen Teemischbetriebe in Frankreich!"
    ],
    "en": [
      "FBKT-La Fabrikathé is an artisan blender of teas, infusions, spices & cocoas. What makes it special: one of the only artisan tea blenders in France!"
    ],
    "it": [
      "FBKT-La Fabrikathé è un miscelatore artigianale di tè, infusi, spezie e cacao. Ciò che ci rende speciali è che siamo uno degli unici miscelatori artigianali di tè in Francia!"
    ],
    "fr": [
      "FBKT-La Fabrikathé est un artisan assembleur de thés, infusions, épices & cacaos. Sa spécificité : être l’un des seuls ateliers d’assemblage artisanal de thés en France !"
    ],
    "nl": [
      "FBKT-La Fabrikathé is een ambachtelijke blender van theeën, infusies, kruiden en cacao. Wat ons bijzonder maakt, is dat we een van de enige ambachtelijke theemengers in Frankrijk zijn!"
    ],
    "es": [
      "FBKT-La Fabrikathé es un mezclador artesanal de tés, infusiones, especias y cacao. Lo que nos hace especiales es que somos uno de los únicos mezcladores de té artesanales de Francia"
    ]
  },
