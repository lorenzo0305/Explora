  "rdfs:comment": {
    "de": [
      "Das Hôtel de France empfängt Sie in einem vollständig renovierten Rahmen, in dem sich klassische und moderne Küche vermischen, die aber vor allem vor Ort und aus frischen, lokalen Produkten hergestellt wird."
    ],
    "en": [
      "The Hôtel de France welcomes you in a completely renovated setting, combining classic and modern cuisine, but above all made on site and using fresh local produce."
    ],
    "it": [
      "L'Hôtel de France vi accoglie in un ambiente completamente rinnovato, combinando cucina classica e moderna, ma soprattutto realizzata sul posto con prodotti freschi e locali."
    ],
    "fr": [
      "L'Hôtel de France vous accueille dans un cadre entièrement rénové, mêlant cuisine classique et moderne, mais surtout réalisée sur place et à base de produits frais et locaux."
    ],
    "nl": [
      "Hôtel de France ontvangt u in een volledig gerenoveerd kader, met een combinatie van klassieke en moderne gerechten, maar vooral ter plaatse bereid met verse en lokale producten."
    ],
    "es": [
      "El Hôtel de France le da la bienvenida en un entorno completamente renovado, combinando la cocina clásica y la moderna, pero sobre todo elaborada en el momento con productos frescos y locales."
    ]
  },
  "rdfs:label": {
