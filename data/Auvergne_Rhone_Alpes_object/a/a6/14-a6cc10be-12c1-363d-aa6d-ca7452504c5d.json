  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/eb311238-43fb-36ea-bc18-be6ca60dc20c",
      "dc:description": {
        "de": [
          "Das Hotel De Wimereux -Restaurant Du Centre bietet in seiner Bar von 19 bis 21 Uhr eine Reihe von musikalischen Veranstaltungen \"Aperitif-Konzerte\" an\nZögern Sie nicht, sich hier zu entspannen und in einem sympathischen Rahmen talentierte Künstler zu entdecken oder wiederzuentdecken."
        ],
        "en": [
          "The Hotel De Wimereux -Restaurant Du Centre is offering a series of musical \"aperitif concerts\" in its bar from 7pm to 9pm\nCome and relax and discover or rediscover talented artists in a friendly setting."
        ],
        "it": [
          "L'Hôtel De Wimereux -Restaurant Du Centre propone una serie di \"concerti aperitivo\" nel suo bar dalle 19.00 alle 21.00\nVenite a rilassarvi e a scoprire o riscoprire artisti di talento in un ambiente amichevole."
        ],
        "fr": [
          "L’ hôtel De Wimereux -Restaurant Du Centre propose une série d’animations musicales « apéros concerts » au sein de son bar de 19h à 21h\nN’hésitez pas à venir vous y détendre et découvrir ou redécouvrir des artistes talentueux dans un cadre sympathique."
        ],
        "nl": [
          "Hôtel De Wimereux -Restaurant Du Centre biedt een reeks \"aperitiefconcerten\" aan in de bar van 19u tot 21u\nKom ontspannen en ontdek of herontdek getalenteerde artiesten in een gezellige omgeving."
        ],
        "es": [
          "El Hôtel De Wimereux -Restaurant Du Centre ofrece una serie de \"conciertos aperitivo\" en su bar de 19:00 a 21:00 horas\nVenga a relajarse y a descubrir o redescubrir a artistas de talento en un ambiente acogedor."
        ]
      },
