  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/e687d344-aa49-3890-9fc6-35bee7f4d533",
      "dc:description": {
        "de": [
          "Fachgeschäft für Tanz- und Sportbekleidung\n\nInformationen :\n\nProdukte :\n\nFinden Sie die Produkte auf der Website des Geschäfts\n \n Bestellungen:\n\nKontaktieren Sie den Laden entweder telefonisch unter 06 83 51 86 89 oder per privater Facebook-Nachricht oder der Website\n\nLieferung :\n\nKostenlose Lieferung nach Hause in einem Umkreis von 30 km bei einem Mindestbestellwert von 20?\n\nVerkauf zum Mitnehmen :\n\nDrive-by-System, holen Sie Ihren Einkauf 2 Stunden nach der Bestellung ab\n\nPostsendungen:\n\nVersandkostenfrei ab einem Bestellwert von 50?\n\n "
        ],
        "en": [
          "Specialized dance and sportswear store\n\nInformations :\n\nProducts :\n\nFind products on the store's website\n \n How to order :\n\nContact the store either by telephone on 06 83 51 86 89 or by private message on Facebook or the website\n\nDelivery:\n\nFree home delivery within a 30km radius for a minimum purchase of 20?\n\nTakeaway :\n\nDrive-through system, collect your purchase 2 hours after ordering\n\nPostal delivery:\n\nFree shipping on orders over 50?\n\n "
        ],
        "it": [
          "Negozio specializzato in abbigliamento per la danza e lo sport\n\nPer saperne di più\n\nProdotti :\n\nTrova i prodotti sul sito web del negozio\n \n Come ordinare :\n\nContattare il negozio per telefono al numero 06 83 51 86 89 o tramite messaggio privato su Facebook o sul sito web\n\nConsegna :\n\nConsegna a domicilio gratuita nel raggio di 30 km per un acquisto minimo di 20?\n\nDa asporto:\n\nSistema drive-through, ritira il tuo acquisto 2 ore dopo l'ordine\n\nConsegna postale:\n\nAffrancatura gratuita per ordini superiori a 50?\n\n "
        ],
        "fr": [
          "Magasin spécialisé de danse et sportwear\n\nInformations :\n\nProduits :\n\nRetrouvez les produits sur le site internet du magasin \n \n Commandes :\n\nContacter le magasin soit par téléphone au 06 83 51 86 89 ou par message privé Facebook ou le site internet\n\nLivraison :\n\nLivraison à domicile gratuite dans un rayon de 30km pour un minimum d'achats de 20€\n\nVente à emporter :\n\nSystème de drive, récupérez votre achat 2h après la commande\n\nEnvois postaux :\n\nFrais de ports offerts des 50€ d'achats\n\n "
        ],
        "es": [
          "Tienda especializada en danza y ropa deportiva\n\nPara más información\n\nProductos :\n\nEncuentre los productos en el sitio web de la tienda\n \n Cómo hacer un pedido :\n\nPóngase en contacto con la tienda por teléfono en el 06 83 51 86 89 o por mensaje privado en Facebook o en el sitio web\n\nEntrega :\n\nEntrega gratuita a domicilio en un radio de 30 km para una compra mínima de 20?\n\nComida para llevar:\n\nSistema drive-through, recoja su compra 2 horas después de hacer el pedido\n\nEntrega por correo:\n\nGastos de envío gratuitos para pedidos superiores a 50?\n\n "
        ],
        "nl": [
          "Gespecialiseerde dans- en sportkledingwinkel\n\nMeer informatie\n\nProducten :\n\nZoek producten op de website van de winkel\n \n Hoe bestellen?\n\nNeem telefonisch contact op met de winkel op 06 83 51 86 89 of via een privébericht op Facebook of de website\n\nLevering :\n\nGratis thuisbezorging binnen een straal van 30 km bij een minimale aankoop van 20?\n\nAfhaalmaaltijden:\n\nDrive-through systeem, haal je aankoop 2 uur na bestelling af\n\nBezorging per post:\n\nGratis verzending voor bestellingen van meer dan 50?\n\n "
        ]
      },
