  "rdfs:comment": {
    "de": [
      "Marion ist eine leidenschaftliche Sophrologin, die auf Elternberatung spezialisiert ist. Sie bietet Einzel- und Gruppenberatungen sowie Workshops, Schulungen und Vorträge an, um Ihr Gleichgewicht zu finden!"
    ],
    "en": [
      "Marion is a passionate sophrologist specializing in parenting support. She offers individual and group consultations as well as workshops, training courses and conferences to help you find your balance!"
    ],
    "it": [
      "Marion è un'appassionata sofrologa specializzata nel sostegno alla genitorialità. Offre consulenze individuali e di gruppo, nonché workshop, corsi di formazione e conferenze per aiutarvi a trovare il vostro equilibrio!"
    ],
    "fr": [
      "Marion est une sophrologue passionnée et spécialisée dans l'accompagnement parental. Elle propose des consultations individuelles ou de groupe ainsi que des ateliers, des formations et des conférences afin de trouver votre équilibre !"
    ],
    "nl": [
      "Marion is een gepassioneerd sofrologist, gespecialiseerd in opvoedingsondersteuning. Ze biedt individuele en groepsconsulten, maar ook workshops, trainingen en conferenties om je te helpen je balans te vinden!"
    ],
    "es": [
      "Marion es una apasionada sofróloga especializada en el apoyo a los padres. Ofrece consultas individuales y en grupo, así como talleres, cursos de formación y conferencias para ayudarte a encontrar el equilibrio"
    ]
  },
  "rdfs:label": {
