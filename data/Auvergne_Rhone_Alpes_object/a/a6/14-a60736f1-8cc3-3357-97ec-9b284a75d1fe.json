  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/faec4696-5d86-386c-a135-bb267708d64b",
      "dc:description": {
        "de": [
          "Das Festkomitee von Torcy organisiert seine Ducasse mit gegrilltem Schinken und einem Tanzabend\nTreffpunkt ist am Samstag, den 21. Juni ab 19.30 Uhr\nReservierung bis zum 17. Juni"
        ],
        "en": [
          "The Comité des Fêtes de Torcy organizes its ducasse with grilled ham and dancing\nRendezvous on Saturday June 21 from 7.30pm\nReservations by June 17"
        ],
        "it": [
          "Il Comité des Fêtes de Torcy organizza la sua \"ducasse\" con prosciutto alla griglia e balli\nAppuntamento sabato 21 giugno dalle 19.30\nPrenota prima del 17 giugno"
        ],
        "fr": [
          "Le Comité des Fêtes de Torcy organise sa ducasse autour d'un jambon grillé et une soirée dansante\nRendez-vous le samedi 21 juin à partir de 19h30\nRéservation avant le 17 juin"
        ],
        "nl": [
          "Het Comité des Fêtes de Torcy organiseert zijn \"ducasse\" met gegrilde ham en dans\nAfspraak op zaterdag 21 juni vanaf 19.30 uur\nReserveer voor 17 juni"
        ],
        "es": [
          "El Comité des Fêtes de Torcy organiza su \"ducasse\" con jamón asado y baile\nCita el sábado 21 de junio a partir de las 19.30 h\nReserva antes del 17 de junio"
        ]
      },
