  "rdfs:comment": {
    "de": [
      "Das Maison des Têtes, ein Denkmal mit symbolträchtiger Fassade, öffnet seine Türen für eine Besichtigung der privaten Räume. Hinterhof, Galerie, Empfangssalon, kleiner Salon?"
    ],
    "en": [
      "With its emblematic façade, the Maison des Têtes opens its doors to visitors for a tour of its private spaces. Back courtyard, gallery, reception room, parlour?"
    ],
    "it": [
      "La Maison des Têtes, monumento dalla facciata emblematica della regione di Valence, vi apre le porte per una visita ai suoi spazi privati. Cortile posteriore, galleria, sala di ricevimento, salotto?"
    ],
    "fr": [
      "Monument valentinois à la façade emblématique, la Maison des Têtes vous ouvre ses portes pour une visite de ses espaces privés. Cour arrière, galerie, salon de réception, petit salon…"
    ],
    "es": [
      "La Maison des Têtes, monumento de fachada emblemática de la región de Valence, le abre sus puertas para que recorra sus espacios privados. Patio trasero, galería, sala de recepción, salón.."
    ],
    "nl": [
      "Het Maison des Têtes, een monument met een emblematische gevel in de regio Valence, opent zijn deuren voor je voor een rondleiding door de privévertrekken. Binnenplaats, galerie, ontvangstruimte, salon?"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite guidée : La Maison des Têtes et ses salons XVIIIe siècle"
    ]
  },
