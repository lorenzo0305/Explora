  "rdfs:comment": {
    "de": [
      "Keolis stellt Ihnen qualifizierte Busse und Fahrer zur Verfügung, für Ihre Freizeit- und Geschäftsreisen.\r\nSportveranstaltungen, Seminare, Tagesreisen - unser Team steht Ihnen zu Diensten."
    ],
    "en": [
      "Keolis provides qualified coaches and drivers for your leisure and business trips.\r\nSports events, seminars, day trips, our team is at your service."
    ],
    "it": [
      "Keolis mette a disposizione pullman e autisti qualificati per i vostri viaggi di piacere e di lavoro.\r\nEventi sportivi, seminari, gite di un giorno, il nostro team è al vostro servizio."
    ],
    "fr": [
      "Keolis met à votre disposition des cars et conducteurs qualifiés, pour vos déplacements de loisirs et professionnels.\r\nÉvènements sportifs, séminaires, voyages à la journée, notre équipe est à votre service."
    ],
    "es": [
      "Keolis pone a su disposición autocares y conductores cualificados para sus viajes de ocio y de negocios.\r\nEventos deportivos, seminarios, viajes de un día, nuestro equipo está a su servicio."
    ],
    "nl": [
      "Keolis biedt gekwalificeerde bussen en chauffeurs voor uw vrijetijds- en zakenreizen.\r\nSportevenementen, seminars, dagtochten, ons team staat voor u klaar."
    ]
  },
