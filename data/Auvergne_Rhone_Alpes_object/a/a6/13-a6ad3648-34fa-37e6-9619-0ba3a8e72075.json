  "rdfs:comment": {
    "de": [
      "Das Theater bietet ein vielfältiges Programm, das sowohl das klassische Theater als auch das Boulevardtheater, den Tanz, den neuen Zirkus, das französische Chanson, den Humor, die Musik und das junge Publikum berührt."
    ],
    "en": [
      "The theatre offers a diversified program, which includes classical theatre, boulevard theatre, dance, new circus, French song, humour, music, and young audiences."
    ],
    "it": [
      "Il teatro offre un programma vario, che spazia dal teatro classico al teatro boulevard, alla danza, al nuovo circo, alla canzone francese, all'umorismo, alla musica e al pubblico giovane."
    ],
    "fr": [
      "Le théâtre propose une programmation diversifiée, qui touche aussi bien au théâtre classique qu'au théâtre de boulevard, à la danse, au nouveau cirque, à la chanson française, à l'humour, à la musique, au jeune public."
    ],
    "nl": [
      "Het theater biedt een gevarieerd programma, van klassiek theater tot boulevardtheater, dans, nieuw circus, Frans lied, komedie, muziek en jong publiek."
    ],
    "es": [
      "El teatro ofrece una programación variada, que va desde el teatro clásico hasta el teatro de bulevar, pasando por la danza, el nuevo circo, la canción francesa, el humor, la música y el público joven."
    ]
  },
  "rdfs:label": {
    "fr": [
