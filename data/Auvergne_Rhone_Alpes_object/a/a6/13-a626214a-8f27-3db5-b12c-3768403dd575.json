  "rdfs:comment": {
    "de": [
      "Auf der Esplanade vor dem Fremdenverkehrsamt beginnt ein Rundgang mit 10 Markierungen, der ideal ist, um das Dorf zu entdecken. An jeder Markierung ist das Faltblatt mit einer Frage oder einem kleinen Quiz über das Kulturerbe des Dorfes versehen."
    ],
    "en": [
      "Starting from the esplanade in front of the Tourist Office, a trail of 10 markers is ideal for discovering the village. Each marker is accompanied by a question or quiz on the village?s heritage."
    ],
    "it": [
      "Partendo dalla spianata di fronte all'Ufficio del Turismo, un percorso di 10 cartelli è il modo ideale per scoprire il villaggio. Ogni cartello è accompagnato da una domanda o da un quiz sul patrimonio del villaggio."
    ],
    "fr": [
      "Au départ de l'esplanade devant l'Office de Tourisme, un parcours de 10 balises idéal pour découvrir le village . A chaque balise le dépliant est agrémenté d’une question ou d’un petit quizz sur le patrimoine du village."
    ],
    "nl": [
      "Vanaf de esplanade voor het VVV-kantoor is een parcours van 10 wegwijzers een ideale manier om het dorp te ontdekken. Bij elke wegwijzer staat een vraag of quiz over het erfgoed van het dorp."
    ],
    "es": [
      "A partir de la explanada situada frente a la Oficina de Turismo, un recorrido de 10 señales permite descubrir el pueblo. Cada baliza va acompañada de una pregunta o un cuestionario sobre el patrimonio del pueblo."
    ]
  },
  "rdfs:label": {
