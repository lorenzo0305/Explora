  "rdfs:comment": {
    "de": [
      "Das Restaurant bietet Ihnen eine familiäre Küche und Bergspezialitäten (hausgemacht). Genießen Sie die Terrasse (50 Plätze) unter den Linden mit Panoramablick auf das Tal und die Belledonne-Kette.\r\nFahrrad-/Motorradgarage."
    ],
    "en": [
      "The restaurant propose family-orientated cuisine and mountain specialties (home-made). Come and enjoy our 50-seat terrace under the linden trees with panoramic views of the valley and the Belledonne mountain range."
    ],
    "it": [
      "Il ristorante propone una cucina familiare e specialità di montagna fatte in casa. Venite a godervi la terrazza (50 coperti), sotto i tigli, con vista panoramica sulla valle e sulla catena montuosa di Belledonne.\r\nGarage per biciclette e moto."
    ],
    "fr": [
      "Le restaurant vous propose une cuisine familiale et des spécialités de montagne (fait maison). Venez profiter de la terrasse (50 couverts), sous les tilleuls avec une vue panoramique sur la vallée et la chaine de Belledonne.\r\nGarage Vélo/motos."
    ],
    "nl": [
      "Het restaurant serveert gerechten in familiestijl en huisgemaakte bergspecialiteiten. Kom genieten op het terras (50 couverts), onder de lindebomen met een panoramisch uitzicht op de vallei en de bergketen van Belledonne.\r\nGarage voor fietsen en motoren."
    ],
    "es": [
      "El restaurante sirve cocina familiar y especialidades caseras de montaña. Disfrute de la terraza (50 cubiertos), bajo los tilos, con una vista panorámica del valle y de la cordillera de Belledonne.\r\nGaraje para bicicletas y motos."
    ]
  },
  "rdfs:label": {
    "en": [
      "Le Beauséjour Hôtel-restaurant"
    ],
