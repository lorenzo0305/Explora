  "rdfs:comment": {
    "de": [
      "Verkauf von Käse, gerührtem Joghurt, mit der Kelle geformten Fässern, Landbrot, hausgemachten Wurstwaren, Weinen aus dem Bugey, Feinkost, zahlreichen regionalen Produkten.\r\nDer Comté-Bereich bietet einen musealen, polysensorischen und spielerischen Bereich."
    ],
    "en": [
      "Cheeses, yoghurts, ladle-molded faisselles, farmhouse bread, artisanal charcuterie, Bugey wines, delicatessen and many regional products.\r\nThe Comté area features a museum, multi-sensory and play area."
    ],
    "it": [
      "Formaggi, yogurt mescolati, faisselles modellate al mestolo, pane di fattoria, salumi tradizionali, vini di Bugey, gastronomia e una vasta gamma di prodotti regionali.\r\nL'area del Comté offre un museo, un'area multisensoriale e un'area ludica."
    ],
    "fr": [
      "Vente de fromages, yaourts brassés, faisselles moulées à la louche, pain de campagne, charcuterie artisanale, vins du Bugey, épicerie fine, nombreux produits régionaux. \r\nL'espace Comté propose un espace musée, polysensoriel, et ludique."
    ],
    "es": [
      "Quesos, yogures batidos, faisselles moldeadas con cucharón, pan de granja, charcutería tradicional, vinos de Bugey, charcutería y una amplia gama de productos regionales.\r\nLa zona del Comté ofrece un museo, un espacio multisensorial y lúdico."
    ],
    "nl": [
      "Kazen, yoghurt, faisselles met lepel, boerenbrood, traditionele vleeswaren, wijnen uit Bugey, delicatessen en een breed scala aan streekproducten.\r\nDe Comté biedt een museum, een multisensoriële en ludieke ruimte."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Fruitière aux Délices d'Aranc"
    ]
  },
