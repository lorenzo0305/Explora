  "rdfs:comment": {
    "de": [
      "Parcours, den Sie unabhängig, allein, mit der Familie, mit Freunden oder im Team absolvieren können.\r\nStart des Parcours in der Rue Abel Gance, am Parkplatz neben dem städtischen Schwimmbad.\r\nFür alle zugänglich."
    ],
    "en": [
      "Course to be enjoyed independently, alone, with family, friends or as part of a team.\r\nStarting point rue Abel Gance, in the parking lot next to the municipal swimming pool.\r\nAccessible to all."
    ],
    "it": [
      "Il percorso può essere affrontato in autonomia, da soli, con la famiglia, con gli amici o in squadra.\r\nPartenza in rue Abel Gance, nel parcheggio accanto alla piscina comunale.\r\nAperto a tutti."
    ],
    "fr": [
      "Parcours à pratiquer indépendamment, seul, en famille, entre amis, en équipe.\r\nDépart du parcours rue Abel Gance, au parking à côté de la piscine municipale.\r\nAccessible à tout public."
    ],
    "nl": [
      "Het parcours kan zelfstandig, alleen, met familie, vrienden of in teamverband worden afgelegd.\r\nStart in de Abel Gancestraat, op de parkeerplaats naast het gemeentelijk zwembad.\r\nVoor iedereen toegankelijk."
    ],
    "es": [
      "El recorrido puede realizarse de forma independiente, en solitario, en familia, con amigos o en equipo.\r\nSalida en la calle Abel Gance, en el aparcamiento situado junto a la piscina municipal.\r\nAbierto a todos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parcours permanent d'orientation : le parcours urbain"
    ]
  },
