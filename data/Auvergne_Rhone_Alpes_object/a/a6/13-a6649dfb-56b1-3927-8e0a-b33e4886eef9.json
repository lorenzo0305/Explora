  "rdfs:comment": {
    "de": [
      "Nutzen Sie Ihren Aufenthalt in Aussois, um das Klettern im Klettergebiet Roche Moutche zu entdecken. Klettern an Felsblöcken in den Bergen oberhalb der Staudämme und am Fuße des Rateau d'Aussois."
    ],
    "en": [
      "Make the most of your stay in Aussois to discover rock climbing at Roche Moutche. Boulder climbing in the mountains above the dams and at the foot of the Rateau d'Aussois."
    ],
    "it": [
      "Approfittate del vostro soggiorno ad Aussois per scoprire l'arrampicata sulla Roche Moutche. Arrampicate sui massi nelle montagne sopra le dighe e ai piedi del Rateau d'Aussois."
    ],
    "fr": [
      "Profitez de votre séjour à Aussois pour découvrir l'escalade sur le site de Roche Moutche. Escalade sur blocs en montagne au-dessus des barrages et au pied du Rateau d'Aussois."
    ],
    "nl": [
      "Profiteer van je verblijf in Aussois om het rotsklimmen in Roche Moutche te ontdekken. Rotsklimmen in de bergen boven de stuwdammen en aan de voet van de Rateau d'Aussois."
    ],
    "es": [
      "Aproveche su estancia en Aussois para descubrir la escalada en Roche Moutche. Escalada en roca en las montañas por encima de las presas y al pie del Rateau d'Aussois."
    ]
  },
  "rdfs:label": {
    "en": [
      "Roche Moutche climbing site"
    ],
