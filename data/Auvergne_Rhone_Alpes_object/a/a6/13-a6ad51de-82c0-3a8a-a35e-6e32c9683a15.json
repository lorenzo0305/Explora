  "rdfs:comment": {
    "de": [
      "Ein Museum, das ganz den Heldentaten des Fliegers Adolphe Pégoud gewidmet ist, Pionier der Luftakrobatik, der 1913 den ersten Fallschirmsprung und den ersten Looping ausführte. Erstes Ass des 14-18-Krieges."
    ],
    "en": [
      "A museum entirely dedicated to the exploits of the aviator Adolphe Pégoud, pioneer of aerial acrobatics who performed the first parachute jump and the first looping in 1913. First Ace of the 14-18 war."
    ],
    "it": [
      "Un museo dedicato alle imprese dell'aviatore Adolphe Pégoud, pioniere dell'acrobazia aerea che nel 1913 effettuò il primo lancio e looping con il paracadute. Primo asso della guerra del 14-18. Una selezione di piloti contemporanei della regione dell'Isère."
    ],
    "fr": [
      "Un musée dédié aux exploits de l’aviateur Adolphe Pégoud, pionnier de l’acrobatie aérienne qui effectua le premier saut en parachute et le premier looping en 1913. Premier As de la guerre de 14-18. Évocation de quelques pilotes isérois contemporains."
    ],
    "es": [
      "Museo dedicado a las hazañas del aviador Adolphe Pégoud, pionero de las acrobacias aéreas, que realizó el primer salto y bucle en paracaídas en 1913. Primer as de la guerra 14-18. Una selección de pilotos contemporáneos de la región de Isère."
    ],
    "nl": [
      "Een museum gewijd aan de heldendaden van vliegenier Adolphe Pégoud, een pionier op het gebied van luchtacrobatiek die in 1913 de eerste parachutesprong en loop maakte. Eerste aas van de 14-18 oorlog. Een selectie van hedendaagse piloten uit de Isère."
    ]
  },
  "rdfs:label": {
    "de": [
      "Luftfahrtmuseum Pégoud"
    ],
    "en": [
      "Pégoud Museum"
    ],
    "fr": [
      "Musée Pégoud"
    ]
  },
