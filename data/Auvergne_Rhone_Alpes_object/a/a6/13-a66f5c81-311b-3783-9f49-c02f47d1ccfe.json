  "rdfs:comment": {
    "de": [
      "Eine Ausstellung nach meinem Bild: Sie spiegelt meine Anliegen, meine Inspirationen und eine tiefe Reflexion über die Zeit, die vergeht, und den Sinn des Lebens wider. Entdecken Sie meine neue Ausstellung: INSPIRATION TEMPORALITY CLIMATE."
    ],
    "en": [
      "An exhibition in my image: it reflects my concerns, my inspirations, and a deep reflection on the passage of time and the meaning of life. Discover my new exhibition: INSPIRATION TEMPORALITY CLIMATE."
    ],
    "it": [
      "Una mostra a mia immagine e somiglianza: riflette le mie preoccupazioni, le mie ispirazioni e una profonda riflessione sul passare del tempo e sul significato della vita. Scoprite la mia nuova mostra: ISPIRAZIONE TEMPORALITÀ CLIMA."
    ],
    "fr": [
      "Une exposition à mon image : Elle reflète mes préoccupations, mes inspirations, et une profonde réflexion sur le temps qui passe et le sens de la vie. Découvrez ma nouvelle exposition : INSPIRATION TEMPORALITÉ CLIMAT."
    ],
    "es": [
      "Una exposición a mi imagen: refleja mis inquietudes, mis inspiraciones y una profunda reflexión sobre el paso del tiempo y el sentido de la vida. Descubra mi nueva exposición: INSPIRACIÓN TEMPORALIDAD CLIMA."
    ],
    "nl": [
      "Een tentoonstelling naar mijn beeld: het weerspiegelt mijn zorgen, mijn inspiraties en een diepe reflectie over het verstrijken van de tijd en de zin van het leven. Ontdek mijn nieuwe tentoonstelling: INSPIRATIE TEMPORALITEIT KLIMAAT."
    ]
  },
