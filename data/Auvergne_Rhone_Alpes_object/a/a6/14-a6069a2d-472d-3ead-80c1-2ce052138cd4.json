  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/99a67153-57dd-3ad1-825d-a1ae910d2672",
      "dc:description": {
        "de": [
          "Das O?safran liegt ideal in der Nähe der Wassersportbasis Süd und bietet eine qualitativ hochwertige Speisekarte mit einer originellen Auswahl: handwerklich hergestellte Biere und Produkte aus lokaler Produktion."
        ],
        "en": [
          "Ideally located close to the southern nautical base, O?safran offers a quality menu with an original selection of craft beers and locally-produced products."
        ],
        "it": [
          "Situato in posizione ideale vicino alla base nautica sud, O?safran offre un menu di alta qualità con un'originale selezione di birre artigianali e prodotti locali."
        ],
        "fr": [
          "Idéalement situé près de la base nautique sud, O’safran propose une carte qualitative avec une sélection originale : bières artisanales & produits issus d’une production locale."
        ],
        "nl": [
          "O?safran is ideaal gelegen bij de zuidelijke nautische basis en biedt een menu van hoge kwaliteit met een originele selectie ambachtelijke bieren en lokaal geproduceerde producten."
        ],
        "es": [
          "Idealmente situado cerca de la base náutica sur, O?safran ofrece un menú de alta calidad con una original selección de cervezas artesanales y productos de producción local."
        ]
      },
