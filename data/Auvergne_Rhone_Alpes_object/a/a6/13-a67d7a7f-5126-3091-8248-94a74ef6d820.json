  "rdfs:comment": {
    "de": [
      "Schöne Gastronomie, Ausgewogenheit der Geschmäcker, Erbe und Know-how in diesem Panoramarestaurant La Rotonde, das den See überblickt. Eric Prowalski bietet eine feine Küche mit authentischen und lokalen Aromen, ohne seine Wurzeln im Südwesten zu vergessen."
    ],
    "en": [
      "Beautiful gastronomy, balance of flavours, heritage and know-how in this panoramic restaurant La Rotonde overlooking the lake. Eric Prowalski offers a fine cuisine with authentic and local flavours without forgetting his south-western roots."
    ],
    "it": [
      "Splendida gastronomia, equilibrio di sapori, patrimonio e know-how in questo ristorante panoramico La Rotonde con vista sul lago. Eric Prowalski propone una cucina raffinata dai sapori autentici e locali, senza dimenticare le sue radici sud-occidentali."
    ],
    "fr": [
      "Belle gastronomie, équilibre des saveurs, patrimoine et savoir-faire dans ce restaurant panoramique La Rotonde qui surplombe le lac. Eric Prowalski propose une cuisine fine aux saveurs authentiques et locales sans oublier ses racines du sud-ouest."
    ],
    "nl": [
      "Prachtige gastronomie, evenwicht van smaken, erfgoed en knowhow in dit panoramische restaurant La Rotonde met uitzicht op het meer. Eric Prowalski biedt een fijne keuken met authentieke en lokale smaken zonder zijn zuidwestelijke wortels te vergeten."
    ],
    "es": [
      "Hermosa gastronomía, equilibrio de sabores, herencia y saber hacer en este restaurante panorámico La Rotonde con vistas al lago. Eric Prowalski ofrece una cocina fina con sabores auténticos y locales sin olvidar sus raíces suroccidentales."
    ]
  },
