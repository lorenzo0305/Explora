  "rdfs:comment": {
    "de": [
      "Willkommen auf dem Heritage-Orientierungslauf an der Côte d'Aime!\r\nEntdecken Sie diese alten Dörfer, die Weinberge und Obstgärten dieses hochgelegenen Dorfes.\r\nEine leichte Strecke von 2,5 km mit 70mD+ und ihren 7 Markierungen."
    ],
    "en": [
      "Welcome to the orienteering course focusing on heritage around La Côte d'Aime!\r\nDiscover the old villages, the vineyards and orchards around this village nestled on the mountainside.\r\nAn easy course of 2.5 km and 70m elevation gain with 7 markers."
    ],
    "it": [
      "Benvenuti al corso di orientamento sul patrimonio della Côte d'Aime!\r\nScoprite gli antichi borghi, i vigneti e i frutteti di questo villaggio arroccato\r\nUn percorso facile di 2,5 km con 70 mD+ e 7 marcatori."
    ],
    "fr": [
      "Bienvenue sur le parcours d'orientation patrimoine sur la Côte d'Aime !\r\nDécouvrez ces villages anciens, les vignes et vergers de ce village perché\r\nUn parcours facile de 2,5km avec 70mD+ et ses 7 balises."
    ],
    "nl": [
      "Welkom bij het oriëntatieparcours van de Côte d'Aime!\r\nOntdek de oude dorpjes, wijngaarden en boomgaarden van dit dorp op een heuveltop.\r\nEen gemakkelijke route van 2,5 km met 70 m+ en 7 markeringen."
    ],
    "es": [
      "Bienvenido al curso de orientación sobre el patrimonio de la Côte d'Aime\r\nDescubra las antiguas aldeas, los viñedos y los huertos de este pueblo encaramado\r\nUn recorrido fácil de 2,5 km con 70mD+ y 7 balizas."
    ]
  },
  "rdfs:label": {
    "de": [
      "Orientierungslauf Kulturerbe an der Côte d'Aime - grüner Parcours"
    ],
    "en": [
      "Orienteering course focusing on heritage around La Côte d'Aime - green level"
    ],
    "fr": [
      "Parcours d'orientation Patrimoine sur la Côte d'Aime - parcours vert"
    ],
    "nl": [
      "Oriëntatieloop erfgoed op de Côte d'Aime - groene route"
    ]
  },
