  "rdfs:comment": {
    "de": [
      "In einem schlichten Rahmen empfängt Sie das Restaurant von Dienstag bis Freitag mittags mit seinen Tagesgerichten und Vorschlägen. Freitags und samstags bieten wir Ihnen eine umfangreiche Speisekarte an."
    ],
    "en": [
      "In a refined setting, the restaurant welcomes you with its daily specials and suggestions of the day, based on fresh produce. Excellent value for money and a warm welcome win over all the customers thisthis ideally located restaurant."
    ],
    "it": [
      "In un ambiente raffinato, il ristorante vi accoglie a pranzo dal martedì al venerdì con specialità e proposte del giorno. E il venerdì e il sabato sera con un menu più elaborato."
    ],
    "fr": [
      "Dans un cadre épuré, le restaurant vous accueille le midi du mardi au vendredi avec ses plats du jour et suggestions. Ainsi que le vendredi et samedi soir avec une carte plus élaborée."
    ],
    "nl": [
      "In een verfijnde omgeving verwelkomt het restaurant je met zijn dagschotels en kwaliteitssuggesties met verse producten. Veel waar voor je geld en een warm welkom zullen alle klanten van dit ideaal gelegen restaurant aanspreken."
    ],
    "es": [
      "En un ambiente refinado, el restaurante le recibe para almorzar de martes a viernes con platos del día y sugerencias. Y los viernes y sábados por la noche con un menú más elaborado."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ô Mouton à 5 pattes"
    ]
  },
