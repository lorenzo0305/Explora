  "rdfs:comment": {
    "de": [
      "Werfen Sie einen Blick hinter die Kulissen der Seilbahnen\r\nTeilen Sie einen einzigartigen Moment mit unseren Experten, die Ihnen einen Blick hinter die Kulissen der Seilbahn Vallandry gewähren. Zugang für Fußgänger und Skifahrer."
    ],
    "en": [
      "Take a behind-the-scenes tour of the ski lifts\r\nShare a unique moment with our experts, who will reveal what goes on behind the scenes at the Vallandry cable car. Access for pedestrians and skiers."
    ],
    "it": [
      "Dietro le quinte degli impianti di risalita\r\nCondividete un momento unico con i nostri esperti che vi porteranno dietro le quinte della cabinovia di Vallandry. Accesso per pedoni e sciatori."
    ],
    "fr": [
      "Visitez les coulisses des rémontées mécaniques\r\nPartagez un moment unique avec nos experts qui vous dévoileront l’envers du décor du télécabine Vallandry. Accès piétons et skieurs."
    ],
    "nl": [
      "Neem een kijkje achter de schermen van de skiliften\r\nBeleef een uniek moment met onze experts als ze je meenemen achter de schermen van de Vallandry gondellift. Toegang voor voetgangers en skiërs."
    ],
    "es": [
      "Entre bastidores de los remontes mecánicos\r\nComparta un momento único con nuestros expertos mientras le llevan entre bastidores del telecabina de Vallandry. Acceso para peatones y esquiadores."
    ]
  },
  "rdfs:label": {
    "en": [
      "Behind the scenes of Vallandry"
    ],
    "fr": [
      "Les coulisses de Vallandry"
    ]
  },
