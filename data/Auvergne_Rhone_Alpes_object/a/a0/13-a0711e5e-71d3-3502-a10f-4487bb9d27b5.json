  "rdfs:comment": {
    "de": [
      "Ein neuartiges Konzept für ein Sport- und Wellnessstudio, das überschaubar, modern und zu 100 % lokal ist.\r\nCardio, Krafttraining, Gruppenkurse, persönliche Betreuung: alles, was Sie brauchen, um in Ihrem Rhythmus Fortschritte zu machen, in einer motivierenden und sicheren Umgebung."
    ],
    "en": [
      "A new concept in fitness & well-being, on a human scale, modern and 100% local.\r\nCardio, weight training, group classes, personalized follow-up: everything you need to progress at your own pace, in a motivating, safe environment."
    ],
    "it": [
      "Un nuovo concetto di sport e benessere, a misura d'uomo, moderno e 100% locale.\r\nCardio, pesi, lezioni di gruppo, follow-up personalizzato: tutto ciò che serve per progredire al proprio ritmo, in un ambiente motivante e sicuro."
    ],
    "fr": [
      "Un concept inédit de salle de sport & bien-être, à taille humaine, moderne et 100 % local.\r\nCardio, musculation, cours collectifs, suivi personnalisé : tout ce qu'il faut pour progresser à votre rythme, dans un cadre motivant et sécurisé."
    ],
    "es": [
      "Un nuevo concepto de deporte y bienestar, a escala humana, moderno y 100% local.\r\nCardio, musculación, clases colectivas, seguimiento personalizado: todo lo que necesitas para progresar a tu ritmo, en un entorno motivador y seguro."
    ],
    "nl": [
      "Een nieuw concept in sport en welzijn, op menselijke schaal, modern en 100% lokaal.\r\nCardio, krachttraining, groepslessen, persoonlijke follow-up: alles wat je nodig hebt om op je eigen tempo vooruitgang te boeken, in een motiverende en veilige omgeving."
    ]
  },
  "rdfs:label": {
