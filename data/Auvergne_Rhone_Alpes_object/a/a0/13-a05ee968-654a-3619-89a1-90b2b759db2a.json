  "rdfs:comment": {
    "de": [
      "Die Garenne von Suze-la-Rousse ist ein 23 Hektar großer, bewaldeter Park mit zahlreichen Überresten, darunter eines der letzten noch existierenden Palmenspiele in Frankreich.\r\nDie Garenne ist ein vorrömisches Oppidum aus dem Lateinischen \"garenna\", provenzalisch \"gareno\", was so viel wie reservierter Wald bedeutet."
    ],
    "en": [
      "La garenne de Suze-la-Rousse is a vast 23-hectare wooded park dotted with remains, including one of the last remaining jeux de paume in France.\r\nLa garenne: pre-Roman oppida from the Latin \"garenna\", in Provençal \"gareno\", meaning reserved forest."
    ],
    "it": [
      "La garenne di Suze-la-Rousse è un vasto parco boscoso di 23 ettari, costellato di vestigia, tra cui uno degli ultimi giochi di paume rimasti in Francia.\r\nLa garenne: oppida preromana dal latino \"garenna\", in provenzale \"gareno\", che significa bosco riservato."
    ],
    "fr": [
      "La garenne de Suze-la-Rousse est un vaste parc boisé de 23 hectares, jalonné de vestiges, dont l’un des derniers jeux de paume subsistant en France.\r\nLa garenne : oppidapré-romain du latin « garenna », en provençal « gareno », signifiant forêt réservée."
    ],
    "es": [
      "La garenne de Suze-la-Rousse es un vasto parque arbolado de 23 hectáreas, salpicado de vestigios, entre ellos uno de los últimos juegos de paume que quedan en Francia.\r\nLa garenne: oppida prerromana del latín \"garenna\", en provenzal \"gareno\", que significa bosque reservado."
    ],
    "nl": [
      "De garenne in Suze-la-Rousse is een uitgestrekt bebost park van 23 hectare met overblijfselen, waaronder een van de laatste overgebleven paumeauspelen in Frankrijk.\r\nLa garenne: pre-Romeinse oppida van het Latijnse \"garenna\", in het Provençaals \"gareno\", wat gereserveerd bos betekent."
    ]
  },
