      "dc:description": {
        "de": [
          "Informationen :\n\nÖffnungstage:\n\nMontag bis Samstag: 6.30-19.30 Uhr\n\nSonntag geschlossen\n\n\nAbholung :\n\nZu den Öffnungszeiten des Geschäfts\n\n\n "
        ],
        "en": [
          "Information :\n\nOpening days:\n\nMonday to Saturday: 6:30am-7:30pm\n\nClosed on Sunday\n\n\nCollection:\n\nDuring store opening hours\n\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura:\n\nDa lunedì a sabato: 6.30-19.30\n\nChiuso la domenica\n\n\nRitiro:\n\nDurante gli orari di apertura del negozio\n\n\n "
        ],
        "fr": [
          "Informations :\n\nJours d'ouverture:\n\nDu lundi au samedi : 6h30-19h30\n\nFermeture le dimanche\n\n\nRetrait :\n\nAux horaires d'ouverture du magasin\n\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen:\n\nMaandag tot zaterdag: 6.30u-7.30u\n\nZondag gesloten\n\n\nOphalen:\n\nTijdens winkelopeningstijden\n\n\n "
        ],
        "es": [
          "Más información :\n\nDías de apertura:\n\nDe lunes a sábado: de 6.30 h. a 19.30 h\n\nDomingos cerrado\n\n\nRecogida:\n\nDurante el horario de apertura de la tienda\n\n\n "
        ]
      },
