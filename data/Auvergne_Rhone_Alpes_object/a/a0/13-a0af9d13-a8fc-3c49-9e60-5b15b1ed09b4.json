  "rdfs:comment": {
    "de": [
      "Innerhalb des Bump'N'Jump-Bereichs, der für alle Niveaus zugänglich ist, bietet Ihnen der Funny Run eine Fülle von Spielmodulen, um sich in aller Sicherheit zu amüsieren."
    ],
    "en": [
      "In the fun area Bump'N'Jump accessible to all levels, the Funny Run offers a host of various modules to have fun in complete safety."
    ],
    "it": [
      "Nella zona Bump'N'Jump, accessibile a tutti i livelli, Funny Run offre una serie di moduli divertenti per un divertimento sicuro."
    ],
    "fr": [
      "Au sein de la zone Bump'N'Jump accessible à tous les niveaux, le Funny Run vous propose une foule de modules ludiques pour s'amuser en toute sécurité."
    ],
    "nl": [
      "In het snowpark, dat leuk en toegankelijk is voor alle niveaus, biedt de minizone tal van leuke modules om in alle veiligheid te leren freestylen."
    ],
