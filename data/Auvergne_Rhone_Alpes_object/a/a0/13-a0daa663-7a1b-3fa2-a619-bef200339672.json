  "rdfs:comment": {
    "de": [
      "Ein anderer Laden, um \"anders zu spielen\". Spielzeug für das erste Lebensjahr, Geburtslisten, Plüschtiere, Gesellschaftsspiele, Geburtstagsgeschenke. Beratung, Ausbildung, Versand."
    ],
    "en": [
      "A different shop to \"play different\". First age toys, birth lists, cuddly toys, board games, birthday presents. Advice, training, shipping."
    ],
    "it": [
      "Un negozio diverso per \"giocare in modo diverso\". Giocattoli per neonati, liste nascita, peluche, giochi da tavolo, regali di compleanno. Consulenza, formazione, spedizione."
    ],
    "fr": [
      "Une boutique différente pour \"jouer différent\". Jouets 1er âge, listes de naissances, peluches, jeux de société, cadeaux d'anniversaire. Conseils, formation, expéditions."
    ],
    "es": [
      "Una tienda diferente para \"jugar diferente\". Juguetes para bebés, listas de nacimiento, peluches, juegos de mesa, regalos de cumpleaños. Asesoramiento, formación, envío."
    ],
    "nl": [
      "Een andere winkel voor \"anders spelen\". Speelgoed voor baby's, geboortelijsten, pluche speelgoed, bordspellen, verjaardagscadeaus. Advies, training, verzending."
    ]
  },
