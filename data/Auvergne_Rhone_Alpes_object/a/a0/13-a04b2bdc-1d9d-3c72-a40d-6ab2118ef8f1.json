  "rdfs:comment": {
    "de": [
      "Produktion und Direktverkauf von Bauernkäse aus Abondance. Besichtigung des Bauernhofs im Winter und der Alm im Sommer, Präsentation und Entdeckung der Käseverarbeitungswerkstatt und der Reifekeller."
    ],
    "en": [
      "Cheeses producer and direct marketing. Visit of the farm in winter and visit of high mountain pasture during summer time. Visit of the  cheese transformation workshop."
    ],
    "it": [
      "Produzione e vendita diretta di formaggio di fattoria Abondance. Visita della fattoria in inverno e dell'alpeggio in estate, presentazione e scoperta del laboratorio di lavorazione del formaggio e delle cantine di stagionatura."
    ],
    "fr": [
      "Fabrication et vente directe d'Abondance fermier. Visite de la ferme en hiver et de  l'alpage en été, présentation et découverte de l'atelier de transformation fromagère et des caves d'affinage."
    ],
    "nl": [
      "Productie en rechtstreekse verkoop van Abondance boerenkaas. Bezoek aan de boerderij in de winter en de bergweide in de zomer, presentatie en ontdekking van het kaasverwerkingsatelier en de rijpingskelders."
    ],
    "es": [
      "Producción y venta directa de queso de granja de Abondance. Visita a la granja en invierno y a los pastos de montaña en verano, presentación y descubrimiento del taller de elaboración de quesos y de las bodegas de maduración."
    ]
  },
