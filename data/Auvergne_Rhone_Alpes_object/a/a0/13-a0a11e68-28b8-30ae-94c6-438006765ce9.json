  "rdfs:comment": {
    "de": [
      "Kümmern Sie sich mit Manuia um Ihre Gesundheit: Naturheilkunde, Massagen und Pilates-Kurse. Gönnen Sie sich einen Wellnessurlaub, der auf Ihre Bedürfnisse zugeschnitten ist."
    ],
    "en": [
      "Take care of your health with Manuia: naturopathy, massages, and Pilates classes. Treat yourself to a wellness break tailored to your needs."
    ],
    "it": [
      "Prendetevi cura della vostra salute con Manuia: naturopatia, massaggi e autentiche lezioni di pilates su attrezzi e matwork. Concedetevi una pausa di benessere su misura per voi."
    ],
    "fr": [
      "Prenez soin de votre santé avec Manuia : naturopathie, massages et cours de pilates authentique sur appareil et en matwork. Offrez-vous une parenthèse bien-être au plus près de vos besoins."
    ],
    "nl": [
      "Zorg voor je gezondheid met Manuia: natuurgeneeskunde, massages en authentieke pilateslessen op apparaten en in matwerk. Gun jezelf een wellnessvakantie op maat."
    ],
    "es": [
      "Cuide su salud con Manuia: naturopatía, masajes y auténticas clases de pilates en aparatos y en colchoneta. Regálate una escapada de bienestar adaptada a tus necesidades."
    ]
  },
  "rdfs:label": {
