  "rdfs:comment": {
    "de": [
      "Kirche aus dem 15. Jahrhundert, Statue der Heiligen Anna aus polychromem Holz. Kapelle Notre-Dame-des-Grâces, Madonna mit Vogel aus dem 15. Jahrhundert (privat). Merowingische Nekropole von Mongebrout, Aussichtspunkt mit Panorama. Ehemalige Römerstraße."
    ],
    "en": [
      "15th-century church, polychrome wooden statue of Sainte-Anne. Notre-Dame-des-Grâces chapel, 15th-century Virgin with bird. 18th-century château (private). Mongebrout Merovingian necropolis, panoramic viewpoint. Ancient Roman road."
    ],
    "it": [
      "Chiesa del XV secolo, statua lignea policroma di Sainte-Anne. Cappella di Notre-Dame-des-Grâces, Vergine con uccello del XV secolo. Castello del XVIII secolo (privato). Necropoli merovingia di Mongebrout, punto panoramico. Antica strada romana."
    ],
    "fr": [
      "Église du XVe siècle, statue de Sainte-Anne en bois polychrome. Chapelle Notre-Dame-des-Grâces, Vierge à l’oiseau du XVe siècle. Château du XVIIIe siècle (privé). Nécropole mérovingienne du Mongebrout, point de vue avec panorama. Ancienne voie romaine."
    ],
    "es": [
      "Iglesia del siglo XV, estatua de madera policromada de Sainte-Anne. Capilla Notre-Dame-des-Grâces, Virgen con pájaro del siglo XV. Castillo del siglo XVIII (privado). Necrópolis merovingia de Mongebrout, mirador. Antigua calzada romana."
    ],
    "nl": [
      "15e-eeuwse kerk, polychroom houten beeld van Sainte-Anne. Kapel Notre-Dame-des-Grâces, 15e-eeuwse Maagd met vogel. 18e-eeuws kasteel (privé). Merovingische necropolis van Mongebrout, panoramisch uitkijkpunt. Oude Romeinse weg."
    ]
  },
