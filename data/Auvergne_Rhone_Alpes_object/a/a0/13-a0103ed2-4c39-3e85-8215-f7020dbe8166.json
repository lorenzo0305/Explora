  "rdfs:comment": {
    "de": [
      "\"Le Relais de l'Abbaye\" hotel***, Hôtel Élégance et Table Distinguée Logis de France lädt Sie ein, einen Moment der Entspannung und Ruhe zu verbringen, in einem raffinierten und zeitgemäßen Rahmen, mit Zugang für Personen mit eingeschränkter Mobilität."
    ],
    "en": [
      "\"The Abbey Relais\" 3 star hotel, Logis de France (quality label) invites you to spend a moment of relaxation and tranquility in a refined and contemporary setting, fully renovated with disabled access."
    ],
    "it": [
      "\"Le Relais de l'Abbaye\", hotel 3 stelle, Hôtel Élégance e Logis de France Distinguished Table, vi invita a trascorrere un momento di relax e tranquillità in un ambiente raffinato e contemporaneo, con accesso per persone a mobilità ridotta."
    ],
    "fr": [
      "\"Le Relais de l'Abbaye\" hôtel***, Hôtel Élégance et Table Distinguée Logis de France vous invite à passer un moment de détente et tranquillité, dans un cadre raffiné et contemporain, avec accès aux personnes à mobilité réduite."
    ],
    "es": [
      "\"Le Relais de l'Abbaye\", hotel de 3 estrellas, Hôtel Élégance y Mesa Distinguida Logis de France, le invita a pasar un momento de relajación y tranquilidad en un entorno refinado y contemporáneo, con acceso para personas con movilidad reducida."
    ],
    "nl": [
      "\"Le Relais de l'Abbaye\", een 3-sterrenhotel, Hôtel Élégance en Logis de France Distinguished Table, nodigt u uit voor een moment van ontspanning en rust in een verfijnde, eigentijdse omgeving, met toegang voor mensen met beperkte mobiliteit."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Relais de l'Abbaye***"
    ]
  },
