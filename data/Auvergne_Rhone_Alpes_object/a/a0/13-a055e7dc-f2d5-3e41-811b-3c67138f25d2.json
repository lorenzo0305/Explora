  "rdfs:comment": {
    "de": [
      "Begleitete Ausflüge mit geländegängigen Elektrorollern in der Region Sud Grésivaudan, Terres de Berlioz und Chambarans (38). Ab 14 Jahren mit verschiedenen Schwierigkeitsgraden: Entdeckung, Mittelstufe oder technisch anspruchsvoller. Dauer: 1 Stunde, 1,5 Stunden oder 2 Stunden."
    ],
    "en": [
      "Supervised all-terrain electric scooter rides in the Royans and Chambarans regions of Isère. Several routes are available, from age 14 upwards, with different levels of difficulty: from discovery rides to more challenging outings."
    ],
    "it": [
      "Uscite supervisionate in monopattino elettrico fuoristrada nelle regioni Sud Grésivaudan, Terres de Berlioz e Chambarans (38). A partire dai 14 anni, con diversi livelli di difficoltà: scoperta, intermedio o più tecnico. Durata: 1h; 1h30 o 2h00."
    ],
    "fr": [
      "Balades encadrées en trottinette électrique tout terrain région du Sud Grésivaudan, Terres de Berlioz et des Chambarans (38). Dès 14 ans avec plusieurs niveaux de difficultés : découverte, intermédiaire ou plus technique. Durées : 1h ; 1h30 ou 2h00."
    ],
    "es": [
      "Salidas supervisadas en scooter eléctrico todo terreno por las regiones de Sud Grésivaudan, Terres de Berlioz y Chambarans (38). A partir de 14 años, con varios niveles de dificultad: descubrimiento, intermedio o más técnico. Duración: 1h; 1h30 o 2h00."
    ],
    "nl": [
      "Begeleide off-road tochten met een elektrische step in de regio's Royans en Chambarans in Isère. Er worden verschillende routes aangeboden, toegankelijk vanaf 14 jaar, met verschillende moeilijkheidsgraden: van ontdekkingstochten tot meer uitdagende tochten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "2 Roues évasion"
    ]
  },
