  "rdfs:comment": {
    "de": [
      "Die Kirche Saint-Nicolas liegt oberhalb des Dorfes auf der alten Burgmotte. Bemerkenswert ist ihr Glockenturm im alpinen Stil, der im 19. Jahrhundert erneuert wurde. Auf dem Gipfel des Hügels befindet sich ein Orientierungstisch, der einen Panoramablick auf die Umgebung bietet."
    ],
    "en": [
      "The Saint-Nicolas church is perched at the top of the village on the ancient motte castrale. Its remarkable Alpine-style bell tower was rebuilt in the 19th century. At the top of the mound, an orientation table offers a panoramic view of the surrounding area."
    ],
    "it": [
      "La chiesa di Saint-Nicolas è arroccata in cima al villaggio sull'antica motte castrale. Si distingue per il suo campanile in stile alpino, ricostruito nel XIX secolo. In cima al tumulo, un tavolo di orientamento offre una vista panoramica dei dintorni."
    ],
    "fr": [
      "L'église Saint-Nicolas est perchée en haut du village sur l'ancienne motte castrale. Elle est remarquable par son clocher de type alpin refait au XIXe siècle. Au sommet de la butte, une table d'orientation offre une vue panoramique sur les alentours."
    ],
    "es": [
      "La iglesia de Saint-Nicolas se alza en lo alto del pueblo, sobre la antigua motte castrale. Destaca por su campanario de estilo alpino, reconstruido en el siglo XIX. En lo alto del montículo, una mesa de orientación ofrece una vista panorámica de los alrededores."
    ],
    "nl": [
      "De kerk Saint-Nicolas staat boven in het dorp op de oude motte castrale. De opmerkelijke klokkentoren in alpine stijl werd herbouwd in de 19e eeuw. Op de top van de heuvel biedt een oriëntatietafel een panoramisch uitzicht over de omgeving."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Eglise Saint-Nicolas"
    ]
  },
