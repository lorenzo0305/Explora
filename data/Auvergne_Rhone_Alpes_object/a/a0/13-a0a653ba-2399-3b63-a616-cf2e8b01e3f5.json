  "rdfs:comment": {
    "de": [
      "2-Sterne-Hotel kurz vor der Ankunft in Valloire über den Col du télégraphe.\r\nRuhige Terrasse mit Panoramablick.\r\n12 Zimmer, großer Parkplatz.\r\nDojo im Hotel, das in einen Empfangsraum umgewandelt werden kann!"
    ],
    "en": [
      "2-star hotel located just before arriving in Valloire from the Telegraphe pass.\r\nQuiet terrace with panoramic view.\r\nAmple parking.\r\nDojo in the hotel can be converted into a reception room!"
    ],
    "it": [
      "Hotel a 2 stelle situato poco prima di arrivare a Valloire dal Col du Télégraphe.\r\nTerrazza tranquilla con vista panoramica.\r\nAmpio parcheggio.\r\nDojo dell'hotel che può essere trasformato in sala ricevimenti!"
    ],
    "fr": [
      "Hôtel 2 étoiles situé juste avant d’arriver à Valloire par le col du télégraphe.\r\nTerrasse calme avec vue panoramique.\r\n12 chambres, grand parking.\r\nDojo dans l’hôtel transformable en salle de réception!"
    ],
    "es": [
      "Hotel de 2 estrellas situado justo antes de llegar a Valloire por el Col du Télégraphe.\r\nTerraza tranquila con vistas panorámicas.\r\n12 habitaciones, amplio aparcamiento.\r\nDojo en el hotel que puede convertirse en salón de actos"
    ],
    "nl": [
      "2-sterrenhotel gelegen vlak voor aankomst in Valloire vanaf de Col du Télégraphe.\r\nRustig terras met panoramisch uitzicht.\r\nRuime parkeergelegenheid.\r\nDojo in het hotel die kan worden omgebouwd tot receptieruimte!"
    ]
  },
