  "rdfs:comment": {
    "de": [
      "Wir bieten Ihnen biologisches und saisonales Gemüse an. Wir sind das ganze Jahr über samstags vormittags auf dem Bauernmarkt in Monistrol-sur-Loire vertreten. Verkauf auf dem Bauernhof am Freitagabend von 18 bis 20 Uhr."
    ],
    "en": [
      "We offer organic and seasonal vegetables. We are present at the Monistrol-sur-Loire farmers' market on Saturday mornings throughout the year. Sales at the farm on Friday evenings from 6pm to 8pm."
    ],
    "it": [
      "Offriamo verdure biologiche e di stagione. Siamo presenti al mercato contadino di Monistrol-sur-Loire il sabato mattina durante tutto l'anno. Vendita in fattoria il venerdì sera dalle 18.00 alle 20.00."
    ],
    "fr": [
      "Nous vous proposons des  légumes bio et de saison. Nous sommes présents sur le marché de producteurs de Monistrol-sur-Loire les samedis matins toute l’année . Vente à la ferme le vendredi soir de 18h à 20h."
    ],
    "nl": [
      "Wij bieden biologische seizoensgroenten. We zijn het hele jaar door op zaterdagochtend aanwezig op de boerenmarkt van Monistrol-sur-Loire. Verkoop op de boerderij op vrijdagavond van 18.00 tot 20.00 uur."
    ],
    "es": [
      "Ofrecemos verduras ecológicas de temporada. Estamos presentes en el mercado agrícola de Monistrol-sur-Loire los sábados por la mañana durante todo el año. Venta en la granja los viernes por la tarde de 18:00 a 20:00."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Au Jardin Laptois"
    ]
  },
