  "rdfs:comment": {
    "de": [
      "Das 66. Bergrennen von Mont-Dore ? Chambon-sur-Lac lässt den Sancy vibrieren: 210 außergewöhnliche Fahrer, eine legendäre Strecke und ein intensives Spektakel im Herzen der Vulkane. Starke Gefühle sind garantiert!"
    ],
    "en": [
      "Event counting for the French Mountain Championship.\r\nThe Mont-Dore hill climb race thrills thousands of enthusiasts in the Sancy massif."
    ],
    "it": [
      "La 66a Course de Côte du Mont-Dore ? Chambon-sur-Lac entusiasma il Sancy: 210 piloti eccezionali, un percorso leggendario e uno spettacolo intenso nel cuore dei vulcani. Emozioni garantite!"
    ],
    "fr": [
      "La 66e Course de Côte du Mont-Dore – Chambon-sur-Lac fait vibrer le Sancy : 210 pilotes d’exception, tracé mythique et spectacle intense au cœur des volcans. Sensations fortes garanties !"
    ],
    "es": [
      "La 66ª edición de la Course de Côte du Mont-Dore ? Chambon-sur-Lac emociona al Sancy: 210 pilotos excepcionales, un recorrido legendario y un espectáculo intenso en el corazón de los volcanes. ¡Emoción garantizada!"
    ],
    "nl": [
      "De 66e Course de Côte du Mont-Dore ? Chambon-sur-Lac brengt de Sancy in vervoering: 210 uitzonderlijke coureurs, een legendarisch parcours en een intens spektakel in het hart van de vulkanen. Sensatie gegarandeerd!"
    ]
  },
  "rdfs:label": {
    "en": [
      "Hill climb race Mont-Dore Chambon-sur-Lac"
    ],
    "fr": [
      "Course de côte internationale du Mont-Dore Chambon-sur-Lac"
    ]
  },
