  "rdfs:comment": {
    "de": [
      "Dorf Mazérat-Aurouze: Priorat aus dem 12. Jahrhundert (privat). Romanische Kirche, die im 14. Jahrhundert umgebaut wurde, mit Wandmalereien. Standort des Schlosses von Aubusson. Chapelle de la Brequeuille mit Madonna mit Kind aus dem 15."
    ],
    "en": [
      "Village of Mazérat-Aurouze: 12th-century priory (private). 14th-century Romanesque church with murals. Château d?Aubusson site. Chapelle de la Brequeuille with 15th-century Virgin and Child."
    ],
    "it": [
      "Villaggio di Mazérat-Aurouze: priorato del XII secolo (privato). Chiesa romanica modificata nel XIV secolo con dipinti murali. Sito del castello di Aubusson. Cappella di La Brequeuille con Vergine e Bambino del XV secolo."
    ],
    "fr": [
      "Village de Mazérat-Aurouze : Prieuré du XIIe siècle (privé). Église romane remaniée au XIVe siècle avec peintures murales. Site du château d’Aubusson. Chapelle de la Brequeuille avec Vierge à l’Enfant du XVe siècle."
    ],
    "es": [
      "Pueblo de Mazérat-Aurouze: priorato del siglo XII (privado). Iglesia románica modificada en el siglo XIV con pinturas murales. Emplazamiento del castillo de Aubusson. Capilla de la Brequeuille con la Virgen y el Niño del siglo XV."
    ],
    "nl": [
      "Dorp Mazérat-Aurouze: 12e-eeuwse priorij (privé). Romaanse kerk uit de 14e eeuw met muurschilderingen. Plaats van het kasteel van Aubusson. Kapel van La Brequeuille met 15e-eeuwse Maagd met kind."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Village | Mazérat-Aurouze"
    ]
  },
