  "rdfs:comment": {
    "de": [
      "Heiße Glasverarbeitung, Herstellung von Bildern, Skulpturen und Schmuck aus Glas.\r\nGroße Auswahl an hochwertigen Einzelstücken und Möglichkeit zur Anfertigung individueller Stücke (auf Bestellung)."
    ],
    "en": [
      "Glass firing work to make artwork, sculptures and jewellery out of glass. \r\nWide range of quality unique pieces and bespoke items (on request)."
    ],
    "it": [
      "Lavorazione del vetro a caldo, creazione di dipinti, sculture e gioielli in vetro.\r\nAmpia scelta di pezzi unici di qualità e possibilità di realizzare pezzi personalizzati (su ordinazione)."
    ],
    "fr": [
      "Travail du verre à chaud, création de tableaux, sculptures et bijoux en verre.\r\nLarge choix de pièces uniques de qualité, et possibilité de réalisation de pièces personnalisées (sur commande)."
    ],
    "es": [
      "Trabajo en vidrio caliente, creación de cuadros, esculturas y joyas en vidrio.\r\nAmplia selección de piezas únicas de calidad, y posibilidad de hacer piezas personalizadas (por encargo)."
    ],
    "nl": [
      "Heet glaswerk, creatie van schilderijen, beelden en juwelen in glas.\r\nGrote keuze aan unieke kwaliteitsstukken, en mogelijkheid om stukken op maat te maken (op bestelling)."
    ]
  },
