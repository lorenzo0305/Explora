  "rdfs:comment": {
    "de": [
      "Der Dokumentationsbestand umfasst mehr als 5000 Bücher, plus 4000 in Rotation mit der Mediathek von Crest. Die Leser können die Titel, die sie finden möchten, anfordern und uns ihre \"Coups de coeur\" mitteilen. Internetzugang: 3€ pro Stunde."
    ],
    "en": [
      "The library's holdings include over 5,000 books, plus 4,000 in rotation with the Crest Médiathèque. Readers can request the titles they'd like to find and tell us about their \"Coups de coeur\". Internet access: €3 per hour."
    ],
    "it": [
      "La collezione della biblioteca comprende più di 5.000 libri, oltre a 4.000 in rotazione con la Crest Media Library. I lettori possono chiedere i titoli che desiderano trovare e raccontarci i loro \"Coups de coeur\". Accesso a Internet: 3? all'ora."
    ],
    "fr": [
      "Le fonds documentaire comprend plus de 5000 ouvrages, plus 4000 en rotation avec la Médiathèque de Crest. Les lecteurs peuvent demander les titres qu'ils souhaitent trouver et nous faire part de leurs « Coups de coeur ». Accès à internet : 3€ l'heure."
    ],
    "es": [
      "La colección de la biblioteca incluye más de 5.000 libros, más 4.000 en rotación con la Mediateca Crest. Los lectores pueden pedir los títulos que quieran encontrar y contarnos sus \"Coups de coeur\". Acceso a Internet: 3? por hora."
    ],
    "nl": [
      "De bibliotheek heeft meer dan 5.000 boeken, plus 4.000 boeken die worden gerouleerd in de Crest-multimediabibliotheek. Lezers kunnen vragen naar de titels die ze willen vinden en ons vertellen over hun favorieten. Internettoegang: €3 per uur."
    ]
  },
  "rdfs:label": {
