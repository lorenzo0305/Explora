  "rdfs:comment": {
    "de": [
      "Le Séquoia bietet Ihnen einen Empfangsraum für Ihre Ehrenweine, Zeremonien, Aperitifs usw. an. Der Saal ist ebenerdig und öffnet sich zu einem großen, vollständig geschlossenen Park mit Bäumen."
    ],
    "en": [
      "Le Séquoia offers a reception room for your receptions, ceremonies, aperitifs... All on one level, it opens onto a large enclosed park planted with trees."
    ],
    "it": [
      "Le Séquoia offre una sala per ricevimenti, cerimonie, aperitivi, ecc. Tutta su un unico livello, si apre su un grande parco alberato e completamente recintato."
    ],
    "fr": [
      "Le Séquoia vous propose une salle de réception pour vos vins d'honneurs, cérémonies, apéritifs... De plein pied, elle s'ouvre sur un grand parc arboré entièrement clos."
    ],
    "es": [
      "Le Séquoia le ofrece una sala de recepción para sus recepciones, ceremonias, aperitivos, etc. Todo en una sola planta, se abre a un gran parque arbolado y totalmente cerrado."
    ],
    "nl": [
      "Le Séquoia biedt een receptieruimte voor uw recepties, ceremonies, aperitieven, enz. De zaal is volledig gelijkvloers en geeft uit op een groot, bebost en volledig omheind park."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Salle de réception Le Séquoia"
    ]
  },
