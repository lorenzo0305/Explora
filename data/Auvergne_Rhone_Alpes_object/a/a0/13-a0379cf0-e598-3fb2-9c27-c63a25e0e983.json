  "rdfs:comment": {
    "de": [
      "Die Kapelle Saint-Clair wurde 1888 auf den Grundmauern einer alten Kapelle errichtet, die bereits 1633 existierte. Sie wurde am 13. August 1894 geweiht und durch Spenden der Einwohner der Pfarrei errichtet."
    ],
    "en": [
      "St. Clair's Chapel was built in 1888 on the foundations of an old chapel that existed in 1633. It was consecrated on 13 August 1894 and was built with donations from the parish's inhabitants."
    ],
    "it": [
      "La cappella di Saint-Clair fu costruita nel 1888 sulle fondamenta di una cappella precedente, risalente al 1633. Fu consacrata il 13 agosto 1894 e costruita con le donazioni dei parrocchiani."
    ],
    "fr": [
      "La chapelle Saint-Clair fut construite en 1888 sur les bases d'une ancienne chapelle qui existait en 1633. Elle fut consacrée le 13 août 1894 et édifiée par les dons des habitants de la paroisse."
    ],
    "es": [
      "La capilla de Saint-Clair se construyó en 1888 sobre los cimientos de una capilla anterior que databa de 1633. Fue consagrada el 13 de agosto de 1894 y construida con donativos de los feligreses."
    ],
    "nl": [
      "De kapel van St. Clair werd in 1888 gebouwd op de fundamenten van een oude kapel uit 1633. Ze werd ingewijd op 13 augustus 1894 en gebouwd met giften van de parochianen."
    ]
  },
