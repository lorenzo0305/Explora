  "rdfs:comment": {
    "de": [
      "Jazz à Vienne lädt Sie zur 45. Ausgabe des Festivals im Jahr 2026 ein! Jedes Jahr kommen mehr als 220.000 Festivalbesucher, um die 1.000 Künstler zu treffen, die auf vier Bühnen auftreten, darunter die legendärste: das Théâtre Antique."
    ],
    "en": [
      "Jazz à Vienne looks forward to seeing you at the 45th edition of the festival in 2026! Every year, over 220,000 festival-goers come to meet the 1,000 artists performing on 4 stages, including the most legendary: the Théâtre Antique."
    ],
    "it": [
      "Jazz à Vienne vi aspetta per la 45ª edizione del festival nel 2026! Ogni anno, oltre 220.000 spettatori vengono a godersi i 1.000 artisti che si esibiscono su 4 palchi, tra cui il più leggendario: il Théâtre Antique."
    ],
    "fr": [
      "Jazz à Vienne vous donne rendez-vous pour la 45eme édition du festival en 2026 ! Chaque année, ce sont plus de 220 000 festivaliers qui viennent à la rencontre des 1 000 artistes se produisant sur 4 scènes dont la plus mythique : le Théâtre Antique."
    ],
    "es": [
      "Jazz à Vienne le espera en la 45ª edición del festival en 2026 Cada año, más de 220.000 festivaleros acuden a disfrutar de los 1.000 artistas que actúan en 4 escenarios, incluido el más legendario: el Théâtre Antique."
    ],
    "nl": [
      "Jazz à Vienne kijkt ernaar uit je te zien op de 45e editie van het festival in 2026! Elk jaar komen meer dan 220.000 festivalgangers genieten van de 1.000 artiesten die optreden op 4 podia, waaronder het meest legendarische: het Théâtre Antique."
    ]
  },
