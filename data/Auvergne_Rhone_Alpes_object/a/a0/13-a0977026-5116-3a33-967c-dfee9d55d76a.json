  "rdfs:comment": {
    "de": [
      "Respire ist ein familienfreundliches und geselliges Wellness-Festival.\r\nEs stellt die Wellness-Praktiker des Vichyssoiser Beckens in den Vordergrund und bietet dem Publikum die Möglichkeit, die vielfältigen und zahlreichen Praktiken im Bereich Wellness zu entdecken."
    ],
    "en": [
      "Respire is a family-friendly wellness festival.\r\nIt showcases wellness practitioners from the Vichy area, offering the public the chance to discover a wide range of wellness practices."
    ],
    "it": [
      "Respire è un festival del benessere adatto alle famiglie.\r\nPresenta gli operatori del benessere della zona di Vichy e offre al pubblico la possibilità di scoprire un'ampia gamma di pratiche di benessere."
    ],
    "fr": [
      "Respire est un festival de bien-être, familial et convivial. \r\nIl met en avant les praticiens du bien-être du bassin vichyssois et propose au public de découvrir des pratiques variées et nombreuses dans le bien-être."
    ],
    "nl": [
      "Respire is een gezinsvriendelijk welzijnsfestival.\r\nHet presenteert welzijnswerkers uit de omgeving van Vichy en geeft het publiek de kans om een breed scala aan welzijnspraktijken te ontdekken."
    ],
    "es": [
      "Respire es un festival de bienestar para toda la familia.\r\nPresenta a los profesionales del bienestar de la región de Vichy y ofrece al público la oportunidad de descubrir una amplia gama de prácticas de bienestar."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Festival Respire"
    ]
  },
