  "rdfs:comment": {
    "de": [
      "Das Enquête-Game ist eine Art Escape-Game im Freien... Mit Ihrem Detektivkoffer ausgerüstet geht es auf ins Abenteuer!\r\nEntdecken Sie auf spielerische Weise das Leben auf den Feldern und die biologische Vielfalt.\r\nEmpfohlenes Mindestalter: 7 Jahre."
    ],
    "en": [
      "The Enquête-Game is a kind of outdoor escape-game... Equipped with your detective's kit, it's time for adventure!\r\nDiscover life in the fields and biodiversity in a fun way.\r\nMinimum recommended age 7."
    ],
    "it": [
      "L'Enquête-Game è una sorta di gioco di fuga all'aperto... Armati del vostro kit da detective, è ora di partire all'avventura!\r\nScoprite la vita nei campi e la biodiversità in modo divertente.\r\nEtà minima consigliata 7 anni."
    ],
    "fr": [
      "L'Enquête-Game est une sorte d'escape-game en extérieur...Muni de votre mallette de détective à vous l'aventure !\r\nPartez à la découverte de la vie des champs et de la biodiversité de façon ludique.\r\nAge minimum conseillé 7 ans."
    ],
    "es": [
      "El Enquête-Game es una especie de juego de escape al aire libre... Armado con tu equipo de detective, ¡es hora de lanzarse a la aventura!\r\nDescubre la vida en el campo y la biodiversidad de forma divertida.\r\nEdad mínima recomendada: 7 años."
    ],
    "nl": [
      "De Enquête-Game is een soort outdoor ontsnappingsspel... Gewapend met je detectiveset is het tijd voor een avontuur!\r\nOntdek op een leuke manier het leven in de velden en de biodiversiteit.\r\nAanbevolen minimumleeftijd 7 jaar."
    ]
  },
