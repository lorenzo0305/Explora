      "dc:description": {
        "de": [
          "Informationen :\n\nÖffnungstage :\n\nMittwochmorgen\nSonntagmorgen: Anwesenheit des Primeur\n\nEinzelhändler:\nHauptsächlich Lebensmittelhändler\n\n\n "
        ],
        "en": [
          "Information :\n\nOpening days :\n\nWednesday mornings\nSunday mornings: The greengrocer is present\n\nShopkeepers :\nMainly food retailers\n\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura :\n\nMercoledì mattina\nDomenica mattina: è presente il fruttivendolo\n\nNegozianti :\nPrincipalmente rivenditori di generi alimentari\n\n\n "
        ],
        "fr": [
          "Informations :\n\nJours d'ouverture :\n\nLe mercredi matin\nLe dimanche matin : Présence du primeur\n\nCommerçants : \nPrincipalement des commerçants alimentaires\n\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen :\n\nWoensdagochtend\nZondagochtend: De groenteboer is aanwezig\n\nWinkeliers :\nVoornamelijk levensmiddelenwinkels\n\n\n "
        ],
        "es": [
          "Más información :\n\nDías de apertura :\n\nMiércoles por la mañana\nDomingos por la mañana: El frutero está presente\n\nComerciantes :\nPrincipalmente minoristas de alimentación\n\n\n "
        ]
      },
