  "rdfs:comment": {
    "de": [
      "Unser Chefkoch, Maître Restaurateur, bietet Ihnen eine gelungene Mischung aus traditioneller französischer Küche und regionalen Inspirationen aus dem Jura, aus Savoyen oder Spezialitäten aus dem Genferseebecken. Jeder wird etwas finden, um seinen Gaumen zu verwöhnen!"
    ],
    "en": [
      "The restaurant offers a spacious dining room with large bay windows. Our chef, Maître Restaurateur, serves a clever mix of traditional French cuisine and regional Jura, Savoyard and Lake Geneva specialities. There is something for everyone!\r\nTerrace in summer and according to the weather."
    ],
    "it": [
      "Il nostro chef, un maestro ristoratore, propone un sapiente mix di cucina tradizionale francese e di ispirazione regionale dal Giura, dalla Savoia e dalla regione del Lago di Ginevra. Tutti troveranno qualcosa per deliziare il proprio palato!"
    ],
    "fr": [
      "Notre chef, Maître Restaurateur, vous propose un savant mélange entre cuisine traditionnelle française et inspirations régionales jurassiennes, savoyardes ou spécialités du bassin lémanique. Chacun saura trouver de quoi régaler ses papilles !"
    ],
    "nl": [
      "Onze chef, een Meester Restaurateur, biedt een slimme mix van de traditionele Franse keuken en regionale inspiratie uit de Jura, Savoie en de regio van het Meer van Genève. Iedereen zal iets vinden om zijn smaakpapillen te verwennen!"
    ],
    "es": [
      "Nuestro chef, maestro restaurador, ofrece una inteligente mezcla de cocina tradicional francesa e inspiración regional del Jura, Saboya y la región del lago Lemán. Todo el mundo encontrará algo que deleite su paladar"
    ]
  },
  "rdfs:label": {
    "en": [
      "Restaurant Bois Joly"
    ],
    "fr": [
      "Restaurant Bois Joly"
    ]
  },
