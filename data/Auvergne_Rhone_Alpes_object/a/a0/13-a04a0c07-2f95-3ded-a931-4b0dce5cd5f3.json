  "rdfs:comment": {
    "de": [
      "Wir empfangen Sie auf dem Gelände des Vitam in einem geräumigen und hellen Raum, in dem Sie zahlreiche Broschüren über die Region Monts du Genevois und Haute Savoie finden. Finden Sie auch den Veranstaltungskalender des Sektors!"
    ],
    "en": [
      "We welcome you to Vitam's spacious and bright premises, where you'll find a wide range of brochures on the Monts du Genevois and Haute Savoie regions. You'll also find a calendar of events for the area!"
    ],
    "it": [
      "Vi diamo il benvenuto negli ampi e luminosi locali di Vitam, dove troverete un'ampia gamma di opuscoli sul Monts du Genevois e sull'Alta Savoia. Troverete anche un calendario degli eventi della zona!"
    ],
    "fr": [
      "Un espace moderne et accueillant au cœur du Genevois. Il invite à vivre des expériences simples et authentiques, avec une documentation en libre-service toute l’année toute l’année et des dispositifs ludiques pour guider les visiteurs en toute autonomie."
    ],
    "es": [
      "Le damos la bienvenida a los amplios y luminosos locales de Vitam, donde encontrará una amplia gama de folletos sobre los Monts du Genevois y la Alta Saboya. También encontrará un calendario de eventos de la zona."
    ],
    "nl": [
      "Een moderne, gastvrije ruimte in het hart van de regio Genève. Het nodigt bezoekers uit om te genieten van eenvoudige, authentieke ervaringen, met zelfbedieningsdocumentatie die het hele jaar door beschikbaar is en leuke functies om bezoekers zelf de weg te wijzen."
    ]
  },
  "rdfs:label": {
    "de": [
