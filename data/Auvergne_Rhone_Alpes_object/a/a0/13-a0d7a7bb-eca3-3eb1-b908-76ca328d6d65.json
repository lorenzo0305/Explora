  "rdfs:comment": {
    "de": [
      "Wir freuen uns, Sie in unserem Tourismusbüro begrüßen zu dürfen. Hier finden Sie alle Informationen, die Sie brauchen, um Ihren Aufenthalt in unserem Ort im Winter wie im Sommer bestmöglich zu organisieren!"
    ],
    "en": [
      "We welcome you with pleasure in the Tourist Office. Here you will find all the information you need to better organize your stay in our resort in winter and summer!"
    ],
    "it": [
      "Siamo lieti di darvi il benvenuto all'Ufficio del Turismo. Qui troverete tutte le informazioni necessarie per organizzare il vostro soggiorno nella nostra località in inverno e in estate!"
    ],
    "fr": [
      "Nous vous accueillons avec plaisir au sein de l'Office de Tourisme. Vous trouverez ici toutes les informations dont vous aurez besoin pour organiser au mieux votre séjour dans notre station en hiver comme en été !"
    ],
    "nl": [
      "We heten je van harte welkom bij het Office du Tourisme. Hier vind je alle informatie die je nodig hebt om optimaal te genieten van je verblijf in ons resort, zowel in de winter als in de zomer!"
    ],
    "es": [
      "Nos complace recibirle en la Oficina de Turismo. Aquí encontrará toda la información necesaria para organizar su estancia en nuestra estación, tanto en invierno como en verano"
    ]
  },
