  "rdfs:comment": {
    "de": [
      "Der Square befindet sich auf der Rückseite des Centre Bonlieu und hat die Besonderheit, dass er einen kleinen schattigen und grünen Platz im Herzen der Stadt mit einem Brunnen in der Mitte bietet. Der Eingang zum Forum Exposition Bonlieu, zeitgenössische Kunst, befindet sich auf der Seite des Platzes."
    ],
    "en": [
      "Located at the back of the Bonlieu Center, the square has the particularity of offering a small shaded and green square in the heart of the city, with a fountain in its center. The entrance to the Bonlieu Exhibition Forum, contemporary art, is on the square side."
    ],
    "it": [
      "Situata sul retro del Centro Bonlieu, la piazza ha la particolarità di offrire una piccola piazza verde e ombreggiata nel cuore della città, con una fontana al centro. L'ingresso del Bonlieu Exhibition Forum, arte contemporanea, si trova sul lato della piazza."
    ],
    "fr": [
      "Situé à l'arrière du Centre Bonlieu, le square a la particularité d'offrir une petite place ombragée et verdoyante au cœur de la ville, avec une fontaine en son centre. L'entrée du Forum Exposition Bonlieu, art contemporain, se situe côté square."
    ],
    "es": [
      "Situada en la parte trasera del Centro Bonlieu, la plaza tiene la particularidad de ofrecer una pequeña plaza sombreada y verde en el corazón de la ciudad, con una fuente en su centro. La entrada al Foro de Exposiciones Bonlieu, de arte contemporáneo, está en el lado de la plaza."
    ],
    "nl": [
      "Het plein ligt aan de achterkant van het Bonlieu-centrum en heeft de bijzonderheid dat het een klein, schaduwrijk, groen plein is in het hart van de stad, met een fontein in het midden. De ingang van het Bonlieu tentoonstellingsforum, hedendaagse kunst, is aan de pleinzijde."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Square des Martyrs de la Déportation"
    ]
  },
