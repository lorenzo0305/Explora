  "rdfs:comment": {
    "de": [
      "Boutique Töpfereiatelier. Originelle kulinarische und dekorative Kreationen.  Personalisierte Geschenkideen. Arbeit auf Bestellung.  Empfang der Öffentlichkeit, Erwachsene und Kinder für Einführungen in die Töpferei oder Skulptur.  Familienworkshops auf Anfrage."
    ],
    "en": [
      "Boutique Pottery workshop. Original culinary and decorative creations.  Personalized gift ideas. Work to order.  Welcomes the public, adults and children, for pottery or sculpture initiations.  Family workshops on request."
    ],
    "it": [
      "Negozio Laboratorio di ceramica. Creazioni culinarie e decorative originali.  Idee regalo personalizzate. Lavori su ordinazione.  Aperto al pubblico, adulti e bambini, per lezioni di ceramica e scultura.  Laboratori per famiglie su richiesta."
    ],
    "fr": [
      "Boutique Atelier de poterie. Créations originales culinaires et décoratives.  Idées cadeaux personnalisées. Travail sur commande.  Accueil du public, adultes et enfants pour des initiations à la poterie ou sculpture.  Ateliers familiaux sur demande."
    ],
    "nl": [
      "Winkel Aardewerk atelier. Originele culinaire en decoratieve creaties.  Gepersonaliseerde cadeau-ideeën. Werk op bestelling.  Open voor het publiek, volwassenen en kinderen, voor pottenbakkers- en beeldhouwlessen.  Familieworkshops op aanvraag."
    ],
    "es": [
      "Tienda Taller de cerámica. Originales creaciones culinarias y decorativas.  Ideas de regalo personalizadas. Trabajos por encargo.  Abierto al público, adultos y niños, para clases de alfarería y escultura.  Talleres familiares a petición."
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'atelier de Caro"
    ]
  },
