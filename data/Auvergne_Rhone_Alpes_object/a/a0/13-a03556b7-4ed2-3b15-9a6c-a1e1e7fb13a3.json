  "rdfs:comment": {
    "de": [
      "Gönnen Sie sich einen schwebenden Moment: Außenwhirlpool mit Blick auf die Berggipfel, Lichtblasensauna und Massagen, um Körper und Geist wieder in Einklang zu bringen."
    ],
    "en": [
      "Treat yourself to a suspended moment: outdoor whirlpool bath facing the peaks, luminous bubble sauna and massages to restore harmony to body and mind."
    ],
    "it": [
      "Concedetevi un momento di sospensione: una vasca idromassaggio all'aperto di fronte alle cime, una luminosa sauna a bolle e massaggi per ritrovare l'armonia di corpo e mente."
    ],
    "fr": [
      "Offrez-vous un instant suspendu : bain à remous extérieur face aux cimes, sauna bulle lumineux et massages pour retrouver l'harmonie du corps et de l'esprit."
    ],
    "nl": [
      "Trakteer uzelf op een luchtig moment: een buitenbubbelbad met uitzicht op de bergtoppen, een heldere bubbelsauna en massages om lichaam en geest weer in harmonie te brengen."
    ],
    "es": [
      "Regálese un momento de suspensión: una bañera de hidromasaje al aire libre frente a las cumbres, una luminosa sauna de burbujas y masajes para devolver la armonía a cuerpo y mente."
    ]
  },
  "rdfs:label": {
    "en": [
      "L'Escale relaxation area"
    ],
    "fr": [
      "Espace détente L'Escale"
    ],
    "nl": [
      "L'Escale ontspanningsruimte"
    ]
  },
