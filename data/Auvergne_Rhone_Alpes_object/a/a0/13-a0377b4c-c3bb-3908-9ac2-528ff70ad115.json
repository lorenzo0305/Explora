  "rdfs:comment": {
    "de": [
      "La Grange des Farfadets, ein kreativer Raum, ist ein Veranstaltungssaal mit einem reichhaltigen und abwechslungsreichen Jahresprogramm. Theater, Aufführungen für junges Publikum, Musik, darstellende Kunst und Ausstellungen stehen auf dem Programm!\r\nLa Grange des Farfadets besitzt den Pass Culture (Kulturpass)."
    ],
    "en": [
      "La Grange des Farfadets, a creative space, is a performance hall with a rich and varied annual program. Theater, young public show, music, live art and exhibition are at the rendez-vous!\r\nThe Grange des Farfadets has the Culture Pass."
    ],
    "it": [
      "La Grange des Farfadets, uno spazio creativo, è una sala per spettacoli con un programma annuale ricco e vario. Teatro, spettacoli per il pubblico giovane, musica, arte dal vivo e mostre sono tutte offerte!\r\nLa Grange des Farfadets dispone del Pass Cultura."
    ],
    "fr": [
      "La Grange des Farfadets, espace créatif, est une salle de spectacles avec une programmation annuelle riche et variée. Théâtre, spectacle jeune public, musique, art vivant et exposition sont au rendez-vous !\r\nLa Grange des Farfadets possède le Pass Culture."
    ],
    "es": [
      "La Grange des Farfadets, espacio de creación, es una sala de espectáculos con una programación anual rica y variada. Teatro, espectáculos para el público joven, música, arte en vivo y exposiciones\r\nLa Grange des Farfadets cuenta con el Culture Pass."
    ],
    "nl": [
      "De Grange des Farfadets, een creatieve ruimte, is een voorstellingszaal met een rijk en gevarieerd jaarprogramma. Theater, voorstellingen voor jong publiek, muziek, live kunst en tentoonstellingen worden allemaal aangeboden!\r\nDe Grange des Farfadets heeft een Cultuurpas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Grange des Farfadets - Espace Créatif"
    ]
  },
