  "rdfs:comment": {
    "de": [
      "Sensibilisierung für die Tiervermittlung, Vorstellung der Einrichtung, Begegnung mit einem atypischen Tierbestand, diesen tollen Vermittlern...\r\nMINI' MAUX ist kein Tierpark, sondern ein Ort, der in enger Verbindung mit der Natur und den Tieren steht."
    ],
    "en": [
      "Awareness of animal mediation, presentation of the structure, meeting with a herd of atypical animals, these formidable mediators...\r\nMINI' MAUX is not an animal park, but a place in close relation with nature and animals."
    ],
    "it": [
      "Sensibilizzazione alla mediazione animale, presentazione della struttura, incontro con un branco di animali atipici, questi formidabili mediatori...\r\nMINI' MAUX non è un parco animali, ma un luogo in stretto rapporto con la natura e gli animali."
    ],
    "fr": [
      "Sensibilisation à la médiation animale, présentation de la structure, rencontre avec un cheptel d'animaux  atypiques,  ces formidables médiateurs...\r\nMINI' MAUX n'est pas un parc animalier, mais un lieu en relation étroite avec la nature et les animaux."
    ],
    "es": [
      "Conciencia de la mediación animal, presentación de la estructura, encuentro con una manada de animales atípicos, estos formidables mediadores...\r\nMINI' MAUX no es un parque de animales, sino un lugar en estrecha relación con la naturaleza y los animales."
    ],
    "nl": [
      "Bewustwording van dierenbemiddeling, presentatie van de structuur, ontmoeting met een kudde atypische dieren, deze formidabele bemiddelaars...\r\nMINI' MAUX is geen dierenpark, maar een plek in nauwe relatie met de natuur en de dieren."
    ]
  },
  "rdfs:label": {
    "fr": [
      "MIini-ferme \"Mini Maux\" - Centre de médiation animale"
    ]
  },
