  "rdfs:comment": {
    "de": [
      "Folgen Sie mir auf halbtägigen oder ganztägigen geführten Touren durch das Herz des Allier in einem bequemen 9-Sitzer-Fahrzeug!"
    ],
    "en": [
      "Follow me on a half-day or full-day guided tour of the heart of the Allier in a comfortable 9-seater vehicle!"
    ],
    "it": [
      "Venite con me in una visita guidata di mezza giornata o di una giornata intera nel cuore dell'Allier in un comodo veicolo a 9 posti!"
    ],
    "fr": [
      "Suivez-moi pour des visites guidées à la demi-journée ou à la journée complète, au cœur de l’Allier en véhicule 9 places tout confort !"
    ],
    "nl": [
      "Kom met mij mee voor een halve of hele dag rondleiding door het hart van de Allier in een comfortabel voertuig met 9 zitplaatsen!"
    ],
    "es": [
      "Acompáñeme en una visita guiada de medio día o de un día entero por el corazón del Allier en un cómodo vehículo de 9 plazas"
    ]
