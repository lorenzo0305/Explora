  "rdfs:comment": {
    "de": [
      "Eine Freizeitanlage, in der man sich gut erholen kann! Die am Ufer des Torrent de La Neuvache gelegene Base des Lières beherbergt ein wahres grünes Schmuckkästchen. Hier gibt es zahlreiche Einrichtungen, die Groß und Klein begeistern werden."
    ],
    "en": [
      "At the edge of the torrent of La Neuvache, in the direction of Les Déserts, a leisure area with barbecues, tables, games for children, deckchairs, hammocks, a botanical path, pedagogical markers and the start of the Butterfly Trail, will delight young and old."
    ],
    "it": [
      "Un centro ricreativo dove rilassarsi! Situata sulle rive del torrente La Neuvache, la base di Lières è un vero e proprio gioiello di verde. Le strutture sono numerose e fanno la felicità di grandi e piccini."
    ],
    "fr": [
      "Une base de loisirs où il fait bon se détendre ! Située au bord du torrent de La Neuvache, la base des Lières abrite un véritable écrin de verdure. On y trouve notamment de nombreuses installations qui feront le bonheur des petits comme des grands."
    ],
    "es": [
      "Un centro de ocio donde relajarse Situada a orillas del torrente La Neuvache, la base de Lières es una auténtica joya de verdor. Numerosas instalaciones harán las delicias de grandes y pequeños."
    ],
    "nl": [
      "Aan de oever van de beek La Neuvache, in de richting van Les Déserts, zal een recreatiegebied met barbecues, tafels, spelletjes voor kinderen, ligstoelen, hangmatten, een botanisch pad, educatieve markeringen en het begin van het vlinderpad jong en oud bekoren."
    ]
  },
  "rdfs:label": {
    "en": [
      "Les Lières"
    ],
    "fr": [
      "Base de loisirs des Lières"
    ],
    "nl": [
      "Les Lières"
    ]
  },
