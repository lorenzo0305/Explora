  "rdfs:comment": {
    "de": [
      "Ein neues Bouchon im 6. Arrondissement von Lyon! Hier sehen Sie das neue Restaurant von Julien Gautier, Küchenchef und Eigentümer des \"M Restaurant\", und seinem Teilhaber Emmanuel Tachon-Foley, der Saalverantwortliche."
    ],
    "en": [
      "Le Bouchon Sully is a new traditional 'bouchon' restaurant in the 6th 'arrondissement' of Lyon, that opened on the 1st October 2014! This is the new restaurant from Julien Gautier, a native of Lyon and owner of the 'M Restaurant', and Emmanuel Tachon-Foley, a native of the Beaujolais region. Together, they make quite a pair!"
    ],
    "it": [
      "Un nuovo bouchon nel 6° arrondissement di Lione! Ecco il nuovo ristorante di Julien Gautier, Chef, cuoco e proprietario del \"M Restaurant\", e del suo socio Emmanuel Tachon-Foley, responsabile di sala."
    ],
    "fr": [
      "Ouvert depuis le 1er octobre 2014, le Bouchon Sully est le nouveau bouchon du 6ème arrondissement ! Créé par Julien Gautier, un Lyonnais (propriétaire du M Restaurant) et Emmanuel Tachon-Foley, un Beaujolais, il démarre sur de bonnes bases."
    ],
    "es": [
      "¡Un nuevo bouchon en el 6o distrito de Lyon! Este es el nuevo restaurante de Julien Gautier, chef cocinero y propietario del M Restaurant y de su socio Emmanuel Tachon-Foley, jefe de sala."
    ],
    "nl": [
      "De Bouchon Sully, geopend sinds 1 oktober 2014, is de nieuwe bouchon in het 6e arrondissement! Opgezet door Julien Gautier, een Lyonnais (eigenaar van M Restaurant) en Emmanuel Tachon-Foley, een Beaujolais, heeft het een geweldige start."
    ]
  },
