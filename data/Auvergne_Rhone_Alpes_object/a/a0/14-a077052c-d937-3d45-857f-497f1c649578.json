  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/43b7e217-2a28-3590-a389-7842cd6cfd72",
      "dc:description": {
        "de": [
          "Racomptines\nBald ist Weihnachten!\nGeschichten, Reime und Fingerspiele für 0-4-Jährige...\n...rund um das Lieblingsfest der Kinder!\n\nkind mit Weihnachtsmannmütze sitzt neben einem Plüschhasen\n\nSamstag, 14. Dezember, um 10.30 Uhr und um 11.15 Uhr\n0-4 J\nKostenlos, mit Reservierung"
        ],
        "en": [
          "Racomptines\nIt's almost Christmas!\nStories, rhymes and fingerplays for 0-4 year olds...\n...about children's favorite holiday!\n\nchild with a santa claus hat sitting next to a stuffed rabbit\n\nSaturday, December 14, at 10:30 and 11:15 a.m\nages 0-4\nFree, on reservation"
        ],
        "it": [
          "Racomptine\nIl Natale è alle porte!\nStorie, filastrocche e giochi con le dita per bambini da 0 a 4 anni...\n...sulla festa preferita dai bambini!\n\nbambino con il cappello di Babbo Natale seduto accanto a un coniglio coccoloso\n\nSabato 14 dicembre, alle 10.30 e alle 11.15\netà 0-4 anni\nGratuito, su prenotazione"
        ],
        "fr": [
          "Racomptines\nC'est bientôt Noël !\nDes histoires, des comptines et des jeux de doigts pour les 0-4 ans...\n...autour de la fête préférée des enfants !\n\nenfant avec un bonnet de père noël assis à côté d'un lapin en peluche\n\nSamedi 14 décembre, à 10h30 et à 11h15\n0-4 ans\nGratuit, sur réservation"
        ],
        "es": [
          "Racomptines\n¡La Navidad está a la vuelta de la esquina!\nCuentos, rimas y juegos de dedos para niños de 0 a 4 años...\n...¡sobre la fiesta favorita de los niños!\n\nniño con gorro de Papá Noel sentado junto a un conejo de peluche\n\nSábado 14 de diciembre, a las 10.30 h y a las 11.15 h\nde 0 a 4 años\nGratuito, previa reserva"
        ],
        "nl": [
          "Racomptines\nKerstmis staat voor de deur!\nVerhalen, rijmpjes en vingerspelletjes voor kinderen van 0-4 jaar...\n...over de favoriete feestdag van kinderen!\n\nkind met kerstmuts naast knuffelkonijn\n\nZaterdag 14 december om 10.30 en 11.15 uur\nleeftijd 0-4\nGratis, reserveren verplicht"
        ]
      },
