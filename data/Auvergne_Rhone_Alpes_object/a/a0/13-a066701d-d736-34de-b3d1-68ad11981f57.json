  "rdfs:comment": {
    "de": [
      "Restaurant, das nur im Juli und August geöffnet ist. Geselliger Ort auf dem Campingplatz Le Travers, der saisonale Produkte von lokalen Erzeugern anbietet."
    ],
    "en": [
      "Restaurant open in July and August only. A nice and warmly place in the campsite Le Travers, which offers seasonal food from locally grown products."
    ],
    "it": [
      "Ristorante aperto solo in luglio e agosto. Un luogo accogliente all'interno del campeggio Le Travers, che offre prodotti di stagione provenienti da produttori locali."
    ],
    "fr": [
      "Restaurant ouvert en juillet et août uniquement. Lieu convivial au sein du camping Le Travers et qui propose des produits de saison de producteurs locaux."
    ],
    "es": [
      "Restaurante abierto sólo en julio y agosto. Un lugar acogedor dentro del camping Le Travers, que ofrece productos de temporada de productores locales."
    ],
    "nl": [
      "Restaurant alleen geopend in juli en augustus. Een gezellige plek op camping Le Travers, met seizoensproducten van lokale producenten."
    ]
  },
