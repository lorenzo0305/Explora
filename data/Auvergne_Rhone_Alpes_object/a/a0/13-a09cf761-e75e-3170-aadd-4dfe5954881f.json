  "rdfs:comment": {
    "de": [
      "Tauchen Sie am 9. Mai ab 20 Uhr im Smart Cabaret in die Welt der Gentleman Show von Christophe Guybet ein, einer eleganten und rhythmischen Humorshow, die Stand-up-Comedy, szenisches Spiel und Kabarettgeist miteinander verbindet."
    ],
    "en": [
      "Dive into the world of Christophe Guybet?s Gentleman Show at Smart Cabaret on May 9 at 8pm, an elegant, fast-paced comedy show combining stand-up, stagecraft and cabaret spirit."
    ],
    "it": [
      "Il 9 maggio dalle 20.00 allo Smart Cabaret, immergetevi nel mondo del Gentleman Show di Christophe Guybet, uno spettacolo comico elegante e dal ritmo incalzante che unisce stand-up, scenotecnica e spirito cabarettistico."
    ],
    "fr": [
      "Plongez le 9 mai dès 20h au Smart Cabaret dans l’univers du Gentleman Show de Christophe Guybet, un spectacle d’humour élégant et rythmé mêlant stand-up, jeu scénique et esprit cabaret."
    ],
    "es": [
      "El 9 de mayo a partir de las 20:00 h en Smart Cabaret, sumérjase en el universo del Gentleman Show de Christophe Guybet, un espectáculo cómico elegante y trepidante que combina el stand-up, la puesta en escena y el espíritu cabaretero."
    ],
    "nl": [
      "Dompel je op 9 mei vanaf 20.00 uur in Smart Cabaret onder in de wereld van Christophe Guybet's Gentleman Show, een elegante, snelle comedyshow die stand-up, toneelkunst en cabaretgeest combineert."
    ]
  },
  "rdfs:label": {
    "fr": [
