  "rdfs:comment": {
    "de": [
      "200 m vom Dorfplatz entfernt, neben der Schule und dem Festsaal. Die Mauer besteht aus zwei rechtwinklig zueinander stehenden Teilen mit einer Höhe von ca. 3 m, die verschiedene Ebenen von 4a bis 6a umfassen."
    ],
    "en": [
      "Situated 200m from the village square, next to the school and village hall, the wall is divided into 2 perpendicular sections, each about 3 m high and comprising various levels ranging from 4a to 6a."
    ],
    "it": [
      "Situato a 200 m dalla piazza del paese, accanto alla scuola e al municipio, il muro è diviso in due sezioni perpendicolari alte circa 3 m, con vari livelli che vanno da 4a a 6a."
    ],
    "fr": [
      "Situé à 200m de la place du village, à côté de l’école et de la salle des fêtes Le mur se décompose en 2 pans perpendiculaires sur une hauteur d’environ 3 m et regroupant divers niveaux allant 4a au 6a."
    ],
    "es": [
      "Situada a 200 m de la plaza del pueblo, junto a la escuela y el ayuntamiento, la muralla está dividida en 2 tramos perpendiculares de aproximadamente 3 m de altura, con varios niveles que van de 4a a 6a."
    ],
    "nl": [
      "De muur ligt 200 m van het dorpsplein, naast de school en het dorpshuis en is verdeeld in 2 loodrechte secties van ongeveer 3 m hoog, met verschillende niveaus variërend van 4a tot 6a."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Mur d’Escalade"
    ]
  },
