  "rdfs:comment": {
    "de": [
      "Pedal'Douce bietet eine große Auswahl an Verleihrädern rund um den See an, darunter Straßenräder, Rennräder, Mountainbikes, Elektroräder, Tandems, Trekkingräder, Kinderräder, Anhänger für Kinder und Tiere, Dreiräder."
    ],
    "en": [
      "Pedal'Douce provides a wide range of bikes to hire around the lake: city, mountain, all-terrain, electric, tandems, trek, children's bikes, children and pet trailers and tricycles."
    ],
    "it": [
      "Pedal'Douce propone un'ampia scelta di bici da noleggiare per gite intorno al lago: bici urbane, bici da strada, mountain bike, bici elettriche, tandem, bici per escursioni, bici per bambini, rimorchi per bambini e animali, terza ruota."
    ],
    "fr": [
      "Pedal'Douce vous propose le plus grand choix de vélos à la location du bassin annécien, VTC, VTT, vélos électriques, tandems, randonneuses, vélos enfants, remorques, 3ème roue."
    ],
    "es": [
      "Pedal'Douce le ofrece la mayor selección de bicicletas de alquiler en la zona de Annecy, bicicletas de montaña, bicicletas eléctricas, tándems, bicicletas de paseo, bicicletas para niños, remolques, terceras ruedas."
    ],
    "nl": [
      "Pedal'Douce biedt een groot aantal fietsen te huur aan rondom het meer; stadsfietsen, mountainbikes, elektrische fietsen, tandems, kinderfietsen, aanhangers voor kinderen en dieren, met 3 wielen."
    ]
  },
