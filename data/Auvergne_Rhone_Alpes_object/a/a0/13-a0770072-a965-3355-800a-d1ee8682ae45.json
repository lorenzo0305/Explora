  "rdfs:comment": {
    "de": [
      "Die Stadtbibliothek bietet verschiedene Medien (Comics, Romane, Hörbücher, Dokumentarfilme, Zeitschriften, Zeitungen, Enzyklopädien) für alle an. Kostenlose Einsichtnahme vor Ort oder die Möglichkeit, Bücher auszuleihen. Kostenloser Internetzugang."
    ],
    "en": [
      "The Municipal Library offers various documents (comics, novels, documentaries, magazines, newspapers and encyclopedias) for all ages. Free on-site consultation or can borrow the books after registration."
    ],
    "it": [
      "La Biblioteca Comunale offre vari documenti (fumetti, romanzi, audiolibri, documentari, riviste, enciclopedie) per tutti. Consultazione gratuita in loco o possibilità di prendere in prestito i libri. Accesso gratuito a Internet."
    ],
    "fr": [
      "La Bibliothèque Municipale propose différents documents (bandes dessinées, romans, livres audios, documentaires, revues, journaux encyclopédies) pour tous. Consultation sur place gratuite ou possibilité d'emprunter les ouvrages. Accès gratuit à internet."
    ],
    "es": [
      "La Biblioteca Municipal ofrece diversos documentos (cómics, novelas, audiolibros, documentales, revistas, enciclopedias) para todos. Consulta gratuita in situ o posibilidad de préstamo de libros. Acceso gratuito a Internet."
    ],
    "nl": [
      "De gemeentebibliotheek biedt een scala aan documenten (strips, romans, luisterboeken, documentaires, tijdschriften, encyclopedieën) voor iedereen. Gratis raadpleging ter plaatse of boeken kunnen worden geleend. Gratis toegang tot internet."
    ]
  },
