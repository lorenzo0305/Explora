      "dc:description": {
        "de": [
          "The Froggy Blues\nMusikalische Bar:Täglich um 18.00 Uhr geöffnet\nAdresse: 23 Rue de Lille, 62200 Boulogne-sur-Mer\nTelefon: 03 61 28 46 44\nMontags und donnerstags geschlossen."
        ],
        "en": [
          "The Froggy Blues\nBar Musical :Opens at 6pm daily\nAddress: 23 Rue de Lille, 62200 Boulogne-sur-Mer\nPhone number: 03 61 28 46 44\nClosed Mondays and Thursdays."
        ],
        "it": [
          "Il blues dei ranocchi\nBar Musicale: apre alle 18:00 tutti i giorni\nIndirizzo: 23 Rue de Lille, 62200 Boulogne-sur-Mer\nNumero di telefono: 03 61 28 46 44\nChiuso il lunedì e il giovedì."
        ],
        "fr": [
          "The Froggy Blues\nBar Musical :Ouverture à 18h00 tous les jours\nAdresse : 23 Rue de Lille, 62200 Boulogne-sur-Mer\nTéléphone : 03 61 28 46 44\nFermé le lundi et jeudi."
        ],
        "es": [
          "El blues de las ranas\nBar Musical :Abre todos los días a las 18h\nDirección: 23 Rue de Lille, 62200 Boulogne-sur-Mer\nTeléfono: 03 61 28 46 44\nCerrado los lunes y jueves."
        ],
        "nl": [
