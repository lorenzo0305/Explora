  "rdfs:comment": {
    "de": [
      "Treffen Sie sich am Montag, dem 21. Juli, und am Dienstag, dem 22. Juli, ab 21.15 Uhr im Amphitheater von Tignes Le Lac für zwei Filmabende unter freiem Himmel mit den Bergen als Hintergrundkulisse."
    ],
    "en": [
      "Join us on Monday July 21 and Tuesday July 22 from 9:15pm at the Tignes Le Lac amphitheatre for 2 evenings of open-air cinema with the mountains as a backdrop."
    ],
    "it": [
      "Unitevi a noi lunedì 21 e martedì 22 luglio dalle 21.15 presso l'anfiteatro di Tignes Le Lac per 2 serate di cinema all'aperto con le montagne come sfondo."
    ],
    "fr": [
      "Rendez-vous le lundi 21 et le mardi 22 juillet à partir de 21h15 à l'amphithéâtre de Tignes Le Lac pour 2 soirées cinéma en plein air avec les montagnes en toile de fond."
    ],
    "nl": [
      "Kom op maandag 21 en dinsdag 22 juli vanaf 21.15 uur naar het amfitheater van Tignes Le Lac voor 2 avonden openluchtcinema met de bergen op de achtergrond."
    ],
    "es": [
      "Acompáñenos el lunes 21 y el martes 22 de julio a partir de las 21.15 h en el anfiteatro de Tignes Le Lac para disfrutar de 2 veladas de cine al aire libre con las montañas como telón de fondo."
    ]
  },
  "rdfs:label": {
    "fr": [
