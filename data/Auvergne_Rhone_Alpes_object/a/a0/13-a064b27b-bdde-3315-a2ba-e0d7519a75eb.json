  "rdfs:comment": {
    "de": [
      "Traditionelles Restaurant im Herzen des Dorfes. Fleisch- und Fischkarte, Menü, Kindermenü ? Spezialitäten aus Savoyen, darunter traditionelles Raclette aus dem Guss.\r\nChalet Hotel***\r\nLogis Hotels Cosy - Table Savoureuse"
    ],
    "en": [
      "Located in the village centre, this charming traditional restaurant offers a menu. A la Carte - Savoyard specialities. \r\nChalet hôtel*** - Logis Hotels Cosy"
    ],
    "it": [
      "Ristorante tradizionale nel cuore del villaggio. Carne, pesce, menu, menu per bambini, specialità savoiarde tra cui la tradizionale raclette à la coulée.\r\nChalet hotel***\r\nLogis Hotels Cosy - Table Savoureuse"
    ],
    "fr": [
      "Restaurant traditionnel au cœur du village. Carte viandes, poissons, menu, menu enfant – spécialités savoyardes dont la raclette traditionnelle à la coulée. \r\nChalet hôtel*** \r\nLogis Hotels Cosy - Table Savoureuse"
    ],
    "es": [
      "Restaurante tradicional en el corazón del pueblo. Carne, pescado, menú, menú infantil... Especialidades saboyanas, incluida la tradicional raclette à la coulée.\r\nChalet hotel***\r\nLogis Hotels Cosy - Table Savoureuse"
    ],
    "nl": [
      "Gelegen in het centrum van het dorp , dit charmante en traditionele restaurant in het hart van het dorp stelt u.\r\nSpecialiteiten uit Savoie .\r\nChalet Hotel *** - Logis Hotels Cosy"
    ]
  },
