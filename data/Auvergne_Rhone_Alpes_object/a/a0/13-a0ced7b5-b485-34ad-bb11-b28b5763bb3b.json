  "rdfs:comment": {
    "de": [
      "Dieses Lokal liegt im historischen Viertel Saint-Chef, in den Balcons du Dauphiné, weniger als eine Stunde von Lyon entfernt, und erinnert an irische Pubs. Stephen und Hedi werden Ihnen ihre eigene Bierproduktion und ihre irischen Whiskys vorstellen."
    ],
    "en": [
      "Located in the historic district of Saint-Chef, in the Balcons du Dauphiné, less than an hour from Lyon, this establishment is reminiscent of an Irish pub.\r\nStephen and Hedi will be delighted to introduce you to their beers and range of Irish whiskies."
    ],
    "it": [
      "Situato nel quartiere storico di Saint-Chef, nei Balcons du Dauphiné, a meno di un'ora da Lione, questo locale ricorda i pub irlandesi. Stephen e Hedi vi faranno conoscere le loro birre e i loro whisky irlandesi."
    ],
    "fr": [
      "Situé dans le quartier historique de Saint-Chef, aux Balcons du Dauphiné, à moins d'une heure de Lyon, cet établissement rappelle les pubs irlandais. Stephen et Hedi vous feront découvrir leur propre production de bières et leurs Whiskys irlandais."
    ],
    "es": [
      "Situado en el barrio histórico de Saint-Chef, en los Balcons du Dauphiné, a menos de una hora de Lyon, este establecimiento recuerda a los pubs irlandeses. Stephen y Hedi le presentarán sus propias cervezas y whiskies irlandeses."
    ],
    "nl": [
      "Dit etablissement ligt in de historische wijk Saint-Chef, in de Balcons du Dauphiné, op minder dan een uur van Lyon, en doet denken aan Ierse pubs. Stephen en Hedi laten je kennismaken met hun eigen bieren en Ierse whisky's."
    ]
  },
  "rdfs:label": {
    "en": [
      "Cask House: brewery, Irish pub"
    ],
    "fr": [
      "Cask House : Irish Pub"
    ]
  },
