  "rdfs:comment": {
    "de": [
      "Zwischen Susa in Italien und Val Cenis gelegen, bietet das Hotel Le Malamot Zimmer mit Blick auf die Berge. Gemütliches und komfortables Interieur für Durchreisende, Aufenthalter, Sportler, Gruppen und Einzelpersonen, Seminare..."
    ],
    "en": [
      "Located between Susa in Italy and Val Cenis, the hotel Malamot offers rooms with view onto the moutnains. Lovely and ocnfortable design. ideal for setepovers, holidays, outdoor specialists..."
    ],
    "it": [
      "Situato tra Susa e la Val Cenis, l'Hôtel Le Malamot offre camere con vista sulle montagne. Interni accoglienti e confortevoli, per passanti, vacanzieri, sportivi, gruppi e singoli, seminari..."
    ],
    "fr": [
      "Situé entre Suse en Italie et Val Cenis,  l'Hôtel Le Malamot propose des chambres avec vue sur les montagnes. Intérieur douillet et confortable, pour passants, séjournants, sportifs, groupes et individuels, séminaires..."
    ],
    "es": [
      "Situado entre Susa (Italia) y Val Cenis, el Hôtel Le Malamot ofrece habitaciones con vistas a la montaña. Interiores acogedores y confortables, para paseantes, veraneantes, deportistas, grupos e individuales, seminarios..."
    ],
    "nl": [
      "Hôtel Le Malamot ligt tussen Susa in Italië en Val Cenis en biedt kamers met uitzicht op de bergen. Gezellig en comfortabel interieur, voor passanten, bewoners, sporters, groepen en individuen, seminars ..."
    ]
  },
