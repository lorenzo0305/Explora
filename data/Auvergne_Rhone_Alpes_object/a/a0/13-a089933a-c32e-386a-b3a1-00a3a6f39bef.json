  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Atelier Miguel im Herzen von Saint-Félicien. Mieten Sie ein Fahrrad mit Elektro- oder Muskelkraftunterstützung oder lassen Sie Ihr Fahrrad fachmännisch reparieren, direkt im Stadtzentrum. Besuchen Sie uns!"
    ],
    "en": [
      "Discover Atelier Miguel in the heart of Saint-Félicien. Rent an electric or muscle-assist bike, or have your bike expertly repaired, right in the village center. Come and visit us!"
    ],
    "it": [
      "Scoprite l'Atelier Miguel nel cuore di Saint-Félicien. Noleggiate una bici elettrica o a pedalata assistita o fate riparare la vostra bici da un esperto nel centro del paese. Venite a trovarci!"
    ],
    "fr": [
      "Découvrez l'Atelier Miguel en plein cœur de Saint-Félicien. Louer un vélo à assistance électrique ou musculaire,  ou encore faites réparer votre vélo avec expertise, en centre-village. Visitez-nous!"
    ],
    "nl": [
      "Ontdek Atelier Miguel in het hart van Saint-Félicien. Huur een elektrische fiets of een fiets met spierkrachtondersteuning, of laat je fiets vakkundig repareren in het dorpscentrum. Kom ons bezoeken!"
    ],
    "es": [
      "Descubra Atelier Miguel en el corazón de Saint-Félicien. Alquile una bicicleta eléctrica o de asistencia muscular, o haga reparar su bicicleta en el centro del pueblo. Venga a visitarnos"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Atelier mobile cycle Miguel"
    ]
  },
