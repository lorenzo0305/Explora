  "rdfs:comment": {
    "de": [
      "Restaurant auf der Terrasse. Hier können Sie herzhafte Kuchen, Salate, salzige Crêpes, Tagesvorschläge und Kindermenüs genießen. Alle Gerichte sind hausgemacht und werden mit lokalen Produkten zubereitet. Sie können das Restaurant unabhängig vom Park genießen."
    ],
    "en": [
      "Terrace restaurant. Enjoy savory tarts, salads and crêpes, as well as daily specials and children's menus. All dishes are homemade with local produce. You can enjoy the restaurant independently of the park."
    ],
    "it": [
      "Ristorante con terrazza. Potrete gustare crostate salate, insalate, crêpes salate, specialità del giorno e menù per bambini. Tutti i piatti sono fatti in casa con prodotti locali. È possibile usufruire del ristorante indipendentemente dal parco."
    ],
    "fr": [
      "Restaurant en terrasse. Vous pourrez déguster des tartes salées, des salades, des crêpes salées, suggestions du jour et menus enfant. Tous les plats sont fait maison avec des produits locaux. Vous pouvez profiter du restaurant indépendamment du parc."
    ],
    "es": [
      "Terraza restaurante. Podrá degustar tartas saladas, ensaladas, crepes salados, platos del día y menús infantiles. Todos los platos son caseros y se elaboran con productos locales. Puede disfrutar del restaurante independientemente del parque."
    ],
    "nl": [
      "Terrasrestaurant. Je kunt er genieten van hartige taarten, salades, hartige crêpes, dagschotels en kindermenu's. Alle gerechten zijn huisgemaakt met lokale producten. Je kunt onafhankelijk van het park van het restaurant genieten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le resto terrasse - L'arbre à fil"
    ]
  },
