  "rdfs:comment": {
    "de": [
      "Die ESF von Le Lioran und ihre 50 Skilehrer bieten Ihnen eine qualitativ hochwertige Betreuung beim Alpinski, Snowboard, Langlauf, Handiski oder Schneeschuhwandern in Form von Gruppenkursen am Wochenende oder in der Woche, Privatunterricht, Leistungen für Gruppen."
    ],
    "en": [
      "The ESF du Lioran and its 50 instructors offer you top-quality instruction in downhill skiing, snowboarding, cross-country skiing, handiskiing and snowshoeing, in the form of weekend or weekly group lessons, private lessons and services for groups."
    ],
    "it": [
      "L'ESF di Le Lioran e i suoi 50 maestri vi offrono un'istruzione di alta qualità per lo sci alpino, lo snowboard, lo sci di fondo, l'handiski e le racchette da neve sotto forma di lezioni di gruppo nei fine settimana o durante la settimana, lezioni private e servizi per gruppi."
    ],
    "fr": [
      "L'ESF du Lioran et ses 50 moniteurs vous propose un encadrement de qualité en ski alpin, snowboard, ski de fond, handiski ou raquette sous forme de cours collectifs Week-end ou semaine, leçons particulières, prestation pour les groupes."
    ],
    "es": [
      "La ESF de Le Lioran y sus 50 monitores le ofrecen una enseñanza de calidad en esquí alpino, snowboard, esquí de fondo, handiski y raquetas de nieve en forma de clases en grupo los fines de semana o entre semana, clases particulares y servicios para grupos."
    ],
    "nl": [
      "De ESF in Le Lioran en haar 50 instructeurs bieden je hoogwaardige lessen in alpineskiën, snowboarden, langlaufen, handiskiën en sneeuwschoenwandelen in de vorm van groepslessen in het weekend of doordeweeks, privélessen en diensten voor groepen."
    ]
  },
  "rdfs:label": {
    "en": [
      "ESF - French Ski School"
    ],
    "fr": [
      "ESF - Ecole du Ski Français"
    ]
  },
