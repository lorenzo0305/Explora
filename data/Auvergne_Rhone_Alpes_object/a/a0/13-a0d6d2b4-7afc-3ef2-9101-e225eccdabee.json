  "rdfs:comment": {
    "de": [
      "Über einen Wanderweg erreichbar. Besteht aus einem kurzen Kirchenschiff und einer siebenseitigen Apsis mit Tonnengewölbe. Wunderschöner Aussichtspunkt."
    ],
    "en": [
      "Accessible by footpath. Composed of a short nave and a 7-sided apse with cul-de-four vaulting. Magnificent views."
    ],
    "it": [
      "Accessibile da un sentiero pedonale. Composto da una navata breve e da un'abside con 7 lati ad arco. Vista magnifica."
    ],
    "fr": [
      "Accessible par un sentier de randonnée. Composée d'une courte nef et d'une abside à 7 pans voutés en cul-de-four. Point de vue magnifique."
    ],
    "nl": [
      "Toegankelijk via voetpad. Bestaat uit een kort schip en een apsis met 7 gewelfde zijden. Prachtig uitzicht."
    ],
    "es": [
      "Accesible por un sendero. Compuesta por una nave corta y un ábside con 7 arcos laterales. Magnífico mirador."
    ]
  },
