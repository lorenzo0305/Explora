  "rdfs:comment": {
    "de": [
      "Die Geräte sind für Erwachsene, Jugendliche und Kinder nur unter der Verantwortung eines Erwachsenen bestimmt. Jeder absolviert den Parcours in seinem eigenen Tempo und entsprechend seiner körperlichen Verfassung."
    ],
    "en": [
      "The equipment is designed for adults, teenagers and children under adult supervision only. You can complete the course at your own pace and according to your physical condition."
    ],
    "it": [
      "L'attrezzatura è destinata ad adulti, adolescenti e bambini solo sotto la responsabilità di un adulto. Ogni persona può completare il corso al proprio ritmo e in base alle proprie condizioni fisiche."
    ],
    "fr": [
      "Les équipements sont destinés aux adultes, aux adolescents et aux enfants uniquement sous la responsabilité d'un adulte. Chacun réalise le parcours à son rythme et selon sa condition physique."
    ],
    "es": [
      "El equipo está destinado a adultos, adolescentes y niños sólo bajo la responsabilidad de un adulto. Cada persona puede completar el curso a su propio ritmo y según su condición física."
    ],
    "nl": [
      "De faciliteiten zijn alleen bedoeld voor volwassenen, tieners en kinderen onder toezicht van volwassenen. Je kunt de cursus in je eigen tempo en op basis van je fysieke conditie afleggen."
    ]
  },
  "rdfs:label": {
