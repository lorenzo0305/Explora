  "rdfs:comment": {
    "de": [
      "Lassen Sie sich für eine Mahlzeit in das Herz Indiens entführen! Eine schmackhafte Küche mit traditionellen Gerichten wie Chicken Tikka Massala, Butter Chicken oder Gulab Jamin. Es ist auch möglich, etwas zum Mitnehmen zu bestellen."
    ],
    "en": [
      "Take a trip to the heart of India for a meal! A tasty cuisine that honours the great traditional dishes such as Chicken Tikka Massala, Butter Chicken or Gulab Jamin. It is possible to order takeaway."
    ],
    "it": [
      "Un viaggio nel cuore dell'India per un pasto! Una cucina gustosa che rende onore ai grandi piatti tradizionali come il Chicken Tikka Massala, il Butter Chicken o il Gulab Jamin. È possibile ordinare da asporto."
    ],
    "fr": [
      "Le temps d'un repas transportez-vous au cœur de l'Inde! Une cuisine savoureuse qui met à l'honneur les grands plats traditionnels comme le Chicken Tikka Massala, le Butter Chicken ou les Gulab Jamin. Il est possible de commander à emporter."
    ],
    "es": [
      "Viaje al corazón de la India para comer Una cocina sabrosa que hace honor a los grandes platos tradicionales como el pollo Tikka Massala, el pollo a la mantequilla o el Gulab Jamin. Es posible pedir comida para llevar."
    ],
    "nl": [
      "Verplaats jezelf naar het hart van India voor een maaltijd! Een smakelijke keuken die de grote traditionele gerechten zoals Chicken Tikka Massala, Butter Chicken of Gulab Jamin in ere houdt. Het is mogelijk om afhaalmaaltijden te bestellen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Taj Mahal"
    ]
  },
