  "rdfs:comment": {
    "de": [
      "Fahren Sie an Bord eines leisen und umweltfreundlichen Elektroboots und entdecken Sie die Fauna und Flora des Canal de Savière. 60 Plätze an Bord. Kommentierte Kreuzfahrt."
    ],
    "en": [
      "Sail aboard a quiet and non-polluting electric boat to discover the flora and fauna of the Savières Canal."
    ],
    "it": [
      "Navigate a bordo di un'imbarcazione elettrica, silenziosa e non inquinante per scoprire la flora e la fauna del Canal de Savières."
    ],
    "fr": [
      "Naviguez à bord d'un bateau électrique silencieux et non polluant pour découvrir la faune et la flore du canal de Savière. 60 places à bord. Croisière commentée."
    ],
    "nl": [
      "Vaar aan boord van een stille en niet-vervuilende elektrische boot om de fauna en flora van het Savièrekanaal te ontdekken. 60 plaatsen aan boord. Becommentarieerde cruise."
    ],
    "es": [
      "Navegue a bordo de un barco eléctrico silencioso y no contaminante para descubrir la fauna y la flora del canal de la Savière. 60 plazas a bordo. Crucero comentado."
    ]
  },
