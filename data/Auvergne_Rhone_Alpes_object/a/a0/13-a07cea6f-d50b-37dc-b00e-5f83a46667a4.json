  "rdfs:comment": {
    "de": [
      "Tauche ein in eine Yogastunde im Freien. Ein dynamischer und leicht zugänglicher Flow, um die Energie zirkulieren zu lassen, den Körper zu stärken und zu lockern, gefolgt von einer Zeit der Tiefenentspannung, gewiegt vom Wind und dem Gesang der Vögel."
    ],
    "en": [
      "Dive into an outdoor yoga session. A dynamic, accessible flow to circulate energy, strengthen and loosen the body, followed by a time of deep relaxation, lulled by the wind and birdsong."
    ],
    "it": [
      "Immergetevi in una sessione di yoga all'aperto. Un flusso dinamico e accessibile per far fluire l'energia, rafforzare e sciogliere il corpo, seguito da un momento di profondo relax, cullati dal vento e dal canto degli uccelli."
    ],
    "fr": [
      "Plonge dans une séance de yoga en extérieur. Un flow dynamique et accessible, pour faire circuler l’énergie, renforcer et délier le corps, suivi d’un temps de relaxation profonde, bercé·e par le souffle du vent, le chant des oiseaux."
    ],
    "es": [
      "Sumérjase en una sesión de yoga al aire libre. Un flujo dinámico y accesible para hacer fluir la energía, fortalecer y relajar el cuerpo, seguido de un momento de profunda relajación, arrullado por el viento y el canto de los pájaros."
    ],
    "nl": [
      "Duik in een yogasessie in de buitenlucht. Een dynamische, toegankelijke flow om de energie te laten stromen, het lichaam te versterken en los te maken, gevolgd door een moment van diepe ontspanning, gesust door de wind en vogelgezang."
    ]
  },
