  "rdfs:comment": {
    "de": [
      "Zum Auftakt der zwei Wochen der Videospiele hören Sie, wie die Schüler des Interkommunalen Konservatoriums Musik aus den größten Videospielen interpretieren!"
    ],
    "en": [
      "To kick off Video Game Fortnight, come and listen to students from the Conservatoire intercommunal perform music from the greatest video games!"
    ],
    "it": [
      "Per dare il via alla Quinzaine des Réclames, venite ad ascoltare gli studenti del Conservatorio intercomunale che eseguono musiche tratte dai più grandi videogiochi!"
    ],
    "fr": [
      "Pour lancer la Quinzaine du Jeu-Vidéo, venez écouter les élèves du Conservatoire intercommunal vous interpréter des musiques tirées des plus grands Jeux-vidéo !"
    ],
    "es": [
      "Para inaugurar la Quincena de los videojuegos, venga a escuchar a los alumnos del Conservatorio Intercomunal interpretar la música de los mejores videojuegos"
    ],
    "nl": [
      "Om de Video Game Fortnight af te trappen, kun je komen luisteren naar studenten van het Conservatoire intercommunal die muziek uit de beste videogames ten gehore brengen!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Quinzaine des Jeux Vidéo - Blind test et musique de Jeu vidéo"
    ]
  },
