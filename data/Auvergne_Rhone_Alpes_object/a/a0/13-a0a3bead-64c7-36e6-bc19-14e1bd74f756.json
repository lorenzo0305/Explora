  "rdfs:comment": {
    "de": [
      "Die Société des 3 Vallées betreibt das Skigebiet Méribel-Mottaret, das im Herzen der 3 Vallées liegt, dem größten Skigebiet der Welt. Dieses hochgelegene Skigebiet ist für alle Skifahrer zugänglich, unabhängig von ihrem Können."
    ],
    "en": [
      "The 3 Vallées company operates the Méribel Mottaret ski area, at the heart of the 3 Vallées ski area, the largest in the world. This high-altitude area is accessible to all skiers, whatever their level."
    ],
    "it": [
      "La Société des 3 Vallées gestisce il comprensorio sciistico di Méribel-Mottaret, situato nel cuore delle 3 Vallées, il più grande comprensorio sciistico del mondo. Questo comprensorio d'alta quota è accessibile a sciatori di tutte le capacità."
    ],
    "fr": [
      "La Société des 3 Vallées exploite le domaine skiable de Méribel-Mottaret, situé au cœur des 3 Vallées, le plus grand domaine skiable du monde. Ce domaine de haute altitude est accessible à tous les skieurs, quel que soit leur niveau."
    ],
    "es": [
      "La Société des 3 Vallées explota el dominio esquiable de Méribel-Mottaret, situado en el corazón de los 3 Vallées, el mayor dominio esquiable del mundo. Esta zona de gran altitud es accesible para esquiadores de todos los niveles."
    ],
    "nl": [
      "De maatschappij 3 Vallées exploiteert het skigebied Méribel Mottaret, een skigebied gelegen in het hart van het 3 Vallées gebied, het grootste ter wereld. Dit hooggelegen gebied is toegankelijk voor alle skiërs, ongeacht hun niveau."
    ]
  },
