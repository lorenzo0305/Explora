  "rdfs:comment": {
    "de": [
      "Brauchen Sie Sport, Entspannung oder eine Wellness-Pause? Das Centre aqualudique von Saint-Flour Communauté bietet Ihnen auf 3 000 m² Wasserspaß und zahlreiche Sport- und Freizeitaktivitäten."
    ],
    "en": [
      "Looking for sport, relaxation or a wellness break? The Saint-Flour Communauté aqualudic center offers 3,000 m² of water-based fun and a wide range of sports and leisure activities."
    ],
    "it": [
      "Cercate sport, relax o una pausa benessere? Il centro acquatico della Communauté di Saint-Flour offre 3.000 m² di divertimento in acqua e un'ampia gamma di attività sportive e ricreative."
    ],
    "fr": [
      "Besoin de sport, de détente ou d’une pause Bien-être ? Le Centre aqualudique de Saint-Flour Communauté vous propose 3 000 m² de plaisirs liés à l’eau et de nombreuses activités sportives et ludiques."
    ],
    "es": [
      "¿Busca deporte, relajación o una escapada de bienestar? El centro acuático de Saint-Flour Communauté ofrece 3.000 m² de diversión acuática y una amplia gama de actividades deportivas y de ocio."
    ],
    "nl": [
      "Op zoek naar sport, ontspanning of wellness? Het aqualudisch centrum Saint-Flour Communauté biedt 3.000 m² waterplezier en een breed scala aan sport- en vrijetijdsactiviteiten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Centre aqualudique de Saint-Flour Communauté"
    ]
  },
