  "rdfs:comment": {
    "de": [
      "Easy2Ride steht für einen privilegierten Empfang, einen hervorragenden Unterricht und personalisierte Dienstleistungen. Um die Leidenschaft für die Berge mit Ihnen zu teilen und vielfältige Leistungen anzubieten."
    ],
    "en": [
      "Easy2Ride means exclusive welcome, top-quality instruction, and personalized services. Our goal is to share our passion for the mountains and offer a wide range of experiences."
    ],
    "it": [
      "Easy2Ride offre un'accoglienza calorosa, un insegnamento eccellente e servizi personalizzati. Vogliamo condividere con voi la nostra passione per la montagna e offrirvi un'ampia gamma di servizi."
    ],
    "fr": [
      "Easy2Ride c'est un accueil privilégié, un enseignement d'excellence et des services personnalisés. Pour vous faire partager la passion de la montagne, et offrir des prestations variées."
    ],
    "nl": [
      "Easy2Ride staat voor een bevoorrechte ontvangst, excellent onderwijs en gepersonaliseerde diensten. Om onze passie voor de bergen met je te delen en gevarieerde diensten aan te bieden."
    ],
    "es": [
      "Easy2Ride le ofrece una cálida bienvenida, una enseñanza excelente y servicios personalizados. Queremos compartir contigo nuestra pasión por la montaña y ofrecerte una amplia gama de servicios."
    ]
  },
  "rdfs:label": {
