  "rdfs:comment": {
    "de": [
      "Halber Tag zum Thema Ostern! Ostereiersuche, Fütterung der Tiere, Kreativworkshops, Imbiss. Aktivitäten für alle ab 2 Jahren (Kinder in Begleitung eines Erwachsenen). Reservierung erforderlich, da die Plätze begrenzt sind."
    ],
    "en": [
      "Easter-themed half-day! Easter Egg Hunt, Animal Feeding, Creative Workshops, Snacks. Activities open to everyone aged 2 and over (children accompanied by an adult). Places are limited and must be booked in advance."
    ],
    "it": [
      "Mezza giornata sul tema della Pasqua! Caccia alle uova di Pasqua, alimentazione degli animali, laboratori creativi, merenda. Attività aperte a tutti a partire dai 2 anni (bambini accompagnati da un adulto). I posti sono limitati e devono essere prenotati in anticipo."
    ],
    "fr": [
      "Demi journée sur le thème de Pâques ! Chasse aux oeufs de Pâques, Nourrissage des Animaux, Ateliers Créatifs, Goûter. Activités ouvertes à tous dès 2 ans (enfant accompagné d'un adulte). Sur réservation car places limitées."
    ],
    "es": [
      "¡Medio día sobre el tema de la Pascua! Búsqueda del huevo de Pascua, alimentación de animales, talleres creativos, merienda. Actividades abiertas a todos a partir de 2 años (niños acompañados de un adulto). Las plazas son limitadas y deben reservarse con antelación."
    ],
    "nl": [
      "Een halve dag in het teken van Pasen! Paaseieren zoeken, dieren voeren, creatieve workshops, snacks. Activiteiten toegankelijk voor iedereen vanaf 2 jaar (kinderen onder begeleiding van een volwassene). Plaatsen zijn beperkt en moeten van tevoren worden gereserveerd."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Activités de Pâques à la ferme pédagogique"
    ]
  },
