  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/fd584a04-1120-354a-a48b-9530d38e0fe6",
      "dc:description": {
        "de": [
          "Französische Küche, die mit frischen Produkten zubereitet wird.\nKurze Speisekarte.\n\nMittagsmenü: Vorspeise, Hauptgericht, Dessert 28?\nAbendessen und Wochenende: Vorspeise, Hauptgericht, Dessert 36?\n\nParkmöglichkeiten in der Nähe."
        ],
        "en": [
          "French cuisine using fresh produce.\nShort menu.\n\nLunch menu: starter, main course, dessert 28?\nDinner and weekend menus: Starter, main course, dessert 36?\n\nParking available nearby."
        ],
        "it": [
          "Cucina francese con prodotti freschi.\nUn breve menu.\n\nMenu del pranzo: antipasto, piatto principale, dessert 28?\nMenu per la cena e il fine settimana: antipasto, piatto principale, dessert 36?\n\nParcheggio disponibile nelle vicinanze."
        ],
        "fr": [
          "Cuisine française réalisée avec des produits frais. \nUne carte courte.\n\nFormule déjeuner: Entrée, plat, dessert 28€\nFormule diner et week-end: Entrée, plat, dessert 36€\n\nPossibilité de se garer à proximité."
        ],
        "nl": [
          "Franse keuken met verse producten.\nEen kort menu.\n\nLunchmenu: Voorgerecht, hoofdgerecht, dessert 28?\nDiner en weekendmenu: Voorgerecht, hoofdgerecht, dessert 36?\n\nParkeergelegenheid in de buurt."
        ],
        "es": [
          "Cocina francesa con productos frescos.\nUn breve menú.\n\nMenú mediodía: entrante, plato principal, postre 28?\nMenú de cena y fin de semana: entrante, plato principal, postre 36?\n\nAparcamiento en las inmediaciones."
        ]
      },
      "@type": [
        "Description"
      ],
