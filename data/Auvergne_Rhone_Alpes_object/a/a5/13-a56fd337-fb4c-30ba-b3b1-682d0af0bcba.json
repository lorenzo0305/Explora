  "rdfs:comment": {
    "de": [
      "Die größte Skischule Europas, mit 500 Skilehrern, die Sie beim Skifahren, Snowboarden und beim Freeriding begleiten."
    ],
    "ru": [
      "Крупнейшая в Европе лыжная школа, в которой работают 500 инструкторов, чтобы помочь вам научиться кататься на лыжах, сноубордах и вне лыжных трасс."
    ],
    "en": [
      "Whatever your level, we've got a ski lesson for you.\r\nThe 500 esf Courchevel 1850 ski instructors, all professionals in their field, will share their enthusiasm and perfect knowledge of the ski area with you."
    ],
    "it": [
      "La più grande scola di sci in Europa, con ben 500 istruttori di sci, snowboard e fuori pista a vostra disposizione."
    ],
    "fr": [
      "Quels que soient vos désirs et votre niveau nous aurons un cours de ski pour vous.\r\nLes 500 monitrices et moniteurs esf Courchevel 1850, en professionnels de la glisse, vous feront partager leur enthousiasme et leur parfaite connaissance du domaine skiable"
    ],
    "nl": [
      "Wat je wensen en niveau ook zijn, wij hebben een skiles voor je.\r\nDe 500 esf Courchevel 1850 instructeurs, allemaal professionals op hun gebied, zullen hun enthousiasme en hun perfecte kennis van het skigebied met je delen"
    ],
    "es": [
      "La escuela de esquí más grande de Europa cuenta con 500 instructores que te acompañarán en el esquí, el «snowboard» y fuera de pista."
    ]
  },
