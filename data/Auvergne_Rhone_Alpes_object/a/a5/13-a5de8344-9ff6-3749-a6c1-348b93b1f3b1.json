  "rdfs:comment": {
    "de": [
      "Im Zentrum eines kleinen Dorfes kochen wir mit frischen Produkten der Saison und empfangen Sie in unserem schönen Speisesaal und bei schönem Wetter auf der schattigen Terrasse, die sich zum Dorfplatz hin öffnet. Wir verfügen außerdem über 4 Gästezimmer."
    ],
    "en": [
      "We cook with fresh, seasonal produce. Situated in the centre of a small village, our restaurant has an attractive dining area and a shaded terrace looking out over the village square which is lovely in warm weather. We also have 4 rooms available for B&B."
    ],
    "it": [
      "Nel centro di un piccolo villaggio, cuciniamo con prodotti freschi di stagione e vi accogliamo nella nostra graziosa sala ristorante e, con il bel tempo, sulla terrazza ombreggiata che si affaccia sulla piazza del paese. Abbiamo anche 4 camere per gli ospiti."
    ],
    "fr": [
      "Au centre d'un petit village, nous cuisinons des produits frais de saison et vous accueillons dans notre jolie salle de restaurant et par beau temps sur la terrasse ombragée ouverte sur la place du village. Nous disposons également 4 chambres d'hôtes."
    ],
    "nl": [
      "In het centrum van een klein dorp koken we met verse seizoensproducten en verwelkomen we u in onze mooie restaurantzaal en, bij mooi weer, op het schaduwrijke terras met uitzicht op het dorpsplein. We hebben ook 4 gastenkamers."
    ],
    "es": [
      "En el centro de un pequeño pueblo, cocinamos con productos frescos de temporada y le damos la bienvenida en nuestra bonita sala de restaurante y, cuando hace buen tiempo, en la terraza a la sombra con vistas a la plaza del pueblo. También disponemos de 4 habitaciones para invitados."
    ]
  },
