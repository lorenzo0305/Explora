  "rdfs:comment": {
    "de": [
      "Im Jahr 1990 übernahm Frédéric Boissonnet das Familienweingut.\r\nDas Haus aus dem 17. Jahrhundert verbirgt mit Leidenschaft restaurierte Gewölbekeller, in denen die Weine Saint Joseph und Condrieu ausgebaut werden."
    ],
    "en": [
      "In 1990,  Frederic Boissonnet took over the family property. The house founded in 17 century, located in Serrieres, offers vaulted cellar, restaured with passion where there are raised our Saint Joseph and Condrieu wines."
    ],
    "it": [
      "Frédéric Boissonnet ha rilevato la tenuta di famiglia nel 1990.\r\nLa casa del XVII secolo nasconde cantine a volta, restaurate con cura, dove vengono maturati i vini Saint Joseph e Condrieu."
    ],
    "fr": [
      "C'est en 1990 que Frédéric Boissonnet reprend le domaine familial.\r\nLa maison du 17ème siècle cache des caves voûtées restaurées avec passion où sont élevés les Saint Joseph et Condrieu."
    ],
    "es": [
      "Frédéric Boissonnet se hizo cargo de la propiedad familiar en 1990.\r\nLa casa del siglo XVII esconde bodegas abovedadas que han sido restauradas con mimo y donde maduran los vinos Saint Joseph y Condrieu."
    ],
    "nl": [
      "Frédéric Boissonnet nam het familiedomein over in 1990.\r\nHet 17e-eeuwse huis verbergt gewelfde kelders die liefdevol zijn gerestaureerd en waar Saint Joseph en Condrieu wijnen rijpen."
    ]
  },
