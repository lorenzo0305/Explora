  "rdfs:comment": {
    "de": [
      "The Champions Course ist die 18-Loch-Strecke (Par 72) des Evian Resort Golf Club. Es erstreckt sich über eine Strecke von 6 128 Metern (6 702 Yards) und beherbergt jedes Jahr im Juli die Amundi Evian Championship, das einzige große Turnier in Kontinentaleuropa."
    ],
    "en": [
      "The Champions Course is the 18-hole course (par 72) of the Evian Resort Golf Club. It extends over a distance of 6,128 meters (6,702 yards) and hosts each year, in July, the Amundi Evian Championship, the only major tournament in continental Europe."
    ],
    "it": [
      "Il Champions Course è il percorso a 18 buche (par 72) dell'Evian Resort Golf Club. Si estende su una distanza di 6.128 metri (6.702 iarde) e ospita ogni luglio l'Amundi Evian Championship, l'unico torneo Major dell'Europa continentale."
    ],
    "fr": [
      "The Champions Course est le tracé 18 trous (par 72) de l’Evian Resort Golf Club. Il s'étend sur une distance de 6 128 mètres (6 702 yards) et accueille chaque année, en  juillet, The Amundi Evian Championship, unique tournoi Majeur d'Europe continentale."
    ],
    "es": [
      "El Champions Course es el campo de 18 hoyos (par 72) del Evian Resort Golf Club. Cubre una distancia de 6.128 metros (6.702 yardas) y acoge cada mes de julio el Amundi Evian Championship, el único torneo Major de Europa continental."
    ],
    "nl": [
      "De Champions Course is een 18-holes (6.120 meter - 6.693 yards) par 72 baan op de Evian Resort Golf Club. De locatie aan de oevers van het Meer van Genève en aan de voet van de Alpen biedt een uitzonderlijk uitzicht tijdens het spel."
    ]
  },
