  "rdfs:comment": {
    "de": [
      "Das Dorf St Cyr de Favières liegt auf dem Gipfel eines zerklüfteten Hügels, der die beiden riesigen Ebenen von Forez und Roannais voneinander trennt."
    ],
    "en": [
      "The village of St Cyr de Favières stands atop a rugged hill separating the two immense plains of Forez and Roannais."
    ],
    "it": [
      "Il villaggio di St Cyr de Favières si trova in cima a un'aspra collina che separa le due immense pianure del Forez e del Roannais."
    ],
    "fr": [
      "C’est au sommet d’un monticule accidenté qui sépare les deux immenses plaines du Forez et du Roannais que s’élève le village de St Cyr de Favières."
    ],
    "nl": [
      "Het dorp St Cyr de Favières ligt op de top van een ruige heuvel die de twee immense vlaktes van Forez en Roannais scheidt."
    ],
    "es": [
      "El pueblo de St Cyr de Favières se alza en lo alto de una escarpada colina que separa las dos inmensas llanuras de Forez y Roannais."
    ]
  },
  "rdfs:label": {
