  "rdfs:comment": {
    "de": [
      "Dieses Restaurant liegt im Herzen des Dorfes Génissiat und 300 m vom Staudamm entfernt. Es bietet Ihnen eine Gourmetküche, traditionelle Gerichte und Pizzen, alles in einem gemütlichen Rahmen."
    ],
    "en": [
      "Located in the heart of the village of Génissiat and 300 metres from the dam, this restaurant offers gourmet, traditional cuisine and pizzas in a warm setting."
    ],
    "it": [
      "Situato nel cuore del villaggio di Génissiat e a 300 metri dalla diga, questo ristorante offre una cucina gourmet tradizionale e pizze, il tutto in un ambiente accogliente."
    ],
    "fr": [
      "Situé au cœur du village de Génissiat et à 300 mètres du barrage, ce restaurant vous propose une cuisine gourmande, traditionnelle ainsi que des pizzas, le tout dans un cadre chaleureux."
    ],
    "es": [
      "Situado en el corazón del pueblo de Génissiat y a 300 metros de la presa, este restaurante ofrece cocina gastronómica tradicional y pizzas, todo ello en un ambiente cálido."
    ],
    "nl": [
      "Gelegen in het hart van het dorp Génissiat en op 300 meter van de stuwdam, biedt dit restaurant traditionele gastronomische gerechten en pizza's, allemaal in een warme omgeving."
    ]
  },
