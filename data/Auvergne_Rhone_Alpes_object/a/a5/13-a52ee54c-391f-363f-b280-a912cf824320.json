  "rdfs:comment": {
    "de": [
      "O'Spart ist ein multidisziplinäres Fitnesscenter, das Calisthenic (Körpergewicht), Street Workout, Kletterblock und Gewichtheben sowie Crosstraining anbietet und auf drei Säulen beruht: Willenskraft, Spaß und Geselligkeit."
    ],
    "en": [
      "O'Spart is a multi-disciplinary fitness center offering Calisthenic (bodyweight), street workout, bouldering, weightlifting and cross-training, based on three pillars: determination, fun and conviviality."
    ],
    "it": [
      "O'Spart è un centro fitness multidisciplinare che offre Calisthenics (bodyweight), street workout, climbing block e weightlifting, cross training e si basa su tre pilastri: forza di volontà, piacere e convivialità."
    ],
    "fr": [
      "O'Spart est un centre de remise en forme pluridisciplinaire proposant Calisthenic (poids de corps), street workout, bloc d'escalade et haltérophilie, cross training et qui repose sur trois piliers : la volonté, le plaisir et la convivialité."
    ],
    "nl": [
      "O'Spart is een multidisciplinair fitnesscentrum met calisthenics (lichaamsgewicht), street workout, klimblok en gewichtheffen, crosstraining en is gebaseerd op drie pijlers: wilskracht, plezier en gezelligheid."
    ],
    "es": [
      "O'Spart es un centro de fitness multidisciplinar que ofrece calistenia (peso corporal), street workout, bloque de escalada y halterofilia, entrenamiento cruzado y se basa en tres pilares: fuerza de voluntad, placer y convivencia."
    ]
  },
