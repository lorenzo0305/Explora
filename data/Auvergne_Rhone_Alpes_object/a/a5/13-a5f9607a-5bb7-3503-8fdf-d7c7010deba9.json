  "rdfs:comment": {
    "de": [
      "Erleben Sie die Emotionen! Nähe, Zärtlichkeit, Geschmack, Atmosphäre und atemberaubende Shows... Das ganze Jahr über bietet Ihnen Voulez-Vous Grand Lyon Dinnershow-Abende, von denen Sie noch lange sprechen werden."
    ],
    "en": [
      "Live the emotion! The proximity, the sweetness, the taste, the atmosphere and the breathtaking shows ...Throughout the year, Voulez-Vous Grand Lyon offers evening dinner shows you will talk about for a long time."
    ],
    "it": [
      "Provate l'emozione! Spettacoli ravvicinati, dolci, di buon gusto, d'atmosfera e mozzafiato? Tutto l'anno, il Voulez-Vous Grand Lyon vi propone cene e spettacoli di cui parlerete a lungo."
    ],
    "fr": [
      "Vivez l’émotion ! De la proximité, de la douceur, du goût, de l’ambiance et des shows époustouflants… Toute l’année, Voulez-Vous Grand Lyon vous propose des soirées en dîner-spectacle dont vous parlerez pendant longtemps."
    ],
    "es": [
      "¡Viva la emoción! ¿Espectáculos cercanos, dulces, de buen gusto, atmosféricos e impresionantes? Durante todo el año, Voulez-Vous Grand Lyon le ofrece cenas y espectáculos de los que hablará durante mucho tiempo."
    ],
    "nl": [
      "Ervaar de emotie! Dichtbij, zoet, lekker, sfeervol en adembenemende shows... Het hele jaar door biedt Voulez-Vous Grand Lyon u diner- en showavonden waar u nog lang over zult napraten."
    ]
  },
