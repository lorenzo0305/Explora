  "rdfs:comment": {
    "de": [
      "Zwischen Valence und Montélimar, 3 Minuten von der Autobahn A 7 - Ausfahrt Loriol entfernt. Grüne und sehr ruhige Umgebung. Schwimmbad, Solarium, Spa 300m², Fitnessraum, große schattige Terrasse. Seminare, Qualitativ hochwertige, hausgemachte Gastronomie."
    ],
    "en": [
      "In the sun of Drôme Provençale, between Valence and Montélimar, 3 minutes from exit \"Loriol\" on motorway A7. Calm, green setting."
    ],
    "it": [
      "Tra Valence e Montélimar, a 3 minuti dall'autostrada A7 - uscita Loriol. Ambiente verde e tranquillo. Piscina, spa di 300 m², sala fitness, ampia terrazza ombreggiata. Seminari, ristorazione di qualità e fatta in casa."
    ],
    "fr": [
      "Entre Valence et Montélimar, à 3 minutes de l'autoroute A 7 - sortie Loriol. Cadre verdoyant et très calme. Piscine, spa 300m², Salle de fitness, Grande terrasse ombragée. Séminaires, Restauration de qualité, fait maison."
    ],
    "nl": [
      "Tussen Valence en Montélimar, op 3 minuten van de snelweg A7 - afslag Loriol. Groene, rustige omgeving. Zwembad, solarium, spa van 300 m², fitnessruimte, groot schaduwrijk terras. Seminars, kwaliteit, huisgemaakte catering."
    ],
    "es": [
      "Entre Valence y Montélimar, a 3 minutos de la autopista A7 - salida Loriol. Entorno verde y tranquilo. Piscina, spa de 300 m², sala de fitness, gran terraza sombreada. Seminarios, restauración casera de calidad."
    ]
  },
