  "rdfs:comment": {
    "de": [
      "Möchten Sie eine einzigartige, entspannte und spektakuläre Erfahrung machen?\r\nWie wäre es mit einem Gleitflug über den Montblanc? Oder gleiten Sie lautlos über die Bergkämme der Belledonne, der Chartreuse und des Lac du Bourget?\r\nEntdecken Sie die Berge vom Segelflugzeug aus!"
    ],
    "en": [
      "Are you looking for a unique, relaxing, and spectacular experience?\r\nHow about gliding over Mont Blanc? Or silently gliding along the ridges of Belledonne, Chartreuse, and Lake Bourget?\r\nDiscover the mountains from a glider!"
    ],
    "it": [
      "Desideri vivere un'esperienza unica, rilassante e spettacolare?\r\nChe ne diresti di librarti sopra il Monte Bianco? O di scivolare silenziosamente lungo le creste di Belledonne, della Chartreuse e del lago del Bourget? \r\nScopri la montagna da un aliante!"
    ],
    "fr": [
      "Vous souhaitez une expérience unique, détendue, et spectaculaire?\r\nQue diriez-vous de planer au dessus du Mont-blanc? Ou de glisser sans bruit le long des crêtes de Belledonne, de la Chartreuse, du lac du Bourget? \r\nDécouvrez la montagne depuis un planeur!"
    ],
    "es": [
      "¿Busca una experiencia única, relajada y espectacular?\r\n¿Qué tal sobrevolar el Mont Blanc? ¿O deslizarse silenciosamente por las crestas del Belledonne, la Chartreuse y el lago Bourget?\r\nDescubra la montaña desde un planeador"
    ],
    "nl": [
      "Wilt u een unieke, ontspannen en spectaculaire ervaring?\r\nWat dacht u ervan om boven de Mont Blanc te zweven? Of geruisloos langs de bergkammen van Belledonne, Chartreuse en het meer van Bourget te glijden? \r\nOntdek de bergen vanuit een zweefvliegtuig!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Soaring adventures : vols en planeur"
    ]
  },
