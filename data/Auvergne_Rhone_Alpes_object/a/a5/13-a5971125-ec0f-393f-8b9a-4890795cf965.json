  "rdfs:comment": {
    "de": [
      "Der Dinoplagne-Standort wurde vom Departement Ain mit dem Label \"Espace Naturel Sensible\" ausgezeichnet und beherbergt die weltweit längste Spur von Fußabdrücken des Sauropoden-Dinosauriers. Für den Besuch der Stätte wird eine Reservierung im Voraus empfohlen."
    ],
    "en": [
      "abeled Sensitive Natural Space by the Ain Department; Dinoplagne is home to the longest track of dinosaur footprints !\r\nTo visit: reservation recommended !"
    ],
    "it": [
      "Etichettato come Area Naturale Sensibile dal dipartimento dell'Ain, il sito Dinoplagne ospita la traccia più lunga al mondo di impronte di dinosauro sauropode. Per visitare il sito si consiglia la prenotazione anticipata."
    ],
    "fr": [
      "Labellisé Espace Naturel Sensible par le département de l'Ain, le site de Dinoplagne abrite la plus longue piste au monde d'empreintes de dinosaure Sauropode. La réservation en amont est recommandée pour visiter le site."
    ],
    "es": [
      "Declarado Espacio Natural Sensible por el departamento de Ain, el yacimiento de Dinoplagne alberga el rastro de huellas de dinosaurio saurópodo más largo del mundo. Se recomienda reservar con antelación para visitar el yacimiento."
    ],
    "nl": [
      "De Dinoplagne-site, die door het departement Ain is aangewezen als kwetsbaar natuurgebied, herbergt 's werelds langste spoor van voetafdrukken van dinosaurussen uit de Sauropode. Vooraf reserveren wordt aanbevolen om de site te bezoeken."
    ]
  },
