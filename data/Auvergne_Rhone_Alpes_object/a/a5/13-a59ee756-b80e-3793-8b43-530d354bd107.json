  "rdfs:comment": {
    "de": [
      "Das MJC Sans Souci ist ein Verein, Gesetz 1901, der im Frühjahr 2022 mit dem Ziel gegründet wurde, den Bewohnern des Sektors ein vielfältiges Angebot an Aktivitäten, einen Ort für generationsübergreifende Begegnungen, einen Raum für Veranstaltungen... zu bieten."
    ],
    "en": [
      "The MJC Sans Souci is an association under the law of 1901, created in the spring of 2022 with the ambition of offering local residents a diversified range of activities, a place for intergenerational encounters, a space for events..."
    ],
    "it": [
      "L'MJC Sans Souci è un'associazione ai sensi della legge del 1901, creata nella primavera del 2022 con l'ambizione di offrire agli abitanti della zona un'ampia gamma di attività, un luogo di incontro intergenerazionale, uno spazio per eventi..."
    ],
    "fr": [
      "La MJC Sans Souci est une association, loi 1901, créée au printemps 2022 avec l'ambition d'offrir aux habitants du secteur, une offre diversifiée d'activités, un lieu de rencontres intergénérationnelles, un espace d'événements..."
    ],
    "nl": [
      "Het MJC Sans Souci is een vereniging volgens de wet van 1901, opgericht in het voorjaar van 2022 met de ambitie om de bewoners van de wijk een gevarieerd aanbod aan activiteiten te bieden, een plek voor ontmoetingen tussen generaties, een ruimte voor evenementen..."
    ],
    "es": [
      "El MJC Sans Souci es una asociación amparada por la ley de 1901, creada en la primavera de 2022 con la ambición de ofrecer a los residentes de la zona un amplio abanico de actividades, un lugar de encuentro intergeneracional, un espacio para eventos..."
    ]
  },
  "rdfs:label": {
