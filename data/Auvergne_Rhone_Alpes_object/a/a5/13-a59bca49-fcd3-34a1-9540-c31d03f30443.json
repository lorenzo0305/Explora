  "rdfs:comment": {
    "de": [
      "Von Brides-les-Bains aus geniessen Sie eine Spritzfahrt durch Tarentaise und Beaufortain. Bourg-Saint-Maurice, Cormet de Roselend, Lac de Roselend, Arèches, Beaufort… lassen Sie sich von den Bergen durchdringen. Und ... nicht vergessen, mit Beaufort (lokale Käse) aufzutanken !"
    ],
    "en": [
      "From Brides-les-Bains, treat yourself to a trip through the Tarentaise and Beaufortain valleys. Bourg-Saint-Maurice, Cormet de Roselend, Lake of Roselend, Arèches, Beaufort... let yourself be won over by the mountain. And... don't forget to stock up on Beaufort (delicious local cheese)!"
    ],
    "it": [
      "Da Brides-les-Bains, fate un viaggio attraverso le regioni della Tarentaise e del Beaufortain. Bourg-Saint-Maurice, Cormet de Roselend, Lac de Roselend, Arèches, Beaufort: lasciatevi conquistare dalle montagne. E non dimenticate di fare il pieno di Beaufort!"
    ],
    "fr": [
      "Depuis Brides-les-Bains, offrez-vous une virée à travers Tarentaise et Beaufortain. Bourg-Saint-Maurice, Cormet de Roselend, Lac de Roselend, Arèches, Beaufort… laissez-vous gagner par la montagne. Et…n’oubliez pas de faire le plein de Beaufort !"
    ],
    "nl": [
      "Maak vanuit Brides-les-Bains een tocht door de regio's Tarentaise en Beaufortain. Bourg-Saint-Maurice, Cormet de Roselend, Lac de Roselend, Arèches, Beaufort? laat je verleiden door de bergen. En vergeet niet te tanken in Beaufort!"
    ],
    "es": [
      "Desde Brides-les-Bains, recorra las regiones de Tarentaise y Beaufortain. Bourg-Saint-Maurice, Cormet de Roselend, Lac de Roselend, Arèches, Beaufort... déjese conquistar por las montañas. Y... ¡no olvide repostar Beaufort!"
    ]
  },
  "rdfs:label": {
    "de": [
      "Ausflug 4 – Cormet de Roselend – Atemraubende Aussichten"
    ],
    "en": [
      "Excursion 4 – Cormet De Roselend – Breathtaking Views"
    ],
    "fr": [
      "Excursion 4 – Cormet de Roselend – Paysages A Couper Le Souffle"
    ]
  },
