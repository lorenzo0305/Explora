  "rdfs:comment": {
    "de": [
      "Ludik & Magik bietet Veranstaltungen rund um Rollenspiele, das Spiel \"Werwolf\" und Abenteuerspiele wie HeroQuest oder Dungeons & Dragons für Kinder, Jugendliche, Erwachsene und sogar Senioren an."
    ],
    "en": [
      "Ludik & Magik offers activities based on role-playing games, werewolves and adventure games such as HeroQuest and Dungeons & Dragons, for children, teenagers, adults and even senior citizens."
    ],
    "it": [
      "Ludik & Magik propone eventi basati su giochi di ruolo, lupi mannari e giochi d'avventura come HeroQuest e Dungeons & Dragons, adatti a tutte le età (bambini, adolescenti, adulti e persino anziani)."
    ],
    "fr": [
      "Ludik & Magik propose des animations autour du jeu de rôle, du jeu “Loup-Garou” et de jeux d’aventure tels que HeroQuest ou Donjons & Dragons, adaptées à tous les publics (enfants, adolescents, adultes et même seniors)."
    ],
    "es": [
      "Ludik & Magik ofrece eventos basados en juegos de rol, hombres lobo y juegos de aventuras como HeroQuest y Dragones y Mazmorras, aptos para todas las edades (niños, adolescentes, adultos e incluso personas mayores)."
    ],
    "nl": [
      "Ludik & Magik biedt evenementen gebaseerd op rollenspellen, weerwolven en avonturenspellen zoals HeroQuest en Dungeons & Dragons, geschikt voor alle leeftijden (kinderen, tieners, volwassenen en zelfs senioren)."
    ]
  },
