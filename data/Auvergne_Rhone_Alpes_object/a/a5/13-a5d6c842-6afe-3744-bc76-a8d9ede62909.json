  "rdfs:comment": {
    "de": [
      "Willkommen bei L'atelier d'André. Ich bin Antoine, ein leidenschaftlicher Kunsthandwerker, der sich in Saint-Didier-la-Forêt niedergelassen hat, und ich stelle sorgfältig handgefertigte Duftkerzen her."
    ],
    "en": [
      "Welcome to the enchanting world of \"L'atelier d'André\", where each scented candle is a modern-day madeleine de Proust, evoking timeless memories and emotions."
    ],
    "it": [
      "Benvenuti a L'atelier d'André. Sono Antoine, un appassionato artigiano di Saint-Didier-la-Forêt, e creo con cura candele profumate fatte a mano."
    ],
    "fr": [
      "Bienvenue à L’atelier d’André. Je suis Antoine, artisan passionné installé à Saint-Didier-la-Forêt, et je crée des bougies parfumées faites main avec soin."
    ],
    "nl": [
      "Welkom bij L'atelier d'André. Ik ben Antoine, een gepassioneerd ambachtsman uit Saint-Didier-la-Forêt, en ik maak met zorg handgemaakte geurkaarsen."
    ],
    "es": [
      "Bienvenido a L'atelier d'André. Soy Antoine, un artesano apasionado afincado en Saint-Didier-la-Forêt, y creo velas perfumadas hechas a mano con esmero."
    ]
  },
