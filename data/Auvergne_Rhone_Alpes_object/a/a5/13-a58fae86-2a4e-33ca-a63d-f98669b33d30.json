  "rdfs:comment": {
    "de": [
      "Landwirtschaftlicher Erzeuger in Isère, der sich auf die Aufzucht von Bio-Geflügel und die Herstellung von Terrinen, Köstlichkeiten und Fertiggerichten aus seiner Produktion spezialisiert hat, die auf Märkten und in Bioläden erhältlich sind."
    ],
    "en": [
      "Agricultural producer in Isère specializing in organic poultry farming and the production of terrines, delicatessen and ready-cooked meals from its production, available in organic markets and stores."
    ],
    "it": [
      "Produttore agricolo dell'Isère specializzato nell'allevamento biologico di pollame e nella produzione di terrine, prelibatezze e piatti pronti con i suoi prodotti, disponibili nei mercati e nei negozi biologici."
    ],
    "fr": [
      "Producteur agricole en Isère spécialisé dans l’élevage de volailles biologiques et la fabrication de terrines, délices et plats cuisinés issus de sa production, disponible en marchés et magasins biologiques."
    ],
    "es": [
      "Productor agrícola de Isère especializado en la avicultura ecológica y la producción de terrinas, delicatessen y platos preparados a partir de sus productos, disponibles en mercados y tiendas ecológicos."
    ],
    "nl": [
      "Landbouwproducent in Isère, gespecialiseerd in biologische pluimveehouderij en de productie van terrines, delicatessen en kant-en-klaarmaaltijden van zijn producten, verkrijgbaar op biologische markten en in winkels."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Ferme de Valensole"
    ]
  },
