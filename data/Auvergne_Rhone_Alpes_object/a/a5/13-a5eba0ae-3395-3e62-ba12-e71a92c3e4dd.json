  "rdfs:comment": {
    "de": [
      "Restaurant, das Burger, Hotdogs, Salate, Tapas und Teller anbietet, die aus frischen, lokalen Produkten hergestellt werden. Außerdem finden Sie hier eine große Auswahl an Getränken mit verschiedenen Bieren aus aller Welt.\r\nVor Ort oder zum Mitnehmen."
    ],
    "en": [
      "Restaurant offering burgers, hot dogs, salads, tapas and plates made with fresh and local products. You will also find a wide selection of drinks with several beers from all around the world.\r\nOn site or take away."
    ],
    "it": [
      "Ristorante che offre hamburger, hot dog, insalate, tapas e piatti a base di prodotti freschi e locali. L'offerta di bevande è ampia e comprende diverse birre provenienti da tutto il mondo.\r\nSul posto o da portare via."
    ],
    "fr": [
      "Restaurant proposant des burgers, des hot-dogs, des salades, des tapas et des assiettes faits avec des produits frais et locaux. Vous y trouverez également un large choix de boissons avec plusieurs bières du monde.\r\nSur place ou à emporter."
    ],
    "es": [
      "Restaurante que ofrece hamburguesas, perritos calientes, ensaladas, tapas y platos elaborados con productos frescos y locales. También hay una amplia gama de bebidas con varias cervezas de todo el mundo.\r\nEn el acto o para llevar."
    ],
    "nl": [
      "Restaurant met hamburgers, hotdogs, salades, tapas en borden, bereid met verse en lokale producten. U vindt er ook een brede selectie van dranken met verschillende bieren uit de hele wereld.\r\nOp het terrein of mee te nemen."
    ]
  },
