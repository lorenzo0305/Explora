  "rdfs:comment": {
    "de": [
      "Ideal gelegen, mit einem großen Parkplatz, einer schattigen Terrasse und einem Bereich für Kinder, bietet Ihnen das Le Cézanne traditionelle Küche in einer familiären Atmosphäre. Privatisierung des Saals für Geburtstage, Hochzeiten, Bankette möglich..."
    ],
    "en": [
      "Ideally situated, with a large car park, terrace, the Cézanne offers you traditional cuisine."
    ],
    "it": [
      "Situato in posizione ideale, con un ampio parcheggio, una terrazza ombreggiata e un'area per bambini, il Cézanne offre una cucina tradizionale in un'atmosfera familiare. È possibile privatizzare la sala per compleanni, matrimoni, banchetti..."
    ],
    "fr": [
      "Idéalement situé, avec un grand parking, une terrasse ombragée, un espace pour les enfants, le Cézanne vous propose une cuisine traditionnelle dans une ambiance familiale. Privatisation possible de la salle pour des anniversaires, mariages, banquets..."
    ],
    "nl": [
      "Le Cézanne met een ideale ligging, een groot parkeerterrein en terras, biedt een traditionele keuken."
    ],
    "es": [
      "Idealmente situado, con un amplio aparcamiento, una terraza a la sombra y una zona infantil, el Cézanne ofrece una cocina tradicional en un ambiente familiar. Es posible privatizar la sala para cumpleaños, bodas, banquetes..."
    ]
  },
