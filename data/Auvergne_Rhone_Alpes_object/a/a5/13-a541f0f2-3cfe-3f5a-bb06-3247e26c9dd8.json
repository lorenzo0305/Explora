  "rdfs:comment": {
    "de": [
      "Ideal gelegen am Ufer der Loire im Herzen des wunderschönen Dorfes Goudet auf dem Stevenson-Weg GR70, der Tour des Volcans du Velay (GR40) und dem Weg durch die Loire-Schluchten (GR3). Das Restaurant empfängt Sie mittags und abends an sieben Tagen in der Woche."
    ],
    "en": [
      "Ideally located on the banks of the Loire in the heart of the beautiful village of Goudet, on the Stevenson GR70, the Tour des Volcans du Velay (GR40) and the Chemin des Gorges de la Loire (GR3). The restaurant welcomes you for lunch and dinner, 7 days a week."
    ],
    "it": [
      "Situato in posizione ideale sulle rive della Loira, nel cuore del magnifico villaggio di Goudet, sulla Stevenson GR70, il Tour des Volcans du Velay (GR40) e il Chemin des Gorges de la Loire (GR3). Il ristorante vi accoglie per pranzo e cena, 7 giorni su 7."
    ],
    "fr": [
      "Idéalement situé en bordure de Loire au cœur du magnifique village de Goudet sur le Chemin de Stevenson GR70, du Tour des volcans du Velay (GR40) et le Chemin des gorges de la Loire (GR3). Le restaurant vous accueille midi et soir 7 jours sur 7."
    ],
    "es": [
      "Idealmente situado a orillas del Loira, en el corazón del magnífico pueblo de Goudet, en el Stevenson GR70, el Tour des Volcans du Velay (GR40) y el Chemin des Gorges de la Loire (GR3). El restaurante le da la bienvenida para el almuerzo y la cena, 7 días a la semana."
    ],
    "nl": [
      "Ideaal gelegen aan de oevers van de Loire in het hart van het prachtige dorp Goudet aan de Stevenson GR70, de Tour des Volcans du Velay (GR40) en de Chemin des Gorges de la Loire (GR3). Het restaurant verwelkomt u voor lunch en diner, 7 dagen per week."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant de l'Hôtel de la Loire"
    ]
  },
