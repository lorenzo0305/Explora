  "rdfs:comment": {
    "de": [
      "Freie Besichtigung auf Anfrage der Schlüssel beim Rathaus. Das Gebäude aus dem 13. und 15. Jahrhundert besteht aus einem Schiff mit drei Jochen aus dem 13."
    ],
    "en": [
      "Free visit on request of the keys from the town hall. The 13th and 15th century building has a nave of three bays dating from the 13th century."
    ],
    "it": [
      "Visita gratuita su richiesta delle chiavi del municipio. L'edificio, risalente al XIII e XV secolo, ha una navata a tre campate che risale al XIII secolo."
    ],
    "fr": [
      "Visite libre sur demande des clés auprès de la mairie. L'édifice des XIIIe et XVe siècles comporte une nef de trois travées datant du XIIIe."
    ],
    "es": [
      "Visita gratuita a petición de las llaves del ayuntamiento. El edificio de los siglos XIII y XV tiene una nave de tres tramos que data del siglo XIII."
    ],
    "nl": [
      "Gratis bezoek op aanvraag van de sleutels van het stadhuis. Het gebouw uit de 13e en 15e eeuw heeft een schip met drie traveeën uit de 13e eeuw."
    ]
  },
