  "rdfs:comment": {
    "de": [
      "Chefkoch Alain Pourret bietet Ihnen eine traditionelle, leckere und einfallsreiche Küche, die aus frischen und saisonalen Produkten besteht, die je nach Geschmack der Region Drôme Ardèche erneuert werden."
    ],
    "en": [
      "Creative gourmet cooking. New menu twice a year."
    ],
    "it": [
      "Lo chef Alain Pourret propone una cucina tradizionale, gourmet e inventiva, utilizzando prodotti freschi e di stagione, rinnovati secondo i sapori della regione Drôme Ardèche."
    ],
    "fr": [
      "Le chef Alain Pourret vous propose une cuisine traditionnelle, gourmande et inventive, composée de produits frais et de saison renouvelés au gré des saveurs de la région Drôme Ardèche."
    ],
    "nl": [
      "Inventieve gastronomische keuken. Twee keer per jaar een nieuwe kaart"
    ],
    "es": [
      "El chef Alain Pourret ofrece una cocina tradicional, gourmet e inventiva, con productos frescos y de temporada que se renuevan según los sabores de la región de la Drôme Ardèche."
    ]
  },
  "rdfs:label": {
