  "rdfs:comment": {
    "de": [
      "Als Erbe eines überlieferten Know-hows bietet dieses Haus Trockenwürste, Salami, Schweineterrinen..., deren Geschmack von der frischen Höhenluft und einer gut gehüteten Tradition geprägt ist\r\nLabel Goutez l'Ardèche."
    ],
    "en": [
      "Heiress of an ancestral know-how, this house proposes dried sausages, sausages, pork's terrines... with a well kept tradition."
    ],
    "it": [
      "Erede di un sapere ancestrale, questa casa propone salsicce secche, wurstel, terrine di maiale... con sapori impregnati dell'aria fresca dell'altitudine e di una tradizione ben custodita\r\nEtichetta Goutez l'Ardèche."
    ],
    "fr": [
      "Héritière d'un savoir-faire ancestral, cette maison propose des saucisses sèches, saucissons, terrines de porc...aux goûts imprégnés du grand air de l'altitude et d'une tradition bien gardée. \r\nLabel Goutez l'Ardèche."
    ],
    "es": [
      "Heredera de un saber hacer ancestral, esta casa ofrece embutidos secos, salchichas, terrinas de cerdo... con sabores impregnados del aire fresco de la altitud y de una tradición bien guardada\r\nEtiqueta Goutez l'Ardèche."
    ],
    "nl": [
      "Erfgenaam van een voorouderlijke knowhow, biedt dit huis droge worst, worst, varkensvlees terrines... met smaken doordrenkt met de frisse lucht van de hoogte en een goed bewaarde traditie\r\nLabel Goutez l'Ardèche."
    ]
  },
