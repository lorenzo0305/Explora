  "rdfs:comment": {
    "de": [
      "Ein in Europa einzigartiger Park mit einem riesigen Holzlabyrinth auf zwei Ebenen, 30 optischen Täuschungen, die weltweit einzigartig sind + Seilbahnen, Go-Karts, Klettergerüste, riesige Holzspiele... Süße und salzige Speisen aus lokalen und biologischen Produkten."
    ],
    "en": [
      "The first park of its kind in Europe, with a giant wooden labyrinth on 2 levels, some 30 optical illusions unique in the world + zip lines, pedal go-karts, accrokids, giant wooden games...Sweet and savory catering based on local and organic products."
    ],
    "it": [
      "Il primo parco del genere in Europa, con un gigantesco labirinto di legno su 2 livelli, una trentina di illusioni ottiche uniche al mondo, oltre a teleferiche, go-kart a pedali, accrokids, giochi di legno giganti, ecc."
    ],
    "fr": [
      "Parc inédit en Europe avec un labyrinthe en bois géant sur 2 niveaux, une trentaine d'illusions d'optiques unique au monde! + tyroliennes , karts à pédales, accrokids, jeux en bois géants...Restauration salée et sucrée à base de produits locaux et ou bio."
    ],
    "nl": [
      "Het eerste park in zijn soort in Europa, met een reusachtig houten labyrint op 2 niveaus, een dertigtal optische illusies die uniek zijn in de wereld, plus tokkelbanen, skelters, accrokids, reusachtige houten spellen, etc. Lekkere en zoete snacks op basis van lokale en biologische producten."
    ],
    "es": [
      "El primer parque de este tipo en Europa, con un laberinto gigante de madera en 2 niveles, una treintena de ilusiones ópticas únicas en el mundo, además de tirolinas, karts a pedales, accrokids, juegos gigantes de madera, etc. Aperitivos salados y dulces a base de productos locales y ecológicos."
    ]
  },
