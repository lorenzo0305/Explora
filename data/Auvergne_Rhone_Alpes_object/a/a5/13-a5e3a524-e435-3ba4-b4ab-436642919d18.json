  "rdfs:comment": {
    "de": [
      "Das Restaurant 1976, ist eine Brasserie, die von Montag bis Freitag mittags geöffnet ist.\r\nEs befindet sich neben dem Stadion Geoffroy Guichard und ist auch an Spieltagen geöffnet"
    ],
    "en": [
      "Restaurant 1976 is a brasserie open from Monday to Friday lunchtime.\r\nLocated next to the Geoffroy Guichard stadium, we are also open on match days"
    ],
    "it": [
      "Il ristorante 1976 è una brasserie aperta dal lunedì al venerdì a pranzo.\r\nSituato accanto allo stadio Geoffroy Guichard, è aperto anche nei giorni delle partite"
    ],
    "fr": [
      "Le restaurant 1976, est une brasserie ouverte du lundi au vendredi midi. \r\nSitué à côté du stade Geoffroy Guichard, nous ouvrons également les jours de match"
    ],
    "nl": [
      "Restaurant 1976 is een brasserie die geopend is van maandag tot vrijdag tijdens lunchtijd.\r\nGelegen naast het Geoffroy Guichard stadion, zijn we ook open op wedstrijddagen"
    ],
    "es": [
      "El restaurante 1976 es una brasserie abierta de lunes a viernes al mediodía.\r\nSituado junto al estadio Geoffroy Guichard, también abrimos los días de partido"
    ]
  },
