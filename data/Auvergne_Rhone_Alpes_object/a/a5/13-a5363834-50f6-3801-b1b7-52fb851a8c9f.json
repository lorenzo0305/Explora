  "rdfs:comment": {
    "de": [
      "Vermietung von Quads für geführte Wanderungen von März bis November. Ob mit Freunden, zu zweit oder mit der Familie, ob Sie Anfänger oder Fortgeschrittener sind, ich begleite Sie mit Leidenschaft über die Wege und Pfade."
    ],
    "en": [
      "Quad rental with guide from March to November. With friends, as a couple or as a family, whether you're a beginner or an experienced rider, I'll accompany you with passion along the paths and trails."
    ],
    "it": [
      "Noleggio di quad con guida da marzo a novembre. Con gli amici, in coppia o in famiglia, che siate principianti o esperti, sarò lieto di guidarvi lungo i sentieri e le piste."
    ],
    "fr": [
      "Location de quad en randonnée avec guide de Mars à Novembre. Entre amis, en couple ou en famille, que vous soyez débutant ou confirmé, c’est avec passion que je vous accompagne à travers les chemins et sentiers."
    ],
    "nl": [
      "Quadverhuur met gids van maart tot november. Met vrienden, met z'n tweeën of met het hele gezin, of je nu een beginner of een ervaren rijder bent, ik begeleid je graag over de paden en paden."
    ],
    "es": [
      "Alquiler de quads con guía de marzo a noviembre. Con amigos, en pareja o en familia, tanto si eres principiante como experimentado, estaré encantado de guiarte por los senderos y pistas."
    ]
  },
  "rdfs:label": {
