  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/cbcf87b0-dc9e-3f61-9f6c-bed4db45024e",
      "dc:description": {
        "de": [
          "Freitag, den 04. Oktober 2024 um 20.30 Uhr im Centre Phénix :\nAbend zur Eröffnung der Kultursaison - Kristov Langagne interpretiert die größten Chanson-Standards neu und wird dabei von der Harmonie Municipale de la Ville d'Outreau begleitet.\nReservierung unter 0321804953 - Kostenlos - Kulturabteilung der Stadt Outreau."
        ],
        "en": [
          "Friday, October 04, 2024 at 8:30pm at the Centre Phénix:\nCultural season launch evening - Kristov Langagne revisits the greatest chanson standards, accompanied by the Harmonie Municipale de la Ville d'Outreau.\nReservations at 0321804953 - Free of charge - Outreau cultural department."
        ],
        "it": [
          "Venerdì 04 ottobre 2024 alle ore 20.30 presso il Centre Phénix:\nInaugurazione della stagione culturale - Kristov Langagne rivisita i più grandi standard della chanson accompagnato dall'Harmonie Municipale de la Ville d'Outreau.\nPrenotazioni su 0321804953 - Gratuito - Dipartimento culturale di Outreau."
        ],
        "fr": [
          "Vendredi 04 octobre 2024 à 20h30 au Centre Phénix : \nSoirée de lancement de la saison culturelle - Kristov Langagne revisite les plus grands standards de la chanson en compagnie de l'Harmonie Municipale de la Ville d'Outreau. \nRéservation au 0321804953 - Gratuit - service culturel de la Ville d'Outreau."
        ],
        "nl": [
          "Vrijdag 04 oktober 2024 om 20.30 uur in het Centre Phénix:\nStart van het culturele seizoen - Kristov Langagne herneemt de grootste chansons begeleid door de Harmonie Municipale de la Ville d'Outreau.\nReserveren op 0321804953 - Gratis - Outreau culturele afdeling."
        ],
        "es": [
          "Viernes 4 de octubre de 2024 a las 20.30 h en el Centre Phénix :\nInauguración de la temporada cultural - Kristov Langagne repasa los grandes estándares de la chanson acompañado por la Harmonie Municipale de la Ville d'Outreau.\nReservas en 0321804953 - Gratuito - Departamento cultural de Outreau."
        ]
      },
