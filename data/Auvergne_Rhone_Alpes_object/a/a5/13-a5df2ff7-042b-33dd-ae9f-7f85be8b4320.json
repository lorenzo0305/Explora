  "rdfs:comment": {
    "de": [
      "Christine Boymond-Lasserre, vom Ministerium für Kultur und vom Ministerium für Tourismus zugelassene Fremdenführerin. \r\nAutorin von Büchern über das Kulturerbe und die Geschichte des Chamonix-Tals."
    ],
    "en": [
      "Christine Boymond-Lasserre, tour guide accredited by the French Ministry of Culture and the Ministry of Tourism. \r\nAuthor of books on the heritage and history of the Chamonix valley."
    ],
    "it": [
      "Christine Boymond-Lasserre, guida turistica autorizzata dal Ministero della Cultura e dal Ministero del Turismo. \r\nAutrice di libri sul patrimonio e la storia della valle di Chamonix."
    ],
    "fr": [
      "Christine Boymond-Lasserre, guide conférencière agréée par le ministère de la culture et le ministère du tourisme. \r\nAuteure de livres sur le patrimoine et l’histoire de la vallée de Chamonix."
    ],
    "es": [
      "Christine Boymond-Lasserre, guía turística homologada por el Ministerio de Cultura y el Ministerio de Turismo. \r\nAutora de libros sobre el patrimonio y la historia del valle de Chamonix."
    ],
    "nl": [
      "Christine Boymond-Lasserre is een reisleidster erkend door het Ministerie van Cultuur en het Ministerie van Toerisme.\r\nAuteur van boeken over het erfgoed en de geschiedenis van de vallei van Chamonix."
    ]
  },
