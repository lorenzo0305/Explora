  "rdfs:comment": {
    "de": [
      "Im Vorfeld Ihres Besuchs oder während der Thermalbadsaison informieren Sie unsere Aufenthaltsberaterinnen über Unterkünfte, Aktivitäten und Transportmöglichkeiten im Thermalbad, in Valmorel und in den Vallées d'Aigueblanche."
    ],
    "en": [
      "Prior to your visit or during the thermal season, our stay advisors will inform you about accommodation, activities or transport within the spa resort and Valmorel and the Vallées d'Aigueblanche."
    ],
    "it": [
      "Prima della vostra visita o durante la stagione termale, i nostri consulenti vi forniranno informazioni su alloggi, attività e trasporti all'interno delle terme, di Valmorel e delle Valli di Aigueblanche."
    ],
    "fr": [
      "En amont de votre visite ou pendant la saison thermale, nos conseillères en séjour vous informent sur les hébergements, les activités ou bien les transports au sein de la station thermale et de Valmorel et des Vallées d'Aigueblanche."
    ],
    "nl": [
      "Voorafgaand aan uw bezoek of tijdens het kuurseizoen geven onze adviseurs u informatie over accommodatie, activiteiten en vervoer binnen het kuuroord en de valleien van Valmorel en de Aigueblanche."
    ],
    "es": [
      "Antes de su visita o durante la temporada balnearia, nuestros asesores le informarán sobre el alojamiento, las actividades y el transporte dentro del balneario y de los valles de Valmorel y Aigueblanche."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Bureau d'information touristique de La Léchère-les-Bains"
    ]
  },
