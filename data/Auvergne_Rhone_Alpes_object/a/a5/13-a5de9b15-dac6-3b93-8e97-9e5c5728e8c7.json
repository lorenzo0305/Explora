  "rdfs:comment": {
    "de": [
      "Unser Restaurant empfängt Sie in einem warmen und modernen Saal mit einer einfachen Speisekarte, die je nach Jahreszeit gestaltet wird; Gerichte, die mit frischen Produkten zubereitet werden."
    ],
    "en": [
      "Classic and regional food with a contemporary flavour, cooked-to-order specialities."
    ],
    "it": [
      "Il nostro ristorante vi accoglie in una sala da pranzo calda e moderna, con un menu semplice basato sulle stagioni e piatti preparati con prodotti freschi."
    ],
    "fr": [
      "Notre restaurant vous accueille dans une salle chaleureuse et moderne avec une carte simple, conçue au fil des saisons ; des plats travaillés à base de produits frais."
    ],
    "nl": [
      "Ons restaurant verwelkomt je in een warme, moderne eetzaal, met een eenvoudig menu gebaseerd op de seizoenen en gerechten gemaakt met verse producten."
    ],
    "es": [
      "Nuestro restaurante le da la bienvenida en un comedor cálido y moderno con una carta sencilla, diseñada teniendo en cuenta las estaciones; platos basados en productos frescos."
    ]
  },
  "rdfs:label": {
