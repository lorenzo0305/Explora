  "rdfs:comment": {
    "de": [
      "Das ganze Jahr über bieten wir Ihnen verschiedene Wanderarrangements an, um unsere schöne Chartreuse, ihre Berge, Wälder und Flüsse in einer magischen Atmosphäre zu entdecken."
    ],
    "en": [
      "Throughout the year, we offer a range of walks to help you discover our beautiful Chartreuse region, its mountains, forests and rivers in a magical setting."
    ],
    "it": [
      "Durante tutto l'anno, proponiamo una serie di passeggiate per scoprire la nostra bella Chartreuse, le sue montagne, i suoi boschi e i suoi fiumi in un'atmosfera magica."
    ],
    "fr": [
      "Toute l'année nous vous proposons des formules de balades pour découvrir notre belle chartreuse, ses montagnes, ses forêts, ses rivières dans une ambiance magique."
    ],
    "nl": [
      "Het hele jaar door bieden we een scala aan wandelingen om onze prachtige Chartreuse, zijn bergen, bossen en rivieren in een magische sfeer te ontdekken."
    ],
    "es": [
      "Durante todo el año, le proponemos una serie de paseos para descubrir nuestra hermosa Chartreuse, sus montañas, bosques y ríos en un ambiente mágico."
    ]
  },
