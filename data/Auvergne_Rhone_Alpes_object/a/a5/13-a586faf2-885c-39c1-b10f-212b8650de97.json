  "rdfs:comment": {
    "de": [
      "Möchten Sie Wein im Herzen der Côte-Rôtie verkosten?\r\nEntdecken Sie Mr. Probus, um Weine aus dem nördlichen Rhône-Tal und seinen verschiedenen geschützten Appellationen zu verkosten\r\nSie haben auch die Möglichkeit, lokale Souvenirs zu kaufen."
    ],
    "en": [
      "Want to taste wine in the heart of Côte-Rôtie?\r\nDiscover Mr Probus to taste wines from the Northern Rhône Valley and its various protected appellations\r\nYou can also buy local souvenirs."
    ],
    "it": [
      "Volete degustare un vino nel cuore della Côte-Rôtie?\r\nVisitate Mr Probus per degustare i vini della Valle del Rodano settentrionale e delle sue diverse denominazioni protette\r\nÈ inoltre possibile acquistare souvenir locali."
    ],
    "fr": [
      "Vous voulez déguster du vin au cœur de la Côte-Rôtie ?\r\nDécouvrez Mr Probus pour déguster des vins de la Vallée de Rhône Nord et ses différentes appellations protégées\r\nVous aurez aussi la possibilité d'acheter des souvenirs locaux."
    ],
    "es": [
      "¿Desea degustar vinos en el corazón de la Côte-Rôtie?\r\nVisite Mr Probus para degustar vinos del Valle del Ródano Norte y sus diversas denominaciones protegidas\r\nTambién podrá comprar recuerdos locales."
    ],
    "nl": [
      "Wil je wijn proeven in het hart van Côte-Rôtie?\r\nBezoek Mr. Probus om wijnen te proeven uit de Noordelijke Rhônevallei en de verschillende beschermde appellations\r\nJe kunt er ook lokale souvenirs kopen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Mr Probus Boutique et Dégustation Oenologique"
    ]
  },
