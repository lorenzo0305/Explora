  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/1e5b4222-c66b-3edf-881b-bb7bab5ae950",
      "dc:description": {
        "de": [
          "Ob vor Ort oder zum Mitnehmen, genießen Sie einen Crêpe, eine Waffel oder ein Eis in unmittelbarer Nähe des Strandes als Snack oder ein herzhaftes Gericht aus lokalen Produkten!\nFamiliärer und herzlicher Empfang!"
        ],
        "en": [
          "Come and enjoy a crêpe, a waffle or an ice cream just a stone's throw from the beach, or a savoury dish made with local produce!\nA warm family welcome!"
        ],
        "it": [
          "Venite a gustare una crêpe, una cialda o un gelato a due passi dalla spiaggia per uno spuntino, o un piatto salato a base di prodotti locali!\nUn caloroso benvenuto in famiglia!"
        ],
        "fr": [
          "Sur place ou à emporter, venez déguster une crêpe, une gaufre ou une glace à deux pas de la plage pour le goûter ou un plat salé à base de produit locaux ! \nAccueil familial et chaleureux !"
        ],
        "es": [
          "Venga a merendar una crepe, un gofre o un helado a dos pasos de la playa, o a degustar un plato salado elaborado con productos locales\nUna cálida bienvenida familiar"
        ],
        "nl": [
          "Kom op een steenworp afstand van het strand genieten van een crêpe, een wafel of een ijsje als tussendoortje, of van een hartig gerecht op basis van lokale producten!\nEen warm onthaal met de familie!"
        ]
      },
