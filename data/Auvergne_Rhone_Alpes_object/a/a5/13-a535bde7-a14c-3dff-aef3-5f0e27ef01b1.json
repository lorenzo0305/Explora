  "rdfs:comment": {
    "de": [
      "Die sechsspurige Bowlingbahn ist ideal für die Freizeitgestaltung nach einem Seminartag oder um sich mit der Familie einige Stunden Spaß zu gönnen! Vermietung von Bowlingbahnen für Privatveranstaltungen möglich."
    ],
    "en": [
      "The 6-lane bowling alley is a great place to unwind after a day’s studying or for some fun-filled family time! Lanes available for private hire."
    ],
    "it": [
      "Rilassatevi nell'area bowling del JOA Casino. Qui le persone vengono per divertirsi dopo una giornata di seminari o per trascorrere del tempo di qualità con le loro famiglie\r\ncon la famiglia! Il luogo d'incontro ideale per tutti coloro che amano la competizione in un'atmosfera calorosa."
    ],
    "fr": [
      "Détendez-vous dans l’espace Bowling du Casino JOA. Ici, on vient pour se distraire après une journée de séminaire ou pour passer un moment convivial en\r\nfamille ! Le rendez-vous idéal pour tous ceux qui aiment la compétition dans un cadre chaleureux."
    ],
    "es": [
      "Relájate en la zona de bolos del Casino JOA. Aquí, la gente viene a divertirse después de un día de seminarios o a pasar un rato agradable con la familia\r\n¡con la familia! El lugar de encuentro ideal para todos los amantes de la competición en un ambiente cálido."
    ],
    "nl": [
      "Ontspan in de bowlingruimte van het JOA Casino. Hier komen mensen om zich te vermaken na een dag van seminars of om wat quality time met hun familie door te brengen\r\nmet de familie! De ideale ontmoetingsplaats voor iedereen die van competitie houdt in een warme sfeer."
    ]
  },
