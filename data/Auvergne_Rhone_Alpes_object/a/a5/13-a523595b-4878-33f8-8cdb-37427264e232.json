  "rdfs:comment": {
    "de": [
      "Erkunden Sie die mineralogischen Schätze des Mont-Blanc-Massivs und lernen Sie die Welt der Kristallsucher in Begleitung eines Kristallmachers vom Club de Minéralogie de Chamonix kennen.\r\nReservierung bis 12 Uhr erforderlich: +33 (0)4 50 54 78 39 oder per E-Mail"
    ],
    "en": [
      "Explore the mineralogical treasures of the Mont-Blanc massif and discover the world of crystal researchers in the company of a crystal maker from the Club de Minéralogie de Chamonix.\r\nReservations required by 12 noon: +33 (0)4 50 54 78 39 or by e-mail"
    ],
    "it": [
      "Esplorate i tesori mineralogici del massiccio del Monte Bianco e scoprite il mondo dei cercatori di cristalli in compagnia di un cristalliere del Club di Mineralogia di Chamonix.\r\nPrenotazione obbligatoria entro le ore 12.00: +33 (0)4 50 54 78 39 o via e-mail"
    ],
    "fr": [
      "Explorez les trésors minéralogiques du massif du Mont-Blanc et découvrez le monde des chercheurs de cristaux en compagnie d’un cristallier du Club de Minéralogie de Chamonix.\r\nRéservation obligatoire jusqu'à 12h  : +33 (0)4 50 54 78 39 ou par mail"
    ],
    "nl": [
      "Ontdek de mineralogische schatten van het Mont Blanc-massief en ontdek de wereld van kristalonderzoekers in gezelschap van een kristalmaker van de Mineralogieclub van Chamonix.\r\nReserveren verplicht vóór 12 uur: +33 (0)4 50 54 78 39 of per e-mail"
    ],
    "es": [
      "Explore los tesoros mineralógicos del macizo del Mont Blanc y descubra el mundo de los buscadores de cristales en compañía de un cristalero del Club de Mineralogía de Chamonix.\r\nReserva obligatoria antes de las 12.00 h: +33 (0)4 50 54 78 39 o por correo electrónico"
    ]
  },
  "rdfs:label": {
    "de": [
      "Führung in Begleitung eines Kristallmachers"
    ],
    "en": [
      "Guided tour with a crystal-maker"
    ],
    "it": [
      "Visita guidata con un cristalliere"
    ],
    "fr": [
      "Visite guidée en compagnie d'un cristallier"
    ],
