  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Aromen des Orients und Asiens!\r\nVor Ort oder zum Mitnehmen: Traditionelle Spezialitäten, die mit frischen Zutaten zubereitet werden. Couscous, Tajines und andere hausgemachte Gerichte werden die Liebhaber würziger Rezepte begeistern.\r\nAuch Catering-Service"
    ],
    "en": [
      "Discover the flavors of the Orient and Asia!\r\nOn the spot or to take away, traditional specialties prepared with fresh ingredients. Couscous, tajines and other homemade dishes will delight fans of spicy recipes.\r\nCatering service also available"
    ],
    "it": [
      "Scoprite i sapori dell'Oriente e dell'Asia!\r\nSul posto o da asporto, specialità tradizionali preparate con ingredienti freschi. Couscous, tajine e altri piatti fatti in casa delizieranno gli appassionati di ricette piccanti.\r\nDisponibile anche il servizio di catering"
    ],
    "fr": [
      "Découvrez les saveurs d’Orient et d’Asie !\r\nSur place ou à emporter,  spécialités traditionnelles préparées avec des ingrédients frais. Couscous, tajines et autres plats faits maison raviront les amateurs de recettes épicées.\r\nService traiteur également"
    ],
    "nl": [
      "Ontdek de smaken van het Oosten en Azië!\r\nTer plekke of om mee te nemen, traditionele specialiteiten bereid met verse ingrediënten. Couscous, tajines en andere huisgemaakte gerechten zullen liefhebbers van pittige recepten verrukken.\r\nCatering service ook beschikbaar"
    ],
    "es": [
      "Descubra los sabores de Oriente y Asia\r\nEn el momento o para llevar, especialidades tradicionales preparadas con ingredientes frescos. Cuscús, tajines y otros platos caseros harán las delicias de los amantes de las recetas picantes.\r\nServicio de catering también disponible"
    ]
  },
