  "rdfs:comment": {
    "de": [
      "Regionaler Lebensmittelladen, Teesalon und kleine Sommerrestaurants. Eine schöne Auswahl an lokalen Produkten, Bieren und Eis zum Genießen vor Ort oder zum Mitnehmen, zwischen Haute-Loire und Ardèche, auf einer schattigen Terrasse im Herzen des Plateaus von Mézenc."
    ],
    "en": [
      "Local grocery, tea room and summer snack bar. A fine selection of local products, beers and ice creams to enjoy on site or to take away, between Haute-Loire and Ardèche, on a shady terrace in the heart of the Mézenc plateau."
    ],
    "it": [
      "Drogheria locale, sala da tè e snack bar estivo. Una raffinata selezione di prodotti locali, birre e gelati da gustare in loco o da asporto, tra l'Alta Loira e l'Ardèche, su una terrazza ombreggiata nel cuore dell'altopiano del Mézenc."
    ],
    "fr": [
      "Épicerie de terroir, salon de thé et petite restauration estivale. Une belle sélection de produits locaux, bières et glaces à savourer sur place ou à emporter, entre Haute-Loire et Ardèche, sur une terrasse ombragée au cœur du plateau du Mézenc."
    ],
    "es": [
      "Tienda de comestibles, salón de té y cafetería de verano. Una buena selección de productos locales, cervezas y helados para degustar en el establecimiento o para llevar, entre el Alto Loira y Ardèche, en una terraza a la sombra en el corazón de la meseta de Mézenc."
    ],
    "nl": [
      "Kruidenierswinkel, tearoom en zomersnackbar. Een ruime keuze aan streekproducten, bieren en ijs om ter plekke van te genieten of om mee te nemen, tussen de Haute-Loire en de Ardèche, op een schaduwrijk terras in het hart van het Mézenc-plateau."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Délices du Mézenc"
    ]
  },
