  "rdfs:comment": {
    "de": [
      "Die Gemeindebibliothek der Gemeinde Auris en Oisans öffnet ihre Türen und stellt allen Leseliebhabern ihre literarischen Schätze zur Verfügung."
    ],
    "en": [
      "Read, consult, borrow... The Auris en Oisans municipal library opens its doors and makes its literary treasures available to all book lovers."
    ],
    "it": [
      "La biblioteca comunale di Auris en Oisans apre le sue porte e mette i suoi tesori letterari a disposizione di tutti gli amanti dei libri."
    ],
    "fr": [
      "La bibliothèque municipale de la commune d'Auris en Oisans ouvre ses portes et met à disposition ses trésors littéraires, à tous les amoureux de lecture."
    ],
    "nl": [
      "Lezen, raadplegen, lenen... De gemeentelijke bibliotheek van Auris en Oisans opent haar deuren en stelt haar literaire schatten ter beschikking van alle boekenliefhebbers."
    ],
    "es": [
      "La biblioteca municipal de Auris en Oisans abre sus puertas y pone sus tesoros literarios a disposición de todos los amantes de los libros."
    ]
  },
