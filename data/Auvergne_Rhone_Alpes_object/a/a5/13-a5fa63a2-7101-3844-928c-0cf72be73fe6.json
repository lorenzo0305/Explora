  "rdfs:comment": {
    "de": [
      "Biologische Polykultur und Viehzucht: Anbau von Gemüse und Obst sowie Aufzucht von Kühen, Schweinen, Hühnern und Hähnchen.\r\nVerkauf von frischen und verarbeiteten Produkten (Gemüse, Obst, ?ier, Fleisch und Wurstwaren...) im Laden \"Aux Sources\" in Saint-Sauveur-de-Montagut."
    ],
    "en": [
      "Organic mixed farming: vegetables and fruit, and cows, pigs, hens and chickens.\r\nSales of fresh and processed produce (vegetables, fruit, eggs, meat and charcuterie...) at the \"Aux Sources\" store in Saint-Sauveur-de-Montagut."
    ],
    "it": [
      "Agricoltura e allevamento misti biologici: coltivazione di ortaggi e frutta, allevamento di mucche, maiali, galline e polli.\r\nProdotti freschi e trasformati (verdura, frutta, uova, carne e salumi, ecc.) venduti nel negozio \"Aux Sources\" di Saint-Sauveur-de-Montagut."
    ],
    "fr": [
      "Polyculture-élevage biologique : culture de légumes et fruits, et élevage de vaches, cochons, poules et poulets.\r\nVente de produits frais et transformés (légumes, fruits, œufs, viande et charcuterie...) au magasin \"Aux Sources\" à Saint-Sauveur-de-Montagut."
    ],
    "nl": [
      "Gemengde biologische landbouw en veeteelt: verbouwen van groenten en fruit en houden van koeien, varkens, kippen en kuikens.\r\nVerse en verwerkte producten (groenten, fruit, eieren, vlees en vleeswaren, enz.) worden verkocht in de winkel \"Aux Sources\" in Saint-Sauveur-de-Montagut."
    ],
    "es": [
      "Agricultura y ganadería ecológica mixta: cultivo de hortalizas y frutas, y cría de vacas, cerdos, gallinas y pollos.\r\nVenta de productos frescos y transformados (verduras, frutas, huevos, carne y charcutería, etc.) en la tienda \"Aux Sources\" de Saint-Sauveur-de-Montagut."
    ]
  },
