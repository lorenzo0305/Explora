  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/00a38426-e731-3a9b-8410-9c13091ca4d7",
      "dc:description": {
        "de": [
          "10.00 Uhr Eintreffen des Publikums\n10.15 Uhr Vortrag und Workshop zur Entdeckung der Entspannung durch Meditation mit tibetischen Klangschalen oder Kristallklangschalen durch den Verein Chosen Light\n11.00 Uhr Tanzvorführung der Tanzschule von Courrières\n11.30 Uhr Vorführung von Aerobic-Gymnastik durch den Verein Ascamap\n12.00 Uhr Karaoke durch den Verein Accords Mineurs\n13.30 Uhr Musikalische Unterhaltung durch die N?Euro Jazz Band\n14.00 Uhr Musikalische Unterhaltung durch die Harmonie Union fait La Force\n14.45 Uhr Musikalische Unterhaltung durch die Harmonie Hilariter\n15.30 Uhr Tanzvorführung der Tanzschule von Courrières\n16.00 Uhr Karaoke durch den Verein Accords Mineurs"
        ],
        "en": [
          "10:00 am Arrival of the public\n10:15 am Lecture and workshop on relaxation through meditation with Tibetan bowls and/or crystal bowls by the Chosen Light association\n11:00 Dance demonstration by the Courrières dance school\n11:30 Aerobics demonstration by the Ascamap association\n12:00 Karaoke by the Accords Mineurs association\n1:30 pm Musical entertainment by the N?Euro Jazz Band\n2:00 pm Musical entertainment by Harmonie Union fait La Force\n2:45 pm Musical entertainment by Harmonie Hilariter\n3:30 pm Dance demonstration by the Courrières dance school\n4:00 pm Karaoke by the Accords Mineurs association"
        ],
        "it": [
          "10.00 Arrivo del pubblico\n10.15 Conferenza e laboratorio sul rilassamento attraverso la meditazione con le ciotole tibetane e/o le ciotole di cristallo a cura dell'associazione Luce Scelta\n11.00 Dimostrazione di danza a cura della scuola di danza di Courrières\n11.30 Dimostrazione di aerobica a cura dell'associazione Ascamap\n12.00 Karaoke a cura dell'associazione Accords Mineurs\n13.30 Intrattenimento musicale a cura della N?Euro Jazz Band\n14:00 Intrattenimento musicale a cura dell'Harmonie Union fait La Force\n14:45 Intrattenimento musicale a cura dell'Harmonie Hilariter\n15:30 Dimostrazione di danza a cura della scuola di ballo di Courrières\n16:00 Karaoke a cura dell'associazione Accords Mineurs"
        ],
        "fr": [
          "10h00          Arrivée du public\n10h15          Conférence et atelier découverte de la relaxation grâce à la méditation aux bols tibétains et ou aux bols de cristal par l’association Chosen Light\n11h00          Démonstration de danse par l’école de danse de Courrières\n11h30          Démonstration de gym aérobic par l’association Ascamap\n12H00         Karaoké par l’association Accords Mineurs\n13h30          animation musicale par le N’Euro Jazz Band\n14h00          animation musicale par l’Harmonie Union fait La Force\n14h45          animation musicale par l’Harmonie Hilariter\n15h30          Démonstration de danse par l’école de danse de Courrières\n16h00          Karaoké par l’association Accords Mineurs"
        ],
        "nl": [
          "10.00 uur Aankomst van het publiek\n10.15 uur Lezing en workshop over ontspanning door meditatie met Tibetaanse schalen en/of kristallen schalen door de vereniging Chosen Light\n11.00 uur Dansdemonstratie door de dansschool van Courrières\n11.30 uur Aerobicsdemonstratie door de vereniging Ascamap\n12.00 Karaoke door de vereniging Accords Mineurs\n13:30 Muzikale animatie door de N?Euro Jazz Band\n14:00 Muzikale animatie door de Harmonie Union fait La Force\n14:45 Muzikale animatie door de Harmonie Hilariter\n15:30 Dansdemonstratie door de dansschool van Courrières\n16:00 Karaoke door de vereniging Accords Mineurs"
        ],
        "es": [
          "10.00 Llegada del público\n10.15 h Conferencia y taller sobre la relajación a través de la meditación con cuencos tibetanos y/o cuencos de cristal a cargo de la asociación Luz Elegida\n11.00 Demostración de danza a cargo de la escuela de danza Courrières\n11.30 Demostración de aeróbic a cargo de la asociación Ascamap\n12.00 Karaoke a cargo de la asociación Accords Mineurs\n13:30 Animación musical a cargo de la N?Euro Jazz Band\n14:00 Animación musical a cargo de la Harmonie Union fait La Force\n14:45 Animación musical a cargo de la Harmonie Hilariter\n15:30 Demostración de baile a cargo de la escuela de baile Courrières\n16:00 Karaoke a cargo de la asociación Accords Mineurs"
        ]
      },
