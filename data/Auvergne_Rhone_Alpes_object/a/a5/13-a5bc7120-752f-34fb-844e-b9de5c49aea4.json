  "rdfs:comment": {
    "de": [
      "Das LEMAND HOTEL Villefontaine ist ideal gelegen, 700 m von der A43 von Lyon nach Chambéry/Grenoble, 20 km vom Messegelände EUREXPO, 25 km vom Stadtzentrum von Lyon und nur 13 km vom Flughafen Lyon?Saint Exupéry entfernt."
    ],
    "en": [
      "LEMAND HOTEL Villefontaine is ideally located 700 m from the A43 from Lyon to Chambéry/Grenoble, 20 km from the EUREXPO Exhibition Centre, 25 km from the city centre of Lyon and only 13 km from Lyon Saint Exupéry Airport."
    ],
    "it": [
      "Il LEMAND HOTEL Villefontaine è situato in posizione ideale a 700 m dall'autostrada A43 che collega Lione a Chambéry/Grenoble, a 20 km dal centro espositivo EUREXPO, a 25 km dal centro di Lione e a soli 13 km dall'aeroporto di Lione-Saint Exupéry."
    ],
    "fr": [
      "LEMAND HOTEL Villefontaine est idéalement situé à 700 m de l’A43 de Lyon à Chambéry/Grenoble, 20 km du Parc des expositions EUREXPO, à 25 km du centre ville de Lyon et à seulement 13 km de l’Aéroport Lyon‐Saint Exupéry."
    ],
    "nl": [
      "LEMAND HOTEL Villefontaine is ideaal gelegen op 700 m van de snelweg A43 van Lyon naar Chambéry/Grenoble, op 20 km van het expositiecentrum EUREXPO, op 25 km van het centrum van Lyon en op slechts 13 km van de luchthaven Lyon-Saint Exupéry."
    ],
    "es": [
      "LEMAND HOTEL Villefontaine goza de una ubicación ideal a 700 m de la autopista A43 de Lyon a Chambéry/Grenoble, a 20 km del centro de exposiciones EUREXPO, a 25 km del centro de Lyon y a sólo 13 km del aeropuerto Lyon-Saint Exupéry."
    ]
  },
