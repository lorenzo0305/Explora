  "rdfs:comment": {
    "de": [
      "Petanque-Plätze in Avoriaz. Nutzen Sie die frei zugänglichen Bouleplätze im Herzen des Ortes. Ideal für einen geselligen Moment mit Freunden oder der Familie in einer einzigartigen Umgebung in den Bergen."
    ],
    "en": [
      "Pétanque Courts in Avoriaz. Enjoy free-access pétanque courts in the heart of the resort. Perfect for a friendly game with family or friends, in a unique mountain setting."
    ],
    "it": [
      "Campi da bocce ad Avoriaz. Godetevi l'accesso gratuito ai campi da petanque nel cuore della località. Ideale per un incontro amichevole con gli amici o la famiglia in un ambiente di montagna unico."
    ],
    "fr": [
      "Terrains de pétanque à Avoriaz. Profitez de terrains de pétanque en libre accès au cœur de la station. Idéal pour un moment convivial entre amis ou en famille, dans un cadre unique en montagne."
    ],
    "es": [
      "Pistas de petanca en Avoriaz. Disfrute del acceso gratuito a las pistas de petanca en el corazón de la estación. Ideal para una reunión amistosa con amigos o familiares en un entorno de montaña único."
    ],
    "nl": [
      "Pétanquebanen in Avoriaz. Geniet van vrij toegankelijke pétanquebanen in het hart van het resort. Ideaal voor een gezellig moment met vrienden of familie, in een unieke bergomgeving."
    ]
  },
  "rdfs:label": {
