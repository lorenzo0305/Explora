  "rdfs:comment": {
    "de": [
      "Die dem Heiligen Martin gewidmete romanische Kirche dominiert den neu gestalteten Platz des Marktfleckens Collandres. Der Chor ist in das Verzeichnis der historischen Monumente eingetragen. In der Nähe der Kirche bietet sich den Besuchern ein herrlicher Ausblick auf die Monts Dore."
    ],
    "en": [
      "The Romanesque church dedicated to Saint-Martin dominates the recently laid-out square in the village of Collandres. The choir is listed as a Monument Historique. A magnificent view of the Monts Dore mountains awaits visitors near the church."
    ],
    "it": [
      "La chiesa romanica dedicata a Saint-Martin domina la piazza del villaggio di Collandres, recentemente sistemata. Il coro è classificato come monumento storico. Nei pressi della chiesa si può godere di una magnifica vista sui Monts Dore."
    ],
    "fr": [
      "L'église romane dédiée à Saint-Martin domine la place récemment aménagée du bourg de Collandres. Le choeur est inscrit à l'inventaire des Monuments Historiques. Un magnifique point de vue sur les Monts Dore s'offre aux visiteurs à proximité de l'église."
    ],
    "es": [
      "La iglesia románica dedicada a Saint-Martin domina la plaza recientemente acondicionada del pueblo de Collandres. El coro está catalogado como Monumento Histórico. Los visitantes pueden disfrutar de una magnífica vista de los Montes Dore cerca de la iglesia."
    ],
    "nl": [
      "De Romaanse kerk gewijd aan Saint-Martin domineert het onlangs aangelegde plein in het dorp Collandres. Het koor staat op de monumentenlijst. Bezoekers kunnen in de buurt van de kerk genieten van een prachtig uitzicht op de Monts Dore."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Eglise Saint-Martin"
    ]
  },
