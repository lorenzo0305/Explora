  "rdfs:comment": {
    "de": [
      "Die Immersion Rugby! Es gibt zwei Möglichkeiten, Ihr Wissen über Rugby zu vertiefen: den ASM Experience-Bereich, einen in Frankreich einzigartigen \"Themenpark\", der ausschließlich dem Rugby gewidmet ist, und eine Führung durch das Stadion. Also... rein ins Getümmel!"
    ],
    "en": [
      "A rugby immersion! There are two ways to expand your rugby knowledge: the ASM experience, a one-of-a-kind in France theme park dedicated to rugby, or a guided tour of the stadium. Push yourself into the scrum!"
    ],
    "it": [
      "Immersione nel rugby! Ci sono due modi per approfondire la conoscenza del rugby: l'area ASM Experience, un \"parco a tema\" unico in Francia dedicato esclusivamente al rugby, e la visita guidata dello stadio. Quindi... sotto la mischia!"
    ],
    "fr": [
      "L'immersion rugby ! Deux façons d'approfondir votre connaissance du rugby : l’espace ASM Experience, un \"parc à thème\" unique en France dédié exclusivement au rugby, et la visite guidée du stade. Alors... entrez sous la mêlée !"
    ],
    "es": [
      "¡Inmersión en el rugby! Hay dos maneras de profundizar en el conocimiento del rugby: el espacio ASM Experience, un \"parque temático\" único en Francia dedicado exclusivamente al rugby, y la visita guiada al estadio. Así que... ¡ponte debajo del scrum!"
    ],
    "nl": [
      "Duik in de wereld van de rugbysport ! Je hebt twee opties : de ASM Experience, een in Frankrijk uniek thema’-park’ dat volledig is gewijd aan rugby, en een rondleiding door het rugbystadion. Aan jou de keus – of doe ze allebei !"
    ]
  },
