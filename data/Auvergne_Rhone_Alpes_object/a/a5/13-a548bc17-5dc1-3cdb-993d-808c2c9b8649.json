  "rdfs:comment": {
    "de": [
      "Entdecken Sie , goldene und duftende Honige, die aus Bergblumen entstanden sind. Authentische Aromen, die Sie mit dem Löffel genießen können. Verkauf ab Hof am späten Nachmittag, auf dem Markt in La Chapelle-en-Vercors am Donnerstagmorgen und in Villard-de-Lans am Sonntagmorgen"
    ],
    "en": [
      "Discover golden, fragrant honeys from mountain flowers. Authentic flavors to enjoy with a spoon. Sales at the farm in the late afternoon, at the La Chapelle-en-Vercors market on Thursday mornings, and at Villard-de-Lans on Sunday mornings"
    ],
    "it": [
      "Scoprite i mieli dorati e profumati dei fiori di montagna. Sapori autentici da gustare al cucchiaio. Vendita in fattoria nel tardo pomeriggio, al mercato di La Chapelle-en-Vercors il giovedì mattina e a Villard-de-Lans la domenica mattina"
    ],
    "fr": [
      "Découvrez , des miels dorés et parfumés, nés des fleurs de montagne. Des saveurs authentiques à déguster à la cuillère. Vente à la ferme en fin d’après-midi, au marché de La Chapelle-en-Vercors le jeudi matin et à Villard-de-Lans le dimanche matin"
    ],
    "nl": [
      "Ontdek de gouden, geurige honing van bergbloemen. Authentieke smaken om van te genieten met een lepel. Verkoop op de boerderij in de late namiddag, op de markt van La Chapelle-en-Vercors op donderdagochtend en in Villard-de-Lans op zondagochtend"
    ],
    "es": [
      "Descubra las mieles doradas y perfumadas de las flores de montaña. Sabores auténticos para degustar con cuchara. Venta en la granja a última hora de la tarde, en el mercado de La Chapelle-en-Vercors los jueves por la mañana y en Villard-de-Lans los domingos por la mañana"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Miellerie Vertaco"
    ]
  },
