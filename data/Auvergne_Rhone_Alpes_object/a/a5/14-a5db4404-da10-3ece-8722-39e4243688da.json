      "@id": "https://data.datatourisme.fr/9c3df56c-ac67-3562-ae89-e397d4a8eb90",
      "dc:description": {
        "de": [
          "Autowerkstatt FIAT und alle anderen Marken, Reparaturen, Pannenhilfe, Spezialist für Wohnmobile\n\nGeöffnet von Montag bis Freitag von 8.30 bis 12 Uhr und von 14 bis 18 Uhr und am Samstagmorgen von 9 bis 12 Uhr"
        ],
        "en": [
          "Car garage FIAT and all other makes, repairs, breakdown service, motorhome specialist\n\nOpen Monday to Friday, 8.30am to 12pm and 2pm to 6pm and Saturday morning, 9am to 12pm"
        ],
        "it": [
          "Autofficina FIAT e di tutte le altre marche, riparazioni, soccorso stradale, specialista di camper\n\nAperto dal lunedì al venerdì dalle 8.30 alle 12.00 e dalle 14.00 alle 18.00 e il sabato mattina dalle 9.00 alle 12.00"
        ],
        "fr": [
          "Garage automobile FIAT et toutes autres marques, réparations, dépannage, spécialiste Camping-Car\n\nOuvert du lundi au vendredi de 8h30 à 12h et de 14h à 18h et le samedi matin de 9h à 12h"
        ],
        "es": [
          "Taller de coches FIAT y todas las demás marcas, reparaciones, reparación de averías, especialista en autocaravanas\n\nAbierto de lunes a viernes de 8h30 a 12h y de 14h a 18h y sábados por la mañana de 9h a 12h"
        ],
        "nl": [
          "FIAT autogarage en alle andere merken, reparaties, pechhulp, camper specialist\n\nOpen van maandag tot vrijdag van 8u30 tot 12u en van 14u tot 18u en zaterdagochtend van 9u tot 12u"
        ]
      },
