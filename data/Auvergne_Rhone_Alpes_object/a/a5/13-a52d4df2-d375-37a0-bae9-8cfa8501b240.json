  "rdfs:comment": {
    "de": [
      "Seen und Gipfel, Familienausflüge, Kulturerbe, Flora, Fauna und Mineralien, Wochen und organisierte Wochenenden...  Mathieu, Bergbegleiter und Mountainbike-Lehrer, führt Sie auf Entdeckungsreise durch eine reiche und geheime, majestätische und großartige Bergwelt!"
    ],
    "en": [
      "Lakes and summits, family outings, heritage, flora, fauna and minerals, organized weeks and weekends... Mathieu, mountain guide, will guide you to discover a rich and secret mountain, majestic and grandiose!"
    ],
    "it": [
      "Laghi e vette, gite in famiglia, patrimonio, flora, fauna e minerali, settimane e weekend organizzati...  Mathieu, guida alpina e istruttore di mountain bike, vi guiderà alla scoperta di una montagna ricca e segreta, maestosa e grandiosa!"
    ],
    "fr": [
      "Lacs et sommets, sorties en famille, patrimoine, flore, faune et minéraux, semaines et week-ends organisés...  Mathieu, accompagnateur en montagne et moniteur VTT, vous guidera à la découverte d'une montagne riche et secrète, majestueuse et grandiose !"
    ],
    "nl": [
      "Meren en pieken, gezinsuitstapjes, erfgoed, flora, fauna en mineralen, georganiseerde weken en weekends...  Mathieu, bergleider en mountainbike-instructeur, zal je begeleiden op je ontdekkingstocht van een rijke en geheime berg, majestueus en grandioos!"
    ],
    "es": [
      "Lagos y cumbres, excursiones en familia, patrimonio, flora, fauna y minerales, semanas y fines de semana organizados...  Mathieu, monitor de montaña y monitor de BTT, le guiará en su descubrimiento de una montaña rica y secreta, ¡majestuosa y grandiosa!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Accompagnateur en montagne-Moniteur VTT, Mathieu TABOURY"
    ]
  },
