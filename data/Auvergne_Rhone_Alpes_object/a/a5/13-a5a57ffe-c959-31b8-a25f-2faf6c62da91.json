  "rdfs:comment": {
    "de": [
      "Die Auberge la Sapinière empfängt Sie in einem rustikalen Rahmen und bietet Ihnen eine traditionelle regionale Küche, die aus hochwertigen und hausgemachten Produkten zubereitet wird."
    ],
    "en": [
      "The Auberge la Sapinière welcomes you in a rustic setting and offers traditional local cuisine, prepared with quality home-made products."
    ],
    "it": [
      "L'Auberge la Sapinière vi accoglie in un ambiente rustico e offre una cucina tradizionale locale, realizzata con prodotti di qualità fatti in casa."
    ],
    "fr": [
      "L'Auberge la Sapinière vous accueille dans un cadre rustique et vous propose une cuisine traditionnelle du terroir, élaborée à base de produits de qualité et fait maison."
    ],
    "es": [
      "El Auberge la Sapinière le acoge en un entorno rústico y le ofrece una cocina tradicional local, elaborada con productos caseros de calidad."
    ],
    "nl": [
      "De Auberge la Sapinière ontvangt u in een rustieke omgeving en biedt een traditionele lokale keuken, bereid met zelfgemaakte kwaliteitsproducten."
    ]
  },
