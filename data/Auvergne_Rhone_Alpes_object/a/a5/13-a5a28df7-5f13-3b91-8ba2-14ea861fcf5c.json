  "rdfs:comment": {
    "de": [
      "DE Bergbegleiter und Mountainbike-Lehrer, der dem Moniteur Cycliste Français angeschlossen ist. Sylvain passt sich allen Zielgruppen für thematische Ausflüge an: Wandern, Schneeschuhwandern, Spuren und Indizien, Fauna und Flora, Überlebenstraining, Orientierung, ... in allen Jahreszeiten."
    ],
    "en": [
      "From mountain guide and mountain bike instructor affiliated with the French Cycling Instructor, Sylvain adapts to all audiences for thematic outings: hiking, snowshoeing, traces and clues, fauna and flora, survival course, orientation, ... in all seasons."
    ],
    "it": [
      "Guida alpina qualificata e istruttore di mountain bike affiliato al Moniteur Cycliste Français, Sylvain si adatta a tutti i tipi di pubblico per le uscite a tema: escursioni, ciaspolate, tracce e indizi, fauna e flora, corsi di sopravvivenza, orienteering, ecc. in tutte le stagioni."
    ],
    "fr": [
      "DE accompagnateur en montagne et moniteur VTT affilié au Moniteur Cycliste Français, Sylvain s'adapte à tous publics pour des sorties thématiques : rando, raquettes, traces et indices, faune et flore, stage de survie, orientation, ... en toutes saisons."
    ],
    "es": [
      "Monitor de montaña titulado y monitor de bicicleta de montaña afiliado al Moniteur Cycliste Français, Sylvain se adapta a todo tipo de público para salidas temáticas: senderismo, raquetas de nieve, pistas y pistas, fauna y flora, cursos de supervivencia, orientación, etc. en todas las estaciones."
    ],
    "nl": [
      "Als gediplomeerd bergleider en mountainbike-instructeur, aangesloten bij het Moniteur Cycliste Français, past Sylvain zich aan alle soorten publiek aan voor thematische uitstapjes: wandelen, sneeuwschoenwandelen, sporen en aanwijzingen, fauna en flora, survivalparcours, oriëntatieloop, enz. in alle seizoenen."
    ]
  },
