  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/98d4b9b9-77d7-3b8e-ad56-4cb113fc783a",
      "dc:description": {
        "de": [
          "Reitschule, die von Jugend und Sport anerkannt und mit dem EFE-Label ausgezeichnet ist.\nAnfänger (Reiten, Voltigieren), Fortgeschrittene, Praktika, Ausflüge, Rallyes, Ponyspiele, Horse-Ball"
        ],
        "en": [
          "Youth and sports-approved riding school with EFE label.\nInitiation (equestrian, acrobatics), advanced training, courses, rides, rallies, pony games, horse-ball.."
        ],
        "it": [
          "Scuola di equitazione per giovani e sportivi con marchio EFE.\nIniziazione (equestre, acrobatica), formazione avanzata, corsi, passeggiate, raduni, pony game, horse-ball, ecc"
        ],
        "fr": [
          "Ecole d'équitation agréée jeunesse et sports, labelisée EFE.\nInitiation (équestre, voltige), perfectionnement, stages, balades, rallyes, poney games, horse-ball"
        ],
        "es": [
          "Escuela de equitación juvenil y deportiva homologada con la etiqueta EFE.\nIniciación (hípica, acrobacia), perfeccionamiento, cursos, paseos, concentraciones, juegos con ponis, horse-ball, etc"
        ],
        "nl": [
          "Door jeugd en sport erkende manege met EFE-label.\nInitiatie (paardrijden, acrobatiek), gevorderde opleidingen, cursussen, ritten, rally's, ponyspelen, horse-ball, enz"
        ]
      },
