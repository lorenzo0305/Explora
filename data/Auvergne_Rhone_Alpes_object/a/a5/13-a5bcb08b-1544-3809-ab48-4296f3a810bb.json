  "rdfs:comment": {
    "de": [
      "Ein gemütliches Familienhotel und -restaurant, in dem vier Generationen von Hoteliers mit derselben Leidenschaft für Gastfreundschaft aufeinander folgten.\r\nE&M Schaeffer übernahmen 1925 das Hotel Ravon, 2018 setzte F.Guironnet das Abenteuer fort und führte die Familientradition fort."
    ],
    "en": [
      "Welcoming hotel with restaurant near the Rhône river. Bike-friendly approval."
    ],
    "it": [
      "Un caldo hotel-ristorante a conduzione familiare dove quattro generazioni di albergatori si sono succedute con la stessa passione per l'ospitalità.\r\nE&M Schaeffer ha rilevato l'Hotel Ravon nel 1925, e nel 2018 F.Guironnet ha continuato l'avventura e mantenuto viva la tradizione familiare."
    ],
    "fr": [
      "Un hôtel-restaurant familial et chaleureux où quatre générations d’hôteliers se sont succédées avec la même passion de l’accueil.\r\nE&M Schaeffer reprennnet l'hotel Ravon en 1925, 2018 F.Guironnet poursuit l'aventure et fait perdurer la tradition familiale."
    ],
    "es": [
      "Un cálido hotel-restaurante familiar donde se han sucedido cuatro generaciones de hosteleros con la misma pasión por la hospitalidad.\r\nE&M Schaeffer se hizo cargo del Hotel Ravon en 1925, y en 2018 F.Guironnet continuó la aventura y mantuvo viva la tradición familiar."
    ],
    "nl": [
      "Een warm familiehotel-restaurant waar vier generaties hoteliers elkaar hebben opgevolgd met dezelfde passie voor gastvrijheid.\r\nE&M Schaeffer nam Hotel Ravon over in 1925 en in 2018 zette F.Guironnet het avontuur voort en hield de familietraditie in ere."
    ]
  },
  "rdfs:label": {
    "en": [
