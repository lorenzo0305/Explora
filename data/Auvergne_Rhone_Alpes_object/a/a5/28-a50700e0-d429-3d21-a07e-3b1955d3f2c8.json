  "rdfs:comment": {
    "de": [
      "Das Hotel-Restaurant befindet sich in Roye im Zentrum der Stadt. Danielle und Denis Devaux pflegen eine besondere Lebenskunst. Ihr Restaurant bietet eine traditionelle und gastronomische Küche, die vom Chefkoch Denis Devaux mit frischen und saisonalen Produkten zubereitet wird."
    ],
    "en": [
      "Hotel-restaurant located in Roye in the center of the city, Danielle and Denis Devaux cultivate an art of living. Their restaurant offers a traditional and gastronomic cuisine prepared by the chef Denis Devaux with fresh and seasonal products."
    ],
    "it": [
      "Hotel-ristorante situato a Roye, nel centro della città, Danielle e Denis Devaux coltivano un'arte di vivere. Il ristorante offre una cucina tradizionale e gastronomica preparata dallo chef Denis Devaux con prodotti freschi e di stagione."
    ],
    "fr": [
      "Hôtel-restaurant situé à Roye en plein centre de la ville, Danielle et Denis Devaux cultivent un art de vivre. Son restaurant offre une cuisine traditionnelle et gastronomique préparée par  le chef Denis Devaux avec des produits frais et de saison."
    ],
    "es": [
      "Hotel-restaurante situado en Roye, en el centro de la ciudad, Danielle y Denis Devaux cultivan un arte de vivir. Su restaurante ofrece una cocina tradicional y gastronómica elaborada por el chef Denis Devaux con productos frescos y de temporada."
    ],
    "nl": [
      "Hotel-restaurant gelegen in Roye in het centrum van de stad, Danielle en Denis Devaux cultiveren een levenskunst. Hun restaurant biedt een traditionele en gastronomische keuken bereid door chef-kok Denis Devaux met verse en seizoensgebonden producten."
    ]
  },
