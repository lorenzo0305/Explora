  "rdfs:comment": {
    "de": [
      "Eingebettet im Herzen der Bocage Bourbonnais in der Gemeinde Couzon bauen wir gemeinsam Gemüse und Heilpflanzen an."
    ],
    "en": [
      "Nestling in the heart of the Bourbonnais bocage in the commune of Couzon, we grow vegetables and medicinal plants together."
    ],
    "it": [
      "Nel cuore del bocage del Bourbonnais, nel comune di Couzon, coltiviamo insieme ortaggi e piante medicinali."
    ],
    "fr": [
      "Nichée au cœur du bocage bourbonnais sur la commune de Couzon, nous cultivons ensemble des légumes et des plantes médicinales."
    ],
    "nl": [
      "Genesteld in het hart van de Bourbonnais bocage in de gemeente Couzon, kweken we samen groenten en medicinale planten."
    ],
    "es": [
      "Enclavados en el corazón del bocage de Bourbonnais, en el municipio de Couzon, cultivamos juntos hortalizas y plantas medicinales."
    ]
