  "rdfs:comment": {
    "de": [
      "Entdecken Sie unsere Pizzen und Spezialitäten, vom Frühstück bis zum Abendessen, vor Ort oder zum Mitnehmen!\r\nDenken Sie an eine Reservierung."
    ],
    "en": [
      "Come and taste the pizzas and food specialities, from breakfast to dinner, eat-in or take-out !\r\nBooking is advised."
    ],
    "it": [
      "Venite a scoprire le pizze e le specialità, dalla colazione alla cena, sul posto o da asporto!\r\nNon dimenticate di prenotare."
    ],
    "fr": [
      "Venez découvrir les pizzas et spécialités, du petit-déjeuner au dîner, sur place ou à emporter !\r\nPensez à réserver."
    ],
    "es": [
      "Venga a descubrir nuestras pizzas y especialidades, desde el desayuno hasta la cena, para comer en casa o para llevar.\r\nNo olvide reservar."
    ],
    "nl": [
      "Kom en ontdek de pizza's en specialiteiten, van ontbijt tot diner, ter plaatse of om mee te nemen!\r\nVergeet niet te reserveren."
    ]
  },
