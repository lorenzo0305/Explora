  "rdfs:comment": {
    "de": [
      "AFNOR-zertifizierter Verein für häusliche Dienste, Dienstleistungen für Menschen: Hilfe, Pflege, Begleitung in einem einzigen Dienst vereint, dem Service Polyvalent d'Aide et de Soins A Domicile (SPASAD). Ein einziger Schalter, ein einziger Ort für alle Ihre Bedürfnisse."
    ],
    "en": [
      "AFNOR-certified home services association, personal services: Help, Care, Accompaniment combined in a single service, the Service Polyvalent d'Aide et de Soins A Domicile (SPASAD). A single point of contact for all your needs."
    ],
    "it": [
      "Associazione di servizi a domicilio certificata AFNOR, servizi alla persona: aiuto, assistenza, accompagnamento combinati in un unico servizio, il Servizio di assistenza e cura a domicilio polivalente (SPASAD). Un unico punto di contatto, un unico luogo per tutte le vostre esigenze."
    ],
    "fr": [
      "Association de services à domicile, certifiée AFNOR, services à la personne : Aide, Soins, Accompagnement réunis en un seul service le Service Polyvalent d'Aide et de Soins A Domicile (SPASAD). Un seul guichet, un seul lieu pour tous vos besoins."
    ],
    "es": [
      "Asociación de servicios a domicilio certificada por AFNOR, servicios personales: Ayuda, Cuidado, Acompañamiento combinados en un solo servicio, el Servicio Polivalente de Ayuda y Cuidado a Domicilio (SPASAD). Un único punto de contacto, un único lugar para todas sus necesidades."
    ],
    "nl": [
      "AFNOR-gecertificeerde vereniging van diensten aan huis, persoonlijke diensten: hulp, zorg, begeleiding samengebracht in één enkele dienst, de Service Polyvalent d'Aide et de Soins A Domicile (SPASAD). Eén aanspreekpunt voor al uw behoeften."
    ]
  },
