  "rdfs:comment": {
    "de": [
      "Dank seiner 16-jährigen Erfahrung und der Professionalität seiner Lehrer bereiten wir Ihnen unseren besten Empfang, um Ihren Aufenthalt zu einem unvergesslichen Erlebnis zu machen."
    ],
    "en": [
      "With over fifteen years experience and a professional staff of instructors, we intend to make your stay with us an truly unforgettable experience."
    ],
    "it": [
      "Grazie ai nostri 16 anni di esperienza e alla professionalità dei nostri istruttori, vi daremo la migliore accoglienza per rendere il vostro soggiorno un'esperienza indimenticabile."
    ],
    "fr": [
      "Grâce à ses 16 années d’expérience et au professionnalisme de ses moniteurs, nous vous réservons notre meilleur accueil pour faire de votre séjour une expérience inoubliable."
    ],
    "es": [
      "Gracias a nuestros 16 años de experiencia y a la profesionalidad de nuestros monitores, le daremos la mejor bienvenida para hacer de su estancia una experiencia inolvidable."
    ],
    "nl": [
      "Dankzij onze 16 jaar ervaring en de professionaliteit van onze instructeurs, kunnen we je van harte welkom heten om van je verblijf een onvergetelijke ervaring te maken."
    ]
  },
