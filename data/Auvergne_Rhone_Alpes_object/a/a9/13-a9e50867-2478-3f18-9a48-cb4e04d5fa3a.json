  "rdfs:comment": {
    "de": [
      "Begeben Sie sich mit Louis Mandrin, dem berühmten Schmuggler des 18. Jahrhunderts, auf ein Abenteuer. Jahrhunderts. Entdecken Sie Tavernen, Wälder und Verstecke, die ihm vertraut waren. Kannst du dir nach einer Schmuggelkampagne mit ihm seine Schatzkarte verdienen?"
    ],
    "en": [
      "Through a journey punctuated with visual and sound effects, Louis Mandrin, a famous smuggler from the 18th century invites you to discover his universe: taverns, woods and hideouts in which he used to go. You may even be able to do some business with him!"
    ],
    "it": [
      "Partite per un'avventura in compagnia di Louis Mandrin, il famoso contrabbandiere del XVIII secolo. Scoprite le taverne, i boschi e i nascondigli che gli erano così familiari. Dopo una campagna di contrabbando in sua compagnia, riuscirete a guadagnare la sua mappa del tesoro?"
    ],
    "fr": [
      "Partez à l'aventure en compagnie de Louis Mandrin, célèbre contrebandier du XVIIIème siècle. Découvrez tavernes, bois et caches qui lui étaient familiers. Après une campagne de contrebande en sa compagnie, saurez-vous mériter sa carte aux trésors ?"
    ],
    "nl": [
      "Museum Louis Mandrin: Beleef de avonturen van de smokkelaarbende uit de XVIII de eeuw. Een speels parcours en interactief om kennis te maken met “Mandrin”, treedt binnen in zijn troepen…en misschien lukt het je om zijn schatkaart te bemachtigen! De ingang bevindt zich bij het Toeristen Bureau."
    ],
    "es": [
      "Embárquese en una aventura con Louis Mandrin, el famoso contrabandista del siglo XVIII. Descubrir las tabernas, los bosques y los escondites que le eran familiares. Tras una campaña de contrabando con él, ¿podrás ganarte su mapa del tesoro?"
    ]
  },
