  "rdfs:comment": {
    "de": [
      "Entdecken Sie Le Grand-Bornand auf eine andere Art und Weise dank der Reitaktivitäten auf Ponys, Pferden, bei einem Spaziergang oder während einer für alle Zielgruppen geeigneten Pferdevermittlung."
    ],
    "en": [
      "Let's discover Le Grand-Bornand in a different way thanks to equestrian activities on pony or horseback, for a stroll or during an equine mediation session adapted to all publics."
    ],
    "it": [
      "Scoprite Le Grand-Bornand in modo diverso grazie alle attività equestri su pony o a cavallo, per una passeggiata o durante una sessione di mediazione equina adatta a tutti i pubblici."
    ],
    "fr": [
      "Découvrez Le Grand-Bornand autrement grâce aux activités équestres à poney, à cheval, pour une balade ou pendant une séance de médiation équine adaptée à tous publics."
    ],
    "nl": [
      "Ontdek Le Grand-Bornand op een andere manier dankzij activiteiten te paard of op een pony, voor een wandeling of tijdens een bemiddelingssessie met paarden, aangepast aan alle publieken."
    ],
    "es": [
      "Descubra Le Grand-Bornand de una forma diferente gracias a las actividades ecuestres en poni o a caballo, durante un paseo o en una sesión de mediación equina adaptada a todos los públicos."
    ]
  },
