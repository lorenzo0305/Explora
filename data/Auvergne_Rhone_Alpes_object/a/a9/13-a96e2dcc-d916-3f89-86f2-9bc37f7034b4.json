  "rdfs:comment": {
    "de": [
      "Carnets d'Alpage, das Treffen der Skizzenmalerei in den Bergen, kehrt für eine fünfte Ausgabe nach Le Grand-Bornand zurück,"
    ],
    "en": [
      "Carnets d'Alpage, the mountain sketching event, is back in Le Grand-Bornand for its 5th edition, organised by the trio of artist-sketchers Pierre Amoudry, Vincent Desplanche and Luc Perillat."
    ],
    "it": [
      "Carnets d'Alpage, l'evento di disegno di montagna, torna a Le Grand-Bornand per una quinta edizione ideata dal trio di artisti-croqueur Pierre Amoudry, Vincent Desplanche e Luc Perillat."
    ],
    "fr": [
      "Carnets d'Alpage, rencontres du croquis en montagne, est de retour au Grand-Bornand pour une 5ème édition concoctée par le trio d’artistes-croqueurs Pierre Amoudry, Vincent Desplanche et Luc Perillat."
    ],
    "nl": [
      "Carnets d'Alpage, het evenement voor bergschetsen, is terug in Le Grand-Bornand voor een 5e editie bedacht door het kunstenaar-kroketstrio Pierre Amoudry, Vincent Desplanche en Luc Perillat."
    ],
    "es": [
      "Carnets d'Alpage, el evento de dibujo de montaña, vuelve a Le Grand-Bornand en su 5ª edición, ideada por el trío de artistas y croqueurs Pierre Amoudry, Vincent Desplanche y Luc Perillat."
    ]
  },
