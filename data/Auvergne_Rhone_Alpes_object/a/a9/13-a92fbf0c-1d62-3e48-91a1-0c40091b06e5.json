  "rdfs:comment": {
    "de": [
      "Entdecken Sie Le Montana by ESF Val Thorens, einen für Kleinkinder (3-4 Jahre) konzipierten Bereich mit sanften und lustigen Skikursen inmitten eines sicheren Kindergartens in der Nähe des Skigebiets."
    ],
    "en": [
      "Discover Le Montana by ESF Val Thorens, an area designed for toddlers (aged 3-4) with gentle, fun ski lessons in a secure children's garden close to the resort."
    ],
    "it": [
      "Scoprite Le Montana by ESF Val Thorens, un'area pensata per i più piccoli (3-4 anni) con lezioni di sci dolci e divertenti in un giardino per bambini sicuro vicino al resort."
    ],
    "fr": [
      "Découvrez Le Montana by ESF Val Thorens, un espace conçu pour les tout-petits (3-4 ans) avec des cours de ski doux et amusants au milieu d'un jardin d'enfant sécurisé à proximité de la station."
    ],
    "nl": [
      "Ontdek Le Montana by ESF Val Thorens, een gebied dat is ontworpen voor peuters (3-4 jaar) met rustige, leuke skilessen in een beveiligde kindertuin dicht bij het resort."
    ],
    "es": [
      "Descubra Le Montana by ESF Val Thorens, un espacio pensado para los más pequeños (3-4 años) con clases de esquí suaves y divertidas en un jardín infantil seguro cerca de la estación."
    ]
  },
