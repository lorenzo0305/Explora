  "rdfs:comment": {
    "de": [
      "Junger Winzer, der sich 2023 in Le Crozet auf den vergessenen Terroirs im Norden der Appellation niedergelassen hat.\r\nBiologische Praktiken, die sich im Prozess der Zertifizierung befinden, biodynamische Präparate und Weinberge, die zu 100% mit Massenselektion bepflanzt sind."
    ],
    "en": [
      "Young winemaker set up in 2023 at Le Crozet on forgotten terroirs in the northern part of the appellation.\r\nOrganic practices undergoing certification, biodynamic preparations and vineyard planted 100% with massal selection."
    ],
    "it": [
      "Giovane viticoltore impiantato nel 2023 a Le Crozet, sui terroir dimenticati del nord della denominazione.\r\nPratiche biologiche in corso di certificazione, preparazioni biodinamiche e vigneto piantato al 100% con selezione massale."
    ],
    "fr": [
      "Jeune vigneron installé en 2023 à Le Crozet sur les terroirs oubliés du Nord de l'appellation. \r\nPratiques biologiques en cours de labellisation, préparations biodynamiques et vignoble planté 100% en sélection massale."
    ],
    "es": [
      "Joven viticultor instalado en 2023 en Le Crozet en los terruños olvidados del norte de la denominación.\r\nPrácticas ecológicas en proceso de certificación, preparaciones biodinámicas y viñedo plantado al 100% con selección masal."
    ],
    "nl": [
      "Jonge wijnmaker, opgericht in 2023 in Le Crozet op de vergeten terroirs in het noorden van de appellation.\r\nBiologische praktijken in het proces van certificering, biodynamische voorbereidingen en wijngaard 100% beplant met massale selectie."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Domaine du Tafret"
    ]
  },
