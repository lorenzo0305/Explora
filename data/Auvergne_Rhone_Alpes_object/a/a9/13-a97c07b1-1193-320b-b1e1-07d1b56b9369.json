  "rdfs:comment": {
    "de": [
      "Der Snowpark von La Rosière wurde nach einem originellen Prinzip angelegt, das es den Fahrern ermöglicht, je nach ihrem Niveau intuitive parallele Wege zu wählen: grün, blau und rot."
    ],
    "en": [
      "La Rosière’s snowpark has been specially designed with various different routes, allowing riders to tackle the obstacles that suit their level: green, blue or red."
    ],
    "it": [
      "Lo snowpark di La Rosière è stato progettato secondo un principio originale che consente ai rider di scegliere percorsi paralleli intuitivi in base al proprio livello: verde, blu e rosso."
    ],
    "fr": [
      "Le snowpark de La Rosière a été aménagé selon un principe original qui permet aux riders de choisir des cheminements parallèles intuitifs en fonction de leur niveau : vert, bleu et rouge."
    ],
    "nl": [
      "Het sneeuwpark van La Rosière is aangelegd volgens een origineel principe waarbij de rijders intuïtieve parallelle paden kunnen kiezen volgens hun niveau: groen, blauw en rood."
    ],
    "es": [
      "El snowpark de La Rosière se ha trazado según un principio original que permite a los riders elegir caminos paralelos intuitivos según su nivel: verde, azul y rojo."
    ]
  },
