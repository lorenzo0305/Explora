  "rdfs:comment": {
    "de": [
      "Das Bistrot Savoyard bietet Ihnen Speisen auf der Grundlage von Savoyer Produkten, wie Fondues und Raclette (auf traditionellen Geräten serviert) sowie verschiedene Gratins und Tartines."
    ],
    "en": [
      "The Savoyard Bistrot offers you a restaurant based on Savoyard products, you will find the essential fondues and raclette (served on traditional device) as well as various gratins and toast."
    ],
    "it": [
      "Il Bistrot Savoyard offre un ristorante a base di prodotti savoiardi, tra cui le immancabili fondute e raclette (servite su attrezzature tradizionali) e vari gratin e creme spalmabili."
    ],
    "fr": [
      "Le Bistrot Savoyard vous propose une restauration à base de produits savoyard , on y retrouve les incontournables fondues et raclette (servies sur appareil traditionnel )ainsi que divers gratins et tartines."
    ],
    "es": [
      "El Bistrot Savoyard sirve comida elaborada con productos de Saboya, incluidas las inevitables fondues y raclette (servidas en un aparato tradicional), así como diversos gratinados y tartines."
    ],
    "nl": [
      "De Bistrot Savoyard biedt een restaurant op basis van Savoyaardse producten, waaronder de onvermijdelijke fondues en raclette (geserveerd op traditionele apparatuur) en diverse gratins en spreads."
    ]
  },
  "rdfs:label": {
