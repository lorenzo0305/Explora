  "rdfs:comment": {
    "de": [
      "Das 17.45 ist das erste Restaurant, das zu 100 % auf Aperitifbretter spezialisiert ist! Stellen Sie sich Ihre Käse- und Wurstplatte nach Ihrem Geschmack aus über 40 sorgfältig ausgewählten Produkten von Erzeugern aus unseren Regionen selbst zusammen!"
    ],
    "en": [
      "Le 17.45 is the first restaurant 100% specialized in aperitif boards! Compose your own cheese and charcuterie board to your taste from over 40 carefully selected products from regional producers!"
    ],
    "it": [
      "Le 17.45 è il primo ristorante specializzato al 100% in taglieri da aperitivo! Componete il vostro tagliere di formaggi e salumi secondo i vostri gusti, scegliendo tra oltre 40 prodotti accuratamente selezionati da produttori regionali!"
    ],
    "fr": [
      "Le 17.45 est le premier restaurant 100% spécialiste des planches apéros ! Composez vous-même votre planche de fromage et charcuterie à votre goût parmi plus de 40 produits sélectionnés avec la plus grande précaution, auprès de producteurs de nos régions !"
    ],
    "nl": [
      "Le 17.45 is het eerste restaurant dat zich 100% specialiseert in aperitiefplankjes! Stel je eigen kaas- en vleesplankje naar smaak samen uit meer dan 40 zorgvuldig geselecteerde producten van regionale producenten!"
    ],
    "es": [
      "Le 17.45 es el primer restaurante especializado al 100% en tablas de aperitivos Confeccione su propia tabla de quesos y embutidos a su gusto entre más de 40 productos cuidadosamente seleccionados de productores regionales"
    ]
  },
