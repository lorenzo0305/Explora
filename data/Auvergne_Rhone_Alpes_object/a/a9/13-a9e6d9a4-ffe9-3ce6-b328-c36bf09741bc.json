  "rdfs:comment": {
    "de": [
      "Passy empfängt eine seiner wichtigsten Veranstaltungen des Sommers: den 17. Trail du Tour des Fiz®. 2000 Läufer werden bei 3 Läufen für alle Niveaus im Herzen des Massif des Fiz erwartet."
    ],
    "en": [
      "Passy hosts one of its flagship summer events: the 17th Trail du Tour des Fiz®. 2000 runners are expected over 3 races for all levels, in the heart of the Massif des Fiz."
    ],
    "it": [
      "Passy ospita uno dei suoi eventi estivi di punta: il 17° Trail du Tour des Fiz®. Sono attesi 2.000 corridori che parteciperanno a 3 gare per tutte le abilità, nel cuore del Massiccio dei Fiz."
    ],
    "fr": [
      "Passy accueille l'un de ses événements phares de l’été : le 17ème Trail du Tour des Fiz®. 2000 coureurs sont attendus sur 3 courses pour tous les niveaux, au coeur du Massif des Fiz."
    ],
    "nl": [
      "Passy organiseert een van zijn belangrijkste zomerevenementen: de 17e Trail du Tour des Fiz®. er worden 2000 lopers verwacht in 3 wedstrijden voor alle niveaus, in het hart van het Massif des Fiz."
    ],
    "es": [
      "Passy acoge uno de sus acontecimientos estrella del verano: el 17º Trail du Tour des Fiz®. se espera la participación de 2.000 corredores en 3 carreras para todos los niveles, en el corazón del Massif des Fiz."
    ]
  },
