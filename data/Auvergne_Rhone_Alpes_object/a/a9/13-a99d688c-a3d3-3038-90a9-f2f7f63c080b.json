  "rdfs:comment": {
    "de": [
      "Haben Sie sich für den Rundgang durch die mittelalterliche Stadt Conflans entschieden? Versuchen Sie, die 12 Hinweise zu entdecken, die auf diesem Rundgang auf Sie warten. Von den Brunnen bis zum Schloss Manuel de Locatel können Sie sich mithilfe Ihrer Karte durch alle Ecken der Stadt führen lassen."
    ],
    "en": [
      "Have you chosen the tour of the medieval town of Conflans? Try your hand at discovering the 12 clues that await you along the way. From the fountains to the Manuel de Locatel castle, let your map guide you through all the nooks and crannies of the town."
    ],
    "it": [
      "Avete scelto il percorso attraverso la città medievale di Conflans? Cercate di scoprire i 12 indizi che vi aspettano lungo il percorso. Dalle fontane al castello Manuel de Locatel, usate la vostra mappa per guidarvi in tutti gli angoli della città."
    ],
    "fr": [
      "Vous avez choisi le circuit de la cité médiévale de Conflans ? Tentez de découvrir les 12 indices qui vous attendent sur ce parcours. Des fontaines au château Manuel de Locatel, laissez-vous guider à l'aide de votre carte dans tous les recoins de la cité."
    ],
    "es": [
      "¿Has elegido la ruta que atraviesa la ciudad medieval de Conflans? Intenta descubrir las 12 pistas que te esperan por el camino. Desde las fuentes hasta el castillo Manuel de Locatel, utiliza tu mapa para guiarte por todos los recovecos de la ciudad."
    ],
    "nl": [
      "Heb jij de route door het middeleeuwse stadje Conflans gekozen? Probeer de 12 aanwijzingen onderweg te ontdekken. Van de fonteinen tot het kasteel Manuel de Locatel, gebruik je kaart om je door alle hoeken en gaten van de stad te leiden."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parcours permanent d'orientation - Cité médiévale de Conflans"
    ]
  },
