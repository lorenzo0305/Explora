  "rdfs:comment": {
    "de": [
      "Erzeugerladen in Monastier-sur-Gazeille. Der Laden wird von einem Kollektiv betrieben und bietet eine breite Palette an frischen, lokalen, handwerklichen und oft biologischen Produkten an. Direktverkauf das ganze Jahr über durch die wechselnden Bauern und Bäuerinnen."
    ],
    "en": [
      "Producer store in Monastier-sur-Gazeille. Run as a collective, it offers a wide range of fresh, local, artisanal and often organic produce. Direct sales all year round by rotating farmers."
    ],
    "it": [
      "Negozio di produttori a Le Monastier-sur-Gazeille. Gestito collettivamente, offre un'ampia gamma di prodotti freschi, locali, artigianali e spesso biologici. Vendita diretta tutto l'anno, da parte di agricoltori a rotazione."
    ],
    "fr": [
      "Magasin de producteur·ices au Monastier-sur-Gazeille. Tenu en collectif, il propose une large gamme de produits frais, locaux, artisanaux et souvent bio. Vente directe toute l’année, assurée par les paysan·nes en rotation."
    ],
    "es": [
      "Tienda de productores en Le Monastier-sur-Gazeille. De gestión colectiva, ofrece una amplia gama de productos frescos, locales, artesanales y a menudo ecológicos. Venta directa todo el año, por agricultores en rotación."
    ],
    "nl": [
      "Producentenwinkel in Le Monastier-sur-Gazeille. De winkel wordt collectief gerund en biedt een breed assortiment verse, lokale, ambachtelijke en vaak biologische producten. Directe verkoop het hele jaar door, door boeren in rotatie."
    ]
  },
  "rdfs:label": {
