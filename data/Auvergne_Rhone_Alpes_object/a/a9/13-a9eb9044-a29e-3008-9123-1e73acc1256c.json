  "rdfs:comment": {
    "de": [
      "Entdecken Sie die einzige \"echte\" Amethystmine Europas: die Mine von Pégut. Auf 2 ha mitten im Wald entdecken Sie mehrere Adern, gehen Sie unter die Erde, suchen Sie im Freien und gehen Sie mit Amethysten nach Hause. Besichtigung, Ausgrabungen, Shop. Wenig zu Fuß."
    ],
    "en": [
      "Discover Europe's only \"real\" amethyst mine: La Mine de Pégut. Set in 2ha of forest, discover several veins, go underground, search outdoors and leave with amethysts. Visit, dig, store. Little walking."
    ],
    "it": [
      "Scoprite l'unica \"vera\" miniera di ametista in Europa: La Mine de Pégut. In 2 ettari di foresta, scoprite diverse vene, scendete sottoterra, cercate all'esterno e uscite con le ametiste. Visita, scavi, negozio. Un po' di cammino."
    ],
    "fr": [
      "Découvrez l'unique \"vraie\" Mine d'Améthyste d'Europe : La Mine de Pégut. Sur 2ha en pleine forêt découvrez plusieurs filons, allez sous terre, cherchez en extérieur et repartez avec des améthystes. Visite, fouilles, boutique. Peu de marche."
    ],
    "nl": [
      "Ontdek de enige 'echte' amethistmijn in Europa: La Mine de Pégut. Ontdek in een bos van 2 hectare verschillende aders, ga ondergronds, zoek buiten en vertrek met amethisten. Bezoek, opgravingen, winkel. Weinig wandelen."
    ],
    "es": [
      "Descubra la única mina de amatista \"auténtica\" de Europa: La Mine de Pégut. Situada en 2 hectáreas de bosque, descubra varias vetas, entre bajo tierra, busque al aire libre y salga con amatistas. Visita, excavaciones, tienda. Poco paseo."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Mines d'Améthystes d'Auvergne"
    ]
  },
