  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/aaacc546-e6e8-39d5-82c4-0a64feeaadad",
      "dc:description": {
        "de": [
          "Monsieur Rémi singt mit poetischer und belebender Verve über Höhen, Tiefen, Schläge und Beulen. Ein musikalisches Intermezzo, aus dem man voller positiver Schwingungen hervorgeht!"
        ],
        "en": [
          "Monsieur Rémi sings of the highs, the lows, the knocks and the bumps with a poetic, invigorating verve. A musical interlude that leaves you full of positive vibes!"
        ],
        "it": [
          "Monsieur Rémi canta gli alti, i bassi, i colpi e gli urti con una verve poetica e rinvigorente. È un intermezzo musicale che vi lascerà pieni di vibrazioni positive!"
        ],
        "fr": [
          "Monsieur Rémi chante les hauts, les bas, les coups, les bosses avec une verve poétique et vivifiante. Une parenthèse musicale dont-on en ressort plein d’ondes positives !"
        ],
        "nl": [
          "Monsieur Rémi zingt over de hoogtepunten, de dieptepunten, de klappen en de hobbels met een poëtische en verkwikkende verve. Het is een muzikaal intermezzo dat je vol positieve vibes achterlaat!"
        ],
        "es": [
          "Monsieur Rémi canta sobre los altibajos, los golpes y los baches con un brío poético y vigorizante. Es un interludio musical que te llenará de vibraciones positivas"
        ]
      },
