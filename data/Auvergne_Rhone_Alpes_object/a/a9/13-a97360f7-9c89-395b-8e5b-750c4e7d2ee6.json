  "rdfs:comment": {
    "de": [
      "Das Centre de Congrès Impérial, gegenüber dem See von Annecy, bietet Ihnen 19 modulierbare Räume in einem außergewöhnlichen Arbeitsumfeld. Unsere Räume verfügen über alle erforderlichen Einrichtungen für erfolgreiche Veranstaltungen."
    ],
    "en": [
      "The Imperial Conference Centre, facing Lake Annecy, offers 19 modular rooms in an exceptional working environment. Our spaces have all the equipment required for successful events."
    ],
    "it": [
      "Il Centre de Congrès Impérial - Grand Annecy, affacciato sul lago di Annecy, vi offre 19 sale modulari in un ambiente di lavoro eccezionale e un ristorante con vista sul parco.\r\nI nostri spazi dispongono di tutti i servizi necessari per eventi di successo!"
    ],
    "fr": [
      "Le Centre de Congrès Impérial - Grand Annecy, face au Lac d'Annecy, vous propose 19 salles modulables dans un cadre de travail exceptionnel et un restaurant vue parc.\r\nNos espaces disposent de tous les équipements requis pour des manifestations réussies !"
    ],
    "nl": [
      "Het Centre de Congrès Impérial - Grand Annecy, met uitzicht op het meer van Annecy, biedt u 19 modulaire zalen in een uitzonderlijke werkomgeving en een restaurant met uitzicht op het park.\r\nOnze ruimtes hebben alle faciliteiten die je nodig hebt voor succesvolle evenementen!"
    ],
    "es": [
      "El Centre de Congrès Impérial - Grand Annecy, frente al lago de Annecy, le ofrece 19 salas modulables en un entorno de trabajo excepcional y un restaurante con vistas al parque.\r\nNuestros espacios cuentan con todas las comodidades necesarias para que sus eventos sean un éxito"
    ]
  },
