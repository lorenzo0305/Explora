            "en": [
              "from 10:30 to 12:30 and from 15:00 to 19:00\r\nClosed on Sundays and public holidays\r\nVisits in July and August: Thursdays and Fridays at 5pm (other days and the rest of the year by reservation)"
            ],
            "it": [
              "dalle 10:30 alle 12:30 e dalle 15:00 alle 19:00\r\nChiuso la domenica e i giorni festivi\r\nVisite in luglio e agosto: giovedì e venerdì alle 17.00 (gli altri giorni e il resto dell'anno su prenotazione)"
            ],
            "fr": [
              "de 10h30 à 12h30 et de 15h à 19h\r\nFermé le dimanche et les jours fériés\r\nVisite en juillet / août : les jeudis et vendredis à 17h (les autres jours et le reste de l'année sur réservation)"
            ],
            "nl": [
              "van 10:30 tot 12:30 uur en van 15:00 tot 19:00 uur\r\nGesloten op zon- en feestdagen\r\nBezoeken in juli en augustus: donderdag en vrijdag om 17 uur (andere dagen en de rest van het jaar op reservering)"
            ],
            "es": [
              "de 10:30 a 12:30 y de 15:00 a 19:00\r\nCerrado los domingos y festivos\r\nVisitas en julio y agosto: jueves y viernes a las 17:00 horas (otros días y el resto del año con reserva)"
            ]
