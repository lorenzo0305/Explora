  "rdfs:comment": {
    "de": [
      "Im 850 m hoch gelegenen Chabannes verarbeiten wir die Milch unserer Kühe zu Saint-Nectaire fermier AOP, den wir anschließend in unseren Reifekellern veredeln.\r\nBesichtigung des Bauernhofs nach vorheriger Anmeldung."
    ],
    "en": [
      "At Chabannes, 850m above sea level, we transform our cows' milk into AOP farmhouse Saint-Nectaire cheese, which we then mature in our own maturing cellars.\r\nVisit the farm on reservation."
    ],
    "it": [
      "A Chabannes, a 850 metri sul livello del mare, trasformiamo il latte delle nostre mucche in formaggio Saint-Nectaire DOP di fattoria, che poi facciamo maturare nelle nostre cantine di stagionatura.\r\nVisite alla fattoria su prenotazione."
    ],
    "fr": [
      "A 850m d'altitude, à Chabannes nous transformons le lait de nos vaches en saint-nectaire fermier AOP que nous affinons ensuite dans nos caves d'affinages. \r\nVisite de la ferme sur réservation."
    ],
    "nl": [
      "In Chabannes, op 850 meter boven zeeniveau, verwerken we de melk van onze koeien tot boerenkaas met de BOB Saint-Nectaire, die we vervolgens laten rijpen in onze eigen rijpingskelders.\r\nBezoek aan de boerderij op afspraak."
    ],
    "es": [
      "En Chabannes, a 850 m de altitud, transformamos la leche de nuestras vacas en queso de granja Saint-Nectaire DOP, que maduramos en nuestras propias bodegas de maduración.\r\nVisitas a la granja con cita previa."
    ]
  },
  "rdfs:label": {
    "en": [
      "GAEC de la Ferme du Clos"
    ],
