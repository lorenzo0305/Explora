        "de": [
          "Um 10:30 Uhr und 11:15 Uhr\nSanfte Umarmungen (Galerie der Zeit)\nRund um die Madonna mit Kind von Andrea della Robbia."
        ],
        "en": [
          "At 10:30 am and 11:15 am\nGentle hugs (Galerie du temps)\nAround Andrea della Robbia?s Madonna and Child."
        ],
        "it": [
          "Alle 10.30 e alle 11.15\nAbbracci gentili (Galerie du temps)\nIntorno alla Vergine e al Bambino di Andrea della Robbia."
        ],
        "fr": [
          "A 10h30 et 11h15\nDes câlins tout en douceur (Galerie du temps)\nAutour de la Vierge à l’enfant d’Andrea della Robbia."
        ],
        "nl": [
          "Om 10.30 uur en 11.15 uur\nZachte omhelzingen (Galerie du temps)\nRondom de Maagd en het Kind van Andrea della Robbia."
        ],
        "es": [
          "A las 10.30 h y a las 11.15 h\nAbrazos suaves (Galerie du temps)\nEn torno a la Virgen con el Niño de Andrea della Robbia."
