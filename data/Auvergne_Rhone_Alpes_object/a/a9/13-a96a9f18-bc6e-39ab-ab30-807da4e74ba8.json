  "rdfs:comment": {
    "de": [
      "Von den fünf Mühlen, die einst am Niervèze-Bach standen, ist sie die einzige, die überlebt hat. Wie wäre es, wenn Sie sich die Zeit für einen Spaziergang nehmen, um sie zu entdecken?"
    ],
    "en": [
      "Of the five mills that once existed on the Niervèze stream, this is the only one to have survived. Why not take a stroll and discover it for yourself?"
    ],
    "it": [
      "Dei cinque mulini che esistevano sul torrente Niervèze, questo è l'unico sopravvissuto. Perché non vi prendete il tempo di fare una passeggiata e scoprirlo?"
    ],
    "fr": [
      "Des cinq moulins qui existaient sur le ruisseau de Niervèze, c'est le seul à avoir survécu. Et si vous preniez le temps d'une petite balade pour aller le découvrir?"
    ],
    "nl": [
      "Van de vijf molens die aan de Niervèze hebben gestaan, is dit de enige die bewaard is gebleven. Waarom neem je niet de tijd om een wandeling te maken en het te ontdekken?"
    ],
    "es": [
      "De los cinco molinos que existían en el arroyo Niervèze, éste es el único que ha sobrevivido. Tómese su tiempo para pasear y descubrirlo."
    ]
  },
  "rdfs:label": {
    "en": [
      "Niervèze watermill"
    ],
    "fr": [
      "Le Moulin de Niervèze"
    ],
    "es": [
      "El molino de Nierveze"
    ]
  },
