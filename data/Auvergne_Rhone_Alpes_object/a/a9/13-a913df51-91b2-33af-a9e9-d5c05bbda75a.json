  "rdfs:comment": {
    "de": [
      "Einnahmen von Betrieben und Einzelhändlern anderer lokaler Hersteller. Verkauf von Obst, Gemüse, verarbeiteten und regionalen Produkten (Saft, Marmelade, Honig, Wein, Käse, Wurstwaren vom Bauernhof. . . ). Möglichkeit des Pflückens auf dem Bauernhof."
    ],
    "en": [
      "Farm products retailer and other local producers. Sales of fruits, vegetables,  and regional products (juice, jam, honey, wine, cheese, charcuterie farm ...). Possibility of harvesting on the farm."
    ],
    "it": [
      "Negozio in fattoria, nel bel mezzo di un'azienda agricola.\r\nTroverete prodotti di una sessantina di produttori, oltre ai nostri! (pane, formaggio, carne, frutta, gelato, vino, olio, uova, pasta, lumache, spirulina, birra, ....)"
    ],
    "fr": [
      "Magasin de producteurs, au milieu d'un site de cueillette à la ferme. \r\nRetrouvez  des produits d'une soixantaine de producteurs en plus de notre production ! (pain, fromage, viande, fruit, , glace, vin, huile, œuf, pâte, escargot, spiruline, bière, ....)"
    ],
    "es": [
      "Tienda agrícola, en medio de una granja de recolección.\r\nEncontrarás productos de unos sesenta productores, ¡además de los nuestros! (pan, queso, carne, fruta, helado, vino, aceite, huevos, pasta, caracoles, espirulina, cerveza, ....)"
    ],
    "nl": [
      "Boerderijwinkel, midden op een plukboerderij. Je vindt er producten van ongeveer zestig producenten (brood, kaas, vlees, fruit, groenten, ijs, wijn, olie, eieren, pasta, lavendel, slakken, spirulina, bier, kaarsen, kruiden ....)."
    ]
  },
