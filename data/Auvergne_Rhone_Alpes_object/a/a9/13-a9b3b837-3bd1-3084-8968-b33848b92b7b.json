  "rdfs:comment": {
    "de": [
      "Jahrhundert erbaut und war früher von der Abtei von Savigny abhängig. Sie besteht aus drei Schiffen."
    ],
    "en": [
      "The church was built in the 18th century and once belonged to Savigny Abbey. It has three naves."
    ],
    "it": [
      "La chiesa fu costruita nel XVIII secolo e un tempo faceva parte dell'Abbazia di Savigny. Ha tre navate."
    ],
    "fr": [
      "L'église a été construite au XVIIIe siècle et dépendait autrefois de l'abbaye de Savigny. Elle est composée de trois nefs."
    ],
    "es": [
      "La iglesia, construida en el siglo XVIII, formaba parte de la abadía de Savigny. Consta de tres naves."
    ],
    "nl": [
      "De kerk werd gebouwd in de 18e eeuw en maakte ooit deel uit van de abdij van Savigny. Ze heeft drie schepen."
    ]
  },
