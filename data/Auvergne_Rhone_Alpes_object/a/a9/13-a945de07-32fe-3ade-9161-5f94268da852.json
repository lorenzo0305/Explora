  "rdfs:comment": {
    "de": [
      "Das Museum befindet sich im Schloss, dem ehemaligen Wohnsitz der Herzöge von Lesdiguières, der mächtigen Familie Perier und von Präsidenten der Republik, inmitten eines 100 Hektar großen Parks."
    ],
    "en": [
      "The castle shelters the museum of the French Revolution since 1984. The collections gather pieces of art such as paintings, drawings, sculptures and engravings."
    ],
    "it": [
      "Il museo è ospitato nel castello, antica dimora dei duchi di Lesdiguières, della potente famiglia Perier e dei presidenti della Repubblica, nel cuore di un parco di 100 ettari."
    ],
    "fr": [
      "Le musée est installé dans le château, ancienne demeure des Ducs de Lesdiguières, de la puissante famille Perier et de présidents de la République, au cœur d’un parc de 100 hectares."
    ],
    "nl": [
      "Het museum is ondergebracht in het kasteel, de voormalige woonplaats van de hertogen van Lesdiguières, de machtige familie Perier en presidenten van de Republiek, in het hart van een 100 hectare groot park."
    ],
    "es": [
      "El museo se situa dentro del castillo, antigua residencia de los Duques de Lesdiguières, de la poderosa familia Perier y de algunos presidentes de la República, en un parque verde de 100 hectáreas."
    ]
  },
