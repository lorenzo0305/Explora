  "rdfs:comment": {
    "de": [
      "25 km von Issoire entfernt bietet Espace VTT n°1® in der Auvergne Rhône Alpes in einer außergewöhnlichen, wunderschönen Umgebung Ausflüge von 18 km bis 25 km mit elektrischen Geländerollern auf markierten Wegen, die für alle zugänglich sind."
    ],
    "en": [
      "25 km from Issoire, Espace VTT n°1® in Auvergne Rhône Alpes offers 18km to 25km rides on electric scooters on marked trails accessible to all, in an exceptional, beautiful setting."
    ],
    "it": [
      "A soli 25 km da Issoire, l'Espace VTT n°1® in Auvergne Rhône Alpes offre corse da 18 a 25 km su scooter elettrici fuoristrada su percorsi segnalati e accessibili a tutti, in un contesto di eccezionale bellezza."
    ],
    "fr": [
      "A 25 km d'Issoire, Espace VTT n°1® en Auvergne Rhône Alpes  propose, dans un cadre exceptionnel, de toute beauté, des balades de 18km à 25km en trottinettes tout terrain électriques sur des chemins balisés accessibles à tous."
    ],
    "nl": [
      "Op slechts 25 km van Issoire biedt Espace VTT n°1® in Auvergne Rhône Alpes ritten van 18 tot 25 km op elektrische all-terrain scooters op bewegwijzerde paden die toegankelijk zijn voor iedereen, in een uitzonderlijk mooie omgeving."
    ],
    "es": [
      "A sólo 25 km de Issoire, el Espace VTT n°1® de Auvergne Rhône Alpes ofrece paseos de 18 a 25 km en scooters eléctricos todo terreno por senderos señalizados y accesibles para todos, en un entorno de excepcional belleza."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Location de trottinettes électriques tout terrain - Espace VTT n°1"
    ]
  },
