  "rdfs:comment": {
    "de": [
      "Dieses Restaurant empfängt Sie in Hautecour das ganze Jahr über in einem angenehmen und gemütlichen Rahmen. Familiäre Atmosphäre am Kamin oder Entspannung auf der Panoramaterrasse.\r\nSie werden eine traditionelle Küche von hoher Qualität genießen."
    ],
    "en": [
      "This restaurant welcomes you to Hautecour all year round in a warm and friendly setting, with a family atmosphere by the fireplace or relaxing on the panoramic terrace.\r\nEnjoy traditional, high-quality cuisine.\r\nDinner service on reservation.  Pizza evenings on Friday evenings.  Continuous lunch service."
    ],
    "it": [
      "Questo ristorante vi accoglie ad Hautecour tutto l'anno in un ambiente caldo e accogliente, con un'atmosfera familiare accanto al camino o rilassandosi sulla terrazza panoramica.\r\nGustate una cucina tradizionale e di alta qualità."
    ],
    "fr": [
      "Ce restaurant vous accueille à Hautecour toute l'année dans un cadre agréable et chaleureux, ambiance familiale au coin de la cheminée ou détente sur la terrasse panoramique.\r\nVous dégusterez une cuisine traditionnelle de qualité."
    ],
    "es": [
      "Este restaurante le da la bienvenida a Hautecour durante todo el año en un ambiente cálido y acogedor, con un ambiente familiar junto a la chimenea o relajándose en la terraza panorámica.\r\nDisfrute de una cocina tradicional de calidad."
    ],
    "nl": [
      "Dit restaurant verwelkomt je het hele jaar door in Hautecour in een warme en vriendelijke omgeving, met een familiale sfeer bij de open haard of ontspannend op het panoramische terras.\r\nGeniet van de traditionele keuken van hoge kwaliteit."
    ]
  },
  "rdfs:label": {
    "en": [
      "Le Chalet de la Trappe"
    ],
    "fr": [
      "Le Chalet de la Trappe"
    ]
  },
