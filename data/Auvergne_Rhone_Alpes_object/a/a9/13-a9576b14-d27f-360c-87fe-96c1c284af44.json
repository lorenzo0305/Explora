  "rdfs:comment": {
    "de": [
      "Muriel und Stéphane laden Sie ein, ein Picknick zu genießen, das zu 100 % aus der Region stammt. Dieses Restaurant wurde von der Marke \"Goûtez l'Ardèche\" ausgewählt, die für Qualität und Nähe steht! Reservieren Sie Ihr Picknick am Vortag unter der Nummer 04 75 52 41 10."
    ],
    "en": [
      "Muriel and Stéphane invite you to enjoy a 100% local picnic. This restaurant is selected by the “Goûtez l’Ardèche” brand, a guarantee of quality and proximity! Reserve your picnic the day before at 04 75 52 41 10."
    ],
    "it": [
      "Muriel e Stéphane vi invitano a gustare un picnic 100% locale. Questo ristorante ha ottenuto il marchio \"Goûtez l'Ardèche\", garanzia di qualità e vicinanza! Prenotate il vostro picnic il giorno precedente chiamando il numero 04 75 52 41 10."
    ],
    "fr": [
      "Muriel et Stéphane vous proposent de déguster un pique-nique  100% local. Ce restaurant est sélectionné par la marque \"Goûtez l'Ardèche\", gage de qualité et de proximité ! Réservez votre pique-nique la veille au 04 75 52 41 10."
    ],
    "es": [
      "Muriel y Stéphane le invitan a disfrutar de un picnic 100% local. Este restaurante ha sido galardonado con el sello \"Goûtez l'Ardèche\", ¡una garantía de calidad y proximidad! Reserve su picnic la víspera llamando al 04 75 52 41 10."
    ],
    "nl": [
      "Muriel en Stéphane nodigen je uit om te genieten van een 100% lokale picknick. Dit restaurant heeft het label \"Goûtez l'Ardèche\" gekregen, een garantie voor kwaliteit en nabijheid! Reserveer je picknick de dag ervoor door te bellen naar 04 75 52 41 10."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le panier pique-nique du Relais du Buis d'Aps"
    ]
  },
