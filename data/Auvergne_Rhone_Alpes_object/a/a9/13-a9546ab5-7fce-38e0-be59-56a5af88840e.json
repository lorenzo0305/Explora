  "rdfs:comment": {
    "de": [
      "Besuchen Sie das Haus auf eigene Faust.\r\nDas Museum hat es geschafft, die Atmosphäre des Geburtshauses von Charles-Louis Philippe, einem Schriftsteller aus Bourbonnais, nachzuempfinden.\r\nSeit 2002 trägt es das Label \"Musée de France\" und \"Maisons des Illustres."
    ],
    "en": [
      "Free visit.\r\nThe museum has been able to recreate the atmosphere of the birthplace of Charles-Louis Philippe, a writer from Bourbonnais.\r\nLabelled \"Musée de France\" since 2002 and \"Maisons des Illustres."
    ],
    "it": [
      "Visita gratuita.\r\nIl museo ha ricreato l'atmosfera della casa natale di Charles-Louis Philippe, lo scrittore Bourbonnais.\r\nEtichettato \"Musée de France\" dal 2002 e \"Maisons des Illustres\"."
    ],
    "fr": [
      "Visite libre.\r\nLe musée a su recréer l'atmosphère de la maison natale de Charles-Louis Philippe, écrivain bourbonnais.\r\nLabellisé \"Musée de France\" depuis 2002 et \"Maisons des Illustres."
    ],
    "es": [
      "Visita gratuita.\r\nEl museo ha recreado el ambiente de la casa natal de Charles-Louis Philippe, el escritor de Bourbonnais.\r\nEtiquetado como \"Museo de Francia\" desde 2002 y \"Maisons des Illustres."
    ],
    "nl": [
      "Gratis bezoek.\r\nHet museum heeft de sfeer van het geboortehuis van Charles-Louis Philippe, een schrijver uit Bourbonnais, nagebootst.\r\nMet het label \"Musée de France\" sinds 2002 en \"Maisons des Illustres\"."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Maison natale Charles-Louis-Philippe"
    ]
  },
