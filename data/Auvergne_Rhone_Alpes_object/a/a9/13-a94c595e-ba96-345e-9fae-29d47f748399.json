  "rdfs:comment": {
    "de": [
      "Dieses traditionelle und authentische Restaurant im Herzen von Montluel legt Wert auf die Zusammenarbeit mit lokalen Produzenten, um Ihnen eine saisonale Küche anbieten zu können."
    ],
    "en": [
      "In the heart of Montluel, this traditional, authentic restaurant works with local producers to offer seasonal cuisine."
    ],
    "it": [
      "Nel cuore di Montluel, questo ristorante tradizionale e autentico collabora con i produttori locali per offrirvi una cucina di stagione."
    ],
    "fr": [
      "Au cœur de Montluel, ce restaurant traditionnel et authentique privilégie la collaboration avec les  producteurs locaux pour vous proposer une cuisine de saison."
    ],
    "es": [
      "En el corazón de Montluel, este restaurante tradicional y auténtico trabaja con los productores locales para ofrecerle una cocina de temporada."
    ],
    "nl": [
      "Dit traditionele en authentieke restaurant in het hart van Montluel werkt samen met lokale producenten om je seizoensgebonden gerechten aan te bieden."
    ]
