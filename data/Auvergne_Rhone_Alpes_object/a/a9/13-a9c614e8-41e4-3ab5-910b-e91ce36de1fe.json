  "rdfs:comment": {
    "de": [
      "DALERY Maroquinier, die erste französische Kette von Lederwaren und Gepäckstücken mit mehreren Marken.\r\nEntdecken Sie eine Auswahl an Handtaschen (Handtaschen, Umhängetaschen, Schultertaschen...), Schuhen, Gürteltaschen, Gepäck und anderen Accessoires der bekanntesten Marken."
    ],
    "en": [
      "DALERY Maroquinier, France's 1st multi-brand leather goods and luggage chain.\r\nCome and discover a selection of handbags (hand-carried, cross-body, shoulder bags...), shoes, bags, luggage and other accessories from leading brands."
    ],
    "it": [
      "DALERY Maroquinier, la prima catena di pelletteria e valigeria multimarca in Francia.\r\nVenite a scoprire una selezione di borse (da portare a mano, a tracolla, ecc.), scarpe, borse, valigie e altri accessori di marchi leader."
    ],
    "fr": [
      "DALERY Maroquinier, 1ère chaîne française de maroquinerie-bagagerie multimarques.\r\nVenez découvrir une sélection de sacs à main (porté main, porté-travers, sac bandoulière…), chaussures, sacoches, bagages et autres accessoires des plus grandes marques."
    ],
    "nl": [
      "DALERY Maroquinier, de 1e lederwaren- en bagageketen van Frankrijk.\r\nKom en ontdek een selectie handtassen (handtassen, crossbodytassen, schoudertassen, enz.), schoenen, tassen, bagage en andere accessoires van de toonaangevende merken."
    ],
    "es": [
      "DALERY Maroquinier, 1ª cadena multimarca de marroquinería y equipaje de Francia.\r\nVenga a descubrir una selección de bolsos (de mano, cruzados, bandoleras, etc.), zapatos, bolsas, maletas y otros accesorios de marcas líderes."
    ]
  },
