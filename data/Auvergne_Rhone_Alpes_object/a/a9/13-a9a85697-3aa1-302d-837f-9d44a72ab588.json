  "rdfs:comment": {
    "de": [
      "Dieses wunderschöne Hausboot mit Bar und Restaurant liegt an den Ufern der Rhône und eignet sich für alle Arten von Veranstaltungen, selbst für geschäftliche Anlässe."
    ],
    "en": [
      "Moored at the Quai du Général Sarrail, on the banks of the Rhône, this magnificent barge bar-restaurant is suitable for the reception of any event, wether for leisure or business."
    ],
    "it": [
      "Ormeggiata sulle rive del Rodano, questa magnifica chiatta bar-ristorante è ideale per ospitare ogni tipo di evento, compresi quelli aziendali."
    ],
    "fr": [
      "Amarrée sur les berges du Rhône, cette magnifique péniche bar-restaurant est propice à la réception de tout événement, même professionnels."
    ],
    "nl": [
      "Dit prachtige bar-restaurantschip ligt aangemeerd aan de oevers van de Rhône en is ideaal voor het organiseren van allerlei evenementen, waaronder zakelijke evenementen."
    ],
    "es": [
      "Atracada a orillas del Ródano, esta magnífica gabarra bar-restaurante es ideal para acoger todo tipo de eventos, incluidos los de empresa."
    ]
  },
