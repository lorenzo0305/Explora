  "rdfs:comment": {
    "de": [
      "Wir begleiten Sie dabei, Ihre Ressourcen zu entfalten, psycho-emotionale Blockaden, die Sie einschränken, zu lösen und Ihrem Leben einen Sinn zu geben."
    ],
    "en": [
      "Supporting you in deploying your resources, releasing the psycho-emotional blockages that limit you and giving meaning to your life."
    ],
    "it": [
      "Aiutarvi a dispiegare le vostre risorse, a liberare i blocchi psico-emotivi che vi limitano e a dare un senso alla vostra vita."
    ],
    "fr": [
      "Vous accompagner pour déployer vos ressources, libérer les blocages psycho-émotionnels qui vous limitent et donner du sens à votre vie."
    ],
    "nl": [
