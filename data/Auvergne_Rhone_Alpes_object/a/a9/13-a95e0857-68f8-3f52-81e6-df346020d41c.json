  "rdfs:comment": {
    "de": [
      "Für Fachleute oder Privatpersonen, einzigartige Kreationen auf Papier, für Schilder, an Wänden und vielen anderen Medien...\r\nVon der Papierillustration bis zum Wandgemälde: Ganéça kreiert auf Ihren Wunsch hin, mit nur wenigen Worten."
    ],
    "en": [
      "For professionals or individuals, unique creations on paper, for signs, walls and many other supports...\r\nFrom paper illustration to mural fresco, Ganéça creates at your request, on a few words."
    ],
    "it": [
      "Per professionisti o privati, creazioni uniche su carta, per insegne, su pareti e molti altri supporti...\r\nDalle illustrazioni su carta ai murales, Ganéça crea su vostra richiesta, con poche parole."
    ],
    "fr": [
      "Pour les professionnels ou pour les particuliers, des créations uniques sur le papier, pour des enseignes, sur les murs et bien d’autres supports...\r\nDe l‘illustration papier à la fresque murale, Ganéça crée à votre demande, sur quelques mots."
    ],
    "nl": [
      "Voor professionals of particulieren, unieke creaties op papier, voor borden, op muren en vele andere media...\r\nVan papieren illustraties tot muurschilderingen, Ganéça creëert op uw verzoek, met een paar woorden."
    ],
    "es": [
      "Para profesionales o particulares, creaciones únicas en papel, para carteles, en paredes y muchos otros soportes...\r\nDesde las ilustraciones en papel hasta los murales de pared, Ganéça crea a petición suya, con unas pocas palabras."
    ]
  },
