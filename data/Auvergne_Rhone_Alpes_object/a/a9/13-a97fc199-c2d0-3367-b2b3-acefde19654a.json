  "rdfs:comment": {
    "de": [
      "Als echter Höhentriathlon bietet dieses Ereignis allen, ob Amateuren oder erfahrenen Triathleten, eine zugängliche, perfekt organisierte und sichere Herausforderung."
    ],
    "en": [
      "A true altitude triathlon, this event offers everyone, from amateurs to seasoned triathletes, an accessible, perfectly organized and safe challenge."
    ],
    "it": [
      "Vero e proprio triathlon d'alta quota, questo evento offre a tutti, amatori e triatleti esperti, una sfida accessibile, perfettamente organizzata e sicura."
    ],
    "fr": [
      "Véritable triathlon d’altitude, cet événement offre à tous, amateurs ou triathlètes aguerris, un défi accessible, parfaitement organisé et sécurisé."
    ],
    "nl": [
      "Dit evenement is een echte triatlon op grote hoogte en biedt iedereen, zowel amateurs als doorgewinterde triatleten, een toegankelijke, perfect georganiseerde en veilige uitdaging."
    ],
    "es": [
      "Auténtico triatlón de altura, esta prueba ofrece tanto a los aficionados como a los triatletas experimentados un desafío accesible, perfectamente organizado y seguro."
    ]
  },
