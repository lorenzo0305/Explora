  "rdfs:comment": {
    "de": [
      "Bistronomie-Spirit und ehrliche Küche: einfache, marktfrische, hausgemachte Küche mit maximaler Ausrichtung auf Produkte aus biologischem Anbau und aus der Region. (Hamburger, Salate und Ravioli)."
    ],
    "en": [
      "Bistronomy spirit and sincere cuisine: simple, market-fresh, homemade cooking, with a focus on organic and local produce. (burgers, salads and ravioli)."
    ],
    "it": [
      "Lo spirito della bistronomia e della cucina sincera: cibo semplice, fresco di mercato e cucinato in casa, con particolare attenzione ai prodotti biologici e locali. (hamburger, insalate e ravioli)"
    ],
    "fr": [
      "Esprit bistronomie et cuisine sincère : cuisine simple et fraîche du marché, faite maison, avec une orientation portée au maximum sur les produits issus de l'agriculture biologique et locaux. (hamburgers, salades et ravioles.)"
    ],
    "es": [
      "El espíritu de la bistronomía y la cocina sincera: comida sencilla, de mercado y casera, con énfasis en los productos ecológicos y locales. (hamburguesas, ensaladas y raviolis)"
    ],
    "nl": [
      "De geest van bistronomie en oprechte keuken: eenvoudig, vers van de markt, huisgemaakt eten, met de nadruk op biologische en lokale producten. (Burgers, salades en ravioli)."
    ]
  },
  "rdfs:label": {
