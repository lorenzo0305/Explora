  "rdfs:comment": {
    "de": [
      "Die Naturheilkunde ist ein ganzheitlicher Gesundheitsansatz, der das Wohlbefinden fördern soll, indem er sich auf das Gleichgewicht von Körper, Geist und Seele konzentriert."
    ],
    "en": [
      "Naturopathy is a holistic approach to health that aims to promote well-being, focusing on the balance of body, mind and soul."
    ],
    "it": [
      "La naturopatia è un approccio olistico alla salute che mira a promuovere il benessere, concentrandosi sull'equilibrio di corpo, mente e anima."
    ],
    "fr": [
      "La naturopathie est une approche de santé holistique qui vise à promouvoir le bien être, en se concentrant sur l’équilibre du corps, de l’esprit et de l’âme."
    ],
    "nl": [
      "Natuurgeneeskunde is een holistische benadering van gezondheid die gericht is op het bevorderen van welzijn, waarbij de nadruk ligt op het evenwicht tussen lichaam, geest en ziel."
    ],
    "es": [
      "La naturopatía es un enfoque holístico de la salud cuyo objetivo es promover el bienestar, centrándose en el equilibrio del cuerpo, la mente y el alma."
    ]
  },
