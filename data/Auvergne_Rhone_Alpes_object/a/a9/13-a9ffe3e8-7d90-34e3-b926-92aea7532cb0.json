  "rdfs:comment": {
    "de": [
      "Noémie und Yannick, Skilehrer und Bergbegleiter, bieten Ihnen ganz- oder halbtägige Wanderungen in Praz de Lys und in den umliegenden Bergmassiven an."
    ],
    "en": [
      "Noémie and Yannick, ski instructors and mountain leaders, offer full-day and half-day hikes in Praz de Lys and the surrounding mountains."
    ],
    "it": [
      "Noémie e Yannick, maestri di sci e guide alpine, propongono escursioni di una giornata o mezza giornata a Praz de Lys e sulle montagne circostanti."
    ],
    "fr": [
      "Noémie et Yannick, Moniteurs de ski et Accompagnateurs en Montagne, vous proposent des randonnées à la journée ou demi-journée au Praz de Lys et dans les massifs environnants."
    ],
    "es": [
      "Noémie y Yannick, monitores de esquí y guías de montaña, ofrecen excursiones de un día o medio día en Praz de Lys y las montañas de los alrededores."
    ],
    "nl": [
      "Noémie en Yannick, skileraren en bergleiders, bieden wandelingen van een hele of halve dag in Praz de Lys en de omliggende bergen."
    ]
