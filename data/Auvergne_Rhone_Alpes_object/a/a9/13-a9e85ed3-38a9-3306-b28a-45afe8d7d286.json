  "rdfs:comment": {
    "de": [
      "Der Puy-de-Montoncel ist mit 1287 m der höchste Punkt des Departements Allier. Er ist über einen Weg durch das Waldmassiv Bois noirs zu erreichen und bietet eine 360°-Aussicht."
    ],
    "ru": [
      "Пюи-де-Монтонсель - самая высокая точка в департаменте Алье (1 287 м), до которой можно добраться пешком через лес Буа-Нуар, откуда открывается вид на 360°."
    ],
    "en": [
      "The highest point in the Allier department at 1287 m, Puy-de-Montoncel can be reached by walking through the Bois Noirs forest, offering 360° views."
    ],
    "it": [
      "Punto più alto del dipartimento dell'Allier, con i suoi 1.287 m, il Puy-de-Montoncel si raggiunge attraversando la foresta di Bois Noirs e offre una vista a 360°."
    ],
    "fr": [
      "Point culminant du département de l’Allier à 1287 m, accessible en cheminant à travers le massif forestier des Bois noirs, le Puy-de-Montoncel offre une vue à 360°."
    ],
    "es": [
      "Puy-de-Montoncel, el punto más alto del departamento de Allier con 1.287 m, se alcanza caminando por el bosque de Bois Noirs y ofrece vistas de 360°."
    ],
    "nl": [
      "Puy-de-Montoncel is met 1.287 m het hoogste punt van het departement Allier en kan worden bereikt via een wandeling door het bos van Bois Noirs en biedt 360° uitzicht."
    ],
    "zh": [
      "Puy-de-Montoncel 是阿利埃省的最高点，海拔 1,287 米，步行穿过 Bois Noirs 森林即可到达，360° 全景尽收眼底。"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Forêt des Bois Noirs, Puy du Montoncel"
    ]
  },
