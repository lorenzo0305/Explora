  "rdfs:comment": {
    "de": [
      "Das Hotel liegt vor den Toren der Cité Sagranière und bietet 23 Zimmer, ein bekanntes Bistronomie-Restaurant mit einer zum Garten hin offenen Terrasse, einen Seminarraum, ein Spa und einen im Sommer beheizten Außenpool."
    ],
    "en": [
      "Located at the entrance to the town of Sagranière, the hotel offers 23 rooms, a renowned bistro restaurant with a terrace opening onto the garden, a seminar room, a spa and an outdoor swimming pool with a unique panorama."
    ],
    "it": [
      "Situato alle porte della città di Sagranière, l'hotel offre 23 camere, un rinomato ristorante bistronomico con terrazza che si apre sul giardino, una sala seminari, un centro benessere e una piscina all'aperto riscaldata in estate."
    ],
    "fr": [
      "Situé aux portes de la cité sagranière, propose 23 chambres, une table bistronomique réputée avec sa terrasse ouverte sur le jardin, une salle de séminaire, un spa et une piscine extérieure chauffée en été."
    ],
    "es": [
      "Situado a las puertas de la ciudad de Sagranière, el hotel ofrece 23 habitaciones, un restaurante bistronómico de renombre con terraza abierta al jardín, una sala de seminarios, un spa y una piscina exterior climatizada en verano."
    ],
    "nl": [
      "Het hotel ligt aan de poort van de stad Sagranière en biedt 23 kamers, een gerenommeerd bistronomisch restaurant met een terras dat uitkomt op de tuin, een seminarruimte, een spa en een buitenzwembad dat in de zomer verwarmd wordt."
    ]
  },
