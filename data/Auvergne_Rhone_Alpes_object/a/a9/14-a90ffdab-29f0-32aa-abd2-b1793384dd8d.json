  "rdfs:comment": {
    "de": [
      "Die Mediathek des Museums ist ein Ort für Insider und Neugierige gleichermaßen. Sie ist ein Werkzeugkasten und ein idealer Ort zum Lernen, Entdecken und Teilen. Ein lebendiger Ort des Austauschs und der Kultur, ganz einfach."
    ],
    "en": [
      "The museum's media library is a place for both the initiated and the simply curious. It is both a toolbox and an ideal place to learn, discover and share. Quite simply, it's a lively place of exchange and culture."
    ],
    "it": [
      "La mediateca del museo è un luogo adatto sia agli iniziati che ai semplici curiosi. È una cassetta degli attrezzi e un luogo ideale per imparare, scoprire e condividere. In poche parole, è un luogo vivo di scambio e cultura."
    ],
    "fr": [
      "La médiathèque du musée est un lieu destiné aux initiés comme aux simples curieux. Elle est à la fois une boîte à outils et un lieu idéal pour apprendre, découvrir et partager. Un lieu vivant d’échanges et de culture, tout simplement."
    ],
    "es": [
      "La mediateca del museo es un lugar tanto para iniciados como para simples curiosos. Es a la vez una caja de herramientas y un lugar ideal para aprender, descubrir y compartir. Sencillamente, es un lugar vivo de intercambio y cultura."
    ],
    "nl": [
      "De mediatheek van het museum is een plek voor zowel ingewijden als gewone nieuwsgierigen. Het is zowel een gereedschapskist als een ideale plek om te leren, te ontdekken en te delen. Simpel gezegd is het een levende plaats van uitwisseling en cultuur."
    ]
  },
  "rdfs:label": {
