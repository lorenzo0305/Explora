  "rdfs:comment": {
    "de": [
      "Im Laden der Mikrofarm kannst du dir die Gemüsemenge aussuchen, die du für eine Woche benötigst. Der Laden ist jeden Mittwoch geöffnet!"
    ],
    "en": [
      "Vegetables and eggs"
    ],
    "it": [
      "Potete venire al negozio della microfattoria e scegliere la quantità di verdure di cui avete bisogno per la settimana. Il negozio è aperto ogni mercoledì!"
    ],
    "fr": [
      "Vous pouvez vous présenter à la boutique de la micro ferme et y choisir la quantité de légumes dont vous avez besoin pour la semaine. Ouverture de la boutique tous les mercredis!"
    ],
    "nl": [
      "U kunt naar de winkel van de micro-boerderij komen en de hoeveelheid groenten kiezen die u voor de week nodig hebt. De winkel is elke woensdag open!"
    ],
    "es": [
      "Puedes venir a la tienda de la microgranja y elegir la cantidad de verduras que necesitas para la semana. La tienda está abierta todos los miércoles"
    ]
  },
