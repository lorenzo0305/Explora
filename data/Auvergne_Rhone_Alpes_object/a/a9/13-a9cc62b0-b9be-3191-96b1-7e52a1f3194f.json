  "rdfs:comment": {
    "de": [
      "Entdecken Sie diesen wunderschönen Ort auf spielerische Weise und nutzen Sie die vier im Wald angelegten Orientierungspfade oder die im Arboretum selbst angelegten."
    ],
    "en": [
      "Come and discover this magnificent site in a playful way, taking advantage of the 4 orienteering trails created in the forest, or those created within the arboretum itself."
    ],
    "it": [
      "Venite a scoprire questo magnifico sito in modo ludico approfittando dei 4 percorsi di orienteering creati nella foresta o di quelli creati all'interno dell'arboreto stesso."
    ],
    "fr": [
      "Venez découvrir ce site magnifique d'une manière ludique en profitant des 4 parcours d'orientation créés dans la forêt, ou de ceux créés à l'intérieur même de l'arboretum."
    ],
    "es": [
      "Venga a descubrir este magnífico lugar de forma lúdica aprovechando los 4 senderos de orientación creados en el bosque, o los creados dentro del propio arboreto."
    ],
    "nl": [
      "Kom en ontdek deze prachtige plek op een speelse manier door gebruik te maken van de 4 oriëntatieroutes die in het bos zijn aangelegd, of de routes die in het arboretum zelf zijn aangelegd."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Espace sport d'orientation - Forêt des Grands Murcins"
    ]
  },
