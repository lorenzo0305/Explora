  "rdfs:comment": {
    "de": [
      "Das Reitzentrum in Ugine bietet Reitern aller Niveaus die Möglichkeit, ihren Lieblingssport unter der Anleitung von staatlich geprüften Reitlehrern auszuüben. Dank seiner Einrichtungen nimmt es Ihre Pferde und Ponys in Pension und bietet Ihnen verschiedene Kurse an."
    ],
    "en": [
      "The Ugine equestrian center allows riders of all levels to practice their favorite sport under the guidance of state-certified instructors. With its facilities, it offers boarding for your horses and ponies and provides various training courses"
    ],
    "it": [
      "Il centro ippico di Ugine permette a cavalieri di ogni livello di praticare il loro sport preferito sotto la supervisione di istruttori qualificati. Grazie alle sue strutture, accoglie i vostri cavalli e pony per la pensione e offre vari corsi."
    ],
    "fr": [
      "Le centre équestre d'Ugine permet aux cavaliers de tous niveaux de pratiquer leur sport favori encadrés par des moniteurs diplômés d'état. Grâce à ses installations, il accueille vos chevaux et poneys en pension et vous propose divers stages."
    ],
    "nl": [
      "In de manege van Ugine kunnen ruiters van alle niveaus hun favoriete sport beoefenen onder begeleiding van gediplomeerde instructeurs. Dankzij haar faciliteiten ontvangt zij uw paarden en pony's voor pensionstalling en biedt zij verschillende cursussen aan."
    ],
    "es": [
      "El centro ecuestre de Ugine permite a jinetes de todos los niveles practicar su deporte favorito bajo la supervisión de instructores cualificados. Gracias a sus instalaciones, acoge a sus caballos y ponis para su pupilaje y ofrece diversos cursos."
    ]
  },
  "rdfs:label": {
    "en": [
      "Berges de la Chaise Park Equestrian Center"
    ],
    "fr": [
      "Centre équestre"
    ]
  },
