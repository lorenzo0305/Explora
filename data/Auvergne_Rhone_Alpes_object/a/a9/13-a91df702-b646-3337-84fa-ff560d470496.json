  "rdfs:comment": {
    "de": [
      "Prabouré: Das ist ein Konzentrat an Sensationen, die man für ein Maximum an Freiheit ausprobieren kann\r\nmit dem Tagespass können Sie sich frei bewegen: Riesenseilrutsche, Ferrata, Downhill-Trottinett, Mountain Kart, die Höhle von Parbourix und hängende Zaubernetze. Sensationen garantiert!"
    ],
    "en": [
      "Prabouré, mountain activity park, can be enjoyed individually or with a day pass:\r\nTyrolean, via-ferrata, downhill mountain scooters, suspended nets and cave..."
    ],
    "it": [
      "Prabouré: è un concentrato di sensazioni da praticare per ottenere il massimo della libertà\r\ncon il pass giornaliero: tyrolienne gigante, rando-ferrata, downhill scooter, mountain kart, la grotta Parbourix e le reti incantate sospese. Sensazioni garantite!"
    ],
    "fr": [
      "Prabouré : c’est un concentré de sensations à pratiquer pour un maximum de\r\nliberté avec le pass journée : tyrolienne géante, rando-ferrata, trottinette de descente, mountain kart, la grotte de Parbourix et filets enchantés suspendus. Sensations garanties!"
    ],
    "nl": [
      "Prabouré: het is een concentraat van sensaties die voor een maximum aan vrijheid kunnen worden beoefend met de dagpas: reuzentyrolienne, rando-ferrata, downhill scooter, mountain kart, de grot van Parbourix en hangende betoverende netten\r\nmet de dagpas: giant tyrolienne, rando-ferrata, downhill scooter, mountain kart, de Parbourix grot en hangende betoverde netten. Sensaties gegarandeerd!"
    ],
    "es": [
      "Prabouré: es un concentrado de sensaciones a practicar para un máximo de libertad\r\ncon el pase de un día: tirolina gigante, rando-ferrata, scooter de descenso, kart de montaña, la cueva de Parbourix y las redes encantadas suspendidas. ¡Sensaciones garantizadas!"
    ]
  },
  "rdfs:label": {
    "en": [
      "Praboure's mountain activity park"
    ],
    "fr": [
      "Parc d'activité de Montagne de Prabouré"
    ]
  },
