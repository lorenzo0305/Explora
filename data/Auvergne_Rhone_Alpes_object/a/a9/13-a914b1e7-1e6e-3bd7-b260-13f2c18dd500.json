  "rdfs:comment": {
    "de": [
      "Das 17 ha große Weingut, das seit 2000 BIO- und seit 2016 Demeter-zertifiziert ist, befindet sich in der Gemeinde Chignin. Es empfängt Sie das ganze Jahr über, damit Sie die Weine aus Savoyen und Biere probieren können."
    ],
    "en": [
      "This 17 hectare vineyard, boasting organic certification since 2000, is located in the village of Chignin.  It is open year round, offering wine tasting experiences of the local Savoie wines."
    ],
    "it": [
      "In questa tenuta vinicola di 17 ettari, che ha ottenuto la certificazione biologica nel 2000, è possibile degustare vini di Savoia tutto l'anno."
    ],
    "fr": [
      "Le domaine de 17 ha, certifié BIO depuis 2000, Demeter depuis 2016 est situé sur la commune de Chignin. Il vous accueille toute l'année pour vous faire déguster les vins de Savoie et bières."
    ],
    "es": [
      "La finca de 17 hectáreas, certificada ecológica desde 2000 y Demeter desde 2016, está situada en la comuna de Chignin. Le damos la bienvenida todo el año para degustar nuestros vinos y cervezas de Saboya."
    ],
    "nl": [
      "Het landgoed van 17 hectare, biologisch gecertificeerd sinds 2000 en Demeter sinds 2016, ligt in de gemeente Chignin. We verwelkomen je het hele jaar door om onze Savoyse wijnen en bieren te proeven."
    ]
  },
