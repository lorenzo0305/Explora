  "rdfs:comment": {
    "de": [
      "Die Domaine de Galopin vermietet halbtägige oder ganztägige Wanderungen und Spaziergänge ab dem Dorf La Bridoire, die Sie selbstständig durchführen können. Es werden mehrere Routen angeboten, je nach Lust und Laune der Besucher."
    ],
    "en": [
      "The Domaine de Galopin rents donkeys by the half-day or full day for independent walks and hikes from the village of La Bridoire. Several itineraries are available, depending on visitors' wishes."
    ],
    "it": [
      "Il Domaine de Galopin noleggia asini per mezza giornata o giornata intera per passeggiate ed escursioni indipendenti dal villaggio di La Bridoire. Ci sono diversi itinerari per tutti i gusti."
    ],
    "fr": [
      "Le domaine de Galopin loue des ânes bâtés à la demi-journée ou à ma journée pour faire des balades e randonnées en autonomie depuis le village de La Bridoire. Plusieurs itinéraires sont proposés en fonction des envies des visiteurs."
    ],
    "nl": [
      "Het Domaine de Galopin verhuurt ezels per halve of hele dag voor zelfstandige wandelingen en trektochten vanuit het dorp La Bridoire. Er zijn verschillende routes voor elk wat wils."
    ],
    "es": [
      "El Domaine de Galopin alquila burros por media jornada o jornada completa para paseos y excursiones independientes desde el pueblo de La Bridoire. Hay varios itinerarios para todos los gustos."
    ]
  },
  "rdfs:label": {
