  "rdfs:comment": {
    "de": [
      "Traditionelles Chalet auf dem Skigebiet, Bergatmosphäre mit Gérard und Aurélie. Auf der Speisekarte: hausgemachte Pommes frites von Gégé, leckere Savoyer Bretter und... das unumgängliche Fondue! Grillen um 11:30 Uhr."
    ],
    "en": [
      "Traditional chalet on the ski slopes, mountain atmosphere with Gérard and Aurélie. On the menu: Gégé's home-made French fries, tasty Savoyard planks and... the inevitable fondue! Grill at 11:30 a.m."
    ],
    "it": [
      "Chalet tradizionale sulle piste da sci, con un'atmosfera di montagna e Gérard e Aurélie. Nel menu: patatine fritte fatte in casa da Gégé, gustosi piatti savoiardi e... l'immancabile fonduta! Grigliata alle 11.30."
    ],
    "fr": [
      "Chalet traditionnel sur le domaine skiable, ambiance montagne avec Gérard et Aurélie. Au menu : frites maison de Gégé, savoureuses planches savoyardes et... l'incontournable fondue ! Grillades à 11h30."
    ],
    "nl": [
      "Traditioneel chalet op de skipistes, met een bergsfeer en Gérard en Aurélie. Op het menu: de huisgemaakte frieten van Gégé, lekkere Savoyaardse schotels en... de onvermijdelijke fondue! Grillen om 11.30 uur."
    ],
    "es": [
      "Chalet tradicional en las pistas de esquí, con ambiente montañés y Gérard y Aurélie. En el menú: patatas fritas caseras de Gégé, sabrosos platos de Saboya y... ¡la inevitable fondue! Parrilladas a las 11.30 h."
    ]
  },
