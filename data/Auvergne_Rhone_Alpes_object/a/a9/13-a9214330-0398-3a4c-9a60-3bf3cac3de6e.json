  "rdfs:comment": {
    "de": [
      "Ein zeitloser Zwischenstopp im Herzen der Bambuswälder, zwischen Geschmack, Entspannung und Staunen."
    ],
    "en": [
      "The magic of the bamboos in Savoie ... a stone's throw from the \"Jardins Secrets\", between the lakes of Annecy and Le Bourget, Denis, passionate gardener, gathered in Lornay the largest collection of bamboos in the region..."
    ],
    "it": [
      "Una sosta senza tempo nel cuore della foresta di bambù, dove assaporare sapori, rilassarsi e meravigliarsi."
    ],
    "fr": [
      "Une escale hors du temps au cœur des bambous, entre saveurs, détente et émerveillement."
    ],
    "es": [
      "Una parada atemporal en el corazón del bosque de bambú, donde podrá degustar sabores, relajarse y maravillarse."
    ],
    "nl": [
      "Een tijdloze tussenstop in het hart van het bamboebos, waar je kunt genieten van smaken, ontspannen en je verwonderen."
    ]
  },
