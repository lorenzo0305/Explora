  "rdfs:comment": {
    "de": [
      "Willkommen bei Ker Annick, einer traditionellen Crêperie und Eisdiele im Herzen des Viertels Saint-Jacques.\r\nHier finden Sie hausgemachte Buchweizenpfannkuchen und Weizencrêpes, eine Cidre-Bar und 26 verschiedene Sorten handgemachtes Eis."
    ],
    "en": [
      "Welcome to Ker Annick, a traditional crêperie and ice-cream parlour in the heart of the Saint-Jacques district.\r\nHome-made galettes de sarrazin and crêpes de froment, cider bar, 26 flavors of artisanal ice creams."
    ],
    "it": [
      "Benvenuti a Ker Annick, una crêperie e gelateria tradizionale nel cuore del quartiere Saint-Jacques.\r\nFrittelle di grano saraceno e di frumento fatte in casa, bar del sidro, 26 gusti di gelati artigianali."
    ],
    "fr": [
      "Bienvenue chez Ker Annick, une crêperie traditionnelle et glacier en plein cœur du quartier Saint-Jacques. \r\nGalettes de sarrazin et crêpes de froment préparées maison, bar à cidres, 26 parfums de glaces artisanales."
    ],
    "nl": [
      "Welkom bij Ker Annick, een traditionele crêperie en ijssalon in het hart van de wijk Saint-Jacques.\r\nHuisgemaakte boekweit- en tarwepannenkoeken, ciderbar, 26 smaken huisgemaakt ijs."
    ],
    "es": [
      "Bienvenido a Ker Annick, crepería y heladería tradicional en el corazón del barrio de Saint-Jacques.\r\nTortitas caseras de trigo sarraceno y trigo, sidrería, 26 sabores de helados artesanos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Crêperie-glacier Ker Annick"
    ]
  },
