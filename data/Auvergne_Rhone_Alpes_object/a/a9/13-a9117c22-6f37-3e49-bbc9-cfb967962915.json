  "rdfs:comment": {
    "de": [
      "Das in einer Ebene gelegene und von Hügeln umgebene Dorf Parnans im Osten von Romans hat seine ländliche Berufung bewahrt und achtet sehr auf den Schutz des Ortes und der Umwelt."
    ],
    "en": [
      "Situated on a plain and surrounded by hills, the village of Parnans, to the east of Romans, has managed to preserve its rural vocation and is very vigilant about protecting the site and the environment."
    ],
    "it": [
      "Situato in pianura e circondato da colline, il villaggio di Parnans, a est di Romans, ha saputo conservare la sua vocazione rurale e ha prestato grande attenzione alla tutela del sito e dell'ambiente."
    ],
    "fr": [
      "Situé dans une plaine et entouré de collines, le village de Parnans, à l'est de Romans, a su conserver sa vocation rurale et a fait preuve d'une grande vigilance quant à la protection du site et de l'environnement."
    ],
    "es": [
      "Situado en una llanura y rodeado de colinas, el pueblo de Parnans, al este de Romans, ha sabido conservar su vocación rural y se ha esmerado en proteger el lugar y el medio ambiente."
    ],
    "nl": [
      "Het dorp Parnans, ten oosten van Romans, ligt op een vlakte en wordt omringd door heuvels. Het heeft zijn landelijke karakter weten te behouden en is zeer waakzaam wat betreft de bescherming van de locatie en het milieu."
    ]
  },
