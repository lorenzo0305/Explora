  "rdfs:comment": {
    "de": [
      "Und warum nicht unsere Vorurteile über die Rollenverteilung zwischen Vätern und Müttern sanft über den Haufen werfen?"
    ],
    "en": [
      "And why not gently shake up our preconceptions about the division of roles between moms and dads?"
    ],
    "it": [
      "E perché non sfidare delicatamente i nostri preconcetti sulla divisione dei ruoli tra mamme e papà?"
    ],
    "fr": [
      "Et pourquoi pas bousculer gentiment nos a priori sur la répartition des rôles entre les papas et les mamans ?"
    ],
    "es": [
      "¿Y por qué no cuestionar con delicadeza nuestras ideas preconcebidas sobre el reparto de papeles entre madres y padres?"
    ],
    "nl": [
      "En waarom zouden we onze vooroordelen over de rolverdeling tussen vaders en moeders niet voorzichtig uitdagen?"
    ]
  },
