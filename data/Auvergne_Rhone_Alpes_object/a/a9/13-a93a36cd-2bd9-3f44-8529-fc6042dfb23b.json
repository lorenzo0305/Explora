  "rdfs:comment": {
    "de": [
      "Der Montrigon-Stausee ist ein friedlicher Ort, der weniger als 1 km vom BSM-Zentrum entfernt liegt. Er ist ideal für Familien- und Entspannungsangeln."
    ],
    "en": [
      "The Montrigon reservoir is a peaceful place less than 1 km from the centre of BSM. It is ideal for family fishing and relaxation."
    ],
    "it": [
      "Il bacino di Montrigon è un luogo tranquillo a meno di 1 km dal centro di BSM. È ideale per la pesca in famiglia e il relax."
    ],
    "fr": [
      "La retenue de Montrigon est un endroit paisible à moins d'1 km du centre de BSM. Elle est idéale pour une pêche en famille et de détente."
    ],
    "nl": [
      "Het stuwmeer van Montrigon is een rustige plek op minder dan 1 km van het centrum van BSM. Het is ideaal om met het gezin te vissen en te ontspannen."
    ],
    "es": [
      "El embalse de Montrigon es un lugar tranquilo a menos de 1 km del centro de BSM. Es ideal para pescar en familia y relajarse."
    ]
  },
