  "rdfs:comment": {
    "de": [
      "Genießen Sie traditionelle Küche in einer ungewöhnlichen Umgebung, in einer entweihten Kapelle in einem ehemaligen Kloster aus dem 17."
    ],
    "en": [
      "Enjoy traditional cuisine in an unusual setting, in a desecrated chapel nestled in a former 17th-century convent in the heart of the medieval town of Charlieu."
    ],
    "it": [
      "Gustate la cucina tradizionale in un ambiente insolito, in una cappella sconsacrata che si trova in un ex convento del XVII secolo nel cuore della città medievale di Charlieu."
    ],
    "fr": [
      "Savourez une cuisine traditionnelle dans un décor insolite, au sein d'une chapelle désacralisée nichée dans un ancien couvent du XVIIe siècle, se situant au cœur de la cité médiévale de Charlieu."
    ],
    "nl": [
      "Geniet van traditionele gerechten in een ongewone omgeving, in een ontheiligde kapel in een voormalig 17e-eeuws klooster in het hart van de middeleeuwse stad Charlieu."
    ],
    "es": [
      "Disfrute de la cocina tradicional en un marco insólito, en una capilla desacralizada situada en un antiguo convento del siglo XVII, en el corazón de la ciudad medieval de Charlieu."
    ]
  },
  "rdfs:label": {
