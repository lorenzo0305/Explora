  "rdfs:comment": {
    "de": [
      "Treten Sie wie im Fernsehen in einem überraschenden und immersiven Quiz gegeneinander an und erleben Sie ein spannendes Erlebnis! Tausende von Fragen in verschiedenen Themenbereichen: Sport, Filme und Serien, Musik, Popkultur, Schule, Disney."
    ],
    "en": [
      "Challenge yourselves to a surprising and immersive quiz, just like on TV! Thousands of questions in a variety of themes: Sports, Movies & Series, Music, Pop Culture, School and Disney."
    ],
    "it": [
      "Mettetevi alla prova come in TV in un quiz sorprendente e coinvolgente per un'esperienza superlativa! Migliaia di domande suddivise in una varietà di temi: sport, film e serie, musica, cultura pop, scuola e Disney."
    ],
    "fr": [
      "Affrontez vous comme à la télé dans un quiz surprenant et immersif pour une expérience survoltée ! Des milliers de questions réparties dans des thèmes variés : Sports, films et séries, Musique, Culture Pop, Scolaire, Disney."
    ],
    "nl": [
      "Neem het tegen elkaar op zoals op tv in een verrassende en meeslepende quiz voor een superervaring! Duizenden vragen verdeeld over verschillende thema's: Sport, films en series, Muziek, Popcultuur, School en Disney."
    ],
    "es": [
      "Enfréntate a los demás como lo harías en la televisión en un concurso sorprendente y envolvente para vivir una experiencia sobrealimentada Miles de preguntas divididas en una variedad de temas: Deportes, películas y series, Música, Cultura Pop, Escuela y Disney."
    ]
  },
