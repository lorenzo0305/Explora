        "de": [
          "Verkauf von Bouchot-Muscheln aus der Baie de Somme, Garnelen, Salicornes und Jakobsmuscheln je nach Saison."
        ],
        "en": [
          "Sale of Bouchot mussels from the Baie de Somme, shrimps, salicornia and scallops, depending on the season."
        ],
        "it": [
          "Cozze Bouchot della Baie de Somme, gamberi, salicornia e capesante in vendita, a seconda della stagione."
        ],
        "fr": [
          "Vente de moules de bouchot de la Baie de Somme, crevettes, salicornes et noix de Saint-Jacques selon les périodes."
        ],
        "es": [
          "Venta de mejillones Bouchot de la Bahía de Somme, gambas, salicornia y vieiras, según la temporada."
        ],
        "nl": [
