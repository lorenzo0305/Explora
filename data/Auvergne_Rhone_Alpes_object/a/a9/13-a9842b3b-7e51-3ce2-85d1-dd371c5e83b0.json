  "rdfs:comment": {
    "de": [
      "Sie werden herzlich empfangen und können in einer ungewöhnlichen Umgebung leckere savoyische, italienische und traditionelle Gerichte genießen. Neben Menüs und Mahlzeiten à la carte werden verschiedene Verpflegungsarten angeboten."
    ],
    "en": [
      "La Grange restaurant serves a variety of Savoyard, Italian and traditional dishes in a unique setting, with the theme of “Savoyard cattle”. Carefully-prepared, varied cuisine – Pizzas to eat in"
    ],
    "it": [
      "Atmosfera conviviale. Questo ristorante, dall’arredamento unico ispirato al tema della “vacca savoiarda”, propone ricette regionali, italiane e tradizionali. Cucina variegata e curata - Pizze (anche da asporto) - Terrazza soleggiata - Ai piedi delle piste."
    ],
    "fr": [
      "Vous serez accueillis chaleureusement pour déguster de bons petits plats savoyards, italiens et traditionnels, dans un décor insolite. Différentes formules de restauration sont proposées en plus des menus et repas à la carte."
    ],
    "nl": [
      "U wordt hartelijk ontvangen om in een ongewoon kader goede Savoyaardse, Italiaanse en traditionele gerechten te proeven. Naast de à la carte menu's en maaltijden zijn er verschillende cateringmogelijkheden."
    ],
    "es": [
      "Le acogerán calurosamente para degustar buenos platos saboyanos, italianos y tradicionales en un marco insólito. Además de los menús y las comidas a la carta, se ofrecen varias opciones de catering."
    ]
  },
