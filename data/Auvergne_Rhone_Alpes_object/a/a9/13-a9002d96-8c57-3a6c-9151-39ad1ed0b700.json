  "rdfs:comment": {
    "de": [
      "Eine Fassade in Orangetönen in der Ortschaft Chevagnes?  Das ist Le Goût des Choses! Ein kleines, kokettes und gemütliches Restaurant für einen gastronomischen Zwischenstopp, den Sie sich nicht entgehen lassen sollten."
    ],
    "en": [
      "A facade in orange tones in the village of Chevagnes ?  It's the Taste of Things! A small, cosy restaurant for a gastronomic stopover not to be missed."
    ],
    "it": [
      "Una facciata dai toni arancioni nel villaggio di Chevagnes?  È il gusto delle cose! Un piccolo e accogliente ristorante per una sosta gastronomica da non perdere."
    ],
    "fr": [
      "Une façade dans les tons orangés dans le bourg de Chevagnes ?...  C'est le Goût des Choses ! Un petit restaurant coquet et douillet pour une étape gastronomique à ne pas manquer."
    ],
    "es": [
      "¿Una fachada en tonos anaranjados en el pueblo de Chevagnes?  ¡Es el sabor de las cosas! Un pequeño y acogedor restaurante para una parada gastronómica imperdible."
    ],
    "nl": [
      "Een gevel in oranje tinten in het dorp Chevagnes?  Het is de smaak van de dingen! Een klein, gezellig restaurant voor een niet te missen gastronomische tussenstop."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Goût des Choses"
    ]
  },
