  "rdfs:comment": {
    "de": [
      "Auf dieser anspruchsvollen Tour gelangen Sie nach Grand Plateau und steigen dann auf der Seite von Valmeinier wieder ab, um das Tal des grünen Sees zu entdecken. Sie haben die Möglichkeit, die Skilifte zu benutzen, um sich einen Teil des Aufstiegs zu ersparen."
    ],
    "en": [
      "This demanding circuit will allow you to arrive at Grand Plateau then to descend towards Valmeinier to discover the valley of the green lake. You have the possibility of taking the ski lifts in order to save part of the climb."
    ],
    "it": [
      "Questo circuito impegnativo vi porterà a Grand Plateau e poi a Valmeinier per scoprire la valle del Lac Vert. È possibile utilizzare gli impianti di risalita per risparmiare parte della salita."
    ],
    "fr": [
      "Ce circuit exigeant vous permettra d'arriver à Grand Plateau puis de redescendre du côté de Valmeinier pour découvrir la vallée du lac vert. Vous avez la possibilité d'emprunter les remontées mécaniques afin d'économiser une partie de la montée."
    ],
    "es": [
      "Este exigente circuito le llevará a Grand Plateau y luego de vuelta a Valmeinier para descubrir el valle del Lac Vert. Puedes utilizar los remontes para ahorrarte parte de la subida."
    ],
    "nl": [
      "Deze veeleisende route brengt je naar Grand Plateau en daalt dan weer af naar Valmeinier om de Lac Vert vallei te ontdekken. Je kunt de skiliften gebruiken om een deel van de klim uit te sparen."
    ]
  },
  "rdfs:label": {
    "de": [
      "Aufstieg Grand Plateau, Abfahrt über den grünen See von Valmeinier - Mountainbike / VTTAE-Route"
    ],
    "ru": [
      "Подъем на Гранд Плато, спуск через зеленое озеро Вальмейнье - маршрут MTB / ATB"
    ],
    "en": [
      "Ascent Grand Plateau, descent to Valmeinier's green lake - Mountain bike / ATV itinerary"
    ],
    "it": [
      "Salita al Grand Plateau, discesa attraverso il lago verde di Valmeinier - percorso MTB / ATB"
    ],
    "fr": [
      "Montée Grand Plateau, descente par le lac vert de Valmeinier - Itinéraire de VTT / VTTAE"
    ],
    "zh": [
      "上大高原，下瓦尔梅尼耶绿湖--山地车/全地形车路线"
    ],
    "nl": [
      "Beklimming Grand Plateau, afdaling via het groene meer van Valmeinier - MTB / ATB route"
    ],
    "es": [
      "Ascenso Grand Plateau, descenso por el lago verde de Valmeinier - Ruta MTB / ATB"
    ]
  },
