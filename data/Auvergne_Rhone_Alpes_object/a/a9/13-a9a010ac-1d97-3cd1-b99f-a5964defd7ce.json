  "rdfs:comment": {
    "de": [
      "Das Shooters ist DIE unumgängliche Bar in Avoriaz! Geöffnet von 17h bis 2h, festliche Atmosphäre, Live-Musik, DJ-Sets und über 40 Shooters. Burger und Cocktails zum Genießen in einer elektrisierenden Atmosphäre. Happy Hour von 17 Uhr bis 18.30 Uhr."
    ],
    "en": [
      "Shooters is the must-visit bar in Avoriaz! Open from 5:00 pm to 2:00 am, it offers a festive atmosphere with live music, DJ sets and over 40 different shooters. Enjoy burgers and cocktails in an electrifying vibe.\r\nHappy hour from 5:00 pm to 6:30 pm."
    ],
    "it": [
      "Lo Shooters è il bar da non perdere ad Avoriaz! Aperto dalle 17.00 alle 2.00, con un'atmosfera festosa, musica dal vivo, DJ set e oltre 40 shooters. Hamburger e cocktail da gustare in un'atmosfera elettrizzante. Happy hour dalle 17.00 alle 18.30."
    ],
    "fr": [
      "Le Shooters est  LE bar incontournable d’Avoriaz ! Ouvert de 17h à 2h, ambiance festive, musique live, DJ sets et plus de 40 shooters. Burgers et cocktails à savourer dans une atmosphère électrisante. Happy hour de 17h à 18h30."
    ],
    "nl": [
      "Shooters is dé onmisbare bar van Avoriaz! Geopend van 17.00 tot 02.00 uur, met een feestelijke sfeer, livemuziek, DJ-sets en meer dan 40 verschillende shooters. Geniet van burgers en cocktails in een energieke ambiance.\r\nHappy hour van 17.00 tot 18.30 uur."
    ],
    "es": [
      "El Shooters es EL bar de Avoriaz que no se puede perder Abierto de 17:00 a 2:00, con un ambiente festivo, música en directo, sesiones de DJ y más de 40 chupitos. Hamburguesas y cócteles para degustar en un ambiente electrizante. Happy hour de 17:00 a 18:30."
    ]
  },
