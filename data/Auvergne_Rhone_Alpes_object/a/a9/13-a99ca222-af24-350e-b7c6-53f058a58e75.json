  "rdfs:comment": {
    "de": [
      "Ein 4-Sterne-Hotel mit idealer Lage am strategischen Punkt der wichtigsten Abfahrten und Ankünfte der Pisten mit 40 Zimmern in modernem Stil. Ausgezeichnetes Preis-Leistungs-Verhältnis am Fuße des größten Skigebiets der Welt: Les 3 Vallées."
    ],
    "en": [
      "A 4-star hotel ideally located at the strategic point of the main slope departures and arrivals, with 40 rooms in a modern style. Excellent value for money at the foot of the world's largest ski area: the 3 Valleys."
    ],
    "it": [
      "Un hotel a 4 stelle idealmente situato nel punto strategico delle partenze e degli arrivi delle piste principali, con 40 camere in stile moderno. Ottimo rapporto qualità-prezzo ai piedi del comprensorio sciistico più grande del mondo: le 3 Valli."
    ],
    "fr": [
      "Un hôtel 4 étoiles idéalement situé au point stratégique des principaux départs et arrivées des pistes de 40 chambres dans un style moderne. Excellent rapport qualité/prix au pied du plus grand domaine skiable du monde : les 3 Vallées."
    ],
    "es": [
      "Un hotel de 4 estrellas idealmente situado en el punto estratégico de las principales salidas y llegadas de pistas, con 40 habitaciones de estilo moderno. Excelente relación calidad-precio al pie del dominio esquiable más grande del mundo: los 3 Valles."
    ],
    "nl": [
      "Een 4-sterrenhotel met een ideale ligging op het strategische punt van de belangrijkste vertrek- en aankomstpistes, met 40 kamers in een moderne stijl. Uitstekende prijs-kwaliteitverhouding aan de voet van het grootste skigebied ter wereld: de 3 Valleien."
    ]
  },
