  "rdfs:comment": {
    "de": [
      "Das Rathaus von Chabeuil öffnet seine Türen von Montag bis Freitag in seinem wunderschönen neogotischen Rathaus, das 1877 erbaut wurde. Der 1903 errichtete Glockenturm, der vom Palazzio Vecchio in Florenz inspiriert wurde, diente als Vorlage für das Logo der Stadt."
    ],
    "en": [
      "Chabeuil Town Hall is open Monday to Friday, in a magnificent neo-Gothic town hall built in 1877. Its bell tower, inspired by Florence's Palazzio Vecchio and built in 1903, was a major inspiration for the town's logo."
    ],
    "it": [
      "Il Municipio di Chabeuil è aperto ai visitatori dal lunedì al venerdì, in un magnifico municipio neogotico costruito nel 1877. Il suo campanile, ispirato al Palazzo Vecchio di Firenze e costruito nel 1903, è stato una delle principali fonti di ispirazione per il logo della città."
    ],
    "fr": [
      "La mairie de Chabeuil vous ouvre ses portes du lundi au vendredi, dans son magnifique hôtel de ville de style néogothique, bâti en 1877. Son campanile, inspiré du Palazzio Vecchio de Florence et édifié en 1903 a grandement inspiré le logo de la ville."
    ],
    "nl": [
      "Het stadhuis van Chabeuil is van maandag tot en met vrijdag te bezichtigen in een prachtig neogotisch stadhuis uit 1877. De klokkentoren, geïnspireerd op het Palazzio Vecchio in Florence en gebouwd in 1903, was een belangrijke inspiratie voor het logo van de stad."
    ],
    "es": [
      "Ayuntamiento neogotico construido en 1877 y su Torre à la Izquierda !"
    ]
  },
