  "rdfs:comment": {
    "de": [
      "Als naturalistische Künstlerin zeichnet Gabi Calaca lokale Vögel in verschiedenen Formaten: Bücher, Postkarten und mehr sind auf ihrer Website und auf dem Markt in Maurs am Donnerstagmorgen zu entdecken!"
    ],
    "en": [
      "Gabi Calaca is a naturalist artist who draws local birds in a variety of formats, including books, postcards and more, which you can discover on her website and at the Maurs market on Thursday mornings!"
    ],
    "it": [
      "Gabi Calaca è un'artista naturalista che disegna uccelli locali in diversi formati, tra cui libri, cartoline e altro, che potete scoprire sul suo sito web e al mercato Maurs il giovedì mattina!"
    ],
    "fr": [
      "Artiste naturaliste, Gabi Calaca dessine les oiseaux locaux sous différents formats : livres, cartes postales et autres à découvrir sur son site internet et sur le marché de Maurs le jeudi matin !"
    ],
    "nl": [
      "Gabi Calaca is een natuurkunstenaar die lokale vogels tekent in verschillende formaten, waaronder boeken, ansichtkaarten en meer, die je kunt ontdekken op haar website en op de Maurs markt op donderdagochtend!"
    ],
    "es": [
      "Gabi Calaca es una artista naturalista que dibuja aves locales en diversos formatos, como libros, postales y mucho más, que podrás descubrir en su página web y en el mercado de Maurs los jueves por la mañana"
    ]
  },
  "rdfs:label": {
    "en": [
