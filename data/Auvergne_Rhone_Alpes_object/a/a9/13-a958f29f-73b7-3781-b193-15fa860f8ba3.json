  "rdfs:comment": {
    "de": [
      "Die im Januar 2014 gegründete Communauté de Communes du Crestois et du Pays de Saillans - Cœur de Drôme umfasst 15 Gemeinden. Sie liegt im Herzen der Drôme, erstreckt sich über eine Fläche von 234 km2 und hat rund 15.000 Einwohner."
    ],
    "en": [
      "Created in January 2014, the Communauté de Communes du Crestois et du Pays de Saillans - Cœur de Drôme comprises 15 communes. In the heart of the Drôme, it covers 234 km2 and has a population of around 15,000."
    ],
    "it": [
      "Creata nel gennaio 2014, la Communauté de Communes du Crestois et du Pays de Saillans - C?ur de Drôme comprende 15 comuni. Nel cuore della Drôme, si estende per 234 km2 e ha una popolazione di circa 15.000 abitanti."
    ],
    "fr": [
      "Créée en janvier 2014, la Communauté de Communes du Crestois et du Pays de Saillans - Cœur de Drôme regroupe 15 communes. Au cœur de la Drôme, elle s’étend sur 234 km2 et compte environ 15 000 habitants."
    ],
    "nl": [
      "De Communauté de Communes du Crestois et du Pays de Saillans - Cœur de Drôme werd opgericht in januari 2014 en bestaat uit 15 gemeenten. Het ligt in het hart van de Drôme, beslaat 234 km2 en heeft ongeveer 15.000 inwoners."
    ],
    "es": [
      "Creada en enero de 2014, la Communauté de Communes du Crestois et du Pays de Saillans - Cœur de Drôme comprende 15 municipios. En el corazón de la Drôme, tiene una superficie de 234 km2 y una población de aproximadamente 15.000 habitantes."
    ]
  },
