  "rdfs:comment": {
    "de": [
      "Albiez Bike School, das ist ein Team von Mountainbike-Lehrern, die motiviert sind, Ihnen im Sommer wie im Winter schöne Erlebnisse auf Ihrem Mountainbike zu bieten. Sie passen sich Ihren Wünschen an, ihr Ziel ist es, dass Sie eine gute Zeit in einer außergewöhnlichen Umgebung verbringen."
    ],
    "en": [
      "Albiez Bike School is a team of mountain bike instructors motivated to give you the best thrills on your mountain bike in summer and winter alike. They'll adapt to your needs, and their aim is to make sure you have a great time in an exceptional setting."
    ],
    "it": [
      "Albiez Bike School è un team di istruttori di mountain bike motivati a regalarvi grandi emozioni in sella alla vostra mountain bike, sia in estate che in inverno. Si adatteranno ai vostri desideri e il loro obiettivo è quello di farvi divertire in un ambiente eccezionale."
    ],
    "fr": [
      "Albiez Bike School, c'est une équipe de moniteurs VTT motivée pour vous offrir de belles sensations sur votre VTT été comme hiver. Ils s'adaptent à vos envies, leur objectif est de vous faire passer un bon moment dans un cadre exceptionnel."
    ],
    "nl": [
      "Albiez Bike School is een team van mountainbike-instructeurs die gemotiveerd zijn om je zowel in de zomer als in de winter geweldige sensaties op je mountainbike te bezorgen. Ze passen zich aan jouw wensen aan en hun doel is om je een geweldige tijd te bezorgen in een uitzonderlijke omgeving."
    ],
    "es": [
      "Albiez Bike School es un equipo de monitores de bicicleta de montaña motivados para proporcionarte grandes emociones sobre tu bicicleta de montaña tanto en verano como en invierno. Se adaptarán a tus deseos y su objetivo es que te lo pases en grande en un entorno excepcional."
    ]
  },
  "rdfs:label": {
    "en": [
      "Mustang - Albiez Bike School"
    ],
    "fr": [
      "Mustang - Albiez Bike School"
    ]
  },
