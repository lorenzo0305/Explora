  "rdfs:comment": {
    "de": [
      "Das auf dem Salève gelegene Les Marches de la Croisette bietet eine traditionelle und gesellige Küche, die aus lokalen Produkten zubereitet wird. Ein Gourmet-Stopp, der wegen seiner Bergkulisse und der außergewöhnlichen Aussicht auf den Mont-Blanc geschätzt wird."
    ],
    "en": [
      "Perched high on the Salève, Les Marches de la Croisette offers traditional, convivial cuisine made from local produce. A gourmet stopover appreciated for its mountain setting and exceptional view of Mont Blanc."
    ],
    "it": [
      "Arroccato sulla Salève, Les Marches de la Croisette propone una cucina tradizionale e accogliente a base di prodotti locali. Una tappa gastronomica apprezzata per il suo ambiente montano e la vista eccezionale sul Monte Bianco."
    ],
    "fr": [
      "Perché sur le Salève, Les Marches de la Croisette propose une cuisine traditionnelle et conviviale, élaborée à partir de produits locaux. Une halte gourmande appréciée pour son cadre montagnard et sa vue exceptionnelle sur le Mont-Blanc."
    ],
    "es": [
      "Situado en lo alto de la Salève, Les Marches de la Croisette sirve una cocina tradicional y acogedora elaborada con productos locales. Una parada gastronómica apreciada por su entorno montañoso y su excepcional vista del Mont Blanc."
    ],
    "nl": [
      "Les Marches de la Croisette ligt hoog op de Salève en serveert traditionele, vriendelijke gerechten gemaakt van lokale producten. Een gastronomische tussenstop die gewaardeerd wordt vanwege de ligging in de bergen en het uitzonderlijke uitzicht op de Mont Blanc."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les marches de la Croisette"
