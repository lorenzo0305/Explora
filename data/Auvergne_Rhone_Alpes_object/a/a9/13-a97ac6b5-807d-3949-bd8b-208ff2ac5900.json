  "rdfs:comment": {
    "de": [
      "Entdecken Sie unsere Region auf den Wegen des Mittelgebirges bei Ausflügen mit einem geländegängigen Elektroroller für Erwachsene und Jugendliche ab 14 Jahren. 2-stündige Aktivität."
    ],
    "en": [
      "Discover our region by exploring mid-mountain trails on an all-terrain electric scooter for adults and young people aged 14 and over. 2-hour activity."
    ],
    "it": [
      "Scoprite la nostra regione esplorando i sentieri di media montagna a bordo di uno scooter elettrico fuoristrada per adulti e giovani a partire dai 14 anni. Attività di 2 ore."
    ],
    "fr": [
      "Découverte de notre région en parcourant les sentiers de moyenne montagne lors de balades en trottinette électrique tout terrain pour adultes et jeunes dès 14 ans. 2h d'activité."
    ],
    "nl": [
      "Ontdek onze regio door de bergpaden in het middengebergte te verkennen op een all-terrain elektrische step voor volwassenen en jongeren vanaf 14 jaar. 2 uur durende activiteit."
    ],
    "es": [
      "Descubra nuestra región recorriendo los senderos de media montaña en un scooter eléctrico todo terreno para adultos y jóvenes a partir de 14 años. Actividad de 2 horas."
    ]
  },
  "rdfs:label": {
