  "rdfs:comment": {
    "de": [
      "Bio-Buchweizenmehl aus Frankreich. Bio-Weizenmehl aus altem Saatgut.\r\nLokale Produkte (Reblochon, Gemüse, handwerklich gebrautes Bier). Bio-Mehl aus der Bretagne. Herzhafte und süße Galettes. Crêpes. Eiscreme. Bretonischer Cidre."
    ],
    "en": [
      "French organic buckwheat flour. Organic wheat flour. \r\nLocal products (reblochon, organic vegetables, craft beers). Organic flour from Brittany. Savory and sweet pancakes. Crepes. Ice cream."
    ],
    "it": [
      "Farina di grano saraceno biologico francese. Farina di grano antico biologico.\r\nProdotti locali (reblochon, verdure, birre artigianali). Farine biologiche della Bretagna. Galette salate e dolci. Frittelle. Gelati. Sidro bretone."
    ],
    "fr": [
      "Farine de sarrasin bio française. Farine de froment bio ancienne semence.\r\nProduits locaux (reblochon, légumes, bières artisanales). Farines bio de Bretagne. Galettes salées et sucrées. Crêpes. Glaces. Cidre breton."
    ],
    "es": [
      "Harina de trigo sarraceno ecológico francés. Harina de trigo ecológico de semillas antiguas.\r\nProductos locales (reblochon, verduras, cervezas artesanales). Harinas ecológicas de Bretaña. Galettes saladas y dulces. Tortitas. Helados. Sidra bretona."
    ],
    "nl": [
      "Frans biologisch boekweitmeel. Oudzadig biologisch tarwemeel.\r\nLokale producten (reblochon, groenten, ambachtelijke bieren). Biologisch meel uit Bretagne. Hartige en zoete galettes. Pannenkoeken. Ijsjes. Bretonse cider."
    ]
  },
