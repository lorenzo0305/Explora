  "rdfs:comment": {
    "de": [
      "Willkommen in \"La Casa de L'Ours\", um einen Moment der Geselligkeit zu teilen."
    ],
    "en": [
      "La Casa de L’Ours, one place you mustn't miss at the bottom of the slopes in Plagne Villages! Restaurant/Pizzeria, Lounge Bar/Pub, sunny terrace, warm, cosy atmosphere, generous gourmet cuisine, service non-stop 7/7."
    ],
    "it": [
      "Benvenuti a \"La Casa de L'Ours\" per condividere un momento di convivialità."
    ],
    "fr": [
      "Bienvenue à « La Casa de L’Ours » pour partager un moment de convivialité."
    ],
    "nl": [
      "La Casa de l'Ours, onvermijdelijk adres op het sneeuwfront van Plagne Villages!  Restaurant/Pizzeria, Bar/Pub lounge, terras op het zuiden, gezellige en warme omgeving, gulle en gastronomische keuken, non-stop service 7/7."
    ],
    "es": [
      "Bienvenido a \"La Casa de L'Ours\" para compartir un momento de convivencia."
    ]
  },
