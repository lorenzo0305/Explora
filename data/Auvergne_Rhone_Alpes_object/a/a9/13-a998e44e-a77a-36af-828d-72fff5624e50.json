  "rdfs:comment": {
    "de": [
      "In unserer Küche kommen leckere und authentische Rezepte sowie Qualitätsprodukte aus der Region mit Zutaten ohne Farb- und Konservierungsstoffe zur Geltung, die oftmals biologisch sind und von lokalen Genossenschaften und Bauern stammen."
    ],
    "en": [
      "Our cuisine features gourmet, authentic recipes and quality local produce, with ingredients that are free from colorants and preservatives, often organic and sourced from local farmers and cooperatives."
    ],
    "it": [
      "La nostra cucina presenta autentiche ricette gourmet e prodotti regionali di qualità, con ingredienti privi di coloranti e conservanti, spesso biologici e provenienti da agricoltori e cooperative locali."
    ],
    "fr": [
      "Notre cuisine met en valeur des recettes gourmandes et authentiques ainsi, des produits de qualité de la région avec des ingrédients sans colorants ni conservateurs, souvent bio et issus des coopératives et agriculteurs locaux."
    ],
    "nl": [
      "Onze keuken staat in het teken van authentieke gastronomische recepten en regionale kwaliteitsproducten, met ingrediënten die vrij zijn van kleurstoffen en conserveringsmiddelen, vaak biologisch en afkomstig van lokale boeren en coöperaties."
    ],
    "es": [
      "Nuestra cocina presenta auténticas recetas gourmet y productos regionales de calidad, con ingredientes sin colorantes ni conservantes, a menudo ecológicos y procedentes de agricultores y cooperativas locales."
    ]
  },
