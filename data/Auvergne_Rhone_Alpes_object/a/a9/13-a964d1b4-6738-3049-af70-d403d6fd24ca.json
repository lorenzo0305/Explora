  "rdfs:comment": {
    "de": [
      "Steigern Sie Ihr Wohlbefinden durch tänzerische Bewegung! Sie müssen nicht tanzen können: Kommen Sie einfach so, wie Sie sind, und erkunden Sie die Workshops von Danse de Plein Potentiel en art-thérapie."
    ],
    "en": [
      "Improve your well-being through dance movement! You don't need to know how to dance: just come as you are and explore the Full Potential Dance in art therapy workshops."
    ],
    "it": [
      "Migliorate il vostro benessere attraverso il movimento della danza! Non è necessario saper ballare: venite come siete ed esplorate il pieno potenziale della danza nei laboratori di arteterapia."
    ],
    "fr": [
      "Améliorez votre bien-être par le mouvement dansé ! Pas besoin de savoir danser : venez comme vous êtes et explorez les ateliers de Danse de Plein Potentiel en art-thérapie."
    ],
    "es": [
      "¡Mejora tu bienestar a través del movimiento de la danza! No necesitas saber bailar: ven como eres y explora el Full Potential Dance en los talleres de arteterapia."
    ],
    "nl": [
      "Verbeter je welzijn door dansbeweging! Je hoeft niet te weten hoe je moet dansen: kom zoals je bent en ontdek het Volledig Potentieel Dans in kunstzinnige therapie workshops."
    ]
  },
