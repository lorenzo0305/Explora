  "rdfs:comment": {
    "de": [
      "Nach einer erfolgreichen Tournee 2025 durch Frankreich kehrt der französische Zirkusgigant, der neue Zirkus Zavatta, 2026 mit seiner neuen futuristischen und innovativen Show \"elektrisierend\" mit voller Kraft zurück."
    ],
    "en": [
      "Fresh from a highly successful tour of France in 2025, French circus giant Le nouveau cirque Zavatta is back with a vengeance in 2026 with its futuristic and innovative \"electrifying\" show."
    ],
    "it": [
      "Forte di una tournée di grande successo in Francia nel 2025, il gigante del circo francese, il nuovo circo Zavatta, torna in forze nel 2026 con il suo futuristico e innovativo spettacolo \"elettrizzante\"."
    ],
    "fr": [
      "Fort d'une tournée 2025 couronnée de succès à travers l'hexagone, le géant du cirque français, le nouveau cirque Zavatta, revient en force en 2026 avec son nouveau spectacle futuriste et innovant \"électrisant\"."
    ],
    "es": [
      "Tras una exitosa gira por Francia en 2025, el gigante del circo francés, el nuevo circo Zavatta, vuelve a la carga en 2026 con su espectáculo \"electrizante\", futurista e innovador."
    ],
    "nl": [
      "Na een zeer succesvolle tournee door Frankrijk in 2025 is de reus van het Franse circus, het nieuwe circus Zavatta, in 2026 weer van de partij met zijn futuristische en innovatieve \"elektriserende\" show."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Nouveau cirque Zavatta"
    ]
  },
