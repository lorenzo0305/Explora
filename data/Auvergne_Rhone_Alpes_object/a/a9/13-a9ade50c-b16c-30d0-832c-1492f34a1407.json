  "rdfs:comment": {
    "de": [
      "Treffpunkt in Les Estables für die 3. Guinguette Fermière!\r\nEntdecken Sie lokale Handwerker und Produzenten auf dem Nachtmarkt, die Feuershow und genießen Sie einen Moment bei Musik. Verpflegung vor Ort, Getränkestand."
    ],
    "en": [
      "Join us in Les Estables for the 3rd Guinguette Fermière!\r\nDiscover local craftsmen and producers at the night market, the fire show and enjoy a musical moment. On-site catering and refreshments."
    ],
    "it": [
      "Venite a Les Estables per la 3ª Guinguette Fermière!\r\nScoprite gli artigiani e i produttori locali al mercato notturno, assistete allo spettacolo pirotecnico e godetevi la musica. Cibo e bevande sul posto."
    ],
    "fr": [
      "Rendez-vous aux Estables pour la 3ème Guinguette Fermière ! \r\nDécouvrez des artisans et producteurs locaux lors du marché nocturne, le spectacle de feu et profitez d'un moment en musique. Restauration sur place, buvette."
    ],
    "es": [
      "¡Venga a Les Estables para asistir a la 3ª Guinguette Fermière!\r\nDescubra a los artesanos y productores locales en el mercado nocturno, asista al espectáculo de fuegos artificiales y disfrute de la música. Comida y refrescos in situ."
    ],
    "nl": [
      "Kom naar Les Estables voor de 3e Guinguette Fermière!\r\nOntdek lokale ambachtslieden en producenten op de avondmarkt, bekijk de vuurwerkshow en geniet van de muziek. Eten en drinken ter plaatse."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Guinguette Fermière - marché nocturne"
    ]
  },
