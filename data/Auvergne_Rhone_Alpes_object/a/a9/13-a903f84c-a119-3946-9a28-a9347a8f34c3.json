  "rdfs:comment": {
    "de": [
      "Das Félix Café hält eine großzügige Familienküche für Sie bereit, die Sie je nach Jahreszeit in einem warmen und geselligen Rahmen entdecken können."
    ],
    "en": [
      "Come along to Félix Café and enjoy hearty home-cooked dishes using seasonal produce in a warm and friendly setting. The dish of the day menu changes every day of the week."
    ],
    "it": [
      "Il Félix Café offre una generosa cucina familiare da scoprire secondo le stagioni in un ambiente caldo e accogliente."
    ],
    "fr": [
      "Le Félix Café vous réserve une cuisine familiale et généreuse à découvrir au fil des saisons dans un cadre chaleureux et convivial."
    ],
    "nl": [
      "Het Félix Café biedt een royale familiekeuken die u naargelang de seizoenen kunt ontdekken in een warm en vriendelijk kader."
    ],
    "es": [
      "El Café Félix ofrece una generosa cocina familiar que se descubre según las estaciones en un entorno cálido y acogedor."
    ]
  },
