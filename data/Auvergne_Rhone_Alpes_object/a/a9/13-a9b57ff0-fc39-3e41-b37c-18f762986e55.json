  "rdfs:comment": {
    "de": [
      "La Guinguettina ist ein im Sommer geöffneter Ort am Ufer des Allier, wo lokale Produkte serviert werden, mit einem Programm von Sommerveranstaltungen wie Konzerte, Filmvorführungen, Karaoke etc ..."
    ],
    "en": [
      "La Guinguettina is a summertime venue on the banks of the Allier, serving local produce and a program of summer events including concerts, film screenings, karaoke and more."
    ],
    "it": [
      "La Guinguettina è un locale estivo sulle rive dell'Allier che serve prodotti locali, con un programma di eventi estivi che comprende concerti, proiezioni di film, karaoke e altro ancora."
    ],
    "fr": [
      "La Guinguettina est un lieu ouvert l'été au bord de l'Allier, où l’on sert des produits locaux, avec une programmation d'animations estivales tels que des concerts, projections de films, karaoké etc .."
    ],
    "nl": [
      "La Guinguettina is een zomers trefpunt aan de oevers van de Allier waar lokale producten worden geserveerd, met een programma van zomerevenementen zoals concerten, filmvertoningen, karaoke en nog veel meer."
    ],
    "es": [
      "La Guinguettina es un local de verano a orillas del Allier que sirve productos locales, con un programa de eventos estivales que incluye conciertos, proyecciones de películas, karaoke y mucho más."
    ]
  },
