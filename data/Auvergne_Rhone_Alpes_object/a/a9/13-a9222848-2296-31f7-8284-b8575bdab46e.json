  "rdfs:comment": {
    "de": [
      "\"Seit 18 Jahren verarbeiten wir die Schweine und Rinder, die auf unserem Hof in den Montagne Bourbonnaise aufgezogen werden, ohne Farb- und Konservierungsstoffe\"."
    ],
    "en": [
      "\"For 18 years we have been transforming the pigs and cattle raised on our farm in the Montagne Bourbonnaise without colouring agents or preservatives."
    ],
    "it": [
      "\"Da 18 anni lavoriamo suini e bovini allevati nella nostra fattoria nella Montagne Bourbonnaise senza coloranti né conservanti."
    ],
    "fr": [
      "« Depuis 18 ans nous transformons les cochons et les bovins élevés dans notre ferme en Montagne Bourbonnaise sans colorants ni conservateurs»."
    ],
    "nl": [
      "\"Sinds 18 jaar verwerken wij varkens en runderen die op onze boerderij in de Montagne Bourbonnaise zijn gefokt zonder kleurstoffen of conserveringsmiddelen."
    ],
    "es": [
      "\"Desde hace 18 años procesamos cerdos y vacas criados en nuestra granja de la Montaña Bourbonnaise sin colorantes ni conservantes."
    ]
  },
