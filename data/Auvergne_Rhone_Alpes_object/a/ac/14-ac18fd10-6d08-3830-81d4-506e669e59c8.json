  "rdfs:comment": {
    "de": [
      "Jean-Jacques Stannard führt in seiner Werkstatt die Restaurierung von Holzmöbeln durch. Auf Wunsch seiner Kunden kann er auch Möbel nach Maß anfertigen. Ein Ausstellungsraum zeigt seine verschiedenen Arbeiten."
    ],
    "en": [
      "Jean-Jacques Stannard restores wooden furniture in his workshop. He can also create custom-made furniture at his customers' request. A showroom displays his various creations."
    ],
    "it": [
      "Jean-Jacques Stannard restaura mobili in legno nel suo laboratorio e può anche creare mobili su misura su richiesta dei clienti. Uno showroom espone le sue varie creazioni."
    ],
    "fr": [
      "Jean-Jacques Stannard effectue au sein de son atelier la restauration de mobilier en bois. il peut également créer des meubles sur mesure à la demande de ses clients. Une salle d'exposition présente ses différentes réalisations."
    ],
    "nl": [
      "Jean-Jacques Stannard restaureert houten meubelen in zijn werkplaats. Hij kan ook meubelen op maat maken op verzoek van zijn klanten. Een showroom toont zijn verschillende creaties."
    ],
    "es": [
      "Jean-Jacques Stannard restaura muebles de madera en su taller. También puede crear muebles a medida a petición de sus clientes. Una sala de exposición muestra sus creaciones."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Jean-Jacques stannard ébéniste"
    ]
  },
