  "rdfs:comment": {
    "de": [
      "Die Cafébibliothek wurde in einem ehemaligen Notarhaus aus dem 17. Jahrhundert errichtet, das sich innerhalb der Stadtmauern des Dorfes befindet, und ist ein atypischer Ort der Stadt. Es bietet ein reichhaltiges und abwechslungsreiches Kulturprogramm."
    ],
    "en": [
      "Housed in a former 17th-century notary's house built into the village ramparts, the Cafébibliothèque is an atypical municipal venue. It offers a rich and varied cultural program."
    ],
    "it": [
      "Costruito in un'antica casa notarile del XVII secolo, situata nei bastioni del villaggio, il Cafébibliothèque è un locale comunale atipico. Offre un programma culturale ricco e variegato."
    ],
    "fr": [
      "Construit dans une ancienne maison notariale du 17ème siècle, implantée dans les remparts du village, le Cafébibliothèque est un lieu municipal atypique. Il propose une programmation culturelle riche et variée."
    ],
    "nl": [
      "Het Cafébibliothèque is gevestigd in een voormalig 17e-eeuws notarishuis binnen de stadsmuren en is een atypische gemeentelijke locatie. Het biedt een rijk en gevarieerd cultureel programma."
    ],
    "es": [
      "Construido en una antigua casa notarial del siglo XVII, situada en las murallas del pueblo, el Cafébibliothèque es un local municipal atípico. Ofrece un programa cultural rico y variado."
    ]
  },
