  "rdfs:comment": {
    "de": [
      "La Strada empfängt Sie in einem italienischen Spezialitätenrestaurant im Herzen von Valencia. Lassen Sie sich von einer hochwertigen Küche suspendieren, die Sie in einem atypischen Rahmen genießen können."
    ],
    "en": [
      "La Strada welcomes you to an Italian specialty restaurant in the heart of Valence. You'll be amazed by the quality of our cuisine, served in an atypical setting."
    ],
    "it": [
      "La Strada vi accoglie in un ristorante di specialità italiane situato nel cuore di Valencia. Lasciatevi sospendere da una cucina di qualità da gustare in un ambiente atipico."
    ],
    "fr": [
      "La Strada vous accueille dans un restaurant de spécialités italiennes situé au cœur de Valence. Laissez-vous suspendre par une cuisine de qualité à déguster dans un cadre atypique."
    ],
    "nl": [
      "La Strada verwelkomt je in een restaurant met Italiaanse specialiteiten in het hart van Valence. Laat je meeslepen door een kwaliteitskeuken in een atypische omgeving."
    ],
    "es": [
      "La Strada le da la bienvenida en un restaurante de especialidades italianas situado en el corazón de Valencia. Déjese suspender por una cocina de calidad que se degusta en un entorno atípico."
    ]
  },
