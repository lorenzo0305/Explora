  "rdfs:comment": {
    "de": [
      "Eine Micro-Folie ist ein kultureller Ort, der nationale und internationale Meisterwerke durch ein digitales Museum zugänglich macht. Die Micro-Folie Issoire verfügt außerdem über einen Virtual-Reality-Raum, in dem immersive Inhalte gezeigt werden. Für alle Altersgruppen."
    ],
    "en": [
      "A Micro-Folie is a cultural venue that makes national and international masterpieces accessible through a Digital Museum. La Micro-Folie Issoire also features a virtual reality space with immersive content. Open to all."
    ],
    "it": [
      "La Micro-Folie è uno spazio culturale che rende accessibili i capolavori nazionali e internazionali attraverso un museo digitale. La Micro-Folie Issoire dispone anche di un'area di realtà virtuale che mostra contenuti immersivi. Aperto al pubblico."
    ],
    "fr": [
      "Une Micro-Folie est un lieu culturel rendant accessible les chefs-d'œuvre nationaux et internationaux à travers un Musée Numérique. La Micro-Folie Issoire possède également un espace de réalité virtuelle diffusant des contenus immersifs. Tout public."
    ],
    "nl": [
      "La Micro-Folie is een cultureel trefpunt dat nationale en internationale meesterwerken toegankelijk maakt via een Digitaal Museum. La Micro-Folie Issoire heeft ook een virtual reality-ruimte met meeslepende inhoud. Open voor publiek."
    ],
    "es": [
      "La Micro-Folie es un espacio cultural que hace accesibles obras maestras nacionales e internacionales a través de un Museo Digital. La Micro-Folie Issoire también cuenta con un espacio de realidad virtual que muestra contenidos inmersivos. Abierto al público en general."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Micro-Folie"
    ]
  },
