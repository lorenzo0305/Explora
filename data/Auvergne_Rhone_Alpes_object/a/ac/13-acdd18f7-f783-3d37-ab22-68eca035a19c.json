  "rdfs:comment": {
    "de": [
      "Le Diapason ist ein Ort der Verbreitung und der Unterstützung kreativer Arbeiten und bemüht sich, alle künstlerischen Bereiche aufzunehmen: Tanz, Theater, Musik, neuer Zirkus, Marionetten, Objekttheater."
    ],
    "en": [
      "As a place of diffusion and support for creation, Le Diapason strives to welcome all artistic fields: dance, theatre, music, new circus, puppets, object theatre."
    ],
    "it": [
      "Come luogo di diffusione e sostegno alla creazione, Le Diapason si sforza di accogliere tutti i campi artistici: danza, teatro, musica, nuovo circo, marionette, teatro d'oggetti."
    ],
    "fr": [
      "Lieu de diffusion et de soutien à la création, Le Diapason s'efforce d'accueillir tous les champs artistiques : danse, théâtre, musique, nouveau cirque, marionnettes, théâtre d'objets."
    ],
    "es": [
      "Como lugar de difusión y apoyo a la creación, Le Diapason se esfuerza por acoger todos los campos artísticos: danza, teatro, música, nuevo circo, marionetas, teatro de objetos."
    ],
    "nl": [
      "Als plaats voor verspreiding en ondersteuning van creatie streeft Le Diapason ernaar alle artistieke domeinen te verwelkomen: dans, theater, muziek, nieuw circus, poppenspel, objecttheater."
    ]
  },
  "rdfs:label": {
