  "rdfs:comment": {
    "de": [
      "Die auf einem Felsvorsprung in 600 m Höhe errichtete Burg aus dem 10. Jahrhundert, eine ehemalige Militärfestung, beherrscht die Ebene der Limagne."
    ],
    "en": [
      "Built on a rocky outcrop at an altitude of 600m, this 10th century fortified castle, a former military fortress, dominates the Limagne plain."
    ],
    "it": [
      "Costruito su uno sperone roccioso a 600 metri di altitudine, questo castello fortificato del X secolo, ex fortezza militare, domina la pianura della Limagne."
    ],
    "fr": [
      "Bâti sur un piton rocheux à 600m d'altitude, ce château fort du Xe siècle, ancienne forteresse militaire domine la plaine de la Limagne."
    ],
    "nl": [
      "Gebouwd op een rotspunt op 600 m hoogte, domineert dit 10e eeuwse versterkte kasteel, een voormalig militair fort, de vlakte van de Limagne."
    ],
    "es": [
      "Construido sobre un saliente rocoso a 600 m de altitud, este castillo fortificado del siglo X, antigua fortaleza militar, domina la llanura de la Limagne."
    ]
  },
