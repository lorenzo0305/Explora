  "rdfs:comment": {
    "de": [
      "Die meisten waren Gemeinschaftsbäckereien, in denen die Dorfbewohner abwechselnd das Brot für das ganze Dorf für einen Monat backten."
    ],
    "en": [
      "Mostly communal: villagers took it in turns to bake bread for the whole village for a month."
    ],
    "it": [
      "La maggior parte di esse erano comuni: gli abitanti del villaggio facevano a turno per preparare il pane per tutto il villaggio per un mese."
    ],
    "fr": [
      "La plupart du temps communautaires: les villageois y cuisaient  à tour de rôle le pain pour tout le village pour un mois."
    ],
    "nl": [
      "Meestal gemeenschappelijk: de dorpelingen bakten om beurten een maand lang brood voor het hele dorp."
    ],
    "es": [
      "La mayoría eran comunales: los aldeanos se turnaban para hornear pan para todo el pueblo durante un mes."
    ]
  },
