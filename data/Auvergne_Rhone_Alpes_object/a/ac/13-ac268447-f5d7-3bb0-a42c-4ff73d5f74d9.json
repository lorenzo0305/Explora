  "rdfs:comment": {
    "de": [
      "Treffen Sie sich am alten Bahnhof von Doussard. Fahren Sie in Richtung Annecy, wobei Sie den Kreisverkehr der RD1508 auf Ihrer rechten Seite haben."
    ],
    "en": [
      "Meet at the old Doussard train station. Head towards Annecy, with the RD1508 traffic circle on your right."
    ],
    "it": [
      "Ritrovo alla vecchia stazione ferroviaria di Doussard. Dirigetevi verso Annecy, con la rotonda RD1508 sulla destra."
    ],
    "fr": [
      "Rendez-vous à l’ancienne gare de Doussard. Prenez la direction d’Annecy en ayant sur votre droite le rond-point de la RD1508."
    ],
    "nl": [
      "Verzamelen bij het oude treinstation in Doussard. Ga richting Annecy, met de RD1508 rotonde aan je rechterhand."
    ],
    "es": [
      "Encuentro en la antigua estación de ferrocarril de Doussard. Diríjase hacia Annecy, con la rotonda RD1508 a su derecha."
    ]
  },
  "rdfs:label": {
