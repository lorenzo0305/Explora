  "rdfs:comment": {
    "de": [
      "Von und mit Jean-Pierre Bodin\r\n\r\nAls genialer Erzähler lädt Sie Jean-Pierre Bodin an den Tisch der Geschichten seines Heimatdorfes und der städtischen Blaskapelle: ein zärtliches, großzügiges und vor allem schrecklich komisches Schauspiel!"
    ],
    "en": [
      "By and for Jean-Pierre Bodin\r\n\r\nA brilliant storyteller, Jean-Pierre Bodin invites you to share the stories of his native village and the municipal brass band in a show that's tender, generous and, above all, wickedly funny!"
    ],
    "it": [
      "Di e su Jean-Pierre Bodin\r\n\r\nGeniale narratore, Jean-Pierre Bodin vi invita a condividere le storie del suo villaggio natale e della banda musicale locale in uno spettacolo tenero, generoso e, soprattutto, terribilmente divertente!"
    ],
    "fr": [
      "De et par Jean-Pierre Bodin\r\n\r\nRaconteur de génie, Jean-Pierre Bodin vous convie à la table des histoires de son village natal et de la fanfare municipale : un spectacle tendre, généreux et surtout terriblement cocasse !"
    ],
    "es": [
      "Por y sobre Jean-Pierre Bodin\r\n\r\nGenio narrador, Jean-Pierre Bodin le invita a compartir las historias de su pueblo natal y de la banda de música local en un espectáculo tierno, generoso y, sobre todo, ¡terriblemente divertido!"
    ],
    "nl": [
      "Door en over Jean-Pierre Bodin\r\n\r\nJean-Pierre Bodin, een geniale verteller, nodigt u uit om de verhalen van zijn geboortedorp en de plaatselijke fanfare te delen in een voorstelling die teder, genereus en vooral vreselijk grappig is!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Musique : Le Banquet de la Sainte Cécile - Saison Romans Scènes"
    ]
  },
