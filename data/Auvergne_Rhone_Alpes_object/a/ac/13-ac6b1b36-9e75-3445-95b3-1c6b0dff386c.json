  "rdfs:comment": {
    "de": [
      "Kirche mit einer sehr schönen Fassade aus Vulkangestein. Möglichkeit einer geführten Besichtigung mit einem Fremdenführer des Pays d'art et d'histoire du Haut-Allier, Tel. 04 71 77 28 30."
    ],
    "en": [
      "Church with beautiful volcanic stone facade. Possibility of guided tour with a guide from the Pays d'art et d'histoire du Haut-Allier, Tel. 04 71 77 28 30."
    ],
    "it": [
      "Chiesa con una bella facciata in pietra vulcanica. Possibilità di visita guidata con una guida del Pays d'art et d'histoire du Haut-Allier, tel. 04 71 77 28 30."
    ],
    "fr": [
      "Eglise avec une très belle façade en pierre volcanique. Possibilité de visite guidée avec un guide conférencier du Pays d'art et d'histoire du Haut-Allier, Tél. 04 71 77 28 30."
    ],
    "nl": [
      "Kerk met een prachtige gevel van vulkanische steen. Mogelijkheid voor een rondleiding met een gids van het Pays d'art et d'histoire du Haut-Allier, Tel. 04 71 77 28 30."
    ],
    "es": [
      "Iglesia con una hermosa fachada de piedra volcánica. Posibilidad de visita guiada con un guía del Pays d'art et d'histoire du Haut-Allier, Tel. 04 71 77 28 30."
    ]
  },
