  "rdfs:comment": {
    "de": [
      "Im Herzen des Dorfes und 5 Minuten von den Pisten entfernt bietet Ihnen das Chalet-Hotel Gai Soleil in Les Contamines-Montjoie den verführerischen Rahmen eines alten Bauernhofs aus dem Jahr 1823 und den modernen Komfort eines 3-Sterne-Hotels."
    ],
    "en": [
      "In the heart of the village and at 5 minutes from the slopes, the Chalet-Hotel Gai Soleil in Les Contamines-Montjoie offers you the charming setting of an old farmhouse dating from 1823 and the modern comfort of a 3-star hotel."
    ],
    "it": [
      "Nel cuore del villaggio e a 5 minuti dalle piste, lo Chalet-Hotel Gai Soleil di Les Contamines-Montjoie vi offre l'ambiente suggestivo di un'antica casa colonica del 1823 e il comfort moderno di un hotel a 3 stelle."
    ],
    "fr": [
      "Au cœur du village et à 5 minutes des pistes le Chalet-Hôtel Gai Soleil aux Contamines-Montjoie vous offre le cadre séduisant d'une ancienne ferme datant de 1823 et le confort moderne d'un 3 étoiles."
    ],
    "nl": [
      "Het Chalet-Hotel Gai Soleil in Les Contamines-Montjoie, in het hart van het dorp en op 5 minuten van de pistes, biedt u de aantrekkelijke omgeving van een oude boerderij uit 1823 en het moderne comfort van een 3-sterren hotel."
    ],
    "es": [
      "En el corazón del pueblo y a 5 minutos de las pistas, el Chalet-Hotel Gai Soleil de Les Contamines-Montjoie le ofrece el atractivo entorno de una antigua granja de 1823 y el confort moderno de un hotel de 3 estrellas."
    ]
  },
