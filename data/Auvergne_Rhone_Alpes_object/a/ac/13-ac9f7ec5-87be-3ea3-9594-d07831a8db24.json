  "rdfs:comment": {
    "de": [
      "Im Comptoir de Philomène finden Sie eine traditionelle Küche, in der die lokalen Produkte im Vordergrund stehen. Alle Fleischsorten stammen garantiert aus lokalen Zuchtbetrieben. Pizzas vor Ort und zum Mitnehmen,."
    ],
    "en": [
      "At Comptoir de Philomène, you'll find traditional cuisine featuring local products. All meats are guaranteed to come from local farms. Pizzas to eat in or take away."
    ],
    "it": [
      "Al Comptoir de Philomène troverete una cucina tradizionale con prodotti locali. Tutte le carni sono garantite da allevamenti locali. Pizze da mangiare o da portare via."
    ],
    "fr": [
      "Au Comptoir de Philomène, vous trouverez une cuisine traditionnelle où les produits locaux seront à l'honneur. Toutes les viandes sont garanties d'élevages locaux. Pizzas sur place et à emporter,."
    ],
    "es": [
      "En el Comptoir de Philomène encontrará una cocina tradicional elaborada con productos locales. Todas las carnes proceden de granjas locales. Pizzas para comer en el restaurante o para llevar."
    ],
    "nl": [
      "Bij Comptoir de Philomène vind je traditionele gerechten met lokale producten. Al het vlees komt gegarandeerd van lokale boerderijen. Pizza's om te eten of om mee te nemen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Comptoir de Philomène"
    ]
  },
