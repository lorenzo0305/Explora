  "rdfs:comment": {
    "de": [
      "Das Gebäude Bételgeuse, das oft mit dem Hotel Le Flaine verglichen wird, unterscheidet sich von seinem Nachbarn durch das Fehlen von gemauerten Sockeln und die vielen vorspringenden Balkone, die für die Bauhaus-Architektur typisch sind."
    ],
    "en": [
      "Often compared to the Le Flaine hotel, the Bételgeuse building differs from its neighbour in that it has no masonry base and an abundance of projecting balconies, emblematic of Bauhaus architecture."
    ],
    "it": [
      "Spesso paragonato all'hotel Le Flaine, l'edificio Betelgeuse si differenzia dal suo vicino per l'assenza di una base in muratura e per l'abbondanza di balconi sporgenti, emblematici dell'architettura Bauhaus."
    ],
    "fr": [
      "Souvent comparé à l’hôtel Le Flaine, l’immeuble Bételgeuse se différencie de son voisin par l’absence de soubassements maçonnés et l’abondance de balcons saillants, emblématiques de l’architecture Bauhaus."
    ],
    "nl": [
      "Het Bételgeuse-gebouw wordt vaak vergeleken met het Le Flaine-hotel, maar verschilt van zijn buurman doordat het geen gemetselde basis heeft en een overvloed aan uitstekende balkons, kenmerkend voor de Bauhaus-architectuur."
    ],
    "es": [
      "A menudo comparado con el hotel Le Flaine, el edificio Betelgeuse se distingue de su vecino por la ausencia de basamento de mampostería y la abundancia de balcones salientes, emblemáticos de la arquitectura Bauhaus."
    ]
  },
  "rdfs:label": {
