  "rdfs:comment": {
    "de": [
      "Das 4*-Hotel La Cachette mit seinem einzigartigen Design verfügt über 88 Zimmer und Suiten, ein Restaurant, eine Bar, ein Spa und einen Coworking-Bereich. Das Hotel befindet sich am Fuße der Pisten und bietet Ihnen einen atemberaubenden Blick auf die umliegenden Gipfel."
    ],
    "en": [
      "A 4* hotel with a unique design, La Cachette has 88 rooms and suites, as well as a restaurant, bar, spa and coworking space. Located at the foot of the slopes, it offers breathtaking views of the surrounding peaks."
    ],
    "it": [
      "Hotel 4* dal design unico, La Cachette dispone di 88 camere e suite, oltre a ristorante, bar, spa e area coworking. Si trova ai piedi delle piste e offre una vista mozzafiato sulle cime circostanti."
    ],
    "fr": [
      "Hôtel 4* au design unique, La Cachette c’est 88 chambres et suites mais aussi un restaurant, un bar, un spa et un espace coworking. Il est situé au pied des pistes et vous offre des vues imprenables sur les sommets environnants."
    ],
    "nl": [
      "La Cachette, een 4*-hotel met een uniek ontwerp, heeft 88 kamers en suites, evenals een restaurant, bar, spa en coworkingruimte. Het ligt aan de voet van de pistes en biedt een adembenemend uitzicht op de omliggende bergtoppen."
    ],
    "es": [
      "Hotel de 4* con un diseño único, La Cachette dispone de 88 habitaciones y suites, así como de restaurante, bar, spa y zona de coworking. Está situado a pie de pistas y ofrece impresionantes vistas de los picos circundantes."
    ]
  },
