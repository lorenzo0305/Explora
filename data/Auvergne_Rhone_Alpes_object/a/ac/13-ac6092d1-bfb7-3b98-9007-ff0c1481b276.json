  "rdfs:comment": {
    "de": [
      "Die Froschschenkel! Das ist die Spezialität des Hauses!\r\nSie können auch ein Pferdesteak mit hausgemachten Pommes frites oder einen gebackenen Camembert genießen!"
    ],
    "en": [
      "Frogs' legs! The house specialty!\r\nYou can also enjoy a horse steak with home fries, or a baked Camembert!"
    ],
    "it": [
      "Cosce di rana! È la specialità della casa!\r\nPotete anche assaggiare una bistecca di cavallo con patatine fritte o un Camembert al forno!"
    ],
    "fr": [
      "Les cuisses de grenouilles ! C'est la spécialité de la maison ! \r\nVous pourrez aussi déguster un steak à cheval accompagné de ses frites maisons ou bien un camembert au four !"
    ],
    "nl": [
      "Kikkerbilletjes! Het is de specialiteit van het huis!\r\nJe kunt ook een paardensteak met huisgemaakte frietjes proberen of een gebakken Camembert!"
    ],
    "es": [
      "Ancas de rana Es la especialidad de la casa\r\nTambién puedes probar un filete de caballo con patatas fritas caseras o un Camembert al horno"
    ]
  },
  "rdfs:label": {
