  "rdfs:comment": {
    "de": [
      "Unser Restaurant befindet sich in idealer Lage im Herzen von Valencia auf dem Place des Clercs, nur wenige Schritte vom Museum von Valencia, dem Maison des Têtes und der Altstadt entfernt. Wir bieten Ihnen eine raffinierte und gastronomische Küche zum besten Preis."
    ],
    "en": [
      "Our restaurant is ideally situated in the heart of Valence in La Place des Clercs, just a stone's throw from Valence Museum, La Maison des Têtes and the old town. We offer you refined, gastronomic cuisine at the best price."
    ],
    "it": [
      "Il nostro ristorante è situato nel cuore di Valencia, in Place des Clercs, a due passi dal Museo di Valence, dalla Maison des Têtes e dal centro storico. Offriamo una cucina raffinata e gastronomica al miglior prezzo."
    ],
    "fr": [
      "Notre restaurant est idéalement situé au cœur de Valence sur la Place des Clercs, à deux pas du musée de Valence, de la Maison des Têtes et de la vieille ville. Nous vous proposons une cuisine raffinée et gastronomique au meilleur prix."
    ],
    "nl": [
      "Ons restaurant is ideaal gelegen in het hart van Valence op de Place des Clercs, op loopafstand van het museum van Valence, van het Maison des Têtes en van het oude centrum. We bieden een geraffineerde en gastronomische keuken tegen lage prijzen."
    ],
    "es": [
      "Nuestro restaurante está idealmente situado en el corazón de Valencia, en la Place des Clercs, a un paso del Museo de Valence, de la Maison des Têtes y del casco antiguo. Ofrecemos una cocina refinada y gastronómica al mejor precio."
    ]
  },
