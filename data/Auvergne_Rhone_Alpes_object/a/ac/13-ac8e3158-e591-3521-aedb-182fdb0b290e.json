  "rdfs:comment": {
    "de": [
      "Oberhalb des Viadukts von Garabit, im Tal der Truyère, fällt das Dorf Chaliers durch seine Lage senkrecht über dem Tal und den Charme seiner Bebauung entlang einer engen Gasse auf, die zur Kirche führt."
    ],
    "en": [
      "Upstream from the Garabit Viaduct, in the Truyère valley, the village of Chaliers stands out for its position overlooking the valley and the charm of its buildings along a narrow lane leading to the church."
    ],
    "it": [
      "A monte del viadotto di Garabit, nella valle del Truyère, il villaggio di Chaliers si distingue per la sua posizione dominante sulla valle e per il fascino dei suoi edifici lungo uno stretto vicolo che conduce alla chiesa."
    ],
    "fr": [
      "En amont du Viaduc de Garabit, dans la vallée de la Truyère, le village de Chaliers se remarque par sa situation en aplomb de la vallée et le charme de son bâti le long d'une ruelle étroite menant à l'église."
    ],
    "nl": [
      "Stroomopwaarts van het viaduct van Garabit, in de Truyère-vallei, valt het dorp Chaliers op door zijn ligging met uitzicht over de vallei en de charme van de gebouwen langs een smalle weg die naar de kerk leidt."
    ],
    "es": [
      "Río arriba del viaducto de Garabit, en el valle del Truyère, el pueblo de Chaliers destaca por su posición dominando el valle y el encanto de sus edificios a lo largo de una estrecha callejuela que conduce a la iglesia."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Village de Chaliers, dominant la Truyère"
    ]
  },
