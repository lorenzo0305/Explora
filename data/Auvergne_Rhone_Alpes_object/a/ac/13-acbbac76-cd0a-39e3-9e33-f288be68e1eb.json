  "rdfs:comment": {
    "de": [
      "Le Clos des Arts bietet Künstlern in einem kathedralenartigen Volumen eine echte Kunstgalerie von 100 m². Dieser schlichte und helle Raum ist komplett ausgestattet, leicht zugänglich und verfügt über angrenzende Parkplätze, sodass Kunstwerke zur Geltung kommen können."
    ],
    "en": [
      "Le Clos des Arts offers artists a genuine 100m² art gallery of cathedral proportions. This understated and bright venue is fully equipped, easy to access with adjoining car parks and the ideal showcase for works of art."
    ],
    "it": [
      "Le Clos des Arts offre agli artisti, in uno spazio simile a una cattedrale, una vera e propria galleria d'arte di 100 m². Questo spazio, sobrio e luminoso, completamente attrezzato, di facile accesso con parcheggi annessi, consente l'esposizione di opere d'arte."
    ],
    "fr": [
      "Le Clos des Arts propose aux artistes, dans un volume cathédral, une véritable galerie d’art de 100m². Cet espace, sobre et lumineux, entièrement équipé, facile d’accès avec parkings attenants, permet la mise en valeur des œuvres d’arts."
    ],
    "es": [
      "Le Clos des Arts ofrece a los artistas, en un espacio con aspecto de catedral, una auténtica galería de arte de 100 m². Este espacio, sobrio y luminoso, totalmente equipado, de fácil acceso con aparcamientos contiguos, permite la exposición de obras de arte."
    ],
    "nl": [
      "Le Clos des Arts biedt kunstenaars, in een kathedraalachtige ruimte, een echte kunstgalerie van 100m². Deze ruimte, sober en licht, volledig uitgerust, gemakkelijk toegankelijk met aangrenzende parkeerplaatsen, maakt de presentatie van kunstwerken mogelijk."
    ]
  },
