  "rdfs:comment": {
    "de": [
      "Anspruchsvolle Route für erfahrene Mountainbiker! Nach einem langen Anstieg können Sie den Gipfel des Sénépy und sein atemberaubendes 360°-Panorama in vollen Zügen genießen!\r\nRoute Nr. 11 mit schwarzer Markierung.\r\nStart: Camping des Cordeliers Pierre Châtel."
    ],
    "en": [
      "Difficult track for experienced bikers ! After a long ascent to the top of the Sénépy you will discover an extraordinary 360° panorama. Itinerary n°11 difficulty level : black"
    ],
    "it": [
      "Un percorso difficile per mountain biker esperti! Dopo una lunga salita, godetevi la cima del Sénépy e il suo panorama mozzafiato a 360°!\r\nPercorso n. 11 segnalato in nero.\r\nPartenza dal Camping des Cordeliers Pierre Châtel."
    ],
    "fr": [
      "Itinéraire difficile pour vttistes confirmés! Après une longue montée, profitez pleinement du sommet du Sénépy et son panorama à 360° à couper le souffle! \r\nParcours n°11 balisé en noir.\r\nDépart Camping des Cordeliers Pierre Châtel."
    ],
    "es": [
      "Una ruta difícil para ciclistas de montaña experimentados Tras una larga subida, disfrute de la cumbre de Sénépy y de su impresionante panorama de 360°\r\nRuta n° 11 señalizada en negro.\r\nSalida del Camping des Cordeliers Pierre Châtel."
    ],
    "nl": [
      "Moeilijk pad voor bevestigde atleten. Na een lange klim komt u op de top van de Sénépy met z'n panorama van 360°"
    ]
  },
