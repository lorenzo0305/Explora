  "rdfs:comment": {
    "de": [
      "Bar-Restaurant und Eisdiele. Traditionelle Küche der Ardèche aus frischen und regionalen Produkten. Genießen Sie unsere Cocktailbar. Karaoke-/DJ-Abende etwa alle zwei Wochen am Samstag.\r\nKostenloser Wifi-Zugang. Finden Sie uns im Routard 2025."
    ],
    "en": [
      "Bar, restaurant and ice creams. Traditional Ardèche cooking using fresh, regional produce. You will appreciate our cocktail bar. Karaoke/DJ nights every two weeks, on Saturday.\r\nFree wifi access."
    ],
    "it": [
      "Bar-ristorante e gelateria. Cucina tradizionale dell'Ardèche con prodotti freschi locali. Godetevi il nostro cocktail bar. Serate Karaoke/DJ circa ogni quindici giorni il sabato.\r\nAccesso wifi gratuito. Ci trovate nella Routard 2025."
    ],
    "fr": [
      "Bar-restaurant et glacier. Cuisine traditionnelle ardéchoise à base de produits frais et régionaux. Profitez de notre bar à cocktails. Soirées karaoké/DJ environ toutes les deux semaines, le samedi.\r\nAccès wifi gratuit. Retrouvez-nous dans le Routard 2025."
    ],
    "es": [
      "Bar-restaurante y heladería. Cocina tradicional de Ardèche con productos frescos de la región. Disfrute de nuestro bar de cócteles. Veladas de karaoke/DJ los sábados aproximadamente cada quince días.\r\nAcceso wifi gratuito. Encuéntrenos en el Routard 2025."
    ],
    "nl": [
      "Bar-restaurant en ijssalon. Traditionele keuken uit de Ardèche met verse lokale producten. Geniet van onze cocktailbar. Karaoke/DJ-avonden ongeveer om de twee weken op zaterdag.\r\nGratis toegang tot wifi. U vindt ons in de Routard 2025."
    ]
  },
