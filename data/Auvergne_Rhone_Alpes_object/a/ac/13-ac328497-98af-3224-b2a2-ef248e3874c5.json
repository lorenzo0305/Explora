  "rdfs:comment": {
    "de": [
      "Gemütlicher Raum für Erwachsene, Jugendliche und Kinder. Hier finden Sie Romane, Comics, Dokumentarfilme, Bücher, Audios und Zeitschriften. Neuheiten sind über den Online-Katalog erhältlich. Wi-Fi-Zugang verfügbar."
    ],
    "en": [
      "Comfortable space for adults, teens and children. You'll find novels, comics, documentaries, books, audios and magazines. New titles available from our online catalog. Wi-fi access available."
    ],
    "it": [
      "Uno spazio confortevole per adulti, adolescenti e bambini. Troverete romanzi, fumetti, documentari, libri, audiolibri e riviste. Nuovi titoli disponibili nel catalogo online. Accesso Wi-Fi disponibile."
    ],
    "fr": [
      "Espace confortable pour les adultes, les ados et les enfants. Vous y trouverez des romans, BDs, documentaires, livres, audios et revues. Nouveautés disponibles sur le catalogue en ligne. Accès wi-fi disponible."
    ],
    "es": [
      "Un espacio confortable para adultos, adolescentes y niños. Encontrarás novelas, cómics, documentales, libros, audiolibros y revistas. Nuevos títulos disponibles en el catálogo en línea. Acceso Wi-Fi disponible."
    ],
    "nl": [
      "Een comfortabele ruimte voor volwassenen, tieners en kinderen. Je vindt er romans, strips, documentaires, boeken, luisterboeken en tijdschriften. Nieuwe titels beschikbaar uit de online catalogus. Wi-Fi-toegang beschikbaar."
    ]
  },
