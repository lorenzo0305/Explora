  "rdfs:comment": {
    "de": [
      "Besuch mit allen Sinnen\nAus der Perspektive eines Tieres erkunden die Kleinsten die Landschaften der Metropolregion mit ihren Sinnen: Hören,\nden Tastsinn und den Sehsinn."
    ],
    "en": [
      "Sensory tour\nTaking the point of view of an animal, toddlers explore the landscapes of the Metropolis through their senses: hearing,\ntouch and sight."
    ],
    "it": [
      "Visita sensoriale\nAssumendo il punto di vista di un animale, i bambini esplorano i paesaggi della Francia metropolitana attraverso i loro sensi: udito, tatto e vista,\ntatto e vista."
    ],
    "fr": [
      "Visite sensorielle\nEn prenant le point de vue d’un animal, les tout-petits explorent les paysages de la Métropole à travers leurs sens : l’ouïe,\nle toucher et la vue."
    ],
    "nl": [
      "Zintuiglijk bezoek\nDoor het standpunt van een dier in te nemen, verkennen de peuters de landschappen van Metropolitan France via hun zintuigen: horen, aanraken en zien,\naanraken en zien."
    ],
    "es": [
      "Visita sensorial\nAdoptando el punto de vista de un animal, los niños exploran los paisajes de la Francia metropolitana a través de sus sentidos: el oído, el tacto y la vista,\ntacto y vista."
    ]
  },
  "rdfs:label": {
    "fr": [
