      "dc:description": {
        "de": [
          "Ikonische Fast-Food-Kette, die Burger und Pommes frites, Desserts und Milchshakes anbietet\n\nÖffnungszeiten Einschluss :\nÖffnungszeiten: 11:00 - 21:30 Uhr\n(click and collect, mc drive, Take-away, UBER EAT-Lieferung)"
        ],
        "en": [
          "Iconic fast-food chain offering burger and fry menus, desserts and milkshakes located at the entrance to the city\n\nSchedules Confinement :\nOpening hours : 11h - 21h30\n(click and collect, mc drive, take away sale, UBER EAT delivery)"
        ],
        "it": [
          "Iconica catena di fast food che offre hamburger e patatine fritte, dolci e frullati, situata all'ingresso della città\n\nOrari di funzionamento :\nOrario di apertura: 11.00 - 21.30\n(click and collect, mc drive, takeaway, consegna UBER EAT)"
        ],
        "fr": [
          "Chaîne emblématique de restauration rapide proposant des menus de burgers-frites, des desserts et milk-shakes situé à l'entrée de la ville\n\nHoraires Confinement :\nHoraires d'ouverture : 11h - 21h30\n(click and collect, mc drive, vente à emporter, livraison UBER EAT)"
        ],
        "nl": [
          "Iconische fastfoodketen met hamburger en friet, desserts en milkshakes aan de ingang van de stad\n\nOpeningstijden :\nOpeningstijden: 11.00 - 21.30 uur\n(click and collect, mc drive, takeaway, UBER EAT delivery)"
        ],
        "es": [
          "Icónica cadena de comida rápida que ofrece hamburguesas y patatas fritas, postres y batidos situada a la entrada de la ciudad\n\nHorario de atención al público :\nHorario de apertura: de 11:00 a 21:30 horas\n(click and collect, mc drive, takeaway, UBER EAT delivery)"
        ]
      },
