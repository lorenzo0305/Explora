  "rdfs:comment": {
    "de": [
      "Second-Hand-Shop, Möbel und Deko, Geschirr, Second-Hand-Läden, Haushaltsgeräte, Multimedia, Werkzeuge und vieles mehr!\r\nBevor Sie zum Wertstoffhof fahren, sollten Sie sich bewusst sein, dass Ihre nutzlosen und sperrigen Gegenstände von anderen benötigt werden können."
    ],
    "en": [
      "Don't trow away !!! Clothes, tableware, furniture, ornaments, bikes.... bring it to La Fabrique - recycling center.\r\nThanks to your gifts, the shop is full of treasures, for a small price."
    ],
    "it": [
      "Negozio di seconda mano, mobili e decorazioni, stoviglie, articoli di seconda mano, elettrodomestici, multimedia, utensili e altro ancora!\r\nPrima di recarvi al centro di smaltimento rifiuti, sappiate che i vostri oggetti inutili e ingombranti possono diventare necessari ad altri."
    ],
    "fr": [
      "Boutique 2ème main, meubles et déco, vaisselle, friperie, électroménager, multimédia, outillage et plus encore !\r\nAvant d'aller à la déchetterie, sachez que vos inutiles et encombrants peuvent devenir nécessaires à d'autres."
    ],
    "nl": [
      "Tweedehands winkel, meubels en decoratie, serviesgoed, tweedehands kleren, huishoudelijke apparaten, multimedia, gereedschap en meer!\r\nVoordat u naar het afvalverwerkingscentrum gaat, moet u weten dat uw nutteloze en hinderlijke voorwerpen anderen kunnen dienen."
    ],
    "es": [
      "Tienda de segunda mano, muebles y decoración, vajillas, artículos de ocasión, electrodomésticos, multimedia, herramientas ¡y mucho más!\r\nAntes de acudir al centro de eliminación de residuos, sepa que sus objetos inútiles y engorrosos pueden convertirse en necesarios para los demás."
    ]
  },
  "rdfs:label": {
    "en": [
      "La Fabrique - recycling centre"
    ],
    "fr": [
      "La Fabrique - recyclerie"
    ],
    "nl": [
      "La Fabrique - recyclerie"
    ]
  },
