  "rdfs:comment": {
    "de": [
      "Restaurant und Tapas-Bar mit verschiedenen Aperitifbrettern, Sonntagsbrunch und traditioneller Küche auf Vorbestellung für Veranstaltungen. Die Bar bietet eine schöne Auswahl an Bieren und Weinen, die Sie bei Gesellschaftsspielen genießen können!"
    ],
    "en": [
      "Restaurant and tapas bar offering a variety of appetizers, brunch on Sundays, as well as traditional cuisine on reservation for events. The bar offers a nice choice of beers and wines, to be enjoyed around board games!"
    ],
    "it": [
      "Ristorante e tapas bar che offre una varietà di aperitivi, un brunch la domenica e una cucina tradizionale su prenotazione per eventi. Il bar offre una buona scelta di birre e vini, da gustare con i giochi da tavolo!"
    ],
    "fr": [
      "Restaurant et bar à tapas proposant des planches apéritives variées, un brunch le dimanche, ainsi qu'une cuisine traditionnelle sur réservation pour des évènements. Le bar propose un beau choix de bières et de vins, à déguster autour de jeux de société !"
    ],
    "es": [
      "Restaurante y bar de tapas que ofrece una variedad de aperitivos, brunch los domingos, así como cocina tradicional bajo reserva para eventos. El bar ofrece una buena selección de cervezas y vinos, que se pueden disfrutar con juegos de mesa"
    ],
    "nl": [
      "Restaurant en tapasbar met verschillende aperitieven, brunch op zondag en traditionele gerechten op reservering voor evenementen. De bar biedt een goede keuze van bieren en wijnen, om van te genieten met gezelschapsspelen!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Comptoir des Amis"
    ]
  },
