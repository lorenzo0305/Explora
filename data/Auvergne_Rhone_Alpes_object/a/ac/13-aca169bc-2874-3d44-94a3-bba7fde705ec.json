  "rdfs:comment": {
    "de": [
      "Das College d'Université pour tous de Langeac feiert sein 30-jähriges Bestehen in der Auberge du Pont de Costet in Reilhac. Nach dem Essen findet ein Konzert statt, das von Catherine LENNE und ihrer Musikgruppe dargeboten wird."
    ],
    "en": [
      "Langeac?s collège d?université pour tous celebrates its 30th anniversary at the auberge du Pont de Costet in Reilhac. The meal will be followed by a concert by Catherine LENNE and her band."
    ],
    "it": [
      "Il Collegio Universitario per Tutti di Langeac festeggia il suo 30° anniversario presso la locanda Pont de Costet di Reilhac. Il pranzo sarà seguito da un concerto di Catherine LENNE e della sua band."
    ],
    "fr": [
      "Le collège d’université pour tous de Langeac fête ses 30 ans à l’auberge du Pont de Costet à Reilhac Le repas sera suivi d’un concert proposé par Catherine LENNE et sa formation musicale."
    ],
    "nl": [
      "Het University College for All in Langeac viert zijn 30e verjaardag in de herberg Pont de Costet in Reilhac. De maaltijd wordt gevolgd door een concert van Catherine LENNE en haar band."
    ],
    "es": [
      "El Colegio Universitario para Todos de Langeac celebra su 30 aniversario en la posada Pont de Costet de Reilhac. Tras la comida, Catherine LENNE y su banda ofrecerán un concierto."
    ]
  },
