  "rdfs:comment": {
    "de": [
      "Le Ballon wird sich um Sie kümmern, damit Sie Ihre Batterien dank einer traditionnellen und reichhaltigen Küche wieder aufladen können. Kommen Sie schnell dieses Restaurant entdecken!"
    ],
    "en": [
      "Le Ballon is the perfect place to relax and unwind, proposing tasty, generous cuisine. Discover this restaurant today!"
    ],
    "it": [
      "Il Ballon saprà ricaricare le tue batterie prendendosi cura di te grazie a una cucina tradizionale saporita e generosa. Vieni a scoprire questo ristorante!"
    ],
    "fr": [
      "Le Ballon saura prendre soin de vous pour recharger vos batteries grâce à une cuisine traditionnelle gourmande et généreuse. Venez vite découvrir ce restaurant !"
    ],
    "nl": [
      "Le Ballon zorgt ervoor dat u nieuwe energie opdoet dankzij een royale en gastronomische traditionele keuken. Kom en ontdek dit restaurant!"
    ],
    "es": [
      "Le Ballon sabe mimar a sus comensales con una cocina tradicional deliciosa y generosa, para que recarguen las pilas. ¡Una referencia imprescindible!"
    ]
  },
