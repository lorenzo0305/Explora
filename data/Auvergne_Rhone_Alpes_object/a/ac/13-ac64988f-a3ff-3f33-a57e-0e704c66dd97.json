  "rdfs:comment": {
    "de": [
      "Feinkostladen C-Gastronomie in Chaponost: hausgemachte Gerichte, Mittagsmenüs, Mitnahmeverkauf vom Aperitif bis zum Dessert und Delikatessen. Eine Feinschmeckerküche der Saison, die vor Ort und als Lieferservice erhältlich ist."
    ],
    "en": [
      "Catering boutique C-Gastronomie in Chaponost: home-cooked dishes, lunch menus, takeaway from aperitif to dessert and delicatessen. Seasonal gourmet cuisine, available on site and on delivery."
    ],
    "it": [
      "C-Gastronomie, negozio di catering a Chaponost: piatti fatti in casa, menu per il pranzo, takeaway dall'aperitivo al dessert e gastronomia. Cucina gourmet di stagione, disponibile in loco e su consegna."
    ],
    "fr": [
      "Boutique traiteur C-Gastronomie à Chaponost : plats cuisinés maison, menus du midi, vente à emporter de l’apéritif au dessert et épicerie fine. Une cuisine gourmande et de saison, disponible sur place et en livraison."
    ],
    "nl": [
      "Traiteur C-Gastronomie in Chaponost: huisgemaakte gerechten, lunchmenu's, afhaalmaaltijden van aperitief tot dessert en delicatessen. Seizoenskeuken voor fijnproevers, zowel ter plaatse als bij levering."
    ],
    "es": [
      "Tienda de restauración C-Gastronomie en Chaponost: platos caseros, menús de mediodía, comida para llevar desde el aperitivo hasta el postre y delicatessen. Cocina gastronómica de temporada, disponible in situ y a domicilio."
    ]
  },
