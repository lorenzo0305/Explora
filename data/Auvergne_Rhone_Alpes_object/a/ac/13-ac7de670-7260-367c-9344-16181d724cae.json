  "rdfs:comment": {
    "de": [
      "In einer wunderschönen Umgebung neben unserer sehr alten Weinpresse freuen wir uns darauf, unsere Leidenschaft mit Ihnen zu teilen."
    ],
    "en": [
      "In a magnificent setting, next to our very old grape press, we will be delighted to share our passion with you."
    ],
    "it": [
      "In un ambiente magnifico, accanto al nostro antico torchio, saremo lieti di condividere con voi la nostra passione."
    ],
    "fr": [
      "Dans un cadre magnifique à côté de notre très ancien pressoir, nous serons enchantés de vous faire partager notre passion."
    ],
    "nl": [
      "In een prachtige omgeving naast onze zeer oude wijnpers delen wij graag onze passie met u."
    ],
    "es": [
