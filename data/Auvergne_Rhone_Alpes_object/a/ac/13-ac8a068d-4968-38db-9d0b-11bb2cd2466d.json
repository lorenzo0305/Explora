  "rdfs:comment": {
    "de": [
      "Nur für Abenteurer und Sportler, die den Nervenkitzel lieben!\r\nEin verkabelter Parcours, der über Felsbänder führt und die Gletscher der Vanoise überblickt."
    ],
    "en": [
      "Reserved for adventurers and thrill-seekers!\r\nA cable course over rocky ledges facing the Vanoise glaciers."
    ],
    "it": [
      "Per gli avventurieri e gli sportivi in cerca di emozioni!\r\nUn percorso in fune su cenge rocciose di fronte ai ghiacciai della Vanoise."
    ],
    "fr": [
      "Réservée aux aventuriers et sportifs amateurs de frissons !\r\nParcours câblé évoluant sur des vires rocheuses face aux glaciers de la Vanoise."
    ],
    "nl": [
      "Voor avonturiers en sportievelingen op zoek naar sensatie!\r\nEen kabelbaan over rotsachtige richels tegenover de gletsjers van de Vanoise."
    ],
    "es": [
      "Para aventureros y deportistas en busca de emociones fuertes\r\nUn recorrido por cable sobre salientes rocosos frente a los glaciares de la Vanoise."
    ]
  },
