  "rdfs:comment": {
    "de": [
      "Unser Club empfängt Sie dienstags und freitags in der Rue Malautière 12 zu Spiel- und Begegnungsnachmittagen. uEin Themenessen einmal im Monat.\r\nEine kostenlose Tagesreise."
    ],
    "en": [
      "Our club welcomes you on Tuesdays and Fridays 12 Rue Malautière for afternoons of games and socializing. uU themed meal once a month.\r\nA free day trip."
    ],
    "it": [
      "Il nostro club vi accoglie il martedì e il venerdì al 12 di Rue Malautière per pomeriggi di gioco e socializzazione. uU pasto a tema una volta al mese.\r\nUna gita gratuita."
    ],
    "fr": [
      "Notre club vous reçoit les mardis et vendredis 12 Rue Malautière pour des après-midi de jeux et de rencontres. uU repas à thème une fois par mois. \r\nUn voyage offert d'une journée."
    ],
    "nl": [
      "Onze club verwelkomt je op dinsdag en vrijdag in Rue Malautière 12 voor spelmiddagen en gezelligheid. UU themamaaltijd één keer per maand.\r\nEen gratis uitstapje."
    ],
    "es": [
      "Nuestro club le acoge los martes y viernes en el 12 de la rue Malautière para tardes de juegos y convivencia. uU comida temática una vez al mes.\r\nUna excursión gratuita."
    ]
  },
  "rdfs:label": {
