  "rdfs:comment": {
    "de": [
      "Die Mediathek/Spielothek in Perreux verfügt über einen schönen, hellen und geräumigen Raum, der für Groß und Klein gemacht ist. Jeder kann kostenlos und frei kommen, um zu lesen, in den bereitgestellten Büchern zu blättern und zu spielen."
    ],
    "en": [
      "The Perreux media/games library has a beautiful, bright and spacious space designed to accommodate young and old. Everyone can come and read for free, leaf through the books at their disposal, and play."
    ],
    "it": [
      "La mediateca e ludoteca di Perreux è uno spazio bellissimo, luminoso e spazioso, progettato per accogliere grandi e piccini. Tutti possono venire a leggere liberamente, sfogliare i libri a disposizione e giocare."
    ],
    "fr": [
      "La médiathèque/ludothèque de Perreux dispose d'un bel espace lumineux et spacieux fait pour accueillir petits et grands. Chacun peut venir gratuitement et librement lire, feuilleter les ouvrages mis à leur disposition, et jouer."
    ],
    "es": [
      "La mediateca y ludoteca de Perreux cuenta con un espacio bello, luminoso y amplio, diseñado para acoger a grandes y pequeños. Todo el mundo puede venir a leer libremente, hojear los libros que tiene a su disposición y jugar."
    ],
    "nl": [
      "De media- en spelotheek van Perreux heeft een mooie, lichte en ruime ruimte die ontworpen is om jong en oud te ontvangen. Iedereen kan vrij komen lezen, snuffelen en spelen."
    ]
  },
  "rdfs:label": {
