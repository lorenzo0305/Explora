  "rdfs:comment": {
    "de": [
      "Am Fuße des Dent de Crolles gelegen, heißt Sie diese familiengeführte Pizzeria herzlich willkommen. Lassen Sie sich auf der Terrasse nieder, nehmen Sie sich Zeit, die Aussicht zu bewundern und genießen Sie die großzügigen und mit Leidenschaft zubereiteten Pizzen."
    ],
    "en": [
      "Situated at the foot of the Dent de Crolles with a terrace offering beautiful views of the Chartreuse and Belledonne mountains.\r\nRestaurant separate from the bar.\r\nTerrace with park, children's play area and pétanque area nearby."
    ],
    "it": [
      "Situata ai piedi della Dent de Crolles, questa pizzeria a conduzione familiare offre un'accoglienza calorosa. Accomodatevi sulla terrazza, ammirate il panorama e assaporate le generose pizze preparate con passione."
    ],
    "fr": [
      "Située au pied de la Dent de Crolles, cette pizzeria familiale vous accueille en toute simplicité. Installez-vous en terrasse, prenez le temps d'admirer la vue et savourez des pizzas généreuses et préparées avec passion."
    ],
    "es": [
      "Situada a los pies del Dent de Crolles, esta pizzería familiar le ofrece una cálida bienvenida. Tome asiento en la terraza, admire las vistas y saboree las generosas pizzas preparadas con pasión."
    ],
    "nl": [
      "Gelegen aan de voet van de Dent de Crolles met een terras dat een prachtig uitzicht biedt op de bergen van de Chartreuse en de Belledonne.\r\nRestaurant gescheiden van de bar.\r\nTerras met park, speeltuin en petanque terrein vlakbij."
    ]
  },
  "rdfs:label": {
    "en": [
      "Sous la Dent pizzeria restaurant"
    ],
    "fr": [
      "Restaurant Pizzeria - Sous la Dent"
    ],
    "nl": [
      "Restaurant Pizzeria - Sous la Dent"
    ]
  },
