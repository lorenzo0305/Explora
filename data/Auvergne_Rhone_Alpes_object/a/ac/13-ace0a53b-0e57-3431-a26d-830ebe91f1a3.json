  "rdfs:comment": {
    "de": [
      "Die Kirche Saint-Barthélemy in Lans-en-Vercors ist eine katholische Kirche, ihr seitlicher Glockenturm stammt aus dem 16. bis 17. Jahrhundert. Dieser Glockenturm ist als historisches Denkmal eingetragen, während das Kirchenschiff, das 1896 wieder aufgebaut wurde, nur teilweise eingetragen ist."
    ],
    "en": [
      "St. Bartholomew's Church in Lans-en-Vercors is a Catholic church, its side bell tower dates back to the 16th-17th century. This bell tower is listed as a historical monument, whereas the nave, rebuilt in 1896, is only partially listed."
    ],
    "it": [
      "La chiesa di Saint-Barthélemy a Lans-en-Vercors è una chiesa cattolica con un campanile laterale risalente al XVI e XVII secolo. Il campanile è classificato come monumento storico, mentre la navata, ricostruita nel 1896, è classificata solo parzialmente."
    ],
    "fr": [
      "L'église Saint-Barthélemy de Lans-en-Vercors est une église catholique, son clocher latéral date du XVIe ‑ XVIIe siècle. Ce clocher est inscrit au titre des monuments historiques alors que la nef, reconstruite en 1896, ne l'est que partiellement."
    ],
    "es": [
      "La iglesia de Saint-Barthélemy, en Lans-en-Vercors, es una iglesia católica con un campanario lateral de los siglos XVI y XVII. El campanario está catalogado como monumento histórico, mientras que la nave, reconstruida en 1896, sólo está catalogada parcialmente."
    ],
    "nl": [
      "De kerk Saint-Barthélemy in Lans-en-Vercors is een katholieke kerk met een klokkentoren aan de zijkant uit de 16e en 17e eeuw. De torenspits staat op de monumentenlijst, terwijl het schip, herbouwd in 1896, slechts gedeeltelijk op de monumentenlijst staat."
    ]
  },
  "rdfs:label": {
    "de": [
      "Kirche Saint-Barthélémy"
    ],
    "en": [
      "St. Bartholomew's Church"
    ],
    "fr": [
      "Église Saint-Barthélémy"
    ]
  },
