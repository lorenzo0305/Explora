  "rdfs:comment": {
    "de": [
      "Biologisch bewirtschafteter Familienbauernhof mit einer Produktionsstätte für Beerenfrüchte (Erdbeeren, Himbeeren, schwarze Johannisbeeren, Johannisbeeren, Blaubeeren) und einer Produktionsstätte für Honig, Bienenstockprodukte (Pollen, Propolis, Lebkuchen, Nougat)."
    ],
    "en": [
      "Family-run organic farm with a berry production unit (strawberries, raspberries, blackcurrants, redcurrants, blueberries) and a production unit for honey, hive products (pollen, propolis, gingerbread, nougat)."
    ],
    "it": [
      "Azienda agricola biologica a conduzione familiare con unità di produzione di bacche (fragole, lamponi, ribes nero, ribes rosso, mirtilli) e unità di produzione di miele, prodotti dell'alveare (polline, propoli, panpepato, torrone)."
    ],
    "fr": [
      "Ferme familiale en agriculture biologique avec un atelier de production de petits fruits rouges (fraises, framboises, cassis, groseilles, bleuets) et un atelier de production de miel, produits de la ruche (pollen, propolis, pain d'épices, nougat)."
    ],
    "es": [
      "Granja ecológica familiar con una unidad de producción de bayas (fresas, frambuesas, grosellas negras, grosellas rojas, arándanos) y una unidad de producción de miel, productos de la colmena (polen, propóleo, pan de especias, turrón)."
    ],
    "nl": [
      "Biologische familieboerderij met een productie-eenheid voor bessen (aardbeien, frambozen, zwarte bessen, rode bessen, bosbessen) en een productie-eenheid voor honing, bijenkorfproducten (stuifmeel, propolis, ontbijtkoek, noga)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Gaec les baies du Lizieux"
    ]
  },
