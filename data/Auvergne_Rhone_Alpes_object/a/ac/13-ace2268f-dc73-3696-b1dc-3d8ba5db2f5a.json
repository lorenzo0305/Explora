  "rdfs:comment": {
    "de": [
      "Das Restaurant \"Le P'Tit petit bouchon de Longes\" empfängt Sie mit seinen traditionellen Gerichten, Pizzas, Burgern und seiner Froschspezialität in einer herzlichen und familiären Atmosphäre."
    ],
    "en": [
      "\"Le petit bouchon de Longes\" welcomes you with its traditional dishes, its pizzas, and its frog speciality in a warm and family atmosphere."
    ],
    "it": [
      "Il ristorante \"Le P'Tit petit bouchon de Longes\" vi accoglie con i suoi piatti tradizionali, le pizze, gli hamburger e la sua specialità di rane in un'atmosfera calda e familiare."
    ],
    "fr": [
      "Le Restaurant \"Le P'Tit petit bouchon de Longes\" vous accueille avec ses plats traditionnels, ses pizzas, ses burgers et sa spécialité grenouille dans une ambiance chaleureuse et familiale."
    ],
    "nl": [
      "Het restaurant \"Le P'Tit petit bouchon de Longes\" verwelkomt je met zijn traditionele gerechten, pizza's, hamburgers en zijn kikkerspecialiteit in een warme, familiale sfeer."
    ],
    "es": [
      "El restaurante \"Le P'Tit petit bouchon de Longes\" le da la bienvenida con sus platos tradicionales, pizzas, hamburguesas y su especialidad de rana en un ambiente cálido y familiar."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le P'Tit Bouchon de Longes"
    ]
  },
