  "rdfs:comment": {
    "de": [
      "Eine mühelose Fahrt durch das Herz von Vienne Condrieu ist möglich! Mit unseren Elektrofahrrädern, die Sie im Pavillon du Tourisme ausleihen können, können Sie die Gegend ganz einfach erkunden!"
    ],
    "en": [
      "Take an effortless ride through the heart of Vienne Condrieu! With our electric bikes for hire at the Tourism Pavilion, you can explore the area with ease!"
    ],
    "it": [
      "Pedalate senza fatica nel cuore di Vienne Condrieu! Con le nostre biciclette elettriche a noleggio presso il Padiglione del Turismo, potrete esplorare la zona con facilità!"
    ],
    "fr": [
      "Une balade sans effort au cœur de Vienne Condrieu, c’est possible ! Avec nos vélos électriques en location au Pavillon du tourisme, partez explorer le territoire en toute simplicité !"
    ],
    "es": [
      "Recorra sin esfuerzo el corazón de Vienne Condrieu Con nuestras bicicletas eléctricas de alquiler en el Pabellón de Turismo, podrá explorar la zona con facilidad"
    ],
    "nl": [
      "Maak moeiteloos een ritje door het hart van Vienne Condrieu! Met onze elektrische fietsen die je kunt huren bij het Paviljoen voor Toerisme, kun je de omgeving gemakkelijk verkennen!"
    ]
  },
  "rdfs:label": {
    "de": [
      "Standort von Elektrofahrrädern"
    ],
    "en": [
      "Electric bike rental"
    ],
    "fr": [
      "Location de vélos électriques à Vienne"
    ]
  },
