  "rdfs:comment": {
    "de": [
      "Fliegen Sie mit unserer 600 Meter langen Seilrutsche über den wunderschönen Lac Vert und genießen Sie die atemberaubende Aussicht auf den Mont Blanc! Zwischen Aime 2000 und Plagne Centre gelegen, garantiert Ihnen dieses einzigartige Erlebnis einen unvergesslichen Nervenkitzel."
    ],
    "en": [
      "Soar above the breathtaking Lac Vert and take in stunning views of Mont Blanc on our exhilarating 600-meter zip line! Located between Aime 2000 and Plagne Centre, this thrilling experience promises an unforgettable ride for adventure seekers."
    ],
    "it": [
      "Sorvolate il magnifico Lac Vert e ammirate le viste mozzafiato del Monte Bianco dalla nostra sensazionale teleferica di 600 metri! Situata tra Aime 2000 e Plagne Centre, questa esperienza unica garantisce emozioni indimenticabili"
    ],
    "fr": [
      "Volez au-dessus du magnifique Lac Vert et admirez la vue imprenable sur le Mont Blanc grâce à notre tyrolienne sensationnelle de 600 mètres! Située entre Aime 2000 et Plagne Centre, cette expérience unique vous garantit des sensations fortes inoubliables"
    ],
    "nl": [
      "Vlieg langs de prachtige Lac Vert en geniet van de adembenemende uitzichten op de Mont Blanc met onze sensationele zipline van 600 meter! Gelegen tussen Aime 2000 en Plagne Centre, garandeert deze unieke ervaring een onvergetelijk avontuur."
    ],
    "es": [
      "Sobrevuele el magnífico Lac Vert y admire las impresionantes vistas del Mont Blanc desde nuestra sensacional tirolina de 600 metros Situada entre Aime 2000 y Plagne Centre, esta experiencia única garantiza emociones inolvidables"
    ]
  },
  "rdfs:label": {
    "de": [
      "Super Tyro Tyrolienne"
    ],
    "en": [
      "Super Tyro zip line"
    ],
    "fr": [
      "Super Tyro Tyrolienne"
    ],
    "nl": [
      "Super Tyro tokkelbaan"
    ]
  },
