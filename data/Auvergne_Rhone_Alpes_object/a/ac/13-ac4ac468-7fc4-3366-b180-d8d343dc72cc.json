  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Bar Lounge, einen gemütlichen und eleganten Ort mit französischen Parkettböden, Samtsofas und gedämpftem Licht. Für Ihre romantischen Momente, Afterworks mit Kollegen oder festliche Abende wird dieser Ort Sie verführen."
    ],
    "en": [
      "Discover the Bar Lounge, a cosy, elegant venue with French parquet floors, velvet sofas and soft lighting. Whether you're looking for romantic moments, after-work get-togethers or festive evenings, this is the place to be."
    ],
    "it": [
      "Scoprite il Bar Lounge, un locale accogliente ed elegante con pavimenti in parquet francese, divani in velluto e luci soffuse. Che si tratti di momenti romantici, di incontri dopo il lavoro con i colleghi o di serate di festa, questo è il posto giusto."
    ],
    "fr": [
      "Découvrez le Bar Lounge, un lieu cosy et élégant avec ses parquets à la française, ses canapés de velours et ses lumières tamisées. Pour vos moments romantiques, vos afterworks entre collègues ou vos soirées festives ce lieu saura vous séduire."
    ],
    "nl": [
      "Ontdek de Bar Lounge, een gezellige, elegante ruimte met Franse parketvloeren, fluwelen sofa's en zachte verlichting. Of je nu op zoek bent naar romantische momenten, een borrel met collega's na het werk of feestelijke avonden, hier moet je zijn."
    ],
    "es": [
      "Descubra el Bar Lounge, un lugar acogedor y elegante con suelos de parqué francés, sofás de terciopelo y una iluminación tenue. Para momentos románticos, reuniones de trabajo o veladas festivas, este es el lugar ideal."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Bar Lounge - Grand Hôtel"
    ]
  },
