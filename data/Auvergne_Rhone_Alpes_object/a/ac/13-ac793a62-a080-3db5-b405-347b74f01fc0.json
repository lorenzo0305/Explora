  "rdfs:comment": {
    "de": [
      "Am Sandstrand von Excenevex, gegenüber dem Genfer See, bietet Ihnen das Restaurant und die Bar Le Smack eine große Auswahl an Pizzas, Salaten, Burgern und Spezialitäten. Große Auswahl an Eis und nicht zu vergessen unsere Themenabende"
    ],
    "en": [
      "On the sandy beach of Excenevex, in front of Lake Geneva , the restaurant - bar Smack proposes you a wide choice of pizzas, salads, burgers, pancakes, specialities of the lake. Today's special. Wide choice of ices creams, milkshakes, smoothies..."
    ],
    "it": [
      "Sulla spiaggia sabbiosa di Excenevex, di fronte al Lago di Ginevra, il ristorante-bar Le Smack vi offre un'ampia scelta di pizze, insalate, hamburger, specialità. Ampia scelta di gelati, senza dimenticare le nostre serate a tema"
    ],
    "fr": [
      "Sur la plage de sable d'Excenevex, face au lac Léman, le restaurant-bar Le Smack vous propose un large choix de pizzas, salades, burgers, spécialités. Large choix de glaces et sans oublier nos soirées à thème"
    ],
    "nl": [
      "Op het zandstrand van Excenevex, tegenover het meer van Genève, biedt restaurant-bar Le Smack u een ruime keuze aan pizza's, salades, hamburgers, specialiteiten. Ruime keuze aan ijsjes en niet te vergeten onze thema-avonden"
    ],
    "es": [
      "En la playa de arena de Excenevex, frente al lago de Ginebra, el restaurante-bar Le Smack le ofrece una amplia selección de pizzas, ensaladas, hamburguesas y especialidades. Amplia selección de helados y sin olvidar nuestras noches temáticas"
    ]
  },
