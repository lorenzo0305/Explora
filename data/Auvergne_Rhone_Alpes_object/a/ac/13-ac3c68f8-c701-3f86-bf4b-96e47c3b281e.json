  "rdfs:comment": {
    "de": [
      "Das Restaurant La Cozna lädt Sie ein, eine authentische und großzügige Küche durch hausgemachte Gerichte zu entdecken, in einer warmen und freundlichen Atmosphäre, im Herzen der Hostellerie du Petit-Saint-Bernard."
    ],
    "en": [
      "The La Cozna restaurant invites you to discover authentic, generous, home-cooked cuisine in a warm, friendly atmosphere in the heart of the Hostellerie du Petit-Saint-Bernard."
    ],
    "it": [
      "Il ristorante La Cozna vi invita a scoprire una cucina autentica e generosa con piatti fatti in casa, in un'atmosfera calda e accogliente, nel cuore dell'Hostellerie du Petit-Saint-Bernard."
    ],
    "fr": [
      "Le restaurant La Cozna vous invite à découvrir une cuisine authentique et généreuse à travers des plats faits maison, dans une ambiance chaleureuse et conviviale, au coeur de l'Hostellerie du Petit-Saint-Bernard."
    ],
    "nl": [
      "Het restaurant La Cozna nodigt u uit om de authentieke en gulle keuken met huisgemaakte gerechten te ontdekken, in een warme en gezellige sfeer, in het hart van het Hostellerie du Petit-Saint-Bernard."
    ],
    "es": [
      "El restaurante La Cozna le invita a descubrir una cocina auténtica y generosa con platos caseros, en un ambiente cálido y acogedor, en el corazón de la Hostellerie du Petit-Saint-Bernard."
    ]
  },
  "rdfs:label": {
