  "rdfs:comment": {
    "de": [
      "Die Brasserie Chavant befindet sich im Herzen der Stadt im historischen Gebäude Mille Pas. Die Speisekarte stammt von Chefkoch Paul Edouard Routhiau und empfängt Sie in einem schicken und eleganten Ambiente für ein Menü, ein Tagesgericht oder ein Wochenangebot."
    ],
    "en": [
      "Located in the heart of the city, in the historic Mille Pas building, Brasserie Chavant, whose menu is signed by chef Paul Edouard Routhiau, welcomes you in a chic and elegant setting for a menu, a dish of the day or a weekday special."
    ],
    "it": [
      "Situata nel cuore della città, nello storico edificio Mille Pas, la Brasserie Chavant, il cui menu è stato ideato dallo chef Paul Edouard Routhiau, vi accoglie in un ambiente elegante e raffinato per un menu, un piatto del giorno o uno speciale dei giorni feriali."
    ],
    "fr": [
      "Située en plein cœur de ville dans l'historique bâtiment Mille Pas, la Brasserie  Chavant, dont la carte est signée par le chef Paul Edouard Routhiau, vous accueille dans un univers chic et élégant pour un menu, un plat du jour ou une formule en semaine."
    ],
    "es": [
      "Situada en pleno centro de la ciudad, en el histórico edificio Mille Pas, la Brasserie Chavant, cuya carta ha sido diseñada por el chef Paul Edouard Routhiau, le da la bienvenida en un ambiente chic y elegante para degustar un menú, un plato del día o un especial entre semana."
    ],
    "nl": [
      "Gelegen in het hart van de stad in het historische Mille Pas gebouw, verwelkomt Brasserie Chavant, waarvan het menu is ontworpen door chef-kok Paul Edouard Routhiau, je in een chique en elegante omgeving voor een menu, een dagschotel of een weekdagspecial."
    ]
  },
