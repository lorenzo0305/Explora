    "de": [
      "Imbiss-Restaurant am Ausgangspunkt des Langlaufgebiets von La Livraz. Wir bieten Ihnen regionale Spezialitäten, die in gemütlicher Atmosphäre wie zu Hause zubereitet werden."
    ],
    "en": [
      "Restaurant-snack bar at the start of the Livraz cross-country ski area, offering regional specialities cooked just like at home."
    ],
    "it": [
      "Ristorante-snack bar all'inizio del comprensorio di sci di fondo La Livraz, che serve specialità regionali cucinate come a casa."
    ],
    "fr": [
      "Restaurant-snack au départ du domaine de ski de fond de la Livraz, nous vous proposons des spécialités régionales cuisinées à la bonne franquette, comme à la maison."
    ],
    "es": [
      "Restaurante-cafetería al inicio de la estación de esquí de fondo de Livraz, que sirve especialidades regionales cocinadas como en casa."
    ],
