  "rdfs:comment": {
    "de": [
      "Unter Denkmalschutz stehender romanischer Chor aus dem 12. Jahrhundert. Der Chor ist mit schönen Kapitellen mit Akanthusblättern und historisierenden Szenen geschmückt. Schöne Wandmalereien aus dem 16. und 17."
    ],
    "en": [
      "Dating from the 12th century, the Romanesque chancel is decorated with beautifully carved acanthus leaves and historical scenes on the capitals. Lovely painted murals from the 16th and 17th centuries."
    ],
    "it": [
      "Coro romanico del XII secolo. Il coro è decorato con bellissimi capitelli scolpiti con foglie d'acanto e scene istoriate. Bellissimi dipinti murali del XVI e XVII secolo."
    ],
    "fr": [
      "Choeur roman classé du XIIème siècle. Le choeur est orné de beaux chapiteaux sculptés de feuilles d'acanthe et de scènes historiées. Belles peintures murales des 16ème et 17ème sicècles."
    ],
    "nl": [
      "Romaans koor uit de 12e eeuw. Het koor is omgeven met historische kapitelen en fraai gebeeldhouwde acanthusbladeren. Schitterende muurschilderingen uit de 16e en 17e eeuw."
    ],
    "es": [
      "Coro románico catalogado del siglo XII. El coro está decorado con hermosos capiteles esculpidos con hojas de acanto y escenas historiadas. Hermosas pinturas murales de los siglos XVI y XVII."
    ]
  },
  "rdfs:label": {
    "fr": [
