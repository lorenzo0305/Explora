  "rdfs:comment": {
    "de": [
      "Haus des örtlichen Dichters und Verlegers Charles Forot."
    ],
    "en": [
      "House of the local poet and publisher Charles Forot."
    ],
    "it": [
      "Casa del poeta ed editore Charles FOROT, che fu l'ideatore e il motore del decentramento artistico e letterario dal 1920 al 1960.\r\nDa giugno a settembre, visite guidate, eventi e mostre"
    ],
    "fr": [
      "Maison du poète et de l’éditeur Charles FOROT qui fut le créateur et l’animateur d’une œuvre de décentralisation artistique et littéraire de 1920 à 1960. \r\nDe juin à septembre, visites guidées, animations, expos"
    ],
    "nl": [
      "In het familiehuis in Saint-Félicien, bekend als Le Pigeonnier, was Charles Forot de schepper en drijvende kracht achter een werk van artistieke en literaire decentralisatie dat zich uitstrekte van de jaren 1920 tot de jaren 1960. Zijn leven en werk worden hier gepresenteerd."
    ],
    "es": [
      "Casa del poeta y editor Charles FOROT, creador e impulsor de la descentralización artística y literaria de 1920 a 1960.\r\nDe junio a septiembre, visitas guiadas, actos y exposiciones"
    ]
  },
