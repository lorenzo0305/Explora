  "rdfs:comment": {
    "de": [
      "Die Touristeninformation von Thiers informiert Sie während Ihres Aufenthalts über alle Aktivitäten, Sehenswürdigkeiten, Handwerker und Produzenten, die es in der Gegend von Thiers und Livradois-Forez zu entdecken gibt."
    ],
    "en": [
      "The Thiers tourist information office will keep you informed during your stay about all the activities, sights, craftsmen and producers to discover in the Thiers and Livradois-Forez area."
    ],
    "it": [
      "L'ufficio informazioni turistiche di Thiers vi fornirà informazioni durante il vostro soggiorno su tutte le attività, i luoghi da visitare, gli artigiani e i produttori da scoprire nella zona di Thiers e Livradois-Forez."
    ],
    "fr": [
      "Le bureau d'information touristique de Thiers vous renseignera pendant votre séjour sur toutes les activités, les sites de visite, artisans, producteurs à découvrir sur le secteur de Thiers et du Livradois-Forez."
    ],
    "es": [
      "La oficina de turismo de Thiers le informará durante su estancia de todas las actividades, lugares que visitar, artesanos y productores que descubrir en la zona de Thiers y Livradois-Forez."
    ],
    "nl": [
      "Het VVV-kantoor van Thiers geeft je tijdens je verblijf informatie over alle activiteiten, bezienswaardigheden, ambachtslieden en producenten die je kunt ontdekken in de omgeving van Thiers en Livradois-Forez."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Maison du tourisme du Livradois-Forez - Bureau d'information de Thiers"
    ]
  },
