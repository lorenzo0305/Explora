  "rdfs:comment": {
    "de": [
      "Der Handballverein Loire Semène lädt Sie zu einer neuen Ausgabe des Sandballturniers in der Freizeitanlage ein, das unter dem Zeichen der Geselligkeit und des Sports im Freien steht."
    ],
    "en": [
      "The Loire Semène Handball Club invites you to the Base de Loisirs for another edition of its Sandball Tournament, a friendly, open-air event."
    ],
    "it": [
      "Il Loire Semène Handball Club vi aspetta al centro ricreativo per un'altra edizione del torneo di Sandball, che sarà un'ottima occasione per godere di un'atmosfera amichevole e di sport all'aria aperta."
    ],
    "fr": [
      "Le club de Handball de Loire Semène vous donne rendez-vous à la base de loisirs pour une nouvelle édition du tournoi de Sandball placé sous le signe de la convivialité et du sport en plein air."
    ],
    "es": [
      "El Club de Balonmano Loire Semène le espera en el centro de ocio para una nueva edición del Torneo de Balonmano de Arena, que será una gran oportunidad para disfrutar de un ambiente agradable y de los deportes al aire libre."
    ],
    "nl": [
      "De handbalclub Loire Semène kijkt ernaar uit om u te ontmoeten in het recreatiecentrum voor een nieuwe editie van het zandbaltoernooi, dat een geweldige gelegenheid zal zijn om te genieten van een gezellige sfeer en buitensporten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Tournoi de Sandball"
    ]
  },
