  "rdfs:comment": {
    "de": [
      "Ausgehend vom Weiler Le Buet schlängelt sich der neue Klettersteig Cascade de Bérard in einer frischen und belebenden Atmosphäre auf beiden Seiten der Schlucht des Torrent de Bérard."
    ],
    "en": [
      "Departing from the hamlet of Le Buet, the new via ferrata de la cascade de Bérard winds up and down the gorge of the torrent de Bérard in a fresh and invigorating atmosphere."
    ],
    "it": [
      "Partendo dalla frazione di Le Buet, la nuova via ferrata della cascata del Bérard si snoda su e giù per la gola del torrente Bérard in un'atmosfera fresca e tonificante."
    ],
    "fr": [
      "Au départ du hameau du Buet, la nouvelle via ferrata de la cascade de Bérard serpente de part et d'autre de la gorge du torrent de Bérard dans une ambiance fraîche et vivifiante."
    ],
    "nl": [
      "Vanuit het gehucht Le Buet slingert de nieuwe via ferrata bij de waterval van Bérard zich in een frisse en verkwikkende sfeer op en neer door de kloof van de rivier de Bérard."
    ],
    "es": [
      "Partiendo de la aldea de Le Buet, la nueva vía ferrata de la cascada de Bérard sube y baja por el desfiladero del torrente de Bérard en un ambiente fresco y tonificante."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Via Ferrata de la cascade de Bérard"
    ]
  },
