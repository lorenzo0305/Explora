  "rdfs:comment": {
    "de": [
      "Durchstreifen Sie ihn zwischen Dolinen, Almen und Unterholz, während Sie einen schönen Blick auf die Haute Chaîne du Jura haben, die zum Greifen nah zu sein scheint!\r\n\r\nZiel la Borne au Lion, eine Hochburg der französischen Résistance, eine schöne Geschichte, die es zu entdecken gilt."
    ],
    "en": [
      "Wind your way between alpine dolines and undergrowth, with a lovely view of the Haute Chaîne du Jura, which seems to be just around the corner!\r\n\r\nObjective la Borne au Lion, major site of the French Resistance, a beautiful story to discover."
    ],
    "it": [
      "Si snoda tra doline, alpeggi e sottobosco, con una bella vista sulla Haute Chaîne du Jura, che sembra essere dietro l'angolo!\r\n\r\nRaggiungete La Borne au Lion, luogo della Resistenza francese, e scoprite la sua storia."
    ],
    "fr": [
      "Sillonnez-le entre dolines, alpages et sous-bois tout en ayant une jolie vue sur la Haute Chaîne du Jura qui semble être à portée de main !\r\n\r\nObjectif la Borne au Lion, haut lieu de la Résistance Française, une belle histoire à découvrir."
    ],
    "es": [
      "Serpentee entre dolinas, pastos de montaña y maleza, con una hermosa vista de la Haute Chaîne du Jura, ¡que parece estar a la vuelta de la esquina!\r\n\r\nDiríjase a La Borne au Lion, lugar de la Resistencia francesa, y descubra su historia."
    ],
    "nl": [
      "Kronkel je een weg door dolines, bergweiden en kreupelhout, met een prachtig uitzicht op de Haute Chaîne du Jura, die om de hoek lijkt te liggen!\r\n\r\nZet koers naar La Borne au Lion, de plek van het Franse verzet, en ontdek de geschiedenis erachter."
    ]
  },
  "rdfs:label": {
    "en": [
      "Circuit VTTAE - Discover the Haut Jura - La Borne au Lion"
    ],
    "fr": [
      "Circuit VTTAE - À la découverte du Haut Jura - La Borne au Lion"
    ]
  },
