  "rdfs:comment": {
    "de": [
      "Familienbetrieb im Herzen des Dorfes mit 60 Milchkühen, die ausschließlich mit unserer Produktion (Weizen, Mais...) gefüttert werden. Ein Teil unserer Milch wird zu Käse verarbeitet."
    ],
    "en": [
      "Family farm in the heart of the village with 60 dairy cows fed exclusively from our production (wheat, corn...), transformation of part of our milk into cheese."
    ],
    "it": [
      "Azienda agricola a conduzione familiare nel cuore del paese con 60 mucche da latte alimentate esclusivamente con prodotti propri (grano, mais, ecc.); parte del latte viene trasformato in formaggio."
    ],
    "fr": [
      "Ferme familiale au cœur du village avec 60 vaches laitières nourries exclusivement de notre production (blé, maïs...), transformation d'une partie de notre lait en fromages."
    ],
    "es": [
      "Granja familiar en el corazón del pueblo con 60 vacas lecheras alimentadas exclusivamente con nuestros propios productos (trigo, maíz, etc.), parte de nuestra leche se transforma en queso."
    ],
    "nl": [
      "Familieboerderij in het hart van het dorp met 60 melkkoeien die uitsluitend worden gevoed met onze eigen producten (tarwe, maïs, enz.), een deel van onze melk wordt verwerkt tot kaas."
    ]
  },
