  "rdfs:comment": {
    "de": [
      "Der Festsaal von Bouthéon befindet sich im Herzen des Dorfes Bouthéon, in der Nähe der Victor-Hugo-Schule.\r\nKeine Vermietung an Privatpersonen. Wird nur an Vereine, Unternehmen und öffentliche Einrichtungen vermietet."
    ],
    "en": [
      "The salle des fêtes de Bouthéon is located in the heart of the village of Bouthéon, near the Victor Hugo school.\r\nNo rentals for individuals. Only available to associations, companies and public bodies."
    ],
    "it": [
      "La sala del villaggio di Bouthéon si trova nel cuore del villaggio di Bouthéon, vicino alla scuola Victor Hugo.\r\nNon è disponibile per il noleggio da parte di privati. Può essere affittata solo da associazioni, aziende ed enti pubblici."
    ],
    "fr": [
      "La salle des fêtes de Bouthéon est située au cœur du bourg de Bouthéon, à proximité de l’école Victor Hugo.\r\nPas de location pour les particuliers. Se loue uniquement aux associations, entreprises, organismes publics."
    ],
    "es": [
      "La sala municipal de Bouthéon está situada en el centro del pueblo de Bouthéon, cerca de la escuela Victor Hugo.\r\nNo se alquila a particulares. Sólo puede ser alquilada por asociaciones, empresas y organismos públicos."
    ],
    "nl": [
      "De dorpshal van Bouthéon ligt in het hart van het dorp Bouthéon, vlakbij de Victor Hugo school.\r\nHet is niet beschikbaar voor privéverhuur. Het kan alleen worden gehuurd door verenigingen, bedrijven en openbare instanties."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Salle des fêtes de Bouthéon"
    ]
  },
