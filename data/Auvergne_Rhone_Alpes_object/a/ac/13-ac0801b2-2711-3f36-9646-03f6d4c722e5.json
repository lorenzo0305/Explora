  "rdfs:comment": {
    "de": [
      "Auf dem Programm stehen Videospiele (Retro-Gaming und neue Konsolen), PC-Spiele, Virtual Reality, Origami, Bonsai, chinesische Kalligraphie, Cosplay und viele Überraschungen! Getränke und kleine Snacks vor Ort."
    ],
    "en": [
      "On the program: video games (retro gaming and new consoles), PC games, virtual reality, origami, bonsai, Chinese calligraphy, cosplay and lots of surprises! Refreshments and snacks on site."
    ],
    "it": [
      "In programma: videogiochi (retro gaming e nuove console), giochi per PC, realtà virtuale, origami, bonsai, calligrafia cinese, cosplay e tante sorprese! Rinfreschi e spuntini in loco."
    ],
    "fr": [
      "Au programme : jeux vidéo (retro gaming et nouvelles consoles), jeux PC, réalité virtuelle, origami, bonsai, calligraphie chinoise, cosplay et plein de surprises ! Buvette et petite restauration sur place."
    ],
    "nl": [
      "Op het programma: videogames (retro gaming en nieuwe consoles), pc-games, virtual reality, origami, bonsai, Chinese kalligrafie, cosplay en veel verrassingen! Versnaperingen en snacks ter plaatse."
    ],
    "es": [
      "En el programa: videojuegos (retro y nuevas consolas), juegos de PC, realidad virtual, papiroflexia, bonsáis, caligrafía china, cosplay y muchas sorpresas Refrescos y tentempiés in situ."
    ]
  },
