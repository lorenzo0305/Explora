  "rdfs:comment": {
    "de": [
      "Das Team aus vier herzlichen Freiwilligen empfängt Sie, um einen Moment, einen Kaffee und seine Favoriten mit Ihnen zu teilen.\r\nDie Bibliotheken bieten das ganze Jahr über Veranstaltungen an."
    ],
    "en": [
      "The team of 4 friendly volunteers will welcome you to share a moment, a coffee and their favorites.\r\nThe libraries offer activities throughout the year."
    ],
    "it": [
      "Il team di 4 amichevoli volontari vi accoglierà per condividere un momento, un caffè e i loro preferiti.\r\nLe biblioteche offrono attività durante tutto l'anno."
    ],
    "fr": [
      "L'équipe de 4 bénévoles chaleureux vous accueillera pour partager un moment, un café et ses coups de cœur.\r\nLes bibliothèques proposent des animations tout au long de l'année."
    ],
    "nl": [
      "Het team van 4 vriendelijke vrijwilligers verwelkomt u voor een moment, een koffie en hun favorieten.\r\nDe bibliotheken bieden het hele jaar door activiteiten aan."
    ],
    "es": [
      "El equipo de 4 amables voluntarios le recibirá para compartir un momento, un café y sus favoritos.\r\nLas bibliotecas ofrecen actividades durante todo el año."
    ]
  },
