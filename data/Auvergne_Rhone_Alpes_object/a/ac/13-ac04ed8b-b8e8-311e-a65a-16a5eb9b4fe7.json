  "rdfs:comment": {
    "de": [
      "Wandern Sie mit einem Packesel für 1 Tag oder mehrere Tage in den Schluchten der Ardèche. Einen Tag lang können Sie 7 bis 10 km in den Hügeln wandern oder 2 bis 8 Tage lang von Staffel zu Staffel die Schluchten der Ardèche entdecken."
    ],
    "en": [
      "Hiking with a pack donkey for 1 day or several days in the Ardèche Gorges. For a day, set off on a 7 to 10 km walk in the hills, or for 2 to 8 days, from relay to relay, discover the Gorges de l'Ardèche."
    ],
    "it": [
      "Escursione con un asino da soma per 1 giorno o più giorni nelle Gole dell'Ardeche. Per un giorno, fate una passeggiata di 7-10 km sulle colline o per 2-8 giorni, di staffetta in staffetta, scoprite le Gole dell'Ardeche."
    ],
    "fr": [
      "Randonnée avec un âne de bât pour 1 journée ou plusieurs jours dans les Gorges de l'Ardèche. A la journée, partez sur 7 à 10 km de marche dans la colline ou bien de 2 à 8 jours de relais en relais découvrez les Gorges de l'Ardèche."
    ],
    "nl": [
      "Wandelen met een pakezel voor 1 dag of meerdere dagen in de Gorges de l'Ardèche. Trek er een dag op uit voor een wandeling van 7 tot 10 km in de heuvels, of ontdek gedurende 2 tot 8 dagen, van estafette tot estafette, de Gorges de l'Ardèche."
    ],
    "es": [
      "Senderismo con un burro de carga durante 1 día o varios días en las Gargantas del Ardeche. Durante un día, haga una caminata de 7 a 10 km por las colinas o durante 2 a 8 días, de relevo en relevo, descubra las Gargantas del Ardèche."
    ]
  },
