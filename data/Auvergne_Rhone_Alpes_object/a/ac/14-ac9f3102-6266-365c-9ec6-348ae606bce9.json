  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/b54703cb-df12-34f5-b9b1-308b1844b8fb",
      "dc:description": {
        "de": [
          "Unterhaltung durch Phil Deco!\n\nVersuchen Sie Ihr Glück in einer freundlichen und herzlichen Atmosphäre\nEs gibt viele Preise zu gewinnen: Geschenkkörbe, Einkaufsgutscheine usw.\n\nGute Laune garantiert!\n\nIm Quillier von Vieil-Moutier\n\nGetränke und kleine Snacks vor Ort."
        ],
        "en": [
          "Entertainment by Phil Deco!\n\nCome and try your luck in a warm and friendly atmosphere\nLots of prizes to be won: gift baskets, vouchers, etc.\n\nGreat fun guaranteed!\n\nAt the Vieil-Moutier Quillier\n\nRefreshments and snacks on site."
        ],
        "it": [
          "Intrattenimento a cura di Phil Deco!\n\nVenite a tentare la fortuna in un'atmosfera calda e accogliente\nIn palio tanti premi: cesti regalo, buoni spesa, ecc.\n\nBuon umore garantito!\n\nAl Quillier Vieil-Moutier\n\nRinfreschi e spuntini in loco."
        ],
        "fr": [
          "Animation assurée par Phil Deco !\n\nVenez tenter votre chance dans une ambiance conviviale et chaleureuse \nDe nombreux lots à gagner: paniers garnis, bons d'achat, etc.\n\nBonne humeur garantie ! \n\nAu Quillier de Vieil-Moutier\n\nBuvette et petite restauration sur place."
        ],
        "es": [
          "¡Entretenimiento a cargo de Phil Deco!\n\nVen a probar suerte en un ambiente cálido y acogedor\nMuchos premios para ganar: cestas de regalo, vales de compra, etc.\n\nBuen humor garantizado\n\nEn el Quillier Vieil-Moutier\n\nRefrescos y tentempiés in situ."
        ],
        "nl": [
          "Entertainment door Phil Deco!\n\nKom je geluk beproeven in een warme en gezellige sfeer\nEr zijn veel prijzen te winnen: cadeaumanden, winkelbonnen, enz.\n\nHumor gegarandeerd!\n\nBij de Quillier Vieil-Moutier\n\nVersnaperingen en snacks ter plaatse."
        ]
      },
