  "rdfs:comment": {
    "de": [
      "Weingut im Familienbesitz. Weinproben, önotouristische Aktivitäten mit Familie oder Freunden. Schatzsuche «Der verlorene Schatz der Gravennes» und Escape BOX «Die geheimnisvolle Box»!"
    ],
    "en": [
      "Wine-tasting cellar, wine tourism activities as a family or with friends. Treasure hunt: «The Lost Treasure of the Gravennes» and escape game «The Mystery Box»!"
    ],
    "it": [
      "Nel 1996, Bernadette e Jean hanno creato il Domaine des Gravennes, partendo dai vigneti di famiglia situati nella Drôme Provençale.\r\nNel 2014, Luc e Rémi, i due figli, hanno unito le forze e dato un nuovo impulso."
    ],
    "fr": [
      "En 1996, Bernadette et Jean créent le Domaine des Gravennes, issu de vignes familiales situées en Drôme provençale.\r\nEn 2014, Luc et Rémi, les deux fils s’associent et donnent un nouvel élan."
    ],
    "nl": [
      "Familiedomein. Proeverij in de kelder, wijntoeristische activiteiten met familie en vrienden. Schatzoeken «Le Trésor perdu des Gravennes» (De verloren schat van de Gravennes) en Zone BOX «La Boîte Mystère» (De Mysterieuze Doos) !"
    ],
    "es": [
      "En 1996, Bernadette y Jean crearon el Domaine des Gravennes, a partir de viñedos familiares situados en la Drôme provenzal.\r\nEn 2014, Luc y Rémi, los dos hijos, unieron sus fuerzas y dieron un nuevo impulso."
    ]
  },
