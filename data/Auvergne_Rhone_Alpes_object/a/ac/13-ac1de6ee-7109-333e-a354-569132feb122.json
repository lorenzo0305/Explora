  "rdfs:comment": {
    "de": [
      "Das Atelier Soubrier befindet sich in einem alten Gebäude in Cantaloupe, am Fuße eines Wanderwegs, am Rande eines Waldes und gegenüber dem Lac des graves, im Jordanne-Tal, das Aurillac mit dem Puy Mary und den Monts du Cantal verbindet."
    ],
    "en": [
      "L'Atelier Soubrier is nestled in an old Cantalien building, at the foot of a hiking trail, on the edge of a wood and facing Lac des Graves, in the Jordanne valley that links Aurillac to Puy Mary and the Monts du Cantal."
    ],
    "it": [
      "L'Atelier Soubrier si trova in un antico edificio cantaliero, ai piedi di un sentiero escursionistico, ai margini di un bosco e di fronte al Lac des Graves, nella valle del Jordanne che collega Aurillac a Puy Mary e ai Monts du Cantal."
    ],
    "fr": [
      "Dans une ancienne bâtisse cantaloue, au pied d’un chemin de randonnée, à l’orée d’un bois et face au lac des graves, c’est niché dans la vallée de la Jordanne qui lie Aurillac au Puy Mary et aux Monts du Cantal que l’on trouve L’Atelier Soubrier."
    ],
    "nl": [
      "L'Atelier Soubrier is gevestigd in een oud Cantalien gebouw, aan de voet van een wandelpad, aan de rand van een bos en tegenover het Lac des Graves, in de Jordanne vallei die Aurillac verbindt met Puy Mary en de Monts du Cantal."
    ],
    "es": [
      "L'Atelier Soubrier está ubicado en un antiguo edificio cantaliense, al pie de una ruta de senderismo, al borde de un bosque y frente al Lac des Graves, en el valle del Jordanne que une Aurillac con Puy Mary y los Montes del Cantal."
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'atelier Soubrier"
    ]
  },
