  "rdfs:comment": {
    "de": [
      "Les Artpenteuses ist eine Designerboutique mit 13 Künstlern und Kunsthandwerkern aus Lyon, die seit mehr als 15 Jahren an den Hängen des Croix-Rousse vertreten sind."
    ],
    "en": [
      "Les Artpenteuses is a designer boutique that brings together 13 Lyon-based artists and craftspeople who have been working on the slopes of the Croix-Rousse for over 15 years."
    ],
    "it": [
      "Les Artpenteuses è una boutique di design che riunisce 13 artisti e artigiani lionesi che lavorano alle pendici della Croix-Rousse da oltre 15 anni."
    ],
    "fr": [
      "Les Artpenteuses c'est une boutique de créateurs qui regroupe 13 artistes et artisans Lyonnais, présents sur les pentes de la Croix-Rousse depuis plus de 15 ans."
    ],
    "nl": [
      "Les Artpenteuses is een designerboetiek die 13 in Lyon gevestigde kunstenaars en ambachtslieden samenbrengt die al meer dan 15 jaar op de hellingen van de Croix-Rousse werken."
    ],
    "es": [
      "Les Artpenteuses es una boutique de diseño que reúne a 13 artistas y artesanos lioneses que trabajan en las laderas de la Croix-Rousse desde hace más de 15 años."
