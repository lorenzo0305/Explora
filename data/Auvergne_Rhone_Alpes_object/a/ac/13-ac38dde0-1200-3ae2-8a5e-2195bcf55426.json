  "rdfs:comment": {
    "de": [
      "Zusätzlich zu den Besuchen in der Werkstatt (nach telefonischer Vereinbarung) nehmen Sie samstags und sonntags von 10:00 bis 12:00 Uhr an Drechselvorführungen teil."
    ],
    "en": [
      "In addition to visits to the workshop (by appointment by telephone), take part in turning demonstrations on Saturday and Sunday from 10am to 12pm."
    ],
    "it": [
      "Oltre a visitare il laboratorio (su appuntamento telefonico), è possibile partecipare a dimostrazioni di tornitura il sabato e la domenica dalle 10.00 alle 12.00."
    ],
    "fr": [
      "En plus des visites à l'atelier (sur rendez-vous par téléphone), participez à des démonstrations de tournage les samedi et dimanche de 10h à 12h."
    ],
    "nl": [
      "Naast een bezoek aan de werkplaats (op telefonische afspraak) kun je op zaterdag en zondag van 10.00 tot 12.00 uur deelnemen aan draaidemonstraties."
    ],
    "es": [
      "Además de visitar el taller (previa cita por teléfono), podrá participar en demostraciones de torneado el sábado y el domingo de 10.00 a 12.00 horas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Démonstration et visite, Cathy Marre céramiste #1 - Journées Européennes des Métiers d'Art"
    ]
  },
