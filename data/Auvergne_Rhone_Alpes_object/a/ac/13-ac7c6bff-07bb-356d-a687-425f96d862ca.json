  "rdfs:comment": {
    "de": [
      "Ruhige Entdeckung des Schlittschuhlaufens für Anfänger jeden Alters. Für Kleinkinder können Schlittschuhe ausgeliehen werden.\r\nZahlreiche Accessoires zum Erlernen des Schlittschuhlaufens stehen zur Verfügung."
    ],
    "en": [
      "A peaceful way for beginners of all ages to discover skating. Loan of skates for toddlers. \r\nLots of accessories to help you learn to skate."
    ],
    "it": [
      "Un modo tranquillo per i principianti di tutte le età di scoprire il pattinaggio. Prestito di pattini per bambini.\r\nTanti accessori per imparare a pattinare."
    ],
    "fr": [
      "Découverte en toute tranquillité du patinage pour les débutants de tout âge. Prêt de patinettes possible pour les tout-petits. \r\nNombreux accessoires à disposition pour l'apprentissage du patinage."
    ],
    "es": [
      "Una forma tranquila de descubrir el patinaje para principiantes de todas las edades. Préstamo de patines para niños pequeños.\r\nMuchos accesorios para aprender a patinar."
    ],
    "nl": [
      "Een rustige manier voor beginners van alle leeftijden om het schaatsen te ontdekken. Uitleen van schaatsen voor peuters. \r\nVeel accessoires om te leren schaatsen."
    ]
  },
  "rdfs:label": {
    "en": [
      "Ice Garden at the Samoëns Skating Rink"
    ],
    "fr": [
      "Jardin de glace à la Patinoire de Samoëns"
    ],
    "nl": [
      "IJstuin op de ijsbaan van Samoëns"
    ]
  },
