  "rdfs:comment": {
    "de": [
      "Lust auf einen Ausflug? Nehmen Sie die ViaRhôna für einen Tag oder einen halben Tag, um die Nuggets der Region zu entdecken! Begeben Sie sich zum Pavillon du tourisme, um Ihren Reisebegleiter zu mieten und sich ins Abenteuer zu stürzen!"
    ],
    "en": [
      "Looking to get away from it all? Take the ViaRhôna for a day or half-day to discover the region's hidden treasures! Go to the Tourism Pavilion to hire your travel companion and set off on an adventure!"
    ],
    "it": [
      "Volete allontanarvi da tutto? Prendete la ViaRhôna per una giornata o mezza giornata per scoprire i tesori nascosti della regione! Recatevi al Padiglione del Turismo per noleggiare il vostro compagno di viaggio e partite all'avventura!"
    ],
    "fr": [
      "Envie d’évasion ? Empruntez la ViaRhôna le temps d’une journée ou d’une demi-journée pour découvrir les pépites du territoire ! Rendez-vous au Pavillon du tourisme pour louer votre compagnon de route et partez à l’aventure !"
    ],
    "es": [
      "¿Quiere alejarse de todo? Tome el ViaRhôna durante un día o medio día para descubrir los tesoros ocultos de la región Acérquese al Pabellón de Turismo para contratar a su compañero de viaje y láncese a la aventura"
    ],
    "nl": [
      "Wil je er even helemaal tussenuit? Neem de ViaRhôna voor een dag of een halve dag en ontdek de verborgen schatten van de regio! Ga naar het Paviljoen voor Toerisme om je reisgenoot te huren en ga op avontuur!"
    ]
  },
  "rdfs:label": {
    "de": [
      "Fahrad verleih"
    ],
    "en": [
      "Bike rental"
    ],
    "fr": [
      "Location de vélos mécaniques à Vienne"
    ]
  },
