  "rdfs:comment": {
    "de": [
      "Im Saal Eugène Verdun finden im Laufe des Jahres verschiedene Termine statt: Ausstellungen, Konferenzen, Seminare, Versammlungen, Foren, Aufführungen, Essen, Weihnachtsmarkt, Blutspenden usw."
    ],
    "en": [
      "The Salle Eugène Verdun hosts a variety of events throughout the year: exhibitions, conferences, seminars, meetings, forums, shows, meals, Christmas markets, blood drives, etc."
    ],
    "it": [
      "La Salle Eugène Verdun ospita una serie di eventi durante tutto l'anno: mostre, conferenze, seminari, incontri, forum, spettacoli, pasti, mercatino di Natale, donazioni di sangue, ecc."
    ],
    "fr": [
      "La salle Eugène Verdun accueille divers rendez-vous pendant l'année : expositions, conférences, séminaires, réunions, forums, spectacles, repas, marché de noël, don du sang, etc."
    ],
    "es": [
      "La Salle Eugène Verdun acoge diversos actos a lo largo del año: exposiciones, conferencias, seminarios, reuniones, foros, espectáculos, comidas, el mercado de Navidad, donaciones de sangre, etc."
    ],
    "nl": [
      "In de Salle Eugène Verdun vinden het hele jaar door verschillende evenementen plaats: tentoonstellingen, conferenties, seminars, vergaderingen, forums, shows, maaltijden, de kerstmarkt, bloeddonaties, enz."
    ]
