  "rdfs:comment": {
    "de": [
      "\"Ich baue mit Liebe und Leidenschaft etwa 40 Gemüse- und Kräuterpflanzen an, die den Geschmack von früher und heute (wieder) entdecken lassen! \""
    ],
    "en": [
      "\"With love and passion, I grow forty or so vegetables and aromatic plants to help you (re)discover the flavors of yesteryear and today! \""
    ],
    "it": [
      "\"Coltivo con amore e passione una quarantina di ortaggi e piante aromatiche, aiutandovi a (ri)scoprire i sapori di un tempo e di oggi! \""
    ],
    "fr": [
      "\" Je cultive avec amour et passion une quarantaine de légumes et plantes aromatiques faisant (re)découvrir les saveurs d'antan et d'aujourd'hui ! \""
    ],
    "nl": [
      "\"Ik kweek zo'n veertig groenten en aromatische planten met liefde en passie en help je de smaken van vroeger en nu te (her)ontdekken! \""
    ],
    "es": [
      "\"Cultivo unas cuarenta hortalizas y plantas aromáticas con amor y pasión, ¡para ayudarle a (re)descubrir los sabores de antaño y de hoy! \""
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les jardins de lumière"
    ]
  },
