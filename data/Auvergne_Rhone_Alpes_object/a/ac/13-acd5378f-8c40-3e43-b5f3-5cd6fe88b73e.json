  "rdfs:comment": {
    "de": [
      "Ein einzigartiger Ort der Begegnung und des Austauschs, um die fantastische Welt der Gesellschaftsspiele zu entdecken! Kommen Sie mit dem Zauberbus, Freude und Lachen garantiert. Kommen Sie allein, mit der Familie oder mit Freunden. Gesellschaftsspiele ab 4 Jahren."
    ],
    "en": [
      "A unique place to meet and share, and discover the fantastic world of board games! Come along on the magic bus, and enjoy the fun and laughter. Come alone, with family or friends. Board games for ages 4 and up."
    ],
    "it": [
      "Un luogo unico di incontro e condivisione per scoprire il fantastico mondo dei giochi da tavolo! Salite sul bus magico, gioia e risate garantite. Venite da soli, con la famiglia o con gli amici. Giochi da tavolo a partire dai 4 anni."
    ],
    "fr": [
      "Un lieu unique de rencontre et de partage pour découvrir l'univers fantastique du jeu de société ! Venez dans le bus magique, joie et rire assurés. Venez seul, en famille ou entre amis. Jeux de société à partir de 4 ans."
    ],
    "es": [
      "¡Un lugar único para reunirse y compartir para descubrir el fantástico mundo de los juegos de mesa! Ven en el autobús mágico, alegría y risas garantizadas. Venga solo, en familia o con amigos. Juegos de mesa a partir de 4 años."
    ],
    "nl": [
      "Een unieke plek om elkaar te ontmoeten en de fantastische wereld van bordspellen te ontdekken! Kom mee met de magische bus en geniet van gegarandeerd plezier en gelach. Kom alleen, met familie of vrienden. Gezelschapsspellen voor kinderen vanaf 4 jaar."
    ]
  },
  "rdfs:label": {
    "fr": [
      "A Bus'E des jeux"
    ]
  },
