  "rdfs:comment": {
    "de": [
      "Der Landschaftsgarten befindet sich am Fuße der Berge von Flandern. Hier finden Sie verschiedene Beete mit Stauden, Gräsern und Blumenzwiebeln der Saison sowie einen kleinen Gemüsegarten in einem Gehege."
    ],
    "en": [
      "The landscaped garden is located at the foot of the Flanders mountains. You will discover various beds of perennials, grasses and seasonal bulbs as well as a small vegetable garden in an enclosure."
    ],
    "it": [
      "Il giardino paesaggistico si trova ai piedi delle montagne delle Fiandre. Scoprirete diverse aiuole di piante perenni, erbe e bulbi stagionali, oltre a un piccolo orto in un recinto."
    ],
    "fr": [
      "Le jardin paysagé se situe au pied des monts de Flandres. Vous y découvrirez différents massifs de vivaces, de graminées et de bulbes de saison ainsi qu'un petit potager en enclos."
    ],
    "es": [
      "El jardín paisajista está situado al pie de las montañas de Flandes. Descubrirá varios parterres de plantas vivaces, gramíneas y bulbos de temporada, así como un pequeño huerto en un recinto."
    ],
    "nl": [
      "De aangelegde tuin ligt aan de voet van het Vlaamse gebergte. U ontdekt er verschillende perken met vaste planten, grassen en seizoensbollen en een kleine moestuin in een omheining."
    ]
  },
