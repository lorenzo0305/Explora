      "dc:description": {
        "de": [
          "Informationen :\n\nTage der Öffnung:\nMontag bis Samstag von 9:00 bis 13:00 Uhr zur Abholung von Bestellungen\n \n Bestellungen:\n\nClick and chocolate: Online-Shop oder per Telefon\n\n\n\n\n "
        ],
        "en": [
          "Information :\n\nOpening days:\nMonday to Saturday, 9am to 1pm for order collection\n \n Orders :\n\nClick and chocolate: online store or by phone\n\n\n\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura:\nDal lunedì al sabato, dalle 9.00 alle 13.00 per il ritiro degli ordini\n \n Ordini :\n\nClick and chocolate: negozio online o per telefono\n\n\n\n\n "
        ],
        "fr": [
          "Informations :\n\nJours d'ouverture:\nDu lundi au samedi de 9h à 13h pour le retrait des commandes\n \n Commandes :\n\nClick and chocolate : boutique en ligne ou par téléphone\n\n\n\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen:\nMaandag tot zaterdag van 9u tot 13u voor afhaling van bestellingen\n \n Bestellingen :\n\nClick and chocolate: online shop of telefonisch\n\n\n\n\n "
        ],
        "es": [
          "Más información :\n\nDías de apertura:\nDe lunes a sábado de 9 a 13 h para la recogida de pedidos\n \n Pedidos :\n\nClick and chocolate: tienda online o por teléfono\n\n\n\n\n "
        ]
      },
