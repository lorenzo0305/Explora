  "rdfs:comment": {
    "de": [
      "Domaine Large, Beaujo Villages.\nMontmelas, sein Vorort als Spielterroir, Crus, um ein wenig zu reisen.\n7ha in Hanglage: Chardo & Gamay Noir.\nDavid, ein Kind aus Beaujolais, seit 2012 am Ruder.\nCélia, Wechsel aus dem Süden 2019 für eine Team-Kombo"
    ],
    "en": [
      "Domaine Large, Beaujo Villages.\nMontmelas, its outskirts as playgrounds for terroirs, some crus to travel a bit.\n7ha of slopes: chardo & gamay noir.\nDavid, a Beaujolais native, at the helm since 2012.\nCélia, join the advventure in 2019 for a team combo"
    ],
    "it": [
      "Domaine Large, Beaujo Villages.\nMontmelas e i suoi sobborghi come terroir con cui giocare, crus per viaggiare un po'.\n7ha di pendii: Chardo e Gamay Noir.\nDavid, figlio del Beaujolais, è al timone dal 2012.\nCélia, trasferitasi a sud nel 2019 per una combinazione di team"
    ],
    "fr": [
      "Domaine Large, Beaujo Villages.\nMontmelas, sa banlieue pour terroirs de jeu, des crus pour voyager un peu.\n7ha en pentes : chardo & gamay noir.\nDavid, enfant beaujolois, aux manettes depuis 2012.\nCélia, transfert sudiste en 2019 pour un combo en équipe"
    ],
    "es": [
      "Domaine Large, Beaujo Villages.\nMontmelas y sus suburbios como terroirs para jugar, crus para viajar un poco.\n7ha de laderas: Chardo & Gamay Noir.\nDavid, hijo de Beaujolais, lleva el timón desde 2012.\nCélia, traslado al sur en 2019 para un combo de equipo"
    ],
    "nl": [
      "Domaine Large, Beaujo Villages.\nMontmelas en zijn buitenwijken als terroirs om mee te spelen, crus om een beetje te reizen.\n7ha hellingen: Chardo & Gamay Noir.\nDavid, kind van de Beaujolais, staat sinds 2012 aan het roer.\nCélia, die in 2019 naar het zuiden verhuist voor een teamcombo"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Domaine Célia & David LARGE"
    ]
  },
