  "rdfs:comment": {
    "de": [
      "Mit Vénéon Eaux Vives entdecken Sie eine Vielzahl von Aktivitäten auf dem türkisfarbenen Wasser des Vénéon!\r\nAuf dem Programm stehen Rafting, Hydrospeed, Hot Dogs und vieles mehr.\r\nSchnupperangebote und Kurse, um mit der Familie oder mit Freunden zu fahren!\r\nTolle Erinnerungen in Sicht!"
    ],
    "en": [
      "Discover a host of activities on the turquoise waters of the Vénéon with Vénéon Eaux Vives!\r\nOn the program: rafting, hydrospeed, hot-dogging and much more.\r\nDiscovery packages and courses for families and friends!\r\nGreat memories!"
    ],
    "it": [
      "Con Vénéon Eaux Vives scoprite una serie di attività sulle acque turchesi del Vénéon!\r\nIn programma, rafting, hydrospeed, hot-dog e molti altri.\r\nPacchetti di scoperta e corsi di formazione, per navigare in famiglia o con gli amici!\r\nGrandi ricordi in vista!"
    ],
    "fr": [
      "Avec Vénéon Eaux Vives découvrez une foule d’activités sur les eaux turquoises du Vénéon !\r\nAu programme, rafting, hydrospeed, hot-dog, et bien d'autres.\r\nFormules découverte et stages, pour naviguer en famille ou entre amis ! \r\nSupers souvenirs en vue !"
    ],
    "nl": [
      "Ontdek een heleboel activiteiten op het turquoise water van de Vénéon met Vénéon Eaux Vives!\r\nOp het programma: raften, hydrospeed, hot-dogging en nog veel meer.\r\nOntdekkingsarrangementen en cursussen voor gezinnen en vrienden!\r\nMooie herinneringen in het vooruitzicht!"
    ],
    "es": [
      "Con Vénéon Eaux Vives descubra un sinfín de actividades en las aguas turquesas del Vénéon\r\nEn el programa, rafting, hidrospeed, hot-dog, y muchos otros.\r\nPaquetes de descubrimiento y cursos de formación, para navegar con la familia o los amigos\r\n¡Grandes recuerdos a la vista!"
    ]
  },
