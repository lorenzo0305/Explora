  "rdfs:comment": {
    "de": [
      "La Ferme des Genêts bietet Ihnen eine Reihe von Früchten (Kastanien, Äpfel, Beeren) und Nebenprodukten, die auf dem Bauernhof in Werkstätten im Freien verarbeitet werden (Kastanienkonfitüren, Apfelsaft,. . . ). Der Betrieb ist in biologischer Landwirtschaft."
    ],
    "en": [
      "The Ferme des Genêts offers a range of fruits (chestnuts, apples, berries) and derived products, processed on the farm in outdoor workshops (chestnut jams, apple juice, ...). The farm is in organic farming."
    ],
    "it": [
      "La Ferme des Genêts offre frutta, verdura e piante (prodotti a base di castagne, marmellate, succhi, piante secche, idrolati), lavorati in azienda e in laboratori esterni. La fattoria è certificata biologica."
    ],
    "fr": [
      "La Ferme des genêts vous propose des fruits et légumes et des plantes  (produits à base de châtaigne, confiture, jus , plantes séchées, hydrolat), transformés à la ferme et dans des ateliers extérieurs. L'exploitation est en agriculture biologique."
    ],
    "es": [
      "La Ferme des Genêts ofrece frutas, verduras y plantas (productos a base de castañas, mermelada, zumo, plantas secas, hidrolato), transformadas en la granja y en talleres externos. La granja cuenta con certificación ecológica."
    ],
    "nl": [
      "La Ferme des Genêts biedt groenten en fruit en bijproducten (producten op basis van kastanjes, jam, sap, compote, gedroogde planten), verwerkt op de boerderij en in externe werkplaatsen. De boerderij is biologisch gecertificeerd."
    ]
  },
