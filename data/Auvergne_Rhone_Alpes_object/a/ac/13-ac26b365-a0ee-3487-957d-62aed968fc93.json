  "rdfs:comment": {
    "de": [
      "Wenc, ein staatlich geprüfter Architekt, ist ein aus Belgien stammender Street Artist, der in Lyon lebt und arbeitet. Er schuf Flore du lac auf der Wand des Office de Tourisme im Jahr 2022."
    ],
    "en": [
      "Wenc, a qualified architect, is a street artist from Belgium who lives and works in Lyon. He created Flore du lac on the wall of the Tourist Office in 2022."
    ],
    "it": [
      "Wenc, architetto diplomato, è uno street artist belga che vive e lavora a Lione. Ha realizzato Flore du lac sul muro dell'Ufficio del Turismo nel 2022."
    ],
    "fr": [
      "Wenc, architecte diplômé d’état, est un street artiste  originaire de Belgique qui vit et travaille à Lyon. Il a crée Flore du lac sur le mur de l'Office de Tourisme en 2022."
    ],
    "nl": [
      "Wenc, een gediplomeerd architect, is een straatkunstenaar uit België die woont en werkt in Lyon. Hij maakte Flore du lac op de muur van het Office du Tourisme in 2022."
    ],
    "es": [
      "Wenc, arquitecto diplomado, es un artista callejero belga que vive y trabaja en Lyon. Creó Flore du lac en la pared de la Oficina de Turismo en 2022."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Fresques et murs peints - Flore du lac de Wenc"
    ]
  },
