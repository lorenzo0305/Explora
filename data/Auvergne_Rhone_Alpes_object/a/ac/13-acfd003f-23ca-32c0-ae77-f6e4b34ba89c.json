  "rdfs:comment": {
    "de": [
      "Sébastien Thiriet hat sich 2017 in Cistrières niedergelassen, um in die Freilandschweinehaltung einzusteigen. In La Ferme des Barbiquettes verarbeitet er das Fleisch zu Würsten, Trockenwürsten, Terrinen und anderen Schinkenstücken (Verkauf ab Hof und auf Märkten)."
    ],
    "en": [
      "Sébastien Thiriet set up in Cistrières in 2017 to take up free-range pig farming. At La Ferme des Barbiquettes, he transforms the meat into sausages, dry sausages, terrines and other ham nuts (farm sales and markets)."
    ],
    "it": [
      "Sébastien Thiriet si è insediato a Cistrières nel 2017 per dedicarsi all'allevamento di suini all'aperto. Presso La Ferme des Barbiquettes, trasforma la carne in salsicce, salsicce secche, terrine e altri tipi di prosciutto (venduti in azienda e nei mercati)."
    ],
    "fr": [
      "Sébastien Thiriet s'est installé à Cistrières en 2017 pour se lancer dans l’élevage porcin en plein air. À La Ferme des Barbiquettes, il transforme la viande en saucissons, saucisses sèches, terrines et autres noix de jambons (vte à la ferme et marchés)."
    ],
    "nl": [
      "Sébastien Thiriet vestigde zich in 2017 in Cistrières om varkens met vrije uitloop te gaan houden. In La Ferme des Barbiquettes verwerkt hij het vlees tot worsten, droge worsten, terrines en andere soorten ham (verkocht op de boerderij en op markten)."
    ],
    "es": [
      "Sébastien Thiriet se instaló en Cistrières en 2017 para dedicarse a la cría de cerdos camperos. En La Ferme des Barbiquettes, transforma la carne en salchichas, embutidos secos, terrinas y otros tipos de jamón (vendidos en la granja y en los mercados)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Ferme des barbiquettes"
    ]
  },
