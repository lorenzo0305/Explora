  "rdfs:comment": {
    "de": [
      "Die Kirche im neuromanischen Stil ist dem Heiligen Clemens gewidmet und besitzt vier Glocken, die noch heute vom Uhrmacher von Hand betätigt werden."
    ],
    "en": [
      "The neo-Romanesque church is dedicated to Saint-Clément, with its four bells still operated by hand by the clockmaker."
    ],
    "it": [
      "Costruita in stile neoromanico, la chiesa è dedicata a Saint-Clément, con le sue quattro campane che vengono ancora azionate manualmente dall'orologiaio."
    ],
    "fr": [
      "De style néo-roman, l'église est dédié à Saint-Clément avec ses quatre cloches qui sont encore aujourd’hui actionnées manuellement par l’horloger."
    ],
    "nl": [
      "De kerk is gebouwd in neoromaanse stijl en is gewijd aan Saint-Clément, met zijn vier klokken die nog steeds handmatig worden bediend door de klokkenmaker."
    ],
    "es": [
      "Construida en estilo neorrománico, la iglesia está dedicada a Saint-Clément, con sus cuatro campanas que aún son accionadas manualmente por el relojero."
    ]
  },
