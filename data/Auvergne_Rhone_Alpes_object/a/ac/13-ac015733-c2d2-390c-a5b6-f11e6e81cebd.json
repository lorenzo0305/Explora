  "rdfs:comment": {
    "de": [
      "Klettergebiet Val d'Orzon: Ehemaliger Granitsteinbruch, mehr als 30 Routen von 4A bis 6A mit einer Mehrheit an Routen auf der Seite 5. Ein sehr angenehmes Trainingsgebiet."
    ],
    "en": [
      "Val d'Orzon climbing site: over thirty practice routes that recreate the main levels of difficulty encountered in this sport."
    ],
    "it": [
      "Sito di arrampicata della Val d'Orzon: ex cava di granito, più di trenta vie dal 4A al 6A con una maggioranza di vie sul lato 5. Un sito di allenamento molto piacevole."
    ],
    "fr": [
      "Site d'escalade du Val d'Orzon : Ancienne carrière de Granit, plus d’une trentaine de voies  du 4A au 6A avec une majorité de voie côté 5. Un site d’entraînement très agréable."
    ],
    "es": [
      "Sitio de escalada Val d'Orzon: Antigua cantera de granito, más de treinta vías de 4A a 6A con una mayoría de vías en la cara 5. Un sitio de entrenamiento muy agradable. Un lugar de entrenamiento muy agradable."
    ],
    "nl": [
      "Klimlocatie Val d'Orzon: Voormalige granietgroeve, meer dan dertig routes van 4A tot 6A met de meeste routes aan kant 5. Een zeer aangename trainingslocatie."
    ]
  },
