  "rdfs:comment": {
    "de": [
      "Entdecken Sie einen modernen und gemütlichen Ort, an dem man sich zu einer guten Mahlzeit treffen kann. Wir bieten Ihnen das Tagesmenü von Montag bis Freitag mittags, die Brasserie-Karte, lokale Fleischgerichte, die Rum- und Whisky-Karte..."
    ],
    "en": [
      "Come and discover a modern, friendly place to enjoy a good meal. We offer a daily menu from Monday to Friday lunchtime, a brasserie menu, local meats, a rum and whisky menu..."
    ],
    "it": [
      "Venite a scoprire un luogo moderno e accogliente dove gustare un buon pasto. Offriamo un menu giornaliero dal lunedì al venerdì a pranzo, un menu brasserie, carni locali, un menu rum e whisky..."
    ],
    "fr": [
      "Venez découvrir un lieu moderne et chaleureux où se retrouver autour d'un bon repas. Nous proposons le menu du jour du lundi au vendredi midi, la carte brasserie, des viandes locales, la carte de rhum et whisky.."
    ],
    "es": [
      "Venga a descubrir un lugar moderno y acogedor donde disfrutar de una buena comida. Ofrecemos un menú diario de lunes a viernes al mediodía, un menú de brasserie, carnes locales, un menú de ron y whisky..."
    ],
    "nl": [
      "Kom en ontdek een moderne, vriendelijke plek om te genieten van een goede maaltijd. We bieden een dagmenu van maandag tot vrijdag tijdens lunchtijd, een brasseriemenu, lokale vleeswaren, een rum- en whiskymenu..."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Brasserie le Y"
    ]
  },
