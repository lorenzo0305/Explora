  "rdfs:comment": {
    "de": [
      "Nina Seita zeigt Ihnen ihre künstlerische Welt. Skulpturen, Gemälde entführen Sie in einen farbenfrohen Strudel. Kurse und Praktika in Modellieren, Drehen und Brennen. Nina empfängt Sie das ganze Jahr über, 7 Tage die Woche."
    ],
    "en": [
      "Nina Seita invites you to discover her artistic universe. Sculptures and paintings transport you into a colorful whirlwind. Courses and workshops in modeling, throwing and firing. Nina welcomes you all year round, 7 days a week."
    ],
    "it": [
      "Nina Seita vi invita a scoprire il suo mondo artistico. Sculture e dipinti vi trasportano in un vortice di colori. Corsi e workshop di modellazione, lancio e cottura. Nina vi accoglie tutto l'anno, 7 giorni su 7."
    ],
    "fr": [
      "Nina Seita vous fait découvrir son univers artistique. Sculptures, Peintures vous transportent dans un tourbillon coloré. Cours, stages de modelage, de tournage et de cuisson. Poussez la porte de l’atelier, Nina vous accueille toute l’année 7 jours sur 7."
    ],
    "nl": [
      "Nina Seita nodigt je uit om haar artistieke wereld te ontdekken. Sculpturen en schilderijen voeren je mee in een kleurrijke wervelwind. Cursussen en workshops in boetseren, gooien en bakken. Nina verwelkomt je het hele jaar door, 7 dagen per week."
    ],
    "es": [
      "Nina Seita le invita a descubrir su mundo artístico. Esculturas y pinturas le transportarán a un torbellino de colores. Cursos y talleres de modelado, lanzamiento y cocción. Nina le da la bienvenida todo el año, 7 días a la semana."
    ]
  },
