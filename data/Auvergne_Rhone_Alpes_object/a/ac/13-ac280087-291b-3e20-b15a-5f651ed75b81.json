  "rdfs:comment": {
    "de": [
      "Die Geschichte, die Kultur und das Leben eines Bonsais im Laufe der vier Jahreszeiten.\r\nPraktische Übungen zum Beschneiden. Sie können Ihren Bonsai mitbringen, um praktische Übungen durchzuführen. Ab 15 Jahren."
    ],
    "en": [
      "The history, culture and life of bonsai through the 4 seasons.\r\nPractical pruning exercises. You can bring your own bonsai for practical work. From 15 years of age."
    ],
    "it": [
      "La storia, la cultura e la vita di un bonsai attraverso le 4 stagioni.\r\nEsercizi pratici di potatura. È possibile portare il proprio bonsai per il lavoro pratico. A partire dai 15 anni di età."
    ],
    "fr": [
      "L’histoire, la culture, la vie d’un bonsai au travers des 4 saisons. \r\nExercices pratiques de taille. Vous pouvez apporter votre bonsaï afin de réaliser des travaux pratiques. Dès 15 ans."
    ],
    "es": [
      "La historia, la cultura y la vida de un bonsái a través de las 4 estaciones.\r\nEjercicios prácticos de poda. Puedes traer tu bonsái para realizar trabajos prácticos. A partir de 15 años."
    ],
    "nl": [
      "De geschiedenis, cultuur en het leven van een bonsai door de 4 seizoenen heen.\r\nPraktische snoei-oefeningen. Je kunt je bonsai meenemen voor praktisch werk. Vanaf 15 jaar."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Initiation à la culture du bonsaï"
    ]
  },
