  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Departement Rhône durch ein spielerisches und kostenloses Geocaching-Erlebnis. In Messimy begeben Sie sich auf die Jagd nach Graâl, einem Spezialisten für Geschichte und Denkmäler. Er und die anderen Gnolus werden Ihnen die Geschichte des Dorfes näher bringen."
    ],
    "en": [
      "Discover the Rhône department through a fun and free geocaching experience. In Messimy, go on a hunt for Graâl, a specialist in history and monuments. He and the other Gnolus will make you discover the history of the village."
    ],
    "it": [
      "Scoprite il dipartimento del Rodano attraverso un'esperienza di geocaching divertente e gratuita. A Messimy, andate a caccia di Graâl, uno specialista di storia e monumenti. Lui e gli altri Gnolus vi aiuteranno a scoprire la storia del villaggio."
    ],
    "fr": [
      "Découvrez le département du Rhône à travers une expérience ludique et gratuite de géocaching. A Messimy, partez à la chasse de Graâl, spécialiste de l'histoire et des monuments. Lui et les autres Gnolus vous feront découvrir l'histoire du village."
    ],
    "nl": [
      "Ontdek het departement Rhône via een leuke en gratis geocaching-ervaring. Ga in Messimy op jacht naar Graâl, een specialist in geschiedenis en monumenten. Hij en de andere Gnolus zullen je helpen de geschiedenis van het dorp te ontdekken."
    ],
    "es": [
      "Descubra el departamento del Ródano a través de una experiencia de geocaching divertida y gratuita. En Messimy, vaya a la caza de Graâl, especialista en historia y monumentos. Él y los otros Gnolus te ayudarán a descubrir la historia del pueblo."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Gnolus : Si t’es fier d’être un vingtain, tape dans tes mains !"
    ]
  },
