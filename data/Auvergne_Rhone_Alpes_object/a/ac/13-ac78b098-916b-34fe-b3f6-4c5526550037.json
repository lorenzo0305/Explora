  "rdfs:comment": {
    "de": [
      "Rodelplatz mit kleiner gesicherter Rodelbahn mit kostenlosem Zugang, der sich unterhalb der Straße Plan du Moulin befindet. Öffnung je nach Schneeverhältnissen."
    ],
    "en": [
      "Sledging area with a small secure sledging run. Free for all to access and located below the Plan du Moulin road. Opening depending on snow conditions."
    ],
    "it": [
      "Area per slittini con una piccola pista sicura ad accesso libero, situata sotto la strada del Plan du Moulin. Apertura in base alle condizioni della neve."
    ],
    "fr": [
      "Aire de luge avec petite piste de luge sécurisée en accès gratuit, située en contrebas de la route du Plan du Moulin. Ouverture en fonction des conditions d'enneigement."
    ],
    "es": [
      "Zona de trineo con una pequeña pista de trineo segura y de libre acceso, situada debajo de la carretera de Plan du Moulin. Abierto según las condiciones de la nieve."
    ],
    "nl": [
      "Sleegebied met een kleine, veilige en gratis piste aan de voet van de weg richting Plan du Moulin. Opening afhankelijk van de sneeuwcondities."
    ]
  },
