  "rdfs:comment": {
    "de": [
      "Mandibule ist nicht einfach nur ein Restaurant, sondern eine wahre Oase der Leidenschaft für die lokale Küche. Unser Restaurant verkörpert eine echte Rückverbindung mit unseren kulinarischen Wurzeln und stellt die ungeahnten Schätze unserer Region in den Vordergrund."
    ],
    "en": [
      "Mandibule is not just a restaurant, but a veritable haven of passion for local cuisine. Our restaurant embodies a true reconnection with our culinary roots, showcasing the unsuspected treasures of our region."
    ],
    "it": [
      "Mandibule non è un semplice ristorante, ma un vero e proprio rifugio di passione per la cucina locale. Il nostro ristorante incarna una vera e propria riconnessione con le nostre radici culinarie, mettendo in mostra i tesori insospettabili della nostra regione."
    ],
    "fr": [
      "Mandibule n'est pas simplement un restaurant, mais un véritable havre de passion pour la cuisine locale. Notre restaurant incarne une véritable reconnexion avec nos racines culinaires, mettant en avant les trésors insoupçonnés de notre région."
    ],
    "es": [
      "Mandibule no es sólo un restaurante, sino un verdadero remanso de pasión por la cocina local. Nuestro restaurante encarna una verdadera reconexión con nuestras raíces culinarias, mostrando los tesoros insospechados de nuestra región."
    ],
    "nl": [
      "Mandibule is niet zomaar een restaurant, maar een ware oase van passie voor de lokale keuken. Ons restaurant belichaamt een ware herverbinding met onze culinaire wortels en laat de onvermoede schatten van onze regio zien."
    ]
  },
