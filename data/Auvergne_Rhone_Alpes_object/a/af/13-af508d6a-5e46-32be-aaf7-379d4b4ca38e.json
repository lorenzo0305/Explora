  "rdfs:comment": {
    "de": [
      "Artyster ist ein ungewöhnlicher, spielerischer, in urbane Kunst getauchter und umweltfreundlicher Ort zum Leben, Übernachten und für die Kultur."
    ],
    "en": [
      "Artyster is a place of life, accommodation and culture, unusual, playful, bathed in urban art and respectful of its environment."
    ],
    "it": [
      "Artyster è un luogo di vita, un luogo di soggiorno e un luogo di cultura, insolito, giocoso, immerso nell'arte urbana e rispettoso del suo ambiente."
    ],
    "fr": [
      "Artyster est un lieu de vie, d'hébergement et de culture, insolite, ludique, baigné d'art urbain et respectueux de son environnement."
    ],
    "nl": [
      "Artyster is een plek om te wonen, een plek om te verblijven en een plek van cultuur, ongewoon, speels, badend in stedelijke kunst en met respect voor zijn omgeving."
    ],
    "es": [
      "Artyster es un lugar para vivir, un lugar para alojarse y un lugar de cultura, insólito, lúdico, bañado en arte urbano y respetuoso con su entorno."
    ]
  },
