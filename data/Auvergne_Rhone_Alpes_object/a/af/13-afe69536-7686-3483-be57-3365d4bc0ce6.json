  "rdfs:comment": {
    "de": [
      "La Fusée Blanche ist eine Rodelbahn für alle, die den Nervenkitzel lieben. Dieser gesicherte Bereich verspricht Ihnen unvergessliche Erinnerungen in einer außergewöhnlichen verschneiten Umgebung."
    ],
    "en": [
      "La Fusée Blanche is a toboggan area for thrill-seekers. This safe area promises unforgettable memories in an exceptional snowy setting."
    ],
    "it": [
      "La Fusée Blanche è un'area per slittini dedicata agli amanti del brivido. Quest'area sicura promette ricordi indimenticabili in un ambiente innevato eccezionale."
    ],
    "fr": [
      "La Fusée Blanche est un espace de luge dédiée aux amateurs de sensations. Cet espace sécurisé vous promet des souvenirs inoubliables dans un cadre enneigé exceptionnel."
    ],
    "nl": [
      "La Fusée Blanche is een rodelgebied voor sensatiezoekers. Dit veilige gebied belooft onvergetelijke herinneringen in een uitzonderlijk besneeuwde omgeving."
    ],
    "es": [
      "La Fusée Blanche es una zona de trineos dedicada a los amantes de las emociones fuertes. Esta zona segura promete recuerdos inolvidables en un entorno nevado excepcional."
    ]
  },
  "rdfs:label": {
