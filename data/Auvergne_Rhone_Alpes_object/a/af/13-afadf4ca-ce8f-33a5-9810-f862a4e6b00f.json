  "rdfs:comment": {
    "de": [
      "HelloResto, ein Restaurant im Herzen des Dorfes Séderon mit Parkplätzen in der Nähe, bietet eine traditionelle Qualitätsküche mit einem wöchentlich wechselnden Menü."
    ],
    "en": [
      "HelloResto, a restaurant located in the heart of the village of Séderon with parking nearby, offers traditional quality cuisine with a menu that changes week by week."
    ],
    "it": [
      "HelloResto, un ristorante situato nel cuore del villaggio di Séderon con parcheggio nelle vicinanze, offre una cucina tradizionale di qualità con un menu che cambia di settimana in settimana."
    ],
    "fr": [
      "HelloResto, restaurant situé au cœur du village de Séderon avec parking à proximité propose une cuisine traditionnelle de qualité avec un menu qui change semaine après semaine."
    ],
    "es": [
      "HelloResto, un restaurante situado en el corazón del pueblo de Séderon con aparcamiento cercano, ofrece cocina tradicional de calidad con un menú que cambia semana a semana."
    ],
    "nl": [
      "HelloResto, een restaurant in het hart van het dorp Séderon met parkeergelegenheid in de buurt, biedt een traditionele kwaliteitskeuken met een menu dat van week tot week verandert."
    ]
  },
