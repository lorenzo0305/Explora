  "rdfs:comment": {
    "de": [
      "Museum 2026 wegen Bauarbeiten geschlossen.\r\nMuseum, das die Geschichte der Flussschifffahrt auf dem Allier rund um die Stadt Pont-du-Château vom 15. bis zum 19. Jahrhundert nachzeichnet"
    ],
    "en": [
      "Museum closed in 2025 for renovation.\r\nMuseum retracing the history of river navigation on the Allier around the town of Pont-du-Château from the 15th to the 19th century."
    ],
    "it": [
      "Museo chiuso nel 2026 per lavori.\r\nMuseo che ripercorre la storia della navigazione fluviale sull'Allier intorno alla città di Pont-du-Château dal XV al XIX secolo"
    ],
    "fr": [
      "Musée fermé en 2026 pour travaux.\r\nMusée retraçant l'histoire de la navigation fluviale sur l'Allier autour de la ville de Pont-du-Château du XVème siècle au XIXème siècle"
    ],
    "es": [
      "Museo cerrado en 2026 por obras.\r\nMuseo que recorre la historia de la navegación fluvial en el Allier, en torno a la ciudad de Pont-du-Château, desde el siglo XV hasta el XIX"
    ],
    "nl": [
      "Het Musée de la Batellerie vertelt het verhaal van het binnenvaartverleden van Pont-du-Château, dat van de 15de tot de 18de eeuw de belangrijkste haven van de regio rond Clermont-Ferrand was."
    ]
