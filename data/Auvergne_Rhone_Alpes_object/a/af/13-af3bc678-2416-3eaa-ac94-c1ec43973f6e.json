  "rdfs:comment": {
    "de": [
      "Ein origineller Raum, der der zeitgenössischen Kunst gewidmet ist!\r\nDer Brückenpfeiler, ein 160 m² großer und 9 m hoher architektonischer Raum aus unbehandeltem Beton, wird jeden Sommer zum Ort von In-situ-Installationen.\r\nIn diesem Sommer wird die Künstlerin Anna-Eva Berge den Ort bespielen."
    ],
    "en": [
      "An original space dedicated to contemporary art!\r\nThe pillar of the bridge, a vast architectural space of raw concrete of 160 m² and 9 meters high, becomes every summer the place of ephemeral in-situ installations."
    ],
    "it": [
      "Uno spazio originale dedicato all'arte contemporanea!\r\nIl pilastro del ponte, vasto spazio architettonico di cemento grezzo di 160 mq e 9 metri di altezza, diventa ogni estate luogo di installazioni in situ effimere."
    ],
    "fr": [
      "Un espace original dédié à l’art contemporain !\r\nLe pilier du pont, vaste espace architectural de béton brut de 160 m² et 9 mètres de hauteur devient chaque été le lieu d’installations in-situ.\r\nCet été, c'est l'artiste Anna-Eva Berge qui investira le lieu."
    ],
    "es": [
      "Un espacio original dedicado al arte contemporáneo\r\nCada verano, el pilar del puente, un vasto espacio arquitectónico de hormigón en bruto de 160 m² y 9 metros de altura, se convierte en escenario de instalaciones in situ.\r\nEste verano, la artista Anna-Eva Berge ocupará el lugar."
    ],
    "nl": [
      "Een originele ruimte gewijd aan hedendaagse kunst!\r\nElke zomer wordt de brugpijler, een grote architecturale ruimte van ruw beton van 160 m² en 9 meter hoog, het decor voor installaties ter plaatse.\r\nDeze zomer neemt kunstenares Anna-Eva Berge de plek over."
    ]
  },
