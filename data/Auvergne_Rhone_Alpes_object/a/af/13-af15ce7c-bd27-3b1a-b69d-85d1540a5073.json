  "rdfs:comment": {
    "de": [
      "Das gemütliche Restaurant im Chalet-Stil serviert feine saisonale Gerichte, die mit frischen Zutaten zubereitet werden. Der Chefkoch Jacky Calvé hat die Leitung übernommen und bereitet Ihnen Gerichte von der Vorspeise bis zum Brot zu!"
    ],
    "en": [
      "The cosy restaurant, with a chalet-style, serves fine seasonal dishes made with fresh products. Chef Jacky Calvé has taken over the management and prepares dishes from starters to bread!"
    ],
    "it": [
      "L'accogliente ristorante in stile chalet serve raffinati piatti di stagione preparati con prodotti freschi. Lo chef Jacky Calvé ne ha assunto la gestione e prepara piatti dall'antipasto al pane!"
    ],
    "fr": [
      "Le restaurant cosy, au style chalet, sert des plats fins de saison concoctés avec des produits frais. Le chef Jacky Calvé a repris la gérance et vous prépare des mets de l'entrée jusqu'au pain !"
    ],
    "nl": [
      "Het gezellige restaurant in chaletstijl serveert verfijnde seizoensgerechten met verse producten. Chef Jacky Calvé heeft de leiding overgenomen en bereidt alle gerechten, van voorgerecht tot brood!"
    ],
    "es": [
      "El acogedor restaurante, de estilo chalé, sirve exquisitos platos de temporada elaborados con productos frescos. El chef Jacky Calvé se ha hecho cargo de la dirección y prepara platos desde entrantes ¡hasta pan!"
    ]
  },
