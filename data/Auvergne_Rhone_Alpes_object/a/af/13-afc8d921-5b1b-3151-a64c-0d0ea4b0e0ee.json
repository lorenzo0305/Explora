  "rdfs:comment": {
    "de": [
      "Das Schloss ist gleichzeitig ein anregender Arbeitsplatz, ein geselliger Lebensraum und eine Ideenschmiede, in der man sich gemeinsam die Veränderungen der Gesellschaft vorstellen kann."
    ],
    "en": [
      "Le Château is a stimulating place to work, a convivial place to live and a laboratory of ideas for collectively imagining the transformations of society."
    ],
    "it": [
      "Lo Château è un luogo stimolante per lavorare, un luogo conviviale per vivere e un laboratorio di idee dove possiamo immaginare collettivamente le trasformazioni della società."
    ],
    "fr": [
      "Le Château, c’est à la fois un lieu de travail stimulant, un espace de vie convivial et un laboratoire d’idées pour imaginer collectivement les transformations de la société."
    ],
    "nl": [
      "Het Château is een stimulerende plek om te werken, een gezellige plek om te wonen en een laboratorium van ideeën waar we ons collectief de transformaties van de maatschappij kunnen voorstellen."
    ],
    "es": [
      "El Château es un lugar de trabajo estimulante, un lugar de convivencia y un laboratorio de ideas donde podemos imaginar colectivamente las transformaciones de la sociedad."
    ]
  },
