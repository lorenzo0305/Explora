      "@id": "https://data.datatourisme.fr/c70f444a-4429-3ab1-85ad-8f7d9155e749",
      "dc:description": {
        "de": [
          "Nehmen Sie am Samstag, den 29. März um 19 Uhr an einem Essen mit Tanzabend zu den von Laurette Goubelle gesungenen 80er Jahren teil. Weitere Informationen finden Sie auf dem Plakat"
        ],
        "en": [
          "Come and join us for a meal and dance to the 80s sung by Laurette Goubelle on Saturday March 29 at 7pm. For further information, please consult the poster"
        ],
        "it": [
          "Unisciti a noi per un pasto e per ballare gli anni '80 cantati da Laurette Goubelle sabato 29 marzo alle 19.00. Per maggiori informazioni, consultare la locandina"
        ],
        "fr": [
          "Venez participer au repas avec soirée dansante sur les années 80 chantées par Laurette Goubelle le samedi 29 mars à 19h. Pour plus d'informations, veuillez consulter l'affiche"
        ],
        "nl": [
          "Kom op zaterdag 29 maart om 19.00 uur bij ons eten en dansen op de 80's gezongen door Laurette Goubelle. Raadpleeg voor meer informatie de poster"
        ],
        "es": [
          "El sábado 29 de marzo a las 19.00 h, venga a comer con nosotros y a bailar al ritmo de los años 80 cantados por Laurette Goubelle. Para más información, consulte el cartel"
        ]
      },
