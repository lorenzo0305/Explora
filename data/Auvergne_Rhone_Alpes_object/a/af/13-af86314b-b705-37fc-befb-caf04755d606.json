  "rdfs:comment": {
    "de": [
      "Les Jardins du Rozier ist eine 100% zertifizierte Bio-Mikrofarm, die den Prinzipien der Agrarökologie folgt. Die Farm produziert über die gesamte Saison hinweg etwa 40 Gemüsesorten."
    ],
    "en": [
      "Bryan In the Garden is a 100% certified organic micro-farm that follows the principles of agroecology. The farm produces around 40 vegetables throughout the year."
    ],
    "it": [
      "Una microfattoria biologica certificata al 100% che segue i principi dell'agroecologia. L'azienda produce circa 40 ortaggi durante tutta la stagione."
    ],
    "fr": [
      "Micro-ferme 100% certifiée biologique qui suit les principes de l'agroécologie. La ferme produit environ 40 légumes tout au long de la saison."
    ],
    "es": [
      "Una microexplotación 100% ecológica certificada que sigue los principios de la agroecología. La granja produce unas 40 hortalizas a lo largo de la temporada."
    ],
