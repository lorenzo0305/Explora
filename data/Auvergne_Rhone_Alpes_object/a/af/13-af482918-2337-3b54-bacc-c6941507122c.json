  "rdfs:comment": {
    "de": [
      "Das Château de la Batisse in Chanonat steht wie das gesamte Anwesen unter Denkmalschutz und ist von einem Garten umgeben, der als \"Jardin Remarquable\" (bemerkenswerter Garten) ausgezeichnet wurde."
    ],
    "en": [
      "The château will not be open to individual visitors this season"
    ],
    "it": [
      "Lo Château de la Batisse, situato a Chanonat, è classificato come Monumento Storico, così come l'intera tenuta, ed è circondato da un giardino che ha ottenuto il marchio \"Jardin Remarquable\"."
    ],
    "fr": [
      "Le Château de la Batisse, situé à Chanonat, est classé au titre des Monuments Historiques, tout comme l’ensemble du domaine, et entouré d’un jardin labellisé « Jardin Remarquable »."
    ],
    "es": [
      "El Château de la Batisse, situado en Chanonat, está catalogado como Monumento Histórico, al igual que toda la finca, y está rodeado de un jardín galardonado con la etiqueta \"Jardin Remarquable\"."
    ],
    "nl": [
      "Château de la Batisse, gelegen in Chanonat, staat op de lijst van historische monumenten, net als het hele landgoed, en wordt omringd door een tuin die het label \"Jardin Remarquable\" heeft gekregen."
    ]
  },
