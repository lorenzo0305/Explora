  "rdfs:comment": {
    "de": [
      "Im 4. Jahrhundert entdeckte der Heilige Petrus diese Quelle mit Heilkraft neben einem Menhir, der Ana, die Schöpfergottheit, darstellte."
    ],
    "en": [
      "In the 4th century, St Martin discovered this healing spring near to a menhir representing Ana, the goddess of creation."
    ],
    "it": [
      "Nel IV secolo, San Pietro scoprì questa sorgente con il potere di guarire accanto a un menhir che rappresentava Ana, la divinità creatrice."
    ],
    "fr": [
      "Au IVe siècle, Saint Pierre découvre cette source ayant le pouvoir de guérir à côté d'un menhir représentant Ana, la divinité créatrice."
    ],
    "nl": [
      "In de 4e eeuw ontdekte Sint Peter deze bron met geneeskracht naast een menhir die Ana, de scheppende godheid, voorstelde."
    ],
    "es": [
      "En el siglo IV, San Pedro descubrió este manantial con poder curativo junto a un menhir que representaba a Ana, la divinidad creadora."
    ]
  },
