  "rdfs:comment": {
    "de": [
      "Happy.Rentals bietet professionelle Ferienvermietung und Immobilienverwaltung in ganz Europa und auf den Kapverden mit einer großen Auswahl an Objekten für jedes Budget, jeden Geschmack und jeden Reisestil."
    ],
    "en": [
      "Happy.Rentals offers professional vacation rental and property management services throughout Europe and Cape Verde, with a wide selection of properties to suit all budgets, tastes and travel styles."
    ],
    "it": [
      "Happy.Rentals offre servizi professionali di affitto e gestione di proprietà per vacanze in tutta Europa e a Capo Verde, con un'ampia selezione di proprietà per tutte le tasche, i gusti e gli stili di viaggio."
    ],
    "fr": [
      "Happy.Rentals propose des services professionnels de location de vacances et de gestion immobilière à travers l’Europe et le Cap-Vert, avec une large sélection de propriétés adaptées à tous les budgets, goûts et styles de voyage."
    ],
    "es": [
      "Happy.Rentals ofrece servicios profesionales de alquiler vacacional y gestión de propiedades en toda Europa y Cabo Verde, con una amplia selección de propiedades que se adaptan a todos los presupuestos, gustos y estilos de viaje."
    ],
    "nl": [
      "Happy Rentals biedt professionele diensten aan op het gebied van vakantieverhuur en vastgoedbeheer in heel Europa en Kaapverdië, met een ruime keuze aan vakantiewoningen voor alle budgetten, smaken en reisstijlen."
    ]
  },
