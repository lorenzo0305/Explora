  "rdfs:comment": {
    "de": [
      "Als Bergbegleiter mit Sitz in Die nehme ich Sie mit auf eine Wanderung durch die Berge unserer schönen Region. Wanderungen nach Lust und Laune, zu jeder Jahreszeit, zu Fuß oder mit Schneeschuhen, halbtags, ganztags oder mehrtägig."
    ],
    "en": [
      "I am a Mountain Guide based in Die and I will take you walking through the mountains of our beautiful region. Hikes à la carte, based on your aspirations, in all seasons, walking or snowshoeing, for half a day, a full day or several days."
    ],
    "it": [
      "In qualità di guida alpina con sede a Die, vi accompagnerò in un tour à la carte delle montagne del Diois e del Vercors, qualunque sia la vostra preferenza, in qualunque stagione, a piedi o con le racchette da neve, per mezza giornata, una giornata intera o più giorni."
    ],
    "fr": [
      "Accompagnateur en montagne basé à Die, je vous emmène parcourir les montagnes du Diois et du Vercors en rando à la carte selon vos envies, en toutes saisons, à pieds ou en raquettes, à la demi-journée, à la journée ou sur plusieurs jours."
    ],
    "es": [
      "Como guía de montaña con base en Die, le llevaré a recorrer a la carta las montañas de Diois y Vercors, sea cual sea su preferencia, en cualquier época del año, a pie o con raquetas de nieve, durante media jornada, una jornada completa o varios días."
    ],
    "nl": [
      "Berggids in Die. Ik neem je mee de bergen in van onze mooie streek. Wandeltochten op maat, voor ieder wat wils, in elk seizoen, op wandelschoenen of sneeuwschoenen, voor een halve dag, een hele dag of meerdere dagen."
    ]
  },
  "rdfs:label": {
    "de": [
      "Christophe Pelet - Bergbegleiter"
    ],
    "en": [
      "Christophe Pelet - Mountain Guide"
    ],
    "fr": [
