  "rdfs:comment": {
    "de": [
      "Direkt am Seeufer können Sie lokale Spezialitäten genießen: Fisch aus dem See, Frittiertes. Frische, lokale Hausmannskost seit 1900. Eine schöne Karte mit Seefisch."
    ],
    "en": [
      "Right on the edge of the lake, you can enjoy local specialties: lake fish, fried food and frogs' legs. Fresh, homemade cuisine since 1900."
    ],
    "it": [
      "Specialità locali proprio in riva al lago: pesce del lago, frittura, cosce di rana. Cucina fresca e casereccia dal 1900."
    ],
    "fr": [
      "Juste au bord du lac, vous pourrez déguster des spécialités locales : poissons du lac, fritures. Cuisine maison fraîche et locale depuis 1900. Une belle carte de poissons de Mer."
    ],
    "es": [
      "Junto al lago, podrá disfrutar de las especialidades locales: pescado de lago, frituras. Cocina casera, fresca y local desde 1900. Un buen menú de pescado de mar."
    ],
    "nl": [
      "Direct aan het meer kunt u genieten van lokale specialiteiten: vis uit het meer, gebakken voedsel. Verse en lokale keuken sinds 1900. Een mooi menu van zeevis."
    ]
  },
