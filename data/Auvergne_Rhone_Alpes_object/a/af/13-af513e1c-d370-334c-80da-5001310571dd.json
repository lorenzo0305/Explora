  "rdfs:comment": {
    "de": [
      "Das Sozialzentrum La Paz in Saint-Nazaire ist ein Ort der Geselligkeit und Solidarität. Aktivitäten für alle, kulturelle Veranstaltungen, Workshops und Unterstützung für Familien: ein Ort, an dem man sich treffen, austauschen und gemeinsam kreativ sein kann."
    ],
    "en": [
      "The Centre Social La Paz, in Saint-Nazaire, is a place of conviviality and solidarity. Activities for all, cultural events, workshops and support for families: a place to meet, exchange ideas and create together."
    ],
    "it": [
      "Il Centro sociale La Paz, a Saint-Nazaire, è un luogo di convivialità e solidarietà. Attività per tutti, eventi culturali, laboratori e sostegno alle famiglie: un luogo dove incontrarsi, scambiarsi idee e creare insieme."
    ],
    "fr": [
      "Le Centre Social La Paz, à Saint-Nazaire, est un lieu de convivialité et de solidarité. Activités pour tous, événements culturels, ateliers et soutien aux familles : un espace pour se rencontrer, échanger et créer ensemble."
    ],
    "nl": [
      "Het Centre Social La Paz, in Saint-Nazaire, is een plek van gezelligheid en solidariteit. Activiteiten voor iedereen, culturele evenementen, workshops en steun voor gezinnen: een plek om elkaar te ontmoeten, ideeën uit te wisselen en samen te creëren."
    ],
    "es": [
      "El Centro Social La Paz, en Saint-Nazaire, es un lugar de convivencia y solidaridad. Actividades para todos, eventos culturales, talleres y apoyo a las familias: un lugar para encontrarse, intercambiar ideas y crear juntos."
    ]
  },
