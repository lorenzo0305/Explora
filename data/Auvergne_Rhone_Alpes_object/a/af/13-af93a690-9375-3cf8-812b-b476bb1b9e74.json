  "rdfs:comment": {
    "de": [
      "Süße und salzige Köstlichkeiten, die traditionell in New Yorker Cafés gegessen werden: Bagels, Salate, Cookies, Donuts, Muffins, Brownies, Kaffee... Vor Ort oder zum Mitnehmen."
    ],
    "en": [
      "Savoury and sweet delights, traditionally consumed in New York cafés: bagels, salads, cookies, donut, muffins, brownie, coffee... On the spot or to take away."
    ],
    "it": [
      "Delizie dolci e salate, tradizionalmente consumate nei caffè di New York: bagel, insalate, biscotti, ciambelle, muffin, brownies, caffè? Sul posto o da portare via."
    ],
    "fr": [
      "Délices salés et sucrés, traditionnellement consommés dans les cafés New Yorkais: bagels, salades, cookies, donut, muffins, brownie, cafés… Sur place ou à emporter."
    ],
    "nl": [
      "Zoete en hartige lekkernijen, traditioneel gegeten in New Yorkse cafés: bagels, salades, koekjes, donuts, muffins, brownies, koffie... Ter plaatse of om mee te nemen."
    ],
    "es": [
      "Delicias dulces y saladas, tradicionalmente consumidas en los cafés neoyorquinos: bagels, ensaladas, galletas, donuts, muffins, brownies, cafés.. En el lugar o para llevar."
    ]
  },
