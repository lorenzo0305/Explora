  "rdfs:comment": {
    "de": [
      "In La Caboche finden Sie einen kostenlosen Teppich für Skianfänger und einen geschützten Rodelbereich (kostenpflichtiger Zugang über die Gondelbahn von Chamois oder Rocharbois)."
    ],
    "en": [
      "At the Caboche there is a free carpet for the use of beginner skiers and a large protected tobogganing area (with paid access by the Chamois of Rocharbois cable cars)."
    ],
    "it": [
      "Alla Caboche troverete un nastro gratuito per gli sciatori principianti, ma anche uno spazio protetto per lo slittino (accesso a pagamento tramite la cabinovia dello Chamois o del Rocharbois)."
    ],
    "fr": [
      "A la Caboche, vous trouverez un tapis gratuit pour les skieurs débutants et un espace luge protégé (accès payant par la télécabine du Chamois ou du Rocharbois)."
    ],
    "nl": [
      "In La Caboche vind je een gratis tapijt voor beginners en een beschermd sleegebied (tegen betaling toegankelijk via de gondel van Chamois of Rocharbois)."
    ],
    "es": [
      "En La Caboche, encontrará una alfombra gratuita para principiantes y una zona protegida para trineos (acceso de pago a través del telecabina Chamois o Rocharbois)."
    ]
  },
