  "rdfs:comment": {
    "de": [
      "Bergrestaurant mit Feinschmeckerküche und herrlichem Panorama.\r\nFür Skiläufer erreichbar mit: Roc 2, Sessellift Granges oder Kabinenbahn Plattières von Méribel aus und für Fußgänger mit der Kabinenbahn und dem Sessellift Roc des 3 Marches."
    ],
    "en": [
      "Mountain restaurant Le Bouche à Oreille. \r\nAccess with Le Roc 2  from Les Menuires, Les Granges chairlift from Saint Martin or with the Les Plattières gondola from Méribel. Pedestrian access with Le Roc des 3 Marches (1 & 2)."
    ],
    "it": [
      "Situato in cima al Roc 2 a 2700 m, di fronte al ghiacciaio della Borgne, Le Bouche à Oreille è uno chalet luminoso e moderno che accoglie sciatori e buongustai da tutte le 3 Valli. Dalla sua terrazza si gode di una vista panoramica a 360°"
    ],
    "fr": [
      "Situé au sommet du Roc 2 à 2700 m, face au glacier du Borgne, le restaurant d'altitude Le Bouche à Oreille, chalet moderne et lumineux accueille les skieurs et piétons gastronomes venus des 3 Vallées. De sa terrasse, découvrez un panorama 360°"
    ],
    "es": [
      "Situado en la cima del Roc 2 a 2700 m, frente al glaciar de la Borgne, Le Bouche à Oreille es un chalet luminoso y moderno que acoge a esquiadores y gastrónomos de los 3 Valles. Desde su terraza, podrá disfrutar de una vista panorámica de 360°"
    ],
    "nl": [
      "Bergrestaurant Le Bouche à Oreille. Smaakvolle kaart en fraai panorama.\r\nPer ski bereikbaar via de Roc 2, de SL Les Granges of de KB van Les Plattières vanaf Méribel. Te voet bereikbaar via de KB en vervolgens de SL van Le Roc des 3 Marches."
    ]
  },
