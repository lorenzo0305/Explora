  "rdfs:comment": {
    "de": [
      "Das gesamte Team freut sich, Sie in ihrem Lebensmittelgeschäft mit allgemeinen Lebensmitteln in Bourdeaux begrüßen zu dürfen.\r\nAllgemeiner Lebensmittelladen, Presse, regionale Produkte, BIO-Produkte, Brotverkauf, gekühlte Getränke."
    ],
    "en": [
      "The whole team is delighted to welcome you to their general grocery store in Bourdeaux.\r\nGeneral grocery store, press, regional products, organic products, bread depot, cold drinks."
    ],
    "it": [
      "L'intero team è lieto di accogliervi nel suo negozio di generi alimentari a Bourdeaux.\r\nNegozio di alimentari generici, stampa, prodotti regionali, prodotti biologici, deposito di pane, bevande fredde."
    ],
    "fr": [
      "Toute l'équipe est heureuse de vous accueillir dans leur épicerie d'alimentation générale à Bourdeaux.\r\nÉpicerie alimentation générale, presse, produits régionaux, produits BIO, dépôt de pain, boissons fraiches."
    ],
    "es": [
      "Todo el equipo está encantado de recibirle en su tienda de alimentación general de Burdeos.\r\nTienda de alimentación general, prensa, productos regionales, productos ecológicos, depósito de pan, bebidas frías."
    ],
    "nl": [
      "Het hele team heet u van harte welkom in hun kruidenierswinkel in Bourdeaux.\r\nKruidenierswinkel, pers, regionale producten, biologische producten, brooddepot, koude dranken."
    ]
  },
