  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/2159f5b5-46b1-3b76-a7d7-f5b37d148cd9",
      "dc:description": {
        "de": [
          "Nampont St Martin Golf Club - 2 Golfplätze mit 18 Löchern. Les Cygnes: Der Parcours durch das Tal der Authie - 5.850 m - Par 72. Le Belvédère: der Parcours der bewaldeten Landschaften: 5.176 m - Par 72. Wasserübungsplatz - Pro Shop - Clubhaus - Panoramarestaurant - Festes Haus aus dem 15. Jahrhundert."
        ],
        "en": [
          "Nampont St Martin Golf Club - 2 courses of 18 holes. Les Cygnes: the Authie valley course - 5,850 m - par 72. Le Belvédère: the wooded landscape course - 5,176 m - par 72. Water driving range - Pro Shop - Club House - Panoramic restaurant - 15th-century Maison Forte."
        ],
        "it": [
          "Golf Club Nampont St Martin - 2 percorsi di 18 buche. Les Cygnes: il percorso della valle dell'Authie - 5.850 m - par 72. Le Belvédère: il percorso del paesaggio boscoso: 5.176 m - par 72. Campo pratica in acqua - Pro Shop - Club House - Ristorante panoramico - Maison Forte del XV secolo."
        ],
        "fr": [
          "Nampont St Martin Golf Club - 2 parcours de 18 trous. Les Cygnes : le parcours de la vallée de l'Authie - 5 850 m - par 72. Le Belvédère : le parcours des paysages boisés : 5 176 m - par 72. Practice sur eau - Pro Shop - Club House - Restaurant panoramique - Maison Forte du 15ème siècle."
        ],
        "es": [
          "Nampont St Martin Golf Club - 2 recorridos de 18 hoyos. Les Cygnes: el recorrido del valle de Authie - 5.850 m - par 72. Le Belvédère: el recorrido del paisaje arbolado: 5.176 m - par 72. Campo de prácticas acuático - Pro Shop - Club House - Restaurante panorámico - Maison Forte del siglo XV."
        ],
        "nl": [
          "Nampont St Martin Golf Club - 2 banen van 18 holes. Les Cygnes: de baan in de Authievallei - 5.850 m - par 72. Le Belvédère: de beboste landschapsbaan: 5.176 m - par 72. Water driving range - Pro Shop - Club House - Panoramic Restaurant - 15e eeuws Maison Forte."
        ]
      },
