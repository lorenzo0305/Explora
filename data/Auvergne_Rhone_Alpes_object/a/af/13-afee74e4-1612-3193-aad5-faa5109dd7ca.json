  "rdfs:comment": {
    "de": [
      "Sie können Elektrofahrräder von der Marke Rossignol, die strapazierfähig, sicher und dauerhaft sind mieten."
    ],
    "en": [
      "The Relais Nordique can rent you electric bikes from the Rossignol brand, known to be hardy, reliable and lasting."
    ],
    "it": [
      "Le Relais Nordique vi offre le mountain bike elettriche Rossignol, progettate per essere robuste, affidabili e durevoli, così come le mountain bike tradizionali."
    ],
    "fr": [
      "Le Relais Nordique vous propose des VTT à assistance électrique de la marque Rossignol, réfléchis pour être robustes, fiables et durables mais aussi des VTT traditionnels."
    ],
    "es": [
      "Le Relais Nordique le ofrece bicicletas de montaña de asistencia eléctrica Rossignol, diseñadas para ser robustas, fiables y duraderas, así como bicicletas de montaña tradicionales."
    ],
    "nl": [
      "Le Relais Nordique biedt je naast traditionele mountainbikes ook elektrische mountainbikes van Rossignol, die robuust, betrouwbaar en duurzaam zijn."
    ]
  },
  "rdfs:label": {
