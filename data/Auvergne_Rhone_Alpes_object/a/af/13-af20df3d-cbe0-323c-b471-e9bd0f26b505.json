  "rdfs:comment": {
    "de": [
      "David & Magali bieten Ihnen jeden Tag ein anderes Menü an, das aus frischen und lokalen Produkten zubereitet wird. Vom Brot bis zum Dessert wird Ihr Teller mit größter Sorgfalt zubereitet."
    ],
    "en": [
      "David & Magali offer a different menu every day, based on fresh, local produce. From bread to dessert, your plate is prepared with the utmost care."
    ],
    "it": [
      "David & Magali propongono un menu diverso ogni giorno, utilizzando prodotti freschi locali. Dal pane ai dolci, il vostro piatto è preparato con la massima cura."
    ],
    "fr": [
      "David & Magali vous propose chaque jour un menu différent élaboré à base de produits frais et locaux. Du pain aux desserts, votre assiette est préparée avec le plus grand soin."
    ],
    "es": [
      "David y Magali ofrecen un menú diferente cada día, utilizando productos locales frescos. Desde el pan hasta los postres, su plato se prepara con el mayor esmero."
    ],
    "nl": [
      "David & Magali bieden elke dag een ander menu, met verse lokale producten. Van het brood tot de desserts, je bord wordt met de grootste zorg bereid."
    ]
  },
