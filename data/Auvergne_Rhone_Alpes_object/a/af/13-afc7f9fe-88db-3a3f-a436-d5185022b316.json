  "rdfs:comment": {
    "de": [
      "Bar-Restaurant am Fuße des Puy de Sancy neben der Seilbahn Nr. 1 und gegenüber der Skischule.\r\nGroße Sonnenterrasse mit Blick auf die Berge.\r\nCrêpes und Snacks zu jeder Tageszeit im Winter."
    ],
    "en": [
      "Bar, restaurant, pancakes. At the foot of the Sancy. Large south-facing terrace."
    ],
    "it": [
      "Bar-ristorante situato ai piedi del Puy de Sancy, vicino alla funivia n. 1, di fronte alla scuola di sci.\r\nAmpia terrazza soleggiata con vista sulle montagne.\r\nCrêpes e spuntini sempre disponibili in inverno."
    ],
    "fr": [
      "Bar-restaurant situé au pied du Puy de Sancy à côté du téléphérique n°1, en face de l'école de ski.\r\nGrande terrasse ensoleillée avec vue sur les montagnes. \r\nCrêpes et snack à toute heure en hiver."
    ],
    "es": [
      "Bar-restaurante situado al pie del Puy de Sancy junto al telecabina nº 1, frente a la escuela de esquí.\r\nGran terraza soleada con vistas a la montaña.\r\nCrêpes y aperitivos disponibles a todas horas en invierno."
    ],
    "nl": [
      "Bar-restaurant gelegen aan de voet van de Puy de Sancy naast kabelbaan nr. 1, tegenover de skischool.\r\nGroot zonnig terras met uitzicht op de bergen.\r\nCrêpes en snacks altijd verkrijgbaar in de winter."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Brasserie Azur Sancy"
    ]
  },
