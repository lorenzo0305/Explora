  "rdfs:comment": {
    "de": [
      "Das in Roanne-Riorges gelegene La Villa Italian Restaurant bietet Ihnen das Beste der italienischen Gastronomie. Wir wählen die besten Produkte der Saison für eine \"hausgemachte\" Küche aus."
    ],
    "en": [
      "La Villa Italian Restaurant in Roanne-Riorges offers you the very best in Italian gastronomy. We select the finest seasonal produce for our \"home-made\" cuisine."
    ],
    "it": [
      "Il ristorante italiano Villa di Roanne-Riorges vi offre il meglio della cucina italiana. Selezioniamo i migliori prodotti di stagione per la nostra cucina casalinga."
    ],
    "fr": [
      "La Villa Italian Restaurant situé à Roanne-Riorges vous propose le meilleur de la gastronomie italienne. Nous sélectionnons les meilleurs produits de saison pour une cuisine \"fait maison\"."
    ],
    "nl": [
      "Het Villa Italian Restaurant in Roanne-Riorges biedt je het allerbeste uit de Italiaanse keuken. We selecteren de beste seizoensproducten voor onze huisgemaakte keuken."
    ],
    "es": [
      "El restaurante italiano Villa de Roanne-Riorges le ofrece lo mejor de la cocina italiana. Seleccionamos los mejores productos de temporada para nuestra cocina casera."
    ]
  },
