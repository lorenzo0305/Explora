  "rdfs:comment": {
    "de": [
      "Piscine Pierre Rajon: der Sommer! Nur während der Sommermonate geöffnet.\r\nFreibad mit: 1 Becken 50mx18m mit 7 Schwimmbahnen ;1 Becken 25m x 10m."
    ],
    "en": [
      "Pierre Rajon swimming pool : the summer one !\r\nDiscovery pool including : 1 pool of 50 m x 18m with 7 swimming lanes ; 1 pool of 25 m x 10 m."
    ],
    "it": [
      "Piscina Pierre Rajon: estate! Aperta solo durante i mesi estivi.\r\nPiscina all'aperto composta da: 1 vasca da 50 m x 18 m con 7 corsie di nuoto; 1 vasca da 25 m x 10 m."
    ],
    "fr": [
      "Piscine Pierre Rajon : l’estivale ! Ouverte uniquement durant la période d'été.\r\nPiscine découverte comprenant  : 1 bassin de 50 mx18m avec 7 couloirs de nage ;1 bassin de 25 m x 10 m."
    ],
    "nl": [
      "Zwembad Pierre Rajon: de zomer! Alleen geopend tijdens de zomermaanden.\r\nOpenluchtzwembad bestaande uit: 1 x 50 m x 18 m bad met 7 zwembanen; 1 x 25 m x 10 m bad."
    ],
    "es": [
      "Piscina Pierre Rajon: ¡verano! Abierta sólo durante los meses de verano.\r\nPiscina al aire libre compuesta por: 1 piscina de 50 m x 18 m con 7 calles de natación; 1 piscina de 25 m x 10 m."
    ]
  },
