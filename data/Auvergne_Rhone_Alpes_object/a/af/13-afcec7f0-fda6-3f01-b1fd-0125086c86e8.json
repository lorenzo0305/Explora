  "rdfs:comment": {
    "de": [
      "Mahlzeiten für Privatpersonen und Geschäftsleute.\r\nL'Antre'mets bietet Ihnen eine schmackhafte traditionelle Küche.\r\nGerichte aus der französischen und internationalen Küche.\r\nMahlzeiten zum Mitnehmen.\r\nFormeln und Tagesgerichte.\r\nLebensmittel aus der Region, feine Wurstwaren."
    ],
    "en": [
      "Meals for individuals and professionals.\r\nL'Antre'mets offers you tasty traditional cuisine.\r\nEmblematic dishes of French and world cuisine.\r\nTakeaway meals.\r\nFormulas and dishes of the day.\r\nLocal grocery, delicatessen."
    ],
    "it": [
      "Pasti per privati e professionisti.\r\nL'Antre'mets vi offre una gustosa cucina tradizionale.\r\nPiatti emblematici della cucina francese e mondiale.\r\nPasti da asporto.\r\nFormule e piatti del giorno.\r\nDrogheria locale, gastronomia."
    ],
    "fr": [
      "Repas pour particuliers et professionnels.\r\nL'Antre'mets vous propose une cuisine traditionnelle goûteuse.\r\nDes plats emblématiques de la cuisine française et du monde.\r\nRepas à emporter.\r\nFormules et plats du jour.\r\nÉpicerie de terroir, charcuterie fine."
    ],
    "nl": [
      "Maaltijden voor particulieren en professionals.\r\nL'Antre'mets biedt u een smakelijke traditionele keuken.\r\nEmblematische gerechten uit de Franse en wereldkeuken.\r\nAfhaalmaaltijden.\r\nFormules en gerechten van de dag.\r\nLokale kruidenier, delicatessenwinkel."
    ],
    "es": [
      "Comidas para particulares y profesionales.\r\nL'Antre'mets le ofrece una sabrosa cocina tradicional.\r\nPlatos emblemáticos de la cocina francesa y mundial.\r\nComidas para llevar.\r\nFórmulas y platos del día.\r\nTienda de comestibles local, delicatessen."
    ]
  },
