  "rdfs:comment": {
    "de": [
      "Im Espace culturel de Saint-Jean-de-Maurienne sind die Mediathek Louise de Savoie und das Stadtarchiv zusammengefasst.\r\nDie Mediathek verfügt neben den Abteilungen Jugend, Erwachsene und Bild und Ton über 8 Computer und WIFI-Zugang."
    ],
    "en": [
      "The Espace culturel de Saint-Jean-de-Maurienne brings together the Louise de Savoie media library and the municipal archives.\r\nIn addition to its Youth, Adult and Image & Sound departments, the media library has 8 computers and WIFI access."
    ],
    "it": [
      "L'Espace culturel de Saint-Jean-de-Maurienne ospita la biblioteca multimediale Louise de Savoie e i servizi di archivio comunale.\r\nOltre alle sezioni per giovani, adulti e immagini e suoni, la biblioteca dispone di 8 computer e accesso WIFI."
    ],
    "fr": [
      "L’Espace culturel de Saint-Jean-de-Maurienne regroupe la médiathèque Louise de Savoie et les services d'archives municipaux.\r\nLa médiathèque, en plus de ses rayons Jeunesse, Adulte et Image et son, dispose de 8 ordinateurs et d'un accès WIFI."
    ],
    "es": [
      "El Espace culturel de Saint-Jean-de-Maurienne alberga la biblioteca multimedia Louise de Savoie y los servicios de archivos municipales.\r\nAdemás de sus secciones juvenil, de adultos y de imagen y sonido, la biblioteca cuenta con 8 ordenadores y acceso WIFI."
    ],
    "nl": [
      "De culturele ruimte van Saint Jean de Maurienne huisvest de mediatheek Louise de Savoie en de gemeentelijke archiefdiensten.\r\nNaast de jeugd-, volwassenen- en beeld- en geluidsafdelingen heeft de bibliotheek 8 computers en WIFI-toegang."
    ]
  },
