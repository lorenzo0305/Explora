  "rdfs:comment": {
    "de": [
      "Au fil du dédale bietet Ihnen die Möglichkeit, seine drei originellen Kreationen zu entdecken:\r\n\"Mord in New Orleans\", \"Einbruch im Museum\" und \"Die Suche nach dem Drachen\".\r\nSpielen Sie mit der Familie, mit Freunden oder Kollegen, 2 bis 6 Spieler pro Raum."
    ],
    "en": [
      "The escape game is an adventure game where you find yourself immersed in a « locked » theme room. They must use elements present in the room to solve series of enigmas and find clues."
    ],
    "it": [
      "Au fil du dédale vi invita a scoprire le sue tre creazioni originali:\r\n\"Omicidio a New Orleans\", \"Furto al museo\" e \"Alla ricerca del drago\".\r\nVieni a giocare con la tua famiglia, i tuoi amici o i tuoi colleghi, da 2 a 6 giocatori per stanza"
    ],
    "fr": [
      "Au fil du dédale vous propose de découvrir ses trois créations originales : \r\n\"Meurtre à la Nouvelle Orléans\", \"Cambriolage au Musée\" et \"La quête du dragon\". \r\nVenez jouer en famille, entre amis ou entre collègues, 2 à 6 joueurs par salle"
    ],
    "nl": [
      "Au fil du dédale nodigt u uit om zijn drie originele creaties te ontdekken:\r\n\"Moord in New Orleans\", \"Inbraak in het museum\" en \"De zoektocht naar de draak\".\r\nKom spelen met je familie, vrienden of collega's, 2 tot 6 spelers per kamer"
    ],
    "es": [
      "Au fil du dédale le invita a descubrir sus tres originales creaciones:\r\n\"Asesinato en Nueva Orleans\", \"Robo en el museo\" y \"La búsqueda del dragón\".\r\nVenga a jugar con su familia, amigos o colegas, de 2 a 6 jugadores por sala."
    ]
  },
