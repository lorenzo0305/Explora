  "rdfs:comment": {
    "de": [
      "Die Karte des Feinschmeckerrestaurants wird entsprechend den vom Koch ausgewählten frischen Produkten der Saison zusammengestellt. Sie werden begeistert sein von der Eleganz und gemütlichen Loungeatmosphäre dieses Restaurants, das sich auf eine im Winter beheizte Terrasse öffnet."
    ],
    "en": [
      "The menu at this gourmet restaurant changes to suit the fresh seasonal produce chosen by the chef. Bask in the restaurant’s elegance and its cosy lounge setting which opens onto a heated terrace in winter."
    ],
    "it": [
      "Nel cuore della tenuta Charpinière a Saint-Galmier, a pochi minuti dalla scintillante fabbrica Badoit, La Source si fregia di una stella Michelin senza volersi mettere in mostra."
    ],
    "fr": [
      "Au cœur du domaine de la Charpinière, à Saint-Galmier, à quelques minutes de la pétillante usine Badoit, La Source affiche une étoile Michelin sans chercher à en mettre plein la vue."
    ],
    "nl": [
      "In het hart van het Charpinière landgoed in Saint-Galmier, op slechts een paar minuten van de sprankelende Badoit fabriek, heeft La Source een Michelinster zonder op te scheppen."
    ],
    "es": [
      "En el corazón de la finca Charpinière, en Saint-Galmier, a pocos minutos de la chispeante fábrica de Badoit, La Source ostenta una estrella Michelin sin pretender alardear."
    ]
  },
