  "rdfs:comment": {
    "de": [
      "Die Gemeinde hat den Raum der ehemaligen Schulkantine für die Einrichtung eines Bibliotheksbereichs zur Verfügung gestellt, der von der Vereinigung \"Petit à petit\" verwaltet wird und sich an Babys, Kinder, kleine und große Teenager richtet."
    ],
    "en": [
      "The municipality has made the room in the former school canteen available to the \"Petit à petit\" association for the creation of a library for babies, children and teenagers."
    ],
    "it": [
      "L'amministrazione comunale ha messo a disposizione la sala dell'ex mensa scolastica per la creazione di uno spazio biblioteca gestito dall'associazione \"Petit à petit\" e rivolto a neonati, bambini, ragazzi e adolescenti."
    ],
    "fr": [
      "La municipalité a mis à disposition la salle de l’ancienne cantine scolaire pour la création d’un espace bibliothèque géré par l’association « Petit à petit » et destinée aux bébés, enfants, petits et grands ados."
    ],
    "nl": [
      "Het gemeentebestuur heeft de ruimte in de voormalige schoolkantine beschikbaar gesteld voor het opzetten van een bibliotheekruimte die wordt beheerd door de vereniging \"Petit à petit\" en gericht is op baby's, kinderen, jongeren en oudere tieners."
    ],
    "es": [
      "El ayuntamiento ha cedido la sala del antiguo comedor escolar para la creación de un espacio bibliotecario gestionado por la asociación \"Petit à petit\" y dirigido a bebés, niños, jóvenes y adolescentes mayores."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Bibliothèque «enfance-jeunesse»"
    ]
  },
