  "rdfs:comment": {
    "de": [
      "Wir sind Imker, die sich auf den Höhen des Dorfes Chindrieux, in Lachat, gegenüber dem Lac du Bourget niedergelassen haben; wir bieten Ihnen unsere verschiedenen Honigsorten und andere Bienenstockprodukte an. Wir stellen her\r\nsüßigkeiten mit Honig. Verkauf nach Vereinbarung oder per Versandhandel."
    ],
    "en": [
      "This Apiary installed on the heights above the village of Chindrieux, facing the Lac du Bourget, offers you varieties of honey and other products, including homemade gingerbread. Sale on site (by appointment) or by correspondence."
    ],
    "it": [
      "Apicultrice sulle alture del villaggio di Chindrieux, di fronte al lago del Bourget. Varietà di miele e altri prodotti apistici, tra cui il pan di zenzero fatto in casa. Vendita sul posto (su appuntamento) o per corrispondenza."
    ],
    "fr": [
      "Apiculteurs installés sur les hauteurs du village de Chindrieux, à Lachat, face au Lac du Bourget ; nous vous proposons nos différentes variétés de miel et autres produits de la ruche. Nous fabriquons \r\ndes douceurs au miel. vente sur RDV ou par VPC."
    ],
    "nl": [
      "Imkers gevestigd op de hoogten van het dorp Chindrieux, in Lachat, tegenover het Lac du Bourget, bieden wij u onze verschillende soorten honing en andere producten van de bijenkorf. We maken ook\r\nverkoop op afspraak of per postorder."
    ],
    "es": [
      "Apicultores establecidos en las alturas del pueblo de Chindrieux, en Lachat, frente al Lac du Bourget, le ofrecemos nuestras diferentes variedades de miel y otros productos de la colmena. También fabricamos\r\nventa con cita previa o por correspondencia."
    ]
  },
  "rdfs:label": {
    "en": [
      "Chautagne Apiaries H Curta L Guichon"
    ],
