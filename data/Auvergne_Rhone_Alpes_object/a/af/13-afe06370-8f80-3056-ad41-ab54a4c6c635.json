  "rdfs:comment": {
    "de": [
      "Ornella verbindet ihre Leidenschaft für Bienen mit ihrer Vergangenheit als Küchenchefin, um Ihnen Produkte aus dem Bienenstock anzubieten."
    ],
    "en": [
      "A small beekeeping business located in the Beaune d?Allier countryside in central France, Ornella combines her passion for bees with her background as a chef to bring you products derived from the hive."
    ],
    "it": [
      "Piccola azienda apistica situata nella campagna di Beaune d'Allier, nella Francia centrale, Ornella unisce la sua passione per le api alla sua formazione di chef per offrirvi prodotti derivati dall'alveare."
    ],
    "fr": [
      "Petite entreprise d’apiculture située dans la campagne de Beaune d’Allier, au centre de la France, Ornella joint sa passion des abeilles avec son passé de cheffe de cuisine pour vous proposer des produits dérivés de la ruche."
    ],
    "es": [
      "Pequeña empresa apícola situada en la campiña de Beaune d'Allier, en el centro de Francia, Ornella combina su pasión por las abejas con su experiencia como chef para ofrecerle productos derivados de la colmena."
    ],
    "nl": [
      "Ornella combineert haar passie voor bijen met haar achtergrond als chef-kok om je producten uit de bijenkorf aan te bieden."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Miel d'O"
    ]
  },
