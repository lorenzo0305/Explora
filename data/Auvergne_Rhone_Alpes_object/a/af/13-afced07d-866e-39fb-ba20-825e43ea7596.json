  "rdfs:comment": {
    "de": [
      "Julie, Anthony und ihr Team bieten Ihnen hausgemachte Gerichte und Desserts an. Um unsere Region zu respektieren, stammen alle unsere Fleisch-, Fisch- und Eierprodukte sowie die meisten unserer Frisch- und Milchprodukte aus Frankreich."
    ],
    "en": [
      "Julie, Anthony and their team offer homemade dishes and desserts. In order to respect our terroir, all our meat, fish and eggs, as well as most of our fresh and dairy products, are of French origin."
    ],
    "it": [
      "Julie, Anthony e il loro team vi offrono piatti e dessert fatti in casa. Per rispettare i prodotti locali, tutta la carne, il pesce e le uova, così come la maggior parte dei prodotti freschi e caseari, sono di origine francese."
    ],
    "fr": [
      "Julie, Anthony et leur équipe vous proposent des plats et desserts maison. Dans un souci de respect de notre terroir, toutes nos viandes, poissons, œufs ainsi que la plupart de nos produits frais et laitiers sont d'origine Française."
    ],
    "es": [
      "Julie, Anthony y su equipo le ofrecen platos y postres caseros. Para respetar nuestros productos locales, toda nuestra carne, pescado y huevos, así como la mayoría de nuestros productos frescos y lácteos, son de origen francés."
    ],
    "nl": [
      "Julie, Anthony en hun team bieden huisgemaakte gerechten en desserts. Om onze lokale producten te respecteren, zijn al ons vlees, vis en eieren en de meeste van onze verse en zuivelproducten van Franse oorsprong."
    ]
  },
