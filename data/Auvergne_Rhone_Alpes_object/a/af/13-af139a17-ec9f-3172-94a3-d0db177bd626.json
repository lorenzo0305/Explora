  "rdfs:comment": {
    "de": [
      "Auf in den Frühling! Blumen, bunte Bäume, kleine Vögel, Kaninchen, poetische Gärten oder was auch immer! Jeder wählt sein Thema, sein Medium und das für sein Projekt geeignete Material. Ein Moment der Entspannung und der Kreativität, den Sie mit anderen teilen können."
    ],
    "en": [
      "Get ready for Spring! Flowers, colorful trees, little birds, rabbits, poetic gardens and more! Everyone chooses their own theme, medium and materials. A moment of relaxation and creativity to share."
    ],
    "it": [
      "La primavera è alle porte! Fiori, alberi colorati, uccellini, conigli, giardini poetici e molto altro! Ognuno sceglie il proprio tema, il mezzo e i materiali più adatti al proprio progetto. Un momento di relax e creatività da condividere."
    ],
    "fr": [
      "A vos envies de Printemps ! Fleurs, arbres colorés, petits oiseaux, lapinous, jardins poétiques ou autre! Chacun choisit son thème, son support et le matériel adapté à son projet. Un moment de détente et de créations à partager."
    ],
    "es": [
      "¡La primavera está a sus puertas! Flores, árboles de colores, pajaritos, conejos, jardines poéticos y mucho más Cada uno elige el tema, el soporte y los materiales que mejor se adapten a su proyecto. Un momento de relajación y creatividad para compartir."
    ],
    "nl": [
      "De lente staat voor de deur! Bloemen, kleurrijke bomen, vogeltjes, konijntjes, poëtische tuinen en nog veel meer! Iedereen kiest zijn eigen thema, medium en materialen voor zijn eigen project. Een moment van ontspanning en creativiteit om te delen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Atelier créatif du printemps"
    ]
  },
