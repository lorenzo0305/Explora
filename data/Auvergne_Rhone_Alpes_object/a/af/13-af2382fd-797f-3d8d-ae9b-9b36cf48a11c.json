  "rdfs:comment": {
    "de": [
      "Skiwake 74 bietet Ihnen Einführungen, Einzelunterricht und Praktika in Wakeboard, Wakeskate, Wakesurf, Wasserski, Monoski, aber auch für die Kleinen (ab 3 Jahren) Babyski... und das alles an einem magischen Spot, dem See von Annecy."
    ],
    "en": [
      "Skiwake74 offers private lessons, wakeboarding, wakesurfing, waterskating, waterskiing and monoskiing courses, and baby skiing for the little ones from 2 years old... all this in a magical spot, lake Annecy!"
    ],
    "it": [
      "Skiwake 74 offre corsi introduttivi, lezioni individuali e corsi di wakeboard, wakeskating, wakesurf, sci nautico e monosci, nonché baby ski per bambini a partire dai 3 anni... il tutto sul magico lago di Annecy."
    ],
    "fr": [
      "Skiwake 74 vous propose des initiations, des cours individuels, des stages de wakeboard, wakeskate, wakesurf, ski nautique, monoski, mais aussi pour les petits (à partir de 3 ans) le baby ski... et tout ça sur un spot magique, le lac d'Annecy."
    ],
    "es": [
      "Skiwake 74 ofrece cursos de iniciación, clases individuales y cursos de wakeboard, wakeskate, wakesurf, esquí acuático y monoesquí, así como baby ski para niños a partir de 3 años... y todo ello en el mágico lago de Annecy."
    ],
    "nl": [
      "Skiwake 74 biedt introductiecursussen, individuele lessen en cursussen in wakeboarden, wakeskaten, wakesurfen, waterskiën en monoskiën, maar ook babyskiën voor kinderen vanaf 3 jaar... en dat allemaal op het magische meer van Annecy."
    ]
  },
