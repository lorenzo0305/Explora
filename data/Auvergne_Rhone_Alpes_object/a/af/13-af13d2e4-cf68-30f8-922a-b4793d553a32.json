  "rdfs:comment": {
    "de": [
      "Seit 1994 präsentiert die Galerie Designer, die in der zeitgenössischen Welt verankert sind.Maler oder Bildhauer,Keramiker oder Glaskünstler,kommen Sie und entdecken Sie unsere Ausstellungen...."
    ],
    "en": [
      "Since 1994, the Gallery presents creators anchored in the contemporary world. Painters or sculptors, ceramists or glassmakers, come and discover our exhibitions...."
    ],
    "it": [
      "Dal 1994, la Galleria presenta creatori radicati nel mondo contemporaneo. Pittori o scultori, ceramisti o vetrai, venite a scoprire le nostre mostre...."
    ],
    "fr": [
      "Depuis 1994, la Galerie présente des créateurs ancrés dans le monde contemporain.Peintres ou sculpteurs,céramistes ou verriers,venez découvrir nos expositions...."
    ],
    "nl": [
      "Sinds 1994 presenteert de galerie makers die geworteld zijn in de hedendaagse wereld. Schilders of beeldhouwers, keramisten of glasblazers, kom en ontdek onze tentoonstellingen...."
    ],
    "es": [
      "Desde 1994, la Galería presenta a creadores arraigados en el mundo contemporáneo. Pintores o escultores, ceramistas o vidrieros, vengan a descubrir nuestras exposiciones...."
    ]
