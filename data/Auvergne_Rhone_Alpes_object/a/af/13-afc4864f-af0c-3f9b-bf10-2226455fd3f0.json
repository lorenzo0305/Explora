  "rdfs:comment": {
    "de": [
      "Das Restaurant A Portuguesa lädt Sie ein, die authentische portugiesische Küche in Morestel dank einer abwechslungsreichen Speisekarte zu genießen, auf der die Aromen Portugals in einer warmen und geselligen Atmosphäre im Mittelpunkt stehen. Sie können das Essen vor Ort genießen oder mitnehmen."
    ],
    "en": [
      "The restaurant A Portuguesa invites you to savor authentic Portuguese cuisine in Morestel thanks to a varied menu highlighting the flavors of Portugal in a warm and friendly atmosphere, to taste on site or take away."
    ],
    "it": [
      "Il ristorante A Portuguesa vi invita ad assaporare l'autentica cucina portoghese a Morestel, con un menù variegato dai sapori portoghesi in un'atmosfera calda e accogliente, da mangiare o da portare via."
    ],
    "fr": [
      "Le restaurant A Portuguesa vous invite à savourer l'authentique cuisine portugaise à Morestel grâce à une carte variée mettant à l'honneur des saveurs du Portugal dans une ambiance chaleureuse et conviviale, à déguster sur place ou à emporter."
    ],
    "nl": [
      "Het restaurant A Portuguesa nodigt u uit om te genieten van de authentieke Portugese keuken in Morestel, met een gevarieerd menu met Portugese smaken in een warme en vriendelijke sfeer, om te eten of om mee te nemen."
    ],
    "es": [
      "El restaurante A Portuguesa le invita a saborear la auténtica cocina portuguesa en Morestel, con una variada carta de sabores portugueses en un ambiente cálido y acogedor, para comer en el restaurante o para llevar."
    ]
  },
  "rdfs:label": {
    "en": [
      "A Portuguesa, Portuguese specialties in Morestel"
    ],
    "fr": [
      "A Portuguesa, spécialités portugaises à Morestel"
    ]
  },
