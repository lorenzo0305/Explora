  "rdfs:comment": {
    "de": [
      "Für einen Zen-Urlaub sollten Sie die richtigen Reflexe haben!\r\nMachen Sie das Beste aus Ihrem Urlaub in den Bergen und vertrauen Sie Sophie, Ihrem Wellness-Coach für die Dauer eines Urlaubs oder länger!"
    ],
    "en": [
      "For a relaxing break, have the right reflexes!\r\nSophie will be your wellness coach during your stay!"
    ],
    "it": [
      "Per una vacanza zen, abbiate i giusti riflessi!!\r\nAffidati a Sophie, la tua coach del benessere."
    ],
    "fr": [
      "Pour des vacances zen, ayez les bons réflexes !\r\nTirez le meilleur bénéfice de vos vacances à la montagne et faites confiance à Sophie, votre coach bien-être le temps d'un séjour ou plus !"
    ],
    "nl": [
      "Voor een zenvakantie moet je de juiste reflexen hebben!\r\nHaal alles uit uw vakantie in de bergen en vertrouw op Sophie, uw welzijnscoach voor een verblijf of langer!"
    ],
    "es": [
      "Para unas vacaciones zen, ¡tenga los reflejos adecuados!\r\nAproveche al máximo sus vacaciones en la montaña y confíe en Sophie, su coach del bienestar para una estancia o más"
    ]
  },
  "rdfs:label": {
    "en": [
      "Wellness coach : Atout Forme"
    ],
    "it": [
      "Coach del benessere : Atout Forme"
    ],
    "fr": [
      "Coach bien-être : Atout Forme"
    ]
  },
