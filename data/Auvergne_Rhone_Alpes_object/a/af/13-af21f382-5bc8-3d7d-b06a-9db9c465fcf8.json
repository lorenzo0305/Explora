  "rdfs:comment": {
    "de": [
      "Dieses Museum mit einer Fläche von 1200 m² zeigt mehr als 140 Jahre Know-how im Dienste mehrerer Generationen von Einwohnern des Ballungsraums Stephanskirchen. Hundert Jahre, in denen jeden Tag die Verkehrsmittel von morgen erfunden wurden."
    ],
    "en": [
      "This 1200m² museum looks back over 100 years of public transport used by several generations of Saint-Etienne's locals. A century inventing the transport of the future."
    ],
    "it": [
      "Questo museo di 1.200 m² ripercorre più di centoquaranta anni di know-how al servizio di diverse generazioni di abitanti dell'area urbana di Saint-Etienne. Cento anni passati a inventare ogni giorno i trasporti di domani."
    ],
    "fr": [
      "Ce musée, d'une superficie de 1 200 m², retrace plus de cent  quarante ans de savoir-faire au service de plusieurs générations d'habitants de l'agglomération stéphanoise. Cent ans passés à inventer, chaque jour, les transports de demain."
    ],
    "es": [
      "Este museo de 1.200 m² recorre más de ciento cuarenta años de saber hacer al servicio de varias generaciones de habitantes de la aglomeración de Saint-Etienne. Cien años inventando cada día el transporte del mañana."
    ],
    "nl": [
      "Dit museum van 1.200 m² toont meer dan honderdveertig jaar knowhow ten dienste van verschillende generaties inwoners van de stad Saint-Etienne. Honderd jaar lang werd elke dag het vervoer van morgen uitgevonden."
    ]
  },
