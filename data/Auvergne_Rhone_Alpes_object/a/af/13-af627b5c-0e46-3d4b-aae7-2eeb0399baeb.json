  "rdfs:comment": {
    "de": [
      "Pizzeria vor Ort oder zum Mitnehmen (hausgemachte Pizzateige). Verschiedene Gratins (Ravioli, Ziegenkäse-Tarti, Salate, Omeletts). Weinkeller und Bierkeller. Möglichkeit, Gruppen bis zu 35 Personen zu empfangen (auf Reservierung)."
    ],
    "en": [
      "Pizzeria on the spot or to take away (home made pizzas). Various gratins (ravioles, tarti-chèvre, meal salads, range of omelettes). Wine cellar, beer cellar. Possibility to welcome groups up to 35 persons (on reservation)"
    ],
    "it": [
      "Pizzeria sul posto o da asporto (pizze fatte in casa). Diversi gratin (ravioli, tarti-chèvre, insalate, gamma di omelette). Cantina dei vini, cantina delle birre. Possibilità di accogliere gruppi fino a 35 persone (su prenotazione)"
    ],
    "fr": [
      "Pizzéria sur place ou à emporter (Pâtes à Pizzas fabriquées maison). Différents gratins ( ravioles, tarti-chèvre, salades repas, gamme d'omelettes). Cave à vins , cave à bières. Possibilité d'accueillir les groupes jusqu'à 35 personnes (sur réservation)"
    ],
    "nl": [
      "Pizzeria ter plaatse of om mee te nemen (zelfgemaakte pizza's). Diverse gratins (ravioli, tarti-chèvre, maaltijdsalades, diverse omeletten). Wijnkelder, bierkelder. Mogelijkheid om groepen tot 35 personen te ontvangen (op reservering)"
    ],
    "es": [
      "Pizzería in situ o para llevar (pizzas caseras). Gratinados variados (raviolis, tarti-chèvre, ensaladas, tortillas variadas). Bodega de vino, bodega de cerveza. Posibilidad de acoger a grupos de hasta 35 personas (previa reserva)"
    ]
  },
