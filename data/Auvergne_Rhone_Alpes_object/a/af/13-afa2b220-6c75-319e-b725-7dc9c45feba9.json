  "rdfs:comment": {
    "de": [
      "Am Hauptplatz des Ortes St-Bonnet-le-Château, direkt neben dem Fremdenverkehrsamt gelegen, serviert Ihnen das Restaurant \"L’Horloge\" wochentags sein Tagesmenü sowie seine abwechslungsreiche Speisekarte."
    ],
    "en": [
      "On the main square of St Bonnet-le-Château's village, next to the tourist office, the restaurant \"L'Horloge\" offers a daily menu during the week and various dishes à la carte on Saturday."
    ],
    "it": [
      "Venite a gustare :\r\n- il menu del giorno e i piatti à la carte durante la settimana\r\n- i piatti à la carte del fine settimana\r\n- le specialità dello chef: pizze e hamburger fatti in casa, insalata Forézienne e dessert fatti in casa"
    ],
    "fr": [
      "Venez déguster :\r\n- le menu du jour et les plats à la carte en semaine \r\n- les plats à la carte du week-end \r\n- les spécialités du chef : Pizzas et burgers \"maison\", Salade forézienne et desserts \"maison\""
    ],
    "es": [
      "Venga y disfrute de :\r\n- el menú del día y los platos a la carta entre semana\r\n- los platos a la carta del fin de semana\r\n- las especialidades del chef: pizzas y hamburguesas caseras, ensalada Forézienne y postres caseros"
    ],
    "nl": [
      "Kom en geniet van :\r\n- het dagmenu en à la carte gerechten tijdens de week\r\n- weekendgerechten à la carte\r\n- de specialiteiten van de chef: huisgemaakte pizza's en hamburgers, salade Forézienne en huisgemaakte desserts"
    ]
  },
  "rdfs:label": {
    "de": [
      "L’Horloge –  Pizzeria und traditionelle Küche"
    ],
    "en": [
      "L'Horloge - Pizzeria and traditionnal cooking"
    ],
    "fr": [
      "L'Horloge"
    ]
  },
