  "rdfs:comment": {
    "de": [
      "Willkommen in dieser wunderschönen Einrichtung im Herzen eines hübschen kleinen Dorfes in der Haute-Loire.\r\nVerbringen Sie hier eine gute Zeit voller Freude, Geselligkeit und Gelassenheit."
    ],
    "en": [
      "Welcome to this superb establishment, in the heart of a pretty little Haute-Loire village.\r\nCome and enjoy a moment of joy, conviviality and serenity."
    ],
    "it": [
      "Benvenuti in questa splendida struttura, nel cuore di un grazioso paesino dell'Alta Loira.\r\nVenite a godervi un momento di gioia, convivialità e serenità."
    ],
    "fr": [
      "Bienvenue dans ce superbe établissement, au cœur d'un joli petit village de Haute-Loire.\r\nVenez passer un bon moment de joie, de convivialité et de sérénité."
    ],
    "nl": [
      "Welkom in dit prachtige etablissement, in het hart van een mooi dorpje in de Haute-Loire.\r\nKom genieten van een moment van vreugde, gezelligheid en sereniteit."
    ],
    "es": [
      "Bienvenido a este magnífico establecimiento, en el corazón de un bonito pueblecito del Alto Loira.\r\nVenga a disfrutar de un momento de alegría, convivencia y serenidad."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Rétro"
    ]
  },
