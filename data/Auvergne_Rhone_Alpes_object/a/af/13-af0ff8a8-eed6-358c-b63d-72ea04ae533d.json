  "rdfs:comment": {
    "de": [
      "Als Anhänger von \"Slow Food\" bietet Ihnen Tony Balli eine kühne Küche, in der sich Geschmack und Farben vermischen, eine Qualitätsküche, die nur aus ausgezeichneten Produkten hergestellt wird."
    ],
    "en": [
      "\"Slow Food\" fanatic Tony Balli invites you to enjoy a daring cuisine that mingles tastes and colours – a cuisine of quality made only with excellent products."
    ],
    "it": [
      "Seguace di \"Slow Food\", Tony Balli vi propone una cucina audace che mescola sapori e colori, una cucina di qualità fatta solo di prodotti eccellenti."
    ],
    "fr": [
      "Adepte du \"Slow Food\", Tony Balli vous propose une cuisine audacieuse mêlant les goûts et les couleurs, une cuisine de qualité faite uniquement avec d’excellents produits."
    ],
    "nl": [
      "Tony Balli, voorstander van \"Slow Food\", stelt U een gedurfde keuken voor die smaken en kleuren combineert, een kwaliteitskeuken met uitsluitend gebruik van kwaliteitsproducten."
    ],
    "es": [
      "Seguidor de \"Slow Food\", Tony Balli le ofrece una cocina atrevida que mezcla sabores y colores, una cocina de calidad elaborada sólo con productos excelentes."
    ]
  },
