  "rdfs:comment": {
    "de": [
      "14 Tennisplätze: 6 Außenplätze aus Harz, 3 Hallenplätze aus Harz, 2 Außenplätze mit Sandboden, 3 Touchtennis-Plätze.\r\n6 Außenplätze verfügen über eine kostenlose Druckknopfbeleuchtung."
    ],
    "en": [
      "14 tennis courts: 6 outdoor resin courts, 3 indoor resin courts, 2 outdoor clay courts, 3 touchtennis courts.\r\n6 outdoor courts have free push-button lighting."
    ],
    "it": [
      "14 campi da tennis: 6 campi in resina all'aperto, 3 campi in resina al coperto, 2 campi in terra battuta all'aperto, 3 campi da touch tennis.\r\n6 campi all'aperto sono dotati di illuminazione a pulsante gratuita."
    ],
    "fr": [
      "14 courts de tennis : 6 courts extérieurs en résine, 3 courts couverts en résine, 2 courts extérieurs sur terre battue, 3 courts touchtennis.\r\n6 courts extérieurs disposent d'un éclairage gratuit par bouton poussoir."
    ],
    "nl": [
      "14 tennisbanen: 6 buitenbanen van kunsthars, 3 binnenbanen van kunsthars, 2 buitenbanen van gravel, 3 touch tennisbanen.\r\n6 buitenbanen hebben gratis drukknopverlichting."
    ],
    "es": [
      "14 pistas de tenis: 6 pistas exteriores de resina, 3 pistas interiores de resina, 2 pistas exteriores de tierra batida, 3 pistas de tenis táctil.\r\n6 pistas exteriores cuentan con iluminación gratuita mediante pulsador."
    ]
  },
