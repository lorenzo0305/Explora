  "rdfs:comment": {
    "de": [
      "Traditionelles Restaurant, das die guten Produkte aus unseren Monts du Lyonnais verwendet. Ein junges und dynamisches Team empfängt Sie von Montag bis Freitag zum Mittag- und Abendessen. Gruppen auf Anfrage am Wochenende."
    ],
    "en": [
      "Traditional restaurant which uses the good products of our Monts du Lyonnais. A young and dynamic team welcomes you for lunch and dinner from Monday to Friday. Groups on request on weekends."
    ],
    "it": [
      "Ristorante tradizionale che utilizza i buoni prodotti dei nostri Monts du Lyonnais. Un team giovane e dinamico vi accoglie a pranzo e a cena dal lunedì al venerdì. Gruppi su richiesta nei fine settimana."
    ],
    "fr": [
      "Restaurant traditionnel qui utilise les bons produits de nos Monts du Lyonnais. C'est une équipe jeune et dynamique qui vous accueille pour le déjeuner et le dîner du lundi au vendredi. Groupes sur demande le weekend."
    ],
    "nl": [
      "Traditioneel restaurant dat gebruik maakt van de goede producten van onze Monts du Lyonnais. Een jong en dynamisch team verwelkomt u voor lunch en diner van maandag tot vrijdag. Groepen op aanvraag in het weekend."
    ],
    "es": [
      "Restaurante tradicional que utiliza los buenos productos de nuestros Monts du Lyonnais. Un equipo joven y dinámico le da la bienvenida para almorzar y cenar de lunes a viernes. Grupos a petición los fines de semana."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant La Fougassette"
    ]
  },
