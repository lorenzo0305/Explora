  "rdfs:comment": {
    "de": [
      "Das Haus Arnaud Soubeyran ist sehr an der Wahl seiner Rohstoffe interessiert und setzt seit 1837 seine handwerkliche Herstellung im Wasserbad in Kupferkesseln fort.\r\nEntdecken Sie die älteste Fabrik in Montélimar!"
    ],
    "en": [
      "Very attached to the choice of its raw materials, the Arnaud Soubeyran house continues its artisanal manufacture in a bain-marie, in copper cauldrons, since 1837.\r\nDiscover the oldest factory still in operation in Montélimar!"
    ],
    "it": [
      "Dal 1837 Arnaud Soubeyran produce i suoi prodotti a bagnomaria in calderoni di rame.\r\nScoprite la più antica fabbrica ancora in funzione a Montélimar!"
    ],
    "fr": [
      "Très attachée au choix de ses matières premières, la maison Arnaud Soubeyran poursuit ses fabrications artisanales au bain-marie, dans des chaudrons en cuivre, depuis 1837.\r\nDécouvrez la plus ancienne fabrique encore en activité à Montélimar !"
    ],
    "nl": [
      "Zeer gehecht aan de keuze van de grondstoffen zet het huis van Arnaud Soubeyran zijn ambachtelijke productie voort in een bain-marie, in koperen ketel, sinds 1837.\r\nOntdek de oudste fabriek die nog in bedrijf is in Montélimar!"
    ],
    "es": [
      "Arnaud Soubeyran elabora sus productos en calderas de cobre al baño maría desde 1837, y es muy cuidadoso en la elección de sus materias primas.\r\nDescubra la fábrica más antigua que sigue en funcionamiento en Montélimar"
    ]
  },
