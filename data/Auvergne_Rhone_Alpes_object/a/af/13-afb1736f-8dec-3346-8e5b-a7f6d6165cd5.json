  "rdfs:comment": {
    "de": [
      "Vélo voies douces bietet Ihnen den Verleih von Fahrrädern, Muskelfahrrädern oder Fahrrädern mit elektrischer Unterstützung. So können Sie die wunderschönen Landschaften der Umgebung entdecken und dabei Spaß haben, allein, mit der Familie oder mit Freunden während eines oder mehrerer Tage."
    ],
    "en": [
      "Vélo voies douces offers you the possibility to rent bicycles, either muscle bikes or electric bikes. You will be able to discover the magnificent surrounding landscapes while having fun, alone, with family or friends, for one or more days."
    ],
    "it": [
      "Vélo voies douces offre la possibilità di noleggiare biciclette, sia muscolari che elettriche. Potrete scoprire i magnifici paesaggi circostanti divertendovi, da soli, in famiglia o con gli amici, per uno o più giorni."
    ],
    "fr": [
      "Vélo voies douces vous propose la location de vélos, musculaires ou à assistance électrique. Vous pourrez ainsi découvrir les magnifiques paysages environnants tout en prenant du plaisir, seul, en famille ou entre amis durant un ou plusieurs jours."
    ],
    "nl": [
      "Vélo voies douces verhuurt spier- en elektrische fietsen. Ontdek prachtige landschappen alleen of met gezin/vrienden voor dagen vol plezier."
    ],
    "es": [
      "Vélo voies douces le ofrece la posibilidad de alquilar bicicletas, ya sean musculosas o eléctricas. Podrá descubrir los magníficos paisajes de los alrededores mientras se divierte, solo, en familia o con amigos, durante uno o varios días."
    ]
  },
  "rdfs:label": {
    "en": [
      "Vélo Voies Douces - bike rental"
    ],
    "fr": [
      "Vélo Voies Douces - Location de vélo"
    ],
    "nl": [
      "Vélo Voies Douces - fietsverhuur"
    ]
  },
