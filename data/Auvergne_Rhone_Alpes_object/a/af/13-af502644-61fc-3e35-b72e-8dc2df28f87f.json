  "rdfs:comment": {
    "de": [
      "Jean-François Brenier ist ein Handwerker, der zeitgenössische Möbel entwirft und an der Ecole Boulle studiert hat. Er bietet Ihnen kreative Lösungen für Ihre Möbel- und Einrichtungsprojekte."
    ],
    "en": [
      "Visits by appointment only.\r\nWorkshop of Jean-François Brenier, Ecole Boulle graduate, cabinetmaker and designer of contemporary furniture and fittings.\r\nLabel des Artisans Ebénistes de France."
    ],
    "it": [
      "Jean-François Brenier, designer di mobili contemporanei e diplomato all'Ecole Boulle, offre soluzioni creative per i vostri progetti di arredamento e interior design."
    ],
    "fr": [
      "Artisan créateur de mobilier contemporain issu de l’école Boulle, Jean-François Brenier vous apporte des solutions créatives pour vos projets de mobilier et d’agencement."
    ],
    "es": [
      "Jean-François Brenier, diseñador de mobiliario contemporáneo y diplomado de la Ecole Boulle, ofrece soluciones creativas para sus proyectos de mobiliario e interiorismo."
    ],
    "nl": [
      "Bezoek alleen op afspraak.\r\nHet atelier van Jean-François Brenier, afgestudeerd aan de Ecole Boulle, meubelmaker en ontwerper van eigentijds meubilair en beslag.\r\nLabel des Artisans Ebénistes de France."
    ]
  },
