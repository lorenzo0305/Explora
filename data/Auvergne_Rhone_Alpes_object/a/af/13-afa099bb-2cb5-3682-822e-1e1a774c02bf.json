  "rdfs:comment": {
    "de": [
      "La Condemine ist eine ehemalige Templeranlage, die Beatrice von Burgund als Lehensgut von Robert Graf von Clermont, dem Sohn des Heiligen Ludwig, überlassen wurde. Das polygonale Gebäude wird von einem wasserführenden Graben geschützt. Kostenpflichtige Besichtigung der Restaurierungsarbeiten und frei zugängliche Gärten."
    ],
    "en": [
      "La Condemine is a former Templar site and fiefdom of Beatrice de Bourgogne, wife of Robert Comte de Clermont, son of St-Louis. This polygonal edifice is protected by a moat. Visit of the restoration site and gardens free of charge."
    ],
    "it": [
      "La Condemine è un antico sito templare e feudo di Beatrice di Borgogna, moglie di Roberto conte di Clermont, figlio di San Luigi. Questo edificio poligonale è protetto da un fossato. L'ingresso al sito di restauro e ai giardini è gratuito."
    ],
    "fr": [
      "La Condemine est un ancien site templier fief de Béatrice de Bourgogne épouse de Robert comte de Clermont, fils de St-Louis. Cet édifice polygonal est protégé par un fossé en eau. Visite payante du chantier de restauration et jardins libres d'accès."
    ],
    "nl": [
      "La Condemine is een voormalige tempelierssite en leengoed van Beatrice van Bourgondië, echtgenote van Robert graaf van Clermont, zoon van Saint Louis. Dit veelhoekige gebouw wordt beschermd door een gracht. De toegang tot de restauratieplaats en de tuinen is gratis."
    ],
    "es": [
      "La Condemine es un antiguo emplazamiento templario y feudo de Beatriz de Borgoña, esposa de Roberto conde de Clermont, hijo de San Luis. Este edificio poligonal está protegido por un foso. La entrada al lugar de restauración y a los jardines es gratuita."
    ]
  },
  "rdfs:label": {
