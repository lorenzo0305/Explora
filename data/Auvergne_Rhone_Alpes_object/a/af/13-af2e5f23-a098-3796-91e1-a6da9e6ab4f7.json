  "rdfs:comment": {
    "de": [
      "Die geführte Tour lädt Sie ein, in die Vergangenheit zu reisen und die Waschhäuser und Brunnen dieses charmanten mittelalterlichen Dorfes zu entdecken, das inmitten von Weinbergen und Lavendelfeldern liegt."
    ],
    "en": [
      "The guided tour invites you to travel back in time, discovering the wash houses and fountains of this charming medieval village, nestled in the heart of vineyards and lavender fields."
    ],
    "it": [
      "La visita guidata vi porterà indietro nel tempo alla scoperta dei lavatoi e delle fontane di questo incantevole borgo medievale, immerso nei vigneti e nei campi di lavanda."
    ],
    "fr": [
      "La visite guidée vous invite à remonter le fil du temps, à la découverte des lavoirs et des fontaines de ce charmant village médiéval, posé au cœur des vignes et des champs de lavande."
    ],
    "es": [
      "La visita guiada le hará retroceder en el tiempo para descubrir los lavaderos y las fuentes de este encantador pueblo medieval, situado en el corazón de viñedos y campos de lavanda."
    ],
    "nl": [
      "De rondleiding neemt je mee terug in de tijd om de washuizen en fonteinen van dit charmante middeleeuwse dorp te ontdekken, gelegen in het hart van wijngaarden en lavendelvelden."
    ]
  },
  "rdfs:label": {
    "en": [
      "Visite commentée \"Entre fontaines et vignobles\""
    ],
    "fr": [
      "Visite commentée \"Entre fontaines et vignobles\""
    ]
  },
