  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/37ae80cb-84f3-32c0-9cc9-3dd8a0d08c45",
      "dc:description": {
        "de": [
          "Herstellung von Klebewerbung für Schaufenster und Geschäftsfahrzeuge. Werbetafeln und Kattunbanner sowie Schilder, Aufkleber und maßgeschneiderte Beschriftungen"
        ],
        "en": [
          "Manufacture of adhesive advertising for shop windows and commercial vehicles. Advertising panels and calico banners, as well as custom-made signs, stickers and lettering"
        ],
        "it": [
          "Produzione di pubblicità adesiva per vetrine e veicoli commerciali. Pannelli pubblicitari e striscioni di calico, oltre a insegne, adesivi e scritte su misura"
        ],
        "fr": [
          "Fabrication de publicité adhésive pour vitrines et véhicules commerciaux. Panneaux publicitaires et des banderoles calicots, ainsi que des enseignes, des autocollants et des lettrages sur-mesure"
        ],
        "nl": [
          "Productie van zelfklevende reclame voor etalages en bedrijfsvoertuigen. Reclamepanelen en calico banners, evenals op maat gemaakte borden, stickers en belettering"
        ],
        "es": [
          "Fabricación de publicidad adhesiva para escaparates y vehículos comerciales. Paneles publicitarios y banderolas de percal, así como rótulos, pegatinas y rotulación a medida"
        ]
      },
