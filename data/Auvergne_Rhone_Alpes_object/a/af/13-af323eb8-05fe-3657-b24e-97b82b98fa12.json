  "rdfs:comment": {
    "de": [
      "Hamburgerspezialitäten, Kebab, Wings, Tenders, Paninis....100% Halal. Zum Verzehr vor Ort oder zum Mitnehmen, drinnen oder auf der Terrasse, in einer familiären Atmosphäre."
    ],
    "en": [
      "Specialities of hamburgers, kebab, wings, tenders, paninis....100% Halal. To be tasted on the spot or to take away, inside or on the terrace, in a family atmosphere."
    ],
    "it": [
      "Specialità di hamburger, kebab, alette di pollo, offerte, panini....100% Halal. Da gustare sul posto o da asporto, all'interno o in terrazza, in un'atmosfera familiare."
    ],
    "fr": [
      "Spécialités de hamburgers, kebab, wings, tenders, paninis....100% Halal. À déguster sur place ou à emporter, en intérieur ou en terrasse, dans une ambiance familiale."
    ],
    "nl": [
      "Specialiteiten van hamburgers, kebab, wings, tenders, panini's....100% Halal. Om ter plaatse te genieten of om mee te nemen, binnen of op het terras, in een familiale sfeer."
    ],
    "es": [
      "Especialidades de hamburguesas, kebab, alitas, tenders, paninis....100% Halal. Para disfrutar allí mismo o para llevar, en el interior o en la terraza, en un ambiente familiar."
    ]
  },
