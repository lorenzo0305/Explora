  "rdfs:comment": {
    "de": [
      "Kurse für biologische und pflanzliche Küche. Catering, Koch zu Hause.\r\nWir lernen, wie man mit biologischen, frischen und lokalen Produkten pflanzlichen Ursprungs anders kocht und gleichzeitig den Konsum von unverdaulichen, fettigen und zuckerhaltigen Produkten reduziert."
    ],
    "en": [
      "Organic and plant-based cooking courses. Caterer, home chef.\r\nWe'll learn how to cook differently with organic, fresh and local plant-based products, while cutting down on the consumption of industrial, fatty and sugary products."
    ],
    "it": [
      "Corsi di cucina biologica e vegetale. Catering, chef a domicilio.\r\nImpareremo a cucinare in modo diverso con prodotti biologici, freschi e locali di origine vegetale, riducendo il consumo di prodotti industriali, grassi e dolci."
    ],
    "fr": [
      "Cours de cuisine bio et végétale. Traiteur, chef à domicile.\r\nNous apprendrons à cuisiner autrement avec des produits bio, frais et locaux d'origine végétale, tout en diminuant la consommation de produits indusriels, gras et sucrés."
    ],
    "es": [
      "Cursos de cocina ecológica y vegetal. Catering, chef a domicilio.\r\nAprenderemos a cocinar de forma diferente con productos ecológicos, frescos y locales de origen vegetal, reduciendo el consumo de productos industriales, grasos y dulces."
    ],
    "nl": [
      "Biologische en plantaardige kookcursussen. Traiteur, thuiskok.\r\nWe leren anders koken met biologische, verse en lokale plantaardige producten, terwijl we de consumptie van industriële, vette en suikerrijke producten beperken."
    ]
  },
