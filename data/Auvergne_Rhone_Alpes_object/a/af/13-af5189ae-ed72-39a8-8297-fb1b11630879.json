  "rdfs:comment": {
    "de": [
      "Über den Dächern Lyons gelegen, hat sich das Fort Saint-Laurent im Laufe der Jahrhunderte immer wieder neu erfunden. Die Bar Les Terrasses du Fort öffnet sich auf der Terrasse und nimmt an schönen Tagen ihren Platz ein."
    ],
    "en": [
      "Overlooking the rooftops of Lyon, Fort Saint-Laurent has reinvented itself over the centuries. The Les Terrasses du Fort bar opens onto the terrace and takes up residence there when the warm weather arrives."
    ],
    "it": [
      "Affacciato sui tetti di Lione, il Fort Saint-Laurent è stato reinventato nel corso dei secoli. Il bar Les Terrasses du Fort si apre sulla terrazza e vi prende dimora quando arriva il bel tempo."
    ],
    "fr": [
      "Surplombant les toits de Lyon, le Fort Saint-Laurent s’est réinventé au fil des siècles. Le bar Les Terrasses du Fort s’ouvre sur la terrasse et y prend ses quartiers à l’arrivée des beaux jours."
    ],
    "nl": [
      "Fort Saint-Laurent kijkt uit over de daken van Lyon en is door de eeuwen heen opnieuw uitgevonden. De bar Les Terrasses du Fort komt uit op het terras en neemt er zijn intrek als het mooi weer is."
    ],
    "es": [
      "Con vistas a los tejados de Lyon, el Fuerte Saint-Laurent se ha reinventado a lo largo de los siglos. El bar Les Terrasses du Fort se abre a la terraza y se instala en ella cuando llega el buen tiempo."
    ]
  },
