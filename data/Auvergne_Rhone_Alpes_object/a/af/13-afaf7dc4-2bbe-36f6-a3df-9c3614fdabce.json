  "rdfs:comment": {
    "de": [
      "Im Herzen der Auvergne, nur wenige Schritte vom mittelalterlichen Dorf Besse entfernt, empfangen wir Sie in einer familiären und herzlichen Umgebung."
    ],
    "en": [
      "In the heart of the Auvergne, a stone's throw from the medieval village of Besse, we will welcome you in a warm and familiar atmosphere."
    ],
    "it": [
      "Nel cuore dell'Alvernia, a due passi dal borgo medievale di Besse, vi accogliamo in un'atmosfera calda e familiare."
    ],
    "fr": [
      "En plein coeur de l'Auvergne, à deux pas du village médiéval de Besse, nous vous accueillons dans un cadre familial et chaleureux."
    ],
    "nl": [
      "In het hart van de Auvergne, op een steenworp afstand van het middeleeuwse dorp Besse, verwelkomen wij u in een warme en familiale sfeer."
    ],
    "es": [
      "En el corazón de Auvernia, a un paso del pueblo medieval de Besse, le damos la bienvenida en un ambiente cálido y familiar."
    ]
  },
  "rdfs:label": {
