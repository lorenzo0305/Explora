  "rdfs:comment": {
    "de": [
      "Tauche ein in das Herz der Foulées des Berges de l'Allier mit drei Läufen, die speziell auf dich zugeschnitten sind: ein schneller 10-km-Lauf, ein natürlicher 21-km-Lauf und ein energiegeladener Kinderlauf."
    ],
    "en": [
      "Dive into the heart of the Foulées des Berges de l?Allier with three races designed with you in mind: a fast 10km, a natural, fast-paced 21km, and an energetic children?s race."
    ],
    "it": [
      "Immergetevi nel cuore delle Foulées des Berges de l'Allier con tre gare pensate per voi: una 10 km veloce, una 21 km naturale e frenetica e un'energica gara per bambini."
    ],
    "fr": [
      "Plonge au cœur des Foulées des Berges de l’Allier avec trois courses pensées pour toi : un 10 km rapide, un 21 km naturel et roulant, et une course enfants pleine d’énergie."
    ],
    "es": [
      "Sumérgete en el corazón de las Foulées des Berges de l'Allier con tres carreras diseñadas pensando en ti: unos rápidos 10 km, unos naturales y trepidantes 21 km y una enérgica carrera infantil."
    ],
    "nl": [
      "Duik in het hart van de Foulées des Berges de l'Allier met drie wedstrijden die speciaal voor jou zijn ontworpen: een snelle 10 km, een natuurlijke, snelle 21 km en een energieke kinderwedstrijd."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Foulées des Berges de l'Allier"
    ]
  },
