  "rdfs:comment": {
    "de": [
      "Entdecken Sie ein außergewöhnliches Landgut im Herzen der Drôme.\r\nLe Clos du Puits ist ein Empfangsbereich im Rovaltain-Dreieck, in der Nähe von Romans, Tain-l'Hermitage und 1 km vom TGV-Bahnhof Valence entfernt."
    ],
    "en": [
      "Discover an exceptional estate in the heart of the Drôme.\r\nLe Clos du Puits is a reception estate in the heart of the Rovaltain triangle, close to Romans, Tain-l'Hermitage and 1 km from Valence TGV station."
    ],
    "it": [
      "Scoprite una tenuta eccezionale nel cuore della Drôme.\r\nLe Clos du Puits è una tenuta di accoglienza nel cuore del triangolo della Rovaltain, vicino a Romans, Tain-l'Hermitage e a 1 km dalla stazione TGV di Valence."
    ],
    "fr": [
      "Découvrez un domaine d'exception en plein cœur de la Drôme.\r\nLe Clos du Puits est un domaine de réception en plein triangle Rovaltain, proche de Romans, Tain-l'Hermitage et à 1 km de la gare TGV de Valence."
    ],
    "nl": [
      "Ontdek een uitzonderlijk landgoed in het hart van de Drôme.\r\nLe Clos du Puits is een receptiedomein in het hart van de Rovaltain-driehoek, vlakbij Romans en Tain-l'Hermitage en op 1 km van het TGV-station van Valence."
    ],
    "es": [
      "Descubra una finca excepcional en el corazón de la Drôme.\r\nLe Clos du Puits es una finca de acogida en el corazón del triángulo de Rovaltain, cerca de Romans, Tain-l'Hermitage y a 1 km de la estación de TGV de Valence."
    ]
  },
