  "rdfs:comment": {
    "de": [
      "Entdecken Sie eine gepflegte Küche, die mit Leidenschaft zubereitet wird, in einer familiären und freundlichen Atmosphäre\r\n Lernen Sie unser neues Team kennen und lassen Sie sich von unserer gemütlichen Umgebung verzaubern."
    ],
    "en": [
      "Come and discover our fine cuisine, prepared with passion, in a friendly family atmosphere\r\n Meet our new team and let yourself be seduced by our warm atmosphere."
    ],
    "it": [
      "Venite a scoprire la nostra cucina raffinata, preparata con passione, in un'atmosfera familiare e amichevole\r\n Incontrate il nostro nuovo team e lasciatevi sedurre dalla nostra calda atmosfera."
    ],
    "fr": [
      "Venez découvrir une cuisine soignée, préparée avec passion, dans une ambiance familiale et conviviale\r\n Rencontrez notre nouvelle équipe et laissez-vous séduire par notre cadre chaleureux."
    ],
    "es": [
      "Venga a descubrir nuestra buena cocina, preparada con pasión, en un ambiente familiar y acogedor\r\n Conozca a nuestro nuevo equipo y déjese seducir por nuestro cálido ambiente."
    ],
    "nl": [
      "Kom en ontdek onze verfijnde keuken, bereid met passie, in een gezellige familiesfeer\r\n Ontmoet ons nieuwe team en laat je verleiden door onze warme sfeer."
    ]
  },
  "rdfs:label": {
    "fr": [
