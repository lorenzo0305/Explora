  "rdfs:comment": {
    "de": [
      "Gruppe von Handwerkern aus Drôme / Ardèche. Eine Boutique / Werkstatt, in der Sie originelle und einzigartige Stücke finden. Kreationen aus Glas, Lederwaren, Keramik, Kreationen für Kinder, Schmuck ..."
    ],
    "en": [
      "A group of craftsmen from Drôme/Ardèche come together for this friendly shop/workshop where you will find original, unique craftwork. Glass, leather work, ceramics, jewellery, creations for children…"
    ],
    "it": [
      "Un gruppo di artigiani della Drôme/Ardèche. Un accogliente negozio/laboratorio dove troverete pezzi originali e unici. Creazioni in vetro, pelletteria, ceramica, creazioni per bambini, gioielli, mobili, decorazioni, illustrazioni..."
    ],
    "fr": [
      "Regroupement d'artisans de Drôme/Ardèche. Une boutique/atelier chaleureuse où vous trouverez des pièces originales et uniques. Créations en verre, maroquinerie, céramique, créations pour les enfants, bijoux, mobilier, décoration, illustrations..."
    ],
    "es": [
      "Un grupo de artesanos de la región de Drôme/Ardèche. Una acogedora tienda-taller donde encontrará piezas originales y únicas. Creaciones en vidrio, marroquinería, cerámica, creaciones infantiles, joyas, muebles, decoración, ilustraciones..."
    ],
    "nl": [
      "Een groep ambachtslieden uit de Drôme / Ardèche. Een boetiek / atelier waar je originele en unieke stukken kunt vinden. Creaties in glas, lederwaren, keramiek, ontwerpen voor kinderen, sieraden…"
    ]
  },
