  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/200c9c51-d481-323a-b9e2-ec91ffe85206",
      "dc:description": {
        "de": [
          "Crédit Agricole Nord de France ist ein Bankinstitut, das sichere und zuverlässige Banklösungen für die Kunden in der Region anbietet. Als Geldautomaten sind sie leicht zugänglich und bieten praktische und effiziente Dienstleistungen für alle ihre Kunden."
        ],
        "en": [
          "Crédit Agricole Nord de France is a banking institution offering secure and reliable banking solutions for customers in the region. As an ATM, they are easily accessible and offer convenient and efficient services to all their customers."
        ],
        "it": [
          "Il Crédit Agricole Nord de France è un istituto bancario che offre soluzioni bancarie sicure e affidabili ai clienti della regione. Come ATM, è facilmente accessibile e offre servizi convenienti ed efficienti a tutti i suoi clienti."
        ],
        "fr": [
          "Crédit Agricole Nord de France est une institution bancaire offrant des solutions bancaires sûres et fiables pour les clients de la région. En tant que distributeur automatique de billets, ils sont facilement accessibles et offrent des services pratiques et efficaces à tous leurs clients."
        ],
        "nl": [
          "Crédit Agricole Nord de France is een bankinstelling die veilige en betrouwbare bankoplossingen biedt aan klanten in de regio. Als geldautomaat zijn ze gemakkelijk bereikbaar en bieden ze handige en efficiënte diensten aan al hun klanten."
        ],
        "es": [
          "Crédit Agricole Nord de France es una entidad bancaria que ofrece soluciones bancarias seguras y fiables a los clientes de la región. Como cajero automático, son fácilmente accesibles y ofrecen servicios cómodos y eficaces a todos sus clientes."
        ]
      },
      "@type": [
        "Description"
