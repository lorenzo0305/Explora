  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/3fb1e915-ca57-3e50-837c-0397faa1ad68",
      "dc:description": {
        "de": [
          "Beach Bike Berck\nMountainbike-Rennen auf Sand.\nStart am Strand gegenüber dem Place de l'entonnoir.\n\nParcours für Kinder:\nvon den Jüngsten (11-12 Jahre) bis zu den Kleinsten (13-14 Jahre) einschließlich 1 Runde von 7 km\n\nKleine Strecke (28 km)\nab Jüngsten (15 Jahre) einschließlich 4 Schleifen von 7 km (Erwachsene)\n\nGroße Strecke (49km)\nab Junioren (17 Jahre) einschließlich 7 Schleifen von 7km ( Erwachsene)"
        ],
        "en": [
          "Beach Bike Berck\nMountain bike race on sand.\nStart on the beach opposite Place de l'Entonnoir.\n\nKids' course:\nfrom benjamins (11-12 yrs) to minimes (13-14 yrs) including 1 loop of 7 km\n\nSmall course (28km)\ncadets (15 years) included 4 loops of 7 km (adult)\n\nLarge course (49km)\nfrom juniors (17 years), including 7 loops of 7km (adult)"
        ],
        "it": [
          "Beach Bike Berck\nGara di mountain bike sulla sabbia.\nPartenza dalla spiaggia di fronte a Place de l'Entonnoir.\n\nPercorso per bambini:\ndai benjamin (11-12 anni) ai minime (13-14 anni) con 1 anello di 7 km\n\nPercorso breve (28 km)\ndai cadetti (15 anni) con 4 anelli di 7 km (adulti)\n\nPercorso grande (49 km)\nda juniores (17 anni), compresi 7 anelli di 7 km (adulti)"
        ],
        "fr": [
          "Beach Bike Berck\nCourse VTT sur sable.\nDépart sur la plage face à la place de l'entonnoir.\n\nParcours kids:\nde benjamins (11-12 ans) à minimes (13-14 ans) inclus 1 boucle de 7 km \n\nPetit parcours (28km)\nà partir de cadets (15 ans) inclus 4 boucles de 7 km ( adulte) \n\nGrand parcours (49km) \nà partir de juniors 17 ans, inclus 7 boucles de 7km ( adulte)"
        ],
        "nl": [
          "Strandfiets Berck\nMountainbikerace op het zand.\nStart op het strand tegenover Place de l'Entonnoir.\n\nParcours voor kinderen:\nvan benjamins (11-12 jaar) tot minimes (13-14 jaar) inclusief 1 lus van 7 km\n\nKort parcours (28 km)\nvan cadetten (15 jaar) inclusief 4 lussen van 7 km (volwassenen)\n\nGroot parcours (49km)\nvan junioren (17 jaar), waarvan 7 lussen van 7 km (volwassene)"
        ],
        "es": [
          "Beach Bike Berck\nCarrera de bicicletas de montaña sobre la arena.\nSalida en la playa frente a la Place de l'Entonnoir.\n\nRecorrido para niños:\nde benjamines (11-12 años) a minimes (13-14 años) incluyendo 1 bucle de 7 km\n\nRecorrido corto (28 km)\ndesde cadetes (15 años) incluyendo 4 vueltas de 7 km (adultos)\n\nRecorrido largo (49 km)\npara juniors (17 años), incluidas 7 vueltas de 7 km (adultos)"
        ]
      },
