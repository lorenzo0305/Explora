  "rdfs:comment": {
    "de": [
      "Eine denkmalgeschützte Kapelle aus dem 11. Jahrhundert. Sie wurde an der Stelle erbaut, an der Ochsen neben hundertjährigen Kastanien knieten, und ist eine reine provenzalische romanische Kunst."
    ],
    "en": [
      "Listed 11th-century chapel. Built on the spot where oxen knelt next to centuries-old cades, it is pure Provencal Romanesque."
    ],
    "it": [
      "Cappella classificata dell'XI secolo. Costruito nel luogo in cui i buoi si inginocchiavano accanto a cadi secolari, è un puro romanico provenzale."
    ],
    "fr": [
      "Chapelle classée du 11ème siècle. Construite à l'endroit où des boeufs se sont agenouillés prés de cades centenaires, elle est de pur art roman provençal."
    ],
    "nl": [
      "Kapel uit de 11e eeuw die op de monumentenlijst staat. Gebouwd op de plek waar ossen knielden naast eeuwenoude cades, is het puur Provençaals Romaans."
    ],
    "es": [
      "Capilla clasificada del siglo XI. Construido en el lugar donde los bueyes se arrodillaban junto a las cadas centenarias, es puro románico provenzal."
    ]
  },
