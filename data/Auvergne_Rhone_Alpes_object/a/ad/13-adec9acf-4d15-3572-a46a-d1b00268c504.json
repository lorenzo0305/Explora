  "rdfs:comment": {
    "de": [
      "Seit 1986 entwickelt und produziert Le Pain d'Épi Sauerteigbrote. Wir begrüßen Sie in unserer Bäckerei, Konditorei, Café und Teestube, wo Sie unsere vollständig hausgemachten Produktionen sowie eine Auswahl an Produkten aus der Region entdecken können."
    ],
    "en": [
      "Organic bread, stone-baked in wood-fired oven, all kneaded and shaped by hand, patisseries, cakes and viennoiserie pastries and biscuits are made on the premises."
    ],
    "it": [
      "Dal 1982, Pain d'Épi dà vita all'arte del pane biologico a lievitazione naturale. Tutti i nostri prodotti sono fatti in casa, utilizzando farine biologiche e ingredienti locali\r\ningredienti locali."
    ],
    "fr": [
      "Depuis 1982, le Pain d’Épi fait vivre l’art du pain au levain BIO. Tous nos produits sont faits maison, à partir de farines biologiques et\r\nd’ingrédients locaux."
    ],
    "es": [
      "Desde 1982, Pain d'Épi da vida al arte del pan de masa madre ecológico. Todos nuestros productos son caseros, utilizando harinas ecológicas e\r\ningredientes locales."
    ],
    "nl": [
      "Biologisch brood dat in een houtoven op een steen wordt gebakken, allemaal handgemaakt, gebak en taart en van de viennoiserie en biscuiterie die ter plekke worden bereid op de werkplaatsen."
    ]
  },
