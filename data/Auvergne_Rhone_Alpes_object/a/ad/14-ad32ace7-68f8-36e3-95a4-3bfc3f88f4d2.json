      "@id": "https://data.datatourisme.fr/c45b726d-83f9-3c75-87b4-d2b1b39207ed",
      "dc:description": {
        "de": [
          "Musikalische Praktika\nVom 15. bis 18. Juli 2025\nVom 28. bis 01. August 2025\nund vom 27. bis 31. Oktober 2025\nVon 10:30 bis 11:30 Uhr für 4/7-Jährige im Blériot-Saal\n40 ? / Kind; 35 ? für das zweite Kind der gleichen Familie\n(- 5 ? für die Woche vom 15. Juli)"
        ],
        "en": [
          "Music courses\nJuly 15 to 18, 2025\nAugust 28 to 01, 2025\nand October 27 to 31, 2025\nFrom 10:30 to 11:30 a.m. for 4/7 year-olds at salle Blériot\n40 ? / child; 35 ? for the 2nd child in the same family\n(- 5 ? for the week of July 15)"
        ],
        "it": [
          "Corsi di musica\nDal 15 al 18 luglio 2025\nDal 28 al 01 agosto 2025\ne dal 27 al 31 ottobre 2025\nDalle 10.30 alle 11.30 per i bambini di 4/7 anni presso la Salle Blériot\n40 ? / bambino; 35 ? per il 2° bambino della stessa famiglia\n(- 5 ? per la settimana del 15 luglio)"
        ],
        "fr": [
          "Stages de Musique\nDu 15 au 18 Juillet 2025\nDu 28 au 01er Août 2025\net du 27 au 31 Octobre 2025\nDe 10h30 à 11h30 pour les 4/7 ans à la salle Blériot\n40 € / enfant ; 35 € pour le 2ème enfant de la même famille \n(- 5 € pour la semaine du 15 Juillet)"
        ],
        "nl": [
          "Muziek cursussen\nVan 15 tot 18 juli 2025\nVan 28 tot 01 augustus 2025\nen van 27 tot 31 oktober 2025\nVan 10u30 tot 11u30 voor kinderen van 4/7 jaar in de Salle Blériot\n40 ? / kind; 35 ? voor het 2e kind in hetzelfde gezin\n(- 5 ? voor de week van 15 juli)"
        ],
        "es": [
          "Cursos de música\nDel 15 al 18 de julio de 2025\nDel 28 al 01 de agosto de 2025\ny del 27 al 31 de octubre de 2025\nDe 10.30 a 11.30 h para niños de 4/7 años en la Salle Blériot\n40 € / niño; 35 € para el 2º niño de la misma familia\n(- 5€ para la semana del 15 de julio)"
        ]
      },
