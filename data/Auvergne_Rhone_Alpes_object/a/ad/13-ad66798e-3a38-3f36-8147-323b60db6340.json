  "rdfs:comment": {
    "de": [
      "Die Bibliothek bietet Ihnen Bücher, Zeitschriften, CDs, DVDs, Lesegeräte zum Ausleihen, Tablets zur Nutzung vor Ort und andere digitale Dienste. Mit der einheitlichen und kostenlosen Anmeldekarte haben Sie Zugang zu allen Bibliotheken der COPAMO."
    ],
    "en": [
      "The library offers books, magazines, CDs, DVDs, e-readers to borrow, tablets to consult on site and other digital services. A single, free registration card gives you access to all COPAMO libraries."
    ],
    "it": [
      "La biblioteca offre libri, riviste, CD, DVD, e-reader da prendere in prestito, tablet da consultare in loco e altri servizi digitali. Un'unica tessera di iscrizione gratuita consente di accedere a tutte le biblioteche COPAMO."
    ],
    "fr": [
      "La bibliothèque vous propose livres, magazines, CD, DVD, liseuses  à emprunter, tablettes à consulter sur place et d’autres services numériques. La carte d'inscription unique et gratuite vous permet d’accéder à toutes les bibliothèques de la COPAMO."
    ],
    "es": [
      "La biblioteca ofrece libros, revistas, CD, DVD, lectores electrónicos en préstamo, tabletas para consultar in situ y otros servicios digitales. Una única tarjeta de registro gratuita le da acceso a todas las bibliotecas de la COPAMO."
    ],
    "nl": [
      "De bibliotheek biedt boeken, tijdschriften, cd's, dvd's, e-readers om te lenen, tablets om ter plaatse te raadplegen en andere digitale diensten. Met één gratis inschrijvingskaart heb je toegang tot alle COPAMO-bibliotheken."
    ]
  },
