  "rdfs:comment": {
    "de": [
      "Diese historische Bibliothek der Gegend befindet sich neben dem Wappensaal der Diana; sie beherbergt heute mehr als 20 000 Volumen."
    ],
    "en": [
      "The Forez regional history and archaeology library, located next to the Diana Heraldry Hall, now boasts over 60,000 catalogued works accessible to all readers."
    ],
    "it": [
      "La biblioteca di storia regionale e archeologia di Forez si trova accanto alla sala araldica di Diana e oggi contiene oltre 60.000 opere catalogate e catalogabili, accessibili a tutti i lettori."
    ],
    "fr": [
      "Bibliothèque d'Histoire régionale -celle du Forez- et d'Archéologie, aménagée à côté de la Salle Héraldique de la Diana, elle compte aujourd'hui plus de 60 000 ouvrages, répertoriés, catalogués, accessibles à tout lecteur."
    ],
    "es": [
      "La biblioteca de historia y arqueología regional de Forez, situada junto a la sala heráldica de Diana, contiene hoy más de 60.000 obras catalogadas accesibles a todos los lectores."
    ],
    "nl": [
      "De bibliotheek voor regionale geschiedenis en archeologie van Forez ligt naast de heraldische zaal van Diana en bevat vandaag de dag meer dan 60.000 geïnventariseerde en gecatalogiseerde werken die toegankelijk zijn voor alle lezers."
    ]
  },
