  "rdfs:comment": {
    "de": [
      "Anthony lädt Sie ein, seine raffinierte und ehrliche Küche zu entdecken. Freuen Sie sich auf einen schlicht und modern eingerichteten Saal und eine Terrasse mit Blick auf den Berg Solaure."
    ],
    "en": [
      "Anthony introduces his refined and authentic cuisine. You will enjoy the dining room’s modern and classic decoration with a terrace and views of Solaure mountain."
    ],
    "it": [
      "Anthony vi invita a scoprire la sua cucina raffinata e sincera. Potrete usufruire di una camera dall'arredamento sobrio e moderno e di una terrazza con vista sul monte Solaure."
    ],
    "fr": [
      "Anthony vous invite à découvrir sa cuisine raffinée et sincère. Vous pourrez profiter d'une salle à la décoration sobre et moderne, et d'une terrasse avec vue sur la montagne de Solaure."
    ],
    "es": [
      "Anthony le invita a descubrir su cocina refinada y sincera. Podrá disfrutar de una habitación con una decoración sobria y moderna, y de una terraza con vistas a la montaña Solaure."
    ],
    "nl": [
      "Anthony gaat voor een verfijnde, eerlijke keuken. Bij hem eet je in een moderne, modest ingerichte zaal of op het terras met uitzicht op de Solaure."
    ]
  },
