  "rdfs:comment": {
    "de": [
      "Eine ideale Lage im Herzen von Aix-les-Bains. Hier findet jeder Moment seinen Platz: vom ersten Kaffee am Morgen bis zu den letzten Drinks am Abend, vom schnellen Mittagessen bis zum gemeinsamen Abendessen."
    ],
    "en": [
      "Our family-run brasserie welcomes you to discover French cuisine in the center of Aix-les-Bains."
    ],
    "it": [
      "La nostra birreria a conduzione familiare vi apre le sue porte: venite a scoprire la cucina francese nel centro di Aix-les-Bains."
    ],
    "fr": [
      "Un emplacement idéal en plein cœur d'Aix-les-Bains. Ici, chaque moment trouve sa place : du premier café du matin aux derniers verres du soir, du déjeuner sur le pouce aux dîners partagés."
    ],
    "es": [
      "Una ubicación ideal en pleno centro de Aix-les-Bains. Aquí, cada momento tiene su lugar: desde el primer café de la mañana hasta las últimas copas de la noche, desde las comidas rápidas hasta las cenas compartidas."
    ],
    "nl": [
      "Een ideale locatie in het hart van Aix-les-Bains. Hier heeft elk moment zijn plaats: van de eerste koffie 's ochtends tot de laatste borrel 's avonds, van snelle lunches tot gezamenlijke diners."
    ]
  },
  "rdfs:label": {
