  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/c96f6b6d-b36c-39ee-8d42-aa13da0b7ae0",
      "dc:description": {
        "de": [
          "Spezialist für Entenpastete aus Amiens.\n\nDie Produkte von Héripré werden unter Einhaltung der Tradition ausgewählt und verarbeitet, mit einem seit vier Generationen anerkannten Know-how. Seine Lieferanten sind die besten lokalen und handwerklichen Produzenten."
        ],
        "en": [
          "Specialist in Amiens duck pâté.\n\nHéripré products are chosen and worked in the respect of tradition, with a know-how unanimously recognized since 4 generations. Its suppliers are the best local and artisanal producers."
        ],
        "it": [
          "Specializzato in paté d'anatra di Amiens.\n\nI prodotti Héripré sono selezionati e lavorati nel rispetto della tradizione, con un know-how unanimemente riconosciuto da 4 generazioni. I suoi fornitori sono i migliori produttori locali e tradizionali."
        ],
        "fr": [
          "Spécialiste du pâté de canard d’Amiens.\n\nLes produits Héripré sont choisis et travaillés dans le respect de la tradition, avec un savoir-faire unanimement reconnu depuis 4 générations. Ses fournisseurs sont les meilleurs producteurs locaux et artisanaux."
        ],
        "nl": [
          "Specialist in eendenpaté uit Amiens.\n\nDe producten van Héripré worden geselecteerd en verwerkt volgens de traditie, met een knowhow die al 4 generaties lang unaniem wordt erkend. De leveranciers zijn de beste lokale en traditionele producenten."
        ],
        "es": [
          "Especialista en paté de pato de Amiens.\n\nLos productos Héripré se seleccionan y elaboran según la tradición, con un saber hacer unánimemente reconocido desde hace 4 generaciones. Sus proveedores son los mejores productores locales y tradicionales."
        ]
      },
