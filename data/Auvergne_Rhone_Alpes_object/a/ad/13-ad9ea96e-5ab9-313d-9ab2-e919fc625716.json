  "rdfs:comment": {
    "de": [
      "Kommentierte Entdeckung des charmanten Weilers Rac, der einige Kilometer vom Zentrum von Malataverne entfernt liegt und allein schon wegen seines außergewöhnlichen Panoramas, das das Rhônetal überragt, einen Umweg wert ist."
    ],
    "en": [
      "Guided tour of the charming hamlet of Rac located a few kilometers from the center of Malataverne and which is worth the detour, if only for its exceptional panorama overlooking the Rhône valley."
    ],
    "it": [
      "Visita guidata dell'incantevole borgo di Rac, a pochi chilometri dal centro di Malataverne, che merita una visita anche solo per l'eccezionale vista panoramica sulla valle del Rodano."
    ],
    "fr": [
      "Découverte commentée du charmant hameau de Rac situé à quelques kilomètre du centre de Malataverne et qui vaut le détour, ne serait-ce que pour son panorama exceptionnel dominant la vallée du Rhône."
    ],
    "es": [
      "Visita guiada de la encantadora aldea de Rac, a pocos kilómetros del centro de Malataverne, que bien merece una visita aunque sólo sea por sus excepcionales vistas panorámicas sobre el valle del Ródano."
    ],
    "nl": [
      "Rondleiding door het charmante gehucht Rac, op slechts een paar kilometer van het centrum van Malataverne, dat alleen al vanwege het uitzonderlijke panoramische uitzicht over de Rhônevallei een bezoek waard is."
    ]
  },
  "rdfs:label": {
    "en": [
      "Visite commentée \"Rac au fil des siècles\""
    ],
    "fr": [
      "Visite commentée \"Rac au fil des siècles\""
    ]
  },
