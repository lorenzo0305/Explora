  "rdfs:comment": {
    "de": [
      "Graines d'avenir bietet Gemüse- und Blumensetzlinge sowie nachbaufähiges Bio-Saatgut zum Verkauf an.\r\nVerkauf ab Hof und auf einigen Märkten in der Region im Frühjahr."
    ],
    "en": [
      "Graines d'avenir sells market garden and flowering plants, as well as reproducible organic seeds.\r\nSales on the farm and at local markets in spring."
    ],
    "it": [
      "Graines d'avenir vende piante da orto e da fiore, nonché sementi biologiche riproducibili.\r\nVendita in azienda e in alcuni mercati locali in primavera."
    ],
    "fr": [
      "Graines d'avenir propose  à la vente de plants maraîchers et floraux, ainsi que des semences reproductibles bio. \r\nVente à la ferme et sur certains marchés de la région au printemps."
    ],
    "nl": [
      "Graines d'avenir verkoopt tuin- en bloeiende planten, maar ook reproduceerbare biologische zaden.\r\nVerkoop op de boerderij en op bepaalde lokale markten in het voorjaar."
    ],
    "es": [
      "Graines d'avenir vende plantas hortícolas y de flor, así como semillas ecológicas reproducibles.\r\nVentas en la granja y en algunos mercados locales en primavera."
    ]
  },
