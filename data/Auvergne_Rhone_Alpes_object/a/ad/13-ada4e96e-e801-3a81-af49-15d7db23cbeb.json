  "rdfs:comment": {
    "de": [
      "Nach drei völlig verrückten Ausgaben kehrt die Boarder Line zurück! Amateur-Skifahrer und internationale Athleten treffen sich zu einem neuen Boarder-Cross-Langlaufrennen. Spektakel, Stürze und Wasserfälle garantiert!"
    ],
    "en": [
      "After three crazy editions, the Boarder Line is back! Amateur skiers and international athletes come together for a new cross-country boarder cross race. Spectacle, falls and stunts guaranteed!"
    ],
    "it": [
      "Dopo tre edizioni pazzesche, torna la Boarder Line! Sciatori amatoriali e atleti internazionali si riuniscono per una nuova gara di boarder cross. Spettacolo, cadute e acrobazie garantite!"
    ],
    "fr": [
      "Après trois éditions complètement folles, la Boarder Line revient ! Skieurs amateurs et athlètes internationaux se retrouvent pour une nouvelle course de ski de fond en boarder cross. Spectacle, chutes et cascades assurés !"
    ],
    "nl": [
      "Na drie waanzinnige edities is de Boarder Line terug! Amateurskiërs en internationale atleten komen samen voor een nieuwe crosscountry boardercrosswedstrijd. Spektakel, valpartijen en stunts gegarandeerd!"
    ],
    "es": [
      "Después de tres locas ediciones, ¡vuelve la Boarder Line! Esquiadores amateurs y atletas internacionales se dan cita en una nueva carrera de cross-country boarder cross. ¡Espectáculo, caídas y acrobacias garantizadas!"
    ]
  },
