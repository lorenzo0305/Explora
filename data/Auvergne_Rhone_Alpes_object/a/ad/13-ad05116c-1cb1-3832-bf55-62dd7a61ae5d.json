  "rdfs:comment": {
    "de": [
      "Die alten Salzspeicher von Langeac, die aus dem Stein von Saint-Roch gebaut wurden, erinnern an die Zeit der Gabelle. Diese Steuern wurden im Hôtel de la Gabelle in der Rue Lafayette in Salz bezahlt."
    ],
    "en": [
      "Langeac's old salt granaries, built of Saint-Roch stone, are a reminder of the days of the Gabelle tax. This tax was paid in salt at the Hôtel de la Gabelle on rue Lafayette."
    ],
    "it": [
      "Gli antichi granai del sale di Langeac, costruiti in pietra di Saint-Roch, ricordano i tempi della tassa della Gabelle. Questa tassa veniva pagata in sale all'Hôtel de la Gabelle in rue Lafayette."
    ],
    "fr": [
      "Les anciens greniers à sel de Langeac bâtis en pierre de Saint-Roch rappelle le temps de la Gabelle. Cet impôts était payé en sel à l'Hôtel de la Gabelle rue Lafayette."
    ],
    "es": [
      "Los antiguos graneros de sal de Langeac, construidos con piedra de Saint-Roch, recuerdan la época del impuesto Gabelle. Este impuesto se pagaba en sal en el Hôtel de la Gabelle, en la calle Lafayette."
    ],
    "nl": [
      "De oude zoutopslagplaatsen van Langeac, gebouwd van steen uit Saint-Roch, herinneren aan de tijd van de Gabelle-belasting. Deze belasting werd in zout betaald in het Hôtel de la Gabelle in de rue Lafayette."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ancien grenier à sel"
    ]
  },
