  "rdfs:comment": {
    "de": [
      "Entdecken Sie das digitale Museum \"Micro-Folie\" in La Coccinelle.\r\nDiese Kulturplattform ist ein echtes digitales Museum, in dem Sie die Schätze der größten nationalen und internationalen Institutionen direkt vor Ihrer Haustür entdecken können."
    ],
    "en": [
      "Come and discover the \"Micro-Folie\" digital museum at La Coccinelle.\r\nThis cultural platform is a veritable digital museum, bringing the treasures of the world's leading national and international institutions right to your doorstep."
    ],
    "it": [
      "Venite a scoprire il museo digitale \"Micro-Folie\" a La Coccinelle.\r\nQuesta piattaforma culturale è un vero e proprio museo digitale che vi permette di scoprire i tesori delle più grandi istituzioni nazionali e internazionali proprio accanto a voi."
    ],
    "fr": [
      "Venez découvrir le musée numérique \"Micro-Folie\" à la Coccinelle.\r\nCette plateforme culturelle est un véritable musée numérique qui vous permet de découvrir, à côté de chez vous, les trésors des plus grandes institutions nationales et internationales."
    ],
    "es": [
      "Venga a descubrir el museo digital \"Micro-Folie\" en La Coccinelle.\r\nEsta plataforma cultural es un auténtico museo digital que te permite descubrir los tesoros de las mayores instituciones nacionales e internacionales justo al lado de casa."
    ],
    "nl": [
      "Kom en ontdek het digitale museum \"Micro-Folie\" in La Coccinelle.\r\nDit culturele platform is een echt digitaal museum waarmee je de schatten van de grootste nationale en internationale instellingen direct naast de deur kunt ontdekken."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Découverte de la \"Micro-Folie\" à la Coccinelle"
    ]
  },
