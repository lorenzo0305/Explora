  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Eisbahn Buisson Rond (wieder) im Restaurantmodus!\r\nLe Bercail ist Ihr neues Restaurant, das Sie für eine einfache und leckere Mittagspause empfängt."
    ],
    "en": [
      "Come and (re)discover the Buisson Rond ice rink in restaurant mode!\r\nLe Bercail is your new restaurant that welcomes you for a simple and greedy lunch break."
    ],
    "it": [
      "Venite a (ri)scoprire la pista di ghiaccio del Buisson Rond in modalità ristorante!\r\nLe Bercail è il nuovo ristorante che vi accoglie per una pausa pranzo semplice e golosa."
    ],
    "fr": [
      "Venez (re)découvrir la patinoire Buisson Rond en mode restauration !\r\nLe Bercail, c'est votre nouveau restaurant qui vous accueille pour une pause déjeuner simple et gourmande."
    ],
    "es": [
      "¡Venga a (re)descubrir la pista de hielo Buisson Rond en modo restaurante!\r\nLe Bercail es su nuevo restaurante que le da la bienvenida para un almuerzo sencillo y gourmet."
    ],
    "nl": [
      "Kom de ijsbaan Buisson Rond (her)ontdekken in restaurantvorm!\r\nLe Bercail is uw nieuwe restaurant dat u verwelkomt voor een eenvoudige en gastronomische lunchpauze."
    ]
  },
  "rdfs:label": {
