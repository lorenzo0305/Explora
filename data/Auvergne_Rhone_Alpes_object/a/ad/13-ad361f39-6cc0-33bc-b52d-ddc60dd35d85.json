  "rdfs:comment": {
    "de": [
      "Die Vereinigung Font d'Urle 1500 wertet die außergewöhnliche Naturlandschaft von Font d'Urle auf 1500 m Höhe auf. Sie bietet sportliche und kulturelle Aktivitäten für alle in einer geselligen Atmosphäre an, um die Reichtümer des Vercors zu entdecken."
    ],
    "en": [
      "The Font d'Urle 1500 association promotes the exceptional natural site of Font d'Urle at an altitude of 1500 meters. It offers sporting and cultural activities for all, in a friendly atmosphere, to help people discover the riches of the Vercors."
    ],
    "it": [
      "L'associazione Font d'Urle 1500 promuove l'eccezionale sito naturale di Font d'Urle, a 1.500 metri di altitudine. Propone attività sportive e culturali per tutti, in un'atmosfera amichevole, per far scoprire le ricchezze del Vercors."
    ],
    "fr": [
      "L'association Font d'Urle 1500  valorise le site naturel exceptionnel de Font d'Urle à 1500 mètres d'altitude. Elle propose des activités sportives et culturelles pour tous, dans une ambiance conviviale  afin de faire découvrir les richesses du Vercors."
    ],
    "es": [
      "La asociación Font d'Urle 1500 promueve el excepcional paraje natural de Font d'Urle, a 1.500 metros de altitud. Ofrece actividades deportivas y culturales para todos, en un ambiente acogedor, para hacer descubrir las riquezas del Vercors."
    ],
    "nl": [
      "De vereniging Font d'Urle 1500 promoot het uitzonderlijke natuurgebied van Font d'Urle op 1500 meter hoogte. Het biedt sportieve en culturele activiteiten voor iedereen, in een gezellige sfeer, om mensen de rijkdommen van de Vercors te laten ontdekken."
    ]
  },
  "rdfs:label": {
