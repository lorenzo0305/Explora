  "rdfs:comment": {
    "de": [
      "Traditionelles Restaurant, in dem wir alle Gerichte der französischen und regionalen Küche zubereiten, sowie einige Spezialitäten: Frösche, Kalbskopf, Salate oder Muscheln mit Pommes frites (am Abend)."
    ],
    "en": [
      "Traditional restaurant where we cook all the dishes of French and regional cuisine, as well as a few specialties: frogs, calf's head, salads or fried mussels (in the evening)."
    ],
    "it": [
      "Ristorante tradizionale dove cuciniamo tutti i piatti della cucina francese e regionale, oltre ad alcune specialità: rane, testa di vitello, insalate o cozze fritte (la sera)."
    ],
    "fr": [
      "Restaurant traditionnel où nous cuisinons tous les plats de la cuisine française et régionale, ainsi que quelques spécialités: grenouilles, tête de veau, salades repas ou moules frites (le soir)."
    ],
    "nl": [
      "Traditioneel restaurant waar we alle gerechten uit de Franse en regionale keuken bereiden, maar ook enkele specialiteiten: kikkers, kalfskop, salades of mosselen  met frites ('s avonds)."
    ],
    "es": [
      "Restaurante tradicional donde se cocinan todos los platos de la cocina francesa y regional, así como algunas especialidades: ranas, cabeza de ternera, ensaladas o mejillones fritos (por la noche)."
    ]
  },
  "rdfs:label": {
