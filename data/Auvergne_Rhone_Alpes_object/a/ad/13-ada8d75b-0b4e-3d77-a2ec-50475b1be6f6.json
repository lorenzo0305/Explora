  "rdfs:comment": {
    "de": [
      "Das Fresko an einer der Fassaden der Ecole Municipale Louise Michel wurde von dem Künstler Fokus aus der Drôme gestaltet. Das Alphabet des Künstlers ist ein beliebtes Motiv vieler Graffiti-Künstler, die \"Lettering\" betreiben."
    ],
    "en": [
      "The fresco on one of the facades of the Ecole Municipale Louise Michel was created by Drôme artist Fokus. The artist's abécédaire is one of the partiques favored by many Graffiti Artists practicing \"Lettering\"."
    ],
    "it": [
      "L'affresco su una delle facciate della scuola comunale Louise Michel è stato realizzato dall'artista della Drôme Fokus. L'alfabeto dell'artista è uno dei luoghi più frequentati da molti graffitari che praticano il lettering."
    ],
    "fr": [
      "La fresque située sur une des façades de l’Ecole Municipale Louise Michel a été réalisée par l’artiste Drômois Fokus. L’abécédaire réalisé par l’artiste est une des partiques prisés par de nombreux Graffiti Artiste pratiquant le « Lettering »."
    ],
    "nl": [
      "Het fresco op een van de gevels van de gemeenteschool Louise Michel is gemaakt door de Drôme-kunstenaar Fokus. Het alfabet van de kunstenaar is favoriet bij veel graffitikunstenaars die aan belettering doen."
    ],
    "es": [
      "El fresco de una de las fachadas de la escuela municipal Louise Michel es obra del artista de Drôme Fokus. El alfabeto del artista es uno de los lugares más frecuentados por muchos grafiteros que practican el lettering."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Street art de Fokus - Wall & love"
    ]
  },
