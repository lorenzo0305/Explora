  "rdfs:comment": {
    "de": [
      "Die Hostellerie du Lac genießt eine außergewöhnliche Lage am Genfersee im Herzen der Alpen. Das Hotel verfügt über 2 Speisesäle und eine herrliche Terrasse an den Stränden des Genfersees."
    ],
    "en": [
      "L'Hostellerie du Lac boasts an exceptional location on Lake Geneva in the heart of the Alps. The establishment features 2 dining rooms with two atmospheres, and a superb terrace overlooking the beaches of Lake Geneva."
    ],
    "it": [
      "L'Hostellerie du Lac gode di una posizione eccezionale sul Lago di Ginevra, nel cuore delle Alpi. Questa struttura dispone di 2 sale ristorante con due atmosfere e di una splendida terrazza con vista sulle spiagge del Lago di Ginevra."
    ],
    "fr": [
      "L’Hostellerie du Lac, bénéficie d’une situation exceptionnelle, sur le Lac Léman au cœur des Alpes. Cet établissement est composé de 2 salles de restaurant avec deux ambiances et d'une superbe terrasse sur les plages du Léman."
    ],
    "es": [
      "La Hostellerie du Lac goza de una ubicación excepcional a orillas del lago Lemán, en el corazón de los Alpes. Este establecimiento dispone de 2 salas de restaurante con dos ambientes y una magnífica terraza con vistas a las playas del lago Lemán."
    ],
    "nl": [
      "L'Hostellerie du Lac heeft een uitzonderlijke locatie aan het Meer van Genève in het hart van de Alpen. Dit etablissement heeft 2 restaurantzalen met twee sferen en een prachtig terras met uitzicht op de stranden van het Meer van Genève."
    ]
  },
