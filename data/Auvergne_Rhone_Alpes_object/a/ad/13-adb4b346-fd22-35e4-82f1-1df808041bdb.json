  "rdfs:comment": {
    "de": [
      "Der Verein wurde am 10.09.1968 gegründet, um das Dach der Eglise de la Viale in Bourdeaux zu restaurieren. Sie öffnet dieses Gebäude jeden Sommer und bietet verschiedene Ausstellungen an. Auch lokale Künstler beteiligen sich am Leben der Kirche."
    ],
    "en": [
      "The association was founded on 10/09/1968 to restore the roof of the church in the Viale de Bourdeaux. It opens the building every summer, offering a variety of exhibitions. Local artists also take part in the life of the church."
    ],
    "it": [
      "L'associazione è stata creata il 10/09/1968 per il restauro del tetto della Chiesa del Viale di Bourdeaux. Ogni estate apre questo edificio e propone varie mostre. Anche gli artisti locali partecipano alla vita della chiesa."
    ],
    "fr": [
      "L'association a été crée le 10/09/1968 pour la restauration de la toiture de l'Eglise de la Viale de Bourdeaux. Elle ouvre cet édifice tous les étés et propose différentes expositions. Les artistes locaux participent aussi à la vie de l'église."
    ],
    "es": [
      "La asociación se creó el 10/09/1968 para la restauración del tejado de la iglesia del Viale de Bourdeaux. Abre este edificio cada verano y propone diversas exposiciones. Los artistas locales también participan en la vida de la iglesia."
    ],
    "nl": [
      "De vereniging werd opgericht op 10/09/1968 om het dak van de Viale de Bourdeaux kerk te restaureren. Elke zomer stelt de vereniging dit gebouw open en worden er verschillende tentoonstellingen georganiseerd. Lokale kunstenaars nemen ook deel aan het leven van de kerk."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Association Les Amis du Pays de Bourdeaux"
    ]
  },
