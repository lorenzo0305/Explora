  "rdfs:comment": {
    "de": [
      "Vom Bauernhof auf den Teller\r\nEine saisonale, lokale und zu 100 % hausgemachte Küche in Megève. Das Restaurant arbeitet mit sehr lokalen Produzenten und Lieferanten zusammen, um authentische, frische und leckere Gerichte in einer herzlichen Atmosphäre anzubieten."
    ],
    "en": [
      "From farm to table\r\nSeasonal, local, and 100% homemade cuisine in Megève. The restaurant works with local producers and suppliers to offer authentic, fresh, and gourmet dishes in a warm atmosphere."
    ],
    "it": [
      "Dalla fattoria al piatto\r\nUna cucina stagionale, locale e 100% fatta in casa a Megève. Il ristorante lavora con produttori e fornitori locali per offrire piatti autentici, freschi e gustosi, in un'atmosfera accogliente."
    ],
    "fr": [
      "De la ferme à l’assiette\r\nUne cuisine de saison, locale et 100 % faite maison à Megève. Le restaurant travaille avec des producteurs et fournisseurs très locaux pour proposer des plats authentiques, frais et gourmands, dans une ambiance chaleureuse."
    ],
    "nl": [
      "Van boerderij tot bord\r\nSeizoensgebonden, lokale en 100% huisgemaakte keuken in Megève. Het restaurant werkt samen met zeer lokale producenten en leveranciers om authentieke, verse en smakelijke gerechten aan te bieden in een warme sfeer."
    ],
    "es": [
      "De la granja al plato\r\nCocina de temporada, local y 100% casera en Megève. El restaurante trabaja con productores y proveedores muy locales para ofrecer platos auténticos, frescos y sabrosos en un ambiente cálido."
    ]
  },
  "rdfs:label": {
