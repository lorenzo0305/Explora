  "rdfs:comment": {
    "de": [
      "Bistronomisches Restaurant im Herzen von Champeix. Eine Küche aus Liebe und Leidenschaft, in der wir versuchen, einfache Produkte zu verschönern und Sie neue Geschmacksrichtungen entdecken zu lassen!"
    ],
    "en": [
      "Bistronomic restaurant in the heart of Champeix. A cuisine of love and passion, where we seek to embellish simple products, and help you discover new flavors!"
    ],
    "it": [
      "Ristorante bistronomico nel cuore di Champeix. Una cucina d'amore e di passione, dove cerchiamo di abbellire prodotti semplici e di farvi scoprire nuovi sapori!"
    ],
    "fr": [
      "Restaurant bistronomique au cœur de Champeix. Une cuisine d’amour et de passion où nous cherchons à embellir les produits simples, et vous faire découvrir de nouvelles saveurs !"
    ],
    "es": [
      "Restaurante bistronómico en el corazón de Champeix. ¡Una cocina de amor y pasión, donde buscamos embellecer productos sencillos y ayudarle a descubrir nuevos sabores!"
    ],
    "nl": [
      "Bistronomisch restaurant in het hart van Champeix. Een keuken vol liefde en passie, waar we eenvoudige producten proberen te verfraaien en je nieuwe smaken laten ontdekken!"
    ]
  },
  "rdfs:label": {
