  "rdfs:comment": {
    "de": [
      "Gourmetrestaurant, 1 Stern im Guide Michelin sowie der Sonderpreis \"Passion Dessert\". Unsere Menüs sind überraschend, omnivor und nach dem Vertrauen des Küchenchefs in 5 oder 7 Schritten."
    ],
    "en": [
      "Gastronomic restaurant, 1 star in the Michelin Guide, as well as the special \"Passion Dessert\" award. Our menus are surprise, omnivorous and at the chef's discretion, in 5 or 7 stages."
    ],
    "it": [
      "Ristorante gastronomico, 1 stella nella Guida Michelin, nonché il premio speciale \"Passion Dessert\". I nostri menu sono a sorpresa, onnivori e a discrezione dello chef, in 5 o 7 tappe."
    ],
    "fr": [
      "Restaurant gastronomique, 1 étoile au Guide Michelin, ainsi que le prix spécial « Passion Dessert ». Nos menus sont surprises, omnivores et à la confiance du chef, en 5 ou 7 étapes."
    ],
    "es": [
      "Restaurante gastronómico, 1 estrella en la Guía Michelin, así como el premio especial \"Postre Pasión\". Nuestros menús son sorpresa, omnívoros y a discreción del chef, en 5 o 7 tiempos."
    ],
    "nl": [
      "Gastronomisch restaurant, 1 ster in de Michelin-gids, evenals de speciale onderscheiding \"Passion Dessert\". Onze menu's zijn verrassend, omnivoor en naar keuze van de chef, in 5 of 7 etappes."
    ]
  },
