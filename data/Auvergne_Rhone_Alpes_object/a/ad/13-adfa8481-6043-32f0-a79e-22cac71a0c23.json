  "rdfs:comment": {
    "de": [
      "Anne-Sophie und Etienne öffnen Ihnen die Türen ihrer handwerklichen Brauerei. Kostenlose Besichtigungen auf Anfrage und je nach Verfügbarkeit für Gruppen ab 10 Personen."
    ],
    "en": [
      "Anne-Sophie and Etienne open the doors of their craft brewery, free visits on request and according to availability for groups of more than 10 people."
    ],
    "it": [
      "Anne-Sophie ed Etienne aprono le porte del loro birrificio artigianale, visite gratuite su richiesta e secondo disponibilità per gruppi di oltre 10 persone."
    ],
    "fr": [
      "Anne-Sophie et Etienne vous ouvrent les portes de leur brasserie artisanale, visites gratuites sur demande et selon disponibilités pour groupes supérieurs à 10 personnes."
    ],
    "es": [
      "Anne-Sophie y Etienne abren las puertas de su cervecería artesanal, visitas gratuitas bajo petición y según disponibilidad para grupos de más de 10 personas."
    ],
    "nl": [
      "Anne-Sophie en Etienne openen de deuren van hun ambachtelijke brouwerij, gratis bezoek op aanvraag en volgens beschikbaarheid voor groepen van meer dan 10 personen."
    ]
  },
