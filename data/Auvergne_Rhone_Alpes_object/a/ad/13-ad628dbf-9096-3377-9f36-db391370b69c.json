  "rdfs:comment": {
    "de": [
      "Loqua ist ein Konzept, das eine bessere Ernährung im Schnellrestaurant ermöglicht. Entdecken Sie Rezepte für Bowls und Croque Monsieur, die jeden Morgen mit frischen und lokalen Produkten hergestellt werden."
    ],
    "en": [
      "Loqua is a concept that allows you to eat better in fast food restaurants. Discover recipes for bowls and croque monsieur made every morning with fresh, local produce."
    ],
    "it": [
      "Loqua è un concetto che permette di mangiare meglio nei fast food. Scoprite le ricette di ciotole e croque monsieur preparate ogni mattina con prodotti freschi e locali."
    ],
    "fr": [
      "Loqua est un concept qui permet de mieux manger en restauration rapide. Découvrez des recettes de bowls et de croque monsieur confectionnés chaque matin avec des produits frais et locaux."
    ],
    "nl": [
      "Loqua is een concept waarmee je beter kunt eten in fastfoodrestaurants. Ontdek recepten voor bowls en croque monsieur die elke ochtend worden gemaakt met verse, lokale producten."
    ],
    "es": [
      "Loqua es un concepto que permite comer mejor en los restaurantes de comida rápida. Descubre recetas de bowls y croque monsieur elaboradas cada mañana con productos frescos y locales."
    ]
  },
