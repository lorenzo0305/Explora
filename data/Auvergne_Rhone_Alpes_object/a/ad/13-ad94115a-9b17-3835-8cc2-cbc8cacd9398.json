  "rdfs:comment": {
    "de": [
      "Hot Dog Gourmet\r\nGourmand, mythisch & köstlich.\r\nSie haben ihn auf einer Reise nach New York oder am Rande eines Fußballfeldes genossen? Der Hot Dog, ein unumgängliches Symbol des Street Food, feiert sein großes Comeback mit einem Hauch von Handwerk und Gourmet."
    ],
    "en": [
      "Hot Dog Gourmet\r\nGourmet, mythical & delicious.\r\nDid you enjoy it on a trip to New York or on the soccer field? An essential street food icon, the hot dog is making a comeback with an artisanal, gourmet twist."
    ],
    "it": [
      "Hot Dog Gourmet\r\nGourmet, leggendario e delizioso.\r\nL'avete gustato durante un viaggio a New York o al campo di calcio? L'hot dog, simbolo essenziale dello street food, sta tornando in auge con un tocco artigianale e gourmet."
    ],
    "fr": [
      "Hot Dog Gourmet\r\nGourmand, mythique & délicieux.\r\nVous l’avez savouré lors d’un voyage à New York ou au bord d’un terrain de football ? Symbole incontournable de la street food, le hot dog fait son grand retour avec une touche  artisanale et gourmande."
    ],
    "es": [
      "Perro caliente Gourmet\r\nGourmet, legendario y delicioso.\r\n¿Lo disfrutó en un viaje a Nueva York o en el campo de fútbol? El perrito caliente, símbolo esencial de la comida callejera, reaparece con un toque artesanal y gourmet."
    ],
    "nl": [
      "Hotdog Gourmet\r\nGourmet, legendarisch en heerlijk.\r\nHeb je ervan genoten tijdens een reis naar New York of op het voetbalveld? De hotdog, een essentieel symbool van streetfood, maakt een comeback met een ambachtelijke en gastronomische twist."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Fabrique du Hot-Dog"
    ]
  },
