  "rdfs:comment": {
    "de": [
      "Mein Restaurant ist ein Ort des Genusses und der Geselligkeit. Ich empfange Sie in einer warmen und gemütlichen Atmosphäre mit einer Gourmetküche \"ohne Chichi\", die sehr regelmäßig erneuert wird, um mehr Entdeckungen zu ermöglichen."
    ],
    "en": [
      "The restaurant is a place for enjoyment and conviality. We welcome you  to a warm and friendly atmosphere in a contemporary setting.\r\nFresh, gourmet cuisine on a regularly changing menu to discover new and tasty delights."
    ],
    "it": [
      "Il mio ristorante è un luogo di piacere e di convivialità. Vi accolgo in un'atmosfera calda e accogliente, intorno a una cucina gourmet \"senza fronzoli\" rinnovata molto regolarmente per ulteriori scoperte."
    ],
    "fr": [
      "Mon restaurant est un lieu de plaisir et de convivialité. Je vous accueille dans une ambiance chaleureuse et cosy, autour d’une cuisine gourmande \"sans chichi\" renouvelée très régulièrement pour plus de découvertes."
    ],
    "es": [
      "Mi restaurante es un lugar de placer y convivencia. Le acojo en un ambiente cálido y acogedor, en torno a una cocina gourmet \"sin aspavientos\" renovada muy regularmente para más descubrimientos."
    ],
    "nl": [
      "Het restaurant is een aangename plek van ontmoetingen en gezelligheid.  We ontvangen u in een warme sfeer en een moderne omgeving.\r\nVerse smakelijke gerechten die regelmatig aangepast worden voor nog meer\r\nverrassingen."
    ]
  },
  "rdfs:label": {
