  "rdfs:comment": {
    "de": [
      "\"Wenn Kommen Lust auf Wiederkommen macht\"\r\nGourmetküche \"hausgemacht\" mit einigen jurassischen Spezialitäten mit Gelbwein-Elixier. Berühren Sie den Himmel mit einer Gabel!"
    ],
    "en": [
      "\"When coming makes you want to come back \"\r\nHome-made gourmet cuisine with some Jura specialities with the elixir of Vin Jaune. Come and touch the sky with your fork!"
    ],
    "it": [
      "\"Quando venire ti fa venire voglia di tornare\r\nCucina gourmet casalinga con alcune specialità del Giura nell'elisir del Vin Jaune. Venite a toccare il cielo con la vostra forchetta!"
    ],
    "fr": [
      "« Quand venir donne envie de revenir »\r\nCuisine gourmande \" fait maison\" avec quelques spécialités jurassiennes à l’élixir de Vin Jaune. Venez toucher le ciel d'un coup de fourchette !"
    ],
    "es": [
      "\"Cuando venir te hace querer volver\r\nCocina gastronómica casera con algunas especialidades del Jura en el elixir del Vin Jaune. ¡Ven y toca el cielo con tu tenedor!"
    ],
    "nl": [
      "\"Als je komt, wil je terugkomen\r\nHuisgemaakte gastronomische keuken met enkele specialiteiten uit de Jura in het elixer Vin Jaune. Kom en raak de hemel aan met je vork!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant Piper Pub"
    ]
  },
