  "rdfs:comment": {
    "de": [
      "Genießen Sie unter dem Barockzelt des Cirque Imagine eine Dinnershow \"Cabaret-Cirque\" in einer zauberhaften und atypischen Welt! Ein einzigartiges und in Frankreich noch nie dagewesenes Konzept."
    ],
    "en": [
      "Under the Cirque Imagine's baroque-style big top\" enjoy a dinner-show in  a magical and unusual setting ! An unique and unpublished concept in France."
    ],
    "it": [
      "Sotto il tendone barocco del Cirque Imagine, godetevi una cena e uno spettacolo \"Cabaret-Cirque\", in un universo incantevole e atipico! Un concetto unico, mai visto prima in Francia."
    ],
    "fr": [
      "Sous le chapiteau baroque du Cirque Imagine, profitez d'un dîner-spectacle \"Cabaret-Cirque\", dans un univers enchanteur et atypique ! Un concept unique et inédit en France."
    ],
    "nl": [
      "Geniet onder de barokke big top van Cirque Imagine van een \"Cabaret-Cirque\" diner en show, in een betoverende en atypische wereld! Een uniek concept, nog nooit eerder vertoond in Frankrijk."
    ],
    "es": [
      "Bajo la carpa barroca del Cirque Imagine, disfrute de una cena-espectáculo \"Cabaret-Cirque\", ¡en un universo encantador y atípico! Un concepto único, nunca visto en Francia."
    ]
  },
