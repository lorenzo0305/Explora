  "rdfs:comment": {
    "de": [
      "Pädagogischer Bauernhof mit geführten Besichtigungen und Erzeugerladen. Verkauf von Honig und verwandten Produkten (Kerzen, Honigessig, Pollen...) Pendelbus oder kleiner Zug halten direkt vor dem Haus."
    ],
    "en": [
      "Educational farm with guided tour and producer store. Sale of honey and derived products (candle, honey vinegar, pollen, etc.)"
    ],
    "it": [
      "Fattoria didattica con visita guidata e bottega del produttore. Vendita di miele e prodotti correlati (candele, aceto di miele, polline, ecc.) Fermata del bus navetta o del trenino proprio di fronte."
    ],
    "fr": [
      "Ferme pédagogique avec visite guidée et magasin producteur. Vente de miel et produits dérivés (bougie, vinaigre de miel, pollen...) Arrêt navette ou petit train juste devant."
    ],
    "es": [
      "Granja educativa con visita guiada y tienda del productor. Venta de miel y productos relacionados (velas, vinagre de miel, polen, etc.) Parada de autobús lanzadera o trenecito justo enfrente."
    ],
    "nl": [
      "Educatieve boerderij met rondleiding en producentenwinkel. Verkoop van honing en afgeleide producten (kaars, honingazijn, pollen enz.)"
    ]
  },
