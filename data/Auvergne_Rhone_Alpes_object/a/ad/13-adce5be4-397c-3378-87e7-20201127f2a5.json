  "rdfs:comment": {
    "de": [
      "Kids Harmony - Sing For Peace\r\nEine Weltpremiere!\r\n\r\nZehntausende Jugendliche aus allen Kontinenten singen in ganz Frankreich für den Frieden. Eine starke Botschaft der Hoffnung, der Einheit und des Optimismus."
    ],
    "en": [
      "Kids Harmony - Sing For Peace\r\nA world first!\r\n\r\nTens of thousands of teenagers from every continent sing for peace all over France. A powerful message of hope, unity and optimism."
    ],
    "it": [
      "Armonia dei bambini - Cantare per la pace\r\nUna novità mondiale!\r\n\r\nDecine di migliaia di adolescenti di tutti i continenti cantano per la pace in tutta la Francia. Un potente messaggio di speranza, unità e ottimismo."
    ],
    "fr": [
      "Kids Harmony - Sing For Peace\r\nUne première au monde !\r\n\r\nDes dizaines de milliers d’adolescents de tous les continents chantent pour la paix partout en France. Un message puissant d’espoir, d’unité et d’optimisme."
    ],
    "nl": [
      "Kinderharmonie - Zing voor vrede\r\nEen wereldprimeur!\r\n\r\nTienduizenden tieners uit alle continenten zingen in heel Frankrijk voor de vrede. Een krachtige boodschap van hoop, eenheid en optimisme."
    ],
    "es": [
      "Kids Harmony - Canta por la paz\r\nUna primicia mundial\r\n\r\nDecenas de miles de adolescentes de todos los continentes cantan por la paz en toda Francia. Un poderoso mensaje de esperanza, unidad y optimismo."
    ]
  },
