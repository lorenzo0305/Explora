  "rdfs:comment": {
    "de": [
      "Die Brasserie du Palais befindet sich in einem alten Bauernhaus weniger als eine Stunde von Lyon entfernt in den Balcons du Dauphiné und stellt obergärige, weder gefilterte noch pasteurisierte Biere sowie eine hausgemachte Limonade her, die Ihre Geschmacksknospen in Wallung bringen werden."
    ],
    "en": [
      "Housed in an old farmhouse less than an hour from Lyon in the Balcons du Dauphiné, the Brasserie du Palais produces top-fermented beers that are neither filtered nor pasteurised, along with a handcrafted lemonade that’s sure to awaken your taste buds."
    ],
    "it": [
      "Ospitata in un'antica fattoria a meno di un'ora da Lione, nei Balcons du Dauphiné, la Brasserie du Palais produce birre ad alta fermentazione non filtrate né pastorizzate, oltre a una limonata artigianale che stuzzicherà il vostro palato."
    ],
    "fr": [
      "Installée dans un vieux corps de ferme à moins d'1h de Lyon aux Balcons du Dauphiné, la Brasserie du Palais produit des bières de fermentation haute ni filtrées ni pasteurisées ainsi qu'une limonade artisanale qui sauront mettre vos papilles en éveil."
    ],
    "es": [
      "Ubicada en una antigua granja a menos de una hora de Lyon, en los Balcons du Dauphiné, la Brasserie du Palais produce cervezas de alta fermentación, sin filtrar ni pasteurizar, así como una limonada artesanal que hará las delicias de su paladar."
    ],
    "nl": [
      "Brasserie du Palais, gevestigd in een oude boerderij op minder dan 1 uur van Lyon in de Balcons du Dauphiné, produceert bieren van hoge gisting die niet gefilterd of gepasteuriseerd worden, en een ambachtelijke limonade die je smaakpapillen zal prikkelen."
    ]
  },
  "rdfs:label": {
