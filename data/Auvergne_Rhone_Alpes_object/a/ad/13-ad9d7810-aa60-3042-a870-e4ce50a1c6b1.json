  "rdfs:comment": {
    "de": [
      "In einer blühenden Umgebung überragt dieses typische Beaujolais-Haus (300 Jahre Geschichte) das Dorf. Kommentierte Besichtigung der Weinberge und des Kellers nach Vereinbarung. Chiroubles, Brouilly, Beaujolais-Villages rot, rosé, weiß. Pétillant rosé."
    ],
    "en": [
      "This typical Beaujolais house, with its 300 years of history, overlooks the village in a floral setting. Guided visit of the vineyards and the cellar by appointment. Chiroubles, Brouilly, Beaujolais-Villages red, rosé, white. Sparkling rosé."
    ],
    "it": [
      "In un ambiente fiorito, questa tipica casa del Beaujolais (300 anni di storia) si affaccia sul villaggio. Visita guidata ai vigneti e alla cantina su prenotazione. Chiroubles, Brouilly, Beaujolais-Villages rosso, rosato, bianco. Rosé frizzante."
    ],
    "fr": [
      "Dans un cadre fleuri, cette maison typique beaujolaise (300ans d'histoire) surplombe le village. Visite commentée des vignes et de la cave sur rendez-vous. Chiroubles, Brouilly,  Beaujolais-Villages rouge, rosé, blanc. Pétillant rosé."
    ],
    "nl": [
      "In een bloemrijke omgeving kijkt dit typische Beaujolais-huis (300 jaar geschiedenis) uit over het dorp. Rondleiding door de wijngaarden en kelder op afspraak. Chiroubles, Brouilly, Beaujolais-Villages rood, rosé, wit. Mousserende rosé."
    ],
    "es": [
      "En un entorno florido, esta casa típica del Beaujolais (300 años de historia) domina el pueblo. Visita guiada a los viñedos y a la bodega con cita previa. Chiroubles, Brouilly, Beaujolais-Villages tinto, rosado, blanco. Rosado espumoso."
    ]
  },
