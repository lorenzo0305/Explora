  "rdfs:comment": {
    "de": [
      "Restaurant 1580m ist eine familiengeführte Räucherei, Brauerei und Café mit einem herrlichen Blick auf den Mont Pourri. Wir legen Wert auf hausgeräuchertes Fleisch und Gemüse, das perfekt zu unseren vor Ort gebrauten handwerklichen Bieren passt."
    ],
    "en": [
      "Restaurant 1580m is a family-owned smoke house, brewery and coffee shop with beautiful views across to Mont Pourri. We offer a variety of dishes with our focus on home smoked meats and vegetables that pair perfectly with our craft ales brewed in house"
    ],
    "it": [
      "Il ristorante 1580m è un affumicatoio, una brasserie e un caffè a conduzione familiare con una magnifica vista sul Mont Pourri. Ci concentriamo su carni e verdure affumicate in casa, che si abbinano perfettamente alle nostre birre artigianali prodotte in loco."
    ],
    "fr": [
      "Restaurant 1580m est un fumoir, brasserie et café familial offrant une vue magnifique sur le Mont Pourri. Nous mettons l'accent sur les viandes et les légumes fumés à la maison, qui s'accordent parfaitement avec nos bières artisanales brassées sur place."
    ],
    "nl": [
      "Restaurant 1580m is een door een familie gerunde rokerij, brasserie en café met een prachtig uitzicht op de Mont Pourri. We focussen op huisgerookt vlees en groenten, die perfect samengaan met onze ambachtelijke bieren die ter plaatse worden gebrouwen."
    ],
    "es": [
      "El restaurante 1580m es un ahumadero, brasserie y cafetería familiar con magníficas vistas al Mont Pourri. Nos centramos en carnes y verduras ahumadas en casa, que combinan a la perfección con nuestras cervezas artesanales elaboradas in situ."
    ]
  },
  "rdfs:label": {
    "en": [
      "Restaurant - coffee shop - Brew House 1580 m"
    ],
