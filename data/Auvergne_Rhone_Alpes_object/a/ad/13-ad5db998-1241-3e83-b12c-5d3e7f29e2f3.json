  "rdfs:comment": {
    "de": [
      "Das 4-Sterne-Hotel La Chaudanne öffnet Ihnen die Türen zum Skigebiet der 3 Vallées. Entdecken Sie am Fuße der Pisten die Zimmer und Suiten, die die charakteristische Wärme der Bergwelt mit schlichtem Luxus verbinden."
    ],
    "en": [
      "The 4-star Hôtel La Chaudanne opens the doors to the 3 Vallées ski area. At the foot of the slopes, discover the rooms and suites that combine the soft warmth of a mountain atmosphere with pure luxury."
    ],
    "it": [
      "L'Hôtel La Chaudanne, 4 stelle, apre le porte del comprensorio sciistico delle 3 Vallées. Ai piedi delle piste, scoprite le camere e le suite che combinano il morbido calore dell'atmosfera di montagna con il puro lusso."
    ],
    "fr": [
      "L’Hôtel La Chaudanne, 4 étoiles, vous ouvre les portes du domaine skiable des 3 Vallées. Au pied des pistes, découvrez les Chambres et suites qui conjuguent à merveille la douce chaleur caractéristique des ambiances de montagne à un luxe épuré."
    ],
    "nl": [
      "Het 4-sterren Hôtel La Chaudanne opent de deuren naar het skigebied van de 3 Vallées. Ontdek aan de voet van de pistes de kamers en suites die de zachte warmte van een bergsfeer combineren met pure luxe."
    ],
    "es": [
      "El Hôtel La Chaudanne, de 4 estrellas, le abre las puertas del dominio esquiable de los 3 Valles. A pie de pistas, descubra las habitaciones y suites que combinan la suave calidez de un ambiente de montaña con el puro lujo."
    ]
  },
