  "rdfs:comment": {
    "de": [
      "Das Team der Mediathek, das aus einer Fachkraft und zahlreichen Freiwilligen besteht, empfängt Sie das ganze Jahr über, um Bücher auszuleihen, einfach nur zum Lesen vorbeizukommen oder von den zahlreichen Animationen zu profitieren."
    ],
    "en": [
      "The team of the Media Library, composed of a professional and many volunteers, welcomes you throughout the year, to borrow books, simply come to spend a little time reading or enjoy many animations."
    ],
    "it": [
      "L'équipe della Mediateca, composta da un professionista e da numerosi volontari, vi accoglie durante tutto l'anno per prendere in prestito i libri, venire semplicemente a passare un po' di tempo a leggere o approfittare delle numerose attività."
    ],
    "fr": [
      "L'équipe de la Médiathèque, composée d'un(e) professionnel(le) et de nombreux bénévoles, vous accueille tout au long de l'année, pour emprunter des ouvrages, venir simplement passer un petit moment de lecture ou profiter de nombreuses animations."
    ],
    "nl": [
      "Het team van de mediatheek, bestaande uit een professional en talrijke vrijwilligers, verwelkomt u het hele jaar door om boeken te lenen, gewoon wat te komen lezen of gebruik te maken van de vele activiteiten."
    ],
    "es": [
      "El equipo de la Mediateca, formado por un profesional y numerosos voluntarios, le da la bienvenida durante todo el año para pedir libros en préstamo, simplemente venir a pasar un rato leyendo o aprovechar las numerosas actividades."
    ]
  },
