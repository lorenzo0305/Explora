  "rdfs:comment": {
    "de": [
      "Les Terrasses de Renage bietet Ihnen eine traditionelle Küche in einem modernen und gemütlichen Ambiente. Die Ruhe des Ortes und seine große Kapazität machen ihn zu einem idealen Rahmen für Seminare, Geburtstage und Bankette..."
    ],
    "en": [
      "This restaurant offers a traditional French cuisine in modern and warm surroundings. The quiet setting as well as the large size of this restaurant makes it an ideal venue for seminars, weddings, family reunions, etc."
    ],
    "it": [
      "Les Terrasses de Renage offre una cucina tradizionale in un'atmosfera calda e moderna. La tranquillità del locale e la sua ampia capienza lo rendono ideale per seminari, compleanni, banchetti, ecc."
    ],
    "fr": [
      "Les Terrasses de Renage vous propose une cuisine traditionnelle, dans une ambiance moderne et chaleureuse. La tranquillité du lieu et sa capacité importante en font un cadre idéal pour organiser séminaires,anniversaires banquets..."
    ],
    "es": [
      "Les Terrasses de Renage ofrece cocina tradicional en un ambiente cálido y moderno. La tranquilidad del lugar y su gran capacidad lo hacen ideal para seminarios, cumpleaños, banquetes, etc."
    ],
    "nl": [
      "Les Terrasses de Renage biedt een traditionele keuken in een warme, moderne sfeer. De rust van de locatie en de grote capaciteit maken het ideaal voor seminars, verjaardagen, banketten, enz."
    ]
  },
