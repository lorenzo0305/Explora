  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Wunder der Natur in der Süd-Ardèche mit \"Parlons Plantes - Botanique Populaire\". Botanische Exkursionen, die für alle zugänglich sind und bei denen Sie lernen, wilde Pflanzen nachhaltig und einfach mit einer einzigartigen Methode zu erkennen."
    ],
    "en": [
      "Discover the wonders of nature in Southern Ardèche with \"Parlons Plantes - Botanique Populaire\". Botanical outings accessible to all, to learn how to recognize wild plants simply and sustainably, thanks to a unique method."
    ],
    "it": [
      "Scoprite le meraviglie della natura nell'Ardèche meridionale con \"Parlons Plantes - Botanique Populaire\". Escursioni botaniche accessibili a tutti, dove potrete imparare a riconoscere le piante selvatiche in modo semplice e sostenibile, utilizzando un metodo unico."
    ],
    "fr": [
      "Découvrez les merveilles de la nature en Sud Ardèche avec \"Parlons Plantes - Botanique Populaire\". Sorties botaniques accessibles à tous pour apprendre à reconnaître durablement et simplement les plantes sauvages grâce à une méthode unique."
    ],
    "nl": [
      "Ontdek de wonderen van de natuur in de zuidelijke Ardèche met \"Parlons Plantes - Botanique Populaire\". Botanische uitstapjes toegankelijk voor iedereen, waar je op een eenvoudige en duurzame manier wilde planten kunt leren herkennen volgens een unieke methode."
    ],
    "es": [
      "Descubra las maravillas de la naturaleza en el sur de Ardèche con \"Parlons Plantes - Botanique Populaire\". Salidas botánicas accesibles a todos, donde aprenderá a reconocer las plantas silvestres de forma sencilla y sostenible con un método único."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parlons Plantes - Botanique Populaire"
    ]
  },
