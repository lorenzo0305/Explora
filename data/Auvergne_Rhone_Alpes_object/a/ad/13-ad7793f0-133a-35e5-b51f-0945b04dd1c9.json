        {
          "@id": "https://data.datatourisme.fr/e726f587-453f-303e-ae9b-081fdc37fc34",
          "schema:validFrom": "2026-07-01T00:00:00",
          "schema:validThrough": "2026-08-31T23:59:59",
          "@type": [
