  "rdfs:comment": {
    "de": [
      "Das Schwimmbad Vallons du Lyonnais bietet mehrere Innenbereiche: ein 25 m langes Sportbecken, ein progressives Becken, ein Aktivitätsbecken mit beweglichem Boden, einen Sprungturm von 1 m und 3 m Höhe, eine Rutsche und eine Sauna."
    ],
    "en": [
      "2 x 25m pools, 30m slide, 5 m deep diving pool, diving boards, 2 paddling pools, saunas, lawns, picnic areas, barbecue, beach volley court, baby swimmers, aqua-gymnastics, synchronised swimming, scuba diving."
    ],
    "it": [
      "La piscina Vallons du Lyonnais dispone di diverse aree interne: una piscina sportiva di 25 metri, una piscina progressiva, una piscina per attività con pavimento mobile, un trampolino di 1 e 3 metri, uno scivolo e una sauna."
    ],
    "fr": [
      "La piscine des Vallons du Lyonnais propose plusieurs espaces intérieurs : un bassin sportif de 25m de long, un bassin progressif, un bassin d’activités au fond mobile, un plongeoir de 1m et 3m, un toboggan et un sauna."
    ],
    "es": [
      "La piscina Vallons du Lyonnais dispone de varias zonas cubiertas: una piscina deportiva de 25 m, una piscina progresiva, una piscina de actividades con fondo móvil, un trampolín de 1 y 3 m, un tobogán y una sauna."
    ],
    "nl": [
      "Het Vallons du Lyonnais zwembad heeft verschillende binnenruimtes: een 25m lang sportbad, een progressief zwembad, een activiteitenbad met een beweegbare bodem, een duikplank van 1m en 3m, een glijbaan en een sauna."
    ]
  },
  "rdfs:label": {
