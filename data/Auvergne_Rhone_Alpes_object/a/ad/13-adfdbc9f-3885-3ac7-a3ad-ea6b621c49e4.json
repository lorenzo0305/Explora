  "rdfs:comment": {
    "de": [
      "Le champ du moulin ist ein Bauernhof, der vollständig biologisch bewirtschaftet wird. Die Gemüsebauern bieten Ihnen Obst, Gemüse, Eier und Zubereitungen aus ihren Produkten an."
    ],
    "en": [
      "Le champ du moulin is a farm entirely in organic farming. The market gardeners propose you fruits, vegetables, eggs and preparations elaborated from their products."
    ],
    "it": [
      "Le champ du moulin è una fattoria biologica. Gli ortolani vi offrono frutta, verdura, uova e preparazioni a base dei loro prodotti."
    ],
    "fr": [
      "Le champ du moulin est une ferme entièrement en agriculture biologique. Les maraichers vous proposent des fruits, des légumes ,des œufs et des préparations élaborées à partir de leurs produits."
    ],
    "nl": [
      "Le champ du moulin is een biologische boerderij. De tuinders bieden fruit, groenten, eieren en bereidingen van hun producten aan."
    ],
    "es": [
      "Le champ du moulin es una granja ecológica. Los hortelanos le ofrecen frutas, verduras, huevos y preparaciones hechas con sus productos."
    ]
  },
  "rdfs:label": {
