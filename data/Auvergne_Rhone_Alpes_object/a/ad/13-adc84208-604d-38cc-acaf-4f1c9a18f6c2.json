  "rdfs:comment": {
    "de": [
      "Flaine hebt sich von anderen Bergorten durch seine starke Präsenz von Kunst ab. Das Kunstzentrum beteiligt sich seit 1970 an der Verbreitung zeitgenössischer Kunst, indem es Ausstellungen und Workshops veranstaltet."
    ],
    "en": [
      "What sets Flaine apart from other mountain resorts is the strong presence of art. Since 1970, the art centre has been helping to promote contemporary art by hosting exhibitions and workshops."
    ],
    "it": [
      "Flaine si distingue dalle altre località di montagna per la sua forte presenza artistica. Dal 1970, il centro d'arte contribuisce a promuovere l'arte contemporanea ospitando mostre e laboratori."
    ],
    "fr": [
      "Flaine se démarque des autres stations de montagne de par la forte présence d’art. Le centre d’art participe depuis 1970 à la diffusion d’art contemporain en accueillant des expositions et des workshops."
    ],
    "nl": [
      "Wat Flaine onderscheidt van andere bergresorts is de sterke aanwezigheid van kunst. Sinds 1970 helpt het kunstcentrum bij het promoten van hedendaagse kunst door tentoonstellingen en workshops te organiseren."
    ],
    "es": [
      "Flaine se distingue de otras estaciones de montaña por su fuerte presencia del arte. Desde 1970, el centro de arte contribuye a promover el arte contemporáneo acogiendo exposiciones y talleres."
    ]
  },
