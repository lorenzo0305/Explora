  "rdfs:comment": {
    "de": [
      "Die Mediathek der Gemeinde Fontanil-Cornillon ist ein Ort für Veranstaltungen und\r\ndes kulturellen Austauschs. Sie ermöglicht den Zugang zu Wissen für alle und bietet dafür den Zugang zu verschiedenen Medien: Bücher, Zeitschriften, CDs, CD-ROMs, Internet..."
    ],
    "en": [
      "The municipal media library of Fontanil-Cornillon is a place of animations and\r\nof cultural exchanges. It provides access to knowledge for all and, to this end, offers access to various media: books, magazines, compact discs, CD-ROMs, the Internet..."
    ],
    "it": [
      "La mediateca comunale di Fontanil-Cornillon è uno spazio per eventi culturali e\r\nscambi culturali. Fornisce l'accesso alla conoscenza per tutti e offre l'accesso a vari supporti: libri, riviste, CD, CD-ROM, Internet, ecc."
    ],
    "fr": [
      "La médiathèque municipale de Fontanil-Cornillon est un lieu d’animations et \r\nd’échanges culturels. Elle permet l’accès à la connaissance pour tous et, pour cela, offre l’accès à divers supports : livres, revues, disques compacts, cédéroms, internet..."
    ],
    "es": [
      "La mediateca municipal de Fontanil-Cornillón es un lugar para eventos culturales y\r\nintercambios culturales. Proporciona acceso al conocimiento para todos y ofrece acceso a diversos medios: libros, revistas, CD, CD-ROM, Internet, etc."
    ],
    "nl": [
      "De gemeentelijke mediatheek van Fontanil-Cornillon is een plaats voor culturele evenementen en\r\nculturele uitwisselingen. Het biedt toegang tot kennis voor iedereen en biedt toegang tot verschillende media: boeken, tijdschriften, cd's, cd-roms, internet..."
    ]
  },
