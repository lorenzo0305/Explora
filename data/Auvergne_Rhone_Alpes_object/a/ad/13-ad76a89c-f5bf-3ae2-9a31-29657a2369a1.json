  "rdfs:comment": {
    "de": [
      "Die Mühle Bernatot ist seit vier Generationen im Herzen des Departements Allier ansässig. Sie bietet Mehle an, die aus sorgfältig ausgewählten Getreidesorten aus der Limagne Bourbonnaise hergestellt werden und garantiert somit 100% lokale Produkte!"
    ],
    "en": [
      "Minoterie Bernatot has been established in the heart of the Allier region for 4 generations. Its flours are made from carefully selected cereals grown in the Limagne bourbonnaise region, guaranteeing 100% local products!"
    ],
    "it": [
      "La Minoterie Bernatot è presente nel cuore della regione di Allier da 4 generazioni. Le sue farine sono prodotte con cereali accuratamente selezionati coltivati nella regione Limagne di Bourbonnais, garantendo il 100% di prodotti locali!"
    ],
    "fr": [
      "La Minoterie Bernatot est implantée au cœur de l’Allier depuis 4 générations. Elle propose des farines élaborées à partir de céréales sélectionnées avec soin, dans la limagne bourbonnaise, garantissant ainsi des produits 100% locaux !"
    ],
    "nl": [
      "Minoterie Bernatot is al 4 generaties lang gevestigd in het hart van de Allier. Het meel wordt gemaakt van zorgvuldig geselecteerde granen uit de Limagne in Bourbonnais, waardoor 100% lokale producten gegarandeerd zijn!"
    ],
    "es": [
      "La Minoterie Bernatot lleva 4 generaciones establecida en el corazón de la región de Allier. Sus harinas se elaboran a partir de cereales cuidadosamente seleccionados cultivados en la región de Limagne de Bourbonnais, ¡lo que garantiza productos 100% locales!"
    ]
  },
  "rdfs:label": {
