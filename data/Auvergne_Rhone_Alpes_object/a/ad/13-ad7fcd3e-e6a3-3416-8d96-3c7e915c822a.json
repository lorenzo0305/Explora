  "rdfs:comment": {
    "de": [
      "Das vollständig renovierte Restaurant \"Les Quatre Saisons\" bietet traditionelle und saisonale Küche, die wir aus frischen Produkten\r\nzubereiten. Bar, Sommerterrasse, Patio (innen) von Mai bis September."
    ],
    "en": [
      "The restaurant ‘Les 4 saisons’, in an elegant and modern setting, offers tasty cuisine combining tradition and modernity, prepared with passion by its chef Pascal Perigaud."
    ],
    "it": [
      "Il ristorante \"Les 4 saisons\", in un ambiente elegante e moderno, offre una cucina gustosa che unisce tradizione e modernità, preparata con passione dallo chef Pascal Perigaud."
    ],
    "fr": [
      "Le restaurant \"Les 4 saisons\", dans un cadre élégant et moderne, vous propose une cuisine savoureuse mêlant tradition et modernité, élaboré avec passion par son chef Pascal Perigaud."
    ],
    "nl": [
      "Het restaurant \"Les 4 saisons\", in een elegante en moderne omgeving, biedt smakelijke gerechten die traditie en moderniteit combineren, met passie bereid door chef-kok Pascal Perigaud."
    ],
    "es": [
      "El restaurante \"Les 4 saisons\", en un marco elegante y moderno, ofrece una sabrosa cocina que combina tradición y modernidad, preparada con pasión por su chef Pascal Perigaud."
    ]
  },
