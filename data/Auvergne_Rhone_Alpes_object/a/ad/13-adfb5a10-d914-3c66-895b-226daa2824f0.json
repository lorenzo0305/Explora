  "rdfs:comment": {
    "de": [
      "Kunstatelier in der ehemaligen Halle du Crozet. Sylvie Mommert, bildende Künstlerin, öffnet Ihnen ihr Atelier. Ausstellung von Bildern, Künstlerbüchern, naturalistisch inspirierten Atelierbüchern. Zeichen- und Pastellkurse für jedermann während der Ferien."
    ],
    "en": [
      "Art studio in the former Crozet hall. Sylvie Mommert, visual artist, opens her studio to you. Exhibition of paintings, artists' books and naturalist-inspired notebooks. Drawing and pastel classes for the general public during the vacations."
    ],
    "it": [
      "Atelier d'arte nella vecchia sala del mercato di Crozet. Sylvie Mommert, artista visiva, apre il suo studio. Mostra di dipinti, libri d'artista e taccuini di ispirazione naturalista. Corsi di disegno e pastello per il pubblico durante le vacanze."
    ],
    "fr": [
      "Atelier d'art de l'ancienne Halle du Crozet. Sylvie Mommert, artiste plasticienne, vous ouvre son atelier. Exposition de tableaux, livres d'artistes, carnets d'atelier d'inspiration naturaliste. Cours de dessin et pastel tout public pendant les vacances."
    ],
    "nl": [
      "Kunstatelier in de oude markthal van Crozet. Sylvie Mommert, beeldend kunstenaar, stelt haar atelier voor je open. Tentoonstelling van schilderijen, kunstenaarsboeken en op naturalisten geïnspireerde notitieboeken. Teken- en pastellessen voor het grote publiek tijdens de vakantie."
    ],
    "es": [
      "Estudio de arte en el antiguo mercado de Crozet. Sylvie Mommert, artista plástica, le abre su estudio. Exposición de cuadros, libros de artista y cuadernos de inspiración naturalista. Clases de dibujo y pastel para el público en general durante las vacaciones."
    ]
  },
