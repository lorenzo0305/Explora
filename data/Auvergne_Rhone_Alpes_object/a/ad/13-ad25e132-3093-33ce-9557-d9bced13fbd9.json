  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Einrichtung Ô Pervenches in Chambéry! Bukolisches Restaurant, Unterkunft, schattige Terrasse, Empfang von Gruppen, traditionelle französische Küche."
    ],
    "en": [
      "In a green setting only 1 km from Chambéry town centre, get away from it all with your loved one, your family, your friends or on business, and enjoy our fine gourmet meals blending traditional recipes and modern techniques."
    ],
    "it": [
      "Scoprite Ô Pervenches a Chambéry! Ristorante bucolico, alloggio, terrazza ombreggiata, accoglienza gruppi, cucina tradizionale francese."
    ],
    "fr": [
      "Découvrez l'établissement Ô Pervenches à Chambéry ! Restaurant bucolique, hébergement, terrasse ombragée, accueil groupes, cuisine traditionnelle française."
    ],
    "es": [
      "¡Descubra Ô Pervenches en Chambéry! Restaurante bucólico, alojamiento, terraza a la sombra, acogida de grupos, cocina tradicional francesa."
    ],
    "nl": [
      "Ontdek Ô Pervenches in Chambéry! Bucolisch restaurant, accommodatie, schaduwrijk terras, groepen welkom, traditionele Franse keuken."
    ]
  },
