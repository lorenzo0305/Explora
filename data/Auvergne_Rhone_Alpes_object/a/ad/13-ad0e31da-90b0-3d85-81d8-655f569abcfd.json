  "rdfs:comment": {
    "de": [
      "Trauen Sie sich, den Pumptrack von Aussois zu entdecken? Eine echte Piste für Mountainbikes, BMX und alle Arten von nicht motorisierten Fahrzeugen. 2 ineinander übergehende Schleifen und Gleitfläche."
    ],
    "en": [
      "Composed of moguls and banked turns, this area is designed for all types of wheeled machines (non-motorised). 2 interlocking loops (green and blue) and a sliding area (Vulcano and Copings) allow for a wide variety of transitions."
    ],
    "it": [
      "Composta da gobbe e curve a gomito, quest'area è progettata per tutti i tipi di macchine su ruote (non motorizzate). 2 loop ad incastro (verde e blu) e un'area di scivolamento (Vulcano e Copings) consentono un'ampia varietà di transizioni."
    ],
    "fr": [
      "Oserez-vous découvrir la pump track d'Aussois ? Véritable piste pour VTT, BMX et tous types d'engins non motorisés. 2 boucles imbriquées et espace de glisse."
    ],
    "es": [
      "¿Atrévete a descubrir la pista de pump track de Aussois? Una auténtica pista para bicicletas de montaña, BMX y todo tipo de máquinas sin motor. 2 bucles entrelazados y zona de deslizamiento."
    ],
    "nl": [
      "Dit gebied bestaat uit moguls en schuine bochten en is ontworpen voor alle soorten machines op wielen (zonder motor). 2 in elkaar grijpende lussen (groen en blauw) en een glijbaan (Vulcano en Copings) maken een grote verscheidenheid aan overgangen mogelijk."
    ]
  },
