  "rdfs:comment": {
    "de": [
      "Das Astronomische Observatorium Trièves befindet sich in Gresse en Vercors, in der Nähe der Dolomiten. Es verfügt über ein digitales Planetarium, mehrere Teleskope und einen Ausstellungsraum. Der Verein Astrieves verwaltet es und bietet Besichtigungen an."
    ],
    "en": [
      "The Trièves Astronomical Observatory is located in Gresse en Vercors, near the Dolomites. It features a digital planetarium, several telescopes and an exhibition room. The Astrieves association runs the observatory and organizes tours."
    ],
    "it": [
      "L'osservatorio astronomico di Trièves si trova a Gresse en Vercors, vicino alle Dolomiti. Dispone di un planetario digitale, di diversi telescopi e di una sala espositiva. L'associazione Astrieves gestisce l'osservatorio e organizza le visite."
    ],
    "fr": [
      "L'observatoire astronomique du Trièves se situe à Gresse en Vercors, près des Dolomites. Il dispose d'un planétarium numériques, de plusieurs téléscope et d'une salle d'exposition. L'association Astrieves en assure la gestion et les visites."
    ],
    "nl": [
      "Het astronomisch observatorium van Trièves bevindt zich in Gresse en Vercors, vlakbij de Dolomieten. Het heeft een digitaal planetarium, verschillende telescopen en een tentoonstellingsruimte. De vereniging Astrieves beheert het observatorium en organiseert bezoeken."
    ],
    "es": [
      "El observatorio astronómico de Trièves está situado en Gresse en Vercors, cerca de los Dolomitas. Cuenta con un planetario digital, varios telescopios y una sala de exposiciones. La asociación Astrieves gestiona el observatorio y organiza las visitas."
    ]
  },
  "rdfs:label": {
    "en": [
      "Trièves Astronomy Observatory"
    ],
    "fr": [
      "Observatoire d'astronomie du Trièves"
    ]
  },
