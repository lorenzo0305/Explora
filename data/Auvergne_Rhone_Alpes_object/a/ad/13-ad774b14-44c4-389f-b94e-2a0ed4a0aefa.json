  "rdfs:comment": {
    "de": [
      "Höhlenforschung, Klettern, Canyoning, Mountainbiking, Fat Scooter, Klettersteig, Wandern, Bergsteigen, das ganze Jahr über mit Betreuung. Winterliche Schneeschuh-Aktivitäten."
    ],
    "en": [
      "Caving, climbing, canyoning, mountain biking, Fat Trott, via ferrata, hiking, mountaineering activities all year round. Winter snowshoeing activities."
    ],
    "it": [
      "Attività supervisionate tutto l'anno: ciaspolate invernali e sci alpinismo, mountain bike, Fat Trott, escursionismo, arrampicata, canyoning, via corda/ferrata, alpinismo, speleologia."
    ],
    "fr": [
      "Activités encadrées toute l'année : raquettes hivernales & ski de rando, VTTAE/VTT, Fat Trott, randonnées, escalade, canyoning, via corda/ferrata, alpinisme, , spéléo."
    ],
    "nl": [
      "Begeleide activiteiten het hele jaar door: sneeuwschoenwandelen en skitochten, mountainbiken, Fat Trott, wandelen, klimmen, canyoning, via corda/ferrata, bergbeklimmen, speleologie."
    ],
    "es": [
      "Actividades supervisadas todo el año: raquetas de nieve y esquí de travesía en invierno, bicicleta de montaña, Fat Trott, senderismo, escalada, barranquismo, vía corda/ferrata, alpinismo, espeleología."
    ]
  },
