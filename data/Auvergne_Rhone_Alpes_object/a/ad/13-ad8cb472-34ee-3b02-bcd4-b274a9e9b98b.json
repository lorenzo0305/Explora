  "rdfs:comment": {
    "de": [
      "In Cyr-les-Vignes gelegen, empfängt Sie der Bauernhof AnimÉcow für eine Zeit voller Emotionen und Entdeckungen.\r\n\r\nOb in Gruppen oder mit der ganzen Familie, wir begrüßen Sie zu Besichtigungen des Bauernhofs und zur Begegnung mit über 100 Tieren."
    ],
    "en": [
      "Located in Cyr-les-Vignes, the AnimÉcow farm welcomes you for a moment rich in emotion and discovery.\r\n\r\nGroups or families are welcome to visit the farm and meet over 100 animals."
    ],
    "it": [
      "Situata a Cyr-les-Vignes, la fattoria AnimÉcow vi accoglie per un momento ricco di emozioni e di scoperte.\r\n\r\nGruppi o famiglie possono visitare la fattoria e incontrare oltre 100 animali."
    ],
    "fr": [
      "Située à Cyr-les-Vignes, la ferme AnimÉcow vous accueille pour un moment riche en émotion et en découvertes.\r\n\r\nEn groupe ou en famille, nous vous accueillons pour des visites de la ferme et la rencontre avec plus de 100 animaux."
    ],
    "es": [
      "Situada en Cyr-les-Vignes, la granja AnimÉcow le da la bienvenida para un momento rico en emociones y descubrimientos.\r\n\r\nGrupos o familias pueden visitar la granja y conocer a más de 100 animales."
    ],
    "nl": [
      "De AnimÉcow boerderij, gelegen in Cyr-les-Vignes, verwelkomt je voor een moment rijk aan emotie en ontdekking.\r\n\r\nGroepen of gezinnen kunnen de boerderij bezoeken en meer dan 100 dieren ontmoeten."
    ]
  },
  "rdfs:label": {
    "de": [
      "Ferme d'animation Anim Ecow"
    ],
    "en": [
      "Ferme d'animation Anim Ecow"
    ],
    "fr": [
      "Ferme d'animation AnimÉcow"
    ]
  },
