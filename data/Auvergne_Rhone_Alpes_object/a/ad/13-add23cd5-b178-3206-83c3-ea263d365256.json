  "rdfs:comment": {
    "de": [
      "Der Zugang ist frei. Ein 3 Hektar großes Gelände, das ganz dem Radsport (Mountainbike, BMX, Dirt, Draisine) gewidmet ist, vom Anfänger bis zum Experten."
    ],
    "en": [
      "Free access. A 3-hectare complex entirely dedicated to cycling (MTB, BMX, Dirt, draisienne), from beginners to experts."
    ],
    "it": [
      "Accesso libero. Una struttura interamente dedicata al ciclismo (MTB, BMX, Dirt, draisienne) dal livello principiante a quello esperto su un complesso di 3 ettari."
    ],
    "fr": [
      "Accès libre. Un équipement entièrement dédié à la pratique cycliste (VTT, BMX, Dirt, draisienne) de l’initiation au niveau expert sur un complexe de 3 hectares."
    ],
    "nl": [
      "Gratis toegang. Een faciliteit die volledig gewijd is aan fietsen (MTB, BMX, Dirt, draisienne) van beginners tot gevorderden op een complex van 3 hectare."
    ],
    "es": [
      "Acceso gratuito. Una instalación enteramente dedicada al ciclismo (MTB, BMX, Dirt, draisienne) desde el nivel principiante hasta el experto en un complejo de 3 hectáreas."
    ]
