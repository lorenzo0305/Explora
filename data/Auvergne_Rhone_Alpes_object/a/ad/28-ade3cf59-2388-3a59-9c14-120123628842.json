  "rdfs:comment": {
    "de": [
      "Das wird Ihnen gefallen: die idyllische, grüne Umgebung am Wasser und die Küche mit frischen Zutaten. Ein schickes und zugleich gemütliches Restaurant!"
    ],
    "en": [
      "You'll love: the idyllic, verdant waterside setting and the cuisine based on fresh produce. A chic restaurant with a warm welcome!"
    ],
    "it": [
      "Vi piacerà l'ambiente idilliaco e verdeggiante in riva al mare e la cucina a base di prodotti freschi. Un ristorante chic con un'accoglienza calorosa!"
    ],
    "fr": [
      "Vous aimerez : le cadre idyllique et verdoyant au bord de l'eau et la cuisine à base de produits frais. Un restaurant chic et chaleureux à la fois !"
    ],
    "nl": [
      "U zult dol zijn op de idyllische, groene omgeving aan het water en de keuken op basis van verse producten. Een chic restaurant met een warm welkom!"
    ],
    "es": [
      "Le encantará su idílico y frondoso entorno junto al agua y su cocina basada en productos frescos. Un restaurante elegante y acogedor"
    ]
  },
