  "rdfs:comment": {
    "de": [
      "Verkauf und Verkostung von Wein und Wurstwaren auf dem Weingut, kulturelles Programm zum Thema Ökologie. Mitglied des Netzwerks France Passion. Verkauf auf dem Bauernhof jeden Freitag von 17 bis 19 Uhr."
    ],
    "en": [
      "On-site wine and charcuterie sales and tastings, cultural programs on ecology. Member of the France Passion network. Farm sales every Friday from 5pm to 7pm."
    ],
    "it": [
      "Vendita e degustazione di vini e salumi presso la proprietà, programma culturale sull'ecologia. Membro della rete France Passion. Vendita in fattoria ogni venerdì dalle 17.00 alle 19.00."
    ],
    "fr": [
      "Vente et dégustation de vins et charcuteries à la propriété, programmation culturelle sur l'écologie. Adhérent au réseau France Passion. Vente à la ferme tous les vendredis de 17h à 19h."
    ],
    "nl": [
      "Verkoop en proeverij van wijnen en vleeswaren op het landgoed, cultureel programma over ecologie. Lid van het France Passion netwerk. Boerderijverkoop elke vrijdag van 17.00 tot 19.00 uur."
    ],
    "es": [
      "Venta y degustación de vinos y charcutería en la propiedad, programa cultural sobre ecología. Miembro de la red France Passion. Venta en la granja todos los viernes de 17:00 a 19:00."
    ]
  },
