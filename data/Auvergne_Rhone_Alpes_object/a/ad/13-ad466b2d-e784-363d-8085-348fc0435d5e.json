  "rdfs:comment": {
    "de": [
      "Die Natur und der Frühling. Die Mediathek von Donzère bietet Ihnen einen Filmworkshop an. Genießen Sie einen kreativen Moment mit einer Filmvorführung und einem anschließenden Fresken-Workshop zum Thema Natur und Frühling."
    ],
    "en": [
      "Nature and Spring. The Médiathèque de Donzère offers you a Ciné-Atelier. Come and enjoy a creative moment with the screening of a film followed by a fresco workshop on the theme of Nature and Spring."
    ],
    "it": [
      "Natura e primavera. La biblioteca multimediale Donzère propone un laboratorio cinematografico. Venite a godervi un momento di creatività con la proiezione di un film seguito da un laboratorio di affresco sul tema Natura e primavera."
    ],
    "fr": [
      "La Nature et le Printemps. La Médiathèque de Donzère vous propose un Ciné-Atelier. Venez profiter d’un moment créatif avec la projection d’un film suivie d’un atelier fresque sur le thème de la Nature et du Printemps."
    ],
    "nl": [
      "Natuur en lente. De mediatheek van Donzère biedt een filmworkshop aan. Kom genieten van een creatief moment met de vertoning van een film gevolgd door een fresco workshop over het thema Natuur en Lente."
    ],
    "es": [
      "Naturaleza y primavera. La mediateca de Donzère propone un taller de cine. Venga a disfrutar de un momento creativo con la proyección de una película seguida de un taller al aire libre sobre el tema de la Naturaleza y la Primavera."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ciné-atelier"
    ]
  },
