  "rdfs:comment": {
    "de": [
      "Ein Rundweg (nicht markiert - GPX), um 4 der Pässe des Revermont-Massivs zu überqueren: Col des Angoulures, Col de la Rousse, Col de la Pérouse und Col de France. Als Bonus auf der Strecke gibt es außergewöhnliche Aussichtspunkte, Bergkämme und Berge."
    ],
    "en": [
      "A circuit (unmarked - GPX) over 4 of the passes in the Revermont massif: Col des Angoulures, Col de la Rousse, Col de la Pérouse and Col de France. As a bonus, the route offers exceptional views, crests and mountains."
    ],
    "it": [
      "Un percorso (non segnalato - GPX) su 4 dei passi del massiccio di Revermont: Col des Angoulures, Col de la Rousse, Col de la Pérouse e Col de France. Come bonus, il percorso offre panorami, creste e montagne eccezionali."
    ],
    "fr": [
      "Un circuit (non balisé - GPX) pour franchir 4 des cols du massif du Revermont : col des Angoulures, col de la Rousse, col de la Pérouse et le col de France. En prime sur le parcours des points de vue exceptionnels, des crêtes et des monts."
    ],
    "es": [
      "Recorrido (no señalizado - GPX) por 4 de los puertos del macizo de Revermont: Col des Angoulures, Col de la Rousse, Col de la Pérouse y Col de France. Como extra, la ruta ofrece vistas, crestas y montañas excepcionales."
    ],
    "nl": [
      "Een route (ongemarkeerd - GPX) over 4 van de passen in het Revermont-massief: Col des Angoulures, Col de la Rousse, Col de la Pérouse en Col de France. Als bonus biedt de route uitzonderlijke uitzichten, bergkammen en bergen."
    ]
  },
  "rdfs:label": {
    "en": [
      "VTTAE circuit (red) - The 4 Revermont passes"
    ],
    "fr": [
      "Circuit VTTAE (rouge) - Les 4 cols du Revermont"
    ]
  },
