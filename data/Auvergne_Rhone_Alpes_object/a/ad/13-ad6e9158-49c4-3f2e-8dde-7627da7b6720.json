  "rdfs:comment": {
    "de": [
      "Baumschule in Höhenlagen, die auf alte/rustikale Obstsorten und Beerenobstpflanzen spezialisiert ist.\r\nProduktion von Obst aus dem Obstgarten in 1000 m Höhe.\r\nZertifiziert für biologischen Landbau"
    ],
    "en": [
      "High-altitude nursery specializing in ancient/rustic fruit varieties and berry plants.\r\nProduction of fruit from the orchard at 1000m altitude.\r\nCertified Organic Agriculture"
    ],
    "it": [
      "Vivaio d'alta quota specializzato in varietà di frutta e piante da bacca antiche e rustiche.\r\nProduzione di frutta dal frutteto a 1000 m di altitudine.\r\nAgricoltura biologica certificata"
    ],
    "fr": [
      "Pépinière d'altitude spécialisée en variétés fruitières anciennes/rustiques et plants de petits-fruits. \r\nProduction de fruits du verger à 1000m d'altitude.\r\nCertifié en Agriculture Biologique"
    ],
    "es": [
      "Vivero de altitud especializado en variedades frutales antiguas/rústicas y plantas de bayas.\r\nProducción de fruta del huerto a 1000 m de altitud.\r\nAgricultura ecológica certificada"
    ],
    "nl": [
      "Kwekerij op grote hoogte gespecialiseerd in oude/ruige fruitsoorten en bessenplanten.\r\nProductie van fruit uit de boomgaard op 1000m hoogte.\r\nGecertificeerde biologische landbouw"
    ]
  },
