  "rdfs:comment": {
    "de": [
      "Touristische Informationen für Touristen.\r\nEbenfalls vor Ort: Plan d'eau de Vieure, Campingplatz, Chalets und Bungalows. Baden, Mountainbiking, Tretboote, Kanu, Paddelboot, Wandern und Kinderspiele."
    ],
    "en": [
      "Tourist information for tourists.\r\nAlso on site, lake of Vieure, campsite, chalets and bungalows. Swimming, mountain biking, pedal boats, canoeing, paddle, hiking and games for children."
    ],
    "it": [
      "Informazioni turistiche per i turisti.\r\nInoltre, sul posto, lago Vieure, campeggio, chalet e bungalow. Nuoto, mountain bike, pedalò, canoa, paddle, escursioni e giochi per bambini."
    ],
    "fr": [
      "Informations touristiques auprès des touristes.\r\nSur place également, plan d'eau de Vieure, camping, chalets et bungalows. Baignade, VTT, pédalos, canoë, paddle, rando et jeux pour enfants."
    ],
    "nl": [
      "Informatie voor toeristen.\r\nOok ter plaatse, Vieure meer, camping, chalets en bungalows. Zwemmen, mountainbiken, waterfietsen, kanoën, peddelen, wandelen en kinderspelen."
    ],
    "es": [
      "Información turística para turistas.\r\nTambién en el lugar, el lago de Vieure, camping, chalets y bungalows. Natación, bicicleta de montaña, botes a pedal, canoa, remo, senderismo y juegos para niños."
    ]
  },
