  "rdfs:comment": {
    "de": [
      "Spielplatz für Fahrräder, ganzjährig zugänglich im Vallée Bleue. Abwechslungsreiche Module für Spaß und Fortschritte in Gleichgewicht und Technik, ideal für Kinder. Schließung möglich bei außergewöhnlichen Ereignissen."
    ],
    "en": [
      "At the Vallée Bleue leisure park in Montalieu-Vercieu, the handling area is reserved for mountain bikes, with a number of modules open to the public. They're perfect for improving the handling of your mountain bike."
    ],
    "it": [
      "Un'area divertente e maneggevole per le biciclette, aperta tutto l'anno a Vallée Bleue. Una varietà di moduli per divertirsi e migliorare l'equilibrio e la tecnica, ideale per i bambini. Può essere chiusa per eventi speciali."
    ],
    "fr": [
      "Aire ludique de maniabilité pour vélos, accessible toute l’année à la Vallée Bleue. Modules variés pour s’amuser et progresser en équilibre et en technique, idéale pour les enfants. Fermeture possible en cas d’événement exceptionnel."
    ],
    "es": [
      "Un espacio lúdico y maniobrable para bicicletas, abierto todo el año en Vallée Bleue. Diversos módulos para divertirse y mejorar el equilibrio y la técnica, ideal para los niños. Puede estar cerrado para eventos especiales."
    ],
    "nl": [
      "Een leuk, wendbaar terrein voor fietsen, het hele jaar geopend in Vallée Bleue. Gevarieerde modules om plezier te hebben en je evenwicht en techniek te verbeteren, ideaal voor kinderen. Kan gesloten zijn voor speciale evenementen."
    ]
  },
  "rdfs:label": {
    "en": [
      "Vallée Bleue mountain biking fun area"
    ],
    "fr": [
      "Aire ludique de maniabilité VTT de la Vallée Bleue"
    ]
  },
