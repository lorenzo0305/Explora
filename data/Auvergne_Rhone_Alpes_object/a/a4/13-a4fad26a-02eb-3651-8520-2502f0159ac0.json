  "rdfs:comment": {
    "de": [
      "Seit 1987 ist Tarriotte Immobilier auf dem Markt der Drôme Provençale und der Ardèche Méridionale mit seinen bemerkenswert gut gelegenen Filialen in MONTELIMAR, ALBA LA ROMAINE, GRIGNAN und DIEULEFIT tätig."
    ],
    "en": [
      "Tarriotte Immobilier has been operating in the Drôme Provençale and Ardèche Méridionale markets since 1987, with agencies in remarkably good locations in MONTELIMAR, ALBA LA ROMAINE, GRIGNAN and DIEULEFIT."
    ],
    "it": [
      "Dal 1987, Tarriotte Immobilier opera nella Drôme Provençale e nell'Ardèche Méridionale con le sue agenzie notevolmente ben posizionate a MONTELIMAR, ALBA LA ROMAINE, GRIGNAN e DIEULEFIT."
    ],
    "fr": [
      "Depuis 1987, Tarriotte Immobilier opère sur le marché de la Drôme provençale et de l'Ardèche Méridionale avec ses agences remarquablement bien situées à MONTELIMAR, ALBA LA ROMAINE, GRIGNAN et DIEULEFIT."
    ],
    "nl": [
      "Tarriotte Immobilier is sinds 1987 actief op de markten van de Drôme Provençale en de Ardèche Méridionale, met agentschappen in MONTELIMAR, ALBA LA ROMAINE, GRIGNAN en DIEULEFIT, allemaal opmerkelijk goed gelegen."
    ],
    "es": [
      "Desde 1987, Tarriotte Immobilier opera en la Drôme Provençale y la Ardèche Méridionale con sus agencias notablemente bien situadas en MONTELIMAR, ALBA LA ROMAINE, GRIGNAN y DIEULEFIT."
    ]
  },
