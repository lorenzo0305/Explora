  "rdfs:comment": {
    "de": [
      "Kulturelles Programm mit Aufführungen (Konzerte, Theaterstücke), Kinosaal.\r\nWorkshops für Kinder und Erwachsene, Spielothek, Aktivitäten im Zusammenhang mit der Familie und dem lokalen Leben, Kinderanimation und Jugendprojekte."
    ],
    "en": [
      "Cultural programme with shows (concerts, plays), cinema.\r\nWorkshops for children and adults, games library, activities based on family and local life, events for children and projects for youth."
    ],
    "it": [
      "Programma culturale di spettacoli (concerti, opere teatrali), cinema.\r\nLaboratori per bambini e adulti, ludoteca, attività legate alla famiglia e alla vita locale, attività per bambini e progetti giovanili."
    ],
    "fr": [
      "Programmation culturelle de spectacles (concerts, pièces de théâtre), salle de cinéma.\r\nAteliers pour enfants et adultes, ludothèque, activités liées à la famille et à la vie locale, animations enfance et projets jeunes."
    ],
    "es": [
      "Programa cultural de espectáculos (conciertos, obras de teatro), cine.\r\nTalleres para niños y adultos, ludoteca, actividades relacionadas con la familia y la vida local, actividades infantiles y proyectos para jóvenes."
    ],
    "nl": [
      "Cultureel programma van voorstellingen (concerten, toneelstukken), bioscoop.\r\nWorkshops voor kinderen en volwassenen, spelotheek, activiteiten met betrekking tot het gezin en het lokale leven, kinderactiviteiten en jeugdprojecten."
    ]
