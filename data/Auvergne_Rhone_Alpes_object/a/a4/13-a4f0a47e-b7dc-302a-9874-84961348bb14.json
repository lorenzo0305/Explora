  "rdfs:comment": {
    "de": [
      "Diese recht einfache Route führt Sie auf das Plateau de Cenise, ein sensibles Naturgebiet, von wo aus Sie einen herrlichen Panoramablick auf das Bargy-Massiv genießen können."
    ],
    "en": [
      "This easy route will take you to Cenise's Pass, a beautiful protected natural area, on which you will have a wonderful viewover the Bargy mountain range."
    ],
    "it": [
      "Questo itinerario abbastanza facile vi porterà sull'altopiano di Cenise, un'area naturale sensibile, da cui potrete godere di uno splendido panorama sul massiccio del Bargy."
    ],
    "fr": [
      "Cet itinéraire assez facile vous emmènera sur le plateau de Cenise, un espace naturel sensible, d'où vous pourrez profiter d'un splendide panorama sur le massif du Bargy."
    ],
    "es": [
      "Este itinerario bastante fácil le llevará a la meseta de Cenise, un espacio natural sensible, desde donde podrá disfrutar de un espléndido panorama del macizo de Bargy."
    ],
    "nl": [
      "Deze vrij gemakkelijke route brengt u naar het plateau van Cenise, een kwetsbaar natuurgebied, vanwaar u kunt genieten van een prachtig panorama op het Bargy-massief."
    ]
  },
