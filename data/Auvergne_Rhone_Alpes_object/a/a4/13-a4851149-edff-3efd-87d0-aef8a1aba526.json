  "rdfs:comment": {
    "de": [
      "Ein kleiner Fußweg mit Bäumen ermöglicht es Ihnen, so nah wie möglich an der Saône entlang zu gehen. Eine Treppe oberhalb der Brücke von Couzon ermöglicht Ihnen den Zugang. Vor Ort gibt es Tische und Bänke, damit Sie den Platz genießen können."
    ],
    "en": [
      "A short, tree-lined walkway takes you right along the Saône. A staircase upstream from the Couzon bridge provides access. Tables and benches have been set up on site for you to enjoy."
    ],
    "it": [
      "Un breve sentiero alberato permette di costeggiare la Saona il più possibile. Una scala a monte del ponte di Couzon consente l'accesso. Sul posto sono stati allestiti tavoli e panchine."
    ],
    "fr": [
      "Un petit cheminement piéton et arboré vous permet de longer la Saône au plus près. Un escalier à l’amont du pont de Couzon vous permet d’y accéder. Sur place, des tables et des bancs ont été installé afin de vous permettre de profiter de cet espace."
    ],
    "nl": [
      "Via een kort wandelpad met bomen kun je zo dicht mogelijk langs de Saône lopen. Een trap stroomopwaarts vanaf de brug van Couzon biedt toegang. Ter plaatse zijn tafels en banken neergezet waar je van kunt genieten."
    ],
    "es": [
      "Un corto sendero arbolado permite bordear el Saona lo más cerca posible. Desde el puente del Couzon, una escalera río arriba permite el acceso. En el lugar se han instalado mesas y bancos para su disfrute."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Pêcher la Saône à Couzon"
    ]
  },
