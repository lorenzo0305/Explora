  "rdfs:comment": {
    "de": [
      "Entdecken Sie das brandneue Escape Game in Valfréjus!\r\nTauchen Sie ein in ein spannendes Spiel, in dem Sie eine Bombe entschärfen müssen, um die Station zu retten.\r\nÜberlegung und Kooperation sind Ihre Verbündeten in diesem fesselnden Abenteuer."
    ],
    "en": [
      "Discover the brand-new Escape Game in Valfréjus!\r\nDive into a thrilling game where you have to defuse a bomb to save the resort.\r\nReflexion and cooperation are your allies in this captivating adventure."
    ],
    "it": [
      "Scoprite il nuovissimo Escape Game di Valfréjus!\r\nTuffatevi in un gioco emozionante in cui dovrete disinnescare una bomba per salvare il resort.\r\nIl pensiero e la collaborazione sono i vostri alleati in questa avvincente avventura."
    ],
    "fr": [
      "Découvrez le tout nouvel Escape Game à Valfréjus ! \r\nPlongez dans un jeu palpitant où vous devez désamorcer une bombe pour sauver la station. \r\nRéflexion et coopération sont vos alliées dans cette aventure captivante."
    ],
    "nl": [
      "Ontdek het gloednieuwe Escape Game in Valfréjus!\r\nDuik in een spannend spel waarin je een bom onschadelijk moet maken om het resort te redden.\r\nDenken en samenwerken zijn je bondgenoten in dit boeiende avontuur."
    ],
    "es": [
      "Descubre el nuevo juego de escape en Valfréjus\r\nSumérgete en un emocionante juego en el que tendrás que desactivar una bomba para salvar el complejo turístico.\r\nPensar y trabajar juntos son tus aliados en esta cautivadora aventura."
    ]
  },
