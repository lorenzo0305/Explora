  "rdfs:comment": {
    "de": [
      "Der Verein \"Au fil d'argent\" organisiert einen Belote-Wettbewerb! Alle Teams werden prämiert. preis: 2 Einkaufsgutscheine im Wert von je 100?, 2. Preis: 2 Präsentkörbe im Wert von 50?, 3. Preis: 2 Mahlzeiten für 30? im Restaurant. Buffet-Buvette."
    ],
    "en": [
      "The \"Au fil d'argent\" association is organizing a belote competition! All teams will win prizes. 1st prize: 2 vouchers worth 100? each, 2nd prize: 2 baskets worth 50?, 3rd prize: 2 meals at 30? in a restaurant. Buffet-Buvette."
    ],
    "it": [
      "L'associazione \"Au fil d'argent\" organizza una gara di belote! Tutte le squadre vinceranno dei premi. 1° premio: 2 buoni spesa da 100€ ciascuno, 2° premio: 2 cesti regalo da 50€, 3° premio: 2 pasti al ristorante da 30€. Buffet bar."
    ],
    "fr": [
      "L'association \"Au fil d'argent\" organise un concours de belote ! Toutes les équipes seront primées. 1er prix : 2 bons d'achat de 100€ chacun, 2ème prix : 2 paniers garnis valeur 50€, 3ème prix : 2 repas à 30€ au restaurant. Buffet-Buvette."
    ],
    "es": [
      "La asociación \"Au fil d'argent\" organiza un concurso de belote Todos los equipos ganarán premios. 1er premio: 2 vales de compra por valor de 100 euros cada uno, 2º premio: 2 cestas de regalo por valor de 50 euros, 3er premio: 2 comidas en un restaurante por valor de 30 euros. Bar buffet."
    ],
    "nl": [
      "De vereniging \"Au fil d'argent\" organiseert een belote-wedstrijd! Alle teams winnen prijzen. 1e prijs: 2 winkelbonnen van elk 100 euro, 2e prijs: 2 geschenkmanden van 50 euro, 3e prijs: 2 maaltijden in een restaurant voor 30 euro. Buffetbar."
    ]
  },
  "rdfs:label": {
