  "rdfs:comment": {
    "de": [
      "Sie befinden sich im Herzen der Châtaigneraie, zwischen Quercy und den Monts d'Auvergne, 25 km südlich von Aurillac. Die Auberge La Tomette liegt auf halbem Hügel in einer grünen Umgebung und empfängt Sie in Vitrac im Departement Cantal."
    ],
    "en": [
      "You are in the heart of the Chaitaigneraie Cantalienne, between Quercy and Monts d'Auvergne, 25 km south of Aurillac. Nestled mid-hill in a green setting, the Auberge La Tomette welcome you to Vitrac in Cantal."
    ],
    "it": [
      "Siete nel cuore della regione della Châtaigneraie, tra il Quercy e le montagne dell'Alvernia, a 25 km a sud di Aurillac. Adagiato a metà collina in un ambiente verde, l'Auberge La Tomette vi dà il benvenuto a Vitrac, nel Cantal."
    ],
    "fr": [
      "Vous êtes au coeur de la Châtaigneraie, entre Quercy et monts d'Auvergne, à 25 km au sud d'Aurillac. Nichée à mi-colline dans un cadre de verdure, l'Auberge La Tomette vous accueille à Vitrac, dans le Cantal."
    ],
    "nl": [
      "U bevindt zich in het hart van de Chataigneraie cantalienne, tussen Quercy en de Monts d'Auvergne, 25 km ten zuiden van Aurillac. Het Auberge La Tomette ligt midden op een heuvel in een groene omgeving, verwelkomt u in Vitrac in de Cantal."
    ],
    "es": [
      "Se encuentra en el corazón de la región de Châtaigneraie, entre Quercy y las montañas de Auvernia, a 25 km al sur de Aurillac. Enclavado a media colina en un entorno verde, el Auberge La Tomette le da la bienvenida a Vitrac, en el Cantal."
    ]
  },
  "rdfs:label": {
