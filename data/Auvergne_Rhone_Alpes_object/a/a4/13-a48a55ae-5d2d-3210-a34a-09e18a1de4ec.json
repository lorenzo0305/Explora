  "rdfs:comment": {
    "de": [
      "Le Verger du Forez produziert in biologischem Anbau rote Früchte, Äpfel, Tafeltrauben, die frisch verkauft oder selbst zu Konfitüren, Coulis, Sirup, Sorbets und Kompott verarbeitet werden, aber auch Honig, der in einem Umkreis von 30 km geerntet wird."
    ],
    "en": [
      "The Verger du Forez produces organically-grown apples, grapes and berry fruits, sold fresh or processed on the premises into jam, jelly, coulis, syrup, sorbet or compote, as well as honey collected within a 30km radius."
    ],
    "it": [
      "Le Verger du Forez è un produttore biologico di frutti rossi, mele e uva da tavola, venduti freschi o trasformati in marmellate, coulis, sciroppi, sorbetti e composte, nonché di miele raccolto nel raggio di 30 km."
    ],
    "fr": [
      "Le Verger du Forez produit en agriculture biologique des fruits rouges, pommes, raisins de table vendus frais ou transformés par ses soins en confitures, coulis, sirops, sorbets, compotes, mais aussi du miel récolté dans un rayon de 30 km."
    ],
    "nl": [
      "Le Verger du Forez is een biologische producent van rood fruit, appels en tafeldruiven, die vers worden verkocht of verwerkt tot jam, coulis, siroop, sorbets en compote, en van honing die in een straal van 30 km wordt geoogst."
    ],
    "es": [
      "Le Verger du Forez es un productor ecológico de frutos rojos, manzanas y uvas de mesa, que se venden frescos o transformados en mermeladas, coulis, siropes, sorbetes y compotas, así como miel recolectada en un radio de 30 km."
    ]
  },
