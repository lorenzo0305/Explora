  "rdfs:comment": {
    "de": [
      "Am Fuße der Seilbahn befindet sich eine große Südterrasse, eine gemütliche Ecke mit Büchern und Spielen für die Kinder. Ideal, um diesen Sommer eine gute Zeit zu verbringen..."
    ],
    "en": [
      "This restaurant is located the foot of the Gorge gondola. On the menu: dish of the day and a selection of homemade dishes. Speciality of the house - The Pontet Burger. Open at lunchtime. Bar pub, free WI-FI, games room, après-ski and live concerts;"
    ],
    "it": [
      "Ai piedi della funivia della Gorge. Piatto del giorno, menu con piatti fatti in casa. Specialità: “Burger Pontet”. Aperto a pranzo. Bar, pub, wi-fi gratuito, spazio ricreativo, aperitivo post sci, concerti live."
    ],
    "fr": [
      "Au pied du télécabine, une grande terrasse plein sud, un coin cosy avec des livres et des jeux pour les enfants. L’idéal pour passer un bon moment cet été..."
    ],
    "es": [
      "Al pie del telecabina, una gran terraza orientada al sur, un rincón acogedor con libros y juegos para los niños. El lugar ideal para pasar un buen rato este verano..."
    ],
    "nl": [
      "Aan de voet van de gondel, een groot terras op het zuiden, een gezellige hoek met boeken en spelletjes voor de kinderen. De ideale plek om deze zomer een leuke tijd door te brengen..."
    ]
  },
