  "rdfs:comment": {
    "de": [
      "Verbringen Sie einen einzigartigen Moment in der Mediathek von Saint-François-Longchamp! Bücher, CDs und Computer (mit Internetzugang) zur Selbstbedienung vor Ort ...\r\nHinter dem Rathaus gelegen, auf 1450\r\nIdeal für Familien, kostenlos und für alle zugänglich."
    ],
    "en": [
      "Come and spend a unique moment in the Library of Saint-François-Longchamp! Books, CDs and computers (with internet access) in self-service on site ...\r\nLocated behind the town hall, at 1450.\r\nIdeal for families, free and open to all."
    ],
    "it": [
      "Venite a trascorrere un momento unico nella Mediathèque di Saint-François-Longchamp! Libri, CD e computer (con accesso a Internet) sono disponibili in loco...\r\nSituato dietro il municipio, al numero 1450\r\nIdeale per le famiglie, gratuito e aperto a tutti."
    ],
    "fr": [
      "Venez passer un moment unique dans la Mediathèque de Saint-François-Longchamp! Livres, CD et ordinateurs (avec accès internet) en libre-service sur place ...\r\nSitué derrière la mairie, à 1450. \r\nIdéal pour les familles, gratuit et ouvert à tous."
    ],
    "es": [
      "¡Venga a pasar un momento único en la Mediateca de Saint-François-Longchamp! Hay libros, CDs y ordenadores (con acceso a Internet) disponibles en el lugar...\r\nSituado detrás del ayuntamiento, en el 1450\r\nIdeal para las familias, es gratuito y está abierto a todos."
    ],
    "nl": [
      "Kom en beleef een uniek moment in de Mediathèque van Saint-François-Longchamp! Boeken, cd's en computers (met internettoegang) zijn ter plaatse beschikbaar...\r\nGelegen achter het stadhuis, op 1450\r\nIdeaal voor gezinnen, gratis en voor iedereen toegankelijk."
    ]
  },
