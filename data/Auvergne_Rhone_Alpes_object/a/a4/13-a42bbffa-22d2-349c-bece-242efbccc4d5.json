  "rdfs:comment": {
    "de": [
      "Im Herzen der Alm Tréchauffé, erreichbar mit dem Auto von La Forclaz oder vom Vallée d'Abondance über den Col du Grand Taillet. Verpflegung: Kartoffelkrapfen, Käseschnitten, Tartiflette, etc."
    ],
    "en": [
      "In the heart of Trechauffe mountain meadow (accessible by car from La Forclaz or from the Abondance valley via the Grand Taillet Col. Light meals from Tuesday to Sunday: potato waffles, traditional cheese toasties, tartiflette, cheese, etc...…"
    ],
    "it": [
      "Nel cuore dell'alpeggio di Tréchauffé, raggiungibile in auto da La Forclaz o dalla Vallée d'Abondance attraverso il Col du Grand Taillet. Ristorazione: frittelle di patate, croûte di formaggio, tartiflette, ecc..."
    ],
    "fr": [
      "Au coeur de l'alpage de Tréchauffé, accessible en voiture depuis La Forclaz ou depuis la Vallée d'Abondance par le Col du Grand Taillet. Restauration: Beignets de pomme de terre, croûtes au fromage, tartiflette, etc..."
    ],
    "nl": [
      "In het hart van de bergweide van Tréchauffé, bereikbaar met de auto vanuit La Forclaz of vanuit de Vallée d'Abondance via de Col du Grand Taillet. Catering: aardappelbeignets, kaascroûtes, tartiflette, enz..."
    ],
    "es": [
      "En el corazón de los pastos de montaña de Tréchauffé, accesible en coche desde La Forclaz o desde la Vallée d'Abondance por el Col du Grand Taillet. Restauración: buñuelos de patata, croûtes de queso, tartiflette..."
    ]
  },
  "rdfs:label": {
    "en": [
      "La Chèvrerie de Tréchauffé"
    ],
    "fr": [
      "La Chèvrerie de Tréchauffé"
    ]
  },
