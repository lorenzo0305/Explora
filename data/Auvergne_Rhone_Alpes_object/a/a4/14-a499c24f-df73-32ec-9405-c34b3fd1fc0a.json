  "rdfs:comment": {
    "de": [
      "Die Wärme einer Bierbar! Le Mac befindet sich mitten im Stadtzentrum von Lens und bietet nicht weniger als 15 Biere vom Fass zur Auswahl!"
    ],
    "en": [
      "The warmth of a beer bar! Located in the heart of downtown Lens, Le Mac offers a choice of no less than 15 beers on draught!"
    ],
    "it": [
      "Il calore di una birreria! Situato nel centro di Lens, Le Mac offre una scelta di ben 15 birre alla spina!"
    ],
    "fr": [
