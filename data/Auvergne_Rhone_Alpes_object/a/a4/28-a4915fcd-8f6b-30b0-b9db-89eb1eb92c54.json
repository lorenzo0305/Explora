  "rdfs:comment": {
    "de": [
      "Restaurant, Weinbar, täglich geöffnet\n\nBesteckaufnahme von 18:00 bis 22:30 Uhr montags bis donnerstags - von 18:00 bis 23:00 Uhr freitags, samstags und sonntags.\n\nPreise à la carte: min: 15? - maxi: 29?\n\nEs besteht die Möglichkeit, einen Raum für bis zu 22 Personen zu privatisieren.\n\n "
    ],
    "en": [
      "Restaurant and wine bar open daily\n\nFrom 6pm to 10:30pm Monday to Thursday - from 6pm to 11pm Friday, Saturday and Sunday.\n\nA la carte prices: min: 15? - maxi : 29?\n\nPossibility of privatizing a room for up to 22 people.\n\n "
    ],
    "it": [
      "Ristorante e wine bar aperti tutti i giorni\n\nDal lunedì al giovedì dalle 18.00 alle 22.30 - venerdì, sabato e domenica dalle 18.00 alle 23.00.\n\nPrezzi alla carta: minimo: 15? - massimo: 29?\n\nUna sala privata può ospitare fino a 22 persone.\n\n "
    ],
    "fr": [
      "Restaurant, Bar à vins ouvert tous les jours \n\nPrise de couverts de 18h à 22h30 du lundi au jeudi - de 18h à 23h les vendredi, samedi et dimanche.\n\nPrix à la carte : mini : 15€ - maxi : 29€\n\nPossibilité de privatiser une salle pouvant accueillir jusqu'à 22 personnes.\n\n "
    ],
    "es": [
      "Restaurante y bar de vinos abierto todos los días\n\nDe lunes a jueves de 18:00 a 22:30 - Viernes, sábados y domingos de 18:00 a 23:00.\n\nPrecios a la carta: mínimo: 15? - máximo: 29?\n\nUna sala privada puede acoger hasta 22 personas.\n\n "
    ],
    "nl": [
      "Restaurant en wijnbar elke dag geopend\n\nMaandag tot donderdag van 18.00 tot 22.30 uur - Vrijdag, zaterdag en zondag van 18.00 tot 23.00 uur.\n\nPrijzen à la carte: minimum: 15? - max: 29?\n\nEen privézaal is geschikt voor maximaal 22 personen.\n\n "
    ]
  },
