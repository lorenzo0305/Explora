  "rdfs:comment": {
    "de": [
      "Die Ferme de la Grangette ist eine biologisch bewirtschaftete Zucht von Abondance- und Montbéliard-Kühen in den Ausläufern der Belledonne. Hier werden mehrere Käsesorten hergestellt, Tomme de Belledonne, Montgaren, Raclette, Joghurt, Fasel etc."
    ],
    "en": [
      "Ferme de la Grangette is an organic farm in the foothills of the Belledonne that rears Abondance and Montbéliarde cows. Several types of cheese are made here, including Tomme de Belledonne, Montgaren, yoghurt and Faisselle."
    ],
    "it": [
      "L'azienda agricola La ferme de la Grangette e un azienda biologica dove produciamo formaggi di mucca et carne bovina e suina. Troverete un negozio sul azienda che vi acoglie per proporvi nostri prodotti e prodotti di altri produttori della zona (mermelate, miele, birre...). Potrete anche vedere i nostri animali."
    ],
    "fr": [
      "La ferme de la Grangette est un élevage de vaches abondances et montbéliardes, en agriculture biologique, sur les contreforts de Belledonne. Plusieurs types de fromages y sont fabriqués, tomme de Belledonne, Montgaren, raclette, yaourts, faisselle etc."
    ],
    "nl": [
      "Ferme de la Grangette is een biologische boerderij in de uitlopers van de Belledonne, waar Abondance en Montbéliarde koeien worden gehouden. Hier worden verschillende soorten kaas gemaakt, waaronder Tomme de Belledonne, Montgaren, yoghurt en faisselle."
    ],
    "es": [
      "Ferme de la Grangette es una granja ecológica con vacas abondance y montbéliardes en las estribaciones de la Belledonne. Aquí se elaboran varios tipos de queso, entre ellos tomme de Belledonne, Montgaren, raclette, yogures y faisselle."
    ]
  },
