  "rdfs:comment": {
    "de": [
      "Die Bibliothek ist ein Ort des Lebens, der Begegnung und des Austauschs. Sie finden vor Ort eine große Auswahl an Büchern für Erwachsene und Kinder, die zweimal im Jahr erneuert werden und die Sie kostenlos ausleihen können."
    ],
    "en": [
      "The library is a place of life, meetings and exchanges. You will find a large choice of books for adults and children, renewed twice a year, which you can borrow free of charge."
    ],
    "it": [
      "La biblioteca è un luogo di vita, di incontri e di scambi. Troverete un'ampia scelta di libri per adulti e bambini, rinnovati due volte l'anno, che potrete prendere in prestito gratuitamente."
    ],
    "fr": [
      "La bibliothèque est un lieu de vie, de rencontres et d’échanges. Vous trouverez sur place un grand choix de livres pour adultes et pour enfants, renouvelés deux fois par an, que vous pourrez emprunter gratuitement."
    ],
    "es": [
      "La biblioteca es un lugar de vida, encuentros e intercambios. Encontrará una amplia selección de libros para adultos y niños, renovada dos veces al año, que podrá tomar prestada gratuitamente."
    ],
    "nl": [
      "De bibliotheek is een plaats van leven, ontmoeting en uitwisseling. U vindt er een grote selectie boeken voor volwassenen en kinderen, die tweemaal per jaar worden vernieuwd en die u gratis kunt lenen."
    ]
  },
