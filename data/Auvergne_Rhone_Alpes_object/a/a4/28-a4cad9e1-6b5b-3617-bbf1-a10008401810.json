  "rdfs:comment": {
    "de": [
      "Auf einem Bauernhof, im Herzen der Viehzucht, gibt es einen Laden für den Direktverkauf und ein Bauernhofgasthaus, das in einem ehemaligen Stall eingerichtet wurde.\nBesichtigung des Bauernhofs auf Anfrage.\nDie Produktion: Geflügel, Schweine, Kaninchen, Eier, Wurstwaren."
    ],
    "en": [
      "In a farm, in the heart of the breeding, a shop for direct sales and a farmhouse inn fitted out in an old cowshed.\nVisit of the farm on request.\nThe productions: poultry, pigs, rabbits, eggs, delicatessen."
    ],
    "it": [
      "In una fattoria, nel cuore dell'allevamento, un negozio di vendita diretta e un'osteria allestita in una vecchia stalla.\nVisita della fattoria su richiesta.\nProduzione: pollame, suini, conigli, uova, salumi."
    ],
    "fr": [
      "Dans une ferme, au coeur de l'élevage, un magasin de vente directe et une ferme auberge aménagée dans une ancienne étable.\nVisite de la ferme sur demande.\nLes productions : volailles, porcs, lapins, oeufs, charcuterie."
    ],
    "nl": [
      "In een boerderij, in het hart van de fokkerij, een winkel voor directe verkoop en een boerenherberg ingericht in een oude koeienstal.\nBezoek aan de boerderij op aanvraag.\nProductie: pluimvee, varkens, konijnen, eieren, vleeswaren."
    ],
    "es": [
      "En una granja, en el corazón de la cría, una tienda de venta directa y una posada agrícola habilitada en un antiguo establo.\nVisita de la granja a petición.\nProducción: aves de corral, cerdos, conejos, huevos, charcutería."
    ]
  },
  "rdfs:label": {
    "fr": [
