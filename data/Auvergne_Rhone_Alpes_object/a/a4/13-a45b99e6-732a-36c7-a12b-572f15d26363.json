  "rdfs:comment": {
    "de": [
      "Als Eingangstor zu den Portes du Mont-Blanc bietet die Gondelbahn von Jaillet eine spektakuläre Aussicht von den Fiz bis zu den Aravis, mit dem Mont-Blanc im Hintergrund, der Megève dominiert. Auf dem Gipfel können Sie die Infrastruktur für einen angenehmen Moment nutzen."
    ],
    "en": [
      "The gateway to the Portes du Mont-Blanc, the Jaillet cable car offers spectacular views from Les Fiz to Les Aravis, with Mont Blanc dominating Megève in the background. At the top, enjoy the facilities for a pleasant break."
    ],
    "it": [
      "Porta d'ingresso alle Porte del Monte Bianco, la cabinovia del Jaillet offre una vista spettacolare dai Fiz agli Aravis, con il Monte Bianco sullo sfondo che domina Megève. Una volta arrivati in cima, approfittate delle infrastrutture per trascorrere momenti piacevoli."
    ],
    "fr": [
      "Porte d’entrée des Portes du Mont-Blanc, la Télécabine du Jaillet offre une vue spectaculaire des Fiz aux Aravis, avec le Mont-Blanc en toile de fond dominant Megève. Au sommet, profitez des infrastructures pour un moment agréable."
    ],
    "es": [
      "La telecabina del Jaillet, puerta de entrada a las Portes du Mont-Blanc, ofrece unas vistas espectaculares desde los Fiz hasta los Aravis, con el Mont-Blanc como telón de fondo dominando Megève. En la cima, disfrute de las instalaciones para pasar un rato agradable."
    ],
    "nl": [
      "De Jaillet gondel is de toegangspoort tot de Portes du Mont-Blanc en biedt een spectaculair uitzicht van de Fiz tot het Aravis gebergte, met op de achtergrond de Mont-Blanc die boven Megève uittorent. Maak op de top optimaal gebruik van de faciliteiten voor een geweldige tijd."
    ]
  },
  "rdfs:label": {
    "en": [
