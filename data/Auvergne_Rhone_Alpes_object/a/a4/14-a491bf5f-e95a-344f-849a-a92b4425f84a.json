      "dc:description": {
        "de": [
          "Le repère de Torcy lädt Sie zu seinem Rock'n Roll-Abend ein, bei dem es sich um ein Essenskonzert handelt, das am 22. Februar 2025 veranstaltet wird. Weitere Informationen finden Sie auf dem Plakat"
        ],
        "en": [
          "Le repère de Torcy invites you to its Rock'n Roll evening, a meal concert on February 22, 2025. For more information, please consult the poster"
        ],
        "it": [
          "Le repère de Torcy vi invita alla serata Rock'n Roll, un pasto e un concerto che si terrà il 22 febbraio 2025. Per maggiori informazioni, consultare la locandina"
        ],
        "fr": [
          "Le repère de Torcy vous invite à sa soirée Rock'n Roll qui est un repas concert organisé le 22 février 2025. Pour plus d'informations, veuillez consulter l'affiche"
        ],
        "nl": [
          "Le repère de Torcy nodigt u uit voor zijn Rock'n Roll avond, een maaltijd en concert op 22 februari 2025. Zie voor meer informatie de poster"
        ],
        "es": [
          "Le repère de Torcy le invita a su velada Rock'n Roll, una comida y un concierto que tendrán lugar el 22 de febrero de 2025. Para más información, consulte el cartel"
        ]
      },
