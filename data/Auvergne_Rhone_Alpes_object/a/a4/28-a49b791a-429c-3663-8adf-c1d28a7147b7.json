  "rdfs:comment": {
    "de": [
      "Die Tradition der hausgemachten Pommes frites seit vier Generationen! Seit 1991, im Viertel Les Halles in Amiens, empfangen Sie Catherine und Philippe von Dienstag bis Samstag sowohl in der Pommesbude als auch in der Bar!"
    ],
    "en": [
      "The tradition of home-made French fries for 4 generations! Since 1991, in the Halles district of Amiens, Catherine and Philippe welcome you from Tuesday to Saturday at the chip shop and at the bar!"
    ],
    "it": [
      "La tradizione delle patatine fritte fatte in casa da 4 generazioni! Dal 1991, nel quartiere Halles di Amiens, Catherine e Philippe vi accolgono dal martedì al sabato al negozio di patatine e al bar!"
    ],
    "fr": [
      "La tradition de la frite maison depuis 4 générations ! Depuis 1991, dans le quartier des Halles à Amiens, Catherine et Philippe vous accueillent du mardi au samedi aussi bien à la friterie qu'au bar !"
    ],
    "es": [
      "La tradición de las patatas fritas caseras desde hace 4 generaciones Desde 1991, en el barrio de las Halles de Amiens, Catherine y Philippe le acogen de martes a sábado en la tienda de patatas fritas y en el bar"
    ],
    "nl": [
      "De traditie van zelfgemaakte Chips sinds 4 generaties! Sinds 1991, in de wijk Halles in Amiens, verwelkomen Catherine en Philippe u van dinsdag tot zaterdag, zowel in de frituur als in de bar!"
    ]
  },
