  "rdfs:comment": {
    "de": [
      "Dorf Auzon: Mittelalterliches Dorf. Stiftskirche aus dem 12. Jahrhundert mit romanischem Christus, Jungfrau aus dem 15. Jahrhundert, Wandmalereien aus dem 14. und 16. Jahrhundert, Statue von Saint Verny (Schutzpatron der Winzer). Schloss (privat). Ehemalige Markthalle (halle). Porte du Brugelet (Tor von Brugelet). Stadtmauer."
    ],
    "en": [
      "Village of Auzon: Medieval village. 12th-century collegiate church with Romanesque Christ, 15th-century Virgin Mary, 14th- and 16th-century murals, statue of Saint Verny (patron saint of winegrowers). Castle (private). Former market hall. Brugelet gate. Ramparts."
    ],
    "it": [
      "Villaggio di Auzon: villaggio medievale. Collegiata del XII secolo con Cristo romanico, Madonna del XV secolo, dipinti murali del XIV e XVI secolo, statua di San Verny (patrono dei viticoltori). Castello (privato). Ex sala del mercato. Porta Brugelet. Bastioni."
    ],
    "fr": [
      "Village de Auzon : Village médiéval. Collégiale du XIIe siècle avec Christ roman, Vierge du XVe siècle, peintures murales des XIVe et XVIe siècles, statue de Saint Verny (patron des vignerons). Château (privé). Ancienne halle. Porte du Brugelet. Remparts."
    ],
    "es": [
      "Pueblo de Auzon: Pueblo medieval. Colegiata del siglo XII con Cristo románico, Virgen María del siglo XV, pinturas murales de los siglos XIV y XVI, estatua de San Verny (patrón de los viticultores). Castillo (privado). Antiguo mercado. Puerta de Brugelet. Murallas."
    ],
    "nl": [
      "Dorp Auzon: Middeleeuws dorp. 12e-eeuwse kapittelkerk met Romaanse Christus, 15e-eeuwse Maria, 14e- en 16e-eeuwse muurschilderingen, standbeeld van Saint Verny (beschermheilige van de wijnbouwers). Kasteel (privé). Voormalige markthal. Brugeletpoort. Stadswallen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Village Auzon  Petite cité de caractère"
    ]
  },
