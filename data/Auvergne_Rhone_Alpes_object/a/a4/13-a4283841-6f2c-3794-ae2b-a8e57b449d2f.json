  "rdfs:comment": {
    "de": [
      "Altitude Travel ist ein Unternehmen für personalisierte Transporte, aber auch ein Taxi mit medizinischem Service.\nDas Unternehmen befindet sich in Chamonix Mont Blanc im Herzen der Alpen und verfügt über eine Taxilizenz Nr. 4."
    ],
    "en": [
      "Altitude Travel is a personalized transport company, but also a medicalized vsl cab.\nlocated in Chamonix Mont Blanc, in the heart of the Alps, with license n°4."
    ],
    "it": [
      "Altitude Travel è un'azienda di trasporto personalizzato, nonché un taxi medico.\ncon sede a Chamonix Mont Blanc, nel cuore delle Alpi, taxi con licenza n. 4."
    ],
    "fr": [
      "Altitude Travel est une société de transports personnalisés, mais également taxi vsl medicalisé\nsituée à Chamonix Mont Blanc au cœur des Alpes.Taxi licence n°4."
    ],
    "nl": [
      "Altitude Travel is een bedrijf voor persoonlijk vervoer en medische taxi\ngevestigd in Chamonix Mont Blanc in het hart van de Alpen, taxi nr. 4 met vergunning."
    ],
    "es": [
      "Altitude Travel es una empresa de transporte personalizado, así como un taxi médico.\nsituada en Chamonix Mont Blanc, en el corazón de los Alpes, con licencia de taxi nº 4."
    ]
