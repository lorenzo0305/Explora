  "rdfs:comment": {
    "de": [
      "Wir erstellen auf Anfrage kostenlose Angebote für Bustransfers, für Halbtages- oder Ganztagesausflüge, für Aufenthalte in Frankreich oder im Ausland oder für Shuttle-Busse zu Bahnhöfen oder Flughäfen."
    ],
    "en": [
      "We offer free quotes for coach transport on request, for your half-day or full-day outings, for holidays in France or abroad, or for shuttles to stations or airports."
    ],
    "it": [
      "Offriamo preventivi gratuiti per il trasporto in pullman su richiesta, per le vostre gite di mezza o intera giornata, per viaggi in Francia o all'estero, o per navette verso stazioni o aeroporti."
    ],
    "fr": [
      "Nous proposons des devis gratuits de transport en autocar sur simple demande, pour vos sorties en demi-journée ou à la journée, pour des séjours en France ou à l’étranger ou pour des navettes en gare ou vers des aéroports."
    ],
    "nl": [
      "Wij bieden gratis busvervoer op aanvraag, voor uitstapjes van een halve of een hele dag, voor vakanties in Frankrijk of in het buitenland, of voor pendeldiensten naar stations of luchthavens."
    ],
    "es": [
      "Ofrecemos presupuestos gratuitos para el transporte en autocar a petición, para sus salidas de medio día o de un día entero, para viajes en Francia o en el extranjero, o para traslados a estaciones o aeropuertos."
    ]
  },
