  "rdfs:comment": {
    "de": [
      "In Hochsavoyen, in der Nähe des Genfer Sees gelegen, 8 Hektar Natur, die dem Wissen und dem Schutz von Raubvögeln gewidmet ist. 350 Vögel, Shows und atemberaubende Volieren.\r\nDer Park leitet das Programm zur Wiedereinführung des Seeadlers."
    ],
    "en": [
      "Located in Haute-Savoie, near Lake Geneva, 8 hectares of nature dedicated to the knowledge and protection of birds of prey. 350 birds, breathtaking shows and aviaries.\r\nThe park is leading a program to reintroduce the white-tailed eagle."
    ],
    "it": [
      "Situato in Alta Savoia, vicino al Lago di Ginevra, questo sito naturale di 8 ettari è dedicato alla conoscenza e alla protezione dei rapaci. 350 uccelli, spettacoli mozzafiato e voliere.\r\nIl parco sta conducendo un programma di reintroduzione dell'aquila di mare."
    ],
    "fr": [
      "Situé en Haute-Savoie, près du lac Léman, 8 hectares de nature dédié à la connaissance et la protection des rapaces. 350 oiseaux, des spectacles et des volières époustouflantes.\r\nLe parc mène le programme de réintroduction du pygargue à queue blanche."
    ],
    "es": [
      "Situado en Alta Saboya, cerca del lago Lemán, este paraje natural de 8 hectáreas está dedicado al conocimiento y la protección de las aves rapaces. 350 aves, espectáculos impresionantes y pajareras.\r\nEl parque lidera un programa de reintroducción del águila de cola blanca."
    ],
    "nl": [
      "Dit natuurgebied van 8 hectare in de Haute-Savoie, vlakbij het meer van Genève, is gewijd aan de kennis en bescherming van roofvogels. 350 vogels, adembenemende shows en volières.\r\nHet park leidt een programma om de zeearend te herintroduceren."
    ]
  },
