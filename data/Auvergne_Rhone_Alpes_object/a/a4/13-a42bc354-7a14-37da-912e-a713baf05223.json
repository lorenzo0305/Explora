  "rdfs:comment": {
    "de": [
      "Handwerksladen mit einzigartigen Stücken von etwa 30 lokalen Designern, Sportzubehör mit der wichtigsten Ausrüstung für Ihre Abenteuer in den Bergen. und Verleih von Schneeschuhen und Fahrrädern (Reparatur und Verkauf von Zubehör)."
    ],
    "en": [
      "Artisanal store with unique pieces from around thirty local designers, sports accessories offering essential equipment for your mountain adventures. and rental of snowshoes and bikes (repair and sale of accessories)."
    ],
    "it": [
      "Negozio artigianale con pezzi unici di una trentina di designer locali, accessori sportivi e abbigliamento outdoor e noleggio di ciaspole e mountain bike classiche o AE (riparazione e vendita di accessori)."
    ],
    "fr": [
      "Boutique artisanal avec des pièces uniques d'une trentaine de créateurs locaux, d'accessoires de sports et vêtements outdoor et location de raquettes et VTT classique où AE (réparation et vente accessoires) ."
    ],
    "es": [
      "Tienda artesanal con piezas únicas de una treintena de diseñadores locales, accesorios deportivos y ropa outdoor y alquiler de raquetas de nieve y bicicletas clásicas de montaña o AE (reparación y venta de accesorios)."
    ],
    "nl": [
      "Ambachtelijke winkel met unieke stukken van zo'n dertig plaatselijke ontwerpers, sportaccessoires met essentiële uitrusting voor je avonturen in de bergen en verhuur van sneeuwschoenen en fietsen (reparatie en verkoop van accessoires)."
    ]
  },
