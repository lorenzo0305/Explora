  "rdfs:comment": {
    "de": [
      "Geschlossene Gewässer, die zum Angeln freigegeben sind. Sie müssen eine Angelkarte mit sich führen. Erhältlich in den Büros des Office de Tourisme Forez-Est: Panissières, Feurs, Montrond les Bains. Angeln mit Köder verboten"
    ],
    "en": [
      "Enjoy a spot of fishing in the Pays de Saint-Galmier and take advantage of a multitude of 1st category (trout and minnow) and 2nd category (white fish) waterways"
    ],
    "it": [
      "Acque chiuse aperte alla pesca. È necessaria una licenza di pesca. In vendita presso l'Ufficio del Turismo del Forez-Est a Panissières, Feurs e Montrond les Bains. Vietata la pesca con esche artificiali"
    ],
    "fr": [
      "Eaux closes ouvertes à la pêche. Se munir obligatoirement d'une carte de pêche. En vente dans les bureaux de l'Office de Tourisme Forez-Est: de Panissières, Feurs, Montrond les Bains. Pêche aux  leurres interdite"
    ],
    "es": [
      "Aguas cerradas abiertas a la pesca. Se requiere licencia de pesca. A la venta en la Oficina de Turismo de Forez-Est en Panissières, Feurs y Montrond les Bains. Prohibida la pesca con señuelos"
    ],
    "nl": [
      "Afgesloten wateren waar gevist mag worden. Een visvergunning is vereist. Te koop bij het VVV-kantoor van Forez-Est in Panissières, Feurs en Montrond les Bains. Vissen met kunstaas verboden"
    ]
  },
