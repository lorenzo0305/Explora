  "rdfs:comment": {
    "de": [
      "Atelier/Boutique für Schmuckkreationen, Besichtigung und Vorführung. Handgefertigte Einzelstücke und Möglichkeit von Bestellungen nach Maß. Einführungskurse in Polymerpaste (für alle Altersgruppen)."
    ],
    "en": [
      "Hand-made jewellery workshop and boutique. Each article is handmade and bespoke orders are available. Introductory courses in polymer clay (all ages welcome)."
    ],
    "it": [
      "Laboratorio/negozio di gioielli, visita e dimostrazione. Pezzi unici fatti a mano e possibilità di ordini personalizzati. Corsi introduttivi all'argilla polimerica (per tutti i tipi di pubblico)."
    ],
    "fr": [
      "Atelier/Boutique de création de bijoux, visite et démonstration. Pièces uniques réalisées à la main et possibilité de commande sur mesure. Stages d'initiation à la pâte polymère (tous publics)."
    ],
    "es": [
      "Taller/tienda de joyería, visita y demostración. Piezas únicas hechas a mano y posibilidad de encargos personalizados. Cursos de iniciación a la arcilla polimérica (todos los públicos)."
    ],
    "nl": [
      "Juwelen atelier/winkel, bezoek en demonstratie. Unieke handgemaakte stukken en mogelijkheid tot maatwerk. Inleidende cursussen in polymeerklei (alle doelgroepen)."
    ]
  },
