  "rdfs:comment": {
    "de": [
      "Wir freuen uns, Sie begrüßen zu dürfen und Sie bei der Vorbereitung Ihres Aufenthalts und der Entdeckung des Massif du Sancy zu begleiten."
    ],
    "en": [
      "We have the pleasure to welcome you and to accompany you in the preparation of your stay and in the discovery of the Massif du Sancy."
    ],
    "it": [
      "Siamo lieti di accogliervi e di aiutarvi a preparare il vostro soggiorno e a scoprire il Massiccio del Sancy."
    ],
    "fr": [
      "Nous avons le plaisir de vous accueillir et de vous accompagner dans la préparation de votre séjour et à la découverte du Massif du Sancy."
    ],
    "nl": [
      "Wij ontvangen u graag en helpen u bij de voorbereiding van uw verblijf om het Massif du Sancy te ontdekken."
    ],
    "es": [
      "Nos complace recibirle y ayudarle a preparar su estancia y a descubrir el Macizo del Sancy."
    ]
  },
