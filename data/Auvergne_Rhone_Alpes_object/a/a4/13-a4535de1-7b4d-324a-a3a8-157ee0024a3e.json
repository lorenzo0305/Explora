  "rdfs:comment": {
    "de": [
      "Probieren Sie unsere Burger aus der Region mit 100% lokalem Fleisch.\r\nBurger ... Aber nicht nur! Kebab, Salate und mögliche Neuheiten!\r\nMahlzeiten vor Ort oder zum Mitnehmen."
    ],
    "en": [
      "Come and taste our local burgers with 100% local meat.\r\nBurger... But that's not all! Kebabs, salads, and possible new items!\r\nMeals on site or to take away."
    ],
    "it": [
      "Venite a provare i nostri hamburger locali preparati con carne 100% locale.\r\nHamburger... Ma non è tutto! Kebab, insalate e altre novità!\r\nPasti sul posto o da asporto."
    ],
    "fr": [
      "Venez goûtez nos burgers du terroir avec de la viande 100% locale.\r\nBurger... Mais pas que ! Kebab, salades, et possibles nouveautés !\r\nRepas sur place ou à emporter."
    ],
    "es": [
      "Venga a probar nuestras hamburguesas locales elaboradas con carne 100% local.\r\nHamburguesa... ¡Pero eso no es todo! Brochetas, ensaladas y otras novedades\r\nComidas en el local o para llevar."
    ],
    "nl": [
      "Kom en probeer onze lokale hamburgers, gemaakt van 100% lokaal vlees.\r\nBurger... Maar dat is nog niet alles! Kebab, salades en andere nieuwe producten!\r\nMaaltijden ter plekke of om mee te nemen."
    ]
  },
  "rdfs:label": {
