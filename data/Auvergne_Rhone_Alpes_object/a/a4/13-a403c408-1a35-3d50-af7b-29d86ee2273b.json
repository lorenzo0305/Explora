  "rdfs:comment": {
    "de": [
      "Das 300 m gelegene Dorf Larnas besteht sich aus seinen vier Weilern im Nègue-Tal, ein bezaubernder kleiner Fluss."
    ],
    "en": [
      "The village of Larnas lies at an altitude of 300m and is made up of 4 hamlets in Nègue Valley, an amazing river that has held onto its natural charm."
    ],
    "it": [
      "Situato a 300 metri di altitudine, il villaggio di Larnas è composto da quattro frazioni nella valle della Nègue, un magnifico fiume che ha conservato il suo fascino naturale."
    ],
    "fr": [
      "Situé à 300 mètres d'altitude, le village de Larnas est composé de quatre hameaux dans la vallée de la Nègue, une magnifique rivière qui a gardé un charme naturel."
    ],
    "es": [
      "Situado a 300 metros de altitud, el pueblo de Larnas está formado por cuatro aldeas en el valle del Nègue, un magnífico río que ha conservado su encanto natural."
    ],
    "nl": [
      "Het dorp Larnas ligt op 300 meter hoogte en bestaat uit vier gehuchten in de vallei van de Nègue, een prachtige rivier die zijn natuurlijke charme heeft behouden."
    ]
  },
