  "rdfs:comment": {
    "de": [
      "Eine Mikrobrauerei für Neugierige! La Chouette bietet eine große Auswahl an Bieren, die mit Finesse und einem Schuss Verrücktheit handwerklich gebraut werden, wobei gute, biologische und lokale Rohstoffe bevorzugt werden."
    ],
    "en": [
      "A Microbrewery for the Curious! La Chouette offers a wide variety of beers, brewed artisanally with finesse and a touch of madness, prioritizing high-quality, organic, and local ingredients."
    ],
    "it": [
      "Un microbirrificio per curiosi! La Chouette offre un'ampia gamma di birre, prodotte con metodi tradizionali, con finezza e un tocco di follia, utilizzando solo i migliori ingredienti biologici e locali."
    ],
    "fr": [
      "Une Microbrasserie pour les Curieux ! La Chouette propose une grande variété de bières, brassées de manière artisanale, avec finesse et grain de folie, en privilégiant les bonnes matières premières, bios et locales."
    ],
    "es": [
      "Una microcervecería para curiosos La Chouette ofrece una amplia variedad de cervezas, elaboradas según métodos tradicionales, con delicadeza y un toque de locura, utilizando únicamente los mejores ingredientes ecológicos y locales."
    ],
    "nl": [
      "Een microbrouwerij voor nieuwsgierigen! La Chouette biedt een grote verscheidenheid aan bieren, gebrouwen volgens traditionele methodes, met finesse en een vleugje gekte, met alleen de beste biologische en lokale ingrediënten."
    ]
  },
