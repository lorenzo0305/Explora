  "rdfs:comment": {
    "de": [
      "Lust auf einen Nervenkitzel? Testen oder verschenken Sie ein einzigartiges Erlebnis und ungewöhnliche Momente, in 40 Metern Höhe hängend! Das Banne-Viadukt bietet einen schwindelerregenden Blick auf die Gorges de l'Ardèche und das Ardèche-Plateau!"
    ],
    "en": [
      "Bungee jumping on the bridge of Banne, 40m height."
    ],
    "it": [
      "Siete alla ricerca di un brivido? Provate o regalate un'esperienza unica e momenti insoliti, sospesi a 40 metri di altezza! Il viadotto della Banne offre una vista mozzafiato sulle Gole dell'Ardèche e sull'altopiano dell'Ardèche!"
    ],
    "fr": [
      "Envie de sensations fortes ? Testez ou offrez une expérience unique et des moments insolites, suspendu à 40 mètres de hauteur ! Le viaduc de Banne offre une vue vertigineuse sur les Gorges de l'Ardèche et le plateau ardéchois !"
    ],
    "es": [
      "¿Busca emociones fuertes? Pruebe u ofrezca una experiencia única y momentos insólitos, ¡suspendido a 40 metros de altura! El viaducto de Banne ofrece una vista impresionante de las gargantas del Ardèche y de la meseta del Ardèche"
    ],
    "nl": [
      "Op zoek naar een sensatie? Probeer of bied een unieke ervaring en ongewone momenten, hangend op een hoogte van 40 meter! Het viaduct van Banne biedt een adembenemend uitzicht op de Gorges de l'Ardèche en het plateau van de Ardèche!"
    ]
  },
  "rdfs:label": {
