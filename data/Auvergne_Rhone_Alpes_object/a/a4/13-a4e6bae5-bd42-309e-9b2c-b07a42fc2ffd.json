  "rdfs:comment": {
    "de": [
      "Entdecken Sie den CYCLODEBOUT: ein zu 100 % elektrisches Gelenkdreirad, das im Stehen genutzt werden kann und eine einzigartige Lösung für sanfte Mobilität darstellt. Besuchen Sie unsere Räumlichkeiten, um diese Innovation und ihren Herstellungsprozess kennenzulernen!"
    ],
    "en": [
      "Discover the CYCLODEBOUT: a 100% electric articulated tricycle that can be ridden standing up, a unique soft mobility solution. Come and visit our premises to discover this innovation and its manufacturing process!"
    ],
    "it": [
      "Scoprite il CYCLODEBOUT: un triciclo articolato 100% elettrico che può essere utilizzato in posizione eretta, una soluzione unica di mobilità dolce. Venite a visitare la nostra sede per saperne di più su questa innovazione e sul suo processo di produzione!"
    ],
    "fr": [
      "Découvrez le CYCLODEBOUT : un tricycle articulé 100% électrique, utilisable debout, une solution de mobilité douce unique. Venez visiter nos locaux pour découvrir cette innovation et son processus de fabrication !"
    ],
    "nl": [
      "Ontdek de CYCLODEBOUT: een 100% elektrische gelede driewieler die staand kan worden gebruikt, een unieke oplossing voor zachte mobiliteit. Kom langs om meer te weten te komen over deze innovatie en het fabricageproces!"
    ],
    "es": [
      "Descubra el CYCLODEBOUT: un triciclo articulado 100% eléctrico que puede utilizarse de pie, una solución única de movilidad suave. ¡Venga a visitar nuestras instalaciones para saber más sobre esta innovación y su proceso de fabricación!"
    ]
  },
