  "rdfs:comment": {
    "de": [
      "Besichtigung der Außen- und Innenräume.\r\nDie Landaristokratie wollte sich wieder auf ihrem Land ansiedeln und baute zwischen 1850 und 1890 in großem Stil neue Häuser."
    ],
    "en": [
      "Visit of the exterior on request. From the reign of Napoleon III, the creation of railway lines transformed the balance of the regions of France."
    ],
    "it": [
      "Visitate l'esterno e l'interno.\r\nTra il 1850 e il 1890, l'aristocrazia terriera, desiderosa di reinsediarsi nelle proprie terre, realizzò un grande progetto edilizio, introducendo uno stile completamente nuovo."
    ],
    "fr": [
      "Visite des extérieurs et intérieurs.\r\nDésireuse de se réinstaller sur ses terres, l'aristocratie foncière a accompli, entre 1850 et 1890, un grand travail de construction de demeures, introduisant un style totalement nouveau."
    ],
    "es": [
      "Visita el exterior y el interior.\r\nEntre 1850 y 1890, la aristocracia terrateniente, deseosa de reasentarse en sus tierras, llevó a cabo un importante proyecto de construcción, introduciendo un estilo completamente nuevo."
    ],
    "nl": [
      "Bezoek het exterieur en interieur.\r\nTussen 1850 en 1890 voerde de landadel, die zich graag opnieuw op hun land vestigde, een groot bouwproject uit, waarbij een compleet nieuwe stijl werd geïntroduceerd."
    ]
  },
  "rdfs:label": {
