  "rdfs:comment": {
    "de": [
      "Orbital ist viel mehr als eine einfache Bar. Es ist ein echter Tap Room, in dem man vor Ort gebraute Biere genießt. In diesem großen Raum im Industrie-Look kommt man ohne Krawatte und im Casual-Modus."
    ],
    "en": [
      "Orbital is much more than just a bar. It's a real tap room where you can enjoy beers brewed on the premises. In this large space with an industrial look, you can come without a tie, in casual mode."
    ],
    "it": [
      "Orbital è molto più di un semplice bar. È una vera e propria tap room dove si possono gustare birre prodotte in loco. In questo grande spazio dall'aspetto industriale, si può venire senza cravatta, in modalità casual."
    ],
    "fr": [
      "Orbital, c'est bien plus qu'un simple bar. C'est un véritable tap room où l'on savoure des bières brassées sur place. Dans ce grand espace au look industriel, on y vient sans cravate, en mode décontract'."
    ],
    "nl": [
      "Orbital is veel meer dan alleen een bar. Het is een echte tapkamer waar je kunt genieten van bieren die ter plekke worden gebrouwen. In deze grote ruimte met industriële look kun je zonder stropdas komen, in casual mode."
    ],
    "es": [
      "Orbital es mucho más que un bar. Es una auténtica tap room donde disfrutar de cervezas elaboradas en el propio local. En este gran espacio de aspecto industrial, puedes venir sin corbata, en modo informal."
    ]
  },
  "rdfs:label": {
    "en": [
      "Brasserie Orbital"
    ],
    "fr": [
      "Brasserie Orbital"
    ]
  },
