  "rdfs:comment": {
    "de": [
      "Das Hotel liegt im Zentrum der Stadt, gegenüber der Basilika, und verfügt über 10 Zimmer. Das Restaurant bietet regionale Küche und zahlreiche hausgemachte Spezialitäten, Terrasse vor und neben dem Garten"
    ],
    "en": [
      "Located in the center of town, opposite the Basilica, this hotel has 10 rooms. In the restaurant, regional cuisine and many homemade specialties, Terrace opposite and on the garden side"
    ],
    "it": [
      "Situato nel centro della città, di fronte alla Basilica, questo hotel dispone di 10 camere. Nel ristorante, cucina regionale e molte specialità fatte in casa. Terrazza di fronte e in giardino"
    ],
    "fr": [
      "Établissement situé au centre de la ville, face à la Basilique, cet hôtel compte 10 chambres . Au restaurant, cuisine régionale et nombreuses spécialités maison, Terrasse en face et coté jardin"
    ],
    "es": [
      "Situado en el centro de la ciudad, frente a la Basílica, este hotel dispone de 10 habitaciones. En el restaurante, cocina regional y numerosas especialidades caseras. Terraza enfrente y en el jardín"
    ],
    "nl": [
      "Dit hotel ligt in het centrum van de stad, tegenover de basiliek, en heeft 10 kamers. In het restaurant, regionale keuken en veel huisgemaakte specialiteiten. Terras tegenover en in de tuin"
    ]
  },
