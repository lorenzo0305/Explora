  "rdfs:comment": {
    "de": [
      "Restaurant ? Bar und Unterkünfte im Jordanne-Tal, 10 Minuten von Aurillac entfernt.  Ruhiger und erholsamer Ort am Wasser, Sie können am Seeufer spazieren gehen, inmitten von Chalets, Zigeunerwagen und Pferden."
    ],
    "en": [
      "Restaurant ? bar and lodging located in the Jordanne valley, 10 minutes from Aurillac.  Quiet and restful place at the edge of the water, you can walk along the lake, in the middle of the cottages, caravans and horses."
    ],
    "it": [
      "Ristorante, bar e alloggio nella valle del Jordanne, a 10 minuti da Aurillac.  Luogo tranquillo e rilassante ai bordi dell'acqua, si può passeggiare lungo il lago, in mezzo a casette, roulotte e cavalli."
    ],
    "fr": [
      "Restaurant – bar et hébergements se situant dans la vallée de la Jordanne à 10 minutes d’Aurillac.  Lieu calme et reposant au bord de l’eau, vous pouvez vous promener au bord du lac, au milieu des chalet, roulottes et chevaux."
    ],
    "es": [
      "Restaurante, bar y alojamiento en el valle del Jordanne, a 10 minutos de Aurillac.  Lugar tranquilo y relajante al borde del agua, se puede pasear por el lago, en medio de casas rurales, caravanas y caballos."
    ],
    "nl": [
      "Restaurant ? bar en accommodatie in de Jordanne-vallei, op 10 minuten van Aurillac.  Rustige en ontspannende plek aan de rand van het water, u kunt wandelen langs het meer, te midden van huisjes, caravans en paarden."
    ]
  },
  "rdfs:label": {
