  "rdfs:comment": {
    "de": [
      "Heben Sie mit Aerolift ab! Entdecken Sie in Begleitung eines staatlich geprüften Piloten das Tandem-Gleitschirmfliegen: einfacher Start, komfortabler Flug und atemberaubende Landschaften für ein unvergessliches Flugerlebnis."
    ],
    "en": [
      "Take to the skies with Aerolift! Accompanied by a state-certified pilot, discover tandem paragliding: easy takeoff, comfortable flight and breathtaking scenery for an unforgettable aerial experience."
    ],
    "it": [
      "Prendete il volo con Aerolift! Accompagnati da un pilota qualificato, scoprite il parapendio in tandem: decollo facile, volo confortevole e scenari mozzafiato per un'esperienza aerea indimenticabile."
    ],
    "fr": [
      "Envolez-vous avec Aerolift ! Accompagné d’un pilote diplômé d’État, découvrez le parapente biplace : décollage facile, vol confortable et paysages à couper le souffle pour une expérience aérienne inoubliable."
    ],
    "es": [
      "¡Surque los cielos con Aerolift! Acompañado por un piloto diplomado, descubra el parapente biplaza: despegue fácil, vuelo cómodo y paisajes impresionantes para vivir una experiencia aérea inolvidable."
    ],
    "nl": [
      "Ga de lucht in met Aerolift! Ontdek tandemparagliding onder begeleiding van een gediplomeerde piloot: gemakkelijk opstijgen, comfortabele vlucht en adembenemende landschappen voor een onvergetelijke ervaring in de lucht."
    ]
  },
