  "rdfs:comment": {
    "de": [
      "Die Kirche von Engins wurde zwischen dem Ende des 11. und dem Anfang des 12. Jahrhunderts erbaut und hat fast ein Jahrtausend lang allen Witterungen und Ereignissen standgehalten!"
    ],
    "en": [
      "Built between the late 11th and early 12th centuries, the Engins church has stood the test of time for almost a thousand years!"
    ],
    "it": [
      "Costruita tra la fine dell'XI secolo e l'inizio del XII secolo, la chiesa di Engins ha resistito alla prova del tempo per quasi mille anni!"
    ],
    "fr": [
      "Construite entre la fin du 11e siècle et du début du 12e siècle, l'église d'Engins a résisté aux intempéries et aux événements depuis presque un millénaire !"
    ],
    "nl": [
      "De kerk van Engins is gebouwd tussen het einde van de 11e en het begin van de 12e eeuw en heeft de tand des tijds bijna duizend jaar doorstaan!"
    ],
    "es": [
      "Construida entre finales del siglo XI y principios del XII, la iglesia de Engins ha resistido el paso del tiempo durante casi mil años"
    ]
  },
  "rdfs:label": {
