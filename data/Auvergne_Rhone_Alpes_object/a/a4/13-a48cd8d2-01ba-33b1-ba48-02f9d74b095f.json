  "rdfs:comment": {
    "de": [
      "In der Auvergne bietet die Ferme du Pré Fleuri, ein Bauernhof mit biologischer Landwirtschaft, die Möglichkeit, seine biologischen Produkte und seine hügelige Umgebung bei einem Ausritt mit den Pferden des Hofes im Herzen des regionalen Naturparks Livradois-Forez zu entdecken."
    ],
    "en": [
      "Relaxation, change of scenery in the heart of a real farm Livradois-Forez .... For an authentic break at the Ferme du Pré Fleuri, choose your trailer theme: decoration, theme, colors and soul will make you travel ..."
    ],
    "it": [
      "In Alvernia, La Ferme du Pré Fleuri, un'azienda zootecnica biologica, offre ai visitatori la possibilità di scoprire i suoi prodotti biologici e il suo ambiente collinare durante una passeggiata con i cavalli della fattoria, nel cuore del Parco Naturale Regionale Livradois-Forez."
    ],
    "fr": [
      "En Auvergne, La Ferme du Pré Fleuri, ferme d'élevage en agriculture biologique propose la découverte de ses produits BIO, de son environnement vallonné lors d'une balade avec les chevaux de la ferme, au cœur du Parc naturel régional Livradois-Forez."
    ],
    "nl": [
      "In de Auvergne biedt La Ferme du Pré Fleuri, een biologische veehouderij, bezoekers de kans om de biologische producten en de heuvelachtige omgeving te ontdekken tijdens een rit met de paarden van de boerderij, in het hart van het regionale natuurpark Livradois-Forez."
    ],
    "es": [
      "En Auvernia, La Ferme du Pré Fleuri, ganadería ecológica, ofrece a los visitantes la posibilidad de descubrir sus productos ecológicos y su entorno de colinas en un paseo con los caballos de la granja, en pleno Parque Natural Regional de Livradois-Forez."
    ]
  },
  "rdfs:label": {
    "en": [
      "Les Roulottes de la Ferme du Pré Fleuri"
    ],
    "fr": [
      "La Ferme du Pré Fleuri - Producteur"
    ]
  },
