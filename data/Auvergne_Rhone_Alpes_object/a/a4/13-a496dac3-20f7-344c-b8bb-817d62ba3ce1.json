  "rdfs:comment": {
    "de": [
      "Vom 22. bis 28. August 2026 findet zum 16. Mal das Avoriaz Danse Festival statt! Eine unvergessliche Tanzwoche mit Kursen, Partys und Shows, die von internationalen Lehrern inszeniert werden, im Herzen der Berge."
    ],
    "en": [
      "Join us from August 22 to 28, 2026, for the 16th edition of the Avoriaz Dance Festival! An unforgettable week of dance, with classes, parties, and shows led by international instructors, set in the heart of the mountains."
    ],
    "it": [
      "Unitevi a noi dal 22 al 28 agosto 2026 per il 16° Avoriaz Dance Festival! Una settimana indimenticabile di danza, con lezioni, feste e spettacoli orchestrati da insegnanti internazionali, nel cuore delle montagne."
    ],
    "fr": [
      "Rendez-vous du 22 au 28 août 2026 pour la 16ème édition de l'Avoriaz Danse Festival ! Une semaine inoubliable de danse, avec des cours, des soirées et des shows orchestrés par des professeurs internationaux, au cœur des montagnes."
    ],
    "nl": [
      "Kom van 23 tot 29 augustus 2025 naar de 16e editie van het Avoriaz Dansfestival! Een onvergetelijke week vol dans, met lessen, feestavonden en shows geleid door internationale instructeurs, in het hart van de bergen."
    ],
    "es": [
      "Acompáñenos del 22 al 28 de agosto de 2026 en el 16º Festival de Danza de Avoriaz Una semana inolvidable de baile, con clases, fiestas y espectáculos orquestados por profesores internacionales, en plena montaña."
    ]
  },
