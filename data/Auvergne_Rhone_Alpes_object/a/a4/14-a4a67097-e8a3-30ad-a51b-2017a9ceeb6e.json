  "rdfs:comment": {
    "de": [
      "MOBIL DANCING: Eine kollektive Erfahrung von seltener Intensität, ein Moment des Loslassens wie ein bewusster und spielerischer, gesunder und befreiender Rauschzustand."
    ],
    "en": [
      "MOBIL DANCING: a collective experience of rare intensity, a moment of letting go like a conscious, playful state of intoxication, healthy and liberating."
    ],
    "it": [
      "MOBIL DANCING: un'esperienza collettiva di rara intensità, un momento di abbandono come uno stato di ebbrezza consapevole e giocosa, salutare e liberatoria."
    ],
    "fr": [
      "MOBIL DANCING : une expérience collective d’une rare intensité, un moment de lâcher-prise comme un état d’ivresse conscient et ludique, sain et libérateur."
    ],
    "es": [
      "MOBIL DANCING: una experiencia colectiva de rara intensidad, un momento de dejarse llevar como un estado de embriaguez consciente, lúdico, saludable y liberador."
