  "rdfs:comment": {
    "de": [
      "Der Speisesaal Ihres Campanile-Hotels bietet saisonal wechselnde All-you-can-eat-Buffets (salzig-süß) und einen privaten Salon für Gruppen und Familienessen. Großer Parkplatz, Rasen und geschlossener Bereich."
    ],
    "en": [
      "Your Campanile hotel's restaurant offers all-you-can-eat buffets (salt-sweet) that change with each season and a private lounge to receive groups and family meals. Ample parking, lawn and closed space."
    ],
    "it": [
      "Il ristorante del vostro hotel Campanile offre buffet a volontà (salato-dolce) che cambiano ogni stagione e una sala privata per gruppi e pasti in famiglia. Ampio parcheggio, prato e area recintata."
    ],
    "fr": [
      "La salle de restaurant de votre hôtel Campanile propose des buffets à volonté (salé-sucré) qui changent à chaque saison et salon privé pour recevoir groupes et repas de famille. Vaste parking, pelouse et espace fermé."
    ],
    "nl": [
      "Het restaurant van uw Campanile hotel biedt all-you-can-eat buffetten (hartig-zoet) die elk seizoen veranderen en een privélounge voor groepen en familiemaaltijden. Ruime parkeergelegenheid, gazon en omheind terrein."
    ],
    "es": [
      "El restaurante de su hotel Campanile ofrece buffets (salado-dulce) que cambian cada temporada y un salón privado para grupos y comidas familiares. Amplio aparcamiento, césped y recinto cerrado."
    ]
  },
