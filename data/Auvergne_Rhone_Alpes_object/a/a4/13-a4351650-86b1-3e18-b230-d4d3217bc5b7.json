  "rdfs:comment": {
    "de": [
      "Wanderungen, Trekking, Schneeschuhwanderungen in Tarentaise-Vanoise werden Ihnen angeboten, egal ob Sie mit Ihrer Familie, Ihren Freunden, einem Incentive-Seminar oder einer Gruppe unterwegs sind. Marie-Paule ist auch diplomierte Yogalehrerin."
    ],
    "en": [
      "We offer hiking, trekking and snowshoeing in the Tarentaise-Vanoise region, whether you're with family, friends, an incentive seminar or a group. Marie-Paule is also a qualified yoga teacher."
    ],
    "it": [
      "Escursioni, trekking e ciaspolate nella regione Tarentaise-Vanoise sono tutte proposte, sia che siate in famiglia, con amici, per un seminario incentive o in gruppo. Marie-Paule è anche un'insegnante di yoga qualificata."
    ],
    "fr": [
      "Randonnées, trekking, balades en raquettes à neige en Tarentaise-Vanoise vous sont proposés, que vous soyez en famille, entre amis, en séminaire incentive ou en groupe. Marie-Paule est aussi professeure de yoga diplômée."
    ],
    "nl": [
      "Wandelen en yoga in Tarentaise-Vanoise en Beaufortain."
    ],
    "es": [
      "Senderismo, trekking y paseos con raquetas de nieve por la región de Tarentaise-Vanoise, en familia, con amigos, en un seminario de incentivos o en grupo. Marie-Paule también es profesora titulada de yoga."
    ]
  },
  "rdfs:label": {
