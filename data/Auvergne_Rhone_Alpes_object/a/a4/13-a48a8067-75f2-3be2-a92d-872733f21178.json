  "rdfs:comment": {
    "de": [
      "Spielerischer botanischer Parcours, der zahlreiche katalogisierte Arten zusammenfasst und die Entdeckung der Pflanzen und Früchte des Pilat ermöglicht. Obstpflücken (je nach Saison), Snacks in der Scheune und Direktverkauf."
    ],
    "en": [
      "La Grange is getting a facelift and will reopen its doors this summer 2023.\r\nA fun botanical trail with 200 listed species, allowing the discovery of mountain plants and fruits. Picking, snacks at the farm and direct sales."
    ],
    "it": [
      "Un divertente percorso botanico con numerose specie elencate che permette di scoprire le piante e i frutti del Pilat. Raccolta di frutta (a seconda della stagione), merenda nel fienile e vendita diretta."
    ],
    "fr": [
      "Parcours botanique ludique regroupant de nombreuses espèces répertoriées, permettant la découverte des plantes et fruits du Pilat. Cueillette de fruits (selon la saison), goûters à la grange et vente directe."
    ],
    "es": [
      "Un divertido sendero botánico con numerosas especies catalogadas que permite descubrir las plantas y los frutos del Pilat. Recogida de fruta (según la temporada), aperitivos en el granero y venta directa."
    ],
    "nl": [
      "Een leuk botanisch parcours met talrijke beschermde soorten om de planten en vruchten van het Pilat te ontdekken. Fruit plukken (afhankelijk van het seizoen), snacks in de schuur en rechtstreekse verkoop."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Grange aux Mille Saveurs"
    ]
  },
