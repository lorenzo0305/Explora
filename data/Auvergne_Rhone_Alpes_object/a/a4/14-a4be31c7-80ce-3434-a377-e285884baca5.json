      "@id": "https://data.datatourisme.fr/5feda69b-ed00-33ff-a9c4-b84de361d04e",
      "dc:description": {
        "de": [
          "Informationen :\n\nProdukte: Geschenke und Dekoration\n\nAn welchen Tagen ist das Geschäft geöffnet?\nMontag bis Samstag: 10:00-19:00 Uhr durchgehend\n\nSonntag geschlossen\n\n\n "
        ],
        "en": [
          "Information :\n\nProducts: gifts and home decoration\n\nOpening days:\nMonday to Saturday: 10am-7pm non-stop\n\nClosed on Sunday\n\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nProdotti : Regali e decorazioni\n\nGiorni di apertura:\nDa lunedì a sabato: dalle 10.00 alle 19.00 ininterrottamente\n\nChiuso la domenica\n\n\n "
        ],
        "fr": [
          "Informations :\n\nProduits : cadeaux et décoration\n\nJours d'ouverture:\nDu lundi au samedi: 10h-19h sans interruption\n\nFermeture le dimanche\n\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nProducten : Geschenken en decoratie\n\nOpeningsdagen:\nMaandag tot zaterdag: 10u-19u non-stop\n\nGesloten op zondag\n\n\n "
        ],
        "es": [
          "Más información :\n\nProductos : Regalos y decoración\n\nDías de apertura:\nDe lunes a sábado: de 10.00 a 19.00 h. ininterrumpidamente\n\nDomingo cerrado\n\n\n "
        ]
      },
