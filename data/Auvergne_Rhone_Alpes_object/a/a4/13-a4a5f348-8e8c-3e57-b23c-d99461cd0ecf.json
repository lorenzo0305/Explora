  "rdfs:comment": {
    "de": [
      "Unsere traditionsreiche französische Küche bietet Ihnen eine Vielfalt an köstlichen und frisch zubereiteten Speisen. Das Salatbuffet und die hausgemachte Küche werden jeden begeistern. N"
    ],
    "en": [
      "Our traditional French cuisine offers a variety of delicious, freshly prepared dishes. The salad buffet and homemade cuisine are sure to please everyone. N"
    ],
    "it": [
      "La nostra cucina tradizionale francese offre una varietà di piatti deliziosi e preparati al momento. Il buffet di insalate e la cucina casalinga sono in grado di soddisfare tutti. N"
    ],
    "fr": [
      "Notre cuisine française riche en traditions vous offre une variété de mets délicieux et fraîchement préparés. Le buffet de salades et la cuisine faite maison feront plaisir à tout le monde. N"
    ],
    "nl": [
      "Onze traditionele Franse keuken biedt een verscheidenheid aan heerlijke, vers bereide gerechten. Het saladebuffet en de huisgemaakte gerechten vallen bij iedereen in de smaak. N"
    ],
    "es": [
      "Nuestra cocina tradicional francesa ofrece una variedad de deliciosos platos recién preparados. El bufé de ensaladas y la cocina casera harán las delicias de todos. N"
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'Epicerie"
    ]
  },
