  "rdfs:comment": {
    "de": [
      "Tauchen Sie ein in das faszinierende Epos der Götter und Helden auf einem Rundgang durch die gallo-römischen Ruinen Wiens, wo jeder Stein von einer mythischen Vergangenheit flüstert."
    ],
    "en": [
      "Immerse yourself in the fascinating epic of gods and heroes on a guided tour of Vienna?s Gallo-Roman remains, where every stone whispers tales of a mythical past."
    ],
    "it": [
      "Immergetevi nell'affascinante saga di dei ed eroi durante una visita guidata ai resti gallo-romani di Vienna, dove ogni pietra sussurra storie di un passato mitico."
    ],
    "fr": [
      "Plongez dans l’épopée fascinante des dieux et des héros lors d’une visite contée au cœur des vestiges gallo-romains de Vienne, où chaque pierre murmure les récits d’un passé mythique."
    ],
    "es": [
      "Sumérjase en la fascinante saga de dioses y héroes en una visita guiada por los vestigios galo-romanos de Viena, donde cada piedra susurra historias de un pasado mítico."
    ],
    "nl": [
      "Dompel jezelf onder in de fascinerende saga van goden en helden tijdens een rondleiding door de Gallo-Romeinse overblijfselen in Wenen, waar elke steen verhalen vertelt over een mythisch verleden."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La visite contée de Ludivine : De Vienna à l'Olympe"
    ]
  },
