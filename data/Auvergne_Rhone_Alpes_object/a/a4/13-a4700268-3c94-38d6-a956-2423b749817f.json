  "rdfs:comment": {
    "de": [
      "Neues Restaurant, das traditionelle Küche und Spezialitäten aus Savoyen anbietet. Gemütliches und warmes Ambiente.\r\nWir kochen mit frischen, lokalen und qualitativ hochwertigen Produkten."
    ],
    "en": [
      "New restaurant offering traditional cuisine and Savoyard specialties. Cosy, warm atmosphere.\r\nWe cook with fresh, local, quality produce."
    ],
    "it": [
      "Nuovo ristorante con cucina tradizionale e specialità savoiarde. Atmosfera accogliente e calorosa.\r\nCuciniamo con prodotti freschi, locali e di qualità."
    ],
    "fr": [
      "Nouveau restaurant proposant de la cuisine traditionnelle et des spécialités savoyardes. Ambiance cosy et chaleureuse. \r\nNous cuisinons avec des produits frais, locaux et de qualité."
    ],
    "es": [
      "Nuevo restaurante de cocina tradicional y especialidades saboyanas. Ambiente acogedor y cálido.\r\nCocinamos con productos frescos, locales y de calidad."
    ],
    "nl": [
      "Nieuw restaurant met traditionele keuken en specialiteiten uit de Savoie. Gezellige, warme sfeer.\r\nWe koken met verse, lokale kwaliteitsproducten."
    ]
