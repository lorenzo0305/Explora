  "rdfs:comment": {
    "de": [
      "Fahrradkurs für Erwachsene. Praktische und theoretische Sitzungen, um wieder Vertrauen zum Fahrradfahren zu gewinnen. Kostenlos unter bestimmten Bedingungen. Kontaktieren Sie uns, um zu sehen, ob Sie dafür in Frage kommen."
    ],
    "en": [
      "Cycling course for adults. Practical and theoretical sessions to regain confidence on the bike. Free under certain conditions. Contact us to see if you qualify."
    ],
    "it": [
      "Corso di ciclismo per adulti. Sessioni pratiche e teoriche per aiutarvi a riprendere confidenza con la bicicletta. Gratuito a determinate condizioni. Contattateci per sapere se siete idonei."
    ],
    "fr": [
      "Stage vélo pour adultes. Séances pratiques et théoriques pour reprendre confiance à vélo. Gratuit sous conditions. Contactez-nous pour voir si vous êtes éligible."
    ],
    "nl": [
      "Fietscursus voor volwassenen. Praktische en theoretische sessies om je vertrouwen op de fiets te herwinnen. Gratis onder bepaalde voorwaarden. Neem contact met ons op om te zien of je in aanmerking komt."
    ],
    "es": [
      "Curso de ciclismo para adultos. Sesiones prácticas y teóricas para recuperar la confianza en la bicicleta. Gratuito en determinadas condiciones. Póngase en contacto con nosotros para saber si cumple los requisitos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Stage vélo adulte : remise en selle"
    ]
  },
