  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/69a5e1ee-b34b-3aa6-a8a0-36376c51d9bd",
      "dc:description": {
        "de": [
          "Boutique für Dekoration, Kunsthandwerk und Trödel\nIn einem Gewölbekeller aus dem 18. Jahrhundert, in der Nähe des grünen Parks des Schlosses von Conteval."
        ],
        "en": [
          "Decoration, arts and crafts and antiques store\nIn a vaulted cellar dating from the 18th century, nestled in the lush greenery of the Parc du Château de Conteval."
        ],
        "it": [
          "Negozio di arti decorative, artigianato e antiquariato\nIn una cantina a volta del XVIII secolo, immersa nel verde del Parc du Château de Conteval."
        ],
        "fr": [
          "Boutique de décoration, d'artisanat d'art et de brocante\nDans une cave voutée datant du XVIII ème siècle, nichée à proximité du cadre verdoyant du Parc du Château de Conteval."
        ],
        "es": [
          "Tienda de artesanía decorativa y antigüedades\nEn una bodega abovedada del siglo XVIII, enclavada en los verdes terrenos del Parque del Castillo de Conteval."
        ],
        "nl": [
          "Kunstnijverheid en antiekwinkel\nIn een gewelfde kelder uit de 18e eeuw, genesteld in het weelderige groen van het Parc du Château de Conteval."
        ]
      },
