  "rdfs:comment": {
    "de": [
      "Sie suchen ein authentisches Reiseziel für Ihren Winterurlaub? Einen Ort, an dem Authentizität mit Austausch, Wohlbefinden und Begegnung einhergeht? Suchen Sie nicht weiter, dann sind Sie im Hôtel le Chamois d'Or, USSIM Vacances, am richtigen Ort."
    ],
    "en": [
      "Are you looking for an authentic destination for your winter vacations? A place where authenticity rhymes with sharing, well-being and encounters? Look no further than Hôtel le Chamois d'Or, USSIM Vacances."
    ],
    "it": [
      "Siete alla ricerca di una destinazione autentica per le vostre vacanze invernali? Un luogo dove autenticità fa rima con condivisione, benessere e incontro con nuove persone? Allora non cercate altro che l'Hôtel le Chamois d'Or, USSIM Vacances."
    ],
    "fr": [
      "Vous cherchez une destination authentique pour vos vacances d’hiver ? Un espace où authenticité rime avec partage, bien-être et rencontre ? Ne cherchez plus, vous êtes au bon endroit  à l'Hôtel le Chamois d'Or, USSIM Vacances."
    ],
    "es": [
      "¿Busca un destino auténtico para sus vacaciones de invierno? ¿Un lugar donde autenticidad rime con compartir, bienestar y conocer gente nueva? Entonces no busque más: Hôtel le Chamois d'Or, USSIM Vacances."
    ],
    "nl": [
      "Bent u op zoek naar een authentieke bestemming voor uw wintervakantie? Een plek waar authenticiteit samengaat met delen, welzijn en mensen ontmoeten? Zoek niet verder, u bent bij het hotel Chamois d'Or in Méribel aan het juiste adres."
    ]
  },
