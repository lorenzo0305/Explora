  "rdfs:comment": {
    "de": [
      "Verleih von Elektrofahrrädern für einen halben Tag, einen ganzen Tag oder + auf Anfrage. Es besteht die Möglichkeit, einen XLC Duo-Anhänger und/oder einen zusätzlichen Akku zu mieten.\r\nFahrräder mit Fahrradcomputer, Reparaturset und Helmen."
    ],
    "en": [
      "E-Bike hire for half a day, a full day or more on request...\r\nAn XLC Duo trailer and/or an extra battery are also available to hire. \r\nOur bikes come with a timer, a repair kit and a helmet."
    ],
    "it": [
      "Noleggio di biciclette elettriche per mezza giornata, una giornata o più su richiesta. Possibilità di noleggiare un rimorchio XLC Duo e/o una batteria supplementare.\r\nBiciclette dotate di parchimetro, kit di riparazione e caschi."
    ],
    "fr": [
      "Location de vélos électriques à la demi-journée, à la journée ou + sur demande. Possibilité de louer une remorque XLC Duo et/ou une batterie supplémentaire.\r\nVélos équipés d'un compteur, d'un kit de réparation et de casques."
    ],
    "nl": [
      "Fietsenverhuur voor een halve of hele dag of langer op aanvraag. Mogelijkheid om een aanhanger XLC Duo en/of extra accu te huren.\r\nFietsen met kilometerteller, reparatiesetje en helm."
    ],
    "es": [
      "Alquiler de bicicletas eléctricas para medio día, un día o más previa solicitud. Posibilidad de alquilar un remolque XLC Duo y/o una batería adicional.\r\nBicicletas equipadas con contador, kit de reparación y cascos."
    ]
  },
  "rdfs:label": {
    "de": [
