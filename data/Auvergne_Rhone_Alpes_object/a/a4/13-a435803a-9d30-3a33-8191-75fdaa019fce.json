  "rdfs:comment": {
    "de": [
      "Am Fuße des Nationalparks Vanoise, im Herzen einer geschützten Naturlandschaft, ist diese symbolträchtige Adresse ein unumgänglicher Treffpunkt für Angler, Wanderer, Spaziergänger und Bergliebhaber."
    ],
    "en": [
      "Nestled at the foot of the Vanoise National Park, in the heart of a preserved natural site, this emblematic address remains a must for fishermen, hikers, walkers and mountain lovers."
    ],
    "it": [
      "Situato ai piedi del Parco Nazionale della Vanoise, nel cuore di una natura incontaminata, questo indirizzo iconico rimane un must per pescatori, escursionisti, camminatori e amanti della montagna."
    ],
    "fr": [
      "Nichée au pied du parc national de la Vanoise, au cœur d’un site naturel préservé, cette adresse emblématique reste le rendez-vous incontournable des pêcheurs, randonneurs, des promeneurs et des amoureux de la montagne."
    ],
    "nl": [
      "Genesteld aan de voet van het Vanoise National Park, in het hart van een ongerepte natuurlijke omgeving, blijft dit iconische adres een must voor vissers, wandelaars en bergliefhebbers."
    ],
    "es": [
      "Enclavado a los pies del Parque Nacional de la Vanoise, en el corazón de un entorno natural intacto, este lugar emblemático sigue siendo una visita obligada para pescadores, excursionistas, senderistas y amantes de la montaña."
    ]
  },
