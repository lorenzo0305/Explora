  "rdfs:comment": {
    "de": [
      "Das Museum der \"Amis du Vieux Donzère\" ist in einem der wenigen Häuser der Grande Rue untergebracht, die ihre schönen Renaissancefassaden bewahrt haben. Es zeigt die Geschichte der Gemeinde von ihren Ursprüngen bis heute."
    ],
    "en": [
      "Housed in one of the few houses on the Grande Rue to have kept its beautiful Renaissance facades, the Musée des Amis du Vieux Donzère presents the history of the town from its origins to the present day."
    ],
    "it": [
      "Ospitato in una delle poche case della Grande Rue che hanno conservato le loro belle facciate rinascimentali, il Museo degli \"Amici della Vecchia Donzère\" presenta la storia della città dalle origini ai giorni nostri."
    ],
    "fr": [
      "Installé dans une des rares maisons de la Grande rue ayant gardé leurs belles façades Renaissance, le Musée des « Amis du Vieux Donzère » présente l’histoire de la commune depuis ses origines jusqu’à nos jours."
    ],
    "es": [
      "Instalado en una de las pocas casas de la Grande Rue que conservan sus bellas fachadas renacentistas, el Museo de los \"Amigos del Viejo Donzère\" presenta la historia de la ciudad desde sus orígenes hasta la actualidad."
    ],
    "nl": [
      "Het museum van de \"Vrienden van Vieux Donzère\" is gevestigd in een van de weinige huizen in de Grande Rue waarvan de mooie renaissancegevels bewaard zijn gebleven en toont de geschiedenis van de stad vanaf het ontstaan tot nu."
    ]
  },
