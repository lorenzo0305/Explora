  "rdfs:comment": {
    "de": [
      "Anna Puig Rosado, Fotoreporterin, empfängt Sie das ganze Jahr über in ihrem Atelier Bildo, das der Fotografie gewidmet ist. Sie leitet dort spielerische und kreative Fotoworkshops und -wanderungen für Erwachsene und Jugendliche!"
    ],
    "en": [
      "Anna Puig Rosado welcomes you all year long in her Bildo workshop dedicated to photography. She organizes creative and playful workshops for kids and adults!"
    ],
    "it": [
      "Anna Puig Rosado, fotoreporter, vi accoglie tutto l'anno nel suo Bildo Workshop dedicato alla fotografia. Tiene workshop fotografici ed escursioni divertenti e creative per adulti e ragazzi!"
    ],
    "fr": [
      "Anna Puig Rosado, reporter photographe,  vous accueille toute l’année dans son Atelier Bildo dédié à la photographie. Elle y anime des  stages et randos photos, ludiques et créatifs pour adultes et juniors !"
    ],
    "es": [
      "Anna Puig Rosado, reportera gráfica, te da la bienvenida durante todo el año a su Taller Bildo dedicado a la fotografía. Dirige divertidos y creativos talleres de fotografía y excursiones para adultos y jóvenes"
    ],
    "nl": [
      "Anna Puig Rosado, fotoreporter, verwelkomt je het hele jaar door in haar Atelier Bildo, gewijd aan fotografie. Ze organiseert leuke, creatieve fotocursussen en wandeltochten voor volwassenen en junioren!"
    ]
  },
