  "rdfs:comment": {
    "de": [
      "Das Gourmet-Hotel und -Restaurant Le Carré d'Alethius liegt in einem charmanten mittelalterlichen Dorf in der Ardèche. Im Sommer können Sie den Innenhof nutzen, um die Küche des mit einem MICHELIN-Stern ausgezeichneten Küchenchefs Olivier SAMIN zu genießen."
    ],
    "en": [
      "Le Carré d’Aléthius is a calm, relaxing hotel-restaurant in a charming medieval village in Ardèche. Enjoy dishes by Michelin-starred chef Olivier Samin out on the patio in summer."
    ],
    "it": [
      "Situato in un incantevole villaggio medievale dell'Ardèche, l'hotel-ristorante gourmet Carré d'Alethius è un'oasi di pace. In estate, potrete approfittare del patio per assaporare la cucina dello chef stellato Olivier SAMIN."
    ],
    "fr": [
      "Situé dans un charmant village médiéval d'Ardèche, l'hôtel-restaurant gastronomique le Carré d'Alethius est un véritable havre de paix. Vous pourrez l'été, profiter du patio pour savourer la cuisine du chef Olivier SAMIN étoilé au Guide MICHELIN."
    ],
    "es": [
      "Situado en un encantador pueblo medieval de Ardèche, el hotel-restaurante gastronómico Carré d'Alethius es un remanso de paz. En verano, puede aprovechar el patio para saborear la cocina del chef Olivier SAMIN, galardonado con una estrella MICHELIN."
    ],
    "nl": [
      "Het gastronomische hotel-restaurant Carré d'Alethius, gelegen in een charmant middeleeuws dorpje in de Ardèche, is een oase van rust. In de zomer kun je op het terras genieten van de keuken van de met een Michelin-ster bekroonde chef Olivier SAMIN."
    ]
  },
