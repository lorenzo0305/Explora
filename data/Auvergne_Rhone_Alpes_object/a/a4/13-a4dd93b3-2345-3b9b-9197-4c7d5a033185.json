  "rdfs:comment": {
    "de": [
      "Das Oasis café restaurant bietet Ihnen eine große Auswahl an Speisen vor Ort, zum Mitnehmen oder sogar nach Hause geliefert, sowie Kaffee und Erfrischungsgetränke von morgens bis abends."
    ],
    "en": [
      "Oasis Café Restaurant offers a wide choice of on-site dining, take-out or even delivered at home as well as coffees and cool drinks from morning to evening."
    ],
    "it": [
      "Il ristorante-caffetteria L'Oasis offre un'ampia scelta di catering in loco, da asporto e con consegna a domicilio, oltre a caffè e bevande fredde dalla mattina alla sera."
    ],
    "fr": [
      "L'Oasis café restaurant vous propose un large choix de restauration sur place, à emporter ou même livré à domicile, ainsi que cafés et boissons fraîches du matin jusqu'au soir."
    ],
    "nl": [
      "L'Oasis café-restaurant biedt een ruime keuze aan catering op locatie, afhaalmaaltijden en thuisbezorging, evenals koffie en koude dranken van 's ochtends vroeg tot 's avonds laat."
    ],
    "es": [
      "El restaurante Oasis café ofrece una amplia selección de restaurantes, comidas para llevar o incluso en casa, así como cafés y bebidas frescas de la mañana a la noche."
    ]
  },
  "rdfs:label": {
    "en": [
      "L'Oasis Café Restaurant"
    ],
