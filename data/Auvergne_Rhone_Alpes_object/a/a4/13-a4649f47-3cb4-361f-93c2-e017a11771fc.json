  "rdfs:comment": {
    "de": [
      "Mamija lädt Sie zu einer kulinarischen Reise ein, die Ihr Herz erwärmt und Erinnerungen weckt. Hier dreht sich alles um leckere Braseros, lokale Produkte und Rezepte aus unserer Kindheit, die mit Sorgfalt neu interpretiert werden."
    ],
    "en": [
      "At Mamija, we invite you on a culinary journey that warms the heart and awakens memories. Here, everything revolves around gourmet braziers, local produce and recipes from our childhood, revisited with care."
    ],
    "it": [
      "Al Mamija vi invitiamo a un viaggio culinario che vi scalderà il cuore e risveglierà i vostri ricordi. Qui tutto ruota attorno a bracieri gourmet, prodotti locali e ricette della nostra infanzia, rivisitate con cura."
    ],
    "fr": [
      "Chez Mamija, on vous invite à un voyage culinaire qui réchauffe le cœur et réveille les souvenirs. Ici, tout tourne autour de braseros gourmands, de produits locaux, et des recettes de notre enfance, revisitées avec soin."
    ],
    "es": [
      "En Mamija, le invitamos a un viaje culinario que le calentará el corazón y despertará sus recuerdos. Aquí, todo gira en torno a braseros gourmet, productos locales y recetas de nuestra infancia, revisitadas con mimo."
    ],
    "nl": [
      "Bij Mamija nodigen we je uit voor een culinaire reis die je hart zal verwarmen en je herinneringen zal doen ontwaken. Hier draait alles om gastronomische vuurpotten, lokale producten en recepten uit onze kindertijd die met zorg opnieuw worden samengesteld."
    ]
  },
  "rdfs:label": {
    "fr": [
