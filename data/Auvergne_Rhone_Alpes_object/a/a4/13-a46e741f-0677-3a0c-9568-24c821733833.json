  "rdfs:comment": {
    "de": [
      "Bewegen Sie sich mithilfe Ihrer Karte durch das Dorf Mens, um die Markierungen zu entdecken, die in der Nähe von historischen Orten angebracht wurden."
    ],
    "en": [
      "With the help of your map, move around the heart of the village of Mens to discover the markers that have been installed near the historical sites."
    ],
    "it": [
      "Con l'aiuto della vostra mappa, muovetevi nel cuore del villaggio di Mens per scoprire i segnalatori installati vicino ai siti storici."
    ],
    "fr": [
      "A l'aide de votre carte, déplacez-vous au cœur de la village de Mens pour découvrir les balises qui ont été installées à proximité des lieux historiques."
    ],
    "nl": [
      "Ga met behulp van uw kaart door het dorp Mens om de markeringen te ontdekken die bij de historische plaatsen zijn aangebracht."
    ],
    "es": [
      "Con la ayuda de su mapa, muévase por el corazón del pueblo de Mens para descubrir los marcadores que se han instalado cerca de los lugares históricos."
    ]
  },
  "rdfs:label": {
    "fr": [
