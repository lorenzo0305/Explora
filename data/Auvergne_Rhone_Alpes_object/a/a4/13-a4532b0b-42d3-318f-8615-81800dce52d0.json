  "rdfs:comment": {
    "de": [
      "Entdecken Sie die 44. Ausgabe des Internationalen Schneeskulpturenwettbewerbs!  Seien Sie bei diesem international anerkannten Ereignis dabei!\r\nEs ist erstaunlich zu entdecken, wie sich einfache Schneeblöcke in monumentale Skulpturen verwandeln können."
    ],
    "en": [
      "Discover the 44th edition of the International Snow Sculpture Competition!  Attend this internationally renowned event!\nIt's amazing to discover how simple blocks of snow can be transformed into monumental sculptures."
    ],
    "it": [
      "Scoprite la 44ª edizione del Concorso Internazionale di Sculture di Neve!  Partecipate a questo evento di fama internazionale!\nÈ sorprendente scoprire come semplici blocchi di neve possano essere trasformati in sculture monumentali."
    ],
    "fr": [
      "Découvrez la 44e édition du Concours International de Sculptures sur Neige !  Assistez à cet événement de renommée internationale !\r\nIl est surprenant de découvrir comment de simples blocs de neige peuvent se transformer en sculptures monumentales."
    ],
    "es": [
      "¡Descubra la 44ª edición del Concurso Internacional de Escultura de Nieve!  ¡Asista a este evento de renombre internacional!\r\nEs increíble descubrir cómo simples bloques de nieve pueden transformarse en esculturas monumentales."
    ],
    "nl": [
      "Ontdek de 44e editie van de Internationale wedstrijd voor sneeuwsculpturen!  Woon dit internationaal gerenommeerde evenement bij!\nHet is verbazingwekkend om te ontdekken hoe eenvoudige blokken sneeuw kunnen worden omgetoverd tot monumentale sculpturen."
    ]
  },
  "rdfs:label": {
    "en": [
