  "rdfs:comment": {
    "de": [
      "An der Ankunft der Seilbahn des Mont d'Arbois, gegenüber dem Mont Blanc und neben dem Kinderspielplatz. Kleine Verpflegung in Form von Take-away oder Selbstbedienung."
    ],
    "en": [
      "Take away food at the top of the Mont d'Arbois cable car."
    ],
    "it": [
      "All’arrivo della funivia del Mont d’Arbois. Piccola ristorazione sotto forma di vendita al dettaglio."
    ],
    "fr": [
      "A l'arrivée de la télécabine du Mont d'Arbois, face au Mont Blanc et à côté de l'aire de jeu pour les enfants. Petite restauration sous forme de vente à emporter ou self."
    ],
    "nl": [
      "Bij de aankomst van de Mont d'Arbois kabelbaan, met uitzicht op de Mont Blanc en naast de speeltuin. Afhaalmaaltijden en zelfbediening beschikbaar."
    ],
    "es": [
      "A la llegada del teleférico del Mont d'Arbois, frente al Mont Blanc y junto a la zona de juegos infantiles. Comida para llevar y autoservicio disponibles."
    ]
  },
