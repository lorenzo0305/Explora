  "rdfs:comment": {
    "de": [
      "Für Ihre Bestellungen von Konditoreiwaren, Kuchen und Gebäck.\r\nFinden Sie unsere Leckereien auch auf dem Markt in Craponne am Samstagmorgen und in Le Bancal in Craponne, dienstags bis donnerstags von 10 bis 19 Uhr."
    ],
    "en": [
      "For your orders of pastries, cakes and viennoiseries.\r\nYou can also find our delicacies at the Craponne market on Saturday mornings and at the Bancal in Craponne, Tuesday to Thursday, 10am to 7pm."
    ],
    "it": [
      "Per i vostri ordini di dolci, torte e pasticcini.\r\nPotete trovare le nostre prelibatezze anche al mercato di Craponne il sabato mattina e al Bancal di Craponne, dal martedì al giovedì dalle 10.00 alle 19.00."
    ],
    "fr": [
      "Pour vos commandes de pâtisserie, gâteaux et viennoiseries.\r\nRetrouvez également nos gourmandises sur le marché de Craponne le samedi matin et au Bancal à Craponne, du mardi au jeudi de 10h à 19h."
    ],
    "nl": [
      "Voor uw bestellingen van gebak, cake en gebak.\r\nJe kunt onze lekkernijen ook vinden op de markt van Craponne op zaterdagochtend en in de Bancal in Craponne, van dinsdag tot donderdag van 10.00 tot 19.00 uur."
    ],
    "es": [
      "Para sus pedidos de pasteles, tartas y bollería.\r\nTambién puede encontrar nuestras delicias en el mercado de Craponne los sábados por la mañana y en el Bancal de Craponne, de martes a jueves de 10:00 a 19:00."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Baptiste Blanc Ethicurien"
    ]
  },
