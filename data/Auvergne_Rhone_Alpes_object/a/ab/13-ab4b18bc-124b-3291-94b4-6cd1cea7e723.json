  "rdfs:comment": {
    "de": [
      "Im Restaurant des Tourmaline Hôtel &amp; Spa, Les Airelles, serviert Ihnen der Chefkoch eine neu interpretierte regionale Küche mit bäuerlichen Akzenten, die auf lokale und saisonale Produkte setzt und eine große Auswahl an Savoyer Spezialitäten bietet."
    ],
    "en": [
      "In Les Airelles, the restaurant of La Tourmaline Hotel & Spa, the chef proposes new versions of local cuisine with a country flavour, making the most of local and seasonal products, as well as a large selection of Savoyard specialities."
    ],
    "it": [
      "Nel ristorante del Tourmaline Hotel & Spa, Les Airelles, lo chef vi propone una cucina locale rivisitata con un tocco contadino, che privilegia i prodotti locali e di stagione e un'ampia selezione di specialità savoiarde."
    ],
    "fr": [
      "Au restaurant de la Tourmaline Hôtel & Spa, Les Airelles, le chef vous propose une cuisine du terroir revisitée aux accents paysans qui fait la part belle aux produits locaux et de saison et une large sélection de spécialités savoyardes."
    ],
    "nl": [
      "In het restaurant van Tourmaline Hôtel & Spa, Les Airelles, biedt de chef u een herontdekte lokale keuken met een boers tintje, met aandacht voor lokale en seizoensgebonden producten en een ruime keuze aan Savoyaardse specialiteiten."
    ],
    "es": [
      "En el restaurante del Tourmaline Hotel & Spa, Les Airelles, el chef le ofrece una cocina local revisitada con un toque campesino, que da protagonismo a los productos locales y de temporada y a una amplia selección de especialidades saboyanas."
    ]
  },
