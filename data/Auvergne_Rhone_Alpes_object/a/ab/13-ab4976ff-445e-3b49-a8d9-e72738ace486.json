  "rdfs:comment": {
    "de": [
      "Genießen Sie eine bukolische Pause am Fuße von Saint-Antoine-l'Abbaye auf der angenehmen schattigen Terrasse dieses Bar-Restaurants, das auf Fleisch, Salate und Gegrilltes spezialisiert ist. Eine großzügige Küche und ein großzügiger Empfang!"
    ],
    "en": [
      "Enjoy a bucolic break at the foot of Saint-Antoine-l'Abbaye on the pleasant shaded terrace of this bar-restaurant specializing in meat, salads and grilled meats. Generous cuisine and a warm welcome!"
    ],
    "it": [
      "Concedetevi una pausa bucolica ai piedi di Saint-Antoine-l'Abbaye sulla piacevole terrazza ombreggiata di questo bar-ristorante specializzato in carne, insalate e grigliate. Cibo abbondante e accoglienza calorosa!"
    ],
    "fr": [
      "Venez profiter d'une pause bucolique au pied de Saint-Antoine-l'Abbaye sur l'agréable terrasse ombragée de ce bar-restaurant spécialisé dans la viande, les salades et les grillades. Une cuisine et un accueil généreux !"
    ],
    "nl": [
      "Geniet van een landelijke pauze aan de voet van Saint-Antoine-l'Abbaye op het aangename schaduwrijke terras van dit bar-restaurant dat gespecialiseerd is in vlees, salades en gegrild vlees. Royaal eten en een warm welkom!"
    ],
    "es": [
      "Disfrute de una pausa bucólica a los pies de Saint-Antoine-l'Abbaye en la agradable terraza sombreada de este bar-restaurante especializado en carnes, ensaladas y carnes a la brasa. Comida generosa y cálida bienvenida"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Mon Manège à Moi"
    ]
  },
