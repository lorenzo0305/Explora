  "rdfs:comment": {
    "de": [
      "Die Berge werden bei einem Fondue geteilt. Eine schicke Berghütte, in der der Käse mit einem Lächeln und der guten Laune der Berggipfel genossen wird."
    ],
    "en": [
      "The mountains are shared over a fondue. A chic refuge where cheese is enjoyed with a smile and the good humor of the summits."
    ],
    "it": [
      "Le montagne sono da condividere davanti a una fonduta. Un rifugio chic dove il formaggio viene gustato con il sorriso e il buon umore delle vette."
    ],
    "fr": [
      "La montagne se partage autour d’une fondue. Un refuge chic où le fromage se déguste avec le sourire et la bonne humeur des sommets."
    ],
    "es": [
      "Las montañas son suyas para compartirlas con una fondue. Un refugio chic donde el queso se disfruta con una sonrisa y el buen humor de las cumbres."
    ],
    "nl": [
      "Deel de bergen onder het genot van een fondue. Een chique toevluchtsoord waar kaas wordt gegeten met een glimlach en het goede humeur van de bergtoppen."
    ]
  },
