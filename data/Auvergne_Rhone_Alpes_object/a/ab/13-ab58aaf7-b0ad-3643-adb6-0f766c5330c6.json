  "rdfs:comment": {
    "de": [
      "Das CNCS ist die erste Konservierungsstruktur, die sich dem materiellen Erbe der Theater widmet, und verfügt über eine prestigeträchtige Sammlung von etwa 10 000 Kostümen. Es lässt das Know-how in den Bereichen Textilien und Bühnenbild strahlen."
    ],
    "en": [
      "The National Center of Stage Costume is the first preservation structure, in France and abroad, to be entirely dedicated to the material heritage of theaters.\r\nTwice a year, exhibitions enhance this heritage collection of 10,000 theater, opera and ballet costumes."
    ],
    "it": [
      "Il CNCS è la prima struttura di conservazione dedicata al patrimonio materiale dei teatri, possiede prestigiose collezioni di circa 10.000 costumi e promuove il know-how tessile e scenografico."
    ],
    "fr": [
      "Première structure de conservation consacrée au patrimoine matériel des théâtres et doté de collections prestigieuses constituées d'environ 10 000 costumes, le CNCS fait rayonner les savoir-faire textiles et scénographiques."
    ],
    "nl": [
      "Het CNCS is de eerste conserveringsstructuur gewijd aan het materiële erfgoed van theaters en beschikt over prestigieuze collecties van ongeveer 10.000 kostuums. Het bevordert de textiel- en scenografische knowhow."
    ],
    "es": [
      "El CNCS es la primera estructura de conservación dedicada al patrimonio material de los teatros y cuenta con prestigiosas colecciones de unos 10.000 trajes. Promueve los conocimientos textiles y escenográficos."
    ]
  },
  "rdfs:label": {
