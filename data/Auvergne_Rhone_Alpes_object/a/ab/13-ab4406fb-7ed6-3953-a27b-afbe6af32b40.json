  "rdfs:comment": {
    "de": [
      "Als Zusammenschluss von Bergprofis steht Ihnen das professionelle Team von Rêve de Cîmes zur Verfügung, um Ihnen die Aktivitäten Klettern, Via Ferrata, Canyoning, Wandern und Höhlenforschung näher zu bringen."
    ],
    "en": [
      "As a group of professional mountain experts, we are ready to help you explore this magnificent region in both summer and winter through a range of fun, sporting activities in the great outdoors, such as climbing, canyoning and snowshoeing."
    ],
    "it": [
      "Un gruppo di professionisti della montagna, il team di Rêve de Cîmes, è a disposizione per aiutarvi a scoprire l'arrampicata, la via ferrata, il canyoning, l'escursionismo e la speleologia."
    ],
    "fr": [
      "Groupement de professionnels de la montagne, l'équipe de professionnels de Rêve de Cîmes est  à votre disposition pour vous faire découvrir les activités escalade, via ferrata, canyoning, randonnée et spéléologie."
    ],
    "nl": [
      "Het team van Rêve de Cîmes, een groep bergprofessionals, staat klaar om je te helpen bij het ontdekken van klimmen, via ferrata, canyoning, wandelen en speleologie."
    ],
    "es": [
      "El equipo de Rêve de Cîmes, formado por profesionales de la montaña, le ayudará a descubrir la escalada, la vía ferrata, el barranquismo, el senderismo y la espeleología."
    ]
  },
  "rdfs:label": {
