  "rdfs:comment": {
    "de": [
      "Die 1963 erbaute Kirche Sacré-C?ur de Mosinges begleitet die Gründung einer neuen Pfarrei in Cran-Gevrier. Mit kostengünstigen Materialien gelang es den Architekten Maurice Novarina und Claude Fay, ein ästhetisches Gebäude zu entwerfen."
    ],
    "en": [
      "The Sacré-C?ur church in Mosinges was built in 1963 to accompany the foundation of a new parish in Cran-Gevrier. Using economical materials, architects Maurice Novarina and Claude Fay succeeded in designing an aesthetically pleasing edifice."
    ],
    "it": [
      "La chiesa del Sacro Cuore di Mosinges fu costruita nel 1963 per accompagnare la fondazione di una nuova parrocchia a Cran-Gevrier. Utilizzando materiali economici, gli architetti Maurice Novarina e Claude Fay riuscirono a progettare un edificio esteticamente gradevole."
    ],
    "fr": [
      "L'église du Sacré-Cœur de Mosinges construite en 1963 accompagne la fondation d'une nouvelle paroisse à Cran-Gevrier. Avec des matériaux économiques, les architectes Maurice Novarina et Claude Fay ont réussi à concevoir un édifice esthétique."
    ],
    "es": [
      "La iglesia Sacré-Cœur de Mosinges se construyó en 1963 para acompañar la fundación de una nueva parroquia en Cran-Gevrier. Utilizando materiales económicos, los arquitectos Maurice Novarina y Claude Fay lograron diseñar un edificio estéticamente agradable."
    ],
    "nl": [
      "De Sacré-C?ur kerk in Mosinges werd in 1963 gebouwd om de stichting van een nieuwe parochie in Cran-Gevrier te begeleiden. De architecten Maurice Novarina en Claude Fay gebruikten zuinige materialen en slaagden erin een esthetisch mooi gebouw te ontwerpen."
    ]
  },
