  "rdfs:comment": {
    "de": [
      "Als kulturelle Einrichtung, die auf die Bedürfnisse und die Größe der Gemeinde zugeschnitten ist, bietet es eine Kapazität von 110 Sitzen mit einem eklektischen Kulturprogramm von etwa 20 Aufführungen."
    ],
    "en": [
      "A cultural facility designed to suit the needs and size of the community, it seats 110 and offers an eclectic cultural program of around 20 performances."
    ],
    "it": [
      "Una struttura culturale adattata alle esigenze e alle dimensioni della comunità, con una capacità di 110 posti e un programma eclettico di circa 20 spettacoli."
    ],
    "fr": [
      "Équipement culturel qui se veut adapté aux besoins et à la taille de la commune, il offre une capacité de 110 fauteuils avec une programmation culturelle éclectique d'environ 20 représentations."
    ],
    "es": [
      "Instalación cultural adaptada a las necesidades y al tamaño de la comunidad, tiene un aforo de 110 plazas y un programa ecléctico de unos 20 espectáculos."
    ],
    "nl": [
      "Het is een culturele faciliteit die is afgestemd op de behoeften en omvang van de gemeenschap, met een capaciteit van 110 zitplaatsen en een eclectisch programma van ongeveer 20 voorstellingen."
    ]
  },
