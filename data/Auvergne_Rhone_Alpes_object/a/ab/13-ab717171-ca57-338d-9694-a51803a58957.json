  "rdfs:comment": {
    "de": [
      "Als Gilles nach einem Unfall sein Gedächtnis verliert, kehrt er nach Hause zu seiner Frau Lisa zurück, mit der er seit fünfzehn Jahren verheiratet ist. Er muss alles neu lernen und sein Leben neu entdecken."
    ],
    "en": [
      "When, following an accident, Gilles loses his memory, he returns home to Lisa, his wife of fifteen years. He has to relearn everything, rediscover his life."
    ],
    "it": [
      "Quando, in seguito a un incidente, Gilles perde la memoria, torna a casa da Lisa, sua moglie da quindici anni. Deve reimparare tutto e riscoprire la sua vita."
    ],
    "fr": [
      "Lorsque, à la suite d'un accident, Gilles perd la mémoire, il revient chez lui auprès de Lisa sa femme depuis quinze ans. Il lui faut tout réapprendre, redécouvrir sa vie."
    ],
    "nl": [
      "Wanneer Gilles na een ongeluk zijn geheugen verliest, keert hij terug naar huis, naar Lisa, zijn vrouw van vijftien jaar. Hij moet alles opnieuw leren en zijn leven opnieuw ontdekken."
    ],
    "es": [
      "Cuando, a raíz de un accidente, Gilles pierde la memoria, vuelve a casa con Lisa, su mujer desde hace quince años. Tiene que volver a aprenderlo todo y redescubrir su vida."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Petits crimes conjugaux - Théâtre"
    ]
  },
