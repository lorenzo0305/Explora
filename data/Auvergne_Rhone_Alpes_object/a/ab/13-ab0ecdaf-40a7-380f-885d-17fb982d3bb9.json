  "rdfs:comment": {
    "de": [
      "Kurse für Pferde und Ponys, Box oder Weide.\r\nArbeit und Unterricht für Pferde.\r\nBesuch des Bauernhofs, Ponyreiten für Kinder von 3 bis 12 Jahren, mittwochs, samstags und in den Schulferien von April bis Oktober."
    ],
    "en": [
      "Little ranch, pony club.\r\n\r\nEducational farm \"La p'tite ferme du ranch\" from 15 April 2019: visit of the farm, pony ride"
    ],
    "it": [
      "Lezioni di cavalli e pony, in box o su prato.\r\nCavalli da lavoro e didattici.\r\nVisite alla fattoria, passeggiate su pony per bambini dai 3 ai 12 anni, il mercoledì, il sabato e durante le vacanze scolastiche da aprile a ottobre."
    ],
    "fr": [
      "Cours de chevaux et poneys, box ou pré.\r\nTravail et enseignement chevaux.\r\nVisite de la ferme, balade à poney pour les enfants de 3 à 12 ans, les mercredis, samedis et vacances scolaires d'avril à octobre."
    ],
    "nl": [
      "Paard en pony lessen, box of weide.\r\nWerk- en leerpaarden.\r\nBezoekjes aan de boerderij, ponyritjes voor kinderen van 3 tot 12 jaar, op woensdag, zaterdag en schoolvakanties van april tot oktober."
    ],
    "es": [
      "Clases de caballos y ponis, box o pradera.\r\nCaballos de trabajo y de enseñanza.\r\nVisitas a la granja, paseos en poni para niños de 3 a 12 años, los miércoles, sábados y vacaciones escolares de abril a octubre."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le p'tit ranch"
    ]
  },
