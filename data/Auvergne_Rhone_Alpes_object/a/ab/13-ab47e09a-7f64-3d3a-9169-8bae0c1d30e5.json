  "rdfs:comment": {
    "de": [
      "Hier finden Sie die neuesten Filme im Kino, Vorträge, Konzerte und Aufführungen...!\r\nDas Cinéma Le Scialet ist mit einem digitalen Projektor der neuesten Generation ausgestattet und verfügt über einen komfortablen Saal mit 168 Sitzplätzen."
    ],
    "en": [
      "Enjoy the latest films, conferences, concerts, shows...!\r\nCinéma Le Scialet is equipped with a state-of-the-art digital projector and a comfortable 168-seat auditorium."
    ],
    "it": [
      "Godetevi gli ultimi film, conferenze, concerti e spettacoli!\r\nIl Cinéma Le Scialet dispone di un proiettore digitale all'avanguardia e di un'accogliente sala cinematografica con una capienza di 168 posti."
    ],
    "fr": [
      "Retrouvez les derniers films à l’affiche, des conférences, des concerts, des spectacles.. !\r\nLe Cinéma Le Scialet est équipé d'un projecteur numérique dernière génération et d'une salle tout confort d'une capacité de 168 places."
    ],
    "nl": [
      "Geniet van de nieuwste films, lezingen, concerten en voorstellingen!\r\nCinéma Le Scialet heeft een hypermoderne digitale projector en een comfortabele bioscoop met een capaciteit van 168."
    ],
    "es": [
      "Disfrute de las últimas películas, conferencias, conciertos y espectáculos\r\nCinéma Le Scialet cuenta con un proyector digital de última generación y una cómoda sala de cine con capacidad para 168 personas."
    ]
  },
