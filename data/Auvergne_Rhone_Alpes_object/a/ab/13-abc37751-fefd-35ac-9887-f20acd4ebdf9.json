  "rdfs:comment": {
    "de": [
      "La Marmite ist ein gutes Bergrestaurant mit dem Gütesiegel Maître Restaurateur, d. h. alles wird hausgemacht und mit frischen oder ausschließlich handwerklich hergestellten Produkten zubereitet. Ein sehr herzliches Team am Empfang sorgt für ein leckeres und herzliches Essen."
    ],
    "en": [
      "La Marmite is a fine mountain restaurant with the Maître Restaurateur label, which means that everything is home-cooked using fresh or exclusively artisanal produce. A warm and friendly team welcomes you for a gourmet meal."
    ],
    "it": [
      "La Marmite è un raffinato ristorante di montagna con il marchio Maître Restaurateur, il che significa che tutto è cucinato in casa con prodotti freschi o esclusivamente di produzione propria. Il cordiale team del La Marmite si assicurerà che il vostro pasto sia di vostro gradimento."
    ],
    "fr": [
      "La Marmite est une bonne table de montagne, labelisée Maître Restaurateur, c'est à dire tout est cuisiné Maison à base de produits frais ou exclusivement artisanaux. Une équipe très chaleureuse à l'accueil pour un repas des plus gourmands et chaleureux."
    ],
    "nl": [
      "La Marmite is een fijn bergrestaurant met het Maître Restaurateur-label, wat betekent dat alles huisgemaakt is met verse of uitsluitend zelf geteelde producten. Het vriendelijke team van La Marmite zorgt ervoor dat je geniet van je maaltijd."
    ],
    "es": [
      "La Marmite es un restaurante de alta cocina de montaña con la etiqueta Maître Restaurateur, lo que significa que todo se cocina en casa con productos frescos o exclusivamente de cosecha propia. El amable equipo de La Marmite se encargará de que disfrute de su comida."
    ]
  },
