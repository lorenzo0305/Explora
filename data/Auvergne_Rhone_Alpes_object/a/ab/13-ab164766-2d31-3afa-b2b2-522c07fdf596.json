  "rdfs:comment": {
    "de": [
      "Um das Erbe zu entdecken, biete Henri Führungen stundenweise, halbtags oder tageweise an; in Savoie, Haute Savoie, aber auch darüber hinaus, in Frankreich oder im Ausland."
    ],
    "en": [
      "To discover the heritage, Henri propose you guided tours by the hour, the half-day or the day; in Savoie, Haute Savoie but also beyond, in France or abroad."
    ],
    "it": [
      "Per scoprire il patrimonio, Henri propone visite guidate di un'ora, di mezza giornata o di un giorno; in Savoia, in Alta Savoia ma anche oltre, in Francia o all'estero."
    ],
    "fr": [
      "Pour découvrir le patrimoine, Henri propose des visites guidées à l'heure, à la demi-journée ou à la journée; en Savoie, Haute Savoie mais aussi au delà, en France ou à l'étranger."
    ],
    "es": [
      "Para descubrir el patrimonio, Henri ofrece visitas guiadas por horas, medias jornadas o días; en Saboya, Alta Saboya pero también más allá, en Francia o en el extranjero."
    ],
    "nl": [
      "Om het erfgoed te ontdekken, biedt Henri rondleidingen per uur, halve dag of dag aan; in de Savoie, de Haute Savoie maar ook daarbuiten, in Frankrijk of in het buitenland."
    ]
  },
