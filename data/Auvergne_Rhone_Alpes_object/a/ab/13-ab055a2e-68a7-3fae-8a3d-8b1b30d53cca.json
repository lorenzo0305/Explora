  "rdfs:comment": {
    "de": [
      "Mittags von Montag bis Freitag geöffnet / Dienstag-, Mittwoch- und Freitagabend. Tagesmenü 16? Auf der Speisekarte stehen Pizzas, jede Woche ein anderer Burger, Vorschläge auf der Schiefertafel: Fisch, Fleisch, hausgemachte Nudeln, Salate, je nach Lust und Laune des Küchenchefs"
    ],
    "en": [
      "Open for lunch Monday to Friday / Tuesday, Wednesday and Friday evenings. Daily menu 16? The menu includes pizzas, a different burger every week, suggestions on the slate: fish, meat, homemade pasta, salads, according to the chef's whims"
    ],
    "it": [
      "Aperto a pranzo dal lunedì al venerdì / martedì, mercoledì e venerdì sera. Menu giornaliero 16? Il menu comprende pizze, un hamburger diverso ogni settimana, proposte sulla lavagna: pesce, carne, pasta fatta in casa, insalate, secondo i capricci dello chef"
    ],
    "fr": [
      "Ouvert le midi du lundi au vendredi / mardi, mercredi et vendredi soir. Menu du jour 16€. La carte compte des pizzas, un burger différent chaque semaine, suggestions à l'ardoise : poisson, viande, pâtes maison, salades, en fonction des envies du chef"
    ],
    "nl": [
      "Open voor lunch van maandag tot vrijdag / dinsdag-, woensdag- en vrijdagavond. Dagmenu 16? Op het menu staan pizza's, elke week een andere hamburger, suggesties op de plaat: vis, vlees, huisgemaakte pasta, salades, volgens de grillen van de chef"
    ],
    "es": [
      "Abierto al mediodía de lunes a viernes / martes, miércoles y viernes por la noche. Menú del día 16? La carta incluye pizzas, una hamburguesa diferente cada semana, sugerencias en la pizarra: pescado, carne, pasta casera, ensaladas, según los caprichos del chef"
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Table de Margaux"
    ]
  },
