  "rdfs:comment": {
    "de": [
      "Montélimar ist eine vernetzte Stadt, die ideal ist, um im Herzen der Provence abzuschalten. Montélimar liegt 1,5 Stunden von Lyon und Marseille entfernt und ist die zweitgrößte Stadt des Departements Drôme. Montélimar ist DAS Reiseziel zwischen Stadt und Land. Lust, die Seele baumeln zu lassen, indem Sie sich ins Grüne begeben, kommen Sie zu uns!"
    ],
    "en": [
      "Montélimar is a connected town, ideal for relaxing in the heart of Provence. 1h30 from Lyon and Marseille, 2nd largest town in the Drôme, Montélimar is THE destination between town and country. If you're looking to relax and enjoy the countryside, come and visit us!"
    ],
    "it": [
      "Porta della Provenza, Montélimar annuncia i primi campi di lavanda, la dolcezza del sud e quel piccolo sapore di vacanza che mette subito di buon umore."
    ],
    "fr": [
      "Porte lumineuse de la Provence qui vous fait vibrer, Montélimar annonce les premiers champs de lavande, la douceur du sud et ce petit goût de vacances qui met instantanément de bonne humeur."
    ],
    "es": [
      "Puerta de entrada a la Provenza, Montélimar anuncia los primeros campos de lavanda, la dulzura del sur y ese saborcillo a vacaciones que pone de buen humor al instante."
    ],
    "nl": [
      "Montélimar is een verbonden stad, ideaal om te ontspannen in het hart van de Provence. Op slechts 1u30 van Lyon en Marseille, en de 2e grootste stad in de Drôme, is Montélimar DE bestemming tussen stad en platteland. Als u wilt ontspannen en genieten van het platteland, kom dan bij ons logeren!"
    ]
  },
