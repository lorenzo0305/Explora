          "@type": [
            "schema:OpeningHoursSpecification"
          ],
          "additionalInformation": {
            "de": [
              "Von Dienstag bis Samstag nur auf Reservierung geöffnet.\r\nFür Einzelpersonen: Führungen nach Voranmeldung, Beginn der Führungen um 11:00, 13:30 und 15:00 Uhr (sowie um 16:30 Uhr am Samstag).\r\nFür Gruppen: Dienstag bis Samstag nach Vereinbarung.\r\n\r\nJährlich geschlossen in den ersten beiden Augustwochen sowie zwischen Weihnachten und Neujahr."
            ],
            "en": [
              "Open by reservation only, Tuesday to Saturday.\r\nIndividuals: guided tours by appointment, departing at 11am, 1:30pm and 3pm (and 4:30pm on Saturdays).\r\nFor groups: Tuesday to Saturday by appointment.\r\n\r\nClosed the first two weeks of August and between Christmas and New Year's Day."
            ],
            "it": [
              "Aperto su prenotazione, dal martedì al sabato.\r\nPrivati: visite guidate su prenotazione, con partenza alle 11.00, alle 13.30 e alle 15.00 (e alle 16.30 il sabato).\r\nGruppi: da martedì a sabato su prenotazione.\r\n\r\nChiuso nelle prime due settimane di agosto e tra Natale e Capodanno."
            ],
            "fr": [
              "Ouverture uniquement sur réservation du mardi au samedi.\r\nPour les individuels : visites guidées sur réservation, départs des visites à 11h, 13h30 et 15h (ainsi qu'à 16h30 le samedi).\r\nPour les groupes : du mardi au samedi sur rendez-vous.\r\n\r\nFermeture annuelle les les deux premières semaines d'août et entre Noël et le Jour de l'An."
            ],
            "nl": [
              "Alleen op reservering geopend van dinsdag tot zaterdag.\r\nIndividueel: rondleidingen op afspraak, vertrek om 11.00, 13.30 en 15.00 uur (en 16.30 uur op zaterdag).\r\nGroepen: dinsdag tot zaterdag op afspraak.\r\n\r\nGesloten tijdens de eerste twee weken van augustus en tussen Kerstmis en Nieuwjaarsdag."
            ],
            "es": [
              "Abierto sólo con reserva previa, de martes a sábado.\r\nIndividuales: visitas guiadas concertadas, salidas a las 11.00, 13.30 y 15.00 (y 16.30 los sábados).\r\nGrupos: de martes a sábado con cita previa.\r\n\r\nCerrado las dos primeras semanas de agosto y entre Navidad y Año Nuevo."
            ]
          },
