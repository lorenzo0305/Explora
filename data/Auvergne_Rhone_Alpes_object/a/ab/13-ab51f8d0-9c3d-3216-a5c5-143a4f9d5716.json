  "rdfs:comment": {
    "de": [
      "Im Herzen des Dorfes befindet sich das Maison du Chambon, ein einfacher und familiärer Ort, um sich zu treffen, zu probieren, zu genießen und glücklich zu sein!"
    ],
    "en": [
      "In the heart of the village, the Maison du Chambon, a simple, family-friendly place to meet, taste, enjoy and be happy!"
    ],
    "it": [
      "Nel cuore del villaggio, la Maison du Chambon è un luogo semplice e familiare per stare insieme, assaggiare, gustare ed essere felici!"
    ],
    "fr": [
      "Au cœur du village, la Maison du Chambon, un lieu simple et familial pour se réunir, déguster, profiter et être heureux !"
    ],
    "nl": [
      "In het hart van het dorp is het Maison du Chambon een eenvoudige, gezinsvriendelijke plek om samen te komen, te proeven, te genieten en gelukkig te zijn!"
    ],
    "es": [
      "En el corazón del pueblo, la Maison du Chambon es un lugar sencillo y familiar donde reunirse, degustar, disfrutar y ser feliz"
    ]
  },
