  "rdfs:comment": {
    "de": [
      "4 Orientierungsstrecken, auf denen Sie die Île de la Ronde und die Cordeliers auf spielerische Weise entdecken können: grün, blau, orange und rot. Von 2 bis 5 km. 1 Kulturerbe-Parcours: 12 Markierungen von 1,5 km Länge. Karteikarten für die Strecken und Abfahrten im Fremdenverkehrsamt."
    ],
    "en": [
      "4 orienteering trails: green, blue, orange and red, offering a fun way to discover Ile de la Ronde and Les Cordeliers. From 2 to 5km. 1 heritage trail: 12 markers 1.5km long. Route descriptions and starting points at the Tourist Office."
    ],
    "it": [
      "4 percorsi di orienteering per scoprire l'Ile de la Ronde e i Cordeliers in modo divertente: verde, blu, arancione e rosso. Da 2 a 5 km. 1 percorso del patrimonio: 12 marcatori su 1,5 km. Descrizione dei percorsi e punti di partenza presso l'Ufficio del Turismo."
    ],
    "fr": [
      "4 parcours d'orientation permettant de découvrir l'île de la Ronde et les Cordeliers de façon ludique : vert, bleu, orange et rouge. De 2 à 5km. 1 parcours patrimoine : 12 balises de 1.5km. Fiches parcours et départs à l'Office de Tourisme."
    ],
    "es": [
      "4 recorridos de orientación para descubrir la Ile de la Ronde y los Cordeliers de forma lúdica: verde, azul, naranja y rojo. De 2 a 5 km. 1 recorrido patrimonial: 12 balizas a lo largo de 1,5 km. Descripción de los recorridos y puntos de partida en la Oficina de Turismo."
    ],
    "nl": [
      "4 oriëntatieroutes om het Ile de la Ronde en de Cordeliers op een leuke manier te ontdekken: groen, blauw, oranje en rood. Van 2 tot 5 km. 1 erfgoedroute: 12 markeringen over 1,5 km. Routebeschrijvingen en startpunten bij het Office du Tourisme."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parcours d'orientation"
    ]
  },
