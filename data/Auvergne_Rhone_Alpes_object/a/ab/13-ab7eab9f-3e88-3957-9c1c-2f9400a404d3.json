  "rdfs:comment": {
    "de": [
      "Außenschreinerarbeiten, Innenausbau (Wandverkleidungen, Fußböden, Türen), Treppen.\r\nMöbel aller Art, Küchen, Bäder, Schreinerei.\r\nEinbau von Fenstern und Terrassentüren, Balkonbau, Fußböden und Haustüren."
    ],
    "en": [
      "Exterior carpentry, interior design (paneling, flooring, doors), staircases.\r\nFurniture of all types, kitchens, bathrooms, cabinetmaking.\r\nInstallation of windows and French doors, construction of balconies, flooring, and front doors."
    ],
    "it": [
      "Falegnameria esterna, arredi interni (rivestimenti, parquet, porte), scale.\r\nTutti i tipi di mobili, cucine, bagni, ebanisteria.\r\nMontaggio di finestre, bovindi, balconi, pavimenti, porte d'ingresso."
    ],
    "fr": [
      "Menuiserie extérieur, agencement d’intérieur (lambris, parquet, portes), escaliers. \r\nMobiliers tous types, cuisines, salles de bains, ébénisterie.\r\nPose de fenêtre, baie vitrée, fabrication de balcon, plancher, porte d’entrée."
    ],
    "es": [
      "Carpintería exterior, interior (revestimientos, parquet, puertas), escaleras.\r\nTodo tipo de muebles, cocinas, baños, ebanistería.\r\nColocación de ventanas, miradores, balcones, suelos, puertas de entrada."
    ],
    "nl": [
      "Buitenschrijnwerk, binneninrichting (lambrisering, parketvloeren, deuren), trappen.\r\nAlle soorten meubels, keukens, badkamers, schrijnwerk.\r\nMontage van ramen, erkers, balkons, vloeren, voordeuren."
    ]
  },
