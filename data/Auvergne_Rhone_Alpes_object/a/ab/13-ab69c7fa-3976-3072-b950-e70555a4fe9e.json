  "rdfs:comment": {
    "de": [
      "Fasziapulsologie-Sitzungen für das Wohlbefinden des Rückens, die Mobilität, die Funktion der Organe und die Beruhigung des Nervensystems. Ganzheitliche manuelle Praxis auf die Faszien, die im gesamten Körper vorhanden sind."
    ],
    "en": [
      "Fasciapulsology sessions for back well-being, mobility, organ function and nervous system calming. Global manual practice on the fascias present throughout the body."
    ],
    "it": [
      "Sedute di Fasciapulsologia per il benessere della schiena, la mobilità, la funzionalità degli organi e il rilassamento del sistema nervoso. Pratica manuale globale sui fasci presenti in tutto il corpo."
    ],
    "fr": [
      "Séances de Fasciapulsologie pour le bien-être du dos, la mobilité, le fonctionnement des organes et l'apaisement du système nerveux. Pratique manuelle globale sur les fascias présents dans l’ensemble du corps."
    ],
    "es": [
      "Sesiones de fasciapulsología para el bienestar de la espalda, la movilidad, el funcionamiento de los órganos y la calma del sistema nervioso. Práctica manual global sobre las fascias presentes en todo el cuerpo."
    ],
    "nl": [
      "Fasciapulsologie sessies voor het welzijn van de rug, mobiliteit, orgaanfunctie en het kalmeren van het zenuwstelsel. Globale manuele praktijk op de fasciën die overal in het lichaam aanwezig zijn."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Fasciapulsologie - Thérapie sur les fascias"
    ]
  },
