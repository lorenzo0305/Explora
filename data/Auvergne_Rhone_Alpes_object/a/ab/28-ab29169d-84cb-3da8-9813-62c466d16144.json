  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/212f1590-383a-3734-9bf5-40091934ed08",
      "dc:description": {
        "de": [
          "Nehmen Sie am Nachmittag des großen Gongbades Äquinoktium \"Erde\" mit dem Verein le champ des gongs in Tergnier teil, am Sonntag, den 21. September, von 15.00 bis 16.30 Uhr.\n\nPreis: 20?\n\nReservieren Sie Ihre Sitzung unter 06 50 78 90 55 oder lechampdesgongs.fr"
        ],
        "en": [
          "Take part in the \"Earth\" equinox gong bath with the association le champ des gongs, in Tergnier, on Sunday September 21 from 3:00 pm to 4:30 pm.\n\nPrice: 20?\n\nBook your session on 06 50 78 90 55 or lechampdesgongs.fr"
        ],
        "it": [
          "Partecipate al bagno di gong dell'equinozio \"Terra\" con l'associazione le champ des gong, a Tergnier, domenica 21 settembre dalle 15.00 alle 16.30.\n\nPrezzo: 20?\n\nPrenotate la vostra sessione chiamando il numero 06 50 78 90 55 o visitando il sito lechampdesgongs.fr"
        ],
        "fr": [
          "Participez à l’après-midi grand bain de gongs équinoxe « Terre » avec l’association le champ des gongs, à Tergnier, le dimanche 21 septembre de 15h00 à 16h30.\n\nTarif : 20€ \n\nRéservez votre séance au 06 50 78 90 55 ou sur lechampdesgongs.fr"
        ],
        "es": [
          "Participe en el baño de gongs del equinoccio \"Tierra\" con la asociación le champ des gongs, en Tergnier, el domingo 21 de septiembre de 15.00 a 16.30 h.\n\nPrecio: 20?\n\nReserve su sesión llamando al 06 50 78 90 55 o visitando lechampdesgongs.fr"
        ],
        "nl": [
          "Neem deel aan het gongbad van de equinox \"Aarde\" met de vereniging le champ des gongs, in Tergnier, op zondag 21 september van 15.00 tot 16.30 uur.\n\nPrijs: 20?\n\nReserveer je sessie door te bellen naar 06 50 78 90 55 of ga naar lechampdesgongs.fr"
        ]
      },
