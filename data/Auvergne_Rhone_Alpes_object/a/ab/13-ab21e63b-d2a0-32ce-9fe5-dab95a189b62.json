  "rdfs:comment": {
    "de": [
      "70 Spielautomaten, elektronisches englisches Roulette und Black Jack, Boule.\r\nDie Spielhallen sind nur für volljährige, spielberechtigte Personen zugänglich, die einen gültigen Ausweis vorlegen."
    ],
    "en": [
      "Every day throughout the year. Casino includes 70 slot machines, electronic english roulette and blackjack, boule, bar. Entry refused to under 18s., valid proof of identity required."
    ],
    "it": [
      "70 Slot machine, roulette inglese e Black Jack elettronico, Boule.\r\nLe sale da gioco sono riservate agli adulti autorizzati a giocare, dietro presentazione di un documento di identità valido."
    ],
    "fr": [
      "70 Machines à sous, roulette anglaise et Black Jack électroniques, Boule.\r\nLes salles de jeux sont réservées aux personnes majeures et autorisées à jouer, sur présentation d'une pièce valide d’identité."
    ],
    "nl": [
      "70 speelautomaten, Engels roulette en elektronisch Black Jack, Boule.\r\nDe speelzalen zijn gereserveerd voor volwassenen met een geldig legitimatiebewijs."
    ],
