  "rdfs:comment": {
    "de": [
      "Handwerker des Lachens und des spielerischen Spiels. Die Cie bietet Clownkurse für Erwachsene an (für alle zugänglich). Die Gelegenheit, mit der eigenen Kreativität und dem inneren Potenzial zu experimentieren."
    ],
    "en": [
      "Artisan of laughter and playfulness. The company offers clowning workshops for adults (accessible to all). The opportunity to experiment with your creativity and inner potential."
    ],
    "it": [
      "Artigiano della risata e del gioco. La compagnia offre laboratori di clownerie per adulti (accessibili a tutti). Un'opportunità per sperimentare la propria creatività e il proprio potenziale interiore."
    ],
    "fr": [
      "Artisan du rire et du jeu ludique. La Cie vous propose des stages de Clown pour adultes (accessibles à tous). L’occasion d’expérimenter sa créativité et ses potentiels intérieurs."
    ],
    "nl": [
      "Artiest van de lach en speelsheid. Het bedrijf biedt workshops clownerie voor volwassenen (toegankelijk voor iedereen). Een kans om te experimenteren met je creativiteit en innerlijk potentieel."
    ],
    "es": [
      "Artesano de la risa y el juego. La empresa ofrece cursos de clown para adultos (accesibles a todos). Una oportunidad para experimentar con su creatividad y su potencial interior."
    ]
  },
