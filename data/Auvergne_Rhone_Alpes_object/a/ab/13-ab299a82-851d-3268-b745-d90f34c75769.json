  "rdfs:comment": {
    "de": [
      "Am Zusammenfluss von Guiers Vif und Herbetan auf einem Platz im Herzen des Dorfes können Sie unsere Küche probieren: savoyische Spezialitäten, Fleisch und Käse aus der Chartreuse..."
    ],
    "en": [
      "It is at the confluence of Guiers Vif and Herbetan on a square in the heart of the village, that you can enjoy our cuisine."
    ],
    "it": [
      "È alla confluenza del Guiers Vif e dell'Herbetan, in una piazza nel cuore del villaggio, che potrete gustare la nostra cucina: specialità savoiarde, carni e formaggi della Chartreuse..."
    ],
    "fr": [
      "C'est au confluent du Guiers Vif et de l'Herbetan sur une place au cœur du village, que vous pourrez déguster notre cuisine : spécialités savoyardes, viandes et fromages de Chartreuse..."
    ],
    "nl": [
      "Het is aan de samenloop van de Guiers Vif en de Herbetan op een plein in het hart van het dorp, dat u onze keuken kunt proeven: specialiteiten uit de Savoie, vlees en kazen uit de Chartreuse..."
    ],
    "es": [
      "Es en la confluencia del Guiers Vif y del Herbetan, en una plaza en el corazón del pueblo, donde podrá degustar nuestra cocina: especialidades saboyanas, carnes y quesos de la Chartreuse..."
    ]
  },
  "rdfs:label": {
    "en": [
      "Restaurant \"La Flambée\""
