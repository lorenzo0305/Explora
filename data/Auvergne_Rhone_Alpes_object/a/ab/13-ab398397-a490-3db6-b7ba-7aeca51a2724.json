  "rdfs:comment": {
    "de": [
      "Gehen Sie auf eine Schneeschuhwanderung, um die verschneiten Landschaften zu entdecken, und genießen Sie anschließend einen gemütlichen Aperitif in einem Iglu, geschützt vor der Kälte. Eine einzigartige Erfahrung, die Abenteuer und warme Momente in der Natur miteinander verbindet!"
    ],
    "en": [
      "Set off on a snowshoe hike to discover snow-covered landscapes, then enjoy a convivial aperitif in an igloo, sheltered from the cold. A unique experience combining adventure and warmth in the heart of nature!"
    ],
    "it": [
      "Partite per un'escursione con le racchette da neve alla scoperta di paesaggi innevati, poi godetevi un aperitivo conviviale in un igloo, al riparo dal freddo. Un'esperienza unica che unisce avventura e calore nel cuore della natura!"
    ],
    "fr": [
      "Partez pour une randonnée en raquettes à la découverte des paysages enneigés, puis savourez un apéritif convivial dans un igloo, à l’abri du froid. Une expérience unique alliant aventure et moments chaleureux en pleine nature !"
    ],
    "nl": [
      "Maak een sneeuwschoenwandeling om besneeuwde landschappen te ontdekken en geniet daarna van een gezellig aperitief in een iglo, beschut tegen de kou. Een unieke ervaring die avontuur en warmte combineert in het hart van de natuur!"
    ],
    "es": [
      "Emprenda una excursión con raquetas de nieve para descubrir paisajes nevados y, a continuación, disfrute de un agradable aperitivo en un iglú, al abrigo del frío. Una experiencia única que combina aventura y calidez en plena naturaleza."
    ]
  },
