      "rdfs:comment": {
        "de": [
          "Honig aus Flandern und Feinschmeckerprodukte wie das flämische Herz oder Lebkuchen mit Honig erwarten Sie im Rucher des 7 fleurs! Zögern Sie nicht, eine Bestellung aufzugeben!"
        ],
        "en": [
          "Flanders honey and gourmet products such as coeur flamand and honey gingerbread await you at the Rucher des 7 fleurs! Don't hesitate to order!"
        ],
        "it": [
          "Il miele delle Fiandre e i prodotti gastronomici come il coeur flamand e il pan di zenzero al miele vi aspettano al Rucher des 7 fleurs! Non esitate a ordinare!"
        ],
        "fr": [
          "Miel de Flandre et produits gourmands comme le coeur flamand ou le pain d'épices au miel vous attendent au Rucher des 7 fleurs ! N'hésitez pas à passer commande !"
        ],
        "es": [
          "¡La miel de Flandes y productos gourmet como el coeur flamand y el pan de especias con miel le esperan en el Rucher des 7 fleurs! ¡No dude en hacer su pedido!"
        ],
        "nl": [
          "Vlaamse honing en gastronomische producten zoals coeur flamand en honingkoek wachten op je bij de Rucher des 7 fleurs! Aarzel niet om te bestellen!"
        ]
      },
