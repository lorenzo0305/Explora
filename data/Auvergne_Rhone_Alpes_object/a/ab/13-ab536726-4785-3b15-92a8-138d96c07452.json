  "rdfs:comment": {
    "de": [
      "Produzent von Bio-Honig (Frühlingshonig von Akazien, Mai-Honig von Linden, Sommer- und Lavendelhonig), frischem Pollen und Verarbeitung: Lebkuchen, Nougat, Karamell und Seifen und Kerzen\r\nKleine Schafzucht.\r\nVon Ecocert als AB zertifiziert."
    ],
    "en": [
      "Producer of organic honey (lavender, forest, acacia, lime, pollen) and processing: bread, gingerbread, nougats, caramiels and soaps with wax and honey.\r\nSmall sheep farm.\r\nCertified AB by Ecocert."
    ],
    "it": [
      "Produttore di miele biologico (miele primaverile di acacia, miele di maggio di tiglio, miele estivo e miele di lavanda), polline fresco e lavorazione: panpepato, torroni, caramello, saponi e candele\r\nPiccolo allevamento di pecore.\r\nCertificato biologico da Ecocert."
    ],
    "fr": [
      "Producteur de miel bio (miel de printemps d',acacia, de mai de  tilleul, miel d'été, et de lavande ), pollen frai et transformation :  pains d'épice , nougats, caramiel et savons et  bougies\r\nPetit élevage de moutons.\r\nCertifié en AB par Ecocert."
    ],
    "es": [
      "Productor de miel ecológica (miel de acacia de primavera, miel de tilo de mayo, miel de verano y miel de lavanda), polen fresco y elaboración: pan de especias, turrones, caramelo, jabones y velas\r\nPequeña explotación ovina.\r\nCertificado ecológico por Ecocert."
    ],
    "nl": [
      "Producent van biologische honing (acacia voorjaarshoning, lindebloesem meihoning, zomerhoning en lavendelhoning), verse pollen en verwerking: peperkoek, nougats, karamel, zeep en kaarsen\r\nKleine schapenboerderij.\r\nAB-gecertificeerd door Ecocert."
    ]
  },
  "rdfs:label": {
