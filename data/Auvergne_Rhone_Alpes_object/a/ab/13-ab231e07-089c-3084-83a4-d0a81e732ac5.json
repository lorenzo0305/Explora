  "rdfs:comment": {
    "de": [
      "Der Parc de l'Ile d'Amour , der zwischen Stadt und Land liegt, präsentiert sich nicht mehr nur als großer Stadtpark, sondern auch als grüne Oase vor den Toren der Stadt."
    ],
    "en": [
      "The Île d'Amour Park, between city and countryside, doesn't represent only a great urban parc but also a heaven of nature located at the gates of the city. Very large park perfect for sportspersons."
    ],
    "it": [
      "Il parco dell'Ile d'Amour, tra città e campagna, non è più solo un grande parco urbano ma anche un'oasi di verde alle porte della città."
    ],
    "fr": [
      "Le parc de l'Ile d'Amour ,  entre ville et campagne, ne se présente plus seulement comme un grand parc urbain mais aussi comme une oasis de verdure aux portes de la ville."
    ],
    "nl": [
      "Het park Ile d'Amour, tussen stad en platteland, is niet langer alleen een groot stadspark, maar ook een oase van groen aan de poort van de stad."
    ],
    "es": [
      "El Parc de l'Ile d'Amour, entre la ciudad y el campo, ya no es sólo un gran parque urbano, sino también un oasis de verdor a las puertas de la ciudad."
    ]
  },
