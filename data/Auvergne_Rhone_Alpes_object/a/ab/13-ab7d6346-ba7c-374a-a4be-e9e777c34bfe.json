  "rdfs:comment": {
    "de": [
      "Familienbauernhof seit 6 Generationen. Wir bieten Ihnen verschiedene Sorten von Pfirsichen, Aprikosen, Nektarinen, Kirschen und Kastanien dank unserer Baumflächen und eine große Vielfalt an Gemüse, Tomaten und Erdbeeren im Gemüseanbaubereich."
    ],
    "en": [
      "A family-run farm for 6 generations, we offer a wide variety of peaches, apricots, nectarines, cherries and chestnuts in our tree nurseries, and a wide variety of vegetables, tomatoes and strawberries in our market garden."
    ],
    "it": [
      "Azienda agricola a conduzione familiare da 6 generazioni, offriamo una varietà di pesche, albicocche, nettarine, ciliegie e castagne nei nostri vivai e un'ampia gamma di verdure, pomodori e fragole nel nostro orto."
    ],
    "fr": [
      "Ferme familiale depuis 6 générations, nous vous proposons diverses variétés de pêches, abricots, nectarines, cerises et châtaignes grâce à nos espaces arboricoles, et une grande variété de légumes, tomates et fraises dans la partie maraîchage."
    ],
    "nl": [
      "We zijn al 6 generaties lang een familiebedrijf en bieden een verscheidenheid aan perziken, abrikozen, nectarines, kersen en kastanjes in onze boomkwekerijen en een breed scala aan groenten, tomaten en aardbeien in onze moestuin."
    ],
    "es": [
      "Granja familiar desde hace 6 generaciones, ofrecemos una gran variedad de melocotones, albaricoques, nectarinas, cerezas y castañas en nuestros viveros, y una amplia gama de hortalizas, tomates y fresas en nuestro huerto."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Ferme de Marcelle"
    ]
  },
