  "rdfs:comment": {
    "de": [
      "Die Terrassen des Viadukts empfangen Sie in der Saison jeden Abend. Denken Sie daran, im Voraus zu reservieren! Eine familiäre und traditionelle Küche wird Ihnen in einem außergewöhnlichen Rahmen inmitten der Natur angeboten."
    ],
    "en": [
      "Camping Le Viaduc warmly welcomes you from Easter to end of September, in its restaurant or on its covered terrace overlooking the river, for a traditional and family cooking around the local products in an exceptional setting, in full nature."
    ],
    "it": [
      "Le terrazze del Viaduc sono aperte tutte le sere in stagione, quindi prenotate in anticipo! La cucina tradizionale familiare è servita in un contesto naturale eccezionale."
    ],
    "fr": [
      "Les terrasses du Viaduc vous accueillent  chaque soir en saison, pensez à réserver à l'avance ! Une cuisine familiale et traditionnelle vous est proposée dans un cadre exceptionnel, en pleine nature."
    ],
    "es": [
      "Las terrazas del Viaduc abren todas las noches en temporada, ¡reserve con antelación! La cocina tradicional familiar se sirve en un marco natural excepcional."
    ],
    "nl": [
      "De terrassen van het Viaduc zijn in het seizoen elke avond geopend, dus reserveer van tevoren! Traditionele familiekeuken wordt geserveerd in een uitzonderlijke natuurlijke omgeving."
    ]
  },
  "rdfs:label": {
    "de": [
      "Die Terrassen des Viadukts - Camping Ushuaïa Villages Le Viaduc"
    ],
    "en": [
