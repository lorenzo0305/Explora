  "rdfs:comment": {
    "de": [
      "La Pierra Menta bietet Ihnen einen schnellen Service, der auf einer großen Auswahl an Burger, Salaten, Pastas, Snacks vor Ort oder zum Mitnehmen basiert.\r\nBedienung an der Theke.\r\nTerrassen an der Schneefront mit Blick auf unsere schönen Berge.\r\n 7 Tage die Woche."
    ],
    "en": [
      "La Pierra Menta offers a fast food service with a wide range of burgers and snacks to eat in or take away.\r\nCounter service.\r\nTerrace at the foot of the ski slopes overlooking our beautiful mountains.\r\nOpen 7/7 all day."
    ],
    "it": [
      "Le Burger ski la Pierra Menta offre un servizio veloce basato su un'ampia varietà di hamburger e snack da mangiare o da portare via.\r\nServizio al banco.\r\nTerrazze fronte neve affacciate sulle nostre splendide montagne.\r\n 7 giorni su 7, senza interruzioni."
    ],
    "fr": [
      "Le Burger ski  la Pierra Menta vous offre un service rapide basé sur une grande variété de Burgers, snacking sur place ou à emporter.\r\nService au comptoir.\r\nTerrasses front de neige face à nos belles montagnes.\r\n 7 jours /7 en continu."
    ],
    "es": [
      "Le Burger ski la Pierra Menta ofrece un servicio rápido basado en una amplia variedad de hamburguesas y bocadillos para comer en el local o para llevar.\r\nServicio de mostrador.\r\nTerrazas frente a la nieve con vistas a nuestras hermosas montañas.\r\n 7 días a la semana, sin parar."
    ],
    "nl": [
      "La Pierra Menta biedt een snelle service op basis van een grote verscheidenheid aan hamburgers, salades, pasta's en snacks om te eten of mee te nemen.\r\nBalie service.\r\nTerrassen met uitzicht op onze prachtige bergen.\r\n7 dagen per week."
    ]
  },
