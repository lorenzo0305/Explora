  "rdfs:comment": {
    "de": [
      "Im Bellevilletal gibt es zahlreiche Angelstellen: der Fluss Doron mit seinen 100 km langen Ufern wo Sie Forellen fangen können, die 12 Seen, wo Sie auf Seeforellen und Seesaiblinge treffen, die 3 privaten Seen mit ihren Regenbogenforellen."
    ],
    "en": [
      "Over ten high altitude lakes and numerous rivers make la Vallée des Belleville a great place to fish."
    ],
    "it": [
      "Numerosi i luoghi di pesca nella Valle di Belleville: il Doron con 100 km di sponde per la pesca della trota, i 12 laghi naturali dove si può pescare la Dama Fario o l'Omble Chevalier e i 3 laghi privati con trote iridee."
    ],
    "fr": [
      "De nombreux lieux de pêche dans la Vallée des Belleville : le Doron avec 100 km de berges pour attraper des truites, les 12 lacs naturels où vous pêcherez Dame Fario ou Omble Chevalier, et les 3 lacs privés avec de la truite arc-en-ciel."
    ],
    "nl": [
      "Veel visplekken in de vallei van Belleville: de Doron met 100 km oevers om forel te vangen, de 12 natuurlijke meren waar u kunt vissen op Dame Fario of Omble Chevalier, en de 3 privémeren met regenboogforel."
    ],
    "es": [
      "Numerosos lugares de pesca en el valle de Belleville: el Doron con 100 km de orillas para pescar truchas, los 12 lagos naturales donde se puede pescar Dame Fario u Omble Chevalier, y los 3 lagos privados con truchas arco iris."
    ]
  },
  "rdfs:label": {
    "de": [
      "Angeln im Bellevilletal"
    ],
    "en": [
      "Fishing in Belleville Valley"
    ],
    "fr": [
      "Pêche dans la vallée des Belleville"
    ]
  },
