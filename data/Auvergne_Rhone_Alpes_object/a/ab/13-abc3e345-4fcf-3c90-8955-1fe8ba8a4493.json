  "rdfs:comment": {
    "de": [
      "Die Textildesignerin Birgit teilt ihr Wissen rund um den Wollfilz und den Pflanzendruck. Mit diesen althergebrachten Techniken lassen sich einzigartige und umweltfreundliche Stücke wie Pflanzenmotive auf Papier oder Stoff aus Wolle und Baumwolle herstellen."
    ],
    "en": [
      "Birgit, textile designer, shares her expertise in wool felt and vegetable printing. These ancestral techniques enable her to create unique, eco-responsible pieces, such as plant motifs on paper or wool and cotton fabric."
    ],
    "it": [
      "Birgit, designer tessile, condivide la sua esperienza nel feltro di lana e nella stampa vegetale. Queste tecniche ancestrali le permettono di creare pezzi unici ed ecologici, come motivi vegetali su carta o tessuti di lana e cotone"
    ],
    "fr": [
      "Birgit, créatrice textile, partage son savoir-faire autour du feutre de laine et de l’impression végétale. Ces techniques ancestrales permettent de créer des pièces uniques et écoresponsables comme des motifs végétaux sur papier ou tissu en laine et coton"
    ],
    "nl": [
      "Birgit, textielontwerpster, deelt haar expertise op het gebied van wolvilt en plantaardig printen. Deze voorouderlijke technieken worden gebruikt om unieke, milieuvriendelijke stukken te maken, zoals plantmotieven op papier of wol en katoenen stof."
    ],
    "es": [
      "Birgit, diseñadora textil, comparte su experiencia en fieltro de lana y estampado vegetal. Estas técnicas ancestrales le permiten crear piezas únicas y ecológicas, como motivos vegetales sobre papel o tejidos de lana y algodón"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Tou'dou Création et Ateliers artistique"
    ]
  },
