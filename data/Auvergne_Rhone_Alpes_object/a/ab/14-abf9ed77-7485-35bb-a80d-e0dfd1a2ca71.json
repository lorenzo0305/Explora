  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/ff3b026f-91a0-3539-b99d-1638754e6e4e",
      "dc:description": {
        "de": [
          "Kleidung für Babys und Kinder. Wohlbefinden und Eleganz für die Kleinen!\n\nMontags von 10:00 bis 14:00 Uhr und von 14:00 bis 19:00 Uhr.\nAm Dienstag geschlossen.\nMittwoch, Donnerstag, Freitag, Samstag und Sonntag von10:00 bis 19:00 Uhr."
        ],
        "en": [
          "Baby and children's clothing. Well-being and elegance for little ones!\n\nMondays 10am to 2pm and 2pm to 7pm.\nClosed Tuesday.\nWednesday, Thursday, Friday, Saturday and Sunday from 10am to 7pm."
        ],
        "it": [
          "Abbigliamento per neonati e bambini. Benessere ed eleganza per i più piccoli!\n\nLunedì dalle 10.00 alle 14.00 e dalle 14.00 alle 19.00.\nMartedì chiuso.\nMercoledì, giovedì, venerdì, sabato e domenica dalle 10.00 alle 19.00."
        ],
        "fr": [
          "Vêtements Bébés et Enfants. Bien-être et Elegance des Petits !\n\nLe lundi de 10h à 14h et de 14h à 19h.\nFermé le mardi.\nMercredi, jeudi, vendredi, samedi et dimanche de10h à 19h."
        ],
        "es": [
          "Ropa para bebés y niños. Bienestar y elegancia para los más pequeños\n\nLunes de 10h a 14h y de 14h a 19h.\nMartes cerrado.\nMiércoles, jueves, viernes, sábado y domingo de 10.00 a 19.00 h."
        ],
        "nl": [
          "Baby- en kinderkleding. Welzijn en elegantie voor de allerkleinsten!\n\nMaandag van 10 tot 14 uur en van 14 tot 19 uur.\nDinsdag gesloten.\nWoensdag, donderdag, vrijdag, zaterdag en zondag van 10 tot 19 uur."
        ]
      },
      "@type": [
        "Description"
