  "rdfs:comment": {
    "de": [
      "Als handwerklicher Siruphersteller seit 2018 biete ich Ihnen Sirup, Konfitüre, Kastaniencreme und andere Leckereien an. Frische, saisonale und lokale Produkte sind für die Herstellung all meiner Produkte unerlässlich."
    ],
    "en": [
      "Artisan Siropier since 2018, I offer syrups, jam, chestnut cream and other sweets. Fresh, seasonal and local produce are essential in the making of all my products."
    ],
    "it": [
      "Sciroppatore artigianale dal 2018, offro sciroppi, marmellate, crema di castagne e altri dolci. I prodotti freschi, di stagione e locali sono fondamentali per la realizzazione di tutti i miei prodotti."
    ],
    "fr": [
      "Artisan Siropier depuis 2018, je vous propose sirops, confiture, crème de marron et autre douceurs. Produit frais, de saison et locaux sont indispensable pour l’élaboration de tous mes produits."
    ],
    "es": [
      "Jarrera artesana desde 2018, ofrezco jarabes, mermelada, crema de castañas y otros dulces. Los productos frescos, de temporada y locales son esenciales en la elaboración de todos mis productos."
    ],
    "nl": [
      "Ambachtelijke siroopmaker sinds 2018, ik bied siropen, jam, kastanjecrème en andere zoetigheden aan. Verse, seizoensgebonden en lokale producten zijn essentieel bij het maken van al mijn producten."
    ]
  },
