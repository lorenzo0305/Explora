  "rdfs:comment": {
    "de": [
      "Entdecken Sie Laura Pasquier Bergbegleiterin mit Sitz in Les Adrets für Aktivitäten in den Bergen: Skifahren, Schneeschuhwandern, Wandern. Genießen Sie die Natur mit dieser lokalen Reiseleiterin!"
    ],
    "en": [
      "Discover Laura Pasquier, a mountain guide based in Les Adrets, for mountain activities such as skiing, snowshoeing and hiking. Enjoy nature with this local guide!"
    ],
    "it": [
      "Vi presentiamo Laura Pasquier, guida alpina di Les Adrets, che propone una serie di attività in montagna, tra cui sci, ciaspole ed escursioni. Godetevi la natura con questa guida locale!"
    ],
    "fr": [
      "Découvrez Laura Pasquier Accompagnatrice en montagne basée aux Adrets pour des activités en montagne : ski, raquettes, randonnée. Profitez de la nature avec cette guide locale !"
    ],
    "nl": [
      "Maak kennis met Laura Pasquier, een berggids uit Les Adrets, die verschillende bergactiviteiten aanbiedt, waaronder skiën, sneeuwschoenwandelen en wandelen. Geniet van de natuur met deze lokale gids!"
    ],
    "es": [
      "Conozca a Laura Pasquier, guía de montaña afincada en Les Adrets, que ofrece una amplia gama de actividades de montaña, como esquí, raquetas de nieve y senderismo. ¡Disfrute de la naturaleza con esta guía local!"
    ]
  },
