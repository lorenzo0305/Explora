  "rdfs:comment": {
    "de": [
      "Unser auf Fleisch und Grillfleisch spezialisiertes Restaurant Courtepaille bietet Ihnen das ganze Jahr über ein saisonales Menü zu einem guten Preis-Leistungs-Verhältnis. Schneller und freundlicher Service!"
    ],
    "ru": [
      "Наш ресторан Courtepaille, специализирующийся на мясных блюдах и мясе на гриле, круглый год предлагает вам сезонное меню с хорошим соотношением цены и качества. Быстрое и дружелюбное обслуживание!"
    ],
    "en": [
      "The Courtepaille restaurant, specializing in meats and grilled meats, offers you a seasonal menu all year round, with good value for money. Fast and friendly service!"
    ],
    "it": [
      "Il nostro ristorante Courtepaille, specializzato in carni e carni alla griglia, vi offre un menù stagionale tutto l'anno, con un buon rapporto qualità-prezzo. Servizio veloce e cordiale!"
    ],
    "fr": [
      "Le restaurant Courtepaille, spécialisé en viandes et en grillades, propose toute l'année une carte de saison, avec un bon rapport qualité-prix. Service rapide et sympathique !"
    ],
    "zh": [
      "我们的 Courtepaille 餐厅专营肉类和烤肉，全年为您提供物超所值的时令菜单。快速友好的服务！"
    ],
    "nl": [
      "Ons restaurant Courtepaille, gespecialiseerd in vlees en gegrild vlees, biedt u het hele jaar door een seizoensmenu met een goede prijs-kwaliteitverhouding. Snelle en vriendelijke service!"
    ],
    "es": [
      "Nuestro restaurante Courtepaille, especializado en carnes y carnes a la brasa, te ofrece un menú de temporada durante todo el año, con una buena relación calidad-precio. ¡Servicio rápido y amable!"
    ]
  },
