          "additionalInformation": {
            "de": [
              "Verkaufsstellen Samoens Village von 8:30 bis 16:15 Uhr und Samoëns 1600 von 8:30 bis 15:00 Uhr.\r\n\r\nDie Verkaufsstellen in MORILLON Village, MORILLON Les Esserts und SAMOËNS Grand Massif Express werden an allen Samstagen während der Schulferien im Februar bis 18 Uhr verlängert."
            ],
            "en": [
              "Points of sale Samoens Village from 8.30am to 4.15pm and Samoëns 1600 from 8.30am to 3pm.\r\n\r\nSales outlets in MORILLON Village, MORILLON Les Esserts and SAMOËNS Grand Massif Express will be extended every Saturday during the February school vacations until 6pm."
            ],
            "it": [
              "Punti vendita Samoens Village dalle 8.30 alle 16.15 e Samoëns 1600 dalle 8.30 alle 15.00.\r\n\r\nI punti vendita di MORILLON Village, MORILLON Les Esserts e SAMOËNS Grand Massif Express saranno prolungati ogni sabato durante le vacanze scolastiche di febbraio fino alle 18.00."
            ],
            "fr": [
              "Points de vente Samoens Village de 8h30 à 16h15 et Samoëns 1600 de 8h30 à 15h. \r\n\r\nLes points de vente de MORILLON Village, MORILLON Les Esserts et SAMOËNS Grand Massif Express seront prolongés tous les samedis des vacances scolaires de février jusqu’à 18h."
            ],
            "nl": [
              "Verkooppunten Samoens Village van 8.30 tot 16.15 uur en Samoëns 1600 van 8.30 tot 15.00 uur.\r\n\r\nDe verkooppunten in MORILLON Village, MORILLON Les Esserts en SAMOËNS Grand Massif Express worden tijdens de schoolvakanties in februari elke zaterdag verlengd tot 18.00 uur."
            ],
            "es": [
              "Puntos de venta Samoens Village de 8h30 a 16h15 y Samoëns 1600 de 8h30 a 15h00.\r\n\r\nLos puntos de venta de MORILLON Village, MORILLON Les Esserts y SAMOËNS Grand Massif Express se prolongarán todos los sábados durante las vacaciones escolares de febrero hasta las 18.00 h."
            ]
          },
