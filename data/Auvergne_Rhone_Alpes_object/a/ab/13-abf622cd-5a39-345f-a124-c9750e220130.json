  "rdfs:comment": {
    "de": [
      "\"Gehen Sie die Korridore der Zeit zurück, von den Römern bis heute\". Entdecken Sie die Geschichte des Weinkellers und der Schaumweine sowie die Geheimnisse der langsamen Herstellung der Clairette de Die. Eine geführte Besichtigung und eine prickelnde Verkostung!!!"
    ],
    "en": [
      "\"Go back in times from the Romans to today\" Come and discover the history of the wine cellar and its sparkling wines as well as the secrets of the slow maturation of the Clairette de Die. A guided visit followed by a fizzy tasting !!"
    ],
    "it": [
      "\"Tornare indietro nel tempo, dai Romani ai giorni nostri. Scoprite la storia della cantina e degli spumanti, nonché i segreti della produzione lenta della Clairette de Die. Una visita guidata e una degustazione di spumanti!"
    ],
    "fr": [
      "\"Remonter les couloirs du temps depuis les Romains jusqu'à aujourd'hui\". Découvrez l'histoire de la cave et des vins effervescents, ainsi que les secrets de le lente élaboration de la Clairette de Die. Une visite guidée et une dégustation pétillante !!"
    ],
    "es": [
      "\"Retrocede en el tiempo desde los romanos hasta la actualidad. Descubra la historia de la bodega y de los vinos espumosos, así como los secretos de la lenta producción de Clairette de Die. Una visita guiada y una cata de vinos espumosos"
    ],
    "nl": [
      "\"Ga terug in de tijd, van de Romeinen tot nu. Ontdek de geschiedenis van de kelder en de mousserende wijnen, evenals de geheimen van de langzame productie van Clairette de Die. Een rondleiding en een mousserende wijnproeverij!"
    ]
  },
  "rdfs:label": {
    "en": [
      "Muséobulles Guided Visits"
    ],
    "fr": [
      "Visite Guidée -  Le Muséo'bulles"
    ]
  },
