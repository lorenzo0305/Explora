  "rdfs:comment": {
    "de": [
      "Achten Sie am Anfang der Strecke auf die kleinen Hindernisse am Rande des Bauernhofs und später auf das kurze Stück auf der D10"
    ],
    "en": [
      "Watch out for the small obstacles at the edge of the farm at the beginning of the course, and then the short section on the D10"
    ],
    "it": [
      "Fate attenzione ai piccoli ostacoli ai margini della fattoria all'inizio del percorso e poi al breve tratto sulla D10"
    ],
    "fr": [
      "Attention au début du parcours aux petits obstacles en bordure de  ferme puis plus loin à la courte portion sur la D10"
    ],
    "nl": [
      "Kijk uit voor de kleine hindernissen aan de rand van de boerderij aan het begin van het parcours en daarna het korte stuk over de D10"
    ],
    "es": [
