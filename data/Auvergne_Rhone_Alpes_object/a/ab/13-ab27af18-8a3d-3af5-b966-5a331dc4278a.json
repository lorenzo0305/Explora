  "rdfs:comment": {
    "de": [
      "Wir züchten Freilandgeflügel neben einer Mutterkuhhaltung der Rasse \"Aubrac\". Um ein Qualitätsprodukt zu gewährleisten, wird unser Geflügel mindestens 140 Tage im Freien aufgezogen."
    ],
    "en": [
      "We raise free-range poultry as well as suckler cows of the Aubrac breed. To guarantee a quality product, our poultry is raised in the open air for a minimum of 140 days."
    ],
    "it": [
      "Alleviamo pollame all'aperto e vacche nutrici di razza Aubrac. Per garantire un prodotto di qualità, il nostro pollame viene allevato all'aperto per un minimo di 140 giorni."
    ],
    "fr": [
      "Nous élevons des volailles fermières en plus d'une production de vaches allaitante de race \"Aubrac\". Pour garantir un produit de qualité, nos volailles sont élevées en plein air au minimum 140 jours."
    ],
    "nl": [
      "We fokken scharrelpluimvee en zoogkoeien van het ras Aubrac. Om een kwaliteitsproduct te garanderen, wordt ons gevogelte minimaal 140 dagen in de open lucht gehouden."
    ],
    "es": [
      "Criamos aves de corral y vacas nodrizas de raza Aubrac. Para garantizar un producto de calidad, nuestras aves se crían al aire libre durante un mínimo de 140 días."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Élevage de volailles fermières : GAEC Alberjo"
    ]
  },
