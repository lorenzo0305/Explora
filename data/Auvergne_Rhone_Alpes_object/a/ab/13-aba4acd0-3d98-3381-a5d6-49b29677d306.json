  "rdfs:comment": {
    "de": [
      "Nehmen Sie die Herausforderung mit Ihrer Familie an! Spielerischer Besuch von Castanea mit einem Spielheft. je nach Alter stehen 3 Spielhefte zur Verfügung: Der geheimnisvolle Gast , Verschwinden im College und Borgen im College."
    ],
    "en": [
      "Take up the challenge with your family! A fun tour of Castanea with a game booklet. 3 game books are available for different ages: the mystery guest, disappearing in the college and pilfering in the college."
    ],
    "it": [
      "Raccogliete la sfida in famiglia! Fate un divertente tour di Castanea con un libretto di giochi. sono disponibili 3 libri gioco per diverse età: l'ospite misterioso, la scomparsa nel collegio e il furto nel collegio."
    ],
    "fr": [
      "Relevez le défi  en famille ! Visite ludique de Castanea avec un livret de jeu. 3 carnets de jeux sont disponibles selon les âges : l’invité mystère , disparition au collège et chapardage au collège."
    ],
    "es": [
      "¡Acepte el reto en familia! Haga un divertido recorrido por Castanea con un cuaderno de juegos. hay 3 cuadernos de juegos disponibles para diferentes edades: el invitado misterioso, desaparecer en el colegio y robar en el colegio."
    ],
    "nl": [
      "Ga de uitdaging aan als gezin! Maak een leuke tocht door Castanea met een spelletjesboekje. er zijn 3 spelboekjes beschikbaar voor verschillende leeftijden: de mystery guest, verdwijnen in het college en stelen in het college."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Menez l'enquête à Castanea-Espace découverte de la châtaigne d'Ardèche"
    ]
  },
