  "rdfs:comment": {
    "de": [
      "Joëlle begleitet Sie das ganze Jahr über bei Workshops rund um das Schreiben. Entdecken Sie die Freuden des Schreibens in Form von Gruppenkursen oder Einzelunterricht!"
    ],
    "en": [
      "Joëlle offers writing workshops all year round. In the form of group courses or individual lessons, discover the joys of writing!"
    ],
    "it": [
      "Joëlle offre laboratori di scrittura tutto l'anno. Sotto forma di corsi di gruppo o lezioni individuali, scoprite le gioie della scrittura!"
    ],
    "fr": [
      "Joëlle vous accompagne sur des ateliers autour de l'écriture toute l'année. Sous forme de stages collectifs ou de cours individuels, déciuvrez les joies de l'écriture !"
    ],
    "es": [
      "Joëlle ofrece talleres de escritura durante todo el año. En forma de cursos en grupo o clases individuales, ¡descubra el placer de escribir!"
    ],
    "nl": [
      "Joëlle biedt het hele jaar door schrijfworkshops aan. In de vorm van groepscursussen of individuele lessen, ontdek het plezier van schrijven!"
    ]
