  "rdfs:comment": {
    "de": [
      "Wie die Region Bressane entdecken Sie hier eine Feinschmeckerküche, die alle Liebhaber guter regionaler Produkte verwöhnen wird."
    ],
    "en": [
      "In the image of the Bresse region, come and discover a gourmet cuisine that will delight all lovers of good local produce."
    ],
    "it": [
      "Nell'immagine della regione della Bresse, venite a scoprire una cucina gourmet che delizierà tutti gli amanti dei buoni prodotti locali."
    ],
    "fr": [
      "A l’image de la région Bressane, venez découvrir une cuisine gourmande qui régalera tous les amateurs de bons produits du terroir."
    ],
    "nl": [
      "Kom in het beeld van de Bressestreek een gastronomische keuken ontdekken die alle liefhebbers van goede streekproducten zal verrukken."
    ],
    "es": [
      "A imagen de la región de Bresse, venga a descubrir una cocina gastronómica que hará las delicias de todos los amantes de los buenos productos locales."
    ]
  },
