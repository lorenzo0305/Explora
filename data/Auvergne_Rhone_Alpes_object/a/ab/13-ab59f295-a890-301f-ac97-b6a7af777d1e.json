  "rdfs:comment": {
    "de": [
      "Die Brasserie Les Deux Branches ist in erster Linie eine Familiengeschichte! Christophe bietet charaktervolle Biere an, indem er sich in die Bewegung der Brauereierneuerung einreiht. Erleben Sie den authentischen oder gewagten Geschmack dieser handwerklich gebrauten Biere."
    ],
    "en": [
      "Brasserie Les Deux Branches is first and foremost a family affair! Christophe offers beers with character, as part of the brewing revival. Renew your acquaintance with the authentic or daring tastes of these craft beers."
    ],
    "it": [
      "La Brasserie Les Deux Branches è prima di tutto un affare di famiglia! Christophe propone birre di carattere, nell'ambito della rinascita della produzione di birra. Godetevi il gusto autentico e deciso di queste birre artigianali."
    ],
    "fr": [
      "La Brasserie Les Deux Branches, c’est d’abord une histoire de famille ! Christophe propose des bières de caractère en s’inscrivant dans le mouvement du renouveau brassicole. Renouez avec les goûts authentiques ou audacieux de ces bières artisanales."
    ],
    "es": [
      "La Brasserie Les Deux Branches es ante todo un negocio familiar Christophe propone cervezas con carácter, en el marco del renacimiento cervecero. Disfrute de los sabores auténticos y atrevidos de estas cervezas artesanales."
    ],
    "nl": [
      "Brasserie Les Deux Branches is in de eerste plaats een familiezaak! In het kader van de heropleving van het brouwen biedt Christophe bieren met karakter aan. Geniet van de authentieke en gedurfde smaken van deze ambachtelijke bieren."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Brasserie Les Deux Branches"
    ]
  },
