  "rdfs:comment": {
    "de": [
      "Le Patio, ein bistronomisches Restaurant im Stadtzentrum, lädt Sie ein, in aller Ruhe eine einfallsreiche Küche zu genießen, die voll und ganz auf frische Produkte von lokalen und regionalen Erzeugern setzt."
    ],
    "en": [
      "Le Patio, a bistronomic restaurant in the city centre invites you to enjoy an inventive cuisine that makes the most of fresh produce from local and regional producers."
    ],
    "it": [
      "Le Patio, ristorante bistronomico nel centro della città, vi invita ad assaporare la sua cucina inventiva, che fa largo uso di prodotti freschi provenienti da produttori locali e regionali."
    ],
    "fr": [
      "Le Patio, restaurant bistronomique en centre-ville vous invite à savourer en toute quiétude une cuisine inventive qui joue à fond la carte des produits frais issus de producteurs locaux et régionaux."
    ],
    "es": [
      "Le Patio, un restaurante bistronómico en el centro de la ciudad, le invita a saborear su inventiva culinaria, que aprovecha al máximo los productos frescos de los productores locales y regionales."
    ],
    "nl": [
      "Le Patio, een bistronomisch restaurant in het centrum van de stad, nodigt u uit om te genieten van zijn inventieve keuken, die volledig gebruik maakt van verse producten van lokale en regionale producenten."
    ]
  },
