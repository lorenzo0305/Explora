  "rdfs:comment": {
    "de": [
      "Das Berführerbüro betreuen die folgende Leistung: Kletterei, Touren, Gletscherwanderungen, Klettersteig"
    ],
    "en": [
      "Nestled between lake Annecy and the Parmelan cliffs at the gate of the Aravis the guides bureau of Thones was created in the 70' s. It regroups guides and leaders passionate about their mountains and open spaces.\r\n\r\nThones is an ideal base camp for your mountain stays in all seasons."
    ],
    "it": [
      "Situata in Alta Savoia, tra il lago di Annecy e il massiccio degli Aravis, la Vallée de Thônes è un campo base per numerose attività. Sia in estate che in inverno, numerose guide e accompagnatori di montagna saranno lieti di accompagnarvi."
    ],
    "fr": [
      "Située en Haute-Savoie entre le lac d'Annecy et le massif des Aravis, la Vallée de Thônes se présente comme un camp de base d'activités variées. Eté comme hiver, plusieurs guides et accompagnateurs passionnés de montagne seront heureux de vous emmener."
    ],
    "nl": [
      "Vallée de Thônes, gelegen in de Haute-Savoie tussen het meer van Annecy en het Aravis-massief, is een basiskamp voor allerlei activiteiten. Zowel in de zomer als in de winter nemen een aantal gidsen en bergleiders je graag mee."
    ],
    "es": [
      "Situado en la Alta Saboya, entre el lago de Annecy y el macizo de Aravis, el Valle de Thônes es un campamento base para realizar numerosas actividades. Tanto en verano como en invierno, numerosos guías y monitores de montaña estarán encantados de acompañarle."
    ]
  },
  "rdfs:label": {
