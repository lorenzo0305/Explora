  "rdfs:comment": {
    "de": [
      "Restaurant mit traditioneller und aktueller Küche und entspannter Atmosphäre auf dem Place du Thay in der mittelalterlichen Stadt Yvoire. Sie können auch unsere Sonnenterrasse nutzen, um ein Getränk zu trinken oder etwas zu essen."
    ],
    "en": [
      "Restaurant with traditional and modern cuisine, with a relaxed atmosphere located on the Place du Thay in the medieval town of Yvoire. You can also enjoy our sunny terrace for a drink or a quick bite to eat."
    ],
    "it": [
      "Ristorante con cucina tradizionale e moderna, in un'atmosfera rilassata, situato sulla Place du Thay nella città medievale di Yvoire. Potrete anche approfittare della nostra terrazza soleggiata per sorseggiare un drink o mangiare un boccone veloce."
    ],
    "fr": [
      "Restaurant à la cuisine traditionnelle et actuelle, à l'ambiance détendue se trouvant sur la place du Thay dans la cité médiéval d'Yvoire. Vous pourrez également profiter de notre terrasse ensoleillée pour boire un verre ou manger sur le pouce."
    ],
    "es": [
      "Restaurante de cocina tradicional y moderna, en un ambiente relajado, situado en la plaza del Thay, en la ciudad medieval de Yvoire. También puede disfrutar de nuestra soleada terraza para tomar una copa o comer algo rápido."
    ],
    "nl": [
      "Restaurant met traditionele en moderne keuken, in een ontspannen sfeer, gelegen op de Place du Thay in de middeleeuwse stad Yvoire. U kunt ook genieten van ons zonnige terras voor een drankje of een snelle hap."
    ]
  },
