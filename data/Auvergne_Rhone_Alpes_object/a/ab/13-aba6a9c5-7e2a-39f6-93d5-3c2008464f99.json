  "rdfs:comment": {
    "de": [
      "Öffnen Sie die Tür von Les 3 P'tits Cochons und genießen Sie eine große Auswahl an Pökelfleisch aus der Auvergne IGP sowie Käse, Confieries und andere regionale Spezialitäten."
    ],
    "en": [
      "Push the door of the 3 Pigs and enjoy a wide choice of IGP salted meats from Auvergne as well as cheeses, confections and other regional specialities."
    ],
    "it": [
      "Aprite la porta del 3 P'tits Cochons e gustate un'ampia scelta di salumi IGP dell'Alvernia, oltre a formaggi, confetture e altre specialità regionali."
    ],
    "fr": [
      "Poussez la porte des 3 P'tits Cochons  et profitez d'un large choix de salaisons d'Auvergne IGP ainsi que de fromages, confieries et autres spécialités régionales."
    ],
    "nl": [
      "Duw de deur van de 3 P'tits Cochons open en geniet van een ruime keuze aan vleeswaren van de IGP Auvergne, kazen, confituren en andere regionale specialiteiten."
    ],
    "es": [
      "Abra la puerta de los 3 P'tits Cochons y disfrute de una amplia selección de embutidos IGP Auvergne, así como de quesos, confitería y otras especialidades regionales."
    ]
  },
  "rdfs:label": {
