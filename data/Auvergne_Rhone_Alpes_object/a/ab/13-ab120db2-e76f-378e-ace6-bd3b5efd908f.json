  "rdfs:comment": {
    "de": [
      "Entdecken Sie eine Produktion in menschlicher Größe. Wir bieten unseren Kunden Qualitätsfleisch (Rind, Kalb, Lamm, Schwein und Geflügel), sowie Wurstwaren und Feinkost an."
    ],
    "en": [
      "Discover a production on a human scale. We offer our customers quality meat (beef, veal, lamb, pork and poultry), as well as charcuterie and delicatessen products."
    ],
    "it": [
      "Scoprite una produzione a misura d'uomo. Offriamo ai nostri clienti carne di qualità (manzo, vitello, agnello, maiale e pollame), oltre a salumi e prodotti di gastronomia."
    ],
    "fr": [
      "Découvrez une production à taille humaine. Nous proposons à nos clients de la viande de qualité (Bœuf, Veau, Agneau, Porc et volaille), ainsi que de la charcuterie et du traiteur."
    ],
    "nl": [
      "Ontdek een productie op menselijke schaal. Wij bieden onze klanten kwaliteitsvlees (rundvlees, kalfsvlees, lamsvlees, varkensvlees en gevogelte), evenals vleeswaren en delicatessen."
    ],
    "es": [
      "Descubra una producción a escala humana. Ofrecemos a nuestros clientes carne de calidad (vacuno, ternera, cordero, cerdo y aves de corral), así como productos de charcutería y delicatessen."
    ]
  },
