  "rdfs:comment": {
    "de": [
      "Treffen Sie alle Ihre Lieblings-Disney-Figuren auf 2 kinderfreundlichen Spielbereichen. Treffpunkt ist an der Abfahrt des Skilifts Les Essarts und unter der Ankunft des Sessellifts La Colomba."
    ],
    "en": [
      "Find all your favorite Disney characters in 2 children's areas. Meeting point is at the departure of the Essarts ski lift and a little below the arrival of La Colomba."
    ],
    "it": [
      "Trova tutti i tuoi personaggi Disney preferiti su 2 aree adatte ai bambini. Ritrovo alla partenza dell'impianto di risalita Essarts e sotto l'arrivo della seggiovia Colomba."
    ],
    "fr": [
      "Retrouvez tous vos personnages Disney préférés sur 2 espaces ludiques adaptés aux enfants. Rendez-vous au départ du téléski des Essarts et sous l'arrivée du télésiège de la Colomba."
    ],
    "nl": [
      "Vind al je favoriete Disney-figuren in 2 pistes op maat van kinderen. Ontmoet elkaar aan het begin van de Essarts-skilift en iets onder de finish van Colomba."
    ],
    "es": [
      "Conozca a todos sus personajes Disney favoritos en 2 zonas de juego especialmente diseñadas para los niños. Encuéntrate al principio del telesilla Essarts y debajo del final del telesilla Colomba."
    ]
  },
  "rdfs:label": {
    "en": [
