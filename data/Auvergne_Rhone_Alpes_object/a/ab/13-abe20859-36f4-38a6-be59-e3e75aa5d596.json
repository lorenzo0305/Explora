  "rdfs:comment": {
    "de": [
      "Als Bio-Bauern in den Bergen bieten wir Saisongemüse, Kräutertees, Marmeladen, Coulis und Sirupe auf dem Markt freitags und sonntags in Megève an. Für den Verkauf ab Hof kontaktieren Sie uns bitte telefonisch oder auf dem Markt."
    ],
    "en": [
      "Organic farmers in the mountains, we offer seasonal vegetables, herbal teas, jams, coulis, and syrups at the market on Fridays and Sundays in Megève. For farm sales, please contact us by phone or at the market."
    ],
    "it": [
      "Agricoltori biologici di montagna, proponiamo verdure di stagione, tisane, marmellate, coulis e sciroppi al mercato, il venerdì e la domenica a Megève. Per la vendita in fattoria, contattateci telefonicamente o al mercato."
    ],
    "fr": [
      "Agriculteurs biologiques en montagne, nous proposons des légumes de saison, tisanes, confitures, coulis et sirops sur le marché, les vendredis et dimanches à Megève. Pour la vente à la ferme, contactez-nous par téléphone ou sur le marché."
    ],
    "es": [
      "Como agricultores ecológicos de montaña, vendemos verduras de temporada, infusiones, mermeladas, coulis y siropes en el mercado de Megève los viernes y domingos. Para ventas en la granja, contacte con nosotros por teléfono o en el mercado."
    ],
    "nl": [
      "Als biologische boeren in de bergen verkopen we seizoensgroenten, kruidenthee, jam, coulis en siroop op de markt in Megève op vrijdag en zondag. Neem voor verkoop op de boerderij telefonisch of op de markt contact met ons op."
    ]
  },
