  "rdfs:comment": {
    "de": [
      "Neu! Ihr Fahrrad schlummert schon viel zu lange in der hintersten Ecke der Garage, die Bremsen sind auf Halbmast, die Reifen platt? Wir haben eine Lösung für Sie."
    ],
    "en": [
      "New! Has your bike been lying dormant in the garage for too long, brakes at half-mast, tires flat? We've got the solution."
    ],
    "it": [
      "Nuovo! La vostra moto è rimasta inattiva in garage per troppo tempo, con i freni a metà e le gomme sgonfie? Abbiamo la soluzione."
    ],
    "fr": [
      "Nouveau ! Votre vélo sommeille depuis trop longtemps au fond du garage, les freins en berne, les pneus à plat ? On a une solution."
    ],
    "es": [
      "Novedad ¿Tu moto lleva demasiado tiempo inactiva en el garaje, con los frenos a medio gas y los neumáticos pinchados? Tenemos la solución."
    ],
    "nl": [
      "Nieuw! Staat je motor al te lang te slapen in de garage, remmen op halve kracht, banden lek? Wij hebben een oplossing."
    ]
  },
