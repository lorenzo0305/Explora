  "rdfs:comment": {
    "de": [
      "Ich bin Guide Animatrice de Terroir und biete Ihnen an, die Drôme Ardèche Provence auf originelle Weise zu entdecken."
    ],
    "en": [
      "As a Local Guide and Host, I offer you the opportunity to discover the region in an original way through themed walks that combine historical heritage, legends and stories, as well as local flora with the identification and gathering of medicinal plants."
    ],
    "it": [
      "Sono una guida locale e vorrei offrirvi un modo originale per scoprire la regione Drôme Ardèche Provence."
    ],
    "fr": [
      "Je suis Guide Animatrice de Terroir et je vous propose de découvrir de façon originale, la Drôme Ardèche Provence."
    ],
    "es": [
      "Soy guía local y me gustaría ofrecerle una forma original de descubrir la región de Drôme Ardèche Provence."
    ],
    "nl": [
      "Als lokale gids en animator bied ik u de mogelijkheid om de regio op een originele manier te ontdekken door thematische wandelingen die historisch erfgoed, legendes en verhalen combineren, evenals de lokale flora met herkenning en het plukken van medicinale planten."
    ]
