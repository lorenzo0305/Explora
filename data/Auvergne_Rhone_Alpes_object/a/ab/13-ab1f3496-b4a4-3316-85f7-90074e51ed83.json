  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Dorf Usson en Forez mit einer lustigen Orientierungskarte. 1 Karte, 2 Wege von 2 und 3 km. 30 Orientierungspunkte auf der Strecke mit Hilfe einer Liste von ungewöhnlichen Fotos zu finden und wiederzuerkenne"
    ],
    "en": [
      "Discover Usson en Forez thanks to a compass and a map. Observe monuments and landscape and play with photos."
    ],
    "it": [
      "Scoprite Usson-en-Forez su un divertente percorso di orienteering.\r\n1 mappa, 2 percorsi di 2 e 3 km. 30 waypoint da scoprire e riconoscere da un elenco di foto insolite del villaggio."
    ],
    "fr": [
      "Découvrez Usson-en-Forez à l'aide d'un parcours ludique d'orientation.\r\n1 carte, 2 parcours de 2 et 3 km. 30 points de passage à découvrir et reconnaître parmi une liste de photos insolites du village."
    ],
    "nl": [
      "Ontdek Usson-en-Forez op een leuke oriëntatieloop.\r\n1 kaart, 2 routes van 2 en 3 km. 30 waypoints om te ontdekken en te herkennen uit een lijst met bijzondere foto's van het dorp."
    ],
    "es": [
      "Descubra Usson-en-Forez en un divertido recorrido de orientación.\r\n1 mapa, 2 recorridos de 2 y 3 km. 30 waypoints para descubrir y reconocer a partir de una lista de fotos insólitas del pueblo."
    ]
  },
  "rdfs:label": {
    "de": [
      "Kulturerbe Orientierungslauf"
    ],
    "en": [
      "Heritage orienteering track"
    ],
    "fr": [
      "Parcours patrimoine d'orientation"
    ]
  },
