  "rdfs:comment": {
    "de": [
      "Holz- und Schiefergravuren. Ich stelle Holzgegenstände mit Gravuren her und verkaufe sie (Flaschenöffner, Schlüsselanhänger, Deko-Bilder, Topfuntersetzer ...).\r\nAuf Bestellung graviere ich auch Zeichnungen und Fotos Ihrer Wahl."
    ],
    "en": [
      "Engravings on wood and slate. I make and sell wooden objects with engravings (bottle-openers, key-hangers, key-rings, decorative pictures, trivets, etc.).\r\nI also engrave drawings and photos of your choice to order."
    ],
    "it": [
      "Incisioni su legno e ardesia. Realizzo e vendo oggetti in legno con incisioni (apribottiglie, portachiavi, portachiavi, quadri decorativi, sottopentole, ecc.)\r\nIncido anche disegni e foto di vostra scelta su ordinazione."
    ],
    "fr": [
      "Gravures sur bois et ardoises. Je fabrique et vends des objets en bois avec des gravures  (décapsuleur, accroches clés, porte clés, tableaux déco, dessous de plats…)\r\nJe grave aussi sur commande les dessins et photos de votre choix."
    ],
    "nl": [
      "Gravures op hout en leisteen. Ik maak en verkoop houten voorwerpen met gravures (flesopeners, sleutelhangers, sleutelhangers, decoratieve afbeeldingen, onderzetters, enz.)\r\nIk graveer ook tekeningen en foto's naar keuze op bestelling."
    ],
    "es": [
      "Grabados en madera y pizarra. Fabrico y vendo objetos de madera con grabados (abrebotellas, cuelgallaves, llaveros, cuadros decorativos, salvamanteles, etc.)\r\nTambién grabo por encargo dibujos y fotos de su elección."
    ]
  },
