  "rdfs:comment": {
    "de": [
      "Der in Europa einzigartige Eisturm erhebt sich im Tal von Champagny le Haut auf 1450 m Höhe vor den Toren des Nationalparks Vanoise."
    ],
    "en": [
      "The ice tower is unique in Europe. It was built in the valley of Champagny le Haut at an elevation of 1450 m, at the entrance to the Vanoise National Park."
    ],
    "it": [
      "Unica nel suo genere in Europa, la Torre di Ghiaccio si erge nella valle di Champagny le Haut a 1450 metri di altitudine, alle porte del Parco Nazionale della Vanoise."
    ],
    "fr": [
      "Unique en Europe, la Tour de glace se dresse dans le vallon de Champagny le Haut à 1450 mètres, aux portes du Parc national de la Vanoise."
    ],
    "es": [
      "Única en Europa, la Torre de Hielo se encuentra en el valle de Champagny le Haut, a 1.450 metros de altitud, a las puertas del Parque Nacional de la Vanoise."
    ],
    "nl": [
      "Uniek in Europa, staat de ijstoren sinds in de vallei van Champagny le Haut, op 1450 m hoogte, aan de poorten van het Parc National de la Vanoise."
    ]
  },
