  "rdfs:comment": {
    "de": [
      "Das Restaurant Notre Dame de l'Hermitage befindet sich auf 1100 m Höhe und empfängt Sie an einem Ort, der friedlich und mystisch zugleich ist. Nachdem Sie eine Küche mit madagassischen Ursprüngen genossen haben, können Sie die Umgebung genießen, die Panoramen und Spaziergänge bietet."
    ],
    "en": [
      "Located at an altitude of 1100m, the restaurant of Notre Dame de l'Hermitage welcomes you to a peaceful and mystical place. After enjoying a cuisine with Malagasy origins, you can enjoy the surroundings which offer panoramas and walks."
    ],
    "it": [
      "Situato a 1100 metri di altitudine, il ristorante Notre Dame de l'Hermitage vi accoglie in un luogo tranquillo e mistico. Dopo aver assaporato una cucina di origine malgascia, potrete godervi i dintorni che offrono panorami e passeggiate."
    ],
    "fr": [
      "Situé à 1100m d'altitude, le restaurant de Notre Dame de l'Hermitage vous accueille dans un lieu à la fois paisible et mystique. Après avoir savouré une cuisine aux origines Malgache, vous pourrez profiter des environs qui offrent panoramas et balades."
    ],
    "es": [
      "Situado a 1.100 metros de altitud, el restaurante Notre Dame de l'Hermitage le da la bienvenida a un lugar tan tranquilo como místico. Después de haber saboreado una cocina de origen malgache, podrá disfrutar de los alrededores que ofrecen panoramas y paseos."
    ],
    "nl": [
      "Het restaurant Notre Dame de l'Hermitage, gelegen op 1100 meter hoogte, verwelkomt u op een plek die zowel vredig als mystiek is. Na te hebben genoten van een keuken van Malagasy oorsprong, kunt u genieten van de omgeving die panorama's en wandelingen biedt."
    ]
  },
