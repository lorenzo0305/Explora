  "rdfs:comment": {
    "de": [
      "MADYA ist ein leidenschaftlicher Breakdance-Content-Ersteller, der in sozialen Netzwerken aktiv ist und seine Tanzvideos, Reisen und Projekte rund um die urbane Kultur mit anderen teilt. Er wird uns seine Arbeit vorstellen und in einem Workshop im zweiten Teil des Treffens sein Fachwissen über die Erstellung von Inhalten weitergeben."
    ],
    "en": [
      "MADYA is a content creator with a passion for breakdance. Active on social networks, he shares his dance videos, travels and projects around urban culture. He will be presenting his work and sharing his expertise on content creation during the workshop in the second half of the Rencontre."
    ],
    "it": [
      "MADYA è una creatrice di contenuti con la passione per la breakdance. Attiva sui social network, condivide i suoi video di danza, i suoi viaggi e i suoi progetti sulla cultura urbana. Presenterà il suo lavoro e condividerà la sua esperienza sulla creazione di contenuti durante il workshop nella seconda parte della Rencontre."
    ],
    "fr": [
      "MADYA est un créateur de contenu passionné de breakdance, actif sur les réseaux sociaux, il partage ses vidéos de danse, ses voyages et projets autour de la culture urbaine. Il viendra nous présenter son travail, mais aussi partager son expertise sur la création de contenu lors de l’atelier en deuxième partie de la Rencontre."
    ],
    "nl": [
      "MADYA is een content creator met een passie voor breakdance. Actief op sociale netwerken deelt hij zijn dansvideo's, zijn reizen en zijn projecten rond urban culture. Hij zal zijn werk presenteren en zijn expertise over het maken van content delen tijdens de workshop in de tweede helft van de Rencontre."
    ],
    "es": [
      "MADYA es un creador de contenidos apasionado por el breakdance. Activo en las redes sociales, comparte sus vídeos de baile, sus viajes y sus proyectos en torno a la cultura urbana. Presentará su trabajo y compartirá su experiencia en la creación de contenidos durante el taller de la segunda mitad de la Rencontre."
    ]
  },
