  "rdfs:comment": {
    "de": [
      "Restaurant und festliche Après-Ski-Bar, La Grotte du Yéti empfängt Sie mit Menüs zu kleinen Preisen (Savoyarden, Burger, Pizza), vor Ort oder zum Mitnehmen. Clubbing-Bar nach der Rückkehr von den Pisten und von 22 Uhr bis 2 Uhr. Folgen Sie uns auf den Netzwerken!"
    ],
    "en": [
      "Restaurant and après-ski party bar, La Grotte du Yéti welcomes you with friendly-priced menus (savoyard dishes, burgers, pizzas), for dine-in or take-away. Enjoy a clubbing experience, just after skiing, and from 10 pm to 2am. Follow us on social media!"
    ],
    "it": [
      "Ristorante festoso e bar per il doposci, La Grotte du Yéti propone menu a basso prezzo (savoiardi, hamburger, pizze), da consumare o da portare via. Bar per discoteche al ritorno dalle piste, dalle 22.00 alle 2.00. Seguiteci sul web!"
    ],
    "fr": [
      "Restaurant et après-ski bar festif, La Grotte du Yéti vous accueille autour de menus à petits prix (savoyards, burgers, pizzas), sur place ou à emporter. Bar clubbing dès le retour des pistes, et de 22h à 02h. Suivez-nous sur les réseaux !"
    ],
    "es": [
      "Restaurante festivo y bar après-ski, La Grotte du Yéti ofrece menús económicos (saboyanas, hamburguesas, pizzas), para comer o llevar. Bar de copas a la vuelta de las pistas, de 22.00 a 2.00 h. ¡Síguenos en la web!"
    ],
    "nl": [
      "La Grotte du Yéti, een feestelijk restaurant en après-ski bar, biedt voordelige menu's (Savoyard, hamburgers, pizza's) om te eten of mee te nemen. Clubbar zodra je terugkomt van de piste, van 22.00 tot 02.00 uur. Volg ons op internet!"
    ]
  },
