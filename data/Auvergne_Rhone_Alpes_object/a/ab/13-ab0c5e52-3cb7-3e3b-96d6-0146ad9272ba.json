  "rdfs:comment": {
    "de": [
      "In der Nähe des Kongresszentrums Eurexpo und des Groupama Stadiums entdecken Sie 106 helle und geräumige Zimmer, 3 modulierbare Tagungsräume, ein Restaurant, eine Bar, einen Wellness-Bereich, einen Kids-Bereich und einen Parkplatz..."
    ],
    "en": [
      "Close to the Eurexpo Congress Centre and Groupama Stadium, discover 106 bright and spacious rooms, a restaurant, 3 meeting rooms, a bar, a wellness area, a Kids area and a car park..."
    ],
    "it": [
      "Vicino al Centro Congressi Eurexpo e allo Stadio Groupama, scoprite 106 camere luminose e spaziose, 3 sale riunioni flessibili, un ristorante, un bar, un'area benessere, un'area Kids e un parcheggio..."
    ],
    "fr": [
      "A proximité du Centre de Congrès Eurexpo et du Groupama Stadium, découvrez 106 chambres lumineuses et spacieuses, 3 salles de réunion modulables, un restaurant, un bar, un espace bien-être, un espace Kids et un parking..."
    ],
    "nl": [
      "Vlakbij het Eurexpo Congrescentrum en het Groupama Stadion, ontdek 106 lichte en ruime kamers, 3 flexibele vergaderzalen, een restaurant, een bar, een wellnessruimte, een kinderruimte en een parkeergarage..."
    ],
    "es": [
      "Cerca del centro de congresos Eurexpo y del estadio Groupama, descubra 106 habitaciones luminosas y espaciosas, 3 salas de reuniones flexibles, un restaurante, un bar, una zona de bienestar, una zona infantil y un aparcamiento..."
    ]
  },
