  "rdfs:comment": {
    "de": [
      "Erleben Sie zwei Tage lang einen großen italienischen Moment beim 1. Little Italy Festival in Saint-Jean-de-Maurienne. Auf dem Programm stehen Konzerte, Kino, literarischer Austausch, Sportbegegnungen und ein französisch-italienisches Dorf!"
    ],
    "en": [
      "Enjoy two days of Italian delights at the 1st Little Italy Festival in Saint-Jean-de-Maurienne. On the program: concerts, cinema, literary exchanges, sporting events and a Franco-Italian village!"
    ],
    "it": [
      "Godetevi due giorni di delizie italiane al 1° Festival della Piccola Italia di Saint-Jean-de-Maurienne. In programma: concerti, cinema, scambi letterari, eventi sportivi e un villaggio franco-italiano!"
    ],
    "fr": [
      "Vivez un grand moment italien pendant deux jours, à l'occasion de la 1ère édition du Little Italy Festival à Saint-Jean-de-Maurienne. Au programme : des concerts, du cinéma, des échanges littéraires, des rencontres sportives et un village franco-italien !"
    ],
    "nl": [
      "Geniet twee dagen van Italiaanse lekkernijen tijdens het 1e Little Italy Festival in Saint-Jean-de-Maurienne. Op het programma: concerten, film, literaire uitwisselingen, sportevenementen en een Frans-Italiaans dorp!"
    ],
    "es": [
      "Disfrute de dos días de delicias italianas en el 1er Festival Little Italy de Saint-Jean-de-Maurienne. En el programa: conciertos, cine, intercambios literarios, eventos deportivos y un pueblo franco-italiano"
    ]
  },
