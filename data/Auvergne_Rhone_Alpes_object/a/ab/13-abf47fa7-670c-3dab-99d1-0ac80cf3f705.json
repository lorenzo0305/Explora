  "rdfs:comment": {
    "de": [
      "Finden Sie den Pizzatruck :\r\nAm Dienstag in Villargondran\r\nAm Mittwoch in Hermillon\r\nAm Donnerstag in Sainte-Marie-de-Cuines\r\nAm Freitag in Épierre\r\nAm Samstag in Saint-Avre\r\nAm Sonntag in Saint-Rémy-de-Maurienne.\r\nTelefonische Bestellung ab 17:30 Uhr."
    ],
    "en": [
      "Visit the pizza truck:\r\nTuesdays in Saint-Julien-Montdenis\r\nWednesday in Hermillon\r\nThursday, Sainte-Marie-de-Cuines\r\nFriday at Épierre\r\nSaturday at Saint-Avre\r\nSunday, Saint-Rémy-de-Maurienne.\r\nTelephone orders from 5:30pm."
    ],
    "it": [
      "Visita al camioncino della pizza:\r\nMartedì a Villargondran\r\nMercoledì a Hermillon\r\nGiovedì a Sainte-Marie-de-Cuines\r\nVenerdì a Épierre\r\nSabato a Saint-Avre\r\nDomenica a Saint-Rémy-de-Maurienne.\r\nOrdini telefonici dalle 17.30."
    ],
    "fr": [
      "Retrouvez le camion à pizzas :\r\nLe mardi à Villargondran\r\nLe mercredi à Hermillon\r\nLe jeudi à Sainte-Marie-de-Cuines\r\nLe vendredi à Épierre\r\nLe samedi à Saint-Avre\r\nLe dimanche à Saint-Rémy-de-Maurienne.\r\nCommande par téléphone à partir de 17h30."
    ],
    "es": [
      "Visita el camión de la pizza:\r\nMartes en Villargondran\r\nMiércoles en Hermillon\r\nJueves en Sainte-Marie-de-Cuines\r\nViernes en Épierre\r\nSábado en Saint-Avre\r\nDomingo en Saint-Rémy-de-Maurienne.\r\nPedidos por teléfono a partir de las 17.30 h."
    ],
    "nl": [
      "Bezoek de pizzatruck:\r\nDinsdag in Villargondran\r\nWoensdag in Hermillon\r\nDonderdag in Sainte-Marie-de-Cuines\r\nVrijdag in Épierre\r\nZaterdag in Saint-Avre\r\nZondag in Saint-Rémy-de-Maurienne.\r\nTelefonische bestellingen vanaf 17.30 uur."
    ]
