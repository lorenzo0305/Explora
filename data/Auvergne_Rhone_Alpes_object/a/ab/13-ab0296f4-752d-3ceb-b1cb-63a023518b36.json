  "rdfs:comment": {
    "de": [
      "6 zugelassene Bahnen mit Scorern*, Bumpern** für Kinder ab 7 Jahren (Schuhe ab Größe 30).\r\nEine Bowlingbahn, die auch für Personen mit eingeschränkter Mobilität zugänglich ist.\r\n\r\nKeine Reservierung möglich."
    ],
    "en": [
      "6 approved lanes with scorers*, bumpers** for children aged 7 and over (shoe size 30 and over).\r\nA bowling alley accessible to people with reduced mobility.\r\n\r\nNo reservations possible."
    ],
    "it": [
      "6 piste omologate con segnapunti*, paracolpi** per bambini a partire dai 7 anni (scarpe a partire dal numero 30).\r\nUna pista da bowling accessibile alle persone a mobilità ridotta.\r\n\r\nNon è possibile prenotare."
    ],
    "fr": [
      "6 pistes homologuées avec scorers*, bumpers** pour les enfants à partir de 7 ans (chaussures à partir de la pointure 30).\r\nUne piste de bowling accessible aux personnes à mobilité réduite.\r\n\r\nPas de réservation possible."
    ],
    "es": [
      "6 pistas homologadas con anotadores*, parachoques** para niños a partir de 7 años (zapatos a partir de la talla 30).\r\nUna bolera accesible para personas con movilidad reducida.\r\n\r\nNo es posible reservar."
    ],
    "nl": [
      "6 goedgekeurde banen met scorers*, bumpers** voor kinderen vanaf 7 jaar (schoenen vanaf maat 30).\r\nEen bowlingbaan die toegankelijk is voor mensen met beperkte mobiliteit.\r\n\r\nGeen reserveringen mogelijk."
    ]
  },
  "rdfs:label": {
