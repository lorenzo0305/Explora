  "rdfs:comment": {
    "de": [
      "22. Juni 1940: Der in Rethondes unterzeichnete Waffenstillstand besiegelt die militärische Niederlage Frankreichs und das Ende der militärischen Offensive Deutschlands."
    ],
    "en": [
      "June 22nd 1940: the armistice signed in Rethondes seals France's military defeat and the end of Germany's military offensive."
    ],
    "it": [
      "22 giugno 1940: l'armistizio firmato a Rethondes sancisce la sconfitta militare della Francia e la fine dell'offensiva militare tedesca."
    ],
    "fr": [
      "Le 22 juin 1940 : l’armistice signé à Rethondes scelle la défaite militaire de la France et la fin de l’offensive militaire de l’Allemagne."
    ],
    "nl": [
      "22 juni 1940: de in Rethondes ondertekende wapenstilstand bezegelt de militaire nederlaag van Frankrijk en het einde van het Duitse militaire offensief."
    ],
    "es": [
      "22 de junio de 1940: el armisticio firmado en Rethondes sella la derrota militar de Francia y el fin de la ofensiva militar alemana."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite guidée : \"Vichy, Capitale de l'Etat français 40/44\""
    ]
  },
