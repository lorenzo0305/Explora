  "rdfs:comment": {
    "de": [
      "Anlässlich der Europäischen Tage der Kunsthandwerke veranstaltet das Atelier Bleu eine vorübergehende Ausstellung, die zwei fotografische Ansätze rund um die Farbe Blau vereint!"
    ],
    "en": [
      "To mark the Journées Européennes des Métiers d'Arts, Atelier Bleu is hosting an ephemeral exhibition featuring two photographic approaches to the color blue!"
    ],
    "it": [
      "In occasione delle Journées Européennes des Métiers d'Arts, Atelier Bleu ospita una mostra temporanea con due approcci fotografici al colore blu!"
    ],
    "fr": [
      "A l'occasion des Journées Européennes des Métiers d'Arts, l'Atelier Bleu accueille une exposition éphémère réunissant deux approches photographiques autour de la couleur bleu !"
    ],
    "nl": [
      "Naar aanleiding van de Journées Européennes des Métiers d'Arts organiseert Atelier Bleu een tijdelijke tentoonstelling met twee fotografische benaderingen van de kleur blauw!"
    ],
    "es": [
      "Con motivo de las Journées Européennes des Métiers d'Arts, Atelier Bleu organiza una exposición temporal con dos aproximaciones fotográficas al color azul"
    ]
  },
  "rdfs:label": {
