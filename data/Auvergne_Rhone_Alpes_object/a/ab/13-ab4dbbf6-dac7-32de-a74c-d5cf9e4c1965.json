  "rdfs:comment": {
    "de": [
      "Bei La Belle Roulotte können Sie trinken, essen und Ihr Zelt für einen Biwakstopp aufschlagen, sich in einer Hängematte ausruhen, an Wellness-Aktivitäten teilnehmen, den Kunsthandwerksmarkt und die kulturellen Veranstaltungen entdecken. Hausgemachte Küche mit lokalen Produkten"
    ],
    "en": [
      "At La Belle Roulotte you can drink, eat and pitch your tent for a bivouac stopover, relax in a hammock, take part in wellness activities, discover its craft market & cultural events. Home cooking with local produce"
    ],
    "it": [
      "A La Belle Roulotte potrete bere, mangiare e piantare la tenda per una sosta bivacco, rilassarvi su un'amaca, partecipare ad attività di benessere e scoprire il suo mercato artigianale e gli eventi culturali. Cucina casalinga con prodotti locali"
    ],
    "fr": [
      "Chez La Belle Roulotte vous pourrez boire, manger et poser votre tente pour une halte bivouac, vous reposer dans un hamac, participer aux activités bien-être, découvrir son marché artisanal & ses animations culturelles. Cuisine maison avec produits locaux"
    ],
    "es": [
      "En La Belle Roulotte podrá beber, comer y montar su tienda para hacer una parada vivac, relajarse en una hamaca, participar en actividades de bienestar y descubrir su mercado artesanal y sus eventos culturales. Cocina casera con productos locales"
    ],
    "nl": [
      "Bij La Belle Roulotte kun je drinken, eten en je tent opzetten voor een bivakstop, ontspannen in een hangmat, deelnemen aan wellnessactiviteiten en de ambachtelijke markt en culturele evenementen ontdekken. Thuis koken met lokale producten"
    ]
  },
  "rdfs:label": {
