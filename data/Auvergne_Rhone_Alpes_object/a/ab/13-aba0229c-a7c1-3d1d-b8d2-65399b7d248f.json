  "rdfs:comment": {
    "de": [
      "Willkommen im Restaurant Belle Rive in Charavines: traditionelle hausgemachte und saisonale Küche. Heiße Getränke, Eis und Cocktails können Sie auf einer Terrasse mit atemberaubendem Blick auf den Lac de Paladru genießen. Gesellige Atmosphäre für Groß und Klein garantiert!"
    ],
    "en": [
      "Come and discover the \"beauty shore\" of Charavines : Belle Rive restaurant. Traditional cuisine homemade and modeled by seasons including : tasty hot drinks, ice creams and cocktails to enjoy while seating on a terrace facing the lake. Warm and cosy mood open for all !"
    ],
    "it": [
      "Benvenuti al ristorante Belle Rive di Charavines: cucina tradizionale casalinga di stagione. Bevande calde, gelati e cocktail possono essere gustati sulla terrazza con una vista mozzafiato sul lago Paladru. Un'atmosfera amichevole garantita per grandi e piccini!"
    ],
    "fr": [
      "Bienvenue au restaurant Belle Rive à Charavines : cuisine traditionnelle maison et de saison. Boissons chaudes, glaces et cocktails à savourer sur une terrasse avec vue imprenable sur le lac de Paladru. Ambiance conviviale garantie pour petits et grands !"
    ],
    "nl": [
      "Welkom in het Belle Rive restaurant in Charavines: traditionele huisgemaakte seizoensgerechten. Warme dranken, ijsjes en cocktails kunnen worden genuttigd op het terras met een adembenemend uitzicht over het meer van Paladru. Een gezellige sfeer gegarandeerd voor jong en oud!"
    ],
    "es": [
      "Bienvenido al restaurante Belle Rive de Charavines: cocina casera tradicional de temporada. Las bebidas calientes, los helados y los cócteles se pueden degustar en la terraza con impresionantes vistas al lago Paladru. Un ambiente agradable garantizado para grandes y pequeños"
    ]
  },
