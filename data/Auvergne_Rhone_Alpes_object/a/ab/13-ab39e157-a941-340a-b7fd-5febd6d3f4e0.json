  "rdfs:comment": {
    "de": [
      "Im Herzen des Atriums des Appart City Confort Lyon Part-Dieu lädt Sie das Le Bistrot City ein, seine raffinierte regionale Küche zu entdecken, die von einem Lyoner Chefkoch in einem schicken und entspannten Rahmen zubereitet wird."
    ],
    "en": [
      "Situated inside the Appart City Confort Lyon Part-Dieu hotel, Bistrot City restaurant invites you to discover its refined local cuisine produced by a Lyonnais chef in a stylish, relaxing setting."
    ],
    "it": [
      "Nel cuore dell'atrio di Park and Suites, Bistrot City ti invita a scoprire la sua raffinata cucina regionale elaborata da uno chef lionese in un'ambientazione chic e informale."
    ],
    "fr": [
      "Au cœur de l’atrium de l'Appart City Confort Lyon Part-Dieu, Le Bistrot City vous invite à découvrir sa cuisine du terroir raffinée, élaborée par un chef lyonnais dans un cadre chic et décontracté."
    ],
    "nl": [
      "In het hart van het atrium van het Appart City Confort Lyon Part-Dieu nodigt Le Bistrot City u uit om zijn verfijnde lokale keuken te ontdekken, bereid door een chef-kok uit Lyon in een chique en ontspannen kader."
    ],
    "es": [
      "En el atrio del Park and Suites, Bistrot City propone una cocina de la tierra, refinada, elaborada por un chef lionés en un entorno elegante y relajado."
    ]
  },
