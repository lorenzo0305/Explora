  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/766e4f4c-ceae-38e1-80d0-6183ee5d257d",
      "dc:description": {
        "de": [
          "Informationen :\n\nProdukte :\n\nBella Italia bietet Ihnen in Selbstbedienung Pizzas zum Mitnehmen an\n\nTage der Öffnung:\n\n24 Stunden am Tag, 7 Tage die Woche.\n\n\n "
        ],
        "en": [
          "Information :\n\nProducts :\n\nBella Italia offers self-service takeaway pizzas\n\nOpening days:\n\nOpen 24/7.\n\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nProdotti :\n\nBella Italia offre pizze da asporto self-service\n\nGiorni di apertura:\n\nAperto 24 ore su 24, 7 giorni su 7.\n\n\n "
        ],
        "fr": [
          "Informations : \n\nProduits :\n\nBella Italia vous propose, en libre service, des pizzas à emporter\n\nJours d'ouverture: \n\nAccessible 24h/24 et 7 jours/7.\n\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nProducten :\n\nBella Italia biedt afhaalpizza's voor zelfbediening\n\nOpeningsdagen:\n\n24 uur per dag, 7 dagen per week geopend.\n\n\n "
        ],
        "es": [
          "Más información :\n\nProductos :\n\nBella Italia ofrece pizzas para llevar en autoservicio\n\nDías de apertura:\n\nAbierto 24 horas al día, 7 días a la semana.\n\n\n "
        ]
      },
