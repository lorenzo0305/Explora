  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/606fb826-bb7c-3b9e-966a-c6d37d1074ee",
      "dc:description": {
        "de": [
          "Fahren Sie vom Fremdenverkehrsamt aus die 22 km (hin und zurück) der Fahrradroute des Bassin Minier ab, begleitet von Julien Lahaye und seinen musikalischen Einlagen."
        ],
        "en": [
          "Starting from the Tourist Office, you will ride the 22 km (round trip) of the \"Bassin Minier\" bicycle route accompanied by Julien Lahaye and his musical punctuations."
        ],
        "it": [
          "Partendo dall'Ufficio del Turismo, percorrete i 22 km della pista ciclabile del Bassin Minier accompagnati da Julien Lahaye e dalla sua musica."
        ],
        "fr": [
          "Au départ de l’Office de Tourisme parcourez les 22kms (aller-retour) de la vélo route du Bassin minier accompagné de Julien Lahaye et de ses ponctuations musicales."
        ],
        "nl": [
          "Vertrek vanaf het Office du Tourisme en fiets de 22 km lange route van het Bassin Minier onder begeleiding van Julien Lahaye en zijn muzikale begeleiding."
        ],
        "es": [
          "Saliendo de la Oficina de Turismo, recorra los 22 km de ida y vuelta de la ruta ciclista de Bassin Minier acompañado por Julien Lahaye y su acompañamiento musical."
        ]
      },
