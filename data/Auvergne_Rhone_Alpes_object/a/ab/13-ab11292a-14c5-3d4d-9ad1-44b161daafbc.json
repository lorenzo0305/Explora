  "rdfs:comment": {
    "de": [
      "Entdecken Sie beim Klang der Schellen das Dorf Combloux einmal anders.\r\nIn einer bequemen Kutsche sitzend, fahren Sie 45 Minuten lang los, um die verschiedenen Landschaften und Weiler von Combloux zu entdecken: Le Feug, Gemoens und Prairy und 15 Minuten Besuch des Zentrums."
    ],
    "en": [
      "Enjoy a ride in a horse-drawn carriage and discovery, during one hour, the differents village landscapes."
    ],
    "it": [
      "Goditi un giro in carrozza e scopri, per un'ora, i diversi paesaggi del villaggio."
    ],
    "fr": [
      "Au son des grelots, découvrez le village de Combloux autrement.\r\nAssis dans une calèche confortable, partez pendant 45 min découvrir les différents paysages et hameaux de Combloux : Le Feug, Gemoens et Prairy et 15 min de visite du centre."
    ],
    "nl": [
      "Ontdek op het ritme van de klokken het dorp Combloux op een andere manier.\r\nIn een comfortabele paardenkoets ontdek je in 45 minuten de verschillende landschappen en gehuchten van Combloux: Le Feug, Gemoens en Prairy en in 15 minuten het centrum."
    ],
    "es": [
      "Al son de las cascabeles, descubra el pueblo de Combloux de otra manera.\r\nSentados en un cómodo carruaje, recorran durante 1 hora los diferentes paisajes y aldeas de Combloux: Le Feug, Gemoens y Prairy."
    ]
  },
  "rdfs:label": {
    "en": [
      "Discovery of the village with a horse-drawn carriage ride"
    ],
    "it": [
      "Giro in carrozza nel villaggio"
    ],
    "fr": [
      "Balade en calèche dans le village"
    ],
    "es": [
      "Paseo en carruaje por el pueblo"
    ]
  },
