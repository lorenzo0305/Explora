  "rdfs:comment": {
    "de": [
      "Dieser Weg, der sich in der Gemeinde Audes befindet, bietet eine Naturwanderung im Herzen der Bocages. Er richtet sich an diejenigen, die eine ländliche Route mit kleinen Entdeckungen des Kulturerbes genießen möchten."
    ],
    "en": [
      "This trail, located in the commune of Audes, offers a nature walk in the heart of the bocages. It is aimed at those who wish to enjoy a rural itinerary punctuated by small heritage discoveries."
    ],
    "it": [
      "Questo sentiero, situato nel comune di Audes, propone una passeggiata naturalistica nel cuore dei bocages. Si rivolge a coloro che desiderano godere di un itinerario rurale punteggiato da piccole scoperte del patrimonio."
    ],
    "fr": [
      "Ce parcours situé sur la commune d'Audes, propose une balade nature au coeur des bocages. Il s'adresse à ceux qui souhaitent profiter d'un itinéraire rural ponctué de petites découvertes patrimoniales."
    ],
    "es": [
      "Este sendero, situado en el municipio de Audes, ofrece un paseo por la naturaleza en el corazón de los bocages. Está dirigido a quienes deseen disfrutar de un itinerario rural salpicado de pequeños descubrimientos patrimoniales."
    ],
    "nl": [
      "Dit wandelpad in de gemeente Audes biedt een natuurwandeling in het hart van de bocages. Het is bedoeld voor wie wil genieten van een landelijke route met kleine erfgoedontdekkingen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "PR1 Circuit à la découverte des Châteaux"
    ]
  },
