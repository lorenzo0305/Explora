      "dc:description": {
        "de": [
          "restaurant im Gartengeschoss des Hôtel du Golf d'Arras *** mit atemberaubendem Blick auf den Golfplatz<br><br>Organisation aller Arten von Veranstaltungen sowohl im familiären als auch im geschäftlichen Bereich"
        ],
        "en": [
          "restaurant located on the garden floor of the Hotel du Golf d'Arras *** with a breathtaking view of the Golf course<br><br>Organisation of all types of events, both family and business events"
        ],
        "it": [
          "ristorante situato al livello del giardino dell'Hôtel du Golf d'Arras *** con una vista mozzafiato sul campo da golf<br><br>Organizzazione di tutti i tipi di eventi, sia familiari che professionali"
        ],
        "fr": [
          "restaurant situé au rez-de-jardin de l'Hôtel du Golf d'Arras *** avec vue imprenable sur le Golf<br><br>Organisation de tout type d'évènements aussi bien familiaux que professionnels"
        ],
        "es": [
          "restaurante situado en el nivel del jardín del Hôtel du Golf d'Arras *** con una vista impresionante del campo de golf<br><br>Organización de todo tipo de eventos, tanto familiares como profesionales"
        ],
        "nl": [
          "restaurant gelegen op het tuinniveau van het Hôtel du Golf d'Arras *** met een adembenemend uitzicht op de golfbaan<br><br>Organisatie van alle soorten evenementen, zowel familiaal als professioneel"
        ]
      },
