  "rdfs:comment": {
    "de": [
      "Nach vier Saisons der Schließung und einer umfangreichen Renovierung übernehmen Corinne und Rémi (die dritte Generation der Familie Jay) stolz die Fackel."
    ],
    "en": [
      "After four seasons of closure and extensive renovation, Corinne and Rémi (the third generation of the Jay family) are proudly taking up the torch."
    ],
    "it": [
      "Dopo la chiusura per 4 stagioni e i lavori di ristrutturazione, Corinne e Rémi (la terza generazione della famiglia Jay) sono orgogliosi di riprendere in mano la torcia."
    ],
    "fr": [
      "Après 4 saisons de fermeture et une vaste rénovation, Corinne et Rémi (la troisième génération de la famille Jay) reprennent fièrement le flambeau."
    ],
    "es": [
      "Tras cerrar durante 4 temporadas y someterse a extensas obras de renovación, Corinne y Rémi (la tercera generación de la familia Jay) retoman con orgullo la antorcha."
    ],
    "nl": [
      "Na 4 seizoenen gesloten te zijn geweest en uitgebreide renovatiewerkzaamheden te hebben ondergaan, nemen Corinne en Rémi (de derde generatie van de familie Jay) trots de fakkel weer over."
    ]
  },
