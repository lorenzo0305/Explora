  "rdfs:comment": {
    "de": [
      "Entdecken Sie unsere Region auf den zahlreichen Wanderungen, die wir anbieten, mit dem besten Reisebegleiter, den es gibt: dem Esel, der hauptsächlich Ihr Gepäck tragen wird!"
    ],
    "en": [
      "Come and discover our region through the many hikes we offer, with the best travel companion there is: the donkey that will essentially carry your luggage!"
    ],
    "it": [
      "Venite a scoprire la nostra regione attraverso le numerose escursioni che proponiamo, con il miglior compagno di viaggio che ci sia: l'asino che porterà essenzialmente i vostri bagagli!"
    ],
    "fr": [
      "Venez découvrir notre région à travers les nombreuses randonnées que nous proposons, avec le meilleur compagnon de voyage qui soit : l'âne qui portera essentiellement vos bagages !"
    ],
    "es": [
      "Venga a descubrir nuestra región a través de las numerosas excursiones que ofrecemos, con el mejor compañero de viaje que existe: ¡el burro que esencialmente llevará su equipaje!"
    ],
    "nl": [
      "Kom en ontdek onze regio via de vele wandelingen die wij aanbieden, met de beste reisgenoot die er is: de ezel die in wezen uw bagage draagt!"
    ]
  },
