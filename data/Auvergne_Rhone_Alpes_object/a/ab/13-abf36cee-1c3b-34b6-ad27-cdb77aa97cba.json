  "rdfs:comment": {
    "de": [
      "Erkunden Sie den schwarzen Parcours der Base de Lavalette: 1,2 km leichter Orientierungslauf an 18 Markierungen vorbei, zwischen Felsen, Wäldchen und Wegen. Ideal, um die Natur zu entdecken und sich mit dem Orientierungslauf vertraut zu machen."
    ],
    "en": [
      "Explore the black course at Base de Lavalette: 1.2 km of easy orienteering through 18 markers, between rocks, copses and paths. Ideal for discovering nature and learning orienteering."
    ],
    "it": [
      "Esplorate il percorso nero della Base de Lavalette: 1,2 km di orienteering facile, attraverso 18 punti, tra rocce, boschetti e sentieri. Ideale per scoprire la natura e imparare l'orienteering."
    ],
    "fr": [
      "Explorez le parcours noir de la Base de Lavalette : 1,2 km d’orientation facile à travers 18 balises, entre rochers, bosquets et chemins. Idéal pour découvrir la nature et s’initier à la course d’orientation."
    ],
    "nl": [
      "Ontdek het zwarte parcours van de Base de Lavalette: 1,2 km gemakkelijk oriëntatielopen langs 18 markeringen, tussen rotsen, bosjes en paden. Ideaal om de natuur te ontdekken en oriëntatielopen te leren."
    ],
    "es": [
      "Explore el recorrido negro de la Base de Lavalette: 1,2 km de orientación fácil a través de 18 balizas, entre rocas, bosquecillos y senderos. Ideal para descubrir la naturaleza y aprender orientación."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parcours noir d'orientation de Lavalette"
    ]
  },
