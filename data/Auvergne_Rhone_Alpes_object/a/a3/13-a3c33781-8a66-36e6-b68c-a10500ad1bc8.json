  "rdfs:comment": {
    "de": [
      "Concept Store im Herzen des Dorfes.\r\nHome & Kids Dekoration, Accessoires, lokale Designer.\r\nKurzwarenladen: Nähen, Wolle, Stickerei, kreative Freizeitgestaltung...\r\nNEU: Teestube mit hausgemachtem Gebäck, kalten und warmen Getränken, Frühstück"
    ],
    "en": [
      "Concept store in the heart of the village.\r\nHome & kids decoration, accessories, local designers.\r\nHaberdashery: sewing, wool, embroidery, creative hobbies...\r\nNEW: tea room with home-made pastries, hot & cold drinks, breakfasts."
    ],
    "it": [
      "Concept store nel cuore del villaggio.\r\nDecorazioni per la casa e i bambini, accessori, designer locali.\r\nMerceria: cucito, lana, ricamo, hobby creativi...\r\nNOVITÀ: sala da tè con dolci fatti in casa, bevande calde e fredde, colazioni"
    ],
    "fr": [
      "Concept store au cœur du village.\r\nDécoration home & kids, accessoires, créateurs locaux.\r\nMercerie : couture, laine, broderie, loisir créatif...\r\nNOUVEAU : salon de thé avec pâtisseries maison, boissons chaudes & froides, petits déjeuners"
    ],
    "nl": [
      "Conceptwinkel in het hart van het dorp.\r\nWoon- en kinderdecoratie, accessoires, lokale ontwerpers.\r\nFournituren: naaien, wol, borduren, creatieve hobby's...\r\nNIEUW: theesalon met zelfgemaakt gebak, warme en koude dranken, ontbijt."
    ],
    "es": [
      "Concept store en el corazón del pueblo.\r\nDecoración infantil y del hogar, accesorios, diseñadores locales.\r\nMercería: costura, lana, bordados, pasatiempos creativos...\r\nNUEVO: salón de té con bollería casera, bebidas frías y calientes, desayunos.."
    ]
