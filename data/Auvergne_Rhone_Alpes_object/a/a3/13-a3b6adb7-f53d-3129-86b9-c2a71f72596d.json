  "rdfs:comment": {
    "de": [
      "Die in Intres gelegene Lesestelle bietet den Einwohnern des Gebiets einen qualitativ hochwertigen und kundennahen Service und ist Teil des öffentlichen Lesenetzes von Val'Eyrieux."
    ],
    "en": [
      "The reading point offers a quality service and proximity to the inhabitants of the territory, and integrates the public reading network of Val'Eyrieux."
    ],
    "it": [
      "Il punto di lettura situato a Intres offre un servizio di qualità e locale agli abitanti della zona e fa parte della rete di lettura pubblica della Val'Eyrieux."
    ],
    "fr": [
      "Le point lecture situé à Intres offre un service de qualité et de proximité aux habitants du territoire, et intègre le réseau de lecture publique de Val'Eyrieux."
    ],
    "nl": [
      "Het leespunt in Intres biedt een kwalitatieve en lokale dienstverlening aan de inwoners van de streek en maakt deel uit van het openbare leesnetwerk van Val'Eyrieux."
    ],
    "es": [
      "El punto de lectura situado en Intres ofrece un servicio de calidad y de proximidad a los habitantes de la zona, y forma parte de la red de lectura pública de Val'Eyrieux."
    ]
  },
