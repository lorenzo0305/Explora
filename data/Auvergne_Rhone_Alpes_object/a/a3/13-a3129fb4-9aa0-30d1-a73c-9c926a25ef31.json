  "rdfs:comment": {
    "de": [
      "Le Domaine des Fauves ist ein familienfreundlicher Tierpark mit der größten Sammlung von pelzigen und gefiederten Raubtieren in der Region Rhône Alpes. Die Domaine des Fauves liegt 45 min von Lyon, 50 min von Grenoble und 30 min von Chambéry entfernt."
    ],
    "en": [
      "A family scaled zoo presenting furry and feathered species you don't see everywhere. Different kinds of activities and animations in addition to the visit. Unusual accomodation experience with the lodge among the wolves pack. Located 45 min away from Lyon, 50 min from Grenoble and 30 min from Chambéry."
    ],
    "it": [
      "Il Domaine des Fauves, un parco zoologico per famiglie, presenta la più grande collezione di predatori pelosi e piumati della regione del Rodano-Alpi. Il Domaine des Fauves si trova a 45 minuti da Lione, 50 minuti da Grenoble e 30 minuti da Chambéry."
    ],
    "fr": [
      "Le Domaine des Fauves, un parc zoologique à dimension familiale, présente la plus grande collection de prédateurs à poils et à plumes de la région Rhône Alpes. Le Domaine des Fauves est situé à 45 min de Lyon, 50 min de Grenoble et 30 min de Chambéry."
    ],
    "nl": [
      "Het Domaine des Fauves, een familiedierenpark, presenteert de grootste collectie harige en gevederde roofdieren in de regio Rhône Alpes. Het Domaine des Fauves ligt op 45 minuten van Lyon, 50 minuten van Grenoble en 30 minuten van Chambéry."
    ],
    "es": [
      "El Domaine des Fauves, parque zoológico familiar, presenta la mayor colección de depredadores peludos y emplumados de la región de Rhône Alpes. El Domaine des Fauves se encuentra a 45 minutos de Lyon, 50 minutos de Grenoble y 30 minutos de Chambéry."
    ]
  },
  "rdfs:label": {
    "en": [
      "Zoo : Le Domaine des Fauves"
    ],
    "fr": [
      "Parc Zoologique Le Domaine des Fauves"
    ]
  },
