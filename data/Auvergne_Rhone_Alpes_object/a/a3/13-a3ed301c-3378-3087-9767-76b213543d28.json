  "rdfs:comment": {
    "de": [
      "L'attroup präsentiert um 20 Uhr sein komisches Stück. Ein Stück von Vivien LHERAUX, inszeniert von Philippe Parthenay.\r\n10? - kinder unter 16 Jahren frei und ein Imbiss wird angeboten. Infos und Reservierung 06 85 67 65 41 oder 07 67 61 76 89"
    ],
    "en": [
      "L'attroup presents its comedy play at 8 pm. Play by Vivien LHERAUX, directed by Philippe Parthenay.\r\n10? - free for children under 16 and a complimentary snack. Info and booking 06 85 67 65 41 or 07 67 61 76 89"
    ],
    "it": [
      "L'attroup presenta la sua commedia alle 20.00. Opera di Vivien LHERAUX per la regia di Philippe Parthenay.\r\n10? - gratuito per i bambini sotto i 16 anni e merenda in omaggio. Informazioni e prenotazioni 06 85 67 65 41 o 07 67 61 76 89"
    ],
    "fr": [
      "L'attroup présente sa pièce comique  à 20 h. Pièce de Vivien LHERAUX mise en scène par Philippe Parthenay. \r\n10€ - gratuit  enfants de moins de 16 ans et une collation  offerte . Infos et réservation 06 85 67 65 41 ou 07 67 61 76 89"
    ],
    "nl": [
      "L'attroup presenteert zijn komediespel om 20.00 uur. Toneelstuk van Vivien LHERAUX in een regie van Philippe Parthenay.\r\n10? - gratis voor kinderen tot 16 jaar en een gratis snack. Informatie en reserveren 06 85 67 65 41 of 07 67 61 76 89"
    ],
