  "rdfs:comment": {
    "de": [
      "Das Antep Kebab befindet sich in dem charaktervollen Dorf Rochemaure, mit Blick auf das Schloss. Er empfängt Sie täglich im Saal oder auf der Terrasse und bietet Ihnen Fastfood, aber auch Gerichte und bald auch spezielle türkische Pizzen."
    ],
    "en": [
      "The Antep Kebab is located in the village of Rochemaure, facing the castle. It welcomes you every day, indoors or on the terrace and offers fast food but also dishes and special Turkish pizzas soon."
    ],
    "it": [
      "L'Antep Kebab si trova nel villaggio di Rochemaure, di fronte al castello. Vi accoglie tutti i giorni, nella sala da pranzo o sulla terrazza, e offre fast food, ma anche piatti e presto pizze turche speciali."
    ],
    "fr": [
      "L'Antep Kebab se situe dans le village de caractère de Rochemaure, vue face au château. Il vous accueille tous les jours, en salle ou en terrasse et vous propose de la restauration rapide mais également des plats et bientôt des pizzas spéciales Turques."
    ],
    "es": [
      "El Antep Kebab está situado en el pueblo de Rochemaure, frente al castillo. Le da la bienvenida todos los días, en el comedor o en la terraza, y ofrece tanto comida rápida como platos y pronto pizzas turcas especiales."
    ],
    "nl": [
      "De Antep Kebab ligt in het dorp Rochemaure, tegenover het kasteel. Het verwelkomt u elke dag, in de eetzaal of op het terras, en biedt zowel fastfood als gerechten en binnenkort speciale Turkse pizza's."
    ]
  },
