  "rdfs:comment": {
    "de": [
      "Das Dorf wurde zwischen Granit und Basalt erbaut und wird vom 90 m hohen Roche Servière überragt, der die ganze Kraft der Naturphänomene erahnen lässt. Orgeln und vulkanische Felsen. Romanische Kirche mit Wandmalereien. Überreste des alten Feudalschlosses."
    ],
    "en": [
      "A village built between granite and basalt, overlooked by Roche Servière (90 m high), which gives a glimpse of the full power of natural phenomena. Organs and volcanic rocks. Romanesque church with mural paintings. Remains of an ancient feudal castle."
    ],
    "it": [
      "Un villaggio costruito tra granito e basalto, sovrastato dalla Roche Servière (alta 90 m), che lascia intravedere tutta la potenza dei fenomeni naturali. Organi e rocce vulcaniche. Chiesa romanica con dipinti murali. Resti dell'antico castello feudale."
    ],
    "fr": [
      "Village bâti entre granite et basalte, surplombé par la Roche Servière (90 m de haut) qui fait entrevoir toute la puissance des phénomènes naturels. Orgues et rochers volcaniques. Église romane avec peintures murales. Vestiges de l’ancien château féodal."
    ],
    "es": [
      "Pueblo construido entre granito y basalto, dominado por la Roche Servière (90 m de altura), que permite vislumbrar toda la potencia de los fenómenos naturales. Órganos y rocas volcánicas. Iglesia románica con pinturas murales. Restos del antiguo castillo feudal."
    ],
    "nl": [
      "Een dorp gebouwd tussen graniet en basalt, met uitzicht op de Roche Servière (90 m hoog), die een glimp geeft van de kracht van natuurverschijnselen. Orgels en vulkanische rotsen. Romaanse kerk met muurschilderingen. Overblijfselen van het oude feodale kasteel."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Village | Prades"
    ]
  },
