  "rdfs:comment": {
    "de": [
      "Die ADMR in Saint-Laurent-en-Royans bietet Hilfe zu Hause an: Unterstützung für ältere Menschen, Menschen mit Behinderungen, Familien, etc. Mit einem Team aus professionellen und ehrenamtlichen Mitarbeitern fördert sie die Autonomie und das Wohlbefinden der Einwohner."
    ],
    "en": [
      "The Saint-Laurent-en-Royans ADMR offers home help services for the elderly, disabled and families. With a team of professionals and volunteers, it promotes the autonomy and well-being of local residents."
    ],
    "it": [
      "L'ADMR di Saint-Laurent-en-Royans offre servizi di assistenza domiciliare: sostegno agli anziani, alle persone con disabilità, alle famiglie, ecc. Con un team di professionisti e volontari, promuove l'indipendenza e il benessere dei residenti locali."
    ],
    "fr": [
      "L'ADMR de Saint-Laurent-en-Royans offre des services d'aide à domicile : soutien aux personnes âgées, en situation de handicap, familles, etc. Avec une équipe de professionnels et bénévoles, elle favorise l'autonomie et le bien -être des habitants."
    ],
    "es": [
      "La ADMR de Saint-Laurent-en-Royans ofrece servicios de ayuda a domicilio: apoyo a ancianos, personas con discapacidad, familias, etc. Con un equipo de profesionales y voluntarios, promueve la independencia y el bienestar de los residentes locales."
    ],
    "nl": [
      "De ADMR in Saint-Laurent-en-Royans biedt thuishulp: ondersteuning voor ouderen, mensen met een handicap, gezinnen, enz. Met een team van professionals en vrijwilligers bevordert het de onafhankelijkheid en het welzijn van de buurtbewoners."
    ]
  },
