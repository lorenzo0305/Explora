  "rdfs:comment": {
    "de": [
      "Unser Weinberg befindet sich in der Gemeinde Mauves, der Wiege der Appellation Saint Joseph. Er besteht aus 6ha30 Syrah und 1ha63 Marsanne. Die Hänge sind nach Süden/Südosten ausgerichtet und liegen auf Granitböden."
    ],
    "en": [
      "AOC red and white St Joseph. Cave created in 1984."
    ],
    "it": [
      "Il nostro vigneto si trova nel comune di Mauves, luogo di nascita della denominazione Saint Joseph. Comprende 6ha30 di Syrah e 1ha 63 di Marsanne. I pendii sono esposti a sud/sud-est su terreni granitici."
    ],
    "fr": [
      "Notre vignoble se situe sur la commune de Mauves, berceau de l'Appellation Saint Joseph. Il est constitué de 6ha30 de syrah et de 1ha 63 de marsanne. Coteaux orientés Sud/Sud-Est sur des sols granitiques."
    ],
    "nl": [
      "Onze wijngaarden liggen in de gemeente Mauves, de bakermat van de Saint Joseph appellatie. Het bestaat uit 6ha30 Syrah en 1ha63 Marsanne. De hellingen zijn zuid/zuidoost gericht op granietbodems."
    ],
    "es": [
      "Nuestro viñedo está situado en el municipio de Mauves, cuna de la denominación Saint Joseph. Comprende 6 ha 30 de Syrah y 1 ha 63 de Marsanne. Las laderas están orientadas al sur/sureste sobre suelos graníticos."
    ]
  },
