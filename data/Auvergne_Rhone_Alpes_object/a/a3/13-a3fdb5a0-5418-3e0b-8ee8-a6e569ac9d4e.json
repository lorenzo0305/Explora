  "rdfs:comment": {
    "de": [
      "Eine abwechslungsreiche Strecke, um Matheysine mit der Familie zu entdecken, mit schönen Ausblicken auf das Plateau Matheysin und seine Seen."
    ],
    "en": [
      "A key route to discover the lakes of the Matheysine region. Along the Creys ridge you'll enjoy beautiful views over the Matheysine plateau and beyond.\r\nThe whole family can follow this varied itinerary with moderate altitude gain.e"
    ],
    "it": [
      "Un percorso vario per scoprire il Matheysine con tutta la famiglia, con splendide viste sull'altopiano del Matheysin e sui suoi laghi."
    ],
    "fr": [
      "Un circuit varié pour découvrir la Matheysine en famille, avec de belles vues sur le plateau Matheysin et ses lacs."
    ],
    "es": [
      "Una ruta variada para descubrir el Matheysine con toda la familia, con hermosas vistas sobre la meseta de Matheysin y sus lagos."
    ],
    "nl": [
      "Een gevarieerde route om de Matheysine met het hele gezin te ontdekken, met prachtige uitzichten over het plateau van Matheysin en de meren."
    ]
  },
