  "rdfs:comment": {
    "de": [
      "Diese Kirche steht im Herzen eines alten, befestigten Viertels von Plauzat. Die Kirche wurde bereits 1862 als historisches Monument klassifiziert und hat von einem umfangreichen Restaurierungsprogramm profitiert."
    ],
    "en": [
      "This church stands at the heart of a former fortified district of Plauzat. Listed as a historic monument since 1862, it has benefited from a major restoration program."
    ],
    "it": [
      "Questa chiesa si trova nel cuore dell'antico quartiere fortificato di Plauzat. Classificata come monumento storico dal 1862, ha beneficiato di un importante programma di restauro."
    ],
    "fr": [
      "Cette église s'élève au cœur d'un ancien quartier fortifié de Plauzat. Classée Monument historique dès 1862, elle a bénéficié d’un important programme de restauration."
    ],
    "es": [
      "Esta iglesia se alza en el corazón de un antiguo barrio fortificado de Plauzat. Declarada monumento histórico en 1862, ha sido objeto de un importante programa de restauración."
    ],
    "nl": [
      "Deze kerk staat in het hart van een voormalige versterkte wijk van Plauzat. Ze staat sinds 1862 op de monumentenlijst en heeft een groot restauratieprogramma ondergaan."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Eglise Saint-Pierre"
    ]
  },
