  "rdfs:comment": {
    "de": [
      "Entdecken Sie unser Angebot an Freizeit-, Mountainbike-, Straßen- und Gravel-Fahrrädern. Kurz gesagt, es gibt etwas für alle Fahrradliebhaber, die die Ardèche in aller Freiheit entdecken möchten."
    ],
    "en": [
      "Discover our range of leisure, mountain, road and gravel bikes. In short, there's something for every cycling enthusiast who wants to discover the Ardèche in complete freedom."
    ],
    "it": [
      "Scoprite la nostra gamma di biciclette da tempo libero, da montagna, da strada e da sterrato. Insomma, ce n'è per tutti gli appassionati di ciclismo che vogliono scoprire l'Ardèche in piena libertà."
    ],
    "fr": [
      "Découvrez nos gammes de vélos loisirs, vtt, route et Gravel. Bref, il y'en a pour tous les amoureux du vélo qui veulent découvrir l'Ardèche en toute liberté."
    ],
    "nl": [
      "Ontdek ons aanbod aan vrijetijdsfietsen, mountainbikes, racefietsen en gravelfietsen. Kortom, er is iets voor elke fietsliefhebber die de Ardèche in alle vrijheid wil ontdekken."
    ],
    "es": [
      "Descubra nuestra gama de bicicletas de ocio, de montaña, de carretera y de gravilla. En resumen, hay algo para cada aficionado al ciclismo que quiera descubrir el Ardèche con total libertad."
    ]
  },
  "rdfs:label": {
    "de": [
      "Verleih von Fahrrädern für die Straße, Gravel und Mountainbikes für einen Tag - Face Sud"
    ],
    "en": [
      "Day hire of road, gravel and mountain bikes - Face Sud"
    ],
    "fr": [
      "Location de vélos Route, Gravel et VTT à la journée - Face Sud"
    ],
    "nl": [
      "Dagverhuur van weg-, gravel- en mountainbikes - Face Sud"
    ]
  },
