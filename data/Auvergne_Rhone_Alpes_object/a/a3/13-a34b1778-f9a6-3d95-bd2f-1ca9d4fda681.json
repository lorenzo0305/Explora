  "rdfs:comment": {
    "de": [
      "Dieses Gebiet befindet sich am Übergang von La Grande Marianne, 25 Minuten von der Hütte entfernt in Richtung Col des Galinettes und Refuge du Gd Bec.\r\nDieser Standort bietet derzeit 3 Routen. Eine vierte ist in Arbeit."
    ],
    "en": [
      "This site is located at the pass of La Grande Marianne, 25 minutes from the refuge in the direction of the Col des Galinettes and the refuge du Gd Bec.\r\nThis site currently offers 3 routes. A 4th route is under construction."
    ],
    "it": [
      "Questo sito si trova al passo della Grande Marianne, a 25 minuti dal rifugio in direzione del Col des Galinettes e del rifugio del Gd Bec.\r\nQuesto sito offre attualmente 3 percorsi. Un quarto percorso è in costruzione."
    ],
    "fr": [
      "Site situé au passage de La Grande Marianne, à 25 minutes du refuge en direction du col des Galinettes et le refuge du Gd Bec.\r\nCe site propose actuellement 3 voies. Une 4ème est en cours."
    ],
    "es": [
      "Este sitio se encuentra en el puerto de La Grande Marianne, a 25 minutos del refugio en dirección al Col des Galinettes y al refugio du Gd Bec.\r\nEste sitio ofrece actualmente 3 rutas. Una 4ª ruta está en construcción."
    ],
    "nl": [
      "Deze site ligt op de pas van La Grande Marianne, op 25 minuten van de refuge in de richting van de Col des Galinettes en de refuge du Gd Bec.\r\nDeze site biedt momenteel 3 routes. Een 4e route is in aanbouw."
    ]
  },
  "rdfs:label": {
