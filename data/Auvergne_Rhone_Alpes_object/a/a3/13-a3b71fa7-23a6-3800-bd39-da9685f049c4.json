  "rdfs:comment": {
    "de": [
      "Mahlzeiten zum Mitnehmen können von Montag bis Freitag vor 10 Uhr und an bestimmten Sonntagen (Thementage, z. B. Oma-Tag) bestellt werden. Wöchentlich wechselnde Menüs zum Mitnehmen."
    ],
    "en": [
      "Takeaway meals can be booked before 10am, Monday to Friday and on certain Sundays (theme days, e.g. Grannies' Day). Weekly change of takeaway menus."
    ],
    "it": [
      "I pasti da asporto possono essere prenotati prima delle 10.00, dal lunedì al venerdì e in alcune domeniche (giornate a tema, ad esempio la Festa della Nonna). Cambio settimanale dei menu da asporto."
    ],
    "fr": [
      "Repas à emporter sur réservation avant 10 h, du lundi au vendredi et certains dimanches (journées à thème, par exemple fête des mamies ... ). Changement de menus de plats à emporter chaque semaine."
    ],
    "es": [
      "Se puede reservar comida para llevar antes de las 10 de la mañana, de lunes a viernes y algunos domingos (días temáticos, por ejemplo, el Día de la Abuela). Cambio semanal de menús para llevar."
    ],
    "nl": [
      "Afhaalmaaltijden kunnen worden gereserveerd vóór 10 uur, van maandag tot en met vrijdag en op bepaalde zondagen (themadagen, bijv. Oma's Dag). Wekelijkse verandering van afhaalmenu's."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant du Foirail"
    ]
  },
