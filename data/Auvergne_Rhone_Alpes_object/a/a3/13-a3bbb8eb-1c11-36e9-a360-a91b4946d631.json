  "rdfs:comment": {
    "de": [
      "Willkommen bei Ganaev73\r\nIch bin Glasspinnerin in St Jean de Chevelu.\r\nIch lade Sie ein, die Glasarbeit jeden Samstag nach Voranmeldung unter 0619547390 zu entdecken."
    ],
    "en": [
      "Welcome to Ganaev73 \r\nI am a glassblower in St Jean de Chevelu.\r\nI invite you to come and discover glasswork every Saturday. Please book in advance by calling 0619547390."
    ],
    "it": [
      "Benvenuto a Ganaev73\r\nSono un filatore di vetro a St Jean de Chevelu.\r\nVi invito a venire a scoprire come si fa il vetro ogni sabato, prenotando in anticipo su 0619547390."
    ],
    "fr": [
      "Bienvenue chez Ganaev73 \r\nJe suis fileuse de verre à St Jean de Chevelu.\r\nJe vous invite à  venir découvrir le travail du verre tous les samedis sur réservation au 0619547390."
    ],
    "nl": [
      "Welkom bij Ganaev73\r\nIk ben glasspinster in St Jean de Chevelu.\r\nIk nodig je uit om elke zaterdag te komen ontdekken hoe glas wordt gemaakt, door vooraf te reserveren op 0619547390."
    ],
    "es": [
      "Bienvenido a Ganaev73\r\nSoy una hilandera de vidrio en St Jean de Chevelu.\r\nTe invito a venir y descubrir cómo se hace el vidrio todos los sábados, reservando con antelación en 0619547390."
    ]
  },
