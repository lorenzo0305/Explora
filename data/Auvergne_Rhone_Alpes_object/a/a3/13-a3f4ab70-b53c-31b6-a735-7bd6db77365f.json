  "rdfs:comment": {
    "de": [
      "Genießen Sie einige Momente der Entspannung im Jardin du Mont-Blanc. Bänke, ein Pavillon, ein Kinderspielplatz - hier gibt es alles, um ein Picknick oder einen Moment mit Freunden oder der Familie zu genießen."
    ],
    "en": [
      "Take a few moments to relax in the Mont-Blanc garden. With benches, a gazebo and a children's play area, there's everything you need to enjoy a picnic or a moment with friends or family."
    ],
    "it": [
      "Prendetevi qualche momento di relax nel giardino del Monte Bianco. Con panchine, un gazebo e un'area giochi per bambini, c'è tutto il necessario per godersi un picnic o un momento con gli amici o la famiglia."
    ],
    "fr": [
      "Profitez de quelques instants de détente au jardin du Mont-Blanc. Bancs, kiosque, aire de jeux pour les enfants, tout y est pour profiter le temps d'un pique-nique ou d'un instant entre amis ou en famille."
    ],
    "nl": [
      "Neem even de tijd om te ontspannen in de tuin van Mont-Blanc. Met bankjes, een prieel en een speeltuin is er alles wat je nodig hebt om te genieten van een picknick of een moment met vrienden of familie."
    ],
    "es": [
      "Disfrute de unos momentos de relax en el jardín del Mont-Blanc. Con bancos, un cenador y una zona de juegos para niños, hay todo lo necesario para disfrutar de un picnic o de un momento con los amigos o la familia."
    ]
  },
