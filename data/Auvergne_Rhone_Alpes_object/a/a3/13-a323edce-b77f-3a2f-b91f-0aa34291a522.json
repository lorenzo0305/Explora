  "rdfs:comment": {
    "de": [
      "Manon Delfieu übt die Kunst der Glasmalerei mit der Tiffany-Technik aus. Nach einer Ausbildung trainierte sie ein Jahr lang, bevor sie sich in einem Atelier in Jaujac niederließ, und erkundet weiterhin die Welt des Glases und der Glasmalerei."
    ],
    "en": [
      "Manon Delfieu practices the art of stained glass using the Tiffany technique. After training, she practiced for a year before setting up her own workshop in Jaujac, where she continues to explore the world of glass and stained glass."
    ],
    "it": [
      "Manon Delfieu pratica l'arte del vetro colorato secondo la tecnica Tiffany. Dopo la formazione, ha esercitato per un anno prima di aprire il suo laboratorio a Jaujac, dove continua a esplorare il mondo del vetro e delle vetrate."
    ],
    "fr": [
      "Manon Delfieu exerce l'art du vitrail avec la technique Tiffany. Après une formation, elle s'est entraînée durant une année avant de s'installer dans un atelier à Jaujac et continue d'explorer l'univers du verre et du vitrail."
    ],
    "es": [
      "Manon Delfieu practica el arte de la vidriera con la técnica Tiffany. Tras formarse, ejerció durante un año antes de crear su propio taller en Jaujac, donde sigue explorando el mundo del vidrio y las vidrieras."
    ],
    "nl": [
      "Manon Delfieu beoefent de kunst van glas-in-lood volgens de Tiffany-techniek. Na een opleiding heeft ze een jaar geoefend voordat ze haar eigen atelier oprichtte in Jaujac, waar ze de wereld van glas en glas in lood blijft verkennen."
    ]
  },
  "rdfs:label": {
