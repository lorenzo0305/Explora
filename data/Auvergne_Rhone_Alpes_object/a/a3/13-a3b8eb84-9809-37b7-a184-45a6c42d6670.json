  "rdfs:comment": {
    "de": [
      "Im Herzen des pädagogischen Bauernhofs von Père Louis befindet sich L'Autruche gourmande, ein Restaurant, das den Besuch mit einer einfachen, großzügigen und verantwortungsbewussten Küche verlängert. Die Gerichte werden mit Produkten aus dem eigenen Betrieb zubereitet."
    ],
    "en": [
      "Located at the heart of the Père Louis educational farm, Autruche Gourmande is a casual dining area that extends the visitor experience, offering simple, generous and responsible cuisine made with produce from the farm."
    ],
    "it": [
      "Situato nel cuore della fattoria didattica Père Louis, l'Autruche gourmande è un ristorante che prolunga la visita con una cucina semplice, generosa e responsabile. I piatti sono realizzati con prodotti della fattoria."
    ],
    "fr": [
      "Installée au cœur de la ferme pédagogique du Père Louis, l’Autruche gourmande est un espace de restauration qui prolonge la visite avec une cuisine simple, généreuse et responsable. Les plats sont élaborés avec les produits issus de l'exploitation."
    ],
    "es": [
      "Situado en el corazón de la granja pedagógica Père Louis, l'Autruche gourmande es un restaurante que prolonga la visita con una cocina sencilla, generosa y responsable. Los platos se elaboran con productos de la granja."
    ],
    "nl": [
      "L'Autruche gourmande, gelegen in het hart van de educatieve boerderij van Père Louis, is een restaurant dat het bezoek verrijkt met een eenvoudige, gulle en verantwoorde keuken. De gerechten worden bereid met producten van de boerderij."
    ]
  },
  "rdfs:label": {
    "en": [
      "Autruche Gourmande snack bar at the Père Louis educational farm"
    ],
    "fr": [
      "Snack l’autruche gourmande à la ferme pédagogique du Père Louis"
    ]
  },
