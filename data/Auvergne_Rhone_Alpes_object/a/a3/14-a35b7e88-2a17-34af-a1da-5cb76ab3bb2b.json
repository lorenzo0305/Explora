      "dc:description": {
        "de": [
          "Vorweihnachtlicher Flohmarkt für Spielzeug und Kleidung? Hier können Sie zusätzliche Geschenke zu günstigen Preisen vorbereiten. Organisiert von Animations Loisirs Bon Secours"
        ],
        "en": [
          "Pre-Christmas flea market for toys and clothes... enough to make extra presents at good prices. Organized by Animations Loisirs Bon Secours"
        ],
        "it": [
          "Mercatino dell'usato prenatalizio di giocattoli e vestiti, con tante occasioni per regali extra. Organizzato da Animations Loisirs Bon Secours"
        ],
        "fr": [
          "Braderie avant Noël des Jouets et des vêtements… de quoi préparer des cadeaux supplémentaires à bon prix. Organisé par Animations Loisirs Bon Secours"
        ],
        "nl": [
          "Pre-kerst rommelmarkt voor speelgoed en kleding, met veel koopjes voor extra cadeautjes. Georganiseerd door Animations Loisirs Bon Secours"
        ],
        "es": [
          "Mercadillo prenavideño de juguetes y ropa, con muchas ofertas para regalos extra. Organizado por Animations Loisirs Bon Secours"
        ]
