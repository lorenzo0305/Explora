  "rdfs:comment": {
    "de": [
      "Lust auf eine Verschnaufpause und einen gemeinsamen Moment der anderen Art?\r\n\r\nDie Abende von Jeu'Part'Âge sind die ideale Gelegenheit, sich um verschiedene Spiele zu versammeln, zu entdecken, zu lachen und sich ganz einfach Herausforderungen zu stellen."
    ],
    "en": [
      "Want to take a breather and share a different moment?\r\n\r\nJeu'Part'Âge evenings are the perfect opportunity to get together and play a variety of games, discover new things, laugh and take on challenges in a relaxed atmosphere."
    ],
    "it": [
      "Volete fare una pausa e condividere qualcosa di diverso?\r\n\r\nLe serate Jeu'Part'Âge sono l'occasione perfetta per riunirsi e fare una serie di giochi, scoprire cose nuove, ridere e affrontare semplici sfide."
    ],
    "fr": [
      "Envie de souffler un peu et de partager un moment différent ? \r\n\r\nLes soirées Jeu'Part'Âge sont l'occasion idéale de se retrouver autour de jeux variés, de découvrir, de rire et de relever des défis en toute simplicité."
    ],
    "es": [
      "¿Quiere tomarse un respiro y compartir algo diferente?\r\n\r\nLas tardes de Jeu'Part'Âge son la ocasión perfecta para reunirse y jugar a juegos variados, descubrir cosas nuevas, reírse un rato y enfrentarse a retos sencillos."
    ],
    "nl": [
      "Wil je even uitblazen en iets anders delen?\r\n\r\nDe Jeu'Part'Âge-avonden zijn de perfecte gelegenheid om samen te komen en verschillende spelletjes te spelen, nieuwe dingen te ontdekken, te lachen en eenvoudige uitdagingen aan te gaan."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Soirée Jeu'Part'Âge"
    ]
  },
