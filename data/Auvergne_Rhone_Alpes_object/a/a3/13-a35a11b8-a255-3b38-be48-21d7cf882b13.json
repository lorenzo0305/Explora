  "rdfs:comment": {
    "de": [
      "Unsere 100 Skilehrerinnen und Skilehrer bringen Ihnen alle Arten des Wintersports bei: Alpinski, Snowboard, Langlauf, Telemark, Freestyle, Freeride und Schneeschuhwandern."
    ],
    "en": [
      "Our 100 instructors can teach you every type of winter sport: downhill skiing, snowboarding, cross-country skiing, telemark, freestyle, freeride and snowshoe hikes."
    ],
    "it": [
      "I nostri 100 maestri e maestre sono a vostra disposizione per insegnarvi ogni disciplina: sci, snowboard, sci di fondo, telemark, freestyle, freeride o racchette da neve."
    ],
    "fr": [
      "Nos 100 moniteurs et monitrices vous enseigneront tout type de glisse : ski alpin, snowboard,ski de fond, télémark, freestyle, freeride et rando raquette."
    ],
    "nl": [
      "Onze 100 skileraren en leraressen leren u allerlei glijsporten: alpine ski, snowboard, langlauf, telemark, freestyle, freeride en sneeuwraketten."
    ],
    "es": [
      "Nuestros 100 instructores le enseñarán todo tipo de deportes de nieve: esquí alpino, snowboard, esquí de fondo, telemark, freestyle, freeride y raquetas de nieve."
    ]
  },
