  "rdfs:comment": {
    "de": [
      "Le Bouillon ist ein reisendes Kulturcafé, das auf den Straßen des Bourbonnais unterwegs ist, um den Bewohnern einen Raum für soziale Bindungen und kulturelles Leben zu bieten."
    ],
    "en": [
      "Le Bouillon is an itinerant café-culturel that travels the roads of the Bourbonnais region, providing local residents with a space for social interaction and cultural life."
    ],
    "it": [
      "Le Bouillon è un caffè culturale itinerante che percorre in lungo e in largo la regione di Bourbonnais, offrendo ai residenti locali un luogo in cui possono stabilire contatti sociali e godere della vita culturale."
    ],
    "fr": [
      "Le Bouillon est un café-culturel itinérant qui sillonne les routes du bourbonnais pour apporter, au plus près des habitants, un espace de lien social et de vie culturelle."
    ],
    "nl": [
      "Le Bouillon is een rondreizend cultureel café dat door de hele regio Bourbonnais reist om de inwoners een plek te bieden waar ze sociale contacten kunnen leggen en van het culturele leven kunnen genieten."
    ],
    "es": [
      "Le Bouillon es un café cultural itinerante que recorre la región de Bourbonnais para ofrecer a sus habitantes un lugar donde relacionarse socialmente y disfrutar de la vida cultural."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Bouillon, café culturel itinérant"
    ]
  },
