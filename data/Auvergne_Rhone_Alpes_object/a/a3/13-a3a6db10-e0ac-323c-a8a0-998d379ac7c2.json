  "rdfs:comment": {
    "de": [
      "Von Le Moulin aus wandern Sie durch Almen und Wälder bis zum Mont Lachat, wo Sie ein wunderschönes Panorama erwartet!"
    ],
    "en": [
      "From the Mill, walk between alpine pastures and forests to reach Mont Lachat where a breathtaking panorama awaits you!"
    ],
    "it": [
      "Partendo da Le Moulin, attraversate pascoli e foreste di montagna per raggiungere il Mont Lachat, dove vi attende un panorama mozzafiato!"
    ],
    "fr": [
      "Au départ du Moulin, cheminez entre alpages et forêts pour rejoindre le Mont Lachat où un panorama de toute beauté vous attend !"
    ],
    "nl": [
      "Vanuit Le Moulin baan je je een weg door bergweiden en bossen om de Mont Lachat te bereiken, waar een adembenemend panorama op je wacht!"
    ],
    "es": [
      "Partiendo de Le Moulin, atraviese pastos de montaña y bosques para llegar al Monte Lachat, donde le espera un panorama impresionante"
    ]
  },
