  "rdfs:comment": {
    "de": [
      "Les Champs du pain steht vor allem für Begegnungen, die reich an Geschmack sind! Wir stellen Bio-Brot mit Natursauerteig her, das über dem Holzfeuer gebacken wird. Aber nicht nur!"
    ],
    "en": [
      "Les Champs du Pain, it is a place of meeting rich in flavor. We made biological sourdough bread baked in a wood-oven. But not only !"
    ],
    "it": [
      "Les Champs du pain è soprattutto un luogo di incontro pieno di sapori! Produciamo pane biologico a lievitazione naturale cotto a legna. Ma non solo!"
    ],
    "fr": [
      "Les Champs du pain c’est avant tout des rencontres riches en saveurs ! Nous fabriquons du pain bio au levain naturel cuit au feu de bois. Mais pas que !"
    ],
    "nl": [
      "Les Champs du pain is vooral een ontmoetingsplaats vol smaken! Wij maken biologisch brood met natuurlijke gisting gebakken in een houtoven. Maar dat niet alleen!"
    ],
    "es": [
      "Les Champs du pain es ante todo un lugar de encuentro lleno de sabores Elaboramos pan ecológico con levadura natural cocinado a fuego de leña. Pero no sólo eso"
    ]
  },
