  "rdfs:comment": {
    "de": [
      "Der Fotoclub \"Les Traqueurs d'Images\" präsentiert eine Ausstellung, die den Texturen, Details und Stimmungen von Holz aus verschiedenen fotografischen Blickwinkeln gewidmet ist."
    ],
    "en": [
      "The \"Les Traqueurs d?Images\" photo club presents an exhibition dedicated to the textures, details and ambiances of wood through different photographic eyes."
    ],
    "it": [
      "Il club fotografico \"Les Traqueurs d'Images\" presenta una mostra dedicata alle texture, ai dettagli e agli ambienti del legno attraverso diverse prospettive fotografiche."
    ],
    "fr": [
      "Le club photo \"Les Traqueurs d’Images\" présente une exposition dédiée aux textures, détails et ambiances du bois à travers différents regards photographiques."
    ],
    "es": [
      "El fotoclub \"Les Traqueurs d'Images\" presenta una exposición dedicada a las texturas, detalles y ambientes de la madera a través de diferentes perspectivas fotográficas."
    ],
    "nl": [
      "De fotoclub \"Les Traqueurs d?Images\" presenteert een tentoonstelling gewijd aan de texturen, details en sfeer van hout vanuit verschillende fotografische perspectieven."
    ]
