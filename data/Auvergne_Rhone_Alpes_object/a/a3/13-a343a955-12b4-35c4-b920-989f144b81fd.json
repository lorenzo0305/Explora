  "rdfs:comment": {
    "de": [
      "Das Atelier Lamarque ist ein Unternehmen, das mit der festen Überzeugung arbeitet, dass die Kreativität großer Konzepte das Leben derjenigen, die es wagen, verbessern und verändern kann."
    ],
    "en": [
      "Atelier Lamarque is a company working with the firm conviction that the creativity of great concepts can improve and change the lives of those who dare."
    ],
    "it": [
      "Atelier Lamarque è un'azienda che lavora con la convinzione che la creatività di grandi concetti possa migliorare e cambiare la vita di chi osa."
    ],
    "fr": [
      "L’atelier Lamarque est une entreprise travaillant avec l’intime conviction que la créativité des grands concepts peut améliorer et changer la vie de ceux qui l’osent."
    ],
    "nl": [
      "Atelier Lamarque is een bedrijf dat werkt vanuit de overtuiging dat de creativiteit van grote concepten het leven van degenen die het aandurven kan verbeteren en veranderen."
    ],
    "es": [
      "Atelier Lamarque es una empresa que trabaja con la convicción de que la creatividad de los grandes conceptos puede mejorar y cambiar la vida de quienes se atreven."
    ]
  },
