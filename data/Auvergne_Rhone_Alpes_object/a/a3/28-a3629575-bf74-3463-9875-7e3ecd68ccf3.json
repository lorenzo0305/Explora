  "rdfs:comment": {
    "de": [
      "Das Restaurant Au 70 bietet eine Feinschmeckerküche mit traditionellen und regionalen Gerichten. Es steht hinter einer Speisekarte, die die Aromen der traditionellen französischen Küche mit denen der Weltküchen verbindet."
    ],
    "en": [
      "Restaurant Au 70 offers gourmet, traditional and regional cuisine. Its menu combines the flavors of traditional French and world cuisine."
    ],
    "it": [
      "Il ristorante Au 70 offre una cucina gourmet, tradizionale e regionale. Il suo menu combina i sapori della tradizione francese e della cucina mondiale."
    ],
    "fr": [
      "Le restaurant Au 70 propose une cuisine gourmande, traditionnelle et régionale. Il est à l'origine d'une carte alliant les saveurs de la cuisine française traditionnelle et les cuisines du monde."
    ],
    "nl": [
      "Restaurant Au 70 biedt gastronomische, traditionele en regionale gerechten. Het menu combineert de smaken van de traditionele Franse en wereldkeuken."
    ],
    "es": [
      "El restaurante Au 70 ofrece cocina gourmet, tradicional y regional. Su carta combina los sabores de la cocina tradicional francesa y de la cocina mundial."
    ]
  },
