  "rdfs:comment": {
    "de": [
      "Diese Weinstube und Weinkeller befindet sich am Ende der Einkaufsgalerie und ist ein komfortabler, gemütlicher Ort, der zahlreiche Tapas und Brettchen, Weine aus den verschiedenen Regionen Frankreichs, Cocktails, handwerklich gebrautes Bier, Teestube und Gebäck anbietet."
    ],
    "en": [
      "Located at the end of the shopping mall, this Wine Bar and wine cellar, a comfortable, cozy and warm place, offers numerous tapas and platters, wines from different regions of France, cocktails, craft beer, tea room and pastries."
    ],
    "it": [
      "Situata alla fine del centro commerciale, questa confortevole e accogliente enoteca e cantina offre un'ampia gamma di tapas e taglieri, vini da tutta la Francia, cocktail, birra artigianale, sala da tè e pasticcini."
    ],
    "fr": [
      "Situé au bout de la galerie commerciale, ce Bar à Vin et caveau à vin, lieu confortable, cosy et chaleureux, propose de nombreuses tapas et planches, des vins des différentes régions de France, cocktails, bière artisanale, salon de thé et pâtisseries."
    ],
    "es": [
      "Situado al final del centro comercial, este Wine Bar y bodega, un lugar cómodo, acogedor y cálido, ofrece numerosas tapas y platos, vinos de diferentes regiones de Francia, cócteles, cerveza artesanal, salón de té y repostería."
    ],
    "nl": [
      "Deze comfortabele, gezellige wijnbar en wijnkelder ligt aan het einde van het winkelcentrum en biedt een breed scala aan tapas en schotels, wijnen uit heel Frankrijk, cocktails, ambachtelijk bier, een theesalon en gebak."
    ]
  },
  "rdfs:label": {
    "en": [
      "Le Caveau de Chavière"
    ],
