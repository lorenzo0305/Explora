  "rdfs:comment": {
    "de": [
      "Les Pépites Bressanes Traiteur bieten verschiedene Gerichte, Menüs, Lunchpakete und entdecken Sie die Hähnchenbrust\r\nFür Familienessen, Hochzeiten, Unternehmen, Betriebsrat, Veranstaltungen, Geburtstage, Einweihungen, private Feiern, den Tag nach der Hochzeit."
    ],
    "en": [
      "Les Pépites Bressanes Traiteur offers a range of dishes, menus, lunches and chicken breasts.\r\nFor family meals, weddings, works councils, events, anniversaries, inaugurations, private parties, the day after a wedding."
    ],
    "it": [
      "Les Pépites Bressanes Traiteur offre una gamma di piatti, menu, pranzi e petti di pollo\r\nPer pranzi in famiglia, matrimoni, aziende, consigli di fabbrica, eventi, compleanni, inaugurazioni, feste private, il giorno dopo il matrimonio."
    ],
    "fr": [
      "Les Pépites Bressanes Traiteur proposent différents plats, menus, lunchs et de découvrir les bréchets de poulet\r\nPour repas familiaux, mariage, entreprise, comité d'entreprise, événementiel, anniversaire, inauguration, soirée privée, lendemain de mariage."
    ],
    "nl": [
      "Traiteur Les Pépites Bressanes biedt een scala aan gerechten, menu's, lunches en kipfilets\r\nVoor familiediners, bruiloften, bedrijven, ondernemingsraden, evenementen, verjaardagen, inhuldigingen, privéfeestjes, de dag na een bruiloft."
    ],
    "es": [
      "Les Pépites Bressanes Traiteur ofrece una gama de platos, menús, almuerzos y pechugas de pollo\r\nPara comidas familiares, bodas, empresas, comités de empresa, eventos, cumpleaños, inauguraciones, fiestas privadas, el día después de una boda."
    ]
  },
