  "rdfs:comment": {
    "de": [
      "Restaurant, das Tradition und Moderne vereint: eine Küche aus regionalen Produkten mit einem Hauch von Fantasie, Spezialitäten aus Savoyen, alles zum Genießen vor Ort oder zum Mitnehmen nach Hause."
    ],
    "en": [
      "Restaurant-delicatessen combining tradition and modern styles: a cuisine using local produce with a special twist and local Savoyard specialities. \r\nEat in or take away."
    ],
    "it": [
      "Ristorante che unisce tradizione e modernità: una cucina a base di prodotti locali con un tocco di fantasia, specialità savoiarde, tutte da gustare sul posto o da portare a casa."
    ],
    "fr": [
      "Restaurant alliant tradition et modernité : une cuisine à base de produits du terroir avec une touche de fantaisie, des spécialités savoyardes, le tout à déguster sur place ou à emporter chez vous."
    ],
    "es": [
      "Restaurante que combina tradición y modernidad: una cocina basada en productos locales con un toque de fantasía, especialidades saboyanas, todo ello para degustar in situ o para llevar a casa."
    ],
    "nl": [
