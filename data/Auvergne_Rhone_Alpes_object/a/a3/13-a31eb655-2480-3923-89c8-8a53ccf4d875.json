  "rdfs:comment": {
    "de": [
      "Der Poney Club d'Echenevex ist einzigartig im Pays de Gex und seiner Umgebung. Er ist eine Einrichtung, die sich ganz und gar und ausschließlich dem Ponyreiten für Kinder (ab 4 Jahren) und Jugendliche widmet."
    ],
    "en": [
      "Unique in the Pays de Gex and surrounding area, the Poney Club d'Echenevex is an establishment entirely and exclusively dedicated to pony riding for children (from age 4) and teenagers."
    ],
    "it": [
      "Unico nel Pays de Gex e nei suoi dintorni, il Pony Club d'Echenevex è una struttura interamente ed esclusivamente dedicata all'equitazione su pony per bambini (a partire dai 4 anni) e adolescenti."
    ],
    "fr": [
      "Unique dans le pays de Gex et ses environs, le Poney club d’Echenevex est un établissement entièrement et exclusivement consacré à l’équitation à poney pour les enfants (à partir de 4 ans) et adolescents."
    ],
    "es": [
      "Único en el Pays de Gex y sus alrededores, el Pony Club d'Echenevex es un establecimiento dedicado total y exclusivamente a la equitación para niños (a partir de 4 años) y adolescentes."
    ],
    "nl": [
      "De Ponyclub van Echenevex, uniek in het Pays de Gex en omgeving, is een instelling die zich volledig en uitsluitend richt op het ponyrijden voor kinderen (vanaf 4 jaar) en tieners."
    ]
  },
