  "rdfs:comment": {
    "de": [
      "Dieser kleine Granitfelsen bietet technisches und athletisches Klettern im Schwierigkeitsgrad 6. Die meisten Routen sind gut mit verketteten Stiften und Relais abgesichert, aber es gibt noch einige Spits."
    ],
    "en": [
      "This small granite cliff offers technical and athletic climbing to level 6. Most of the routes are well protected with chained pins and belays, but there are still a few spits."
    ],
    "it": [
      "Questa piccola falesia di granito offre un'arrampicata tecnica e atletica di livello 6. La maggior parte delle vie sono ben protette da spit e soste con catena, ma ci sono ancora alcuni spit."
    ],
    "fr": [
      "Cette petite falaise de granit offre une escalade technique et athlétique de niveau 6. La plupart des voies sont bien protégées avec des broches et relais chaînés mais il reste quelques spits."
    ],
    "es": [
      "Este pequeño peñasco de granito ofrece escalada técnica y atlética de nivel 6. La mayoría de las vías están bien protegidas con bolts y aseguradores encadenados. La mayoría de las rutas están bien protegidas con bolts y aseguradores encadenados, pero todavía hay algunos spits."
    ],
    "nl": [
      "Deze kleine granieten rots biedt technisch en atletisch klimmen van niveau 6. De meeste routes zijn goed beschermd met bouten en beveiligingen met kettingen, maar er zijn nog steeds een paar spitsen."
    ]
  },
  "rdfs:label": {
    "en": [
      "Hélène rock climbing site"
    ],
    "fr": [
      "Site d'escalade du rocher Hélène"
    ]
  },
