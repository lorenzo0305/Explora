  "rdfs:comment": {
    "de": [
      "ScienceExplo, um die Wissenschaft auf andere Weise zu erforschen, zu lernen und zu erleben!\r\nSchulungen, Erkundungen und ein Online-Shop, der den Naturwissenschaften und Technologien gewidmet ist: Astronomie, Luft & Weltraum, Digitale Wissenschaften und Geowissenschaften."
    ],
    "en": [
      "ScienceExplo, a new way to explore, learn and experience science!\r\nTraining courses, explorations and an online store dedicated to Science and Technology: Astronomy, Air & Space, Digital Sciences and Earth Sciences."
    ],
    "it": [
      "ScienceExplo, un nuovo modo di esplorare, imparare e vivere la scienza!\r\nCorsi di formazione, esplorazioni e un negozio online dedicato alla scienza e alla tecnologia: Astronomia, Aria e Spazio, Scienze digitali e Scienze della Terra."
    ],
    "fr": [
      "ScienceExplo, pour explorer, apprendre et vivre la science autrement !\r\nFormations, explorations et boutique en ligne dédiées aux Sciences et Technologies : Astronomie, Air & Espace, Sciences Numériques et Sciences de la Terre."
    ],
    "nl": [
      "ScienceExplo, een nieuwe manier om wetenschap te ontdekken, te leren en te ervaren!\r\nTrainingen, verkenningen en een online winkel gewijd aan wetenschap en technologie: Astronomie, Lucht- & Ruimtevaart, Digitale Wetenschappen en Aardwetenschappen."
    ],
    "es": [
      "ScienceExplo, ¡una nueva forma de explorar, aprender y experimentar la ciencia!\r\nCursos de formación, exploraciones y una tienda en línea dedicados a la Ciencia y la Tecnología: Astronomía, Aire y Espacio, Ciencias Digitales y Ciencias de la Tierra."
    ]
  },
