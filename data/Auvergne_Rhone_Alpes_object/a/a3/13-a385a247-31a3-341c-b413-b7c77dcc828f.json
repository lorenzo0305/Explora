  "rdfs:comment": {
    "de": [
      "Die im Nordosten des Departements gelegene Route Dompierre-Diou-Digoin verläuft zwischen Fluss und Kanal auf einer Länge von fast 30 km."
    ],
    "en": [
      "Located in the north-east of the department, the Dompierre-Diou-Digoin route winds its way between river and canal for almost 30 km."
    ],
    "it": [
      "Situato nel nord-est del dipartimento, il percorso Dompierre-Diou-Digoin si estende per quasi 30 km tra il fiume e il canale."
    ],
    "fr": [
      "Situé au nord-est du département, l'itinéraire Dompierre-Diou-Digoin se dessine entre fleuve et canal sur près de 30 km."
    ],
    "es": [
      "Situada en el noreste del departamento, la ruta Dompierre-Diou-Digoin se extiende a lo largo de casi 30 km entre el río y el canal."
    ],
    "nl": [
      "De route Dompierre-Diou-Digoin ligt in het noordoosten van het departement en strekt zich uit over bijna 30 km tussen de rivier en het kanaal."
    ]
  },
