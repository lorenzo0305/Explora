  "rdfs:comment": {
    "de": [
      "Der ehemalige Leiter des Sozialzentrums Lavieux in Saint-Chamond, Jean-Luc Denis, hat einen großen Teil seines Lebens seiner Leidenschaft für das Laufen auf fünf Kontinenten gewidmet und dabei fast 100.000 km zurückgelegt."
    ],
    "en": [
      "A former director of the Centre Social Lavieux in Saint-Chamond, Jean-Luc Denis has devoted a large part of his life to his passion for running on 5 continents, and has now clocked up almost 100,000 km."
    ],
    "it": [
      "Ex direttore del Centro sociale Lavieux di Saint-Chamond, Jean-Luc Denis ha dedicato gran parte della sua vita alla passione per la corsa in tutti e 5 i continenti, arrivando a percorrere quasi 100.000 km."
    ],
    "fr": [
      "Ancien directeur du Centre Social Lavieux à Saint-Chamond, Jean-Luc Denis a consacré une grande partie de sa vie à sa passion pour la course à pied sur les 5 continents, cumulant aujourd'hui près de 100 000 km au compteur."
    ],
    "nl": [
      "Jean-Luc Denis, voormalig directeur van het Sociaal Centrum Lavieux in Saint-Chamond, heeft een groot deel van zijn leven gewijd aan zijn passie voor hardlopen op alle 5 continenten en heeft nu bijna 100.000 km op de teller staan."
    ],
    "es": [
      "Antiguo director del Centro Social Lavieux de Saint-Chamond, Jean-Luc Denis ha dedicado gran parte de su vida a su pasión por correr por los 5 continentes, y ya ha recorrido casi 100.000 km."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Soirée découverte et échanges avec le \"Citoyen-coureur du monde\""
    ]
  },
