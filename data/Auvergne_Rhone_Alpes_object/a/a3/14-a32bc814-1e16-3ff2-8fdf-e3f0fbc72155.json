  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/ef90ed9e-c732-354a-9def-ebf9b96336a1",
      "dc:description": {
        "de": [
          "Durchführung von Veranstaltungen: Flohmarkt, Konzert, Theater, Blumenfest. Sie bietet Aktivitäten zur Entspannung an\nund Freizeitaktivitäten: Fitness: Montag 10:00-11:30 Uhr und 19:00-20:00 Uhr, Donnerstag 18:00-19:00 Uhr, Line Dance: Mittwochabend von 19:00-20:30 Uhr."
        ],
        "en": [
          "Organizing events: flea markets, concerts, theater, flower festival. It offers relaxation and leisure activities\nand leisure activities: fitness: Mondays 10am-11.30am and 7pm-8pm, Thursdays 6pm-7pm, Line Dance: Wednesday evenings 7pm-8.30pm."
        ],
        "it": [
          "Organizza eventi come mercatini delle pulci, concerti, festival teatrali e floreali. Offre attività di relax e di svago\ne attività ricreative: fitness: lunedì 10.00-11.30 e 19.00-20.00, giovedì 18.00-19.00, Line Dance: mercoledì sera 19.00-20.30."
        ],
        "fr": [
          "Mise en place de manifestations : brocante, concert, théâtre, fête des fleurs. Elle offre des activités de détente\net de loisirs : le fitness : Lundi 10h-11h30 et 19h-20h, jeudi de 18h à 19h, Line Dance : mercredi soir de 19h à 20h30."
        ],
        "es": [
          "Organiza eventos como mercadillos, conciertos, teatro y festivales de flores. Ofrece actividades de relajación y ocio\ny actividades de ocio: fitness: lunes de 10.00 a 11.30 y de 19.00 a 20.00, jueves de 18.00 a 19.00, Line Dance: miércoles por la tarde de 19.00 a 20.30."
        ],
        "nl": [
          "Organiseert evenementen zoals rommelmarkten, concerten, theater en bloemenfestivals. Het biedt ontspanning en vrijetijdsactiviteiten\nen vrijetijdsactiviteiten: fitness: maandag 10.00-11.30 uur en 19.00-20.00 uur, donderdag 18.00-19.00 uur, Line Dance: woensdagavond 19.00-20.30 uur."
        ]
      },
