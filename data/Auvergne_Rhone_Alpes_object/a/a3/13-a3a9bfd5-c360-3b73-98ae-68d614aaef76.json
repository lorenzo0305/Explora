  "rdfs:comment": {
    "de": [
      "Driven Sie in Les Gets mit Blick auf den Mont Blanc!\r\nDie Driving Range des Golfplatzes Les Gets, 55 Minuten von Genf und 30 Minuten von der Evian Championship entfernt, bietet außergewöhnliche Panoramen.\r\nLernen Sie in dieser idyllischen Umgebung den Golfsport kennen!"
    ],
    "en": [
      "In Les Gets, drift facing the Mont Blanc!\r\nThe Golf des Gets driving range, located 55 minutes from Geneva and 30 minutes from the Evian Championship, offers exceptional panoramas.\r\nCome and try your hand at golf in this idyllic setting!"
    ],
    "it": [
      "A Les Gets, fate il tee off contro il Monte Bianco!\r\nIl campo pratica del Golf des Gets, situato a 55 minuti da Ginevra e a 30 minuti dal Campionato di Evian, offre una vista panoramica eccezionale.\r\nVenite a cimentarvi nel golf in questa cornice idilliaca!"
    ],
    "fr": [
      "Aux Gets, drivez face au Mont Blanc !\r\nLe Practice du Golf des Gets, situé à 55 minutes de Genève et à 30 minutes de l'Evian Championship, propose des panoramas exceptionnels.\r\nVenez vous initier au golf dans ce cadre idyllique !"
    ],
    "nl": [
      "In Les Gets, drift met uitzicht op de Mont Blanc!\r\nDe driving range van Golf des Gets, gelegen op 55 minuten van Genève en 30 minuten van het Evian Championship, biedt uitzonderlijke panorama's.\r\nKom golfen in deze idyllische omgeving!"
    ],
    "es": [
      "En Les Gets, juegue contra el Mont Blanc\r\nEl campo de prácticas del Golf des Gets, situado a 55 minutos de Ginebra y a 30 minutos del Campeonato de Evian, ofrece unas vistas panorámicas excepcionales.\r\nVenga a probar el golf en este entorno idílico"
    ]
  },
  "rdfs:label": {
    "en": [
      "Practice Golf Les Gets"
    ],
    "fr": [
      "Practice Golf Les Gets"
    ],
    "nl": [
      "Praktijk Golf Les Gets"
    ]
  },
