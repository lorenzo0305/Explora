  "rdfs:comment": {
    "de": [
      "Die Kirche von Neuvecelle befindet sich in der Pfarrei Saint-André en Gavot-Léman, in der Diözese von Annecy. Die Kirche ist dem Heiligen Nikolaus geweiht und wurde innerhalb der Mauern des Schlosses von Neuvecelle errichtet, das ursprünglich im Besitz der Herren des Ortes war."
    ],
    "en": [
      "The church of Neuvecelle is located in the parish of Saint-André en Gavot-Léman, in the diocese of Annecy. Dedicated to Saint Nicolas, the church was built within the walls of the Château de Neuvecelle, originally owned by the local lords."
    ],
    "it": [
      "La chiesa di Neuvecelle si trova nella parrocchia di Saint-André en Gavot-Léman, nella diocesi di Annecy. Dedicata a San Nicola, la chiesa è costruita all'interno delle mura del Castello di Neuvecelle, originariamente di proprietà dei signori locali."
    ],
    "fr": [
      "L'église de Neuvecelle est située dans la paroisse de Saint-André en Gavot-Léman, dans le diocèse d'Annecy. Dédiée à Saint Nicolas, l’église est construite à l’intérieur de l’enceinte du Château de Neuvecelle, à l'origine propriété des seigneurs du lieu."
    ],
    "es": [
      "La iglesia de Neuvecelle se encuentra en la parroquia de Saint-André en Gavot-Léman, en la diócesis de Annecy. Dedicada a San Nicolás, la iglesia está construida dentro de las murallas del castillo de Neuvecelle, originalmente propiedad de los señores locales."
    ],
    "nl": [
      "De kerk van Neuvecelle ligt in de parochie Saint-André en Gavot-Léman, in het bisdom Annecy. De kerk is gewijd aan Saint Nicolas en werd gebouwd binnen de muren van het kasteel van Neuvecelle, dat oorspronkelijk eigendom was van de plaatselijke heren."
    ]
  },
