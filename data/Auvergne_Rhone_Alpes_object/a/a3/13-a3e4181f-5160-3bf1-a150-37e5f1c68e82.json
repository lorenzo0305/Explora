  "rdfs:comment": {
    "de": [
      "Die Ferme des Bêh Rôdent ist ein überschaubarer Bauernhof, der die Tiere und die Umwelt respektiert. Die Ziegen weiden auf den Hängen und produzieren gute Milch, die für die handwerkliche Herstellung von köstlichem Käse und Joghurt verwendet wird."
    ],
    "en": [
      "Ferme des Bêêh Rôdent is a human-scale farm, respectful of animals and the environment. The goats graze on the hillside to produce good milk, used to make delicious artisan cheeses and yoghurts."
    ],
    "it": [
      "La fattoria Bêêh Rôdent è un'azienda agricola a misura d'uomo, rispettosa degli animali e dell'ambiente. Le capre pascolano in collina per produrre un buon latte, che viene utilizzato per produrre deliziosi formaggi e yogurt artigianali."
    ],
    "fr": [
      "La ferme des Bêêh Rôdent est une ferme à taille humaine, respectueuse des animaux et de l'environnement. Les chèvres pâturent sur le coteau pour produire du bon lait qui sert à la  fabrications artisanales de délicieux fromages et yaourts."
    ],
    "es": [
      "La granja de Bêêh Rôdent es una explotación a escala humana, respetuosa con los animales y el medio ambiente. Las cabras pastan en la ladera para producir buena leche, con la que se elaboran deliciosos quesos y yogures artesanos."
    ],
    "nl": [
      "De boerderij van Bêêh Rôdent is een boerderij op menselijke schaal, met respect voor de dieren en het milieu. De geiten grazen op de heuvel en produceren goede melk, waar heerlijke ambachtelijke kazen en yoghurts van worden gemaakt."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Bêêh Rodent"
    ]
  },
