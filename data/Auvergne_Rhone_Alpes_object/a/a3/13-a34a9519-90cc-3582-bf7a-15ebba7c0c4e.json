  "rdfs:comment": {
    "de": [
      "Dieses kleine Familienrestaurant mit gemütlicher Atmosphäre bietet Ihnen eine hausgemachte Küche mit frischen Produkten. Spezialitäten und Vorschläge auf der Schiefertafel je nach Jahreszeit."
    ],
    "en": [
      "This small family restaurant has a cosy and warm atmosphere and offers home cooking with fresh products. Specialities and suggestions on the slate according to the seasons."
    ],
    "it": [
      "Questo piccolo ristorante a conduzione familiare ha un'atmosfera accogliente e calda e offre una cucina casalinga con prodotti freschi. Specialità e suggerimenti sulla lavagna in base alle stagioni."
    ],
    "fr": [
      "Ce petit restaurant familial a l’ambiance cosy et chaleureuse vous propose une cuisine maison avec des produits frais. Spécialités et suggestions à l’ardoise au fil des saisons."
    ],
    "es": [
      "Este pequeño restaurante familiar tiene un ambiente acogedor y cálido y ofrece cocina casera con productos frescos. Especialidades y sugerencias en la pizarra según las estaciones."
    ],
    "nl": [
      "Dit kleine familierestaurant heeft een gezellige, warme sfeer en serveert huisgemaakte gerechten met verse producten. Specialiteiten en suggesties op de lei met de seizoenen."
    ]
  },
