  "rdfs:comment": {
    "de": [
      "Entdecken Sie La Maison du Savon de Marseille in Valence für handwerkliche Qualitätsprodukte rund um das Bad und das tägliche Wohlbefinden.\n französisch und Englisch verfügbar.\nHaustiere willkommen."
    ],
    "en": [
      "Discover La Maison du Savon de Marseille in Valence for quality handcrafted products for everyday bathing and well-being.\n french and English available.\nPets welcome."
    ],
    "it": [
      "Scoprite La Maison du Savon de Marseille a Valence per trovare prodotti artigianali di qualità per il bagno e il benessere quotidiano.\n disponibile in francese e inglese.\nAnimali domestici ammessi."
    ],
    "fr": [
      "Découvrez La Maison du Savon de Marseille à Valence pour des produits artisanaux de qualité autour du bain et du bien-être au quotidien.\n français et anglais disponibles.\nAnimaux bienvenus."
    ],
    "nl": [
      "Ontdek La Maison du Savon de Marseille in Valence voor handgemaakte kwaliteitsproducten voor dagelijks baden en welzijn.\n frans en Engels beschikbaar.\nHuisdieren welkom."
    ],
    "es": [
      "Descubra La Maison du Savon de Marseille en Valence, donde encontrará productos artesanales de calidad para el baño y el bienestar cotidianos.\n francés e inglés disponibles.\nSe admiten animales de compañía."
    ]
  },
