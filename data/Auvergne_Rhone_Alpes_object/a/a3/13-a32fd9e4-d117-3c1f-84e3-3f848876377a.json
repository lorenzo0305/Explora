  "rdfs:comment": {
    "de": [
      "Antigym sind von der Stimme geführte Bewegungen, die darauf abzielen, den Muskeln Geschmeidigkeit, Freiheit und Mobilität zurückzugeben."
    ],
    "en": [
      "Antigym uses voice-guided movements to restore suppleness, freedom and mobility to the muscles, restore muscular balance and release emotional memories frozen in the muscles."
    ],
    "it": [
      "L'antiginnastica è una serie di movimenti guidati dalla voce, pensati per restituire flessibilità, libertà e mobilità ai muscoli, ripristinare l'equilibrio muscolare e liberare le memorie emotive congelate nei muscoli."
    ],
    "fr": [
      "L'antigym ce sont des mouvements guidés par la voix, qui cherche à redonner souplesse, liberté, mobilité aux muscles. retrouver un meilleure équilibre musculaire, libérer aussi les mémoires émotionnelles figées dans les muscles."
    ],
    "es": [
      "La antigimnasia es una serie de movimientos guiados por la voz, diseñados para devolver flexibilidad, libertad y movilidad a los músculos, restablecer el equilibrio muscular y liberar memorias emocionales congeladas en los músculos."
    ],
    "nl": [
      "Anti-gym is een serie bewegingen geleid door de stem, ontworpen om flexibiliteit, vrijheid en beweeglijkheid in de spieren te herstellen, de spierbalans te herstellen en emotionele herinneringen los te maken die in de spieren zijn vastgezet."
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'Anti-Gymnastique"
    ]
  },
