  "rdfs:comment": {
    "de": [
      "Atelier Thérèse: Stickerin und Textilkünstlerin. Nadel, Häkelnadel und Faden sind ihre Pinsel. Entdecken Sie ihre traumhafte Welt in ihrem Atelier und in ihren Ausstellungen. Workshops: Trommelstickerei, Papierstickerei, Cyanotypien."
    ],
    "en": [
      "Atelier Thérèse: embroiderer and textile artist. Needle, crochet hook and thread are her brushes. Discover her dreamlike world in her studio and exhibitions. Workshops: drum embroidery, paper embroidery, cyanotypes."
    ],
    "it": [
      "Atelier Thérèse: ricamatrice e artista tessile. Ago, gancio e filo sono i suoi pennelli. Scoprite il suo mondo onirico nel suo studio e nelle sue mostre. Laboratori: ricamo a tamburo, ricamo su carta, cianotipi."
    ],
    "fr": [
      "Atelier Thérèse : brodeuse d’art et artiste textile. L’aiguille, le crochet et le fil sont ses pinceaux. Découvrez son univers onirique dans son atelier et ses expositions. Ateliers : broderie sur tambour, sur papier, cyanotypes."
    ],
    "nl": [
      "Atelier Thérèse: borduurster en textielkunstenares. Naald, haak en draad zijn haar penselen. Ontdek haar droomwereld in haar atelier en tentoonstellingen. Workshops: trommel borduren, papier borduren, cyanotypes."
    ],
    "es": [
      "Atelier Thérèse: bordadora y artista textil. Aguja, gancho e hilo son sus pinceles. Descubra su mundo onírico en su taller y sus exposiciones. Talleres: bordado de tambor, bordado de papel, cianotipos."
    ]
  },
