  "rdfs:comment": {
    "de": [
      "Die Vélorail des Alpes ist eine 7 km lange Fahrt (14 A/R), bei der Sie das Vergnügen haben, durch vier Tunnel zu fahren, bevor Sie am Aussichtspunkt Notre Dame de Commiers ankommen, wo ein Picknickplatz auf Sie wartet."
    ],
    "en": [
      "The Vélorail des Alpes is a 7 km ride (14 return trips) during which you'll have the pleasure of crossing 4 tunnels before arriving at the Notre Dame de Commiers lookout where a picnic area awaits you."
    ],
    "it": [
      "La Vélorail des Alpes è un percorso di 7 km (14 corse di andata e ritorno) che attraversa 4 tunnel prima di raggiungere il punto panoramico di Notre Dame de Commiers, dove vi attende un'area picnic."
    ],
    "fr": [
      "Le Vélorail des Alpes c'est une balade de 7 km (14 A/R) pendant laquelle vous aurez le plaisir de traverser 4 tunnels avant d'arriver au belvédère de Notre Dame de Commiers où une aire de pique nique vous attend."
    ],
    "es": [
      "El Vélorail des Alpes recorre 7 km (14 viajes de ida y vuelta) a través de 4 túneles antes de llegar al mirador de Notre Dame de Commiers, donde le espera una zona de picnic."
    ],
    "nl": [
      "De Vélorail des Alpes is een rit van 7 km (14 retourritten) door 4 tunnels voordat je het uitkijkpunt bij Notre Dame de Commiers bereikt, waar een picknickplaats op je wacht."
    ]
  },
