  "rdfs:comment": {
    "de": [
      "Moderne und kreative französische Küche. Durch wechselnde Menüs interpretiert der Koch die klassischen Grundlagen kreativ neu und würdigt saisonale Produkte sowie lokale Produzenten.\r\nOffene Küche, warme Atmosphäre."
    ],
    "en": [
      "Modern and inventive French cuisine. Through evolving menus, the chef reinterprets classic basics with creativity by highlighting seasonal products and local producers.\r\nOpen kitchen, warm setting."
    ],
    "it": [
      "Cucina francese moderna e inventiva. Con menù mutevoli, lo chef reinterpreta i classici con creatività, privilegiando i prodotti di stagione e i produttori locali. Cucina aperta, ambiente caldo."
    ],
    "fr": [
      "Cuisine française moderne et inventive. A travers des menus évolutifs,  le chef réinterprète les bases classiques avec créativité en mettant à l'honneur les produits de saison et les producteurs locaux. Cuisine ouverte, cadre chaleureux."
    ],
    "nl": [
      "Moderne en inventieve Franse keuken. Door evoluerende menu's herinterpreteert de chef klassieke basis met creativiteit door seizoensproducten en lokale producenten te benadrukken.\r\nOpen keuken, warme setting."
    ],
    "es": [
      "Cocina francesa moderna e inventiva. Con menús cambiantes, el chef reinterpreta los clásicos con creatividad, dando prioridad a los productos de temporada y a los productores locales. Cocina abierta, ambiente cálido."
    ]
  },
