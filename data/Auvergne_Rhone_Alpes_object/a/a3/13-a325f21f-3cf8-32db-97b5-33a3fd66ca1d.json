  "rdfs:comment": {
    "de": [
      "Das NH Lyon Airport verfügt über ein Café, ein Restaurant und eine Bar. Das Restaurant \"Les 100 Ciels\" bietet eine französische und internationale Küche, die sich durch ihre Qualität auszeichnet und die \"französische Lebensart\" in den Vordergrund stellt."
    ],
    "en": [
      "The NH Lyon Airport has a café, restaurant and bar. The ‘Les 100 Ciels’ restaurant offers French and international cuisine of unquestionable quality, celebrating the ‘art de vivre à la Française’."
    ],
    "it": [
      "L'NH Lyon Airport dispone di una caffetteria, un ristorante e un bar. Il ristorante \"Les 100 Ciels\" offre una cucina francese e internazionale di qualità indiscutibile, che celebra l'\"art de vivre à la Française\"."
    ],
    "fr": [
      "Le NH Lyon Airport possède un café, un restaurant et un bar. Le restaurant « les 100 Ciels » offre une cuisine française et internationale qui se démarque indiscutablement par sa qualité, en mettant à l’honneur « l’art de vivre à la Française »."
    ],
    "nl": [
      "Het NH Lyon Airport heeft een café, restaurant en bar. Het restaurant \"Les 100 Ciels\" biedt Franse en internationale gerechten van onbetwistbare kwaliteit en viert de \"art de vivre à la Française\"."
    ],
    "es": [
      "El NH Lyon Aeropuerto dispone de cafetería, restaurante y bar. El restaurante \"Les 100 Ciels\" ofrece cocina francesa e internacional de calidad indiscutible, celebrando el \"art de vivre à la Française\"."
    ]
  },
