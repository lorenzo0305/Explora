  "rdfs:comment": {
    "de": [
      "Fest am 14. Juli mit dem Programm für den 13. Juli: Fackelzug ab dem Rathaus um 22 Uhr, großes Feuerwerk 23 Uhr und Tanzabend. Am 14. Juli: offizielle Parade mit der Harmonie de Paulhaguet um 11 Uhr."
    ],
    "en": [
      "July 14th festivities: torchlight procession from the town hall at 10pm, fireworks display at 11pm and dancing. On July 14, official parade with the Paulhaguet brass band at 11am."
    ],
    "it": [
      "Festa del 14 luglio: fiaccolata dal municipio alle 22.00, spettacolo pirotecnico alle 23.00 e balli. Il 14 luglio, sfilata ufficiale con la banda di Paulhaguet alle 11.00."
    ],
    "fr": [
      "Fête du 14 juillet avec au programme pour le 13 juillet : retraite aux flambeaux au départ de la mairie à 22h, grand feu d'artifice 23h et soirée dansante. Le 14 juillet, défilé officiel avec l'Harmonie de Paulhaguet à 11h."
    ],
    "es": [
      "Fiesta del 14 de julio: procesión de antorchas desde el ayuntamiento a las 22:00 h, espectáculo de fuegos artificiales a las 23:00 h y baile. El 14 de julio, desfile oficial con la banda de música de Paulhaguet a las 11h."
    ],
    "nl": [
      "Feest van 14 juli: fakkeltocht vanaf het gemeentehuis om 22.00 uur, vuurwerk om 23.00 uur en dans. Op 14 juli, officiële parade met de fanfare van Paulhaguet om 11 uur."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Fête du 14 juillet | Paulhaguet"
    ]
  },
