  "rdfs:comment": {
    "de": [
      "Le Bratoria liegt in der Nähe von Brignais (15 km von Lyon, 23 km von Vienne und 45 km von Saint-Etienne entfernt) und bietet Ihnen in einem angenehmen und freundlichen Rahmen die Qualitätsleistungen, die Sie sich für einen beruflichen oder familiären Aufenthalt wünschen."
    ],
    "en": [
      "Hotel Saint Vincent is located close to Brignais, (15Km from Lyon, 23Km from Vienne and 45Km from Saint-Etienne) and provides the pleasant setting, convivial atmosphere and top quality services that guests come looking for"
    ],
    "it": [
      "Situato nei pressi di Brignais (15 km da Lione, 23 km da Vienne e 45 km da Saint-Etienne), il Bratoria offre i servizi di qualità che cercate in un ambiente piacevole e accogliente, sia che siate in viaggio d'affari o in vacanza con la famiglia."
    ],
    "fr": [
      "Le Bratoria situé à proximité de Brignais, (à 15Km de Lyon, 23Km de Vienne et 45Km de Saint-Etienne), vous propose dans un cadre agréable et convivial les prestations de qualité que vous recherchez dans le cadre d'un séjour professionnel ou familial."
    ],
    "es": [
      "Situada cerca de Brignais (a 15 km de Lyon, 23 km de Vienne y 45 km de Saint-Etienne), la Bratoria le ofrece los servicios de calidad que busca en un entorno agradable y acogedor, tanto si se encuentra en viaje de negocios como de vacaciones en familia."
    ],
    "nl": [
      "Het Bratoria ligt in de buurt van Brignais (15 km van Lyon, 23 km van Vienne en 45 km van Saint-Etienne) en biedt de kwaliteitsdiensten die u zoekt in een aangename, vriendelijke omgeving, of u nu op zakenreis bent of met het gezin op vakantie."
    ]
  },
  "rdfs:label": {
    "en": [
      "Bratoria Hotel restaurant"
    ],
    "fr": [
      "Hôtel Restaurant Le Bratoria"
    ]
  },
