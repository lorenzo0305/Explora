  "rdfs:comment": {
    "de": [
      "Im Parc Thermal du Fayet gelegen, profitieren Sie von den zwei Quick-Tennisplätzen, die eine ruhige Umgebung bieten, um mit Freunden oder der Familie Tennis zu spielen."
    ],
    "en": [
      "Located in the Parc Thermal du Fayet, the two quick-court tennis courts offer a peaceful setting for playing tennis with friends or family."
    ],
    "it": [
      "Situati nel Parc Thermal du Fayet, i due campi da tennis a campo rapido offrono un ambiente tranquillo per giocare a tennis con gli amici o la famiglia."
    ],
    "fr": [
      "Situés au Parc Thermal du Fayet, profitez des deux courts de tennis en quick offrant un environnement calme pour pratiquer le tennis entre amis ou en famille."
    ],
    "es": [
      "Situadas en el Parque Termal du Fayet, las dos pistas de tenis rápidas ofrecen un entorno tranquilo para jugar al tenis con amigos o en familia."
    ],
