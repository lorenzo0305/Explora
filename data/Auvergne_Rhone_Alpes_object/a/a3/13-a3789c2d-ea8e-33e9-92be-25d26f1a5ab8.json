  "rdfs:comment": {
    "de": [
      "Das Restaurant Le Fangle bietet 140 Sitzplätze im Innenbereich und 100 Sitzplätze auf der Terrasse. Die Bergküche und die savoyischen Spezialitäten wärmen und stärken die Besucher"
    ],
    "en": [
      "Le Fangle restaurant can accommodate 140 diners indoors and 100 outdoors, on the terrace. Mountain cuisine and Sayorard specialities, designed to warm up, energize and invigorate visitors and skiers!"
    ],
    "it": [
      "Il ristorante Le Fangle offre 140 posti a sedere all'interno e 100 sulla terrazza. Cucina di montagna e specialità savoiarde per riscaldare e rinvigorire i visitatori!"
    ],
    "fr": [
      "Le restaurant Le Fangle offre 140 places assises à l'intérieur et 100 places en terrasse. Une cuisine de montagne et des spécialités savoyardes qui réchauffent et tiennent au corps pour que les visiteurs puissent prendre des forces!"
    ],
    "nl": [
      "Restaurant Le Fangle biedt 140 zitplaatsen binnen en 100 plaatsen op het terras. Een typische keuken uit de bergen en specialiteiten uit de Savoie voor een stevige maaltijd waar skiërs en bezoekers weer mee op krachten kunnen komen."
    ],
    "es": [
      "El restaurante Le Fangle tiene capacidad para 140 comensales en el interior y 100 en la terraza. Cocina de montaña y especialidades saboyanas para calentar y vigorizar a los visitantes"
    ]
  },
