  "rdfs:comment": {
    "de": [
      "Entdecken Sie Morges anlässlich seines 56. Tulpenfestes, das unter dem Motto \"Märchen und Legenden\" steht. Im Parc de l'Indépendance, am Ufer des Genfer Sees, mit Blick auf den Mont Blanc, werden sich mehr als 140.000 Tulpen von 350 Sorten enthüllen..."
    ],
    "en": [
      "Discover Morges at its 56th Tulip Festival, on the theme of Tales and Legends. In the Parc de l'Indépendance, on the shores of Lake Geneva, facing Mont Blanc, more than 140,000 tulips of 350 varieties..."
    ],
    "it": [
      "Scoprite Morges alla 56ª edizione della Festa dei tulipani, con il tema \"Racconti e leggende\". Più di 140.000 tulipani di 350 varietà saranno esposti nel Parc de l'Indépendance, sulle rive del Lago di Ginevra, di fronte al Monte Bianco..."
    ],
    "fr": [
      "Partez à la découverte de Morges à l'occasion de sa 56ème Fête de la Tulipe, placée sous le thème des Contes et Légendes. Dans le Parc de l'Indépendance, au bord du Lac Léman, face au mont Blanc, se dévoileront plus de 140 000 tulipes de 350 variétés..."
    ],
    "nl": [
      "Ontdek Morges tijdens het 56e Tulpenfestival, met als thema Verhalen en Legenden. Meer dan 140.000 tulpen van 350 variëteiten zullen te zien zijn in het Parc de l'Indépendance, aan de oevers van het meer van Genève, tegenover de Mont Blanc..."
    ],
    "es": [
      "Descubra Morges en el 56º Festival del Tulipán, con su tema de Cuentos y Leyendas. Más de 140.000 tulipanes de 350 variedades se expondrán en el Parc de l'Indépendance, a orillas del lago Lemán, frente al Mont Blanc...."
    ]
  },
  "rdfs:label": {
    "en": [
      "Excursion - Tulip Festival in Morges"
    ],
    "fr": [
      "Excursion - Fête de la Tulipe à Morges"
    ]
  },
