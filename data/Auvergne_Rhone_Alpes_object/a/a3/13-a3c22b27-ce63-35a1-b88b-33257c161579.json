  "rdfs:comment": {
    "de": [
      "Verbringen Sie nach einem schönen Tag auf der Piste einen gemütlichen Moment mit Ihrer Familie oder Ihren Freunden. Das Restaurant bietet Ihnen \"Après-Ski\"-Teller, neu interpretierte Burger oder auch köstliche Aperitifs an der Theke."
    ],
    "en": [
      "Share a friendly moment with your family or friends after a good day on the slopes. The restaurant offers \"après-ski\" plates, revisited burgers or delicious drinks at the counter."
    ],
    "it": [
      "Condividete un momento di convivialità con la famiglia o gli amici dopo una bella giornata sulle piste. Il ristorante offre piatti \"après-ski\", hamburger rivisitati o deliziosi aperitivi al banco."
    ],
    "fr": [
      "Partagez un moment convivial avec votre famille ou vos amis après une bonne journée sur les pistes. Le restaurant vous propose assiettes « après-ski », burgers revisités ou encore délicieux apéritifs au comptoir."
    ],
    "nl": [
      "Deel een gezellig moment met je familie of vrienden na een geweldige dag op de piste. Het restaurant biedt 'après-ski' gerechten, vernieuwde hamburgers en heerlijke aperitieven aan de bar."
    ],
    "es": [
      "Comparta un momento de convivencia con su familia o amigos después de un buen día en las pistas. El restaurante le ofrece platos \"après-ski\", hamburguesas revisitadas o deliciosos aperitivos en la barra."
    ]
  },
