  "rdfs:comment": {
    "de": [
      "Wir sind eine kleine Familienpizzeria, die neapolitanische Pizzen anbietet, die auf handwerkliche Weise aus italienischem Mehl und frischen Produkten zubereitet werden."
    ],
    "en": [
      "We're a small, family-run pizzeria serving Neapolitan pizzas made by hand using Italian flours and fresh produce."
    ],
    "it": [
      "Siamo una piccola pizzeria a conduzione familiare che serve pizze napoletane preparate con metodi tradizionali, farine italiane e prodotti freschi."
    ],
    "fr": [
      "Nous sommes une petite pizzéria familiale proposant des pizzas napolitaines préparées de façon artisanales à base de farines italiennes et produits frais."
    ],
