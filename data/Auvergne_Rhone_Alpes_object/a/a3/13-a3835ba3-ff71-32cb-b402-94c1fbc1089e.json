  "rdfs:comment": {
    "de": [
      "Auf der Straße zum Mont-Dore in Orcival parken Sie am Parkplatz des Col de Guéry und steigen dann zu Fuß über den GR 30 zum Gipfel auf (Höhenmeter 250 m - 45 min)."
    ],
    "en": [
      "From the road leading from Le Mont-Dore to Orcival, park at the Col de Guéry parking lot, then climb to the summit on foot via the GR 30 (deniv.250 m - 45 mn)."
    ],
    "it": [
      "Prendere la strada da Le Mont-Dore a Orcival, parcheggiare al parcheggio del Col de Guéry e salire a piedi fino alla vetta sul GR 30 (250 m di altitudine - 45 minuti)."
    ],
    "fr": [
      "Par la route allant au Mont-Dore à Orcival se garer au parking du Col de Guéry puis monter à pied au sommet par le GR 30 (deniv.250 m - 45 mn)."
    ],
    "es": [
      "Tomar la carretera de Le Mont-Dore a Orcival, aparcar en el parking del Col de Guéry y subir a pie a la cumbre por el GR 30 (250 m de altitud - 45 min)."
    ],
    "nl": [
      "Neem de weg van Le Mont-Dore naar Orcival, parkeer op de parkeerplaats Col de Guéry en wandel naar de top over de GR 30 (250 m hoogte - 45 min)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Terrain de pratique de parapente - Le Puy de l'Ouire"
    ]
  },
