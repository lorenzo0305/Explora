  "rdfs:comment": {
    "de": [
      "5000 verfügbare Dokumente für alle Altersgruppen: Roman, Krimi, Lokalgeschichte, Dokumentarfilm, Zeitschrift, Album, Märchen, Comic, Biografie..., die regelmäßig durch den Kauf von Neuheiten oder durch Ausleihen von Savoie Biblio erneuert werden."
    ],
    "en": [
      "5000 documents available for all ages: novels, detective novels, local history, documentaries, magazines, albums, stories, comic strips, biographies..., regularly renewed by buying new items or loans from Savoie Biblio."
    ],
    "it": [
      "5.000 documenti disponibili per tutte le età: romanzi, gialli, storia locale, documentari, riviste, album, storie, fumetti, biografie, ecc., regolarmente rinnovati attraverso l'acquisto di nuovi articoli o i prestiti di Savoia Biblio."
    ],
    "fr": [
      "5000 documents disponibles pour tous les âges : roman, roman policier, histoire locale, documentaire, magazine, album, conte, bande dessinée, biographie…, renouvelés régulièrement par des achats de nouveautés ou des prêts de Savoie Biblio."
    ],
    "nl": [
      "5000 documenten beschikbaar voor alle leeftijden: romans, detectiveverhalen, lokale geschiedenis, documentaires, tijdschriften, albums, verhalen, strips, biografieën, enz., regelmatig vernieuwd door de aankoop van nieuwe stukken of uitleningen van Savoie Biblio."
    ],
    "es": [
      "5.000 documentos disponibles para todas las edades: novelas, novelas policíacas, historia local, documentales, revistas, álbumes, cuentos, cómics, biografías, etc., que se renuevan regularmente mediante la compra de nuevos ejemplares o el préstamo de Savoie Biblio."
