  "rdfs:comment": {
    "de": [
      "Handwerkliche Ölmühle in der Drôme. Besichtigung der Mühle und Verkostung an der Ölbar. Direktverkauf von DOP-Olivenölen, Oliven, Lebensmitteln und anderen Spezialitäten."
    ],
    "en": [
      "Artisanal oil mill in the Drôme. Visit to the mill and tasting at the oil bar. Direct sales of PDO olive oils, olives, grocery products and other specialties."
    ],
    "it": [
      "Frantoio artigianale nella Drôme. Visita al frantoio e degustazione al bar dell'olio. Vendita diretta di oli d'oliva DOP, olive, prodotti di gastronomia e altre specialità."
    ],
    "fr": [
      "Huilerie artisanale de la Drôme. Visite du moulin et dégustation au bar à huiles. Vente directe d’huiles d’olive AOP, olives, produits d’épicerie fine et autres spécialités."
    ],
    "nl": [
      "Ambachtelijke oliemolen in de Drôme. Bezoek aan de molen en proeverij in de oliebar. Directe verkoop van olijfolie met BOB, olijven, kruidenierswaren en andere specialiteiten."
    ],
    "es": [
      "Almazara artesanal en la Drôme. Visita de la almazara y degustación en el bar de aceites. Venta directa de aceites de oliva DOP, aceitunas, productos delicatessen y otras especialidades."
    ]
  },
