  "rdfs:comment": {
    "de": [
      "Minet empfängt Sie in seiner rustikal eingerichteten Bar/Restaurant für eine Mittags- und/oder Kaffeepause, auf der Terrasse oder im Innenbereich, im Zentrum des Dorfes und nur wenige Minuten von der Freizeitanlage Vallée Bleue entfernt!"
    ],
    "en": [
      "Minet welcomes you in its bar/restaurant with a rustic decoration for a lunch and/or coffee break, on the terrace or inside, in the center of the village and a few minutes away from the leisure center of the Vallée Bleue !"
    ],
    "it": [
      "Minet vi accoglie nel suo bar/ristorante dall'arredamento rustico per un pranzo e/o una pausa caffè, sulla terrazza o all'interno, proprio nel centro del paese e a pochi minuti dal centro ricreativo Vallée Bleue!"
    ],
    "fr": [
      "Minet vous accueille dans son bar/restaurant à la décoration rustique pour une pause déjeuner et/ou café, en terrasse ou en intérieur, en plein centre du village et à quelques minutes de la base de loisirs de la Vallée Bleue !"
    ],
    "nl": [
      "Minet verwelkomt u in zijn bar/restaurant met zijn rustieke inrichting voor een lunch en/of koffiepauze, op het terras of binnen, midden in het dorp en op enkele minuten van het recreatiecentrum Vallée Bleue!"
    ],
    "es": [
      "Minet le da la bienvenida a su bar/restaurante de decoración rústica para almorzar y/o tomar un café, en la terraza o en el interior, ¡en pleno centro del pueblo y a pocos minutos del centro de ocio Vallée Bleue!"
    ]
  },
