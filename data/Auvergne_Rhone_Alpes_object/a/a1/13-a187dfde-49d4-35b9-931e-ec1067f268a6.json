  "rdfs:comment": {
    "de": [
      "Das Mutterhaus der Palets d'Or, einer Spezialität aus Moulins, ist das Geschäft, in dem Bernard Sérardy 1898 diese abgeflachte Schokolade aus frischer Sahne und Kaffee, die mit einer feinen Goldfolie überzogen ist, kreierte."
    ],
    "en": [
      "Mother house of the Palets d'Or, a speciality of Moulins, it is in this shop that Bernard Sérardy created in 1898 this flattened chocolate, based on fresh cream and coffee, covered with a fine gold leaf."
    ],
    "it": [
      "Capostipite dei Palets d'Or, specialità di Moulins, è in questo negozio che Bernard Sérardy creò nel 1898 questo cioccolato schiacciato, a base di panna fresca e caffè, ricoperto da una sottile foglia d'oro."
    ],
    "fr": [
      "Maison mère des Palets d'Or, spécialité de Moulins, c'est dans cette boutique que Bernard Sérardy a crée en 1898 ce chocolat aplati, à base de crème fraiche et de café, recouvert d'une fine feuille d'or."
    ],
    "es": [
      "La empresa matriz de los Palets d'Or, una especialidad de Moulins, fue en esta tienda donde Bernard Sérardy creó en 1898 este chocolate aplastado, hecho con crema fresca y café, cubierto con una fina hoja de oro."
    ],
    "nl": [
      "Bernard Sérardy, het moederbedrijf van de Palets d'Or, een specialiteit van Moulins, creëerde in deze winkel in 1898 deze geplette chocolade op basis van verse room en koffie, bedekt met een dun laagje bladgoud."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Palets d'Or"
    ]
  },
