  "rdfs:comment": {
    "de": [
      "In einer Bistro-Atmosphäre bieten sie zur Aperitif- oder Essenszeit die Möglichkeit, mit Freunden ein paar Austern zu probieren."
    ],
    "en": [
      "In a bistro atmosphere, they propose at the time of the aperitif or the meal, to taste some oysters between friends."
    ],
    "it": [
      "In un'atmosfera da bistrot, propongono di gustare qualche ostrica con gli amici durante l'aperitivo o il pasto."
    ],
    "fr": [
      "Dans une ambiance bistrot, ils proposent à l’heure de l’apéro ou du repas, de déguster quelques huîtres entre amis."
    ],
    "nl": [
      "In een bistrosfeer stellen zij voor om met vrienden te genieten van enkele oesters tijdens het aperitief of de maaltijd."
    ],
    "es": [
      "En un ambiente de bistró, proponen disfrutar de unas ostras con los amigos durante el aperitivo o la comida."
    ]
  },
