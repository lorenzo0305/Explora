  "rdfs:comment": {
    "de": [
      "Jean Porte ist auf hausgemachte Pizzas und Hotdogs spezialisiert. Kein eigener Speisesaal, aber es besteht die Möglichkeit, etwas mitzunehmen oder im Café la Bastille mit Verzehr zu genießen."
    ],
    "en": [
      "Jean Porte specializes in homemade pizzas and hot dogs. No restaurant, but you can take away or enjoy a drink at Café la Bastille."
    ],
    "it": [
      "Jean Porte è specializzato in pizze e hot dog fatti in casa. Non c'è un ristorante, ma è possibile prendere un drink da asporto al Café la Bastille e al Café la Placette."
    ],
    "fr": [
      "Jean Porte est spécialisé dans les pizzas et hot dogs maison. Pas de salle de restaurant mais possibilité de prendre à emporter ou de déguster au Café la Bastille et au café la placette avec consommation."
    ],
    "nl": [
      "Jean Porte is gespecialiseerd in huisgemaakte pizza's en hotdogs. Er is geen restaurant, maar je kunt wel afhalen of genieten van een drankje in Café la Bastille."
    ],
    "es": [
      "Jean Porte está especializado en pizzas caseras y perritos calientes. No hay restaurante, pero se puede llevar o tomar algo en el Café la Bastille y el Café la Placette."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Pizzeria Jean Porte"
    ]
  },
