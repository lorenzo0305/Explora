          "additionalInformation": {
            "de": [
              "Die Bar empfängt Sie von Mittwoch bis Sonntag.\r\n- Mittwoch: 14 -23 Uhr\r\n- Donnerstag: 18 - 23 Uhr\r\n- Freitag: 18 - 23 Uhr\r\n- Samstag: 14 -23 Uhr\r\n- Sonntag: 14 -20 Uhr\r\n+ Escape game geöffnet von Montag bis Sonntag von 10 bis 23 Uhr mit Reservierung: Besuchen Sie unsere Website, um die verfügbaren Zeitfenster zu sehen!"
            ],
            "en": [
              "The Bar welcomes you from Wednesday to Sunday.\r\n- Wednesday: 2pm - 11pm\r\n- Thursday: 6pm - 11pm\r\n- Friday: 6pm - 11pm\r\n- Saturday: 2pm - 11pm\r\n- Sunday: 2pm - 8pm\r\n+ Escape game open Monday to Sunday, 10am to 11pm by reservation: visit our website to see available slots!"
            ],
            "it": [
              "Il bar è aperto dal mercoledì alla domenica.\r\n- Mercoledì: 14:00 - 23:00\r\n- Giovedì: dalle 18.00 alle 23.00\r\n- Venerdì: dalle 18.00 alle 23.00\r\n- Sabato: dalle 14.00 alle 23.00\r\n- Domenica: dalle 14.00 alle 20.00\r\n+ Escape game aperto dal lunedì alla domenica dalle 10.00 alle 23.00 su prenotazione: visita il nostro sito per vedere gli slot disponibili!"
            ],
            "fr": [
              "Le Bar vous accueille du Mercredi au Dimanche.\r\n- Mercredi : 14 -23h\r\n- Jeudi : 18 - 23h\r\n- Vendredi : 18 - 23h\r\n- Samedi : 14 -23h\r\n- Dimanche : 14 -20h\r\n+ Escape game ouvert du lundi au dimanche de 10h à 23h sur réservation : visitez notre site pour voir les créneaux disponibles !"
            ],
            "es": [
              "El Bar está abierto de miércoles a domingo.\r\n- Miércoles: 14.00 h - 23.00 h\r\n- Jueves: 18.00 h - 23.00 h\r\n- Viernes: 18.00 h - 23.00 h\r\n- Sábado: 14.00 h - 23.00 h\r\n- Domingo: 14.00 h - 20.00 h\r\n+ Juego de escape abierto de lunes a domingo de 10:00 a 23:00 con reserva previa: ¡visite nuestro sitio web para ver las franjas horarias disponibles!"
            ],
            "nl": [
              "De bar is geopend van woensdag tot zondag.\r\n- Woensdag: 14.00 - 23.00\r\n- Donderdag: 18.00 - 23.00\r\n- Vrijdag: 18.00 - 23.00\r\n- Zaterdag: 14.00 - 23.00\r\n- Zondag: 14.00 - 20.00 uur\r\n+ Escape spel geopend van maandag tot zondag van 10u tot 23u op reservatie: bezoek onze website om de beschikbare plaatsen te zien!"
            ]
          },
