  "rdfs:comment": {
    "de": [
      "Ihr neues Ziel für Spaß und Spiel!\r\nTauchen Sie mit unseren Escape Games in das Mysterium und in das Abenteuer unserer Spielebar ein!\r\nWir bieten Ihnen ein außergewöhnliches Spielerlebnis im Mystere."
    ],
    "en": [
      "Your new play destination!\r\nImmerse yourself in Mystere with our escapes games and in the adventure of our game bar!\r\nWe invite you to enjoy an extraordinary gaming experience at Mystere."
    ],
    "it": [
      "La vostra nuova destinazione ludica!\r\nImmergetevi in Mystere con i nostri giochi di evasione e nell'avventura del nostro bar!\r\nVi invitiamo a vivere un'esperienza di gioco straordinaria a Mystere."
    ],
    "fr": [
      "Votre nouvelle destination ludique!\r\nPlongez dans le Mystère avec nos escapes games et dans l’aventure de notre bar à jeux!\r\nNous vous proposons de vivre une expérience de jeux hors du commun chez Mystere."
    ],
    "es": [
      "¡Tu nuevo destino de juego!\r\n¡Sumérgete en Mystere con nuestros juegos de escape y en la aventura de nuestro bar de juegos!\r\nLe invitamos a disfrutar de una extraordinaria experiencia de juego en Mystere."
    ],
    "nl": [
      "Je nieuwe speelbestemming!\r\nDompel je onder in Mystere met onze ontsnappingsspellen en in het avontuur van onze spelletjesbar!\r\nWe nodigen je uit voor een buitengewone spelervaring bij Mystere."
    ]
  },
