  "rdfs:comment": {
    "de": [
      "Verleih von zahmen und liebevollen Eseln, die bis zu 35 kg tragen können, für eine Wanderung von einem halben Tag, einem ganzen Tag oder mehreren Tagen. Annäherung und Kontakt mit dem Tier für einen Spaziergang mit der Familie, unter Freunden oder in einer Gruppe."
    ],
    "en": [
      "Rental of docile, affectionate donkeys, capable of carrying up to 35 kg, for 1/2-day, full-day or multi-day rides. Approach and contact with the animal for a walk with family, friends or a group."
    ],
    "it": [
      "Noleggiate asini docili e affettuosi, in grado di trasportare fino a 35 kg, per passeggiate di mezza giornata, giornata intera o più giorni. Avvicinamento e contatto con l'animale per una passeggiata con la famiglia, gli amici o in gruppo."
    ],
    "fr": [
      "Location d'ânes dociles et affectueux, capables de porter jusqu'à 35 kg, à l'occasion d'une balade 1/2 journée , journée ou plusieurs jours. Approche et contact de l'animal pour une balade en famille, entre amis ou en groupe."
    ],
    "nl": [
      "Huur volgzame, aanhankelijke ezels, die tot 35 kg kunnen dragen, voor halve dagen, hele dagen of meerdaagse tochten. Benader en maak contact met het dier voor een wandeling met familie, vrienden of in een groep."
    ],
    "es": [
      "Alquile burros dóciles y cariñosos, capaces de cargar hasta 35 kg, para paseos de medio día, día completo o varios días. Acercamiento y contacto con el animal para un paseo en familia, con amigos o en grupo."
    ]
  },
