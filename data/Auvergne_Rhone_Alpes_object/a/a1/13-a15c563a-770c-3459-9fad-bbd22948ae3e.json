  "rdfs:comment": {
    "de": [
      "Eine dynamische Skischule!\r\n25 Skilehrer und zwei Sekretärinnen empfangen Sie den ganzen Winter über und bieten Ihnen Unterricht in allen Wintersportarten an."
    ],
    "en": [
      "A dynamic ski school!\r\n25 ski instructors and two secretaries welcome you all winter long and offer lessons in all types of snow sports."
    ],
    "it": [
      "Una scuola di sci dinamica!\r\nI maestri di sci sono a disposizione per tutto l'inverno per insegnarvi tutti i diversi sport invernali."
    ],
    "fr": [
      "Une école de ski dynamique !\r\nDes monitrices et des moniteurs de ski vous accueillent tout l'hiver et vous proposent l'enseignement de toutes les glisses."
    ],
    "es": [
      "Una escuela de esquí dinámica\r\nLos monitores de esquí están a tu disposición todo el invierno para enseñarte los diferentes deportes de invierno."
