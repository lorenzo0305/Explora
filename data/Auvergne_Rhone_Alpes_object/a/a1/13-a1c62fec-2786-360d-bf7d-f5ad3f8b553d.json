  "rdfs:comment": {
    "de": [
      "Diese 22 km lange Radroute zwischen Montluçon und Vallon-en-Sully verspricht eine Fahrt, die Ruhe und kulturelle Entdeckungen miteinander verbindet."
    ],
    "en": [
      "This 22-kilometre cycle route between Montluçon and Vallon-en-Sully promises a ride that combines peace and quiet with cultural discoveries."
    ],
    "it": [
      "Questo percorso ciclabile di 22 km tra Montluçon e Vallon-en-Sully offre una pedalata rilassante e la possibilità di scoprire attrazioni culturali."
    ],
    "fr": [
      "Cet itinéraire cyclable de 22 kilomètres entre Montluçon et Vallon-en-Sully promet une balade alliant calme et découvertes culturelles."
    ],
    "es": [
      "Esta ruta ciclista de 22 kilómetros entre Montluçon y Vallon-en-Sully ofrece un paseo relajante y la oportunidad de descubrir lugares de interés cultural."
    ],
    "nl": [
      "Deze fietsroute van 22 kilometer tussen Montluçon en Vallon-en-Sully biedt een ontspannen rit en een kans om culturele bezienswaardigheden te ontdekken."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Voie verte du canal de Berry"
    ]
  },
