  "rdfs:comment": {
    "de": [
      "Das Tourismusbüro von La Plagne Champagny-en-Vanoise befindet sich im Herzen des Dorfes und der Geschäfte und empfängt Sie das ganze Jahr über."
    ],
    "en": [
      "Located in the heart of the village and shops, the La Plagne Champagny-en-Vanoise Tourist Office welcomes you all year round."
    ],
    "it": [
      "Situato nel cuore del villaggio e dei negozi, l'Ufficio del Turismo di La Plagne Champagny-en-Vanoise vi accoglie tutto l'anno."
    ],
    "fr": [
      "Situé au cœur du village et des commerces, l'Office de tourisme de La Plagne Champagny-en-Vanoise vous accueille toute l'année."
    ],
    "es": [
      "Situada en el corazón del pueblo y de los comercios, la Oficina de Turismo de La Plagne Champagny-en-Vanoise le da la bienvenida todo el año."
    ],
    "nl": [
      "Het toeristenbureau van La Plagne Champagny-en-Vanoise ligt in het hart van het dorp en de winkels en verwelkomt je het hele jaar door."
    ]
  },
