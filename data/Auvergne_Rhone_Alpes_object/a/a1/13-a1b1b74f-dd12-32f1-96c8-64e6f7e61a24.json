  "rdfs:comment": {
    "de": [
      "Au Primeur du Chantre bevorzugt den kurzen Vertriebsweg und bietet Ihnen erntefrisches, hochwertiges Obst und Gemüse aus der Drôme und der Ardèche. Der Verzehr von saisonalem Obst und Gemüse ist eine Garantie für geschmackliche und ernährungsphysiologische Qualität."
    ],
    "en": [
      "Au Primeur du Chantre offers freshly harvested, quality fruit and vegetables from the Drôme and Ardèche regions. Eating seasonal fruit and vegetables is a guarantee of quality taste and nutrition."
    ],
    "it": [
      "Au Primeur du Chantre offre frutta e verdura di qualità appena raccolta e proveniente dalle regioni della Drôme e dell'Ardèche. Mangiare frutta e verdura di stagione è una garanzia di gusto e nutrizione di qualità."
    ],
    "fr": [
      "En privilégiant le circuit court, Au Primeur du Chantre vous propose des fruits et légumes fraîchement récoltés et de qualité de Drôme et d'Ardèche. Consommer les fruits et légumes de saison, c’est la garantie d’une qualité gustative et nutritionnelle."
    ],
    "es": [
      "Au Primeur du Chantre ofrece frutas y verduras de calidad recién recolectadas en las regiones de Drôme y Ardèche. Comer fruta y verdura de temporada es garantía de calidad gustativa y nutricional."
    ],
    "nl": [
      "Au Primeur du Chantre biedt vers geoogst kwaliteitsfruit en -groenten uit de Drôme en de Ardèche. Het eten van seizoensfruit en -groenten is een garantie voor smaak en voedingswaarde."
    ]
  },
