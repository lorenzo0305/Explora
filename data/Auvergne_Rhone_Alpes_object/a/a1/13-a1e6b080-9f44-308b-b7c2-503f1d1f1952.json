  "rdfs:comment": {
    "de": [
      "In Bassignac, am Ufer des Flusses Sumène, können Sie sich im Mais verlieren! Zwei Labyrinthe und zwei Sinnesparcours sind auf beiden Seiten des Flusses angelegt. Eine Hängebrücke ermöglicht es, von der einen auf die andere Seite zu gelangen: Nervenkitzel garantiert!"
    ],
    "en": [
      "In Bassignac, on the banks of the Sumène, come and lose yourself in the corn! Two mazes and a barefoot trail have been laid out on either side of the river. A suspended footbridge takes you from one side to the other: thrills guaranteed!"
    ],
    "it": [
      "A Bassignac, sulle rive della Sumène, venite a perdervi nel mais! Due labirinti e due percorsi sensoriali sono stati allestiti su entrambe le sponde del fiume. Una passerella sospesa vi porterà da una sponda all'altra: emozioni garantite!"
    ],
    "fr": [
      "A Bassignac, au bord de la Sumène, venez vous perdre dans le maïs ! Deux labyrinthes et 2 parcours sensoriels sont aménagés de part et d’autre de la rivière. Une passerelle suspendue permet de passer d’un côté et de l’autre : sensations garanties !"
    ],
    "nl": [
      "Kom in Bassignac, aan de oevers van de Sumène, verdwalen in het graan! Aan weerszijden van de rivier zijn twee doolhoven en 2 zintuigenpaden aangelegd. Een hangbrug brengt je van de ene naar de andere kant: sensatie gegarandeerd!"
    ],
    "es": [
      "En Bassignac, a orillas del Sumène, venga a perderse en el maíz A ambos lados del río se han instalado dos laberintos y dos recorridos sensoriales. Una pasarela suspendida le llevará de una orilla a otra: ¡emoción garantizada!"
    ]
  },
  "rdfs:label": {
    "en": [
      "Bassignac corn maze"
    ],
    "fr": [
      "Labyrinthe maïs de Bassignac"
    ]
  },
