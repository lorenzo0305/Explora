  "rdfs:comment": {
    "de": [
      "Die Stadtbibliothek, ein Ort des Empfangs und der Unterhaltung für alle kleinen und großen Leute!\r\nIch kann hier Dokumente konsultieren, lesen und ausleihen: Alben, Romane, Comics, Dokumentarfilme, ...."
    ],
    "en": [
      "The public library, a place of welcome and entertainment for all young and old!\r\nI can consult, read and borrow documents, albums, novels, comic strips, documentaries, ...."
    ],
    "it": [
      "La biblioteca comunale è un luogo di accoglienza e divertimento per tutte le età!\r\nPosso consultare, leggere e prendere in prestito documenti, album, romanzi, fumetti, documentari, ecc."
    ],
    "fr": [
      "La bibliothèque municipale, un lieu d’accueil, d’animation pour tous petits et grands !\r\nJe peux consulter, lire et emprunter des documents, albums, romans, bandes dessinées, documentaires, …."
    ],
    "es": [
      "La biblioteca municipal es un lugar de acogida y entretenimiento para todas las edades\r\nPuedo consultar, leer y tomar prestados documentos, álbumes, novelas, cómics, documentales, etc."
    ],
    "nl": [
      "De gemeentelijke bibliotheek is een plaats van welkom en vermaak voor alle leeftijden!\r\nIk kan documenten, albums, romans, strips, documentaires, .... raadplegen, lezen en lenen."
    ]
  },
