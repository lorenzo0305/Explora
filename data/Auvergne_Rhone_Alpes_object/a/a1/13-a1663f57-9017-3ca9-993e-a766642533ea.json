  "rdfs:comment": {
    "de": [
      "Die Gemeinde stellt Vereinen oder Einzelpersonen den Gemeindesaal zur Verfügung, um kulturelle Freizeitaktivitäten, Familienfeiern, Versammlungen oder Bankette abzuhalten."
    ],
    "en": [
      "The commune makes the village hall available to associations and private individuals for cultural and leisure activities, family receptions, meetings and banquets."
    ],
    "it": [
      "Il Comune mette la sala del villaggio a disposizione di associazioni o privati per attività culturali e ricreative, ricevimenti familiari, riunioni o banchetti."
    ],
    "fr": [
      "La commune met à disposition des associations ou des particuliers la salle des fêtes communale pour pratiquer des activités culturelles de loisirs, des réceptions familiales, des réunions ou des banquets."
    ],
    "es": [
      "El municipio pone la sala de fiestas a disposición de asociaciones o particulares para actividades culturales y de ocio, recepciones familiares, reuniones o banquetes."
    ],
    "nl": [
      "De gemeente stelt het dorpshuis ter beschikking van verenigingen en particulieren voor culturele en vrijetijdsactiviteiten, familierecepties, vergaderingen en banketten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Salle municipale Adèle Clément - Salle des fêtes"
    ]
  },
