  "rdfs:comment": {
    "de": [
      "Rundstrecke zwischen Plagne und Montchavin-les Coches, die durch einen charakteristischen Bergwald mit dem Mont Blanc im Hintergrund führt. Eine schöne Tour mit dem Mountainbike mit elektrischer Unterstützung, die für die ganze Familie geeignet ist."
    ],
    "en": [
      "A looped route between Plagne and Montchavin-les Coches through a characteristic mountain forest with Mont Blanc in the background. A great electrically-assisted mountain bike ride for the whole family."
    ],
    "it": [
      "Un percorso ad anello tra Plagne e Montchavin-les Coches attraverso una caratteristica foresta di montagna con il Monte Bianco sullo sfondo. Un'ottima escursione in mountain bike a pedalata assistita, adatta a tutta la famiglia."
    ],
    "fr": [
      "Itinéraire en boucle entre Plagne et Montchavin-les Coches traversant une forêt de montagne caractéristique avec le Mont Blanc en toile de fond. Une belle balade en VTT à assistance électrique adaptée à toute la famille."
    ],
    "es": [
      "Una ruta en bucle entre Plagne y Montchavin-les Coches a través de un característico bosque de montaña con el Mont Blanc de fondo. Un estupendo paseo en bicicleta de montaña con asistencia eléctrica apto para toda la familia."
    ],
    "nl": [
      "Een lusvormige route tussen Plagne en Montchavin-les Coches door een karakteristiek bergbos met de Mont Blanc op de achtergrond. Een geweldige elektrisch ondersteunde mountainbiketocht geschikt voor het hele gezin."
    ]
  },
  "rdfs:label": {
    "de": [
      "Mountainbike-Route E : Les Frasses"
    ],
    "en": [
      "Electric Mountain Biking Tour: Les Frasses"
    ],
    "fr": [
      "Circuit VTT-E : Les Frasses"
    ],
    "nl": [
      "Circuit VTT-E : (Mountainbike met elektrische ondersteuning) : Les Frasses"
    ]
  },
