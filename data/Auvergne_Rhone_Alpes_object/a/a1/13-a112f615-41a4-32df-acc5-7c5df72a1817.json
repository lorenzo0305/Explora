  "rdfs:comment": {
    "de": [
      "Fußreflexzonenmassage, Handreflexzonenmassage, Schädel- und Gesichtsreflexzonenmassage. Bauchmassage: Lymphdrainage. HNO-Behandlung mit Hopi-Kerze. Übernachtungsmöglichkeit in der Blase von April bis Oktober."
    ],
    "en": [
      "Foot, palm and craniofacial reflexology. Belly massage: lymphatic drainage. ENT Hopi candle treatment. Accommodation in the bubble available from April to October."
    ],
    "it": [
      "Riflessologia plantare, palmare e craniofacciale. Massaggio del ventre: linfodrenaggio. Trattamento ENT con candele Hopi. Sistemazione nella bolla disponibile da aprile a ottobre."
    ],
    "fr": [
      "Réflexologie plantaire, palmaire, crânio-faciale. Massage du ventre : drainage lymphatique. Soin ORL bougie Hopi. Possibilité d'hébergement dans la bulle d'avril à octobre."
    ],
    "nl": [
      "Voet-, handpalm- en craniofaciale reflexologie. Buikmassage: lymfedrainage. Behandeling met Hopi-kaarsen. Accommodatie in de bubbel beschikbaar van april tot oktober."
    ],
    "es": [
      "Reflexología podal, palmar y craneofacial. Masaje de vientre: drenaje linfático. Tratamiento con velas hopi. Alojamiento en la burbuja disponible de abril a octubre."
    ]
  },
