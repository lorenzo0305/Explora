  "rdfs:comment": {
    "de": [
      "Dieser Rundweg ist 67 km lang und bietet die Möglichkeit, in einer friedlichen und bukolischen Atmosphäre ein um 7 Schlösser herum gebautes Kulturerbe zu entdecken.\r\nDie Strecke ist für Radfahrer (Mountainbike/VTC) und Wanderer geeignet."
    ],
    "en": [
      "This circuit forms a loop of 67 kilometers allowing to discover in a peaceful and bucolic atmosphere a heritage built around 7 castles."
    ],
    "it": [
      "Questo circuito forma un anello di 67 chilometri che permette di scoprire un patrimonio costruito intorno a 7 castelli in un'atmosfera tranquilla e bucolica.\r\nQuesto circuito è accessibile sia ai ciclisti (mountain bike) che agli escursionisti."
    ],
    "fr": [
      "Ce circuit forme une boucle de 67 kilomètres permettant de découvrir dans une ambiance paisible et bucolique un patrimoine bâti autour de 7 châteaux.\r\nCe circuit est accessible aux cyclistes (VTT/VTC) ainsi qu'aux randonneurs pédestres."
    ],
    "es": [
      "Este circuito forma un bucle de 67 kilómetros que permite descubrir un patrimonio construido en torno a 7 castillos en un ambiente tranquilo y bucólico.\r\nEste circuito es accesible tanto para los ciclistas (bicicletas de montaña) como para los excursionistas."
    ],
    "nl": [
      "Dit circuit vormt een lus van 67 kilometer waarmee u in een rustige en bucolische sfeer een erfgoed ontdekt dat is opgebouwd rond 7 kastelen.\r\nDit circuit is toegankelijk voor zowel fietsers (mountainbikes) als wandelaars."
    ]
  },
  "rdfs:label": {
    "en": [
      "Walk of the seven castles"
    ],
    "fr": [
      "Balade des sept châteaux"
    ]
  },
