  "rdfs:comment": {
    "de": [
      "Romanische Kirche aus dem 9. Jahrhundert, die vom 12. Jahrhundert bis zur Revolution den Antoniterorden beherbergte. Kuppel über Trompen, Statue des Heiligen Antonius, gallo-römische Basreliefs."
    ],
    "en": [
      "A 9th century Romanesque church housing the Order of St. Anthony from the 12th century until the French Revolution. Dome with squinches, statue of St Anthony, Gallo-Roman bas-relief statues."
    ],
    "it": [
      "Chiesa romanica del IX secolo, sede dell'ordine antonino dal XII secolo fino alla Rivoluzione. Cupola su trombe, statua di Sant'Antonio, bassorilievi gallo-romani."
    ],
    "fr": [
      "Eglise romane du IXe siècle ayant abrité l'ordre des Antonins du XIIe siècle à la Révolution. Coupole sur Trompes, statue de Saint-Antoine, bas-reliefs gallo-romains."
    ],
    "nl": [
      "Romaanse kerk uit de 9e eeuw, thuisbasis van de Antonijnse orde van de 12e eeuw tot de Revolutie. Koepel op trompetten, beeld van Sint Antonius, Gallo-Romeinse bas-reliëfs."
    ],
    "es": [
      "Iglesia románica del siglo IX, sede de la orden de los Antoninos desde el siglo XII hasta la Revolución. Cúpula sobre trompetas, estatua de San Antonio, bajorrelieves galo-romanos."
    ]
  },
  "rdfs:label": {
    "fr": [
