  "rdfs:comment": {
    "de": [
      "Veranstaltungen, Begegnungen und Ausstellungen rund um die Symbolfigur der Marquise de Sévigné, die in der Kapelle der Cordeliers stattfinden, die während der Europäischen Tage des Denkmals 2026 ausnahmsweise für die Öffentlichkeit zugänglich ist."
    ],
    "en": [
      "Activities, meetings and exhibitions around the emblematic figure of the Marquise de Sévigné will take place at the Chapelle des Cordeliers, which will be exceptionally open to the public during the 2026 European Heritage Days."
    ],
    "it": [
      "Eventi, incontri e mostre incentrati sulla figura emblematica della Marchesa di Sévigné avranno luogo nella cappella dei Cordeliers, che sarà aperta al pubblico per le Giornate Europee del Patrimonio 2026."
    ],
    "fr": [
      "Animations, rencontres, expositions autour de la figure emblématique de la marquise de Sévigné se déroulant à la chapelle des Cordeliers ouverte exceptionnellement au public lors des Journées européennes du patrimoine 2026."
    ],
    "nl": [
      "Evenementen, bijeenkomsten en tentoonstellingen over de emblematische figuur van de Markiezin van Sévigné zullen plaatsvinden in de Cordeliers-kapel, die tijdens de Europese Erfgoeddagen van 2026 open zal zijn voor het publiek."
    ],
    "es": [
      "Actos, encuentros y exposiciones en torno a la figura emblemática de la marquesa de Sévigné tendrán lugar en la capilla de los Cordeliers, que estará abierta al público durante las Jornadas Europeas del Patrimonio 2026."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Exposition : Service Patrimoine, développement culturel et mémoire - Journées européennes du Patrimoine"
    ]
  },
