  "rdfs:comment": {
    "de": [
      "Jérémy Morne bietet Ihnen biologisches und frisches Gemüse im Direktverkauf an, wobei er den Rhythmus der Jahreszeiten und die Umwelt respektiert. 5 Min. von Romans entfernt, auf dem Gelände des \"Grüngürtels Drôme\"."
    ],
    "en": [
      "From May 2024, Jérémy Morne will be offering baskets of organic vegetables for pick-up at local markets and direct sales."
    ],
    "it": [
      "Jérémy Morne offre verdure fresche biologiche per la vendita diretta, rispettando il ritmo delle stagioni e l'ambiente. A 5 minuti da Romans, nel sito della \"cintura verde della Drôme\""
    ],
    "fr": [
      "Jérémy Morne vous propose des légumes bio et frais en vente directe, dans le respect du rythme des saisons et de l'environnement. A 5 min de Romans, sur le site de \"la ceinture verte Drôme\""
    ],
    "nl": [
      "Vanaf mei 2024 zal Jérémy Morne manden met biologische groenten aanbieden voor directe verkoop of om af te halen op lokale markten."
    ],
    "es": [
      "Jérémy Morne ofrece verduras ecológicas frescas para la venta directa, respetando el ritmo de las estaciones y el medio ambiente. A 5 minutos de Romans, en el paraje del \"cinturón verde de la Drôme\""
    ]
  },
