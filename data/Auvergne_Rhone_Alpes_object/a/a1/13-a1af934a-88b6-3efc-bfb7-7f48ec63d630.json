  "rdfs:comment": {
    "de": [
      "Vom Opinel-Platz aus erreichen Sie diesen schmalen Pfad über den Anfang von Tré Cret.\r\nDieser kurze, technische und schmale Pfad durch den Wald wird vor allem Enduro-Mountainbiker begeistern."
    ],
    "en": [
      "Starting from Place Opinel, join this narrow trail at the beginning of Tré Cret.\r\nThis short, technical and narrow trail through the forest will delight enduro mountain bikers."
    ],
    "it": [
      "Partendo da Place Opinel, si raggiunge questo stretto sentiero all'inizio di Tré Cret.\r\nQuesto percorso breve, tecnico e stretto attraverso la foresta farà la gioia degli appassionati di mountain bike enduro."
    ],
    "fr": [
      "Au départ de la place Opinel, rejoignez ce sentier étroit par le début de Tré Cret.\r\nCe court sentier dans la forêt, technique et étroit sera combler les adeptes d'enduro VTT."
    ],
    "es": [
      "Partiendo de la Place Opinel, únase a este estrecho sendero al comienzo de Tré Cret.\r\nEste sendero corto, técnico y estrecho a través del bosque hará las delicias de los ciclistas de montaña de enduro."
    ],
    "nl": [
      "Neem vanaf Place Opinel deze smalle route aan het begin van Tré Cret.\r\nDit korte, technische en smalle pad door het bos zal enduro mountainbikers zeker bevallen."
    ]
  },
