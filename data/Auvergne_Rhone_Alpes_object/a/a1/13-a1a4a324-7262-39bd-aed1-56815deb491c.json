  "rdfs:comment": {
    "de": [
      "Dieses Museum ist in dem schönen und einzigartigen Haus des innovativen Ingenieurs Aristide Bergès (1833-1904) untergebracht. Die Präsentation konzentriert sich auf diese Persönlichkeit, seine technischen Herausforderungen, die Wasserkraft und die Entwicklung seiner Papierfabrik."
    ],
    "en": [
      "La Maison Bergès [the Bergès family home] - Museum of Hydroelectric Power, standing at the foot of the Belledonne Massif, is an exceptional cultural heritage site which transports visitors back in time to the advent of hydroelectric power."
    ],
    "it": [
      "Questo museo è ospitato nella bellissima e unica casa dell'innovativo ingegnere Aristide Bergès (1833-1904). La presentazione si concentra su questo personaggio, sulle sue sfide tecniche, sull'energia idroelettrica e sullo sviluppo della sua cartiera."
    ],
    "fr": [
      "Ce musée est installé dans la belle et singulière maison de l’ingénieur innovateur Aristide Bergès (1833-1904). La présentation est axée sur ce personnage, ses défis techniques, l’hydroélectricité et le développement de son usine de papeterie."
    ],
    "es": [
      "Este museo se encuentra en la hermosa y singular casa del innovador ingeniero Aristide Bergès (1833-1904). La presentación se centra en este personaje, sus retos técnicos, la hidroelectricidad y el desarrollo de su fábrica de papel."
    ],
    "nl": [
      "Dit museum is gevestigd in het prachtige en unieke huis van de innovatieve ingenieur Aristide Bergès (1833-1904). De presentatie richt zich op deze figuur, zijn technische uitdagingen, waterkracht en de ontwikkeling van zijn papierfabriek."
    ]
  },
