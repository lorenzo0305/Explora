  "rdfs:comment": {
    "de": [
      "Im Herzen des Waldes von Marchiennes, in der Nähe von Valenciennes, lädt das Team Sie ein, eine moderne und raffinierte Küche in einer ehemaligen Dachziegelfabrik zu entdecken, die in einen modernen und eleganten Ort umgewandelt wurde."
    ],
    "en": [
      "In the heart of the Marchiennes forest, near Valenciennes, the team invites you to discover modern, refined cuisine, in a former tile factory transformed into a modern, elegant venue."
    ],
    "it": [
      "Nel cuore della foresta di Marchiennes, vicino a Valenciennes, il team vi invita a scoprire una cucina moderna e raffinata in un'ex fabbrica di piastrelle trasformata in un locale moderno ed elegante."
    ],
    "fr": [
      "Au cœur de la forêt de Marchiennes, près de Valenciennes, l'équipe vous invite à découvrir une cuisine moderne et raffinée, au sein d’une ancienne fabrique de tuiles transformée en lieu moderne et élégant."
    ],
    "nl": [
      "In het hart van het bos van Marchiennes, in de buurt van Valenciennes, nodigt het team u uit om de moderne, verfijnde keuken te ontdekken in een voormalige tegelfabriek die is omgetoverd tot een moderne, elegante locatie."
    ],
    "es": [
      "En el corazón del bosque de Marchiennes, cerca de Valenciennes, el equipo le invita a descubrir una cocina moderna y refinada en una antigua fábrica de azulejos transformada en un local moderno y elegante."
    ]
  },
