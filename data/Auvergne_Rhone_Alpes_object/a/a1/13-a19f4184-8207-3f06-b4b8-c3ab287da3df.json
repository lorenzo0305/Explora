  "rdfs:comment": {
    "de": [
      "Dieses Familienunternehmen stellt Ravioles ausschließlich auf handwerkliche Weise mit Qualitätsprodukten her, die zu 100 % garantiert aus Frankreich stammen. Sie werden den authentischen Geschmack der Raviole von früher zu schätzen wissen."
    ],
    "en": [
      "This family-run company makes local recipe ravioli using top quality products in exclusively artisanal preparation. You are sure to enjoy the authentic taste of ravioli from bygone times."
    ],
    "it": [
      "Questa azienda familiare produce raviole esclusivamente in modo tradizionale con prodotti di qualità e di origine francese garantita al 100%. Apprezzerete il gusto autentico delle raviole di una volta."
    ],
    "fr": [
      "Cette société familiale fabrique des ravioles exclusivement de façon artisanale avec des produits de qualité 100% origine France garantie. Vous apprécierez le goût authentique de la raviole d'autrefois."
    ],
    "es": [
      "Esta empresa familiar elabora ravioles exclusivamente de forma tradicional con productos de calidad de origen francés 100% garantizado. Apreciará el auténtico sabor de las ravioles de antaño."
    ],
    "nl": [
      "Dit familiebedrijf fabriceert op ambachtelijke wijze raviole met uitsluitend kwaliteitsproducten. We garanderen dat u zult smullen van de authentieke smaak van de raviole."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Ravioles des Grands Goulets"
    ]
  },
