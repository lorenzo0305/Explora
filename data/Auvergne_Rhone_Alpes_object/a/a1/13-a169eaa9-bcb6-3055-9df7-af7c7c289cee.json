  "rdfs:comment": {
    "de": [
      "Emilie Sartelet, die das Gütesiegel \"Kunsthandwerker\" trägt, führt Ihre Bestellungen aus oder restauriert Ihre Skulpturen nach Ihren Wünschen und Vorstellungen.\r\nSie können ihre Kreationen auch im Atelier entdecken."
    ],
    "en": [
      "Emilie Sartelet, a certified craftswoman, can create or restore your sculptures according to your wishes and desires.\r\nYou can also discover her creations at the workshop."
    ],
    "it": [
      "Emilie Sartelet, artigiana certificata, può realizzare i vostri ordini o restaurare le vostre sculture secondo i vostri desideri e le vostre richieste.\r\nÈ inoltre possibile vedere le sue creazioni nel laboratorio."
    ],
    "fr": [
      "Emilie Sartelet, labellisée artisan d'art,  réalise vos commandes ou restaure vos sculptures selon vos souhaites et envies.\r\nVous pouvez également découvrir ses créations à l'atelier."
    ],
    "nl": [
      "Emilie Sartelet, een gediplomeerd ambachtsvrouw, kan uw bestellingen maken of uw sculpturen restaureren volgens uw wensen en verlangens.\r\nJe kunt haar creaties ook bekijken in het atelier."
    ],
    "es": [
      "Emilie Sartelet, artesana diplomada, puede realizar sus encargos o restaurar sus esculturas según sus deseos y anhelos.\r\nTambién puede ver sus creaciones en el taller."
    ]
  },
  "rdfs:label": {
    "en": [
