  "rdfs:comment": {
    "de": [
      "Sich in die Clownskunst einführen zu lassen, bedeutet, die Türen zu einem unendlichen Universum von Entdeckungen über sich selbst und andere zu durchschreiten."
    ],
    "en": [
      "Introducing yourself to the art of clowning opens the door to an infinite universe of discoveries about yourself and others."
    ],
    "it": [
      "Introdursi all'arte del clown significa aprire le porte a un universo infinito di scoperte su se stessi e sugli altri."
    ],
    "fr": [
      "S'initier à l'art clownesque c'est franchir les portes d'un univers infini de découvertes sur soi et sur les autres."
    ],
    "nl": [
      "Jezelf introduceren in de kunst van het clown spelen betekent de deuren openen naar een oneindig universum van ontdekkingen over jezelf en anderen."
    ],
    "es": [
      "Iniciarse en el arte del clown significa abrir las puertas a un universo infinito de descubrimientos sobre uno mismo y sobre los demás."
    ]
