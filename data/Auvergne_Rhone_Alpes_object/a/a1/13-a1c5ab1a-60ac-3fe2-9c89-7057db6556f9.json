  "rdfs:comment": {
    "de": [
      "Der Mehrzweckbereich des Board Val Thorens ist in der Lage, ein Angebot an Mannschaftssportarten (Volleyball, Basketball, Tischtennis, Badminton) ebenso anzubieten wie Sport-, Musik-, Kultur- und Geschäftsveranstaltungen."
    ],
    "en": [
      "The Board Val Thorens multi-purpose facility is capable of offering a range of team sports (volleyball, basketball, table tennis, badminton) as well as sporting, musical, cultural and professional events."
    ],
    "it": [
      "L'impianto polifunzionale del Board Val Thorens è in grado di offrire una serie di sport di squadra (pallavolo, pallacanestro, ping pong, badminton) nonché eventi sportivi, musicali, culturali e professionali."
    ],
    "fr": [
      "L’espace polyvalent du Board Val Thorens est capable de proposer une offre de sports collectifs (volley, basket, tennis de table, badminton) aussi bien que des événements sportifs, musicaux, culturels et professionnels."
    ],
    "es": [
      "Las instalaciones polivalentes del Board Val Thorens son capaces de ofrecer diversos deportes de equipo (voleibol, baloncesto, tenis de mesa, bádminton), así como eventos deportivos, musicales, culturales y profesionales."
    ],
    "nl": [
      "De multifunctionele faciliteit van Board Val Thorens is geschikt voor verschillende teamsporten (volleybal, basketbal, tafeltennis, badminton) en voor sportieve, muzikale, culturele en professionele evenementen."
    ]
  },
