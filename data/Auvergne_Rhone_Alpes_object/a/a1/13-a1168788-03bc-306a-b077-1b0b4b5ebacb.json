  "rdfs:comment": {
    "de": [
      "Sommersaison vom 21. Juni bis 31. August: Schwimmbad geschlossen. Sie können sich zum Schwimmbad Pierre Rajon begeben, das vom 21. Juni bis 31. August 2025 geöffnet ist.\r\nEine hochwertige Sporteinrichtung, die 8 Schwimmbahnen bietet."
    ],
    "en": [
      "Summer season from June 21 to August 31: swimming pool closed, you can visit the Pierre Rajon swimming pool open from June 21 to August 31, 2025.\r\nA high-quality sports facility with 8 swimming lanes."
    ],
    "it": [
      "Stagione estiva dal 21 giugno al 31 agosto: piscina chiusa, è possibile visitare la piscina Pierre Rajon aperta dal 21 giugno al 31 agosto 2025.\r\nQuesto impianto sportivo di alta qualità dispone di 8 corsie di nuoto."
    ],
    "fr": [
      "Saison estivale du 21 juin au 31 août : piscine fermée, vous pourrez vous rendre à la piscine Pierre Rajon ouverte du 21 juin au 31 août 2025.\r\nUn équipement sportif de haute qualité qui propose 8 couloirs de nage."
    ],
    "nl": [
      "Zomerseizoen van 21 juni tot 31 augustus: zwembad gesloten, je kunt het Pierre Rajon zwembad bezoeken dat geopend is van 21 juni tot 31 augustus 2025.\r\nDeze hoogwaardige sportfaciliteit heeft 8 zwembanen."
    ],
    "es": [
      "Temporada de verano del 21 de junio al 31 de agosto: piscina cerrada, puede visitar la piscina Pierre Rajon abierta del 21 de junio al 31 de agosto de 2025.\r\nUna instalación deportiva de gran calidad con 8 calles de natación."
    ]
  },
