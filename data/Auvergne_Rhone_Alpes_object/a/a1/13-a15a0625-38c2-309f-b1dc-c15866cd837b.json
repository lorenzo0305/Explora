  "rdfs:comment": {
    "de": [
      "Gönnen Sie sich einen zeitlosen Moment in einer Sauna aus Holz, die sich an den See schmiegt und von viel Grün umgeben ist.  Ob allein, zu zweit oder mit Freunden, erleben Sie eine einzigartige Sinneserfahrung in perfekter Harmonie mit der Natur."
    ],
    "en": [
      "Treat yourself to a timeless moment in a wooden sauna nestled on the edge of the lake, surrounded by greenery.  Alone, as a couple or with friends, come and enjoy a unique sensory experience, in perfect harmony with nature."
    ],
    "it": [
      "Concedetevi un momento senza tempo in una sauna in legno situata sul bordo del lago, circondata dal verde.  Da soli, in coppia o con gli amici, venite a vivere un'esperienza sensoriale unica, in perfetta armonia con la natura."
    ],
    "fr": [
      "Offrez-vous un moment hors du temps dans un sauna en bois, niché au bord du lac, entouré de verdure.  Seul, en couple ou entre amis, venez vivre une expérience sensorielle unique, en harmonie parfaite avec la nature."
    ],
    "nl": [
      "Trakteer jezelf op een tijdloos moment in een houten sauna aan de rand van het meer, omgeven door groen.  Kom alleen, met z'n tweeën of met vrienden genieten van een unieke zintuiglijke ervaring, in perfecte harmonie met de natuur."
    ],
    "es": [
      "Regálese un momento intemporal en una sauna de madera situada a orillas del lago, rodeada de vegetación.  Solo, en pareja o con amigos, venga a disfrutar de una experiencia sensorial única, en perfecta armonía con la naturaleza."
    ]
  },
