  "rdfs:comment": {
    "de": [
      "Quiz Room Valence ist der ideale Ort, um sich wie in einem TV-Set herauszufordern und einen unvergesslichen Moment mit Freunden, Mitarbeitern oder der Familie zu verbringen!"
    ],
    "en": [
      "Quiz Room Valence is the ideal place to challenge each other as if on a TV set, and have a memorable time with friends, colleagues or family!"
    ],
    "it": [
      "La Quiz Room Valence è il luogo ideale per sfidarsi come su un televisore e trascorrere un momento memorabile con amici, colleghi o familiari!"
    ],
    "fr": [
      "Quiz Room Valence, c’est l’endroit idéal pour se défier comme sur un plateau TV et passer un moment mémorable entre amis, collaborateurs ou familles !"
    ],
    "nl": [
      "Quiz Room Valence is de ideale plek om elkaar uit te dagen als op een tv-toestel, en een onvergetelijke tijd te hebben met vrienden, collega's of familie!"
    ],
    "es": [
      "Quiz Room Valence es el lugar ideal para retarse como en un plató de televisión y pasar un rato inolvidable con amigos, colegas o familiares"
    ]
  },
