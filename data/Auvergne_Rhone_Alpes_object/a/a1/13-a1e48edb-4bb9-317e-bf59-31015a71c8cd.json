    "de": [
      "Ein einziges Ziel: möglichst vielen Menschen das Lesen schmackhaft zu machen! Willkommen in der Bibliothek von Yenne!"
    ],
    "en": [
      "A single goal: to bring the joy of reading to as many people as possible! Welcome to the Yenne library!"
    ],
