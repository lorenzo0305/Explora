  "rdfs:comment": {
    "de": [
      "Die Micro-Folie ist eine kulturpolitische Einrichtung, die vom französischen Kulturministerium getragen und von La Villette koordiniert wird. Der Micro-Folie Pays de Cruseilles verfügt über ein digitales Museum, einen Raum für Virtuelle Realität (2 VR-Helme) und ein FabLab."
    ],
    "en": [
      "La Micro-Folie is a cultural policy initiative supported by the French Ministry of Culture and coordinated by La Villette. La Micro-Folie Pays de Cruseilles features a Digital Museum, a Virtual Reality area (2 VR headsets), and a FabLab."
    ],
    "it": [
      "Micro-Folie è un'iniziativa di politica culturale sostenuta dal Ministero della Cultura francese e coordinata da La Villette. La Micro-Folie del Pays de Cruseilles dispone di un Museo digitale, di un'area di realtà virtuale (2 cuffie VR) e di un FabLab."
    ],
    "fr": [
      "La Micro-Folie est un dispositif de politique culturelle porté par le Ministère de la Culture et coordonné par La Villette. La Micro-Folie Pays de Cruseilles dispose d'un Musée numérique, d'un espace de Réalité Virtuelle (2 casques VR), et d'un FabLab."
    ],
    "nl": [
      "Micro-Folie is een cultuurbeleidsinitiatief dat wordt ondersteund door het Franse ministerie van Cultuur en wordt gecoördineerd door La Villette. De Micro-Folie Pays de Cruseilles heeft een Digitaal Museum, een Virtual Reality ruimte (2 VR headsets) en een FabLab."
    ],
    "es": [
      "Micro-Folie es una iniciativa de política cultural apoyada por el Ministerio de Cultura francés y coordinada por La Villette. La Micro-Folie Pays de Cruseilles cuenta con un Museo Digital, un espacio de Realidad Virtual (2 cascos de RV) y un FabLab."
    ]
  },
  "rdfs:label": {
