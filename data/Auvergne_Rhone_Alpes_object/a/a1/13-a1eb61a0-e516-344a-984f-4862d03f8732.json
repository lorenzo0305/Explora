  "rdfs:comment": {
    "de": [
      "Im Jahr 1440 kämpfte der französische König Karl VII. im mittelalterlichen Dorf Saint-Haon-le-Châtel gegen seinen Sohn, den Dauphin Ludwig XI. Das Dorf wird bombardiert und die Soldaten des Königs fallen in die Stadt ein."
    ],
    "en": [
      "In 1440, in the medieval village of Saint-Haon-le-Châtel, Charles VII, King of France, confronts his son, the Dauphin Louis XI. The village was bombarded and the king's soldiers invaded the town."
    ],
    "it": [
      "Nel 1440, nel villaggio medievale di Saint-Haon-le-Châtel, Carlo VII, re di Francia, affrontò suo figlio, il Delfino Luigi XI. Il villaggio fu bombardato e i soldati del re invasero la città."
    ],
    "fr": [
      "En 1440, dans le village médiéval de Saint-Haon-le-Châtel, Charles VII, le roi de France, affronte son fils le dauphin Louis XI. Le village est bombardé et les soldats du roi envahissent la cité."
    ],
    "nl": [
      "In 1440 kwam Karel VII, koning van Frankrijk, in het middeleeuwse dorp Saint-Haon-le-Châtel tegenover zijn zoon, de kroonprins Lodewijk XI te staan. Het dorp werd gebombardeerd en de soldaten van de koning vielen de stad binnen."
    ],
    "es": [
      "En 1440, en el pueblo medieval de Saint-Haon-le-Châtel, Carlos VII, rey de Francia, se enfrenta a su hijo, el delfín Luis XI. El pueblo fue bombardeado y los soldados del rey invadieron la ciudad."
    ]
  },
  "rdfs:label": {
