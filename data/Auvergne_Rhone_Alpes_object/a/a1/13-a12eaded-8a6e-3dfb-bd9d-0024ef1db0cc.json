  "rdfs:comment": {
    "de": [
      "Ein Bio-Wein, verarbeitet um die Region und Traubensorten im reinsten Ausdruck von Früchten und Gewürzen wiederzugeben. Ausgewogene und elegante Weine. Boutique mit regionalen Produkten."
    ],
    "en": [
      "An expression of the land and grape varieties with a hint of fruits and spices. \r\nBalanced and elegant wines. Vineyard shop with regional products."
    ],
    "it": [
      "Philippe, viticoltore indipendente e artigiano, vi apre le porte della sua tenuta di famiglia."
    ],
    "fr": [
      "Philippe, vigneron indépendant et artisan œnologue, vous ouvre les portes de son domaine familial."
    ],
    "es": [
      "Philippe, viticultor independiente y artesano, le abre las puertas de su finca familiar."
    ],
