  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Kanu- oder Kajakfahren bei einer Tour oder einer Abfahrt auf der Ardèche. Für Abenteuerlustige ist Stand-Up-Paddle auf dem See von Sauze ein ungewöhnliches Erlebnis."
    ],
    "en": [
      "Come and discover canoeing or kayaking on the Ardèche river, either on a leisurely trip or a whitewater descent. For the more adventurous, stand-up paddleboarding offers a unique experience on the Sauze lake."
    ],
    "it": [
      "Venite a scoprire la canoa o il kayak durante una gita nell'Ardèche. Per i più avventurosi, lo Stand-Up Paddle sarà un'esperienza insolita sul lago di Sauze."
    ],
    "fr": [
      "Venez découvrir le canoë ou le kayak en balade ou en descente de l'Ardèche. Pour les aventuriers, le Stand-Up Paddle sera une expérience insolite sur le plan d'eau de Sauze."
    ],
    "es": [
      "Venga a descubrir el piragüismo o el kayak en una excursión por el Ardèche. Para los aventureros, el Stand-Up Paddle será una experiencia insólita en el lago de la Sauze."
    ],
    "nl": [
      "Kom kanoën of kajakken op de Ardèche. Voor avonturiers is stand-up paddle een bijzondere ervaring op het meer van Sauze."
    ]
  },
