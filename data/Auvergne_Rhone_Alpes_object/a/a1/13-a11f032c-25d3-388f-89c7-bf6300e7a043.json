  "rdfs:comment": {
    "de": [
      "Der Fußgängerweg folgt der Trasse der alten Eisenbahnstrecke, die Néris-les-Bains mit Montluçon verbindet. Er führt über drei Viadukte und bietet schöne Panoramablicke auf die Landschaft des Bourbonnaise. Zu Fuß oder mit dem Fahrrad."
    ],
    "en": [
      "The pedestrian path follows the route of the old railroad line linking Néris-les-Bains to Montluçon. Passing over 3 viaducts, it offers lovely panoramic views of the Bourbonnais countryside. On foot or by bike."
    ],
    "it": [
      "Il sentiero segue il percorso della vecchia linea ferroviaria tra Néris-les-Bains e Montluçon. Superando 3 viadotti, offre una bella vista sulla campagna del Bourbonnais. A piedi o in bicicletta."
    ],
    "fr": [
      "La voie piétonne emprunte le tracé de l'ancienne voie de chemin de fer reliant Néris-les-Bains à Montluçon. Passant sur 3 viaducs, elle offre de jolis panoramas sur la campagne bourbonnaise. A pied ou à vélo."
    ],
    "nl": [
      "Het wandelpad volgt de route van de oude spoorlijn tussen Néris-les-Bains en Montluçon. Het loopt over 3 viaducten en biedt prachtige uitzichten over het platteland van de Bourbonnais. Te voet of met de fiets."
    ],
    "es": [
      "El sendero sigue el trazado de la antigua línea de ferrocarril entre Néris-les-Bains y Montluçon. Atraviesa 3 viaductos y ofrece hermosas vistas de la campiña del Bourbonnais. A pie o en bicicleta."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Voie piétonne Néris-Montluçon"
    ]
  },
