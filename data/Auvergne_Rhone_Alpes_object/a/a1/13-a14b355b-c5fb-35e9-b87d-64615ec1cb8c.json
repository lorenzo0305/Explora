  "rdfs:comment": {
    "de": [
      "Ein einzigartiges, dem Pétanque gewidmetes Konzept, das aus der Zusammenlegung mehrerer Bereiche am Produktionsstandort der legendären OBUT-Kugeln entstanden ist: Pétanque-Bahnen, Restaurant, 3 Seminarräume und Boutique."
    ],
    "en": [
      "A unique concept dedicated to pétanque, born from the combination of several spaces on the production site of the iconic OBUT boules: pétanque courts, a restaurant, three seminar rooms, and a shop."
    ],
    "it": [
      "Un concetto unico dedicato alla pétanque, creato combinando diverse aree sul sito di produzione delle leggendarie bocce OBUT: campi da pétanque, ristorante, 3 sale per seminari e negozio."
    ],
    "fr": [
      "Un concept unique dédié à la pétanque né d'un regroupement de plusieurs espaces sur le site de production des mythiques boules OBUT : pistes de pétanque, restaurant, 3 salles de séminaires et boutique."
    ],
    "es": [
      "Un concepto único dedicado a la petanca, creado combinando varios espacios en el lugar de producción de las legendarias bolas OBUT: pistas de petanca, restaurante, 3 salas de seminarios y tienda."
    ],
    "nl": [
      "Een uniek concept gewijd aan jeu de boules, gecreëerd door het combineren van verschillende ruimtes op de productielocatie van de legendarische OBUT-boules: jeu de boulesbanen, restaurant, 3 seminarzalen en winkel."
    ]
  },
