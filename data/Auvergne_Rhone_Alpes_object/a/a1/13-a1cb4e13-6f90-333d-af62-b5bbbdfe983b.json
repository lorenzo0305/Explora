  "rdfs:comment": {
    "de": [
      "Das Restaurant La Ferme de la Choumette liegt über dem Dorf Saint Martin und empfängt Sie mittags und abends. Es verfügt über einen großen Saal mit Blick auf den Stall und eine Sonnenterrasse mit Blick auf die Piste."
    ],
    "en": [
      "The restaurant « La Ferme de la Choumette » is directly on the slope and is open every lunchtime and evening.  It has a large dining room with a glass wall enabling you to see into the stable and a sunny terrace with views overlooking the piste."
    ],
    "it": [
      "Affacciato sul villaggio di Saint Martin, il ristorante La Ferme de la Choumette vi accoglie per pranzo e cena. Dispone di un'ampia sala da pranzo con vista sulla stalla e di una terrazza soleggiata con vista sulla pista."
    ],
    "fr": [
      "Dominant le village de Saint Martin,  le restaurant La Ferme de la Choumette vous accueille midi et soir. Il dispose d'une vaste salle avec vue sur l'étable et d'une terrasse ensoleillée donnant sur la piste."
    ],
    "nl": [
      "Het restaurant La Ferme de la Choumette kijkt uit over het dorp Saint Martin en verwelkomt je voor lunch en diner. Het heeft een grote eetzaal met uitzicht op de koeienstal en een zonnig terras met uitzicht op de piste."
    ],
    "es": [
      "Con vistas al pueblo de Saint Martin, el restaurante La Ferme de la Choumette le da la bienvenida para almorzar y cenar. Dispone de un amplio comedor con vistas al establo y de una soleada terraza con vistas a la pista."
    ]
  },
