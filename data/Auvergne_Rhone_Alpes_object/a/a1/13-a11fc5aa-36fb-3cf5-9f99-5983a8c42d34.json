  "rdfs:comment": {
    "de": [
      "Ein Wochenende lang können Sie beim Yogafestival in La Clusaz Yoga entdecken oder Ihre Kenntnisse über diese wohltuende Praxis vertiefen."
    ],
    "en": [
      "During a weekend, come discover yoga or deepen your knowledge of this beneficial practice during the 1st La Clusaz Satiam Yoga Festival."
    ],
    "it": [
      "Per un fine settimana, venite a scoprire lo yoga o ad approfondire la vostra conoscenza di questa pratica benefica allo Yoga Festival di La Clusaz."
    ],
    "fr": [
      "Le temps d'un week-end, venez découvrir le yoga ou approfondir votre connaissance de cette pratique bénéfique à l’occasion du Festival de Yoga de la Clusaz."
    ],
    "nl": [
      "Kom een weekend lang yoga ontdekken of leer meer over deze heilzame beoefening tijdens het La Clusaz Yoga Festival."
    ],
    "es": [
      "Durante un fin de semana, venga a descubrir el yoga o a profundizar sus conocimientos sobre esta beneficiosa práctica en el Festival de Yoga de La Clusaz."
    ]
  },
