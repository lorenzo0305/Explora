  "rdfs:comment": {
    "de": [
      "Machen Sie den großen Sprung am Fuße des Mont Blanc über der Bonnant-Schlucht. Entdecken Sie diesen einzigartigen, völlig wettergeschützten Ort und springen Sie für 65 Meter freien Fall ins Leere. Garantierte Sicherheit und 100% Adrenalin!"
    ],
    "en": [
      "Take the plunge at the foot of Mont Blanc above the Bonnant Gorges. Discover this unique site, completely protected from the elements, and leap into the void for a 65-metre free fall. Safety guaranteed and 100% adrenaline!"
    ],
    "it": [
      "Fate il grande salto ai piedi del Monte Bianco sopra le gole del Bonnant. Scoprite questo sito unico, completamente protetto dalle intemperie, e lanciatevi nel vuoto per 65 metri di caduta libera. Sicurezza garantita e adrenalina al 100%!"
    ],
    "fr": [
      "Faites le grand saut au pied du Mont Blanc au-dessus des gorges du Bonnant. Découvrez ce site unique, entièrement protégé des intempéries, et sautez dans le vide pour 65 mètres de chute libre. Sécurité garantie et 100% adrénaline !"
    ],
    "es": [
      "Láncese al vacío al pie del Mont Blanc, sobre las gargantas de Bonnant. Descubra este lugar único, totalmente protegido de la intemperie, y láncese al vacío en una caída libre de 65 metros. Seguridad garantizada y adrenalina al 100%"
    ],
    "nl": [
      "Duik aan de voet van de Mont Blanc boven de Gorges de Bonnant. Ontdek deze unieke plek, volledig beschermd tegen de elementen, en spring in het luchtledige voor een vrije val van 65 meter. Veiligheid gegarandeerd en 100% adrenaline!"
    ]
  },
  "rdfs:label": {
    "en": [
      "Bungee jumping - Elastik Jump Mont-Blanc"
    ],
