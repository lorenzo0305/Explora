  "rdfs:comment": {
    "de": [
      "Cédric und sein Team heißen Sie herzlich willkommen und bieten Ihnen die Spitzenprodukte des Hauses Perret an. Ein Snackangebot, das durch einen Vorschlag für vor Ort zubereitete Gerichte ergänzt wird."
    ],
    "en": [
      "Cédric and his team will be delighted to welcome you and offer you Maison Perret's flagship products. A snack offer complemented by a range of dishes cooked on the premises."
    ],
    "it": [
      "Cédric e il suo team saranno lieti di accogliervi e di offrirvi i prodotti di punta della Maison Perret. L'offerta di snack è completata da una serie di piatti cucinati in loco."
    ],
    "fr": [
      "Cédric et son équipe vous accueillent avec plaisir et vous proposent les produits  phares de la Maison Perret. Une offre snacking  complétée par une proposition de plats cuisinés sur place."
    ],
    "es": [
      "Cédric y su equipo estarán encantados de recibirle y ofrecerle los productos estrella de la Maison Perret. La oferta de aperitivos se complementa con una gama de platos cocinados en el propio local."
    ],
    "nl": [
      "Cédric en zijn team heten je van harte welkom en bieden je de paradepaardjes van Maison Perret. Het snackaanbod wordt aangevuld met een reeks ter plaatse bereide gerechten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Snack la Maison Perret"
    ]
  },
