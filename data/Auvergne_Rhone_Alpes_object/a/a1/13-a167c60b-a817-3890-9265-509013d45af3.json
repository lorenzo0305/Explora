  "rdfs:comment": {
    "de": [
      "Dieses Restaurant, das nur 100 Meter vom Strand entfernt liegt und einen Blick auf den See bietet, bietet eine große Auswahl an Menüs: Pizza vor Ort oder zum Mitnehmen, Fisch aus dem See, Fleisch ... Terrasse bei schönem Wetter."
    ],
    "en": [
      "This restaurant, located 100 meters from the beach and offering a view of the lake, offers a wide choice of menus: on-site or take-away pizzas, fish from the lake, meats ... Terrace in fine weather."
    ],
    "it": [
      "Questo ristorante, situato a 100 metri dalla spiaggia e con vista sul lago, offre un'ampia scelta di menu: pizze sul posto o da asporto, pesce di lago, carni... Terrazza nella bella stagione."
    ],
    "fr": [
      "Ce restaurant, situé à 100 mètres de la plage et offrant une vue sur le Lac, vous propose un large choix de menus : Pizzas sur place ou à emporter, poissons du lac, viandes ...Terrasse aux beaux jours."
    ],
    "es": [
      "Este restaurante, situado a 100 metros de la playa y con vistas al lago, ofrece una amplia selección de menús: pizzas al momento o para llevar, pescado del lago, carnes... Terraza con buen tiempo."
    ],
    "nl": [
      "Dit restaurant, gelegen op 100 meter van het strand en met uitzicht op het meer, biedt een ruime keuze aan menu's: pizza's ter plaatse of om mee te nemen, vis uit het meer, vleeswaren... Terras bij mooi weer."
    ]
  },
