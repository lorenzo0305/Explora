  "rdfs:comment": {
    "de": [
      "Privates Spa in Valencia: Whirlpool, Infrarotsauna, Kuppelsauna, Terrasse und Ruheraum. Massagen, Peelings und Behandlungen stehen zur Auswahl. Die Atmosphäre variiert von festlich bis Zen, mit Musik und Unterhaltung. Ein warmes und modernes Ambiente für unvergessliche Erinnerungen."
    ],
    "en": [
      "Private spa in Valencia: jacuzzi, infrared sauna, dome sauna, terrace, and relaxation lounge. Massages, scrubs, and treatments are available. The atmosphere can be varied, from festive to zen, with music and entertainment. A warm and modern setting for unforgettable memories."
    ],
    "it": [
      "\"La tua oasi di benessere, offre spazi privati con jacuzzi e hammam, oltre a vari servizi come massaggi, coaching alimentare e coworking siamo ambasciatori di uno stile di vita sano e attivo.\""
    ],
    "fr": [
      "Centre bien-être avec Spa privatif à Valence : jacuzzi, sauna infrarouge, bain froid,, terrasse et éspace  détente. Massages, gommages et soins à la carte. Moment détente ou festif, avec votre musique. Une bulle bien-être pour des souvenirs mémorables."
    ],
    "nl": [
      "Privéspa in Valencia: jacuzzi, infraroodsauna, koepelsauna, terras en ontspanningsruimte. Massages, scrubs en behandelingen zijn beschikbaar. De sfeer kan variëren van feestelijk tot zen, met muziek en entertainment. Een warme en moderne setting voor onvergetelijke herinneringen."
    ],
    "es": [
      "Centro de bienestar con spa privado en Valence: jacuzzi, sauna de infrarrojos, baño frío, terraza y zona de relajación. Masajes, exfoliantes y tratamientos a la carta. Relájese o celébrelo con su propia música. Una burbuja de bienestar para recuerdos inolvidables."
    ]
  },
