  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/4d37cd53-495d-30f2-ba31-96bdbbba4bdd",
      "dc:description": {
        "de": [
          "Diese Maschinen erzeugen durch die Tätigkeit experimentierfreudiger Maschinisten Flammen, die die Zuschauer auf magische Weise erleuchten."
        ],
        "en": [
          "These machines produce flames through the action of experimental machinists who magically illuminate the spectators."
        ],
        "it": [
          "Queste macchine producono fiamme grazie all'azione di macchinisti sperimentali che illuminano magicamente gli spettatori."
        ],
        "fr": [
          "Machines déglinguées, véhicules mécanisés fabriqués à base de récupération métal (vélo, soufflerie manuelle, roues ... ) Ces machines produisent des flammes par l'action de machinistes expérimentateurs qui illuminent avec magie les spectateurs."
        ],
        "es": [
          "Estas máquinas producen llamas mediante la acción de maquinistas experimentales que iluminan mágicamente a los espectadores."
        ],
        "nl": [
          "Deze machines produceren vlammen door toedoen van experimentele machinisten die de toeschouwers op magische wijze verlichten."
        ]
      },
