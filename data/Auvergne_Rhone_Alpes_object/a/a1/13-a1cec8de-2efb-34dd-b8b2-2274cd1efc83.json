  "rdfs:comment": {
    "de": [
      "Entdecken Sie diesen wunderschönen Ort auf spielerische Weise und nutzen Sie die vier Orientierungswege, die im Arboretum angelegt wurden, oder die, die im Wald rund um das Arboretum angelegt wurden."
    ],
    "en": [
      "Come and discover this magnificent site in a playful way, taking advantage of the 4 orienteering trails created in the arboretum, or those created in the surrounding forest."
    ],
    "it": [
      "Venite a scoprire questo magnifico sito in modo divertente approfittando dei 4 percorsi di orienteering creati nell'arboreto, o di quelli creati nella foresta circostante."
    ],
    "fr": [
      "Venez découvrir ce site magnifique d'une manière ludique en profitant des 4 parcours d'orientation crées dans l'arboretum, ou de ceux crées dans la forêt autour."
    ],
    "es": [
      "Venga a descubrir este magnífico lugar de forma lúdica aprovechando los 4 senderos de orientación creados en el arboreto, o los creados en el bosque circundante."
    ],
    "nl": [
      "Kom en ontdek deze prachtige plek op een leuke manier door gebruik te maken van de 4 oriëntatieroutes die in het arboretum of in het omliggende bos zijn aangelegd."
    ]
  },
  "rdfs:label": {
