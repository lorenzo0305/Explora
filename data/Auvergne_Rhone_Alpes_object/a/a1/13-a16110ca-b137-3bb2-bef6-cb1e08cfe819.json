  "rdfs:comment": {
    "de": [
      "Restaurant im Zentrum der Residenzen des Ortes, mit einer großen Südterrasse, Liegestühlen, am Fuße der Pisten. Regionale Spezialitäten, Pizzakarte und alles \"hausgemacht\". Alle unsere Gerichte sind auch zum Mitnehmen, Burger, Pizzas, Trüffel, Aligot"
    ],
    "en": [
      "Restaurant in the center of the resort's residences, with a large south-facing terrace, deckchairs, at the foot of the slopes. Regional specialities, home-made pizzas. All our dishes are also available to take away, including burgers, pizzas, truffade and aligot."
    ],
    "it": [
      "Ristorante al centro delle residenze del resort, con ampia terrazza esposta a sud, sedie a sdraio, ai piedi delle piste. Specialità regionali, menù pizza, tutto \"fatto in casa\". Tutti i nostri piatti sono disponibili anche da asporto, hamburger, pizze, truffade, aligot"
    ],
    "fr": [
      "Restaurant au centre des résidences de la station, avec une grande terrasse plein sud ,transats,au pied des pistes. Spécialités régionales, carte de pizzas le tout \"Fait Maison\". Tous nos plats sont également à emporter , burgers, pizzas,truffade,aligot"
    ],
    "es": [
      "Restaurante en el centro de las residencias de la estación, con una gran terraza orientada al sur, tumbonas, al pie de las pistas. Especialidades regionales, menú de pizzas, todo \"casero\". Todos nuestros platos también están disponibles para llevar, hamburguesas, pizzas, trufadas, aligot"
    ],
    "nl": [
      "Restaurant in het centrum van de residenties van het resort, met een groot terras op het zuiden, ligstoelen, aan de voet van de pistes. Regionale specialiteiten, pizza menu, alles \"home-made\". Al onze gerechten zijn ook beschikbaar om mee te nemen, hamburgers, pizza's, truffel, aligot"
    ]
  },
  "rdfs:label": {
    "en": [
      "Les Sagnes"
    ],
    "fr": [
      "Les Sagnes"
    ]
  },
