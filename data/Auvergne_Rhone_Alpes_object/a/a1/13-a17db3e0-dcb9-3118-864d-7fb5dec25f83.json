  "rdfs:comment": {
    "de": [
      "Schließen Sie sich unseren Gruppenkursen an oder nutzen Sie Einzelcoachings mit unserer Trainerin Caroline im gesamten Val d'Arly! Von sanfter Gymnastik bis zum Zirkeltraining ist für jeden Geschmack etwas dabei! Geselligkeit und gute Laune sind garantiert."
    ],
    "en": [
      "Join our group classes or enjoy individual coaching sessions with our coach Caroline, throughout the Val d'Arly! From gentle gymnastics to circuit training, there's something for everyone! Fun and good humor guaranteed."
    ],
    "it": [
      "Unitevi ai nostri corsi di gruppo o approfittate delle sessioni di coaching individuale con la nostra allenatrice Caroline, in tutta la Val d'Arly! Dalla ginnastica dolce all'allenamento a circuito, ce n'è per tutti i gusti! Divertimento e buon umore garantiti."
    ],
    "fr": [
      "Rejoignez nos cours collectifs ou profitez de séances de coaching individuel avec notre coach Caroline, dans tout le Val d'Arly ! De la gym douce au circuit training, il y a en aura pour tous les goûts ! Convivialité et bonne humeur garanties."
    ],
    "es": [
      "Únete a nuestras clases en grupo o aprovecha las sesiones individuales de entrenamiento con nuestra entrenadora Caroline, por todo el Val d'Arly Desde gimnasia suave hasta entrenamiento en circuito, ¡hay para todos los gustos! Diversión y buen humor garantizados."
    ],
    "nl": [
      "Doe mee met onze groepslessen of profiteer van individuele coachingsessies met onze coach Caroline, overal in Val d'Arly! Van rustige gymnastiek tot circuittraining, er is voor elk wat wils! Plezier en humor gegarandeerd."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Chamois Fitness - Coach Sportif"
    ]
  },
