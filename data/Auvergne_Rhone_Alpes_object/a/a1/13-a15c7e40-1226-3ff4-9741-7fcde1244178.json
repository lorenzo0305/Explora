  "rdfs:comment": {
    "de": [
      "In ihrem Atelier erwartet Sie Claudine, um ihre Werke zu entdecken. Und wenn Sie sich in die Pastelltechnik einführen lassen möchten, bietet sie Kurse für Erwachsene und Kinder an."
    ],
    "en": [
      "In her studio, Claudine awaits you to discover her creations. And if you'd like to try your hand at pastel, she offers courses for adults and children."
    ],
    "it": [
      "Claudine sarà lieta di mostrarvi le sue opere nel suo studio. E se volete cimentarvi con il pastello, Claudine offre corsi per adulti e bambini."
    ],
    "fr": [
      "Dans son atelier, Claudine vous attend pour découvrir ses réalisations. Et si vous souhaitez vous initier à la technique du pastel, elle propose des cours adulte et enfant."
    ],
    "nl": [
      "Claudine laat je graag haar werk zien in haar atelier. En als je pastel wilt proberen, biedt ze cursussen aan voor volwassenen en kinderen."
    ],
    "es": [
      "Claudine estará encantada de mostrarle su trabajo en su estudio. Y si quieres probar el pastel, ofrece cursos para adultos y niños."
    ]
  },
  "rdfs:label": {
