  "rdfs:comment": {
    "de": [
      "Im Weiler Les Cours, 5 Minuten vom Skiort Auris-en-Oisans entfernt, empfängt Sie die Auberge mit Blick auf das Meije-Massiv.\r\nVirginie, die Geschäftsführerin, empfängt Sie in einer herzlichen Atmosphäre im Herzen eines typischen und friedlichen Dorfes."
    ],
    "en": [
      "In the hamlet of Les Cours, 5 minutes from the resort of Auris-en-Oisans, the inn welcomes you facing the Meije massif.\r\nVirginie, the manager, welcomes you in a warm atmosphere, in the heart of a typical, peaceful village."
    ],
    "it": [
      "Nella frazione di Cours, a 5 minuti dalla località di Auris-en-Oisans, la locanda vi accoglie di fronte al massiccio della Meije.\r\nVirginie, il gestore, vi accoglie in un'atmosfera calorosa, nel cuore di un villaggio tipico e tranquillo."
    ],
    "fr": [
      "Au hameau des Cours, à 5 minutes de la station d'Auris-en-Oisans, l’auberge vous accueille  face au massif de la Meije.\r\nVirginie, la gérante, vous reçoit dans une ambiance chaleureuse, au cœur d’un village typique et paisible."
    ],
    "nl": [
      "In het gehucht Cours, op 5 minuten van de badplaats Auris-en-Oisans, heet de herberg u welkom met uitzicht op het Meije-massief.\r\nVirginie, de uitbaatster, ontvangt u in een warme sfeer, in het hart van een typisch, rustig dorp."
    ],
    "es": [
      "En la aldea de Cours, a 5 minutos de la estación de Auris-en-Oisans, la posada le da la bienvenida frente al macizo de Meije.\r\nVirginie, la gerente, le da la bienvenida en un ambiente cálido, en el corazón de un pueblo típico y tranquilo."
    ]
  },
  "rdfs:label": {
    "en": [
      "Auberge de la Foret"
    ],
    "fr": [
      "Auberge de la Forêt"
    ],
    "nl": [
      "Auberge de la Forêt"
    ]
  },
