  "rdfs:comment": {
    "de": [
      "Traditionelles Restaurant mit Spezialitäten aus Savoyen, Pizzas, Burgern, Salaten und Pasta.\r\nCrêpes(nur am Nachmittag).\r\nTypisch savoyardischer Rahmen.\r\nSüdterrasse auf den Pisten. Vor Ort oder zum Mitnehmen."
    ],
    "en": [
      "A traditional restaurant serving Savoyard specialities, pizzas, burgers, salads and pasta dishes.\r\nCrepes (only in the afternoon)\r\nTypical Savoyard decor\r\nSouth-facing terrace on the slopes. Food to eat in or take away."
    ],
    "it": [
      "Ristorante tradizionale che offre specialità savoiarde, pizze, hamburger, insalate, pasta.\r\nPancake (solo nel pomeriggio)\r\nAmbientazione tipica savoiarda\r\nTerrazza esposta a sud sulle piste. Sul posto o da portare via."
    ],
    "fr": [
      "Restaurant traditionnel proposant des spécialités Savoyardes, pizzas, burgers, salades, pâtes.\r\nCrêpes(uniquement l'après-midi)\r\nCadre typiquement Savoyard\r\nTerrasse plein sud sur les pistes. Sur place ou en vente à emporter."
    ],
    "nl": [
      "Traditioneel restaurant met specialiteiten uit de Savoie, pizza's, hamburgers, maaltijdsalades, pastagerechten. \r\nCrêpes (alleen 's middags).\r\nTypische bergsfeer van de Savoie.\r\nTerras op het zuiden, langs de pistes. Ter plaatse of afhaal."
    ],
    "es": [
      "Restaurante tradicional que ofrece especialidades de Saboya, pizzas, hamburguesas, ensaladas, pasta.\r\nTortitas (sólo por la tarde)\r\nEl entorno típico de Saboya\r\nTerraza orientada al sur en las laderas. En el acto o para llevar."
    ]
  },
