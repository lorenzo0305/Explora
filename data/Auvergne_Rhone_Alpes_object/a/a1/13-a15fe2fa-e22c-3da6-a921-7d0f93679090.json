  "rdfs:comment": {
    "de": [
      "Debout sur le zinc spielt jedes Konzert wie eine Nacht, die sich ausdehnt, in der die Lieder Lebenssplitter, Vertraulichkeiten und innere Landschaften vermischen. Auf der Bühne reibt sich ihre fotografische Poesie mit Rock und Folk und öffnet leuchtende Klammern."
    ],
    "en": [
      "Debout sur le zinc plays each concert like a night that stretches out, where songs mingle bursts of life, confidences and inner landscapes. On stage, their photographic poetry rubs shoulders with rock and folk, opening up luminous interludes."
    ],
    "it": [
      "Debout sur le zinc interpreta ogni concerto come una notte che si allunga, dove le canzoni mescolano esplosioni di vita, confidenze e paesaggi interiori. Sul palcoscenico, la loro poesia fotografica si sposa con il rock e il folk, aprendo intermezzi luminosi."
    ],
    "fr": [
      "Debout sur le zinc joue chaque concert comme une nuit qui s’étire, où les chansons mêlent éclats de vie, confidences et paysages intérieurs. Sur scène, leur poésie photographique se frotte au rock et à la folk, ouvrant des parenthèses lumineuses."
    ],
    "nl": [
      "Debout sur le zinc speelt elk concert als een nacht die zich uitstrekt, waar de liedjes uitbarstingen van leven, vertrouwen en innerlijke landschappen mengen. Op het podium schuurt hun fotografische poëzie schouder aan schouder met rock en folk en opent ze lichtgevende intermezzo's."
    ],
    "es": [
      "Debout sur le zinc interpreta cada concierto como una noche que se alarga, donde las canciones mezclan ráfagas de vida, confidencias y paisajes interiores. Sobre el escenario, su poesía fotográfica se codea con el rock y el folk, abriendo interludios luminosos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Concert : DEBOUT SUR LE ZINC + EKSETERA"
    ]
  },
