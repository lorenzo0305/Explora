  "rdfs:comment": {
    "de": [
      "Spielenachmittag von 14:00 bis 18:00 Uhr zum Thema Ostern.\r\nFür alle Altersgruppen, mit Basteln, Ausmalen und Eiersuche!\r\nKostenlos, solange der Platz reicht, kostenloser Snack."
    ],
    "en": [
      "Easter-themed games afternoon from 2pm to 6pm.\r\nFor all ages, with arts and crafts, coloring and? egg hunts!\r\nFree, subject to availability, snack included."
    ],
    "it": [
      "Pomeriggio di giochi a tema pasquale dalle 14.00 alle 18.00.\r\nPer tutte le età, con attività artistiche e artigianali, colorazione e caccia alle uova!\r\nGratuito, fino a esaurimento posti, merenda inclusa."
    ],
    "fr": [
      "Après-midi jeux de 14h à 18h sur le thème de Pâques.\r\nTout public, avec activités manuels, coloriages et… chasse aux œufs !\r\nLibre et gratuit, dans la limite des places, goûter offert."
    ],
    "es": [
      "Tarde de juegos de Pascua, de 14.00 a 18.00 horas.\r\nPara todas las edades, con manualidades, colorear y... ¡búsqueda de huevos!\r\nGratuito, sujeto a disponibilidad, merienda incluida."
    ],
    "nl": [
      "Spelletjesmiddag met paasthema van 14.00 tot 18.00 uur.\r\nVoor alle leeftijden, met knutselen, kleuren en eieren zoeken!\r\nGratis, afhankelijk van beschikbaarheid, inclusief snack."
    ]
  },
  "rdfs:label": {
