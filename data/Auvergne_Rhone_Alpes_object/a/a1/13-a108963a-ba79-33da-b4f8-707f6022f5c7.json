  "rdfs:comment": {
    "de": [
      "Verfolgen Sie die Geschichte und beantworten Sie die Rätsel, um den Schuldigen zu entlarven! Wie ein echter Ermittler begeben Sie sich auf eine spielerische Entdeckungsreise durch die Stadt Marignier"
    ],
    "en": [
      "Follow the story and answer the riddles to unmask the culprit! Like a real investigator, set off on a fun discovery of the town of Marignier"
    ],
    "it": [
      "Seguite la storia e rispondete agli indovinelli per smascherare il colpevole! Come un vero detective, partite alla scoperta della città di Marignier"
    ],
    "fr": [
      "Suivez l'histoire et répondez aux énigmes pour démasquer le coupable ! Comme un vrai enquêteur, partez pour une découverte ludique de la ville de Marignier"
    ],
    "es": [
      "¡Sigue la historia y responde a los enigmas para desenmascarar al culpable! Como un auténtico detective, emprende un divertido descubrimiento de la ciudad de Marignier"
    ],
    "nl": [
      "Volg het verhaal en beantwoord de raadsels om de dader te ontmaskeren! Ga als een echte detective op een leuke ontdekkingstocht door de stad Marignier"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Jeu de piste \"CLUEDO\""
    ]
  },
