  "rdfs:comment": {
    "de": [
      "Freier Zugang mit Informationstafel. In dem Bestreben, das ökologische, landschaftliche und ornamentale Potenzial der Tümpel hervorzuheben, hat sich St-Marcel-en-Marcillat dem Programm \"Mares communales de l'Allier, un patrimoine à préserver\" (Kommunale Tümpel im Allier, ein zu bewahrendes Erbe) angeschlossen."
    ],
    "en": [
      "Free access with information panel. In order to enhance the environmental, landscape and ornamental potential of the ponds, St-Marcel-en-Marcillat has committed itself to the programme \"Ponds in the Allier, a heritage to be preserved\"."
    ],
    "it": [
      "Accesso libero con pannello informativo. Per valorizzare il potenziale ambientale, paesaggistico e ornamentale degli stagni, St-Marcel-en-Marcillat ha aderito al programma \"Mares communales de l'Allier, un patrimoine à préserver\"."
    ],
    "fr": [
      "Accès libre avec panneau d'information. Dans le souci de mettre en valeur le potentiel environnemental, paysager et ornemental des mares, St-Marcel-en-Marcillat s'est engagé dans le programme \"Mares communales de l'Allier, un patrimoine à préserver\"."
    ],
    "nl": [
      "Vrije toegang met informatiepaneel. Om het milieu-, landschaps- en sierpotentieel van de vijvers te versterken, heeft St-Marcel-en-Marcillat zich aangesloten bij het programma \"Mares communales de l'Allier, un patrimoine à préserver\"."
    ],
    "es": [
      "Acceso gratuito con panel informativo. Para valorizar el potencial medioambiental, paisajístico y ornamental de los estanques, St-Marcel-en-Marcillat se ha adherido al programa \"Mares communales de l'Allier, un patrimoine à préserver\"."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Mare communale des Vincents"
    ]
  },
