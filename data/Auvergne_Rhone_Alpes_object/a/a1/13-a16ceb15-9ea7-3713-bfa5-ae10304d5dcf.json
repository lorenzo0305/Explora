  "rdfs:comment": {
    "de": [
      "Steigen Sie 20 Meter hoch auf die Spitze des Tour des Minimes und genießen Sie die herrliche 360°-Aussicht! Von diesem Orientierungstisch aus können Sie die Landschaft des Saône-Tals und das sehr schöne Panorama auf die Monts du Beaujolais und den Mont Blanc genießen."
    ],
    "en": [
      "Come enjoy the view, with panoramic table available for admiring the landscapes of the Val de Saône and the magnificent panorama on the Beaujolais hills and the Mont Blanc."
    ],
    "it": [
      "Salite per 20 metri in cima alla Tour des Minimes e ammirate la superba vista a 360°! Da questo punto panoramico si può apprezzare il paesaggio della Val de Saône e lo splendido panorama dei Monts du Beaujolais e del Monte Bianco."
    ],
    "fr": [
      "Montez à 20 mètres de hauteur en haut de la Tour des Minimes et admirez la superbe vue à 360° ! Cette table d'orientation vous permettra d'apprécier le paysage du Val de Saône et le très beau panorama sur les Monts du Beaujolais et le Mont Blanc."
    ],
    "es": [
      "Suba 20 metros hasta la cima de la Tour des Minimes y admire la magnífica vista de 360° Desde este mirador panorámico, podrá apreciar el paisaje del Val de Saône y el hermoso panorama de los Montes del Beaujolais y el Mont Blanc."
    ],
    "nl": [
      "Klim 20 meter naar de top van de Tour des Minimes en bewonder het prachtige 360° uitzicht! Vanaf dit panoramische uitkijkpunt kun je genieten van het landschap van de Val de Saône en het prachtige panorama van de Monts du Beaujolais en de Mont Blanc."
    ]
  },
  "rdfs:label": {
    "en": [
      "Panoramic table"
    ],
    "fr": [
      "Table d'orientation"
    ]
  },
