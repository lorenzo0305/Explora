      "dc:description": {
        "de": [
          "In einer Lounge-Atmosphäre empfängt Sie die Bar des Grand Hôtel täglich von 10 Uhr bis Mitternacht. Täglich von 10 Uhr bis Mitternacht geöffnet."
        ],
        "en": [
          "In a lounge atmosphere, the Grand Hôtel bar welcomes you every day from 10am to midnight. Open every day from 10am to midnight."
        ],
        "it": [
          "In un'atmosfera lounge, il bar del Grand Hôtel vi accoglie tutti i giorni dalle 10 a mezzanotte. Aperto tutti i giorni dalle 10.00 alle 24.00."
        ],
        "fr": [
          "Dans une atmosphère lounge, le bar du Grand Hôtel vous accueille tous les jours de 10h à minuit. Ouvert tous les jours de 10h à minuit."
        ],
        "nl": [
          "In een loungesfeer verwelkomt de Grand Hôtel bar je elke dag van 10 tot middernacht. Elke dag geopend van 10.00 tot middernacht."
        ],
        "es": [
          "En un ambiente lounge, el bar del Grand Hôtel le da la bienvenida todos los días de 10:00 a 24:00. Abierto todos los días de 10:00 a 24:00."
        ]
      },
