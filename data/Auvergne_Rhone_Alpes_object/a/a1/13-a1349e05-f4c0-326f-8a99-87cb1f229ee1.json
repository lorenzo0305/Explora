  "rdfs:comment": {
    "de": [
      "Alle Wunder der Haute Maurienne Vanoise in den Bildern von Christian SIMON, einem passionierten Fotografen: Fauna, Flora und Landschaften, die auf verschiedenen Medien dargestellt werden... Direktverkauf und 100% lokale Kreationen."
    ],
    "en": [
      "All the wonders of Haute Maurienne Vanoise through the pictures taken by Christian SIMON, a passionate photographer: fauna, flora and landscapes in a variety of media... Direct sales and 100% local creations."
    ],
    "it": [
      "Tutte le meraviglie dell'Alta Maurienne Vanoise attraverso le immagini di Christian SIMON, fotografo appassionato: fauna, flora e paesaggi in una varietà di supporti... Vendita diretta e creazioni 100% locali."
    ],
    "fr": [
      "Toutes les merveilles de Haute Maurienne Vanoise à travers les clichés de Christian SIMON, photographe passionné : faune, flore et paysages déclinés sur différents supports... Vente directe et créations 100% locales."
    ],
    "es": [
      "Todas las maravillas de Haute Maurienne Vanoise a través de las imágenes tomadas por Christian SIMON, fotógrafo apasionado: fauna, flora y paisajes en diversos soportes... Venta directa y creaciones 100% locales."
    ],
    "nl": [
      "Alle wonderen van de Haute Maurienne Vanoise via de foto's van Christian SIMON, een gepassioneerd fotograaf: fauna, flora en landschappen in verschillende media... Directe verkoop en 100% lokale creaties."
    ]
  },
