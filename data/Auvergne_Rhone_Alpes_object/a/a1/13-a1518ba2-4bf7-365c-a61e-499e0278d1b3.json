  "rdfs:comment": {
    "de": [
      "Die eigene Geschichte anschauen, um zu sich selbst geboren zu werden. Tag der Familienaufstellungen und systemischen Aufstellungen in Charroux. Befreien Sie Ihre Emotionen, transformieren Sie Ihre Schemata in einem wohlwollenden Kreis."
    ],
    "en": [
      "Looking at your history to be born to yourself. A day of family and systemic constellations in Charroux. Free your emotions, transform your patterns in a caring circle."
    ],
    "it": [
      "Guardare alla propria storia per nascere a se stessi. Una giornata di costellazioni familiari e sistemiche a Charroux. Liberate le vostre emozioni, trasformate i vostri schemi in un cerchio di cura."
    ],
    "fr": [
      "Regarder son histoire pour naitre à soi. Journée de constellations familiales et systémiques à Charroux. Libérez vos émotions, transformez vos schémas dans un cercle bienveillant."
    ],
    "es": [
      "Mirar tu historia para nacer a ti mismo. Un día de constelaciones familiares y sistémicas en Charroux. Libera tus emociones, transforma tus esquemas en un círculo solidario."
    ],
    "nl": [
      "Kijken naar je geschiedenis om geboren te worden voor jezelf. Een dag van familie en systemische opstellingen in Charroux. Bevrijd je emoties, transformeer je patronen in een zorgzame cirkel."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Constellations familiales groupe"
    ]
