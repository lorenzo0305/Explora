  "rdfs:comment": {
    "de": [
      "Live-Graffiti, schnelle Skizzen, urbane Atmosphäre: Mehdi verwandelt die Märkte der Ardèche in künstlerische Bühnen. Jede Kreation ist einzigartig und wird vor den Augen des Publikums gemalt."
    ],
    "en": [
      "Live graffiti, quick sketches, urban atmosphere: Mehdi transforms the markets of Ardèche into artistic stages. Each creation is unique, painted before the eyes of the public."
    ],
    "it": [
      "Graffiti dal vivo, tele minuscole, ambiente urbano: Mehdi trasforma i mercati dell'Ardèche in palcoscenici artistici. Ogni creazione è unica, dipinta davanti agli occhi del pubblico."
    ],
    "fr": [
      "Graff en live, toiles minute, ambiance urbaine : Mehdi transforme les marchés d’Ardèche en scènes artistiques. Chaque création est unique, peinte sous les yeux du public."
    ],
    "nl": [
      "Live graffiti, minuscule doeken, stedelijke sfeer: Mehdi verandert de markten in de Ardèche in artistieke podia. Elke creatie is uniek, geschilderd voor de ogen van het publiek."
    ],
    "es": [
      "Graffiti en vivo, lienzos diminutos, ambiente urbano: Mehdi transforma los mercados de Ardèche en escenarios artísticos. Cada creación es única, pintada ante los ojos del público."
    ]
  },
