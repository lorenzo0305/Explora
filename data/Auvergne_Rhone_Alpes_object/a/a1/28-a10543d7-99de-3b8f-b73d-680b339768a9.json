  "rdfs:comment": {
    "de": [
      "Die Buchhandlung/Galerie l'Imprimerie verkauft und kauft gebrauchte Bücher, Gemälde, Zeichnungen, Drucke und Fotos. Auch zeitgenössische Künstler stellen hier aus."
    ],
    "en": [
      "The bookshop/gallery l'Imprimerie sells and buys second-hand books, paintings, drawings, prints, photos. Contemporary artists also exhibit there."
    ],
    "it": [
      "La libreria/galleria l'Imprimerie vende e acquista libri, dipinti, disegni, stampe e foto di seconda mano. Qui espongono anche artisti contemporanei."
    ],
    "fr": [
      "La librairie/galerie l'Imprimerie vends et achète des livres d'occasion, tableaux, dessins, estampes, photos. Des artistes contemporains y exposent aussi."
    ],
    "es": [
      "La librería/galería l'Imprimerie vende y compra libros de segunda mano, pinturas, dibujos, grabados y fotos. También exponen aquí artistas contemporáneos."
    ],
    "nl": [
      "De boekhandel/galerie l'Imprimerie verkoopt en koopt tweedehands boeken, schilderijen, tekeningen, prenten en foto's. Hier exposeren ook hedendaagse kunstenaars."
    ]
