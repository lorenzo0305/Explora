  "rdfs:comment": {
    "de": [
      "Mach dich mit deiner Karte auf die Suche nach den Markierungen, mit denen du auf spielerische und sportliche Weise die Schätze des Dorfes entdecken kannst. \r\nOrientierungsläufer, jetzt bist du dran!"
    ],
    "en": [
      "Armed with your map, go in search of the markers that will help you to discover the village's treasures in a fun and challenging way.\r\nOrienteer, it's your turn!"
    ],
    "it": [
      "Armati di mappa, partite alla ricerca dei segnalini che vi permetteranno di scoprire le ricchezze del villaggio in modo divertente.\r\nOrientatori, tocca a voi!"
    ],
    "fr": [
      "Muni de ta carte, pars à la recherche des balises qui te permettront de découvrir de manière ludique les richesses du village. \r\nOrienteur, à toi de jouer !"
    ],
    "nl": [
      "Ga gewapend met je kaart op zoek naar de markeringen waarmee je de rijkdommen van het dorp op een leuke manier kunt ontdekken.\r\nOriëntatieliefhebbers, het is aan jullie!"
    ],
    "es": [
      "Armados con vuestro mapa, salid en busca de los marcadores que os permitirán descubrir las riquezas del pueblo de forma divertida.\r\nOrientadores, ¡de vosotros depende!"
    ]
  },
  "rdfs:label": {
    "de": [
      "Spielerischer Orientierungslauf für Kinder"
    ],
    "en": [
      "Children's fun orienteering course"
    ],
    "fr": [
      "Parcours d'orientation accessible"
    ]
  },
