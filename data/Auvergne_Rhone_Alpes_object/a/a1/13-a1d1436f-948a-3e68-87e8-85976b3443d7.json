  "rdfs:comment": {
    "de": [
      "Besuchen Sie unsere Ziegen und unsere beiden Annesses im Winter auf den Anhöhen von Sallanches und im Sommer auf der Alm in der Gemeinde Le Reposoir. Wir freuen uns darauf, Ihnen unseren Beruf und unsere ausgezeichneten Käse im Laufe der Jahreszeiten näher zu bringen!"
    ],
    "en": [
      "Come and meet our goats and our two annesses in winter on the heights of Sallanches and in summer on the mountain pastures of Le Reposoir. We'll be delighted to show you our work and our excellent cheeses throughout the seasons!"
    ],
    "it": [
      "Venite a conoscere le nostre capre e i nostri due puledri in inverno sulle alture di Sallanches e in estate negli alpeggi di Le Reposoir. Saremo lieti di mostrarvi il nostro lavoro e i nostri eccellenti formaggi durante tutte le stagioni!"
    ],
    "fr": [
      "Venez retrouver nos chèvres et nos deux annesses l'hiver sur les hauteurs de Sallanches et l'été en alpage sur la commune du Reposoir. Nous serons ravis de vous faire découvrir notre métier et nos excellents fromages au fil des saisons !"
    ],
    "es": [
      "Venga a conocer a nuestras cabras y a nuestros dos cabritos en invierno en las alturas de Sallanches y en verano en los pastos de montaña de Le Reposoir. Estaremos encantados de mostrarle nuestro trabajo y nuestros excelentes quesos a lo largo de todas las estaciones"
    ],
    "nl": [
      "Kom kennismaken met onze geiten en onze twee jaarlingen in de winter op de hoogten van Sallanches en in de zomer op de bergweiden van Le Reposoir. We laten u graag kennismaken met ons werk en onze uitstekende kazen door de seizoenen heen!"
    ]
  },
