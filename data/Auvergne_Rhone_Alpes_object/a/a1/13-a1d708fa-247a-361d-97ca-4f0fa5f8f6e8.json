  "rdfs:comment": {
    "de": [
      "Ein Rundweg durch die Bresse in den Rädern der Geschichte.\r\nEine Reise in die Bresse der landwirtschaftlichen Anwesen, der großen Wege und der weiten Landschaften."
    ],
    "en": [
      "An all-terrain loop through the Bresse region, in the wheels of history.\r\nA journey through the Bresse of farming estates, great roads and great landscapes."
    ],
    "it": [
      "Un itinerario tutto su strada attraverso la regione della Bresse, tra le ruote della storia.\r\nUn viaggio nella regione della Bresse tra fattorie, strade secondarie e paesaggi."
    ],
    "fr": [
      "Une boucle tout chemin sur les terres bressanes dans les roues de l'histoire. \r\nUn voyage dans la Bresse des domaines agricoles, des grands chemins et des grands paysages."
    ],
    "es": [
      "Un bucle todoterreno por la región de Bresse, en las ruedas de la historia.\r\nUn viaje por la región de Bresse de granjas, carreteras secundarias y paisajes."
    ],
    "nl": [
      "Een all-road lus door de Bresse streek, in de wielen van de geschiedenis.\r\nEen reis door de Bresse streek van boerderijen, landwegen en landschappen."
    ]
  },
  "rdfs:label": {
