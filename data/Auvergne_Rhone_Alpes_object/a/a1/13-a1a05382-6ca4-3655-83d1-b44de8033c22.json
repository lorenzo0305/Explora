  "rdfs:comment": {
    "de": [
      "Der Maler Jongkind fertigte 1874 ein wunderschönes Aquarell dieses Platzes an. Vor Ort kann man ihn auf einer Schautafel rekonstruieren."
    ],
    "en": [
      "The painter Jongkind produced a superb watercolour of this square in 1874, and a mediation panel on site allows you to recreate it."
    ],
    "it": [
      "Il pittore Jongkind realizzò un superbo acquerello di questa piazza nel 1874, e un pannello di mediazione sul posto permette di ricrearlo."
    ],
    "fr": [
      "Le peintre Jongkind réalisa une superbe aquarelle de cette place en 1874, sur place un panneau de médiation permet de la reconstituer."
    ],
    "es": [
      "El pintor Jongkind realizó una magnífica acuarela de esta plaza en 1874, y un panel de mediación en el lugar permite recrearla."
    ],
    "nl": [
      "De schilder Jongkind maakte een prachtige aquarel van dit plein in 1874, en met een bemiddelingspaneel ter plekke kun je het nabootsen."
    ]
  },
  "rdfs:label": {
