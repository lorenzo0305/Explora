  "rdfs:comment": {
    "de": [
      "Halbüberdachtes Schwimmbad mit Schwimmunterricht, Wasseraerobic, Wassertraining und Aquabike. Begrenzte Plätze. Badeshorts verboten. Schulen, Vereine, Freizeit und Aquafitness."
    ],
    "en": [
      "Semi-covered swimming pool offering swimming lessons, water aerobics, water training and aquabike. Limited places. Swimming shorts prohibited. Schools, associations, leisure and aquafitness."
    ],
    "it": [
      "Piscina semicoperta che offre lezioni di nuoto, aquagym, aquatraining e aquabike. Iscrizione obbligatoria perché i posti sono limitati!\r\nVietati i pantaloncini da bagno. Per scuole, associazioni, attività ricreative e aquafitness."
    ],
    "fr": [
      "Piscine semi-couverte proposant des cours de natation, de l'aquagym, de l'aquatraining et de l'aquabike. Uniquement sur inscription car les places limitées !\r\nShorts de bain interdits. Scolaires, associations, loisirs et aquafitness."
    ],
    "es": [
      "Piscina semicubierta que ofrece clases de natación, aquagym, aquatraining y aquabike. Inscripción obligatoria, ya que las plazas son limitadas\r\nProhibido el uso de bañador. Para escuelas, asociaciones, actividades de ocio y aquafitness."
    ],
    "nl": [
      "Halfoverdekt zwembad met zwemlessen, aquagym, aquatraining en aquabike. Inschrijven verplicht, plaatsen zijn beperkt!\r\nZwemshorts verboden. Voor scholen, verenigingen, vrijetijdsactiviteiten en aquafitness."
    ]
  },
