  "rdfs:comment": {
    "de": [
      "Sechs Monate lang reist die Truppe des Cirque Musical durch Frankreich, um seine Bewohner zu treffen. Entdecken Sie ihre Musical-Show, ihr Escape Game sowie ihre spielerischen und künstlerischen Workshops!"
    ],
    "en": [
      "For 6 months, the Cirque Musical troupe will be touring France to meet its inhabitants. Come and discover their musical show, escape game and artistic workshops!"
    ],
    "it": [
      "Per 6 mesi, la troupe del Cirque Musical viaggerà in lungo e in largo per la Francia per incontrare le persone che la abitano. Venite a scoprire il suo spettacolo musicale, il suo gioco di fuga e i suoi laboratori artistici e divertenti!"
    ],
    "fr": [
      "Pendant 6 mois, la troupe du Cirque Musical parcourt la France à la rencontre de ses habitants. Venez découvrir son spectacle musical, son escape game ainsi que ses ateliers ludiques et artistiques !"
    ],
    "es": [
      "Durante 6 meses, la compañía Cirque Musical recorrerá Francia para ir al encuentro de sus habitantes. ¡Venga a descubrir su espectáculo musical, su juego de escape y sus talleres lúdicos y artísticos!"
    ],
    "nl": [
      "6 maanden lang reist Cirque Musical door heel Frankrijk om kennis te maken met de mensen die er wonen. Kom en ontdek de muzikale show, het ontsnappingsspel en de leuke en artistieke workshops!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Fabuleux Tour du Cirque Musical"
    ]
  },
