  "rdfs:comment": {
    "de": [
      "Der Skiort Chamrousse verfügt über mehrere Klettergebiete in außergewöhnlichen Landschaften. Vom Schulgelände für Anfänger bis zum Sportgelände in den Bergen ist für jedes Niveau und jede Lust etwas dabei!"
    ],
    "en": [
      "The resort of Chamrousse has several areas dedicated to climbing in exceptional landscapes. From the learning area to the sporty area in the mountains, there are for all levels and desires!"
    ],
    "it": [
      "La stazione di Chamrousse offre numerosi siti dedicati all'arrampicata in paesaggi eccezionali. Dalle scuole di arrampicata per principianti ai centri sportivi di montagna, ce n'è per tutti i gusti!"
    ],
    "fr": [
      "La station de Chamrousse possède plusieurs sites dédiés à l'escalade dans des paysages exceptionnels. Du site école pour s'initier au site sportif en montagne, il y a pour tous les niveaux et les envies !"
    ],
    "es": [
      "La estación de Chamrousse cuenta con varios lugares dedicados a la escalada en paisajes excepcionales. Desde escuelas de escalada para principiantes hasta centros de deportes de montaña, ¡hay para todos los gustos!"
    ],
    "nl": [
      "Het skioord Chamrousse heeft verschillende locaties gewijd aan klimmen in uitzonderlijke landschappen. Van klimscholen voor beginners tot bergsportcentra, er is voor elk wat wils!"
    ]
  },
  "rdfs:label": {
    "de": [
      "Klettergebiete Chamrousse"
    ],
    "en": [
      "Chamrousse climbing areas"
    ],
    "fr": [
      "Sites d'escalade Chamrousse"
    ]
  },
