  "rdfs:comment": {
    "de": [
      "Restaurant mit familiärer und entspannter Atmosphäre, das hausgemachte Gerichte aus der Region anbietet. Der Teller ist großzügig und abwechslungsreich, je nach Jahreszeit und Inspiration des Küchenchefs."
    ],
    "en": [
      "A restaurant with a relaxed family atmosphere offering homemade local dishes. The plate is generous and varied according to the seasons and the chef's inspiration."
    ],
    "it": [
      "Ristorante dall'atmosfera familiare e rilassata che offre piatti locali fatti in casa. I piatti sono generosi e variano in base alle stagioni e all'ispirazione dello chef."
    ],
    "fr": [
      "Restaurant à l'ambiance familiale et décontractée proposant des plats de terroir  maison. L'assiette est généreuse et variée selon les saisons et l'inspiration du chef."
    ],
    "es": [
      "Restaurante de ambiente familiar y relajado que ofrece platos caseros de la zona. Los platos son generosos y variados según las estaciones y la inspiración del chef."
    ],
    "nl": [
      "Restaurant met een familiale en ontspannen sfeer met huisgemaakte streekgerechten. De gerechten zijn royaal en gevarieerd volgens de seizoenen en de inspiratie van de chef."
    ]
  },
