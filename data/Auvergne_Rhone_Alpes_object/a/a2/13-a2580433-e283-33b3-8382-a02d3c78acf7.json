  "rdfs:comment": {
    "de": [
      "Eine einzigartige Veranstaltung, die Sport, Führung und Inspiration miteinander verbindet, mit einem außergewöhnlichen Gast, Fabien Pelous, ehemaliger Kapitän des XV de France: \"Unternehmenskapitän? Den Menschen zum Motor der Leistung machen\"."
    ],
    "en": [
      "A unique event combining sport, leadership and inspiration, featuring an exceptional guest, Fabien Pelous, former captain of the XV de France: \"Corporate captain? Making people the driving force behind performance\"."
    ],
    "it": [
      "Un evento unico che unisce sport, leadership e ispirazione, con un ospite d'eccezione, Fabien Pelous, ex capitano della nazionale francese: \"Corporate Captain? Fare delle persone il motore della performance\"."
    ],
    "fr": [
      "Un événement unique mêlant sport, leadership et inspiration, autour d’un invité d’exception, Fabien Pelous, ancien capitaine du XV de France : \"capitaine d’entreprise – Faire de l’humain un moteur de performance\"."
    ],
    "es": [
      "Un evento único que combina deporte, liderazgo e inspiración, con un invitado de excepción, Fabien Pelous, antiguo capitán de la selección francesa: \"¿Capitán de empresa? Hacer de las personas el motor del rendimiento\"."
    ],
    "nl": [
      "Een uniek evenement dat sport, leiderschap en inspiratie combineert, met een bijzondere gast, Fabien Pelous, voormalig aanvoerder van het Franse nationale team: \"Corporate Captain? Maak van mensen de drijvende kracht achter prestaties\"."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Rencontre avec Fabien Pelous"
    ]
  },
