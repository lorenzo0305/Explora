  "rdfs:comment": {
    "de": [
      "Entdecken Sie die bäuerlichen Obstgärten des Kantons, die Geschichte des Bergapfels und seiner Sorten, aber auch die Rolle der Bienen bei der Bestäubung."
    ],
    "en": [
      "Discover the district's orchard farmers, the history of the mountain apple and its different varieties as well as the essential role played by bees in pollination.  A guided tour followed by apple juice and Biscantin (Aravis cider) tasting."
    ],
    "it": [
      "Scoprite i frutteti agricoli del cantone, la storia della mela di montagna e delle sue varietà e il ruolo delle api nell'impollinazione."
    ],
    "fr": [
      "Découvrir les vergers fermiers du canton, l'histoire de la pomme de montagne et ses variétés mais aussi le rôle des abeilles dans la pollinisation."
    ],
    "nl": [
      "Ontdek de boomgaarden van het kanton, de geschiedenis van de bergappel en zijn variëteiten, en de rol van de bijen bij de bestuiving."
    ],
    "es": [
      "Descubra los huertos agrícolas del cantón, la historia de la manzana de montaña y sus variedades, y el papel de las abejas en la polinización."
    ]
  },
  "rdfs:label": {
    "en": [
      "Tour of the Maison de la pomme et du biscantin in Serraval"
    ],
    "fr": [
      "Maison de la pomme et du biscantin"
    ]
  },
