  "rdfs:comment": {
    "de": [
      "Eine Lesekiste ist eine kleine Straßenbibliothek, in der jeder kostenlos Bücher aufstellen und ausleihen kann, wodurch der Zugang zur Kultur privilegiert wird."
    ],
    "en": [
      "A reading box is a small street library where everyone can deposit and borrow books free of charge, thus promoting access to culture."
    ],
    "it": [
      "Una reading box è una piccola biblioteca di strada dove chiunque può lasciare e prendere in prestito libri gratuitamente, promuovendo così l'accesso alla cultura."
    ],
    "fr": [
      "Une boîte à lire est une petite bibliothèque de rue où chacun peut déposer et emprunter des livres gratuitement, privilégiant ainsi l'accès à la culture."
    ],
    "es": [
      "Un buzón de lectura es una pequeña biblioteca callejera donde cualquiera puede dejar y tomar prestados libros de forma gratuita, fomentando así el acceso a la cultura."
    ],
    "nl": [
      "Een leesdoos is een kleine straatbibliotheek waar iedereen gratis boeken kan afgeven en lenen en zo de toegang tot cultuur bevordert."
    ]
  },
  "rdfs:label": {
