  "rdfs:comment": {
    "de": [
      "Die Villa Cécile profitiert von einer privilegierten Lage, einem idyllischen Rahmen mit 20 Zimmern, einem Spa, Massagekabinen und einer distinguierten Küche, die Sie während eines Gourmetaufenthalts, eines Aufenthalts oder auch anlässlich eines Etappenabends genießen können."
    ],
    "en": [
      "Villa Cécile boasts a privileged location, an idyllic setting with 20 rooms, a spa, massage cabins and distinguished cuisine to enjoy during a gourmet stopover, a stay or even a stopover evening."
    ],
    "it": [
      "Villa Cécile vanta una posizione privilegiata, un ambiente idilliaco con 20 camere, una spa, cabine per massaggi e una cucina raffinata da gustare durante una sosta gastronomica, un soggiorno o una sosta serale."
    ],
    "fr": [
      "La Villa Cécile bénéficie d’une situation privilégiée, d’un cadre idyllique avec 20 chambres, d’un spa, de cabines de massage et d’une cuisine distinguée à apprécier lors d’une escale gourmande, d’un séjour ou encore à l’occasion d’une soirée-étape."
    ],
    "es": [
      "Villa Cécile goza de una ubicación privilegiada, un entorno idílico con 20 habitaciones, un spa, cabinas de masaje y una cocina distinguida para disfrutar durante una escala gastronómica, una estancia o una escala nocturna."
    ],
    "nl": [
      "Villa Cécile beschikt over een bevoorrechte locatie, een idyllische omgeving met 20 kamers, een spa, massagecabines en een verfijnde keuken om van te genieten tijdens een gastronomische tussenstop, een verblijf of een avondstop."
    ]
  },
