  "rdfs:comment": {
    "de": [
      "Florent Gillot hat 2018 seine Mikrobrauerei \"Motueka\" (der Name eines neuseeländischen Hopfens) gestartet.\r\nEr ist in Brives-Charensac ansässig, bietet 10 lokal gebraute Biere an und hat direkt in seiner Brauerei eine Bar eröffnet, in der du seine Kreationen verkosten kannst."
    ],
    "en": [
      "Florent Gillot launched his microbrewery \"Motueka\" (the name of a New Zealand hop) in 2018.\r\nBased in Brives-Charensac, he offers 10 locally brewed beers and has opened a bar directly in his brewery to sample his creations."
    ],
    "it": [
      "Florent Gillot ha lanciato il suo microbirrificio \"Motueka\" (il nome di un luppolo neozelandese) nel 2018.\r\nCon sede a Brives-Charensac, offre 10 birre prodotte localmente e ha aperto un bar direttamente nel suo birrificio per degustare le sue creazioni."
    ],
    "fr": [
      "Florent Gillot a lancé en 2018 sa micro-brasserie \"Motueka\" (le nom d’un houblon néo-zélandais).\r\nInstallé à Brives-Charensac, il propose 10 bières brassées localement et a ouvert un bar directement dans sa brasserie pour déguster ses créations."
    ],
    "es": [
      "Florent Gillot puso en marcha su microcervecería \"Motueka\" (el nombre de un lúpulo neozelandés) en 2018.\r\nCon sede en Brives-Charensac, ofrece 10 cervezas elaboradas localmente y ha abierto un bar directamente en su fábrica para degustar sus creaciones."
    ],
    "nl": [
      "Florent Gillot lanceerde zijn microbrouwerij \"Motueka\" (de naam van een Nieuw-Zeelandse hop) in 2018.\r\nHij is gevestigd in Brives-Charensac, biedt 10 lokaal gebrouwen bieren aan en heeft een bar direct in zijn brouwerij geopend om zijn creaties te proeven."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Brasserie Motueka"
    ]
  },
