  "rdfs:comment": {
    "de": [
      "Seit 1980 bietet das Haus Chambriard Schneidwaren, Tischkultur und die Herstellung seines Modells \"Le Thiers® par Chambriard\" an."
    ],
    "en": [
      "Since 1980, Chambriard has been offering cutlery and tableware, not forgetting the manufacture of its model \"Le Thiers® by Chambriard\"."
    ],
    "it": [
      "Dal 1980, Chambriard offre posate e stoviglie, senza dimenticare la produzione del modello \"Le Thiers® by Chambriard\"."
    ],
    "fr": [
      "Depuis 1980, la maison Chambriard propose article de coutellerie, arts de la table sans oublier la fabrication de son modèle \"Le Thiers® par Chambriard\"."
    ],
    "nl": [
      "Sinds 1980 biedt Chambriard bestek en tafelgerei aan en niet te vergeten de vervaardiging van het model \"Le Thiers® by Chambriard\"."
    ],
    "es": [
      "Desde 1980, Chambriard ofrece cubertería y vajilla, sin olvidar la fabricación de su modelo \"Le Thiers® by Chambriard\"."
    ]
  },
