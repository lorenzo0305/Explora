  "rdfs:comment": {
    "de": [
      "es stehen Ihnen 2 zugelassene Golfplätze zur Verfügung, eine 18-Loch-Kombination (Länge 4693 Meter PAR 72 ) und ein 9-Loch-Pitch-and-Putt-Platz (Länge 587 Meter PAR 27). Vermietung von Golfwagen und Ausrüstung. Kurse für alle mit Lehrer vor Ort."
    ],
    "en": [
      "2 approved courses are available, an 18-hole combination (length 4693 meters PAR 72 ) and a 9-hole Pitch and Putt (length 587 meters PAR 27). Buggy and equipment hire. Lessons open to all, with on-site instructor."
    ],
    "it": [
      "sono disponibili 2 campi omologati, uno combinato a 18 buche (lunghezza 4693 metri PAR 72) e uno a 9 buche Pitch and Putt (lunghezza 587 metri PAR 27). Noleggio di buggy e attrezzature. Lezioni aperte a tutti con istruttore in loco."
    ],
    "fr": [
      "2 parcours homologués sont à votre disposition, une combinaison 18 trous (longueur 4693 mètres PAR 72 ) et un Pitch and Putt 9 trous (longueur 587 mètres PAR 27). Location de voiturette et matériel. Cours ouverts à tous avec professeur sur place."
    ],
    "nl": [
      "er zijn 2 goedgekeurde banen beschikbaar, een 18-holes combinatie (lengte 4693 meter PAR 72) en een 9-holes Pitch and Putt (lengte 587 meter PAR 27). Buggy's en uitrusting te huur. Lessen voor iedereen met instructeur ter plaatse."
    ],
    "es": [
      "dispone de 2 campos homologados, uno combinado de 18 hoyos (longitud 4693 metros PAR 72) y un Pitch and Putt de 9 hoyos (longitud 587 metros PAR 27). Alquiler de buggies y material. Lecciones abiertas a todos con instructor in situ."
    ]
  },
