  "rdfs:comment": {
    "de": [
      "Au Fût et à mesure Annemasse bedeutet, dass du dank des Fassbierausschanks im Saal und seines Bestellsystems per Tablet am Tisch eine Bar-Erfahrung machen kannst. Hier bist du der Barkeeper und zapfst dir an den Zapfhähnen die gewünschte Menge Bier."
    ],
    "en": [
      "At Au Fût et à mesure Annemasse, you'll enjoy a bar experience thanks to our in-house draught beer service and our tabletop ordering system. Here, you play bartender and pour yourself the quantity of beer you want from the pumps."
    ],
    "it": [
      "Au Fût et à mesure Annemasse è un'esperienza di bar, con un servizio di birra alla spina nel bar e un sistema di ordinazione su tablet al tavolo. Qui si gioca a fare il barista e ci si versa la quantità di birra desiderata dalle pompe."
    ],
    "fr": [
      "Au Fût et à mesure Annemasse, c'est vivre une expérience de bar grâce au service de bières pression en salle et son système de commande sur tablette à table. Ici c'est toi qui joues les barmen et te sers aux pompes la quantité de bière que tu souhaites."
    ],
    "nl": [
      "Au Fût et à mesure Annemasse is een barervaring, met een tapbierservice in de bar en een tabletbestelsysteem aan tafel. Hier speel je barman en schenk je zelf de gewenste hoeveelheid bier in uit de pompen."
    ],
    "es": [
      "Au Fût et à mesure Annemasse es una experiencia de bar, con un servicio de cerveza de barril en la barra y un sistema de pedidos por tableta en la mesa. Aquí, juegas a ser camarero y te sirves la cantidad de cerveza que quieras de los surtidores."
    ]
  },
