  "rdfs:comment": {
    "de": [
      "Francesco, ein virtuoser Gitarrist und Sänger mit einer kraftvollen, an Joe Cocker erinnernden Stimme, bildet mit dem Mundharmonikaspieler Alain Michel ein intensives und authentisches Duo, das mit Inbrunst die großen Strömungen des Blues und der afroamerikanischen Roots Music durchläuft."
    ],
    "en": [
      "A virtuoso guitarist and a singer with a powerful voice reminiscent of Joe Cocker, Francesco and harmonica player Alain Michel form an intense, authentic duo that fervently explores the great currents of Afro-American blues and roots music."
    ],
    "it": [
      "Chitarrista virtuoso e cantante dalla voce potente che ricorda Joe Cocker, Francesco e l'armonicista Alain Michel formano un duo intenso e autentico che esplora con fervore le grandi correnti del blues afroamericano e della roots music."
    ],
    "fr": [
      "Guitariste virtuose et chanteur habité à la voix puissante rappelant Joe Cocker, Francesco forme avec l’harmoniciste Alain Michel un duo intense et authentique qui parcourt avec ferveur les grands courants du blues et de la roots music afro-américaine."
    ],
    "es": [
      "Guitarrista virtuoso y cantante con una poderosa voz que recuerda a Joe Cocker, Francesco y el armonicista Alain Michel forman un dúo intenso y auténtico que explora con fervor las grandes corrientes del blues afroamericano y la música de raíces."
    ],
    "nl": [
      "Als virtuoos gitarist en zanger met een krachtige stem die doet denken aan Joe Cocker, vormen Francesco en harmonicaspeler Alain Michel een intens, authentiek duo dat met verve de grote stromingen van de Afro-Amerikaanse blues en rootsmuziek verkent."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Jeudis de l'Orangerie - Francesco Piu - Soirée Blues"
    ]
  },
