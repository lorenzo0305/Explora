  "rdfs:comment": {
    "de": [
      "Das Restaurant La Pyramide, das sich im gleichnamigen Hotel befindet, lädt Sie mit seiner Sterneküche zu einer kulinarischen Reise ein. Aromen von gestern und heute können in einem raffinierten Rahmen mit Blick über den Barockgarten verkostet werden."
    ],
    "en": [
      "The Pyramide restaurant invites you on a culinary journey through gastronomic cuisine that has been awarded two Michelin stars since 1992. In an ultra contemporary setting, Patrick Henriroux demonstrates expertise that is as discreet as it is unmistakable"
    ],
    "it": [
      "Il ristorante La Pyramide, all'interno dell'omonimo hotel, vi invita a compiere un viaggio culinario attraverso una cucina gastronomica stellata. Sapori di ieri e di oggi vi delizieranno il palato, in un ambiente raffinato con vista sul giardino alla francese."
    ],
    "fr": [
      "Le restaurant la Pyramide vous invite à un voyage culinaire à travers une cuisine gastronomique doublement étoilée au guide Michelin depuis 1992. Dans un cadre ultra contemporain, Patrick Henriroux fait preuve d’un savoir-faire aussi discret qu'imparable."
    ],
    "nl": [
      "Het restaurant la Pyramide nodigt u uit voor een culinaire reis door een gastronomische keuken die sinds 1992 met twee Michelinsterren is bekroond. In een ultramodern kader demonstreert Patrick Henriroux een even discrete als onstuitbare knowhow."
    ],
    "es": [
      "El restaurante La Pyramide, situado en el hotel del mismo nombre, le invita a un viaje culinario a través de una cocina de calidad premiada por la guía Michelin. Podrá degustar sabores de ayer y de hoy en un marco refinado con vistas a un jardín de estilo francés."
    ]
  },
