  "rdfs:comment": {
    "de": [
      "Maison Urbanbroc ist eine Boutique für Trödel und Deko-Kreationen.\r\nHier finden Sie eine Auswahl an Dekorationsgegenständen und Kleinmöbeln vom Ende des 19. Jahrhunderts bis in die 80er Jahre.\r\nMaison Urbanbroc bietet auch Deko-Kreationen an."
    ],
    "en": [
      "Maison Urbanbroc is a boutique selling second-hand goods and decorative creations.\r\nYou'll find a selection of decorative objects and small furnishings dating from the late 19th century to the 1980s.\r\nMaison Urbanbroc also offers decorative creations."
    ],
    "it": [
      "La Maison Urbanbroc è una boutique che vende oggetti di seconda mano e creazioni decorative.\r\nTroverete una selezione di oggetti decorativi e piccoli mobili che vanno dalla fine del XIX secolo agli anni Ottanta.\r\nLa Maison Urbanbroc propone anche creazioni decorative."
    ],
    "fr": [
      "Maison Urbanbroc est une boutique de brocante et créations déco. \r\nVous y trouverez une sélection d’objets décoratifs et petits mobiliers datant de la fin du XIXeme jusqu’aux années 80.\r\nMaison Urbanbroc propose également des créations déco."
    ],
    "nl": [
      "Maison Urbanbroc is een boetiek met tweedehands spullen en decoratieve creaties.\r\nJe vindt er een selectie decoratieve voorwerpen en kleine meubelstukken uit de late 19e eeuw tot de jaren 1980.\r\nMaison Urbanbroc biedt ook decoratieve creaties aan."
    ],
    "es": [
      "Maison Urbanbroc es una boutique de artículos de segunda mano y creaciones decorativas.\r\nEncontrará una selección de objetos de decoración y pequeños muebles que datan de finales del siglo XIX hasta la década de 1980.\r\nLa Maison Urbanbroc también ofrece creaciones decorativas."
    ]
  },
