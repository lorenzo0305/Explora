  "rdfs:comment": {
    "de": [
      "Konzept für Schnellrestaurants vor Ort oder zum Mitnehmen, wo wir Geschmack und Vergnügen für frische und leckere Rezepte kombinieren... Kaffee, süße Riegel, Wraps, Buchweizenpfannkuchen: alles hausgemacht und gut für Ihren Gaumen!"
    ],
    "en": [
      "A fast-food concept for eat-in or takeaway, where we combine flavour and pleasure in recipes that are as fresh as they are delicious... Coffee, sweet bars, wraps, buckwheat pancakes: all homemade and good for your taste buds!"
    ],
    "it": [
      "Un concetto di fast-food per il consumo o l'asporto, dove combiniamo gusto e piacere in ricette tanto fresche quanto deliziose... Caffè, barrette dolci, wrap, frittelle di grano saraceno: tutto fatto in casa e buono per le vostre papille gustative!"
    ],
    "fr": [
      "Concept de restauration rapide sur place ou à emporter, où nous combinons saveur et plaisir pour des recettes aussi fraîches que gourmandes... Café, barres sucrées, wraps, galettes de sarrasin: du fait maison ; bon pour vos papilles !"
    ],
    "es": [
      "Un concepto de comida rápida para comer en casa o para llevar, donde combinamos sabor y placer en recetas tan frescas como deliciosas... Café, barritas dulces, wraps, tortitas de trigo sarraceno: ¡todo casero y bueno para el paladar!"
    ],
    "nl": [
      "Een fastfoodconcept om in te eten of mee te nemen, waar we smaak en plezier combineren in even verse als heerlijke recepten... Koffie, zoete repen, wraps, boekweitpannenkoeken: allemaal huisgemaakt en goed voor je smaakpapillen!"
    ]
  },
