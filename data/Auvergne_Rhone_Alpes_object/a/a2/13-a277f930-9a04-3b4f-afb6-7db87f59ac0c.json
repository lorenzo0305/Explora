  "rdfs:comment": {
    "de": [
      "Großhandel mit über 200 lokal und handwerklich zusammengestellten Teesorten, Kräutertees, Rooibos, Mate und Matcha sowie Kaffee, Tischkultur und Dekorationsartikel. Hier finden Sie auch unseren Kräutertee Pastille de Vichy."
    ],
    "en": [
      "Bulk sales of over 200 references of teas, herbal teas, rooibos, maté and matcha, locally blended and handcrafted, as well as coffee, tableware and home decoration. You'll also find our Vichy Pastille infusion."
    ],
    "it": [
      "Vendita all'ingrosso di oltre 200 referenze di tè, tisane, rooibos, maté e matcha miscelati localmente e a mano, oltre a caffè, stoviglie e oggetti decorativi. Troverete anche il nostro infuso Pastille de Vichy."
    ],
    "fr": [
      "Vente en vrac de plus de 200 references de thés, tisanes, rooibos, maté, matcha assemblés localement et artisanalement ainsi que du café, de l'art de la table et de la décoration. Retrouvez également notre infusion à la Pastille de Vichy."
    ],
    "es": [
      "Venta a granel de más de 200 referencias de tés, tisanas, rooibos, maté y matcha mezclados local y artesanalmente, así como café, vajilla y artículos de decoración. También encontrará nuestra infusión Pastille de Vichy."
    ],
    "nl": [
      "Bulkverkoop van meer dan 200 soorten thee, kruidenthee, rooibos, maté en matcha, lokaal en met de hand gemengd, evenals koffie, servies en decoratieve artikelen. U vindt hier ook onze Pastille de Vichy infusie."
    ]
  },
