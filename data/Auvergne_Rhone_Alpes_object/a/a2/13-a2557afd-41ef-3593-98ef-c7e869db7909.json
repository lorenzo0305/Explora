  "rdfs:comment": {
    "de": [
      "Die Auberge du Pelloux liegt in Villy-le-Pelloux zwischen Annecy und Genf. Sie ist ein familiengeführtes Restaurant und Catering-Unternehmen, das mitten auf dem Land liegt."
    ],
    "en": [
      "Located in Villy-le-Pelloux between Annecy & Geneva, the Auberge du Pelloux is a family restaurant - caterer located in the heart of the countryside working with our local producers to ensure fresh, quality and seasonal products."
    ],
    "it": [
      "Situato a Villy-le-Pelloux, tra Annecy e Ginevra, l'Auberge du Pelloux è un ristorante e catering a conduzione familiare situato nel cuore della campagna, che collabora con i produttori locali per garantire prodotti di stagione freschi e di qualità."
    ],
    "fr": [
      "Situés à Villy-le-Pelloux entre Annecy & Genève, l'Auberge du Pelloux est un restaurant - traiteur familial implanté au cœur de la campagne travaillant au maximum avec nos producteurs locaux pour vous assurer des produits frais, de qualité et de saison."
    ],
    "es": [
      "Situado en Villy-le-Pelloux, entre Annecy y Ginebra, el Auberge du Pelloux es un restaurante y servicio de catering familiar situado en plena naturaleza, que trabaja con productores locales para garantizar productos de temporada frescos y de calidad."
    ],
    "nl": [
      "Auberge du Pelloux ligt in Villy-le-Pelloux tussen Annecy en Genève en is een familierestaurant en traiteur in het hart van het platteland. Het werkt samen met lokale producenten om verse seizoensproducten van hoge kwaliteit te garanderen."
    ]
  },
