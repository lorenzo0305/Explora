  "rdfs:comment": {
    "de": [
      "Olivenhain mit 10 000 Bäumen im Süden der Ardèche, der auf die Produktion von hochwertigem BIO-Olivenöl ausgerichtet ist. Gewinner des weltweiten Wettbewerbs Flos Olei 2019, 2022, 2023.\r\nWir verfügen über eine moderne Ölmühle und eine Verkaufsstelle ab Hof und online."
    ],
    "en": [
      "Olive grove with 10,000 trees in the southern Ardèche region, dedicated to the production of top-of-the-range organic olive oil. Winner of the Flos Olei world competition 2019, 2022, 2023.\r\nWe have a modern oil mill and an on-farm and online sales outlet."
    ],
    "it": [
      "Oliveto con 10.000 piante nel sud dell'Ardèche, che produce olio d'oliva biologico di alta gamma. Vincitore del concorso mondiale Flos Olei nel 2019, 2022 e 2023.\r\nDisponiamo di un moderno frantoio e di un punto vendita in azienda e online"
    ],
    "fr": [
      "Oliveraie de 10 000 arbres au sud de l'Ardèche orientée vers la production d'huile d'olive haut de gamme BIO. Lauréat du concours mondial Flos Olei 2019, 2022, 2023. \r\nNous disposons d'un moulin à huile moderne et d'un point de vente à la ferme et en ligne"
    ],
    "es": [
      "Olivar con 10.000 árboles en el sur de Ardèche, que produce aceite de oliva ecológico de alta gama. Ganador del concurso mundial Flos Olei en 2019, 2022 y 2023.\r\nDisponemos de una almazara moderna y de un punto de venta en la explotación y en línea"
    ],
    "nl": [
      "Olijfgaard met 10.000 bomen in het zuiden van de Ardèche, die biologische olijfolie van topkwaliteit produceert. Winnaar van de Flos Olei wereldwedstrijd in 2019, 2022 en 2023.\r\nWe hebben een moderne oliemolen en een verkooppunt op de boerderij en online."
    ]
  },
