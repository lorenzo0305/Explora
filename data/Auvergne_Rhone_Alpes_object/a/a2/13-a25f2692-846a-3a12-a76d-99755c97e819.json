  "rdfs:comment": {
    "de": [
      "In einer herzlichen und familiären Atmosphäre bieten wir Ihnen an, lustige Momente zu verbringen und spanische Tapas und Produkte aus dem Südwesten zu teilen."
    ],
    "en": [
      "In a warm and cosy atmosphere, we offer you the chance to have a good time and share Spanish tapas."
    ],
    "it": [
      "In un'atmosfera calda e accogliente, vi offriamo di trascorrere dei bei momenti e di condividere le tapas spagnole."
    ],
    "fr": [
      "Dans une ambiance chaleureuse et familiale , nous vous proposons de passer de bons moments de rigolades et de partager des tapas à l'espagnole et des produits de Sud-Ouest."
    ],
    "nl": [
      "In een warme en familiale sfeer, bieden wij u goede momenten van plezier en het delen van tapas op de Spaanse manier en producten van het Zuid-Westen."
    ],
    "es": [
      "En un ambiente cálido y familiar, te ofrecemos pasar buenos momentos de diversión y compartir tapas a la española y productos del suroeste."
    ]
  },
  "rdfs:label": {
    "en": [
      "Chez nous 2 Tapas Bar"
