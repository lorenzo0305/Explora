  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/e2f23c09-9a67-316f-a24c-ecc86e09433c",
      "dc:description": {
        "de": [
          "Anlässlich des Rosa Oktobers organisiert das Festkomitee von Hucqueliers einen Liederabend mit französischen Chansons.\nim Festsaal von Hucqueliers.\nDie Einnahmen gehen an den Verein Rosa Oktober.\nEintritt 10 ? - Kostenlos für Kinder unter 12 Jahren."
        ],
        "en": [
          "To mark Pink October, the Hucqueliers Comité des fêtes is organizing a Recital of French songs.\nat the Hucqueliers village hall.\nProfits will be donated to the association Octobre Rose.\nAdmission 10? - Free for children under 12."
        ],
        "it": [
          "In occasione dell'Ottobre Rosa, il Comitato delle feste di Hucqueliers organizza un recital di canzoni francesi.\npresso la sala del villaggio di Hucqueliers.\nIl ricavato sarà devoluto all'associazione Pink October.\nIngresso 10? - Gratuito per i bambini sotto i 12 anni."
        ],
        "fr": [
          "À l'occasion d'Octobre Rose, le comité des fêtes d'Hucqueliers organise un Récital de chansons françaises. \nà la salle des fêtes d'Hucqueliers. \nLes profits seront reversés à l'association Octobre Rose. \nEntrée 10€ - Gratuit pour les -12ans."
        ],
        "nl": [
          "Ter gelegenheid van Roze oktober organiseert het Comité des fêtes van Hucqueliers een voordracht van Franse liederen.\nin het dorpshuis van Hucqueliers.\nDe winst gaat naar het goede doel Roze Oktober.\nToegang 10? - Gratis voor kinderen onder de 12 jaar."
        ],
        "es": [
          "Con motivo del Octubre Rosa, el Comité des fêtes de Hucqueliers organiza un recital de canciones francesas.\nen la sala de fiestas de Hucqueliers.\nLos beneficios se destinarán a la asociación Octubre Rosa.\nEntrada 10? - Gratis para menores de 12 años."
        ]
      },
