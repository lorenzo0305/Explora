  "rdfs:comment": {
    "de": [
      "Das Restaurant La Casa bietet französische und italienische Küche: Pizzas aus dem Holzofen, eine Salatkarte, Nudel- Fleisch- und Fischgerichte."
    ],
    "en": [
      "The Casa restaurant offers traditional French and Italian cooking. \r\nDifferent dishes such as pizzas baked in wood-fired oven, salad menu, pastas,  meat and fish."
    ],
    "it": [
      "Il ristorante La Casa offre cucina francese e italiana, pizze cotte a legna, un menu di insalate, pasta, carne e pesce. All'esterno si trova una terrazza con area salotto."
    ],
    "fr": [
      "Le restaurant La Casa propose une cuisine Française et Italienne, pizzas au feu de  bois, une carte de salades, pâtes, viandes et poissons. En extérieur une terrasse avec un coin salon."
    ],
    "nl": [
      "Het restaurant La Casa biedt een keuken met franse en italiaanse gerechten , pizza op houtvuur, vele verschillende salades, pasta, vlees en vis gerechten."
    ],
    "es": [
      "El restaurante La Casa ofrece una cocina francesa e italiana, pizzas al fuego de leña, y una carta de ensaladas, pastas, carnes y pescados."
    ]
  },
