  "rdfs:comment": {
    "de": [
      "Die Mediathek ist frei zugänglich und bietet Sammlungen für jeden Geschmack und jedes Alter. Sie bietet ein reichhaltiges und abwechslungsreiches Programm an Veranstaltungen und Aktivitäten."
    ],
    "en": [
      "The media library is open to all, with collections to suit all tastes and ages. It offers a rich and varied program of events and activities."
    ],
    "it": [
      "La mediateca è aperta a tutti, con collezioni adatte a tutti i gusti e a tutte le età. Offre un programma ricco e vario di eventi e attività."
    ],
    "fr": [
      "La médiathèque est en accès libre et propose des collections pour tous les goûts et tous les âges. Elle offre un programme d'événements et d'activités riche et varié."
    ],
    "es": [
      "La mediateca está abierta a todos, con colecciones para todos los gustos y edades. Ofrece un rico y variado programa de actos y actividades."
    ],
    "nl": [
      "De mediatheek is voor iedereen toegankelijk, met collecties voor alle smaken en leeftijden. Ze biedt een rijk en gevarieerd programma van evenementen en activiteiten."
    ]
  },
