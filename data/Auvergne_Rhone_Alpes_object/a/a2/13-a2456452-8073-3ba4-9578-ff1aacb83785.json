  "rdfs:comment": {
    "de": [
      "Avenue des Isles, das Arboretum, das durch den Parc de la Rigolée verlängert wird, bildet einen grünen Raum, der zur Entspannung und zum Spazierengehen einlädt. Spiele für Kinder. Gesundheitsparcours."
    ],
    "en": [
      "Avenue des Isles, the arboretum extended by the Parc de la Rigolée is a green space ideal for relaxing and strolling. Children's playground. Fitness trail."
    ],
    "it": [
      "In Avenue des Isles, l'arboreto, ampliato dal parco Rigolée, è uno spazio verde lussureggiante ideale per rilassarsi e passeggiare. Parco giochi per bambini. Percorso fitness."
    ],
    "fr": [
      "Avenue des Isles, l'arboretum prolongé par le parc de la Rigolée compose un espace verdoyant propice à la détente et à la promenade. Jeux pour enfants. Parcours santé."
    ],
    "nl": [
      "Op de Avenue des Isles is het arboretum, uitgebreid met het Rigolée park, een weelderige groene ruimte ideaal om te ontspannen en te wandelen. Kinderspeelplaats. Fitnessparcours."
    ],
    "es": [
      "En la Avenue des Isles, el arboreto, prolongado por el parque de la Rigolée, es un exuberante espacio verde ideal para relajarse y pasear. Parque infantil. Pista de fitness."
    ]
  },
