  "rdfs:comment": {
    "de": [
      "Artissima ist eine Privatsammlung, die in den Mauern einer alten Mühle aus goldenem Stein untergebracht ist. Hier werden fast 200 Werke ausgestellt, die die Sensibilität von französischen und internationalen Künstlern widerspiegeln."
    ],
    "en": [
      "Artissima is a private collection of contemporary art housed within the walls of a gilded stone mill on the banks of the Saône river. This venue reveals a renewed display of nearly 200 works, celebrating the sensibilities of French and international artists."
    ],
    "it": [
      "Artissima è una collezione privata ospitata tra le mura di un antico mulino in pietra dorata. Presenta un'esposizione di quasi 200 opere che celebrano la sensibilità di artisti francesi e internazionali."
    ],
    "fr": [
      "Artissima est une collection privée installée dans les murs d'un ancien moulin en pierres dorées. Ce lieu révèle un accrochage de près de 200 œuvres, qui célèbrent la sensibilité d’artistes français et internationaux."
    ],
    "nl": [
      "Artissima is een privéverzameling binnen de muren van een oude molen van gouden steen. Er worden bijna 200 werken tentoongesteld die de gevoeligheden van Franse en internationale kunstenaars vieren."
    ],
    "es": [
      "Artissima es una colección privada albergada entre los muros de un antiguo molino de piedra dorada. Presenta una muestra de casi 200 obras, que celebran la sensibilidad de artistas franceses e internacionales."
    ]
  },
