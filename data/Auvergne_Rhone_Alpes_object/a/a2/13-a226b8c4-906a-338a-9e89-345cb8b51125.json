  "rdfs:comment": {
    "de": [
      "Erleben Sie Close-up-Tischzauberei und Bühnenauftritte mit den Magiciens du Velay und der Teilnahme der Schüler des Zauberworkshops des MJC."
    ],
    "en": [
      "Come and enjoy close-up and stage magic with Les Magiciens du Velay and students from the MJC?s magic workshop."
    ],
    "it": [
      "Venite a vedere trucchi di magia da vicino su tavoli e numeri da palcoscenico, con i Magiciens du Velay e gli studenti del laboratorio di magia del MJC."
    ],
    "fr": [
      "Venez assister à des tours de magie sur tables « close-up » et des numéros de scène, avec les Magiciens du Velay et la participation des élèves de l’atelier « magie » de la MJC."
    ],
    "es": [
