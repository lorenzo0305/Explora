  "rdfs:comment": {
    "de": [
      "SIVALOR ist ein EPCI (Etablissement Public de Coopération Intercommunale).\r\nSein Name bedeutet Syndicat Intercommunal de VALORisation des déchets (Interkommunaler Verband zur Verwertung von Abfällen). Er ist in einem Gebiet tätig, das aus 163 Gemeinden in den Departements Ain und Haute-Savoie besteht."
    ],
    "en": [
      "SIVALOR is an EPCI (public establishment for inter-municipal cooperation).\r\nIts name stands for Syndicat Intercommunal de VALORisation des déchets (Inter-municipal Waste Recovery Association). It operates across an area comprising 163 municipalities in the Ain and Haute-Savoie departments."
    ],
    "it": [
      "SIVALOR è un EPCI (Etablissement Public de Coopération Intercommunale).\r\nIl suo nome sta per Syndicat Intercommunal de VALORisation des déchets. Copre un territorio di 163 comuni nei dipartimenti dell'Ain e dell'Alta Savoia."
    ],
    "fr": [
      "Le SIVALOR est un EPCI (Etablissement Public de Coopération Intercommunale).\r\nSon nom signifie Syndicat Intercommunal de VALORisation des déchets. Il intervient sur un territoire composé de 163 communes dans l'Ain et la Haute-Savoie."
    ],
    "nl": [
      "SIVALOR is een EPCI (Etablissement Public de Coopération Intercommunale).\r\nDe naam staat voor Syndicat Intercommunal de VALORisation des déchets. Het bestrijkt een gebied van 163 gemeenten in de departementen Ain en Haute-Savoie."
    ],
    "es": [
      "SIVALOR es un EPCI (Etablissement Public de Coopération Intercommunale).\r\nSu nombre significa Syndicat Intercommunal de VALORisation des déchets. Abarca un territorio de 163 municipios de los departamentos de Ain y Alta Saboya."
    ]
  },
