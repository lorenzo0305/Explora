  "rdfs:comment": {
    "de": [
      "Entdecken Sie in den engen Gassen die Perlen der Altstadt von Valence.\r\nHolen Sie sich den Stadtplan im Office de Tourisme auf den Boulevards ab, bevor Sie Ihren Spaziergang beginnen!"
    ],
    "en": [
      "Discover the gems of Valence's old town along its narrow streets.\nPick up a map of the town at the Tourist Office on the boulevards before you set off!"
    ],
    "it": [
      "Scoprite le gemme del centro storico di Valence passeggiando per le sue stradine.\r\nPrima di partire, ritirate una mappa della città presso l'Ufficio del Turismo sui viali!"
    ],
    "fr": [
      "Au fil de ses ruelles, découvrez les perles du centre-ancien de Valence. \r\nVenez récupérer le plan découverte de la ville à l'Office de Tourisme situé sur les boulevards avant de commencer votre balade !"
    ],
    "nl": [
      "Ontdek de juweeltjes van de oude binnenstad van Valence terwijl je door de smalle straatjes dwaalt.\nHaal een plattegrond van de stad bij het VVV-kantoor op de boulevards voordat je aan je wandeling begint!"
    ],
    "es": [
      "Descubra las joyas del casco antiguo de Valence paseando por sus callejuelas.\r\nAntes de salir, coge un plano de la ciudad en la Oficina de Turismo de los bulevares"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Centre historique de Valence"
    ]
  },
