  "rdfs:comment": {
    "de": [
      "Spezialität: Gegrilltes und Salate. Menü+Karte am Mittag, Vorspeisenbuffet. Menü und Tagesgericht unter der Woche. Restaurant im Stadtzentrum gelegen."
    ],
    "en": [
      "The specialities are grilled meat and fish and salads. Set menu + 'à la carte' at lunchtimes, buffet of appetisers. Set menu and dish of the day during the week. Restaurant in the town centre."
    ],
    "it": [
      "Specialità di carne alla griglia e insalate. Menu+carta a pranzo, buffet di antipasti. Menu e piatto del giorno durante la settimana. Ristorante situato nel centro della città."
    ],
    "fr": [
      "Spécialité de grillades et de salades. Menu+carte le midi, buffet de hors-d'oeuvres. Menu et plat du jour en semaine. Restaurant situé en centre ville."
    ],
    "nl": [
      "Specialiteit van gegrild vlees en salades. Menu+kaart tijdens de lunch, hors d'oeuvres buffet. Menu en dagschotel van de week. Restaurant gelegen in het centrum van de stad."
    ],
    "es": [
      "Especialidad en carnes a la brasa y ensaladas. Menú+tarjeta a la hora de comer, buffet de entremeses. Menú y plato del día durante la semana. Restaurante situado en el centro de la ciudad."
    ]
  },
  "rdfs:label": {
    "en": [
