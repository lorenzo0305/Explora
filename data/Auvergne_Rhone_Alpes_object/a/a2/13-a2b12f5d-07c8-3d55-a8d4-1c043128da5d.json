  "rdfs:comment": {
    "de": [
      "13 Tische am Flussufer in einem baumbestandenen Rahmen. In der Nähe einer Wasserstelle und eines öffentlichen WCs ganz in der Nähe. Neben dem Parkplatz des Palais idéal."
    ],
    "en": [
      "13 tables by the river, in a wooded setting. Close to a watering hole and public toilet. Next to the Palais idéal parking lot."
    ],
    "it": [
      "13 tavoli in riva al fiume, in un ambiente boscoso. Vicino a un punto d'acqua pubblico e a una toilette. Vicino al parcheggio del Palais idéal."
    ],
    "fr": [
      "13 tables au bord de la rivière, dans un cadre arboré. Proche d'un point d'eau et wc publics tout proche. A côté du parking du Palais idéal."
    ],
    "nl": [
      "13 tafels bij de rivier, in een bosrijke omgeving. Vlakbij een openbaar waterpunt en toilet. Naast de parkeerplaats van Palais idéal."
    ],
    "es": [
      "13 mesas junto al río, en un entorno arbolado. Cerca de un punto de agua y aseos públicos. Junto al aparcamiento del Palais idéal."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Aire de pique-nique"
    ]
