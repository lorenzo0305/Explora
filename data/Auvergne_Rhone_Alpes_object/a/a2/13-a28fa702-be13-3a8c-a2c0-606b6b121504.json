  "rdfs:comment": {
    "de": [
      "in \"Jeux trinque\" finden Sie zahlreiche Brettspiele, aber auch Billard, Tischfußball, Flipper und eine vernetzte Dartscheibe."
    ],
    "en": [
      "\"Jeux Trinque\". Come and enjoy our famous games like billiards, baby-foot, connected dart games..."
    ],
    "it": [
      "\"Venite a divertirvi con i nostri numerosi e iconici giochi da tavolo, oltre a biliardo, calcio balilla, flipper e un bersaglio per le freccette collegato."
    ],
    "fr": [
      "« Jeux trinque » venez profiter de nos nombreux jeux de plateau emblématiques mais également, billards, baby-foot, flipper, ainsi qu’un jeu de fléchettes connecté."
    ],
    "es": [
      "\"Venga a disfrutar de nuestros numerosos e icónicos juegos de mesa, así como del billar, el futbolín, el pinball y un tablero de dardos conectado."
    ],
    "nl": [
      "\"Jeux trinque\". Kom van de vele emblematische gezelschapsspelletjes genieten, maar ook van de biljarttafels, de babyvoetbaltafel en het elektronische dartspel."
    ]
  },
