  "rdfs:comment": {
    "de": [
      "Unsere Leidenschaft \" Der Geschmack auf natürliche Weise \".\r\nDurch die Verbindung unserer Ansprüche und unserer Professionalität präsentieren wir Ihnen heute die Magie des handwerklich hergestellten Speiseeises!"
    ],
    "en": [
      "Our passion: \"Natural taste\r\nBy combining our high standards with our professionalism, we are able to bring you the magic of artisanal ice cream!"
    ],
    "it": [
      "La nostra passione: \"Gusto naturale\r\nÈ unendo le nostre esigenze e la nostra professionalità che oggi vi presentiamo la magia del gelato artigianale!"
    ],
    "fr": [
      "Notre passion   « Le goût au naturel »\r\nC’est en alliant nos exigences et notre professionnalisme que nous vous présentons aujourd’hui la magie des glaces artisanales !"
    ],
    "nl": [
      "Onze passie: \"Natuurlijke smaak\r\nDoor onze hoge normen te combineren met onze professionaliteit, kunnen we u nu de magie van zelfgemaakt ijs brengen!"
    ],
    "es": [
      "Nuestra pasión: \"El sabor natural\r\nCombinando nuestra exigencia y nuestra profesionalidad, ¡le presentamos hoy la magia de los helados artesanales!"
    ]
  },
