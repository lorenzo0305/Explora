  "rdfs:comment": {
    "de": [
      "Die Bibliothek befindet sich im Park des Rathauses und bietet neben Büchern auch DVDs zum Ausleihen an. Sie ist Teil des Bibliotheksnetzes von Grésivaudan."
    ],
    "en": [
      "The library is located in the grounds of the town hall and has book and DVDs available on loan. It is part of the Grésivaudan library network."
    ],
    "it": [
      "La biblioteca si trova nel parco del municipio e presta libri e DVD. Fa parte della rete bibliotecaria di Grésivaudan."
    ],
    "fr": [
      "La bibliothèque se situe dans le parc de la mairie et propose des prêts de livres mais aussi de DVD. Elle fait partie du réseau des bibliothèques du Grésivaudan."
    ],
    "es": [
      "La biblioteca está situada en el recinto del ayuntamiento y presta libros y DVD. Forma parte de la red de bibliotecas de Grésivaudan."
    ],
    "nl": [
      "De bibliotheek bevindt zich op het terrein van het gemeentehuis en je kunt er boeken en dvd's lenen. Het maakt deel uit van het bibliotheeknetwerk Grésivaudan."
    ]
  },
