  "rdfs:comment": {
    "de": [
      "Das Team empfängt Sie in einer landschaftlich reizvollen Umgebung ganz in der Nähe Ihres Zuhauses\r\nTerrasse mit Panoramablick auf die Teiche. Speisekarte und Themenabende im Rhythmus der Jahreszeiten. Im Sommer serviert das Lokal täglich Frühstück."
    ],
    "en": [
      "Stéphane welcomes you in an exotic setting just a stone's throw from your home.\r\nTerrace with panoramic view on the ponds. Menu and theme evenings set to the rhythm of the seasons. The establishment serves daily breakfasts in summer."
    ],
    "it": [
      "Il team vi accoglie in un ambiente esotico a pochi passi da casa vostra.\r\nTerrazza con vista panoramica sui laghi. Menu stagionale e serate a tema. Il ristorante serve colazioni giornaliere in estate."
    ],
    "fr": [
      "L'équipe vous accueille dans un cadre dépaysant à deux pas de chez vous. \r\nTerrasse avec vue panoramique sur les étangs. Carte et soirées à thème rythmées par les saisons. L'établissement sert quotidiennement des petits déjeuners l'été."
    ],
    "nl": [
      "Het team heet je welkom in een exotische omgeving op een steenworp afstand van je huis.\r\nTerras met panoramisch uitzicht over de meren. Seizoensmenu en thema-avonden. Het restaurant serveert dagelijks ontbijt in de zomer."
    ],
    "es": [
      "El equipo le da la bienvenida a un entorno exótico a tiro de piedra de su casa.\r\nTerraza con vistas panorámicas a los lagos. Menú de temporada y veladas temáticas. El restaurante sirve desayunos diarios en verano."
    ]
  },
