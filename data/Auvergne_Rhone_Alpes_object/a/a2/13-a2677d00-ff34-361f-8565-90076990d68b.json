  "rdfs:comment": {
    "de": [
      "Die Familie CHAPELAT ist seit 1670 in Saint Rémy-Sur-Durolle ansässig. Die Familie CHAPELAT war zuvor eine Familie von Stumpfmachern und 1670 wurde die Messerschmiede von François CHAPELAT gegründet."
    ],
    "en": [
      "The CHAPELAT family has been making cutlery in Saint Rémy-Sur-Durolle since 1670. Before that, they were a family of grinders, and it was in 1670 that François CHAPELAT founded the cutlery business."
    ],
    "it": [
      "La famiglia CHAPELAT produce posate a Saint Rémy-Sur-Durolle dal 1670, prima era una famiglia di arrotini e nel 1670 François CHAPELAT creò le posate."
    ],
    "fr": [
      "Coutellerie implantée depuis 1670 à Saint Rémy-Sur-Durolle, la famille CHAPELAT était avant cela une famille d’émouleur et c’est en 1670 que la coutellerie fut crée par François CHAPELAT."
    ],
    "es": [
      "La familia CHAPELAT fabrica cuchillería en Saint Rémy-Sur-Durolle desde 1670. Antes, eran una familia de afiladores, y fue en 1670 cuando François CHAPELAT creó la cuchillería."
    ],
    "nl": [
      "De familie CHAPELAT maakt al sinds 1670 bestek in Saint Rémy-Sur-Durolle. Daarvoor waren ze een familie van slijpers en in 1670 werd het bestek gemaakt door François CHAPELAT."
    ]
  },
  "rdfs:label": {
