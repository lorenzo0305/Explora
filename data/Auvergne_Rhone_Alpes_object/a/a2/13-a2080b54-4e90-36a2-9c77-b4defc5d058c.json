  "rdfs:comment": {
    "de": [
      "Seit 2012 ist er selbstständig in der Glasgravur tätig. Er zähmt ganz fein die Technik der Gravur mit Diamantspitze auf allen Glasträgern: Karaffen, Gläser, Flaschen, Vasen auch Trophäen aus Glas."
    ],
    "en": [
      "Self-entrepreneur in glass engraving since 2012, he has mastered the technique of diamond point engraving on all glass supports: carafes, glasses, bottles, vases, also glass trophies."
    ],
    "it": [
      "Libero professionista nell'incisione del vetro dal 2012, doma la tecnica dell'incisione a punta di diamante su qualsiasi supporto in vetro: caraffe, bicchieri, bottiglie, vasi e anche trofei in vetro."
    ],
    "fr": [
      "Auto-entrepreneur dans la gravure sur verre depuis 2012, il apprivoise tout en finesse la technique de gravure à la pointe de diamant sur tout support en verre : carafes, verres, bouteilles, vases également trophées en verres."
    ],
    "es": [
      "Autónomo del grabado en vidrio desde 2012, domina la técnica del grabado en punta de diamante sobre cualquier soporte de vidrio: garrafas, vasos, botellas, jarrones y también trofeos de vidrio."
    ],
    "nl": [
      "Als zelfstandig glasgraveur sinds 2012 beheerst hij de techniek van de diamantpuntgravure op elke glazen drager: karaffen, glazen, flessen, vazen en ook glazen trofeeën."
    ]
  },
  "rdfs:label": {
    "fr": [
      "TGRAV Graveur sur verre"
    ]
  },
