  "rdfs:comment": {
    "de": [
      "Das Hotelrestaurant ist ideal gelegen, nur wenige Meter vom SNCF-Bahnhof Valence-Ville, der Place Aristide Briand und dem Kiosk Peynet entfernt, der den Parc Jouvet überblickt."
    ],
    "en": [
      "Ideally located, just a few meters from the Valence-Ville SNCF train station, Place Aristide Briand and the Kiosque Peynet overlooking Parc Jouvet, the hotel's restaurant is the perfect place for dinners or evenings out."
    ],
    "it": [
      "Situato in posizione ideale, a pochi metri dalla stazione ferroviaria di Valence-Ville, da Place Aristide Briand e dal Kiosque Peynet con vista sul Parc Jouvet, il ristorante dell'hotel è il luogo ideale per le vostre cene o soste serali."
    ],
    "fr": [
      "Bénéficiant d'un emplacement idéal, à quelques mètres de la gare SNCF Valence-Ville, de la Place Aristide Briand et du Kiosque Peynet dominant le Parc Jouvet, le restaurant de l'hôtel est le lieu parfait pour vos dîners ou soirées étapes."
    ],
    "nl": [
      "Het restaurant van het hotel heeft een ideale ligging, op slechts een paar meter van het SNCF-station Valence-Ville, de Place Aristide Briand en de Peynet Kiosk met uitzicht op het Parc Jouvet, en is de perfecte plek voor uw diners of avondjes uit."
    ],
    "es": [
      "Con una ubicación ideal, a pocos metros de la estación de tren de Valence-Ville, la plaza Aristide Briand y el Kiosco Peynet con vistas al Parque Jouvet, el restaurante del hotel es el lugar perfecto para sus cenas o paradas nocturnas."
    ]
  },
  "rdfs:label": {
