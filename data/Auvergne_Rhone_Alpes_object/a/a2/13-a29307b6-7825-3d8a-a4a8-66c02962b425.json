  "rdfs:comment": {
    "de": [
      "Vor etwa 1,9 Millionen Jahren senkte sich in der Verlängerung der Vulkankette von Devès ein Lavastrom aus dem Schlackenkegel von Pié-Rouge in das Tal des Allier."
    ],
    "en": [
      "Around 1.9 million years ago, in the extension of the Devès volcanic chain, a lava flow from the Pié-Rouge slag cone descended into the Allier valley."
    ],
    "it": [
      "Circa 1,9 milioni di anni fa, nell'estensione della catena vulcanica del Devès, una colata lavica proveniente dal cono di scorie di Pié-Rouge scese nella valle dell'Allier."
    ],
    "fr": [
      "Il y a environ 1,9 million d'années, dans le prolongement de la chaîne volcanique du Devès, une coulées de lave issue du cône de scories du Pié-Rouge descend dans la vallée de l'Allier."
    ],
    "nl": [
      "Ongeveer 1,9 miljoen jaar geleden, in het verlengde van de vulkanische keten van Devès, daalde een lavastroom van de Pié-Rouge slakkenkegel af in de vallei van de Allier."
    ],
    "es": [
      "Hace aproximadamente 1,9 millones de años, en la prolongación de la cadena volcánica de Devès, una colada de lava procedente del cono de escorias de Pié-Rouge descendió hasta el valle del Allier."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Volcan du Pié Rouge"
    ]
  },
