  "rdfs:comment": {
    "de": [
      "Tigmi ist eine Einladung, die marokkanische Gastronomie in Grenoble zu entdecken. Wenn Sie die Schwelle überschreiten, werden Sie von einer Mischung aus exotischen Aromen eingehüllt, die von der Reichhaltigkeit der marokkanischen Gerichte zeugen."
    ],
    "en": [
      "Tigmi is an invitation to discover Moroccan gastronomy in Grenoble. As you cross the threshold, you will be enveloped by a mixture of exotic aromas, witnesses to the richness of Moroccan dishes."
    ],
    "it": [
      "Tigmi è un invito a scoprire la gastronomia marocchina a Grenoble. Varcando la soglia, sarete avvolti da una miscela di aromi esotici che testimoniano la ricchezza dei piatti marocchini."
    ],
    "fr": [
      "Tigmi est une invitation à la découverte de la gastronomie marocaine à Grenoble. En franchissant le seuil, vous serez enveloppé par un mélange d'arômes exotiques, témoins de la richesse des plats marocains."
    ],
    "nl": [
      "Tigmi is een uitnodiging om de Marokkaanse gastronomie in Grenoble te ontdekken. Als je over de drempel stapt, word je omringd door een mix van exotische aroma's die getuigen van de rijkdom van Marokkaanse gerechten."
    ],
    "es": [
      "Tigmi es una invitación a descubrir la gastronomía marroquí en Grenoble. Al cruzar el umbral, le envolverá una mezcla de aromas exóticos, testigo de la riqueza de los platos marroquíes."
    ]
  },
  "rdfs:label": {
