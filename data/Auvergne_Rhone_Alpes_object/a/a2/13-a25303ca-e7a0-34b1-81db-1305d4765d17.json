    "de": [
      "Panoramaterrasse des städtischen Schwimmbads mit Blick auf das Dorf: Pommes frites - Gegrilltes - Sandwiches - Waffeln - Eis - Getränke - Vor Ort oder zum Mitnehmen."
    ],
    "en": [
      "Panoramic terrace overlooking the village: French fries - Grilled meats - Sandwiches - Waffles - Ice cream - Drinks - On the spot or to take away."
    ],
    "it": [
      "Terrazza panoramica presso la piscina comunale con vista sul paese: Patatine fritte - Carne alla griglia - Panini - Cialde - Gelati - Bevande - Da mangiare o da portare via."
    ],
    "fr": [
      "Terrasse panoramique de la Piscine Municipale avec vue sur le village : Frites - Grillades - Sandwiches - Gaufres - Glaces - Boissons - Sur place ou à emporter."
    ],
    "es": [
      "Terraza panorámica en la piscina municipal con vistas al pueblo: Patatas fritas - Carnes a la brasa - Bocadillos - Gofres - Helados - Bebidas - Para comer en casa o para llevar."
    ],
    "nl": [
      "Panoramaterras bij het gemeentelijk zwembad met uitzicht op het dorp: Chips - Gegrilde vleeswaren - Sandwiches - Wafels - IJsjes - Drankjes - Om te eten of om mee te nemen."
    ]
  },
