  "rdfs:comment": {
    "de": [
      "Home Sweet Holidays, Concierge-Service.\r\nDie Verbindung von Freundlichkeit, Professionalität und Nähe eines maßgeschneiderten Service, der sowohl Urlaubern als auch Geschäftsleuten und Eigentümern mit privatem Komfort vorbehalten ist."
    ],
    "en": [
      "Home Sweet Holidays, private Concierge Service\r\nThe perfect blend of friendliness, professionalism, and personalized service, tailored for vacationers, professionals, and property owners, all within a private and comfortable setting."
    ],
    "it": [
      "Home Sweet Holidays, servizio di concierge.\r\nLa combinazione di cordialità, professionalità e vicinanza di un servizio su misura riservato a vacanzieri, professionisti e proprietari in un comfort privato."
    ],
    "fr": [
      "Home Sweet Holidays, Service de conciergerie.\r\nL'alliance de la convivialité, le professionnalisme et la proximité d'un service sur mesure réservés à la fois aux vacanciers, professionnels et propriétaires dans un confort privé."
    ],
    "es": [
      "Home Sweet Holidays, servicio de conserjería.\r\nLa combinación de amabilidad, profesionalidad y proximidad de un servicio a medida reservado a veraneantes, profesionales y propietarios en privado."
    ],
    "nl": [
      "Home Sweet Holidays, Conciërgedienst.\r\nDe combinatie van vriendelijkheid, professionaliteit en nabijheid van een service op maat, gereserveerd voor vakantiegangers, professionals en eigenaars in privécomfort."
    ]
  },
