  "rdfs:comment": {
    "de": [
      "Die Auberge de la Paillère bietet Ihnen die althergebrachte Spezialität Froschschenkel des Hauses nach Art von Suzanne (Rezept von 1967), ergänzt durch eine saisonale Speisekarte, die die Produkte der Region Bugey in den Vordergrund stellt."
    ],
    "en": [
      "The \"Auberge de la Paillère\" offers you the ancestral specialty of frog's legs of the house Suzanne style (recipe of 1967) with a seasonal menu highlighting the products of the Bugey."
    ],
    "it": [
      "L'Auberge de la Paillère vi propone la tradizionale specialità delle cosce di rana alla Suzanne (ricetta del 1967), completata da un menu stagionale con prodotti della regione di Bugey."
    ],
    "fr": [
      "L'Auberge de la Paillère vous propose la spécialité ancestrale de cuisses de grenouilles de la maison façon Suzanne (recette de 1967) agrémentée d'une carte saisonnière mettant en avant les produits du Bugey."
    ],
    "es": [
      "El Auberge de la Paillère le ofrece la especialidad tradicional de ancas de rana al estilo de Suzanne (receta de 1967), complementada con un menú de temporada con productos de la región de Bugey."
    ],
    "nl": [
      "De Auberge de la Paillère biedt u de traditionele kikkerbillenspecialiteit op Suzanne wijze (recept uit 1967), aangevuld met een seizoensmenu met producten uit de streek van Bugey."
    ]
  },
