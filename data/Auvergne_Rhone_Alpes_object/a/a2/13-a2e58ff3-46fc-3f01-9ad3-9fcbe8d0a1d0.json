  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Welt des Restaurants Le Pérou in Form von Drinks und Tapas.  Diese Loungebar im ehemaligen Bahnhof von Saint Béron - La Bridoire Savoie entführt Sie mit hausgemachten Cocktails und Tapas in die peruanische Welt."
    ],
    "en": [
      "Discover the world of Le Pérou restaurant, in a drinks & tapas version.  Housed in the former train station at Saint Béron - La Bridoire Savoie, this lounge bar plunges you into the Peruvian world with its handcrafted cocktails and homemade tapas."
    ],
    "it": [
      "Scoprite il mondo del ristorante Le Pérou, in versione drink e tapas.  Ospitato nell'antica stazione ferroviaria di Saint Béron - La Bridoire Savoie, questo lounge bar vi immerge nel mondo del Perù con i suoi cocktail e le sue tapas fatte in casa."
    ],
    "fr": [
      "Retrouvez l'univers du restaurant Le Pérou, décliné en version drinks & tapas.  Installé dans l'ancienne gare de Saint Béron - La Bridoire Savoie, ce lounge bar vous plonge dans l'univers péruvien grâce à ses cocktails artisanaux et tapas maison."
    ],
    "nl": [
      "Ontdek de wereld van restaurant Le Pérou, in een drank- en tapasversie.  Deze loungebar, gevestigd in het oude treinstation van Saint Béron - La Bridoire Savoie, dompelt je onder in de wereld van Peru met zijn huisgemaakte cocktails en tapas."
    ],
    "es": [
      "Descubra el mundo del restaurante Le Pérou, en versión copas y tapas.  Instalado en la antigua estación de tren de Saint Béron - La Bridoire Savoie, este lounge bar le sumerge en el mundo de Perú con sus cócteles y tapas caseros."
    ]
  },
  "rdfs:label": {
