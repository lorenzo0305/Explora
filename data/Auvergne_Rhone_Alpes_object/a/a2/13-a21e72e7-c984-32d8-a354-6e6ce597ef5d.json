  "rdfs:comment": {
    "de": [
      "Um zu essen oder eine Pause zu machen, täglich von 6.30 bis 19.00 Uhr!\r\nWir verfügen über einen Speiseraum mit Wi-Fi.\r\nFür mehr Auswahl und Schnelligkeit: Click and Collect auf www.etape-gourmande.fr"
    ],
    "en": [
      "To eat or take a break from 6:30 am to 7:00 pm every day!\r\nWe have a catering room with Wi-fi.\r\nFor more choice and speed : click and collect on www.etape-gourmande.fr"
    ],
    "it": [
      "Per mangiare o fare una pausa dalle 6.30 alle 19 ogni giorno!\r\nDisponiamo di una sala catering con wi-fi.\r\nPer una maggiore scelta e velocità: click and collect su www.etape-gourmande.fr"
    ],
    "fr": [
      "Pour vous restaurer ou faire une pause de 6h30 à 19h00 tous les jours !\r\nNous disposons d’une salle de restauration avec Wi-fi.\r\nPour plus de choix et de rapidité : click and collect sur www.etape-gourmande.fr"
    ],
    "es": [
      "Para comer o hacer una pausa de 6.30 a 19.00 horas todos los días\r\nDisponemos de una sala de restauración con Wi-fi.\r\nPara más opciones y rapidez: click and collect en www.etape-gourmande.fr"
    ],
    "nl": [
      "Om elke dag van 6.30 tot 19.00 uur te eten of te pauzeren!\r\nWe hebben een cateringruimte met Wi-fi.\r\nVoor meer keuze en snelheid: click and collect op www.etape-gourmande.fr"
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'Etape Gourmande"
