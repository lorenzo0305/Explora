  "rdfs:comment": {
    "de": [
      "Auf die Bedürfnisse der Eigentümer von Mietobjekten für kurze Zeiträume eingehen, den saisonalen Mietern Erlebnisse bieten (Entspannung, Gastronomie, Sport, Kulturerbe, Workshops zur Kreation von Cocktails...)."
    ],
    "en": [
      "Conciergerie service for vacationers, secondary residents, holiday home owners, groups and businesses. Our concierge service adapts to your needs and continues to evolve to offer you quality services."
    ],
    "it": [
      "Rispondere alle esigenze dei proprietari di immobili in affitto a breve termine, offrendo agli affittuari stagionali una serie di esperienze (relax, gastronomia, sport, patrimonio, laboratori di creazione di cocktail, ecc.)"
    ],
    "fr": [
      "Répondre aux besoins des propriétaires de biens locatifs de courtes durées, faire vivre des expériences aux locataires saisonniers (détente, gastronomie, sport, patrimoine, ateliers création de cocktails...)."
    ],
    "nl": [
      "Voldoe aan de behoeften van eigenaars van kortdurende huuraccommodaties en bied seizoenshuurders een scala aan ervaringen (ontspanning, gastronomie, sport, erfgoed, cocktailworkshops, enz.)."
    ],
    "es": [
      "Responder a las necesidades de los propietarios de viviendas de alquiler de corta duración, ofreciendo a los inquilinos de temporada un abanico de experiencias (descanso, gastronomía, deporte, patrimonio, talleres de creación de cócteles, etc.)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Conciergerie de tourisme TIMA"
    ]
  },
