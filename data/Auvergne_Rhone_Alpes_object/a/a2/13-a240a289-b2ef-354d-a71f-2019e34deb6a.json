  "rdfs:comment": {
    "de": [
      "Im Stadtzentrum von Valence bietet das römische Kollektiv l'Artisanoscope dem Publikum einen Einblick in die kreative Welt von rund 20 lokalen Kunsthandwerkern."
    ],
    "en": [
      "In downtown Valence, the Roman collective l'Artisanoscope invites the public to discover the creative universe of some twenty local artisans."
    ],
    "it": [
      "Nel centro di Valence, il collettivo romano l'Artisanoscope offre al pubblico la possibilità di scoprire il mondo creativo di una ventina di artigiani locali."
    ],
    "fr": [
      "En centre-ville de Valence, le collectif romanais l'Artisanoscope propose au public de découvrir l'univers créatif d'une vingtaine d'artisans locaux."
    ],
    "nl": [
      "In het centrum van Valence biedt het Romeinse collectief l'Artisanoscope het publiek de kans om de creatieve wereld van een twintigtal lokale ambachtslieden te ontdekken."
    ],
    "es": [
      "En el centro de Valence, el colectivo romano l'Artisanoscope ofrece al público la posibilidad de descubrir el universo creativo de una veintena de artesanos locales."
    ]
  },
