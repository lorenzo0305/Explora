  "rdfs:comment": {
    "de": [
      "Taufe Paragliding\r\n\r\nFür alle zugänglich, von 5 bis 90 Jahren, maximal 90 kg, zögern Sie nicht, diese Aktivität zu entdecken, die Sie zum Träumen bringen wird."
    ],
    "en": [
      "Paragliding Baptism\r\n\r\nAccessible to all, from 5 to 90 years old, maximum 90 kg, don't hesitate to come and discover this activity that will make you dream."
    ],
    "it": [
      "Battesimo del parapendio\r\n\r\nAccessibile a tutti, dai 5 ai 90 anni, massimo 90 kg, non esitate a venire a scoprire questa attività che vi farà sognare."
    ],
    "fr": [
      "Baptême Parapente\r\n\r\nAccessible à tous, de 5 à 90 ans, maximum 90 kg , n’hésitez plus à venir découvrir cette activité qui vous fera rêver."
    ],
    "nl": [
      "Paragliding Doop\r\n\r\nToegankelijk voor iedereen, van 5 tot 90 jaar, maximaal 90 kg, aarzel niet om deze activiteit te komen ontdekken die je zal doen dromen."
    ],
    "es": [
      "Bautismo de parapente\r\n\r\nAccesible a todos, de 5 a 90 años, máximo 90 kg, no dudes en venir a descubrir esta actividad que te hará soñar."
    ]
  },
