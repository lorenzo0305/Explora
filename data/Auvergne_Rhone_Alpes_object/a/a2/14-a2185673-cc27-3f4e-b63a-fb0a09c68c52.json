  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/5ec8c2f3-d4e5-3b2e-a218-bab8301b6d93",
      "dc:description": {
        "de": [
          "Le Marchand de Sable ist ein Touristenladen, der sich nur wenige Schritte vom Strand entfernt befindet.\nDieser warme und freundliche Laden ist auf den Verkauf von Strandartikeln, Meeresartikeln, Geschenken und Souvenirs spezialisiert."
        ],
        "en": [
          "Le Marchand de Sable is a tourist store located just a stone's throw from the beach.\nThis warm and friendly boutique specializes in the sale of beach and marine items, gifts and souvenirs."
        ],
        "it": [
          "Le Marchand de Sable è un negozio turistico situato a pochi passi dalla spiaggia.\nQuesto negozio accogliente e cordiale è specializzato nella vendita di articoli da spiaggia e marini, regali e souvenir."
        ],
        "fr": [
          "Le Marchand de Sable est une boutique touristique située à deux pas de la plage. \nCette boutique chaleureuse et conviviale est spécialiée dans la vente d'articles de plage, d'articles marins, de cadeaux et de souvenirs."
        ],
        "nl": [
          "Le Marchand de Sable is een toeristenwinkel op een steenworp afstand van het strand.\nDeze warme en vriendelijke winkel is gespecialiseerd in de verkoop van strand- en zeeartikelen, cadeaus en souvenirs."
        ],
        "es": [
          "Le Marchand de Sable es una tienda turística situada a dos pasos de la playa.\nEsta cálida y acogedora tienda está especializada en la venta de artículos de playa y marinos, regalos y recuerdos."
        ]
      },
      "@type": [
        "Description"
