  "rdfs:comment": {
    "de": [
      "Die Imker Céline Leynaud und Jérôme Debard laden Sie ein, ihre Leidenschaft für die Bienen zu teilen und einen geselligen Moment bei einer Verkostung der Produkte des Bauernhofs zu genießen: Nougat, Lebkuchen, Honigkekse, Fruchtsäfte etc."
    ],
    "en": [
      "Beekeepers Céline Leynaud and Jérôme Debard invite you to share their passion for bees and enjoy a tasting of the farm's products: nougats, gingerbread, honey biscuits, fruit juices and more."
    ],
    "it": [
      "Gli apicoltori Céline Leynaud e Jérôme Debard vi invitano a condividere la loro passione per le api e a vivere un momento di convivialità attorno a una degustazione dei prodotti della fattoria: torroni, pan di zenzero, biscotti al miele, succhi di frutta ecc."
    ],
    "fr": [
      "Apiculteurs, Céline  Leynaud et Jérôme Debard vous invitent à partager leur passion pour les abeilles et profiter d'un moment convivial autour d'une dégustation des produits de la ferme : nougats, pain d'épices, biscuits au miel, jus de fruits etc."
    ],
    "es": [
      "Los apicultores Céline Leynaud y Jérôme Debard le invitan a compartir su pasión por las abejas y a disfrutar de un momento de convivencia en torno a una degustación de los productos de la granja: turrones, pan de especias, galletas de miel, zumos de frutas, etc."
    ],
    "nl": [
      "De imkers Céline Leynaud en Jérôme Debard nodigen u uit om hun passie voor bijen te delen en te genieten van een gezellig moment rond een proeverij van de producten van de boerderij: nougats, peperkoek, honingkoekjes, vruchtensappen enz."
    ]
  },
  "rdfs:label": {
    "en": [
      "Terre d'abeilles : individual operation"
    ],
    "fr": [
      "Terre d'abeilles : exploitation individuelle"
    ]
  },
