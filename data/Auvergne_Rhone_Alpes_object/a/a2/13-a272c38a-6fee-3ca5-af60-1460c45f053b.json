  "rdfs:comment": {
    "de": [
      "Die Tanzklassen des Konservatoriums von Romans freuen sich, Ihnen ihre neue Aufführung im Zeichen des Kinos zu präsentieren. Eine originelle und bewegende choreografische Reise, die Sie nicht verpassen sollten!"
    ],
    "en": [
      "The dance classes of the Conservatoire de Romans are delighted to present their new show, based on the theme of cinema. An original and moving choreographic journey not to be missed!"
    ],
    "it": [
      "Le classi di danza del Conservatorio di Romans sono liete di presentare il loro nuovo spettacolo, basato sul tema del cinema. Un viaggio coreografico originale e commovente da non perdere!"
    ],
    "fr": [
      "Les classes de danse du Conservatoire de Romans sont heureuses de vous présenter leur nouveau spectacle placé sous le signe du cinéma. Un voyage chorégraphique original et émouvant à ne pas manquer !"
    ],
    "es": [
      "Las clases de danza del Conservatorio de Romans están encantadas de presentar su nuevo espectáculo, basado en el tema del cine. Un viaje coreográfico original y conmovedor que no se puede perder"
    ],
    "nl": [
      "De dansklassen van het Romans Conservatorium presenteren met veel plezier hun nieuwe show, gebaseerd op het thema cinema. Een originele en ontroerende choreografische reis die je niet mag missen!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "La danse fait son cinéma"
    ]
  },
