  "rdfs:comment": {
    "de": [
      "ROCHEBAUDIN (Alt 325m): Kleines, friedliches Dorf aus dem 10. Jahrhundert mit seiner Kirche Notre Dame de Sénisse, Überbleibsel einer Zisterzienserabtei (12. Jh.). Der Ort liegt an beiden Ufern des Flusses Malle."
    ],
    "en": [
      "ROCHEBAUDIN (Alt 325m): Small, peaceful 10th-century village with Notre Dame de Sénisse church, remnant of a 12th-century Cistercian abbey. The village is located on both banks of the Malle river."
    ],
    "it": [
      "ROCHEBAUDIN (Alt 325 m): piccolo e tranquillo villaggio del X secolo con la chiesa di Notre Dame de Sénisse, resti di un'abbazia cistercense (XII secolo). Il villaggio si trova su entrambe le sponde del Malle."
    ],
    "fr": [
      "ROCHEBAUDIN (Alt 325m) : Petit village paisible du Xème siècle avec son église Notre Dame de Sénisse, vestige d'une abbaye cistercienne (XIIè siécle). Le bourg est implanté sur les deux rives de la Malle."
    ],
    "es": [
      "ROCHEBAUDIN (Alt 325m): Pequeño y tranquilo pueblo del siglo X con la iglesia de Notre Dame de Sénisse, restos de una abadía cisterciense (siglo XII). El pueblo está situado en las dos orillas del Malle."
    ],
    "nl": [
      "ROCHEBAUDIN (Alt 325m): Een rustig dorpje dat dateert uit de 10e eeuw, met de kerk Notre Dame de Sénisse, de overblijfselen van een cisterciënzer abdij (12e eeuw). Het dorp ligt aan beide oevers van de rivier de Malle."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Village de Rochebaudin"
    ]
  },
