  "rdfs:comment": {
    "de": [
      "Entdecken Sie mit unserem Fremdenführer die Geschichte der historischen Hauptstadt der Haute Auvergne, ihr bemerkenswertes Erbe und ihre Denkmäler. 1,5-stündige Führung durch einen Fremdenführer."
    ],
    "en": [
      "Discover with our guide the history of the historical capital of the Haute Auvergne, its remarkable heritage and its monuments. Guided tour of 1h30 by a lecturer."
    ],
    "it": [
      "Scoprite con la nostra guida la storia della capitale storica dell'Alta Alvernia, il suo notevole patrimonio e i suoi monumenti. Visita guidata di 1h30 da parte di una guida esperta."
    ],
    "fr": [
      "Découvrez avec notre guide l'histoire de la capitale historique de la Haute Auvergne, son patrimoine remarquable et ses monuments. Visite guidée par un guide conférencier de 1h30."
    ],
    "nl": [
      "Ontdek met onze gids de geschiedenis van de historische hoofdstad van de Haute Auvergne, haar opmerkelijke erfgoed en haar monumenten. Rondleiding van 1u30 door een deskundige gids."
    ],
    "es": [
      "Descubra con nuestro guía la historia de la capital histórica de la Alta Auvernia, su notable patrimonio y sus monumentos. Visita guiada de 1h30 por un guía experto."
    ]
  },
  "rdfs:label": {
