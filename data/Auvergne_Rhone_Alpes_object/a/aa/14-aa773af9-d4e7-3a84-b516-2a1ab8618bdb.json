  "rdfs:comment": {
    "de": [
      "Wenn Sie morgens vor dem Spiegel stehen und sich sagen, dass das Leben Sie nicht verwöhnt hat."
    ],
    "en": [
      "If you stand in front of the mirror in the morning and tell yourself that life hasn't spoiled you."
    ],
    "it": [
      "Se la mattina vi guardate allo specchio e vi dite che la vita non vi ha rovinato."
    ],
    "fr": [
      "Si le matin, devant le miroir, vous vous dîtes que la vie ne vous a pas gâtée."
    ],
    "es": [
      "Si te miras al espejo por la mañana y te dices a ti mismo que la vida no te ha echado a perder."
    ],
    "nl": [
      "Als je 's ochtends in de spiegel kijkt en tegen jezelf zegt dat het leven je niet verwend heeft."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Thaïs \"Hymne à la joie\""
    ]
  },
