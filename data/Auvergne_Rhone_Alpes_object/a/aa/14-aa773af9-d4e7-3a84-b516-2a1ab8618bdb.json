  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/8ef636e5-ffa2-3f2a-89e2-28c21a589ed2",
      "dc:description": {
        "de": [
          "Wenn Sie es nicht lassen können, in jedes Fettnäpfchen zu treten.\nWenn Sie mit Freunden wie den Ihren keine Feinde brauchen.\nWenn Ihr Liebesleben einer Wüste gleicht."
        ],
        "en": [
          "If you can't stop putting your foot in it.\nIf with friends like yours, you don't need enemies.\nIf your love life is like a desert."
        ],
        "it": [
          "Se non riesci a smettere di mettere i piedi in testa.\nSe con amici come i tuoi, non hai bisogno di nemici.\nSe la tua vita sentimentale è come un deserto."
        ],
        "fr": [
          "Si vous ne pouvez pas vous empêcher de mettre les pieds dans le plat.\nSi avec des amis comme les vôtres, vous n'avez pas besoin d'ennemis.\nSi votre vie sentimentale ressemble à un désert."
        ],
        "es": [
          "Si no puedes dejar de meter la pata.\nSi con amigos como los tuyos, no necesitas enemigos.\nSi tu vida amorosa es como un desierto."
        ],
        "nl": [
          "Als je niet kunt stoppen je voet erin te zetten.\nAls je met vrienden zoals jij geen vijanden nodig hebt.\nAls je liefdesleven als een woestijn is."
        ]
      },
