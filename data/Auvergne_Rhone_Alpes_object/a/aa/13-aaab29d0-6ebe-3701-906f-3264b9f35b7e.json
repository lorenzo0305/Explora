  "rdfs:comment": {
    "de": [
      "In den Kleingärten von Perrier können Annemassianer eine Parzelle pachten und dort ihr eigenes Obst und Gemüse anbauen."
    ],
    "en": [
      "Come and discover the allotment gardens at Le Perrier, where Annemasse residents can rent a plot and grow their own fruit and vegetables."
    ],
    "it": [
      "Venite a scoprire gli orti di Le Perrier, dove i residenti di Annemasse possono affittare un appezzamento di terreno e coltivare la propria frutta e verdura."
    ],
    "fr": [
      "Venez découvrir les jardins familiaux du Perrier permettent aux Annemassiens de louer une parcelle et d'y cultiver leurs fruits et légumes."
    ],
    "es": [
      "Venga a descubrir los huertos de Le Perrier, que permiten a los habitantes de Annemasse alquilar una parcela y cultivar sus propias frutas y verduras."
    ],
    "nl": [
      "Kom en ontdek de volkstuinen bij Le Perrier, waar inwoners van Annemasse een stuk grond kunnen huren en hun eigen fruit en groenten kunnen verbouwen."
    ]
  },
  "rdfs:label": {
