  "rdfs:comment": {
    "de": [
      "Dieses alte Bauernhaus im Herzen der flämischen Landschaft empfängt Sie in einem authentischen und gemütlichen Rahmen unter der Leitung des jungen und kreativen Küchenchefs Antonin Maresciano."
    ],
    "en": [
      "In an authentic and charming setting, this old farmhouse located in the heart of the Flemish countryside welcomes you under the guidance of its young creative Chef Antonin Maresciano."
    ],
    "it": [
      "In un ambiente autentico e accogliente, questa ex casa colonica situata nel cuore della campagna fiamminga vi accoglie sotto la guida del suo giovane e creativo chef Antonin Maresciano."
    ],
    "fr": [
      "Dans un cadre authentique et coquet, cette ancienne fermette située au cœur de la campagne flamande vous accueille sous l’impulsion de son jeune créatif Chef Antonin Maresciano."
    ],
    "nl": [
      "In een authentiek en gezellig kader ontvangt deze voormalige boerderij in het hart van het Vlaamse platteland u onder leiding van de jonge en creatieve chef Antonin Maresciano."
    ],
    "es": [
      "En un marco auténtico y acogedor, esta antigua granja situada en el corazón de la campiña flamenca le da la bienvenida bajo la dirección de su joven y creativo Chef Antonin Maresciano."
    ]
  },
