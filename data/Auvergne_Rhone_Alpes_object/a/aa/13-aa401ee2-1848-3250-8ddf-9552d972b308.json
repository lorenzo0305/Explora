  "rdfs:comment": {
    "de": [
      "Durchqueren Sie die Haute Maurienne Vanoise im Gravel-Bike-Modus auf ausgesuchten Strecken. Entdecken Sie zwischen Feldwegen und asphaltfreien Pisten eine andere Art des Radfahrens."
    ],
    "en": [
      "Ride through Haute Maurienne Vanoise in Gravel Bike mode on choice itineraries. From dirt roads to unpaved trails, discover a different way of riding."
    ],
    "it": [
      "Percorrete la Haute Maurienne Vanoise in modalità Gravel Bike su alcuni itinerari scelti. Dalle strade sterrate ai sentieri non asfaltati, scoprite un modo diverso di pedalare."
    ],
    "fr": [
      "Parcourez la Haute Maurienne Vanoise en mode Gravel Bike sur des itinéraires de choix. Entre chemins de terre et pistes sans asphalte, découvrez une façon de rouler autrement."
    ],
    "nl": [
      "Rijd door de Haute Maurienne Vanoise in de modus Gravel Bike op een aantal uitgekozen routes. Van onverharde wegen tot onverharde paden, ontdek een andere manier van fietsen."
    ],
    "es": [
      "Recorra Haute Maurienne Vanoise en modo Gravel Bike por algunos itinerarios selectos. Desde caminos de tierra a pistas sin asfaltar, descubre una forma diferente de conducir."
    ]
  },
  "rdfs:label": {
