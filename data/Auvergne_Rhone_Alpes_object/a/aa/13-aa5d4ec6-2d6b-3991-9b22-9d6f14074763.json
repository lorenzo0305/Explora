  "rdfs:comment": {
    "de": [
      "COMPS (675m alt): Zwischen Dieulefit und Bourdeaux, ist eine Berggemeinde mit verstreuten Siedlungen. Einer der liebenswertesten Orte des Landes, seine romanische Kirche thront majestätisch über einem Hügel (Ort für Konzerte)."
    ],
    "en": [
      "COMPS (675m alt): Between Dieulefit and Bourdeaux, this mountain commune has a scattered settlement. One of the most attractive sites in the region, its Romanesque church majestically dominates a hill (concert venue)."
    ],
    "it": [
      "COMPS (675 m s.l.m.) : Tra Dieulefit e Bourdeaux, è un comune di montagna dall'habitat sparso. Uno dei siti più affascinanti del paese, la sua chiesa romanica domina maestosamente una collina (sede di concerti)."
    ],
    "fr": [
      "COMPS (675m alt) : Entre Dieulefit et Bourdeaux, est une commune de montagne avec un habitat dispersé. l'un des sites les plus attachants du Pays, son église romane domine majestueusement une colline (lieu de concerts)."
    ],
    "nl": [
      "COMPS (675m hoogte): tussen Dieulefit en Bourdeaux, een berggemeente met een verspreide nederzetting. Een van de charmantste plekken in de regio, de Romaanse kerk domineert majestueus een heuvel (concertzaal)."
    ],
    "es": [
      "COMPS (675 m de altitud) : Entre Dieulefit y Bourdeaux, es un municipio de montaña con un hábitat disperso. Uno de los lugares más encantadores del país, su iglesia románica domina majestuosamente una colina (lugar de conciertos)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Village de Comps"
    ]
  },
