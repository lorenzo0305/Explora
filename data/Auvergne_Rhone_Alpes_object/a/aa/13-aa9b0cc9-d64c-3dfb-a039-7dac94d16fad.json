  "rdfs:comment": {
    "de": [
      "Das Café Jeanne bietet Ihnen neben einer gemütlichen Dorfbar verschiedene Dienstleistungen an: kulturelle Veranstaltungen, Getränke, Presse, Tabak, Verarbeitungslabor usw. sowie hausgemachte Speisen, die aus frischen und lokalen Produkten zubereitet werden."
    ],
    "en": [
      "As well as being a friendly village bar, Café Jeanne offers a range of services: cultural events, drinks, newspapers, tobacco, a processing lab, etc., as well as home-cooked meals prepared with fresh, local produce."
    ],
    "it": [
      "Oltre a essere un accogliente bar di paese, il Café Jeanne offre una serie di servizi: eventi culturali, bevande, giornali, tabacchi, laboratorio di trasformazione, ecc. e pasti preparati in casa con prodotti freschi locali."
    ],
    "fr": [
      "Le café Jeanne vous propose différents services en plus d'être un chaleureux bar de village : animations culturelles, boisson, presse, tabac, labo de transformation etc. ainsi qu'une restauration maison préparée à partir de produits frais et locaux."
    ],
    "nl": [
      "Café Jeanne is niet alleen een gezellig dorpscafé, maar biedt ook een scala aan diensten: culturele evenementen, drankjes, kranten, tabak, een verwerkingslaboratorium, enzovoort, en huisgemaakte maaltijden bereid met verse, lokale producten."
    ],
    "es": [
      "Además de ser un agradable bar de pueblo, el Café Jeanne ofrece diversos servicios: actos culturales, bebidas, prensa, tabaco, laboratorio de transformación, etc., así como comida casera elaborada con productos frescos de la zona."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Café Epicerie Jeanne"
    ]
  },
