  "rdfs:comment": {
    "de": [
      "Das Restaurant \"Le Bouchon Eric\" in der Altstadt von Annecy empfängt Sie in einer warmen und freundlichen Atmosphäre, um Ihnen Lyoner Spezialitäten zu servieren, die aus frischen und hausgemachten Produkten zubereitet werden."
    ],
    "en": [
      "The Restaurant \" Le Bouchon Eric \" in the old town of Annecy, welcomes you in a warm and friendly atmosphere, to make you taste Lyon specialities, made with fresh and home-made products."
    ],
    "it": [
      "Il ristorante \"Le Bouchon Eric\", nel centro storico di Annecy, vi accoglie in un'atmosfera calda e accogliente, per farvi gustare le specialità lionesi, realizzate con prodotti freschi e fatti in casa."
    ],
    "fr": [
      "Le Restaurant « Le Bouchon Eric » en vieille ville d’Annecy, vous accueille dans une ambiance chaleureuse et conviviale, pour vous faire déguster des spécialités lyonnaises, réalisées avec des produits frais et fait maison."
    ],
    "nl": [
      "Het Restaurant \"Le Bouchon Eric\" in de oude stad van Annecy, ontvangt u in een warme en vriendelijke sfeer, om u de specialiteiten van Lyon te laten proeven, gemaakt met verse en huisgemaakte producten."
    ],
    "es": [
      "El Restaurante \" Le Bouchon Eric \" en el casco antiguo de Annecy, le acoge en un ambiente cálido y acogedor, para hacerle degustar especialidades lionesas, elaboradas con productos frescos y caseros."
    ]
  },
