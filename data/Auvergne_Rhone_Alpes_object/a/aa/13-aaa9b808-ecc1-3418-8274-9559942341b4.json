  "rdfs:comment": {
    "de": [
      "Mit der Gondelbahn, die sich in Chamrousse 1650 - Recoin befindet, erreichen Sie in 5 Minuten den Gipfel des Croix de Chamrousse auf 2250 m Höhe und genießen ein außergewöhnliches Panorama."
    ],
    "en": [
      "The gondola takes you in just 5 minutes from Chamrousse 1650 - Recoin to the top of the resort (2250m), where you will enjoy an exceptional panorama."
    ],
    "it": [
      "Grazie alla funivia, situata a Chamrousse 1650 - Recoin, è possibile raggiungere la vetta della Croix de Chamrousse a 2250 m di altitudine in 5 minuti e godere di un panorama straordinario."
    ],
    "fr": [
      "Grâce à la télécabine, située à Chamrousse 1650 - Recoin, rejoignez en 5 minutes le sommet de la Croix de Chamrousse à 2250 m d'altitude pour profiter d'un panorama hors du commun."
    ],
    "es": [
      "Gracias al teleférico, situado en Chamrousse 1650 - Recoin, podrá alcanzar en 5 minutos la cima de la Croix de Chamrousse, a 2250 m de altitud, y disfrutar de un panorama extraordinario."
    ],
    "nl": [
      "Dankzij de kabelbaan, gelegen in Chamrousse 1650 - Recoin, bereikt u in 5 minuten de top van de Croix de Chamrousse op 2250 m hoogte en kunt u genieten van een buitengewoon panorama."
    ]
  },
  "rdfs:label": {
    "de": [
      "Seilbahn von La Croix"
    ],
    "en": [
      "Gondola of La Croix 2250m"
    ],
    "fr": [
      "Télécabine de la Croix"
    ]
  },
