  "rdfs:comment": {
    "de": [
      "Im Vercors Trièves, am Fuße des Mont-Aiguille, kümmert sich das Team des Familienhotels Gai Soleil du Mont Aiguille im Weiler La Richardière um alles: zu zweit, mit Freunden oder in der Gruppe."
    ],
    "en": [
      "\" Au Gai Soleil du Mont Aiguille \" Hotel offers you all a 2 starts Hotel comfort. We are situating at Mont Aiguille feet in the Regional Natural Reserve of Vercors which is the beginning of the biggest French Natural Reserve."
    ],
    "it": [
      "Nel Vercors Trièves, ai piedi del Mont-Aiguille, il team del Gai Soleil du Mont Aiguille, hotel 3 stelle a conduzione familiare nella frazione di La Richardière, si occuperà di tutto: per coppie, amici o gruppi."
    ],
    "fr": [
      "Dans le Vercors Trièves, au pied du Mont-Aiguille, l'équipe du Gai Soleil du Mont Aiguille, hôtel** familial, situé au hameau de La Richardière,  s'occupe de tout: en couple, entre amis ou en groupe."
    ],
    "nl": [
      "In de Vercors Trièves, aan de voet van de Mont-Aiguille, zorgt het team van het Gai Soleil du Mont Aiguille, een familiehotel met 3 sterren in het gehucht La Richardière, voor alles: voor koppels, vrienden of groepen."
    ],
    "es": [
      "En las Trièves de Vercors, a los pies del Mont-Aiguille, el equipo del Gai Soleil du Mont Aiguille, hotel familiar de 3 estrellas situado en la aldea de La Richardière, se ocupará de todo: para parejas, amigos o grupos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Hôtel Restaurant au Gai Soleil du Mont-Aiguille"
    ]
  },
