  "rdfs:comment": {
    "de": [
      "Restaurant am Rande der Lignon-Schlucht und des Grünzugs Via Fluvia, 4 km von Yssingeaux entfernt. Bietet Frösche, Wurstwaren aus der Region, Wachteln, Reibeplätzchen, Sarasson, lokale Produkte..."
    ],
    "en": [
      "Restaurant located on the banks of the Lignon Gorge and the Via Fluvia greenway, 4 km from Yssingeaux. Offers frogs, local charcuterie, caillettes, râpées, sarasson, local products..."
    ],
    "it": [
      "Ristorante situato sulle rive delle gole di Lignon e della Via Fluvia, a 4 km da Yssingeaux. Offre rane, salumi locali, caillettes, râpées, sarasson, prodotti locali..."
    ],
    "fr": [
      "Restaurant situé en bordure des gorges du Lignon et de la voie verte Via Fluvia à 4 km d'Yssingeaux. Propose grenouilles, charcuterie de pays, caillettes, râpées, sarasson, produits locaux..."
    ],
    "es": [
      "Restaurante situado a orillas de las gargantas del Lignon y de la vía verde Via Fluvia, a 4 km de Yssingeaux. Ofrece ranas, charcutería local, caillettes, râpées, sarasson, productos locales..."
    ],
    "nl": [
      "Restaurant gelegen aan de oevers van de Gorges de Lignon en de Via Fluvia greenway, op 4 km van Yssingeaux. Biedt kikkers, lokale vleeswaren, caillettes, râpées, sarasson, lokale producten..."
    ]
  },
  "rdfs:label": {
