  "rdfs:comment": {
    "de": [
      "Marie-Jo lädt Sie mit ihren Bildern zu einem Spaziergang durch den Kosmos ein: Konstellationen, Sterne, Exoplaneten.\r\nErklärungen zu den Werken und Verkauf von Postkarten\r\nNur nach Vereinbarung"
    ],
    "en": [
      "Marie-Jo invites you to take a walk through the cosmos in her paintings: constellations, stars, exoplanets.\r\nExplanation of the works and sale of postcards\r\nBy appointment only"
    ],
    "it": [
      "Marie-Jo vi invita a fare una passeggiata attraverso il cosmo nei suoi dipinti: costellazioni, stelle, esopianeti.\r\nSpiegazione delle opere e vendita di cartoline\r\nSolo su appuntamento"
    ],
    "fr": [
      "Marie-Jo vous invite à une promenade dans le cosmos à travers ses peintures: constellations, étoiles, exoplanètes. \r\nExplication des oeuvres et vente de cartes postales\r\nSur rendez-vous uniquement"
    ],
    "nl": [
      "Marie-Jo nodigt je uit voor een wandeling door de kosmos in haar schilderijen: sterrenbeelden, sterren, exoplaneten.\r\nUitleg over de werken en verkoop van ansichtkaarten\r\nAlleen op afspraak"
    ],
    "es": [
      "Marie-Jo le invita a dar un paseo por el cosmos en sus cuadros: constelaciones, estrellas, exoplanetas.\r\nExplicación de las obras y venta de postales\r\nSólo con cita previa"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite commentée de l'atelier de peinture du Cosmos"
    ]
  },
