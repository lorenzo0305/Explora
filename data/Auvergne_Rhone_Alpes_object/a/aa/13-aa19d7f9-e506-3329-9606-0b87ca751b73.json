  "rdfs:comment": {
    "de": [
      "Die Galerie artSème ist ein Ort der Kunstpraxis für die Teilnehmer der Workshops für Zeichnen und Ölmalerei, aber auch ein Ort der Verbreitung durch ihre Rolle als Kunstgalerie."
    ],
    "en": [
      "The artSème gallery is not only a place for participants in drawing and oil painting workshops to practice their art, but also a place to promote it through its role as an art gallery."
    ],
    "it": [
      "La galleria artSème è un luogo di pratica artistica per i partecipanti ai laboratori di disegno e pittura a olio, ma anche un luogo di diffusione grazie al suo ruolo di galleria d'arte."
    ],
    "fr": [
      "La galerie artSème est un lieu de pratique des arts pour les participants aux ateliers de dessin et peinture à l’huile mais aussi un lieu de diffusion par son rôle de galerie d'art."
    ],
    "es": [
      "La galería artSème es un lugar donde los participantes en los talleres de dibujo y pintura al óleo pueden practicar su arte, pero también es un lugar donde se puede exponer arte, gracias a su función de galería de arte."
    ],
    "nl": [
      "De galerie artSème is een plek waar de deelnemers aan de teken- en olieverfworkshops hun kunst kunnen beoefenen, maar het is ook een plek voor verspreiding door zijn rol als kunstgalerie."
    ]
  },
