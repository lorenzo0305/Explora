  "rdfs:comment": {
    "de": [
      "Die Boutique de L''artsolite ist eine Boutique für Kunst und Dekoration mit einem Hauch von Pop und Säure. Mit mehr als 1500 Artikeln können Sie hier nach Nuggets suchen!"
    ],
    "en": [
      "La Boutique de L''artsolite, an arts and decor boutique with a pop and acid touch. With over 1,500 items to choose from, come and discover the nuggets!"
    ],
    "it": [
      "La Boutique de L''artsolite, un negozio di arti e decorazioni con un tocco pop e acidulo. Con oltre 1.500 articoli tra cui scegliere, troverete sicuramente qualche chicca!"
    ],
    "fr": [
      "La Boutique de L''artsolite, une boutique d'arts et de décoration avec des touches pop et acidulées. Avec + de 1500 références, venez y dénicher des pépites !"
    ],
    "es": [
      "La Boutique de L''artsolite, una tienda de arte y decoración con un toque pop y ácido. Con más de 1.500 artículos para elegir, ¡seguro que encuentras alguna pepita!"
    ],
    "nl": [
      "La Boutique de L''artsolite, een kunst- en decorwinkel met een pop en zuur tintje. Met meer dan 1.500 artikelen om uit te kiezen, ben je er zeker van dat je een paar goudklompjes tegenkomt!"
    ]
