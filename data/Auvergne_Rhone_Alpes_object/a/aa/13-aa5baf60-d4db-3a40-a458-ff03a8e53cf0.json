  "rdfs:comment": {
    "de": [
      "Produzent von Lammfleisch. Verkauf in Kisten, vakuumverpackt, kochfertiges Fleisch, alles zerlegt.\r\nMöglichkeit, Mechoui zuzubereiten\r\nSeit Kurzem Verkauf von Merino-Wolle in Bündeln oder in Strängen"
    ],
    "en": [
      "Producer of lamb meat. Vacuum-packed, ready-to-cook, fully-cut meat.\r\nMechoui possible\r\nRecently began selling Merino wool in bundles or skeins"
    ],
    "it": [
      "Produttore di carne di agnello. Vendita in scatole, sottovuoto, carne pronta da cuocere, tutto tagliato.\r\nDisponibile anche il mechoui\r\nRecentemente ha iniziato a vendere lana Merino in fasci o matasse"
    ],
    "fr": [
      "Producteur de viande d'agneaux. Vente en caissette, sous vide, viande prête à cuire, toute découpée.\r\nPossibilité de méchoui\r\nDepuis peu vente de laine Mérinos en pelotte ou en echeveau"
    ],
    "es": [
      "Productor de carne de cordero. Venta en cajas, envasada al vacío, carne lista para cocinar, todo troceado.\r\nMechoui disponible\r\nRecientemente ha empezado a vender lana merina en manojos o madejas"
    ],
    "nl": [
      "Producent van lamsvlees. Verkoop in dozen, vacuüm verpakt, kant-en-klaar vlees, alles versneden.\r\nMechoui verkrijgbaar\r\nVerkoopt sinds kort Merinowol in bundels of strengen"
    ]
  },
  "rdfs:label": {
