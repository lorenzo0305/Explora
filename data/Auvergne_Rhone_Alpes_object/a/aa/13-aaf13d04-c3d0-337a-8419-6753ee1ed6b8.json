  "rdfs:comment": {
    "de": [
      "Der Lac des Hermines ist ein künstlicher See, der 1968 angelegt wurde und sich auf einer Höhe von 1350 m befindet. Er ist 9 m tief und hat eine Fläche von 14 ha. der Umfang beträgt 1,3 km.\r\nAngelegter Strand mit Sand und Gras.\r\nWährend der Sommerferien wird das Baden überwacht."
    ],
    "en": [
      "The lake of Hermines, artificial lake created in 1968, is located at 1350 m of altitude. It is 9 m deep and has a surface area of 14 ha \r\nBeach equipped with sand and grass. Supervised swimming during the summer holidays."
    ],
    "it": [
      "Il Lac des Hermines, un lago artificiale creato nel 1968, si trova a 1.350 m di altitudine. È profondo 9 metri e copre un'area di 14 ettari. 1,3 km di circonferenza.\r\nSpiaggia con sabbia ed erba.\r\nNuoto sorvegliato durante le vacanze estive."
    ],
    "fr": [
      "Le lac des Hermines, lac artificiel crée en 1968, se situe à 1350 m d'altitude. II fait 9 m de profondeur avec une superficie de 14 ha. 1,3 km de circonférence.\r\nPlage aménagée sable et herbe. \r\nBaignade surveillée pendant les vacances estivales."
    ],
    "nl": [
      "Lac des Hermines, een kunstmatig meer dat in 1968 werd aangelegd, ligt op een hoogte van 1.350 m. Het is 9 m diep en beslaat een oppervlakte van 14 ha. het heeft een omtrek van 1,3 km.\r\nStrand met zand en gras.\r\nZwemmen onder toezicht tijdens de zomervakantie."
    ],
    "es": [
      "El Lac des Hermines, lago artificial creado en 1968, se encuentra a 1.350 m de altitud. Tiene 9 m de profundidad y una superficie de 14 ha. 1,3 km de circunferencia.\r\nPlaya de arena y césped.\r\nBaño vigilado durante las vacaciones de verano."
    ]
  },
