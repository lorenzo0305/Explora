  "rdfs:comment": {
    "de": [
      "Bio-Bauernhof mit Heilpflanzenproduktion, energetischen Behandlungen und Schulungen zu Pflanzen und Energie. Direktverkauf von Kräutertees, Sirupen, Elixieren, Gemmotherapie. Workshops, geführte Pflückungen, Praktika auf dem Bauernhof. Shop vor Ort und online."
    ],
    "en": [
      "Organic farm producing medicinal plants, energy treatments and training in plants and energies. Direct sales of herbal teas, syrups, elixirs, gemmotherapy. Workshops, guided gatherings, courses on the farm. Store on site and online."
    ],
    "it": [
      "Azienda agricola biologica che produce piante medicinali, trattamenti energetici e formazione su piante ed energie. Vendita diretta di tisane, sciroppi, elisir e gemmoterapia. Laboratori, incontri guidati, corsi in fattoria. Negozio in loco e online."
    ],
    "fr": [
      "Ferme bio de production de plantes médicinales, soins énergétiques et formations plantes et energies. Vente directe de tisanes, sirops, élixirs, gemmothérapie. Ateliers, cueillettes guidées, stages à la ferme. Boutique sur place et en ligne."
    ],
    "es": [
      "Granja ecológica productora de plantas medicinales, tratamientos energéticos y formación en plantas y energías. Venta directa de infusiones, jarabes, elixires y gemoterapia. Talleres, encuentros guiados, cursos en la granja. Tienda in situ y en línea."
    ],
    "nl": [
      "Biologische boerderij die geneeskrachtige planten, energiebehandelingen en opleidingen in planten en energieën produceert. Directe verkoop van kruidenthee, siropen, elixers en gemmotherapie. Workshops, begeleide bijeenkomsten, cursussen op de boerderij. Winkel ter plaatse en online."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Ferme de la Reine des Près"
    ]
  },
