  "rdfs:comment": {
    "de": [
      "Die Speisekartedes Restaurants wechselt regelmäßig, um sich den Jahreszeiten anzupassen, wobei lokale und biologische Produkte bevorzugt werden."
    ],
    "en": [
      "The restaurant's menu changes regularly to adapt to the seasons and to favor local and organic products."
    ],
    "it": [
      "Il menu del ristorante cambia regolarmente per adattarsi alle stagioni, con particolare attenzione ai prodotti locali e biologici."
    ],
    "fr": [
      "La cartedu restaurant change régulièrement pour s'adapter aux saisons et en privilégiant les produits locaux et bio."
    ],
    "nl": [
      "Het menu van het restaurant verandert regelmatig om zich aan te passen aan de seizoenen, met de nadruk op lokale en biologische producten."
    ],
    "es": [
      "El menú del restaurante cambia regularmente para adaptarse a las estaciones, haciendo hincapié en los productos locales y ecológicos."
    ]
  },
