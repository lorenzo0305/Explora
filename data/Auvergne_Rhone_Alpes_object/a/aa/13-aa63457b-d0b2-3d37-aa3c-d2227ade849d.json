  "rdfs:comment": {
    "de": [
      "Verbringen Sie mit uns einen Abend zum Thema italienische, abwechslungsreiche oder traditionelle Küche und lernen Sie deren verschiedene Aspekte kennen. Genießen Sie das schöne Wetter auf unserer eigens dafür vorgesehenen Terrasse."
    ],
    "en": [
      "Spend an evening with us on the theme of Italian cuisine, varied or traditional, and discover its various aspects. Enjoy the good weather on our dedicated terrace."
    ],
    "it": [
      "Trascorrete con noi una serata sul tema della cucina italiana, varia o tradizionale, e scopritene i vari aspetti. Godetevi il bel tempo sulla nostra terrazza dedicata."
    ],
    "fr": [
      "Passez une soirée avec nous sur le thème de la cuisine italienne, variée ou traditionnelle et découvrez ses divers aspects. Profitez du beau temps sur notre terrasse dédiée."
    ],
    "es": [
      "Pase una velada con nosotros sobre el tema de la cocina italiana, variada y tradicional, y descubra sus diferentes aspectos. Disfrute del buen tiempo en nuestra terraza dedicada."
    ],
    "nl": [
      "Breng met ons een avond door rond het thema van de Italiaanse keuken, gevarieerd of traditioneel, en ontdek de verschillende aspecten ervan. Geniet van het mooie weer op ons speciale terras."
    ]
  },
