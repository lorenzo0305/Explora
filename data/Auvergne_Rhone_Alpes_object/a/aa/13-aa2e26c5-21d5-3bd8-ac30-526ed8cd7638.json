  "rdfs:comment": {
    "de": [
      "Das Hôtel du Lac und sein Restaurant bieten Ihnen traditionelle Gerichte aus der Auvergne, insbesondere aus dem Cantal, inmitten einer grünen Oase der Ruhe."
    ],
    "en": [
      "Nestled in a haven of greenery, the Hôtel du Lac and its restaurant offer traditional Auvergne cuisine, more specifically from the Cantal region."
    ],
    "it": [
      "Immerso in un'oasi di verde, l'Hôtel du Lac e il suo ristorante offrono una cucina tradizionale dell'Alvernia, in particolare della regione del Cantal."
    ],
    "fr": [
      "Lové dans un cœur de verdure, véritable havre de paix, l'Hôtel du Lac et son restaurant vous proposent une cuisine traditionnelle Auvergnate et plus spécifiquement du Cantal."
    ],
    "es": [
      "Ubicado en un remanso de verdor, el Hôtel du Lac y su restaurante ofrecen cocina tradicional de Auvernia, más concretamente de la región de Cantal."
    ],
    "nl": [
      "Hôtel du Lac en het restaurant liggen verscholen in een oase van groen en bieden traditionele gerechten uit de Auvergne, meer specifiek uit de Cantal-streek."
    ]
  },
