  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/cec0d20a-a642-356a-bfb9-cda4d02c84ec",
      "dc:description": {
        "de": [
          "Informationen :\n\nTage der Öffnung:\nDienstag bis Freitag: 7h-13h / 15h30-19h\nSamstag: 7h-13h / 15h30-18h\nSonntag und Feiertage: 7.30-13 Uhr\n\nMontag geschlossen\n\nBrotverkauf rund um die Uhr an sieben Tagen in der Woche 28 rue d'Arras in Habarcq.\n \n Bestellungen:\nKontaktieren Sie den Laden telefonisch unter 03 21 48 45 37."
        ],
        "en": [
          "Information :\n\nOpening days:\nTuesday to Friday: 7am-1pm / 3:30pm-7pm\nSaturday: 7am-1pm / 3:30pm-6pm\nSundays and public holidays: 7:30am-1pm\n\nClosed on Mondays\n\nBread dispenser open 24/7 28 rue d'Arras, Habarcq.\n \n To order:\nContact the store by telephone on 03 21 48 45 37."
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura:\nDa martedì a venerdì: 7.00-13.00 / 15.30-19.00\nSabato: 7.00-13.00 / 15.30-18.00\nDomenica e festivi: 7.30-13.00\n\nChiuso il lunedì\n\nDistributore automatico di pane aperto 24 ore su 24, 7 giorni su 7, al 28 di rue d'Arras a Habarcq.\n \n Ordini:\nContattare il negozio per telefono al numero 03 21 48 45 37."
        ],
        "fr": [
          "Informations : \n\nJours d'ouverture: \nDu mardi au vendredi: 7h-13h / 15h30-19h\nLe samedi: 7h-13h / 15h30-18h\nLe dimanche et jours fériés: 7h30-13h\n\nFermeture le lundi\n\nDistributeur de pains accessible 24h/24 et 7 jours/7 28 rue d'Arras à Habarcq.\n \n Commandes :\nContacter le magasin par téléphone au 03 21 48 45 37."
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen:\nDinsdag tot vrijdag: 7u-13u / 15u30-19u\nZaterdag: 7u-1u / 15u30-18u\nZon- en feestdagen: 7.30-1pm\n\nGesloten op maandag\n\nBroodautomaat 24/7 open op 28 rue d'Arras in Habarcq.\n \n Bestellen:\nNeem telefonisch contact op met de winkel op 03 21 48 45 37."
        ],
        "es": [
          "Más información :\n\nDías de apertura:\nDe martes a viernes: de 7.00 a 13.00 h. y de 15.30 a 19.00 h\nSábados: de 7.00 a 13.00 h / de 15.30 a 18.00 h\nDomingos y días festivos: de 7h30 a 13h00\n\nLunes cerrado\n\nMáquina expendedora de pan abierta 24 horas al día, 7 días a la semana, en el 28 rue d'Arras, en Habarcq.\n \n Pedidos:\nPóngase en contacto con la tienda por teléfono llamando al 03 21 48 45 37."
        ]
      },
