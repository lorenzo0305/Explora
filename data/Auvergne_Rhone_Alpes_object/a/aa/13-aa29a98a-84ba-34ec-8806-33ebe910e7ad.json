  "rdfs:comment": {
    "de": [
      "Das Fremdenverkehrsamt stellt Ihnen die gesamte lokale und regionale Dokumentation zur Verfügung und berät Sie bei der Organisation Ihres Thermal- oder Tourismusaufenthalts."
    ],
    "en": [
      "The Tourist Office puts at your disposal a whole local and regional documentation and advises you in the organization of your thermal or tourist stay."
    ],
    "it": [
