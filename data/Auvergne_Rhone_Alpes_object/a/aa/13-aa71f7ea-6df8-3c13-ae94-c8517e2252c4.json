  "rdfs:comment": {
    "de": [
      "Mini-Downhill und Downhill im Kanu-Kajak. Strecke vom Mini-Downhill bis zum Downhill in zwei Tagen. Neoprenanzüge, Picknickmahlzeiten, eingezäunter Parkplatz, Motorradgarage, Duschen."
    ],
    "en": [
      "Mini-descent and descent by canoe. Mini-descent to descent in two days. Neoprene wetsuits, picnic lunch, enclosed parking, motorcycle garage, showers."
    ],
    "it": [
      "Mini-discesa e discesa in canoa. Dalla mini-discesa alla discesa in due giorni. Mute in neoprene, pranzo al sacco, parcheggio chiuso, garage per le moto, docce."
    ],
    "fr": [
      "Mini-descente et descente en canoë kayak. Parcours de la mini-descente à la descente en deux jours. Combinaisons Néoprène, repas pique-nique, parking clos, garage à moto, douches."
    ],
    "es": [
      "Mini-descenso y descenso en canoa. Del mini-descenso al descenso en dos días. Trajes de neopreno, comida campestre, aparcamiento cerrado, garaje para motos, duchas."
    ],
    "nl": [
      "Mini-afdaling en afdaling per kano. Van de mini-afdaling tot de afdaling in twee dagen. Neopreen wetsuits, picknicklunch, afgesloten parkeerplaats, motorgarage, douches."
    ]
  },
