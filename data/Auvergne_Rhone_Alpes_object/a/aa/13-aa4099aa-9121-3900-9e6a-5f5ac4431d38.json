  "rdfs:comment": {
    "de": [
      "Er wird von den olympischen Skisprungschanzen von Courchevel dominiert. Die Umgebung ist zum Spazierengehen und Entspannen eingerichtet und bietet die Möglichkeit, das Training und die Wettkämpfe der weltbesten Skispringer live zu verfolgen."
    ],
    "en": [
      "Overlooked by the Courchevel Olympic ski jumping hill, the surrounding area is ideal for strolling and relaxing, with live coverage of the training sessions and competitions of the world's best ski jumpers."
    ],
    "it": [
      "Dominata dalla collina olimpica del salto con gli sci di Courchevel, l'area circostante è perfetta per passeggiare e rilassarsi, con una copertura in diretta degli allenamenti e delle gare dei migliori saltatori del mondo."
    ],
    "fr": [
      "Dominé par les Tremplins olympiques de saut à skis de Courchevel, ses abords, aménagés pour la promenade et la détente, permettent de suivre en direct, les entrainements et les compétitions des meilleurs sauteurs mondiaux."
    ],
    "nl": [
      "Met uitzicht op de Olympische schansspringheuvel van Courchevel is het omliggende gebied perfect om te wandelen en te ontspannen, met live verslag van de training en wedstrijden van 's werelds beste schansspringers."
    ],
    "es": [
      "Dominado por la colina olímpica de saltos de esquí de Courchevel, los alrededores son perfectos para pasear y relajarse, con cobertura en directo de los entrenamientos y competiciones de los mejores saltadores de esquí del mundo."
    ]
  },
  "rdfs:label": {
    "en": [
      "Lac du Praz"
    ],
    "fr": [
      "Lac du Praz"
    ]
  },
