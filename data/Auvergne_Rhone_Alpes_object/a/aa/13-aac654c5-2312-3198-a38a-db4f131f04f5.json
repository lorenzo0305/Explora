  "rdfs:comment": {
    "de": [
      "Der Etang de Farges erstreckt sich über 12,5 ha. Idealer Ort für Angelamateure oder Profis. Fußgänger- und Picknickmöglichkeiten. Abwechslungsreicher Fischbestand (Salmoniden, Raubfische, Karpfen etc.), Nachtangeln."
    ],
    "en": [
      "Etang de Farges stretches over 12.5 ha. Ideal place for fishing amateurs or professionals. Pedestrian and picnic facilities. Varied fish population (salmonids, predators, carp, etc.), night fishing."
    ],
    "it": [
      "L'Étang de Farges si estende per 12,5 ettari. Luogo ideale per pescatori dilettanti o professionisti. Strutture pedonali e per picnic. Popolazione ittica variegata (salmonidi, carnivori, carpe...), pesca notturna."
    ],
    "fr": [
      "L'Étang de Farges s'étale sur 12,5 ha. Lieu idéal pour les amateurs ou professionnels de pêche. Aménagement pédestre et pique-nique. Peuplement piscicole varié (salmonidés, carnassiers, carpes..), pêche de nuit."
    ],
    "es": [
      "El Étang de Farges ocupa 12,5 hectáreas. Lugar ideal para pescadores aficionados o profesionales. Instalaciones peatonales y de picnic. Población de peces variada (salmónidos, carnívoros, carpas..), pesca nocturna."
    ],
    "nl": [
      "De Étang de Farges beslaat 12,5 hectare. Ideale plek voor amateur- of beroepsvissers. Voetgangers- en picknickvoorzieningen. Gevarieerde vispopulatie (zalmachtigen, carnivoren, karper...), nachtvissen."
    ]
  },
  "rdfs:label": {
    "de": [
      "Angelstelle - Étang de Farges"
    ],
    "en": [
      "Fishing site - Étang de Farges"
    ],
