  "rdfs:comment": {
    "de": [
      "Entdecken Sie Lyon mit Oncity, Ihrem lokalen Reiseführer! Tauchen Sie mit seinen Food-Touren in die Lyoner Gastronomie ein oder entscheiden Sie sich für ein idyllisches Picknick im Herzen der Stadt. Eine authentische Erfahrung, um Lyon zu erkunden!"
    ],
    "en": [
      "Discover Lyon with Oncity, your local tour guide! Immerse yourself in Lyon's gastronomy with our food tours, or opt for an idyllic picnic in the heart of the city. An authentic way to explore Lyon!"
    ],
    "it": [
      "Scoprite Lione con Oncity, la vostra guida turistica locale! Immergetevi nella gastronomia lionese con i nostri tour gastronomici, oppure optate per un idilliaco picnic nel cuore della città. Un modo autentico di esplorare Lione!"
    ],
    "fr": [
      "Découvrez Lyon avec Oncity, votre guide touristique local ! Immergez-vous grâce à ses food tours pour savourer la gastronomie lyonnaise, ou optez pour un pique-nique idyllique au cœur de la ville. Une expérience authentique pour explorer Lyon !"
    ],
    "nl": [
      "Ontdek Lyon met Oncity, uw lokale toeristische gids! Dompel u onder in de gastronomie van Lyon met onze culinaire tours, of kies voor een idyllische picknick in het hart van de stad. Een authentieke manier om Lyon te verkennen!"
    ],
    "es": [
      "Descubra Lyon con Oncity, ¡su guía turístico local! Sumérjase en la gastronomía lionesa con nuestras rutas gastronómicas u opte por un idílico picnic en el corazón de la ciudad. Una forma auténtica de descubrir Lyon"
    ]
  },
