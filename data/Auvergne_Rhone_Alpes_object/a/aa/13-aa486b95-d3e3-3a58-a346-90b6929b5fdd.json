  "rdfs:comment": {
    "de": [
      "Hausgemachte\" Küche aus frischen lokalen Produkten. Schmackhafte Menüs von hier und anderswo. Jede Woche neues Menü. Tage und Öffnungszeiten finden Sie auf unserer Facebook- und Instagram-Seite! Verfügbar als Privatisierung für Ihre privaten Veranstaltungen."
    ],
    "en": [
      "Home-cooked cuisine using fresh local produce. Tasty menus from near and far. New menu every week. Days and times on our Facebook and Instagram pages! Available for private events."
    ],
    "it": [
      "Cucina casalinga con prodotti freschi locali. Menu gustosi da vicino e da lontano. Ogni settimana un nuovo menu. Giorni e orari sono disponibili sulle nostre pagine Facebook e Instagram! Disponibile per eventi privati."
    ],
    "fr": [
      "Cuisine \"fait maison\" à partir de produits frais locaux. Menus savoureux d'ici et d'ailleurs. Nouveau menu chaque semaine. Jours et horaires à consulter sur notre page Facebook et Instagram ! Disponible en privatisation pour vos évènements privés."
    ],
    "nl": [
      "Huisgemaakte keuken met verse lokale producten. Smakelijke menu's van dichtbij en ver weg. Elke week een nieuw menu. Dagen en tijden vind je op onze Facebook- en Instagrampagina's! Beschikbaar voor privé-evenementen."
    ],
    "es": [
      "Cocina casera con productos locales frescos. Sabrosos menús de cerca y de lejos. Nuevo menú cada semana. Días y horarios en nuestras páginas de Facebook e Instagram Disponible para eventos privados."
    ]
  },
  "rdfs:label": {
