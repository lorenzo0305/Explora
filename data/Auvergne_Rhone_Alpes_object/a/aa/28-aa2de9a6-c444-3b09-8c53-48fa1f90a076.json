  "rdfs:comment": {
    "de": [
      "Der Notre-Dame gewidmete Kapelle, die ab 1897 vom Architekten Achille Delafont für das Oeuvre de la chapelle d'Onival erbaut wurde. Die Initiative für den Bau ging von einem Komitee von Patronatsdamen aus, das 1894 gegründet wurde, um die Ausübung des Gottesdienstes in der Station zu verbessern."
    ],
    "en": [
      "Chapel dedicated to Notre-Dame built from 1897 by the architect Achille Delafont for the Onival Chapel. The initiative for this construction was taken by a committee of Ladies Patrons, founded in 1894, to improve the practice of worship in the station."
    ],
    "it": [
      "Cappella dedicata alla Madonna costruita a partire dal 1897 dall'architetto Achille Delafont per l'Oeuvre de la chapelle d'Onival. L'iniziativa di questa costruzione fu di un comitato di mecenati, fondato nel 1894, al fine di migliorare l'esercizio del culto nella località."
    ],
    "fr": [
      "Chapelle dédiée à Notre-Dame construite à partir de 1897 par l'architecte Achille Delafont pour l'Oeuvre de la chapelle d'Onival. L'initiative de cette construction revient à un comité de Dames patronnesses, fondé en 1894, afin d'améliorer l'exercice du culte dans la station."
    ],
    "nl": [
      "Kapel gewijd aan Onze-Lieve-Vrouw, gebouwd vanaf 1897 door de architect Achille Delafont voor het Oeuvre de la chapelle d'Onival. Het initiatief voor deze bouw kwam van een comité van vrouwelijke mecenassen, opgericht in 1894, om de uitoefening van de eredienst in het vakantieoord te verbeteren."
    ],
    "es": [
      "Capilla dedicada a Nuestra Señora construida a partir de 1897 por el arquitecto Achille Delafont para la Oeuvre de la chapelle d'Onival. La iniciativa de esta construcción partió de un comité de damas patronas, fundado en 1894, con el fin de mejorar el ejercicio del culto en la estación."
    ]
  },
