  "rdfs:comment": {
    "de": [
      "Erhältlich bis zum 6. November.\r\n\r\nDas abrakadabrische Feen-Abenteuer ist das Abenteuerspiel, das dir den Kopf verdrehen wird! Der Zauberwald ist in Gefahr, die Feen brauchen dringend deine Hilfe!"
    ],
    "en": [
      "Available until November 6.\r\n\r\nThe crazy adventure fairy is the adventure game that will blow you away! The enchanted forest is in danger, the fairies need you urgently!"
    ],
    "it": [
      "Disponibile fino al 6 novembre.\r\n\r\nThe fairy bubble adventure è il gioco d'avventura che vi lascerà a bocca aperta! La foresta incantata è in pericolo, le fate hanno urgentemente bisogno di te!"
    ],
    "fr": [
      "Disponible jusqu'au 6 novembre.\r\n\r\nLa fée-buleuse aventure abracadabrantesque c'est le jeu d'aventure qui va vous décoi-fée ! La forêt enchantée est en danger, les fées ont besoin de vous de toute urgence !"
    ],
    "es": [
      "Disponible hasta el 6 de noviembre.\r\n\r\n¡La aventura de las hadas burbuja es el juego de aventuras que te dejará boquiabierto! El bosque encantado está en peligro, ¡las hadas te necesitan urgentemente!"
    ],
    "nl": [
      "Beschikbaar tot 6 november.\r\n\r\nHet feeënbellenavontuur is het avonturenspel dat je versteld zal doen staan! Het betoverde bos is in gevaar, de feeën hebben je dringend nodig!"
    ]
  },
  "rdfs:label": {
    "en": [
      "La fée-buleuse aventure abracadabrantesque"
    ],
    "fr": [
      "La fée-buleuse aventure abracadabrantesque - Jeu d'aventures"
    ]
  },
