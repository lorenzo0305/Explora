  "rdfs:comment": {
    "de": [
      "Mit Blick auf die Dents de Lanfon und Tournette gelegen, großer Strand mit Sand und Wiese. Ideal für Familien mit Kindern. Label \"Blaue Flagge\" in 2014."
    ],
    "en": [
      "Opposite the Dents de Lanfon and the Tournette mountain, a large grassy sandy beach. Ideal for families and children. \"Blue Flag\" label since 2010."
    ],
    "it": [
      "Davanti ai Dents de Lanfon e alla Tournette, grande spiaggia di sabbia ed erba. Ideale per bambini e famiglie. Bandiera blu 2014."
    ],
    "fr": [
      "Face aux Dents de Lanfon et à la Tournette, grande plage de sable et d'herbe. Idéale pour les familles et les enfants. Label \"Pavillon bleu\" depuis 2010."
    ],
    "nl": [
      "Uitgestrekt zandstrand en zonneweide tegenover de Dents de Lanfon en de Tournette. Ideaal voor gezinnen met kinderen. Europees kwaliteitslabel Pavillon bleu 2014."
    ],
    "es": [
      "Frente a los Dents de Lanfon y la Tournette, gran playa de arena y hierba. Ideal para familias y niños. Etiqueta \"Bandera Azul\" desde 2010."
    ]
