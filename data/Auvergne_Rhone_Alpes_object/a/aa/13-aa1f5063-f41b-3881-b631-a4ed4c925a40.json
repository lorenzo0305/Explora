  "rdfs:comment": {
    "de": [
      "BocaLocal ist ein weibliches Duo, das einen Lieferservice für gesunde, leckere und engagierte Gerichte in Pfandgläsern anbietet. Sie werden mit einem Lastenfahrrad an das Ende des Sees von Annecy geliefert, um gut, schön, bio und abfallfrei zu essen."
    ],
    "en": [
      "BocaLocal is a duo of women, who offer a service of meal delivery with healthy, tasty and ecofriendly dishes in returnable jars. Delivered with a foodbike at the Southern end of lake Annecy, so that you can eat healthy, organic and with zero waste."
    ],
    "it": [
      "BocaLocal è un duo di donne che offre un servizio di consegna di piatti sani, gustosi e impegnati in barattoli a rendere. Consegnati in cargo bike fino all'estremità del lago di Annecy per un cibo buono, bello, biologico e a spreco zero."
    ],
    "fr": [
      "BocaLocal, c'est un duo féminin, qui propose un service de livraison de plats sains, gourmands et engagés en bocaux consignés. Livrés en vélo cargo au bout du lac d’Annecy pour manger bon, beau, bio et zéro déchet."
    ],
    "nl": [
      "BocaLocal is een duo vrouwen dat een bezorgdienst aanbiedt voor gezonde, lekkere en betrokken gerechten in statiegeldpotten. Geleverd per bakfiets aan het einde van het meer van Annecy voor goed, mooi, biologisch en zero waste eten."
    ],
    "es": [
      "BocaLocal es un dúo de mujeres que ofrece un servicio de reparto de platos sanos, sabrosos y comprometidos en tarros retornables. Entregados en bicicleta de carga hasta el final del lago de Annecy para una comida buena, bonita, ecológica y de residuo cero."
    ]
  },
  "rdfs:label": {
