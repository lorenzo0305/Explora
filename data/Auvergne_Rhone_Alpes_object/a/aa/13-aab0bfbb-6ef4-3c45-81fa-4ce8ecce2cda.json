  "rdfs:comment": {
    "de": [
      "Die Ausstellung erläutert alle Geheimnisse des Beaufort und seiner Region durch einen sensorischen Ansatz und originelle Hilfsmittel (Geruchsboxen, Modelle, Klangraketen, Filme usw.)."
    ],
    "en": [
      "Beaufort is a mountain cheese, like gruyère, produced in the alpine regions of Savoie : Beaufortain. Visit the milk cooperative, cheese dairy and cellars, Exhibition explanatory, photos, and a new sensory visit with, hay smell, bells sound... You can watch the Beaufort being made and taste it, and buy it !"
    ],
    "it": [
      "La mostra esplora tutti i segreti di Beaufort e della sua regione utilizzando un approccio sensoriale e strumenti originali (scatole degli odori, modelli, colonne sonore, film, ecc.)."
    ],
    "fr": [
      "L’exposition aborde tous les secrets du Beaufort et de son territoire via une approche sensorielle et des outils originaux (boîtes à odeur, maquettes, raquettes sonores, films…)."
    ],
    "es": [
      "La exposición explora todos los secretos de Beaufort y su región mediante un enfoque sensorial y herramientas originales (cajas de olores, maquetas, bandas sonoras, películas, etc.)."
    ],
    "nl": [
      "De tentoonstelling verkent alle geheimen van Beaufort en zijn regio door middel van een zintuiglijke benadering en originele hulpmiddelen (geurdoosjes, maquettes, soundtracks, films, enz.)."
    ]
  },
  "rdfs:label": {
    "en": [
      "The Dairy cooperative of Beaufortain"
    ],
    "fr": [
      "Fromagerie coopérative laitière du Beaufortain."
    ]
  },
