  "rdfs:comment": {
    "de": [
      "Neuer Treffpunkt für die Bewohner von Hochsavoyen und Genf. Willy und Pascal empfangen Sie von Montagmittag bis Samstagabend in einem Bergchalet im Herzen des Tals!"
    ],
    "en": [
      "The latest \"in\" place for people from Haute-Savoie and Geneva. Willy and Pascal welcome guests to a mountain chalet in the heart of the valley from Monday lunchtime to Saturday evening."
    ],
    "it": [
      "Un nuovo luogo di incontro per gli abitanti dell'Alta Savoia e di Ginevra, Willy e Pascal vi accolgono dal lunedì a pranzo al sabato sera in uno chalet di montagna nel cuore della valle!"
    ],
    "fr": [
      "Nouveau lieu de rendez-vous des haut-savoyards et des genevois, Willy et Pascal vous accueillent du lundi midi au samedi soir dans un chalet montagnard au cœur de la vallée !"
    ],
    "es": [
      "Un nuevo lugar de encuentro para los habitantes de la Alta Saboya y Ginebra, Willy y Pascal le acogen desde el lunes al mediodía hasta el sábado por la noche en un chalet de montaña en el corazón del valle"
    ],
    "nl": [
      "Een nieuwe ontmoetingsplaats voor de inwoners van de Haute-Savoie en Genève. Willy en Pascal verwelkomen u van maandagmiddag tot zaterdagavond in een bergchalet in het hart van de vallei!"
    ]
  },
  "rdfs:label": {
    "en": [
      "La Table à raclette"
    ],
    "fr": [
      "La Table à raclette"
    ]
  },
