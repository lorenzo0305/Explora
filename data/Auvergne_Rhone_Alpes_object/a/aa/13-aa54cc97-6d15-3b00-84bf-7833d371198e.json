  "rdfs:comment": {
    "de": [
      "Lust auf authentische Geschmäcker? Im L'Avalon steht die Küche der Ardèche mit ihren großzügigen und geselligen Gerichten im Vordergrund. Verwöhnen Sie sich mit unseren Ravioles, Quark und anderen Spezialitäten, die Groß und Klein begeistern werden! Die ganze Saison über geöffnet, jeden Tag"
    ],
    "en": [
      "Looking for authentic flavors? At L'Avalon, Ardèche cuisine takes center stage with generous, convivial dishes. Treat yourself to our ravioles, caillettes and other specialties that will delight young and old alike! Open all season, every day"
    ],
    "it": [
      "Siete alla ricerca di sapori autentici? A L'Avalon la cucina dell'Ardèche è al primo posto con piatti generosi e conviviali. Concedetevi i nostri ravioles, le caillettes e altre specialità che faranno la gioia di grandi e piccini! Aperto tutta la stagione, tutti i giorni"
    ],
    "fr": [
      "Envie de saveurs authentiques ? À L’Avalon, la cuisine ardéchoise est à l’honneur avec des plats généreux et conviviaux. Régalez-vous avec nos ravioles, caillettes et autres spécialités qui raviront petits et grands ! Ouvert toute la saison, tous les jour"
    ],
    "es": [
      "¿Busca sabores auténticos? En L'Avalon, la cocina de Ardèche es la protagonista, con platos generosos y acogedores. Deléitese con nuestros ravioles, caillettes y otras especialidades que harán las delicias de grandes y pequeños Abierto toda la temporada, todos los días"
    ],
    "nl": [
      "Zin in authentieke smaken? Bij L’Avalon staat de Ardèche-keuken centraal, met royale en gezellige gerechten. Geniet van onze heerlijke ravioles, caillettes en andere specialiteiten die jong en oud bekoren! Geopend het hele seizoen, elke dag van 8.00 tot 22.00 uur."
    ]
  },
