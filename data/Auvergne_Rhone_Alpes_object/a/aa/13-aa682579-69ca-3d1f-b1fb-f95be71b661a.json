  "rdfs:comment": {
    "de": [
      "Die Taverne befindet sich im Herzen des historischen Zentrums und bietet Ihnen eine vielfältige Auswahl an heißen und kalten Getränken, Cocktails sowie kleine Speisen (Flammküche, Crêpes, Brett zum Teilen,...), alles in einem typischen und gemütlichen Rahmen."
    ],
    "en": [
      "Situated in the heart of the historic center, La Taverne offers a varied selection of hot and cold drinks, cocktails and snacks (flammenküche, crêpes, sharing planks, etc.), all in a warm, typical setting."
    ],
    "it": [
      "Situata nel cuore del centro storico, La Taverne offre una scelta variegata di bevande calde e fredde, cocktail e spuntini (flammenküche, crêpes, tavolette da condividere, ecc.), il tutto in un ambiente caldo e tipico."
    ],
    "fr": [
      "Située au coeur du centre historique, La Taverne vous propose un choix varié de boissons chaudes et froides, cocktails, ainsi que de la petite restauration (flammenküche, crêpes, planche à partager,...) le tout dans un cadre typique et chaleureux."
    ],
    "es": [
      "Situada en pleno centro histórico, La Taverne ofrece una variada selección de bebidas frías y calientes, cócteles y aperitivos (flammenküche, crêpes, tablas para compartir, etc.), todo ello en un ambiente cálido y típico."
    ],
    "nl": [
      "La Taverne ligt in het hart van het historische centrum en biedt een gevarieerde keuze aan warme en koude dranken, cocktails en snacks (flammenküche, crêpes, gedeelde planken, enz.), allemaal in een warme, typische omgeving."
    ]
  },
  "rdfs:label": {
