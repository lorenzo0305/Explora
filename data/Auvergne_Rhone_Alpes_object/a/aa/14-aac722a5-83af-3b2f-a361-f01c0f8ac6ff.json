  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/3d51e5e0-7552-3a6b-bfb5-060c6392dc6d",
      "dc:description": {
        "de": [
          "Informationen :\n\nSpeisekarte :\nBesuchen Sie die Facebook-Seite, um die Wochenkarte zu sehen\n\nÖffnungstage:\nMontag bis Freitag von 11:30 bis 14:00 Uhr\nMittwoch, Freitag und Samstag von 19:00 bis 20:00 Uhr\n\nAuch an Feiertagen geöffnet\n\nBestellung:\nTelefonische Bestellung unter 03 21 07 00 24 ab Montag möglich\n "
        ],
        "en": [
          "Information :\n\nMenu :\nCheck the Facebook page for the weekly menu\n\nOpening days:\nMonday to Friday, 11:30am to 2pm\nWednesday, Friday and Saturday from 7pm to 8pm\n\nAlso open on public holidays\n\nHow to order :\nOrders can be placed by telephone on 03 21 07 00 24 on Mondays\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nMenu :\nControllare la pagina Facebook per il menù della settimana\n\nGiorni di apertura:\nDa lunedì a venerdì dalle 11.30 alle 14.00\nMercoledì, venerdì e sabato dalle 19.00 alle 20.00\n\nAperto anche nei giorni festivi\n\nCome ordinare :\nLe ordinazioni possono essere effettuate telefonicamente al numero 03 21 07 00 24 il lunedì\n "
        ],
        "fr": [
          "Informations :\n\nMenu :\nConsultez la page Facebook afin de connaître la carte de la semaine\n\nJours d'ouverture : \nDu lundi au vendredi de 11h30 à 14h\nLe mercredi, vendredi et samedi de 19h à 20h\n\nOuvert, également, les jours fériés\n\nCommande :\nPossibilité de commander par téléphone au 03 21 07 00 24 dès le lundi \n "
        ],
        "nl": [
          "Meer informatie :\n\nMenu :\nCheck de Facebook pagina voor het weekmenu\n\nOpeningsdagen:\nMaandag tot vrijdag van 11.30 tot 14.00 uur\nWoensdag, vrijdag en zaterdag van 19.00 tot 20.00 uur\n\nOok open op feestdagen\n\nHoe bestellen?\nBestellingen kunnen op maandag telefonisch worden doorgegeven op 03 21 07 00 24\n "
        ],
        "es": [
          "Más información :\n\nMenú :\nConsulta la página de Facebook para ver el menú de la semana\n\nDías de apertura:\nDe lunes a viernes de 11h30 a 14h00\nMiércoles, viernes y sábado de 19:00 a 20:00\n\nAbierto también los días festivos\n\nCómo hacer un pedido :\nLos pedidos pueden hacerse por teléfono llamando al 03 21 07 00 24 los lunes\n "
        ]
      },
