  "rdfs:comment": {
    "de": [
      "Wanderungen aller Schwierigkeitsgrade von 1 Stunde bis zu einem ganzen Tag, spielerische Einführungen für Kinder ab 4 Jahren für einen halben Tag. Spaziergänge auf einem ausgeschilderten Rundweg für Kinder von 3-9 Jahren."
    ],
    "en": [
      "Rides for all levels, from 1 hour to a full day, and fun 1/2-day introductions for children aged 4 and over. Walks on a signposted circuit for 3-9 year-olds."
    ],
    "it": [
      "Passeggiate per tutti i livelli, da 1 ora a una giornata intera, e divertenti passeggiate introduttive di 1/2 giornata per bambini a partire dai 4 anni. Passeggiate su un circuito segnalato per bambini dai 3 ai 9 anni."
    ],
    "fr": [
      "Promenades tous niveaux de 1h à la journée, initiations ludiques à la 1/2 journée pour les enfants dès 4 ans. Promenades sur un circuit fléché pour les 3-9 ans."
    ],
    "nl": [
      "Wandelingen voor alle niveaus, van 1 uur tot een hele dag, en leuke inleidende 1/2-daagse wandelingen voor kinderen vanaf 4 jaar. Wandelingen op een bewegwijzerd parcours voor kinderen van 3-9 jaar."
    ],
    "es": [
      "Paseos para todos los niveles, desde 1 hora hasta un día completo, y divertidos paseos introductorios de 1/2 día para niños a partir de 4 años. Paseos por un circuito señalizado para niños de 3 a 9 años."
    ]
  },
