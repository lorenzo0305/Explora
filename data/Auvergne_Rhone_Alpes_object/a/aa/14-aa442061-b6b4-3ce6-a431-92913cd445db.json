  "rdfs:comment": {
    "de": [
      "Der Tänzer und Choreograf Aziz El Youssoufi geht in seinem Solo auf die Ursprünge seiner 25-jährigen Bühnenpräsenz ein und erzählt zum ersten Mal von den Hintergründen seines künstlerischen Werdegangs."
    ],
    "en": [
      "Dancer and choreographer Aziz El Youssoufi?s solo explores the origins of his stage presence over the past 25 years, and for the first time tells the story behind the scenes of his artistic journey."
    ],
    "it": [
      "Nel suo assolo, il ballerino e coreografo Aziz El Youssoufi esplora le origini della sua presenza scenica negli ultimi 25 anni e racconta per la prima volta il dietro le quinte del suo percorso artistico."
    ],
    "fr": [
      "Le danseur et chorégraphe Aziz El Youssoufi , à travers son solo, plante les origines de sa présence sur scène depuis 25 ans et raconte pour la première fois l’envers du décor de son cheminement artistique."
    ],
    "nl": [
      "In zijn solo verkent danser en choreograaf Aziz El Youssoufi de oorsprong van zijn podiumprésence in de afgelopen 25 jaar en vertelt hij voor het eerst het verhaal achter de schermen van zijn artistieke reis."
    ],
    "es": [
      "En su solo, el bailarín y coreógrafo Aziz El Youssoufi explora los orígenes de su presencia escénica en los últimos 25 años, y por primera vez cuenta la historia entre bastidores de su trayectoria artística."
    ]
  },
