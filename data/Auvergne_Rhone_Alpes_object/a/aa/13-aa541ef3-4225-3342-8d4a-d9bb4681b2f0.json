  "rdfs:comment": {
    "de": [
      "Unsere Restaurants haben sich ihre belgische Seele bewahrt. Unsere Teams empfangen Sie jeden Tag in einer freundlichen, authentischen und herzlichen Atmosphäre wie in Brüssel."
    ],
    "en": [
      "Our restaurants have been careful to maintain their Belgian soul and our teams welcome you daily in a convivial, authentic and friendly atmosphere, exactly as they would in Brussels."
    ],
    "it": [
      "I nostri ristoranti hanno conservato la loro anima belga, i nostri team vi accolgono ogni giorno in un'atmosfera amichevole, autentica e calorosa, proprio come a Bruxelles."
    ],
    "fr": [
      "Nos restaurants ont su préserver toute leur âme Belge, nos équipes vous accueillent chaque jour dans une ambiance conviviale, authentique et chaleureuse comme à Bruxelles."
    ],
    "nl": [
      "Onze restaurants hebben hun Belgische ziel behouden, onze teams ontvangen u elke dag in een vriendelijke, authentieke en warme sfeer, net als in Brussel."
    ],
    "es": [
      "Nuestros restaurantes han conservado toda su alma belga, nuestros equipos le acogen cada día en un ambiente amable, auténtico y cálido, como en Bruselas."
    ]
  },
