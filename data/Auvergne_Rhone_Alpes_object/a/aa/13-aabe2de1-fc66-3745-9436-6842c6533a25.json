  "rdfs:comment": {
    "de": [
      "Am Rande der Auvergne, an der Grenze zwischen den Departements Loire und Haute-Loire, liegt die Mikrobrauerei Beauseigne auf 800 m Höhe in der Gemeinde Saint-Just-Malmont, einer privilegierten Lage 20 Minuten von Saint-Étienne entfernt."
    ],
    "en": [
      "At the gateway to the Auvergne region, on the borders of the Loire and Haute-Loire departments, the Beauseigne microbrewery is located at an altitude of 800 meters in the commune of Saint-Just-Malmont, a privileged location just 20 minutes from Saint-Étienne."
    ],
    "it": [
      "Alle porte della regione dell'Alvernia, ai confini con la Loira e l'Alta Loira, il microbirrificio Beauseigne è situato a 800 metri di altitudine nel comune di Saint-Just-Malmont, in una posizione privilegiata a 20 minuti da Saint-Étienne."
    ],
    "fr": [
      "Aux portes de l'Auvergne, en limite de la Loire et de la Haute-Loire, la micro-brasserie Beauseigne se situe à 800 mètres d'altitude sur la commune de Saint-Just-Malmont, un emplacement privilégié à 20 minutes de Saint-Étienne."
    ],
    "nl": [
      "Aan de poort van de Auvergne, op de grens van de Loire en de Haute-Loire, ligt de microbrouwerij Beauseigne op 800 meter hoogte in de gemeente Saint-Just-Malmont, een bevoorrechte locatie op slechts 20 minuten van Saint-Étienne."
    ],
    "es": [
      "A las puertas de la región de Auvernia, en los límites del Loira y el Alto Loira, la microcervecería Beauseigne está situada a 800 metros de altitud en el municipio de Saint-Just-Malmont, un lugar privilegiado a sólo 20 minutos de Saint-Étienne."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Brasserie Beauseigne"
    ]
  },
