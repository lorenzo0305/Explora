  "rdfs:comment": {
    "de": [
      "Das Auditorium des Museums von Grenoble ist intim (275 Plätze) und verfügt über eine von Musikern und Publikum anerkannte Akustik. Hier finden das ganze Jahr über Konzerte und Vorträge statt.\r\nKonzerte und Vorträge im Herzen des Museums von Grenoble"
    ],
    "en": [
      "The Musée de Grenoble's intimate 275-seat auditorium boasts acoustics recognized by musicians and audiences alike. It hosts concerts and conferences all year round.\r\nConcerts and lectures at the heart of the Grenoble museum"
    ],
    "it": [
      "L'auditorium del Musée de Grenoble, con la sua intima sala da 275 posti, vanta un'acustica ampiamente apprezzata dai musicisti e dal pubblico in generale. Ospita concerti e conferenze tutto l'anno.\r\nConcerti e conferenze nel cuore del museo di Grenoble"
    ],
    "fr": [
      "Découvrez l'Auditorium du Musée de Grenoble pour des concerts de qualité au cœur de la ville. Cette salle intimiste est reconnue par les musiciens et le public pour sa très belle acoustique."
    ],
    "nl": [
      "Het auditorium van het Musée de Grenoble, met zijn intieme zaal met 275 zitplaatsen, heeft een akoestiek die alom geprezen wordt door zowel muzikanten als het grote publiek. Hier vinden het hele jaar door concerten en lezingen plaats.\r\nConcerten en lezingen in het hart van het museum van Grenoble"
    ],
    "es": [
      "Descubra el Auditorium du Musée de Grenoble para disfrutar de conciertos de calidad en pleno centro de la ciudad. Este lugar íntimo es conocido tanto por los músicos como por el público por su magnífica acústica."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Auditorium du Musée de Grenoble"
    ]
  },
