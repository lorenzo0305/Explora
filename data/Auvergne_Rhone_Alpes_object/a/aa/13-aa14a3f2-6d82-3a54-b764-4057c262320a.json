  "rdfs:comment": {
    "de": [
      "Das Maison Pour Tous lädt Sie zu seinem großen Sommerfest ein! Es werden zahlreiche Aktivitäten angeboten. Essen vor Ort Guinguette ab 19 Uhr am Ufer der Loire.="
    ],
    "en": [
      "La Maison Pour Tous invites you to its summer party! A wide range of activities will be on offer. Guinguette dinner from 7pm on the banks of the Loire.="
    ],
    "it": [
      "La Maison Pour Tous vi invita alla sua grande festa estiva! Verrà proposta un'ampia gamma di attività. Dalle 19:00 ci sarà una cena a base di guinguette sulle rive della Loira.="
    ],
    "fr": [
      "La Maison Pour Tous vous donne rendez-vous pour sa grande fête d’été ! De nombreuses activités seront proposées. Repas sur place guinguette à partir de 19h en bord de Loire.="
    ],
    "es": [
      "La Maison Pour Tous le invita a su gran fiesta de verano Se ofrecerá un amplio abanico de actividades. Habrá una cena guinguette a partir de las 19:00 a orillas del Loira.="
    ],
    "nl": [
      "Het Maison Pour Tous nodigt je uit op haar grote zomerfeest! Er zullen tal van activiteiten worden aangeboden. Er zal een guinguette diner zijn vanaf 19u op de oevers van de Loire.="
    ]
  },
  "rdfs:label": {
    "fr": [
      "Fête des Epouvantails et de la Musique"
    ]
  },
