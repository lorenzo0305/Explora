  "rdfs:comment": {
    "de": [
      "Willkommen am Lac des Meinettes!\r\n\r\nWir schlagen Ihnen eine ganz sanfte Gravel-Wanderung vor, um diesen wunderschönen See mit seinem völlig geschützten Ökosystem zu umrunden."
    ],
    "en": [
      "Welcome to the Ménettes lake!\r\n\r\nWe're offering you a very pleasant gravel route around this superb stretch of water with its totally preserved ecosystem."
    ],
    "it": [
      "Benvenuti al Lac des Meinettes!\r\n\r\nVi proponiamo un giro su ghiaia intorno a questo lago superbo con un ecosistema totalmente preservato."
    ],
    "fr": [
      "Bienvenue au lac des Meinettes !\r\n\r\nNous vous proposons une randonnée gravel toute douce pour faire le tour de ce superbe plan d’eau à l’écosystème totalement préservé."
    ],
    "es": [
      "¡Bienvenido a Lac des Meinettes!\r\n\r\nLe proponemos un suave paseo de gravilla alrededor de este magnífico lago con un ecosistema totalmente preservado."
    ],
    "nl": [
      "Welkom in Lac des Meinettes!\r\n\r\nWe bieden je een rustige tocht op grind rond dit prachtige meer met zijn volledig behouden ecosysteem."
    ]
  },
  "rdfs:label": {
