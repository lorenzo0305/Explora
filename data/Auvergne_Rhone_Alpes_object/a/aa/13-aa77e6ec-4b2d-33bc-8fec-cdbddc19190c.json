  "rdfs:comment": {
    "de": [
      "Virginie Féminier und Émilie Bergeron, zwei Erzählerinnen mit komplementären Welten, werden musikalisch begleitet und laden Sie zu einer sensorischen und poetischen Reise ein, die speziell dafür konzipiert wurde, die Neugier der Kinder zu wecken."
    ],
    "en": [
      "Virginie Féminier and Émilie Bergeron, two storytellers with complementary backgrounds, will be accompanied by music to take you on a sensory and poetic journey, specially designed to awaken children's curiosity."
    ],
    "it": [
      "Virginie Féminier ed Émilie Bergeron, due narratrici provenienti da mondi complementari, saranno accompagnate dalla musica per accompagnarvi in un viaggio sensoriale e poetico, pensato appositamente per risvegliare la curiosità dei bambini."
    ],
    "fr": [
      "Virginie Féminier et Émilie Bergeron, deux conteuses aux univers complémentaires, seront accompagnées en musique pour vous inviter à un voyage sensoriel et poétique, spécialement imaginé pour éveiller la curiosité des enfants."
    ],
    "es": [
      "Virginie Féminier y Émilie Bergeron, dos narradoras de mundos complementarios, se acompañarán de música para realizar un viaje sensorial y poético, especialmente diseñado para despertar la curiosidad de los niños."
    ],
    "nl": [
      "Virginie Féminier en Émilie Bergeron, twee verhalenvertellers uit werelden die elkaar aanvullen, zullen worden begeleid door muziek om je mee te nemen op een zintuiglijke en poëtische reis, speciaal ontworpen om de nieuwsgierigheid van kinderen te wekken."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Lecture d'albums jeunesse en occitan"
    ]
  },
