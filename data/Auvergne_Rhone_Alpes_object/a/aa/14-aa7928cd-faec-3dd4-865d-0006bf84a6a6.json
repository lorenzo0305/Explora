  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/c9687433-f91f-393a-a0cb-56ddc95ad9fa",
      "dc:description": {
        "de": [
          "Informationen :\n\nÖffnungstage:\n\nDie Bäckerei ist dienstags bis sonntags von 6:30 bis 12:30 Uhr und von 15:00 bis 19:30 Uhr sowie sonntags von 7:00 bis 13:00 Uhr geöffnet.\n\nMontags ist die Bäckerei geschlossen.\n\n\n "
        ],
        "en": [
          "Information :\n\nOpening days:\n\nThe bakery is open Tuesday to Sunday from 6:30am to 12:30pm and from 3pm to 7:30pm, and on Sundays from 7am to 1pm.\n\nClosed on Mondays.\n\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura:\n\nLa panetteria è aperta dal martedì alla domenica dalle 6.30 alle 12.30 e dalle 15.00 alle 19.30 e la domenica dalle 7.00 alle 13.00.\n\nChiuso il lunedì.\n\n\n "
        ],
        "fr": [
          "Informations : \n\nJours d'ouverture: \n\nLa boulangerie est ouverte du mardi au dimanche de 6h30 à 12h30 et de 15h à 19h30 et le dimanche de 7h à 13h.\n\nFermeture le lundi.\n\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen:\n\nDe bakkerij is geopend van dinsdag tot en met zondag van 6.30 tot 12.30 uur en van 15.00 tot 19.30 uur en op zondag van 7.00 tot 13.00 uur.\n\nGesloten op maandag.\n\n\n "
        ],
        "es": [
          "Más información :\n\nDías de apertura:\n\nLa panadería abre de martes a domingo de 6h30 a 12h30 y de 15h00 a 19h30 y los domingos de 7h00 a 13h00.\n\nLunes cerrado.\n\n\n "
        ]
      },
