  "rdfs:comment": {
    "de": [
      "Genießen Sie kabylische Spezialitäten, d. h. Tajines (auf Bestellung) und Couscous. Hausgemachtes orientalisches Gebäck, einige französische Desserts sowie Tee."
    ],
    "en": [
      "Enjoy Kabyle specialties, including tajines (to order) and couscous. Home-made oriental pastries, some French desserts and tea."
    ],
    "it": [
      "Assaggiate le specialità cabie come le tajine (su ordinazione) e il couscous. Pasticceria orientale fatta in casa, alcuni dolci francesi e tè."
    ],
    "fr": [
      "Vous apprécierez des spécialités kabyles, à savoir tajines (sur commande) et couscous. Pâtisseries orientales faites maison, quelques desserts français ainsi que le thé."
    ],
    "nl": [
      "Geniet van Kabylische specialiteiten zoals tajines (op bestelling) en couscous. Huisgemaakt oosters gebak, enkele Franse desserts en thee."
    ],
    "es": [
      "Disfrute de especialidades cabilas como tajines (por encargo) y cuscús. Pastelería oriental casera, algunos postres franceses y té."
    ]
  },
