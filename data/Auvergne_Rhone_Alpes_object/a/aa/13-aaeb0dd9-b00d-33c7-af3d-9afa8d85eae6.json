  "rdfs:comment": {
    "de": [
      "Nur wenige Minuten von Eurexpo, dem internationalen Flughafen St Exupéry, dem Miribel-See und dem Zentrum von Lyon entfernt, entdecken Sie die Nouvelle Passerelle."
    ],
    "en": [
      "Just a few minutes from Eurexpo, St Exupéry International Airport, Lake Miribel and the centre of Lyon, come and discover the Nouvelle Passerelle."
    ],
    "it": [
      "A pochi minuti da Eurexpo, dall'aeroporto internazionale di St Exupéry, dal lago Miribel e dal centro di Lione, venite a scoprire la Nouvelle Passerelle."
    ],
    "fr": [
      "A quelques minutes d'Eurexpo, de l'aéroport international St Exupéry, du lac de Miribel et du centre de Lyon, venez découvrir la Nouvelle Passerelle."
    ],
    "nl": [
      "Op enkele minuten van Eurexpo, de internationale luchthaven St Exupéry, het meer van Miribel en het centrum van Lyon kunt u de Nouvelle Passerelle ontdekken."
    ],
    "es": [
      "A pocos minutos de Eurexpo, del aeropuerto internacional de St Exupéry, del lago Miribel y del centro de Lyon, venga a descubrir el Nouvelle Passerelle."
    ]
  },
