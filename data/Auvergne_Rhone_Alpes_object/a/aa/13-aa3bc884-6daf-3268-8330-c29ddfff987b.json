  "rdfs:comment": {
    "de": [
      "Frédéric, ein erfahrener Bergführer, führt Sie sanft in die Entdeckung neuer Sensationen beim Klettern, Klettersteiggehen, Canyoning, Alpin- oder Gletscherwanderungen, Skitouren an Orten, die aufgrund ihrer Schönheit ausgewählt wurden."
    ],
    "en": [
      "Frédéric, an experienced mountain guide, will gently lead you in the discovery of new sensations in climbing, via ferrata, canyoning, alpine or glacier hiking, ski touring in places chosen for their beauty."
    ],
    "it": [
      "Frédéric, guida alpina esperta, vi condurrà dolcemente alla scoperta di nuove sensazioni nell'arrampicata, nella via ferrata, nel canyoning, nel trekking alpino o su ghiacciaio, nello sci alpinismo in luoghi scelti per la loro bellezza."
    ],
    "fr": [
      "Frédéric, guide de montagne expérimenté, vous conduit en douceur dans la découverte de nouvelles sensations en escalade, via ferrata, canyon, randonnée alpine ou glaciaire, ski de randonnée dans des lieux choisis pour leur beauté."
    ],
    "es": [
      "Frédéric, guía de montaña experimentado, le conducirá suavemente al descubrimiento de nuevas sensaciones en escalada, vía ferrata, barranquismo, senderismo alpino o glaciar, esquí de travesía en lugares elegidos por su belleza."
    ],
    "nl": [
      "Frédéric, een ervaren berggids, zal je zachtjes leiden in de ontdekking van nieuwe sensaties in het klimmen, via ferrata, canyoning, alpine of gletsjer trekking, skitochten op plaatsen gekozen voor hun schoonheid."
    ]
  },
  "rdfs:label": {
    "de": [
      "Viret Frédéric - Bergführer"
    ],
    "en": [
      "Viret Frédéric - Mountain guide"
    ],
    "fr": [
      "Viret Frédéric - Guide de haute montagne"
    ],
    "nl": [
      "Viret Frédéric - Berggids"
    ]
  },
