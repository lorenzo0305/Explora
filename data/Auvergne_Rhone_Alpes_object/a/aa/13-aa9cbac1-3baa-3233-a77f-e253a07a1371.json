  "rdfs:comment": {
    "de": [
      "Workshop zum spielerischen und kreativen Schreiben, Lebensbericht, Familiengenealogie. Blase der Fantasie und Kreativität. Die Vorschläge zum spielerischen Schreiben fördern das Spiel und die Begegnungen. Die Teilnahme an einem Workshop bedeutet vor allem, einen Moment für sich selbst zu erleben."
    ],
    "en": [
      "Fun and creative writing workshop, life stories, family genealogy. A bubble of imagination and creativity. Our playful writing workshops encourage play and encounters. Taking part in a workshop is above all having a moment to yourself."
    ],
    "it": [
      "Laboratorio di scrittura divertente e creativa, storie di vita, genealogia familiare. Una bolla di immaginazione e creatività. I laboratori di scrittura ludica incoraggiano il gioco e l'incontro. Partecipare a un laboratorio è soprattutto avere un momento per sé."
    ],
    "fr": [
      "Atelier d'écriture ludique et créative, récit de vie, généalogie familiale. Bulle d'imagination et de créativité. Les propositions d'écriture ludique favorisent le jeu et les rencontres. Participer à un atelier c'est avant tout vivre un moment à soi."
    ],
    "es": [
      "Taller de escritura divertida y creativa, historias de vida, genealogía familiar. Una burbuja de imaginación y creatividad. Los talleres de escritura lúdica favorecen el juego y el encuentro. Participar en un taller es sobre todo tener un momento para uno mismo."
    ],
    "nl": [
      "Leuke en creatieve schrijfworkshop, levensverhalen, familiegenealogie. Een bubbel van verbeelding en creativiteit. Deze speelse schrijfactiviteiten stimuleren spel en ontmoeting. Deelnemen aan een workshop is vooral een moment voor jezelf hebben."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Au cœur des mots 63 : ateliers d'écriture"
    ]
  },
