  "rdfs:comment": {
    "de": [
      "Verleih, Verkauf und Reparatur von Winter- und Sommersportgeräten: Skier, Schneeschuhe, Fahrräder, Elektrofahrräder, Fatbike mit Elektrounterstützung der Vogesenmarke Moustache, Wandern, Camping...\r\nVerleih von Via Ferrata-Ausrüstung."
    ],
    "en": [
      "Rental, sale, hardware repair of winter equipment, mountain bike, VTC, electric bicycle, for adults and children throughout summer. Rental of via ferrata equipment."
    ],
    "it": [
      "Noleggio, vendita e riparazione di attrezzature sportive invernali ed estive: sci, racchette da neve, biciclette, biciclette elettriche, Fatbike elettriche a pedalata assistita del marchio Moustache dei Vosgi, escursioni, campeggio...\r\nNoleggio di attrezzature per la Via Ferrata."
    ],
    "fr": [
      "Location, vente et réparations de matériel de sports d'hiver et d'été : skis, raquettes, vélos, vélos électriques, Fatbike à assistance électrique de la marque vosgienne Moustache, randonnée, camping...\r\nLocation de matériel de Via Ferrata."
    ],
    "nl": [
      "Verhuur, verkoop en reparatie van winter- en zomersportartikelen: ski's, sneeuwschoenen, fietsen, elektrische fietsen, Fatbike met elektrische ondersteuning van het merk Moustache uit de Vogezen, wandelen, kamperen...\r\nVerhuur van via ferrata uitrusting."
    ],
    "es": [
      "Alquiler, venta y reparación de material deportivo de invierno y verano: esquís, raquetas de nieve, bicicletas, bicicletas eléctricas, Fatbike de asistencia eléctrica de los Vosgos marca Moustache, senderismo, camping...\r\nAlquiler de material de vía ferrata."
    ]
  },
