  "rdfs:comment": {
    "de": [
      "MEZENK, Handwerkliche Brennerei, die Brände aus lokalen Pflanzen, Liköre, Malz und alkoholfreie Spirituosen herstellt. Ganzjährig geöffnet / Besichtigung & Shop nur nach Vereinbarung / Flexible Öffnungszeiten außerhalb der Produktionstage"
    ],
    "en": [
      "MEZENK, Artisanal distillery producing eaux de vies made from local plants, liqueurs, malts and non-alcoholic spirits. Open all year round / Visits & store by appointment only / Flexible opening hours outside production days"
    ],
    "it": [
      "MEZENK, Distilleria artigianale che produce acquaviti di piante locali, liquori, malti e liquori analcolici. Aperta tutto l'anno / Visite e negozio solo su appuntamento / Orari di apertura flessibili, esclusi i giorni di produzione"
    ],
    "fr": [
      "MEZENK, Distillerie artisanale produisant des eaux de vies à base de plantes locales, des liqueurs, des malts et des spiritueux sans alcool. Ouvert toute l’année / Visites & boutique sur RDV seulement / Jours-Horaires souples hors jours de production"
    ],
    "nl": [
      "MEZENK, ambachtelijke distilleerderij die eaux de vies van lokale planten, likeuren, mout en alcoholvrije sterke dranken produceert. Het hele jaar geopend / Bezoek & winkel alleen op afspraak / Flexibele openingstijden met uitzondering van productiedagen"
    ],
    "es": [
      "MEZENK, Destilería artesanal que produce aguardientes de plantas locales, licores, maltas y bebidas espirituosas sin alcohol. Abierto todo el año / Visitas y tienda con cita previa / Horario flexible excepto los días de producción"
    ]
  },
  "rdfs:label": {
