  "rdfs:comment": {
    "de": [
      "Der Aigle-Staudamm wurde während des Zweiten Weltkriegs gebaut und am 15. Oktober 1945 eingeweiht."
    ],
    "en": [
      "Started in 1935, the construction of Le barrage de l'Aigle ended in 1945. The dam played an important part during the war and it has been aptly named \"the Resistance Dam\"."
    ],
    "it": [
      "Seconda diga idroelettrica costruita sul fiume Dordogna dopo quella di Marèges (1932-1935), la diga di Aigle fu costruita durante la Seconda guerra mondiale e inaugurata il 15 ottobre 1945."
    ],
    "fr": [
      "Second barrage hydro-électrique édifié sur la rivière Dordogne après celui de Marèges (1932 - 1935), le barrage de l'Aigle a été construit durant la seconde guerre mondiale et inauguré le 15 octobre 1945."
    ],
    "es": [
      "Segunda presa hidroeléctrica construida en el río Dordoña después de la de Marèges (1932 - 1935), la presa de Aigle se construyó durante la Segunda Guerra Mundial y se inauguró el 15 de octubre de 1945."
    ],
    "nl": [
      "De stuwdam van Aigle, die na die van Marèges (1932 - 1935) de tweede hydro-elektrische stuwdam in de Dordogne is, werd tijdens de Tweede Wereldoorlog gebouwd en op 15 oktober 1945 in gebruik genomen."
    ]
  },
  "rdfs:label": {
    "en": [
