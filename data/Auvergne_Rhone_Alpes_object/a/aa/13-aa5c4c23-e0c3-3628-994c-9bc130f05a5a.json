  "rdfs:comment": {
    "de": [
      "100m von den Linga-Liften entfernt empfängt Sie die Bar des Hotels Eliova L'Eau Vive*** nach dem Skifahren, zum Aperitif oder am Abend."
    ],
    "en": [
      "Located at 100m from the Linga ski lifts, the bar of the hotel Eliova L'Eau Vive*** welcomes you after skiing for an aperitif or in the evening."
    ],
    "it": [
      "A soli 100 metri dagli impianti di risalita Linga, il bar dell'hotel Eliova L'Eau Vive*** vi accoglie dopo lo sci, per un aperitivo o la sera."
    ],
    "fr": [
      "A 100m des remontées mécaniques du Linga, le Bar de l'hôtel Eliova L'Eau Vive*** vous accueille après le ski, pour l'apéritif ou en soirée."
    ],
    "nl": [
      "Op slechts 100 meter van de Linga skiliften verwelkomt de Eliova L'Eau Vive*** hotelbar u na het skiën, voor een aperitief of in de avond."
