  "rdfs:comment": {
    "de": [
      "Jede Woche bietet Ihnen die Ferme de Mesenguy Produkte aus ihrer BIO-Schweinezucht (Fleisch, Wurstwaren, Terrinen, Rillettes...), ihrer kleinen Schafzucht, aber auch Produkte von anderen Bauernhöfen der Region (Marmeladen, Käse, Bier, Honig, Kekse...)."
    ],
    "en": [
      "Every week, the Farm of Mesenguy offers you products from its organic pig breeding (meat, cooked pork meats, terrines, rillettes...), from its small sheep breeding but also products from other farms in the region (jams, cheeses, beers, honey, biscuits...)."
    ],
    "it": [
      "Ogni settimana, la fattoria Mesenguy offre prodotti provenienti dal suo allevamento di maiali biologici (carne, salumi, terrine, rillettes...), dal suo piccolo allevamento di pecore ma anche prodotti provenienti da altre fattorie della regione (marmellate, formaggi, birre, miele, biscotti...)."
    ],
    "fr": [
      "Chaque semaine, la Ferme de Mesenguy vous propose des produits issus de son élevage de porcs BIO (viande, charcuterie, terrines, rillettes...), de son petit élevage de moutons mais aussi des produits d’autres fermes de la région (confitures, fromages, bières, miel, biscuits...)."
    ],
    "nl": [
      "Elke week biedt de boerderij van Mesenguy u producten aan van haar biologische varkenshouderij (vlees, vleeswaren, terrines, rillettes, enz.), haar kleine schapenhouderij en ook producten van andere boerderijen uit de streek (jam, kaas, bier, honing, koekjes, enz.)."
    ],
    "es": [
      "Cada semana, la Granja Mesenguy le ofrece productos de su granja de cerdos ecológicos (carne, charcutería, terrinas, rillettes...), de su pequeña granja de ovejas pero también productos de otras granjas de la región (mermeladas, quesos, cervezas, miel, galletas...)."
    ]
  },
