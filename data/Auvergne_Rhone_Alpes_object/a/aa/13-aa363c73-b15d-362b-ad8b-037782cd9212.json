  "rdfs:comment": {
    "de": [
      "Die Mediathek in Lézigneux bietet eine große Auswahl an Büchern für alle Arten von Lesern, von Schulkindern bis hin zu Senioren. Außerdem organisiert sie das ganze Jahr über Veranstaltungen."
    ],
    "en": [
      "The Médiathèque de Lézigneux offers a wide range of books for all types of readers, from schoolchildren to senior citizens. It also organizes events throughout the year."
    ],
    "it": [
      "La biblioteca multimediale Lézigneux offre un'ampia gamma di libri per tutti i tipi di lettori, dagli scolari agli anziani. Organizza inoltre eventi durante tutto l'anno."
    ],
    "fr": [
      "La Médiathèque  de Lézigneux propose un large éventail d'ouvrages s'adressant à tous les types de lecteurs, depuis les enfants de l'école jusqu'au 3e âge. D'autre part, elle organise des manifestations tout au long de l'année."
    ],
    "es": [
      "La biblioteca multimedia Lézigneux ofrece una amplia gama de libros para todo tipo de lectores, desde escolares hasta personas mayores. También organiza eventos a lo largo del año."
    ],
    "nl": [
      "De mediatheek van Lézigneux biedt een breed scala aan boeken voor alle soorten lezers, van schoolkinderen tot senioren. Er worden het hele jaar door evenementen georganiseerd."
    ]
  },
