  "rdfs:comment": {
    "de": [
      "Ihr Restaurant in der Nähe des Flughafens von Grenoble ist 7 Tage die Woche geöffnet. Es ist mit einem neuen Restaurantkonzept ausgestattet und bietet Ihnen eine große Auswahl an Sandwiches. Außerdem können Sie von einer Salatbar und einer Drive-Through-Bahn mit Online-Bestellung profitieren."
    ],
    "en": [
      "Your restaurant, located near Grenoble airport, is open 7 days a week. Equipped with the new catering concept, it offers you a wide range of sandwiches and allows you to enjoy a Salad'Bar and an online drive-through."
    ],
    "it": [
      "Il vostro ristorante, situato vicino all'aeroporto di Grenoble, è aperto 7 giorni alla settimana. Dotato di un nuovo concetto di ristorazione, offre una vasta gamma di panini e permette di usufruire di un Salad'Bar e di un drive-through online."
    ],
    "fr": [
      "Votre restaurant, situé à proximité de l'aéroport de Grenoble est ouvert 7j/7. Doté du nouveau concept de restauration, il vous offre une gamme large de sandwich et vous permet de profiter d'un Salad'Bar et d'une piste drive commande en ligne."
    ],
    "nl": [
      "Uw restaurant, gelegen nabij de luchthaven van Grenoble, is 7 dagen per week geopend. Uitgerust met het nieuwe restaurantconcept biedt het een breed scala aan broodjes en kunt u genieten van een Salad'Bar en een online drive-through."
    ],
    "es": [
      "Su restaurante, situado cerca del aeropuerto de Grenoble, está abierto los 7 días de la semana. Equipado con el nuevo concepto de restaurante, ofrece una amplia gama de sándwiches y permite disfrutar de un Salad'Bar y un drive-through en línea."
    ]
  },
