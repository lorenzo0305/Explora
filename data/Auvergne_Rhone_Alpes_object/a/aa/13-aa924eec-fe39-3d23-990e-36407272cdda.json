  "rdfs:comment": {
    "de": [
      "Planète Apnée ist eine Apnoe-Schule mit Sitz in Annecy!\nEntdecken Sie eine Aktivität für alle und jeden!\nPräsenz am Strand Plant in Veyrier-du-Lac von Anfang Juni bis Ende September und von Oktober bis Mai in Nemo33 in einem beheizten Becken."
    ],
    "en": [
      "Planète Apnée is an apnea school based in Annecy!\nCome and discover an activity for everyone!\nPresent at Plage du Plant in Veyrier-du-Lac from early June to late September and from October to May at Némo33 in a heated pool."
    ],
    "it": [
      "Planète Apnée è una scuola di apnea con sede ad Annecy!\r\nVenite a scoprire un'attività per tutti!\r\nSiamo alla Plage du Plant a Veyrier-du-Lac dall'inizio di giugno alla fine di settembre e al Némo33 da ottobre a maggio in una piscina riscaldata."
    ],
    "fr": [
      "Planète Apnée est une école d'apnée basée sur Annecy !\r\nVenez découvrir une activité pour toutes et tous !\r\nPrésence à la plage du Plant à Veyrier-du-Lac de début juin à fin septembre et de octobre à mai à Némo33 dans un bassin chauffé."
    ],
    "nl": [
      "Planète Apnée is een vrijduikschool in Annecy!\r\nKom en ontdek een activiteit voor iedereen!\r\nWe zijn op het Plage du Plant in Veyrier-du-Lac van begin juni tot eind september en bij Némo33 van oktober tot mei in een verwarmd zwembad."
    ],
    "es": [
      "Planète Apnée es una escuela de apnea situada en Annecy\r\nVen a descubrir una actividad para todos los gustos\r\nEstamos en la Plage du Plant en Veyrier-du-Lac desde principios de junio hasta finales de septiembre y en Némo33 de octubre a mayo en una piscina climatizada."
    ]
  },
