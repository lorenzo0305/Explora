  "rdfs:comment": {
    "de": [
      "Unsere 100 mehrsprachigen Lehrer werden Ihnen die Liebe zum Skifahren in all seinen Formen vermitteln und Ihnen helfen, in Ihrem eigenen Tempo Fortschritte zu machen."
    ],
    "en": [
      "Our 100 multilingual instructors will help you discover the love of skiing in all its forms and help you progress at your own pace."
    ],
    "it": [
      "I nostri 100 istruttori multilingue vi faranno scoprire l'amore per lo sci in tutte le sue forme e vi aiuteranno a progredire al vostro ritmo."
    ],
    "fr": [
      "Nos 100 moniteurs multilingues vous feront découvrir l'amour de la glisse sous toutes ses formes et vous aideront à progresser à votre rythme."
    ],
    "nl": [
      "Onze 100 meertalige instructeurs helpen je de liefde voor skiën in al zijn vormen te ontdekken en helpen je op je eigen tempo vooruitgang te boeken."
    ],
    "es": [
      "Nuestros 100 monitores multilingües le harán descubrir el amor por el esquí en todas sus formas y le ayudarán a progresar a su propio ritmo."
    ]
  },
