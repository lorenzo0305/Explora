  "rdfs:comment": {
    "de": [
      "Als Naturheilpraktikerin und Reflexologin für chinesische Energie empfange ich Sie in meiner Praxis in Buis les Baronnies für eine Beratung oder eine Behandlung mit Fußreflexzonenmassage oder Fuß- und Gesichtsreflexzonenmassage."
    ],
    "en": [
      "Naturopath and Chinese energy reflexologist, I welcome you for a consultation or treatment in foot reflexology, or plantar and facial reflexology at my practice in Buis les Baronnies."
    ],
    "it": [
      "Naturopata e riflessologo energetico cinese, vi accolgo per una consulenza o un trattamento di riflessologia plantare o di riflessologia plantare e facciale presso il mio studio di Buis les Baronnies."
    ],
    "fr": [
      "Naturopathe et Réflexologue en énergétique chinoise, je vous reçois pour une consultation ou un soin en réflexologie plantaire, ou plantaire et faciale à mon cabinet de Buis les Baronnies."
    ],
    "nl": [
      "Natuurgeneeskundige en Chinese energiereflexoloog, ik verwelkom je voor een consult of behandeling in voetreflexologie, of voet- en gezichtsreflexologie in mijn praktijk in Buis les Baronnies."
    ],
    "es": [
      "Naturópata y reflexóloga energética china, le acojo para una consulta o un tratamiento de reflexología podal o reflexología podal y facial en mi consulta de Buis les Baronnies."
    ]
  },
  "rdfs:label": {
