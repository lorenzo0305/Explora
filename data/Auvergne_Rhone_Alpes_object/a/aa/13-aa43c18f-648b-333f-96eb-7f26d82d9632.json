  "rdfs:comment": {
    "de": [
      "Eine familiengeführte, ambulante Mikrobrauerei, die an Bord eines Peugeot J5 4x4 ROSE durch die Region fährt!\r\nReich an einer breiten Palette von Bieren, die sich mit den Jahreszeiten entwickeln, wird jedes Rezept von Hand mit Bio- und lokalem Malz gebraut."
    ],
    "en": [
      "The Beer Truck is a family microbrewery who roams along the region with its ambulant bar ! rich of a vast range of beers, evolving with the seasons, each of receipts is brewed by hand with local and bio malt."
    ],
    "it": [
      "Una micro-birreria famigliale e ambulante che gira nella region con un Peugeot J5 4x4 rosa !\r\nRicca di un vaste panello di birre, evolvendo con le stagioni, ognune ricette è fatta alla mano con malts bio e locali."
    ],
    "fr": [
      "Une microbrasserie familiale et ambulante, qui sillonne la région à bord d'un Peugeot J5 4x4 ROSE !\r\nRiche d'une vaste gamme de bière, évoluant au gré des saisons, chacune des recette est brassée à la main avec des malts bio et locaux."
    ],
    "es": [
      "Una microcervecería familiar en movimiento que recorre la región en un Peugeot J5 4x4 de color ROSA\r\nCon una amplia gama de cervezas que cambian con las estaciones, cada receta se elabora a mano con maltas orgánicas locales."
    ],
    "nl": [
      "Een door een familie gerunde microbrouwerij in beweging, kriskras door de regio in een roze Peugeot J5 4x4!\r\nMet een uitgebreid assortiment bieren dat met de seizoenen mee verandert, wordt elk recept met de hand gebrouwen met biologische, lokale moutsoorten."
    ]
  },
  "rdfs:label": {
    "en": [
      "Beer truck des Alpes"
    ],
    "it": [
      "Beer truck des Alpes (Birreria)"
    ],
    "fr": [
      "Beer truck des Alpes"
    ]
  },
