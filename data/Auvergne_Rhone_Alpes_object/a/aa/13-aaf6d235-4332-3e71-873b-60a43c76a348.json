  "rdfs:comment": {
    "de": [
      "Der Standort Collet d'Allevard verfügt über mehrere Startplätze, die alle eine unterschiedliche Ausrichtung haben. Dieser Platz wird vom Verein Coccin'ailes du pays d'Allevard verwaltet."
    ],
    "en": [
      "The site of Collet d'Allevard has several take-offs which all have a different orientation. This site is managed by the Coccin'ailes club of Allevard."
    ],
    "it": [
      "Il sito del Collet d'Allevard presenta diversi decolli, tutti con orientamenti diversi. Questo sito è gestito dal club Coccin'ailes du pays d'Allevard."
    ],
    "fr": [
      "Le site du Collet d'Allevard dispose de plusieurs décollages qui ont tous une orientation différente. Ce site est géré par le club des Coccin'ailes du pays d'Allevard."
    ],
    "es": [
      "El emplazamiento del Collet d'Allevard cuenta con varios despegues, todos ellos con diferentes orientaciones. Este sitio está gestionado por el club Coccin'ailes du pays d'Allevard."
    ],
    "nl": [
      "De site van Collet d'Allevard heeft verschillende opstijgingen, allemaal met verschillende oriëntaties. Deze site wordt beheerd door de club Coccin'ailes du pays d'Allevard."
    ]
  },
  "rdfs:label": {
