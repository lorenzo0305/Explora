  "rdfs:comment": {
    "de": [
      "19 Uhr Nächtlicher Boule-Wettbewerb. Die Atmosphäre wird familiär und freundlich sein. Unsere Erfrischungsstände werden ebenfalls geöffnet sein. Wir zählen auf Ihre Anwesenheit"
    ],
    "en": [
      "7pm Petanque competition by night. A friendly, family atmosphere. Our refreshment bar will also be on hand. We look forward to seeing you there"
    ],
    "it": [
      "alle 19:00 gara di petanque in notturna. Un'atmosfera amichevole e familiare. Sarà presente anche il nostro bar per il ristoro. Non vediamo l'ora di vedervi lì"
    ],
    "fr": [
      "19h Concours de pétanque en nocturne. L’ambiance sera familiale et amicale. Notre buvette sera, elle aussi du rendez vous. On compte sur votre présence"
    ],
    "es": [
      "7 de la tarde Competición nocturna de petanca. Un ambiente agradable y familiar. Nuestro bar de refrescos también estará a su disposición. Le esperamos"
    ],
    "nl": [
      "19.00 Petanquewedstrijd bij nacht. Een gezellige, familiale sfeer. Onze verfrissingsbar zal ook aanwezig zijn. We kijken ernaar uit om je daar te zien"
    ]
  },
