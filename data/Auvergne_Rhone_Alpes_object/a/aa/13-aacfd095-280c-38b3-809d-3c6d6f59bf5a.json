  "rdfs:comment": {
    "de": [
      "Genießen Sie einen atemberaubenden Blick auf den Mont-Blanc.\r\nMit der Gondelbahn Princesse können Sie in 10 Minuten auf den Gipfel des Mont d'Arbois gelangen."
    ],
    "en": [
      "Enjoy breathtaking views of Mont Blanc.\r\nThe Princesse cablecar drives you to the top of Mont d'Arbois in 10 minutes."
    ],
    "it": [
      "Approfittate di una vista mozzafiato sul Monte Bianco.\r\nLa telecabina Princesse vi permette di accedere alla vetta del Mont d'Arbois in 10 minuti. In cima, troverete il punto di partenza di numerose piste da sci."
    ],
    "fr": [
      "Profitez d’une vue imprenable sur le Mont-Blanc.\r\nLa télécabine de la  Princesse vous permet d’accéder au sommet du Mont d’Arbois en 10 minutes."
    ],
    "nl": [
      "Geniet van een adembenemend uitzicht op de Mont Blanc.\r\nDe Princesse kabelbaan brengt je in 10 minuten naar de top van de Mont d'Arbois."
    ],
    "es": [
      "Disfrute de las impresionantes vistas del Mont Blanc.\r\nEl teleférico Princesse te lleva a la cima del Mont d'Arbois en 10 minutos."
    ]
  },
  "rdfs:label": {
