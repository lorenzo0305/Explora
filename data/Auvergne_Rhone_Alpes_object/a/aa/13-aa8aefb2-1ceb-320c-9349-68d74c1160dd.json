  "rdfs:comment": {
    "de": [
      "Im Herzen des Skigebiets von Les Karellis können Sie die savoyischen Spezialitäten genießen und von der Terrasse dieses Bar-Restaurants profitieren.\r\nMöglichkeit zum Empfang von Gruppen, nur auf Reservierung."
    ],
    "en": [
      "In the heart of the skiing area of Les Karellis, let's taste savoyarde specialities and enjoy the terrace of this bar & restaurant.\r\n\r\nFor groups, by reservation only"
    ],
    "it": [
      "Nel cuore del comprensorio sciistico di Karellis, venite a gustare le specialità savoiarde e la terrazza di questo bar-ristorante.\r\nPossibilità di accogliere gruppi, solo su prenotazione."
    ],
    "fr": [
      "En plein coeur du domaine skiable des Karellis, venez savourer les spécialités savoyardes et profiter de la terrasse de ce bar-restaurant.\r\nPossibilité d'accueil groupe, sur réservation uniquement."
    ],
    "nl": [
      "Kom in het hart van het Karellis-skigebied genieten van Savoyaardse specialiteiten en het terras van dit bar-restaurant.\r\nMogelijkheid tot ontvangst van groepen, uitsluitend op reservering."
    ],
    "es": [
      "En el corazón del dominio esquiable de Karellis, venga a disfrutar de las especialidades saboyanas y de la terraza de este bar-restaurante.\r\nPosibilidad de acoger grupos, sólo con reserva."
    ]
  },
  "rdfs:label": {
    "en": [
      "le Vinouva, Mountain restaurant"
    ],
    "fr": [
      "Le Vinouva, Snack d'altitude"
    ]
  },
