  "rdfs:comment": {
    "de": [
      "Mittelschwere Strecke von Chinaillon, die in der Nähe des Sees von La Cour vorbeiführt, um den Fuß des Maroly-Tals zu erreichen und bis zur Ankunft des Almet-Skilifts zu gehen. Vom Gipfel aus hat man einen herrlichen Blick auf die Aravis Range."
    ],
    "en": [
      "Intermediate level itinerary from Chinaillon which passes near the lake of La Cour to reach the foot of the Maroly valley and go up to the arrival of the ski lift of Almet. Splendid view on the Aravis chain at the top."
    ],
    "it": [
      "Un percorso di livello intermedio da Chinaillon che passa vicino al Lac de la Cour per raggiungere i piedi della valle del Maroly e salire fino all'arrivo dell'impianto di risalita di Almet. Dalla cima si gode di una magnifica vista sulla catena degli Aravis."
    ],
    "fr": [
      "Itinéraire niveau intermédiaire au départ du Chinaillon qui passe à proximité du lac de la Cour pour gagner le pied de la vallée du Maroly et la remonter jusqu'à l'arrivée du téléski de l'Almet. Vue splendide sur la chaîne des Aravis au sommet."
    ],
    "es": [
      "Ruta de nivel intermedio desde Chinaillon que pasa cerca del Lac de la Cour para llegar al pie del valle de Maroly y subir hasta la meta del remonte de Almet. Magníficas vistas de la cordillera de Aravis desde la cima."
    ],
    "nl": [
      "Een route van gemiddeld niveau vanuit Chinaillon die dicht langs het Lac de la Cour loopt om de voet van de Maroly-vallei te bereiken en omhoog te klimmen naar het eindpunt van de Almet-skilift. Prachtig uitzicht op het Aravis-gebergte vanaf de top."
    ]
  },
  "rdfs:label": {
    "de": [
      "Skitourenroute - L'Almet"
    ],
    "en": [
      "Ski touring route - L'Almet"
    ],
    "fr": [
      "Itinéraire ski de randonnée - L'Almet"
    ]
  },
