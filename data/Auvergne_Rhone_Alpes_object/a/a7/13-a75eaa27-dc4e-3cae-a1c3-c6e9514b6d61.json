  "rdfs:comment": {
    "de": [
      "Der Bauernhof befindet sich in Saint-Sandoux und Saint Amant Tallende. Die Obstplantagen werden biologisch bewirtschaftet und der Verkauf erfolgt hauptsächlich über Direktvermarktung."
    ],
    "en": [
      "The farm is located in Saint-Sandoux and Saint Amant Tallende. The orchards are conducted in organic farming and the sale is done mainly in direct sale."
    ],
    "it": [
      "La fattoria si trova a Saint-Sandoux e Saint Amant Tallende. I frutteti sono gestiti in agricoltura biologica e la vendita avviene principalmente in forma diretta."
    ],
    "fr": [
      "La ferme est située à Saint-Sandoux et Saint Amant Tallende. Les vergers sont conduis en agriculture biologique et la vente se fait essentiellement en vente directe."
    ],
    "es": [
      "La granja se encuentra en Saint-Sandoux y Saint Amant Tallende. Los huertos se gestionan en agricultura ecológica y la venta se realiza principalmente en venta directa."
    ],
    "nl": [
      "De boerderij ligt in Saint-Sandoux en Saint Amant Tallende. De boomgaarden worden beheerd in biologische landbouw en de verkoop gebeurt hoofdzakelijk in rechtstreekse verkoop."
    ]
  },
  "rdfs:label": {
