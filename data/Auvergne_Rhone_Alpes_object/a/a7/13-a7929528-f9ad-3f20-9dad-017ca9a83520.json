  "rdfs:comment": {
    "de": [
      "Eingebettet in 1250 m Höhe liegt Vaujany in einem großen Gebiet, das mit Alpe d'Huez verbunden ist, im Herzen von Oisans in den Nordalpen."
    ],
    "en": [
      "Nestled at an altitude of 1250m, Vaujany is located on a vast estate connected to Alpe d'Huez in the heart of Oisans in the Northern Alps."
    ],
    "it": [
      "Ad un'altitudine di 1250 m, Vaujany si trova in una vasta area sciistica collegata all'Alpe d'Huez, nel cuore dell'Oisans, nelle Alpi settentrionali."
    ],
    "fr": [
      "Niché à 1250m d'altitude, Vaujany est situé sur un vaste domaine relié à l'Alpe d'Huez au cœur de l'Oisans dans les Alpes du Nord."
    ],
    "es": [
      "Situado a 1250 m de altitud, Vaujany se encuentra en un vasto dominio esquiable vinculado a Alpe d'Huez, en el corazón de los Oisans, en los Alpes del Norte."
    ],
    "nl": [
      "Het VVV-kantoor is het hele jaar door geopend en verwelkomt u elke dag tijdens het seizoen en van maandag tot vrijdag tijdens het tussenseizoen.\r\nOns onthaalpersoneel stelt u verschillende, gratis diensten voor :"
    ]
  },
