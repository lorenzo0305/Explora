  "rdfs:comment": {
    "de": [
      "Vercors Aventure ist ein Veranstaltungsunternehmen mit Sitz in der Region Vercors. Haben Sie Lust auf Familienausflüge, Aktivitäten in der Natur oder möchten Sie ein Seminar für Ihre Teammitglieder organisieren?"
    ],
    "en": [
      "Vercors Aventure is an event management company based in the Vercors. Do you want to go on a family outing, enjoy activities out in the country or organise a seminar for your team members?"
    ],
    "it": [
      "Cercate gite in famiglia, attività all'aria aperta o un seminario per il vostro team?"
    ],
    "fr": [
