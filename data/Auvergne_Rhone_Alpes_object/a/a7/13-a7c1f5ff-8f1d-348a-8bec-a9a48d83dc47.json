  "rdfs:comment": {
    "de": [
      "Das Restaurant des Village Auvergnat bietet eine traditionelle Küche mit starker auvergnatischer Färbung, die Sie am Fuße des Puy de Dôme in einer gemütlichen Umgebung genießen können."
    ],
    "en": [
      "The Village Auvergnat restaurant offers traditional cuisine with a strong Auvergne flavour, to be enjoyed in a warm setting at the foot of the Puy de Dôme."
    ],
    "it": [
      "Il ristorante Auvergnat Village offre una cucina tradizionale dal forte sapore d'Alvernia, da gustare ai piedi del Puy de Dôme in un ambiente accogliente."
    ],
    "fr": [
      "Le restaurant du Village Auvergnat propose une cuisine traditionnelle à forte coloration auvergnate, à déguster au pied du Puy de Dôme dans un cadre chaleureux."
    ],
    "nl": [
      "Het restaurant Auvergnat Village biedt een traditionele keuken met een sterke Auvergne-smaak, te genieten aan de voet van de Puy de Dôme in een warm kader."
    ],
    "es": [
      "El restaurante del pueblo de Auvergnat ofrece una cocina tradicional con un fuerte sabor a Auvernia, que se puede degustar al pie del Puy de Dôme en un entorno cálido."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Village Auvergnat"
    ]
  },
