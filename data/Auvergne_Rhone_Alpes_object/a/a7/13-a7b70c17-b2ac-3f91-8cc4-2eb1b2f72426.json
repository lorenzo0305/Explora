  "rdfs:comment": {
    "de": [
      "La Voulte-sur-Rhône ist der Ausgangspunkt der Dolce-Via-Route. Sie verlassen die ViaRhôna und fahren mit dem Fahrrad in das Tal des Eyrieux auf der Jagd nach alten Lokomotiven."
    ],
    "en": [
      "La Voulte-sur-Rhône is the starting point of the Dolce Via route. You leave ViaRhôna to cycle into the Eyrieux valley in pursuit of the old locomotives."
    ],
    "it": [
      "La Voulte-sur-Rhône è il punto di partenza dell'itinerario Dolce Via. Lasciate la ViaRhôna e pedalate nella valle dell'Eyrieux alla ricerca delle vecchie locomotive."
    ],
    "fr": [
      "La Voulte-sur-Rhône est le point de départ de l'itinéraire Dolce Via. Vous quittez ViaRhôna pour pénétrer à vélo dans la vallée de l'Eyrieux à la poursuite des anciennes locomotives."
    ],
    "nl": [
      "La Voulte-sur-Rhône is het vertrekpunt van de Dolce Via route. Verlaat de ViaRhôna en fiets de Eyrieux-vallei in op zoek naar de oude locomotieven."
    ],
    "es": [
      "La Voulte-sur-Rhône es el punto de partida del itinerario de la Dolce Via. Abandone la ViaRhôna y adéntrese en bicicleta en el valle de Eyrieux en busca de las antiguas locomotoras."
    ]
  },
  "rdfs:label": {
    "en": [
      "Dolce Via - La-Voulte-sur-Rhône to Les-Ollière-sur-Eyrieux"
    ],
    "fr": [
      "Dolce Via de La Voulte-sur-Rhône à Les Ollières-sur-Eyrieux"
    ]
  },
