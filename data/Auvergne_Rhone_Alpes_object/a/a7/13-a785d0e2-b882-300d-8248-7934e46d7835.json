  "rdfs:comment": {
    "de": [
      "Yoann, Sandrine und ihr Team freuen sich, Sie in einer gemütlichen Umgebung an der Talstation des Sessellifts von Plan Bois begrüßen zu dürfen."
    ],
    "en": [
      "Yoann and Sandrine and their team are looking forward to seeing you in their cosy restaurant at the bottom of Plan Bois chairlift."
    ],
    "it": [
      "Yoann, Sandrine e il loro team sono lieti di accogliervi in un ambiente caloroso alla partenza della seggiovia di Plan Bois."
    ],
    "fr": [
      "Yoann, Sandrine et leur équipe sont heureux de vous accueillir dans un cadre chaleureux au départ du télésiège de Plan Bois."
    ],
    "es": [
      "Yoann, Sandrine y su equipo estarán encantados de recibirle en un ambiente acogedor al comienzo del telesilla Plan Bois."
    ],
