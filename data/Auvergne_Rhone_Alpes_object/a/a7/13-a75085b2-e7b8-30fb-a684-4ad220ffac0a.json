  "rdfs:comment": {
    "de": [
      "Drômans Cadences feiert sein 10-jähriges Bestehen mit der Familie Michel und lädt die Komponistin Camille Pépin und befreundete Musiker ein! Ein Konzert, das dieser jungen Komponistin und Komponistinnen im Laufe der Jahrhunderte gewidmet ist!"
    ],
    "en": [
      "Drômans Cadences celebrates its 10th anniversary with the Michel family, inviting composer Camille Pépin and musician friends! A concert dedicated to this young composer and to women composers through the centuries!"
    ],
    "it": [
      "Drômans Cadences festeggia il suo 10° anniversario con la famiglia Michel, invitando la compositrice Camille Pépin e alcuni amici musicisti! Un concerto dedicato a questa giovane compositrice e alle donne compositrici attraverso i secoli!"
    ],
    "fr": [
      "Drômans Cadences fête ses 10 ans avec la famille Michel, en invitant la compositrice Camille Pépin et des amis musiciens ! Un concert consacré à cette jeune compositrice et aux femmes compositrices à travers les siècles !"
    ],
    "nl": [
      "Drômans Cadences viert zijn 10e verjaardag met de familie Michel, met componist Camille Pépin en enkele bevriende musici! Een concert gewijd aan deze jonge componiste en aan vrouwelijke componisten door de eeuwen heen!"
    ],
    "es": [
      "Drômans Cadences celebra su 10º aniversario con la familia Michel, invitando a la compositora Camille Pépin y a algunos músicos amigos Un concierto dedicado a esta joven compositora y a las mujeres compositoras a lo largo de los siglos"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Concert : Orchestre symphonique Allegro"
    ]
  },
