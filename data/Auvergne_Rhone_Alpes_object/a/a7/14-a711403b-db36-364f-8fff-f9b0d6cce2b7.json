  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/95aaa8cd-f116-3f16-afb4-a06c59196f43",
      "dc:description": {
        "de": [
          "Großes Familienspiel von 10:30 bis 12:00 Uhr.\nFür alle offen.\nAnmeldung im Fremdenverkehrsamt erforderlich.\n3 Euro pro Person, Kinder unter 12 Jahren sind kostenlos.\nTreffen Sie sich mit Ihrer Wasserflasche auf der Esplanade."
        ],
        "en": [
          "Great Family Game from 10:30am to 12pm.\nOpen to all.\nRegistration essential at the Tourist Office.\n3 euros per person, free for children under 12.\nMeet at the esplanade with your bottle of water."
        ],
        "it": [
          "Grande gioco per famiglie dalle 10.30 alle 12.00.\nAperto a tutti.\nIscrizione obbligatoria presso l'Ufficio del Turismo.\n3 euro a persona, gratis per i bambini sotto i 12 anni.\nRitrovo alla spianata con bottiglia d'acqua."
        ],
        "fr": [
          "Grand Jeu en Famille de 10h30 à 12h. \nOuvert à tous. \nInscription indispensable à l'Office de Tourisme. \n3 euros par personne, gratuit pour les enfants de moins de 12 ans. \nRendez-vous à l'esplanade avec votre bouteille d'eau."
        ],
        "nl": [
          "Groot familiespel van 10.30 tot 12.00 uur.\nVoor iedereen toegankelijk.\nAanmelding verplicht bij het toeristenbureau.\n3 euro per persoon, gratis voor kinderen onder de 12 jaar.\nVerzamelen op de esplanade met een fles water."
        ],
        "es": [
          "Gran juego familiar de 10.30 a 12 h.\nAbierto a todos.\nImprescindible inscribirse en la Oficina de Turismo.\n3 euros por persona, gratis para los menores de 12 años.\nCita en la explanada con su botella de agua."
        ]
      },
      "@type": [
        "Description"
