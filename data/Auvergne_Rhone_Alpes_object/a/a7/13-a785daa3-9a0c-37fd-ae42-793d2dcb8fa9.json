  "rdfs:comment": {
    "de": [
      "Vom Orientierungstisch aus bietet sich ein herrlicher Blick auf die Ausläufer der Alpen, den Mont-Ventoux, das Rhonetal und die Berge der Ardèche. Die Kalköfen zeugen von der industriellen Vergangenheit."
    ],
    "en": [
      "The viewpoint overlooks the foothills of the Alps, Mont Ventoux, the Rhône valley and the Ardèche mountains. Lime kilns bear witness to the industrial past."
    ],
    "it": [
      "Dal tavolo di orientamento si gode di una superba vista sulle Prealpi, sul Mont Ventoux, sulla valle del Rodano e sulle montagne dell'Ardèche. I forni per la calce testimoniano il passato industriale."
    ],
    "fr": [
      "Depuis la table d’orientation se dégage une superbe vue sur les contreforts des Alpes, le Mont-Ventoux, la vallée du Rhône et les monts d’Ardèche. Les fours à chaux témoignent du passé industriel."
    ],
    "nl": [
      "Vanaf de oriëntatietafel heb je een prachtig uitzicht op de uitlopers van de Alpen, de Mont Ventoux, de Rhônevallei en de bergen van de Ardèche. De kalkovens getuigen van het industriële verleden."
    ],
    "es": [
      "Desde la mesa de orientación hay una magnífica vista de las estribaciones de los Alpes, el Mont Ventoux, el valle del Ródano y las montañas de Ardèche. Los hornos de cal son testigos del pasado industrial."
    ]
  },
