  "rdfs:comment": {
    "de": [
      "Unter ihrem Kammglockenturm besitzt diese alte romanische Kirche aus dem 12. Jahrhundert eine bedeutende Folge von Fresken aus dem 14. und 16."
    ],
    "en": [
      "Beneath its combed bell tower, this former 12th-century Romanesque church boasts an important series of 14th- and 16th-century frescoes."
    ],
    "it": [
      "Sotto il suo campanile a pettine, questa ex chiesa romanica del XII secolo vanta un'importante serie di affreschi del XIV e XVI secolo."
    ],
    "fr": [
      "Sous son clocher à peigne, cette ancienne église romane du XIIe siècle possède une importante suite de fresques des XIVe et XVIe siècles."
    ],
    "nl": [
      "Onder de gekamde klokkentoren heeft deze voormalige Romaanse kerk uit de 12e eeuw een belangrijke reeks fresco's uit de 14e en 16e eeuw."
    ],
    "es": [
      "Bajo su campanario peinado, esta antigua iglesia románica del siglo XII conserva un importante conjunto de frescos de los siglos XIV y XVI."
    ]
  },
