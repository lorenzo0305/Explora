  "rdfs:comment": {
    "de": [
      "Pierre Lesicki ist ein leidenschaftlicher Koch und bevorzugt frische und qualitativ hochwertige Zutaten.\nAlle seine Gerichte werden in seinem Atelier in Chabeuil zubereitet, wo er seit über 20 Jahren ansässig ist."
    ],
    "en": [
      "A passionate chef, Pierre Lesicki favors fresh, high-quality ingredients.\nAll his dishes are cooked in his workshop in Chabeuil, where he has been established for over 20 years, and can be taken away or served with service and crockery included."
    ],
    "it": [
      "Chef appassionato, Pierre Lesicki predilige ingredienti freschi e di qualità.\nTutti i suoi piatti sono cucinati nel suo laboratorio di Chabeuil, dove si è stabilito da oltre 25 anni, e possono essere portati via o serviti con servizio e stoviglie inclusi."
    ],
    "fr": [
      "Passionné, Pierre Lesicki privilégie les ingrédients  frais et de qualité. \nA emporter ou prestations avec service et vaisselle inclus, tous ses plats sont cuisinés dans son atelier de Chabeuil où il est implanté depuis plus de 25 ans."
    ],
    "nl": [
      "Pierre Lesicki is een gepassioneerde chef-kok die de voorkeur geeft aan verse ingrediënten van hoge kwaliteit.\nAl zijn gerechten worden bereid in zijn atelier in Chabeuil, waar hij al meer dan 20 jaar gevestigd is, en kunnen worden meegenomen of geserveerd met servies en bestek."
    ],
    "es": [
      "Chef apasionado, Pierre Lesicki privilegia los ingredientes frescos y de calidad.\nTodos sus platos se cocinan en su taller de Chabeuil, donde está establecido desde hace más de 25 años, y se pueden llevar o servir con servicio y vajilla incluidos."
    ]
  },
  "rdfs:label": {
