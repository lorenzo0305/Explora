  "rdfs:comment": {
    "de": [
      "Geocaching ist ein Outdoor-Abenteuer in Flaine, das Erkundung und Technologie miteinander verbindet. Bewaffnet mit einer mobilen App machen Sie sich auf die Suche nach Caches, die an malerischen Orten versteckt sind. Jeder Cache enthält ein Logbuch und kleine Gegenstände."
    ],
    "en": [
      "Geocaching is an outdoor adventure in Flaine, combining exploration and technology. Armed with a mobile app, set off in search of caches hidden in picturesque locations. Each cache contains a register and small objects."
    ],
    "it": [
      "Il geocaching è un'avventura all'aperto a Flaine, che unisce esplorazione e tecnologia. Armati di un'applicazione mobile, si parte alla ricerca di cache nascoste in luoghi pittoreschi. Ogni cache contiene un registro e piccoli oggetti."
    ],
    "fr": [
      "Le géocaching est une aventure de plein air à Flaine, alliant exploration et technologie. Armé d'une application mobile, partez à la recherche de caches dissimulées dans des lieux pittoresques. Chaque cache contient un registre et de petits objets."
    ],
    "nl": [
      "Geocaching is een buitenavontuur in Flaine dat exploratie en technologie combineert. Gewapend met een mobiele app ga je op zoek naar caches die verborgen liggen op schilderachtige locaties. Elke cache bevat een register en kleine voorwerpen."
    ],
    "es": [
      "El geocaching es una aventura al aire libre en Flaine que combina exploración y tecnología. Armado con una aplicación móvil, salga en busca de cachés escondidos en lugares pintorescos. Cada caché contiene un registro y pequeños objetos."
    ]
  },
