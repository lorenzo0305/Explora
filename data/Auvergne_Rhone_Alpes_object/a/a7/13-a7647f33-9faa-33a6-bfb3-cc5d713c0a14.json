  "rdfs:comment": {
    "de": [
      "Le Schuss empfängt Sie in einer angenehmen und sympathischen Atmosphäre. Dieses Bar-Restaurant bietet Spezialitäten aus den Bergen, verfügt über eine Sonnenterrasse und ist auch eine Cocktailbar."
    ],
    "en": [
      "Emeric and Helen and their team welcome you in a warm and cosy atmosphere. This bar-restaurant offers mountain specialities (fondues, raclette, tartiflette, schuss salads. . . ). It has a sunny terrace with deckchairs on the Place des Écrins. Also Cocktail Bar."
    ],
    "it": [
      "Lo Schuss vi accoglie in un'atmosfera piacevole e amichevole. Questo bar-ristorante offre specialità di montagna, dispone di una terrazza soleggiata ed è anche un cocktail bar."
    ],
    "fr": [
      "Le Schuss vous accueille dans une ambiance agréable et sympathique. Ce bar-restaurant propose des spécialités montagnardes, dispose d'une terrasse ensoleillée et fait également bar à Cocktails."
    ],
    "nl": [
      "Le Schuss verwelkomt u in een aangename en sympathieke sfeer.  Deze bar-restaurant biedt bergspecialiteiten (fondues, raclette, salades,...) Zij beschikt over een zonnig terras met ligstoelen en is gelegen op de place des Ecrins."
    ],
    "es": [
      "El Schuss le da la bienvenida en un ambiente agradable y acogedor. Este bar-restaurante ofrece especialidades de montaña, tiene una terraza soleada y es también un bar de cócteles."
    ]
  },
  "rdfs:label": {
