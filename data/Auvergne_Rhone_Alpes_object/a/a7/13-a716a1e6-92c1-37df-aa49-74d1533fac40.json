  "rdfs:comment": {
    "de": [
      "Willkommen in Cabane, Atelier und Boutique im Schatten des überdachten Platzes! Entdecken Sie die handgefertigten Kreationen und das Know-how von Roxanne Riou und Alice Corbel, Töpferkeramikerin und Lederschuhmacherin.\r\nHandgemacht / Kurse, Einführungen / Atelierbesuche"
    ],
    "en": [
      "Welcome to Cabane, a workshop-boutique in the shade of the covered square! Discover the artisanal creations and know-how of Roxanne Riou and Alice Corbel, ceramicist, potter and shoemaker.\r\nHandmade / Classes, initiations / Workshop visits"
    ],
    "it": [
      "Benvenuti alla Cabane, un'officina-boutique all'ombra della piazza coperta! Scoprite le creazioni artigianali e il know-how di Roxanne Riou e Alice Corbel, ceramista e pellettiera.\r\nFatto a mano / Corsi, iniziazioni / Visite ai laboratori"
    ],
    "fr": [
      "Bienvenue à Cabane, atelier-boutique à l'ombre de la Place couverte ! Découvrez les créations artisanales et les savoir-faire de Roxanne Riou et Alice Corbel, céramiste potière et chausseuse maroquinière.\r\nFait-main / Cours, initiations / Visites d'atelier"
    ],
    "nl": [
      "Welkom bij Cabane, een atelier-boutique in de schaduw van het overdekte plein! Ontdek de handgemaakte creaties en knowhow van Roxanne Riou en Alice Corbel, keramiste en lederbewerker.\r\nHandgemaakt / Cursussen, inwijdingen / Workshop bezoeken"
    ],
    "es": [
      "Bienvenido a Cabane, un taller-boutique a la sombra de la plaza cubierta Descubra las creaciones artesanales y el saber hacer de Roxanne Riou y Alice Corbel, ceramista y marroquinera.\r\nHecho a mano / Cursos, iniciaciones / Visitas a talleres"
    ]
  },
