  "rdfs:comment": {
    "de": [
      "Entdecken Sie das alte Zollhaus im Dorf Le Sappey am Rande der Departementale Nr. 15. Die Zollstationen wurden errichtet, um die Ein- und Ausreise von Lebensmitteln, aber auch von zonischen Landwirtschaftsbetrieben zu kontrollieren."
    ],
    "en": [
      "Discover the old customs house in the village of Le Sappey, on the edge of the départementale n°15. Customs posts were built to control the entry and exit of goods, but also of Zonian farms."
    ],
    "it": [
      "Scoprite l'antico posto di dogana nel villaggio di Le Sappey, ai margini della départementale n. 15. I posti di dogana sono stati costruiti per controllare l'entrata e l'uscita delle merci, nonché le aziende agricole zoniane."
    ],
    "fr": [
      "Découvrez l'ancienne douane du village du Sappey au bord de la départementale n°15. Les postes de douane furent construits pour contrôler l’entrée et la sortie des denrées, mais également des exploitations agricoles zoniennes."
    ],
    "nl": [
      "Ontdek het oude douanehuis van het dorp Le Sappey aan de rand van de departementale weg nr. 15. De douaneposten werden gebouwd om de binnenkomst en uitgang van goederen, maar ook van Zoniaanse boerderijen te controleren."
    ],
    "es": [
      "Descubra el antiguo puesto aduanero del pueblo de Le Sappey, en el límite del départementale nº 15. Los puestos aduaneros se construyeron para controlar la entrada y salida de mercancías, así como las granjas zonales."
    ]
  },
  "rdfs:label": {
