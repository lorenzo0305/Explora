  "rdfs:comment": {
    "de": [
      "In dem hübschen Dorf Roisey im Herzen des Pilat bemühen wir uns, mit lokalen Produzenten und frischen Qualitätsprodukten zu arbeiten, um eine Küche mit Inspirationen von hier und anderswo anzubieten."
    ],
    "en": [
      "In the pretty village of Roisey, in the heart of the Pilat region, we strive to work with local producers and fresh quality produce, to offer a cuisine inspired by local and international influences."
    ],
    "it": [
      "Nel grazioso villaggio di Roisey, nel cuore del Pilat, ci sforziamo di lavorare con i produttori locali e con prodotti freschi e di qualità, per offrire una cucina ispirata da qui e altrove."
    ],
    "fr": [
      "Dans le joli village de Roisey, au cœur du Pilat, nous nous efforçons à travailler avec des producteurs locaux et des produits frais de qualité, pour proposer une cuisine aux inspirations d’ici et d’ailleurs."
    ],
    "nl": [
      "In het mooie dorpje Roisey, in het hart van Pilat, streven we ernaar te werken met lokale producenten en verse kwaliteitsproducten, om een keuken aan te bieden die is geïnspireerd op hier en elders."
    ],
    "es": [
      "En el bonito pueblo de Roisey, en el corazón del Pilat, nos esforzamos por trabajar con productores locales y productos frescos de calidad, para ofrecer una cocina inspirada en aquí y en otros lugares."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Escale à Roisey"
    ]
  },
