  "rdfs:comment": {
    "de": [
      "Der Zugang ist frei. Der Name Montmarault wird erstmals im 12. Jahrhundert unter dem Namen MONS SMARAGDI erwähnt, der im 14. Jahrhundert zu MONS MERALDI oder MONS MERAUDI wird."
    ],
    "en": [
      "Free access. The name Montmarault is first mentioned in the 12th century as MONS SMARAGDI, which became MONS MERALDI or MONS MERAUDI in the 14th century."
    ],
    "it": [
      "Accesso libero. Il nome Montmarault viene citato per la prima volta nel XII secolo come MONS SMARAGDI, che diventa MONS MERALDI o MONS MERAUDI nel XIV secolo."
    ],
    "fr": [
      "Accès libre. Le nom de Montmarault se trouve mentionné pour la première fois au XIIe siècle sous le nom de MONS SMARAGDI qui devient au XIVe siècle MONS MERALDI ou MONS MERAUDI."
    ],
    "nl": [
      "Vrije toegang. De naam Montmarault wordt voor het eerst vermeld in de 12e eeuw als MONS SMARAGDI, dat in de 14e eeuw MONS MERALDI of MONS MERAUDI werd."
    ],
    "es": [
      "Acceso libre. El nombre de Montmarault se menciona por primera vez en el siglo XII como MONS SMARAGDI, que se convirtió en MONS MERALDI o MONS MERAUDI en el siglo XIV."
    ]
  },
