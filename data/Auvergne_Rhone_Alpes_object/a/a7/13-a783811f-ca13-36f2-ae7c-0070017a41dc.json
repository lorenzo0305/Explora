  "rdfs:comment": {
    "de": [
      "Air Passion ODVL wurde Ende der 80er Jahre von Didier Mathurin gegründet. Éric, ein Mitglied der France Delta Group, bietet Ihnen Sommer- und Winterflüge mit zwei Sitzplätzen an."
    ],
    "en": [
      "Air Passion ODVL was founded in the late 80s by Didier Mathurin. Éric, a member of the France Delta Group, offers you two-seater flights, summer and winter alike."
    ],
    "it": [
      "Air Passion ODVL è stata fondata alla fine degli anni '80 da Didier Mathurin. Éric, membro del Gruppo France Delta, offre voli biposto sia in estate che in inverno."
    ],
    "fr": [
      "Air Passion ODVL a été créée à la fin des années 80 par Didier Mathurin. Éric, membre du Groupe France Delta, vous propose des vols bi-place, été comme hiver."
    ],
    "nl": [
      "Air Passion ODVL werd eind jaren 80 opgericht door Didier Mathurin. Éric, dat deel uitmaakt van de groep France Delta, biedt zowel in de zomer als in de winter tweezitsvluchten aan."
    ],
    "es": [
      "Air Passion ODVL fue fundada a finales de los años 80 por Didier Mathurin. Éric, miembro del grupo France Delta, ofrece vuelos biplaza tanto en verano como en invierno."
    ]
  },
