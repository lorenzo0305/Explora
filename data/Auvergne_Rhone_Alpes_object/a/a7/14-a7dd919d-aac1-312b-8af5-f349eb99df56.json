  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/87191723-31f8-348e-9c05-e698f685168f",
      "dc:description": {
        "de": [
          "Die Handwerker und Händler von Oignies treffen sich mit Ihnen auf dem Platz, wo Sie zahlreiche Chalets und viele Animationen, die vom Weihnachtszauber animiert werden, entdecken können."
        ],
        "en": [
          "Oignies' artisans and shopkeepers will be on hand to welcome you to the square, where you'll discover a host of chalets and entertainment brought to life by Noël magique."
        ],
        "it": [
          "Gli artigiani e i negozianti di Oignies saranno presenti in piazza per presentare una serie di chalet e di intrattenimenti che animeranno Noël magique."
        ],
        "fr": [
          "Les artisans et commerçants de Oignies vous donnent rendez-vous sur la place pour vous faire découvrir de nombreux chalets et de nombreuses animations animées par Noël magique."
        ],
        "es": [
          "Los artesanos y comerciantes de Oignies estarán presentes en la plaza para presentar un sinfín de chalés y animaciones animadas por Noël magique."
        ],
        "nl": [
          "De ambachtslieden en winkeliers van Oignies zullen op het plein aanwezig zijn om een heleboel chalets en animaties te presenteren die door Noël magique tot leven worden gebracht."
        ]
      },
