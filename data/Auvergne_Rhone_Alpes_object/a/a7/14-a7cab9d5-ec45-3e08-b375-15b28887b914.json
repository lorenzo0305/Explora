  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/c01d2864-11bf-3192-86f8-5e5823db795d",
      "dc:description": {
        "de": [
          "Als Bank ist die Banque Populaire du Nord dazu da, Ihnen zu helfen, Ihre Finanzen auf einfache und effiziente Weise zu verwalten. Sie verfügen über ein praktisches Netz von Geldautomaten, damit Sie jederzeit auf Ihr Geld zugreifen können."
        ],
        "en": [
          "As a bank, Banque Populaire du Nord is there to help you manage your finances simply and efficiently. They have a network of convenient ATMs to enable you to access your funds at any time."
        ],
        "it": [
          "Come banca, la Banque Populaire du Nord vi aiuta a gestire le vostre finanze in modo semplice ed efficiente. Dispone di una rete di comodi sportelli bancomat per permettervi di accedere ai vostri fondi in qualsiasi momento."
        ],
        "fr": [
          "En tant que banque, Banque Populaire du Nord est là pour vous aider à gérer vos finances de manière simple et efficace. Ils disposent d'un réseau de distributeurs automatiques de billets pratique pour vous permettre d'accéder à vos fonds à tout moment."
        ],
        "es": [
          "Como banco, Banque Populaire du Nord está ahí para ayudarle a gestionar sus finanzas de forma sencilla y eficaz. Disponen de una red de cajeros automáticos para que pueda acceder a sus fondos en cualquier momento."
        ],
        "nl": [
          "Als bank is Banque Populaire du Nord er om je te helpen je financiën eenvoudig en efficiënt te beheren. Ze hebben een netwerk van handige geldautomaten zodat je altijd bij je geld kunt."
        ]
      },
      "@type": [
        "Description"
      ],
