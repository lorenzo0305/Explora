  "rdfs:comment": {
    "de": [
      "Die Auberge des Canuts, ein authentischer Bouchon Lyonnais, empfängt Sie täglich von 12:00 bis 22:00 Uhr im Vieux-Lyon. Entdecken Sie den Service, die Einrichtung und die traditionelle Küche im historischen Viertel von Lyon."
    ],
    "en": [
      "L’ Auberge des Canuts, an authentic Lyonnais restaurant, welcomes you every day from 12 PM to 10 PM in the Vieux-Lyon (Old Lyon) district. Discover a service, decor, and traditional cuisine in the historical neighborhood of Lyon."
    ],
    "it": [
      "L'Auberge des Canuts, autentico bouchon lionese, vi accoglie tutti i giorni dalle 12 alle 22 nella Vieux-Lyon. Scoprite il servizio, l'arredamento e la cucina tradizionali nel quartiere storico di Lione."
    ],
    "fr": [
      "L’Auberge des Canuts, authentique bouchon lyonnais, vous accueille tous les jours de 12h à 22h dans le Vieux-Lyon. Découvrez un service, un décor et une cuisine traditionnelle dans le quartier historique de Lyon."
    ],
    "es": [
      "El Auberge des Canuts, un auténtico bouchon lionés, le da la bienvenida todos los días de 12:00 a 22:00 en Vieux-Lyon. Descubra el servicio, la decoración y la cocina tradicionales en el barrio histórico de Lyon."
    ],
    "nl": [
      "De Auberge des Canuts, een authentieke Lyonnais bouchon, verwelkomt je elke dag van 12 tot 22 uur in Vieux-Lyon. Ontdek de traditionele service, inrichting en keuken in de historische wijk van Lyon."
    ]
  },
