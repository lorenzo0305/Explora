  "rdfs:comment": {
    "de": [
      "Die ursprüngliche Pfarrkirche, die dem heiligen Erlöser geweiht war und von der nichts mehr erhalten ist, war die Schlosskapelle, die bereits 1095 erwähnt wurde."
    ],
    "en": [
      "The primitive parish church, dedicated to the Holy Saviour, and of which nothing remains, was the castle chapel, mentioned as early as 1095."
    ],
    "it": [
      "La primitiva chiesa parrocchiale, dedicata al Santo Salvatore, di cui non rimane nulla, era la cappella del castello, menzionata già nel 1095."
    ],
    "fr": [
      "L'église paroissiale primitive, dédiée au saint Sauveur, et dont rien ne subsiste, était la chapelle du château, citée dès 1095."
    ],
    "es": [
      "La primitiva iglesia parroquial, dedicada al Santo Salvador, de la que no queda nada, era la capilla del castillo, mencionada ya en 1095."
    ],
    "nl": [
      "De oorspronkelijke parochiekerk, gewijd aan de Heilige Redder, waarvan niets is overgebleven, was de slotkapel, die al in 1095 wordt genoemd."
    ]
  },
