  "rdfs:comment": {
    "de": [
      "Das Marius Hôtel, ein charmantes Hotel mit 9 Zimmern gegenüber dem Lac d'Aydat, wurde 2020 vollständig renoviert.\r\nEs empfängt Sie das ganze Jahr über. Ideal gelegen für einen \"Natur\"-Aufenthalt im Herzen der Volcans d'Auvergne und gegenüber dem Lac d'Aydat."
    ],
    "en": [
      "The Marius Hotel, a charming 9-room hotel facing Lake Aydat, welcomes you all year round. Ideally located for a Nature stay in the heart of the heritage of the Chaine des Puys and Faille de la Limagne classified by UNESCO."
    ],
    "it": [
      "Il Marius Hôtel, un affascinante hotel di 9 camere affacciato sul lago Aydat, è stato completamente rinnovato nel 2020.\r\nVi accoglie tutto l'anno. Situato in posizione ideale per un soggiorno \"naturale\" nel cuore dei vulcani dell'Alvernia e di fronte al lago Aydat."
    ],
    "fr": [
      "Le Marius Hôtel, charmant hôtel de 9 chambres face au Lac d'Aydat, entièrement rénové en 2020.\r\nIl vous accueille toute l'année. Idéalement situé pour un séjour \"nature\" au cœur  des Volcans d'Auvergne et face au lac d'Aydat."
    ],
    "nl": [
      "Het Marius Hôtel, een charmant hotel met 9 kamers tegenover het Aydat-meer, is in 2020 volledig gerenoveerd.\r\nHet verwelkomt u het hele jaar door. Ideaal gelegen voor een \"natuurlijk\" verblijf in het hart van de Vulkanen van de Auvergne en tegenover het meer van Aydat."
    ],
    "es": [
      "El Marius Hôtel, un encantador hotel de 9 habitaciones frente al lago Aydat, fue completamente renovado en 2020.\r\nLe da la bienvenida todo el año. Idealmente situado para una estancia \"natural\" en el corazón de los volcanes de Auvernia y frente al lago Aydat."
    ]
  },
