  "rdfs:comment": {
    "de": [
      "Das Hotel lädt Sie zu einem ruhigen Aufenthalt in einer lichtdurchfluteten und grünen Umgebung ein. 18 komfortable Zimmer mit Flachbildschirm."
    ],
    "en": [
      "The hotel invites you to relax in a quiet setting of light and greenery. 18 comfortable rooms with flat screen TV and free Wifi access."
    ],
    "it": [
      "L'hotel vi invita a rilassarvi in un ambiente luminoso e verdeggiante. 18 camere confortevoli con TV a schermo piatto."
    ],
    "fr": [
      "L'hôtel vous invite au calme dans un cadre de lumière et de verdure. 18 chambres confortables avec écran plat."
    ],
    "nl": [
      "Het hotel nodigt u uit om te ontspannen in een omgeving van licht en groen. 18 comfortabele kamers met flatscreentelevisie."
    ],
    "es": [
      "El hotel le invita a relajarse en un entorno de luz y verdor. 18 cómodas habitaciones con pantalla plana."
    ]
  },
