  "rdfs:comment": {
    "de": [
      "Brunch in Moulins? Reservieren Sie Ihre Gourmet-Sonntage im CNCS!\r\nDas Museum öffnet seine Türen für ein geselliges Schlemmererlebnis mit seinen Brunch-Sonntagen im CNCS, die im Café Brasserie veranstaltet werden."
    ],
    "en": [
      "Brunch in Moulins? Book your gourmet Sundays at the CNCS!\r\nThe museum opens its doors to you for a gourmet and convivial experience with its Sunday brunches at the CNCS, organized at the Café Brasserie."
    ],
    "it": [
      "Brunch a Moulins? Prenotate le vostre domeniche gourmet al CNCS!\r\nIl museo vi apre le porte per un'esperienza gastronomica e conviviale con i brunch domenicali del CNCS, organizzati presso il Café Brasserie."
    ],
    "fr": [
      "Brunch à Moulins – Réservez vos dimanches gourmands au CNCS !\r\nLe musée vous ouvre ses portes pour une expérience gourmande et conviviale avec ses dimanches brunchs au CNCS, organisés au Café Brasserie."
    ],
    "es": [
      "¿Brunch en Moulins? ¡Reserve sus domingos gastronómicos en el CNCS!\r\nEl museo le abre sus puertas para una experiencia gastronómica y de convivencia con sus brunchs dominicales en el CNCS, organizados en el Café Brasserie."
    ],
    "nl": [
      "Brunchen in Moulins? Reserveer je zondag voor fijnproevers bij het CNCS!\r\nHet museum opent zijn deuren voor u voor een gastronomische en gezellige ervaring met zijn zondagse brunches in het CNCS, georganiseerd in het Café Brasserie."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Brunch au CNCS à Moulins !"
    ]
  },
