      "The Museum of Printing and Graphic Communication"
    ],
    "it": [
      "Museo della Stampa di Lione"
    ],
    "fr": [
      "Musée de l'Imprimerie et de la communication graphique"
    ],
    "es": [
      "Museo de la Imprenta y la Comunicación Gráfica"
    ]
  },
