  "rdfs:comment": {
    "de": [
      "Tischkultur aus Steingut: zeitgenössische Stücke, die von Hand entworfen und geformt werden.\r\nTreffen im Atelier, Verkauf zum Mitnehmen und Annahme von Bestellungen das ganze Jahr über nach Vereinbarung.\r\nModellierkurse (Schulferien).\r\nPrivatunterricht im Drehen.\r\nPrivatisierung."
    ],
    "en": [
      "Stoneware tableware: contemporary pieces designed and shaped by hand.\r\nMeet at the studio, take-away sales and orders by appointment all year round.\r\nModeling courses (school vacations).\r\nPrivate turning lessons.\r\nPrivatization available."
    ],
    "it": [
      "Stoviglie in gres: pezzi contemporanei disegnati e modellati a mano.\r\nIncontro in studio, vendita da asporto e ordini su appuntamento tutto l'anno.\r\nCorsi di modellazione (vacanze scolastiche).\r\nLezioni private di lancio.\r\nNoleggio privato."
    ],
    "fr": [
      "Arts de la table en grès : pièces contemporaines conçues et façonnées à la main.\r\nRencontre à l’atelier, vente à emporter et prise de commande toute l'année sur RDV.\r\nStages de modelage (vacances scolaires).\r\nCours particuliers de tournage.\r\nPrivatisation."
    ],
    "es": [
      "Vajilla de gres: piezas contemporáneas diseñadas y moldeadas a mano.\r\nEncuentro en el estudio, venta para llevar y pedidos con cita previa durante todo el año.\r\nCursos de modelado (vacaciones escolares).\r\nClases particulares de lanzamiento.\r\nAlquiler privado."
    ],
    "nl": [
      "Servies van steengoed: eigentijdse stukken met de hand ontworpen en gevormd.\r\nOntmoetingen in het atelier, afhaalverkoop en bestellingen op afspraak, het hele jaar door.\r\nBoetseercursussen (schoolvakanties).\r\nPrivé werplessen.\r\nPrivéverhuur."
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'Atelier céramique de Morgane Louis -Gobin"
    ]
  },
