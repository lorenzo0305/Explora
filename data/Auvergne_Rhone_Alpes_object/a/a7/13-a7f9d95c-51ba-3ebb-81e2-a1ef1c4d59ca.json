  "rdfs:comment": {
    "de": [
      "Der Platz ist zu 100% barrierefrei und energieautark dank Photovoltaikanlagen und einer 3-Klick-Reservierung über die App \"Le Padel Français\"."
    ],
    "en": [
      "The court is 100% self-sufficient in accessibility and energy thanks to photovoltaic panels and a 3-click reservation via the \"Le Padel Français\" app."
    ],
    "it": [
      "Il campo è al 100% autosufficiente in termini di accessibilità ed energia, grazie a pannelli fotovoltaici e a un processo di prenotazione in 3 click tramite l'app \"Le Padel Français\"."
    ],
    "fr": [
      "Le terrain est 100% autonome en accessibilité et en énergie grâce à des panneaux photovoltaïques et une réservation en 3 clics via l’application « Le Padel Français »."
    ],
    "es": [
      "La pista es 100% autosuficiente en términos de accesibilidad y energía, gracias a paneles fotovoltaicos y a un proceso de reserva en 3 clics a través de la app \"Le Padel Français\"."
    ],
    "nl": [
      "De baan is 100% zelfvoorzienend wat betreft toegankelijkheid en energie, dankzij fotovoltaïsche panelen en een boekingsproces met 3 klikken via de app \"Le Padel Français\"."
    ]
  },
