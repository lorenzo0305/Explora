      "@id": "https://data.datatourisme.fr/e664bc2c-89d1-368e-9352-615040c9a3a7",
      "dc:description": {
        "de": [
          "Ein atypischer Laden, der voller Bücher für alle, Schallplatten und überraschender alter oder gebrauchter Gegenstände steckt. Geschirr, Haushaltswäsche, Kleinmöbel..."
        ],
        "en": [
          "An atypical boutique brimming with books for all, records, and surprising vintage and second-hand objects. Crockery, household linen, small furniture..."
        ],
        "it": [
          "Un negozio insolito, ricco di libri per tutti, dischi e sorprendenti oggetti di seconda mano e d'antiquariato. Stoviglie, biancheria per la casa, piccoli mobili..."
        ],
        "fr": [
          "Une boutique atypique qui regorge de livres pour tous, de disques, d'objets anciens ou d'occasion surprenants. Vaisselle, linge de maison, petit mobilier..."
        ],
        "es": [
          "Una tienda insólita repleta de libros para todos los gustos, discos y sorprendentes objetos de segunda mano y antigüedades. Vajillas, ropa de hogar, pequeños muebles..."
        ],
        "nl": [
          "Een bijzondere winkel boordevol boeken voor iedereen, platen en verrassende tweedehands en antieke voorwerpen. Serviesgoed, huishoudlinnen, klein meubilair..."
        ]
      },
