  "rdfs:comment": {
    "de": [
      "Der authentische und humanistische Edgar-Yves Jr. zeichnet sich durch seine unbändige Energie und sein Engagement für die Verteidigung einer intelligenten und verantwortungsbewussten Meinungsfreiheit aus."
    ],
    "en": [
      "Genuine and humanistic, Edgar-Yves Jr stands out for his boundless energy and commitment to the defense of intelligent and responsible freedom of expression."
    ],
    "it": [
      "Autentico umanista, Edgar-Yves Jr si distingue per la sua sconfinata energia e per il suo impegno nella difesa di una libertà di espressione intelligente e responsabile."
    ],
    "fr": [
      "Authentique et humaniste, Edgar-Yves Jr se distingue par son énergie débordante et son engagement dans la défense d’une liberté d’expression intelligente et responsable."
    ],
    "nl": [
      "Edgar-Yves Jr, een echte humanist, valt op door zijn tomeloze energie en zijn inzet voor het verdedigen van intelligente en verantwoordelijke vrijheid van meningsuiting."
    ],
    "es": [
      "Auténtico humanista, Edgar-Yves Jr destaca por su energía desbordante y su compromiso en defensa de una libertad de expresión inteligente y responsable."
    ]
  },
