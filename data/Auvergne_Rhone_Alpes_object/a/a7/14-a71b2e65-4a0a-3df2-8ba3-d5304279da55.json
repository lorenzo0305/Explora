  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/9a710de3-9e99-394e-b428-3bbd3f86c46a",
      "dc:description": {
        "de": [
          "Club für Besitzer von Oldtimern oder außergewöhnlichen Fahrzeugen.\n\nSammeln Sie sich auf der Treppe des Palastes.\n\n3. Sonntag im Monat von 10:00 bis 12:30 Uhr von April bis November."
        ],
        "en": [
          "Club for owners of classic and exceptional vehicles.\n\nGather at the palace steps.\n\n3rd Sunday of the month from 10am to 12:30pm from April to November."
        ],
        "it": [
          "Un club per i proprietari di veicoli classici ed eccezionali.\n\nRiunitevi sui gradini del palazzo.\n\nla terza domenica del mese dalle 10.00 alle 12.30 da aprile a novembre."
        ],
        "fr": [
          "Club de propriétaires de véhicules de collection ou d’exception.\n\nRassemblement au niveau des marches du palais.\n\n3ème dimanche du mois de 10h à 12h30 du mois d’avril au mois de novembre."
        ],
        "es": [
          "Un club para propietarios de vehículos clásicos y excepcionales.\n\nReúnanse en la escalinata del palacio.\n\nel tercer domingo de cada mes, de 10.00 a 12.30 h, de abril a noviembre."
        ],
        "nl": [
          "Een club voor eigenaars van klassieke en uitzonderlijke voertuigen.\n\nVerzamelen op de trappen van het paleis.\n\n3e zondag van de maand van 10u tot 12u30 van april tot november."
        ]
      },
