  "rdfs:comment": {
    "de": [
      "Harmonnia bietet Ihnen eine persönliche Begleitung in Sophrologie, Hypnose, Feng Shui und Numerologie. Konkrete Werkzeuge, um das innere Gleichgewicht zu stärken, die Ressourcen zu optimieren und die Harmonie im Alltag zu verbessern."
    ],
    "en": [
      "Harmonnia offers personalized support in sophrology, hypnosis, feng shui and numerology. Concrete tools to reinforce inner balance, optimize resources and improve harmony in daily life."
    ],
    "it": [
      "Harmonnia vi offre un supporto personalizzato in sofrologia, ipnosi, feng shui e numerologia. Strumenti concreti per rafforzare il vostro equilibrio interiore, ottimizzare le vostre risorse e migliorare l'armonia nella vostra vita quotidiana."
    ],
    "fr": [
      "Harmonnia vous propose un accompagnement personnalisé en sophrologie, hypnose, feng shui et numérologie. Des outils concrets pour renforcer l’équilibre intérieur, optimiser les ressources et améliorer l’harmonie dans la vie quotidienne."
    ],
    "es": [
      "Harmonnia le propone un acompañamiento personalizado en sofrología, hipnosis, feng shui y numerología. Herramientas concretas para reforzar tu equilibrio interior, optimizar tus recursos y mejorar la armonía en tu vida cotidiana."
    ],
    "nl": [
      "Harmonnia biedt je persoonlijke ondersteuning in sofrologie, hypnose, feng shui en numerologie. Concrete hulpmiddelen om je innerlijke balans te versterken, je hulpbronnen te optimaliseren en de harmonie in je dagelijks leven te verbeteren."
    ]
  },
