  "rdfs:comment": {
    "de": [
      "\"Route des savoirs-faire de Haute-Loire\"\r\nEntdecken Sie die Reichtümer des Departements, Landwirtschaft, Gastronomie...\r\nDamien Grasset bietet Ihnen eine kommentierte Besichtigung seines Bauernhofs an. Er ist Züchter von Limouzines-Kühen und Produzent von grünen Linsen aus Le Puy."
    ],
    "en": [
      "\"Route des savoirs-faire de Haute-Loire\" (Haute-Loire know-how route)\r\nDiscover the riches of the department, from agriculture to gastronomy...\r\nDamien Grasset offers a guided tour of his farm, where he breeds Limouzines cows and produces green Puy lentils."
    ],
    "it": [
      "\"L'itinerario del savoir-faire della Haute-Loire\r\nScoprite le ricchezze del dipartimento, l'agricoltura, la gastronomia...\r\nDamien Grasset propone una visita guidata alla sua azienda agricola, dove alleva vacche Limouzines e produce lenticchie verdi di Puy."
    ],
    "fr": [
      "\" Route des savoirs-faire de Haute-Loire\"\r\nDécouvrir les richesses du département, agriculture, gastronomie...\r\nDamien Grasset vous propose une visite commentée de sa ferme, il est éleveur de vache limouzines et producteur de lentilles vertes du Puy."
    ],
    "es": [
      "\"La ruta del saber hacer del Alto Loira\r\nDescubra las riquezas del departamento, agricultura, gastronomía...\r\nDamien Grasset ofrece una visita guiada por su granja, donde cría vacas Limouzines y produce lentejas verdes de Puy."
    ],
    "nl": [
      "\"De kennisroute van de Haute-Loire\r\nOntdek de rijkdommen van het departement, landbouw, gastronomie...\r\nDamien Grasset biedt een rondleiding over zijn boerderij, waar hij Limouzines koeien fokt en groene Puy linzen produceert."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite de ferme | Damien Grasset | Ouïdes"
    ]
  },
