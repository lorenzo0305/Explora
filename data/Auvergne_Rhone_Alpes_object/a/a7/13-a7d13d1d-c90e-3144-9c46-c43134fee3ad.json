  "rdfs:comment": {
    "de": [
      "In diesem Restaurant wird kreativ und leidenschaftlich gekocht. Wir legen Wert auf Authentizität und unsere Rezepte basieren auf Traditionen der Bergwelt. Unser Küchenchef Alicia Motte modernisiert sie und entlockt dabei lokalen Zutaten alle Geheimnisse ihres Geschmacks."
    ],
    "en": [
      "Restaurant offering a cuisine that is creative and full of passion.  We attach great importance to authenticity and so our menus are based on mountain traditions featuring local ingredients which our chef  Alicia Motte reinterprets in order to reveal their hidden secrets."
    ],
    "it": [
      "Un ristorante che offre una cucina creativa e appassionata. Impegnata nell'autenticità, la nostra cucina si basa sulle tradizioni di montagna, dove i prodotti locali vengono rivisitati per svelarne tutti i segreti grazie alla nostra chef Alicia Motte."
    ],
    "fr": [
      "Restaurant avec une cuisine créative et de passion. Attachée à l'authenticité, notre cuisine est créée sur les traditions montagnardes où les produits du terroir sont revisités pour révéler tous leurs secrets grâce à notre cheffe Alicia Motte."
    ],
    "es": [
      "Un restaurante de cocina creativa y apasionada. Comprometidos con la autenticidad, nuestra cocina se basa en las tradiciones de montaña, donde los productos locales son revisitados para revelar todos sus secretos gracias a nuestra chef Alicia Motte."
    ],
    "nl": [
      "Een restaurant met een creatieve en gepassioneerde keuken. Onze authentieke keuken is gebaseerd op bergtradities, waarbij lokale producten opnieuw worden bekeken om al hun geheimen te onthullen dankzij onze chef-kok Alicia Motte."
    ]
  },
