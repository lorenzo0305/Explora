  "rdfs:comment": {
    "de": [
      "Die Droguerie des Oliviers bietet Ihnen neben ihren Standardprodukten, Insektiziden, Wachsen ... eine große Auswahl an handgefertigten Töpferwaren, Hirtenlampen, Olivenholz und provenzalischen Produkten. Die beste Beratung erwartet Sie hier."
    ],
    "en": [
      "Large choice of... everything! Standard products, insecticides, wax... local potteries, lamps, local products... And the best advice too!"
    ],
    "it": [
      "La Droguerie des Oliviers vi offre, oltre ai suoi prodotti standard, insetticidi, cere... una vasta gamma di ceramiche artigianali, lampade da pastore, legno d'ulivo e prodotti provenzali. Il miglior consiglio vi aspetta."
    ],
    "fr": [
      "La Droguerie des Oliviers vous propose, outre ses produits standards, insecticides, cires ... tout un grand choix de poteries artisanales, lampes berger, bois d'olivier et produits provençaux. Le meilleur conseil vous y attend."
    ],
    "es": [
      "La Droguerie des Oliviers le ofrece, además de sus productos estándar, insecticidas, ceras... una amplia gama de cerámica artesanal, lámparas de pastor, madera de olivo y productos provenzales. El mejor consejo te espera."
    ],
    "nl": [
      "La Droguerie des Oliviers biedt u behalve hun algemene assortiment, insecticides, was... een grote keus uit ambachtelijke potten, olijfhout en andere provençaalse producten... Wij geven u het beste advies."
    ]
  },
