  "rdfs:comment": {
    "de": [
      "In Jahon, 3 km von Langeac entfernt, werden Sie von einem Dorfbewohner geführt und lernen das Leben eines Dorfes kennen, in dem sich seit 160 Jahren das Haus der Beate befindet."
    ],
    "en": [
      "In Jahon, 3km from Langeac, a local takes us on a guided tour of the village where the Maison de la Béate has been located for 160 years."
    ],
    "it": [
      "A Jahon, a 3 km da Langeac, partecipate a una visita guidata e scoprite la vita del villaggio in cui si trova la Maison de la Béate da 160 anni, guidati da un abitante del luogo."
    ],
    "fr": [
      "A Jahon, 3km de Langeac, visite guidée et découverte de la vie d'un village où est implantée la maison de la Béate depuis 160 ans par un habitant du village."
    ],
    "nl": [
      "Neem in Jahon, op 3 km van Langeac, een rondleiding en ontdek het leven van een dorp waar het Maison de la Béate al 160 jaar is gevestigd, onder leiding van een lokale bewoner."
    ],
    "es": [
      "En Jahon, a 3 km de Langeac, realice una visita guiada y descubra la vida de un pueblo donde se encuentra la Maison de la Béate desde hace 160 años, de la mano de un residente local."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Maison de la Béate"
    ]
  },
