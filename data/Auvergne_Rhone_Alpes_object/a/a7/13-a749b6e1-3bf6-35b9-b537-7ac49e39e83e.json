  "rdfs:comment": {
    "de": [
      "Das Yogazentrum Fleur de Lotus empfängt Sie das ganze Jahr über und bietet Ihnen wöchentliche Kurse , Workshops (halber Tag) und Praktika (mehrere Tage) in ayurvedischem Yoga, Klangyoga und Meditation an."
    ],
    "en": [
      "The Fleur de Lotus yoga center welcomes you all year round and offers weekly classes, half-day workshops and multi-day courses in ayurvedic yoga, sound yoga and meditation."
    ],
    "it": [
      "Il centro yoga Fleur de Lotus vi accoglie tutto l'anno e offre lezioni settimanali, workshop di mezza giornata e corsi di più giorni di yoga ayurvedico, yoga del suono e meditazione."
    ],
    "fr": [
      "Le centre de yoga Fleur de Lotus vous accueille toute l'année et vous propose des cours hebdomadaires , ateliers (demi-journée) et stages (plusieurs jours)  en yoga ayurvédique, yoga du son et méditation."
    ],
    "nl": [
      "Het yogacentrum Fleur de Lotus verwelkomt je het hele jaar door en biedt wekelijkse lessen, workshops van een halve dag en meerdaagse cursussen in ayurvedische yoga, klankyoga en meditatie."
    ],
    "es": [
      "El centro de yoga Fleur de Lotus le da la bienvenida todo el año y ofrece clases semanales, talleres de media jornada y cursos de varios días de yoga ayurvédico, yoga del sonido y meditación."
    ]
  },
  "rdfs:label": {
