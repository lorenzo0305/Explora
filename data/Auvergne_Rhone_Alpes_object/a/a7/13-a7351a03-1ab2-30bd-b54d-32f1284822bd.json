  "rdfs:comment": {
    "de": [
      "Die Freizeitheime in Luriecq / Saint-Jean-Soleymieux / Usson-en-Forez werden nun von der Organisation Léo Lagrange verwaltet, um Ihr Kind anzumelden gehen Sie bitte auf das Familienportal."
    ],
    "en": [
      "The Luriecq / Saint-Jean-Soleymieux / Usson-en-Forez leisure centers are now managed by the Léo Lagrange organization. To register your child, please go to the family portal."
    ],
    "it": [
      "I centri ricreativi di Luriecq / Saint-Jean-Soleymieux / Usson-en-Forez sono ora gestiti da Léo Lagrange. Per registrare il proprio figlio, accedere al portale delle famiglie."
    ],
    "fr": [
      "Les accueils de loisirs de Luriecq / Saint-Jean-Soleymieux / Usson-en-Forez sont désormais gérés par l’organisme Léo Lagrange, pour inscrire votre enfant veuillez vous rendre sur le portail familles."
    ],
    "es": [
      "Los centros de ocio de Luriecq / Saint-Jean-Soleymieux / Usson-en-Forez están ahora gestionados por Léo Lagrange. Para inscribir a su hijo, vaya al portal de la familia."
    ],
    "nl": [
      "De recreatiecentra in Luriecq / Saint-Jean-Soleymieux / Usson-en-Forez worden nu beheerd door Léo Lagrange. Ga naar het familieportaal om je kind in te schrijven."
    ]
  },
