  "rdfs:comment": {
    "de": [
      "Jean-Marie Philippe, der sich im Dorf niedergelassen hat, öffnet sein Atelier und seine Ausstellungsräume für Besucher und organisiert im Frühling und Sommer auf Anfrage Workshops für Kinder und Familien."
    ],
    "en": [
      "Based in the village, Jean-Marie Philippe opens his workshop and showrooms to visitors, and organizes workshops for children and families on request."
    ],
    "it": [
      "Con sede nel villaggio, Jean-Marie Philippe apre il suo studio e i suoi showroom ai visitatori e organizza laboratori per bambini e famiglie su richiesta in primavera e in estate."
    ],
    "fr": [
      "Installé au village, Jean-Marie Philippe ouvre son atelier et ses salles d’exposition aux visiteurs et organise sur demande, le printemps et l'été, des ateliers pour les enfants et famille."
    ],
    "nl": [
      "Jean-Marie Philippe, gevestigd in het dorp, stelt zijn atelier en showrooms open voor bezoekers en organiseert op verzoek in de lente en zomer workshops voor kinderen en gezinnen."
    ],
    "es": [
      "Con sede en el pueblo, Jean-Marie Philippe abre su estudio y sus salas de exposición a los visitantes y organiza talleres para niños y familias previa petición en primavera y verano."
    ]
  },
  "rdfs:label": {
