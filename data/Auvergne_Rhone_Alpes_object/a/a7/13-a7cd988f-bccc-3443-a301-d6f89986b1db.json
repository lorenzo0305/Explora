  "rdfs:comment": {
    "de": [
      "DER Ort zum Feiern in Peisey-Vallandry von Party Après-Ski bis 02.00 Uhr auf.\r\nEine breite Auswahl an hausgemachten Cocktails, Weinen und Spirituosen.\r\nDelikatessen, Terrinen, Käse.\r\nSportübertragungen (bein Sport), Live-Musik und DJ-Sets."
    ],
    "en": [
      "THE place to party in Peisey-Vallandry from après-ski until 2am.\r\nWide selection of home made cocktails, spirits and wines.\r\nDelicatessen, terrines, cheese.\r\nSports broadcasts (bein sport), live music and DJ sets."
    ],
    "it": [
      "Il luogo dove fare festa a Peisey-Vallandry, dall'après-ski fino alle 2 di notte.\r\nAmpia scelta di cocktail, liquori e vini della casa.\r\nTaglieri di salumi, terrine e formaggi.\r\nTrasmissioni sportive (bein sport), concerti e DJ set."
    ],
    "fr": [
      "LE lieu pour faire la fête à Peisey-Vallandry. de l'après-ski jusqu'à 2h du matin.\r\nLarge choix de cocktails maison, alcools et vins.\r\nAssiettes de Charcuterie, terrines, fromage.\r\nRetransmissions sportives (bein sport), concerts et Dj sets."
    ],
    "es": [
      "El lugar de fiesta de Peisey-Vallandry, desde el après-ski hasta las 2 de la madrugada.\r\nAmplia selección de cócteles, licores y vinos de la casa.\r\nCharcutería, terrinas y tablas de quesos.\r\nRetransmisiones deportivas (bein sport), conciertos y sesiones de DJ."
    ],
    "nl": [
      "Dé plek om te feesten in Peisey-Vallandry, van après-ski tot 2 uur 's nachts.\r\nRuime keuze aan huiscocktails, sterke dranken en wijnen.\r\nCharcuterie, terrines en kaasplateaus.\r\nSportuitzendingen (bein sport), concerten en dj-sets."
    ]
  },
