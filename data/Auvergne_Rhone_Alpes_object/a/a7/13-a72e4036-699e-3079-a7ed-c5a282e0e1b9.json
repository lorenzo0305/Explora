  "rdfs:comment": {
    "de": [
      "Le comptoir savoyard ist ein kleiner Imbiss und ein Teesalon mit regionalen Produkten vor Ort oder zum Mitnehmen, damit Sie die Berge genießen können! \r\nEntdecken Sie die typischen und raffinierten Produkte von hier und anderswo"
    ],
    "en": [
      "Le comptoir savoyard is a small restaurant and tea room, with regional products to eat in or take away, so you can savour the mountains! \r\nDiscover typical and refined products from here and elsewhere"
    ],
    "it": [
      "Le comptoir savoyard è un piccolo ristorante e sala da tè, con prodotti regionali da consumare o da portare via, per assaporare la montagna!\nScoprite i prodotti tipici e raffinati di qui e altrove\nA qualsiasi ora e per tutti i gusti"
    ],
    "fr": [
      "Le comptoir savoyard c'est une petite restauration et un salon de thé, avec des produits régionaux sur place ou à emporter pour dégustez la montagne ! \nDécouvrez les produits typiques et raffinés d'ici et d'ailleurs\nA toute heure pour toutes les envies"
    ],
    "nl": [
      "Le comptoir savoyard is een klein restaurant en tearoom, met regionale producten om te eten of mee te nemen, zodat je kunt genieten van de bergen!\nOntdek typische en verfijnde producten van hier en elders\nOp elk moment voor alle smaken"
    ],
    "es": [
      "Le comptoir savoyard es un pequeño restaurante y salón de té, con productos regionales para comer en casa o para llevar, ¡para saborear la montaña!\nDescubra productos típicos y refinados de aquí y de otros lugares\nA cualquier hora y para todos los gustos"
    ]
  },
