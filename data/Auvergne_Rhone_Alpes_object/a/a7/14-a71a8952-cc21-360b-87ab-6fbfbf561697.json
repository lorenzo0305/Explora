  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/f4d8cfa9-5211-3e44-9a95-86fb768d07de",
      "dc:description": {
        "de": [
          "Informationen :\n\nProdukte :\n\nIn Schließfächern werden Ihnen saisonale Bauernhofprodukte angeboten: Äpfel, Eier, Karotten, Kartoffeln von lokalen Erzeugern.\n\nÖffnungstage:\n\n24 Stunden am Tag und 7 Tage in der Woche zugänglich.\n\n\n "
        ],
        "en": [
          "Information :\n\nProducts :\n\nYou'll find seasonal farm produce in racks: apples, eggs, carrots, potatoes from local producers.\n\nOpening days:\n\nOpen 24/7.\n\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nProdotti :\n\nTroverete prodotti agricoli di stagione in scaffali: mele, uova, carote, patate di produttori locali.\n\nGiorni di apertura:\n\nAperto 24 ore su 24, 7 giorni su 7.\n\n\n "
        ],
        "fr": [
          "Informations : \n\nProduits :\n\nDans des casiers vous sont proposés des produits fermiers de saison : pommes, oeufs, carottes, pommes de terre des producteurs locaux.\n\nJours d'ouverture: \n\nAccessible 24h/24 et 7 jours/7.\n\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nProducten :\n\nJe vindt seizoensproducten van de boerderij in rekken: appels, eieren, wortelen, aardappelen van lokale producenten.\n\nOpeningsdagen:\n\n24 uur per dag, 7 dagen per week geopend.\n\n\n "
        ],
        "es": [
          "Más información :\n\nProductos :\n\nEncontrará productos agrícolas de temporada en estanterías: manzanas, huevos, zanahorias, patatas de productores locales.\n\nDías de apertura:\n\nAbierto 24 horas al día, 7 días a la semana.\n\n\n "
        ]
      },
