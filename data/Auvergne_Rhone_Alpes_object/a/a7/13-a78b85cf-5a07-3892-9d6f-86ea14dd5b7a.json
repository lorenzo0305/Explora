  "rdfs:comment": {
    "de": [
      "Alicia und Loan bieten Ihnen: Biere, Weine, Granitas, Cocktails und Softs mit Aperitifbrettern.\r\nAuf dem Markt vertreten mit Frühstücksangeboten, die von Softs und Kaffee begleitet werden."
    ],
    "en": [
      "Alicia and Loan offer beer, wine, granita, cocktails and soft drinks accompanied by aperitif boards.\r\nWe are also present on the market with breakfast formulas accompanied by soft drinks and coffee."
    ],
    "it": [
      "Alicia e Loan offrono birra, vino, granite, cocktail e bevande analcoliche con taglieri di aperitivi.\r\nOffriamo anche formule di colazione con bevande analcoliche e caffè."
    ],
    "fr": [
      "Alicia et Loan vous proposent :  bières, vins, granités, cocktails et softs accompagnés de planches apéritives.\r\nPrésents sur le marché avec des formules petits déjeuners accompagnés de softs et café."
    ],
    "es": [
      "Alicia y Loan ofrecen cerveza, vino, granizados, cócteles y refrescos con tablas de aperitivos.\r\nTambién ofrecemos fórmulas de desayuno con refrescos y café."
    ],
    "nl": [
      "Alicia en Loan bieden bier, wijn, granita, cocktails en frisdrank met aperitiefplankjes.\r\nWe bieden ook ontbijtformules met frisdrank en koffie."
    ]
  },
  "rdfs:label": {
