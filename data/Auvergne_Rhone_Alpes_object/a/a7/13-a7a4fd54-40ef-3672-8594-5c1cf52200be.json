  "rdfs:comment": {
    "de": [
      "Régis bietet Einführungen ins Hochgebirge für Anfänger, Gämsen- und Murmeltierausflüge, Trekking in den Massiven der Vanoise, des Grand Paradis, des Mont Rose, der Écrins oder des Mont Blanc sowie Klettersteigausflüge und Kletterschule an."
    ],
    "en": [
      "Régis offers introduction to the high mountains for beginners, chamois and marmot outings, treks in the Vanoise, Grand Paradis, Mont Rose, Écrins and Mont-Blanc massifs as well as via ferrata and ski school outings. climbing."
    ],
    "it": [
      "Régis offre corsi di iniziazione all'alta montagna per principianti, camosci, marmotte, trekking nei massicci della Vanoise, del Grand Paradis, del Mont Rose, degli Écrins o del Monte Bianco, nonché vie ferrate e scuola di arrampicata."
    ],
    "fr": [
      "Régis propose de l'initiation à la haute montagne pour les débutants, des sorties chamois, marmottes, treks dans les massifs de la Vanoise, Grand Paradis, Mont Rose, Écrins, ou Mont-Blanc ainsi que des sorties via ferrata et école d'escalade."
    ],
    "es": [
      "Régis ofrece iniciación a la alta montaña para principiantes, gamuzas, marmotas, excursiones por los macizos de la Vanoise, Grand Paradis, Mont Rose, Écrins o Mont-Blanc, así como vías ferratas y escuela de escalada."
    ],
    "nl": [
      "Régis biedt kennismaking met het hooggebergte voor beginners, gemzen- en marmottentochten, tochten in de Vanoise, Grand Paradis, Mont Rose, Écrins en Mont-Blanc-massieven, evenals via ferrata en skischooltochten."
    ]
  },
  "rdfs:label": {
    "en": [
      "Régis Anselmet - High mountain guide - Ski instructor"
    ],
    "fr": [
      "Régis Anselmet - Guide de Haute Montagne - Moniteur de ski"
    ],
    "nl": [
      "Régis Anselmet - Berggids - Skileraar"
    ]
  },
