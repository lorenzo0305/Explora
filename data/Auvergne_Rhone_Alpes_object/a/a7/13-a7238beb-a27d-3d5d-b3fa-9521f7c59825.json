  "rdfs:comment": {
    "de": [
      "Eine Boutique mit Kunsthandwerkern empfängt Sie in Charly in Andilly 74. Holzdekorationen, Makramee, Näharbeiten, Leder, Schmuck, Skulpturen, Eisen, Holz... Verschiedene Kunsthandwerker stellen ihre Kreationen aus und verkaufen sie. Im Obergeschoss erwartet Sie eine mittelalterliche Boutique."
    ],
    "en": [
      "An arts and crafts boutique welcomes you to Charly in Andilly 74. Wood decorations, macramé sewing, leather, jewelry, sculpture, iron, wood... Various artisans display and sell their creations. Upstairs, a medieval boutique awaits you."
    ],
    "it": [
      "Una boutique di arti e mestieri vi dà il benvenuto a Charly ad Andilly 74. Decorazioni in legno, cucito macramè, cuoio, gioielli, sculture, ferro, legno... Diversi artigiani espongono e vendono le loro creazioni. Al piano superiore, vi attende una bottega medievale."
    ],
    "fr": [
      "Une boutique d’artisans d’art vous accueillera dans Charly à Andilly 74. Décorations bois ,macramé couture, cuir, bijoux, sculpture, fer, bois... Divers artisans exposent et vendent leurs créations. À l’étage, une boutique médiévale vous attend."
    ],
    "es": [
      "Una boutique de artesanía le da la bienvenida en Charly, en Andilly 74. Decoración en madera, costura en macramé, cuero, bisutería, escultura, hierro, madera... Varios artesanos exponen y venden sus creaciones. Arriba, una tienda medieval le espera."
    ],
    "nl": [
      "Een kunstnijverheidsboetiek verwelkomt je in Charly in Andilly 74. Houtdecoraties, macramé naaien, leer, sieraden, beeldhouwwerk, ijzer, hout... Verschillende ambachtslieden tonen en verkopen hun creaties. Boven wacht je een middeleeuwse winkel."
    ]
  },
