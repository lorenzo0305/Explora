  "rdfs:comment": {
    "de": [
      "Das Derby's, Maître Restaurateur seit 2011, ist mit seinem lichtdurchfluteten Speisesaal und seinem leidenschaftlichen Küchenchef auf der Suche nach neuen Geschmäckern eine Freude für Augen und Gaumen!"
    ],
    "en": [
      "The Derby's, Master Restaurateur since 2011, is a delight for the eyes and the taste buds with its dining room bathed in light and its passionate chef in search of new flavours!"
    ],
    "it": [
      "Derby's, Maître Restaurateur dal 2011, è una delizia per gli occhi e per le papille gustative con la sua sala luminosa e il suo chef appassionato alla ricerca di nuovi sapori!"
    ],
    "fr": [
      "Le Derby’s, Maître Restaurateur depuis 2011, est un bonheur pour les yeux et les papilles avec sa salle à manger baignée de lumière et son chef passionné à la recherche de saveurs nouvelles !"
    ],
    "nl": [
      "Derby's, Maître Restaurateur sinds 2011, is een genot voor het oog en de smaakpapillen met zijn lichte eetzaal en zijn gepassioneerde chef op zoek naar nieuwe smaken!"
    ],
    "es": [
      "Derby's, Maître Restaurateur desde 2011, es una delicia para los ojos y las papilas gustativas con su luminoso comedor y su apasionado chef en busca de nuevos sabores"
    ]
  },
  "rdfs:label": {
