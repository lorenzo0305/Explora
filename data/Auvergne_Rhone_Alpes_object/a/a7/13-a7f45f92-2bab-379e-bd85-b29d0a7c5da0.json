  "rdfs:comment": {
    "de": [
      "Entdecken Sie mit den Langlauflehrern und Schneeschuhbegleitern das Glück des nordischen Skisports und der Berge im Winter inmitten der Natur."
    ],
    "en": [
      "With our cross-country ski instructors and snowshoe guides, discover the joys of Nordic skiing and winter mountain sports in the heart of nature."
    ],
    "it": [
      "Con gli istruttori di sci di fondo e le guide per le racchette da neve, scoprite le gioie dello sci nordico e della montagna in inverno, nel cuore della natura."
    ],
    "fr": [
      "Avec les moniteurs de ski de fond et accompagnateurs raquettes, découvrez le bonheur de la glisse nordique et de la montagne en hiver en pleine nature."
    ],
    "nl": [
      "Ontdek met de langlaufleraren en sneeuwschoengidsen de geneugten van het noords skiën en de bergen in de winter in het hart van de natuur."
    ],
    "es": [
      "Con los monitores de esquí de fondo y los guías de raquetas de nieve, descubra los placeres del esquí nórdico y de la montaña en invierno en plena naturaleza."
    ]
  },
