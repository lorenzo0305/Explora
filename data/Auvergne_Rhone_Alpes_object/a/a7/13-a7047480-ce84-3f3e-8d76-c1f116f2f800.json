  "rdfs:comment": {
    "de": [
      "Der wichtigste Schulstandort im nördlichen Vercors. Er wird vom Freiflugkomitee des Departements, der Freiflugschule ALTO und dem Freiflugclub Lans en l'air verwaltet."
    ],
    "en": [
      "The major training site in the northern Vercors. It is managed by the departmental free-flight committee, the ALTO free-flight school and the Lans en l'air free-flight club."
    ],
    "it": [
      "È il principale sito di addestramento del Vercors settentrionale. È gestito dal comitato dipartimentale di volo libero, dalla scuola di volo libero ALTO e dal club di volo libero di Lans en l'air."
    ],
    "fr": [
      "Le site école majeur du nord Vercors. Il est géré par le comité départementale de vol libre, l’école de vol libre ALTO ainsi que le club de vol libre Lans en l'air."
    ],
    "nl": [
      "Het belangrijkste oefenterrein in de noordelijke Vercors. Het wordt beheerd door de departementale vrije vluchtcommissie, de ALTO vrije vluchtschool en de vrije vluchtclub Lans en l'air."
    ],
    "es": [
      "Es el principal centro de entrenamiento del norte del Vercors. Está gestionado por el comité departamental de vuelo libre, la escuela de vuelo libre ALTO y el club de vuelo libre Lans en l'air."
    ]
  },
  "rdfs:label": {
    "fr": [
