  "rdfs:comment": {
    "de": [
      "Im regionalen Naturpark Baronnies Provençales, 5 km von Rosans entfernt, liegt das Dorf Verclause, sein Fluss Eygues und ein Landrestaurant mit einer vollständig hausgemachten Speisekarte, die vor allem auf lokale Produkte setzt."
    ],
    "en": [
      "A friendly restaurant situated between the Baronnies and the Rosans area.\r\nCome and enjoy our outdoor terrace and taste our fresh regional cuisine of the season."
    ],
    "it": [
      "Nel parco naturale regionale delle Baronnies provençales, a 5 km da Rosans, un villaggio chiamato Verclause, il suo fiume Eygues e un ristorante locale con un menu interamente fatto in casa, utilizzando prodotti locali."
    ],
    "fr": [
      "Dans le parc naturel régional des Baronnies provençales, à 5km de Rosans, un village Verclause, sa rivière l'Eygues et un restaurant de pays avec une carte entièrement faite maison en faisant la part belle aux produits locaux."
    ],
    "nl": [
      "Restaurant gelegen tussen Les Baronnies en het gebied rondom Rosans.\r\nProfiteer van het schaduwrijke terras bij l'Escargot Rouge en proef onze regionale keuken met verse seizoenproducten."
    ],
    "es": [
      "En el parque natural regional de las Baronnies provenzales, a 5 km de Rosans, un pueblo llamado Verclause, su río el Eygues y un restaurante local con un menú totalmente casero, a base de productos locales."
    ]
  },
