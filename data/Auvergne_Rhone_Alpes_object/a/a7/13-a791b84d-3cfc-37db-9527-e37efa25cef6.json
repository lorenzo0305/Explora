  "rdfs:comment": {
    "de": [
      "In einer familiären Atmosphäre bietet Ihnen diese Bar - Restaurant eine traditionelle und saisonale Küche in einem Raum mit schickem und modernem Dekor oder einer Terrasse im Herzen von Châtillon"
    ],
    "en": [
      "In a family atmosphere, this bar-restaurant offers traditional, seasonal cuisine in a chic, modern setting or on the terrace in the heart of Châtillon"
    ],
    "it": [
      "In un'atmosfera familiare, questo bar-ristorante serve una cucina tradizionale e stagionale in un ambiente elegante e moderno o sulla terrazza nel cuore di Châtillon"
    ],
    "fr": [
      "Dans une ambiance familiale, ce bar - restaurant vous propose une cuisine traditionnelle et de saison dans une salle au décor chic et moderne ou une terrasse en plein coeur de Châtillon"
    ],
    "nl": [
      "In een familiale sfeer serveert dit bar-restaurant traditionele, seizoensgebonden gerechten in een chique, moderne omgeving of op het terras in het hart van Châtillon"
    ],
    "es": [
      "En un ambiente familiar, este bar-restaurante sirve cocina tradicional de temporada en un ambiente elegante y moderno o en la terraza, en pleno centro de Châtillon"
    ]
  },
