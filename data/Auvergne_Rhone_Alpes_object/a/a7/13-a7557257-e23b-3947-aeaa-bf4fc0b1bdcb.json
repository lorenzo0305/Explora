  "rdfs:comment": {
    "de": [
      "In einer grünen Oase von 2,5 Hektar, zwischen hundertjährigen Bäumen und den Ufern des Baches Thiez, lädt Les Lodges du Lac Sie zu einer zeitlosen Auszeit ein, nur wenige Schritte vom See von Aiguebelette entfernt."
    ],
    "en": [
      "Set in 2.5 hectares of lush greenery, between century-old trees and the banks of the Thiez stream, Les Lodges du Lac invites you to take a timeless break just a stone's throw from Lac d'Aiguebelette."
    ],
    "it": [
      "Immerso in 2,5 ettari di verde lussureggiante, tra alberi secolari e le rive del torrente Thiez, Les Lodges du Lac vi invita a concedervi una pausa senza tempo a due passi dal lago di Aiguebelette."
    ],
    "fr": [
      "Dans un écrin de verdure de 2,5 hectares, entre les arbres centenaires et les rives du ruisseau du Thiez, Les Lodges du Lac vous invitent à une parenthèse hors du temps, à deux pas du lac d’Aiguebelette."
    ],
    "es": [
      "Situado en 2,5 hectáreas de exuberante vegetación, entre árboles centenarios y a orillas del arroyo Thiez, Les Lodges du Lac le invitan a tomarse un descanso atemporal a dos pasos del lago Aiguebelette."
    ],
    "nl": [
      "Les Lodges du Lac, gelegen op 2,5 hectare weelderig groen tussen eeuwenoude bomen en de oevers van de beek Thiez, nodigt je uit voor een tijdloze vakantie op een steenworp afstand van het meer van Aiguebelette."
    ]
  },
  "rdfs:label": {
    "en": [
      "Les Lodges du Lac · Hotel and huts"
    ],
    "fr": [
      "Les Lodges du Lac · Hôtel et cabanes"
    ]
  },
