  "rdfs:comment": {
    "de": [
      "Machen Sie einen Spaziergang mit Groß und Klein auf unseren schattigen Wegen und begegnen Sie unseren Tieren. Viele verschiedene Arten werden Sie unterhalten und in Staunen versetzen."
    ],
    "en": [
      "Come and walk along our shady paths to meet our animals. Many different species will be there to entertain and amaze you."
    ],
    "it": [
      "Venite a vivere una parentesi incantata nel cuore del nostro parco ombreggiato per un incontro indimenticabile dove accarezzare e dare da mangiare ai nostri animali diventa un momento di pura magia per grandi e piccini."
    ],
    "fr": [
      "Venez vivre une parenthèse enchantée au cœur de notre parc ombragé pour une rencontre inoubliable où caresser et nourrir nos animaux devient un moment de pure magie pour petits et grands."
    ],
    "es": [
      "Venga a vivir un interludio encantado en el corazón de nuestro sombreado parque para disfrutar de un encuentro inolvidable en el que acariciar y dar de comer a nuestros animales se convierte en un momento de pura magia para pequeños y mayores."
    ],
    "nl": [
      "Kom langs onze schaduwrijke paden om onze dieren te ontmoeten. Er zullen veel verschillende soorten zijn om je te vermaken en te verbazen."
    ]
  },
