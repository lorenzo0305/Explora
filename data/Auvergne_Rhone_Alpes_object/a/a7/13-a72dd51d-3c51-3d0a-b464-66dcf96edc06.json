  "rdfs:comment": {
    "de": [
      "Im Herzen von Marignieu, einem traditionellen Dorf in Bugiste, empfängt Sie das Maison Angelot, ein Betrieb mit dem Zertifikat Haute Valeur Environnementale, jeden Tag zur Entdeckung seiner Bugey-Weine."
    ],
    "en": [
      "In the heart of Marignieu, a traditional Bugiste village, Maison Angelot, a certified High Environmental Value farm, welcomes you every day to discover its Bugey wines."
    ],
    "it": [
      "Nel cuore di Marignieu, tradizionale villaggio bugista, la Maison Angelot, azienda agricola certificata ad alto valore ambientale, vi accoglie ogni giorno per scoprire i suoi vini Bugey."
    ],
    "fr": [
      "Au coeur de Marignieu, village traditionnel bugiste, la Maison Angelot, exploitation certifiée Haute Valeur Environnementale, vous accueille tous les jours pour une découverte de ses vins du Bugey."
    ],
    "nl": [
      "In het hart van Marignieu, een traditioneel Bugistendorp, verwelkomt Maison Angelot, een gecertificeerde boerderij met hoge milieuwaarde, u elke dag om zijn Bugey-wijnen te ontdekken."
    ],
    "es": [
      "En el corazón de Marignieu, un pueblo tradicional bugista, la Maison Angelot, una granja certificada de alto valor medioambiental, le da la bienvenida cada día para descubrir sus vinos Bugey."
    ]
  },
