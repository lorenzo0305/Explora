  "rdfs:comment": {
    "de": [
      "Eden Marine liegt am Ufer der Rhône in der Freizeitanlage Vallée Bleue und bietet Elektroboote ohne Führerschein zum Verleih an. So können Sie mit der ganzen Familie die Rhône und die Brotteaux-Inseln entdecken, die nur einen Steinwurf entfernt liegen."
    ],
    "en": [
      "Located on the banks of the Rhône at the Vallée Bleue leisure centre, Eden Marine offers electric boats for hire without a licence. You and your family can discover the Rhône and the Brotteaux islands just a stone's throw away."
    ],
    "it": [
      "Situato sulle rive del Rodano, presso il centro ricreativo Vallée Bleue, Eden Marine offre barche elettriche a noleggio senza patente. Voi e la vostra famiglia potrete scoprire il Rodano e le isole Brotteaux a pochi passi di distanza."
    ],
    "fr": [
      "Implanté au bord du Rhône, sur la base de loisirs de la Vallée Bleue, Eden Marine propose à la location des bateaux électriques sans permis. Vous pourrez ainsi découvrir en famille le Rhône et les îles des Brotteaux situés à quelques encablures."
    ],
    "es": [
      "Situada a orillas del Ródano, en el centro de ocio Vallée Bleue, Eden Marine le propone el alquiler de barcos eléctricos sin licencia. Descubra en familia el Ródano y las islas Brotteaux a dos pasos."
    ],
    "nl": [
      "Eden Marine, gelegen aan de oevers van de Rhône in het recreatiecentrum Vallée Bleue, verhuurt elektrische boten zonder vaarbewijs. Ontdek samen met uw gezin de Rhône en de Brotteaux eilanden op een steenworp afstand."
    ]
  },
  "rdfs:label": {
    "en": [
      "Eden Marine - electric boat hire"
    ],
    "fr": [
      "Eden Marine - location de bateaux électriques"
    ]
  },
