  "rdfs:comment": {
    "de": [
      "Touristischer Informationsbereich, in dem Sie alle notwendigen Informationen finden, um einen angenehmen Aufenthalt im Beaujolais zu verbringen. Wanderungen, Museen, Kulturerbe, Gastronomie, Unterkünfte, Freiluftaktivitäten, Veranstaltungen und Boutique-Bereich."
    ],
    "en": [
      "Tourist information site where you'll find all the necessary information to enjoy your stay in the Beaujolais area. Hikes, museums, heritage, gastronomy, accommodation, open air activities and events..."
    ],
    "it": [
      "Uno spazio di informazione turistica dove troverete tutte le informazioni necessarie per un piacevole soggiorno nel Beaujolais. Escursioni, musei, patrimonio, gastronomia, alloggi, attività all'aperto, eventi e un negozio."
    ],
    "fr": [
      "Espace d'information touristique où vous trouverez tous les renseignements nécessaires pour passer un agréable séjour en Beaujolais. Randonnées, musée, patrimoine, gastronomie, hébergement, activités de plein air, évènements et espace Boutique."
    ],
    "es": [
      "Un espacio de información turística donde encontrará toda la información necesaria para una estancia agradable en el Beaujolais. Senderismo, museos, patrimonio, gastronomía, alojamiento, actividades al aire libre, eventos y una tienda."
    ],
    "nl": [
      "Een toeristische informatieruimte waar u alle informatie vindt voor een aangenaam verblijf in de Beaujolais. Wandelen, musea, erfgoed, gastronomie, accommodatie, buitenactiviteiten, evenementen en een winkel."
    ]
  },
