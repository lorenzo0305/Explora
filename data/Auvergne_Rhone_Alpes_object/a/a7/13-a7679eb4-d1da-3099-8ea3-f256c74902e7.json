  "rdfs:comment": {
    "de": [
      "Caroline und Gérard lassen Sie ihre Leidenschaft für Ziegen und die Landwirtschaft in den Bergen entdecken.\r\nVerkaufsladen auf dem Bauernhof und Angebot von Besichtigungen, bei denen Sie hinter die Kulissen des Bauernhofs blicken können."
    ],
    "en": [
      "Caroline and Gérard will share with you their passion for goats and mountain farming.\r\nOn-farm store and behind-the-scenes tours of the farm."
    ],
    "it": [
      "Caroline e Gérard condivideranno con voi la loro passione per le capre e l'agricoltura di montagna.\r\nAcquisti in fattoria e visite dietro le quinte."
    ],
    "fr": [
      "Caroline et Gérard vous feront découvrir leur passion pour les chèvres et l'agriculture de montagne. \r\nMagasin de vente à la ferme et proposition de visites à la découverte des coulisses de la ferme."
    ],
    "es": [
      "Caroline y Gérard compartirán con usted su pasión por las cabras y la agricultura de montaña.\r\nTienda en la granja y visitas entre bastidores."
    ],
    "nl": [
      "Caroline en Gérard delen hun passie voor geiten en berglandbouw met je.\r\nWinkel op de boerderij en rondleidingen achter de schermen."
    ]
  },
