  "rdfs:comment": {
    "de": [
      "Caroline, Laurent, Marie-Odile, Coralie, Audrey... und die anderen, das sind wir Curieux de Vercors!... Ein fröhliches Team von professionellen Bergfreunden mit Diplom (Diplôme d'Etat Accompagnateur en Moyenne Montagne)."
    ],
    "en": [
      "Caroline, Laurent, Marie-Odile, Coralie, Audrey... and the others, that's us, Curieux de Vercors!... A happy team of professionals with a passion for the mountains and a diploma (Diplôme d'Etat Accompagnateur en Moyenne Montagne)."
    ],
    "it": [
      "Caroline, Laurent, Marie-Odile, Coralie, Audrey... e gli altri, siamo i Curieux de Vercors!... Un'allegra squadra di professionisti con la passione per la montagna e le qualifiche (Diplôme d'Etat Accompagnateur en Moyenne Montagne)."
    ],
    "fr": [
      "Caroline, Laurent, Marie-Odile, Coralie, Audrey…. et les autres, c’est nous Curieux de Vercors !...Une joyeuse équipe de professionnels passionnés de montagne et diplômés (Diplôme d'Etat Accompagnateur en Moyenne Montagne)."
    ],
    "es": [
      "Caroline, Laurent, Marie-Odile, Coralie, Audrey... y los demás, ¡somos Curieux de Vercors!... Un equipo feliz de profesionales apasionados por la montaña y cualificados (Diplôme d'Etat Accompagnateur en Moyenne Montagne)."
    ],
    "nl": [
      "Caroline, Laurent, Marie-Odile, Coralie, Audrey... en de anderen, wij zijn Curieux de Vercors!.. Een gelukkig team van professionals met een passie voor de bergen en kwalificaties (Diplôme d'Etat Accompagnateur en Moyenne Montagne)."
    ]
  },
