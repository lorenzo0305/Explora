  "rdfs:comment": {
    "de": [
      "Kommen Sie mit auf eine Reise von Baum zu Baum im Herzen des Waldes von Dronières. In einer grünen Oase erleben Sie einzigartige Momente mit seinen Affenbrücken, Tarzanlianen... die Sie mit Freunden, der Familie oder in der Gemeinschaft teilen können."
    ],
    "en": [
      "Take a trip from tree to tree in the heart of the Dronières forest. In a green setting, experience unique moments with monkey bridges, Tarzan lianas... to be shared with friends, family or groups."
    ],
    "it": [
      "Un viaggio da un albero all'altro nel cuore della foresta di Dronières. In un ambiente verde, vivete momenti unici con i ponti delle scimmie, le liane di Tarzan... da condividere con amici, famiglia o gruppi."
    ],
    "fr": [
      "Venez faire un voyage d'arbre en arbre au cœur de la forêt des Dronières. Dans un écrin de verdure, vivez des instants uniques avec ses ponts de singes, liane de tarzan... à partager entre amis, en famille, ou en collectivité."
    ],
    "es": [
      "Viaje de árbol en árbol en el corazón del bosque de Dronières. En un entorno verde, viva momentos únicos con sus puentes de monos, lianas de Tarzán... para compartir con amigos, familia o grupos."
    ],
    "nl": [
      "Maak een tocht van boom tot boom in het hart van het bos van Dronières. Beleef in een groene omgeving unieke momenten met zijn apenbruggen, Tarzanlianen... om te delen met vrienden, familie of als groep."
    ]
  },
