  "rdfs:comment": {
    "de": [
      "Als Junglandwirte in Megève produzieren wir von November bis März Reblochon fermier und von April bis Oktober Abondance fermier. Im Sommer begrüßen wir Sie zum Direktverkauf auf dem Bauernhof, der eine Stunde Fußweg vom Parkplatz Leutaz entfernt liegt."
    ],
    "en": [
      "Young farmers from Megève, we produce farmhouse Reblochon from November to March and farmhouse Abondance from April to October. During the summertime, we welcome you for direct sales at the farm, a one hour walk from the Leutaz parking lot."
    ],
    "it": [
      "Come giovani agricoltori di Megève, produciamo l'agriturismo Reblochon da novembre a marzo e l'agriturismo Abondance da aprile a ottobre. Vi accogliamo per la vendita diretta in fattoria, a 1 ora di cammino dal parcheggio di Leutaz."
    ],
    "fr": [
      "Jeunes agriculteurs de Megève nous produisons du reblochon fermier de novembre à mars et de l’abondance fermier d’avril à octobre. L'été, nous vous accueillons pour de la vente directe à la ferme à 1h de marche depuis le parking du Leutaz."
    ],
    "es": [
      "Como jóvenes agricultores de Megève, producimos en la granja Reblochon de noviembre a marzo y en la granja Abondance de abril a octubre. En verano, le invitamos a vender directamente desde la granja, a 1 hora a pie desde el aparcamiento de Leutaz."
    ],
    "nl": [
      "Als jonge boeren in Megève produceren we boerderij Reblochon van november tot maart en boerderij Abondance van april tot oktober. In de zomer verwelkomen we je om rechtstreeks vanaf de boerderij te verkopen, op 1 uur lopen van de parkeerplaats van Leutaz."
    ]
  },
  "rdfs:label": {
    "en": [
      "Les Alpagistes GAEC (Farming Association)"
    ],
    "it": [
      "GAEC Les Alpagistes"
    ],
