      "dc:description": {
        "de": [
          "Informationen :\n\nSpeisekarte :\nBesuchen Sie die Website der Marinella Pizzeria\n\nTage der Öffnung:\nDienstag bis Sonntag: 11:0-14:00 18:30-22:00\n\nAbholung:\nMittags und abends zum Mitnehmen\n\nBestellungen:\nZum Mitnehmen: Bestellungen unter 03 91 19 51 16\n "
        ],
        "en": [
          "Information :\n\nMenu :\nVisit the Marinella Pizzeria website\n\nOpening days:\nTuesday to Sunday: 11:0-14:00 18:30-22:00\n\nCollection:\nTakeaway lunch and dinner\n\nTo order:\nTakeaway: orders on 03 91 19 51 16\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nMenu :\nVisita il sito web della pizzeria Marinella\n\nGiorni di apertura:\nDa martedì a domenica: 11:0-14:00 18:30-22:00\n\nRaccolta:\nDa asporto per pranzo e cena\n\nPer ordinare:\nDa asporto: ordinare allo 03 91 19 51 16\n "
        ],
        "fr": [
          "Informations :\n\nMenu :\nConsultez le site internet de la Marinella Pizzeria\n\nJours d'ouverture : \nDu mardi au dimanche : 11:0-14:00 18:30-22:00\n\nRetrait :\nÀ emporter midi et soir\n\nCommandes: \nÀ emporter : commandes au 03 91 19 51 16\n "
        ],
        "nl": [
          "Meer informatie :\n\nMenu :\nBezoek de website van Marinella Pizzeria\n\nOpeningsdagen:\nDinsdag t/m zondag: 11:0-14:00 18:30-22:00\n\nAfhalen:\nAfhalen voor lunch en diner\n\nOm te bestellen:\nAfhalen: bestellen op 03 91 19 51 16\n "
        ],
        "es": [
          "Más información :\n\nMenú :\nVisite el sitio web de la pizzería Marinella\n\nDías de apertura:\nDe martes a domingo: 11:0-14:00 18:30-22:00\n\nRecogida:\nComida y cena para llevar\n\nPara pedir:\nPara llevar: pedir al 03 91 19 51 16\n "
        ]
      },
