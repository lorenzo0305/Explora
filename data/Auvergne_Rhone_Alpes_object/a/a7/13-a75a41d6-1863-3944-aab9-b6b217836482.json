  "rdfs:comment": {
    "de": [
      "Béatrice ist Polstererin für Möbel und Sitzmöbel. Sie fertigt und renoviert individuelle und maßgefertigte Lampenschirme, Vorhänge, Sessel und Kissen."
    ],
    "en": [
      "Béatrice is an upholsterer. She makes and renovates personalized and made-to-measure lampshades, curtains, armchairs and cushions."
    ],
    "it": [
      "Béatrice è una tappezziera. Realizza e rinnova paralumi, tende, poltrone e cuscini su misura."
    ],
    "fr": [
      "Béatrice est tapissière d’ameublement et sièges. Elle fabrique et rénove des abats jour personnalisés et sur mesure, des rideaux, des fauteuils, des coussins."
    ],
    "nl": [
      "Béatrice is stoffeerster. Ze maakt en renoveert op maat gemaakte lampenkappen, gordijnen, fauteuils en kussens."
    ],
    "es": [
      "Béatrice es tapicera. Confecciona y renueva a medida pantallas de lámparas, cortinas, sillones y cojines."
    ]
