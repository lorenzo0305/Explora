      "dc:description": {
        "de": [
          "Gemütliche Pizzeria mit Holzfeuer, hausgemachte italienische Küche, guter Empfang und freundliche Atmosphäre im Vidocq in Arras."
        ],
        "en": [
          "Cosy wood-fired pizzeria, homemade Italian cuisine, warm welcome and friendly atmosphere at Le Vidocq in Arras."
        ],
        "it": [
          "Un'accogliente pizzeria a legna, una cucina italiana casalinga, un'accoglienza calorosa e un'atmosfera amichevole presso Le Vidocq ad Arras."
        ],
        "fr": [
          "Pizzeria chaleureuse au feu de bois, cuisine italienne maison, bon accueil et ambiance conviviale au Vidocq à Arras."
        ],
        "es": [
          "Una acogedora pizzería de leña, cocina italiana casera, una cálida bienvenida y un ambiente agradable en Le Vidocq, en Arras."
        ],
        "nl": [
          "Een gezellige houtgestookte pizzeria, Italiaanse keuken, een warm welkom en een vriendelijke sfeer in Le Vidocq in Arras."
        ]
      },
