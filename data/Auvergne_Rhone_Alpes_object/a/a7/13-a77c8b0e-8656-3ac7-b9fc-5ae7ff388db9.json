  "rdfs:comment": {
    "de": [
      "Die Natur rebelliert gegen den Menschen. Darstellung eines unschuldigen Mädchens, das die Erde geerbt hat und die zukünftigen Generationen repräsentiert, die unter dem Klimawandel leiden werden, den wir nicht verhindern konnten."
    ],
    "en": [
      "Nature rebels against man. Representation of an innocent little girl who has inherited the Earth and who represents the future generations who will have to endure the climate change we have failed to prevent."
    ],
    "it": [
      "La natura si ribella all'uomo. Una rappresentazione di una bambina innocente che ha ereditato la Terra e che rappresenta le generazioni future che dovranno sopportare i cambiamenti climatici che non siamo stati in grado di prevenire."
    ],
    "fr": [
      "La nature se rebelle contre l'homme. Représentation d'une petite fille innocente qui a hérité de la Terre et qui représente les futures générations qui devront subir les changements climatiques que nous n'auront pas sû empêcher."
    ],
    "es": [
      "La naturaleza se rebela contra el hombre. Una representación de una niña inocente que ha heredado la Tierra y que representa a las generaciones futuras que tendrán que soportar el cambio climático que no hemos podido evitar."
    ],
    "nl": [
      "De natuur komt in opstand tegen de mens. Een voorstelling van een onschuldig klein meisje dat de aarde heeft geërfd en dat de toekomstige generaties vertegenwoordigt die de klimaatverandering, die we niet hebben kunnen voorkomen, zullen moeten doorstaan."
    ]
  },
  "rdfs:label": {
    "de": [
      "Wandgemälde: War Zoo"
    ],
    "en": [
      "Fresco: War Zoo"
    ],
    "it": [
      "Affresco: Zoo di guerra"
    ],
    "fr": [
      "Fresque : War Zoo"
    ],
    "nl": [
      "Fresco: Oorlogsdierentuin"
    ]
  },
