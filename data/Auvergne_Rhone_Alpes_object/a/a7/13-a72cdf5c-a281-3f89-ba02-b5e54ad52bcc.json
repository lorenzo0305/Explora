  "rdfs:comment": {
    "de": [
      "Unterricht, Praxis und Perfektionierung des Paartanzes: kubanische Salsa, Bachata, Rock, Cha-cha und Kizomba.\r\nDas alles in einer guten Atmosphäre, mit einem Lächeln und der Freude, gute Momente zu teilen!\r\nOffen für alle: Anfänger und Fortgeschrittene."
    ],
    "en": [
      "Teaching, practicing and perfecting couple dancing: Cuban Salsa, Bachata, Rock, Cha-cha and Kizomba.\r\nAll in a great atmosphere, with a smile and the pleasure of sharing good times!\r\nOpen to all: beginners and advanced."
    ],
    "it": [
      "Insegnamento, pratica e perfezionamento del ballo di coppia: Salsa cubana, Bachata, Rock, Cha-cha e Kizomba.\r\nIl tutto in una grande atmosfera, con il sorriso e il piacere di condividere bei momenti!\r\nAperto a tutti: principianti e avanzati."
    ],
    "fr": [
      "Enseignement, pratique et perfectionnement de la danse de couple : Salsa Cubaine, Bachata, Rock, Cha-cha et Kizomba.\r\nLe tout dans une bonne ambiance, avec le sourire et le plaisir de partager de bons moments !\r\nOuvert à tous : débutants et confirmés."
    ],
    "es": [
      "Enseñar, practicar y perfeccionar el baile en pareja: Salsa cubana, Bachata, Rock, Cha-cha y Kizomba.\r\n¡Todo en un gran ambiente, con una sonrisa y el placer de compartir buenos momentos!\r\nAbierto a todos: principiantes y avanzados."
    ],
    "nl": [
      "Aanleren, oefenen en perfectioneren van partnerdans: Cubaanse Salsa, Bachata, Rock, Cha-cha en Kizomba.\r\nDit alles in een geweldige sfeer, met een glimlach en het plezier van het delen van goede tijden!\r\nOpen voor iedereen: beginners en gevorderden."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Tonic Dans'Club"
    ]
  },
