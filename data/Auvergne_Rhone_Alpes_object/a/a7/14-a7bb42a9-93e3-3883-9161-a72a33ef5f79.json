  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/16cde9a2-30c7-33bc-8798-39f12375fa9d",
      "dc:description": {
        "de": [
          "Laurence empfängt Sie in ihrem Teesalon, Restaurant Le Rodière gegenüber der Place Darnétal.\nSie bietet Ihnen Schmorgerichte, Kuchen , Gerichte und Sandwiches zum Mitnehmen, ein Croissant am Morgen? viele gute Dinge, die vor Ort mit saisonalen Produkten, aber vor allem mit Liebe und Leidenschaft gekocht werden!"
        ],
        "en": [
          "Laurence welcomes you to her salon de thé, Restaurant Le Rodière, opposite Place Darnétal.\nShe offers simmered dishes, pies, takeaway meals and sandwiches, a croissant in the morning... all cooked on the premises with seasonal produce, but above all with love and passion!"
        ],
        "it": [
          "Laurence vi accoglie nella sua sala da tè, il ristorante Le Rodière, di fronte a Place Darnétal.\nOffre piatti a fuoco lento, crostate, piatti da asporto e panini, un croissant al mattino? Tutte cose buone cucinate sul posto con prodotti di stagione, ma soprattutto con amore e passione!"
        ],
        "fr": [
          "Laurence vous accueille dans son Salon de thé, Restaurant Le Rodière  en face de la place Darnétal. \nElle vous propose des plats mijotés, des tartes , des plats et sandwichs à emporter, un croissant le matin … plein de bonnes choses cuisinées sur place avec des produits de saison mais surtout avec Amour et Passion !"
        ],
        "es": [
          "Laurence le da la bienvenida a su salón de té, el Restaurante Le Rodière, frente a la Place Darnétal.\nOfrece platos cocinados a fuego lento, tartas, platos para llevar y bocadillos, un cruasán por la mañana... ¡todo lo bueno cocinado en el local con productos de temporada, pero sobre todo con amor y pasión!"
        ],
        "nl": [
          "Laurence heet je welkom in haar tearoom, Restaurant Le Rodière, tegenover Place Darnétal.\nZe biedt gestoofde gerechten, taarten, meeneemgerechten en sandwiches, een croissant in de ochtend? Allemaal lekkers dat ter plekke wordt bereid met seizoensproducten, maar vooral met liefde en passie!"
        ]
      },
      "@type": [
        "Description"
      ],
