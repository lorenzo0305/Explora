  "rdfs:comment": {
    "de": [
      "Der Espace Mosaïk liegt im Herzen des Dorfes Pomeys und empfängt Sie in einem vollständig renovierten, angenehmen und für den Empfang der Öffentlichkeit geeigneten Raum."
    ],
    "en": [
      "Situated in the heart of the village of Pomeys, Espace Mosaïk welcomes you to a pleasant, fully-renovated venue, ideally suited to welcoming the public."
    ],
    "it": [
      "Situato nel cuore del villaggio di Pomeys, l'Espace Mosaïk vi accoglie in un locale completamente rinnovato, attraente e adatto al pubblico."
    ],
    "fr": [
      "Situé au cœur du village de Pomeys, l’espace Mosaïk vous accueille dans un lieu entièrement rénové, agréable et adapté à l’accueil du public."
    ],
    "es": [
      "Situado en el corazón del pueblo de Pomeys, el Espace Mosaïk le da la bienvenida a un local totalmente renovado, agradable y bien adaptado al público."
    ],
    "nl": [
      "Espace Mosaïk, gelegen in het hart van het dorp Pomeys, verwelkomt je in een volledig gerenoveerde, aangename locatie die zeer geschikt is voor het publiek."
    ]
  },
