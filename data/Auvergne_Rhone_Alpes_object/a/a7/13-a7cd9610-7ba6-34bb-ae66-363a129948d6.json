  "rdfs:comment": {
    "de": [
      "Le Polinno ist ein für alle offener Dritter Ort in der Süd-Ardèche und im Nord-Gard, der sich dem künstlerischen Schaffen, dem geteilten Know-how und dem Zugang zu digitalen Werkzeugen widmet."
    ],
    "en": [
      "The Polinno is a third-location center open to all, dedicated to artistic creation, shared know-how and access to digital tools, in southern Ardèche and northern Gard."
    ],
    "it": [
      "Polinno è un centro di terza parte aperto a tutti, dedicato alla creazione artistica, al know-how condiviso e all'accesso agli strumenti digitali nelle regioni dell'Ardèche meridionale e del Gard settentrionale."
    ],
    "fr": [
      "Le Polinno est un tiers-lieu ouvert à tous, dédié à la création artistique, aux savoir-faire partagés et à l'accès aux outils numériques, en sud-Ardèche et nord-Gard."
    ],
    "nl": [
      "Polinno is opgericht als antwoord op vraagstukken rondom het thema ambacht. Het draait er vooral om het delen van vakkennis en het bieden van digitale hulpmiddelen."
    ],
    "es": [
      "Polinno es un centro para terceros abierto a todos, dedicado a la creación artística, el intercambio de conocimientos y el acceso a las herramientas digitales en las regiones del sur de Ardèche y el norte de Gard."
    ]
  },
  "rdfs:label": {
    "en": [
      "Fablab -  Pôle d'innovation dédié aux métiers d'art en Ardèche méridionale"
    ],
    "fr": [
      "Fablab - Pôle d'innovation dédié aux métiers d'art en Ardèche méridionale"
    ],
    "nl": [
      "Fablab - Innovatiecentrum gewijd aan ambacht in het zuiden van de Ardèche"
    ]
  },
