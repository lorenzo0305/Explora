  "rdfs:comment": {
    "de": [
      "Cotta ist Liebe auf den ersten Blick auf italienische Art, eine Liebe zur neapolitanischen Pizza der neuen Generation, die den Ursprung der Begegnung zwischen Olivier, einem Unternehmer, der die Gastronomie liebt, und Magdiel, einem charismatischen Pizzabäcker, darstellt."
    ],
    "en": [
      "Cotta is Italian-style love at first sight, a love of new-generation Neapolitan pizza that led to the meeting of Olivier, an entrepreneur with a passion for gastronomy, and Magdiel, a charismatic pizza chef."
    ],
    "it": [
      "Cotta è un amore a prima vista all'italiana, un amore per la pizza napoletana di nuova generazione che ha portato all'incontro tra Olivier, un imprenditore con la passione per la gastronomia, e Magdiel, un pizzaiolo carismatico."
    ],
    "fr": [
      "Cotta, c’est le coup de foudre à l’italienne, un amour de la pizza napolitaine nouvelle génération à l’origine de la rencontre d’Olivier, un entrepreneur amoureux de gastronomie et de Magdiel, un pizzaïolo charismatique."
    ],
    "nl": [
      "Cotta is Italiaanse liefde op het eerste gezicht, een liefde voor Napolitaanse pizza van de nieuwe generatie die leidde tot de ontmoeting tussen Olivier, een ondernemer met een passie voor gastronomie, en Magdiel, een charismatische pizzabakker."
    ],
    "es": [
      "Cotta es amor a primera vista a la italiana, un amor por la pizza napolitana de nueva generación que propició el encuentro de Olivier, un empresario apasionado por la gastronomía, y Magdiel, un carismático pizzero."
    ]
  },
