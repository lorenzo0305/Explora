  "rdfs:comment": {
    "de": [
      "Als Spezialist für Outdoor-Sportarten organisiert TAKAMAKA Grenoble Outdoor-Ausflüge und vermietet Bergsportausrüstung: Klettersteigsets, Canyoning, Bergsteigen, Skier, Schneeschuhe, Schlitten, Fahrräder, Kanus."
    ],
    "en": [
      "Specializing in outdoor sports, TAKAMAKA Grenoble organizes outdoor outings and rents out mountain equipment: via-ferrata kits, canyoning, mountaineering, skis, snowshoes, sledges, bikes and canoes."
    ],
    "it": [
      "TAKAMAKA Grenoble è specializzato in sport all'aria aperta, organizzando uscite e noleggiando attrezzature da montagna: kit da via-ferrata, canyoning, alpinismo, sci, racchette da neve, slitte, biciclette e canoe."
    ],
    "fr": [
      "Spécialiste des sports en plein air, TAKAMAKA Grenoble organise des sorties outdoors et propose la location de matériel de montagne : kits via-ferrata, canyoning, alpinisme, skis, raquettes, luges, vélos, canoës."
    ],
    "nl": [
      "TAKAMAKA Grenoble is gespecialiseerd in buitensporten, het organiseren van uitstapjes en het verhuren van berguitrustingen: via-ferrata-kits, canyoning, alpinisme, ski's, sneeuwschoenen, sleeën, fietsen en kano's."
    ],
    "es": [
      "TAKAMAKA Grenoble está especializada en deportes al aire libre, organización de salidas y alquiler de material de montaña: kits de vía ferrata, barranquismo, alpinismo, esquís, raquetas de nieve, trineos, bicicletas y canoas."
    ]
  },
