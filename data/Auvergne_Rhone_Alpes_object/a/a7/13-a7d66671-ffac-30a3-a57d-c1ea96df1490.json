  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Gebiet der Communauté de communes Val de Saône Centre mithilfe von Geocaching! Mit jedem Geocache können Sie ein wenig mehr über die Stadt Montmerle-sur-Saône erfahren."
    ],
    "en": [
      "Discover the territory of the Community of Communes Val de Saône Center through geocaching! Each geocache will allow you to learn a little more about the town of Montmerle-sur-Saône."
    ],
    "it": [
      "Scoprite la Comunità di Comuni Val de Saône Centre attraverso il geocaching! Ogni geocache vi racconterà qualcosa in più sulla città di Montmerle-sur-Saône."
    ],
    "fr": [
      "Partez à la découverte du territoire de la Communauté de communes Val de Saône Centre à travers le géocaching ! Chaque géocache vous permettra d'en apprendre un peu plus sur la ville de Montmerle-sur-Saône."
    ],
    "nl": [
      "Ontdek de gemeente Val de Saône Centre door middel van geocaching! Elke geocache vertelt je iets meer over de stad Montmerle-sur-Saône."
    ],
    "es": [
      "Descubra la Mancomunidad de Municipios del Centro Val de Saône a través del geocaching Cada geocaché le contará algo más sobre la ciudad de Montmerle-sur-Saône."
    ]
  },
