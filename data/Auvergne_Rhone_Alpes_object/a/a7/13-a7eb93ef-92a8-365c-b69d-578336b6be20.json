  "rdfs:comment": {
    "de": [
      "Es wurde von dem Architekten Novarina im Rahmen der Olympischen Spiele 1968 erbaut und weist eine kühne Betonarchitektur mit zahlreichen Kunstwerken auf."
    ],
    "en": [
      "Built by the architect Novarina as part of the 1968 Olympic games, Grenoble’s city hall is built in an audacious concrete architectural style and houses many works of art."
    ],
    "it": [
      "Costruito dall'architetto Novarina per i Giochi Olimpici del 1968, presenta un'audace architettura in cemento con numerose opere d'arte."
    ],
    "fr": [
      "Construit par l'architecte Novarina dans le cadre des Jeux Olympiques de 1968, il présente une audacieuse architecture de béton avec de nombreuses oeuvres d'art."
    ],
    "nl": [
      "Gebouwd door de architect Novarina voor de Olympische Spelen van 1968, heeft het een gedurfde betonnen architectuur met veel kunstwerken."
    ],
    "es": [
      "Construido por el arquitecto Novarina para los Juegos Olímpicos de 1968, presenta una atrevida arquitectura de hormigón y numerosas obras de arte."
    ]
  },
