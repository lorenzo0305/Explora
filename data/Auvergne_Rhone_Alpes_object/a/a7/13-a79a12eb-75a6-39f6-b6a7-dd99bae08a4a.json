  "rdfs:comment": {
    "de": [
      "Biologische und biodynamische Produktion, der Betrieb ist leicht von der D8 aus erreichbar. Er liegt an Hängen gegenüber der Ebene von Roannais. Wir produzieren Rot- und Weißweine aus den Rebsorten Gamay und Chenin."
    ],
    "en": [
      "Organic and biodynamic production, easily accessible from the D8. Located on hillsides overlooking the Roannais plain. We produce red and white wines from Gamay and Chenin grapes."
    ],
    "it": [
      "Produzione biologica e biodinamica, facilmente accessibile dalla D8. Situata su una collina che domina la pianura di Roannais. Produciamo vini rossi e bianchi da uve Gamay e Chenin."
    ],
    "fr": [
      "Production bio et biodynamie, exploitation facilement accessible depuis la D8. Située sur des coteaux face à la plaine du Roannais. Nous produisons des vins rouges et blancs en cépages Gamay et Chenin."
    ],
    "es": [
      "Producción ecológica y biodinámica, fácilmente accesible desde la D8. Situada en las laderas que dominan la llanura de Roannais. Producimos vinos tintos y blancos a partir de uvas Gamay y Chenin."
    ],
    "nl": [
      "Biologische en biodynamische productie, gemakkelijk bereikbaar vanaf de D8. Gelegen op hellingen met uitzicht op de Roannais-vlakte. We produceren rode en witte wijnen van Gamay en Chenin druiven."
    ]
  },
