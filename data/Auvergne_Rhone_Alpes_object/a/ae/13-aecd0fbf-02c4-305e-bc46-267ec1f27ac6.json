  "rdfs:comment": {
    "de": [
      "Haben Sie Lust auf ein zeitloses Wochenende inmitten einer außergewöhnlichen Naturlandschaft?\r\nRetro Camping lädt Sie auf den Campingplatz La Chanterelle in Champagnac-le-Vieux (43) ein, um einen geselligen Moment im Zeichen der guten Laune zu verbringen"
    ],
    "en": [
      "Looking for a timeless weekend in the heart of an exceptional natural setting?\r\nRetro Camping invites you to La Chanterelle campsite, in Champagnac-le-Vieux (43), to share a convivial moment in good spirits"
    ],
    "it": [
      "Volete trascorrere un fine settimana senza tempo nel cuore di una natura eccezionale?\r\nRetro Camping vi invita al campeggio La Chanterelle, a Champagnac-le-Vieux (43), per un weekend all'insegna del divertimento"
    ],
    "fr": [
      "Envie de vivre un week-end hors du temps, au cœur d’un cadre naturel exceptionnel ?\r\nLe Retro Camping vous donne rendez-vous au camping La Chanterelle, à Champagnac-le-Vieux (43), pour partager un moment convivial placé sous le signe de la bonne humeur"
    ],
    "es": [
      "¿Desea pasar un fin de semana intemporal en el corazón de un entorno natural excepcional?\r\nRetro Camping le invita al camping La Chanterelle, en Champagnac-le-Vieux (43), para pasar un fin de semana lleno de diversión"
    ],
    "nl": [
      "Wilt u een tijdloos weekend doorbrengen in het hart van een uitzonderlijke natuurlijke omgeving?\r\nRetro Camping nodigt u uit op camping La Chanterelle, in Champagnac-le-Vieux (43), voor een weekend vol plezier"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Rétro-Camping"
    ]
  },
