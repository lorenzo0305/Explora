  "rdfs:comment": {
    "de": [
      "Maison Soler ist ein handwerkliches Atelier im Herzen Frankreichs, das sich auf die Herstellung und Verarbeitung von 100% französischem Straußenleder spezialisiert hat. Ein Know-how, das Tradition und Innovation für außergewöhnliche Materialien für Luxusgüter vereint."
    ],
    "en": [
      "Maison Soler is an artisan workshop located in the heart of France, specialized in the manufacture and processing of 100% French ostrich leathers. Our expertise combines tradition and innovation to produce exceptional materials for the luxury market."
    ],
    "it": [
      "La Maison Soler è un laboratorio artigianale nel cuore della Francia, specializzato nella produzione e lavorazione di pelle di struzzo 100% francese. La nostra esperienza combina tradizione e innovazione per produrre materiali eccezionali per il mercato del lusso."
    ],
    "fr": [
      "Maison Soler est un atelier artisanal situé au cœur de la France, spécialisé dans la fabrication et le traitement de cuirs d’autruche 100% français. Un savoir-faire qui allie tradition et innovation pour des matériaux d’exception destinés au luxe."
    ],
    "nl": [
      "Maison Soler is een ambachtelijke werkplaats in het hart van Frankrijk, gespecialiseerd in de productie en verwerking van 100% Frans struisvogelleer. Onze expertise combineert traditie en innovatie om uitzonderlijke materialen te produceren voor de luxemarkt."
    ],
    "es": [
      "Maison Soler es un taller artesanal situado en el corazón de Francia, especializado en la fabricación y transformación de piel de avestruz 100% francesa. Nuestro saber hacer combina tradición e innovación para producir materiales excepcionales destinados al mercado del lujo."
    ]
  },
  "rdfs:label": {
    "en": [
      "Maison Soler - Tannery & Parchment-making"
    ],
    "fr": [
      "Maison Soler - Tannerie & Parcheminerie"
    ]
  },
