  "rdfs:comment": {
    "de": [
      "Der Vélorail des Fades ist ein 7,5 km (15 A/R) langer bummel. Abstieg, bei dem Sie das Vergnügen haben, 3 Tunnel zu durchqueren, dann haben Sie das Privileg, das Viadukt zu erreichen und die herrlichen Landschaften und den Lago Fades aus einer einzigen Perspektive zu bewundern."
    ],
    "en": [
      "The Vélorail des Fades is a 7 km (14 A/R) stroll during which you will have the pleasure of crossing 3 tunnels then you will have the privilege of accessing the viaduct and admiring the magnificent landscapes and Lake Fades from a point single view."
    ],
    "it": [
      "La Vélorail des Fades è un viaggio di 7 km (14 corse di andata e ritorno) durante il quale avrete il piacere di attraversare 3 tunnel, per poi avere il privilegio di accedere al viadotto e ammirare il magnifico scenario e il Lac des Fades da un punto di vista unico."
    ],
    "fr": [
      "Le Vélorail des Fades c'est une balade de 7 km (14 A/R) pendant laquelle vous aurez le plaisir de traverser 3 tunnels puis vous aurez le privilège d'accéder au viaduc et d'admirer les magnifiques paysages et le lac des Fades d'un point de vue unique."
    ],
    "es": [
      "El Vélorail des Fades es un recorrido de 7 km (14 viajes de ida y vuelta) durante el cual tendrá el placer de atravesar 3 túneles, después tendrá el privilegio de acceder al viaducto y admirar el magnífico paisaje y el Lac des Fades desde un mirador único."
    ],
    "nl": [
      "De Vélorail des Fades is een rit van 7 km (14 retourritten) waarbij je het genoegen hebt om door 3 tunnels te rijden. Daarna heb je het voorrecht om het viaduct op te gaan en het prachtige landschap en het Lac des Fades te bewonderen vanaf een uniek uitkijkpunt."
    ]
  },
  "rdfs:label": {
    "de": [
      "Elektrische Velorail von Fades"
    ],
    "en": [
      "Fades Electric Velorail"
    ],
    "fr": [
      "Vélorail Électrique des Fades"
    ]
  },
