  "rdfs:comment": {
    "de": [
      "Ein landwirtschaftliches Kollektiv bietet Ihnen an, Sie von April bis November zu empfangen, um das Leben auf den Feldern in dieser schönen grünen Umgebung zu teilen."
    ],
    "en": [
      "From April to November, an agricultural collective welcomes you to share the life of the fields in this beautiful green setting."
    ],
    "it": [
      "Da aprile a novembre, un gruppo di agricoltori vi accoglie per condividere la vita dei campi in questa splendida cornice verde."
    ],
    "fr": [
      "Un collectif agricole vous propose de vous accueillir d'Avril à Novembre pour partager la vie des champs dans ce bel écrin de verdure."
    ],
    "nl": [
      "Van april tot november verwelkomt een groep boeren je om het leven op de velden te delen in deze prachtige groene omgeving."
    ],
    "es": [
      "De abril a noviembre, un grupo de agricultores le da la bienvenida para compartir la vida de los campos en este hermoso entorno verde."
    ]
  },
  "rdfs:label": {
