  "rdfs:comment": {
    "de": [
      "Ein herzlicher Empfang, eine freundliche Atmosphäre in einer typischen Umgebung. Kochen von frischen und saisonalen Produkten von lokalen Produzenten."
    ],
    "en": [
      "A warm welcome, a friendly atmosphere in a typical setting. Cooking of fresh and seasonal products from local producers."
    ],
    "it": [
      "Un'accoglienza calorosa, un'atmosfera amichevole in un ambiente tipico. Cucina stagionale con prodotti freschi provenienti da produttori locali."
    ],
    "fr": [
      "Un accueil chaleureux, une ambiance conviviale dans un cadre typique. Cuisine de saison avec des produits frais issus de producteurs locaux."
    ],
    "es": [
      "Una cálida bienvenida, un ambiente agradable en un entorno típico. Cocina de temporada con productos frescos de los productores locales."
    ],
    "nl": [
      "Een warm welkom, een vriendelijke sfeer in een typisch kader. Seizoensgebonden keuken met verse producten van lokale producenten."
    ]
  },
