  "rdfs:comment": {
    "de": [
      "Krebsfischen für die ganze Familie mit einem Führer! Lernen Sie, die Arten zu erkennen, fangen Sie den Signalkrebs ? zu beseitigender Schädling ? und probieren Sie ihn anschließend. Lehrreich, spielerisch und gesellig!"
    ],
    "en": [
      "Family crayfish fishing with a guide! Learn to recognize the species, catch the signal crayfish - a pest to be eliminated - and then taste it. Instructive, fun and friendly!"
    ],
    "it": [
      "Pesca del gambero di fiume con la famiglia e una guida! Imparate a riconoscere la specie, a catturare il gambero di fiume - un fastidio che deve essere debellato - e poi assaggiatelo. Educativo, divertente e amichevole!"
    ],
    "fr": [
      "Pêche aux écrevisses en famille avec un guide ! Apprenez à reconnaître les espèces, capturez l'écrevisse signal — nuisible à éliminer — et dégustez-la ensuite. Instructif, ludique et convivial !"
    ],
    "es": [
      "¡Pesca del cangrejo de río con tu familia y un guía! Aprenda a reconocer las especies, capture el cangrejo señal -una molestia que hay que erradicar- y después pruébelo. Educativo, divertido y agradable"
    ],
    "nl": [
      "Kreeften vissen met je familie en een gids! Leer de soorten herkennen, vang de signaalkreeft - een overlast die uitgeroeid moet worden - en proef ze vervolgens. Educatief, leuk en gezellig!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Pêche des écrevisses sur la Bouble"
    ]
  },
