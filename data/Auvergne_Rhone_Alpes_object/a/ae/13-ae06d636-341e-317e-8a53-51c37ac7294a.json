  "rdfs:comment": {
    "de": [
      "Aerokix Paragliding bietet während der gesamten Wintersaison Flüge von Val Thorens und Les Menuires aus an.\r\n\r\nWeitere Informationen und Preise auf der Website des Anbieters."
    ],
    "en": [
      "Aerokix Parapente offers flights from Val Thorens and Les Menuires throughout the winter season.\r\n\r\nMore information and prices on the service provider's website."
    ],
    "it": [
      "Aerokix Parapente offre voli da Val Thorens e Les Menuires per tutta la stagione invernale.\r\n\r\nMaggiori informazioni e prezzi sul sito web del fornitore del servizio."
    ],
    "fr": [
      "Aerokix Parapente propose des vols au départ de Val Thorens et des Menuires tout au long de la saison d'hiver.\r\n\r\nPlus d'informations et tarifs sur le site du prestataire."
    ],
    "es": [
      "Aerokix Parapente ofrece vuelos desde Val Thorens y Les Menuires durante toda la temporada de invierno.\r\n\r\nMás información y precios en la web del proveedor de servicios."
    ],
    "nl": [
