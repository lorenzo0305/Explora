  "rdfs:comment": {
    "de": [
      "Produzenten von traditionellem und japanischem Gemüse (Kabocha-Kürbis, Edamame-Soja, Shiso). Gemeinsamer Verkauf mit anderen lokalen Produzenten (Bio-Eier, Brot, Honig, Ziegenkäse, Geflügel, Bier usw.) jeden letzten Dienstag im Monat."
    ],
    "en": [
      "Producer of traditional and Japanese vegetables (kabocha squash, edamame beans, shiso). Vegetable boxes for sale at the farm.\r\nStarted in 2017, we grow our products according to permaculture inspired principles."
    ],
    "it": [
      "Produttori di verdure tradizionali e giapponesi (zucca kabocha, soia edamame, shiso). Vendita congiunta con altri produttori locali (uova biologiche, pane, miele, formaggio di capra, pollame, birra, ecc.) ogni ultimo martedì del mese."
    ],
    "fr": [
      "Producteurs de légumes traditionnels et japonais (courges kabocha, soja édamame, shiso). Vente conjointe avec d’autres producteurs locaux (œufs bio, pain, miel, fromages de chèvre, volailles, bière…) tous les derniers mardis du mois."
    ],
    "es": [
      "Productores de verduras tradicionales y japonesas (calabaza kabocha, soja edamame, shiso). Venta conjunta con otros productores locales (huevos ecológicos, pan, miel, queso de cabra, aves de corral, cerveza, etc.) todos los últimos martes de mes."
    ],
    "nl": [
      "Producenten van traditionele en Japanse groenten (kabocha pompoen, edamame soja, shiso). Gezamenlijke verkoop met andere lokale producenten (biologische eieren, brood, honing, geitenkaas, gevogelte, bier, etc.) elke laatste dinsdag van de maand."
    ]
  },
  "rdfs:label": {
