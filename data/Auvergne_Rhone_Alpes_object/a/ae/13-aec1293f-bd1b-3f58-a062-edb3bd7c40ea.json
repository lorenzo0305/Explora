  "rdfs:comment": {
    "de": [
      "Restaurant-Bar inmitten der Almen von Le Cernix. Sonnenterrasse mit außergewöhnlichem Panorama. Küche mit saisonalen Produkten. Gemütliche und authentische Atmosphäre. Nutzen Sie die Gelegenheit und streicheln Sie die Esel des Anwesens, Abwechslung garantiert!"
    ],
    "en": [
      "Restaurant bar in the middle of the Cernix mountain pastures. Sunny terrace with exceptional panorama. Cuisine with seasonal produce. Cozy and authentic atmosphere. Take the opportunity to come and pet the donkeys on the estate, a change of scenery guaranteed!"
    ],
    "it": [
      "Ristorante e bar in mezzo agli alpeggi di Cernix. Terrazza soleggiata con vista eccezionale. Cucina stagionale. Atmosfera accogliente e autentica. Cogliete l'occasione di venire ad accarezzare gli asini della tenuta, un cambiamento di scenario garantito!"
    ],
    "fr": [
      "Restaurant bar au milieu des alpages du Cernix. Terrasse ensoleillée avec panorama exceptionnel. Cuisine avec produit de saison. Ambiance cosy et authentique. Profitez-en pour venir caresser les ânes du domaine, Dépaysement garanti !"
    ],
    "es": [
      "Restaurante y bar en medio de los pastos de la montaña de Cernix. Terraza soleada con vistas excepcionales. Cocina de temporada. Ambiente acogedor y auténtico. Aproveche para venir a acariciar a los burros de la finca, ¡un cambio de aires garantizado!"
    ],
    "nl": [
      "Restaurant en bar midden op de alpenweiden van Cernix. Zonnig terras met uitzonderlijk uitzicht. Seizoensgebonden keuken. Gezellige, authentieke sfeer. Maak van de gelegenheid gebruik om de ezels op het landgoed te komen aaien, een verandering van omgeving gegarandeerd!"
    ]
  },
  "rdfs:label": {
    "en": [
      "La Tête de Mule"
    ],
    "fr": [
      "La Tête de Mule"
    ]
  },
