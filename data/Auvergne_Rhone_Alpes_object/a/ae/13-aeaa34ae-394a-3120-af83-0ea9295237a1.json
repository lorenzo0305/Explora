  "rdfs:comment": {
    "de": [
      "Nachdem er 2021 als Chefkoch der Pariser Oper Garnier mit dem Goldenen Gault und Millau ausgezeichnet worden war, stellte Yann Tanneau (ausgebildet bei Ducasse, Alain Senderens und Jérôme Banctel) vor zwei Jahren in dem Dorf L'Albenc seine Töpfe auf den Tisch."
    ],
    "en": [
      "After being awarded the Gault et Millau d'Or in 2021 when he was chef at the Opéra Garnier in Paris, it is in the village of l'Albenc that Yann Tanneau (trained at Ducasse, Alain Senderens and Jérôme Banctel) put down his pans two years ago."
    ],
    "it": [
      "Dopo aver ricevuto il Gault et Millau d'Or nel 2021 quando era chef dell'Opéra Garnier di Parigi, è nel villaggio di l'Albenc che Yann Tanneau (formatosi presso Ducasse, Alain Senderens e Jérôme Banctel) ha posato le sue padelle due anni fa."
    ],
    "fr": [
      "Après avoir été récompensé du Gault et Millau d'Or en 2021 lorsqu'il été chef à l'Opéra Garnier à Paris, c'est dans le village de l'Albenc, que Yann Tanneau (formé chez Ducasse, Alain Senderens et Jérôme Banctel) a posé ses casseroles il y a deux ans."
    ],
    "nl": [
      "Nadat hij in 2021 de Gault et Millau d'Or ontving toen hij chef-kok was bij de Opéra Garnier in Parijs, was het in het dorp l'Albenc dat Yann Tanneau (opgeleid bij Ducasse, Alain Senderens en Jérôme Banctel) twee jaar geleden zijn pannen neerzette."
    ],
    "es": [
      "Después de haber sido galardonado con el Gault et Millau d'Or en 2021 cuando era chef de la Ópera Garnier de París, fue en el pueblo de l'Albenc donde Yann Tanneau (formado en Ducasse, Alain Senderens y Jérôme Banctel) dejó sus sartenes hace dos años."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Bistrot Louise"
    ]
  },
