  "rdfs:comment": {
    "de": [
      "Wagen Sie sich an die Ukulele! Offen für alle Personen (ab 12 Jahren), die das Instrument entdecken und ihre musikalischen Aktivitäten bereichern möchten. Stufe 2 - begrenzte Plätze"
    ],
    "en": [
      "Dare to play Ukulele! Open to anyone (aged 12 and over) wishing to discover the instrument and enrich their musical activities. Level 2 - limited places"
    ],
    "it": [
      "Osate suonare l'Ukulele! Aperto a chiunque (a partire dai 12 anni) desideri scoprire lo strumento e migliorare le proprie attività musicali. Livello 2 - posti limitati"
    ],
    "fr": [
      "Osez le Ukulélé ! Ouvert à toute personne (dès 12 ans) souhaitant découvrir l'instrument et enrichir ses activités musicales. Niveau 2 - places limitées"
    ],
    "es": [
      "¡Atrévete a tocar el Ukelele! Abierto a cualquier persona (a partir de 12 años) que desee descubrir el instrumento y mejorar sus actividades musicales. Nivel 2 - plazas limitadas"
    ],
    "nl": [
      "Durf de Ukulele te bespelen! Open voor iedereen (vanaf 12 jaar) die het instrument wil ontdekken en zijn muzikale activiteiten wil uitbreiden. Niveau 2 - beperkt aantal plaatsen"
    ]
  },
  "rdfs:label": {
    "fr": [
