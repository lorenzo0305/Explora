  "rdfs:comment": {
    "de": [
      "Verkauf, Werkstatt und Töpferwerkstatt für alle offen (mögliche Familienaktivität): Arbeits columbine, um die Platte, Modellierung, schießen ... Die Oberfläche des Objekts in der Szene: Slips, judoxydes, Stiche, Schnitte oder Modellierung wird geschlossen Arbeit."
    ],
    "en": [
      "Sale and pottery workshop open to all. You will be taught many different techniques to create your object and to decorate it."
    ],
    "it": [
      "Lavoro con pellet, lastre, modellazione e lancio.\r\nI miei pezzi in gres e terracotta sono unici."
    ],
    "fr": [
      "Je travaille au colombin, à la plaque, en modelage et tournage.\r\nMes pièces en grès et en faïences sont uniques."
    ],
    "nl": [
      "Verkoop, Workshop en pottenbakkerij open voor alle (mogelijke familie-activiteit): Werk akelei, op de plaat, modellering, schieten ... De afwerking van het object in de scène: slips, judoxydes, gravures, etsen en modellering zal sluiten werk."
    ],
    "es": [
      "Trabajo con bolitas, losas, modelado y vaciado.\r\nMis piezas de gres y loza son únicas."
    ]
  },
