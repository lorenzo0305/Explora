  "rdfs:comment": {
    "de": [
      "Färsenfleisch, Kalbfleisch, Lammfleisch, Schweinefleisch, Geflügelfleisch\r\nSpezialitäten: Altmodische Wachteln\r\n\r\nFleisch aus der Region\r\nAlle unsere Fleischsorten auf dem Marktstand stammen von den umliegenden Bauernhöfen."
    ],
    "en": [
      "Genoa, veal, lamb, pork, poultry\r\nSpecialities: Old-fashioned Caillettes\r\n\r\nCountry Meat\r\nAll of our meat on display comes from the surrounding farms."
    ],
    "it": [
      "Giovenca, vitello, agnello, maiale, pollame\r\nSpecialità: Quillettes all'antica\r\n\r\nCarne locale\r\nTutte le nostre carni esposte provengono dalle fattorie circostanti."
    ],
    "fr": [
      "Genisse, veau, agneau, porc, volaille\r\nSpécialités : Caillettes à l'ancienne\r\n\r\nViande de Pays\r\nToutes nos viandes à l'étal proviennent des fermes environnantes."
    ],
    "nl": [
      "Vaars, kalfsvlees, lam, varkensvlees, gevogelte\r\nSpecialiteiten: Ouderwetse quaillettes\r\n\r\nLokaal vlees\r\nAl ons tentoongestelde vlees komt van de omliggende boerderijen."
    ],
    "es": [
      "Ternera, cordero, cerdo, aves de corral\r\nEspecialidades: Codornices a la antigua usanza\r\n\r\nCarne local\r\nTodas nuestras carnes expuestas proceden de las granjas de los alrededores."
    ]
  },
  "rdfs:label": {
    "fr": [
