  "rdfs:comment": {
    "de": [
      "SoGo Loisirs Hochseilgarten und Getränke- und Snackbereich am Plan d'eau des Ozières in Yzeure.\r\n\r\nReservierung wird dringend empfohlen. Vorzugsweise am Morgen, wenn der Park am wenigsten besucht ist."
    ],
    "en": [
      "SoGo Loisirs Accrobranche and drinks-snacking area at the Ozières lake in Yzeure.\r\n\r\nReservations strongly recommended. Preferably in the mornings when the park is least busy."
    ],
    "it": [
      "SoGo Loisirs Accrobranche e area di ristoro presso il lago di Ozières a Yzeure.\r\n\r\nSi consiglia vivamente la prenotazione. Preferibilmente al mattino, quando il parco è meno frequentato."
    ],
    "fr": [
      "SoGo Loisirs Accrobranche et espace boisson-snacking au plan d’eau des Ozières à Yzeure.\r\n\r\nRéservation fortement conseillée. Privilégier le matin où l’affluence du parc est la plus faible."
    ],
    "es": [
      "SoGo Loisirs Accrobranche y zona de aperitivos en el lago de Ozières, en Yzeure.\r\n\r\nSe recomienda reservar. Preferiblemente por las mañanas, cuando el parque está menos concurrido."
    ],
    "nl": [
      "SoGo Loisirs Accrobranche en drinks-snacking area bij het meer van Ozières in Yzeure.\r\n\r\nReserveren wordt sterk aangeraden. Bij voorkeur 's ochtends wanneer het park het minst druk is."
    ]
  },
  "rdfs:label": {
