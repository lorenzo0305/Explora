  "rdfs:comment": {
    "de": [
      "Lust auf ein kreatives Erlebnis? Tauchen Sie ein in die elegante, poetische und fantasievolle Welt und gestalten Sie ein Blumenarrangement mit der kreativen Floristin Madame Defranoux."
    ],
    "en": [
      "Looking for a creative experience? Immerse yourself in the elegant, poetic and whimsical world of Madame Defranoux's creative florist."
    ],
    "it": [
      "Siete alla ricerca di un'esperienza creativa? Immergetevi in un mondo elegante, poetico e stravagante creando una composizione floreale con la fiorista creativa Madame Defranoux."
    ],
    "fr": [
      "Envie d'une expérience créative ? Plongez dans l'univers élégant, poétique et fantaisiste en réalisant une composition florale avec la fleuriste créatrice Madame Defranoux."
    ],
    "es": [
