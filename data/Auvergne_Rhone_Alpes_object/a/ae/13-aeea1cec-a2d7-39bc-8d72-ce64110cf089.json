  "rdfs:comment": {
    "de": [
      "DIe Domaine du Colombier ist eine Oase des Friedens in einem eschichtsträchtigen Ort der Drôme Provençale."
    ],
    "en": [
      "Le Domaine du Colombier, a haven of peace teeming with history in Drôme Provençale."
    ],
    "it": [
      "Nel cuore di un parco di 4 ettari a Malataverne, l'Hôtel du Domaine du Colombier a 5 stelle offre 21 camere e 4 suite, una piscina riscaldata, un'area benessere e due ristoranti, per un soggiorno che unisce comfort, natura e gastronomia."
    ],
    "fr": [
      "Au cœur d’un parc de 4 hectares à Malataverne, l’Hôtel 5 étoiles du Domaine du Colombier propose 21 chambres et 4 suites, une piscine chauffée, un espace bien-être et deux restaurants, pour un séjour alliant confort, nature et gastronomie."
    ],
    "nl": [
      "Het Domaine du Colombier is een oase van rust op een plaats rijk aan eschiedenis in de Drôme Provençale."
    ],
    "es": [
      "En el corazón de un parque de 4 hectáreas en Malataverne, el Hôtel du Domaine du Colombier de 5 estrellas ofrece 21 habitaciones y 4 suites, una piscina climatizada, un espacio de bienestar y dos restaurantes, para una estancia que combina confort, naturaleza y gastronomía."
    ]
  },
