  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/a33518ea-b0dd-37e1-9bb6-b84f6e0f60ee",
      "dc:description": {
        "de": [
          "Am Elterntag stehen Aktivitäten und Informationsstände für Familien auf dem Programm\n\nDie Veranstaltung wird vom soziokulturellen Zentrum Audrey Bartier, der Kindertagesstätte Nougatine und dem Relais Petite Enfance von Wimereux organisiert."
        ],
        "en": [
          "Parenting Day: activities and information stands for families\n\nA time for sharing, organized by the Audrey Bartier sociocultural center, the Nougatine multi-accueil and the Relais Petite Enfance de Wimereux."
        ],
        "it": [
          "Giornata della genitorialità: attività e stand informativi per le famiglie\n\nUn momento di condivisione, organizzato dal centro sociale e culturale Audrey Bartier, dal centro multi-accoglienza Nougatine e dal Centro di collegamento per la prima infanzia di Wimereux."
        ],
        "fr": [
          "Au programme de la journée de la parentalité: activités et stands d'informations pour les familles\n\nUn temps de partage organisé par le centre socioculturel Audrey Bartier, le multi-accueil Nougatine et le Relais Petite Enfance de Wimereux."
        ],
        "nl": [
          "Dag van het ouderschap: activiteiten en informatiestands voor gezinnen\n\nEen moment om te delen, georganiseerd door het sociaal en cultureel centrum Audrey Bartier, het multi-accueilcentrum Nougatine en het kinderdagverblijf Wimereux."
        ],
        "es": [
          "Día de la Crianza: actividades y stands informativos para las familias\n\nUn momento para compartir, organizado por el centro social y cultural Audrey Bartier, el centro multi-accueil de Nougatine y el Centro de Relevo para la Primera Infancia de Wimereux."
        ]
      },
