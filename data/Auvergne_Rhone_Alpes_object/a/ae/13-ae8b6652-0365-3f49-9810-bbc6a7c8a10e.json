  "rdfs:comment": {
    "de": [
      "Ich habe mich im Mars-Tal, in Saint-Vincent-de-Salers, niedergelassen und entwickle ein zeitgenössisches, verwurzeltes Design: ein Zusammentreffen von Kunsttischlerei-Know-how und Innovation."
    ],
    "en": [
      "Based in the Mars valley, in Saint-Vincent-de-Salers, I'm developing a contemporary, rooted design: an encounter between cabinetmaking know-how and innovation."
    ],
    "it": [
      "Con sede nella Valle di Marte, a Saint-Vincent-de-Salers, sviluppo un design contemporaneo con radici profonde: un incontro di competenze ebanistiche e innovazione."
    ],
    "fr": [
      "Installé dans la vallée du Mars, à Saint-Vincent-de-Salers, je développe un design contemporain enraciné : une rencontre entre les savoir-faire d’ébénisterie et l’innovation."
    ],
    "es": [
      "Instalado en el valle de Marte, en Saint-Vincent-de-Salers, desarrollo un diseño contemporáneo con raíces profundas: un encuentro de saber hacer ebanista e innovación."
    ],
    "nl": [
      "Gevestigd in de Marsvallei, in Saint-Vincent-de-Salers, ontwikkel ik een hedendaags ontwerp met diepe wortels: een ontmoeting van meubelmakersvaardigheden en innovatie."
    ]
  },
  "rdfs:label": {
