  "rdfs:comment": {
    "de": [
      "TRAITEUR\r\nRESTAURANT\r\nCONSERVERIE rund um seine Majestät die Gans\r\n\r\nUnser Geschäft ist von Montag bis Samstag geöffnet und bietet alle unsere Spezialitäten rund um die Gans an (Gänseleber, Rillettes, Cassoulets...)."
    ],
    "en": [
      "CATERER\r\nRESTAURANT\r\nCONSERVERY around His Majesty the Goose\r\n\r\nOur store, open Monday to Saturday, offers all our goose specialities (Goose foie gras, Rillettes, Cassoulets...)."
    ],
    "it": [
      "CATERINGOIO\r\nRISTORANTE\r\nCONSERVAZIONE intorno a Sua Maestà l'Oca\r\n\r\nIl nostro negozio, aperto dal lunedì al sabato, offre tutte le nostre specialità a base di oca (foie gras d'oca, Rillettes, Cassoulets, ecc.)"
    ],
    "fr": [
      "TRAITEUR \r\nRESTAURANT\r\nCONSERVERIE autour de sa Majesté l'Oie \r\n\r\nNotre boutique, ouverte du lundi au samedi, propose toutes nos spécialités autour de l'Oie (Foie gras d'Oie, Rillettes, Cassoulets...)"
    ],
    "es": [
      "CATER\r\nRESTAURANTE\r\nCONSERVERÍA en torno a su Majestad la Oca\r\n\r\nNuestra tienda, abierta de lunes a sábado, ofrece todas nuestras especialidades de oca (Foie gras de oca, Rillettes, Cassoulets, etc.)"
    ],
    "nl": [
      "CATERER\r\nRESTAURANT\r\nCONSERVERIE rond zijne majesteit de gans\r\n\r\nOnze winkel, open van maandag tot zaterdag, biedt al onze ganzenspecialiteiten (Ganzenlever, Rillettes, Cassoulets, enz.)."
    ]
  },
