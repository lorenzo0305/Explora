  "rdfs:comment": {
    "de": [
      "Brücken verbinden über das Trennende hinweg. Der gute Geist von Marc Seguin (1786-1875) und seine kühnen \"Drahtbrücken\", die zwischen 1823 und 1849 über die Rhône gespannt wurden, haben unsere Region ganz besonders geprägt."
    ],
    "en": [
      "Bridges bridge the divide. The fine spirit of Marc Seguin (1786-1875) and his audacious \"wire bridges\" across the Rhône between 1823 and 1849, left a particular mark on our region."
    ],
    "it": [
      "I ponti colmano il divario. Lo spirito fine di Marc Seguin (1786-1875) e i suoi audaci \"ponti di ferro\" costruiti attraverso il Rodano tra il 1823 e il 1849 hanno lasciato un segno particolare nella nostra regione."
    ],
    "fr": [
      "Les ponts relient par-dessus ce qui sépare. Le bel esprit de Marc Seguin (1786-1875) et ses audacieux « ponts en fil-de-fer » lancés par-dessus le Rhône entre 1823 et 1849, a tout spécialement marqué notre région."
    ],
    "es": [
      "Los puentes tienden puentes. El espíritu de Marc Seguin (1786-1875) y sus audaces \"puentes de alambre de hierro\" construidos sobre el Ródano entre 1823 y 1849 dejaron una huella especial en nuestra región."
    ],
    "nl": [
      "Bruggen overbruggen de kloof. De goede geest van Marc Seguin (1786-1875) en zijn gewaagde \"ijzerdraadbruggen\" die hij tussen 1823 en 1849 over de Rhône bouwde, hebben een bijzonder stempel op onze regio gedrukt."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Activité : D'une rive à l'autre du Rhône : histoire des ponts"
    ]
  },
