  "rdfs:comment": {
    "de": [
      "Die Brasserie des 2 terrasses bietet eine traditionelle Küche mit frischen und hausgemachten Produkten.\r\nGenießen Sie auf der Terrasse Ihre Afterworks mit einem Aperitifbrett mit Wurst und Käse oder Themenabende an Samstagabenden."
    ],
    "en": [
      "La Brasserie des 2 terrasses offers traditional cuisine with fresh, homemade products.\r\nCome and enjoy the terrace for afterworks with a charcuterie and cheese aperitif, or themed evenings on Saturday nights."
    ],
    "it": [
      "La Brasserie des 2 terrasses propone una cucina tradizionale con ingredienti freschi e fatti in casa.\r\nApprofittate della terrazza per un drink dopo il lavoro, con un aperitivo a base di salumi e formaggi, o per serate a tema il sabato sera."
    ],
    "fr": [
      "La Brasserie des 2 terrasses propose une cuisine traditionnelle avec des produits frais et du fait maison.\r\nVenez profitez de la terrasse pour vos afterworks avec une planche apéro de charcuteries et fromages, ou des soirées à thèmes les samedis soirs."
    ],
    "es": [
      "La Brasserie des 2 terrasses sirve cocina tradicional con ingredientes frescos y caseros.\r\nAproveche la terraza para tomar una copa después del trabajo, con una tabla de aperitivos a base de embutidos y quesos, o para las veladas temáticas de los sábados por la noche."
    ],
    "nl": [
      "De Brasserie des 2 terrasses serveert traditionele gerechten met verse, huisgemaakte ingrediënten.\r\nKom en geniet van het terras voor een drankje na het werk, met een aperitiefplankje met vleeswaren en kazen, of thema-avonden op zaterdagavond."
    ]
  },
  "rdfs:label": {
