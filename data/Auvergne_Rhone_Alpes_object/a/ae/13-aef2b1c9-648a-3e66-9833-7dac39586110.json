  "rdfs:comment": {
    "de": [
      "Nehmen Sie anlässlich des Säulenfestes an den Veranstaltungen im Park des Espace 3 lacs und auf der Esplanade des Sees teil.\r\nBauern- und Handwerkermarkt, Fackelwanderung & Feuerwerk stehen auf dem Programm."
    ],
    "en": [
      "Join in the festivities in the Espace 3 lacs park and on the Esplanade du Lac.\r\nProducers' and craftsmen's market, torchlight walk & fireworks are on the program."
    ],
    "it": [
      "Partecipate ai festeggiamenti nel parco Espace 3 lacs e sull'Esplanade du Lac.\r\nIl programma prevede un mercato di produttori e artigiani, una fiaccolata e fuochi d'artificio."
    ],
    "fr": [
      "A l'occasion de la fête de la colonne, participez aux animations dans le parc de l'Espace 3 lacs et sur l'Esplanade du lac.\r\nMarché de producteurs et d'artisans, randonnée aux flambeaux & feu d'artifice sont prévus au programme."
    ],
    "es": [
      "Participe en los festejos en el parque Espace 3 lacs y en la Esplanade du lac.\r\nMercado de productores y artesanos, paseo de antorchas y fuegos artificiales."
    ],
    "nl": [
      "Neem deel aan de festiviteiten in het park Espace 3 lacs en op de Esplanade du lac.\r\nProducenten- en ambachtsmarkt, fakkeltocht en vuurwerk staan allemaal op het programma."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Fête de la Colonne"
    ]
  },
