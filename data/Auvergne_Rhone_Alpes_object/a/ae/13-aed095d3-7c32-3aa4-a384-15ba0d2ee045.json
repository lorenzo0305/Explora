  "rdfs:comment": {
    "de": [
      "Dieser Ort empfängt Praktikanten, die sich in die verschiedenen Techniken der bildenden und angewandten Künste einführen lassen oder diese perfektionieren möchten."
    ],
    "en": [
      "This facility welcomes trainees wishing to learn or improve their skills in various plastic and applied arts techniques."
    ],
    "it": [
      "Questo centro accoglie i tirocinanti che desiderano imparare o migliorare le proprie competenze in una serie di tecniche plastiche e di arti applicate."
    ],
    "fr": [
      "Ce lieu accueille des stagiaires désireux de s'initier, de se perfectionner aux différentes techniques des arts plastiques  et des arts appliqués."
    ],
    "es": [
      "Este centro acoge a los aprendices que desean aprender o perfeccionarse en una serie de técnicas de artes plásticas y aplicadas."
    ],
    "nl": [
      "Dit centrum verwelkomt stagiairs die hun vaardigheden in een reeks plastische en toegepaste kunsttechnieken willen leren of verbeteren."
    ]
