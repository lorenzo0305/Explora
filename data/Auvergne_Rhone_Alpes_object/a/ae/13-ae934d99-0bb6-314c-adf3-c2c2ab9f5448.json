  "rdfs:comment": {
    "de": [
      "Diese Piste wurde unterhalb des beheizten Sessellifts Vinouve angelegt. Sie ist leicht zugänglich und bietet Kindern die Möglichkeit, die Freuden des Skifahrens zu entdecken. Die Piste befindet sich auf einem Schneehügel, der mit Netzen gesichert ist."
    ],
    "en": [
      "Track below the Vinouve heated chairlift. Easy to access, it lets children discover the joys of sliding. The run is set on a snow mound secured by nets."
    ],
    "it": [
      "Una pista sotto la seggiovia riscaldata Vinouve. Di facile accesso, è un ottimo modo per far scoprire ai bambini le gioie degli sport sulla neve. La pista si trova su un cumulo di neve assicurato da reti."
    ],
    "fr": [
      "Piste aménagée en contrebas du télésiège chauffant Vinouve. Facile d'accès, elle permet de faire découvrir les joies de la glisse aux enfants. Cette piste est installée sur une butte de neige sécurisée par des filets."
    ],
    "es": [
      "Una pista situada debajo del telesilla climatizado de Vinouve. De fácil acceso, es ideal para que los niños se inicien en los deportes de nieve. La pista está situada sobre un montículo de nieve sujeto con redes."
    ],
    "nl": [
      "Een afdaling onder de verwarmde stoeltjeslift Vinouve. Gemakkelijk toegankelijk en een geweldige manier voor kinderen om de geneugten van de sneeuwsport te ontdekken. De piste ligt op een berg sneeuw die met netten is beveiligd."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Piste de luge"
    ]
  },
