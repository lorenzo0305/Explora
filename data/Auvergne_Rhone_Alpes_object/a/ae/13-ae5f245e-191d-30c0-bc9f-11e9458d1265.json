  "rdfs:comment": {
    "de": [
      "Parapente Airlines bietet Ihnen Gleitschirmtaufen über den Almen und dem Dorf Albiez und auf Anfrage überall in der Maurienne an. Perfektionierungskurse sind möglich."
    ],
    "en": [
      "Parapente Airlines offers paragliding flights over the Alps and the village of Albiez, and all over the Maurienne on request. Advanced training available."
    ],
    "it": [
      "Parapente Airlines offre primi voli in parapendio sui pascoli di montagna e sul villaggio di Albiez e, su richiesta, in tutta la Maurienne. Sono disponibili corsi avanzati."
    ],
    "fr": [
      "Parapente Airlines vous propose des baptêmes en parapente au dessus des alpages et du village d'Albiez et partout en Maurienne sur demande. Stage de perfectionnement possible."
    ],
    "es": [
      "Parapente Airlines ofrece primeros vuelos en parapente sobre los pastos de montaña y el pueblo de Albiez y en cualquier lugar de la Maurienne bajo petición. Cursos avanzados disponibles."
    ],
    "nl": [
      "Parapente Airlines biedt eerste vluchten in een parapente boven de bergweiden en het dorp Albiez en overal in de Maurienne op aanvraag. Cursussen voor gevorderden beschikbaar."
    ]
  },
