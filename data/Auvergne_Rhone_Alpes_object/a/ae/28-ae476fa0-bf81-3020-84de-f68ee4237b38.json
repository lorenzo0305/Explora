  "rdfs:comment": {
    "de": [
      "Emmanuel COUSIN hat 2018 seinen Familienbetrieb in Villeneuve Saint-Germain, vor den Toren von Soissons, gegründet.\nDer Imker wandert mit seinen Bienenvölkern und produziert 6 Honigsorten: Luzerne, Akazie, Kastanie, Wald, Blumen und Linde.\nNicht zu vergessen die Süßigkeiten: Nougat, Lolli, Lebkuchen?\n\nFinden Sie die verschiedenen Honigsorten in den Geschäften des Fremdenverkehrsamtes Soissonnais Valois."
    ],
    "en": [
      "In 2018, Emmanuel COUSIN set up his family business in Villeneuve Saint-Germain, just outside Soissons.\nThis beekeeper transhumances his bee colonies and produces 6 varieties of honey: Alfalfa, Acacia, Chestnut, Forest, Flower and Lime.\nNot forgetting the sweet treats: nougat, lollipops, gingerbread?\n\nFind the different varieties of honey in the Soissonnais Valois Tourist Office stores."
    ],
    "it": [
      "Emmanuel COUSIN ha avviato la sua azienda familiare a Villeneuve Saint-Germain, alle porte di Soissons, nel 2018.\nQuesto apicoltore porta le sue colonie di api in transumanza e produce 6 varietà di miele: Erba medica, Acacia, Castagno, Foresta, Fiore e Tiglio.\nSenza dimenticare i dolci: torrone, lecca-lecca, pan di zenzero?\n\nPotete trovare le diverse varietà di miele nei negozi dell'Ufficio del Turismo del Soissonnais Valois."
    ],
    "fr": [
      "C’est en 2018 que Emmanuel COUSIN a installé son entreprise familiale à Villeneuve Saint-Germain, aux portes de Soissons.\nCet apiculteur réalise la transhumance de ses colonies d’abeilles et produit 6 variétés de miels : Luzerne, Acacia, Châtaignier, Forêt, Fleurs et Tilleul.\nSans oublier les douceurs : nougat, sucette, pain d’épices …\n\nRetrouvez les différentes variétés de miel dans les boutiques de l'Office de tourisme Soissonnais Valois."
    ],
    "nl": [
      "Emmanuel COUSIN richtte in 2018 zijn familiebedrijf op in Villeneuve Saint-Germain, net buiten Soissons.\nDeze imker neemt zijn bijenkolonies mee op transhumance en produceert 6 soorten honing: Alfalfa, Acacia, Kastanje, Bos, Bloem en Linde.\nEn niet te vergeten de zoete lekkernijen: nougat, lolly's, peperkoek?\n\nJe kunt de verschillende honingsoorten vinden in de winkels van het Office du Tourisme Soissonnais Valois."
    ],
    "es": [
      "Emmanuel COUSIN creó su empresa familiar en Villeneuve Saint-Germain, a las afueras de Soissons, en 2018.\nEste apicultor lleva sus colonias de abejas en trashumancia y produce 6 variedades de miel: Alfalfa, Acacia, Castaño, Bosque, Flor y Tilo.\nSin olvidar los dulces: turrón, piruletas, pan de especias..\n\nEncontrará las distintas variedades de miel en las tiendas de la Oficina de Turismo de Soissonnais Valois."
    ]
  },
