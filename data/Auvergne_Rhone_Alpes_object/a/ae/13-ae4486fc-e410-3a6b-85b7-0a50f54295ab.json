  "rdfs:comment": {
    "de": [
      "Schöne kreative Küche im aktuellen Trend und mit sorgfältig ausgewählten Weinen. Ehemaliger Bauernhof aus dem 17. Jahrhundert, stilvolle Inneneinrichtung und angenehme Terrasse. 1 Stern im Michelin-Führer 2018."
    ],
    "en": [
      "This one Michelin-star (2017) restaurant boasts an imaginative style of fine cooking, featuring seasonal flavours and wines that are carefully selected. The 17th century farmhouse offers a charming interior with a lovely terrace."
    ],
    "it": [
      "Cucina creativa e attuale accompagnata da un'ottima carta dei vini. Vecchia fattoria del XVII secolo, arredamento di carattere e bella terrazza. Una stella Michelin 2017."
    ],
    "fr": [
      "Belle cuisine créative, au goût du jour et vins judicieusement sélectionnés. Vieille ferme du 17e siècle, intérieur de caractère et agréable terrasse."
    ],
    "nl": [
      "Mooie, creatieve en actuele gerechten en zorgvuldig geselecteerde wijnen. Oude boerderij uit de 17e eeuw, interieur met karakter en aangenaam terras."
    ],
    "es": [
      "Fabulosa cocina creativa, con gusto actual, aderezada con vinos cuidadosamente seleccionados. Antigua granja del siglo XVII con interiores robustos y terraza agradable. 1 estrella en la Guía Michelín 2017."
    ]
  },
