  "rdfs:comment": {
    "de": [
      "Ein Esskeller in Condat. Lehnen Sie sich an die Theke, bestellen Sie, teilen Sie und diskutieren Sie über die Schätze unserer Region, die sorgfältig ausgewählt wurden, um Ihren Gaumen zu verwöhnen!"
    ],
    "en": [
      "A dining cellar in Condat. Sit at the counter, order, share and discuss the treasures of our terroirs, carefully selected to delight your taste buds!"
    ],
    "it": [
      "Una cantina da mangiare a Condat. Sedetevi al bancone, ordinate, condividete e chiacchierate dei tesori dei nostri terroir, selezionati con cura per deliziare il vostro palato!"
    ],
    "fr": [
      "Une cave à manger à Condat. S’accouder au comptoir, commander, partager et discuter autour des trésors de nos terroirs, soigneusement sélectionnés pour ravir vos papilles !"
    ],
    "es": [
      "Una bodega para comer en Condat. Siéntese en el mostrador, pida, comparta y charle sobre los tesoros de nuestros terruños, cuidadosamente seleccionados para deleitar su paladar"
    ],
    "nl": [
      "Een kelder om te eten in Condat. Neem plaats aan de toonbank, bestel, deel en praat over de schatten van onze terroirs, zorgvuldig geselecteerd om je smaakpapillen te verwennen!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Burons & Bouchons - Cave à manger, Bistro de Pays, Epicerie fine, Caviste"
    ]
  },
