  "rdfs:comment": {
    "de": [
      "Louis empfängt Sie in seinem kleinen Paradies, in dem er das Drechseln von Holz praktiziert. Er liebt es, mithilfe seiner Drechselbank und seiner Schneidewerkzeuge Gegenstände aus Holz herzustellen."
    ],
    "en": [
      "Louis welcomes you to his little woodturning paradise. He loves to create wooden objects with his lathe and cutting tools."
    ],
    "it": [
      "Louis vi dà il benvenuto nel suo piccolo paradiso della tornitura del legno. Ama creare oggetti in legno utilizzando il suo tornio e i suoi utensili da taglio."
    ],
    "fr": [
      "Louis vous accueille dans son petit paradis où il pratique le tournage sur bois. Il aime créer des objets en bois grâce à son tour et à l'aide de ses outils de coupe."
    ],
    "es": [
      "Louis le da la bienvenida a su pequeño paraíso de la madera. Le encanta crear objetos de madera con su torno y sus herramientas de corte."
    ],
    "nl": [
      "Louis heet je welkom in zijn kleine houtdraaiparadijs. Hij houdt ervan houten voorwerpen te maken met zijn draaibank en snijgereedschap."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Inghilleri Louis"
    ]
  },
