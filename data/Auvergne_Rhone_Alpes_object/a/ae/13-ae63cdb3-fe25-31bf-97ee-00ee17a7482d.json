  "rdfs:comment": {
    "de": [
      "Die Mediathek Anna de Noailles bietet Ihnen eine Sammlung von Büchern, Zeitschriften und Hörbüchern. Vor Ort sind die Konsultation der Dokumente und die Suche nach Informationen kostenlos."
    ],
    "en": [
      "The Anna de Noailles media library offers you collections of books, magazines and magazines and audio books. On the spot, the consultation of documents and the information is free of charge."
    ],
    "it": [
      "La mediateca Anna de Noailles vi offre collezioni di libri, riviste e\r\nriviste e audiolibri. In loco, la consultazione dei documenti e la\r\ninformazioni sono gratuite."
    ],
    "fr": [
      "La médiathèque Anna de Noailles vous propose des collections de livres, de\r\nmagazines et de livres-audio. Sur place, la consultation des documents et la\r\nrecherche d’informations sont gratuites."
    ],
    "es": [
      "La mediateca Anna de Noailles le ofrece colecciones de libros, revistas y audiolibros. La consulta de documentos y la búsqueda de información son gratuitas."
    ],
    "nl": [
      "De mediatheek van Anna de Noailles biedt u collecties boeken, tijdschriften en luisterboeken. Ter plaatse zijn de raadpleging van documenten en het zoeken naar informatie gratis."
    ]
