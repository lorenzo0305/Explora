  "rdfs:comment": {
    "de": [
      "Rodeln 2000\r\nEin Maximum an Nervenkitzel auf einer Länge von 3 km!\r\nDie Rodelbahn 2000 bietet Ihnen zahlreiche Steilkurven, in denen sich schnelle Abschnitte mit reinem Gleiten abwechseln."
    ],
    "en": [
      "Luge 2000\r\nA maximum of thrills over a length of 3km!\r\nThe Luge 2000 offers you many challenging turns, alternating fast parts and pure skiing."
    ],
    "it": [
      "Slittino 2000\r\n3 km di brividi e di emozioni!\r\nLa pista per slittini 2000 è ricca di curve a gomito, che alternano tratti veloci a tratti di puro scivolamento."
    ],
    "fr": [
      "Luge 2000\r\nUn maximum de sensations fortes sur une longueur de 3km !\r\nLa piste de luge 2000 vous offre de nombreux virages relevés, alternant parties rapides et de glisse pure."
    ],
    "es": [
      "Trineo 2000\r\n3 km de emociones fuertes\r\nLa pista de trineo 2000 está llena de curvas peraltadas que alternan tramos rápidos con otros de puro deslizamiento."
    ],
    "nl": [
      "Rodel 2000\r\n3 km spanning en sensatie!\r\nDe rodelbaan 2000 heeft veel schuine bochten, afwisselend snelle stukken en puur glijden."
    ]
  },
