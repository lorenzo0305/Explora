  "rdfs:comment": {
    "de": [
      "Möglichkeit, den Raum für eine geringere Kapazität abzutrennen. Zugang für Personen mit eingeschränkter Mobilität, ausgestattete Küche für Catering, Kühlschrank. Ton- und Videomaterial optional."
    ],
    "en": [
      "Possibility of partitioning the room for a smaller capacity. Disabled access, catering kitchen, refrigerator. Optional sound and video equipment."
    ],
    "it": [
      "Possibilità di dividere la sala per una capienza inferiore. Accesso per disabili, cucina completamente attrezzata per il catering, frigorifero. Attrezzature audio e video opzionali."
    ],
    "fr": [
      "Possibilité de cloisonner la salle pour une capacité inférieure. Accès personne à mobilité réduite, cuisine équipée pour traiteur, réfrigérateur. Matériel son et vidéo en option."
    ],
    "es": [
      "Posibilidad de dividir la sala para una capacidad menor. Acceso para discapacitados, cocina totalmente equipada para catering, nevera. Equipo de sonido y vídeo opcional."
    ],
    "nl": [
      "Mogelijkheid om de ruimte in te delen voor een kleinere capaciteit. Toegang voor mindervaliden, volledig uitgeruste keuken voor cateraars, koelkast. Optionele geluids- en videoapparatuur."
    ]
  },
  "rdfs:label": {
