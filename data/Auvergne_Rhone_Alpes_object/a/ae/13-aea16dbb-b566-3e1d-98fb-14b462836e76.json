  "rdfs:comment": {
    "de": [
      "Eine Tasche ... Eine große Tasche ... Und schon beginnt das große Auspacken! Ein Stück Geschichte, ein Lied aus einer anderen Welt, seltsame Klangmaterialien, ein Hauch von Poesie, einige Instrumente aus der ganzen Welt... Sehr junges Publikum, ab 3 Monaten. Dauer: 35 Min."
    ],
    "en": [
      "One bag... A big bag... And the big unpacking begins! A piece of history, a song from somewhere else, strange sound materials, a touch of poetry, a few instruments from around the world... Very young audience, from 3 months. Running time: 35 min."
    ],
    "it": [
      "Una borsa... Una grande borsa... E inizia il grande disimballaggio! Un pezzo di storia, una canzone da un'altra parte, suoni strani, un tocco di poesia, alcuni strumenti da tutto il mondo... Pubblico molto giovane, a partire dai 3 mesi. Durata: 35 min."
    ],
    "fr": [
      "Un sac... Un grand sac... Et commence le grand déballage ! Un bout d'histoire, une chanson venue d'ailleurs, d'étranges matières sonores, un brin de poésie, quelques instruments du monde... Très jeune public, à partir de 3 mois. Durée : 35 min."
    ],
    "es": [
      "Una bolsa... Una gran bolsa... ¡Y empieza el gran desembalaje! Un trozo de historia, una canción de otro lugar, sonidos extraños, un toque de poesía, algunos instrumentos de todo el mundo... Público muy joven, a partir de 3 meses. Duración: 35 min."
    ],
    "nl": [
      "Eén tas... Eén grote tas... En het grote uitpakken begint! Een stukje geschiedenis, een liedje van ergens anders, vreemde geluiden, een vleugje poëzie, een paar instrumenten van over de hele wereld... Zeer jong publiek, vanaf 3 maanden. Duur: 35 min."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Conte musical : Brin d'air"
    ]
  },
