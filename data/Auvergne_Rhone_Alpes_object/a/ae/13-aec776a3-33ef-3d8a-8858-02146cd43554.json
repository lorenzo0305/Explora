  "rdfs:comment": {
    "de": [
      "Ideal gelegen zwischen Annecy und Albertville, in der Nähe des Radwegs, bieten wir hausgemachte und traditionelle französische Küche. Auswahl an frischen und lokalen Produkten."
    ],
    "en": [
      "Located by Annecy to Albertville, cycle track, in the middle of mighty mountainous surroundings. Large choice of home made french traditional dishes. Daily selection of fresh local products"
    ],
    "it": [
      "In posizione ideale tra Annecy e Albertville, vicino alla pista ciclabile, offriamo una cucina casalinga tradizionale francese. Selezione di prodotti freschi e locali."
    ],
    "fr": [
      "Idéalement situé entre Annecy et Albertville, à proximité de la piste cyclable, nous proposons une cuisine maison et traditionnelle française. Sélection de produits frais et locaux."
    ],
    "es": [
      "Idealmente situado entre Annecy y Albertville, cerca del carril bici, ofrecemos cocina casera tradicional francesa. Selección de productos frescos y locales."
    ],
    "nl": [
      "Ideaal gelegen tussen Annecy en Albertville, dicht bij het fietspad, bieden wij een traditionele Franse thuiskeuken. Selectie van verse en lokale producten."
    ]
  },
