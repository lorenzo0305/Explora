  "rdfs:comment": {
    "de": [
      "Didier stellt kleine Skulpturen aus Metall- und mechanischen Teilen her und kann sich Ihren Wünschen anpassen, um auf Anfrage Maßanfertigungen zu erstellen.$\r\nPerfekt, um (sich selbst) eine Freude zu machen!"
    ],
    "en": [
      "Didier makes small sculptures from metal and mechanical parts, and can adapt to your wishes to create made-to-measure pieces on request\r\nPerfect for indulging yourself!"
    ],
    "it": [
      "Didier realizza piccole sculture in metallo e parti meccaniche e può adattarsi ai vostri desideri per creare pezzi su misura su richiesta\r\nPerfetto per (concedersi) un po' di relax!"
    ],
    "fr": [
      "Didier fabrique de petites sculptures à partir de pièces métalliques et mécaniques et peut s'adapter à vos souhaits pour créer du sur-mesure à la demande.$\r\nParfait pour (se) faire plaisir !"
    ],
    "es": [
      "Didier realiza pequeñas esculturas a partir de metal y piezas mecánicas, y puede adaptarse a sus deseos para crear piezas a medida bajo pedido\r\nPerfecto para darse un capricho"
    ],
    "nl": [
      "Didier maakt kleine sculpturen van metaal en mechanische onderdelen, en kan zich aanpassen aan jouw wensen om op verzoek stukken op maat te maken\r\nPerfect om jezelf (mee) te verwennen!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Facile à Fer : Création de sculptures en métal"
    ]
  },
