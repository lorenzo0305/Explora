  "rdfs:comment": {
    "de": [
      "Unglaubliche Gefühle, unvergleichliche Geschwindigkeit, schwindelerregende Weite... Einzigartig in den Alpen!  Bequem in einem Gurtzeug sitzend, fliegen Sie mit fast 100 km/h und in einer Höhe von bis zu 140 m über den Weiler Plaine-Dranse."
    ],
    "en": [
      "From the air the countryside looks completely different!!! Don't deny yourself the chance for some spine-tingling thrills, come and flirt with the clouds!!! In Châtel, you really can fly."
    ],
    "it": [
      "Sensazioni incredibili, velocità ineguagliabile, ampiezza vertiginosa? Unico nelle Alpi!  Comodamente seduti in un'imbracatura, si vola sopra il borgo di Plaine-Dranse a quasi 100 km/h e fino a 140 m di altezza."
    ],
    "fr": [
      "Sensations incroyables,vitesse inégalée, amplitude vertigineuse… Unique dans les Alpes !  Confortablement installé dans un harnais, vous survolez à presque 100 km/h et jusqu’à 140 m de haut, le hameau de Plaine-Dranse."
    ],
    "nl": [
      "Sensatie, snelheid, duizelingwekkende afstanden: uniek in de Alpen! In een veilige harnas suist u met bijna 100 km /u en tot 140 m hoogte boven de Plaine-Dranse vlakte."
    ],
    "es": [
      "Sensaciones increíbles, velocidad inigualable, amplitud vertiginosa.. ¡Único en los Alpes!  Cómodamente instalado en un arnés, volarás sobre la aldea de Plaine-Dranse a casi 100 km/h y hasta 140 m de altura."
    ]
  },
  "rdfs:label": {
    "de": [
      "Fantasticable im Winter"
    ],
    "en": [
      "Fantasticable in winter"
    ],
    "fr": [
      "Fantasticable en hiver"
    ],
    "nl": [
      "Fantasticable in de winter"
    ]
  },
