  "rdfs:comment": {
    "de": [
      "Unser Restaurant empfängt Sie in einer herzlichen und authentischen Atmosphäre, in der die Gastfreundschaft im Vordergrund steht. Wir bringen die Produkte der Region durch eine hausgemachte, großzügige und geschmackvolle Küche zur Geltung."
    ],
    "en": [
      "Our restaurant welcomes you in a warm and authentic atmosphere, where conviviality is the order of the day. We showcase local produce through generous, flavorful home-cooking."
    ],
    "it": [
      "Il nostro ristorante vi accoglie in un'atmosfera calda e autentica, dove la convivialità è al primo posto. La nostra cucina casalinga, generosa e saporita, valorizza i prodotti locali"
    ],
    "fr": [
      "Notre restaurant vous accueille dans une ambiance chaleureuse et authentique, où la convivialité est à l'honneur. Nous mettons en valeur les produits du terroir à travers une cuisine maison, généreuse et pleine de saveurs"
    ],
    "nl": [
      "Ons restaurant verwelkomt je in een warme en authentieke sfeer, waar gezelligheid voorop staat. We laten lokale producten zien in onze royale, smaakvolle keuken."
    ],
    "es": [
      "Nuestro restaurante le da la bienvenida en un ambiente cálido y auténtico, donde la convivencia ocupa un lugar privilegiado. La cocina casera, generosa y sabrosa, se basa en productos locales"
    ]
  },
