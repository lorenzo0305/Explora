  "rdfs:comment": {
    "de": [
      "Baustoffhändler, umfassendes Sortiment an Materialien und Werkzeugen für Baustellen. Komplettes Sortiment für Elektro-, Maler- oder Klempnerarbeiten sowie eine breite Palette an Materialien und Werkzeugen. Mitglied der Bigmat-Gruppe."
    ],
    "en": [
      "Building materials merchants, complete range of materials and tools for construction sites. Complete range for electrical, painting and plumbing work, as well as a vast array of materials and tools. Member of the Bigmat group."
    ],
    "it": [
      "Commercianti di materiali per l'edilizia, gamma completa di materiali e strumenti per i cantieri. Assortimento completo per lavori elettrici, di verniciatura e idraulici, oltre a un'ampia gamma di materiali e utensili. Membro del gruppo Bigmat."
    ],
    "fr": [
      "Négociants en matériaux de construction, gamme complète de matériaux et outillages pour chantiers. Gamme complète pour travaux d'électricité, de peinture, ou de plomberie ainsi qu'une vaste gamme de matériels et outillages. Membre du groupement Bigmat."
    ],
    "nl": [
      "Handelaar in bouwmaterialen, compleet assortiment materialen en gereedschap voor bouwplaatsen. Compleet assortiment voor elektriciteits-, schilder- en loodgieterswerk, evenals een breed assortiment materialen en gereedschappen. Lid van de Bigmat-groep."
    ],
    "es": [
      "Comerciantes de materiales de construcción, gama completa de materiales y herramientas para obras. Gama completa para trabajos de electricidad, pintura y fontanería, así como una amplia gama de materiales y herramientas. Miembro del grupo Bigmat."
    ]
  },
