  "rdfs:comment": {
    "de": [
      "Die Berge sind nicht nur für Skifahrer reserviert! Erreichen Sie verschiedene Aussichtspunkte und Bergrestaurants mit den 8 fußgängerfreundlichen Liften."
    ],
    "en": [
      "The mountain is not just for skiers! Access various viewpoints and restaurants in altitude thanks to the 8 lifts accessible to pedestrians."
    ],
    "it": [
      "Le montagne non sono solo per gli sciatori! Gli 8 ascensori sono accessibili ai pedoni e consentono di raggiungere diversi punti panoramici e ristoranti in quota."
    ],
    "fr": [
      "La montagne n’est pas réservée qu’aux skieurs ! Accédez à différents points de vue et restaurants d’altitude grâce aux 8 remontées accessibles aux piétons."
    ],
    "es": [
      "La montaña no es sólo para los esquiadores Los 8 ascensores son accesibles para los peatones y permiten acceder a varios miradores y restaurantes en altura."
    ],
    "nl": [
      "De bergen zijn niet alleen voor skiërs! De 8 liften zijn toegankelijk voor voetgangers en bieden toegang tot verschillende uitzichtpunten en restaurants op hoogte."
    ]
  },
  "rdfs:label": {
