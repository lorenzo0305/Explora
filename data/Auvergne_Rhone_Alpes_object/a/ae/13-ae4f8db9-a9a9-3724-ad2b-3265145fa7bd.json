  "rdfs:comment": {
    "de": [
      "Im Herzen der südlichen Ardèche entdecken Sie die Auberge de la Tour de Brison, ein kleines charmantes 3*-Hotel mit Panoramarestaurant, Infinity-Pool und Schwimmspa (außerhalb der Saison überdacht)."
    ],
    "en": [
      "Hotel in a 1620 building that's been welcoming guests since 1902. Sanilhac is both in the Cévennes and Vivarais areas surrounded by two stunning rivers. Car park. Duplex rooms with views. Chromotherapy spa."
    ],
    "it": [
      "Nel cuore dell'Ardèche meridionale, venite a scoprire l'Auberge de la Tour de Brison, un incantevole hotel 3* con ristorante panoramico, piscina a sfioro e centro benessere (coperto fuori stagione)."
    ],
    "fr": [
      "Au cœur de l’Ardèche méridionale, venez découvrir l’Auberge de la Tour de Brison, petit hôtel de charme 3* avec restaurant panoramique, piscine à débordement et spa de nage (couvert hors saison)."
    ],
    "nl": [
      "Kom in het hart van de zuidelijke Ardèche de Auberge de la Tour de Brison ontdekken, een charmant 3*-hotel met panoramisch restaurant, overloopzwembad en zwemspa (overdekt buiten het seizoen)."
    ],
    "es": [
      "En el corazón del sur de Ardèche, venga a descubrir el Auberge de la Tour de Brison, un encantador hotel de 3* con restaurante panorámico, piscina infinita y spa de natación (cubierto fuera de temporada)."
    ]
  },
  "rdfs:label": {
    "en": [
      "Hôtel Auberge la Tour de Brison"
    ],
    "fr": [
      "Auberge de la tour de Brison"
    ]
  },
