  "rdfs:comment": {
    "de": [
      "Kaito, ein japanisches Restaurant mit panasiatischer Fusion, bietet eine delikate und kreative Küche, die ihre Inspiration in Asien findet. Die Klassiker der japanischen Kochkunst werden mit anderen asiatischen Düften und dem Geschmack der Produkte aus den Bergen kombiniert."
    ],
    "en": [
      "Kaito, the first Japanese restaurant on the ski area, presents a delicate and creative cuisine that takes its inspiration from Asia. Classics of Japanese culinary art blend harmoniously with other aromatics of Asia and the savours of Alpine products."
    ],
    "it": [
      "Kaito è un ristorante giapponese di fusion pan-asiatico, che propone una cucina delicata e creativa ispirata all'Asia. I classici dell'arte culinaria giapponese si sposano con i profumi asiatici e con i sapori dei prodotti di montagna."
    ],
    "fr": [
      "Kaito, restaurant japonais de fusion pan-asiatique, offre une cuisine délicate et créative, qui puise son inspiration en Asie. Les classiques de l’art culinaire japonais se marient à d’autres parfums d’Asie et aux saveurs des produits de la montagne."
    ],
    "es": [
      "Kaito, un restaurante panasiático de fusión japonesa, ofrece una cocina delicada y creativa inspirada en Asia. Los clásicos del arte culinario japonés se combinan con otros sabores asiáticos y productos de montaña."
    ],
    "nl": [
      "Kaito, een pan-Aziatisch Japans fusionrestaurant, biedt een verfijnde, creatieve keuken geïnspireerd door Azië. De klassiekers van de Japanse culinaire kunst worden gecombineerd met andere Aziatische smaken en producten uit de bergen."
    ]
  },
