  "rdfs:comment": {
    "de": [
      "Als Fächerplastiker, der zum immateriellen Kulturerbe zählt, beschäftige ich mich hauptsächlich mit der Scham, dem Blick, dem Geschlecht und dem Flattern des Fächers durch seine Geschichte und Anthropologie bis hin zu den avantgardistischsten Ansätzen."
    ],
    "en": [
      "As a fan-maker, I work mainly on modesty, the gaze, gender and the flapping of the fan through its history and anthropology, right up to the most avant-garde approaches."
    ],
    "it": [
      "Come creatrice di ventagli, lavoro principalmente sul pudore, lo sguardo, il genere e il battito del ventaglio attraverso la sua storia e la sua antropologia, fino agli approcci più all'avanguardia."
    ],
    "fr": [
      "Plasticien éventailliste, classé au patrimoine immatériel, je travaille essentiellement sur la pudeur, le regard, le genre et le battement de l'éventail au travers de son histoire et de son anthropologie, jusqu'aux démarches les plus avant-gardistes."
    ],
    "es": [
      "Como abaniquera, trabajo principalmente sobre el pudor, la mirada, el género y el latido del abanico a través de su historia y antropología, hasta llegar a los planteamientos más vanguardistas."
    ],
    "nl": [
      "Als waaiermaker werk ik voornamelijk rond bescheidenheid, de blik, gender en het slaan van de waaier via zijn geschiedenis en antropologie tot aan de meest avant-gardistische benaderingen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Atelier Appâts d'Anges - Eventailliste"
    ]
  },
