  "rdfs:comment": {
    "de": [
      "Der 1926 gegründete Weinkeller von Saint-Sauveur-de-Cruzières empfängt Sie das ganze Jahr über zu einem geschmacklichen und olfaktorischen Streifzug durch unsere besten Cuvées der IGP Ardèche."
    ],
    "en": [
      "The cellar welcomes you all year round for a taste and smell tour of our best wines."
    ],
    "it": [
      "Fondata nel 1926, la cantina di Saint-Sauveur-de-Cruzières vi accoglie tutto l'anno per una visita gusto-olfattiva dei nostri migliori vini IGP dell'Ardèche."
    ],
    "fr": [
      "Créé en 1926, le caveau de Saint-Sauveur-de-Cruzières vous accueille toute l'année pour une balade gustative et olfactive de nos meilleures cuvées IGP Ardèche."
    ],
    "es": [
      "Fundada en 1926, la bodega de Saint-Sauveur-de-Cruzières le acoge todo el año para una visita olfativa y gustativa de nuestros mejores vinos IGP Ardèche."
    ],
    "nl": [
      "De wijnkelder van Saint-Sauveur-de-Cruzières, opgericht in 1926, verwelkomt je het hele jaar door voor een proef- en ruikrondleiding langs onze beste IGP-wijnen uit de Ardèche."
    ]
  },
  "rdfs:label": {
    "en": [
