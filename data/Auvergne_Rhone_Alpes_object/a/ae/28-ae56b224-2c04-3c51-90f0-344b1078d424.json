  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/dc1b221b-d955-357a-9972-4ab70ea57af7",
      "dc:description": {
        "de": [
          "Eine Institution am Eingang der Altstadt von Douai, gegenüber dem Justizpalast! In dieser Bar-Brasserie finden Sie eine entspannte Atmosphäre bei einer hausgemachten Mahlzeit oder einem kleinen Kaffee. Jeden Mittag wird Ihnen ein neues Gericht angeboten."
        ],
        "en": [
          "An institution located at the entrance to old Douai, opposite the Palais de Justice! You'll find a relaxed atmosphere in this bar-brasserie, where you can enjoy a home-cooked meal or a cup of coffee. A new dish is offered every lunchtime."
        ],
        "it": [
          "Un'istituzione situata all'ingresso della città vecchia di Douai, di fronte al Tribunale! Questo bar-brasserie offre un'atmosfera rilassata davanti a un pasto fatto in casa o a una tazza di caffè. Ogni pranzo viene servito un nuovo piatto."
        ],
        "fr": [
          "Une institution située à l'entrée du vieux Douai, en face du Palais de justice ! Vous trouverez dans ce bar-brasserie une ambiance décontractée autour d'un repas fait maison ou d'un petit café. Chaque midi, un plat nouveau vous est proposé."
        ],
        "es": [
          "Una institución situada a la entrada del casco antiguo de Douai, frente al Palacio de Justicia Este bar-brasserie ofrece un ambiente relajado mientras se degusta una comida casera o se toma un café. Cada mediodía se sirve un plato nuevo."
        ],
        "nl": [
          "Een instituut aan de ingang van de oude stad Douai, tegenover het Justitiepaleis! Deze bar-brasserie biedt een ontspannen sfeer bij een huisgemaakte maaltijd of een kopje koffie. Elke middag wordt er een nieuw gerecht geserveerd."
        ]
      },
      "@type": [
        "Description"
      ],
