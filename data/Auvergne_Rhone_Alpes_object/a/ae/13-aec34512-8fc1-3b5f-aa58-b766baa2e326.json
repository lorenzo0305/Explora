  "rdfs:comment": {
    "de": [
      "Lust auf Italien? La Golosita, eine italienische Trattoria im Herzen des Stadtzentrums, bietet alle frischen Produkte aus Italien, Essen vor Ort, Gerichte zum Mitnehmen, Aperitif-/Dinnerplatten, Terrasse, Brunch. Nur wenige Schritte vom Fer à Cheval und der Oper entfernt."
    ],
    "en": [
      "In the mood for Italy? La Golosita, an Italian trattoria in the heart of downtown, offers all the fresh produce of Italy, on-site catering, takeaways, aperitif/dinner platters, terrace, brunch. Just a stone's throw from the Fer à Cheval and the Opéra."
    ],
    "it": [
      "Avete voglia di Italia? La Golosita, trattoria italiana nel cuore del centro città, offre tutti i prodotti freschi d'Italia, catering in loco, take away, vassoi per aperitivi/cene, terrazza, brunch. A due passi dal Fer à Cheval e dall'Opéra."
    ],
    "fr": [
      "Envie d'Italie ? La Golosita, trattoria italienne au coeur du centre-ville, propose tous les produits frais d'Italie, restauration sur place, plats à emporter, plateaux apéritif/dinatoire, terrasse, brunch. À deux pas du Fer à Cheval et de l’Opéra."
    ],
    "es": [
      "¿Te apetece Italia? La Golosita, trattoria italiana en pleno centro de la ciudad, ofrece todos los productos frescos de Italia, servicio de catering in situ, comida para llevar, aperitivos/cenas, terraza, brunch. A dos pasos del Fer à Cheval y de la Ópera."
    ],
    "nl": [
      "Zin in Italië? La Golosita, een Italiaanse trattoria in het hart van het stadscentrum, biedt alle verse producten van Italië, catering ter plekke, afhaalmaaltijden, aperitief/diner trays, terras, brunch. Op een steenworp afstand van de Fer à Cheval en de Opéra."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Golosita"
    ]
  },
