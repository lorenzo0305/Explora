  "rdfs:comment": {
    "de": [
      "Die Region Burgund hat einen Ort, um den sie alle beneiden: Les Arts dans l'R, ein gemütliches Café-Theater, das Ihnen die Türen zum Lachen, zum Mitfiebern und zur Freude öffnet\r\nemotionen öffnet, um Sie in das Herz der darstellenden Kunst zu entführen."
    ],
    "en": [
      "The region of Burgundy has a place that everyone envies: the Arts in the R, a theater-café, warm that opens the doors of laughter, emotion to take you to the heart of live entertainment.\r\nemotion to lead you to the heart of the live show."
    ],
    "it": [
      "La regione della Borgogna ha un luogo che fa invidia a tutti: l'Arts dans l'R, un accogliente caffè-teatro che apre le porte a risate, emozioni e performance dal vivo\r\nemozione per portarvi nel cuore dello spettacolo dal vivo."
    ],
    "fr": [
      "La région burgienne possède un lieu que tous lui envient : les Arts dans l'R, une salle de spectacle café-théâtre, chaleureuse qui vous ouvre les portes du rire, de \r\nl'émotion pour vous entrainer au coeur du spectacle vivant."
    ],
    "es": [
      "La región de Borgoña tiene un lugar que es la envidia de todos: el Arts dans l'R, un cálido café-teatro que abre las puertas a la risa, la emoción y el espectáculo en vivo\r\nemoción para llevarte al corazón del entretenimiento en vivo."
    ],
    "nl": [
      "De Bourgogne heeft een plek waar iedereen jaloers op is: de Arts dans l'R, een warme café-theaterzaal die de deuren opent voor gelach, emotie en live optredens\r\nemotie om je mee te nemen naar het hart van live entertainment."
    ]
  },
