  "rdfs:comment": {
    "de": [
      "Hier finden Sie Bücher, Zeitschriften und auch Musik, Filme, Noten, Hörbücher...usw. und natürlich ein Team, das Ihnen zuhören und Sie beraten kann."
    ],
    "en": [
      "You will find books, magazines and also music, films, scores, audio books...etc. and of course a team available to listen to you and advise you."
    ],
    "it": [
      "Troverete libri, riviste e anche musica, film, spartiti, audiolibri... ecc. e naturalmente un team disponibile ad ascoltarvi e consigliarvi."
    ],
    "fr": [
      "Vous trouverez des livres, des revues et aussi de la musique, des films, des partitions, des livres audio...etc. et bien sûr une équipe disponible pour vous écouter et vous conseiller."
    ],
    "nl": [
      "U vindt er boeken, tijdschriften en ook muziek, films, partituren, audioboeken...enz. en natuurlijk een team dat beschikbaar is om naar u te luisteren en u te adviseren."
    ],
    "es": [
      "Encontrará libros, revistas y también música, películas, partituras, audiolibros...etc. y, por supuesto, un equipo disponible para escucharle y aconsejarle."
    ]
  },
