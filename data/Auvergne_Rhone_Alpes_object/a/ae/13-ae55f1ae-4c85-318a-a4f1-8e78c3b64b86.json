  "rdfs:comment": {
    "de": [
      "Eisenwarenhandel. Große Auswahl für die Renovierung und Instandhaltung des Hauses!\r\nElektrowerkzeuge, Werkzeuge, Schweißen, Elektrizität, Klempnerei, persönliche Schutzausrüstung, Beschilderung, Malerei, PSA\r\nService plus: Minutenschlüssel und Gasdepot"
    ],
    "en": [
      "Ironmonger, you will find all that you need to repair and to look after your home.\r\nElectrical equipment, tools, weld, electricity, plumbing, marking..."
    ],
    "it": [
      "Hardware. Ampia scelta per il miglioramento e la manutenzione della casa!\r\nElettricità portatile, utensili, saldatura, elettricità, idraulica, dispositivi di protezione individuale, segnaletica, verniciatura, DPI\r\nService plus: Chiave rapida e deposito di gas"
    ],
    "fr": [
      "Quincaillerie. Grand choix pour la rénovation et l'entretien de la maison !\r\nElectroportatif, outillage, soudure, électricité, plomberie, équipement protection individuelle, signalisation, peinture, EPI. \r\nService plus : Clé minute et dépôt de gaz"
    ],
    "nl": [
      "Hardware. Ruime keuze voor woningverbetering en onderhoud!\r\nDraagbare elektriciteit, gereedschap, lassen, elektriciteit, loodgieterij, persoonlijke beschermingsmiddelen, bewegwijzering, verf, PBM's\r\nService plus: Snelsleutel en gasafzetting"
    ],
    "es": [
      "Hardware. Amplia selección para la mejora y el mantenimiento del hogar\r\nElectricidad portátil, herramientas, soldadura, electricidad, fontanería, equipos de protección individual, señalización, pintura, EPI\r\nServicio plus: Llave rápida y depósito de gas"
    ]
  },
