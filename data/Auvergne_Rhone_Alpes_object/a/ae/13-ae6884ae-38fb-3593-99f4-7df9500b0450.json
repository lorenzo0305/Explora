  "rdfs:comment": {
    "de": [
      "Das Restaurant 77 befindet sich in idealer Lage im Herzen des dynamischen Stadtteils Part-Dieu.  Der Chefkoch arbeitet mit frischen, saisonalen Produkten und ändert seine Speisekarte täglich entsprechend dem Tagesmarkt."
    ],
    "en": [
      "Restaurant 77 is ideally located in the heart of the vibrant Part-Dieu district. The Chef works with fresh, seasonal produce and changes his menu daily according to the market of the day."
    ],
    "it": [
      "Il ristorante 77 è situato in posizione ideale nel cuore del dinamico quartiere di Part-Dieu.  Lo chef lavora con prodotti freschi e di stagione e cambia il suo menu ogni giorno in base al mercato del giorno."
    ],
    "fr": [
      "Le Restaurant 77 est idéalement situé en plein cœur du très dynamique quartier Part-Dieu.  Le Chef travaille des produits frais et de saison et fait évoluer sa carte quotidiennement en fonction de son marché du jour."
    ],
    "nl": [
      "Restaurant 77 is ideaal gelegen in het hart van de zeer dynamische wijk Part-Dieu.  De chef werkt met verse en seizoensgebonden producten en verandert zijn menu dagelijks volgens de markt van de dag."
    ],
    "es": [
      "El Restaurante 77 está idealmente situado en el corazón del dinámico barrio de Part-Dieu.  El Chef trabaja con productos frescos y de temporada y cambia su menú diariamente según el mercado del día."
    ]
  },
