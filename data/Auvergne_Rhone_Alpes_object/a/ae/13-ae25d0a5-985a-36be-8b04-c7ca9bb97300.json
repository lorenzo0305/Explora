  "rdfs:comment": {
    "de": [
      "Carbone Zero ist ein Geschäft, das sich auf nicht motorisierte Transportmittel spezialisiert hat. Das Geschäft liegt mitten in der Stadt und in der Nähe des Bahnhofs.\r\nFahrrad- und Elektrofahrradverleih."
    ],
    "en": [
      "Carbone zero is a shop dedicated to non motorized transportation.The shop is right in the middle of town and nearby the Train station.\r\nBike and eletric bike rental."
    ],
    "it": [
      "Carbone zero è un negozio dedicato ai trasporti non motorizzati. Il negozio si trova proprio nel centro della città e vicino alla stazione ferroviaria.\r\nNoleggio bici e bici elettriche."
    ],
    "fr": [
      "Carbone zéro est un magasin dédié au transport non motorisé. Le magasin est en plein centre ville de Valence, à proximité immédiate de la gare SNCF  Valence Ville.\nVente, Réparation, Entretien et Location de vélos et vélos électriques."
    ],
    "nl": [
      "Carbone zero is een winkel gewijd aan niet-gemotoriseerd vervoer. De winkel ligt midden in de stad en vlakbij het treinstation.\r\nVerhuur van fietsen en elektrische fietsen."
    ],
    "es": [
      "Carbone zéro es una tienda dedicada al transporte no motorizado. La tienda está situada en el centro de Valence, justo al lado de la estación de tren SNCF Valence Ville.\nVenta, reparación, mantenimiento y alquiler de bicicletas y bicicletas eléctricas."
    ]
  },
