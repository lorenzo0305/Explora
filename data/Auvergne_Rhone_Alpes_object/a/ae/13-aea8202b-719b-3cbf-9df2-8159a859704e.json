  "rdfs:comment": {
    "de": [
      "Das Ökozentrum Terre vivante wird diesen Sommer wiedereröffnet und in dieser Zeit geht auch der Verlag weiter!\r\nDie Publikationen von Terre vivante finden Sie auf ihrer Website oder im Buchhandel."
    ],
    "en": [
      "The Terre vivante Ecological Center is reopening this summer, while the publishing house continues its activities!\r\nYou can find Terre vivante publications on its website or in bookshops."
    ],
    "it": [
      "Il centro ecologico Terre vivante riapre quest'estate, mentre la casa editrice continua la sua attività!\r\nLe pubblicazioni di Terre vivante sono disponibili sul sito web o in libreria."
    ],
    "fr": [
      "Le Centre écologique Terre vivante réouvre cet été et dans ce temps, la maison d'édition poursuit son activité !\r\nVous pouvez retrouver les publications de Terre vivante sur son site internet ou en librairie."
    ],
    "nl": [
      "Het ecologisch centrum Terre vivante heropent deze zomer, terwijl de uitgeverij haar activiteiten voortzet!\r\nJe kunt de publicaties van Terre vivante vinden op de website of in de boekhandel."
    ],
    "es": [
      "El centro ecológico Terre vivante reabre sus puertas este verano, mientras la editorial prosigue sus actividades\r\nPuede encontrar las publicaciones de Terre vivante en su sitio web o en las librerías."
    ]
  },
