  "rdfs:comment": {
    "de": [
      "Pont-de-Beauvoisin, seit Franz I. die Stadt der Möbel, besitzt ein erstklassiges Holzmaschinenmuseum. Vom Baum zum Möbelstück, auf zu einer magischen Reise, bei der das Holz König ist."
    ],
    "en": [
      "Pont-de-Beauvoisin, city of wood furniture since François the 1st, shelters a museum of woodworking machinery. From trees to furnitures, experiment an old fashioned cabinetmaker workshop."
    ],
    "it": [
      "Pont-de-Beauvoisin, la città del mobile dai tempi di Francesco I, ospita un museo di prim'ordine sulle macchine per la lavorazione del legno. Dall'albero al mobile, partiamo per un viaggio magico dove il legno è il re."
    ],
    "fr": [
      "Pont-de-Beauvoisin, cité du meuble depuis François 1er, possède un musée de la machine à bois de premier ordre. De l’arbre au meuble, en route pour une traversée magique où le bois est roi."
    ],
    "es": [
      "Pont-de-Beauvoisin, ciudad del mueble desde Francisco I, cuenta con un museo de maquinaria de madera de primer orden. Del árbol al mueble, vamos a realizar un viaje mágico en el que la madera es el rey."
    ],
    "nl": [
      "Laat U zien hoe in het begin van de 20e eeuw de meubels gemaakt werden die Pont de Beauvoisin bekend maakten als de meubelstad van Frankrijk."
    ]
  },
  "rdfs:label": {
    "en": [
      "Wood machine and hand tools Museum"
    ],
    "fr": [
      "Musée de la Machine à Bois et de l'Outillage à Main"
    ],
    "nl": [
      "Museum over houtwerkmachines en het oude handwerk"
    ]
  },
