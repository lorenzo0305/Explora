  "rdfs:comment": {
    "de": [
      "Im Restaurant Le Pergros stellen wir unsere Leidenschaft und unser Wissen in den Dienst einer raffinierten Küche, die mit frischen und lokalen Produkten zubereitet wird. Da jeder Moment ein passendes kulinarisches Erlebnis verdient, bieten wir Ihnen verschiedene Menüs an"
    ],
    "en": [
      "At Le Pergros restaurant, we put our passion and expertise at the service of refined cuisine, prepared with fresh, local produce. Because every moment deserves its own culinary experience, we offer a choice of menus"
    ],
    "it": [
      "Al ristorante Le Pergros mettiamo la nostra passione e competenza al servizio di una cucina raffinata, utilizzando prodotti freschi e locali. Poiché ogni momento merita la sua esperienza culinaria, offriamo una gamma di menu"
    ],
    "fr": [
      "Au restaurant Le Pergros , nous mettons notre passion et notre savoir-faire au service d’une cuisine raffinée, élaborée avec des produits frais et locaux. Parce que chaque moment mérite une expérience culinaire adaptée, nous vous proposons plusieurs menus"
    ],
    "nl": [
      "In restaurant Le Pergros stellen we onze passie en expertise in dienst van een verfijnde keuken, met verse, lokale producten. Omdat elk moment zijn eigen culinaire ervaring verdient, bieden we een keuze aan menu's"
    ],
    "es": [
      "En el restaurante Le Pergros, ponemos nuestra pasión y experiencia al servicio de una cocina refinada, elaborada con productos frescos y locales. Porque cada momento merece su propia experiencia culinaria, ofrecemos una selección de menús"
    ]
  },
  "rdfs:label": {
