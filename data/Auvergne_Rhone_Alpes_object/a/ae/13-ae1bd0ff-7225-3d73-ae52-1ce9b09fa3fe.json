  "rdfs:comment": {
    "de": [
      "In einem gemütlichen Rahmen mit einer ruhigen Terrasse bietet das Restaurant le \"Tit'Abel\" eine Abendkarte mit Schiefertafel an. Die Pizzen und das Tagesmenü werden aus frischen Zutaten zubereitet. Denken Sie daran, im Voraus zu reservieren."
    ],
    "en": [
      "In a warm setting, with its quiet terrace, the \"Tit'Abel\" restaurant offers an evening menu by the slate. The pizzas and daily menu are made with fresh produce. Please book in advance."
    ],
    "it": [
      "In un ambiente accogliente, con la sua tranquilla terrazza, il ristorante \"Tit'Abel\" offre un menu serale dalla lavagna. Le pizze e il menu del giorno sono preparati con prodotti freschi. Ricordate di prenotare in anticipo."
    ],
    "fr": [
      "Dans un cadre chaleureux, avec sa terrasse au calme, le restaurant le \"Tit'Abel\" propose une carte du soir à l'ardoise. Les pizzas et le menu du jour sont élaborés à partir de produits frais. Pensez à réserver à l'avance."
    ],
    "nl": [
      "In een warme omgeving, met een rustig terras, biedt het restaurant \"Tit'Abel\" een avondmenu van de lei. De pizza's en het dagmenu worden bereid met verse producten. Vergeet niet vooraf te reserveren."
    ],
    "es": [
      "En un ambiente cálido, con su tranquila terraza, el restaurante \"Tit'Abel\" ofrece un menú nocturno de pizarra. Las pizzas y el menú del día se elaboran con productos frescos. Recuerde reservar con antelación."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant- Pizzeria le Tit'Abel"
    ]
  },
