  "rdfs:comment": {
    "de": [
      "Bar, Brasserie, Saladerie, traditionelle Küche, Teesalon. Herzlicher und sympathischer Empfang. Überdachte Terrasse im Winter und große Terrasse im Sommer. Internetzugang über Wifi. Essenspakete zum Mitnehmen mittags und abends auf Bestellung."
    ],
    "en": [
      "Bar, brasserie, salad bar, traditional kitchen, tea room. Warm and friendly welcome. Covered terrace in winter and large terrace in summer. Wifi internet access. Packed lunch and dinner to take away on order."
    ],
    "it": [
      "Bar, brasserie, salad bar, cucina tradizionale, sala da tè. Accoglienza calorosa e amichevole. Terrazza coperta in inverno e grande terrazza in estate. Accesso a Internet via Wifi. Scatole per pranzo e cena da asporto su ordinazione."
    ],
    "fr": [
      "Bar, brasserie, saladerie, cuisine traditionnelle, salon de thé. Accueil chaleureux et sympathique. Terrasse couverte l'hiver et grande terrasse l'été. Accès internet Wifi. Coffrets repas à emporter midi et soir sur commande."
    ],
    "nl": [
      "Bar, brasserie, saladebar, traditionele keuken, theesalon. Warm en vriendelijk onthaal. Overdekt terras in de winter en groot terras in de zomer. Wifi internet toegang. Take-away lunch en diner dozen op bestelling."
    ],
    "es": [
      "Bar, brasserie, bar de ensaladas, cocina tradicional, salón de té. Acogida cálida y amable. Terraza cubierta en invierno y gran terraza en verano. Acceso a Internet Wifi. Cajas de comida y cena para llevar por encargo."
    ]
  },
