  "rdfs:comment": {
    "de": [
      "Das Hallenbad und der Wasserspielplatz im Freien mit Rutschen, Aquasplash, Bauchrutschen... sind ab dem 29. Juni sieben Tage die Woche von 11:00 bis 19:00 Uhr geöffnet."
    ],
    "en": [
      "The outdoor recreational pool and the indoor pool are open every day from June 29th to August 30th from 11 a.m. to 7 p.m."
    ],
    "it": [
      "La piscina coperta e l'area giochi d'acqua all'aperto con scivoli, aquasplash, scivoli per il pancione... sono aperti 7 giorni su 7 dalle 11 alle 19 a partire dal 29 giugno."
    ],
    "fr": [
      "La piscine intérieure et l'aire de jeux d'eau extérieur avec toboggans, aquasplash, ventre glisse... sont ouverts 7j/7 de 11h à 19h à partir du 29 juin."
    ],
    "es": [
      "La piscina cubierta y la zona de juegos acuáticos al aire libre, con toboganes, aquasplash, toboganes hinchables... están abiertas los 7 días de la semana, de 11.00 a 19.00 h, a partir del 29 de junio."
    ],
    "nl": [
      "Het overdekte zwembad en de waterspeeltuin buiten met glijbanen, aquasplash, buikglijbanen... zijn vanaf 29 juni 7 dagen per week geopend van 11.00 tot 19.00 uur."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Jeux d'eau saison estivale - piscine de Saint Paulien"
    ]
  },
