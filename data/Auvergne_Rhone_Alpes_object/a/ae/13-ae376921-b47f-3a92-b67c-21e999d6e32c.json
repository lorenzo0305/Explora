  "rdfs:comment": {
    "de": [
      "Geschenke, provenzalische Produkte, Erinnerungen: Zeichen wie Durance, Occitane, Desigual Homme Femme Enfants, Melvita, Florame, Vater Kürschner, Hügel der Provence, der Krippenfiguren Marcel Carbonel."
    ],
    "en": [
      "A very varied universe selling Prrovençal gifts and souvenirs, essential oils, men's/women's/children's clothing. Brands such as Durance, L'Occitan, Desigual, Melvita, Florame (organic), Père Pelletier, Hills of Provence, Marcel Christmas crib figures."
    ],
    "it": [
      "Un universo molto vario, regali, souvenir provenzali, oli essenziali, abbigliamento, gioielli e accessori femminili."
    ],
    "fr": [
      "Univers très varié, cadeaux, souvenirs de Provence, huiles essentielles, vêtements, bijoux et accessoires femme."
    ],
    "nl": [
      "Zeer gevarieerd aanbod, cadeaus, souvenirs, etherische oliën, kleding voor mannen/vrouwen/kinderen. Modieuze accessoires, tafel- en huishoudlinnen, merken: L'Occitane, Durance, Désigual, Florame (Bio), le père Pelletier, Marc Vidal."
    ],
    "es": [
      "Un universo muy variado, regalos, recuerdos de la Provenza, aceites esenciales, ropa, joyas y accesorios femeninos."
    ]
  },
