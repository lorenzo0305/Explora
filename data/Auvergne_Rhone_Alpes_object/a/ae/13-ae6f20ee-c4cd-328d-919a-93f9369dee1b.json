  "rdfs:comment": {
    "de": [
      "11 Einrichtungen, Bibliotheken und Mediatheken schließen sich zu einem Netzwerk (Réseau Le Pluriel) zusammen, um den Einwohnern der Communauté de Communes Saône-Beaujolais einen qualitativ hochwertigen und kundennahen Service zu bieten."
    ],
    "en": [
      "11 facilities, libraries and media libraries are grouped together in a network (Réseau Le Pluriel) to offer a quality and local service to the inhabitants of the Saône-Beaujolais Community of Communes."
    ],
    "it": [
      "11 strutture, biblioteche e mediateche sono raggruppate in una rete (Réseau Le Pluriel) per offrire un servizio di qualità e locale agli abitanti della Comunità dei Comuni del Saône-Beaujolais."
    ],
    "fr": [
      "11 équipements, bibliothèques et médiathèques se regroupent en réseau (Réseau Le Pluriel) pour offrir un service de qualité et de proximité aux habitants de la Communauté de Communes Saône-Beaujolais."
    ],
    "nl": [
      "11 voorzieningen, bibliotheken en mediatheken zijn gegroepeerd in een netwerk (Réseau Le Pluriel) om de inwoners van de gemeente Saône-Beaujolais een kwalitatieve en lokale dienstverlening te bieden."
    ],
    "es": [
      "11 instalaciones, bibliotecas y mediatecas se agrupan en una red (Réseau Le Pluriel) para ofrecer un servicio de calidad y de proximidad a los habitantes de la Comunidad de Municipios de Saône-Beaujolais."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Médiathèque Le Singuliers"
    ]
  },
