  "rdfs:comment": {
    "de": [
      "Der typisch schottische Wallace Pub befindet sich im Herzen des Viertels Vaise. Wie bei seinen beiden Wallace-Brüdern im 5. (Saint-Paul) und 2. (Rue Thomassin) legt das Team großen Wert auf die Auswahl der Produkte, die man hier findet."
    ],
    "en": [
      "The Wallace Pub is a typically Scottish pub in the heart of the Vaise district. Here, as in its two eponymous pubs (in Saint-Paul, 5th arrondissement, and Rue Thomassin, 2nd arrondissement) we place great emphasis on selecting our products."
    ],
    "it": [
      "Il Wallace Pub, tipicamente scozzese, si trova nel cuore del quartiere Vaise. Come per i suoi due fratelli Wallace nel 5° arrondissement (Saint-Paul) e nel 2° arrondissement (rue Thomassin), il team attribuisce grande importanza alla selezione dei prodotti che vi si trovano."
    ],
    "fr": [
      "Le Wallace Pub, typiquement écossais, se situe au cœur du quartier de Vaise. Comme pour ses 2 frères Wallace du 5ème (Saint-Paul) et du 2ème (rue Thomassin), l'équipe attache une grande importance à la sélection des produits que l'on y trouve."
    ],
    "es": [
      "El Wallace Pub, típicamente escocés, está situado en el corazón del barrio de Vaise. Al igual que sus dos hermanos Wallace, en el distrito 5 (Saint-Paul) y en el distrito 2 (rue Thomassin), el equipo concede gran importancia a la selección de los productos que allí se encuentran."
    ],
    "nl": [
      "De Wallace Pub, typisch Schots, ligt in het hart van de wijk Vaise. Net als bij zijn twee broers Wallace in het 5e arrondissement (Saint-Paul) en het 2e arrondissement (rue Thomassin) hecht het team veel belang aan de selectie van de producten die er te vinden zijn."
    ]
  },
