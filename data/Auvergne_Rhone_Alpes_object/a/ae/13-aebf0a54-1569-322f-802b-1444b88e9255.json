  "rdfs:comment": {
    "de": [
      "Willkommen im Espace Loisirs Orientation de Laval, dem Eingangstor zur Belledonne-Kette."
    ],
    "en": [
      "Welcome to L’Espace d'Orientation de Laval, the gateway to the Belledonne mountain range. Discovering Laval's heritage and landscapes.\r\nEach marker asks you a question, so answer as best you can. Answers are given on the map."
    ],
    "it": [
      "Benvenuti all'Espace Loisirs Orientation di Laval, la porta della catena montuosa di Belledonne."
    ],
    "fr": [
      "Bienvenue à l'Espace Loisirs Orientation de Laval porte d'entrée de la chaîne de Belledonne."
    ],
    "nl": [
      "Welkom bij Espace d'Orientation de Laval, de toegangspoort tot het Belledonne-gebergte. Ontdek het erfgoed en de landschappen van Laval.\r\nElk merkteken stelt je een vraag, dus beantwoord die zo goed mogelijk. Antwoorden op de kaart."
    ],
    "es": [
      "Bienvenido al Espace Loisirs Orientation de Laval, puerta de entrada a la cordillera Belledonne."
    ]
