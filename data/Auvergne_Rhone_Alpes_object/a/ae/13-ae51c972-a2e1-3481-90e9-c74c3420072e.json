  "rdfs:comment": {
    "de": [
      "Das Café-Bistro \"Si mon père savait...\" befindet sich im Herzen des Dorfes und bietet Ihnen die Möglichkeit, einen gemütlichen Moment zu verbringen.\r\nNeu: Entdecken Sie die von Yann entworfene Pizzakarte!"
    ],
    "en": [
      "The café-bistro \"If my father knew...\", located in the heart of the village, offers a friendly and welcoming atmosphere. \r\nNew: discover the pizza menu created by Yann!"
    ],
    "it": [
      "Il caffè-bistrot \"Se mio padre sapesse...\" situato nel cuore del paese, vi permetterà di trascorrere un momento conviviale. \r\nNovità: scoprite il menù di pizze ideato da Yann!"
    ],
    "fr": [
      "Le café-bistrot \"Si mon père savait...\" situé en plein cœur du village, vous permettra de passer un moment convivial.\r\nNouveauté  : découvrez la carte des pizzas imaginé par Yann !"
    ],
    "es": [
      "El café-bistró \"Si mon père savait...\", en el corazón del pueblo, es el lugar perfecto para pasar un momento de convivencia.\r\nNovedad: ¡descubra la carta de pizzas diseñada por Yann!"
    ],
    "nl": [
      "De café-bistro \"Si mon père savait...\" in het hart van het dorp is de perfecte plek om een gezellig moment door te brengen.\r\nNieuw: ontdek het pizzamenu ontworpen door Yann!"
    ]
  },
