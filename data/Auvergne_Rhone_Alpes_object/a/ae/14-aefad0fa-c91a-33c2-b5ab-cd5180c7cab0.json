  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/00e30524-5fb6-3890-aeea-3c93e05b485b",
      "dc:description": {
        "de": [
          "Metzgerei, Wurstwaren, Traiteur, im Keller gereiftes Fleisch.\nLokale Produkte, hausgemacht.\nÖffnungszeiten: Dienstag bis Samstag und Sonntag von Mitte September bis April"
        ],
        "en": [
          "Butcher's, delicatessen, cellar-aged meats.\nLocal products, homemade.\nOpening hours: Tuesday to Saturday and Sunday from mid-September to April"
        ],
        "it": [
          "Macelleria, salumeria, gastronomia, carni stagionate in cantina.\nProdotti locali, fatti in casa.\nAperto da martedì a sabato e domenica da metà settembre ad aprile"
        ],
        "fr": [
          "Boucherie, Charcuterie, Traiteur, viandes maturées en cave.\nProduits locaux, fabrication faite maison.\nPériode d'ouverture: du mardi au samedi et le dimanche de mi septembre à avril"
        ],
        "nl": [
          "Slagers, vleeswaren, delicatessen, gerijpt vlees uit de kelder.\nLokale producten, huisgemaakt.\nGeopend van dinsdag tot zaterdag en zondag van half september tot april"
        ],
        "es": [
          "Carnicería, charcutería, charcutería, carnes curadas en bodega.\nProductos locales, caseros.\nAbierto de martes a sábado y domingos de mediados de septiembre a abril"
        ]
      },
