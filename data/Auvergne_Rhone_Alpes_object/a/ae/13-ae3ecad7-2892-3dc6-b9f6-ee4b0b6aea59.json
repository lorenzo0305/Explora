  "rdfs:comment": {
    "de": [
      "Sie wollen wie alle anderen sein und dorthin gehen, wo alle anderen hingehen? Es steht Ihnen frei... \nDas Bureau des Guides steht für: Professionelle Betreuung bei Bergaktivitäten: Bergführer, Begleiter im Mittelgebirge, BE VTT."
    ],
    "en": [
      "Do you want to be like everyone else and go where everyone else goes?.... It's up to you...The Montalbert mountain guides office offers professional accompaniment for mountain activities with state-qualified high- and medium-altitude mountain guides and mountain bike guides."
    ],
    "it": [
      "Volete essere come tutti gli altri e andare dove vanno gli altri?... Dipende da voi?\nIl Bureau des Guides è: guide alpine professioniste, accompagnatori di montagna, istruttori di mountain bike."
    ],
    "fr": [
      "Vous voulez faire comme tout le monde et aller où tout le monde va?... Libre à vous… \nLe Bureau des Guides c'est: Un encadrement professionnel des activités de montagne : Guide de Haute Montagne, Accompagnateurs en moyenne montagne ,BE VTT."
    ],
    "es": [
      "¿Quieres ser como los demás e ir a donde todos van?... ¿depende de ti?\nEl Bureau des Guides es: Guías de montaña profesionales, líderes de montaña, instructores de ciclismo de montaña."
    ],
    "nl": [
      "Wil je net als iedereen zijn en gaan waar iedereen gaat? Aan jou de keuze... Het Bureau des Guides is: professionele berggidsen, bergleiders, mountainbike-instructeurs."
    ]
  },
  "rdfs:label": {
    "de": [
      "Bergführerbüro von Plagne Montalbert"
    ],
    "en": [
      "Plagne Montalbert Mountain Guides"
    ],
    "fr": [
      "Bureau des guides de Plagne Montalbert"
    ],
    "nl": [
      "Gidsenbureau van Plagne Montalbert"
