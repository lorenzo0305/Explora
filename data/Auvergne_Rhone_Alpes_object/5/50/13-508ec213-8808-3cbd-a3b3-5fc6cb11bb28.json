  "rdfs:comment": {
    "de": [
      "Das Hotel Gallia befindet sich auf den Anhöhen von Aix-les-Bains, ganz in der Nähe der Thermen Chevalley, 7 Minuten zu Fuß vom Stadtzentrum und dem TGV-Bahnhof entfernt."
    ],
    "en": [
      "The Gallia hotel is located on the heights of Aix-les-Bains, close to the Chevalley thermal baths, 7 minutes walk from the city center, the TGV train station and close to all the popular places such as the Congress Center, the Grand Cercle Casino, the Bourget Lake."
    ],
    "it": [
      "L'hotel Gallia si trova sulle alture di Aix-les-Bains, vicino alle Thermes Chevalley, a 7 minuti a piedi dal centro città, dalla stazione dei treni TGV e vicino a tutti i luoghi più popolari come il Centro Congressi, il Casino Grand Cercle e il Lac du Bourget."
    ],
    "fr": [
      "L’hôtel Gallia est situé sur les hauteurs d’Aix-les-Bains, tout près des Thermes Chevalley, à 7 mn à pied du centre-ville, de la gare TGV et proche de tous les lieux prisés tels que Le Centre des Congrès, le Casino Grand Cercle, le Lac du Bourget."
    ],
    "nl": [
      "Het Gallia hotel ligt op de hoogten van Aix-les-Bains, dicht bij de Thermen Chevalley, op 7 minuten lopen van het stadscentrum, het TGV treinstation en dicht bij alle populaire plaatsen zoals het Congrescentrum, het Casino Grand Cercle en het Lac du Bourget."
    ],
    "es": [
      "El hotel Gallia está situado en las alturas de Aix-les-Bains, cerca de las Thermes Chevalley, a 7 minutos a pie del centro de la ciudad, de la estación de tren TGV y cerca de todos los lugares populares como el Centro de Congresos, el Casino Grand Cercle y el Lac du Bourget."
    ]
  },
