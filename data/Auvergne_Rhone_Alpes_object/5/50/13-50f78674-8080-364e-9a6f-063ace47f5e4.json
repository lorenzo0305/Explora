  "rdfs:comment": {
    "de": [
      "Weltküche in Form eines Buffets\r\nFür Firmen und Privatpersonen gibt es auch einen Cateringservice: Menüplatten, Cocktails, Gerichte zum Mitnehmen"
    ],
    "en": [
      "World cuisine in the form of a buffet\r\nA catering service is also available for companies and private individuals: Meal trays, cocktails, takeaway meals, etc"
    ],
    "it": [
      "Cucina mondiale a buffet\r\nÈ inoltre disponibile un servizio di catering per aziende e privati: vassoi di pasti, cocktail, pasti da asporto"
    ],
    "fr": [
      "Cuisine du monde sous forme de buffet. \r\nUne partie traiteur est également disponible pour les entreprises ainsi qu'aux particuliers: Plateaux-repas, Cocktails, plats à emporter"
    ],
    "nl": [
      "Wereldkeuken in buffetvorm\r\nEr is ook een cateringdienst beschikbaar voor bedrijven en particulieren: maaltijdtrays, cocktails, meeneemmaaltijden"
