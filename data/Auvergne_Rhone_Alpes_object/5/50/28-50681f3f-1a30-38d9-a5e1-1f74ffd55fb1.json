      "@id": "https://data.datatourisme.fr/ecef07da-54d8-3632-b7a1-273d1251aee3",
      "dc:description": {
        "de": [
          "Die Noshoes-Shops begrüßen dich in Le Crotoy und Saint-Valery-sur-Somme zum Fahrradverleih!\nVerleih von Beach-Cruiser-Fahrrädern und Kinderanhängern."
        ],
        "en": [
          "Noshoes shops welcome you in Le Crotoy and Saint-Valery-sur-Somme for bike rental!\nBeach cruiser bikes and children's trailers for hire."
        ],
        "it": [
          "I negozi Noshoes vi accolgono a Le Crotoy e a Saint-Valery-sur-Somme per il noleggio di biciclette!\nNoleggio di biciclette da spiaggia e rimorchi per bambini."
        ],
        "fr": [
          "Les boutiques Noshoes vous accueillent au Crotoy et à Saint-Valery-sur-Somme pour la location de vélos !\nLocation de vélos Beach cruiser et remorques enfants."
        ],
        "nl": [
          "Noshoes winkels verwelkomen u in Le Crotoy en Saint-Valery-sur-Somme voor fietsverhuur!\nVerhuur van strandfietsen en kinderwagens."
        ],
        "es": [
          "Las tiendas Noshoes le dan la bienvenida en Le Crotoy y Saint-Valery-sur-Somme para el alquiler de bicicletas\nAlquiler de bicicletas de playa y remolques para niños."
        ]
      },
