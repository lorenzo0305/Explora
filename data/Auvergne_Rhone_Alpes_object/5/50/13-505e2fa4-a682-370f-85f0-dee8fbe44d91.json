  "rdfs:comment": {
    "de": [
      "Der Sportparcours in Seillon, nur einen Steinwurf von der Stadt Bourg-en-Bresse entfernt, steht das ganze Jahr über allen offen. So kommen Groß und Klein, unabhängig von ihrer körperlichen Verfassung, auf ihre Kosten."
    ],
    "en": [
      "The Seillon fitness trail, just a stone's throw from Bourg-en-Bresse, is open to everyone, all year round. Something for everyone, whatever their physical condition."
    ],
    "it": [
      "La pista sportiva del Seillon, a due passi da Bourg-en-Bresse, è aperta a tutti tutto l'anno. Ce n'è per tutti i gusti, indipendentemente dal livello di preparazione fisica."
    ],
    "fr": [
      "Le parcours sportif de Seillon, à deux pas de la ville de Bourg-en-Bresse, est ouvert à tous, tout au long de l'année. De quoi ravir petits et grands, peu importe leur condition physique."
    ],
    "es": [
      "La pista deportiva de Seillon, a dos pasos de Bourg-en-Bresse, está abierta a todos durante todo el año. Hay para todos los gustos, sea cual sea su forma física."
    ],
    "nl": [
      "Het sportparcours van Seillon, op een boogscheut van Bourg-en-Bresse, is het hele jaar door toegankelijk voor iedereen. Er is voor elk wat wils, ongeacht het fitnessniveau."
    ]
  },
  "rdfs:label": {
    "en": [
      "Seillon sports trail"
    ],
    "fr": [
      "Parcours sportif de Seillon"
    ]
  },
