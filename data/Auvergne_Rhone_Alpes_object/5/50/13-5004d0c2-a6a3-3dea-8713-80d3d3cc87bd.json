  "rdfs:comment": {
    "de": [
      "Hier brodelt es im Lokal. Ob bei einem Druck am Tresen oder bei einem Glas Wein und einem Aperitifbrett, die Stimmung ist gut."
    ],
    "en": [
      "The place is buzzing. Whether you're enjoying a draught at the counter or a glass of wine and an aperitif board, the atmosphere is just right."
    ],
    "it": [
      "Il locale è in fermento. Che si tratti di una birra alla spina al bar o di un bicchiere di vino e un aperitivo, l'atmosfera è perfetta."
    ],
    "fr": [
      "Ici, le lieu bouillonne. Que ce soit pour une pression au comptoir ou autour d'un verre de vin et d'une planche apéritive, l'ambiance est au rendez-vous."
    ],
    "nl": [
      "Het bruist hier. Of je nu geniet van een biertje aan de bar of van een glas wijn en een aperitief, de sfeer is precies goed."
    ],
    "es": [
      "Es un lugar animado. Tanto si te tomas una cerveza de barril en el bar como una copa de vino y un aperitivo, el ambiente es perfecto."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Michelet Bistrot - Brasserie"
    ]
  },
