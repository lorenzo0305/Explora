  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/3cca0a25-501e-3a86-9190-160389a6cb2c",
      "dc:description": {
        "de": [
          "Machen Sie sich bereit für eine epische Suche nach den Geheimnissen der Ozeane. Unsere Schnitzeljagd zum Thema Meer verspricht einen Nachmittag voller Erkundungen, Rätsel und Entdeckungen\nAnmeldung im Fremdenverkehrsamt erforderlich - Von 14 bis 17 Uhr"
        ],
        "en": [
          "Get ready to embark on an epic quest through the mysteries of the oceans. Our sea-themed hunt promises an afternoon of exploration, enigmas and discovery\nRegistration essential at the Tourist Office - 2pm to 5pm"
        ],
        "it": [
          "Preparatevi a partire per un'epica ricerca attraverso i misteri degli oceani. La nostra caccia a tema marino promette un pomeriggio ricco di esplorazioni, enigmi e scoperte\nIscrizione obbligatoria presso l'Ufficio del Turismo - dalle 14.00 alle 17.00"
        ],
        "fr": [
          "Préparez-vous à embarquer pour une quête épique à travers les mystères des océans. Notre chasse aux sur le thème de la mer vous promet un après-midi rempli d'exploration, d'énigmes et dé découvertes\nInscription indispensable à l'Office de Tourisme - De 14h à 17h"
        ],
        "es": [
          "Prepárese para embarcarse en una búsqueda épica a través de los misterios de los océanos. Nuestra cacería marítima promete una tarde llena de exploración, enigmas y descubrimientos\nImprescindible inscribirse en la Oficina de Turismo - de 14:00 a 17:00 horas"
        ],
        "nl": [
          "Bereid je voor op een epische zoektocht door de mysteries van de oceanen. Onze speurtocht met zeethema belooft een middag vol verkenning, puzzels en ontdekkingen\nAanmelding noodzakelijk bij het VVV-kantoor - 14.00 tot 17.00 uur"
        ]
      },
      "@type": [
        "Description"
      ],
