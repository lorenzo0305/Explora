  "rdfs:comment": {
    "de": [
      "Die Kanu- und Kajakbasis befindet sich am Südufer des Leman-Sees, in einem drei Hektar großen Park und nur wenige Kilometer vom Fluss „la Dranse“ entfernt."
    ],
    "en": [
      "The canoeing and kayaking base is located on the south shore of Lake Leman, in a three-hectare park a few kilometres from the River Dranse."
    ],
    "it": [
      "La base di canoa e kayak si trova sulla sponda meridionale del Lago Lemano, in un parco di tre ettari e a pochi chilometri dal fiume \"la Dranse\"."
    ],
    "fr": [
      "La base de canoë kayak est située sur la rive sud du lac Leman, dans un parc de trois hectares et à quelques kilomètres de la rivière \" la Dranse \"."
    ],
    "es": [
      "La base de canoas y kayaks se encuentra en la orilla sur del lago Leman, en un parque de tres hectáreas y a pocos kilómetros del río \"la Dranse\"."
    ],
    "nl": [
      "De kano- en kajakbasis ligt aan de zuidoever van het Lemmeer, in een park van drie hectare op een paar kilometer van de rivier de Dranse."
    ]
  },
