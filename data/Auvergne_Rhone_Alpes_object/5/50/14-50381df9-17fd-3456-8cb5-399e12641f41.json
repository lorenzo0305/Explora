  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/9e69fea1-c5e5-34a9-b655-64df74c448fb",
      "dc:description": {
        "de": [
          "Schwingen Sie sich zum Klang der Stimme von Laurette GOUBELLE, die Ihnen La Môme vortragen wird?\nEine außergewöhnliche Stimm- und Körpershow!\n\nPreis: 35? pro Person\n\nZahlung und Menüwahl bei der Reservierung"
        ],
        "en": [
          "Come and thrill to the sound of Laurette GOUBELLE's voice as she performs La Môme?\nAn exceptional vocal and physical show!\n\nPrice: 35? per person\n\nPayment and choice of menu on reservation"
        ],
        "it": [
          "Venite a emozionarvi al suono della voce di Laurette GOUBELLE che interpreta La Môme?\nUno spettacolo vocale e fisico eccezionale!\n\nPrezzo: 35? a persona\n\nPagamento e scelta del menu su prenotazione"
        ],
        "fr": [
          "Venez vibrer au son de la voix de Laurette GOUBELLE qui vous interprètera La Môme 🤩\nUn show vocal et physique exceptionnel !\n\nTarif : 35€ par personne\n\nRèglement et choix du menu à la réservation"
        ],
        "es": [
          "Venga a deleitarse con la voz de Laurette GOUBELLE en La Môme?\nUn espectáculo vocal y físico excepcional\n\nPrecio: 35? por persona\n\nPago y elección de menú previa reserva"
        ],
        "nl": [
          "Kom luisteren naar de stem van Laurette GOUBELLE in La Môme?\nEen uitzonderlijke vocale en fysieke show!\n\nPrijs: 35? per persoon\n\nBetaling en menukeuze bij reservering"
        ]
      },
      "@type": [
        "Description"
      ],
