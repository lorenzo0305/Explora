      "dc:description": {
        "de": [
          "Kleine Kirche im Zentrum des Dorfes. Nach dem Ersten Weltkrieg wiederaufgebaut, im romanischen Stil und ohne dekorative Glasmalereien."
        ],
        "en": [
          "Small church located in the center of the village. Rebuilt after the First World War, in Romanesque style and without decorative stained glass."
        ],
        "it": [
          "Piccola chiesa nel centro del paese. Ricostruita dopo la prima guerra mondiale, è in stile romanico e non presenta vetrate decorative."
        ],
        "fr": [
          "Petite église située au centre du village. Reconstruite après la Première Guerre Mondiale, de style roman et sans vitraux décoratifs."
        ],
        "es": [
          "Pequeña iglesia en el centro del pueblo. Reconstruida tras la Primera Guerra Mundial, es de estilo románico y carece de vidrieras decorativas."
        ],
        "nl": [
          "Kleine kerk in het centrum van het dorp. De kerk is na de Eerste Wereldoorlog herbouwd, heeft een romaanse stijl en heeft geen decoratieve glas-in-loodramen."
        ]
