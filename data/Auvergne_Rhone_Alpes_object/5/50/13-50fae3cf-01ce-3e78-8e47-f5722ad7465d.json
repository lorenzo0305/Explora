  "rdfs:comment": {
    "de": [
      "Zwei Minuten vom Stadtzentrum entfernt lädt Sie das Team von La Minute Blonde dazu ein, seine Kellerbar mit prestigeträchtigen Bieren in einem gemütlichen Rahmen zu entdecken."
    ],
    "en": [
      "Two minutes from downtown, the Minute Blonde team invites you to discover its bar-cellar with prestigious beers in a friendly setting."
    ],
    "it": [
      "A due minuti dal centro città, il team di Minute Blonde vi invita a scoprire il suo bar-cantina con birre prestigiose in un ambiente accogliente."
    ],
    "fr": [
      "A deux minutes du centre-ville, l'équipe de la Minute Blonde vous invite à découvrir son bar-cave à bières prestigieuses dans un cadre convivial."
    ],
    "nl": [
      "Op twee minuten van het stadscentrum nodigt het team van Minute Blonde u uit om zijn bar-cellar met prestigieuze bieren in een gezellig kader te ontdekken."
    ],
    "es": [
      "A dos minutos del centro de la ciudad, el equipo de Minute Blonde le invita a descubrir su bar-bodega con prestigiosas cervezas en un ambiente acogedor."
    ]
  },
