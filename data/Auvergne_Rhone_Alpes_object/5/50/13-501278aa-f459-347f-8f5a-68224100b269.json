  "rdfs:comment": {
    "de": [
      "Unter dem Fresko der Crémolans entdecken Sie diesen gemütlichen Ort, an dem Sie sonntags brunchen oder unter der Woche eine mediterrane Küche voller Sonne entdecken können. Besondere Erwähnung verdienen die Cocktails, die Sie unbedingt probieren sollten!"
    ],
    "en": [
      "Beneath the Crémolans fresco, discover this cosy spot where you can brunch on Sundays or discover sun-drenched Mediterranean cuisine during the week. Special mention must go to the cocktails!"
    ],
    "it": [
      "Sotto l'affresco di Crémolans, scoprite questo luogo accogliente dove potrete fare il brunch la domenica o scoprire una cucina mediterranea piena di sole durante la settimana. Una menzione speciale va ai cocktail!"
    ],
    "fr": [
      "Sous la fresque des Crémolans, découvrez cet endroit cosy où vous pourrez bruncher le dimanche ou découvrir une cuisine méditerranéenne pleine de soleil en semaine. Mention spéciale pour les cocktails à découvrir absolument !"
    ],
    "nl": [
      "Ontdek onder de fresco van Crémolans deze gezellige plek waar je op zondag kunt brunchen of doordeweeks een mediterrane keuken vol zon kunt ontdekken. Een speciale vermelding verdienen de cocktails!"
    ],
    "es": [
      "Bajo el fresco de Crémolans, descubra este acogedor lugar donde podrá tomar el brunch los domingos o descubrir una cocina mediterránea llena de sol durante la semana. Mención especial merecen los cócteles"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant la Fresque"
    ]
  },
