  "rdfs:comment": {
    "de": [
      "Ein Kinderreim zum Summen, Geschichten zum Knuspern, ein Moment des Vergnügens, den Sie mit Ihrem Baby teilen können, wenn es seine ersten Schritte in die Welt der Bücher und des Lesens macht."
    ],
    "en": [
      "A rhyme to hum, stories to crunch, a moment of pleasure to share with baby as he takes his first steps into the world of books and reading."
    ],
    "it": [
      "Una filastrocca da canticchiare, storie da masticare, un momento di piacere da condividere con il bambino che muove i primi passi nel mondo dei libri e della lettura."
    ],
    "fr": [
      "Une comptine à fredonner, des histoires à croquer, un moment de plaisir à partager avec bébé pour ses premiers pas dans l'univers du livre et de la lecture."
    ],
    "es": [
      "Una canción infantil para tararear, cuentos para masticar, un momento de placer para compartir con el bebé mientras da sus primeros pasos en el mundo de los libros y la lectura."
    ],
    "nl": [
      "Een kinderrijmpje om te neuriën, verhaaltjes om op te kauwen, een moment van plezier om met baby te delen terwijl hij zijn eerste stapjes zet in de wereld van boeken en lezen."
    ]
  },
  "rdfs:label": {
