  "rdfs:comment": {
    "de": [
      "Höhenrestaurant in Montfrais. Mit hausgemachten Hamburgern, Broten und Paninis finden Sie alle Gerichte eines Imbisses, in dem eine gute Atmosphäre herrscht."
    ],
    "en": [
      "Altitude restaurant located in Montfrais. With hamburgers, sandwiches and paninis houses you will find all the dishes of a snack with the good atmosphere."
    ],
    "it": [
      "Ristorante d'alta quota situato a Montfrais. Con hamburger, panini e panini fatti in casa, troverete tutti i piatti di uno snack bar con una buona atmosfera."
    ],
    "fr": [
      "Restaurant d'altitude situé à Montfrais. Avec des hamburgers, tartines et paninis maisons vous trouverez tous les plats d'un snack où règne la bonne ambiance."
    ],
    "es": [
      "Restaurante de altura situado en Montfrais. Con hamburguesas caseras, sándwiches y paninis, encontrarás todos los platos de un snack bar con buen ambiente."
    ],
    "nl": [
      "Bergestaurant gelegen op de skipistes van Montfrais. Hier worden huisgemaakte hamburgers, belegde broodjes en paninis geserveerd in een ongedwongen sfeer.\r\nKlein chalet met een aangenaam terras op wandelafstand van de gondellift van Montfrais."
    ]
  },
