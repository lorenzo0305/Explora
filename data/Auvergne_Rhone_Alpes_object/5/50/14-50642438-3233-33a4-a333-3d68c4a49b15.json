  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/7235b4ce-fbb6-3ccb-a351-460a454b6d5c",
      "dc:description": {
        "de": [
          "Friseur für Männer und Frauen.\nFür eine gepflegte Frisur, egal ob für Frauen oder Männer, besuchen Sie einen Friseursalon.\nOb für einen besonderen Anlass oder im Alltag, vertrauen Sie Ihr Haar einem erfahrenen Friseur an."
        ],
        "en": [
          "Hairdresser for men and women.\nFor a well-groomed hairstyle, whether for men or women, visit a hair salon.\nWhether it's for a special event or a daily routine, entrust your hair to an experienced hairdresser."
        ],
        "it": [
          "Parrucchiere per uomo e donna.\nPer un'acconciatura curata, sia per le donne che per gli uomini, visitate un parrucchiere.\nChe si tratti di un evento speciale o di un appuntamento quotidiano, affidate i vostri capelli a un parrucchiere esperto."
        ],
        "fr": [
          "Coiffeur hommes et femmes.\nPour une coiffure soignée, que ce soit pour femme ou pour homme, rendez-vous dans un salon de coiffure. \nQue ce soit pour un événement spécial ou au quotidien, confiez vos cheveux à un coiffeur expérimenté."
        ],
        "es": [
          "Peluquería para hombres y mujeres\nPara un peinado cuidado, ya sea para mujeres u hombres, visite una peluquería.\nYa sea para un evento especial o para el día a día, confíe su cabello a un peluquero con experiencia."
        ],
        "nl": [
          "Kapsalon voor mannen en vrouwen.\nVoor een verzorgd kapsel, of het nu voor vrouwen of mannen is, ga je naar een kapsalon.\nOf het nu voor een speciale gebeurtenis is of voor dagelijks gebruik, vertrouw je haar toe aan een ervaren kapper."
        ]
      },
      "@type": [
        "Description"
      ],
