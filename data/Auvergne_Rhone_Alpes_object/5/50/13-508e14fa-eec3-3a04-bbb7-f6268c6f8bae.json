  "rdfs:comment": {
    "de": [
      "Bei Chat Gourmand reimt sich die Küche auf Qualität, Authentizität, Einfallsreichtum und Respekt für die Produkte. Als lokaler Foodtruck sind meine Galettes, Waffeln, süßen und herzhaften Crêpes, Desserts und Gebäck superlecker!"
    ],
    "en": [
      "At Chat Gourmand, our cuisine is synonymous with quality, authenticity, inventiveness and respect for products. A local food truck, my sweet and savory galettes, waffles and crepes, desserts and pastries are super gourmet!"
    ],
    "it": [
      "Allo Chat Gourmand, la nostra cucina è sinonimo di qualità, autenticità, inventiva e rispetto dei prodotti. Un food truck locale, le mie galettes, i waffles e le crêpes dolci e salate, i dessert e i pasticcini sono super gourmet!"
    ],
    "fr": [
      "Chez Chat Gourmand, la cuisine rime avec qualité, authenticité, inventivité  et respect des produits. Food truck local, mes galettes, gaufres et crêpes  salées et sucrées,  desserts et pâtisseries sont super gourmand !"
    ],
    "es": [
      "En Chat Gourmand, nuestra cocina es sinónimo de calidad, autenticidad, inventiva y respeto por los productos. Como food truck local, mis galettes, gofres y crêpes dulces y salados, postres y pasteles son súper gourmet"
    ],
    "nl": [
      "Bij Chat Gourmand staat onze keuken synoniem voor kwaliteit, authenticiteit, inventiviteit en respect voor producten. Als lokale foodtruck zijn mijn galettes, wafels en zoete en hartige crêpes, desserts en gebakjes supergourmet!"
    ]
  },
