  "rdfs:comment": {
    "de": [
      "Der Grundstein wurde am 23. November 1841 von Kardinal Louis-Jacques-Maurice DE BONALD, Bischof von Lyon, gelegt. Ein Wappen am Kreuzungspunkt der Gewölbe des ersten Jochs des Kirchenschiffs gibt 1842 als Datum der Fertigstellung an."
    ],
    "en": [
      "The foundation stone was laid on November 23, 1841, by Cardinal Louis-Jacques-Maurice DE BONALD, Bishop of Lyon. An escutcheon at the crossing of the vaults in the nave's first bay indicates 1842 as the completion date."
    ],
    "it": [
      "La prima pietra fu posta il 23 novembre 1841 dal cardinale Louis-Jacques-Maurice DE BONALD, vescovo di Lione. Uno stemma all'incrocio delle volte nella prima campata della navata centrale indica che i lavori furono completati nel 1842."
    ],
    "fr": [
      "Première pierre posée le 23 novembre 1841, par le Cardinal Louis-Jacques-Maurice DE BONALD, évêque de Lyon. Un écusson à la croisée des voûtes de la première travée de la nef, indique 1842 comme date de fin des travaux."
    ],
    "es": [
      "La primera piedra fue colocada el 23 de noviembre de 1841 por el cardenal Louis-Jacques-Maurice DE BONALD, obispo de Lyon. Un escudo en el cruce de las bóvedas de la primera crujía de la nave indica que las obras se terminaron en 1842."
    ],
    "nl": [
      "De eerste steen werd op 23 november 1841 gelegd door kardinaal Louis-Jacques-Maurice DE BONALD, bisschop van Lyon. Een wapenschild op de kruising van de gewelven in de eerste travee van het schip geeft aan dat het werk in 1842 werd voltooid."
    ]
  },
  "rdfs:label": {
