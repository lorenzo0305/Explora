  "rdfs:comment": {
    "de": [
      "Blesle, das zu den Schönsten Dörfern Frankreichs zählt, ist ein mittelalterliches Juwel in der Haute-Loire, das aus einer weiblichen Benediktinerinnenabtei hervorgegangen ist, die um 880 von Ermengarde von Auvergne, der Mutter Wilhelms des Frommen, gegründet wurde."
    ],
    "en": [
      "Blesle, listed as one of France's Most Beautiful Villages, is a medieval gem in the Haute-Loire region, born of a Benedictine abbey founded around 880 by Ermengarde d'Auvergne, mother of William the Pious."
    ],
    "it": [
      "Blesle, annoverata tra i Borghi più belli di Francia, è un gioiello medievale della regione dell'Alta Loira, nato da un'abbazia benedettina fondata intorno all'880 da Ermengarde d'Auvergne, madre di Guglielmo il Pio."
    ],
    "fr": [
      "Blesle, classé parmi les Plus Beaux Villages de France, est un joyau médiéval de Haute-Loire né d'une abbaye bénédictine féminine fondée vers 880 par Ermengarde d'Auvergne, mère de Guillaume le Pieux."
    ],
    "nl": [
      "Blesle, dat op de lijst van Mooiste Dorpen van Frankrijk staat, is een middeleeuws juweeltje in de Haute-Loire dat is ontstaan uit een benedictijnenabdij die rond 880 werd gesticht door Ermengarde d'Auvergne, de moeder van Willem de Vrome."
    ],
    "es": [
      "Blesle, catalogado como uno de los Pueblos más Bonitos de Francia, es una joya medieval de la región del Alto Loira que surgió de una abadía benedictina fundada hacia el año 880 por Ermengarde de Auvernia, madre de Guillermo el Piadoso."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Blesle, Plus Beau Village de France"
    ]
  },
