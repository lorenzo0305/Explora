  "rdfs:comment": {
    "de": [
      "In der ungewöhnlichen Umgebung eines savoyischen Mazots bietet Les Mas?Hauts authentische savoyische Spezialitäten: Fondues, Raclettes und hausgemachte Desserts. Eine unumgängliche Adresse für Liebhaber von Käse und Bergküche in L'Alpe d'Huez."
    ],
    "en": [
      "In the unusual setting of a Savoyard mazot, Les Mas'Hauts offers authentic Savoyard specialties: fondues, raclettes and homemade desserts. A must for lovers of cheese and mountain cuisine in Alpe d'Huez."
    ],
    "it": [
      "Nell'insolita cornice di un mazot savoiardo, Les Mas?Hauts offre autentiche specialità savoiarde: fondute, raclettes e dessert fatti in casa. Un must per gli amanti del formaggio e della cucina di montagna dell'Alpe d'Huez."
    ],
    "fr": [
      "Dans un cadre insolite de mazot savoyard, Les Mas’Hauts offrent des spécialités savoyardes authentiques : fondues, raclettes et desserts maison. Une adresse incontournable pour les amateurs de fromage et de cuisine montagnarde à l'Alpe d'Huez."
    ],
    "nl": [
      "In de ongewone setting van een Savoyaardse mazot biedt Les Mas'Hauts authentieke Savoyaardse specialiteiten: fondues, raclettes en huisgemaakte desserts. Een must voor liefhebbers van kaas en bergkeuken in Alpe d'Huez."
    ],
    "es": [
      "En el marco insólito de un mazot saboyano, Les Mas?Hauts ofrece auténticas especialidades saboyanas: fondues, raclettes y postres caseros. Una visita obligada para los amantes del queso y la cocina de montaña en Alpe d'Huez."
    ]
  },
