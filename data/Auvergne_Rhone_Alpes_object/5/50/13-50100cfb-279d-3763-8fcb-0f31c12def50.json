  "rdfs:comment": {
    "de": [
      "Sébastien Droulers stammt aus Yzeure und absolvierte sein Bäckerdiplom CAP am CFA in Avermes. Seit 2001 ist er als Bäcker und Konditor in Vallon-en-Sully tätig."
    ],
    "en": [
      "Originally from Yzeure, Sébastien Droulers has been a baker and confectioner in Vallon-en-Sully since 2001, after graduating from the CFA in Avermes."
    ],
    "it": [
      "Originario di Yzeure, Sébastien Droulers ha conseguito la qualifica di panettiere presso il CFA di Avermes e dal 2001 lavora come panettiere e pasticcere a Vallon-en-Sully."
    ],
    "fr": [
      "Originaire d’Yzeure et diplômé du CAP de boulanger au CFA d’Avermes, Sébastien Droulers est installé comme boulanger-pâtissier à Vallon-en-Sully depuis 2001."
    ],
    "nl": [
      "Sébastien Droulers, afkomstig uit Yzeure, heeft zijn bakkersdiploma behaald aan het CFA in Avermes en werkt sinds 2001 als bakker en banketbakker in Vallon-en-Sully."
    ],
    "es": [
      "Originario de Yzeure, Sébastien Droulers obtuvo el título de panadero en el CFA de Avermes y trabaja como panadero y pastelero en Vallon-en-Sully desde 2001."
    ]
  },
  "rdfs:label": {
