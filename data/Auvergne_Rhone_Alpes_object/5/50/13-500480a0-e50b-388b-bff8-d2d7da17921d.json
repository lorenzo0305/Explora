  "rdfs:comment": {
    "de": [
      "Das Le Bressan steht Ihnen seit 1991 zu Diensten und empfängt Sie in einer intimen Atmosphäre. Ob kleine Ausflüge oder große Anlässe, unsere Menüs sind auf jedes Budget abgestimmt."
    ],
    "en": [
      "At your service since 1991, Le Bressan welcomes you in an intimate atmosphere. From small outings to special occasions, our menus are adapted to all budgets."
    ],
    "it": [
      "Al vostro servizio dal 1991, il Bressan vi accoglie in un'atmosfera intima. Per piccole gite o occasioni speciali, i nostri menu si adattano a tutte le tasche."
    ],
    "fr": [
      "A votre service depuis 1991, le Bressan vous accueille dans une ambiance intimiste. Petites sorties comme grandes occasions, nos menus sont adaptés à tous les budgets."
    ],
    "nl": [
      "Tot uw dienst sinds 1991, de Bressan verwelkomt u in een intieme sfeer. Voor kleine uitjes of speciale gelegenheden zijn onze menu's aangepast aan alle budgetten."
    ],
    "es": [
      "A su servicio desde 1991, el Bressan le da la bienvenida en un ambiente íntimo. Para pequeñas salidas u ocasiones especiales, nuestros menús se adaptan a todos los presupuestos."
    ]
  },
