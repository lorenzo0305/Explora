  "rdfs:comment": {
    "de": [
      "Die Büros der Nordic-Skischule von Villard-de-Lans/Corrençon sind während der Wintersaison täglich geöffnet."
    ],
    "en": [
      "The offices of the Nordic Ski School in Villard de Lans/Corrençon are open every day during the winter season."
    ],
    "it": [
      "Gli uffici della scuola di sci nordico di Villard de Lans/Corrençon sono aperti tutti i giorni durante la stagione invernale. Lezioni di sci individuali e di gruppo per adulti e bambini a tutti i livelli, introduzione al biathlon a Corrençon e Villard."
    ],
    "fr": [
      "Les bureaux de l’école de ski nordique Villard de Lans/Corrençon sont ouverts tous les jours pendant la saison d'hiver.Cours de ski individuels,  collectifs, adultes et enfants tous niveaux, initiation au biathlon sur le site de Corrençon et Villard."
    ],
    "es": [
      "Las oficinas de la escuela de esquí nórdico de Villard de Lans/Corrençon están abiertas todos los días durante la temporada de invierno. Clases de esquí individuales y en grupo para adultos y niños de todos los niveles, introducción al biatlón en Corrençon y Villard."
    ],
    "nl": [
      "De kantoren van de Noordse skischool Villard de Lans/Corrençon zijn tijdens het winterseizoen dagelijks geopend. Individuele en groepsskilessen voor volwassenen en kinderen op alle niveaus, kennismaking met biatlon in Corrençon en Villard."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ecole de ski nordique de Villard Corrençon / Accueil Corrençon"
    ]
  },
