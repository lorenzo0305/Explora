  "rdfs:comment": {
    "de": [
      "Genießen Sie auf der blühenden Terrasse oder im Raum mit Holz und freiliegenden Steinen ein süßes Krepp für ein wenig Hunger mit einer guten Schale durstlöschenden Apfelmost oder eine komplette Kreppmahlzeit! Die Speisekarte ist reichhaltig und appetitlich!"
    ],
    "en": [
      "On the flowered terrace or in the room with wood and exposed stones, enjoy a sweet crepe for a little hunger with a good bowl of thirst-quenching cider, or make a complete crepe meal! The menu is rich and appetizing!"
    ],
    "it": [
      "Sulla terrazza fiorita o nella sala con pareti in legno e pietra, gustate una crêpe dolce per un po' di fame con una buona ciotola di sidro dissetante, oppure fate un pasto completo a base di crêpe! Il menu è ampio e appetitoso!"
    ],
    "fr": [
      "Sur la terrasse fleurie ou dans la salle avec bois et pierres apparentes, régalez-vous d'une crêpe sucrée pour une petite faim avec une bonne bolée de cidre désaltérante, ou faite un repas crêpes complet ! La carte est étoffée et appétissante !"
    ],
    "nl": [
      "Geniet op het bloemrijke terras of in de zaal met houten en stenen muren van een zoete crêpe voor de kleine honger met een goede kom dorstlessende cider, of maak een complete crêpe maaltijd! Het menu is uitgebreid en smakelijk!"
    ],
    "es": [
      "En la terraza florida o en la habitación con madera y piedras expuestas, disfrute de un crepe dulce para pasar un poco de hambre con un buen tazón de sidra para saciar la sed, o haga una comida completa de crepe! El menú es rico y apetitoso !"
    ]
  },
