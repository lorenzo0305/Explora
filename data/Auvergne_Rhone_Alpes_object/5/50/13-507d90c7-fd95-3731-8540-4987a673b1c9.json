  "rdfs:comment": {
    "de": [
      "Savoyisches Restaurant am Fuße der Pisten. Wir bieten Ihnen eine Gourmetküche in einer freundlichen Atmosphäre. Südterrasse & Brasserie-Atmosphäre am Mittag, Trost und gemütliche Atmosphäre am Abend nach der Anstrengung."
    ],
    "en": [
      "Savoyard restaurant at the foot of the slopes, offering gourmet cuisine in a friendly atmosphere. South-facing terrace and brasserie atmosphere at lunchtime, comfort and warmth in the evening after a hard day's work."
    ],
    "it": [
      "Ristorante savoiardo ai piedi delle piste, che offre una cucina gourmet in un'atmosfera amichevole. Terrazza esposta a sud e atmosfera da brasserie a pranzo, comfort e calore la sera dopo una dura giornata di lavoro."
    ],
    "fr": [
      "Restaurant Savoyard au pied des pistes, nous vous proposons une cuisine gourmande dans une atmosphère conviviale. Terrasse orientée plein sud & ambiance brasserie le midi, réconfort et ambiance chaleureuse le soir après l'effort."
    ],
    "nl": [
      "Savoyaards restaurant aan de voet van de pistes, met een gastronomische keuken in een gezellige sfeer. Terras op het zuiden en brasseriesfeer tijdens de lunch, comfort en warmte 's avonds na een dag hard werken."
    ],
    "es": [
      "Restaurante saboyano a pie de pistas que ofrece cocina gastronómica en un ambiente acogedor. Terraza orientada al sur y ambiente de brasserie al mediodía, confort y calidez por la noche tras una dura jornada de trabajo."
    ]
  },
