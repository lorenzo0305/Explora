  "rdfs:comment": {
    "de": [
      "Im Hotel Restaurant Million sind Sie immer herzlich willkommen. José De Anacleto und seine Frau Su Chen, die Besitzer dieses großen bürgerlichen Hauses, werden Sie gebührend empfangen, damit Sie sich einfach wie zu Hause fühlen."
    ],
    "en": [
      "26 rooms, 45 beds"
    ],
    "it": [
      "All'hotel Restaurant Million siete sempre i benvenuti. José De Anacleto e sua moglie Su Chen, proprietari di questa grande casa borghese, vi faranno sentire come a casa vostra."
    ],
    "fr": [
      "Vous serez toujours les bienvenus à l'hôtel Restaurant Million. José De Anacleto et sa femme Su Chen, les propriétaires de cette grande maison bourgeoise, sauront vous accueillir comme il se doit pour que vous vous sentiez tout simplement comme chez vous."
    ],
    "nl": [
      "Je bent altijd welkom in het Restaurant Million hotel. José De Anacleto en zijn vrouw Su Chen, de eigenaren van dit statige burgerhuis, zorgen ervoor dat je je meteen thuis voelt."
    ],
    "es": [
      "En el hotel Restaurant Million siempre será bienvenido. José De Anacleto y su esposa Su Chen, los propietarios de esta gran casa burguesa, le harán sentirse como en casa."
    ]
  },
