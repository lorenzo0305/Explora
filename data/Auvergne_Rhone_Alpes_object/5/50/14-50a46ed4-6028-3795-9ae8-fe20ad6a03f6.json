  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/99015c2e-c353-31fa-ac35-926675f97da3",
      "dc:description": {
        "de": [
          "Informationen :\n\nÖffnungszeiten:\nDienstag bis Samstag: 7:15-13 Uhr / 14:30-19 Uhr\nSonntag: 7h15-13h\n\nMontag geschlossen\n \n Bestellung :\nBestellung per Telefon unter 03.27.80.28.53 möglich\n\nAbholung:\nZu den Öffnungszeiten der Bäckerei\n\n "
        ],
        "en": [
          "Information :\n\nOpening days :\nTuesday to Saturday: 7.15am-1pm / 2.30pm-7pm\nSunday: 7h15-13h\n\nClosed on Monday\n \n Ordering :\nOrder by phone 03.27.80.28.53\n\nCollection:\nDuring bakery opening hours\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura :\nDa martedì a sabato: 7.15-13.00 / 14.30-19.00\nDomenica: 7.15-13.00\n\nChiuso il lunedì\n \n Ordini :\nLe ordinazioni possono essere effettuate telefonicamente al numero 03.27.80.28.53\n\nRitiro:\nDurante gli orari di apertura della panetteria\n\n "
        ],
        "fr": [
          "Informations :\n\nJours d'ouverture : \nDu mardi au samedi: 7h15-13h / 14h30-19h\nLe dimanche: 7h15-13h\n\nFermeture le lundi\n \n Commande : \nPossibilité de commander par téléphone au 03.27.80.28.53\n\nRetrait :\nAux horaires d'ouverture de la boulangerie\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen :\nDinsdag tot zaterdag: 7.15u-13u / 14.30u-19u\nZondag: 7.15-1pm\n\nGesloten op maandag\n \n Bestellen :\nBestellingen kunnen telefonisch geplaatst worden op 03.27.80.28.53\n\nAfhalen:\nTijdens de openingsuren van de bakkerij\n\n "
        ],
        "es": [
          "Más información :\n\nDías de apertura :\nDe martes a sábado: 7h15-13h00 / 14h30-19h00\nDomingo: de 7h15 a 13h00\n\nLunes cerrado\n \n Pedidos :\nLos pedidos pueden realizarse por teléfono llamando al 03.27.80.28.53\n\nRecogida:\nDurante el horario de apertura de la panadería\n\n "
        ]
      },
