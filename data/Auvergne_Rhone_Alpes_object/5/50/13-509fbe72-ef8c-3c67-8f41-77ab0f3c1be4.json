  "rdfs:comment": {
    "de": [
      "Traditionelle Restauration, savoyische Spezialitäten, Wild, Pierrade.\r\nGenießen Sie mit Freunden oder der Familie das Panorama bei einem Fondue oder einer Pierrade mit Wildgerichten.\r\nEine Reservierung wird empfohlen\r\nThemenmahlzeiten und Abendveranstaltungen in der Saison/Zwischensaison."
    ],
    "en": [
      "Traditional food, Savoyard specialties, game, pierrade.\r\nWith friends or family, come and enjoy the panorama over a fondue or a pierrade based on game.\r\nReservations recommended.\r\nTheme meals and evenings in season and off-season."
    ],
    "it": [
      "Ristorante tradizionale, specialità savoiarde, selvaggina, pierrade.\r\nCon gli amici o la famiglia, venite a godervi la vista panoramica davanti a una fonduta o a una pierrade a base di selvaggina.\r\nPrenotazione consigliata\r\nCene e serate a tema in stagione/invernale."
    ],
    "fr": [
      "Restauration traditionnelle, spécialités savoyardes, gibiers, pierrade.\r\nEntre amis ou en famille, venez profiter du panorama autour d'une fondue ou d'une pierrade à base de gibiers.\r\nRéservation conseillée\r\nRepas à thème et soirées en saison/intersaison."
    ],
    "nl": [
      "Traditioneel restaurant, Savoyaardse specialiteiten, wild, pierrade.\r\nKom met vrienden of familie genieten van het panoramische uitzicht bij een fondue of een pierrade op basis van wild.\r\nReservering aanbevolen\r\nThemamaaltijden en -avonden in het seizoen en het tussenseizoen."
    ],
    "es": [
      "Restaurante tradicional, especialidades saboyanas, caza, pierrade.\r\nCon amigos o en familia, venga a disfrutar de las vistas panorámicas mientras degusta una fondue o una pierrade de caza.\r\nSe recomienda reservar\r\nComidas y veladas temáticas en temporada/intertemporada."
    ]
  },
