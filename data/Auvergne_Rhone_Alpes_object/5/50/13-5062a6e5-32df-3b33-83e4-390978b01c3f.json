  "rdfs:comment": {
    "de": [
      "Die in Frankreich einzigartige Nationale Sammlung umfasst heute 350 Bäume von 145 verschiedenen Sorten, darunter einige seltene Exemplare. Nutzen Sie vom Touristischen Informationspunkt aus einen kleinen Zwischenstopp, um diese Sammlung zu entdecken."
    ],
    "en": [
      "Unique in France, the National Collection currently comprises 350 trees of 145 different varieties, including some rare specimens. Stop off at the Tourist Information Point to discover this collection."
    ],
    "it": [
      "Unica in Francia, la Collezione Nazionale comprende oggi 350 alberi di 145 varietà diverse, alcuni dei quali sono esemplari rari. Dal punto di informazione turistica, fate una breve pausa per scoprire questa collezione."
    ],
    "fr": [
      "Unique en France, la Collection Nationale comprend aujourd’hui 350 arbres de 145 variétés différentes dont certains spécimens rares. Au départ du Point Information Touristique, profitez d’une petite halte pour découvrir cette collection."
    ],
    "es": [
      "Única en Francia, la Colección Nacional cuenta actualmente con 350 árboles de 145 variedades diferentes, algunas de las cuales son especímenes raros. Desde el Punto de Información Turística, haga una breve pausa para descubrir esta colección."
    ],
    "nl": [
      "De Nationale Collectie is uniek in Frankrijk en omvat nu 350 bomen van 145 verschillende variëteiten, waaronder enkele zeldzame exemplaren. Neem vanaf het Toeristisch Informatie Punt een korte pauze om deze collectie te ontdekken."
    ]
  },
  "rdfs:label": {
    "en": [
      "National collection of Asian cherry blossoms"
    ],
    "fr": [
      "Collection nationale de cerisiers à fleurs d'Asie"
    ]
  },
