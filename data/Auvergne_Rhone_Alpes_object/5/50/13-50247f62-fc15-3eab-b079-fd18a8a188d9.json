  "rdfs:comment": {
    "de": [
      "Eine Kirche und eine königliche Abtei, zwei Stile für einen Architekten: Ernest Mélano. Unter der Kuppel der Pfarrkirche, die in Savoyen einzigartig ist, erzählt die Führerin die mittelalterliche Geschichte von Hautecombe und die Bedingungen seiner Restaurierung im 19."
    ],
    "en": [
      "A church and a royal abbey, 2 styles for one architect: Ernest Mélano. Under the dome of the parish church, the only one of its kind in Savoie, the guide recounts Hautecombe's medieval history and the conditions under which it was restored in the 19th century."
    ],
    "it": [
      "Una chiesa e un'abbazia reale, due stili per un solo architetto: Ernest Mélano. Sotto la cupola della chiesa parrocchiale, unica in Savoia, la guida racconta la storia medievale di Hautecombe e le condizioni del suo restauro nel XIX secolo."
    ],
    "fr": [
      "Une église et une abbaye royale, 2 styles pour un architecte : Ernest Mélano. Sous la coupole de l'église paroissiale, unique en Savoie, la guide retrace l'histoire médiévale de Hautecombe et les conditions de sa restauration au XIXème siècle."
    ],
    "es": [
      "Una iglesia y una abadía real, dos estilos para un mismo arquitecto: Ernest Mélano. Bajo la cúpula de la iglesia parroquial, única en Saboya, el guía relata la historia medieval de Hautecombe y las condiciones de su restauración en el siglo XIX."
    ],
    "nl": [
      "Een kerk en een koninklijke abdij, 2 stijlen voor één architect: Ernest Mélano. Onder de koepel van de parochiekerk, uniek in de Savoie, vertelt de gids over de middeleeuwse geschiedenis van Hautecombe en de omstandigheden van de restauratie in de 19e eeuw."
    ]
  },
