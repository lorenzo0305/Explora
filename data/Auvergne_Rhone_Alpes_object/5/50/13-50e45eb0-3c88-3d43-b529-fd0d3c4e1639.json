  "rdfs:comment": {
    "de": [
      "Handwerkliche Keksfabrik, die Ihnen eine Reihe von süßen und herzhaften Keksen anbietet, darunter eine gluten- und laktosefreie Auswahl, aber auch lokale Produkte wie Schokolade, Konfitüren, Fruchtsäfte und auch eine schöne Auswahl an Tees und Rooibos."
    ],
    "en": [
      "Artisanal cookie factory offering a range of sweet and savoury cookies, including a gluten-free and lactose-free range, as well as local products such as chocolates, jams, fruit juices and a fine range of teas and rooibos."
    ],
    "it": [
      "Un biscottificio tradizionale che offre una gamma di biscotti dolci e salati, oltre a prodotti locali come miele, marmellate, succhi di frutta, torrone e una raffinata selezione di tè e rooibos."
    ],
    "fr": [
      "Biscuiterie artisanale qui vous propose une gamme de biscuits salés et sucrés, mais également des produits locaux tels que miel, confitures, jus de fruits, nougat et aussi une belle gamme de thés et rooibos."
    ],
    "es": [
      "Una fábrica de galletas tradicionales que ofrece una gama de galletas dulces y saladas, así como productos locales como miel, mermeladas, zumos de fruta, turrón y una fina selección de tés y rooibos."
    ],
    "nl": [
      "Een ambachtelijke koekjesfabriek met een assortiment zoete en hartige koekjes, waaronder een glutenvrij en lactosevrij assortiment, en lokale producten zoals chocolade, jam, vruchtensappen en een fijn assortiment thee en rooibos."
    ]
  },
