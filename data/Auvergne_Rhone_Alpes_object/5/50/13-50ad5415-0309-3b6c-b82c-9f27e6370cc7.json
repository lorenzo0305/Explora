  "rdfs:comment": {
    "de": [
      "Bar, Brasserie, Restaurant, Tagesgericht, Snack, Eisdiele, täglich geöffnet (je nach Wetterlage) am Stadtstrand von Publier.  Neu in diesem Jahr 2025: Profitieren Sie von der bioklimatischen Pergola auf der Terrasse am Restaurant!"
    ],
    "en": [
      "Bar, brasserie, restaurant, daily specials, snack bar, ice cream parlour, open every day (weather permitting) on Publier's municipal beach.  New for 2025: enjoy the bioclimatic pergola on the restaurant terrace!"
    ],
    "it": [
      "Bar, brasserie, ristorante, specialità del giorno, snack bar, gelateria, aperti tutti i giorni (tempo permettendo) sulla spiaggia comunale di Publier.  Novità 2025: godetevi la pergola bioclimatica sulla terrazza del ristorante!"
    ],
    "fr": [
      "Bar, brasserie, restaurant, formule plat du jour, snack, glacier, ouvert tous les jours (selon conditions météo) sur la plage municipale de Publier.  Nouveauté cette année 2025 : profitez de la pergola bioclimatique sur la terrasse coté restaurant !"
    ],
    "es": [
      "Bar, brasserie, restaurante, platos del día, snack bar, heladería, abierto todos los días (si el tiempo lo permite) en la playa municipal de Publier.  Novedad 2025: ¡disfrute de la pérgola bioclimática de la terraza del restaurante!"
    ],
    "nl": [
      "Bar, brasserie, restaurant, dagschotels, snackbar, ijssalon, elke dag geopend (als het weer het toelaat) op het gemeentestrand van Publier.  Nieuw in 2025: geniet van de bioklimatologische pergola op het terras van het restaurant!"
    ]
  },
  "rdfs:label": {
