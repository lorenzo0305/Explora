  "rdfs:comment": {
    "de": [
      "LyLyLand ist ein Eiscafé und Teesalon im Herzen des Dorfes. Ein Reich der Süßigkeiten in einem gemütlichen und warmen Raum, in dem alles \"hausgemacht\" ist ...."
    ],
    "en": [
      "LyLyLand is an ice cream shop - tea room, in the heart of the village. A kingdom of sweets in a cosy and warm space where everything is home made ...."
    ],
    "it": [
      "LyLyLand è una gelateria e sala da tè nel cuore del paese. Un regno di dolci in uno spazio accogliente e caldo dove tutto è fatto in casa ...."
    ],
    "fr": [
      "LyLyLand est un glacier - salon de Thé, au cœur du village. Un royaume de douceurs dans un espace cosy et chaleureux où tout est fabriqué \"maison\" ...."
    ],
    "nl": [
      "LyLyLand is een ijssalon en theesalon in het hart van het dorp. Een koninkrijk van zoetigheden in een gezellige en warme ruimte waar alles huisgemaakt is ...."
    ],
    "es": [
      "LyLyLand es una heladería y salón de té en el corazón del pueblo. Un reino de dulces en un espacio acogedor y cálido donde todo es casero ...."
    ]
  },
