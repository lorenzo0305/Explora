  "rdfs:comment": {
    "de": [
      "Geführte Besichtigung ab 5 Personen und Ausstellung über die Bienenzucht. Der Jardin de l'Abeille ist ein Muss für alle Hobby- und Berufsimker sowie für alle, die gute Produkte aus dem Bienenstock lieben."
    ],
    "en": [
      "Guided tour from 5 people and exhibition on beekeeping. The Jardin de l'Abeille is the place to be for all amateur or professional beekeepers as well as for all those who love the good products of the hive."
    ],
    "it": [
      "Visita guidata da 5 persone e mostra sull'apicoltura. Il Giardino delle Api è il luogo ideale per tutti gli apicoltori dilettanti e professionisti e per tutti coloro che amano i buoni prodotti dell'alveare."
    ],
    "fr": [
      "Visite guidée à partir de 5 personnes et exposition sur l'apiculture. Le Jardin de l'Abeille est le lieu incontournable pour tous les apiculteurs amateurs ou professionnels ainsi que pour tous les gourmands des bons produits de la ruche."
    ],
    "es": [
      "Visita guiada a partir de 5 personas y exposición sobre apicultura. El Jardín de las Abejas es el lugar ideal para todos los apicultores aficionados o profesionales, así como para todos los amantes de los buenos productos de la colmena."
    ],
    "nl": [
      "Rondleiding vanaf 5 personen en tentoonstelling over bijenteelt. De Bijentuin is de place to be voor alle amateur- en professionele imkers en voor iedereen die houdt van goede producten uit de bijenkorf."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Jardin de l'Abeille"
    ]
  },
