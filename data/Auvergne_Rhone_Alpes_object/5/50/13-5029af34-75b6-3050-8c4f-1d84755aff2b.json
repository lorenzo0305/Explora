  "rdfs:comment": {
    "de": [
      "Dorf Pébrac: Imposante Gebäude einer ehemaligen Abtei, die 1062 von Pierre de Chavanon gegründet wurde. Kirche aus dem 15. Jahrhundert mit Wandmalereien. Jahrhundert. Schatzkammer von Pébrac, liturgische Gegenstände, Krippe aus polychromem Holz aus dem 15."
    ],
    "en": [
      "Village of Pébrac: Imposing buildings of an ancient abbey founded in 1062 by Pierre de Chavanon. 15th-century church with murals. Pébrac treasure, liturgical objects, 15th-century polychrome wooden crib."
    ],
    "it": [
      "Villaggio di Pébrac: imponenti edifici di un'antica abbazia fondata nel 1062 da Pierre de Chavanon. Chiesa del XV secolo con dipinti murali. Tesoro di Pébrac, oggetti liturgici, culla in legno policromo del XV secolo."
    ],
    "fr": [
      "Village de Pébrac : Bâtiments imposants d’une ancienne abbaye fondée en 1062 par Pierre de Chavanon. Église du XVe siècle avec peintures murales. Trésor de Pébrac, objets liturgiques, crèche en bois polychrome du XVe siècle."
    ],
    "es": [
      "Pueblo de Pébrac: imponentes edificios de una antigua abadía fundada en 1062 por Pierre de Chavanon. Iglesia del siglo XV con pinturas murales. Tesoro de Pébrac, objetos litúrgicos, catre de madera policromada del siglo XV."
    ],
    "nl": [
      "Dorp Pébrac: Imposante gebouwen van een voormalige abdij gesticht in 1062 door Pierre de Chavanon. Kerk uit de 15e eeuw met muurschilderingen. Pébrac schatkamer, liturgische voorwerpen, 15e-eeuws polychroom houten kinderbedje."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Village | Pébrac"
    ]
  },
