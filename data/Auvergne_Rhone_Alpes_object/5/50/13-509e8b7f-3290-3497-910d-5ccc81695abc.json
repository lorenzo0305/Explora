  "rdfs:comment": {
    "de": [
      "Seit 1962 verzaubert die Familie Dematons unsere Geschmacksknospen. Es sind drei Generationen von Fachleuten, die sich in dem Familienunternehmen ablösen. Genießen Sie die hausgemachte französische Küche mit frischen Produkten der Saison."
    ],
    "en": [
      "Since 1962, the Dematons family has been delighting our taste buds. They are 3 generations of professionals, who succeed one another in the family business. You will enjoy a French cuisine, home-made around fresh and seasonal products."
    ],
    "it": [
      "Dal 1962, la famiglia Dematons delizia le nostre papille gustative. Tre generazioni di professionisti si sono succedute nell'azienda di famiglia. Potrete gustare una cucina francese, fatta in casa con prodotti freschi e di stagione."
    ],
    "fr": [
      "Depuis 1962, la Famille Dematons enchante nos papilles. Ce sont 3 générations de professionnels, qui se succèdent au sein de l'entreprise familiale. Vous dégusterez une cuisine française, faite maison autour de produits frais et de saison."
    ],
    "nl": [
      "Sinds 1962 verwent de familie Dematons onze smaakpapillen. Drie generaties professionals hebben elkaar opgevolgd in het familiebedrijf. U zult genieten van een Franse keuken, huisgemaakt rond verse en seizoensgebonden producten."
    ],
    "es": [
      "Desde 1962, la familia Dematons ha estado deleitando nuestras papilas gustativas. Tres generaciones de profesionales se han sucedido en la empresa familiar. Disfrutará de una cocina francesa, elaborada de forma casera en torno a productos frescos y de temporada."
    ]
  },
  "rdfs:label": {
