  "rdfs:comment": {
    "de": [
      "Das Schloss aus dem 13. Jahrhundert liegt 9 km von der A75 entfernt und befindet sich im Herzen des Dorfes Saint-Gervazy. Es gehörte der Familie de Saint-Gervazy und später der Familie d'Oradour. Im Jahr 1986 war das Schloss eine Ruine. Im Jahr 2002 ging es in den Besitz der Gemeinde über."
    ],
    "en": [
      "Located 9 km from the A75, the 13th century castle is in the heart of the village of Saint-Gervazy. It belonged to the family of Saint-Gervazy and then to the family of Oradour. In 1986, the castle was in ruins. It became the property of the municipality in 2002."
    ],
    "it": [
      "Situato a 9 km dalla A75, il castello del XIII secolo si trova nel cuore del villaggio di Saint-Gervazy. Apparteneva alla famiglia Saint-Gervazy e poi alla famiglia Oradour. Nel 1986 il castello era in rovina. Nel 2002 è diventato proprietà del comune."
    ],
    "fr": [
      "Situé à 9 km de l'A75, le château du 13ème siècle est au cœur du village de Saint-Gervazy. Il a appartenu à la famille de Saint-Gervazy puis à la famille d'Oradour. En 1986, le château était en ruine. Il devint propriété de la commune en 2002."
    ],
    "es": [
      "Situado a 9 km de la A75, el castillo del siglo XIII se encuentra en el corazón del pueblo de Saint-Gervazy. Perteneció a la familia Saint-Gervazy y luego a la familia Oradour. En 1986, el castillo estaba en ruinas. Pasó a ser propiedad del municipio en 2002."
    ],
    "nl": [
      "Op 9 km van de A75 ligt het 13e-eeuwse kasteel in het hart van het dorp Saint-Gervazy. Het behoorde toe aan de familie Saint-Gervazy en vervolgens aan de familie Oradour. In 1986 lag het kasteel in puin. Het werd eigendom van de gemeente in 2002."
    ]
  },
