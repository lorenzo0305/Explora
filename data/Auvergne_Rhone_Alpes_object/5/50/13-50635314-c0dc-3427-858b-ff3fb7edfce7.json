  "rdfs:comment": {
    "de": [
      "Handwerkliche Brauerei, aber nicht nur! Dieser Ort der Herstellung\r\nist eine Bar mit geselligem Stil, ein Ort für Weinproben, ein Ort\r\nder von Reisen inspiriert ist. Konzerte und Entspannung gewidmet den Genießern..."
    ],
    "en": [
      "Not just a craft brewery! This production facility\r\nis a convivial bar, a wine-tasting venue and a place inspired\r\ninspired by travel. Concerts and relaxation dedicated to epicureans..."
    ],
    "it": [
      "Birrificio artigianale, ma non solo! Questo luogo di produzione\r\nè un bar dallo stile conviviale, un luogo per la degustazione dei vini, un luogo\r\nispirato al viaggio. Concerti e relax dedicati agli epicurei..."
    ],
    "fr": [
      "Brasserie artisanale, mais pas seulement ! Ce lieu de fabrication\r\nest un bar au style convivial, un lieu de dégustation de vin, un lieu\r\ninspiré par les voyages. Concerts et détente dédié aux épicuriens..."
    ],
    "nl": [
      "Niet zomaar een ambachtelijke brouwerij! Deze plaats van productie\r\nis een gezellige bar, een plek om wijn te proeven, een plek geïnspireerd door\r\ngeïnspireerd door reizen. Concerten en ontspanning gewijd aan levensgenieters..."
    ],
    "es": [
      "Cervecería artesanal, ¡pero no sólo! Este lugar de producción\r\nes un bar de estilo cordial, un lugar de degustación de vinos, un lugar\r\ninspirado en los viajes. Conciertos y relajación dedicados a los epicúreos..."
    ]
  },
  "rdfs:label": {
