  "rdfs:comment": {
    "de": [
      "Das Hotel-Restaurant Le Hauteville** befindet sich gegenüber dem Kino und dem Rathaus, nur wenige Schritte von der Festhalle und dem Casino entfernt."
    ],
    "en": [
      "The hotel-restaurant Le Hauteville** is located opposite the cinema and the town hall, a stone's throw from the village hall and the Casino."
    ],
    "it": [
      "L'hotel-ristorante Le Hauteville** si trova di fronte al cinema e al municipio, a due passi dal municipio e dal Casinò."
    ],
    "fr": [
      "L'hôtel-restaurant Le Hauteville** est situé en face du cinéma et de la Mairie, à deux pas de la salle des fêtes et du Casino."
    ],
    "nl": [
      "Hotel-restaurant Le Hauteville** ligt tegenover de bioscoop en het gemeentehuis, op een steenworp afstand van het dorpshuis en het Casino."
    ],
    "es": [
      "El hotel-restaurante Le Hauteville** está situado frente al cine y el ayuntamiento, a dos pasos del ayuntamiento y el Casino."
    ]
  },
