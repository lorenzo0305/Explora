  "rdfs:comment": {
    "de": [
      "Chaumontet & Co, Bäckermeister seit 1965. Konditor, Feinkosthändler, Café, Kochkurse, Makronen und Pralinen. Entdecken Sie \"Klassische und ideenreiche Rezepte, die Geschmack, Frische und Qualität vereinen...\""
    ],
    "en": [
      "Chaumontet & Co, Master Craftsman since 1965. Pastries, catering, tea room, cookery lessons, macaroon and chocolates. Learn more about \"Classic and inventive recipes combining taste, freshness and high quality.\""
    ],
    "it": [
      "Chaumontet & Co, Maestri artigiani dal 1965. Pasticceria, Drogheria, Sala da tè, Corsi di cucina, Macarons e Cioccolata. Partite alla scoperta di \"Ricette classiche e innovative, che uniscono Sapore, Freschezza e Qualità...\""
    ],
    "fr": [
      "Chaumontet & Co, Maître Artisan depuis 1965. Pâtissier, Traiteur, Salon de thé, Cours de cuisine, Macarons & Chocolats. Partez à la découverte de \"Recettes classiques et inventives, alliant Saveur, Fraîcheur et Qualité...\""
    ],
    "es": [
      "Chaumontet & Co, maestro artesano desde 1965. Pastelero, Catering, Tearoom, Clases de cocina, Macarrones y Chocolates. Descubra \"Recetas clásicas e inventivas, que combinan sabor, frescura y calidad...\""
    ],
    "nl": [
      "Chaumontet & Co, Meesterlijke vakman sinds 1965. Banketbakker, Traiteur, Tearoom, Kooklessen, Macarons & Chocolade. Ontdek \"Klassieke en inventieve recepten, die smaak, versheid en kwaliteit combineren...\""
    ]
