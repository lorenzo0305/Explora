  "rdfs:comment": {
    "de": [
      "In der vom Tageslicht durchfluteten Kletteranlage des Vitam können Sie das Gipfelerklimmen trainieren! 1300 m² Kletterfläche, für alle Stufen, mehr als 160 Kletterrouten, bis zu 14 m Höhe!"
    ],
    "en": [
      "Vitam’s naturally-lit climbing zone will train you up for scaling the heights! A playground for all levels with two bouldering walls, more than 160 routes and reaching a height of 14m!"
    ],
    "it": [
      "L'area di arrampicata Vitam, inondata di luce naturale, vi porterà a nuove altezze! Un parco giochi per tutti i livelli, con 2 aree boulder, oltre 160 percorsi e altezze fino a 14 m!"
    ],
    "fr": [
      "L'espace escalade du Vitam, tout en lumière naturelle, vous entraîne pour atteindre des sommets! Un terrain de jeu pour tous les niveaux, avec 2 espaces bloc, plus de 160 voies et jusqu'à 14m de hauteur !"
    ],
    "nl": [
      "Het klimgebied van Vitam, met zijn natuurlijke licht, brengt u naar de top! Een speeltuin voor alle niveaus, met 2 bouldergebieden, meer dan 160 routes en tot 14m hoog!"
    ],
    "es": [
      "El rocódromo de Vitam, con su iluminación natural, le entrenará para que llegue a cualquier cima. 1300m2 de superficie apta para escalar, para todos los niveles, con más de 160 vías de hasta 14 m de altura."
    ]
  },
