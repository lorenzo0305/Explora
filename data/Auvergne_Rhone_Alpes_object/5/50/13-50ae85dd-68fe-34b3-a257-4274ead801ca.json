  "rdfs:comment": {
    "de": [
      "Oben angekommen liegt hier der schönste Aufstieg zum Puy Griou und Puy Mary über den GR (Fernwanderweg). Nur für Fußgänger."
    ],
    "en": [
      "At Le Lioran resort, the chairlift takes you to the Col de Rombière from the Cirque de Font d'Alagnon. At the chairlift arrival easy access to the foot of the Puy Griou. It also offers you the best access to Puy Mary via the crests (GR4)."
    ],
    "it": [
      "La seggiovia porta al Col de Rombière dal Cirque de Font d'Alagnon. Alla fine della seggiovia, si accede facilmente ai piedi del Puy Griou. Offre inoltre il miglior accesso al Puy Mary, Grand Site de France, attraverso le creste (GR4)."
    ],
    "fr": [
      "Le télésiège permet d'atteindre le Col de Rombière depuis le Cirque de Font d'Alagnon. A l'arrivée du télésiège accès facile au pied du Puy Griou. Il vous offre également le plus bel accès vers le Puy Mary, Grand Site de France, par les crêtes (GR4)."
    ],
    "es": [
      "El telesilla le lleva hasta el Col de Rombière desde el Circo de Font d'Alagnon. Al final del telesilla, se accede fácilmente al pie del Puy Griou. También ofrece el mejor acceso a Puy Mary, Grand Site de France, a través de las crestas (GR4)."
    ],
    "nl": [
      "De stoeltjeslift brengt je naar de Col de Rombière vanaf de Cirque de Font d'Alagnon. Aan het einde van de stoeltjeslift heb je gemakkelijk toegang tot de voet van Puy Griou. Het biedt ook de beste toegang tot Puy Mary, Grand Site de France, via de bergkammen (GR4)."
    ]
  },
  "rdfs:label": {
    "de": [
      "Seilbahn am Rombière"
    ],
    "en": [
      "Rombiere Chairlift"
    ],
    "fr": [
      "Télésiège de Rombière"
    ]
  },
