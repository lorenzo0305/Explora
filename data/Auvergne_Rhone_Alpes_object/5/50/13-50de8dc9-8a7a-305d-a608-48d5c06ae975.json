  "rdfs:comment": {
    "de": [
      "Das Val des Saveurs steht für eine freundliche und familiäre Gastronomie\r\nEntdecken Sie eine schmackhafte Küche rund um Käse und Wurstwaren. Es gibt auch Fondue- und Racletteabende, Käseverkostungen ..\r\nPartyservice."
    ],
    "en": [
      "Le Val des Saveurs is a convivial and family restaurant\r\nDiscover a tasty cuisine through a variation based on cheese and charcuterie. You can also enjoy fondue, raclette and cheese tasting evenings..\r\nCatering service."
    ],
    "it": [
      "Le Val des Saveurs è un ristorante accogliente e familiare\r\nScoprite una cucina gustosa a base di formaggi e salumi. Si tratta anche di serate di fonduta, raclette, degustazione di formaggi..\r\nServizio di catering."
    ],
    "fr": [
      "Le Val des Saveurs, c'est une restauration conviviale et familiale. \r\nDécouvrez une cuisine goûteuse à travers une déclinaison autour du fromage et de la charcuterie. C'est aussi des soirées fondue, raclette, dégustation de fromages ... \r\nService traiteur."
    ],
    "nl": [
      "Le Val des Saveurs is een gezellig familierestaurant\r\nOntdek een smakelijke keuken op basis van kaas en vleeswaren. Het zijn ook fondue-avonden, raclette, kaasproeverijen..\r\nCatering service."
    ],
    "es": [
      "Le Val des Saveurs es un restaurante familiar y acogedor\r\nDescubra una sabrosa cocina basada en el queso y la charcutería. También hay tardes de fondue, raclette, degustación de quesos..\r\nServicio de catering."
    ]
  },
  "rdfs:label": {
