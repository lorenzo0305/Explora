  "rdfs:comment": {
    "de": [
      "Laden mit über 30 Produzenten, die Ihnen frische und saisonale Qualitätsprodukte anbieten: Obst und Gemüse, Ziegen-, Kuh- und Schafskäse, Fruchtsäfte, Bier und Wein. Aber auch Fleisch, Geflügel, Mehl, Honig, Brot, Marmelade..."
    ],
    "en": [
      "30 producers have come together in this shop to offer you their fresh and seasonal quality products : fruit and vegetables, goat, ewe and dairy cheese, soups, fruit juices, beer and wine, flour, honey, jams and also various meats…."
    ],
    "it": [
      "Negozio con oltre 30 produttori che offrono prodotti freschi, stagionali e di qualità: frutta e verdura, formaggi di capra, mucca e pecora, succhi di frutta, birra e vino. Ma anche carne, pollame, farina, miele, pane, marmellate..."
    ],
    "fr": [
      "Magasin de plus de 30 producteurs qui vous proposent des produits de qualité, frais et de saison: fruits et légumes, fromages de chèvre, de vache et de brebis, jus de fruits, bières et vins. Mais aussi viande, volailles, farines, miel, pain, confitures..."
    ],
    "es": [
      "Tienda con más de 30 productores que ofrecen productos frescos, de temporada y de calidad: frutas y verduras, quesos de cabra, vaca y oveja, zumos de frutas, cerveza y vino. Pero también carne, aves, harina, miel, pan, mermeladas..."
    ],
    "nl": [
      "Een winkel met meer dan 30 producenten die verse, seizoensgebonden kwaliteitsproducten aanbieden: fruit en groenten, geiten-, koeien- en schapenkaas, vruchtensappen, bier en wijn. Maar ook vlees, gevogelte, meel, honing, brood, jam..."
    ]
  },
  "rdfs:label": {
    "en": [
      "Le Panier des Saveurs (local products' shop)"
    ],
    "fr": [
      "Le Panier des Saveurs"
    ]
  },
