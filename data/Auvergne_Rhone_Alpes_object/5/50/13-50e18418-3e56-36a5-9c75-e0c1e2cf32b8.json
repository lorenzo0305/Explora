  "rdfs:comment": {
    "de": [
      "Eine Reihe von Produkten auf der Grundlage von Heilpflanzen, die aus Sammlungen und Kulturen stammen, die auf der Suche nach einem Gleichgewicht zwischen Menschen und Pflanzen sind: ätherische Öle, Kräutertees, Sirupe, essbare Blüten..."
    ],
    "en": [
      "A range of herbal products from harvests and crops in search of a balance between men and plants: essential oils, herbal teas, syrups, edible flowers..."
    ],
    "it": [
      "Una gamma di prodotti a base di piante officinali raccolte e coltivate alla ricerca di un equilibrio tra uomo e pianta: oli essenziali, tisane, sciroppi, fiori commestibili..."
    ],
    "fr": [
      "Une gamme de produits à base de plantes médicinales issues de cueillettes et de cultures à la recherche d'un équilibre entre les hommes et les plantes : huiles essentielles, tisanes, sirops, fleurs comestibles..."
    ],
    "es": [
      "Una gama de productos a base de plantas medicinales recolectadas y cultivadas en busca del equilibrio entre el hombre y las plantas: aceites esenciales, infusiones, jarabes, flores comestibles..."
    ],
    "nl": [
      "Een assortiment producten op basis van geneeskrachtige planten die worden geoogst en gekweekt in een zoektocht naar evenwicht tussen mensen en planten: etherische oliën, kruidenthee, siropen, eetbare bloemen..."
    ]
  },
  "rdfs:label": {
