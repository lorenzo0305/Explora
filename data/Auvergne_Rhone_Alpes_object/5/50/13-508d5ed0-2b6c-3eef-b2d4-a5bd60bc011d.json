  "rdfs:comment": {
    "de": [
      "In La Côte-Saint-André gibt es ein reiches Kulturerbe (Halle, Kirche, Schloss, alte Häuser...), das von der Musik von Hector Berlioz und den Farben des Malers Johan Barthold Jongkind geprägt ist. (Rundgang Kulturerbe in der Touristeninformation erhältlich)"
    ],
    "en": [
      "In city center of La Côte-Saint-André, birthplace of Hector Berlioz, the french classical music composer."
    ],
    "it": [
      "La Côte-Saint-André vanta un ricco patrimonio (mercato coperto, chiesa, castello, case antiche, ecc.) impregnato della musica di Hector Berlioz e dei colori del pittore Johan Barthold Jongkind (percorso del patrimonio disponibile presso l'ufficio turistico)"
    ],
    "fr": [
      "A La Côte-Saint-André, un patrimoine riche (Halle, église, château, maisons anciennes...) empreint de la musique d'Hector Berlioz et des couleurs du peintre Johan Barthold Jongkind. (circuit patrimoine disponible en office de tourisme)"
    ],
    "es": [
      "La Côte-Saint-André posee un rico patrimonio (mercado cubierto, iglesia, castillo, casas antiguas, etc.) impregnado de la música de Hector Berlioz y los colores del pintor Johan Barthold Jongkind (ruta del patrimonio disponible en la oficina de turismo)"
    ],
    "nl": [
      "La Côte-Saint-André kan bogen op een rijk erfgoed (overdekte markt, kerk, kasteel, oude huizen, enz.) doordrenkt met de muziek van Hector Berlioz en de kleuren van de schilder Johan Barthold Jongkind (erfgoedroute verkrijgbaar bij het toeristenbureau)"
    ]
  },
