  "rdfs:comment": {
    "de": [
      "Mathilde und Franck Lerouge liegt es am Herzen, mit Ihnen einen geselligen Gourmetmoment in ihrem Restaurant zu teilen. Im Laufe der Jahreszeiten kommen Sie in den Genuss von hochwertigen und frischen Produkten, die streng ausgewählt und perfekt von einem schönen Wein begleitet werden."
    ],
    "en": [
      "Mathilde and Franck Lerouge are eager to share with you a gourmet and convivial moment in their restaurant. As the seasons go by, come and taste quality and fresh products, rigorously selected and perfectly accompanied by a nice vintage wine."
    ],
    "it": [
      "Mathilde e Franck Lerouge sono pronti a condividere con voi un momento gastronomico e conviviale nel loro ristorante. Venite a gustare prodotti freschi e di qualità, rigorosamente selezionati e perfettamente accompagnati da una bella annata."
    ],
    "fr": [
      "Mathilde et Franck Lerouge ont à cœur de partager avec vous un moment gourmand et convivial dans leur restaurant. Au fil des saisons, venez déguster des produits de qualité et frais, rigoureusement sélectionnés et accompagnés parfaitement d’un joli cru."
    ],
    "es": [
      "Mathilde y Franck Lerouge están dispuestos a compartir con usted un momento gastronómico y de convivencia en su restaurante. Venga a degustar productos frescos de calidad, rigurosamente seleccionados y perfectamente acompañados por una buena cosecha."
    ],
    "nl": [
      "Mathilde en Franck Lerouge willen met u een gastronomisch en gezellig moment delen in hun restaurant. Kom in de loop van de seizoenen proeven van verse kwaliteitsproducten, streng geselecteerd en perfect vergezeld van een mooie wijn."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Aux 3 Faisans"
    ]
  },
