  "rdfs:comment": {
    "de": [
      "Der Parking du Saint-Jacques, bietet geräumige, schattige und ständig videoüberwachte Stellplätze, die ideal sind, um Ihr Auto oder Ihren Kastenwagen während eines Aufenthalts in Le Puy oder während Ihrer Wanderung länger zu parken."
    ],
    "en": [
      "Parking du Saint-Jacques offers spacious, shaded parking spaces under constant video surveillance, ideal for prolonged parking of your vehicle or van during a stay in Le Puy or while hiking."
    ],
    "it": [
      "Il parcheggio Saint-Jacques offre piazzole spaziose e ombreggiate, costantemente videosorvegliate, ideali per la sosta prolungata del vostro veicolo o furgone trasformato durante un soggiorno a Le Puy o durante la vostra escursione."
    ],
    "fr": [
      "Le Parking du Saint-Jacques, propose des emplacements spacieux, ombragés et sous surveillance vidéo constante, idéaux pour un stationnement prolongé de votre véhicule ou fourgon aménagé pendant un séjour au Puy ou pendant votre randonnée."
    ],
    "es": [
      "El aparcamiento Saint-Jacques ofrece parcelas amplias y sombreadas bajo vigilancia permanente por vídeo, ideales para el estacionamiento prolongado de su vehículo o furgoneta transformada durante una estancia en Le Puy o durante su excursión."
    ],
    "nl": [
      "De parking Saint-Jacques biedt ruime, schaduwrijke plaatsen onder constant videobewaking, ideaal voor het lang parkeren van je auto of omgebouwde bestelwagen tijdens een verblijf in Le Puy of tijdens je trektocht."
    ]
  },
  "rdfs:label": {
