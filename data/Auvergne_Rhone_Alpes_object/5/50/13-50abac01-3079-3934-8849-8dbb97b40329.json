  "rdfs:comment": {
    "de": [
      "Der Lebensmittelladen von Claveyson bietet Ihnen eine Auswahl an lokalen Produkten und Dienstleistungen für den täglichen Bedarf. Profitieren Sie auch von unserem Bistrobereich, wo Sie Bars und kleine Snacks finden!"
    ],
    "en": [
      "Comptoir de Campagne Claveyson offers you a range of local, short-distance products and local, everyday services. You'll also find a bar and snack bar in our Bistrot area!"
    ],
    "it": [
      "L'épicerie Locale de Claveyson offre una gamma di prodotti locali, a breve distanza e servizi quotidiani. Potete anche approfittare della nostra area Bistro, dove troverete un bar e degli snack!"
    ],
    "fr": [
      "L'épicerie Locale de Claveyson vous propose un panel de produits locaux en circuits-courts et une offre de services de proximité du quotidien. Profitez également de notre espace Bistrot où votre retrouvez une offre bar et petite restauration !"
    ],
    "es": [
      "L'épicerie Locale de Claveyson ofrece una gama de productos locales, de corta distancia y servicios cotidianos. También puede aprovechar nuestra zona Bistro, donde encontrará un bar y tentempiés"
    ],
    "nl": [
      "L'épicerie Locale de Claveyson biedt een assortiment lokale producten, producten voor korte afstanden en dagelijkse diensten. Je kunt ook gebruikmaken van onze Bistro-ruimte, waar je een bar en snacks vindt!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'atelier Du Vie'llage"
    ]
  },
