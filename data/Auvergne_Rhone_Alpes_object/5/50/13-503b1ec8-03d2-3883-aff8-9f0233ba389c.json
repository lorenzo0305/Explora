  "rdfs:comment": {
    "de": [
      "Im Rahmen des Vichy-Vitalitätsprogramms bietet der Racing Club de Vichy Athlétisme kostenlose Schnupperkurse an: Einführung in Nordic Walking.\r\nInformationen und Anmeldung per Telefon."
    ],
    "en": [
      "As part of the Vichy Vitality program, Racing Club de Vichy Athlétisme offers free discovery sessions: introduction to Nordic Walking.\r\nInformation and registration by telephone."
    ],
    "it": [
      "Nell'ambito del programma Vichy Vitality, il Racing Club de Vichy Athlétisme offre sessioni gratuite di introduzione al Nordic Walking.\r\nInformazioni e iscrizioni telefoniche."
    ],
    "fr": [
      "Dans le cadre du programme Vichy Vitalité, Racing Club de Vichy Athlétisme propose des séances gratuites de découverte : initiation à la Marche nordique.\r\nRenseignements et inscription par téléphone."
    ],
    "nl": [
      "In het kader van het vitaliteitsprogramma van Vichy biedt Racing Club de Vichy Athlétisme gratis kennismakingssessies Nordic Walking aan.\r\nInformatie en inschrijving per telefoon."
    ],
    "es": [
      "En el marco del programa Vichy Vitality, el Racing Club de Vichy Athlétisme propone sesiones gratuitas de iniciación a la marcha nórdica.\r\nInformación e inscripciones por teléfono."
    ]
  },
