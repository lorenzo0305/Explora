          "additionalInformation": {
            "de": [
              "Freie Besichtigung des Melkens um 17.30 Uhr (Reservierung per SMS oder Anruf unter 06 33 25 37 43)\r\nBesichtigung des Bauernhofs für Gruppen nach vorheriger Anmeldung.\r\nKäseverkaufsladen geöffnet von Mittwoch 17h-19h, Donnerstag 15h-17h, Samstag 10h-12h und 15h-17h."
            ],
            "en": [
              "Self-guided milking tour at 5:30pm (reservation by SMS or call 06 33 25 37 43)\r\nFarm visits for groups on reservation.\r\nCheese store open Wednesday 5pm-7pm, Thursday 3pm-5pm, Saturday 10am-12pm and 3pm-5pm."
            ],
            "it": [
              "Visita non accompagnata della mungitura alle 17.30 (prenotazioni via SMS o al numero 06 33 25 37 43)\r\nVisite alla fattoria per gruppi su prenotazione.\r\nNegozio di formaggi aperto mercoledì 17.00-19.00, giovedì 15.00-17.00, sabato 10.00-12.00 e 15.00-17.00."
            ],
            "fr": [
              "Visite libre de la traite à 17h30 (réservation par SMS ou appel au 06 33 25 37 43)\r\nVisite de la ferme pour les groupes sur réservation.\r\nMagasin de vente de fromage ouvert de mercredi 17h-19h, jeudi 15h-17h, samedi 10h-12h et 15h-17h."
            ],
            "es": [
              "Visita no acompañada al ordeño a las 17.30 h (reservas por SMS o llamando al 06 33 25 37 43)\r\nVisitas de la granja para grupos previa concertación.\r\nLa quesería abre los miércoles de 17.00 a 19.00 h, los jueves de 15.00 a 17.00 h y los sábados de 10.00 a 12.00 h y de 15.00 a 17.00 h."
            ],
            "nl": [
              "Rondleiding zonder begeleiding bij het melken om 17.30 uur (boekingen per sms of bel 06 33 25 37 43)\r\nRondleidingen op de boerderij voor groepen op afspraak.\r\nKaaswinkel geopend op woensdag 17.00-19.00 uur, donderdag 15.00-17.00 uur, zaterdag 10.00-12.00 uur en 15.00-17.00 uur."
            ]
          },
