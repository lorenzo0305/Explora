  "rdfs:comment": {
    "de": [
      "Kommen Sie und entdecken Sie meine Herde von Alpenziegen und die Etappen der Ziegenkäseherstellung vom Grashalm bis zur Verkostung. Mein Hof liegt auf den Anhöhen von Sugères, wo Sie ein herrliches Panorama genießen können."
    ],
    "en": [
      "Come and discover my herd of alpine goats and the steps involved in making goat cheese from the blade of grass to the tasting. My farm is located on the heights of Sugères where you can enjoy a magnificent panorama."
    ],
    "it": [
      "Venite a scoprire il mio gregge di capre alpine e le fasi di produzione del formaggio di capra, dal filo d'erba alla degustazione. La mia fattoria si trova sulle alture di Sugères, da cui si gode un magnifico panorama."
    ],
    "fr": [
      "Venez découvrir mon troupeau de chèvres alpines et les étapes de fabrication du fromage de chèvre depuis le brin d'herbe jusqu'à la dégustation. Ma ferme est située sur les hauteurs de Sugères où vous pourrez profiter d'un magnifique panorama."
    ],
    "es": [
      "Venga a descubrir mi rebaño de cabras alpinas y las etapas de elaboración del queso de cabra, desde la brizna de hierba hasta la degustación. Mi granja está situada en las alturas de Sugères donde se puede disfrutar de un magnífico panorama."
    ],
    "nl": [
      "Kom en ontdek mijn kudde alpengeiten en de stappen die nodig zijn om geitenkaas te maken, van de grasspriet tot het proeven. Mijn boerderij ligt op de hoogten van Sugères waar u kunt genieten van een prachtig panorama."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La chèvrerie d'Eugénie"
    ]
  },
