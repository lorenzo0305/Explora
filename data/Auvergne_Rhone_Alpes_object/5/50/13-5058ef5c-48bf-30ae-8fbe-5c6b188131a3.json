  "rdfs:comment": {
    "de": [
      "Es ist ein ehemaliges Provinzhaus, das zwischen 1852 und 1854 erbaut wurde und die Büros der Intendanz von Faucigny beherbergte. Nach der Annexion wurde es zur Unterpräfektur."
    ],
    "en": [
      "This is an old provincial house built between 1852 and 1854, housing Faucigny's supplies office.  It became a sub-prefecture after the Annexation."
    ],
    "it": [
      "Questa ex casa provinciale, costruita tra il 1852 e il 1854, ospitava gli uffici dell'Intendenza di Faucigny. Dopo l'annessione divenne una sottoprefettura."
    ],
    "fr": [
      "C’est une ancienne maison provinciale construite entre 1852 et 1854, qui abritait les bureaux de l’Intendance du Faucigny. Elle est devenue sous-préfecture après l’Annexion."
    ],
    "es": [
      "Esta antigua casa provincial, construida entre 1852 y 1854, albergaba las oficinas de la Intendencia de Faucigny. Se convirtió en subprefectura tras la Anexión."
    ],
    "nl": [
      "Dit voormalige provinciehuis, gebouwd tussen 1852 en 1854, huisvestte de kantoren van de Intendance du Faucigny. Na de annexatie werd het een onderprefectuur."
    ]
  },
