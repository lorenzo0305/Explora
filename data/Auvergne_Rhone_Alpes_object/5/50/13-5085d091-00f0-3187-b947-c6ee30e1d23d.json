  "rdfs:comment": {
    "de": [
      "Der Verein \"Le Royans d'Hier et d'Aujourd'hui\" setzt sich für den Schutz des historischen, kulturellen und natürlichen Erbes ein, indem er die Überreste des Kulturerbes der Dörfer von Royans katalogisiert."
    ],
    "en": [
      "The \"Le Royans d'Hier et d'Aujourd'hui\" association is dedicated to preserving the historical, cultural and natural heritage of the Royans villages."
    ],
    "it": [
      "L'associazione \"Le Royans d'Hier et d'Aujourd'hui\" si dedica alla conservazione del patrimonio storico, culturale e naturale dei villaggi Royans."
    ],
    "fr": [
      "L'association \"Le Royans d'Hier et d'Aujourd'hui' s'attache à sauvegarder le patrimoine historique, culturel et naturel en répertoriant les vestiges patrimoniaux des villages du Royans."
    ],
    "es": [
      "La asociación \"Le Royans d'Hier et d'Aujourd'hui\" se dedica a preservar el patrimonio histórico, cultural y natural de los pueblos royanos."
    ],
    "nl": [
      "De vereniging \"Le Royans d'Hier et d'Aujourd'hui\" zet zich in voor het behoud van het historische, culturele en natuurlijke erfgoed van de Royans-dorpen."
    ]
  },
  "rdfs:label": {
