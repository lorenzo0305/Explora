  "rdfs:comment": {
    "de": [
      "Der hinter dem Universitätscampus verborgene Parc de la Charité spricht mit offenem Buch hinter dem Gebäude des ehemaligen Hospizes, das heute zum Universitätscampus von Bourg-en-Bresse gehört."
    ],
    "en": [
      "Hidden behind the university campus, Parc de la Charité is an open book behind the building of the former hospice, now the Bourg-en-Bresse university campus."
    ],
    "it": [
      "Nascosto dietro il campus universitario, il Parc de la Charité è un libro aperto dietro l'edificio dell'ex ospizio che ora è il campus universitario di Bourg-en-Bresse."
    ],
    "fr": [
      "Caché derrière le campus universitaire, le parc de la Charité vous parle à livre ouvert derrière le bâtiment de l’ancien hospice devenu le campus universitaire de Bourg-en-Bresse."
    ],
    "nl": [
      "Verborgen achter de universiteitscampus ligt het Parc de la Charité, een open boek achter het gebouw van het voormalige hospitium dat nu de universiteitscampus van Bourg-en-Bresse is."
    ],
    "es": [
      "Oculto tras el campus universitario, el Parque de la Charité es un libro abierto tras el edificio del antiguo hospicio que hoy es el campus universitario de Bourg-en-Bresse."
    ]
  },
  "rdfs:label": {
