  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/d2745873-484d-3bee-bec9-85b0d9fcd129",
      "dc:description": {
        "de": [
          "Ganz neue Metzgerei in Wailly-Beaucamp eingerichtet\n\nGeöffnet von Dienstag bis Samstag von 8:00 bis 13:00 Uhr und von 15:00 bis 19:00 Uhr.\n\nBestellungen für Weihnachten bis zum 19. Dezember und Neujahr bis zum 26. Dezember möglich"
        ],
        "en": [
          "A brand new butcher's shop in Wailly-Beaucamp\n\nOpen Tuesday to Saturday, 8am to 1pm and 3pm to 7pm.\n\nChristmas orders until December 19 and New Year's orders until December 26"
        ],
        "it": [
          "Una macelleria nuova di zecca a Wailly-Beaucamp\n\nAperta dal martedì al sabato, dalle 8.00 alle 13.00 e dalle 15.00 alle 19.00.\n\nOrdini natalizi possibili fino al 19 dicembre e ordini di Capodanno fino al 26 dicembre"
        ],
        "fr": [
          "Toute nouvelle boucherie installée à Wailly-Beaucamp\n\nOuvert du mardi au samedi de 8h à 13h et de 15h à 19h.\n\nCommandes pour Noël possibles jusqu'au 19 décembre et nouvel-an jusqu'au 26 décembre"
        ],
        "es": [
          "Una nueva carnicería en Wailly-Beaucamp\n\nAbierto de martes a sábado, de 8h a 13h y de 15h a 19h.\n\nPosibilidad de hacer pedidos de Navidad hasta el 19 de diciembre y de Año Nuevo hasta el 26 de diciembre"
        ],
        "nl": [
          "Een gloednieuwe slagerij in Wailly-Beaucamp\n\nOpen van dinsdag tot zaterdag van 8 tot 13 uur en van 15 tot 19 uur.\n\nKerstbestellingen mogelijk tot 19 december en nieuwjaarsbestellingen tot 26 december"
        ]
      },
      "@type": [
        "Description"
      ],
