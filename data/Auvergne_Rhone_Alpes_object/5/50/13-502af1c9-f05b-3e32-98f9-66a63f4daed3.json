  "rdfs:comment": {
    "de": [
      "Das Spiel Clair Obscur: Expedition 33 steht während dieser zwei Wochen der Videospiele im Mittelpunkt. Erfahren Sie mehr über dieses Universum und seinen Platz in der französischen Videospielindustrie."
    ],
    "en": [
      "Clair Obscur: Expedition 33 will be in the spotlight during this fortnight of video games, so come and find out more about this universe and its place in the French video game industry."
    ],
    "it": [
      "Clair Obscur: Expedition 33 è sotto i riflettori durante la Quinzaine des Réalisateurs, quindi venite a scoprire di più su questo universo e sul suo posto nell'industria videoludica francese."
    ],
    "fr": [
      "Le jeu  Clair Obscur : Expedition 33 est à l'honneur lors de cette quinzaine des Jeux vidéo, venez en apprendre plus sur cet univers et sa place dans l'industrie du jeu vidéo français."
    ],
    "nl": [
      "Clair Obscur: Expedition 33 staat in de schijnwerpers tijdens deze Video Games Fortnight, dus kom en ontdek meer over dit universum en zijn plaats in de Franse videogamesindustrie."
    ],
    "es": [
      "Clair Obscur: Expedition 33 será el centro de atención durante esta Quincena de los Videojuegos, así que venga a descubrir más sobre este universo y su lugar en la industria francesa de los videojuegos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Quinzaine des jeux vidéo - Conférence : Il était une fois Clair obscur l'Expedition 33"
    ]
  },
