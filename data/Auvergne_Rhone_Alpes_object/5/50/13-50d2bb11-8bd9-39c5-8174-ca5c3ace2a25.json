  "rdfs:comment": {
    "de": [
      "Der Stausee von La Rosière ist ein ideal angelegtes Gewässer für Familienangeln inmitten der grünen Bergwelt."
    ],
    "ru": [
      "Водохранилище Rosière - идеальное место для семейной рыбалки в самом сердце зеленых гор."
    ],
    "en": [
      "The Rosière reservoir is ideally situated for family fishing in the heart of the green mountains."
    ],
    "it": [
      "Il lago artificiale della Rosière è un luogo ideale per la pesca in famiglia nel cuore delle montagne verdi."
    ],
    "fr": [
      "La retenue de la Rosière est un plan d'eau idéalement aménagé pour une pêche familiale au cœur de la montagne verdoyante."
    ],
    "zh": [
      "罗西埃水库（Rosière）是青山绿水间家庭垂钓的理想场所。"
    ],
    "nl": [
      "Het stuwmeer van Rosière is een ideale plek om met het gezin te vissen in het hart van de groene bergen."
    ],
    "es": [
      "El embalse de la Rosière es un lugar ideal para pescar en familia en el corazón de las verdes montañas."
    ]
  },
  "rdfs:label": {
    "de": [
      "Angelstrecke \"1 Fisch\" auf dem Stausee von La Rosière und dem Bach flussaufwärts"
    ],
    "ru": [
      "Рыболовная тропа \"1 рыба\" на водохранилище Розьер и ручье выше по течению"
    ],
    "en": [
      "1 fish\" fishing course on the Rosière reservoir and upstream stream"
    ],
    "it": [
      "Percorso di pesca \"1 fish\" sul bacino di Rosière e sul torrente a monte"
    ],
    "fr": [
      "Parcours pêche « 1 poisson » sur la retenue de la Rosière et le ruisseau en amont"
    ],
    "zh": [
      "罗西埃水库和上游溪流的 \"1条鱼 \"垂钓道"
    ],
    "es": [
      "Sendero de pesca \"1 pez\" en el embalse de la Rosière y el arroyo aguas arriba"
    ],
    "nl": [
      "1 vis\" visroute op het stuwmeer van Rosière en de stroomopwaarts gelegen beek"
    ]
  },
