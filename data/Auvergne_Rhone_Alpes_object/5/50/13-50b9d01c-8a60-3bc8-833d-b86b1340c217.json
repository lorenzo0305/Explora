  "rdfs:comment": {
    "de": [
      "Lassen Sie sich von der bistronomischen Küche dieses Restaurants zwischen Pont-de-Beauvoisin und St-Genix-sur-Guiers in Savoyen verführen. Der Chefkoch zaubert Ihnen hier das ganze Jahr über eine traditionelle Küche, die mit frischen Produkten aus der Savoyer Region zubereitet wird,"
    ],
    "en": [
      "Let yourself be seduced by the bistronomic cuisine of this restaurant located between Pont-de-Beauvoisin and St-Genix-sur-Guiers, in Savoie. The chef prepares traditional cuisine all year round, using fresh local Savoyard produce,"
    ],
    "it": [
      "Lasciatevi sedurre dalla cucina bistronomica di questo ristorante situato tra Pont-de-Beauvoisin e St-Genix-sur-Guiers, in Savoia. Durante tutto l'anno, lo chef prepara una cucina tradizionale utilizzando prodotti savoiardi freschi e locali,"
    ],
    "fr": [
      "Laissez-vous séduire par la cuisine bistronomique de ce restaurant situé entre Pont-de-Beauvoisin et St-Genix-sur-Guiers, en Savoie. Le chef vous y concocte, toute l'année, une cuisine traditionnelle préparée avec des produits frais du terroir savoyard,"
    ],
    "nl": [
      "Laat je verleiden door de bistronomische keuken van dit restaurant tussen Pont-de-Beauvoisin en St-Genix-sur-Guiers, in de Savoie. Het hele jaar door bereidt de chef traditionele gerechten met verse Savoyaardse streekproducten,"
    ],
    "es": [
      "Déjese seducir por la cocina bistronómica de este restaurante situado entre Pont-de-Beauvoisin y St-Genix-sur-Guiers, en Saboya. Durante todo el año, el chef elabora una cocina tradicional con productos locales frescos de Saboya,"
    ]
  },
  "rdfs:label": {
