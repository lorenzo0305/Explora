  "rdfs:comment": {
    "de": [
      "Delphine entwirft in ihrem Familienatelier in Hauterives feste Seifen und Shampoos, die durch Kaltverseifung von Hand hergestellt werden und aus biologischem Anbau stammen. Besuche der Seifenfabrik sind während der Schulferien über die OT möglich."
    ],
    "en": [
      "Delphine designs solid soaps and shampoos made by cold saponification, by hand, from organic farming in her family workshop in Hauterives. Visits possible in summer."
    ],
    "it": [
      "Delphine crea saponi e shampoo solidi realizzati con saponificazione a freddo, a mano, da agricoltura biologica nel suo laboratorio familiare di Hauterives. Le visite alla fabbrica di sapone sono possibili durante le vacanze scolastiche presso l'Ufficio del Turismo."
    ],
    "fr": [
      "Delphine conçoit des savons et shampoings solides fait par saponification à froid, à la main, issue de l’agriculture biologique dans son atelier familial à Hauterives. Visites de la savonnerie possibles pendant les vacances scolaires sur l'OT."
    ],
    "nl": [
      "Delphine ontwerpt vaste zepen en shampoos die door middel van koude verzeping met de hand worden gemaakt van biologische landbouw in haar familieatelier in Hauterives. Tijdens de schoolvakanties kun je de zeepfabriek bezichtigen bij het VVV-kantoor."
    ],
    "es": [
      "Delphine crea jabones sólidos y champús elaborados por saponificación en frío, a mano, a partir de cultivos ecológicos en su taller familiar de Hauterives. Las visitas a la fábrica de jabón son posibles durante las vacaciones escolares en la Oficina de Turismo."
    ]
  },
