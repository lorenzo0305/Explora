  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/962e0106-580d-3a16-9fee-3d869292e3f2",
      "dc:description": {
        "de": [
          "Informationen :\n\nÖffnungszeiten:\n Montag bis Freitag von 9:00 bis 12:00 Uhr und von 14:00 bis 19:00 Uhr\nSamstags von 9:00 bis 12:00 Uhr\n\nSonntag geschlossen\n\nAbholung:\nZu den Öffnungszeiten der Apotheke\n\n "
        ],
        "en": [
          "Information :\n\nOpening days :\n Monday to Friday, 9am to 12pm and 2pm to 7pm\nSaturday from 9h to 12h\n\nClosed on Sunday\n\nPick-up :\nDuring pharmacy opening hours\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nOrari di apertura :\n Dal lunedì al venerdì, dalle 9.00 alle 12.00 e dalle 14.00 alle 19.00\nSabato dalle 9.00 alle 12.00\n\nChiuso la domenica\n\nRitiro:\nDurante gli orari di apertura della farmacia\n\n "
        ],
        "fr": [
          "Informations :\n\nJours d'ouverture :\n Du lundi au vendredi de 9h à 12h et de 14h à 19h\nLe samedi de 9h à 12h\n\nFermeture le dimanche\n\nRetrait :\nAux horaires d'ouverture de l'officine\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningstijden :\n Maandag tot vrijdag van 9u tot 12u en van 14u tot 19u\nZaterdag van 9 tot 12 uur\n\nZondag gesloten\n\nAfhalen:\nTijdens openingsuren van de apotheek\n\n "
        ],
        "es": [
          "Más información :\n\nHorarios de apertura :\n De lunes a viernes de 9h a 12h y de 14h a 19h\nSábado de 9h a 12h\n\nDomingo cerrado\n\nRecogida:\nDurante el horario de apertura de la farmacia\n\n "
        ]
      },
