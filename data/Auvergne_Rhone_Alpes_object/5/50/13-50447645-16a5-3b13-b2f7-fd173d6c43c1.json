  "rdfs:comment": {
    "de": [
      "Dieser Veranstaltungssaal bietet einen Raum für Kultur, Aufführungen und private Veranstaltungen.\r\nMit versenkbaren Tribünen und einer Kapazität von 224 Sitzplätzen ist er auch ideal für die Organisation von Hochzeiten und anderen Empfängen."
    ],
    "en": [
      "This auditorium offers a space dedicated to culture, shows and private events. With retractable tiers and a seating capacity of 218, it is also ideal for organising weddings and other receptions."
    ],
    "it": [
      "Questo auditorium offre uno spazio dedicato alla cultura, agli spettacoli e agli eventi privati.\r\nCon gradinate retrattili e una capacità di 224 posti a sedere, è ideale anche per l'organizzazione di matrimoni e altri ricevimenti."
    ],
    "fr": [
      "Cette salle de spectacle offre un espace dédié à la culture, aux spectacles et aux événements privés. \r\nDotée de gradins escamotables avec une capacité de 224 places assises, elle est également idéale pour l'organisation de mariages et autres réceptions."
    ],
    "es": [
      "Este auditorio ofrece un espacio dedicado a la cultura, los espectáculos y los eventos privados.\r\nCon gradas retráctiles y un aforo de 224 plazas, también es ideal para organizar bodas y otras recepciones."
    ],
    "nl": [
      "Dit auditorium biedt een ruimte gewijd aan cultuur, voorstellingen en privé-evenementen.\r\nMet uitschuifbare etages en een capaciteit van 224 zitplaatsen is het ook ideaal voor het organiseren van bruiloften en andere recepties."
    ]
  },
