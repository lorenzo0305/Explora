  "rdfs:comment": {
    "de": [
      "Der Zugang ist frei.\r\nEine Zeichnung, ein Foto, ein Originalwerk, eine Stickerei... Lauréna und Christine sind seit 1994 Einrahmerinnen. Sie fertigen Einrahmungen an, bei denen die Werke respektiert, zur Geltung gebracht und bewahrt werden, und kommentieren mit Freude ihren Beruf."
    ],
    "en": [
      "Free access.\r\nA drawing, a photo, an original work, an embroidery... Framers since 1994, Lauréna and Christine have been framing works of art with respect for the works, their enhancement and conservation, and are happy to comment on their profession."
    ],
    "it": [
      "Accesso libero.\r\nUn disegno, una foto, un'opera originale, un ricamo... Corniciaie dal 1994, Lauréna e Christine creano cornici nel rispetto delle opere, della loro valorizzazione e conservazione, e commentano con piacere la loro professione."
    ],
    "fr": [
      "Accès libre.\r\nUn dessin, une photo, une oeuvre originale, une broderie... Encadreurs depuis 1994, Lauréna et Christine réalisent des encadrements dans le respect des œuvres, leur mise en valeur et leur conservation, et commentent avec plaisir leur métier."
    ],
    "nl": [
      "Vrije toegang.\r\nEen tekening, een foto, een origineel werk, een borduurwerk... Lauréna en Christine, lijstenmakers sinds 1994, vervaardigen lijsten met respect voor de werken, hun opwaardering en bewaring, en geven met plezier commentaar op hun beroep."
    ],
    "es": [
      "Acceso gratuito.\r\nUn dibujo, una foto, una obra original, un bordado... Enmarcadoras desde 1994, Lauréna y Christine crean marcos respetando las obras, su puesta en valor y su conservación, y comentan con gusto su profesión."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Atelier d'encadrement Le cadre et vous"
    ]
  },
