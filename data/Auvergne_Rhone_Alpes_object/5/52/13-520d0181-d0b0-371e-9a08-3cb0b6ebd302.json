  "rdfs:comment": {
    "de": [
      "Zumba-Fitness-Kurse für Erwachsene im Tanzsaal des Kulturzentrums, montags von 19:00 bis 20:00 Uhr, geleitet von den Freiwilligen des Büros & donnerstags von 18:45 bis 19:45 Uhr, geleitet von Fabrice Gravillon, Zumba-Instruktor."
    ],
    "en": [
      "Zumba Fitness classes for adults at the Centre Culturel dance hall, Mondays from 7pm to 8pm led by office volunteers & Thursdays from 6.45pm to 7.45pm led by Zumba instructor Fabrice Gravillon."
    ],
    "it": [
      "Corsi di Zumba Fitness per adulti nella sala da ballo del Centre Culturel, il lunedì dalle 19.00 alle 20.00 guidati dai volontari dell'ufficio e il giovedì dalle 18.45 alle 19.45 guidati da Fabrice Gravillon, istruttore di Zumba."
    ],
    "fr": [
      "Cours de Zumba Fitness pour les adultes à la salle de danse du Centre Culturel, les lundis de 19h à 20h animés par les bénévoles du bureau & les jeudis de 18h45 à 19h45 animés par Fabrice Gravillon, instructeur Zumba."
    ],
    "nl": [
      "Zumba Fitness-lessen voor volwassenen in de danszaal van het Cultureel Centrum, op maandag van 19.00 tot 20.00 uur onder leiding van vrijwilligers van het kantoor en op donderdag van 18.45 tot 19.45 uur onder leiding van Fabrice Gravillon, Zumba-instructeur."
    ],
    "es": [
      "Clases de Zumba Fitness para adultos en la sala de baile del Centre Culturel, los lunes de 19.00 a 20.00 horas, dirigidas por voluntarios de la oficina, y los jueves de 18.45 a 19.45 horas, dirigidas por Fabrice Gravillon, instructor de Zumba."
    ]
  },
  "rdfs:label": {
