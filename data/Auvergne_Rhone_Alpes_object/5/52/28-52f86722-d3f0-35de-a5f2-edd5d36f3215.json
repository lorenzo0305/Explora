  "rdfs:comment": {
    "de": [
      "Käserei, Weinkeller und Gästetisch. Eine unumgängliche Adresse in Saint-Valery-sur-Somme für Liebhaber regionaler Käsesorten, begleitet von einem kostenlosen Glas Wein\nEs besteht die Möglichkeit, eine Käse- und/oder Wurstplatte vor Ort zu genießen oder mitzunehmen."
    ],
    "en": [
      "Cheese shop, wine cellar and table d'hôtes. An address not to be missed in Saint-Valery-sur-Somme for the amateurs of regional cheeses accompanied by a glass of wine offered\nPossibility of tasting a cheese and/or charcuterie board on the spot or to take away."
    ],
    "it": [
      "Formaggeria, cantina e table d'hôtes. Un indirizzo da non perdere a Saint-Valery-sur-Somme per gli amanti dei formaggi regionali accompagnati da un bicchiere di vino\nPossibilità di degustare un tagliere di formaggi e/o salumi sul posto o da portare via."
    ],
    "fr": [
      "Fromagerie, cave à vins et table d’hôtes. Une adresse incontournable sur Saint-Valery-sur-Somme pour les amateurs de fromages régionaux accompagné d’un verre de vin offert. \nPossibilité de déguster une planche de fromage et/ou charcuterie sur place ou à emporter."
    ],
    "es": [
      "Tienda de quesos, bodega y table d'hôtes. Una dirección ineludible en Saint-Valery-sur-Somme para los amantes de los quesos regionales acompañados de una copa de vino\nPosibilidad de degustar una tabla de quesos y/o embutidos in situ o para llevar."
    ],
    "nl": [
      "Kaaswinkel, wijnkelder en table d'hôtes. Een niet te missen adres in Saint-Valery-sur-Somme voor liefhebbers van regionale kazen in combinatie met een glas wijn\nMogelijkheid tot het proeven van een kaas- en/of vleeswarenplankje ter plaatse of om mee te nemen."
    ]
  },
