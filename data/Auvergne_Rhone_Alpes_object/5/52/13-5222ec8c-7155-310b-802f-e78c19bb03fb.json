  "rdfs:comment": {
    "de": [
      "Das Restaurant du Vieux Logis, das sich an die Stadtmauern des mittelalterlichen Dorfes Yvoire lehnt, ist ein freundlicher Ort mit familiärem Charakter, in dem Sie unter anderem den Fisch des Genfersees probieren können. Garten und Terrasse."
    ],
    "en": [
      "Leaning against the ramparts of the medieval village of Yvoire, the restaurant du Vieux Logis is a friendly place with a family spirit where you can taste, among other things, the fish of Lake Geneva. Garden and terrace."
    ],
    "it": [
      "Situato contro i bastioni del villaggio medievale di Yvoire, il ristorante Vieux Logis è un ambiente accogliente e familiare dove potrete gustare, tra gli altri piatti, il pesce del lago di Ginevra. Giardino e terrazza."
    ],
    "fr": [
      "Adossé aux remparts du village médiéval d'Yvoire, le restaurant du Vieux Logis est un lieu convivial à l'esprit de famille où vous pourrez déguster entre autres, les poissons du lac Léman. Jardin et terrasse."
    ],
    "nl": [
      "Leunend tegen de stadsmuren van het middeleeuwse dorp Yvoire is het restaurant Vieux Logis een gezellige, gezinsvriendelijke plek waar je onder andere vis uit het meer van Genève kunt proeven. Tuin en terras."
    ],
    "es": [
      "Apoyado en las murallas del pueblo medieval de Yvoire, el restaurante Vieux Logis es un lugar acogedor y familiar donde podrá degustar, entre otros platos, pescado del lago Lemán. Jardín y terraza."
    ]
  },
