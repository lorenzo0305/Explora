      "dc:description": {
        "de": [
          "Große Auswahl an Käse, Joghurt, Sahne, aber auch Lebensmittel und Wein.\n\nZugang für Behinderte, Lieferservice, Haustiere erlaubt."
        ],
        "en": [
          "Wide selection of cheeses, yogurts, creamery, groceries and wines.\n\nPRM access, delivery access, pets allowed."
        ],
        "it": [
          "Ampia scelta di formaggi, yogurt, creme, alimentari e vini.\n\nAccesso PRM, accesso alle consegne, animali ammessi."
        ],
        "fr": [
          "Grand choix de fromage, yaourts, crémerie mais aussi épicerie et vins. \n\nAccès PMR, accès livraison, animaux acceptés."
        ],
        "nl": [
          "Ruime keuze aan kaas, yoghurt, zuivel, kruidenierswaren en wijnen.\n\nToegang voor PRM, bezorging, huisdieren toegestaan."
        ],
        "es": [
          "Amplia selección de quesos, yogures, cremas, comestibles y vinos.\n\nAcceso PMR, acceso a domicilio, se admiten animales."
        ]
      },
