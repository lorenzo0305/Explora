  "rdfs:comment": {
    "de": [
      "Als einziger Kinosaal im Umkreis von 30 km ist La Viouze der wichtigste Ort der Region für kulturelle Unterhaltung. Als großer Saal mit 303 Sitzplätzen bietet La Viouze jede Woche ein abwechslungsreiches Programm, um alle seine Zuschauer zufrieden zu stellen."
    ],
    "en": [
      "The only cinema  within a radius of 30 km, La Viouze is the region's essential place for cultural entertainment. A large hall with 303 seats, La Viouze offers a varied program each week to satisfy all its spectators."
    ],
    "it": [
      "Unico cinema nel raggio di 30 km, La Viouze è il luogo ideale per l'intrattenimento culturale della zona. Con una capacità di 303 posti, La Viouze offre ogni settimana un programma vario per soddisfare tutti gli spettatori."
    ],
    "fr": [
      "Unique salle de cinéma dans un rayon de 30 km, la Viouze est le lieu incontournable de distraction culturelle du territoire. Vaste salle de 303 places, La Viouze propose chaque semaine une programmation variée pour satisfaire tous ses spectateurs."
    ],
    "es": [
      "Único cine en un radio de 30 km, La Viouze es el lugar de entretenimiento cultural de la zona. Con un aforo de 303 plazas, La Viouze ofrece cada semana un programa variado para satisfacer a todos sus espectadores."
    ],
    "nl": [
      "Als enige bioscoop in een straal van 30 km is La Viouze de plaats bij uitstek voor cultureel vermaak in de omgeving. Met een capaciteit van 303 plaatsen biedt La Viouze elke week een gevarieerd programma om alle toeschouwers tevreden te stellen."
    ]
  },
  "rdfs:label": {
