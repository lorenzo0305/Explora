  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/c1aea5cc-41bc-31d0-bfd3-57f8ec221177",
      "dc:description": {
        "de": [
          "Light Painting ist eine moderne Fototechnik, bei der es darum geht, Lichteffekte und Lichtzeichnungen zu erzeugen... Sie werden unglaubliche Lichterlebnisse haben!"
        ],
        "en": [
          "Light painting is a modern photography technique that involves creating lighting effects and light patterns... You're in for an incredible light experience!"
        ],
        "it": [
          "Il light painting è una moderna tecnica fotografica che prevede la creazione di effetti e schemi di luce... Vi aspetta un'incredibile esperienza di luce!"
        ],
        "fr": [
          "Le light painting est une technique de photographie moderne qui consiste à réaliser des effets d'éclairages et dessins de lumières. Vous allez vivre d’incroyables expériences lumineuses !"
        ],
        "nl": [
          "Lichtschilderen is een moderne fotografietechniek waarbij lichteffecten en lichtpatronen worden gecreëerd... Je bent in voor een ongelooflijke lichtervaring!"
        ],
        "es": [
          "El light painting es una técnica fotográfica moderna que consiste en crear efectos y patrones de luz... ¡Una experiencia lumínica increíble!"
        ]
      },
