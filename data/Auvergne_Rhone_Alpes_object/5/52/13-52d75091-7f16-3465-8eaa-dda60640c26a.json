  "rdfs:comment": {
    "de": [
      "Mountainbike-Zentrum Espace Revermont mit dem Gütesiegel der Fédération Française Vélo.\r\nTreffpunkt im Herzen der Berge des Revermont.\r\n26 Rundwege, 6 markierte Verbindungen von 4 bis 32 km. - 650 km markierte Strecke"
    ],
    "en": [
      "Espace Revermont mountain-biking base, accredited by the Fédération Française Vélo.\r\nRendezvous in the heart of the Revermont mountains.\r\n26 circuits, 6 marked trails from 4 to 32 km. - 650 km of marked trails"
    ],
    "it": [
      "Base per mountain bike Espace Revermont, accreditata dalla Federazione ciclistica francese.\r\nAppuntamento nel cuore delle montagne di Revermont.\r\n26 circuiti, 6 percorsi segnalati da 4 a 32 km. - 650 km di sentieri segnalati"
    ],
    "fr": [
      "Base VTT Espace Revermont labélisée Fédération Française Vélo.\r\nRendez-vous, au cœur des montagnes du Revermont.\r\n26 circuits, 6 liaisons balisées de 4 à 32 km. - 650 km balisés"
    ],
    "nl": [
      "Espace Revermont mountainbikebasis, erkend door de Franse wielerbond.\r\nAfspraak in het hart van de bergen van Revermont.\r\n26 circuits, 6 bewegwijzerde routes van 4 tot 32 km. - 650 km bewegwijzerde paden"
    ],
    "es": [
      "Base BTT Espace Revermont, acreditada por la Federación Francesa de Ciclismo.\r\nCita en el corazón de las montañas de Revermont.\r\n26 circuitos, 6 recorridos señalizados de 4 a 32 km. - 650 km de senderos balizados"
    ]
  },
  "rdfs:label": {
    "en": [
      "Espace Revermont mountain bike base"
    ],
    "fr": [
      "Base VTT Espace Revermont"
    ]
  },
