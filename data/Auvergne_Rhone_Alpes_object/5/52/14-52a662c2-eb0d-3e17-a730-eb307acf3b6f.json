  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/08f6e1d4-9e8e-3176-bb02-91b1bbc3ac2a",
      "dc:description": {
        "de": [
          "Die Comédie de Béthune, Centre Dramatique National Nord-Pas de Calais, ist ein kreatives Theater, das Theaterstücke produziert und empfängt, aber auch Zirkus- und Marionettenvorstellungen... Die Comédie de Béthune hat zwei Spielstätten: Le Palace, 138 rue du 11 Novembre und das Studio-Théâtre, Place Foch in Béthune."
        ],
        "en": [
          "The Comédie de Béthune, Centre Dramatique National Nord-Pas de Calais, is a creative theatre that produces and hosts theatre, circus and puppet shows. The Comédie de Béthune has two venues: the Palace, 138 rue du 11 Novembre and the Studio-Théâtre, place Foch in Béthune."
        ],
        "it": [
          "La Comédie de Béthune, Centre Dramatique National Nord-Pas de Calais, è un teatro creativo che produce e ospita spettacoli teatrali, circensi e di marionette... La Comédie de Béthune ha due sedi: il Palace, 138 rue du 11 Novembre e lo Studio-Théâtre, place Foch a Béthune."
        ],
        "fr": [
          "La Comédie de Béthune, Centre Dramatique National Nord-Pas de Calais est un théâtre de création qui produit et accueille des spectacles de théâtre mais aussi de cirque, de marionnettes... La Comédie de Béthune possède deux lieux d'expression : le Palace, 138 rue du 11 Novembre et le Studio-Théâtre, place Foch à Béthune."
        ],
        "nl": [
          "La Comédie de Béthune, Centre Dramatique National Nord-Pas de Calais, is een creatief theater dat theater-, circus- en poppenvoorstellingen produceert en organiseert... De Comédie de Béthune heeft twee zalen: het Palace, 138 rue du 11 Novembre en de Studio-Théâtre, place Foch in Béthune."
        ],
        "es": [
          "La Comédie de Béthune, Centre Dramatique National Nord-Pas de Calais, es un teatro de creación que produce y acoge espectáculos de teatro, circo y marionetas... La Comédie de Béthune tiene dos sedes: el Palace, 138 rue du 11 Novembre y el Studio-Théâtre, place Foch en Béthune."
        ]
      },
