  "rdfs:comment": {
    "de": [
      "Entdecken Sie den Teesalon & Dekoration Romain Bertrand in Saint-Geneys-près-Saint-Paulien. Ein märchenhafter Ort, an dem das Ambiente der Belle Epoque auf eine naturbelassene und romantische Einrichtung trifft."
    ],
    "en": [
      "Discover the Romain Bertrand Tearoom in Saint-Geneys-près-Saint-Paulien. A magical place where Belle Epoque meets nature and romance."
    ],
    "it": [
      "Scoprite la sala da tè e l'arredamento Romain Bertrand a Saint-Geneys-près-Saint-Paulien. Un luogo magico dove l'atmosfera della Belle Epoque incontra un ambiente naturale e romantico."
    ],
    "fr": [
      "Découvrez le Salon de thé & décoration Romain Bertrand à Saint-Geneys-près-Saint-Paulien. Un lieu féerique où l'ambiance Belle Epoque rencontre un décor nature et romantique."
    ],
    "nl": [
      "Ontdek de tearoom en het decor van Romain Bertrand in Saint-Geneys-près-Saint-Paulien. Een magische plek waar de Belle Epoque sfeer samenkomt met een natuurlijke, romantische omgeving."
    ],
    "es": [
      "Descubra el salón de té y decoración Romain Bertrand en Saint-Geneys-près-Saint-Paulien. Un lugar mágico donde el ambiente de la Belle Epoque se encuentra con un entorno natural y romántico."
    ]
  },
