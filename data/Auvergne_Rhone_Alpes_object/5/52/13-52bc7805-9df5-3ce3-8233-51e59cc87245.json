  "rdfs:comment": {
    "de": [
      "Lassen Sie sich auf dem größten Outdoor-Lasertag-Gelände der Loire fallen. Hier treffen Sie sich mit Freunden oder der Familie auf 17.000 m2 Spielfläche, um einen Moment voller Emotionen zu erleben."
    ],
    "en": [
      "Let loose on the Loire's largest outdoor laser tag course. Here, you'll find 17,000 m2 of games to enjoy with friends or family."
    ],
    "it": [
      "Scatenatevi nel più grande campo di laser tag all'aperto della Loira. Qui potrete riunirvi con gli amici o la famiglia su una superficie di 17.000 m2 di giochi per un momento emozionante."
    ],
    "fr": [
      "Lâchez prise sur le plus grand terrain de laser tag en extérieur de la Loire. Ici, vous vous retrouvez entre amis ou en famille sur 17 000 m2 de jeux pour un moment riche en émotions."
    ],
    "es": [
      "Libérese en el mayor circuito de láser tag al aire libre del Loira. Aquí podrá reunirse con amigos o familiares en 17.000 m2 de juegos para pasar un rato emocionante."
    ],
    "nl": [
      "Leef je uit op het grootste outdoor lasergame parcours van de Loire. Hier kun je met vrienden of familie op 17.000 m2 spelen voor een spannende tijd."
    ]
  },
