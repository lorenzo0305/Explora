  "rdfs:comment": {
    "de": [
      "Eine schwindelerregende Erfahrung, die Sie unbedingt ausprobieren sollten! In die Wand eingelassene Sprossen, eine nepalesische Brücke, eine Affenbrücke, 2 Seilrutschen (Umleitung möglich, wenn Sie die Seilrutschen nicht nehmen wollen)."
    ],
    "en": [
      "A vertiginous experience worth trying out! Bars set into the wall, a Nepalese bridge, a monkey bridge, 2 zip lines (you can deviate if you don't want to take the zip lines)."
    ],
    "it": [
      "Un'esperienza vertiginosa che vale la pena provare! Barre incastonate nella parete, un ponte nepalese, un ponte delle scimmie, 2 teleferiche (si può deviare se non si vuole fare la teleferica)."
    ],
    "fr": [
      "Une expérience vertigineuse à tester ! Barreaux scellés dans la paroi, un pont népalais, un pont de singe, 2 tyroliennes (déviation possible pour ne pas prendre les tyroliennes)."
    ],
    "es": [
      "Una experiencia vertiginosa que merece la pena probar Barras empotradas en la pared, un puente nepalí, un puente de monos, 2 tirolinas (puedes desviarte si no quieres coger las tirolinas)."
    ],
    "nl": [
      "Een duizelingwekkende ervaring die het proberen waard is! Tralies in de muur, een Nepalese brug, een apenbrug, 2 tokkelbanen (je kunt afwijken als je de tokkelbanen niet wilt nemen)."
    ]
  },
  "rdfs:label": {
    "en": [
      "Via Ferrata of the gorges d'Ambin"
    ],
    "fr": [
      "Via Ferrata des gorges d'Ambin"
    ],
    "nl": [
      "Via Ferrata van de kloven van Ambin"
    ]
  },
