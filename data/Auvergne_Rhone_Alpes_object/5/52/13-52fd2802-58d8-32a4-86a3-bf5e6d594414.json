  "rdfs:comment": {
    "de": [
      "Essbereich in der Boutique von Les Délices d'Alpage. Zu Ihrer Verfügung stehen 2 Mikrowellen, um die im Laden gekauften hausgemachten Gerichte aufzuwärmen.\r\nTische auf den Terrassen empfangen Sie unter der Sonne von Châtillon!"
    ],
    "en": [
      "Catering area in the Délices d'Alpage store. 2 microwaves for reheating homemade dishes bought in the store.\r\nTerrace tables welcome you under the Châtillon sun!"
    ],
    "it": [
      "Area catering nel negozio Délices d'Alpage. Sono disponibili 2 microonde per riscaldare i piatti fatti in casa acquistati nel negozio.\r\nI tavoli della terrazza vi accolgono sotto il sole di Châtillon!"
    ],
    "fr": [
      "Espace de restauration dans la boutique des Délices d'Alpage. A votre disposition 2 micro-ondes pour réchauffer les plats fait maison achetés à la boutique.\r\nDes tables en terrasses vous accueilleront sous le soleil de Châtillon !"
    ],
    "es": [
      "Zona de restauración en la tienda Délices d'Alpage. 2 microondas a su disposición para recalentar los platos caseros comprados en la tienda.\r\nLas mesas de la terraza le dan la bienvenida bajo el sol de Châtillon"
    ],
    "nl": [
      "Cateringruimte in de winkel Délices d'Alpage. Er zijn 2 magnetrons beschikbaar om zelfgemaakte gerechten uit de winkel op te warmen.\r\nTerrastafels verwelkomen je onder de Châtillon zon!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Snack/Bar des Délices d'Alpage"
    ]
  },
