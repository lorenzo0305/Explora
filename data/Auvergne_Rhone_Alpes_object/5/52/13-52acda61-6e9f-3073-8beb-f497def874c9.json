  "rdfs:comment": {
    "de": [
      "Weinbaugebiet im Süden der Ardèche, Herstellung von Weinen aus Côtes du Vivarais und Chatus, der emblematischen Rebsorte des Piemonts der Cevennen.\r\nProduktion von Weinen. Ein Weinberg mit innovativen Praktiken.\r\nGerne erzähle ich Ihnen von den Geheimnissen der Produktion !"
    ],
    "en": [
      "Vineyards in the southern Ardèche, producing Côtes du Vivarais and Chatus wines, the emblematic grape variety of the Cévennes foothills.\r\nWine production. A vineyard with innovative practices.\r\nI'd be delighted to tell you all about the secrets of wine production !"
    ],
    "it": [
      "Vigneti nell'Ardèche meridionale che producono vini Côtes du Vivarais e Chatus, il vitigno emblematico delle Prealpi Cévennes.\r\nRaccolta a mano, produzione biologica\r\nSarò lieto di raccontarvi tutti i segreti della nostra produzione!"
    ],
    "fr": [
      "Vignoble du sud Ardèche, production de vins en Côtes du Vivarais et Chatus, cépage emblématique du piémont cévenol.\r\nProduction en Agriculture Biologique en vendanges manuelle\r\nC'est avec plaisir que je vous parlerai des secrets de la production !"
    ],
    "nl": [
      "Wijngaarden in de zuidelijke Ardèche die Côtes du Vivarais en Chatus-wijnen produceren, de emblematische druivensoort van de uitlopers van de Cevennen.\r\nWijnproductie. Een wijngaard met innovatieve praktijken.\r\nIk vertel je graag alles over de geheimen van de wijnproductie !"
    ],
    "es": [
      "Viñedos en el sur de Ardèche, que producen vinos Côtes du Vivarais y Chatus, la variedad de uva emblemática de las estribaciones de Cévennes.\r\nVendimia manual, producción ecológica\r\nEstaré encantado de contarle todos los secretos de nuestra producción"
    ]
  },
