  "rdfs:comment": {
    "de": [
      "Swing, Essen, Tapas und Geselligkeit: das perfekte Rezept für Ihre Tage und Abende.\r\nMittagessen (außer dienstags und mittwochs) und Tapas am Abend rund um die Bar mit ihren Spielen (Billard, Tischfußball, Darts... )\r\nDenken Sie an eine Reservierung!"
    ],
    "en": [
      "Swing dancing, food, tapas, and a friendly atmosphere: the perfect recipe for your days and evenings. Lunch is served (except Tuesdays and Wednesdays), and tapas are available in the evenings around the bar with its games (pool, foosball, darts, etc.). Reservations are recommended!"
    ],
    "it": [
      "Swing, cibo, tapas e convivialità: la ricetta perfetta per la vostra giornata o serata.\r\nRistorazione a pranzo (tranne il martedì e il mercoledì) e tapas la sera intorno al bar con i suoi giochi (biliardo, baby, freccette, ecc.)\r\nNon dimenticate di prenotare!"
    ],
    "fr": [
      "Swing, restauration, tapas et convivialité : la recette parfaite pour vos journées et soirées.\r\nRestauration le midi (sauf mardi et mercredi) et tapas le soir autour du bar avec ses jeux (billard, baby, fléchettes... )\r\nPensez à réserver !"
    ],
    "nl": [
      "Swing, eten, tapas en gezelligheid: het perfecte recept voor je dag of avond.\r\nCatering tijdens de lunch (behalve dinsdag en woensdag) en tapas 's avonds rond de bar met spelletjes (biljart, baby, darts, enz.)\r\nVergeet niet te reserveren!"
    ],
    "es": [
      "Swing, comida, tapas y convivencia: la receta perfecta para su día o su noche.\r\nRestauración al mediodía (excepto martes y miércoles) y tapas por la noche en torno al bar con sus juegos (billar, baby, dardos, etc.)\r\n¡No olvide reservar!"
    ]
  },
  "rdfs:label": {
