  "rdfs:comment": {
    "de": [
      "Juliénas bietet einen einzigartigen Rahmen für die Verkostung seines Weinkellers: eine 1868 entweihte Kirche. An diesem einzigartigen Ort können Sie den Cru Juliénas, seine Geschichte, seinen Wein und sein Terroir entdecken. Unumgänglich, um das Beaujolais zu entdecken oder ein Glas zu trinken."
    ],
    "en": [
      "Juliénas offers a unique tasting setting for its cellar: a church deconsecrated in 1868. In this unique location, come and discover the Juliénas Cru, its history, its wine, and its terroir. A must-see for anyone wanting to discover Beaujolais or simply enjoy a glass."
    ],
    "it": [
      "Juliénas offre un ambiente di degustazione unico per la sua cantina: una chiesa dismessa nel 1868. Venite a scoprire il Cru Juliénas, la sua storia, il suo vino e il suo terroir in questo ambiente unico. Un'occasione imperdibile per scoprire la regione del Beaujolais o semplicemente per bere qualcosa."
    ],
    "fr": [
      "Juliénas offre un cadre de dégustation unique pour son caveau : une église désaffectée en 1868. Dans ce lieu unique, venez découvrir le Cru Juliénas, son histoire, son vin, son terroir. Incontournable pour découvrir le Beaujolais ou boire un verre."
    ],
    "es": [
      "Juliénas ofrece un entorno de degustación único para su bodega: una iglesia en desuso de 1868. Venga a descubrir Cru Juliénas, su historia, su vino y su terruño en este marco único. Una visita obligada si desea descubrir la región del Beaujolais o simplemente tomar una copa."
    ],
    "nl": [
      "Juliénas biedt een unieke proefomgeving voor zijn kelder: een kerk die in 1868 buiten gebruik werd gesteld. Kom en ontdek de Cru Juliénas, zijn geschiedenis, zijn wijn en zijn terroir in deze unieke omgeving. Een must als je de Beaujolais wilt ontdekken of gewoon een glaasje wilt drinken."
    ]
  },
  "rdfs:label": {
    "en": [
      "Le Cellier de la Vieille Eglise, wine cellar and former church"
    ],
    "fr": [
      "Le Cellier de la Vieille Eglise"
    ]
  },
