  "rdfs:comment": {
    "de": [
      "Die Galerie Saint-Paul präsentiert eine Ausstellung von Vincent Alran, einem Maler, dessen farbenfrohes und poetisches Universum über die Grenzen Frankreichs hinaus begeistert hat. Der Künstler lädt Sie mit seinen Werken zu einem sensiblen Spaziergang ein, der von Lyrik und Menschlichkeit geprägt ist."
    ],
    "en": [
      "Galerie Saint-Paul presents an exhibition by Vincent Alran, a painter whose colorful, poetic universe has seduced audiences beyond France?s borders. Through his work, the artist invites you on a sensitive journey, imbued with lyricism and humanity."
    ],
    "it": [
      "La Galerie Saint-Paul presenta una mostra di Vincent Alran, un pittore il cui mondo colorato e poetico gli ha fatto guadagnare consensi oltre i confini della Francia. Attraverso le sue opere, l'artista invita a fare una passeggiata sensibile, intrisa di lirismo e umanità."
    ],
    "fr": [
      "La Galerie Saint-Paul présente une exposition de Vincent Alran, peintre dont l’univers coloré et poétique a su séduire au-delà des frontières hexagonales. L’artiste vous invite par son œuvre à une déambulation sensible, empreinte de lyrisme et d’humanité."
    ],
    "es": [
      "La Galería Saint-Paul presenta una exposición de Vincent Alran, pintor cuyo universo colorista y poético le ha valido el reconocimiento más allá de las fronteras francesas. A través de su obra, el artista invita a un paseo sensible, impregnado de lirismo y humanidad."
    ],
    "nl": [
      "Galerie Saint-Paul presenteert een tentoonstelling van Vincent Alran, een schilder wiens kleurrijke, poëtische wereld hem ook buiten Frankrijk bekendheid heeft gegeven. Met zijn werk nodigt de kunstenaar u uit voor een gevoelige wandeling, doordrenkt van lyriek en menselijkheid."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Exposition : Vincent Alran - une exposition en prélude au festival « Les Musicades »"
    ]
  },
