  "rdfs:comment": {
    "de": [
      "Das Restaurant Seven Spices in Viuz-en-Sallaz bietet eine Küche mit würzigen und vielfältigen Aromen, die von kulinarischen Traditionen inspiriert ist, die reich an Düften und Farben sind."
    ],
    "en": [
      "The Seven Spices restaurant in Viuz-en-Sallaz offers spicy and varied cuisine inspired by culinary traditions rich in flavors and colors."
    ],
    "it": [
      "Il ristorante Seven Spices di Viuz-en-Sallaz offre una cucina speziata e varia, ispirata a tradizioni culinarie ricche di sapori e colori."
    ],
    "fr": [
      "Le restaurant Seven Spices à Viuz-en-Sallaz propose une cuisine aux saveurs épicées et variées, inspirée de traditions culinaires riches en parfums et en couleurs."
    ],
    "nl": [
      "Het restaurant Seven Spices in Viuz-en-Sallaz biedt een pittige, gevarieerde keuken geïnspireerd door culinaire tradities rijk aan smaak en kleur."
    ],
    "es": [
      "El restaurante Siete Especias de Viuz-en-Sallaz ofrece una cocina picante y variada inspirada en tradiciones culinarias ricas en sabor y color."
    ]
