  "rdfs:comment": {
    "de": [
      "Diese zentrale Anlaufstelle vereint bürgernahe, moderne und leicht zugängliche öffentliche Dienstleistungen an ein und demselben Ort.....\r\nNach Terminvereinbarung, Montag bis Freitag, 9:00 - 12:00 und 13:30 - 17:00 Uhr (Mittwochmorgen geschlossen)"
    ],
    "en": [
      "This one-stop shop brings together modern, accessible local public services....\r\nBy appointment, Monday to Friday, 9am - 12pm and 1:30pm - 5pm (closed Wednesday morning)"
    ],
    "it": [
      "Questo sportello unico riunisce servizi pubblici locali moderni e accessibili in un unico luogo....\r\nSu appuntamento, dal lunedì al venerdì, dalle 9.00 alle 12.00 e dalle 13.30 alle 17.00 (chiuso il mercoledì mattina)"
    ],
    "fr": [
      "Ce guichet unique regroupe dans un même lieu, des services publics de proximité, modernes et accessibles....\r\nSur RDV, du lundi au vendredi, 9h - 12h et 13h30 - 17h (fermeture le mercredi matin)"
    ],
    "es": [
      "Esta ventanilla única reúne en un solo lugar servicios públicos locales modernos y accesibles....\r\nCon cita previa, de lunes a viernes, de 9.00 a 12.00 y de 13.30 a 17.00 (miércoles por la mañana cerrado)"
    ],
    "nl": [
      "Deze one-stop shop brengt moderne, toegankelijke lokale overheidsdiensten samen op één plek....\r\nOp afspraak, maandag t/m vrijdag, 9.00 - 12.00 uur en 13.30 - 17.00 uur (gesloten op woensdagochtend)"
    ]
  },
