  "rdfs:comment": {
    "de": [
      "Höhenrestaurant auf dem Gipfel des Skigebiets von Combloux. Nur im Winter geöffnet, mit atemberaubendem Blick auf den Mont-Blanc und die umliegenden Bergketten. Panoramaterrasse."
    ],
    "en": [
      "Located on \"les Portes du Mont-Blanc\" ski slopes, this restaurant can be reach on skis or on foot. Enjoy your meal while comtemplating the Mont-Blanc massif and the Aravis chain."
    ],
    "it": [
      "A 1700m di altitudine, in cima alle piste, accessibile con gli sci o a piedi (possibilità di prendere la seggiovia di Pertuis). Vista grandiosa sulla catena del Monte Bianco e degli Aravis."
    ],
    "fr": [
      "Restaurant d’altitude au sommet du domaine skiable de Combloux. Ouvert uniquement l'hiver, avec une vue imprenable sur le Mont-Blanc et sur les chaînes avoisinantes. Terrasse panoramique."
    ],
    "nl": [
      "Restaurant op grote hoogte aan de top van het skigebied Combloux. Alleen in de winter geopend, met adembenemend uitzicht op de Mont Blanc en de omliggende bergen. Panoramisch terras."
    ],
    "es": [
      "A 1700m de altitud, en la cima de las pistas, accesible por los esquiadores y peatones (posibilidad de utilizar el telesilla de Pertuis). Grandiosa vista de la cadena del Mont Blanc y de los Aravis."
    ]
  },
  "rdfs:label": {
