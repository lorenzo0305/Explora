  "rdfs:comment": {
    "de": [
      "Das Restaurant \"Séchex-Nous\" lädt Sie ein, eine nachhaltige und verantwortungsvolle Küche zu entdecken. Sie lassen sich durch drei Menüs in 3, 5 oder 7 Schritten führen, die ständig weiterentwickelt werden."
    ],
    "en": [
      "The \"Séchex-Nous\" restaurant invites you to discover sustainable and responsible cuisine. You'll be guided through three menus in 3, 5 or 7 steps, which will be constantly evolving."
    ],
    "it": [
      "Il ristorante \"Séchex-Nous\" vi invita a scoprire una cucina sostenibile e responsabile. Sarete guidati attraverso tre menu in 3, 5 o 7 tappe, in continua evoluzione."
    ],
    "fr": [
      "Le restaurant \"Séchex-Nous\" vous invite à découvrir une cuisine durable et responsable. Vous vous laisserez guider à travers trois menus en 3, 5 ou 7 étapes, qui seront en perpétuelle évolution."
    ],
    "nl": [
      "Het restaurant \"Séchex-Nous\" nodigt je uit om de duurzame en verantwoorde keuken te ontdekken. Je wordt geleid door drie menu's in 3, 5 of 7 etappes, die voortdurend in ontwikkeling zijn."
    ],
    "es": [
      "El restaurante \"Séchex-Nous\" le invita a descubrir una cocina sostenible y responsable. Le guiarán a través de tres menús en 3, 5 o 7 tiempos, que estarán en constante evolución."
    ]
  },
