  "rdfs:comment": {
    "de": [
      "Familienweingut seit fünf Generationen, Claude und Samuel empfangen Sie in ihren Weinkellern zur Weinprobe. Kellerbesichtigung und Beschreibung der Landschaft des Val de Saône am Mont du Beaujolais. Verkostung und Verkauf. In biologischer Landwirtschaft zertifizierte Weine."
    ],
    "en": [
      "A family vineyard for five generations, Claude and Samuel welcome you to their tasting cellars. Cellar tour and description of the landscape from the Val de Saône to the Mont du Beaujolais. Tasting and sales. Certified organic wines."
    ],
    "it": [
      "Vigna di famiglia da cinque generazioni, Claude e Samuel vi accolgono nelle loro cantine di degustazione. Visita della cantina e descrizione del paesaggio dalla Val de Saône al Mont du Beaujolais. Degustazione e vendita. Vini biologici certificati."
    ],
    "fr": [
      "Vignoble familial depuis cinq générations, Claude et Samuel vous accueillent dans leurs caveaux de dégustation. Visite de cave et description du paysage du Val de Saône au Mont du Beaujolais. Dégustation et vente. Vins certifié en Agriculture Biologique."
    ],
    "es": [
      "Viñedo familiar desde hace cinco generaciones, Claude y Samuel le dan la bienvenida a sus bodegas de degustación. Visita de la bodega y descripción del paisaje desde el Val de Saône hasta el Mont du Beaujolais. Degustación y venta. Vinos ecológicos certificados."
    ],
    "nl": [
      "Claude en Samuel, al vijf generaties lang een familiewijngaard, heten je welkom in hun proefkelders. Rondleiding door de kelders en beschrijving van het landschap van de Val de Saône tot de Mont du Beaujolais. Proeverij en verkoop. Gecertificeerde biologische wijnen."
    ]
  },
