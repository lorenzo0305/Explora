  "rdfs:comment": {
    "de": [
      "Entdecken Sie Lanslebourg, wie Sie es noch nie gesehen haben, in zwei verschiedenen Spielen: \"Le Portail Magique\" und \"Opération Mindfall\".\r\nEscape Game im Freien, das eine Mischung aus Augmented Reality und Rätseln im Dorf bietet."
    ],
    "en": [
      "Discover Lanslebourg as you've never seen it before thanks to 2 different games: \"Le Portail Magique\" and \"Opération Mindfall\".\r\nAn outdoor escape game combining augmented reality and puzzles in the village."
    ],
    "it": [
      "Scoprite Lanslebourg come non l'avete mai vista prima grazie a due giochi diversi: \"Le Portail Magique\" (Il Portale Magico) e \"Opération Mindfall\" (Operazione Mindfall).\r\nUn gioco di fuga all'aperto che combina realtà aumentata ed enigmi nel villaggio."
    ],
    "fr": [
      "Partez à la découverte de Lanslebourg comme vous ne l'avez jamais vu grâce à 2 jeux différents : « Le Portail Magique » et « Opération Mindfall » .\r\nEscape game en extérieur qui mêle réalité augmentée et énigmes dans le village."
    ],
    "nl": [
      "Ontdek Lanslebourg zoals je het nog nooit hebt gezien dankzij 2 verschillende spellen: \"Le Portail Magique\" (Het Magische Portaal) en \"Opération Mindfall\" (Operatie Mindfall).\r\nEen ontsnappingsspel in de buitenlucht dat augmented reality en puzzels in het dorp combineert."
    ],
    "es": [
      "Descubre Lanslebourg como nunca antes lo habías visto gracias a 2 juegos diferentes: \"Le Portail Magique\" (El Portal Mágico) y \"Opération Mindfall\" (Operación Mindfall).\r\nUn juego de escape al aire libre que combina realidad aumentada y rompecabezas en el pueblo."
    ]
  },
