  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/51c6cb50-d80d-3a47-bd73-07c60e5c3307",
      "dc:description": {
        "de": [
          "Die Boutique du lait bietet Qualitätsprodukte vom Bauernhof an: Fleisch, Geflügel, Milch, Butter, Käse, Joghurt, Quark, Honig, Getränke, Gemüse, Obst der Saison, echte Produkte. Zögern Sie nicht, mich für Ihre Bestellungen oder Auskünfte zu kontaktieren. Bis bald in der Boutique du lait!"
        ],
        "en": [
          "La boutique du lait offers quality farm products, meat, poultry, milk, butter, cheese, yogurt, cottage cheese, honey, drinks, vegetables, seasonal fruits, real products. Do not hesitate to contact me for your orders or information. See you soon at the milk store!"
        ],
        "it": [
          "La boutique du lait offre prodotti agricoli di qualità, carne, pollame, latte, burro, formaggio, yogurt, ricotta, miele, bevande, verdure, frutta di stagione, prodotti sfusi. Non esitate a contattarmi per i vostri ordini o informazioni. Ci vediamo presto al negozio di latte!"
        ],
        "fr": [
          "La boutique du lait propose des produits fermiers de qualité, viande, volailles, lait, beurre, fromage, yaourts, fromage blanc, miel, boissons, légumes, fruits de saison, produits vracs. N'hésitez à me contacter pour vos commandes ou renseignements. À bientôt à la boutique du lait !"
        ],
        "es": [
          "La boutique du lait ofrece productos agrícolas de calidad, carne, aves de corral, leche, mantequilla, queso, yogur, requesón, miel, bebidas, verduras, fruta de temporada, productos a granel. No dude en ponerse en contacto conmigo para sus pedidos o información. ¡Nos vemos pronto en la tienda de leche!"
        ],
        "nl": [
          "La boutique du lait biedt kwaliteitslandbouwproducten, vlees, gevogelte, melk, boter, kaas, yoghurt, kwark, honing, dranken, groenten, seizoensfruit, bulkproducten. Aarzel niet om contact met mij op te nemen voor uw bestellingen of informatie. Tot ziens in de melkwinkel!"
        ]
      },
      "@type": [
        "Description"
      ],
