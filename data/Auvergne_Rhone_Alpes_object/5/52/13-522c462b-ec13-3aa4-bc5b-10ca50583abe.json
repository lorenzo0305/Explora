  "rdfs:comment": {
    "de": [
      "Das Thermalbad Les Nériades erstreckt sich über eine Fläche von fast 1 000 m2. Es ist in einen Sinnesbereich (Becken, Sauna) gegliedert, um den herum Kabinen für Balneotherapie-Behandlungen angeordnet sind."
    ],
    "en": [
      "The Les Nériades thermal spa covers nearly 1,000m2. It is organized around a sensory area (pools, sauna) and cabins dedicated to balneotherapy treatments."
    ],
    "it": [
      "Il centro termale Les Nériades si estende per quasi 1.000 m2. È organizzato intorno a un'area sensoriale (piscine, sauna) e a cabine dedicate ai trattamenti di balneoterapia."
    ],
    "fr": [
      "Le spa thermal Les Nériades s'étend sur près de 1 000m2. Il est organisé à partir d'un Espace sensoriel (bassins, sauna) autour duquel on retrouve des cabines dédiées aux soins de balnéothérapie."
    ],
    "es": [
      "El spa termal Les Nériades ocupa casi 1.000 m2. Se organiza en torno a una zona sensorial (piscinas, sauna) y cabinas dedicadas a tratamientos de balneoterapia."
    ],
    "nl": [
      "De thermen van Les Nériades beslaan bijna 1.000 m2. Het is georganiseerd rond een zintuiglijke ruimte (zwembaden, sauna) en cabines voor balneotherapiebehandelingen."
    ]
  },
  "rdfs:label": {
