  "rdfs:comment": {
    "de": [
      "Die Ferme des Chambauds ist ein Viehzuchtbetrieb im Herzen des Bourbonnais, der biologisch geführt wird. Produktion von Rind- und Kalbfleisch."
    ],
    "en": [
      "The Fermes des Chambauds is a breeding farm located in the heart of Bourbonnais, conducted in organic farming. Production of lamb, beef and veal and eggs."
    ],
    "it": [
      "La Ferme des Chambauds è un'azienda zootecnica situata nel cuore della regione del Bourbonnais, gestita con metodi di agricoltura biologica. Produzione di carne bovina."
    ],
    "fr": [
      "La Ferme des Chambauds est une ferme d'élevage située au coeur du Bourbonnais, conduite en agriculture biologique. Production de viande de boeuf et de veau."
    ],
    "nl": [
      "La Ferme des Chambauds is een veeteeltbedrijf in het hart van de Bourbonnais, dat op biologische wijze wordt beheerd. Productie van rundvlees."
    ],
    "es": [
      "La Ferme des Chambauds es una explotación ganadera situada en el corazón de la región de Bourbonnais, gestionada con métodos de agricultura ecológica. Producción de carne de vacuno."
    ]
  },
