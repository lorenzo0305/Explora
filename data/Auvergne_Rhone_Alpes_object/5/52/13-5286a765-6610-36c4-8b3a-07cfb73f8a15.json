  "rdfs:comment": {
    "de": [
      "Verarbeitung und Abfüllen in Gläser vor Ort: Gänsestopfleber, Rillettes, Cassoulets, Confits, Toast'oie, Gänsemagen. Der Betrieb verwaltet alle Herstellungsschritte und bietet den Verkauf vor Ort, auf Märkten und online an."
    ],
    "en": [
      "The Ferme des Payres produces goose foie gras: rearing, force-feeding and processing. Farm tours. Reception and group catering, reservation required."
    ],
    "it": [
      "Lavorazione e imbottigliamento in loco: foie gras d'oca, rillettes, cassoulets, confits, toast d'oca e ventrigli. L'azienda gestisce tutte le fasi della produzione e vende i suoi prodotti in loco, nei mercati e online."
    ],
    "fr": [
      "Transformation et mise en bocal sur place : foie gras d'oie, rillettes, cassoulets, confits, toast'oie, gésiers. L'exploitation gère toutes les étapes de la fabrication et propose de la vente sur place, sur les marchés et en ligne."
    ],
    "nl": [
      "Verkoop van foie gras van een gans, rillettes, cassoulets, gekonfijt vlees, toast'gans, pens. Teelt, overvoeding, bewerking. Bezoek aan het bedrijf. Ontvangst en restaurant voor groepen na reservering."
    ],
    "es": [
      "Transformación y embotellado in situ: foie gras de oca, rillettes, cassoulets, confits, tostadas y mollejas de oca. La granja gestiona todas las etapas de la producción y vende sus productos in situ, en mercados y en línea."
    ]
  },
