  "rdfs:comment": {
    "de": [
      "Nach 30 Jahren Produktion von Bresse-Geflügel, Direktverkauf und Verpflegung in Bauernhöfen und Gasthäusern setzen wir die Aufwertung dieses schönen Produkts auf gastronomischen Veranstaltungen, Messen, privaten Mahlzeiten und anderen Events fort."
    ],
    "en": [
      "After 30 years of Bresse poultry production, direct sales and farm-auberge catering, we continue to showcase this fine product at gastronomic events, trade fairs, private meals and other functions."
    ],
    "it": [
      "Dopo 30 anni di produzione di pollame di Bresse, di vendita diretta e di ristorazione in fattoria, continuiamo a presentare questo prodotto pregiato in occasione di eventi gastronomici, fiere, pranzi privati e altre manifestazioni."
    ],
    "fr": [
      "Après 30 années de production de la Volaille de Bresse, de vente directe et de restauration en ferme-auberge,  nous continuons la mise en valeur de ce beau produit sur des événements gastronomiques, salons, repas privés et autres manifestations."
    ],
    "es": [
      "Tras 30 años de producción avícola de Bresse, de venta directa y de restauración en granjas, seguimos presentando este excelente producto en acontecimientos gastronómicos, ferias, comidas privadas y otros eventos."
    ],
    "nl": [
      "Na 30 jaar pluimveeproductie uit Bresse, directe verkoop en catering op de boerderij, blijven we dit fijne product presenteren op gastronomische evenementen, beurzen, privémaaltijden en andere evenementen."
    ]
  },
  "rdfs:label": {
