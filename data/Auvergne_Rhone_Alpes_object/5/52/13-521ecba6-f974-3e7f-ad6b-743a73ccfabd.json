  "rdfs:comment": {
    "de": [
      "Gemütliches Restaurant in einem kleinen grünen und gastlichen Dorf. Cateringservice, Festessen, Speisen zum Mitnehmen. Neu: Genießen Sie das ganze Jahr über hausgemachte Schokoladen und Koch-Workshops."
    ],
    "en": [
      "A friendly restaurant in a small and welcoming, flower-filled village. Catering service, banqueting, dishes to take away. New: all year round, enjoy our home made chocolates and cookery workshops"
    ],
    "it": [
      "Ristorante accogliente in un piccolo villaggio pieno di fiori.\r\nServizio di catering, gruppi, matrimoni, compleanni...\r\nNovità: regalatevi tutto l'anno con il nostro menu a base di rane."
    ],
    "fr": [
      "Restaurant convivial dans un petit village fleuri et accueillant.\r\nService traiteur, groupe, mariage, anniversaire...\r\nNouveauté : faites vous plaisir tout au long de l’année avec notre menu grenouilles."
    ],
    "nl": [
      "Vriendelijk restaurant in een klein dorp vol bloemen.\r\nCateringservice, groepen, bruiloften, verjaardagen...\r\nNieuw: verwen jezelf het hele jaar door met ons kikkermenu."
    ],
    "es": [
      "Restaurante acogedor en un pequeño pueblo lleno de flores.\r\nServicio de catering, grupos, bodas, cumpleaños...\r\nNovedad: date un capricho todo el año con nuestro menú rana."
    ]
  },
