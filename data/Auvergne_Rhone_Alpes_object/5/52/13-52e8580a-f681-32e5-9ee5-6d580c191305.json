  "rdfs:comment": {
    "de": [
      "Willkommen in Les Confins, dem unbestritten besten Ort in La Clusaz, um die Aravis-Kette im Winter wie im Sommer zu bewundern."
    ],
    "en": [
      "Welcome to Les Confins, undoubtedly the best place in La Clusaz to admire the Aravis mountain range in winter and summer."
    ],
    "it": [
      "Benvenuti a Les Confins, senza dubbio il luogo migliore di La Clusaz per ammirare la catena montuosa degli Aravis sia in inverno che in estate."
    ],
    "fr": [
      "Bienvenue aux Confins, incontestablement le meilleur endroit de La Clusaz pour admirer la chaîne des Aravis hiver comme été."
    ],
    "nl": [
      "Welkom in Les Confins, ongetwijfeld de beste plek in La Clusaz om de Aravis bergketen te bewonderen in de winter en de zomer."
    ],
    "es": [
      "Bienvenido a Les Confins, sin duda el mejor lugar de La Clusaz para admirar la cordillera de Aravis tanto en invierno como en verano."
    ]
  },
