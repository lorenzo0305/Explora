  "rdfs:comment": {
    "de": [
      "Entdecken Sie diese Brauerei, die es sich zum Ziel gesetzt hat, eine Vielzahl hochwertiger handwerklicher Biere herzustellen, die die biologische Vielfalt respektieren, indem sie insbesondere aus biologischem Anbau stammen."
    ],
    "en": [
      "Come and discover this brewery which at will and manufacture a multitude of quality craft beers that respect biodiversity, notably from organic farming."
    ],
    "it": [
      "Venite a scoprire questo birrificio che ha la volontà di produrre una moltitudine di birre artigianali di qualità che rispettano la biodiversità grazie alla coltivazione biologica."
    ],
    "fr": [
      "Venez découvrir cette brasserie qui a la volonté de fabriquer une multitude de bières artisanales de qualité qui respectent la biodiversité en étant notamment issus d’une agriculture biologique."
    ],
    "es": [
      "Venga a descubrir esta cervecería que tiene la voluntad de producir una multitud de cervezas artesanales de calidad que respetan la biodiversidad al ser de cultivo ecológico."
    ],
    "nl": [
      "Kom en ontdek deze brouwerij die de wil heeft om een groot aantal ambachtelijke kwaliteitsbieren te produceren die de biodiversiteit respecteren door biologisch te worden geteeld."
    ]
  },
  "rdfs:label": {
    "de": [
      "Brauerei \"Sous le Bois\" (Unter dem Wald)"
    ],
    "en": [
      "Brewery \"Under the Wood\"/\"Sous le Bois\""
    ],
    "fr": [
      "Brasserie \"Sous le Bois\""
    ]
  },
