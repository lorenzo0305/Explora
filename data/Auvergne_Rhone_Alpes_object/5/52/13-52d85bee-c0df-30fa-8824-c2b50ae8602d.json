  "rdfs:comment": {
    "de": [
      "Aufrichtige und raffinierte gastronomische Küche, die frische und regionale Produkte anbietet. Dieses Restaurant bietet Gerichte oder Menüs an, die mit dem Gütesiegel Goûtez l'Ardèche® ausgezeichnet sind."
    ],
    "en": [
      "Sincere and refined gourmet cuisine that offers fresh and regional products."
    ],
    "it": [
      "Cucina gastronomica sincera e raffinata con prodotti freschi e regionali. Questo ristorante propone piatti o menu approvati da Goûtez l'Ardèche®."
    ],
    "fr": [
      "Cuisine gastronomique sincère et raffinée qui propose des produits frais et régionaux. Ce restaurant propose des plats ou menus agréés Goûtez l'Ardèche®."
    ],
    "nl": [
      "Oprechte en verfijnde gastronomische keuken met verse en regionale producten. Dit restaurant stelt gerechten of menu's voor die zijn goedgekeurd door Goûtez l'Ardèche®."
    ],
    "es": [
      "Cocina gastronómica sincera y refinada con productos frescos y regionales. Este restaurante propone platos o menús aprobados por Goûtez l'Ardèche®."
    ]
  },
