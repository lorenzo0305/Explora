  "rdfs:comment": {
    "de": [
      "Die Vereinsbibliothek Les Tilleuls bietet Bücher für jeden Geschmack und jedes Alter zur freien Verfügung an!\r\nKinder, Jugendliche und Erwachsene können hier verschiedene Sammlungen und Neuheiten (wieder-)entdecken, die sie vor Ort lesen oder zu Hause ausleihen können!"
    ],
    "en": [
      "The library Les Tilleuls offers a free consultation of books for all tastes and all ages!\r\nChildren, teenagers and adults, (re)discover various collections and new books to read on site or to borrow at home!"
    ],
    "it": [
      "La biblioteca di Les Tilleuls offre accesso gratuito a libri per tutti i gusti e per tutte le età!\r\nBambini, ragazzi e adulti, (ri)scoprono varie collezioni e nuovi libri da leggere sul posto o da prendere in prestito a casa!"
    ],
    "fr": [
      "La bibliothèque associative Les Tilleuls propose une libre consultation de livres pour tous les goûts et tous les âges !\r\nEnfants, adolescents et adultes, (re)découvrez des collections variées et des nouveautés à lire sur place ou à emprunter chez vous !"
    ],
    "es": [
      "La biblioteca de Les Tilleuls ofrece acceso gratuito a libros para todos los gustos y edades\r\nNiños, adolescentes y adultos, (re)descubren varias colecciones y nuevos libros para leer in situ o para tomarlos prestados en casa"
    ],
    "nl": [
      "De bibliotheek Les Tilleuls biedt gratis toegang tot boeken voor alle smaken en leeftijden!\r\nKinderen, tieners en volwassenen, (her)ontdekken verschillende collecties en nieuwe boeken om ter plaatse te lezen of om thuis te lenen!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Bibliothèque Les Tilleuls"
    ]
  },
