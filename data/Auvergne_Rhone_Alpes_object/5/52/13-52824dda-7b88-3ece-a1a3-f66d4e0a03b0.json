  "rdfs:comment": {
    "de": [
      "die Pump Party Tour kommt nach Tignes für einen Tag voller Wettkämpfe und Shows auf dem Asphalt-Pumptrack von Tignes le Lac. Das Ganze findet in einer guten Atmosphäre statt und ist für alle offen."
    ],
    "en": [
      "the Pump Party Tour comes to Tignes for a day of competition and shows on the asphalt pumptrack at Tignes le Lac. All in a great atmosphere and open to all."
    ],
    "it": [
      "il Pump Party Tour arriva a Tignes per una giornata di gare e spettacoli sulla pista d'asfalto di Tignes le Lac. Il tutto in una grande atmosfera e aperto a tutti."
    ],
    "fr": [
      "la tournée du Pump Party Tour s’installe à Tignes pour une journée de compétition et de shows sur le pumptrack en enrobée de Tignes le Lac. Le tout dans une bonne ambiance et ouvert à tous."
    ],
    "es": [
      "el Pump Party Tour llega a Tignes para una jornada de competición y espectáculos en la pista de asfalto de Tignes le Lac. Todo en un gran ambiente y abierto a todos."
    ],
    "nl": [
      "de Pump Party Tour komt naar Tignes voor een dag vol wedstrijden en shows op de geasfalteerde pumptrack van Tignes le Lac. Alles in een geweldige sfeer en open voor iedereen."
    ]
  },
  "rdfs:label": {
