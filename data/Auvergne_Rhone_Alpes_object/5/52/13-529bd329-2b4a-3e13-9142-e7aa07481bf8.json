  "rdfs:comment": {
    "de": [
      "Das Wohlbefinden des Einzelnen durch Yoga, Qi Gong und Meditation fördern.\r\nWöchentliche Sitzungen in kleinen Gruppen.  Individuelle und personalisierte Sitzungen.\r\nauf Anfrage während eines Aufenthalts oder auch das ganze Jahr über."
    ],
    "en": [
      "Promoting personal well-being through yoga, Qi Gong and meditation\r\nWeekly sessions in small groups.  Individual and personalized sessions\r\non request during a stay or all year round."
    ],
    "it": [
      "Promuovere il benessere personale attraverso lo yoga, il Qi Gong e la meditazione\r\nSessioni settimanali in piccoli gruppi.  Sessioni individuali e personalizzate\r\nsu richiesta durante un soggiorno o tutto l'anno."
    ],
    "fr": [
      "Promouvoir le bien-être de la personne à travers le yoga, le Qi Gong et la  méditation \r\nSéances hebdomadaires en petit groupe.  Séance individuelle et personnalisée \r\nà la demande durant un séjour ou bien toute l'année."
    ],
    "es": [
      "Promover el bienestar personal a través del yoga, el Qi Gong y la meditación\r\nSesiones semanales en pequeños grupos.  Sesiones individuales y personalizadas\r\na petición durante una estancia o durante todo el año."
    ],
    "nl": [
      "Bevordering van persoonlijk welzijn door yoga, Qi Gong en meditatie\r\nWekelijkse sessies in kleine groepen.  Individuele en persoonlijke sessies\r\nop aanvraag tijdens een vakantie of het hele jaar door."
    ]
  },
  "rdfs:label": {
