  "rdfs:comment": {
    "de": [
      "KARAOKE - BLINDTESTS\r\nSchließe dich unseren treuen Stammgästen an / falsches Singen wird dringend empfohlen!\r\nKaraoke auf Großbildschirm in der Bar wie jeden Sonntag\r\n? Kostenlos"
    ],
    "en": [
      "KARAOKE - BLIND-TESTS\r\nJoin our loyal regulars / singing off-key is highly recommended\r\nKaraoke on a giant screen in the bar as every Sunday\r\n? Free"
    ],
    "it": [
      "KARAOKE - TEST AL BUIO\r\nUnitevi ai nostri fedeli habitué / si consiglia vivamente di cantare in modo stonato\r\nKaraoke su schermo gigante nel bar come ogni domenica\r\n? Gratuito"
    ],
    "fr": [
      "KARAOKÉ - BLIND-TESTS\r\nRejoins nos fidèles habitués / chanter faux est vivement conseillé   \r\nKaraoké sur écran géant dans le bar comme tous les dimanches \r\n️ Gratuit"
    ],
    "es": [
      "KARAOKE - PRUEBAS A CIEGAS\r\nÚnete a nuestros fieles asiduos / se desaconseja cantar fuera de tono\r\nKaraoke en pantalla gigante en el bar como cada domingo\r\n? Gratis"
    ],
    "nl": [
      "KARAOKE - BLIND TESTEN\r\nDoe mee met onze trouwe stamgasten / vals zingen wordt sterk aangeraden\r\nKaraoke op een reuzenscherm in de bar zoals elke zondag\r\n? Gratis"
    ]
  },
  "rdfs:label": {
