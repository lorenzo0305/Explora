  "rdfs:comment": {
    "de": [
      "Entdecken Sie unsere regionalen Käsesorten: \"Le Chapelou\", \"Chapelou bleu\" und \"L'Artison\", die wir selbst herstellen, sowie den Campalou und den Tomme des 3 sucs."
    ],
    "en": [
      "Come and discover our local cheeses: \"le Chapelou\", \"le Chapelou bleu\", \"L'Artison\", made by us, as well as Campalou and Tomme des 3 sucs."
    ],
    "it": [
      "Venite a scoprire i nostri formaggi locali: \"le Chapelou\", \"le Chapelou bleu\", \"L'Artison\", prodotti da noi, oltre a Campalou e Tomme des 3 sucs."
    ],
    "fr": [
      "Venez découvrir nos fromages de pays: « le Chapelou », le \"Chapelou bleu\", \"L'Artison\",  fabriqués par nos soins ainsi que le Campalou et la Tomme des 3 sucs."
    ],
    "es": [
      "Venga a descubrir nuestros quesos locales: \"le Chapelou\", \"le Chapelou bleu\", \"L'Artison\", elaborados por nosotros, así como el Campalou y la Tomme des 3 sucs."
    ],
    "nl": [
      "Kom en ontdek onze lokale kazen: \"le Chapelou\", \"le Chapelou bleu\", \"L'Artison\", door ons gemaakt, evenals Campalou en Tomme des 3 sucs."
    ]
  },
