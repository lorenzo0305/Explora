  "rdfs:comment": {
    "de": [
      "Dieser Platz, ein schöner Park mit Gras und einigen Bäumen, ist für alle offen. Er befindet sich am Ufer des Flusses Biaillère und des Radwegs, der am Krankenhaus vorbeiführt"
    ],
    "en": [
      "This space, a pretty grassy park with a few trees, is open to all. It is located on the banks of the biaillère river and the cycle path that runs alongside the hospital"
    ],
    "it": [
      "Quest'area, un bel parco erboso con alcuni alberi, è aperta a tutti. Si trova sulle rive del Biaillère e sulla pista ciclabile che costeggia l'ospedale"
    ],
    "fr": [
      "Cet espace, un joli parc enherbé assorti de quelques arbres, est ouvert à tous.. Il se situe au bord de la biaillère et de la piste cyclable qui longe l'hôpital"
    ],
    "es": [
      "Esta zona, un bonito parque herboso con algunos árboles, está abierta a todos. Se encuentra a orillas de la Biaillère y del carril bici que bordea el hospital"
    ],
    "nl": [
      "Dit gebied, een mooi graspark met een paar bomen, is voor iedereen toegankelijk. Het ligt aan de oever van de Biaillère en het fietspad dat langs het ziekenhuis loopt"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Pré Curral"
    ]
  },
