      "rdfs:comment": {
        "de": [
          "Markt ab Samstag, den 9. Mai, von 10:30 bis 12:30 Uhr in Bucilly (Place rue de Verdun).\n\nEmmanuel bietet Ihnen sein Biogemüse an, das in Permakultur inmitten der Bocage de Thiérache angebaut wird. Sie werden ihn vor allem auf den Märkten in Bucilly als Aussteller antreffen können."
        ],
        "en": [
          "Market from Saturday 9 May from 10.30 to 12.30 in Bucilly (Place rue de Verdun).\n\nEmmanuel offers you his organic vegetables, grown in permaculture in the bocage of Thiérache. You will have the opportunity to meet him as an exhibitor at the Bucilly markets."
        ],
        "it": [
          "Mercato da sabato 9 maggio dalle 10:30 alle 12:30 a Bucilly (Place rue de Verdun).\n\nEmmanuel vi offre i suoi ortaggi biologici, coltivati in permacultura nel cuore del bocage di Thiérache. Avrete l'opportunità di incontrarlo ai mercati di Bucilly come espositore."
        ],
        "fr": [
          "Marché à partir du samedi 9 mai de 10h30 à 12h30 à Bucilly (Place rue de Verdun).\n\nEmmanuel vous propose ses légumes bio, cultivés en permaculture au sein du bocage de Thiérache. Vous aurez l'occasion de le rencontrer notamment lors des marchés de Bucilly en tant qu'exposant."
        ],
        "es": [
          "Mercado del sábado 9 de mayo de 10:30 a 12:30 en Bucilly (Place rue de Verdun).\n\nEmmanuel le ofrece sus verduras ecológicas, cultivadas en permacultura en el corazón del bocage de Thiérache. Tendrá la oportunidad de conocerlo en los mercados de Bucilly como expositor."
        ],
        "nl": [
          "Markt van zaterdag 9 mei van 10.30 tot 12.30 uur in Bucilly (Place rue de Verdun).\n\nEmmanuel biedt u zijn biologische groenten, geteeld in permacultuur in het hart van de Thiérache bocage. U kunt hem ontmoeten op de markten van Bucilly als exposant."
        ]
      },
