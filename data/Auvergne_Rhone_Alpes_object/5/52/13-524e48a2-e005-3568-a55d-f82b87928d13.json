  "rdfs:comment": {
    "de": [
      "Nach Mozart und seinem tschechischen Zeitgenossen Dru?ecký entführt uns Anna ?trbová mit den Engländern Moeran und Arnold ins 20. Jahrhundert, die einer lächelnden und melodiösen Sprache treu bleiben, die weit entfernt von den Avantgarden ihrer Zeit ist."
    ],
    "en": [
      "After Mozart and his Czech contemporary Dru?ecký, Anna ?trbová transports us to the 20th century with the Englishmen Moeran and Arnold, who remain faithful to a smiling, melodious language, far removed from the avant-gardes of their time."
    ],
    "it": [
      "Dopo Mozart e il suo contemporaneo ceco Dru?ecký, Anna ?trbová ci trasporta nel Novecento con gli inglesi Moeran e Arnold, che rimangono fedeli a un linguaggio sorridente e melodioso, lontano dalle avanguardie del loro tempo."
    ],
    "fr": [
      "Après Mozart et son contemporain tchèque Družecký, Anna Štrbová nous transporte au XXe siècle avec les Anglais Moeran et Arnold, qui restent fidèles à un langage souriant et mélodieux, loin des avant-gardes de leur temps."
    ],
    "es": [
      "Tras Mozart y su contemporáneo checo Dru?ecký, Anna ?trbová nos transporta al siglo XX con los ingleses Moeran y Arnold, fieles a un lenguaje sonriente y melodioso, alejado de las vanguardias de su tiempo."
    ],
    "nl": [
      "Na Mozart en zijn Tsjechische tijdgenoot Dru?ecký voert Anna ?trbová ons naar de twintigste eeuw met de Engelsen Moeran en Arnold, die trouw blijven aan een glimlachende, melodieuze taal, ver verwijderd van de avant-gardes van hun tijd."
    ]
  },
  "rdfs:label": {
