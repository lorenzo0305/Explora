  "rdfs:comment": {
    "de": [
      "Die Bibliothek steht allen Einwohnern der Gemeinde kostenlos zur Verfügung. Hier können Sie mehr als 9650 Dokumente und eine Auswahl von 100 Spielen für alle Altersgruppen entdecken. Das ganze Jahr über werden temporäre Ausstellungen und Animationen organisiert."
    ],
    "en": [
      "The library is open free of charge to all local residents. You can discover over 9650 documents, and a selection of 100 games, for all ages. Temporary exhibitions and events are organized throughout the year."
    ],
    "it": [
      "La biblioteca è aperta gratuitamente a tutti i residenti. Sono disponibili oltre 9.650 documenti e una selezione di 100 giochi per tutte le età. Durante l'anno vengono organizzate mostre temporanee ed eventi."
    ],
    "fr": [
      "La bibliothèque est ouverte gratuitement à tous les habitants de la commune. Vous pourrez découvrir plus de 9650 documents, et une sélection de 100 jeux, pour tous les âges. Toute l'année des expositions temporaires et animations sont organisées."
    ],
    "es": [
      "La biblioteca está abierta gratuitamente a todos los residentes. Dispone de más de 9.650 documentos y una selección de 100 juegos para todas las edades. A lo largo del año se organizan exposiciones temporales y actos."
    ],
    "nl": [
      "De bibliotheek is gratis toegankelijk voor alle inwoners. Er zijn meer dan 9.650 documenten en een selectie van 100 spelletjes voor alle leeftijden. Het hele jaar door worden er tijdelijke tentoonstellingen en evenementen georganiseerd."
    ]
  },
