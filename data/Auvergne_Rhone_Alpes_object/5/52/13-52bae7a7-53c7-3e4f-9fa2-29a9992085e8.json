  "rdfs:comment": {
    "de": [
      "Eine Mischung aus Vorstellungswelten und Kulturen, eine Gemeinschaft von Körpern und Herzen im Tanz, ein Bal Folk in tausend Farben: Willkommen in der heiligen Welt von Maka!"
    ],
    "en": [
      "A blend of imaginary worlds and cultures, a communion of bodies and hearts in dance, a folk ball of a thousand colors: welcome to the sacred world of Maka!"
    ],
    "it": [
      "Un crogiolo di immaginari e culture, una comunione di corpi e cuori nella danza, un ballo popolare dai mille colori: benvenuti nel sacro mondo di Maka!"
    ],
    "fr": [
      "Un métissage d’imaginaires et de cultures, une communion de corps et de cœurs dans la danse, un bal folk aux milles couleurs : bienvenue dans le monde sacré de Maka !"
    ],
    "es": [
      "Un crisol de imaginaciones y culturas, una comunión de cuerpos y corazones en danza, un baile folclórico de mil colores: ¡bienvenidos al mundo sagrado de Maka!"
    ],
    "nl": [
      "Een smeltkroes van fantasieën en culturen, een gemeenschap van lichamen en harten in dans, een volksbal met duizend kleuren: welkom in de heilige wereld van Maka!"
    ]
  },
  "rdfs:label": {
    "fr": [
