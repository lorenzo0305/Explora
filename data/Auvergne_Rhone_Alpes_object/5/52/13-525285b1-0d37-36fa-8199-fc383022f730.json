  "rdfs:comment": {
    "de": [
      "Evolution 2 Tignes Val Claret ist als eine der besten Skischulen der Alpen anerkannt und bietet Ihnen Ski-, Snowboard- und Freeridekurse in kleinen Gruppen für Kinder, Jugendliche und Erwachsene an."
    ],
    "en": [
      "Evolution 2 has become one of the most respected ski and adventure schools in the French Alps. We believe in learning in small groups, with specialist instructors, and an emphasis on progression and fun!"
    ],
    "it": [
      "Riconosciuta come una delle migliori scuole di sci delle Alpi, Evolution 2 Tignes Val Claret offre lezioni di sci, snowboard e freeride in piccoli gruppi per bambini, ragazzi e adulti."
    ],
    "fr": [
      "Reconnue comme l’une des meilleures écoles de ski des Alpes, Evolution 2 Tignes Val Claret vous propose des cours de ski, snowboard et freeride en petits groupes, pour enfants, ados et adultes."
    ],
    "es": [
      "Reconocida como una de las mejores escuelas de esquí de los Alpes, Evolution 2 Tignes Val Claret ofrece clases de esquí, snowboard y freeride en grupos reducidos para niños, adolescentes y adultos."
    ],
    "nl": [
      "Evolution 2 Tignes Val Claret, erkend als een van de beste skischolen in de Alpen, biedt ski-, snowboard- en freeride-lessen in kleine groepen voor kinderen, tieners en volwassenen."
    ]
  },
