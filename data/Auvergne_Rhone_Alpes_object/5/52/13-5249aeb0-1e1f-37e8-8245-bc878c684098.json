  "rdfs:comment": {
    "de": [
      "Atelier für plastische Kunst: Zeichnungen, Drucke, Skulpturen auf Stein und Beton. Ich suche nach der richtigen Begegnung zwischen Motiven aus dem Kulturerbe, Spuren der Vergangenheit und einem zeitgenössischen Ausdruck.\r\nVorschläge für individuelle Arbeiten und Praktika."
    ],
    "en": [
      "Plastic art worshop : drawing, print, stone and concrete sculpture. I'm looking for the right meeting between patterns coming from heritage, traces of the past and a  contempory artistic expression.\r\nWorkshop and personalized training proposal."
    ],
    "it": [
      "Laboratorio di arte plastica: disegno, stampa, scultura su pietra e cemento. Cerco il giusto incontro tra i motivi del patrimonio, le tracce del passato e l'espressione contemporanea.\r\nPropongo lavori e corsi di formazione personalizzati."
    ],
    "fr": [
      "Atelier d'art plastique: dessin, estampe, sculpture sur pierre et béton. Je recherche la juste rencontre entre des motifs issus du patrimoine, les traces du passé et une expression contemporaine.\r\nProposition de travaux et stages personnalisés."
    ],
    "es": [
      "Taller de artes plásticas: dibujo, grabado, escultura sobre piedra y hormigón. Busco el encuentro adecuado entre los motivos del patrimonio, las huellas del pasado y la expresión contemporánea.\r\nPropongo trabajos y cursos de formación personalizados."
    ],
    "nl": [
      "Plastische kunst workshop: tekenen, printen, beeldhouwen op steen en beton. Ik zoek naar de juiste balans tussen erfgoedmotieven, sporen uit het verleden en hedendaagse expressie.\r\nMaatwerk en cursussen mogelijk."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Atelier Oiseau Pierre"
    ]
  },
