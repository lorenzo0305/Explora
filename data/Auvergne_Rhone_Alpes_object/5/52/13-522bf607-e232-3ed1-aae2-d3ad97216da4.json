  "rdfs:comment": {
    "de": [
      "Der Touristenzug erwartet Sie zu einer Fahrt in der Kabine einer Draisine aus den 1950er Jahren. Das Bahnhofsmuseum zeigt eine Ausstellung mit mehreren Modellautos und vielen ikonischen Objekten aus der Welt der Eisenbahn."
    ],
    "en": [
      "The tourist train awaits you for a trip in a 1950s draisine cab. The station's museum features a number of scale models and iconic railway objects."
    ],
    "it": [
      "Il treno turistico vi aspetta per un viaggio in una cabina draisina degli anni Cinquanta. Il museo della stazione ospita un'esposizione con diversi modelli in scala e molti oggetti emblematici del mondo ferroviario."
    ],
    "fr": [
      "Le train touristique vous attend pour un voyage en cabine de draisines des années 1950. Le musée de la gare présente une exposition avec plusieurs modèles réduits et de nombreux objets emblématiques du monde ferroviaire."
    ],
    "es": [
      "El tren turístico le espera para un viaje en una cabina de draisina de los años 50. El museo de la estación alberga una exposición con varias maquetas y numerosos objetos emblemáticos del mundo del ferrocarril."
    ],
    "nl": [
      "De toeristische trein wacht op je voor een reis in een draisine-cabine uit 1950. Het stationsmuseum heeft een tentoonstelling met een aantal schaalmodellen en veel emblematische voorwerpen uit de spoorwegwereld."
    ]
  },
  "rdfs:label": {
