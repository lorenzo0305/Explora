  "rdfs:comment": {
    "de": [
      "Die Kirche ist ein neogotisches Gebäude mit 56 Glasfenstern, einer Kanzel mit zwei Treppen und dem seltenen Phänomen, dass der Kreuzweg in die Glasfenster geschnitzt ist."
    ],
    "en": [
      "The church is a neo-gothic building with a series of 56 stained glass windows, a pulpit with a double staircase, and a rare phenomenon: the Way of the Cross is carved into the stained glass windows."
    ],
    "it": [
      "Edificio neogotico, la chiesa contiene una serie di 56 vetrate, un pulpito a doppia scala e un fenomeno raro: le stazioni della Via Crucis sono scolpite nelle finestre."
    ],
    "fr": [
      "Edifice de style néo gothique,  l'église renferme une série de 56 vitraux, une chaire à double escalier, et phénomène rare : le chemin de croix est sculpté dans les vitraux."
    ],
    "es": [
      "Edificio neogótico, la iglesia contiene una serie de 56 vidrieras, un púlpito de doble escalera y un fenómeno poco común: las estaciones del Vía Crucis están talladas en las ventanas."
    ],
    "nl": [
      "De kerk, een neogotisch gebouw, bevat een reeks van 56 gebrandschilderde ramen, een preekstoel met dubbele trap, en een zeldzaam verschijnsel: de kruiswegstaties zijn in de ramen gegraveerd."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Eglise Notre Dame des Victoires"
    ]
  },
