  "rdfs:comment": {
    "de": [
      "Bergbegleiterin, Lehrerin für nordischen Skisport. Einzelunterricht in Langlauf, Ausflüge mit Schneeschuhen oder Hok-Ski.\r\nHalbtages-, Tages- und Nachtausflüge. Einzelperson, Familie oder Gruppe. Erleben Sie das Abenteuer und entdecken Sie den Schnee in seinem ursprünglichen Zustand."
    ],
    "en": [
      "Mountain guide, Nordic ski instructor. Private lessons in cross-country skiing, snowshoeing or ski hok.\r\nHalf-day, full-day and night-time excursions. Individuals, families and groups. Experience adventure and discover snow in its purest form."
    ],
    "it": [
      "Accompagnatrice di montagna, istruttrice di sci nordico. Lezioni individuali di sci di fondo, escursioni con racchette da neve o sci hok.\r\nEscursioni di mezza giornata, giornata intera, notturne. Individuali, famiglie, gruppi. Vivete l'avventura e scoprite la neve allo stato puro."
    ],
    "fr": [
      "Accompagnatrice en montagne, monitrice ski nordique. Cours individuel en ski de fond, sorties en raquettes ou ski hok.\r\nSortie demi-journée, journée, nocturne. Individuel, famille groupe. Vivez l'aventure et découvrez la neige à l'état brut."
    ],
    "es": [
      "Monitor de montaña, monitor de esquí nórdico. Clases individuales de esquí de fondo, raquetas de nieve o hok-esquí.\r\nSalidas de media jornada, jornada completa y nocturnas. Individuales, familias, grupos. Viva la aventura y descubra la nieve en estado puro."
    ],
    "nl": [
      "Berggids, instructrice langlaufen. Privélessen langlaufen, sneeuwschoenwandelen of skitoeren.\r\nHalve dag, hele dag, nachtelijke tochten. Individueel, gezinnen, groepen. Beleef het avontuur en ontdek de sneeuw in zijn puurste vorm."
    ]
  },
