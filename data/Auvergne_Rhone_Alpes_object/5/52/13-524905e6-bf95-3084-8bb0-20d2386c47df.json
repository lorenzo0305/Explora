  "rdfs:comment": {
    "de": [
      "Park mit Bäumen, der an das Maison pour Tous angrenzt und den Kanal säumt. Hier gibt es einen Picknicktisch, Bänke und einen Spielplatz."
    ],
    "en": [
      "Wooded park adjacent to the Maison pour Tous and bordering the canal. Picnic tables, benches and a play area."
    ],
    "it": [
      "Parco alberato adiacente alla Maison pour Tous e confinante con il canale. Ci sono tavoli da picnic, panchine e un'area giochi."
    ],
    "fr": [
      "Parc arboré qui jouxte la Maison pour Tous et qui borde le canal. Présence de table de pique-nique, de bancs, et d'une aire de jeux."
    ],
    "es": [
      "Parque arbolado adyacente a la Maison pour Tous y que bordea el canal. Hay mesas de picnic, bancos y una zona de juegos."
    ],
    "nl": [
      "Bosrijk park grenzend aan het Maison pour Tous en aan het kanaal. Er zijn picknicktafels, banken en een speeltuin."
    ]
  },
