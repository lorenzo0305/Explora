  "rdfs:comment": {
    "de": [
      "Triofestif, ein Kultur- und Freizeitverein. Dieser dynamische Verein bietet eine Vielzahl von Aktivitäten für jeden Geschmack, von Musik und Tanz bis hin zu sozialen und kulturellen Veranstaltungen."
    ],
    "en": [
      "Triofestif, a cultural and leisure association. This dynamic association offers a variety of activities to suit all tastes, from music and dance to social and cultural events."
    ],
    "it": [
      "Triofestif, un'associazione culturale e ricreativa. Questa dinamica associazione offre una varietà di attività per tutti i gusti, dalla musica alla danza, agli eventi sociali e culturali."
    ],
    "fr": [
      "Triofestif, une association culturelle et de loisirs. Cette association dynamique propose une variété d'activités pour tous les goûts, allant de la musique et de la danse aux événements sociaux et culturels."
    ],
    "es": [
      "Triofestif, una asociación cultural y de ocio. Esta dinámica asociación ofrece una gran variedad de actividades para todos los gustos, desde música y danza hasta actos sociales y culturales."
    ],
    "nl": [
      "Triofestif, een culturele en vrijetijdsvereniging. Deze dynamische vereniging biedt een verscheidenheid aan activiteiten naar ieders smaak, van muziek en dans tot sociale en culturele evenementen."
    ]
  },
