  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/37e89773-b23c-3b88-94e0-962f78d56970",
      "dc:description": {
        "de": [
          "Winter-Schnitzeljagd.\n\nAuf der Suche nach den Anomalien!\nBei den Händlern und Gastronomen von Toulouse.\nWillkommen bei diesem lustigen Spiel für die ganze Familie!\nBegeben Sie sich auf die Suche nach Anomalien, die in den Schaufenstern Ihrer Geschäftsleute versteckt sind, und entdecken Sie Ihre Stadt auf spielerische Weise neu."
        ],
        "en": [
          "Winter treasure hunt.\n\nIn search of anomalies!\nIn Touquet's shops and restaurants.\nWelcome to this fun game for the whole family!\nSet off in search of the anomalies hidden in your shop windows and rediscover your town in a fun way."
        ],
        "it": [
          "Caccia al tesoro invernale.\n\nAlla ricerca di anomalie!\nNei negozi e nei ristoranti di Touquet.\nBenvenuti in questo divertente gioco per tutta la famiglia!\nPartite alla ricerca delle anomalie nascoste nelle vetrine dei negozi e riscoprite la vostra città in modo divertente."
        ],
        "fr": [
          "Jeu de piste d'hiver.\n\nA la recherche des anomalies !\nChez les commerçants et restaurateurs touquettois.\nBienvenue dans ce jeu amusant pour toute la famille !\nPartez à la recherche des anomalies dissimulées dans les vitrines de vos commerçants et redécouvrez votre ville de façon ludique."
        ],
        "nl": [
          "Winterschattenjacht.\n\nOp zoek naar anomalieën!\nIn de winkels en restaurants van Touquet.\nWelkom bij dit leuke spel voor het hele gezin!\nGa op zoek naar de anomalieën in de etalages en herontdek je stad op een leuke manier."
        ],
        "es": [
          "Búsqueda del tesoro en invierno.\n\n¡En busca de anomalías!\nEn las tiendas y restaurantes de Touquet.\n¡Bienvenido a este divertido juego para toda la familia!\nParte en busca de las anomalías escondidas en los escaparates y redescubre tu ciudad de forma divertida."
        ]
      },
      "@type": [
        "Description"
      ],
