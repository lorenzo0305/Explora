  "rdfs:comment": {
    "de": [
      "Bistronomische Küche mit frischen, lokalen und \"hausgemachten\" Produkten. Wochenmenü nach Wahl, um Ihren Gaumen zu verwöhnen. Donnerstag- und Freitagabends können Sie ein Menü nach Wahl genießen, das edle Produkte verfeinert. Terrasse an schönen Tagen."
    ],
    "en": [
      "Bistronomic cuisine using fresh, local, home-grown produce. A choice of weekly menus to delight your taste buds. On Thursday and Friday evenings, you can enjoy a menu of your choice, sublimating noble products. Terrace in fine weather."
    ],
    "it": [
      "Cucina bistronomica con prodotti freschi, locali e fatti in casa. Una scelta di menu settimanali per deliziare il vostro palato. Il giovedì e il venerdì sera potrete gustare un menu a scelta con i migliori prodotti. Terrazza nella bella stagione."
    ],
    "fr": [
      "Cuisine bistronomique avec des produits frais et locaux, \"fait maison\". Menu à la semaine au choix, pour ravir vos papilles. Les jeudis et vendredis soirs, vous pourrez déguster un menu au choix sublimant des produits nobles. Terrasse aux beaux jours."
    ],
    "es": [
      "Cocina bistronómica con productos frescos, locales y caseros. Una selección de menús semanales para deleitar su paladar. Los jueves y viernes por la noche, menú a elegir con los mejores productos. Terraza cuando hace buen tiempo."
    ],
    "nl": [
      "Bistronomische keuken met verse, lokale, huisgemaakte producten. Keuze uit verschillende weekmenu's om je smaakpapillen te verwennen. Op donderdag- en vrijdagavond kunt u genieten van een menu naar keuze met de beste producten. Terras bij mooi weer."
    ]
  },
  "rdfs:label": {
