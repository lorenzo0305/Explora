  "rdfs:comment": {
    "de": [
      "Der Pool ist vom 24.12.2023 bis einschließlich 7.1.2024 geschlossen.\r\n\r\nDas im Sportkomplex gelegene interkommunale Schwimmbad empfängt Erwachsene und Kinder für einen Moment der Entspannung. Das Schwimmbad und der Sportkomplex sind bis auf weiteres für die Öffentlichkeit geschlossen."
    ],
    "en": [
      "The pool is closed from 24/12/2023 to 7/01/2024 inclusive.\r\n\r\nLocated in the Sports Complex, the intercommunal swimming pool welcomes adults and children to enjoy a relaxing moment. The pool and sports complex are closed to the public until further notice."
    ],
    "it": [
      "La piscina è chiusa dal 24/12/2023 al 7/01/2024 compreso.\r\n\r\nSituata nel complesso sportivo, la piscina intercomunale accoglie adulti e bambini per un momento di relax. La piscina e il complesso sportivo sono chiusi al pubblico fino a nuovo avviso."
    ],
    "fr": [
      "La piscine est fermé du 24/12/2023 au 7/01/2024 inclus.\r\n\r\nSituée au Complexe Sportif, la Piscine intercommunale accueille les adultes et les enfants pour un moment de détente. La piscine et le complexe sportif sont fermés au public jusqu’à nouvel ordre."
    ],
    "es": [
      "La piscina permanecerá cerrada del 24/12/2023 al 7/01/2024 inclusive.\r\n\r\nSituada en el Complejo Deportivo, la piscina intercomunal acoge a adultos y niños para un momento de relajación. La piscina y el complejo deportivo están cerrados al público hasta nuevo aviso."
    ],
    "nl": [
      "Het zwembad is gesloten van 24/12/2023 tot en met 7/01/2024.\r\n\r\nHet intercommunale zwembad, gelegen in het Sportcomplex, verwelkomt volwassenen en kinderen voor een moment van ontspanning. Het zwembad en het sportcomplex zijn tot nader order gesloten voor het publiek."
    ]
  },
  "rdfs:label": {
