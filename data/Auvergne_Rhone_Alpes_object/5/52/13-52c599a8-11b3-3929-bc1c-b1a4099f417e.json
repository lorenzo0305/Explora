  "rdfs:comment": {
    "de": [
      "Nahe des Stadtzentrums und Vieux-Lyons, verfügt das Novotel Lyon-Confluence über 150 Zimmer der neusten Generation, ein Restaurant, eine Loungebar mit Terrasse, Versammlungsräume, einen Fitnesssaal und einen Privatparkplatz."
    ],
    "en": [
      "Located near the city centre and Old Lyon, the Novotel Lyon Centre Confluence Bord de Saône boasts 150 latest-generation guest rooms, a restaurant, lounge bar with terrace, meeting rooms, gym and private parking."
    ],
    "it": [
      "Vicino al centro di Lione e alla Lione Vecchia, il Novotel Lyon-Confluence dispone di 150 camere di ultima generazione, di un ristorante, di un lounge bar con terrazza, di sale riunione, di una sala fitness e di un parcheggio privato."
    ],
    "fr": [
      "À deux pas du centre-ville, l'hôtel vous accueille dans ses 150 chambres modernes et confortables. Vous y trouverez aussi un restaurant, un bar avec terrasse ayant vue sur la Saône, des espaces de réunion, une salle de fitness et un parking privé."
    ],
    "nl": [
      "Het hotel ligt op een steenworp afstand van het stadscentrum en verwelkomt je in zijn 150 moderne, comfortabele kamers. Er is ook een restaurant, een bar met terras met uitzicht op de Saône, vergaderzalen, een fitnessruimte en een privéparkeerplaats."
    ],
    "es": [
      "El Novotel Lyon-Confluence está cerca del centro urbano y el barrio de Vieux-Lyon, dispone de 150 habitaciones de última generación, un restaurante, un bar lounge con terraza, salas de reuniones, sala de fitness y parking privado."
    ]
  },
