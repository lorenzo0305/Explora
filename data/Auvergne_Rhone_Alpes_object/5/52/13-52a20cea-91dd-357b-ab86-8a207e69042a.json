  "rdfs:comment": {
    "de": [
      "Diese rote Langlaufloipe führt Sie von Chavanne nach Chenex durch die zauberhaften Almwiesen des Salève."
    ],
    "en": [
      "This red cross-country ski trail takes you from Chavanne to Chenex through the charm of the Salève mountain pastures."
    ],
    "it": [
      "Questa pista rossa per lo sci di fondo vi porta da Chavanne a Chenex attraverso gli incantevoli pascoli di montagna della Salève."
    ],
    "fr": [
      "Cette piste rouge de ski de fond vous emmène de Chavanne a Chenex au travers du charme des alpages du Salève."
    ],
    "es": [
      "Esta pista roja de esquí de fondo le llevará de Chavanne a Chenex a través de los encantadores pastos de montaña del Salève."
    ],
    "nl": [
      "Deze rode loipe voert u van Chavanne naar Chenex door de charme van de alpenweiden van de Salève."
    ]
  },
