  "rdfs:comment": {
    "de": [
      "Nehmen Sie an der traditionellen Eierjagd auf der Pferderennbahn teil. Denken Sie daran, Ihre Körbe mitzubringen!\r\nVerschiedene Zonen, die je nach Alter der Kinder abgegrenzt werden."
    ],
    "en": [
      "Come and take part in the traditional egg hunt at the racecourse. Don't forget to bring your baskets!\r\nDifferent zones for different ages."
    ],
    "it": [
      "Venite a partecipare alla tradizionale caccia alle uova all'ippodromo - non dimenticate di portare i vostri cestini!\r\nCi saranno zone diverse per le varie età dei bambini."
    ],
    "fr": [
      "Venez participer à la traditionnelle chasse aux œufs à l'hippodrome, pensez à apporter vos paniers !\r\nDifférentes zones délimitées en fonction de l'âge des enfants."
    ],
    "es": [
      "Participe en la tradicional búsqueda de huevos en el hipódromo. ¡No olvide traer sus cestas!\r\nHay diferentes zonas para las distintas edades de los niños."
    ],
    "nl": [
      "Kom meedoen aan de traditionele eierzoektocht op de renbaan - vergeet je mandjes niet mee te nemen!\r\nEr zullen verschillende zones zijn voor kinderen van verschillende leeftijden."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Chasse aux oeufs"
    ]
  },
