  "rdfs:comment": {
    "de": [
      "Die Keramikerin öffnet Ihnen den in ihrem Atelier eingerichteten Ausstellungsraum... Abstrakte Porzellanskulpturen, die die Materie herausfordern, die Leere nachzeichnen und den Raum choreographieren..."
    ],
    "en": [
      "Daniela SCHLAGENHAUF, has been creating in her workshop since the 80’s. Her amazing abstract sculptures in porcelain carve the space and defy the material."
    ],
    "it": [
      "La ceramista apre lo spazio espositivo nel suo studio... Sculture astratte in porcellana che sfidano la materia, tracciano il vuoto e coreografano lo spazio..."
    ],
    "fr": [
      "La céramiste vous ouvre l’espace d’exposition aménagé à son atelier... Des sculptures abstraites en porcelaine qui défient la matière, tracent le vide et chorégraphient l’espace..."
    ],
    "es": [
      "La ceramista inaugura el espacio expositivo de su estudio... Esculturas abstractas de porcelana que desafían el material, trazan el vacío y coreografían el espacio..."
    ],
    "nl": [
      "De keramiste opent de tentoonstellingsruimte in haar atelier... Abstracte porseleinen sculpturen die het materiaal tarten, de leegte opsporen en de ruimte choreograferen..."
    ]
  },
