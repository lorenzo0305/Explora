  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Aktivität Paintball im Wald von Planchards in Yzeure!\r\nIn einer idealen Umgebung für Paintball finden Sie zwei bewaldete Spielfelder (1000 und 3000 m²), die mit Hindernissen gespickt sind."
    ],
    "en": [
      "Come and discover paintball in the Planchards forest in Yzeure!\r\nIn an ideal setting for paintball, you'll find two wooded fields (1000 and 3000 m²) dotted with obstacles."
    ],
    "it": [
      "Venite a scoprire il paintball nella foresta di Planchards a Yzeure!\r\nIn un ambiente ideale per il paintball, troverete due campi boscosi (1000 e 3000 m²) disseminati di ostacoli."
    ],
    "fr": [
      "Venez découvrir l’activité Paintball dans la forêt des Planchards à Yzeure !\r\nDans un cadre idéal pour la pratique du paintball, vous trouverez deux terrains boisés (1000 et 3000 m²) parsemés d’obstacles."
    ],
    "es": [
      "Venga a descubrir el paintball en el bosque de Planchards, en Yzeure\r\nEn un entorno ideal para el paintball, encontrarás dos campos arbolados (1000 y 3000 m²) salpicados de obstáculos."
    ],
    "nl": [
      "Kom paintball ontdekken in het bos van Planchards in Yzeure!\r\nIn een ideale omgeving voor paintball vind je twee beboste velden (1000 en 3000 m²) bezaaid met hindernissen."
    ]
  },
  "rdfs:label": {
