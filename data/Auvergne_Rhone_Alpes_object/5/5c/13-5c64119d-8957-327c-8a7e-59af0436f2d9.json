  "rdfs:comment": {
    "de": [
      "Familiengeführtes Restaurant, das vor über 30 Jahren gegründet wurde.\r\nSelbstbedienung und seit diesem Jahr neu ein Tischserviceteil mit einem Rooftop, von dem aus man einen herrlichen Blick auf die Berge hat.\r\nTraditionelle Speisekarte mit Austern, Crêpes und Galettes."
    ],
    "en": [
      "High altitude restaurant"
    ],
    "it": [
      "Ristorante a conduzione familiare creato più di 30 anni fa.\r\nSelf service e, novità di quest'anno, un'area per il servizio al tavolo con un tetto che offre una vista mozzafiato sulle montagne.\r\nMenu tradizionale con ostriche, crêpes e galettes"
    ],
    "fr": [
      "Restaurant familial créé il y a plus de 30 ans.\r\nSelf service et nouveau cette année une partie service à table avec un rooftop qui offre une vue imprenable sur les montagnes.\r\nCarte traditionnelle agrémentée d'huîtres, des crêpes et galettes"
    ],
    "es": [
      "Restaurante familiar creado hace más de 30 años.\r\nAutoservicio y, como novedad este año, una zona de servicio de mesa con una azotea que ofrece una impresionante vista de las montañas.\r\nMenú tradicional con ostras, crêpes y galettes"
    ],
    "nl": [
      "Bergrestaurant"
    ]
  },
