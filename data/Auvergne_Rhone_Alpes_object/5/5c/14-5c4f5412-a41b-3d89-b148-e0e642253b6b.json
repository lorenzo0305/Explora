  "rdfs:comment": {
    "de": [
      "Der Arena Trail in Liévin ist der Treffpunkt für Trailrunner! Auf dem Programm stehen der Trail des gueules noires (22 km), der Trail les moulineurs (15 km) und der Trail les galibots (8 km). Außerdem gibt es eine 8 km lange Wanderung!"
    ],
    "en": [
      "The Arena Trail de Liévin is the place to be for runners! On the program: the trail des gueules noires (22km), the trail les moulineurs (15km) and the trail les galibots (8km). And don't forget the 8km hike!"
    ],
    "it": [
      "L'Arena Trail di Liévin è il luogo ideale per i corridori! Il programma comprende il trail des gueules noires (22 km), il trail les moulineurs (15 km) e il trail les galibots (8 km). E non dimenticate l'escursione di 8 km!"
    ],
    "fr": [
      "L'Arena Trail de Liévin c'est le rendez-vous des traileurs ! Au programme découvrez le trail des gueules noires (22km), le trail les moulineurs (15km) et le trail les galibots (8km). Retrouvez également la randonnée de 8km !"
    ],
    "nl": [
      "Het Arena Parcours in Liévin is de place to be voor hardlopers! Op het programma staan het parcours des gueules noires (22 km), het parcours les moulineurs (15 km) en het parcours les galibots (8 km). En vergeet de wandeling van 8 km niet!"
    ],
    "es": [
      "El Arena Trail de Liévin es el lugar ideal para los corredores El programa incluye el trail des gueules noires (22 km), el trail les moulineurs (15 km) y el trail les galibots (8 km). Y no se olvide de la caminata de 8 km"
    ]
  },
