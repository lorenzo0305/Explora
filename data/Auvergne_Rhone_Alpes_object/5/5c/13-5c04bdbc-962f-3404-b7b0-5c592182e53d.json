  "rdfs:comment": {
    "de": [
      "Das Restaurant befindet sich im Herzen des Dorfes, in der Nähe des Fremdenverkehrsamtes.\r\nUnser Restaurant bietet Ihnen eine abwechslungsreiche Speisekarte: Tagesgericht, savoyische Spezialitäten, Salate, Pizzen, bretonische Galettes...\r\nSüdterrasse."
    ],
    "en": [
      "Located in the heart of the village, near the Tourist Office.\r\nOur restaurant offers a varied menu: daily specials, Savoyard specialties, salads, pizzas, Breton cakes etc."
    ],
    "it": [
      "Situato nel cuore del villaggio, vicino all'Ufficio del Turismo.\r\nIl nostro ristorante offre un menù vario: specialità del giorno, specialità savoiarde, insalate, pizze, frittelle bretoni, ecc.\r\nTerrazza esposta a sud."
    ],
    "fr": [
      "Situé au cœur du village, prés de l'Office de Tourisme.\r\nNotre restaurant vous propose une carte variée : plat du jour, spécialités savoyardes, salades, pizzas, galettes bretonnes...\r\nTerrasse plein sud."
    ],
    "es": [
      "Situado en el corazón del pueblo, cerca de la Oficina de Turismo.\r\nNuestro restaurante ofrece una carta variada: platos del día, especialidades de Saboya, ensaladas, pizzas, crepes bretonas, etc.\r\nTerraza orientada al sur."
    ],
    "nl": [
      "Middenin het dorp, vlak bij het VVV-kantoor.\r\nOns restaurant biedt een gevarieerd menu: dagschotels, specialiteiten uit de Savoie, salades, pizza's, hartige crêpes..."
    ]
  },
  "rdfs:label": {
    "en": [
      "Le Centre"
    ],
