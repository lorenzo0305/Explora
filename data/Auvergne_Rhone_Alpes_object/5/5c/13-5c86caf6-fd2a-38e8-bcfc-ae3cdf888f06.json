  "rdfs:comment": {
    "de": [
      "Öffnen Sie die Tür zu diesem Steinmetzatelier und entdecken Sie die Kunst, Mineralien in echte Schmuckstücke zu verwandeln! Zwischen präzisen Gesten und funkelnden Edelsteinen lädt Thierry Sie ein, seine Kreationen zu bewundern oder sich selbst in die Kunst des Steinschneidens einzuführen."
    ],
    "en": [
      "Push open the door of this lapidary workshop to discover the art of transforming minerals into genuine jewels! Thierry invites you to admire his creations, or try your hand at stone-cutting yourself."
    ],
    "it": [
      "Varcate la porta di questo laboratorio lapidario per scoprire l'arte di trasformare i minerali in veri e propri gioielli! Thierry vi invita ad ammirare le sue creazioni o a cimentarvi nel taglio della pietra."
    ],
    "fr": [
      "Poussez la porte de cet atelier lapidaire pour découvrir l'art de transformer le minéral en véritable bijou ! Entre précision du geste et éclats des gemmes, Thierry vous invite à admirer ses créations ou à vous initier vous même à la taille de pierre."
    ],
    "nl": [
      "Stap door de deur van dit lapidair atelier en ontdek de kunst om mineralen om te zetten in echte juwelen! Thierry nodigt je uit om zijn creaties te bewonderen of om het steenhouwen zelf te proberen."
    ],
    "es": [
      "Entre por la puerta de este taller lapidario y descubra el arte de transformar los minerales en auténticas joyas Thierry le invita a admirar sus creaciones o a probar a tallar piedras."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Boutique atelier lapidaire - Artelier d'Ores"
    ]
  },
