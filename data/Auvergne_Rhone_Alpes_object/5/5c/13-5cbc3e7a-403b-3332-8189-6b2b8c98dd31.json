  "rdfs:comment": {
    "de": [
      "Sehr große Formate über den Körper, der sich im Tanz ausdrückt.... sehr kleine Formate , wie ein Weg aus flüchtigen, poetischen Lebensmomenten.... Marie Jo Girard kommt, um uns ihr aktuelles Schaffen vorzustellen. Ausstellung in der MPT vom 18. bis 31. Mai 2026."
    ],
    "en": [
      "Très grands formats about the body expressing itself in dance.... très petits formats , like a path of fugitive, poetic moments of life.... Marie Jo Girard presents her current work. Exhibition at MPT from May 18 to 31, 2026."
    ],
    "it": [
      "Très grands formats sul corpo che si esprime nella danza.... très petits formats , come una scia di fugaci e poetici momenti di vita.... Marie Jo Girard presenterà il suo lavoro attuale. Mostra al MPT dal 18 al 31 maggio 2026."
    ],
    "fr": [
      "Très grands formats à propos du corps s’exprimant en danse.... très petits formats , comme un chemin d’instants de vie fugitifs, poétiques.... Marie Jo Girard vient nous présenter sa création actuelle. Exposition à la MPT du 18 au 31 mai 2026."
    ],
    "es": [
      "Très grands formats sobre el cuerpo que se expresa en la danza.... très petits formats , como un rastro de momentos fugaces y poéticos de la vida.... Marie Jo Girard presentará su obra actual. Exposición en la MPT del 18 al 31 de mayo de 2026."
    ],
    "nl": [
      "Très grands formats over het lichaam dat zich uitdrukt in dans.... très petits formats , als een spoor van vluchtige, poëtische momenten van het leven.... Marie Jo Girard presenteert haar huidige werk. Tentoonstelling in het MPT van 18 tot 31 mei 2026."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Exposition de Marie-Jo Girard"
    ]
  },
