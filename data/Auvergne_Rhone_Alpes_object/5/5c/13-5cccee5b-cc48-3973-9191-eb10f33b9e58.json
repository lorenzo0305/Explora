  "rdfs:comment": {
    "de": [
      "Dorf Pinols: am Tor zur Margeride, Kirche, Markthalle aus dem 19. Schöner Aussichtspunkt mit Blick auf die Windräder auf dem Plateau d'Ally."
    ],
    "en": [
      "Village of Pinols: at the gateway to the Margeride, 19th-century church and market hall. Beautiful view of the wind turbines on the Ally plateau."
    ],
    "it": [
      "Villaggio di Pinols: alle porte della Margeride, chiesa e sala del mercato del XIX secolo. Ottima vista sulle turbine eoliche dell'altopiano di Ally."
    ],
    "fr": [
      "Village de Pinols : aux portes de la Margeride, église, halle du XIXe siècle. Beau point de vue sur les éoliennes du plateau d’Ally."
    ],
    "es": [
      "Pueblo de Pinols: a las puertas de la Margeride, iglesia y mercado del siglo XIX. Magníficas vistas de los aerogeneradores de la meseta de Ally."
    ],
    "nl": [
      "Dorp Pinols: aan de poort van de Margeride, kerk en 19e-eeuwse markthal. Prachtig uitzicht op de windturbines op het Ally-plateau."
    ]
  },
