  "rdfs:comment": {
    "de": [
      "Im Herzen eines alten Weberdorfes, in einem renovierten Gebäude mit Charakter, entdecken Sie eine raffinierte Küche, die sich im Rhythmus der Jahreszeiten entwickelt. Angrenzende Gästezimmer."
    ],
    "en": [
      "In the heart of an old weavers' village, in a renovated building of character, discover a refined cuisine evolving with the seasons. Adjacent guest rooms."
    ],
    "it": [
      "Nel cuore di un antico villaggio di tessitori, in un edificio ristrutturato di carattere, scoprite una cucina raffinata che si evolve con le stagioni. Camere per gli ospiti adiacenti."
    ],
    "fr": [
      "Au cœur d'un ancien village de tisserands, dans une bâtisse de caractère rénovée, découvrez une cuisine raffinée évoluant au rythme des saisons. Chambres d'hôtes attenantes."
    ],
    "nl": [
      "In het hart van een oud weversdorp, in een gerenoveerd gebouw vol karakter, ontdekt u een verfijnde keuken die met de seizoenen mee verandert. Aangrenzende gastenkamers."
    ],
    "es": [
      "En el corazón de un antiguo pueblo de tejedores, en un edificio renovado con carácter, descubra una cocina refinada que evoluciona con las estaciones. Habitaciones de huéspedes adyacentes."
    ]
  },
