  "rdfs:comment": {
    "de": [
      "In unseren Geschäften finden Sie Beaufort, aber auch andere Produkte aus Savoyen (Käse, Wurstwaren, Fleisch aus dem Beaufortain, Weine, Konfitüren, Honig, Crozets...). Verkauf vor Ort und Online-Verkauf."
    ],
    "en": [
      "Our stores offer you Beaufort but also other products of Savoie (cheeses, charcuterie, meat from Beaufortain, wines, jams, honey, crozets...). On-site sale and online sale."
    ],
    "it": [
      "I nostri negozi vendono Beaufort e altri prodotti della Savoia (formaggi, salumi, carne di Beaufortain, vini, marmellate, mieli, crozets, ecc.) Vendita sul posto e online."
    ],
    "fr": [
      "Nos magasins vous proposent du Beaufort mais également d'autres produits de Savoie (fromages, charcuterie, viande du Beaufortain, vins, confitures, miels, crozets...). Vente sur place et vente en ligne."
    ],
    "nl": [
      "Onze winkels bieden u Beaufort maar ook andere producten van Savoie (kazen, vleeswaren, vlees uit Beaufortain, wijnen, jam, honing, crozets ...). Verkoop ter plaatse en online verkoop."
    ],
    "es": [
      "Nuestras tiendas venden Beaufort, así como otros productos de Saboya (quesos, charcutería, carne de Beaufortain, vinos, mermeladas, mieles, crozets, etc.). Venta in situ y en línea."
    ]
  },
