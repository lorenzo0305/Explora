  "rdfs:comment": {
    "de": [
      "Unser hausgemachter Teig wird von Hand geknetet und ausgerollt und ist seit 20 Jahren eine handwerkliche Pizzabäckerei. Er ist großzügig mit frischen Qualitätsprodukten belegt. Wir verarbeiten einen dünnen, leichten und sehr bekömmlichen Pizzateig."
    ],
    "en": [
      "Artisan pizza makers for 20 years, our homemade dough is kneaded and rolled out by hand. Generously topped with fresh quality produce. Our pizza dough is thin, light and highly digestible."
    ],
    "it": [
      "Pizzaioli artigianali da 20 anni, la nostra pasta fatta in casa è impastata e stesa a mano. Condita generosamente con prodotti freschi e di qualità. La nostra pasta per pizza è sottile, leggera e altamente digeribile."
    ],
    "fr": [
      "Artisan pizzaïola depuis 20ans, notre pâte faîte maison est pétrie et étalée à la main. Généreusement garnie avec des produits frais de qualités. Nous travaillons une pâte à pizza fine, légère et très digestive."
    ],
    "es": [
      "Pizzeros artesanos desde hace 20 años, nuestra masa casera se amasa y extiende a mano. Generosamente cubierta con productos frescos de calidad. Nuestra masa de pizza es fina, ligera y muy digestiva."
    ],
    "nl": [
      "Al 20 jaar ambachtelijke pizzabakkers, ons huisgemaakte deeg wordt met de hand gekneed en uitgerold. Royaal belegd met verse kwaliteitsproducten. Ons pizzadeeg is dun, licht en licht verteerbaar."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Mona Lisa"
    ]
  },
