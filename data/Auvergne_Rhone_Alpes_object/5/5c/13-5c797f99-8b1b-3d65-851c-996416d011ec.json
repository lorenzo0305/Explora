  "rdfs:comment": {
    "de": [
      "Das Chalet de la Grande Rochette bietet Ihnen eine hausgemachte Küche mit hochwertigen Produkten in einem außergewöhnlichen Panorama.\r\nNEU IM WINTER 2024/2025: Ein Verkaufsbereich zum Mitnehmen mit Sandwiches, Hotdogs, heißen und kalten Getränken, ..."
    ],
    "en": [
      "The Chalet de la Grande Rochette has a bar and a restaurant serving homemade cuisine made with quality products, in an exceptional panoramic setting.\r\nWe also have a kiosk selling takeaway sandwiches, hot dogs, drinks and sweet snacks."
    ],
    "it": [
      "Lo Chalet de la Grande Rochette vi offre un bar e un ristorante, cucina casalinga con prodotti di qualità, in un panorama eccezionale.\r\nC'è anche un'area takeaway con panini, hot dog, bevande e dolci."
    ],
    "fr": [
      "Le Chalet de la Grande Rochette vous propose un bar et un restaurant, une cuisine faite maison, avec des produits de qualité, dans un panorama exceptionnel.\r\nEt aussi un espace vente à emporter avec sandwiches, hot-dogs, boissons, gourmandises."
    ],
    "es": [
      "El Chalet de la Grande Rochette le ofrece bar y restaurante, comida casera con productos de calidad, en un panorama excepcional.\r\nTambién hay una zona de comida para llevar con sándwiches, perritos calientes, bebidas y dulces."
    ],
    "nl": [
      "Chalet de la Grande Rochette biedt je een bar en restaurant, huisgemaakte gerechten met kwaliteitsproducten, in een uitzonderlijk panorama.\r\nEr is ook een afhaalgedeelte met broodjes, hotdogs, drankjes en zoete lekkernijen."
    ]
  },
