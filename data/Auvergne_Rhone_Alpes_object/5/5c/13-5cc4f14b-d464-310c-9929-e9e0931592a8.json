  "rdfs:comment": {
    "de": [
      "Plaine de l'Ain Tourisme empfängt Sie in seinem saisonalen Informationsbüro für Touristen. Im Zentrum seines Territoriums berät Sie das Fremdenverkehrsamt über Aktivitäten in der Natur, Wanderungen oder Radtouren und bietet Ihnen verschiedene praktische Dienstleistungen an"
    ],
    "en": [
      "Plaine de l'Ain Tourisme welcomes you to its seasonal tourist information office. At the heart of the region, the Tourist Office advises you on nature, hiking and cycling activities, and offers a range of practical services."
    ],
    "it": [
      "Plaine de l'Ain Tourisme vi dà il benvenuto nel suo ufficio informazioni turistiche stagionale. Nel cuore della regione, l'Ufficio del Turismo offre consigli sulle attività naturalistiche, escursionistiche e ciclistiche, oltre a una serie di servizi pratici"
    ],
    "fr": [
      "Plaine de l'Ain Tourisme vous accueille dans son bureau d'information touristique saisonnier. Au centre de son territoire, l'Office de Tourisme vous conseille sur les activités nature, randonnée ou vélo et vous propose différents services pratiques"
    ],
    "es": [
      "Plaine de l'Ain Tourisme le da la bienvenida a su oficina de información turística de temporada. En el centro de la región, la Oficina de Turismo puede aconsejarle sobre actividades en la naturaleza, senderismo y ciclismo y ofrecerle una serie de servicios prácticos"
    ],
    "nl": [
      "Plaine de l'Ain Tourisme heet je welkom in zijn seizoensgebonden VVV-kantoor. In het hart van de regio biedt het VVV-kantoor advies over natuur-, wandel- en fietsactiviteiten en een reeks praktische diensten"
    ]
  },
  "rdfs:label": {
