  "rdfs:comment": {
    "de": [
      "Erleben Sie die Otaku-Erfahrung, Asian Street Food Spezialitäten (Smash Burger, Ramen und japanische Currys) und entdecken Sie unsere Welt der Popkultur Manga Anime. ."
    ],
    "en": [
      "Come and enjoy the Otaku experience, Asian street food specialities (smash burger, ramen and Japanese curry) and discover our pop culture, manga and anime universe."
    ],
    "it": [
      "Venite a godervi l'esperienza Otaku, le specialità asiatiche di street food (smash burger, ramen e curry giapponese) e a scoprire il nostro mondo di cultura pop, manga e anime."
    ],
    "fr": [
      "Venez vivre l'expérience Otaku, Spécialités Asian street food (smash burger, ramen et curry japonais) et découvrir notre univers pop culture mangas animés. ."
    ],
    "es": [
      "Venga y disfrute de la experiencia Otaku, de las especialidades de la comida callejera asiática (hamburguesa smash, ramen y curry japonés) y descubra nuestro mundo de cultura pop, mangas y anime."
    ],
    "nl": [
      "Kom genieten van de Otaku-ervaring, Aziatische streetfoodspecialiteiten (smash burger, ramen en Japanse curry) en ontdek onze wereld van popcultuur, manga's en anime."
    ]
  },
