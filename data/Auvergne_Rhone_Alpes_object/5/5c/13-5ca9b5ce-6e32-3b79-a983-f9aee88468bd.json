  "rdfs:comment": {
    "de": [
      "Im Herzen des Massivs entdecken Sie unsere Bio-Biere aus handwerklicher und lokaler Herstellung, die mit Quellwasser unter der Bezeichnung nature et Progrès gebraut werden."
    ],
    "en": [
      "Visit, tasting and sale of home made artisan beer, brewed in the Sancy mountains. Also available at the markets."
    ],
    "it": [
      "Nel cuore del Massiccio, scoprite le nostre birre biologiche prodotte localmente con acqua di sorgente e certificate Nature et Progrès."
    ],
    "fr": [
      "Au coeur du massif découvrez nos bières bio de fabrication artisanale et locale brassée à l'eau de source sous mention nature et Progrès."
    ],
    "nl": [
      "Proeven en verkoop van ambachtelijke gebrouwen bier uit de bergen van de Sancy. Ook beschikbaar op de markten."
    ],
    "es": [
      "En el corazón del Macizo, descubra nuestras cervezas ecológicas locales elaboradas con agua de manantial y certificadas Nature et Progrès."
    ]
  },
