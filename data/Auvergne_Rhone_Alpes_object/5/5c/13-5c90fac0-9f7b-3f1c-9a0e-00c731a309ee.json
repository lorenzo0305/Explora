  "rdfs:comment": {
    "de": [
      "Vélo'box ist ein individueller oder kollektiver Schließfachservice, ideal für die Kombination von Busfahrten / Auto + Fahrrad.\r\n\r\nStationen:\r\n4 Plätze Romans Gare\r\n\r\nAbonnement in den Citéa-Agenturen von Valence und Romans, Reservierungsmöglichkeit unter 04 75 600 626."
    ],
    "en": [
      "Vélo'box is an individual or collective locker service, ideal for combining bus / car + bike travel.\r\n\r\nStations :\r\n4 places Romans Gare\r\n\r\nSubscription available at Citéa agencies in Valence and Romans. Reservations can be made by calling 04 75 600 626."
    ],
    "it": [
      "Vélo?box è un servizio di armadietto individuale o collettivo, ideale per combinare viaggi in autobus/auto + bici.\r\n\r\nStazioni \r\n4 posti Romans Gare\r\n\r\nAbbonamento presso le agenzie di Valence e Romans Citéa, prenotazione possibile al numero 04 75 600 626."
    ],
    "fr": [
      "Vélo’box est un service de consigne individuelle ou collective, idéal pour combiner déplacements en bus / voiture + vélo.\r\n\r\nStations : \r\n4 places Romans Gare\r\n\r\nSouscription en agence Citéa de Valence et Romans, possibilité de réservation au 04 75 600 626."
    ],
    "es": [
      "Vélo?box es un servicio de consigna individual o colectiva, ideal para combinar viajes en autobús / coche + bicicleta.\r\n\r\nEstaciones \r\n4 plazas Romans Gare\r\n\r\nInscripción en las agencias de Valence y Romans Citéa, posibilidad de reserva en el 04 75 600 626."
    ],
    "nl": [
      "Vélo'box is een individuele of collectieve lockerservice, ideaal voor het combineren van bus / auto + fiets reizen.\r\n\r\nStations :\r\n4 plaatsen Romeins Gare\r\n\r\nAbonnement beschikbaar in de vestigingen Valence en Romans Citéa. Reserveren kan door te bellen naar 04 75 600 626."
    ]
  },
  "rdfs:label": {
