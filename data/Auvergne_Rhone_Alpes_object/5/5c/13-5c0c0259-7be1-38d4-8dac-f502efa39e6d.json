  "rdfs:comment": {
    "de": [
      "Diese gemeindeübergreifende Einrichtung bietet Ihnen einen Mineralstrand, einen Wellnessbereich, einen Kardioraum, Hammams, Saunen, Jacuzzi, ein Solarium, 3 Becken: Sportbecken, Spielbecken (Massagedüsen, Flüsse gegen die Strömung...), Planschbecken, Pentagliss."
    ],
    "en": [
      "This inter-communal facility features a mineral beach, wellness area, cardio room, steam rooms, saunas, jacuzzi, solarium, 3 pools: sports pool, leisure pool (massaging jets, counter-current rivers), paddling pool, pentagliss."
    ],
    "it": [
      "Questa struttura intercomunale offre una spiaggia minerale, un'area benessere, una sala cardio, sale vapore, saune, jacuzzi, solarium, 3 piscine: piscina sportiva, piscina per il tempo libero (getti massaggianti, fiumi controcorrente, ecc.), piscina per bambini, pentagliss."
    ],
    "fr": [
      "Cet équipement intercommunal vous propose une plage minérale, un espace bien-être, une salle cardio, hammams, saunas, jacuzzi, un solarium, 3 bassins : bassin sportif, bassin ludique (jets massant, rivières contre-courant...), pataugeoire, pentagliss."
    ],
    "es": [
      "Esta instalación intercomunal ofrece una playa mineral, una zona de bienestar, una sala de cardio, salas de vapor, saunas, jacuzzi, solárium, 3 piscinas: piscina deportiva, piscina lúdica (chorros de masaje, ríos contracorrientes, etc.), piscina infantil, pentagliss."
    ],
    "nl": [
      "Deze intercommunale biedt een mineraalstrand, een wellnessruimte, een cardiokamer, stoombaden, sauna's, jacuzzi, solarium, 3 zwembaden: sportbad, recreatiebad (massagestralen, tegenstroomrivieren, enz.), peuterbad, pentagliss."
    ]
  },
  "rdfs:label": {
