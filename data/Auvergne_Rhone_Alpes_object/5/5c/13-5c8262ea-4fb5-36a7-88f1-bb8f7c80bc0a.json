  "rdfs:comment": {
    "de": [
      "Bar-Restaurant mitten im Zentrum von Chazelles-sur-Lyon. Ein Café im Stil eines französischen Bistrots, chic und raffiniert, jedoch mit lässigem Ambiente."
    ],
    "en": [
      "Bar restaurant, right in the centre of Chazelles-sur-Lyon. French bistro-type café, chic and refined, but relaxed."
    ],
    "it": [
      "Cucina in stile bistrot con prodotti freschi provenienti da produttori locali. Brasserie, cantina di vini e birre, cantina da pranzo, gastronomia. Ristorante privato a partire da 15 persone."
    ],
    "fr": [
      "Cuisine style bistro, à base de produits frais et de producteurs locaux. Brasserie, cave à vin et bière, cave à manger, épicerie fine. Privatisation restaurant à partir de 15 personnes."
    ],
    "es": [
      "Cocina de bistró con productos frescos de productores locales. Brasserie, bodega de vinos y cervezas, comedor, tienda de delicatessen. Restaurante privado a partir de 15 personas."
    ],
    "nl": [
      "Bistrokeuken met verse producten van lokale producenten. Brasserie, wijn- en bierkelder, eetkelder, delicatessen. Privé-restaurant vanaf 15 personen."
    ]
  },
