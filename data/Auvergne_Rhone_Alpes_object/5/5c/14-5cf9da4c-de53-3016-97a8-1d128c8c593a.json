  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/70d9541e-9359-3d18-82d9-b3b72e9f8d5e",
      "dc:description": {
        "de": [
          "Willkommen im \"instant du papillon\" in Le Touquet, wo Sie durch Yoga und Ayurveda neue Energie tanken können.\n\nGEMEINSAMER YOGA-KURS /Beruhigend oder dynamisch (angepasst an das Niveau der Gruppe und die Jahreszeit) Gruppe von maximal 7 Personen , darüber hinaus für Gruppen zu Hause."
        ],
        "en": [
          "Welcome to l?instant du papillon in Le Touquet, where you can recharge your batteries with yoga and ayurveda.\n\nGROUP YOGA CLASSES / Calming or dynamic (adapted according to group level and season) group of 7 people maximum, more for home groups."
        ],
        "it": [
          "Benvenuti a l'instant du papillon a Le Touquet, dove potrete fare il pieno di energia con lo yoga e l'ayurveda.\n\nCLASSI DI YOGA DI GRUPPO / Calmante o dinamico (adattato in base al livello del gruppo e alla stagione) gruppo di 7 persone al massimo, di più per i gruppi domestici."
        ],
        "fr": [
          "Bienvenue à l ‘instant du papillon du Touquet pour vous ressourcer par le yoga et l ‘ayurvéda.\n\nCOURS DE YOGA COLLECTIF /Apaisante ou dynamique (adaptée en fonction du niveau du groupe et de la saison) groupe de 7 personnes maximum , au-delà pour groupe domicile."
        ],
        "nl": [
          "Welkom bij l'instant du papillon in Le Touquet, waar je nieuwe energie kunt opdoen met yoga en ayurveda.\n\nGROEP YOGA LESSEN / Kalmerende of dynamische (aangepast aan het niveau van de groep en het seizoen) groep van maximaal 7 personen, meer voor thuisgroepen."
        ],
        "es": [
          "Bienvenido a l'instant du papillon, en Le Touquet, donde podrá recargar las pilas con yoga y ayurveda.\n\nCLASES DE YOGA EN GRUPO / Calmantes o dinámicas (adaptadas según el nivel del grupo y la temporada) grupo de 7 personas máximo, más para grupos en casa."
        ]
      },
