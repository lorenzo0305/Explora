  "rdfs:comment": {
    "de": [
      "Tauchen Sie ein in das verrückte Musical \"En attendant Cloclo\" am 11. April 2026 ab 20 Uhr im Smart Cabaret in Brives-Charensac, wo zwei Doppelgänger, die davon überzeugt sind, die besten Sardou und Johnny zu sein, vom Ruhm träumen."
    ],
    "en": [
      "Immerse yourself in the delirious musical \"En attendant Cloclo\", on April 11, 2026 from 8pm at the Smart Cabaret in Brives-Charensac, where two look-alikes convinced they are the best Sardou and Johnny dream of glory."
    ],
    "it": [
      "Tuffatevi nella delirante commedia musicale \"En attendant Cloclo\", l'11 aprile 2026 dalle ore 20.00 allo Smart Cabaret di Brives-Charensac, dove due sosia convinti di essere i migliori Sardou e Johnny sognano la gloria."
    ],
    "fr": [
      "Plongez dans une comédie musicale délirante \"En attendant Cloclo\", le 11 avril 2026 dès 20h au Smart Cabaret de Brives-Charensac, où deux sosies convaincus d’être les meilleurs Sardou et Johnny rêvent de gloire."
    ],
    "es": [
      "Sumérjase en la delirante comedia musical \"En attendant Cloclo\", el 11 de abril de 2026 a partir de las 20:00 horas en el Smart Cabaret de Brives-Charensac, donde dos dobles convencidos de ser los mejores Sardou y Johnny sueñan con la gloria."
    ],
    "nl": [
      "Duik in de uitzinnige muzikale komedie \"En attendant Cloclo\", op 11 april 2026 vanaf 20.00 uur in het Smart Cabaret in Brives-Charensac, waar twee lookalikes die ervan overtuigd zijn dat ze de beste Sardou en Johnny zijn, dromen van roem."
    ]
  },
  "rdfs:label": {
