  "rdfs:comment": {
    "de": [
      "Das im alten Dorf gelegene L'Oule Rouge bietet Ihnen eine traditionelle, hausgemachte Küche aus frischen und regionalen Produkten."
    ],
    "en": [
      "Located in the old La Chal, the Oule Rouge restaurant offers you a homemade traditional cuisine."
    ],
    "it": [
      "Situato nel vecchio villaggio, L'Oule Rouge serve una cucina tradizionale fatta in casa con prodotti freschi locali."
    ],
    "fr": [
      "Situé dans le vieux village, l'Oule Rouge vous propose une cuisine traditionnelle faite maison à base de produits frais et régionaux."
    ],
    "es": [
      "Situado en el casco antiguo, L'Oule Rouge sirve cocina casera tradicional elaborada con productos frescos de la zona."
    ],
    "nl": [
      "Bevindt zich in het oorspronkelijke gedeelte van  gehucht La Chal.\r\nLokale specialiteiten en traditionele keuken.\r\nWinter: elke avond open, zaterdag ook overdag."
    ]
