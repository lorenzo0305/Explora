  "rdfs:comment": {
    "de": [
      "La Petite Auberge, Hotel , Bar, Restaurant , in Yssingeaux , zwischen Saint-Etienne und Le Puy-en-Velay gelegen, empfängt Sie jeden Tag der Woche (außer Freitagabend, Samstag und Sonntag)"
    ],
    "en": [
      "La Petite Auberge, hotel, bar, restaurant, located in Yssingeaux, between Saint-Étienne and Le Puy-en-Velay, welcomes you every day of the week (except Friday evening, Saturday and Sunday)"
    ],
    "it": [
      "La Petite Auberge, hotel, bar, ristorante, situato a Yssingeaux, tra Saint-Étienne e Le Puy-en-Velay, vi accoglie tutti i giorni della settimana (tranne il venerdì sera, il sabato e la domenica)"
    ],
    "fr": [
      "La Petite Auberge,  hôtel , bar, restaurant , située à Yssingeaux , entre Saint-Étienne et Le Puy-en-Velay, vous accueille tous les jours de la semaine (sauf vendredi soir, samedi et dimanche)"
    ],
    "es": [
      "La Petite Auberge, hotel, bar, restaurante, situado en Yssingeaux, entre Saint-Étienne y Le Puy-en-Velay, le da la bienvenida todos los días de la semana (excepto viernes por la noche, sábados y domingos)"
    ],
    "nl": [
      "La Petite Auberge, hotel, bar, restaurant, gelegen in Yssingeaux, tussen Saint-Étienne en Le Puy-en-Velay, verwelkomt je elke dag van de week (behalve vrijdagavond, zaterdag en zondag)"
    ]
  },
