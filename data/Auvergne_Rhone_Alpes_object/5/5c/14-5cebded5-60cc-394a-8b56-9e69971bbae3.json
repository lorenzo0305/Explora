  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/65bafba2-e668-3f67-9f9e-1c20d56a7e55",
      "dc:description": {
        "de": [
          "Halloween-Ball\n\nKomm verkleidet zum Tanzen!\n\n\nMediathek des Sandettie\nSamstag, 12. Oktober, um 16 Uhr\nFür 8-12-Jährige, mit Anmeldung"
        ],
        "en": [
          "Halloween Ball\n\nCome and dance in costume!\n\n\nMédiathèque du Sandettie\nSaturday, October 12, 4pm\nFor 8-12 year-olds, registration required"
        ],
        "it": [
          "Ballo di Halloween\n\nVenite a ballare in costume!\n\n\nBiblioteca multimediale Sandettie\nSabato 12 ottobre, ore 16.00\nPer ragazzi dagli 8 ai 12 anni, iscrizione obbligatoria"
        ],
        "fr": [
          "Bal d'Halloween\n\nViens danser déguisé !\n\n\nMédiathèque du Sandettie\nSamedi 12 octobre, à 16h\nPour les 8-12 ans, sur inscription"
        ],
        "nl": [
          "Halloweenbal\n\nKom en dans in kostuum!\n\n\nSandettie mediatheek\nZaterdag 12 oktober, 16.00 uur\nVoor 8-12 jaar, inschrijven verplicht"
        ],
        "es": [
          "Baile de Halloween\n\n¡Ven a bailar disfrazado!\n\n\nBiblioteca multimedia Sandettie\nSábado 12 de octubre, 16.00 h\nPara niños de 8 a 12 años, inscripción obligatoria"
        ]
      },
