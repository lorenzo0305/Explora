  "rdfs:comment": {
    "de": [
      "In der Nähe des Stadtzentrums in einem ruhigen Park mit Bäumen gelegen, bietet die Einrichtung, die aus einem alten charaktervollen Bauernhaus erbaut wurde, eine gastronomische Küche."
    ],
    "en": [
      "Close to the town centre in a quiet park planted with trees, the establishment, built from a former farmhouse of character, offers a gastronomic cuisine."
    ],
    "it": [
      "Vicino al centro città, in un tranquillo parco alberato, la struttura, ricavata da un'antica casa colonica di carattere, offre una cucina gastronomica."
    ],
    "fr": [
      "Près du centre-ville dans un parc arboré au calme, l'établissement, construit à partir d'un ancien corps de ferme de caractère propose une cuisine gastronomique."
    ],
    "nl": [
      "Dicht bij het stadscentrum, in een rustig bebost park, biedt het etablissement, gebouwd van een voormalige karaktervolle boerderij, een gastronomische keuken."
    ],
    "es": [
      "Cerca del centro de la ciudad, en un tranquilo parque arbolado, el establecimiento, construido a partir de una antigua granja de carácter, ofrece cocina gastronómica."
    ]
  },
  "rdfs:label": {
