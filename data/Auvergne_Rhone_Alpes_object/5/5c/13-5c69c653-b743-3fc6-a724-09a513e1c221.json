  "rdfs:comment": {
    "de": [
      "Willkommen auf der Domaine de Couron!\r\nUnsere Côtes du Rhône und Côtes du Rhône Villages St Andéol sowie unsere Landweine aus der Ardèche erwarten Sie zu einer kostenlosen Verkostung. Alle unsere Weine werden von uns selbst vinifiziert und abgefüllt. Bag In Box 5 und 10 l ."
    ],
    "en": [
      "The Couron estate stands on the sunny slopes overlooking the Provençal village of Saint Marcel d’Ardèche. Côtes du Rhône, CDR Villages and IGP Ardèche red, rosé and white wines, bottled or in 5-litre or 10-litre boxes."
    ],
    "it": [
      "Benvenuti al Domaine de Couron!\r\nI nostri Côtes du Rhône e Côtes du Rhône Villages St Andéol e i nostri Vins de Pays Ardèche vi aspettano per una degustazione gratuita. Tutti i nostri vini sono vinificati e imbottigliati da noi. Bag In Box da 5 e 10 l."
    ],
    "fr": [
      "Bienvenue au Domaine de Couron !\r\nNos Côtes du Rhône et Côtes du Rhône Villages St Andéol ainsi que nos Vins de Pays Ardèche vous attendent pour une dégustation gratuite. Tous nos vins sont vinifiés et mis en bouteilles par nos soins. Bag In Box 5 et 10 l."
    ],
    "es": [
      "¡Bienvenido al Domaine de Couron!\r\nNuestros Côtes du Rhône y Côtes du Rhône Villages St Andéol así como nuestros Vins de Pays Ardèche le esperan para una degustación gratuita. Todos nuestros vinos son vinificados y embotellados por nosotros. Bag In Box de 5 y 10 l."
    ],
    "nl": [
      "Welkom op het Domaine de Couron!\r\nOnze Côtes du Rhône en Côtes du Rhône Villages St Andéol evenals onze Vins de Pays Ardèche wachten op u voor een gratis proeverij. Al onze wijnen worden door ons gevinifieerd en gebotteld. Bag In Box 5 en 10 l"
    ]
  },
