  "rdfs:comment": {
    "de": [
      "L'Art Lie ist ein charmantes Restaurant am Flussufer, wo sich die Cité de Conflans und das Stadtzentrum treffen.\r\nHausgemachte und saisonale Küche mit Produkten aus Savoyen und Frankreich."
    ],
    "en": [
      "L'Art Lie is a charming riverside restaurant at the junction of the Cité de Conflans and the town center.\r\nHome-cooked, seasonal cuisine with products from Savoie and France."
    ],
    "it": [
      "L'Art Lie è un incantevole ristorante sul fiume all'incrocio tra la Cité de Conflans e il centro città.\r\nCucina casalinga e stagionale con prodotti della Savoia e della Francia."
    ],
    "fr": [
      "L'Art Lie est un charmant restaurant situé au bord de la rivière, à la jonction de la Cité de Conflans et du centre-ville.\r\nCuisine maison et de saison avec des produits de Savoie et de France."
    ],
    "nl": [
      "L'Art Lie is een charmant restaurant aan de rivier op de kruising van de Cité de Conflans en het stadscentrum.\r\nHuisgemaakte, seizoensgebonden gerechten met producten uit de Savoie en Frankrijk."
    ],
    "es": [
      "L'Art Lie es un encantador restaurante situado a orillas del río, en la confluencia de la Cité de Conflans y el centro de la ciudad.\r\nCocina casera y de temporada elaborada con productos de Saboya y Francia."
    ]
  },
