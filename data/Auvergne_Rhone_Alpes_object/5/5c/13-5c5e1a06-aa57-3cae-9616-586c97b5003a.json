  "rdfs:comment": {
    "de": [
      "Der vom Landschaftsarchitekten Alain Provost angelegte Parc de Saint-Clair liegt am rechten Rhôneufer in Caluire, gegenüber der Cité internationale."
    ],
    "en": [
      "The Saint-Clair park, designed by landscape architect Alain Provost, is located on the right bank of the Rhône in Caluire, opposite the Cité internationale."
    ],
    "it": [
      "Il parco di Saint-Clair, progettato dall'architetto paesaggista Alain Provost, si trova sulla riva destra del Rodano a Caluire, di fronte alla Cité internationale."
    ],
    "fr": [
      "Le parc de Saint-Clair, réalisé par l’architecte- paysager Alain Provost, est situé sur la rive droite du Rhône à Caluire, en face de la Cité internationale."
    ],
    "nl": [
      "Het park Saint-Clair, ontworpen door landschapsarchitect Alain Provost, ligt op de rechteroever van de Rhône in Caluire, tegenover de Cité internationale."
