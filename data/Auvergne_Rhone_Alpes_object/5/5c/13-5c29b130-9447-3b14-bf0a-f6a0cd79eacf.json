  "rdfs:comment": {
    "de": [
      "Yoga des Hautes Terres führt Sie auf den Wegen des Yoga. Gruppenkurse Hatha-Yoga von 90 min. Hatha- oder Yin-Yoga individuell oder in privaten Gruppen, im Saal oder in der freien Natur mit \"Yoga en Estive\". Offen für alle."
    ],
    "en": [
      "Yoga des Hautes Terres guides you along the paths of yoga. 90-minute group Hatha yoga classes. Hatha or yin yoga for individuals or private groups, indoors or outdoors with \"Yoga en Estive\". Open to all."
    ],
    "it": [
      "Yoga des Hautes Terres vi guida lungo i sentieri dello yoga. Corsi di Hatha yoga di gruppo di 90 minuti. Hatha o yin yoga per singoli o gruppi privati, all'interno o all'esterno con \"Yoga en Estive\". Aperto a tutti."
    ],
    "fr": [
      "Yoga des Hautes Terres vous guide sur les chemins du yoga. Cours collectifs de Hatha yoga de 90 min. Hatha ou yin yoga en individuels ou en groupe privé, en salle ou en pleine nature avec \"Yoga en Estive\". Ouvert à tous."
    ],
    "es": [
      "Yoga des Hautes Terres te guía por los caminos del yoga. Clases de Hatha yoga en grupo de 90 minutos. Hatha o yin yoga para particulares o grupos privados, en interior o al aire libre con \"Yoga en Estive\". Abierto a todos."
    ],
    "nl": [
      "Yoga des Hautes Terres leidt je langs de paden van yoga. Groepslessen Hatha yoga van 90 minuten. Hatha- of yin yoga voor individuen of privégroepen, binnen of buiten met \"Yoga en Estive\". Voor iedereen toegankelijk."
    ]
  },
