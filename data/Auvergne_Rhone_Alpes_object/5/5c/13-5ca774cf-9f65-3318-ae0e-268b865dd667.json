  "rdfs:comment": {
    "de": [
      "Dieses Restaurant liegt nicht weit von der Achse Lempdes Brioude in Richtung Vergongheon und ist ideal für einen Zwischenstopp auf der Durchreise oder bei der Abreise in den Urlaub."
    ],
    "en": [
      "This restaurant, located not far from the Lempdes Brioude road in the direction of Vergongheon, is ideal for a stopover when passing through or going on vacation."
    ],
    "it": [
      "Questo ristorante, situato non lontano dalla strada Lempdes Brioude in direzione Vergongheon, è ideale per una sosta quando si è di passaggio o in vacanza."
    ],
    "fr": [
      "Ce restaurant situé non loin de l'axe Lempdes Brioude en direction de Vergongheon est idéal pour faire une halte lors d'un passage ou lors de départ en vacances."
    ],
    "es": [
      "Este restaurante, situado no lejos de la carretera de Lempdes Brioude en dirección a Vergongheon, es ideal para hacer un alto en el camino cuando se está de paso o de vacaciones."
    ],
    "nl": [
      "Dit restaurant, niet ver van de weg Lempdes Brioude in de richting van Vergongheon, is ideaal voor een tussenstop op doorreis of op vakantie."
    ]
  },
