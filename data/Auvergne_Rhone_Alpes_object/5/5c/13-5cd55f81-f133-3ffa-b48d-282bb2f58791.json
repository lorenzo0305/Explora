  "rdfs:comment": {
    "de": [
      "Das Büro befindet sich in der Mitte der Einkaufsstraße, am Fuße des mittelalterlichen Dorfes, in der Ecke eines kleinen Platzes. Eine öffentliche Bank umgibt sie und lädt zum Verweilen ein. Vor Ort: kostenloses WLAN Cigale, Laden."
    ],
    "en": [
      "Located at the center of the commercial street which cross Châtillon-en-Diois, at the feet of the medieval center, our office is at the square corner. A large public bench surrounds it, stop to get information or free Internet connexion thanks to \"Cigale\"."
    ],
    "it": [
      "Situato al centro della via dello shopping, ai piedi del borgo medievale, l'ufficio si trova all'angolo di una piccola piazza. Una panchina pubblica la circonda, venite a visitarla. Sul posto: Wifi gratuito Cigale, negozio."
    ],
    "fr": [
      "Situé au centre de la rue commerçante, au pied du village médiéval, le bureau est dans l'angle d'une placette. Un banc public l'entoure, venez y faire une halte. Sur place : Wifi Cigale gratuit, boutique."
    ],
    "es": [
      "Situada en el centro de la calle comercial, a los pies de la villa medieval, la oficina hace esquina en una pequeña plaza. Un banco público lo rodea, ven y pásate por allí. En el lugar: Wifi Cigale gratuito, tienda."
    ],
    "nl": [
      "Het kantoor ligt in het midden van de winkelstraat, aan de voet van het middeleeuwse dorp, in de hoek van een klein plein. Het is omgeven door een openbare bank. Ter plaatse: gratis Cigale WiFi, winkel."
    ]
  },
  "rdfs:label": {
    "de": [
      "Pays Diois Verkehrsbüro - Châtillon-en-Diois"
    ],
