  "rdfs:comment": {
    "de": [
      "Die jährlich stattfindende Veranstaltung La Fête du court métrage entstand aus dem Wunsch heraus, den Kurzfilm einem möglichst breiten Publikum näher zu bringen."
    ],
    "en": [
      "An annual event, La Fête du court métrage was born of the desire to make short films better known to as many people as possible."
    ],
    "it": [
      "Evento annuale, La Fête du court métrage nasce dal desiderio di far conoscere i cortometraggi al maggior numero di persone possibile."
    ],
    "fr": [
      "Manifestation annuelle, La Fête du court métrage est née de la volonté de mieux faire connaître le court métrage au plus grand nombre."
    ],
    "nl": [
      "La Fête du court métrage, een jaarlijks evenement, is ontstaan uit de wens om korte films bij zoveel mogelijk mensen bekend te maken."
    ],
    "es": [
      "Evento anual, la Fête du court métrage nació del deseo de dar a conocer el cortometraje al mayor número de personas posible."
    ]
  },
  "rdfs:label": {
