  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/5b107a4a-b050-3a41-b334-8b4a98ffcfe3",
      "dc:description": {
        "de": [
          "Für kleine und große Naschkatzen Verkauf von Eis, Chichis, Zuckerwatte, Crêpes und Waffeln\n\nTäglich von 10:00 bis 19:00 Uhr geöffnet."
        ],
        "en": [
          "For young and old gourmets Sale of ice creams, chichis, cotton candy, pancakes and waffles\n\nOpen every day from 10am to 7pm."
        ],
        "it": [
          "Per grandi e piccini Vendita di gelati, chichis, zucchero filato, pancakes e waffles\n\nAperto tutti i giorni dalle 10.00 alle 19.00."
        ],
        "fr": [
          "Pour les petits et grands gourmands Vente de glaces, chichis, barbes à papa, crêpes et gaufres. \n\nOuvert tous les jours de 10h à 19h."
        ],
        "nl": [
          "Voor kleine en grote fijnproevers Verkoop van ijsjes, chichis, suikerspinnen, pannenkoeken en wafels\n\nDagelijks geopend van 10 tot 19 uur."
        ],
        "es": [
          "Para pequeños y grandes gourmets Venta de helados, chichis, candyfloss, tortitas y gofres\n\nAbierto todos los días de 10 a 19 horas."
        ]
      },
