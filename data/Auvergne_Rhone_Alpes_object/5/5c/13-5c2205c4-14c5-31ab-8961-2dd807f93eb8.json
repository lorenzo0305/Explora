  "rdfs:comment": {
    "de": [
      "Grimoire ist ein mittelalterlicher Foodtruck und Caterer, der kreative, vom Mittelalter inspirierte Hausmannskost für private oder öffentliche Veranstaltungen anbietet. Er bietet eine saisonale, authentische und lokal verankerte Küche. Er hat seinen Sitz in."
    ],
    "en": [
      "Grimoire is a medieval food truck and caterer offering creative, homemade dishes inspired by the Middle Ages for private or public events. It offers seasonal, authentic, locally sourced cuisine. It is based in."
    ],
    "it": [
      "Grimoire è un foodtruck e catering medievale che offre piatti creativi fatti in casa ispirati al Medioevo per eventi privati o pubblici. La sua cucina è stagionale, autentica e di origine locale. Ha sede a."
    ],
    "fr": [
      "Grimoire est un foodtruck et traiteur médiéval , offrant des plats maison créatifs inspirés du Moyen Âge pour événements privés ou publics. Il propose une cuisine de saison, authentique et ancrée localement. Il est basé."
    ],
    "nl": [
      "Grimoire is een middeleeuwse foodtruck en cateraar die creatieve huisgemaakte gerechten aanbiedt, geïnspireerd door de Middeleeuwen, voor privé- of openbare evenementen. De keuken is seizoensgebonden, authentiek en lokaal geworteld. Het is gevestigd in."
    ],
    "es": [
      "Grimoire es un foodtruck medieval y servicio de catering, que ofrece platos caseros creativos inspirados en la Edad Media para eventos privados o públicos. Su cocina es de temporada, auténtica y de raíz local. Tiene su sede en."
    ]
  },
