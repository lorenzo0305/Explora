  "rdfs:comment": {
    "de": [
      "Der Name Alba Ristorante erinnert an die italienische Stadt im Herzen des Piemonts.\r\nDie Hauptstadt des weißen Trüffels, der Haselnüsse und der piemontesischen Weine."
    ],
    "en": [
      "The name Alba Ristorante echoes the Italian town in the heart of Piedmont.\r\nThe capital of white truffles, hazelnuts and Piedmont wines."
    ],
    "it": [
      "Il nome Alba Ristorante riecheggia la città italiana nel cuore del Piemonte.\r\nLa capitale del tartufo bianco, delle nocciole e dei vini piemontesi."
    ],
    "fr": [
      "L'Alba Ristorante, son nom fait écho à la ville Italienne située au cœur du Piémont.\r\nLa capitale de la truffe blanche, des noisettes, et des vins piémontais."
    ],
    "es": [
      "El nombre de Alba Ristorante evoca la ciudad italiana situada en el corazón del Piamonte.\r\nLa capital de las trufas blancas, las avellanas y los vinos del Piamonte."
    ],
    "nl": [
      "De naam Alba Ristorante verwijst naar de Italiaanse stad in het hart van Piemonte.\r\nDe hoofdstad van witte truffels, hazelnoten en Piemonte wijnen."
    ]
  },
