  "rdfs:comment": {
    "de": [
      "Die Haut-Rhône ist für ihre Äschen und ihre großen Bachforellen bekannt. Der Parcours Passion de Lucey bietet eine hohe Qualität an Fischen und Fischarten."
    ],
    "en": [
      "The Haut-Rhône is renowned for its grayling and large fario trout. The Lucey Passion course offers high quality fish and fish products."
    ],
    "it": [
      "L'Haut-Rhône è rinomato per i suoi temoli e le grandi trote fario. Il corso Passion de Lucey offre pesce e prodotti ittici di alta qualità."
    ],
    "fr": [
      "Le Haut-Rhône est réputé pour ses ombres communs et ses grosses truites fario. Le parcours Passion de Lucey offre une haute qualité piscicole et halieutique."
    ],
    "es": [
      "El Haut-Rhône es famoso por sus tímalos y grandes truchas fario. El campo Passion de Lucey ofrece pescado y productos pesqueros de gran calidad."
    ],
    "nl": [
      "De Haut-Rhône staat bekend om zijn vlagzalm en grote fario-forel. De cursus Passion de Lucey biedt vis en visproducten van hoge kwaliteit."
    ]
  },
  "rdfs:label": {
    "en": [
      "\"Passion\" fishing route on the Rhône in Lucey"
    ],
    "fr": [
      "Parcours de pêche \"Passion\" sur le Rhône à Lucey"
    ],
    "nl": [
      "Passievissen op de Rhône"
    ]
  },
