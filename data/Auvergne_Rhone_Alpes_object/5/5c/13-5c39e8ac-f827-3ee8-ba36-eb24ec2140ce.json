  "rdfs:comment": {
    "de": [
      "Am Ufer des Doron bietet Ihnen der Park der Thermen die Möglichkeit, sich in einer natürlichen Umgebung zu beruhigen. Es werden Ihnen zahlreiche Sport- und Freizeitaktivitäten angeboten."
    ],
    "en": [
      "On the banks of the Doron River, the Thermes park offers you the chance to relax in a natural environment. Numerous sports and recreational activities are on offer."
    ],
    "it": [
      "Sulle rive del fiume Doron, il Parc des Thermes offre la possibilità di rilassarsi in un ambiente naturale. Numerose sono le attività sportive e ricreative proposte."
    ],
    "fr": [
      "Au bord du Doron, le parc des Thermes vous permet de vous apaiser dans un environnement naturel. De nombreuses activités sportives et récréatives vous sont proposées."
    ],
    "nl": [
      "Aan de oever van de rivier de Doron biedt het Parc des Thermes je de kans om te ontspannen in een natuurlijke omgeving. Er worden tal van sportieve en recreatieve activiteiten aangeboden."
    ],
    "es": [
      "A orillas del río Doron, el Parque Balneario le permite relajarse en un entorno natural. Existen numerosas actividades deportivas y recreativas."
    ]
  },
