  "rdfs:comment": {
    "de": [
      "Oréade, das Wellness- und Gourmetabenteuer! Egal zu welcher Jahreszeit, entspannen Sie sich in unserem umweltfreundlichen und spielerischen Wellnessbereich: Saunen, nordische Bäder im Freien, Ruhejurte... Testen Sie auch unsere Massagen und Schönheitsbehandlungen."
    ],
    "en": [
      "Oréade, nature’s feel-good gateway! \r\nOutdoor spa : sauna, nordic baths (hot baths), yurt\r\nWellness : massages, beauty care"
    ],
    "it": [
      "Oréade, l'avventura del benessere gourmet! In qualsiasi stagione, rilassatevi nella nostra area benessere ecologica e divertente: saune, bagni nordici all'aperto, yurte per il riposo... Potete anche provare i nostri massaggi e trattamenti di bellezza."
    ],
    "fr": [
      "Oréade, l'aventure bien-être et gourmande ! Quelle que soit la saison, délassez-vous dans notre espace balnéo écologique et ludique : saunas, bains nordiques en extérieur, yourte de repos... Testez également nos massages et soins esthétiques."
    ],
    "nl": [
      "Oréade, het wellnessavontuur voor fijnproevers! Ontspan in elk seizoen in onze ecologische en ludieke wellnessruimte: sauna's, nordic buitenbaden, rust in een yurt... Je kunt ook onze massages en schoonheidsbehandelingen proberen."
    ],
    "es": [
      "Oréade, ¡la aventura gourmet del bienestar! Sea cual sea la estación, relájese en nuestra zona de spa ecológica y divertida: saunas, baños nórdicos al aire libre, yurta de descanso... También puede probar nuestros masajes y tratamientos de belleza."
    ]
  },
