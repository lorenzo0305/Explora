  "rdfs:comment": {
    "de": [
      "Seit mehr als vierzig Jahren kochen und servieren Louise und Michel in dem geselligen und beliebten Restaurant, in dem man ganz selbstverständlich mit den anderen Tischen in Kontakt kommt und lacht."
    ],
    "en": [
      "How about discovering one of the most iconic establishments in Sainté? Head over to the Quartier des Martyrs, more particularly the bucolic pedestrian street, Rue Georges Dupré."
    ],
    "it": [
      "Volete scoprire uno degli stabilimenti più emblematici di Sainté? Dirigetevi verso il quartiere di St Jacques e in particolare la bucolica e pedonale Rue Georges Dupré."
    ],
    "fr": [
      "Ca vous tente de découvrir un des établissements les plus emblématiques de Sainté ? Direction le quartier st jacques et plus particulièrement la très bucolique et piétonne rue Georges Dupré."
    ],
    "es": [
      "¿Desea descubrir uno de los establecimientos más emblemáticos de Sainté? Diríjase al barrio de St Jacques y, más concretamente, a la calle Georges Dupré, muy bucólica y peatonal."
    ],
    "nl": [
      "Wilt u een van de meest emblematische etablissementen van Sainté ontdekken? Ga naar de wijk St Jacques en meer in het bijzonder naar de zeer bucolische en autovrije Rue Georges Dupré."
    ]
  },
