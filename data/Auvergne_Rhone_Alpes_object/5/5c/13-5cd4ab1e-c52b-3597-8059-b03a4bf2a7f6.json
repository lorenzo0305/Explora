  "rdfs:comment": {
    "de": [
      "Bildende Künstlerin, Acrylmalerei auf Steinen, Möbeln, Bildern.\r\nArbeiten auf Papier.\r\nIch bin Autodidaktin und lasse mich von der Technik des Pointillismus inspirieren, bei der eine Reihe von sehr engen Punkten ausgeführt werden, die aufeinander folgen und sich nicht vermischen."
    ],
    "en": [
      "Plastic artist, acrylic painting on stone, furniture, paintings.\r\nPaper work.\r\nSelf-taught, I draw my inspiration from the pointillism technique, which consists in painting a series of tightly-packed dots that follow one another and don't blend."
    ],
    "it": [
      "Artista plastico, pittura acrilica su pietra, mobili, dipinti.\r\nLavori su carta.\r\nAutodidatta, mi ispiro alla tecnica del puntinismo, che consiste in una serie di punti molto ravvicinati che si susseguono senza fondersi."
    ],
    "fr": [
      "Plasticienne,  peinture acrylique sur pierres,  meubles,  tableaux. \r\nTravail du papier.\r\nAutodidacte, je m'inspire de la technique du pointillisme, qui consiste à effectuer une série de points très serrés qui se suivent et qui ne se mélangent pas."
    ],
    "nl": [
      "Beeldend kunstenaar, acrylverf op steen, meubels, schilderijen.\r\nPapierwerk.\r\nIk ben autodidact en haal mijn inspiratie uit de pointillisme-techniek, die bestaat uit een reeks zeer dicht op elkaar geplaatste stippen die elkaar opvolgen en niet in elkaar overlopen."
    ],
    "es": [
      "Artista plástico, pintura acrílica sobre piedra, muebles, cuadros.\r\nObra sobre papel.\r\nAutodidacta, me inspiro en la técnica del puntillismo, que consiste en una serie de puntos muy apretados que se suceden y no se mezclan."
    ]
  },
  "rdfs:label": {
    "fr": [
