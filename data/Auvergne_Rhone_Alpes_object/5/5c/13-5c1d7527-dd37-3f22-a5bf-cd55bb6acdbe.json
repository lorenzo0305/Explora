  "rdfs:comment": {
    "de": [
      "Die Stadt Mornant beherbergt die Etappe 5: Cormoranche-sur-Saône? Colombier-le-Vieux (205 km) :\r\nDies ist die längste Etappe mit über 3000 Höhenmetern. Die Verbindungsleute aus der Ardèche könnten neue Abstände in der Gesamtwertung schaffen."
    ],
    "en": [
      "The town of Mornant hosts Stage 5: Cormoranche-sur-Saône ? Colombier-le-Vieux (205 km):\r\nThis is the longest stage, with over 3000 m of ascent. The Ardèche links could create new gaps in the overall classification."
    ],
    "it": [
      "La città di Mornant ospita la quinta tappa: Cormoranche-sur-Saône ? Colombier-le-Vieux (205 km):\r\nÈ la tappa più lunga, con oltre 3000 m di dislivello. I corridori dell'Ardèche potrebbero creare ulteriori distacchi nella classifica generale."
    ],
    "fr": [
      "La ville de Mornant accueille l'Étape 5 : Cormoranche-sur-Saône – Colombier-le-Vieux (205 km) : \r\nC’est l’étape la plus longue, avec plus de 3000 m de dénivelé. Les relies ardéchois pourraient créer de nouveaux écarts au classement général."
    ],
    "es": [
      "La ciudad de Mornant acoge la Etapa 5: Cormoranche-sur-Saône ? Colombier-le-Vieux (205 km):\r\nEs la etapa más larga, con más de 3000 m de ascensión. Los corredores de Ardèche podrían abrir nuevas brechas en la clasificación general."
    ],
    "nl": [
      "De stad Mornant is gastheer van Etappe 5: Cormoranche-sur-Saône ? Colombier-le-Vieux (205 km):\r\nDit is de langste etappe, met meer dan 3000 meter klimmen. De renners uit de Ardèche kunnen nog meer gaten slaan in het algemeen klassement."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Course cycliste Paris-Nice : étape 5"
    ]
  },
