  "rdfs:comment": {
    "de": [
      "Das 1600 Café ist eine Bar und ein Schnellrestaurant, die sich an der Schneefront gegenüber der Rodelbahn befindet. Wir servieren von 8:30 Uhr bis ca. 17:00 Uhr, 17:30 Uhr (je nachdem, wann die Skilifte schließen).  Wir sind ein Café, eine Bar und ein Imbiss."
    ],
    "en": [
      "The 1600 Café is a fast food and bar establishment located on the snow front, opposite the toboggan run. We serve from 8.30 a.m. until approximately 5 p.m., 5.30 p.m. (depending on the closing of the ski lifts). We are a cafe, bar, snack."
    ],
    "it": [
      "Le 1600 Café è un bar e fast food situato sul fronte neve, di fronte alla pista da slittino. Serviamo dalle 8.30 del mattino fino alle 17.00, 17.30 circa (a seconda della chiusura degli impianti di risalita).  Siamo un caffè, un bar e uno snack bar."
    ],
    "fr": [
      "Le 1600 Café est un établissement bar et restauration rapide situé sur le front de neige, en face de la piste de luge. Nous servons de 8h30 jusque environ 17h, 17h30 (en fonction de la fermeture des remontées mécaniques).  Nous sommes un café, bar, snack."
    ],
    "es": [
      "Le 1600 Café es un bar y establecimiento de comida rápida situado en el frente de nieve, frente a la pista de trineo. Servimos desde las 8.30 h hasta las 17.00 h aproximadamente, 17.30 h (dependiendo de cuándo cierren los remontes).  Somos un café, bar y snack bar."
    ],
    "nl": [
      "Het 1600 Café is een fastfoodrestaurant gelegen aan het sneeuwfront, tegenover de rodelbaan.\r\nWij bedienen van 8.30 uur tot circa 17.00 uur, 17.30 uur (afhankelijk van sluiting van de skiliften).\r\nWij zijn een café, bar, snackbar."
    ]
  },
