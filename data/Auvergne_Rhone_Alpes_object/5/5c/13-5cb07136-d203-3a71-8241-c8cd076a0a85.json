  "rdfs:comment": {
    "de": [
      "Der Chefkoch Claude Trincaz, Maître Restaurateur, lädt Sie an seinen Tisch ein, um die guten Geschmäcker der französischen Küche wiederzuentdecken. Seine feine Beherrschung der regionalen Produkte und sein hausgemachtes Essen werden Sie in ein Erlebnis vom Amuse-Bouche bis zum Dessert eintauchen lassen."
    ],
    "en": [
      "Chef Claude Trincaz, master restaurateur, invites you to his table to rediscover the good flavors of French cuisine. His fine mastery of local products and his homemade will immerse you in an experience from appetizer to dessert."
    ],
    "it": [
      "Lo chef Claude Trincaz, maestro ristoratore, vi invita alla sua tavola per riscoprire i buoni sapori della cucina francese. La sua raffinata padronanza dei prodotti locali e la sua cucina casalinga vi faranno immergere in un'esperienza che va dall'amuse-bouche al dessert."
    ],
    "fr": [
      "Le chef Claude Trincaz, maître restaurateur, vous invite à sa table pour redécouvrir les bonnes saveurs de la cuisine française. Sa fine maîtrise des produits du terroir et son fait maison vous plongeront dans une expérience de l’amuse-bouche au dessert."
    ],
    "nl": [
      "Meesterkok Claude Trincaz nodigt je uit aan zijn tafel om de heerlijke smaken van de Franse keuken te herontdekken. Zijn fijne beheersing van lokale producten en huisgemaakte gerechten zal je onderdompelen in een ervaring van amuse tot dessert."
    ],
    "es": [
      "El Chef Claude Trincaz, maestro restaurador, le invita a su mesa para redescubrir los buenos sabores de la cocina francesa. Su fino dominio de los productos locales y su cocina casera le sumergirán en una experiencia desde el amuse-bouche hasta el postre."
    ]
  },
  "rdfs:label": {
