  "rdfs:comment": {
    "de": [
      "Entdecken Sie den \"Chemin du Vallon\" in Méribel, eine Schneeschuhwanderung, die ideal für sportliche Wanderer ist. Genießen Sie eine idyllische Route inmitten der verschneiten Landschaft. Ein einzigartiges Outdoor-Erlebnis ist garantiert!"
    ],
    "en": [
      "Discover the \"Chemin du Vallon\" in Méribel, a snowshoe trail ideal for sporty hikers. Enjoy a bucolic itinerary through snow-covered landscapes. A unique outdoor experience guaranteed!"
    ],
    "it": [
      "Scoprite lo \"Chemin du Vallon\" a Méribel, un percorso con le racchette da neve ideale per gli escursionisti sportivi. Godetevi un itinerario bucolico nel cuore di paesaggi innevati. Un'esperienza unica all'aria aperta garantita!"
    ],
    "fr": [
      "Découvrez le \"Chemin du Vallon\" à Méribel, un parcours en raquettes idéal pour les randonneurs sportifs. Profitez d’un itinéraire bucolique au coeur des paysages enneigés. Expérience unique en plein air garantie!"
    ],
    "nl": [
      "Ontdek de \"Chemin du Vallon\" in Méribel, een sneeuwschoenpad dat ideaal is voor sportieve wandelaars. Geniet van een bucolische route in het hart van besneeuwde landschappen. Een unieke buitenervaring gegarandeerd!"
    ],
    "es": [
      "Descubra el \"Chemin du Vallon\" en Méribel, un sendero para raquetas de nieve ideal para senderistas deportistas. Disfrute de un itinerario bucólico en el corazón de paisajes nevados. ¡Una experiencia única al aire libre garantizada!"
    ]
  },
  "rdfs:label": {
    "en": [
      "Winter footpath \"Chemin du Vallon\" (Snowshoes)"
    ],
    "fr": [
      "Sentier piéton - Hiver \"Chemin du Vallon\" (Raquettes)"
    ],
    "nl": [
      "Winterwandelpad \"Chemin du Vallon\" (sneeuwschoenen)"
    ]
  },
