  "rdfs:comment": {
    "de": [
      "Der Strand liegt am Fuße des prächtigen Schlosses von Val und wird während der Sommermonate (Juli - August) von einem Bademeister überwacht"
    ],
    "en": [
      "Situated at the foot of the sumptuous Châteaux de Val, the beach is supervised by a lifeguard during the summer months."
    ],
    "it": [
      "Situata ai piedi del sontuoso Château de Val, la spiaggia è sorvegliata da un bagnino durante i mesi estivi (luglio-agosto)"
    ],
    "fr": [
      "Située au pied du somptueux château de Val, la plage est surveillée par un maître nageur pendant la période estivale (juillet -août)"
    ],
    "es": [
      "Situada a los pies del suntuoso Château de Val, la playa está vigilada por un socorrista durante los meses de verano (julio-agosto)"
    ],
