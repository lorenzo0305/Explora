  "rdfs:comment": {
    "de": [
      "Die Weinkellerei Jean-Pierre LEZIN, Ernteproduzent in Chavanay (42), bietet Ihnen Weine aus den Appellationen Côte Rôtie, Condrieu und Saint-Joseph sowie Landweine an."
    ],
    "en": [
      "The Cave Jean-Pierre Lézin, a winery in Chavanay (42) offers you wines from the Côte rôtie, Condrieu and Saint-Joseph appellations."
    ],
    "it": [
      "La Cave Jean-Pierre LEZIN, produttrice e vendemmiatrice di Chavanay (42), offre vini della Côte Rôtie, Condrieu e Saint-Joseph, oltre a vini locali."
    ],
    "fr": [
      "La Cave Jean-Pierre LEZIN, producteur récoltant à Chavanay (42) vous propose des vins d'appellation Côte Rôtie, Condrieu et Saint-Joseph ainsi que des vins de pays."
    ],
    "es": [
      "La Cave Jean-Pierre LEZIN, productor y cosechero de Chavanay (42) le ofrece vinos de Côte Rôtie, Condrieu y Saint-Joseph, así como vinos locales."
    ],
    "nl": [
      "De Cave Jean-Pierre LEZIN, producent en oogstbedrijf in Chavanay (42) biedt u Côte Rôtie-, Condrieu- en Saint-Joseph-wijnen en lokale wijnen."
    ]
