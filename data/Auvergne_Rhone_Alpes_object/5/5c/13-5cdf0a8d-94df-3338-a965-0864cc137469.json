  "rdfs:comment": {
    "de": [
      "Tagesmenüs oder à la carte auf Reservierung von Montag bis Freitag\r\n\r\nUnser Restaurant empfängt Sie zum Mittagessen von Montag bis Freitag von 12:00 bis 13:30 Uhr.\r\nZahlreiche Formeln, Tagesgericht, à la carte.\r\nHausgemachte Küche mit Liebe gemacht!"
    ],
    "en": [
      "Menus of the day or à la carte on reservation Monday to Friday\r\n\r\nOur restaurant welcomes you for lunch Monday to Friday, from noon to 1:30pm.\r\nNumerous formulas, daily specials and à la carte menus\r\nHome cooking made with love!"
    ],
    "it": [
      "Menù giornaliero o à la carte disponibile su prenotazione dal lunedì al venerdì\r\n\r\nIl nostro ristorante vi accoglie a pranzo dal lunedì al venerdì, dalle 12.00 alle 13.30\r\nNumerose formule, piatto del giorno, menù à la carte\r\nCucina casalinga fatta con amore!"
    ],
    "fr": [
      "Menus du jour ou à la carte sur réservation du lundi au vendredi\r\n\r\nNotre restaurant vous accueille pour le déjeuner du lundi au vendredi de midi à 13h30\r\nNombreuses formules, plat du jour, carte \r\nCuisine maison faite avec Amour !"
    ],
    "es": [
      "Menús del día o a la carta disponibles previa reserva de lunes a viernes\r\n\r\nNuestro restaurante le recibe para almorzar de lunes a viernes, de 12.00 a 13.30 h\r\nNumerosas fórmulas, plato del día, menú a la carta\r\n¡Cocina casera hecha con amor!"
    ],
    "nl": [
      "Dagmenu's of à la carte menu's beschikbaar op reservering van maandag tot vrijdag\r\n\r\nOns restaurant verwelkomt u voor de lunch van maandag tot vrijdag, van 12u tot 13u30.\r\nTalrijke formules, dagschotel, à la carte menu\r\nThuis koken met liefde!"
    ]
  },
