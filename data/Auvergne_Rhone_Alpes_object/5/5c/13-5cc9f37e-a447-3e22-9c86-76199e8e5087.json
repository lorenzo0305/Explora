  "rdfs:comment": {
    "de": [
      "Hier finden Sie Obst, Gemüse, Brot, Getränke, Fleisch, Käse, verschiedene Konserven, Trockenprodukte ... mit einer großen Auswahl an Bio-Produkten auch."
    ],
    "en": [
      "You'll find fruit, vegetables, breads, drinks, meats, cheeses, various preserves, dried products... and a wide choice of organic products too."
    ],
    "it": [
      "Troverete frutta, verdura, pane, bevande, carni, formaggi, conserve varie, prodotti secchi... e un'ampia scelta di prodotti biologici."
    ],
    "fr": [
      "Vous y trouverez des fruits, légumes, pains, boissons, viandes, fromages, conserves diverses, produits secs... avec un grand choix de produits bio également."
    ],
    "nl": [
      "Je vindt er fruit, groenten, brood, drankjes, vleeswaren, kazen, verschillende conserven, gedroogde producten... en ook een ruime keuze aan biologische producten."
    ],
    "es": [
      "Encontrará frutas, verduras, pan, bebidas, carnes, quesos, conservas variadas, productos secos... y también una amplia selección de productos ecológicos."
    ]
  },
  "rdfs:label": {
