  "rdfs:comment": {
    "de": [
      "Genießen Sie auf der schattigen Terrasse mit Blick auf den Lac aux Ramiers eine raffinierte und schmackhafte Gourmetküche sowie eine sanfte und gemütliche Atmosphäre."
    ],
    "en": [
      "On the shaded terrace overlooking the Lac aux Ramiers, enjoy a gourmet, refined and flavourful cuisine, in a warm and welcoming atmosphere."
    ],
    "it": [
      "Sulla terrazza ombreggiata con vista sul Lac aux Ramiers, gustate una cucina gourmet raffinata e gustosa e un'atmosfera calda e accogliente."
    ],
    "fr": [
      "Sur la terrasse ombragée surplombant le Lac aux Ramiers, profitez d'une cuisine gourmande, raffinée et savoureuse, ainsi que d'une ambiance douce et chaleureuse."
    ],
    "nl": [
      "Geniet op het schaduwrijke terras met uitzicht op het Lac aux Ramiers van verfijnde, smakelijke gastronomische gerechten en een warme, vriendelijke sfeer."
    ],
    "es": [
      "En la terraza a la sombra con vistas al lago de Ramiers, disfrute de una cocina gastronómica refinada y sabrosa y de un ambiente cálido y acogedor."
    ]
  },
