  "rdfs:comment": {
    "de": [
      "Das Restaurant Le Tremplin, das nur zwei Schritte vom Zentrum von Morzine entfernt liegt, verwöhnt alle Geschmacksnerven mit lokaler Küche, Gourmetküche aus aller Welt und gepflegten Gerichten."
    ],
    "en": [
      "The restaurant Le Tremplin, located at 2 steps of the center of Morzine with local and world food to satisfy all the appetites..\r\nA the foot of \"Le Pleney Ski Lift\"."
    ],
    "it": [
      "Il ristorante Le Tremplin, situato a pochi passi dal centro di Morzine, delizia tutti i palati con la sua cucina locale, gourmet e preparata con cura."
    ],
    "fr": [
      "Le restaurant Le Tremplin, situé à 2 pas du centre de Morzine, régale toutes les papilles avec une cuisine locale, du Monde gourmande et soignée."
    ],
    "nl": [
      "Het restaurant Le Tremplin, op een steenworp afstand van het centrum van Morzine, verwent elke smaakpapil met zijn heerlijke, zorgvuldig bereide lokale en wereldkeuken."
    ],
    "es": [
      "El restaurante Le Tremplin, situado a tiro de piedra del centro de Morzine, deleita a todos los paladares con su cocina local, gourmet y cuidadosamente elaborada."
    ]
  },
