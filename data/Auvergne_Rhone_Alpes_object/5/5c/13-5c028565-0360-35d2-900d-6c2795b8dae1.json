  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Château d'Envaux, einen herrschaftlichen Wohnsitz aus dem 16. Jahrhundert, mit seinen Weinkellern und seiner Kapelle. Es erwartet Sie eine Viognier-Verkostung."
    ],
    "en": [
      "Come and explore Château d'Envaux, a 16th century manor house with its cellars and chapel. A tasting of Viognier is waiting for you."
    ],
    "it": [
      "Venite a scoprire lo Château d'Envaux, un maniero del XVI secolo con cantine e cappella. Vi attende una degustazione di Viognier."
    ],
    "fr": [
      "Venez à la découverte du Château d'Envaux, demeure seigneuriale du XVIème siècle avec ses caves et sa chapelle. Une dégustation de Viognier vous attend."
    ],
    "es": [
      "Venga a descubrir el Château d'Envaux, una casa solariega del siglo XVI con sus bodegas y su capilla. Le espera una degustación de Viognier."
    ],
    "nl": [
      "Kom en ontdek Château d'Envaux, een 16e-eeuws landhuis met zijn kelders en kapel. Er wacht een proeverij van Viognier op je."
    ]
  },
