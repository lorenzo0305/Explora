  "rdfs:comment": {
    "de": [
      "Familienweingut, das von Generation zu Generation weitergegeben wird, auf den Granithängen von Vaux-en-Beaujolais. Parzellenselektionen, schwefelfreie Cuvées, althergebrachte Weinbereitungsmethoden, Innovation und Weitergabe sind die DNA der Domaine le Fagolet."
    ],
    "en": [
      "Family domain handed down from generation to generation on the granite slopes of Vaux-en-Beaujolais. Parcel selections, sulphur-free vintages, ancestral vinification methods, innovation and transmission are the DNA of Domaine le Fagolet."
    ],
    "it": [
      "Tenuta familiare tramandata di generazione in generazione sui pendii granitici di Vaux-en-Beaujolais. Selezione delle parcelle, vini senza solfiti, metodi di vinificazione ancestrali, innovazione e trasmissione sono il DNA del Domaine le Fagolet."
    ],
    "fr": [
      "Domaine Familial transmis de génération en génération sur les coteaux granitiques de Vaux-en-Beaujolais. Sélections parcellaires, cuvées sans soufre, méthodes de vinification ancestrales, innovation et transmission sont l’ADN du Domaine le Fagolet."
    ],
    "es": [
      "Finca familiar transmitida de generación en generación en las laderas de granito de Vaux-en-Beaujolais. La selección de las parcelas, los vinos sin azufre, los métodos ancestrales de vinificación, la innovación y la transmisión son el ADN del Domaine le Fagolet."
    ],
    "nl": [
      "Familiedomein overgedragen van generatie op generatie op de granieten hellingen van Vaux-en-Beaujolais. Selectie van percelen, zwavelvrije wijnjaren, voorouderlijke vinificatiemethoden, innovatie en overdracht vormen het DNA van Domaine le Fagolet."
    ]
  },
  "rdfs:label": {
    "en": [
      "Le Fagolet estate"
    ],
    "fr": [
      "Domaine Le Fagolet"
    ]
  },
