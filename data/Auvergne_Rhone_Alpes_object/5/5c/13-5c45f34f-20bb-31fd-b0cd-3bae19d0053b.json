  "rdfs:comment": {
    "de": [
      "Gehen Sie auf die Anhöhen von Saint-Galmier zum Bistrot de la Poste, ganz in der Nähe des Casinos (und der Post, Sie haben es erraten). Hier ist der perfekte Ort zum Essen und Genießen!"
    ],
    "en": [
      "Welcome to the Bistrot de la Poste in Saint-Galmier! Enjoy home cooking, prepared with seasonal ingredients and featuring local flavours, all with a panoramic view over the Forez plain."
    ],
    "it": [
      "Dirigetevi verso le alture di Saint-Galmier al Bistrot de la Poste, proprio accanto al Casinò (e all'Ufficio Postale, come avrete capito). È il posto perfetto per mangiare e ammirare il panorama!"
    ],
    "fr": [
      "Direction les hauteurs de Saint-Galmier au Bistrot de la Poste, tout prêt du Casino (et de la Poste, vous l'aurez devinez). Voilà le spot parfait pour manger et en prendre plein les mirettes !"
    ],
    "nl": [
      "Ga naar de hoogten van Saint-Galmier naar de Bistrot de la Poste, vlak naast het casino (en het postkantoor, zoals je misschien al had geraden). Het is de perfecte plek om te eten en de bezienswaardigheden te bekijken!"
    ],
    "es": [
      "Dirígete a las alturas de Saint-Galmier, al Bistrot de la Poste, justo al lado del Casino (y de la Oficina de Correos, como habrás adivinado). Es el lugar perfecto para comer y disfrutar de las vistas"
    ]
  },
  "rdfs:label": {
