  "rdfs:comment": {
    "de": [
      "Dieses Hotel, Bar und Restaurant befindet sich in idealer Lage im Herzen von Monistrol-sur-Loire. Es besteht aus 8 Zimmern, darunter 2 Familienzimmer, die alle neu renoviert wurden und in einem aktuellen und angenehmen Stil eingerichtet sind. Familiärer und freundlicher Empfang."
    ],
    "en": [
      "This hotel-bar-restaurant is ideally located in the heart of Monistrol-sur-Loire. It has 8 rooms, including 2 family rooms, all refurbished in a modern, pleasant style. A friendly family welcome."
    ],
    "it": [
      "Questo hotel-bar-ristorante è situato in posizione ideale nel cuore di Monistrol-sur-Loire. Dispone di 8 camere, di cui 2 familiari, tutte rinnovate in uno stile moderno e piacevole. Un'accoglienza familiare e amichevole."
    ],
    "fr": [
      "Cet Hôtel-bar-restaurant est idéalement situé en plein cœur de Monistrol-sur-Loire. Il est composé de 8 chambres, dont 2 chambres familiales, toutes refaites à neuf, dans un style actuel et agréable. Accueil familial et convivial."
    ],
    "es": [
      "Este hotel-bar-restaurante goza de una ubicación ideal en el corazón de Monistrol-sur-Loire. Dispone de 8 habitaciones, 2 de ellas familiares, todas reformadas en un estilo moderno y agradable. Una acogida familiar y acogedora."
    ],
    "nl": [
      "Dit hotel-bar-restaurant is ideaal gelegen in het hart van Monistrol-sur-Loire. Het heeft 8 kamers, waaronder 2 familiekamers, allemaal gerenoveerd in een eigentijdse en aangename stijl. Een vriendelijk familie-ontvangst."
    ]
  },
  "rdfs:label": {
    "fr": [
