  "rdfs:comment": {
    "de": [
      "Die Route beginnt mit einem leichten Anstieg auf der roten Piste von Rochassons und zweigt dann rechts in den Wald ab, wo Sie einige atemberaubende Ausblicke auf das Tal genießen können."
    ],
    "en": [
      "The route begins with a gentle climb on the red Les Rochassons trail, then forks right into the heart of the forest, offering some breathtaking views over the valley."
    ],
    "it": [
      "Il percorso inizia con una leggera salita sulla pista rossa di Les Rochassons, per poi biforcarsi a destra nel cuore della foresta, offrendo una vista mozzafiato sulla valle."
    ],
    "fr": [
      "L’itinéraire débute par une légère montée sur la piste rouge des Rochassons puis bifurquer à droite au cœur de la forêt, offrant quelques points de vue imprenables sur la vallée."
    ],
    "es": [
      "La ruta comienza con una suave subida por la pista roja de Les Rochassons, y luego se bifurca a la derecha en el corazón del bosque, ofreciendo unas vistas impresionantes sobre el valle."
    ],
    "nl": [
      "De route begint met een lichte klim over het rode Les Rochassons-pad en maakt dan een splitsing midden in het bos, waar je prachtige uitzichten hebt over de vallei."
    ]
  },
  "rdfs:label": {
    "en": [
      "Ski touring trail La Serpentine"
    ],
    "fr": [
      "Itinéraire ski de randonnée La Serpentine"
    ],
    "nl": [
      "Toerskiroute La Serpentine"
    ]
  },
