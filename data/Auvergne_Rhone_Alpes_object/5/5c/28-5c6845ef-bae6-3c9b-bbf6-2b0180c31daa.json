  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/2a4b81a1-fc66-3043-b901-31e60a6fd698",
      "dc:description": {
        "de": [
          "Ein Restaurant für Feinschmecker mit regionalen Spezialitäten, eine gemütliche Bar und eine Bühne für Musikliebhaber....Und eine schöne Sonnenterrasse in einer grünen Ecke!\nDie Woche über jeden Mittag geöffnet und am Wochenende Dinnerkonzert."
        ],
        "en": [
          "A restaurant for local gourmets, a cosy bar and a stage for music lovers....And a lovely sunny terrace in a green setting!\nOpen for lunch every day of the week and dinner concerts at weekends."
        ],
        "it": [
          "Un ristorante per gli amanti della cucina locale, un bar accogliente e un palco per gli amanti della musica....E una bella terrazza soleggiata in un angolo di verde!\nAperto a pranzo tutti i giorni della settimana e a cena nei fine settimana."
        ],
        "fr": [
          "Un resto pour les gourmands des bonnes choses du terroir, un bar chaleureux et une scène pour les amateurs de musique....Et une belle terrasse ensoleillée dans un coin de verdure !\nOuvert tous les midis de la semaine et dîner concert le week-end."
        ],
        "es": [
          "Un restaurante para los amantes de la comida local, un bar acogedor y un escenario para los amantes de la música....¡Y una encantadora terraza soleada en un rincón de vegetación!\nAbierto para almorzar todos los días de la semana y para cenar conciertos los fines de semana."
        ],
        "nl": [
          "Een restaurant voor liefhebbers van lokaal eten, een gezellige bar en een podium voor muziekliefhebbers....En een heerlijk zonnig terras in een hoekje van groen!\nElke dag van de week geopend voor lunch en in het weekend voor dinerconcerten."
        ]
      },
      "@type": [
        "Description"
      ],
