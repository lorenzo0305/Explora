      "dc:description": {
        "de": [
          "Fahrschule seit 1978 zu Ihren Diensten! 6 qualifizierte Fahrlehrer, die Ihnen zuhören, 2 Räume für den Code, private Motorradpiste und ultrarealistischer Fahrsimulator."
        ],
        "en": [
          "Driving school at your service since 1978! 6 qualified instructors at your service, 2 code rooms, private motorcycle track and ultra-realistic driving simulator."
        ],
        "it": [
          "Scuola guida al vostro servizio dal 1978! 6 istruttori qualificati al vostro servizio, 2 sale di prova, pista privata per moto e simulatore di guida ultra-realistico."
        ],
        "fr": [
          "Auto-école à votre service depuis 1978 ! 6 moniteurs qualifiés à votre écoute, 2 salles de code, piste moto privée et simulateur de conduite ultra réaliste."
        ],
        "nl": [
          "Rijschool tot uw dienst sinds 1978! 6 gediplomeerde instructeurs tot uw dienst, 2 rijexamenlokalen, privé motorcircuit en ultra-realistische rijsimulator."
        ],
        "es": [
          "Autoescuela a su servicio desde 1978 6 profesores cualificados a su servicio, 2 salas de examen de conducir, pista de motos privada y simulador de conducción ultrarrealista."
        ]
      },
