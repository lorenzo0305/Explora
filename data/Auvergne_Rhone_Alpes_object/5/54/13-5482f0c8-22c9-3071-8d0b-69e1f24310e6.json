  "rdfs:comment": {
    "de": [
      "Modeschmuck, der Frauen, Männer und Kinder begeistern wird, geschmackvoll gefertigt und von hoher Qualität. Feinsteinzeug, Muranoglas, Swarovski-Kristalle und Leder. Erhältlich in der Touristeninformation und in meinem Atelier nach Vereinbarung."
    ],
    "en": [
      "Quality dress jewellery for women, men and children using ornamental stones, Murano glass, swarovski crystal and leather. For sale at the Tourist Office and online Etsy."
    ],
    "it": [
      "Bigiotteria per deliziare donne, uomini e bambini, realizzata con gusto e qualità. Pietre pregiate, vetro di Murano, cristalli Swarovski e pelle. In vendita presso l'ufficio turistico e nel mio laboratorio su appuntamento."
    ],
    "fr": [
      "Des bijoux fantaisie qui raviront femmes, hommes et enfants, réalisés avec goût et de qualité. Pierres fines, verre de Murano, cristaux de Swarovski et cuir. En vente à l'office de tourisme et à mon atelier sur rdv."
    ],
    "nl": [
      "Kostuumjuwelen voor vrouwen, mannen en kinderen, gemaakt met smaak en kwaliteit. Fijne stenen, Murano glas, Swarovski kristallen en leer. Te koop bij het VVV-kantoor en in mijn atelier op afspraak."
    ],
    "es": [
      "Bisutería para deleitar a mujeres, hombres y niños, hecha con gusto y calidad. Piedras finas, cristal de Murano, cristales de Swarovski y cuero. A la venta en la oficina de turismo y en mi taller con cita previa."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Noam Bijou"
    ]
  },
