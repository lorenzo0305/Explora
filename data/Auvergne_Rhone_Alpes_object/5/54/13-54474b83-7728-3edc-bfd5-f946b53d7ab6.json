  "rdfs:comment": {
    "de": [
      "Willkommen bei DINO FOOD. Bei uns ist das kein Kino! Hier wird hausgemacht gekocht, die Atmosphäre ist durch und durch chillig und die Dekoration könnte die stylischsten Influencer auf Instagram neidisch machen..."
    ],
    "en": [
      "Welcome to DINO FOOD. We're not a movie theater! The food is homemade, the atmosphere is chill as can be, and the decor could make Instagram's most stylish influencers jealous..."
    ],
    "it": [
      "Benvenuti a DINO FOOD. Non siamo il cinema! Il cibo è fatto in casa, l'atmosfera è quanto di più rilassante si possa desiderare e l'arredamento potrebbe far invidia ai più eleganti influencer di Instagram..."
    ],
    "fr": [
      "Bienvenue chez DINO FOOD. Chez nous, c'est pas du cinéma ! La cuisine est faite maison, l'ambiance est chill à souhait, et la déco pourrait rendre jaloux les influenceurs les plus stylés d'Instagram..."
    ],
    "nl": [
      "Welkom bij DINO FOOD. Wij zijn de bioscoop niet! Het eten is huisgemaakt, de sfeer is zo chill als je je maar kunt wensen en het decor zou de meest stijlvolle influencers op Instagram jaloers kunnen maken..."
    ],
    "es": [
      "Bienvenido a DINO FOOD. ¡No somos el cine! La comida es casera, el ambiente es todo lo relajado que puedas desear y la decoración daría envidia a las influencers con más estilo de Instagram..."
    ]
  },
  "rdfs:label": {
