  "rdfs:comment": {
    "de": [
      "Eine Einrichtung mit drei Arthouse-Kinosälen, einem Café und einer Buchhandlung im Herzen des Viertels Bonne. Das Méliès entwickelt zahlreiche Aktionen zur Bilderziehung und zur Förderung des Autorenkinos, indem es insbesondere Vorführungen für ein junges Publikum anbietet."
    ],
    "en": [
      "A three-rooms art cinema structure, with a café and a bookshop within the de Bonne neighborhood. The Méliès develops several actions dedicated to the discovering of a picture sensibility, and to the promotion of auteur cinema, offering showings to young public in particular."
    ],
    "it": [
      "Una struttura con 3 cinema d'essai, un caffè e una libreria nel cuore del quartiere Bonne. Il Méliès sviluppa numerose azioni di educazione all'immagine e di promozione del cinema d'autore, in particolare proponendo proiezioni per il pubblico giovane."
    ],
    "fr": [
      "Un équipement de 3 salles art & essai, un café et une librairie au cœur du quartier de Bonne. Le Méliès développe de nombreuses actions pour l'éducation à l'image et la promotion du cinéma d'auteur en proposant notamment des projections jeune public."
    ],
    "es": [
      "Una instalación con 3 salas de cine de arte y ensayo, un café y una librería en el corazón del barrio de Bonne. Le Méliès participa en una amplia gama de iniciativas para educar a la gente sobre las artes visuales y promover el cine independiente, incluyendo proyecciones para el público joven."
    ],
    "nl": [
      "Een voorziening met 3 arthousebioscopen, een café en een boekhandel in het hart van de wijk Bonne. Het Méliès ontwikkelt talrijke acties voor beeldeducatie en de promotie van de auteursfilm, met name door het aanbieden van voorstellingen voor een jong publiek."
    ]
  },
  "rdfs:label": {
    "en": [
      "Le Méliès cinema"
    ],
    "fr": [
      "Cinéma le Méliès"
    ]
  },
