  "rdfs:comment": {
    "de": [
      "Die Uhr der 4 Zeiten landet in Saint-Pal-de-Chalencon, einer kleinen Stadt mit Charakter und mittelalterlichem Charme. Escape Game im Freien, ab 7 Jahren. Gehen Sie mit Ihrem Smartphone auf Abenteuerreise! Eine schöne Art, St-Pal-de-Chalencon neu zu entdecken und dabei Spaß zu haben"
    ],
    "en": [
      "L'Horloge des 4 temps comes to Saint-Pal-de-Chalencon, a charming medieval town full of character. Open-air Escape game, ages 7 and up. Set off on an adventure with your smartphone! A great way to re(discover) St-Pal-de-Chalencon while having fun!"
    ],
    "it": [
      "L'Horloge des 4 temps arriva a Saint-Pal-de-Chalencon, una piccola città piena di carattere e fascino medievale. Un gioco di fuga all'aria aperta per bambini dai 7 anni in su. Partite all'avventura con il vostro smartphone! Un modo per riscoprire Saint-Pal-de-Chalencon divertendosi!"
    ],
    "fr": [
      "L'Horloge des 4 temps débarque à Saint-Pal-de-Chalencon, petite cité de caractère au charme médiéval. Escape game en plein air, dès 7 ans. Partez à l'aventure avec votre smartphone! Une belle manière de re(découvrir) St-Pal-de-Chalencon tout en s'amusant"
    ],
    "es": [
      "L'Horloge des 4 temps llega a Saint-Pal-de-Chalencon, una pequeña ciudad llena de carácter y encanto medieval. Un juego de escape al aire libre para niños a partir de 7 años. Emprenda una aventura con su smartphone Una buena manera de redescubrir Saint-Pal-de-Chalencon divirtiéndose"
    ],
    "nl": [
      "L'Horloge des 4 temps komt naar Saint-Pal-de-Chalencon, een klein stadje vol karakter en middeleeuwse charme. Een ontsnappingsspel in de open lucht voor kinderen vanaf 7 jaar. Ga op avontuur met je smartphone! Een geweldige manier om St-Pal-de-Chalencon te herontdekken en plezier te maken!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'Horloge des 4 Temps"
    ]
  },
