  "rdfs:comment": {
    "de": [
      "Genießen Sie in der schönen Jahreszeit eine späte Besichtigung dieses bürgerlichen Wohnsitzes, die mit einer angebotenen Erfrischung auf der Terrasse abgeschlossen wird."
    ],
    "en": [
      "In fine weather, enjoy a late-night tour of this bourgeois home, rounded off with refreshments on the terrace."
    ],
    "it": [
      "Con il bel tempo, godetevi una visita notturna di questa residenza borghese, completata da un rinfresco sulla terrazza."
    ],
    "fr": [
      "Profitez à la  belle saison, d'une visite tardive de cette demeure bourgeoise, clôturée par un rafraîchissement offert sur la terrasse."
    ],
    "es": [
      "Si hace buen tiempo, disfrute de una visita nocturna a esta residencia burguesa, rematada con un refresco en la terraza."
    ],
    "nl": [
      "Bij mooi weer kun je 's avonds laat genieten van een rondleiding door deze burgerlijke residentie, met een verfrissing op het terras."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Maison Mantin \"Les soirs d'été de Louis Mantin\""
    ]
  },
