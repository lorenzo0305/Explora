  "rdfs:comment": {
    "de": [
      "Um nach La Penne-sur-l'Ouvèze zu gelangen, müssen Sie die kleine Departementale 525 nehmen, eine bewaldete Straße, die am Bach Aspirants entlangführt. La Penne ist eine kleine Gemeinde zwischen Cost und Pierrelongue, 6Km von Buis-les-Baronnies entfernt."
    ],
    "en": [
      "To get to La Penne-sur-l'Ouvèze, take the petite départementale 525, a wooded road that runs alongside the Ruisseau des Aspirants. La Penne is a small commune located between Cost and Pierrelongue, 6 km from Buis-les-Baronnies."
    ],
    "it": [
      "Per arrivare a La Penne-sur-l'Ouvèze, bisogna percorrere la piccola strada dipartimentale 525, una strada boscosa che costeggia il torrente Aspirants. La Penne è un piccolo comune situato tra Cost e Pierrelongue, a 6 km da Buis-les-Baronnies."
    ],
    "fr": [
      "Pour accéder à la Penne-sur-l’Ouvèze, il faut emprunter la petite départementale 525, une route boisée qui longe le ruisseau des Aspirants. La Penne est une petite commune située entre Cost et Pierrelongue, à 6Km de Buis-les-Baronnies."
    ],
    "es": [
      "Para llegar a La Penne-sur-l'Ouvèze, hay que tomar la pequeña carretera departamental 525, un camino arbolado que bordea el arroyo Aspirants. La Penne es un pequeño municipio situado entre Cost y Pierrelongue, a 6 km de Buis-les-Baronnies."
    ],
    "nl": [
      "Om La Penne-sur-l'Ouvèze te bereiken, moet je de petite départementale 525 nemen, een beboste weg die langs de Ruisseau des Aspirants loopt. La Penne is een kleine gemeente tussen Cost en Pierrelongue, op 6 km van Buis-les-Baronnies."
    ]
  },
