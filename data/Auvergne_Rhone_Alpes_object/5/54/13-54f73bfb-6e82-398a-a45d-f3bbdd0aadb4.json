  "rdfs:comment": {
    "de": [
      "Die Opéra de Lyon führt zum ersten Mal Billy Budd auf, ein Meisterwerk des Komponisten Benjamin Britten. Eine bewegende Geschichte über einen unschuldigen Mann, der mit Ungerechtigkeit und menschlicher Grausamkeit konfrontiert wird."
    ],
    "en": [
      "The Lyon Opera presents Billy Budd for the first time, a masterpiece by composer Benjamin Britten. A moving story of an innocent man confronted with human injustice and cruelty."
    ],
    "it": [
      "L'Opéra de Lyon presenta per la prima volta Billy Budd, un capolavoro del compositore Benjamin Britten. La storia commovente di un uomo innocente che si confronta con l'ingiustizia e la crudeltà umana."
    ],
    "fr": [
      "L’Opéra de Lyon présente pour la première fois Billy Budd, un coup de maître du compositeur Benjamin Britten. Histoire émouvante d’un homme innocent confronté à l’injustice et à la cruauté humaine."
    ],
    "es": [
      "La Ópera de Lyon presenta por primera vez Billy Budd, obra maestra del compositor Benjamin Britten. Una conmovedora historia de un hombre inocente enfrentado a la injusticia y la crueldad humanas."
    ],
    "nl": [
      "De Opéra de Lyon presenteert voor het eerst Billy Budd, een meesterwerk van componist Benjamin Britten. Een ontroerend verhaal over een onschuldige man die geconfronteerd wordt met menselijk onrecht en wreedheid."
    ]
  },
