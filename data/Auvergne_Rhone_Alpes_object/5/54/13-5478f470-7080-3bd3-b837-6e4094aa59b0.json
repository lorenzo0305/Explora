  "rdfs:comment": {
    "de": [
      "Eine Zeit des Schlemmens und der Komplizenschaft, in der Eltern und Kinder gemeinsam ein Gericht oder sogar ein ganzes Menü zubereiten und dabei die Grundlagen der gesunden Ernährung entdecken."
    ],
    "en": [
      "A gourmet moment where parents and children work together to prepare a dish or even a complete menu, while learning the basics of healthy eating."
    ],
    "it": [
      "È un modo delizioso e divertente per genitori e figli di preparare insieme un piatto o addirittura un intero menu, imparando al contempo le basi di una sana alimentazione."
    ],
    "fr": [
      "Un moment gourmand et complice où parents et enfants réalisent ensemble un plat ou même un menu complet tout en découvrant les bases de l'alimentation saine."
    ],
    "nl": [
      "Het is een heerlijke en leuke manier voor ouders en kinderen om samen een gerecht of zelfs een heel menu te maken, terwijl ze leren over de basisprincipes van gezond eten."
    ],
    "es": [
      "Es una forma deliciosa y divertida de que padres e hijos preparen juntos un plato o incluso todo un menú, mientras aprenden los fundamentos de una alimentación sana."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Atelier parents enfants cuisine et hygiène alimentaire - Programme parentalité"
    ]
  },
