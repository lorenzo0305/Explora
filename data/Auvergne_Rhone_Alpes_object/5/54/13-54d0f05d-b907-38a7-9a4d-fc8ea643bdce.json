  "rdfs:comment": {
    "de": [
      "Die Amicale de Pétanque Craponnaise organisiert einen offiziellen Pétanque-Wettbewerb in Doublette A-B-C, der für lizenzierte Veteranen reserviert ist, im Stade de la prairie.\r\nAnmeldung ab 13:30 Uhr, Beginn der Spiele um 14:30 Uhr."
    ],
    "en": [
      "The Amicale de Pétanque Craponnaise organizes an official double A-B-C petanque competition, reserved for veterans, at the stade de la prairie.\r\nRegistration from 1.30pm, games start at 2.30pm."
    ],
    "it": [
      "L'Amicale de Pétanque Craponnaise organizza una gara ufficiale di petanque doppia A-B-C, riservata ai veterani, presso lo stadio della prateria.\r\nIscrizioni dalle 13.30, inizio delle partite alle 14.30."
    ],
    "fr": [
      "L'Amicale de Pétanque Craponnaise organise un concours officiel de pétanque en doublette A-B-C, réservé aux licenciés vétérans, au stade de la prairie. \r\nInscriptions à partir de 13h30, début des parties à 14h30."
    ],
    "es": [
      "La Amicale de Pétanque Craponnaise organiza una competición oficial de petanca doble A-B-C, reservada a los veteranos, en el stade de la prairie.\r\nInscripciones a partir de las 13.30 h, inicio de las partidas a las 14.30 h."
    ],
    "nl": [
      "De Amicale de Pétanque Craponnaise organiseert een officiële dubbele A-B-C petanquewedstrijd, gereserveerd voor veteranen, op de stade de la prairie.\r\nInschrijving vanaf 13.30 uur, de wedstrijden beginnen om 14.30 uur."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Concours officiel de pétanque"
    ]
  },
