  "rdfs:comment": {
    "de": [
      "La Merlette, der Kurzwarenladen in Bourbon-l'Archambault, bietet Stoffe, Wolle, kreatives Zubehör, Änderungen und persönliche Beratung an. Ein gemütlicher Ort, um all Ihre Näh- und Hobbywünsche zu erfüllen."
    ],
    "en": [
      "La Merlette, the haberdashery in Bourbon-l?Archambault, offers fabrics, wool, creative accessories, alterations and personalized advice. A warm place to bring all your sewing and hobby desires to life."
    ],
    "it": [
      "La Merlette, la merceria di Bourbon-l'Archambault, offre tessuti, lana, accessori creativi, modifiche e consigli personalizzati. Un luogo caldo e accogliente per dare vita a tutti i vostri desideri di cucito e hobby."
    ],
    "fr": [
      "La Merlette, la mercerie de Bourbon-l’Archambault, propose tissus, laine, accessoires créatifs, retouches et conseils personnalisés. Un lieu chaleureux pour donner vie à toutes vos envies de couture et de loisirs créatifs."
    ],
    "es": [
      "La Merlette, la mercería de Bourbon-l'Archambault, ofrece telas, lanas, accesorios creativos, arreglos y asesoramiento personalizado. Un lugar cálido y acogedor para dar vida a todos sus deseos de costura y hobby."
    ],
    "nl": [
      "La Merlette, de fourniturenwinkel in Bourbon-l?Archambault, biedt stoffen, wol, creatieve accessoires, verbouwingen en persoonlijk advies. Een warme en gastvrije plek om al uw naai- en hobbywensen tot leven te brengen."
    ]
  },
