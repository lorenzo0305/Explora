  "rdfs:comment": {
    "de": [
      "L'Armellier ist eine Werkstatt für Holzdrechslerei und ein Laden. Hier können Sie Alltagsgegenstände aus gedrechseltem Holz entdecken: Schalen, Kreisel, Schachteln sowie Kunstgegenstände."
    ],
    "en": [
      "L'Armellier is a woodturning workshop and boutique. You'll discover everyday objects in turned wood: bowls, spinning tops, boxes, as well as objets d'art."
    ],
    "it": [
      "L'Armellier è un laboratorio e un negozio di tornitura del legno. Qui si trovano oggetti di uso quotidiano realizzati in legno tornito, tra cui ciotole, trottole e scatole, ma anche oggetti d'arte."
    ],
    "fr": [
      "L'Armellier est un atelier de tournage sur bois et une boutique. Vous y découvrirez des objets de la vie quotidienne en bois tourné : bols, toupies, boîtes, ainsi que des objets d'art."
    ],
    "nl": [
      "L'Armellier is een houtdraaiatelier en -winkel. Hier vind je alledaagse voorwerpen gemaakt van gedraaid hout, zoals schalen, tollen en kisten, maar ook kunstvoorwerpen."
    ],
    "es": [
      "L'Armellier es un taller y tienda de torneado de madera. Aquí encontrará objetos cotidianos de madera torneada, como cuencos, peonzas y cajas, así como objetos de arte."
    ]
  },
