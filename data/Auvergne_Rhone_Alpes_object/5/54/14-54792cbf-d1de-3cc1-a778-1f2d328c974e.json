  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/6e7e89af-7c7e-337f-83e2-02ba34bc093a",
      "dc:description": {
        "de": [
          "Handgemachte Pizzas, Pizzateig aus Sauerteig, frische und hochwertige Zutaten, AOP-Käse, frische Pommes frites aus Rinderfett, Paninis, Burger, Sandwiches, Amerikaner, Brot vom Bäcker, Service vor Ort oder zum Mitnehmen, Lieferungen je nach Möglichkeit"
        ],
        "en": [
          "Handmade pizzas, sourdough pizza dough, fresh quality ingredients, AOP cheeses, fresh fries cooked in beef fat, paninis, burgers, sandwiches, American, baker's breads, on-site or takeaway service, deliveries according to availability"
        ],
        "it": [
          "Pizze fatte a mano, impasto per pizza a lievitazione naturale, ingredienti freschi di qualità, formaggi AOP, patatine fritte fresche cotte nel grasso di manzo, panini, hamburger, sandwich, americani, pane del fornaio, servizio da asporto o in loco, consegne su richiesta"
        ],
        "fr": [
          "Pizzas faites à la main, pâte à pizza au levain, ingrédients frais et de qualité, fromages aop, frites fraîches cuites au gras de bœuf, paninis, burgers, sandwichs, américains, pains du boulanger, service sur place ou à emporter, livraisons suivant possibilités"
        ],
        "es": [
          "Pizzas artesanales, masa de pizza de masa madre, ingredientes frescos de calidad, quesos AOP, patatas fritas frescas cocinadas en grasa de vacuno, paninis, hamburguesas, sándwiches, americanos, pan de panadería, servicio para llevar o in situ, entregas por encargo"
        ],
        "nl": [
          "Handgemaakte pizza's, zuurdesem pizzadeeg, verse kwaliteitsingrediënten, AOP kazen, verse friet gebakken in rundervet, panini's, hamburgers, sandwiches, Amerikanen, bakkersbrood, afhaal of op locatie, bezorging op aanvraag"
        ]
      },
      "@type": [
        "Description"
