  "rdfs:comment": {
    "de": [
      "Hausgemachte Familienküche. Wir verwenden lokales Charolais-Fleisch von unserem Familienbetrieb und nutzen lokale Kanäle für den Rest unserer Produkte. Das Gemüse kommt von Erzeugern aus weniger als 5 km Entfernung."
    ],
    "en": [
      "Home-cooked family cuisine. We use local Charolais meat from our family farm, and use local channels for the rest of our produce. Vegetables come from producers less than 5 km away."
    ],
    "it": [
      "Cucina casalinga a conduzione familiare. Utilizziamo carne Charolais locale proveniente dalla fattoria di famiglia e utilizziamo canali locali per il resto dei nostri prodotti. Le verdure provengono da produttori a meno di 5 km di distanza."
    ],
    "fr": [
      "Cuisine familiale faite maison. Nous utilisons la viande charolaise locale de la ferme familiale et nous favorisons des circuits locaux pour le restant des produits. Les légumes viennent de producteurs à moins de  5 km."
    ],
    "nl": [
      "Huisgemaakte familiekeuken. We gebruiken lokaal Charolais-vlees van de familieboerderij en gebruiken lokale kanalen voor de rest van onze producten. Groenten komen van producenten op minder dan 5 km afstand."
    ],
    "es": [
      "Cocina casera y familiar. Utilizamos carne Charolais local de la granja familiar, y utilizamos canales locales para el resto de nuestros productos. Las verduras proceden de productores situados a menos de 5 km."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Cocotte du Château"
    ]
  },
