  "rdfs:comment": {
    "de": [
      "Das Epi-Centre ist für alle offen und ohne Terminvereinbarung zugänglich und bietet einen Raum, der der Unterstützung bei der digitalen Nutzung und der Telearbeit gewidmet ist."
    ],
    "en": [
      "Open to all without appointment, the Epi-Centre offers a space dedicated to supporting digital uses and teleworking."
    ],
    "it": [
      "Aperto a tutti senza appuntamento, l'Epi-Centre offre uno spazio dedicato al supporto degli usi digitali e del telelavoro."
    ],
    "fr": [
      "Ouvert à tous et sans rendez-vous, l’Epi-Centre propose un espace dédié à l’accompagnement aux usages numériques et au télétravail."
    ],
    "nl": [
      "Het Epi-Centre is zonder afspraak voor iedereen toegankelijk en biedt een ruimte die digitale toepassingen en telewerken ondersteunt."
    ],
    "es": [
      "Abierto a todos sin cita previa, el Epi-Centre ofrece un espacio dedicado a apoyar los usos digitales y el teletrabajo."
    ]
  },
