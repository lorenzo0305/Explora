  "rdfs:comment": {
    "de": [
      "Les Petites Cantines Oullins ist ein partizipatives Restaurant, das für alle offen ist. Hier kommen Menschen zusammen, um gemeinsam zu kochen und/oder eine gute Mahlzeit zu essen, die zu einem freien Preis serviert wird. Es ist ein Ort, an dem sich gutes Essen auf Geselligkeit reimt!"
    ],
    "en": [
      "Les Petites Cantines Oullins is a community restaurant open to everyone. People come together to cook and/or eat a good meal at a free price. It's a place where good food goes hand in hand with conviviality!"
    ],
    "it": [
      "Les Petites Cantines Oullins è un ristorante partecipativo aperto a tutti. Le persone si riuniscono per cucinare e/o mangiare un buon pasto a prezzo libero. È un luogo dove mangiare bene fa rima con convivialità!"
    ],
    "fr": [
      "Les Petites Cantines Oullins est un restaurant participatif ouvert à toutes et tous. On s'y rassemble pour cuisiner et/ou manger un bon repas servi à prix libre. C'est un lieu où bien manger rime avec convivialité !"
    ],
    "nl": [
      "Les Petites Cantines Oullins is een participatief restaurant dat openstaat voor iedereen. Mensen komen samen om gratis een goede maaltijd te koken en/of te eten. Het is een plek waar goed eten rijmt met gezelligheid!"
    ],
    "es": [
      "Les Petites Cantines Oullins es un restaurante participativo abierto a todos. La gente se reúne para cocinar y/o comer una buena comida a precio libre. Es un lugar donde comer bien rima con convivir"
    ]
  },
