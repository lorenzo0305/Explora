  "rdfs:comment": {
    "de": [
      "Die Eisbahn ist für Kinder und ihre Eltern reserviert, um in aller Sicherheit und mit angemessenem Lernmaterial Schlittschuh laufen zu können."
    ],
    "en": [
      "The ice skating rink is reserved for the young ones to enjoy ice pleasure safely with some adapted educational equipment."
    ],
    "it": [
      "La pista di pattinaggio è riservata ai bambini e ai loro genitori, che possono godere dei piaceri del ghiaccio in tutta sicurezza, con materiale didattico adattato."
    ],
    "fr": [
      "La patinoire est réservée aux enfants et à leurs parents pour profiter des plaisirs de la glace en toute sécurité avec du matériel pédagogique adapté."
    ],
    "es": [
      "Pista de patinaje cubierta de 800m2. Un momento de descanso en un marco privilegiado, frente al pueblo y frente a la Cadena del Aravis."
    ],
    "nl": [
      "De ijsbaan is gereserveerd voor kinderen en hun ouders om in alle veiligheid te genieten van de geneugten van het ijs met aangepast educatief materiaal."
    ]
