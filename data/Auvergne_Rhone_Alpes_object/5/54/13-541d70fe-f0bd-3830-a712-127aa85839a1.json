  "rdfs:comment": {
    "de": [
      "Philippe, der im Tal der Cère geboren ist, begleitet Sie bei Ausflügen zu allen Jahreszeiten auf den Bergkämmen oder im Wald, bietet Ihnen aber auch personalisierte Freizeit- und Entdeckungstage an!"
    ],
    "en": [
      "Philippe, a native of the Cère valley, will accompany you on outings in all seasons on the crests or in the forest, but also offers personalized leisure and discovery days!"
    ],
    "it": [
      "Philippe, originario della valle della Cère, vi accompagnerà in tutte le stagioni nelle escursioni sulle creste o nella foresta, ma potrà anche proporvi giornate di svago e di scoperta personalizzate!"
    ],
    "fr": [
      "Philippe, natif de la vallée de la Cère, vous accompagne pour des sorties en toutes saisons sur les crêtes ou en forêt, mais vous propose aussi des journées personnalisées loisirs et découvertes !"
    ],
    "es": [
      "Philippe, oriundo del valle de la Cère, le acompañará en excursiones en todas las estaciones por las crestas o el bosque, ¡pero también puede ofrecerle jornadas de ocio y descubrimiento personalizadas!"
    ],
    "nl": [
      "Philippe, een inwoner van de Cère-vallei, begeleidt je in alle seizoenen tijdens uitstapjes op de bergkammen of in het bos, maar hij kan je ook gepersonaliseerde vrijetijds- en ontdekkingsdagen aanbieden!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Philippe Guilhen -Accompagnateur à Vic sur Cère"
    ]
  },
