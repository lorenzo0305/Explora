  "rdfs:comment": {
    "de": [
      "Anthony und Aurélie begrüßen Sie in der Auberge du Vieux Lanas, einem Hotel*-Restaurant im Herzen des Dorfes. Lassen Sie sich je nach Jahreszeit auf der Terrasse im Schatten der Platanen oder im Saal nieder. Raffinierte traditionelle Küche, freundliche und herzliche Atmosphäre.***"
    ],
    "en": [
      "Anthony and Aurélie welcome you to the Auberge du Vieux Lanas, a hotel*-restaurant in the heart of the village. Sit out on the terrace in the shade of the plane trees, or in the dining room, depending on the season. Refined traditional cuisine in a warm and friendly atmosphere."
    ],
    "it": [
      "Anthony e Aurélie vi danno il benvenuto all'Auberge du Vieux Lanas, un hotel*-ristorante nel cuore del villaggio. Sedetevi sulla terrazza all'ombra dei platani o nella sala da pranzo, a seconda della stagione. Una cucina tradizionale raffinata in un'atmosfera calda e accogliente"
    ],
    "fr": [
      "Anthony et Aurélie vous accueillent à l’Auberge du Vieux Lanas, hôtel*-restaurant au cœur du village. Installez-vous en terrasse à l’ombre des platanes ou en salle selon la saison. Cuisine traditionnelle raffinée, ambiance conviviale et chaleureuse.***"
    ],
    "es": [
      "Anthony y Aurélie le dan la bienvenida al Auberge du Vieux Lanas, un hotel*-restaurante en el corazón del pueblo. Siéntese en la terraza, a la sombra de los plátanos, o en el comedor, según la temporada. Cocina tradicional refinada en un ambiente cálido y acogedor"
    ],
    "nl": [
      "Anthony en Aurélie heten je welkom in de Auberge du Vieux Lanas, een hotel*-restaurant in het hart van het dorp. Neem plaats op het terras in de schaduw van de platanen of in de eetzaal, afhankelijk van het seizoen. Verfijnde traditionele keuken in een warme en vriendelijke sfeer."
    ]
  },
