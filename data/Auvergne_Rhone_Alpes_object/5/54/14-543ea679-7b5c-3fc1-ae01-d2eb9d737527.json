  "rdfs:comment": {
    "de": [
      "Die Gruppe Faternity Gospel aus Carvinois wird den Hof der Ermitage Saint Druon beleben. Es ist sehens- und hörenswert und warum nicht wagen, mit diesen leidenschaftlichen Musikern aus vollem Herzen zu singen."
    ],
    "en": [
      "The Carvinois group Faternity Gospel is coming to liven up the courtyard of the Ermitage Saint Druon. See and hear them, and why not dare to sing your heart out with these enthusiasts."
    ],
    "it": [
      "I Faternity Gospel, un gruppo di Carvin, animeranno il cortile dell'Ermitage Saint Druon. Vedeteli e ascoltateli, e perché non osare cantare a squarciagola con questi musicisti appassionati."
    ],
    "fr": [
      "Le groupe carvinois Faternity Gospel vient animer la cour de l'Ermitage Saint Druon. A voir et écouter et pourquoi pas oser chanter en cœur avec ces passionnés."
    ],
    "es": [
      "Faternity Gospel, un grupo de Carvin, animará el patio del Ermitage Saint Druon. Véalos y escúchelos, y anímese a cantar con estos músicos apasionados."
    ],
    "nl": [
      "Faternity Gospel, een groep uit Carvin, brengt de binnenplaats van Ermitage Saint Druon tot leven. Bekijk en beluister ze, en waarom zou je het niet aandurven om je hart uit te zingen met deze gepassioneerde muzikanten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Récital de gospel - Journée européenne du Patrimoine"
    ]
  },
