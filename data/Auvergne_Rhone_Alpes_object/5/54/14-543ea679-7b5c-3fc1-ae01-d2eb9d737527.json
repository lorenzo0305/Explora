      "dc:description": {
        "de": [
          "Ohne Mäßigung zu entdecken. Die Gruppe Fraternity Gospel praktiziert den Gospelchorgesang zu humanitären Zwecken. Der Chor besteht aus Amateursängern und ist für alle offen."
        ],
        "en": [
          "To be discovered without moderation. Fraternity Gospel is a gospel choir dedicated to humanitarian causes. The choir is made up of amateur singers and is open to all."
        ],
        "it": [
          "Da scoprire senza moderazione. Fraternity Gospel è un coro gospel dedicato a cause umanitarie. Il coro è composto da cantanti dilettanti ed è aperto a tutti."
        ],
        "fr": [
          "A découvrir sans modération. Le groupe Fraternity Gospel pratique le chant choral gospel à des fins humanitaires. La chorale est composée de chanteurs amateurs et elle est ouverte à tous."
        ],
        "nl": [
          "Om zonder mate ontdekt te worden. Fraternity Gospel is een gospelkoor dat zich inzet voor humanitaire doelen. Het koor bestaat uit amateurzangers en staat open voor iedereen."
        ],
        "es": [
          "Descubrirse sin moderación. Fraternity Gospel es un coro de gospel dedicado a causas humanitarias. El coro está formado por cantantes aficionados y está abierto a todos."
        ]
      },
