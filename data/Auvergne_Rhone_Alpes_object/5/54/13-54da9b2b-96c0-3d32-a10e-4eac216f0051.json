  "rdfs:comment": {
    "de": [
      "Eine handwerkliche und hausgemachte Küche, die aus frischen und lokalen Produkten zubereitet wird. Ein wöchentlich wechselndes Menü mit einer kurzen Karte als Zeichen für Qualität. Und immer ein vegetarisches Angebot."
    ],
    "en": [
      "Artisanal, home-cooked cuisine using fresh, local produce. A menu that changes every week, with a short menu to guarantee quality. And always a vegetarian option."
    ],
    "it": [
      "Cucina casalinga con prodotti freschi e locali. Un menu che cambia ogni settimana, con una carta corta per garantire la qualità. E c'è sempre un'opzione vegetariana."
    ],
    "fr": [
      "Une cuisine artisanale et faite maison, élaborée à partir de produits frais et locaux. Un menu qui change chaque semaine, avec une carte courte en gage de qualité. Et toujours une proposition végétarienne."
    ],
    "nl": [
      "Huisgemaakte gerechten met verse, lokale producten. Een menu dat elke week verandert, met een kort menu om kwaliteit te garanderen. En er is altijd een vegetarische optie."
    ],
    "es": [
      "Cocina casera, elaborada con productos frescos y de proximidad. Un menú que cambia cada semana, con una carta corta para garantizar la calidad. Y siempre hay una opción vegetariana."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Canopée"
    ]
  },
