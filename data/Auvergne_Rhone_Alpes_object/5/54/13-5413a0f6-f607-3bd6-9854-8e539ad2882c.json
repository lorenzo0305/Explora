  "rdfs:comment": {
    "de": [
      "Im Herzen des Tals der Fabriken in Thiers können Sie bei Fontenille Pataud einen immersiven Besuch erleben. Geräusche, Gerüche, präzise Gesten: Tauchen Sie mit all Ihren Sinnen in die lebendige Welt der handwerklichen französischen Messerschmiedekunst ein."
    ],
    "en": [
      "Fontenille Pataud, an exceptional cutlery company based in Thiers, embodies French craftsmanship. Since 1929, we have been creating top-of-the-range knives, combining tradition and innovation."
    ],
    "it": [
      "Nel cuore della Vallée des Usines a Thiers, partecipate a un tour immersivo della Fontenille Pataud. Suoni, odori, gesti precisi: immergete tutti i vostri sensi nel mondo vivo della coltelleria tradizionale francese."
    ],
    "fr": [
      "Au cœur de la vallée des Usines à Thiers, vivez une visite immersive chez Fontenille Pataud. Bruits, odeurs, gestes précis : plongez avec tous vos sens dans l’univers vivant de la coutellerie artisanale française."
    ],
    "nl": [
      "In het hart van de Vallée des Usines in Thiers kun je een meeslepende rondleiding krijgen bij Fontenille Pataud. Geluiden, geuren, precieze gebaren: dompel al je zintuigen onder in de levende wereld van het traditionele Franse bestek."
    ],
    "es": [
      "En el corazón del Valle de las Usinas, en Thiers, haga una visita inmersiva a Fontenille Pataud. Sonidos, olores, gestos precisos: sumerja todos sus sentidos en el mundo vivo de la cuchillería tradicional francesa."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite de la Coutellerie Fontenille-Pataud"
    ]
  },
