  "rdfs:comment": {
    "de": [
      "Während des Spaziergangs erfahren Sie mehr über die Aktivitäten der Kohleminen, die bis ins 20. Die Ruinen, die Sie beobachten, markieren die Bedeutung der Minen in dieser Zeit."
    ],
    "en": [
      "During this walk, you will be able to learn more about the coal mines that were in operation until the 20th century. The ruins along the way bear witness to the importance of the mining activity at that time"
    ],
    "it": [
      "Durante la passeggiata, scoprirete l'attività delle miniere di carbone in funzione fino al XX secolo. Le rovine che si possono vedere qui dimostrano l'importanza delle miniere all'epoca."
    ],
    "fr": [
      "Au fil de la balade, vous découvrirez l'activité des mines de charbon en exploitation jusqu'au XXe siècle. Les ruines que l'observe, marquent l'importance des mines à cette époque."
    ],
    "nl": [
      "Onderweg leer je over de kolenmijnen die tot in de 20e eeuw in bedrijf waren. De ruïnes die hier te zien zijn, getuigen van het belang van de mijnen in die tijd."
    ],
    "es": [
      "Durante el paseo, descubrirá la actividad de las minas de carbón en funcionamiento hasta el siglo XX. Las ruinas que pueden verse aquí muestran la importancia de las minas en aquella época."
    ]
  },
  "rdfs:label": {
    "en": [
      "Hiking itinerary : Tour de la Mine"
    ],
    "fr": [
      "Itinéraire de randonnée pédestre : Le Tour de la Mine"
    ],
    "nl": [
      "Wandelroute : Tour de la Mine"
    ]
  },
