  "rdfs:comment": {
    "de": [
      "Le Navire ist ein unabhängiges Arthouse-Kino, das eine seltene und pluralistische Kinematografie der Autoren, Länder, Visionen und Experimente fördern, begleiten und verteidigen will.\r\n\r\nFilme in OV. Label Recherche et Découverte (Forschung und Entdeckung).\r\n5 Kinosäle"
    ],
    "en": [
      "Le Navire is an independent arthouse cinema that aims to promote, support and defend a rare and plural cinematography of authors, countries, visions and experimentation.\r\n\r\nFilms in V.O. Label Recherche et Découverte.\r\n5 screens"
    ],
    "it": [
      "Le Navire è un cinema d'essai indipendente che intende promuovere, sostenere e difendere una cinematografia rara e diversificata di autori, paesi, visioni e sperimentazioni.\r\n\r\nFilm in V.O.S.T. Label Recherche et Découverte.\r\n5 schermi"
    ],
    "fr": [
      "Le Navire est un cinéma d’Art et d’Essai indépendant qui vise à promouvoir, accompagner et défendre une cinématographie rare et plurielle, d’auteurs, de pays, de visions et d’expérimentation.\r\n\r\nFilms en V.O.S.T Label Recherche et Découverte.\r\n5 salles"
    ],
    "nl": [
      "Le Navire is een onafhankelijke arthouse bioscoop die een zeldzame en pluriforme cinematografie van auteurs, landen, visies en experimenten wil promoten, ondersteunen en verdedigen.\r\n\r\nFilms in V.O. Label Recherche et Découverte.\r\n5 schermen"
    ],
    "es": [
      "Le Navire es un cine de arte y ensayo independiente que pretende promover, apoyar y defender una cinematografía rara y diversa de autores, países, visiones y experimentación.\r\n\r\nPelículas en V.O.S.T. Label Recherche et Découverte.\r\n5 salas"
    ]
  },
