  "rdfs:comment": {
    "de": [
      "Verein nach dem Gesetz von 1901, der von der CAF zugelassen und der Fédération des Centres Sociaux angegliedert ist.\r\n\r\nDas Projekt des Sozialzentrums ist das Ergebnis einer gemeinsamen Erarbeitung durch die Bewohner des Gebiets, die Partner und das ehrenamtliche und angestellte Team des Vereins."
    ],
    "en": [
      "Association under the law of 1901, approved by the CAF and affiliated with the Fédération des Centres Sociaux.\r\n\r\nThe Centre Social's project is the fruit of joint development between local residents, partners and the association's volunteer and salaried staff."
    ],
    "it": [
      "Associazione ai sensi della legge del 1901, approvata dal CAF e affiliata alla Fédération des Centres Sociaux.\r\n\r\nIl progetto del Centre Social è il frutto di uno sviluppo congiunto tra i residenti locali, i partner e il team di volontari e dipendenti dell'associazione."
    ],
    "fr": [
      "Association loi 1901 agréée par la CAF et affiliée à la Fédération des Centres Sociaux.\r\n\r\nLe projet du Centre Social est le fruit d’une co-élaboration entre les habitants du territoire, les partenaires et l’équipe bénévole et salariée de l’association."
    ],
    "nl": [
      "Vereniging onder de wet van 1901, goedgekeurd door de CAF en aangesloten bij de Fédération des Centres Sociaux.\r\n\r\nHet project van het Centre Social is het resultaat van een gezamenlijke ontwikkeling tussen buurtbewoners, partners en het vrijwillige en betaalde team van de vereniging."
    ],
    "es": [
      "Asociación conforme a la ley de 1901, aprobada por la CAF y afiliada a la Fédération des Centres Sociaux.\r\n\r\nEl proyecto del Centre Social es fruto del desarrollo conjunto de los residentes locales, los socios y el equipo de voluntarios y asalariados de la asociación."
    ]
  },
