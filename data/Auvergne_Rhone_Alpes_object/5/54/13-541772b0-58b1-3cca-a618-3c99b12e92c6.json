  "rdfs:comment": {
    "de": [
      "Der Verein La Bouquinade bietet mit Unterstützung der Gemeinde jeden dritten Mittwoch im Monat einen Abend mit Gesellschaftsspielen an. Verbringen Sie einen geselligen Abend, bringen Sie Ihre eigenen Spiele mit und lassen Sie sich von ihnen begeistern und entdecken Sie neue!"
    ],
    "en": [
      "The Bouquinade association, with the help of the municipality, organizes board game evenings on the 3rd Wednesday of the month. Bring your own games and discover new ones!"
    ],
    "it": [
      "L'associazione Bouquinade, con l'aiuto del Comune, organizza serate di giochi da tavolo il 3° mercoledì del mese. Venite a trascorrere un momento di convivialità, portate i vostri giochi e scopritene di nuovi!"
    ],
    "fr": [
      "L'association la Bouquinade, avec l'aide de la municipalité, propose des soirées jeux de société les 3èmes mercredis du mois. Venez passer un moment convivial, apporter vos propres jeux et faites les découvrir et découvrez-en d'autres !"
    ],
    "es": [
      "La asociación Bouquinade, con la ayuda del ayuntamiento, organiza veladas de juegos de mesa el tercer miércoles de cada mes. Venga a pasar un rato agradable, traiga sus propios juegos y descubra otros nuevos"
    ],
    "nl": [
      "De vereniging Bouquinade organiseert met de hulp van het gemeentebestuur gezelschapsspellenavonden op de 3e woensdag van de maand. Kom gezellig langs, neem je eigen spellen mee en ontdek nieuwe!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Soirée jeux de société"
    ]
  },
