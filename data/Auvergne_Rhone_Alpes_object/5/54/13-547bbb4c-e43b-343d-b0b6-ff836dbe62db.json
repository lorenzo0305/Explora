  "rdfs:comment": {
    "de": [
      "Die Glass Bar ist ein intimer Treffpunkt im Herzen des Four Seasons Resort Megève und eine unwiderstehliche Einladung zum Entspannen. Hier trifft man sich auf ein Glas außergewöhnlichen Wein oder einen Klassiker der Mixologie."
    ],
    "en": [
      "Intimate hideaway nestled in the heart of Four Seasons Resort Megève, the Glass Bar is an irresistible invitation to relaxation. It's where you come for a glass of exceptional wine or a classic mixology concoction."
    ],
    "it": [
      "Il Glass Bar, un rifugio intimo nel cuore del Four Seasons Resort Megève, è un irresistibile invito al relax. \r\nVenite a concedervi un bicchiere di vino eccezionale o un classico drink di mixology."
    ],
    "fr": [
      "Repaire intimiste niché au cœur du Four Seasons Resort Megève, le Glass Bar est une invitation irrésistible à la détente. On s'y retrouve pour un verre de vin d’exception, ou un grand classique de la mixologie."
    ],
    "es": [
      "Un refugio íntimo enclavado en el corazón del Four Seasons Resort Megève, el Glass Bar es una invitación irresistible a relajarse. Venga a disfrutar de una excepcional copa de vino o de una clásica bebida de coctelería."
    ],
    "nl": [
      "De Glass Bar, een intieme plek in het hart van het Four Seasons Resort Megève, is een onweerstaanbare uitnodiging om te ontspannen. Kom genieten van een uitzonderlijk glas wijn of een klassiek mixdrankje."
    ]
  },
  "rdfs:label": {
