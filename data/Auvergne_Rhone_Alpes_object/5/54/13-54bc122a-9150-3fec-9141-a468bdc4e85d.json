  "rdfs:comment": {
    "de": [
      "Landbistro des Castel 1904. Tagesmenü und Spezialität von Bourriols d'Auvergne. Es handelt sich um sättigende gesalzene Crêpes aus der Haute Auvergne gefüllt mit verschiedenen Füllungen. Craft Cider und Glasweine. Ambiance 50er Jahre."
    ],
    "en": [
      "Bistrot de campagne du Castel 1904. Daily menu and specialty of Bourriols d'Auvergne. They are savoury crepes from Haute Auvergne stuffed with various toppings. Craft ciders and wines by the glass. Atmosphere 50s."
    ],
    "it": [
      "Situato in Alvernia. Bistrot di campagna a Castel 1904. Menu giornaliero e specialità Bourriols d'Auvergne. Si tratta di appetitose frittelle salate dell'Alta Alvernia farcite con vari ripieni. Sidro e vini tradizionali al bicchiere. Atmosfera anni '50."
    ],
    "fr": [
      "Situé en Auvergne. Bistrot de campagne du Castel 1904. Menu du jour et spécialité de Bourriols d'Auvergne. Il s'agit de rassasiantes crêpes salées de Haute Auvergne farcies de différentes garnitures. Cidres artisanaux et vins au verre. Ambiance années 50."
    ],
    "es": [
      "Situado en Auvernia. Bistro rural en Castel 1904. Menú diario y especialidad de Bourriols d'Auvergne. Apetitosas tortitas saladas de la Alta Auvernia rellenas de diferentes ingredientes. Sidras y vinos tradicionales por copas. Ambiente de los años 50."
    ],
    "nl": [
      "Bistrot de campagne du Castel 1904. Dagelijks menu en specialiteit van Bourriols d'Auvergne. Het zijn hartige pannenkoeken uit de Haute Auvergne gevuld met verschillende toppings. Ambachtelijke ciders en wijnen per glas. Sfeer 50s."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Comptoir à Moustaches"
    ]
  },
