  "rdfs:comment": {
    "de": [
      "Ihre Karaoke-Bar in Thonon! \r\nVerbringen Sie in einer herzlichen und geselligen Atmosphäre angenehme Momente unter Freunden. \r\n7 Tage die Woche geöffnet, entweder mit einer DJ-Themenparty oder einem Freitagskonzert."
    ],
    "en": [
      "Your karaoke bar in Thonon! \r\nIn a warm and friendly atmosphere, spend nice moments with friends. \r\nOpen 7 days a week with either a DJ theme party or a concert every friday."
    ],
    "it": [
      "Il vostro karaoke bar a Thonon-les-Bains! Trascorrete del tempo di qualità con gli amici in un'atmosfera calda e accogliente. Aperto martedì, mercoledì e domenica dalle 18:00 all'1:00, giovedì e venerdì dalle 18:00 alle 3:00 e sabato dalle 19:00 alle 3:00."
    ],
    "fr": [
      "Votre karaoké bar à Thonon-les-Bains ! Dans une ambiance chaleureuse et conviviale, passez d’agréables moments entre amis. Ouvert mardi, mercredi et dimanche de 18h à 1h, jeudi et vendredi de 18h à 3h et samedi de 19h à 3h."
    ],
    "es": [
      "¡Su karaoke en Thonon-les-Bains! Pase un buen rato con sus amigos en un ambiente cálido y acogedor. Abierto los martes, miércoles y domingos de 18:00 a 01:00, los jueves y viernes de 18:00 a 03:00 y los sábados de 19:00 a 03:00."
    ],
    "nl": [
      "Jouw karaokebar in Thonon-les-Bains! Breng wat quality time door met vrienden in een warme en vriendelijke sfeer. Geopend op dinsdag, woensdag en zondag van 18.00 tot 01.00 uur, op donderdag en vrijdag van 18.00 tot 03.00 uur en op zaterdag van 19.00 tot 03.00 uur."
    ]
  },
