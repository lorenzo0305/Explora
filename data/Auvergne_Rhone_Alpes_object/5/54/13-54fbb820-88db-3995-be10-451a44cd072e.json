  "rdfs:comment": {
    "de": [
      "Airmax ist ein kleines Team aus 6 Enthusiasten. Entdecken Sie das Gleitschirmfliegen mit Freude und guter Laune. Schnupperflüge über dem See von Annecy im Tandemflug für unvergleichliche Erlebnisse. Einführung in das Gleitschirmfliegen bei allen Flügen."
    ],
    "en": [
      "Airmax is a small team of six enthusiasts. Discover paragliding in a fun and friendly atmosphere. Enjoy an unforgettable first flight over Lake Annecy in a tandem paraglider. Learn how to fly a paraglider on all flights."
    ],
    "it": [
      "Airmax Parapente propone battesimi biposto in parapendio sul lago di Annecy.\r\nUn team di quattro istruttori in una scuola di parapendio a misura d'uomo."
    ],
    "fr": [
      "Airmax est une petite équipe de 6 passionnés. Découvrez le parapente dans la joie et la bonne humeur. Baptêmes au-dessus du lac d'Annecy en vol biplace, pour des sensations inégalées. Initiation au pilotage du parapente sur tous les vols."
    ],
    "es": [
      "Airmax es un pequeño equipo de 6 entusiastas. Descubre el parapente con buen humor. Primeros vuelos sobre el lago de Annecy en biplaza, para sensaciones inigualables. Iniciación al parapente en todos los vuelos."
    ],
    "nl": [
      "Airmax Parapente biedt tandemvluchten boven het meer van Annecy. Een team van vier instructeurs werkt voor deze kleinschalige paraglidingschool."
    ]
  },
