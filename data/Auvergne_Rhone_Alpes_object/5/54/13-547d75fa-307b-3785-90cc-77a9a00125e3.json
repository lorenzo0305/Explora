  "rdfs:comment": {
    "de": [
      "Das Ciné Capitole liegt am Place de Jaude im Herzen der Stadt und empfängt Sie an 365 Tagen im Jahr, damit Sie in einem seiner 5 Säle Ihre Emotionen intensiv erleben können!"
    ],
    "en": [
      "Located on Place de Jaude in the heart of the city, Ciné Capitole welcomes you 365 days a year to experience your emotions in one of its 5 screens!"
    ],
    "it": [
      "Situato in Place de Jaude, nel cuore della città, il Ciné Capitole vi accoglie 365 giorni all'anno per vivere le vostre emozioni in uno dei suoi 5 cinema!"
    ],
    "fr": [
      "Situé place de Jaude en plein cœur de ville, Ciné Capitole vous accueille 365 jours par an pour vivre vos émotions intensément dans l'une de ses 5 salles !"
    ],
    "es": [
      "Situado en la plaza de Jaude, en pleno centro de la ciudad, Ciné Capitole le da la bienvenida los 365 días del año para vivir sus emociones en una de sus 5 salas"
    ],
    "nl": [
      "Ciné Capitole, gelegen aan de Place de Jaude in het hart van de stad, verwelkomt je 365 dagen per jaar om je emoties te beleven in een van zijn 5 bioscopen!"
    ]
  },
