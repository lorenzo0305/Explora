  "rdfs:comment": {
    "de": [
      "Besuchen Sie dieses typische Dorf mit seinem Museum für Volkskunst und Traditionen, das Sie in die Vergangenheit zurückversetzen und das Leben von früher entdecken lässt!!!"
    ],
    "en": [
      "Come and visit this typical village with its Museum of Popular Arts and Traditions which will take you back in time and discover the life of yesteryear !"
    ],
    "it": [
      "Venite a visitare questo tipico villaggio con il suo Museo delle Arti e Tradizioni Popolari, che vi porterà indietro nel tempo per scoprire la vita del passato!"
    ],
    "fr": [
      "Venez visiter ce village typique avec son Musée des Arts et Traditions Populaires qui vous fera remonter dans le temps et découvrir la vie d'autrefois !!"
    ],
    "es": [
      "Venga a visitar este típico pueblo con su Museo de Artes y Tradiciones Populares, que le hará retroceder en el tiempo para descubrir la vida del pasado"
    ],
    "nl": [
      "Kom en bezoek dit typische dorp met zijn Museum van Volkskunst en -tradities, dat u mee terug in de tijd neemt om het leven van vroeger te ontdekken!"
    ]
  },
