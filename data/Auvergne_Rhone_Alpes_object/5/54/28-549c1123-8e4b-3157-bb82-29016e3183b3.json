  "rdfs:comment": {
    "de": [
      "Im Hafen von Le Crotoy lädt Sie La Maddy dazu ein, das Beste aus dem Meer zu entdecken: Fisch, Muscheln, Krustentiere... Direkt von den Fischern auf Ihren Teller! Entdecken Sie ihre Produkte und lassen Sie sich von einem leidenschaftlichen Team beraten. Täglich geöffnet."
    ],
    "en": [
      "At the Port du Crotoy, La Maddy invites you to discover the best of seafood: fish, shellfish, crustaceans... Straight from the fishermen to your plate! Come and discover their products and let our passionate team advise you. Open every day."
    ],
    "it": [
      "Nel Port du Crotoy, La Maddy vi invita a scoprire il meglio dei frutti di mare: pesci, molluschi, crostacei... Direttamente dai pescatori al vostro piatto! Venite a scoprire i loro prodotti e lasciatevi consigliare dal nostro team appassionato. Aperto tutti i giorni."
    ],
    "fr": [
      "Au Port du Crotoy, La Maddy vous invite à découvrir le meilleur des produits de la mer : poissons, coquillages, crustacés... Directement des pêcheurs à votre assiette ! Venez découvrir leurs produits et laissez-vous conseiller par une équipe passionnée. Ouvert tous les jours."
    ],
    "nl": [
      "In de Port du Crotoy nodigt La Maddy je uit om het beste van zeevruchten te ontdekken: vis, schelpdieren, schaaldieren... Rechtstreeks van de vissers naar uw bord! Kom hun producten ontdekken en laat je adviseren door ons gepassioneerde team. Elke dag geopend."
    ],
    "es": [
      "En el Puerto de Crotoy, La Maddy le invita a descubrir lo mejor del marisco: pescados, mariscos, crustáceos... ¡Directamente de los pescadores a su plato! Venga a descubrir sus productos y déjese aconsejar por nuestro apasionado equipo. Abierto todos los días."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Poissonnerie La Maddy"
    ]
  },
