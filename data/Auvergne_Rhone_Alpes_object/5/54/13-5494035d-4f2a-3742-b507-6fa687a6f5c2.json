  "rdfs:comment": {
    "de": [
      "Tropicalp golf aventure ist die größte landschaftlich gestaltete Minigolfanlage der Region. 2 Parcours mit 18 Bahnen zu verschiedenen Themen (Tropen und Alpen). Für die Kleinsten gibt es auch eine Strecke mit Elektroautos und Autoscooter..."
    ],
    "en": [
      "Tropicalp golf adventure is the region's largest landscaped Minigolf course. 2 themed 18-lane courses (tropics and alps). For the little ones, an electric car circuit and bumper cars are also available..."
    ],
    "it": [
      "L'avventura golfistica di Tropicalp è il più grande campo da minigolf paesaggistico della regione. 2 corsi di 18 tracce a tema (tropici e alpi). Per i più piccoli sono disponibili anche un circuito di auto elettriche e autoscontri..."
    ],
    "fr": [
      "Le Tropicalp golf aventure est le plus grand Minigolf paysager de la région. 2 parcours de 18 pistes à thèmes (tropiques et alpes). Pour les plus petits , un circuit de voitures électriques et des bouées tamponneuses sont également à disposition..."
    ],
    "es": [
      "La aventura de golf de Tropicalp es el mayor campo de Minigolf ajardinado de la región. 2 cursos de 18 pistas con temas (trópicos y alpes). Para los más pequeños, también hay un circuito de coches eléctricos y coches de choque..."
    ],
    "nl": [
      "Het Tropicalp golfavontuur is de grootste aangelegde minigolfbaan in de regio. 2 banen met 18 themabanen (tropen en Alpen). Voor de kleintjes zijn er ook een elektrisch autocircuit en botsauto's beschikbaar..."
    ]
  },
