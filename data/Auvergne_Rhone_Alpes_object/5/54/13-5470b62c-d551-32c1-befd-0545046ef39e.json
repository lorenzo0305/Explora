  "rdfs:comment": {
    "de": [
      "Melba: Das festliche Restaurant mit der Atmosphäre von Anfang 1900 in Annecy\r\nEntdecken Sie Melba, das unumgängliche festliche Restaurant in Annecy, wo Haute Cuisine und die bezaubernde Atmosphäre von Anfang 1900 aufeinandertreffen, um ein einzigartiges Erlebnis zu bieten."
    ],
    "en": [
      "Melba: Annecy's festive early 1900s restaurant\r\nDiscover Melba, Annecy's not-to-be-missed festive restaurant, where haute cuisine and the enchanting ambience of the early 1900s come together to offer a unique experience."
    ],
    "it": [
      "Melba: il ristorante festivo con atmosfera di inizio '900 ad Annecy\r\nScoprite Melba, l'imperdibile ristorante festivo di Annecy, dove l'alta cucina e l'incantevole atmosfera dei primi del '900 si fondono per creare un'esperienza unica."
    ],
    "fr": [
      "Melba : Le restaurant festif et ambiance début 1900 à Annecy\r\nDécouvrez Melba, le restaurant festif incontournable d'Annecy, où haute gastronomie et ambiance envoûtante de début 1900 se rencontrent pour offrir une expérience unique."
    ],
    "nl": [
      "Melba: het feestelijke restaurant met de sfeer van begin 1900 in Annecy\r\nOntdek Melba, het niet te missen feestrestaurant van Annecy, waar haute cuisine en de betoverende sfeer van begin 1900 samenkomen voor een unieke ervaring."
    ],
    "es": [
      "Melba: el restaurante festivo con ambiente de principios del siglo XX en Annecy\r\nDescubra Melba, el restaurante festivo ineludible de Annecy, donde la alta cocina y el ambiente encantador de principios del siglo XX se unen para crear una experiencia única."
    ]
  },
