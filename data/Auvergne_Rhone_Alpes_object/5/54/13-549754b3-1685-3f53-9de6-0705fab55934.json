  "rdfs:comment": {
    "de": [
      "Entdecken Sie unser neues Bar-Restaurant in einem wunderschönen, renovierten Gebäude! Genießen Sie eine 100% hausgemachte Küche mit einem schmackhaften und wechselnden Tagesmenü in einer gemütlichen Atmosphäre. Ein idealer Ort zum Schlemmen und Entspannen."
    ],
    "en": [
      "Discover our new bar-restaurant in a beautifully renovated building! Enjoy 100% home cooking with a tasty and ever-changing daily menu, all in a warm atmosphere. An ideal place to enjoy and relax."
    ],
    "it": [
      "Scoprite il nostro nuovo bar-ristorante in un edificio splendidamente ristrutturato! Godetevi una cucina casalinga al 100% con un menù giornaliero gustoso e variabile, il tutto in un'atmosfera accogliente. È il luogo ideale per rilassarsi e gustare un pasto delizioso."
    ],
    "fr": [
      "Découvrez notre nouveau bar-restaurant dans un magnifique bâtiment rénové ! Profitez d'une cuisine 100% maison avec un menu du jour savoureux et changeant, le tout dans une ambiance chaleureuse. Un lieu idéal pour se régaler et se détendre."
    ],
    "nl": [
      "Ontdek ons nieuwe bar-restaurant in een prachtig gerenoveerd gebouw! Geniet van 100% home cooking met een smakelijk en wisselend dagmenu, en dat alles in een warme sfeer. Het is de perfecte plek om te ontspannen en te genieten van een heerlijke maaltijd."
    ],
    "es": [
      "Descubra nuestro nuevo bar-restaurante en un bonito edificio renovado Disfrute de una cocina 100% casera con un sabroso y cambiante menú diario, todo ello en un ambiente acogedor. Es el lugar perfecto para relajarse y disfrutar de una deliciosa comida."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Bar restaurant Le Local"
    ]
  },
