  "rdfs:comment": {
    "de": [
      "Das Restaurant bietet Ihnen als Spezialität Couscous und Paella, aber auch alle traditionellen Gerichte der Auvergne wie Schweinefüße, Auvergnateneintopf, Kutteln, Pot au feu auf Bestellung und ab 10 Personen."
    ],
    "en": [
      "The restaurant specializes in couscous and paella, as well as traditional Auvergne dishes such as pig's trotters, Auvergne potée, tripe and pot au feu, available to order for groups of 10 or more."
    ],
    "it": [
      "Il ristorante è specializzato in couscous e paella, oltre a piatti tradizionali dell'Alvernia come lo zampone, la potée d'Auvergne, la trippa e il pot au feu, disponibili su ordinazione per gruppi di 10 o più persone."
    ],
    "fr": [
      "Le restaurant vous propose en spécialité le couscous et la paëlla, mais aussi tous les plats traditionnels auvergnat comme les pieds de cochon, la potée auvergnate, les tripes, pot au feu sur commande et dès 10 personnes."
    ],
    "nl": [
      "Het restaurant is gespecialiseerd in couscous en paella, maar ook in traditionele gerechten uit de Auvergne zoals varkenspoot, Auvergne potée, pens en pot au feu, te bestellen voor groepen vanaf 10 personen."
    ],
    "es": [
      "El restaurante está especializado en cuscús y paella, así como en platos tradicionales de Auvernia como manitas de cerdo, potée de Auvernia, callos y pot au feu, disponibles por encargo para grupos a partir de 10 personas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le 500 Bornes"
    ]
  },
