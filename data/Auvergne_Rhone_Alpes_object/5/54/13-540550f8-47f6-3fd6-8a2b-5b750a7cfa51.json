  "rdfs:comment": {
    "de": [
      "Entdecken Sie dieses traditionelle Restaurant, in dem die Leidenschaft für das Hausgemachte jeden Teller veredelt. Frische Produkte, authentische Aromen und Gastfreundschaft sorgen für ein einzigartiges und herzliches kulinarisches Erlebnis. Eine Adresse, die Sie sich nicht entgehen lassen sollten!"
    ],
    "en": [
      "Discover this traditional restaurant, where a passion for homemade delights every plate. Fresh produce, authentic flavours and a friendly atmosphere make for a unique and warm culinary experience. An address not to be missed!"
    ],
    "it": [
      "Scoprite questo ristorante tradizionale, dove la passione per la cucina casalinga delizia ogni piatto. Prodotti freschi, sapori autentici e un'atmosfera accogliente rendono l'esperienza culinaria unica e calorosa. Un indirizzo da non perdere!"
    ],
    "fr": [
      "Découvrez ce restaurant traditionnel où la passion du fait maison sublime chaque assiette. Produits frais, saveurs authentiques et convivialité au rendez-vous pour une expérience culinaire unique et chaleureuse. Une adresse à ne pas manquer !"
    ],
    "nl": [
      "Ontdek dit traditionele restaurant, waar een passie voor zelfgemaakte gerechten elk bord verrukt. Verse producten, authentieke smaken en een vriendelijke sfeer zorgen voor een unieke en warme culinaire ervaring. Een adres om niet te missen!"
    ],
    "es": [
      "Descubra este restaurante tradicional, donde la pasión por lo casero deleita cada plato. Los productos frescos, los sabores auténticos y el ambiente acogedor hacen que la experiencia culinaria sea única y cálida. ¡Una dirección que no debe perderse!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Rest'Ô Ptit Bois"
    ]
  },
