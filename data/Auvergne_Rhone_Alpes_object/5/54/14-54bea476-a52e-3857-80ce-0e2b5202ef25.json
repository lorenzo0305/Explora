  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/e343f5b1-d855-3ef5-b143-8bc3b7cdb25a",
      "dc:description": {
        "de": [
          "Diese Ausstellung bietet die Möglichkeit, die verschiedenen Fragen der Ökologie, des Klimawandels, der Biodiversität, der Treibhausgase, der CO2-Bilanz und der Lösungen zu erforschen."
        ],
        "en": [
          "This exhibition explores the issues of ecology, climate change, biodiversity, greenhouse gases, carbon footprint and solutions."
        ],
        "it": [
          "Questa mostra esplora i temi dell'ecologia, del cambiamento climatico, della biodiversità, dei gas serra, dell'impronta di carbonio e delle soluzioni."
        ],
        "fr": [
          "Cette exposition propose d'explorer les différentes questions de l'écologie, du dérèglement climatique, de la biodiversité, des gaz à effet de serre, du bilan carbone et des solutions."
        ],
        "es": [
          "Esta exposición explora los temas de la ecología, el cambio climático, la biodiversidad, los gases de efecto invernadero, la huella de carbono y las soluciones."
        ],
        "nl": [
          "Deze tentoonstelling verkent de thema's ecologie, klimaatverandering, biodiversiteit, broeikasgassen, koolstofvoetafdruk en oplossingen."
        ]
      },
