  "rdfs:comment": {
    "de": [
      "Küche aus aller Welt. Brasserie am Mittag. Abende mit verschiedenen Themen. Service bis Mitternacht. Service bis 23 Uhr am Dienstag, Mittwoch, Donnerstag und bis Mitternacht am Freitag, Samstag. Barservice bis 0:30 Uhr.\n\nLetzte Dienste: 2.00 Uhr und 0.00 Uhr\nSonntags und montags geschlossen."
    ],
    "en": [
      "World cuisine. Brasserie at lunchtime. Theme evenings. Service until midnight. Service until 11pm on Tuesdays, Wednesdays, Thursdays and until midnight on Fridays and Saturdays. Bar service until 12:30am.\n\nLast service: 2 p.m. and 12 a.m\nClosed Sundays and Mondays."
    ],
    "it": [
      "Cucina mondiale. Brasserie a pranzo. Serate a tema. Servizio fino a mezzanotte. Servizio fino alle 23.00 il martedì, mercoledì e giovedì e fino a mezzanotte il venerdì e il sabato. Servizio bar fino alle 12.30.\n\nUltimo servizio: ore 14.00 e mezzanotte\nChiuso la domenica e il lunedì."
    ],
    "fr": [
      "Cuisine du monde. Brasserie le midi. Soirées à thème. Service jusqu'à minuit. Service jusqu'à 23h le mardi, mercredi, jeudi et jusqu'à minuit le vendredi, samedi. Service bar jusqu'à 0h30.\n\nDerniers services : 14h00 et 00h00\nFermé les dimanches et lundis."
    ],
    "nl": [
      "Wereldkeuken. Brasserie 's middags. Thema-avonden. Bediening tot middernacht. Service tot 23.00 uur op dinsdag, woensdag en donderdag en tot middernacht op vrijdag en zaterdag. Barservice tot 12.30 uur.\n\nLaatste dienst: 14.00 en middernacht\nGesloten op zondag en maandag."
    ],
    "es": [
      "Cocina del mundo. Brasserie al mediodía. Veladas temáticas. Servicio hasta medianoche. Servicio hasta las 23h los martes, miércoles y jueves y hasta medianoche los viernes y sábados. Servicio de bar hasta las 12.30 h.\n\nÚltimo servicio: 14.00 h y medianoche\nDomingos y lunes cerrado."
    ]
  },
