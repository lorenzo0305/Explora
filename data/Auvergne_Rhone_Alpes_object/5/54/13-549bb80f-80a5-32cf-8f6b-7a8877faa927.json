  "rdfs:comment": {
    "de": [
      "Vibrieren Sie im Klang des Blues mit Jeff Toto Blues, der am 21. März ab 20 Uhr im Smart Cabaret in Brives-Charensac ein Konzert gibt. Ein einzigartiger Abend, um 35 Jahre auf der Bühne, musikalische Leidenschaft und prägende Begegnungen zu feiern."
    ],
    "en": [
      "Vibrate to the sound of the blues with Jeff Toto Blues, in concert on March 21 from 8pm at the Smart Cabaret in Brives-Charensac. A unique evening to celebrate 35 years of stage performances, musical passion and memorable encounters."
    ],
    "it": [
      "Vibrate al suono del blues con Jeff Toto Blues, in concerto il 21 marzo dalle 20.00 allo Smart Cabaret di Brives-Charensac. Una serata unica per celebrare 35 anni di esibizioni dal vivo, passione musicale e incontri memorabili."
    ],
    "fr": [
      "Vibrez au son du blues avec Jeff Toto Blues, en concert le 21 mars dès 20h au Smart Cabaret de Brives-Charensac. Une soirée unique pour fêter 35 ans de scènes, de passion musicale et de rencontres marquantes."
    ],
    "es": [
      "Vibre al son del blues con Jeff Toto Blues, en concierto el 21 de marzo a partir de las 20:00 h en el Smart Cabaret de Brives-Charensac. Una velada única para celebrar 35 años de actuaciones en directo, pasión musical y encuentros memorables."
    ],
    "nl": [
      "Tril mee met de sound van de blues met Jeff Toto Blues, op 21 maart vanaf 20.00 uur in het Smart Cabaret in Brives-Charensac. Een unieke avond om 35 jaar live optredens, muzikale passie en memorabele ontmoetingen te vieren."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Concert : Jeff Toto Blues"
    ]
  },
