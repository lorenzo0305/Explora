  "rdfs:comment": {
    "de": [
      "Die Myrtilleraie hat es sich zur Aufgabe gemacht, Konfitüren, Kompotte, Suppen und Chutneys aus Obst und Gemüse herzustellen und zu verkaufen, das ohne Insektizide angebaut wird.\r\nSeit 2024 können Sie auch Ziegenkäse direkt ab Hof kaufen."
    ],
    "en": [
      "La Myrtilleraie makes and sells jams, compotes, soups and chutneys from insecticide-free fruit and vegetables.\r\nFrom April 2024, you'll be able to find goat cheeses sold directly from the farm."
    ],
    "it": [
      "La Myrtilleraie produce e vende marmellate, composte, zuppe e chutney a base di frutta e verdura priva di insetticidi.\r\nDal 2024, il formaggio di capra viene venduto direttamente dalla fattoria."
    ],
    "fr": [
      "La Myrtilleraie a pour vocation la confection et la vente de confitures, compotes, soupes, chutney de de fruits et légumes cultivés sans insecticide.\r\nDepuis 2024, vous pourrez retrouver des fromages de chèvres vendus directement à la ferme."
    ],
    "nl": [
      "La Myrtilleraie maakt en verkoopt jam, compote, soepen en chutneys van fruit en groenten zonder insecticiden.\r\nSinds 2024 wordt de geitenkaas rechtstreeks van de boerderij verkocht."
    ],
    "es": [
      "La Myrtilleraie elabora y vende mermeladas, compotas, sopas y chutneys a partir de frutas y verduras libres de insecticidas.\r\nDesde 2024, el queso de cabra se vende directamente en la granja."
    ]
  },
