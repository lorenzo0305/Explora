  "rdfs:comment": {
    "de": [
      "Wellness-Modellagen für Momente der Entspannung und Gesichts- und Körperpflege versprechen einen immer wieder neuen Alltag im Zeichen der Schönheit. Kosmetikerin zu Hause, Enthaarungszentrum, Maniküre, Pflege zu Hause."
    ],
    "en": [
      "Well-being massages for moments of relaxation and face and body treatments are the promise of a constantly renewed daily life under the sign of beauty. Esthetician at home, waxing center, manicure, home treatments."
    ],
    "it": [
      "Massaggi benessere per momenti di relax e trattamenti viso e corpo sono la promessa di una quotidianità sempre rinnovata nel segno della bellezza. Estetista a domicilio, centro cerette, manicure, trattamenti a domicilio."
    ],
    "fr": [
      "Des modelages bien-être pour des instants de relaxation et des soins du visage et du corps sont la promesse d'un quotidien sans cesse renouvelé sous le signe de la beauté. Esthéticienne à domicile, centre d'épilation, manucure, soins à domicile."
    ],
    "nl": [
      "Wellnessmassages voor momenten van ontspanning en gezichts- en lichaamsbehandelingen zijn de belofte van een voortdurend vernieuwd dagelijks leven in het teken van schoonheid. Schoonheidsspecialiste aan huis, harsen, manicure, thuisbehandelingen."
    ],
    "es": [
      "Masajes de bienestar para momentos de relajación y tratamientos faciales y corporales son la promesa de un día de belleza siempre cambiante. Esteticista a domicilio, centro de depilación, manicura, tratamientos a domicilio."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Institut Le Temps d'un Instant"
    ]
  },
