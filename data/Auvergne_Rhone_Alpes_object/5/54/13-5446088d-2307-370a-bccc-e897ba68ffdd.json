  "rdfs:comment": {
    "de": [
      "L'Essentiel, ein gemütliches Café-Restaurant! Entspannen Sie sich an einem Tisch und genießen Sie die traditionelle Küche...\r\n\r\nEin typisches Restaurant im Herzen von Bressolles, einem Dorf, das für seine zahlreichen Brotbacköfen bekannt ist."
    ],
    "en": [
      "L'Essentiel, a friendly café-restaurant! Come and relax around a table and enjoy traditional cuisine...\r\n\r\nA typical restaurant in the heart of Bressolles, a village famous for its many bread ovens."
    ],
    "it": [
      "L'Essentiel, un caffè-ristorante accogliente! Venite a rilassarvi attorno a un tavolo e a gustare la cucina tradizionale...\r\n\r\nUn ristorante tipico nel cuore di Bressolles, un villaggio famoso per i suoi numerosi forni per il pane."
    ],
    "fr": [
      "L'Essentiel, un café restaurant convivial ! Venez vous détendre autour d'une table et déguster une cuisine traditionnelle... \r\n\r\nUn restaurant typique au cœur de Bressolles, village connu pour ses nombreux fours à pains."
    ],
    "nl": [
      "L'Essentiel, een gezellig café-restaurant! Kom ontspannen aan tafel en geniet van de traditionele keuken...\r\n\r\nEen typisch restaurant in het hart van Bressolles, een dorp dat beroemd is om zijn vele broodovens."
    ],
    "es": [
      "L'Essentiel, ¡un café-restaurante acogedor! Venga a relajarse alrededor de una mesa y disfrute de la cocina tradicional...\r\n\r\nUn restaurante típico en el corazón de Bressolles, pueblo famoso por sus numerosos hornos de pan."
    ]
  },
