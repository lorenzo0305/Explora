  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/9abf07cf-15a0-39c0-b774-da32113b7ea8",
      "dc:description": {
        "de": [
          "Weihnachtsmarkt in Frencq\nSonntag, den 7. Dezember von 9 bis 18 Uhr\nStade de l'Abbé Caux (Stadion des Abbé Caux)\n-------------------------\nAuf dem Programm stehen:\n- Kunsthandwerkliche Ausstellungen\n- Anwesenheit von Saint-Nicolas am Nachmittag\n- Skulptur von Guénels\n- Schnelle Verpflegung\n\nCredit: Pixabay"
        ],
        "en": [
          "Frencq Christmas Market\nSunday December 7, 9am to 6pm\nAbbé Caux Stadium\n-------------------------\nOn the program :\n- Craft exhibitions\n- Presence of Saint-Nicolas in the afternoon\n- Guénels sculpture\n- Fast food\n\nCredit : Pixabay"
        ],
        "it": [
          "Mercatino di Natale di Frencq\nDomenica 7 dicembre dalle 9.00 alle 18.00\nStadio Abbé Caux\n-------------------------\nIn programma\n- Mostre di artigianato\n- Saint-Nicolas nel pomeriggio\n- Scultura di Guénels\n- Cibo veloce\n\nCredito : Pixabay"
        ],
        "fr": [
          "Marché de Noël de Frencq\nDimanche 7 décembre de 9h à 18h\nStade de l’Abbé Caux\n-------------------------\nAu programme : \n- Expositions artisanales\n- Présence de Saint-Nicolas l’après-midi\n- Sculpture de Guénels \n- Restauration rapide\n\nCrédit : Pixabay"
        ],
        "es": [
          "Mercado de Navidad de Frencq\nDomingo 7 de diciembre de 9:00 a 18:00\nEstadio Abbé Caux\n-------------------------\nEn el programa\n- Exposiciones de artesanía\n- Saint-Nicolas por la tarde\n- Escultura de Guénels\n- Comida rápida\n\nCrédito : Pixabay"
        ],
        "nl": [
          "Frencq Kerstmarkt\nZondag 7 december van 9 tot 18 uur\nStadion Abbé Caux\n-------------------------\nOp het programma\n- Ambachtelijke tentoonstellingen\n- Sint-Niklaas in de namiddag\n- Beeldhouwwerk van Guénels\n- Snel eten\n\nKrediet : Pixabay"
        ]
      },
