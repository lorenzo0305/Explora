  "rdfs:comment": {
    "de": [
      "Spielzeugmuseum der 50er und 60er Jahre. Bei einem Spaziergang durch dieses Museum werden Sie Spielzeug wiederfinden, das Sie besessen haben, und anderes, das Sie gerne gehabt hätten. Tauchen Sie ein in Ihre \"Kindheitserinnerungen\"."
    ],
    "en": [
      "Museum of toys from the 50s and 60s. As you stroll through the museum, you'll come across toys you once had, and others you wish you'd had. Come and immerse yourself in your childhood memories."
    ],
    "it": [
      "Museo dei giocattoli degli anni '50 e '60. Passeggiando per il museo troverete i giocattoli che avevate un tempo e altri che avreste voluto avere. Venite a immergervi nei vostri ricordi d'infanzia."
    ],
    "fr": [
      "Musée du jouet années 50-60. En vous promenant dans ce musée, vous retrouverez des jouets que vous avez eu, d'autres que vous auriez aimé avoir. Venez plonger dans vos \"Souvenirs d'Enfant\"."
    ],
    "nl": [
      "Museum van speelgoed uit de jaren 50 en 60. Wandel door het museum en je zult speelgoed vinden dat je ooit hebt gehad en waarvan je zou willen dat je het had. Kom en dompel jezelf onder in je jeugdherinneringen."
    ],
    "es": [
      "Museo de juguetes de los años 50 y 60. Pasee por el museo y encontrará juguetes que un día tuvo y otros que desearía haber tenido. Ven y sumérgete en los recuerdos de tu infancia."
    ]
  },
  "rdfs:label": {
    "en": [
      "Toy Museum"
    ],
    "fr": [
      "Musée du jouet"
    ]
  },
