  "rdfs:comment": {
    "de": [
      "Die Bibliothek, die seit 1984 besteht, ist reich an Büchern (Romane, verschiedene Dokumente für Groß und Klein) und Tondokumenten und steht allen kostenlos zur Verfügung."
    ],
    "en": [
      "The library, which opened in 1984, boasts a rich collection of books (novels and various other material for both adults and children) and audio books. It is open to all, free of charge."
    ],
    "it": [
      "La biblioteca, che esiste dal 1984, è aperta a tutti gratuitamente e dispone di un'ampia gamma di libri (romanzi, documenti vari per giovani e anziani) e documenti audio."
    ],
    "fr": [
      "Riche de nombreux ouvrages (romans, documents variés pour grands et petits) et documents sonores, la bibliothèque, qui existe depuis 1984, est ouverte à tous gratuitement."
    ],
    "es": [
      "La biblioteca, que existe desde 1984, está abierta a todo el mundo de forma gratuita y cuenta con una amplia gama de libros (novelas, documentos diversos para jóvenes y mayores) y documentos de audio."
    ],
    "nl": [
      "De bibliotheek, die sinds 1984 bestaat, is voor iedereen gratis toegankelijk en heeft een ruim aanbod aan boeken (romans, diverse documenten voor jong en oud) en geluidsdocumenten."
    ]
  },
