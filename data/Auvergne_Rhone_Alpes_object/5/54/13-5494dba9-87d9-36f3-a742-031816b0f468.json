  "rdfs:comment": {
    "de": [
      "Flaine hat dank des harmonischen Designs, das auf alle Gebäude des Ortes angewendet wurde, einen klaren und modernen Charakter."
    ],
    "en": [
      "Flaine has a clean, modern feel thanks to the harmonious design applied to all the resort's buildings."
    ],
    "it": [
      "Flaine ha un'atmosfera pulita e moderna grazie al design armonioso applicato a tutti gli edifici del resort."
    ],
    "fr": [
      "Flaine possède un cachet épuré et moderne grâce à l’harmonie de design appliquée à l’ensemble des bâtiments de la station."
    ],
