  "rdfs:comment": {
    "de": [
      "Die 1844 gebohrte Lardy-Quelle wurde nach einem ihrer beiden Erfinder, Henri Lardy, zusammen mit seinem Schwager Pierre Ménot Saint-Ange benannt; sie wurde auch als \"Tee von Vichy\" bezeichnet, da sie als sehr bekömmlich galt."
    ],
    "en": [
      "The Lardy spring, drilled in 1844, bears the name of one of its two inventors, Henri Lardy, in association with his brother-in-law Pierre Ménot Saint-Ange; it was also nicknamed \"Vichy tea\" because of its reputation for being easily digested."
    ],
    "it": [
      "La sorgente Lardy, perforata nel 1844, porta il nome di uno dei suoi due inventori, Henri Lardy, in associazione con il cognato Pierre Ménot Saint-Ange; era anche soprannominata \"il tè di Vichy\" per la sua reputazione di essere facilmente digeribile."
    ],
    "fr": [
      "La source Lardy forée en 1844 porte le nom de l’un de ses deux inventeurs, Henri Lardy, associé à son beau-frère Pierre Ménot Saint-Ange ; elle était aussi surnommée « le thé de Vichy » car réputée très digeste."
    ],
    "es": [
      "El manantial de Lardy, perforado en 1844, lleva el nombre de uno de sus dos inventores, Henri Lardy, en asociación con su cuñado Pierre Ménot Saint-Ange; también fue apodado \"el té de Vichy\" por su reputación de fácil digestión."
    ],
    "nl": [
      "De Lardy-bron, geboord in 1844, draagt de naam van een van de twee uitvinders, Henri Lardy, in samenwerking met zijn zwager Pierre Ménot Saint-Ange; het kreeg ook de bijnaam \"de thee van Vichy\" vanwege zijn reputatie als licht verteerbaar."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Pavillon de la source Lardy"
    ]
  },
