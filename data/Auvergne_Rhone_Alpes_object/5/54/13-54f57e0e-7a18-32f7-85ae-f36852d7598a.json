  "rdfs:comment": {
    "de": [
      "Das Restaurant der Auberge Ensoleillée bietet Ihnen eine schmackhafte und authentische Küche mit einer herrlichen Aussicht auf den Col de l'Étendard. Nach einem Tag auf der Skipiste können Sie hier inmitten der Berge eine wärmende Mahlzeit genießen."
    ],
    "en": [
      "Discover an exceptional culinary experience at the Auberge Ensoleillée, nestling in the heart of an authentic setting steeped in history."
    ],
    "it": [
      "Il ristorante Auberge Ensoleillée offre una cucina gustosa e autentica con una magnifica vista sul Col de l'Étendard. Dopo una giornata sulle piste, godetevi il comfort food nel cuore delle montagne."
    ],
    "fr": [
      "Le restaurant de l'Auberge Ensoleillée vous propose une cuisine savoureuse et authentique, avec une magnifique vue sur le col de l'Étendard. Après une journée sur les pistes, savourez des plats réconfortants au cœur des montagnes."
    ],
    "nl": [
      "Ontdek een uitzonderlijke culinaire ervaring in de Auberge Ensoleillée, genesteld in het hart van een authentieke omgeving vol geschiedenis."
    ],
    "es": [
      "El restaurante del Auberge Ensoleillée ofrece una cocina sabrosa y auténtica con una magnífica vista del Col de l'Étendard. Después de un día en las pistas, disfrute de una comida reconfortante en el corazón de las montañas."
    ]
  },
  "rdfs:label": {
    "en": [
