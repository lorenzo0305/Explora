  "rdfs:comment": {
    "de": [
      "Für Vintage-Liebhaber: Eine kleine Ecke der Nostalgie für Liebhaber von Dingen, die unserem Herzen und unseren Wünschen wertvoll sind, Gegenstände, die eine Geschichte erzählen, Nippes, Kolifichets, Bücher und Wanddekorationen. Kunsthandwerkliche Gegenstände."
    ],
    "en": [
      "For lovers of vintage : a little corner of nostalgia for lovers of precious things to our heart, our desires, objects that tell a story, ornaments, books and wall decorations."
    ],
    "it": [
      "Per gli amanti del vintage: un piccolo angolo di nostalgia per gli amanti delle cose preziose per il nostro cuore, per i nostri desideri, oggetti che raccontano una storia, gingilli, ninnoli, libri e decorazioni da parete. Oggetti di artigianato."
    ],
    "fr": [
      "Pour les amoureux du vintage : un petit coin de nostalgie pour les amateurs de choses précieuses à notre cœur, à nos envies, des objets qui racontent une histoire, bibelots, colifichets, livres et décors muraux. Objets d'artisanat."
    ],
    "nl": [
      "Voor liefhebbers van vintage: een nostalgisch hoekje voor liefhebbers van dingen die ons dierbaar zijn, voorwerpen die een verhaal vertellen, curiosa, snuisterijen, boeken en wanddecoratie. Kunst en ambacht."
    ],
    "es": [
      "Para los amantes de lo vintage: un pequeño rincón de nostalgia para los amantes de las cosas preciosas de nuestro corazón, de nuestros deseos, de los objetos que cuentan una historia, de las baratijas, de los libros y de las decoraciones de pared. Objetos de artesanía."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le vintage du Facteur"
    ]
  },
