      "@id": "https://data.datatourisme.fr/7741142f-c79f-364c-8feb-056aaf124d18",
      "dc:description": {
        "de": [
          "Wanderung von 6 km\nSamstag, 4. Oktober um 10 Uhr\nOrt: Rathaus des Dorfes\n----------------------\nErlöse gehen an den Verein Etincelle\n\nAnmeldung vor Ort ab 9:30 Uhr\nPreis: 5? pro Erwachsener und 2? pro Kind - kostenloser Imbiss\n\nCredit: Pixabay"
        ],
        "en": [
          "6km walk\nSaturday, October 4 at 10 a.m\nLocation: Village Hall\n----------------------\nProfits donated to Association Etincelle\n\nRegistration on site from 9:30am\nPrice: 5? per adult and 2? per child - Snack offered\n\nCredit : Pixabay"
        ],
        "it": [
          "Camminata di 6 km\nSabato 4 ottobre alle 10.00\nSede: Sala del villaggio\n----------------------\nIl ricavato è devoluto all'Associazione Etincelle\n\nIscrizioni sul posto dalle 9.30\nPrezzo: 5? per adulto e 2? per bambino - Merenda offerta\n\nCredito : Pixabay"
        ],
        "fr": [
          "Marche de 6km\nSamedi 4 octobre à 10h\nLieu : Mairie du village\n----------------------\nBénéfices reversés à l’Association Etincelle\n\nInscriptions sur place à partir de 9h30\nTarif : 5€ par adulte et 2€ par enfant - Collation offerte\n\nCrédit : Pixabay"
        ],
        "es": [
          "Marcha de 6 km\nSábado 4 de octubre a las 10h\nLugar: Village Hall\n----------------------\nBeneficios donados a la Asociación Etincelle\n\nInscripciones in situ a partir de las 9.30\nPrecio: 5? por adulto y 2? por niño - Merienda ofrecida\n\nCrédito : Pixabay"
        ],
        "nl": [
          "6km wandeling\nZaterdag 4 oktober om 10.00 uur\nPlaats: Dorpshuis\n----------------------\nDe winst gaat naar de vereniging Etincelle\n\nInschrijving ter plaatse vanaf 9.30 uur\nPrijs: 5? per volwassene en 2? per kind - Snack aangeboden\n\nKrediet: Pixabay"
        ]
      },
