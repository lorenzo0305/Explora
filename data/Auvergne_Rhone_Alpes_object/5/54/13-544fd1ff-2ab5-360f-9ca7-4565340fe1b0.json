  "rdfs:comment": {
    "de": [
      "Im Atelier Miss Terre kreiert Christel Schmuck sowie Gebrauchs- und Dekorationsgegenstände aus Keramik (Steingut und Raku). Sie organisiert außerdem Workshops und Praktika in Töpferei und kreativer Freizeitgestaltung für Erwachsene, Jugendliche und Kinder.\nAusstellungs- und Verkaufsveranstaltungen und Besichtigungen nach Vereinbarung."
    ],
    "en": [
      "Pottery workshop."
    ],
    "it": [
      "All'Atelier Miss Terre, Christel crea gioielli e oggetti utilitari e decorativi in ceramica (terracotta e raku). Organizza inoltre laboratori di ceramica e corsi creativi per il tempo libero per adulti, adolescenti e bambini.\nMostre e visite su appuntamento."
    ],
    "fr": [
      "A l'Atelier Miss Terre, Christel crée bijoux et objets utilitaires et décoratifs en céramique (faïence et raku). Elle organise également des ateliers et stages de poterie et loisirs créatifs pour adultes, ados et enfants.\nExpo-vente et visites sur rdv."
    ],
    "es": [
      "En el Atelier Miss Terre, Christel crea joyas y objetos utilitarios y decorativos de cerámica (barro y rakú). También organiza talleres y cursos de alfarería y ocio creativo para adultos, adolescentes y niños.\nExposiciones y visitas con cita previa."
    ],
    "nl": [
      "Bij Atelier Miss Terre maakt Christel sieraden en gebruiks- en siervoorwerpen van keramiek (aardewerk en raku). Ze organiseert ook workshops en cursussen pottenbakken en creatieve vrijetijdsbesteding voor volwassenen, tieners en kinderen.\nTentoonstellingen en bezoeken op afspraak."
    ]
  },
  "rdfs:label": {
    "en": [
      "Atelier Miss Terre"
    ],
    "fr": [
      "Atelier Miss Terre - Christel Guillerme"
    ]
  },
