  "rdfs:comment": {
    "de": [
      "Guy Lassausaie, Meilleur Ouvrier de France und 1* Michelin, verkörpert die vierte Generation am Herd der ehemaligen Poststation. Er interpretiert die Lyoner Küche neu, indem er sich von seinen Reisen inspirieren lässt, in einem zeitgenössischen und gemütlichen Ambiente."
    ],
    "en": [
      "Guy Lassausaie, awarded the 'Meilleur Ouvrier de France' (best craftsman of France) title and 1 star from the Michelin Guide, represents the fourth generation in the kitchens of this former coaching inn. He adds his own unique touch to the specialities of Lyon by drawing inspiration from his travels, in a contemporary and inviting atmosphere."
    ],
    "it": [
      "Guy Lassausaie, Meilleur Ouvrier de France e 1* Michelin, è la quarta generazione alla guida dell'ex ufficio postale. Rivisita la cucina lionese ispirandosi ai suoi viaggi, in un'atmosfera contemporanea e accogliente."
    ],
    "fr": [
      "Guy Lassausaie, Meilleur Ouvrier de France et 1* Michelin, incarne la quatrième génération aux fourneaux de l'ancien relais de poste. Il revisite la cuisine  lyonnaise en s'inspirant de ses voyages, dans une ambiance contemporaine et chaleureuse."
    ],
    "es": [
      "Guy Lassausaie, Meilleur Ouvrier de France y 1* Michelin, es la cuarta generación al frente de la antigua oficina de correos. Revisa la cocina lionesa, inspirada en sus viajes, en un ambiente contemporáneo y cálido."
    ],
    "nl": [
      "Guy Lassausaie, Meilleur Ouvrier de France en 1* Michelin, is de vierde generatie die aan het roer staat van het voormalige postkantoor. Hij herneemt de keuken van Lyon, geïnspireerd door zijn reizen, in een eigentijdse en warme sfeer."
    ]
  },
