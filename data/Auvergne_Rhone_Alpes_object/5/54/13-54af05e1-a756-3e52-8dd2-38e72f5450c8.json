  "rdfs:comment": {
    "de": [
      "Willkommen im Relais Cyné de Paladru; wir können Sie für die Dauer eines Picknicks oder für eine Etappe im Biwak empfangen.\r\nPicknicktisch, Anbindestange für Pferde, Unterstände, Parkplatz und Wasser stehen Ihnen zur Verfügung."
    ],
    "en": [
      "Welcome to Relais Cyné de Paladru, where we can welcome you for a picnic or a bivouac.\r\nPicnic tables, horse tie-downs, shelters, parking and water are at your disposal."
    ],
    "it": [
      "Benvenuti al Relais Cyné de Paladru; possiamo ospitarvi per un picnic o un bivacco.\r\nAbbiamo a disposizione un tavolo da picnic, una barra per legare i cavalli, ripari, parcheggio e acqua."
    ],
    "fr": [
      "Bienvenue au Relais Cyné de Paladru ; nous pouvons vous accueillir le temps d'un pique nique ou pour une étape en bivouac.\r\nTable de pique-nique, barre d'attache pour chevaux, abris, parking et eau sont à votre dispositions."
    ],
    "nl": [
      "Welkom op Relais Cyné de Paladru; we kunnen je ontvangen voor een picknick of een bivak.\r\nWe hebben een picknicktafel, een paardenbox, schuilhutten, parkeerplaats en water tot je beschikking."
    ],
    "es": [
      "Bienvenido al Relais Cyné de Paladru; podemos acogerle para un picnic o un vivac.\r\nTenemos una mesa de picnic, un bar para atar caballos, refugios, aparcamiento y agua a su disposición."
    ]
  },
