  "rdfs:comment": {
    "de": [
      "Der Bataillières-See liegt in einer erhabenen Landschaft und ist reich an Bachlachsen, Bach- und Regenbogenforellen."
    ],
    "en": [
      "Set in a sublime setting, the Bataillières lake is full of brook salmon, as well as fario and rainbow trout."
    ],
    "it": [
      "In un contesto sublime, il Lac des Bataillières pullula di salmoni di ruscello, oltre che di trote fario e iridee."
    ],
    "fr": [
      "Planté dans un décor sublime, le lac des Bataillières regorge de saumons de fontaine, ainsi que de truites fario et arc-en-ciel."
    ],
    "nl": [
      "Het meer van Bataillières, gelegen in een sublieme omgeving, zit vol beekzalm, fario en regenboogforel."
    ],
    "es": [
      "En un marco sublime, el lago de Bataillières está repleto de salmones de arroyo, así como de truchas fario y arco iris."
    ]
  },
