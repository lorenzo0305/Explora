  "rdfs:comment": {
    "de": [
      "Das Haus wurde 1902 gegründet. Öffnen Sie die Tür von Vercornoix und entdecken Sie alle Produkte des Vercors. Direktverkauf von Nüssen und ihren Gourmet-Derivaten."
    ],
    "en": [
      "Founded in 1902. Welcome to Verconoix where you'll discover all the produce of the Vercors Massif. Direct sales of nuts and gourmet by-products."
    ],
    "it": [
      "Fondata nel 1902. Spingete la porta di Vercornoix e scoprite tutti i prodotti del Vercors. Vendita diretta di noci e dei loro derivati gastronomici."
    ],
    "fr": [
      "Maison fondée en 1902. Poussez la porte de Vercornoix et découvrez tous les produits du Vercors. Vente directe de noix et ses dérivés gourmands."
    ],
    "nl": [
      "Huis opgericht in 1902. Duw de deur van de Vercornoix open en ontdek alle producten uit de Vercors. Directe verkoop van noten en lekkernijen met noten."
    ],
    "es": [
      "Fundada en 1902. Empuje la puerta de Vercornoix y descubra todos los productos del Vercors. Venta directa de nueces y sus derivados gourmet."
    ]
  },
