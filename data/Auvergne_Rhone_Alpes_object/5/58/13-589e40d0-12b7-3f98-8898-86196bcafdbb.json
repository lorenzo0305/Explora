  "rdfs:comment": {
    "de": [
      "Die Gemeindebibliothek lädt Sie in Partnerschaft mit dem gemeindeübergreifenden Bibliotheksnetzwerk Ardèche Rhône Coiron zu einem gemütlichen Leseabend ein."
    ],
    "en": [
      "The communal library invites you to share a moment of reading in a friendly atmosphere in partnership with the Ardèche Rhône Coiron inter-municipal library network."
    ],
    "it": [
      "La biblioteca locale vi invita a condividere un momento di lettura in un'atmosfera amichevole, in collaborazione con la rete bibliotecaria intercomunale Ardèche Rhône Coiron."
    ],
    "fr": [
      "La bibliothèque communale vous invite à partager un moment de lecture en toute convivialité en partenariat avec le réseau bibliothèques intercommunales Ardèche Rhône Coiron."
    ],
    "es": [
      "La biblioteca local le invita a compartir un momento de lectura en un ambiente agradable en colaboración con la red de bibliotecas intercomunales Ardèche Rhône Coiron."
    ],
    "nl": [
      "De plaatselijke bibliotheek nodigt u uit voor een leesmoment in een gezellige sfeer in samenwerking met het intercommunale bibliotheeknetwerk Ardèche Rhône Coiron."
    ]
  },
