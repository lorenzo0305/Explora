  "rdfs:comment": {
    "de": [
      "Das Restaurant bietet Ihnen eine traditionelle, leckere und großzügige Küche, damit sich jeder Augenblick in ein Stück Genuss rund um das Geschmackszifferblatt aus Salaten, regionalen Gerichten, Gegrilltem, aber auch Fisch verwandelt."
    ],
    "en": [
      "The restaurant offers you traditional, hearty and gourmet cuisine so that each moment is deliciously savoured through an array of salads, regional dishes, grilled meat and vegetables, and fresh fish."
    ],
    "it": [
      "Il ristorante offre una cucina tradizionale, gourmet e generosa in modo che ogni momento diventi un pezzo di delizia intorno al quadrante gustativo che sono insalate, piatti regionali, carni alla griglia, ma anche pesce."
    ],
    "fr": [
      "Le restaurant vous propose une cuisine traditionnelle, gourmande et généreuse pour que chaque instant se transforme en morceau de délice autour du cadran gustatif que sont les salades, les plats régionaux, les grillades, mais aussi les poissons."
    ],
    "nl": [
      "Het restaurant biedt een traditionele smakelijke en rijke keuken, zodat elk moment een moment van puur genot wordt rondom het buffet met salades, regionale gerechten, gril- en visgerechten."
    ],
    "es": [
      "El restaurante ofrece una cocina tradicional, gourmet y generosa para que cada momento se convierta en una pieza de deleite alrededor del dial gustativo que son las ensaladas, los platos regionales, las carnes a la parrilla, pero también el pescado."
    ]
  },
