  "rdfs:comment": {
    "de": [
      "Das Gebiet Monts Jura LA VATTAY ist mit seinen 100 km Pisten ganz dem nordischen Skisport gewidmet. Hier können Sie nach Herzenslust Skating oder Alternativski laufen."
    ],
    "en": [
      "Monts Jura LA VATTAY is entirely dedicated to Nordic skiing, with 100 km of trails. You can practice skating or alternating at your leisure."
    ],
    "it": [
      "Il sito Monts Jura LA VATTAY è interamente dedicato allo sci nordico, con 100 km di piste. Potrete praticare il pattinaggio o l'alternanza a vostro piacimento."
    ],
    "fr": [
      "Le site Monts Jura LA VATTAY est entièrement dédié au ski nordique avec ses 100 km de pistes. Vous pourrez y pratiquer à loisir le skating ou l'alternatif."
    ],
    "es": [
      "El centro Monts Jura LA VATTAY está totalmente dedicado al esquí nórdico, con 100 km de pistas. Podrá practicar el patinaje o la alternancia a su aire."
    ],
    "nl": [
      "De site Monts Jura LA VATTAY is volledig gewijd aan Noords skiën, met 100 km pistes. Je kunt er op je gemak skaten of afwisselen."
    ]
  },
