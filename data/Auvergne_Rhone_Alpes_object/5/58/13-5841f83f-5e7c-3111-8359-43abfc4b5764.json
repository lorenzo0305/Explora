  "rdfs:comment": {
    "de": [
      "Willkommen bei Cérès, unserer handwerklichen und ethischen Brennerei in der Auvergne, am Rande von Clermont-Ferrand.\r\nWir stellen kreative Spirituosen her, die den ganzen Reichtum der lokalen Ressourcen zum Ausdruck bringen."
    ],
    "en": [
      "Welcome to Cérès, our artisanal and ethical distillery in Auvergne, just outside Clermont-Ferrand.\r\nWe produce creative spirits that express the full richness of local resources."
    ],
    "it": [
      "Benvenuti a Cérès, la nostra distilleria tradizionale ed etica in Alvernia, alle porte di Clermont-Ferrand.\r\nProduciamo distillati creativi che esaltano la ricchezza delle risorse locali."
    ],
    "fr": [
      "Bienvenue chez Cérès, notre distillerie artisanale et éthique en Auvergne, aux abords de Clermont-Ferrand. \r\nNous produisons des alcools créatifs qui expriment toutes les richesses des ressources locales."
    ],
    "nl": [
      "Welkom bij Cérès, onze traditionele en ethische distilleerderij in de Auvergne, net buiten Clermont-Ferrand.\r\nWij produceren creatieve gedistilleerde dranken die de rijkdom van de lokale bronnen ten volle benutten."
    ],
    "es": [
      "Bienvenido a Cérès, nuestra destilería tradicional y ética de Auvernia, a las afueras de Clermont-Ferrand.\r\nProducimos espirituosos creativos que sacan toda la riqueza de los recursos locales."
    ]
  },
