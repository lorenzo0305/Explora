  "rdfs:comment": {
    "de": [
      "Entdecken Sie Chez Roger, eine spielerische grüne Piste, die in einen riesigen Boarder verwandelt wurde!\r\nSie ist für alle zugänglich und bietet eine lustige und sichere Strecke, auf der Groß und Klein zwischen den Hindernissen Slalom fahren können."
    ],
    "en": [
      "Discover Chez Roger, a fun green run transformed into a giant boarder!\r\nAccessible to all, it offers a fun and safe course where young and old alike can slalom between the obstacles."
    ],
    "it": [
      "Scoprite Chez Roger, una divertente pista verde trasformata in un gigantesco boarder!\r\nAccessibile a tutti, offre un percorso divertente e sicuro dove grandi e piccini possono fare lo slalom tra gli ostacoli."
    ],
    "fr": [
      "Découvrez Chez Roger, une piste verte ludique transformée en un boarder géant !\r\nAccessible à tous, elle propose un parcours amusant et sécurisé où petits et grands peuvent slalomer entre les obstacles."
    ],
    "nl": [
      "Ontdek Chez Roger, een leuke groene piste die is omgetoverd tot een gigantische boarder!\r\nHet is toegankelijk voor iedereen en biedt een leuk en veilig parcours waar jong en oud kunnen slalommen tussen de hindernissen."
    ],
    "es": [
      "Descubra Chez Roger, ¡una divertida pista verde transformada en un boarder gigante!\r\nAccesible a todos, ofrece un recorrido divertido y seguro donde pequeños y mayores pueden hacer slalom entre los obstáculos."
    ]
  },
  "rdfs:label": {
    "en": [
      "Chez Roger play trail"
    ],
    "fr": [
      "Piste ludique Chez Roger"
    ],
    "nl": [
      "Chez Roger speelpad"
    ]
  },
