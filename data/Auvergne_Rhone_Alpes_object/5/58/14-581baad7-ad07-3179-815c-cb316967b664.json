  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/c46b4408-0b74-3839-ba64-6c886c25abbe",
      "dc:description": {
        "de": [
          "Informationen :\n\nFeinkostmenü: Besuchen Sie die Facebook-Seite La Table du Chef\n\nTage der Öffnung:\n\nDienstag bis Freitag: 09:30 - 13:30 / 15:30 - 19:30\nSamstag: 09:30 - 13:30 / 15:30 - 18:30\n\n\nAbholung :\nZum Mitnehmen während der Öffnungszeiten des Geschäfts\n\nBestellung:\nBestellung unter 03 21 73 84 54\n\n "
        ],
        "en": [
          "Information :\n\nCatering menu: Visit the La Table du Chef Facebook page\n\nOpening days:\n\nTuesday to Friday: 09:30 - 13:30 / 15:30 - 19:30\nSaturday: 09:30 - 13:30 / 15:30 - 18:30\n\n\nPick-up :\nTakeaway during store opening hours\n\nOrdering:\nOrder on 03 21 73 84 54\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nMenù del catering: Visita la pagina Facebook de La Table du Chef\n\nGiorni di apertura:\n\nDa martedì a venerdì: 09:30 - 13:30 / 15:30 - 19:30\nSabato: 09:30 - 13:30 / 15:30 - 18:30\n\n\nRitiro :\nDa asporto durante gli orari di apertura del negozio\n\nOrdini:\nOrdinare al numero 03 21 73 84 54\n\n "
        ],
        "fr": [
          "Informations :\n\nMenu traiteur : Consultez la page Facebook La Table du Chef \n\nJours d'ouverture:\n\nDu mardi au vendredi : 09:30 - 13:30 / 15h30 - 19h30\nSamedi: 09:30 - 13:30 / 15:30 - 18:30\n\n\nRetrait :\nÀ emporter  aux horaires d'ouverture du magasin\n\nCommande : \nCommande au 03 21 73 84 54\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nCateringmenu: Bezoek de Facebookpagina van La Table du Chef\n\nOpeningsdagen:\n\nDinsdag t/m vrijdag: 09:30 - 13:30 / 15:30 - 19:30\nZaterdag: 09:30 - 13:30 / 15:30 - 18:30\n\n\nAfhalen :\nAfhalen tijdens openingstijden winkel\n\nBestellen:\nBestellen op 03 21 73 84 54\n\n "
        ],
        "es": [
          "Más información :\n\nMenú de catering: Visite la página de Facebook de La Table du Chef\n\nDías de apertura:\n\nDe martes a viernes: 09:30 - 13:30 / 15:30 - 19:30\nSábado: 09:30 - 13:30 / 15:30 - 18:30\n\n\nRecogida :\nPara llevar durante el horario de apertura de la tienda\n\nPedidos:\nPedidos al 03 21 73 84 54\n\n "
        ]
      },
