  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/07512af1-f1d2-3bef-afa0-9eb9f58bb9ba",
      "dc:description": {
        "de": [
          "Sind Sie auf der Suche nach Natur und weiten Landschaften? Romane bietet Ihnen ein Naturerlebnis mit ihrem Spaziergang \"A la Découverte des phoques\" (Entdeckung der Robben). Ein zweistündiger Ausflug, der für alle Altersgruppen geeignet ist!"
        ],
        "en": [
          "Looking for nature and wide open spaces? Romane offers you a nature experience with her walk \"Discovering seals\". A 2-hour outing for all ages!"
        ],
        "it": [
          "Siete alla ricerca di natura e di grandi spazi aperti? Romane vi offre un'esperienza naturalistica con la sua passeggiata \"Alla scoperta delle foche\". Questa escursione di 2 ore è adatta a tutte le età!"
        ],
        "fr": [
          "Vous recherchez la nature et les grands espaces ? Romane vous propose une expérience nature avec sa balade \"A la Découverte des phoques\". Sortie de 2 heures, accessible à tous les publics !"
        ],
        "es": [
          "¿Busca naturaleza y amplios espacios abiertos? Romane le ofrece una experiencia en la naturaleza con su paseo \"Descubriendo focas\". Esta excursión de 2 horas es apta para todas las edades"
        ],
        "nl": [
          "Op zoek naar natuur en weidse ruimtes? Romane biedt je een natuurbeleving met haar wandeling \"Zeehonden ontdekken\". Dit 2 uur durende uitje is geschikt voor alle leeftijden!"
        ]
      },
