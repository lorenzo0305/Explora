  "rdfs:comment": {
    "de": [
      "Die Lesestelle bietet den Einwohnern des Gebiets einen qualitativ hochwertigen und kundennahen Service und ist Teil des öffentlichen Lesenetzwerks von Val'Eyrieux."
    ],
    "en": [
      "The reading point offers a quality service and proximity to the inhabitants of the territory, and integrates the public reading network of Val'Eyrieux."
    ],
    "it": [
      "Il punto di lettura offre un servizio di qualità e locale agli abitanti della zona e fa parte della rete di lettura pubblica della Val'Eyrieux."
    ],
    "fr": [
      "Le point lecture offre un service de qualité et de proximité aux habitants du territoire, et intègre le réseau de lecture publique de Val'Eyrieux."
    ],
    "nl": [
      "Het leespunt biedt een kwalitatieve en lokale service aan de inwoners van het gebied en maakt deel uit van het openbare leesnetwerk van Val'Eyrieux."
    ],
