  "rdfs:comment": {
    "de": [
      "Experten in Triathlon, Schwimmen, Straßenradfahren und Fitness.\r\nBieten das ganze Jahr über betreute Gruppen- und Einzelsitzungen an.\r\nFür alle Niveaus von Anfänger bis Experte."
    ],
    "en": [
      "Experts in triathlon, swimming, road cycling and fitness.\r\nOffering coached group and individual sessions throughout the year.\r\nFor all levels from beginner to expert."
    ],
    "it": [
      "Esperti di triathlon, nuoto, ciclismo su strada e fitness.\r\nOffre sessioni di gruppo e individuali supervisionate durante tutto l'anno.\r\nPer tutti i livelli, dal principiante all'esperto."
    ],
    "fr": [
      "Experts en triathlon, natation, cyclisme sur route et fitness.\r\nOffrant des sessions de groupe et individuelles encadrées tout au long de l'année.\r\nPour tous les niveaux de débutant à expert."
    ],
    "nl": [
      "Experts in triatlon, zwemmen, wielrennen en fitness.\r\nHet hele jaar door groeps- en individuele sessies onder begeleiding.\r\nVoor alle niveaus, van beginner tot expert."
    ],
    "es": [
      "Expertos en triatlón, natación, ciclismo de carretera y fitness.\r\nOfrece sesiones supervisadas en grupo e individuales durante todo el año.\r\nPara todos los niveles, desde el principiante hasta el experto."
    ]
