  "rdfs:comment": {
    "de": [
      "Seit 1820 empfängt Sie dieses Hotel in einer idyllischen Umgebung am Hafen. In den charmanten Appartements herrscht eine ruhige und bukolische Atmosphäre. Die Dekoration ist raffiniert und gemütlich zugleich."
    ],
    "en": [
      "Since 1820, this hotel has been welcoming guests to its idyllic harbor-side setting. You'll find a calm, bucolic atmosphere in the charming apartments, decorated in a refined, cosy style."
    ],
    "it": [
      "Dal 1820, questo hotel vi accoglie in un ambiente idilliaco sul porto. Negli affascinanti appartamenti, arredati con uno stile raffinato e accogliente, troverete un'atmosfera tranquilla e bucolica."
    ],
    "fr": [
      "Depuis 1820, cet hôtel vous accueille dans un cadre idyllique sur le port. Ambiance calme et bucolique dans ses appartements de charme, où la décoration se veut à la fois raffnée et cosy."
    ],
    "nl": [
      "Sinds 1820 verwelkomt dit hotel je in een idyllische omgeving aan de haven. U vindt een rustige, bucolische sfeer in de charmante appartementen, ingericht in een verfijnde, gezellige stijl."
    ],
    "es": [
      "Desde 1820, este hotel le da la bienvenida en un entorno idílico a orillas del puerto. Encontrará un ambiente tranquilo y bucólico en los encantadores apartamentos, decorados con un estilo refinado y acogedor."
    ]
  },
