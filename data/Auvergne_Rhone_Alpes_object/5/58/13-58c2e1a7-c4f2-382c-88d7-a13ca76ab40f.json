  "rdfs:comment": {
    "de": [
      "Besichtigung des Ateliers, Ausstellung/Verkauf im Laden, Einführung in die Töpferei, Kurse in plastischer Kunst und Keramik für Kinder und Erwachsene. Töpferwaren und Skulpturen aus glasiertem Steingut."
    ],
    "en": [
      "Pottery and sculptures in enamelled stoneware. Visit the workshop and the exhibition/sales area. Learning how to make pottery and courses in art and ceramics for adults and children."
    ],
    "it": [
      "Visita del laboratorio, esposizione/vendita nel negozio, introduzione alla ceramica, corsi di arte e ceramica per bambini e adulti. Ceramiche e sculture in gres smaltato."
    ],
    "fr": [
      "Visite de l'atelier, expo/vente à la boutique, initiation à la poterie, cours d'art plastique et de céramique pour enfants et adultes. Poteries et sculptures en grès émaillés."
    ],
    "es": [
      "Visita del taller, exposición/venta en la tienda, introducción a la alfarería, cursos de arte y cerámica para niños y adultos. Cerámica y esculturas de gres esmaltado."
    ],
    "nl": [
      "Bezoek de studio, tentoonstelling/verkoop in de winkel, introductie tot pottenbakken, kunst- en keramieklessen voor kinderen en volwassenen. Geglazuurd steengoed aardewerk en sculpturen."
    ]
  },
