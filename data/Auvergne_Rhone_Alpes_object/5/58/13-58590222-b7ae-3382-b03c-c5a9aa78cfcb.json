  "rdfs:comment": {
    "de": [
      "CANTAL Nature lädt Sie ein, die Wunder des Cantal in unvergesslichen Naturaktivitäten zu erkunden (Themenwanderungen, Entdeckung des Biwaks, sportliche Aktivitäten und Naturanimationen)."
    ],
    "en": [
      "CANTAL Nature invites you to explore the wonders of the Cantal:\r\n- full-day or 1/2-day guided hikes\r\n- Volcamp: a bivouac experience (1 night in a tent in the heart of the volcanoes)\r\n- unforgettable outdoor sports and activities"
    ],
    "it": [
      "CANTAL Nature vi invita a esplorare le meraviglie del Cantal attraverso indimenticabili attività all'aria aperta (escursioni a tema, bivacchi alla scoperta, attività sportive ed eventi naturalistici)."
    ],
    "fr": [
      "CANTAL Nature vous invite à explorer les merveilles du Cantal dans des activités de pleine nature inoubliables (randonnées à thème, découverte du bivouac, activités sportives et animations nature)."
    ],
    "nl": [
      "CANTAL Nature nodigt je uit om de wonderen van de Cantal te ontdekken door middel van onvergetelijke buitenactiviteiten (themawandelingen, bivakken ontdekken, sportieve activiteiten en natuurevenementen)."
    ],
    "es": [
      "CANTAL Nature le invita a explorar las maravillas del Cantal a través de inolvidables actividades al aire libre (excursiones temáticas, vivacs de descubrimiento, actividades deportivas y eventos en la naturaleza)."
    ]
  },
