  "rdfs:comment": {
    "de": [
      "Die Mediathek Bachut, die für alle offen ist, bietet Ihnen auf 5 Ebenen (2500 m²) komfortable Räume mit Sesseln zum Lesen und Verweilen, Arbeitsräume mit Sitzgelegenheiten zum ruhigen Arbeiten."
    ],
    "en": [
      "The Bachut media library is open to all and offers you on 5 levels (2,500 m²) comfortable areas with armchairs for reading and spending a pleasant moment, work areas with seating for quiet work."
    ],
    "it": [
      "La biblioteca multimediale Bachut è aperta a tutti e offre spazi confortevoli su 5 livelli (2.500 m²) con poltrone per leggere e trascorrere momenti piacevoli, nonché spazi di lavoro con sedute per lavorare in tranquillità."
    ],
    "fr": [
      "La médiathèque du Bachut ouverte à tous vous offre sur 5 niveaux (2 500 m²)  des espaces confortables avec des fauteuils pour lire et passer un moment agréable, des espaces de travail avec des places assises pour travailler tranquillement."
    ],
    "es": [
      "La biblioteca multimedia de Bachut está abierta a todos y ofrece cómodos espacios en 5 niveles (2.500 m²) con sillones para leer y pasar un rato agradable, así como espacios de trabajo con asientos para trabajar tranquilamente."
    ],
    "nl": [
      "De mediatheek van Bachut staat open voor iedereen en biedt comfortabele ruimtes op 5 niveaus (2.500 m²) met fauteuils om te lezen en een aangenaam moment door te brengen, evenals werkruimtes met stoelen om rustig te werken."
    ]
  },
