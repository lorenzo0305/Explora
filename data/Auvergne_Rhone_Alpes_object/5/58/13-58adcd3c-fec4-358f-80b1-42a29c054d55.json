  "rdfs:comment": {
    "de": [
      "Die Domaine Chambeyron besitzt 5 Hektar Weinberge, die sich auf die verschiedenen Appellationen verteilen: Côte-Rôtie in der Gemeinde Ampuis, Condrieu in der Gemeinde Condrieu, Côtes du Rhône, Vin de pays Viognier und Syrah auf den Anhöhen von Ampuis."
    ],
    "en": [
      "Domaine Chambeyron owns 5 hectares of vines spread over the different appellations: Côte-Rôtie in the commune of Ampuis, Condrieu, Côtes du Rhône, Vin de pays Viognier and Syrah on the heights of Ampuis."
    ],
    "it": [
      "Il Domaine Chambeyron possiede 5 ettari di vigneti distribuiti in diverse denominazioni: Côte-Rôtie nel comune di Ampuis, Condrieu, Côtes du Rhône, Vin de pays Viognier e Syrah sulle alture di Ampuis."
    ],
    "fr": [
      "Le Domaine Chambeyron est propriétaire de 5 hectares de vigne répartis sur les différentes appellations : Côte-Rôtie sur la commune d'Ampuis, Condrieu, sur la commune de Condrieu, Côtes du Rhône, Vin de pays Viognier et Syrah sur les hauteurs d'Ampuis."
    ],
    "es": [
      "El Domaine Chambeyron posee 5 hectáreas de vides repartidas en diferentes denominaciones: Côte-Rôtie en el municipio de Ampuis, Condrieu, Côtes du Rhône, Vin de pays Viognier y Syrah en las alturas de Ampuis."
    ],
    "nl": [
      "Domaine Chambeyron bezit 5 hectare wijngaarden verspreid over verschillende appellations: Côte-Rôtie in de gemeente Ampuis, Condrieu, Côtes du Rhône, Vin de pays Viognier en Syrah op de hoogten van Ampuis."
    ]
  },
  "rdfs:label": {
