  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Vorleseaktionen, die von den Freiwilligen des Album aux c?urs angeboten werden. Ihre Stimmen antworten sich, vermischen sich und lassen schöne Geschichten zum Thema Frühling entstehen."
    ],
    "en": [
      "Come and discover the readings offered by the volunteers of l?Album aux c?urs. Their voices respond to each other, intertwining to bring to life beautiful stories on the theme of spring."
    ],
    "it": [
      "Venite a scoprire le letture proposte dai volontari de l'Album aux c'urs. Le loro voci si rispondono l'una con l'altra, intrecciandosi per dare vita a bellissime storie sul tema della primavera."
    ],
    "fr": [
      "Venez découvrir les lectures à voix hautes proposées par les bénévoles de l’Album aux cœurs. Leurs voix se répondent, s'entremêlent et font naître de belles histoires sur le thème du printemps."
    ],
    "es": [
      "Venga a descubrir las lecturas ofrecidas por los voluntarios de l'Album aux cœurs. Sus voces se responden entre sí, entrelazándose para dar vida a bellas historias sobre el tema de la primavera."
    ],
    "nl": [
      "Kom en ontdek de voordrachten van de vrijwilligers van l'Album aux c?urs. Hun stemmen reageren op elkaar, vervlechten zich en brengen prachtige verhalen over het thema lente tot leven."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Lecture : Duo d’Histoires"
    ]
  },
