  "rdfs:comment": {
    "de": [
      "Bénédicte Guichard, zertifizierte Beraterin für wissenschaftliche Aromatherapie und Spezialistin für Naturkosmetik, begleitet Sie bei der Herstellung Ihrer eigenen natürlichen Pflegeprodukte für Gesundheit, Gesicht und Körper."
    ],
    "en": [
      "Bénédicte Guichard, certified consultant in scientific aromatherapy and specialist in natural cosmetology, accompanies you in the realization of your own natural health care products, face and body."
    ],
    "it": [
      "Bénédicte Guichard, consulente certificata in aromaterapia scientifica e specialista in cosmetologia naturale, vi aiuterà a creare i vostri prodotti naturali per la salute, il viso e il corpo."
    ],
    "fr": [
      "Bénédicte Guichard, conseillère certifiée en aromathérapie scientifique et spécialiste de cosmétologie naturelle, vous accompagne dans la réalisation de vos propres produits de soins naturels santé, visage et corps."
    ],
    "nl": [
      "Bénédicte Guichard, gecertificeerd consulente in wetenschappelijke aromatherapie en specialist in natuurlijke cosmetologie, zal u helpen uw eigen natuurlijke gezondheids-, gezichts- en lichaamsverzorgingsproducten te creëren."
    ],
    "es": [
      "Bénédicte Guichard, consultora certificada en aromaterapia científica y especialista en cosmetología natural, le ayudará a crear sus propios productos naturales para la salud, el rostro y el cuerpo."
    ]
  },
