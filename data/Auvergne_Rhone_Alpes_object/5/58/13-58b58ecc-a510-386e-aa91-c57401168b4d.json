  "rdfs:comment": {
    "de": [
      "Vortrag, moderiert von Raymond Servant\r\nSekretär des Vereins \"Amis de Maubourg\" (Freunde von Maubourg)\r\nDie Faÿ beherrschten mit ihrer Anwesenheit die Ländereien, die sich von Chastelas du Mézenc bis zum Schloss Maubourg in Saint Maurice de Lignon erstreckten."
    ],
    "en": [
      "Lecture by Raymond Servant\r\nSecretary of the Friends of Maubourg Association\r\nThe Faÿs dominated the lands stretching from the Chastelas du Mézenc to the Château de Maubourg in Saint Maurice de Lignon."
    ],
    "it": [
      "Conferenza di Raymond Servant\r\nSegretario dell'Associazione degli Amici di Maubourg\r\nI Faÿs dominavano le terre che si estendevano dalle Chastelas du Mézenc al Castello di Maubourg a Saint Maurice de Lignon."
    ],
    "fr": [
      "Conférence animée par Raymond Servant\r\nSecrétaire de l'association des Amis de Maubourg\r\nLes Faÿ ont dominé par leurs présences les terres s'étendant du Chastelas du Mézenc au château de Maubourg de Saint Maurice de  Lignon."
    ],
    "nl": [
      "Lezing door Raymond Servant\r\nSecretaris van de Vereniging van de Vrienden van Maubourg\r\nDe Faÿs beheersten de landerijen die zich uitstrekten van de Chastelas du Mézenc tot het Château de Maubourg in Saint Maurice de Lignon."
    ],
    "es": [
      "Conferencia de Raymond Servant\r\nSecretario de la Asociación de los Amigos de Maubourg\r\nLos Faÿs dominaban las tierras que se extienden desde las Chastelas du Mézenc hasta el Castillo de Maubourg en Saint Maurice de Lignon."
    ]
  },
  "rdfs:label": {
    "fr": [
      "CONFERENCE UPT Histoire et Patrimoine en Haute-Loire : Du Mézenc à Maubourg"
    ]
  },
