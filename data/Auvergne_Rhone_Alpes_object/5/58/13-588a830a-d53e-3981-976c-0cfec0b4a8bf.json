  "rdfs:comment": {
    "de": [
      "Choreografische Kreise in Moulins! Ein künstlerisches und kollektives Abenteuer, um zu kreieren, zu tanzen, zu träumen und zu teilen. Offene Workshops für Schüler der Mittelstufe, Oberstufe und Erwachsene, um die Poesie der Bewegung und die Kreativität in der Gruppe zu erforschen."
    ],
    "en": [
      "Choreographic circles in Moulins! An artistic and collective adventure to create, dance, dream and share. Workshops open to secondary school students and adults to explore the poetry of movement and group creativity."
    ],
    "it": [
      "Circoli coreografici a Moulins! Un'avventura artistica e collettiva per creare, danzare, sognare e condividere. Laboratori aperti agli studenti delle scuole secondarie e agli adulti per esplorare la poesia del movimento e la creatività di gruppo."
    ],
    "fr": [
      "Cercles chorégraphiques à Moulins ! Une aventure artistique et collective pour créer, danser, rêver et partager. Ateliers ouverts aux collégiens, lycéens et adultes pour explorer la poésie du mouvement et la créativité en groupe."
    ],
    "es": [
      "¡Círculos coreográficos en Moulins! Una aventura artística y colectiva para crear, bailar, soñar y compartir. Talleres abiertos a alumnos de secundaria y adultos para explorar la poesía del movimiento y la creatividad en grupo."
    ],
    "nl": [
      "Choreografische cirkels in Moulins! Een artistiek en collectief avontuur om te creëren, te dansen, te dromen en te delen. Workshops voor middelbare scholieren en volwassenen om de poëzie van beweging en groepscreativiteit te verkennen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Animations : Cercles chorégraphiques"
    ]
  },
