  "rdfs:comment": {
    "de": [
      "Die Mediathek in L'Isle d'Abeau bietet Ihnen eine große Auswahl an Büchern, DVDs und Abonnements.\r\naußerdem stehen Ihnen 14 Computer zum Surfen im Internet und zum Ansehen von DVDs zur Verfügung."
    ],
    "en": [
      "The Isle d'Abeau media library offers a wide choice of books, DVDs and subscriptions.\r\n14 computers are also at your disposal for Internet browsing and DVD consultation."
    ],
    "it": [
      "La biblioteca multimediale de L'Isle d'Abeau offre un'ampia gamma di libri, DVD e abbonamenti.\r\nsono inoltre disponibili 14 computer per la navigazione in Internet e la visione di DVD."
    ],
    "fr": [
      "La médiathèque de L'Isle d'Abeau vous propose un large choix de livres, de DVD, et d'abonnements.\r\n14 ordinateurs sont également à votre disposition pour la navigation Internet et la consultation de DVD."
    ],
    "es": [
      "La biblioteca multimedia de L'Isle d'Abeau ofrece una amplia gama de libros, DVD y suscripciones.\r\ntambién dispone de 14 ordenadores para navegar por Internet y ver DVD."
    ],
    "nl": [
      "De mediatheek van L'Isle d'Abeau biedt een breed scala aan boeken, dvd's en abonnementen.\r\ner zijn ook 14 computers beschikbaar om op internet te surfen en dvd's te bekijken."
    ]
  },
