  "rdfs:comment": {
    "de": [
      "Die Association Communale de Chasse Agréée de La Motte-Fanjas vereint die Jäger des Dorfes und verspricht eine verantwortungsvolle Jagd sowie die Erhaltung von Fauna und Flora."
    ],
    "en": [
      "The Association Communale de Chasse Agréée de La Motte-Fanjas brings together the village's hunters and promises responsible hunting and preservation of the flora and fauna."
    ],
    "it": [
      "L'Association Communale de Chasse Agréée de La Motte-Fanjas riunisce i cacciatori del villaggio e promette una caccia responsabile e la conservazione della flora e della fauna."
    ],
    "fr": [
      "L'Association Communale de Chasse Agréée de La Motte-Fanjas regroupe les chasseurs du village et promet une chasse responsable ainsi qu'une préservation de la faune et de la flore."
    ],
    "es": [
      "La Association Communale de Chasse Agréée de La Motte-Fanjas reúne a los cazadores del pueblo y promete una caza responsable y la preservación de la flora y la fauna."
    ],
    "nl": [
      "De Association Communale de Chasse Agréée de La Motte-Fanjas verenigt de jagers van het dorp en belooft een verantwoorde jacht en het behoud van de flora en fauna."
    ]
  },
