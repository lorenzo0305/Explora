  "rdfs:comment": {
    "de": [
      "In Plaine Dranse, auf dem Gebiet des Linga? Pré-la-Joux in Châtel, \"Chez Crépy\" bietet eine Sonnenschirmbar auf einer großen Sonnenterrasse und ein Restaurant in savoyischem Ambiente."
    ],
    "en": [
      "In Plaine Dranse, on the Linga - Pré-la-Joux estate in Châtel, \"Chez Crépy\" offers a parasol bar on a large sunny terrace and a restaurant with a Savoyard atmosphere."
    ],
    "it": [
      "Nella Plaine Dranse, nel dominio Linga ? A Pré-la-Joux, a Châtel, il \"Chez Crépy\" offre un bar con ombrellone su un'ampia terrazza soleggiata e un ristorante dall'atmosfera savoiarda."
    ],
    "fr": [
      "A Plaine Dranse, sur le domaine du Linga – Pré-la-Joux à Châtel, « Chez Crépy » propose un bar parasol sur une grande terrasse ensoleillée et un restaurant dans une ambiance savoyarde."
    ],
    "nl": [
      "In Plaine Dranse, op het landgoed Linga - Pré-la-Joux in Châtel, biedt \"Chez Crépy\" een parasolbar op een groot zonnig terras en een restaurant met een Savoyaardse sfeer."
    ],
    "es": [
      "En Plaine Dranse, en el dominio de Linga ? Pré-la-Joux, en Châtel, \"Chez Crépy\" ofrece un bar con sombrilla en una gran terraza soleada y un restaurante de ambiente saboyano."
    ]
  },
  "rdfs:label": {
