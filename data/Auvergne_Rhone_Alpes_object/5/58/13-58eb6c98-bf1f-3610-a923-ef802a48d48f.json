  "rdfs:comment": {
    "de": [
      "Die Sympa'trick's Dayssss kommen: Auf dem Programm stehen Essen, Trinken und Musik am Abend.\r\nUnd dazu gibt es exklusives Stout-Bier aus der Brasserie des Abymes!\r\nAlso komm vorbei, das wird gut!"
    ],
    "en": [
      "The Sympa'trick's Dayssss are here: there'll be food, drink and music all evening.\r\nPlus exclusive Brasserie des Abymes stout beer!\r\nSo come along, it's going to be great!"
    ],
    "it": [
      "Si avvicina il Sympa'trick's Dayssss: in programma cibo, bevande e musica la sera.\r\nE l'esclusiva birra stout della Brasserie des Abymes!\r\nVenite anche voi, sarà fantastico!"
    ],
    "fr": [
      "Les Sympa'trick's Dayssss débarquent: au programme, il y aura à boire, à manger et de la musique en soirée.\r\nEt en prime de la bière stout Brasserie des Abymes en exclusivité ! \r\nDonc viens ça va être bien !"
    ],
    "es": [
      "Se acercan los Sympa'trick's Dayssss: en el programa, habrá comida, bebida y música por la noche.\r\nAdemás de cerveza negra exclusiva de la Brasserie des Abymes\r\nVen, ¡va a ser genial!"
    ],
    "nl": [
      "De Sympa'trick's Dayssss komen eraan: op het programma staat 's avonds eten, drinken en muziek.\r\nPlus exclusief bier van Brasserie des Abymes!\r\nDus kom langs, het wordt geweldig!"
    ]
  },
  "rdfs:label": {
