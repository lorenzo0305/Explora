  "rdfs:comment": {
    "de": [
      "Skulpturen, Bilder, Raku-Objekte.\r\nEines Tages setzt sich die Materie durch. Intensiv, rau oder subtil, sie ist lebendig und der Raum öffnet sich mit ihr."
    ],
    "en": [
      "Sculpture, paintings, raku objects.\r\nOne day, the material imposes itself. Intense, rough or subtle, it's alive and space opens up with it."
    ],
    "it": [
      "Sculture, dipinti, oggetti raku.\r\nUn giorno la materia si impone. Intensa, ruvida o sottile, è viva e lo spazio si apre con essa."
    ],
    "fr": [
      "Sculpture, tableaux, objets raku.\r\nUn jour la matière s'impose. Intense, rude ou subtile, elle est vivante et l'espace s'ouvre avec elle."
    ],
    "nl": [
      "Sculpturen, schilderijen, raku-objecten.\r\nOp een dag dringt het materiaal zich op. Intens, ruw of subtiel, het leeft en de ruimte opent zich ermee."
    ],
    "es": [
      "Escultura, pintura, objetos de rakú.\r\nUn día el material se impone. Intenso, áspero o sutil, está vivo y el espacio se abre con él."
    ]
  },
