  "rdfs:comment": {
    "de": [
      "L'ivresse des sommets ist ein Bier aus Belledonne, das aus einer handwerklichen Brauerei stammt, die mit Leidenschaft den Geschmack, kurze Wege und lokale Rohstoffe pflegt."
    ],
    "en": [
      "L'Ivresse des Sommets, Belledonne beer.\r\nA craft brewery that cultivates taste, short supply chains and locally-grown raw materials."
    ],
    "it": [
      "L'ivresse des sommets è una birra di Belledonne prodotta da un birrificio artigianale che coltiva con passione il gusto, la filiera corta e le materie prime locali."
    ],
    "fr": [
      "L'ivresse des sommets est une bière de Belledonne née d'une brasserie artisanale qui cultive avec passion le goût, les circuits courts et les matières premières locales."
    ],
    "es": [
      "L'ivresse des sommets es una cerveza de Belledonne de una cervecería artesanal que cultiva con pasión el sabor, las cadenas de suministro cortas y las materias primas locales."
    ],
    "nl": [
      "De roes van de toppen, het bier van Belledonne.\r\nEen ambachtelijke brouwerij die smaak, korte lijnen en lokaal verbouwde grondstoffen cultiveert."
    ]
  },
