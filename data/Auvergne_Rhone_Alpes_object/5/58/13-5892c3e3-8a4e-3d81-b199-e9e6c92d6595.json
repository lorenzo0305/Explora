  "rdfs:comment": {
    "de": [
      "Eine leuchtende Idee sind handgefertigte Lampen, die in Beaulon entworfen und hergestellt werden. Anne-Gaëlle, Designerin und Mutter von vier fröhlichen Jungen, hat ihre Werkstatt zu Hause eingerichtet."
    ],
    "en": [
      "Une idée lumineuse is a range of handmade lamps designed and manufactured in Beaulon. Anne-Gaëlle, designer and mother of four happy boys, has set up her workshop at home."
    ],
    "it": [
      "Une idée lumineuse è una gamma di lampade artigianali progettate e realizzate a Beaulon. Anne-Gaëlle, designer e madre di quattro ragazzi felici, ha creato il suo laboratorio a casa."
    ],
    "fr": [
      "Une idée lumineuse, ce sont des lampes artisanales conçues et fabriquées à Beaulon. Anne-Gaëlle, créatrice et maman de quatre joyeux garçons, a installé son atelier à la maison."
    ],
    "nl": [
      "Une idée lumineuse is een reeks handgemaakte lampen ontworpen en gemaakt in Beaulon. Anne-Gaëlle, ontwerpster en moeder van vier vrolijke jongens, heeft haar atelier aan huis opgezet."
    ],
    "es": [
      "Une idée lumineuse es una gama de lámparas artesanales diseñadas y fabricadas en Beaulon. Anne-Gaëlle, diseñadora y madre de cuatro niños felices, ha montado su taller en casa."
    ]
  },
  "rdfs:label": {
