  "rdfs:comment": {
    "de": [
      "Acro’ Aventures Quintal liegt in Le Semnoz und 15 Minuten von Annecy entfernt im Bauges-Massiv. Ein Hochseilgarten „Accrobranche®“ der neuen Art für die ganze Familie."
    ],
    "en": [
      "At Le Semnoz, just 15 minutes from Annecy in the Bauges mountains, the whole family will enjoy Acro'Aventures Quintal, a new kind of  \"Accrobranche®\" adventure park."
    ],
    "it": [
      "Situato sul Semnoz e a 15 minuti da Annecy nel massiccio dei Bauges, Acro' Aventures Quintal è un nuovo genere di parco \"Accrobranche®\" per tutta la famiglia."
    ],
    "fr": [
      "Situé sur la route du Semnoz à 15 minutes d’Annecy dans le massif des Bauges, Acro’Aventures Quintal est une aire de jeu géante suspendue dans les arbres par des filets. Une sortie pour toute la famille."
    ],
    "es": [
      "Situado en la carretera de Semnoz, a 15 minutos de Annecy, en las montañas de Bauges, Acroaventuras Quintal es un parque infantil gigante suspendido en los árboles por redes. Una excursión para toda la familia."
    ],
    "nl": [
      "Acro'Aventures Quintal is een klimbos met activiteiten voor heel het gezin. Het park ligt op een kwartier van Annecy in het Baugesmassief."
    ]
  },
