  "rdfs:comment": {
    "de": [
      "Das Rathaus von Pérignat-lès-Sarliève befindet sich in einem Schloss, dessen Ursprünge auf das Mittelalter zurückgehen. In der Nähe befindet sich eine alte Kapelle, die aus dem 11. Jahrhundert stammen soll."
    ],
    "en": [
      "The Pérignat-lès-Sarliève town hall is located in a château whose origins date back to medieval times. Nearby is a former 11th century chapel."
    ],
    "it": [
      "Il municipio di Pérignat-lès-Sarliève è ospitato in un castello le cui origini risalgono al Medioevo. Nelle vicinanze si trova un'antica cappella risalente all'XI secolo."
    ],
    "fr": [
      "La Mairie de Pérignat-lès-Sarliève prend place au sein d’un château dont les origines remontent à l’époque médiévale. À proximité, se situe une ancienne chapelle qui daterait du 11e siècle."
    ],
    "nl": [
      "Het stadhuis van Pérignat-lès-Sarliève is gevestigd in een kasteel waarvan de oorsprong teruggaat tot de middeleeuwen. Vlakbij staat een oude kapel uit de 11e eeuw."
    ],
    "es": [
      "El Ayuntamiento de Pérignat-lès-Sarliève se encuentra en un castillo cuyos orígenes se remontan a la época medieval. Cerca se encuentra una antigua capilla que data del siglo XI."
    ]
  },
