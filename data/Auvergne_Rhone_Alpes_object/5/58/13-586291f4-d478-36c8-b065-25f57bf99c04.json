  "rdfs:comment": {
    "de": [
      "Par Pleyad: Erzählung, Slam und Lied, um die Geschichte einer Lebensveränderung auf dem Weg zur Freiheit zu erzählen.\r\nAb 10 Jahren.\r\nFreier Eintritt, Getränke an der Bar."
    ],
    "en": [
      "By Pleyad: Storytelling, slam and song tell the story of a life-changing journey to freedom.\r\nAges 10 and up.\r\nFree admission, drinks at the bar."
    ],
    "it": [
      "A cura di Pleyad: narrazione, slam e canzoni per raccontare la storia di un cambiamento di vita, sulla strada della libertà.\r\nDai 10 anni in su.\r\nIngresso libero, consumazioni al bar."
    ],
    "fr": [
      "Par Pleyad :  Récit, slam et chanson pour raconter l'histoire d'un changement de vie, sur le chemin de la liberté.\r\nA partir de 10 ans.\r\nEntrée libre, consommations au bar."
    ],
    "es": [
      "Por Pleyad: Cuentacuentos, slam y canciones para contar la historia de un cambio de vida, en el camino hacia la libertad.\r\nA partir de 10 años.\r\nEntrada gratuita, bebidas en el bar."
    ],
    "nl": [
      "Door Pleyad: Verhalen vertellen, slammen en zingen om het verhaal te vertellen van een verandering in het leven, op weg naar vrijheid.\r\nVanaf 10 jaar.\r\nGratis toegang, drankjes aan de bar."
    ]
  },
