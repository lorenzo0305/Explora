  "rdfs:comment": {
    "de": [
      "Traditionelles Haus, eines der ältesten des Dorfes, in dem Menschen und Tiere untergebracht waren. Anhand der Aussagen der Bewohner erfahren Sie mehr über das Leben der Berggemeinde von ihren Ursprüngen als Agro-Pastor bis hin zu ihren touristischen Aktivitäten."
    ],
    "en": [
      "A traditional house, one of the oldest in the village, which used to house men and animals. Through the testimonies of the inhabitants, discover the life of the mountain community from its agro-pastoral origins to its tourist activity."
    ],
    "it": [
      "Casa tradizionale, una delle più antiche del paese, che ospitava uomini e animali. Attraverso le testimonianze degli abitanti, scopri la vita della comunità montana dalle origini agro-pastorali alla sua attività turistica."
    ],
    "fr": [
      "Maison traditionnelle, une des plus anciennes du village, qui accueillait hommes et bêtes. A travers les témoignages des habitants, découvrez la vie de la communauté montagnarde de ses origines agro-pastorales à son activité touristique."
    ],
    "es": [
      "Una casa tradicional, una de las más antiguas del pueblo, en la que se alojaban hombres y animales. A través de los testimonios de los habitantes, descubra la vida de la comunidad de montaña desde sus orígenes agropastorales hasta su actividad turística."
    ],
    "nl": [
      "Traditioneel huis, een van de oudste in het dorp, dat mensen en dieren verwelkomde. Ontdek aan de hand van de getuigenissen van de inwoners het leven van de berggemeenschap van zijn agro-pastorale oorsprong tot zijn toeristische activiteit."
    ]
  },
  "rdfs:label": {
    "de": [
      "L'Arche d'Oé - Agro-Pastoral-Museum"
    ],
    "en": [
      "L'Arche d'Oé, heritage centre"
    ],
    "it": [
      "L'Arche d'Oé - Museo agropastorale"
    ],
    "fr": [
      "L'Arche d'Oé - Musée agro-pastoral"
    ],
    "nl": [
      "L'Arche d'Oé - Museum agro-pastoralisme"
    ]
  },
