  "rdfs:comment": {
    "de": [
      "Das Hauptziel des Vereins Spielzeug für alle ist es, Spiele und Spielzeug zu sammeln, um sie zu erschwinglichen Preisen weiterzuverkaufen, um neues Spielzeug aufzukaufen und es an Pflege-, sozialmedizinische und Bildungseinrichtungen zu verschenken."
    ],
    "en": [
      "The main aim of the association jouets pour tous is to collect toys and games for resale at affordable prices in order to buy new toys and donate them to care, medical, social and educational institutions."
    ],
    "it": [
      "L'obiettivo principale dell'associazione jouets pour tous è raccogliere giochi e giocattoli per rivenderli a prezzi accessibili e acquistare nuovi giocattoli da offrire a istituzioni assistenziali, mediche, sociali ed educative"
    ],
    "fr": [
      "L'association jouets pour tous a pour objectif principal de collecter des jeux et jouets afin de les revendre à tarifs abordables pour racheter des jouets neufs et les offrir à des établissements de soins, médicaux sociaux, éducatifs"
    ],
    "nl": [
      "Het belangrijkste doel van de vereniging jouets pour tous is het inzamelen van speelgoed en spelletjes voor de wederverkoop tegen betaalbare prijzen om nieuw speelgoed te kopen en te doneren aan zorg-, medische, sociale en onderwijsinstellingen."
    ],
    "es": [
      "El objetivo principal de la asociación jouets pour tous es recoger juegos y juguetes para revenderlos a precios asequibles y comprar juguetes nuevos y ofrecerlos a instituciones asistenciales, médicas, sociales y educativas"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Association Jouets pour tous"
    ]
  },
