  "rdfs:comment": {
    "de": [
      "Ein Ort, an dem die Kunst die Berge sublimiert. Hier finden Sie künstlerische Fotografien der Alpen, Skulpturen, eine Bergbuchhandlung und viele Gastkünstler."
    ],
    "en": [
      "A place where art sublimates the mountains. You'll discover artistic photography of the Alps, sculpture, a mountain bookshop and numerous guest artists."
    ],
    "it": [
      "Un luogo dove l'arte sublima le montagne. Scoprirete fotografie artistiche delle Alpi, sculture, una libreria di montagna e una serie di artisti ospiti."
    ],
    "fr": [
      "Un endroit où l’art sublime la Montagne. Vous y découvrirez des photographies artistiques des Alpes, de la sculpture, une librairie de Montagne et de nombreux artistes invités."
    ],
    "es": [
      "Un lugar donde el arte sublima las montañas. Descubrirás fotografías artísticas de los Alpes, esculturas, una librería de montaña y un sinfín de artistas invitados."
    ],
    "nl": [
      "Een plek waar kunst de bergen sublimeert. Je ontdekt er artistieke foto's van de Alpen, beeldhouwkunst, een bergboekwinkel en een groot aantal gastkunstenaars."
    ]
  },
