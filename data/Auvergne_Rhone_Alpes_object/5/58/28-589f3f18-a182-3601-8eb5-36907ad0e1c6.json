      "dc:description": {
        "de": [
          "Die Snackbar/Pizzeria \"Le 254\" bietet Ihnen eine große Auswahl an Pizzen sowie einen Kebab-Teil, Panini, Burger, Tacos...\nPizzateig und Brot \"hausgemacht\"."
        ],
        "en": [
          "The snack/pizzeria \"Le 254\" offers a wide range of pizzas, as well as a kebab, panini, burgers, tacos...\nPizza dough and bread \"home made\"."
        ],
        "it": [
          "Lo snack/pizzeria \"Le 254\" offre una vasta gamma di pizze, oltre a kebab, panini, hamburger, tacos...\nImpasto per pizza e pane fatti in casa."
        ],
        "fr": [
          "Le snack/pizzeria \"Le 254\" vous propose une large gamme de pizza, ainsi q'une partie kebab, panini, burgers, tacos...\nPâte à pizza et pain \"fait maison\"."
        ],
        "es": [
          "El snack/pizzería \"Le 254\" ofrece una amplia gama de pizzas, así como un kebab, panini, hamburguesas, tacos...\nMasa de pizza y pan caseros."
        ],
        "nl": [
          "De snack/pizzeria \"Le 254\" biedt een breed scala aan pizza's, evenals een kebab, panini, hamburgers, taco's...\nZelfgemaakt pizzadeeg en brood."
        ]
      },
