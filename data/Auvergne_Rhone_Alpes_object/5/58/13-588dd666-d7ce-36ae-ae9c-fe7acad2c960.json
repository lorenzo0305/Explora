  "rdfs:comment": {
    "de": [
      "Von der Compagnie Circonvolution.\r\n\r\n\"D'une mouche, un éléphant\" ist ein zirzensisches und musikalisches Spektakel für ein junges Publikum ab 2 Jahren... und bis zu 122 Jahren."
    ],
    "en": [
      "By Compagnie Circonvolution.\r\n\r\n\"D'une mouche, un éléphant\" is a circus and musical show for young audiences, from age 2... up to 122."
    ],
    "it": [
      "A cura della Compagnie Circonvolution.\r\n\r\n\"D'une mouche, un éléphant\" è uno spettacolo circense e musicale per un pubblico giovane dai 2 ai 122 anni."
    ],
    "fr": [
      "Par la Compagnie Circonvolution. \r\n\r\n\"D'une mouche, un éléphant\" est un spectacle circassien et musical à destination du jeune public, à partir de 2 ans... et jusqu'à 122 ans."
    ],
    "es": [
