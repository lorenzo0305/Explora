  "rdfs:comment": {
    "de": [
      "Die ESF in Châtel besteht seit 1948 und zählt heute 100 Lehrer, echte Bergprofis, die alle über ein staatliches Diplom verfügen."
    ],
    "en": [
      "ESF Châtel exists since 1948 and today has 80 in structors, real mountain professionals who all have a national instructor qualification."
    ],
    "it": [
      "L'ESF di Châtel esiste dal 1948 e oggi conta 100 istruttori, veri professionisti della montagna, tutti con diploma statale."
    ],
    "fr": [
      "L'ESF de Châtel existe depuis 1948 et compte aujourd'hui 100 moniteurs, vrais professionnels de la montagne, tous titulaires d'un diplôme d’État."
    ],
    "es": [
      "La ESF de Châtel existe desde 1948 y hoy cuenta con 100 instructores, verdaderos profesionales de la montaña, todos ellos con un diploma estatal."
    ],
    "nl": [
      "De ESF Châtel bestaat sinds 1948 en telt vandaag maar liefst 100 leraren, echte professionals van de bergen en allen gediplomeerd."
    ]
