  "rdfs:comment": {
    "de": [
      "Ideal gelegen im Herzen von Vichy, an der Kreuzung zwischen dem Hyperzentrum, dem Bahnhof und dem Lac d'Allier, empfängt Sie der Grand Marché de Vichy an 6 Tagen in der Woche"
    ],
    "en": [
      "Ideally located in the heart of Vichy, at the crossroads of the city centre, the train station and the lake, the Grand Marché de Vichy welcomes you 6 days a week"
    ],
    "it": [
      "Situato in posizione ideale nel cuore di Vichy, all'incrocio tra l'ipercentro, la stazione ferroviaria e il lago di Allier, il Grand Marché de Vichy vi accoglie 6 giorni su 7"
    ],
    "fr": [
      "Idéalement situé au cœur de Vichy, à la croisée de l'hyper centre, de la gare et du lac d’allier, le Grand Marché de Vichy vous accueille 6 jours sur 7"
    ],
    "es": [
      "Idealmente situado en el corazón de Vichy, en el cruce del hipercentro, la estación de tren y el lago de Allier, el Grand Marché de Vichy le da la bienvenida 6 días a la semana"
    ],
    "nl": [
      "Ideaal gelegen in het hart van Vichy, op het kruispunt van het hypercentrum, het station en het meer van Allier, heet de Grand Marché de Vichy u 6 dagen per week welkom"
    ]
  },
  "rdfs:label": {
