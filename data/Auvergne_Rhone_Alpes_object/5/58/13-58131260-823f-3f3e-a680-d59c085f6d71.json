  "rdfs:comment": {
    "de": [
      "Dieses vielseitige Kunstzentrum konzentriert mehrere Leistungen, die die künstlerische Praxis betreffen. Der Espace Vallès ist der ideale Ort, um zu lernen, zu entdecken und sich zu bereichern."
    ],
    "en": [
      "This multipurpose art centre gathers several services around artistic practice. Open from Tuesday to Saturday afternoon, it is the proper place to learn, discover, enrich oneself."
    ],
    "it": [
      "Questo centro d'arte polivalente si concentra su diversi servizi riguardanti la pratica artistica. L'Espace Vallès è il luogo ideale per imparare, scoprire e arricchirsi."
    ],
    "fr": [
      "Ce centre d'art polyvalent recentre plusieurs prestations concernant la pratique artistique. L'Espace Vallès constitue l'endroit idéal pour apprendre, découvrir, s'enrichir."
    ],
    "es": [
      "Este centro de arte polivalente se centra en una serie de servicios relacionados con la práctica artística. El Espace Vallès es el lugar ideal para aprender, descubrir y crecer."
    ],
    "nl": [
      "Dit multifunctionele kunstcentrum richt zich op verschillende diensten betreffende kunstbeoefening. De Espace Vallès is de ideale plek om te leren, te ontdekken en te verrijken."
    ]
  },
