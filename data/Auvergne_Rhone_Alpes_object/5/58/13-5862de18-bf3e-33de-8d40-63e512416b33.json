  "rdfs:comment": {
    "de": [
      "Magali Ripoll ist ein alter Hase im Fernsehgeschäft: Als Musikerin und Sängerin in der Sendung N?oubliez pas les paroles, die täglich auf France2 ausgestrahlt wird, reist Magali durch ganz Frankreich, um auf der Bühne aufzutreten!"
    ],
    "en": [
      "Magali Ripoll is a regular on the small screen: a musician and singer on N?oubliez pas les paroles, a daily show on France2, Magali travels the roads of France to perform on stage!"
    ],
    "it": [
      "Magali Ripoll è un habitué del piccolo schermo: musicista e cantante del programma N?oubliez pas les paroles, in onda tutti i giorni su France2, Magali percorre le strade della Francia per esibirsi dal vivo sul palco!"
    ],
    "fr": [
      "Magali Ripoll est une habituée du petit écran : musicienne et chanteuse dans l’émission N’oubliez pas les paroles, diffusée tous les jours sur France2, Magali parcourt les routes de France pour se produire sur scène !"
    ],
    "nl": [
      "Magali Ripoll is een vaste waarde op het kleine scherm: als muzikant en zangeres in het programma N?oubliez pas les paroles, dat elke dag wordt uitgezonden op France2, reist Magali de wegen van Frankrijk af om live op te treden!"
    ],
    "es": [
      "Magali Ripoll es una habitual de la pequeña pantalla: músico y cantante en el programa N'oubliez pas les paroles, emitido todos los días en France2, Magali recorre las carreteras de Francia para actuar en directo sobre el escenario"
    ]
  },
  "rdfs:label": {
    "fr": [
      "fête de la musique: concert Magali Ripoll"
    ]
  },
