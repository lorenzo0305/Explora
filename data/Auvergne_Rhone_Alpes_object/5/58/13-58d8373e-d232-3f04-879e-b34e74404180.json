  "rdfs:comment": {
    "de": [
      "Aus Le Cabanon wird Le Cairn. Wir freuen uns, Sie in einer gastronomischen, herzlichen und entspannten Atmosphäre begrüßen zu dürfen. Lassen Sie sich durch unsere Menüs führen, in denen frische, saisonale und lokale Produkte die Hauptzutaten sind."
    ],
    "en": [
      "Le Cabanon becomes Le Cairn. We are pleased to welcome you in a gastronomic, warm and relaxed atmosphere. Let us guide you through our menus where fresh, seasonal and local products are the main ingredients."
    ],
    "it": [
      "Le Cabanon diventa Le Cairn. Siamo lieti di accogliervi in un'atmosfera gastronomica, calda e rilassata. Lasciatevi guidare dai nostri menu in cui i prodotti freschi, stagionali e locali sono gli ingredienti principali."
    ],
    "fr": [
      "Le Cabanon devient Le Cairn. Nous avons le plaisir de vous accueillir dans une ambiance gastronomique, chaleureuse et décontractée. Laissez-vous guider à travers nos menus où les produits frais, de saison et locaux sont les principaux ingrédients."
    ],
    "nl": [
      "Le Cabanon wordt Le Cairn. Wij ontvangen u graag in een gastronomische, warme en ontspannen sfeer. Laat u leiden door onze menu's waarin verse, seizoensgebonden en lokale producten de belangrijkste ingrediënten zijn."
    ],
    "es": [
      "Le Cabanon se convierte en Le Cairn. Nos complace darle la bienvenida en un ambiente gastronómico, cálido y relajado. Déjese guiar por nuestros menús en los que los productos frescos, de temporada y locales son los principales ingredientes."
    ]
  },
  "rdfs:label": {
