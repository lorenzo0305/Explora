  "rdfs:comment": {
    "de": [
      "La Locomotive - Ungewöhnlicher Bahnhof in Saillans, das ist ein Kulturcafé, Gemeinschaftsbüros, die von allen gemietet werden können, eine Resto-Kantine\r\n und ein Bahnhof!"
    ],
    "en": [
      "La Locomotive - Gare insolite de Saillans, is a cultural café, shared offices that can be rented by anyone, a restaurant-canteen\r\n and a train station!"
    ],
    "it": [
      "La Locomotive - Gare insolite de Saillans, è un caffè culturale, uffici condivisi che possono essere affittati da chiunque, un ristorante-mensa e una stazione!\r\n e una stazione!"
    ],
    "fr": [
      "La Locomotive - Gare insolite de Saillans, c'est un café culturel, des bureaux partagés qui peuvent être loués par tous, un resto cantine \r\n et une gare !"
    ],
    "nl": [
      "La Locomotive - Gare insolite de Saillans, is een cultureel café, gedeelde kantoren die door iedereen gehuurd kunnen worden, een restaurant-kantine\r\n en een station!"
    ],
    "es": [
      "La Locomotive - Gare insolite de Saillans, es un café cultural, oficinas compartidas que pueden ser alquiladas por cualquiera, un restaurante-cantina\r\n y ¡una estación!"
    ]
  },
