  "rdfs:comment": {
    "de": [
      "Speisesaal und Panoramaterrasse mit außergewöhnlichem Blick auf den Berg Couspeau. Moderne traditionelle Küche. Wasserbereich und Spielplätze für Restaurantgäste auf Reservierung zugänglich."
    ],
    "en": [
      "Restaurant room with an exceptional view on the Couspeau mountain. Traditional and modern cooking. Aquatic space and playground accessible for restaurant customers on reservation."
    ],
    "it": [
      "Sala ristorante e terrazza panoramica con vista eccezionale sul monte Couspeau. Cucina tradizionale e moderna. Area acquatica e parchi giochi a disposizione degli ospiti del ristorante su prenotazione."
    ],
    "fr": [
      "Salle de restaurant et terrasse panoramique avec vue exceptionnelle sur la montagne de Couspeau. Cuisine traditionnelle moderne. Espace aquatique et aires de jeux accessibles aux clients du restaurant sur réservation."
    ],
    "es": [
      "Sala de restaurante y terraza panorámica con vistas excepcionales al monte Couspeau. Cocina tradicional y moderna. Zona acuática y parques infantiles disponibles para los clientes del restaurante previa reserva."
    ],
    "nl": [
      "Restaurant en panoramisch terras met uitzonderlijk uitzicht op de Couspeau-berg. Traditionele moderne keuken. Water- en speelruimte beschikbaar voor gasten van het restaurant op reservering."
    ]
  },
  "rdfs:label": {
    "fr": [
