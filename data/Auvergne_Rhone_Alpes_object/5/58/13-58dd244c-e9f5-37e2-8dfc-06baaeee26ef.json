  "rdfs:comment": {
    "de": [
      "Die Musiker des Jazz Club Moulinois werden reinen Malt-Swing, fassgereifte Standards, tief verwurzelten Blues und Improvisationen, die wie Champagner prickeln, destillieren."
    ],
    "en": [
      "The musicians of the Jazz Club Moulinois will be distilling pure malt swing, barrel-aged standards, deep-rooted blues and champagne-sparkling improvisation."
    ],
    "it": [
      "I musicisti del Jazz Club Moulinois distilleranno swing di puro malto, standard invecchiati in botte, blues dalle radici profonde e improvvisazione spumeggiante."
    ],
    "fr": [
      "Les musiciens du Jazz Club Moulinois vont distiller du swing pur malt, des standards vieillis en fût, du blues enraciné et des improvisation pétillantes comme du champagne."
    ],
    "es": [
      "Los músicos del Jazz Club Moulinois destilarán swing de pura malta, standards añejados en barrica, blues de raíces profundas e improvisación que chispea champán."
    ],
    "nl": [
      "De muzikanten van Jazz Club Moulinois distilleren pure malt swing, barrel-aged standards, diepgewortelde blues en champagne-sprankelende improvisatie."
    ]
  },
