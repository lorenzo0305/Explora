  "rdfs:comment": {
    "de": [
      "Jérémy, Angelführer und Bergführer in der Region Savoyen, bietet Ihnen verschiedene Dienstleistungen an: Angelkurse, Anfängerkurse, Fortgeschrittenenkurse in Flüssen oder Seen."
    ],
    "en": [
      "Jérémy, fishing instructor and mountain guide in the Savoie region, offers a range of services: fishing courses, introductory and advanced fishing in rivers and lakes."
    ],
    "it": [
      "Jérémy, istruttore di pesca e guida alpina nella regione della Savoia, offre una gamma di servizi: corsi di pesca, corsi introduttivi e avanzati su fiumi e laghi."
    ],
    "fr": [
      "Jérémy, moniteur guide de pêche et accompagnateur en montagne en Pays de Savoie vous propose différentes prestations: stage de pêche, initiation, perfectionnement en rivière ou lacs."
    ],
    "es": [
      "Jérémy, guía instructor de pesca y líder de montaña en la región de Saboya, ofrece una gama de servicios: cursos de pesca, cursos de iniciación y perfeccionamiento en ríos y lagos."
    ],
    "nl": [
      "Jérémy, een instructeur visgids en bergleider in de Savoie, biedt een scala aan diensten: viscursussen, inleidende en gevorderde cursussen op rivieren en meren."
    ]
  },
  "rdfs:label": {
    "en": [
      "Alp' fishing escape"
    ],
