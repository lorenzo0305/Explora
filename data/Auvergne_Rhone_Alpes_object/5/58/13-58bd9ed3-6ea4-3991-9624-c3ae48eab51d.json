  "rdfs:comment": {
    "de": [
      "Makleragentur, Vermietung und Verkauf von Immobilien, Verwaltung, Ferienvermietung in der Drôme sud, Haut Vaucluse. Ihre Adresse in Sachen Immobilien seit 1991! 10 Mitarbeiter stehen für den Erfolg Ihres Projektes bereit. \r\nZweite Agentur in Sainte Cécile les Vignes."
    ],
    "en": [
      "Real estate transactions, management, seasonal rentals in Drôme sud, Haut Vaucluse. Your house’s best contact since 1991  8 collaborators interact with you and clients for the success of your project. Second agency in St Restitut"
    ],
    "it": [
      "Transazioni immobiliari, gestione, affitti per vacanze a Drome Sud. Le vostre case hanno un indirizzo dal 1991.\r\n2 agenzie vicine a voi e 8 collaboratori che lavorano insieme per garantire il successo del vostro progetto."
    ],
    "fr": [
      "Transaction immobilière, gestion, location saisonnière en Sud Drome. Vos maisons ont une adresse depuis 1991.\r\n2 agences au plus près de vous et 8 collaborateurs en interaction pour la réussite de votre projet."
    ],
    "nl": [
      "Vastgoedtransacties, beheer, vakantieverhuur in Drôme Sud en Haut Vaucluse. Uw huizen hebben sinds 1991 een adres! Tien medewerkers die samenwerken voor het succes van uw project. Tweede agentschap in Sainte Cécile les Vignes."
    ],
    "es": [
      "Transacciones inmobiliarias, gestión, alquileres de vacaciones en South Drome. Sus casas tienen una dirección desde 1991.\r\n2 agencias cerca de usted y 8 empleados que trabajan juntos para asegurar el éxito de su proyecto."
    ]
  },
