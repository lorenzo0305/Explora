  "rdfs:comment": {
    "de": [
      "Der Laden bietet Ihnen die besten Produkte direkt vom Bauernhof: Obst, Gemüse, Wurstwaren, Lamm, Geflügel, Eier, Käse, Brot, Wein, Honig, Kunsthandwerk,... Die meisten Produkte stammen aus biologischem Anbau."
    ],
    "en": [
      "The shop offers the best products straight from the farm: fruit, vegetables, charcuterie, lamb, poultry, eggs, cheeses, bread, wine, honey,… most of the products come from organic farming."
    ],
    "it": [
      "Il negozio offre i migliori prodotti direttamente dalle fattorie: frutta, verdura, salumi, agnello, pollame, uova, formaggio, pane, vino, miele, prodotti artigianali, ecc."
    ],
    "fr": [
      "Le magasin vous propose les meilleurs produits en direct des fermes : fruits, légumes, charcuterie, agneau, volailles, oeufs, fromages, pain, vin, miel, artisanat,... la plupart des produits sont issus de l'agriculture biologique."
    ],
    "es": [
      "La tienda le ofrece los mejores productos directamente de las granjas: frutas, verduras, charcutería, cordero, aves, huevos, queso, pan, vino, miel, artesanía, etc. La mayoría de los productos son de producción ecológica."
    ],
    "nl": [
      "De winkel verkoopt de beste producten direct bij de boerderij: fruit, groente, charcuterie, lam, gevogelte, eieren, kaas, brood, wijn, honing, ambachtelijke producten, etc. de meeste producten zijn op biologische manier verbouwd."
    ]
  },
