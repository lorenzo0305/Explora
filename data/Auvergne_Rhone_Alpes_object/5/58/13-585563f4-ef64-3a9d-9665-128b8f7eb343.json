  "rdfs:comment": {
    "de": [
      "Helfen Sie Marie-Pelline dabei, die Fragmente ihrer Partitur in Chabeuil wiederzufinden! Erkunden Sie mit Ihrer Familie dieses Dorf in der Drôme, um die Melodie wiederherzustellen und der Musikerin zu ermöglichen, vor François Couperin zu spielen."
    ],
    "en": [
      "Help Marie-Pelline find the fragments of her score in Chabeuil! Explore this village in the Drôme region with your family to reconstruct the melody and enable the musician to play in front of François Couperin."
    ],
    "it": [
      "Aiutate Marie-Pelline a trovare i frammenti della sua partitura a Chabeuil! Accompagnate la vostra famiglia in un tour di questo villaggio della Drôme per ricostruire la melodia e permettere alla musicista di suonare davanti a François Couperin."
    ],
    "fr": [
      "Aidez Marie-Pelline à retrouver les fragments de sa partition dans Chabeuil ! Parcourez en famille ce village drômois pour reconstituer la mélodie et permettre à la musicienne de jouer devant François Couperin."
    ],
    "es": [
      "¡Ayude a Marie-Pelline a encontrar los fragmentos de su partitura en Chabeuil! Acompañe a su familia a recorrer este pueblo de la Drôme para reconstruir la melodía y permitir al músico tocar delante de François Couperin."
    ],
    "nl": [
      "Help Marie-Pelline om de fragmenten van haar partituur terug te vinden in Chabeuil! Verken met het hele gezin dit dorpje in de Drôme om de melodie te reconstrueren en de muzikante in staat te stellen voor François Couperin te spelen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Jeu de piste numérique \"Marie-Pelline et le mystère de la mélodie\" avec Baludik"
    ]
  },
