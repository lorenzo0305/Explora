  "rdfs:comment": {
    "de": [
      "Die Association Sportive Automobile de la Drôme hat zum Ziel, den Motorsport zu regeln, zu organisieren, zu leiten und zu entwickeln."
    ],
    "en": [
      "The purpose of the Association Sportive Automobile de la Drôme is to regulate, organize, direct and develop motor sport, and to play an important role in the training of members and road safety."
    ],
    "it": [
      "L'Association Sportive Automobile de la Drôme ha lo scopo di regolamentare, organizzare, dirigere e sviluppare la pratica dello sport automobilistico, oltre a svolgere un ruolo importante nella formazione dei titolari di patente e nella sicurezza stradale."
    ],
    "fr": [
      "L’Association Sportive Automobile de la Drôme a pour objet de réglementer, d’organiser, de diriger et de développer la pratique du sport automobile, elle joue également un rôle important au niveau de la formation des licenciés et de la sécurité routière."
    ],
    "es": [
      "La Asociación Sportive Automobile de la Drôme tiene por objeto regular, organizar, dirigir y desarrollar la práctica del deporte del motor. También desempeña un papel importante en la formación de los titulares de licencias y en la seguridad vial."
    ],
    "nl": [
      "Het doel van de Association Sportive Automobile de la Drôme is het reguleren, organiseren, beheren en ontwikkelen van de motorsport. De vereniging speelt ook een belangrijke rol in de opleiding van leden en de verkeersveiligheid."
    ]
  },
  "rdfs:label": {
