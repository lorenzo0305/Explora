  "rdfs:comment": {
    "de": [
      "Route über den Col des Saisies bis zum Col du Joly, einem noch unberührten und wilden Pass... Anspruchsvolle Anstiege, die mit herrlichen Ausblicken auf den Mont Blanc belohnt werden. Eine sportliche und panoramareiche Tour, die man in vollen Zügen genießen kann."
    ],
    "en": [
      "Route passing through the Col des Saisies to the Col du Joly, a pass that remains unspoilt and wild... Challenging climbs rewarded by splendid panoramic views of Mont Blanc. A sporty and scenic outing to be savoured to the full."
    ],
    "it": [
      "Il percorso comprende il Col des Saisies e il Col du Joly, un passo ancora incontaminato e selvaggio... Salite impegnative ricompensate da splendide viste sul Monte Bianco. Un'uscita sportiva e panoramica da gustare appieno."
    ],
    "fr": [
      "Parcours en passant par le Col des Saisies jusqu’au Col du Joly, col encore préservé et sauvage... Des ascensions exigeantes récompensées par des panoramas splendides sur le Mont Blanc. Une sortie sportive et panoramique à savourer pleinement."
    ],
    "es": [
      "La ruta pasa por el Col des Saisies y el Col du Joly, un puerto todavía virgen y salvaje... Desafiantes ascensiones recompensadas con espléndidas vistas del Mont Blanc. Una salida deportiva y panorámica para saborear al máximo."
    ],
    "nl": [
      "De route gaat over de Col des Saisies en de Col du Joly, een pas die nog ongerept en wild is... Uitdagende beklimmingen die worden beloond met prachtige uitzichten op de Mont Blanc. Een sportieve en panoramische tocht om volop van te genieten."
    ]
  },
  "rdfs:label": {
    "de": [
      "Expertkurs : Der Mont Blanc vom Col du Joly aus gesehen"
    ],
    "en": [
      "Expert Ride : Mont Blanc from the Col du Joly pass"
    ],
    "fr": [
      "Parcours expert : Le Mont-Blanc depuis le col du Joly"
    ]
  },
