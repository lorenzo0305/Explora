  "rdfs:comment": {
    "de": [
      "Im Herzen der Domaine de la Dombes gibt es 5 verschiedene Angebote für Groß und Klein: Sensorik, Baby, Oustiti, Kind und Junior-Erwachsener.\r\nRiesige Seilrutsche, die den Teich überquert.\r\n100 % Sicherheit mit durchgehenden Sicherheitsleinen."
    ],
    "en": [
      "In the heart of the Domaine de la Dombes, 5 different formulas for young and old: Sensorielle, Baby, Oustiti, Child and Junior-Adult.\r\nGiant zip line crossing the pond.\r\n100% safety with continuous lifelines."
    ],
    "it": [
      "Nel cuore del Domaine de la Dombes, 5 diversi pacchetti per grandi e piccini: Sensory, Baby, Oustiti, Children e Junior-Adult.\r\nLinea zip gigante attraverso il laghetto.\r\n100% sicurezza con linee di vita continue."
    ],
    "fr": [
      "Au cœur du Domaine de la Dombes, 5 formules différentes pour petits et grands : Sensorielle, Baby, Oustiti, Enfant et Junior-Adulte.\r\nTyrolienne géante traversant l'étang. \r\n100% sécurité avec lignes de vie continue."
    ],
    "nl": [
      "In het hart van het Domaine de la Dombes, 5 verschillende formules voor groot en klein: Sensory, Baby, Oustiti, Children en Junior-Adult.\r\nGigantische tokkelbaan over de vijver.\r\n100% veilig met doorlopende vanglijnen."
    ],
    "es": [
      "En el corazón del Domaine de la Dombes, 5 paquetes diferentes para grandes y pequeños: Sensory, Baby, Oustiti, Children y Junior-Adult.\r\nTirolina gigante sobre el estanque.\r\n100% de seguridad con líneas de vida continuas."
    ]
  },
