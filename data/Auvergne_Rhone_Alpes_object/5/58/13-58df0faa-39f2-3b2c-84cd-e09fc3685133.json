  "rdfs:comment": {
    "de": [
      "Die Ruhe, alle Ihre Mahlzeiten vor Ort einnehmen zu können, die im Speisesaal und an schönen Tagen auf der Terrasse serviert werden. Traditionelles Restaurant mit 3 Vorspeisen, 3 Hauptgerichten und 3 hausgemachten Desserts."
    ],
    "en": [
      "Self-service breakfast from 6:30am to 9:00am. Weekends from 7:00am to 10:00am. From 12:00pm to 2:00pm for lunch and from 7pm to 10:00pm for dinner. Buffet set menus and à la carte dishes. Special children’s menu. Open daily."
    ],
    "it": [
      "La tranquillità di poter consumare tutti i pasti in loco, serviti nella sala da pranzo e sulla terrazza nella bella stagione. Ristorante tradizionale con 3 antipasti, 3 piatti principali e 3 dessert fatti in casa."
    ],
    "fr": [
      "La tranquillité de pouvoir prendre tous vos repas sur place, servis en salle de restaurant et en terrasse dès les beaux jours. Restaurant traditionnel avec 3 entrées, 3 plats, 3 desserts fait maison."
    ],
    "es": [
      "La tranquilidad de poder disfrutar de todas sus comidas en el propio establecimiento, servidas en el comedor y en la terraza cuando hace buen tiempo. Restaurante tradicional con 3 entrantes, 3 platos principales y 3 postres caseros."
    ],
    "nl": [
      "De rust om al je maaltijden ter plaatse te nuttigen, geserveerd in de eetzaal en bij mooi weer op het terras. Traditioneel restaurant met 3 voorgerechten, 3 hoofdgerechten en 3 huisgemaakte desserts."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant le Campanile Hôtel-Grill"
    ]
  },
