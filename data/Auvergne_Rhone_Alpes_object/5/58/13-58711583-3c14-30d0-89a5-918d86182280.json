  "rdfs:comment": {
    "de": [
      "Ätherische Öle aus Lavendel, Aspiklavendel, Lavandin, Wacholder, Waldkiefer und Blütenwasser werden auf diesem kleinen Bio-Betrieb hergestellt.\r\nMärkte in Crest und Die von Mai bis Oktober. Animationen: Lavendeldestillation mit mobilem Destillierapparat."
    ],
    "en": [
      "Essential oil of lavender, aspic lavender, juniper, Scots pine and flower water are made on this small organic farm. Markets in Crest and Die from May to October. Sales events: lavender distillation with mobile still."
    ],
    "it": [
      "In questa piccola azienda agricola biologica si producono oli essenziali di lavanda, lavanda spiga, lavandina, ginepro, pino silvestre e acqua floreale.\r\nMercati di Crest e Die da maggio a ottobre. Animazioni: distillazione della lavanda con alambicco mobile."
    ],
    "fr": [
      "Huiles essentielles de lavande, lavande aspic, lavandin, genévrier, pin sylvestre et eau florale sont produites sur cette petite exploitation biologique.\r\nMarchés de Crest et Die de mai à octobre. Animations : distillation de lavande avec alambic mobile."
    ],
    "nl": [
      "Etherische oliën van lavendel, lavandula spica, lavandin, jenever, den en bloemwater, geproduceerd bij deze kleine biologische onderneming.\nMarkt in Crest en Die van mei tot oktober. Activiteiten: lavendeldestillatie met mobiel distilleerapparaat."
    ],
    "es": [
      "En esta pequeña granja ecológica se producen aceites esenciales de lavanda, espliego, lavandín, enebro, pino silvestre y agua floral.\r\nMercados en Crest y Die de mayo a octubre. Actividades: destilación de lavanda con un alambique móvil."
    ]
  },
