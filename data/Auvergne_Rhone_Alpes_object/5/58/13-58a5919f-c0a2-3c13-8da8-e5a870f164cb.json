    "de": [
      "Bei einem Aperitif können Sie auf Astrids Plattenspieler Ihre Favoriten aus den Bereichen Jazz, Soul, Latin und anderen entdecken."
    ],
    "en": [
      "Over an aperitif, come and discover Astrid's jazz, soul, Latin and other favorites on the turntable."
    ],
    "it": [
      "Durante l'aperitivo, venite a scoprire il jazz, il soul, il latino e altri brani preferiti di Astrid sul giradischi."
    ],
    "fr": [
      "Le temps d'un apéro, venez découvrir les coups de cœur Jazz, Soul, Latin et autres, sur la platine d'Astrid."
    ],
    "es": [
      "Mientras toma un aperitivo, venga a descubrir el jazz, el soul, el latín y otros géneros favoritos de Astrid en el tocadiscos."
    ],
