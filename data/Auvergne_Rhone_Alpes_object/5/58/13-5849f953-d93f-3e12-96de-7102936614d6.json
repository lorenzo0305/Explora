  "rdfs:comment": {
    "de": [
      "Betrieb mit 7,5 ha verteilt auf die Gemeinde Marchampt in Hanglage, der von Hand bearbeitet wird. Ein Teil des Betriebs wird von Agamy vinifiziert, der andere von Laurent. Sein Beaujolais Villages 2023 wurde 2025 als bester Gamay der Welt ausgezeichnet."
    ],
    "en": [
      "This estate of 7,5 ha is situated in Marchampt. Three quarters of the estate are converted into wine in la cave Agamy de Quincié, the rest by Laurent."
    ],
    "it": [
      "Un vigneto di 7,5 ettari sulle colline di Marchampt, lavorato a mano. Parte del vigneto è vinificato da Agamy e il resto da Laurent. Il suo Beaujolais Villages 2023 è stato premiato come miglior Gamay del mondo nel 2025."
    ],
    "fr": [
      "Exploitation de 7,5 ha répartis sur la commune de Marchampt en coteaux travaillées manuellement. Une partie de l'exploitation est vinifiée à  Agamy, et  l'autre par Laurent. Son Beaujolais Villages 2023 a été primé Meilleur Gamay du Monde en 2025."
    ],
    "es": [
      "Un viñedo de 7,5 hectáreas en las laderas de Marchampt, trabajado a mano. Una parte del viñedo es vinificada por Agamy y el resto por Laurent. Su Beaujolais Villages 2023 fue galardonado como mejor Gamay del mundo en 2025."
    ],
    "nl": [
      "Een wijngaard van 7,5 hectare op de heuvels van Marchampt, met de hand bewerkt. Een deel van de wijngaard wordt gevinifieerd door Agamy en de rest door Laurent. Zijn Beaujolais Villages 2023 werd in 2025 uitgeroepen tot Beste Gamay ter wereld."
    ]
  },
