  "rdfs:comment": {
    "de": [
      "Die Botschaft ist ein Vereinscafé, das mit dem Ziel gegründet wurde, einen ruhigen und friedlichen Ort zu bieten, an dem sich jeder akzeptiert und respektiert fühlt."
    ],
    "en": [
      "L'Ambassade is a community café, created to offer a calm and peaceful space where everyone feels accepted and respected."
    ],
    "it": [
      "L'Ambassade è un caffè comunitario creato per offrire uno spazio amichevole e tranquillo dove tutti possano sentirsi accettati e rispettati."
    ],
    "fr": [
      "L'Ambassade est un café associatif, créé dans le but d'offrir un espace convivial et paisible où chacun se sentira accepté et respecté."
    ],
    "nl": [
      "L'Ambassade is een buurtcafé dat is opgezet om een rustige en vredige ruimte te bieden waar iedereen zich geaccepteerd en gerespecteerd voelt."
    ],
    "es": [
      "L'Ambassade es un café comunitario creado para ofrecer un espacio acogedor y tranquilo donde todos puedan sentirse aceptados y respetados."
    ]
  },
