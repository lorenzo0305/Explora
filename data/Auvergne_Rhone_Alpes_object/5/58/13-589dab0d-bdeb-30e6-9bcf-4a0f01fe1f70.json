  "rdfs:comment": {
    "de": [
      "Garten mit Blumen und Bäumen, am Ufer des Flusses Arve und des Kasinos. In einer sehr angenehmen Umgebung gelegen, kann man bei gutem Wetter den Mont-Blanc erblicken."
    ],
    "en": [
      "Flower-filled garden with trees, bordering the Arve River and the Casino. Situated in very pleasant surroundings, on a clear day you can see Mont Blanc."
    ],
    "it": [
      "Giardino fiorito e alberato, confinante con il fiume Arve e il Casinò. Situato in un ambiente molto piacevole, nelle giornate limpide si può vedere il Monte Bianco."
    ],
    "fr": [
      "Jardin fleuri et arboré, en bordure de la rivière Arve et du Casino. Situé dans un environnement très agréable, par beau temps, on peut apercevoir le Mont-Blanc."
    ],
    "es": [
      "Jardín florido con árboles, que bordea el río Arve y el Casino. Situado en un entorno muy agradable, con buen tiempo se puede ver el Mont Blanc."
    ],
    "nl": [
      "Bloemrijke tuin met bomen, grenzend aan de rivier de Arve en het Casino. Gelegen in een zeer aangename omgeving, bij helder weer kun je de Mont Blanc zien liggen."
    ]
  },
  "rdfs:label": {
