  "rdfs:comment": {
    "de": [
      "Begeben Sie sich an Bord der Rhône und entdecken Sie ihre Geheimnisse: Fauna, Flora, faszinierende Landschaften und Ökosysteme warten auf Sie. 1 Stunde Bootsfahrt."
    ],
    "en": [
      "Embark on a journey along the Rhône to discover its secrets: fauna, flora, landscapes and fascinating ecosystems await you. 1h navigation."
    ],
    "it": [
      "Partite per un viaggio lungo il Rodano alla scoperta dei suoi segreti: fauna, flora, paesaggi ed ecosistemi affascinanti vi aspettano. 1 ora di navigazione."
    ],
    "fr": [
      "Embarquez au fil du Rhône à la découverte de ses secrets : faune, flore, paysage et écosystèmes fascinant vous attendent. 1h de navigation."
    ],
    "nl": [
      "Ga op reis langs de Rhône om zijn geheimen te ontdekken: fauna, flora, landschappen en fascinerende ecosystemen wachten op je. 1 uur vaartijd."
    ],
    "es": [
      "Embárquese en un viaje por el Ródano para descubrir sus secretos: fauna, flora, paisajes y ecosistemas fascinantes le esperan. 1 hora de navegación."
    ]
  },
  "rdfs:label": {
