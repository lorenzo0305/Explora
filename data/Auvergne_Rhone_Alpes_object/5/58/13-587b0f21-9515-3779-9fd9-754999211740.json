  "rdfs:comment": {
    "de": [
      "In einem warmen und freundlichen Rahmen können Sie die halbgastronische und gastronomische Küche genießen, die Chefkoch Maxime PEYRE Tag für Tag mit Leidenschaft für Sie zubereitet."
    ],
    "en": [
      "It is in a warm and friendly atmosphere that you will be able to enjoy the semi-gastronomic delights prepared daily with passion by Chef Maxime PEYRE."
    ],
    "it": [
      "È in un ambiente caldo e accogliente che potrete apprezzare la cucina semi-gastronomica e gastronomica che Maxime PEYRE, lo chef, prepara per voi giorno dopo giorno, con passione."
    ],
    "fr": [
      "C'est dans un cadre chaleureux et convivial que vous pourrez apprécier la cuisine semi-gastronique et gastronomique que Maxime PEYRE, le Chef, vous prépare jour après jour, avec passion."
    ],
    "nl": [
      "U kunt genieten in een warme gezellige omgeving van de semi-gastronomische gerechten die de chef-kok Maxime PEYRE elke dag vol passie voor u bereidt."
    ],
    "es": [
      "En un entorno cálido y acogedor, podrá apreciar la cocina semigastronómica y gastronómica que Maxime PEYRE, el Chef, le prepara día tras día, con pasión."
    ]
  },
