  "rdfs:comment": {
    "de": [
      "Als Bergbegleiter, der seit 14 Jahren im Bergführerbüro von Super Besse arbeitet, biete ich Ihnen an, die verschiedenen Vulkane der Chaîne des Puys und ihre gesamte Artenvielfalt zu entdecken, um Sie für ihre Zerbrechlichkeit zu sensibilisieren."
    ],
    "en": [
      "I've been a mountain guide for 14 years at the Super Besse mountain guide office, and I invite you to discover the different volcanoes of the Chaîne des Puys and all their biodiversity, to make you aware of their fragility."
    ],
    "it": [
      "Sono una guida alpina da 14 anni presso l'ufficio delle guide alpine di Super Besse e vi accompagnerò alla scoperta dei diversi vulcani della Chaîne des Puys e di tutta la loro biodiversità, per farvi capire quanto siano fragili."
    ],
    "fr": [
      "Accompagnateur montagne depuis 14 ans au bureau des guides de Super Besse, je vous propose de découvrir les différents volcans de la Chaîne des Puys et toute sa biodiversité afin de vous sensibiliser à sa fragilité."
    ],
    "es": [
      "Soy guía de montaña desde hace 14 años en la oficina de guías de montaña de Super Besse, y te llevaré a recorrer los diferentes volcanes de la Chaîne des Puys y toda su biodiversidad, para concienciarte de lo frágiles que son."
    ],
    "nl": [
      "Ik ben al 14 jaar berggids bij het berggidsenbureau Super Besse en ik neem je mee op een tocht langs de verschillende vulkanen van de Chaîne des Puys en al hun biodiversiteit, om je bewust te maken van hoe kwetsbaar ze zijn."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Cédric Martin – Guides Pavin Sancy –  Accompagnateur en moyenne montagne"
    ]
  },
