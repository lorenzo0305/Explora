  "rdfs:comment": {
    "de": [
      "Im Herzen des Aravis-Massivs bietet die Millet Manigod Trail Challenge am 12. und 13. September 2025 mehrere Laufformate an zwei Tagen. Die Gelegenheit, eines der schönsten Täler des Massivs zu entdecken: Manigod."
    ],
    "en": [
      "In the heart of the Aravis massif, the Millet Manigod Trail Challenge offers several running formats over 2 days, on September 12 and 13, 2025. The opportunity to discover one of the most beautiful valleys in the massif: Manigod."
    ],
    "it": [
      "Nel cuore del massiccio degli Aravis, il Millet Manigod Trail Challenge propone diversi formati di corsa per 2 giorni, il 12 e 13 settembre 2025. È l'occasione per scoprire una delle più belle valli del massiccio: Manigod."
    ],
    "fr": [
      "Au cœur du massif des Aravis, le Millet Manigod Trail Challenge vous propose plusieurs formats de course à pied durant 2 jours, les 12 et 13 septembre 2025. L’occasion de découvrir l’une des plus belles vallées du massif : Manigod."
    ],
    "nl": [
      "In het hart van het Aravis massief, biedt de Millet Manigod Trail Challenge verschillende loopvormen gedurende 2 dagen op 12 en 13 september 2025. Dit is je kans om een van de mooiste valleien van het massief te ontdekken: Manigod."
    ],
    "es": [
      "En el corazón del macizo de Aravis, el Millet Manigod Trail Challenge ofrece varios formatos de carrera durante 2 días, el 12 y 13 de septiembre de 2025. Esta es tu oportunidad para descubrir uno de los valles más bellos del macizo: Manigod."
    ]
  },
