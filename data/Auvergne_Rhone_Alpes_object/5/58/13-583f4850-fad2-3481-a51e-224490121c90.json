  "rdfs:comment": {
    "de": [
      "Das Ecopôle du Forez – die führende Naturstätte an der Loire.\r\nMitten in der Natur, zwischen Fluss, Mäandern und dem Forez, ist das Ecopôle ein geschütztes Refugium für wilde Tiere.\r\nDer ideale Ort für Ihr naturbezogenes Seminar."
    ],
    "en": [
      "Ecopôle du Forez, the reference nature site in the Loire.\r\nIn the heart of nature, between river, meanders, and forest, the Ecopôle is a haven for protected wildlife.\r\nThe ideal place for your nature-themed seminar."
    ],
    "it": [
      "L'Ecopôle du Forez, il sito naturale di riferimento della Loira. Nel cuore della natura, tra il fiume, i meandri e il Forez, l'Ecopôle è una riserva naturale protetta.\r\nIl luogo ideale per il vostro seminario sulla natura."
    ],
    "fr": [
      "L'Ecopôle du Forez, le site nature référent dans la Loire. Au cœur de la nature, entre fleuve, méandres et forez, l'Ecopôle est un écrin de vie sauvage protégée.\r\nLe lieu idéal pour votre séminaire nature."
    ],
    "es": [
      "El Ecopôle du Forez, el paraje natural de referencia del Loira. En plena naturaleza, entre el río, los meandros y el Forez, el Ecopôle es una reserva natural protegida.\r\nEl lugar ideal para su seminario sobre la naturaleza."
    ],
    "nl": [
      "De Ecopôle du Forez, de referentie op natuurgebied in de Loire. In het hart van de natuur, tussen de rivier, de meanders en de Forez, is de Ecopôle een beschermd natuurreservaat.\r\nDe ideale plek voor uw natuur seminar."
    ]
  },
  "rdfs:label": {
    "de": [
      "Ecopôle du Forez – Seminarraum"
    ],
    "en": [
      "Ecopôle du Forez – Seminar Room"
    ],
