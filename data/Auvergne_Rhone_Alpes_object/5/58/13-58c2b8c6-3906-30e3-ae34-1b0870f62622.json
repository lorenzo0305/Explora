  "rdfs:comment": {
    "de": [
      "Paroux ist eine Abfahrt, die kleine Singles auf den Almen und technisch anspruchsvollere Waldpassagen miteinander verbindet. Diese Route ist von mäßigem Schwierigkeitsgrad. Sie ist perfekt, um Ihre Technik zu verbessern oder für die Amateure, um ein Maximum an Geschwindigkeit zu erreichen!"
    ],
    "en": [
      "Paroux is a descent that mixes short singles in the mountain pastures with more technical forest passages. This is a moderate-level route. It's perfect for improving your technique, or for those who like to go fast!"
    ],
    "it": [
      "Paroux è una discesa che combina brevi single in alpeggio con tratti più tecnici nel bosco. Si tratta di un percorso di livello moderato. È perfetto per migliorare la tecnica o per chi ama andare veloce!"
    ],
    "fr": [
      "Paroux est une descente qui mêle petits singles dans les alpages et passages en forêt plus techniques. Cet itinéraire est de niveau modéré. Il est parfait pour améliorer sa technique ou pour les amateurs prendre un max de vitesse !"
    ],
    "nl": [
      "Paroux is een afdaling die korte singletjes in de alpenweiden combineert met meer technische stukken in het bos. Dit is een route van gemiddeld niveau. Perfect om je techniek te verbeteren of voor wie graag hard gaat!"
    ],
    "es": [
      "Paroux es un descenso que combina cortos tramos sencillos en los pastos de montaña con tramos más técnicos en el bosque. Se trata de una ruta de nivel moderado. Es perfecta para mejorar la técnica, ¡o para los que les gusta ir rápido!"
    ]
  },
