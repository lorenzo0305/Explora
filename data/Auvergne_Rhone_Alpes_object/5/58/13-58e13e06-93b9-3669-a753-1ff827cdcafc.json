  "rdfs:comment": {
    "de": [
      "Diese charmante Bar/Restaurant mit südländischen Aromen lädt Sie zu einer Reise in die Provence ein. Es ist ein Lokal, das hauptsächlich Tagesvorschläge mit Fischgerichten im Vordergrund anbietet."
    ],
    "en": [
      "This charming bar/restaurant with southern flavors invites you on a journey to Provence. The menu features daily suggestions, with fish dishes taking center stage."
    ],
    "it": [
      "Questo affascinante bar-ristorante dai sapori del sud vi invita a fare un viaggio in Provenza. Il ristorante offre principalmente specialità del giorno, con piatti di pesce in primo piano."
    ],
    "fr": [
      "Ce charmant bar/restaurant aux saveurs du Sud, vous invite à un voyage en Provence. C'est un établissement qui propose essentiellement des suggestions du jour avec les plats de poissons à l'honneur."
    ],
    "es": [
      "Este encantador bar-restaurante con sabores del sur le invita a hacer un viaje a la Provenza. El restaurante ofrece principalmente platos del día, con especial atención a los platos de pescado."
    ],
    "nl": [
      "Dit charmante zuidersgetinte bar/restaurant, nodigt u uit voor een reis in de Provence.  Zij stelt voornamelijk dagsuggesties met vis voor."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Café du Centre"
    ]
  },
