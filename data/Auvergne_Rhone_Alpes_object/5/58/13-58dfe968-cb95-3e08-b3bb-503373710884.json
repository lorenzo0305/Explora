  "rdfs:comment": {
    "de": [
      "Grazac wird im Jahr 939 in das Erbe der großen Abtei von Cluny aufgenommen. Es wurde ein Priorat errichtet, eine Kirche gebaut und die Klostergebäude errichtet."
    ],
    "en": [
      "Grazac became part of the heritage of the great abbey of Cluny in the year 939. A priory is established there, a church is built, as well as the monastic buildings."
    ],
    "it": [
      "Grazac entrò a far parte del patrimonio della grande abbazia di Cluny nell'anno 939. Vi fu fondato un priorato, fu costruita una chiesa e gli edifici monastici."
    ],
    "fr": [
      "Grazac intègre le patrimoine de la grande abbaye de Cluny en l'an 939. Un prieuré y est implanté, une église est construite, ainsi que les bâtiments monastiques."
    ],
    "nl": [
      "Grazac werd deel van het erfgoed van de grote abdij van Cluny in het jaar 939. Er werd een priorij gevestigd, een kerk gebouwd en de kloostergebouwen."
    ],
    "es": [
      "Grazac pasó a formar parte del patrimonio de la gran abadía de Cluny en el año 939. Allí se estableció un priorato y se construyó una iglesia, así como los edificios monásticos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Église et Château Prieuré clunisien"
    ]
  },
