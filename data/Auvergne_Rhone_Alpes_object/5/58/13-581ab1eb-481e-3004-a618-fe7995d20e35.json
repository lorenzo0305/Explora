  "rdfs:comment": {
    "de": [
      "Animation \"Baby im Museum: Colorama\". Formen und Farben kommen zusammen, explodieren, spielen und nehmen die Kleinsten mit auf ihr verrücktes Abenteuer! Von 18 Monaten bis 4 Jahren. Dauer ca. 1 Stunde"
    ],
    "en": [
      "Baby at the Museum: Colorama\" animation. Shapes and colors come together, explode, play and take toddlers on a wild adventure! From 18 months to 4 years. Duration approx. 1 hr"
    ],
    "it": [
      "Bambini al museo: Colorama\". Forme e colori si uniscono, esplodono, giocano e portano i bambini in un'avventura selvaggia! Da 18 mesi a 4 anni. Durata circa 1 ora"
    ],
    "fr": [
      "Animation « bébé au musée : Colorama ». Formes et couleurs se réunissent, éclatent, jouent et embarquent les tout-petits dans leur folle aventure ! De 18 mois à 4 ans. Durée environ 1h"
    ],
    "es": [
      "Bebés en el Museo: Colorama\". Formas y colores se unen, explotan, juegan y llevan a los más pequeños a una aventura salvaje De 18 meses a 4 años. Duración aprox. 1 hora"
    ],
    "nl": [
      "Baby's in het museum: Colorama\". Vormen en kleuren komen samen, exploderen, spelen en nemen peuters mee op een wild avontuur! Van 18 maanden tot 4 jaar. Duur ca. 1 uur"
    ]
  },
  "rdfs:label": {
    "fr": [
