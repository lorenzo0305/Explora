  "rdfs:comment": {
    "de": [
      "Delphine verbindet Leichtigkeit und Tiefgang, Stand up und Charaktere und macht sich einen Spaß daraus, Ihnen ihre Sicht auf die Liebe, Kinder und die Arbeit zu vermitteln..."
    ],
    "en": [
      "Combining lightness and depth, stand-up and characters, Delphine has fun delivering her vision of love, children, work..."
    ],
    "it": [
      "Combinando leggerezza e profondità, stand-up e personaggi, Delphine si diverte a condividere la sua visione dell'amore, dei figli, del lavoro..."
    ],
    "fr": [
      "Alliant légèreté et profondeur, Stand up et personnages, Delphine s'amuse à vous livrer sa vision de l'amour, des enfants, du travail..."
    ],
    "nl": [
      "Delphine combineert lichtheid en diepgang, stand-up en personages, en deelt met plezier haar visie op liefde, kinderen, werk..."
    ],
    "es": [
      "Combinando ligereza y profundidad, stand-up y personajes, Delphine se divierte compartiendo su visión del amor, los hijos, el trabajo..."
    ]
  },
