  "rdfs:comment": {
    "de": [
      "Von der handgefertigten Spitze aus dem 16. Jahrhundert bis zur zeitgenössischen Spitzenindustrie: Entdecken Sie die Fertigkeiten dieses Erbes, das von unserer Geschichte zeugt."
    ],
    "en": [
      "Handmade lace museum: a visit at the heart of our heritage where the history of lace is told. Discover the techniques of bobbin lacemaking and needle lace-making. An exhibition and classes are organized during the season."
    ],
    "it": [
      "Dal merletto a mano del XVI secolo all'industria contemporanea del merletto, scoprite il know-how di questo patrimonio, testimone della nostra storia."
    ],
    "fr": [
      "De la dentelle à la main du XVIe siècle à l'industrie dentellière contemporaine, découvrez les savoir-faire de ce patrimoine témoin de notre histoire."
    ],
    "nl": [
      "Van handkant uit de 16e eeuw tot de hedendaagse kantindustrie, ontdek de knowhow van dit erfgoed, een getuige van onze geschiedenis."
    ],
    "es": [
      "Desde el encaje manual del siglo XVI hasta la industria contemporánea del encaje, descubra el saber hacer de este patrimonio, testigo de nuestra historia."
    ]
  },
