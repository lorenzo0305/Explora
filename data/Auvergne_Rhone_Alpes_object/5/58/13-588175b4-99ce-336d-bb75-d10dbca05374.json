  "rdfs:comment": {
    "de": [
      "Im Pokawa Bourgoin-Jallieu hat man eine einfache Mission: das Beste der hawaiianischen Küche in einem gemütlichen, schnellen und wirklich leckeren Rahmen anzubieten."
    ],
    "en": [
      "At Pokawa Bourgoin-Jallieu, we have a simple mission: to offer the best of Hawaiian cuisine in a warm, fast and truly gourmet setting."
    ],
    "it": [
      "Al Pokawa Bourgoin-Jallieu abbiamo una semplice missione: offrire il meglio della cucina hawaiana in un ambiente caldo, veloce e veramente gourmet."
    ],
    "fr": [
      "Chez Pokawa Bourgoin-Jallieu, on a une mission simple : offrir le meilleur de la cuisine hawaïenne dans un cadre chaleureux, rapide et vraiment gourmand."
    ],
    "es": [
      "En Pokawa Bourgoin-Jallieu, tenemos una misión sencilla: ofrecer lo mejor de la cocina hawaiana en un ambiente cálido, rápido y verdaderamente gourmet."
    ],
    "nl": [
      "Bij Pokawa Bourgoin-Jallieu hebben we een eenvoudige missie: het beste van de Hawaïaanse keuken aanbieden in een warme, snelle en gastronomische omgeving."
    ]
  },
