  "rdfs:comment": {
    "de": [
      "Genießen Sie unsere lokale Küche mit einem Menü, das jeden Monat den \r\nsaisonalen Produkten (Trüffel, Gänseleber, Zucchiniblüten, Spargel... ) angepasst wird. Service im Garten während der Saison."
    ],
    "en": [
      "Savour our regional cuisine based on seasonal local food featured on a menu renewed monthly (truffle, foie gras, courgette flowers, asparagus...). Food platters \r\nin the garden during high season."
    ],
    "it": [
      "Assaggiate la nostra cucina locale, al ritmo del canto delle cicale, attraverso un menù rinnovato ogni mese in base ai prodotti di stagione (tartufi, foie gras, fiori di zucca, asparagi...)"
    ],
    "fr": [
      "Dégustez notre cuisine de terroir, au rythme des chants des cigales, à travers un menu renouvelé tous les mois en fonction des produits de saison (truffes, foie gras, fleurs de courgettes, asperges ...)"
    ],
    "nl": [
      "Proef onze streekgerechten, via maandelijks veranderde \r\nmenu’s afhankelijk van de seizoensproducten (Truffels, foie gras, courgettebloemen, asperges...). Maaltijdplanken in de tuin in het seizoen."
    ],
    "es": [
      "Deguste nuestra cocina local, al ritmo del canto de las cigarras, a través de un menú renovado cada mes según los productos de la temporada (trufas, foie gras, flores de calabacín, espárragos...)"
    ]
  },
