  "rdfs:comment": {
    "de": [
      "Landwirtschaftlicher Betrieb am Fuße der Windräder von St Jean Lachalm.\r\nUnsere 40 Milchkühe der Rasse Montbéliardes werden auf den Wiesen in der Umgebung weiden."
    ],
    "en": [
      "Farm located at the foot of the wind turbines at St Jean Lachalm.\r\nOur forty or so Montbeliarde dairy cows graze in the surrounding meadows."
    ],
    "it": [
      "Azienda agricola situata ai piedi delle turbine eoliche di St Jean Lachalm.\r\nLe nostre circa quaranta mucche da latte Montbéliardes pascolano nei prati circostanti."
    ],
    "fr": [
      "Exploitation agricole située au pied des éoliennes de St Jean Lachalm. \r\nNotre quarantaine de vaches laitières de race Montbéliardes vont pâturer dans les prairies aux alentours."
    ],
    "es": [
      "Granja situada al pie de las turbinas eólicas de St Jean Lachalm.\r\nNuestras cerca de cuarenta vacas lecheras Montbéliardes pastan en los prados de los alrededores."
    ],
    "nl": [
      "Boerderij aan de voet van de windmolens van St Jean Lachalm.\r\nOnze ongeveer veertig Montbéliardes melkkoeien grazen in de omliggende weiden."
    ]
  },
  "rdfs:label": {
    "fr": [
      "GAEC Ricoules | St Jean Lachalm"
    ]
  },
