  "rdfs:comment": {
    "de": [
      "Vernissage der Ausstellung von Maryse Grousson, \"Pour suivre la lumière, choisir la paix\" (Um dem Licht zu folgen, den Frieden zu wählen). Die Welt von Maryse, ein poetisches Werk, in dem Farbe und Licht zur Gelassenheit einladen."
    ],
    "en": [
      "Opening of Maryse Grousson's exhibition, \"Pour suivre la lumière, choisir la paix\". Maryse's universe, a poetic work where color and light invite serenity."
    ],
    "it": [
      "Inaugurazione della mostra di Maryse Grousson, \"Pour suivre la lumière, choisir la paix\". L'universo di Maryse, un'opera poetica dove il colore e la luce invitano alla serenità."
    ],
    "fr": [
      "Vernissage de l'exposition de Maryse Grousson, \"Pour suivre la lumière, choisir la paix\". L'univers de Maryse, une œuvre poétique où la couleur et la lumière invite à la sérénité."
    ],
    "nl": [
      "Opening van de tentoonstelling \"Pour suivre la lumière, choisir la paix\" van Maryse Grousson. Maryse's universum, een poëtisch werk waar kleur en licht uitnodigen tot sereniteit."
    ],
    "es": [
      "Inauguración de la exposición de Maryse Grousson, \"Pour suivre la lumière, choisir la paix\". El universo de Maryse, una obra poética donde el color y la luz invitan a la serenidad."
    ]
  },
