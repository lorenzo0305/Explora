  "rdfs:comment": {
    "de": [
      "Türöffnung, Austausch aller Arten von Schlössern, Rollläden, Metallvorhänge, Türpanzerungen, alle Arten von Verglasungen.\r\n7 Tage pro Woche, 24 Stunden pro Tag."
    ],
    "en": [
      "Door opening, locks changes, rolling shutters, metal curtains, armoured doors.\r\n7/7, 24/24."
    ],
    "it": [
      "Apertura porte, cambio di tutti i tipi di serrature, tapparelle, tende metalliche, blindatura porte, tutti i tipi di vetri.\r\n7 giorni su 7, 24 ore al giorno."
    ],
    "fr": [
      "Ouverture de porte, changement tous types de serrures, volets roulants, rideaux métalliques, blindage de portes, tous type de vitrages.\r\n7 Jours/7, 24h/24."
    ],
    "nl": [
      "Deuren openen, alle soorten sloten vervangen, rolluiken, metalen gordijnen, deurpantsering, alle soorten beglazing.\r\n7 dagen per week, 24 uur per dag."
    ],
    "es": [
      "Apertura de puertas, cambio de todo tipo de cerraduras, persianas, cortinas metálicas, blindaje de puertas, todo tipo de acristalamientos.\r\n7 días a la semana, 24 horas al día."
    ]
  },
