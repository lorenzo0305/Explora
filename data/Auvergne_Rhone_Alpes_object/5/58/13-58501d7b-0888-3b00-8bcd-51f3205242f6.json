  "rdfs:comment": {
    "de": [
      "Als Imker und Nougathersteller in Vallon Pont d'Arc produzieren und ernten wir einen Honig, der zu 100 % aus der Ardèche stammt, und verkaufen ihn direkt an die Nougaterie du Pont d'Arc. Als Nougathersteller stellen wir handwerklich Nougat mit unserem eigenen Honig her."
    ],
    "en": [
      "Beekeeper installed since January 2018 in Vallon pont d'Arc. Sale on the Vallon Pont d'Arc market and at the Pont d'Arc Nougaterie.\r\nMaking candy and gingerbread with honey my production."
    ],
    "it": [
      "Apicoltori e torronai del Vallon Pont d'Arc, produciamo e raccogliamo miele 100% Ardéchois e lo vendiamo direttamente alla Nougaterie du Pont d'Arc. Artigiani torronai, produciamo un torrone tradizionale con il nostro miele."
    ],
    "fr": [
      "Apiculteur-Nougatier à Vallon Pont d'Arc, nous produisons et récoltons un miel 100% Ardéchois et le vendons en direct à la Nougaterie du Pont d'Arc. Artisan nougatier, nous confectionnons un nougat artisanal avec notre propre miel."
    ],
    "nl": [
      "Imker / Nougatiers in Vallon Pont d'Arc, we produceren en oogsten 100% honing uit Ard��che en verkopen deze rechtstreeks aan onze winkel \"La Nougaterie du Pont d'Arc\" en op de markten, evenals andere producten gemaakt van onze honing: nougats , peperkoek."
    ],
    "es": [
      "Apicultores y turroneros de Vallon Pont d'Arc, producimos y cosechamos miel 100% Ardéchois y la vendemos directamente a la Nougaterie du Pont d'Arc. Turronero artesano, elaboramos un turrón tradicional con nuestra propia miel."
    ]
  },
