  "rdfs:comment": {
    "de": [
      "Seit 500 Jahren liegt das befestigte Haus von Durianne vor den Toren von Le Puy en Velay am Eingang der Loire-Schlucht.\r\nFührungen nur mit Reservierung (mind. 5 Pers.): Außenansicht des Schlosses, Garten, Schafstall, Gemüsegarten."
    ],
    "en": [
      "For 500 years, the fortified house of Durianne has stood at the gateway to Le Puy en Velay, at the entrance to the Loire Gorge.\r\nGuided tour by reservation only (minimum 5 people): castle exterior, garden, sheepfold, vegetable garden."
    ],
    "it": [
      "Da 500 anni, la casa fortificata di Durianne si trova alle porte di Le Puy en Velay, all'ingresso delle Gole della Loira.\r\nVisita guidata su prenotazione (minimo 5 persone): esterno del castello, giardino, ovile, orto."
    ],
    "fr": [
      "Depuis 500 ans, la maison forte de Durianne se situe aux portes du Puy en Velay à l'entrée des gorges de la Loire.\r\nVisite guidée uniquement sur réservation (minimum 5 pers) : extérieur du château, jardin, bergerie, potager."
    ],
    "nl": [
      "Het versterkte huis van Durianne staat al 500 jaar aan de poort van Le Puy en Velay, bij de ingang van de Loire-kloof.\r\nRondleiding op reservering (minimaal 5 personen): buiten het kasteel, tuin, schaapskooi, moestuin."
    ],
    "es": [
      "Desde hace 500 años, la casa fortificada de Durianne se alza a las puertas de Le Puy en Velay, en la entrada de las gargantas del Loira.\r\nVisita guiada previa reserva (mínimo 5 personas): exterior del castillo, jardín, aprisco, huerto."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ferme biologique de découverte au château de Durianne"
    ]
  },
