  "rdfs:comment": {
    "de": [
      "Entdecken Sie zwischen religiösen und weltlichen Gebäuden eine Auswahl der schönsten Glasmalereien von Valence. Ein Rundgang auf den Spuren der Werke der Familie Thomas, die seit 1878 Glasmalerei betreibt."
    ],
    "en": [
      "Between religious and secular buildings, discover a selection of some of the finest stained glass in Valence. Follow in the footsteps of the Thomas family, master glassmakers since 1878."
    ],
    "it": [
      "Tra edifici religiosi e secolari, scoprite una selezione di alcune delle più belle vetrate di Valence. Seguite le tracce della famiglia Thomas, maestri vetrai dal 1878."
    ],
    "fr": [
      "Entre édifices religieux et profanes, partez à la découverte d’une sélection de vitraux, parmi les plus beaux de Valence. Un circuit sur les traces des réalisations de la famille Thomas, maîtres-verriers depuis 1878."
    ],
    "nl": [
      "Ontdek tussen religieuze en wereldlijke gebouwen een selectie van het mooiste glas-in-lood van Valence. Treed in de voetsporen van de familie Thomas, meester-glasmakers sinds 1878."
    ],
    "es": [
      "Entre edificios religiosos y laicos, descubra una selección de algunas de las mejores vidrieras de Valence. Siga los pasos de la familia Thomas, maestros vidrieros desde 1878."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite guidée : L'art de la lumière - Journées Européennes des Métiers d'Art"
    ]
  },
