  "rdfs:comment": {
    "de": [
      "Das Bruegel ist eine flämische Kneipe, die in einem der ältesten Häuser von Bergues untergebracht ist: 1597! Aus dieser Zeit hat sich das Lokal mit langen Holztischen, Holzfußböden und sogar Pflastersteinen seinen Charakter bewahrt... und die ganze Wärme eines Holzfeuers im Kamin! Die regionalen Spezialitäten, die hausgemachte Küche und die Grillspezialitäten vom Holzfeuer machen den Ruf des Lokals aus."
    ],
    "en": [
      "Le Bruegel is a Flemish estaminet located in one of the oldest houses in Bergues: 1597! With its long wooden tables, cobblestone floors and even the warmth of a wood-burning fireplace, the place has retained all the cachet of that era! Regional specialities, homemade cuisine and wood-fired grills are the hallmarks of the place."
    ],
    "it": [
      "Le Bruegel è un estaminet fiammingo situato in una delle case più antiche di Bergues: 1597! Il locale ha conservato il fascino di quell'epoca, con lunghi tavoli in legno, pavimenti in legno, persino ciottoli... e tutto il calore di un camino a legna! Le specialità regionali, la cucina casalinga e le grigliate a legna hanno reso famoso questo locale."
    ],
    "fr": [
      "Le Bruegel est un estaminet flamand situé dans l'une des plus anciennes maisons de Bergues : 1597 ! De cette époque, l'établissement a conservé le cachet avec de longues tables en bois, du plancher, des pavés même!...et toute la chaleur d'une cheminée au feu de bois ! Les spécialités régionales, la cuisine faite maison et les grillades au feu de bois font la renommée du lieu."
    ],
    "nl": [
      "Le Bruegel is een Vlaams estaminet gevestigd in een van de oudste huizen van Bergues: 1597! Het etablissement heeft het cachet van die tijd behouden, met lange houten tafels, houten vloeren, zelfs kasseien... en alle warmte van een houtgestookte open haard! Regionale specialiteiten, huisgemaakte gerechten en houtgestookte grillgerechten hebben de plek beroemd gemaakt."
    ],
    "es": [
      "Le Bruegel es un estaminet flamenco situado en una de las casas más antiguas de Bergues: ¡1597! El establecimiento ha conservado el caché de aquella época, con largas mesas de madera, suelos de madera, incluso adoquines... ¡y todo el calor de una chimenea de leña! Las especialidades regionales, la comida casera y las parrilladas de leña han dado fama al lugar."
    ]
  },
