  "rdfs:comment": {
    "de": [
      "Herstellung einzigartiger bunter und dekorierter Keramiken \r\n- Gedrehte kulinarische Objekte\r\n- Taubenkrüge\r\n- Schmuck aus Keramik, Halbedelsteinen und 925er Silber\r\n\r\nLeitung von Töpferei-Workshops für Kinder und Erwachsene.\r\n\r\nBesichtigungen nach Vereinbarung."
    ],
    "en": [
      "Creation of unique coloured and decorated ceramics \r\n- Turned culinary objects\r\n- Pigeon jars\r\n- Ceramic jewelry, semi-precious stones and silver 925\r\n\r\nAnimation of pottery workshops for children and adults.\r\n\r\nVisits by appointment."
    ],
    "it": [
      "Creazione di ceramiche colorate e decorate uniche\r\n- Oggetti culinari trasformati\r\n- Barattoli con colombe\r\n- Gioielli in ceramica, pietre semipreziose e argento 925\r\n\r\nAnimazione di laboratori di ceramica per bambini e adulti.\r\n\r\nVisite su appuntamento."
    ],
    "fr": [
      "Création de céramiques uniques colorées et décorées : \r\n- Objets culinaires tournés\r\n- Jarres aux colombins\r\n- Bijoux céramique, pierres semi-précieuses et argent 925\r\n\r\nAnimation d'ateliers poterie pour enfants et adultes.\r\n\r\nVisites sur rendez-vous."
    ],
    "nl": [
      "Creatie van unieke gekleurde en gedecoreerde keramiek\r\n- Gedraaide culinaire objecten\r\n- Kruiken met duiven\r\n- Keramische juwelen, halfedelstenen en 925 zilver\r\n\r\nAnimatie van pottenbakworkshops voor kinderen en volwassenen.\r\n\r\nBezoeken op afspraak."
    ],
    "es": [
      "Creación de cerámicas únicas coloreadas y decoradas\r\n- Objetos culinarios torneados\r\n- Tarros con palomas\r\n- Joyas de cerámica, piedras semipreciosas y plata 925\r\n\r\nAnimación de talleres de cerámica para niños y adultos.\r\n\r\nVisitas con cita previa."
    ]
  },
