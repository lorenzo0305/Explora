  "rdfs:comment": {
    "de": [
      "Der Caveau Bugiste ist seit 1967 Produzent von Bugey-Weinen und für die Qualität seiner Weine und seine Gastfreundschaft bekannt.\r\nEs werden mehr als 30 Cuvées aus AOC Bugey und IGP Vins des Coteaux de l'Ain angeboten.\r\nDer Weinkeller verfügt außerdem über zwei Museen, die frei zugänglich sind."
    ],
    "en": [
      "Producer of Bugey wines since 1967, the Caveau Bugiste is renowned for the quality of its wines and its welcome. \r\nMore than 30 vintages of AOC Bugey and IGP Vins des Coteaux de l'Ain are offered. \r\nThe cellar also has two museums with free access."
    ],
    "it": [
      "Produttore di vini di Bugey dal 1967, Caveau Bugiste è rinomato per la qualità dei suoi vini e per la sua calda accoglienza.\r\nL'offerta comprende più di 30 vini AOC Bugey e IGP Vins des Coteaux de l'Ain.\r\nIl Caveau dispone anche di due musei aperti al pubblico."
    ],
    "fr": [
      "Producteur de vins du Bugey depuis 1967, le Caveau Bugiste est renommé pour la qualité de ses vins et son accueil. \r\nPlus de 30 cuvées en AOC Bugey et IGP Vins des Coteaux de l'Ain sont proposées. \r\nLe Caveau dispose aussi de deux musées en accès libre."
    ],
    "es": [
      "Productor de vinos de Bugey desde 1967, Caveau Bugiste es famoso por la calidad de sus vinos y su cálida acogida.\r\nOfrece más de 30 vinos AOC Bugey e IGP Vins des Coteaux de l'Ain.\r\nEl Caveau también cuenta con dos museos abiertos al público."
    ],
    "nl": [
      "Caveau Bugiste, producent van Bugey-wijnen sinds 1967, staat bekend om de kwaliteit van zijn wijnen en zijn warme onthaal.\r\nEr worden meer dan 30 AOC Bugey en IGP Vins des Coteaux de l'Ain wijnen aangeboden.\r\nDe Caveau heeft ook twee musea die open zijn voor het publiek."
    ]
  },
