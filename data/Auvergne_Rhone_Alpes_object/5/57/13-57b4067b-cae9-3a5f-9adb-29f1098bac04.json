  "rdfs:comment": {
    "de": [
      "Nächtliche Skitourenroute auf den alpinen Skipisten des Skigebiets. Diese Route ist ideal für mittlere bis erfahrene Tourengeher (recht schwierige Strecke) und kombiniert schattige Waldpassagen mit offenen Almwiesen."
    ],
    "en": [
      "Night-time ski touring on the ski area's downhill slopes. This route, which is ideal for intermediate hikers (fairly difficult), combines shady forest passages and open mountain pastures."
    ],
    "it": [
      "Sci alpinismo notturno sulle piste da discesa del comprensorio sciistico. Questo percorso, ideale per escursionisti di livello intermedio-avanzato (abbastanza difficile), combina passaggi ombrosi nei boschi e pascoli aperti in montagna."
    ],
    "fr": [
      "Itinéraire nocturne de ski de randonnée sur les pistes de ski alpin du domaine skiable. Ce parcours, idéal pour les randonneurs de niveau intermédiaire à confirmé (parcours assez difficile), combine des passages forestiers ombragés et des alpages dégagés."
    ],
    "nl": [
      "Nachtelijke skitochten op de skipistes van het skigebied. Deze route, die ideaal is voor gemiddelde wandelaars (redelijk moeilijk), combineert schaduwrijke bospassages en open bergweiden."
    ],
    "es": [
      "Esquí de travesía nocturno por las pistas de descenso de la estación de esquí. Esta ruta, ideal para excursionistas de nivel intermedio a avanzado (bastante difícil), combina pasajes sombreados de bosque y pastos abiertos de montaña."
    ]
  },
  "rdfs:label": {
    "en": [
      "Montée d'Aujon ski touring itinerary - night ascent"
    ],
    "fr": [
      "Itinéraire de ski de randonnée Montée d'Aujon - nocturne"
    ],
    "nl": [
      "Montée d'Aujon toerskiroute - nachtbeklimming"
    ]
  },
