  "rdfs:comment": {
    "de": [
      "Entdecken Sie Aquazergues, Ihre Wasserlandschaft, die der Entspannung und der Fitness gewidmet ist. Tauchen Sie in unseren für alle Altersgruppen geeigneten Becken ab, entspannen Sie sich in unseren Wellnessbereichen oder üben Sie verschiedene Wassersportarten aus. Eine Auszeit zum Wohlfühlen erwartet Sie"
    ],
    "en": [
      "Discover Aquazergues, your aquatic centre dedicated to relaxation and fitness. Dive into our pools suitable for all ages, relax in our wellness areas or enjoy a variety of water activities. A wellness break awaits you."
    ],
    "it": [
      "Scoprite Aquazergues, il vostro centro acquatico dedicato al relax e al fitness. Tuffatevi nelle nostre piscine per tutte le età, rilassatevi nelle nostre aree benessere o partecipate a diverse attività acquatiche. Un momento di benessere vi aspetta"
    ],
    "fr": [
      "Découvrez Aquazergues,votre espace aquatique dédié à la détente et à la forme. Plongez dans nos bassins adaptés à tous les âges, relaxez-vous dans nos espaces bien-être ou pratiquez des activités aquatiques variées. Une parenthèse de bien-être vous attend"
    ],
    "nl": [
      "Ontdek Aquazergues, jouw aquacentrum voor ontspanning en fitness. Neem een duik in onze zwembaden voor alle leeftijden, ontspan in onze wellnessruimtes of neem deel aan verschillende wateractiviteiten. Een moment van welzijn wacht op je"
    ],
    "es": [
      "Descubra Aquazergues, su centro acuático dedicado a la relajación y la puesta en forma. Sumérjase en nuestras piscinas para todas las edades, relájese en nuestras zonas de bienestar o participe en diversas actividades acuáticas. Le espera un momento de bienestar"
    ]
  },
