  "rdfs:comment": {
    "de": [
      "Das in der Unterstadt von Saint-Flour gelegene Grand Hôtel l'Etape ist ein 3-Sterne-Hotel und -Restaurant, das modernen Komfort mit authentischem Charme verbindet.\r\nEs bietet seinen Gästen eine warme und elegante Umgebung, die ideal für einen angenehmen und erholsamen Aufenthalt ist."
    ],
    "en": [
      "Located in the lower town of Saint-Flour, the Grand Hôtel l'Etape is a 3-star hotel-restaurant combining modern comfort with authentic charm.\r\nIt offers guests a warm, elegant setting, ideal for a pleasant, relaxing stay."
    ],
    "it": [
      "Situato nella città bassa di Saint-Flour, il Grand Hôtel l'Etape è un hotel-ristorante a 3 stelle che unisce il comfort moderno al fascino autentico.\r\nOffre agli ospiti un ambiente caldo ed elegante, ideale per un soggiorno piacevole e rilassante."
    ],
    "fr": [
      "Situé dans la ville basse de Saint-Flour, le Grand Hôtel l'Etape est un hôtel-restaurant 3 étoiles alliant confort moderne et charme authentique.\r\nIl offre à ses hôtes un cadre chaleureux et élégant, idéal pour un séjour agréable et reposant."
    ],
    "es": [
      "Situado en la parte baja de la ciudad de Saint-Flour, el Grand Hôtel l'Etape es un hotel-restaurante de 3 estrellas que combina el confort moderno con el encanto auténtico.\r\nOfrece a sus huéspedes un entorno cálido y elegante, ideal para una estancia agradable y relajante."
    ],
    "nl": [
      "Grand Hôtel l'Etape, gelegen in de benedenstad van Saint-Flour, is een 3-sterren hotel-restaurant dat modern comfort combineert met authentieke charme.\r\nHet biedt gasten een warme en elegante omgeving, ideaal voor een aangenaam en ontspannen verblijf."
    ]
  },
  "rdfs:label": {
