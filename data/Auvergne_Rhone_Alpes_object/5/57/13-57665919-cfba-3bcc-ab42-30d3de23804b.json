  "rdfs:comment": {
    "de": [
      "Poesieabend mit anschließendem Buffet: Lesung aus einer meiner Sammlungen\r\n\r\nInnocence, Ausstellung von Estelle Darve, traumhafte Zeichnungen und Gedichte.\r\nInnocence ist eine Serie von kleinen, bunten Zeichnungen mit trockenen Pastellkreiden und Wasserfarben."
    ],
    "en": [
      "Poetry evening followed by a buffet: Reading from one of my collections\r\n\r\nInnocence, Exhibition by Estelle Darve, dreamlike drawings and poetry.\r\nInnocence is a series of colorful pastel and watercolor drawings."
    ],
    "it": [
      "Serata di poesia seguita da un buffet: Lettura da una delle mie raccolte\r\n\r\nInnocence, mostra di Estelle Darve, disegni onirici e poesia.\r\nInnocence è una serie di piccoli disegni colorati a pastello secco e acquerello."
    ],
    "fr": [
      "Soirée poésie suivi d’un buffet : Lecture de l’un de mes recueils \r\n\r\nInnocence, Exposition d’Estelle Darve, dessins oniriques et poésies.\r\nInnocence est une série de petits dessins colorés aux pastels secs et à l’eau."
    ],
    "es": [
      "Velada poética seguida de un buffet: Lectura de una de mis colecciones\r\n\r\nInnocence, Exposición de Estelle Darve, dibujos oníricos y poesía.\r\nInnocence es una serie de pequeños dibujos coloristas en pastel seco y acuarela."
    ],
    "nl": [
      "Poëzieavond gevolgd door een buffet: Lezing uit een van mijn bundels\r\n\r\nInnocence, tentoonstelling van Estelle Darve, dromerige tekeningen en poëzie.\r\nInnocence is een serie kleine kleurrijke tekeningen in droge pastel en aquarel."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Soirée poésie de l'Exposition Innocence - Estelle Darve, dessins et poésies"
    ]
  },
