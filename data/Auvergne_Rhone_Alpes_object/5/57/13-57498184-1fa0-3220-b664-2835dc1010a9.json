  "rdfs:comment": {
    "de": [
      "Nehmen Sie am Tisch Platz und entdecken Sie eine regionale Küche, die von delikaten Weinen begleitet wird!\r\nEs besteht auch die Möglichkeit, die Bar zu nutzen."
    ],
    "en": [
      "Enjoy those home made dishes ! Fresh and local !"
    ],
    "it": [
      "Accomodatevi intorno al tavolo e scoprite la cucina locale accompagnata da vini pregiati!\r\nPotrete anche usufruire del bar."
    ],
    "fr": [
      "Prenez place autour de la table pour découvrir une cuisine de terroir accompagnée de délicats vins !\r\nPossibilité de profiter également du bar."
    ],
    "es": [
      "Siéntese a la mesa y descubra la cocina local acompañada de buenos vinos\r\nTambién puede disfrutar del bar."
    ],
    "nl": [
      "Neem plaats rond de tafel en ontdek de lokale keuken vergezeld van heerlijke wijnen!\r\nJe kunt ook genieten van de bar."
    ]
  },
