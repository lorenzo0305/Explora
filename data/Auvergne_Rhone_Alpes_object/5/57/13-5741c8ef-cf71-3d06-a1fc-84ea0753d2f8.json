          "additionalInformation": {
            "de": [
              "Keine Öffnung für die Öffentlichkeit\r\n\r\n- Verkauf auf dem Bio-Bauernmarkt in St Denis les Bourg, freitags von 15:30 bis 18:30 Uhr auf dem Parkplatz des Festsaals\r\n\r\n- Verkauf auf dem Markt in Bourg-en-Bresse samstags von 7:30 bis 12:30 Uhr in der Markthalle."
            ],
            "en": [
              "Not open to the public\r\n\r\n- Sales at the St Denis les Bourg organic farmers' market, Fridays from 3:30pm to 6:30pm in the village hall parking lot\r\n\r\n- Sales at the Bourg-en-Bresse market on Saturdays from 7.30am to 12.30pm, under the covered market."
            ],
            "it": [
              "Non aperto al pubblico\r\n\r\n- Vendita al mercato biologico di St Denis les Bourg, il venerdì dalle 15.30 alle 18.30 nel parcheggio del municipio\r\n\r\n- Vendita al mercato di Bourg-en-Bresse il sabato dalle 7.30 alle 12.30, sotto il mercato coperto."
            ],
            "fr": [
              "Pas d'ouverture au public\r\n\r\n- Vente au marché de producteurs bio de St Denis les Bourg, les vendredis de 15h30 à 18h30 sur le parking de la salle des fêtes\r\n\r\n- Vente au marché de Bourg-en-Bresse le samedi de 7h30 à 12h30, sous le marché couvert."
            ],
            "es": [
              "No abierto al público\r\n\r\n- Venta en el mercado ecológico de St Denis les Bourg, los viernes de 15.30 a 18.30 h en el aparcamiento del ayuntamiento\r\n\r\n- Venta en el mercado de Bourg-en-Bresse, los sábados de 7.30 a 12.30 h, bajo el mercado cubierto."
            ],
            "nl": [
              "Niet toegankelijk voor het publiek\r\n\r\n- Verkoop op de biologische boerenmarkt van St Denis les Bourg, vrijdag van 15.30 tot 18.30 uur op de parkeerplaats van het dorpshuis\r\n\r\n- Verkoop op de markt van Bourg-en-Bresse op zaterdag van 7.30 tot 12.30 uur, onder de overdekte markt."
            ]
          },
