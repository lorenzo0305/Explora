  "rdfs:comment": {
    "de": [
      "Das Café des Sucs ist eine Dorfbar, die leichte Gerichte aus fertigen, lokalen und respektvollen Produkten anbietet. Trockene und frische Käseplatten und Wurstplatten. Jakobusempfang und Übernachtungsmöglichkeiten für Pilger. Zugang zur Küche."
    ],
    "en": [
      "Café des Sucs is a village bar offering light meals made with local, respectful, finished products. Dry and fresh cheese boards and charcuterie boards. Pilgrims welcome and overnight accommodation. Kitchen access."
    ],
    "it": [
      "Il Café des Sucs è un bar di paese che serve piatti leggeri preparati con prodotti locali, rispettosi e finiti. Tavole di formaggi e salumi secchi e freschi. Accoglie i pellegrini e offre alloggio per la notte. Accesso alla cucina."
    ],
    "fr": [
      "Le Café des Sucs est un bar de village qui propose de la restauration légère de produits finis, locaux et respectueux. Planches de fromages secs et frais et planches de charcuterie. Accueil jacquaire et hébergement des pèlerins à la nuitée. Accès cuisine."
    ],
    "es": [
      "El Café des Sucs es un bar de pueblo que sirve comidas ligeras elaboradas con productos locales, respetuosos y acabados. Tablas de quesos secos y frescos y charcutería. Acoge a los peregrinos y ofrece alojamiento para pasar la noche. Acceso a la cocina."
    ],
    "nl": [
      "Café des Sucs is een dorpscafé waar lichte maaltijden worden geserveerd, bereid met lokale, respectvolle, afgewerkte producten. Planken met droge en verse kazen en vleeswaren. Ontvangt pelgrims en biedt overnachtingsmogelijkheden. Toegang tot de keuken."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Café des Sucs"
    ]
  },
