  "rdfs:comment": {
    "de": [
      "Es gibt Menschen, die mit Tieren sprechen, um sie zu verstehen... Es gibt Menschen, die Tiere verstehen, ohne mit ihnen sprechen zu müssen..."
    ],
    "en": [
      "There are some who talk to animals to try to understand them... There are some who understand animals without the need to talk to them..."
    ],
    "it": [
      "Ci sono alcuni che parlano con gli animali per cercare di capirli... Ci sono alcuni che capiscono gli animali senza bisogno di parlare con loro..."
    ],
    "fr": [
      "Il y en a qui parlent aux animaux pour essayer de les comprendre... Il y en a qui comprennent les animaux sans le besoin de leur parler..."
    ],
    "nl": [
      "Sommige mensen praten met dieren om ze te begrijpen... Er zijn er die dieren begrijpen zonder met ze te hoeven praten..."
    ],
    "es": [
      "Algunas personas hablan con los animales para tratar de entenderlos... Hay quienes entienden a los animales sin necesidad de hablar con ellos..."
    ]
  },
