  "rdfs:comment": {
    "de": [
      "Barbereich mit kalten Getränken (Softdrinks, Bier, Wein) sowie heißen Getränken (Kaffee, Cappuccino) und verschiedenen Käse- und Wurstplatten, bei Ihrem Ausrüstungsverleih!"
    ],
    "en": [
      "Bar area with cold drinks (soft drinks, beers, wines) as well as hot drinks (coffees, cappuccinos) and various cheese and charcuterie platters, available from your equipment rental store!"
    ],
    "it": [
      "Area bar con bevande fredde (bibite, birre, vini) e calde (caffè, cappuccini) e vari taglieri di formaggi e salumi, disponibili presso il vostro negozio di noleggio attrezzature!"
    ],
    "fr": [
      "Espace bar avec des boissons froides (softs, bières, vins) ainsi que des boissons chaudes (cafés, cappuccinos) et divers plateaux de fromages et charcuteries, auprès de votre magasin de location de matériel !"
    ],
    "es": [
      "Zona de bar con bebidas frías (refrescos, cervezas, vinos), así como bebidas calientes (cafés, capuchinos) y diversas tablas de quesos y embutidos, ¡disponibles en la tienda de alquiler de material!"
    ],
    "nl": [
      "Bargedeelte met koude dranken (frisdranken, bieren, wijnen) en warme dranken (koffie, cappuccino) en verschillende kaas- en vleeswarenplateaus, verkrijgbaar bij uw materiaalverhuur!"
    ]
  },
  "rdfs:label": {
