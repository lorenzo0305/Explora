  "rdfs:comment": {
    "de": [
      "Vertical Aventure ist ein Team von professionellen Bergführern und Betreuern, die sich für Bergsportarten begeistern: Klettern, Canyoning, Höhlenforschung, Via Ferrata, Paragliding oder auch ungewöhnliche Übernachtungen."
    ],
    "en": [
      "Vertical Aventure is a team of professional guides and instructors with a passion for mountain sports: rock climbing, canyoning, caving, Via Ferrata, paragliding and unusual overnight stays."
    ],
    "it": [
      "Vertical Aventure è un team di guide e istruttori professionisti con la passione per gli sport di montagna: arrampicata, canyoning, speleologia, vie ferrate, parapendio e pernottamenti insoliti."
    ],
    "fr": [
      "Vertical Aventure est une équipe de guides et moniteurs professionnels passionnés par les sports de montagne: escalade, canyoning, spéléologie, Via Ferrata, Parapente ou encore nuit insolite."
    ],
    "nl": [
      "Vertical Aventure is een team van professionele gidsen en instructeurs met een passie voor bergsporten: klimmen, canyoning, speleologie, Via Ferrata, paragliding en ongewone overnachtingen."
    ],
    "es": [
      "Vertical Aventure es un equipo de guías y monitores profesionales apasionados por los deportes de montaña: escalada, barranquismo, espeleología, vías ferratas, parapente y pernoctaciones insólitas."
    ]
  },
