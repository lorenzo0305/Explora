  "rdfs:comment": {
    "de": [
      "FEEL GOOD SPA\r\nDie unglaubliche Energie von La Folie Douce durch gewagte, speziell für unsere Kunden entwickelte Behandlungen weitergeben. Das Feel Good Spa empfängt Sie für einen Moment voller Entspannung mit den natürlichen Produkten der Marke PURE ALTITUDE."
    ],
    "en": [
      "FEEL GOOD SPA\r\nConveying the incredible energy of Folie Douce through daring treatments specially designed for our customers. Feel Good Spa welcomes you for a moment of relaxation with natural products from PURE ALTITUDE."
    ],
    "it": [
      "SPA FEEL GOOD\r\nTrasmettete l'incredibile energia de la Folie Douce attraverso audaci trattamenti appositamente studiati per i nostri clienti. La Feel Good Spa vi accoglie per un momento di relax con i prodotti naturali del marchio PURE ALTITUDE."
    ],
    "fr": [
      "Le Feel Good Club Sport & Spa de La Folie Douce Hotels est un Spa version 4 étoiles : une piscine extérieure chauffée de 18 mètres, un sauna et un hammam et une terrasse face aux montagnes, ainsi que sept cabines de massage, pour des soins individuels ou"
    ],
    "es": [
      "SPA FEEL GOOD\r\nTransmita la increíble energía de la Folie Douce a través de atrevidos tratamientos especialmente diseñados para nuestros clientes. El Feel Good Spa le da la bienvenida para un momento de relajación con productos naturales de la marca PURE ALTITUDE."
    ],
    "nl": [
      "De Feel Good Club Sport & Spa van La Folie Douce Hotels is een 4-sterren Spa: een verwarmd buitenzwembad van 18 meter, een sauna en een hamam en een terras met uitzicht op de bergen, evenals zeven massagecabines voor individuele of groepsbehandelingen"
    ]
  },
