  "rdfs:comment": {
    "de": [
      "Genossenschaft von kollektivem Interesse, die die Umwandlung von Obst in Fruchtsäfte und Nektare anbietet, ab 100 kg Obst. Schlägt einen Besuch der Werkstatt, ihrer Umgebung und eine Verkostung vor. Verkauf von Säften und Nektaren."
    ],
    "en": [
      "Cooperative of collective interest which proposes the transformation of fruits into juice of fruits and nectars, starting from 100 kg of fruits. Batch transformation. Offers a tour of the workshop, its environment and tasting. Sale of juice and nectars."
    ],
    "it": [
      "La Société Coopérative d'Intérêt Collectif offre la trasformazione della frutta in succhi e nettari, a partire da 100 kg di frutta. Lavorazione lotto per lotto. Offre una visita del laboratorio, dei dintorni e una degustazione. Vendita di succhi e nettari."
    ],
    "fr": [
      "Société Coopérative d'Intérêt Collectif qui propose la transformation de fruit en jus et nectars, à partir de 100 kg de fruits. Transformation en lot par lot. Propose une visite de l'atelier, son environnement et dégustation. Vente de jus et nectars."
    ],
    "es": [
      "Société Coopérative d'Intérêt Collectif ofrece transformación de fruta en zumos y néctares, a partir de 100 kg de fruta. Procesamiento por lotes. Ofrece una visita del taller, sus alrededores y una degustación. Venta de zumos y néctares."
    ],
    "nl": [
      "Société Coopérative d'Intérêt Collectif biedt fruitverwerking tot sappen en nectars, vanaf 100 kg fruit. Verwerking per partij. Biedt een rondleiding door de werkplaats, de omgeving en een proeverij. Verkoop van sappen en nectars."
    ]
  },
