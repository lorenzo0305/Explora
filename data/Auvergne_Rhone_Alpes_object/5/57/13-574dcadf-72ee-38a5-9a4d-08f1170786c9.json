  "rdfs:comment": {
    "de": [
      "Von Saint-Jean-de-Maurienne aus fahren Sie in Richtung Col de la Madeleine. Sie beginnen die Schleife mit den eleganten Serpentinen von Montvernier, bevor Sie vollends in eine wilde und unberührte Bergstimmung eintreten."
    ],
    "en": [
      "Leaving Saint-Jean-de-Maurienne, head for the Col de la Madeleine. You'll start the loop with the elegant switchbacks of Montvernier, before fully entering the wild, unspoilt mountain environment."
    ],
    "it": [
      "Partendo da Saint-Jean-de-Maurienne, ci si dirige verso il Col de la Madeleine. L'anello inizia con gli eleganti tornanti che portano a Montvernier, prima di entrare in un ambiente montano selvaggio e incontaminato."
    ],
    "fr": [
      "Au départ de Saint-Jean-de-Maurienne, partez en direction du Col de la Madeleine. Vous commencerez la boucle par les élégants lacets de Montvernier avant d'entrée pleinement dans une ambiance montagne sauvage et préservée."
    ],
    "nl": [
      "Verlaat Saint-Jean-de-Maurienne en ga naar de Col de la Madeleine. Je begint de lus met de elegante switchbacks naar Montvernier voordat je de wilde, ongerepte bergwereld betreedt."
    ],
    "es": [
      "Saliendo de Saint-Jean-de-Maurienne, diríjase al Col de la Madeleine. Comenzará el bucle con las elegantes curvas hacia Montvernier, antes de adentrarse en un entorno de montaña salvaje y virgen."
    ]
  },
  "rdfs:label": {
    "en": [
      "Ascent to Col de la Madeleine"
    ],
    "fr": [
      "Montée au Col de la Madeleine"
    ]
  },
