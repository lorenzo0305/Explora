  "rdfs:comment": {
    "de": [
      "Elegant Fußball spielen, auf einem Golfplatz, nach den Regeln des Golfsports - so könnte die Definition von Fußballgolf lauten.  Verbringen Sie einen geselligen Moment in einer grünen Umgebung."
    ],
    "en": [
      "Playing soccer in style, on a golf course, according to the rules of golf - that could be the definition of foot golf.  Spend a convivial moment in a green setting."
    ],
    "it": [
      "Giocare a calcio con stile, su un campo da golf, secondo le regole del golf: questa potrebbe essere la definizione di foot golf.  Trascorrere un momento di convivialità in un ambiente verde."
    ],
    "fr": [
      "Jouer au football avec élégance, sur un terrain de golf, selon les règles du golf, tel pourrait être la définition du foot golf.  Passez un moment convivial dans un cadre verdoyant."
    ],
    "nl": [
      "Voetballen in stijl, op een golfbaan, volgens de golfregels - dat zou de definitie van footgolf kunnen zijn.  Breng een gezellig moment door in een groene omgeving."
    ],
    "es": [
      "Jugar al fútbol con estilo, en un campo de golf, según las reglas del golf: ésa podría ser la definición del foot golf.  Pasar un rato agradable en un entorno verde."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Foot Golf"
    ]
  },
