  "rdfs:comment": {
    "de": [
      "Die Bowl ist die höchste Europas und bietet einen atemberaubenden Ausblick und Nervenkitzel: eine spielerische Gleitzone für Skateboards und BMX-Räder (verboten für Roller, Inline-Skates und Fahrräder)."
    ],
    "en": [
      "Come and ride the bowl, which is the highest in Europe. Fun area offers breathtaking views and sensations: a fun zone for skateboarding and BMX (no scooters, rollerblades or bikes allowed)."
    ],
    "it": [
      "Venite a percorrere la pista, la più alta d'Europa, con vista sul Lac de la Grenouillère e vicino agli alberi: un'area di divertimento per skateboarder e BMX rider (scooter, rollerblade e biciclette non sono ammessi)."
    ],
    "fr": [
      "Venez rider le bowl est le plus haut d’Europe offrant une vue sur le lac de la Grenouillère et en proximité d'arbres : zone ludique de glisse pour skateboard et BMX (interdit aux trottinettes, rollers et vélos)."
    ],
    "es": [
      "Ven a montar en el bowl, el más alto de Europa, con vistas al Lac de la Grenouillère y cerca de los árboles: una zona de diversión para patinadores y ciclistas de BMX (no se permiten patinetes, patines ni bicicletas)."
    ],
    "nl": [
      "Kom rijden op de bowl, de hoogste van Europa, met uitzicht over het Lac de la Grenouillère en dicht bij bomen: een leuk gebied voor skateboarders en BMX-rijders (scooters, skeelers en fietsen zijn niet toegestaan)."
    ]
  },
