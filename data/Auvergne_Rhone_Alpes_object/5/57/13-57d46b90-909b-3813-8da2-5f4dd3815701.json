  "rdfs:comment": {
    "de": [
      "Big Bear ist ein einzigartiger Concept Store in Samoëns. Die Entscheidung für Big Bear als Skiverleih in Samoens ist eine Entscheidung für Qualität und Komfort dank unseres Teams aus leidenschaftlichen, aufmerksamen und kundenorientierten Mitarbeitern"
    ],
    "en": [
      "Big Bear is a unique concept store in Samoens. Choosing Big Bear for your ski hire in Samoens means choosing quality and comfort thanks to our team of passionate, attentive and customer-focused staff."
    ],
    "it": [
      "Big Bear è un concept store unico a Samoens. Scegliere Big Bear per il vostro noleggio sci a Samoens significa scegliere la qualità e il comfort grazie al nostro team di collaboratori appassionati, attenti e focalizzati sul cliente"
    ],
    "fr": [
      "Big Bear est un concept store unique à Samoëns. Choisir Big Bear pour votre location de ski à Samoens c'est choisir la qualité et le confort grâce à notre équipe de passionnés, attentionnée et à l'écoute de nos clients"
    ],
    "nl": [
      "Big Bear is een unieke concept store in Samoens. Kiezen voor Big Bear voor je skiverhuur in Samoens betekent kiezen voor kwaliteit en comfort dankzij ons team van gepassioneerde, attente en klantgerichte medewerkers."
    ],
    "es": [
      "Big Bear es un concepto de tienda único en Samoens. Elegir Big Bear para su alquiler de esquí en Samoens es elegir calidad y comodidad gracias a nuestro equipo de apasionados, atentos y orientados al cliente"
    ]
  },
