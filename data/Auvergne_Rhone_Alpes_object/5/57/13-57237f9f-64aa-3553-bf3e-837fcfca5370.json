  "rdfs:comment": {
    "de": [
      "In diesem magischen Ort, dem Maison Vermorel, ist der Erdgeschossgarten für das Kulinarische reserviert.\r\nDer Tisch Vermorel liegt in einem 20.000 m2 großen Park in einer bemerkenswerten Umgebung."
    ],
    "en": [
      "In the magical setting of Maison Vermorel, the ground floor is reserved for the culinary arts.\r\nLocated in the heart of a 20,000m2 park, La Table Vermorel is set in a remarkable setting."
    ],
    "it": [
      "Nella magica cornice della Maison Vermorel, il piano terra è riservato all'arte culinaria.\r\nSituata nel cuore di un parco di 20.000 m2, La Table Vermorel è inserita in un contesto straordinario."
    ],
    "fr": [
      "Dans ce lieu magique qu’est la Maison Vermorel, le rez-de jardin est réservé au Culinaire.\r\nSitué au cœur d’un parc de 20 000m2 La table Vermorel est située dans un cadre remarquable."
    ],
    "nl": [
      "In de magische omgeving van Maison Vermorel is de begane grond gereserveerd voor de culinaire kunsten.\r\nLa Table Vermorel ligt in het hart van een park van 20.000 m2 in een opmerkelijke omgeving."
    ],
    "es": [
      "En el marco mágico de la Maison Vermorel, la planta baja está reservada a las artes culinarias.\r\nSituada en el corazón de un parque de 20.000 m2, La Table Vermorel se encuentra en un marco excepcional."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La table Vermorel"
    ]
  },
