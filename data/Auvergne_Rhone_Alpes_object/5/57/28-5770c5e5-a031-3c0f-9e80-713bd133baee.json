  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/8c789780-f66d-3f29-a5f2-311030252234",
      "dc:description": {
        "de": [
          "Carla empfängt Sie von Dienstag bis Samstag auf dem Parkplatz von Ets Ridoux, gegenüber von Lidl, und bietet Ihnen Muscheln direkt vom Erzeuger sowie kühle Getränke und Produkte aus der Bucht an."
        ],
        "en": [
          "Carla welcomes you from Tuesday to Saturday in the Ets Ridoux parking lot, opposite Lidl, and offers mussels direct from the producer, as well as cold drinks and Bay products."
        ],
        "it": [
          "Carla vi accoglie dal martedì al sabato nel parcheggio di Ets Ridoux, di fronte a Lidl, e offre cozze direttamente dal produttore, oltre a bevande fredde e prodotti Bay."
        ],
        "fr": [
          "Carla vous accueille du mardi au samedi sur le parking de l'Ets Ridoux, face à Lidl, et vous propose des moules en direct du producteur, ainsi que des boissons fraiches et des produits de la Baie."
        ],
        "nl": [
          "Carla verwelkomt je van dinsdag tot zaterdag op de parkeerplaats van Ets Ridoux, tegenover Lidl, en biedt mosselen rechtstreeks van de producent, evenals koude dranken en Bay-producten."
        ],
        "es": [
          "Carla le recibe de martes a sábado en el aparcamiento de Ets Ridoux, frente al Lidl, y le ofrece mejillones directamente del productor, así como bebidas frías y productos de la Bahía."
        ]
      },
