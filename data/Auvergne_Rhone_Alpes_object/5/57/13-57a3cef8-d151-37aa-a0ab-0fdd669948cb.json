  "rdfs:comment": {
    "de": [
      "Als diversifizierter Bio- und Freiland-Maraicher vermarktet David seine Produkte in \"Nos Champs\", einem Bauernladen in L'Ecancière, und seit kurzem auch auf dem Guinguette-Markt in Le Chalutier am Mittwochabend."
    ],
    "en": [
      "A diversified organic and open-field farmer, David sells his produce at \"Nos Champs\", a producers' store in L'Ecancière, and more recently at the \"marché guinguette du Chalutier\" on Wednesday evenings."
    ],
    "it": [
      "Agricoltore biologico diversificato e di campo aperto, David vende i suoi prodotti a \"Nos Champs\", un negozio di produttori a L'Ecancière, e più recentemente al \"marché guinguette du Chalutier\" il mercoledì sera."
    ],
    "fr": [
      "Maraicher diversifié en agriculture biologique et de plein champ, David commercialise à \"Nos Champs\", magasin de producteurs à L'Ecancière et depuis peu au marché guinguette du Chalutier le mercredi soir."
    ],
    "es": [
      "David, agricultor ecológico diversificado y de campo abierto, vende sus productos en \"Nos Champs\", una tienda de productores de L'Ecancière, y más recientemente en el \"marché guinguette du Chalutier\" los miércoles por la noche."
    ],
    "nl": [
      "David is een gediversifieerde bio- en vollegrondboer en verkoopt zijn producten bij \"Nos Champs\", een producentenwinkel in L'Ecancière, en sinds kort op de \"marché guinguette du Chalutier\" op woensdagavond."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ferme du Clair de Lune"
    ]
  },
