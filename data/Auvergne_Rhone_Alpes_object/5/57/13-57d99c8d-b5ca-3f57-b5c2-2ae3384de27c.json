  "rdfs:comment": {
    "de": [
      "In diesem kleinen Museum ist Guignol König! Sie finden eine große Sammlung von Puppen und andere einzigartige Gegenstände entdecken Sie das Bild der kleinen Holz Lyon trägt."
    ],
    "en": [
      "In this small museum, Guignol is king! You will discover the history of Guignol, by whom it was invented, when and why, through a wide collection of puppets and other unique items bearing the image of small wooden Lyon."
    ],
    "it": [
      "In questo piccolo museo, Guignol è il re assoluto! Qui scoprirai una vasta collezione di marionette e altri oggetti unici a immagine del piccolo lionese di legno."
    ],
    "fr": [
      "Dans ce petit musée, Guignol est roi ! Vous y découvrirez l'histoire de la création de Guignol au travers de collections de marionnettes et automates."
    ],
    "nl": [
      "In dit kleine museum is Punch koning! U ontdekt de geschiedenis van het ontstaan van Guignol aan de hand van collecties poppen en automaten."
    ],
    "es": [
      "En este pequeño museo ¡Guignol es el rey! Los visitantes podrán descubrir una amplia colección de marionetas y otros objetos únicos con la efigie del pequeño lionés de madera."
    ]
  },
  "rdfs:label": {
    "de": [
