  "rdfs:comment": {
    "de": [
      "Inmitten eines 6 Hektar großen Parks bietet das Haus 15 Zimmer und Suiten sowie ein Gourmet-Restaurant mit einer blumengeschmückten Terrasse: \"La Broderie\"."
    ],
    "en": [
      "In the heart of a 6-hectare park, on opening, this establishment will offer 15 bedrooms and suites as well as a gastronomic restaurant and a flower-filled patio: \"La Broderie\"."
    ],
    "it": [
      "Nel cuore di un parco di 6 ettari, la struttura proporrà 15 camere e suite al momento della sua apertura, oltre a un ristorante gastronomico e alla sua terrazza fiorita: \"La Broderie\"."
    ],
    "fr": [
      "Au cœur d’un parc de 6 hectares, l’établissement propose 15 chambres et suites ainsi qu’un restaurant gastronomique et sa terrasse fleurie : «La Broderie»."
    ],
    "nl": [
      "In het hart van een park van 6 hectare biedt het etablissement 15 kamers en suites, evenals een gastronomisch restaurant en een bloemrijk terras: \"La Broderie\"."
    ],
    "es": [
      "En el corazón de un parque de 6 hectáreas, el establecimiento ofrece 15 habitaciones y suites, así como un restaurante gastronómico y su florida terraza: \"La Broderie\"."
    ]
  },
