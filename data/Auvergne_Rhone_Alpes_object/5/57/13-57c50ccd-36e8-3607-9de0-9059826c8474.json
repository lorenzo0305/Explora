  "rdfs:comment": {
    "de": [
      "Genießen Sie großzügige und leckere Tacos im Herzen des Skiorts! Tacos Avenue Chamrousse bietet Ihnen leckere Rezepte, um all Ihre Wünsche zu erfüllen, zum Verzehr vor Ort oder zum Mitnehmen."
    ],
    "en": [
      "Come and enjoy generous, gourmet tacos in the heart of the resort! Tacos Avenue Chamrousse offers tasty recipes to satisfy all your cravings, to eat in or take away."
    ],
    "it": [
      "Venite a gustare generosi tacos gourmet nel cuore del resort! Tacos Avenue Chamrousse offre ricette gustose per soddisfare tutte le vostre voglie, da mangiare o da portare via."
    ],
    "fr": [
      "Venez savourer des tacos généreux et gourmands au cœur de la station ! Tacos Avenue Chamrousse vous propose des recettes savoureuses pour combler toutes vos envies, à déguster sur place ou à emporter."
    ],
    "es": [
      "Venga y disfrute de generosos tacos gourmet en el corazón de la estación Tacos Avenue Chamrousse ofrece sabrosas recetas para satisfacer todos sus antojos, para comer en casa o para llevar."
    ],
    "nl": [
      "Kom genieten van gulle, gastronomische taco's in het hart van het resort! Tacos Avenue Chamrousse biedt smakelijke recepten om al uw verlangens te bevredigen, om te eten of om mee te nemen."
    ]
  },
