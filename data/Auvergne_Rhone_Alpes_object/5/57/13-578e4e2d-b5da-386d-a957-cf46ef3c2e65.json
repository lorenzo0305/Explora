  "rdfs:comment": {
    "de": [
      "Luxuriöses Chalet im Napoleonischen Stil im Zentrum von Vichy und am Rande des Parks Napoleon III.\r\n3 Salons für Empfänge - ein Untergeschoss mit einzigartigen Leistungen (Hammam, Sauna, Billard, Fitnessraum usw.) - ein Garten und sein beheizter Pool - 10 Zimmer"
    ],
    "en": [
      "Luxurious Napoleonic chalet in the heart of Vichy, on the edge of the Napoleon III park.\r\n3 reception rooms - basement with unique amenities (hammam, sauna, billiards, gym, etc.) - garden with heated pool - 10 bedrooms"
    ],
    "it": [
      "Lussuoso chalet napoleonico nel centro di Vichy, ai margini del parco Napoleone III.\r\n3 sale di ricevimento - un seminterrato con servizi unici (hammam, sauna, biliardo, palestra, ecc.) - un giardino con piscina riscaldata - 10 camere da letto"
    ],
    "fr": [
      "Luxueux Chalet Napoléonien en plein centre de Vichy et au bord du parc Napoléon III. \r\n3 salons pour les réceptions - un sous-sol avec des prestations uniques (hammam, sauna, billard, salle de sport etc) - un jardin et sa piscine chauffée - 10 chambres"
    ],
    "nl": [
      "Luxe Napoleontisch chalet in het centrum van Vichy, aan de rand van het Napoleon III park.\r\n3 ontvangstruimten - een kelder met unieke faciliteiten (hammam, sauna, biljart, fitnessruimte, enz.) - een tuin met verwarmd zwembad - 10 slaapkamers"
    ],
    "es": [
      "Lujoso chalet napoleónico en el centro de Vichy, al borde del parque Napoleón III.\r\n3 salas de recepción - un sótano con instalaciones únicas (hammam, sauna, billar, gimnasio, etc.) - un jardín con piscina climatizada - 10 habitaciones"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Chalet Clermont-Tonnerre"
    ]
  },
