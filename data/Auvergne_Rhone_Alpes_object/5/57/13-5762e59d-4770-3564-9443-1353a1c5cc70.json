  "rdfs:comment": {
    "de": [
      "Wanderungen und Mountainbike-Touren zwischen Seen und Bergen. Entdecken Sie die Gegend auf den im Gebiet markierten Wegen, die für alle Niveaus geeignet sind.\r\n17 markierte Strecken, von 4 bis 32 km"
    ],
    "en": [
      "Hiking and mountain biking between lakes and mountains. Discover the region on marked trails suitable for all levels.\r\n17 marked trails, from 4 to 32km"
    ],
    "it": [
      "Escursioni a piedi e in mountain bike tra laghi e montagne. Scoprite la zona su sentieri segnalati adatti a tutti i livelli.\r\n17 percorsi segnalati, da 4 a 32 km"
    ],
    "fr": [
      "Randonnées et balades VTT entre lacs et montagnes. Découvrez le territoire à travers les chemins balisés sur le territoire et adaptées à tous niveaux.\r\n17 parcours balisés, de 4 à 32km"
    ],
    "nl": [
      "Wandelen en mountainbiken tussen meren en bergen. Ontdek het gebied op gemarkeerde routes geschikt voor alle niveaus.\r\n17 bewegwijzerde routes, van 4 tot 32 km"
    ],
    "es": [
      "Senderismo y bicicleta de montaña entre lagos y montañas. Descubra la zona por senderos señalizados aptos para todos los niveles.\r\n17 rutas señalizadas, de 4 a 32 km"
    ]
  },
