  "rdfs:comment": {
    "de": [
      "Im Herzen des Weinkellers können Sie im Cafuron, unserer Brühe aus Forézien, zu Mittag essen. Eine süße Ergänzung, um sich an der guten Küche von Amélie und den Weinen der Domaines Qui Montent zu erfreuen"
    ],
    "en": [
      "In the heart of the cellar, enjoy lunch at Cafuron, our Forézien broth, a sweet addition to Amélie?s fine cuisine and Domaines Qui Montent? wines"
    ],
    "it": [
      "Nel cuore della cantina, venite a pranzare al Cafuron, il nostro brodo Forézien, un delizioso complemento alla cucina raffinata di Amélie e ai vini dei Domaines Qui Montent?"
    ],
    "fr": [
      "Au cœur de la cave, venez déjeuner en immersion au  Cafuron, notre bouillon forézien, une douce addition pour se régaler de la bonne cuisine d’Amélie et des vins des Domaines Qui Montent…"
    ],
    "nl": [
      "Kom in het hart van de kelder lunchen in Cafuron, onze Forézien-bouillon, een heerlijke aanvulling op de fijne keuken van Amélie en de wijnen van Domaines Qui Montent?"
    ],
    "es": [
      "En el corazón de la bodega, venga a almorzar al Cafuron, nuestro caldo Forézien, un delicioso complemento a la buena cocina de Amélie y a los vinos de Domaines Qui Montent?"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant le Cafuron"
    ]
  },
