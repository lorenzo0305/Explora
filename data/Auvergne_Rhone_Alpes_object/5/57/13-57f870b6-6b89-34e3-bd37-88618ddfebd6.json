  "rdfs:comment": {
    "de": [
      "Erlernen und Praktizieren von Chorgesang. Organisation von und Teilnahme an Veranstaltungen zur Förderung ihrer Aktivitäten.\r\nAktivitäten: Organisation einer Chanson-Show und eines Festivals. Organisation eines Wochenendes zur Entdeckung des Chorgesangs."
    ],
    "en": [
      "Learning and practicing choral singing. Organization and participation in events to promote its activities.\r\nActivities: organization of a song show and festival. Organization of a weekend to discover choral singing."
    ],
    "it": [
      "Apprendimento e pratica del canto corale. Organizzazione e partecipazione a eventi per promuovere le proprie attività\r\nAttività: organizzazione di uno spettacolo canoro e di un festival. Organizzazione di un fine settimana alla scoperta del canto corale."
    ],
    "fr": [
      "Apprentissage et pratique du chant choral. Organisation et participation à des manifestations destinées à promouvoir ses activités. \r\nActivités : organisation d’un spectacle en chansons et festival. Organisation d’un week-end de découverte du chant choral."
    ],
    "nl": [
      "Leren en oefenen van koorzang. Organisatie van en deelname aan evenementen om de activiteiten te promoten.\r\nActiviteiten: organisatie van een zangshow en festival. Organisatie van een weekend om koorzang te ontdekken."
    ],
    "es": [
      "Aprender y practicar el canto coral. Organización y participación en eventos para promover sus actividades\r\nActividades: organización de un espectáculo de canciones y un festival. Organización de un fin de semana para descubrir el canto coral."
    ]
  },
