  "rdfs:comment": {
    "de": [
      "Traditionelles, familiengeführtes Hotel-Restaurant in einer ländlichen Umgebung, 8 km von \"Tarare\" entfernt und in der Nähe des \"Lac des Sapins\".\r\nDas Hotel verfügt über 9 Zimmer, mit Außenspielen für Kinder."
    ],
    "en": [
      "Traditional and family hotel-restaurant located in a country setting 8 km from \"Tarare\" and near the \"Lac des Sapins\".\r\nThe hotel has 9 rooms, with outdoor games for children."
    ],
    "it": [
      "Tradizionale hotel-ristorante a conduzione familiare situato in un ambiente rurale a 8 km da Tarare e vicino al Lac des Sapins.\r\nL'hotel dispone di 9 camere, con giochi all'aperto per bambini."
    ],
    "fr": [
      "Hôtel-Restaurant traditionnel et familial situé dans un cadre campagnard à 8 km de \"Tarare\" et à proximité du \"Lac des Sapins\".\r\nL'hôtel dispose de 9 chambres, avec des jeux extérieurs pour enfants."
    ],
    "nl": [
      "Traditioneel familiehotel-restaurant gelegen in een landelijke omgeving op 8 km van Tarare en dicht bij het Lac des Sapins.\r\nHet hotel heeft 9 kamers, met buitenspelen voor kinderen."
    ],
    "es": [
      "Tradicional hotel-restaurante familiar situado en un entorno rural a 8 km de Tarare y cerca del Lac des Sapins.\r\nEl hotel dispone de 9 habitaciones, con juegos al aire libre para niños."
    ]
  },
  "rdfs:label": {
