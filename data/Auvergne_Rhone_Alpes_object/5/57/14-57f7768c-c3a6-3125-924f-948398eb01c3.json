  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/a75b0aa2-cedb-3a14-9c5b-a2c363155572",
      "dc:description": {
        "de": [
          "Handwerklich hergestellte Metzgerei und Wurstwaren\nHochwertiges und schmackhaftes Fleisch (mit AB-, AOC- oder auch DOP-Zertifizierung), Fertiggerichte aus dem Partyservice. Bereitstellung von Braten- und Triperiediensten."
        ],
        "en": [
          "Traditional butcher's and delicatessen\nQuality, tasty meats (certified AB, AOC or AOP), ready-made meals from our catering service. Rotisserie and tripe services available."
        ],
        "it": [
          "Macelleria e salumeria tradizionale\nCarni di qualità e gustose (certificate AB, AOC o AOP), piatti preparati dal nostro servizio di catering. Disponibili servizi di rosticceria e trippa."
        ],
        "fr": [
          "Boucherie charcuterie artisanale\nViandes de qualité et savoureuses (certifiées AB, AOC ou encore AOP), plats cuisinés du service traiteur. Mise à disposition de services de rôtisserie et de triperie."
        ],
        "es": [
          "Carnicería tradicional y charcutería\nCarnes de calidad y sabrosas (certificadas AB, AOC o AOP), platos preparados de nuestro servicio de catering. Servicios de asador y callos disponibles."
        ],
        "nl": [
          "Ambachtelijke slagerij en delicatessenzaak\nSmakelijke vleeswaren van hoge kwaliteit (gecertificeerd AB, AOC of AOP), bereide gerechten van onze traiteurdienst. Rotisserie en pens beschikbaar."
        ]
      },
      "@type": [
        "Description"
      ],
