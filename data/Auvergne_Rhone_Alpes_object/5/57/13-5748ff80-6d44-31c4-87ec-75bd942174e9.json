  "rdfs:comment": {
    "de": [
      "Diese Route ist ein kleines Abenteuer vor den Toren von St-Jean, um auf atypische Weise zur Station Bottières zu gelangen."
    ],
    "en": [
      "This itinerary is a little adventure on the outskirts of St-Jean, giving you access to the Bottières resort in an atypical way."
    ],
    "it": [
      "Questo percorso è una piccola avventura alla periferia di St-Jean, che offre un modo insolito per raggiungere la località di Bottières."
    ],
    "fr": [
      "Cet itinéraire est une petite aventure aux portes de St-Jean pour accéder à la station des Bottières de manière atypique."
    ],
    "es": [
      "Esta ruta es una pequeña aventura en las afueras de St-Jean, que ofrece una forma poco habitual de llegar a la estación de Bottières."
    ],
    "nl": [
      "Deze route is een klein avontuur aan de rand van St-Jean en biedt een ongebruikelijke manier om het skioord Bottières te bereiken."
    ]
