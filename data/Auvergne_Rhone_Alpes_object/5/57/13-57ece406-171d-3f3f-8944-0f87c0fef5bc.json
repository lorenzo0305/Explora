  "rdfs:comment": {
    "de": [
      "Entdecken Sie dieses herrliche Skigebiet mit fantastischen Ausblicken und einer blauen Loipe von 10 km Länge. Rundwanderung über die Landstraße D41A (La Croisette - La Grotte du Diable)."
    ],
    "en": [
      "Come and discover this impressive site with exceptional views and our 10 km cross-country blue run. Loop on the D41A departmental road (la Croisette- la Grotte du Diable)."
    ],
    "it": [
      "Venite a scoprire la nostra pista blu per lo sci di fondo di circa 10 km (andata e ritorno) nella magnifica cornice della Salève con i suoi panorami eccezionali. La pista si snoda lungo la strada D41A (la Croisette - la Grotte du Diable), chiusa in inverno."
    ],
    "fr": [
      "Venez découvrir notre piste bleue de ski de fond d'environ 10 km (allé-retour) dans le magnifique site du Salève avec des vues exceptionnelles. La piste prend place sur la route départementale D41A (la Croisette - la Grotte du Diable), fermée l'hiver."
    ],
    "es": [
      "Venga a descubrir nuestra pista azul de esquí de fondo de unos 10 km (ida y vuelta) en el magnífico marco de la Salève y sus excepcionales vistas. La pista discurre por la carretera D41A (la Croisette - la Grotte du Diable), cerrada en invierno."
    ],
    "nl": [
      "Kom en ontdek onze blauwe langlaufloipe van ongeveer 10 km (heen en terug) in het prachtige Salève gebied met uitzonderlijke uitzichten. De baan ligt aan de weg D41A (la Croisette - la Grotte du Diable), die in de winter gesloten is."
    ]
  },
  "rdfs:label": {
    "de": [
      "Skilanglauf in La Croisette - Blaue Loipe - Les Pitons"
    ],
    "en": [
      "Cross-country skiing at La Croisette - Blue run - Les Pitons"
    ],
    "it": [
      "Sci di fondo a La Croisette - Piste bleue - Les pitons"
    ],
    "fr": [
      "Ski de fond à la Croisette - Piste bleue - Les pitons"
    ],
    "es": [
      "Esquí de fondo en La Croisette - Piste bleue - Les pitons"
    ]
  },
