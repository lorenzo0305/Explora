  "rdfs:comment": {
    "de": [
      "Erlebnisse, die man in Aubrac erleben kann.\r\nCécile und André heißen Sie auf ihrem Hof willkommen, um verschiedene Momente je nach Lust und Laune und Jahreszeit miteinander zu teilen."
    ],
    "en": [
      "Experiences to live in Aubrac.\r\nCécile and André will welcome you on their farm to share different moments according to your desires and the season."
    ],
    "it": [
      "Esperienze ad Aubrac.\r\nCécile e André vi accoglieranno nella loro fattoria per condividere momenti diversi a seconda dei vostri desideri e della stagione."
    ],
    "fr": [
      "Expériences à vivre en Aubrac.\r\nCécile et André vous accueilleront sur leur ferme pour partager différents moments en fonction de vos envies et de la saison."
    ],
    "es": [
      "Experiencias en Aubrac.\r\nCécile y André le recibirán en su granja para compartir diferentes momentos según sus deseos y la temporada."
    ],
    "nl": [
      "Ervaringen in Aubrac.\r\nCécile en André heten je welkom op hun boerderij om verschillende momenten te delen, afhankelijk van je wensen en het seizoen."
    ]
  },
