  "rdfs:comment": {
    "de": [
      "Anlässlich der 22. Ausgabe der Nacht der Museen lädt Sie das Pays d'art et d'histoire am Samstag, den 23. Mai dazu ein, die Interpretationszentren für Architektur und Kulturerbe im Hôtel Demoret und der Chapelle de la Visitation zu entdecken."
    ],
    "en": [
      "To mark the 22nd Museum Night, the Pays d?art et d?histoire invites you to discover the Architecture and Heritage Interpretation Centers at Hôtel Demoret and Chapelle de la Visitation on Saturday, May 23."
    ],
    "it": [
      "In occasione della 22a Notte dei Musei, il Pays d'art et d'histoire vi invita a scoprire i Centri di Interpretazione dell'Architettura e del Patrimonio dell'Hôtel Demoret e della Cappella della Visitazione sabato 23 maggio."
    ],
    "fr": [
      "À l’occasion de la 22e édition de la Nuit des musées, le Pays d’art et d’histoire vous invite à découvrir les Centres d’interprétation de l’architecture et du patrimoine à l’Hôtel Demoret et chapelle de la Visitation le samedi 23 mai."
    ],
    "nl": [
      "Ter gelegenheid van de 22e Museumnacht nodigt het Pays d'art et d'histoire je uit om op zaterdag 23 mei de Interpretatiecentra voor Architectuur en Erfgoed in het Hôtel Demoret en de Visitatiekapel te ontdekken."
    ],
    "es": [
      "Con motivo de la 22ª Noche de los Museos, el Pays d'art et d'histoire le invita a descubrir el sábado 23 de mayo los Centros de Interpretación de la Arquitectura y el Patrimonio del Hôtel Demoret y la Capilla de la Visitación."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Nuit des musée à la chapelle de la Visitation"
    ]
  },
