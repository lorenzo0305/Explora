      "dc:description": {
        "de": [
          "Wenn die Pfeife ertönt, begeben Sie sich auf eine geführte Wanderung zwischen Lagunen, Teichen, Unterholz und Haldenaufstiegen."
        ],
        "en": [
          "When the whistle blows, set off on a guided hike through lagoons, ponds, undergrowth and up a slag heap."
        ],
        "it": [
          "Al fischio d'inizio, si parte per una passeggiata guidata tra lagune, stagni, sottobosco e su un cumulo di scorie."
        ],
        "fr": [
          "Au coup de sifflet, partez pour une randonnée guidée entre lagunage, étang, espaces en sous-bois et ascension de terril."
        ],
        "es": [
          "Cuando suene el silbato, emprenda un paseo guiado por lagunas, estanques, maleza y un escorial."
        ],
        "nl": [
          "Als het fluitsignaal klinkt, ga je op pad voor een begeleide wandeling door lagunes, vijvers, kreupelhout en over een terril."
        ]
      },
