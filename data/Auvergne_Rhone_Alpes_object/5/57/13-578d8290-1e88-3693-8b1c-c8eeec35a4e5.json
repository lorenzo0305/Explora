  "rdfs:comment": {
    "de": [
      "Wir bieten Ihnen eine Reihe von Artisous-Käsen, Joghurts und Milchdesserts, Rohmilch, grüne Linsen AOP du Puy und Linsenmehl. Fleisch von Lammfleisch. Verkauf am Samstagmorgen auf dem Bauernhof."
    ],
    "en": [
      "We offer a range of artisan cheeses, yoghurts and dairy desserts, raw milk, AOP du Puy green lentils and lentil flour. Lamb meat. Saturday morning sale at the farm."
    ],
    "it": [
      "Offriamo una gamma di formaggi artigianali, yogurt e dessert a base di latte, latte crudo, lenticchie verdi DOP du Puy e farina di lenticchie. Carne di agnello. Vendita il sabato mattina in fattoria."
    ],
    "fr": [
      "Nous vous proposons une gamme de fromages aux artisous, yaourts et desserts lactés, lait cru, des lentilles vertes AOP du Puy et de la farine de lentille. Viande d'agneau. Vente le samedi matin à la ferme."
    ],
    "nl": [
      "We bieden een assortiment ambachtelijke kazen, yoghurts en zuiveldesserts, rauwe melk, groene linzen met BOB du Puy en linzenmeel. Lamsvlees. Verkoop op zaterdagochtend op de boerderij."
    ],
    "es": [
      "Ofrecemos una gama de quesos artesanos, yogures y postres lácteos, leche cruda, lentejas verdes DOP du Puy y harina de lentejas. Carne de cordero. Venta los sábados por la mañana en la granja."
    ]
  },
  "rdfs:label": {
