  "rdfs:comment": {
    "de": [
      "Freundliches und modernes Café. Schnell-Restaurant. Möglichkeit, einen Raum im Obergeschoss für Geburtstage,Treffen, Partys...zu reservieren."
    ],
    "en": [
      "Friendly and modern coffee. Fast food. Possibility of reservation room in the floor for birthdays, meetings, evenings..."
    ],
    "it": [
      "Fast food.\r\nCaffè moderno e accogliente su due piani, con trasmissioni sportive e intrattenimento nei fine settimana.  Possibilità di riservare una sala al piano superiore per compleanni, riunioni, feste, ecc."
    ],
    "fr": [
      "Restauration Rapide.\r\nCafé convivial et moderne sur deux étages avec retransmission des évènements sportifs et animations les week end.  Possibilité de réservation salle à l'étage pour anniversaires, réunions, soirées..."
    ],
    "nl": [
      "Snel eten.\r\nVriendelijk, modern café op twee verdiepingen met sportuitzendingen en entertainment in het weekend.  Mogelijkheid om boven een zaal te reserveren voor verjaardagen, vergaderingen, feestjes, enz."
    ],
    "es": [
      "Comida rápida.\r\nAgradable y moderna cafetería en dos plantas con retransmisiones deportivas y animación los fines de semana.  Posibilidad de reservar una sala en la planta superior para cumpleaños, reuniones, fiestas, etc."
    ]
  },
