  "rdfs:comment": {
    "de": [
      "Das Bistrot de la gare, unser Bar-Restaurant mit Terrasse, bietet Ihnen eine mit frischen und lokalen Produkten zubereitete Verpflegung, die Sie den ganzen Tag über genießen können, vor Ort oder zum Mitnehmen. Nicht zu vergessen unser Souvenirladen!"
    ],
    "en": [
      "The Bistrot de la gare, our bar-restaurant with terrace, offers a range of fresh local produce to eat in or take away all day long. And don't forget the souvenir shop!"
    ],
    "it": [
      "Il Bistrot de la gare, il nostro bar-ristorante con terrazza, offre una gamma di prodotti freschi locali da consumare o da portare via durante tutta la giornata. E non dimenticate il negozio di souvenir!"
    ],
    "fr": [
      "Le Bistrot de la gare, notre bar-restaurant avec terrasse, vous propose une restauration élaborée avec des produits frais et locaux à déguster tout au long de la journée, sur place ou à emporter. Sans oublier la boutique souvenirs !"
    ],
    "nl": [
      "In de Bistrot de la gare, ons bar-restaurant met terras, kun je de hele dag door verse streekproducten eten of meenemen. En vergeet de souvenirwinkel niet!"
    ],
    "es": [
      "El Bistrot de la gare, nuestro bar-restaurante con terraza, ofrece una amplia gama de productos locales frescos para comer o llevar durante todo el día. Y no se olvide de la tienda de recuerdos."
    ]
  },
