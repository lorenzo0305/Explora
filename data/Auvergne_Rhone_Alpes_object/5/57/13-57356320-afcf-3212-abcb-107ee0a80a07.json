  "rdfs:comment": {
    "de": [
      "Das Fremdenverkehrsamt befindet sich am Ufer des Lac d'Aydat, direkt neben der Segelschule. Unsere Reiseberater empfangen Besucher das ganze Jahr über."
    ],
    "en": [
      "The Tourist Office is located on the shores of Lac d'Aydat, right next to the sailing school. Our tourism advisors welcome visitors all year round."
    ],
    "it": [
      "L'Ufficio del Turismo si trova sulle rive del Lac d'Aydat, accanto alla scuola di vela. I nostri consulenti turistici accolgono i visitatori tutto l'anno."
    ],
    "fr": [
      "L'Office de Tourisme est situé au bord du lac d'Aydat, juste à côté de l'école de voile. Nos conseillers en séjours accueillent les visiteurs toute l'année."
    ],
    "es": [
      "La Oficina de Turismo se encuentra a orillas del lago de Aydat, justo al lado de la escuela de vela. Nuestros asesores de vacaciones reciben a los visitantes todo el año."
    ],
    "nl": [
      "Het VVV-kantoor ligt aan de oever van het Lac d'Aydat, vlak naast de zeilschool. Onze vakantieadviseurs verwelkomen bezoekers het hele jaar door."
    ]
  },
