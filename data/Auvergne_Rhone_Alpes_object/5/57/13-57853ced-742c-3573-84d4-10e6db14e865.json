  "rdfs:comment": {
    "de": [
      "Die AAPPMA verfügt über 90 km Bäche der Kategorie 1 und 30 km am Fluss Morge.\r\nNeuheit 2026: Fischereiaufseher, der der AAPPMA von Combronde zugewiesen ist und für die Überwachung des Flusses Morge zuständig ist."
    ],
    "en": [
      "The AAPPMA owns 90 km of streams classified as Category 1 and 30 km of the Morge River.\r\nNew for 2026: Fishing warden assigned to the Combronde AAPPMA and responsible for monitoring the Morge River."
    ],
    "it": [
      "L'AAPPMA conta 90 km di corsi d'acqua di prima categoria e 30 km sul fiume Morge.\r\nNovità per il 2026: un guardapesca assegnato all'AAPPMA di Combronde e responsabile del monitoraggio del fiume Morge."
    ],
    "fr": [
      "L'AAPPMA possède 90 km de ruisseaux classés en 1ère catégorie et 30 km sur la rivière la Morge.\r\nNouveauté 2026 : Garde de pêche affecté à l'AAPPMA de Combronde et en charge de la surveillance de la rivière Morge."
    ],
    "es": [
      "La AAPPMA cuenta con 90 km de arroyos de 1ª categoría y 30 km en el río Morge.\r\nNovedad para 2026: guarda de pesca asignado a la AAPPMA de Combronde y responsable del seguimiento del río Morge."
    ],
    "nl": [
      "De AAPPMA heeft 90 km stromen van de 1e categorie en 30 km op de rivier de Morge.\r\nNieuw in 2026: visserijopzichter toegewezen aan de AAPPMA Combronde en verantwoordelijk voor het toezicht op de Morge."
    ]
  },
  "rdfs:label": {
    "de": [
      "Angelstelle - Fluss La Pampeluze"
    ],
    "en": [
      "Fishing site - Rivière La Pampeluze"
    ],
    "fr": [
      "Site de pêche - Rivière La Morge"
    ]
  },
