  "rdfs:comment": {
    "de": [
      "Die Course du C?ur ist ein Laufwettbewerb mit dem Ziel, das Bewusstsein für Organspenden zu schärfen. Die Ankunft des Course du C?ur in Bourg Saint Maurice am Sonntag, den 29. März 2026 vor dem Rathaus."
    ],
    "en": [
      "The Course du Cœur is a running race to raise awareness of organ donation. The Race du Cœur will finish in Bourg Saint Maurice on Sunday, March 29, 2026, in front of the town hall."
    ],
    "it": [
      "La Course du C?ur è una corsa a piedi ideata per sensibilizzare alla donazione di organi. L'arrivo della Course du C?ur a Bourg Saint Maurice è previsto per domenica 29 marzo 2026 davanti al municipio."
    ],
    "fr": [
      "La Course du Cœur, c’est une course à pied avec pour objectif la sensibilisation au don d’organes. L'arrivée de la Course du Cœur à Bourg Saint Maurice le dimanche 29 mars 2026 en face de l'hôtel de ville."
    ],
    "es": [
      "La Course du Cœur es una carrera pedestre destinada a sensibilizar sobre la donación de órganos. La meta de la Course du Cœur en Bourg Saint Maurice el domingo 29 de marzo de 2026 frente al ayuntamiento."
    ],
    "nl": [
      "De Course du Cœur is een hardloopwedstrijd om aandacht te vragen voor orgaandonatie. De finish van de Course du Cœur in Bourg Saint Maurice op zondag 29 maart 2026 voor het gemeentehuis."
    ]
  },
