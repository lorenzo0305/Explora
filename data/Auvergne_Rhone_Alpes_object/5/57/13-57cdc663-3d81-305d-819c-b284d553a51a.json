  "rdfs:comment": {
    "de": [
      "Erleben Sie mit Yannick Dacheux ein unvergessliches Abenteuer im Heißluftballon über dem See von Annecy und den Alpen! Als leidenschaftlicher Pilot mit 400 Flugstunden lädt er Sie zu einem magischen Moment in der Luft ein. Buchen Sie jetzt Ihren Flug!"
    ],
    "en": [
      "Experience an unforgettable hot-air ballooning adventure with Yannick Dacheux over Lake Annecy and the Alps! A passionate pilot with 400h of flying experience, he invites you to a magical moment in the air. Book your flight now!"
    ],
    "it": [
      "Vivete un'indimenticabile avventura in mongolfiera con Yannick Dacheux sul lago di Annecy e sulle Alpi! Pilota appassionato con 400 ore di esperienza di volo, vi invita a vivere un momento magico in aria. Prenotate subito il vostro volo!"
    ],
    "fr": [
      "Vivez une aventure inoubliable en montgolfière avec Yannick Dacheux au-dessus du lac d’Annecy et des Alpes ! Pilote passionné avec 400h de vol, il vous invite à un moment magique dans les airs. Réservez dès maintenant votre envol !"
    ],
    "es": [
      "Viva una inolvidable aventura en globo aerostático con Yannick Dacheux sobre el lago de Annecy y los Alpes Piloto apasionado con 400 horas de experiencia de vuelo, le invita a vivir un momento mágico en el aire. ¡Reserve ya su vuelo!"
    ],
    "nl": [
      "Beleef een onvergetelijk luchtballonavontuur met Yannick Dacheux boven het meer van Annecy en de Alpen! Als gepassioneerd piloot met 400 uur vliegervaring nodigt hij je uit om een magisch moment in de lucht te beleven. Boek nu je vlucht!"
    ]
  },
