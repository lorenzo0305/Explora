  "rdfs:comment": {
    "de": [
      "Lassen Sie sich vom Rhythmus unserer reinrassigen Schlittenhunde mitreißen, während Sie durch eine unberührte und geschützte Natur fahren und die wunderschönen verschneiten Landschaften genießen."
    ],
    "en": [
      "Let yourself be transported to the rhythm of our Nordic dogs for a walk in the heart of unspoilt nature, to enjoy the magnificent snow-covered landscapes."
    ],
    "it": [
      "Lasciatevi trasportare al ritmo dei nostri cani nordici durante una passeggiata nel cuore di una natura vergine e preservata, per godere di magnifici paesaggi innevati."
    ],
    "fr": [
      "Laissez vous transporter au rythme de nos chiens de traîneaux pure race le temps d'une balade au cœur d'une nature vierge et préservée, afin de profiter de magnifiques paysages enneigés."
    ],
    "nl": [
      "Laat onze rasechte sledehonden je meenemen op een tocht door ongerepte landschappen en prachtige besneeuwde landschappen."
    ],
    "es": [
      "Deje que nuestros perros de trineo de pura raza le lleven de paseo por paisajes vírgenes y magníficos parajes nevados."
    ]
  },
