  "rdfs:comment": {
    "de": [
      "Französische Varietät\n\nEtwas mehr als zwei Jahre nach dem Ende der Paradis Tour, die 2022 mit dem Victoire de la Musique für das beste Konzert ausgezeichnet wurde, kehrt Ben Mazué im Jahr 2026 mit einer völlig neuen Show zurück."
    ],
    "en": [
      "French variety\n\nJust over 2 years after the end of the Paradis Tour, winner of the Victoire de la Musique for Best Concert in 2022, Ben Mazué returns with a brand new show in 2026."
    ],
    "it": [
      "Varietà francese\n\nA poco più di due anni dalla fine del Paradis Tour, vincitore della Victoire de la Musique per il miglior concerto nel 2022, Ben Mazué torna con un nuovo spettacolo nel 2026."
    ],
    "fr": [
      "Variété française\n\nUn peu plus de 2 ans après la fin du Paradis Tour, Victoire de la Musique du meilleur concert en 2022, Ben Mazué revient avec un tout nouveau spectacle en 2026."
    ],
    "es": [
      "Variedad francesa\n\nPoco más de 2 años después del final de la Gira Paradis, ganadora de la Victoire de la Musique al Mejor Concierto en 2022, Ben Mazué regresa con un espectáculo totalmente nuevo en 2026."
    ],
    "nl": [
      "Franse variëteit\n\nIets meer dan 2 jaar na het einde van de Paradis Tour, winnaar van de Victoire de la Musique voor Beste Concert in 2022, keert Ben Mazué terug met een gloednieuwe show in 2026."
    ]
  },
