  "rdfs:comment": {
    "de": [
      "Das Restaurant Chez les filles bietet Ihnen eine traditionelle und originelle Küche. Mittags haben Sie die Wahl zwischen verschiedenen Menüs, Burgern und Croque-madame. Abends und am Wochenende gibt es à la carte!"
    ],
    "en": [
      "The Chez les filles restaurant offers traditional and original cuisine. At lunchtime, you'll have a choice of menus, burgers and croque-madame. Evenings and weekends are à la carte!"
    ],
    "it": [
      "Il ristorante Chez les filles offre una cucina tradizionale e originale. A pranzo è possibile scegliere tra diversi menu, hamburger e croque-madame. La sera e il fine settimana è à la carte!"
    ],
    "fr": [
      "Le restaurant Chez les filles vous propose une cuisine traditionnelle et originale. A midi, vous aurez le choix entre plusieurs menus, des burgers, des croque-madame. Le soir et week-end, c'est à la carte !"
    ],
    "nl": [
      "Het restaurant Chez les filles biedt een traditionele en originele keuken. s Middags kun je kiezen uit verschillende menu's, hamburgers en croque-madame. s Avonds en in het weekend is het à la carte!"
    ],
    "es": [
      "El restaurante Chez les filles ofrece cocina tradicional y original. Al mediodía, podrá elegir entre varios menús, hamburguesas y croque-madame. Las noches y los fines de semana son a la carta"
    ]
  },
