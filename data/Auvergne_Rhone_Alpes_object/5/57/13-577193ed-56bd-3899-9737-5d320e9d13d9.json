      "schema:openingHoursSpecification": [
        {
          "@id": "https://data.datatourisme.fr/fdcab31f-1d25-3970-b6c1-b0027416b0f1",
          "schema:validFrom": "2026-05-29T00:00:00",
          "schema:validThrough": "2026-09-30T23:59:59",
          "@type": [
            "schema:OpeningHoursSpecification"
          ],
          "additionalInformation": {
            "de": [
              "Für die Mai-Brücken: Öffnung unter Vorbehalt der Schneeschmelze (direkt beim Tourismusbüro nachfragen)\r\nErleichterter kostenpflichtiger Zugang über die Seilbahn von La Croix im Sommer: täglich im Juli und August + an den Wochenenden im Juni und September (vorbehaltlich des Wetters mit Bestätigung am Donnerstag für das Wochenende).\r\nKostenloser Zugang zu Fuß über die Wanderwege."
            ],
            "en": [
              "For May bridges: opening subject to snowmelt (check with the Tourist Office)\r\nPaid access via the La Croix gondola in summer: every day in July-August + weekends in June and September (subject to weather conditions, with confirmation on Thursday for the weekend).\r\nFree access on foot via hiking trails."
            ],
            "it": [
              "Per i giorni festivi di maggio: apertura subordinata allo scioglimento della neve (per informazioni rivolgersi direttamente all'Ufficio del Turismo)\r\nAccesso a pagamento tramite la funivia di La Croix in estate: tutti i giorni in luglio e agosto + fine settimana in giugno e settembre (a seconda delle condizioni meteorologiche, con conferma il giovedì per il fine settimana).\r\nAccesso libero a piedi attraverso i sentieri escursionistici."
            ],
            "fr": [
              "Pour les ponts de mai : ouverture sous réserve de la fonte des neiges (se renseigner directement auprès de l'Office de Tourisme)\r\nAccès payant facilité via la télécabine de la Croix en été : tous les jours en juillet-août + les week-ends de juin et septembre (sous réserve météo avec confirmation le jeudi pour le week-end).\r\nAccès gratuit à pied par les sentiers de randonnée."
            ],
            "nl": [
              "Voor de feestdagen in mei: opening afhankelijk van het smelten van de sneeuw (neem rechtstreeks contact op met het Office du Tourisme voor informatie)\r\nBetaalde toegang via de kabelbaan La Croix in de zomer: elke dag in juli en augustus + weekends in juni en september (afhankelijk van de weersomstandigheden, met bevestiging op donderdag voor het weekend).\r\nGratis toegang te voet via de wandelpaden."
            ],
            "es": [
              "Para los días festivos de mayo: apertura sujeta al deshielo (para más información, póngase en contacto directamente con la Oficina de Turismo)\r\nAcceso de pago a través del teleférico de La Croix en verano: todos los días en julio y agosto + fines de semana en junio y septiembre (sujeto a las condiciones meteorológicas, con confirmación el jueves para el fin de semana).\r\nAcceso libre a pie por las rutas de senderismo."
            ]
          },
