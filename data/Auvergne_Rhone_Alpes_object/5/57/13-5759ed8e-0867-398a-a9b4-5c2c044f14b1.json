  "rdfs:comment": {
    "de": [
      "Nehmen Sie die Herausforderung des Triathlons in einer außergewöhnlichen natürlichen Umgebung an! Verschiedene Formate für alle Niveaus, von 6-jährigen Jugendlichen bis zu erfahrenen Erwachsenen. Schwimmen im Schwimmbad und Rad-/Laufstrecke. Sportliche Atmosphäre garantiert!"
    ],
    "en": [
      "Take up the triathlon challenge in an exceptional natural setting! Several formats for all levels, from 6-year-olds to experienced adults. Swimming in the pool and cycling/running courses. A sporting atmosphere guaranteed!"
    ],
    "it": [
      "Affrontate la sfida del triathlon in un contesto naturale eccezionale! Diversi formati adatti a tutti i livelli, dai bambini di 6 anni agli adulti esperti. Nuoto in piscina e ciclismo/corsa. Atmosfera sportiva garantita!"
    ],
    "fr": [
      "Relevez le défi du triathlon dans un cadre naturel exceptionnel ! Plusieurs formats pour tous les niveaux, des jeunes de 6 ans aux adultes confirmés. Natation en piscine et parcours vélo/course à pied. Ambiance sportive garantie !"
    ],
    "nl": [
      "Ga de triatlon uitdaging aan in een uitzonderlijke natuurlijke omgeving! Verschillende formules voor alle niveaus, van 6-jarigen tot ervaren volwassenen. Zwemmen in het zwembad en fietsen/lopen. Een sportieve sfeer gegarandeerd!"
    ],
    "es": [
      "Acepte el reto del triatlón en un entorno natural excepcional Varios formatos para todos los niveles, desde niños de 6 años hasta adultos experimentados. Natación en la piscina y ciclismo/carrera. Ambiente deportivo garantizado"
    ]
  },
  "rdfs:label": {
