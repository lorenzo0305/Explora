  "rdfs:comment": {
    "de": [
      "La Dolce Via, ein sanfter Weg in der Ardèche, den Sie auf sanfte Weise bis zu den Grenzen des Eyrieux und seines noch unberührten Tals entdecken können. 90 km ausgebauter und gesicherter Weg im Eyrieux-Tal."
    ],
    "en": [
      "La Dolce Via is a gentle trail in Ardèche taking you all the way to the banks of the RIver Eyrieux and its well-preserved valley. 90 km of safe greenway in the Eyrieux valley."
    ],
    "it": [
      "La Dolce Via, un percorso dolce attraverso l'Ardèche fino ai margini dell'Eyrieux e della sua valle incontaminata. 90 km di percorso sicuro e ben tracciato nella valle dell'Eyrieux."
    ],
    "fr": [
      "La Dolce Via, voie douce d'Ardèche à découvrir tout en douceur jusqu'aux confins de l'Eyrieux et de sa vallée encore préservée. 90 km de voie aménagée et sécurisée en vallée de l'Eyrieux."
    ],
    "es": [
      "La Dolce Via, una ruta suave por la Ardèche hasta el borde del Eyrieux y su valle virgen. 90 km de ruta segura y bien acondicionada en el valle de Eyrieux."
    ],
    "nl": [
      "De Dolce Via, een rustige route door de Ardèche naar de rand van de Eyrieux en zijn ongerepte vallei. 90 km veilige, goed aangelegde route in de vallei van de Eyrieux."
    ]
  },
  "rdfs:label": {
    "en": [
      "The Dolce Via from La Voulte sur Rhône to Lamastre"
    ],
    "fr": [
      "La Dolce Via de La Voulte sur Rhône à Lamastre"
    ]
  },
