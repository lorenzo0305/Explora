  "rdfs:comment": {
    "de": [
      "Schönes Hotel mit schlichtem, zeitgenössischem Dekor in ruhiger Lage. 10 Min. von der Ausfahrt Nr. 5 der A40, 15 Min. von Bourg-en-Bresse, TGV-Bahnhof, 1 Std. von Lyon St Exupéry entfernt. 30 klimatisierte Zimmer, Restaurant, Terrasse, 3 Seminarräume. Fitness, Schwimmbad, Wifi, Stromanschlüsse."
    ],
    "en": [
      "Beautiful hotel with clean, contemporary decor, in a quiet location. 10 min from exit 5 on A40, 15 min from Bourg-en-Bresse, TGV station, 1h from Lyon St Exupéry. 30 air-conditioned rooms, restaurant, terrace, 3 seminar rooms. fitness, swimming pool, Wifi, electricity terminals."
    ],
    "it": [
      "Bellissimo hotel dall'arredamento raffinato e contemporaneo, in posizione tranquilla. A 10 minuti dall'uscita 5 della A40, a 15 minuti da Bourg-en-Bresse, stazione TGV, a 1 ora da Lione St Exupéry. 30 camere climatizzate, ristorante, terrazza, 3 sale per seminari. fitness, piscina, Wifi, chioschi elettrici"
    ],
    "fr": [
      "Bel hôtel au décor épuré et contemporain, au calme. A 10 min de la sortie n° 5 sur A40, 15 min de Bourg-en-Bresse, gare TGV, à 1h de Lyon St Exupéry. 30 chambres climatisées, restaurant, terrasse, 3 salles de séminaires. fitness, piscine, Wifi,Bornes elec"
    ],
    "es": [
      "Precioso hotel con una decoración refinada y contemporánea, en una ubicación tranquila. A 10 minutos de la salida 5 de la A40, a 15 minutos de Bourg-en-Bresse, estación de TGV, a 1 hora de Lyon St Exupéry. 30 habitaciones climatizadas, restaurante, terraza, 3 salas de seminarios. fitness, piscina, Wifi, quioscos eléctricos"
    ],
    "nl": [
      "Mooi, eigentijds hotel in het hart van de Bresse, rustig gelegen, op 10 minuten van afrit 5 van de A40, op 15 minuten van Bourg en Bresse, het station, op 1 uur van Lyon. 31 kamers, een restaurant, een terras, een verwarmd binnenzwembad, een fitnesscentrum, gratis wifi."
    ]
  },
