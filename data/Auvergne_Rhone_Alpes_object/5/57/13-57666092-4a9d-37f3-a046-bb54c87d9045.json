  "rdfs:comment": {
    "de": [
      "Verkauf von Weinen im Einzelhandel, lose Ware, Bag in Box, Flaschen. Beratung, Verkostung. Monatliche Sonderangebote. Landweine aus den Côteaux de l'Ardèche. AOC Côtes du Vivarais. Verkauf von regionalen Produkten."
    ],
    "en": [
      "Retail sale of wines, bulk, bag in box, bottles. Advice, tasting. Monthly specials. Local wines from the Coteaux de l'Ardèche. AOC Côtes du Vivarais. Sale of regional products."
    ],
    "it": [
      "Vendita al dettaglio di vini, sfusi, bag in box, bottiglie. Consigli, degustazioni. Promozioni mensili. Vini locali dei côteaux de l'Ardèche. AOC Côtes du Vivarais. Vendita di prodotti regionali."
    ],
    "fr": [
      "Vente de vins au détail, vrac, bag in box, bouteilles. Conseils, dégustation. Promotions mensuelles. Vins de pays des côteaux de l'Ardèche. AOC côtes du Vivarais. Vente de produits régionaux."
    ],
    "es": [
      "Venta al por menor de vinos, a granel, bag in box, botellas. Consejos, degustación. Promociones mensuales. Vinos locales de los côteaux de l'Ardèche. AOC Côtes du Vivarais. Venta de productos regionales."
    ],
    "nl": [
      "Detailhandel in wijn, bag in box, flessen. Advies, proeverij. Maandelijkse promoties. Lokale wijnen van de hellingen van de Ardèche. AOC côtes du Vivarais. Verkoop van streekproducten."
    ]
  },
