  "rdfs:comment": {
    "de": [
      "Das Théâtre des Ïlets ist ein Ort des Lebens und der Kreativität im Herzen der Stadt, der für alle offen ist: Aufführungen, Theatrothèque- und Kinderbereiche, Praktika, Lesungen, Residenzen, Treffen mit Künstlern..."
    ],
    "en": [
      "The theater des Ïlets is a place of life and creation in the heart of the city open to all: shows, theatrical and children's spaces, training courses, readings, residencies, meetings with artists..."
    ],
    "it": [
      "Il Théâtre des Ïlets è un luogo di vita e di creazione nel cuore della città, aperto a tutti: spettacoli, biblioteca teatrale e spazi per bambini, corsi, letture, residenze, incontri con artisti, ecc."
    ],
    "fr": [
      "Le théâtre des Ïlets est un lieu de vie et de création au coeur de la ville ouvert à tous : spectacles, espaces théâtrothèque et enfants, stages, lectures, résidences, rencontres avec les artistes..."
    ],
    "nl": [
      "Het Théâtre des Ïlets is een plek van leven en creatie in het hart van de stad, open voor iedereen: voorstellingen, theaterbibliotheek en kinderruimtes, cursussen, lezingen, residenties, ontmoetingen met kunstenaars, enz."
    ],
    "es": [
      "El Théâtre des Ïlets es un lugar de vida y creación en el corazón de la ciudad, abierto a todos: espectáculos, biblioteca teatral y espacios infantiles, cursos, lecturas, residencias, encuentros con artistas, etc."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le théâtre des Îlets - Centre dramatique national de Montluçon"
    ]
  },
