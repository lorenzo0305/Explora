  "rdfs:comment": {
    "de": [
      "Das Hotel Bellevue empfängt Sie in einer ruhigen und entspannenden Bergkulisse im Herzen des kleinen Weinberg Ayze."
    ],
    "en": [
      "Situated in the heart of the small Ayze vineyard, the Bellevue Hotel offers a warm welcome in this quiet, restful mountain setting ."
    ],
    "it": [
      "Il Bellevue Hotel vi accoglie in un ambiente tranquillo di montagna e relax nel cuore del piccolo vigneto Ayze."
    ],
    "fr": [
      "L'hôtel Bellevue vous accueille chaleureusement dans un cadre de montagne calme et reposant au coeur du petit vignoble d'Ayze."
    ],
    "nl": [
      "Het Bellevue Hotel verwelkomt u in een rustige bergachtige omgeving en ontspannen in het hart van de kleine wijngaard Ayze."
    ],
    "es": [
      "El Bellevue Hotel le da la bienvenida en un lugar tranquilo y relajante de la montaña en el corazón de la pequeña viña Ayze."
    ]
  },
