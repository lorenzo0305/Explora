  "rdfs:comment": {
    "de": [
      "Besuchen Sie uns auf eigene Faust. Der Marktflecken entwickelte sich um ein Priorat mit cluniazensischer Gründung, das im 15. Jahrhundert verschwand."
    ],
    "en": [
      "Free visit. The village developed around a priory of Cluniac foundation which disappeared in the 15th century."
    ],
    "it": [
      "Visita gratuita. Il villaggio si è sviluppato attorno a un priorato di fondazione cluniacense, scomparso nel XV secolo."
    ],
    "fr": [
      "Visite libre. Le bourg s'est développé autour d'un prieuré de fondation clunisienne qui a disparu au XVe siècle."
    ],
    "es": [
      "Visita gratuita. El pueblo se desarrolló en torno a un priorato de fundación cluniacense que desapareció en el siglo XV."
    ],
    "nl": [
      "Gratis bezoek. Het dorp ontwikkelde zich rond een priorij van Cluniac-stichting die in de 15e eeuw verdween."
    ]
  },
