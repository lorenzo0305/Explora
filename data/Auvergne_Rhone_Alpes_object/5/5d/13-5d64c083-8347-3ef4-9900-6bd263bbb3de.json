  "rdfs:comment": {
    "de": [
      "Guten Tag an alle und an alle,\r\nIch biete Ihnen an, sich mir anzuschließen, um das wunderschöne Skigebiet von Val d'Isère Tignes zu entdecken, entweder mit Privatunterricht oder mit Gruppenunterricht für maximal 6 Personen.\r\nSpaß, Technik, Sensationen, Sicherheit!"
    ],
    "en": [
      "Hello everyone, \r\nI invite you to join me in discovering the magnificent Val d'Isère Tignes ski area with either private lessons or group lessons for a maximum of 6 people.\r\nFun, technique, thrills, safety!"
    ],
    "it": [
      "Buongiorno a tutti, \r\nvi invito a unirvi a me alla scoperta del magnifico comprensorio sciistico di Val d'Isère Tignes con lezioni private o collettive per un massimo di 6 persone.\r\nDivertimento, tecnica, emozioni, sicurezza!"
    ],
    "fr": [
      "Bonjour à tous et à toutes, \r\nJe vous propose de me rejoindre pour la découverte de ce magnifique domaine skiable de Val d'Isère Tignes avec soit des cours particuliers ou des cours collectifs maximum 6 personnes.\r\nPlaisirs, Technique, Sensations, Sécurité!"
    ],
    "es": [
      "Hola a todos\r\nOs invito a descubrir conmigo el magnífico dominio esquiable de Val d'Isère Tignes con clases particulares o en grupo para un máximo de 6 personas.\r\n¡Diversión, Técnica, Sensaciones, Seguridad!"
    ],
    "nl": [
      "Hallo allemaal,\r\nIk nodig je uit om samen met mij het prachtige skigebied Val d'Isère Tignes te ontdekken met privélessen of groepslessen voor maximaal 6 personen.\r\nPlezier, techniek, sensatie, veiligheid!"
    ]
  },
