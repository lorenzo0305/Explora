  "rdfs:comment": {
    "de": [
      "L'Echanson unumgänglicher Ort für eine Gourmet-Mahlzeit, warm und gemütlich mit einem Schwerpunkt auf der Region.\r\nRestaurant mit Tagesmenüs unter der Woche, Bistrokarte und -menü mit Produkten aus der Region, Weinkarte mit Weinen aus der Region.\r\nZum Entdecken!"
    ],
    "en": [
      "A place of conviviality with a focus on the region. Friendly restaurant offering daily menus, regional products, wine list and a selection of local products and local craft beers,"
    ],
    "it": [
      "L'Echanson è il posto giusto per un pasto gourmet caldo e accogliente con un'attenzione particolare alla regione.\r\nIl ristorante offre menù giornalieri durante la settimana, menù bistrot con prodotti regionali, carta dei vini locali.\r\nDa scoprire!"
    ],
    "fr": [
      "L'Echanson lieu incontournable pour un repas gourmand, chaleureux et convivial avec un accent sur la région. \r\nRestaurant proposant des menus du jour en semaine, carte et menu bistrot avec des produits de la région, carte des vins du terroir.\r\nA découvrir !"
    ],
    "es": [
      "L'Echanson es el lugar ideal para disfrutar de una comida gastronómica, cálida y acogedora centrada en la región.\r\nRestaurante que ofrece menús diarios durante la semana, menú de bistró con productos regionales, carta de vinos locales.\r\n¡A descubrir!"
    ],
    "nl": [
      "Bij L'Echanson kunt u terecht voor een gastronomische, warme en gezellige maaltijd met aandacht voor de streek.\r\nRestaurant met dagmenu's tijdens de week, bistromenu met streekproducten, lokale wijnkaart.\r\nTe ontdekken!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'Echanson"
    ]
  },
