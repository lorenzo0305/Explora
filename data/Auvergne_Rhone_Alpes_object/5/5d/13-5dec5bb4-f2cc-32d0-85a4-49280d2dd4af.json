  "rdfs:comment": {
    "de": [
      "Arnaud Bonnet, ein Grafikdesigner und Illustrator, der sich für eine lokale und verantwortungsvolle Produktion einsetzt, wirbt mit seinen Retro-Kreationen, die in Montluçon als Postkarten oder Poster gedruckt werden, für das Departement Allier."
    ],
    "en": [
      "Arnaud Bonnet, a graphic designer and illustrator committed to local, responsible production, promotes the Allier region through his retro creations, printed in Montluçon in the form of postcards and posters."
    ],
    "it": [
      "Arnaud Bonnet, grafico e illustratore impegnato in una produzione locale e responsabile, promuove la regione di Allier attraverso le sue creazioni retrò, stampate a Montluçon sotto forma di cartoline e poster."
    ],
    "fr": [
      "Arnaud Bonnet, graphiste et illustrateur engagé dans une démarche de production locale et responsable, fait la promotion de l’Allier par le biais de ses créations rétro imprimées à Montluçon sous forme de cartes postales ou d’affiches."
    ],
    "nl": [
      "Arnaud Bonnet, een grafisch ontwerper en illustrator die zich inzet voor lokale, verantwoorde productie, promoot de regio Allier met zijn retrocreaties, gedrukt in Montluçon in de vorm van ansichtkaarten en posters."
    ],
    "es": [
      "Arnaud Bonnet, diseñador gráfico e ilustrador comprometido con la producción local y responsable, promociona la región de Allier a través de sus creaciones retro, impresas en Montluçon en forma de postales y carteles."
    ]
  },
