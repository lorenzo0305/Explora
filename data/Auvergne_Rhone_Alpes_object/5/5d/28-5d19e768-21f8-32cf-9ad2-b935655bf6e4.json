  "rdfs:comment": {
    "de": [
      "Vez und das Valois, eines der wichtigsten Ländereien der französischen Könige. Vez war seine Hauptstadt und der Donjon einer der wichtigsten Orte seiner Geschichte. 1000 Jahre Kunst und Architektur, vom Mittelalter bis zur zeitgenössischen Kunst."
    ],
    "en": [
      "Vez and the Valois, one of the most important lands of the kings of France. Vez was its capital, and the Donjon, one of the most important places in its history. 1000 years of art and architecture, from the Middle Ages to contemporary art."
    ],
    "it": [
      "Vez e i Valois, una delle terre più importanti dei re di Francia. Vez era la sua capitale e il Donjon uno dei luoghi più importanti della sua storia. 1000 anni di arte e architettura, dal Medioevo all'arte contemporanea."
    ],
    "fr": [
      "Vez et le Valois, l’une des plus importantes terres des rois de France. Vez en fut la capitale, le Donjon, l’un des hauts lieux de son histoire. 1000 ans d’art et d’architecture, du Moyen-Âge à l’art contemporain."
    ],
    "es": [
      "Vez y los Valois, una de las tierras más importantes de los reyes de Francia. Vez fue su capital y el Donjon uno de los lugares más importantes de su historia. 1000 años de arte y arquitectura, desde la Edad Media hasta el arte contemporáneo."
    ],
    "nl": [
      "Vez en de Valois, een van de belangrijkste landen van de koningen van Frankrijk. Vez was de hoofdstad en de Donjon een van de belangrijkste plaatsen in de geschiedenis. 1000 jaar kunst en architectuur, van de middeleeuwen tot hedendaagse kunst."
    ]
  },
