  "rdfs:comment": {
    "de": [
      "Das Maison de la Mineralogie ist ein kleines Privatmuseum, das von einem leidenschaftlichen Mineralogie-Fan gegründet wurde und sich der Vielfalt und Unterschiedlichkeit der Mineralien des Zentralmassivs widmet."
    ],
    "en": [
      "The Maison de la Minéralogie is a small private museum, created by a mineralogy enthusiast, dedicated to the variety and diversity of minerals in the Massif Central."
    ],
    "it": [
      "La Maison de la Minéralogie è un piccolo museo privato, creato da un appassionato di mineralogia, dedicato alla varietà e alla diversità dei minerali del Massiccio Centrale."
    ],
    "fr": [
      "La maison de la minéralogie est un petit musée privé, créé par un passionné de minéralogie, consacré à la variété et à la diversité des minéraux du Massif-Central."
    ],
    "es": [
      "La Maison de la Minéralogie es un pequeño museo privado, creado por un aficionado a la mineralogía, dedicado a la variedad y diversidad de los minerales del Macizo Central."
    ],
    "nl": [
      "Het Maison de la Minéralogie is een klein privé-museum, opgericht door een liefhebber van mineralogie, gewijd aan de verscheidenheid en diversiteit van de mineralen in het Centraal Massief."
    ]
  },
  "rdfs:label": {
    "en": [
      "House of Mineralogy of the Massif Central"
    ],
    "fr": [
      "Maison de la Minéralogie du Massif-Central"
    ]
  },
