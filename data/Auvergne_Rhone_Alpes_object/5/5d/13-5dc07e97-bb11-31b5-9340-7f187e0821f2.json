  "rdfs:comment": {
    "de": [
      "Die Kirche Les Angelas in der Gemeinde Valbonnais (wo es bereits eine Kirche gibt) wurde 1882 von J. Riondet erbaut."
    ],
    "en": [
      "The church of Les Angelas, in Valbonnais (where there is also a church) has been built in 1882 by J Riondet."
    ],
    "it": [
      "La chiesa di Les Angelas, nel comune di Valbonnais (dove esiste già una chiesa), fu costruita nel 1882 da J. Riondet."
    ],
    "fr": [
      "L'église des Angelas, sur la commune de Valbonnais (où il y a déjà une église) a été construite en 1882 par J. Riondet."
    ],
    "es": [
      "La iglesia de Les Angelas, en el municipio de Valbonnais (donde ya hay una iglesia) fue construida en 1882 por J. Riondet."
    ],
    "nl": [
      "De kerk \" des Angelas\" in het dorp van de Valbonnais werd gebouwd in 1882 door J. riondet. . Een hele eenvoudige constructie met een eenvoudige boog ingang die uitgeeft op een driedelig schip. Een mengeling tussen de neo-romaanse et neo-gotische stijl."
    ]
  },
