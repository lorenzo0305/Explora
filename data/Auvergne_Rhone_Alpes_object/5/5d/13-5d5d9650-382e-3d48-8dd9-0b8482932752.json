  "rdfs:comment": {
    "de": [
      "Die Mediathek in Cusset lädt die Kleinsten und ihre Eltern zu einem gemütlichen Moment auf einem bequemen Geschichtenteppich mit der Erzählerin Christine Righi ein."
    ],
    "en": [
      "The Médiathèque de Cusset invites the very young and their parents to a sweet moment curled up on a comfortable story carpet with storyteller Christine Righi."
    ],
    "it": [
      "La Médiathèque di Cusset invita i più piccoli e i loro genitori a godersi un momento di dolcezza accoccolati su un comodo tappeto di storie con la narratrice Christine Righi."
    ],
    "fr": [
      "La Médiathèque de Cusset invite les tout petits et leurs parents à un grand moment de douceur lovés sur un confortable tapis à histoire avec la conteuse Christine Righi."
    ],
    "es": [
      "La Médiathèque de Cusset invita a los más pequeños y a sus padres a disfrutar de un momento de dulzura acurrucados en una cómoda alfombra de cuentos con la cuentacuentos Christine Righi."
    ],
    "nl": [
      "De Médiathèque in Cusset nodigt de allerkleinsten en hun ouders uit om te genieten van een zacht moment opgekruld op een comfortabel verteltapijt met verhalenvertelster Christine Righi."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Petites histoires pour petites mains"
    ]
  },
