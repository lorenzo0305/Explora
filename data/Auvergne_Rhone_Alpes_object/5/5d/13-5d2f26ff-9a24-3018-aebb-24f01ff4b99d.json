  "rdfs:comment": {
    "de": [
      "Der Club - Indoor Paintball, in der Nähe von Cusset und Vichy, bietet ein 650m² großes, überdachtes Feld, das Sie nach vorheriger Reservierung nutzen können. Ideal für ein einzigartiges Paintball-Erlebnis, bei jedem Wetter und zu jedem Anlass."
    ],
    "en": [
      "Le Club - Paintball Indoor, near Cusset and Vichy, offers a 650m² covered field with reservation. Ideal for a unique paintball experience, in all weathers and for all occasions."
    ],
    "it": [
      "Il Club - Paintball Indoor, vicino a Cusset e Vichy, offre un campo coperto di 650 m² che può essere prenotato in anticipo. Ideale per vivere un'esperienza di paintball unica, in qualsiasi condizione atmosferica e per tutte le occasioni."
    ],
    "fr": [
      "Le Club - Paintball Indoor, près de Cusset et Vichy, propose un terrain couvert de 650m² sur réservation. Idéal pour vivre une expérience unique du paintball, par tous les temps et pour toutes les occasions."
    ],
    "nl": [
      "The Club - Paintball Indoor, in de buurt van Cusset en Vichy, biedt een overdekt veld van 650 m² dat van tevoren gereserveerd kan worden. Ideaal voor een unieke paintballervaring, in alle weersomstandigheden en voor alle gelegenheden."
    ],
    "es": [
      "El Club - Paintball Indoor, cerca de Cusset y Vichy, ofrece un campo cubierto de 650 m² que puede reservarse con antelación. Ideal para vivir una experiencia de paintball única, con cualquier tiempo y para cualquier ocasión."
    ]
  },
