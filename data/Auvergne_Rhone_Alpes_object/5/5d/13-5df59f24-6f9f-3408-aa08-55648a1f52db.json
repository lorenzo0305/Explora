  "rdfs:comment": {
    "de": [
      "Die Festung Le Châtelard geht auf das 12. Jahrhundert zurück. Während des Praguerie-Aufstands im Jahr 1440 reiste der französische König Karl VII. in die Auvergne. Auf der Durchreise durch Ébreuil wohnte er zum ersten Mal in Le Châtelard. Besichtigung nur der Außenanlagen."
    ],
    "en": [
      "The fortress of Le Châtelard dates back to the 12th century. During the Praguerie revolt in 1440, King Charles VII of France came to Auvergne and, passing through Ébreuil, stayed at Le Châtelard for the first time. Visit of exteriors only."
    ],
    "it": [
      "La fortezza di Le Châtelard risale al XII secolo. Durante la rivolta della Praguerie del 1440, Carlo VII, re di Francia, visitò l'Alvernia e, passando per Ébreuil, soggiornò per la prima volta a Le Châtelard. Visita solo dell'esterno."
    ],
    "fr": [
      "La forteresse du Châtelard remonte au XIIe siècle. Lors de la révolte de la Praguerie, en 1440, le roi de France Charles VII se rend en Auvergne et, de passage à Ébreuil, il réside au Châtelard pour la première fois. Visite des extérieurs uniquement."
    ],
    "es": [
      "La fortaleza de Le Châtelard data del siglo XII. Durante la revuelta de Praguerie en 1440, Carlos VII, rey de Francia, visitó Auvernia y, pasando por Ébreuil, se alojó por primera vez en Le Châtelard. Visita sólo del exterior."
    ],
    "nl": [
      "Het fort van Le Châtelard dateert uit de 12e eeuw. Tijdens de opstand van de Praguerie in 1440 bezocht Karel VII, koning van Frankrijk, de Auvergne en via Ébreuil verbleef hij voor het eerst in Le Châtelard. Bezoek alleen de buitenkant."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Château du Châtelard"
    ]
