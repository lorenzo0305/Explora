  "rdfs:comment": {
    "de": [
      "Haben Sie Lust auf einen Gleitschirm-Schnupperflug im Vercors oder in der Chartreuse?!\r\nParapente Isère bietet Ihnen 3 Arten von Schnupperflügen in einem Tandem-Gleitschirm über dem Vercors (oder anderen Orten in Isère) an. Ab 35€ wird der Traum von Ikarus wahr!"
    ],
    "en": [
      "Are you tempted by a first flight in a paraglider on the Vercors or the Chartreuse?\r\nParapente Isère has 3 types of tandem paragliding first flights in the Vercors (or other sites in Isère). From €35, the dream of being Icarus becomes reality!"
    ],
    "it": [
      "Volete fare un primo volo in parapendio nel Vercors o nella Chartreuse?\r\nParapente Isère propone 3 tipi di primi voli in parapendio tandem nel Vercors (o in altri siti dell'Isère)\r\nA partire da € 35, il sogno di Icaro diventa realtà!"
    ],
    "fr": [
      "Un baptême en parapente sur le Vercors ou la Chartreuse, ça vous tente ?!\r\nParapente Isère vous propose 3 types de baptêmes de l’air en parapente biplace, sur le Vercors (ou autres sites en Isère)\r\nA partir de 35€, le rêve d’Icare devient réalité !"
    ],
    "es": [
      "¿Te apetece un primer vuelo en parapente en el Vercors o la Chartreuse?\r\nParapente Isère le propone 3 tipos de primeros vuelos en parapente biplaza en el Vercors (o en otros lugares de Isère)\r\nA partir de 35 euros, ¡el sueño de Ícaro se hace realidad!"
    ],
    "nl": [
      "Zin in een eerste paragliding vlucht in de Vercors of Chartreuse?\r\nParapente Isère biedt 3 soorten tandem paragliding eerste vluchten aan in de Vercors (of andere plaatsen in Isère)\r\nVanaf €35 wordt de droom van Icarus werkelijkheid!"
    ]
  },
