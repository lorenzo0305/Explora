  "rdfs:comment": {
    "de": [
      "Starten Sie an der Kirche und überqueren Sie den Fluss über die Vieux Pont. Gehen Sie unter der Straße hindurch über die Metallbrücke zum ersten Schild."
    ],
    "en": [
      "Start from the church and cross over the old bridge, go below the road via the metal  bridge and to the first information board."
    ],
    "it": [
      "Uscire dalla chiesa e attraversare il fiume dal Ponte Vecchio. Passare sotto la strada, vicino alla passerella metallica, e raggiungere il primo cartello."
    ],
    "fr": [
      "Départ de l’Eglise, traversez la rivière en empruntant le Vieux Pont. Passez sous la route par la passerelle métallique pour rejoindre le premier panneau."
    ],
    "nl": [
      "Steek vanaf de kerk de rivier over via de Oude Brug. Steek onder de weg door via de metalen voetgangersbrug om bij de eerste wegwijzer te komen."
    ],
    "es": [
      "Salga de la iglesia y cruce el río por el Puente Viejo. Pase por debajo de la carretera junto a la pasarela metálica para llegar a la primera señal."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le sentier du renard - Piste de ski de fond"
    ]
  },
