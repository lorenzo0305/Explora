  "rdfs:comment": {
    "de": [
      "NUR IM WINTER GEÖFFNET\r\nErleben Sie die Freuden des Schlittschuhlaufens auf der überdachten Außeneisbahn mit Tribünen. Im Winter werden Sie die Freuden des Eislaufens entdecken."
    ],
    "en": [
      "ONLY OPEN IN WINTER\r\nCome and experience the joys of ice skating on our covered outdoor rink, equipped with bleachers. In winter, discover the joys of ice skating."
    ],
    "it": [
      "APERTO SOLO IN INVERNO\r\nVenite a provare il piacere di pattinare sulla pista coperta all'aperto, dotata di gradinate. In inverno, scoprite le gioie del pattinaggio su ghiaccio."
    ],
    "fr": [
      "UNIQUEMENT OUVERTE L'HIVER\r\nVenez goûter aux joies du patinage sur la patinoire extérieure couverte, équipée de gradins. L'hiver, vous découvrirez les joies du patin sur glace."
    ],
    "nl": [
      "ALLEEN OPEN IN DE WINTER\r\nKom en ervaar het plezier van schaatsen op de overdekte buitenbaan met tribunes. Ontdek in de winter het plezier van schaatsen."
    ],
    "es": [
      "ABIERTA SÓLO EN INVIERNO\r\nDescubra el placer de patinar en la pista exterior cubierta y equipada con gradas. En invierno, descubra el placer de patinar sobre hielo."
    ]
  },
  "rdfs:label": {
    "en": [
