  "rdfs:comment": {
    "de": [
      "Marktküche mit frischen, saisonalen Produkten, die möglichst von lokalen Erzeugern stammen. Abwechslungsreiche, täglich wechselnde Speisekarte 4 Vorspeisen - 2 Hauptgerichte - 4 Desserts Vegetarische und vegane Optionen.\r\nGewölbter Innenraum, Außenterrasse unter den Arkaden."
    ],
    "en": [
      "Market cuisine, fresh and seasonal products most often from local trade. On the menu: choice of 4 starters, 3 main courses (fish, poultry, beef), 4 desserts."
    ],
    "it": [
      "Cucina di mercato, con prodotti freschi di stagione provenienti il più possibile da produttori locali. Menù vario che cambia ogni giorno - 4 antipasti - 2 piatti principali - 4 dessert - opzioni vegetariane e vegane.\r\nSala interna a volta, terrazza esterna sotto i portici."
    ],
    "fr": [
      "Cuisine du marché, des produits frais, de saison issus, au maximum, de producteurs locaux. Carte variée changeant chaque jours 4 entrées - 2 plats - 4 desserts option végétarienne et Vegan.\r\nSalle intérieure voûtée, terrasse extérieure sous les arcades."
    ],
    "nl": [
      "Keuken van de markt, verse en seizoen produkten, meestal van lokale handel. Mooie zaal met boog. 4 voorgerechten naar keuze - 3 hoofdgerechten (vis, kip, rund) - 4 desserten."
    ],
    "es": [
      "Cocina de mercado, con productos frescos de temporada procedentes, en la medida de lo posible, de productores locales. Menú variado que cambia a diario - 4 entrantes - 2 platos principales - 4 postres - opciones vegetarianas y veganas.\r\nSala interior abovedada, terraza exterior bajo los soportales."
    ]
  },
