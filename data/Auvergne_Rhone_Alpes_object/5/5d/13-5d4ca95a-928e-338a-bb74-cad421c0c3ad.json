  "rdfs:comment": {
    "de": [
      "Bauernhofproduktion vom Feld ... bis zur Mühle ... über das Huhn! Nudeln mit Kastanien, Nudeln mit Eiern, Nudeln mit Clairette, Nudeln mit Kakao, Nudeln mit Roggen, frische Nudeln, Dinkel-Nudeln, Kichererbsen, Weizenmehl, Roggenmehl."
    ],
    "en": [
      "Farmhouse production from the field ... to the mill ... via the hen! Chestnut pasta, egg pasta, Clairette pasta, cocoa pasta, rye pasta, fresh pasta, small spelt pasta, chickpea pasta, wheat flour, rye flour."
    ],
    "it": [
      "La produzione agricola dal campo... al mulino... passando per la gallina! Pasta di castagne, pasta all'uovo, pasta Clairette, pasta al cacao, pasta di segale, pasta fresca, piccola pasta di farro, pasta di ceci, farina di grano, farina di segale."
    ],
    "fr": [
      "Production fermière du champs ... au moulin ... en passant par la poule ! Pâtes à la châtaigne, pâtes aux œufs, pâtes à la Clairette, pâtes au cacao, pâtes au seigle, pâtes fraîches, pâtes petit épeautre, pois chiche, farine de blé, farine de seigle."
    ],
    "es": [
      "La producción agrícola del campo... al molino... ¡a través de la gallina! Pasta de castañas, pasta al huevo, pasta Clairette, pasta de cacao, pasta de centeno, pasta fresca, pasta de espelta pequeña, pasta de garbanzos, harina de trigo, harina de centeno."
    ],
    "nl": [
      "Boerderijproductie van het veld ... tot de molen ... via de kip! Kastanjepasta, eierpasta, Clairette pasta, cacaopasta, roggepasta, verse pasta, kleine speltpasta, kikkererwtenpasta, tarwemeel, roggemeel."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ferme du Grezou"
    ]
  },
