  "rdfs:comment": {
    "de": [
      "Laurence praktiziert seit 20 Jahren Yoga und unterrichtet es seit 2011. Sie ist Absolventin der Ecole Française de Yoga (EFY) und unterrichtet Energie-Yoga, Iyengar- und Ashtanga-Yoga, aber auch Yin-Yoga, um das Loslassen zu fördern."
    ],
    "en": [
      "Laurence has been practicing yoga for 20 years. She is a graduate of the French School of Yoga (EFY). Laurence's teaching is based on energy yoga, Iyengar yoga, Ashtanga yoga, but also on yin yoga based on letting go."
    ],
    "it": [
      "Laurence insegna yoga dal 2011. È diplomata all'Ecole Française de Yoga (EFY), garanzia di qualità dell'insegnamento dello yoga in Francia. Essendo bilingue, insegna sia in francese che in inglese, a seconda del pubblico."
    ],
    "fr": [
      "Laurence enseigne le yoga depuis 2011. Elle est diplômée de l'Ecole Française de Yoga (EFY) un gage de qualité dans l'enseignement du yoga en France. Etant bilingue, elle dispense ses cours aussi bien en français et qu'en anglais selon le public."
    ],
    "es": [
      "Laurence enseña yoga desde 2011. Es diplomada de la Escuela Francesa de Yoga (EFY), garantía de la calidad de la enseñanza del yoga en Francia. Como es bilingüe, enseña tanto en francés como en inglés, en función del público."
    ],
    "nl": [
      "Laurence beoefent al 20 jaar yoga en geeft er sinds 2011 les in. Zij is afgestudeerd aan de Ecole Française de Yoga (EFY) en geeft les in energie-yoga, Iyengar yoga en Ashtanga yoga, maar ook in yin yoga, voor een meer ontspannen aanpak."
    ]
  },
