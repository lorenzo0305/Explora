  "rdfs:comment": {
    "de": [
      "Im Herzen von Lyon bietet Ihnen dieses Restaurant eine Lyoner und traditionelle Küche an. Als kleiner Platz abseits des Trubels, ist die Terrasse während der Saison eine wahre Insel des Friedens."
    ],
    "en": [
      "Situated in the heart of Lyon, this restaurant proposes both Lyonnais and traditional cooking. Located in a small square away from hustle and bustle of the city, the terrace is a genuine haven of peace during the fine weather."
    ],
    "it": [
      "In pieno centro di Lione questo ristorante ti propone una cucina lionese e tradizionale. In una piazzetta appartata lontano dall'agitazione, i tavoli all'aperto nella bella stagione sono una vera oasi di pace."
    ],
    "fr": [
      "Au cœur de Lyon, ce restaurant vous propose une cuisine lyonnaise et traditionnelle. Sur une petite place à l’écart de l’agitation, la terrasse en saison est un véritable havre de paix."
    ],
    "nl": [
      "In het hart van Lyon biedt dit restaurant traditionele Lyonnaise gerechten. Op een pleintje, weg van de drukte, is het terras in het seizoen een echte oase van rust."
    ],
    "es": [
      "Este restaurante, situado en pleno corazón de Lyon, propone una cocina lionesa y tradicional. La terraza, dispuesta en una pequeña plaza alejada de la agitación cuando hace buen tiempo, es un auténtico remanso de paz."
    ]
  },
