  "rdfs:comment": {
    "de": [
      "Entdecke oder wiederentdecke den Orientierungslauf mit diesem Kinderparcours rund um das Thema \"Es war einmal der Wintersport\".\r\nMach dich mit deiner Karte auf die Suche nach den Markierungen, die dich auf die Spuren der Olympischen Winterspiele 1968 führen."
    ],
    "en": [
      "Discover or rediscover orienteering with this children's course based on a \"Once upon a time there were winter sports” theme.\r\nArmed with your map, go in search of the markers that will lead you to the route of the 1968 Winter Olympics."
    ],
    "it": [
      "Scoprite o riscoprite l'orienteering con questo corso per bambini basato sul tema \"C'erano una volta gli sport invernali\".\r\nArmati di mappa, andate alla ricerca dei marcatori che vi porteranno sulle tracce delle Olimpiadi invernali del 1968."
    ],
    "fr": [
      "Découvre ou redécouvre la course d'orientation avec ce parcours enfant autour de la thématique \" Il était une fois les sports d'hiver\".\r\nMuni de ta carte, pars à la recherche des balises qui t'emmèneront sur les traces des J.O d'hiver 1968."
    ],
    "nl": [
      "Ontdek of herontdek het oriëntatielopen met dit kinderparcours rond het thema \"Er was eens wintersport\".\r\nGewapend met uw kaart gaat u op zoek naar de markeringen die u op het spoor zetten van de Olympische Winterspelen van 1968."
    ],
    "es": [
      "Descubra o redescubra la orientación con este curso para niños basado en el tema \"Érase una vez los deportes de invierno\".\r\nArmado con su mapa, vaya en busca de los marcadores que le llevarán tras la pista de los Juegos Olímpicos de Invierno de 1968."
    ]
  },
  "rdfs:label": {
    "de": [
      "Orientierungslauf Kulturerbe für Kinder"
    ],
    "en": [
      "Children's heritage orienteering course"
    ],
    "fr": [
      "Parcours d'orientation patrimoine enfant"
    ]
  },
