  "rdfs:comment": {
    "de": [
      "Direktverkauf von Ziegenkäse von Mai bis Dezember im Weiler Samonod, mit Gemüse, Wein, Fruchtsäften, Eiern und Linsen."
    ],
    "en": [
      "Direct sale of farmhouse cheeses (goat and ewe) from May to December in the hamlet of Samonod, with vegetable, wine, fruit juice, egg and lentil depots."
    ],
    "it": [
      "Vendita diretta di formaggi di capra di fattoria da maggio a dicembre nella frazione di Samonod, con vendita di verdure, vino, succhi di frutta, uova e lenticchie."
    ],
    "fr": [
      "Vente  directe de fromages  fermiers de chèvres  de Mai à Décembre sur le hameau de Samonod, avec dépôt de légumes, vins, jus de fruits, œufs et lentilles ."
    ],
    "es": [
      "Venta directa de quesos de cabra de granja de mayo a diciembre en la aldea de Samonod, con venta de verduras, vino, zumos de frutas, huevos y lentejas."
    ],
    "nl": [
      "Directe verkoop van boerengeitenkaas van mei tot december in het gehucht Samonod, met een voorraad groenten, wijn, vruchtensap, eieren en linzen."
    ]
  },
