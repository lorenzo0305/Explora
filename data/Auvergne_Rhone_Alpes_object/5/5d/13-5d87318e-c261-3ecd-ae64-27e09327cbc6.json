  "rdfs:comment": {
    "de": [
      "Die ACCA von Saint-Martin-en-Vercors vereint die Jäger des Dorfes und verspricht eine verantwortungsvolle Jagd sowie den Erhalt von Fauna und Flora. Ihr Ziel ist es, über die Arten zu wachen und die Wege und Übergänge in den Bergen instand zu halten."
    ],
    "en": [
      "The ACCA de Saint-Martin-en-Vercors brings together the village's hunters and promises responsible hunting and the preservation of flora and fauna. Their aim is to look after species and maintain mountain paths and passages."
    ],
    "it": [
      "L'ACCA di Saint-Martin-en-Vercors riunisce i cacciatori del villaggio e promette una caccia responsabile e la conservazione della flora e della fauna. Il loro obiettivo è la cura delle specie e la manutenzione dei sentieri e dei passaggi in montagna."
    ],
    "fr": [
      "L'ACCA de Saint-Martin-en-Vercors  regroupe les chasseurs du village et promet une chasse responsable ainsi qu'une préservation de la faune et de la flore. Leur but est de veiller sur les espèces et entretenir les chemins et passages en montagnes."
    ],
    "es": [
      "La ACCA de Saint-Martin-en-Vercors reúne a los cazadores del pueblo y promete una caza responsable, así como la preservación de la flora y la fauna. Su objetivo es cuidar las especies y mantener los senderos y pasos de montaña."
    ],
    "nl": [
      "De ACCA van Saint-Martin-en-Vercors verenigt de jagers van het dorp en belooft een verantwoorde jacht en het behoud van de flora en fauna. Hun doel is om de diersoorten te beschermen en de paden en doorgangen in de bergen te onderhouden."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Association communale de chasse agréé"
    ]
  },
