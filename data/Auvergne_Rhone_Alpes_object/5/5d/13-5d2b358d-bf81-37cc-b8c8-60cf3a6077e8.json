  "rdfs:comment": {
    "de": [
      "Der Verein Samoëns Handi-Glisse hat sich zum Ziel gesetzt, Behindertensportmaterial zu erwerben und zu warten und es Menschen mit Behinderungen kostenlos zur Verfügung zu stellen. Außerdem beteiligt er sich an der Ausbildung von Piloten auf Tandem, Uni, Dual und Cimgo."
    ],
    "en": [
      "The Samoëns Handi-Glisse association aims to acquire and maintain handisport equipment and make it available free of charge to people with disabilities. It also participates in pilot training on Tandem, Uni, Dual and Cimgo."
    ],
    "it": [
      "L'associazione Samoëns Handi-Glisse si propone di acquistare e mantenere attrezzature sportive per disabili e di metterle gratuitamente a disposizione delle persone con disabilità. Partecipa inoltre alla formazione dei piloti di Tandem, Uni, Dual e Cimgo."
    ],
    "fr": [
      "L'association Samoëns Handi-Glisse a pour but d'acquérir et d'entretenir du matériel handisport et de le mettre gratuitement à disposition de personnes en situation de handicap. Elle participe aussi à la formation de pilote sur Tandem, Uni, Dual et Cimgo."
    ],
    "es": [
      "La asociación Samoëns Handi-Glisse tiene como objetivo adquirir y mantener material deportivo para discapacitados y ponerlo gratuitamente a disposición de las personas con discapacidad. También participa en la formación de pilotos en Tándem, Uni, Dual y Cimgo."
    ],
    "nl": [
      "De vereniging Samoëns Handi-Glisse heeft als doel gehandicapte sporttoestellen aan te schaffen, te onderhouden en gratis ter beschikking te stellen aan mensen met een handicap. De vereniging neemt ook deel aan piloottrainingen op de Tandem, Uni, Dual en Cimgo."
    ]
  },
  "rdfs:label": {
    "en": [
      "Samoëns Handi-Glisse: Parasports in the mountains!"
    ],
    "fr": [
      "Samoëns Handi-Glisse : Le handisport au cœur des montagnes !"
    ],
    "nl": [
      "Samoëns Handi-Glisse: Gehandicaptensport in het hart van de bergen!"
    ]
  },
