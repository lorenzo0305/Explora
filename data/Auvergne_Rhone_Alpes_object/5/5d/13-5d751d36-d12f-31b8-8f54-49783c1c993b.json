  "rdfs:comment": {
    "de": [
      "Das gesamte Team unseres Restaurants erwartet Sie in seinem ruhigen und gemütlichen Rahmen, um Sie an den Reichtümern der indischen Küche teilhaben zu lassen."
    ],
    "en": [
      "The whole team of our restaurant awaits you in its calm and warm setting to share with you the richness of Indian cuisine."
    ],
    "it": [
      "L'intero team del nostro ristorante vi aspetta in un ambiente calmo e accogliente per condividere con voi la ricchezza della cucina indiana."
    ],
    "fr": [
      "Toute l’équipe de notre restaurant vous attends au sein de son cadre calme et chaleureux pour vous faire partager les richesses de la cuisine indienne."
    ],
    "es": [
      "Todo el equipo de nuestro restaurante le espera en su entorno tranquilo y cálido para compartir con usted la riqueza de la cocina india."
    ],
    "nl": [
      "Het hele team van ons restaurant wacht op je in de rustige en warme omgeving om de rijkdom van de Indiase keuken met je te delen."
    ]
  },
