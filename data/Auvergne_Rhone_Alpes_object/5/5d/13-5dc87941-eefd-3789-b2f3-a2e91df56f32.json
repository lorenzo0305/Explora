  "rdfs:comment": {
    "de": [
      "Im Herzen des Landes der Pierres Dorées liegt die Domaine de Baluce in Bagnols auf einem Südhügel des Beaujolais. So bieten wir Ihnen ein umfassendes Angebot an authentischen und feinen Weinen.\nBis bald!"
    ],
    "en": [
      "At the foot of the Château de Bagnols (12th century); Warm welcome with a visit to the cellars and the vat room. Old oak tuns in two vaulted cellars, the house in golden stone surrounded by 7.80 ha of vines."
    ],
    "it": [
      "Nel cuore della regione delle Pierres Dorées, il Domaine de Baluce si trova a Bagnols, sul versante meridionale del Beaujolais. Offriamo una gamma completa di vini pregiati e autentici.\nSaremo lieti di incontrarvi presto!"
    ],
    "fr": [
      "Au cœur du pays des Pierres Dorées, le domaine de Baluce se situe à Bagnols sur un côteau Sud du Beaujolais. Ainsi, nous vous proposons une gamme complète de vins authentiques et fins.\nA très vite !"
    ],
    "nl": [
      "In het hart van de regio Pierres Dorées ligt Domaine de Baluce in Bagnols op de zuidelijke hellingen van de Beaujolais. Wij bieden een volledig assortiment van fijne, authentieke wijnen.\nWe kijken uit naar uw komst!"
    ],
    "es": [
      "En el corazón de la región de Pierres Dorées, el Domaine de Baluce está situado en Bagnols, en la vertiente sur del Beaujolais. Ofrecemos una gama completa de vinos finos y auténticos.\n¡Le esperamos!"
    ]
  },
