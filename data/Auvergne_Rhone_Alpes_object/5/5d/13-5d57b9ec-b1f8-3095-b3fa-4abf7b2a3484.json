  "rdfs:comment": {
    "de": [
      "Hören Sie das Ensemble Terracanto, das aus etwa 50 Chorsängern und einem Instrumentalisten besteht und in Saint-Etienne beheimatet ist.\r\nDer Titel des Programms, das aufgeführt wird, lautet: \"La Misa Tango\"."
    ],
    "en": [
      "Come and listen to the Terracanto ensemble, made up of some 50 choristers and an instrumentalist, based in Saint-Etienne.\r\nThe title of the program to be performed is \"La Misa Tango\"."
    ],
    "it": [
      "Venite ad ascoltare l'ensemble Terracanto, composto da una cinquantina di coristi e uno strumentista, con sede a Saint-Etienne.\r\nIl titolo del programma che verrà eseguito è \"La Misa Tango\"."
    ],
    "fr": [
      "Venez écouter l'ensemble Terracanto composée d'une cinquantaine de choristes et d'un instrumentiste, domiciliée à Saint-Etienne. \r\nLe titre du programme qui sera interprété est le suivant : \"La Misa Tango\"."
    ],
    "es": [
      "Venga a escuchar al conjunto Terracanto, formado por unos cincuenta coralistas y un instrumentista, con sede en Saint-Etienne.\r\nEl título del programa que interpretarán es \"La Misa Tango\"."
    ],
    "nl": [
      "Kom luisteren naar het Terracanto ensemble, bestaande uit een vijftigtal koorleden en een instrumentalist, gevestigd in Saint-Etienne.\r\nDe titel van het uit te voeren programma is \"La Misa Tango\"."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Concert Chorale de l'ensemble Terracanto"
    ]
  },
