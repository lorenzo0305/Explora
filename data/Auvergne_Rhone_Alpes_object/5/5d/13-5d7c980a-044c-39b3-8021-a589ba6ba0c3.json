  "rdfs:comment": {
    "de": [
      "Die Klippe von Lierre ist für Kletterfans ein geselliger Ort, der für alle Niveaus geeignet ist. Vor Ort wird keine professionelle Betreuung angeboten."
    ],
    "en": [
      "The Falaise de Lierre (\"Ivy cliff\") is a friendly spot all amateurs of climbing, whether beginners or experienced. No professional supervision. 25 to 40 metre high routes. Difficulty from 3 to 7a. Belaying : 55 metres. Limestone rock. Cliff located in the hamlet of Haut Somont. Car park in Ruffieux."
    ],
    "it": [
      "La falesia di Lierre è uno spazio accogliente per gli appassionati di arrampicata ed è adatta a tutti i livelli. Non viene offerta alcuna supervisione professionale in loco."
    ],
    "fr": [
      "La falaise de Lierre est pour les amateurs d'escalade un espace convivial et adapté à tous les niveaux. Aucun encadrement professionnel n'est proposé sur place."
    ],
    "es": [
      "El acantilado de Lierre es un espacio acogedor para los aficionados a la escalada y es apto para todos los niveles. No se ofrece supervisión profesional in situ."
    ],
    "nl": [
      "De grot van Lierre is een vriendelijke plek voor klimliefhebbers van alle niveaus. Er is geen professionele begeleiding ter plaatse."
    ]
  },
  "rdfs:label": {
    "en": [
      "Climbing Spot \"La Falaise de Lierre\""
    ],
    "fr": [
      "Site d'escalade La Falaise de Lierre"
    ],
    "nl": [
      "De klimsite van La Falaise de Lierre"
    ]
  },
