  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/25c40822-9a15-3849-ab23-8284331b01d7",
      "dc:description": {
        "de": [
          "Vom 23. Oktober bis zum 7. November 2021\n\nJe nach Verfügbarkeit\nDer Parc Equestre bietet Ponykurse (ab 2 Jahren), Reitunterricht für alle Niveaus, Ausritte für alle Niveaus, Verleih von Ponys in der Hand, Turnierkurse, Praktika mit Galoppprüfung (jede Woche, Montag bis Samstag von 9 bis 12 Uhr)"
        ],
        "en": [
          "October 23 to November 7, 2021\n\nSubject to availability\nThe Equestrian Park offers pony lessons (from 2 years old), horseback riding lessons for all levels, horseback rides for all levels, pony rental, competition lessons, courses with galops (every week, Monday to Saturday, 9am to 12pm)"
        ],
        "it": [
          "Dal 23 ottobre al 7 novembre 2021\n\nIn base alla disponibilità\nIl Parco Equestre offre lezioni di pony (a partire dai 2 anni), lezioni di equitazione per tutti i livelli, passeggiate a cavallo per tutti i livelli, noleggio di pony, lezioni di gara, corsi con galop (ogni settimana, dal lunedì al sabato dalle 9 alle 12)"
        ],
        "fr": [
          "Du 23 octobre au 7 novembre 2021\n\nEn fonction des disponibilités\nLe Parc Equestre propose des cours de poneys (à partir de 2 ans), des cours à cheval tous niveaux, des balades à cheval tous niveaux, de la location de poneys en main, des cours de compétition, des stages avec passage de galops (chaque semaine, du lundi au samedi de 9h à 12h)"
        ],
        "nl": [
          "Van 23 oktober tot 7 november 2021\n\nAfhankelijk van beschikbaarheid\nHet ruiterpark biedt ponylessen (vanaf 2 jaar), paardrijlessen voor alle niveaus, buitenritten voor alle niveaus, ponyverhuur, wedstrijdlessen, cursussen met galops (elke week, maandag t/m zaterdag van 9.00 tot 12.00 uur)"
        ],
        "es": [
          "Del 23 de octubre al 7 de noviembre de 2021\n\nSegún disponibilidad\nEl Parque Ecuestre ofrece clases de poni (a partir de 2 años), clases de equitación para todos los niveles, paseos a caballo para todos los niveles, alquiler de ponis, clases de competición, cursos con galopes (todas las semanas, de lunes a sábado de 9:00 a 12:00)"
        ]
      },
