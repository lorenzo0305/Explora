  "rdfs:comment": {
    "de": [
      "Zugelassener Minigolfplatz mit 18 Bahnen, schattiger Parcours umgeben von Grün, Bänke, klimatisiertes Schwimmbad, Campingplatz, Spielplatz, Tennisplätze in der Nähe, sowie Paddle und City-Stadion."
    ],
    "en": [
      "Approved mini-golf with 18 runs, shaded course surrounded by greenery, benches, air-conditioned swimming pool, campsite, playground, tennis courts nearby, as well as paddle and city stadium."
    ],
    "it": [
      "Campo da minigolf omologato a 18 corsie, percorso ombreggiato e circondato dal verde, panchine, piscina climatizzata, campeggio, parco giochi, campi da tennis nelle vicinanze, nonché paddle e stadio cittadino."
    ],
    "fr": [
      "Mini-golf homologué composé de 18 pistes, parcours ombragé entouré de verdure, bancs, piscine climatisée, camping, aire de jeux, terrains de tennis à proximité, ainsi que paddle et city stade."
    ],
    "nl": [
      "Goedgekeurde midgetgolfbaan met 18 banen, schaduwrijke baan omringd door groen, bankjes, zwembad met airconditioning, camping, speeltuin, tennisbanen in de buurt, evenals paddle- en stadsstadion."
    ],
    "es": [
      "Campo de minigolf homologado de 18 calles, recorrido sombreado rodeado de vegetación, bancos, piscina climatizada, camping, parque infantil, pistas de tenis en las inmediaciones, así como de pádel y estadio municipal."
    ]
  },
