  "rdfs:comment": {
    "de": [
      "Hier können Sie Bücher lesen oder ausleihen, aber auch Ausstellungen sehen, die alle zwei Monate wechseln. Es ist auch ein Ort der Kultur, der Begegnung und des Austauschs."
    ],
    "en": [
      "You can consult or borrow books but also see exhibitions that change every two months. It is also a place of culture, meetings and sharing."
    ],
    "it": [
      "È possibile consultare o prendere in prestito libri, ma anche vedere mostre che cambiano ogni due mesi. È anche un luogo di cultura, incontro e condivisione."
    ],
    "fr": [
      "Vous pouvez consulter ou emprunter des livres mais aussi, voir des expositions qui changent tous les deux mois. C'est aussi un lieu de culture, de rencontres et de partage."
    ],
    "nl": [
      "U kunt boeken raadplegen of lenen, maar ook tentoonstellingen bekijken die om de twee maanden veranderen. Het is ook een plek voor cultuur, ontmoeting en uitwisseling."
    ],
    "es": [
      "Puede consultar o tomar prestados libros, pero también ver exposiciones que cambian cada dos meses. También es un lugar para la cultura, el encuentro y el intercambio."
    ]
  },
