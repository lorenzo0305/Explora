  "rdfs:comment": {
    "de": [
      "Willkommen in der schiefen Sanduhr!\r\nIm Laden finden Sie eine große Auswahl an Tees und Kräutertees der Marke Ta Tea Tam aus Dieulefitoise, und im Teesalon einen gemütlichen und warmen Ort, an dem Sie ein Getränk mit hausgemachtem Gebäck genießen können."
    ],
    "en": [
      "Welcome to Le sablier penché!\r\nOn the store side, a wide selection of teas and infusions from Dieulefit's Ta Tea Tam brand, and on the tearoom side a cosy, warm place to relax and enjoy a drink accompanied by a homemade pastry."
    ],
    "it": [
      "Benvenuti a Le sablier penché!\r\nIl negozio offre un'ampia gamma di tè e infusi del marchio Dieulefit Ta Tea Tam e la sala da tè è un luogo accogliente e caldo dove rilassarsi e gustare una bevanda accompagnata da un pasticcino fatto in casa."
    ],
    "fr": [
      "Bienvenue au sablier penché !\r\nCôté boutique un grand choix de thés et d'infusions de la marque Dieulefitoise Ta Tea Tam, et côté salon de thé un endroit cosy et chaleureux où vous poser pour déguster une boisson accompagnée d'une pâtisserie maison."
    ],
    "es": [
      "¡Bienvenido a Le sablier penché!\r\nLa tienda ofrece una amplia gama de tés e infusiones de la marca Dieulefit Ta Tea Tam, y el salón de té es un lugar acogedor y cálido para relajarse y disfrutar de una bebida acompañada de un pastel casero."
    ],
    "nl": [
      "Welkom bij Le sablier penché!\r\nDe winkel biedt een breed assortiment theeën en infusies van het merk Ta Tea Tam uit Dieulefit, en de theesalon is een gezellige, warme plek om te ontspannen en te genieten van een drankje met een huisgemaakt gebakje."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Sablier Penché"
    ]
  },
