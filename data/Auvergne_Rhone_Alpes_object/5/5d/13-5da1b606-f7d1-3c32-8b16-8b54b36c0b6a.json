  "rdfs:comment": {
    "de": [
      "Auf 1030 m Höhe, 2 km von der Skistation Chalmazel entfernt, produzieren Marie Agnès und René Plagne Fourme de Montbrison fermière AOP, St Augustin, Crottin, Tomme Des Jasseries."
    ],
    "en": [
      "At an elevation of 1,030 metres, 2kms from the ski resort of Chalmazel, Marie Agnès and René Plagne make traditional PDO Fourme de Montbrison cheese.\r\nFarm visits available during the school holidays."
    ],
    "it": [
      "A 1030 m di altitudine, a 2 km dalla stazione sciistica di Chalmazel, Marie Agnès e René Plagne producono l'agriturismo DOP Fourme de Montbrison, St Augustin, Crottin e Tomme Des Jasseries."
    ],
    "fr": [
      "A 1030 m d’altitude, à 2 kms de la station de ski de Chalmazel, Marie Agnès et René Plagne produisent de la fourme de Montbrison fermière AOP., St Augustin,  Crottin,  Tomme Des Jasseries."
    ],
    "nl": [
      "Op 1030 m hoogte, op 2 km van het skigebied van Chalmazel, produceren Marie Agnès en René Plagne hun boerderij met BOB Fourme de Montbrison, St Augustin, Crottin en Tomme Des Jasseries."
    ],
    "es": [
      "A 1030 m de altitud, a 2 km de la estación de esquí de Chalmazel, Marie Agnès y René Plagne producen en la granja DOP Fourme de Montbrison, St Augustin, Crottin y Tomme Des Jasseries."
    ]
  },
