  "rdfs:comment": {
    "de": [
      "Diesen Sommer geht es auf 2000 m Höhe!\r\nDer Sessellift von Haut-Fleury ist den ganzen Sommer über für Spaziergänger und Wanderer zugänglich.\r\nBergauf, bergab oder beides - Sie haben die Wahl! Zahlreiche Wanderrouten ab der Pointe du Haut-Fleury und eine spektakuläre Aussicht."
    ],
    "en": [
      "Head for 2000 m this summer!\r\nThe Haut-Fleury chairlift is open all summer to walkers and hikers.\r\nUp / down, both or your choice! Plenty of hiking itineraries from the Pointe du Haut-Fleury and spectacular views."
    ],
    "it": [
      "Quest'estate, andate a 2000 m!\r\nLa seggiovia Haut-Fleury è aperta tutta l'estate a escursionisti e camminatori.\r\nA voi la scelta: salita, discesa o entrambe! Numerosi percorsi escursionistici con partenza dalla Pointe du Haut-Fleury e viste spettacolari."
    ],
    "fr": [
      "Cet été, cap sur les 2000 m d'altitude!\r\nLe télésiège du Haut-Fleury accessible tout l'été aux promeneurs et randonneurs.\r\nMontée ou descente ou les deux, au choix ! Plein d'itinéraires rando au départ de la Pointe du Haut-Fleury et une vue spectaculaire."
    ],
    "nl": [
      "Ga deze zomer naar 2000 m!\r\nDe stoeltjeslift van Haut-Fleury is de hele zomer geopend voor wandelaars.\r\nOmhoog, omlaag, allebei of naar keuze! Volop wandelroutes vanaf de Pointe du Haut-Fleury en spectaculaire uitzichten."
    ],
    "es": [
      "Este verano, suba a 2000 m\r\nEl telesilla de Haut-Fleury está abierto todo el verano a senderistas y excursionistas.\r\nUsted elige: subir, bajar o ambas cosas Numerosas rutas de senderismo que parten de la Pointe du Haut-Fleury y vistas espectaculares."
    ]
  },
