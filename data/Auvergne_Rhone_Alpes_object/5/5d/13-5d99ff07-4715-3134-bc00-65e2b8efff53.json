  "rdfs:comment": {
    "de": [
      "Manon Lescaut und Des Grieux: Das mythische Paar der Literatur wird auf der Opernbühne wieder zum Leben erweckt. Puccinis perfekter Erfolg, blitzartig schön."
    ],
    "en": [
      "Manon Lescaut and Des Grieux: the legendary couple from literature is brought to the stage. A stunningly beautiful success by Puccini."
    ],
    "it": [
      "Manon Lescaut e Des Grieux: la leggendaria coppia letteraria rivive sul palcoscenico dell'opera. Un perfetto successo pucciniano, abbagliante nella sua bellezza."
    ],
    "fr": [
      "Manon Lescaut et Des Grieux : le couple mythique de la littérature reprend vie sur la scène de l’opéra. Une parfaite réussite de Puccini, foudroyante de beauté."
    ],
    "es": [
      "Manon Lescaut y Des Grieux: la legendaria pareja literaria revive en el escenario de la ópera. Un éxito perfecto de Puccini, deslumbrante por su belleza."
    ],
    "nl": [
      "Manon Lescaut en Des Grieux: het legendarische literaire koppel komt weer tot leven op het operapodium. Een perfect Puccini-succes, oogverblindend mooi."
    ]
  },
