  "rdfs:comment": {
    "de": [
      "Während einer außergewöhnlichen Nacht öffnet La Piscine kostenlos seine Türen für einen magischen Abend.\n\nAnlässlich der Ausgabe 2026 wird La Piscine im Rhythmus von La Redoute und dem rasanten Abenteuer der Mode vibrieren!"
    ],
    "en": [
      "On a special night, La Piscine opens its doors free of charge for a magical evening.\n\nFor the 2026 edition, La Piscine will be vibrating to the rhythm of La Redoute and the unbridled adventure of fashion!"
    ],
    "it": [
      "La Piscine apre le sue porte gratuitamente per una serata magica.\n\nPer l'edizione 2026, La Piscine vibrerà al ritmo di La Redoute e dell'avventura sfrenata della moda!"
    ],
    "fr": [
      "Lors d’une nocturne exceptionnelle, La Piscine vous ouvre ses portes gratuitement pour une soirée magique.\n\nÀ l'occasion de l'édition 2026, La Piscine vibrera au rythme de La Redoute et de l'aventure effrénée de la mode !"
    ],
    "nl": [
      "La Piscine opent haar deuren gratis voor een magische avond.\n\nVoor de editie van 2026 zal La Piscine trillen op het ritme van La Redoute en het ongebreidelde avontuur van de mode!"
    ],
    "es": [
      "La Piscine abre sus puertas gratuitamente para una velada mágica.\n\nPara la edición de 2026, La Piscine vibrará al ritmo de La Redoute y de la aventura desenfrenada de la moda"
    ]
  },
