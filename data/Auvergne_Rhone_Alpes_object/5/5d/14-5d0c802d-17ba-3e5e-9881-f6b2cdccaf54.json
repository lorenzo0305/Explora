  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/c57ec61c-628b-35b6-be30-da8657091ddf",
      "dc:description": {
        "de": [
          "Spezialist für elektronische Zigaretten seit 2013.\n\n- Elektronische Zigaretten\n- Zubehör\n- Verbrauchsmaterial\n- Personalisierung\n- Ratschläge von einem Fachmann\n\nÖffnungszeiten: Montag bis Samstag von 9:30 bis 19:00 Uhr durchgehend.\nSonntags geschlossen."
        ],
        "en": [
          "Electronic Cigarette Specialist since 2013.\n\n- Electronic Cigarettes\n- Accessories\n- Consumables\n- Personalization\n- Professional advice\n\nOpening hours: Monday to Saturday, 9:30am to 7:00pm non-stop.\nClosed on Sundays."
        ],
        "it": [
          "Specialista in sigarette elettroniche dal 2013.\n\n- Sigarette elettroniche\n- Accessori per sigarette elettroniche\n- Materiali di consumo\n- Personalizzazione\n- Consulenza professionale\n\nOrari di apertura: dal lunedì al sabato dalle 9.30 alle 19.00 ininterrottamente.\nChiuso la domenica."
        ],
        "fr": [
          "Spécialiste de la Cigarette Electronique depuis 2013.\n\n- Cigarettes Electronique\n- Accessoires\n- Consommables\n- Personnalisation\n- Conseils d'un professionnel\n\nLes horaires d'ouverture : du lundi au samedi de 9h30 à 19h00 non stop.\nFermé le dimanche."
        ],
        "nl": [
          "Specialist in elektronische sigaretten sinds 2013.\n\n- Elektronische sigaretten\n- Accessoires\n- Verbruiksartikelen\n- Maatwerk\n- Professioneel advies\n\nOpeningstijden: maandag tot zaterdag van 9.30 tot 19.00 non-stop.\nGesloten op zondag."
        ],
        "es": [
          "Especialista en cigarrillos electrónicos desde 2013.\n\n- Cigarrillos electrónicos\n- Accesorios\n- Consumibles\n- Personalización\n- Asesoramiento profesional\n\nHorario de apertura: de lunes a sábado de 9.30 a 19.00 horas ininterrumpidamente.\nDomingos cerrado."
        ]
      },
