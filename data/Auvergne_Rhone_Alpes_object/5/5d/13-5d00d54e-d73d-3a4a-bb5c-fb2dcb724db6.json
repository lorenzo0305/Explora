  "rdfs:comment": {
    "de": [
      "Dieser Uhrenturm - so wird er seit dem 18. Jahrhundert genannt - stammt in Wirklichkeit aus dem 15. Jahrhundert und hatte im Laufe der Geschichte verschiedene Verwendungszwecke."
    ],
    "en": [
      "This clock tower - thus named from the 18th century - actually dates back to the 15th century, and over the course of history has had different purposes."
    ],
    "it": [
      "Questa torre dell'orologio, così chiamata a partire dal XVIII secolo, risale in realtà al XV secolo e ha avuto diverse funzioni nel corso della storia."
    ],
    "fr": [
      "Cette tour de l’horloge - ainsi nommée à partir du 18e siècle - date en réalité du 15e siècle et a eu, au fil de l’histoire, différentes utilités."
    ],
    "es": [
      "Esta torre del reloj -así llamada a partir del siglo XVIII- data en realidad del siglo XV y ha tenido diferentes usos a lo largo de los años."
    ],
    "nl": [
      "Deze klokkentoren - zo genoemd vanaf de 18e eeuw - dateert eigenlijk uit de 15e eeuw en heeft in de loop der jaren verschillende doelen gediend."
    ]
  },
