  "rdfs:comment": {
    "de": [
      "Im 13. Jahrhundert wiederaufgebaute Kirche.\r\nDie Fassade wurde 2007 renoviert.\r\nEs scheint eine enge Verbindung zwischen der Kirche und der Säule im Inneren des Dorfrestaurants (Restaurant la Colonne) zu geben."
    ],
    "en": [
      "Church rebuilt in the 13th century.\r\nRenovation of the façade in 2007.\r\nThere seems to be a close link between the church and the column inside the village restaurant (restaurant la Colonne)."
    ],
    "it": [
      "Chiesa ricostruita nel XIII secolo.\r\nRistrutturazione della facciata nel 2007.\r\nSembra esserci uno stretto legame tra la chiesa e la colonna all'interno del ristorante del villaggio (ristorante la Colonne)."
    ],
    "fr": [
      "Eglise reconstruite au XIIIè siècle.\r\nRénovation de la façade en 2007.\r\nIl semblerait qu'il y ai un lien étroit entre l'église et la colonne à l'intérieur du restaurant du village (restaurant la Colonne)."
    ],
    "nl": [
      "Kerk herbouwd in de 13e eeuw.\r\nRenovatie van de gevel in 2007.\r\nEr lijkt een nauwe band te bestaan tussen de kerk en de zuil in het dorpsrestaurant (restaurant la Colonne)."
    ],
    "es": [
      "Iglesia reconstruida en el siglo XIII.\r\nRenovación de la fachada en 2007.\r\nParece haber un estrecho vínculo entre la iglesia y la columna del restaurante del pueblo (restaurante la Colonne)."
    ]
  },
