  "rdfs:comment": {
    "de": [
      "Nachdem sie für große Juwelierhäuser am Place Vendôme gearbeitet hatte, beschloss Coline Chamignon, ihre Boutique im Herzen ihrer Heimatstadt Montluçon zu eröffnen."
    ],
    "en": [
      "After working for leading jewelry houses in Place Vendôme, Coline Chamignon decided to open her own boutique in the heart of her home town: Montluçon."
    ],
    "it": [
      "Dopo aver lavorato per alcune delle più importanti case di gioielleria di Place Vendôme, Coline Chamignon ha deciso di aprire la sua boutique nel cuore della sua città natale, Montluçon."
    ],
    "fr": [
      "Après avoir travaillé pour de grandes maisons de joaillerie place Vendôme, Coline Chamignon a décidé d’ouvrir sa boutique en plein coeur de sa ville natale : Montluçon."
    ],
    "nl": [
      "Na gewerkt te hebben voor een aantal vooraanstaande juweliershuizen op de Place Vendôme, besloot Coline Chamignon haar eigen boetiek te openen in het hart van haar woonplaats Montluçon."
    ],
    "es": [
      "Después de trabajar para algunas de las mejores casas de joyería de la Place Vendôme, Coline Chamignon decidió abrir su propia boutique en el corazón de su ciudad natal, Montluçon."
    ]
  },
