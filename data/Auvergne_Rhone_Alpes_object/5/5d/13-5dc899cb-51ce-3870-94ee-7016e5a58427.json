  "rdfs:comment": {
    "de": [
      "In ihrem Atelier im Herzen des Waldes modelliert und dreht Cécile Steingut und Porzellan, um symbolische Tiere und Hybridwesen zwischen Mensch und Tier entstehen zu lassen."
    ],
    "en": [
      "In her studio in the heart of the forest, Cécile models and turns stoneware and porcelain to create symbolic animals and hybrids between man and beast."
    ],
    "it": [
      "Nel suo studio nel cuore della foresta, Cécile modella e trasforma l'argilla e la porcellana in gres per creare animali simbolici e ibridi tra uomini e animali."
    ],
    "fr": [
      "Dans son atelier au cœur de la forêt, Cécile modèle et tourne la terre à grès et la porcelaine pour faire naître des animaux symboliques et des êtres hybrides entre homme et animal."
    ],
    "nl": [
      "In haar atelier in het hart van het bos boetseert en draait Cécile steengoed klei en porselein om symbolische dieren en hybriden tussen mens en dier te creëren."
    ],
    "es": [
      "En su estudio, en el corazón del bosque, Cécile modela y tornea arcilla de gres y porcelana para crear animales simbólicos e híbridos entre humanos y animales."
    ]
  },
  "rdfs:label": {
