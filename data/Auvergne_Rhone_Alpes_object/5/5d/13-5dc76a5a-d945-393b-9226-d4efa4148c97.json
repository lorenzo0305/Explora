  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Gefühl und die Freude am Fahren auf einer 700 Meter langen, beleuchteten Freiluftpiste. Auf dem Gelände finden Sie außerdem einen Imbiss, einen Bouleplatz und eine Minigolfanlage, ein Schwimmbad."
    ],
    "en": [
      "Make the most of the karting activities, as a family, among friends or as a couple, over more than 700 m of open-air track. For those who are feeling less energetic, the swimming pool is at your disposal."
    ],
    "it": [
      "Venite a scoprire le emozioni e i brividi della guida su una pista all'aperto di 700 metri, veloce e tecnica, con riflettori. Troverete anche uno snack bar, un campo da bocce, un campo da minigolf e una piscina."
    ],
    "fr": [
      "Venez découvrir les sensations et le plaisir du pilotage sur une piste rapide et technique de 700 m, en plein air et éclairée. Vous trouverez également sur le site un snack, un terrain de pétanque et un mini-golf, piscine."
    ],
    "nl": [
      "Verhuur van karts voor volwassen en kinderen. Baan van 700 m in de open lucht en verlicht."
    ],
    "es": [
      "Descubra la emoción de conducir en una pista rápida y técnica de 700 metros al aire libre y con iluminación. También encontrarás un snack bar, un campo de petanca, un minigolf y una piscina."
    ]
  },
