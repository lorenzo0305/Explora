  "rdfs:comment": {
    "de": [
      "Ailes des Aravis, eine Gleitschirmschule in La Clusaz, bietet im Sommer und Winter Tandemflüge an. Starten Sie zu Fuß oder auf Skiern und erleben Sie einzigartige Eindrücke im Herzen der Aravis."
    ],
    "en": [
      "Ailes des Aravis, paragliding school in La Clusaz, offers two-seater flights in summer and winter. Take off on foot or on skis and experience unique sensations in the heart of the Aravis mountains."
    ],
    "it": [
      "Ailes des Aravis, una scuola di parapendio a La Clusaz, offre voli biposto sia in estate che in inverno. Decollate a piedi o con gli sci e provate sensazioni uniche nel cuore delle montagne degli Aravis."
    ],
    "fr": [
      "Ailes des Aravis, école de parapente à La Clusaz, propose des vols biplaces été comme hiver. Décollez à pied ou à ski et vivez des sensations uniques au coeur des Aravis."
    ],
    "es": [
      "Ailes des Aravis, escuela de parapente de La Clusaz, ofrece vuelos biplaza tanto en verano como en invierno. Despegue a pie o con esquís y experimente sensaciones únicas en el corazón de los montes Aravis."
    ],
    "nl": [
      "Ailes des Aravis, een paraglidingschool in La Clusaz, biedt zowel in de zomer als in de winter tweezitsvluchten aan. Stijg te voet of op ski's op en ervaar unieke sensaties in het hart van het Aravis-gebergte."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ailes des Aravis"
    ]
  },
