  "rdfs:comment": {
    "de": [
      "Das Conservatoire à Rayonnement Départemental André Messager bietet 900 Schülern von der Vorschule (ab 5 Jahren) bis zur Berufsvorbereitung einen spezialisierten Vokal- und Instrumentalunterricht sowie Schauspiel an."
    ],
    "en": [
      "The Conservatoire à Rayonnement Départemental André Messager offers specialized vocal and instrumental teaching, as well as dramatic arts, to 900 students from kindergarten (from age 5) to the pre-professional cycle."
    ],
    "it": [
      "Il Conservatoire à Rayonnement Départemental André Messager offre un insegnamento specializzato di canto e strumento, oltre che di teatro, a 900 allievi dalla scuola materna (dai 5 anni) al ciclo pre-professionale."
    ],
    "fr": [
      "Le Conservatoire à Rayonnement Départemental André Messager propose un enseignement spécialisé vocal et instrumental, ainsi que l'art dramatique auprès de 900 élèves de la grande section de maternelle (à partir de 5 ans) au cycle préprofessionnel."
    ],
    "nl": [
      "Het Conservatoire à Rayonnement Départemental André Messager biedt gespecialiseerd zang- en instrumentaal onderwijs en drama aan 900 leerlingen vanaf de kleuterschool (vanaf 5 jaar) tot aan de preprofessionele cyclus."
    ],
    "es": [
      "El Conservatoire à Rayonnement Départemental André Messager ofrece enseñanza vocal e instrumental especializada, así como teatro, a 900 alumnos desde el parvulario (a partir de los 5 años) hasta el ciclo preprofesional."
    ]
  },
