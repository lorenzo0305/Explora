  "rdfs:comment": {
    "de": [
      "Die Kapelle Saint-Antoine wurde im 14. Jahrhundert auf den Grundmauern einer alten, Saint-Marcellin geweihten Kirche errichtet. Im Inneren befindet sich eine Skulptur von Saint-Antoine und seinem berühmten Schwein."
    ],
    "en": [
      "The Saint-Antoine chapel was built in the 14th century on the foundations of an earlier church dedicated to Saint-Marcellin. Inside, sculpture of Saint-Antoine and his famous pig."
    ],
    "it": [
      "La cappella di Saint-Antoine fu costruita nel XIV secolo sulle fondamenta di una precedente chiesa dedicata a Saint-Marcellin. All'interno si trova una scultura di Saint-Antoine e del suo famoso maiale."
    ],
    "fr": [
      "La chapelle Saint-Antoine fut construite au 14ème siècle sur les bases d'une ancienne église dédiée à Saint-Marcellin. A l'intérieur, sculpture de Saint-Antoine et son célèbre cochon."
    ],
    "es": [
      "La capilla de Saint-Antoine se construyó en el siglo XIV sobre los cimientos de una iglesia anterior dedicada a Saint-Marcellin. En su interior hay una escultura de Saint-Antoine y su famoso cerdo."
    ],
    "nl": [
      "De kapel Saint-Antoine werd in de 14e eeuw gebouwd op de fundamenten van een eerdere kerk gewijd aan Saint-Marcellin. Binnen staat een beeld van Saint-Antoine en zijn beroemde varken."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Chapelle Saint-Antoine"
    ]
  },
