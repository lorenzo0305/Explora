  "rdfs:comment": {
    "de": [
      "Le Local steht für den Wunsch, sich (Ihnen) mit handwerklich hergestellten Schnellgerichten und Produkten von lokalen Partnern eine Freude zu machen. Es ist auch eine lebhafte Bar am Abend."
    ],
    "en": [
      "Le Local is all about indulging yourself with home-made fast food and products from local partners. It's also a lively bar in the evening."
    ],
    "it": [
      "Le Local è un luogo in cui ci si può deliziare con fast food tradizionali e prodotti di partner locali. La sera è anche un bar vivace."
    ],
    "fr": [
      "Le Local, c'est la volonté de se (vous) faire plaisir avec de la restauration rapide artisanale et des produits issus de partenaires locaux. C'est aussi un bar animé le soir."
    ],
    "es": [
      "Le Local es un lugar para darse un capricho con comida rápida tradicional y productos de socios locales. También es un animado bar por las noches."
    ],
    "nl": [
      "In Le Local kun je jezelf verwennen met traditionele fastfood en producten van lokale partners. S Avonds is het ook een levendige bar."
    ]
  },
