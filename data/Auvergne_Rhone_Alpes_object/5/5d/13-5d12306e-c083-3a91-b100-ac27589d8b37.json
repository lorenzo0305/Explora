  "rdfs:comment": {
    "de": [
      "Zwischen atemberaubenden Panoramen und der Gastfreundschaft der Auvergne werden garantiert Emotionen inmitten einer geschützten und außergewöhnlichen Naturlandschaft geteilt."
    ],
    "en": [
      "Between breathtaking panoramas and Auvergne conviviality, sharing of emotions guaranteed in the heart of a preserved and exceptional natural site."
    ],
    "it": [
      "Tra panorami mozzafiato e convivialità alverniate, condivisione di emozioni garantita nel cuore di un sito naturale eccezionale e preservato."
    ],
    "fr": [
      "Entre panoramas époustouflants et convivialité auvergnate, partage d’émotions garanti au cœur d’un site naturel préservé et exceptionnel."
    ],
    "nl": [
      "Tussen adembenemende panorama's en gezelligheid in de Auvergne, het delen van emoties gegarandeerd in het hart van een uitzonderlijk beschermd natuurgebied."
    ],
    "es": [
      "Entre impresionantes panoramas y la convivencia de Auvernia, el intercambio de emociones está garantizado en el corazón de un sitio natural excepcional y preservado."
    ]
  },
