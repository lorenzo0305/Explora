      "@id": "https://data.datatourisme.fr/0311e417-662b-32bf-a831-e2da75cfbc27",
      "dc:description": {
        "de": [
          "Informationen :\n\nÖffnungszeiten:\nMontag bis Samstag von 7:00 bis 12:30 Uhr und von 13:30 bis 19:00 Uhr, Sonntag von 7:30 bis 12:30 Uhr.\n \n Abholung:\nZu den Öffnungszeiten des Geschäfts\n\n "
        ],
        "en": [
          "Information :\n\nOpening days:\nMonday to Saturday 7am to 12:30pm and 1:30pm to 7pm, Sunday 7:30am to 12:30pm.\n \n Pick-up:\nDuring store opening hours\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura:\nDal lunedì al sabato dalle 7.00 alle 12.30 e dalle 13.30 alle 19.00, domenica dalle 7.30 alle 12.30.\n \n Ritiro:\nDurante gli orari di apertura del negozio\n\n "
        ],
        "fr": [
          "Informations :\n\nJours d'ouverture : \nDu lundi au samedi de 7h à 12h30 et de 13h30 à 19h, le dimanche de 7h30 à 12h30.\n \n Retrait :\nAux horaires d'ouverture du magasin\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen:\nMaandag t/m zaterdag van 7.00 tot 12.30 uur en van 13.30 tot 19.00 uur, zondag van 7.30 tot 12.30 uur.\n \n Ophalen:\nTijdens openingstijden van de winkel\n\n "
        ],
        "es": [
          "Más información :\n\nHorario de apertura:\nDe lunes a sábado, de 7.00 a 12.30 h. y de 13.30 a 19.00 h.; domingos, de 7.30 a 12.30 h.\n \n Recogida:\nDurante el horario de apertura de la tienda\n\n "
        ]
      },
