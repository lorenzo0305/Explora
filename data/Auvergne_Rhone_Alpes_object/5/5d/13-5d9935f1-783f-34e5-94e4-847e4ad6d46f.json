  "rdfs:comment": {
    "de": [
      "Eingebettet im Herzen der Alpen bietet My Spa Pure Altitude 350 m², die ganz der Entspannung gewidmet sind. In einem zeitgenössischen und einzigartigen Ambiente können Sie einen Entspannungsraum mit Kräutertee, 2 Saunen und Hammams genießen. Massagen und Leistungen à la carte."
    ],
    "en": [
      "Nestled in the heart of the Alps, My Spa Pure Altitude offers 350 m² entirely dedicated to relaxation. In a unique, contemporary setting, you'll enjoy a relaxation room with herbal tea room, 2 saunas and steam rooms. Massages and à la carte services."
    ],
    "it": [
      "Immersa nel cuore delle Alpi, la My Spa Pure Altitude offre 350 m² interamente dedicati al relax. In un ambiente unico e contemporaneo, potrete godere di una sala relax con tisaneria, 2 saune e sale vapore. Massaggi e servizi à la carte."
    ],
    "fr": [
      "Niché au coeur des Alpes, My Spa Pure Altitude propose 350 m² entièrement dédiés à la détente. Dans une ambiance contemporaine et unique, vous profiterez d'une salle de relaxation avec tisanerie, 2 saunas et hammams. Massages et prestations à la carte."
    ],
    "nl": [
      "My Spa Pure Altitude ligt in het hart van de Alpen en biedt 350 m² volledig gewijd aan ontspanning. In een unieke, eigentijdse omgeving geniet je van een ontspanningsruimte met kruidenthee, 2 sauna's en stoombaden. Massages en à la carte diensten."
    ],
    "es": [
      "En el corazón de los Alpes, My Spa Pure Altitude ofrece 350 m² dedicados por completo a la relajación. En un entorno único y contemporáneo, disfrutará de una sala de relajación con tisanería, 2 saunas y baños de vapor. Masajes y servicios a la carta."
    ]
  },
  "rdfs:label": {
