  "rdfs:comment": {
    "de": [
      "Mit zwei Sälen mit 228 und 71 Plätzen bietet das Kino sowohl Arthouse-Filme als auch große Produktionen. Alle 14 Tage wird ein neues Programm angeboten. Das gesamte Programm finden Sie auf der Website www.cineode.fr/cine7"
    ],
    "en": [
      "With 2 cinemas, 228 and 71 seats, the cinema offers both Art et Essai films and big productions. A new program is offered every 15 days. You can find all the program on the website www.cineode.fr/cine7"
    ],
    "it": [
      "Con 2 sale da 228 e 71 posti, il cinema offre sia film d'essai che grandi produzioni. Ogni 15 giorni viene proposto un nuovo programma. L'intero programma è disponibile sul sito web www.cineode.fr/cine7"
    ],
    "fr": [
      "Avec 2 salles, de 228 et 71 places, le cinéma propose à la fois des films Art et Essai et des grosses productions. Un nouveau programme est proposé tous les 15 jours. Retrouvez toute la programmation sur le site internet www.cineode.fr/cine7"
    ],
    "nl": [
      "Met 2 zalen, 228 en 71 stoelen, biedt de bioscoop zowel arthousefilms als grote producties. Elke 15 dagen wordt een nieuw programma aangeboden. Het volledige programma is te vinden op de website www.cineode.fr/cine7"
    ],
    "es": [
      "Con 2 salas, de 228 y 71 plazas, el cine ofrece tanto películas de autor como grandes producciones. Cada 15 días se ofrece un nuevo programa. Puede encontrar el programa completo en el sitio web www.cineode.fr/cine7"
    ]
  },
