  "rdfs:comment": {
    "de": [
      "Dieser Saal befindet sich im Stadtzentrum und besteht aus einer Bühne. Er ist ideal für die Organisation von Konferenzen und Generalversammlungen! Nur für Vereine aus Roanne."
    ],
    "en": [
      "Located in the center of town, with a stage, this hall is ideal for conferences and general meetings! For local associations only."
    ],
    "it": [
      "Situata nel centro della città, con un palco, questa sala è ideale per organizzare conferenze e riunioni generali! Solo per le associazioni locali."
    ],
    "fr": [
      "Située en centre-ville, et composée d'une scène, cette salle est idéale pour l'organisation de conférences et d'assemblées générales ! Uniquement pour les associations roannaises."
    ],
    "es": [
      "Situada en el centro de la ciudad, con un escenario, esta sala es ideal para organizar conferencias y reuniones generales Sólo para asociaciones locales."
