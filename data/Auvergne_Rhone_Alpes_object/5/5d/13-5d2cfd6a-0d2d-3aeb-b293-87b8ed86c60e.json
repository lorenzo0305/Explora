  "rdfs:comment": {
    "de": [
      "Als Fotograf und Storyteller für Verliebte und wandernde Seelen schlage ich Ihnen vor, Ihren Aufenthalt im Trièves zu nutzen, um sich ein Fotoshooting inmitten der Natur zu gönnen. Ob mit der Familie, als Paar oder allein, behalten Sie unvergessliche Erinnerungen ..."
    ],
    "en": [
      "As a photographer and storyteller for lovers and wanderers, I'd like to take advantage of your stay in the Trièves to offer you a photo shoot in the heart of nature. Whether you're a family, a couple or a solo traveler, you'll have unforgettable memories ..."
    ],
    "it": [
      "Fotografo e narratore per amanti e girovaghi, vi suggerisco di approfittare del vostro soggiorno nel Trièves per regalarvi un servizio fotografico nel cuore della natura. In famiglia, in coppia o da soli, conservate ricordi indimenticabili..."
    ],
    "fr": [
      "Photographe et storyteller pour les amoureux et les âmes vagabondes, je vous propose de profiter de votre séjour dans le Trièves pour vous offrir une séance photos en pleine nature. En famille, en couple ou solo, gardez des souvenirs inoubliables ..."
    ],
    "nl": [
      "Fotograaf en verhalenverteller voor liefhebbers en zwervers, ik stel voor dat je van je verblijf in de Trièves profiteert om jezelf te trakteren op een fotoshoot in het hart van de natuur. Met je gezin, met z'n tweeën of alleen, bewaar onvergetelijke herinneringen ..."
    ],
    "es": [
      "Fotógrafo y cuentacuentos para enamorados y trotamundos, le propongo que aproveche su estancia en las Trièves para regalarse una sesión de fotos en plena naturaleza. En familia, en pareja o solo, guarde recuerdos inolvidables..."
    ]
  },
  "rdfs:label": {
