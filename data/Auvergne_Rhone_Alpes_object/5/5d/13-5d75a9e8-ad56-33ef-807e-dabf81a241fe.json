  "rdfs:comment": {
    "de": [
      "Es wird viel gelacht, Zutaten werden gemischt, Geduld, Ausdauer, Spaß und am Ende die Belohnung, die Verkostung."
    ],
    "en": [
      "Make your child's birthday as if you were making a cake as a family, with lots of laughter, mixing ingredients, patience, perseverance, lots of fun and finally the reward, the taste."
    ],
    "it": [
      "Preparate il compleanno del vostro bambino come se steste preparando una torta in famiglia, con tante risate, mescolando gli ingredienti, pazienza, perseveranza, tanto divertimento e infine la ricompensa, il gusto."
    ],
    "fr": [
      "Fabriquez l’anniversaire de votre enfant comme si vous fabriquiez un gâteau en famille, des éclats de rires, des mélanges d’ingrédients, de la patience, de la persévérance, beaucoup d’amusement et au final la récompense, la dégustation."
    ],
    "es": [
      "Prepare el cumpleaños de su hijo como si estuviera haciendo una tarta en familia, con muchas risas, mezclando ingredientes, paciencia, perseverancia, mucha diversión y finalmente la recompensa, el sabor."
    ],
    "nl": [
      "Maak de verjaardag van uw kind alsof u als gezin een taart maakt, met veel gelach, het mengen van ingrediënten, geduld, doorzettingsvermogen, veel plezier en uiteindelijk de beloning, de smaak."
    ]
  },
  "rdfs:label": {
