  "rdfs:comment": {
    "de": [
      "Stimmungsvolle Bar im Savoyer Stil: Cocktails, große Auswahl an Bier, hausgemachter Croque Monsieur...\r\nBowling, special bumper (System für Kinder und Anfänger) Spielhalle: Billard, Flipper, Arcade-Spiele."
    ],
    "en": [
      "Savoyard-style bar: cocktails, wide choice of beer, home-made croque monsieur, etc.\r\nBowling, special bumper (system for children), games room: billiards, pinball, arcade games."
    ],
    "it": [
      "Bar in stile savoiardo: cocktail, ampia scelta di birre, croque monsieur fatti in casa, ecc.\r\nBowling, bumper speciale (sistema per bambini e principianti) sala giochi: biliardo, flipper, giochi arcade."
    ],
    "fr": [
      "Bar ambiance à la déco savoyarde : cocktail, large choix de bière, croque monsieur maison...\r\nBowling, special bumper (système pour les enfants et débutants) salle de jeux :  billard, flipper, jeux d’Arcade."
    ],
    "nl": [
      "Bar met Savoyaardse inrichting: cocktails, ruime keuze aan bier, huisgemaakte croque monsieur, enz.\r\nBowling, speciale bumper (systeem voor kinderen), speelzaal: biljart, flipperkast, arcadespellen."
    ],
    "es": [
      "Bar de estilo saboyano: cócteles, amplia selección de cervezas, croque monsieur casero, etc.\r\nBowling, parachoques especial (sistema para niños y principiantes) sala de juegos: billar, pinball, juegos de arcade."
    ]
  },
