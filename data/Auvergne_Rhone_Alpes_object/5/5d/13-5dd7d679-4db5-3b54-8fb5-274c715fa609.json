  "rdfs:comment": {
    "de": [
      "Willkommen auf der Route des fromages AOP d'Auvergne, die für jede Etappe mit Schildern ausgeschildert ist.\r\nBesuchen Sie Bauernhöfe und Käsereien.\r\nMehr als dreißig Etappen, die über die Departements Puy-de-Dôme und Cantal verteilt sind, öffnen das ganze Jahr über ihre Türen."
    ],
    "en": [
      "Visit farms and cheese dairies... More than thirty stops spread over Puy-de-Dôme and Cantal open their doors all year round."
    ],
    "it": [
      "Benvenuti sulla Strada dei formaggi DOP dell'Alvernia, segnalata in ogni tappa.\r\nVisitate le fattorie e i caseifici.\r\nPiù di trenta tappe nelle regioni del Puy-de-Dôme e del Cantal sono aperte tutto l'anno."
    ],
    "fr": [
      "Bienvenue sur la Route des fromages AOP d'Auvergne, balisée pour chaque étape avec des panneaux signalétiques.\r\nVisite de fermes et de fromageries.\r\nPlus d'une trentaine d'étapes réparties sur le Puy-de-Dôme et le Cantal, ouvrent leurs portes toute l'année."
    ],
    "es": [
      "Bienvenido a la Ruta del Queso DOP de Auvernia, señalizada en cada etapa.\r\nVisite granjas y queserías.\r\nMás de treinta paradas en las regiones de Puy-de-Dôme y Cantal están abiertas todo el año."
    ],
    "nl": [
      "Bezoek aan de boerderijen en de kaasmakerijen ….. Een veertigtal routes in de Puy-de-Dôme en de Cantal. Het hele jaar open."
    ]
  },
  "rdfs:label": {
    "en": [
      "The P.D.O. cheese tour"
    ],
    "fr": [
      "La Route des Fromages AOP d'Auvergne"
    ],
    "nl": [
      "De route van de AOP kazen uit de Auvergne"
    ]
  },
