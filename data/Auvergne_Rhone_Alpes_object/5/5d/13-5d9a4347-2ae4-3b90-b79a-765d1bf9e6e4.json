  "rdfs:comment": {
    "de": [
      "Im Herzen des Dorfes Habère-Poche empfängt Sie das Team des Fremdenverkehrsamtes das ganze Jahr über und hilft Ihnen bei der Organisation Ihres Aufenthalts, Ihres Wochenendes oder Ihres Tages."
    ],
    "en": [
      "At the center of Habère-Poche, in the Alpes du Léman area, the tourist office welcomes you all year around."
    ],
    "it": [
      "Nel cuore del villaggio di Habère-Poche, il team dell'Ufficio del Turismo vi accoglie tutto l'anno e vi aiuta a organizzare il vostro soggiorno, il vostro weekend o la vostra giornata."
    ],
    "fr": [
      "Au cœur du village d'Habère-Poche  l'équipe  de l'Office de Tourisme vous accueille toute l'année et vous accompagne pour l'organisation de votre séjour, de votre week-end, de votre journée."
    ],
    "nl": [
      "In het hart van het dorp Habère-Poche ontvangt het team van het VVV-kantoor u het hele jaar door en helpt u bij het organiseren van uw verblijf, uw weekend of uw dag."
    ],
    "es": [
      "En el corazón del pueblo de Habère-Poche, el equipo de la Oficina de Turismo le acoge todo el año y le ayuda a organizar su estancia, su fin de semana o su jornada."
    ]
  },
