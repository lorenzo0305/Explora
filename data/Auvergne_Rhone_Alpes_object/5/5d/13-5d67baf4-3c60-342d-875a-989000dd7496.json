  "rdfs:comment": {
    "de": [
      "Der Natursportplatz La Stèle liegt auf 1250 bis 1450 m Höhe und ist ein Ort für Naturerlebnisse in allen vier Jahreszeiten (Langlauf, Schneeschuhwandern, Rodeln, Radfahren, Ski-Rollen, Inline-Skaten, Roller, Draisine, Wandern, Orientierungslauf usw.)."
    ],
    "en": [
      "The La Stèle nature sports area, located between 1250 and 1450 m altitude, is a 4-season site for outdoor activities (cross-country skiing, snowshoeing, tobogganing, cycling, ski-wheeling, rollerblading, scootering, walking, orienteering, etc.)."
    ],
    "it": [
      "L'area sportiva naturale di La Stèle, situata a un'altitudine compresa tra i 1250 e i 1450 m, è un sito di attività all'aperto per 4 stagioni (sci di fondo, racchette da neve, slittino, ciclismo, sci-alpinismo, pattini a rotelle, monopattino, passeggiate, orienteering, ecc.)"
    ],
    "fr": [
      "L'espace sport nature de la Stèle, situé entre 1250 et 1450 m d'altitude, est un site de pratique pleine nature 4 saisons  (ski de fond, raquettes, luge, vélo, ski-roue, rollers, trottinette, draisienne, randonnées, course d'orientation…)."
    ],
    "es": [
      "La zona deportiva natural de La Stèle, situada entre 1250 y 1450 m de altitud, es un lugar de actividades al aire libre durante las 4 estaciones del año (esquí de fondo, raquetas de nieve, trineos, ciclismo, esquí de fondo, patinaje, scooter, senderismo, orientación, etc.)."
    ],
    "nl": [
      "Het natuursportgebied La Stèle, gelegen op een hoogte tussen 1250 en 1450 m, is een plek voor outdooractiviteiten in 4 seizoenen (langlaufen, sneeuwschoenwandelen, sleeën, fietsen, skiën, skeeleren, steppen, wandelen, oriëntatielopen, enz.)"
    ]
  },
