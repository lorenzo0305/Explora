  "rdfs:comment": {
    "de": [
      "Bar, Brasserie, Pizzéria am Fuße der Pisten, mit einer großen und schönen Terrasse und einer Sonnenterrasse, die den ganzen Tag über sonnig sind.\r\nDurchgehender Service von 11 Uhr bis 21.30 Uhr, 7 Tage die Woche"
    ],
    "en": [
      "Bar, Brasserie, Pizzeria at the foot of the slopes, with a large, beautiful terrace and sunny solarium all day long.\nContinuous service 11am - 9.30pm, 7 days a week."
    ],
    "it": [
      "Bar, Brasserie e Pizzeria ai piedi delle piste, con un'ampia e splendida terrazza e solarium che gode del sole tutto il giorno.\r\nServizio continuo dalle 11 alle 21.30, 7 giorni su 7"
    ],
    "fr": [
      "Bar, Brasserie, Pizzéria au pied des pistes, bénéficiant d'une grande et belle terrasse et d'un solarium ensoleillés toute la journée.\r\nService continu 11H - 21h30, 7 jours sur 7"
    ],
    "es": [
      "Bar, Brasserie y Pizzería a pie de pistas, con una amplia y bonita terraza y solarium que disfruta del sol durante todo el día.\r\nServicio continuo de 11.00 a 21.30, los 7 días de la semana"
    ],
    "nl": [
      "Bar, Brasserie en Pizzeria aan de voet van de pistes, met een groot, mooi terras en solarium waar je de hele dag van de zon kunt genieten.\nDoorlopende service 11.00 - 21.30 uur, 7 dagen per week."
    ]
  },
