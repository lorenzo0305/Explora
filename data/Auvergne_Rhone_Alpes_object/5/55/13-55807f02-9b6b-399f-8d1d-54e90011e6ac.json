  "rdfs:comment": {
    "de": [
      "Im Bigairbag haben wir Spaß, und zwar für alle!!!\r\nAb 4 Jahren!!! Komm in die Luft, in den Reifen, auf Skiern oder Snowboards - das ist total verrückt!!!"
    ],
    "en": [
      "Come and have fun at the Bigairbag. Everyone can do it !!\r\nFrom 4 years old. Enjoy the fly by donut, ski or snowboard, that's awefull !!"
    ],
    "it": [
      "Bigairbag è un divertimento per tutti!\r\nA partire dai 4 anni! Venite a divertirvi in aria, in boa, con gli sci o lo snowboard, è assolutamente folle!"
    ],
    "fr": [
      "Au Bigairbag on s'éclate, et c'est pour tout le monde !!\r\nDès 4 ans !! Viens t'envoyer en l'air, en bouée, à ski ou snowboard c'est complètement Dingo !!"
    ],
    "es": [
      "¡Bigairbag es divertido para todos!\r\n¡Desde los 4 años! Ven a divertirte en el aire, en una boya, sobre esquís o snowboard, ¡es una locura total!"
    ],
    "nl": [
      "Bigairbag is leuk voor iedereen!\r\nVanaf 4 jaar! Kom plezier maken in de lucht, in een boei, op ski's of snowboard, het is helemaal te gek!"
    ]
  },
