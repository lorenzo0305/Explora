  "rdfs:comment": {
    "de": [
      "Seit 1999 bietet Lachal traiteur individuelle Leistungen für Ihre Veranstaltungen, Hochzeiten, Geburtstage, Seminare... an. Arbeitet mit lokalen Produkten. Personalisierte Menüs."
    ],
    "en": [
      "Since 1999, Lachal traiteur has been offering personalized services for your events, weddings, birthdays, seminars... Works with local produce. Customized menus."
    ],
    "it": [
      "Dal 1999, Lachal traiteur offre servizi personalizzati per i vostri eventi, matrimoni, compleanni, seminari... Lavora con prodotti locali. Menu personalizzati."
    ],
    "fr": [
      "Depuis 1999, Lachal traiteur vous propose des prestations personnalisées pour vos évènements, mariages, anniversaires, séminaires... Travaille des produits locaux. Menus personnalisés."
    ],
    "nl": [
      "Sinds 1999 biedt Lachal traiteur gepersonaliseerde diensten voor uw evenementen, bruiloften, verjaardagen, seminars, enz. Werkt met lokale producten. Gepersonaliseerde menu's."
    ],
    "es": [
      "Desde 1999, Lachal traiteur ofrece servicios personalizados para sus eventos, bodas, cumpleaños, seminarios... Trabaja con productos locales. Menús personalizados."
    ]
  },
