  "rdfs:comment": {
    "de": [
      "Die Berge haben für unsere Begleiter und Bergführer keine Geheimnisse mehr. Sie sind Profis und werden ihre Leidenschaft für die Berge mit Ihnen in guter Laune und Geselligkeit teilen."
    ],
    "en": [
      "Snow holds no secrets for our guides. Our professional guides will share their passion for the mountains with you in a friendly and relaxed atmosphere."
    ],
    "it": [
      "Le montagne non hanno segreti per le nostre guide. Professionisti, condivideranno con voi la loro passione per la montagna in un'atmosfera amichevole e rilassata."
    ],
    "fr": [
      "La Montagne n'a plus de secret pour nos accompagnateurs et guides. Professionnels, ils sauront vous faire partager leur passion pour la montagne dans la bonne humeur et la convivialité."
    ],
    "nl": [
      "Sneeuw heeft geen geheimen voor onze gidsen. Als professionals delen ze hun passie voor de bergen met je in een vriendelijke sfeer."
    ],
    "es": [
      "Las montañas no tienen secretos para nuestros guías. Profesionales, compartirán con usted su pasión por la montaña en un ambiente amistoso y relajado."
    ]
  },
