  "rdfs:comment": {
    "de": [
      "Tauchen Sie ein in die Geschichte des Breakdance! Mit 25 Jahren Leidenschaft und Kreativität, vom Asphalt bis zur Bühne, zeichnet die Pockemon Crew die pulsierende Geschichte des Hip-Hop in einer fesselnden Show nach."
    ],
    "en": [
      "Dive into the history of breakdance! With 25 years of passion and creation, from asphalt to stage, the Pockemon Crew retraces the vibrant history of hip-hop in a captivating show."
    ],
    "it": [
      "Tuffatevi nella storia della breakdance! Sostenuta da 25 anni di passione e creazione, dall'asfalto al palcoscenico, la Pockemon Crew ripercorre la vibrante storia dell'hip-hop in uno spettacolo accattivante."
    ],
    "fr": [
      "Plongez dans l’histoire du breakdance ! Fort de 25 ans de passion et de création, du bitume à la scène, le Pockemon Crew retrace l’histoire vibrante du hip-hop à travers un spectacle captivant."
    ],
    "es": [
      "¡Sumérjase en la historia del breakdance! Respaldados por 25 años de pasión y creación, del asfalto al escenario, la Pockemon Crew recorre la vibrante historia del hip-hop en un espectáculo cautivador."
    ],
    "nl": [
      "Duik in de geschiedenis van breakdance! Gesteund door 25 jaar passie en creatie, van asfalt tot podium, laat de Pockemon Crew de levendige geschiedenis van hiphop zien in een boeiende show."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Saison culturelle - Pockemon Crew, « De la rue aux jeux »"
    ]
  },
