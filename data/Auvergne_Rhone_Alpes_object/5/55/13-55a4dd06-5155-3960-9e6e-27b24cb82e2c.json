  "rdfs:comment": {
    "de": [
      "Lust auf einen festlichen Abend?\r\nEntdecken Sie das Le Shamrock 73 - Pub & Restaurant.\r\n\r\nHier können Sie eine große Auswahl an Bieren genießen oder sich am Tisch, an der Bar oder zum Mitnehmen verpflegen.\r\n\r\nVon Restaurant Guru zum besten Pub & Bar 2023 gewählt"
    ],
    "en": [
      "Looking for a festive evening out? \r\nDiscover Le Shamrock 73 - Pub & restaurant. \r\n\r\nYou can enjoy a wide choice of beers or eat at the table, bar or takeaway.\r\n\r\nVoted best Pub & Bar 2023 by Restaurant Guru"
    ],
    "it": [
      "Cercate una serata di festa?\r\nScoprite Le Shamrock 73 - Pub e ristorante.\r\n\r\nPotrete gustare un'ampia scelta di birre o mangiare al tavolo, al bar o da asporto.\r\n\r\nVotato miglior Pub & Bar 2023 da Restaurant Guru"
    ],
    "fr": [
      "Envie de passer une soirée festive ? \r\nDécouvrez Le Shamrock 73 - Pub & restauration. \r\n\r\nVous pourrez profiter d'un large choix de bières ou vous restaurer à table, au bar ou prendre à emporter.\r\n\r\nElu meilleur Pub & Bar 2023 par Restaurant Guru"
    ],
    "es": [
      "¿Busca una velada festiva?\r\nDescubra Le Shamrock 73 - Pub & restaurant.\r\n\r\nPodrá disfrutar de una amplia selección de cervezas o comer en la mesa, en el bar o para llevar.\r\n\r\nElegido mejor Pub & Bar 2023 por Restaurant Guru"
    ],
    "nl": [
      "Op zoek naar een feestelijk avondje uit?\r\nOntdek Le Shamrock 73 - Pub & restaurant.\r\n\r\nJe kunt er genieten van een ruime keuze aan bieren of eten aan tafel, bar of afhaalmaaltijden.\r\n\r\nUitgeroepen tot beste Pub & Bar 2023 door Restaurant Guru"
    ]
  },
