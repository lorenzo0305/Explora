  "rdfs:comment": {
    "de": [
      "Im Herzen von Val Cenis hilft Ihnen das Fremdenverkehrsamt von Termignon, Ihren Aufenthalt mit Informationen über lokale Veranstaltungen zu organisieren. Animationen, Besichtigungen des Kulturerbes, Spaziergänge, Wanderungen."
    ],
    "en": [
      "In the heart of Val Cenis, the Termignon Tourist Office will help you organise your stay with information on local events. Events, heritage visits, walks and hikes."
    ],
    "it": [
      "Nel cuore della Val Cenis, l'Ufficio del Turismo di Termignon vi aiuterà a organizzare il vostro soggiorno con informazioni sugli eventi locali. Eventi, visite al patrimonio, passeggiate ed escursioni."
    ],
    "fr": [
      "Au cœur de Val Cenis, l'Office de Tourisme de Termignon vous aide à organiser votre séjour avec des informations sur les événements locaux. Animations, visites du patrimoine, balades, randonnées."
    ],
    "nl": [
      "In het hart van Val Cenis helpt het toeristenbureau van Termignon u bij het organiseren van uw verblijf met informatie over plaatselijke evenementen. Evenementen, erfgoedbezoeken, wandelingen en trektochten."
    ],
    "es": [
      "En el corazón del Val Cenis, la Oficina de Turismo de Termignon le ayuda a organizar su estancia con información sobre los eventos locales. Actividades, visitas patrimoniales, paseos y excursiones."
    ]
  },
  "rdfs:label": {
