  "rdfs:comment": {
    "de": [
      "Inmitten eines wunderschönen sechs Hektar großen Parks mit jahrhundertealten Bäumen und fröhlichen Brunnen verbindet dieses authentische befestigte Haus aus dem 14. Jahrhundert Vergangenheit und Gegenwart für einen idyllischen Aufenthalt."
    ],
    "en": [
      "In the heart of a magnificent six-hectare park with century-old trees and cheerful fountains, this authentic 14th century fortified house combines past and present for an idyllic stay."
    ],
    "it": [
      "Nel cuore di un magnifico parco di sei ettari con alberi secolari e allegre fontane, questa autentica casa fortificata del XIV secolo unisce il passato al presente per un soggiorno idilliaco."
    ],
    "fr": [
      "Au cœur d’un magnifique parc de six hectares aux arbres centenaires et aux fontaines joyeuses, cette authentique maison forte du XIVème siècle conjugue passé et contemporanéité pour un séjour idyllique."
    ],
    "nl": [
      "In het hart van een prachtig park van zes hectare met eeuwenoude bomen en vrolijke fonteinen, combineert dit authentieke 14e-eeuwse versterkte huis het verleden met het heden voor een idyllisch verblijf."
    ],
    "es": [
      "En el corazón de un magnífico parque de seis hectáreas con árboles centenarios y alegres fuentes, esta auténtica casa fortificada del siglo XIV combina el pasado con el presente para una estancia idílica."
    ]
  },
