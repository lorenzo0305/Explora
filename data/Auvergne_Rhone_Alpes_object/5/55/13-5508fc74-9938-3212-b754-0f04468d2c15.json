  "rdfs:comment": {
    "de": [
      "L'Armellier ist eine Werkstatt für Holzdrechslerei. Hier können Sie Alltagsgegenstände aus gedrechseltem Holz entdecken: Schalen, Korkenzieher, Dosen und auch Kunstgegenstände."
    ],
    "en": [
      "L'Armellier is a wood turning workshop. Discover daily life items turned into wood:  bowls, corkscrews, boxes, as well as works of arts."
    ],
    "it": [
      "L'Armellier è un laboratorio di tornitura del legno. Scoprirete oggetti di uso quotidiano realizzati in legno tornito: ciotole, cavatappi, scatole, ma anche oggetti d'arte."
    ],
    "fr": [
      "L'Armellier est un atelier de tournage sur bois. Vous y découvrirez des objets de la vie quotidienne en bois tourné : bols, tire-bouchons, boîtes, ainsi que des objets d'art."
    ],
    "nl": [
      "L'Armellier is een houtdraaierij. Je kunt er gebruiksvoorwerpen, zoals kommen, kurkentrekkers, doosjes en kunstvoorwerpen kopen."
    ],
    "es": [
      "L'Armellier es un taller de torneado de madera. Descubrirá objetos cotidianos de madera torneada: cuencos, sacacorchos, cajas, así como objetos de arte."
    ]
  },
