  "rdfs:comment": {
    "de": [
      "Haben Sie Lust, ohne Stress und zu einem günstigen Preis in den Skiort zu fahren und dabei etwas für den Planeten zu tun? Die Navettes des Neiges bringen Sie von Die aus direkt zu den Pisten des Skigebiets Col de Rousset."
    ],
    "en": [
      "Looking for a stress-free, low-cost way to get to the resort while doing something for the planet? Les Navettes des Neiges will take you straight to the heart of the Col de Rousset ski resort from Die."
    ],
    "it": [
      "Volete salire al comprensorio senza stress, a un prezzo contenuto e facendo qualcosa per il pianeta? Les Navettes des Neiges vi porterà direttamente nel cuore delle piste del comprensorio sciistico del Col de Rousset da Die."
    ],
    "fr": [
      "Envie de monter en station sans stress, à petit prix et en faisant un geste pour la planète ? Les Navettes des Neiges sont là pour vous emmener directement au cœur des pistes de la station de ski du Col de Rousset au départ de Die."
    ],
    "es": [
      "¿Quieres subir a la estación sin estrés, a bajo precio y haciendo algo por el planeta? Les Navettes des Neiges le llevarán directamente al corazón de las pistas de la estación de esquí Col de Rousset desde Die."
    ],
    "nl": [
      "Wil je naar het skigebied zonder stress, voor een lage prijs en tegelijkertijd iets doen voor de planeet? Les Navettes des Neiges brengt je vanuit Die rechtstreeks naar het hart van de pistes van het skigebied Col de Rousset."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Navette des neiges : Die > Col de Rousset"
    ]
  },
