  "rdfs:comment": {
    "de": [
      "Im Rahmen des 2026, Sévigné-Jahres bietet das Département de la Drôme einen Schreibwettbewerb in den Bibliotheken und Mediatheken der Drôme an. In der Mediathek Drôme provençale wird ein Schreibzimmer angeboten, um den Wettbewerb aufzuwerten."
    ],
    "en": [
      "As part of 2026, Année Sévigné, the Département de la Drôme is offering a writing competition in Drôme's libraries and media libraries. A writing room will be available at the Drôme Provençale media library to promote the competition."
    ],
    "it": [
      "Nell'ambito di 2026, Année Sévigné, il Dipartimento della Drôme propone un concorso di scrittura nelle biblioteche e mediateche della Drôme. Presso la mediateca della Drôme Provençale sarà disponibile una sala di scrittura per promuovere il concorso."
    ],
    "fr": [
      "Dans le cadre de 2026, Année Sévigné, le Département de la Drôme propose un concours d'écriture dans les bibliothèques et médiathèques drômoises. Une chambre d'écriture sera proposée à la médiathèque Drôme provençale pour valoriser le concours."
    ],
    "nl": [
      "In het kader van 2026, Année Sévigné, organiseert het Département de la Drôme een schrijfwedstrijd in de bibliotheken en mediatheken van de Drôme. In de mediatheek van Drôme Provençale zal een schrijfzaal beschikbaar zijn om de wedstrijd te promoten."
    ],
    "es": [
      "En el marco de 2026, Année Sévigné, el Département de la Drôme propone un concurso de escritura en las bibliotecas y mediatecas de Drôme. La mediateca de Drôme Provençale dispondrá de una sala de escritura para promover el concurso."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Correspondances animées, un concours d’écriture où vos mots prennent vie"
    ]
  },
