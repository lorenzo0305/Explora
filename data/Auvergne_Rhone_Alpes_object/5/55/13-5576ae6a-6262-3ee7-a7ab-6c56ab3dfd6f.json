  "rdfs:comment": {
    "de": [
      "Atelier und Kunstgalerie, die Aquarelle, Schmuck, Töpferwaren und vieles mehr anbietet. Im Atelier werden auch Aquarellkurse und Workshops zu vergessenen Kunsthandwerken wie Glasmalerei, Mosaik oder Korbflechterei angeboten."
    ],
    "en": [
      "Art studio-gallery offering watercolors, jewelry, pottery and much more. The studio also organizes watercolor courses and workshops in forgotten arts and crafts, such as stained glass, mosaics and basketry."
    ],
    "it": [
      "Una galleria d'arte e uno studio che offre acquerelli, gioielli, ceramiche e molto altro. Lo studio organizza anche lezioni di acquerello e corsi di arti e mestieri dimenticati, come vetro colorato, mosaico e cesteria."
    ],
    "fr": [
      "Atelier-galerie d'art proposant des aquarelles, bijoux, poteries et bien plus encore. Des cours d'aquarelle ainsi que des stages dédiés aux métiers d'art oubliés, tels que le vitrail, la mosaïque ou la vannerie, sont également organisés dans l'atelier."
    ],
    "es": [
      "Galería y estudio de arte que ofrece acuarelas, joyas, cerámica y mucho más. El estudio también organiza clases de acuarela y cursos de artes y oficios olvidados, como vidrieras, mosaicos y cestería."
    ],
    "nl": [
      "Een kunstgalerie en studio met aquarellen, sieraden, aardewerk en nog veel meer. De studio organiseert ook aquarellessen en cursussen in vergeten kunsten en ambachten, zoals glas-in-lood, mozaïek en mandenvlechten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Atelier - \"Carrefour des Arts\""
    ]
  },
