  "rdfs:comment": {
    "de": [
      "Entdecken Sie in diesem schönen Herrenhaus und seinem Geburtshaus das Leben und Werk dieses herausragenden Wissenschaftlers des 19. Jahrhunderts, des Begründers der experimentellen Medizin. Museum mit dem Gütesiegel \"Maison des Illustres\"."
    ],
    "en": [
      "Explore the life and work of this outstanding 19th century scientist who founded experimental medicine here in this beautiful mansion and his hometown. Museum under the label \"Maison des Illustres\"."
    ],
    "it": [
      "Scoprite la vita e l'opera di questo eminente scienziato del XIX secolo, fondatore della medicina sperimentale, in questa splendida dimora e nella sua casa natale. Il museo ha ottenuto il marchio \"Maison des Illustres\"."
    ],
    "fr": [
      "Découvrez la vie et l’œuvre de cet éminent scientifique du XIXe siècle, fondateur de la médecine expérimentale, dans cette belle maison de maître et sa maison natale. Musée labellisé « Maison des Illustres »."
    ],
    "nl": [
      "Ontdek het leven en werk van deze eminente wetenschapper uit de 19e eeuw, grondlegger van de experimentele geneeskunde, in dit prachtige herenhuis en zijn geboortehuis. Het museum heeft het label \"Maison des Illustres\" gekregen."
    ],
    "es": [
      "Descubra la vida y obra de este eminente científico del siglo XIX, fundador de la medicina experimental, en esta hermosa mansión y su casa natal. El museo ha sido galardonado con el sello \"Maison des Illustres\"."
    ]
  },
