  "rdfs:comment": {
    "de": [
      "Schnellimbiss: Hamburger, Pommes frites, Salate, Snacks, Eis, Kaffee...  Zum Essen am Platz oder zum Mitnehmen im \"Mc Drive\". Täglich von 10.30 Uhr bis Mitternacht..."
    ],
    "en": [
      "Fast food: Hamburgers, fries, salads, snacks, ice creams and coffee to eat in, take away or collect at McDrive. Open every day from 10.30am to midnight."
    ],
    "it": [
      "Fast food: hamburger, patatine fritte, insalata, spuntini, gelati, caffè.  Servizio sul posto o da asporto \"Mc Drive\". Tutti i giorni dalle 10.30 a mezzanotte."
    ],
    "fr": [
      "Restauration rapide : hamburgers, frites, salades, en-cas, glaces, café...  Service sur place ou à emporter \"Mc Drive\". Tous les jours de 10h30 à minuit..."
    ],
    "nl": [
      "Fast food: hamburgers, patat, salades, snacks, ijs, koffie...  \"Mc Drive\" service ter plaatse of om mee te nemen. Elke dag van 10.30 tot middernacht..."
    ],
    "es": [
      "Comida rápida: hamburguesas, patatas fritas, ensaladas, bocadillos, helados, café...  Servicio \"Mc Drive\" in situ o para llevar. Todos los días, desde las 10.30 hasta la medianoche..."
    ]
  },
