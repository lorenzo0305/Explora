  "rdfs:comment": {
    "de": [
      "Der Verein Arts Passion hat sich zum Ziel gesetzt, den Zugang zum kulturellen Leben zu erleichtern. Busfahrten zu Aufführungen (Theater, Konzert, Tanz, Oper) und Planung von Reisen zu kulturellen und touristischen Zwecken in Frankreich und Europa."
    ],
    "en": [
      "The Arts Passion association aims to facilitate access to cultural life. Bus transport to attend shows (theater, concert, dance, opera) and programming of cultural and tourist trips in France and Europe."
    ],
    "it": [
      "L'associazione Arts Passion mira a facilitare l'accesso alla vita culturale. Fornisce trasporti in pullman per gli spettacoli (teatro, concerti, danza, opera) e organizza viaggi culturali e turistici in Francia e in Europa."
    ],
    "fr": [
      "L’association Arts Passion a pour but de faciliter l’accès à la vie culturelle. Transport en car pour assister à des spectacles (théâtre, concert, danse, opéra) et programmation de voyages à but culturel et touristique en France et en Europe."
    ],
    "es": [
      "La asociación Arts Passion pretende facilitar el acceso a la vida cultural. Proporciona transporte en autocar a espectáculos (teatro, conciertos, danza, ópera) y organiza viajes culturales y turísticos por Francia y Europa."
    ],
    "nl": [
      "De vereniging Arts Passion wil de toegang tot het culturele leven vergemakkelijken. Ze verzorgt busvervoer naar voorstellingen (theater, concerten, dans, opera) en organiseert culturele en toeristische uitstapjes in Frankrijk en Europa."
    ]
  },
