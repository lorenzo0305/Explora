  "rdfs:comment": {
    "de": [
      "Name der Einwohner: die Chazellois.\r\nDank seiner kommerziellen, handwerklichen und industriellen Dynamik ist Chazelles-sur-Lyon ein attraktives Zentrum für eine ganze landwirtschaftlich geprägte Region, insbesondere während seiner zwei wöchentlichen Märkte am Dienstag und Freitag."
    ],
    "en": [
      "Name of the inhabitants: the Chazellois.\r\nThanks to its commercial, artisanal, and industrial vitality, Chazelles-sur-Lyon is an attractive hub for an entire agricultural region, particularly during its two weekly markets held on Tuesdays and Fridays."
    ],
    "it": [
      "Abitanti: i Chazellois. Grazie alla sua vitalità commerciale, artigianale e industriale, Chazelles-sur-Lyon è un centro di attrazione per un'intera regione agricola, in particolare durante i suoi due mercati settimanali: il martedì e il venerdì."
    ],
    "fr": [
      "Nom des habitants : les chazellois. Grâce à sa vitalité commerciale, artisanale et industrielle, Chazelles-sur-Lyon, est un centre attractif pour toute une région agricole, notamment lors de ses deux marchés hebdomadaires : le mardi et le vendredi."
    ],
    "nl": [
      "Inwoners: de Chazellois. Dankzij de commerciële, ambachtelijke en industriële vitaliteit is Chazelles-sur-Lyon een aantrekkelijk centrum voor een hele landbouwstreek, vooral tijdens de twee wekelijkse markten: dinsdag en vrijdag."
    ],
    "es": [
      "Habitantes: los Chazellois. Gracias a su vitalidad comercial, artesanal e industrial, Chazelles-sur-Lyon es un centro atractivo para toda una región agrícola, sobre todo durante sus dos mercados semanales: martes y viernes."
    ]
  },
