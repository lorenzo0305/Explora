  "rdfs:comment": {
    "de": [
      "Mes p?tits Lu Création entwirft und personalisiert einzigartige Kreationen für Ihre Veranstaltungen: Hochzeiten, Taufen, Geburtstage und Geburten, mit handwerklichem Können in Holzgravur und -schnitt."
    ],
    "en": [
      "Mes p?tits Lu Création imagines and customizes unique creations for your events: weddings, christenings, birthdays and births, using traditional woodcutting and engraving techniques."
    ],
    "it": [
      "Mes p?tits Lu Création progetta e personalizza creazioni uniche per i vostri eventi: matrimoni, battesimi, compleanni e nascite, utilizzando le abilità tradizionali di incisione e taglio del legno."
    ],
    "fr": [
      "Mes p’tits Lu Création imagine et personnalise des créations uniques pour vos événements : mariages, baptêmes, anniversaires et naissances, avec un savoir-faire artisanal en gravure et découpe sur bois."
    ],
    "nl": [
      "Mes p?tits Lu Création ontwerpt en personaliseert unieke creaties voor uw evenementen: bruiloften, doopfeesten, verjaardagen en geboortes, met behulp van traditionele vaardigheden in houtgraveren en snijden."
    ],
    "es": [
      "Mes p?tits Lu Création diseña y personaliza creaciones únicas para sus eventos: bodas, bautizos, cumpleaños y nacimientos, utilizando técnicas tradicionales de grabado y corte de madera."
    ]
  },
