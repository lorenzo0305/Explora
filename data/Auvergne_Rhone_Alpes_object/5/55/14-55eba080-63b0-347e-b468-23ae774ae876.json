  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/5d93d5f9-6b51-3ac7-88d8-d11216a704f4",
      "dc:description": {
        "de": [
          "Lassen Sie sich von der Kompanie La Vache Bleue zu einem schrägen Rundgang voller Überraschungen mit den etwas schrägen Führern des Dienstes für bürgernahe Besuche führen. Eine andere Art, das Museum zu entdecken!"
        ],
        "en": [
          "Let the company La Vache Bleue guide you on an offbeat tour full of surprises, with guides from the Local Visits Department. Another way to discover the museum!"
        ],
        "it": [
          "Lasciatevi guidare dalla compagnia La Vache Bleue in una visita fuori dagli schemi e piena di sorprese con le guide un po' fuori dagli schemi del Dipartimento Visite Locali. Un altro modo per scoprire il museo!"
        ],
        "fr": [
          "Laissez-vous guider par la compagnie La Vache Bleue pour une visite décalée et pleine de surprises avec des guides un peu décalés du Service des visites de proximité. Une autre façon de découvrir le musée !"
        ],
        "nl": [
          "Laat je rondleiden door La Vache Bleue voor een onconventionele rondleiding vol verrassingen met de ietwat onconventionele gidsen van de afdeling Plaatselijke Bezoeken. Een andere manier om het museum te ontdekken!"
        ],
        "es": [
          "Deje que la compañía La Vache Bleue le guíe en un recorrido poco convencional lleno de sorpresas con los guías poco convencionales del Departamento de Visitas Locales. Otra forma de descubrir el museo"
        ]
      },
