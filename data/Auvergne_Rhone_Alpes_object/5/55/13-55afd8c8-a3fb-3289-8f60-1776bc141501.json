  "rdfs:comment": {
    "de": [
      "Die romanische Kirche Saint-Pierre de Biollet (11. Jh.) ist aufgrund ihres Grundrisses (Basilika) und der skulpturalen Kapitelle, die in der Auvergne ihresgleichen suchen, atypisch."
    ],
    "en": [
      "The romaesque church of Saint Pierre of Biollet (11th century) is atypically Basilican by the sculpted carved capitals which are without equivalents in the Auvergne."
    ],
    "it": [
      "La chiesa romanica di Saint-Pierre de Biollet, risalente all'XI secolo, è atipica per la sua pianta basilicale e i suoi capitelli scolpiti, che non hanno equivalenti in Alvernia."
    ],
    "fr": [
      "L'église romane Saint-Pierre de Biollet (XIe siècle) est atypique par son plan (basilical) et par la présence de chapiteaux sculptés, sans équivalents en Auvergne."
    ],
    "es": [
      "La iglesia románica de Saint-Pierre de Biollet, del siglo XI, es atípica por su planta basilical y sus capiteles esculpidos, que no tienen equivalente en Auvernia."
    ],
    "nl": [
      "De 11e-eeuwse Romaanse kerk Saint-Pierre de Biollet is atypisch vanwege de indeling van de basiliek en de gebeeldhouwde kapitelen, die geen equivalent hebben in de Auvergne."
    ]
  },
  "rdfs:label": {
    "en": [
