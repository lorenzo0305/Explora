      "schema:openingHoursSpecification": [
        {
          "@id": "https://data.datatourisme.fr/9b0dbddb-3433-380a-9d28-d139a36ae651",
          "schema:validFrom": "2026-01-02T00:00:00",
          "schema:validThrough": "2026-12-30T23:59:59",
          "@type": [
            "schema:OpeningHoursSpecification"
          ],
          "additionalInformation": {
            "de": [
              "Die oben angegebenen Zeiten beziehen sich nur auf den Wellnessbereich.\r\nBitte beachten Sie die Zeiten für die zweistündigen Slots.\r\nRäumung der Räume 30 Minuten vor Schließung.\r\nWährend der kleinen und großen Schulferien gelten andere Öffnungszeiten; bitte informieren Sie sich auf unserer Website und in unseren sozialen Netzwerken."
            ],
            "en": [
              "The above times apply to the Bien-Etre area only.\r\nPlease consult the timetables for the 2-hour slots.\r\nPlease vacate the area 30 minutes before closing time.\r\nPlease consult our website and social networks for different timetables during school vacations."
            ],
            "it": [
              "Gli orari sopra indicati si riferiscono solo all'area benessere.\r\nPer le fasce orarie di 2 ore consultare gli orari.\r\nSi prega di lasciare l'area 30 minuti prima della chiusura.\r\nDurante le vacanze scolastiche brevi e lunghe, gli orari di apertura sono diversi; si prega di consultare il nostro sito web e i social network."
            ],
            "fr": [
              "Les horaires ci-dessus ne concernent que l'espace Bien-Etre.\r\nMerci de consulter les horaires des créneaux de 2h.\r\nEvacuation des espaces 30 minutes avant la fermeture.\r\nEn période de petites et grandes vacances scolaires, les horaires sont différents ; merci de consulter notre site web et nos réseaux sociaux."
            ],
            "es": [
              "Los horarios arriba indicados corresponden únicamente al espacio Bienestar.\r\nConsulte los horarios para las franjas de 2 horas.\r\nDesaloje la zona 30 minutos antes del cierre.\r\nDurante las vacaciones escolares cortas y largas, los horarios son diferentes; consulte nuestra página web y nuestras redes sociales."
            ],
            "nl": [
              "De tijden hierboven zijn alleen voor het welzijnsgebied.\r\nRaadpleeg de roosters voor de 2-uurstijden.\r\nGelieve de ruimte 30 minuten voor sluitingstijd te verlaten.\r\nTijdens korte en lange schoolvakanties gelden andere openingstijden; raadpleeg hiervoor onze website en sociale netwerken."
            ]
          },
