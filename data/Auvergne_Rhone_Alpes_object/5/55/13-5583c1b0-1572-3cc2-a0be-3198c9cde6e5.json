  "rdfs:comment": {
    "de": [
      "Für Ihre Tourismus- und Geschäftsaufenthalte ist das Collège Hôtel ideal im Viertel Vieux-Lyon, das Teil des UNESCO-Weltkulturerbes ist, gelegen."
    ],
    "en": [
      "For tourism and business stays, the College Hotel is ideally located in the Old Lyon district, listed as a World Heritage site by UNESCO. A place to discover «as Saône as possible» in memory of our dreams!"
    ],
    "it": [
      "Per soggiorni turistici e professionali, il Collège Hotel si trova in posizione ideale nel quartiere della Lione Vecchia, incluso nel Patrimonio Mondiale dell'UNESCO."
    ],
    "fr": [
      "Pour des séjours de tourisme et d'affaires, le Collège Hôtel est idéalement situé dans le quartier du Vieux-Lyon, inscrit au Patrimoine Mondial par l'UNESCO. Un lieu à découvrir « as Saône as possible » en souvenir de nos rêves !"
    ],
    "nl": [
      "Voor toeristische en zakelijke verblijven is het Collège Hôtel ideaal gelegen in de wijk Oud Lyon, een UNESCO-werelderfgoed. Een plek om \"zo Saône mogelijk\" te ontdekken als herinnering aan onze dromen!"
    ],
    "es": [
      "El Collège Hôtel ofrece una ubicación ideal para estancias de ocio y negocios en el barrio de Vieux-Lyon, Patrimonio Universal de la UNESCO."
    ]
  },
