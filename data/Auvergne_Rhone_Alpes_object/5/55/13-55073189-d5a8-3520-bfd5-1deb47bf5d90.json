  "rdfs:comment": {
    "de": [
      "Das Restaurant le Loup Blanc liegt unterhalb der Pisten von Plagne 1800. Auf seiner großen Sonnenterrasse können Sie eine Savoyer Spezialität oder ein Fertiggericht genießen und im großen Speisesaal im Obergeschoss können Sie sich mit der Familie aufwärmen."
    ],
    "en": [
      "Le Loup Blanc restaurant, at the foot of the ski slopes in Plagne 1800, has a large sunny terrace where you can enjoy Savoyard specialities and a large dining room upstairs for a cosy meal with your family."
    ],
    "it": [
      "Il ristorante Loup Blanc, situato ai piedi delle piste di Plagne 1800, dispone di un'ampia terrazza soleggiata dove gustare una specialità savoiarda o un piatto cucinato, e di una grande sala da pranzo al piano superiore per riscaldarsi con la famiglia."
    ],
    "fr": [
      "Le restaurant le Loup Blanc, situé en bas des pistes de Plagne 1800, vous propose sa grande terrasse ensoleillée pour déguster une spécialité Savoyarde ou un plat cuisiné et sa grande salle de restaurant à l'étage pour se réchauffer en famille."
    ],
    "nl": [
      "Restaurant Le Loup Blanc ligt onderaan de pistes van Plagne 1800. Op het zonovergoten terras kunt u genieten van specialiteiten uit de Savoie of andere gerechten en in de grote eetkamer op de bovenverdieping om gezellig met het gezin te zitten"
    ],
    "es": [
      "El restaurante Loup Blanc, situado a pie de pistas en Plagne 1800, dispone de una amplia terraza soleada donde degustar una especialidad saboyana o un plato cocinado, y de un gran comedor en el piso de arriba para calentarse en familia."
    ]
  },
