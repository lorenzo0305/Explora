  "rdfs:comment": {
    "de": [
      "Im Jahr 2027 feiern die Celtic Legends ihr 25-jähriges Bestehen!\r\nVom 26. bis 28. Februar in der Salle Pleyel in Paris und anschließend auf Tournee durch ganz Frankreich kehrt das Irish Team der Celtic Lelends mit einer neuen Show auf die Bühne zurück!"
    ],
    "en": [
      "In 2027, Celtic Legends celebrates its 25th anniversary!\r\nFrom February 26 to 28 at the Salle Pleyel in Paris, then on tour throughout France, L?Irish Team des Celtic Lelends returns to the stage with a new show!"
    ],
    "it": [
      "Nel 2027, Celtic Legends festeggia il suo 25° anniversario!\r\nDal 26 al 28 febbraio alla Salle Pleyel di Parigi, poi in tournée in tutta la Francia, la squadra irlandese dei Celtic Lelends torna in scena con un nuovo spettacolo!"
    ],
    "fr": [
      "En 2027, Celtic Legends fête ses 25 ans !\r\nDu 26 au 28 février à la Salle Pleyel à Paris, puis en tournée dans toute la France, L’Irish Team des Celtic Lelends revient sur scène avec un nouveau spectacle !"
    ],
    "es": [
      "¡En 2027, Celtic Legends celebra su 25 aniversario!\r\nDel 26 al 28 de febrero en la Sala Pleyel de París, y después de gira por toda Francia, el equipo irlandés de Celtic Lelends vuelve a los escenarios con un nuevo espectáculo"
    ],
    "nl": [
      "In 2027 viert Celtic Legends zijn 25e verjaardag!\r\nVan 26 tot 28 februari in de Salle Pleyel in Parijs, daarna op tournee door heel Frankrijk, keert het Ierse team van Celtic Lelends terug op het podium met een nieuwe show!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Spectacle : Celtic Legends"
    ]
  },
