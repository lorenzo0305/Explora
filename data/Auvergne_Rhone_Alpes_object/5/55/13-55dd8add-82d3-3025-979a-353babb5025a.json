  "rdfs:comment": {
    "de": [
      "An der Ecke zwischen dem Place Claveyson und dem Place aux Herbes in Grenoble befindet sich ein Schaufenster. Wenn Sie die Galerie Showcase suchen und in Ratlosigkeit versinken, machen Sie sich keine Sorgen, Sie sind am richtigen Ort."
    ],
    "en": [
      "At the corner of Place Claveyson and Place aux Herbes in Grenoble, a shop window. If you're looking for Galerie Showcase and getting baffled, don't worry, you've come to the right place."
    ],
    "it": [
      "Una vetrina all'angolo tra Place Claveyson e Place aux Herbes a Grenoble. Se state cercando la Galerie Showcase e siete perplessi, non preoccupatevi, siete nel posto giusto."
    ],
    "fr": [
      "A l’angle de la place Claveyson et de la place aux Herbes à Grenoble, une vitrine. Si vous cherchez Galerie Showcase et sombrez dans la perplexité, ne vous inquiétez pas, vous êtes au bon endroit."
    ],
    "es": [
      "En la esquina de la Place Claveyson y la Place aux Herbes de Grenoble, un escaparate. Si busca la galería Showcase y se está desconcertando, no se preocupe, ha llegado al lugar adecuado."
    ],
    "nl": [
      "Een etalage op de hoek van Place Claveyson en Place aux Herbes in Grenoble. Als je op zoek bent naar Galerie Showcase en je raakt verbijsterd, maak je dan geen zorgen, je bent hier aan het juiste adres."
    ]
  },
  "rdfs:label": {
