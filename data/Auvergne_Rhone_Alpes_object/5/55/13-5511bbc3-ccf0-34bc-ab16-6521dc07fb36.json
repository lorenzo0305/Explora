  "rdfs:comment": {
    "de": [
      "Im Herzen des mittelalterlichen Dorfes Désaignes enthüllt Ihnen die Brauerei Kokine Bières ihre biologische und lokale Produktion, die mit Sorgfalt und Quellwasser hergestellt wird."
    ],
    "en": [
      "In the heart of the medieval village of Désaignes, the Kokine Bières brewery unveils its organic and locally produced beer, crafted with care and spring water."
    ],
    "it": [
      "Nel cuore del borgo medievale di Désaignes, il birrificio Kokine Bières rivela la sua produzione biologica e locale, realizzata con cura e acqua di sorgente."
    ],
    "fr": [
      "Au cœur du village médiéval de Désaignes, la brasserie Kokine Bières vous dévoile sa production bio et locale, élaborée avec soin et de l'eau de source."
    ],
    "nl": [
      "In het hart van het middeleeuwse dorp Désaignes onthult brouwerij Kokine Bières haar biologische en lokale productie, zorgvuldig gemaakt met bronwater."
    ],
    "es": [
      "En el corazón del pueblo medieval de Désaignes, la cervecería Kokine Bières revela su producción ecológica y local, elaborada con esmero y agua de manantial."
    ]
  },
