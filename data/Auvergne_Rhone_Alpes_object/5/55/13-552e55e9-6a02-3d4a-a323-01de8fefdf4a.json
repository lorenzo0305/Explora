  "rdfs:comment": {
    "de": [
      "Wahrscheinlich vor dem 15. Jahrhundert erbaut, wird er im Kataster von 1409 erwähnt. Er wurde im Laufe der Jahrhunderte zugeschüttet und 2010 gereinigt. Es handelt sich um einen Gemeindebrunnen."
    ],
    "en": [
      "Probably built before the 15th century, it is mentioned in the 1409 land register. It has been filled in over the centuries and was cleaned in 2010. It is a communal well."
    ],
    "it": [
      "Probabilmente costruito prima del XV secolo, è menzionato nel catasto del 1409. È stato riempito nel corso dei secoli ed è stato ripulito nel 2010. È un pozzo comune."
    ],
    "fr": [
      "Probablement construit avant le XVe siècle, il est mentionné dans le cadastre de 1409. Il a été comblé au cours des siècles et a été nettoyé en 2010. C'est un puit communal."
    ],
    "es": [
      "Probablemente construido antes del siglo XV, se menciona en el catastro de 1409. Se ha rellenado a lo largo de los siglos y se limpió en 2010. Es un pozo comunitario."
    ],
    "nl": [
      "Het werd waarschijnlijk voor de 15e eeuw gebouwd en wordt vermeld in het kadaster van 1409. Hij is in de loop der eeuwen gedempt en werd in 2010 schoongemaakt. Het is een gemeenschappelijke waterput."
    ]
  },
  "rdfs:label": {
