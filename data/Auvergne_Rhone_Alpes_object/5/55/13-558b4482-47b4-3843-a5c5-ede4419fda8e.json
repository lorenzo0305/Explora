  "rdfs:comment": {
    "de": [
      "Der ideale Spot für Afterwork-Partys und lebhafte Abende. Entdecken Sie köstliche Tapas und innovative Cocktails in einem stilvollen und geselligen Ambiente. Erleben Sie Baden Baden, wo jeder Moment einzigartig ist!"
    ],
    "en": [
      "The ideal spot for afterworks and lively evenings. Discover delicious tapas and innovative cocktails in a chic and friendly atmosphere. Come and experience Baden Baden, where every moment is unique!"
    ],
    "it": [
      "Il luogo ideale per feste dopo il lavoro e serate vivaci. Scoprite deliziose tapas e cocktail innovativi in un'atmosfera chic e accogliente. Venite a scoprire Baden Baden, dove ogni momento è unico!"
    ],
    "fr": [
      "Le spot idéal pour des afterworks et soirées animées. Découvrez de délicieux tapas et cocktails innovants dans une ambiance chic et conviviale. Venez vivre l'expérience Baden Baden, où chaque moment est unique !"
    ],
    "es": [
      "El lugar ideal para fiestas después del trabajo y veladas animadas. Descubra deliciosas tapas y cócteles innovadores en un ambiente elegante y acogedor. Venga a conocer Baden Baden, donde cada momento es único"
    ],
    "nl": [
      "De ideale plek voor after-work parties en levendige avonden. Ontdek heerlijke tapas en innovatieve cocktails in een chique en vriendelijke sfeer. Kom en ervaar Baden Baden, waar elk moment uniek is!"
    ]
  },
  "rdfs:label": {
