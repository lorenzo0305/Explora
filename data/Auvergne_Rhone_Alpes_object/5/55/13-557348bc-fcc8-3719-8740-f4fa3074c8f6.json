  "rdfs:comment": {
    "de": [
      "Vergessen Sie den Stress mit den Gleitschirmen von Puy-Mary! Wir bieten Erstflüge mit Tandem-Gleitschirmen an den Hängen des größten Vulkans Europas im Regionalen Naturpark Volcans d'Auvergne an"
    ],
    "en": [
      "Forget stress with paragliding at Puy-Mary! We offer tandem paragliding flights on the slopes of Europe's largest volcano in the Parc Naturel Régional des Volcans d'Auvergne"
    ],
    "it": [
      "Dimenticate lo stress con il parapendio al Puy-Mary! Offriamo i primi voli in parapendio in tandem sulle pendici del vulcano più grande d'Europa, nel Parc Naturel Régional des Volcans d'Auvergne"
    ],
    "fr": [
      "Oubliez le stress avec les parapentes du Puy-Mary ! Nous proposons des baptêmes de l'air en parapente biplace sur les pentes du plus grand volcan d'Europe dans le Parc Naturel Régional des Volcans d'Auvergne"
    ],
    "es": [
      "¡Olvídese del estrés con el parapente en Puy-Mary! Ofrecemos primeros vuelos en parapente biplaza en las laderas del volcán más grande de Europa, en el Parc Naturel Régional des Volcans d'Auvergne"
    ],
    "nl": [
      "Vergeet de stress met paragliding bij Puy-Mary! Wij bieden eerste vluchten in tandem paragliders op de hellingen van de grootste vulkaan van Europa in het Parc Naturel Régional des Volcans d'Auvergne"
    ]
  },
  "rdfs:label": {
