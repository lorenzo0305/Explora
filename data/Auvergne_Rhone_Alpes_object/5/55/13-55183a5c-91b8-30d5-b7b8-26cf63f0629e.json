  "rdfs:comment": {
    "de": [
      "Tauchen Sie vom ersten bis zum letzten Kilometer in den Wald ein, zwischen Wegen für Nordic Walking und Trail. Panoramablicke auf die Berge von Tarare, das Azergues-Tal, die Alpen und den Pilat, inmitten von majestätischen Douglasien und frischem Unterholz."
    ],
    "en": [
      "A forest immersion from the first to the last kilometer, between Nordic walking and trail running paths. Panoramas of the Tarare mountains, the Azergues valley, the Alps and Pilat, in the heart of majestic Douglas firs and the freshness of the undergrowth."
    ],
    "it": [
      "Un'immersione nella foresta dal primo all'ultimo chilometro, tra nordic walking e sentieri. Vista panoramica sulle montagne di Tarare, sulla valle di Azergues, sulle Alpi e sul Pilat, circondati da maestosi abeti di Douglas e da un fresco sottobosco."
    ],
    "fr": [
      "Une immersion forestière du premier au dernier kilomètre, entre chemins pour marche nordique et trail. Panoramas sur les monts de Tarare, la vallée de l’Azergues, les Alpes et le Pilat, au cœur des douglas majestueux et de la fraîcheur des sous-bois."
    ],
    "es": [
      "Una inmersión en el bosque desde el primer al último kilómetro, entre senderos de marcha nórdica y de trail. Vistas panorámicas de los montes Tarare, el valle de Azergues, los Alpes y Pilat, rodeados de majestuosos abetos Douglas y un sotobosque fresco."
    ],
    "nl": [
      "Een onderdompeling in het bos van de eerste tot de laatste kilometer, tussen nordic walking en wandelpaden. Panoramisch uitzicht op de bergen van Tarare, de vallei van de Azergues, de Alpen en Pilat, omringd door majestueuze douglassparren en koel kreupelhout."
    ]
  },
  "rdfs:label": {
    "en": [
      "The forest of Brou - Beaujolais - Dième"
    ],
    "fr": [
      "La forêt de Brou - Beaujolais - Dième"
    ]
  },
