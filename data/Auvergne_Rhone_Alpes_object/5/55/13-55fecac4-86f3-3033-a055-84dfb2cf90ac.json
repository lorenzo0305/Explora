  "rdfs:comment": {
    "de": [
      "Pédal'O Nautic du Bouchet empfängt Sie in der idyllischen Umgebung des Lac du Bouchet, 20 Minuten südlich von Le Puy-en-Velay, um Ihnen ihre Tretboote und Paddles vorzustellen.\r\nTäglich von 10:00 bis 20:00 Uhr geöffnet (je nach Wetterlage)"
    ],
    "en": [
      "Pédal'O Nautic du Bouchet welcomes you to the idyllic setting of Lac du Bouchet, 20 minutes south of Le Puy-en-Velay, to show you their pedalos and paddles.\r\nOpen every day from 10 a.m. to 8 p.m. (weather permitting)"
    ],
    "it": [
      "Pédal'O Nautic du Bouchet vi accoglie nell'idilliaco scenario del Lac du Bouchet, a 20 minuti a sud di Le Puy-en-Velay, per mostrarvi i suoi pedalò e le sue pagaie.\r\nAperto tutti i giorni dalle 10.00 alle 20.00 (tempo permettendo)"
    ],
    "fr": [
      "Pédal'O Nautic du Bouchet  vous accueillent dans le cadre idyllique du Lac du Bouchet, à 20 minutes au sud du Puy-en-Velay, pour vous faire découvrir leurs pédalos et paddles.\r\nOuvert tous les jours de 10h à 20h (selon la météo)"
    ],
    "nl": [
      "Pédal'O Nautic du Bouchet verwelkomt je in de idyllische omgeving van Lac du Bouchet, 20 minuten ten zuiden van Le Puy-en-Velay, om je hun waterfietsen en peddels te laten zien.\r\nElke dag geopend van 10.00 tot 20.00 uur (als het weer het toelaat)"
    ],
    "es": [
      "Pédal'O Nautic du Bouchet le da la bienvenida en el idílico entorno del lago del Bouchet, a 20 minutos al sur de Le Puy-en-Velay, para mostrarle sus pedales y remos.\r\nAbierto todos los días de 10.00 a 20.00 (si el tiempo lo permite)"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Pédal'o Nautic du Bouchet | Paddle | Pédalos"
    ]
  },
