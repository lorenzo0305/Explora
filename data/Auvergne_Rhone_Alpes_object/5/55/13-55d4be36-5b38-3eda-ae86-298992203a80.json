  "rdfs:comment": {
    "de": [
      "Das Spa d'Altitude Ô des Cimes in der Residenz CGH Les Cimes Blanches bietet Ihnen Schönheitsbehandlungen, Gesichts- und Körperpflege. Für Erwachsene, Jugendliche und Kinder."
    ],
    "en": [
      "The Spa d'Altitude Ô des Cimes at the CGH Les Cimes Blanches residence offers beauty, facial and body treatments. For adults, teens and children."
    ],
    "it": [
      "Aperta a tutti, la Spa di montagna Ô des Cimes dei residence CGH Les Cimes Blanches propone trattamenti per il viso e il corpo, trattamenti estetici anche per bambini e ragazzi."
    ],
    "fr": [
      "Le Spa d’Altitude Ô des Cimes de la résidence CGH Les Cimes Blanches vous propose des soins esthétiques, des soins du visage et du corps. Pour adultes, ados et enfants."
    ],
    "es": [
      "El Spa Altitude Ô des Cimes de la residencia CGH Les Cimes Blanches ofrece tratamientos de belleza, tratamientos faciales y tratamientos corporales. Para adultos, adolescentes y niños."
    ],
    "nl": [
      "De Spa d'Altitude Ô des Cimes in de residentie CGH Les Cimes Blanches biedt schoonheids-, gezichts- en lichaamsbehandelingen. Voor volwassenen, tieners en kinderen."
    ]
  },
