  "rdfs:comment": {
    "de": [
      "Die Haute Sioule AAPPMA verwaltet etwa 39 km des Flusses Sioule und 54 km Bäche. Auf unserem Angelkurs sind drei No-Kill-Kurse (Kurse ohne Töten) und 2 Fischreservate vorhanden."
    ],
    "en": [
      "Haute Sioule AAPPMA manages about 39 km of Sioule river and 54 km of streams. Three no-kill courses (courses without killing) and 2 fishing reserves are present on our fishing course."
    ],
    "it": [
      "L'AAPPMA Haute Sioule gestisce circa 39 km di fiume Sioule e 54 km di torrenti. Disponiamo di tre riserve di pesca temporanea e di tre riserve no-kill."
    ],
    "fr": [
      "L'AAPPMA de la Haute Sioule gère environ 39 km de rivière Sioule et 54 Km de ruisseaux. Trois parcours no-kill (parcours sans tuer) et 3 réserves de pêche temporaires sont présents sur notre parcours de pêche."
    ],
    "es": [
      "La AAPPMA de Haute Sioule gestiona unos 39 km del río Sioule y 54 km de arroyos. Disponemos de tres recorridos sin muerte y 3 cotos temporales de pesca."
    ],
    "nl": [
      "De AAPPMA Haute Sioule beheert ongeveer 39 km van de rivier de Sioule en 54 km aan beken. We hebben drie no-kill stroomgebieden en 3 tijdelijke visreservaten."
    ]
  },
  "rdfs:label": {
    "de": [
      "Angelplatz - Fluss La Sioule (obere Sioule)"
    ],
    "en": [
      "Fishing site - River La Sioule (Haute Sioule)"
    ],
    "fr": [
      "Site de pêche - Rivière La Sioule (haute Sioule)"
    ]
  },
