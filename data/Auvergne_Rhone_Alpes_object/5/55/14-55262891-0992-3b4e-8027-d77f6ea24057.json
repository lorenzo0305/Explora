  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/5958a764-b15e-3aaa-88d4-d9443ef9f458",
      "dc:description": {
        "de": [
          "Der Sänger Hervé Teneur kehrt mit seinem zweiten Album auf die Bühne zurück. Als Autor, Komponist und Interpret lädt er die Kinder ein, zum Klang seiner Gitarre lustige, poetische und interaktive Lieder zu entdecken."
        ],
        "en": [
          "Singer Hervé Teneur is back on stage with a second album. A singer-songwriter, he invites children to discover funny, poetic and interactive songs to the sound of his guitar."
        ],
        "it": [
          "Il cantante Hervé Teneur torna in scena con un secondo album. Cantautore, invita i bambini a scoprire canzoni divertenti, poetiche e interattive al suono della sua chitarra."
        ],
        "fr": [
          "Le chanteur Hervé Teneur reprend le chemin de la scène avec un second album. Auteur compositeur interprète, il invite les enfants à découvrir des chansons drôles, poétiques et interactives au son de sa guitare."
        ],
        "nl": [
          "Zanger Hervé Teneur is terug op het podium met een tweede album. Als singer-songwriter nodigt hij kinderen uit om grappige, poëtische en interactieve liedjes te ontdekken op de klanken van zijn gitaar."
        ],
        "es": [
          "El cantante Hervé Teneur vuelve a los escenarios con un segundo álbum. Cantautor, invita a los niños a descubrir canciones divertidas, poéticas e interactivas al son de su guitarra."
        ]
      },
