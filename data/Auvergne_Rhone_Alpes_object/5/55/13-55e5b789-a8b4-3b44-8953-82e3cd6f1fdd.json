  "rdfs:comment": {
    "de": [
      "Hubert schafft Denkmäler und Brunnen, die vom Kulturerbe der Vaucluse inspiriert sind. Als treue Anhänger des provenzalischen Erbes spiegeln seine Stücke seine Leidenschaft für alte Steine wider."
    ],
    "en": [
      "Hubert creates monuments and fountains inspired by the heritage of the Vaucluse region. Faithful to the heritage of Provence, his pieces reflect his passion for old stones."
    ],
    "it": [
      "Hubert crea monumenti e fontane ispirati al patrimonio della regione di Vaucluse. Fedeli al patrimonio della Provenza, i suoi pezzi riflettono la sua passione per le pietre antiche."
    ],
    "fr": [
      "Hubert crée des monuments et des fontaines inspirés du patrimoine vauclusien. Fidèle au patrimoine provençal, ses pièces reflètent sa passion pour les vieilles pierres."
    ],
    "es": [
      "Hubert crea monumentos y fuentes inspirados en el patrimonio de la región de Vaucluse. Fiel a la herencia provenzal, sus piezas reflejan su pasión por las piedras antiguas."
    ],
    "nl": [
      "Hubert creëert monumenten en fonteinen geïnspireerd door het erfgoed van de Vaucluse. Trouw aan het erfgoed van de Provence weerspiegelen zijn stukken zijn passie voor oude stenen."
    ]
  },
