  "rdfs:comment": {
    "de": [
      "Le Cellier steht für eine gemütliche und authentische Atmosphäre rund um einen großen Kamin, in dem unser Grilleur große Stücke französischen Fleisches zubereitet.\r\nTraditionelle Restauration, Spezialitäten aus den Bergen, Fleisch vom Holzfeuer"
    ],
    "en": [
      "A friendly atmosphere around an open fireplace where we cook large pieces of meat in front of our many and loyal customers.\r\nTraditional restaurant, mountain specialities, wood-fired meats"
    ],
    "it": [
      "Un ambiente conviviale intorno ad un grande camino nel quale si cuoce carne davanti alla nostra clientela numerosa e fedele.\r\nRistorante tradizionale, specialità di montagna, carni cotte a legna"
    ],
    "fr": [
      "Le Cellier c'est une ambiance conviviale et authentique autour d'une grande cheminée dans laquelle notre grillardin cuit de grosses pièces de viande française.\r\nRestauration traditionnelle, spécialités montagnardes, viandes au feu de bois"
    ],
    "nl": [
      "Le Cellier is een gezellige en authentieke sfeer rond een grote open haard waarin onze grill grote stukken Frans vlees bakt.\r\nTraditionele catering, bergspecialiteiten, op houtvuur bereid vlees"
    ],
    "es": [
      "Le Cellier es un ambiente acogedor y auténtico en torno a una gran chimenea en la que nuestra parrilla cocina grandes piezas de carne francesa.\r\nRestauración tradicional, especialidades de montaña, carne cocinada a la leña"
    ]
  },
