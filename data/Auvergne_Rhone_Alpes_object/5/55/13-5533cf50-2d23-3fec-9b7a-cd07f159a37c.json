  "rdfs:comment": {
    "de": [
      "La Comédia empfängt Sie in einem komplett renovierten Saal! Kommen Sie und entdecken Sie unsere Pizzas (handgemachter Teig)\r\nKostenlose Lieferung nach 18 Uhr ( in einem Umkreis von 4kms)"
    ],
    "en": [
      "La Comédia welcomes you in a completely renovated room! Come and discover our pizzas (home-made dough)\r\nFree delivery after 6pm (within 4kms)"
    ],
    "it": [
      "La Comédia vi accoglie in una camera completamente rinnovata! Venite a scoprire le nostre pizze (impasto fatto in casa)\r\nConsegna gratuita dopo le 18:00 (nel raggio di 4 km)"
    ],
    "fr": [
      "La Comédia vous accueille dans une salle entièrement rénovée  ! Venez découvrir nos pizzas (pâte artisanale)\r\nLivraison gratuite après 18h ( dans un périmètre de  4kms)"
    ],
    "nl": [
      "La Comédia verwelkomt u in een volledig gerenoveerde kamer! Kom en ontdek onze pizza's (zelfgemaakt deeg)\r\nGratis levering na 18.00 uur (binnen een straal van 4 km)"
    ],
    "es": [
      "La Comédia le da la bienvenida en una habitación completamente renovada Ven a descubrir nuestras pizzas (masa casera)\r\nEntrega gratuita después de las 18:00 horas (en un radio de 4 km)"
    ]
  },
