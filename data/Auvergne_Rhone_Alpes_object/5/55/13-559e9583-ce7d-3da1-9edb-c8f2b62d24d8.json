  "rdfs:comment": {
    "de": [
      "Nach mehreren Jahren als Saisonarbeiter in der Gastronomie in Frankreich und im Ausland haben wir uns entschlossen, uns selbstständig zu machen und das Restaurant Frencheese in Montluçon zu gründen. Ein Restaurant mit französischer Küche, das sich auf Käse spezialisiert hat."
    ],
    "en": [
      "After several years as seasonal workers in restaurants in France and abroad, we decided to set up our own restaurant, Frencheese, in Montluçon. A French cuisine restaurant specializing in cheese."
    ],
    "it": [
      "Dopo aver lavorato per diversi anni come stagionali in ristoranti in Francia e all'estero, abbiamo deciso di aprire il nostro ristorante, Frencheese, a Montluçon. Un ristorante di cucina francese specializzato in formaggi."
    ],
    "fr": [
      "Après plusieurs années en tant que saisonniers en restauration en France et à l'étranger, nous avons décidé de nous lancer à notre compte et de créer le restaurant Frencheese à Montluçon. Un restaurant de cuisine française, spécialisé dans le fromage."
    ],
    "es": [
      "Tras varios años trabajando como temporeros en restaurantes de Francia y del extranjero, decidimos crear nuestro propio restaurante, Frencheese, en Montluçon. Un restaurante de cocina francesa especializado en quesos."
    ],
    "nl": [
      "Na een aantal jaren als seizoensmedewerker te hebben gewerkt in restaurants in Frankrijk en daarbuiten, besloten we ons eigen restaurant, Frencheese, op te richten in Montluçon. Een restaurant met Franse keuken en gespecialiseerd in kaas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Frencheese Restaurant"
    ]
  },
