  "rdfs:comment": {
    "de": [
      "La Parenthèse des Célestins ? Strandbar & Wasserspaß in Vichy. Eis, Cocktails, Aperitifs an Bord & Entspannung am Ufer des Allier. Wasserfahrrad, Elektrokatamaran, Tretboote und Paddles an einem einzigartigen Ort, Spaß und Familie."
    ],
    "en": [
      "La Parenthèse des Célestins? beach bar & water sports in Vichy. Ice creams, cocktails, aperitifs on board & relaxation on the banks of the Allier. Water bikes, electric catamarans, pedalos and paddles in a unique, fun and family-friendly setting."
    ],
    "it": [
      "La Parenthèse des Célestins? Bar sulla spiaggia e sport acquatici a Vichy. Gelati, cocktail, aperitivi a bordo e relax sulle rive dell'Allier. Biciclette sull'acqua, catamarani elettrici, pedalò e pagaie in un ambiente unico, divertente e familiare."
    ],
    "fr": [
      "La Parenthèse des Célestins – bar de plage & loisirs nautiques à Vichy. Glaces, cocktails, apéros à bord & détente au bord de l’Allier. Vélo sur l’eau, Catamaran électrique, pédalos et paddles dans un lieu unique, fun et familial."
    ],
    "nl": [
      "La Parenthèse des Célestins ? strandbar & watersport in Vichy. IJsjes, cocktails, aperitieven aan boord en ontspanning aan de oevers van de Allier. Fietsen op het water, elektrische catamarans, waterfietsen en peddels in een unieke, leuke en gezinsvriendelijke omgeving."
    ],
    "es": [
      "La Parenthèse des Célestins ? chiringuito y deportes náuticos en Vichy. Helados, cócteles, aperitivos a bordo y relax a orillas del Allier. Bicicletas acuáticas, catamaranes eléctricos, pedales y remos en un entorno único, divertido y familiar."
    ]
  },
  "rdfs:label": {
