  "rdfs:comment": {
    "de": [
      "Das Château Bellevue, ein bukolischer Halt in den Weinbergen, streift die Gipfel der Monts du Beaujolais und bietet einen echten Moment der Entspannung außerhalb der Zeit."
    ],
    "en": [
      "A bucolic stopover in the vineyards, skimming the peaks of the Monts du Beaujolais, Château Bellevue offers a truly relaxing moment relaxation."
    ],
    "it": [
      "Una sosta bucolica tra i vigneti, sfiorando le cime dei Monts du Beaujolais, Château Bellevue offre un momento di relax davvero senza tempo."
    ],
    "fr": [
      "Halte bucolique dans le vignoble, effleurant les cimes des Monts du Beaujolais, le Château Bellevue offre un véritable moment de détente hors du temps."
    ],
    "es": [
      "Parada bucólica en los viñedos, rozando las cumbres de los Montes del Beaujolais, el Château Bellevue ofrece un momento de relajación verdaderamente intemporal."
    ],
    "nl": [
      "Château Bellevue, een bucolische tussenstop in de wijngaarden, langs de toppen van de Monts du Beaujolais, biedt een echt tijdloos moment van ontspanning."
    ]
  },
