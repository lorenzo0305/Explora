  "rdfs:comment": {
    "de": [
      "Das milde Klima der Drôme, eine Oase der Ruhe an den Ufern der Isère. Dieses charmante Hotel-Restaurant, ein ehemaliger Dauphinoise-Bauernhof, lädt Sie zu Entspannung und Erholung ein."
    ],
    "en": [
      "In Drôme's nice weather, a haven of peace and tranquility along the Isère River is waiting for you. The charming Hotel and Restaurant \"Les Vieilles Granges\", ancient farm of the Dauphiné region, is the perfect place to relax and rest."
    ],
    "it": [
      "Il clima mite della Drôme, un'oasi di pace sulle rive dell'Isère, questo hotel-ristorante di charme, un'antica fattoria del Delfinato, vi invita a rilassarvi e distendervi."
    ],
    "fr": [
      "La clémence du climat drômois, un havre de paix sur les rives de l'Isère, cet hôtel-restaurant de charme, ancienne ferme dauphinoise, vous invite à la détente et au repos."
    ],
    "nl": [
      "Dit charmante hotel-restaurant, een voormalige boerderij uit de Dauphiné, is een oase van rust aan de oever van de Isère en nodigt je uit om te ontspannen en tot rust te komen."
    ],
    "es": [
      "Clima suave de la Drôme, remanso de paz a orillas del Isère, este encantador hotel-restaurante, antigua granja del Dauphiné, le invita a relajarse y descansar."
    ]
  },
