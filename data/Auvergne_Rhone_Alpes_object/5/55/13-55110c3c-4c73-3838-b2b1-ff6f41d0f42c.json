  "rdfs:comment": {
    "de": [
      "Ein ungehinderter Wildbach, eine hohe Fischdichte, klare Ufer, dieser Kurs ist ideal für Anfänger und vor allem, um in einer herrlichen Bergkulisse Spaß zu haben!"
    ],
    "en": [
      "An unhindered torrent, a high density of fish, clear banks, this course is ideal for beginners and especially for having fun in a splendid mountain setting!"
    ],
    "it": [
      "Torrente libero, elevata densità di pesci, rive limpide: questo percorso è ideale per i principianti e soprattutto per divertirsi in uno splendido ambiente montano!"
    ],
    "fr": [
      "Un torrent sans encombre, une forte densité de poissons, des berges dégagées, ce parcours est idéal pour les débutants et surtout pour se faire plaisir dans un splendide cadre de montagne !"
    ],
    "es": [
      "Un torrente sin obstáculos, una gran densidad de peces, orillas cristalinas, ¡este recorrido es ideal para principiantes y sobre todo para divertirse en un espléndido entorno de montaña!"
    ],
    "nl": [
      "Een ongehinderde stroming, een hoge visdichtheid en heldere oevers: dit parcours is ideaal voor beginners en vooral voor wie plezier wil hebben in een prachtige bergachtige omgeving!"
    ]
  },
  "rdfs:label": {
    "de": [
      "Angelpfad „Passion“ vom Bach Bissorte nach Orelle"
    ],
    "en": [
      "\"Passion\" Fishing Trail from the Bissorte Stream to Orelle"
    ],
    "it": [
      "Sentiero di pesca \"Passion\" dal torrente Bisorte a Orelle"
    ],
    "fr": [
      "Parcours Pêche \"Passion\" du Ruisseau de Bissorte à Orelle"
    ],
    "nl": [
      "Visroute \"Passie\" van de Bissorte-beek naar Orelle"
    ],
    "es": [
      "Ruta de pesca \"Pasión\" desde el arroyo Bissorte hasta Orelle"
    ]
  },
