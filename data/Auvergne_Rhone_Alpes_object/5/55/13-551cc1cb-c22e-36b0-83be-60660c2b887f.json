  "rdfs:comment": {
    "de": [
      "Savoyische Spezialitäten, Pizzas, Salate, Fleisch, Fisch, Pasta. Eine Reservierung wird empfohlen. Pizzas zum Mitnehmen am besten im Voraus bestellen. Kleine Snacks je nach Nachfrage durchgehend."
    ],
    "en": [
      "Savoyard specialities, pizzas, salads, meat and fish dishes, pasta. Booking advised. Take away pizzas, preferably ordered beforehand. All day snack\r\nservice according to demand.\r\n24 hour pizza vending machine."
    ],
    "it": [
      "Specialità savoiarde, pizze, insalate, carne, pesce, pasta. Si consiglia la prenotazione. Pizze da asporto, preferibilmente ordinate in anticipo. Snack disponibili su richiesta."
    ],
    "fr": [
      "Spécialités savoyardes, pizzas, salades, viandes, poisson, pâtes. Réservation conseillée. Pizzas à emporter à commander à l'avance de préférence. Petite restauration en continu selon la demande."
    ],
    "nl": [
      "Streekspecialiteiten, pizza’s, salades, vlees, vis, pasta. Reserveren angeraden. Pizza’s om mee te nemen bij voorkeur op voorhand te bestellen. Doorlopend\r\nsnacks naargelang de vraag.\r\n24-uurs pizza-automaat."
    ],
    "es": [
      "Especialidades de Saboya, pizzas, ensaladas, carne, pescado, pasta. Se recomienda reservar. Pizzas para llevar, preferiblemente encargadas con antelación. Aperitivos a petición."
    ]
  },
