  "rdfs:comment": {
    "de": [
      "Wenn Sie sich einen Moment des Wohlbefindens gönnen möchten, bietet Ihnen Virginie, eine zertifizierte Wellness-Massage-Praktikerin (FFMBE-zertifiziert), verschiedene Arten von Massagen an."
    ],
    "en": [
      "If you wish to treat yourself to a moment of well-being, Virginie, a certified massage and well-being practitioner (FFMBE certified) will offer you several types of massages."
    ],
    "it": [
      "Se desiderate concedervi un momento di benessere, Virginie, operatrice certificata in massaggi e benessere (accreditata FFMBE), vi offrirà diversi tipi di massaggio."
    ],
    "fr": [
      "Si vous souhaitez vous offrir un moment bien-être, Virginie, praticienne de massage-bien-être certifiée (agréée FFMBE) vous proposera plusieurs types de massages."
    ],
    "es": [
      "Si desea regalarse un momento de bienestar, Virginie, masajista certificada en bienestar (acreditada por la FFMBE) le ofrecerá varios tipos de masaje."
    ],
    "nl": [
      "Als u uzelf wilt trakteren op een moment van welzijn, zal Virginie, een gediplomeerd massage- en welzijnspecialiste (FFMBE geaccrediteerd) u verschillende soorten massage aanbieden."
    ]
  },
