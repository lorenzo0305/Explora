  "rdfs:comment": {
    "de": [
      "Der Lac de Darbon ist ein kleiner Bergsee mit einer Fläche von zwei Hektar auf 1813 m Höhe. Er ist zu Fuß von den Chalets de Bise in Vacheresse aus in einer 1,5-stündigen Wanderung zu erreichen. Fischbestand: Bachforelle, Elritze."
    ],
    "en": [
      "Lac de Darbon is a small, two-hectare mountain lake at 1,813 m altitude, accessible on foot from the Chalets de Bise in Vacheresse in a 1.5-hour hike. Fish population: Fario trout, minnow."
    ],
    "it": [
      "Il Lac de Darbon è un piccolo lago di montagna di due ettari a 1.813 m di altitudine, raggiungibile a piedi dagli Chalets de Bise a Vacheresse con un'escursione di un'ora. Popolazione ittica: trote fario, pesciolini."
    ],
    "fr": [
      "Le lac de Darbon est un petit lac de montagne, d'une surface de deux hectares, situé à 1 813 m d'altitude, accessible à pied depuis les chalets de Bise à Vacheresse en 1h30 de randonnée. Peuplement piscicole : truites Fario, vairon."
    ],
    "nl": [
      "Lac de Darbon is een klein bergmeer van twee hectare op een hoogte van 1.813 m, te voet bereikbaar vanaf de Chalets de Bise in Vacheresse in een wandeling van 1 uur. Vispopulatie: Fario forel, minnow."
    ],
    "es": [
      "Lac de Darbon es un pequeño lago de montaña de dos hectáreas a 1.813 m de altitud, accesible a pie desde los Chalets de Bise en Vacheresse en una hora y media de marcha. Población piscícola: trucha fario, pececillo."
    ]
  },
  "rdfs:label": {
    "en": [
      "Fishing in the Darbon lake"
    ],
    "fr": [
      "Pêche au lac de Darbon"
    ],
    "nl": [
      "Vissen bij het Darbonmeer"
    ]
  },
