  "rdfs:comment": {
    "de": [
      "Spezialität des Tisches mit Plancha. Jeder Tisch ist mit einer integrierten Plancha ausgestattet, auf der jeder Fleisch und/oder Fisch sowie Gemüse grillen kann, dazu gibt es einen Salat und Bratkartoffeln als Beilage. Küche \"hausgemacht\"."
    ],
    "en": [
      "Plancha table specialty. Each table is equipped with a built-in plancha where you can grill meat and/or fish as well as vegetables, accompanied by a salad and grilled potatoes. Home-made cuisine."
    ],
    "it": [
      "Specialità del tavolo Plancha. Ogni tavolo è dotato di una plancha incorporata dove ognuno può grigliare carne e/o pesce, nonché verdure con insalata e patate grigliate a parte. Cucina casalinga."
    ],
    "fr": [
      "Spécialité de table plancha. Chaque table est équipée d'une plancha intégrée où chacun pourra faire griller viande et/ou poisson ainsi que des légumes avec en accompagnement une salade et des pommes de terre grenailles. Cuisine \"fait maison\"."
    ],
    "nl": [
      "Specialiteit van de plancha-tafel. Elke tafel is uitgerust met een ingebouwde plancha waar iedereen vlees en/of vis kan grillen, evenals groenten met een salade en gegrilde aardappelen ernaast. Huisgemaakte gerechten."
    ],
    "es": [
      "Especialidad en mesas con plancha. Cada mesa está equipada con una plancha integrada en la que cada uno puede asar carne y/o pescado, así como verduras con ensalada y patatas asadas aparte. Cocina casera."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Table à Griller"
    ]
  },
