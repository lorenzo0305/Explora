  "rdfs:comment": {
    "de": [
      "Die Bibliothek bietet über 9000 Bücher für alle!\r\nDer Multimediaraum verfügt über 2 Stationen mit VDSL-Internet, die Möglichkeit zu drucken, zu scannen, zu laminieren und zu binden."
    ],
    "en": [
      "The library has more than 9000 books, something for everyone!\r\nThe multimedia room has 2 computers with VDSL internet connection, a printer, scanner, laminator and a binder."
    ],
    "it": [
      "La biblioteca propone oltre 9000 opere per tutti!\r\nLa sala multimedia è dotata di 2 computers con connessione internet, possibilità di stampare, di fare scansioni, di plastificare e classificare."
    ],
    "fr": [
      "La bibliothèque propose plus de 9000 ouvrages pour tous !\r\nLa salle multimédia possède 2 postes avec internet VDSL, possibilité d'imprimer, de scanner, de plastifier et de relier."
    ],
    "es": [
      "La biblioteca cuenta con más de 9.000 libros para todos los gustos\r\nLa sala multimedia dispone de 2 puestos de trabajo con acceso a Internet VDSL, con posibilidad de imprimir, escanear, plastificar y encuadernar."
    ],
    "nl": [
      "De bibliotheek biedt meer dan 9000 werken voor iedereen!\r\nDe multimedia zaal heeft 2 computers met internet VDSL, mogelijk om te printen, scannen, plastificeren en in te binden."
    ]
  },
