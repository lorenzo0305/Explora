  "rdfs:comment": {
    "de": [
      "Diese sensible und zutiefst menschliche Komödie, die mit fünf Molières ausgezeichnet wurde, lässt uns in eine Welt des Bergbaus eintauchen, die von ebenso farbenfrohen wie liebenswerten Charakteren bevölkert wird."
    ],
    "en": [
      "Winner of five Molières awards, this sensitive, deeply human comedy plunges us into a mining world populated by characters as colorful as they are endearing."
    ],
    "it": [
      "Vincitrice di cinque Molières, questa commedia sensibile e profondamente umana ci immerge in un mondo minerario popolato da personaggi tanto colorati quanto accattivanti."
    ],
    "fr": [
      "Auréolée de cinq Molières, cette comédie sensible et profondément humaine nous plonge dans un univers minier peuplé de personnages aussi hauts en couleur qu’attachants."
    ],
    "nl": [
      "Winnaar van vijf Molières, deze gevoelige en diep menselijke komedie dompelt ons onder in een mijnwereld bevolkt door even kleurrijke als vertederende personages."
    ],
    "es": [
      "Ganadora de cinco Molières, esta comedia sensible y profundamente humana nos sumerge en un mundo minero poblado por personajes tan pintorescos como entrañables."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Du Charbon dans les Veines - Jean-Philippe Daguerre"
    ]
  },
