  "rdfs:comment": {
    "de": [
      "Um 1900 für Charles Taillefer, den Rechtsberater der französischen Botschaft\r\nin London, erbaut und dann in den Thermalkomplex des Châtelet integriert, gleicht diese große Villa mit einem Türmchen einem kleinen Schloss."
    ],
    "en": [
      "Built around 1900 for Charles Taillefer, legal counsel to the French Embassy in\r\nLondon, then integrated to the Châtelet thermal baths, this large villa with a turret\r\nlooks like a small castle."
    ],
    "it": [
      "Costruita intorno al 1900 per Charles Taillefer, consulente legale dell'ambasciata francese a Londra, e poi integrata nel complesso termale dello Châtelet, questa grande villa con torretta sembra un piccolo castello."
    ],
    "fr": [
      "Construite vers 1900 pour Charles Taillefer, avocat-conseil de l'ambassade de France à Londres, puis intégrée dans le complexe thermal du Châtelet, cette grande villa agrémentée d'une tourelle ressemble à un petit château."
    ],
    "nl": [
      "Deze grote villa met torentje werd rond 1900 gebouwd voor Charles Taillefer, juridisch adviseur van de Franse ambassade in Londen, en werd vervolgens opgenomen in het kuuroordcomplex Châtelet. Het lijkt op een klein kasteel."
    ],
    "es": [
      "Construida en torno a 1900 para Charles Taillefer, consejero jurídico de la Embajada de Francia en Londres, y luego integrada en el complejo termal de Châtelet, esta gran villa con torreón parece un pequeño castillo."
    ]
  },
