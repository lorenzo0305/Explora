  "rdfs:comment": {
    "de": [
      "Die Natur - gibt es einen größeren Garten? Entdecken Sie sie gemeinsam!\r\nLeo, ein Naturanimateur, bietet Animationen rund um die Umwelt und die Berge an, um sie besser kennen, lieben und schützen zu lernen."
    ],
    "en": [
      "Is there a bigger garden than Nature? Discover it together! Léo, nature educator, offers workshops and events on the environment and mountain in order to know it better, to love it and protect it."
    ],
    "it": [
      "C'è un giardino più grande là fuori? Scopriamolo insieme!\r\nLéo, coordinatore naturalistico, propone attività intorno all'ambiente e alle montagne per aiutarvi a comprenderle, amarle e proteggerle."
    ],
    "fr": [
      "La nature, y a-t-il un jardin plus grand ? Découvrez-la ensemble ! \r\nLéo, animateur nature, propose des animations autour de l'environnement et de la montagne pour mieux la connaitre, l'aimer et la protéger."
    ],
    "es": [
      "¿Existe un jardín más grande? ¡Descúbranlo juntos!\r\nLéo, coordinador de naturaleza, te propone actividades en torno al medio ambiente y la montaña para ayudarte a comprenderlos, amarlos y protegerlos."
    ],
    "nl": [
      "Is er een grotere tuin? Ontdek het samen!\r\nLéo, natuurcoördinator, biedt activiteiten rond het milieu en de bergen om je te helpen ze te begrijpen, lief te hebben en te beschermen."
    ]
  },
