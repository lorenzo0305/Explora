  "rdfs:comment": {
    "de": [
      "Léna & Steve begrüßen Sie jeden Tag im Motown Café von 9.00 Uhr morgens bis 22.00 Uhr abends in einer warmen und gemütlichen Atmosphäre. Täglich werden ab 18 Uhr Tapas angeboten"
    ],
    "en": [
      "Léna & Steve welcome you every day at the Motown café from 9am to 10pm in a warm and cosy atmosphere. Every day, tapas boards are offered from 6pm onwards."
    ],
    "it": [
      "Léna & Steve vi accolgono ogni giorno al Motown café dalle 9.00 alle 22.00 in un'atmosfera calda e accogliente. Tutti i giorni, a partire dalle 18.00, vengono offerti dei taglieri di tapas.Léna & Steve welcome you every day at the Motown café from 9am to 10pm in a warm and cosy atmosphere. Every day, tapas boards are offered from 6pm onwards."
    ],
    "fr": [
      "Léna & Steve vous accueillent tous les jours au Motown café  de 9h00 du matin jusqu’à 22H00 dans un cadre chaleureux et feutré. Tous les jours planches de tapas offertes à partir de 18h00"
    ],
    "es": [
      "Léna y Steve le dan la bienvenida todos los días en el café Motown de 9 a 22 horas en un ambiente cálido y acogedor. Todos los días se ofrecen tablas de tapas a partir de las 18:00 horas"
    ],
    "nl": [
      "Léna & Steve verwelkomen u elke dag in het Motown café van 9 tot 22 uur in een warme en gezellige sfeer. Elke dag worden er vanaf 18.00 uur tapasplanken aangeboden"
    ]
  },
