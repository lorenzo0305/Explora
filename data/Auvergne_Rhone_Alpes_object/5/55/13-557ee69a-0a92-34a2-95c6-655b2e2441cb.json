  "rdfs:comment": {
    "de": [
      "Im Restaurant \"La Rôtisserie\" mit seinem Bergambiente genießen Sie die knisternde Glut des Kamins und die schönen Fleischstücke, die über dem Holzfeuer zubereitet werden."
    ],
    "en": [
      "In the mountain-style restaurant \"La Rôtisserie\", you'll enjoy the crackling embers of the fireplace and fine cuts of meat cooked over a wood fire."
    ],
    "it": [
      "Nel ristorante in stile montano \"La Rôtisserie\", potrete godervi le braci scoppiettanti del camino e i pregiati tagli di carne cotti sul fuoco a legna."
    ],
    "fr": [
      "Au restaurant « La Rôtisserie » et son ambiance montagne, vous apprécierez le crépitement des braises de la cheminée et les belles pièces de viandes cuites au feu de bois."
    ],
    "nl": [
      "In het bergrestaurant \"La Rôtisserie\" geniet je van het knisperen van de open haard en de fijne stukken vlees die boven een houtvuur worden bereid."
    ],
    "es": [
      "En el restaurante de estilo montañés \"La Rôtisserie\", disfrutará del crepitar de las brasas de la chimenea y de los finos cortes de carne cocinados a la leña."
    ]
  },
  "rdfs:label": {
    "en": [
