  "rdfs:comment": {
    "de": [
      "Die geografische Lage von Bésayes macht es zu einer unbestrittenen Touristenattraktion! Hier gibt es keine Sehenswürdigkeiten zu besichtigen, aber Bésayes ist ein charmantes kleines Dorf, durch das Sie bei einem grünen Ausflug sicher kommen werden!"
    ],
    "en": [
      "Bésayes' geographical location makes it an undeniable tourist attraction! There are no monuments to visit here, but Bésayes is a charming little village that you're sure to want to pass through on your green getaway!"
    ],
    "it": [
      "La posizione geografica di Bésayes ne fa un'innegabile attrazione turistica! Non ci sono monumenti da visitare, ma Bésayes è un piccolo villaggio affascinante che sicuramente vorrete attraversare durante il vostro viaggio in campagna!"
    ],
    "fr": [
      "La situation géographique de Bésayes lui confère une attraction touristique indiscutable ! Ici pas de monuments à visiter, mais Bésayes est un charmant petit village par lequel vous passerez sans doute lors d'une escapade verte !"
    ],
    "es": [
      "La situación geográfica de Bésayes lo convierte en una atracción turística innegable No hay monumentos que visitar, pero Bésayes es un pueblecito encantador por el que seguro querrá pasar de camino al campo"
    ],
    "nl": [
      "De geografische ligging van Bésayes maakt het een onmiskenbare toeristische trekpleister! Er zijn hier geen monumenten om te bezoeken, maar Bésayes is een charmant dorpje waar je zeker doorheen wilt op weg naar het platteland!"
    ]
  },
