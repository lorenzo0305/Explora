  "rdfs:comment": {
    "de": [
      "Im Rahmen des Programms Vichy Vitalité bietet Garest Gym Volontaire maximal 2 Schnupperkurse pro Person an: Zumba.\r\nInformationen und Anmeldung per Telefon."
    ],
    "en": [
      "As part of the Vichy Vitality program, Garest Gym Volontaire offers a maximum of 2 discovery classes per person: Zumba.\r\nInformation and registration by telephone."
    ],
    "it": [
      "Nell'ambito del programma Vichy Vitality, la Palestra Volontaire di Garest propone un massimo di 2 lezioni di scoperta a persona: Zumba.\r\nInformazioni e iscrizioni telefoniche."
    ],
    "fr": [
      "Dans le cadre du programme Vichy Vitalité, Garest Gym Volontaire propose 2 cours maximum par personne de découverte :  Zumba.\r\nRenseignements et inscription par téléphone."
    ],
    "nl": [
      "In het kader van het vitaliteitsprogramma van Vichy biedt Garest Gym Volontaire maximaal 2 ontdekkingslessen per persoon: Zumba.\r\nInformatie en inschrijving per telefoon."
    ],
    "es": [
      "En el marco del programa Vichy Vitality, Garest Gym Volontaire propone un máximo de 2 clases de descubrimiento por persona: Zumba.\r\nInformación e inscripciones por teléfono."
    ]
  },
