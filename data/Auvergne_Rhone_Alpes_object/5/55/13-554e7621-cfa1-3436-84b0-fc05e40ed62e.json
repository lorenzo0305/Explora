  "rdfs:comment": {
    "de": [
      "Große Auswahl an Büchern für alle Altersgruppen: Alben, Märchen, Sachbücher, Comics, ... Aber auch digitale Bücher, CDs und DVDs. Animationen für Kinder und Erwachsene das ganze Jahr über"
    ],
    "en": [
      "Wide selection of items to suit all ages, including picture books, fairytales, novels, documentary items and comic books, as well as Ebooks, CDs and DVDs. Activities organised throughout the year for both children and adults."
    ],
    "it": [
      "Ampia scelta di libri per tutte le età: album, racconti, romanzi di saggistica, fumetti, ecc. Ma anche libri digitali, CD e DVD. Attività per bambini e adulti durante tutto l'anno"
    ],
    "fr": [
      "Large choix d'ouvrages pour tous les âges : albums, contes, romans documentaires, BD, ... Mais également livres numériques, CD et DVD. animations enfants et adultes tout au long de l'année"
    ],
    "nl": [
      "Ruime keuze aan boeken voor alle leeftijden: albums, verhalen, non-fictie romans, strips, enz. Maar ook digitale boeken, cd's en dvd's. Activiteiten voor kinderen en volwassenen het hele jaar door"
    ],
    "es": [
      "Amplia selección de libros para todas las edades: álbumes, cuentos, novelas de no ficción, cómics, etc. Pero también libros digitales, CD y DVD. Actividades para niños y adultos durante todo el año"
    ]
  },
