  "rdfs:comment": {
    "de": [
      "Bei der 14. Ausgabe des Rock The Pistes Festivals wird Cachemire nur eine Sekunde brauchen, um euch mit seinen aggressiven Gitarrenriffs, harten Drums und bissigen Texten zu begeistern. In Plaine Dranse wird gerockt!"
    ],
    "en": [
      "For the 14th edition of the Rock The Pistes Festival, Cachemire will need just a second to shake you to your core with their corrosive guitars, pounding drums, and caustic lyrics. It's going to rock at Plaine Dranse."
    ],
    "it": [
      "Per la 14ª edizione del Rock The Pistes Festival, i Cachemire vi faranno tremare le ossa con le loro chitarre corrosive, la batteria martellante e i testi caustici. Ci sarà da divertirsi alla Plaine Dranse."
    ],
    "fr": [
      "Pour la 14 ème édition du Rock The Pistes Festival, il suffira à Cachemire d'une seconde pour ébranler vos os à grands renforts de guitares corrosives, de batteries claquées et de textes caustiques. Ça va être rock à Plaine Dranse."
    ],
    "nl": [
      "Voor de 14e editie van het Rock The Pistes Festival heeft Cachemire slechts een seconde nodig om je botten te laten trillen met bijtende gitaren, knallende drums en scherpe teksten. Het wordt rocken in Plaine Dranse."
    ],
    "es": [
      "En la 14ª edición del festival Rock The Pistes, Cachemire te sacudirá los huesos con sus guitarras corrosivas, sus tambores contundentes y sus letras cáusticas. Habrá rock en Plaine Dranse."
    ]
  },
