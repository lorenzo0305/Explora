  "rdfs:comment": {
    "de": [
      "Dieses kleine, ruhige Hotel liegt im Herzen des historischen Zentrums, nur wenige Schritte von der Basilika Saint-Julien entfernt und verfügt über eine sehr angenehme Terrasse"
    ],
    "en": [
      "Located in the heart of the historic center, a few steps away from the Saint-Julien basilica, this small and quiet hotel has a very pleasant terrace, a very charming welcome"
    ],
    "it": [
      "Situato nel cuore del centro storico, a pochi passi dalla Basilica di St. Julien, questo piccolo e tranquillo hotel vanta una piacevole terrazza e un'accoglienza calorosa"
    ],
    "fr": [
      "Situé en plein cœur du centre historique, à deux pas de la basilique Saint-Julien, ce petit hôtel calme dispose d'une terrasse fort agréable, un accueil des plus charmants"
    ],
    "es": [
      "Situado en el corazón del centro histórico, a dos pasos de la Basílica de San Julián, este pequeño y tranquilo hotel cuenta con una agradable terraza, una cálida acogida y un personal amable"
    ],
    "nl": [
      "Dit kleine, rustige hotel ligt in het hart van het historische centrum, op een steenworp afstand van de Basiliek van St. Julien. Het beschikt over een aangenaam terras, een warm onthaal en vriendelijk personeel"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Hôtel du centre"
    ]
  },
