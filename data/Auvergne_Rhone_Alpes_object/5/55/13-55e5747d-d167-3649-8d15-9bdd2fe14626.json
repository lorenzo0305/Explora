  "rdfs:comment": {
    "de": [
      "The Wall liegt im Herzen von Aix-les-Bains und ist ein einzigartiges, urbanes Konzept: Pizzen, Tapas nach Belieben, eine Bierwand, Sportveranstaltungen auf Großbildschirmen, Darts und Tischfußball? Ein lustiger und geselliger Ort, der dazu gedacht ist, authentische Momente zu teilen."
    ],
    "en": [
      "Located in the heart of Aix-les-Bains, The Wall is a unique, urban concept: all-you-can-eat pizza, a beer wall, sporting events on giant screens, darts, and foosball... A fun and friendly place, designed for sharing authentic moments."
    ],
    "it": [
      "Situato nel cuore di Aix-les-Bains, The Wall è un concept unico e urbano: pizza a volontà, parete di birre, eventi sportivi su maxischermi, freccette e calcio balilla... Un luogo divertente e conviviale, pensato per condividere momenti autentici."
    ],
    "fr": [
      "Situé au cœur d’Aix-les-Bains, The Wall est un concept unique et urbain : pizzas, tapas  à volonté, mur de bières, événements sportifs sur écrans géants, fléchettes et babyfoot… Un lieu fun et convivial, pensé pour partager des instants authentiques."
    ],
    "nl": [
      "The Wall, gelegen in het hart van Aix-les-Bains, is een uniek, stedelijk concept met pizza's, onbeperkt tapas, een biermuur, sportevenementen op reuzenschermen, darts en tafelvoetbal? Het is een leuke, vriendelijke plek, ontworpen voor het delen van authentieke momenten."
    ],
    "es": [
      "Situado en el corazón de Aix-les-Bains, The Wall es un concepto único y urbano que ofrece pizzas, tapas ilimitadas, un muro de cerveza, eventos deportivos en pantallas gigantes, dardos y futbolín.. Es un lugar divertido y acogedor, pensado para compartir momentos auténticos."
    ]
  },
