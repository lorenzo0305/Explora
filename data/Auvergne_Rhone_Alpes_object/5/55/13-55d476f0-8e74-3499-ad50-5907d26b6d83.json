  "rdfs:comment": {
    "de": [
      "Das Museum erzählt die Geschichte des ehemaligen Sanatoriums des Departements Felleries-Liessies, das 1933 zur Behandlung von Tuberkulosepatienten gegründet wurde."
    ],
    "en": [
      "The museum traces the history of the former departmental sanatorium at Felleries-Liessies, created in 1933 to care for patients suffering from tuberculosis."
    ],
    "it": [
      "Il museo ripercorre la storia dell'ex sanatorio dipartimentale di Felleries-Liessies, istituito nel 1933 per curare i pazienti affetti da tubercolosi."
    ],
    "fr": [
      "Le musée retrace l’Histoire de l’ancien sanatorium départemental de Felleries-Liessies, créé en 1933 pour prendre en charge les patients atteints de la tuberculose."
    ],
    "nl": [
      "Het museum vertelt de geschiedenis van het voormalige departementale sanatorium in Felleries-Liessies, dat in 1933 werd opgericht om tuberculosepatiënten te behandelen."
    ],
    "es": [
      "El museo recorre la historia del antiguo sanatorio departamental de Felleries-Liessies, creado en 1933 para tratar a pacientes tuberculosos."
    ]
  },
  "rdfs:label": {
