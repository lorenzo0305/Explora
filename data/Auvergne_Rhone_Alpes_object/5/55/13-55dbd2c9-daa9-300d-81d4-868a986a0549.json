  "rdfs:comment": {
    "de": [
      "Elegant & kulturell\r\nMit Eleganz begrüßen wir Amélie Jardel Lecoeur und ihre Geschmeidigkeit.\r\nEine sensible und poetische Ausstellung, die es in Moulins zu entdecken gilt."
    ],
    "en": [
      "Elegant & cultural\r\nIt's with elegance that we welcome Amélie Jardel Lecoeur and her souplesses.\r\nA sensitive and poetic exhibition to discover in Moulins."
    ],
    "it": [
      "Elegante e culturale\r\nSiamo lieti di accogliere Amélie Jardel Lecoeur e le sue morbide opere.\r\nUna mostra sensibile e poetica da scoprire a Moulins."
    ],
    "fr": [
      "Élégant & culturel\r\nC’est avec élégance que nous accueillons Amélie Jardel Lecoeur et ses souplesses.\r\nUne exposition sensible et poétique à découvrir à Moulins."
    ],
    "es": [
      "Elegante y cultural\r\nEstamos encantados de recibir a Amélie Jardel Lecoeur y sus obras flexibles.\r\nUna exposición sensible y poética para descubrir en Moulins."
    ],
    "nl": [
      "Elegant & cultureel\r\nWe zijn verheugd Amélie Jardel Lecoeur en haar soepele werken te mogen verwelkomen.\r\nEen gevoelige en poëtische tentoonstelling om te ontdekken in Moulins."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Exposition : Les souplesses"
    ]
  },
