  "rdfs:comment": {
    "de": [
      "La Cure, Pôle métiers d'art, stellt lokale und nationale Kunsthandwerker ins Rampenlicht, indem sie ihre Kreationen in drei zeitlich begrenzten Ausstellungen präsentieren. Jedes Werk zeugt von einem einzigartigen Know-how. Die Stücke werden zum Verkauf angeboten."
    ],
    "en": [
      "La Cure, Pôle métiers d?art, showcases local and national craftsmen, presenting their creations in 3 temporary exhibitions. Each piece bears the imprint of a unique savoir-faire. Pieces are offered for sale."
    ],
    "it": [
      "La Cure, Pôle métiers d'art, valorizza gli artigiani locali e nazionali presentando le loro creazioni in 3 mostre temporanee. Ogni pezzo porta il segno di un'abilità unica. I pezzi sono disponibili per la vendita."
    ],
    "fr": [
      "La Cure, Pôle métiers d’art, met en lumière des artisans d’art locaux et nationaux en présentant leurs créations à travers 3 expositions temporaires. Chaque réalisation porte la trace d’un savoir-faire unique. Les pièces sont proposées à la vente."
    ],
    "nl": [
      "La Cure, Pôle métiers d'art, zet lokale en nationale ambachtslieden in de kijker door hun creaties te presenteren in 3 tijdelijke tentoonstellingen. Elk stuk draagt het stempel van een uniek vakmanschap. De stukken zijn te koop."
    ],
    "es": [
      "La Cure, Pôle métiers d'art, pone en valor a los artesanos locales y nacionales presentando sus creaciones en 3 exposiciones temporales. Cada pieza lleva la marca de una habilidad única. Las piezas están a la venta."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Cure, Exposition artisanat d'art"
    ]
  },
