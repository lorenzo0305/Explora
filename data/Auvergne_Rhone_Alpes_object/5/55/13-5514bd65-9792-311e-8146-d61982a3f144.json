  "rdfs:comment": {
    "de": [
      "Höhle von Ali Baba: Geschenke, Erinnerungen, Trikotage, provenzalische Gewebe und Verschiedene, Spielzeuge, Basar, Sport- und Campingartikel, Kurzwaren, Konfektionskleidung: Mann(Mensch), Frau, Kind."
    ],
    "en": [
      "Aladdin's cave: presents, memories(souvenirs), hosiery, Provençal fabrics(tissues) and miscellaneous, toys, general store(mess), articles of campsite(camping) sport, and fishing, notions(notions store), ready-to-wear clothing: man, woman, child."
    ],
    "it": [
      "Prêt-à-porter: uomo, donna e bambino.\r\nGiocattoli, campeggi, merceria, calzetteria,\r\npesca, tessuti, souvenir, regali.\r\n\r\nNegozio universale fondato nel 1896 e visto in TV!"
    ],
    "fr": [
      "Prêt-à-porter : homme, femme, enfant.\r\nJouets, campings, merceries, bonneteries, \r\npêches, tissus, souvenirs, cadeaux.\r\n\r\nMagasin universel fondé en 1896 vu à la TV!..."
    ],
    "es": [
      "Prêt-à-porter: hombre, mujer y niño.\r\nJuguetes, campings, mercería, calcetería,\r\npesca, tejidos, souvenirs, regalos.\r\n\r\nTienda universal fundada en 1896 ¡y vista en televisión!"
    ],
    "nl": [
      "Confectiekleding: mannen, vrouwen en kinderen.\r\nSpeelgoed, campings, fournituren, kousen,\r\nvisserij, stoffen, souvenirs, cadeaus.\r\n\r\nUniversele winkel opgericht in 1896 en gezien op tv!"
    ]
  },
