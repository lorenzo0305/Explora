  "rdfs:comment": {
    "de": [
      "Jackie, Christelle und Michael empfangen Sie im Herzen der Limagne zwischen Clermont-Ferrand und Thiers in einer gemütlichen Umgebung. Das gesamte Team bietet Ihnen einen qualitativ hochwertigen, effizienten und freundlichen Service."
    ],
    "en": [
      "Jackie, Christelle and Michael welcome you in the heart of the Limagne, between Clermont-Ferrand and Thiers. The whole team invites you to enjoy the warm and welcoming space where they offer qua- lity, efficient service with a smile. 1/05 > 30/09: open for lunch from Wednesday to Sunday and for dinner from Thursday to Saturday. 1/10 > 30/04: open for lunch from Wednesday to Sunday and for din- ner Friday and Saturday."
    ],
    "it": [
      "Jackie, Christelle e Michael vi danno il benvenuto nel cuore della regione della Limagne, tra Clermont-Ferrand e Thiers, in un ambiente accogliente. L'intero team vi offre un servizio di qualità, efficiente e cordiale."
    ],
    "fr": [
      "Jackie, Christelle et Michael vous accueille au cœur de la Limagne entre Clermont-Ferrand et Thiers, dans un cadre chaleureux. Toute l’équipe vous propose un service de qualité, efficace et convivial."
    ],
    "es": [
      "Jackie, Christelle y Michael le dan la bienvenida al corazón de la región de Limagne, entre Clermont-Ferrand y Thiers, en un entorno cálido. Todo el equipo le ofrece un servicio de calidad, eficiente y amable."
    ],
    "nl": [
      "Jackie, Christelle en Michael heten u welkom in het hart van de Limagne tussen Clermont-Ferrand en Thiers, in een warme omgeving. Het hele team biedt u een kwalitatieve, efficiënte en vriendelijke service."
    ]
  },
  "rdfs:label": {
