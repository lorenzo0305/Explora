  "rdfs:comment": {
    "de": [
      "Bücher können vor Ort eingesehen oder ausgeliehen werden, Zugang zu 4000 Büchern und zahlreichen Spielen.\r\nAusleihmöglichkeiten: 3 Bücher pro Leser und 3 oder 4 Comics für eine maximale Dauer von 3 Wochen."
    ],
    "en": [
      "Books to consult on site or on loan, access to 4000 works and numerous games.\r\nPossibility of borrowing: 3 books per reader and 3 or 4 comics for a maximum duration of 3 weeks."
    ],
    "it": [
      "Libri da consultare sul posto o in prestito, accesso a 4000 libri e molti giochi.\r\nPossibilità di prestito: 3 libri per lettore e 3 o 4 fumetti per un massimo di 3 settimane."
    ],
    "fr": [
      "Livres à consulter sur place ou en prêt, accès à 4000 ouvrages et de nombreux jeux.\r\nPossibilité d'emprunt : 3 ouvrages par lecteur et 3 ou 4 BD pour une durée maximale de 3 semaines."
    ],
    "es": [
      "Libros para consultar in situ o en préstamo, acceso a 4000 libros y muchos juegos.\r\nPosibilidad de préstamo: 3 libros por lector y 3 o 4 cómics durante un máximo de 3 semanas."
    ],
    "nl": [
      "Boeken ter plaatse te raadplegen of te leen, toegang tot 4.000 boeken en veel spelletjes.\r\nMogelijkheid tot lenen: 3 boeken per lezer en 3 of 4 stripboeken voor maximaal 3 weken."
    ]
  },
