  "rdfs:comment": {
    "de": [
      "Mitten im Herzen der Ardèche-Schluchten, nahe Vallon-Pont-d'Arc, Ruoms, Les Vans und Barjac, erwartet Sie im Adventure Camp ein unvergessliches Abenteuer: Baumwipfelpfade, Klettersteige, gigantische Seilrutschen über den Fluss! Paintball und sogar ein Escape Game im Wald!"
    ],
    "en": [
      "Family fun between Vallon Pont d'Arc and Ruoms. A treetop adventure course covering 8 hectares in an outdoor activity centre at the heart of a 100-year-old riverside forest. 17 shaded trails, suitable for children from 2 years old, 500-metre zip wire across the river, Via ferrata, swimming."
    ],
    "it": [
      "Nel cuore delle Gole dell'Ardèche, vicino a Vallon-Pont-d'Arc, Ruoms, Les Vans e Barjac, venite a vivere l'avventura al Campo Avventura: Accrobranche, Via Ferrata, Tiroliennes giganti sul fiume! Painball e persino un Escape Game nella foresta!"
    ],
    "fr": [
      "Au cœur du territoire des Gorges de l’Ardèche, près de Vallon-Pont-d’Arc, Ruoms, Les Vans et Barjac, venez vivre l’aventure à Adventure Camp : Accrobranche, Via Ferrata, Tyroliennes géantes au-dessus de la rivière ! Painball et même Escape Game en Forêt !"
    ],
    "es": [
      "¡En el corazón de las Gargantas del Ardèche, cerca de Vallon-Pont-d'Arc, Ruoms, Les Vans y Barjac, venga a vivir la aventura en el Campamento de Aventura: Accrobranche, Vía Ferrata, tirolina gigante sobre el río! Painball e incluso un juego de escape en el bosque"
    ],
    "nl": [
      "In het hart van de Ardèche Gorges, vlakbij Vallon-Pont-d'Arc, Ruoms, Les Vans en Barjac, beleef je avontuur in Adventure Camp: klimparcoursen in de boomtoppen, via ferrata's, gigantische ziplines over de rivier! Paintball en zelfs een escape game in het bos!"
    ]
  },
