  "rdfs:comment": {
    "de": [
      "Julien und Cathy züchten Schafe und Schweine auf ihrem Bauern- und Bio-Bauernhof in Matheysine.\r\nSie bieten Ihnen Käse und Joghurt aus Schafsmilch, Lamm- und Schweinefleisch sowie Gemüse an."
    ],
    "en": [
      "Julien and Cathy raise sheeps and pigs on their organic farm located in Matheysine.\r\nThey offer sheep's milk cheeses and yogurts, lamb and pork, and vegetables."
    ],
    "it": [
      "Julien e Cathy ellevano pecore e maiali nella loro fattoria bio situata in Matheysine.\r\nOffrono formaggi e yogurt di pecore, carne di agnello e di porco anzi che verdure."
    ],
    "fr": [
      "Julien et Cathy élèvent des brebis et des cochons sur leur ferme paysanne et bio située en Matheysine.\r\nIls vous proposent des fromages et yahourts de brebis, de la viande d'agneau et de porc ainsi que des légumes."
    ],
    "es": [
      "Julien y Cathy crían ovejas y cerdos en su granja ecológica de la región de Matheysine.\r\nOfrecen quesos y yogures de oveja, carne de cordero y cerdo y verduras."
    ],
    "nl": [
      "Julien en Cathy houden schapen en varkens op hun biologische boerderij in de Matheysine streek.\r\nZe bieden schapenkaas en -yoghurt, lams- en varkensvlees en groenten."
    ]
  },
  "rdfs:label": {
    "en": [
      "Farm sales - La Bergerie de la Roizonne"
    ],
    "it": [
      "Vendita diretta alla ferma - La Bergerie de la Roizonne"
    ],
    "fr": [
      "La Bergerie de la Roizonne - Vente à la ferme"
    ]
  },
