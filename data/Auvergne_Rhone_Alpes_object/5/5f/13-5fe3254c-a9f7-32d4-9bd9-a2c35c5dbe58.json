  "rdfs:comment": {
    "de": [
      "Der Strand von Redon liegt an der Mündung des Flusses Redon und ist ein natürlicher Strand mit Grasfläche. Dieser Strand wird Ihnen einen unvergesslichen Moment bescheren. Die Bäume sorgen für schattige Bereiche."
    ],
    "en": [
      "The Redon beach, located at the mouth of the Redon river, is a natural beach with a grassy area. You'll have a memorable time on this beach. Trees provide shaded areas."
    ],
    "it": [
      "La spiaggia di Redon, situata alla foce del fiume Redon, è una spiaggia naturale con un'area erbosa. Questa spiaggia vi regalerà momenti memorabili. Gli alberi offrono zone d'ombra."
    ],
    "fr": [
      "La plage du Redon située à l'embouchure de la rivière du Redon est une plage naturelle avec espace en herbe. Cette plage vous fera un moment mémorable. Les arbres vous permettront d'avoir des zones ombragées."
    ],
    "es": [
      "La playa del Redon, situada en la desembocadura del río Redon, es una playa natural con zona de césped. Esta playa le hará pasar momentos inolvidables. Los árboles proporcionan zonas de sombra."
    ],
    "nl": [
      "Het strand van Redon, gelegen aan de monding van de rivier de Redon, is een natuurlijk strand met gras. Dit strand bezorgt je een onvergetelijke tijd. De bomen zorgen voor schaduwrijke plekken."
    ]
  },
  "rdfs:label": {
    "de": [
      "Strand von Redon"
    ],
    "en": [
      "Redon Beach"
    ],
    "fr": [
      "Plage du Redon"
    ]
  },
