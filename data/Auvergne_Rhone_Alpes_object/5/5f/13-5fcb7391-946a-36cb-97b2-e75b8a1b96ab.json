  "rdfs:comment": {
    "de": [
      "Mit seinen 12 Bowlingbahnen und seinem 400 m² großen Lazer Game bietet Ihnen das Lokal vor Ort Verpflegung für jedes Budget und auf der Grundlage von Spezialitäten aus den USA: Burger, Salate, handgemachte Pizzas, Crêpes und Desserts. Aperitifplatten und Tapas."
    ],
    "en": [
      "With its 12 bowling lanes and its 400m² lazer game, the establishment offers on-site catering, for all budgets and based on American specialties: Burgers, salads, homemade pizzas, pancakes and desserts. Aperitif boards and tapas."
    ],
    "it": [
      "Con le sue 12 piste da bowling e il suo gioco del lazer di 400 m², la struttura offre una ristorazione in loco per tutte le tasche e basata su specialità americane: hamburger, insalate, pizze fatte in casa, pancake e dessert. Tavoli da aperitivo e tapas."
    ],
    "fr": [
      "Avec ses 12 pistes de bowling et son lazer game de 400m², l'établissement vous propose une restauration sur place, pour tous les budgets et à base de spécialités USA : Burgers, salades, pizzas artisanales, crêpes et desserts. Planches apéro et tapas."
    ],
    "nl": [
      "Met zijn 12 bowlingbanen en zijn lazerspel van 400 m² biedt het etablissement ter plaatse catering voor alle budgetten en op basis van Amerikaanse specialiteiten: hamburgers, salades, huisgemaakte pizza's, pannenkoeken en desserts. Aperitiefplankjes en tapas."
    ],
    "es": [
      "Con sus 12 pistas de bolos y su juego de lazer de 400m², el establecimiento ofrece un servicio de restauración in situ para todos los presupuestos y basado en especialidades estadounidenses: hamburguesas, ensaladas, pizzas caseras, tortitas y postres. Tablas de aperitivos y tapas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant du bowling Burger Bowl"
    ]
  },
