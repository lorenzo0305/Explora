  "rdfs:comment": {
    "de": [
      "Sébastien, der im Tal von Entremonts geboren wurde, ist Kunsthandwerker und Messerschmied. Seine Werkstatt befindet sich im Herzen des Massivs, in St Pierre d'Entremont. Er stellt alle seine Messer mit seinen eigenen Händen her. Die Messer bestehen zu 100 % aus der Chartreuse und sind ethisch vertretbar."
    ],
    "en": [
      "Sébastien, a native of the Entremonts valley, is a craftsman specialising in cutlery and blacksmithing. His workshop is located in the heart of the mountains, in St Pierre d'Entremont. He makes all of his knives by hand. They are 100% Chartreuse and ethical knives."
    ],
    "it": [
      "Sébastien, originario della valle di Entremonts, è un artigiano tagliatore e fabbro. Il suo laboratorio si trova nel cuore del massiccio, a St Pierre d'Entremont. Realizza personalmente tutti i suoi coltelli. I suoi coltelli sono 100% Chartreuse ed etici."
    ],
    "fr": [
      "Sébastien, natif de la vallée des Entremonts, est artisan d'art coutelier/forgeron. Son atelier est situé au cœur de massif, à St Pierre d'Entremont. Il fabrique de ses mains la totalité de ses couteaux. Se sont des couteaux 100% Chartreuse et éthiques."
    ],
    "es": [
      "Sébastien, natural del valle de Entremonts, es cuchillero y herrero artesano. Su taller se encuentra en el corazón del macizo, en St Pierre d'Entremont. Él mismo fabrica todos sus cuchillos. Sus cuchillos son 100% Chartreuse y éticos."
    ],
    "nl": [
      "Sébastien, afkomstig uit de Entremonts-vallei, is een ambachtelijke messenmaker en smid. Zijn werkplaats bevindt zich in het hart van het massief, in St Pierre d'Entremont. Hij maakt al zijn messen zelf. Zijn messen zijn 100% Chartreuse en ethisch verantwoord."
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'Ame de Chartreuse"
    ]
  },
