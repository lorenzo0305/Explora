  "rdfs:comment": {
    "de": [
      "Auf dem Teller ein Gast: die provenzalische Drôme und ihre Gaumenfreuden! Jérôme, unser Küchenchef, wird Ihnen eine regionale Küche voller Düfte und Geschmäcker näher bringen."
    ],
    "en": [
      "The Hotel and Restaurant \"Le Jabron\" is situated on the way out of the village of La Bégude de Mazenc. It is surrounded by lavender fields and benefits from the famous microclimate of Dieulefit."
    ],
    "it": [
      "Nel piatto, un ospite: la Drôme Provençale e i suoi piaceri gastronomici! Jérôme, il nostro chef, vi farà scoprire e apprezzare una cucina locale ricca di sapori e aromi."
    ],
    "fr": [
      "Dans l’assiette, une invitée : la Drôme provençale et ses plaisirs gourmands ! Jérôme, notre chef saura vous faire découvrir et apprécier une cuisine du terroir riche de parfums et de saveurs."
    ],
    "nl": [
      "Op uw bord vindt u de Drôme provençale en haar lekkernijen! Jérôme, onze chef, wil u graag laten kennismaken met de streekkeuken met haar rijke smaken en geuren."
    ],
    "es": [
      "En el plato, un invitado: ¡la Drôme provenzal y sus placeres gastronómicos! Jérôme, nuestro chef, le hará descubrir y apreciar una cocina local rica en sabores y aromas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant le Jabron"
    ]
  },
