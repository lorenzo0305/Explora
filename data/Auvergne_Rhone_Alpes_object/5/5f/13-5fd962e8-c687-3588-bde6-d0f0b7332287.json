  "rdfs:comment": {
    "de": [
      "Montbrun-les-Bains hat das Privileg, zu den schönsten Dörfern Frankreichs zu gehören, die man entlang der Brunnen, Caladen und Denkmäler entdecken kann. Kurort für die Behandlung der Atemwege und Fitnesskuren,"
    ],
    "en": [
      "Montbrun-les-Bains has the honour of being one of the most attractive villages of France and can be explored by way of its fountains, narrow streets (‘calades’) and monuments. Montbrun is a thermal resort for the treatment of respiratory conditions and also offers wellbeing courses."
    ],
    "it": [
      "Montbrun-les-Bain, annoverato tra i più bei villaggi di Francia, può essere esplorato attraverso le sue fontane, le calate e i monumenti. Unico centro termale della Drôme, il villaggio medievale ha un'atmosfera autentica, di fronte al selvaggio hubacus del Ventoux."
    ],
    "fr": [
      "Montbrun-les-Bain, classé parmi les plus beaux villages de France, se découvre au fil des ses fontaines, calades et monuments. Unique station thermale de la Drôme, le village médiéval séduit par son authenticité  face à l’hubac sauvage du Ventoux."
    ],
    "es": [
      "Montbrun-les-Bain, catalogado como uno de los pueblos más bonitos de Francia, se recorre a través de sus fuentes, calades y monumentos. Única ciudad balneario de la Drôme, el pueblo medieval tiene un aire auténtico, frente a los hubacus salvajes del Ventoux."
    ],
    "nl": [
      "Bezoek een van de mooiste dorpen van Frankrijk op eigen gelegenheid en slenter rond langs de fonteinen, geplaveide omhooglopende weggetjes en historische monumenten."
    ]
  },
