  "rdfs:comment": {
    "de": [
      "Die Familie Duclos-Gonet führt ihr Know-how seit vier Generationen fort. Die Pastier-Bauern Valérie und Xavier verarbeiten ihr Getreide zu Nudeln und Mehl und bauen Linsen an. Seit 2024 wird mit der Brasserie du Palais ein Bier gebraut."
    ],
    "en": [
      "The Duclos-Gonet family has been perpetuating its know-how for 4 generations. Valérie and Xavier, pastier farmers, transform their cereals into pasta and flour and grow lentils. Since 2024, a beer has been produced with the Brasserie du Palais."
    ],
    "it": [
      "La famiglia Duclos-Gonet perpetua il suo know-how da 4 generazioni. Valérie e Xavier, coltivatori di pastiere, trasformano i loro cereali in pasta e farina e coltivano lenticchie. Dal 2024 viene prodotta una birra con la Brasserie du Palais."
    ],
    "fr": [
      "La famille Duclos-Gonet perpétue son savoir-faire depuis 4 générations. Valérie et Xavier, paysans pastiers, transforment leurs céréales en pâtes et farines, cultivent des lentilles. Depuis 2024, une bière est réalisée avec la Brasserie du Palais."
    ],
    "es": [
      "La familia Duclos-Gonet perpetúa su saber hacer desde hace 4 generaciones. Valérie y Xavier, agricultores pasteros, transforman sus cereales en pasta y harina y cultivan lentejas. Desde 2024, elaboran una cerveza con la Brasserie du Palais."
    ],
    "nl": [
      "De familie Duclos-Gonet houdt haar knowhow al 4 generaties lang in ere. Valérie en Xavier, pastierboeren, verwerken hun graan tot pasta en meel en verbouwen linzen. Sinds 2024 wordt er een bier geproduceerd met de Brasserie du Palais."
    ]
  },
