  "rdfs:comment": {
    "de": [
      "Mary empfängt Sie 7 Tage die Woche in ihrem Imbiss, auf ihrer schönen schattigen Terrasse und bietet Ihnen wahlweise das Tagesmenü oder Gerichte à la carte (Snacks, Burger, Veggie-Gerichte, gemischte Salate usw.)."
    ],
    "en": [
      "Mary welcomes you 7/7 in her snack bar, on her beautiful shaded terrace and offers you a choice of Menu du Jour and à la carte dishes (Snacking, Burgers, Veggie dishes, Mixed salads etc.)."
    ],
    "it": [
      "Mary vi accoglie 7 giorni su 7 nel suo snack bar e nella sua bella terrazza ombreggiata, dove potrete scegliere tra il Menu du Jour e i piatti à la carte (snack, hamburger, piatti vegetariani, insalate miste, ecc.)"
    ],
    "fr": [
      "Mary vous accueille 7j/7 dans son snack, sur sa belle terrasse ombragée et vous propose au choix le Menu du Jour et des plats à la carte (Snacking, Burgers, plats Veggies, Salades composées etc...)"
    ],
    "nl": [
      "Mary verwelkomt je 7 dagen per week in haar snackbar en op haar mooie schaduwrijke terras, waar je kunt kiezen uit het Menu du Jour en à la carte gerechten (snacks, hamburgers, veggiegerechten, gemengde salades, etc.)."
    ],
    "es": [
      "Mary le da la bienvenida los 7 días de la semana a su snack bar y a su encantadora terraza a la sombra, donde podrá elegir entre el Menu du Jour y platos a la carta (bocadillos, hamburguesas, platos vegetarianos, ensaladas mixtas, etc.)"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Snack de la Piscine - Chez Mary"
    ]
  },
