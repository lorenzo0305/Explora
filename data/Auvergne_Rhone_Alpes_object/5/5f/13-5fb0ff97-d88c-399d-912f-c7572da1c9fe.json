  "rdfs:comment": {
    "de": [
      "Willkommen in Vichy! Entdecken Sie Chez Martin - Brasserie 1910, ein gemütliches Lokal im Herzen der Stadt. Genießen Sie unsere Sonnenterrasse, unsere lebhafte Bar und unser klimatisiertes Restaurant."
    ],
    "en": [
      "Welcome to Vichy! Discover Chez Martin - Brasserie 1910, a friendly establishment in the heart of the city. Enjoy our sunny terrace, lively bar and air-conditioned restaurant."
    ],
    "it": [
      "Benvenuti a Vichy! Scoprite Chez Martin - Brasserie 1910, un locale accogliente nel cuore della città. Godetevi la nostra terrazza soleggiata, il nostro vivace bar e il nostro ristorante climatizzato."
    ],
    "fr": [
      "Bienvenue à Vichy ! Découvrez Chez Martin - Brasserie 1910, un établissement chaleureux situé en plein cœur de la ville. Profitez de notre terrasse ensoleillée, de notre bar animé et de notre restaurant climatisé."
    ],
    "es": [
      "¡Bienvenido a Vichy! Descubra Chez Martin - Brasserie 1910, un establecimiento acogedor en pleno centro de la ciudad. Disfrute de nuestra soleada terraza, nuestro animado bar y nuestro restaurante climatizado."
    ],
    "nl": [
      "Welkom in Vichy! Ontdek Chez Martin - Brasserie 1910, een gezellig etablissement in het hart van de stad. Geniet van ons zonnige terras, onze levendige bar en ons restaurant met airconditioning."
    ]
  },
