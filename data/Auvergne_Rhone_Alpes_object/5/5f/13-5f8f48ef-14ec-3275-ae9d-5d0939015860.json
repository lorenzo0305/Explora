  "rdfs:comment": {
    "de": [
      "Das Grand Café empfängt Sie täglich in seinem gemütlichen Rahmen oder im Sommer auf seiner Terrasse. Eine traditionelle Küche mit frischen Produkten."
    ],
    "en": [
      "The Grand Café welcomes you every day in its warm setting or on its terrace in the summer. A traditional cuisine with fresh products."
    ],
