  "rdfs:comment": {
    "de": [
      "Um den Wind anders zu sehen, als wenn man die Ohren spitzt oder die Bäume sich neigen. Diese Einrichtung ist eine von vielen, die auf dem Weg des kleinen Glücks gemacht wurden."
    ],
    "en": [
      "To see the wind in a way other than by straining your ear or watching the trees bend. This is just one of the many improvements made to the Chemin du Petit Bonheur."
    ],
    "it": [
      "Così si può vedere il vento in modo diverso da come si guardano gli alberi. Questo è uno dei tanti miglioramenti apportati al Chemin du Petit Bonheur."
    ],
    "fr": [
      "Pour voir le vent autrement qu'en tendant l'oreille ou en regardant les arbres se pencher. Cet aménagement fait parti des nombreux aménagements faits sur le chemin du petit bonheur."
    ],
    "nl": [
      "Zo zie je de wind op een andere manier dan wanneer je naar de bomen kijkt. Dit is een van de vele verbeteringen aan de Chemin du Petit Bonheur."
    ],
    "es": [
      "Así puedes ver el viento de una forma diferente a como ves los árboles. Esta es una de las muchas mejoras realizadas en el Chemin du Petit Bonheur."
    ]
  },
  "rdfs:label": {
    "en": [
      "Wind revealer"
    ],
    "it": [
      "Un generatore eolico"
    ],
    "fr": [
      "Révélateur de vent"
    ],
    "nl": [
      "Winddetector"
    ]
  },
