  "rdfs:comment": {
    "de": [
      "Dieses Hotel in Amphion liegt direkt am Genfer See und bietet einen Panoramablick. Es verfügt über einen schönen klimatisierten Speisesaal auf Pfählen, einen von Mai bis Oktober beheizten Pool, Tennis, einen großen schattigen Park mit Blumen und kostenlosen Privatparkplätzen."
    ],
    "en": [
      "In Amphion, just a stone's throw from Lake Geneva, this hotel boasts a panoramic view, a lovely air-conditioned restaurant on stilts, a heated swimming pool from May to October, a tennis court, a large shady park with flowers, and free private parking."
    ],
    "it": [
      "Ad Amphion, a pochi passi dal Lago di Ginevra, questo hotel vanta una vista panoramica, un attraente ristorante climatizzato su palafitte, una piscina riscaldata da maggio a ottobre, un campo da tennis, un ampio parco ombreggiato con fiori e un parcheggio privato gratuito."
    ],
    "fr": [
      "A Amphion, situé à fleur d'eau du Lac Léman, cet hôtel bénéficie d'une vue panoramique avec une jolie salle de restaurant climatisée sur pilotis, une piscine chauffée de mai à octobre, un tennis, un grand parc ombragé et fleuri, parking privé gratuit."
    ],
    "es": [
      "En Amphion, a dos pasos del lago Lemán, este hotel goza de vistas panorámicas, un atractivo restaurante sobre pilotes climatizado, una piscina climatizada de mayo a octubre, una pista de tenis, un gran parque sombreado con flores y aparcamiento privado gratuito."
    ],
    "nl": [
      "Dit hotel in Amphion, op een steenworp afstand van het meer van Genève, heeft een panoramisch uitzicht, een aantrekkelijk restaurant op palen met airconditioning, een verwarmd zwembad van mei tot oktober, een tennisbaan, een groot schaduwrijk park met bloemen en gratis privéparkeergelegenheid."
    ]
  },
