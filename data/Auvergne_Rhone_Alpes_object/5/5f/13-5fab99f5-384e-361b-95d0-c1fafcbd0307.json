  "rdfs:comment": {
    "de": [
      "Verkauf von Weinen im Einzelhandel, lose Ware, Bag in Box, Flaschen. \r\nBeratung, Verkostung. Monatliche Sonderangebote. \r\nLandweine aus den Côteaux de l'Ardèche. AOC Côtes du Vivarais. Verkauf von regionalen Produkten."
    ],
    "en": [
      "Retail sale of wines, bulk, bag in box, bottles. \r\nAdvice, tasting. Monthly specials. \r\nLocal wines from the Coteaux de l'Ardèche. AOC Côtes du Vivarais. Sale of regional products."
    ],
    "it": [
      "Vendita al dettaglio di vini, sfusi, bag in box, bottiglie\r\nConsigli, degustazioni. Promozioni mensili\r\nVini locali dei côteaux de l'Ardèche. AOC Côtes du Vivarais. Vendita di prodotti regionali."
    ],
    "fr": [
      "Vente de vins au détail, vrac, bag in box, bouteilles. \r\nConseils, dégustation. Promotions mensuelles. \r\nVins de pays des côteaux de l'Ardèche. AOC côtes du Vivarais. Vente de produits régionaux."
    ],
    "es": [
      "Venta al por menor de vinos, a granel, bag in box, botellas\r\nConsejos, degustación. Promociones mensuales\r\nVinos locales de los côteaux de l'Ardèche. AOC Côtes du Vivarais. Venta de productos regionales."
    ],
    "nl": [
      "Detailhandel in wijn, bulk, bag in box, flessen. \r\nAdvies, proeverij. Maandelijkse promoties. \r\nLokale wijnen van de hellingen van de Ardèche. AOC côtes du Vivarais. Verkoop van streekproducten."
    ]
  },
