  "rdfs:comment": {
    "de": [
      "Die Scourtinerie, die letzte Scourtins-Fabrik Frankreichs, lädt Sie ein, in ihrem Museum, ihrer Werkstatt und ihrer Boutique fünf Generationen Abenteuer zu entdecken."
    ],
    "en": [
      "La Scourtinerie, France?s last scourtins factory, invites you to discover 5 generations of adventure through its museum, workshop and store."
    ],
    "it": [
      "La Scourtinerie, l'ultima fabbrica di scourtine rimasta in Francia, vi invita a scoprire 5 generazioni di avventure attraverso il suo museo, il laboratorio e il negozio."
    ],
    "fr": [
      "La Scourtinerie, dernière fabrique de scourtins de France, vous invite à découvrir 5 générations d’aventure à travers son musée, son atelier et sa boutique."
    ],
    "es": [
      "La Scourtinerie, la última fábrica de scourtine que queda en Francia, le invita a descubrir 5 generaciones de aventuras a través de su museo, taller y tienda."
    ],
    "nl": [
      "La Scourtinerie, de laatst overgebleven scourtinefabriek van Frankrijk, nodigt je uit om 5 generaties avontuur te ontdekken in haar museum, werkplaats en winkel."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite guidée de la Scourtinerie"
    ]
  },
