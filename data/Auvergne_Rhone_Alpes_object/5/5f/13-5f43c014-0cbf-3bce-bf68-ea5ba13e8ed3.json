  "rdfs:comment": {
    "de": [
      "57 staatlich geprüfte Skilehrerinnen und Skilehrer bringen Ihnen die Freuden des Skifahrens und der Berge näher."
    ],
    "en": [
      "Snow sports school for all the family and for all tastes. 57 state-qualified instructors from the valley will help you discover and share the pleasures of skiing and the joys of the mountains, whatever your level."
    ],
    "it": [
      "Scuola di sport sulla neve per tutta la famiglia e per tutti i gusti. 57 istruttori qualificati della valle vi aiuteranno a scoprire e condividere i piaceri dello sci e le gioie della montagna, qualunque sia il vostro livello."
    ],
    "fr": [
      "57 monitrices et moniteurs diplômés d'état vous font découvrir les plaisirs de la glisse et de la montagne."
    ],
    "nl": [
      "Sneeuwschool voor het hele gezin en voor alle smaken. 57 door de staat gecertificeerde instructeurs uit de vallei zullen u helpen de geneugten van skiën en de geneugten van de bergen te ontdekken en te delen, ongeacht uw niveau."
    ],
    "es": [
      "57 monitores titulados por el Estado le harán descubrir los placeres del esquí y de la montaña."
    ]
  },
