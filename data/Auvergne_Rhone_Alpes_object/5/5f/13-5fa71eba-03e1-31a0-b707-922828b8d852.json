  "rdfs:comment": {
    "de": [
      "Nicolas bietet Ihnen Ausflüge mit dem Mountainbike, BMX, Fat Bike, Fahrradtouren sowie Fahrradunterricht in der Schule an. Außerdem bietet er in seinem Geschäft Ride to the future Neuverkäufe, Lagerverkäufe und Fahrradreparaturen an."
    ],
    "en": [
      "Nicolas offers mountain bike, BMX and fat bike outings, as well as bike training for schools. He also offers new bike sales, depot sales and repairs in his Ride to the Future store."
    ],
    "it": [
      "Nicolas offre uscite in mountain bike, BMX e fat bike, oltre a corsi di formazione per le scuole. Nel suo negozio Ride to the Future offre anche un servizio di vendita di biciclette nuove, di deposito e di riparazione."
    ],
    "fr": [
      "Nicolas vous propose des sorties en VTT, BMX, Fat Bike, des randonnées à vélo, ainsi que l'apprentissage du vélo en milieu scolaire. Il propose également un service de vente neuve, dépôt vente et de réparation de vélo dans son magasin Ride to the futur."
    ],
    "es": [
      "Nicolas ofrece salidas en bicicleta de montaña, BMX y fat bike, así como cursos de ciclismo para escuelas. También ofrece un servicio de venta de bicicletas nuevas, de depósito y de reparaciones en su tienda Ride to the Future."
    ],
    "nl": [
      "Nicolas biedt mountainbike-, BMX- en fatbike-uitstapjes aan, evenals fietstrainingen voor scholen. Hij biedt ook verkoop van nieuwe fietsen, depotverkoop en reparatieservice in zijn Ride to the Future winkel."
    ]
  },
  "rdfs:label": {
    "en": [
      "Nicolas Charvin - Guided bike outings"
    ],
    "fr": [
      "Nicolas Charvin - Sorties vélo accompagnées"
    ]
  },
