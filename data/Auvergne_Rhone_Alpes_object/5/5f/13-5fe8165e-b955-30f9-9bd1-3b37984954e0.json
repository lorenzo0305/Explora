  "rdfs:comment": {
    "de": [
      "Die Blüte des Loire-Erbes : das Schloss der Bâtie d'Urfé wurde im sechzehnten Jahrhundert im Renaissancestil auf Initiative von Claude d'Urfé erbaut."
    ],
    "en": [
      "Jewel of the Loire heritage, the Bâtie d’Urfé Castle was built in the 16th century with Renaissance style, on the initiative of Claude d’Urfé."
    ],
    "it": [
      "La Bâtie d'Urfé è un luogo emblematico del Forez, una tenuta ristrutturata nel Rinascimento e decorata da artisti francesi e italiani su iniziativa di Claude d'Urfé (1501-1558), ambasciatore francese in Italia sotto Francesco I e Enrico II."
    ],
    "fr": [
      "Lieu emblématique du Forez, la Bâtie d'Urfé est un domaine réaménagé à la Renaissance et décoré par des artistes français et italiens à l'initiative de Claude d'Urfé (1501-1558), ambassadeur de France en Italie sous François Ier et Henri II."
    ],
    "es": [
      "La Bâtie d'Urfé es un lugar emblemático de Forez, una finca reformada durante el Renacimiento y decorada por artistas franceses e italianos por iniciativa de Claude d'Urfé (1501-1558), embajador de Francia en Italia bajo Francisco I y Enrique II."
    ],
    "nl": [
      "Het monumentenpand Château de la Bâtie d'Urfé werd in de 16de eeuw op initiatief van Claude d'Urfé door Italiaanse kunstenaars in renaissancestijl ingericht."
    ]
  },
