  "rdfs:comment": {
    "de": [
      "Die Winzergenossenschaft Vignerons de Bourg-Saint-Andéol bietet eine große Auswahl an konventionellen und biologischen Weinen in Flaschen, Bag-in-Boxen und Zapfanlagen: Côtes du Rhône, I.G.P. Ardèche.\r\nAußerdem finden Sie hier viele regionale Produkte."
    ],
    "en": [
      "The Vignerons des Gorges de l’Ardèche wine cooperative offers a large selection of both traditional and organic wines, bottled, boxed or from the pump! Côtes du Rhône, Côtes du Vivarais and local table wine."
    ],
    "it": [
      "Il Caveau des Vignerons de Bourg-Saint-Andéol offre un'ampia gamma di vini in bottiglia, bag-in-box e alla spina, sia convenzionali che biologici: Côtes du Rhône, I.G.P. Ardèche.\r\nTroverete anche un'ampia gamma di prodotti locali."
    ],
    "fr": [
      "Le caveau des Vignerons de Bourg-Saint-Andéol propose une large gamme de vins en bouteille, en Bag In Box et à la tireuse, conventionnels et biologiques: Côtes du Rhône, I.G.P. Ardèche.\r\nVous y trouverez également de nombreux produits du terroir."
    ],
    "es": [
      "El Caveau des Vignerons de Bourg-Saint-Andéol ofrece una amplia gama de vinos en botella, bag-in-box y de barril, tanto convencionales como ecológicos: Côtes du Rhône, I.G.P. Ardèche.\r\nTambién encontrará una amplia gama de productos locales."
    ],
    "nl": [
      "De wijnkelder van Vignerons des Gorges de l'Ardèche biedt u een grote waaier aan wijnen aan : Côtes du Rhône, Côtes du Vivarais, Vins de Pays en biowijnen."
    ]
  },
