  "rdfs:comment": {
    "de": [
      "Ein sympathisches Team setzt sich dafür ein, Ihnen ein familiäres und zugängliches Jazzfestival in einer wunderschönen mittelalterlichen Umgebung mit Blick auf die Hügel der Drôme Provençale zu bieten."
    ],
    "en": [
      "A friendly team is mobilized to offer you a family-friendly jazz festival in a superb medieval setting overlooking the hills of the Drôme Provençale."
    ],
    "it": [
      "Un team amichevole sta lavorando duramente per offrirvi un festival jazz adatto alle famiglie in una superba cornice medievale che domina le colline della Drôme Provençale."
    ],
    "fr": [
      "Une sympathique équipe se mobilise pour vous proposer un festival de jazz familial et accessible dans un superbe cadre médiéval surplombant les collines de la Drôme Provençale."
    ],
    "es": [
      "Un amable equipo se esfuerza por ofrecerle un festival de jazz familiar en un magnífico marco medieval con vistas a las colinas de la Drôme provenzal."
    ],
    "nl": [
      "Een vriendelijk team werkt hard om je een gezinsvriendelijk jazzfestival te bieden in een prachtige middeleeuwse omgeving met uitzicht op de heuvels van de Drôme Provençale."
    ]
  },
