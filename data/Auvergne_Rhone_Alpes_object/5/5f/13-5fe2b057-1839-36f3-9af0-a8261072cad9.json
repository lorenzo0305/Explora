  "rdfs:comment": {
    "de": [
      "Die Galerie Pasqui hat nun eine zweite Adresse, im Hyperzentrum.\r\nSie sind ein Kunstfan und kennen die Galerie Pasqui noch nicht?\r\nWir laden Sie ein, diesen Ausstellungsraum für zeitgenössische Kunst im Herzen von Saint-Etienne zu entdecken."
    ],
    "en": [
      "Galerie Pasqui now has a second address, right in the center of town.\r\nAre you an art fan who hasn't heard of Galerie Pasqui?\r\nWe invite you to discover this contemporary art exhibition space in the heart of Saint-Etienne."
    ],
    "it": [
      "La Galerie Pasqui ha ora un secondo indirizzo nel centro della città.\r\nSiete appassionati d'arte e non conoscete la Galerie Pasqui?\r\nVi invitiamo a scoprire questo spazio espositivo di arte contemporanea nel cuore di Saint-Etienne."
    ],
    "fr": [
      "La galerie Pasqui a désormais une deuxième adresse, en hyper-centre.\r\nVous êtes fan d'art et vous ne connaissez pas la galerie Pasqui ?\r\nOn vous invite à découvrir cet espace d'exposition d'art contemporain en plein cœur de Saint-Etienne."
    ],
    "es": [
      "La Galerie Pasqui tiene ahora una segunda dirección en el centro de la ciudad.\r\n¿Es usted un aficionado al arte y no conoce la Galerie Pasqui?\r\nLe invitamos a descubrir este espacio de exposición de arte contemporáneo en pleno centro de Saint-Etienne."
    ],
    "nl": [
      "Galerie Pasqui heeft nu een tweede adres in het centrum van de stad.\r\nBen je een kunstliefhebber die nog nooit van Galerie Pasqui heeft gehoord?\r\nWe nodigen je uit om deze tentoonstellingsruimte voor hedendaagse kunst in het hart van Saint-Etienne te ontdekken."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Galerie d'art Pasqui - Dorian"
    ]
  },
