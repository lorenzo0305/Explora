  "rdfs:comment": {
    "de": [
      "Eine gute Adresse, um Antipasti, Pizza, Pasta aller Art oder, etwas subtiler, eine dieser italienischen Spezialitäten zu genießen, von denen jede Region ein Geheimnis hat. Kreative Küche in einer freundlichen und herzlichen Atmosphäre."
    ],
    "en": [
      "A good address to taste an antipasti, pizza, pasta of all kinds or more subtle, one of those Italian specialties of which every region has the secret. Creative cuisine in a warm and friendly atmosphere."
    ],
    "it": [
      "Un buon indirizzo per gustare antipasti, pizza, pasta di tutti i tipi o, più delicatamente, una di queste specialità italiane di cui ogni regione ha il segreto. Cucina creativa in un'atmosfera calda e accogliente."
    ],
    "fr": [
      "Une bonne adresse pour déguster un antipasti, pizza, pasta en tous genres ou plus subtil, une de ces spécialités italiennes dont chaque région a le secret. Cuisine créative dans une ambiance conviviale et chaleureuse."
    ],
    "es": [
      "Una buena dirección para disfrutar de un antipasti, una pizza, pasta de todo tipo o, más sutilmente, una de esas especialidades italianas que cada región tiene como secreto. Cocina creativa en un ambiente cálido y acogedor."
    ],
    "nl": [
      "Een goed adres om te genieten van een antipasti, pizza, allerlei soorten pasta of subtieler, een van die Italiaanse specialiteiten waar elke streek het geheim van heeft. Creatieve keuken in een warme en vriendelijke sfeer."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Pizza Pasta Del Arte"
    ]
  },
