      "dc:description": {
        "de": [
          "Workshop: Lasst uns in der Mediathek spielen!\nGesellschaftsspiele für Kinder, die von einer Mediathekarin geleitet werden\nkostenlos, nach Voranmeldung\nAb 6 Jahren\nMediathek Jean de la Fontaine"
        ],
        "en": [
          "Workshop: Let's play at the Médiathèque\nBoard games for children led by a multimedia librarian\nfree, on reservation\nAges 6 and up\nJean de la Fontaine multimedia library"
        ],
        "it": [
          "Laboratorio: Giochiamo alla biblioteca multimediale\nGiochi da tavolo per bambini guidati da un bibliotecario multimediale\ngratuito, su prenotazione\nA partire dai 6 anni\nBiblioteca multimediale Jean de la Fontaine"
        ],
        "fr": [
          "Atelier : Allons jouer à la Médiathèque\nJeux de sociétés pour les enfants animés par une médiathécaire\ngratuit, sur réservation\nA partir de 6 ans\nMédiathèque Jean de la Fontaine"
        ],
        "nl": [
          "Workshop: Spelen in de mediatheek\nBordspellen voor kinderen onder leiding van een mediathecaris\ngratis, op reservering\nVanaf 6 jaar\nMediatheek Jean de la Fontaine"
        ],
        "es": [
          "Taller: Juguemos en la biblioteca multimedia\nJuegos de mesa para niños dirigidos por un bibliotecario multimedia\ngratuito, previa reserva\nA partir de 6 años\nBiblioteca multimedia Jean de la Fontaine"
        ]
      },
