  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/133b98cc-fd98-385f-a118-bf2e4d6143c4",
      "dc:description": {
        "de": [
          "Informationen :\n\nÖffnungstage:\n\nDienstag bis Samstag von 9:00 bis 12:00 Uhr und von 14:00 bis 19:00 Uhr. Sonntags und montags geschlossen.\n\nBestellungen:\n\nKontaktieren Sie das Geschäft telefonisch unter 03 74 41 21 13.\n\nBedingungen :\n\nDie Lieferung ist ab einem Bestellwert von 30 Euro möglich. Die Kosten für die Lieferung sind kostenlos.\n\n "
        ],
        "en": [
          "Information :\n\nOpening days:\n\nTuesday to Saturday, 9am to 12pm and 2pm to 7pm. Closed on Sundays and Mondays.\n\nOrders :\n\nContact the store by telephone on 03 74 41 21 13.\n\nTerms and conditions:\n\nDelivery possible from 30? purchase. Delivery is free of charge.\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura:\n\nDa martedì a sabato, dalle 9.00 alle 12.00 e dalle 14.00 alle 19.00. Chiuso la domenica e il lunedì.\n\nOrdini :\n\nContattare il negozio telefonicamente al numero 03 74 41 21 13.\n\nTermini e condizioni:\n\nConsegna possibile per ordini pari o superiori a 30? La consegna è gratuita.\n\n "
        ],
        "fr": [
          "Informations : \n\nJours d'ouverture: \n\nDu mardi au samedi de 9h à 12h et de 14h à 19h. Fermeture les dimanches et lundis.\n\nCommandes :\n\nContacter le magasin par téléphone au 03 74 41 21 13.\n\nConditions : \n\nLivraison possible dès 30€ d'achat. Le coût de la livraison est gratuite. \n\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen:\n\nDinsdag t/m zaterdag van 9.00 tot 12.00 uur en van 14.00 tot 19.00 uur. Gesloten op zondag en maandag.\n\nBestellingen :\n\nNeem telefonisch contact op met de winkel op 03 74 41 21 13.\n\nAlgemene voorwaarden:\n\nLevering mogelijk voor bestellingen van 30? of meer. Levering is gratis.\n\n "
        ],
        "es": [
          "Más información :\n\nDías de apertura:\n\nDe martes a sábado, de 9h a 12h y de 14h a 19h. Domingos y lunes cerrado.\n\nPedidos :\n\nPóngase en contacto con la tienda por teléfono llamando al 03 74 41 21 13.\n\nCondiciones generales de venta:\n\nEntrega posible para pedidos de 30? o más. La entrega es gratuita.\n\n "
        ]
      },
