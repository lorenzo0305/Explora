  "rdfs:comment": {
    "de": [
      "L?O Provençale, la Ferme aux Oliviers bietet Ihnen während der Wintersaison \"getrüffelte\" Angebote, die Sie ohne Mäßigung entdecken und genießen können. Das Ganze findet in einer freundlichen und herzlichen Atmosphäre statt."
    ],
    "en": [
      "L'O Provençale, la Ferme aux Oliviers offers you a range of \"Truffle\" products to discover and enjoy without moderation, during the winter season. All in a warm and friendly atmosphere."
    ],
    "it": [
      "L'O Provençale, la Ferme aux Oliviers vi offre una gamma di prodotti al tartufo da scoprire e gustare senza moderazione durante la stagione invernale. Il tutto in un'atmosfera calda e accogliente."
    ],
    "fr": [
      "L’O Provençale, la Ferme aux Oliviers vous propose des offres « Truffées » à découvrir et déguster sans modération, durant la saison hivernale. Le tout dans une ambiance conviviale et chaleureuse."
    ],
    "es": [
      "L'O Provençale, la Ferme aux Oliviers le ofrece una gama de productos \"Trufa\" para descubrir y disfrutar sin moderación durante la temporada de invierno. Todo ello en un ambiente cálido y acogedor."
    ],
    "nl": [
      "L'O Provençale, la Ferme aux Oliviers biedt u een scala aan \"Truffel\" producten om te ontdekken en te genieten zonder mate tijdens het winterseizoen. Dit alles in een warme en gezellige sfeer."
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'O Provençale - Offre Truffe"
    ]
  },
