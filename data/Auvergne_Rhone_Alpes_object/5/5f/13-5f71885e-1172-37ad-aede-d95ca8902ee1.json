  "rdfs:comment": {
    "de": [
      "Die Buchbinderei ist ein Kunsthandwerk, das darin besteht, Dokumente zu binden und dauerhaft zu machen. Traditionelle und moderne Buchbindungen, kreative Buchbindungen, Fotobücher oder Kunstobjekte - ich fertige alle Arten von Werken nach Maß an."
    ],
    "en": [
      "Traditional and modern bindings, creative bindings, photo books or works of art, I create all types of tailor-made books. I also offer binding lessons as well as cardboard lessons where you can make boxes, boxes and objects of your creation..."
    ],
    "it": [
      "La legatoria è una forma d'arte che consiste nel rilegare documenti e farli durare nel tempo. Rilegature tradizionali e moderne, rilegature creative, libri fotografici o oggetti d'arte, produco ogni tipo di lavoro personalizzato."
    ],
    "fr": [
      "La reliure est un métier d’Art qui consiste à lier et pérenniser les documents. Reliures traditionnelles et modernes, reliures de création, books-photos ou objets d'art, je réalise tous types d'ouvrages sur-mesure."
    ],
    "es": [
      "La encuadernación es un arte que consiste en encuadernar documentos y hacer que perduren. Encuadernaciones tradicionales y modernas, encuadernaciones creativas, libros de fotos u objetos de arte, realizo todo tipo de trabajos a medida."
    ],
    "nl": [
      "Boekbinden is een kunstvorm waarbij je documenten inbindt en duurzaam maakt. Traditionele en moderne bindingen, creatieve bindingen, fotoboeken of kunstvoorwerpen, ik maak alle soorten maatwerk."
    ]
  },
