  "rdfs:comment": {
    "de": [
      "Hotel ca. 30 min von Vallon-Pont-d'Arc entfernt, am Ufer des Flusses Beaume, mit beheiztem Hallenbad, am Dorfeingang. Regionale Küche. Empfang von Wanderern, Familien, Kindern, Fahrrädern, Angeln, Motorrädern."
    ],
    "en": [
      "Hotel about 30 minutes from Vallon Pont d'Arc, on the banks of the Beaume river, heated indoor pool, village entrance. Regional cuisine. Logis rando, logis famille enfants, logis vélos, logis pêche, logis moto."
    ],
    "it": [
      "Hotel situato a circa 30 minuti da Vallon-Pont-d'Arc, sulle rive del fiume Beaume, con piscina interna riscaldata, all'ingresso del villaggio. Cucina regionale. Accoglie escursionisti, famiglie, bambini, biciclette, pesca, moto."
    ],
    "fr": [
      "Hôtel situé à environ 30 min de Vallon-Pont-d’Arc, en bordure de la rivière la Beaume, avec piscine couverte et chauffée, à l’entrée du village. Cuisine régionale. Accueil randonneurs, familles, enfants, vélos, pêche, moto."
    ],
    "es": [
      "Hotel situado a unos 30 minutos de Vallon-Pont-d'Arc, a orillas del río Beaume, con piscina cubierta climatizada, a la entrada del pueblo. Cocina regional. Acoge a excursionistas, familias, niños, bicicletas, pesca, motos."
    ],
    "nl": [
      "Hotel op ongeveer 30 minuten van Vallon-Pont-d?Arc, aan de oever van de rivier de Beaume, met verwarmd binnenzwembad, bij de ingang van het dorp. Regionale keuken. Geschikt voor wandelaars, gezinnen, kinderen, fietsen, vissen, motoren."
    ]
  },
