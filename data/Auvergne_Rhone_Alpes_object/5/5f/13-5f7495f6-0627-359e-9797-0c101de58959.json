  "rdfs:comment": {
    "de": [
      "Das Schwimmbad Charly-Kirakossian in Roussillon ist im Winter überdacht und im Sommer offen.\r\nEs verfügt über ein 25 m langes und 10 m breites Becken.\r\nPicknick-Möglichkeiten"
    ],
    "en": [
      "The Charly-Kirakossian swimming pool in Roussillon is covered in the winter, discovered in the summer.\r\nIt has a pool of 25 meters long by 10 meters wide.\r\nPossibility of picnic"
    ],
    "it": [
      "La piscina Charly-Kirakossian di Roussillon è coperta in inverno e scoperta in estate.\r\nLa piscina è lunga 25 metri e larga 10 metri.\r\nSono disponibili strutture per il picnic"
    ],
    "fr": [
      "La piscine Charly-Kirakossian à Roussillon est couverte l'hiver, découverte l'été.\r\nElle dispose d’un bassin de 25 mètres de long par 10 mètres de large.\r\nPossibilité de pique-nique"
    ],
    "es": [
      "La piscina Charly-Kirakossian de Rosellón está cubierta en invierno y descubierta en verano.\r\nLa piscina tiene 25 metros de largo y 10 de ancho.\r\nHay instalaciones de picnic disponibles"
    ],
    "nl": [
      "Het Charly-Kirakossian zwembad in Roussillon is 's winters overdekt en 's zomers onoverdekt.\r\nHet zwembad is 25 meter lang en 10 meter breed.\r\nPicknick faciliteiten"
    ]
  },
