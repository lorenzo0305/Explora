  "rdfs:comment": {
    "de": [
      "Öffnen Sie die Türen zu unserem Spa und entdecken Sie einen Raum, der ganz Ihrem Wohlbefinden und dem Abschalten gewidmet ist. Der ideale Ort, um sich zu entspannen, den atemberaubenden Blick auf die Berge zu genießen oder sich nach einem anstrengenden Tag auf der Piste zu erholen."
    ],
    "en": [
      "Push the doors of our Spa, discover a space entirely dedicated to your well-being and disconnection. Ideal place to relax, enjoy a breathtaking view on the mountains or recover after a good day on the slopes."
    ],
    "it": [
      "Aprendo le porte della nostra Spa, si entra in uno spazio interamente dedicato al benessere e alla remise en forme. Ideale per rilassarsi prima o dopo una giornata sulle piste."
    ],
    "fr": [
      "Poussez les portes de notre Spa, découvrez un espace entièrement dédié à votre bien-être et à la déconnexion. Lieu idéal pour se détendre, profiter d’une vue imprenable sur les montagnes ou récupérer après une bonne journée sur les pistes."
    ],
    "es": [
      "Entre en nuestro spa y sumérjase en un espacio totalmente dedicado al bienestar y al cuidado del cuerpo. Ideal para relajarse tras una jornada deportiva en las pistas."
    ],
    "nl": [
      "Bij het openduwen van de deuren van onze Spa, dringt u binnen in een ruimte die volledig in het teken staat van de wellness en van het opladen van de batterijen. Ideaal om zich te ontspannen vóór of na een dag op de pistes."
    ]
  },
  "rdfs:label": {
