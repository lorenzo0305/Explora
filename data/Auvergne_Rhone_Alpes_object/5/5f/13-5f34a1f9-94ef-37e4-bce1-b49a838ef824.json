  "rdfs:comment": {
    "de": [
      "Zwischen Kirche und ehemaligem Waschhaus werden Sie hier mit Pizzas, Tapas, Kastanien-Tiramisu und handgemachtem Eis verköstigt. Hausgemachte Küche."
    ],
    "en": [
      "Situated between the wash-house and the church in the heart of the village, on a shady terrace or in our vaulted, air-conditioned dining room. You'll be able to enjoy our home-cooked dishes, made from quality local produce."
    ],
    "it": [
      "Tra il lavatoio e la chiesa, nel cuore del villaggio, su una terrazza ombreggiata o nella nostra sala da pranzo con soffitto a volta e aria condizionata, godrete della pace e della tranquillità dei nostri piatti casalinghi, preparati con prodotti locali di qualità."
    ],
    "fr": [
      "Situé entre le lavoir et l'église, au cœur du village, en terrasse ombragée ou dans notre salle voûtée et climatisée, vous serez au calme pour déguster nos plats faits maison, élaborés à partir de produits locaux et de qualité."
    ],
    "es": [
      "Situado entre el lavadero y la iglesia, en el corazón del pueblo, en una terraza a la sombra o en nuestro comedor abovedado y climatizado, disfrutará de la tranquilidad de nuestros platos caseros, elaborados con productos locales de calidad."
    ],
    "nl": [
      "Gelegen tussen het washuis en de kerk, in het hart van het dorp, op een schaduwrijk terras of in onze gewelfde eetzaal met airconditioning, geniet je van de rust van onze huisgemaakte gerechten, bereid met lokale kwaliteitsproducten."
    ]
  },
