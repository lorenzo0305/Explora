  "rdfs:comment": {
    "de": [
      "Christine Pollier, Holzmalerei-Künstlerin, präsentiert Ihnen ihre Tierbilder und Kuh-Poyas.\r\nIn unserem Ausstellungsatelier können Sie auch die Bergfotografien von Michel Lavanchy entdecken."
    ],
    "en": [
      "Christine Pollier painter on wood presents her animal paintings and poyas of cows.\r\nIn our exhibition workshop you will also discover Michel Lavanchy's mountain photography."
    ],
    "it": [
      "Christine Pollier, pittrice su legno, presenta i suoi dipinti di animali e le sue poyas di mucca.\r\nNel nostro laboratorio scoprirete anche le fotografie di montagna di Michel Lavanchy."
    ],
    "fr": [
      "Christine Pollier artiste peintre sur bois vous présente ses peintures animalières et ses poyas de vaches.\r\nDans notre atelier exposition vous découvrirez aussi les  photographies de montagne de Michel Lavanchy."
    ],
    "es": [
      "Christine Pollier, pintora de madera, presenta sus cuadros de animales y poyas de vaca.\r\nEn nuestro taller también descubrirá las fotografías de montaña de Michel Lavanchy."
    ],
    "nl": [
      "Christine Pollier, een houtschilderes, presenteert haar dierenschilderijen en koeienpoezen.\r\nIn onze workshop ontdekt u ook de bergfoto's van Michel Lavanchy."
    ]
  },
