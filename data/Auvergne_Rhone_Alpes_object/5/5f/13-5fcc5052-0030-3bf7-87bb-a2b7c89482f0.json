  "rdfs:comment": {
    "de": [
      "Delphine Erde Yoga\r\nVerformt die elastische Form des Runden, gravierte Zeichnung auf Erde & Papier.\r\nSpuren von Rauch & Farben ...\r\nKeramikerin/Pädagogin, die STAGE mit geschliffener & geräucherter Erde & Yoga betreut."
    ],
    "en": [
      "Delphine Terre Yoga\r\nDeforms the elastic shape of the round, drawing engraved on clay & paper.\r\nTraces of smoke & color ...\r\nCéramiste/Pédagogue who supervises polished & smoked clay & yoga WORKSHOPS."
    ],
    "it": [
      "Delphine Terra Yoga\r\nDeforma la forma elastica del tondo, disegno inciso sulla terra e sulla carta.\r\nTracce di fumo e colori ...\r\nCeramista / Pedagogista che conduce laboratori di argilla levigata e affumicata e di yoga"
    ],
    "fr": [
      "Delphine Terre Yoga\r\nDéforme la forme élastique du rond, dessin gravé sur terre & sur papier.\r\nTraces de fumées & de couleurs ...\r\nCéramiste/Pédagogue qui encadre des STAGES de Terre polis & enfumées & de Yoga"
    ],
    "nl": [
      "Delphine Yoga Aarde\r\nVervormt de elastische vorm van de ronde, tekening gegraveerd op klei & papier.\r\nSporen van rook & kleur ...\r\nEen keramist/docent die gepolijste & gerookte klei & yoga WORKSHOPS geeft."
    ],
    "es": [
      "Delphine Earth Yoga\r\nDeforma la forma elástica del redondo, dibujo grabado en tierra y en papel.\r\nRestos de humo y colores ...\r\nCeramista / Pedagoga que dirige talleres de arcilla pulida y ahumada y de yoga"
    ]
  },
  "rdfs:label": {
