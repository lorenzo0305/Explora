  "rdfs:comment": {
    "de": [
      "Feiern Sie mit uns dieses außergewöhnliche Wochenende: Kirmes, animierter Ball, Parade der Schulklassen und ein spektakuläres Feuerwerk zum Abschluss der Feierlichkeiten. Eine festliche und familiäre Atmosphäre, die Sie sich nicht entgehen lassen sollten!"
    ],
    "en": [
      "Join us in celebrating this exceptional weekend: funfair, lively ball, class parade and a spectacular fireworks display to round off the festivities. A festive, family atmosphere not to be missed!"
    ],
    "it": [
      "Unitevi a noi per festeggiare questo weekend eccezionale: luna park, ballo vivace, sfilata di classe e uno spettacolare spettacolo pirotecnico per concludere i festeggiamenti. Un'atmosfera festosa e familiare da non perdere!"
    ],
    "fr": [
      "Venez célébrer avec nous ce week-end exceptionnel : fête foraine, bal animé, défilé des classes et un spectaculaire feu d'artifice pour clôturer les festivités. Une ambiance festive et familiale à ne pas manquer !"
    ],
    "nl": [
      "Kom en vier dit uitzonderlijke weekend met ons mee: kermis, levendig bal, klassenparade en een spectaculair vuurwerk om de festiviteiten af te ronden. Een feestelijke, familiale sfeer die je niet mag missen!"
    ],
    "es": [
      "Acompáñenos en la celebración de este fin de semana excepcional: parque de atracciones, baile animado, desfile de clases y un espectacular castillo de fuegos artificiales como colofón de los festejos. Un ambiente festivo y familiar que no te puedes perder"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Fête foraine"
    ]
  },
