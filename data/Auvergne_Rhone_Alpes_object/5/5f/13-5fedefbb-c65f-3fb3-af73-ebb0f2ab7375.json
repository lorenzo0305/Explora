  "rdfs:comment": {
    "de": [
      "Rochebrune ist von Buis-les-Baronnies aus über den Col d'Ey erreichbar und ist ein charmantes kleines Dorf, das 13 km von der Hauptstadt der Linde entfernt liegt. Sie müssen die Departementale 108 verlassen, um auf die Departementale 528 abzubiegen."
    ],
    "en": [
      "Accessible from Buis-les-Baronnies via the Col d'Ey, Rochebrune is a charming little village 13km from the lime capital. Leave the départementale 108 and take the départementale 528."
    ],
    "it": [
      "Raggiungibile dal Col d'Ey da Buis-les-Baronnies, Rochebrune è un incantevole paesino situato a 13 km dalla capitale della calce. È necessario lasciare la strada dipartimentale 108 per imboccare la strada dipartimentale 528."
    ],
    "fr": [
      "Accessible depuis le col d’Ey en provenance de Buis-les-Baronnies, Rochebrune est un charmant petit village situé à 13Km de la capitale du tilleul. Il faudra quitter la départementale 108 pour prendre la départementale 528."
    ],
    "nl": [
      "Rochebrune is een charmant dorpje op 13 km van de lindehoofdstad, bereikbaar vanuit Buis-les-Baronnies via de Col d'Ey. Verlaat de departementale weg 108 en neem de departementale weg 528."
    ],
    "es": [
      "Accesible desde el Col d'Ey desde Buis-les-Baronnies, Rochebrune es un encantador pueblecito situado a 13Km de la capital de la cal. Es necesario dejar la carretera departamental 108 para tomar la carretera departamental 528."
    ]
  },
