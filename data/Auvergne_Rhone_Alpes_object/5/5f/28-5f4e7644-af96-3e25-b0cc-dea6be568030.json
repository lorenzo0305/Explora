      "dc:description": {
        "de": [
          "Begib dich allein oder mit deiner Familie auf ein Abenteuer und suche nach dem sagenhaften Schatz Fort-Mahonnais.....\nEntdecke unterwegs die geheimen Orte des Ortes!!!"
        ],
        "en": [
          "Go on an adventure alone or with your family in search of the fabulous Fort-Mahonnais treasure....\nOn the way, discover the secret places of the resort!"
        ],
        "it": [
          "Partite all'avventura da soli o in famiglia alla ricerca del favoloso tesoro di Fort-Mahonnais....\nDurante il percorso, scoprite i luoghi segreti del resort!"
        ],
        "fr": [
          "Part à l'aventure seul ou en famille à la recherche du fabuleux trésor Fort-Mahonnais....\nEn chemin découvre les lieux secrets de la station !!"
        ],
        "nl": [
          "Ga alleen of met uw gezin op avontuur op zoek naar de fabelachtige Fort-Mahonnais-schat ....\nOntdek onderweg de geheime plekjes van de badplaats!"
        ],
        "es": [
          "Aventúrese solo o en familia en busca del fabuloso tesoro de Fort-Mahonnais....\nPor el camino, ¡descubra los lugares secretos de la estación!"
        ]
