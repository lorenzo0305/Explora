  "rdfs:comment": {
    "de": [
      "Die Bibliothek von Vallorcine ist für alle zugänglich, ob Einwohner oder Touristen: Möchten Sie mit Romanen dem Alltag entfliehen, sich mit Comics amüsieren oder im Internet surfen, dann kommen Sie und entdecken Sie die Bibliothek von Vallorcine!"
    ],
    "en": [
      "Accessible to all, locals and tourists: want to escape with novels, bubble with comics, surf the Internet, come and discover the library of Vallorcine!"
    ],
    "it": [
      "Accessibile a tutti, abitanti del luogo e turisti: se volete evadere con i romanzi, spumeggiare con i fumetti, navigare in internet, venite a scoprire la biblioteca di Vallorcine!"
    ],
    "fr": [
      "Accessible à tous, habitants et touristes : envie de vous évader avec des romans, buller avec des BD, surfer sur internet, venez découvrir la bibliothèque de Vallorcine !"
    ],
    "nl": [
      "Toegankelijk voor iedereen, zowel inwoners als toeristen: wil je ontsnappen met romans, bubbelen met strips, surfen op het internet, kom en ontdek de bibliotheek van Vallorcine!"
    ],
    "es": [
      "Accesible a todos, tanto a los habitantes como a los turistas: si quiere evadirse con novelas, burbujear con cómics, navegar por Internet, ¡venga a descubrir la biblioteca de Vallorcine!"
    ]
  },
