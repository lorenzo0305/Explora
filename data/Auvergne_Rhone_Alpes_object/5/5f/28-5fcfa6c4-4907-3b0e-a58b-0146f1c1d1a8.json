      "dc:description": {
        "de": [
          "Entdecken Sie eine lokale und saisonale Küche in einer gemütlichen Umgebung in Rouvroy, nur wenige Schritte vom Naturschutzgebiet Parc d'Isle entfernt."
        ],
        "en": [
          "Discover a local and seasonal cuisine in a warm setting located in Rouvroy, a stone's throw from the Parc d'Isle nature reserve."
        ],
        "it": [
          "Scoprite la cucina locale e stagionale in un ambiente accogliente a Rouvroy, a due passi dalla riserva naturale del Parc d'Isle."
        ],
        "fr": [
          "Découvrez une cuisine locale et de saison dans un cadre chaleureux situé à Rouvroy, à deux pas de la réserve naturelle du Parc d'Isle."
        ],
        "nl": [
          "Ontdek de lokale en seizoensgebonden keuken in een warme omgeving in Rouvroy, op een steenworp afstand van het natuurreservaat Parc d'Isle."
        ],
        "es": [
          "Descubra la cocina local y de temporada en un entorno cálido en Rouvroy, a un paso de la reserva natural del Parc d'Isle."
        ]
      },
