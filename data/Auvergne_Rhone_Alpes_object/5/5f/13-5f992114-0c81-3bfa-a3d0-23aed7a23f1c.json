  "rdfs:comment": {
    "de": [
      "Schließen Sie sich ein und lösen Sie in einem Team von 2 bis 5 Spielern Rätsel in einem unserer 4 Räume, deren Themen von lokalen Begebenheiten inspiriert sind.\r\nSchaffen Sie es, innerhalb der vorgegebenen Zeit wieder herauszukommen? Logik, Kombinationsgabe und Kooperation sind Ihre besten Verbündeten."
    ],
    "en": [
      "Come and lock yourself in and solve puzzles in teams of 2 to 5 players in one of our 4 rooms with themes inspired by local facts.\r\nWill you manage to get out of the room in the allotted time? Logic, deduction and cooperation will be your best allies."
    ],
    "it": [
      "Venite a chiudervi in casa e a risolvere enigmi in squadre da 2 a 5 giocatori in una delle nostre 4 stanze con temi ispirati a fatti locali.\r\nRiuscirete a uscire dalla stanza entro il tempo stabilito? Logica, deduzione e cooperazione saranno i vostri migliori alleati."
    ],
    "fr": [
      "Venez vous enfermer et résoudre des énigmes en équipe de 2 à 5 joueurs dans l'une de nos 4 salles aux thèmes inspirés de faits locaux.\r\nRéussirez-vous à sortir dans le temps imparti ? Pour cela logique, déduction, coopération seront vos meilleures alliées."
    ],
    "es": [
      "Ven a encerrarte y a resolver rompecabezas en equipos de 2 a 5 jugadores en una de nuestras 4 salas con temas inspirados en hechos locales.\r\n¿Conseguirás salir de la habitación en el tiempo previsto? La lógica, la deducción y la cooperación serán sus mejores aliados."
    ],
    "nl": [
      "Kom en sluit je op en los puzzels op in teams van 2 tot 5 spelers in een van onze 4 kamers met thema's geïnspireerd op lokale feiten.\r\nLukt het je om de kamer binnen de gestelde tijd te verlaten? Logica, deductie en samenwerking zullen je beste bondgenoten zijn."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Escape Hunt"
    ]
  },
