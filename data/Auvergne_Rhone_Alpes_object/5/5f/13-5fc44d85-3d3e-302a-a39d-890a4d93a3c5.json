  "rdfs:comment": {
    "de": [
      "Vernissage\r\n\r\nInnocence, Ausstellung von Estelle Darve, traumhafte Zeichnungen und Poesie.\r\nInnocence ist eine Serie von kleinen, bunten Zeichnungen mit trockenen Pastellkreiden und Wasserfarben."
    ],
    "en": [
      "Vernissage\r\n\r\nInnocence, Exhibition by Estelle Darve, dreamlike drawings and poetry.\r\nInnocence is a series of colorful pastel and watercolor drawings."
    ],
    "it": [
      "Apertura\r\n\r\nInnocence, mostra di Estelle Darve, disegni onirici e poesia.\r\nInnocence è una serie di piccoli disegni colorati a pastello secco e acquerello."
    ],
    "fr": [
      "Vernissage\r\n\r\nInnocence, Exposition d’Estelle Darve, dessins oniriques et poésies.\r\nInnocence est une série de petits dessins colorés aux pastels secs et à l’eau."
    ],
    "nl": [
      "Opening\r\n\r\nInnocence, tentoonstelling van Estelle Darve, dromerige tekeningen en poëzie.\r\nInnocence is een serie kleine kleurrijke tekeningen in droge pastel en aquarel."
    ],
    "es": [
      "Apertura\r\n\r\nInnocence, Exposición de Estelle Darve, dibujos oníricos y poesía.\r\nInnocence es una serie de pequeños dibujos coloristas en pastel seco y acuarela."
    ]
