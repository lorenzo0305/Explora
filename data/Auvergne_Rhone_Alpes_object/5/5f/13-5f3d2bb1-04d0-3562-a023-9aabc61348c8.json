  "rdfs:comment": {
    "de": [
      "Das Discopic befindet sich im Herzen der Rue des Moulins und ist eine Bar, in der Retro-Eleganz mit Disco-Energie verschmilzt, in einer einzigartigen Atmosphäre im Zentrum von Chamonix."
    ],
    "en": [
      "Located in the heart of Rue des Moulins, Discopic is a bar that fuses retro elegance with disco energy in a unique ambience in the center of Chamonix."
    ],
    "it": [
      "Situato nel cuore di Rue des Moulins, Discopic è un bar che fonde l'eleganza retrò con l'energia della discoteca in un'atmosfera unica nel centro di Chamonix."
    ],
    "fr": [
      "Situé au cœur de la Rue des Moulins, le Discopic est un bar qui fusionne l’élégance rétro avec l’énergie disco dans une ambiance unique au centre de Chamonix."
    ],
    "es": [
      "Situado en el corazón de la Rue des Moulins, Discopic es un bar que fusiona la elegancia retro con la energía de la música disco en un ambiente único en el centro de Chamonix."
    ],
    "nl": [
      "Discopic, gelegen in het hart van de Rue des Moulins, is een bar die retro elegantie combineert met disco energie in een unieke sfeer in het centrum van Chamonix."
    ]
  },
