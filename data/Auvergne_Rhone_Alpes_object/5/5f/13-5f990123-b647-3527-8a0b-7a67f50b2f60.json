  "rdfs:comment": {
    "de": [
      "Auf dem Programm: Konzerte von Schülern des Konservatoriums und der Gruppe The Paddy?s Friends, eine festliche Atmosphäre in den Farben des St. Patrick's Day! Ein geselliger musikalischer Moment, um einen Abend lang nach Irland zu reisen. Mit Reservierung beim Fremdenverkehrsamt."
    ],
    "en": [
      "On the program: Concerts by students from the conservatory and the group The Paddy?s Friends, a festive atmosphere in the colors of St. Patrick's Day! A convivial musical evening on the road to Ireland. Reservations required at the Tourist Office."
    ],
    "it": [
      "In programma: concerti degli studenti del Conservatorio e del gruppo The Paddy's Friends, in un'atmosfera festosa per il giorno di San Patrizio! È un ottimo modo per fare una gita serale in Irlanda. Prenotazione obbligatoria presso l'Ufficio del Turismo."
    ],
    "fr": [
      "Au programme : Concerts d’élèves du conservatoire et le groupe The Paddy’s Friends, une ambiance festive aux couleurs de la Saint-Patrick ! Un moment musical convivial pour voyager en Irlande le temps d’une soirée. Sur réservation à l'Office de Tourisme."
    ],
    "nl": [
      "Op het programma: Concerten door studenten van het Conservatorium en de groep The Paddy's Friends, in een feestelijke St Patrick's Day sfeer! Een geweldige manier om een avondje Ierland te bezoeken. Reserveren verplicht bij het toeristenbureau."
    ],
    "es": [
      "En el programa: Conciertos de estudiantes del Conservatorio y del grupo The Paddy's Friends, en un ambiente festivo por el Día de San Patricio Es una buena manera de hacer un viaje nocturno a Irlanda. Es necesario reservar en la Oficina de Turismo."
    ]
  },
