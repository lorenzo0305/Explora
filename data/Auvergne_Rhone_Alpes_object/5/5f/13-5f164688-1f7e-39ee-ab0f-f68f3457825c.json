  "rdfs:comment": {
    "de": [
      "Alpinski, Snowboard, Skitouren, Freestyle. In Gruppen oder privat, alle Niveaus.\r\nAnimationen: Nächtliche Schneeschuhwanderungen, Einführung in den Laser-Biathlon, Fackelabfahrt...\r\nReservierung online oder bei der ESF, je nach Verfügbarkeit der Skilehrer."
    ],
    "en": [
      "Alpine skiing, snowboarding, ski touring, freestyle. Group or private lessons, all levels. \r\nActivities: night snowshoeing, laser biathlon initiation, torchlight descent...\r\nBook online or at the ESF, depending on instructor availability."
    ],
    "it": [
      "Sci alpino, snowboard, sci alpinismo, freestyle. Gruppi o singoli, tutti i livelli.\r\nAttività: ciaspolate notturne, introduzione al laser biathlon, discesa con le fiaccole, ecc.\r\nPrenotazione online o presso l'ESF, in base alla disponibilità degli istruttori."
    ],
    "fr": [
      "Ski alpin, snowboard, ski de rando, freestyle. En groupe ou privés, tous niveaux. \r\nAnimations : raquettes nocturnes, initiation biathlon laser, descente au flambeaux...\r\nRéservation en ligne ou à l'ESF, en fonction de la disponibilité des moniteurs."
    ],
    "es": [
      "Esquí alpino, snowboard, esquí de travesía, freestyle. Grupos o individuales, todos los niveles.\r\nActividades: raquetas nocturnas, iniciación al biatlón láser, descenso con antorchas, etc.\r\nReserva en línea o en el FSE, según disponibilidad de los monitores."
    ],
    "nl": [
      "Alpineskiën, snowboarden, toerskiën, freestyle. In groep of privé, alle niveaus. \r\nAnimatie: nachtelijke sneeuwschoenwandelingen, initiatie laserbiatlon, afdaling met fakkels...\r\nReserveren online of bij de ESF, afhankelijk van de beschikbaarheid van de instructeurs."
    ]
  },
