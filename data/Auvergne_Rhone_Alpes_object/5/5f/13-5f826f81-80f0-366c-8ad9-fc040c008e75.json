  "rdfs:comment": {
    "de": [
      "\"Die Klavierstunde\", Nathalia Milstein, Klavierrezital. In der romantischen Welt des 19. Jahrhunderts, Beethoven, Liszt, Schumann.\r\nAusweichen auf den Temple du Mazet bei ungünstigem Wetter."
    ],
    "en": [
      "\"La leçon de piano\", Nathalia Milstein, piano recital. In the romantic world of the 19th century, Beethoven, Liszt, Schumann.\r\nWithdrawal to the Temple du Mazet in case of inclement weather."
    ],
    "it": [
      "\"La lezione di pianoforte\", Nathalia Milstein, recital di pianoforte. Nel mondo romantico del XIX secolo, Beethoven, Liszt, Schumann.\r\nRitiro al Temple du Mazet in caso di maltempo."
    ],
    "fr": [
      "\"La leçon de piano\", Nathalia Milstein, récital de piano. Dans l'univers romantique du XIXème, Beethoven, Liszt, Schumann.\r\nRepli temple du Mazet si météo défavorable."
    ],
    "es": [
      "\"La lección de piano\", Nathalia Milstein, recital de piano. En el mundo romántico del siglo XIX, Beethoven, Liszt, Schumann.\r\nRetirada al Temple du Mazet en caso de mal tiempo."
    ],
    "nl": [
      "\"De pianoles\", Nathalia Milstein, pianorecital. In de romantische wereld van de 19e eeuw, Beethoven, Liszt, Schumann.\r\nVerplaatsing naar de Temple du Mazet in geval van slecht weer."
    ]
  },
  "rdfs:label": {
