  "rdfs:comment": {
    "de": [
      "Das Hotel befindet sich am Fuße des Vercors-Gebirges und ist über die Autobahnen A480 und A48 erreichbar. Es ist ideal gelegen, weniger als eine Stunde von den Wintersportorten und 6 km vom Zentrum von Grenoble entfernt, und eignet sich perfekt für Ihren Geschäfts- oder Freizeitaufenthalt."
    ],
    "en": [
      "The hotel is located at the foot of the Vercors Mountain and the access to the highways A48 and 49 is very easy. Ideally situated at less than an hour from the Winter ski resorts, and 6 kms away from the city centre of Grenoble, it is ideal to your business or leisure travels."
    ],
    "it": [
      "L'hotel è situato ai piedi del Vercors ed è servito dalle autostrade A480 e A48. Idealmente situato a meno di un'ora dalle stazioni sciistiche e a 6 chimometri dal centro di Grenoble, è perfetto per i Suoi soggiorni d'affari o recreativi."
    ],
    "fr": [
      "L'hôtel est situé au pied du Vercors et desservi par les autoroutes A480 et A48. Idéalement situé à moins d'une heure des stations de sports d'hiver et à 6 km du centre de Grenoble, il est parfait pour vos séjours d'affaires ou d'agrément."
    ],
    "nl": [
      "Het hotel ligt aan de voet van de Vercors en wordt bediend door de snelwegen A480 en A48. Ideaal gelegen op minder dan een uur van de wintersportplaatsen en op 6 km van het centrum van Grenoble, het is perfect voor uw zakelijke of recreatieve verblijven."
    ],
    "es": [
      "El hotel se situa a los pies del Vercors y cerca de las autopistas A480 y A48. Idealmente situado a menos de una hora de las estaciónes de esquí y a 6km del centro de Grenoble, es perfecto para sus estancias de negocios y de vacaciones."
    ]
  },
