  "rdfs:comment": {
    "de": [
      "Abschlusskonzert der 60. Ausgabe des Festival de Musique en Bourbonnais mit dem Hermès-Quartett am Samstag, den 15. August 2026 um 18 Uhr in der Kirche Saint-Pierre in Châteloy.\r\nOmer Bouchez und Elise Liu: Violinen\r\nLou Yung-Hsin Chang: Viola\r\nYan Levionnpois: Violoncello"
    ],
    "en": [
      "Final concert of the 60th edition of the Festival de Musique en Bourbonnais with the Quatuor Hermès, Saturday August 15, 2026 at 6pm, in the Église Saint-Pierre de Châteloy.\r\nOmer Bouchez and Elise Liu: violins\r\nLou Yung-Hsin Chang: viola\r\nYan Levionnpois: cello"
    ],
    "it": [
      "Concerto finale del 60° Festival di Musica di Bourbonnais con il Quatuor Hermès, sabato 15 agosto 2026 alle 18.00, nella Chiesa di Saint-Pierre a Châteloy.\r\nOmer Bouchez e Elise Liu: violini\r\nLou Yung-Hsin Chang: viola\r\nYan Levionnpois: violoncello"
    ],
    "fr": [
      "Concert final de la 60ème édition du Festival de Musique en Bourbonnais avec le Quatuor Hermès, le samedi 15 août 2026 à 18h, en l'Église Saint-Pierre de Châteloy.\r\nOmer Bouchez et Elise Liu: violons\r\nLou Yung-Hsin Chang: alto\r\nYan Levionnpois: violoncelle"
    ],
    "nl": [
      "Slotconcert van het 60e Bourbonnais Muziekfestival met het Quatuor Hermès, op zaterdag 15 augustus 2026 om 18.00 uur, in de kerk Saint-Pierre in Châteloy.\r\nOmer Bouchez en Elise Liu: violen\r\nLou Yung-Hsin Chang: altviool\r\nYan Levionnpois: cello"
    ],
    "es": [
      "Concierto final del 60º Festival de Música de Bourbonnais con el Quatuor Hermès, el sábado 15 de agosto de 2026 a las 18:00 h, en la iglesia Saint-Pierre de Châteloy.\r\nOmer Bouchez y Elise Liu: violines\r\nLou Yung-Hsin Chang: viola\r\nYan Levionnpois: violonchelo"
    ]
  },
