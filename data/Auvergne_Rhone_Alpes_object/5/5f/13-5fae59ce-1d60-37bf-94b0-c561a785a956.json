  "rdfs:comment": {
    "de": [
      "Der Veranstaltungssaal des Museums ist ein idealer Ort für Ihre Versammlungen, Schulungen, Seminare, Sitzungen usw."
    ],
    "en": [
      "If you are a wine or heritage professional (interprofession, association, training organization, etc.), the museum's animation room is an ideal space for organizing your meetings, training sessions, seminars, assemblies, etc."
    ],
    "it": [
      "Se siete professionisti del vino o del patrimonio (associazioni di categoria, associazioni, enti di formazione, ecc.), la sala del museo è il luogo ideale per organizzare riunioni, sessioni di formazione, seminari, assemblee, ecc."
    ],
    "fr": [
      "Professionnels de la viticulture ou du patrimoine (interprofession, association, organisme de formation,…), la salle d'animation du musée est un espace idéal pour l'organisation de vos réunions, séances de formation, séminaires, assemblées,..."
    ],
    "es": [
      "Si es usted un profesional del vino o del patrimonio (asociación profesional, asociación, organismo de formación, etc.), el salón de actos del museo es el lugar ideal para celebrar sus reuniones, sesiones de formación, seminarios, asambleas, etc."
    ],
    "nl": [
      "Als je een wijn- of erfgoedprofessional bent (beroepsvereniging, vereniging, opleidingsorganisatie, enz.), is de feestzaal van het museum de ideale plaats om je vergaderingen, opleidingen, seminaries, bijeenkomsten, enz. te houden."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Salle d'animation du Musée de la vigne et du vin de Savoie"
    ]
  },
