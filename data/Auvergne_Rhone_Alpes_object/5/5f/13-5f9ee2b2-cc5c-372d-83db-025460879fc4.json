  "rdfs:comment": {
    "de": [
      "Handwerkliche Brauerei und Kräuterladen am Ortsausgang von Les Estables, Richtung Le Monastier. La Pastorale bietet Biere an, die mit seinem Bio-Hopfen und lokalen Heilpflanzen gebraut werden. Direktverkauf, Produkte aus der Region und Besichtigung nach Vereinbarung."
    ],
    "en": [
      "Artisanal brewery and herbalist's shop on the outskirts of Les Estables, in the direction of Le Monastier. La Pastorale offers beers brewed with organic hops and local medicinal plants. Direct sales, local products and visits by appointment."
    ],
    "it": [
      "Birreria artigianale ed erboristeria alla periferia di Les Estables, in direzione di Le Monastier. La Pastorale offre birre prodotte con luppolo biologico e piante medicinali locali. Vendita diretta, prodotti locali e visite su appuntamento."
    ],
    "fr": [
      "Brasserie et herboristerie artisanales à la sortie des Estables, direction Le Monastier. La Pastorale propose des bières brassées avec ses houblons bio et des plantes médicinales locales. Vente directe, produits du territoire et visite sur rendez-vous."
    ],
    "es": [
      "Cervecería artesanal y herboristería a las afueras de Les Estables, en dirección a Le Monastier. La Pastorale ofrece cervezas elaboradas con lúpulo ecológico y plantas medicinales locales. Venta directa, productos locales y visitas con cita previa."
    ],
    "nl": [
      "Ambachtelijke brouwerij en kruidenwinkel aan de rand van Les Estables, in de richting van Le Monastier. La Pastorale biedt bieren gebrouwen met biologische hop en lokale geneeskrachtige planten. Directe verkoop, lokale producten en bezoeken op afspraak."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Brasserie et herboristerie La Pastorale"
    ]
  },
