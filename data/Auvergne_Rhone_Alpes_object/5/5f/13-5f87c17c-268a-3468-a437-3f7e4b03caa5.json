  "rdfs:comment": {
    "de": [
      "Die Einrichtung liegt auf der Achse Lyon-Toulouse, 10 Minuten von Le Puy en Velay und Yssingeaux entfernt. Sie verfügt über 8 Zimmer mit eigenem Bad, ein traditionelles Restaurant, eine Bar und einen Tabakladen."
    ],
    "en": [
      "Located on the Lyon-Toulouse axis, 10 minutes from Le Puy en Velay and Yssingeaux, with 8 rooms with private bathroom, a traditional restaurant, a bar and a tobacconist's shop."
    ],
    "it": [
      "Situata sulla strada Lione-Tolosa, a 10 minuti da Le Puy en Velay e Yssingeaux, questa struttura dispone di 8 camere con bagno privato, un ristorante tradizionale, un bar e una tabaccheria."
    ],
    "fr": [
      "Etablissement situé sur l’axe Lyon-Toulouse, à 10 minutes du Puy en Velay et d’Yssingeaux, doté de 8 chambres avec sanitaires privatifs, d’un restaurant traditionnel, d’un bar et d'un bureau de tabac."
    ],
    "es": [
      "Este establecimiento, situado en la carretera Lyon-Toulouse, a 10 minutos de Le Puy en Velay y de Yssingeaux, dispone de 8 habitaciones con baño privado, un restaurante tradicional, un bar y un estanco."
    ],
    "nl": [
      "Dit etablissement ligt aan de weg Lyon-Toulouse, op 10 minuten van Le Puy en Velay en Yssingeaux. Het beschikt over 8 kamers met eigen badkamer, een traditioneel restaurant, een bar en een tabakswinkel."
    ]
  },
