  "rdfs:comment": {
    "de": [
      "Zögern Sie nicht, durch die Tür des Fremdenverkehrsamtes von Bourdeaux zu gehen. Dort finden Sie alle Informationen, die Sie für Ihren Aufenthalt in der Region Pays de Dieulefit-Bourdeaux benötigen."
    ],
    "en": [
      "Don't hesitate to drop in at the Bourdeaux Tourist Office. You'll find all the information you need for your stay in the Pays de Dieulefit-Bourdeaux."
    ],
    "it": [
      "Non esitate a visitare l'Ufficio del Turismo di Bourdeaux. Troverete tutte le informazioni necessarie per il vostro soggiorno nel Pays de Dieulefit-Bourdeaux."
    ],
    "fr": [
      "N'hésitez pas à passer la porte de l'Office de Tourisme de Bourdeaux. Vous y trouverez toutes les informations nécessaires à votre séjour dans le Pays de Dieulefit-Bourdeaux."
    ],
    "es": [
      "No dude en acudir a la Oficina de Turismo de Burdeos. Encontrará toda la información necesaria para su estancia en el Pays de Dieulefit-Bourdeaux."
    ],
    "nl": [
      "Aarzel niet om langs te gaan bij het Office du Tourisme van Bourdeaux. U vindt er alle informatie die u nodig hebt voor uw verblijf in de omgeving van Dieulefit-Bourdeaux."
    ]
  },
  "rdfs:label": {
