  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Ziegenkäsesorten von Adrien.\r\nBesuchen Sie den Bauernhof und lernen Sie die Käseverarbeitung kennen.\r\nKleiner Imbiss, der mit den Produkten des Hofes zubereitet wird.\r\nDirektverkauf von Käse und hausgemachten Marmeladen: Heugelee, Linsen..."
    ],
    "en": [
      "Come and discover Adrien's goat cheeses.\r\nVisit the farm and see how cheese is made.\r\nLight meals prepared with farm produce.\r\nDirect sales of artisanal cheeses and jams: hay jelly, lentils..."
    ],
    "it": [
      "Venite a scoprire i formaggi di capra di Adrien.\r\nVisitate la fattoria e scoprite come viene prodotto il formaggio.\r\nSpuntini a base di prodotti della fattoria.\r\nVendita diretta di formaggi e marmellate fatte in casa: gelatina di fieno, lenticchie, ecc."
    ],
    "fr": [
      "Venez découvrir les fromages de chèvre d'Adrien.\r\nVisite de la ferme et découverte de la transformation fromagère.\r\nPetite  restauration élaborée avec  les produits de la ferme.\r\nVente directe fromages et confitures artisanales : gelée de foin, lentilles..."
    ],
    "es": [
      "Venga a descubrir los quesos de cabra de Adrien.\r\nVisite la granja y vea cómo se elabora el queso.\r\nAperitivos elaborados con productos de la granja.\r\nVenta directa de queso y mermeladas caseras: jalea de heno, lentejas, etc."
    ],
    "nl": [
      "Kom en ontdek de geitenkazen van Adrien.\r\nBezoek de boerderij en zie hoe de kaas wordt gemaakt.\r\nSnacks gemaakt met producten van de boerderij.\r\nDirecte verkoop van kaas en zelfgemaakte jam: hooigelei, linzen, etc."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les fromages d'Adrien"
    ]
  },
