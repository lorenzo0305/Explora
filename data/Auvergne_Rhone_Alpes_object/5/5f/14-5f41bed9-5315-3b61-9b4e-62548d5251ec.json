  "rdfs:comment": {
    "de": [
      "Ihr Weinhändler heißt Sie herzlich willkommen, um Ihnen alle Geschmacksrichtungen ihrer Weine, Champagner, Spirituosen und Biere vorzustellen."
    ],
    "en": [
      "Your wine merchant welcomes you warmly to help you discover all the flavours of their wines, champagnes, spirits and beers."
    ],
    "it": [
      "Il vostro enotecario vi accoglie calorosamente per farvi scoprire tutti i sapori dei suoi vini, champagne, liquori e birre."
    ],
    "fr": [
      "Votre caviste vous accueille chaleureusement pour faire découvrir toutes les saveurs de leurs vins, de leurs champagnes, de leurs spiritueux et de leurs bières."
    ],
    "nl": [
      "Uw wijnhandelaar ontvangt u hartelijk om alle smaken van zijn wijnen, champagnes, sterke dranken en bieren te ontdekken."
    ],
    "es": [
      "Su comerciante de vinos le da una cálida bienvenida para que descubra todos los sabores de sus vinos, champanes, licores y cervezas."
    ]
  },
