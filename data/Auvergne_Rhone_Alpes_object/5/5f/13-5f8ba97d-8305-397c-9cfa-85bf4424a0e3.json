  "rdfs:comment": {
    "de": [
      "Guillaume Pley lädt Sie gemeinsam mit hochkarätigen Gästen und Ausnahmekünstlern ein, während der Legend Tour am 29. Oktober 2026 in der LDLC Arena in Lyon-Décines schwebende Momente und exklusive künstlerische Darbietungen zu erleben."
    ],
    "en": [
      "Guillaume Pley, accompanied by prestigious guests and exceptional artists, invites you to experience suspended moments and exclusive artistic performances during the Legend Tour, on October 29, 2026 at the LDLC Arena in Lyon-Décines."
    ],
    "it": [
      "Guillaume Pley, accompagnato da ospiti prestigiosi e artisti d'eccezione, vi invita a vivere momenti sospesi e performance artistiche esclusive durante il Legend Tour il 29 ottobre 2026 all'Arena LDLC di Lione-Décines."
    ],
    "fr": [
      "Guillaume Pley, accompagné d’invités de prestige et d’artistes d’exception, vous invite à vivre des instants suspendus et des performances artistiques exclusives lors du Legend Tour, le 29 octobre 2026 à la LDLC Arena de Lyon-Décines."
    ],
    "nl": [
      "Guillaume Pley, vergezeld door prestigieuze gasten en uitzonderlijke artiesten, nodigt je uit om zwevende momenten en exclusieve artistieke optredens te beleven tijdens de Legend Tour op 29 oktober 2026 in de LDLC Arena in Lyon-Décines."
    ],
    "es": [
      "Guillaume Pley, acompañado de prestigiosos invitados y artistas excepcionales, le invita a vivir momentos suspendidos y actuaciones artísticas exclusivas durante la Gira de la Leyenda, el 29 de octubre de 2026 en el LDLC Arena de Lyon-Décines."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Legend Tour by Trade Republic"
    ]
  },
