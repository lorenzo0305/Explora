  "rdfs:comment": {
    "de": [
      "La Vitrine Flow befindet sich im Herzen von Les Vans und ist eine kollektive Boutique für Kunsthandwerk und Drucke. Entdecken Sie das Know-how lokaler Handwerker und Künstler sowie von Gästen aus anderen Ländern."
    ],
    "en": [
      "Located in the heart of Les Vans, La Vitrine Flow is a collective craft and print shop.\r\nDiscover the expertise of local craftspeople, artists and guests from abroad."
    ],
    "it": [
      "Situata nel cuore di Les Vans, La Vitrine Flow è una bottega collettiva di artigianato e stampa. Scoprite l'esperienza di artigiani e artisti locali, ma anche di ospiti provenienti da altri paesi."
    ],
    "fr": [
      "Située au cœur des Vans, La Vitrine Flow est une boutique collective de métiers d’art et d’estampes. Découvrez le savoir-faire des artisans et artistes locaux, ainsi que des invités venus d’ailleurs."
    ],
    "es": [
      "Situada en el corazón de Les Vans, La Vitrine Flow es una tienda colectiva de artesanía e imprenta. Descubre la experiencia de artesanos y artistas locales, así como de invitados de otros lugares."
    ],
    "nl": [
      "La Vitrine Flow, gelegen in het hart van Les Vans, is een collectieve ambachts- en drukkerij. Ontdek de expertise van lokale ambachtslieden en kunstenaars, maar ook van gasten van elders."
    ]
  },
