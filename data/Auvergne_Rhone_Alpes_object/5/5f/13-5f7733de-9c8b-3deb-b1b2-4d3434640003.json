  "rdfs:comment": {
    "de": [
      "Direkter Zugang von den Pisten im Viertel Mottet. Traditionelle Feinschmeckerküche und Pizzeria in familiärer und geselliger Atmosphäre mittags und abends."
    ],
    "en": [
      "Direct access from the slopes to the Mottet district. Traditional gourmet cuisine and pizzeria in a friendly family atmosphere for lunch and dinner."
    ],
    "it": [
      "Accesso diretto dalle piste al quartiere Mottet. Cucina tradizionale gourmet e pizzeria in un'atmosfera familiare e amichevole per pranzo e cena."
    ],
    "fr": [
      "En accès direct depuis les pistes au quartier du Mottet. Cuisine traditionnelle gourmande et Pizzeria dans une ambiance familiale et conviviale midi et soir."
    ],
    "nl": [
      "Directe toegang vanaf de pistes naar de wijk Mottet. Traditionele gastronomische keuken en pizzeria in een vriendelijke familiesfeer voor lunch en diner."
    ],
    "es": [
      "Acceso directo desde las pistas al barrio del Mottet. Cocina gastronómica tradicional y pizzería en un ambiente familiar y acogedor para almorzar y cenar."
    ]
  },
