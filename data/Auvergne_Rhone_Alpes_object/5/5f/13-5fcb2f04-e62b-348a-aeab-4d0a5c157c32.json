  "rdfs:comment": {
    "de": [
      "Ein Nachmittag rund um den Brotofen des Maison du Lieutenant, an dem Sie Ihre Brote und eine Brioche-Torte vollständig selbst herstellen können, alles über dem Holzfeuer gebacken."
    ],
    "en": [
      "An afternoon around the bread oven at the Lieutenant's House to make your own bread and a brioche tart, all baked over a wood fire."
    ],
    "it": [
      "Un pomeriggio nel forno a legna della Casa del Tenente per preparare il proprio pane e una crostata di brioche, il tutto cotto sul fuoco a legna."
    ],
    "fr": [
      "Une après-midi autour du four à pain de la Maison du Lieutenant pour réaliser entièrement vos pains et une tarte briochée, le tout cuit au feu de bois."
    ],
    "es": [
      "Una tarde en torno al horno de pan de la Casa del Teniente para elaborar su propio pan y una tarta de brioche, todo ello cocido al fuego de leña."
    ],
    "nl": [
      "Een middag rond de broodoven in het Luitenant's Huis om je eigen brood en een brioche taart te maken, allemaal gebakken boven een houtvuur."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Atelier : Four à pain"
    ]
