  "rdfs:comment": {
    "de": [
      "Maryse Chouvellon, Gesangslehrerin, Cathy Trufier, Erzählerin, und Michèle Dargaud, Klavierspielerin und Begleiterin, leiten Sie an, Ihre Stimme zu befreien und Ihren Körper zum Klingen zu bringen."
    ],
    "en": [
      "Singing teacher Maryse Chouvellon, storyteller Cathy Trufier and pianist-accompanist Michèle Dargaud will guide you in freeing your voice and making your body resonate from August 26 to 30 for a workshop on flavors and taste buds."
    ],
    "it": [
      "L'insegnante di canto Maryse Chouvellon, la narratrice Cathy Trufier e la pianista-accompagnatrice Michèle Dargaud vi guideranno a liberare la voce e a far risuonare il vostro strumento dal 26 al 30 agosto per un corso basato su sapori e papille gustative."
    ],
    "fr": [
      "Maryse Chouvellon professeur de chant, Cathy Trufier conteuse et Michèle Dargaud pianiste-accompagnatrice vous guideront pour libérer votre voix et faire résonner votre corps instrument du 26 au 30 août pour un stage autour des saveurs et papilles."
    ],
    "nl": [
      "Zangdocente Maryse Chouvellon, verhalenvertelster Cathy Trufier en pianiste-begeleidster Michèle Dargaud begeleiden je van 26 tot 30 augustus bij het bevrijden van je stem en het laten klinken van je instrument voor een cursus gebaseerd op smaken en smaakpapillen."
    ],
    "es": [
      "La profesora de canto Maryse Chouvellon, la cuentacuentos Cathy Trufier y la pianista-acompañante Michèle Dargaud le guiarán para liberar su voz y hacer resonar su instrumento del 26 al 30 de agosto en un curso basado en los sabores y las papilas gustativas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Stage de chants et contes \"L'Expression Voix et Corps chantée et contée\" Saveurs et papilles"
    ]
  },
