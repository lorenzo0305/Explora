  "rdfs:comment": {
    "de": [
      "Machen Sie eine Pause in diesem Gasthaus im Herzen des Dorfes Bully. Bistro, Gasthaus, Brotverkauf, Lebensmittelgeschäft, Poststation. Es wird Ihnen eine Küche serviert, die hauptsächlich aus lokalen Produkten besteht. Tagesmenü von Dienstag bis Freitag."
    ],
    "en": [
      "Take a break at this inn in the heart of the village of Bully. Bistro, inn, bread shop, grocery store, post office. You'll be served cuisine based on local produce. Daily menu Tuesday to Friday."
    ],
    "it": [
      "Venite a fare una pausa in questa locanda nel cuore del villaggio di Bully. Bistrot, locanda, panetteria, negozio di alimentari, ufficio postale. Vi verrà servita una cucina basata principalmente su prodotti locali. Menù giornaliero da martedì a venerdì."
    ],
    "fr": [
      "Venez faire une pause dans cette auberge située en plein cœur du village de Bully. Bistrot, auberge, dépôt de pain, épicerie, relais poste. Une cuisine essentiellement réalisée avec des produits locaux vous sera servie. Menu du jour du mardi au vendredi."
    ],
    "es": [
      "Venga a descansar a esta posada situada en el corazón del pueblo de Bully. Bistro, posada, panadería, tienda de ultramarinos, oficina de correos. Le servirán una cocina basada principalmente en productos locales. Menú diario de martes a viernes."
    ],
    "nl": [
      "Kom tot rust in deze herberg in het hart van het dorp Bully. Bistro, herberg, brooddepot, kruidenierswinkel, postkantoor. U krijgt een keuken voorgeschoteld die voornamelijk gebaseerd is op lokale producten. Dagmenu van dinsdag tot vrijdag."
    ]
  },
