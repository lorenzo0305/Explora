  "rdfs:comment": {
    "de": [
      "Die Guinguettes kehren im Juli und August zurück. Finden Sie sie an den Ufern des Flusses Souchez, zur Freude von Groß und Klein."
    ],
    "en": [
      "The guinguettes are back in July and August. Join them on the banks of the Souchez, for the pleasure of young and old alike."
    ],
    "it": [
      "Le guinguettes tornano a luglio e agosto. Le troverete sulle rive del Souchez, per la gioia di grandi e piccini."
    ],
    "fr": [
      "Les guinguettes reviennent en juillet et en aout. Retrouvez-les sur les berges de la Souchez, pour le plaisir des petits et des grands."
    ],
    "es": [
      "Las guinguettes vuelven en julio y agosto. Las encontrará a orillas del Souchez, para deleite de grandes y pequeños."
    ],
    "nl": [
      "De guinguettes zijn terug in juli en augustus. Je vindt ze op de oevers van de Souchez, tot groot genoegen van jong en oud."
    ]
  },
