  "rdfs:comment": {
    "de": [
      "Sie suchen einen Anfänger- oder Fortgeschrittenenkurs für Ski oder Snowboard?\r\nSind Sie ein Fan von Tiefschneefahren?\r\nSuchen Sie eine Skitour oder ein Splitboard?"
    ],
    "en": [
      "You look for courses of initiation or of improvement into ski or in snowboard?\r\nYou are a fan of the off-piste skiing?\r\nYou look for a trip in ski touring or in Split-board?"
    ],
    "it": [
      "Siete alla ricerca di lezioni di sci o snowboard per principianti o avanzati?\r\nSiete appassionati di fuoripista?\r\nSiete alla ricerca di un viaggio di scialpinismo o di splitboard?"
    ],
    "fr": [
      "Vous recherchez des cours d'initiation ou de perfectionnement à ski ou en snowboard?\r\nVous êtes adepte du hors piste?\r\nVous recherchez une sortie en ski de randonnée ou en split-board?"
    ],
    "es": [
      "¿Busca clases de esquí o snowboard para principiantes o avanzados?\r\n¿Es usted un entusiasta del fuera de pista?\r\n¿Busca un viaje de esquí de travesía o de split-board?"
    ],
    "nl": [
      "Bent u op zoek naar ski- of snowboardlessen voor beginners of gevorderden?\r\nBent u een off-piste liefhebber?\r\nOp zoek naar een toerski- of splitboarderuitje?"
    ]
  },
