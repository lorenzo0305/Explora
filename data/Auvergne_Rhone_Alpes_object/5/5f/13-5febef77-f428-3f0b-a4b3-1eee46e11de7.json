  "rdfs:comment": {
    "de": [
      "\"Les curiosités d'Isa\" ist der Name des Bildhauerateliers, in dem Isabelle Ihnen mit Freude ihre kleine Fantasiewelt zeigt, ihre Skulpturen aus powertex (umweltfreundliches Verfestigungsmittel), aus recycelten Stoffen (Bettlaken oder T-Shirts) und aus Papier."
    ],
    "en": [
      "\"Les curiosités d'Isa\" are the name of a sculpting workshop where Isabelle is happy to introduce you to her little imaginary world, and show you her sculptures made of powertex (ecological solidifier), recycled fabric (sheets or tee-shirts) and paper."
    ],
    "it": [
      "\"Les curiosités d'Isa\" (Le curiosità di Isa) è il nome del laboratorio di scultura di Isabelle, dove ci si può divertire a scoprire il suo piccolo mondo immaginario e le sue sculture realizzate in powertex (un solidificante ecologico), tessuti riciclati (lenzuola o magliette) e carta."
    ],
    "fr": [
      "\"Les curiosités d'Isa\" sont le nom de l'atelier de sculpture où Isabelle vous fait découvrir avec plaisir son petit monde imaginaire, ses sculptures en powertex (solidifiant écologique), en tissus recyclés (draps ou tee-shirts), et en papier."
    ],
    "nl": [
      "\"Les curiosités d'Isa\" is de naam van Isabelle's beeldhouwatelier, waar je kunt genieten van het ontdekken van haar kleine fantasiewereld en haar sculpturen gemaakt van powertex (een ecologisch stollingsmiddel), gerecyclede stoffen (lakens of T-shirts) en papier."
    ],
    "es": [
      "\"Les curiosités d'Isa\" (Las curiosidades de Isa) es el nombre del taller de escultura de Isabelle, donde podrá disfrutar descubriendo su pequeño mundo imaginario y sus esculturas realizadas con powertex (un solidificante ecológico), telas recicladas (sábanas o camisetas) y papel."
    ]
  },
  "rdfs:label": {
    "en": [
