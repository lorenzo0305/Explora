      "dc:description": {
        "de": [
          "Programm Fête de la Science 2025\nMuseen in Boulogne-sur-Mer\nGrafisches Schloss\n\nSpielen mit der ganzen Familie\nDie Stunde des wissenschaftlichen Spiels\nAb 5 Jahren\n\nReservierung empfohlen."
        ],
        "en": [
          "Fête de la Science 2025 program\nBoulogne-sur-Mer Museums\nChâteau comtal\n\nFamily fun\nScience playtime\nAges 5 and up\n\nReservations recommended."
        ],
        "it": [
          "Programma della Festa della Scienza 2025\nMusei di Boulogne-sur-Mer\nCastello del Conte\n\nGiochi per famiglie\nGioco scientifico\nDa 5 anni\n\nPrenotazione consigliata."
        ],
        "fr": [
          "Programme Fête de la Science 2025\nMusées de Boulogne-sur-Mer\nChâteau comtal \n\nJouer en famille\nL’heure du jeu scientifique\nDès 5 ans\n\nRéservation conseillée."
        ],
        "nl": [
          "Programma Fête de la Science 2025\nBoulogne-sur-Mer Musea\nKasteel van de graaf\n\nSpelletjes voor het hele gezin\nWetenschap spelletjes\nVanaf 5 jaar\n\nReserveren aanbevolen."
        ],
        "es": [
          "Programa de la Fiesta de la Ciencia 2025\nMuseos de Boulogne-sur-Mer\nCastillo del Conde\n\nJuegos en familia\nLa hora del juego científico\nA partir de 5 años\n\nSe recomienda reservar."
        ]
      },
