  "rdfs:comment": {
    "de": [
      "INFLU8 ist eine in Riom entwickelte Marke für Sporternährung der neuen Generation, die darauf ausgelegt ist, sowohl Alltagssportler als auch engagierte Athleten mit einfachen, wirksamen und erschwinglichen Lösungen zu begleiten."
    ],
    "en": [
      "INFLU8 is a new-generation sports nutrition brand developed in Riom, designed to support both everyday and committed athletes, with simple, effective and accessible solutions."
    ],
    "it": [
      "INFLU8 è un marchio di nutrizione sportiva di nuova generazione sviluppato a Riom, pensato per supportare gli sportivi di tutti i giorni e gli atleti impegnati, con soluzioni semplici, efficaci e accessibili."
    ],
    "fr": [
      "INFLU8 est une marque de nutrition sportive nouvelle génération développée à Riom, pensée pour accompagner les sportifs du quotidien comme les athlètes engagés, avec des solutions simples, efficaces et accessibles."
    ],
    "nl": [
      "INFLU8 is een nieuwe generatie sportvoedingsmerk ontwikkeld in Riom, ontworpen om zowel alledaagse sporters als toegewijde atleten te ondersteunen met eenvoudige, effectieve en toegankelijke oplossingen."
    ],
    "es": [
      "INFLU8 es una marca de nutrición deportiva de nueva generación desarrollada en Riom, diseñada para apoyar tanto a los deportistas cotidianos como a los atletas comprometidos, con soluciones sencillas, eficaces y accesibles."
    ]
  },
