  "rdfs:comment": {
    "de": [
      "Das Potenzial der Singstimme entdecken, ihre Mechanismen verstehen, mit ihren ungeahnten Möglichkeiten spielen und Spaß am Singen haben."
    ],
    "en": [
      "Discover the potential of your singing voice, understand its mechanisms, play with its unsuspected possibilities and have fun singing."
    ],
    "it": [
      "Scoprite il potenziale della vostra voce, comprendete i suoi meccanismi, giocate con le sue possibilità insospettate e divertitevi a cantare."
    ],
    "fr": [
      "Découvrir le potentiel de sa voix chantée, en comprendre les mécanismes, jouer avec ses possibilités insoupçonnées, s’amuser en chantant."
    ],
    "nl": [
      "Ontdek het potentieel van je zangstem, begrijp de mechanismen, speel met de onvermoede mogelijkheden en beleef plezier aan het zingen."
    ],
    "es": [
      "Descubra el potencial de su voz cantada, comprenda sus mecanismos, juegue con sus insospechadas posibilidades y diviértase cantando."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Stage de chant \"découvrir et explorer sa voix\""
    ]
  },
