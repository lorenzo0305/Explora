  "rdfs:comment": {
    "de": [
      "Panorama, das Sie bei der Wanderung zum Roche d'Au-Delà von Nantua aus entdecken können. Weite Sicht auf das Jura-Gebirge und die Alpenkette mit dem Mont Blanc."
    ],
    "en": [
      "A panorama which you can discover during the \"La Roche d'Au-Delà\" or the \"Tour du Plateau de Chamoise\" walks starting from Nantua. Extensive view of the Jura Mountains and the Alps with Mont Blanc."
    ],
    "it": [
      "Panorama da scoprire durante l'escursione alla Roche d'Au-Delà da Nantua. Ampia vista sulle montagne del Giura e sulle Alpi con il Monte Bianco."
    ],
    "fr": [
      "Panorama à découvrir lors de la randonnée pédestre de la Roche d'Au-Delà au départ de Nantua. Vue étendue sur les Monts du Jura et la chaîne des Alpes avec le Mont Blanc."
    ],
    "nl": [
      "Panorama te ontdekken tijdens de Roche d'Au-Delà wandeling vanuit Nantua. Weids uitzicht op het Juragebergte en de Alpen met de Mont Blanc."
    ],
    "es": [
      "Panorama a descubrir durante la excursión a la Roche d'Au-Delà desde Nantua. Amplia vista de las montañas del Jura y los Alpes con el Mont Blanc."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Panorama des Monts d'Ain"
    ]
  },
