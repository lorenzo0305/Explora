  "rdfs:comment": {
    "de": [
      "Ein freundliches, familiäres Lokal in einer privilegierten Umgebung am Ufer der Saône, wo Sie eine qualitativ hochwertige Küche genießen können."
    ],
    "en": [
      "A friendly, family-run establishment in a privileged setting on the banks of the Saône where you can enjoy a quality cuisine."
    ],
    "it": [
      "Una struttura accogliente e familiare in un ambiente privilegiato sulle rive della Saona, dove potrete gustare una cucina di qualità."
    ],
    "fr": [
      "Etablissement convivial, familial dans un cadre privilégié en bord de saône où vous pourrez déguster une cusine de qualité."
    ],
    "es": [
      "Un establecimiento familiar y acogedor en un entorno privilegiado a orillas del Saona donde podrá disfrutar de una cocina de calidad."
    ],
    "nl": [
      "Een vriendelijk familiebedrijf in een bevoorrechte omgeving aan de oevers van de Saône, waar u kunt genieten van een kwaliteitskeuken."
    ]
  },
