  "rdfs:comment": {
    "de": [
      "Ludovic Challit ist seit über 10 Jahren Brauer und hat von nun an nur noch ein Ziel: die Leidenschaft für die Bierherstellung mit dem Wunsch zu verbinden, Bier zu entdecken. Die Biere stammen aus biologischem Anbau und werden mit lokalen Zutaten gebraut."
    ],
    "en": [
      "A brewer for over 10 years, Ludovic Challit now has just one objective: to combine a passion for beer-making with a desire to help people discover beer. The beers are organic and brewed with local ingredients."
    ],
    "it": [
      "Birraio da oltre 10 anni, Ludovic Challit ha oggi un solo obiettivo: coniugare la passione per la produzione di birra con il desiderio di aiutare le persone a scoprire la birra. Le birre sono biologiche e prodotte con ingredienti locali."
    ],
    "fr": [
      "Brasseur depuis plus de 10 ans, Ludovic Challit n'a désormais qu'un seul objectif : allier passion de la fabrication de la bière et envie de faire découvrir la bière. Les bières sont en Agriculture Biologique et brassées avec des ingrédients locaux."
    ],
    "nl": [
      "Ludovic Challit is al meer dan 10 jaar brouwer en heeft nu nog maar één doel: zijn passie voor bier maken combineren met het verlangen om mensen bier te laten ontdekken. De bieren zijn biologisch en gebrouwen met lokale ingrediënten."
    ],
    "es": [
      "Cervecero desde hace más de 10 años, Ludovic Challit tiene ahora un único objetivo: combinar la pasión por hacer cerveza con el deseo de ayudar a la gente a descubrirla. Las cervezas son ecológicas y se elaboran con ingredientes locales."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Brasserie Challit ICSAS"
    ]
  },
