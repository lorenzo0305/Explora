  "rdfs:comment": {
    "de": [
      "Tauchen Sie ein in das Herz des größten Decathlon-Geschäfts in der Metropole Lille! Profitieren Sie von einem Gastronomieangebot und einer Vielzahl von Sportaktivitäten: Kurse, Praktika für Erwachsene und Kinder, Geburtstagsorganisationen und Privatisierungen von Sportplätzen."
    ],
    "en": [
      "Immerse yourself in the heart of the largest Decathlon store in the Lille area! Take advantage of our catering facilities and a wide range of sporting activities, including lessons, adult and children's courses, birthday parties and field privatizations."
    ],
    "it": [
      "Immergetevi nel cuore del più grande negozio Decathlon della zona di Lille! Approfittate delle nostre strutture di ristorazione e di un'ampia gamma di attività sportive: lezioni, corsi per adulti e bambini, feste di compleanno e campi privati."
    ],
    "fr": [
      "Plongez au coeur du plus grand magasin Decathlon de la métropole lilloise ! Profitez d'une offre de restauration et d'une multitude d'activités sportives : cours, stages adultes et enfants, organisations d'anniversaires et privatisation de terrains."
    ],
    "es": [
      "Sumérgete en el corazón de la tienda Decathlon más grande de la región de Lille Aprovecha nuestras instalaciones de restauración y una amplia oferta de actividades deportivas: clases, cursos para adultos y niños, fiestas de cumpleaños y campos privados."
    ],
    "nl": [
      "Dompel je onder in het hart van de grootste Decathlon-winkel in de buurt van Lille! Profiteer van onze cateringfaciliteiten en een ruim aanbod aan sportactiviteiten: lessen, cursussen voor volwassenen en kinderen, verjaardagsfeestjes en privévelden."
    ]
  },
  "rdfs:label": {
