  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Beaujolais mit Geocaching: eine Schatzsuche für die ganze Familie!\r\nIn Lucenay gilt es, den Gnolu Ebooli aufzuspüren! Es liegt an Ihnen, ihn zu fangen: Folgen Sie den Gassen des Dorfes und entdecken Sie die lokale Geologie."
    ],
    "en": [
      "Discover Beaujolais with geocaching: a treasure hunt for all the family!\r\nIn Lucenay, it's time to find the Gnolu Ebooli! It's up to you to find it: follow the village lanes and discover the local geology."
    ],
    "it": [
      "Scoprite il Beaujolais con il geocaching: una caccia al tesoro per tutta la famiglia!\r\nA Lucenay, è lo Gnolu Ebooli che dovrete scovare! Sta a voi trovarlo: seguite le stradine del villaggio e scoprite la geologia locale."
    ],
    "fr": [
      "Découvrez le Beaujolais avec le géocaching : une chasse aux trésors à vivre en famille ! \r\nÀ Lucenay, c'est le Gnolu Ebooli qu'il faudra débusquer ! À vous de l'attraper : suivez les ruelles du village et découvrez la géologie locale."
    ],
    "nl": [
      "Ontdek de Beaujolais met geocaching: een schattenjacht voor het hele gezin!\r\nIn Lucenay is het de Gnolu Ebooli die je moet opsporen! Aan jou om hem te vinden: volg de smalle straatjes van het dorp en ontdek de plaatselijke geologie."
    ],
    "es": [
      "Descubra el Beaujolais con el geocaching: ¡una búsqueda del tesoro para toda la familia!\r\nEn Lucenay, tendrás que encontrar el Gnolu Ebooli De ti depende encontrarlo: recorre las callejuelas del pueblo y descubre la geología local."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Gnolus - Lucenay, petit bijou…"
    ]
  },
