  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/87a649f3-d106-3b34-99b3-7e4062aa72c5",
      "dc:description": {
        "de": [
          "Informationen :\n\nÖffnungstage:\n\nTäglich von 9:30 bis 12:00 Uhr und von 14:15 bis 18:00 Uhr. Nur am Montagmorgen geschlossen\n\nAbholung :\n\nBei der Abholung\nBezahlung: Scheck oder Bargeld\n\nBestellungen :\n\nTelefonische Bestellung möglich: 07 49 56 40 87\n\n "
        ],
        "en": [
          "Information :\n\nOpening days:\n\nDaily from 9:30am to 12pm and from 2:15pm to 6pm. Closed on Monday mornings only\n\nPick-up :\n\nAt the pick-up\nPayment: cheque or cash\n\nOrdering :\n\nYou can order by phone: 07 49 56 40 87\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura:\n\nTutti i giorni dalle 9.30 alle 12.00 e dalle 14.15 alle 18.00. Chiuso solo il lunedì mattina\n\nRaccolta :\n\nAl ritiro\nPagamento: assegno o contanti\n\nOrdini :\n\nÈ possibile ordinare per telefono: 07 49 56 40 87\n\n "
        ],
        "fr": [
          "Informations :\n\nJours d'ouverture:\n\nTous les jours de 9h30 à 12h et de 14h15 à 18h. Fermeture uniquement le lundi matin\n\nRetrait :\n\nÀ la cueillette\nRéglement: chèque ou espèces\n\nCommandes :\n\nPossibilité de commander par téléphone : 07 49 56 40 87\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen:\n\nElke dag van 9.30 tot 12.00 uur en van 14.15 tot 18.00 uur. Alleen op maandagochtend gesloten\n\nOphalen :\n\nBij het afhaalpunt\nBetaling: cheque of contant\n\nBestellingen :\n\nU kunt telefonisch bestellen: 07 49 56 40 87\n\n "
        ],
        "es": [
          "Más información :\n\nDías de apertura:\n\nTodos los días de 9h30 a 12h00 y de 14h15 a 18h00. Cerrado sólo los lunes por la mañana\n\nRecogida :\n\nEn el punto de recogida\nPago: cheque o efectivo\n\nPedidos :\n\nPuede hacer su pedido por teléfono: 07 49 56 40 87\n\n "
        ]
      },
