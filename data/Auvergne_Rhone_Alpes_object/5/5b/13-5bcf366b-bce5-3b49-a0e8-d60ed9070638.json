  "rdfs:comment": {
    "de": [
      "Dieses kleine ländliche Dorf liegt auf einem Hügel inmitten einer grünen Landschaft in der Nähe von Roanne, das es überblickt. Es verfügt über zahlreiche Bauernhöfe, aber auch über Geschäfte, Handwerker und ein ausgeprägtes Vereinsleben."
    ],
    "en": [
      "Situated on a hill, in the middle of lush green countryside, close to Roanne which it overlooks, this small rural village has many farms, but also shops, craftsmen and a highly-developed community life."
    ],
    "it": [
      "Situato su una collina, in mezzo a una campagna verdeggiante, vicino a Roanne su cui si affaccia, questo piccolo villaggio rurale ospita numerose fattorie, nonché negozi, artigiani e una vita comunitaria molto sviluppata."
    ],
    "fr": [
      "Situé sur une colline, au milieu d’une campagne verdoyante, à proximité de Roanne qu’il surplombe, ce petit village rural avec de nombreuses fermes mais aussi des commerces, des artisans et une vie associative très développée."
    ],
    "es": [
      "Situado en una colina, en medio de una campiña verde y exuberante, cerca de Roanne, a la que domina, este pequeño pueblo rural cuenta con numerosas granjas, así como tiendas, artesanos y una vida comunitaria muy desarrollada."
    ],
    "nl": [
      "Dit kleine plattelandsdorpje ligt op een heuvel, midden in een weelderig groen landschap, dicht bij Roanne waar het over uitkijkt. Het heeft talrijke boerderijen, winkels, ambachtslieden en een sterk ontwikkeld gemeenschapsleven."
    ]
  },
  "rdfs:label": {
