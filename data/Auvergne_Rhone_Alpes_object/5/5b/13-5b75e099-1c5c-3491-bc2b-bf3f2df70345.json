  "rdfs:comment": {
    "de": [
      "Der Bergsee 'Lac du Brévent' liegt unweit der Bergstation der Brévent-Seilbahn. Dieser Gletschersee liegt in 2125 m Höhe."
    ],
    "en": [
      "Lac du Brevent is not far from the arrival point of Le Brevent cable car. It is a glacial lake that lies 2,125 metres above sea level."
    ],
    "it": [
      "Il Lac du Brévent non si trova lontano dall'arrivo della funivia del Brévent. Di origine glaciale, si trova a 2125 m di altezza."
    ],
    "fr": [
      "Le Lac du Brévent est situé non-loin de l’arrivée du Téléphérique du Brévent.  D'origine glaciaire, il se trouve à 2 125 mètres d'altitude."
    ],
    "nl": [
      "Het Lac du Brévent ligt niet ver van de aankomst van de kabelbaan van Brévent.  Het is van glaciale oorsprong en ligt op een hoogte van 2.125 meter."
    ],
    "es": [
      "El Lac du Brévent se encuentra a corta distancia del punto de llegada del teleférico de Le Brévent. Es de origen glaciar y se halla a 2125 metros de altitud."
    ]
  },
