  "rdfs:comment": {
    "de": [
      "La Yaute Skydive lädt Sie ein, die Haute Savoie auf magische Weise zu entdecken und dabei in die Welt des Hubschrauberflugs und des Fallschirmspringens einzutauchen."
    ],
    "en": [
      "Yaute Skydive invites you to discover the Haute Savoie in a magical way, while immersing yourself in the world of helicopter flight and skydiving."
    ],
    "it": [
      "Yaute Skydive vi invita a scoprire l'Alta Savoia in modo magico, immergendovi nel mondo del volo in elicottero e del paracadutismo."
    ],
    "fr": [
      "La Yaute Skydive vous invite à découvrir la Haute Savoie de façon magique, tout en vous plongeant dans l'univers du vol en Hélicoptère et du parachutisme."
    ],
    "nl": [
      "Yaute Skydive nodigt u uit om de Haute Savoie op magische wijze te ontdekken en u onder te dompelen in de wereld van helikoptervliegen en parachutespringen."
    ],
    "es": [
      "Yaute Skydive le invita a descubrir la Alta Saboya de una forma mágica, mientras se sumerge en el mundo del vuelo en helicóptero y el paracaidismo."
    ]
  },
