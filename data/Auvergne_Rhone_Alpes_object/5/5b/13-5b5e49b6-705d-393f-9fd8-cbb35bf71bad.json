  "rdfs:comment": {
    "de": [
      "INFO WM 2025: Sessellift für Fußgänger hin und zurück zugänglich, Zugang zum Start der DH-Piste. Ähnliche Öffnungszeiten wie die Gondelbahn Mont Chéry, von Donnerstag, 28. bis Samstag, 30. August ab 8 Uhr bis 17.30 Uhr."
    ],
    "en": [
      "2025 WORLD CUP INFO: Pedestrian access to the chairlift from the DH trailhead. Similar opening hours to the Mont Chéry gondola, from Thursday August 28 to Saturday August 30, from 8am to 5:30pm."
    ],
    "it": [
      "INFO SULLA COPPA DEL MONDO 2025: Accesso pedonale da e per la seggiovia, all'inizio della pista di DH. Orari di apertura simili a quelli della funivia del Mont Chéry, da giovedì 28 a sabato 30 agosto dalle 8.00 alle 17.30."
    ],
    "fr": [
      "INFO COUPE DU MONDE 2025 : Télésiège accessible en aller-retour pour les piétons, accès au départ de la piste DH. Horaires similaires au télécabine du Mont Chéry, du jeudi 28 au samedi 30 août à partir de 8h et jusqu'à 17h30."
    ],
    "nl": [
      "2025 WORLD CUP INFO: Toegang voor voetgangers van en naar de stoeltjeslift, aan het begin van de DH piste. Openingstijden vergelijkbaar met die van de Mont Chéry kabelbaan, van donderdag 28 tot zaterdag 30 augustus van 8.00 tot 17.30 uur."
    ],
    "es": [
      "2025 WORLD CUP INFO: Acceso peatonal desde y hacia el telesilla, al comienzo de la pista DH. Horarios de apertura similares a los del teleférico de Mont Chéry, del jueves 28 al sábado 30 de agosto de 8:00 a 17:30."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Télésiège de la Pointe"
    ]
  },
