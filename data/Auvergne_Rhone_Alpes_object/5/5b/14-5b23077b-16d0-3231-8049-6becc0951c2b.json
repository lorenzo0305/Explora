  "rdfs:comment": {
    "de": [
      "In 100 Jahren hat sich die Stadt Harnes weiterentwickelt, ihre Sportvereine haben sich vervielfacht, es wurden große Anstrengungen unternommen und wichtige Entscheidungen getroffen, um Sportanlagen mit einem breiten Spektrum an Möglichkeiten einzurichten."
    ],
    "en": [
      "In 100 years, the town of Harnes has evolved, its sports associations have multiplied, and major efforts and choices have been made to set up sports facilities offering a wide range of possibilities."
    ],
    "it": [
      "In 100 anni, la città di Harnes si è evoluta, le associazioni sportive si sono moltiplicate e sono stati compiuti sforzi e scelte importanti per realizzare impianti sportivi che offrono un'ampia gamma di possibilità."
    ],
    "fr": [
      "En 100 ans la ville de Harnes a évolué, ses associations sportives se sont multipliées, des efforts et des choix importants ont été faits pour mettre en place des équipements sportifs offrant un large éventail de possibilités."
    ],
    "nl": [
      "In 100 jaar is de stad Harnes geëvolueerd, zijn de sportverenigingen vermenigvuldigd en zijn er grote inspanningen geleverd en keuzes gemaakt om sportfaciliteiten op te zetten die een breed scala aan mogelijkheden bieden."
    ],
    "es": [
      "En 100 años, la ciudad de Harnes ha evolucionado, sus asociaciones deportivas se han multiplicado y se han hecho grandes esfuerzos y elecciones para crear instalaciones deportivas que ofrezcan un amplio abanico de posibilidades."
    ]
  },
  "rdfs:label": {
