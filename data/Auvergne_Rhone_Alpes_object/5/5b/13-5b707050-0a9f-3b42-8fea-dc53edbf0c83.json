  "rdfs:comment": {
    "de": [
      "Im Herzen der grünen Ardèche, in Désaignes, präsentiert Ihnen GOLOSINA seine einzigartigen handwerklichen Kreationen, die dank einer alten Brombeerplantage entworfen wurden, die sanft am Ende eines Tals eingebettet ist und vom Rauschen eines Baches gewiegt wird."
    ],
    "en": [
      "In the heart of the green Ardèche, in Désaignes, GOLOSINA presents its unique artisanal creations, crafted from an ancient blackberry plantation delicately nestled at the bottom of a valley, serenaded by the murmur of a stream."
    ],
    "it": [
      "Nel cuore della verde Ardèche, a Désaignes, GOLOSINA presenta le sue creazioni uniche e artigianali, realizzate in un'antica piantagione di more, delicatamente adagiata sul fondo di una valle, cullata dal mormorio di un ruscello."
    ],
    "fr": [
      "Dans le coeur de l'Ardèche verte, à Désaignes, GOLOSINA vous présente ses créations artisanales uniques, conçues grâce à une ancienne plantation de mûres, délicatement nichée au fond d'un vallon, bercée par le murmure d'un ruisseau."
    ],
    "nl": [
      "In het hart van de groene Ardèche, in Désaignes, presenteert GOLOSINA u haar unieke ambachtelijke creaties, ontworpen met behulp van een oude braambessenplantage, teder genesteld in de diepte van een vallei, gesust door het gemurmel van een beek."
    ],
    "es": [
      "En el corazón de la verde Ardèche, en Désaignes, GOLOSINA presenta sus creaciones únicas y artesanales, creadas en una antigua plantación de moras, enclavada delicadamente en el fondo de un valle, arrullada por el murmullo de un arroyo."
    ]
  },
  "rdfs:label": {
    "en": [
      "Golosina - Pâtes de fruits d'Ardèche"
    ],
    "fr": [
      "Golosina - Pâtes de fruits d'Ardèche"
    ],
    "nl": [
      "Golosina - Pâtes de fruits d'Ardèche"
    ]
  },
