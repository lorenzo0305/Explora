  "rdfs:comment": {
    "de": [
      "Tauchen Sie ein in eine entspannende und revitalisierende Erfahrung im Oz 3300 Pool & Spa, das sich im Timberlodge Hotel befindet. Eine wahre Oase der Entspannung nach einem Tag auf der Piste!"
    ],
    "en": [
      "Dive into a relaxing and revitalizing experience at the Piscine and Spa d’Oz 3300, located at the Timberlodge Hotel. A true haven of tranquility after a day on the slopes!"
    ],
    "it": [
      "Immergetevi in un'esperienza rilassante e rivitalizzante presso la Piscina e Spa Oz 3300, situata nell'hotel Timberlodge. Un'oasi di relax dopo una giornata sulle piste!"
    ],
    "fr": [
      "Plongez dans une expérience relaxante et revitalisante à la Piscine et Spa d’Oz 3300, situé à l’hôtel Timberlodge. Un véritable havre de détente après une journée sur les pistes !"
    ],
    "es": [
      "Sumérgete en una experiencia relajante y revitalizante en la Oz 3300 Pool and Spa, situada en el hotel Timberlodge. Un paraíso de relajación después de un día en las pistas"
    ],
    "nl": [
      "Duik in een ontspannende en revitaliserende ervaring bij het Piscine en Spa d’Oz 3300, gelegen in het Timberlodge Hotel. Een ware oase van rust na een dag op de pistes!"
    ]
  },
  "rdfs:label": {
    "en": [
      "Oz 3300 Swimming Pool and Spa"
    ],
    "fr": [
      "Piscine et Spa d'Oz 3300"
    ],
    "nl": [
      "Oz 3300 Spa en ontspanningsruimte, sauna, stoombad"
    ]
