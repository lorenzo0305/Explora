  "rdfs:comment": {
    "de": [
      "Zu den Gepflogenheiten des Pfarrhauses gehörten auch Gottesdienste. Bei seinem ersten Besuch in Vichy im Jahr 1861 nahm Napoleon III. an der Messe in Saint-Blaise teil."
    ],
    "en": [
      "Religious services were a regular feature of the curacy. On his first visit to Vichy in 1861, Napoleon III attended mass at Saint-Blaise."
    ],
    "it": [
      "Le funzioni religiose erano una delle abitudini della cura. Durante la sua prima visita a Vichy, nel 1861, Napoleone III assistette alla messa a Saint-Blaise."
    ],
    "fr": [
      "Parmi les usages de la cure, figuraient les offices religieux. Lors de sa première venue à Vichy en 1861, Napoléon III assiste à la messe à Saint-Blaise."
    ],
    "nl": [
      "Religieuze diensten waren een van de gewoonten van de kuur. Tijdens zijn eerste bezoek aan Vichy in 1861 woonde Napoleon III de mis bij in Saint-Blaise."
    ],
    "es": [
      "Los oficios religiosos eran una de las costumbres del cura. En su primera visita a Vichy, en 1861, Napoleón III asistió a misa en Saint-Blaise."
    ]
  },
