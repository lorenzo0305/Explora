  "rdfs:comment": {
    "de": [
      "Das Bergmuseum erinnert an das ländliche Leben in den Bergen durch die Rekonstruktion traditioneller Wohnräume und die Präsentation ethnografischer Gegenstände, die früher im Tal von Chamonix verwendet wurden."
    ],
    "en": [
      "The mountain museum evokes rural life in the mountains through the reconstitution of the rooms of the traditional habitat and the presentation of ethnographic objects used in the past in the valley of Chamonix."
    ],
    "it": [
      "Il museo della montagna evoca la vita rurale in montagna attraverso la ricostruzione di ambienti dell'habitat tradizionale e la presentazione di oggetti etnografici utilizzati in passato nella valle di Chamonix."
    ],
    "fr": [
      "Le musée montagnard évoque la vie rurale en montagne à travers la reconstitution des pièces de l'habitat traditionnel et la présentation d'objets ethnographiques utilisés autrefois dans la vallée de Chamonix."
    ],
    "nl": [
      "Het bergmuseum roept het plattelandsleven in de bergen op door de reconstructie van vertrekken uit de traditionele habitat en de presentatie van etnografische voorwerpen die vroeger in het dal van Chamonix werden gebruikt."
    ],
    "es": [
      "El museo de la montaña evoca la vida rural en la montaña a través de la reconstitución de salas del hábitat tradicional y la presentación de objetos etnográficos utilizados en el pasado en el valle de Chamonix."
    ]
  },
