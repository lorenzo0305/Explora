  "rdfs:comment": {
    "de": [
      "Tomme de l'Aillon ist ein Ziegenbetrieb, der Ziegenprodukte züchtet und verkauft, darunter Rohmilch-Vollmilchkäse und Zickleinfleisch. Der Familienbetrieb wurde 1996 von Emmanuel übernommen, die Käserei seit 2015."
    ],
    "en": [
      "Tomme de l'Aillon is a goat farm that raises and sells goat products including whole raw milk cheese and kid meat. The family farm was taken over by Emmanuel in 1996, and the cheese dairy since 2015."
    ],
    "it": [
      "Tomme de l'Aillon è un'azienda caprina che alleva e vende prodotti di capra, tra cui formaggio a latte crudo intero e carne di capretto. L'azienda familiare è stata rilevata da Emmanuel nel 1996 e il caseificio dal 2015."
    ],
    "fr": [
      "Tomme de l’Aillon est une exploitation caprine qui élève et vend des produits caprins dont le fromage au lait cru entier et de la viande de chevreau. L’exploitation familiale a été reprise par Emmanuel en 1996, et la fromagerie depuis 2015."
    ],
    "nl": [
      "Tomme de l'Aillon is een geitenboerderij die geitenproducten fokt en verkoopt, waaronder volle rauwmelkse kaas en geitenvlees. Het familiebedrijf werd in 1996 overgenomen door Emmanuel en de kaasmakerij sinds 2015."
    ],
    "es": [
      "Tomme de l'Aillon es una granja de cabras que cría y vende productos caprinos, como queso de leche cruda entera y carne de cabrito. Emmanuel se hizo cargo de la empresa familiar en 1996 y de la quesería en 2015."
    ]
  },
