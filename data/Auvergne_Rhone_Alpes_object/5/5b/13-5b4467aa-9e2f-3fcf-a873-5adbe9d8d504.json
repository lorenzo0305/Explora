  "rdfs:comment": {
    "de": [
      "Die Comédie de Valence, Centre dramatique national Drôme-Ardèche, ist ein lebendiger und gemeinsam genutzter Ort, der in jeder Saison von mehr als 40.000 Zuschauern besucht wird."
    ],
    "en": [
      "Over the course of some 200 performances each season in its three venues and some sixty decentralised venues, more than 40,000 spectators have made the Comédie de Valence, Centre dramatique national Drôme-Ardèche, a lively and shared venue."
    ],
    "it": [
      "Con circa 200 spettacoli a stagione nei suoi tre teatri e una sessantina di sedi decentrate, più di 40.000 spettatori fanno de La Comédie de Valence, Centre dramatique national Drôme-Ardèche, un luogo vivace e condiviso."
    ],
    "fr": [
      "Au fil des quelque 200 représentations données chaque saison dans ses trois salles et une soixantaine de lieux décentralisés, plus de 40.000 spectateurs font de La Comédie de Valence, Centre dramatique national Drôme-Ardèche, un lieu vif et partagé."
    ],
    "nl": [
      "Met ongeveer 200 voorstellingen per seizoen in de drie theaters en een zestigtal gedecentraliseerde zalen, maken meer dan 40.000 toeschouwers van de Comédie de Valence, Centre dramatique national Drôme-Ardèche, een levendige, gedeelde locatie."
    ],
    "es": [
      "Con unas 200 representaciones cada temporada en sus tres teatros y unas sesenta salas descentralizadas, más de 40.000 espectadores hacen de La Comédie de Valence, Centre dramatique national Drôme-Ardèche, un lugar vivo y compartido."
    ]
  },
