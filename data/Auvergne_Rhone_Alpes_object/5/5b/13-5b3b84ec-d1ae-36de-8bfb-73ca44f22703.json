  "rdfs:comment": {
    "de": [
      "In den Fußgängerzonen im Herzen der Altstadt von Valencia eine nette, entspannte und gesellige Atmosphäre, in der man sich bei einem guten Glas Wein, der vom Wirt empfohlen wird, oder einem Cocktail gut unterhalten kann."
    ],
    "en": [
      "In the pedestrian streets, in the heart of old Valence, you'll find a friendly, relaxed atmosphere where it's good to chat over a glass of wine recommended by the owner, or a cocktail."
    ],
    "it": [
      "Nelle vie pedonali, nel cuore della vecchia Valencia, un'atmosfera piacevole, rilassata e amichevole dove è bello chiacchierare davanti a un buon bicchiere di vino consigliato dal proprietario, o a un cocktail."
    ],
    "fr": [
      "Dans les rues piétonnes, au cœur de vieux Valence une ambiance sympa, détendue et conviviale où il fait bon discuter autour d’un bon verre de vin recommandé par le patron, ou d’un cocktail."
    ],
    "nl": [
      "In de autovrije straten in het hart van het oude Valence, een vriendelijke, ontspannen sfeer waar u kunt genieten van een goed gesprek onder het genot van een glas wijn aanbevolen door de eigenaar, of een cocktail."
    ],
    "es": [
      "En las calles peatonales, en el corazón de la vieja Valencia, un ambiente agradable, relajado y amigable donde es bueno charlar con una buena copa de vino recomendada por el propietario, o un cóctel."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Café La Bastille"
    ]
  },
