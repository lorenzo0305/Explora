  "rdfs:comment": {
    "de": [
      "Als Spezialisten für traditionelles Brot bieten wir Ihnen auch eine große Auswahl an Brot, Gebäck, Konditoreiwaren, Schokolade, Eis und Sandwiches. Wir bieten auch einen Cateringservice für alle Ihre Veranstaltungen an."
    ],
    "en": [
      "Specialists in traditional bread, we also offer a wide range of breads, pastries, chocolates, ice creams and sandwiches. We also offer a catering service for all your events."
    ],
    "it": [
      "Specializzati in pane tradizionale, offriamo anche una vasta gamma di pani, dolci, cioccolatini, gelati e panini. Offriamo anche un servizio di catering per tutti i vostri eventi."
    ],
    "fr": [
      "Spécialistes du pain tradition, nous mettons aussi à votre disposition un grand choix de pains, viennoiseries, pâtisseries, chocolats, glaces et sandwiches. Nous effectuons également un service traiteur pour tous vos évènements."
    ],
    "nl": [
      "Gespecialiseerd in ambachtelijk brood, bieden wij ook een breed scala aan brood, gebak, chocolade, ijs en broodjes. Wij verzorgen ook de catering voor al uw evenementen."
    ],
    "es": [
      "Especialistas en pan tradicional, también ofrecemos una amplia gama de panes, bollería, chocolates, helados y bocadillos. También ofrecemos un servicio de catering para todos sus eventos."
    ]
  },
