  "rdfs:comment": {
    "de": [
      "Schnitzeljagd, bestehend aus einem 5,5 km langen Spaziergang zur Entdeckung des Kulturerbes und der Geschichte der Gemeinde. Auf den Spuren von Inspektor Rando müssen die Kinder ein altersgerechtes Rätsel lösen."
    ],
    "en": [
      "A 5.5 km treasure hunt to discover the town's heritage and history. Following in the footsteps of Inspector Rando, children will have to solve an age-appropriate riddle."
    ],
    "it": [
      "Una caccia al tesoro che consiste in una passeggiata di 5,5 km alla scoperta del patrimonio e della storia della città. Seguendo le orme dell'ispettore Rando, i bambini dovranno risolvere un indovinello adatto alla loro età."
    ],
    "fr": [
      "Jeu de piste contitué d'une balade de 5,5 km à la découverte du patrimoine et de l'histoire de la commune. Sur les traces de l'inspecteur Rando, les enfants devront résoudre une énigme adaptée à leur âge."
    ],
    "es": [
      "Una búsqueda del tesoro consistente en un recorrido a pie de 5,5 km para descubrir el patrimonio y la historia de la ciudad. Siguiendo los pasos del inspector Rando, los niños tendrán que resolver un enigma adecuado a su edad."
    ],
    "nl": [
      "Een schattenjacht bestaande uit een wandeling van 5,5 km om het erfgoed en de geschiedenis van de stad te ontdekken. In de voetsporen van inspecteur Rando moeten kinderen een raadsel oplossen dat past bij hun leeftijd."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Circuit Randoland Duerne"
    ]
  },
