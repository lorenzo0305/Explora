  "rdfs:comment": {
    "de": [
      "Spa-Hotel im Tal von Chamonix mit Blick auf die Mont-Blanc-Kette, beheiztes Hallenbad, Sauna, Hammam.\r\n\r\nNeu: eine neue Kategorie mit nur einem Doppelzimmer und einem Queensize-Superior-Bett!"
    ],
    "en": [
      "Spa hotel in the Chamonix valley with views of the Mont Blanc range, indoor heated pool, sauna, hammam.\r\n\r\nNew: a new category of one double room with a superior queen-size bed!"
    ],
    "it": [
      "Hotel termale nella valle di Chamonix con vista sulla catena del Monte Bianco, piscina interna riscaldata, sauna, bagno turco.\r\n\r\nNovità: una nuova categoria di camera doppia con letto queen size superiore!"
    ],
    "fr": [
      "Hôtel Spa dans la vallée de Chamonix vue sur la chaine du Mont-Blanc, piscine couverte, chauffée, sauna, hammam.\n\nNouveauté: une nouvelle catégorie d'une seule chambre double avec un lit queen size supérieur !"
    ],
    "nl": [
      "Spahotel in de vallei van Chamonix met uitzicht op de Mont Blanc, verwarmd binnenzwembad, sauna, stoombad.\n\nNieuw: een nieuwe categorie van een tweepersoonskamer met een superieur queensize bed!"
    ],
    "es": [
      "Hotel balneario en el valle de Chamonix con vistas al macizo del Mont Blanc, piscina cubierta climatizada, sauna, baño turco.\r\n\r\nNovedad: ¡una nueva categoría de una habitación doble con cama de matrimonio superior!"
    ]
  },
  "rdfs:label": {
    "en": [
