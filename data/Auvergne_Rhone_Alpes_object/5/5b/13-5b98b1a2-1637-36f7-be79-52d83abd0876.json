  "rdfs:comment": {
    "de": [
      "Willkommen in Saint-Baudille-de-la-Tour, einem Dorf im Norden der Balcons du Dauphiné auf dem Plateau der Isle Crémieu. Entdecken Sie seine Kirche und den Espace Naturel Sensible du Luve!"
    ],
    "en": [
      "Welcome to Saint-Baudille-de-la-Tour, a village north of the Balcons du Dauphiné on the Isle Crémieu plateau. Come and discover its church and the Espace Naturel Sensible du Luve!"
    ],
    "it": [
      "Benvenuti a Saint-Baudille-de-la-Tour, un villaggio a nord dei Balcons du Dauphiné, sull'altopiano dell'Isle Crémieu. Venite a scoprire la sua chiesa e l'Espace Naturel Sensible du Luve!"
    ],
    "fr": [
      "Bienvenue à Saint-Baudille-de-la-Tour, village au nord des Balcons du Dauphiné sur le plateau de l'Isle Crémieu. Venez découvrir son église et son Espace Naturel Sensible du Luve !"
    ],
    "nl": [
      "Welkom in Saint-Baudille-de-la-Tour, een dorp in het noorden van de Balcons du Dauphiné op het plateau van Isle Crémieu. Kom en ontdek de kerk en het Espace Naturel Sensible du Luve!"
    ],
    "es": [
      "Bienvenido a Saint-Baudille-de-la-Tour, pueblo situado al norte de los Balcones del Dauphiné, en la meseta de la Isla Crémieu. ¡Venga a descubrir su iglesia y el Espace Naturel Sensible du Luve!"
    ]
  },
