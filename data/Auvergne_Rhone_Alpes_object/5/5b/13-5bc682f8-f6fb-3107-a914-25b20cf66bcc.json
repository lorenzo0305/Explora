  "rdfs:comment": {
    "de": [
      "Verkauf von frischen und konservierten Trüffeln, Trüffelpflanzen, Trüffelöl, Büchern über Trüffel und anderen Produkten. Besuch der Trüffelfelder mit Hunden (Vorführung der Höhlenforschung) + mögliche Verkostung von Trüffel-Carpaccio, nur nach vorheriger Anmeldung."
    ],
    "en": [
      "Sale of fresh and preserved truffles, local products made with truffles (oil...), books about truffles...\r\nGuided tour of the truffle domain: walk among oak trees, \"cavage\" demonstration (how dogs look for truffles by sniffing the soil),  truffle carpaccio tasting, reservation required (6€/pers)."
    ],
    "it": [
      "Vendita di tartufi freschi e conservati, piante da tartufo, olio al tartufo, libri sul tartufo e altri prodotti. Visita delle tartufaie con i cani (dimostrazione di cavage) + eventuale degustazione di carpaccio di tartufo, solo su prenotazione."
    ],
    "fr": [
      "Vente de truffes fraîches et en conserve, plants truffiers , huile truffée, livres sur la truffe et autres produits. Visite des truffières avec les chiens (démonstration de cavage) + dégustation possible de carpaccio de truffe, uniquement sur RV."
    ],
    "nl": [
      "Verkoop van truffels, vers en in blik, truffelplanten, truffelolie, boeken over truffel en andere producten. Bezoek aan de truffelvelden met honden (demonstratie van truffel zoeken met de honden) en proeverij van truffelcarpaccio (€ 6,- per persoon), alleen op afspraak."
    ],
    "es": [
      "Venta de trufas frescas y en conserva, plantas truferas, aceite de trufa, libros sobre trufas y otros productos. Visita de los campos de trufa con los perros (demostración de cavage) + posible degustación de carpaccio de trufa, sólo con cita previa."
    ]
  },
