  "rdfs:comment": {
    "de": [
      "Pferderennen in Jullianges!\r\nBesuchen Sie die drei jährlichen Trabrennen auf der höchstgelegenen Rennbahn Europas im Herzen des Zentralmassivs in der Haute-Loire!"
    ],
    "en": [
      "Jullianges horse races!\r\nCome and enjoy three trotting race meetings a year on Europe's highest racecourse, in the heart of the Massif Central, in Haute-Loire!"
    ],
    "it": [
      "Le corse dei cavalli di Jullianges!\r\nVenite ad assistere alle tre corse al trotto che si svolgono ogni anno sull'ippodromo più alto d'Europa, nel cuore del Massiccio Centrale, nell'Alta Loira!"
    ],
    "fr": [
      "Courses hippiques de Jullianges !\r\nVenez assister aux trois réunion de courses de trot annuelles sur le plus haut hippodrome d'Europe, au cœur du Massif Central, en Haute-Loire !"
    ],
    "nl": [
      "Jullianges paardenraces!\r\nKom kijken naar de drie draverijen die elk jaar worden gehouden op de hoogste renbaan van Europa, in het hart van het Centraal Massief, in de Haute-Loire!"
    ],
    "es": [
      "Carreras de caballos de Jullianges\r\nVenga a ver las tres carreras de trote que se celebran cada año en el hipódromo más alto de Europa, en el corazón del Macizo Central, en el Alto Loira"
    ]
  },
  "rdfs:label": {
    "fr": [
