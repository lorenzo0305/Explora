  "rdfs:comment": {
    "de": [
      "Lassen Sie sich in einem raffinierten und herzlichen Ambiente von Gerichten verführen, die den Reichtum unserer Region zur Geltung bringen, und genießen Sie ein einzigartiges kulinarisches Erlebnis."
    ],
    "en": [
      "In a refined and warm atmosphere, let yourself be tempted by dishes that highlight the richness of our terroir for a unique culinary experience."
    ],
    "it": [
      "In un'atmosfera raffinata e calda, lasciatevi tentare da piatti che esaltano la ricchezza del nostro terroir per un'esperienza culinaria unica."
    ],
    "fr": [
      "Dans une ambiance raffinée et chaleureuse, laissez-vous tenter par des plats qui mettent en valeur la richesse de notre terroir pour une expérience culinaire unique."
    ],
    "nl": [
      "Laat je in een verfijnde en warme sfeer verleiden door gerechten die de rijkdom van ons terroir benadrukken voor een unieke culinaire ervaring."
    ],
    "es": [
      "En un ambiente refinado y cálido, déjese tentar por platos que ponen de relieve la riqueza de nuestro terruño para vivir una experiencia culinaria única."
    ]
  },
  "rdfs:label": {
