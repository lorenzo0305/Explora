  "rdfs:comment": {
    "de": [
      "Eine regionale Küche in den Farben und mit den Gewürzen und Aromen aus unseren Wäldern."
    ],
    "en": [
      "Local cuisine with the tastes and colours of our mountain forests."
    ],
    "it": [
      "Scoprite il nostro ristorante, classificato come Restaurant Gourmand dal Logis Hôtel. Siete alla ricerca di un buon pasto? Vi piace una cucina autentica, genuina e generosa che valorizzi i prodotti locali? Benvenuti nel nostro ristorante del Vercors!"
    ],
    "fr": [
      "Découvrez notre table, classée Restaurant Gourmand aux Logis Hôtel. Vous recherchez une bonne table ? Vous aimez la cuisine, authentique, vraie, généreuse, qui met en valeur les produits du terroir ? Bienvenue chez nous, une bonne table du Vercors !"
    ],
    "nl": [
      "Ontdek ons restaurant, geklasseerd als Restaurant Gourmand door het Logis Hôtel. Bent u op zoek naar een goede maaltijd? Houdt u van een authentieke, eerlijke en gulle keuken die optimaal gebruik maakt van lokale producten? Welkom in ons restaurant in de Vercors!"
    ],
    "es": [
      "Descubra nuestro restaurante, clasificado como Restaurante Gourmand por el Logis Hôtel. ¿Le apetece comer bien? ¿Le gusta la cocina auténtica, genuina, generosa y que aprovecha al máximo los productos locales? Bienvenido a nuestro restaurante de Vercors"
    ]
  },
