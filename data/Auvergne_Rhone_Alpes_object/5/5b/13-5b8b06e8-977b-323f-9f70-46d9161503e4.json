  "rdfs:comment": {
    "de": [
      "Laden für lokale Bauernprodukte. Produkte aus dem In- und Ausland: Geflügel, Fleisch, Fisch, Safran, Fruchtsäfte, Olivenöl, Oliven, Tapenaden, Käse, Gemüse, Obst, Wein, Bier, Marmelade, Gewürzbrot, Schokolade..."
    ],
    "en": [
      "Shop for local farm products. Products from here and elsewhere: Poultry, meat, fish, saffron, fruit juice, olive oil, olives, tapenades, cheeses, vegetables, fruits, wines, beer, jams, pain d'épices, chocolates and more."
    ],
    "it": [
      "Spaccio aziendale: cortocircuito da vari produttori all'acquirente.\r\nOgni mercoledì: pane e dolci cotti sul fuoco a legna dalle 07:30!"
    ],
    "fr": [
      "Magasin de produits fermiers : circuit court de producteurs divers à l'acheteur.\r\nTous les mercredis : cuisson pains et viennoiseries au feu de bois dès 07h30 !"
    ],
    "nl": [
      "Winkel met lokale boerderijproducten. Producten van hier en elders: gevogelte, vlees, vis, saffraan, vruchtensappen, olijfolie, olijven, tapenade, kazen, groenten, fruit, wijnen, bier, jam, ontbijtkoek, chocolade..."
    ],
    "es": [
      "Granja tienda: circuito corto de varios productores al comprador.\r\nTodos los miércoles: ¡pan y bollería al horno de leña a partir de las 07:30!"
    ]
  },
