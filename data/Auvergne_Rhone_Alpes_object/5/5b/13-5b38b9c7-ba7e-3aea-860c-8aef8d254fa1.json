  "rdfs:comment": {
    "de": [
      "Drei Fahrzeuge stehen den Bewohnern und Besuchern des Vercors Drômois zur Verfügung\r\nEs können reserviert werden: 2 Zoé und 9-Sitzer-Kleinbus.\r\nDiese Fahrzeuge stehen von La Chapelle en Vercors oder Saint Martin en Vercors aus zur Verfügung."
    ],
    "en": [
      "Three vehicles are available to Vercors Drômois residents and visitors\r\nIt is possible to reserve: 2 Zoé and a 9-seater minibus.\r\nThese vehicles are available from La Chapelle en Vercors or Saint Martin en Vercors."
    ],
    "it": [
      "Tre veicoli sono a disposizione dei residenti e dei visitatori del Vercors Drômois\r\nÈ possibile prenotare: 2 Zoé e un minibus a 9 posti.\r\nQuesti veicoli sono disponibili presso La Chapelle en Vercors o Saint Martin en Vercors."
    ],
    "fr": [
      "Trois véhicules sont à disposition des habitants et visiteurs du Vercors Drômois\r\nIl est possible de réserver : 2 Zoé et minibus 9 places.\r\nCes véhicules sont disponibles au départ de La Chapelle en Vercors ou de Saint Martin en Vercors."
    ],
    "es": [
      "Tres vehículos están a disposición de los residentes y visitantes del Vercors Drômois\r\nEs posible reservar: 2 Zoé y un minibús de 9 plazas.\r\nEstos vehículos están disponibles en La Chapelle en Vercors o en Saint Martin en Vercors."
    ],
    "nl": [
      "Er zijn drie voertuigen beschikbaar voor bewoners en bezoekers van de Vercors Drômois\r\nHet is mogelijk om te reserveren: 2 Zoé en een 9-persoons minibus.\r\nDeze voertuigen zijn beschikbaar vanuit La Chapelle en Vercors of Saint Martin en Vercors."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Vercors Soleil : voitures et mini bus en auto partage"
    ]
  },
