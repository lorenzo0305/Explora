  "rdfs:comment": {
    "de": [
      "Unser Ziel ist es, Menschen, die über freie Zeit verfügen, Aktivitäten und Unterricht in verschiedenen Bereichen wie Geisteswissenschaften, moderne Sprachen, Kunst oder Naturwissenschaften anzubieten."
    ],
    "en": [
      "Our aim is to offer people with free time activities and teaching in a variety of fields, such as humanities, modern languages, arts and sciences."
    ],
    "it": [
      "Il nostro obiettivo è quello di offrire alle persone con tempo libero attività e insegnamenti in diversi campi, come le discipline umanistiche, le lingue moderne, le arti e le scienze."
    ],
    "fr": [
      "Notre objectif est d'offrir aux personnes qui disposent de temps libre des activités et des enseignements dans divers domaines tels que les Sciences Humaines, les langues vivantes, les Arts ou les Sciences."
    ],
    "nl": [
      "Ons doel is om mensen met vrije tijd activiteiten en onderwijs te bieden op verschillende gebieden, zoals menswetenschappen, moderne talen, kunsten en wetenschappen."
    ],
    "es": [
      "Nuestro objetivo es ofrecer a las personas con tiempo libre actividades y enseñanza en diversos campos, como las Humanidades, las lenguas modernas, las Artes y las Ciencias."
    ]
  },
