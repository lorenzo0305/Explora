  "rdfs:comment": {
    "de": [
      "Im Rahmen der Comédie itinérante. Dieses Duo aus einer virtuosen Pianistin und einem Geigenvirtuosen ist eine Mischung aus Musiktheater und Animationskonzert und nimmt Neulinge wie Musikliebhaber mit auf eine ebenso spielerische wie unerwartete Klangreise."
    ],
    "en": [
      "As part of the Comédie itinérante tour. Halfway between musical theater and animated concert, this complicit duo between a virtuoso pianist and violinist-artist takes novices and music lovers alike on a journey of sound as playful as it is unexpected."
    ],
    "it": [
      "Nell'ambito della Comédie itinérante. A metà strada tra il teatro musicale e il concerto d'animazione, questo duetto complice tra un pianista virtuoso e un violinista-altista accompagna i neofiti e gli amanti della musica in un viaggio sonoro tanto giocoso quanto inaspettato."
    ],
    "fr": [
      "Dans le cadre de la Comédie itinérante. À mi-chemin entre théâtre musical et concert animé, ce duo complice entre une pianiste et un violoniste-altiste virtuoses embarque néophytes comme mélomanes dans un voyage sonore aussi ludique qu’inattendu."
    ],
    "es": [
      "En el marco de la Comédie itinérante. A medio camino entre el teatro musical y el concierto de animación, este dúo cómplice entre un pianista virtuoso y un violinista-artista lleva a novatos y melómanos por igual a un viaje sonoro tan lúdico como inesperado."
    ],
    "nl": [
      "Als onderdeel van de Comédie itinérante. Dit medeplichtige duet tussen een virtuoze pianist en violist-altist houdt het midden tussen muziektheater en een geanimeerd concert en neemt zowel beginners als muziekliefhebbers mee op een even speelse als onverwachte klankreis."
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'abécedaire musical"
    ]
  },
