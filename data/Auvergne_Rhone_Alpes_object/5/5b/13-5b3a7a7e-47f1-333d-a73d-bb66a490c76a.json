  "rdfs:comment": {
    "de": [
      "In unserem Büro, das sich in der Nähe des Naturschutzgebiets La Jarjatte befindet, steht Ihnen Informationsmaterial aus den Regionen Pays Diois, Trièves und Buëch zur Verfügung. Vor Ort: kostenloses Wifi Cigale, Shop."
    ],
    "en": [
      "Our office, located near the La Jarjatte conservation area, offers documentation on the Diois, Trièves and Buëch regions. On-site: free Wifi Cigale, store."
    ],
    "it": [
      "Il nostro ufficio, situato vicino al sito classificato di La Jarjatte, fornisce documentazione sulle regioni di Diois, Trièves e Buëch. In loco: Wifi gratuito Cigale, negozio."
    ],
    "fr": [
      "Notre bureau, situé à proximité du site classé de La Jarjatte, met à disposition de la documentation du Pays Diois, du Trièves et du Buëch. Sur place : Wifi Cigale gratuit, boutique."
    ],
    "nl": [
      "Ons kantoor, vlakbij de geklasseerde site van La Jarjatte, biedt documentatie over de regio's Diois, Trièves en Buëch. Ter plaatse: gratis Cigale WiFi, winkel."
    ],
    "es": [
      "Nuestra oficina, situada cerca del sitio catalogado de La Jarjatte, ofrece documentación de las regiones de Diois, Trièves y Buëch. En el lugar: Wifi Cigale gratuito, tienda."
    ]
  },
