  "rdfs:comment": {
    "de": [
      "Im Stade Pompidou findet das 15. Spiel der Saison zwischen den Mannschaften von Valence und Provence statt. Die beiden Vereine mit ihren jeweiligen Geschichten und Leidenschaften bereiten sich darauf vor, ein energiegeladenes und spannendes Spektakel zu bieten."
    ],
    "en": [
      "The Stade Pompidou will play host to the 15th match of the season between the Valence and Provence teams. The two clubs, with their respective histories and passions, are preparing to put on a show full of energy and suspense."
    ],
    "it": [
      "Lo Stade Pompidou ospiterà la 15ª partita della stagione tra le squadre di Valencia e Provenza. I due club, con le rispettive storie e passioni, si preparano a dare vita a uno spettacolo pieno di energia e suspense."
    ],
    "fr": [
      "Le stade Pompidou accueillera le 15ème match de la saison entre les équipes de Valence et Provence. Les deux clubs, avec leurs histoires et leurs passions respectives, se préparent à offrir un spectacle plein d'énergie et de suspense."
    ],
    "nl": [
      "In het Stade Pompidou vindt de 15e wedstrijd van het seizoen plaats tussen de teams van Valencia en de Provence. De twee clubs, met hun respectievelijke geschiedenis en passies, bereiden zich voor op een show vol energie en spanning."
    ],
    "es": [
      "El Stade Pompidou acogerá el 15º partido de la temporada entre los equipos de Valencia y Provenza. Los dos clubes, con sus respectivas historias y pasiones, se preparan para ofrecer un espectáculo lleno de energía y suspense."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Match VRDR vs Provence"
    ]
  },
