  "rdfs:comment": {
    "de": [
      "Die Société Publique Locale \"Parrachée Vanoise\" ist für den Betrieb der alpinen und Langlaufskigebiete, des Campingplatzes La Buidonnière, der Sportanlagen und Freizeitbasen, des Zentrums Schwimmbad/Spa ô'Soi und der Chalets de la Pyramide zuständig."
    ],
    "en": [
      "The Société Publique Locale \"Parrachée Vanoise\" is responsible for running the downhill and cross-country ski areas, the La Buidonnière campsite, sports facilities and leisure center, the ô'Soi pool/spa center and the Chalets de la Pyramide."
    ],
    "it": [
      "La Société Publique Locale \"Parrachée Vanoise\" è responsabile della gestione dei comprensori sciistici di discesa e di fondo, del campeggio La Buidonnière, degli impianti sportivi e del centro ricreativo, della piscina/spa ô'Soi e degli Chalets de la Pyramide."
    ],
    "fr": [
      "La Société Publique Locale \"Parrachée Vanoise\" est en charge de l'exploitation des domaines skiables alpin et fond, du camping La Buidonnière, des équipements sportifs et base de loisirs, centre piscine/spa ô'Soi et des Chalets de la Pyramide."
    ],
    "es": [
      "La Société Publique Locale \"Parrachée Vanoise\" es responsable de la gestión de las zonas de esquí alpino y de fondo, del camping La Buidonnière, de las instalaciones deportivas y del centro de ocio, de la piscina/balneario ô'Soi y de los Chalets de la Pyramide."
    ],
    "nl": [
      "De Société Publique Locale \"Parrachée Vanoise\" is verantwoordelijk voor het beheer van de ski- en langlaufgebieden, de camping La Buidonnière, de sportfaciliteiten en het recreatiecentrum, het zwembad/spa-centrum ô'Soi en de Chalets de la Pyramide."
    ]
  },
