  "rdfs:comment": {
    "de": [
      "Le Bufadou ist das erste sportliche Basislager im Mittelgebirge.\r\nEs liegt im Herzen des Skigebiets, am Anfang der Skipisten. Wir bieten Ihnen 7 Zimmer für 2 bis 6 Personen. Reservierung direkt online."
    ],
    "en": [
      "BUFADOU is the first mid-mountain sports base camp.\r\nIn the heart of the resort, at the start of the ski slopes. We offer 7 rooms for 2 to 6 people and open all season long, bookable directly online."
    ],
    "it": [
      "Le Bufadou è il primo campo base per gli sport di media montagna.\r\nNel cuore della stazione, all'inizio delle piste da sci. Offriamo 7 camere da 2 a 6 persone. Prenotate direttamente online."
    ],
    "fr": [
      "Le Bufadou est le premier Camp de Base sportif de moyenne montagne.\r\nAu cœur de la station, au départ des pistes de ski. Nous vous proposons 7 ch de 2 à 6 pers. Réservation directement en ligne."
    ],
    "nl": [
      "Le Bufadou is het eerste sportieve basiskamp in het middengebergte.\r\nIn het hart van het skigebied, aan het begin van de pistes. We bieden 7 kamers voor 2 tot 6 personen. Boek direct online."
    ],
    "es": [
      "Le Bufadou es el primer campamento base deportivo de media montaña.\r\nEn el corazón de la estación, al comienzo de las pistas de esquí. Ofrecemos 7 habitaciones para 2 a 6 personas. Reserve directamente en línea."
    ]
  },
