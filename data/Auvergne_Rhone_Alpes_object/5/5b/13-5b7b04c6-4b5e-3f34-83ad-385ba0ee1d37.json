  "rdfs:comment": {
    "de": [
      "\"Dessine moi une Brebis\" ist ein ganzes Team, das eine ganze Reihe von Schafskäsen und -joghurts, Lamm-, Broutard- und Schweinefleisch herstellt und verarbeitet."
    ],
    "en": [
      "\"Dessine moi une Brebis\" is an entire team that produces and processes a full range of ewe's milk cheeses and yogurts, as well as lamb, mutton and pigmeat."
    ],
    "it": [
      "dessine moi une Brebis? è un team che produce e trasforma un'intera gamma di formaggi e yogurt di latte di pecora, oltre a carni di agnello, montone e maiale."
    ],
    "fr": [
      "“Dessine moi une Brebis” c’est tout une équipe qui produit et transforme une gamme entière de fromages et yaourts de brebis, de viande d’agnelet, de broutard et de cochon."
    ],
    "es": [
      "dessine moi une Brebis? es un equipo que produce y transforma toda una gama de quesos y yogures de leche de oveja, así como carne de cordero, carnero y cerdo."
    ],
    "nl": [
      "\"Dessine moi une Brebis\" is een team dat een hele reeks kazen en yoghurts van schapenmelk produceert en verwerkt, evenals lams-, schapen- en varkensvlees."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ferme Dessine-moi une Brebis - Maison Dicina"
    ]
  },
