      "dc:description": {
        "de": [
          "Friseursalon, Barbier.\n\nÖffnungszeiten:\n- dienstag, Mittwoch, Freitag von 09:00 bis 19:00 Uhr.\n- donnerstag von 09:00 bis 20:00 Uhr.\n- samstag von 09:00 bis 18:00 Uhr."
        ],
        "en": [
          "Hair salon, barber.\n\nOpening hours:\n- tuesday, Wednesday, Friday 09:00 to 19:00.\n- thursday 09h00 to 20h00.\n- saturday 09h00 to 18h00."
        ],
        "it": [
          "Parrucchiere e barbiere.\n\nOrari di apertura:\n- martedì, mercoledì e venerdì dalle 09:00 alle 19:00.\n- giovedì dalle 09:00 alle 20:00.\n- sabato dalle 09:00 alle 18:00."
        ],
        "fr": [
          "Salon de coiffure, barbier.\n\nHoraires : \n- mardi, mercredi, vendredi de 09h00 à 19h00.\n- jeudi de 09h00 à 20h00.\n- samedi de 09h00 à 18h00."
        ],
        "es": [
          "Peluquería y barbería.\n\nHorario de apertura:\n- martes, miércoles y viernes de 09:00 a 19:00.\n- jueves de 09:00 a 20:00.\n- sábado de 09:00 a 18:00."
        ],
        "nl": [
          "Kapper en barbier.\n\nOpeningstijden:\n- dinsdag, woensdag, vrijdag van 09:00 tot 19:00 uur.\n- donderdag van 09.00 tot 20.00 uur.\n- zaterdag van 09:00 tot 18:00 uur."
        ]
