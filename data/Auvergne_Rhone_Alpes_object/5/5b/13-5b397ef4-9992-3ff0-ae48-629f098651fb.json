  "rdfs:comment": {
    "de": [
      "Lémouv Club Evian ist ein unabhängiges Fitnessstudio, das zahlreiche Fitness- und Kraftdisziplinen umfasst. Das Hotel liegt am Eingang der Stadt in einem außergewöhnlichen Gebäude und bietet hochwertige Geräte, die in Frankreich hergestellt werden."
    ],
    "en": [
      "Lémouv Club Evian is an independent gym that includes many disciplines of fitness and bodybuilding. Located at the entrance of the city in an exceptional building, it offers high-end equipment made in France."
    ],
    "it": [
      "Il Lémouv Club Evian è una palestra indipendente che offre un'ampia gamma di discipline di fitness e body-building. Situata all'ingresso della città in un edificio eccezionale, offre attrezzature di alta gamma prodotte in Francia."
    ],
    "fr": [
      "Lémouv Club Evian est une salle de sport indépendante qui regroupe de nombreuses disciplines du fitness et de la musculation. Située à l'entrée de la ville dans un bâtiment d'exception, elle propose des équipements haut de gamme fabriqués en France."
    ],
    "nl": [
      "Lémouv Club Evian is een onafhankelijke sportschool met een breed aanbod aan fitness- en bodybuildingslessen. Het is gevestigd bij de ingang van de stad in een uitzonderlijk gebouw en biedt de beste apparatuur van Franse makelij."
    ],
    "es": [
      "El Lémouv Club Evian es un gimnasio independiente que ofrece una amplia gama de disciplinas de fitness y musculación. Situado a la entrada de la ciudad en un edificio excepcional, ofrece equipos de alta gama fabricados en Francia."
    ]
  },
