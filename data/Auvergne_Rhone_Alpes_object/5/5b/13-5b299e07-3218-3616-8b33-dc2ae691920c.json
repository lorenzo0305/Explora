  "rdfs:comment": {
    "de": [
      "Unser Team befindet sich im Herzen von Saint Hugues und serviert Ihnen Gerichte aus den Bergen, Burger und hausgemachte Salate. Alle Gerichte werden mit lokalen Produkten zubereitet. Wir sind sowohl im Sommer als auch im Winter geöffnet und begrüßen Sie gerne zu Themenabenden."
    ],
    "en": [
      "Located in the heart of Saint Hugues, our team is here to serve you mountain dishes, burgers and home-made salads. All dishes are made with local products.\r\nOpen summer and winter, we welcome you for thematic evenings."
    ],
    "it": [
      "Situato nel cuore di Saint Hugues, il nostro team è qui per servirvi piatti di montagna, hamburger e insalate fatte in casa. Tutti i piatti sono preparati con prodotti locali. Aperto in estate e in inverno, vi accoglie per serate a tema."
    ],
    "fr": [
      "Situé au cœur de Saint Hugues, notre équipe est là pour vous servir des plats montagnards, des burgers et salades maison. Tous les plats sont préparés à base de produits locaux. Ouvert été comme hiver, nous vous accueillons pour des soirées thématiques."
    ],
    "es": [
      "Situado en el corazón de Saint Hugues, nuestro equipo está aquí para servirle platos de montaña, hamburguesas y ensaladas caseras. Todos los platos se preparan con productos locales. Abierto en verano e invierno, le damos la bienvenida para veladas temáticas."
    ],
    "nl": [
      "Gelegen in het hart van Saint Hugues, staat ons team klaar om u berggerechten, hamburgers en huisgemaakte salades te serveren. Alle gerechten worden bereid met lokale producten. Open in zomer en winter, verwelkomen wij u voor thema-avonden."
    ]
  },
