  "rdfs:comment": {
    "de": [
      "Name der Einwohner: Panissiérois. Panissières liegt an einem alten Weg, der zwei Provinzen miteinander verband: Forez und Beaujolais. Der alte, eingemauerte Marktflecken hat sich im Laufe der Jahrhunderte in eine moderne Stadt mit vielen Dienstleistungen verwandelt."
    ],
    "en": [
      "Name of the inhabitants : Panissieres. Panissières is located on an ancient road that linked two provinces: Forez and Beaujolais. The old walled town has been transformed over the centuries into a modern city with many services."
    ],
    "it": [
      "Nome degli abitanti: Panissieres. Panissières si trova su un'antica strada che collegava due province: Forez e Beaujolais. L'antica città murata è stata trasformata nel corso dei secoli in una città moderna con molti servizi."
    ],
    "fr": [
      "Nom des habitants : les Panissiérois. Panissières se trouvent sur un ancien chemin qui reliait deux provinces : Forez et Beaujolais. Le vieux bourg emmuré, s'est transformé au cours des siècles en une cité moderne avec de nombreux services."
    ],
    "es": [
      "Nombre de los habitantes: Panissieres. Panissières se encuentra en una antigua carretera que unía dos provincias: Forez y Beaujolais. La antigua ciudad amurallada se ha transformado a lo largo de los siglos en una ciudad moderna con numerosos servicios."
    ],
    "nl": [
      "Naam van de inwoners: Panissieres. Panissières ligt aan een oude weg die twee provincies met elkaar verbond: de Forez en de Beaujolais. De oude ommuurde stad is in de loop der eeuwen omgevormd tot een moderne stad met veel voorzieningen."
    ]
  },
