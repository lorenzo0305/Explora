  "rdfs:comment": {
    "de": [
      "Madame, früher Madame Moustache, Pseudonym von Aurélie Ludivine Bidault, ist eine visuelle Künstlerin, Street Artist und Collagekünstlerin aus Tours. Das 2024 entstandene Wandgemälde befindet sich unter der Veranda des Rathauses."
    ],
    "en": [
      "Madame, formerly Madame Moustache, pseudonym of Aurélie Ludivine Bidault, is a visual artist, street artist and collagist from Tours. This fresco, created in 2024, is located under the porch of the Town Hall."
    ],
    "it": [
      "Madame, già Madame Moustache, pseudonimo di Aurélie Ludivine Bidault, è un'artista visiva, street artist e collagista di Tours. Questo affresco, realizzato nel 2024, si trova sotto il portico del Municipio."
    ],
    "fr": [
      "Madame, anciennement Madame Moustache, pseudonyme d'Aurélie Ludivine Bidault, est une artiste visuelle, street artiste et collagiste originaire de Tours. Cette fresque, réalisée en 2024, est située sous le porche de la Mairie."
    ],
    "nl": [
      "Madame, voorheen Madame Moustache, pseudoniem van Aurélie Ludivine Bidault, is beeldend kunstenaar, straatkunstenaar en collagist uit Tours. Dit fresco, gemaakt in 2024, bevindt zich onder de portiek van het stadhuis."
    ],
    "es": [
      "Madame, antes Madame Moustache, seudónimo de Aurélie Ludivine Bidault, es una artista visual, artista callejera y collagista de Tours. Este fresco, creado en 2024, se encuentra bajo el pórtico del Ayuntamiento."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Fresques et murs peints - Nuances d'espoir de Madame"
    ]
  },
