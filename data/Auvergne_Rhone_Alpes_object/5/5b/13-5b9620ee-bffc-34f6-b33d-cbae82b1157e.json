  "rdfs:comment": {
    "de": [
      "Die Verbindungsspur wird von Fußgängern gemeinsam genutzt. Die Loipe ist daher nicht für Langlaufski gesperrt. Sie ermöglicht es jedoch, eine Verbindung zwischen zwei Langlaufrouten herzustellen, ohne die Schuhe abzuschnallen."
    ],
    "en": [
      "The connecting trails are shared by pedestrians. The trail is not groomed for cross-country skiing. However, it can be used to link 2 cross-country ski routes without taking off your shoes."
    ],
    "it": [
      "I sentieri di collegamento sono condivisi dai pedoni. La pista non è preparata per lo sci di fondo. Tuttavia, può essere utilizzata per collegare 2 percorsi di sci di fondo senza togliersi le scarpe."
    ],
    "fr": [
      "Les pistes de liaison sont communes aux piétons. La piste n'est donc pas dammée pour le ski de fond. Elle permet néanmoins de faire la liaison entre 2 itinéraires de ski de fond sans déchausser."
    ],
    "es": [
      "Los senderos de conexión son compartidos por peatones. La pista no está preparada para el esquí de fondo. Sin embargo, puede utilizarse para enlazar 2 rutas de esquí de fondo sin descalzarse."
    ],
    "nl": [
      "De verbindingspaden worden gedeeld door voetgangers. De loipe is niet geprepareerd voor langlaufen. Je kunt er echter wel 2 langlaufroutes mee verbinden zonder je schoenen uit te trekken."
    ]
  },
  "rdfs:label": {
    "en": [
      "Samoëns/Sixt-Fer-à-Cheval connecting trail"
    ],
    "fr": [
      "Piste de liaison Samoëns/Sixt-Fer-à-Cheval"
    ],
    "nl": [
      "Samoëns/Sixt-Fer-à-Cheval link track"
    ]
  },
