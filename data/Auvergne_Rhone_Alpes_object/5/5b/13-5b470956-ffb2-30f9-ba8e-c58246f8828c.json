  "rdfs:comment": {
    "de": [
      "Nach siebenjähriger Renovierung wurde das Schloss im Jahr 2024 zu einem Zentrum für zeitgenössische Kunst und Kulturerbe. Dieser prestigeträchtige Ort in Südfrankreich lädt Sie dazu ein, seine restaurierten Räume durch Ausstellungen, Besichtigungen, Workshops und Veranstaltungen zu entdecken."
    ],
    "en": [
      "After seven years of renovation, Le Château became a Centre for Contemporary Art and Heritage in 2024. This prestigious site in the south of France invites you to discover its restored spaces through exhibitions, tours, workshops and events."
    ],
    "it": [
      "Dopo sette anni di restauro, Le Château è diventato un Centro d'Arte Contemporanea e del Patrimonio nel 2024. Questo prestigioso sito nel sud della Francia vi invita a scoprire i suoi spazi restaurati attraverso mostre, visite, laboratori ed eventi."
    ],
    "fr": [
      "Après sept ans de rénovation, Le Château est devenu en 2024 un Centre d'Art Contemporain et du Patrimoine. Ce site prestigieux du sud de la France vous invite à découvrir ses espaces restaurés à travers des expositions, visites, ateliers et événements."
    ],
    "es": [
      "Tras siete años de renovación, Le Château se convierte en Centro de Arte Contemporáneo y Patrimonio en 2024. Este prestigioso lugar del sur de Francia le invita a descubrir sus espacios restaurados a través de exposiciones, visitas, talleres y eventos."
    ],
    "nl": [
      "Na zeven jaar renovatie werd Le Château in 2024 een Centrum voor Hedendaagse Kunst en Erfgoed. Deze prestigieuze locatie in het zuiden van Frankrijk nodigt je uit om de gerestaureerde ruimtes te ontdekken via tentoonstellingen, rondleidingen, workshops en evenementen."
    ]
  },
