  "rdfs:comment": {
    "de": [
      "3 ha großer Wasserplan, der von der AAPPMA de la Châtaigneraie verwaltet wird.\r\nAngeln (1. Kategorie = Weißfische): Angelschein erforderlich, erhältlich unter www.cartedepeche.fr oder :"
    ],
    "en": [
      "Fishing activity (1st category = whitefish): Fishing license required: Daily (€14), weekly (€36.50) or yearly permits (€87) on sale at www.cartedepeche.fr or from the above stockists.\r\nFishing is permitted all year round. \r\n3 ha pond. No catch limit."
    ],
    "it": [
      "Lago di 3 ettari gestito dall'AAPPMA de la Châtaigneraie.\r\nPesca (1a categoria = pesce bianco): è richiesta la licenza di pesca, in vendita su www.cartedepeche.fr o :"
    ],
    "fr": [
      "Plan d'eau de 3 ha géré par l'AAPPMA de la Châtaigneraie. \r\nActivité pêche (1e catégorie = poissons blancs) : permis de pêche nécessaire, en vente sur www.cartedepeche.fr ou :"
    ],
    "nl": [
      "Visserijactiviteit (1ste categorie = witvis): Visvergunning vereist: Dagelijkse (€ 14), wekelijkse (€ 36,50) of jaarlijkse pas (€ 87) verkrijgbaar op www.cartedepeche.fr of bij de bovenstaande verkooppunten.\r\nVissen is het hele jaar door toegestaan. \r\nMeer van 3 ha. Geen vangstbeperkingen."
    ],
    "es": [
      "Lago de 3 ha gestionado por la AAPPMA de la Châtaigneraie.\r\nPesca (1ª categoría = pescado blanco): se requiere licencia de pesca, a la venta en www.cartedepeche.fr o :"
    ]
  },
