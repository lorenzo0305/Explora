  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/b6f2f387-b35b-3629-bba5-22ca0c9a8359",
      "dc:description": {
        "de": [
          "3000 m² großer Teich, der für Angler geeignet ist\nleidenschaftliche Angler. Sie werden dort eine Forelle necken\nrosa, die vor Ort gezüchtet wird. 5 private Golfplätze\nzusätzliche. Angelrute kann ausgeliehen werden\nangeln. Bar und Restaurant vor Ort."
        ],
        "en": [
          "3,000 m² pond, suitable for anglers\nanglers. Here, they can tease a pink trout\nraised on site. 5 private courses\navailable. Fishing rods available\nfishing rods. Bar and restaurant on site."
        ],
        "it": [
          "Laghetto di 3.000 m², adatto ai pescatori\npescatori. Qui è possibile stuzzicare una trota rosa\nallevati in loco. 5 corsi privati\ndisponibili. Canne da pesca disponibili\ncanne da pesca. Bar e ristorante in loco."
        ],
        "fr": [
          "Étang de 3 000 m², adapté aux pêcheurs\npassionnés. Ils y taquineront une truite\nrose, élevée sur place. 5 parcours privés\nsupplémentaires. Prêt possible de canne à\npêche. Bar et restauration sur place."
        ],
        "nl": [
          "Vijver van 3.000 m², geschikt voor vissers\nvissers. Hier kun je een roze forel\nter plaatse gekweekt. 5 privélessen\nbeschikbaar. Hengel beschikbaar\nhengels. Bar en restaurant ter plaatse."
        ],
        "es": [
          "Estanque de 3.000 m², apto para pescadores\npescadores. Aquí podrá provocar a una trucha rosada\ncriada in situ. 5 cursos privados\ndisponibles. Cañas de pescar disponibles\ncañas de pescar. Bar y restaurante en el sitio."
        ]
      },
      "@type": [
        "Description"
      ],
