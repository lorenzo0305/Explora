  "rdfs:comment": {
    "de": [
      "Sie werden touristische Dokumentation, Show Tickets und lokale Produkte finden."
    ],
    "en": [
      "You will find tourist documentation and information, show tickets as well as local products."
    ],
    "it": [
      "L'ufficio turistico Loire Forez di Saint-Bonnet-le-Château offre documentazione turistica, consulenza personalizzata, servizio di biglietteria, accesso Wi-Fi sicuro e un negozio di prodotti locali."
    ],
    "fr": [
      "L'office de tourisme Loire Forez à Saint-Bonnet-le-Château propose de la documentation touristique, un conseil personnalisé, un service de billetterie, un accès Wifi sécurisé et une boutique de produits locaux."
    ],
    "es": [
      "La oficina de turismo Loire Forez de Saint-Bonnet-le-Château ofrece documentación turística, asesoramiento personalizado, servicio de venta de entradas, acceso Wi-Fi seguro y una tienda de productos locales."
    ],
    "nl": [
      "Het VVV-kantoor van de Loire Forez in Saint-Bonnet-le-Château biedt toeristische documentatie, persoonlijk advies, kaartverkoop, beveiligde WiFi-toegang en een winkel met streekproducten."
    ]
  },
