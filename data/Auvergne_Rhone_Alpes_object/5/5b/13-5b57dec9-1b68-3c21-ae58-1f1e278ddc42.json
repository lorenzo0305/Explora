  "rdfs:comment": {
    "de": [
      "Das hermitage Tournonais Team empfehlt Ihnen, um Ihre Aufenthalt in der drôme und Ardèche zu vorbereiten. Wir empfangen Sie in Tain l'Hermitage und Tournon-sur-Rhône."
    ],
    "en": [
      "The Tourist Information team is here to help you plan your stay in Drôme Ardèche. We have offices on either side of the Rhône in Tain l'Hermitage and Tournon sur Rhône."
    ],
    "it": [
      "Il team dell'Ufficio del Turismo vi consiglierà su come preparare il vostro soggiorno nella Drôme Ardèche. Vi accogliamo da una sponda all'altra del Rodano intorno a Tain l'Hermitage e Tournon sur Rhône."
    ],
    "fr": [
      "L'équipe de l'Office de tourisme vous conseille pour préparer votre séjour en Drôme Ardèche. Nous vous accueillons d'une rive à l'autre du Rhône autour de Tain l'Hermitage et Tournon sur Rhône."
    ],
    "nl": [
      "Het team van het Office du Tourisme kan je adviseren bij de voorbereiding van je verblijf in de Drôme Ardèche. Wij verwelkomen u van de ene oever van de Rhône tot de andere rond Tain l'Hermitage en Tournon sur Rhône."
    ],
    "es": [
      "El equipo de la Oficina de Turismo le aconsejará sobre cómo preparar su estancia en Drôme Ardèche. Le acogemos de una orilla a otra del Ródano, en torno a Tain l'Hermitage y Tournon sur Rhône."
    ]
  },
