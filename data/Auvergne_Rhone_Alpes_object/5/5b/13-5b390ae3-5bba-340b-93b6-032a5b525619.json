  "rdfs:comment": {
    "de": [
      "Regionale Küche, Crêpes, Galettes, Parkplatz in der Nähe, klimatisierter Raum.\r\nSpezialitäten: warmer Picodon auf Toast, Froschschenkel, Muscheln mit Pommes frites."
    ],
    "en": [
      "Regional cuisine, pancakes, including buckwheat pancakes, car park nearby, air conditioned dinning room. Our specialties are: Picodon cheese melt on toast, frogs legs, mussels and chips."
    ],
    "it": [
      "Cucina locale, crêpes, galettes, parcheggio nelle vicinanze, sala climatizzata\r\nSpecialità: picodon caldo su pane tostato, cosce di rana, cozze fritte."
    ],
    "fr": [
      "Cuisine du terroir, crêpes, galettes, proximité parking, salle climatisée. \r\nSpécialités : picodon chaud sur toasts, cuisses de grenouilles, moules frites."
    ],
    "nl": [
      "Streekgerechten, hartige en zoete flensjes, parkeerplaats in de buurt, zaal met airco. \r\nSpecialiteiten: warme picodon op toast, kikkerbilletjes, mosselen en frieten."
    ],
    "es": [
      "Cocina local, crêpes, galettes, aparcamiento cercano, habitación con aire acondicionado\r\nEspecialidades: picón caliente sobre tostadas, ancas de rana, mejillones fritos."
    ]
  },
