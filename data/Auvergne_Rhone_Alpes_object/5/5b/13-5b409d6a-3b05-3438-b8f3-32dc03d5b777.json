  "rdfs:comment": {
    "de": [
      "Die jungen Tänzer und Musiker der classes à horaires aménagés der Collèges Jean Zay und Paul Valéry kommen zusammen, um uns das Ergebnis all der Arbeit zu präsentieren, die sie mit ihren Lehrern geleistet haben."
    ],
    "en": [
      "Young dancers and musicians from the special classes at Jean Zay and Paul Valéry secondary schools get together to present the results of all the work they've done with their teachers."
    ],
    "it": [
      "I giovani ballerini e musicisti delle classi speciali delle scuole secondarie Jean Zay e Paul Valéry si riuniscono per presentare i risultati del lavoro svolto con i loro insegnanti."
    ],
    "fr": [
      "Les jeunes danseurs et musiciens des classes à horaires aménagés des collèges Jean Zay et Paul Valéry se réunissent pour nous présenter le résultat de tout le travail accompli avec leurs professeurs."
    ],
    "es": [
      "Los jóvenes bailarines y músicos de las clases especiales de los institutos Jean Zay y Paul Valéry se reúnen para presentar los resultados de todo el trabajo que han realizado con sus profesores."
    ],
    "nl": [
      "De jonge dansers en muzikanten uit de speciale klassen van de middelbare scholen Jean Zay en Paul Valéry komen bij elkaar om de resultaten te presenteren van al het werk dat ze samen met hun leraren hebben gedaan."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Spectacle : Semaine CHAD / CHAM"
    ]
  },
