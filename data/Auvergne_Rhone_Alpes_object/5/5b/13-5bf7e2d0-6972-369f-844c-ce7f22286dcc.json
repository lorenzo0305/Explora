  "rdfs:comment": {
    "de": [
      "Das 2013 eingeweihte Museum befindet sich in der Ermitage und ist ein Interpretationszentrum für den Kalvarienberg. Der zwischen 1840 und 1878 errichtete Kalvarienberg ist das Werk eines Mannes, nämlich von Pater Ambroise Martin (1791-1863), der von 1820 bis zu seinem Tod Pfarrer von Megève war."
    ],
    "en": [
      "Located at the Hermitage, this museum, inaugurated in 2013, is an interpretation centre for the Calvaire site. Built between 1840 and 1878, the Calvary is the work of one man, Father Ambroise Martin (1791-1863), parish priest of Megève from 1820 until his death."
    ],
    "it": [
      "Situato nell'Eremo, questo museo inaugurato nel 2013 ripercorre la storia del Calvario. Edificato tra il 1840 e il 1878, il Calvario è l'opera di un uomo, padre Ambroise Martin (1791 - 1863), curato di Megève dal 1820 e fino alla morte."
    ],
    "fr": [
      "Situé à l’Ermitage, ce musée inauguré en 2013, est un centre d'interprétation du site du Calvaire. Edifié entre 1840 et 1878, le Calvaire est l'œuvre d'un homme, le père Ambroise Martin (1791- 1863), curé de Megève de 1820 à sa mort."
    ],
    "es": [
      "Situado en el Hermitage, este museo, inaugurado en 2013, es un centro de interpretación del yacimiento del Calvario. Construido entre 1840 y 1878, el Calvario fue obra de un solo hombre, el padre Ambroise Martin (1791- 1863), párroco de Megève desde 1820 hasta su muerte."
    ],
    "nl": [
      "Dit museum is gevestigd in de Hermitage en werd ingehuldigd in 2013. Het is een interpretatiecentrum voor de Calvaire-site. De Calvaire werd gebouwd tussen 1840 en 1878 en was het werk van één man, pater Ambroise Martin (1791-1863), pastoor van Megève van 1820 tot aan zijn dood."
    ]
  },
