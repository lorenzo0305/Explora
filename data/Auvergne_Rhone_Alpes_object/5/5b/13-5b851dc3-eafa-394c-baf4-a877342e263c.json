  "rdfs:comment": {
    "de": [
      "Das 5 à 7siete bietet einen Empfang in einer gemütlichen Atmosphäre für eine Weinprobe oder eine bistronomische Mahlzeit auf der Terrasse oder am Kamin."
    ],
    "en": [
      "The 5 à 7siete offers a warm welcome for a drink or a bistronomic meal on the terrace or by the fireplace."
    ],
    "it": [
      "Il 5 à 7siete offre un'accoglienza calorosa per una degustazione o un pasto bistronomico sulla terrazza o accanto al camino."
    ],
    "fr": [
      "Le 5 à 7siete propose un accueil dans une ambiance chaleureuse pour une dégustation ou une restauration bistronomique en terrasse ou au coin de la cheminée."
    ],
    "es": [
      "El 5 à 7siete ofrece una cálida acogida para una degustación o una comida bistronómica en la terraza o junto a la chimenea."
    ],
    "nl": [
      "De 5 à 7siete biedt een warm welkom voor een proeverij of een bistronomische maaltijd op het terras of bij de open haard."
    ]
  },
