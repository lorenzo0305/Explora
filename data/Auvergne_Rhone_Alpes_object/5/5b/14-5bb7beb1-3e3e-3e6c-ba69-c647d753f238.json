      "dc:description": {
        "de": [
          "30. Internationales Tischfußballturnier\nAm Samstag, den 8. und Sonntag, den 9. November\nSalle Bernard Pion - Ecuires\n--------------------------------\nOrganisiert vom Club de Baby-Foot de Montreuil-sur-Mer\n\nEintritt frei\nInformationen: 06 86 75 02 55 oder per E-Mail: mathilde.houyelle@hotmail.fr\nBildnachweis: Les Gladiateurs"
        ],
        "en": [
          "30th International Foosball Tournament\nSaturday 8th and Sunday 9th November\nSalle Bernard Pion - Ecuires\n--------------------------------\nOrganized by Club de Baby-Foot de Montreuil-sur-Mer\n\nFree admission\nInformation: 06 86 75 02 55 or by e-mail: mathilde.houyelle@hotmail.fr\nPhoto credit : Les Gladiateurs"
        ],
        "it": [
          "30° Torneo internazionale di biliardino\nSabato 8 e domenica 9 novembre\nSalle Bernard Pion - Ecuires\n--------------------------------\nOrganizzato dal Club di biliardino di Montreuil-sur-Mer\n\nIngresso libero\nInformazioni: 06 86 75 02 55 o via e-mail: mathilde.houyelle@hotmail.fr\nCrediti fotografici: Les Gladiateurs"
        ],
        "fr": [
          "30e Tournoi International de Babyfoot\nLes samedi 8 et dimanche 9 novembre\nSalle Bernard Pion - Ecuires\n--------------------------------\nOrganisé par le Club de Baby-Foot de Montreuil-sur-Mer\n\nEntrée Gratuite\nRenseignements : 06 86 75 02 55 ou par mail : mathilde.houyelle@hotmail.fr\nCrédit photo : Les Gladiateurs"
        ],
        "es": [
          "xXX Torneo Internacional de Futbolín\nSábado 8 y domingo 9 de noviembre\nSala Bernard Pion - Ecuires\n--------------------------------\nOrganizado por el Club de Futbolín de Montreuil-sur-Mer\n\nEntrada gratuita\nInformación: 06 86 75 02 55 o por correo electrónico: mathilde.houyelle@hotmail.fr\nCrédito de la foto: Les Gladiateurs"
        ],
        "nl": [
          "30e internationale tafelvoetbaltoernooi\nZaterdag 8 en zondag 9 november\nSalle Bernard Pion - Ecuires\n--------------------------------\nGeorganiseerd door de Montreuil-sur-Mer Tafelvoetbalclub\n\nGratis toegang\nInformatie: 06 86 75 02 55 of per e-mail: mathilde.houyelle@hotmail.fr\nFoto credit: Les Gladiateurs"
