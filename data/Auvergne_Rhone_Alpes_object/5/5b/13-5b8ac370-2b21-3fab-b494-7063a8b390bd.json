  "rdfs:comment": {
    "de": [
      "Am Col de la Molède: Ausritte und Wanderungen hoch zu Ross für Anfänger und geübte Reiter. Ponyreiten mit viel Spaß für die Kleinen. Eselverleih für Familienwanderungen."
    ],
    "en": [
      "Donkey or pony hire for 1/2 day, full day or several days.\r\nHalf-day, full-day or multi-day horseback rides.\r\nTracking Game, outdoor Escape Game\r\nShiatsu"
    ],
    "it": [
      ">Noleggio di asini o pony per 1/2 giornata, giornata intera o più giorni.\r\n>>Gioco di inseguimento, gioco di fuga all'aperto\r\n>>>Shiatsu"
    ],
    "fr": [
      ">Location d'ânes ou poneys sur la 1/2 journée, journée ou sur plusieurs jours. \r\n>>Tracking Game, Escape Game de plein air\r\n>>>Shiatsu"
    ],
    "nl": [
      ">Ezel of pony huren voor 1/2 dag, hele dag of meerdere dagen.\r\n>>Tracking Game, ontsnappingsspel in de open lucht\r\n>>>Shiatsu"
    ],
    "es": [
      ">Alquiler de burros o ponis para 1/2 día, día completo o varios días.\r\n>>Juego de pistas, juego de escape al aire libre\r\n>>>Shiatsu"
    ]
  },
