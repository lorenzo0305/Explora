  "rdfs:comment": {
    "de": [
      "Jean-Michel steht Ihnen 7/7 und 24/24 zur Verfügung, um Ihre Transfers zwischen Flughäfen , Bahnhöfen, Skigebieten und Chamonix oder für wunderschöne Ausflüge durchzuführen, sowie alle Ihre Reisen in Frankreich und im Ausland."
    ],
    "en": [
      "Jean-Michel is at your disposal 7/7 and 24H/24 to make your transfers between airports, train stations, ski resorts and Chamonix or for magnificent excursions, as well as all your travels in France and abroad."
    ],
    "it": [
      "Jean-Michel è a vostra disposizione 7 giorni su 7 e 24 ore su 24 per i vostri trasferimenti tra aeroporti, stazioni ferroviarie, stazioni sciistiche e Chamonix o per magnifiche escursioni, nonché per tutti i vostri viaggi in Francia e all'estero."
    ],
    "fr": [
      "Jean-Michel est à votre disposition 7/7 et 24H/24 pour effectuer vos transferts entre les aéroports , les gares, les stations de ski et Chamonix ou pour de magnifiques excursions, ainsi que tous vos déplacements en France et à l’étranger."
    ],
    "nl": [
      "Jean-Michel staat 7/7 en 24H/24 tot uw beschikking voor uw transfers tussen luchthavens, treinstations, skigebieden en Chamonix of voor prachtige excursies, evenals voor al uw uitstapjes in Frankrijk en in het buitenland."
    ],
    "es": [
      "Jean-Michel está a su disposición los 7 días de la semana y las 24 horas del día para sus traslados entre aeropuertos, estaciones de tren, estaciones de esquí y Chamonix o para sus magníficas excursiones, así como para todos sus viajes en Francia y en el extranjero."
    ]
  },
