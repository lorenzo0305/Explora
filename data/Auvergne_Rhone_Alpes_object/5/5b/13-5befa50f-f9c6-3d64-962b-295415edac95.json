  "rdfs:comment": {
    "de": [
      "Bergrestaurant am Fuße des TS La Ravine, 800 m vom Gipfel der Seilbahn von Le Jaillet entfernt. Außergewöhnliche Aussicht auf die Mont-Blanc-Kette. Zugang für Skifahrer, Fußgänger und Mountainbiker. Traditionelle, savoyische Küche mit frischen Qualitätsprodukten."
    ],
    "en": [
      "High-altitude restaurant located at the foot of the La Ravine chairlift, 800 metres from the top of the Jaillet cable car. Exceptional views of the Mont Blanc range. Accessible by ski, on foot and by mountain bike. Traditional Savoyard cuisine made with fresh, high-quality ingredients."
    ],
    "it": [
      "Ristorante d'altitudine ai piedi degli impianti di risalita La Ravine, a 800 metri dalla funivia del Jaillet. Vista eccezionale sulla catena del Monte Bianco. Accesso in sci, a piedi e in mountain-bike. Cucina tradizionale e savoiarda con prodotti freschi e di qualità."
    ],
    "fr": [
      "Restaurant d’altitude situé au pied du TS La Ravine à 800 mètres du sommet de la télécabine du Jaillet. Vue exceptionnelle sur la chaîne du Mont-Blanc. Accès à ski, piéton et VTT. Cuisine traditionnelle et savoyarde avec des produits frais et de qualité."
    ],
    "nl": [
      "Hooggelegen restaurant aan de voet van TS La Ravine, op 800 meter van de top van de Jaillet-kabelbaan. Uitzonderlijk uitzicht op de Mont Blanc-keten. Toegang voor ski's, voetgangers en mountainbikes. Traditionele Savoyaardse keuken met verse kwaliteitsproducten."
    ],
    "es": [
      "Comedor de montaña situado a los pies del teleférico La Ravine, a 800 metros de la cima del teleférico del Jaillet. Vistas excepcionales a la cadena del Mont-Blanc. Acceso en esquí, a pie y en bicicleta de montaña. Cocina tradicional y saboyana con productos frescos y de calidad."
    ]
  },
