  "rdfs:comment": {
    "de": [
      "In den Bibliotheken finden Sie Bücher, Zeitschriften, CDs, DVDs, Lesegeräte, Tablets, die Sie vor Ort lesen oder ausleihen können, sowie weitere digitale Dienstleistungen. Mit der einheitlichen Karte haben Sie Zugang zu allen 16 Bibliotheken des Pays Mornantais.  Lesegeräte stehen zur Verfügung."
    ],
    "en": [
      "Libraries offer books, magazines, CDs, DVDs, readers, shelves to consult on site, to borrow, and other digital services. The single card gives you access to the 16 libraries of the Pays Mornantais.  Reading machine at your disposal."
    ],
    "it": [
      "Le biblioteche offrono libri, riviste, CD, DVD, e-reader, tablet da consultare sul posto, da prendere in prestito e altri servizi digitali. La tessera unica dà accesso alle 16 biblioteche del Pays Mornantais.  Dispositivo di lettura disponibile."
    ],
    "fr": [
      "Les bibliothèques vous proposent livres, magazines, CD, DVD, liseuses, tablettes à consulter sur place, à emprunter,  d’autres services numériques. La carte unique vous permet d’accéder aux 16 bibliothèques du Pays Mornantais.  Liseuse à disposition."
    ],
    "es": [
      "Las bibliotecas te ofrecen libros, revistas, CDs, DVDs, e-readers, tabletas para consultar in situ, para tomar en préstamo y otros servicios digitales. El carné único le da acceso a las 16 bibliotecas del Pays Mornantais.  Dispositivo de lectura disponible."
    ],
    "nl": [
      "De bibliotheken bieden u boeken, tijdschriften, cd's, dvd's, e-readers, tablets om ter plaatse te raadplegen, te lenen en andere digitale diensten. De enkele kaart geeft u toegang tot de 16 bibliotheken van het Pays Mornantais.  Leesapparaat aanwezig."
    ]
  },
  "rdfs:label": {
