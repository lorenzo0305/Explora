  "rdfs:comment": {
    "de": [
      "Ingrid und Michel begrüßen Sie in ihrem Restaurant gegenüber der Bäckerei. Pizza, Burger, traditionelle oder schnelle Gerichte, savoyische Spezialitäten. Nr. 1 der Verkäufe zum Mitnehmen.\r\nAutomat mit handwerklich hergestellten Pizzen, 7/7 und 24/24 geöffnet."
    ],
    "en": [
      "Ingrid and Michel welcome you to their restaurant opposite the bakery. Pizza, burgers, traditional or fast food, Savoyard specialties. N°1 takeaway.\r\nArtisanal pizza vending machine open 7/7 and 24/24."
    ],
    "it": [
      "Ingrid e Michel vi danno il benvenuto nel loro ristorante di fronte alla panetteria. Pizza, hamburger, cibo tradizionale o veloce, specialità savoiarde. N°1 da asporto.\r\nDistributore di pizze fatte in casa aperto 7/7 e 24/24."
    ],
    "fr": [
      "Ingrid et Michel vous accueillent dans leur restaurant situé en face de la boulangerie. Pizza, burgers, restauration traditionnelle ou rapide, spécialités savoyardes. N°1 des ventes à emporter.\r\nDistributeur de pizzas artisanales ouvert 7/7 et 24/24."
    ],
    "es": [
      "Ingrid y Michel le dan la bienvenida a su restaurante frente a la panadería. Pizza, hamburguesas, comida tradicional o rápida, especialidades de Saboya. Número 1 en comida para llevar.\r\nDistribuidor de pizzas caseras abierto 7/7 y 24/24."
    ],
    "nl": [
      "Ingrid en Michel heten je welkom in hun restaurant tegenover de bakkerij. Pizza, hamburgers, traditionele of snelle gerechten, specialiteiten uit de Savoie. Nr. 1 afhaalrestaurant.\r\nVerdeler van huisgemaakte pizza's, 7/7 en 24/24 open."
    ]
  },
  "rdfs:label": {
    "en": [
      "Restaurant pizzeria Le Mont de Grange"
    ],
