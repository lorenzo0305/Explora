  "rdfs:comment": {
    "de": [
      "Eingebettet am Fuße des Puy Griou beherbergt dieser Bergweiler traditionelle Bauernhöfe und Häuser mit typischer Architektur. Als Liebhaber des Kulturerbes oder als Liebhaber der Natur und der Aussichtspunkte werden Sie vom Hameau des Chazes..."
    ],
    "en": [
      "Nestled at the foot of Puy Griou, this mountain hamlet is home to traditional farmhouses and houses with typical architecture. Whether you're a heritage enthusiast or a lover of nature and views, you'll love Hameau des Chazes..."
    ],
    "it": [
      "Situato ai piedi del Puy Griou, questo borgo di montagna ospita fattorie tradizionali e case dall'architettura tipica. Che siate amanti del patrimonio o della natura e dei panorami, sarete sedotti dall'Hameau des Chazes..."
    ],
    "fr": [
      "Niché au pied du Puy Griou, ce hameau de montagne abrite des fermes traditionnelles et des maisons à l'architecture typique. Amateurs de patrimoine ou amoureux de la nature et des points de vue, vous serez séduits par le Hameau des Chazes..."
    ],
    "nl": [
      "In dit berggehucht, gelegen aan de voet van de Puy Griou, staan traditionele boerderijen en huizen met typische architectuur. Of u nu een liefhebber bent van erfgoed of van natuur en uitzicht, u zult verleid worden door de Hameau des Chazes..."
    ],
    "es": [
      "Enclavado a los pies del Puy Griou, este caserío de montaña alberga granjas tradicionales y casas de arquitectura típica. Tanto si es amante del patrimonio como de la naturaleza y las vistas, le encantará el Hameau des Chazes...."
    ]
  },
  "rdfs:label": {
    "en": [
      "The hamlet of Les Chazes"
    ],
    "fr": [
      "Le Hameau des Chazes"
    ],
    "es": [
      "Aldea de Chazes"
    ]
  },
