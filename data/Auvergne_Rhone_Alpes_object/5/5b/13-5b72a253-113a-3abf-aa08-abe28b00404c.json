  "rdfs:comment": {
    "de": [
      "Diese Route, die in Reugny beginnt, bietet eine technisch anspruchsvollere Wanderung, bei der sich Feldwege, Waldgebiete und Weiler abwechseln. Diese dynamische Route ist ideal für sportliche Wanderer."
    ],
    "en": [
      "Leaving from Reugny, this route offers a more technical walk alternating between dirt tracks, woodland and hamlets. A dynamic itinerary, it is ideal for sporty hikers."
    ],
    "it": [
      "Partendo da Reugny, si tratta di un percorso più tecnico che alterna sentieri sterrati, boschi e frazioni. Questo percorso dinamico è ideale per gli escursionisti sportivi."
    ],
    "fr": [
      "Ce parcours au départ de Reugny propose une balade plus technique qui alterne chemins de terre, zone boisée et hameaux. Itinéraire dynamique, il est idéal pour les randonneurs sportifs."
    ],
    "nl": [
      "Vertrekkend vanuit Reugny is dit een meer technische route die afwisselend onverharde paden, bossen en gehuchten volgt. Deze dynamische route is ideaal voor sportieve wandelaars."
    ],
    "es": [
      "Partiendo de Reugny, se trata de una ruta más técnica que alterna pistas de tierra, bosques y aldeas. Esta ruta dinámica es ideal para los senderistas deportistas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "PR7ter Circuit Sur le Chemin de Montavent- Reugny"
    ]
  },
