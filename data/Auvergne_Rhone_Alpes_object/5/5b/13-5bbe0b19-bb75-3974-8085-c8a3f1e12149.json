  "rdfs:comment": {
    "de": [
      "Casa Truck bietet eine leckere Mittagspause in der Zone Axe7 in Saint-Rambert-d'Albon. Tagesgerichte, hausgemachte Salate und Pizzen, schneller Service und praktische Lage."
    ],
    "en": [
      "Casa Truck offers a gourmet lunch break in the Axe7 zone of Saint-Rambert-d?Albon. Daily specials, homemade salads and pizzas, fast service and a convenient location."
    ],
    "it": [
      "Casa Truck offre una pausa pranzo gourmet nella zona Axe7 di Saint-Rambert-d'Albon. Specialità giornaliere, insalate e pizze fatte in casa, servizio veloce e posizione comoda."
    ],
    "fr": [
      "Casa Truck propose une pause déjeuner gourmande en zone Axe7 à Saint-Rambert-d’Albon. Plats du jour, salades et pizzas faits maison, service rapide et emplacement pratique."
    ],
    "es": [
      "Casa Truck ofrece una pausa gourmet para comer en la zona Axe7 de Saint-Rambert-d'Albon. Especialidades del día, ensaladas y pizzas caseras, servicio rápido y una ubicación conveniente."
    ],
    "nl": [
      "Casa Truck biedt een gastronomische lunchpauze in de Axe7-zone in Saint-Rambert-d?Albon. Dagelijkse specialiteiten, huisgemaakte salades en pizza's, snelle service en een gunstige ligging."
    ]
  },
  "rdfs:label": {
