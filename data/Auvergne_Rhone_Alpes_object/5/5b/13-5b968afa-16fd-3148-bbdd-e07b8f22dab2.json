  "rdfs:comment": {
    "de": [
      "Familiäres Reitzentrum, das das ganze Jahr über verschiedene Aktivitäten anbietet, für eine regelmäßige (Jahreskurse) oder gelegentliche (Ausritte, Themenkurse in den Ferien...) Aktivität\r\nAb 3 Jahren."
    ],
    "en": [
      "Family equestrian centre offering various activities throughout the year, for a regular activity (year-round courses) or occasional (rides, theme courses during the holidays, etc.)\r\nFrom 3 years old."
    ],
    "it": [
      "Centro equestre per famiglie che offre varie attività durante tutto l'anno, per un'attività regolare (corsi tutto l'anno) o occasionale (passeggiate, corsi a tema durante le vacanze...)\r\nA partire da 3 anni."
    ],
    "fr": [
      "Centre équestre familial proposant des activités diverses tout au long de l'année, pour une activité régulière (cours à l'année) ou occasionnelle (balades, stages à thème pendant les vacances..) \r\nA partir de 3 ans."
    ],
    "nl": [
      "Familie manege die het hele jaar door verschillende activiteiten aanbiedt, voor een regelmatige activiteit (het hele jaar door lessen) of incidenteel (ritten, themacursussen tijdens de vakantie...)\r\nVanaf 3 jaar."
    ],
    "es": [
      "Centro ecuestre familiar que ofrece diversas actividades a lo largo del año, para una actividad regular (clases durante todo el año) u ocasional (paseos, cursos temáticos durante las vacaciones...)\r\nA partir de los 3 años."
    ]
  },
