  "rdfs:comment": {
    "de": [
      "Das Cintra empfängt Sie durchgehend in einem erstaunlichen Dekor, das je nach Raum sowohl eine entspannte als auch eine intime Atmosphäre für ein einzigartiges kulinarisches Erlebnis bietet."
    ],
    "en": [
      "Le Cintra welcomes you around the clock in a stunning setting, with atmospheres that are both relaxed and intimate, depending on the space, for a unique culinary experience."
    ],
    "it": [
      "Le Cintra è aperto tutto il giorno, tutti i giorni, in un ambiente straordinario, con un'atmosfera rilassata ma intima, a seconda dello spazio, per un'esperienza culinaria unica."
    ],
    "fr": [
      "Le Cintra vous reçoit en continu dans un décor étonnant, avec des ambiances à la fois décontractées et intimistes selon les espaces pour une expérience culinaire unique."
    ],
    "nl": [
      "Le Cintra is de hele dag open, elke dag, in een prachtige omgeving, met een ontspannen maar intieme sfeer, afhankelijk van de ruimte, voor een unieke culinaire ervaring."
    ],
    "es": [
      "Le Cintra está abierto todo el día, todos los días, en un entorno impresionante, con un ambiente relajado y a la vez íntimo, según el espacio, para vivir una experiencia culinaria única."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Cintra"
    ]
  },
