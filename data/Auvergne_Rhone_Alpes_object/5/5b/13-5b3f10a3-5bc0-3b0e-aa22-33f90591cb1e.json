  "rdfs:comment": {
    "de": [
      "Gönnen Sie sich eine Pause in einem außergewöhnlichen Rahmen und genießen Sie eine hausgemachte regionale Küche. Fondue-Abend (Meilleure Fondue de Megève 2024) auf Reservierung. Im Winter über die Pisten Rosière/Mouillette erreichbar, im Sommer 5 Min. zu Fuß vom Javen-See entfernt."
    ],
    "en": [
      "Come and take a break in unique surroundings and enjoy cuisine based on local products and prepared in-house. Book ahead for fondue night. Accessible from the Rosière and Mouillette slopes in Winter, and a 5-minute walk from Javen lake in Summer."
    ],
    "it": [
      "Venite a fare una pausa in una cornice eccezionale e gustate la cucina del territorio fatta in casa. Serata fonduta su prenotazione. Accessibile in inverno dalle piste Rosière/Mouillette, in estate a 5 minuti a piedi dal lago di Javen."
    ],
    "fr": [
      "Faites une pause dans un cadre exceptionnel et profitez d’une cuisine de terroir faite maison. Soirée fondue (Meilleure Fondue de Megève 2024) sur réservation. Accessible l’hiver depuis les pistes Rosière/Mouillette, l'été à 5 min à pied du lac de Javen."
    ],
    "es": [
      "Tómese un descanso en un marco excepcional y disfrute de la cocina local casera. Veladas de fondue (Mejor Fondue de Megève 2024) con cita previa. Accesible en invierno desde las pistas de Rosière/Mouillette y en verano a 5 minutos a pie del lago de Javen."
    ],
    "nl": [
      "Neem een pauze in een uitzonderlijke omgeving en geniet van huisgemaakte lokale gerechten. Fondue-avonden (Beste Fondue van Megève 2024) op afspraak. Bereikbaar in de winter vanaf de Rosière/Mouillette-pistes en in de zomer op 5 minuten lopen van het Lac de Javen."
    ]
  },
  "rdfs:label": {
    "en": [
      "La Petite Fontaine"
    ],
