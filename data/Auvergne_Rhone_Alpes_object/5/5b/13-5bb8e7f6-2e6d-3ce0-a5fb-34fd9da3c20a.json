  "rdfs:comment": {
    "de": [
      "Ich komme ursprünglich aus Clermont-Ferrand, bin aber vor etwa 25 Jahren in die Region Vichyssoise gezogen und habe mich entschieden, wegen der hohen Lebensqualität dort zu bleiben."
    ],
    "en": [
      "Originally from Clermont-Ferrand, I moved to the Vichyssoise region around 25 years ago and decided to stay for its quality of life."
    ],
    "it": [
      "Originaria di Clermont-Ferrand, mi sono trasferita nella regione della Vichyssoise circa 25 anni fa e ho deciso di rimanere per la sua qualità di vita."
    ],
    "fr": [
      "Clermontoise d’origine, je suis arrivée dans la région Vichyssoise il y a environ 25 ans et j’ai décidé d’y rester pour sa qualité de vie."
    ],
    "es": [
      "Originario de Clermont-Ferrand, me trasladé a la región de Vichyssoise hace unos 25 años y decidí quedarme por su calidad de vida."
    ],
    "nl": [
      "Ik kom oorspronkelijk uit Clermont-Ferrand, maar ik verhuisde ongeveer 25 jaar geleden naar de Vichyssoise regio en besloot te blijven vanwege de levenskwaliteit."
    ]
  },
