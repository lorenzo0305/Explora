  "rdfs:comment": {
    "de": [
      "Das Hotel bietet Ihnen einen ruhigen Aufenthalt in seinen hübschen Zimmern im Herzen des Dorfes mit Blick auf die Berge."
    ],
    "en": [
      "Charming rooms at the heart of the village, with views of the mountains for a peaceful stay."
    ],
    "it": [
      "L'hotel offre un soggiorno tranquillo nelle sue camere accoglienti nel cuore del villaggio con vista sulle montagne."
    ],
    "fr": [
      "L'hôtel vous propose de séjourner au calme, dans ses chambres coquettes au coeur du village avec vue sur les montagnes."
    ],
    "nl": [
      "Het hotel biedt je een rustig verblijf in zijn gezellige kamers in het hart van het dorp, met uitzicht op de bergen."
    ],
    "es": [
      "El hotel le ofrece una estancia tranquila en sus acogedoras habitaciones en el corazón del pueblo con vistas a las montañas."
    ]
  },
