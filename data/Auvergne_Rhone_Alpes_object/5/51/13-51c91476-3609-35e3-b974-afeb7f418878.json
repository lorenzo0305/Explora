  "rdfs:comment": {
    "de": [
      "6 km lange Wanderstrecke in der Gemeinde Saint-Jacques des Blats, die am Col de Font de Cère beginnt und 1,5 km von der Station Lioran entfernt bis zum Weiler Les Chazes führt. Sie werden 6 km auf Waldwegen und 900 m auf Straßen zurücklegen. Planen Sie 2 Stunden für die Wanderung ein."
    ],
    "en": [
      "6 km hiking trail in the Saint-Jacques des Blats commune, from the Font de Cère pass, 1.5 km from the Lioran resort, to the hamlet of Les Chazes. You will follow 5 km of forest tracks and 900 m of roads. Allow 2 hours' walking."
    ],
    "it": [
      "Un percorso escursionistico di 6 km nel comune di Saint-Jacques des Blats, che parte dal passo della Font de Cère, a 1,5 km dalla località di Le Lioran, e conduce alla frazione di Les Chazes. Si percorrono 6 km di sentieri forestali e 900 m di strade. Prevedere 2 ore di cammino."
    ],
    "fr": [
      "Parcours de randonnée de 6 km sur la commune de Saint-Jacques des Blats au départ du col de Font de Cère à 1.5 km de la station du Lioran jusqu'au hameau des Chazes. Vous emprunterez 6 km de pistes forestières et 900 m de routes. Prévoir 2h de marche."
    ],
    "es": [
      "Ruta de senderismo de 6 km en el municipio de Saint-Jacques des Blats, que parte del puerto de Font de Cère, a 1,5 km de la estación de Le Lioran, y llega hasta la aldea de Les Chazes. Recorrerá 5 km de pistas forestales y 900 m de caminos. Prever 2 horas de marcha."
    ],
    "nl": [
      "Een wandelroute van 6 km in de gemeente Saint-Jacques des Blats, die begint bij de pas Font de Cère, op 1,5 km van het skioord Le Lioran, en naar het gehucht Les Chazes leidt. Je volgt 6 km bospaden en 900 m wegen. Reken op 2 uur wandelen."
    ]
  },
  "rdfs:label": {
    "en": [
      "Les Chazes from Font de Cère"
    ],
    "fr": [
      "Les Chazes depuis Font de Cère"
    ],
    "es": [
      "Les Chazes desde Font de Cère"
    ]
  },
