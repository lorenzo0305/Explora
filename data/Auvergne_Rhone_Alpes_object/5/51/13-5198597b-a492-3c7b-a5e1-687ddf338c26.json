  "rdfs:comment": {
    "de": [
      "Seit 30 Jahren heißen wir Sie in unserem Restaurant an der Place Jean Jaurès in unserem gemütlichen Ambiente oder auf der wunderschönen Sonnenterrasse.willkommen.  90% aller Gerichte sind hausgemacht. Lassen Sie sich von unseren Spezialitäten und hausgemachten Burgern überzeugen.\r\n\r\n."
    ],
    "en": [
      "Imagine a terrasse, a large, sunny terrasse... Imagine a Parisian-style bistrot, not a strait-laced one, a young, trendy one. Stop imagining, this place exists - the Nota Bene on Place Jean Jaurès.\r\n\r\n\r\n."
    ],
    "it": [
      "Immaginate una terrazza, una grande terrazza soleggiata... Immaginate un bistrot dallo spirito parigino, non soffocante, giovane e alla moda. Non immaginate altro e andate in Place Jean Jaurès a Nota Bene."
    ],
    "fr": [
      "Imaginez une terrasse, une grande terrasse ensoleillée... Imaginez un bistrot esprit parisien, pas guindé, jeune et branché. N’imaginez plus, et rendez-vous sur la Place Jean Jaurès au Nota Bene."
    ],
    "nl": [
      "Stel je een terras voor, een groot zonnig terras... Stel je een bistro voor met een Parijse geest, niet stoffig, jong en trendy. Stel je niets meer voor, en ga naar de Place Jean Jaurès bij Nota Bene."
    ],
    "es": [
      "Imagina una terraza, una gran terraza soleada... Imagina un bistró con espíritu parisino, no recargado, joven y a la moda. No imagine más y vaya a la plaza Jean Jaurès en Nota Bene."
    ]
  },
