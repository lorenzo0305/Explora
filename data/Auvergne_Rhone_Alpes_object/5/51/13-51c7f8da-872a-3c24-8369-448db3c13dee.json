  "rdfs:comment": {
    "de": [
      "Das Restaurant Au Fil de l'Eau bietet Ihnen am Hafen von Roanne eine traditionelle Küche von hoher Qualität, die je nach Jahreszeit und Markt variiert. Die Speisekarte wurde mit Blick auf die Liebhaber von Fleisch und Fröschen zusammengestellt"
    ],
    "en": [
      "The Au Fil de l'Eau restaurant in the port of Roanne offers traditional, high-quality cuisine that changes with the seasons and the markets. The menu has been created with meat and frog lovers in mind?"
    ],
    "it": [
      "Il ristorante Au Fil de l'Eau, nel porto di Roanne, offre una cucina tradizionale e di qualità che cambia in base alle stagioni e ai mercati. Il menu è stato creato pensando agli amanti della carne e delle rane?"
    ],
    "fr": [
      "Le restaurant Au Fil de l’Eau vous propose au port de Roanne, une cuisine traditionnelle de qualité renouvelée au fil des saisons et des marchés. La carte a été créée en pensant aux amoureux de la viande et des grenouilles…"
    ],
    "nl": [
      "Het restaurant Au Fil de l'Eau in de haven van Roanne biedt traditionele gerechten van hoge kwaliteit die veranderen met de seizoenen en de markten. Het menu is samengesteld met vlees- en kikkerliefhebbers in het achterhoofd?"
    ],
    "es": [
      "El restaurante Au Fil de l'Eau, en el puerto de Roanne, ofrece una cocina tradicional de calidad que cambia con las estaciones y los mercados. El menú se ha creado pensando en los amantes de la carne y las ranas.."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Au Fil de l'Eau"
    ]
  },
