  "rdfs:comment": {
    "de": [
      "Das Café Terroir Lyon Célestins ist ein einzigartiges Café-Bar bietet eine Auswahl an lokalen Produkten in der Region Rhône-Alpes ausgegraben."
    ],
    "en": [
      "The Café Terroir - Lyon Célestins is a unique gastronomic restaurant of french tradition offering a selection of local products from all over the Rhone-Alps region."
    ],
    "it": [
      "Il Café Terroir Lyon Célestins è un caffè-comptoir unico con una selezione di prodotti locali scovati ai quattro angoli della regione Rodano-Alpi."
    ],
    "fr": [
      "Café Terroir est une table gastronomique de tradition française qui se caractérise par son ambiance décontractée et intimiste, la qualité des produits qui y sont servis, la singularité de la carte des vins et le service en salle particulièrement élégant."
    ],
    "es": [
      "El Café Terroir Lyon Célestins es un bar-restaurante único con una selección de productos locales de todos los rincones de la región de Ródano-Alpes."
    ],
    "nl": [
      "Café Terroir is een traditioneel Frans gastronomisch restaurant met een ontspannen, intieme sfeer, een menu met producten van hoge kwaliteit, een unieke wijnkaart en bijzonder elegante roomservice."
    ]
  },
