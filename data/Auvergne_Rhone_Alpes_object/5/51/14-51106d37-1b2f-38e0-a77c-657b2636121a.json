  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/311ec60e-fdea-3d31-b0ef-ec04625e4647",
      "dc:description": {
        "de": [
          "Haben Sie Lust, eine einzigartige, schöne und umweltfreundliche Dekoration zu kreieren? Dieser Workshop lädt Sie dazu ein, aus natürlichen Elementen, die Sie im Parc des Cytises gesammelt haben, Ihr eigenes hängendes Mobile herzustellen."
        ],
        "en": [
          "Want to create a unique, beautiful and eco-responsible decoration? This workshop invites you to create your own hanging mobile, using natural elements gleaned from the Parc des Cytises."
        ],
        "it": [
          "Volete creare una decorazione unica, bella ed eco-responsabile? Questo laboratorio vi invita a creare il vostro mobile sospeso, utilizzando elementi naturali raccolti nel Parc des Cytises."
        ],
        "fr": [
          "Envie de créer une décoration unique, belle et éco-responsable ? Cet atelier vous invite à réaliser votre propre mobile suspendu, à partir d’éléments naturels glanés dans le Parc des Cytises."
        ],
        "es": [
          "¿Quieres crear una decoración única, bonita y ecorresponsable? Este taller te invita a crear tu propio móvil colgante, utilizando elementos naturales recogidos en el Parc des Cytises."
        ],
        "nl": [
          "Wil je een unieke, mooie en ecologisch verantwoorde decoratie maken? Deze workshop nodigt je uit om je eigen hangende mobiel te maken met natuurlijke elementen uit het Parc des Cytises."
        ]
      },
