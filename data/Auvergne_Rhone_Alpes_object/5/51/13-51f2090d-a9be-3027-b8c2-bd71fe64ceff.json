  "rdfs:comment": {
    "de": [
      "Sicherer Wasserspielplatz für die Kleinsten mit einem Bereich ohne Wassertiefe, der ideal ist, um das Wasser zu entdecken und sich abzukühlen.\r\nEine familienfreundliche und unterhaltsame Umgebung am Ufer des Lac du Bourget."
    ],
    "en": [
      "A huge relaxation area in a natural setting with lawn and solarium."
    ],
    "it": [
      "Un immenso spazio relax in un contesto naturale con prato e solarium."
    ],
    "fr": [
      "Aire de jeux aquatique sécurisée pour les plus petits, dotée d'un espace sans profondeur, idéal pour la découverte de l’eau et pour se rafraîchir.\r\nUn environnement familial et amusant, au bord du lac du Bourget."
    ],
    "es": [
      "Una zona de juegos acuáticos segura para los más pequeños, con una zona poco profunda ideal para descubrir el agua y refrescarse.\r\nUn ambiente familiar y divertido a orillas del lago Bourget."
    ],
    "nl": [
      "Een veilige waterspeelplaats voor de kleintjes, met een ondiep gedeelte dat ideaal is om het water te ontdekken en koel te blijven.\r\nEen leuke gezinsomgeving aan de oevers van Lac du Bourget."
    ]
  },
  "rdfs:label": {
    "en": [
      "Municipal Beach (Aqualac Beach)"
    ],
    "it": [
      "Spiaggia Comunale (Spiaggia di Aqualac)"
    ],
    "fr": [
      "Splashpad"
    ]
  },
