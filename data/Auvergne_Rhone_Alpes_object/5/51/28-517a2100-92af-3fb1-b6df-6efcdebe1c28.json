  "rdfs:comment": {
    "de": [
      "Mit: Alexandra Lescure, Klavier; Etienne Kippellen, Musikwissenschaftler.\nUnd David Louwerse, Cello, in einem Duett mit Alexandra Lescure für eine Hommage an Paul Paray (1886-1979) anlässlich seines 140."
    ],
    "en": [
      "With : Alexandra Lescure, piano; Etienne Kippellen, musicologist.\nAnd the participation of David Louwerse, cello, in a duet with Alexandra Lescure for a tribute to Paul Paray (1886-1979), on the 140th anniversary of his birth in Le Tréport."
    ],
    "it": [
      "Con : Alexandra Lescure, pianoforte; Etienne Kippellen, musicologo.\nE la partecipazione di David Louwerse, violoncello, in un duetto con Alexandra Lescure in un omaggio a Paul Paray (1886-1979), in occasione del 140° anniversario della sua nascita a Le Tréport."
    ],
    "fr": [
      "Avec : Alexandra Lescure, piano; Etienne Kippellen, musicologue.\nEt la participation de David Louwerse, violoncelle, à un duo avec Alexandra Lescure pour un hommage à Paul Paray (1886-1979), à l'occasion des 140 ans de sa naissance au Tréport."
    ],
    "nl": [
      "Met : Alexandra Lescure, piano; Etienne Kippellen, musicoloog.\nEn de deelname van David Louwerse, cello, in een duet met Alexandra Lescure in een eerbetoon aan Paul Paray (1886-1979), ter gelegenheid van de 140e verjaardag van zijn geboorte in Le Tréport."
    ],
    "es": [
      "Con : Alexandra Lescure, piano; Etienne Kippellen, musicólogo.\nY la participación de David Louwerse, violonchelo, en dúo con Alexandra Lescure en un homenaje a Paul Paray (1886-1979), con motivo del 140 aniversario de su nacimiento en Le Tréport."
    ]
  },
