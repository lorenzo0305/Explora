  "rdfs:comment": {
    "de": [
      "Entdecken Sie Blei und Silberminen (17. Jh. 19. Jh.) Sowie die Geschichte der prestigeträchtigen Ecole Française des Mines in Peisey-Nancroix: Führungen und Geologie mit einem Führer zum Erbe des Savoie Mont Blanc."
    ],
    "en": [
      "Discover the lead and silver mines (17th c., 19th c.) and the history of the prestigious French School of Mines in Peisey-Nancroix: guided tours and geology for children with a Heritage Guide from the Pays de Savoie."
    ],
    "it": [
      "Scoprite le miniere di piombo e argento (XVII secolo, XIX secolo) e la storia della prestigiosa Ecole Française des Mines di Peisey-Nancroix: visite guidate e geologia per bambini con una guida del patrimonio del Pays de Savoie."
    ],
    "fr": [
      "A la découverte des mines de plomb et d'argent (XVIIe s., XIXe s.) ainsi que l'histoire de la prestigieuse Ecole Française des Mines à Peisey-Nancroix : visites guidées et géologie enfants avec un Guide du Patrimoine des Pays de Savoie."
    ],
    "nl": [
      "Ontdek de lood- en zilvermijnen (17e eeuw, 19e eeuw) en de geschiedenis van de prestigieuze Ecole Française des Mines in Peisey-Nancroix: rondleidingen en geologie voor kinderen met een erfgoedgids van Pays de Savoie."
    ],
    "es": [
      "Descubra las minas de plomo y plata (siglo XVII, siglo XIX) y la historia de la prestigiosa Escuela Francesa de Minas de Peisey-Nancroix: visitas guiadas y geología infantil con un guía del patrimonio de Pays de Savoie."
    ]
  },
