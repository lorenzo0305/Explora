  "rdfs:comment": {
    "de": [
      "Italien lädt sich in Megève ein! Eine authentische Speisekarte mit italienischen Spezialitäten. Große Sonnenterrasse, Cocktailbar, täglich von 9 bis 1 Uhr geöffnet."
    ],
    "en": [
      "Italy comes to Megève! A menu of authentic Italian specialities, a vast sunny terrace, a cocktail bar, daily from 9am to 1am."
    ],
    "it": [
      "L'Italia a Megève! Una carta autentica che comprende specialità italiane. Una grande terrazza soleggiata, cocktail bar, tutti i giorni dalle 9 all'1."
    ],
    "fr": [
      "L'Italie s'invite à Megève ! Une carte authentique, composée de spécialités italiennes. Grande terrasse ensoleillée, bar à cocktails, ouvert tous les jours de 9h à 1h."
    ],
    "es": [
      "¡Italia se invita a Megève! Un auténtico menú de especialidades italianas. Amplia terraza soleada, bar de cócteles, abierto todos los días de 9.00 a 1.00."
    ],
    "nl": [
      "Italië nodigt zichzelf uit in Megève! Een authentiek menu met Italiaanse specialiteiten. Groot zonnig terras, cocktailbar, elke dag geopend van 9 tot 1 uur."
    ]
  },
