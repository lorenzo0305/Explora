  "rdfs:comment": {
    "de": [
      "Ferme Auberge, 100% hausgemachte Mahlzeiten aus den Produkten unseres Bauernhofs.\r\nAls Liebhaber der Geselligkeit garantieren wir Ihnen einen Moment der Authentizität und Großzügigkeit."
    ],
    "en": [
      "Ferme Auberge, 100% home-cooked meals using produce from our farm.\r\nWith our love of conviviality, we guarantee you a moment of authenticity and generosity."
    ],
    "it": [
      "Fattoria Inn alle porte di Marais de Lavours, 100% cibo fatto in casa da prodotti agricoli."
    ],
    "fr": [
      "Ferme Auberge, repas 100% fait maison à partir des produits de notre ferme.\r\nAmoureux de la convivialité, nous vous garantissons un moment d’authenticité et de générosité."
    ],
    "es": [
      "Ferme Auberge, comidas 100% caseras elaboradas con productos de nuestra granja.\r\nCon nuestro amor por la convivencia, le garantizamos un momento de autenticidad y generosidad."
    ],
    "nl": [
      "Ferme Auberge, 100% huisbereide maaltijden met producten van onze boerderij.\r\nMet onze liefde voor gezelligheid garanderen we je een moment van authenticiteit en gulheid."
    ]
  },
