  "rdfs:comment": {
    "de": [
      "Mit einer Sammlung von mehr als 4000 Objekten präsentiert das Regionalmuseum der Auvergne die ländliche Auvergne des 19. Jahrhunderts, will aber auch ein Spiegel der heutigen Region und ihrer Bewohner sein."
    ],
    "en": [
      "Through a collection of more than 4,000 objects, the Auvergne Regional Museum presents the rural Auvergne of the 19th century, but also aims to reflect the territory and its inhabitants today."
    ],
    "it": [
      "Attraverso una collezione di oltre 4.000 oggetti, il Museo Regionale dell'Alvernia presenta l'Alvernia rurale del XIX secolo, ma mira anche a rispecchiare il territorio e i suoi abitanti di oggi."
    ],
    "fr": [
      "À travers une collection de plus de 4 000 objets, le musée régional d'Auvergne présente l'Auvergne rurale du XIXe siècle, mais se veut aussi miroir du territoire et des habitants d'aujourd'hui."
    ],
    "nl": [
      "Via een collectie van meer dan 4.000 voorwerpen presenteert het Regionaal Museum van de Auvergne het landelijke Auvergne van de 19e eeuw, maar wil het ook een spiegel zijn van het grondgebied en zijn inwoners van vandaag."
    ],
    "es": [
      "A través de una colección de más de 4.000 objetos, el Museo Regional de Auvernia presenta la Auvernia rural del siglo XIX, pero también pretende reflejar el territorio y sus habitantes de hoy."
    ]
  },
