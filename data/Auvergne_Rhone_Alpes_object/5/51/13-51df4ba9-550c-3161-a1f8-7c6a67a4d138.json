  "rdfs:comment": {
    "de": [
      "La Maison-Mère: Historisches Geschäft, das 1852 gegründet wurde.\r\nDie Produkte werden vor Ort auf handwerkliche Weise hergestellt: Schokolade, Pralinen, Eisbonbons, Karamellbonbons, Nougat.\r\nDie Produkte sind somit garantiert \"made in France\" und sogar \"made in Auvergne\"!"
    ],
    "en": [
      "La Maison-Mère: historic store founded in 1852.\r\nAll products are handmade on site: chocolates, pralines, bonbons glacés, caramels and nougats.\r\nAll products are guaranteed \"made in France\" and even \"made in Auvergne\"!"
    ],
    "it": [
      "La Maison-Mère: negozio storico fondato nel 1852.\r\nI prodotti sono fatti a mano sul posto: cioccolatini, praline, caramelle glassate, caramelle e torroni.\r\nI prodotti sono garantiti \"made in France\" e addirittura \"made in Auvergne\"!"
    ],
    "fr": [
      "La Maison-Mère : boutique historique fondée en 1852.\r\nLes produits sont fabriqués sur place de manière artisanale : chocolats, pralines, bonbons glacés, caramels, nougats.\r\nLes produits sont ainsi garantis « made in France » et même « made in Auvergne » !"
    ],
    "es": [
      "La Maison-Mère: una tienda histórica fundada en 1852.\r\nLos productos se elaboran artesanalmente en el propio establecimiento: chocolates, pralinés, caramelos helados, caramelos y turrones.\r\nLos productos están garantizados \"made in France\" e incluso \"made in Auvergne\""
    ],
    "nl": [
      "La Maison-Mère: een historische winkel opgericht in 1852.\r\nDe producten worden ter plekke met de hand gemaakt: bonbons, pralines, ijsbonbons, karamels en nougat.\r\nDe producten zijn gegarandeerd \"made in France\" en zelfs \"made in Auvergne\"!"
    ]
  },
