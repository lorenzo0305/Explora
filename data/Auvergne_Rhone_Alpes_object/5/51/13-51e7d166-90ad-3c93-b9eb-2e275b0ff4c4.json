  "rdfs:comment": {
    "de": [
      "Wenn Sie uns besuchen, entdecken Sie eine bäuerliche, biologische Landwirtschaft, in der Tiere, Erde und Menschen respektiert werden."
    ],
    "en": [
      "By coming to meet us, discover a peasant, organic agriculture in the respect of the animals, the earth and the Men."
    ],
    "it": [
      "Venendo a conoscerci, scoprirete un'agricoltura contadina, biologica nel rispetto degli animali, della terra e degli uomini."
    ],
    "fr": [
      "En venant à notre rencontre, découvrez une agriculture paysanne, biologique dans le respect des animaux, de la terre et des Hommes."
    ],
    "nl": [
      "Door ons te komen ontmoeten, ontdekt u een boerenlandbouw, biologisch in het respect voor de dieren, de grond en de Mensen."
    ],
    "es": [
      "Al venir a nuestro encuentro, descubra una agricultura campesina, orgánica en el respeto de los animales, la tierra y los hombres."
    ]
  },
