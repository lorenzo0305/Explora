  "rdfs:comment": {
    "de": [
      "Das Einhorn ist ein Verein nach dem Gesetz von 1901, der gemeinsame Freizeitaktivitäten für Kinder und Erwachsene entwickelt und Aktionen anbietet, die den Zugang zu kulturellen, künstlerischen, bürgerschaftlichen und sozialen Praktiken ermöglichen, und der für alle offen ist."
    ],
    "en": [
      "La Licorne is an association under the law of 1901, which develops shared leisure activities for Children/Adults and proposes actions allowing access to cultural, artistic, civic and social practices and is open to all."
    ],
    "it": [
      "La Licorne è un'associazione di diritto francese del 1901, che sviluppa attività di svago condivise per bambini e adulti e propone azioni che consentono l'accesso a pratiche culturali, artistiche, civiche e sociali e che è aperta a tutti."
    ],
    "fr": [
      "La Licorne est une association loi 1901, qui développe les loisirs partagés Enfants/Adultes et propose des actions permettant l'accès à des pratiques culturelles, artistiques, civiques et sociales et qui est ouverte à tous."
    ],
    "nl": [
      "La Licorne is een vereniging volgens de Franse wet van 1901, die gemeenschappelijke vrijetijdsactiviteiten voor kinderen en volwassenen ontwikkelt en acties voorstelt die toegang bieden tot culturele, artistieke, burgerlijke en sociale praktijken en die voor iedereen openstaat."
    ],
    "es": [
      "La Licorne es una asociación amparada por la ley francesa de 1901, que desarrolla actividades de ocio compartido para niños y adultos y propone acciones que permiten el acceso a prácticas culturales, artísticas, cívicas y sociales y que está abierta a todos."
    ]
  },
