  "rdfs:comment": {
    "de": [
      "Cyrille Dubois und das Ensemble ArteCombo entführen uns in das goldene Zeitalter des Broadway, von den 30er bis zu den 50er Jahren, in einer Show, in der Humor auf Feinfühligkeit und Emotionen trifft."
    ],
    "en": [
      "Cyrille Dubois and the ArteCombo Ensemble take us back to the golden age of Broadway, from the 30?s to the 50?s, in a show where humor rubs shoulders with delicacy and emotion."
    ],
    "it": [
      "Cyrille Dubois e l'Ensemble ArteCombo ci riportano all'epoca d'oro di Broadway, dagli anni '30 agli anni '50, in uno spettacolo che combina umorismo, delicatezza ed emozione."
    ],
    "fr": [
      "Cyrille Dubois et l’Ensemble ArteCombo nous entraînent dans l’âge d’or de Broadway, des années 30 aux années 50, dans un spectacle où l’humour côtoie la délicatesse et l’émotion."
    ],
    "es": [
      "Cyrille Dubois y el conjunto ArteCombo nos transportan a la época dorada de Broadway, de los años 30 a los 50, en un espectáculo que combina humor con delicadeza y emoción."
    ],
    "nl": [
      "Cyrille Dubois en het ArteCombo Ensemble nemen ons mee terug naar de gouden eeuw van Broadway, van de jaren 1930 tot 1950, in een show die humor combineert met delicatesse en emotie."
    ]
  },
  "rdfs:label": {
