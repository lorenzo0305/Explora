  "rdfs:comment": {
    "de": [
      "Im Herzen von Grenoble gelegen, nur einen Katzensprung von der Straßenbahnhaltestelle, der Belle Électrique, Espace Vertical und dem pulsierenden Viertel Saint Bruno entfernt, bringt unsere Spielebar Spaß in das Herz eines dynamischen Viertels!\r\nRestaurant mittags geöffnet"
    ],
    "en": [
      "Located in the heart of Grenoble, just a hop, skip and a jump from the streetcar stop, the Belle Électrique, Espace Vertical and the vibrant Saint Bruno district, our games bar brings playfulness to the heart of a dynamic neighborhood!\r\nRestaurant open for lunch"
    ],
    "it": [
      "Situato nel cuore di Grenoble, a un passo dalla fermata del tram, dalla Belle Électrique, dall'Espace Vertical e dal vivace quartiere di Saint Bruno, il nostro games bar porta il divertimento nel cuore di un quartiere dinamico!\r\nRistorante aperto a pranzo"
    ],
    "fr": [
      "Situé au cœur de Grenoble, à un saut de puce de l’arrêt de tram, de la Belle Électrique, d’Espace Vertical et du vibrant quartier Saint Bruno, notre bar à jeux vient apporter le ludique au cœur d’un quartier dynamique ! \r\nRestaurant ouvert le midi"
    ],
    "es": [
      "Situado en pleno centro de Grenoble, a dos pasos de la parada del tranvía, de la Belle Électrique, del Espace Vertical y del animado barrio de Saint Bruno, nuestro bar de juegos lleva la diversión al corazón de un barrio dinámico\r\nRestaurante abierto al mediodía"
    ],
    "nl": [
      "Gelegen in het hart van Grenoble, op een steenworp afstand van de tramhalte, de Belle Électrique, Espace Vertical en de bruisende wijk Saint Bruno, brengt onze spelletjesbar plezier in het hart van een dynamische wijk!\r\nRestaurant geopend voor lunch"
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Tanière au Coin du Jeu"
    ]
  },
