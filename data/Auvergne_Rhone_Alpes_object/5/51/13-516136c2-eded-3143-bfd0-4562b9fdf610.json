  "rdfs:comment": {
    "de": [
      "Gutes Essen bringt Menschen zusammen, köstliche Gerichte lassen sie wiederkommen. So werden Sie jedes Mal schmackhafte Gerichte genießen, die mit frischen, saisonalen und möglichst lokalen Produkten zubereitet werden."
    ],
    "en": [
      "Good food brings people together, delicious food keeps them coming back. So, you will enjoy every time tasty dishes prepared with fresh and seasonal products and local whenever possible."
    ],
    "it": [
      "Il buon cibo unisce le persone, il cibo delizioso le fa tornare. Potrete così gustare sempre piatti gustosi preparati con prodotti freschi, di stagione e locali, quando possibile."
    ],
    "fr": [
      "Les bons plats rassemblent les gens, les plats délicieux les font revenir. Ainsi, vous dégusterez à chaque fois des plats savoureux préparés avec des produits frais et de saison et locaux tant que possible."
    ],
    "es": [
      "La buena comida une a la gente, la comida deliciosa hace que vuelvan. Así, siempre que sea posible, disfrutará de sabrosos platos elaborados con productos frescos, de temporada y locales."
    ],
    "nl": [
      "Goed eten brengt mensen samen, lekker eten zorgt ervoor dat ze terugkomen. Zo geniet u altijd van smakelijke gerechten die waar mogelijk met verse, seizoensgebonden en lokale producten worden bereid."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant Le Brévenne Café"
    ]
  },
