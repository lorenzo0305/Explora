  "rdfs:comment": {
    "de": [
      "Der Plan d'eau de Cunlhat liegt 55 km von Clermont-Ferrand entfernt. Dieser Ort ist eine Oase der Ruhe, in der Familien die Schönheit der Landschaft rund um die Wasserstelle bewundern und die vorhandenen Einrichtungen (Sportgeräte, Tennis, BMX-Räder usw.) nutzen können."
    ],
    "en": [
      "The Cunlhat lake is located 55 kilometers from Clermont-Ferrand. It's a haven of peace where families come to admire the beauty of the surrounding landscape and enjoy the facilities on offer (apparatus, tennis, BMX, etc.)."
    ],
    "it": [
      "Il lago di Cunlhat si trova a 55 chilometri da Clermont-Ferrand. È un'oasi di pace dove le famiglie possono ammirare la bellezza del paesaggio che circonda il lago e godere delle strutture offerte (attrezzature, tennis, BMX, ecc.)."
    ],
    "fr": [
      "Le plan d'eau de Cunlhat se situe à 55 kilomètres de Clermont-Ferrand. Ce lieu est un havre de paix où les familles viennent admirer la beauté du paysage qui entoure le point d'eau et profiter des infrastructures présentes (agrès, tennis, BMX, etc.)."
    ],
    "nl": [
      "Het meer van Cunlhat ligt op 55 kilometer van Clermont-Ferrand. Het is een oase van rust waar gezinnen de schoonheid van het landschap rondom het meer kunnen bewonderen en kunnen genieten van de aangeboden faciliteiten (toestellen, tennis, BMX, enz.)."
    ],
    "es": [
      "El lago de Cunlhat está situado a 55 kilómetros de Clermont-Ferrand. Es un remanso de paz donde las familias pueden admirar la belleza del paisaje que rodea el lago y disfrutar de las instalaciones que se ofrecen (aparatos, tenis, BMX, etc.)."
    ]
  },
