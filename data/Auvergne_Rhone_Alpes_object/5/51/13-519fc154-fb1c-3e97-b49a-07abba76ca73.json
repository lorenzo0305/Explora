  "rdfs:comment": {
    "de": [
      "Leckere hausgemachte Burger mit Charolais-Rindfleisch, regionalem Käse und knusprigen Pommes frites aus eigener Herstellung. Ein 100 % frisches und authentisches Erlebnis. Alles wird vor Ort zubereitet, um Ihnen Frische und Authentizität zu garantieren.  Zum Mitnehmen."
    ],
    "en": [
      "Delicious homemade burgers made with Charolais beef, local cheese and crispy homemade chips. A 100% fresh and authentic experience. Everything is prepared on site to guarantee freshness and authenticity.  Takeaway only."
    ],
    "it": [
      "Gustosi hamburger fatti in casa preparati con carne Charolais, formaggio locale e croccanti patatine fritte fatte in casa. Un'esperienza 100% fresca e autentica. Tutto viene preparato in loco per garantire freschezza e autenticità.  Da asporto."
    ],
    "fr": [
      "Burgers maison savoureux préparés avec de la viande charolaise, du fromage local et des frites croustillantes faites maison. Une expérience 100% fraîche et authentique. Tout est préparé sur place pour vous garantir fraîcheur et authenticité.  À emporter."
    ],
    "nl": [
      "Smakelijke zelfgemaakte burgers bereid met Charolais vlees, lokale kaas en knapperige zelfgemaakte frietjes. Een 100% verse en authentieke ervaring. Alles wordt ter plekke bereid om versheid en authenticiteit te garanderen.  Om mee te nemen."
    ],
    "es": [
      "Sabrosas hamburguesas caseras preparadas con carne Charolais, queso local y crujientes patatas fritas caseras. Una experiencia 100% fresca y auténtica. Todo se prepara in situ para garantizar la frescura y la autenticidad.  Para llevar."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Burger des volcans"
    ]
  },
