  "rdfs:comment": {
    "de": [
      "Als Fotografin, die sich auf Aufnahmen von Schwangeren, Familien und Kindern spezialisiert hat, biete ich persönliche Fotoshootings im Studio, im Freien oder bei Ihnen zu Hause an. Um einen runden Bauch oder ein verschmitztes Lächeln einzufangen, passe ich mich Ihren Wünschen an!"
    ],
    "en": [
      "As a photographer specialising in photos of pregnant women, families and children, I offer personalised photo sessions in the studio, on location or at home. Whether you want to capture a round belly or a mischievous smile, I'll adapt to your wishes!"
    ],
    "it": [
      "Come fotografa specializzata in scatti di donne incinte, famiglie e bambini, offro sessioni fotografiche personalizzate in studio, sul posto o a casa. Che vogliate immortalare un pancione o un sorriso birichino, mi adatterò ai vostri desideri!"
    ],
    "fr": [
      "Photographe spécialisée dans les clichés de femmes enceintes, familles et enfants, je propose des séances photos personnalisées en studio, en extérieur ou à domicile. Pour capturer un ventre rond ou un sourire malicieux, je m'adapte à vos envies !"
    ],
    "es": [
      "Como fotógrafa especializada en fotografías de embarazadas, familias y niños, ofrezco sesiones fotográficas personalizadas en estudio, en exteriores o a domicilio. Tanto si quieres captar una barriga redonda como una sonrisa traviesa, ¡me adaptaré a tus deseos!"
    ],
    "nl": [
      "Als fotograaf gespecialiseerd in foto's van zwangere vrouwen, gezinnen en kinderen, bied ik persoonlijke fotosessies in de studio, op locatie of thuis. Of je nu een bolle buik of een ondeugende lach wilt vastleggen, ik pas me aan je wensen aan!"
    ]
  },
  "rdfs:label": {
