  "rdfs:comment": {
    "de": [
      "Dieses renovierte Restaurant heißt Sie herzlich willkommen und bietet Ihnen eine traditionelle Küche. Spezialität: Kartoffelgratin mit Fourme de Montbrison."
    ],
    "en": [
      "The refurbished restaurant warmly welcomes you with its traditional cuisine. Specialty: potato gratin with Fourme de Montbrison cheese."
    ],
    "it": [
      "Il ristorante vi accoglie calorosamente. La sua cucina tradizionale e all'antica è meticolosa, abbondante, generosa, gustosa, gourmet e di alta qualità. Un menu vario con prodotti e fornitori locali. Un'ampia carta dei vini vi aspetta"
    ],
    "fr": [
      "Le restaurant vous accueille chaleureusement. Sa cuisine traditionnelle, d’antan, soignée, copieuse, généreuse, goûteuse, gourmande et de qualité. Une carte variée avec des produits du terroir et des fournisseurs locaux. Une large carte de vin vous attend"
    ],
    "nl": [
      "Het restaurant heet u hartelijk welkom. Zijn traditionele, ouderwetse keuken is nauwgezet, overvloedig, genereus, smakelijk, gastronomisch en van hoge kwaliteit. Een gevarieerd menu met lokale producten en leveranciers. Een grote wijnkaart wacht op u"
    ],
    "es": [
      "El restaurante le da una cálida bienvenida. Su cocina tradicional, a la antigua, es meticulosa, copiosa, generosa, sabrosa, gourmet y de gran calidad. Un menú variado con productos y proveedores locales. Una amplia carta de vinos le espera"
    ]
  },
