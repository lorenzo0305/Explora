  "rdfs:comment": {
    "de": [
      "Serge Pingrenon, ein Gemüsebauer, der sich seit 1987 im Weiler Crevecoeur niedergelassen hat, bietet Ihnen das ganze Jahr über Gemüse der Saison an."
    ],
    "en": [
      "Serge Pingrenon, market gardener settled in the hamlet of Crevecoeur since 1987, offers you seasonal vegetables all year round."
    ],
    "it": [
      "Serge Pingrenon, ortolano con sede nella frazione di Crevecoeur dal 1987, vi offre verdure di stagione tutto l'anno."
    ],
    "fr": [
      "Serge Pingrenon, maraîcher installé dans le hameau de Crevecoeur depuis 1987, vous propose tout au long de l'année des légumes de saison."
    ],
    "nl": [
      "Serge Pingrenon, tuinder in het gehucht Crevecoeur sinds 1987, biedt u het hele jaar door seizoensgroenten aan."
    ],
    "es": [
      "Serge Pingrenon, hortelano establecido en la aldea de Crevecoeur desde 1987, le ofrece verduras de temporada durante todo el año."
    ]
