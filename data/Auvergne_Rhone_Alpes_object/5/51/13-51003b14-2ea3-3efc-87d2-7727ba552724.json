  "rdfs:comment": {
    "de": [
      "BISTROT TO SHARE\r\nDas Bistrot Le C empfängt Sie für köstliche Momente in Courchevel Moriond, an der ersten Haltestelle der zentralen Rolltreppe, die zum Aquamotion hinunterführt."
    ],
    "en": [
      "BISTROT TO SHARE\r\nBistrot Le C is a restaurant, located at the first stop of the escalator going down to the Aquamotion."
    ],
    "it": [
      "BISTROT DA CONDIVIDERE\r\nIl Bistrot Le C vi accoglie per momenti deliziosi a Courchevel Moriond, alla prima fermata della scala mobile centrale che scende all'Aquamotion."
    ],
    "fr": [
      "BISTROT TO SHARE\r\nBistrot Le C vous accueille pour de délicieux moments à Courchevel Moriond, au premier arrêt de l’escalator central descendant à l’Aquamotion."
    ],
    "es": [
      "BISTROT PARA COMPARTIR\r\nBistrot Le C le da la bienvenida para momentos deliciosos en Courchevel Moriond, en la primera parada de la escalera mecánica central que baja al Aquamotion."
    ],
    "nl": [
      "BISTROT OM TE DELEN\r\nBistrot Le C verwelkomt je voor heerlijke momenten in Courchevel Moriond, bij de eerste halte van de centrale roltrap naar beneden naar de Aquamotion."
    ]
  },
