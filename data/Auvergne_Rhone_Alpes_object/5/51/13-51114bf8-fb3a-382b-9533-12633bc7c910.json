  "rdfs:comment": {
    "de": [
      "Die Reisenden in Drôme provençale, in der Nähe von Touristendörfern, in einem schönen Dorf in Ruhe lassen Sie sich im Familien-Hotel begrüssen."
    ],
    "en": [
      "Located in Drôme Provençale, near tourist villages, quiet in a charming village, Les Voyageurs welcomes you in their family hotel restaurant."
    ],
    "it": [
      "Situato nella Drôme Provençale, vicino ai villaggi turistici, nella pace e nella tranquillità di un incantevole villaggio, Les Voyageurs vi accoglie nel suo hotel ristorante a conduzione familiare."
    ],
    "fr": [
      "Situé en Drôme provençale, à proximité de villages touristiques, au calme dans un charmant village, Les Voyageurs vous accueillent dans leur hôtel restaurant familial."
    ],
    "es": [
      "Situado en la Drôme provenzal, cerca de los pueblos turísticos, en la tranquilidad de un pueblo encantador, Les Voyageurs le da la bienvenida a su hotel restaurante de gestión familiar."
    ],
    "nl": [
      "Gelegen in Drôme Provençale, in de buurt van toeristische dorpen, rustig in een charmant dorp, Les Voyageurs heet u welkom in hun familie hotel restaurant."
