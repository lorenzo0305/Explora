  "rdfs:comment": {
    "de": [
      "Gillons ist eine romanische Kapelle in unmittelbarer Nähe des Maison Forte de Clérivaux, in der heute Gästezimmer untergebracht sind.\r\nJahrhundert ein Benediktinerpriorat und wurde ab dem 14. Jahrhundert zur Pfarrkirche des Weilers Châtillon."
    ],
    "en": [
      "Gillons is a Romanesque chapel in the immediate vicinity of the Maison Forte de Clérivaux, which today houses bed & breakfast accommodation.\r\nA Benedictine priory in the 12th century, it became the parish church of the Hameau de Châtillon in the 14th century."
    ],
    "it": [
      "Gillons è una cappella romanica nelle immediate vicinanze della Maison Forte de Clérivaux, che oggi ospita camere per gli ospiti\r\nPriorato benedettino nel XII secolo, divenne la chiesa parrocchiale della frazione di Châtillon nel XIV secolo."
    ],
    "fr": [
      "Gillons est une Chapelle Romane à proximité immédiate de la Maison Forte de Clérivaux qui abrite aujourd'hui des chambres d'hôtes. \r\nPrieuré Bénédictin au XII siècle, elle devient église paroissiale du Hameau de Châtillon à partir du XIV siècle."
    ],
    "nl": [
      "Gillons is een Romaanse kapel in de onmiddellijke nabijheid van het Maison Forte de Clérivaux, dat tegenwoordig gastenkamers herbergt.\r\nHet was in de 12e eeuw een benedictijnse priorij en werd in de 14e eeuw de parochiekerk van het gehucht Châtillon."
    ],
    "es": [
      "Gillons es una capilla románica en las inmediaciones de la Maison Forte de Clérivaux, que hoy alberga habitaciones de huéspedes\r\nPriorato benedictino en el siglo XII, se convirtió en la iglesia parroquial de la aldea de Châtillon en el siglo XIV."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Chapelle de Gillons"
    ]
  },
