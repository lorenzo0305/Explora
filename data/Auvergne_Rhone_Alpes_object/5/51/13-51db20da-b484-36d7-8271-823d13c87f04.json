  "rdfs:comment": {
    "de": [
      "Zipline Lioran Express: ein Abenteuer für die ganze Familie!\r\nSind Sie bereit für ein gemeinsames Erlebnis? Ob allein oder zu zweit, lassen Sie sich auf 1200 Meter Abfahrt entlang des Baguet-Sessellifts fallen, im Sommer wie im Winter!"
    ],
    "en": [
      "Tyrolienne Lioran Express: a family adventure!\r\nReady for a great time together? Solo or in pairs, take to the skies for a 1,200-metre descent along the Baguet chairlift, summer or winter!"
    ],
    "it": [
      "Tyrolienne Lioran Express: un'avventura per tutta la famiglia!\r\nPronti a divertirvi insieme? Da soli o in coppia, salite in cielo per una discesa di 1.200 metri lungo la seggiovia Baguet, in estate o in inverno!"
    ],
    "fr": [
      "Tyrolienne Lioran Express : l’aventure à partager en famille !\r\nPrêt à vivre un grand moment tous ensemble ? En solo ou en duo, envolez-vous pour 1 200 mètres de descente le long du télésiège du Baguet, été comme hiver !"
    ],
    "nl": [
      "Tyrolienne Lioran Express: een gezinsavontuur!\r\nKlaar om samen een fantastische tijd te beleven? Alleen of met z'n tweeën, ga de lucht in voor een afdaling van 1200 meter met de stoeltjeslift Baguet, zomer of winter!"
    ],
    "es": [
      "Tyrolienne Lioran Express: ¡una aventura en familia!\r\n¿Listo para pasarlo en grande todos juntos? Solo o en pareja, surque los cielos en un descenso de 1.200 metros por el telesilla Baguet, ¡en verano o en invierno!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Tyrolienne Lioran Express"
    ]
  },
