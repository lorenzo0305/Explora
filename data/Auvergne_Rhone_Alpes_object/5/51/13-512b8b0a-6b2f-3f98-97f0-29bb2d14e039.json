  "rdfs:comment": {
    "de": [
      "Familienrestaurant, ein geselliger Ort zum Teilen, eingebettet im Herzen der Aravis. Probieren Sie die savoyischen Spezialitäten oder verbringen Sie einen schönen Moment in unserem Bar-Restaurant mit Blick auf die Berge."
    ],
    "en": [
      "A family-run restaurant, a friendly place for sharing, nestling in the heart of the Aravis mountains. Come and enjoy our Savoyard specialities or just have a good time in our bar-restaurant, facing the mountains."
    ],
    "it": [
      "Un ristorante a conduzione familiare, un luogo di condivisione amichevole, immerso nel cuore dei monti Aravis. Venite a gustare le nostre specialità savoiarde o semplicemente a divertirvi nel nostro bar-ristorante, di fronte alle montagne."
    ],
    "fr": [
      "Restaurant familial, lieu convivial et de partage, niché au cœur des Aravis. Venez déguster les spécialités savoyardes ou partager un bon moment dans notre bar-restaurant, face à la montagne."
    ],
    "es": [
      "Un restaurante familiar, un lugar agradable para compartir, enclavado en el corazón de los montes Aravis. Venga a degustar nuestras especialidades saboyanas o simplemente a pasar un buen rato en nuestro bar-restaurante, frente a las montañas."
    ],
    "nl": [
      "Een familierestaurant, een gezellige plek om te delen, genesteld in het hart van het Aravis-gebergte. Kom onze Savoyaardse specialiteiten proeven of geniet gewoon van de gezelligheid in ons bar-restaurant, met uitzicht op de bergen."
    ]
  },
