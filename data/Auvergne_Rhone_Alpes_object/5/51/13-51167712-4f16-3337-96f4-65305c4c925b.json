  "rdfs:comment": {
    "de": [
      "Eine echte lokale Institution am Flussufer. Entdecken Sie den Charme des Café Restaurant L'Ardenave. In der Küche werden frische, saisonale und qualitativ hochwertige Produkte verwendet und eine einfache, hausgemachte Speisekarte angeboten, die den Schwerpunkt auf regionale Aromen und Produkte legt."
    ],
    "en": [
      "A veritable local institution on the banks of the river, come and discover the charm of Café Restaurant L'Ardenave, where the cuisine is based on fresh, seasonal, quality produce and a simple menu that focuses on flavours and regional products."
    ],
    "it": [
      "Una vera e propria istituzione locale sulle rive del fiume, venite a scoprire il fascino del Café Restaurant L'Ardenave, che serve prodotti freschi, stagionali e di qualità e un menu semplice e casalingo che privilegia i sapori e i prodotti regionali."
    ],
    "fr": [
      "Véritable institution locale en bord de rivière, venez découvrir le charme du Café Restaurant L'Ardenave, en cuisine des produits frais, de saison et de qualité et une carte simple, faite maison, qui met l'accent sur les saveurs et les produits régionaux."
    ],
    "nl": [
      "Kom en ontdek de charme van Café Restaurant L'Ardenave, een echt plaatselijk instituut aan de oever van de rivier, waar verse seizoensproducten en kwaliteitsproducten worden geserveerd en waar een eenvoudig, huisgemaakt menu wordt geserveerd waarbij de nadruk ligt op smaken en regionale producten."
    ],
    "es": [
      "Auténtica institución local a orillas del río, venga a descubrir el encanto del Café Restaurant L'Ardenave, que sirve productos frescos, de temporada y de calidad y una carta sencilla y casera, centrada en los sabores y los productos regionales."
    ]
  },
