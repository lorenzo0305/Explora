  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/eeb539ea-b072-3ae3-960a-edcbddf0a1db",
      "dc:description": {
        "de": [
          "Erwecken Sie Ihre Sinne während der Woche des Dichterfrühlings. Das Thema 2025: Vulkanische Poesie!\nEntdecken Sie Workshops für Jung und Alt, vom Schreiben bis hin zur Gestaltung eines Vulkans aus Pappmaché!"
        ],
        "en": [
          "Come and awaken your sensibilities during Poets' Spring Week. The 2025 theme: Volcanic poetry!\nDiscover workshops for young and old, from writing to creating a papier-mâché volcano!"
        ],
        "it": [
          "Venite a risvegliare i vostri sensi durante la Settimana dei Poeti di Primavera. Tema del 2025: la poesia vulcanica!\nScoprite i laboratori per grandi e piccini, dalla scrittura alla creazione di un vulcano di cartapesta!"
        ],
        "fr": [
          "Venez éveiller votre sensibilité pendant la Semaine du Printemps des Poètes. Le thème 2025 : La poésie volcanique !\nDécouvrez des ateliers pour petits et grands, de l'écriture à la création d'un volcan en papier mâché !"
        ],
        "es": [
          "Venga a despertar sus sentidos durante la Semana de Primavera de los Poetas. El tema de 2025: ¡la poesía volcánica!\nDescubra talleres para grandes y pequeños, desde la escritura hasta la creación de un volcán de cartón piedra"
        ],
        "nl": [
          "Kom je zintuigen prikkelen tijdens de Poets Lente Week. Het thema van 2025: Vulkanische poëzie!\nOntdek workshops voor jong en oud, van schrijven tot het maken van een vulkaan van papier-maché!"
        ]
      },
