  "rdfs:comment": {
    "de": [
      "Ich kreiere lokale, originelle und gefüllte (salzige oder süße) Waffeln in Montbrison, Loire Forez und überall auf Anfrage.\r\nIch stelle die verschiedenen Waffelteige selbst her und backe sie vor Ihren Augen, bevor ich sie Ihnen serviere."
    ],
    "en": [
      "I create local, original and filled waffles (savory or sweet) in Montbrison, Loire Forez and anywhere else on request.\r\nI make the different waffle batters myself and bake them in front of you before serving them."
    ],
    "it": [
      "Creo waffle locali, originali e ripieni (salati o dolci) a Montbrison, Loire Forez e in qualsiasi altro luogo su richiesta.\r\nPreparo personalmente le diverse pastelle per i waffle e li cucino davanti a voi prima di servirli."
    ],
    "fr": [
      "Je crée des gaufres locales, originales et fourrées (salées ou sucrées) à Montbrison, dans Loire Forez et partout sur demande.\r\nJe fabrique moi-même les différentes pâtes à gaufres et les cuis devant vous avant de vous les servir."
    ],
    "nl": [
      "Ik maak lokale, originele en gevulde wafels (hartig of zoet) in Montbrison, Loire Forez en elders op aanvraag.\r\nIk maak de verschillende wafelbatsems zelf en bak ze voor je neus voordat ik ze serveer."
    ],
    "es": [
      "Elaboro gofres locales, originales y rellenos (salados o dulces) en Montbrison, Loire Forez y en cualquier otro lugar por encargo.\r\nYo mismo elaboro las diferentes masas de gofre y las cocino delante de usted antes de servirlas."
    ]
  },
