  "rdfs:comment": {
    "de": [
      "Ungewöhnliche und spielerische Fußwanderungen mit Lydie, Eselführerin und Wanderleiterin, und den Eseln Manouche, Ulcie... . Mit Animationen und Erzählungen teilt Lydie ihr Wissen über Esel und die Natur. Für jedes Publikum geeignet. Halber Tag und Aufenthalt auf Wanderschaft."
    ],
    "en": [
      "Unusual and fun walking tours with Lydie, donkey-trekking leader, and the donkeys Manouche, Ulcie... . With activities and stories, Lydie shares her knowledge of donkeys and nature. All ages. Half-day and full-day tours."
    ],
    "it": [
      "Passeggiate insolite e giocose con Lydie, asinaio, e gli asini Manouche e Ulcie? Con animazioni e racconti, Lydie condivide la sua conoscenza degli asini e della natura. Per il pubblico in generale. Tour di mezza giornata e di una giornata intera."
    ],
    "fr": [
      "Balades à pied insolites et ludiques avec Lydie, ânière-animatrice de randonnée et les ânes Manouche, Ulcie… . Avec des animations et des contes, Lydie partage sa connaissance des ânes, de la nature. Tout public. Demi-journée et séjour en itinérance."
    ],
    "es": [
      "Paseos insólitos y juguetones con Lydie, burrera y los burros Manouche, Ulcie? Con animaciones y cuentos, Lydie comparte sus conocimientos sobre los burros y la naturaleza. Para el público en general. Visitas de medio día y de día completo."
    ],
    "nl": [
      "Ongewone en leuke wandelingen met Lydie, ezeltrekleidster, en de ezels Manouche, Ulcie... . Met activiteiten en verhalen deelt Lydie haar kennis over ezels en de natuur. Alle leeftijden. Halve dagtochten en dagtochten."
    ]
  },
