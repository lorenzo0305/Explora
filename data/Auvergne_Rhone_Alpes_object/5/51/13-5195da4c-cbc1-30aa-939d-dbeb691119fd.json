  "rdfs:comment": {
    "de": [
      "Ein Ort zum Entdecken, Gegenstände aus dem Alltag unserer Großeltern, für Groß und Klein! Der Konservator des Ortes stellt Ihnen mit viel Freude und Anekdoten die Berufe von früher und die dazugehörigen Gebrauchsgegenstände vor."
    ],
    "en": [
      "A place to discover, objects from the daily lives of our grandparents, for young and old alike! The curator will be delighted to tell you all about the trades of yesteryear and the objects used in them."
    ],
    "it": [
      "Un luogo da scoprire, oggetti della vita quotidiana dei nostri nonni, per grandi e piccini! È con grande piacere che il curatore del luogo vi presenterà, con tanti aneddoti, i mestieri del passato e gli oggetti abituali ad essi legati."
    ],
    "fr": [
      "Lieu à découvrir, objets du quotidien de nos grands parents, pour petits et grands ! C 'est avec grand plaisir que le conservateur des lieux vous présentera avec plein d'anecdotes les métiers d'autrefois et les objets usuels s'y rapportant."
    ],
    "es": [
      "Un lugar para descubrir, objetos de la vida cotidiana de nuestros abuelos, ¡para grandes y pequeños! Con gran placer, el conservador del lugar les presentará, con muchas anécdotas, los oficios del pasado y los objetos habituales relacionados con ellos."
    ],
    "nl": [
      "Een plek om te ontdekken, voorwerpen uit het dagelijks leven van onze grootouders, voor jong en oud! Het is met groot genoegen dat de conservator van de plaats u, met veel anekdotes, de ambachten uit het verleden en de gebruikelijke voorwerpen die daarmee verband houden, zal presenteren."
    ]
  },
  "rdfs:label": {
