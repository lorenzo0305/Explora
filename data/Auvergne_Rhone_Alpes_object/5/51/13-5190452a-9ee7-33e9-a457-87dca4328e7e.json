  "rdfs:comment": {
    "de": [
      "Dominique Bourrin, Winzer und Obstbauer, bewirtschaftet 6 ha Weinanbaufläche der Bezeichnungen Condrieu und Saint-Joseph, welche er direkt an den Verbraucher verkauft,..."
    ],
    "en": [
      "Dominique Bourrin, winemaker and grower cultivates 6 hectares of vines in AOC Condrieu and Saint-Joseph. He sells his own wines as well as Pilat apples (14 varieties) and other regional products from his property."
    ],
    "it": [
      "Alexis e Florian Bourrin, arboricoltori e viticoltori, coltivano 7 ettari di viti nelle zone di Condrieu e Saint-Joseph, che vendono nella tenuta, oltre a mele della regione di Pilat."
    ],
    "fr": [
      "Alexis et Florian Bourrin, arboriculteurs et vignerons, cultivent 7 ha de vignes en aire d'appellation Condrieu et Saint-Joseph qu'ils vendent à la propriété ainsi que des pommes du Pilat."
    ],
    "es": [
      "Alexis y Florian Bourrin, arboricultores y viticultores, cultivan 7 hectáreas de viñas en las zonas de denominación Condrieu y Saint-Joseph, que comercializan en la finca, así como manzanas de la región de Pilat."
    ],
    "nl": [
      "Alexis en Florian Bourrin, boomkwekers en wijnbouwers, cultiveren 7 hectare wijngaarden in de Condrieu en Saint-Joseph appellation gebieden, die ze verkopen op het landgoed, evenals appels uit de Pilat regio."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Saveurs du Terroir"
    ]
  },
