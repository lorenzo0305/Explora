  "rdfs:comment": {
    "de": [
      "Das Atelier Maga verbindet kunstvolle Intarsienarbeiten mit vegetarischer Küche im Herzen von Chambéry. Ein herzlicher Ort, an dem Kreation, Austausch und Gaumenfreuden auf der Grundlage nachhaltiger und lokaler Werte vereint werden."
    ],
    "en": [
      "Atelier Maga blends art marquetry and vegetarian cuisine in the heart of Chambéry. A warm place where creation, sharing and gourmet delights come together around sustainable, local values."
    ],
    "it": [
      "L'Atelier Maga unisce intarsio artistico e cucina vegetariana nel cuore di Chambéry. È un luogo accogliente dove la creatività, la condivisione e le delizie gastronomiche si fondono su valori sostenibili e locali."
    ],
    "fr": [
      "L’Atelier Maga mêle marqueterie d’art et cuisine végétarienne au cœur de Chambéry. Un lieu chaleureux où création, partage et gourmandise s’unissent autour de valeurs durables et locales."
    ],
    "nl": [
      "Atelier Maga combineert inlegwerk en vegetarische gerechten in het hart van Chambéry. Het is een gastvrije plek waar creativiteit, delen en gastronomisch genieten samenkomen rond duurzame, lokale waarden."
    ],
    "es": [
      "Atelier Maga combina el arte de la marquetería y la cocina vegetariana en el corazón de Chambéry. Es un lugar acogedor donde la creatividad, el compartir y las delicias gourmet se unen en torno a valores sostenibles y locales."
    ]
  },
  "rdfs:label": {
    "fr": [
