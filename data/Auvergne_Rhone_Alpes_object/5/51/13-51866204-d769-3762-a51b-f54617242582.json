  "rdfs:comment": {
    "de": [
      "Das Bistrot de la Place bietet Ihnen eine traditionelle und regionale Küche. Hier können Sie Menüs aus frischen und lokalen Produkten genießen."
    ],
    "en": [
      "Le Bistrot de la Place offers traditional, local cuisine. Enjoy menus based on fresh local produce."
    ],
    "it": [
      "Il Bistrot de la Place propone una cucina tradizionale e locale. Potrete gustare menù a base di prodotti freschi locali."
    ],
    "fr": [
      "Le Bistrot de la Place vous propose une cuisine traditionnelle et de terroir. Vous pourrez y déguster des menus à base de produits frais et locaux."
    ],
    "es": [
      "El Bistrot de la Place sirve cocina local tradicional. Podrá disfrutar de menús basados en productos locales frescos."
    ],
    "nl": [
      "De Bistrot de la Place serveert traditionele, lokale gerechten. Je kunt genieten van menu's op basis van verse lokale producten."
    ]
  },
