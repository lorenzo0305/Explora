  "rdfs:comment": {
    "de": [
      "Der botanische Garten, ein lebendiges Museum der Pflanze, umschließt auf 8 ha eine der reichsten Sammlungen Europas, 15 000 Pflanzenarten. In verschiedenen Gewächshäusern werden etwa 6.000 Arten bewahrt, auf 6 ha ist er der größte Komplex Frankreichs..."
    ],
    "en": [
      "The 8 ha botanical garden, a living plant museum, contains one of the richest collections in Europe, including 15,000 species of plants. Different greenhouses are used to keep approx. 6000 species. Covering 6 ha, it's the biggest complex in France."
    ],
    "it": [
      "Il giardino botanico, un museo vivente delle piante, si estende su 8 ettari e contiene una delle collezioni più ricche d'Europa, con 15.000 specie vegetali. Diverse serre permettono la conservazione di circa 6.000 specie, su 6 ettari è la più grande collezione in Francia..."
    ],
    "fr": [
      "Le jardin botanique, musée vivant de la plante, sur 8 ha, enferme une des plus riches collections d'Europe, 15 000 espèces végétales. Différentes serres permettent de préserver environ 6 000 espèces, sur 6 ha c'est le plus grand ensemble de France..."
    ],
    "es": [
      "El jardín botánico, un museo vivo de plantas, ocupa 8 hectáreas y contiene una de las colecciones más ricas de Europa, con 15.000 especies de plantas. Diferentes invernaderos permiten la conservación de unas 6.000 especies, en 6 ha es la mayor colección de Francia..."
    ],
    "nl": [
      "De botanische tuin, een levend museum van planten, beslaat 8 hectare en bevat een van de rijkste collecties van Europa, met 15.000 plantensoorten. Verschillende kassen maken het behoud van ongeveer 6.000 soorten mogelijk, op 6 ha is het de grootste collectie in Frankrijk..."
    ]
  },
  "rdfs:label": {
