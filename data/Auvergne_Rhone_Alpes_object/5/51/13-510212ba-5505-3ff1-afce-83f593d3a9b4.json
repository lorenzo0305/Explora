  "rdfs:comment": {
    "de": [
      "Traditionelle Küche und savoyische Spezialitäten à la carte und Traiteur, einfach und authentisch, hausgemacht, wo sich savoyische Spezialitäten und traditionelle Gerichte begegnen. Sonnenterrasse mit Blick auf das Dorf."
    ],
    "en": [
      "Traditional cuisine and Savoyard specialties, à la carte and catered, simple and authentic, homemade, where Savoyard specialties and traditional dishes meet. Sunny terrace open onto the village."
    ],
    "it": [
      "Cucina tradizionale e specialità savoiarde alla carta e ristorazione, semplice e autentica, fatta in casa, dove si combinano specialità savoiarde e piatti tradizionali. Terrazza soleggiata con vista sul villaggio."
    ],
    "fr": [
      "Cuisine traditionnelle et spécialités savoyardes à la carte et traiteur, simple et authentique, faite maison, où se côtoient spécialités savoyardes et plats traditionnels. Terrasse ensoleillée ouverte sur le village."
    ],
    "nl": [
      "Traditionele keuken en Savoyaardse specialiteiten à la carte en catering, eenvoudig en authentiek, huisgemaakt, waar Savoyaardse specialiteiten en traditionele gerechten worden gecombineerd. Zonnig terras met uitzicht op het dorp."
    ],
    "es": [
      "Cocina tradicional y especialidades saboyanas a la carta y catering, sencillo y auténtico, casero, donde se combinan las especialidades saboyanas y los platos tradicionales. Terraza soleada con vistas al pueblo."
    ]
  },
  "rdfs:label": {
