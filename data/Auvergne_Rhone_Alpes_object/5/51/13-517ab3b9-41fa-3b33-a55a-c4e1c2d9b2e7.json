  "rdfs:comment": {
    "de": [
      "Ô Bon Bec erfindet die klassische Küche neu, um Ihnen ein einzigartiges Erlebnis zu bieten. Die Wein-, Käse-, Wurst- und Fleischkeller mit gereiftem Fleisch werden von einer Speisekarte begleitet, die einem das Wasser im Mund zusammenlaufen lässt, und das alles zu einem Live-DJ-Set am Abend"
    ],
    "en": [
      "Ô Bon Bec reinvents classic cuisine to give you an experience of your own. The wine, cheese, charcuterie and matured meat cellars are accompanied by a mouth-watering menu, all set to a live DJ set."
    ],
    "it": [
      "Ô Bon Bec reinventa la cucina classica per un'esperienza unica. Le cantine di vini, formaggi, salumi e carni stagionate sono accompagnate da un menù da leccarsi i baffi, il tutto accompagnato da un DJ live set la sera"
    ],
    "fr": [
      "Ô Bon Bec réinvente la cuisine classique pour vous faire vivre une expérience unique. Les caves à vin, à fromages, à charcuteries et viandes maturées sont accompagnées par une carte qui met l’eau à la bouche, le tout sur fond de DJ Live Set le soir"
    ],
    "nl": [
      "Ô Bon Bec vindt de klassieke keuken opnieuw uit voor een unieke ervaring. De wijn-, kaas-, vleeswaren- en rijpingskelders gaan vergezeld van een overheerlijk menu, 's avonds begeleid door een live DJ-set"
    ],
    "es": [
      "Ô Bon Bec reinventa la cocina clásica para ofrecer una experiencia única. Las bodegas de vinos, quesos, embutidos y carnes maduradas se acompañan de un apetitoso menú, todo ello ambientado por la noche con un DJ en directo"
    ]
  },
