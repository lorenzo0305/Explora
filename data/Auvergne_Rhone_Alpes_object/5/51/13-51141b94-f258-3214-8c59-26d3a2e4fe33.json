  "rdfs:comment": {
    "de": [
      "Der Wellnessbereich des Château d'Origny umfasst ein Spa mit beheiztem Pool, Sauna, Hammam, Jacuzzi, Sinnesdusche und Räumen für Massagen und Körper- und Gesichtsbehandlungen. Modelage"
    ],
    "en": [
      "Château d'Origny wellness area featuring a spa with heated pool, sauna, steam room, Jacuzzi, sensory shower and massage and body and facial treatment rooms. Modelage"
    ],
    "it": [
      "L'area benessere dello Château d'Origny comprende una spa con piscina riscaldata, sauna, bagno turco, idromassaggio, doccia sensoriale, sale massaggi e trattamenti per il corpo e il viso. Modellazione"
    ],
    "fr": [
      "Espace bien-être du château d’Origny comprenant un spa avec piscine chauffée, sauna, hammam, jacuzzi, douche sensorielle et salles de massage et soins du corps-visage. Modelage"
    ],
    "es": [
      "La zona de bienestar del Château d'Origny incluye un spa con piscina climatizada, sauna, baño de vapor, jacuzzi, ducha sensorial, salas de masaje y tratamientos corporales y faciales. Modelado"
    ],
    "nl": [
      "De wellnessruimte van Château d'Origny omvat een spa met verwarmd zwembad, sauna, stoombad, jacuzzi, zintuiglijke douche, massageruimtes en lichaams- en gezichtsbehandelingen. Modellering"
    ]
  },
