  "rdfs:comment": {
    "de": [
      "Schule, Elektro-Mountainbike-Laden und -Verleih, Reparaturwerkstatt. Verkauf von gebrauchten und neuen Fahrrädern, persönliche Beratung, Familienpaket. Ihre 100 % Mountainbike-Struktur, ganzjährig geöffnet, Lieferung an den Ort Ihrer Wahl."
    ],
    "en": [
      "School, electric mountain bike store and rental, repair workshop. Sale of used and new bicycles, personalized advice, family pack. Your 100% mountain bike structure open all year round, delivery to the location of your choice."
    ],
    "it": [
      "Scuola, negozio e noleggio di mountain bike elettriche, officina di riparazione. Vendita di biciclette usate e nuove, consulenza personalizzata, pacchetto famiglia. Il vostro centro di mountain bike al 100% aperto tutto l'anno, con consegna nel luogo di vostra scelta."
    ],
    "fr": [
      "École, magasin et location de VTT électrique, atelier réparation. Vente vélos d'occasion et neuf, conseils personnalisés, pack famille. Votre structure 100% VTT ouverte toute l'année, livraison sur le lieu de votre choix."
    ],
    "nl": [
      "School, winkel en verhuur van elektrische mountainbikes, reparatiewerkplaats. Gebruikte en nieuwe fietsen te koop, persoonlijk advies, familiepakket. Jouw 100% mountainbikecentrum het hele jaar geopend, met levering op de locatie van jouw keuze."
    ],
    "es": [
      "Escuela, tienda y alquiler de bicicletas eléctricas de montaña, taller de reparación. Venta de bicicletas usadas y nuevas, asesoramiento personalizado, pack familiar. Tu centro BTT 100% abierto todo el año, con entrega en el lugar que elijas."
    ]
  },
