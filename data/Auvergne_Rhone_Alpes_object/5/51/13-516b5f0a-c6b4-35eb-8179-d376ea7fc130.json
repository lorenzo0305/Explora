  "rdfs:comment": {
    "de": [
      "Vom berühmten Mont Gerbier-de-Jonc aus wandern Sie abwechselnd durch Wälder und über grüne Weiden bis zum Dorf Sainte-Eulalie, vorbei an den Seen von Issarlès und La Palisse."
    ],
    "en": [
      "Starting from the famous Mont Gerbier-de-Jonc, the route alternates between forest paths and crossings of lush green pastures, leading you to the village of Sainte-Eulalie via Lake Issarlès and Lake La Palisse."
    ],
    "it": [
      "Partendo dal famoso Mont Gerbier-de-Jonc, il percorso alterna boschi e pascoli verdi per raggiungere il villaggio di Sainte-Eulalie attraverso i laghi di Issarlès e La Palisse."
    ],
    "fr": [
      "Au départ du célèbre Mont Gerbier-de-Jonc, vous alternez entre passages en forêts et traversées de verts pâturages, pour rejoindre le village de Sainte-Eulalie en passant par les lacs d’Issarlès et de La Palisse."
    ],
    "nl": [
      "Vanaf de beroemde Mont Gerbier-de-Jonc loopt de route afwisselend door bossen en groene weiden om via de meren van Issarlès en La Palisse het dorp Sainte-Eulalie te bereiken."
    ],
    "es": [
      "Partiendo del famoso Mont Gerbier-de-Jonc, la ruta alterna bosques y verdes praderas para llegar al pueblo de Sainte-Eulalie a través de los lagos de Issarlès y La Palisse."
    ]
  },
