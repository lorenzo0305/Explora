      "dc:description": {
        "de": [
          "Wir haben uns auf Pizzeria spezialisiert und bieten Lieferservice, Mitnahme und Vor-Ort-Service an. Wir liefern bis zu 17 km um Marseille en Beauvaisis herum."
        ],
        "en": [
          "Specialized in pizzeria, we offer delivery, takeaway and on site service. We deliver up to 17 km around Marseille en Beauvaisis."
        ],
        "it": [
          "Siamo specializzati in pizzeria e offriamo servizi di consegna, take-away e in loco. Consegniamo fino a 17 km intorno a Marsiglia a Beauvaisis."
        ],
        "fr": [
          "Activité spécialisée dans la pizzeria, nous proposons le service en livraison, emporté et sur place. Nous livrons jusqu’à 17 km autour de Marseille en Beauvaisis."
        ],
        "nl": [
          "Wij zijn gespecialiseerd in pizzeria, en bieden bezorging, take-away en diensten ter plaatse. Wij leveren tot 17 km rond Marseille en Beauvaisis."
        ],
        "es": [
          "Estamos especializados en pizzerías y ofrecemos servicios de entrega, comida para llevar y a domicilio. Entregamos hasta 17 km alrededor de Marsella en Beauvaisis."
        ]
      },
