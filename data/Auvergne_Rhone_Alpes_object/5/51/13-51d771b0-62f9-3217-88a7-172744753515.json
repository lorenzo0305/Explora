  "rdfs:comment": {
    "de": [
      "Willkommen auf dem Heritage-Orientierungslauf in Valezan! Entdecken Sie die Authentizität dieses kleinen Dorfes und seinen Panoramablick.\r\nEine leichte Strecke von 1,6 km mit 100mD+ und seinen 6 Markierungen."
    ],
    "en": [
      "Welcome to the orienteering course focusing on the heritage of Valezan! Discover this traditional little village and its panoramic view.\r\nAn easy course of 1.6km and 100m elevation gain, with 6 markers."
    ],
    "it": [
      "Benvenuti al corso di orientamento sul patrimonio Valezan! Scoprite l'autenticità di questo piccolo villaggio e la sua vista panoramica.\r\nUn percorso facile di 1,6 km con 100mD+ e i suoi 6 marcatori."
    ],
    "fr": [
      "Bienvenue sur le parcours d'orientation patrimoine de Valezan ! Découvrez l'authenticité de ce petit village et de sa vue panoramique.\r\nUn parcours facile de 1,6km avec 100mD+ et ses 6 balises."
    ],
    "es": [
      "¡Bienvenido al curso de orientación sobre el patrimonio de Valezan! Descubra la autenticidad de este pequeño pueblo y su vista panorámica.\r\nUn recorrido fácil de 1,6km con 100mD+ y sus 6 balizas."
    ],
    "nl": [
      "Welkom op het oriëntatieparcours van het erfgoed van Valezan! Ontdek de authenticiteit van dit kleine dorp en zijn panoramische uitzichten.\r\nEen gemakkelijke route van 1,6 km met 100 m+ en 6 waypoints."
    ]
  },
  "rdfs:label": {
    "de": [
      "Orientierungslauf Erbgut von Valezan - grüner Parcours"
    ],
    "en": [
      "Orienteering course - Heritage of Valezan - green level"
    ],
    "fr": [
      "Parcours d'orientation Patrimoine de Valezan - parcours vert"
    ],
    "nl": [
      "Valezan erfgoed oriëntatieloop - groene route"
    ]
  },
