  "rdfs:comment": {
    "de": [
      "Ein Bestand von 14.000 Dokumenten: Romane, Dokumentarfilme, Ratgeber, Comics, Mangas, Jugendbücher, Zeitschriften, DVDs, CDs\r\nZahlreiche Ausstellungen\r\nVerschiedene Animationen: Märchenlesungen, musikalische Früherziehung, Filmvorführungen, Theater- und Schreibworkshops..."
    ],
    "en": [
      "A collection of 14,000 documents: novels, documentaries, guides, comics, manga, children’s books, magazines, DVDs, CDs\r\nMany exhibitions \r\nVaried animations: Readings of tales, musical awakening, film projections, theater workshops, writing..."
    ],
    "it": [
      "Una collezione di 14.000 documenti: romanzi, documentari, guide, fumetti, manga, libri per bambini, riviste, DVD, CD, ecc\r\nNumerose mostre\r\nUn'ampia gamma di attività: Letture di storie, educazione musicale precoce, proiezioni di film, laboratori teatrali e di scrittura, ecc."
    ],
    "fr": [
      "Un fonds de 14.000 documents : romans, documentaires, guides, BD, mangas, livres jeunesse, revues, DVD, CD\r\nDe nombreuses expositions \r\nDes animations variées : Lectures de contes, éveil musical, projections de films, ateliers de théâtre, d'écriture..."
    ],
    "es": [
      "Una colección de 14.000 documentos: novelas, documentales, guías, cómics, manga, libros infantiles, revistas, DVD, CD, etc\r\nNumerosas exposiciones\r\nUn amplio abanico de actividades: Lecturas de cuentos, educación musical, proyecciones de películas, talleres de teatro y escritura, etc."
    ],
    "nl": [
      "Een collectie van 14.000 documenten: romans, documentaires, reisgidsen, strips, manga, kinderboeken, tijdschriften, dvd's, cd's, enz\r\nTalrijke tentoonstellingen\r\nEen breed scala aan activiteiten: Verhalenlezingen, vroeg muziekonderwijs, filmvertoningen, theater- en schrijfworkshops, enz."
    ]
  },
