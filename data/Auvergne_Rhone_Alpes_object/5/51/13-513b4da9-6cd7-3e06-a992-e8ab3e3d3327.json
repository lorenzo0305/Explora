  "rdfs:comment": {
    "de": [
      "Freie Besichtigung das ganze Jahr über mit Touristenplan oder geführte Besichtigung auf Anfrage. Ihr Fremdenführer stellt sich vor... Verneuil zur Zeit der Bourbonen, die das Dorf zum Sitz einer der 17 Châtellenies des Bourbonnais machten."
    ],
    "en": [
      "Free visit all year with a tourist map or guided tour upon request. Your guide imagines… Verneuil at the Bourbons' time, who established in the village one of the 17 Bourbonnais castellanies."
    ],
    "it": [
      "Visita libera tutto l'anno con mappa turistica o visita guidata su richiesta. La guida immagina... Verneuil all'epoca dei Borboni che fecero del villaggio la sede di una delle 17 castellerie del Bourbonnais."
    ],
    "fr": [
      "Visite libre toute l'année avec plan touristique ou visite guidée sur demande. Votre guide imagine... Verneuil au temps des Bourbons qui firent du village le siège de l'une des 17 châtellenies du Bourbonnais."
    ],
    "nl": [
      "Vrij bezoek het hele jaar door met toeristische kaart of rondleiding op aanvraag. Je gids stelt zich voor... Verneuil ten tijde van de Bourbons die het dorp tot zetel van een van de 17 kastelen van de Bourbonnais maakten."
    ],
    "es": [
      "Visita gratuita durante todo el año con mapa turístico o visita guiada a petición. Su guía imagina... Verneuil en la época de los Borbones, que hicieron del pueblo la sede de uno de los 17 castillos del Bourbonnais."
    ]
  },
