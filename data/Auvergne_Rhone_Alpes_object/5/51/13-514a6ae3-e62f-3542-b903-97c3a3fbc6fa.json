  "rdfs:comment": {
    "de": [
      "Tauchen Sie in eine gesellige Atmosphäre ein und erleben Sie drei außergewöhnliche Abende (Dienstag, Mittwoch und Donnerstag), an denen die Komödie im Mittelpunkt steht, mit einem abwechslungsreichen Programm aus One-Man-Shows, Theater, Zauberei und Illusionen."
    ],
    "en": [
      "Immerse yourself in a convivial atmosphere with three exceptional evenings (Tuesday, Wednesday and Thursday) where comedy takes centre stage, with a varied programme combining one-man shows, theatre, magic and illusions."
    ],
    "it": [
      "Immergetevi in un'atmosfera conviviale con tre serate di spettacoli eccezionali (martedì, mercoledì e giovedì) in cui le risate sono all'ordine del giorno. Un programma vario che combina one-man show, teatro, magia e illusioni."
    ],
    "fr": [
      "Plongez dans une ambiance conviviale avec trois soirées de spectacles exceptionnels (mardi, mercredi et jeudi) où le rire est à l'honneur. Avec une programmation variée alliant one man show, théâtre, magie et illusions."
    ],
    "es": [
      "Sumérjase en un ambiente cordial con tres veladas de espectáculos excepcionales (martes, miércoles y jueves) donde la risa está a la orden del día. Con un programa variado que combina espectáculos unipersonales, teatro, magia e ilusionismo."
    ],
    "nl": [
      "Dompel je onder in een gezellige sfeer met drie uitzonderlijke avonden (dinsdag, woensdag en donderdag) waar komedie centraal staat, met een gevarieerd programma dat one-man shows, theater, magie en illusies combineert."
    ]
  },
