  "rdfs:comment": {
    "de": [
      "Die Mediathek L'Oiseau Lire in St-Marcel-lès-Valence, das sind 13.000 Bücher und DVDs zum Ausleihen, Räume zum Entspannen und Arbeiten, Veranstaltungen das ganze Jahr über und ein Team, das Ihnen gerne zuhört. Wir freuen uns darauf, Sie bald begrüßen zu dürfen!"
    ],
    "en": [
      "The l'Oiseau Lire media library in St-Marcel-lès-Valence offers 13,000 books and DVDs for borrowing, relaxation and work areas, year-round activities and a team ready to listen. We look forward to welcoming you soon!"
    ],
    "it": [
      "La biblioteca multimediale L'Oiseau Lire di St-Marcel-lès-Valence dispone di 13.000 libri e DVD da prendere in prestito, spazi per rilassarsi e lavorare, eventi durante tutto l'anno e un team pronto ad ascoltare. Non vediamo l'ora di darvi il benvenuto!"
    ],
    "fr": [
      "La médiathèque L'Oiseau lire à St-Marcel-lès-Valence, c'est 13.000 ouvrages et DVD à emprunter, des espaces de détente et de travail, des animations tout au long de l'année et une équipe à votre écoute. Au plaisir de vous accueillir !"
    ],
    "es": [
      "La mediateca L'Oiseau Lire de St-Marcel-lès-Valence dispone de 13.000 libros y DVD en préstamo, espacios de descanso y de trabajo, eventos durante todo el año y un equipo dispuesto a escucharle. ¡Le esperamos!"
    ],
    "nl": [
      "De mediatheek l'Oiseau Lire in St-Marcel-lès-Valence heeft 13.000 boeken en dvd's om te lenen, ruimtes om te ontspannen en te werken, het hele jaar door evenementen en een team dat klaarstaat om naar je te luisteren. We kijken ernaar uit u binnenkort te verwelkomen!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Médiathèque L'Oiseau Lire"
    ]
  },
