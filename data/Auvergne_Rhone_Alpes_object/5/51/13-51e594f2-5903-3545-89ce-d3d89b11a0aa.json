  "rdfs:comment": {
    "de": [
      "Im Herzen des Regionalen Naturparks Vercors, auf 1000 m Höhe, züchten Amandine und Théo Lacaune- und Merinoschafe."
    ],
    "en": [
      "In the heart of the Vercors Regional Natural Park, at 1,000m high, Amandine and Théo raise Lacaune and Merino sheep."
    ],
    "it": [
      "Nel cuore del Parco Naturale Regionale del Vercors, a 1000 m di altitudine, la fattoria familiare à la crecia alleva pecore Lacaune e Merino, oltre a maiali, per trasformare e offrire prodotti a base di latte di pecora, agnello e maiale."
    ],
    "fr": [
      "En plein cœur du Parc Naturel Régional du Vercors, à 1000m d'altitude, la ferme familiale à la crecia, élèvent des Brebis Lacaune et Mérinos ainsi que des porcs , pour transformer et proposer produits laitiers de brebis, viande d'agneau et de porc."
    ],
    "nl": [
      "In het hart van het Regionale Natuurpark van de Vercors, op een hoogte van 1000m, fokt de familieboerderij à la crecia Lacaune en Merino ooien en varkens, om schapenmelkproducten, lamsvlees en varkensvlees te verwerken en aan te bieden."
    ],
    "es": [
      "En el corazón del Parque Natural Regional de Vercors, a 1000 m de altitud, la granja familiar à la crecia cría ovejas Lacaune y Merino, así como cerdos, para transformar y ofrecer productos de leche de oveja, cordero y cerdo."
    ]
  },
  "rdfs:label": {
    "de": [
      "Ferme à la Crécia"
    ],
    "en": [
      "Ferme à la Crécia"
    ],
