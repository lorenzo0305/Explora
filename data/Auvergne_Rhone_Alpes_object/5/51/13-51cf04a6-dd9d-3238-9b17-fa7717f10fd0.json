  "rdfs:comment": {
    "de": [
      "Handwerkliche Mikrobrauerei seit 2016. Ethische Biere für jeden Geschmack. Die Brauerei befindet sich in Champs Libres, einem Ort mit mehreren landwirtschaftlichen Aktivitäten, Erzeugerladen und Veranstaltungsort. Organisation von Besichtigungen und Verkostungen für Gruppen."
    ],
    "en": [
      "Craft microbrewery with Nature & Progrès label\r\nLocated at Champs Libres in Lablachère."
    ],
    "it": [
      "Microbirrificio artigianale dal 2016. Birre etiche per tutti i gusti. Birrificio situato agli Champs Libres, un sito agricolo multiattività, negozio di produttori e spazio per eventi. Visite e degustazioni organizzate per gruppi."
    ],
    "fr": [
      "Microbrasserie artisanale depuis 2016. Bières éthiques pour tous les goûts. Brasserie implantée à Champs Libres, lieu de polyactivités agricoles, magasin de producteurs et espace d’événements. Organisation de visites et dégustations pour les groupes."
    ],
    "es": [
      "Microcervecería artesanal desde 2016. Cervezas éticas para todos los gustos. Cervecería situada en Champs Libres, un emplazamiento agrícola multiactividades, tienda de productores y espacio para eventos. Visitas y degustaciones organizadas para grupos."
    ],
    "nl": [
      "Ambachtelijke microbrouwerij sinds 2016. Ethische bieren voor elke smaak. De brouwerij is gevestigd op Champs Libres, een multifunctionele landbouwlocatie, een winkel voor producenten en een ruimte voor evenementen. Rondleidingen en proeverijen voor groepen."
    ]
  },
