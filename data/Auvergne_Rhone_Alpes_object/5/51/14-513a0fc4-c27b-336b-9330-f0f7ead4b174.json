      "dc:description": {
        "de": [
          "Kleines, sympathisches, familienfreundliches Restaurant, das für seine köstlichen Fish and Chips bekannt ist.\nAndere Produkte auf der Speisekarte sind zu entdecken, Wels, Muscheln...."
        ],
        "en": [
          "Small, friendly, family-run restaurant known for its succulent fish and chips.\nOther à la carte products include welshs and mussels...."
        ],
        "it": [
          "Un piccolo e accogliente ristorante a conduzione familiare noto per il suo succulento fish and chips.\nTra gli altri prodotti à la carte figurano il welsh e le cozze...."
        ],
        "fr": [
          "Petit restaurant sympatique, familial, connu pour ses succulents Fish and Chips.\nD'autres produits à la carte sont à venir découvrir, les welshs, les moules...."
        ],
        "es": [
          "Un pequeño y acogedor restaurante familiar conocido por su suculento fish and chips.\nOtros productos a la carta son los galeses y los mejillones...."
        ],
        "nl": [
          "Een klein, vriendelijk familierestaurant dat bekend staat om zijn sappige fish and chips.\nAndere à la carte producten zijn onder andere welsh en mosselen...."
        ]
      },
