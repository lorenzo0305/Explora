  "rdfs:comment": {
    "de": [
      "Die Domaine du Château de la Rive wird exklusiv für Ihre privaten oder geschäftlichen Veranstaltungen vermietet: Hochzeiten, Geburtstage, Cocktailpartys, Familienessen, Versammlungen, Seminare, Teambuiding. Unser Küchenchef Aurélien Poncet verwöhnt Ihre Gäste!"
    ],
    "en": [
      "The château de la Rive is an exceptional place to organise your receptions. Weddings, cocktails, family dinners, meetings, seminaries, commercial introductions."
    ],
    "it": [
      "Il Domaine du Château de la Rive è disponibile esclusivamente per eventi privati o aziendali: matrimoni, compleanni, cocktail party, pranzi in famiglia, riunioni, seminari e teambuilding. Il nostro chef Aurélien Poncet delizierà i vostri ospiti!"
    ],
    "fr": [
      "Le Domaine du Château de la Rive est loué en exclusivité pour vos évènements privés ou professionnels : Mariages, Anniversaires, Cocktails, Repas de famille, Réunions, Séminaires, Teambuiding. Notre Chef Aurélien Poncet régale vos invités !"
    ],
    "nl": [
      "Het Domaine du Château de la Rive is exclusief beschikbaar voor privé- of bedrijfsevenementen: bruiloften, verjaardagen, cocktailparty's, familiediners, vergaderingen, seminars en teambuilding. Onze chef-kok Aurélien Poncet zal uw gasten verrukken!"
    ],
    "es": [
      "El Domaine du Château de la Rive está disponible exclusivamente para eventos privados o corporativos: bodas, cumpleaños, cócteles, comidas familiares, reuniones, seminarios y teambuilding. Nuestro Chef Aurélien Poncet hará las delicias de sus invitados"
    ]
  },
