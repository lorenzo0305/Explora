  "rdfs:comment": {
    "de": [
      "Le Plateau Sept ist ein professionelles Ensemble für zeitgenössisches Theater, dessen Ziel die Schaffung und Verbreitung von Live-Darbietungen sowie die Organisation von Veranstaltungen ist: Theater, Tanz, Musik und andere Feierlichkeiten in Montselgues."
    ],
    "en": [
      "Le Plateau Sept is a professional contemporary theater company, whose purpose is the creation and dissemination of live performances, and the organization of events: theater, dance, music and other festivities in Montselgues."
    ],
    "it": [
      "Le Plateau Sept è una compagnia professionale di teatro contemporaneo, il cui scopo è la creazione e la diffusione di spettacoli dal vivo, nonché l'organizzazione di eventi: teatro, danza, musica e altre feste a Montselgues."
    ],
    "fr": [
      "Le Plateau Sept est une compagnie professionnelle de théâtre contemporain, dont l’objet est la création et la diffusion de spectacles vivants, ainsi que l’organisation de manifestations : théâtre, danse, musique et autres festivités à Montselgues."
    ],
    "nl": [
      "Le Plateau Sept is een professioneel hedendaags theatergezelschap, met als doel de creatie en verspreiding van live voorstellingen, alsook de organisatie van evenementen: theater, dans, muziek en andere festiviteiten in Montselgues."
    ],
    "es": [
      "Le Plateau Sept es una compañía profesional de teatro contemporáneo, cuyo objetivo es la creación y difusión de espectáculos en directo, así como la organización de eventos: teatro, danza, música y otras festividades en Montselgues."
    ]
  },
