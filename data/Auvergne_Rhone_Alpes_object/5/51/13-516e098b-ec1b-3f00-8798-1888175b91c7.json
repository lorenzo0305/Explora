  "rdfs:comment": {
    "de": [
      "Die Boutique Au Fil de la Monne bietet Ihnen Artikel aus Mohair (Knäuel, Schals, Socken, Pullover, Plaids usw.).\r\nDie Produkte werden lokal und handwerklich hergestellt."
    ],
    "en": [
      "The Au Fil de la Monne shop offers mohair items (balls, scarves, socks, sweaters, plaids, etc.).\r\nLocal and artisanal production and confection. Open Monday, Tuesday and Thursday afternoons and by appointment."
    ],
    "it": [
      "Il negozio Au Fil de la Monne vende articoli in mohair (gomitoli, sciarpe, calze, maglioni, plaid, ecc.).\r\nProdotti localmente e a mano."
    ],
    "fr": [
      "La boutique Au Fil de la Monne vous propose des articles en mohair (pelotes, écharpes, chaussettes, pulls, plaids…).\r\nConfection locales et artisanales."
    ],
    "es": [
      "La tienda Au Fil de la Monne vende artículos de mohair (ovillos, bufandas, calcetines, jerseys, cuadros, etc.).\r\nFabricados localmente y a mano."
    ],
    "nl": [
      "De winkel Au Fil de la Monne verkoopt mohair artikelen (bollen, sjaals, sokken, truien, plaids, enz.).\r\nLokaal en met de hand gemaakt."
    ]
  },
