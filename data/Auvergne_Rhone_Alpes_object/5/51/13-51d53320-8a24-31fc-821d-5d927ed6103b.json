  "rdfs:comment": {
    "de": [
      "Laden mit Handwerkern und Kreativen, den Sie unbedingt entdecken sollten!\r\nIllustration - Gesellschaftsspiele.\r\nTöpferei.\r\nSchmuck aus Holz, Muranoglas und Silber.\r\nTextilkreationen aus Mohair.\r\nTextilkreationen für Geburten und personalisierte Textilien.\r\nKräutertees, Sirupe, Salze.\r\nSeifen."
    ],
    "en": [
      "A must-see artisan store!\r\nIllustration - board games.\r\nPottery.\r\nJewelry in wood, Murano glass and silver.\r\nMohair textile creations.\r\nBaby and personalized textile creations.\r\nHerbal teas, syrups, salts.\r\nSoaps."
    ],
    "it": [
      "Un negozio di artigianato e design da non perdere!\r\nIllustrazione - giochi da tavolo.\r\nCeramiche.\r\nGioielli in legno, vetro di Murano e argento.\r\nCreazioni tessili in mohair.\r\nCreazioni tessili per neonati e personalizzate.\r\nTisane, sciroppi, sali.\r\nSaponi."
    ],
    "fr": [
      "Magasin d'artisans-créateurs à découvrir absolument !\r\nIllustration - jeux de société.\r\nPoterie.\r\nBijoux en bois, en verre de Murano et en argent.\r\nCréations textiles en Mohair.\r\nCréations textiles naissances et personnalisées.\r\nTisanes, sirops, sels.\r\nSavons."
    ],
    "es": [
      "Una tienda de artesanía y diseño de visita obligada\r\nIlustración - juegos de mesa.\r\nCerámica.\r\nJoyería en madera, cristal de Murano y plata.\r\nCreaciones textiles de mohair.\r\nCreaciones textiles para recién nacidos y personalizadas.\r\nTisanas, jarabes, sales.\r\nJabones."
    ],
    "nl": [
      "Een must-see knutsel- en designwinkel!\r\nIllustratie - bordspellen.\r\nAardewerk.\r\nSieraden van hout, Murano glas en zilver.\r\nMohair textielcreaties.\r\nNewborn en gepersonaliseerde textielcreaties.\r\nKruidenthee, siropen, zouten.\r\nZepen."
    ]
  },
  "rdfs:label": {
