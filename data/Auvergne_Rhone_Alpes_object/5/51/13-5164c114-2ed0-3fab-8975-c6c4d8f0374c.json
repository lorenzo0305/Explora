  "rdfs:comment": {
    "de": [
      "Machen Sie einen Spaziergang durch das Dorf Arêches, um den vom Sommelier versteckten Schatz zu finden. App vor der Abfahrt herunterladen!"
    ],
    "en": [
      "Walk in our lovely village, to discover having fun, regional wines and cheeses. The best part ? Trying to find the secret treasure, hidden by Victor, sommelier of the bar. With smartphone or tablet. Download the Baludik app. A course to do in all weather."
    ],
    "it": [
      "Passeggiate nel villaggio di Arêches per trovare il tesoro nascosto dal sommelier. Applicazione da scaricare prima di partire!"
    ],
    "fr": [
      "Balade dans le village d’Arêches pour trouver le trésor caché par le sommelier. Application à télécharger avant le départ !"
    ],
    "nl": [
      "Wandel door het dorp Arêches en ontdek op een speelse manier de wijnen en kazen van Savoye en vind de verborgen schat van Victor, de sommelier van de Accord."
    ],
    "es": [
      "Pasea por el pueblo de Arêches para encontrar el tesoro escondido por el sumiller. ¡Aplicación para descargar antes de salir!"
    ]
  },
  "rdfs:label": {
    "en": [
      "Treasure hunt from the Bar \"L'Accord\""
    ],
    "fr": [
      "La Chasse au trésor de l'Accord"
    ],
    "nl": [
      "Schattenjacht van de Accord"
    ]
  },
