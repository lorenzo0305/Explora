  "rdfs:comment": {
    "de": [
      "Evolution 2 ist nicht nur eine der angesehensten Ski- und Abenteuerschulen in den französischen Alpen, sondern auch eine Wintersportschule. Wir sind auch eine Abenteuerschule und bieten eine Vielzahl von winterlichen Outdoor-Aktivitäten für die ganze Familie an!"
    ],
    "en": [
      "Evolution 2 has become one of the most respected ski and adventure schools in the French Alps. We believe in learning in small groups, with specialist instructors, and an emphasis on progression and fun!"
    ],
    "it": [
      "Evolution 2 non è solo una delle scuole di sci e avventura più rispettate delle Alpi francesi. Siamo anche una scuola di avventura che offre una serie di attività invernali all'aperto per tutta la famiglia!"
    ],
    "fr": [
      "Evolution 2 en plus d'être l’une des écoles de ski et d’aventure les plus respectées des Alpes françaises. Nous sommes également une école d'aventure et proposons une multitude d'activité outdoor hivernales pour toute la famille !"
    ],
    "es": [
      "Evolution 2 no es sólo una de las escuelas de esquí y aventura más respetadas de los Alpes franceses. También somos una escuela de aventura que ofrece un sinfín de actividades de invierno al aire libre para toda la familia"
    ],
    "nl": [
      "Evolution 2 is niet alleen een van de meest gerespecteerde ski- en avontuurscholen in de Franse Alpen. We zijn ook een avonturenschool en bieden een groot aantal winterse outdooractiviteiten voor het hele gezin!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Evolution 2 le lac   Hors Glisse"
    ]
  },
