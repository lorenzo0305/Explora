  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/a9aebcf2-15fc-39af-9129-ce7119772cda",
      "dc:description": {
        "de": [
          "Das Le Bouquet bietet eine große Auswahl an Speisen und Erfrischungen. Das Restaurant ist vor allem für seine hervorragenden regionalen Gerichte und seine hausgemachte Küche bekannt."
        ],
        "en": [
          "Le Bouquet offers a wide range of dishes and refreshments. The restaurant is renowned for its excellent local dishes and homemade cuisine."
        ],
        "it": [
          "Le Bouquet offre una vasta gamma di piatti e rinfreschi. Il ristorante è rinomato per gli ottimi piatti locali e la cucina casalinga."
        ],
        "fr": [
          "Le Bouquet propose une grande gamme de plats et de rafraîchissements. Ce restaurant est notamment renommés pour ses excellents plats du terroir et sa cuisine faite maison."
        ],
        "es": [
          "Le Bouquet ofrece una amplia gama de platos y refrescos. El restaurante es famoso por sus excelentes platos locales y su cocina casera."
        ],
        "nl": [
          "Le Bouquet biedt een breed scala aan gerechten en verfrissingen. Het restaurant staat bekend om zijn uitstekende streekgerechten en huisgemaakte gerechten."
        ]
      },
