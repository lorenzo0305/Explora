  "rdfs:comment": {
    "de": [
      "Eine der symbolträchtigsten Festungen des Velay. Vigie der Stadt Le Puy-en-Velay, seit dem 11. Jahrhundert gegenüber dem Vivarais. Zwei Burgen in einer: ein überraschendes Verteidigungssystem."
    ],
    "en": [
      "One of Velay's most emblematic fortresses. Since the 11th century, it has stood guard over the town of Le Puy-en-Velay, facing the Vivarais region. Two castles in one: a surprising defensive system."
    ],
    "it": [
      "Una delle fortezze più emblematiche del Velay. È la parola d'ordine della città di Le Puy-en-Velay, affacciata sulla regione del Vivarais, fin dall'XI secolo. Due castelli in uno: un sistema difensivo sorprendente."
    ],
    "fr": [
      "Une des forteresses les plus emblématiques du Velay. Vigie de la ville du Puy-en-Velay, face au Vivarais depuis le 11ème siècle. Deux châteaux en un : un système défensif surprenant."
    ],
    "es": [
      "Una de las fortalezas más emblemáticas del Velay. Desde el siglo XI es la consigna de la ciudad de Le Puy-en-Velay, frente a la región de Vivarais. Dos castillos en uno: un sistema defensivo sorprendente."
    ],
    "nl": [
      "Een van de meest emblematische forten van de Velay. Het is al sinds de 11e eeuw het parool van de stad Le Puy-en-Velay, tegenover de Vivarais. Twee kastelen in één: een verrassend verdedigingssysteem."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Château de Bouzols représenté par  Association \"Bouzols forteresse d'avenir\""
    ]
  },
