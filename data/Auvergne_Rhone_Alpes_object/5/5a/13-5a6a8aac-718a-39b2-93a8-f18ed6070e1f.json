  "rdfs:comment": {
    "de": [
      "Ehemaliges Casadéen-Priorat, Kreuzgang, romanische Kirche Saint-Marcellin mit figürlichen Kapitellen, Kapelle Sainte-Anne.\r\nDas ganze Jahr über geöffnet.\r\nGeführte Besichtigungen mit dem Pays d'art et d'histoire du Haut-Allier unter 04 71 77 28 30 möglich."
    ],
    "en": [
      "Former Casadean priory, cloister, Saint-Marcellin Romanesque church with figurative capitals, Sainte-Anne chapel.\r\nOpen all year round.\r\nGuided tours available with the Pays d'art et d'histoire du Haut-Allier on 04 71 77 28 30."
    ],
    "it": [
      "Ex priorato casadiano, chiostro, chiesa romanica di Saint-Marcellin con capitelli figurati, cappella di Sainte-Anne.\r\nAperto tutto l'anno.\r\nVisite guidate disponibili con il Pays d'art et d'histoire du Haut-Allier al numero 04 71 77 28 30."
    ],
    "fr": [
      "Ancien prieuré casadéen, cloître, église romane Saint-Marcellin avec chapiteaux figurés, chapelle Sainte-Anne. \r\nOuvert toute l’année. \r\nPossibilité de visites guidées avec le Pays d'art et d'histoire du Haut-Allier au 04 71 77 28 30."
    ],
    "nl": [
      "Voormalige Casadische priorij, klooster, Romaanse kerk Saint-Marcellin met figuratieve kapitelen, kapel Sainte-Anne.\r\nHet hele jaar geopend.\r\nRondleidingen mogelijk met het Pays d'art et d'histoire du Haut-Allier op 04 71 77 28 30."
    ],
    "es": [
      "Antiguo priorato casadio, claustro, iglesia románica de Saint-Marcellin con capiteles figurativos, capilla de Sainte-Anne.\r\nAbierto todo el año.\r\nVisitas guiadas disponibles en el Pays d'art et d'histoire du Haut-Allier en el 04 71 77 28 30."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Eglise Saint-Marcellin"
    ]
  },
