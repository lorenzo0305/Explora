  "rdfs:comment": {
    "de": [
      "Dies ist ein städtischer Sportplatz mit freiem Zugang, der für alle offen ist. Er befindet sich in der Nähe des Reitzentrums von Buis. Die Jugendabteilung hat einen neuen Raum auf der Höhe des Skateparks, in dem du alle notwendigen Materialien und einen Kicker findest."
    ],
    "en": [
      "It's a municipal sports area with free access, open to all. Located near the Buis equestrian center, the youth department has a new facility next to the skatepark, where you'll find all the equipment you need, plus table soccer."
    ],
    "it": [
      "Il Plateau des Tuves è un luogo in cui giovani, famiglie, associazioni, scuole e centri ricreativi si riuniscono per godere delle strutture e di una posizione tranquilla lontano dal centro della città."
    ],
    "fr": [
      "Le plateau des Tuves est un lieu où les jeunes, les familles, les associations, les écoles ainsi que les centres de loisirs, se retrouvent pour profiter des infrastructures et d'un endroit calme, à l'écart du centre bourg."
    ],
    "nl": [
      "Het is een gemeentelijk sportterrein dat gratis toegankelijk is voor iedereen. Het ligt vlakbij de manege van Buis en de jeugddienst heeft een nieuwe ruimte naast het skatepark, waar je alle benodigde uitrusting en een tafelvoetbalspel vindt."
    ],
    "es": [
      "El Plateau des Tuves es un lugar donde jóvenes, familias, asociaciones, escuelas y centros de ocio se reúnen para disfrutar de las instalaciones y de una ubicación tranquila y alejada del centro de la ciudad."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Plateau sportif des Tuves"
    ]
  },
