  "rdfs:comment": {
    "de": [
      "Bio-Restaurants vor Ort oder zum Mitnehmen: vom Haus zusammengestellte Gerichte.\r\nSaisonaler Salat, Poke Toast, Gemüsekuchen, glutenfreie Pizza, Chiasamen-Dessert, Schokoladenkekse, Brownie... je nach Jahreszeit.\r\nAbwechslungsreiche, ausgewogene und vegetarische Menüs."
    ],
    "en": [
      "Organic catering on the spot or to take away: dishes concocted by the house.\r\nSeasonal salad, poke toasts, vegetable cake, gluten-free pizza, chia seed dessert, chocolate cookies, brownie... depending on the season.\r\nVaried, balanced and vegetarian menus."
    ],
    "it": [
      "Ristorazione biologica sul posto o da asporto: piatti preparati dalla casa.\r\nInsalata di stagione, toast di poke, torta di verdure, pizza senza glutine, dessert ai semi di chia, biscotti al cioccolato, brownie... a seconda della stagione.\r\nMenù variati, equilibrati e vegetariani."
    ],
    "fr": [
      "Restauration bio sur place ou à emporter : plats concoctés par la maison. \r\nSalade de saison, poke toasts, cake légumes, pizza sans gluten, dessert graines de chia, cookies chocolat, brownie... selon la période. \r\nMenus variés, équilibrés et végétariens."
    ],
    "es": [
      "Catering ecológico in situ o para llevar: platos elaborados por la casa.\r\nEnsalada de temporada, tostadas poke, tarta vegetal, pizza sin gluten, postre de semillas de chía, galletas de chocolate, brownie... según la temporada.\r\nMenús variados, equilibrados y vegetarianos."
    ],
    "nl": [
      "Biologische catering ter plaatse of om mee te nemen: door het huis samengestelde gerechten.\r\nSeizoenssalade, poke toasts, groentetaart, glutenvrije pizza, chiazaaddessert, chocoladekoekjes, brownie... afhankelijk van het seizoen.\r\nGevarieerde, evenwichtige en vegetarische menu's."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Ronde du Bio"
    ]
  },
