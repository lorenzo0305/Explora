          "@type": [
            "schema:OpeningHoursSpecification"
          ],
          "additionalInformation": {
            "de": [
              "An Feiertagen geschlossen.\r\nDas Tourismusbüro ist für die Öffentlichkeit geöffnet\r\n- Dienstag, Mittwoch und Freitag von 9:00 bis 12:00 Uhr und von 13:30 bis 17:30 Uhr.\r\n- Donnerstagvormittag von 9:00 bis 12:00 Uhr.\r\n- Samstag von 9:30 bis 12:30 Uhr und von 14:00 bis 17:00 Uhr.\r\nDas Team bleibt auch telefonisch oder per E-Mail erreichbar: ot@capi38.fr"
            ],
            "en": [
              "Closed on public holidays.\r\nThe Tourist Office is open to the public\r\n- Tuesday, Wednesday and Friday from 9am to 12pm and from 1:30pm to 5:30pm.\r\n- Thursday morning from 9am to 12pm.\r\n- Saturday from 9.30am to 12.30pm and from 2pm to 5pm.\r\nThe team can also be reached by telephone or by e-mail: ot@capi38.fr"
            ],
            "it": [
              "Chiuso nei giorni festivi.\r\nL'Ufficio del Turismo è aperto al pubblico\r\n- Martedì, mercoledì e venerdì dalle 9 alle 12 e dalle 13:30 alle 17:30.\r\n- Giovedì mattina dalle 9.00 alle 12.00.\r\n- Sabato dalle 9.30 alle 12.30 e dalle 14.00 alle 17.00.\r\nIl team può essere contattato anche telefonicamente o via e-mail: ot@capi38.fr"
            ],
            "fr": [
              "Fermé les jours féries.\r\nL'Office de Tourisme est ouvert au public : \r\n- Mardi, Mercredi et Vendredi de 9h à 12h et de 13h30 à 17h30.\r\n- Jeudi matin de 9h à 12h.\r\n- Samedi de 9h30 à 12h30 et de 14h à 17h.\r\nL'équipe reste joignable également par téléphone ou par mail : ot@capi38.fr"
            ],
            "nl": [
              "Gesloten op feestdagen.\r\nHet toeristenbureau is open voor het publiek\r\n- Dinsdag, woensdag en vrijdag van 9.00 tot 12.00 uur en van 13.30 tot 17.30 uur.\r\n- Donderdagochtend van 9 tot 12 uur.\r\n- Zaterdag van 9.30 tot 12.30 uur en van 14.00 tot 17.00 uur.\r\nHet team is ook telefonisch of per e-mail bereikbaar: ot@capi38.fr"
            ],
            "es": [
              "Cerrado los días festivos.\r\nLa Oficina de Turismo está abierta al público\r\n- Martes, miércoles y viernes de 9 a 12 y de 13:30 a 17:30.\r\n- Jueves por la mañana de 9 a 12 horas.\r\n- Sábado de 9.30 a 12.30 y de 14 a 17 horas.\r\nTambién se puede contactar con el equipo por teléfono o por correo electrónico: ot@capi38.fr"
            ]
          },
