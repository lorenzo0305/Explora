  "rdfs:comment": {
    "de": [
      "Die Dranse d'Abondance (außerhalb des Reservats: vom Bach La Pesse bis zum Pont du Moulin (La Chapelle d'Abondance) und vom Pont du village bis zum Pont d'Offaz (Abondance)) beherbergt eine der schönsten Populationen autochthoner Forellen des Departements."
    ],
    "en": [
      "The Dranse d'Abondance (outside the reserve: from the stream of La Pesse to the Pont du Moulin (La Chapelle d'Abondance) and from the village bridge to the Offaz bridge (Abondance)) is home to one of the best populations of native trout in the department."
    ],
    "it": [
      "La Dranse d'Abondance (fuori dalla riserva: dal torrente La Pesse al Pont du Moulin (La Chapelle d'Abondance) e dal ponte del villaggio al ponte di Offaz (Abondance)) ospita una delle migliori popolazioni di trote autoctone del dipartimento."
    ],
    "fr": [
      "La Dranse d’Abondance (hors réserve : du ruisseau de La Pesse au Pont du Moulin (La Chapelle d’Abondance) et du pont du village au pont d’Offaz (Abondance)) héberge l’une des plus belles populations de truites autochtones du département."
    ],
    "es": [
      "La Dranse d'Abondance (fuera de la reserva: desde el arroyo de La Pesse hasta el Pont du Moulin (La Chapelle d'Abondance) y desde el puente del pueblo hasta el puente de Offaz (Abondance)) alberga una de las mejores poblaciones de truchas autóctonas del departamento."
    ],
    "nl": [
      "De Dranse d'Abondance (buiten het reservaat: van de ruisseau de La Pesse tot de Pont du Moulin (La Chapelle d'Abondance) en van de dorpsbrug tot de brug van Offaz (Abondance)) herbergt een van de beste populaties inheemse forel van het departement."
    ]
  },
  "rdfs:label": {
    "en": [
      "Fishing in the Dranse d'Abondance"
    ],
    "fr": [
      "Pêche dans la Dranse d'Abondance"
    ],
    "nl": [
      "Vissen in de Dranse d'Abondance"
    ]
  },
