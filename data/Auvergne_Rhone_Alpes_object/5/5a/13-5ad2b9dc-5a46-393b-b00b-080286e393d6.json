  "rdfs:comment": {
    "de": [
      "5 fünf Strecken von 3-39 km vom Skiort aus und eine Semi-KMV-Strecke mit einem Höhenunterschied von 500 m (Holzschild am Fuß des Sessellifts).6 Strecken von 4,4-23,1 km vom Dorf aus."
    ],
    "en": [
      "\"Five trails ranging from 3 to 39km starting at the ski resort, and a semi VKM with a 500m elevation gain (wooden panel at the bottom of the chairlift).\r\n6 trails ranging from 4.4 to 23.1km, starting at the village\""
    ],
    "it": [
      "5 cinque percorsi da 3 a 39 km con partenza dalla stazione sciistica e un percorso semi-MKV con 500 m di dislivello (cartello in legno installato ai piedi della seggiovia).\r\n6 percorsi da 4,4 a 23,1 km con partenza dal paese"
    ],
    "fr": [
      "5 cinq parcours de 3 à 39 km au départ de la station de ski et un parcours semi KMV avec un dénivelé de 500m (panneau en bois installé au pied du télésiège).\r\n6 parcours de 4,4 à 23,1 km au départ du village"
    ],
    "nl": [
      "5 vijf routes van 3 tot 39 km vanaf het skigebied en een semi-MKV-route met een hoogteverschil van 500 m (houten bord geïnstalleerd aan de voet van de stoeltjeslift).\r\n6 routes van 4,4 tot 23,1 km vanaf het dorp"
    ],
    "es": [
      "5 rutas de 3 a 39 km con salida desde la estación de esquí y una ruta semi-MKV con un desnivel de 500 m (señal de madera instalada al pie del telesilla).\r\n6 rutas de 4,4 a 23,1 km con salida desde el pueblo"
    ]
  },
  "rdfs:label": {
