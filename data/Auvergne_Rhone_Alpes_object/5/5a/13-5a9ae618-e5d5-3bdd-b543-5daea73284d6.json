  "rdfs:comment": {
    "de": [
      "Treffen Sie die Illustratorin und Künstlerin Emmanuelle Houdart an diesem außergewöhnlichen Abend in der Mediathek von Saint-Vincent, der in Zusammenarbeit mit der Buchhandlung \"Le Chat Perché\" stattfindet.\r\nDenken Sie an eine Reservierung."
    ],
    "en": [
      "Come and meet illustrator and artist Emmanuelle Houdart for this exceptional evening at the Saint-Vincent media library, in collaboration with the \"Le Chat Perché\" bookshop.\r\nDon't forget to book."
    ],
    "it": [
      "Venite a conoscere Emmanuelle Houdart, illustratrice e artista, per questa serata eccezionale alla biblioteca multimediale di Saint-Vincent, in collaborazione con la libreria \"Le Chat Perché\".\r\nNon dimenticate di prenotare."
    ],
    "fr": [
      "Venez rencontrer Emmanuelle Houdart, illustratrice et artiste, lors de cette soirée exceptionnelle à la médiathèque de Saint-Vincent, en collaboration avec la librairie \"Le Chat Perché\".\r\nPensez à réserver."
    ],
    "es": [
      "Venga a conocer a Emmanuelle Houdart, ilustradora y artista, en esta velada excepcional en la mediateca de Saint-Vincent, en colaboración con la librería \"Le Chat Perché\".\r\nNo olvide reservar."
    ],
    "nl": [
      "Kom Emmanuelle Houdart, illustratrice en kunstenares, ontmoeten op deze uitzonderlijke avond in de mediatheek van Saint-Vincent, in samenwerking met boekhandel \"Le Chat Perché\".\r\nVergeet niet te reserveren."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Rencontre-dédicace avec Emmanuelle Houdart"
    ]
  },
