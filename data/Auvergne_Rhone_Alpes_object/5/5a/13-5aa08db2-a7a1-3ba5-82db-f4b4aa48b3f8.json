  "rdfs:comment": {
    "de": [
      "Zwischen Design und Modernität zeigt das Zénith eine aerodynamische Silhouette, die mit einem majestätischen Vorplatz verbunden ist. Lassen Sie sich von einer der zahlreichen Veranstaltungen verführen, die in diesem unumgänglichen Ort des kulturellen Lebens der Agglomeration St. Etienne auf dem Programm stehen."
    ],
    "en": [
      "Between design and modernity, the Zenith displays an aerodynamic silhouette associated with a majestic square. Let yourself be tempted by one of the many events on offer at this venue, which is a must in the cultural life of the Saint-Etienne area."
    ],
    "it": [
      "Tra design e modernità, lo Zenith ha una silhouette aerodinamica associata a una piazza maestosa. Lasciatevi tentare da uno dei tanti eventi proposti in questo locale, che è una tappa obbligata della vita culturale della zona di Saint-Etienne."
    ],
    "fr": [
      "Entre design et modernité, le Zénith affiche une silhouette aérodynamique associé à un parvis majestueux. Laissez-vous tenter par l’un des nombreux évènements à l’affiche de ce lieu incontournable dans la vie culturelle de l'agglomération stéphanoise."
    ],
    "nl": [
      "Tussen design en moderniteit heeft de Zenith een gestroomlijnd silhouet dat geassocieerd wordt met een majestueus plein. Laat u verleiden door een van de vele evenementen die worden aangeboden in deze zaal, die niet mag ontbreken in het culturele leven van Saint-Etienne."
    ],
    "es": [
      "Entre diseño y modernidad, el Zenith presenta una silueta aerodinámica asociada a una plaza majestuosa. Déjese tentar por uno de los numerosos eventos que ofrece este lugar, imprescindible en la vida cultural de la región de Saint-Etienne."
    ]
  },
