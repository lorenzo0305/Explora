  "rdfs:comment": {
    "de": [
      "Bar, Restaurant im Freizeitpark von L'Aigle in der Nähe des Dorfes. Nur Außenterrasse, von der ein Teil überdacht ist.\r\nLokale und saisonale Küche am Mittag (und im Sommer auch am Abend). Kaffee, Getränke und Nachmittagssnacks."
    ],
    "en": [
      "Bar, restaurant located on the Aigle area near the village. Outside terrace only, part of which is covered. Local and seasonal cuisine at lunchtime (and in the evening in summer). Coffee, drinks and snacks in the afternoon."
    ],
    "it": [
      "Ristorante situato sul sito di Aigle, vicino al villaggio. Sala da pranzo interna e terrazza esterna con zona divani.\r\nCucina con prodotti locali e di stagione."
    ],
    "fr": [
      "Restaurant situé sur le site de l’Aigle à proximité du village. Salle intérieure et terrasse extérieure avec son coin canapé.\r\nCuisine avec les produits locaux et de saison."
    ],
    "es": [
      "Restaurante situado en el emplazamiento de Aigle, cerca del pueblo. Comedor interior y terraza exterior con zona de sofás.\r\nCocina con productos locales y de temporada."
    ],
    "nl": [
      "Restaurant gelegen op het Aigle terrein vlakbij het dorp. Overdekte eetzaal en buitenterras met zitbank.\r\nGekookt met lokale en seizoensgebonden producten."
    ]
  },
  "rdfs:label": {
