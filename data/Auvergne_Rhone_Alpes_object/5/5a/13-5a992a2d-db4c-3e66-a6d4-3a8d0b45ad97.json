  "rdfs:comment": {
    "de": [
      "Große Auswahl an Kräutertees aus Bergpflanzen und biologischen Tees zum Verzehr vor Ort oder zum Mitnehmen, handgemachtes Eis, frische Fruchtcocktails, glutenfreie Crêpes, Galettes, Savoyarder Spezialitäten, natürliche und hochwertige Produkte."
    ],
    "en": [
      "Large selection of herbal teas and organic teas..."
    ],
    "it": [
      "Ampia scelta di tisane di montagna e tè biologici da bere sul posto o da portare via, gelati fatti in casa, cocktail di frutta fresca, frittelle senza glutine, specialità savoiarde, prodotti naturali e di qualità."
    ],
    "fr": [
      "Grand choix de tisanes aux plantes de montagne et de thés biologiques à consommer sur place ou à emporter, glaces artisanales, cocktails de fruits frais, crêpes sans gluten, galettes, spécialité Savoyarde, produits naturel et de qualité ."
    ],
    "nl": [
      "Grote keuze aan kruidenthee en biologische thee om ter plaatse te drinken of om mee te nemen, huisgemaakt ijs, verse fruitcocktails, glutenvrije pannenkoeken, Savoyaardse specialiteiten, natuurlijke en kwaliteitsproducten."
    ],
    "es": [
      "Amplia selección de tisanas de montaña y tés ecológicos para tomar in situ o para llevar, helados caseros, cócteles de fruta fresca, tortitas sin gluten, especialidades de Saboya, productos naturales y de calidad."
    ]
  },
