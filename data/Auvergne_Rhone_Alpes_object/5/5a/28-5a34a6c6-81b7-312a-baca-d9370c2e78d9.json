  "rdfs:comment": {
    "de": [
      "Pflücken Sie die Früchte bis Ende Oktober direkt im Obstgarten (Äpfel und Birnen) oder kommen Sie im Laden in Esnes vorbei."
    ],
    "en": [
      "Come and pick fruit directly from the orchard until the end of October (apples and pears), or drop in at the store in Esnes."
    ],
    "it": [
      "Venite a raccogliere la frutta direttamente dal frutteto fino alla fine di ottobre (mele e pere) o a fare un salto al negozio di Esnes."
    ],
    "fr": [
      "Venez cueillir directement les fruits au verger jusque fin octobre (pommes et poires) ou passez à la boutique à Esnes."
    ],
    "es": [
      "Venga a recoger fruta directamente al huerto hasta finales de octubre (manzanas y peras) o pase por la tienda de Esnes."
    ],
    "nl": [
      "Kom tot eind oktober fruit rechtstreeks uit de boomgaard plukken (appels en peren) of kom langs in de winkel in Esnes."
    ]
  },
