  "rdfs:comment": {
    "de": [
      "Erleben Sie einen außergewöhnlichen Moment im Herzen der Toskana der Auvergne und des Livradois-Forez auf eine originelle und sympathische Art und Weise. Von einem staatlich geprüften Fremdenführer geleitete Wanderungen für Privatpersonen und Unternehmen, Anfänger oder Fortgeschrittene."
    ],
    "en": [
      "Experience an exceptional moment in the heart of the Tuscany of Auvergne and the Livradois-Forez in an original and friendly way. Hikes supervised by a state-qualified guide for individuals and companies, beginners or experienced hikers."
    ],
    "it": [
      "Vivete un momento eccezionale nel cuore della Toscana d'Alvernia e del Livradois-Forez in modo originale e amichevole. Escursioni condotte da una guida qualificata dallo Stato per privati e aziende, principianti o escursionisti esperti."
    ],
    "fr": [
      "Vivez un moment d'exception au cœur de la Toscane auvergnate et du Livradois-Forez d'une manière originale et sympathique. Randonnées encadrées par un guide diplômé d'Etat pour particuliers et entreprises, débutants ou confirmés."
    ],
    "es": [
      "Viva un momento excepcional en el corazón de la Toscana de Auvernia y del Livradois-Forez de forma original y acogedora. Caminatas supervisadas por un guía calificado por el estado para particulares y empresas, principiantes o excursionistas experimentados."
    ],
    "nl": [
      "Beleef een uitzonderlijk moment in het hart van de Toscane van de Auvergne en de Livradois-Forez op een originele en vriendelijke manier. Wandelingen onder leiding van een staatsgediplomeerde gids voor particulieren en bedrijven, beginners of ervaren wandelaars."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Randonnées en quad - Quad 63"
    ]
  },
