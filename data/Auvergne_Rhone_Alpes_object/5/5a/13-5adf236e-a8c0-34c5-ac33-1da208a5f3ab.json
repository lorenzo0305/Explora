  "rdfs:comment": {
    "de": [
      "Produzentin von Obst aus biologischem Anbau: Erdbeeren, Himbeeren, schwarze Johannisbeeren, Stachelbeeren, Brombeeren, Kirschen, Haselnüsse, Äpfel, Pfirsiche, Birnen, Pflaumen, Walnüsse, Haselnüsse\r\nFrisches Obst und Derivate: Sirup, Coulis, Kompott, Konfitüre, Apero-Nüsse..."
    ],
    "en": [
      "Organic fruit producer: strawberries, raspberries, blackcurrants, redcurrants, blackberries, cherries, currants, apples, peaches, pears, plums, walnuts, hazelnuts\r\nFresh fruit and by-products: syrups, coulis, compotes, jams, aperitif nuts..."
    ],
    "it": [
      "Produttore di frutta biologica: fragole, lamponi, ribes nero, ribes rosso, more, ciliegie, ribes, mele, pesche, pere, prugne, noci, nocciole, ecc\r\nFrutta fresca e derivati: sciroppi, coulis, composte, marmellate, noci per aperitivi, ecc."
    ],
    "fr": [
      "Productrice de fruits en agriculture biologique : fraises, framboises, cassis, groseilles, mures, cerises, caseilles, pommes, pêches, poires, prunes, noix, noisettes\r\nFruits frais et dérivés : sirops, coulis, compotes confitures, noix apéro..."
    ],
    "es": [
      "Productor de fruta ecológica: fresas, frambuesas, grosellas negras, grosellas rojas, moras, cerezas, grosellas, manzanas, melocotones, peras, ciruelas, nueces, avellanas, etc\r\nFruta fresca y derivados: siropes, coulis, compotas, mermeladas, frutos secos de aperitivo, etc."
    ],
    "nl": [
      "Biologische fruitteler: aardbeien, frambozen, zwarte bessen, rode bessen, bramen, kersen, aalbessen, appels, perziken, peren, pruimen, walnoten, hazelnoten, enz\r\nVers fruit en bijproducten: siropen, coulis, compotes, jam, aperitiefnoten, enz."
    ]
  },
