  "rdfs:comment": {
    "de": [
      "Ein Pumptrack ist eine Rundstrecke, die aus Buckeln und Steilkurven besteht und mit Mountainbikes, BMX-Rädern, Skateboards, Inline-Skates, Rollern oder Draisinen befahren werden kann."
    ],
    "en": [
      "The pump track can be used by mountain bikes, BMX, rollerblades and scooters."
    ],
    "it": [
      "Una pump track è una pista ad anello composta da dossi e curve a gomito che può essere utilizzata da mountain bike, BMX, skateboard, rollerblade, monopattini o draisiennes."
    ],
    "fr": [
      "La pump track est une piste en boucle, constituée de bosses et de virages relevés et peut être utilisée en VTT, BMX, skateboard, rollers, trottinettes ou draisiennes."
    ],
    "es": [
      "Un pump track es una pista en bucle formada por baches y curvas peraltadas por la que pueden circular bicicletas de montaña, BMX, monopatines, patines, patinetes o draisiennes."
    ],
    "nl": [
      "Een pump track is een lusvormige baan met hobbels en scherpe bochten die gebruikt kan worden door mountainbikes, BMX-fietsen, skateboards, skeelers, steps of draisiennes."
    ]
  },
  "rdfs:label": {
    "en": [
