  "rdfs:comment": {
    "de": [
      "Sie haben Lust auf asiatische Gerichte? Im Mets Kong, einem Feinkostladen, der aber auch Fastfood anbietet, finden Sie eine große Auswahl: Samossas, Peking-Ente..."
    ],
    "en": [
      "Do you have a craving for Asian food? You will find a very varied choice at the Mets Kong, caterer but also fast food: samossas, Peking duck..."
    ],
    "it": [
      "Avete voglia di cibo asiatico? Troverete una vasta gamma di scelte al Mets Kong, un catering ma anche un fast-food: samosa, anatra alla pechinese, ecc."
    ],
    "fr": [
      "Vous avez une envie de mets asiatiques ? Vous trouverez un choix très varié aux Mets Kong, traiteur mais également restauration rapide : samossas, canard laqué..."
    ],
    "es": [
      "¿Le apetece comida asiática? En Mets Kong, empresa de catering pero también restaurante de comida rápida, encontrará una amplia gama de opciones: samossas, pato pekinés, etc."
    ],
    "nl": [
      "Heb je zin in Aziatisch eten? Bij Mets Kong, een traiteur maar ook een fastfoodrestaurant, vindt u een ruime keuze: samosa's, pekingeend, enz."
    ]
  },
