  "rdfs:comment": {
    "de": [
      "Das Blumencafé ist ein Teesalon mit zehn Sitzplätzen, in dem Sie die gute Atmosphäre und die blumige Dekoration von Crealy Fleurs genießen können. Tee, Kaffee und Säfte sind vor Ort erhältlich, ebenso wie kleine Leckereien zum Essen."
    ],
    "en": [
      "The Café-fleurs is a tearoom with seating for ten, where you can enjoy the atmosphere and floral decor of Crealy Fleurs. Teas, coffees and juices will be available on site, as well as sweet treats to eat."
    ],
    "it": [
      "Il Café-fleurs è una sala da tè con dieci posti a sedere, dove si può godere dell'atmosfera e dell'arredamento floreale di Crealy Fleurs. Sul posto saranno disponibili tè, caffè e succhi di frutta, oltre a dolci da mangiare."
    ],
    "fr": [
      "Le Café-fleurs est un espace salon de thé équipé d'une dizaine de places assises, permettant profiter de la bonne ambiance et de la décoration fleurie de Crealy Fleurs. Thés, cafés, jus seront disponibles sur place ainsi que de petites douceurs à manger."
    ],
    "nl": [
      "Het Café-fleurs is een theesalon met tien zitplaatsen, waar je kunt genieten van de sfeer en het bloemendecor van Crealy Fleurs. Thee, koffie en sappen zijn ter plaatse verkrijgbaar, evenals zoete lekkernijen om te eten."
    ],
    "es": [
      "El Café-fleurs es un salón de té con capacidad para diez personas, donde podrá disfrutar del ambiente y la decoración floral de Crealy Fleurs. Habrá tés, cafés y zumos disponibles in situ, así como dulces para comer."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Café Fleurs"
    ]
  },
