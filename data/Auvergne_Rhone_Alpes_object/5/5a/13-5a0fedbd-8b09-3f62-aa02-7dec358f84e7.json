  "rdfs:comment": {
    "de": [
      "Bienvenue à La Plage: Konzept einer Cocktail- & Tapas-Bar, in der die Atmosphäre der Meeresküste Sie das ganze Jahr über in Stimmung bringen wird. Themenabende, DJs, Essen nach Belieben ... Hier findet jeder sein Glück! Zögern Sie nicht länger, es ist The Plage to be!"
    ],
    "en": [
      "Welcome to La Plage: a cocktail and tapas bar concept where the atmosphere of the seaside can be enjoyed all year round. Theme evenings, DJ’s, all-you-can-eat meals... There’s something for everyone! Don’t hesitate, it’s The Plage to be!"
    ],
    "it": [
      "Benvenuti a La Plage: un concept di cocktail e tapas bar dove l'atmosfera del mare può essere vissuta tutto l'anno. Serate a tema, DJ, pasti a volontà... Ce n'è per tutti i gusti! Non esitate, la Plage è il posto giusto!"
    ],
    "fr": [
      "Bienvenue à La Plage : Concept de bar à cocktails & Tapas où l’ambiance des bords de mer saura vous ambiancer toute l’année. Soirées à thème, DJ’s, repas à volonté... Chacun y trouvera son bonheur ! N’hésitez plus, c’est The Plage to be !"
    ],
    "nl": [
      "Welkom bij La Plage: een cocktail- en tapasbarconcept waar je het hele jaar door kunt genieten van de sfeer van de zee. Thema-avonden, DJ's, all-you-can-eat maaltijden... Er is voor elk wat wils! Aarzel niet, het is The Plage to be!"
    ],
    "es": [
      "Bienvenido a La Plage: un concepto de bar de cócteles y tapas donde podrá disfrutar del ambiente de la costa durante todo el año. Noches temáticas, DJs, platos para todos los gustos... Hay para todos los gustos No lo dude, ¡es La Plage to be!"
    ]
  },
