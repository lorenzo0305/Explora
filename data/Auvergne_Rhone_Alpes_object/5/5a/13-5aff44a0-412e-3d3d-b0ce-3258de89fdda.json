  "rdfs:comment": {
    "de": [
      "Das Schwimmbad Jean Pommier liegt im Stadtteil Polygone in Valence, nur wenige Schritte von der Eislaufbahn entfernt. Es ist für alle Profile geeignet, von erfahrenen Schwimmern bis hin zu Familien auf der Suche nach Entspannung."
    ],
    "en": [
      "Located in Valence's Polygone district, a stone's throw from the skating rink, the Jean Pommier pool caters for all profiles, from experienced swimmers to families looking for relaxation."
    ],
    "it": [
      "Situata nel quartiere Polygone di Valence, a due passi dalla pista di pattinaggio, la piscina Jean Pommier è adatta a tutti, dai nuotatori esperti alle famiglie in cerca di relax."
    ],
    "fr": [
      "Située dans le quartier du Polygone à Valence, à deux pas de la patinoire, la piscine Jean Pommier s'adapte à tous les profils, des nageurs confirmés aux familles en quête de détente."
    ],
    "es": [
      "Situada en el barrio Polygone de Valence, a dos pasos de la pista de patinaje, la piscina Jean Pommier se adapta a todos los gustos, desde los nadadores experimentados hasta las familias que buscan relajarse."
    ],
    "nl": [
      "Het zwembad Jean Pommier ligt in de wijk Polygone in Valence, op een steenworp afstand van de ijsbaan, en is geschikt voor iedereen, van ervaren zwemmers tot gezinnen die willen ontspannen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Piscine Jean Pommier"
    ]
  },
