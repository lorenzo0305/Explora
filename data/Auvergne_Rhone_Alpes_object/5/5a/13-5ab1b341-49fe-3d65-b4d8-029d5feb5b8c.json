  "rdfs:comment": {
    "de": [
      "Ein großer Garten für die Kleinen (Schaukeln, Brücken...) und ein Fitnessparcours für die Großen entlang des Flusses Galaure. Sehr schattig gelegen. Bänke und sanitäre Anlagen."
    ],
    "en": [
      "A large garden for the little ones (swings, bridges, etc.) and a fitness trail for older children along the Galaure river. Very shady. Benches and toilets."
    ],
    "it": [
      "Un grande giardino per i più piccoli (altalene, ponti, ecc.) e un percorso fitness per i più grandi lungo il fiume Galaure. Tanta ombra. Panchine e servizi igienici."
    ],
    "fr": [
      "Un grand jardin aménagé pour les petits (balançoires, ponts...) et parcours de santé pour les grands le long de la rivière Galaure. Très ombragé. Bancs et sanitaires."
    ],
    "es": [
      "Un gran jardín para los más pequeños (columpios, puentes, etc.) y un sendero de fitness para los mayores a lo largo del río Galaure. Mucha sombra. Bancos y aseos."
    ],
    "nl": [
      "Een grote tuin voor de kleintjes (schommels, bruggetjes, enz.) en een trimparcours voor oudere kinderen langs de rivier de Galaure. Veel schaduw. Bankjes en toiletten."
    ]
  },
