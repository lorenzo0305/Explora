  "rdfs:comment": {
    "de": [
      "Das Familienrestaurant am Fuße der Piste und im Herzen des Ortes empfängt Sie jeden Tag vom Frühstück über das Abendessen bis hin zu Snacks und Aperitifs."
    ],
    "en": [
      "Located at the foot of the slopes and in the heart of the resort, this family restaurant welcomes you every day from breakfast to dinner, including afternoon snacks and aperitifs."
    ],
    "it": [
      "Ai piedi delle piste e nel cuore del resort, questo ristorante a conduzione familiare vi accoglie ogni giorno per colazione, pranzo, cena, spuntini e aperitivi."
    ],
    "fr": [
      "Au pied piste et au cœur de la station, le restaurant familial vous accueille tous les jours du petit-déjeuner au dîner en passant par le goûter ou encore l’apéro."
    ],
    "nl": [
      "Aan de voet van de piste en in het hart van het skigebied verwelkomt het familierestaurant u elke dag, van ontbijt tot diner, maar ook voor een snack of een aperitief."
    ],
    "es": [
      "A pie de pistas y en el corazón de la estación, este restaurante familiar le da la bienvenida todos los días para desayunar, comer, cenar, merendar y tomar un aperitivo."
    ]
  },
  "rdfs:label": {
    "en": [
