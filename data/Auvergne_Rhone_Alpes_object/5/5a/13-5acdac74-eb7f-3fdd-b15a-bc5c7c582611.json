  "rdfs:comment": {
    "de": [
      "Im La Table Floralie heißen wir Sie herzlich willkommen in einem Kokon der Intimität mit 25 Gedecken, in dem Geselligkeit, Komfort, Großzügigkeit und Raffinesse unsere Schlüsselwörter sind.\r\nSie werden verwöhnt, damit Sie sich einzigartig fühlen."
    ],
    "en": [
      "At Table Floralie, we warmly welcome you to an intimate cocoon of 25 place settings, where conviviality, comfort, generosity and refinement are our watchwords.\r\nYou'll be pampered and made to feel unique."
    ],
    "it": [
      "Alla Table Floralie vi offriamo un'accoglienza calorosa in un bozzolo intimo di 25 coperti, dove convivialità, comfort, generosità e raffinatezza sono le nostre parole d'ordine.\r\nSarete coccolati e fatti sentire unici."
    ],
    "fr": [
      "À la Table Floralie, nous vous accueillons chaleureusement dans un cocon d’intimité de 25 couverts, où la convivialité, le confort, la générosité et le raffinement sont nos maîtres-mots.\r\nVous serez choyés afin de vous sentir uniques."
    ],
    "es": [
      "En Table Floralie, le damos una calurosa bienvenida a un capullo privado de 25 cubiertos, donde la convivencia, el confort, la generosidad y el refinamiento son nuestras consignas.\r\nLe mimaremos y le haremos sentir único."
    ],
    "nl": [
      "Bij Table Floralie verwelkomen we u hartelijk in een privé cocon van 25 couverts, waar gezelligheid, comfort, gulheid en verfijning onze sleutelwoorden zijn.\r\nU wordt er verwend en u voelt zich er uniek."
    ]
  },
