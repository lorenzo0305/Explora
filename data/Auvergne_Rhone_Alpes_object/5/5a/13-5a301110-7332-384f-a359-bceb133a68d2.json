  "rdfs:comment": {
    "de": [
      "Entdecken Sie Chozeau im Südwesten der Balcons du Dauphiné. Diese Ortschaft bietet eine ländliche Umgebung mit einem baulichen Erbe, das aus einem mittelalterlichen Schloss, einer Kirche und einem befestigten Haus besteht. Hier finden Sie auch den Étang de Chalignieu für eine Pause in der Natur."
    ],
    "en": [
      "Discover Chozeau, in the south-west of the Balcons du Dauphiné. This village offers a rural setting with a built heritage comprising a medieval castle, a church and a fortified house. You'll also find the Etang de Chalignieu for a nature break."
    ],
    "it": [
      "Scoprite Chozeau, nel sud-ovest dei Balcons du Dauphiné. Questo villaggio offre un ambiente rurale con un patrimonio edilizio che comprende un castello medievale, una chiesa e una casa fortificata. Troverete anche l'Etang de Chalignieu per una pausa nella natura."
    ],
    "fr": [
      "Découvrez Chozeau, au sud-ouest des Balcons du Dauphiné. Cette bourgade offre un cadre champêtre à un patrimoine bâti composé d’un château médiéval, d’une église et d’une maison forte. Vous trouverez aussi l’étang de Chalignieu pour une pause nature."
    ],
    "nl": [
      "Ontdek Chozeau, in het zuidwesten van de Balcons du Dauphiné. Dit dorp biedt een landelijke omgeving met een gebouwd erfgoed bestaande uit een middeleeuws kasteel, een kerk en een versterkt huis. Je vindt er ook het Etang de Chalignieu voor een natuurvakantie."
    ],
    "es": [
      "Descubra Chozeau, en el suroeste de los Balcons du Dauphiné. Este pueblo ofrece un entorno rural con un patrimonio construido que incluye un castillo medieval, una iglesia y una casa fortificada. También encontrará el Etang de Chalignieu para una escapada a la naturaleza."
    ]
  },
