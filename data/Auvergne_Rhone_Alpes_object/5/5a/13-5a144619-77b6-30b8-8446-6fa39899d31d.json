  "rdfs:comment": {
    "de": [
      "Lassen Sie sich von der Intensität des Konzerts geistlicher Musik rund um Pergolesis Stabat Mater und Alessandro Scarlattis Répons de la Semaine Sainte in der Kathedrale Notre-Dame du Puy am 29. März ab 17 Uhr mitreißen."
    ],
    "en": [
      "Let yourself be carried away by the intensity of a sacred music concert featuring Pergolesi?s Stabat Mater and Alessandro Scarlatti?s Répons de la Semaine Sainte, at Notre-Dame du Puy Cathedral on March 29 from 5pm."
    ],
    "it": [
      "Lasciatevi trasportare dall'intensità del concerto di musica sacra con lo Stabat Mater di Pergolesi e i Répons de la Semaine Sainte di Alessandro Scarlatti, presso la Cattedrale di Notre-Dame du Puy il 29 marzo dalle 17.00."
    ],
    "fr": [
      "Laissez-vous emporter par l'intensité du concert de musique sacrée autour du Stabat Mater de Pergolèse et des Répons de la Semaine Sainte d’Alessandro Scarlatti, à la Cathédrale Notre-Dame du Puy le 29 mars dès 17h."
    ],
    "nl": [
      "Laat je meeslepen door de intensiteit van het concert met gewijde muziek van Pergolesi's Stabat Mater en Alessandro Scarlatti's Répons de la Semaine Sainte, in de kathedraal Notre-Dame du Puy op 29 maart vanaf 17.00 uur."
    ],
    "es": [
      "Déjese llevar por la intensidad del concierto de música sacra con el Stabat Mater de Pergolesi y los Répons de la Semaine Sainte de Alessandro Scarlatti, en la catedral de Notre-Dame du Puy, el 29 de marzo a partir de las 17:00 h."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Cathédrale : Stabat Mater & pergolese concert"
    ]
  },
