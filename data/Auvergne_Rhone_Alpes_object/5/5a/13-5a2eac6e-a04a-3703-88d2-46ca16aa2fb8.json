  "rdfs:comment": {
    "de": [
      "Schöner Panoramablick bei der Ankunft auf das Chablais-Massiv (herrlich bei Sonnenuntergang). Start vom Dorf Les Lindarets aus. Ankunft auf dem Gipfel der Crêtes des Lindarets über Brochaux."
    ],
    "en": [
      "Beautiful panoramic view at the summit over the Chablais mountains (especially stunning at sunset).\r\nDeparture from the village of Lindarets. Arrival at the top of the Lindarets Ridge via the Brochaux."
    ],
    "it": [
      "Bellissima vista panoramica sul massiccio dello Chablais all'arrivo (magnifica al tramonto). Partenza dal villaggio di Les Lindarets. Arrivo alla cima delle Crêtes des Lindarets passando per Les Brochaux."
    ],
    "fr": [
      "Belle vue panoramique à l’arrivée sur le massif du Chablais (magnifique à l’heure du coucher du soleil). Départ depuis le village des Lindarets. Arrivée au sommet des Crêtes des Lindarets en passant par les Brochaux."
    ],
    "es": [
      "Preciosas vistas panorámicas del macizo del Chablais a la llegada (magníficas al atardecer). Salida del pueblo de Les Lindarets. Llegada a la cima de las Crêtes des Lindarets por Les Brochaux."
    ],
    "nl": [
      "Prachtig panoramisch uitzicht op het Chablais-gebergte bij aankomst (schitterend tijdens zonsondergang).\r\nVertrek vanaf de voet van de Ardent-gondel of vanuit het dorp Lindarets. Aankomst aan de top van de Lindarets-kam via de Brochaux."
    ]
  },
  "rdfs:label": {
    "en": [
      "Le Vanné ski touring route"
    ],
    "fr": [
      "Itinéraire de ski de randonnée le Vanné"
    ],
    "nl": [
      "Toerskiroute Le Vanné"
    ]
  },
