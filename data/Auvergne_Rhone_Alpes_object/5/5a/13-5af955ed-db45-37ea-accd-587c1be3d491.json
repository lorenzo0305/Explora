  "rdfs:comment": {
    "de": [
      "Der im Herzen von Vizille gelegene Saal Le Jeu de Paume bietet Ihnen ein reichhaltiges und abwechslungsreiches Programm, in dem die Künste des Theaters, des Humors, der Musik und des Tanzes zum Ausdruck kommen."
    ],
    "en": [
      "Located in the heart of Vizille, Le Jeu de Paume offers a rich and varied program of theater, comedy, music and dance."
    ],
    "it": [
      "Situato nel cuore di Vizille, il cinema-teatro Jeu de Paume offre un ricco e variegato programma di spettacoli nell'ambito della sua stagione culturale, con teatro, commedia, musica e danza."
    ],
    "fr": [
      "Située au cœur de Vizille, le ciné-théâtre Le Jeu de Paume vous propose, dans le cadre de sa saison culturelle, une programmation de spectacles, riche et variée, dans laquelle s’expriment les arts du théâtre, de l’humour, de la musique, de la danse."
    ],
    "es": [
      "Situado en el corazón de Vizille, Le Jeu de Paume ofrece una rica y variada programación de teatro, comedia, música y danza."
    ],
    "nl": [
      "Bioscoop-theater Jeu de Paume ligt in het hart van Vizille en biedt een rijk en gevarieerd programma van voorstellingen als onderdeel van het culturele seizoen, met theater, komedie, muziek en dans."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Salle Le Jeu de Paume"
    ]
  },
