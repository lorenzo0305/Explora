  "rdfs:comment": {
    "de": [
      "Das Ermitage Hotel, das im Herzen eines großen Parks liegt, enthüllt eine herzliche und elegante Atmosphäre.\r\nHier ist die Natur allgegenwärtig und deshalb ist die gesamte Dekoration daraus harmonisch genutzt worden, um Ihnen Entspannung und Spaß anzubieten."
    ],
    "en": [
      "Ermitage Hotel, nestled in the heart of a 19-acre park, offers a warm and elegant atmosphere. Here, nature is omnipresent and all the decoration is in harmony, to bring you relaxation and pleasure."
    ],
    "it": [
      "L'Hotel Ermitage, immerso nel cuore di un parco di 19 ettari, emana un'atmosfera calda ed elegante. Qui la natura è onnipresente e l'intero arredamento si ispira armoniosamente ad essa per offrirvi un condensato di relax e piacere."
    ],
    "fr": [
      "L'Hôtel Ermitage, niché au cœur d'un parc de 19 hectares, dégage une atmosphère chaleureuse et élégante. Ici, la nature est omniprésente et l'ensemble de la décoration s'en inspire harmonieusement pour vous offrir un condensé de détente et de plaisirs."
    ],
    "nl": [
      "Hôtel Ermitage, genesteld in het hart van 19 hectare park, ademt een warme en elegante sfeer uit. Hier is de natuur alomtegenwoordig, en het hele decor is er harmonieus op geïnspireerd om je het toppunt van ontspanning en plezier te bieden."
    ],
    "es": [
      "El Hotel Ermitage, enclavado en el corazón de un parque de 19 hectáreas, desprende un ambiente cálido y elegante. Aquí, la naturaleza es omnipresente y toda la decoración se inspira armoniosamente en ella para ofrecerle una versión condensada de la relajación y el placer."
    ]
  },
