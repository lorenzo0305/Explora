  "rdfs:comment": {
    "de": [
      "Als Planer und Organisator Ihrer Naturaktivitäten im Vercors werden unsere Teams von Bergbegleitern Sie auf den richtigen Weg führen."
    ],
    "en": [
      "Our teams of mountain guides will guide you along the right path, designing and organizing your nature activities in the Vercors."
    ],
    "it": [
      "In qualità di ideatori e organizzatori delle vostre attività naturalistiche nel Vercors, i nostri team di guide alpine vi guideranno lungo la strada giusta."
    ],
    "fr": [
      "Concepteur et organisateur de vos activités natures dans le Vercors, nos équipes d'accompagnateurs en montagne seront vous guider sur le bon chemin."
    ],
    "es": [
      "Como creadores y organizadores de sus actividades en la naturaleza en el Vercors, nuestros equipos de guías de montaña le guiarán por el buen camino."
    ],
