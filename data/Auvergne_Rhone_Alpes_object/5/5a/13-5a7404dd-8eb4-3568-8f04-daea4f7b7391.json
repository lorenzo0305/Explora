  "rdfs:comment": {
    "de": [
      "Lassen Sie sich führen, um den Genfersee mit dem Fahrrad mit einem Vermittler des Geoparks Chablais zu erkunden: kommentierte, authentische und inspirierende Entdeckungen, von Halbtagestouren bis zu mehrtägigen Wanderungen."
    ],
    "en": [
      "Let a Chablais Geopark mediator guide you as you explore Lake Geneva by bike: authentic and inspiring guided tours, from half-day to multi-day itineraries."
    ],
    "it": [
      "Lasciatevi guidare alla scoperta del Lago di Ginevra in bicicletta con un mediatore del Geoparco dello Chablais: visite guidate autentiche e stimolanti, da itinerari di mezza giornata a quelli di più giorni."
    ],
    "fr": [
      "Laissez-vous guider pour explorer le Léman à vélo avec un médiateur du Géoparc du Chablais : des découvertes commentées, authentiques et inspirantes, de la demi-journée aux itinérances de plusieurs jours."
    ],
    "nl": [
      "Laat je leiden terwijl je het meer van Genève per fiets verkent met een bemiddelaar van het Chablais Geopark: authentieke en inspirerende rondleidingen, van halve dagen tot meerdaagse routes."
    ],
    "es": [
      "Déjese guiar mientras explora el lago Lemán en bicicleta con un mediador del Geoparque de Chablais: auténticas e inspiradoras visitas guiadas, desde itinerarios de medio día a itinerarios de varios días."
    ]
  },
