  "rdfs:comment": {
    "de": [
      "Gönnen Sie sich den Geist von \"Saint Maurice\" mit unseren Appellationen Côtes du Rhône, Côtes du Rhône Villages Saint Maurice, sowie unseren Crus Vinsobres und nicht zu vergessen unsere Landweine aus der Drôme.\r\nVerkostung und Verkauf im Weinkeller."
    ],
    "en": [
      "Offer yourself the “Saint Maurice” spirit with our appellations in Côtes du Rhône, Côtes du Rhône Villages Saint Maurice and Visan, as well as our Crus Vinsobres, without forgetting our local wines from Drôme.\r\nTasting and sale in the cellar."
    ],
    "it": [
      "Entrate nello spirito di Saint Maurice con le nostre denominazioni Côtes du Rhône, Côtes du Rhône Villages Saint Maurice e Crus Vinsobres, senza dimenticare i nostri vins de Pays de la Drôme.\r\nDegustazione e vendita in cantina."
    ],
    "fr": [
      "Offrez vous l’esprit “Saint Maurice” avec nos appellations en Côtes du Rhône, Côtes du Rhône Villages Saint Maurice, ainsi que nos Crus Vinsobres, sans oublier nos vins de Pays de la Drôme.\r\nDégustation-vente au caveau."
    ],
    "nl": [
      "Trakteer uzelf op \"Saint Maurice\" met onze Côtes du Rhône, Côtes du Rhône Villages Saint Maurice en Visan appellations, evenals onze Crus Vinsobres en niet te vergeten onze vins de Pays de la Drôme.\r\nProeverij en verkoop in de kelder."
    ],
    "es": [
      "Sumérjase en el espíritu de Saint Maurice con nuestras denominaciones Côtes du Rhône, Côtes du Rhône Villages Saint Maurice y Crus Vinsobres, sin olvidar nuestros vins de Pays de la Drôme.\r\nDegustación y venta en la bodega."
    ]
  },
