  "rdfs:comment": {
    "de": [
      "Foodtruck mit guten Waffeln, gepressten Bio-Zitronen aus Italien, Glühwein, Sirupbar und Kaffee! Zu finden vor dem Bauernhof von Sabotdance, neben der Gondelbahn von La Gorge."
    ],
    "en": [
      "Food truck triporter offering good waffles, organic squeezed lemons from Italy, mulled wine, syrup bar and coffee! To be found in front of the Sabotdance farm, next to the Gorge cable car."
    ],
    "it": [
      "Food truck che offre ottimi waffle, limoni biologici spremuti dall'Italia, vin brulè, sciroppo e caffè! Si trova di fronte alla fattoria Sabotdance, accanto alla funivia delle Gole."
    ],
    "fr": [
      "Triporteur food truck proposant des bonnes gaufres, citrons pressés bio d’Italie, vin chaud, bar à sirop et café ! A retrouver devant le ferme des Sabotdance, à côté de la télécabine de la Gorge."
    ],
    "nl": [
      "Foodtruck met lekkere wafels, biologisch geperste citroenen uit Italië, glühwein, stroopbar en koffie! Te vinden voor de Sabotdance boerderij, naast de Gorge kabelbaan."
    ],
    "es": [
      "Food truck que ofrece buenos gofres, limones ecológicos exprimidos de Italia, vino caliente, bar de sirope y café Se encuentra frente a la granja Sabotdance, junto al teleférico del desfiladero."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le repaire des Curioos"
    ]
  },
