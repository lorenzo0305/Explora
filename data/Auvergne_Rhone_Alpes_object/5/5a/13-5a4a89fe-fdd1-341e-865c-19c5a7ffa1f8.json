  "rdfs:comment": {
    "de": [
      "Gönnen Sie sich eine wunderbare Reise in die Geschichte mit den Pferdeshows der Cie des Portes de l'Histoire. Action, Voltigieren, Kämpfe und originelle Kreationen für historische Feste, Museen, Events, immersives Theater und Kinderanimationen"
    ],
    "en": [
      "Treat yourself to a marvelous journey through history with the equestrian shows of Cie des Portes de l'Histoire. Action, acrobatics, combat and original creations for historical festivals, museums, events, immersive theater and children's entertainment"
    ],
    "it": [
      "Fate un meraviglioso viaggio nel tempo con gli spettacoli equestri della Cie des Portes de l'Histoire. Azione, acrobazie, combattimenti e creazioni originali per festival storici, musei, eventi, teatro immersivo e intrattenimento per bambini"
    ],
    "fr": [
      "Offrez vous un merveilleux voyage dans l'Histoire avec les spectacles équestres de la Cie des Portes de l'Histoire. Action, voltige, combats, et créations originales pour fêtes historiques, musées, événementiel, théâtre immersif et animations pour enfants"
    ],
    "es": [
      "Realice un maravilloso viaje en el tiempo con los espectáculos ecuestres de la Cie des Portes de l'Histoire. Acción, acrobacias, combates y creaciones originales para festivales históricos, museos, eventos, teatro de inmersión y entretenimiento infantil"
    ],
    "nl": [
      "Ga terug in de tijd met de ruitershows van de Cie des Portes de l'Histoire. Actie, acrobatiek, gevechten en originele creaties voor historische festivals, musea, evenementen, meeslepend theater en kinderanimatie"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Portes de l'Histoire"
    ]
