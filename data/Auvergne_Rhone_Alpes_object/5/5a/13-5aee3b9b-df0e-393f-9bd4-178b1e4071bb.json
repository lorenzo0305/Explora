  "rdfs:comment": {
    "de": [
      "Das Restaurant le Shiva lädt Sie dazu ein, die Spezialitäten der nordindischen Küche in einer warmen und einladenden Umgebung zu entdecken."
    ],
    "en": [
      "The shiva restaurant intites you to discover typical dishes from nothern India in a warm and welcoming setting."
    ],
    "it": [
      "Il ristorante Shiva vi invita a scoprire le specialità della cucina indiana del Nord in un ambiente caldo e accogliente."
    ],
    "fr": [
      "Le restaurant le Shiva vous invite à découvrir les spécialités de la cuisine du nord de l'Inde dans un cadre chaleureux et accueillant."
    ],
    "nl": [
      "Het restaurant Shiva nodigt u uit om de specialiteiten van de Noord-Indiase keuken te ontdekken in een warme en gastvrije omgeving."
    ],
