  "rdfs:comment": {
    "de": [
      "Neben dem Talent ihrer Fahrer können Sie auch wunderschöne Oldtimer-Cross-Motorräder bewundern, die in den 60er bis 90er Jahren den Ruhm dieser Disziplin begründet haben."
    ],
    "en": [
      "In addition to the talent of their riders, come and admire the magnificent vintage motocross bikes that made the sport famous from the 60s to the 90s."
    ],
    "it": [
      "Oltre al talento dei loro piloti, venite ad ammirare le magnifiche moto da cross d'epoca che hanno reso celebre questo sport dagli anni '60 agli anni '90."
    ],
    "fr": [
      "En plus du talent de leurs pilotes venez admirer de magnifiques motos de cross de collection qui ont fait la gloire de la discipline dans les années 60 à 90."
    ],
    "nl": [
      "Kom naast het talent van hun rijders ook de prachtige vintage crossmotoren bewonderen die de sport beroemd maakten van de jaren 60 tot de jaren 90."
    ],
    "es": [
      "Además del talento de sus pilotos, ven a admirar las magníficas motos de motocross de época que hicieron famoso este deporte desde los años 60 hasta los 90."
    ]
  },
  "rdfs:label": {
    "fr": [
