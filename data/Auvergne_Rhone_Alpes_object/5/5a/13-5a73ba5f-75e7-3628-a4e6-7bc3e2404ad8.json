  "rdfs:comment": {
    "de": [
      "Im Sportgeschäft Skiset des Bottières bietet Lionel Ihnen im Winter den Verleih von Skiern und im Sommer von geländegängigen Elektrorollern, Tennisschlägern, Tischtennisschlägern, Badmintonschlägern und Boulekugeln an!"
    ],
    "en": [
      "At the Skiset sports store in Les Bottières, Lionel rents out skis in winter and all-terrain electric scooters, tennis rackets, table tennis rackets, badminton rackets and boules... in summer."
    ],
    "it": [
      "Presso il negozio di articoli sportivi Skiset a Les Bottières, Lionel noleggia sci in inverno e scooter elettrici fuoristrada, racchette da tennis, racchette da ping pong, racchette da badminton e bocce... in estate!"
    ],
    "fr": [
      "Au magasin de sports Skiset des Bottières, Lionel vous propose la location de skis en hiver et de trottinettes électriques tout terrain, raquettes de tennis, raquettes de ping-pong, raquettes de badminton et boules de pétanques... en été !"
    ],
    "nl": [
      "In de sportwinkel Skiset in Les Bottières verhuurt Lionel ski's in de winter en all-terrain elektrische scooters, tennisrackets, tafeltennisrackets, badmintonrackets en jeu de boules... in de zomer!"
    ],
    "es": [
      "En la tienda de deportes Skiset de Les Bottières, Lionel alquila esquís en invierno y patinetes eléctricos todo terreno, raquetas de tenis, de ping-pong, de bádminton y de petanca... ¡en verano!"
    ]
  },
  "rdfs:label": {
    "en": [
