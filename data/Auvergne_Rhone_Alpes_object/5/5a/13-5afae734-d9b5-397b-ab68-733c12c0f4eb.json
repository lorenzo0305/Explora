  "rdfs:comment": {
    "de": [
      "Die heutige Kirche wurde Mitte des 19. Jahrhunderts von einem Ingenieur und aus Turin stammenden Künstlern und Handwerkern nach dem Kanon der sardischen neoklassizistischen Architektur wiederaufgebaut."
    ],
    "en": [
      "The present church was rebuilt in the mid-19th century by an engineer and artists and craftsmen from Turin, according to the canons of Sardinian neoclassical architecture."
    ],
    "it": [
      "L'attuale chiesa fu ricostruita a metà Ottocento da un ingegnere e da artisti e artigiani torinesi, seguendo i canoni dell'architettura neoclassica sarda."
    ],
    "fr": [
      "L'église actuelle fut reconstruite au milieu du XIXe siècle par un ingénieur et des artistes et artisans originaires de Turin, selon les canons de l'architecture néoclassique sarde."
    ],
    "es": [
      "La iglesia actual fue reconstruida a mediados del siglo XIX por un ingeniero y artistas y artesanos de Turín, siguiendo los cánones de la arquitectura neoclásica sarda."
    ],
    "nl": [
      "De huidige kerk werd halverwege de negentiende eeuw herbouwd door een ingenieur en kunstenaars en ambachtslieden uit Turijn, volgens de canons van de Sardijnse neoklassieke architectuur."
    ]
  },
  "rdfs:label": {
    "en": [
      "Saint-Peters church"
    ],
    "fr": [
      "Eglise Saint-Pierre"
    ]
  },
