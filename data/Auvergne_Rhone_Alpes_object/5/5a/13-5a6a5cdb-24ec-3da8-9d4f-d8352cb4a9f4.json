  "rdfs:comment": {
    "de": [
      "Restaurant, Wein-, Bier-, Rum-, Whisky- und Cocktailbar... Gastronomie von hier und anderswo auf der Grundlage frischer Produkte. Bretter und Überbackenes im Bistro-Stil. 2 klimatisierte Räume und eine Dachterrasse mit Blick auf die Berge."
    ],
    "en": [
      "Restaurant, wine, beer, whisky, rhum, bar \r\nLocal And elsewhere cooking dithyrambique Fresh products \r\nPlanches and gratin on bistrot way \r\nOpen every lunch time unless wednesday and saturday \r\nAt night open thursday friday saturday \r\nEnglish spoken"
    ],
    "it": [
      "Ristorante, wine bar, beer bar, rum bar, whisky bar, cocktail... Catering da qui e altrove con prodotti freschi. 2 camere climatizzate e una terrazza sui tetti con vista sulle montagne."
    ],
    "fr": [
      "Restaurant, Bar à vin, à bières, à rhum, whisky, cocktails... Restauration d’ici et d’ailleurs  à base produits frais. Planches et gratinées en mode bistrot. 2 salles climatisées et une terrasse sur les toits avec vue sur les montagnes."
    ],
    "es": [
      "Restaurante, bar de vinos, bar de cervezas, bar de ron, bar de whisky, cócteles... Catering de aquí y de otros lugares con productos frescos. 2 habitaciones con aire acondicionado y una terraza en los tejados con vistas a las montañas."
    ],
    "nl": [
      "Restaurant, wijnbar, bieren, rhum, whisky, coctails... Keuken van hier en verder, op basis van verse produkten. Planken en in de oven beriede gerechten, in een bistrot-stijl. 2 zalen met air-conditioning en een terras op het dak met zicht op de bergen."
    ]
  },
