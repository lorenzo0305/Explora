  "rdfs:comment": {
    "de": [
      "In diesem Waschsalon stehen Ihnen 4 Waschmaschinen mit einem Fassungsvermögen von 8 kg und 1 Waschmaschine mit einem Fassungsvermögen von 18 kg zur Verfügung, mit der Sie Ihre Bettdecken und Steppdecken reinigen können. Außerdem finden Sie hier 2 große Trockner und einen Waschmittelspender."
    ],
    "en": [
      "The launderette has 4 8 kg washing machines and 1 18 kg washing machine for cleaning comforters and blankets. You'll also find 2 large dryers and a detergent dispenser."
    ],
    "it": [
      "Questa lavanderia dispone di 4 lavatrici da 8 kg, 1 lavatrice da 18 kg che vi permetterà di pulire piumoni e coperte. Troverete anche 2 grandi asciugatrici e un distributore di detersivo."
    ],
    "fr": [
      "Cette laverie met à votre disposition 4 machines à laver de 8 kg, 1 machine à laver de 18 kg qui vous permettra le nettoyage de couettes et couvertures. Vous trouverez également 2 gros séchoirs et un distributeur de lessive."
    ],
    "es": [
      "Esta lavandería cuenta con 4 lavadoras de 8 kg, 1 lavadora de 18 kg que le permitirá limpiar edredones y mantas. También encontrará 2 secadoras grandes y un dispensador de detergente."
    ],
    "nl": [
      "De wasserette heeft 4 wasmachines van 8 kg en 1 wasmachine van 18 kg voor het reinigen van dekbedden en dekens. Er zijn ook 2 grote wasdrogers en een wasmiddeldispenser."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Laverie Wash'N'Dry"
    ]
  },
