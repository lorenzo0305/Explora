  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/2bdf323d-d535-30de-9649-632077eb51cc",
      "dc:description": {
        "de": [
          "Entdecken Sie die Konfitüre von Appoline: Eine Gourmet-Reise mit jedem Löffel!\n\nBereiten Sie Ihre Geschmacksknospen auf eine hausgemachte Köstlichkeit vor, die jedes Frühstück, jeden Snack oder jede süße Pause in einen magischen Moment verwandelt!"
        ],
        "en": [
          "Discover Confiture d'Appoline: a gourmet journey with every spoon!\n\nPrepare your taste buds for a homemade delight that transforms every breakfast, snack or sweet break into a magical moment!"
        ],
        "it": [
          "Scoprite la marmellata di Appoline: un viaggio gastronomico ad ogni cucchiaio!\n\nPreparate le vostre papille gustative per una delizia fatta in casa che trasforma ogni colazione, merenda o pausa dolce in un momento magico!"
        ],
        "fr": [
          "Découvrez la Confiture d'Appoline : un Voyage Gourmand à Chaque Cuillère !\n\nPréparez vos papilles à un délice fait maison qui transforme chaque petit-déjeuner, goûter ou pause sucrée en un instant magique !"
        ],
        "nl": [
          "Ontdek Appoline's jam: een gastronomische reis met elke lepel!\n\nBereid je smaakpapillen voor op een huisgemaakte lekkernij die van elk ontbijt, tussendoortje of zoete pauze een magisch moment maakt!"
        ],
        "es": [
          "Descubra la mermelada de Appoline: ¡un viaje gourmet con cada cuchara!\n\n¡Prepare sus papilas gustativas para una delicia casera que transforma cada desayuno, merienda o pausa dulce en un momento mágico!"
        ]
      },
      "@type": [
        "Description"
      ],
