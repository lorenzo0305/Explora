  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/bde1637f-9316-3aa9-b749-8452c40a91cf",
      "dc:description": {
        "de": [
          "Informationen :\n\nÖffnungstage :\n \nMittwochs, freitags und samstags von 7.30 bis 14.00 Uhr\n \n Bestellungen:\n\nKontaktieren Sie die Bäckerei unter 0321225425. Die Bäckerei ist von Dienstag bis Samstag von 7:30 bis 18:30 Uhr telefonisch erreichbar. Bitte bestellen Sie mindestens am Vortag für den nächsten Tag.\n\nLieferung :"
        ],
        "en": [
          "Information :\n\nOpening days :\n \nWednesday, Friday and Saturday from 7:30 am to 2:00 pm\n \n Orders :\n\nContact the bakery at 0321225425. The bakery is open by phone from Tuesday to Saturday, 7.30am to 6.30pm. Please order at least the day before for the following day.\n\nDelivery :"
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura :\n \nMercoledì, venerdì e sabato, dalle 7.30 alle 14.00\n \n Ordini :\n\nContattare il panificio all'indirizzo 0321225425. La panetteria è raggiungibile telefonicamente dal martedì al sabato dalle 7.30 alle 18.30. Si prega di ordinare almeno il giorno prima per il giorno successivo.\n\nConsegna :"
        ],
        "fr": [
          "Informations :\n\nJours d'ouverture : \n \nLe mercredi, le vendredi et le samedi de 7h30 à 14h00\n \n Commandes :\n\nContacter la boulangerie au 0321225425. La boulangerie est joignable par téléphone du mardi au samedi de 7h30 à 18h30. Veuillez au minimum commander la veille pour le lendemain.\n\nLivraison :"
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen :\n \nWoensdag, vrijdag en zaterdag van 7.30 tot 14.00 uur\n \n Bestellingen :\n\nNeem contact op met de bakkerij op 0321225425. De bakkerij is telefonisch bereikbaar van dinsdag tot en met zaterdag van 7.30 tot 18.30 uur. Bestel ten minste de dag van tevoren voor de volgende dag.\n\nLevering :"
        ],
        "es": [
          "Más información :\n\nDías de apertura :\n \nMiércoles, viernes y sábados de 7h30 a 14h00\n \n Pedidos :\n\nPóngase en contacto con la panadería en 0321225425. Puede ponerse en contacto con la panadería por teléfono de martes a sábado de 7.30 a 18.30. Se ruega hacer el pedido al menos la víspera para el día siguiente.\n\nEntrega :"
        ]
      },
