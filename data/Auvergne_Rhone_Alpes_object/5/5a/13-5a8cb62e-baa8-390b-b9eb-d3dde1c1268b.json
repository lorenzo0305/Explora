  "rdfs:comment": {
    "de": [
      "Keramikstücke, die Ihr Zuhause erhellen, durch ihre Farben, durch Dekorationen, die von der Natur und der naiven Kunst inspiriert sind. Jede Töpferei ist ein Original. Individuelle Gestaltung ist möglich. Einzelunterricht für Gruppen oder Familien, Besuch des Ateliers."
    ],
    "en": [
      "Ceramic pieces with colours, floral and modern designs to  brighten up your home. Each piece is steeped in  originality making it unique. Customisation available. Individual lessons and visits to the workshop."
    ],
    "it": [
      "Pezzi di ceramica che rallegrano la casa, con i loro colori e decori ispirati alla natura e all'arte naïf. Ogni pezzo di ceramica è originale. Possibilità di personalizzazione. Corsi individuali per gruppi o famiglie, visita del laboratorio."
    ],
    "fr": [
      "Pièces en céramiques qui éclairent vos maisons, par leurs couleurs, par des décoration inspirées de la nature et de l'art naïf. Chaque poterie est originale. Personnalisation possible. Cours individuels par groupe ou famille, visite de l'atelier."
    ],
    "es": [
      "Piezas de cerámica que alegran tu hogar, con sus colores y decoraciones inspiradas en la naturaleza y el arte naif. Cada pieza de cerámica es original. Posibilidad de personalización. Cursos individuales para grupos o familias, visita del taller."
    ],
    "nl": [
      "Keramische stukken die je huis opfleuren met hun kleuren en decoraties geïnspireerd door de natuur en naïeve kunst. Elk stuk is origineel. Maatwerk mogelijk. Individuele lessen voor groepen of families en atelierbezoeken."
    ]
  },
  "rdfs:label": {
    "en": [
      "La Poterie des Anges"
    ],
    "fr": [
      "La Poterie des Anges"
    ]
  },
