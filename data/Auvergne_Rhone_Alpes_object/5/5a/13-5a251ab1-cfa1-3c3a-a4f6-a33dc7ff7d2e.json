  "rdfs:comment": {
    "de": [
      "Das im Herzen des Dorfes gelegene Le Chalet Gourmand empfängt Sie in einem warmen und modernen Ambiente. Der Chefkoch bietet Ihnen eine kreative und leckere Küche, Spezialitäten aus den Bergen sowie Pizzas aus dem Holzofen vor Ort oder zum Mitnehmen."
    ],
    "en": [
      "Located in the heart of the village, the Chalet Gourmand welcomes you in a warm and modern atmosphere. The chef offers creative and gourmet cuisine, mountain specialities as well as wood-fired pizzas to eat in or take away."
    ],
    "it": [
      "Situato nel cuore del villaggio, lo Chalet Gourmand vi accoglie in un'atmosfera calda e moderna. Lo chef propone una cucina creativa e gourmet, specialità di montagna e pizze cotte a legna da mangiare o da portare via."
    ],
    "fr": [
      "Situé au cœur du village, le Chalet Gourmand vous accueille dans une ambiance chaleureuse et moderne. Le chef vous propose une cuisine créative et gourmande, des spécialités montagnardes ainsi que des pizzas au feu de bois sur place ou à emporter."
    ],
    "es": [
      "Situado en el corazón del pueblo, el Chalet Gourmand le da la bienvenida en un ambiente cálido y moderno. El chef ofrece cocina creativa y gourmet, especialidades de montaña y pizzas al horno de leña para comer en casa o para llevar."
    ],
    "nl": [
      "Het Chalet Gourmand ligt in het hart van het dorp en verwelkomt u in een warme en moderne sfeer. De chef biedt creatieve en gastronomische gerechten, bergspecialiteiten en houtgestookte pizza's om te eten of mee te nemen."
    ]
  },
