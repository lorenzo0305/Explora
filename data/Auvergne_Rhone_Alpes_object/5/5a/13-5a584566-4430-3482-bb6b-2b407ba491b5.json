  "rdfs:comment": {
    "de": [
      "Engins Passion ist ein Verein, der Sammler von Baumaschinen zusammenbringt. Die ausgestellten Oldtimer-Maschinen werden am Tag der Veranstaltung in einem Steinbruch betrieben."
    ],
    "en": [
      "Engins Passion is an association of public works machinery collectors. The vintage machines on display will be working in a quarry on the day of the event."
    ],
    "it": [
      "Engins Passion è un'associazione di collezionisti di macchine per lavori pubblici. Le macchine d'epoca esposte saranno al lavoro in una cava il giorno dell'evento."
    ],
    "fr": [
      "Engins Passion est une association qui regroupe des collectionneurs de machines de travaux publics. Les machines de collection exposées fonctionneront dans une carrière le jour de la manifestation."
    ],
    "nl": [
      "Engins Passion is een vereniging van verzamelaars van machines voor openbare werken. De tentoongestelde vintage machines zullen op de dag van het evenement in een steengroeve werken."
    ],
    "es": [
      "Engins Passion es una asociación de coleccionistas de maquinaria de obras públicas. Las máquinas de época expuestas trabajarán en una cantera el día del evento."
    ]
  },
