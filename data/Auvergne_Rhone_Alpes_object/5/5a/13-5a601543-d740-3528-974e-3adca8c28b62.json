  "rdfs:comment": {
    "de": [
      "Das Théâtre de Villefranche bietet einen schönen Saal mit 650 Plätzen, in dem das ganze Jahr über ein multidisziplinäres Programm stattfindet (Theater, Zirkus, Tanz, Musik, Aufführungen für junge Zuschauer...)."
    ],
    "en": [
      "The theater of Villefranche offers of a magnificent 650-seat theatre which hosts several different programmes throughout the year (theatre, circus, dance, music, shows for young audiences, etc.)."
    ],
    "it": [
      "Il Théâtre de Villefranche offre un bellissimo teatro da 650 posti che ospita un programma multidisciplinare tutto l'anno (teatro, circo, danza, musica, spettacoli per il pubblico giovane, ecc.)"
    ],
    "fr": [
      "Le Théâtre de Villefranche offre une belle salle de 650 places qui accueille à l'année une programmation pluridisciplinaire (théâtre, cirque, danse, musique, spectacles jeune public...)."
    ],
    "nl": [
      "Het Théâtre de Villefranche beschikt over een prachtig theater met 650 plaatsen waar het hele jaar door een multidisciplinair programma wordt aangeboden (theater, circus, dans, muziek, voorstellingen voor een jong publiek, enz.)"
    ],
    "es": [
      "El Théâtre de Villefranche ofrece un hermoso teatro de 650 plazas que acoge una programación multidisciplinar durante todo el año (teatro, circo, danza, música, espectáculos para el público joven, etc.)."
    ]
  },
