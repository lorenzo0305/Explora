  "rdfs:comment": {
    "de": [
      "Die Mediathek wird vom Verein Montélier Je Lis verwaltet und von einer Gemeindeangestellten unterstützt. Sie bietet Bücher und CDs sowie einen kostenlosen Internetzugang."
    ],
    "en": [
      "Managed by the Montélier Je Lis association, with the support of a local employee, the media library offers books and CDs, as well as free Internet access."
    ],
    "it": [
      "Gestita dall'associazione Montélier Je Lis con il supporto di un dipendente locale, la mediateca offre libri e CD, oltre a un punto di accesso gratuito a Internet."
    ],
    "fr": [
      "Gérée par l'association Montélier Je Lis avec l'appui d'une salariée communale, la médiathèque propose des livres et CD, ainsi qu'un poste d'accès à internet gratuit."
    ],
    "es": [
      "Gestionada por la asociación Montélier Je Lis con el apoyo de un empleado local, la mediateca ofrece libros y CDs, así como un punto de acceso gratuito a Internet."
