  "rdfs:comment": {
    "de": [
      "Das Café de la Mairie empfängt Sie am Place de la Mairie in Riom-ès-Montagnes. Hier können Sie hausgemachte Gerichte genießen, die aus lokalen Produkten hergestellt werden."
    ],
    "en": [
      "Café de la Mairie welcomes you to Place de la Mairie in Riom-ès-Montagnes. Enjoy home-cooked dishes made with local produce."
    ],
    "it": [
      "Il Café de la Mairie vi dà il benvenuto in Place de la Mairie a Riom-ès-Montagnes. Gustate i piatti preparati in casa con prodotti locali."
    ],
    "fr": [
      "Le Café de la Mairie vous accueille Place de la Mairie à Riom-ès-Montagnes. Vous pourrez déguster des plats maison confectionnés avec des produits locaux."
    ],
    "es": [
      "El Café de la Mairie le da la bienvenida en la Place de la Mairie de Riom-ès-Montagnes. Disfrute de platos caseros elaborados con productos locales."
    ],
    "nl": [
      "Café de la Mairie heet je welkom op Place de la Mairie in Riom-ès-Montagnes. Geniet van huisgemaakte gerechten met lokale producten."
    ]
  },
