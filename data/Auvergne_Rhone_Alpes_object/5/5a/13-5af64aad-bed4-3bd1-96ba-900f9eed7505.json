  "rdfs:comment": {
    "de": [
      "Das Restaurant verfügt über eine schattige Holzterrasse mit Blick auf den Fluss. Hier können Sie Friture d'Ablette, Bachforelle (auf Bestellung), Charolais-Fleisch und viele andere regionale Produkte probieren..."
    ],
    "en": [
      "The retaurant has a shaded wooden terrase overlooking the river. You will taste: Friture d'Ablette, trout fario ( on order),and many other regional products"
    ],
    "it": [
      "Il ristorante dispone di una terrazza in legno ombreggiata che si affaccia sul fiume. Qui potrete assaggiare l'Ablette friture, la trota fario (su ordinazione), la carne Charolais e molti altri prodotti regionali..."
    ],
    "fr": [
      "Le restaurant dispose d'une terrasse en bois ombragée surplombant la rivière. Vous y dégusterez de la friture d'Ablette, de la truite fario (sur commande), viande de charolais,  et bien d'autres produits régionaux..."
    ],
    "nl": [
      "Het restaurant heeft een schaduwrijk houten terras met uitzicht op de rivier. Hier kun je Ablette friture, fario forel (op bestelling), Charolais vlees en vele andere regionale producten proeven..."
    ],
    "es": [
      "El restaurante dispone de una terraza de madera sombreada con vistas al río. Aquí podrá degustar Ablette friture, trucha fario (por encargo), carne charolesa y muchos otros productos regionales..."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Gorges de Chouvigny"
    ]
  },
