  "rdfs:comment": {
    "de": [
      "Entdecken Sie Montluçon auf einem spannenden Spaziergang durch die symbolträchtigsten Orte der Stadt.\r\nNur mit Reservierung. Der Rundgang beginnt bei einer Mindestteilnehmerzahl von 4 Personen."
    ],
    "en": [
      "Discover Montluçon through a captivating stroll around its most emblematic sites.\r\nReservations required. Tours depart with a minimum of 4 people."
    ],
    "it": [
      "Scoprite Montluçon con un tour accattivante dei suoi luoghi più emblematici.\r\nPrenotazione obbligatoria. I tour partono con un minimo di 4 persone."
    ],
    "fr": [
      "Partez à la découverte de Montluçon à travers une balade captivante au cœur de ses lieux les plus emblématiques. \r\nSur réservation. Départ de la visite avec un minimum de 4 personnes."
    ],
    "nl": [
      "Ontdek Montluçon tijdens een boeiende tour langs de meest karakteristieke plekken.\r\nReserveren is noodzakelijk. Tours vertrekken met een minimum van 4 personen."
    ],
    "es": [
      "Descubra Montluçon en un cautivador recorrido por sus lugares más emblemáticos.\r\nImprescindible reservar. Las visitas salen con un mínimo de 4 personas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite guidée : Il était une fois L'incontournable Montluçon"
    ]
  },
