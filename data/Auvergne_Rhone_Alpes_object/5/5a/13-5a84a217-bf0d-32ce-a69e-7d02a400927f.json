  "rdfs:comment": {
    "de": [
      "Das Théâtre Le Guignol de Lyon liegt im Herzen der Altstadt von Lyon, nur wenige Schritte vom Bahnhof Saint-Paul entfernt, und ist der historische Ort der Lyoner Marionette."
    ],
    "en": [
      "The company M.A. takes over the Zonzons, to propose shows of Guignol and puppets of all kinds. They are artists, puppet researchers of all kinds, from yesterday, today, and tomorrow."
    ],
    "it": [
      "Situato nel cuore della Vieux Lyon, a pochi passi dalla stazione Gare Saint-Paul, il Théâtre Le Guignol de Lyon è la sede storica del teatro delle marionette di Lione."
    ],
    "fr": [
      "Situé au cœur du Vieux Lyon, à deux pas de la gare Saint-Paul, le Théâtre Le Guignol de Lyon est le lieu historique de la marionnette lyonnaise."
    ],
    "es": [
      "Situado en el corazón del Vieux Lyon, a dos pasos de la estación Gare Saint-Paul, el Théâtre Le Guignol de Lyon es la sede histórica del teatro de marionetas lionés."
    ],
    "nl": [
      "Het Théâtre Le Guignol de Lyon ligt in het hart van Vieux Lyon, op een steenworp afstand van het station Gare Saint-Paul, en is de historische thuisbasis van het poppentheater van Lyon."
    ]
  },
