  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/b30a9ff1-0279-3c10-884f-a20d479689eb",
      "dc:description": {
        "de": [
          "Deux Caps Découverte bietet Ihnen den Verleih von Mountainbikes und Elektro-Mountainbikes zur freien Verfügung, aber auch in Begleitung eines Führers, der Ihnen die Sehenswürdigkeiten der Deux Caps näher bringt."
        ],
        "en": [
          "Deux Caps Découverte offers you the possibility of renting mountain bikes and electric bikes, but also accompanied by a guide who will help you discover the Deux Caps site."
        ],
        "it": [
          "Deux Caps Découverte offre il noleggio gratuito di mountain bike e biciclette elettriche, nonché visite guidate al sito di Deux Caps."
        ],
        "fr": [
          "Deux Caps Découverte vous propose la location de VTC et VTT électrique libre mais aussi accompagnées d'un guide qui vous fera découvrir le site des Deux Caps."
        ],
        "nl": [
          "Deux Caps Découverte verhuurt gratis mountainbikes en elektrische fietsen, en biedt rondleidingen over het terrein van Deux Caps."
        ],
        "es": [
          "Deux Caps Découverte ofrece alquiler gratuito de bicicletas de montaña y eléctricas, así como visitas guiadas al paraje de Deux Caps."
        ]
      },
