  "rdfs:comment": {
    "de": [
      "Mit Arlette und Marc Simon, Keramiker. Verschiedene Techniken der Formgebung, Modellieren, Tauben, Platten, Arbeiten in der Masse, Dekor, Emaillieren. Raku- und Sigillata-Brände."
    ],
    "en": [
      "With ceramists Arlette and Marc Simon. Various shaping techniques, modelling, colombins, slab, bodywork, decoration, glazing. Raku and sigillata firing."
    ],
    "it": [
      "Con i ceramisti Arlette e Marc Simon. Varie tecniche di modellazione, modellazione, colombine, lastre, lavorazione del corpo, decorazione, smaltatura. Cotture raku e sigillate."
    ],
    "fr": [
      "Avec Arlette et Marc Simon, céramistes. Diverses techniques de façonnage, modelage, colombins, plaque, travail dans la masse, décor, émaillage. Cuissons raku et sigillée."
    ],
    "nl": [
      "Met keramisten Arlette en Marc Simon. Diverse vormgevingstechnieken, boetseren, colombins, plakken, werken in het lichaam, decoratie, emailleren. Raku en gezandstraald stoken."
    ],
    "es": [
      "Con los ceramistas Arlette y Marc Simon. Diversas técnicas de modelado, colombinas, losas, trabajo en el cuerpo, decoración, esmaltado. Cocciones de rakú y sigilado."
    ]
  },
