  "rdfs:comment": {
    "de": [
      "Die Brasserie le Coè Bou empfängt Sie in einem angenehmen Rahmen und bietet Ihnen köstliche Gerichte, die mit frischen und lokalen Produkten zubereitet werden. Es erwartet Sie eine abwechslungsreiche traditionelle Küche."
    ],
    "en": [
      "Brasserie le Coè Bou welcomes you in a pleasant setting to enjoy delicious dishes prepared with fresh, local produce. A wide variety of traditional cuisine awaits you."
    ],
    "it": [
      "La Brasserie le Coè Bou vi accoglie in un ambiente piacevole per gustare piatti deliziosi preparati con prodotti freschi e locali. Vi attende un'ampia varietà di piatti della cucina tradizionale."
    ],
    "fr": [
      "La Brasserie le Coè Bou vous accueille dans un cadre agréable et vous propose de déguster de délicieux plats cuisinés avec des produits frais et locaux. Une cuisine traditionnelle très variée vous attend."
    ],
    "nl": [
      "Brasserie le Coè Bou verwelkomt je in een aangename omgeving om te genieten van heerlijke gerechten bereid met verse, lokale producten. Er wacht u een grote verscheidenheid aan traditionele gerechten."
    ],
    "es": [
      "Brasserie le Coè Bou le da la bienvenida en un ambiente agradable para disfrutar de deliciosos platos preparados con productos frescos y locales. Le espera una amplia variedad de cocina tradicional."
    ]
  },
  "rdfs:label": {
