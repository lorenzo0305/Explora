  "rdfs:comment": {
    "de": [
      "Verkauf von selbst hergestelltem Käse im Laden: Salers, Cantal, Bleu d'Auvergne... Kostenlose Verkostung. Führungen durch den Betrieb das ganze Jahr über."
    ],
    "en": [
      "Sale in the shop of cheeses made by us : Salers, Cantal, Bleu d'Auvergne... Free tasting. Guided tours of the farm throughout the year."
    ],
    "it": [
      "Vendita in negozio di formaggi di nostra produzione: Salers, Cantal, Bleu d'Auvergne... Degustazione gratuita. Visite guidate alla fattoria durante tutto l'anno."
    ],
    "fr": [
      "Vente au magasin des fromages fabriqués par nos soins : Salers, Cantal, Bleu d'Auvergne... Dégustation gratuite. Prestations de visites guidées de l'exploitation tout au long de l'année."
    ],
    "nl": [
      "Verkoop in de winkel van door ons gemaakte kazen: Salers, Cantal, Bleu d'Auvergne... Gratis proeven. Rondleidingen op de boerderij gedurende het hele jaar."
    ],
    "es": [
      "Venta en la tienda de quesos de elaboración propia: Salers, Cantal, Bleu d'Auvergne... Degustación gratuita. Visitas guiadas a la granja durante todo el año."
    ]
  },
