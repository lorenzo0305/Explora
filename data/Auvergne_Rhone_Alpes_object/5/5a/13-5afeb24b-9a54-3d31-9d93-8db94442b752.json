  "rdfs:comment": {
    "de": [
      "Les Lanchettes beginnt im Ort auf der Höhe der Residenz La Grange aux fées und führt zu einem hohen Teil des Skigebiets von Valmorel mit dem Bergrestaurant la vache orange auf dem Gipfel.\r\nIm Sommer und Winter zu Fuß, auf Skiern oder mit dem Fahrrad erreichbar!"
    ],
    "en": [
      "The Lanchettes chairlift leaves the resort at the La Grange aux fées residence and takes you to the top of the Valmorel ski area, with the orange cow restaurant at the top.\r\nAccessible in summer and winter, on foot, skis or bike!"
    ],
    "it": [
      "Les Lanchettes parte dal resort presso la residenza La Grange aux fées e arriva in cima al comprensorio sciistico di Valmorel, con il ristorante d'alta quota La Vache Orange in vetta.\r\nAccessibile in estate e in inverno, a piedi, con gli sci o in bicicletta!"
    ],
    "fr": [
      "Les Lanchettes part de la station au niveau de la résidence La Grange aux fées pour arriver sur une partie haute du domaine skiable de Valmorel avec le restaurant d'altitude la vache orange au sommet.\r\nAccessible été et hiver, à pied, en ski ou en vélo !"
    ],
    "es": [
      "Les Lanchettes sale de la estación en la residencia La Grange aux fées y llega a la cima del dominio esquiable de Valmorel, con el restaurante de altura La Vache Orange en la cumbre.\r\nAccesible tanto en verano como en invierno, a pie, con esquís o en bicicleta"
    ],
    "nl": [
      "De stoeltjeslift Lanchettes verlaat het skioord bij de residentie La Grange aux fées en brengt je naar de top van het skigebied van Valmorel, met bovenaan het restaurant van de oranje koe.\r\nToegankelijk in zomer en winter, te voet, op ski's of op de fiets!"
    ]
  },
