  "rdfs:comment": {
    "de": [
      "Wie kann man die Liebe in der Literatur erzählen? Wie kann man die Worte tanzen lassen? Beantworten Sie diese Fragen in einem Schreibkurs zum Thema Liebe!"
    ],
    "en": [
      "How do you tell the story of love in literature? How do you make words dance? Answer these questions during a writing workshop dedicated to love!"
    ],
    "it": [
      "Come si racconta l'amore in letteratura? Come si fa a far danzare le parole? Rispondete a queste domande in un corso di scrittura dedicato all'amore!"
    ],
    "fr": [
      "Par quels biais raconter l’amour en littérature ? Comment faire danser les mots ? Répondez à ces questions lors d'un stage d'écriture dédié à l'amour !"
    ],
    "es": [
      "¿Cómo se cuenta el amor en la literatura? ¿Cómo hacer bailar las palabras? Responda a estas preguntas en un curso de escritura dedicado al amor"
    ],
    "nl": [
      "Hoe vertel je het verhaal van de liefde in literatuur? Hoe laat je woorden dansen? Beantwoord deze vragen tijdens een schrijfcursus over de liefde!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Atelier d'écriture - stage d'été 2026 : \"L'amour des mots, les mots de l'amour\""
    ]
  },
