  "rdfs:comment": {
    "de": [
      "Käse, Milch, Fässer aus Villard de Lans und Käse von anderen Genossenschaften aus Savoyen, dem Jura oder der Schweiz sowie Ziegenkäse von lokalen Produzenten (Saint Bardoux, Montmiral, Rochefort Samson..)."
    ],
    "en": [
      "Cheeses, milk, Villard de Lans cottage cheese and cheeses from other cooperatives in Savoy, the Jura and Switzerland, as well as goat's milk cheeses from local farmers (Saint Bardoux, Montmiral, Rochefort Samson, among others)."
    ],
    "it": [
      "Formaggi cooperativi e di altre cooperative della Savoia, del Giura e della Svizzera, nonché formaggi di capra e di pecora di produttori locali.\r\nCremeria, gastronomia, birre artigianali, salumi, carni, ecc."
    ],
    "fr": [
      "Fromages de coopérative,  et fromages d’autres coopératives de Savoie, du Jura ou de Suisse ainsi que des fromages de chèvres et de brebis par des producteurs locaux.\r\nCrémerie, épicerie fine, bières artisanales, charcuteries, viandes etc..."
    ],
    "es": [
      "Quesos de cooperativas y quesos de otras cooperativas de Saboya, el Jura y Suiza, así como quesos de cabra y oveja de productores locales.\r\nCremería, charcutería, cervezas artesanales, charcutería, carnes, etc."
    ],
    "nl": [
      "Kaas, melk, faisselle uit Villard de Lans en kazen van andere coöperaties in de Savoie, de Jura en Zwitserland, en geitenkazen van lokale producenten (Saint Bardoux, Montmiral, Rochefort Samson, etc.)."
    ]
  },
