  "rdfs:comment": {
    "de": [
      "Von Mizoën aus erfolgt der Aufstieg über Schäferpfade, wobei Sie am Ziel einen Blick auf die majestätische Meije haben. Sie überqueren einen großen Teil des Plateaus und steigen durch das bezaubernde Dorf Besse ab, bevor Sie auf der Straße nach Mizoën zurückkehren."
    ],
    "en": [
      "The ride from Mizoën goes gradually up a 4WD track, with a wonderful view over the Meije on at the top. You can then cycle over a large part of the plateau and go down via the beautiful village of Besse and then on to Mizoën on the road."
    ],
    "it": [
      "Da Mizoën si sale attraverso sentieri pastorali, con vista sulla maestosa Meije all'arrivo, si attraversa gran parte dell'altopiano e si scende attraverso il delizioso villaggio di Besse prima di tornare a Mizoën su strada."
    ],
    "fr": [
      "Depuis Mizoën, la montée se fait par les pistes pastorales, avec à l'arrivée une vue sur la majestueuse Meije, vous traverserez une grande partie du plateau et descendrez par le ravissant village de Besse avant de revenir à Mizoën par la route."
    ],
    "nl": [
      "Vanuit Mizoën klimt u via de rustige, pastorale weg die bij aankomst op het plateau een prachtig panorama biedt op de machtige Meije.  Steek een groot deel van het plateau over en daal af via het schitterend dorpje Besse en vervolgens Mizoën langs de baan."
    ],
    "es": [
      "Desde Mizoën, el ascenso se realiza por pistas pastorales, con vistas al majestuoso Meije a la llegada. Se atraviesa gran parte de la meseta y se desciende por el encantador pueblo de Besse antes de regresar a Mizoën por carretera."
    ]
  },
  "rdfs:label": {
    "en": [
      "The Emparis Plateau by e-bike"
    ],
    "fr": [
      "Le plateau d'Emparis en vélo électrique"
    ],
    "nl": [
      "Het plateau d'Emparis met de e-bike"
    ]
  },
