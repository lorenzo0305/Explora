  "rdfs:comment": {
    "de": [
      "Entdecken Sie in Chichilianne (Trièves) die BIO-Blumenfarm Les Jardins de Traverses. Giulia öffnet Ihnen die Türen ihrer geheimen Gärten für einen Moment außerhalb der Zeit, ein echtes Eintauchen in die pulsierende Welt der verantwortungsvollen und saisonalen Blumenzucht."
    ],
    "en": [
      "In Chichilianne (Trièves), discover Les Jardins de Traverses, an organic flower farm. Giulia opens the doors of her secret gardens for a moment out of time, a true immersion in the vibrant world of responsible, seasonal floriculture."
    ],
    "it": [
      "A Chichilianne (Trièves), scoprite Les Jardins de Traverses, un'azienda floricola biologica. Giulia vi apre le porte dei suoi giardini segreti per un momento senza tempo, una vera e propria immersione nel vivace mondo della floricoltura responsabile e stagionale."
    ],
    "fr": [
      "À Chichilianne (Trièves), découvrez Les Jardins de Traverses, ferme florale BIO. Giulia vous ouvre les portes de ses jardins secrets pour un moment hors du temps, une véritable immersion dans le monde vibrant de la floriculture responsable et de saison."
    ],
    "nl": [
      "Ontdek in Chichilianne (Trièves) Les Jardins de Traverses, een biologische bloemenkwekerij. Giulia opent de deuren van haar geheime tuinen voor je voor een tijdloos moment, een echte onderdompeling in de bruisende wereld van verantwoorde, seizoensgebonden bloementeelt."
    ],
    "es": [
      "En Chichilianne (Trièves), descubra Les Jardins de Traverses, una granja de flores ecológicas. Giulia le abre las puertas de sus jardines secretos para vivir un momento intemporal, una auténtica inmersión en el vibrante mundo de la floricultura responsable y de temporada."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Jardins de Traverses"
    ]
  },
