  "rdfs:comment": {
    "de": [
      "Familienbauernhof, der biologischen Gemüseanbau mit agrarökologischen Methoden betreibt.\r\nAb-Hof-Verkauf von vielfältigem, saisonalem Biogemüse und anderen lokalen Produkten."
    ],
    "en": [
      "Family farm practicing organic market gardening using agroecological methods.\r\nOn-farm sales of diversified, seasonal organic vegetables and other local produce."
    ],
    "it": [
      "Azienda agricola a conduzione familiare che pratica l'orticoltura biologica con metodi agro-ecologici.\r\nVendita in azienda di una varietà di ortaggi biologici di stagione e di altri prodotti locali."
    ],
    "fr": [
      "Ferme familiale pratiquant le maraichage biologique en utilisant des méthodes agroécologiques.\r\nVente à la ferme de légumes bio diversifiés et de saison et autres produits locaux."
    ],
    "es": [
      "Granja familiar que practica la horticultura ecológica con métodos agroecológicos.\r\nVenta en la explotación de hortalizas ecológicas de temporada y otros productos locales."
    ],
    "nl": [
      "Familieboerderij die biologisch tuiniert volgens agro-ecologische methoden.\r\nVerkoop op de boerderij van een verscheidenheid aan seizoensgebonden biologische groenten en andere lokale producten."
    ]
  },
  "rdfs:label": {
