  "rdfs:comment": {
    "de": [
      "Tauchen Sie in die Welt der Fabrique ein, indem Sie unser Museum Parcours découverte besuchen! Geschichte, Einblicke in die Werkstätten, spielerische Aktivitäten und eine kostenlose Verkostung... verbringen Sie einen angenehmen Moment mit Ihrer Familie und besuchen Sie zum Abschluss unsere Gourmethalle mit Teesalon."
    ],
    "en": [
      "Immerse yourself in the world of the Fabrique by visiting our Discovery Route Museum! History, views of the workshops, fun activities and free tastings? come and spend a pleasant moment with your family, and finish off with a visit to our gourmet tearoom."
    ],
    "it": [
      "Immergetevi nel mondo della Fabrique visitando il nostro Museo del Percorso di Scoperta! Storia, vista sui laboratori, attività ludiche e degustazioni gratuite: venite a trascorrere del tempo di qualità con la vostra famiglia e concludete con una visita alla nostra sala da tè gourmet."
    ],
    "fr": [
      "Plongez dans l'univers de la Fabrique en visitant notre Musée Parcours découverte ! Histoire, vues sur les ateliers, activités ludiques et dégustation gratuite… venez passer un agréable moment en famille et terminez par notre halle gourmande salon de thé."
    ],
    "es": [
      "Sumérjase en el mundo de la Fabrique visitando nuestro Museo de la Ruta del Descubrimiento Historia, vistas de los talleres, actividades lúdicas y degustaciones gratuitas... venga a pasar un rato agradable en familia y termine con una visita a nuestro salón de té gastronómico."
    ],
    "nl": [
      "Dompel jezelf onder in de wereld van de Fabrique door een bezoek te brengen aan ons museum Ontdekkingstraject! Geschiedenis, uitzicht op de ateliers, leuke activiteiten en gratis proeverijen? Kom wat quality time doorbrengen met je familie en sluit af met een bezoek aan onze gastronomische tearoom."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parcours découverte de la Biscuiterie"
    ]
  },
