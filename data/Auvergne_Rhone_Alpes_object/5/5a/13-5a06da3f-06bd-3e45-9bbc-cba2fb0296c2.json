  "rdfs:comment": {
    "de": [
      "Das neue Sporting befindet sich in einer einzigartigen Lage im Herzen von L'Alpe d'Huez und empfängt Sie den ganzen Tag und Abend über mit einer großzügigen, raffinierten Küche."
    ],
    "en": [
      "Occupying a unique location in the heart of the Alpe d'Huez resort, the new Sporting welcomes you to a warm, vintage and festive new setting, where you can enjoy generous, gourmet and refined cuisine throughout the day and evening."
    ],
    "it": [
      "In una posizione unica nel cuore della stazione dell'Alpe d'Huez, il nuovo Sporting vi accoglie in un ambiente caldo, vintage e festoso per tutto il giorno e la sera, servendo una cucina generosa, gourmet e raffinata."
    ],
    "fr": [
      "Occupant un emplacement unique au cœur de la station de l'Alpe d'Huez, le nouveau Sporting vous accueille dans un nouvel écrin chaleureux, vintage et festif tout au long de la journée et de la soirée autour d’une cuisine généreuse, gourmande et raffinée."
    ],
    "nl": [
      "Op een unieke locatie in het hart van het skioord Alpe d'Huez verwelkomt het nieuwe Sporting je in een warme, vintage en feestelijke nieuwe omgeving, waar je overdag en 's avonds kunt genieten van een gulle, gastronomische en verfijnde keuken."
    ],
    "es": [
      "Con una ubicación única en el corazón de la estación de Alpe d'Huez, el nuevo Sporting le da la bienvenida en un nuevo ambiente cálido, vintage y festivo durante todo el día y la noche, sirviendo una cocina generosa, gourmet y refinada."
    ]
  },
