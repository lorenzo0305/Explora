  "rdfs:comment": {
    "de": [
      "Das Hotel Le Kaïla verfügt über eine gemütliche Lounge-Bar, in der Sie sich neben dem Kamin entspannen können, um eine Mahlzeit mit Snacks, ein Glas Wein oder einen Cocktail zu genießen!"
    ],
    "en": [
      "The Kaïla Hotel has a very cosy lounge where you can relax next to the fireplace with a snacking menu, a glass of wine or a cocktail!"
    ],
    "it": [
      "Le Kaïla dispone di un accogliente lounge-bar dove potrete rilassarvi accanto al camino per uno spuntino, un bicchiere di vino o un cocktail!"
    ],
    "fr": [
      "L'hôtel Le Kaïla possède un salon-bar très chaleureux où vous pourrez vous détendre à côté de la cheminée pour un repas en formule snacking, un verre de vin ou encore un cocktail !"
    ],
    "nl": [
      "Le Kaïla heeft een gezellige lounge-bar waar u kunt ontspannen bij de open haard voor een hapje, een glas wijn of een cocktail!"
    ],
    "es": [
      "Le Kaïla cuenta con un acogedor bar-salón donde podrá relajarse junto a la chimenea para tomar un aperitivo, una copa de vino o un cóctel"
    ]
  },
  "rdfs:label": {
    "en": [
      "Bar of le Kaïla Hotel"
    ],
