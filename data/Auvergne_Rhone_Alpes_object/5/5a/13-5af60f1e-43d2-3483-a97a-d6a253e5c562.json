  "rdfs:comment": {
    "de": [
      "Entdecken Sie auf dem neuen Fußgängerweg von Lachat mithilfe von Fotos (Yannick Lenoir) und Malerei (Nicolas Gilormini) die emblematischen Arten des Torfmoors von Saisies."
    ],
    "en": [
      "Discover on the new Lachat footpath, emblematic species of the Saisies peat bog thanks to the photo (Yannick Lenoir) and the painting (Nicolas Gilormini)."
    ],
    "it": [
      "Scoprite le specie emblematiche della torbiera di Saisies sul nuovo sentiero di Lachat attraverso la fotografia (Yannick Lenoir) e la pittura (Nicolas Gilormini)."
    ],
    "fr": [
      "Découvrez sur le nouveau sentier piéton du Lachat, des espèces emblématiques de la tourbière des Saisies grâce à la photo (Yannick Lenoir) et la peinture (Nicolas Gilormini)."
    ],
    "nl": [
      "Ontdek de emblematische soorten van het veen van Saisies op het nieuwe wandelpad van Lachat door middel van fotografie (Yannick Lenoir) en schilderkunst (Nicolas Gilormini)."
    ],
    "es": [
      "Descubra las especies emblemáticas de la turbera de Saisies en el nuevo sendero del Lachat a través de la fotografía (Yannick Lenoir) y la pintura (Nicolas Gilormini)."
    ]
  },
  "rdfs:label": {
    "en": [
      "\"Details of Life\" Exhibition - Footpath"
    ],
    "fr": [
      "Exposition « Détails du vivant » - Sentier piétons"
    ]
  },
