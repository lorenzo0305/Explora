  "rdfs:comment": {
    "de": [
      "Gegründet im Jahr 1978. Hausgemachtes Brot, Chocolatier, Sorbets, Eiscreme und italienisches Eis, Konditor, Teesalon, Frühstück und Fastfood, Kuchen, Eistorten und Vacherins. Vor Ort handwerklich hergestellte Produkte."
    ],
    "en": [
      "Founded in 1978, homemade, chocolates, ice cream, confectionery. Tea room also serving breakfast and snacks, traditional tiered cakes and theme cakes. All the products are homemade and traditional."
    ],
    "it": [
      "Fondata nel 1978. Pane fatto in casa, cioccolateria, sorbetti, gelati e ghiaccio italiano, pasticceria, sala da tè, colazioni e merende, pasticceria, torte gelato e vacherin. Prodotti realizzati in loco con metodi tradizionali."
    ],
    "fr": [
      "Fondée en 1978. Pains maison, chocolatier, sorbets, crèmes glacées et glaces italienne, confiseur, salon de thé, petit-déj et snacking, pièces montées, gâteaux glacés et vacherins. Produits élaborés sur place de manière artisanale."
    ],
    "nl": [
      "Maison opgericht in 1978. Huisgemaakt ambachtelijk brood, chocolademaker, ijsmaker, snoepmaker, theesalon, ontbijt en kleine gerechten, traditionele taarten en themataarten."
    ],
    "es": [
      "Fundada en 1978. Panes artesanos, chocolatería, sorbetes, helados y hielo italiano, pastelería, salón de té, desayunos y meriendas, bollería, tartas heladas y vacherins. Productos elaborados in situ siguiendo métodos tradicionales."
    ]
  },
