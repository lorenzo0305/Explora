  "rdfs:comment": {
    "de": [
      "In einem alten Gebäude im Stadtzentrum von Moulins freuen sich Olivier, der Küchenchef, und sein Team darauf, Sie zu empfangen.\r\nDas Restaurant ist mit dem Gütesiegel Table d'Auvergne ausgezeichnet."
    ],
    "en": [
      "Olivier, the head chef, and his team will be delighted to welcome you to an old building in the center of Moulins.\r\nThe restaurant has been awarded the Table d'Auvergne label."
    ],
    "it": [
      "Olivier, il capo chef, e il suo team saranno lieti di accogliervi in un antico edificio nel centro di Moulins.\r\nIl ristorante ha ottenuto il marchio Table d'Auvergne."
    ],
    "fr": [
      "C'est dans une vieille bâtisse, située dans le centre ville de Moulins, qu'Olivier, le chef de cuisine et son équipe se feront une joie de vous recevoir.\r\nLe restaurant est labelisé Table d'Auvergne."
    ],
    "es": [
      "Olivier, el jefe de cocina, y su equipo estarán encantados de recibirle en un antiguo edificio del centro de Moulins.\r\nEl restaurante ha sido galardonado con la etiqueta Table d'Auvergne."
    ],
    "nl": [
      "Olivier, de chef-kok, en zijn team heten je van harte welkom in een oud gebouw in het centrum van Moulins.\r\nHet restaurant is bekroond met het label Table d'Auvergne."
    ]
  },
  "rdfs:label": {
