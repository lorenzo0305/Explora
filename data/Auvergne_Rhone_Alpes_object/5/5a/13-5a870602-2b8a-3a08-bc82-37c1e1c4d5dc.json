  "rdfs:comment": {
    "de": [
      "Bistro im historischen Herzen von Clermont-Ferrand, wo man sich Zeit nimmt, um es sich gut gehen zu lassen. Teller, Wein und Dekoration klingen lateinamerikanisch."
    ],
    "en": [
      "Bistro in the historic heart of Clermont-Ferrand, where you can take the time to relax. The food, the wine and the decoration resonate Latin."
    ],
    "it": [
      "Un bistrot nel cuore storico di Clermont-Ferrand, dove potete prendervi il vostro tempo per divertirvi. Il piatto, il vino e la decorazione sono tutti latini."
    ],
    "fr": [
      "Bistrot du cœur historique de Clermont-Ferrand, où l'on prend le temps de se la couler douce. L’assiette, le vin et la déco résonnent latino."
    ],
    "es": [
      "Un bistró en el centro histórico de Clermont-Ferrand, donde podrá tomarse su tiempo para disfrutar. El plato, el vino y la decoración son latinos."
    ],
    "nl": [
      "Een bistro in het historische hart van Clermont-Ferrand, waar u op uw gemak kunt genieten. Het bord, de wijn en de decoratie zijn allemaal Latijns."
    ]
  },
