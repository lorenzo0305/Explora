  "rdfs:comment": {
    "de": [
      "Die Kunst des Wohlbefindens in Megève. Kos Paris & Skinceuticals\r\nIn der Nähe des Dorfkerns befindet sich das Spa des Hotels \"Le Fer à Cheval *****\", ein 450 m2 großes Universum, das dem Wohlbefinden gewidmet ist."
    ],
    "en": [
      "The Art of Well-being in Megève. Kos Paris & Skinceuticals\r\nClose to the heart of the village, the spa at the ‘Le Fer à Cheval’ hotel ***** is a 450 m2 world dedicated to well-being."
    ],
    "it": [
      "L'arte del benessere a Megève. Kos Paris & Skinceuticals\r\nVicino al cuore del villaggio, la spa dell'hotel “Le Fer à Cheval” ***** è un mondo di 450 m2 dedicato al benessere."
    ],
    "fr": [
      "L’Art du Bien-Être à Megève. Kos Paris & Skinceuticals\r\nÀ proximité du cœur du village, le spa de l’hôtel \"Le Fer à Cheval *****\" est un univers de 450 m2 dédié au bien-être."
    ],
    "es": [
      "El arte del bienestar en Megève. Kos Paris & Skinceuticals\r\nCerca del corazón del pueblo, el spa del hotel \"Le Fer à Cheval\" ***** es un universo de 450 m2 dedicado al bienestar."
    ],
    "nl": [
      "De kunst van welzijn in Megève. Kos Parijs & Skinceuticals\r\nDe spa van het hotel \"Le Fer à Cheval\" *****, in het hart van het dorp, is een wereld van 450 m2 gewijd aan welzijn."
    ]
  },
