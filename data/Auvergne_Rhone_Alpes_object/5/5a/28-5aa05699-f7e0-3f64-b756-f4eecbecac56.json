  "rdfs:comment": {
    "de": [
      "Im Herzen der Stadt können Sie auf der Terrasse die Spezialitäten des Chefs (Pizzas und Crêpes), aber auch traditionelle Gerichte und die Bohne von Soissons probieren!"
    ],
    "en": [
      "In the heart of the city, take advantage of the terrace to sample the chef's specialties (pizzas and crêpes), as well as traditional dishes, not forgetting the Soissons bean!"
    ],
    "it": [
      "Nel cuore della città, approfittate della terrazza per gustare le specialità dello chef (pizze e crêpes) e i piatti tradizionali, senza dimenticare il fagiolo di Soissons!"
    ],
    "fr": [
      "En cœur de ville, profitez de la terrasse pour déguster les spécialités du chef (pizzas et crêpes), aussi des plats traditionnels sans oublier le haricot de Soissons !"
    ],
    "nl": [
      "In het hart van de stad kunt u op het terras genieten van de specialiteiten van de chef (pizza's en crêpes), maar ook van traditionele gerechten en niet te vergeten de Soissons boon!"
    ],
    "es": [
      "En pleno centro de la ciudad, aproveche la terraza para degustar las especialidades del chef (pizzas y crêpes), así como platos tradicionales, ¡sin olvidar la judía de Soissons!"
    ]
  },
  "rdfs:label": {
