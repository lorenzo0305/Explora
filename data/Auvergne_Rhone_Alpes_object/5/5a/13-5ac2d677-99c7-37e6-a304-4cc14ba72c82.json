  "rdfs:comment": {
    "de": [
      "Gastronomenpaar, das mit vier Händen kocht und Ihnen eine Gourmetküche mit frischen, lokalen und saisonalen Produkten anbietet.\r\nSehr schöne Weinkarte mit Weinen aus dem Rhonetal , Burgund und anderen Regionen.\r\nEtwa 1150 Referenzen"
    ],
    "en": [
      "Couple of restaurateurs who cook with 4 hands and offer gourmet cuisine using fresh, local and seasonal produce.\r\nExcellent wine list from the Rhône Valley, Burgundy and other regions.\r\nAround 1150 references"
    ],
    "it": [
      "Una coppia di ristoratori che cucina a 4 mani e propone una cucina gourmet con prodotti freschi, locali e di stagione.\r\nOttima carta dei vini della Valle del Rodano, della Borgogna e di altre regioni.\r\nCirca 1150 referenze"
    ],
    "fr": [
      "Couple de restaurateurs qui cuisine à 4 mains et vous propose une cuisine gastronomique, avec des produits frais, locaux et de saison.\r\nTrès belle carte des vins de la vallée du Rhône , Bourgogne et autres régions.\r\nEnviron 1150 références"
    ],
    "es": [
      "Una pareja de restauradores que cocinan a 4 manos y ofrecen cocina gourmet con productos frescos, locales y de temporada.\r\nExcelente carta de vinos del valle del Ródano, Borgoña y otras regiones.\r\nAlrededor de 1150 referencias"
    ],
    "nl": [
      "Een stel restaurateurs dat met 4 handen kookt en gastronomische gerechten aanbiedt met verse, lokale en seizoensgebonden producten.\r\nUitstekende wijnkaart uit de Rhônevallei, Bourgogne en andere regio's.\r\nOngeveer 1150 referenties"
    ]
  },
