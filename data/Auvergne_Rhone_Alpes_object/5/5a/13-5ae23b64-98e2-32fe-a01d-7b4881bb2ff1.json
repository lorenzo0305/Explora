    "de": [
      "Chalet aus Stein und Holz, auf den Skipisten von La Norma, in Höhenlage. Schnelle Verpflegung. Große Sonnenterrasse mit Blick auf die Pisten."
    ],
    "en": [
      "Stone and wood chalet on the ski slopes of La Norma. Fast-food restaurant. Large sunny terrace facing the slopes."
    ],
    "it": [
      "Chalet in pietra e legno sulle piste da sci di La Norma, in quota. Ristorazione veloce. Ampia terrazza soleggiata affacciata sulle piste."
    ],
    "fr": [
      "Chalet en pierre et bois, sur les pistes de ski de La Norma, en altitude. Restauration rapide. Grande terrasse au soleil face aux pistes."
    ],
    "nl": [
      "Chalet van steen en hout op de skipistes van La Norma. Fast food. Groot zonnig terras met uitzicht op de pistes."
    ],
