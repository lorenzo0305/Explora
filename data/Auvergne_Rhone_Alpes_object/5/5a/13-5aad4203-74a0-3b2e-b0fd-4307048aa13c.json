  "rdfs:comment": {
    "de": [
      "Traditionelles Familienrestaurant mit lokalen Produkten (GAEC de Jourcy, Délices Fermiers, Ferme des Délices...). Lyoner Menü, Froschmenü, Burger, Moules Frites (April bis August freitags abends)."
    ],
    "en": [
      "Traditional family restaurant using local produce (GAEC de Jourcy, Délices Fermiers, Ferme des Délices...). Lyonnais menu, frog menu, burger, moules frites (April to August, Friday evenings)."
    ],
    "it": [
      "Ristorante tradizionale a conduzione familiare con prodotti locali (GAEC de Jourcy, Délices Fermiers, Ferme des Délices...). Menu lionese, menu rana, hamburger, cozze e patatine (da aprile ad agosto il venerdì sera)."
    ],
    "fr": [
      "Restaurant traditionnelle familiale avec des produits locaux (GAEC de Jourcy, Délices Fermiers, Ferme des Délices...). Menu Lyonnais, menu grenouilles, burger, moules frites (avril à août les vendredis soirs)."
    ],
    "nl": [
      "Traditioneel familierestaurant met streekproducten (GAEC de Jourcy, Délices Fermiers, Ferme des Délices...). Lyonnais-menu, kikkermenu, hamburger, mosselen en friet (april tot augustus op vrijdagavond)."
    ],
    "es": [
      "Restaurante familiar tradicional con productos locales (GAEC de Jourcy, Délices Fermiers, Ferme des Délices...). Menú Lyonnais, menú rana, hamburguesa, mejillones y patatas fritas (de abril a agosto los viernes por la noche)."
    ]
  },
