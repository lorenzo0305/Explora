  "rdfs:comment": {
    "de": [
      "AMAP-ähnlicher Verein, der lokale Produzenten und Verbraucher zusammenbringt, um Bio- und lokale Produkte zu fördern. Etwa 30 Produkte sind jeden Donnerstag während der Öffnungszeiten in Saint-Julien-Chapteuil vor dem Vereinshaus zu finden."
    ],
    "en": [
      "AMAP-type association bringing together local producers and consumers to promote organic and local produce. Around thirty products can be found every Thursday at the office in Saint-Julien-Chapteuil, in front of the association centre."
    ],
    "it": [
      "Associazione di tipo AMAP che riunisce produttori e consumatori locali per promuovere i prodotti biologici e locali. Una trentina di prodotti si possono trovare ogni giovedì presso l'ufficio di Saint-Julien-Chapteuil, di fronte al centro dell'associazione."
    ],
    "fr": [
      "Association de type AMAP mettant en relation producteurs locaux et consom’acteurs pour promouvoir les produits bio et locaux. Une trentaine de productions à retrouver chaque jeudi lors de la permanence à Saint-Julien-Chapteuil, devant l’espace associatif."
    ],
    "nl": [
      "Een vereniging van het type AMAP die lokale producenten en consumenten samenbrengt om biologische en lokale producten te promoten. Een dertigtal producten zijn elke donderdag te vinden in het kantoor in Saint-Julien-Chapteuil, tegenover het centrum van de vereniging."
    ],
    "es": [
      "Asociación de tipo AMAP que reúne a productores y consumidores locales para promover los productos ecológicos y locales. Cada jueves se pueden encontrar unos treinta productos en la oficina de Saint-Julien-Chapteuil, frente al centro de la asociación."
    ]
  },
