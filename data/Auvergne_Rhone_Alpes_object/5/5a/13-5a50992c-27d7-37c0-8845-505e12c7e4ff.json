  "rdfs:comment": {
    "de": [
      "Im Herzen des Dorfes St-Just-en-Chevalet, zwischen den Bergen der Madeleine, liegt das 3-Sterne-Hotel de la Poste, das ländlichen Charme mit zeitgemäßem Komfort verbindet."
    ],
    "en": [
      "Located in the heart of the village of St-Just-en-Chevalet, between the Monts de la Madeleine, Hôtel de la Poste is a 3-star establishment combining country charm and contemporary comfort."
    ],
    "it": [
      "Situato nel cuore del villaggio di St-Just-en-Chevalet, tra i Monts de la Madeleine, l'Hôtel de la Poste è una struttura a 3 stelle che unisce il fascino della campagna al comfort contemporaneo."
    ],
    "fr": [
      "Situé au cœur du village de St-Just-en-Chevalet, entre les monts de la Madeleine, l'Hôtel de la Poste est un établissement 3 étoiles qui allie charme campagnard et confort contemporain."
    ],
    "es": [
      "Situado en el corazón del pueblo de St-Just-en-Chevalet, entre los Montes de la Madeleine, el Hôtel de la Poste es un establecimiento de 3 estrellas que combina encanto campestre y confort contemporáneo."
    ],
    "nl": [
      "Hôtel de la Poste ligt in het hart van het dorp St-Just-en-Chevalet, tussen de Monts de la Madeleine, en is een 3-sterrenhotel dat landelijke charme combineert met hedendaags comfort."
    ]
  },
  "rdfs:label": {
