  "rdfs:comment": {
    "de": [
      "Mit einer Fläche von 1000 m2 beherbergt er vor allem Rotaugen und Schleien, aber auch einige Karpfen und Raubfische. Für Black-Bass ist er als No-Kill eingestuft."
    ],
    "en": [
      "Covering an area of 1,000 m2, it is home mainly to roach and tench, but also to a few carp and carnassial fish. It is classified No-Kill for Black Bass."
    ],
    "it": [
      "Su una superficie di 1.000 m2, ospita soprattutto lasche e tinche, ma anche alcune carpe e pesci carnivori. Ha una classificazione No-Kill per il black bass."
    ],
    "fr": [
      "D'une superficie de 1000 m2, il abrite surtout des gardons et des tanches, mais aussi quelques carpes et carnassiers. Il est classé No-Kill pour le Black-Bass."
    ],
    "nl": [
      "Het heeft een oppervlakte van 1000 m2 en herbergt voornamelijk voorn en zeelt, maar ook een paar karpers en vleesetende vissen. Het heeft een No-Kill classificatie voor black bass."
    ],
    "es": [
      "Con una superficie de 1.000 m2, alberga principalmente cucarachas y tencas, pero también algunas carpas y peces carnívoros. Cuenta con una clasificación No-Kill para el black bass."
    ]
  },
