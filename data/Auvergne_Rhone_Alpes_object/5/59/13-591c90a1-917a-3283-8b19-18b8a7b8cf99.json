  "rdfs:comment": {
    "de": [
      "Teesalon, Feinschmeckerladen.\r\nGroße Auswahl an Kaffees aus aller Welt, heißen Schokoladen und Tees; vor Ort oder zum Mitnehmen.\r\nBrunch am Sonntag auf Reservierung."
    ],
    "en": [
      "Tearoom, gourmet store.\r\nWide choice of world coffees, hot chocolates, teas; on site or to take away.\r\nSunday brunch by prior arrangement."
    ],
    "it": [
      "Sala da tè, negozio di specialità gastronomiche.\r\nAmpia scelta di caffè da tutto il mondo, cioccolate calde, tè; in loco o da asporto.\r\nBrunch domenicale su prenotazione."
    ],
    "fr": [
      "Salon de thé, boutique gourmande.\r\nLarge choix de cafés du monde, de chocolats chauds, de thés ; sur place ou à emporter.\r\nBrunch le dimanche sur réservation."
    ],
    "nl": [
      "Tearoom, winkel voor fijnproevers.\r\nRuime keuze aan koffie uit de hele wereld, warme chocolademelk en thee; om te eten of mee te nemen.\r\nZondagbrunch op afspraak."
    ],
    "es": [
      "Salón de té, tienda gourmet.\r\nAmplia selección de cafés de todo el mundo, chocolates calientes, tés; en el lugar o para llevar.\r\nEl brunch de los domingos, previa reserva."
    ]
  },
