            "de": [
              "RESTAURANT\r\nMittags: von 12:00 bis 14:30 Uhr von Montag bis Freitag / Abends: von 19:00 bis 22:00 Uhr von Mittwoch bis Freitag\r\n\r\nBar: von 18 Uhr bis Mitternacht von Dienstag bis Samstag\r\n\r\nVereinscafé: von 14:30 bis 17:30 Uhr dienstags bis freitags"
            ],
            "en": [
