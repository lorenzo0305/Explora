  "rdfs:comment": {
    "de": [
      "In 15 m Höhe auf einer Dachterrasse gelegen, bietet die Bar Radis ein Restaurant, eine Bar, ein Café für Vereinszwecke, ein Gewächshaus und einen Garten zur Versorgung des Restaurants sowie eine Werkstatt für Lebensmittelverarbeitung und eine Gärtnerei für Vereinszwecke."
    ],
    "en": [
      "Perched 15m high on a rooftop terrace, Bar Radis is a restaurant, a bar, a community café, a greenhouse and a garden to supply the restaurant, as well as a food processing workshop and a community nursery."
    ],
    "it": [
      "Arroccato a 15 metri di altezza su una terrazza panoramica, il Bar Radis è un ristorante, un bar, un caffè associativo, una serra e un orto per alimentare il ristorante, nonché un laboratorio di trasformazione alimentare e un vivaio associativo."
    ],
    "fr": [
      "Perché à 15m de hauteur sur un toit-terrasse, le Bar Radis c’est un restaurant, un bar, un café associatif, une serre et un jardin pour alimenter le restaurant ainsi qu’un atelier de transformation alimentaire et une pépinière associative."
    ],
    "es": [
      "Encaramado a 15 metros de altura en una azotea, el Bar Radis es un restaurante, un bar, un café comunitario, un invernadero y un huerto para abastecer al restaurante, así como un taller de procesamiento de alimentos y un vivero comunitario."
    ],
    "nl": [
      "Bar Radis, 15 meter hoog gelegen op een dakterras, is een restaurant, een bar, een associatief café, een kas en een tuin om het restaurant te voeden, evenals een werkplaats voor voedselverwerking en een associatieve kwekerij."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Bar Radis"
    ]
  },
