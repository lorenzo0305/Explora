  "rdfs:comment": {
    "de": [
      "VélOYO bietet samstags vormittags und mittwochs nachmittags (AUSSER IM AUGUST) den Verleih von Fahrrädern (VTC, VTT, VAE) für Kinder und Erwachsene an.\r\n3 mögliche Formeln: 3 Tage Verleih, 1 Woche, 1 Monat.\r\nDie kollaborative Werkstatt ermöglicht es Ihnen, Ihr Fahrrad zu reparieren"
    ],
    "en": [
      "Véloyo aims at promoting the use of bicycle in the town of oyonnax"
    ],
    "it": [
      "VélOYO offre il noleggio di mountain bike (bambini e adulti) il sabato mattina e il mercoledì pomeriggio (ECCETTO AD AGOSTO).\r\n3 formule possibili: 3 giorni di noleggio, 1 settimana, 1 mese.\r\nL'officina collaborativa permette di riparare la propria bicicletta"
    ],
    "fr": [
      "VélOYO propose la location de vélo VTC, VTT, VAE (enfants et adultes) les samedis matins et mercredis après-midis (SAUF EN AOUT).\r\n3 formules possibles : 3 jours de location, 1 semaine, 1 mois.\r\nL'atelier collaboratif vous permet de réparer votre vélo"
    ],
    "nl": [
      "VélOYO verhuurt mountainbikes (kinderen en volwassenen) op zaterdagochtend en woensdagmiddag (behalve in augustus).\r\n3 mogelijke formules: 3 dagen verhuur, 1 week, 1 maand.\r\nIn de gezamenlijke werkplaats kunt u uw fiets repareren"
    ],
    "es": [
      "VélOYO propone el alquiler de bicicletas de montaña (niños y adultos) los sábados por la mañana y los miércoles por la tarde (EXCEPTO EN AGOSTO).\r\n3 fórmulas posibles: 3 días de alquiler, 1 semana, 1 mes.\r\nEl taller colaborativo le permite reparar su bicicleta"
    ]
  },
