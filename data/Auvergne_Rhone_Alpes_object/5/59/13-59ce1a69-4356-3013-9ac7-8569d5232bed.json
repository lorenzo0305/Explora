  "rdfs:comment": {
    "de": [
      "Ehemaliger mittelalterlicher Turm mit Zinnen, der einige Umbauten erfuhr: Verbreiterung der Öffnungen, Brotofen und Kamin aus dem 15. Jahrhundert, Treppe. Jh. wurde er in eine Kapelle umgewandelt, die Notre-Dame gewidmet ist."
    ],
    "en": [
      "Ancient medieval crenelated tower, it had few transformations : openings enlargement, 15th-century bread oven and fireplace, staircase. At the begining if the 20th century, it became a chapel dedicated to Our Lady."
    ],
    "it": [
      "Antica torre medievale merlata, ha subito diverse trasformazioni: ampliamento delle aperture, forno per il pane e camino del XV secolo, scala. All'inizio del XX secolo è stata trasformata in una cappella dedicata alla Madonna."
    ],
    "fr": [
      "Ancienne tour médiévale crénelée, elle a subi quelques transformations : élargissement des ouvertures, four à pain et cheminée du XVème siècle, escalier. Au début du XXème siècle, elle fut transformée en chapelle dédiée à Notre-Dame."
    ],
    "nl": [
      "Deze voormalige gekanteelde middeleeuwse toren heeft verschillende transformaties ondergaan: vergroting van de openingen, broodoven en schoorsteen uit de 15e eeuw, trap. Aan het begin van de 20e eeuw werd het omgebouwd tot een kapel gewijd aan Onze Lieve Vrouw."
    ],
    "es": [
      "Antigua torre medieval almenada, ha sufrido varias transformaciones: ampliación de los vanos, horno de pan y chimenea del siglo XV, escalera. A principios del siglo XX, se transformó en una capilla dedicada a la Virgen."
    ]
  },
  "rdfs:label": {
