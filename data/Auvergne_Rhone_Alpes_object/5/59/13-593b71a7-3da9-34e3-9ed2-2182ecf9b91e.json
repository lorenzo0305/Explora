  "rdfs:comment": {
    "de": [
      "Fotografische Ausstellung. Jeden Tag brechen Männer und Frauen, Wanderer und Pilger auf, um sich auf den Weg zu machen, in der geheimen Hoffnung, dass sie in sich den Funken, den Stern finden, der sie auf dieser langen Wanderung, die das Leben ist, leiten wird."
    ],
    "en": [
      "Photographic exhibition. Every day, men and women, walkers and pilgrims, set off on their journey, some with the secret hope of finding within themselves the spark, the star that will guide them through life's long itinerary."
    ],
    "it": [
      "Mostra fotografica. Ogni giorno, uomini e donne, camminatori e pellegrini, si mettono in viaggio, alcuni con la segreta speranza di trovare dentro di sé la scintilla, la stella che li guiderà nel lungo viaggio della vita."
    ],
    "fr": [
      "Exposition photographique. Chaque jour, hommes et femmes, marcheurs et pèlerins, partent pour se mettre en chemin avec le secret espoir pour certains de trouver en eux l'étincelle, l'étoile qui les guidera dans cette longue itinérance qu'est la vie."
    ],
    "nl": [
      "Fototentoonstelling. Elke dag gaan mannen en vrouwen, wandelaars en pelgrims op reis, sommigen in de geheime hoop in zichzelf de vonk te vinden, de ster die hen zal leiden op de lange reis van het leven."
    ],
    "es": [
      "Exposición fotográfica. Cada día, hombres y mujeres, caminantes y peregrinos, emprenden su viaje, algunos con la secreta esperanza de encontrar en su interior la chispa, la estrella que les guiará en el largo viaje de la vida."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Exposition de plein air : L'abécédaire du chemin"
    ]
  },
