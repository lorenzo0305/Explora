  "rdfs:comment": {
    "de": [
      "Am Fuße des Mont-Charvin, im Herzen der Alm, auf der wir Reblochon und Chevrotin herstellen, genießen Sie mittags und abends unsere Bergrestaurants auf dem Bauernhof."
    ],
    "en": [
      "At the foot of Mont-Charvin, in the heart of the mountain pasture where we produce Reblochon and Chevrotin, you will enjoy our mountain restaurant at the farm for lunch and dinner."
    ],
    "it": [
      "Ai piedi del Mont-Charvin, nel cuore dell'alpeggio dove si producono Reblochon e Chevrotin, potrete gustare il nostro ristorante di montagna a pranzo e a cena."
    ],
    "fr": [
      "Au pied du Mont-Charvin, au coeur de l'alpage où nous produisons Reblochon et Chevrotin, vous dégusterez midi et soir notre restauration montagnarde à la ferme."
    ],
    "es": [
      "Al pie de Mont-Charvin, en el corazón de los pastos de montaña donde producimos Reblochon y Chevrotin, podrá disfrutar de nuestro restaurante de montaña en el almuerzo y la cena."
    ],
    "nl": [
      "Aan de voet van de Mont-Charvin, in het hart van de bergweide waar we Reblochon en Chevrotin produceren, kunt u bij de lunch en het diner genieten van ons bergrestaurant."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Auberge de l'Aulp de Marlens"
    ]
  },
