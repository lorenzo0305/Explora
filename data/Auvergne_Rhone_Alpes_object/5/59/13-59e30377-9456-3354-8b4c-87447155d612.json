  "rdfs:comment": {
    "de": [
      "SUPREM'NOUGAT, G. Savin, ist ein ruhiges und dynamisches Unternehmen, das stark lokal verwurzelt ist und stolz darauf ist, ein hochwertiges handwerkliches Produkt wie den berühmten Nougat aus Montélimar anzubieten."
    ],
    "en": [
      "SUPREM'NOUGAT, G. Savin, is a serene and dynamic company, very rooted at the local level and proud to propose a top-of-the-range artisanal product like the famous nougat of Montélimar."
    ],
    "it": [
      "SUPREM?NOUGAT, G. Savin, è un'azienda serena e dinamica, profondamente radicata nel territorio e orgogliosa di offrire un prodotto artigianale di alta gamma come il famoso torrone di Montélimar."
    ],
    "fr": [
      "SUPREM’NOUGAT, G. Savin, est une entreprise sereine et dynamique, très enracinée au niveau local et fière de proposer un produit artisanal haut de gamme comme le fameux nougat de Montélimar."
    ],
    "es": [
      "SUPREM?NOUGAT, G. Savin, es una empresa serena y dinámica, profundamente arraigada en la zona y orgullosa de ofrecer un producto artesanal de gama alta como el famoso turrón de Montélimar."
    ],
    "nl": [
      "SUPREM'NOUGAT, G. Savin, is een sereen en dynamisch bedrijf, diep geworteld in de streek en trots op het aanbieden van een ambachtelijk topproduct zoals de beroemde nougat van Montélimar."
    ]
  },
