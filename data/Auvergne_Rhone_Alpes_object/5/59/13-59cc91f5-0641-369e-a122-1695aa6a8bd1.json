  "rdfs:comment": {
    "de": [
      "Brasserie (Gegrilltes auf Brettern, Ribs...).\r\nSnack (Burger, Sandwiches, Paninis).\r\nCrêpes, Waffeln und Churros.\r\nFondue- oder Raclette-Abende unter einer beheizten Iglu-Blase.\r\nSavoyische Spezialitäten.\r\n\r\nSpielübertragungen auf Anfrage."
    ],
    "en": [
      "Brasserie (grilled meats, ribs...).\r\nSnack bar (Burgers, sandwiches, paninis).\r\nPancakes, waffles and churros.\r\nFondue or raclette evenings under a heated igloo bubble.\r\nSavoyard specialities.\r\n\r\nOn-demand match broadcasts."
    ],
    "it": [
      "Brasserie (carne alla griglia, costine, ecc.).\r\nSnack (hamburger, panini, panini).\r\nPancake, waffle e churros.\r\nSerate di fonduta o raclette in un igloo riscaldato.\r\nSpecialità savoiarde.\r\n\r\nTrasmissione di partite su richiesta."
    ],
    "fr": [
      "Brasserie (grillades sur planches, ribs...).\r\nSnack (Burgers, sandwichs, paninis). \r\nCrêpes, gaufres et churros.\r\nSoirées fondue ou raclette sous une bulle igloo chauffée.\r\nSpécialités savoyardes.\r\n\r\nRetransmission des matchs à la demande."
    ],
    "nl": [
      "Brasserie (gegrild vlees, spareribs, enz.).\r\nSnacks (hamburgers, sandwiches, panini's).\r\nPannenkoeken, wafels en churros.\r\nFondue- of raclette-avonden in een verwarmde iglo-bubbel.\r\nSavoyaardse specialiteiten.\r\n\r\nWedstrijden op aanvraag."
    ],
    "es": [
      "Brasserie (carnes a la brasa, costillas, etc.).\r\nSnacks (hamburguesas, sándwiches, paninis).\r\nTortitas, gofres y churros.\r\nVeladas de fondue o raclette en una burbuja iglú climatizada.\r\nEspecialidades saboyanas.\r\n\r\nRetransmisiones de partidos a la carta."
    ]
  },
