  "rdfs:comment": {
    "de": [
      "Canyoning in Annecy und in der Tarentaise mit Odyssée Canyon diplomierte und spezialisierte Canyoning in Savoyen und Hochsavoyen mit Abstiegen von Canyons mit unterschiedlichen Niveaus : Sehr sportlich, sportlich, Entdeckung oder Familie mit Kindern ab 8 Jahren."
    ],
    "en": [
      "Canyoning in Annecy and Tarentaise with Odyssée Canyon, a qualified canyoning specialist in Savoie and Haute-Savoie with canyoning trips at different levels: Very sporty, sporty, discovery or family with children aged 8 and over."
    ],
    "it": [
      "Canyoning ad Annecy e in Tarentaise con Odyssée Canyon, specialista qualificato di canyoning in Savoia e Alta Savoia con discese di canyoning di diversi livelli: Molto sportivo, sportivo, scoperta o famiglia con bambini a partire dagli 8 anni"
    ],
    "fr": [
      "Canyoning à Annecy et en Tarentaise avec Odyssée Canyon diplômé et spécialisé canyonisme en Savoie et Haute-Savoie avec des descentes de canyons de niveaux différents : Très sportif, sportif, découverte ou familial avec enfants à partir de l'âge de 8 ans"
    ],
    "es": [
      "Descenso de barrancos en Annecy y Tarentaise con Odyssée Canyon, especialista cualificado en descenso de barrancos en Savoie y Haute-Savoie con descensos de barrancos de diferentes niveles: Muy deportivo, deportivo, descubrimiento o familia con niños a partir de 8 años"
    ],
    "nl": [
