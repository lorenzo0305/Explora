  "rdfs:comment": {
    "de": [
      "Folgen Sie den langen Wegen von Broût-Vernet, inmitten von weitläufigen\r\nweiten Wiesen, Bäumen und Hecken. Sie führen Sie zu\r\ndas stolze Château de Lafont, das wie ein Traum in der Landschaft erscheint."
    ],
    "en": [
      "Follow the long paths of Broût-Vernet, through vast expanses of\r\nmeadows, trees and hedges. They will lead you to\r\nthe proud Château de Lafont, which appears like a dream in the landscape."
    ],
    "it": [
      "Seguite i lunghi sentieri di Broût-Vernet, attraverso vaste distese di prati, alberi e siepi\r\nprati, alberi e siepi. Vi condurranno al\r\nl'orgoglioso Château de Lafont, che appare come un sogno nel paesaggio."
    ],
    "fr": [
      "Suivez les longs chemins de Broût-Vernet, au milieu de vastes \r\nétendues de prairies, d'arbres et de haies. Ils vous mèneront vers \r\nle fier château de Lafont, qui apparaît tel un rêve dans le paysage."
    ],
    "nl": [
      "Volg de lange paden van Broût-Vernet, door uitgestrekte\r\nweiden, bomen en heggen. Ze leiden je naar\r\nhet trotse Château de Lafont, dat als een droom in het landschap opdoemt."
    ],
    "es": [
      "Siga los largos senderos de Broût-Vernet, a través de vastas extensiones de\r\nprados, árboles y setos. Le conducirán hasta\r\nel orgulloso Château de Lafont, que aparece como un sueño en el paisaje."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Château Lafont - 17.5 km"
    ]
  },
