  "rdfs:comment": {
    "de": [
      "Das Musée de la Romanche dokumentiert die industrielle, energetische und menschliche Geschichte des Romanche-Tals, eines Gebiets, das durch Wasser, Wasserkraft und die Entwicklung großer Industrien geprägt wurde."
    ],
    "en": [
      "The Musée de la Romanche traces the industrial, energy and human history of the Romanche valley, an area shaped by water, hydroelectricity and the development of major industries."
    ],
    "it": [
      "Il Museo della Romanche ripercorre la storia industriale, energetica e umana della valle della Romanche, un'area plasmata dall'acqua, dall'energia idroelettrica e dallo sviluppo di grandi industrie."
    ],
    "fr": [
      "Le Musée de la Romanche retrace l’histoire industrielle, énergétique et humaine de la vallée de la Romanche, un territoire façonné par l’eau, l’hydroélectricité et le développement des grandes industries."
    ],
    "nl": [
      "Het Musée de la Romanche schetst de industriële, energie- en menselijke geschiedenis van de vallei van de Romanche, een gebied dat gevormd is door water, hydro-elektriciteit en de ontwikkeling van grote industrieën."
    ],
    "es": [
      "El Museo de la Romanche recorre la historia industrial, energética y humana del valle de la Romanche, una zona marcada por el agua, la hidroelectricidad y el desarrollo de grandes industrias."
    ]
  },
