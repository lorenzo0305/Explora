  "rdfs:comment": {
    "de": [
      "Eine sehr schöne Verbindungsstrecke zwischen Val Thorens und Méribel in einer wilden und natürlichen Umgebung (Durchquerung eines nationalen Naturschutzgebiets).\r\nMehr als 9 Kilometer Abfahrt und 1000 Höhenmeter auf blauen Pisten."
    ],
    "en": [
      "A beautiful route linking Val Thorens and Méribel in a wild and natural environment (crossing a national nature reserve).\r\nMore than 9 kilometers of descent and 1000 meters of unevenness on blue slopes."
    ],
    "it": [
      "Un bellissimo collegamento tra Val Thorens e Méribel in un ambiente naturale e selvaggio (attraversando una riserva naturale nazionale).\r\nOltre 9 chilometri di discesa e 1000 metri di dislivello su piste blu."
    ],
    "fr": [
      "Un très bel itinéraire de liaison entre Val Thorens et Méribel dans un environnement sauvage et naturel (traversée d'une réserve naturelle nationale).\r\nPlus de 9 kilomètres de descente et 1000 mètres de dénivellation sur des pistes bleues."
    ],
    "es": [
      "Un hermoso enlace entre Val Thorens y Méribel en un entorno salvaje y natural (atravesando una reserva natural nacional).\r\nMás de 9 kilómetros de descenso y 1.000 metros de desnivel en pistas azules."
    ],
    "nl": [
      "Een zeer mooie verbinding tussen Val Thorens en Méribel in een wilde en natuurlijke omgeving (dwars door een nationaal natuurreservaat).\r\nMeer dan 9 kilometer afdaling en 1000 meter hoogteverschil op blauwe pistes."
    ]
  },
  "rdfs:label": {
    "en": [
      "Slope Lac de la Chambre and Ours"
    ],
    "fr": [
      "Piste du Lac de la Chambre et de l'Ours"
    ],
    "nl": [
      "Kamer en Bear Pass Trail"
    ]
  },
