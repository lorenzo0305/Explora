  "rdfs:comment": {
    "de": [
      "Entdecken Sie die dritte Dimension mit Annecy Vol Libre! Professionelle Fluglehrer, die die Region lieben, fliegen mit Ihnen in aller Sicherheit über den See und die Berge."
    ],
    "en": [
      "Come and discover the 3rd dimension with Annecy Vol Libre! Professionals who love the region will take you flying over the lake and mountains in complete safety."
    ],
    "it": [
      "Venite a scoprire la terza dimensione con Annecy Vol Libre! Professionisti che amano la regione vi porteranno a sorvolare il lago e le montagne in tutta sicurezza."
    ],
    "fr": [
      "Venez découvrir la 3ème dimension avec Annecy Vol Libre ! Des professionnels amoureux de la région vous emmèneront voler au dessus du lac et des montagnes en toute sécurité."
    ],
    "es": [
      "¡Venga a descubrir la 3ª dimensión con Annecy Vol Libre! Profesionales enamorados de la región le llevarán a sobrevolar el lago y las montañas con total seguridad."
    ],
    "nl": [
      "Kom en ontdek de 3e dimensie met Annecy Vol Libre! Professionals die van de regio houden nemen je mee om in alle veiligheid over het meer en de bergen te vliegen."
    ]
  },
