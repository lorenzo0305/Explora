  "rdfs:comment": {
    "de": [
      "Diese auf dem Plateau von \"Proclou\" installierte kuppelbare Bahn stellt die Verbindung zwischen Super-Morzine und Avoriaz her. Erreichen Sie den Ort vom Bike Park aus mühelos."
    ],
    "en": [
      "Installed on the \"Proclou\" plateau, this detachable lift makes the connection between Super-Morzine and Avoriaz. Reach the resort from the Bike Park without  effort."
    ],
    "it": [
      "Situato sull'altopiano di \"Proclou\", questo impianto di risalita staccabile collega Super-Morzine ad Avoriaz. Raggiungete il resort dal Bike Park senza fatica."
    ],
    "fr": [
      "Installé sur le plateau de « Proclou », ce débrayable assure la liaison en Super-Morzine et Avoriaz. Rejoignez la station depuis  le Bike Park sans effort."
    ],
    "es": [
      "Situado en la meseta de \"Proclou\", este remonte desembragable sirve de enlace entre Super-Morzine y Avoriaz. Llegue a la estación desde el Bike Park sin esfuerzo."
    ],
    "nl": [
      "Deze demonteerbare lift is geïnstalleerd op het plateau van \"Proclou\" en vormt een verbinding tussen Super-Morzine en Avoriaz. Bereik het resort moeiteloos vanaf het Bikepark."
    ]
  },
