  "rdfs:comment": {
    "de": [
      "Das ganze Jahr über verfügbar.\r\n\r\nDie Kinder gehen mit Rosalie, dem Maskottchen des Fremdenverkehrsamtes, auf Entdeckungsreise durch den Weiler Romme und suchen nach den 8 im Dorf versteckten Markierungen."
    ],
    "en": [
      "Available all year round. \r\n\r\nRosalie is taking the children to Romme where they will have to find the 8 control points hidden in the hamlet!"
    ],
    "it": [
      "Disponibile tutto l'anno.\r\n\r\nI bambini andranno con Rosalie, la mascotte dell'ufficio turistico, alla scoperta del borgo di Romme cercando gli 8 indicatori nascosti nel villaggio."
    ],
    "fr": [
      "Disponible toute l'année.\r\n\r\nLes enfants partiront avec Rosalie, la mascotte de l'office de tourisme, à la découverte du hameau de Romme en recherchant les 8 balises cachées dans le village."
    ],
    "nl": [
      "Het hele jaar door beschikbaar.\r\n\r\nKinderen gaan met Rosalie, de mascotte van het toeristenbureau, het gehucht Romme ontdekken door op zoek te gaan naar de 8 verborgen markers in het dorp."
    ],
    "es": [
      "Disponible todo el año.\r\n\r\nLos niños irán con Rosalie, la mascota de la oficina de turismo, a descubrir la aldea de Romme buscando los 8 marcadores escondidos en el pueblo."
    ]
  },
  "rdfs:label": {
    "en": [
      "A Journey with Rosalie - Orienteering"
    ],
    "fr": [
      "À l'aventure avec Rosalie - Parcours d'orientation"
    ]
  },
