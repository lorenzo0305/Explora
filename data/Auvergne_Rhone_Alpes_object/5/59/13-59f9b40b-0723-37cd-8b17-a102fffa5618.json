  "rdfs:comment": {
    "de": [
      "Nehmen Sie vom 27. bis 29. März 2026 an der von François Nyame-Siliki geleiteten Gospel-Masterclass in L'Embarcadère teil. Drei Tage Gesang für erfahrene Chorsänger in einer warmen Atmosphäre mit einem öffentlichen Abschlusskonzert am Sonntag."
    ],
    "en": [
      "Join François Nyame-Siliki for a gospel masterclass at L?Embarcadère from March 27 to 29, 2026. Three days of singing for experienced choristers, in a warm atmosphere, with a final concert open to the public on Sunday."
    ],
    "it": [
      "Partecipate alla masterclass di gospel guidata da François Nyame-Siliki a L'Embarcadère dal 27 al 29 marzo 2026. Tre giorni di canto per coristi esperti, in una calda atmosfera, con un concerto finale aperto al pubblico la domenica."
    ],
    "fr": [
      "Participez à la masterclass gospel animée par François Nyame-Siliki à L’Embarcadère du 27 au 29 mars 2026. Trois jours de chant pour choristes avertis, dans une ambiance chaleureuse, avec concert de restitution ouvert au public le dimanche."
    ],
    "es": [
      "Participe en la clase magistral de gospel dirigida por François Nyame-Siliki en L'Embarcadère del 27 al 29 de marzo de 2026. Tres días de canto para coristas experimentados, en un ambiente cálido, con un concierto final abierto al público el domingo."
    ],
    "nl": [
      "Neem deel aan de gospelmasterclass onder leiding van François Nyame-Siliki in L'Embarcadère van 27 tot 29 maart 2026. Drie dagen zingen voor ervaren koorleden, in een warme sfeer, met een slotconcert voor publiek op zondag."
    ]
  },
