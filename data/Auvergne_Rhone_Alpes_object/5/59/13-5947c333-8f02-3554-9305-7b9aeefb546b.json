  "rdfs:comment": {
    "de": [
      "Entdecke Bloc Session Vienne, die Kletterhalle, die für alle zugänglich ist! Mit erschwinglichen Preisen, einer freundlichen Atmosphäre und einer Schule, die zahlreiche Kurse für alle Niveaus anbietet! Du wirst schnell Fortschritte machen können."
    ],
    "en": [
      "Discover Bloc Session Vienne, the climbing gym for everyone! With affordable rates, a friendly atmosphere and a school offering a wide range of courses for all levels! You'll be able to make rapid progress."
    ],
    "it": [
      "Scoprite Bloc Session Vienne, la palestra di arrampicata per tutti! Con prezzi accessibili, un'atmosfera amichevole e una scuola che offre un'ampia gamma di corsi per tutti i livelli! Sarete in grado di fare rapidi progressi."
    ],
    "fr": [
      "Découvre Bloc Session Vienne, la salle d’escalade accessible à tous ! Avec des tarifs abordables, une ambiance conviviale et une école proposant de nombreux cours pour tous les niveaux ! Tu pourras progresser rapidement."
    ],
    "nl": [
      "Ontdek Bloc Session Vienne, de klimzaal voor iedereen! Met betaalbare prijzen, een gezellige sfeer en een school met een breed aanbod aan cursussen voor alle niveaus! Je zult snel vooruitgang boeken."
    ],
    "es": [
      "Descubra Bloc Session Vienne, el rocódromo para todos Con precios asequibles, un ambiente agradable y una escuela que ofrece una amplia gama de cursos para todos los niveles Podrás progresar rápidamente."
    ]
  },
