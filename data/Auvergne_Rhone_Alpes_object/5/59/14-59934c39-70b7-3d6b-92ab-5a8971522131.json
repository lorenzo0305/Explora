  "rdfs:comment": {
    "de": [
      "François Cervantes leiht seine Stimme und seinen Körper einem Mann, der seiner Freiheit beraubt ist, indem er eine Briefbeziehung mit dem Häftling Erik, einem wilden Tier, das sich inmitten der Menschen verirrt hat, erzählt."
    ],
    "en": [
      "François Cervantes lends his voice and his body to a man deprived of his freedom, through the story of an epistolary relationship with the prisoner Erik, a wild animal lost among men."
    ],
    "it": [
      "François Cervantes presta la sua voce e il suo corpo a un uomo privato della libertà, attraverso il racconto di un rapporto epistolare con il prigioniero Erik, un animale selvatico perso tra gli uomini."
    ],
    "fr": [
      "François Cervantes prête sa voix et son corps à un homme privé de liberté, à travers le récit d’une relation épistolaire avec le détenu Erik, animal sauvage égaré au milieu des hommes."
    ],
    "es": [
      "François Cervantes presta su voz y su cuerpo a un hombre privado de libertad, a través del relato de una relación epistolar con el prisionero Erik, un animal salvaje perdido entre los hombres."
    ],
    "nl": [
      "François Cervantes leent zijn stem en zijn lichaam aan een man die van zijn vrijheid is beroofd, via het verhaal van een briefwisseling met de gevangene Erik, een wild dier dat verdwaald is onder de mensen."
    ]
  },
