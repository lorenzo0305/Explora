  "rdfs:comment": {
    "de": [
      "Anaëlle und Amandine haben dieses kleine Restaurant auf dem Dorfplatz übernommen. Eine beliebte Mittagspause bei Motorradfahrern und Radtouristen. Das mittags servierte Tagesmenü macht abends Platz für eine großzügige Bistrokarte."
    ],
    "en": [
      "Anaëlle and Amandine have taken over this small restaurant on the village square. A popular lunch spot for bikers and cyclists. The daily lunch menu gives way to a generous bistro menu in the evening."
    ],
    "it": [
      "Anaëlle e Amandine hanno rilevato questo piccolo ristorante nella piazza del paese. Un punto di ristoro molto apprezzato da ciclisti e motociclisti. Il menu del pranzo giornaliero è seguito da un generoso menu da bistrot la sera."
    ],
    "fr": [
      "Anaëlle et Amandine ont repris ce petit restaurant situé sur la place du village. Une pause déjeuner prisée par motards et cyclotouristes. Le menu du jour servi à midi laisse place, le soir, à une carte de bistrot généreuse."
    ],
    "es": [
      "Anaëlle y Amandine se han hecho cargo de este pequeño restaurante de la plaza del pueblo. Un lugar muy frecuentado por motoristas y ciclistas. Al menú del día le sigue un generoso menú de bistró por la noche."
    ],
    "nl": [
      "Anaëlle en Amandine hebben dit kleine restaurant op het dorpsplein overgenomen. Een populaire lunchplek voor fietsers en motorrijders. Het dagelijkse lunchmenu wordt 's avonds gevolgd door een royaal bistromenu."
    ]
  },
  "rdfs:label": {
    "en": [
      "Au Branguignol"
    ],
    "fr": [
      "Le Brangues"
    ]
  },
