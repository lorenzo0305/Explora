  "rdfs:comment": {
    "de": [
      "Die Rosalie des Bonnevaux ist ein Kramladen auf Rädern, der mit menschlicher Energie betrieben wird. Mit Eleganz lässt sie sich nieder und entfaltet ihr Bistro-Carriole und ihre gute Laune im Herzen der Dörfer von Porte des Bonnevaux, um einen Hauch von früher wiederzufinden."
    ],
    "en": [
      "La Rosalie des Bonnevaux is a bric-a-brac on wheels, fueled by human energy. With elegance, she sets up her bistrot-carriole and her good humor in the heart of the villages of Porte des Bonnevaux to recapture an air of yesteryear."
    ],
    "it": [
      "La Rosalie des Bonnevaux è un bric-a-brac su ruote, alimentato dall'energia umana. Con eleganza, allestisce il suo bistrot-carriola e il suo buonumore nel cuore dei villaggi di Porte des Bonnevaux per riscoprire un'aria d'altri tempi."
    ],
    "fr": [
      "La Rosalie des Bonnevaux est un bric à brac sur roues, carburant à l'énergie humaine. Avec élégance, elle s'installe et déploie son bistrot-carriole et sa bonne humeur au coeur des villages de Porte des Bonnevaux pour retrouver un air d'antan."
    ],
    "nl": [
      "La Rosalie des Bonnevaux is een bric-a-brac op wielen, gevoed door menselijke energie. Met elegantie vestigt ze haar bistro-carriole en haar goede humeur in het hart van de dorpen van Porte des Bonnevaux om een sfeer van weleer te herontdekken."
    ],
    "es": [
      "La Rosalie des Bonnevaux es un bricolaje sobre ruedas, alimentado por la energía humana. Con elegancia, instala su bistro-carriole y su buen humor en el corazón de los pueblos de Porte des Bonnevaux para redescubrir un aire de antaño."
    ]
  },
  "rdfs:label": {
