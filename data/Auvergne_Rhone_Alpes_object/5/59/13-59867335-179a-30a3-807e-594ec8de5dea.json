  "rdfs:comment": {
    "de": [
      "Das Restaurant Le Chat Vert befindet sich in einer ehemaligen Poststation mit Gewölbekellern aus Stein und ist in der Nebensaison nur mit Reservierung zugänglich."
    ],
    "en": [
      "Located in an old coaching inn with vaulted stone cellars, Le Chat Vert is a restaurant open only by reservation in the off-season, serving local and Brazilian cuisine."
    ],
    "it": [
      "Situato in un'antica locanda con cantine a volta in pietra, Le Chat Vert è un ristorante aperto solo su prenotazione in bassa stagione, che serve cucina locale e brasiliana."
    ],
    "fr": [
      "Situé dans un ancien Relais de Poste avec ses caves voutées en pierre, le Chat Vert est un restaurant accessible uniquement sur réservation en hors saison proposant une cuisine locale mais aussi brésilienne."
    ],
    "es": [
      "Situado en una antigua posada con bodegas de piedra abovedadas, Le Chat Vert es un restaurante abierto sólo con reserva en temporada baja, que sirve cocina local y brasileña."
    ],
    "nl": [
      "Le Chat Vert, gevestigd in een voormalige herberg met gewelfde stenen kelders, is een restaurant dat buiten het seizoen alleen op reservering geopend is en waar lokale en Braziliaanse gerechten geserveerd worden."
    ]
  },
