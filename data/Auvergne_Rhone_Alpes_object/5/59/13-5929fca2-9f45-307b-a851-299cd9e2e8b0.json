  "rdfs:comment": {
    "de": [
      "L'Oiseau Siffleur ist eine unabhängige, allgemeine Buchhandlung. Sie bietet eine große Auswahl an Literatur, Geisteswissenschaften, Krimis, Jugendbüchern, praktischen Büchern, Bildender Kunst, englischen Büchern sowie Schreibwaren und Postkarten."
    ],
    "en": [
      "L'Oiseau Siffleur is an independent general bookshop, offering a wide selection of literature, humanities, thrillers, children's books, practical books, fine arts, English books, as well as stationery and postcards."
    ],
    "it": [
      "L'Oiseau Siffleur è una libreria generale indipendente che offre un'ampia selezione di libri di letteratura, scienze umane, thriller, libri per bambini, libri pratici, belle arti, libri inglesi, oltre a cartoleria e cartoline."
    ],
    "fr": [
      "L’Oiseau Siffleur est une librairie indépendante généraliste, elle propose un large choix en littérature, sciences humaines, polar, jeunesse, pratique, beaux-arts, english books, ainsi que de la papeterie et des cartes postales."
    ],
    "nl": [
      "L'Oiseau Siffleur is een onafhankelijke algemene boekhandel met een ruime keuze aan literatuur, geesteswetenschappen, thrillers, kinderboeken, praktische boeken, kunstboeken, Engelse boeken, maar ook schrijfwaren en ansichtkaarten."
    ],
    "es": [
      "L'Oiseau Siffleur es una librería general independiente que ofrece una amplia selección de literatura, humanidades, thrillers, libros infantiles, libros prácticos, bellas artes, libros ingleses, así como papelería y postales."
    ]
  },
  "rdfs:label": {
    "fr": [
