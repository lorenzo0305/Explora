  "rdfs:comment": {
    "de": [
      "Hören Sie Maxime Della Coletta, Sänger und Gitarrist: Brassens, Renaud und Anne Sylvestre haben ihn dazu gebracht, Lieder zu schreiben, Francis Cabrel, John Mayer oder auch Mark Knopfler haben das Gitarrenvirus in seinen Händen verbreitet."
    ],
    "en": [
      "Come and listen to Maxime Della Coletta, singer and guitarist: Brassens, Renaud and Anne Sylvestre inspired him to write songs, while Francis Cabrel, John Mayer and Mark Knopfler spread the guitar virus in his hands."
    ],
    "it": [
      "Venite ad ascoltare Maxime Della Coletta, cantante e chitarrista: Brassens, Renaud e Anne Sylvestre lo hanno ispirato a scrivere canzoni, mentre Francis Cabrel, John Mayer e Mark Knopfler hanno diffuso il virus della chitarra attraverso le sue mani."
    ],
    "fr": [
      "Venez écouter Maxime Della Coletta, chanteur et guitariste : Brassens, Renaud et Anne Sylvestre l'ont poussé à écrire des chansons, Francis Cabrel, John Mayer ou encore Mark Knopfler ont propagé le virus de la guitare dans ses mains."
    ],
    "es": [
      "Venga a escuchar a Maxime Della Coletta, cantante y guitarrista: Brassens, Renaud y Anne Sylvestre le inspiraron para escribir canciones, mientras que Francis Cabrel, John Mayer y Mark Knopfler propagaron el virus de la guitarra a través de sus manos."
    ],
    "nl": [
      "Kom luisteren naar Maxime Della Coletta, zanger en gitarist: Brassens, Renaud en Anne Sylvestre inspireerden hem tot het schrijven van liedjes, terwijl Francis Cabrel, John Mayer en Mark Knopfler het gitaarvirus via zijn handen verspreidden."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Maxime Della Coletta en concert"
    ]
  },
