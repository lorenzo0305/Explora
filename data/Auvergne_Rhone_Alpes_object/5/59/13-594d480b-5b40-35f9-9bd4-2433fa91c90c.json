  "rdfs:comment": {
    "de": [
      "Tennisplatz in der Nähe des Stadtzentrums von Saint-Agrève, Reservierung beim Centre socio culturel.\r\nWenn Sie die Plätze am Wochenende nutzen möchten, denken Sie daran, bis spätestens Freitagnachmittag zu reservieren!\r\nVor Ort finden Sie einen Kinderspielplatz."
    ],
    "en": [
      "Tennis courts near the center of Saint-Agrève, book at the socio-cultural center.\r\nTo use the courts at weekends, please book by Friday afternoon at the latest!\r\nThere's a children's playground on site."
    ],
    "it": [
      "Campi da tennis vicino al centro di Saint-Agrève, prenotare presso il centro socio-culturale.\r\nPer utilizzare i campi nel fine settimana, ricordatevi di prenotare entro e non oltre il venerdì pomeriggio!\r\nIn loco è presente un'area giochi per bambini."
    ],
    "fr": [
      "Terrain de tennis à proximité du centre-bourg de Saint-Agrève, réservation auprès du centre socio culturel.\r\nPour profiter des courts le week-end, pensez à réserver au plus tard vendredi après-midi !\r\nVous trouverez sur place une aire de jeux pour enfants."
    ],
    "nl": [
      "Tennisbanen in de buurt van het centrum van Saint-Agrève, reserveren bij het sociaal-cultureel centrum.\r\nAls je de banen in het weekend wilt gebruiken, moet je uiterlijk vrijdagmiddag reserveren!\r\nEr is een speeltuin voor kinderen."
    ],
    "es": [
      "Pistas de tenis cerca del centro de Saint-Agrève, reservar en el centro sociocultural.\r\nPara utilizar las pistas los fines de semana, no olvide reservar antes del viernes por la tarde\r\nHay una zona de juegos para niños."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Terrain de tennis"
    ]
  },
