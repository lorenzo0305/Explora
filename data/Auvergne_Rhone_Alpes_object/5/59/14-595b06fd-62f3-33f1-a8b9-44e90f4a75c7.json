      "@id": "https://data.datatourisme.fr/189b6279-ecf3-3c8a-8246-9c97c8cc796b",
      "dc:description": {
        "de": [
          "Rennen für 2er-Teams in Blokarts und Mini-4ern\n\nSamstag, 21. September\n8.00 Uhr Öffnung des Clubs\n8.45 Uhr Startlinie, Briefing, Start\n19.00 Uhr Freier Abend oder Abend im Club\n\nSonntag 22. September\n8.00 Uhr Öffnung des Clubs\n8.45 Uhr Startlinie, Briefing, Abfahrt\n14.00 Uhr Preisverleihung\n\nDie Zeiten können sich je nach Ergebnis des Samstags ändern."
        ],
        "en": [
          "Team race of 2 in blokart and mini 4\n\nSaturday, September 21st\n8:00 Club opening\n8:45 Start line, briefing, departure\n7:00 pm Free evening or evening at the Club\n\nSunday September 22nd\n8:00 Club opening\n8:45 Start line, briefing, departure\n2:00 pm Prize-giving ceremony\n\nTimes are subject to change depending on Saturday's results."
        ],
        "it": [
          "Gara a squadre di 2 persone in blokart e mini 4\n\nSabato 21 settembre\n8.00 Apertura del club\n8.45 Linea di partenza, briefing, partenza\n19.00 Serata libera o serata al Club\n\nDomenica 22 settembre\n8.00 Apertura del club\n8.45 Linea di partenza, briefing, partenza\n14h00 Cerimonia di premiazione\n\nGli orari sono soggetti a modifiche in base ai risultati di sabato."
        ],
        "fr": [
          "Course par équipe de 2 en blokart et mini 4 \n\nSamedi 21 septembre \n8h00  Ouverture du Club\n8h45  Ligne de départ, briefing, départ \n19h00  Soirée libre ou soirée au Club\n\nDimanche 22 septembre\n8h00  Ouverture du Club \n8h45 Ligne de départ, briefing, départ \n14h00 Remise des Prix \n\nLes horaires sont susceptibles de changer suivant le résultat du samedi."
        ],
        "nl": [
          "Race per team van 2 in blokart en mini 4\n\nZaterdag 21 september\n8.00 Clubopening\n8.45 Startlijn, briefing, start\n19:00 Vrije avond of avond in de Club\n\nZondag 22 september\n8.00 Clubopening\n8.45 Startlijn, briefing, start\n14u00 Prijsuitreiking\n\nTijden kunnen veranderen afhankelijk van de resultaten van zaterdag."
        ],
        "es": [
          "Carrera por equipos de 2 en blokart y mini 4\n\nSábado 21 de septiembre\n8.00 Apertura del club\n8.45 Línea de salida, briefing, salida\n19:00 Tarde libre o velada en el Club\n\nDomingo 22 de septiembre\n8.00 Apertura del club\n8.45 Línea de salida, briefing, salida\n14h00 Entrega de premios\n\nHorarios sujetos a cambios en función de los resultados del sábado."
        ]
      },
