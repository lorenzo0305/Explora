  "rdfs:comment": {
    "de": [
      "Der 18-Loch-Minigolfplatz von Bernex ist ein netter, generationenübergreifender Freizeitort in der Nähe des Flusses. Nutzen Sie die Buvette du Mazot, die während der Öffnungszeiten des Minigolfplatzes geöffnet ist!"
    ],
    "en": [
      "Bernex's 18-hole mini-golf course is a fun, intergenerational leisure facility close to the river. The Buvette du Mazot is open during mini-golf opening hours!"
    ],
    "it": [
      "Il campo da minigolf a 18 buche di Bernex è un luogo di gioco ideale per tutte le generazioni, proprio accanto al fiume. La Buvette du Mazot è aperta durante gli orari di apertura del minigolf!"
    ],
    "fr": [
      "Le mini-golf 18 trous de Bernex est un lieu de loisir intergénérationnel sympa à proximité de la rivière. Profitez de la Buvette du Mazot ouvert pendant les heures d'ouvertures du mini-golf !"
    ],
    "es": [
      "El campo de minigolf de 18 hoyos de Bernex es un lugar de juego ideal para todas las generaciones, justo al lado del río. La Buvette du Mazot está abierta durante el horario de apertura del minigolf"
    ],
    "nl": [
      "De 18-holes midgetgolfbaan van Bernex is een geweldige plek om te spelen voor alle generaties, direct aan de rivier. De Buvette du Mazot is geopend tijdens de openingstijden van de midgetgolfbaan!"
    ]
  },
