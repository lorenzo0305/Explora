  "rdfs:comment": {
    "de": [
      "Mit Liebe zubereitete Küche, einfach, aber nicht simpel. Das Restaurant arbeitet zu 80% mit lokalen, biologischen und fair gehandelten Produkten. Natürliche und biodynamische Weine. Schattiger und ruhiger Innengarten."
    ],
    "en": [
      "Cuisine made with love, simple but not simplistic. We cook with 80% local, organic and fair-trade produce and offer a selection of natural and biodynamic wines. Outdoor terrace, under the trees in a quiet environment."
    ],
    "it": [
      "Una cucina fatta con amore, semplice ma non semplicistica. L'80% dei prodotti del ristorante sono locali, biologici e del commercio equo e solidale. Vini naturali e biodinamici. Giardino interno tranquillo e ombreggiato."
    ],
    "fr": [
      "Cuisine faîte avec amour, simple mais pas simpliste. Restaurant travaillant à 80% avec des produits locaux, bio et issus du commerce équitable. Vins natures et en biodynamie. Jardin intérieur ombragé et calme."
    ],
    "nl": [
      "Keuken met liefde gemaakt, eenvoudig maar niet simplistisch. 80% van de producten van het restaurant zijn lokaal, biologisch en fair trade. Natuurlijke en biodynamische wijnen. Rustige, schaduwrijke binnentuin."
    ],
    "es": [
      "Cocina hecha con amor, sencilla pero no simplista. El 80% de los productos del restaurante son locales, ecológicos y de comercio justo. Vinos naturales y biodinámicos. Jardín interior tranquilo y sombreado."
    ]
  },
