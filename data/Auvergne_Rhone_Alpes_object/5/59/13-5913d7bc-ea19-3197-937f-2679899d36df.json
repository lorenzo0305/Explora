  "rdfs:comment": {
    "de": [
      "Ort für kulturelle Experimente in der Region. Le Bief stellt ein Programm mit Aufführungen und bildender Kunst (Druckgrafik, Gravur) auf die Beine. Es ist ein Verein, der sich für die Verbreitung von Kultur an ein möglichst breites Publikum einsetzt"
    ],
    "en": [
      "An artistic space dedicated to engraving and micropublishing linked to the  tradition of paper making in the region. Workshops of typography and screen-printing and linocut."
    ],
    "it": [
      "Un luogo di sperimentazione culturale nella regione. Le Bief propone un programma di spettacoli e arti visive (stampa, incisione). È un'associazione che lavora per diffondere la cultura a un pubblico il più ampio possibile"
    ],
    "fr": [
      "Lieu d’expérimentations culturelles sur le territoire. Le Bief met en place une programmation de spectacle et d'arts plastiques (estampe, gravure). C'est une association, qui œuvre pour la diffusion de la culture auprès d’un public le plus large possible"
    ],
    "es": [
      "Un lugar para la experimentación cultural en la región. Le Bief ofrece un programa de espectáculos y artes visuales (grabado, estampación). Es una asociación que trabaja para difundir la cultura entre un público lo más amplio posible"
    ],
    "nl": [
      "Een plek voor culturele experimenten in de regio. Le Bief biedt een programma van voorstellingen en beeldende kunst (prenten, gravures). Het is een vereniging die zich inzet om cultuur te verspreiden onder een zo breed mogelijk publiek"
    ]
  },
