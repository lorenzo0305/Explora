  "rdfs:comment": {
    "de": [
      "Von der mittelalterlichen Kirche, die von St. Stephanus behütet wurde, sind nur noch Teile des Mobiliars erhalten. Der Grundstein für die heutige Kirche wurde 1845 gelegt."
    ],
    "en": [
      "All that remains of the medieval church, patronized by Saint-Étienne, is the furniture. The foundation stone for the present-day church was laid in 1845."
    ],
    "it": [
      "Della chiesa medievale, patrocinata da Saint-Étienne, rimangono solo gli arredi. La prima pietra dell'attuale chiesa fu posta nel 1845."
    ],
    "fr": [
      "De l'église médiévale patronnée par Saint-Étienne, il ne reste que les éléments du mobilier. La première pierre de l'église actuelle est posée en 1845."
    ],
    "nl": [
      "Van de middeleeuwse kerk, die door Saint-Étienne werd gepatroneerd, is alleen het meubilair overgebleven. De eerste steen van de huidige kerk werd gelegd in 1845."
    ],
    "es": [
      "De la iglesia medieval, patrocinada por Saint-Étienne, sólo queda el mobiliario. La primera piedra de la iglesia actual se colocó en 1845."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Église de l'Immaculée Conception"
    ]
  },
