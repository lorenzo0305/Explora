  "rdfs:comment": {
    "de": [
      "Das Atelier des lignes ist eine Werkstatt und ein Ausstellungs- und Verkaufsraum. Hier können Sie handwerkliche Kreationen, Schmuck und Holzobjekte entdecken, die von den Bergen inspiriert sind. Hier werden Sie zu Einführungsworkshops in die Holzbearbeitung empfangen."
    ],
    "en": [
      "L'atelier des lignes is a workshop and showroom where you can discover handcrafted creations, jewelry and wooden objects inspired by the mountains. It also proposes woodworking initiation workshops."
    ],
    "it": [
      "L'atelier des lignes è un laboratorio e uno spazio espositivo e di vendita dove si possono scoprire creazioni artigianali, gioielli e oggetti in legno ispirati alla montagna. È inoltre possibile partecipare a laboratori di iniziazione alla lavorazione del legno."
    ],
    "fr": [
      "L’atelier des lignes est un atelier de fabrication et un espace d'expo-vente, vous découvrirez des créations artisanales, des bijoux et objets en bois inspirés de la montagne. Vous y serez accueilli pour des ateliers d'initiations au travail du bois."
    ],
    "nl": [
      "L'atelier des lignes is zowel een werkplaats als een tentoonstellings- en verkoopruimte, waar je handgemaakte creaties, sieraden en houten voorwerpen kunt ontdekken die geïnspireerd zijn door de bergen. Je kunt ook deelnemen aan inleidende workshops houtbewerken."
    ],
    "es": [
      "L'atelier des lignes es un taller y espacio de exposición-venta donde podrá descubrir creaciones artesanales, joyas y objetos de madera inspirados en la montaña. También puede participar en talleres de iniciación a la madera."
    ]
  },
  "rdfs:label": {
    "en": [
      "atelier des lignes - jewelry and handcrafted objects in wood"
    ],
    "fr": [
      "Atelier des lignes - bijoux et objets artisanaux en bois"
    ],
    "nl": [
      "Atelier des lignes - sieraden en houten handwerk"
    ]
  },
