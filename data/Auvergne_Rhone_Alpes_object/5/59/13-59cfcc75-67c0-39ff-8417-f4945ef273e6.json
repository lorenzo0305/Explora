  "rdfs:comment": {
    "de": [
      "Die Freunde der Stiftskirche Saint-Barnard und des Kalvarienbergs der Récollets bieten Ihnen den ganzen Sommer über Führungen durch die Stiftskirche Saint-Barnard an. Kommen Sie zahlreich, um diese Angebote zu nutzen!"
    ],
    "en": [
      "Les Amis de la Collégiale Saint-Barnard et du Calvaire des Récollets offers guided tours of the Collégiale Saint-Barnard throughout the summer. Come one, come all!"
    ],
    "it": [
      "Gli Amici della Collegiata di Saint-Barnard e del Calvario dei Récollets propongono visite guidate alla Collegiata di Saint-Barnard per tutta l'estate, non mancate!"
    ],
    "fr": [
      "Les Amis de la Collégiale Saint-Barnard et du Calvaire des Récollets vous propose des visites guidées de la Collégiale Saint-Barnard tout au long de l'été, venez nombreux pour en profiter !"
    ],
    "es": [
      "Los Amigos de la Colegiata de Saint-Barnard y del Calvario de los Récollets proponen visitas guiadas a la Colegiata de Saint-Barnard durante todo el verano, ¡no se lo pierda!"
    ],
    "nl": [
      "De Vrienden van de collegiale kerk Saint-Barnard en de Calvarieberg van de Récollets bieden de hele zomer rondleidingen aan in de collegiale kerk Saint-Barnard, dus mis het niet!"
    ]
  },
