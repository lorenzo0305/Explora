  "rdfs:comment": {
    "de": [
      "Saveur Bohème ist ein Ort, an dem man morgens Kaffee trinkt, mittags zu Mittag isst und nachmittags hausgemachte Patisserie genießt. Das alles in einer Cocooning-, Natur- und geselligen Atmosphäre mitten im Stadtzentrum."
    ],
    "en": [
      "Saveur Bohème is a place where you can have coffee in the morning, lunch at midday, and enjoy home-made pastries in the afternoon, all in a cocooning, natural and friendly atmosphere right in the center of town."
    ],
    "it": [
      "Saveur Bohème è un luogo dove si può prendere un caffè al mattino, pranzare a mezzogiorno e gustare dolci fatti in casa nel pomeriggio, il tutto in un'atmosfera accogliente, naturale e amichevole proprio nel centro della città."
    ],
    "fr": [
      "Saveur Bohème est un lieu où l’on prend le café le matin, où l’on déjeune le midi, et où l’on profite des pâtisseries maison l’après-midi, le tout dans une ambiance cocooning, nature et conviviale en plein centre-ville."
    ],
    "nl": [
      "Saveur Bohème is een plek waar je 's ochtends koffie kunt drinken, 's middags kunt lunchen en 's middags kunt genieten van huisgemaakt gebak, allemaal in een gezellige, natuurlijke en vriendelijke sfeer midden in het centrum."
    ],
    "es": [
      "Saveur Bohème es un lugar donde tomar un café por la mañana, almorzar al mediodía y disfrutar de repostería casera por la tarde, todo ello en un ambiente acogedor, natural y agradable en pleno centro de la ciudad."
    ]
  },
  "rdfs:label": {
