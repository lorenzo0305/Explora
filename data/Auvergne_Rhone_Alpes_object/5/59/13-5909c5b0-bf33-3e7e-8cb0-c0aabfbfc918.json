  "rdfs:comment": {
    "de": [
      "Das Cinéma itinérant des Monts du Lyonnais zeigt alle 14 Tage mehrere aktuelle Filme in 14 ländlichen Gemeinden der Monts du Lyonnais."
    ],
    "en": [
      "Every 15 days, the Cinéma itinérant des Monts du Lyonnais presents several recent films in 14 rural towns in the Monts du Lyonnais region."
    ],
    "it": [
      "Il Cinéma itinérant des Monts du Lyonnais proietta ogni quindici giorni una serie di film recenti in 14 comuni rurali dei Monts du Lyonnais."
    ],
    "fr": [
      "Le Cinéma itinérant des Monts du Lyonnais propose tous les 15 jours plusieurs films récents dans 14 communes rurales des Monts du Lyonnais."
    ],
    "es": [
      "El Cinéma itinérant des Monts du Lyonnais proyecta quincenalmente varias películas recientes en 14 municipios rurales de los Monts du Lyonnais."
    ],
