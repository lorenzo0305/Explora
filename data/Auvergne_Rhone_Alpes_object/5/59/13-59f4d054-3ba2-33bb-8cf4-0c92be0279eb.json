  "rdfs:comment": {
    "de": [
      "Ein Café Auberge im Herzen der Berge. Gute lokale Produkte und selbstgebrautes Bier für eine leckere Pause auf Ihrem Weg."
    ],
    "en": [
      "Coffee shop and snacks\r\nLocal products (beer, wine, Cola Ardeche, Bigallet sirups ...)\r\n\r\nMoto riders, horserides, bike riders, hikers welcome !"
    ],
    "it": [
      "Un café auberge nel cuore delle montagne. Ottimi prodotti locali e birra artigianale per una pausa golosa durante il cammino."
    ],
    "fr": [
      "Un café auberge au cœur de la montagne. De bon produits locaux et de la bière artisanale pour une pause gourmande sur votre route."
    ],
    "es": [
