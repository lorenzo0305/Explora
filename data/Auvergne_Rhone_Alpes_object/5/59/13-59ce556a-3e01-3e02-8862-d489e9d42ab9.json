  "rdfs:comment": {
    "de": [
      "Charmantes, familiäres Chalet-Hotel inmitten der Berge, wo Françoise und Olivier Sie herzlich willkommen heißen. Restaurant, Bar mit Kamin, beheizte Innen- und Außenpools, Spa, Sauna/Hammam/Jacuzzi, Fitness, Tennis, Spielzimmer. Skibushaltestelle."
    ],
    "en": [
      "A delightful family hotel chalet nestled at the heart of the mountains where Françoise & Olivier welcome you with friendliness. Restaurant, bar with fireplace, 2 heated swimming pools, one indoor and one outdoor, spa, hot tub/steam room/jacuzzi, fitness room, tennis court, game room. Ski shuttle bus stop."
    ],
    "it": [
      "Incantevole chalet hotel a conduzione familiare immerso nel cuore delle montagne, dove Françoise e Olivier offrono un'accoglienza cordiale. Ristorante, bar con camino, piscine interne/esterne riscaldate, spa, sauna/hammam/jacuzzi, fitness, tennis, sala giochi. Fermata dello skibus."
    ],
    "fr": [
      "Hôtel chalet de charme familial blotti au cœur des montagnes où Françoise et Olivier vous accueillent avec convivialité. Restaurant, bar avec cheminée, piscines chauffées int./ext., spa, sauna/hammam/jacuzzi, fitness, tennis, salle de jeux. Arrêt ski bus."
    ],
    "es": [
      "Encantador hotel chalet de gestión familiar situado en el corazón de las montañas, donde Françoise y Olivier le ofrecen una agradable bienvenida. Restaurante, bar con chimenea, piscinas interior y exterior climatizadas, spa, sauna/hammam/jacuzzi, gimnasio, tenis, sala de juegos. Parada de autobús de esquí."
    ],
    "nl": [
      "Een heerlijk familiehotel in het hart van de bergen waar Françoise & Olivier u vriendelijk ontvangen. Restaurant, bar met open haard, 2 verwarmde zwembaden, een binnen- en een buitenbad, spa, hot tub/stoombad/jacuzzi, fitnessruimte, tennisbaan, speelzaal. Skibushalte."
    ]
  },
