  "rdfs:comment": {
    "de": [
      "Unser Restaurant befindet sich an einem historischen Standort in Vichy, dem Hufeisen, das sich in der Verlängerung des Parc des Sources befindet. Wir werden uns gegenüber dem Musikpavillon befinden und nur wenige Schritte von der Oper von Vichy entfernt sein."
    ],
    "en": [
      "Our restaurant is located in a historic Vichy location, the Fer à Cheval, which is an extension of the Parc des Sources. We'll be opposite the bandstand, a stone's throw from the Vichy Opera House."
    ],
    "it": [
      "Il nostro ristorante si trova in uno dei luoghi storici di Vichy, il Fer à Cheval, che è un'estensione del Parc des Sources. Siamo di fronte al palco della banda, a due passi dal Teatro dell'Opera di Vichy."
    ],
    "fr": [
      "Notre restaurant est situé dans un emplacement historique de Vichy, le Fer à cheval, qui est situé dans le prolongement du parc des Sources. Nous serons en face du kiosque à musique à deux pas de l'Opéra de Vichy."
    ],
    "nl": [
      "Ons restaurant is gevestigd in een van de historische locaties van Vichy, de Fer à Cheval, dat een uitbreiding is van het Parc des Sources. We zitten tegenover de muziektent, op een steenworp afstand van de Opera van Vichy."
    ],
    "es": [
      "Nuestro restaurante está situado en uno de los lugares históricos de Vichy, el Fer à Cheval, que es una extensión del Parc des Sources. Estaremos frente al quiosco de música, a dos pasos de la Ópera de Vichy."
    ]
  },
  "rdfs:label": {
    "fr": [
      "L’Écrin de Marlène"
    ]
  },
