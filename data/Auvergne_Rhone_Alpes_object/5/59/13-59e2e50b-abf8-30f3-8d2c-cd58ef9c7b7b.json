  "rdfs:comment": {
    "de": [
      "Dieses Restaurant ist in die Abtei Saint-Robert de La Chaise-Dieu eingebettet und verdankt seinen Namen dem Echoraum, der nur wenige Schritte entfernt liegt und für seine ganz besondere Akustik bekannt ist."
    ],
    "en": [
      "Set in the Saint-Robert Abbey in La Chaise-Dieu, this restaurant owes its name to the echo room located a few steps away and known for its very special acoustics."
    ],
    "it": [
      "Incastonato nell'abbazia di Saint-Robert de La Chaise-Dieu, questo ristorante deve il suo nome alla sala dell'eco situata a pochi passi e nota per la sua acustica molto particolare."
    ],
    "fr": [
      "Enchâssée dans l'abbaye Saint-Robert de La Chaise-Dieu, ce restaurant doit son nom à la salle de l'écho située à quelques pas et connue pour son acoustique très particulière."
    ],
    "es": [
      "Incrustado en la abadía de Saint-Robert de La Chaise-Dieu, este restaurante debe su nombre a la sala del eco situada a pocos pasos y conocida por su acústica tan particular."
    ],
    "nl": [
      "Dit restaurant, gevestigd in de abdij Saint-Robert de La Chaise-Dieu, dankt zijn naam aan de op een steenworp afstand gelegen galmzaal die bekend staat om zijn bijzondere akoestiek."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant \"L'Echo et L'Abbaye\""
    ]
  },
