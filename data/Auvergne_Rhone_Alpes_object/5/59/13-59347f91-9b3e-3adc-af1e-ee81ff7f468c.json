  "rdfs:comment": {
    "de": [
      "\"La Fromagerie de Peisey\" wurde 2021 gegründet und umfasst 3 Betriebe aus dem Tal von Peisey-Nancroix: die EARL les chèvres de Sainte-Agathe, die GAEC de l'Aliet und die GAEC Alpin."
    ],
    "en": [
      "\"La Fromagerie de Peisey\" was created in 2021 and brings together 3 farms in the Peisey-Nancroix valley: the EARL les chèvres de Sainte-Agathe, the GAEC de l'Aliet and the GAEC Alpin."
    ],
    "it": [
      "\"La Fromagerie de Peisey\" è stata creata nel 2021 e riunisce 3 aziende agricole della valle di Peisey-Nancroix: la EARL les chèvres de Sainte-Agathe, la GAEC de l'Aliet e la GAEC Alpin."
    ],
    "fr": [
      "« La Fromagerie de Peisey » est née en 2021 et regroupe 3 exploitations de la vallée de Peisey-Nancroix : l’EARL les chèvres de Sainte-Agathe, le GAEC de l’Aliet et le GAEC Alpin."
    ],
    "nl": [
      "\"La Fromagerie de Peisey\" werd opgericht in 2021 en verenigt 3 boerderijen in de vallei van Peisey-Nancroix: de EARL les chèvres de Sainte-Agathe, de GAEC de l'Aliet en de GAEC Alpin."
    ],
    "es": [
      "\"La Fromagerie de Peisey\" se creó en 2021 y reúne a 3 explotaciones del valle de Peisey-Nancroix: la EARL les chèvres de Sainte-Agathe, el GAEC de l'Aliet y el GAEC Alpin."
    ]
  },
  "rdfs:label": {
    "de": [
      "Besuch der Produktionswerkstatt der Käserei Peisey"
    ],
    "en": [
      "Visit to the Peisey cheese factory production workshop"
    ],
    "fr": [
      "Visite de l'atelier de fabrication de la fromagerie de Peisey"
    ]
  },
