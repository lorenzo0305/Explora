  "rdfs:comment": {
    "de": [
      "Das \"Bistronomique\" von Ambert... Formeln in der Woche mittags und abends sowie am Wochenende (die Schiefertafel wechselt jeden Service je nach Markt)"
    ],
    "en": [
      "Several options for weekday and weekend (the menu changes weekly in line with the farmers’ market). An eclectic cuisine (organic vegetables, local products). Closed Sunday evening and all day Monday."
    ],
    "it": [
      "Il \"bistronomico\" di Ambert? Formule durante la settimana per il pranzo e la cena e nel fine settimana (il menu cambia ad ogni servizio in base al mercato)"
    ],
    "fr": [
      "Le \"bistronomique\" d’Ambert… Formules en semaine midi et soir ainsi que les week end (l'ardoise change chaque service en fonction du marché)"
    ],
    "es": [
      "¿La \"bistronomía\" de Ambert? Fórmulas entre semana para el almuerzo y la cena, así como los fines de semana (la pizarra cambia cada servicio en función del mercado)"
    ],
    "nl": [
      "De \"bistronomie\" van Ambert... Formules tijdens de week voor lunch en diner en in het weekend (de lei verandert elke dienst volgens de markt)"
    ]
  },
