  "rdfs:comment": {
    "de": [
      "Cathy arbeitet mit pflanzlichem Indigo, um Textilien zu personalisieren.\r\nTreffen Sie sie auch bei Workshops, um Ihnen das Pflanzenfärben näher zu bringen!"
    ],
    "en": [
      "Cathy works with vegetable indigo to personalize textiles.\r\nYou can also join her in workshops to discover vegetable dyeing!"
    ],
    "it": [
      "Cathy lavora con l'indaco vegetale per personalizzare i tessuti.\r\nPotete anche incontrarla durante i workshop per scoprire la tintura vegetale!"
    ],
    "fr": [
      "Cathy travaille avec l'indigo végétal pour personnaliser des textiles.\r\nRetrouvez-la également lors d'ateliers pour vous faire découvrir la teinture végétale !"
    ],
    "nl": [
      "Cathy werkt met plantaardige indigo om textiel te personaliseren.\r\nJe kunt haar ook ontmoeten tijdens workshops om het plantaardig verven te ontdekken!"
    ],
    "es": [
