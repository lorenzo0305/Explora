  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/02df5204-7b90-347c-9d43-922102aec10c",
      "dc:description": {
        "de": [
          "Für Literaturbegeisterte ist dies die Gelegenheit, den poetischen Ausdruck zu teilen (Vorlesen von Texten, Lieder, Gedichte), um die Dichtkunst zu feiern.\nFreier Eintritt."
        ],
        "en": [
          "For literary enthusiasts, here's an opportunity to share poetic expression (readings, songs, poems) to celebrate the art of poetry.\nFree admission."
        ],
        "it": [
          "Un'occasione per gli amanti della letteratura di condividere l'espressione poetica (letture, canzoni, poesie) e celebrare l'arte della poesia.\nIngresso libero."
        ],
        "fr": [
          "Pour les passionnés de littérature, voici l'occasion de partager l'expression poétique (lecture de textes, chansons, poèmes) pour célébrer l’art poétique.\nEntrée libre."
        ],
        "es": [
          "Una oportunidad para los amantes de la literatura de compartir la expresión poética (lecturas, canciones, poemas) y celebrar el arte de la poesía.\nEntrada gratuita."
        ],
        "nl": [
          "Dit is een gelegenheid voor literatuurliefhebbers om te delen in poëtische expressie (voordracht, liedjes, gedichten) en de kunst van poëzie te vieren.\nGratis toegang."
        ]
      },
