  "rdfs:comment": {
    "de": [
      "Eine Küche, die aus rohen und lokalen Produkten zubereitet wird und ein hervorragendes Preis-Leistungs-Verhältnis bietet\r\nIm Sommer können wir Sie unter unserer Pergola empfangen."
    ],
    "en": [
      "A cuisine of raw and local products for an excellent quality/price ratio. \r\nWe can welcome you under our pergola in summer."
    ],
    "it": [
      "Una cucina preparata con prodotti crudi e locali per un ottimo rapporto qualità/prezzo\r\nIn estate possiamo accogliervi sotto la nostra pergola."
    ],
    "fr": [
      "Une cuisine préparée à partir de produits bruts et locaux pour un excellent rapport qualité/prix. \r\nNous pouvons vous accueillir sous notre pergola en période estivale."
    ],
    "es": [
      "Una cocina elaborada con productos crudos y locales para una excelente relación calidad/precio\r\nDurante el verano, podemos acogerle bajo nuestra pérgola."
    ],
    "nl": [
      "Een keuken bereid met rauwe en lokale producten voor een uitstekende prijs/kwaliteitsverhouding\r\nWij kunnen u in de zomer onder onze pergola ontvangen."
    ]
  },
