  "rdfs:comment": {
    "de": [
      "Das Hotel liegt am Balkon mit seiner Südterrasse gegenüber der großen Moucherolle bietet Ihnen einen schönen Rahmen.\r\nideal, um eine angenehme Zeit zu verbringen. \r\nDas Kop1 ist ein Restaurant / eine Weinstube mit einer freundlichen, lateinamerikanischen Atmosphäre."
    ],
    "en": [
      "Situated on the balcony with its south-facing terrace facing the Grande Moucherolle, this is the ideal place to spend a pleasant moment.\r\nto spend a pleasant moment. \r\nLes kop1 is a restaurant and wine bar with a friendly Latino atmosphere."
    ],
    "it": [
      "Situato sul Balcon, con la sua terrazza esposta a sud e affacciata sulla Grande Moucherolle, offre l'ambiente ideale per trascorrere momenti indimenticabili.\r\nLes kop1 è un ristorante e wine bar dall'atmosfera amichevole e latina."
    ],
    "fr": [
      "Situé au Balcon avec sa terrasse orientée plein sud face à la Grande Moucherolle, nous vous offrons un cadre idéal pour passer un moment agréable. \r\nLes kop1 est un restaurant et un bar à vins dans une ambiance latino conviviale."
    ],
    "es": [
      "Situado en el Balcón, con su terraza orientada al sur frente a la Grande Moucherolle, ofrecemos el marco ideal para pasarlo en grande.\r\nLes kop1 es un restaurante y bar de vinos con un agradable ambiente latino."
    ],
    "nl": [
      "Gelegen op het Balcon met een terras op het zuiden met uitzicht op de Grande Moucherolle, bieden wij de ideale omgeving voor een geweldige tijd.\r\nLes kop1 is een restaurant en wijnbar met een vriendelijke Latino sfeer."
    ]
  },
  "rdfs:label": {
