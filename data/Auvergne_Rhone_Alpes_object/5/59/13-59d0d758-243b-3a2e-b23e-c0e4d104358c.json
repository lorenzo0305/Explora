  "rdfs:comment": {
    "de": [
      "Wunderschöner Ort der Geschichte, der im Inventar der historischen Monumente des Departements Haute-Loire eingetragen ist. Private Führung \"Das Schloss und sein Park\" durch den Eigentümer, nur nach Vereinbarung, max. 10 Pers. gleichzeitig."
    ],
    "en": [
      "Magnificent historic site listed in the Inventaire des Monuments Historiques de Haute-Loire. Private guided tour of \"Le château et son parc\" by the owner, by appointment only, max. 10 pers. simultaneously."
    ],
    "it": [
      "Magnifico sito storico classificato come Monumento Storico dell'Alta Loira. Visita guidata privata del castello e del suo parco da parte del proprietario, solo su appuntamento, per un massimo di 10 persone alla volta."
    ],
    "fr": [
      "Magnifique lieu d'histoire inscrit à l'Inventaire des Monuments Historiques de Haute-Loire. Visite privée guidée \"Le château et son parc\" par le propriétaire, uniquement sur rendez vous, max. 10 pers. simultanément."
    ],
    "nl": [
      "Schitterende historische site die is opgenomen op de lijst van historische monumenten in de Haute-Loire. Privérondleiding door de eigenaar door \"Het kasteel en zijn terrein\", alleen op afspraak, max. 10 personen per keer."
    ],
    "es": [
      "Magnífico lugar histórico declarado Monumento Histórico del Alto Loira. Visita guiada privada del castillo y sus jardines por el propietario, con cita previa, máx. 10 personas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Château du Thiolent et son parc "
    ]
  },
