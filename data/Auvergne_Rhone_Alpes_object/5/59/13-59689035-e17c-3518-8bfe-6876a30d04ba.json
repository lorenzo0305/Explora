  "rdfs:comment": {
    "de": [
      "Das Team der Bibliothek von Macot bietet dem Publikum ein breites Spektrum an Lektüre. Ob Erwachsene oder Kinder, für jeden Geschmack ist etwas dabei!"
    ],
    "en": [
      "The team from Macot public library offers a wide range of reading. There is something for everyone - adults and children!"
    ],
    "it": [
      "Il team della biblioteca del Macot offre al pubblico un'ampia gamma di materiale di lettura. Che siate adulti o bambini, ce n'è per tutti i gusti!"
    ],
    "fr": [
      "L'équipe de la bibliothèque de Macot offre au public un large panel de lectures. Que l'on soit adulte ou enfant, il y en a pour tous les goûts !"
    ],
    "nl": [
      "Het bibliotheekteam van Macot biedt het publiek een breed scala aan leesmateriaal. Of u nu een volwassene of een kind bent, er is voor elk wat wils!"
    ],
    "es": [
      "El equipo de la biblioteca de Macot ofrece al público una amplia gama de material de lectura. Ya sea un adulto o un niño, ¡hay algo para todos!"
    ]
  },
