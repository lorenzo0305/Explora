  "rdfs:comment": {
    "de": [
      "Anlässlich des \"Printemps des Poètes\" bieten wir Ihnen eine Auswahl an Gedichten der bekanntesten Autoren (Baudelaire, Verlaine, Rimbaud), die von Richard Angénieux vertont wurden."
    ],
    "en": [
      "To mark the \"Printemps des Poètes\", we invite you to come and listen to a selection of poems by some of the most famous authors (Baudelaire, Verlaine, Rimbaud), set to music by Richard Angénieux."
    ],
    "it": [
      "In occasione del festival \"Printemps des Poètes\", vi invitiamo a venire ad ascoltare una selezione di poesie di alcuni degli autori più famosi (Baudelaire, Verlaine, Rimbaud) musicate da Richard Angénieux."
    ],
    "fr": [
      "À l’occasion du « Printemps des Poètes », nous vous proposons de venir écouter une sélection de poèmes choisis parmi les auteurs les plus célèbres (Baudelaire, Verlaine, Rimbaud) mis en musique par Richard Angénieux."
    ],
    "nl": [
      "Ter gelegenheid van het festival \"Printemps des Poètes\" nodigen we je uit om te komen luisteren naar een selectie gedichten van enkele van de beroemdste auteurs (Baudelaire, Verlaine, Rimbaud) op muziek van Richard Angénieux."
    ],
    "es": [
      "Con motivo del festival \"Printemps des Poètes\", le invitamos a venir a escuchar una selección de poemas de algunos de los autores más famosos (Baudelaire, Verlaine, Rimbaud) musicados por Richard Angénieux."
    ]
  },
  "rdfs:label": {
