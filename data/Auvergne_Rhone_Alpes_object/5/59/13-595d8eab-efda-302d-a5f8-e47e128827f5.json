  "rdfs:comment": {
    "de": [
      "Tauchen Sie im Musée de l'Alambic in Saint-Désirat, im Herzen der Destillerie Jean Gauthier, in die Kunst der Destillation ein. Entdecken Sie die größte Sammlung von Destillierapparaten in Frankreich, faszinierende Geschichten und das Know-how der Bouilleurs de Cru."
    ],
    "en": [
      "The \"Still Museum\" retraces the life of the \"bouilleurs de cru\", or jobbing distillers, at the period when the right to distill was still handed down from generation to generation."
    ],
    "it": [
      "Immergetevi nell'arte della distillazione al Musée de l'Alambic di Saint-Désirat, nel cuore della Distillerie Jean Gauthier. Scoprite la più grande collezione di alambicchi in Francia, storie affascinanti e le abilità dei distillatori."
    ],
    "fr": [
      "Plongez dans l’art de la distillation au Musée de l’Alambic à Saint-Désirat, au cœur de la Distillerie Jean Gauthier. Découvrez la plus grande collection d’alambics de France, des récits fascinants, et le savoir-faire des bouilleurs de cru."
    ],
    "es": [
      "Sumérjase en el arte de la destilación en el Musée de l'Alambic de Saint-Désirat, en el corazón de la Distillerie Jean Gauthier. Descubra la mayor colección de alambiques de Francia, historias fascinantes y las habilidades de los destiladores."
    ],
    "nl": [
      "Dompel jezelf onder in de kunst van het distilleren in het Musée de l'Alambic in Saint-Désirat, in het hart van de Distillerie Jean Gauthier. Ontdek de grootste collectie distilleerketels in Frankrijk, fascinerende verhalen en de vaardigheden van de distilleerders."
    ]
  },
  "rdfs:label": {
    "en": [
      "Still Museum - Jean-Gauthier Distillery"
    ],
    "fr": [
      "Musée de l'Alambic - Distillerie Jean Gauthier"
    ]
  },
