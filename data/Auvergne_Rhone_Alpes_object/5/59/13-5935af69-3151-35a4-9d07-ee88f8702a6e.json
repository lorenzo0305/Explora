  "rdfs:comment": {
    "de": [
      "Die Amicale Pétanque Parodienne organisiert ihr Lotto, das von Marc und Daniel moderiert wird. Wert der Lose 7100,00 ? Es gibt eine Bar sowie Sandwiches und Gebäck."
    ],
    "en": [
      "The Amicale Pétanque Parodienne organizes its Loto hosted by Marc and Daniel. Value of prizes 7100,00 ? A refreshment bar will be open, as well as sandwiches and pastries for sale."
    ],
    "it": [
      "L'Amicale Pétanque Parodienne organizza la sua Loto, condotta da Marc e Daniel. Valore dei premi 7100,00 ? Sarà aperto un punto di ristoro e saranno in vendita panini e pasticcini."
    ],
    "fr": [
      "L’Amicale Pétanque Parodienne organise son Loto animé par Marc et Daniel. Valeur des lots 7100,00 € Une buvette sera ouverte ainsi que la vente de sandwichs et pâtisseries."
    ],
    "es": [
      "La Amicale Pétanque Parodienne organiza su Loto, presentado por Marc y Daniel. Valor de los premios 7100,00 ? Estará abierto un bar de refrescos, así como bocadillos y bollería a la venta."
    ],
    "nl": [
      "De Amicale Pétanque Parodienne organiseert haar Loto onder leiding van Marc en Daniel. Waarde van de prijzen 7100,00 ? Er is een bar met versnaperingen en er zijn broodjes en gebak te koop."
    ]
  },
