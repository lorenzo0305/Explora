  "rdfs:comment": {
    "de": [
      "Die Kirche von Saint-Alyre erhebt sich auf über 1100 m Höhe am Rande des Cézallier-Massivs und seiner Sommerplateaus."
    ],
    "en": [
      "The church of Saint-Alyre stands at an altitude of over 1,100 meters, on the edge of the Cézallier massif and its summer pastures."
    ],
    "it": [
      "La chiesa di Saint-Alyre si trova a oltre 1.100 metri di altitudine, ai margini del massiccio del Cézallier e dei suoi pascoli estivi."
    ],
    "fr": [
      "L'église de Saint-Alyre s'élève à plus de 1 100 mètres d'altitude, au bord du massif du Cézallier et de ses plateaux d'estives."
    ],
    "es": [
      "La iglesia de Saint-Alyre se alza a más de 1.100 metros de altitud, al borde del macizo de Cézallier y sus pastos de verano."
    ],
    "nl": [
      "De kerk van Saint-Alyre ligt op een hoogte van meer dan 1100 meter, aan de rand van het massief van Cézallier en zijn zomerweiden."
    ]
