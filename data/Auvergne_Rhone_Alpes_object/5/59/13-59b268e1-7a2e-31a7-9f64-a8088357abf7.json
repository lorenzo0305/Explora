  "rdfs:comment": {
    "de": [
      "Das Zahir-Quartett wird am Sonntag, den 9. August 2026 um 18 Uhr in der Kirche Saint-Paul in Venas auftreten.\r\n\r\nGuillaume Berceau: Sopransaxophon\r\nEtienne Boussard: Altsaxophon\r\nFlorent Louman: Tenorsaxophon\r\nJoakim Ciesla: Baritonsaxophon"
    ],
    "en": [
      "The Quatuor Zahir will perform at the Église Saint-Paul in Venas, on Sunday August 9, 2026 at 6pm.\r\n\r\nGuillaume Berceau: soprano saxophone\r\nEtienne Boussard: alto saxophone\r\nFlorent Louman: tenor saxophone\r\nJoakim Ciesla: baritone saxophone"
    ],
    "it": [
      "Il Quatuor Zahir si esibirà all'Église Saint-Paul di Venas domenica 9 agosto 2026 alle 18.00.\r\n\r\nGuillaume Berceau: sassofono soprano\r\nEtienne Boussard: sassofono contralto\r\nFlorent Louman: sassofono tenore\r\nJoakim Ciesla: sassofono baritono"
    ],
    "fr": [
      "Le Quatuor Zahir se produira en l'Église Saint-Paul de Venas, le dimanche 9 août 2026 à 18h.\r\n\r\nGuillaume Berceau: saxophone soprano\r\nEtienne Boussard: saxophone alto\r\nFlorent Louman: saxophone ténor\r\nJoakim Ciesla: saxophone baryton"
    ],
    "nl": [
      "Het Quatuor Zahir treedt op in de Église Saint-Paul in Venas op zondag 9 augustus 2026 om 18.00 uur.\r\n\r\nGuillaume Berceau: sopraansaxofoon\r\nEtienne Boussard: altsaxofoon\r\nFlorent Louman: tenorsaxofoon\r\nJoakim Ciesla: baritonsaxofoon"
    ],
    "es": [
      "El Quatuor Zahir actuará en la Église Saint-Paul de Venas el domingo 9 de agosto de 2026 a las 18.00 horas.\r\n\r\nGuillaume Berceau: saxofón soprano\r\nEtienne Boussard: saxofón alto\r\nFlorent Louman: saxofón tenor\r\nJoakim Ciesla: saxofón barítono"
    ]
  },
  "rdfs:label": {
