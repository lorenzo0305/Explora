  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/fb197892-52f0-3bf4-9007-4cb80fc4a872",
      "dc:description": {
        "de": [
          "Jean-Luc Franchi, ein freiberuflicher Krankenpfleger, empfängt Sie in seiner Ganzkörper-Kryotherapiekabine.\nEr ist selbst Traiteur und nutzt die Kryotherapie, um alle Muskelverspannungen loszuwerden."
        ],
        "en": [
          "Nurse Jean-Luc Franchi welcomes you to his full-body cryotherapy cabin.\nA runner himself, he uses cryotherapy to relieve muscular tension."
        ],
        "it": [
          "Jean-Luc Franchi, infermiere privato, vi dà il benvenuto nella sua cabina di crioterapia per tutto il corpo.\nLui stesso è un corridore e usa la crioterapia per alleviare le tensioni muscolari."
        ],
        "fr": [
          "Jean-Luc Franchi, infirmier libéral, vous accueille dans sa cabine de cryothérapie corps entier. \nTraileur lui-même il utilise la cryothérapie pour se débarrasser de toutes les tensions musculaires."
        ],
        "es": [
          "Jean-Luc Franchi, enfermero de consulta privada, le da la bienvenida a su cabina de crioterapia de cuerpo entero.\nCorredor, utiliza la crioterapia para aliviar las tensiones musculares."
        ],
        "nl": [
          "Jean-Luc Franchi, een verpleger uit een privépraktijk, heet je welkom in zijn cryotherapiecabine voor het hele lichaam.\nHij is zelf hardloper en gebruikt cryotherapie om spierspanning te verlichten."
        ]
      },
