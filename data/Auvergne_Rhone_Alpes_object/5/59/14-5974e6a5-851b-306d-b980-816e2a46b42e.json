  "rdfs:comment": {
    "de": [
      "Die Kryotherapie ist nicht mehr nur der Elite der Sportler vorbehalten und jeder kann nun seine Sitzung buchen."
    ],
    "en": [
      "Cryotherapy is no longer reserved for the sporting elite, and everyone can now book a session."
    ],
    "it": [
      "La crioterapia non è più riservata all'élite sportiva: chiunque può prenotare una seduta."
    ],
    "fr": [
      "La cryothérapie n’est plus réservée à l’élite des sportifs et chacun peut désormais réserver sa séance."
    ],
    "es": [
      "La crioterapia ya no está reservada a la élite deportiva, ahora cualquiera puede reservar una sesión."
