  "rdfs:comment": {
    "de": [
      "Die Galerie ist offen für lokale Künstler und junge Künstler, die gerade erst mit der Kunst beginnen.\r\nDie Ausstellung findet jeden Monat mit Künstlern aus der Region statt. Derzeit und bis zum 31. Oktober malt die Malerin Marie Aubert wunderschöne Rosen, Wölfe und abstrakte Gemälde."
    ],
    "en": [
      "Gallery open to local artists and young artists new to art.\r\nmonthly exhibition with artists from the region at the moment and until October 31 a painter Marie Aubert paints magnificent wolf roses and abstract paintings."
    ],
    "it": [
      "Galleria aperta ad artisti locali e a giovani artisti alle prime armi con l'arte.\r\nmostra mensile con artisti della regione al momento e fino al 31 ottobre una pittrice Marie Aubert dipinge bellissime rose di lupo e quadri astratti"
    ],
    "fr": [
      "Galerie ouverte aux artistes locaux et aux jeunes artistes débutant dans l'art.\r\nexpo tous les mois avec des artistes de la region en ce moment et jusqu'au 31 Octobre un peintre Marie Aubert peint les roses magnifiques des loups et des peintures abstraite"
    ],
    "nl": [
      "Galerie open voor lokale kunstenaars en jonge kunstenaars die nieuw zijn in de kunst.\r\nElke maand expositie met kunstenaars uit de regio op dit moment en tot 31 oktober schildert schilderes Marie Aubert de prachtige rozen van de wolven en abstracte schilderijen."
    ],
    "es": [
      "Galería abierta a los artistas locales y a los jóvenes que se inician en el arte.\r\nexposición mensual con artistas de la región en este momento y hasta el 31 de octubre una pintora Marie Aubert pinta hermosas rosas de lobo y cuadros abstractos"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Lez'arts Galerie"
    ]
  },
