  "rdfs:comment": {
    "de": [
      "Die Mediatheken sind offen und für alle zugänglich. Sie stellen der Öffentlichkeit Sammlungen aller Medien zur Verfügung, um sie bei ihrer Suche nach Wissen, Bildung und Freizeit zu unterstützen."
    ],
    "en": [
      "Open and accessible to all, the media libraries provide the public with collections of all kinds to accompany them in their search for knowledge, training and leisure activities."
    ],
    "it": [
      "Aperte e accessibili a tutti, le mediateche mettono a disposizione del pubblico collezioni di tutti i media per accompagnarlo nella sua ricerca di conoscenza, formazione e svago."
    ],
    "fr": [
      "Ouvertes et accessibles à tous, les médiathèques mettent à la disposition du public des collections tout support pour l'accompagner dans sa recherche de connaissance, de formation et de loisirs."
    ],
    "nl": [
      "De mediatheken zijn open en toegankelijk voor iedereen en bieden het publiek collecties in alle media om hen te begeleiden bij hun zoektocht naar kennis, opleiding en ontspanning."
    ],
    "es": [
      "Abiertas y accesibles a todos, las mediatecas ponen a disposición del público colecciones en todos los soportes para acompañarle en su búsqueda de conocimiento, formación y ocio."
    ]
  },
