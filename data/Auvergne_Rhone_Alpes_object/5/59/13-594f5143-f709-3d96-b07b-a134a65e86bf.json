  "rdfs:comment": {
    "de": [
      "Dieser in die erste Kategorie eingestufte Staudamm befindet sich am Lignon du Forez. Sie ist über die \"Route des Barrages\" von Sail sous Couzan aus erreichbar. Hier können Sie Forellen, Karpfen und Rotaugen angeln."
    ],
    "en": [
      "This 1st category dam is located on the Lignon du Forez. Accessible via the \"route des barrages\" from Sail sous Couzan, you can fish for trout, carp, roach..."
    ],
    "it": [
      "Questa diga di 1ª categoria si trova sul Lignon du Forez. Accessibile attraverso la \"route des barrages\" da Sail sous Couzan, vi si possono pescare trote, carpe e lasche..."
    ],
    "fr": [
      "Ce barrage classé en 1ère catégorie est installé sur le Lignon du Forez. Accessible par la \"route des barrages\" depuis Sail sous Couzan, vous y pêcherez des truites, des carpes, gardons..."
    ],
    "es": [
      "Esta presa de 1ª categoría está situada en el Lignon du Forez. Accesible por la \"route des barrages\" desde Sail sous Couzan, podrá pescar truchas, carpas y cucarachas..."
    ],
    "nl": [
      "Deze stuwdam van de 1e categorie ligt aan de Lignon du Forez. Bereikbaar via de \"route des barrages\" vanuit Sail sous Couzan, kun je hier vissen op forel, karper en voorn..."
    ]
  },
