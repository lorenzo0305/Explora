  "rdfs:comment": {
    "de": [
      "Gourmet-Bistro-Menü und Tapas. Zentrale Lage im Herzen des Dorfes. Saisonale Produkte, hausgemachte Produkte und eine warme und lokale Atmosphäre."
    ],
    "en": [
      "Gourmet bistro menu and tapas for lunch and dinner. Central location in the heart of the village. Seasonal products, homemade products and a warm and local atmosphere."
    ],
    "it": [
      "Menu bistrot gourmet e tapas per pranzo e cena. Posizione centrale nel cuore del paese. Prodotti stagionali e fatti in casa e un'atmosfera calda e locale."
    ],
    "fr": [
      "Carte bistrot gourmand et tapas midi et soir. Emplacement central au cœur du village. Produits de saison, confection maison et ambiance locale et chaleureuse."
    ],
    "es": [
      "Menú gourmet de bistró y tapas para el almuerzo y la cena. Ubicación céntrica en el corazón del pueblo. Productos de temporada, caseros y un ambiente cálido y local."
    ],
    "nl": [
      "Gastronomisch bistromenu en tapas voor lunch en diner. Centrale locatie in het hart van het dorp. Seizoensgebonden, huisgemaakte producten en een warme, lokale sfeer."
    ]
  },
