  "rdfs:comment": {
    "de": [
      "Die Kinder entdecken das Leben auf dem Bauernhof, indem sie Miniaturtiere füttern und pflegen: Kaninchen, Schweine, Ziegen, Schafe... Sie machen einen Spaziergang mit der berühmten Ziege Cookie und helfen bei der Fütterung der Maultiere. Ein spielerischer und lehrreicher Moment."
    ],
    "en": [
      "Children discover life on the farm by feeding and caring for miniature animals: rabbits, pigs, goats, sheep... They go for a walk with the famous Cookie goat and help feed the mules. A fun and educational experience."
    ],
    "it": [
      "I bambini scoprono la vita della fattoria nutrendo e curando gli animali in miniatura: conigli, maiali, capre, pecore? Fanno una passeggiata con la famosa capra Cookie e aiutano a nutrire i muli. Un'esperienza divertente ed educativa."
    ],
    "fr": [
      "Les enfants découvrent la vie à la ferme en nourrissant et soignant les animaux miniatures : lapins, cochons, chèvres, brebis… Ils partent en balade avec la célèbre chèvre Cookie et participent au nourrissage des mules. Un moment ludique et éducatif."
    ],
    "es": [
      "Los niños descubren la vida en la granja alimentando y cuidando animales en miniatura: conejos, cerdos, cabras, ovejas? Pasean con la famosa cabra Cookie y ayudan a dar de comer a las mulas. Una experiencia divertida y educativa."
    ],
    "nl": [
      "Kinderen ontdekken het leven op de boerderij door miniatuurdieren te voeren en te verzorgen: konijnen, varkens, geiten, schapen? Ze maken een wandeling met de beroemde koekjesgeit en helpen bij het voeren van de muilezels. Een leuke en leerzame ervaring."
    ]
  },
  "rdfs:label": {
    "de": [
      "Der kleine Bauer - Züchterlehrling"
    ],
    "en": [
      "The little farmer - apprentice breeder"
    ],
    "fr": [
      "Le petit fermier - apprenti éleveur"
    ]
  },
