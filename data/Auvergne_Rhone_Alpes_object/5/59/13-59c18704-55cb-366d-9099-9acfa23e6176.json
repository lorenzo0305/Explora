  "rdfs:comment": {
    "de": [
      "Eröffnung einer neuen Handwerkerboutique: Mycelium.\r\nAuf Initiative von 10 Handwerkerinnen und Handwerkern aus der Region entstand dieses Projekt einer assoziativen und kollektiven Boutique."
    ],
    "en": [
      "Opening of a new artisan boutique: Mycelium\r\nOn the initiative of 10 local craftsmen and women, this project for an associative and collective boutique was born."
    ],
    "it": [
      "Apertura di una nuova boutique artigianale: Mycelium\r\n10 artigiani e donne locali sono alla base di questo progetto di creazione di un negozio comunitario."
    ],
    "fr": [
      "Ouverture d'une nouvelle boutique dˋartisans : Mycelium \r\nC’est à l’initiative de 10 artisans et artisanes de la région, que ce projet de boutique associative et collective a vu le jour."
    ],
    "nl": [
      "Opening van een nieuwe ambachtelijke winkel: Mycelium\r\n10 lokale ambachtslieden hebben het initiatief genomen om deze collectieve winkel op te zetten."
    ],
