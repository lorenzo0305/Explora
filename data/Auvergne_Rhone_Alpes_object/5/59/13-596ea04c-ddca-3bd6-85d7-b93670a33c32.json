  "rdfs:comment": {
    "de": [
      "Coralie und Maxime bieten Ihnen eine hausgemachte traditionelle und lokale Küche an.\r\nEs gibt mehrere Angebote: Burger, Tagesgericht, Entdeckermenü, Expressformel usw."
    ],
    "en": [
      "Coralie and Maxime offer traditional, local, homemade cuisine.\r\nThere's a choice of burgers, daily specials, discovery menus, express menus and more."
    ],
    "it": [
      "Coralie e Maxime propongono una cucina tradizionale, locale e casalinga.\r\nSi può scegliere tra hamburger, specialità del giorno, menu di scoperta, menu espressi e altro ancora."
    ],
    "fr": [
      "Coralie et Maxime vous proposent une cuisine traditionnelle et locale faite maison.\r\nPlusieurs offres sont disponibles : burgers,  plat du jour, menu découverte, formule express, etc."
    ],
    "es": [
      "Coralie y Maxime proponen una cocina tradicional, local y casera.\r\nHamburguesas, platos del día, menús descubrimiento, menús exprés, etc."
    ],
    "nl": [
      "Coralie en Maxime bieden traditionele, lokale, huisgemaakte gerechten.\r\nEr is keuze uit hamburgers, dagschotels, ontdekkingsmenu's, express menu's en nog veel meer."
    ]
  },
