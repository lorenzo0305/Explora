  "rdfs:comment": {
    "de": [
      "Das Hotel l'Aigle liegt in Valmeinier 1800, gegenüber den Skipisten und Skiliften. Es verfügt über einen Außenwhirlpool, eine Sonnenterrasse, eine Sauna und ein Hammam."
    ],
    "en": [
      "English owner ! \r\n\r\nLocated in Valmeinier 1800, in front of the ski slopes and ski lifts, Hotel l'Aigle features an outdoor hot tub, a sun terrace, a sauna and a steam room."
    ],
    "it": [
      "Situato a Valmeinier 1800, di fronte alle piste e agli impianti di risalita, l'Hotel l'Aigle offre una vasca idromassaggio all'aperto, una terrazza solarium, una sauna e un hammam."
    ],
    "fr": [
      "Situé à Valmeinier 1800, en face des pistes de ski et des remontées mécaniques, l'Hotel l'Aigle dispose d'un jacuzzi extérieur, d'une terrasse bien exposée, d'un sauna et d'un hammam."
    ],
    "es": [
      "Situado en Valmeinier 1800, frente a las pistas de esquí y los remontes, el Hotel l'Aigle cuenta con jacuzzi al aire libre, solárium, sauna y hammam."
    ],
    "nl": [
      "Hotel l'Aigle ligt in Valmeinier 1800, tegenover de skipistes en skiliften, en beschikt over een hot tub, een zonneterras, een sauna en een stoomcabine."
    ]
  },
