  "rdfs:comment": {
    "de": [
      "Entdecken Sie den Lebensmittelladen der Auberge de Planzolles, die im Herzen der Cevennen der Ardèche liegt und eine Auswahl an lokalen und handwerklichen Produkten anbietet, um Ihren Gaumen zu verwöhnen."
    ],
    "en": [
      "Discover the grocery store of Auberge de Planzolles, nestled in the heart of the Ardèche Cévennes, offering a selection of local and artisanal products to delight your taste buds."
    ],
    "it": [
      "Scoprite il negozio di alimentari dell'Auberge de Planzolles, immerso nel cuore delle Cévennes ardéchoises, che offre una selezione di prodotti locali e artigianali per deliziare il vostro palato."
    ],
    "fr": [
      "Découvrez l’épicerie de l’Auberge de Planzolles, nichée au cœur des Cévennes ardéchoises, offrant une sélection de produits locaux et artisanaux pour ravir vos papilles."
    ],
    "nl": [
      "Ontdek de kruidenierswinkel van de Auberge de Planzolles, genesteld in het hart van de Cevennen ardéchoises, met een selectie lokale en ambachtelijke producten om je smaakpapillen te verwennen."
    ],
    "es": [
      "Descubra la tienda de comestibles del Auberge de Planzolles, enclavado en el corazón de las Cévennes ardéchoises, que ofrece una selección de productos locales y artesanales para deleitar su paladar."
    ]
  },
