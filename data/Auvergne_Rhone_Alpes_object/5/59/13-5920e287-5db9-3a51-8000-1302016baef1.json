  "rdfs:comment": {
    "de": [
      "Besuchen Sie die Kirche auf eigene Faust. Die ursprüngliche Kirche befand sich in Puy-Rogier; sie wurde im 15. Jahrhundert im Zentrum des Dorfes wiederaufgebaut. Seitdem wurde sie zahlreichen Umbauten unterzogen."
    ],
    "en": [
      "Free visit. The primitive church was located in Puy-Rogier; it was rebuilt in the center of the village in the 15th century. Since then, it has undergone many transformations."
    ],
    "it": [
      "Visita gratuita. La chiesa originaria si trovava a Puy-Rogier; fu ricostruita nel centro del villaggio nel XV secolo. Da allora ha subito molte trasformazioni."
    ],
    "fr": [
      "Visite libre. L'église primitive se trouvait à Puy-Rogier ; elle a été reconstruite au centre du village au XVe siècle. Depuis, elle a subi de nombreuses transformations."
    ],
    "es": [
      "Visita gratuita. La iglesia original se encontraba en Puy-Rogier; fue reconstruida en el centro del pueblo en el siglo XV. Desde entonces, ha sufrido numerosas transformaciones."
    ],
    "nl": [
      "Gratis bezoek. De oorspronkelijke kerk stond in Puy-Rogier; zij werd in de 15e eeuw herbouwd in het centrum van het dorp. Sindsdien heeft het talrijke transformaties ondergaan."
    ]
  },
  "rdfs:label": {
    "en": [
      "Church of Saint-Voir and Saint-Sever"
    ],
    "fr": [
      "Église Saint-Voir et Saint-Sever"
    ]
  },
