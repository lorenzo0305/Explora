      "rdfs:comment": {
        "de": [
          "Das Rezept für den Mont des Cats-Käse stammt aus der Abtei Port du Salut in der Mayenne. Er wird seit 1890 von Mönchen in Flandern in einer Abtei in der Nähe von Godewaersvelde (der Ebene Gottes) hergestellt."
        ],
        "en": [
          "The recipe for Mont des Cats cheese comes from the Abbaye de Port du Salut in Mayenne. It has been made by monks in Flanders in an abbey near Godewaersvelde (the Plain of God) since 1890."
        ],
        "it": [
          "La ricetta del formaggio Mont des Cats proviene dall'Abbaye de Port du Salut di Mayenne. Dal 1890 viene prodotto dai monaci delle Fiandre in un'abbazia vicino a Godewaersvelde (la Piana di Dio)."
        ],
        "fr": [
          "La recette du fromage du Mont des Cats provient de l'Abbaye de Port du Salut dans la Mayenne. Il est fabriqué par des moines en Flandres dans une abbaye située près de Godewaersvelde (la plaine de Dieu) depuis 1890."
        ],
        "es": [
          "La receta del queso Mont des Cats procede de la Abbaye de Port du Salut, en Mayenne. Los monjes de Flandes lo elaboran en una abadía cerca de Godewaersvelde (la Llanura de Dios) desde 1890."
        ],
        "nl": [
          "Het recept voor Mont des Cats kaas komt van de Abbaye de Port du Salut in Mayenne. Het wordt sinds 1890 gemaakt door monniken in Vlaanderen in een abdij in de buurt van Godewaersvelde (de Vlakte van God)."
        ]
      },
