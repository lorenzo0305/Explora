  "rdfs:comment": {
    "de": [
      "Le Labo, das sind 600 m², die ausschließlich dem Bouldern gewidmet sind, Routen, die für Anfänger und Fortgeschrittene konzipiert sind, und täglich neue Boulder, die kreiert werden."
    ],
    "en": [
      "With 600 square feet of climbing area, new boulders created every day, Le Labo is the place to be!"
    ],
    "it": [
      "Il Labo è un'area di 600 m² dedicata esclusivamente al bouldering, con circuiti pensati sia per i principianti che per gli esperti, e nuovi boulder creati ogni giorno."
    ],
    "fr": [
      "Le Labo, c'est 600m² uniquement dédiés à la pratique du bloc, des circuits pensés pour les débutants et les experts, de nouveaux blocs créés chaque jour."
    ],
    "nl": [
      "Het Labo is 600m² exclusief gewijd aan boulderen, met circuits voor zowel beginners als gevorderden en elke dag nieuwe boulders."
    ],
    "es": [
      "El Labo cuenta con 600 m² dedicados exclusivamente al búlder, con circuitos diseñados tanto para principiantes como para expertos, y nuevos búlderes creados cada día."
