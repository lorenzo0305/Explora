  "rdfs:comment": {
    "de": [
      "Familienhotel mit Charakter, das einen aufmerksamen und persönlichen Empfang in einer sportlichen und internationalen Atmosphäre bietet. Das Hotel liegt im Herzen des Dorfes Argentière, in unmittelbarer Nähe der Pisten von Grands Montets und am Anfang der Wanderwege."
    ],
    "en": [
      "Family hotel with character offering an attentive and personalized welcome in a sporting and international atmosphere. Located in the heart of the village of Argentière, close to the Grands Montets ski slopes and at the start of the hiking trails."
    ],
    "it": [
      "Un hotel familiare di carattere, che offre un'accoglienza attenta e personalizzata in un'atmosfera sportiva e internazionale. Situato nel cuore del villaggio di Argentière, vicino alle piste da sci dei Grands Montets e all'inizio dei sentieri escursionistici."
    ],
    "fr": [
      "Idéalement situé à Argentière, La Couronne, fondé en 1865 et rénové en 2024, allie charme familial et confort 3 é. Avec 69 chambres, spa, restaurant bistronomique et vue sur le Mont-Blanc, il séduit skieurs, randonneurs et amoureux de la montagne."
    ],
    "es": [
      "Un hotel familiar con carácter, que ofrece una acogida atenta y personalizada en un ambiente deportivo e internacional. Situado en el corazón del pueblo de Argentière, cerca de las pistas de esquí de Grands Montets y al inicio de las rutas de senderismo."
    ],
    "nl": [
      "La Couronne, ideaal gelegen in Argentière, werd opgericht in 1865 en gerenoveerd in 2024. Het combineert familiale charme met 3-sterrencomfort. Met 69 kamers, een spa, een bistronomisch restaurant en uitzicht op de Mont Blanc zal het zowel skiërs als wandelaars en bergliefhebbers aanspreken."
    ]
  },
