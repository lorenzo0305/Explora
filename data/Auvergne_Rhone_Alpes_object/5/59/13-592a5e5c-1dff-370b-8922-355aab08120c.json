  "rdfs:comment": {
    "de": [
      "Les Sens'Ciel empfängt Sie von Montag bis Freitag in seinem Bar-Restaurant, Tabakladen und Zeitungsladen. Jeden Tag wird Ihnen eine abwechslungsreiche Familienküche angeboten. An schönen Tagen können Sie auf der gemütlichen Terrasse essen oder ein Getränk genießen."
    ],
    "en": [
      "Les Sens'Ciel welcomes you Monday to Friday to its bar-restaurant, tabac-presse. Every day, you'll be served a varied, home-style menu. In fine weather, enjoy a meal or a drink on the pleasant terrace."
    ],
    "it": [
      "Les Sens'Ciel vi accoglie dal lunedì al venerdì nel suo bar-ristorante, tabaccheria ed edicola. Ogni giorno potrete gustare un'ampia gamma di piatti casalinghi. Nelle giornate di sole, potrete gustare un pasto o un drink sulla piacevole terrazza."
    ],
    "fr": [
      "Les Sens'Ciel vous accueille du lundi au vendredi dans son bar-restaurant, tabac-presse. Tous les jours, une cuisine familiale et variée vous est proposée. Aux beaux jours, profitez de l'agréable terrasse pour manger ou prendre un verre."
    ],
    "nl": [
      "Les Sens'Ciel verwelkomt je van maandag tot vrijdag in zijn bar-restaurant, tabakswinkel en krantenwinkel. Elke dag kun je genieten van een breed scala aan huisgemaakte gerechten. Op zonnige dagen kun je genieten van een maaltijd of een drankje op het aangename terras."
    ],
    "es": [
      "Les Sens'Ciel le recibe de lunes a viernes en su bar-restaurante, estanco y quiosco de prensa. Todos los días podrá degustar una amplia gama de platos caseros. En los días soleados, podrá disfrutar de una comida o una copa en la agradable terraza."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Sens'Ciel"
    ]
  },
