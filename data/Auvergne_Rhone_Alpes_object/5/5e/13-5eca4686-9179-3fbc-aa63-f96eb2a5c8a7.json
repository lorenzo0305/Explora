  "rdfs:comment": {
    "de": [
      "Als Kunstgalerie und Dekorationsgeschäft zugleich finden Sie hier nur Einzelstücke oder sehr kleine Serien... Möbel, Spiegel, Bilder, Fotografie, Skulpturen, Leuchten, zweckentfremdete Gegenstände, Dekorationsobjekte..."
    ],
    "en": [
      "Enamelled lava atelier, unique pieces, furniture, interior and exterior decorative pieces, art de la table… Gratuated from IMAPEC, Volvic."
    ],
    "it": [
      "Sia una galleria d'arte che un negozio di decorazioni, troverete solo pezzi unici o serie molto piccole... mobili, specchi, dipinti, fotografie, sculture, illuminazione, oggetti deviati, oggetti decorativi..."
    ],
    "fr": [
      "À la fois galerie d'art et boutique de décoration, vous n'y trouverez que des pièces uniques ou en très petite série... mobilier, miroirs, tableaux, photographie, sculptures, luminaires, objets détournés, objets décoratifs..."
    ],
    "nl": [
      "Zowel een kunstgalerie als een decoratiewinkel, u vindt er enkel unieke stukken of zeer kleine series... meubels, spiegels, schilderijen, fotografie, beeldhouwwerken, verlichting, afgeleide voorwerpen, decoratieve objecten..."
    ],
    "es": [
      "Tanto una galería de arte como una tienda de decoración, sólo encontrarás piezas únicas o series muy pequeñas... muebles, espejos, cuadros, fotografía, esculturas, iluminación, objetos divertidos, objetos decorativos..."
    ]
  },
  "rdfs:label": {
    "en": [
