  "rdfs:comment": {
    "de": [
      "Ein Überblick über die seltsame Wissenschaft der Glaziologie: verkannt und doch im Zentrum der Umweltherausforderungen!\r\n\r\nÖffnen Sie die Tür von Glacialis und tauchen Sie ein in das Herz der Alpengletscher!"
    ],
    "en": [
      "An overview of the strange science of glaciology: little-known, yet at the heart of environmental issues!\r\n\r\nPush open the door of Glacialis and plunge into the heart of Alpine glaciers!"
    ],
    "it": [
      "Una panoramica sull'affascinante scienza della glaciologia: poco conosciuta eppure al centro delle questioni ambientali!\r\n\r\nAprite la porta di Glacialis e immergetevi nel cuore dei ghiacciai alpini!"
    ],
    "fr": [
      "Tour d'horizon sur cette drôle de science qu'est la glaciologie : méconnue et pourtant au cœur des enjeux environnementaux !\r\n\r\nPoussez la porte de Glacialis pour plonger au cœur des glaciers alpins !"
    ],
    "es": [
      "Una visión general de la fascinante ciencia de la glaciología: ¡poco conocida pero en el centro de las cuestiones medioambientales!\r\n\r\nAbra la puerta de Glacialis y sumérjase en el corazón de los glaciares alpinos"
    ],
    "nl": [
      "Een overzicht van de fascinerende wetenschap van de gletsjerkunde: weinig bekend maar toch de kern van milieukwesties!\r\n\r\nOpen de deur van Glacialis en duik in het hart van de Alpengletsjers!"
    ]
  },
  "rdfs:label": {
    "de": [
      "Espace Glacialis - Zentrum zur Interpretation von Gletschern"
    ],
    "en": [
      "Espace Glacialis - The Glacier Museum"
    ],
    "fr": [
      "Espace Glacialis - Centre d'interprétation des glaciers"
    ],
    "nl": [
      "Espace Glacialis - Het Gletsjermuseum"
    ]
  },
