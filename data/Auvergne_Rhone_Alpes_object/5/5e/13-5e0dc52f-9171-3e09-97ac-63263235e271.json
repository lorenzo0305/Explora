  "rdfs:comment": {
    "de": [
      "Vom Parkplatz des Panoramic gehen Sie weiter auf der D68 in Richtung Ceyssat. Fahren Sie über den Col de Ceyssat, die Landung ist rechts am Straßenrand, 1 km nach dem Pass."
    ],
    "en": [
      "From the Panoramique parking lot, continue on the D68 towards Ceyssat, pass the Col de Ceyssat, the landing is on the right at the roadside 1km after the pass."
    ],
    "it": [
      "Dal parcheggio Panoramique, proseguire sulla D68 in direzione Ceyssat, superare il Col de Ceyssat e l'atterraggio si trova sulla destra a lato della strada 1 km dopo il passo."
    ],
    "fr": [
      "Du parking du Panoramique, continuer sur la D68 en direction de Ceyssat, passer le col de Ceyssat l'atterrissage est à droite au bord de la route à 1km après le col."
    ],
    "nl": [
      "Vanaf de Panoramique-parkeerplaats volgt u de D68 richting Ceyssat, passeert u de Col de Ceyssat en de aanlegsteiger bevindt zich 1 km na de pas aan de rechterkant van de weg."
    ],
    "es": [
      "Desde el aparcamiento Panoramique, continúe por la D68 en dirección a Ceyssat, pase el Col de Ceyssat y el rellano se encuentra a la derecha al lado de la carretera 1 km después del paso."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Terrain de pratique de parapente - Le Puy de Dôme"
    ]
  },
