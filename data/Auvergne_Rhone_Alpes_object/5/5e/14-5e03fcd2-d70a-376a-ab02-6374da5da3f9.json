  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/b8d9ade8-ffd8-335f-9072-26399fb5a9e3",
      "dc:description": {
        "de": [
          "Ein ausschließlich französischsprachiges Repertoire: Inmitten der Klassiker von Barbara, Brel, Gainsbourg und Nougaro hoffen Manon Roisin (Gesang) und Frédéric Volanti (Klavier), Sie dazu zu bringen, weniger bekannte Stücke (wieder) zu entdecken, die nicht alle von gestern sind, sondern die das französische Chanson von heute ausmachen und noch ausmachen."
        ],
        "en": [
          "An exclusively French-language repertoire: amidst classics by Barbara, Brel, Gainsbourg and Nougaro, Manon Roisin (vocals) and Frédéric Volanti (piano) hope to help you (re)discover lesser-known songs, not all of which date from yesterday, but which have made and are still making French chanson today."
        ],
        "it": [
          "Un repertorio tutto francese: tra i classici di Barbara, Brel, Gainsbourg e Nougaro, Manon Roisin (voce) e Frédéric Volanti (pianoforte) sperano di farvi (ri)scoprire canzoni meno conosciute, non tutte di ieri, ma che hanno fatto e fanno ancora oggi la chanson francese."
        ],
        "fr": [
          "Un répertoire exclusivement francophone : au milieu des classiques de Barbara, Brel, Gainsbourg, Nougaro, Manon Roisin (chant) et Frédéric Volanti (Piano) espèrent vous faire (re)découvrir des morceaux moins connus qui ne datent pas tous d’hier mais qui ont fait et font encore la chanson française d’aujourd’hui."
        ],
        "es": [
          "Un repertorio totalmente francés: entre clásicos de Barbara, Brel, Gainsbourg y Nougaro, Manon Roisin (voz) y Frédéric Volanti (piano) esperan hacerle (re)descubrir canciones menos conocidas, no todas de ayer, pero que han hecho y siguen haciendo la chanson francesa de hoy."
        ],
        "nl": [
          "Een volledig Frans repertoire: te midden van klassiekers van Barbara, Brel, Gainsbourg en Nougaro hopen Manon Roisin (zang) en Frédéric Volanti (piano) je minder bekende liedjes te laten (her)ontdekken, die niet allemaal van gisteren dateren, maar die het Franse chanson hebben gemaakt en vandaag de dag nog steeds maken."
        ]
      },
