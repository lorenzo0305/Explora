  "rdfs:comment": {
    "de": [
      "Erkunden Sie das Dorf Saint-Chef durch ein spielerisches Eintauchen mit der ganzen Familie! Nehmen Sie die Herausforderung an und beantworten Sie die Fragen, die auf der ganzen Strecke verteilt sind! 12 Markierungen müssen gefunden werden."
    ],
    "en": [
      "Explore the village of Saint-Chef as a family! Take up the challenge by answering the questions along the way! There are 12 markers to find."
    ],
    "it": [
      "Esplorate il villaggio di Saint-Chef in famiglia! Raccogliete la sfida rispondendo alle domande che troverete lungo il percorso! ci sono 12 indicatori da trovare."
    ],
    "fr": [
      "Explorez le village de Saint-Chef à travers une immersion ludique en famille ! Relevez le défi en répondant aux questions disséminées tout au long du parcours ! 12 balises sont à retrouver."
    ],
    "nl": [
      "Verken het dorp Saint-Chef met het hele gezin! Ga de uitdaging aan door onderweg de vragen te beantwoorden! er zijn 12 markers te vinden."
    ],
    "es": [
      "Explora el pueblo de Saint-Chef en familia Acepta el reto respondiendo a las preguntas del camino hay 12 marcadores que encontrar."
    ]
  },
  "rdfs:label": {
