  "rdfs:comment": {
    "de": [
      "Ein totales Spektakel an der Schnittstelle von Theater, Tanz, Gesang und Pantomime.\r\nMit Climax nutzt die Compagnie Zygomatic den Humor als massive Reflexionswaffe im Dienste eines brennenden Themas: der Klimazerstörung."
    ],
    "en": [
      "A total show at the crossroads of theater, dance, song and mime.\r\nWith Climax, Compagnie Zygomatic uses humor as a weapon of massive reflection on a burning issue: climate change."
    ],
    "it": [
      "Uno spettacolo totale all'incrocio tra teatro, danza, canto e mimo.\r\nCon Climax, la Compagnie Zygomatic utilizza l'umorismo come arma di riflessione di massa su un tema scottante: il cambiamento climatico."
    ],
    "fr": [
      "Spectacle total à l'intersection du théâtre, de la danse, du chant et du mime. \r\nAvec Climax, la Compagnie Zygomatic utilise l'humour comme une arme de réflexion massive au service d'un sujet brûlant : le dérèglement climatique."
    ],
    "es": [
      "Un espectáculo total a caballo entre el teatro, la danza, el canto y el mimo.\r\nCon Climax, la Compagnie Zygomatic utiliza el humor como arma de reflexión masiva sobre un tema candente: el cambio climático."
    ],
    "nl": [
      "Een totaalspektakel op het kruispunt van theater, dans, zang en mime.\r\nMet Climax gebruikt Compagnie Zygomatic humor als wapen om massaal na te denken over een brandende kwestie: klimaatverandering."
    ]
  },
  "rdfs:label": {
    "fr": [
      "CLIMAX (Quand le rire décarbonne)"
    ]
  },
