  "rdfs:comment": {
    "de": [
      "Entdecken Sie eine Familien- und Marktküche, bereiten Sie traditionelle Gerichte aus der Region zu, die hausgemacht sind und aus lokalen und saisonalen Produkten hergestellt werden."
    ],
    "en": [
      "Come and discover home-cooked cuisine made using products from the market, traditional regional dishes, all homemade using local and seasonal products."
    ],
    "it": [
      "Venite a scoprire la cucina familiare e di mercato, che prepara piatti della tradizione regionale, fatti in casa con prodotti locali e di stagione."
    ],
    "fr": [
      "Venez découvrir une cuisine de famille et du marché, préparation des plats de tradition régionale, faits maison, réalisés à partir de produits locaux et de saison."
    ],
    "es": [
      "Venga a descubrir la cocina familiar y de mercado, elaborando platos tradicionales de la región, hechos en casa con productos locales y de temporada."
    ],
    "nl": [
      "Kom en ontdek de familie- en marktkeuken, die traditionele regionale gerechten bereidt, zelfgemaakt met lokale en seizoensgebonden producten."
    ]
  },
