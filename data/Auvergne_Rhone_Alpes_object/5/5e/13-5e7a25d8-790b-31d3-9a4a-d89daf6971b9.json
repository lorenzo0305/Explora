  "rdfs:comment": {
    "de": [
      "Weine aus Saint-Pourçain und dem Val-de-Loire. Der Winzer Fabien Malavaud entschied sich bei der Übernahme des Weinguts für die Umstellung auf biologischen Anbau, um die Erträge zu kontrollieren und die Qualität seiner Weine zu optimieren."
    ],
    "en": [
      "Wines from Saint-Pourçain and the Val-de-Loire. When Fabien Malavaud took over the estate, he decided to convert to organic farming, with the aim of controlling yields to optimize the quality of his wines."
    ],
    "it": [
      "Vini di Saint-Pourçain e della Val-de-Loire. Quando Fabien Malavaud ha rilevato la tenuta, ha deciso di convertirsi all'agricoltura biologica, con l'obiettivo di controllare le rese per ottimizzare la qualità dei suoi vini."
    ],
    "fr": [
      "Vins de Saint-Pourçain et du Val-de-Loire. Le vigneron, Fabien Malavaud, a fait le choix dès la reprise du domaine de le convertir vers l’agriculture biologique avec la volonté de maîtriser les rendements afin d’optimiser la qualité de ses vins."
    ],
    "nl": [
      "Wijnen uit Saint-Pourçain en de Val-de-Loire. Toen Fabien Malavaud het landgoed overnam, besloot hij over te schakelen op biologische landbouw, met als doel de opbrengsten te beheersen om de kwaliteit van zijn wijnen te optimaliseren."
    ],
    "es": [
      "Vinos de Saint-Pourçain y del Val-de-Loire. Cuando Fabien Malavaud se hizo cargo de la propiedad, decidió convertirse a la agricultura ecológica, con el objetivo de controlar los rendimientos para optimizar la calidad de sus vinos."
    ]
  },
  "rdfs:label": {
