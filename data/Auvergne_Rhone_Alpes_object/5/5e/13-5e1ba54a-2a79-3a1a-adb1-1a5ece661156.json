  "rdfs:comment": {
    "de": [
      "Testen Sie die zur Verfügung stehenden Headsets und erleben Sie eine immersive 3D-Erfahrung: Reisen Sie ans Ende der Welt, erforschen Sie den Weltraum, entfliehen Sie in wunderbaren Spielen und erschaffen Sie Ihre eigenen Kunstwerke. Ein einzigartiger Spaziergang, den Sie unbedingt ausprobieren sollten. Ab 13 Jahren."
    ],
    "en": [
      "Try out the helmets available and enjoy an immersive 3D experience: travel to the ends of the earth, explore space, escape into marvellous games, create your own works of art. It's a unique experience you've got to try out. Ages 13 and up."
    ],
    "it": [
      "Provate le cuffie in offerta e godetevi un'esperienza 3D immersiva: viaggiate fino ai confini del mondo, esplorate lo spazio, evadete in giochi meravigliosi e create le vostre opere d'arte. È un'esperienza unica, assolutamente da provare. Dai 13 anni in su."
    ],
    "fr": [
      "Testez les casques à disposition et vivez une expérience immersive en 3D : voyagez au bout de la terre, explorez l’espace, évadez vous dans des jeux merveilleux, créez vos propres œuvres d'art. Une balade unique à tester absolument. Dès 13 ans."
    ],
    "es": [
      "Pruebe los auriculares que le ofrecemos y disfrute de una experiencia 3D envolvente: viaje a los confines de la tierra, explore el espacio, escápese a juegos maravillosos y cree sus propias obras de arte. Es una experiencia única que no puedes dejar de probar. A partir de 13 años."
    ],
    "nl": [
      "Probeer de aangeboden headsets uit en geniet van een meeslepende 3D-ervaring: reis naar de uiteinden van de aarde, verken de ruimte, ontsnap in prachtige games en maak je eigen kunstwerken. Het is een unieke ervaring die je gewoon moet proberen. Vanaf 13 jaar."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Atelier Réalité Virtuelle"
    ]
  },
