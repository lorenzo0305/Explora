  "rdfs:comment": {
    "de": [
      "Familienbauernhof mit Gemüseanbau und Obstplantagen, um Ihnen das ganze Jahr über Obst und Gemüse der Saison anzubieten."
    ],
    "en": [
      "Family farm with market gardening and orchards.\r\nWe produce peaches, apricots, pears, strawberries and many other vegetables.\r\nWe also offer fruit juices!"
    ],
    "it": [
      "Azienda agricola a conduzione familiare con orti e frutteti che offrono frutta e verdura di stagione tutto l'anno."
    ],
    "fr": [
      "Ferme familiale en maraichage et vergers pour vous proposer des fruits et légumes de saison tout au long de l'année."
    ],
    "es": [
      "Granja familiar con huertos y frutales que ofrecen frutas y verduras de temporada durante todo el año."
    ],
    "nl": [
