  "rdfs:comment": {
    "de": [
      "Erleben Sie die Authentizität eines 4-Sterne-Hotel-Chalets im Herzen des Arvetals.\nZwischen verschneiten Gipfeln und sonnenverwöhnten Landschaften heißt unser Hotel Sie das ganze Jahr über willkommen. Ein ideales Ziel, um neue Energie im Rhythmus der Berge zu tanken."
    ],
    "en": [
      "Experience the authenticity of a 4-star chalet hotel in the heart of the Arve Valley.\nBetween snow-capped peaks and sun-drenched landscapes, our hotel welcomes you all year round. An ideal destination to recharge to the rhythm of the mountains."
    ],
    "it": [
      "Vivi l’autenticità di un hotel-chalet a 4 stelle nel cuore della valle dell’Arve.\nTra vette innevate e paesaggi baciati dal sole, il nostro hotel ti accoglie tutto l’anno. Una destinazione ideale per rigenerarsi al ritmo delle montagne."
    ],
    "fr": [
      "Vivez l’authenticité d’un hôtel-chalet 4 étoiles au cœur de la vallée de l’Arve.\nEntre sommets enneigés et paysages baignés de soleil, notre hôtel vous accueille tout au long de l'année. Une destination idéale pour se ressourcer au rythme des montagnes."
    ],
    "es": [
      "Experimente la autenticidad de un hotel chalet de 4 estrellas en el corazón del valle del Arve.\nEntre cumbres nevadas y paisajes bañados por el sol, nuestro hotel le da la bienvenida todo el año. Un destino ideal para recargar las pilas al ritmo de las montañas."
    ],
    "nl": [
      "Ervaar de authenticiteit van een 4-sterren chalet-hotel in het hart van de Arvevallei.\nTussen besneeuwde toppen en zonovergoten landschappen verwelkomt ons hotel u het hele jaar door. Een ideale bestemming om op te laden op het ritme van de bergen."
    ]
  },
