  "rdfs:comment": {
    "de": [
      "Saint-Gervais hat eine Eisbahn für alle zugänglich.\r\nIhre Kinder auf ihren ersten Schritten auf dem Eis begleiten Sie auf Anfrage Pinguine oder Stuhl Führung verwenden können, um ihnen zu helfen."
    ],
    "en": [
      "Saint-Gervais boasts an indoor ice-rink accessible to all. \r\nAccompany your children for their first time on the ice and request \r\nthe use of a fun material to help them find their balance. \r\nA sled for the disabled is also available."
    ],
    "it": [
      "Saint-Gervais dispone di un palaghiaccio coperto accessibile a tutti. Per \r\naccompagnare i vostri bambini durante le loro prime scivolate sul ghiaccio \r\nsono a disposizione su richiesta degli appositi “pinguini” o sedie con lame. \r\nLa pista di pattinaggio dispone inoltre di uno slittino per le persone con \r\nmobilità ridotta."
    ],
    "fr": [
      "Saint-Gervais dispose d'une patinoire couverte accessible à tous.\r\nPour accompagner vos enfants lors de leurs premiers pas sur la glace, vous pourrez utiliser sur demande du matériel ludique pour les aider."
    ],
    "nl": [
      "Saint-Gervais heeft een overdekte ijsbaan die voor iedereen toegankelijk is.\r\nOm je kinderen te helpen hun eerste stapjes op het ijs te zetten, kun je op verzoek gebruikmaken van speeltoestellen."
    ],
    "es": [
      "Saint-Gervais dispone de una pista de hielo cubierta abierta a todos.\r\nPara ayudar a sus hijos a dar sus primeros pasos sobre el hielo, puede utilizar material lúdico previa petición."
    ]
  },
