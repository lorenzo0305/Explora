  "rdfs:comment": {
    "de": [
      "Zwei Stunden für eine kreative Aktivität mit Ihrem Kind: eine kleine Schüssel, Vase oder Tasse, die Sie mit einfachen Techniken verzieren können: Stempel, bunte Engoben mit Schwamm oder Pinsel."
    ],
    "en": [
      "Two hours for a creative activity with your child: a small bowl, vase or mug that you can decorate using simple techniques: stamps, colored engobes with sponge or brush."
    ],
    "it": [
      "Due ore per un'attività creativa con il vostro bambino: una piccola ciotola, un vaso o una tazza da decorare con tecniche semplici: timbri, ingobbi colorati con una spugna o un pennello."
    ],
    "fr": [
      "Deux heures pour faire une activité créative avec votre enfant : un petit bol, vase ou mug que vous pourrez décorer avec des techniques simples : tampons, engobes colorés à l’éponge ou au pinceau."
    ],
    "nl": [
      "Twee uur voor een creatieve activiteit met je kind: een kleine kom, vaas of mok die je kunt versieren met eenvoudige technieken: stempels, gekleurde engobes met een spons of kwast."
    ],
    "es": [
      "Dos horas para una actividad creativa con tu hijo: un cuenco pequeño, un jarrón o una taza que podréis decorar con técnicas sencillas: sellos, engobes de colores con una esponja o un pincel."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Stage de poterie parent enfant"
    ]
  },
