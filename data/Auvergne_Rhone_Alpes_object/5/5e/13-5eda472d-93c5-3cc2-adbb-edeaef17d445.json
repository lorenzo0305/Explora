  "rdfs:comment": {
    "de": [
      "Ein Treffpunkt für Einheimische und Besucher: In einer freundlichen und geselligen Atmosphäre bietet der Koch des Restaurants Ihnen eine gepflegte Küche; die Auswahl der Gerichte wechslet in regelmäßigen Abständen je nach den Erzeugnissen der Saison."
    ],
    "en": [
      "A meeting place for people near and far....In a warm and friendly environment the chef offers quality dishes and a menu that changes regularly according to seasonal products."
    ],
    "it": [
      "Un luogo di incontro per persone di qui e di altrove... In un ambiente caldo e accogliente, lo chef vi propone una cucina accurata, regolarmente rinnovata in base ai prodotti di stagione. Specialità regionali: trota del Vercors, ravioli al formaggio blu."
    ],
    "fr": [
      "Un rendez-vous pour les gens d'ici et d'ailleurs... Dans un cadre chaleureux et convivial, le chef vous propose une cuisine soignée, renouvelée régulièrement selon les produits de la saison. Spécialités régionales : truite du Vercors, ravioles au bleu."
    ],
    "es": [
      "Un lugar de encuentro para gente de aquí y de otros lugares... En un ambiente cálido y acogedor, el chef le ofrece una cuidada cocina, renovada regularmente según los productos de la temporada. Especialidades regionales: trucha del Vercors, raviolis de queso azul."
    ],
    "nl": [
      "Een ontmoetingsplaats voor mensen van hier en elders... In een warm en vriendelijk kader biedt de chef u een zorgvuldige keuken, regelmatig vernieuwd volgens de producten van het seizoen. Regionale specialiteiten: Vercors forel, blauwe kaas ravioli."
    ]
  },
  "rdfs:label": {
    "de": [
      "Restaurant Les 3 Oursons"
    ],
    "en": [
      "Restaurant Les 3 Oursons"
    ],
