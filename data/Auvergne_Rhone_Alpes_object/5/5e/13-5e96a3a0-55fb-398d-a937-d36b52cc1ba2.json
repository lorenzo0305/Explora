  "rdfs:comment": {
    "de": [
      "Alle unsere Produkte sind frisch, unsere Fische werden von uns in der Küche geschuppt, gehoben und entgrätet. Genießen Sie unsere einfallsreiche Saisonküche in einer angenehmen Umgebung."
    ],
    "en": [
      "All our products are fresh, our fish are scaled, raised and boned by us in the kitchen. Come and taste our inventive seasonal cuisine in a pleasant setting."
    ],
    "it": [
      "Tutti i nostri prodotti sono freschi, il pesce viene squamato, allevato e decapitato da noi in cucina. Venite a gustare la nostra inventiva cucina stagionale in un ambiente piacevole."
    ],
    "fr": [
      "Tous nos produits sont frais, nos poissons sont écaillés, levés et désarêtés par nos soins en cuisine. Venez déguster notre cuisine de saison inventive dans un cadre agréable."
    ],
    "es": [
      "Todos nuestros productos son frescos, nuestro pescado es desescamado, criado y descabezado por nosotros en la cocina. Venga a disfrutar de nuestra ingeniosa cocina de temporada en un entorno agradable."
    ],
    "nl": [
      "Al onze producten zijn vers, onze vis wordt door ons in de keuken geschubd, grootgebracht en ontkopt. Kom genieten van onze inventieve seizoensgebonden keuken in een aangenaam kader."
    ]
  },
