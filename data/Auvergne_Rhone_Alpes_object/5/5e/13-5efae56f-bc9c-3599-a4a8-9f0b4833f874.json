  "rdfs:comment": {
    "de": [
      "Jahrhundert unter dem Schutz des heiligen Gildas stand, wurde sie 1848 vollständig wieder aufgebaut, wie der Stein auf ihrem Giebel beweist"
    ],
    "en": [
      "Dedicated to Saint Gildas since the 14th century, it was completely rebuilt in 1848, as attested by the engraved stone on its pediment"
    ],
    "it": [
      "Dedicata a San Gildas fin dal XIV secolo, fu completamente ricostruita nel 1848, come testimonia la pietra incisa sul frontone"
    ],
    "fr": [
      "Placée sous le vocable de saint Gildas depuis le XIVe  siècle, elle est entièrement reconstruite en 1848, comme l’atteste la pierre  gravée de son fronton"
    ],
    "nl": [
      "Gewijd aan Sint Gildas sinds de 14e eeuw, werd het volledig herbouwd in 1848, zoals blijkt uit de gegraveerde steen op het fronton"
    ],
    "es": [
      "Dedicada a San Gildas desde el siglo XIV, fue completamente reconstruida en 1848, como atestigua la piedra grabada de su frontón"
    ]
  },
