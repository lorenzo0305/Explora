  "rdfs:comment": {
    "de": [
      "Mousquetaire, eine Kreation von Le Puy du fou, ist als Mantel- und Degenromanze konzipiert und wird am 5. und 6. Februar 2028 in der LDLC Arena in Lyon-Décines zu sehen sein."
    ],
    "en": [
      "Imagined as a cloak-and-dagger romance, Mousquetaire, a Puy du fou creation, will visit the LDLC Arena in Lyon-Décines on February 5 & 6, 2028."
    ],
    "it": [
      "Immaginato come una storia di cappa e spada, Mousquetaire, una creazione di Puy du fou, sarà all'Arena LDLC di Lione-Décines il 5 e 6 febbraio 2028."
    ],
    "fr": [
      "Imaginé comme une romance de cape et d’épée, Mousquetaire, une création du Puy du fou sera de passage à la LDLC Arena de Lyon-Décines les 5 & 6 février 2028."
    ],
    "nl": [
      "Mousquetaire, een creatie van Puy du fou, is verbeeld als een romance vol geheimzinnigheid en is op 5 en 6 februari 2028 te zien in de LDLC Arena in Lyon-Décines."
    ],
    "es": [
      "Imaginado como un romance de capa y espada, Mousquetaire, una creación de Puy du fou, estará en el LDLC Arena de Lyon-Décines los días 5 y 6 de febrero de 2028."
    ]
  },
