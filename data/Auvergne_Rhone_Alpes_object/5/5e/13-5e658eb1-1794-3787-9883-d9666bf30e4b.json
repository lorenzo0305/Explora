  "rdfs:comment": {
    "de": [
      "The One Courchevel bietet einen luxuriösen Skiunterricht an. Die Skilehrer legen großen Wert auf das Zuhören und die Zufriedenheit der Kunden. Die dynamischen und vielseitigen Profis im Alter von 25 bis 40 Jahren beherrschen Skifahren, Snowboarden, Tiefschneefahren, Schneeschuhwandern etc."
    ],
    "en": [
      "The One Courchevel offers luxurious ski instruction. Our instructors focus on customer satisfaction. Dynamic and versatile, these 25 to 40 year-old professionals have mastered skiing, snowboarding, off-piste, snowshoeing and more."
    ],
    "it": [
      "The One Courchevel offre lezioni di sci di lusso. Gli istruttori si concentrano sull'ascolto e sulla soddisfazione dei clienti. Dinamici e versatili, questi professionisti di età compresa tra i 25 e i 40 anni sono esperti di sci, snowboard, fuoripista, ciaspole e altro ancora."
    ],
    "fr": [
      "The One Courchevel offre un enseignement de ski luxueux. Les moniteurs mettent l'accent sur l'écoute et la satisfaction du client. Dynamiques et polyvalents, ces professionnels de 25 à 40 ans maîtrisent ski, snowboard, hors-piste, raquette, etc."
    ],
    "es": [
      "The One Courchevel ofrece clases de esquí de lujo. Los instructores se centran en escuchar y satisfacer a los clientes. Dinámicos y polivalentes, estos profesionales de entre 25 y 40 años son expertos en esquí, snowboard, fuera de pista, raquetas de nieve y mucho más."
    ],
    "nl": [
      "The One Courchevel biedt luxe skilessen. De instructeurs richten zich op het luisteren naar en tevreden stellen van de klanten. Deze dynamische en veelzijdige professionals tussen 25 en 40 jaar zijn experts in skiën, snowboarden, off-piste, sneeuwschoenwandelen en nog veel meer."
    ]
  },
