  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/d7c2e624-96ba-305b-a46a-55dc3e084638",
      "dc:description": {
        "de": [
          "Informationen :\n\nTage der Öffnung:\nDienstag bis Samstag: 7:00-13:00 Uhr und 15:00-19:00 Uhr\nSonntag: 7-13 Uhr\n\n\nAbholung:\nZum Mitnehmen während der Öffnungszeiten des Geschäfts\n\nBestellungen:\nBestellung im Laden möglich\n\n "
        ],
        "en": [
          "Information :\n\nOpening days:\nTuesday to Saturday 7am-1pm and 3pm-7pm\nSunday: 7am-1pm\n\n\nPick-up :\nTakeaway during store opening hours\n\nOrdering:\nIn-store ordering possible\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura:\nDa martedì a sabato: 7.00-13.00 e 15.00-19.00\nDomenica: 7.00-13.00\n\n\nRitiro :\nDa asporto durante gli orari di apertura del negozio\n\nOrdini :\nGli ordini possono essere effettuati in negozio\n\n "
        ],
        "fr": [
          "Informations :\n\nJours d'ouverture:\nDu mardi au samedi 7h-13h et 15h-19h \nLe dimanche: 7h-13h\n\n\nRetrait :\nÀ emporter aux horaires d'ouverture du magasin\n\nCommandes :\nPossibilité de commande  en magasin\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen:\nDinsdag tot zaterdag van 7.00 tot 13.00 uur en van 15.00 tot 19.00 uur\nZondag: 7u-1u\n\n\nAfhalen :\nAfhalen tijdens openingstijden winkel\n\nBestellen :\nBestellingen kunnen in de winkel geplaatst worden\n\n "
        ],
        "es": [
          "Más información :\n\nDías de apertura:\nDe martes a sábado: de 7.00 a 13.00 h. y de 15.00 a 19.00 h\nDomingo: de 7.00 a 13.00 h\n\n\nRecogida :\nPara llevar durante el horario de apertura de la tienda\n\nPedidos :\nLos pedidos se pueden hacer en la tienda\n\n "
        ]
      },
