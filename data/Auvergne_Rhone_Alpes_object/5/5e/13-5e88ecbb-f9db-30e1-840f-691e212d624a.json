  "rdfs:comment": {
    "de": [
      "Weißer und gereifter Kuhmilchkäse vom Bauernhof, Faselle, Tomme du Bresson, geglätteter geschlagener Weißkäse, gekochter Teig Typ Gruyère, Raclette. Naturbelassen oder aromatisiert.\nOrt des Lebens und der Aktivität auf dem Bauernhof für Erwachsene mit Autismus-Spektrum-Störung."
    ],
    "en": [
      "Farmhouse cow's milk cheeses, fromage blanc and ripened cheeses, Faisselles, Tomme du Bresson, fromage blanc beaten until smooth, cooked Gruyère-type cheeses, raclette. Plain or flavoured. \nA place to live and work on a farm for mentally handicapped adults."
    ],
    "it": [
      "Formaggi di latte vaccino di fattoria, bianchi e stagionati, faisselles, Tomme du Bresson, formaggi bianchi a pasta liscia, formaggi cotti come Gruyère e Raclette. A pasta liscia o aromatizzata.\nUn luogo dove vivere e lavorare in fattoria per adulti con disturbi dello spettro autistico."
    ],
    "fr": [
      "Fromages fermiers de vache, blancs et affinés, faisselles, tomme du Bresson, fromages blancs battus lissés, pâte cuite type gruyère, raclette. Natures ou aromatisés. \nLieu de vie et d'activité à la ferme pour adultes du trouble du spectre de l'autisme."
    ],
    "es": [
      "Quesos de granja de leche de vaca, blancos y madurados, faisselles, Tomme du Bresson, quesos blancos batidos suaves, quesos cocidos como el Gruyère y la Raclette. Naturales o aromatizados.\nUn lugar para vivir y trabajar en la granja para adultos con trastornos del espectro autista."
    ],
    "nl": [
      "Boerenkaas van koemelk, wit en gerijpt, witte kazen, Tomme du Bresson, gladde geklopte kwark, gekookte deeg type Gruyère, raclette. Gewoon of met een smaakje. \nEen woon- en werkplek op een boerderij voor verstandelijk gehandicapte volwassenen."
    ]
  },
