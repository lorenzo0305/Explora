      "rdfs:comment": {
        "de": [
          "Von Hand gefertigte Stickerin.\nNatürliche Färberin.\nIllustratorin.\n\nKreative.\nÜberrecyclerin.\nTräumerin.\n\nNaturliebhaberin.\n\nSind Sie auch so?\nAtmen Sie tief durch :\nsie sind am richtigen Ort"
        ],
        "en": [
          "Hand embroiderer.\nNatural dyer.\nIllustrator.\n\nCreative.\nOvercycler.\nDreamer.\n\nNature lover.\n\nYou too?\nTake a deep breath:\nyou are in the right place"
        ],
        "it": [
          "Ricamatrice a mano.\nTintore naturale.\nIllustratore.\n\nCreativa.\nSurciclista.\nSognatore.\n\nAmante della natura.\n\nAnche voi?\nFai un respiro profondo:\nsiete nel posto giusto"
        ],
        "fr": [
          "Brodeuse main.\nTeinturière naturelle.\nIllustratrice.\n\nCréative.\nSurcycleuse.\nRêveuse.\n\nAmoureuse de la Nature.\n\nVous aussi ?\nRespirez profondément :\nvous êtes au bon endroit"
        ],
        "nl": [
          "Handborduurster.\nNatuurlijke verver.\nIllustrator.\n\nCreatief.\nSurcyclist.\nDromer.\n\nNatuurliefhebber.\n\nJij ook?\nHaal diep adem:\nje bent op de juiste plaats"
        ],
        "es": [
          "Bordadora manual.\nTintorero natural.\nIlustradora.\n\nCreativo.\nMotociclista.\nSoñador.\n\nAmante de la naturaleza.\n\n¿Y tú?\nRespira hondo:\nestás en el lugar adecuado"
        ]
