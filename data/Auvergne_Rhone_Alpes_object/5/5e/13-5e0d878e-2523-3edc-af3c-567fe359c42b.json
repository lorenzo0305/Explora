  "rdfs:comment": {
    "de": [
      "Als echtes Schloss von Moûtiérain wurde es 1972 von der Stadt aufgekauft und beherbergt heute das Kulturzentrum Marius Hudry mit Ausstellungsflächen, zwei Museen und das Pfarrhaus."
    ],
    "en": [
      "A real moûtiérain castle, it was bought by the town in 1972 and now houses the Marius Hudry Cultural Centre with exhibition spaces, two museums and the presbytery."
    ],
    "it": [
      "Vero e proprio castello moresco, fu acquistato dalla città nel 1972 e oggi ospita il Centro culturale Marius Hudry con spazi espositivi, due musei e il presbiterio."
    ],
    "fr": [
      "Véritable château moûtiérain, il a été racheté par la ville en 1972 et abrite aujourd'hui le Centre Culturel Marius Hudry avec des espaces d'exposition, deux musées, et le presbytère."
    ],
    "es": [
      "Verdadero castillo moûtiano, fue comprado por la ciudad en 1972 y hoy alberga el Centro Cultural Marius Hudry con espacios de exposición, dos museos y el presbiterio."
    ],
    "nl": [
      "Het kasteel, een echt Moûtiéaans kasteel, werd in 1972 door de stad gekocht en herbergt tegenwoordig het Cultureel Centrum Marius Hudry met tentoonstellingsruimten, twee musea en de pastorie."
    ]
  },
  "rdfs:label": {
    "en": [
