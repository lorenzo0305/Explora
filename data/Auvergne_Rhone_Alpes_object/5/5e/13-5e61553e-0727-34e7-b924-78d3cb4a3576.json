  "rdfs:comment": {
    "de": [
      "Große sandige Esplanade am Ufer des Senouire, auf der Sie neue Energie tanken und sich mit der Familie in der Ruhe dieses schönen Ortes entspannen können."
    ],
    "en": [
      "A big, sandy esplanade beside the River Senouire, a great place to charge your batteries and relax with your family in the peace and quiet of a charming village."
    ],
    "it": [
      "Un'ampia spianata sabbiosa sulle rive del Senouire dove potrete fare il pieno di energia e rilassarvi con la famiglia nella pace e nella tranquillità di questo splendido villaggio."
    ],
    "fr": [
      "Grande esplanade ensablée au bord de la Senouire où vous pourrez vous ressourcer et vous détendre en famille au calme au sein de cette belle bourgade."
    ],
    "es": [
      "Una gran explanada de arena a orillas del Senouire donde podrá reponer fuerzas y relajarse en familia en la tranquilidad de este bonito pueblo."
    ],
    "nl": [
      "Een grote zanderige esplanade aan de oevers van de Senouire waar je nieuwe energie kunt opdoen en kunt ontspannen met je gezin in de rust van dit prachtige dorp."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Aire de pique-nique de l'esplanade de St-Pal-de-Senouire"
    ]
  },
