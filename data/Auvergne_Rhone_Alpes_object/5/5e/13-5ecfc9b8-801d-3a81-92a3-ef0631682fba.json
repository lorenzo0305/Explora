  "rdfs:comment": {
    "de": [
      "Willkommen in Le Pressoir de Boisy. Sophie und Stéphane begrüßen Sie in einem alten, vollständig renovierten Bauernhaus im Herzen der Landschaft der Loire. Organisieren Sie Ihre Arbeitstreffen, Seminare oder privaten Veranstaltungen in diesem charmanten Raum."
    ],
    "en": [
      "Welcome to Pressoir de Boisy. Sophie and Stéphane welcome you to a fully renovated former farmhouse in the heart of the Loire countryside. Organize your business meetings, seminars or private events in this charming space."
    ],
    "it": [
      "Benvenuti al Pressoir de Boisy. Sophie e Stéphane sono lieti di accogliervi in un'antica casa colonica completamente ristrutturata nel cuore della campagna della Loira. Organizzate i vostri incontri di lavoro, seminari o eventi privati in questo ambiente affascinante."
    ],
    "fr": [
      "Bienvenue au Pressoir de Boisy. Sophie et Stéphane vous accueillent dans une ancienne ferme entièrement rénovée, au cœur de la campagne de la Loire. Organisez vos réunions de travail, séminaires ou évènements privés dans cet espace plein de charme."
    ],
    "nl": [
      "Welkom bij Pressoir de Boisy. Sophie en Stéphane heten u van harte welkom in een volledig gerenoveerde voormalige boerderij in het hart van het platteland van de Loire. Organiseer uw zakelijke bijeenkomsten, seminars of privé-evenementen in deze charmante omgeving."
    ],
    "es": [
      "Bienvenido a Pressoir de Boisy. Sophie y Stéphane están encantados de recibirle en una antigua granja totalmente renovada en el corazón de la campiña del Loira. Organice sus reuniones de negocios, seminarios o eventos privados en este marco encantador."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Salle à louer - Pressoir de Boisy"
    ]
  },
