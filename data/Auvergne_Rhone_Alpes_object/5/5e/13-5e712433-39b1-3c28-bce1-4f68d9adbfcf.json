  "rdfs:comment": {
    "de": [
      "Die Agentur 1786 ist Spezialist für Reisen, maßgeschneiderte Erlebnisse, Geschäftsveranstaltungen und hochwertige Transporte in den Alpen, um eine authentische, elegante und menschliche Entdeckung der Region zu ermöglichen."
    ],
    "en": [
      "Agence 1786 specializes in travel, tailor-made experiences, professional events, and high-end transportation in the Alps, offering an authentic, elegant, and human-centered way to discover the region."
    ],
    "it": [
      "L'Agenzia 1786 è specializzata in viaggi, esperienze su misura, eventi professionali e trasporti di alta gamma nelle Alpi, per una scoperta autentica, elegante e umana del territorio."
    ],
    "fr": [
      "L’Agence 1786 est spécialiste des voyages, expériences sur mesure, événements professionnels et transports haut-de-gamme dans les Alpes, pour une découverte authentique, élégante et humaine du territoire."
    ],
    "es": [
      "La agencia 1786 está especializada en viajes, experiencias a medida, eventos de empresa y transportes de alta gama en los Alpes, para un descubrimiento auténtico, elegante y humano de la región."
    ],
    "nl": [
      "Agence 1786 is gespecialiseerd in reizen, op maat gemaakte ervaringen, zakelijke evenementen en eersteklas vervoer in de Alpen, voor een authentieke, elegante en menselijke ontdekking van de regio."
    ]
  },
