  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/20442504-b6ae-3287-8e78-74454179784a",
      "dc:description": {
        "de": [
          "Geführte Tour \"DER MARIENHALLE UND DIE KRIEGE\"\n\nBeobachten Sie die Aktivitäten in der Gezeitenhalle und der Auktionshalle des ersten Fischereihafens Frankreichs\n\nTreffpunkt vor der Auktionshalle, Boulevard de Châtillon\n\nUhrzeit: 4.30 Uhr (Dauer: 1 Std.)\n-\tSamstag, 25. Oktober\n-\tFreitag, 31. Oktober\n\n\nAchtung: nur ab 18 Jahren"
        ],
        "en": [
          "Guided tour of the \"HALLE A MAREE ET LA CRIEE\"\n\nObserve the activities of the fish market and the auction of France?s 1st fishing port\n\nRv in front of the Criée, boulevard de Châtillon\n\nTime: 4 h 30 (duration: 1 h)\n-\tSaturday, October 25th\n-\tFriday, October 31st\n\n\nWarning: 18 years and over only"
        ],
        "it": [
          "Visita guidata a \"L'ALBERO MARINO E LE CRIME\"\n\nOsservate le attività del mercato delle maree e dell'asta del pesce nel principale porto di pesca francese\n\nRitrovo davanti all'asta del pesce, in boulevard de Châtillon\n\nOra: 4 ore e 30 (durata: 1 ora)\n-\tSabato 25 ottobre\n-\tVenerdì 31 ottobre\n\n\nAttenzione: solo dai 18 anni in su"
        ],
        "fr": [
          "Visite guidée « La HALLE A MAREE ET LA CRIEE »\n\nObservez l’activité de la halle à marée et de la Criée du 1er port de pêche de France\n\nRv devant la Criée, boulevard de Châtillon\n\nHoraire : 4 h 30 (durée : 1 h)\n-\tSamedi 25 octobre\n-\tVendredi 31 octobre \n\n\nAttention : à partir de 18 ans uniquement"
        ],
        "es": [
          "Visita guiada a \"LA HALLA MARINA Y LOS GRITOS\"\n\nObserve las actividades del mercado de mareas y la subasta de pescado en el principal puerto pesquero de Francia\n\nEncuentro frente a la lonja, bulevar de Châtillon\n\nHora: 4 h 30 (duración: 1 h)\n-\tSábado 25 de octubre\n-\tViernes 31 de octubre\n\n\nAdvertencia: sólo para mayores de 18 años"
        ],
        "nl": [
          "Rondleiding door \"DE MARINE HALLE EN DE KRIJGEN\"\n\nBekijk de activiteiten van de getijdenmarkt en de visafslag in de belangrijkste vissershaven van Frankrijk\n\nAfspraak voor de vismijn, boulevard de Châtillon\n\nTijd: 4 h 30 (duur: 1 h)\n-\tZaterdag 25 oktober\n-\tVrijdag 31 oktober\n\n\nWaarschuwing: 18 jaar en ouder"
        ]
      },
