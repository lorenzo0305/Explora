  "rdfs:comment": {
    "de": [
      "Ob mit der Familie, mit Freunden oder zu zweit, begeben Sie sich auf eine bukolische Minikreuzfahrt, um die Flora und Fauna des Canal de Berry zu entdecken."
    ],
    "en": [
      "With family, friends or loved ones, embark on a bucolic mini-cruise to discover the flora and fauna of the Berry canal."
    ],
    "it": [
      "Con la famiglia, gli amici o i vostri cari, fate una mini-crociera bucolica alla scoperta della flora e della fauna del canale di Berry."
    ],
    "fr": [
      "En famille, entre amis ou en amoureux, embarquez pour une mini-croisière bucolique à la découverte de la faune et la flore du canal de Berry."
    ],
    "nl": [
      "Maak met je gezin, vrienden of geliefden een bucolische minicruise om de flora en fauna van het Berrykanaal te ontdekken."
    ],
    "es": [
      "Con su familia, amigos o seres queridos, realice un bucólico minicrucero para descubrir la flora y la fauna del canal de Berry."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Promenades fluviales sur le Canal de Berry - Vallon-en-Sully"
    ]
  },
