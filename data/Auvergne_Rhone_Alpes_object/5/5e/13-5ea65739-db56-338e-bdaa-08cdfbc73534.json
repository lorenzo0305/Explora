  "rdfs:comment": {
    "de": [
      "Die Auberge de Clochemerle verfügt mit seinen 10 persönlichen Zimmern, welche Charme und Modernität vereinen, über den ganzen Komfort eines traditionellen Hotelbetriebs."
    ],
    "en": [
      "Welcome to L'Auberge de Clochemerle, a beautiful house in the heart of the vineyards, with 10 rooms, a wellness area, homemade breakfasts and a breathtaking view."
    ],
    "it": [
      "L'Auberge de Clochemerle è dotata di tutti i comfort di un hotel tradizionale, con 10 camere personalizzate che uniscono fascino e modernità."
    ],
    "fr": [
      "Bienvenue à L'Auberge de Clochemerle, très belle maison au cœur du vignoble disposant de 10 chambres, un espace bien-être, des petits déjeuners maisons avec une vue imprenable."
    ],
    "nl": [
      "Welkom bij L'Auberge de Clochemerle, een prachtig huis in het hart van de wijngaard met 10 kamers, een wellnessruimte, huisgemaakt ontbijt en een adembenemend uitzicht."
    ],
    "es": [
      "El Auberge de Clochemerle dispone de toda la comodidad de un establecimiento hotelero tradicional con 10 habitaciones personalizadas que combinan encanto y modernidad."
    ]
  },
