  "rdfs:comment": {
    "de": [
      "Es handelt sich um 6 Schautafeln, die entlang des 300 Meter langen Pfades aufgestellt sind. Sie zeigen die 13 bekannten Arten, die auf dem Pfad vorkommen, mit einer geschätzten Anzahl von 1700 Pflanzenarten."
    ],
    "en": [
      "There are 6 explanatory panels along the 300-metre trail. The 13 species known on the trail's plots are listed, for an estimated total of 1,700 plants of all species."
    ],
    "it": [
      "Lungo i 300 metri del sentiero ci sono 6 pannelli informativi. In essi sono elencate le 13 specie conosciute che crescono negli appezzamenti di terreno lungo il sentiero, con una stima di 1.700 piante di tutte le specie messe insieme."
    ],
    "fr": [
      "Ce sont 6 panneaux explicatifs disposé le long des 300 mètres du sentier. On y retrouve les 13 espèces connues sur les parcelles du sentier pour une estimation de 1 700 pieds toutes espèces confondues."
    ],
    "es": [
      "Hay 6 paneles informativos a lo largo de los 300 metros del sendero. En ellos se enumeran las 13 especies que se sabe que crecen en las parcelas del sendero, con un total estimado de 1.700 plantas de todas las especies."
    ],
    "nl": [
      "Er zijn 6 informatiepanelen langs het 300 meter lange pad. Ze geven een overzicht van de 13 soorten waarvan bekend is dat ze groeien op de percelen langs het pad, met naar schatting 1.700 planten van alle soorten samen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Sentier des orchidées sauvages"
    ]
  },
