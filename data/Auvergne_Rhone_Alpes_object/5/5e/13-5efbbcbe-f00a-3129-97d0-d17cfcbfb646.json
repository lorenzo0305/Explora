  "rdfs:comment": {
    "de": [
      "Die Kirche St Gervais et Protais, ein im Laufe der Zeit errichtetes Gebäude. Genießen Sie die von den Bürgerfamilien von Mieussy gegründeten Kapellen, das als historisches Denkmal eingestufte Portal im Stil der Flamboyant-Gotik..."
    ],
    "en": [
      "NEW ! St Gervais and Protais church. Enjoy its chapels built by comfortable families of Mieussy and its Flamboyant Gothic style gate which was classified as an \"historic monument\"..."
    ],
    "it": [
      "La chiesa di St Gervais e Protais, un edificio costruito nel tempo. Apprezzate le sue cappelle fondate dalle famiglie borghesi di Mieussy, il suo portale in stile gotico fiammeggiante classificato come monumento storico..."
    ],
    "fr": [
      "L'Eglise St Gervais et Protais, un édifice construit au fil du temps. Appréciez ses chapelles fondées par les familles bourgeoises de Mieussy, son portail de style gothique flamboyant classé au titre des monuments historiques..."
    ],
    "es": [
      "La iglesia de St Gervais y Protais, un edificio construido a lo largo del tiempo. Aprecie sus capillas fundadas por las familias burguesas de Mieussy, su portal de estilo gótico flamígero clasificado como monumento histórico..."
    ],
    "nl": [
      "De kerk van St Gervais en Protais, een gebouw dat in de loop der tijd is gebouwd. Geniet van de kapellen die werden gesticht door de rijke families van Mieussy, het flamboyante gotische portaal dat op de monumentenlijst staat..."
    ]
  },
  "rdfs:label": {
