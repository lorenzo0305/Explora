  "rdfs:comment": {
    "de": [
      "Die Bibliothek La Chrysalide steht allen Barrolins und den Einwohnern anderer Gemeinden offen. Dieser Ort verfügt über einen angenehmen Entspannungsbereich, einen Arbeitsraum und einen Computerplatz, an dem Sie die Recherchen Ihrer Autoren einsehen können."
    ],
    "en": [
      "La Chrysalide library is open to Barrolins and residents of other communes. The library has a pleasant relaxation area, a workroom and a computer workstation for consulting your authors' research."
    ],
    "it": [
      "La biblioteca La Chrysalide è aperta ai residenti di Barrol e di altri comuni. La biblioteca dispone di una piacevole area relax, di una sala studio e di una postazione informatica per consultare le proprie ricerche d'autore."
    ],
    "fr": [
      "La bibliothèque La Chrysalide est ouverte aux Barrolins et pour les habitants des autres communes. Ce lieu bénéficie d'un espace de détente agréable, d'une salle de travail, d'un poste informatique pour consulter la recherche de vos auteurs."
    ],
    "es": [
      "La biblioteca La Chrysalide está abierta a los habitantes de Barrol y de otros municipios. La biblioteca dispone de una agradable zona de descanso, una sala de estudio y un puesto informático para consultar sus investigaciones de autor."
    ],
    "nl": [
      "De bibliotheek van La Chrysalide is toegankelijk voor inwoners van Barrol en andere gemeenten. De bibliotheek heeft een aangename ontspanningsruimte, een studieruimte en een computerwerkstation voor het raadplegen van uw auteursonderzoek."
    ]
  },
  "rdfs:label": {
