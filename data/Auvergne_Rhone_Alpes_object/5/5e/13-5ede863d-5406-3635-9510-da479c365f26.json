    "de": [
      "Action Sport - Ski rider & Café burger empfängt Sie vom kleinen Kaffee am Morgen über das Mittagessen bis hin zur Aperitifzeit."
    ],
    "en": [
      "Action Sport - Ski rider & Café burger will welcome you from breakfast to breakfast, until the time of the aperitif."
    ],
    "it": [
      "Action Sport - Ski rider & Café burger vi accoglierà dal caffè del mattino al pranzo, fino all'ora dell'aperitivo."
    ],
    "fr": [
      "Action Sport - Ski rider & Café burger vous  accueillera du petit café du matin au  déjeuner, jusqu'à l'heure de l'apéritif."
    ],
    "nl": [
      "Action Sport - Ski rider & Café burger verwelkomt je van 's ochtends bij de koffie tot de lunch en het aperitief."
    ],
