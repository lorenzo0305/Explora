  "rdfs:comment": {
    "de": [
      "Im Jahr 1910 gründete François Perceval das Weingut an den Hängen der Combe de Savoie. Mehr als ein Jahrhundert später und nach vier Generationen der Percevals umfasst das Weingut heute mehr als 50 Hektar."
    ],
    "en": [
      "In 1910, François Perceval founded the estate on the slopes of the Combe de Savoie. More than a century later, with 4 generations of Perceval, the vineyard now covers more than 50 hectares."
    ],
    "it": [
      "Nel 1910, François Perceval fondò la tenuta sulle pendici della Combe de Savoie. Più di un secolo dopo, con 4 generazioni di Perceval, il vigneto copre oggi più di 50 ettari."
    ],
    "fr": [
      "En 1910, François Perceval créa l’exploitation sur les pentes de la Combe de Savoie. Plus d’un siècle plus tard et ayant vu passé 4 générations de Perceval, le vignoble compte actuellement plus de 50 hectares."
    ],
    "nl": [
      "In 1910 stichtte François Perceval het domein op de hellingen van de Combe de Savoie. Meer dan een eeuw later, met 4 generaties Perceval, beslaat de wijngaard nu meer dan 50 hectare."
    ],
    "es": [
      "En 1910, François Perceval fundó la propiedad en las laderas de la Combe de Savoie. Más de un siglo después, con 4 generaciones de Perceval, el viñedo ocupa hoy más de 50 hectáreas."
    ]
  },
  "rdfs:label": {
