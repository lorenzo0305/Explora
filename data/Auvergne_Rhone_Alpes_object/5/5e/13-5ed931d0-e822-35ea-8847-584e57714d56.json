  "rdfs:comment": {
    "de": [
      "Nach italienischer Tradition zubereitete Pizzas.\r\nPizzas, Gerichte und Desserts zum Mitnehmen.\r\nFreitag, Samstag und Sonntag ab 18 Uhr.\r\nSamstags auch mittags.\r\nAuf Reservierung 06 23 52 67 58 oder 04 71 59 73 50"
    ],
    "en": [
      "Pizzas made in the Italian tradition.\r\nPizzas, dishes and desserts to take away.\r\nFriday, Saturday and Sunday from 6pm.\r\nSaturday lunchtime.\r\nOn reservation 06 23 52 67 58 or 04 71 59 73 50"
    ],
    "it": [
      "Pizze fatte secondo la tradizione italiana.\r\nPizze, piatti e dessert da asporto.\r\nVenerdì, sabato e domenica dalle 18:00.\r\nSabato a pranzo.\r\nSu prenotazione 06 23 52 67 58 o 04 71 59 73 50"
    ],
    "fr": [
      "Pizzas élaborées dans la tradition italienne.\r\nPizzas, plats et desserts à emporter.\r\nVendredi, samedi et dimanche dès 18h.\r\nSamedi midi.\r\nSur réservation  06 23 52 67 58 ou 04 71 59 73 50"
    ],
    "es": [
      "Pizzas elaboradas según la tradición italiana.\r\nPizzas, platos y postres para llevar.\r\nViernes, sábado y domingo a partir de las 18 horas.\r\nSábado a la hora de comer.\r\nEn reserva 06 23 52 67 58 o 04 71 59 73 50"
    ],
    "nl": [
      "Pizza's gemaakt in de Italiaanse traditie.\r\nPizza's, schotels en desserts om mee te nemen.\r\nVrijdag, zaterdag en zondag vanaf 18.00 uur.\r\nZaterdagmiddag.\r\nOp reservering 06 23 52 67 58 of 04 71 59 73 50"
    ]
  },
