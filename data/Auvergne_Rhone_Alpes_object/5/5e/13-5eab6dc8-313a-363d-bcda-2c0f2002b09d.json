  "rdfs:comment": {
    "de": [
      "Ein Ort, der der Schokolade gewidmet ist. Verkauf von Schokolade und anderen Leckereien, die im Labor hergestellt werden. Boutique mit kulinarischen Artikeln, die auf Schokolade und Konditoreiwaren spezialisiert sind. Kurse und Praktika zur Herstellung von Schokolade und Konditoreiwaren. Geschenkkarten."
    ],
    "en": [
      "A place dedicated to chocolate. Sale of chocolates and sweets, made in the laboratory. Culinary articles shop specializing in chocolate / pastry. Courses and training courses in chocolate and pastry making. Gift cards."
    ],
    "it": [
      "Un luogo dedicato al cioccolato. Vendita di cioccolatini e prelibatezze, realizzati in laboratorio. Negozio specializzato in cioccolato e pasticceria. Corsi e laboratori di cioccolato e pasticceria. Carte regalo."
    ],
    "fr": [
      "Un lieu dédié au chocolat. Vente de chocolats et gourmandises, fabriqués dans le laboratoire. Boutique d'articles culinaires spécialisée chocolat / pâtisserie. Cours et stages de confection de chocolat et pâtisserie. Cartes cadeaux."
    ],
    "es": [
      "Un lugar dedicado al chocolate. Venta de chocolates y golosinas, elaborados en el laboratorio. Tienda especializada en chocolate y pastelería. Cursos y talleres de chocolatería y pastelería. Tarjetas de regalo."
    ],
    "nl": [
      "Een plek gewijd aan chocolade. Verkoop van chocolade en delicatessen, gemaakt in het laboratorium. Winkel gespecialiseerd in chocolade en gebak. Chocolade en gebak cursussen en workshops. Cadeaubonnen."
    ]
  },
