  "rdfs:comment": {
    "de": [
      "Le Bistrot du Jardin lädt Sie ein, das Beste der Ardèche mit seiner traditionellen Küche zu genießen. Entspannen Sie sich auf der Terrasse bei Eis und Cocktails. Genießen Sie jeden Abend unsere Pizzen vor Ort oder zum Mitnehmen unter 07 56 47 62 98."
    ],
    "en": [
      "Le Bistrot du Jardin invites you to savour the best of the Ardèche with its traditional cuisine. Relax on the terrace over ice creams and cocktails. Every evening, enjoy our pizzas on the premises or to take away on 07 56 47 62 98."
    ],
    "it": [
      "Il Bistrot du Jardin vi invita a gustare il meglio dell'Ardèche con la sua cucina tradizionale. Rilassatevi sulla terrazza con gelati e cocktail. Tutte le sere, potrete gustare le nostre pizze in loco o da asporto al numero 07 56 47 62 98."
    ],
    "fr": [
      "Le Bistrot du Jardin vous invite à savourer le meilleur de l’Ardèche avec une cuisine traditionnelle. Détendez-vous en terrasse autour de glaces et cocktails. Chaque soir, dégustez nos pizzas sur place ou à emporter au 07 56 47 62 98."
    ],
    "nl": [
      "Le Bistrot du Jardin nodigt je uit om het beste van de Ardèche te proeven met zijn traditionele keuken. Ontspan op het terras met ijsjes en cocktails. Geniet elke avond van onze pizza's ter plaatse of om mee te nemen op 07 56 47 62 98."
    ],
    "es": [
      "Le Bistrot du Jardin le invita a saborear lo mejor de la Ardèche con su cocina tradicional. Relájese en la terraza con helados y cócteles. Todas las noches, disfrute de nuestras pizzas en el local o para llevar en el 07 56 47 62 98."
    ]
  },
