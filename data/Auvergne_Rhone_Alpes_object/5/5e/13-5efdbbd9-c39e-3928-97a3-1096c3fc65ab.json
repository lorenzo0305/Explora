  "rdfs:comment": {
    "de": [
      "Willkommen in der Auberge \"LOU PINATOU\". Auf 800 m Höhe gelegenes Panoramarestaurant mit Blick auf das Massif du Pilat, die Yssingelais-Berge, das Massif Meygal und Mezenc. Charlotte und Alexandre begrüßen Sie in ihrem Gourmet-Restaurant."
    ],
    "en": [
      "Welcome to the \"LOU PINATOU\" inn. Perched at 800m altitude, this panoramic restaurant overlooks the Pilat massif, the Yssingelais mountains, the Meygal and Mezenc massif. Charlotte and Alexandre welcome you to their gourmet restaurant."
    ],
    "it": [
      "Benvenuti alla locanda \"LOU PINATOU\". Arroccato a 800 m di altitudine, questo ristorante panoramico domina il massiccio del Pilat, le montagne dell'Yssingelais, il massiccio del Meygal e il Mezenc. Charlotte e Alexandre vi danno il benvenuto nel loro ristorante gourmet."
    ],
    "fr": [
      "Bienvenue à l'auberge \"LOU PINATOU\". Perché à 800m d’altitude,  restaurant panoramique avec vue sur le massif du Pilat, les monts Yssingelais, le massif Meygal et Mezenc. Charlotte et Alexandre vous accueillent dans leur restaurant gastronomique."
    ],
    "nl": [
      "Welkom in de herberg \"LOU PINATOU\". Dit panoramisch restaurant ligt op 800 m hoogte en kijkt uit op het Pilat-massief, het Yssingelais-gebergte, het Meygal-massief en de Mezenc. Charlotte en Alexandre heten u welkom in hun gastronomische restaurant."
    ],
    "es": [
      "Bienvenido a la posada \"LOU PINATOU\". Situado a 800 m de altitud, este restaurante panorámico domina el macizo del Pilat, los montes Yssingelais, el macizo del Meygal y el Mezenc. Charlotte y Alexandre le dan la bienvenida a su restaurante gastronómico."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Auberge Lou Pinatou"
    ]
  },
