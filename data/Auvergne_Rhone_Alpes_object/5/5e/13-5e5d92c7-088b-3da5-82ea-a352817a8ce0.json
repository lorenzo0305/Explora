  "rdfs:comment": {
    "de": [
      "Charmantes Landgasthaus, eingebettet in die Gassen der mittelalterlichen Stadt Hérisson, am Fuße des feudalen Schlosses und der Überreste der Stiftskirche Saint-Sauveur."
    ],
    "en": [
      "Charming country inn nestled in the narrow streets of the medieval town of Hérisson, at the foot of the feudal castle and the remains of the Collegiate Church of Saint-Sauveur."
    ],
    "it": [
      "Affascinante locanda di campagna immersa nelle stradine della città medievale di Hérisson, ai piedi del castello feudale e dei resti della Collegiata di Saint-Sauveur."
    ],
    "fr": [
      "Charmante auberge de campagne, nichée dans les ruelles de la cité médiévale de Hérisson, au pied du château féodal et des vestiges de la Collégiale Saint-Sauveur."
    ],
    "es": [
      "Encantadora posada rural enclavada en las callejuelas de la ciudad medieval de Hérisson, a los pies del castillo feudal y de los restos de la Colegiata de Saint-Sauveur."
    ],
    "nl": [
      "Charmante plattelandsherberg genesteld in de smalle straatjes van de middeleeuwse stad Hérisson, aan de voet van het feodale kasteel en de overblijfselen van de collegiale kerk Saint-Sauveur."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant Auberge le Médiéval"
    ]
  },
