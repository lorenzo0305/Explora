  "rdfs:comment": {
    "de": [
      "Pizzas aus frischen und lokalen Produkten, die den guten Ruf der lokalen Marke Pizza Cosy ausmachen."
    ],
    "en": [
      "Pizzas made from fresh local ingredients, the very signature of the local Pizza Cosy brand."
    ],
    "it": [
      "Benvenuti a La Pizzette, una pizzeria accogliente dove la passione per la cucina italiana si assapora in ogni boccone. a La Pizzette troverete un'atmosfera calda e autentica che unisce tradizione italiana e modernità."
    ],
    "fr": [
      "Bienvenue à La Pizzette, une pizzeria conviviale où la passion de la cuisine italienne se déguste à chaque bouchée. , nos établissements vous accueille dans une ambiance chaleureuse et authentique, mêlant tradition italienne et modernité."
    ],
    "nl": [
      "Welkom bij La Pizzette, een gezellige pizzeria waar passie voor de Italiaanse keuken in elke hap te proeven is. bij La Pizzette vind je een warme, authentieke sfeer die Italiaanse traditie en moderniteit combineert."
    ],
    "es": [
      "Bienvenido a La Pizzette, una pizzería acogedora donde la pasión por la cocina italiana se saborea en cada bocado. en La Pizzette encontrará un ambiente cálido y auténtico que combina tradición italiana y modernidad."
    ]
  },
