  "rdfs:comment": {
    "de": [
      "Sie haben Zugang zu 20 Hektar wunderschöner, abwechslungsreicher Natur, wie bei einem Ausflug ins Mittelgebirge abseits der ausgetretenen Pfade, wo wir plötzlich Pferde und Ponys in freier Wildbahn sehen können! Wir können sie beobachten, streicheln und uns erholen."
    ],
    "en": [
      "Gain access to twenty hectares of magnificent, rich & varied nature, like a mid-mountain walk off the beaten track, where we can suddenly catch a glimpse of horses & ponies at liberty! Observe them, stroke them, recharge your batteries."
    ],
    "it": [
      "Accedete a una ventina di ettari di paesaggio magnifico, ricco e vario, come una passeggiata di mezza montagna fuori dai sentieri battuti, dove potrete improvvisamente scorgere cavalli e pony liberi! Osservateli, accarezzateli, fate il pieno di energia."
    ],
    "fr": [
      "Ayez accès à une vingtaine d'hectares de magnifique nature, riche & variée, telle une balade en moyenne montagne hors des sentiers battus, où nous pouvons, d'un coup, apercevoir les chevaux & poneys en liberté ! Les observer, les caresser, se ressourcer."
    ],
    "nl": [
      "Krijg toegang tot ongeveer twintig hectare prachtig, rijk en gevarieerd landschap, zoals een wandeling in het midden van de bergen buiten de gebaande paden, waar je plotseling een glimp kunt opvangen van paarden en pony's die vrij rondlopen! Observeer ze, aai ze, doe nieuwe energie op."
    ],
    "es": [
      "Acceda a una veintena de hectáreas de un paisaje magnífico, rico y variado, como un paseo a media montaña fuera de los caminos trillados, donde de repente podrá vislumbrar caballos y ponis en libertad Obsérvelos, acarícielos, recargue las pilas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Cœur Nature"
    ]
  },
