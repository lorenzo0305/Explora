  "rdfs:comment": {
    "de": [
      "Bioproduzenten: Syrah-Wein, Kartoffeln, Kürbisse, frische Kastanien, Kastaniendelikatesse und Eier.\r\nVerkauf ab Hof (auf Anfrage) und auf den Märkten von Saint-Péray (Mittwoch) Guilherand-Granges (Freitag) und Valence place danton (Montag)."
    ],
    "en": [
      "Organic producers: syrah wine, potatoes, squash, fresh chestnuts, chestnut delight and eggs.\r\nSale at the farm (on request) and on the markets of Saint-Péray (Wednesday) Guilherand-Granges (Friday) and Valence place danton (Monday)."
    ],
    "it": [
      "Produttori biologici: vino syrah, patate, zucca, castagne fresche, specialità di castagne e uova.\r\nVendita in azienda (su richiesta) e nei mercati di Saint-Péray (mercoledì) Guilherand-Granges (venerdì) e Valence place danton (lunedì)."
    ],
    "fr": [
      "Producteurs bio : vin syrah, pommes de terre, courges, châtaigne fraiche, délice de châtaigne et œufs.\r\nVente à la ferme (sur demande) et sur les marchés de Saint-Péray (mercredi) Guilherand-Granges (vendredi) et Valence place danton (lundi)."
    ],
    "es": [
      "Productores ecológicos: vino syrah, patatas, calabaza, castañas frescas, manjar de castañas y huevos.\r\nVenta en la granja (previa petición) y en los mercados de Saint-Péray (miércoles) Guilherand-Granges (viernes) y Valence place danton (lunes)."
    ],
    "nl": [
      "Biologische producenten: syrah wijn, aardappelen, pompoen, verse kastanjes, kastanje delicatesse en eieren.\r\nVerkoop op de boerderij (op aanvraag) en op de markten van Saint-Péray (woensdag) Guilherand-Granges (vrijdag) en Valence place danton (maandag)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ferme de Chazal"
    ]
  },
