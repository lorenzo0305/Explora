  "rdfs:comment": {
    "de": [
      "Kirche im romanischen Stil. Der Chor ist eine ehemalige Kapelle aus dem Jahr 1084. Bau aus sichtbaren Steinen. Ein einziges Schiff, das den Chor verlängert, und ein darauf aufgesetzter Glockenturm mit Portal."
    ],
    "en": [
      "this Romanesque monastic church is a superb stone construction composed of a single nave and a porch belfry covered in typical local tiles. The choir, a former chapel of the Condat monks, dates from 1084. the 'Jardin de la cure' is a former cemetery where the monks were buried"
    ],
    "it": [
      "Chiesa in stile romanico. Il coro è un'antica cappella risalente al 1084. Costruzione in pietra a vista. Dal coro si estende un'unica navata, alla quale è addossato un campanile-portico."
    ],
    "fr": [
      "Eglise de style roman. Le choeur est une ancienne chapelle de 1084. Construction en pierres apparentes. Une seule nef prolongeant le choeur et d'un clocher-porche plaqué sur celle-ci."
    ],
    "nl": [
      "Kerk in romaanse stijl. Het koor is een voormalige kapel uit 1084. Constructie van zichtbare stenen. Er is een enkel schip dat zich uitstrekt vanuit het koor en een klokkentoren-porch ertegenaan."
    ],
    "es": [
      "Iglesia de estilo románico. El coro es una antigua capilla que data de 1084. Construcción de piedra vista. Del coro sale una sola nave con un campanario-porche adosado."
    ]
  },
