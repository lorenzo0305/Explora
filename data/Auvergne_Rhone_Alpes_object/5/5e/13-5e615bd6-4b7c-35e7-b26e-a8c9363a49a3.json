  "rdfs:comment": {
    "de": [
      "Entdecken Sie die französische Berggastronomie unseres Küchenchefs Edouard Loubet in einer geselligen Atmosphäre mit überraschenden, schmackhaften und einzigartigen Tellern."
    ],
    "en": [
      "Discover the Mountain gastronomy by Edouard Loubet in a friendly atmosphere savouring unique dishes that will delight and astound your taste buds !"
    ],
    "it": [
      "Venite a scoprire la gastronomia francese di montagna del nostro chef Edouard Loubet in un ambiente conviviale con piatti unici, gustosi e particolari."
    ],
    "fr": [
      "Venez découvrir la gastronomie française de Montagne de notre chef Edouard Loubet dans une ambiance conviviale avec des assiettes surprenantes, savoureuses et singulières."
    ],
    "es": [
      "Venga a descubrir la gastronomía francesa de montaña de nuestro chef Edouard Loubet en un ambiente acogedor con platos sorprendentes, sabrosos y únicos."
    ],
    "nl": [
      "Kom en ontdek de Franse berggastronomie van onze chef Edouard Loubet in een gezellige sfeer met verrassende, smakelijke en unieke gerechten."
    ]
  },
