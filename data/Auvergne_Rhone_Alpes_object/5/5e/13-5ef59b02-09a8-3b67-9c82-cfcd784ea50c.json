  "rdfs:comment": {
    "de": [
      "Eine Frau liest ein Buch und hört dabei Musik (Kopfhörer).\r\nDas Wandgemälde zeigt auch die Nutzung des Gebäudes: die Kopfhörer für die Musikschule und das Buch für die Mediathek."
    ],
    "en": [
      "A woman reads a book while listening to music (headphones)\r\nThe fresco also reveals the building's uses: the headphones for the music school and the book for the media library."
    ],
    "it": [
      "Una donna legge un libro ascoltando musica (cuffie)\r\nL'affresco rivela anche gli usi dell'edificio: le cuffie per la scuola di musica e il libro per la mediateca."
    ],
    "fr": [
      "Une femme lit un livre en écoutant de la musique (écouteurs)\r\nLa fresque révèle aussi les usages du bâtiment: les écouteurs pour l'école de musique et le livre pour la médiathèque."
    ],
    "es": [
      "Una mujer lee un libro mientras escucha música (auriculares)\r\nEl fresco también revela los usos del edificio: los auriculares para la escuela de música y el libro para la mediateca."
    ],
    "nl": [
      "Een vrouw leest een boek terwijl ze naar muziek luistert (koptelefoon)\r\nHet fresco onthult ook het gebruik van het gebouw: de koptelefoon voor de muziekschool en het boek voor de mediatheek."
    ]
  },
  "rdfs:label": {
    "de": [
      "Wandgemälde: Die Welt steht Kopf"
    ],
    "en": [
      "Fresco: The world upside down"
    ],
    "it": [
      "Affresco: Il mondo alla rovescia"
    ],
    "fr": [
      "Fresque : Le monde à l'envers"
    ],
    "nl": [
      "Fresco: De wereld op zijn kop"
    ]
  },
