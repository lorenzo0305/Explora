  "rdfs:comment": {
    "de": [
      "Der Temple de Saillans wurde vollständig restauriert und im Juni 2011 eingeweiht. Er ist heute kultischen und kulturellen Aktivitäten gewidmet und ist der Wohnort des Vereins Théâtre de nuit. Bald ein Programm mit Aufführungen!"
    ],
    "en": [
      "The Temple de Saillans was completely restored and inaugurated in June 2011. It is now dedicated to religious and cultural activities, and is home to the Théâtre de nuit association. Shows coming soon!"
    ],
    "it": [
      "Il Tempio di Saillans è stato completamente restaurato e inaugurato nel giugno 2011. Oggi è dedicato ad attività religiose e culturali e ospita l'associazione Théâtre de nuit. Presto un programma di spettacoli!"
    ],
    "fr": [
      "Le Temple de Saillans a été entièrement restauré et inauguré en juin 2011. Il est aujourd'hui dédié à l'activité cultuelle et culturelle et constitue le lieu de résidence de l'association du Théâtre de nuit. Bientôt une programmation de spectacles !"
    ],
    "es": [
      "El templo de Saillans fue completamente restaurado e inaugurado en junio de 2011. Actualmente se dedica a actividades religiosas y culturales y es la sede de la asociación Théâtre de nuit. ¡Pronto un programa de espectáculos!"
    ],
    "nl": [
      "De Temple de Saillans werd volledig gerestaureerd en ingehuldigd in juni 2011. Het is nu gewijd aan religieuze en culturele activiteiten en is de thuisbasis van de vereniging Théâtre de nuit. Binnenkort een programma met voorstellingen!"
    ]
  },
