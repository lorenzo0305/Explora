  "rdfs:comment": {
    "de": [
      "Der Club Val D'Allier Quad organisiert eine halbnächtliche Wanderung über 120 km, die um 15 Uhr in Langeac beginnt und um Mitternacht endet. Tarif zu 45?/Person mit eingeschlossener Mahlzeit. Nur zugelassene Fahrzeuge. Infos & Anmeldung unter 07 67 76 28 58."
    ],
    "en": [
      "The Val D'Allier Quad club is organizing a 120km semi-natural ride, departing from Langeac at 3pm and returning at midnight. Price: ?45/person, including meal. Approved vehicles only. Info & registration on 07 67 76 28 58."
    ],
    "it": [
      "Il Val D'Allier Quad Club organizza un giro semi-notturno di 120 km con partenza da Langeac alle 15.00 e ritorno a mezzanotte. Prezzo: 45 euro a persona, pasto incluso. Solo veicoli omologati. Informazioni e iscrizioni al numero 07 67 76 28 58."
    ],
    "fr": [
      "Le club Val D'Allier Quad organise une rando semi-nocturne de 120km au départ de Langeac à 15h et retour à minuit. Tarif à 45€/personne avec repas compris. Véhicules homologués seulement. Infos & inscription au 07 67 76 28 58."
    ],
    "es": [
      "El Quad Club Val D'Allier organiza un recorrido semi nocturno de 120 km con salida en Langeac a las 15 h y regreso a medianoche. Precio: 45 euros por persona, comida incluida. Sólo vehículos homologados. Información e inscripciones en el 07 67 76 28 58."
    ],
    "nl": [
      "De Val D'Allier Quad Club organiseert een nachtrit van 120 km die om 15.00 uur in Langeac begint en om middernacht terugkeert. Prijs: 45 euro per persoon, inclusief maaltijd. Alleen goedgekeurde voertuigen. Informatie en inschrijving op 07 67 76 28 58."
    ]
  },
