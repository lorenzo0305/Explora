  "rdfs:comment": {
    "de": [
      "Die ganzheitliche Therapeutin Audrey ANAFATRA bietet in ihrer Praxis Sophrologie, Klangtherapie, sanfte Befreiungs- und Harmonisierungspraktiken mit individueller Begleitung oder Gruppenveranstaltungen in Präsenzform oder online an."
    ],
    "en": [
      "In her practice, holistic therapist Audrey ANAFATRA offers sophrology, sonotherapy, gentle practices of liberation and harmonization, with individual accompaniment or group events, both face-to-face and online."
    ],
    "it": [
      "Nel suo studio, la terapeuta olistica Audrey ANAFATRA offre sofrologia, sonoterapia, pratiche dolci di liberazione e armonizzazione, nonché coaching individuale ed eventi di gruppo, sia faccia a faccia che online."
    ],
    "fr": [
      "La thérapeute holistique Audrey ANAFATRA propose dans son cabinet, de la sophrologie, de la sonothérapie, des pratiques douces de libération et d’harmonisation avec des accompagnements individuels, ou des événements collectifs en présentiels et en ligne."
    ],
    "nl": [
      "In haar praktijk biedt holistisch therapeute Audrey ANAFATRA sofrologie, sonotherapie, zachte praktijken van bevrijding en harmonisatie, evenals individuele coaching en groepsevenementen, zowel face-to-face als online."
    ],
    "es": [
      "En su consulta, la terapeuta holística Audrey ANAFATRA ofrece sofrología, sonoterapia, prácticas suaves de liberación y armonización, así como coaching individual y eventos en grupo, tanto presenciales como en línea."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Audrey ANAFATRA | Thérapeute holistique"
    ]
  },
