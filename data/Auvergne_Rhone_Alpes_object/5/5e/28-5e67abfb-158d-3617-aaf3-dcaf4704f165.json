  "rdfs:comment": {
    "de": [
      "Herzlicher Empfang, traditionelle Küche. Service von 12 Uhr bis 14 Uhr. Abends geschlossen, außer für Gruppen.\nFormel: Vorspeise + Hauptgericht oder Hauptgericht + Dessert oder komplette Formel."
    ],
    "en": [
      "Warm welcome, traditional cuisine. Service from 12pm to 2pm. Closed in the evening except for groups.\nFormula : starter + main course or main course + dessert or complete formula."
    ],
    "it": [
      "Accoglienza calorosa, cucina tradizionale. Servizio dalle 12:00 alle 14:00. Chiuso la sera, tranne che per i gruppi.\nFormule: antipasto + piatto principale o piatto principale + dessert o formula completa."
    ],
    "fr": [
      "Accueil chaleureux, cuisine traditionnelle. Service de 12h à 14h. Fermé le soir sauf pour les groupes.\nFormule : entrée + plat ou plat + dessert ou formule complète."
    ],
    "nl": [
      "Warm onthaal, traditionele keuken. Dienst van 12 tot 14 uur. S Avonds gesloten, behalve voor groepen.\nFormules: voorgerecht + hoofdgerecht of hoofdgerecht + dessert of volledige formule."
    ],
    "es": [
      "Cálida acogida, cocina tradicional. Servicio de 12.00 a 14.00 horas. Cerrado por la noche excepto para grupos.\nFórmulas: entrante + plato principal o plato principal + postre o fórmula completa."
    ]
  },
