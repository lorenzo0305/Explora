  "rdfs:comment": {
    "de": [
      "Mit seinem Saal mit 339 Sitzplätzen und einer Bühne von nationalem Interesse für Kunst und Kreation bietet das seit 1895 bestehende Theater von Cusset eine große Vielfalt an Aufführungen und Konferenzen."
    ],
    "en": [
      "With its 339-seat hall and a stage of national interest in art and creation, the Théâtre de Cusset, which has been present since 1895, offers a wide variety of shows and conferences."
    ],
    "it": [
      "Con la sua sala da 339 posti e un palcoscenico di interesse nazionale in termini di arte e creazione, il teatro di Cusset, che esiste dal 1895, offre un'ampia varietà di spettacoli e conferenze."
    ],
    "fr": [
      "Avec sa salle de 339 places assises et une scène d'intérêt national en matière d'art et de création, le théâtre de Cusset présent depuis 1895, propose une grande diversité de spectacles et de conférences."
    ],
    "nl": [
      "Met zijn 339 zitplaatsen en een podium van nationaal belang op het gebied van kunst en creatie biedt het theater van Cusset, dat sinds 1895 bestaat, een grote verscheidenheid aan voorstellingen en conferenties."
    ],
    "es": [
      "Con su auditorio de 339 plazas y un escenario de interés nacional en términos de arte y creación, el teatro de Cusset, que existe desde 1895, ofrece una gran variedad de espectáculos y conferencias."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Théâtre de Cusset"
    ]
  },
