  "rdfs:comment": {
    "de": [
      "Vier Forts und eine Schanze schützen Savoyen: ein Leckerbissen für Liebhaber des Festungserbes.\r\nDie Forts stehen unter Denkmalschutz und sind nach den Vornamen der königlichen Familie von Piemont-Sardinien benannt."
    ],
    "en": [
      "Four forts and a redoubt protecting Savoie: a treat for lovers of fortified heritage.\r\nListed as Historic Monuments, the forts are named after the royal family of Piedmont-Sardinia."
    ],
    "it": [
      "Quattro forti e una ridotta a protezione della Savoia: una chicca per gli amanti del patrimonio fortificato.\r\nClassificati come Monumenti Storici, i forti portano il nome della famiglia reale del Piemonte-Sardegna."
    ],
    "fr": [
      "Quatre forts et une redoute protégeant la Savoie : un régal pour les amateurs de patrimoine fortifié.\r\nClassés Monuments Historiques, les forts portent les prénoms de la famille royale de Piémont-Sardaigne."
    ],
    "nl": [
      "Vier forten en een redoute die de Savoie beschermen: een traktatie voor liefhebbers van versterkt erfgoed.\r\nDe forten staan op de lijst van historische monumenten en zijn vernoemd naar de koninklijke familie van Piemonte-Sardinië."
    ],
    "es": [
      "Cuatro fuertes y un reducto protegen Saboya: un regalo para los amantes del patrimonio fortificado.\r\nCatalogados como Monumentos Históricos, los fuertes llevan el nombre de la familia real de Piamonte-Cerdeña."
    ]
  },
