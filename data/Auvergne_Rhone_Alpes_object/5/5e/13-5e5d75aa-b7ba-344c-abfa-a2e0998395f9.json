  "rdfs:comment": {
    "de": [
      "Das Chalet du Plan Bois ist ein hochgelegener regionaler Tisch mit intimer Atmosphäre. Es befindet sich in der Montagnette de Plan Bois, einem Ort der Natur und der Ruhe, der Kulisse für ein seltenes Erlebnis auf den Punkt gebracht."
    ],
    "en": [
      "The Chalet du Plan Bois is an intimate, high-altitude terroir restaurant. It's located in the Plan Bois mountain range, a place of nature and tranquillity, the backdrop to a rare experience."
    ],
    "it": [
      "Lo Chalet du Plan Bois è un intimo ristorante di montagna. Si trova nella catena montuosa del Plan Bois, un luogo di natura e tranquillità che fa da sfondo a un'esperienza rara."
    ],
    "fr": [
      "Le chalet du Plan Bois est une table de terroir d'altitude à l'esprit intimiste. Il est situé dans la montagnette de Plan Bois, lieu de pleine nature, de tranquillité, le décor d'une expérience rare aux petits oignons."
    ],
    "nl": [
      "Het Chalet du Plan Bois is een intiem bergrestaurant. Het is gelegen in de Plan Bois bergketen, een plek van natuur en rust, de achtergrond voor een zeldzame ervaring."
    ],
    "es": [
      "El Chalet du Plan Bois es un íntimo restaurante de montaña. Está situado en la cordillera del Plan Bois, un lugar de naturaleza y tranquilidad, telón de fondo de una experiencia poco común."
    ]
  },
  "rdfs:label": {
