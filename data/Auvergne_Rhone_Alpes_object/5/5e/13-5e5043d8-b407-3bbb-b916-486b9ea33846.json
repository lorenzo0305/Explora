  "rdfs:comment": {
    "de": [
      "Der Küchenchef Hiroyuki Watanabe lädt Sie unter der Schirmherrschaft von Christian Têtedoie ein durch die Aromen seiner bistronomischen Küche in einem sachlichen Dekor zu reisen."
    ],
    "en": [
      "The chef Hiroyuki Watanabe, one of Christian Têtedoie's protégés, invites diners on a journey with his bistronomic cuisine, in an understated and elegant setting."
    ],
    "it": [
      "Lo Chef Hiroyuki Watanabe, presentato da Christian Têtedoie, ti invita a viaggiare attraverso i sapori della sua cucina «bistronomica» avvolto da una sobria decorazione."
    ],
    "fr": [
      "Le Chef Hiroyuki Watanabe, parrainé par Christian Têtedoie, vous invite à voyager à travers les saveurs de sa cuisine bistronomique dans un décor sobre."
    ],
    "es": [
      "El chef Hiroyuki Watanabe, apadrinado por Christian Têtedoie, le invita a viajar por los sabores de su cocina bistronómica en un ambiente sobrio."
    ],
    "nl": [
      "Chef Hiroyuki Watanabe, gesponsord door Christian Têtedoie, nodigt u uit om in een sober decor door de smaken van zijn bistronomische keuken te reizen."
    ]
  },
