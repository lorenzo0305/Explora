  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/57534967-204f-3a9e-9fc9-23ac708b59d8",
      "dc:description": {
        "de": [
          "Informationen :\n\nÖffnungstage:\n\nMontag bis Freitag von 8:30 bis 12:15 Uhr und von 14:00 bis 19:00 Uhr\n\nSamstag von 8:30 bis 12:15 Uhr und von 14:00 bis 17:00 Uhr\n \n Abholung :\n\nZu den Öffnungszeiten der Apotheke\n\n "
        ],
        "en": [
          "Information :\n\nOpening days:\n\nMonday to Friday, 8:30am to 12:15pm and 2pm to 7pm\n\nSaturday 8.30am to 12.15pm and 2pm to 5pm\n \n Pick-up :\n\nDuring pharmacy opening hours\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura:\n\nDal lunedì al venerdì, dalle 8.30 alle 12.15 e dalle 14.00 alle 19.00\n\nSabato dalle 8.30 alle 12.15 e dalle 14.00 alle 17.00\n \n Ritiro:\n\nDurante gli orari di apertura della farmacia\n\n "
        ],
        "fr": [
          "Informations :\n\nJours d'ouverture:\n\nDu lundi au vendredi de 8h30 à 12h15 et de 14h00 à 19h00\n\nSamedi de 8h30 à 12h15 et de 14h00 à 17h00\n \n Retrait :\n\nAux horaires d'ouverture de la pharmacie\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen:\n\nMaandag tot vrijdag van 8u30 tot 12u15 en van 14u tot 19u\n\nZaterdag van 8.30 tot 12.15 uur en van 14.00 tot 17.00 uur\n \n Ophalen:\n\nTijdens openingstijden van de apotheek\n\n "
        ],
        "es": [
          "Más información :\n\nDías de apertura:\n\nDe lunes a viernes, de 8.30 a 12.15 y de 14.00 a 19.00 h\n\nSábados de 8.30 a 12.15 y de 14.00 a 17.00 horas\n \n Recogida:\n\nDurante el horario de apertura de la farmacia\n\n "
        ]
      },
