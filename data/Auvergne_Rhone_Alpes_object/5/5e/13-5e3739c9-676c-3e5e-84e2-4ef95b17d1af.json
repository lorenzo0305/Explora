  "rdfs:comment": {
    "de": [
      "Entdecken Sie ein authentisches kulinarisches Erlebnis, bei dem jedes Gericht sorgfältig aus frischen und hochwertigen Produkten zubereitet wird, die vollständig hausgemacht sind. Wir bieten Ihnen eine große Auswahl an thailändischen Spezialitäten."
    ],
    "en": [
      "Discover an authentic culinary experience, where every dish is prepared with care from fresh, quality ingredients, entirely homemade. We offer a wide selection of Thai specialties."
    ],
    "it": [
      "Scoprite un'esperienza culinaria autentica, dove ogni piatto è preparato con cura utilizzando ingredienti freschi e di qualità ed è interamente fatto in casa. Offriamo un'ampia selezione di specialità thailandesi."
    ],
    "fr": [
      "Découvrez une expérience culinaire authentique, où chaque plat est préparé avec soin à partir de produits frais et de qualité, entièrement fait maison. Nous vous proposons une large sélection de spécialités thaïlandaises."
    ],
    "nl": [
      "Ontdek een authentieke culinaire ervaring, waar elk gerecht met zorg wordt bereid met verse ingrediënten van hoge kwaliteit en volledig huisgemaakt is. We bieden een ruime keuze aan Thaise specialiteiten."
    ],
    "es": [
      "Descubra una auténtica experiencia culinaria, donde cada plato se prepara con esmero utilizando ingredientes frescos y de calidad y es totalmente casero. Ofrecemos una amplia selección de especialidades tailandesas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Rak Thai traiteur thaïlandais"
    ]
  },
