  "rdfs:comment": {
    "de": [
      "Der Bauernhof Clos Doré bietet vor Ort verarbeitetes Mehl und Öl, Gemüse und andere Bioprodukte, Black Angus-Rindfleisch und Selbstpflücker zum Verkauf an.\r\nFinden Sie auch Getreide für den Hinterhof und Vögel."
    ],
    "en": [
      "La ferme du Clos Doré sells flours and oils processed on site, vegetables and other organic produce, Black Angus beef and U-pick. \r\nYou'll also find cereals for poultry and birds."
    ],
    "it": [
      "L'azienda agricola Clos Doré vende farina e olio lavorati in loco, ortaggi e altri prodotti biologici, manzo Black Angus e prodotti da raccolta.\r\nTroverete anche cereali per pollame e uccelli."
    ],
    "fr": [
      "La ferme du Clos Doré propose à la vente des farines et huiles transformées sur place, des légumes et autres produits bio, du bœuf Black Angus et la cueillette libre. \r\nRetrouvez aussi les céréales pour la basse-cour et les oiseaux."
    ],
    "es": [
      "La granja Clos Doré vende harina y aceite procesados in situ, verduras y otros productos ecológicos, carne de buey Black Angus y U-pick.\r\nTambién encontrará cereales para aves de corral y pájaros."
    ],
    "nl": [
      "De boerderij Clos Doré verkoopt ter plekke verwerkt meel en olie, groenten en andere biologische producten, Black Angus rundvlees en U-pick.\r\nJe vindt er ook granen voor pluimvee en vogels."
    ]
  },
  "rdfs:label": {
