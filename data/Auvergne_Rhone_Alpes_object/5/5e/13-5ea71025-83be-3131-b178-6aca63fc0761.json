  "rdfs:comment": {
    "de": [
      "Habitat Design gestaltet harmonische und individuelle Räume: von der Raumplanung über Möbeldesign und -herstellung bis hin zur Ausstattung. Von der Innenarchitektur bis zur kompletten Gestaltung Ihres Wohnraums – ganz nach Ihren Wünschen."
    ],
    "en": [
      "Habitat Design creates harmonious and bespoke spaces: layout plans, furniture design and manufacturing, and fittings. From interior design to the complete creation of your living space, according to your tastes."
    ],
    "it": [
      "Habitat Design crea spazi armoniosi e su misura: progettazione, design e produzione di mobili e arredi. Dalla progettazione degli interni alla creazione completa del vostro spazio abitativo, secondo i vostri gusti."
    ],
    "fr": [
      "Habitat Design crée des espaces harmonieux et sur mesure : plans d’agencement, conception et fabrication de meubles et aménagements. Du design intérieur à la création complète de votre lieu de vie, selon vos goûts."
    ],
    "es": [
      "Habitat Design crea espacios armoniosos a medida: planos de distribución, diseño y fabricación de muebles y accesorios. Desde el diseño de interiores hasta la creación completa de su espacio vital, según sus gustos."
    ],
    "nl": [
      "Habitat Design creëert harmonieuze ruimtes op maat: inrichtingsplannen, ontwerp en productie van meubilair en inrichting. Van interieurontwerp tot de volledige creatie van uw leefruimte, volgens uw smaak."
    ]
  },
