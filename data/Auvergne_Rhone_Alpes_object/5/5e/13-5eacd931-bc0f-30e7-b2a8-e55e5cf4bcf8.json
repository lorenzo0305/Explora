  "rdfs:comment": {
    "de": [
      "LA VERTUEUSE FEIERT SEINEN 10. GEBURTSTAG! Bereiten Sie sich auf einen festlichen und geselligen Tag rund um einen JAMBON à LA BROCHE vor, in einer warmen und leckeren Atmosphäre! Musik, Party und Leckereien. Reservieren Sie jetzt online Ihren Platz für LE BANQUET!"
    ],
    "en": [
      "LA VERTUEUSE CELEBRATES ITS 10TH ANNIVERSARY! Get ready for a festive and convivial day of JAMBON À LA BROCHE, in a warm and gourmet atmosphere! Music, festivities and gourmet delights. Reserve your place online now for LE BANQUET!"
    ],
    "it": [
      "LA VERTUEUSE FESTEGGIA IL SUO 10° ANNIVERSARIO! Preparatevi a una giornata di festa e convivialità attorno a un JAMBON À LA BROCHE, in un'atmosfera calda e gastronomica! Musica, festeggiamenti e delizie gastronomiche. Prenotate subito il vostro posto online per LE BANQUET!"
    ],
    "fr": [
      "LA VERTUEUSE FÊTE SES 10 ANS ! Préparez-vous pour une journée festive et conviviale autour d’un JAMBON À LA BROCHE, dans une ambiance chaleureuse et gourmande ! Musique, fête et gourmandise. Réservez dès maintenant votre place en ligne pour LE BANQUET !"
    ],
    "es": [
      "¡LA VERTUEUSE CELEBRA SU 10º ANIVERSARIO! Prepárese para una jornada festiva y de convivencia en torno a un JAMBON À LA BROCHE, en un ambiente cálido y gastronómico Música, fiesta y delicias gastronómicas. ¡Reserve ya su plaza en línea para LE BANQUET!"
    ],
    "nl": [
      "LA VERTUEUSE VIERT ZIJN 10E VERJAARDAG! Bereid je voor op een feestelijke en gezellige dag rond een JAMBON À LA BROCHE, in een warme en gastronomische sfeer! Muziek, feestelijkheden en gastronomische lekkernijen. Reserveer nu uw plaats online voor LE BANQUET!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Banquet de la Vertueuse"
    ]
  },
