  "rdfs:comment": {
    "de": [
      "Entdecken Sie an den Tagen des Kulturerbes, wie viel Spaß es macht, seine eigene Pizza zu backen, und natürlich können Sie Ihre Pizza im Garten des Hauses genießen."
    ],
    "en": [
      "For Heritage Days, discover the pleasure of making your own pizza, and of course enjoy your pizza in the Maison's garden."
    ],
    "it": [
      "Per le Giornate del Patrimonio, scoprite il piacere di preparare la vostra pizza e, naturalmente, di gustarla nel giardino della Maison."
    ],
    "fr": [
      "Pour les journées du Patrimoine, découvrez le plaisir de fabriquer sa pizza, et bien sur déguster votre pizza dans le jardin de la Maison."
    ],
    "es": [
      "Para las Jornadas del Patrimonio, descubra el placer de hacer su propia pizza y, por supuesto, disfrute de su pizza en el jardín de la Maison."
    ],
    "nl": [
      "Ontdek tijdens de Open Monumentendagen hoe leuk het is om je eigen pizza te maken, en geniet natuurlijk van je pizza in de tuin van het Maison."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Dégustation : Pizza au four à pain"
    ]
  },
