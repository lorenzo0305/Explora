  "rdfs:comment": {
    "de": [
      "Das L'ourson bietet eine festliche und bergische Atmosphäre, die perfekt ist, um einen Moment der Entspannung mit der Familie, mit Freunden oder nach einem Tag auf der Skipiste zu genießen. Es gibt eine Bar/Restaurant und eine Terrasse mit Blick auf Les Mémises und den Genfersee."
    ],
    "en": [
      "L'ourson offers a festive, mountain atmosphere, perfect for relaxing with family and friends, or after a day on the slopes. There's a bar/restaurant and a terrace overlooking the Mémises and Lake Geneva."
    ],
    "it": [
      "L'Ourson offre un'atmosfera festosa e montana, perfetta per rilassarsi con la famiglia e gli amici o dopo una giornata sulle piste. C'è un bar/ristorante e una terrazza con vista sulle Mémises e sul Lago di Ginevra."
    ],
    "fr": [
      "L'ourson offre une ambiance festive et montagnarde, parfaite pour profiter d’un moment de détente en famille, entre amis ou après une journée de ski. On y trouve un bar/restaurant et une terrasse  avec vue sur les Mémises et le lac Léman."
    ],
    "es": [
      "L'ourson tiene un ambiente festivo y montañés, perfecto para relajarse con la familia y los amigos o después de un día en las pistas. Hay un bar/restaurante y una terraza con vistas a las Mémises y al lago Lemán."
    ],
    "nl": [
      "L'ourson heeft een feestelijke, bergachtige sfeer, perfect om te ontspannen met familie en vrienden of na een dag op de piste. Er is een bar/restaurant en een terras met uitzicht op de Mémises en het meer van Genève."
    ]
  },
  "rdfs:label": {
    "en": [
      "Bar - Restaurant l'Ourson"
    ],
