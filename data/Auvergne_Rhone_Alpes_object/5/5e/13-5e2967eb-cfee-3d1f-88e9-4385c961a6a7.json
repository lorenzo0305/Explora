  "rdfs:comment": {
    "de": [
      "Kein Grund zur Aufregung? Lassen Sie sich nicht täuschen. Dieser Rundweg, der durch den gesamten Zirkus oberhalb von Vaudevant führt, ist trotz seiner geringen Entfernung nicht uninteressant."
    ],
    "en": [
      "What's the big deal? Think again. This circuit, which covers the entire cirque above Vaudevant, is not lacking in interest despite its short distance."
    ],
    "it": [
      "Non c'è nulla per cui agitarsi? Ripensateci. Questo circuito, che copre l'intero circo sopra Vaudevant, non manca di interesse nonostante la sua breve distanza."
    ],
    "fr": [
      "Pas de quoi en faire tout un fromage ? Détrompez vous. Ce circuit, qui parcourt tout le cirque au dessus de Vaudevant, ne manque pas d'intérêt malgré sa faible distance."
    ],
    "es": [
      "¿Nada de qué preocuparse? Piénselo otra vez. Este circuito, que recorre todo el circo por encima de Vaudevant, no carece de interés a pesar de su corta distancia."
    ],
    "nl": [
      "Niets om je druk over te maken? Denk nog maar eens na. Dit circuit, dat het hele keteldal boven Vaudevant beslaat, is ondanks de korte afstand niet oninteressant."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La tomme en salade"
    ]
  },
