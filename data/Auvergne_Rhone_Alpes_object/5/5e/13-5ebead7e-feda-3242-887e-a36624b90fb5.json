  "rdfs:comment": {
    "de": [
      "La Toscane ist ein italienisches Restaurant in der Nähe des Stadtzentrums. Sie können hier die verschiedensten Pizzas, Nudelgerichte und andere italienische Spezialitäten in einem behaglichen und intimen Rahmen geniessen."
    ],
    "en": [
      "Situated close to the town centre, la Toscane is an Italian restaurant where you can chose between all sorts of pizzas, pasta and\r\nItalian specialities in a warm and cosy atmosphere"
    ],
    "it": [
      "Situato vicino al centro della città, il Tuscany è un ristorante italiano dove si possono gustare tutti i tipi di pizza, pasta e specialità italiane in un ambiente caldo e intimo."
    ],
    "fr": [
      "Situé proche du centre ville, la Toscane est un restaurant italien où vous pourrez déguster toutes sortes de pizzas, de pâtes et de spécialités italiennes dans un cadre intime et chaleureux."
    ],
    "es": [
      "Ubicado cerca del centro, La Toscane es un restaurante italiano donde podrá degustar todo tipo de pizzas, pastas y especialidades italianas en un marco íntimo y acogedor."
    ],
    "nl": [
      "Het  Italiaanse  restaurant Toscane bevindt zich vlakbij het stadcentrum, hier serveren zij in een warm en intiem kader allerlei soorten pizzas, pasta, en andere lekkere italiaanse specialiteiten."
    ]
  },
