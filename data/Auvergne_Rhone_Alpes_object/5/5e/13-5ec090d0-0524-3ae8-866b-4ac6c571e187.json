  "rdfs:comment": {
    "de": [
      "Handgefertigter Silber- und Makramee-Schmuck mit Natursteinen. Schmuckreparaturen (Gold, Silber). Workshop zur Herstellung von Silberschmuck oder Makramee-Kreationen (Anmeldung erforderlich)."
    ],
    "en": [
      "Handcrafted silver and macrame jewelry with natural stones. Jewelry repair (gold, silver). Workshop for silver jewelry making or macrame creations (reservation required)."
    ],
    "it": [
      "Creazione artigianale di gioielli in argento e macramè con pietre naturali. Riparazioni di gioielli (oro, argento). Laboratorio aperto a tutti per corsi di creazione di gioielli in argento o creazioni in macramè (su prenotazione)."
    ],
    "fr": [
      "Création artisanale de bijoux en argent et macramé avec pierres naturelles. Réparation de bijoux (or, argent). Atelier ouvert à tous pour des stages de création de bijoux en argent ou des créations en macramé (sur réservation)."
    ],
    "nl": [
      "Handgemaakte zilveren en macramé sieraden met natuurstenen. Sieradenreparatie (goud, zilver). Workshop voor het maken van zilveren sieraden of macramé creaties (reserveren verplicht)."
    ],
    "es": [
      "Creación artesanal de joyas de plata y macramé con piedras naturales. Reparación de joyas (oro, plata). Taller abierto a todos para cursos de creación de joyas en plata o creaciones en macramé (previa reserva)."
    ]
  },
  "rdfs:label": {
