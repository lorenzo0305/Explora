  "rdfs:comment": {
    "de": [
      "Willkommen in Caron 3200, einem außergewöhnlichen Ort auf dem mythischen Gipfel der Cime Caron, im Herzen der 3 Vallées, zwischen Orelle und Val Thorens.\r\nTauchen Sie ein in eine einzigartige Erfahrung, in der die Flucht den Gipfeln nahekommt."
    ],
    "en": [
      "Welcome to Caron 3200, an exceptional place perched at the legendary summit of Cime Caron, in the heart of the 3 Valleys, between Orelle and Val Thorens.\r\nImmerse yourself in a unique experience where escape reaches the peaks. Here, gastronomy, conviviality and unforgettable moments intertwine in a breathtaking setting."
    ],
    "it": [
      "Benvenuti a Caron 3200, un luogo eccezionale arroccato sulla leggendaria vetta delle Cime Caron, nel cuore delle 3 Valli, tra Orelle e Val Thorens.\r\nImmergiti in un'esperienza unica dove l'evasione è vicina alle vette."
    ],
    "fr": [
      "Bienvenue à Caron 3200, un lieu d’exception perché au sommet mythique de la Cime Caron, au cœur des 3 Vallées, entre Orelle et Val Thorens.\r\nPlongez dans une expérience unique où l’évasion tutoie les cimes."
    ],
    "nl": [
      "Welkom in Caron 3200, een uitzonderlijk resort op de legendarische top van de Cime Caron, in het hart van de 3 Valleien, tussen Orelle en Val Thorens.\r\nDompel jezelf onder in een unieke ervaring waar ontsnappen en toppen elkaar ontmoeten."
    ],
    "es": [
      "Bienvenido a Caron 3200, una estación excepcional encaramada en la legendaria cumbre de Cime Caron, en el corazón de los 3 Valles, entre Orelle y Val Thorens.\r\nSumérjase en una experiencia única donde la evasión se encuentra con las cumbres."
    ]
  },
  "rdfs:label": {
