  "rdfs:comment": {
    "de": [
      "Genießen Sie einen komfortablen, klimatisierten und mit 3D ausgestatteten Saal mit 160 Sitzplätzen. Das Kino in Morestel bietet fast 200 Filme und 800 Vorstellungen pro Jahr."
    ],
    "en": [
      "Revamped this year and fitted with air-conditioning and 3D technology, the 160-seat cinema of Morestel invites you to get comfortable and enjoy one of the 200 films shown in our 800 yearly screenings."
    ],
    "it": [
      "Venite a godervi un cinema confortevole, climatizzato e dotato di 3D, con 160 posti a sedere. Il cinema Morestel offre quasi 200 film e 800 proiezioni all'anno."
    ],
    "fr": [
      "Venez profiter d'une salle tout confort, climatisée et équipée de la 3D, comptant 160 places assises. Le cinéma de Morestel propose près de 200 films et 800 séances par an."
    ],
    "es": [
      "Venga a disfrutar de una sala de cine confortable, climatizada y equipada con 3D, con 160 butacas. El cine Morestel ofrece cerca de 200 películas y 800 proyecciones al año."
    ],
    "nl": [
      "Kom genieten van een comfortabele bioscoop met airconditioning en 3D, met 160 zitplaatsen. De Morestel-bioscoop biedt bijna 200 films en 800 voorstellingen per jaar."
    ]
  },
  "rdfs:label": {
