  "rdfs:comment": {
    "de": [
      "Entdecken Sie die geheimen Gärten des Schlosses Chavaniac-Lafayette... Der Rosengarten, der unterhalb des Ehrenhofs liegt, bietet einen bemerkenswerten Blick auf das Schloss und den gesamten Park.\r\nMit dem Label \"Jardin Remarquable\" (bemerkenswerter Garten) ausgezeichnet."
    ],
    "en": [
      "Discover the secret gardens of Château de Chavaniac-Lafayette... La Roseraie, set below the main courtyard, offers a remarkable view of the château and the park as a whole.\r\nLabelled Jardin Remarquable."
    ],
    "it": [
      "Scoprite i giardini segreti del Castello di Chavaniac-Lafayette... Il Giardino delle Rose, situato sotto il cortile principale, offre una vista straordinaria sul castello e sull'intero parco.\r\nÈ stato insignito del marchio Jardin Remarquable."
    ],
    "fr": [
      "À la découverte des jardins secrets du château de Chavaniac-Lafayette... La Roseraie, implantée en contre-bas de la cour d’honneur, offre un point de vue remarquable sur le château et sur l’ensemble du Parc. \r\nLabellisé Jardin Remarquable."
    ],
    "nl": [
      "Ontdek de geheime tuinen van het Château de Chavaniac-Lafayette... De Rozentuin ligt onder de binnenplaats en biedt een prachtig uitzicht op het kasteel en het park.\r\nHij heeft het label Jardin Remarquable gekregen."
    ],
    "es": [
      "Descubra los jardines secretos del castillo de Chavaniac-Lafayette... La Rosaleda, situada bajo el patio principal, ofrece una vista excepcional del castillo y del parque en su conjunto.\r\nHa sido galardonado con el sello Jardin Remarquable."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Jardin du Château de Chavaniac-Lafayette"
    ]
  },
