  "rdfs:comment": {
    "de": [
      "Start von La Croisette in Les Menuires. Dieser flüssige und abwechslungsreiche Weg führt über Lichtungen und bietet einen zugänglichen und angenehmen Ausflug."
    ],
    "en": [
      "Starting from La Croisette in Les Menuires, this smooth and varied trail crosses open clearings, making for an accessible and enjoyable outing."
    ],
    "it": [
      "Partendo da La Croisette a Les Menuires, questo percorso fluido e vario attraversa radure e offre un'escursione accessibile e piacevole."
    ],
    "fr": [
      "Départ depuis La Croisette aux Menuires, ce sentier fluide et varié traverse des clairières, offrant une sortie accessible et agréable."
    ],
    "es": [
      "Partiendo de La Croisette en Les Menuires, este sendero fluido y variado atraviesa claros, ofreciendo una excursión accesible y agradable."
    ],
    "nl": [
      "Dit vloeiende en gevarieerde pad vertrekt vanuit La Croisette in Les Menuires en loopt door open vlaktes en biedt een toegankelijke en aangename tocht."
    ]
  },
