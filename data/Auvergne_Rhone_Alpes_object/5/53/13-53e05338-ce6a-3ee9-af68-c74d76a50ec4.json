  "rdfs:comment": {
    "de": [
      "Saint-Germain-Laval erhebt sich über dem Fluss Aix, einem Nebenfluss der Loire, auf einem Hügel gegenüber der Plaine du Forez. Es gibt malerische Gassen, verschiedene charakteristische Bauwerke und schöne Häuser aus dem 14. bis 16."
    ],
    "en": [
      "Saint-Germain-Laval rises above the River Aix, a tributary of the Loire, on a hill facing the Plaine du Forez. Admire the picturesque narrow streets, characterful monuments and fine 14th to 16th century residences."
    ],
    "it": [
      "Saint-Germain-Laval sorge sopra il fiume Aix, affluente della Loira, su una collina che si affaccia sulla pianura del Forez. Ammirate le pittoresche stradine, i numerosi monumenti caratteristici e le belle residenze del XIV-XVI secolo."
    ],
    "fr": [
      "Saint-Germain-Laval se dresse au-dessus de la rivière de l'Aix, affluent sur la Loire, sur une colline qui fait face à la Plaine du Forez. Ruelles pittoresques, divers monuments de caractère et belles demeures du 14ème au 16ème siècle sont à admirer."
    ],
    "nl": [
      "Saint-Germain-Laval verheft zich boven de rivier de Aix, een zijrivier van de Loire, op een heuvel die uitkijkt op de vlakte van de Forez. Bewonder de pittoreske smalle straatjes, de vele karakteristieke monumenten en de mooie 14e tot 16e-eeuwse residenties."
    ],
    "es": [
      "Saint-Germain-Laval se alza sobre el río Aix, afluente del Loira, en una colina frente a la llanura de Forez. Admire las pintorescas callejuelas, los numerosos monumentos con carácter y las bellas residencias de los siglos XIV a XVI."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Village de Saint-Germain-Laval"
    ]
  },
