  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/5f04d614-2a2b-311f-9071-cc3e2420812a",
      "dc:description": {
        "de": [
          "Lernen Sie die Archäologie in Lens-Liévin kennen\nDie Archäologie ist eine Disziplin, die sich mit der Erforschung alter Zivilisationen anhand der vom Menschen hinterlassenen Überreste befasst."
        ],
        "en": [
          "Learn about archaeology in the Lens-Liévin area\nArchaeology is a discipline that allows the study of ancient civilizations from the remains left by man."
        ],
        "it": [
          "Conoscere l'archeologia nell'area di Lens-Liévin\nL'archeologia è lo studio delle civiltà antiche basato sui resti lasciati dall'uomo."
        ],
        "fr": [
          "Initiez-vous à l’archéologie sur le territoire de Lens-Liévin \nL’archéologie est une discipline qui permet l’étude des civilisations anciennes à partir des vestiges laissés par l’homme."
        ],
        "nl": [
          "Leer meer over archeologie in de regio Lens-Liévin\nArcheologie is de studie van oude beschavingen op basis van de overblijfselen die de mens heeft achtergelaten."
        ],
        "es": [
          "Conozca la arqueología en la región de Lens-Liévin\nLa arqueología es el estudio de las civilizaciones antiguas a partir de los vestigios dejados por el hombre."
        ]
      },
