  "rdfs:comment": {
    "de": [
      "Seit 2006 ist Carnet des Alpes ein Reiseveranstalter und Empfänger im Dienste von Unternehmen und Gruppen. Unser Team besteht aus Fachleuten mit komplementären Kompetenzen: Berge, Sport, Eventmanagement und Geschäftstourismus."
    ],
    "en": [
      "Since 2006, Carnet des Alpes has been an incoming agency and a Tour Operator serving companies and groups.\r\nOur team is made up of professionals with complementary skills: mountain, sport, event management and business tourism."
    ],
    "it": [
      "Dal 2006, Carnet des Alpes è un Tour Operator e un agente di incoming per aziende e gruppi. Il nostro team è composto da professionisti con competenze complementari in montagna, sport, gestione di eventi e turismo d'affari."
    ],
    "fr": [
      "Depuis 2006, Carnet des Alpes est un Tour Opérator et réceptif au service des entreprises et des groupes. Notre équipe est constituée de professionnels aux compétences complémentaires : montagne, sport, management d’événements et tourisme d’affaires."
    ],
    "nl": [
      "Sinds 2006 is Carnet des Alpes een Tour Operator en incoming agent voor bedrijven en groepen. Ons team bestaat uit professionals met aanvullende vaardigheden in de bergen, sport, event management en zakelijk toerisme."
    ],
    "es": [
      "Desde 2006, Carnet des Alpes es turoperador y agente receptivo para empresas y grupos. Nuestro equipo está formado por profesionales con competencias complementarias en montaña, deporte, gestión de eventos y turismo de negocios."
    ]
  },
