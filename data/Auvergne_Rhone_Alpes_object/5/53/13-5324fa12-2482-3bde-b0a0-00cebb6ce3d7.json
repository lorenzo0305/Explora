  "rdfs:comment": {
    "de": [
      "Beginnen wir mit diesem Familienspaziergang, bei dem Sie das Dorf, seine Geschichte, seine Skulpturen und nicht zu vergessen seine Fresken kennenlernen."
    ],
    "en": [
      "Let's start with this family walk, which will introduce you to the village, its history, its sculptures, not forgetting its frescoes."
    ],
    "it": [
      "Iniziamo con questa passeggiata per famiglie, che vi farà scoprire il villaggio, la sua storia, le sue sculture, senza dimenticare i suoi affreschi."
    ],
    "fr": [
      "Commençons par cette balade familiale, qui vous fera découvrir le village, son histoire, ses sculptures, sans oublier ses fresques."
    ],
    "nl": [
      "Laten we beginnen met deze gezinswandeling, die u het dorp, zijn geschiedenis, zijn beeldhouwwerken en niet te vergeten zijn fresco's laat ontdekken."
    ],
    "es": [
      "Empecemos con este paseo familiar, que le hará descubrir el pueblo, su historia, sus esculturas, sin olvidar sus frescos."
    ]
  },
  "rdfs:label": {
    "en": [
