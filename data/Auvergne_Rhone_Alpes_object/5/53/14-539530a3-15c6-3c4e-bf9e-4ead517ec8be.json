  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/a3dd6b0a-8c95-3eb9-be35-ff5f948f5397",
      "dc:description": {
        "de": [
          "Auf dem Programm dieses Festivals stehen :\n- einen kulinarischen Wettbewerb\n- mehr als dreißig Händler, die sich den Berufen rund um den Korken widmen\n- essen Kabarettaufführung\n- messe für Kunsthandwerk und Know-how\n- mehr als dreißig Händler, die sich den handwerklichen Berufen widmen"
        ],
        "en": [
          "The festival program includes :\n- a culinary competition\n- more than thirty merchants dedicated to cork crafts\n- cabaret dinner and show\n- craft and know-how fair\n- more than thirty merchants dedicated to craft trades"
        ],
        "it": [
          "Il programma del festival comprende\n- un concorso culinario\n- più di trenta commercianti dedicati al commercio del sughero\n- pasti, spettacoli di cabaret\n- fiera dell'artigianato e del know-how\n- più di trenta commercianti dedicati all'artigianato"
        ],
        "fr": [
          "Au programme de ce festival, vous pourrez retrouver :\n- un concours culinaire\n- plus d'une trentaine de commerçants dédiés aux métiers au bouchon\n- repas spectacle cabaret\n- salon de l'artisanat et du savoir-faire\n- plus d'une trentaine commerçants dédiés aux métiers de l'artisanat"
        ],
        "nl": [
          "Het festivalprogramma omvat\n- een culinaire wedstrijd\n- meer dan dertig handelaars gewijd aan de kurkhandel\n- maaltijden, cabaretvoorstellingen\n- ambachts- en kennisbeurs\n- meer dan dertig ambachtelijke handelaars"
        ],
        "es": [
          "El programa del festival incluye\n- un concurso culinario\n- más de treinta comerciantes dedicados al comercio del corcho\n- comidas, espectáculos de cabaret\n- feria de artesanía y saber hacer\n- más de treinta comerciantes dedicados a la artesanía"
        ]
      },
      "@type": [
