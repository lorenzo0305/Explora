    "de": [
      "Das Restaurant La Tablée, bietet Ihnen täglich von Montag bis Freitag mittags im Speisesaal oder auf der Terrasse Speisen an.\r\nThemenabende."
    ],
    "en": [
      "Restaurant La Tablée offers daily lunchtime dining from Monday to Friday, in the dining room or on the terrace.\r\nTheme evenings."
    ],
    "it": [
