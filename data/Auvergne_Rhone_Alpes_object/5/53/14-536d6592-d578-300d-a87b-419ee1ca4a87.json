  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/4a12f9af-bbe6-3323-abde-b25ead6c9dae",
      "dc:description": {
        "de": [
          "Informationen :\n\nÖffnungstage:\n\nJeden Donnerstag von 15:00 bis 17:30 Uhr\n\n\nOrganisation :\nAbhaltung des Marktes unter Einhaltung der von der Regierung vorgeschriebenen Hygienevorschriften.\n\n- Halten Sie einen Abstand von 1m zwischen allen Personen ein\n- Bevorzugen Sie kontaktlose Zahlungen, wenn möglich\n\n\n\n "
        ],
        "en": [
          "Information :\n\nOpening days:\n\nEvery Thursday from 3pm to 5:30pm\n\n\nOrganization :\nMarket held in accordance with government hygiene regulations.\n\n- Respect a distance of 1m between each person\n- Use contactless payment whenever possible\n\n\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura:\n\nOgni giovedì dalle 15.00 alle 17.30\n\n\nOrganizzazione :\nIl mercato si svolge nel rispetto delle norme igieniche governative.\n\n- Rispettare una distanza di 1 m tra le persone\n- Usare il pagamento senza contatto quando possibile\n\n\n\n "
        ],
        "fr": [
          "Informations :\n\nJours d'ouverture: \n\nTous les jeudis de 15h à 17h30\n\n\nOrganisation : \nTenue du marché dans les règles d’hygiène imposées par le gouvernement.\n\n- Respecter une distance d'1m entre chaque personne \n- Privilégier le paiement sans contact quand cela est possible\n\n\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen:\n\nElke donderdag van 15u tot 17u30\n\n\nOrganisatie :\nMarkt gehouden in overeenstemming met de hygiënevoorschriften van de overheid.\n\n- Respecteer een afstand van 1m tussen elke persoon\n- Gebruik waar mogelijk contactloos betalen\n\n\n\n "
        ],
        "es": [
          "Más información :\n\nDías de apertura:\n\nTodos los jueves de 15:00 a 17:30\n\n\nOrganización :\nMercado organizado de acuerdo con las normas de higiene gubernamentales.\n\n- Respete una distancia de 1 m entre cada persona\n- Utilizar el pago sin contacto siempre que sea posible\n\n\n\n "
        ]
      },
