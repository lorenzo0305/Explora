  "rdfs:comment": {
    "de": [
      "Bietet natürliche Kreativ-Workshops für Unternehmen und Berufsgruppen an: Teambuilding rund um die Herstellung von ökologischen Kosmetika, Kerzen und Haushaltsprodukten, die den Teamzusammenhalt und das verantwortungsvolle Engagement fördern."
    ],
    "en": [
      "Offers creative and eco-friendly workshops for companies and professional groups: team building activities focused on making natural cosmetics, candles and household products, encouraging teamwork and sustainability."
    ],
    "it": [
      "Laboratori creativi naturali per aziende e gruppi professionali: team building intorno alla produzione di cosmetici, candele e prodotti per la casa ecologici, promuovendo la coesione del gruppo e l'impegno responsabile."
    ],
    "fr": [
      "Propose des ateliers créatifs naturels dédiés aux entreprises et groupes professionnels : team building autour de la fabrication de cosmétiques, bougies et produits ménagers écologiques, favorisant cohésion d’équipe et engagement responsable."
    ],
    "es": [
      "Talleres creativos naturales para empresas y grupos profesionales: creación de equipos en torno a la producción de cosméticos, velas y productos domésticos ecológicos, fomentando la cohesión de los equipos y el compromiso responsable."
    ],
    "nl": [
      "Natuurlijke creatieve workshops voor bedrijven en beroepsgroepen: teambuilding rond de productie van milieuvriendelijke cosmetica, kaarsen en huishoudelijke producten, bevordering van teamcohesie en verantwoord engagement."
    ]
  },
  "rdfs:label": {
