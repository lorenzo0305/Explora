  "rdfs:comment": {
    "de": [
      "Tanken Sie bei Energy Karting Nervenkitzel pur. Auf dieser Indoor-Piste für Elektrokarts können Sie alle Gefühle des Gleitens und der Geschwindigkeit ohne Lärm und Gerüche erleben!"
    ],
    "en": [
      "Come to fill up strong sensations at Energy Karting. This  electric karting tracks indoor allows to feel all the sensations of ride and speed without noice and smells."
    ],
    "it": [
      "Venite a provare il brivido dell'Energy Karting. Questa pista di go-kart elettrici al coperto vi permette di provare tutte le sensazioni di scorrimento e velocità senza rumori né odori!"
    ],
    "fr": [
      "Venez faire le plein de sensations fortes à Energy Karting. Cette piste indoor de karts électriques permet de ressentir toutes les sensations de glisse et de vitesse sans bruits ni odeurs !"
    ],
    "es": [
      "Ven a disfrutar de la emoción del Energy Karting. Esta pista de karts eléctricos cubierta le permite experimentar todas las sensaciones de deslizamiento y velocidad sin ruido ni olor"
    ],
    "nl": [
      "Kom en geniet van de sensatie van Energy Karting. Deze indoor elektrische kartbaan laat je alle sensaties van glijden en snelheid ervaren zonder lawaai of geur!"
    ]
  },
