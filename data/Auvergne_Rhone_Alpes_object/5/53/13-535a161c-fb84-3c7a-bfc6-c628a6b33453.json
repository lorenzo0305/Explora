  "rdfs:comment": {
    "de": [
      "Kommen Sie und üben Sie Fahrrad, BMX, Mountainbike, Draisine, Skateboard, Inlineskates, Roller, kurzum alles, was rollt, aber vor allem ohne Motor auf dem Pump Track in Aime la Plagne!"
    ],
    "en": [
      "Come to the brand new Pump Track in Aime la Plagne and have a great time on your bike, BMX, ATV, balance bike, skateboard, rollerblades, scooter, in short anything that rolls but isn't powered by a motor."
    ],
    "it": [
      "Venite a pedalare in bicicletta, BMX, mountain bike, draisienne, skateboard, rollerblade, monopattini, insomma tutto ciò che rotola, ma soprattutto senza motore sul Pump Track di Aime la Plagne!"
    ],
    "fr": [
      "Venez pratiquer le vélo, BMX, VTT, draisiennes, skateboard, rollers, trottinettes, bref tout ce qui roule, mais surtout sans moteur sur la Pump Track à Aime la Plagne !"
    ],
    "es": [
      "¡Ven a montar en bici, BMX, mountain bike, draisienne, monopatín, patines, scooters, en fin cualquier cosa que ruede, pero sobre todo sin motor en el Pump Track de Aime la Plagne!"
    ],
    "nl": [
      "Kom genieten van fietsen, BMX, mountainbiken, rijden, skateboarden, rolschaatsen, scooters, kortom, alles wat rolt, maar vooral zonder motor op de gloednieuwe Pump Track te Aime la Plagne!"
    ]
  },
