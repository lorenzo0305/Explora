  "rdfs:comment": {
    "de": [
      "Traditionelles Restaurant und Pizzeria. Auf der Speisekarte: lokale Produkte, Qualitätsfleisch, ein Hauch von Originalität, alles zu Ihrem Vergnügen zusammengestellt. Pizza vor Ort oder zum Mitnehmen mittwochs, freitags und samstags abends."
    ],
    "en": [
      "Traditional restaurant and pizzeria. On the menu: local produce, quality meats and a touch of originality, all concocted for your enjoyment. On-site pizza or takeaway on Wednesday, Friday and Saturday evenings."
    ],
    "it": [
      "Ristorante e pizzeria tradizionale. Nel menu: prodotti locali, carni di qualità e un tocco di originalità, il tutto preparato per il vostro piacere. Pizza in loco o da asporto il mercoledì, venerdì e sabato sera."
    ],
    "fr": [
      "Restaurant traditionnel et pizzeria. Au menu : des produits locaux, des viandes de qualité, une touche d'originalité, tout cela concocté pour votre plus grand plaisir. Pizza sur place ou à emporter les mercredis, vendredis et samedis soirs."
    ],
    "nl": [
      "Traditioneel restaurant en pizzeria. Op het menu: streekproducten, kwaliteitsvlees en een vleugje originaliteit, allemaal samengesteld voor jouw plezier. Pizza ter plaatse of om mee te nemen op woensdag-, vrijdag- en zaterdagavond."
    ],
    "es": [
      "Restaurante y pizzería tradicional. En el menú: productos locales, carnes de calidad y un toque de originalidad, todo preparado para su disfrute. Pizza en el local o para llevar los miércoles, viernes y sábados por la noche."
    ]
  },
