  "rdfs:comment": {
    "de": [
      "My little warung ist ein neues Schnellrestaurant, das südostasiatische Eintopfgerichte zum Verzehr vor Ort oder zum Mitnehmen anbietet. Wir bieten Ihnen die Möglichkeit, Ihre Sinne auf eine Reise zu schicken, bei der Sie eine gesunde und raffinierte Mahlzeit genießen können, die dennoch erschwinglich ist."
    ],
    "en": [
      "My little warung is a new fast-food restaurant offering simmered Southeast Asian dishes to eat in or take away. We invite you to take your senses on a journey for a healthy, refined and affordable meal."
    ],
    "it": [
      "Il mio piccolo warung è un nuovo fast food che offre piatti stufati del sud-est asiatico da mangiare o da portare via. Vi offriamo un pasto sano, raffinato e conveniente per accompagnare i vostri sensi in un viaggio."
    ],
    "fr": [
      "My little warung est un nouveau lieu de restauration rapide proposant des plats mijotés d'Asie du Sud-Est à consommer sur place ou à emporter. Nous vous proposons de faire voyager vos sens pour un repas sain et raffiné tout en restant abordable."
    ],
    "nl": [
      "My little warung is een nieuw fastfoodrestaurant met gestoofde Zuidoost-Aziatische gerechten om te eten of mee te nemen. We nodigen je uit om je zintuigen mee te nemen op reis voor een gezonde, verfijnde en betaalbare maaltijd."
    ],
    "es": [
      "My little warung es un nuevo local de comida rápida que ofrece platos guisados del sudeste asiático para comer en casa o para llevar. Le ofrecemos una comida sana, refinada y asequible para hacer viajar sus sentidos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "My Litlle Warung"
    ]
  },
