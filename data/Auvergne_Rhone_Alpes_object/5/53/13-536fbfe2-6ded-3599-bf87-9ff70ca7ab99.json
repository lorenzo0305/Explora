  "rdfs:comment": {
    "de": [
      "La Buissonnière ist eine Werkstatt für natürliche Textilfärbung, die sich in der ehemaligen Schule eines kleinen Weilers in den Bergen der Ardèche in der Nähe von Vals-les-Bains befindet."
    ],
    "en": [
      "La Buissonnière is a natural textile dyeing workshop located in the former school of a small hamlet in the Ardèche mountains, near Vals-les-Bains."
    ],
    "it": [
      "La Buissonnière è un laboratorio di tintura naturale di tessuti situato nell'ex scuola di un piccolo borgo nelle montagne dell'Ardèche, vicino a Vals-les-Bains."
    ],
    "fr": [
      "La Buissonnière est un atelier de teinture naturelle sur textile situé dans l’ancienne école d’un petit hameau de la montagne ardéchoise, près de Vals-les-Bains."
    ],
    "nl": [
      "La Buissonnière is een atelier voor natuurlijke textielverven, gevestigd in de voormalige school van een klein gehucht in de bergen van de Ardèche, vlakbij Vals-les-Bains."
    ],
    "es": [
      "La Buissonnière es un taller de tintes textiles naturales situado en la antigua escuela de una pequeña aldea de las montañas de Ardèche, cerca de Vals-les-Bains."
    ]
  },
