  "rdfs:comment": {
    "de": [
      "Nächte der Tagundnachtgleiche oder Wintersternennacht\r\nAver Beobachtung oder kommentierte Diashow in Innenräumen bei schlechtem Wetter\r\nKohlsuppe auf Hello Asso und Shuttle möglich nach Reservierung Hello Asso"
    ],
    "en": [
      "Equinox or winter star nights\r\nAver observation or commented slideshow indoors if the weather is bad\r\nCabbage soup on Hello Asso and shuttle service available on reservation Hello Asso"
    ],
    "it": [
      "Notti degli equinozi o notte delle stelle d'inverno\r\nOsservazione dell'Aver o proiezione di diapositive commentate al chiuso in caso di maltempo\r\nZuppa di cavoli su Hello Asso e servizio navetta disponibile su prenotazione Hello Asso"
    ],
    "fr": [
      "Nuits de l'équinoxe ou nuit des étoiles d'hiver\r\nAver observation ou diaporama commenté en intérieur si la météo est mauvaise\r\nSoupe aux choux sur Hello Asso et navette possible sur réservation Hello Asso"
    ],
    "es": [
      "Noches de equinoccio o de estrellas de invierno\r\nObservación de Aver o pase de diapositivas comentado en el interior si hace mal tiempo\r\nSopa de col en Hello Asso y servicio de transporte disponible previa reserva Hello Asso"
    ],
    "nl": [
      "Equinoxnachten of wintersterrennacht\r\nAver observatie of becommentarieerde diavoorstelling binnen bij slecht weer\r\nKoolsoep op Hello Asso en pendeldienst beschikbaar op reservering Hello Asso"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Nuit de l'équinoxe"
    ]
  },
