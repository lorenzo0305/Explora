  "rdfs:comment": {
    "de": [
      "Derzeit zählt die Mediathek 5 900 Bücher und Dokumente. Durch Ausleihen von Büchern aus der Mediathek des Departements und Einkäufe werden die zur Verfügung gestellten Bücher regelmäßig erneuert, um Sie noch zufriedener zu machen."
    ],
    "en": [
      "To date, the media library holds 5,900 books and documents. Book loans to the departmental media library as well as purchases enable the books made available to be regularly renewed, in order to satisfy you more."
    ],
    "it": [
      "Ad oggi, la mediateca conta 5.900 libri e documenti. I prestiti di libri dalla mediateca del dipartimento e gli acquisti ci permettono di rinnovare regolarmente i libri disponibili, per soddisfarvi sempre di più."
    ],
    "fr": [
      "A ce jour, la médiathèque comptabilise 5 900 livres et documents. Des prêts de livre à la médiathèque départementale ainsi que des achats permettent de renouveler régulièrement les livres mis à disposition, afin de vous satisfaire davantage."
    ],
    "es": [
      "Hasta la fecha, la mediateca cuenta con 5.900 libros y documentos. Los préstamos de libros de la mediateca del departamento, así como las compras, nos permiten renovar regularmente los libros disponibles, para satisfacerle aún más."
    ],
    "nl": [
      "De mediatheek telt momenteel 5.900 boeken en documenten. Door het lenen van boeken uit de mediatheek van de afdeling en door aankopen kunnen we de beschikbare boeken regelmatig vernieuwen om u nog meer tevreden te stellen."
    ]
  },
  "rdfs:label": {
