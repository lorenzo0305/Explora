      "@id": "https://data.datatourisme.fr/90b6aa45-26f6-3dab-bfa6-524440d6b42f",
      "dc:description": {
        "de": [
          "Die Galerie LE PASSAGE befindet sich auf dem Grand Place im wunderschönen Hotel d'Halluin und vereint Künstler, Kunsthandwerker, Designer und lokale Produzenten in einem einzigartigen und unumgänglichen Ort in Kassel."
        ],
        "en": [
          "Located on the Grand Place in the magnificent Hôtel d'Halluin, the LE PASSAGE gallery brings together artists, craftspeople, designers and local producers in a unique and essential Kassel venue."
        ],
        "it": [
          "Situata nella Grand Place del magnifico Hôtel d'Halluin, la galleria LE PASSAGE riunisce artisti, artigiani, designer e produttori locali in uno spazio unico e imperdibile a Kassel."
        ],
        "fr": [
          "Située sur la Grand Place au sein du magnifique hôtel d'Halluin, la galerie LE PASSAGE réunit artistes, artisans, créateurs et producteurs locaux dans un lieu de vie unique et incontournable de Cassel."
        ],
        "es": [
          "Situada en la Grand Place del magnífico Hôtel d'Halluin, la galería LE PASSAGE reúne a artistas, artesanos, diseñadores y productores locales en un lugar único e ineludible de Kassel."
        ],
        "nl": [
          "De galerie LE PASSAGE, gevestigd op de Grote Markt in het prachtige Hôtel d'Halluin, brengt kunstenaars, ambachtslieden, ontwerpers en lokale producenten samen op een unieke en niet te missen locatie in Kassel."
        ]
      },
