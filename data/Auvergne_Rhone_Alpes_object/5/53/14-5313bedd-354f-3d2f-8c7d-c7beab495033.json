  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/3481a913-ca12-3570-af37-ad2a448f2391",
      "dc:description": {
        "de": [
          "Informationen :\n\nTage der Öffnung:\nMontag bis Samstag: 6.30-19.00 Uhr\nSonntag: 6.30-12.30 Uhr\n\nMittwoch geschlossen\n\nAbholung :\nZum Mitnehmen während der Öffnungszeiten des Geschäfts\n\nBestellungen:\nDirektbestellung im Laden möglich\n\n "
        ],
        "en": [
          "Information :\n\nOpening days:\nMonday to Saturday: 6:30am-7pm\nSunday: 6.30am-12.30pm\n\nClosed on Wednesday\n\nPick-up :\nTakeaway during store opening hours\n\nOrdering:\nDirect in-store ordering possible\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura:\nDa lunedì a sabato: 6.30-19.00\nDomenica: 6.30-12.30\n\nChiuso il mercoledì\n\nRitiro :\nDa asporto durante gli orari di apertura del negozio\n\nOrdini :\nGli ordini possono essere effettuati direttamente in negozio\n\n "
        ],
        "fr": [
          "Informations :\n\nJours d'ouverture:\nDu lundi au samedi: 6h30-19h\nLe dimanche: 6h30-12h30\n\nFermeture le mercredi\n\nRetrait :\nÀ emporter aux horaires d'ouverture du magasin\n\nCommandes :\nPossibilité de commande direct en magasin\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen:\nMaandag tot zaterdag: 6.30u-19u\nZondag: 6u30-12u30\n\nWoensdag gesloten\n\nAfhalen :\nAfhalen tijdens openingstijden winkel\n\nBestellen :\nBestellingen kunnen direct in de winkel worden geplaatst\n\n "
        ],
        "es": [
          "Más información :\n\nDías de apertura:\nDe lunes a sábado: de 6h30 a 19h00\nDomingo: de 6h30 a 12h30\n\nMiércoles cerrado\n\nRecogida :\nPara llevar durante el horario de apertura de la tienda\n\nPedidos :\nLos pedidos se pueden hacer directamente en la tienda\n\n "
        ]
      },
