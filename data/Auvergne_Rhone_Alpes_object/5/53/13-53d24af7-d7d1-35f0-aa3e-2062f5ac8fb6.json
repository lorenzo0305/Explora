  "rdfs:comment": {
    "de": [
      "Bar-Restaurant, das Arbeitermenüs anbietet. Allgemeine Lebensmittel, FDJ und Themenabende am Wochenende. Mittwoch: Froschschenkel; Donnerstag: Kalbskopf; Freitag: Pommes frites und mit Whisky flambierte Gambas."
    ],
    "en": [
      "Bar-restaurant offering workers' menus. General food, FDJ and themed evenings at weekends. Wednesday: frogs' legs; Thursday: calf's head; Friday: chips and prawns flambéed in whisky."
    ],
    "it": [
      "Bar-ristorante che offre menù per lavoratori. Cucina generale, FDJ e serate a tema nei fine settimana. Mercoledì: cosce di rana; giovedì: testa di vitello; venerdì: patatine e gamberi fiammeggiati nel whisky."
    ],
    "fr": [
      "Bar-restaurant proposant des menus ouvriers. Alimentation générale, FDJ et soirée à thème le week-end. Mercredi : cuisses de grenouilles ; jeudi : tête de veau ; vendredi : fritures et gambas flambées au whisky."
    ],
    "es": [
      "Bar-restaurante que ofrece menús para trabajadores. Comida general, FDJ y noches temáticas los fines de semana. Miércoles: ancas de rana; jueves: cabeza de ternera; viernes: patatas fritas y gambas flambeadas al whisky."
    ],
    "nl": [
      "Bar-restaurant met werknemersmenu's. Algemeen eten, FDJ en thema-avonden in het weekend. Woensdag: kikkerbilletjes; donderdag: kalfskop; vrijdag: friet en garnalen geflambeerd in whisky."
    ]
  },
  "rdfs:label": {
    "en": [
      "Marronniers' Inn"
    ],
    "fr": [
      "L'Auberge des Marronniers"
    ]
  },
