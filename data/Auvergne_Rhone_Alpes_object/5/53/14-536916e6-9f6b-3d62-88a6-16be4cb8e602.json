      "dc:description": {
        "de": [
          "Erick Baert in Vokalillusionen \"Neue Show\".\nAm Samstag, den 20. September 2025 im Kursaal von Berck um 20.30 Uhr.\n\nPreise:\nErmäßigt: 10?\nVoller Preis: 15?\nKartenvorverkauf: Casino, Tourismusbüro und Ticketmaster."
        ],
        "en": [
          "Erick Baert in vocal illusions \"New show\".\nSaturday, September 20, 2025 at Berck's Kursaal, 8:30 pm.\n\nPrices :\nReduced : 10?\nFull: 15?\nTickets available at: casino, tourist office and ticketmaster."
        ],
        "it": [
          "Erick Baert in illusioni vocali \"Nuovo spettacolo\".\nSabato 20 settembre 2025 al Kursaal di Berck alle 20.30.\n\nPrezzi :\nRidotto : 10?\nIntero: 15?\nBiglietti disponibili presso il casinò, l'ufficio turistico e ticketmaster."
        ],
        "fr": [
          "Erick Baert dans illusions vocales \"Nouveau spectacle\".\nLe samedi 20 septembre 2025 au Kursaal de Berck à 20h 30. \n\nTarifs :\nRéduit : 10€\nPlein : 15€ \nBilletterie ouverte : casino, office de tourisme et ticketmaster."
        ],
        "nl": [
          "Erick Baert in vocale illusies \"Nieuwe show\".\nZaterdag 20 september 2025 in het Kursaal in Berck om 20.30 uur.\n\nPrijzen :\nGereduceerd : 10?\nVol: 15?\nTickets verkrijgbaar bij het casino, toeristenbureau en ticketmaster."
        ],
        "es": [
          "Erick Baert en ilusiones vocales \"Nuevo espectáculo\".\nSábado 20 de septiembre de 2025 en el Kursaal de Berck a las 20.30 h.\n\nPrecios :\nReducido : 10?\nCompleto: 15?\nEntradas disponibles en el casino, la oficina de turismo y ticketmaster."
        ]
      },
