  "rdfs:comment": {
    "de": [
      "Erklimmen Sie den legendären Grand Colombier auf gesperrter Straße an einem Samstag im Juni, Juli, August und September!\r\nFreie und kostenlose Auffahrten auf den Grand Colombier von Culoz aus, Straße für Radfahrer von 7 bis 15 Uhr reserviert."
    ],
    "en": [
      "On the road of Tour de France 2023, challenge the giant of Bugey: 18.5 kilometers, 1262 meters of elevation gain, with a maximum percentage of 14%! Free event,open for all, car-free road only for cyclists."
    ],
    "it": [
      "Salite il leggendario Grand Colombier su strada chiusa un sabato di giugno, luglio, agosto e settembre!\r\nSalita libera del Grand Colombier da Culoz, percorso riservato ai ciclisti dalle 7.00 alle 15.00."
    ],
    "fr": [
      "Grimpez le mythique Grand Colombier sur route fermée un samedi de juin, juillet août et septembre ! \r\nMontées libres et gratuites du Grand Colombier depuis Culoz, route réservée aux cyclistes de 7h à 15h."
    ],
    "es": [
      "Suba el legendario Grand Colombier por una carretera cerrada un sábado de junio, julio, agosto y septiembre\r\nSubida libre al Grand Colombier desde Culoz, ruta reservada a los ciclistas de 7h a 15h."
    ],
    "nl": [
      "Beklim de legendarische Grand Colombier op een afgesloten weg op een zaterdag in juni, juli, augustus en september!\r\nGratis beklimming van de Grand Colombier vanuit Culoz, route gereserveerd voor fietsers van 7u tot 15u."
    ]
  },
  "rdfs:label": {
    "en": [
      "Carfree cycling day of the Grand Colombier: July"
    ],
    "fr": [
      "Journée cyclo du Grand Colombier : juillet"
    ]
  },
