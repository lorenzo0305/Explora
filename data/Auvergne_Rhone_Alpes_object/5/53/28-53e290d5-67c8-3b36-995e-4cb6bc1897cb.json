      "dc:description": {
        "de": [
          "Lots of fishing \n- Öffentlicher Bereich :\n- Canal de \"la Sambre à l'Oise\" (lots N°27-28-29) biefs 25 à 27\n\n- Private Domäne :\n- Fluss \"l'Oise\" auf 6 kms\n- \"bras de l'Oise\" auf 4 kms"
        ],
        "en": [
          "Fishing boats \n- Public domain:\n- Canal de \"la Sambre à l'Oise\" (lots N°27-28-29) diversion bays 25 to 27\n\n- Private Domain :\n- River \"l'Oise\" on 6 kms\n- \"bras de l'Oise\" for four kilometers"
        ],
        "it": [
          "Lotti di pesca \n? Pubblico dominio:\n- Canal de \"la Sambre à l'Oise\" (lotti N°27-28-29) raggiunge il 25 a 27\n\n? Dominio privato :\n- Fiume \"l'Oise\" oltre 6 km\n- \"Bras de l'Oise\" per 4 km"
        ],
        "fr": [
          "Lots de pêche : \n• Domaine public :\n- Canal de \"la Sambre à l'Oise\" (lots N°27-28-29) biefs 25 à 27\n\n• Domaine privé :\n- Rivière \"l'Oise\" sur 6 kms\n- \"bras de l'Oise\" sur 4 kms"
        ],
        "nl": [
          "Viskavels\n- Publiek domein:\n- Canal de \"la Sambre à l'Oise\" (kavels N°27-28-29) bereikt 25 tot 27\n\n- Privé domein:\n- Rivier \"l'Oise\" op 6 km\n- \"bras de l'Oise\" over 4 km"
        ],
        "es": [
          "Parcelas de pesca \n? Dominio público:\n- Canal de \"la Sambre à l'Oise\" (lotes N°27-28-29) llega al 25 al 27\n\n? Dominio privado :\n- Río \"l'Oise\" más de 6 kms\n- \"bras de l'Oise\" más de 4 km"
        ]
      },
