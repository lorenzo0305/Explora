  "rdfs:comment": {
    "de": [
      "Mirmande, ein alter mittelalterlicher Marktflecken, wurde als \"Plus Beau Village de France\" klassifiziert. Entdecken Sie seine malerischen Gassen, seine romanische Kirche und probieren Sie seine Früchte."
    ],
    "en": [
      "Mirmande, an ancient medieval village, is classified as one of France's Most Beautiful Villages. Come and discover its picturesque streets, Romanesque church and taste its fruit."
    ],
    "it": [
      "Mirmande, un antico borgo medievale, è classificato come il più bel villaggio di Francia. Venite a scoprire le sue strade pittoresche, la sua chiesa romanica e a gustare i suoi frutti."
    ],
    "fr": [
      "Mirmande, ancien bourg médiéval, est classé comme Plus Beau Village de France. Venez découvrir ses ruelles pittoresques, son église romane et déguster ses fruits."
    ],
    "nl": [
      "Mirmande, een oud middeleeuws dorp, staat op de lijst van Mooiste Dorpen van Frankrijk. Kom en ontdek de pittoreske smalle straatjes, de Romaanse kerk en proef het fruit."
    ],
    "es": [
      "Mirmande, antiguo pueblo medieval, está clasificado como el Pueblo más Bonito de Francia. Venga a descubrir sus pintorescas calles, su iglesia románica y a degustar sus frutos."
    ]
  },
