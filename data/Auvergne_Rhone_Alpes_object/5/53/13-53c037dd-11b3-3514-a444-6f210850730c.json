  "rdfs:comment": {
    "de": [
      "Wir bieten Ihnen in einem atypischen Ort handwerklich hergestellte Holzofenpizzen, die aus Qualitätsprodukten aus der Umgebung hergestellt werden."
    ],
    "en": [
      "We prepare handmade pizzas to take away cooked over a wood fire with quality\r\nand local products. The quality of our dough is due to the flours selected\r\nby us as well as the kneading and long fermentation process. Open every 1st\r\nand 3rd Friday and Saturday of each month, 5 p.m. – 9h30 p.m."
    ],
    "it": [
      "In un luogo atipico, offriamo pizze cotte a legna e fatte in casa con prodotti di qualità e locali."
    ],
    "fr": [
      "Nous vous proposons dans un lieu atypique des pizzas cuites au feu de bois et artisanales élaborées à partir de produits de qualité et de proximité."
    ],
    "nl": [
      "Op een atypische plek bieden we houtgestookte en zelfgemaakte pizza's van kwaliteits- en streekproducten."
    ],
    "es": [
      "En un lugar atípico, ofrecemos pizzas a la leña y caseras elaboradas con productos locales y de calidad."
    ]
  },
