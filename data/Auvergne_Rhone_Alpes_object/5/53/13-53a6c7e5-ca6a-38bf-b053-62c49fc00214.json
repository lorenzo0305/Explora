  "rdfs:comment": {
    "de": [
      "In einem großen Park von über 4000m² bietet das Hôtel des Bains hochwertigen Komfort. Alle Zimmer haben Blick auf die Berge. Mehrere Aufenthaltsräume stehen zur Verfügung. Schwimmbad und überdachter Wellnessbereich."
    ],
    "en": [
      "Set in a large park of over 3,000m², the Hôtel des Bains offers quality comfort. All rooms have mountain views. Several lounges available. Covered swimming pool and wellness area."
    ],
    "it": [
      "Situato in un terreno di oltre 4.000 m², l'Hôtel des Bains offre un elevato standard di comfort. Tutte le camere hanno vista sulle montagne. Diversi saloni a disposizione. Piscina coperta e area benessere."
    ],
    "fr": [
      "Dans un grand parc de plus de 4000m², l'Hôtel des Bains offre un confort de qualité. Toutes les chambres ont vue sur les montagnes. Plusieurs salons à disposition. Piscine et espace bien être couvert."
    ],
    "es": [
      "Situado en un terreno de más de 3.000 m², el Hôtel des Bains ofrece un alto nivel de confort. Todas las habitaciones tienen vistas a la montaña. Varios salones disponibles. Piscina cubierta y zona de bienestar."
    ],
    "nl": [
      "Hôtel des Bains ligt op een terrein van meer dan 4.000 m² en biedt een hoge standaard aan comfort. Alle kamers hebben uitzicht op de bergen. Verschillende lounges beschikbaar. Overdekt zwembad en wellnessruimte."
    ]
  },
