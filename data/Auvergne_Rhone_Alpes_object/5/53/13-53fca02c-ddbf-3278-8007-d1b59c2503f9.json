  "rdfs:comment": {
    "de": [
      "Le Pied de la Lettre ist ein Restaurant mit Weinbar, das kleine Teller aus frischen, lokalen Produkten und eine Weinkarte mit 200 Weinen (aus biologischem Anbau) anbietet. Seine kreative Küche wurde von Gault und Millau (13/20) und dem Fooding ausgezeichnet."
    ],
    "en": [
      "Le Pied de la Lettre is a restaurant offering a selection of small plates made with fresh, local ingredients, as well as a wine list featuring 300 organic references. Its inventive cuisine has been recognized by Gault and Millau and Fooding."
    ],
    "it": [
      "Le Pied de la Lettre è un ristorante che offre una selezione di piccoli piatti preparati con prodotti freschi e locali, oltre a una carta dei vini con 300 etichette biologiche. La sua cucina è stata riconosciuta da Gault et Millau e Fooding."
    ],
    "fr": [
      "Le Pied de la Lettre est un restaurant offrant une sélection de petites assiettes préparées avec des produits frais et locaux, ainsi qu'une carte des vins comprenant 300 références bio. Sa cuisine a été reconnue par le Gault et Millau et le Fooding."
    ],
    "nl": [
      "Le Pied de la Lettre is een restaurant en wijnbar met kleine gerechten van verse, lokale producten en een 200-koppige (biologische) wijnkaart. De creatieve keuken is bekroond door Gault et Millau (13/20) en Fooding."
    ],
    "es": [
      "Le Pied de la Lettre es un restaurante que ofrece una selección de pequeños platos elaborados con productos frescos y locales, así como una carta de 300 vinos ecológicos. Su cocina ha sido reconocida por Gault et Millau y Fooding."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Pied de la Lettre"
    ]
  },
