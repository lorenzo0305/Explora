  "rdfs:comment": {
    "de": [
      "1929 wurde die Bowstring-Brücke gebaut, um die einbogige Hängebrücke aus dem Jahr 1833 zu ersetzen, deren Fahrbahnplatte bei Hochwasser unweigerlich weggespült wurde."
    ],
    "en": [
      "In 1929, the Bowstring bridge was built to replace the single-arch suspension bridge of 1833, whose deck was invariably washed away by flooding."
    ],
    "it": [
      "Nel 1929, il ponte di Bowstring fu costruito per sostituire il ponte sospeso a un solo arco del 1833, il cui ponte veniva invariabilmente spazzato via dalle inondazioni."
    ],
    "fr": [
      "En 1929, le pont de type Bowstring est construit pour remplacé le pont suspendu d'une seule arche de 1833, dont les crues emportaient invariablement le tablier."
    ],
    "nl": [
      "In 1929 werd de Bowstring-brug gebouwd ter vervanging van de hangbrug met één boog uit 1833, waarvan het brugdek steeds wegspoelde door overstromingen."
    ],
    "es": [
      "En 1929 se construyó el puente Bowstring para sustituir al puente colgante de un solo arco de 1833, cuyo tablero era invariablemente arrastrado por las inundaciones."
    ]
  },
  "rdfs:label": {
