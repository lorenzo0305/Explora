  "rdfs:comment": {
    "de": [
      "Fahrradverleih für einen Tag auf dem grünen Weg \"Via Ardèche\" , entdecken Sie unsere ultra-komfortablen Beach Cruiser Fahrräder, mit denen Sie sanft die wunderschönen Landschaften entdecken können."
    ],
    "en": [
      "Bike hire for the day on the \"Via Ardèche\" greenway. Come and discover our ultra-comfortable beach cruiser bikes, which will let you discover some magnificent landscapes."
    ],
    "it": [
      "Noleggio di biciclette per un giorno sull'autostrada verde \"Via Ardèche\", venite a scoprire le nostre comodissime biciclette da spiaggia, che vi permetteranno di scoprire magnifici paesaggi con facilità."
    ],
    "fr": [
      "Location de vélos à la journée sur la voie verte « Via Ardèche » , venez découvrir nos vélos beach cruiser ultra confortables, qui vous permettront de découvrir avec douceur de magnifiques paysages."
    ],
    "nl": [
      "Huur een fiets voor een dag op de groene route \"Via Ardèche\" en ontdek onze ultracomfortabele cruisefietsen waarmee je prachtige landschappen kunt ontdekken."
    ],
    "es": [
      "Alquiler de bicicletas para el día en la vía verde \"Via Ardèche\", venga a descubrir nuestras bicicletas de crucero de playa ultra cómodas, que le permitirán descubrir magníficos paisajes con facilidad."
    ]
  },
  "rdfs:label": {
    "de": [
