  "rdfs:comment": {
    "de": [
      "Zwischen Modernität und Tradition... In unserem Restaurant werden Sie eine familiäre Küche entdecken. Wir verwenden frische Produkte, um zu unseren Wurzeln zurückzukehren, indem wir mit lokalen Erzeugern und Handwerkern zusammenarbeiten."
    ],
    "en": [
      "Our restaurant is a mix between modernity and tradition, in a family atmosphere. We use fresh products from local farmers and suppliers."
    ],
    "it": [
      "Tra modernità e tradizione? Nel nostro ristorante scoprirete una cucina familiare. Utilizziamo prodotti freschi per un ritorno alle nostre radici, collaborando con produttori e artigiani locali."
    ],
    "fr": [
      "Entre modernité et tradition… Vous découvrirez dans notre restaurant une cuisine familiale. Nous utilisons des produits frais pour un retour aux sources en travaillant avec des producteurs et artisans locaux."
    ],
    "es": [
      "¿Entre la modernidad y la tradición? En nuestro restaurante descubrirá una cocina familiar. Utilizamos productos frescos para volver a nuestras raíces trabajando con productores y artesanos locales."
    ],
    "nl": [
      "Tussen moderniteit en traditie... In ons restaurant ontdekt u een familiekeuken. Wij gebruiken verse producten voor een terugkeer naar onze roots door te werken met lokale producenten en ambachtslieden."
    ]
  },
