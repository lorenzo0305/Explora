  "rdfs:comment": {
    "de": [
      "Dorf mit charmanten Weilern: Rif des Fauries (Hauptort), les Bellieux, St Moirans, les Auberts, am Fuße der schönen Felsen von Rochecourbe. Gorges du Contècle, ein 500 bis 700 Jahre alter Kastanienbaum, der als bemerkenswerter Baum der Drôme gelistet ist."
    ],
    "en": [
      "A village of charming hamlets: Rif des Fauries (village center), les Bellieux, St Moirans, les Auberts, at the foot of the beautiful Rochecourbe cliffs. Gorges du Contècle, a 500 to 700-year-old chestnut tree listed as a remarkable Drôme tree."
    ],
    "it": [
      "Un villaggio di frazioni affascinanti: Rif des Fauries (villaggio principale), les Bellieux, St Moirans, les Auberts, ai piedi delle splendide falesie di Rochecourbe. Gorges du Contècle, un castagno di 500-700 anni classificato come albero notevole della Drôme."
    ],
    "fr": [
      "Village aux charmants hameaux : Rif des Fauries (chef-lieu village), les Bellieux, St Moirans, les Auberts, au pied des belles falaises de Rochecourbe. Gorges du Contècle, vieux châtaignier de 500 à 700 ans répertorié arbre remarquable de la Drôme."
    ],
    "es": [
      "Un pueblo de encantadoras aldeas: Rif des Fauries (pueblo principal), les Bellieux, St Moirans, les Auberts, al pie de los hermosos acantilados de Rochecourbe. Gorges du Contècle, un castaño de 500 a 700 años catalogado como árbol notable de la Drôme."
    ],
    "nl": [
      "Een dorp van charmante gehuchten: Rif des Fauries (hoofddorp), les Bellieux, St Moirans, les Auberts, aan de voet van de prachtige kliffen van Rochecourbe. Gorges du Contècle, een kastanjeboom van 500 tot 700 jaar oud, geklasseerd als opmerkelijke boom in de Drôme."
    ]
  },
