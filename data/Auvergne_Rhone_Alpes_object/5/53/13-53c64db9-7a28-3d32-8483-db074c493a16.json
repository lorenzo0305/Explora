  "rdfs:comment": {
    "de": [
      "Das Restaurant bietet Ihnen eine kreative Küche aus frischen und saisonalen Produkten in einem hellen, angenehmen und erholsamen Rahmen, um dort Ihre privaten oder geschäftlichen Mahlzeiten zu organisieren."
    ],
    "en": [
      "Our restaurant offers creative cuisine prepared with fresh, seasonal produce in a bright, pleasant, relaxing setting, ideal for private or business dining."
    ],
    "it": [
      "Il ristorante offre una cucina creativa basata su prodotti freschi e di stagione in un ambiente luminoso, piacevole e rilassante per i vostri pasti privati e professionali."
    ],
    "fr": [
      "Le restaurant vous propose une cuisine créative à base de produits frais et de saison dans un cadre lumineux, agréable et reposant afin d'y organiser vos repas privés et professionnels."
    ],
    "nl": [
      "Het restaurant biedt een creatieve keuken op basis van verse en seizoensgebonden producten in een lichte, aangename en ontspannende omgeving voor uw privé- en professionele maaltijden."
    ],
    "es": [
      "El restaurante ofrece una cocina creativa basada en productos frescos y de temporada en un entorno luminoso, agradable y relajante para sus comidas privadas y profesionales."
    ]
  },
