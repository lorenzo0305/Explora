  "rdfs:comment": {
    "de": [
      "Spüren Sie den Ton und finden Sie Ihre Inspiration an einem Ort, der die Kreativität fördert!\r\n\r\nEintägiger Kurs, in dem Sie eine Kreation aus Ton herstellen. Die Stücke bleiben zum Glasieren und Brennen in der Werkstatt."
    ],
    "en": [
      "Feel the clay and find your inspiration in a place conducive to creation!\r\n\r\nA 1-day workshop to create a piece in clay. The pieces remain in the workshop for glazing and firing."
    ],
    "it": [
      "Sentite l'argilla e trovate la vostra ispirazione in un luogo perfetto per creare!\r\n\r\nUn corso di 1 giorno per creare un pezzo di argilla. I pezzi rimangono in studio per la smaltatura e la cottura."
    ],
    "fr": [
      "Ressentir l’argile et trouver votre inspiration  dans un  lieu propice à la création !\r\n\r\nStage en 1 journée pour réaliser une création en argile. Les pièces restent à l’atelier pour l’émaillage et les cuissons."
    ],
    "nl": [
      "Voel de klei en doe inspiratie op op een plek die perfect is om te creëren!\r\n\r\nEen 1-daagse cursus om een kleiwerkstuk te maken. De werkstukken blijven in de studio om geglazuurd en gebakken te worden."
    ],
    "es": [
      "Siente la arcilla y encuentra tu inspiración en un lugar perfecto para crear\r\n\r\nUn curso de 1 día para crear una pieza de arcilla. Las piezas permanecen en el estudio para su esmaltado y cocción."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Stage de céramique adultes"
    ]
  },
