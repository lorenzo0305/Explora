  "rdfs:comment": {
    "de": [
      "Besuchen Sie die Basilika Saint-Julien mit unseren Führern! Entdecken Sie eine der schönsten romanischen Kirchen der Auvergne mit unseren Führungen für Einzelpersonen, die das ganze Jahr über angeboten werden, um ihre Architektur und Geschichte zu erkunden."
    ],
    "en": [
      "Visit Saint-Julien Basilica with our guides! Discover one of Auvergne?s most beautiful Romanesque churches with our guided tours for individuals, available all year round to explore its architecture and history."
    ],
    "it": [
      "Visitate la Basilica di Saint-Julien con le nostre guide! Scoprite una delle più belle chiese romaniche dell'Alvernia con le nostre visite guidate per individuali, disponibili tutto l'anno per esplorare la sua architettura e la sua storia."
    ],
    "fr": [
      "Visitez la Basilique Saint-Julien avec nos guides ! Découvrez l’une des plus belles églises romanes d’Auvergne grâce à nos visites guidées pour individuels, proposées toute l’année pour explorer son architecture et son histoire."
    ],
    "es": [
      "¡Visite la Basílica de Saint-Julien con nuestros guías! Descubra una de las iglesias románicas más bellas de Auvernia con nuestras visitas guiadas para particulares, disponibles todo el año para explorar su arquitectura y su historia."
    ],
    "nl": [
      "Bezoek de Basiliek Saint-Julien met onze gidsen! Ontdek een van de mooiste Romaanse kerken in de Auvergne met onze individuele rondleidingen, die het hele jaar door beschikbaar zijn om de architectuur en geschiedenis te ontdekken."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visites guidées pour les individuels de la Basilique Saint Julien"
    ]
  },
