  "rdfs:comment": {
    "de": [
      "Von Renaud de Forez errichtete mittelalterliche Burg mit einem zylindrischen Bergfried, einem halbrunden Turm und einem zentralen rechteckigen Hauptgebäude. Im Inneren: gallo-römische Mosaike, kleines archäologisches Museum..."
    ],
    "en": [
      "Medieval castle built by Renaud de Forez, comprising a cylindrical keep, a semi-circular tower and a central rectangular building. Inside: Gallo-Roman mosaics, small archaeological museum..."
    ],
    "it": [
      "Castello medievale costruito da Renaud de Forez, composto da un mastio cilindrico, una torre semicircolare e un edificio principale centrale rettangolare. All'interno: mosaici gallo-romani, piccolo museo archeologico..."
    ],
    "fr": [
      "Château médiéval édifié par Renaud de Forez, comprenant un donjon cylindrique, une tour semi-circulaire et un corps de logis central rectangulaire. A l'intérieur : mosaïques gallo-romaines, petit musée archéologique..."
    ],
    "nl": [
      "Middeleeuws kasteel gebouwd door Renaud de Forez, bestaande uit een cilindrische donjon, een halfronde toren en een centraal rechthoekig hoofdgebouw. Binnen: Gallo-Romeinse mozaïeken, klein archeologisch museum..."
    ],
    "es": [
      "Castillo medieval construido por Renaud de Forez, compuesto por una torre del homenaje cilíndrica, una torre semicircular y un edificio central rectangular. En el interior: mosaicos galo-romanos, pequeño museo arqueológico..."
    ]
  },
