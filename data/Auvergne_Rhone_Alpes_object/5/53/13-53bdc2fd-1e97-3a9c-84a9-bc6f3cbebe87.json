  "rdfs:comment": {
    "de": [
      "Emilie und ihre Familie begrüßen Sie auf ihrem Bauernhof, wo Sie unter anderem grüne Linsen aus Puy AOP sowie bäuerliche und regionale Produkte kaufen können."
    ],
    "en": [
      "Emilie and her family welcome you to their farm, where you can buy PDO green Puy lentils and other farm and regional products."
    ],
    "it": [
      "Emilie e la sua famiglia vi danno il benvenuto nella loro fattoria, dove potrete acquistare lenticchie verdi di Puy DOP e altri prodotti agricoli e regionali."
    ],
    "fr": [
      "Emilie et sa famille vous accueille dans sa ferme où vous pourrez notamment vous procurer des lentilles vertes du Puy AOP ainsi que des produits fermiers et régionaux."
    ],
    "es": [
      "Emilie y su familia le dan la bienvenida a su granja, donde podrá comprar lentejas de Puy verdes DOP y otros productos de la granja y de la región."
    ],
    "nl": [
      "Emilie en haar gezin heten je welkom op hun boerderij, waar je groene Puy linzen met BOB en andere boerderij- en streekproducten kunt kopen."
    ]
  },
