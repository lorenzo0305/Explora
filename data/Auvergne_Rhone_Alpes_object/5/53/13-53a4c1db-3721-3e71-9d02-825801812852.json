  "rdfs:comment": {
    "de": [
      "Die Auberge des Bornes ist seit 2005 geöffnet und empfängt Ihre Gruppen- und Firmenessen von 40 bis 120 Personen. Schlüsselfertige Angebote: Essen im Sitzen, Cocktail, Fondue vom Fass, ideal für Teambuilding, Geburtstag, Cousinade."
    ],
    "en": [
      "L'Auberges des Bornes is located in an old building transformed into a restaurant in 2005. You will find traditional and Savoyard food. You can also enjoy themed evenings every month."
    ],
    "it": [
      "L'Auberge des Bornes, aperto dal 2005, si occupa di pranzi e cene aziendali per gruppi da 40 a 120 persone. Formule \"chiavi in mano\": pasto seduto, cocktail, fonduta su botte, ideale per team building, compleanni e anniversari."
    ],
    "fr": [
      "L’Auberge des Bornes, ouverte depuis 2005, accueille vos repas de groupes et d’entreprise de 40 à 120 personnes. Formules clé en main : repas assis, cocktail dinatoire, fondue sur tonneau, idéal pour team building, anniversaire, cousinade."
    ],
    "es": [
      "El Auberge des Bornes, abierto desde 2005, ofrece comidas para grupos y empresas de 40 a 120 personas. Fórmulas llave en mano: comida sentada, cóctel, fondue en barril, ideal para team-building, cumpleaños y aniversarios."
    ],
    "nl": [
      "De Auberge des Bornes, geopend sinds 2005, verzorgt groeps- en bedrijfsmaaltijden voor 40 tot 120 personen. Kant-en-klare formules: zitmaaltijd, cocktailreceptie, fondue op vat, ideaal voor teambuilding, verjaardagen en jubilea."
    ]
  },
