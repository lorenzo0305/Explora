  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/1e33faf4-dc38-335c-9ff0-390b0707bc8f",
      "dc:description": {
        "de": [
          "Das Fremdenverkehrsamt Haut-Pays Côte d'opale lädt Sie zu einem Familienausflug in die Natur mit den Eseln und einer Entdeckung des Ziegenhofs ein.\n\nAbfahrt: Rumilly um 14 Uhr\n\nPreis: 6 ? pro Person / kostenlos für Kinder unter 3 Jahren\n\nAuf Reservierung"
        ],
        "en": [
          "The Haut-Pays Côte d'Opale Tourist Office invites you to take part in a family outing with donkeys and discover the goat farm.\n\nDeparture: Rumilly at 2pm\n\nPrice: 6? per person / free for children under 3\n\nOn reservation"
        ],
        "it": [
          "L'Ufficio del Turismo dell'Haut-Pays Côte d'Opale vi invita a fare una passeggiata in famiglia nel cuore della natura con gli asini e a scoprire la fattoria delle capre.\n\nPartenza: Rumilly alle 14.00\n\nPrezzo: 6? a persona / gratis per i minori di 3 anni\n\nSolo su prenotazione"
        ],
        "fr": [
          "L'Office de Tourisme Haut-Pays Côte d'opale vous invite à une balade en famille en pleine nature avec les ânes et une découverte de la chèvrerie.\n\nDépart: Rumilly à 14h\n\nTarif: 6€ par personne / gratuit pour les moins de 3 ans \n\nSur réservation"
        ],
        "es": [
          "La Oficina de Turismo de Haut-Pays Côte d'Opale le invita a participar en una excursión familiar con burros y a descubrir la granja de cabras.\n\nSalida: Rumilly a las 14:00\n\nPrecio: 6? por persona / gratis para los menores de 3 años\n\nSólo con reserva"
        ],
        "nl": [
          "Het toeristenbureau van de Haut-Pays Côte d'Opale nodigt je uit voor een gezinsuitstapje met ezels en om de geitenboerderij te ontdekken.\n\nVertrek: Rumilly om 14u\n\nPrijs: 6? per persoon / gratis voor kinderen onder de 3 jaar\n\nAlleen op reservering"
        ]
      },
