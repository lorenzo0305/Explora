  "rdfs:comment": {
    "de": [
      "Dieser Dienst stellt die Anschlüsse der Nutzer aus den verschiedenen Ortschaften, die nicht von einer regelmäßigen Linie bedient werden, zum nächstgelegenen Haltepunkt sicher (Anschlüsse nach Die und Villard de Lans aus den 5 Dörfern des Kantons)"
    ],
    "en": [
      "This service connects users from various towns not served by a regular line to the nearest stop (connections to Die and Villard de Lans from the 5 villages in the Canton)"
    ],
    "it": [
      "Questo servizio fornisce collegamenti per gli utenti di varie località non servite da una linea regolare fino alla fermata più vicina (collegamenti per Die e Villard de Lans dai 5 villaggi del Cantone)"
    ],
    "fr": [
      "Ce service assure les correspondances des usagers à partir des diverses localités non desservies par une ligne régulière vers le point d'arrêt le plus proche. (correspondance pour Die et Villard de Lans depuis les 5 villages du Canton)"
    ],
    "es": [
      "Este servicio permite conectar a los usuarios de diversas localidades no servidas por una línea regular con la parada más cercana (conexiones para Die y Villard de Lans desde los 5 pueblos del Cantón)"
    ],
    "nl": [
      "Deze dienst biedt verbindingen voor gebruikers uit verschillende plaatsen die niet worden bediend door een reguliere lijn naar de dichtstbijzijnde halte (verbindingen voor Die en Villard de Lans vanuit de 5 dorpen in het kanton)"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Transport à la Demande"
    ]
  },
