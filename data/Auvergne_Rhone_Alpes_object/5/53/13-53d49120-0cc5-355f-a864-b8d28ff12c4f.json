  "rdfs:comment": {
    "de": [
      "Ihr neuer Paintball eröffnet ab dem 1. Juni. Er liegt auf einer Anhöhe inmitten der Natur und ist der ideale Ort, um sich zu erholen und mit Freunden und Familie zu genießen. Wir haben zwei Parcours vorbereitet: einen für Erwachsene und einen für Kinder."
    ],
    "en": [
      "Your new paintball center opens on June 1st. Located in the hills, in the heart of nature, it's the ideal place to relax and enjoy with friends and family. We've prepared two courses: one for adults, one for children."
    ],
    "it": [
      "Il Paintball è aperto tutto l'anno, su prenotazione. Situato in collina, nel cuore della natura, è il luogo ideale per rilassarsi e divertirsi con gli amici e la famiglia. Abbiamo preparato due percorsi: uno per adulti e uno per bambini."
    ],
    "fr": [
      "Le paintball est ouvert toute l'année sur réservation. Situé sur les hauteurs, en pleine nature, c'est l'endroit idéal pour se resourcer et profiter avec ses amis et sa famille. Nous avons préparé deux parcours : un pour les adultes, un pour les enfants."
    ],
    "nl": [
      "Je nieuwe paintballcentrum opent op 1 juni. Gelegen in de heuvels, midden in de natuur, is het de ideale plek om te ontspannen en te genieten met vrienden en familie. We hebben twee parcours uitgezet: een voor volwassenen en een voor kinderen."
    ],
    "es": [
      "El paintball está abierto todo el año, previa reserva. Situado en las colinas, en plena naturaleza, es el lugar ideal para relajarse y disfrutar con los amigos y la familia. Hemos preparado dos recorridos: uno para adultos y otro para niños."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Paintball Baronnies"
    ]
  },
