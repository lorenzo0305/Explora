  "rdfs:comment": {
    "de": [
      "Gehen Sie mit dem \"Enquête Game\" auf Entdeckungsreise durch das charmante Village de Caractère du Crozet. Sie müssen Nachforschungen anstellen, um die Gründe für das Verschwinden von Marie Couvet zu ermitteln und herauszufinden, wo sie sich aufhält. Werden Sie der Aufgabe gewachsen sein?"
    ],
    "en": [
      "Discover the charming Village de Caractère of Le Crozet with the \"Enquête Game\". You'll have to investigate the cause of Marie Couvet's disappearance and find out where she is. Are you up to the challenge?"
    ],
    "it": [
      "Scoprite l'affascinante villaggio di Crozet con il \"Gioco dell'Inchiesta\". Dovrete indagare per scoprire perché Marie Couvet è scomparsa e dove si trova. Sarete all'altezza del compito?"
    ],
    "fr": [
      "Partez à la découverte du charmant Village de Caractère du Crozet grâce au jeu \"Enquête Game\". Vous devez mener l'enquête pour déterminer les causes de la disparition de Marie Couvet et découvrir où elle se trouve. Serez-vous à la hauteur ?"
    ],
    "nl": [
      "Ontdek het charmante dorpje Crozet met het \"Enquête Spel\". Je moet op onderzoek uit om erachter te komen waarom Marie Couvet is verdwenen en waar ze is. Kun jij deze taak aan?"
    ],
    "es": [
      "Descubre el encantador pueblo de Crozet con el \"Juego de la Enquête\". Tendrás que investigar para averiguar por qué ha desaparecido Marie Couvet y dónde está. ¿Estarás a la altura?"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Enquête game"
    ]
  },
