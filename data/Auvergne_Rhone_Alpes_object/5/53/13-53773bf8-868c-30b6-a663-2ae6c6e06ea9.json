  "rdfs:comment": {
    "de": [
      "Die Kirche im neugotischen Stil stammt aus den Jahren 1863-18659, mit Geldern, die Napoleon III. bei seinem Besuch in diesem Dorf im Jahr 1860 gespendet hat. Der Glockenturm wurde 1898 errichtet, ein Datum, dem auch das Innere der Kirche entspricht (Gemälde, Chorgestühl, Fußboden, ...)."
    ],
    "en": [
      "The neo-Gothic church dates from 1863-18659, with funds donated by Napoleon III when he visited the village in 1860. The bell tower was built in 1898, the same year as the church interior (paintings, stalls, floor, etc.)."
    ],
    "it": [
      "La chiesa neogotica risale al 1863-18659, con fondi donati da Napoleone III in occasione della sua visita al villaggio nel 1860. Il campanile è stato costruito nel 1898, la stessa data dell'interno della chiesa (dipinti, stalli del coro, pavimento, ecc.)."
    ],
    "fr": [
      "L'église de style néogothique datant de 1863-18659, avec les fonds offerts par Napoléon III lors de son passage dans ce village en 1860. Le clocher fut édifié en 1898, date à laquelle correspond aussi l'intérieur de l'église (peintures, stalles, sol,...)."
    ],
    "es": [
      "La iglesia neogótica data de 1863-18659, con fondos donados por Napoleón III cuando visitó el pueblo en 1860. El campanario se construyó en 1898, fecha en la que también se renovó el interior de la iglesia (pinturas, sillería, suelo, etc.)."
    ],
    "nl": [
      "De neogotische kerk dateert uit 1863-18659, met fondsen geschonken door Napoleon III toen hij het dorp bezocht in 1860. De klokkentoren werd gebouwd in 1898, dezelfde datum als het interieur van de kerk (schilderijen, koorbanken, vloer, enz.)."
    ]
  },
  "rdfs:label": {
    "de": [
      "Kirche St. Peter/St. Paul"
    ],
