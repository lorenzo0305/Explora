  "rdfs:comment": {
    "de": [
      "Der Aussichtspunkt befindet sich 3 km entfernt. Er bietet einen Tiefblick auf die Ebene von Tricastin und Pierrelatte. Im Norden zeichnet sich die Schlucht von Donzère ab."
    ],
    "en": [
      "Exceptional view over the Rhône valley and the Ardèche foothills."
    ],
    "it": [
      "Il belvedere si trova a 3 km di distanza. Offre una vista a volo d'uccello sulla pianura di Tricastin e su Pierrelatte. A nord si trovano le gole del Donzère."
    ],
    "fr": [
      "Le belvédère se trouve à 3 km. Il offre une vue plongeante sur la plaine du Tricastin et Pierrelatte. Au nord, se dessine le défilé de Donzère."
    ],
    "es": [
      "El mirador está a 3 km. Ofrece una vista de pájaro sobre la llanura de Tricastin y Pierrelatte. Al norte, el desfiladero de la Donzère."
    ],
    "nl": [
      "Adembenemend uitzicht over het Rhônedal en de uitlopers van de Ardèche."
    ]
  },
  "rdfs:label": {
