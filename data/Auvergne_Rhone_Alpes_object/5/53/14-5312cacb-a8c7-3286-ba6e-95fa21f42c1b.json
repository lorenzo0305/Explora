  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/eb15d454-5937-3e29-883c-6d7799e54562",
      "dc:description": {
        "de": [
          "Am Sonntag, den 23. November, organisiert die APEL Saint Michel Saint Joseph im Saal des Pax einen Flohmarkt, eine Spielzeug- und Kleiderbörse.\nKommen Sie zum Stöbern und finden Sie die seltene Perle!"
        ],
        "en": [
          "On Sunday November 23, APEL Saint Michel Saint Joseph is organizing a flea market, toy and clothing exchange in the Salle du Pax.\nCome and find the rare pearl!"
        ],
        "it": [
          "Domenica 23 novembre, l'APEL Saint Michel Saint Joseph organizza un mercatino delle pulci e una fiera di giocattoli e vestiti nella Salle du Pax.\nVenite a curiosare e a trovare quel gioiello raro!"
        ],
        "fr": [
          "Le dimanche 23 novembre, l'APEL Saint Michel Saint Joseph organise à la salle du Pax, une brocante, une bourse aux jouets et aux vêtements.\nVenez chiner et trouver la perle rare !"
        ],
        "nl": [
          "Op zondag 23 november organiseert het APEL Saint Michel Saint Joseph een rommelmarkt en een speelgoed- en kledingbeurs in de Salle du Pax.\nKom snuffelen en vind dat zeldzame juweeltje!"
        ],
        "es": [
          "El domingo 23 de noviembre, la APEL Saint Michel Saint Joseph organiza un mercadillo y una feria de juguetes y ropa en la Salle du Pax.\n¡Venga a curiosear y a encontrar esa joya rara!"
        ]
      },
