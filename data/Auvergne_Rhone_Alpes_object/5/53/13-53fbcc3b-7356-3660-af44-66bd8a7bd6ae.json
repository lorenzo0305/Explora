  "rdfs:comment": {
    "de": [
      "Der Frühling ist da!\r\nDer Frühling kommt und mit ihm erwacht eine ganze Welt. Die Tiere kommen aus ihren Verstecken und schlüpfen in die Geschichten."
    ],
    "en": [
      "Spring is here!\r\nSpring is here, and with it a whole world awakens. Animals come out of their hiding places and into the stories."
    ],
    "it": [
      "È arrivata la primavera!\r\nLa primavera è arrivata e con essa si risveglia un mondo intero. Gli animali escono dai loro nascondigli per entrare nelle storie."
    ],
    "fr": [
      "Le printemps est là !\r\nLe printemps arrive et avec lui tout un monde se réveille. Les animaux sortent de leurs cachettes pour se glisser dans les histoires."
    ],
    "es": [
      "La primavera ya está aquí\r\nLa primavera ya está aquí y con ella todo un mundo despierta. Los animales salen de sus escondites para colarse en los cuentos."
    ],
    "nl": [
      "Het is lente!\r\nHet is lente en daarmee ontwaakt een hele wereld. De dieren komen uit hun schuilplaatsen om in de verhalen te kruipen."
    ]
  },
  "rdfs:label": {
