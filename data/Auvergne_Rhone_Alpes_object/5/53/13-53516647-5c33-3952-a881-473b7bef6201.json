  "rdfs:comment": {
    "de": [
      "La Petite Fabrique steht für den Geist eines Familienrestaurants, in dem jedes Gericht hausgemacht ist und mit frischen Zutaten und vor allem mit viel Liebe zubereitet wird."
    ],
    "en": [
      "La Petite Fabrique is the spirit of a family restaurant, where every dish is homemade, prepared with fresh produce and, above all, a lot of love."
    ],
    "it": [
      "La Petite Fabrique è lo spirito di un ristorante familiare, dove ogni piatto è fatto in casa, preparato con prodotti freschi e, soprattutto, con tanto amore."
    ],
    "fr": [
      "La Petite Fabrique, c’est l’esprit d’un restaurant familial où chaque plat, fait maison, est préparé avec des produits frais et, surtout, avec beaucoup d’amour."
    ],
    "nl": [
      "La Petite Fabrique is de geest van een familierestaurant, waar elk gerecht huisgemaakt is, bereid met verse producten en vooral met veel liefde."
    ],
    "es": [
      "La Petite Fabrique es el espíritu de un restaurante familiar, donde cada plato es casero, preparado con productos frescos y, sobre todo, con mucho amor."
    ]
  },
