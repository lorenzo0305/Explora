  "rdfs:comment": {
    "de": [
      "Der Sumpf Les Lèches, benannt nach einem gewöhnlichen Gras, ist ein schützendes Gehäuse für die Tier- und Pflanzenwelt."
    ],
    "en": [
      "\"Lèche\", a type of grass commonly found in marshes, is what probably gave the name to this marsh in a small combe in the hills of Monts Berthiand, not far from the hamlet of Etables."
    ],
    "it": [
      "La palude di Lèches, che prende il nome da un'erba comune, è un ambiente protettivo per la fauna e la foresta."
    ],
    "fr": [
      "Le marais des Lèches, du nom d'une herbe commune, est un écrin protecteur pour la faune et la fore."
    ],
    "nl": [
      "Het moeras van Lèches, genoemd naar een gewone grassoort, is een beschermende omgeving voor de fauna en het bos."
    ],
    "es": [
      "El pantano de Lèches, que lleva el nombre de una hierba común, es un entorno protector para la fauna y el bosque."
    ]
  },
  "rdfs:label": {
    "en": [
      "The Leches Marsh"
    ],
    "fr": [
      "Marais des Lèches"
    ]
  },
