  "rdfs:comment": {
    "de": [
      "Im Atelier se découpe in Les Astiers finden Sie Aubrac-Rind, Agneaux Noirs du Velay und Milchkälber.\r\nAlle unsere Produkte werden von uns vakuumverpackt."
    ],
    "en": [
      "At the cutting workshop in Les Astiers, you will find Aubrac beef, Velay black lamb and milk-fed calves.\r\nAll our products are vacuum-packed by us."
    ],
    "it": [
      "Presso il laboratorio di taglio di Les Astiers si possono trovare carne di Aubrac, Agneaux Noirs du Velay e Veaux de lait.\r\nTutti i nostri prodotti sono confezionati sottovuoto da noi."
    ],
    "fr": [
      "A l'atelier se découpe aux Astiers, vous trouverez Bœuf Aubrac, Agneaux Noirs du Velay et Veaux de lait.\r\nTous nos produits sont emballés sous-vide par nos soins."
    ],
    "nl": [
      "In de uitsnijderij in Les Astiers vindt u rundvlees uit Aubrac, Agneaux Noirs du Velay en Veaux de lait.\r\nAl onze producten worden door ons vacuüm verpakt."
    ],
    "es": [
      "En el taller de despiece de Les Astiers, encontrará carne de Aubrac, Agneaux Noirs du Velay y Veaux de lait.\r\nTodos nuestros productos son envasados al vacío por nosotros."
    ]
  },
