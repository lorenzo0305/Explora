  "rdfs:comment": {
    "de": [
      "Traditionelle Bar/Restaurant\r\nGeöffnet von Montag bis Freitag mittags.\r\nEinzigartiges Menü\r\nAm Wochenende und an Feiertagen Mittagsöffnung nach vorheriger Reservierung für mindestens 10 Personen."
    ],
    "en": [
      "Traditional bar/restaurant\r\nOpen Monday to Friday lunchtime\r\nSingle menu\r\nWeekends and public holidays, lunchtime opening by prior arrangement for a minimum of 10 people."
    ],
    "it": [
      "Bar/ristorante tradizionale\r\nAperto dal lunedì al venerdì a pranzo\r\nMenu unico\r\nFine settimana e giorni festivi, apertura a pranzo su prenotazione per un minimo di 10 persone."
    ],
    "fr": [
      "Bar/Restaurant traditionnel\r\nOuvert du lundi au vendredi midi \r\nMenu unique\r\nWeek-end et jours fériés ouverture le midi sur réservation à l'avance pour un minimum de 10 personnes."
    ],
    "nl": [
      "Traditionele bar/restaurant\r\nGeopend van maandag tot vrijdag tijdens lunchtijd\r\nEnkel menu\r\nWeekends en feestdagen, lunchopening op afspraak voor minimaal 10 personen."
    ],
    "es": [
      "Bar-restaurante tradicional\r\nAbierto de lunes a viernes al mediodía\r\nMenú único\r\nFines de semana y festivos, apertura al mediodía previa concertación para un mínimo de 10 personas."
    ]
  },
