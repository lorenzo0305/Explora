  "rdfs:comment": {
    "de": [
      "Das Betriebsrestaurant La Garenne ist eine Partnerschaft mit den Unternehmen der Zone Chesnes de Tharabie.\r\nEs gibt verschiedene Mitgliedschaftsmodelle und das Restaurant ist auch für die Öffentlichkeit zugänglich."
    ],
    "en": [
      "The inter-company restaurant La Garenne is in partnership with the companies of the Chesnes de Tharabie area.\r\nSeveral membership formulas are available and the restaurant is also open to the public."
    ],
    "it": [
      "Il ristorante interaziendale La Garenne è in collaborazione con le aziende della zona di Chesnes de Tharabie.\r\nSono disponibili diverse formule di adesione e il ristorante è aperto anche al pubblico."
    ],
    "fr": [
      "Le restaurant inter-entreprises La Garenne est en partenariat avec les entreprises de la zone Chesnes de Tharabie.\r\nPlusieurs formules d'adhésion sont possibles et le restaurant est ouvert également au public."
    ],
    "nl": [
      "Het bedrijfsrestaurant van La Garenne is een samenwerkingsverband met de bedrijven in de regio Chesnes de Tharabie.\r\nEr zijn verschillende lidmaatschapsformules beschikbaar en het restaurant is ook toegankelijk voor het publiek."
    ],
    "es": [
      "El restaurante interempresarial de La Garenne está en colaboración con las empresas de la zona de Chesnes de Tharabie.\r\nExisten varias fórmulas de afiliación y el restaurante también está abierto al público."
    ]
  },
  "rdfs:label": {
