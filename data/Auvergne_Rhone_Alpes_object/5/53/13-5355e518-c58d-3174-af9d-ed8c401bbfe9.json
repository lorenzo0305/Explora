  "rdfs:comment": {
    "de": [
      "Handwerklich hergestellte Pizzen. Entdeckungsangebot:1Kostenlose Pizza, wenn Sie sich auf www.lekiosqueapizzas.com(Nach Ihrer Anmeldung erhalten Sie per E-Mail einen Gutschein für eine gekaufte Pizza =1kostenlose Pizza)."
    ],
    "en": [
      "\"Traditional pizza.\r\nIntroductory offer: Sign up for a free pizza on our website at www.lekiosqueapizzas.com (you’ll then receive by email a buy-one-get-one-free pizza voucher.\""
    ],
    "it": [
      "Pizze fatte in casa.\r\nOfferta scoperta: 1 pizza gratuita registrandosi su www.lekiosqueapizzas.com (dopo la registrazione, si riceverà via e-mail un buono per 1 pizza acquistata = 1 pizza offerta)."
    ],
    "fr": [
      "Pizzas artisanales.\r\nOffre découverte : 1 pizza gratuite en vous inscrivant sur www.lekiosqueapizzas.com (suite à votre inscription, vous recevrez par mail un bon pour une pizza achetée = 1 pizza offerte)."
    ],
    "nl": [
      "Zelfgemaakte pizza's.\r\nOntdekkingsaanbieding: 1 gratis pizza bij registratie op www.lekiosqueapizzas.com (na registratie ontvangt u per e-mail een voucher voor 1 gekochte pizza = 1 gratis pizza)."
    ],
    "es": [
      "Pizzas caseras.\r\nOferta Discovery: 1 pizza gratis al registrarse en www.lekiosqueapizzas.com (después de registrarse, recibirá un vale por correo electrónico por 1 pizza comprada = 1 pizza gratis)."
    ]
  },
