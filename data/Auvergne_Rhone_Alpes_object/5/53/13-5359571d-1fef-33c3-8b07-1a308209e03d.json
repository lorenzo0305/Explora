  "rdfs:comment": {
    "de": [
      "Von Reittourismusbegleitern betreute Ausritte, um das Arves-Tal zu entdecken. Für Kinder gibt es Ausflüge mit Ponys an der Hand, die von den Eltern begleitet werden."
    ],
    "en": [
      "Horseback rides supervised by equestrian tourism guides to discover the Arves valley. For children, pony rides with their parents."
    ],
    "it": [
      "Passeggiate a cavallo seguite da guide di turismo equestre per scoprire la valle di Arves. Per i bambini, passeggiate sui pony con i genitori."
    ],
    "fr": [
      "Balades à cheval encadrées par des accompagnateurs de tourisme équestre pour découvrir la vallée des Arves. Pour les enfants, des balades poneys en main, avec les parents."
    ],
    "nl": [
      "Tochten te paard onder begeleiding van gidsen voor paardentoerisme om de vallei van Arves te ontdekken. Voor kinderen, ponyritjes met hun ouders."
    ],
    "es": [
      "Paseos a caballo supervisados por guías de turismo ecuestre para descubrir el valle de Arves. Para los niños, paseos en poni con sus padres."
    ]
  },
