  "rdfs:comment": {
    "de": [
      "Houria Nommay empfängt Sie in Condorcet und bietet Ihnen Entspannungs-, Reflexzonen- und Ayurveda-Massagen sowie Körperbehandlungen an. Genießen Sie ein bis zwei Stunden Entspannung, um sich von Muskelverspannungen und Stress zu befreien."
    ],
    "en": [
      "Houria Nommay welcomes you in Condorcet and offers relaxation massages, reflexology and body treatments. Enjoy one to two hours of relaxation and well-being to free you from your muscular tensions and stress."
    ],
    "it": [
      "Houria Nommay vi dà il benvenuto a Condorcet e vi offre massaggi rilassanti, riflessologici e ayurvedici, nonché trattamenti per il corpo. Godetevi una o due ore di relax per alleviare le tensioni muscolari e lo stress."
    ],
    "fr": [
      "Houria Nommay vous accueille à Condorcet et vous propose des massages de relaxation, de réflexologie et Ayurvédique ainsi que des soins du corps. Profitez d'une à deux heures de détente pour vous libérer de vos tensions musculaires et de votre stress."
    ],
    "nl": [
      "Houria Nommay verwelkomt u in Condorcet en biedt ontspanningsmassages, reflexologie en lichaamsbehandelingen. Geniet van één tot twee uur ontspanning en welzijn om uzelf te bevrijden van spierspanning en stress."
    ],
    "es": [
      "Houria Nommay le da la bienvenida a Condorcet y le ofrece masajes de relajación, reflexología y ayurvédicos, así como tratamientos corporales. Disfrute de una o dos horas de relajación para aliviar la tensión muscular y el estrés."
    ]
  },
  "rdfs:label": {
    "fr": [
