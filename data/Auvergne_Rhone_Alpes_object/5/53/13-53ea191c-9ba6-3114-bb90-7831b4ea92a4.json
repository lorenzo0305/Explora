  "rdfs:comment": {
    "de": [
      "Unsere Bar und Restaurant Au Torè, unser orientalischer Feinkostladen BLED oder auch unsere lebhafte Lounge-Bar heißen Sie für einen köstlichen und herzlichen Moment willkommen. Hier kommen alle auf ihre Kosten, die gerne teilen und gut essen."
    ],
    "en": [
      "Our Bar and Restaurant Au Torè, our Oriental delicatessen BLED, and our lively lounge bar welcome you for a warm and tasty meal. Enough to satisfy the bon vivants, those who like to share and eat well."
    ],
    "it": [
      "Il nostro Bar e Ristorante Au Torè, la nostra gastronomia orientale BLED e il nostro vivace lounge bar vi accolgono per un pasto caldo e gustoso. C'è qualcosa per tutti coloro che amano condividere e mangiare bene."
    ],
    "fr": [
      "Notre Bar et Restaurant Au Torè, notre Epicerie fine orientale BLED, ou encore notre bar lounge animé vous accueillent pour un moment savoureux et chaleureux. De quoi satisfaire les bons vivants, ceux qui aiment partager et bien manger."
    ],
    "nl": [
      "Onze bar en restaurant Au Torè, onze oosterse delicatessenzaak BLED en onze levendige loungebar verwelkomen je voor een warme en smakelijke maaltijd. Er is iets voor iedereen die graag deelt en lekker eet."
    ],
    "es": [
      "Nuestro Bar y Restaurante Au Torè, nuestra charcutería oriental BLED y nuestro animado bar salón le dan la bienvenida para que disfrute de una comida cálida y sabrosa. Hay algo para todos a los que les gusta compartir y comer bien."
    ]
  },
