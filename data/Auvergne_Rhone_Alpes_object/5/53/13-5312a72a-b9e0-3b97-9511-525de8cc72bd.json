  "rdfs:comment": {
    "de": [
      "Öffnen Sie die Tür des ehemaligen Zollhauses von Châtel und werfen Sie einen neuen Blick auf das Grenzgebiet."
    ],
    "en": [
      "Open the door of Châtel's Old Customs House to discover a different side to this cross-border region."
    ],
    "it": [
      "Aprite la porta dell'ex dogana di Châtel e date uno sguardo nuovo alla regione di confine."
    ],
    "fr": [
      "Poussez la porte de l'ancienne douane de Châtel et portez un regard nouveau sur le territoire frontalier."
    ],
    "nl": [
      "Het oude douane kantoor, het bezoekerscentrum over smokkelpraktijken in de bergen. Stap het oude douanekantoor van Châtel binnen en werp een nieuwe blik op het grensgebied."
    ],
    "es": [
      "Abra la puerta de la antigua aduana de Châtel y eche un vistazo a la zona fronteriza."
    ]
  },
