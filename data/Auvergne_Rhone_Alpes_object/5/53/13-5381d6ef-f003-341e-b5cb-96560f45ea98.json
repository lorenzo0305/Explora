  "rdfs:comment": {
    "de": [
      "Ob mit der Familie, mit Freunden oder auf Geschäftsreise, das Team des Mercure-Hotels empfängt Sie in einem herzlichen Rahmen. Das Restaurant mit seiner hausgemachten Küche, der üppige Garten und der Fitnessraum werden Ihren Aufenthalt zu einer ausgezeichneten Zeit machen. Bis bald!"
    ],
    "en": [
      "Whether you're with family, friends or on business, the Mercure hotel team welcomes you in a warm and friendly atmosphere. The restaurant and its home cooking, the lush garden and the fitness room will make your stay a memorable one. See you soon!"
    ],
    "it": [
      "In famiglia o con gli amici, per lavoro, il team dell'hotel Mercure vi accoglie in un'atmosfera calorosa. Il ristorante e la sua cucina casalinga, il giardino lussureggiante, la sala fitness renderanno il vostro soggiorno un momento eccellente. A presto!"
    ],
    "fr": [
      "En famille ou entre amis, pour affaires, l'équipe de l'hôtel Mercure vous accueille dans un cadre chaleureux. Le restaurant et sa cuisine maison, son jardin luxuriant, sa salle de fitness feront de votre séjour un excellent moment. A très bientôt !"
    ],
    "nl": [
      "Met familie of vrienden, op zakenreis, het team van het Mercure hotel verwelkomt u in een warme sfeer. Het restaurant en de huiselijke keuken, de weelderige tuin, de fitnessruimte maken van uw verblijf een uitstekend moment. Tot ziens!"
    ],
    "es": [
      "En familia o con amigos, por negocios, el equipo del hotel Mercure le da la bienvenida en un ambiente cálido. El restaurante y su cocina casera, su exuberante jardín, su sala de fitness harán de su estancia un momento excelente. Hasta pronto"
    ]
  },
