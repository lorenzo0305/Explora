  "rdfs:comment": {
    "de": [
      "Einmaliges Konzept in Haute-Savoie, 5 km von Genf entfernt! Marie-Laure und Eric erwarten Sie im authentischen Rahmen eines Bauernhofs aus dem Jahr 1900. Die geschmackvoll eingerichteten 9 Zimmer und 4 Suiten sind eine Verbindung aus modernem Komfort und gemütlichem, ruhigem Ambiente."
    ],
    "en": [
      "Unique concept in Haute-Savoie, 5km from Geneva! Marie Laure and Éric welcome you to the authentic setting of an early 1900s farm. The tastefully decorated 9 rooms and 4 suites combine modern comfort with a cosy, calm and welcoming atmosphere."
    ],
    "it": [
      "Un concetto unico in Alta Savoia, a 5 km da Ginevra! Marie Laure ed Éric vi danno il benvenuto nell'ambiente autentico di una fattoria del 1900. Le 9 camere e le 4 suite sono arredate con gusto e combinano i comfort moderni con un'atmosfera accogliente, calma e calda."
    ],
    "fr": [
      "Concept unique en Haute-Savoie, à 5km de Genève ! Marie Laure et Éric vous accueillent dans le cadre authentique d'une ferme de 1900. Les 9 chambres et les 4 suites aménagées avec goût, allient le confort moderne à une ambiance cosy, calme et chaleureuse."
    ],
    "es": [
      "¡Un concepto único en Alta Saboya, a 5 km de Ginebra! Marie Laure y Eric le recibirán en una granja auténtica de principios de 1900. Su 9 habitaciones y sus 4 suites, decoradas con refinamiento, combinan la comodidad moderna con un ambiente acogedor, tranquilo y cálido."
    ],
    "nl": [
      "Uniek concept in de Haute-Savoie, op 5 km van Genève! Marie Laure en Eric ontvangen u in het authentieke kader van een boerderij uit 1900. De 9 kamers en 4 suites zijn smaakvol ingericht en combineren modern comfort met een gezellige, rustige en warme sfeer."
    ]
  },
