  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Geschichte derAusrüstung der Feuerwehr und der Retterder gesamten Haute Savoie, von den1930er Jahren bis heute: Handpumpen, Fahrzeuge, Kleidung, Videos..."
    ],
    "en": [
      "Discover the history of the equipment of the Fire Brigade and that of the rescuers of the whole Haute-Savoie, from the 1930s to the present day: hand pumps, vehicles, clothing, videos…"
    ],
    "it": [
      "Questo museo, consacrato alla storia delle attrezzature dei pompieri, riapre le sue porte dopo alcuni lavori di ristrutturazione. La visita dura 30 min./1 ora."
    ],
    "fr": [
      "Découvrez l'histoire du matériel des Sapeurs-Pompiers et celle des sauveteurs de toute la Haute-Savoie, depuis les années 1930 à nos jours: pompes à bras, véhicules, tenues, vidéos ..."
    ],
    "nl": [
      "Ontdek de geschiedenis van het brandweermateriaal en dat van de redders uit de hele Haute-Savoie, van de jaren 1930 tot nu: handpompen, voertuigen, uitrustingen, video's ..."
    ],
    "es": [
      "Descubra la historia del equipamiento de los bomberos y de los socorristas de toda la Alta Saboya, desde los años 30 hasta la actualidad: bombas manuales, vehículos, trajes, vídeos..."
    ]
  },
  "rdfs:label": {
    "de": [
      "Prefectural Feuerwehr Museum"
    ],
    "en": [
      "Firemen’s Museum of Haute-Savoie"
    ],
    "it": [
      "Museo dipartimentale dei pompieri dell'Alta Savoia"
    ],
    "fr": [
      "Musée Départemental des Sapeurs-Pompiers de Haute-Savoie"
    ],
    "es": [
      "Museo Departamental de Bomberos de la Alta Saboya"
    ]
  },
