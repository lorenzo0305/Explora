  "rdfs:comment": {
    "de": [
      "Die Kirche ist Saint-Albain gewidmet und wurde 1872 erbaut. Sie besitzt schöne zeitgenössische Glasfenster und hat einen weiten Blick über das Tal."
    ],
    "en": [
      "Dedicated to Saint-Albain, the church was built in 1872. It boasts attractive contemporary stained glass windows and an unobstructed view over the valley."
    ],
    "it": [
      "Dedicata a Saint-Albain, la chiesa fu costruita nel 1872. Vanta splendide vetrate contemporanee e una vista ininterrotta sulla valle."
    ],
    "fr": [
      "Dédiée à Saint-Albain l'église fut construite en 1872. Elle bénéfice de jolis vitraux contemporains et de par sa positon, d'une vue dégagée sur la vallée."
    ],
    "es": [
      "Dedicada a Saint-Albain, la iglesia se construyó en 1872. Cuenta con hermosas vidrieras contemporáneas y una vista ininterrumpida sobre el valle."
    ],
    "nl": [
      "De kerk is gewijd aan Saint-Albain en werd gebouwd in 1872. Het heeft prachtige hedendaagse gebrandschilderde ramen en een ononderbroken uitzicht over de vallei."
    ]
  },
