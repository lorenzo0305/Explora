  "rdfs:comment": {
    "de": [
      "Grive Épicier - Bistrotier befindet sich auf dem Place Benoît Crepu im Vieux-Lyon und bietet Ihnen ein kulinarisches Erlebnis, bei dem Kreativität auf frische und lokale Produkte trifft."
    ],
    "en": [
      "Located on Place Benoît-Crépu in Vieux Lyon, Grive Épicier - Bistrotier offers you a culinary experience where creativity meets fresh, local produce, all in a warm and friendly setting."
    ],
    "it": [
      "Situato in Place Benoît Crepu nella Vieux-Lyon, Grive Épicier - Bistrotier offre un'esperienza culinaria in cui la creatività incontra i prodotti freschi locali, il tutto in un ambiente caldo e accogliente."
    ],
    "fr": [
      "Installé sur la place Benoît Crepu dans le Vieux-Lyon, Grive Épicier - Bistrotier vous propose une expérience culinaire où la créativité rencontre les produits frais et locaux, le tout dans un cadre convivial et chaleureux."
    ],
    "es": [
      "Situado en la Place Benoît Crepu, en Vieux-Lyon, Grive Épicier - Bistrotier ofrece una experiencia culinaria en la que la creatividad se une a los productos locales frescos, todo ello en un ambiente cálido y acogedor."
    ],
    "nl": [
      "Gelegen aan de Place Benoît Crepu in Vieux-Lyon, biedt Grive Épicier - Bistrotier een culinaire ervaring waar creativiteit samenkomt met verse lokale producten, allemaal in een warme en vriendelijke omgeving."
    ]
  },
