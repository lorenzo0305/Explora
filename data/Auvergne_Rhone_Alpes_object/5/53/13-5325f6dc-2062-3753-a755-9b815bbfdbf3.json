  "rdfs:comment": {
    "de": [
      "Die Domaine Escalin ist ein außergewöhnliches Terroir im Herzen der provenzalischen Drôme. Sie ist das Ergebnis einer harmonischen Verbindung zwischen zwei einzigartigen Terroirs: Vergobbi mit seinen großen Kieselsteinen und Escalin mit seinen Kalksplittern."
    ],
    "en": [
      "Domaine Escalin is an exceptional terroir, nestled in the heart of the Drôme provençale, and is the fruit of a harmonious marriage between two unique terroirs: Vergobbi, with its large pebbles, and Escalin, composed of limestone fragments."
    ],
    "it": [
      "Il Domaine Escalin è un terroir eccezionale, incastonato nel cuore della Drôme Provençale, frutto dell'armonioso connubio tra due terroir unici: Vergobbi, con i suoi grandi ciottoli, ed Escalin, costituito da pezzi di calcare."
    ],
    "fr": [
      "Le Domaine Escalin est un terroir d' exception, niché au cœur de la Drôme provençale, est le fruit d'un mariage harmonieux entre deux terroirs uniques: celui de Vergobbi, avec ses gros galets, et celui d'Escalin, composé d' éclats calcaires."
    ],
    "es": [
      "El Domaine Escalin es un terruño excepcional, enclavado en el corazón de la Drôme provenzal, fruto de la unión armoniosa de dos terruños únicos: Vergobbi, con sus grandes guijarros, y Escalin, formado por trozos de piedra caliza."
    ],
    "nl": [
      "Domaine Escalin is een uitzonderlijk terroir, genesteld in het hart van de Drôme Provençale. Het is de vrucht van een harmonieus huwelijk tussen twee unieke terroirs: Vergobbi, met zijn grote kiezelstenen, en Escalin, dat bestaat uit brokken kalksteen."
    ]
  },
  "rdfs:label": {
