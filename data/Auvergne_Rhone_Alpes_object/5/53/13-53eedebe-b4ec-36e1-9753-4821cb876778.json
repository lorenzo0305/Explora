  "rdfs:comment": {
    "de": [
      "La Raymonde ist ein Folkrock-Trio, das aus dem Westen kommt!\r\n\"Ein Kontrabass, eine Gitarre, Mundharmonikas, ein Akkordeon, zwei Stimmen und ein Tamburin treiben ihr Unwesen."
    ],
    "en": [
      "La Raymonde is a folk-rock trio from the West!\r\n\"A double bass, a guitar, harmonicas, an accordion, two voices and a tambourine."
    ],
    "it": [
      "La Raymonde è un trio folk-rock dell'ovest della Francia!\r\n\"Un contrabbasso, una chitarra, armoniche, una fisarmonica, due voci e un tamburello."
    ],
    "fr": [
      "La Raymonde est un Trio Folk rock, des baroudeurs qui nous viennent de l'ouest!\r\n\"Une contrebasse, une guitare, des harmonicas, un accordéon, deux voix et un tambourin y sévissent."
    ],
    "nl": [
      "La Raymonde is een folkrocktrio uit het westen van Frankrijk!\r\n\"Een contrabas, een gitaar, harmonica's, een accordeon, twee stemmen en een tamboerijn."
    ],
    "es": [
      "La Raymonde es un trío de folk-rock del oeste de Francia\r\n\"Un contrabajo, una guitarra, armónicas, un acordeón, dos voces y una pandereta."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Concert Folk/Rock : \"La Raymonde\""
    ]
  },
