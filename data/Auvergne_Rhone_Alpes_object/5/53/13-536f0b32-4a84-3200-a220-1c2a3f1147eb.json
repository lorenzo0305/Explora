  "rdfs:comment": {
    "de": [
      "Genießen Sie vor oder nach Ihrem Skitag einen heißen Crêpe, Kaffee oder heiße Schokolade und viele andere Snacks zum Mitnehmen am Fuße der Pisten."
    ],
    "en": [
      "Enjoy a hot pancake, coffee or hot chocolate and many other snacks to take away at the foot of the slopes before or after your ski day."
    ],
    "it": [
      "Godetevi un pancake caldo, un caffè o una cioccolata calda e molti altri snack da portare via ai piedi delle piste prima o dopo la vostra giornata sugli sci."
    ],
    "fr": [
      "Déguster une crêpe bien chaude, café ou chocolat chaud et bien d'autres snacking à emporter au pied des pistes avant ou après votre journée de ski."
    ],
    "nl": [
      "Geniet van een warme crêpe, koffie of warme chocolademelk en vele andere snacks om mee te nemen aan de voet van de pistes voor of na het skiën."
    ],
    "es": [
      "Disfruta de una tortita caliente, café o chocolate caliente y muchos otros aperitivos para llevar a pie de pista antes o después de tu jornada de esquí."
    ]
