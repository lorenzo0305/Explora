  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Seifenstücke von Florence Renaudier. Sie bietet Ihnen die Möglichkeit, ihre Produkte auf dem Bauernmarkt in Saint-Victor-Malescours zu entdecken, der von April bis Ende des Jahres jeden zweiten Sonntag im Monat von 9:30 bis 12:00 Uhr stattfindet."
    ],
    "en": [
      "Discover Florence Renaudier's soaps. You can discover her products at the Saint-Victor-Malescours farmers? market every 2nd Sunday of the month from 9:30am to 12pm, from April until the end of the year."
    ],
    "it": [
      "Scoprite i saponi di Florence Renaudier. Potete scoprire i suoi prodotti al mercato contadino di Saint-Victor-Malescours ogni seconda domenica del mese dalle 9.30 alle 12.00, da aprile fino alla fine dell'anno."
    ],
    "fr": [
      "Découvrez les savonnettes de Florence Renaudier. Elle vous propose de découvrir ses produits lors du marché des producteurs de Saint-Victor-Malescours tous les 2es dimanches de chaque mois de 9h30 à 12h, à partir du mois d’avril jusqu’en fin d’année."
    ],
    "nl": [
      "Ontdek de zepen van Florence Renaudier. Je kunt haar producten ontdekken op de boerenmarkt van Saint-Victor-Malescours, elke 2e zondag van de maand van 9.30 tot 12.00 uur, van april tot het einde van het jaar."
    ],
    "es": [
      "Descubra los jabones de Florence Renaudier. Podrá descubrir sus productos en el mercado agrícola de Saint-Victor-Malescours todos los segundos domingos de mes, de 9:30 a 12:00, desde abril hasta finales de año."
    ]
  },
  "rdfs:label": {
