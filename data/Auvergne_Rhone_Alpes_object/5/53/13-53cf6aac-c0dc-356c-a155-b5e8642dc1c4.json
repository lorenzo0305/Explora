  "rdfs:comment": {
    "de": [
      "Schickes, aber entspanntes Ambiente. Offene Küche. Frische Produkte. Keine Speisekarte, sondern Menüs von Tag zu Tag und je nach Jahreszeit. Französisch-italienische Küche. Schöne Weinkarte. Empfehlung Petit Futé 2026."
    ],
    "en": [
      "In a chic but relaxed ambiance, beige and black.  Open kitchen. Fresh products. No menu but dishes of the day and of the season."
    ],
    "it": [
      "Atmosfera chic e rilassata. Cucina aperta. Prodotti freschi. Nessun menu à la carte, solo menu giornalieri e stagionali. Cucina franco-italiana. Bella carta dei vini. Consigliato da Petit Futé 2026."
    ],
    "fr": [
      "Ambiance chic mais décontractée. Cuisine ouverte. Produits frais. Pas de carte mais des menus au jour le jour et au fil des saisons. Cuisine Franco-Italienne. Belle carte des vins. Recommandation Petit Futé 2026."
    ],
    "nl": [
      "Chique maar ontspannen sfeer. Open keuken. Verse producten. Geen à la carte menu, alleen dagelijkse, seizoensgebonden menu's. Frans-Italiaanse keuken. Mooie wijnkaart. Aanbevolen door Petit Futé 2026."
    ],
    "es": [
      "Ambiente elegante y relajado. Cocina abierta. Productos frescos. No hay menú a la carta, sino menús diarios de temporada. Cocina francoitaliana. Buena carta de vinos. Recomendado por Petit Futé 2026."
    ]
  },
