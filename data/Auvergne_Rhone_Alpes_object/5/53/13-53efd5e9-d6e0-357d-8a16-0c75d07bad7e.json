  "rdfs:comment": {
    "de": [
      "Der 18-Loch-Golfplatz von Tignes (der höchste in Europa!) liegt auf 2100 m Höhe unterhalb des Grande Motte-Gletschers und bietet ein außergewöhnliches Panorama auf den See von Tignes."
    ],
    "en": [
      "The 18-hole golf course in Tignes (the highest in Europe!), located at an altitude of 2100 m, below the Grande Motte glacier, offers an exceptional panorama of Lake Tignes."
    ],
    "it": [
      "Il campo da golf a 18 buche di Tignes (il più alto d'Europa!), situato a 2100 m di altitudine, sotto il ghiacciaio della Grande Motte, offre una vista panoramica eccezionale sul Lac de Tignes."
    ],
    "fr": [
      "Le golf 18 trous de Tignes (le plus haut d’Europe !), situé à 2100 m d’altitude, en contrebas du glacier de la Grande Motte, offre un panorama exceptionnel sur le lac de Tignes."
    ],
    "es": [
      "El campo de golf de 18 hoyos de Tignes (¡el más alto de Europa!), situado a 2.100 m de altitud, bajo el glaciar de la Grande Motte, ofrece una vista panorámica excepcional del lago de Tignes."
    ],
    "nl": [
      "De 18-holes golfbaan van Tignes (de hoogste van Europa!), gelegen op 2100 m hoogte, onder de gletsjer van de Grande Motte, biedt een uitzonderlijk panoramisch uitzicht op het Lac de Tignes."
    ]
  },
