  "rdfs:comment": {
    "de": [
      "Das 100' Ain bietet Ihnen das ganze Jahr über eine Pizzakarte vor Ort und zum Mitnehmen, frische Salate, Pasta mit originellen Soßen und vor Ort zubereitete Desserts in einer freundlichen Atmosphäre."
    ],
    "en": [
      "The 100' Ain restaurant offers you all year long, a pizza menu on the spot and to take away, a daily special and suggestion menu, desserts made on the spot, all in a friendly atmosphere."
    ],
    "it": [
      "Le 100' Ain vi offre tutto l'anno un menu di pizze da mangiare e da portare via, insalate fresche, pasta e i suoi sughi originali, dolci fatti sul momento, il tutto in un'atmosfera amichevole."
    ],
    "fr": [
      "Le 100' Ain vous propose toute l'année, une carte de pizzas sur place et à emporter, des salades fraîches, des pâtes et ses sauces originales, des desserts confectionnés sur place, le tout dans une ambiance conviviale."
    ],
    "es": [
      "Le 100' Ain le ofrece durante todo el año una carta de pizzas para comer y llevar, ensaladas frescas, pasta y sus originales salsas, postres hechos al momento, todo ello en un ambiente acogedor."
    ],
    "nl": [
      "De 100' Ain biedt u het hele jaar door een menu van pizza's om te eten en om mee te nemen, verse salades, pasta en zijn originele sauzen, ter plaatse gemaakte desserts, en dat alles in een gezellige sfeer."
    ]
  },
