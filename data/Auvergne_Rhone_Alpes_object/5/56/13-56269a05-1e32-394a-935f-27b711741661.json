  "rdfs:comment": {
    "de": [
      "Das Relais du Château bietet einen atemberaubenden Blick auf das Château de la Roche und ist dank seiner seit über 50 Jahren bestehenden Spezialität, den Fröschen, zu einem unverzichtbaren Tisch im Roannais geworden."
    ],
    "en": [
      "The restaurant «Le Relais du Château» is situated on the\r\nedge of the Loire offering unobstructed views of the\r\nChâteau de la Roche"
    ],
    "it": [
      "Con una vista mozzafiato sullo Château de la Roche, il Relais du Château è diventato un must della regione del Roannais grazie alla sua specialità da oltre 50 anni: le rane."
    ],
    "fr": [
      "Offrant une vue imprenable sur le Château de la Roche, le Relais du Château est devenu une table incontournable du Roannais grâce à sa spécialité depuis plus de 50 ans : les grenouilles."
    ],
    "nl": [
      "Het Relais du Château, met een adembenemend uitzicht op het Château de la Roche, is al meer dan 50 jaar een must in de Roannais-streek dankzij zijn specialiteit: kikkers."
    ],
    "es": [
      "Con una vista impresionante del Château de la Roche, el Relais du Château se ha convertido en una visita obligada en la región de Roannais gracias a su especialidad desde hace más de 50 años: las ranas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Relais du Château"
    ]
  },
