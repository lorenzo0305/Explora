  "rdfs:comment": {
    "de": [
      "Kommen Sie und feuern Sie die besten internationalen Badmintonhoffnungen der U19 an. Seit 2019 ist das FZ FORZA U19-Turnier ein Pflichttermin, bei dem Intensität, Talent und Leidenschaft bei jedem Ballwechsel aufeinandertreffen."
    ],
    "en": [
      "Come and cheer on the best international U19 badminton hopefuls. Since 2019, the FZ FORZA U19 tournament has been a not-to-be-missed event, where intensity, talent and passion meet in every exchange."
    ],
    "it": [
      "Venite a fare il tifo per le migliori speranze internazionali del badminton U19. Dal 2019, il torneo FZ FORZA U19 è un evento imperdibile, dove intensità, talento e passione si incontrano in ogni scambio."
    ],
    "fr": [
      "Venez encourager les meilleurs espoirs internationaux du badminton U19. Depuis 2019, le tournoi U19 FZ FORZA est un rendez-vous incontournable, où intensité, talent et passion se rencontrent sur chaque échange."
    ],
    "es": [
      "Ven a animar a las mejores promesas internacionales del bádminton sub19. Desde 2019, el torneo FZ FORZA U19 es una cita ineludible, donde la intensidad, el talento y la pasión se dan cita en cada intercambio."
    ],
    "nl": [
      "Kom de beste internationale U19-badmintonbeloften aanmoedigen. Sinds 2019 is het FZ FORZA U19-toernooi een niet te missen evenement, waar intensiteit, talent en passie elkaar ontmoeten in elke uitwisseling."
    ]
  },
