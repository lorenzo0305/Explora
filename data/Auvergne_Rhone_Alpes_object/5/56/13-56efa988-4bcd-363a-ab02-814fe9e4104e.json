  "rdfs:comment": {
    "de": [
      "Der Run & Fun du Giffre ist ein einzigartiges Erlebnis für alle Läufer!\r\nFestliche Atmosphäre, mitreißende Musik und Animationen entlang der Strecke. Entdecken Sie die wunderschönen Wanderwege am Fil du Giffre und haben Sie dabei auch noch Spaß!"
    ],
    "en": [
      "The Run & Fun du Giffre is a unique experience for all runners!\r\nFestive atmosphere, lively music and entertainment along the way. Come and discover the magnificent trails of the Fil du Giffre while having fun!"
    ],
    "it": [
      "La Run & Fun du Giffre è un'esperienza unica per tutti i corridori!\r\nUn'atmosfera festosa, musica vivace e intrattenimento lungo tutto il percorso. Venite a scoprire i magnifici sentieri della Giffre divertendovi!"
    ],
    "fr": [
      "Le Run & Fun du Giffre, c'est une expérience unique pour tous les coureurs !\r\nAmbiance festive, musique entraînante, et animations tout au long du parcours. Venez découvrir les magnifiques sentiers au Fil du Giffre tout en vous amusant !"
    ],
    "es": [
      "El Run & Fun du Giffre es una experiencia única para todos los corredores\r\nAmbiente festivo, música animada y animaciones a lo largo de todo el recorrido. Venga a descubrir los magníficos senderos del Giffre mientras se divierte"
    ],
    "nl": [
      "De Run & Fun du Giffre is een unieke ervaring voor alle lopers!\r\nEen feestelijke sfeer, levendige muziek en entertainment langs het hele parcours. Kom en ontdek de prachtige paden langs de Giffre terwijl je plezier hebt!"
    ]
  },
