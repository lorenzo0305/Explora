  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/d1835b27-7758-3167-b7d4-646abace0190",
      "dc:description": {
        "de": [
          "Kostümwettbewerb für Kinder von 3 bis 12 Jahren.\n\nVon 15:00 bis 16:30 Uhr, Quentovic-Platz (Bascoulergue-Saal bei schlechtem Wetter).\nAnmeldung online und dann vor Ort von 14 bis 15 Uhr.\nAnschließend gibt es um 16:30 Uhr einen Imbiss.\n\nAlterskategorien:\n3 / 5 Jahre\n6 / 8 Jahre\n9 / 12 Jahre"
        ],
        "en": [
          "Costume contest for children aged 3 to 12.\n\nFrom 3 pm to 4:30 pm, Place Quentovic (Salle Bascoulergue in case of bad weather).\nRegistration online, then on site from 2pm to 3pm.\nFollowed by a snack at 4:30pm.\n\nAge categories :\n3 / 5 years\n6 / 8 years old\n9 / 12 years old"
        ],
        "it": [
          "Concorso in maschera per bambini dai 3 ai 12 anni.\n\nDalle 15.00 alle 16.30, Place Quentovic (Salle Bascoulergue in caso di maltempo).\nIscrizioni online, poi sul posto dalle 14.00 alle 15.00.\nSeguirà una merenda alle 16.30.\n\nCategorie di età :\n3 / 5 anni\nda 6 a 8 anni\n9 / 12 anni"
        ],
        "fr": [
          "Concours de déguisements pour les enfants de 3 à 12 ans.\n\nDe 15h à 16h30, place Quentovic (Salle Bascoulergue en cas de mauvais temps).\nInscriptions en ligne puis sur place de 14h à 15h.\nSuivi d’un goûter à 16h30.\n\nCatégories d'âges :\n3 / 5 ans\n6 / 8 ans\n9 / 12 ans"
        ],
        "nl": [
          "Verkleedwedstrijd voor kinderen van 3 tot 12 jaar.\n\nVan 15.00 tot 16.30 uur, Quentovicplein (Salle Bascoulergue bij slecht weer).\nInschrijving online, daarna ter plaatse van 14.00 tot 15.00 uur.\nGevolgd door een snack om 16.30 uur.\n\nLeeftijdscategorieën :\n3 / 5 jaar\n6 tot 8 jaar\n9 / 12 jaar"
        ],
        "es": [
          "Concurso de disfraces para niños de 3 a 12 años.\n\nDe 15:00 a 16:30 h, plaza Quentovic (sala Bascoulergue en caso de mal tiempo).\nInscripciones en línea e in situ de 14:00 a 15:00 horas.\nMerienda a las 16.30 h.\n\nCategorías de edad :\n3 / 5 años\n6 a 8 años\n9 a 12 años"
        ]
      },
