  "rdfs:comment": {
    "de": [
      "Ein Restaurantteil für Gäste, die sich gerne aufhalten (Reservierung dringend empfohlen), und ein Selbstbedienungsrestaurant für diejenigen, die es eilig haben, die Hänge des Skigebiets hinunterzufahren."
    ],
    "en": [
      "Seated restaurant area for customers who prefer table service (we strongly recommend booking) and a self-service section for those who are in a hurry to get back on the slopes. Access via Colosses or Bergerie chairlift, then down Trieuse slope."
    ],
    "it": [
      "C'è una sezione ristorante per chi ama il relax (si consiglia vivamente la prenotazione) e una sezione self-service per chi ha fretta di andare sulle piste. Si accede tramite le seggiovie Colosses o Bergerie, poi si scende lungo la pista Trieuse."
    ],
    "fr": [
      "Une partie restaurant pour une clientèle qui aime se poser (réservation fortement conseillée) et une partie self pour les plus pressé de dévaler les pentes du domaine.Accès par le télésiège des Colosses ou de la Bergerie,descendre piste de la Trieuse."
    ],
    "nl": [
      "Er is een restaurantgedeelte voor degenen die willen ontspannen (reserveren wordt sterk aanbevolen) en een zelfbedieningsgedeelte voor degenen die haast hebben om de pistes op te gaan. Toegang via de stoeltjesliften Colosses of Bergerie, dan de Trieuse-piste af."
    ],
    "es": [
      "Dispone de una sección de restauración para los que prefieran relajarse (se recomienda reservar) y una sección de autoservicio para los que tengan prisa por lanzarse a las pistas. Se accede a través de los telesillas Colosses o Bergerie, y luego por la pista Trieuse."
    ]
  },
