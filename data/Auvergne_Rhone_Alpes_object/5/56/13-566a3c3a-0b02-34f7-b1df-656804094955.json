  "rdfs:comment": {
    "de": [
      "Machen Sie sich auf, um die \"Geheimnisse der Natur\" aufzuspüren! Diese ca. 4 km lange Schnitzeljagd für Jung (ab 7 Jahren) und Alt führt Sie durch bemerkenswerte Landschaften! Start: Domaine Rocheville in Nyons. Überraschungsgeschenk auf dem Rückweg."
    ],
    "en": [
      "Uncover Nature's Secrets! This 4 km treasure hunt, for children (aged 7 and over) and adults alike, will take you through some remarkable landscapes! Departure from Domaine Rocheville, Nyons. Surprise gift on return."
    ],
    "it": [
      "Andate a scoprire i \"Segreti della Natura\"! Questa caccia al tesoro di 4 km, per bambini (a partire dai 7 anni) e adulti, vi porterà attraverso paesaggi straordinari! Partenza dal Domaine Rocheville a Nyons. Regalo a sorpresa al ritorno."
    ],
    "fr": [
      "Partez débusquer les \"Secrets de Nature\" ! Ce jeu de piste d'environ 4 km, pour petits (à partir de 7 ans) et grands, vous amènera dans des paysages remarquables ! Départ du Domaine Rocheville à Nyons. Cadeau surprise au retour."
    ],
    "es": [
      "¡Vaya a buscar los \"Secretos de la Naturaleza\"! Esta búsqueda del tesoro de 4 km, para niños (a partir de 7 años) y adultos, le llevará a través de notables paisajes Salida del Domaine Rocheville en Nyons. Regalo sorpresa a la vuelta."
    ],
    "nl": [
      "Ga op jacht naar de geheimen van de natuur! Deze speurtocht van 4 km, voor kinderen (vanaf 7 jaar) en volwassenen, voert je door opmerkelijke landschappen! Vertrek vanaf Domaine Rocheville in Nyons. Verrassingscadeau bij terugkeer."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Jeu de piste dans les vignes et les oliviers !"
    ]
  },
