  "rdfs:comment": {
    "de": [
      "Der Zugang ist frei. Dieser Garten befindet sich im historischen Zentrum der Stadt Montluçon und bietet einen sehr strukturierten und angenehmen Rahmen mit schönen Baum- und Straucharten."
    ],
    "en": [
      "Free access. This garden is located in the historic center of Montluçon, and offers a very structured and pleasant setting with beautiful trees and shrubs."
    ],
    "it": [
      "Accesso libero. Questo giardino si trova nel centro storico della città di Montluçon e offre un ambiente molto strutturato e piacevole con belle specie di alberi e arbusti."
    ],
    "fr": [
      "Accès libre. Ce jardin est  situé dans le centre historique de la ville de Montluçon et offre un cadre très structuré et agréable avec de belles essences d'arbres et d'arbustes."
    ],
    "nl": [
      "Gratis toegang. Deze tuin ligt in het historische centrum van de stad Montluçon en biedt een zeer gestructureerde en aangename omgeving met prachtige soorten bomen en struiken."
    ],
    "es": [
      "Acceso gratuito. Este jardín está situado en el centro histórico de la ciudad de Montluçon y ofrece un entorno muy estructurado y agradable con hermosas especies de árboles y arbustos."
    ]
  },
