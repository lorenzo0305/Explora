  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/85ec3735-7c65-3b8e-a62b-6df88307e53d",
      "dc:description": {
        "de": [
          "Entdecken oder wiederentdecken Sie das Leben in der Siedlung 8.\nEin Fremdenführer wird Ihnen das Leben der Siedlung während des Bergbaus, ihre Gegenwart und ihre Zukunft näher bringen."
        ],
        "en": [
          "Come and discover or rediscover the life of cité 8.\nA tour guide will take you back to the life of the town during the mining era, and show you its present and future."
        ],
        "it": [
          "Venite a scoprire o a riscoprire la vita della città 8.\nUna guida turistica vi farà rivivere la vita della città durante l'epoca mineraria e vi mostrerà il suo presente e il suo futuro."
        ],
        "fr": [
          "Venez découvrir ou redécouvrir la vie de la cité 8.\nUn guide conférencier fera revivre la vie de la cité pendant l’exploitation minière et vous fera découvrir son présent et son futur."
        ],
        "es": [
          "Venga a descubrir o redescubrir la vida de la cité 8.\nUn guía turístico te trasladará a la vida de la ciudad durante la época minera y te mostrará su presente y su futuro."
        ],
        "nl": [
          "Kom en ontdek of herontdek het leven van cité 8.\nEen gids neemt je mee naar het leven van de stad ten tijde van de mijnbouw en laat je het heden en de toekomst zien."
        ]
      },
