  "rdfs:comment": {
    "de": [
      "Alte und moderne Kunst. Die Galerie zeigt verschiedene Tendenzen: Impressionismus, Kubismus, Pariser Schule, Schule der Auvergne (Murols...). Zeichnungen, Gravuren und Skulpturen. Die Galerie fühlt sich dem Werk von Louis Dussour (1905-1986) verbunden."
    ],
    "en": [
      "Ancient and modern art. The gallery presents various trends: impressionism, cubism, Paris school, Auvergne school (Murols...). Drawings, engravings and sculptures. The gallery is dedicated to the work of Louis Dussour (1905-1986)."
    ],
    "it": [
      "Arte antica e moderna. La galleria presenta varie tendenze: impressionismo, cubismo, scuola di Parigi, scuola d'Alvernia (Murols, ecc.). Disegni, incisioni e sculture. La galleria è dedicata all'opera di Louis Dussour (1905-1986)."
    ],
    "fr": [
      "Art ancien et moderne. La galerie présente différentes tendances : impressionnisme, cubisme, école de Paris, école auvergnate (Murols...). Dessins, gravures et sculptures. La galerie est attachée à l'oeuvre de Louis Dussour (1905-1986)."
    ],
    "nl": [
      "Oude en moderne kunst. De galerie presenteert verschillende stromingen: impressionisme, kubisme, de Parijse school, de school van de Auvergne (Murols, enz.). Tekeningen, gravures en beeldhouwwerken. De galerie is gewijd aan het werk van Louis Dussour (1905-1986)."
    ],
    "es": [
      "Arte antiguo y moderno. La galería presenta diversas tendencias: impresionismo, cubismo, escuela de París, escuela de Auvernia (Murols, etc.). Dibujos, grabados y esculturas. La galería está dedicada a la obra de Louis Dussour (1905-1986)."
    ]
  },
  "rdfs:label": {
