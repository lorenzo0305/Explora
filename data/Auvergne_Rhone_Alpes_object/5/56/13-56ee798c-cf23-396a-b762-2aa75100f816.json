  "rdfs:comment": {
    "de": [
      "Wir bei Brontie sind Blumenliebhaber und lieben es, schöne Sträuße zu Hause oder im Büro zu haben, aber nicht um jeden Preis."
    ],
    "en": [
      "At Brontie, we love flowers, we love to have beautiful bouquets at home or in the office but not at any price."
    ],
    "it": [
      "Noi di Brontie amiamo i fiori, amiamo avere bellissimi bouquet a casa o in ufficio, ma non a tutti i costi."
    ],
    "fr": [
      "Chez Brontie, nous sommes amoureux des fleurs, nous adorons avoir de beaux bouquets à la maison ou au bureau mais pas à n’importe quel prix."
    ],
    "es": [
      "En Brontie nos encantan las flores, nos encanta tener bonitos ramos en casa o en la oficina, pero no a cualquier precio."
    ],
    "nl": [
      "Bij Brontie houden we van bloemen, we hebben graag mooie boeketten thuis of op kantoor, maar niet tegen elke prijs."
    ]
  },
