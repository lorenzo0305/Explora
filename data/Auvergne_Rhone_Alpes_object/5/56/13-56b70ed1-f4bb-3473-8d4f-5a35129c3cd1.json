  "rdfs:comment": {
    "de": [
      "Das Museum befindet sich im ersten Stock einer alten Getreidehalle, die 1823 erbaut wurde. Die archäologischen Sammlungen berichten über die Bedeutung von Vienne, der Hauptstadt der gallischen Allobroger, als mächtige gallorömische Stadt."
    ],
    "en": [
      "The museum occupies the first floor of a former grain market built in 1823. The archaeological collections illustrate the importance of Vienne as a powerful Gallo-Roman city, capital of the Allobroge Gauls."
    ],
    "it": [
      "Il museo si trova al primo piano di un'ex centrale del mais costruita nel 1823. Le collezioni archeologiche illustrano l'importanza di Vienne come capitale dei Galli Allobroge, una potente città gallo-romana."
    ],
    "fr": [
      "Le musée occupe le premier étage d’une ancienne halle aux grains construite en 1823. Les collections archéologiques rendent compte de l’importance de Vienne, capitale des Gaulois Allobroges, une puissante cité gallo-romaine."
    ],
    "nl": [
      "Het museum bevindt zich op de eerste verdieping van een voormalige korenbeurs uit 1823. De archeologische collecties weerspiegelen het belang van Vienne als hoofdstad van de Allobroge Galliërs, een machtige Gallo-Romeinse stad."
    ],
    "es": [
      "El museo se encuentra en la primera planta de una antigua bolsa de maíz construida en 1823. Las colecciones arqueológicas ilustran la importancia de Vienne como capital de los galos de Allobroge, una poderosa ciudad galo-romana."
    ]
  },
