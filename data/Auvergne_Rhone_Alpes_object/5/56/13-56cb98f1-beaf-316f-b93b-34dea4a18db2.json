          "additionalInformation": {
            "de": [
              "Das Restaurant le R ist von 12:00 bis 13:30 Uhr und von 19:00 bis 21:30 Uhr geöffnet, freitags und samstags bis 22:30 Uhr.\r\nDie Bar le R ist täglich von 10:00 bis 1:00 Uhr geöffnet, donnerstags und sonntags bis 2:00 Uhr, freitags und samstags bis 3:00 Uhr."
            ],
            "en": [
              "Restaurant le R is open from 12 noon to 1:30 pm and from 7 pm to 9:30 pm, until 10:30 pm on Fridays and Saturdays.\r\nBar Le R is open daily from 10am to 1am, until 2am on Thursdays and Sundays, and 3am on Fridays and Saturdays."
            ],
            "it": [
              "Il ristorante le R è aperto dalle 12.00 alle 13.30 e dalle 19.00 alle 21.30, fino alle 22.30 il venerdì e il sabato.\r\nIl Bar le R è aperto tutti i giorni dalle 10.00 all'1.00, fino alle 2.00 il giovedì e la domenica, e alle 3.00 il venerdì e il sabato."
            ],
            "fr": [
              "Le restaurant le R est ouvert de 12h à 13h30 et de 19h à 21h30, jusqu'à 22h30 les vendredis et samedis.\r\nLe bar le R est ouvert tous les jours de 10h à 1h du matin, jusqu'à 2h les jeudis et dimanches, 3h les vendredis et samedis."
            ],
            "nl": [
              "Restaurant le R is geopend van 12.00 tot 13.30 uur en van 19.00 tot 21.30 uur, tot 22.30 uur op vrijdag en zaterdag.\r\nBar le R is elke dag geopend van 10.00 tot 1.00 uur, op donderdag en zondag tot 2.00 uur en op vrijdag en zaterdag tot 3.00 uur."
            ],
            "es": [
              "El restaurante le R abre de 12.00 a 13.30 h y de 19.00 a 21.30 h, hasta las 22.30 h los viernes y sábados.\r\nEl Bar le R abre todos los días de 10.00 a 1.00 h, hasta las 2.00 h los jueves y domingos, y hasta las 3.00 h los viernes y sábados."
            ]
          },
