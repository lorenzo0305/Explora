  "rdfs:comment": {
    "de": [
      "7 Tage die Woche geöffnet, nur 10 Minuten vom Stadtzentrum von Clermont-Ferrand entfernt.\r\n\r\nWillkommen im R!\r\n\r\nEine gesellige und kreative Bistronomie in einer magischen Umgebung."
    ],
    "en": [
      "Open 7 days a week, just 10 minutes from downtown Clermont-Ferrand.\r\n\r\nWelcome to Le R!\r\n\r\nFriendly, creative bistronomy in a magical setting."
    ],
    "it": [
      "Aperto 7 giorni su 7, a soli 10 minuti dal centro di Clermont-Ferrand.\r\n\r\nBenvenuti a Le R!\r\n\r\nUn bistrot accogliente e creativo in un ambiente magico."
    ],
    "fr": [
      "Ouvert 7 jours sur 7, à seulement 10 minutes du centre-ville de Clermont-Ferrand.\r\n\r\nBienvenue au R !\r\n\r\nUne bistronomie conviviale et créative dans un cadre magique."
    ],
    "es": [
      "Abierto los 7 días de la semana, a sólo 10 minutos del centro de Clermont-Ferrand.\r\n\r\n¡Bienvenido a Le R!\r\n\r\nUn bistró acogedor y creativo en un entorno mágico."
    ],
    "nl": [
      "7 dagen per week geopend, op slechts 10 minuten van het centrum van Clermont-Ferrand.\r\n\r\nWelkom bij Le R!\r\n\r\nEen vriendelijke, creatieve bistro in een magische omgeving."
    ]
