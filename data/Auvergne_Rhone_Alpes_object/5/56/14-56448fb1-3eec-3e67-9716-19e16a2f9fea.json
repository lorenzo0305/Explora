      "dc:description": {
        "de": [
          "Ein junger Mann aus einem kleinen Dorf in Südfrankreich träumt davon, Filme zu machen. Eines Tages lässt sich ein Filmteam in der Nähe nieder."
        ],
        "en": [
          "A young man from a small village in the south of France dreams of making films. One day, a film crew moves into the area."
        ],
        "it": [
          "Un giovane di un piccolo villaggio del sud della Francia sogna di fare film. Un giorno, una troupe cinematografica si trasferisce nella zona."
        ],
        "fr": [
          "Un jeune homme originaire d’un petit village du sud de la France rêve de faire du cinéma. Un jour, une équipe de tournage s’installe dans les environs."
        ],
        "es": [
          "Un joven de un pequeño pueblo del sur de Francia sueña con hacer películas. Un día, un equipo de rodaje se instala en la zona."
        ],
        "nl": [
          "Een jonge man uit een klein dorpje in het zuiden van Frankrijk droomt ervan om films te maken. Op een dag komt er een filmploeg in de buurt."
        ]
