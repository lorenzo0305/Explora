  "rdfs:comment": {
    "de": [
      "Gemüse das ganze Jahr über. Verkauf auf den Märkten am Donnerstagmorgen in Langeac und am Samstagmorgen in Brioude am Stand \"Arbre\" sowie im Erzeugerladen \"L'Epinette\" in Langeac (Place de la liberté)."
    ],
    "en": [
      "Vegetables all year round. Sales at the \"Arbre\" stand at the Thursday morning market in Langeac and the Saturday morning market in Brioude, and at the \"L'Epinette\" producers' store in Langeac (Place de la liberté)."
    ],
    "it": [
      "Verdure tutto l'anno. In vendita nei mercati del giovedì mattina a Langeac e del sabato mattina a Brioude presso lo stand \"Arbre\" e presso il negozio dei produttori \"L'Epinette\" a Langeac (Place de la liberté)."
    ],
    "fr": [
      "Légumes toute l'année. Vente sur les marchés jeudi matin à Langeac et samedi matin à Brioude sur le stand \"Arbre\", et à la boutique de producteurs \"L'Epinette\" à Langeac (Place de la liberté)."
    ],
    "es": [
      "Verduras todo el año. A la venta en los mercados los jueves por la mañana en Langeac y los sábados por la mañana en Brioude en el puesto \"Arbre\", y en la tienda de productores \"L'Epinette\" de Langeac (Place de la liberté)."
    ],
    "nl": [
      "Groenten het hele jaar door. Te koop op markten op donderdagochtend in Langeac en zaterdagochtend in Brioude op de stand \"Arbre\", en bij de producentenwinkel \"L'Epinette\" in Langeac (Place de la liberté)."
    ]
  },
