  "rdfs:comment": {
    "de": [
      "Foodtruck mit leckeren Burgern; Pommes und Bagels. Wir arbeiten nur mit frischen lokalen Produkten!\r\nUnd melden Sie sich schnell zu unseren Backkursen an!"
    ],
    "en": [
      "Food truck serving delicious burgers, fries and bagels. We work exclusively with fresh local produce!\nAnd don't forget to sign up for our baking classes!"
    ],
    "it": [
      "Food truck che serve deliziosi hamburger, patatine e bagel. Lavoriamo esclusivamente con prodotti freschi locali!\r\nE non dimenticate di iscrivervi ai nostri corsi di pasticceria!"
    ],
    "fr": [
      "Food truck proposant de délicieux burgers ; frites et bagels. Nous travaillons uniquement avec des produits frais locaux !\r\nEt inscrivez-vous vite à nos cours de pâtisseries !"
    ],
    "nl": [
      "Foodtruck met heerlijke hamburgers, friet en bagels. We werken uitsluitend met verse lokale producten!\nEn vergeet je niet in te schrijven voor onze gebaklessen!"
    ],
    "es": [
      "Food truck que sirve deliciosas hamburguesas, patatas fritas y bagels. ¡Trabajamos exclusivamente con productos locales frescos!\r\n¡Y no olvides apuntarte a nuestras clases de repostería!"
    ]
  },
