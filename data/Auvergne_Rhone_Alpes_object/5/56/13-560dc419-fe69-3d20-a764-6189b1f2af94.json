  "rdfs:comment": {
    "de": [
      "Mediathek, die im Mai 2011 eingeweiht wurde. Etwa 40.000 ausleihbare Dokumente, darunter 30.000 Bücher, 4500 DVDs, 3300 CDs und 100 Pressetitel.\r\nComputer mit Internetanschluss zur freien Verfügung und WIFI."
    ],
    "en": [
      "Media library inaugurated in May 2011. Approximately 40,000 borrowable documents including 30,000 books, 4,500 DVDs, 3,300 CDs and 100 press titles.\r\nComputers connected to the Internet with free access and WIFI."
    ],
    "it": [
      "La mediateca è stata inaugurata nel maggio 2011. Circa 40.000 documenti disponibili per il prestito, tra cui 30.000 libri, 4.500 DVD, 3.300 CD e 100 titoli di stampa.\r\nComputer collegati a Internet e WIFI."
    ],
    "fr": [
      "Médiathèque inaugurée en mai 2011. Environ 40 000 documents empruntables dont 30 000 livres, 4500 DVD, 3300 CD et 100 titres de presse.\r\nOrdinateurs connectés à internet en libre accès et WIFI."
    ],
    "nl": [
      "Mediatheek geopend in mei 2011. Er kunnen ongeveer 40.000 documenten worden geleend, waaronder 30.000 boeken, 4.500 dvd's, 3.300 cd's en 100 perstitels.\r\nComputers met internet en WIFI."
    ],
    "es": [
      "La mediateca se inauguró en mayo de 2011. Aproximadamente 40.000 documentos disponibles para préstamo, incluyendo 30.000 libros, 4.500 DVDs, 3.300 CDs y 100 títulos de prensa.\r\nOrdenadores conectados a Internet y WIFI."
    ]
  },
