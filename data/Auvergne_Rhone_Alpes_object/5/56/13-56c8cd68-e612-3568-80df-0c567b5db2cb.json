  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Teufelsbrücke! Diese Wanderung, die Weg und Straße verbindet, führt Sie durch den Wald und die Weiler von Valloire bis zum Weiler Les Verneys.\r\n\r\nUm die Geolokalisierung zu aktivieren, klicken Sie auf das Symbol auf der Karte."
    ],
    "en": [
      "Discover the Pont du Diable! This trail and road walk takes you through the forest and hamlets of Valloire to the hamlet of Les Verneys.\r\n\r\nTo activate geolocation, click on the map icon."
    ],
    "it": [
      "Scoprite il Pont du Diable! Questa passeggiata su strada e sentiero vi porterà attraverso la foresta e le frazioni di Valloire fino alla frazione di Les Verneys.\r\n\r\nPer attivare la geolocalizzazione, cliccare sull'icona della mappa."
    ],
    "fr": [
      "Découvrez le Pont du Diable ! Cette balade alliant chemin et route vous emmènera jusqu'au hameau des Verneys en passant par la forêt et les hameaux de Valloire.\r\n\r\nPour activer la géolocalisation, cliquez sur l'icône de la carte."
    ],
    "es": [
      "¡Descubra el Pont du Diable! Esta ruta de senderismo y carretera le llevará por el bosque y las aldeas de Valloire hasta la aldea de Les Verneys.\r\n\r\nPara activar la geolocalización, haga clic en el icono del mapa."
    ],
    "nl": [
      "Ontdek de Pont du Diable! Deze wandelroute voert je door het bos en de gehuchten van Valloire naar het gehucht Les Verneys.\r\n\r\nKlik op het kaarticoon om de geolocatie te activeren."
    ]
  },
  "rdfs:label": {
    "de": [
      "6 - Überquerung der Teufelsbrücke - Mountainbike- / ATV-Route"
    ],
    "ru": [
      "6 - Пересечение моста Дьявола - маршрут для горных велосипедов и квадроциклов"
    ],
    "en": [
      "6 - Devil's bridge crossing - Mountain bike / ATV route"
    ],
    "it": [
      "6 - Attraversamento del Ponte del Diavolo - Percorso per mountain bike / ATV"
    ],
    "fr": [
      "6 - Passage du pont du diable - Itinéraire de VTT / VTTAE"
    ],
    "zh": [
      "6 - 穿越魔鬼桥--山地自行车/全地形车路线"
    ],
    "nl": [
      "6 - Oversteek van de Duivelsbrug - Mountainbike / ATV-route"
    ],
    "es": [
      "6 - Cruzando el Puente del Diablo - Ruta en bicicleta de montaña / ATV"
    ]
  },
