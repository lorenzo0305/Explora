  "rdfs:comment": {
    "de": [
      "Am Eingang des Dorfes, neben dem City Park, 2 Tennisplätze, davon einer aus Harz mit Flutlicht, ein Clubhaus mit Terrasse, Getränken, Dusche, Toilette, Fernseher und kostenlosem WIFI. Möglichkeit, Ausrüstung zu mieten. Aktivität Multi Pass Portes du Soleil."
    ],
    "en": [
      "At the entrance of the village, next to the City Park, 2 courts, one of which is in lit resin, a club house with terrace, drinks, shower, toilets, television and free WIFI. Possibility to rent equipment. Approved provider for the Multi Pass Portes du Soleil."
    ],
    "it": [
      "All'ingresso del villaggio, accanto al parco cittadino, 2 campi da gioco, di cui uno in resina illuminato, una club house con terrazza, bevande, doccia, servizi igienici, televisione e WIFI gratuito. Possibilità di noleggiare attrezzature. Attività Multi Pass Portes du Soleil."
    ],
    "fr": [
      "A l'entrée du village, à côté du city Park, 2 courts dont un en résine éclairé, un club house avec terrasse, boissons, douche, toilettes, télévision et WIFI gratuit. Possibilité de location de matériel. Activité Multi Pass Portes du Soleil."
    ],
    "nl": [
      "Bij de ingang van het dorp, naast het stadspark, 2 banen, waarvan één verlichte harsbaan, een clubhuis met terras, drankjes, douche, toilet, televisie en gratis WIFI. Verhuur van materiaal mogelijk. Multi Pass Portes du Soleil activiteit."
    ],
    "es": [
      "A la entrada del pueblo, junto al parque de la ciudad, 2 pistas, una de ellas de resina iluminada, una casa club con terraza, bebidas, ducha, aseos, televisión y WIFI gratuito. Posibilidad de alquilar equipos. Actividad Multi Pass Portes du Soleil."
    ]
  },
