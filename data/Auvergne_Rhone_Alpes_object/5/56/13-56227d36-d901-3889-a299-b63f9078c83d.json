  "rdfs:comment": {
    "de": [
      "Begeben Sie sich auf eine Klangreise, auf der sich mitteleuropäische Volksmelodien in klassische Schätze von Bartok, Dvorak, Smetana und anderen verwandeln"
    ],
    "en": [
      "Embark on a sonic journey where the folk melodies of Central Europe are transformed into classical treasures by Bartok, Dvorak, Smetana?etc?"
    ],
    "it": [
      "Intraprendete un viaggio sonoro in cui le melodie popolari dell'Europa centrale si trasformano in tesori classici di Bartok, Dvorak, Smetana, ecc?"
    ],
    "fr": [
      "Embarquez pour un voyage sonore où les mélodies folkloriques d’Europe Centrale se métamorphosent en trésors classiques chez Bartok, Dvorak, Smetana…etc…"
    ],
    "nl": [
      "Ga mee op een sonische reis waarbij de volksmelodieën van Midden-Europa worden getransformeerd tot klassieke schatten van Bartok, Dvorak, Smetana, enz?"
    ],
    "es": [
      "Embárquese en un viaje sonoro en el que las melodías folclóricas de Europa Central se transforman en tesoros clásicos de Bartok, Dvorak, Smetana, etc?"
