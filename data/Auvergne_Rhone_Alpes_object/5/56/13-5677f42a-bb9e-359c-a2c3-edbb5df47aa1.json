  "rdfs:comment": {
    "de": [
      "Franck und Géraldine sind seit 1987 Köche und heißen Sie im Thymallus willkommen.\r\nKomplett renoviertes bistronomisches Restaurant mit gepflegter Dekoration.\r\nAkzeptiert T'CAP-Schecks."
    ],
    "en": [
      "Cook since 1987, Franck and Géraldine welcome you to the Thymallus.\r\nBistronomical restaurant entirely renovated with careful decoration.\r\nAccepts T'CAP cheques."
    ],
    "it": [
      "Cuochi dal 1987, Franck e Géraldine vi danno il benvenuto al Thymallus.\r\nUn ristorante bistronomico completamente rinnovato e arredato con cura.\r\nAccetta gli assegni T'CAP."
    ],
    "fr": [
      "Cuisinier depuis 1987, Franck et Géraldine vous accueillent au Thymallus.\r\nRestaurant bistronomique entièrement rénové à la décoration soignée.\r\nAccepte les chèques T'CAP."
    ],
    "nl": [
      "Franck en Géraldine, koks sinds 1987, heten u welkom in de Thymallus.\r\nEen bistronomisch restaurant dat volledig is gerenoveerd en met zorg is ingericht.\r\nAccepteert T'CAP cheques."
    ],
    "es": [
      "Cocineros desde 1987, Franck y Géraldine le dan la bienvenida al Thymallus.\r\nUn restaurante bistronómico completamente renovado y decorado con esmero.\r\nAcepta cheques T'CAP."
    ]
  },
