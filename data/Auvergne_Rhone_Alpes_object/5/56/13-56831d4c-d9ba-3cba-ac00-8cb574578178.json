  "rdfs:comment": {
    "de": [
      "Das im Freien aufgezogene Porc Fermier d'Auvergne Label Rouge verfügt über die geschützte geografische Angabe: Es wurde in der Auvergne geboren, aufgezogen und geschlachtet."
    ],
    "en": [
      "Free-range Label Rouge Porc Fermier d'Auvergne is a Protected Geographical Indication pig born, raised and slaughtered in Auvergne."
    ],
    "it": [
      "I maiali di fattoria Label Rouge dell'Auvergne, allevati all'aperto, hanno un'indicazione geografica protetta: sono nati, allevati e macellati in Auvergne."
    ],
    "fr": [
      "Le Porc Fermier d’Auvergne Label Rouge, élevé en plein air bénéficie de l’Indication Géographique Protégée : il est né, élevé et abattu en Auvergne."
    ],
    "es": [
      "Los cerdos de granja Label Rouge de Auvernia tienen una Indicación Geográfica Protegida: nacen, se crían y se sacrifican en Auvernia."
    ],
    "nl": [
      "De scharrelvarkens met het Label Rouge uit de Auvergne hebben een Beschermde Geografische Aanduiding: ze zijn geboren, opgefokt en geslacht in de Auvergne."
    ]
  },
