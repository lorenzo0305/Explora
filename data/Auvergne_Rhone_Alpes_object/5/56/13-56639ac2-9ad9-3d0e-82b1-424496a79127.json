  "rdfs:comment": {
    "de": [
      "Run In Lyon by Harmonie Mutuelle kehrt dieses Jahr zum 14. Mal mit der gleichen Mission zurück: Entdecken Sie das Lyoner Kulturerbe anhand von vier verschiedenen Läufen, die für alle Läufertypen zugänglich sind."
    ],
    "en": [
      "You want to prove that Lyon is still the capital of the Gauls? Come and run for your city on October 1st and 2nd! Four events: 10 km, half-marathon, marathon, but also a relay for those who prefer to run as a team!"
    ],
    "it": [
      "Run In Lyon by Harmonie Mutuelle torna quest'anno per la sua 14a edizione, con la stessa missione: scoprire il patrimonio di Lione attraverso quattro diverse gare accessibili a tutti i tipi di corridori."
    ],
    "fr": [
      "Run In Lyon by Harmonie Mutuelle revient cette année pour une 14e édition avec la même mission : découvrir le patrimoine lyonnais à travers quatre courses différentes accessibles à tout type de coureur."
    ],
    "es": [
      "Run In Lyon by Harmonie Mutuelle vuelve este año en su 14ª edición, con la misma misión: descubrir el patrimonio lionés a través de cuatro carreras diferentes accesibles a todo tipo de corredores."
    ],
    "nl": [
      "Run In Lyon by Harmonie Mutuelle is dit jaar terug voor de 14e editie, met dezelfde missie: het erfgoed van Lyon ontdekken door middel van vier verschillende races die toegankelijk zijn voor alle soorten hardlopers."
    ]
  },
