  "rdfs:comment": {
    "de": [
      "Entdecken Sie den kulturellen, gastronomischen, sportlichen und menschlichen Reichtum der Region Savoie Mont-Blanc. Einzelpersonen oder Unternehmen, Cozyfrance, Reisebüro, organisieren Ihre Freizeit. Halbtägige oder ganztägige Besichtigungstouren."
    ],
    "en": [
      "Discover the cultural, gastronomic, sporting and human riches of the Savoie Mont-Blanc region. Individuals or companies, Cozyfrance, tourist agency, organize your free time. Half-day or full-day sightseeing tours."
    ],
    "it": [
      "Scoprite la ricchezza culturale, gastronomica, sportiva e umana della regione Savoia Monte Bianco. Privati o aziende, Cozyfrance, agenzia turistica, organizza il vostro tempo libero. Tour di mezza giornata o di una giornata intera."
    ],
    "fr": [
      "Découvrez les richesses culturelles, gastronomiques, sportives et humaines de la région Savoie Mont-Blanc. Particuliers ou entreprises, Cozyfrance, agence touristique, organise vos temps libres. Circuits touristiques en demi-journée ou en journée."
    ],
    "nl": [
      "Ontdek de culturele, gastronomische, sportieve en menselijke rijkdom van de Savoie Mont-Blanc. Particulieren of bedrijven, Cozyfrance, toeristenbureau, organiseert uw vrije tijd. Rondleidingen van een halve of een hele dag."
    ],
    "es": [
      "Descubra la riqueza cultural, gastronómica, deportiva y humana de la región de Savoie Mont-Blanc. Particulares o empresas, Cozyfrance, agencia de turismo, organiza su tiempo libre. Visitas de medio día o de día completo."
    ]
  },
