  "rdfs:comment": {
    "de": [
      "Roulons en ville à vélo ist ein Verein aus Valentino, der sich für die Förderung des Anteils des Fahrrads in seinen verschiedenen Verwendungszwecken im Alltag und für eine ausgewogene Aufteilung des öffentlichen Raums einsetzt."
    ],
    "en": [
      "Roulons en ville à vélo (Let's cycle in the city) is an association based in the city of Valentin which promotes the use of bicycles in everyday life and a balanced sharing of public space."
    ],
    "it": [
      "Roulons en ville à vélo (Andiamo in bicicletta in città) è un'associazione con sede a Valentines che promuove l'uso della bicicletta nella vita quotidiana e una condivisione equilibrata dello spazio pubblico."
    ],
    "fr": [
      "Roulons en ville à vélo est une association Valentinoise qui agit pour la promotion de la part du vélo dans ses différents usages au quotidien et pour un partage équilibré de l'espace public."
    ],
    "es": [
      "Roulons en ville à vélo (Vamos en bici por la ciudad) es una asociación con sede en Valentines que promueve el uso de la bicicleta en la vida cotidiana y un reparto equilibrado del espacio público."
    ],
    "nl": [
      "Roulons en ville à vélo (Laten we fietsen in de stad) is een vereniging uit Valentines die het gebruik van de fiets in het dagelijks leven en een evenwichtig gebruik van de openbare ruimte promoot."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Roulons en ville à vélo - REVV"
    ]
  },
