  "rdfs:comment": {
    "de": [
      "Holen Sie die Schlitten raus! Mit seinem Rennwagen oder seiner Schneeschaufel in Höchstgeschwindigkeit hinuntersausen: ein familiäres Muss im Urlaub im Schnee."
    ],
    "en": [
      "Get out the sledges! Speed down the slope on your toboggan or snow shovel: a family must-have on a snow vacation."
    ],
    "it": [
      "Tirate fuori le slitte! Sfrecciate sulle piste con lo slittino o la pala da neve: un must per tutta la famiglia in una vacanza sulla neve."
    ],
    "fr": [
      "Sortez les luges ! Descendre a toute vitesse sur son bolide ou sur sa pelle a neige : un incontournable familial des vacances à la neige."
    ],
    "es": [
      "¡Saca los trineos! Desciende a toda velocidad por las pistas con tu tobogán o tu pala de nieve: algo imprescindible para toda la familia en unas vacaciones en la nieve."
    ],
    "nl": [
      "Haal de sleeën tevoorschijn! Scheur met je slee of sneeuwschuiver de hellingen af: een must-have voor het hele gezin tijdens een sneeuwvakantie."
    ]
