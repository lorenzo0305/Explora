  "rdfs:comment": {
    "de": [
      "Gourmet-Küche mit einem exzellenten Preis-/Leistungsverhältnis.\r\nMarie-Laurence und Fabrice sind immer auf der Suche nach neuen Geschmacksrichtungen, damit Sie lange Zeit den subtilen und geschmackvollen Fussabdruck Ihrer Heimreise behalten."
    ],
    "en": [
      "Gastronomic cuisine. Excellent value for money.\r\nMarie-Laurence and Fabrice are always looking for new flavours, so that you can keep the subtle and gourmet imprint of your stay with them for a long time."
    ],
    "it": [
      "Marie-Laurence e Fabrice sono sempre alla ricerca di nuovi sapori, in modo che possiate conservare a lungo l'impressione sottile e gastronomica della vostra visita."
    ],
    "fr": [
      "Marie-Laurence et Fabrice sont toujours à la recherche de nouvelles saveurs, pour que vous gardiez longtemps l'empreinte subtile et gourmande de votre passage chez eux."
    ],
    "es": [
      "Marie-Laurence y Fabrice están siempre a la búsqueda de nuevos sabores, para que usted conserve durante mucho tiempo la huella sutil y gourmet de su visita."
    ],
    "nl": [
      "Marie-Laurence en Fabrice zijn altijd op zoek naar nieuwe smaken, zodat u de subtiele en gastronomische indruk van uw bezoek lang behoudt."
    ]
  },
