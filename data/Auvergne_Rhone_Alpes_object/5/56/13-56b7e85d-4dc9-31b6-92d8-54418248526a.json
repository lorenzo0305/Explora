  "rdfs:comment": {
    "de": [
      "Gary Mullen an der Spitze seines neuen One night of Queen\r\n\r\nDer weltweit größte Queen-Tribute kehrt nach einer triumphalen US-Tournee mit seiner außergewöhnlichen Show nach Frankreich zurück: \"The Wembley show!\""
    ],
    "en": [
      "Gary Mullen at the helm of his new One Night of Queen\r\n\r\nThe world's biggest Queen tribute, returns to France after a triumphant American tour with its extraordinary show: \"The Wembley show!\""
    ],
    "it": [
      "Gary Mullen al timone della sua nuova One Night of Queen\r\n\r\nIl più grande tributo ai Queen del mondo torna in Francia dopo un trionfale tour americano con il suo straordinario spettacolo: \"The Wembley show!"
    ],
    "fr": [
      "Gary Mullen à la tête de son nouveau One night of Queen\r\n\r\nLe plus grand tribute de Queen au monde, revient en France après une tournée américaine triomphale avec son spectacle hors-normes : « The Wembley show ! »"
    ],
    "es": [
      "Gary Mullen al frente de su nuevo One Night of Queen\r\n\r\nEl mayor tributo a Queen del mundo regresa a Francia tras una triunfal gira americana con su extraordinario espectáculo: \"¡El show de Wembley!"
    ],
    "nl": [
      "Gary Mullen aan het roer van zijn nieuwe One Night of Queen\r\n\r\nS Werelds grootste Queen-tribute keert na een triomfantelijke Amerikaanse tournee terug naar Frankrijk met zijn buitengewone show: \"The Wembley show!"
    ]
  },
