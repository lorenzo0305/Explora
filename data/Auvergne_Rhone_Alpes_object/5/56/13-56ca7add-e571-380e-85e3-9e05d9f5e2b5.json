  "rdfs:comment": {
    "de": [
      "Die Mediathek Jean Pellerin in Pontcharra ist Teil des Bibliotheksnetzes von Grésivaudan.\nDer Eintritt ist frei und kostenlos. Ein Abonnement ist erforderlich, um aus den 430.000 Dokumenten (Bücher, DVDs, CDs) der 36 Bibliotheken des Netzwerks auszuleihen."
    ],
    "en": [
      "The Jean Pellerin multimedia library in Pontcharra is part of the Grésivaudan library network.\nFree admission. You need membership to borrow any of the 430,000 items (books, DVDs, CDs) in the 36 libraries in the network."
    ],
    "it": [
      "La Mediateca Jean Pellerin di Pontcharra fa parte della Rete delle Biblioteche del Grésivaudan.\nL'ingresso è gratuito. È necessario un abbonamento per prendere in prestito uno dei 430.000 articoli (libri, DVD, CD) presenti nelle 36 biblioteche della rete."
    ],
    "fr": [
      "La Médiathèque Jean Pellerin de Pontcharra fait partie du Réseau des Bibliothèques du Grésivaudan.\nEntrée libre et gratuite. L'abonnement est nécessaire pour emprunter parmi les 430 000 documents (livre, DVD, CD) des 36 bibliothèques du réseau."
    ],
    "es": [
      "La Mediateca Jean Pellerin de Pontcharra forma parte de la Red de Bibliotecas de Grésivaudan.\nLa entrada es gratuita. Para acceder a los 430.000 fondos (libros, DVD, CD) de las 36 bibliotecas de la red es necesario abonarse."
    ],
    "nl": [
      "De mediatheek Jean Pellerin in Pontcharra maakt deel uit van het netwerk van bibliotheken in Grésivaudan.\nDe toegang is gratis. Een abonnement is nodig om een van de 430.000 items (boeken, dvd's, cd's) in de 36 bibliotheken van het netwerk te lenen."
    ]
  },
