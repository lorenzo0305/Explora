  "rdfs:comment": {
    "de": [
      "Die Université Populaire Tricastine ist ein laizistischer, humanistischer und republikanischer Verein, der allen offen steht. Sie ist nicht gewinnorientiert, wird von Freiwilligen geleitet und gehört zum Netzwerk der Volkshochschulen Frankreichs."
    ],
    "en": [
      "The Université Populaire Tricastine is a secular, humanist and republican association open to all. Non-profit-making, it is run by volunteers and is part of the Universités Populaires de France network."
    ],
    "it": [
      "L'Université Populaire Tricastine è un'associazione laica, umanista e repubblicana, aperta a tutti. È un'associazione senza scopo di lucro gestita da volontari e fa parte della rete delle Universités Populaires de France."
    ],
    "fr": [
      "L'Université Populaire Tricastine est une association laïque, humaniste et républicaine, ouverte à tous. Sans but lucratif, elle est gérée par des bénévoles et fait partie du réseau des Universités Populaires de France."
    ],
    "es": [
      "La Universidad Popular Tricastina es una asociación laica, humanista y republicana, abierta a todos. Es una asociación sin ánimo de lucro dirigida por voluntarios y forma parte de la red de las Universités Populaires de France."
    ],
    "nl": [
      "De Université Populaire Tricastine is een seculiere, humanistische en republikeinse vereniging die openstaat voor iedereen. Ze heeft geen winstoogmerk, wordt gerund door vrijwilligers en maakt deel uit van het netwerk Universités Populaires de France."
    ]
  },
