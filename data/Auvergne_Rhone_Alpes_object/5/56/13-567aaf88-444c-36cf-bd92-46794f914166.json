  "rdfs:comment": {
    "de": [
      "Japanisches Restaurant mit À-la-carte- oder All-you-can-eat-Service und Bedienung am Tisch. Sie werden über ein Touchscreen-Tablet verfügen, in dem Sie jedes beliebige Gericht auswählen und bestellen können.\r\njedes unserer Gerichte."
    ],
    "en": [
      "A la carte or all-you-can-eat Japanese restaurant with table service. You'll have access to a touch-screen tablet from which you can choose and order any of our dishes.\r\nany of our dishes."
    ],
    "it": [
      "Ristorante giapponese alla carta o all-you-can-eat con servizio al tavolo. Avrete a disposizione un tavolo tattile dove potrete scegliere e ordinare qualsiasi piatto\r\nqualsiasi piatto."
    ],
    "fr": [
      "Restaurant japonais à la carte ou à volonté et service à la table. Vous disposerez d’une tablette tactile dans lequel vous pourrez choisir et commander n’importe \r\nlequel de nos plats."
    ],
    "es": [
      "Restaurante japonés a la carta o todo a la carta con servicio de mesa. Tendrá a su disposición una mesa táctil donde podrá elegir y pedir cualquiera de nuestros platos\r\ncualquiera de nuestros platos."
    ],
    "nl": [
      "Japans à la carte of all-you-can-eat restaurant met bediening aan tafel. Je hebt een tafel tot je beschikking waar je al onze gerechten kunt kiezen en bestellen\r\neen van onze gerechten."
    ]
  },
