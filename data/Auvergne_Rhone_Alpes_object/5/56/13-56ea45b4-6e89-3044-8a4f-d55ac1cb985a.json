  "rdfs:comment": {
    "de": [
      "Die Seifenfabrik Les Secrets du Bens stellt in Handarbeit Seifen und Massageöle aus 100% natürlichen Zutaten her, die mit Pflanzenextrakten aus eigenem Anbau angereichert sind. Es werden auch Kosmetik-Workshops angeboten."
    ],
    "en": [
      "Les Secrets du Bens hand-makes soaps and massage oils from 100% natural ingredients, enriched with locally-grown plant extracts. Cosmetic workshops are also available."
    ],
    "it": [
      "Les Secrets du Bens produce a mano saponi e oli da massaggio con ingredienti naturali al 100%, arricchiti con estratti di piante coltivate localmente. Sono disponibili anche laboratori di cosmesi."
    ],
    "fr": [
      "La savonnerie Les Secrets du Bens fabrique à la main des savons et huiles de massage à partir d'ingrédients 100% naturels et enrichis en extraits de plantes cultivées sur place. Des ateliers cosmétiques sont également proposés."
    ],
    "nl": [
      "Les Secrets du Bens maakt met de hand zeep en massageolie van 100% natuurlijke ingrediënten, verrijkt met lokaal geteelde plantenextracten. Er zijn ook cosmeticaworkshops beschikbaar."
    ],
    "es": [
      "Les Secrets du Bens fabrica jabones y aceites de masaje a mano con ingredientes 100% naturales, enriquecidos con extractos de plantas cultivadas localmente. También se ofrecen talleres de cosmética."
    ]
  },
  "rdfs:label": {
