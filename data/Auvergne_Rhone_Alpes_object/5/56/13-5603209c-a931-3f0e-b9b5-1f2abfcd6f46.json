  "rdfs:comment": {
    "de": [
      "Genießen Sie auf der Terrasse mit herrlichem Blick auf die Berge ein warmes Gericht oder ein Getränk. Das Selbstbedienungsrestaurant bietet Ihnen eine große Auswahl an landestypischen Gerichten."
    ],
    "en": [
      "Enjoy a hot meal or a drink on the terrace with its breathtaking mountain views. The self-service restaurant offers a wide choice of local cuisine."
    ],
    "it": [
      "Godetevi un pasto caldo o un drink sulla terrazza con una vista mozzafiato sulle montagne. Il ristorante self-service offre un'ampia scelta di piatti della cucina locale."
    ],
    "fr": [
      "Profitez de la terrasse avec une vue imprenable sur les montagnes, pour déguster un bon plat chaud ou une boisson. Le restaurant en self-service vous offre une large choix de cuisine du pays."
    ],
    "nl": [
      "Geniet van een warme maaltijd of een drankje op het terras met adembenemend uitzicht op de bergen. Het zelfbedieningsrestaurant biedt een ruime keuze aan lokale gerechten."
    ],
    "es": [
      "Disfrute de una comida caliente o de una bebida en la terraza con una impresionante vista de las montañas. El restaurante de autoservicio ofrece una amplia selección de cocina local."
    ]
  },
  "rdfs:label": {
