  "rdfs:comment": {
    "de": [
      "Wenn die Geschmacksknospen sich auf den Weg machen! Genießen Sie auf einem kulinarischen Spaziergang eine köstliche Mahlzeit in vier Etappen (Mise en bouche, Vorspeise, Hauptgang und Dessert) und erleben Sie bei der Ankunft einen Kunsthandwerksmarkt!"
    ],
    "en": [
      "When your taste buds take to the road! Enjoy a delicious 4-step meal (Mise en bouche, starter, main course and dessert) during a culinary stroll, with a craft market at the end!"
    ],
    "it": [
      "Quando le papille gustative si mettono in viaggio! Gustate un delizioso pasto in 4 fasi (Mise en bouche, antipasto, piatto principale e dessert) durante una passeggiata culinaria e partecipate a un mercatino dell'artigianato all'arrivo!"
    ],
    "fr": [
      "Quand les papilles prennent le chemin ! Dégustez un délicieux repas en 4 étapes (Mise en bouche, entrée, plat et dessert) au cours d'une balade culinaire et profitez d'un marché artisanal à l'arrivée !"
    ],
    "es": [
      "¡Cuando su paladar se pone en marcha! Disfrute de una deliciosa comida en 4 tiempos (Mise en bouche, entrante, plato principal y postre) durante un paseo culinario y disfrute de un mercado de artesanía a su llegada"
    ],
    "nl": [
      "Wanneer je smaakpapillen op pad gaan! Geniet van een heerlijk 4-gangenmenu (Mise en bouche, voorgerecht, hoofdgerecht en dessert) tijdens een culinaire wandeling en neem bij aankomst een ambachtelijke markt in je op!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Balade culinaire"
    ]
  },
