  "rdfs:comment": {
    "de": [
      "Das Petit Bougnat empfängt Sie in einer herzlichen und familiären Atmosphäre, in der die traditionelle Küche mit Authentizität einhergeht. Großzügige Gerichte, die mit sorgfältig ausgewählten regionalen Produkten zubereitet werden."
    ],
    "en": [
      "Le Petit Bougnat welcomes you in a warm, family atmosphere, where traditional cuisine rhymes with authenticity. Generous dishes prepared with carefully selected regional produce."
    ],
    "it": [
      "Le Petit Bougnat vi accoglie in un'atmosfera calda e familiare, dove la cucina tradizionale fa rima con autenticità. Piatti generosi preparati con prodotti regionali accuratamente selezionati."
    ],
    "fr": [
      "Le Petit Bougnat vous accueille dans une ambiance chaleureuse et familiale, où la cuisine traditionnelle rime avec authenticité. Plats généreux, préparés avec des produits régionaux soigneusement sélectionnés."
    ],
    "nl": [
      "Le Petit Bougnat verwelkomt u in een warme, familiale sfeer, waar een traditionele keuken samengaat met authenticiteit. Royale gerechten bereid met zorgvuldig geselecteerde streekproducten."
    ],
    "es": [
      "Le Petit Bougnat le da la bienvenida en un ambiente cálido y familiar, donde la cocina tradicional rima con autenticidad. Platos generosos elaborados con productos regionales cuidadosamente seleccionados."
    ]
  },
  "rdfs:label": {
