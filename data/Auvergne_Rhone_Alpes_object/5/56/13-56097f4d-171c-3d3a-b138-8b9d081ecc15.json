  "rdfs:comment": {
    "de": [
      "Kreative Küche mit Produkten des französischen Terroirs. All unsere Speisen werden aus frischen, saisonalen Produkten zubereitet, die sorgfältig ausgewählt und leidenschaftlich zubereitet werden."
    ],
    "en": [
      "Creative cuisine based on ingredients produced in France. All our dishes are made with fresh, seasonal produce that is carefully selected and prepared with enthusiasm."
    ],
    "it": [
      "Cucina creativa di prodotti del territorio francese. Tutti i piatti sono preparati con prodotti freschi, di stagione, scelti con cura e preparati con passione."
    ],
    "fr": [
      "Cuisine créative de produits issus du terroir Français. Tous nos plats sont concoctés avec des produits frais, de saison, choisis avec soin et préparés avec passion."
    ],
    "nl": [
      "Creatieve keuken met Franse streekproducten. Alle gerechten worden bereid met verse seizoensproducten die met zorg worden geselecteerd en met passie worden gemaakt."
    ],
    "es": [
      "Cocina creativa con productos del terruño francés. Todos nuestros platos se elaboran con productos frescos de temporada, elegidos con cuidado y preparados con pasión."
    ]
  },
