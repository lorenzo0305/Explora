  "rdfs:comment": {
    "de": [
      "Anstelle des Café Cousu zeigt Ihnen Odessa Comptoir eine Auswahl an Weinen mit der Möglichkeit, vor Ort zu essen: natürliche Weine und eine bistronomische Küche. Eine neue Adresse auch für einen Sonntagsbrunch in Lyon."
    ],
    "en": [
      "In place of Café Cousu, Odessa Comptoir offers you a selection of wines with the possibility of eating on the spot: natural wines and a bistronomic cuisine. A new address also for a Sunday brunch in Lyon."
    ],
    "it": [
      "Al posto del Café Cousu, Odessa Comptoir offre una selezione di vini con la possibilità di cenare: vini naturali e cucina bistronomica. Un nuovo indirizzo per un brunch domenicale a Lione."
    ],
    "fr": [
      "En lieu et place du Café Cousu, Odessa Comptoir vous fait découvrir une sélection de vins avec la possibilité de se restaurer sur place : des vins naturels et  une cuisine bistronomique. Une nouvelle adresse aussi pour un brunch dominical à Lyon."
    ],
    "nl": [
      "In plaats van Café Cousu biedt Odessa Comptoir een selectie wijnen met de mogelijkheid om te dineren: natuurlijke wijnen en bistronomische gerechten. Een nieuw adres voor een zondagse brunch in Lyon."
    ],
    "es": [
      "En lugar del Café Cousu, Odessa Comptoir ofrece una selección de vinos con la posibilidad de cenar en él: vinos naturales y cocina bistronómica. Una nueva dirección para un brunch dominical en Lyon."
    ]
  },
