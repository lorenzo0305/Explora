  "rdfs:comment": {
    "de": [
      "Drôme Ardèche Tradition ist der Zusammenschluss von zwei Pökelbetrieben: Jules Courtial in der Ardèche und Drôme Salaisons.\r\nSie stellen handwerklich hergestellte Wurstspezialitäten her und haben den Titel \"Artisan\" erhalten!"
    ],
    "en": [
      "Drôme Ardèche Tradition is the merger of two salaisons: Jules Courtial in Ardèche and Drôme Salaisons.\nThey produce artisanal charcuterie specialties, and have earned the title of Artisan!"
    ],
    "it": [
      "Drôme Ardèche Tradition è il risultato della fusione di due aziende di salatura: Jules Courtial in Ardèche e Drôme Salaisons.\r\nEsse producono specialità salumiere tradizionali e sono state insignite del titolo di Artisan!"
    ],
    "fr": [
      "Drôme Ardèche Tradition est la fusion de deux salaisons : Jules Courtial en Ardèche et Drôme Salaisons.\r\nIls élaborent des spécialités charcutières artisanales, et ont obtenu le titre d'Artisan !"
    ],
    "nl": [
      "Drôme Ardèche Tradition is het resultaat van de fusie van twee zoutziederijen: Jules Courtial in de Ardèche en Drôme Salaisons.\nZij produceren ambachtelijke vleeswaren en zijn bekroond met de titel Artisan!"
    ],
    "es": [
      "Drôme Ardèche Tradition es el resultado de la fusión de dos salazones: Jules Courtial en Ardèche y Drôme Salaisons.\r\n¡Producen especialidades de charcutería tradicional y han obtenido el título de Artesano!"
    ]
  },
