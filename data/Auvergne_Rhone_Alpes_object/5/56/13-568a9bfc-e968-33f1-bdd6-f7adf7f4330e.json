  "rdfs:comment": {
    "de": [
      "In der Nähe des Dorfes FARGES, von SIAUGUES aus, auf 1000 m Höhe gelegen, entdecken Sie einen außergewöhnlichen Ort, der umweltfreundlich angelegt wurde.\r\nDer Besucher kann hier Regenbogenforellen, Bachforellen und Bachlachse angeln."
    ],
    "en": [
      "Situated near the village of FARGES on the outskirts of SIAUGUES, at an altitude of 1000 m, you will discover an exceptional site, developed with respect for the environment.\r\nVisitors can enjoy fishing for rainbow trout, fario and brook salmon."
    ],
    "it": [
      "Situato nei pressi del villaggio di FARGES, alla periferia di SIAUGUES, a 1000 m di altitudine, scoprirete un sito eccezionale, sviluppato nel rispetto dell'ambiente.\r\nI visitatori possono praticare la pesca della trota iridea, della fario e del salmone di ruscello."
    ],
    "fr": [
      "Situé près du village de FARGES en partant de SIAUGUES, à 1000 m d’altitude, vous découvrirez un site exceptionnel, aménagé dans le respect de l’environnement.\r\nLe visiteur pourra s'adonner à la pêche à la truite arc-en-ciel, fario & saumon de fontaine."
    ],
    "es": [
      "Situado cerca del pueblo de FARGES, en las afueras de SIAUGUES, a 1000 m de altitud, descubrirá un lugar excepcional, desarrollado respetando el medio ambiente.\r\nLos visitantes pueden disfrutar de la pesca de la trucha arco iris, el fario y el salmón de arroyo."
    ],
    "nl": [
      "Gelegen in de buurt van het dorp FARGES aan de rand van SIAUGUES, op een hoogte van 1000 m, ontdek je een uitzonderlijke site, ontwikkeld met respect voor het milieu.\r\nBezoekers kunnen hier vissen op regenboogforel, fario en beekzalm."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Étang du Repos"
    ]
  },
