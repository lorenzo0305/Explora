  "rdfs:comment": {
    "de": [
      "Bierbar und Weinstube. Aperitifbretter (Wurst, Käse, regionale Produkte) und Sandwiches. Events: Themenabende, Firmenfeiern, Konzerte und Jam Sessions."
    ],
    "en": [
      "Beer and wine bar. Aperitif platters (cold meats, cheeses, regional products) and sandwiches. Events: theme evenings, company parties, concerts and jam sessions."
    ],
    "it": [
      "Bar con birra e vino. Aperitivo con taglieri (salumi, formaggi, prodotti regionali) e panini. Eventi: serate a tema, feste aziendali, concerti e jam session."
    ],
    "fr": [
      "Bar à bière et bar à vin. Planches apéro (charcuteries, fromages, produits régionaux) et sandwichs. Événementiel : soirées à thème, soirées d’entreprise, concerts et jam sessions."
    ],
    "nl": [
      "Bier- en wijnbar. Aperitiefschotels (vleeswaren, kazen, streekproducten) en broodjes. Evenementen: thema-avonden, bedrijfsfeesten, concerten en jamsessies."
    ],
    "es": [
      "Bar de cervezas y vinos. Platos de aperitivo (embutidos, quesos, productos regionales) y bocadillos. Eventos: veladas temáticas, fiestas de empresa, conciertos y jam sessions."
    ]
