  "rdfs:comment": {
    "de": [
      "Johan Bonnefoy studierte an der École supérieure d'art de Clermont-Ferrand, wo er einen Bachelor- und einen Masterabschluss mit Auszeichnung erhielt. Er spezialisierte sich schnell auf Zeichnen, Malerei und elektronische Musik."
    ],
    "en": [
      "Johan Bonnefoy studied at the École supérieure d?art de Clermont-Ferrand, where he obtained a bachelor?s degree and a master?s degree with honors. He quickly specialized in drawing, painting and electronic music."
    ],
    "it": [
      "Johan Bonnefoy ha studiato all'École supérieure d'art de Clermont-Ferrand, dove ha conseguito un bachelor e un master con lode. Si è rapidamente specializzato in disegno, pittura e musica elettronica."
    ],
    "fr": [
      "Johan Bonnefoy a étudié à l’École supérieure d’art de Clermont-Ferrand où il a obtenu une licence et un master avec félicitations du jury. Il s’est rapidement spécialisé dans les pratiques du dessin, de la peinture et de la musique électronique."
    ],
    "nl": [
      "Johan Bonnefoy studeerde aan de École supérieure d'art de Clermont-Ferrand, waar hij een bachelor en een master cum laude behaalde. Hij specialiseerde zich al snel in tekenen, schilderen en elektronische muziek."
    ],
    "es": [
      "Johan Bonnefoy estudió en la Escuela Superior de Arte de Clermont-Ferrand, donde obtuvo una licenciatura y un máster con matrícula de honor. Rápidamente se especializó en dibujo, pintura y música electrónica."
    ]
  },
  "rdfs:label": {
    "fr": [
