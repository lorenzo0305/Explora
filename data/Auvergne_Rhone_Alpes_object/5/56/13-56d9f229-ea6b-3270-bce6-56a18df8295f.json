  "rdfs:comment": {
    "de": [
      "Vier Hektar große Wasserfläche (Karpfen, Schleie, Plötze und Hecht) mit Tageskarten, die vor Ort oder bei Geraud Motoculture in der Rue des Gouttes in Tronget erworben werden können."
    ],
    "en": [
      "Four-hectare lake (carp, tench, roach and pike) with day tickets available on site or from Geraud Motoculture in Rue des Gouttes, Tronget."
    ],
    "it": [
      "Lago di quattro ettari (carpe, tinche, lasche e lucci) con biglietti giornalieri disponibili in loco o presso Geraud Motoculture in Rue des Gouttes, Tronget."
    ],
    "fr": [
      "Plan d'eau de quatre hectares (carpes, tanches, gardons et brochets) avec cartes à la journée à prendre sur place ou chez Geraud Motoculture situé Rue des Gouttes à Tronget."
    ],
    "nl": [
      "Meer van vier hectare (karper, zeelt, voorn en snoek) met dagkaarten ter plaatse of bij Geraud Motoculture in Rue des Gouttes, Tronget."
    ],
    "es": [
      "Lago de 4 hectáreas (carpas, tencas, cucarachas y lucios) con entradas de un día disponibles in situ o en Geraud Motoculture, Rue des Gouttes, Tronget."
    ]
  },
