  "rdfs:comment": {
    "de": [
      "Hier finden Sie die von der Coopérative laitière de Yenne hergestellten Savoyerkäse sowie andere Milchspezialitäten. Ein szenografischer und interaktiver Raum zeigt die Herstellung des Tomme de Savoie."
    ],
    "en": [
      "Direct sale of dairy products and cheeses.  Specialities: tomme de Savoie, Dent du Chat, Savoie raclette, tomme de Yenne, goats cheese (crottins)…"
    ],
    "it": [
      "Scoprite i formaggi savoiardi prodotti dalla cooperativa lattiero-casearia di Yenne e altre specialità casearie. Un'area scenografica e interattiva mostra come viene prodotto il formaggio Tomme de Savoie."
    ],
    "fr": [
      "Retrouvez les fromages de Savoie produits par la Coopérative laitière de Yenne, ainsi que d'autres spécialités laitières. Un espace scénographique et interactif présente la fabrication de la Tomme de Savoie."
    ],
    "nl": [
      "Ontdek de Savoyse kazen van de zuivelcoöperatie van Yenne en andere zuivelspecialiteiten. Een interactieve scenografische ruimte laat zien hoe Tomme de Savoie wordt gemaakt."
    ],
    "es": [
      "Descubra los quesos de Saboya producidos por la cooperativa lechera de Yenne, así como otras especialidades lácteas. Un espacio escenográfico e interactivo muestra cómo se elabora el queso Tomme de Savoie."
    ]
  },
  "rdfs:label": {
    "en": [
      "Shop of Yenne milk cooperative"
    ],
    "fr": [
      "Magasin de vente d'Ayn Dullin (coopérative laitière de Yenne)"
    ]
  },
