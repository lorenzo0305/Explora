  "rdfs:comment": {
    "de": [
      "Le Boule d'Or liegt in der Gemeinde Curis-au-Mont-d'Or, nördlich von Lyon, und ist ein Bauernhof mit diversifiziertem biologischem Gemüseanbau: 3 leidenschaftliche Gemüsebauern, 7 ha AB-Anbau, 50 Gemüsesorten, 100 % Bio!"
    ],
    "en": [
      "Located in Curis-au-Mont-d'Or, north of Lyon, Le Boule d'Or is a diversified organic market gardening farm: 3 passionate market gardeners, 7 ha cultivated in AB, 50 varieties of vegetables, 100% organic!"
    ],
    "it": [
      "Situata nel comune di Curis-au-Mont-d'Or, a nord di Lione, Le Boule d'Or è un'azienda agricola biologica a orto diversificato: 3 ortisti appassionati, 7 ettari coltivati in AB, 50 varietà di ortaggi, 100% biologici!"
    ],
    "fr": [
      "Située sur la commune de Curis-au-Mont-d’Or, au Nord de Lyon, Le Boule d’Or est une ferme en maraîchage biologique diversifié : 3 maraîchers passionnés, 7 ha cultivés en AB, 50 variété des légumes, 100 % Bio !"
    ],
    "es": [
      "Situada en el municipio de Curis-au-Mont-d'Or, al norte de Lyon, Le Boule d'Or es una explotación de huerta ecológica diversificada: 3 hortelanos apasionados, 7 ha cultivadas en AB, 50 variedades de verduras, ¡100% ecológicas!"
    ],
    "nl": [
      "Gelegen in de gemeente Curis-au-Mont-d'Or, ten noorden van Lyon, is Le Boule d'Or een gediversifieerde biologische tuinderij: 3 gepassioneerde tuinders, 7 ha bebouwd in AB, 50 soorten groenten, 100% biologisch!"
    ]
  },
