  "rdfs:comment": {
    "de": [
      "Die Brasserie des Plantes ist die Idee einer handwerklichen Herstellung von Likören und Kräutertees aus vergessenen Pflanzen mit zahlreichen positiven Eigenschaften. Besuchen Sie unser Unternehmen und stellen Sie Ihren eigenen Likör her!"
    ],
    "en": [
      "La Brasserie des Plantes is an artisanal production of liqueurs and infusions made from forgotten plants with multiple virtues. Come and visit us, and why not make your own liqueur!"
    ],
    "it": [
      "La Brasserie des Plantes è l'idea alla base di una produzione tradizionale di liquori e infusi a base di piante dimenticate dalle molteplici virtù. Venite a trovarci e perché non fare il vostro liquore!"
    ],
    "fr": [
      "La Brasserie des Plantes, c’est l’idée d’une production artisanale de liqueurs et d’infusions, à partir de plantes oubliées aux vertus multiples. Venez visiter notre entreprise, pour, pourquoi pas fabriquer votre propre liqueur !"
    ],
    "nl": [
      "La Brasserie des Plantes is het idee achter een ambachtelijke productie van likeuren en infusies gemaakt van vergeten planten met een breed scala aan deugden. Kom langs en maak je eigen likeur!"
    ],
    "es": [
      "La Brasserie des Plantes es la idea de una producción artesanal de licores e infusiones elaborados a partir de plantas olvidadas con un amplio abanico de virtudes. Venga a visitarnos y, por qué no, ¡haga su propio licor!"
    ]
  },
  "rdfs:label": {
    "en": [
      "La Brasserie des Plantes"
    ],
    "fr": [
      "La Brasserie des Plantes"
    ]
  },
