  "rdfs:comment": {
    "de": [
      "Espace Débutant: sanftes Skifahren für die ganze Familie!\r\nHaben Sie Lust, die Freuden des Skifahrens in aller Sicherheit zu entdecken? Der Espace Débutant in Le Lioran ist der ideale Ort, um seine ersten Spuren im Schnee zu ziehen."
    ],
    "en": [
      "Espace Débutant: gentle skiing for the whole family!\r\nWant to discover the joys of skiing in complete safety? The Espace Débutant at Le Lioran is the ideal place to make your first tracks on the snow."
    ],
    "it": [
      "Espace Débutant: sci dolce per tutta la famiglia!\r\nVolete scoprire le gioie dello sci in tutta sicurezza? L'Espace Débutant di Le Lioran è il luogo ideale per fare le prime tracce sulla neve."
    ],
    "fr": [
      "Espace Débutant : le ski en douceur pour toute la famille !\r\nEnvie de découvrir les joies de la glisse en toute sécurité ? L’Espace Débutant du Lioran est l’endroit idéal pour faire ses premières traces sur la neige."
    ],
    "nl": [
      "Espace Débutant: zacht skiën voor het hele gezin!\r\nWil je het plezier van skiën in alle veiligheid ontdekken? De Espace Débutant in Le Lioran is de ideale plek om je eerste sporen in de sneeuw te zetten."
    ],
    "es": [
      "Espace Débutant: ¡esquí suave para toda la familia!\r\n¿Quieres descubrir el placer de esquiar con total seguridad? El Espace Débutant de Le Lioran es el lugar ideal para hacer tus primeras huellas en la nieve."
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'espace débutant"
    ]
  },
