  "rdfs:comment": {
    "de": [
      "Sandrine Grolière stammt von der Insel La Réunion und malt die leuchtenden Landschaften, die üppige Flora und die authentischen und herzlichen Lebensszenen, die den Charme der Insel ausmachen."
    ],
    "en": [
      "Originally from Reunion Island, Sandrine Grolière paints the luminous landscapes, generous flora and warm, authentic scenes of life that give the island its charm."
    ],
    "it": [
      "Originaria dell'Isola della Riunione, Sandrine Grolière dipinge i paesaggi luminosi, la flora generosa e le scene di vita calde e autentiche che rendono l'isola così affascinante."
    ],
    "fr": [
      "Originaire de l'île de la Réunion, Sandrine Grolière peint les paysages luminueuyx, la flore généreuse, les scènes de vie authentiques et chaleureuses qui en font le charme."
    ],
    "nl": [
      "Sandrine Grolière komt oorspronkelijk van het eiland Réunion en schildert de heldere landschappen, de weelderige flora en de warme, authentieke levensscènes die het eiland zo charmant maken."
    ],
    "es": [
      "Originaria de la isla de la Reunión, Sandrine Grolière pinta los luminosos paisajes, la generosa flora y las cálidas y auténticas escenas de la vida que hacen tan encantadora a la isla."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Exposition : Couleurs créoles"
    ]
  },
