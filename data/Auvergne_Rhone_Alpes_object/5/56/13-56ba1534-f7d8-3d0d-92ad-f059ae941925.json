  "rdfs:comment": {
    "de": [
      "Am Rande der Pisten zwischen Plagne Villages und Plagne Soleil empfängt Sie Le Chairlift den ganzen Tag über. Auf der Terrasse oder in einem gemütlichen Rahmen bieten wir Ihnen mittags und abends Speisen und Getränke sowie eine Schlemmerpause für den Goûter und den Aperitif."
    ],
    "en": [
      "Just on the edge of the ski slopes between Plagne Villages and Plagne Soleil, Le Chairlift is pleased to welcome you any time of the day. On the terrace or in the cosy indoor dining room, we are open at lunchtime and in the evening, or for a gourmet teatime snack or an aperitif."
    ],
    "it": [
      "Ai margini delle piste tra Plagne Villages e Plagne Soleil, Le Chairlift vi accoglie tutto il giorno. Sulla terrazza o in un ambiente accogliente, offriamo pranzo e cena, oltre a spuntini gourmet e aperitivi."
    ],
    "fr": [
      "Au bord des pistes entre Plagne Villages et Plagne Soleil, Le Chairlift vous accueille toute la journée. En terrasse ou dans un cadre chaleureux, nous vous proposons une restauration midi et soir, et une pause gourmande pour le gouter et l'apéritif."
    ],
    "es": [
      "Al borde de las pistas entre Plagne Villages y Plagne Soleil, Le Chairlift le da la bienvenida durante todo el día. En la terraza o en un ambiente acogedor, le ofrecemos almuerzos y cenas, así como aperitivos y tentempiés gourmet."
    ],
    "nl": [
      "Aan de rand van de pistes tussen Plagne Villages en Plagne Soleil heet Le Chairlift je de hele dag welkom. Op het terras of in een gezellige setting, bieden wij lunch en diner, evenals gastronomische snacks en aperitieven."
    ]
  },
