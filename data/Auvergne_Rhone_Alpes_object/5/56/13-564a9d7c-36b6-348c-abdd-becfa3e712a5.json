  "rdfs:comment": {
    "de": [
      "COMBO ist ein Bistrot Cantine Lebensmittelgeschäft, das Alltags- und Weltlebensmittel mit leckerer Küche in einer freundlichen und entspannten Street-Food-Atmosphäre verbindet."
    ],
    "en": [
      "COMBO is a Bistrot Cantine grocery store that combines everyday and world groceries with tasty cuisine in a friendly, relaxed street food atmosphere."
    ],
    "it": [
      "COMBO è un negozio di alimentari Bistrot Cantine che combina generi alimentari quotidiani e internazionali con cibi gustosi in un'atmosfera amichevole e rilassata da street food."
    ],
    "fr": [
      "COMBO est une épicerie Bistrot Cantine qui allie épicerie du quotidien et du monde et cuisine savoureuse dans une ambiance Street Food conviviale et détendue."
    ],
    "nl": [
      "COMBO is een Bistrot Cantine kruidenierswinkel die alledaagse en internationale boodschappen combineert met lekker eten in een vriendelijke, ontspannen streetfood sfeer."
    ],
    "es": [
      "COMBO es una tienda de comestibles Bistrot Cantine que combina comestibles cotidianos e internacionales con comida sabrosa en un ambiente agradable y relajado de comida callejera."
    ]
  },
