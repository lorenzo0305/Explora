  "rdfs:comment": {
    "de": [
      "Inmitten des Naturschutzgebietes der Aiguilles Rouges gelegen, unterhalb des Lac Blanc, erwartet Sie vor der Kulisse des Mont-Blanc eine Reihe kleinerer Seen."
    ],
    "en": [
      "Discover this string of little lakes in the Aiguilles Rouges Nature Reserve, below Lac Blanc and facing Mont Blanc."
    ],
    "it": [
      "All'interno della riserva naturale delle Aiguilles Rouges, sotto al Lac Blanc, venite a scoprire questa serie di laghetti affacciati sul Monte Bianco."
    ],
    "fr": [
      "A l'intérieur de la réserve Naturelles des Aiguilles Rouges, sous le Lac Blanc, découvrez un chapelet de petits Lacs face au Mont-Blanc."
    ],
    "nl": [
      "In het natuurreservaat van de Aiguilles Rouges, onder het Lac Blanc, ontdekt u een reeks kleine meren tegenover de Mont Blanc."
    ],
    "es": [
      "Dentro de la Reserva Natural de las Aiguilles Rouges, bajo el Lac Blanc, se extiende un rosario de pequeños lagos de montaña frente al Mont-Blanc."
    ]
  },
