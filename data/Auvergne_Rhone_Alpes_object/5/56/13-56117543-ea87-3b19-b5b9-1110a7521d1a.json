  "rdfs:comment": {
    "de": [
      "Canyoning wird kein Geheimnis mehr für Sie sein! Erleben Sie mit Hydrogène Sports ein pures Naturerlebnis. Sébastien wird Sie gut gelaunt betreuen und Sie werden sicherlich eine unvergessliche Zeit verbringen!\r\nGleitschirmflüge auf Anfrage."
    ],
    "en": [
      "Canyoning will hold no secrets for you! Come and enjoy a Pure Nature Experience with Hydrogène Sports. Sébastien will supervise you in good spirits, and you're sure to have an unforgettable time!\r\nParagliding on request."
    ],
    "it": [
      "Canyoning, parapendio ed escursioni-scalate non avranno più segreti per voi! Hydrogène Sports è una struttura a dimensione umana e familiare, fatta da istruttori dinamici originari della regione e che la conoscono perfettamente."
    ],
    "fr": [
      "Le Canyoning, n'aura plus de secret pour vous ! Venez vivre une Pure Expérience Nature avec Hydrogène Sports, Sébastien vous encadrera dans la bonne humeur et vous passerez assurément un moment inoubliable !\r\nVol en parapente sur demande."
    ],
    "es": [
      "El barranquismo no tendrá secretos para ti Venga a disfrutar de una experiencia en plena naturaleza con Hydrogène Sports. Sébastien le supervisará con buen humor y seguro que pasará un rato inolvidable\r\nVuelos en parapente a petición."
    ],
    "nl": [
      "Canyoning, paragliden en via ferrata zullen u niet langer onbekend blijven!\r\nHydrogène Sports is een familiaal bedrijf op mensenmaat dat bestaat uit dynamische monitoren die de regio door en door kennen."
    ]
  },
