  "rdfs:comment": {
    "de": [
      "Eine spannende Untersuchung, die Sie durch die acht Jahrhunderte der Geschichte des Kartäuserklosters von Sainte-Croix führt und Sie dank Augmented und Virtual Reality an verschiedenen unumgänglichen Orten des Dorfes eintauchen lässt."
    ],
    "en": [
      "This fascinating investigation will take you on a journey through the eight centuries of the history of the Chartreuse de Sainte-Croix, immersing you in the village's key sites thanks to augmented and virtual reality."
    ],
    "it": [
      "Un'indagine affascinante che vi porterà in un viaggio attraverso gli otto secoli di storia della Certosa di Sainte-Croix e vi farà immergere in diversi luoghi chiave del villaggio grazie alla realtà aumentata e virtuale."
    ],
    "fr": [
      "Une enquête passionnante qui vous fera voyager au cours des huit siècles d’histoire de la Chartreuse de Sainte-Croix et vous immerger dans différents lieux incontournables du village grâce à la réalité augmentée et virtuelle."
    ],
    "es": [
      "Una investigación fascinante que le hará viajar a través de los ocho siglos de historia de la Cartuja de Sainte-Croix y le sumergirá en varios lugares clave del pueblo gracias a la realidad aumentada y virtual."
    ],
    "nl": [
      "Een fascinerend onderzoek dat u meeneemt op een reis door de acht eeuwen geschiedenis van het Charterhouse van Sainte-Croix en u onderdompelt in verschillende sleutelplaatsen van het dorp dankzij augmented en virtual reality."
    ]
  },
  "rdfs:label": {
    "en": [
      "The Secret of the Holy Cross Interactive Quest"
    ],
    "fr": [
      "Quête Interactive Le Secret de Sainte-Croix"
    ]
  },
