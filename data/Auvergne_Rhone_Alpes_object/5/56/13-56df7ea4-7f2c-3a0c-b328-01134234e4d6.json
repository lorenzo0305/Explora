  "rdfs:comment": {
    "de": [
      "Les Écuries des Fiz ist ein Reitzentrum mit einer von der Fédération Française d'Equitation anerkannten Reitschule, einem Ponyclub sowie einer Pension und Halbpension für Pferde und Ponys."
    ],
    "en": [
      "Les Écuries des Fiz is an equestrian center including a riding school approved by the French Equestrian Federation, a pony club as well as board and half board for horses and ponies."
    ],
    "it": [
      "Les Écuries des Fiz è un centro ippico che comprende una scuola di equitazione riconosciuta dalla Fédération Française d’Equitation, un club di pony nonché una pensione e mezza pensione per cavalli e pony."
    ],
    "fr": [
      "Les Écuries des Fiz est un centre équestre comprenant une école d’équitation agréée par la Fédération Française d’Equitation, un club de poney ainsi qu’une pension et une demi-pension pour chevaux et poneys."
    ],
    "nl": [
      "Les Écuries des Fiz is een manege met een door de Franse Hippische Federatie erkende rijschool, een ponyclub en pension en halfpension voor paarden en pony's."
    ],
    "es": [
      "Les Écuries des Fiz es un centro ecuestre con una escuela de equitación homologada por la Federación Ecuestre Francesa, un club de ponis, así como pensión y media pensión para caballos y ponis."
    ]
  },
