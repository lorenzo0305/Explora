  "rdfs:comment": {
    "de": [
      "Der Genin-See ist ein idealer Ort für die ganze Familie. Der im Juli und August bewachte Sandstrand befindet sich in der Nähe des Hostels."
    ],
    "en": [
      "Lake Genin is a great place for all the family, with its monitored sandy beach located amongst the trees."
    ],
    "it": [
      "Il lago di Genin è un luogo ideale per tutta la famiglia, con una spiaggia di sabbia vicino all'ostello, sorvegliata nei mesi di luglio e agosto."
    ],
    "fr": [
      "Le lac Genin est un endroit idéal pour toute la famille, avec sa plage de sable surveillée en juillet et août située à proximité de l'auberge."
    ],
    "nl": [
      "Het meer van Genin is een geweldige plek voor het hele gezin, met een zandstrand in de buurt van het hostel, dat in juli en augustus onder toezicht staat."
    ],
    "es": [
      "El lago Genin es un gran lugar para toda la familia, con una playa de arena cerca del albergue, que está supervisada en julio y agosto."
    ]
  },
  "rdfs:label": {
