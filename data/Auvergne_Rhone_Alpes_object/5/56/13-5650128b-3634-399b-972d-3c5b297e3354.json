  "rdfs:comment": {
    "de": [
      "EIN IN EUROPA EINZIGARTIGER ORT DER TRÄUME UND DER MAGIE!\r\nNur wenige Kilometer von Valence entfernt hat der Illusionist Dani Lary eine ehemalige Spinnerei in einen echten Showroom mit 5000 m² Fläche verwandelt, der heute in \"Les Ateliers Magiques\" umbenannt wurde."
    ],
    "en": [
      "A ONE-OF-A-KIND VENUE IN EUROPE DEDICATED TO DREAMS AND MAGIC!\r\nA few kilometers from Valence, illusionist Dani Lary has transformed a former spinning mill into a 5,000 m² showroom, now known as \"Les Ateliers Magiques\"."
    ],
    "it": [
      "UNO SPAZIO UNICO IN EUROPA DEDICATO AI SOGNI E ALLA MAGIA!\r\nA pochi chilometri da Valence, l'illusionista Dani Lary ha trasformato un'ex filanda in uno spazio per spettacoli di 5.000 m², ora noto come Les Ateliers Magiques."
    ],
    "fr": [
      "UN LIEU HORS-NORMES UNIQUE EN EUROPE DÉDIÉ AUX RÊVES ET À LA MAGIE !\r\nÀ quelques kms de Valence, l’illusionniste Dani Lary a transformé une ancienne filature en une véritable salle de spectacle de 5 000 m², aujourd’hui rebaptisée “Les Ateliers Magiques”."
    ],
    "es": [
      "UN LUGAR ÚNICO EN EUROPA DEDICADO A LOS SUEÑOS Y LA MAGIA\r\nA pocos kilómetros de Valence, el ilusionista Dani Lary ha transformado una antigua hilandería en un lugar de espectáculos de 5.000 m², ahora conocido como Les Ateliers Magiques."
    ],
    "nl": [
      "EEN UNIEKE LOCATIE IN EUROPA GEWIJD AAN DROMEN EN MAGIE!\r\nOp slechts een paar kilometer van Valence heeft illusionist Dani Lary een voormalige spinnerij omgetoverd tot een 5.000 m² grote showlocatie, die nu bekend staat als \"Les Ateliers Magiques\"."
    ]
  },
