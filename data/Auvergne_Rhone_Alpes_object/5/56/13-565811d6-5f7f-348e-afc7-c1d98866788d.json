  "rdfs:comment": {
    "de": [
      "Hochgebirgsführer: seit zwanzig Jahren in den Bauges, teilen Sie mit mir einen emotionalen Moment in einem vertikalen Horizont.\r\n\r\nAusflüge für Einzelpersonen, Gruppen und Gemeinschaften.\r\nKletterkurse und Multiaktivitäten für Kinder/Jugendliche und Erwachsene"
    ],
    "en": [
      "Alpine Guide invites you to discover the Massif des Bauges!"
    ],
    "it": [
      "Guida di alta montagna: da vent'anni nelle Bauges, venite con me a condividere un momento di emozione in un orizzonte verticale.\r\n\r\nEscursioni per singoli, gruppi ed enti locali.\r\nCorsi di arrampicata e multiattività per bambini, ragazzi e adulti"
    ],
    "fr": [
      "Guide de Haute Montagne : depuis vingt ans dans les Bauges, venez avec moi partager un moment d’émotion dans un horizon vertical.\r\n\r\nSorties pour les individuels, les groupes et collectivités. \r\nStage escalade et multi activités enfants/ados et adultes"
    ],
    "es": [
      "Guía de alta montaña: desde hace veinte años en las Bauges, venga conmigo a compartir un momento de emoción en un horizonte vertical.\r\n\r\nSalidas para particulares, grupos y colectividades.\r\nCursos de escalada y multiactividad para niños, adolescentes y adultos"
    ],
    "nl": [
      "Berggids gespecialiseerd in hooggebergte\r\nExcursies voor particulieren, gezinnen of groepen.\r\nKlimcursussen en diverse activiteiten voor kinderen en jongeren."
    ]
  },
