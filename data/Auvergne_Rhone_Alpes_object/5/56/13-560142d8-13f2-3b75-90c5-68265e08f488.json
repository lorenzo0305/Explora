  "rdfs:comment": {
    "de": [
      "7. Ausgabe bereits und die Freude, Autoren und Illustratoren der Kinder- und Jugendliteratur zu entdecken und ins Rampenlicht zu stellen, ist mehr denn je vorhanden!"
    ],
    "en": [
      "already in its 7th year, the pleasure of discovering and highlighting authors and illustrators of children's literature is as great as ever!"
    ],
    "it": [
      "sono già passati 7 anni e il piacere di scoprire e valorizzare autori e illustratori per bambini è più grande che mai!"
    ],
    "fr": [
      "7e édition déjà et le plaisir de faire découvrir et mettre en lumière les auteurs et illustrateurs de la littérature jeunesse est plus que jamais au rendez-vous !"
    ],
    "es": [
      "ya han pasado 7 años, ¡y el placer de descubrir y destacar a autores e ilustradores infantiles sigue siendo tan grande como siempre!"
    ],
    "nl": [
      "het is alweer 7 jaar geleden en het plezier om kinderauteurs en -illustratoren te ontdekken en in het zonnetje te zetten is nog altijd even groot!"
    ]
  },
