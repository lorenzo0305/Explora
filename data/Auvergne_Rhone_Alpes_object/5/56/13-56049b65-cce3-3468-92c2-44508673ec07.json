  "rdfs:comment": {
    "de": [
      "In der Nähe des Tyssandier d'Escous-Platzes. Küche mit lokalen Farben. Terrasse im Sommer. Geräumiger Saal im Obergeschoss mit Cantou. Spezialitäten: Fleisch aus Salers, Pounti, Trüffel... Individueller Empfang und Gruppen."
    ],
    "en": [
      "Characteristic regional house, situated near the Tyssandier d’Escous square, offering local cooking. There is a terrace for summer dining and a spacious upstairs room with a “cantou” (fire place), too."
    ],
    "it": [
      "Vicino alla piazza Tyssandier d'Escous. Cucina con colori locali. Terrazza in estate. Ampia sala al piano superiore con camino a legna. Specialità: Carne di Salers, pounti, truffade... Singoli e gruppi sono i benvenuti."
    ],
    "fr": [
      "A proximité de la place Tyssandier d'Escous. Cuisine aux couleurs locales. Terrasse l'été. Salle spacieuse à l'étage avec cantou. Spécialités : viande de Salers, pounti, truffade... Accueil individuel et groupe."
    ],
    "nl": [
      "Vlakbij het Tyssandier d'Escous plein. Keuken met lokale kleuren. Terras in de zomer. Ruime kamer boven met open haard. Specialiteiten: Salers vlees, pounti, truffel... Individuen en groepen zijn welkom."
    ],
    "es": [
      "Cerca de la plaza Tyssandier d'Escous. Cocina con colores locales. Terraza en verano. Amplio salón en la planta superior con chimenea de obra. Especialidades: carne de Salers, pounti, truffade... Se aceptan individuos y grupos."
    ]
  },
  "rdfs:label": {
    "en": [
      "Les Templiers"
    ],
