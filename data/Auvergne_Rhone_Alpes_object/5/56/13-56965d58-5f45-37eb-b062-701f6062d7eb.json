  "rdfs:comment": {
    "de": [
      "Das Relais des Communailles, ein ikonisches Restaurant in Saint-Gervais Mont-Blanc, ist ein Ort, an dem Genießer zusammenkommen, um Momente des Austauschs und der Geselligkeit zu erleben und dabei ein einzigartiges Panorama gegenüber dem Mont-Blanc zu genießen."
    ],
    "en": [
      "Le Relais des Communailles, the iconic restaurant in Saint-Gervais Mont-Blanc, is a place where epicureans gather to enjoy moments of sharing and conviviality, while taking in a unique panorama facing Mont-Blanc."
    ],
    "it": [
      "Le Relais des Communailles, il ristorante simbolo di Saint-Gervais Mont-Blanc, è un luogo in cui i buongustai si riuniscono per vivere momenti di condivisione e convivialità, ammirando un panorama unico sul Monte Bianco."
    ],
    "fr": [
      "Le Relais des Communailles, restaurant iconique à Saint-Gervais Mont-Blanc, est un lieu de vie où les épicuriens se rassemblent pour vivre des moments de partage et de convivialité, en profitant d’un panorama unique face au Mont-Blanc."
    ],
    "nl": [
      "Le Relais des Communailles, het iconische restaurant in Saint-Gervais Mont-Blanc, is een plek waar levensgenieters samenkomen om te genieten van momenten van delen en gezelligheid, terwijl ze genieten van een uniek panorama op de Mont-Blanc."
    ],
    "es": [
      "Le Relais des Communailles, el restaurante emblemático de Saint-Gervais Mont-Blanc, es un lugar donde los epicúreos se reúnen para disfrutar de momentos de convivencia y compartir, mientras contemplan un panorama único frente al Mont-Blanc."
    ]
  },
