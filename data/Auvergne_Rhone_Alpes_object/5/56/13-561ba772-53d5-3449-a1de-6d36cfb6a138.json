  "rdfs:comment": {
    "de": [
      "Entdecken Sie eine traditionelle Ziegenzucht mit der Rasse Massif Central im Herzen des Cézallier.\r\nHerstellung und Verkauf von Ziegenkäse sowie Terrinen: Zicklein, Seeigel (Bärlauch, Öl, Salz)."
    ],
    "en": [
      "Discover a traditional Massif Central goat farm in the heart of the Cézallier region.\r\nProduction and sale of goat cheese and terrines: chevreau, oursinade (wild garlic, oil, salt)."
    ],
    "it": [
      "Scoprite un'azienda caprina tradizionale del Massiccio Centrale nel cuore del Cézallier.\r\nProduzione e vendita di formaggi di capra e terrine: capretto, oursinade (aglio selvatico, olio, sale)."
    ],
    "fr": [
      "Découvrez un élevage traditionnel de chèvres de race massif central en plein cœur du Cézallier. \r\nFabrication et vente de fromage de chèvres ainsi que des terrines : chevreau, oursinade (ail des ours, huile, sel)."
    ],
    "nl": [
      "Ontdek een traditionele geitenboerderij uit het Centraal Massief in het hart van de Cézallier.\r\nWe maken en verkopen geitenkaas en terrines zoals chevreau (geitenkaas) en oursinade (berenknoflook, olie en zout)."
    ],
    "es": [
      "Descubra una explotación caprina tradicional del Macizo Central en el corazón del Cézallier.\r\nElabora y vende queso de cabra y terrinas: cabrito, oursinade (ajo silvestre, aceite, sal)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Terre de seigle - Fromage de chèvre et terrines"
    ]
  },
