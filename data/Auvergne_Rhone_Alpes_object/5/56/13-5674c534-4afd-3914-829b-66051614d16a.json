  "rdfs:comment": {
    "de": [
      "Die Domaine de Menie ist ein einzigartiger und privilegierter Ort, an dem KUNST und Gaumenfreuden miteinander verschmelzen. Das Herzstück der Domaine ist das Atelier der bildenden Künstlerin Nathalie Martenon.\r\nHier werden ihre Werke in einem Showroom ausgestellt und sie unterrichtet ihre Leidenschaft."
    ],
    "en": [
      "The Domaine de Menie is a unique and privileged place where ART and gourmet delights come together. The heart of the Domaine is the studio of Nathalie Martenon, a visual artist.\r\nHer creations are exhibited in a showroom and she teaches her passion there."
    ],
    "it": [
      "Il Domaine de Menie è un luogo unico e privilegiato dove si incontrano ARTE e delizie gastronomiche. Il cuore del Domaine è l'atelier di Nathalie Martenon, artista visiva.\r\nLe sue creazioni sono esposte in uno showroom e lei vi insegna la sua passione."
    ],
    "fr": [
      "Le Domaine de Menie est un lieu unique et privilégié où se mêlent l'ART et la gourmandise. Le cœur du Domaine est l'atelier de Nathalie Martenon, peintre plasticienne.\r\nSes créations s'y exposent en show room et elle y enseigne sa passion."
    ],
    "nl": [
      "Het Domaine de Menie is een unieke en bevoorrechte plek waar KUNST en gastronomie samenkomen. Het hart van het Domaine is het atelier van Nathalie Martenon, een beeldend kunstenares.\r\nHaar creaties worden tentoongesteld in een showroom en ze geeft er les in haar passie."
    ],
    "es": [
      "El Domaine de Menie es un lugar único y privilegiado donde se unen el ARTE y las delicias gastronómicas. El corazón del Domaine es el taller de Nathalie Martenon, artista plástica.\r\nSus creaciones se exponen en una sala de exposiciones y allí enseña su pasión."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Atelier d'Art \"Le Domaine de Menie\""
    ]
  },
