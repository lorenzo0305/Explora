  "rdfs:comment": {
    "de": [
      "Im Herzen von La Boisse gelegen, lassen Sie sich von der vornehmen Atmosphäre des Restaurants Les Accords D'M verführen. Genießen Sie eine schmackhafte, mit Liebe zubereitete Küche in einem einladenden und raffinierten Rahmen."
    ],
    "en": [
      "Situated in the heart of La Boisse, let yourself be seduced by the distinguished atmosphere of the restaurant Les Accords D'M. Enjoy tasty, lovingly-crafted cuisine in a welcoming, refined setting."
    ],
    "it": [
      "Situato nel cuore di La Boisse, lasciatevi sedurre dall'atmosfera distinta del ristorante Les Accords D'M. Venite a gustare una cucina gustosa e amorevole in un ambiente accogliente e raffinato."
    ],
    "fr": [
      "Situé au cœur de La Boisse, laissez vous séduire par l'atmosphère distinguée du restaurant Les Accords D'M. Venez déguster une cuisine savoureuse, conçue avec amour dans un cadre accueillant et raffiné."
    ],
    "es": [
      "Situado en el corazón de La Boisse, déjese seducir por el ambiente distinguido del restaurante Les Accords D'M. Venga a disfrutar de una cocina sabrosa y elaborada con mimo en un ambiente acogedor y refinado."
    ],
    "nl": [
      "Laat je verleiden door de gedistingeerde sfeer van restaurant Les Accords D'M, gelegen in het hart van La Boisse. Kom genieten van smakelijke, met liefde bereide gerechten in een gastvrije, verfijnde omgeving."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Accords d'M"
    ]
  },
