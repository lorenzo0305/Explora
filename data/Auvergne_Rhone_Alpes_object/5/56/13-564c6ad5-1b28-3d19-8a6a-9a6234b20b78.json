  "rdfs:comment": {
    "de": [
      "Japanische Spezialitäten (Sushi, Sashimi, California Rolls, Maki) und indochinesische Spezialitäten (Wok, Frühlingsrollen, Bo Bun), zum Mitnehmen oder vor Ort.\r\nAlle Gerichte sind hausgemacht und werden à la minute mit frischen Zutaten zubereitet."
    ],
    "en": [
      "Japanese specialties (sushi, sashimi, california rolls, maki) and Indochinese specialties (wok, nems, bo bun), takeaway and on-site.\nAll dishes are homemade and prepared à la minute with fresh produce."
    ],
    "it": [
      "Specialità giapponesi (sushi, sashimi, california rolls, maki) e indocinesi (wok, nems, bo bun), da asporto o da mangiare.\r\nTutti i piatti sono fatti in casa e preparati à la minute con prodotti freschi."
    ],
    "fr": [
      "Spécialités japonaises (sushis, sashimis, california rolls, maki) et indochinoises (wok, nems, bo bun), à emporter et sur place.\r\nTous les plats sont fait maison et préparés à la minute avec des produits frais."
    ],
    "nl": [
      "Japanse specialiteiten (sushi, sashimi, california rolls, maki) en Indochinese specialiteiten (wok, nems, bo bun), om mee te nemen of om op te eten.\r\nAlle gerechten zijn huisgemaakt en à la minute bereid met verse producten."
    ],
    "es": [
      "Especialidades japonesas (sushi, sashimi, california rolls, maki) e indochinas (wok, nems, bo bun), para llevar o comer en casa.\r\nTodos los platos son caseros y se preparan al momento con productos frescos."
    ]
  },
