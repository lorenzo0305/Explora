  "rdfs:comment": {
    "de": [
      "Das Café du Rhône, ein symbolträchtiges Bistro am Quai Victor Augagneur im 3. Arrondissement von Lyon, das heute als historisches Monument eingestuft ist, wurde 1902 eröffnet. Genießen Sie eine traditionelle Küche, die aus frischen und hochwertigen Produkten besteht."
    ],
    "en": [
      "The Café du Rhône, an emblematic bistro located on the Quai Victor Augagneur in Lyon's 3rd arrondissement, now listed as a Historic Monument, opened its doors in 1902. Enjoy traditional cuisine made with fresh, quality produce."
    ],
    "it": [
      "Il Café du Rhône, emblematico bistrot sul Quai Victor Augagneur nel 3° arrondissement di Lione, oggi monumento storico tutelato, ha aperto i battenti nel 1902. Si può gustare una cucina tradizionale a base di prodotti freschi e di qualità."
    ],
    "fr": [
      "Le Café du Rhône, bistrot emblématique situé quai Victor Augagneur dans le 3ème arrondissement de Lyon classé aujourd’hui Monument Historique, a ouvert ses portes en 1902. Dégustez une cuisine traditionnelle composée de produits frais et de qualité."
    ],
    "nl": [
      "Het Café du Rhône, een emblematische bistro aan de Quai Victor Augagneur in het 3e arrondissement van Lyon, nu een beschermd historisch monument, opende zijn deuren in 1902. Geniet van de traditionele keuken met verse kwaliteitsproducten."
    ],
    "es": [
      "El Café du Rhône, bistró emblemático del Quai Victor Augagneur, en el distrito 3 de Lyon, declarado monumento histórico, abrió sus puertas en 1902. Disfrute de una cocina tradicional elaborada con productos frescos y de calidad."
    ]
  },
