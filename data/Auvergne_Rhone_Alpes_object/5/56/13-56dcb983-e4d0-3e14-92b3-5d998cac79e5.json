  "rdfs:comment": {
    "de": [
      "Kunstschmuck in Einzelstücken oder Kleinstserien aus geschmolzenem Kupfer- und Bronzemetall... Isabelle empfängt Sie das ganze Jahr über in ihrem Atelier Expo/Verkauf und bietet Ihnen auch Kurse zur Kreation von Metallschmuck an, um Ihre Kreativität zu entfalten"
    ],
    "en": [
      "Jewels, alchemy, fire, earth: Art Jewels in single or very small series in copper and bronze metal fused.... Isabelle welcomes you all year in his workshop and also offers fun training at metal jewelry creation to expand your creativity."
    ],
    "it": [
      "Gioielli d'arte in pezzi unici o piccolissime serie in rame e bronzo fusi... Isabelle vi accoglie tutto l'anno nel suo laboratorio e vi offre anche corsi di creazione di gioielli in metallo per sviluppare la vostra creatività"
    ],
    "fr": [
      "Bijoux d’Art en pièces uniques ou très petites séries en métal fusionné de cuivre et bronze... Isabelle vous accueille toute l’année dans son Atelier Expo/vente et vous propose aussi des stages de création de bijoux en métal pour épanouir votre créativité"
    ],
    "nl": [
      "Kunstjuwelen in unieke stukken of zeer kleine series in gesmolten koper en brons... Isabelle ontvangt u het hele jaar door in haar atelier en biedt u ook cursussen metaalbewerking om uw creativiteit te ontwikkelen"
    ],
    "es": [
      "Joyas de arte en piezas únicas o series muy pequeñas en metal fundido de cobre y bronce... Isabelle le acoge durante todo el año en su taller y le ofrece también cursos de creación de joyas de metal para desarrollar su creatividad"
    ]
  },
  "rdfs:label": {
    "en": [
      "Illuvion Jewels - Isabelle Di Martino"
    ],
    "fr": [
      "Illuvion Bijoux – Isabelle Di Martino"
    ]
  },
