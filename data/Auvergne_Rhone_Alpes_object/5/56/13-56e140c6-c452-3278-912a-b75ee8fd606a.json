  "rdfs:comment": {
    "de": [
      "Haut-Rhône Tourisme bietet Ihnen die Möglichkeit, Seyssel auf diesem geführten Spaziergang zu entdecken.\r\n\r\nDiese Route ist ideal, um die beiden Dörfer von Seyssel (Ain und Haute-Savoie), ihr Natur- und Kulturerbe zu entdecken."
    ],
    "en": [
      "Haut-Rhône Tourisme proposes you to discover Seyssel through this geo-guided walking tour.\r\n\r\nThis itinerary is ideal to discover the two towns of Seyssel (Ain and Haute-Savoie), their natural and cultural heritage."
    ],
    "it": [
      "Haut-Rhône Tourisme vi invita a scoprire Seyssel attraverso questa passeggiata geo-guidata.\r\n\r\nQuesto itinerario è ideale per scoprire i due villaggi del Seyssel (Ain e Alta Savoia), il loro patrimonio naturale e culturale."
    ],
    "fr": [
      "Haut-Rhône Tourisme vous propose de découvrir Seyssel à travers cette balade pédestre géo-guidée.\r\n\r\nCet itinéraire est idéal pour découvrir les deux bourgs de Seyssel (Ain et Haute-Savoie), leur patrimoine naturel et culturel."
    ],
    "nl": [
      "Haut-Rhône Tourisme nodigt u uit om Seyssel te ontdekken via deze geo-geleide wandeling.\r\n\r\nDeze route is ideaal om de twee dorpen van Seyssel (Ain en Haute-Savoie) en hun natuurlijke en culturele erfgoed te ontdekken."
    ],
    "es": [
      "Haut-Rhône Tourisme le invita a descubrir Seyssel a través de este paseo geo-guiado.\r\n\r\nEste itinerario es ideal para descubrir los dos pueblos de Seyssel (Ain y Haute-Savoie), su patrimonio natural y cultural."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Randonnée VAE : Bourgs de Seyssel"
    ]
  },
