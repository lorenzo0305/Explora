  "rdfs:comment": {
    "de": [
      "Carine Giraud bietet die Eier aus ihrer \"Cocotterie\" mit 6000 Legehennen Label Rouge an, die extra frisch sind, von Hand gesammelt und von ihr selbst sortiert werden."
    ],
    "en": [
      "Carine Giraud offers eggs from her \"cocotterie\" of 6,000 Label rouge laying hens, extra fresh, hand-picked and sorted by her."
    ],
    "it": [
      "Carine Giraud offre uova provenienti dalla sua \"cocotterie\" di 6.000 galline ovaiole Label Rouge, freschissime, raccolte e selezionate a mano da lei."
    ],
    "fr": [
      "Carine Giraud propose les œufs issus de sa « cocotterie » de 6 000 poules pondeuses Label rouge, extra frais, ramassés à la main et triés par ses soins."
    ],
    "es": [
      "Carine Giraud ofrece huevos de su \"cocotterie\" de 6.000 gallinas ponedoras Label Rouge, extra frescos, recogidos y clasificados a mano por ella misma."
    ],
    "nl": [
      "Carine Giraud biedt eieren van haar 'cocotterie' van 6000 Label Rouge leghennen, die extra vers zijn, met de hand geplukt en gesorteerd door haar."
    ]
  },
