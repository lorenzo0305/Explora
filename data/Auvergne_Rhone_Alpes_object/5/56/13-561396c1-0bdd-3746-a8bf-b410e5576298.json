  "rdfs:comment": {
    "de": [
      "Das Bistrot de Malbosc bietet Ihnen eine bodenständige Küche aus frischen, lokalen Produkten mit kurzen Transportwegen. Außergewöhnliches Fleisch und traditionelle Rezepte aus der Ardèche. Alles hausgemacht!"
    ],
    "en": [
      "The Bistrot de Malbosc offers local cuisine based on fresh local produce. Exceptional meats and traditional Ardèche recipes. All homemade!"
    ],
    "it": [
      "Offriamo una cucina locale basata su prodotti freschi del territorio. Carni di razze eccezionali e ricette tradizionali dell'Ardèche, una carta dei vini con oltre 70 referenze e una vista panoramica sulle Cévennes!"
    ],
    "fr": [
      "Nous vous proposons une cuisine de terroir à base de produits frais et locaux en circuit court. Des viandes de races d’exception et recettes traditionnelles ardéchoises, une carte des vins avec plus de 70 références et vue panoramique sur les Cévennes !"
    ],
    "nl": [
      "Wij bieden een lokale keuken op basis van verse streekproducten. Vlees van uitzonderlijke rassen en traditionele recepten uit de Ardèche, een wijnkaart met meer dan 70 referenties en een panoramisch uitzicht op de Cevennen!"
    ],
    "es": [
      "Le proponemos una cocina local basada en productos frescos de la tierra. Carnes de razas excepcionales y recetas tradicionales de Ardèche, una carta de vinos con más de 70 referencias y ¡vistas panorámicas de las Cevenas!"
    ]
  },
