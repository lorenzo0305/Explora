  "rdfs:comment": {
    "de": [
      "Jahrhundert im neogotischen Stil erbaute Kirche liegt auf dem großen Platz, auf dem auch das Kriegerdenkmal steht."
    ],
    "en": [
      "Camped on the large square where the war memorial also stands, the church built in the 19th century in neo-gothic style, imposes its vast proportions and its belt of buttresses in the heart of the village."
    ],
    "it": [
      "La chiesa, costruita nel XIX secolo in stile neogotico, si erge nel cuore del villaggio, imponendo le sue vaste proporzioni e la sua cintura di contrafforti."
    ],
    "fr": [
      "Campée sur la grande place où veille aussi le monument aux morts l'église construite au XIX° siècle en style néogothique, impose au cœur du village ses vastes proportions et sa ceinture de contreforts."
    ],
    "es": [
      "La iglesia, construida en el siglo XIX en estilo neogótico, se alza en el corazón del pueblo, imponiendo sus vastas proporciones y su cinturón de contrafuertes."
    ],
    "nl": [
      "De kerk, gebouwd in de 19e eeuw in neogotische stijl, staat in het hart van het dorp, met enorme afmetingen en een gordel van steunberen."
    ]
  },
