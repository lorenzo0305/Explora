  "rdfs:comment": {
    "de": [
      "Entdecken Sie Le Lounge, eine stimmungsvolle Bar/Restaurant, die Gaumenfreuden und gemeinsames Essen in einem gemütlichen Rahmen vereint, im Winter dank des gemütlichen Bar- und Restaurantraums und im Sommer mit seiner 300 m2 großen schattigen Terrasse."
    ],
    "en": [
      "Discover Le Lounge, an atmospheric bar/restaurant that combines gourmet delights and sharing in a warm setting, in winter thanks to its cosy bar and dining room, and in summer with its 300m2 shaded terrace."
    ],
    "it": [
      "Scoprite Le Lounge, un bar-ristorante d'atmosfera che combina delizie gastronomiche e condivisione in un ambiente caldo, in inverno grazie all'accogliente bar e alla sala da pranzo, e in estate con la sua terrazza ombreggiata di 300 m2."
    ],
    "fr": [
      "Découvrez Le Lounge, un bar/restaurant à ambiance qui mêle gourmandise et partage dans un cadre chaleureux, en hiver grâce à sa salle de bar et sa salle de resto cosy, comme en été avec ses 300m2 de terrasse ombragée."
    ],
    "nl": [
      "Ontdek Le Lounge, een sfeervolle bar/restaurant dat gastronomische hoogstandjes combineert met delen in een warme omgeving, in de winter dankzij de gezellige bar en eetzaal, en in de zomer met het schaduwrijke terras van 300 m2."
    ],
    "es": [
      "Descubra Le Lounge, un bar-restaurante de ambiente que combina delicias gastronómicas y compartir en un entorno cálido, en invierno gracias a su acogedor bar y comedor, y en verano con su terraza sombreada de 300 m2."
    ]
  },
