  "rdfs:comment": {
    "de": [
      "Handgemachte, überfettete Seifen, die in Pierrefonds nach der Methode der Kaltverseifung von der Seifenmeisterin Marie hergestellt werden.\nKosmetikprodukte von hoher Qualität.\nSeifenfabrik mit dem Label Slow Cosmetics."
    ],
    "en": [
      "Artisanal soaps, made in Pierrefonds according to the cold saponification method by Marie, master soap maker.\nHigh quality cosmetic products.\nSoap factory with the Slow Cosmetic label."
    ],
    "it": [
      "Saponi artigianali, realizzati a Pierrefonds secondo il metodo della saponificazione a freddo da Marie, maestra saponaia.\nProdotti cosmetici di alta qualità.\nEtichetta Slow Cosmetics."
    ],
    "fr": [
      "Savons artisanaux surgras, fabriqués à Pierrefonds selon la méthode de saponification à froid par Marie, maître savonnière.\nProduits cosmétiques de haute qualité.\nSavonnerie labellisée Slow Cosmétique."
    ],
    "es": [
      "Jabones artesanales, elaborados en Pierrefonds según el método de saponificación en frío por Marie, maestra jabonera.\nProductos cosméticos de alta calidad.\nEtiqueta de Slow Cosmetics."
    ],
    "nl": [
      "Artisanale zepen, gemaakt in Pierrefonds volgens de koude verzepingsmethode door Marie, meester-zeepmaakster.\nHoogwaardige cosmetische producten.\nSlow Cosmetics label."
    ]
  },
