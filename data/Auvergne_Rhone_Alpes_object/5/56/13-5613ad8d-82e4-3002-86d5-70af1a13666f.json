  "rdfs:comment": {
    "de": [
      "Innenbecken aufgrund von Arbeiten im Zusammenhang mit dem Rutschproblem nur unter bestimmten Bedingungen geöffnet.\r\nAußenbecken im Sommer teilweise geöffnet, ebenfalls unter besonderen Bedingungen."
    ],
    "en": [
      "Indoor pools open under certain conditions due to works related to slipperiness issues.\r\nOutdoor pool partially open in summer, also under certain conditions."
    ],
    "it": [
      "Le piscine interne sono aperte a condizioni particolari a causa di lavori legati alla scivolosità.\r\nPiscina esterna parzialmente aperta in estate, anch'essa soggetta a condizioni particolari."
    ],
    "fr": [
      "Bassins intérieurs ouverts sous conditions en raison de travaux liés au problème de glissance.\r\nBassin extérieur ouvert partiellement en été, sous conditions particulière également."
    ],
    "es": [
      "Piscinas cubiertas abiertas sujetas a condiciones debido a obras relacionadas con el deslizamiento.\r\nPiscina exterior parcialmente abierta en verano, también sujeta a condiciones especiales."
    ],
    "nl": [
      "Binnenzwembaden geopend onder voorwaarden vanwege werkzaamheden in verband met gladheid.\r\nBuitenzwembad gedeeltelijk geopend in de zomer, ook onder speciale voorwaarden."
    ]
  },
