  "rdfs:comment": {
    "de": [
      "Dyönisette, ein besonders schelmisches Gnolu, ist der Wachsamkeit der L.I.G. (Lutte contre l'Invasion des Gnolus) entgangen. Begeben Sie sich auf ihre Spuren durch die Weinberge und Wälder!"
    ],
    "en": [
      "Dyönisette, a particularly mischievous Gnolu, has escaped the vigilance of the L.I.G. (Lutte contre l?Invasion des Gnolus). Follow in her footsteps through vineyards and woods!"
    ],
    "it": [
      "Dyönisette, uno Gnolu particolarmente dispettoso, è sfuggito alla vigilanza della L.I.G. (Lutte contre l'Invasion des Gnolus). Seguite le sue orme attraverso i vigneti e i boschi!"
    ],
    "fr": [
      "Dyönisette, une Gnolu particulièrement espiègle, a échappé à la vigilance de la L.I.G (Lutte contre l’Invasion des Gnolus). Partez sur ses traces à travers les vignes et dans les bois !"
    ],
    "es": [
      "Dyönisette, una gnolu especialmente traviesa, ha escapado a la vigilancia del G.I.L. (Lucha contra la Invasión de los Gnolus). Sigue sus pasos por los viñedos y los bosques"
    ],
    "nl": [
      "Dyönisette, een bijzonder ondeugende Gnolu, is ontsnapt aan de waakzaamheid van de L.I.G. (Lutte contre l?Invasion des Gnolus). Treed in haar voetsporen door de wijngaarden en bossen!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Gnolus - Roule barrique"
    ]
  },
