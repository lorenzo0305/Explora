  "rdfs:comment": {
    "de": [
      "Anlässlich des 200. Geburtstags von William Bouguereau (1825 ? 1905) ehrt die Tomaselli Collection diesen bedeutenden Meister des 19. Jahrhunderts mit einer Ausstellung, die seine Beziehungen zu den Lyoner Künstlern erforscht."
    ],
    "en": [
      "To mark the bicentenary of the birth of William Bouguereau (1825 ? 1905), Tomaselli Collection pays tribute to this major 19th-century master with an exhibition exploring his relationship with Lyon?s artists."
    ],
    "it": [
      "In occasione del bicentenario della nascita di William Bouguereau (1825 - 1905), la Collezione Tomaselli rende omaggio a questo grande maestro del XIX secolo con una mostra che esplora il suo rapporto con gli artisti lionesi."
    ],
    "fr": [
      "À l’occasion du bicentenaire de la naissance de William Bouguereau (1825 – 1905), Tomaselli Collection rend hommage à ce maître majeur du XIXe siècle à travers une exposition qui explore ses relations avec les artistes lyonnais."
    ],
    "nl": [
      "Ter gelegenheid van de tweehonderdste geboortedag van William Bouguereau (1825 ? 1905) brengt de Tomaselli Collectie hulde aan deze belangrijke 19e-eeuwse meester met een tentoonstelling over zijn relatie met de kunstenaars van Lyon."
    ],
    "es": [
      "Con motivo del bicentenario del nacimiento de William Bouguereau (1825 - 1905), la Colección Tomaselli rinde homenaje a este gran maestro del siglo XIX con una exposición que explora su relación con los artistas lioneses."
    ]
  },
  "rdfs:label": {
    "fr": [
      "William Bouguereau et les peintres lyonnais"
    ]
  },
