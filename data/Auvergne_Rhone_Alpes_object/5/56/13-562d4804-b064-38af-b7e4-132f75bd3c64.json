  "rdfs:comment": {
    "de": [
      "Bei Pépé Gust' genießt man das Leben: eine Bistroküche teilen, anstoßen, Bekanntschaften machen, lachen, schlemmen... alles ist möglich, man kann sogar bei ihm übernachten!"
    ],
    "en": [
      "At Pépé Gust’s, share a meal at any hour, enjoy a drink, meet people, laugh, or just have an all-around good time… and you can even stay the night!"
    ],
    "it": [
      "Al Pépé Gust' ci godiamo la vita: condividere la cucina di un bistrot, brindare, incontrare persone, ridere, banchettare... tutto è possibile, possiamo anche dormire da noi!"
    ],
    "fr": [
      "Chez Pépé Gust', on profite de la vie : partager une cuisine bistro, trinquer, faire des rencontres, rire, festoyer... tout est possible, on peut même dormir chez lui !"
    ],
    "es": [
      "En Pépé Gust' disfrutamos de algunos de los placeres de la vida como compartir una cocina bistró, brindar, conocer gente nueva, reír, festejar, etc. Todo es posible, ¡incluso dormir en su casa!"
    ],
    "nl": [
      "Bij Pépé Gust' genieten we van het leven: een bistrokeuken delen, proosten, mensen ontmoeten, lachen, feesten... alles is mogelijk, we kunnen zelfs blijven slapen!"
    ]
  },
