  "rdfs:comment": {
    "de": [
      "Sandrine und Pascal bieten Ihnen Galettes (glutenfrei), Crêpes, Salate, aber auch eine auvergnatische Küche an. Jede Woche variiert ein aktueller Galette und ein Crêpe!"
    ],
    "en": [
      "Sandrine and Pascal offer (gluten-free) galettes, crêpes, salads and Auvergne cuisine. A galette and a crêpe of the moment vary every week!"
    ],
    "it": [
      "Sandrine e Pascal vi propongono galettes (senza glutine), crêpes, insalate ma anche la cucina dell'Alvernia. Una galette e una crêpe del momento variano ogni settimana!"
    ],
    "fr": [
      "Sandrine et Pascal vous proposent des galettes (sans gluten), crêpes, salades mais aussi une cuisine auvergnate. Une galette et une crêpe du moment varie chaque semaine !"
    ],
    "es": [
      "Sandrine y Pascal le ofrecen galettes (sin gluten), crêpes, ensaladas, pero también cocina de Auvernia. ¡Una galette y una crêpe del momento varían cada semana!"
    ],
    "nl": [
      "Sandrine en Pascal bieden u (glutenvrije) galettes, crêpes, salades maar ook gerechten uit de Auvergne. Een galette en een crêpe van het moment varieert elke week!"
    ]
  },
