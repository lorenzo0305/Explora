  "rdfs:comment": {
    "de": [
      "Zwischen dem PNR du Vercors und dem PNR des Baronnies Provençales ist das Diois bei Mountainbikern, die den Nervenkitzel suchen, und bei Radfahrern für seine mittelhohen Pässe bekannt, die sich ideal für eine Aufwärmrunde eignen."
    ],
    "en": [
      "Situated between the Vercors and Baronnies Provençales Regional Nature Parks, the Diois region is renowned among thrill-seeking mountain bikers and cyclists for its medium-altitude passes, ideal for warming up..."
    ],
    "it": [
      "Situata tra i parchi naturali regionali del Vercors e delle Baronnies Provençales, la regione del Diois è rinomata tra gli appassionati di mountain bike e ciclismo per i suoi passi di media altitudine, ideali per entrare nel vivo..."
    ],
    "fr": [
      "Entre le PNR du Vercors et celui des Baronnies Provençales, le Diois est reconnu par les vététistes amateurs de sensations fortes et en cyclo pour ses cols d'altitude moyenne idéaux pour une mise en jambe.."
    ],
    "es": [
      "Situada entre los Parques Naturales Regionales del Vercors y de las Baronnies Provençales, la región de Diois es famosa entre los amantes de la BTT y el ciclismo por sus puertos de media altitud, ideales para entrar en contacto con la naturaleza..."
    ],
    "nl": [
      "De regio Diois, gelegen tussen de regionale natuurparken Vercors en Baronnies Provençales, staat bij mountainbikers en fietsers bekend om zijn middelhoge passen, ideaal voor een warming-up..."
    ]
  },
  "rdfs:label": {
    "fr": [
