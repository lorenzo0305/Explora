  "rdfs:comment": {
    "de": [
      "Die Bibliothek von Chirens est wurde vor über 20 Jahren in der Gemeinde gegründet. Das Team besteht aus zwei Bibliothekarinnen und 15 ehrenamtlichen Mitarbeitern. Auf 180m² finden Sie über 10.000 Bücher, Zeitschriften, DVDs und Videospiele, die Sie ausleihen können."
    ],
    "en": [
      "The Chirens library was created over 20 years ago. The team consists of 2 librarians and 15 volunteers. In its 180m², you can borrow over 10,000 books, magazines, DVDs and video games."
    ],
    "it": [
      "La biblioteca di Chirens è stata istituita più di 20 anni fa. Il team è composto da 2 bibliotecari e 15 volontari. Nei suoi 180 m² è possibile prendere in prestito oltre 10.000 libri, riviste, DVD e videogiochi."
    ],
    "fr": [
      "La bibliothèque de Chirens est a été créée il y a plus de 20 ans dans la commune. L’équipe est composée de 2 bibliothécaires et de 15 bénévoles. Dans ses 180m², vous pouvez trouver plus de 10000 livres, magazines, DVD et jeux vidéos empruntables."
    ],
    "es": [
      "La biblioteca de Chirens se creó hace más de 20 años. El equipo está formado por 2 bibliotecarios y 15 voluntarios. En sus 180 m² se pueden tomar prestados más de 10.000 libros, revistas, DVD y videojuegos."
    ],
    "nl": [
      "De bibliotheek van Chirens werd meer dan 20 jaar geleden opgericht. Het team bestaat uit 2 bibliothecarissen en 15 vrijwilligers. In de 180 m² kun je meer dan 10.000 boeken, tijdschriften, dvd's en videogames lenen."
    ]
  },
