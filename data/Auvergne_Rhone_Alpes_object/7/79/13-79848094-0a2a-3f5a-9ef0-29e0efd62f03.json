  "rdfs:comment": {
    "de": [
      "In Oyonnax gab es viele \"Kämmerer\". Hier steht noch das Schild des Kammherstellers Hugon Verdet, das sich in der Rue de la Paix befand."
    ],
    "en": [
      "Oyonnax was home to many \"comb makers\". The sign of comb manufacturer Hugon Verdet, located on rue de la Paix, can still be seen here."
    ],
    "it": [
      "Oyonnax era la patria di molti \"fabbricanti di pettini\". Qui si può ancora vedere l'insegna del fabbricante di pettini Hugon Verdet in rue de la Paix."
    ],
    "fr": [
      "Oyonnax comptait de nombreux «peigneux». Ici subsiste l’enseigne du fabricant de peignes Hugon Verdet située rue de la Paix."
    ],
    "nl": [
      "Oyonnax was de thuisbasis van veel \"kammenmakers\". Hier kun je nog steeds het uithangbord zien van de kammenfabrikant Hugon Verdet in de rue de la Paix."
    ],
    "es": [
      "Oyonnax fue cuna de muchos \"fabricantes de peines\". Aquí todavía se puede ver el rótulo del fabricante de peines Hugon Verdet en la rue de la Paix."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Fresques et murs peints - Peignes Hugon Verdet"
    ]
  },
