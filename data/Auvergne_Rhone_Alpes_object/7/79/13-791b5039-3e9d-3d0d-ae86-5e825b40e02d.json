  "rdfs:comment": {
    "de": [
      "Bar mit Ravioli\r\nFür jeden Feinschmecker ist etwas dabei: kleiner Hunger, großer Hunger, Salate (mit Ravioli) ...\r\nVor Ort oder zum Mitnehmen"
    ],
    "en": [
      "Ravioli bar\r\nThere's something for everyone: small hungers, large hungers, salad formulas (with ravioli)...\r\nOn the spot or to take away"
    ],
    "it": [
      "Bar dei ravioli\r\nCe n'è per tutti i gusti: piccoli languorini, grandi languorini, formule di insalata (con ravioli)...\r\nSul posto o da asporto"
    ],
    "fr": [
      "Bar à ravioles\r\nIl y a en aura pour tous les gourmands : petites faims, grosses faims, des formules salade (avec ravioles) ..\r\nSur place ou à emporter"
    ],
    "nl": [
      "Ravioli bar\r\nEr is voor elk wat wils: kleine trek, grote trek, saladeformules (met ravioli) ...\r\nTer plaatse of om mee te nemen"
    ],
    "es": [
      "Barra de raviolis\r\nHay para todos los gustos: pequeños hambrientos, grandes hambrientos, fórmulas de ensaladas (con raviolis)...\r\nEn el momento o para llevar"
    ]
  },
  "rdfs:label": {
