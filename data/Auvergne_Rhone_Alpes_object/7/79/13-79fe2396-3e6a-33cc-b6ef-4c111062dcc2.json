  "rdfs:comment": {
    "de": [
      "Dieser Ort, der sowohl der Kunst als auch dem lokalen Erbe aus Lehm gewidmet ist, beherbergt Ausstellungen und Aufführungen für kulturelle Termine, die für alle und alle Künste offen sind."
    ],
    "en": [
      "Chevrotière barn is dedicated to art and local heritage. It’s a venue for cultural events and exhibitions and shows"
    ],
    "it": [
      "Dedicata all'arte e al patrimonio locale di terra, questa sede ospita mostre ed esposizioni, per eventi culturali aperti a tutti e a tutte le arti."
    ],
    "fr": [
      "Dédié à la fois à l'art et au patrimoine local en terre, ce lieu accueille des expositions et des spectacles, pour des rendez-vous culturels ouverts à tous et à tous les arts."
    ],
    "nl": [
      "Deze locatie, gewijd aan zowel de kunst als het lokale aardse erfgoed, biedt onderdak aan tentoonstellingen en voorstellingen, voor culturele evenementen die voor iedereen en voor alle kunsten toegankelijk zijn."
    ],
    "es": [
      "Dedicado tanto al arte como al patrimonio local de la tierra, este lugar acoge exposiciones y espectáculos, para eventos culturales abiertos a todos y a todas las artes."
    ]
  },
