  "rdfs:comment": {
    "de": [
      "3 Säle: 71, 121 und 216 Plätze. Alle sind mit digitaler Technik ausgestattet. Ein 3D-Saal. Vorführung der neuesten Filme, aber auch \"Art et Essai\"-Vorstellungen. Programm und Preise auf der Website."
    ],
    "en": [
      "3 rooms: 71, 121 and 216 seats. All equipped with digital technology. A 3D room. Projection of the latest films but also \"Art et Essai\" screenings. Programme and prices on the website."
    ],
    "it": [
      "3 sale: 71, 121 e 216 posti. Tutti dotati di tecnologia digitale. Una stanza 3D. Proiezione degli ultimi film ma anche sessioni di \"Art et Essai\". Programma e prezzi sul sito web."
    ],
    "fr": [
      "3 salles : 71, 121 et 216 places. Toutes équipées en numérique. Une salle 3D. Projection des derniers films mais aussi séances \"Art et Essai\". Programme et tarifs sur le site internet."
    ],
    "nl": [
      "3 zalen: 71, 121 en 216 zitplaatsen. Allemaal uitgerust met digitale technologie. Een 3D kamer. Vertoning van de nieuwste films maar ook \"Art et Essai\" sessies. Programma en prijzen op de website."
    ],
    "es": [
      "3 salas: 71, 121 y 216 plazas. Todo equipado con tecnología digital. Una sala 3D. Proyección de las últimas películas, pero también sesiones de \"Art et Essai\". Programa y precios en el sitio web."
    ]
  },
