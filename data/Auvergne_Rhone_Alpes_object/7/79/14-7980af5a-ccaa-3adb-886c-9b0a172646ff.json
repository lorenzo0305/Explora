  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/6cd55927-3a75-3ad4-a404-be78a3e67c33",
      "dc:description": {
        "de": [
          "Tennis für jedermann, Freizeit und Wettkampf im Team, Jugendliche und Erwachsene, Gesundheitstennis (auf ärztliche Verordnung), in einer freundlichen Atmosphäre.\nHanditennis ist ebenfalls möglich.\n\nTennisplatz mieten avenue des Garennes in Montreuil-sur-Mer."
        ],
        "en": [
          "Tennis for all, leisure and competitive team play, for youngsters and adults, health tennis (on medical prescription), in a friendly atmosphere.\nHanditennis also available.\n\nTennis court rental avenue des Garennes, Montreuil-sur-Mer."
        ],
        "it": [
          "Tennis per tutti, per giovani e meno giovani, squadre ricreative e competitive, tennis per la salute (con prescrizione medica), in un'atmosfera amichevole.\nÈ disponibile anche l'handitennis.\n\nNoleggio campi da tennis avenue des Garennes, Montreuil-sur-Mer."
        ],
        "fr": [
          "Un tennis accessible à tous, loisir et compétition en équipe, jeunes et adultes, tennis santé (sur prescription médicale), dans une ambiance conviviale. \nHanditennis possible également.\n\nLocation de court de tennis avenue des Garennes à Montreuil-sur-Mer."
        ],
        "nl": [
          "Tennis voor iedereen, voor jong en oud, recreatieve en competitieve teams, gezondheidstennis (op doktersvoorschrift), in een gezellige sfeer.\nHandtennis is ook mogelijk.\n\nHuur tennisbaan avenue des Garennes, Montreuil-sur-Mer."
        ],
        "es": [
          "Tenis para todos, para jóvenes y mayores, equipos recreativos y de competición, tenis para la salud (con receta médica), en un ambiente agradable.\nTambién se ofrece tenis de mano.\n\nAlquiler de pistas de tenis avenue des Garennes, Montreuil-sur-Mer."
        ]
      },
