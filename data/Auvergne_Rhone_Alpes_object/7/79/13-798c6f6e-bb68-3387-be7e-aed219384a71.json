  "rdfs:comment": {
    "de": [
      "Eine gewagte thematische Assoziation: Rindfleisch und die Atmosphäre der fünfziger Jahre verbinden – mit dem Ehrgeiz, sich von den klassischen Codes der Fleischrestaurants frei zu machen. Blau- und Orange-Töne ersetzen die traditionelle Codefarbe Rot."
    ],
    "en": [
      "This is a meat bistro with a 50s decor and a selection of beef from the best breeds. The cuisine is homemade and local, with gourmet burgers and a salad menu. Open 7 days a week from 11.30am."
    ],
    "it": [
      "È un bistrot di carne con un arredamento anni '50 e una selezione di carni bovine delle migliori razze. La cucina è casalinga e locale, con hamburger gourmet e un menu di insalate. Aperto 7 giorni su 7 dalle 11.30."
    ],
    "fr": [
      "C'est un bistrot à viande mêlant déco 50's et une sélection de viandes de bœuf issues des meilleures races. La cuisine est maison, locale et propose aussi des burgers gourmets et une carte de salades. C'est ouvert 7j/7 en continu à partir de 11h30."
    ],
    "es": [
      "Se trata de un bistró cárnico con una decoración de los años 50 y una selección de carne de vacuno de las mejores razas. La cocina es casera y local, con hamburguesas gourmet y una carta de ensaladas. Abierto los 7 días de la semana a partir de las 11.30 h."
    ],
    "nl": [
      "Dit is een vleesbistro met een jaren 50 decor en een selectie rundvlees van de beste rassen. De keuken is huisgemaakt en lokaal, met hamburgers voor fijnproevers en een salademenu. 7 dagen per week geopend vanaf 11.30 uur."
    ]
  },
