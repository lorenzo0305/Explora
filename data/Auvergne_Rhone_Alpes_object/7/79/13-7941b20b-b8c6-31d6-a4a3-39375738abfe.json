  "rdfs:comment": {
    "de": [
      "Very Thés ist eine Marke für Bio-Tees und Kräutertees, die von Amandine und Anthony im Revermont-Gebiet gegründet wurde. Entdecken Sie über 80 Referenzen an Tees und Kräutertees in ihrem Laden in Ceyzériat, auf www.very-thes.com und bei zahlreichen lokalen Händlern."
    ],
    "en": [
      "Very Thés is a brand of organic teas and infusions created by Amandine and Anthony in the Revermont region. Discover over 80 references of teas and infusions in their store in Ceyzériat, on www.very-thes.com and through numerous local retailers."
    ],
    "it": [
      "Very Thés è un marchio di tè e infusi biologici creato da Amandine e Anthony nella regione di Revermont. È possibile trovare oltre 80 diversi tè e infusi nel loro negozio di Ceyzériat, su www.very-thes.com e presso molti rivenditori locali."
    ],
    "fr": [
      "Very Thés est une marque de thés et infusions bio créée par Amandine et Anthony dans le Revermont. Découvrez plus de 80 références de thés et infusions au sein de leur boutique à Ceyzériat, sur www.very-thes.com et auprès de nombreux revendeurs locaux."
    ],
    "nl": [
      "Very Thés is een merk van biologische theeën en infusies dat is gecreëerd door Amandine en Anthony in de regio Revermont. Je kunt meer dan 80 verschillende theeën en infusies vinden in hun winkel in Ceyzériat, op www.very-thes.com en bij veel lokale retailers."
    ],
    "es": [
      "Very Thés es una marca de tés e infusiones ecológicos creada por Amandine y Anthony en la región de Revermont. Puede encontrar más de 80 tés e infusiones diferentes en su tienda de Ceyzériat, en www.very-thes.com y en muchos minoristas locales."
    ]
  },
