  "rdfs:comment": {
    "de": [
      "Im Rahmen der Europäischen Tage des Kunsthandwerks bietet Ihnen das Fremdenverkehrsamt eine Führung zum Thema \"XXL-Skulpturen: Wenn die Stadt die Dinge groß sieht\" an"
    ],
    "en": [
      "As part of the Journées Européennes des Métiers d' Arts, the Tourist Office is offering a guided tour on the theme of \"Sculptures XXL: Quand la ville voit les choses en grand!\" (XXL sculptures: when the town thinks big!)"
    ],
    "it": [
      "Nell'ambito delle Giornate Europee dell'Artigianato, l'Ufficio del Turismo propone una visita guidata sul tema \"Sculture XXL: quando la città pensa in grande\""
    ],
    "fr": [
      "Dans le cadre des Journées Européennes des Métiers d' Arts, l'Office de tourisme vous offre une visite commentée sur le thème des \"Sculptures XXL: Quand la ville voit les choses en grand !\""
    ],
    "nl": [
      "In het kader van de Europese Ambachtsdagen organiseert het Office du Tourisme een rondleiding met als thema \"XXL Sculptures: When the town thinks big!"
    ],
    "es": [
      "En el marco de los Días Europeos de la Artesanía, la Oficina de Turismo ofrece una visita guiada sobre el tema \"Esculturas XXL: ¡Cuando la ciudad piensa a lo grande!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite commentée : \"Sculptures XXL : Quand la ville voit les choses en grand !\""
    ]
  },
