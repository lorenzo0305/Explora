  "rdfs:comment": {
    "de": [
      "La Parenthèse ist eine der Räumlichkeiten des Vereins MJC Archipel Sud Centre social. Dieser Ort bietet den Bewohnern einen Raum, in dem sie sich erholen, einer Aktivität nachgehen, sich eine Lesezeit gönnen, den neuen Kinder-Eltern-Bereich entdecken usw. können."
    ],
    "en": [
      "La Parenthèse is one of the premises of the MJC Archipel Sud social center. It offers local residents a place to recharge their batteries, enjoy an activity, take time out to read, discover the new children's and parents' area, and much more."
    ],
    "it": [
      "La Parenthèse è uno dei locali del centro sociale MJC Archipel Sud. Offre agli abitanti della zona un luogo in cui ricaricare le batterie, praticare un'attività, dedicarsi alla lettura, scoprire la nuova area per bambini e genitori e così via."
    ],
    "fr": [
      "La Parenthèse est l'un des locaux de l'association MJC Archipel Sud Centre social. Ce lieu offre aux habitants un espace pour se ressourcer, pratiquer une activité, s'octroyer un temps de lecture, découvrir le nouvel espace enfants parents, etc."
    ],
    "nl": [
      "La Parenthèse is een van de gebouwen van het sociaal centrum MJC Archipel Sud. Het biedt buurtbewoners een plek om nieuwe energie op te doen, een activiteit te doen, tijd te nemen om te lezen, de nieuwe ruimte voor kinderen en ouders te ontdekken, enzovoort."
    ],
    "es": [
      "La Parenthèse es uno de los locales del centro social MJC Archipel Sud. Ofrece a los vecinos un lugar donde recargar las pilas, disfrutar de una actividad, tomarse un tiempo para leer, descubrir el nuevo espacio para niños y padres, etc."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Archipel Sud - La Parenthèse"
    ]
  },
