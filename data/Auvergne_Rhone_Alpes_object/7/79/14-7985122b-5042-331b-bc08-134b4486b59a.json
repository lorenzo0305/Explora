  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/dc6a1654-0b8c-36e3-9667-6883af53311a",
      "dc:description": {
        "de": [
          "Bei einem Croissant, Kaffee oder Tee können Sie sich mit den Künstlern des Ensemble Contraste musikalisch auf gesellige und leckere Weise austauschen.\nVon 10.30 bis 12.00 Uhr."
        ],
        "en": [
          "Over a croissant, coffee or tea, come and chat with the artists of Ensemble Contraste en musique in a convivial, gourmet setting.\nFrom 10:30 a.m. to 12:00 p.m."
        ],
        "it": [
          "Davanti a un croissant, un caffè o un tè, venite a chiacchierare con gli artisti dell'Ensemble Contraste in una cornice musicale conviviale e gustosa.\nDalle 10.30 alle 12.00."
        ],
        "fr": [
          "Autour d'un croissant, d'un café ou d'un thé, venez échanger avec les artistes de l'Ensemble Contraste en musique de manière conviviale et gourmande.\nDe 10h30 à 12h00."
        ],
        "nl": [
          "Kom onder het genot van een croissant, koffie of thee napraten met de artiesten van Ensemble Contraste in een gezellige en smakelijke muzikale setting.\nVan 10.30 tot 12.00 uur."
        ],
        "es": [
          "En torno a un croissant, un café o un té, venga a charlar con los artistas del Ensemble Contraste en un ambiente musical cordial y sabroso.\nDe 10.30 a 12.00 h."
        ]
      },
