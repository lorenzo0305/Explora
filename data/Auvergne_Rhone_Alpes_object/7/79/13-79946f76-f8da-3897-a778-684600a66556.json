  "rdfs:comment": {
    "de": [
      "Kommen Sie und genießen Sie eine traditionelle \"hausgemachte\" Küche.  Der Service ist schnell, wenn Sie es wünschen... Geöffnet von Montag bis Freitag mittags."
    ],
    "en": [
      "Come and enjoy traditional \"home-made\" cuisine.  Quick service if you wish. Open Monday to Friday lunchtime."
    ],
    "it": [
      "Venite a gustare la tradizionale cucina casalinga.  Servizio rapido se lo desiderate. Aperto dal lunedì al venerdì a pranzo."
    ],
    "fr": [
      "Venez déguster une cuisine traditionnelle \"faite maison\".  Le service est rapide si vous le souhaitez.. Ouvert du  lundi au vendredi midi."
    ],
    "es": [
      "Venga y disfrute de la comida casera tradicional.  Servicio rápido si lo desea. Abierto de lunes a viernes a mediodía."
    ],
    "nl": [
      "Kom genieten van traditioneel huisgemaakt eten.  Snelle service als u dat wenst. Geopend van maandag tot vrijdag tijdens lunchtijd."
    ]
  },
  "rdfs:label": {
