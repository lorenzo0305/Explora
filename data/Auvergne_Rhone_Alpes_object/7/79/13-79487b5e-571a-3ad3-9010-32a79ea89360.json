  "rdfs:comment": {
    "de": [
      "Auf dem Hügel Murier treffen Sie Anna, Alexandre und Mélanie, die Rohmilchkäse (Fässer, Frischkäse oder gereifter Käse) und Milchprodukte (Joghurt, Schokoladendessertcreme) herstellen und verkaufen."
    ],
    "en": [
      "On the Murier hill, come and meet Anna, Alexandre and Mélanie, who make and sell raw-milk cheeses (faisselles, fresh and mature cheeses) and dairy products (yoghurts, chocolate cream desserts)."
    ],
    "it": [
      "Scoprite la nostra fattoria di capre sulla collina di Murier. Produciamo e vendiamo formaggi a latte crudo (faisselles, formaggi freschi o stagionati) e prodotti caseari (yogurt, crema da dessert al cioccolato)."
    ],
    "fr": [
      "Sur la colline du Murier, découvrez notre élevage de chèvre. Nous fabriquons et vendons des fromages au lait cru (faisselles, fromages frais ou affinés) et des produits laitiers (yaourts, crème dessert au chocolat)."
    ],
    "nl": [
      "Ontdek onze geitenboerderij op de heuvel van Murier. We maken en verkopen rauwmelkse kazen (faisselles, verse en gerijpte kazen) en zuivelproducten (yoghurt, chocolade dessertroom)."
    ],
    "es": [
      "En la colina de Murier, venga a conocer a Anna, Alexandre y Mélanie, que elaboran y venden quesos de leche cruda (faisselles, quesos frescos y curados) y productos lácteos (yogures, crema de chocolate para postres)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ferme des Maquis (GAEC)"
    ]
  },
