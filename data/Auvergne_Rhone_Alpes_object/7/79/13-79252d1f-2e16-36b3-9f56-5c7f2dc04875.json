  "rdfs:comment": {
    "de": [
      "Auf der Suche nach der Roten Quelle ... auf den Spuren eines Wassersuchers! Der Animationsverein Castelneuvoise lädt kleine Abenteurer ein, die Rote Quelle auf den Spuren des Entdeckers Jean-Pierre Alibert zu entdecken!"
    ],
    "en": [
      "The Castelneuvoise Animation Association invites you on a little adventure to discover the source of the red spring; following in the footsteps of explorer and water seeker; Jean-Pierre Alibert."
    ],
    "it": [
      "Alla ricerca della Sorgente Rossa... sulle orme di un esploratore dell'acqua! L'Association pour l'Animation Castelneuvoise invita i piccoli avventurieri a scoprire la Sorgente Rossa sulle orme dell'esploratore Jean-Pierre Alibert!"
    ],
    "fr": [
      "À la recherche de la source Rouge... dans les pas d'un chercheur d'eau ! L'Association pour l'Animation Castelneuvoise propose aux petits aventuriers de découvrir la Source Rouge sur les pas de l'explorateur Jean-Pierre Alibert !"
    ],
    "nl": [
      "Op zoek naar de Rode Bron... in de voetsporen van een waterverkenner! De Association pour l'Animation Castelneuvoise nodigt kleine avonturiers uit om de Rode Bron te ontdekken in de voetsporen van de ontdekkingsreiziger Jean-Pierre Alibert!"
    ],
    "es": [
      "En busca del Manantial Rojo... ¡tras las huellas de un explorador del agua! La Association pour l'Animation Castelneuvoise invita a los pequeños aventureros a descubrir la Primavera Roja tras las huellas del explorador Jean-Pierre Alibert"
    ]
  },
  "rdfs:label": {
    "de": [
      "Schnitzeljagd - „Auf der Suche nach La Source Rouge“ (Auf der Suche nach der Roten Quelle)"
    ],
    "en": [
      "Treasure hunt - ‘In search of La Source Rouge’ (The Red Spring)"
    ],
    "fr": [
      "Jeu de piste - \"À la recherche de La Source Rouge\""
    ]
  },
