  "rdfs:comment": {
    "de": [
      "Der Informationspunkt in Les Coches empfängt Sie in der Winter- und Sommersaison und versorgt Sie während Ihres Aufenthalts in Montchavin-Les Coches mit den nötigen Informationen.\r\nHier finden Sie auch eine Außentoilette und die Haltestelle des Pendelbusses."
    ],
    "en": [
      "Les Coches information point is open in the winter and summer seasons so you can find all the information you need during your stay in Montchavin-Les Coches.\r\nPublic toilets, shuttle bus stop."
    ],
    "it": [
      "Il punto informativo di Les Coches vi accoglie durante la stagione invernale ed estiva per fornirvi le informazioni necessarie durante il vostro soggiorno a Montchavin-Les Coches.\r\nAll'esterno troverete anche i servizi igienici e la fermata del bus navetta."
    ],
    "fr": [
      "Le point information des Coches vous accueille en saison d'hiver et d'été, pour vous apporter les informations nécessaires durant votre séjour à Montchavin-Les Coches.\r\nVous trouverez également des toilettes à l'extérieur et l'arrêt de la navette."
    ],
    "nl": [
      "Het informatiepunt van Les Coches verwelkomt u tijdens het winter- en zomerseizoen, om u de nodige informatie te verstrekken tijdens uw verblijf in Montchavin-Les Coches.\r\nTer plaatse vindt u ook buitentoiletten en de halte van de pendelbus."
    ],
    "es": [
      "El punto de información de Les Coches le da la bienvenida durante las temporadas de invierno y verano, para proporcionarle la información que necesite durante su estancia en Montchavin-Les Coches.\r\nTambién encontrará aseos en el exterior y la parada del autobús lanzadera."
    ]
  },
