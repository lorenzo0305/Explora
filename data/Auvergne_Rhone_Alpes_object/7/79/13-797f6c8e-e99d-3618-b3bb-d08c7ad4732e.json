  "rdfs:comment": {
    "de": [
      "Bouleplatz am Ufer des Flusses Arc, am Fuße des Spielplatzes. Nachtbeleuchtung durch eine vor Ort zu betätigende Zeitschaltuhr."
    ],
    "en": [
      "Petanque court located on the banks of the Arc, at the foot of the playground. Night lighting with a timer to be activated on site."
    ],
    "it": [
      "Campo da bocce situato in Val Cenis-Lanslebourg, ai margini dell'Arco, ai piedi del parco giochi. Illuminazione notturna tramite timer per l'attivazione in loco Obiettivo del gioco: segnare punti posizionando le sue palle più vicino all'obiettivo del suo avversario."
    ],
    "fr": [
      "Terrain de pétanque situé au bord de l’Arc, au pied de l’aire de jeux. Éclairage nocturne par un minuteur à actionner sur place."
    ],
    "es": [
      "Pista de petanca situada a orillas del Arco, al pie del parque infantil. Iluminación nocturna con temporizador que se activa in situ."
    ],
    "nl": [
      "Jeu de boules baan gelegen aan de rand van de Arc, aan de voet van de speeltuin. Nachtverlichting dmv een timer die ter plaatse moet worden geactiveerd."
    ]
  },
