  "rdfs:comment": {
    "de": [
      "Zwei No-kill-Strecken:\r\n- eine Strecke vom Hotel des Méritis über 400m bis zur Einmündung des Ruisseau des Cottariaux\r\n- eine Strecke von der Moulin de la Fayolle über 2700m bis zur Schwelle der Moulin de la Croix."
    ],
    "en": [
      "Two no-kill runs:\r\n- a 400m stretch from the Hôtel des Méritis to the confluence of the Ruisseau des Cottariaux\r\n- a 2700m stretch from the Moulin de la Fayolle to the Moulin de la Croix weir."
    ],
    "it": [
      "Due percorsi no-kill:\r\n- 400 m dall'Hôtel des Méritis fino alla confluenza del Ruisseau des Cottariaux\r\n- un tratto di 2700 m dal Moulin de la Fayolle allo sbarramento del Moulin de la Croix."
    ],
    "fr": [
      "Deux parcours no-kill : \r\n- un parcours de l’hôtel des Méritis sur 400m, à la confluence du ruisseau des Cottariaux \r\n- un parcours du moulin de la Fayolle, sur 2700m au seuil du moulin de la Croix."
    ],
    "nl": [
      "Twee no-kill pistes:\r\n- 400m van het Hôtel des Méritis tot de samenloop van de Ruisseau des Cottariaux\r\n- een traject van 2700 m van de Moulin de la Fayolle tot de stuw van de Moulin de la Croix."
    ],
    "es": [
      "Dos pistas sin muerte :\r\n- 400 m desde el Hôtel des Méritis hasta la confluencia del Ruisseau des Cottariaux\r\n- un tramo de 2700 m desde el Moulin de la Fayolle hasta el embalse del Moulin de la Croix."
    ]
  },
  "rdfs:label": {
