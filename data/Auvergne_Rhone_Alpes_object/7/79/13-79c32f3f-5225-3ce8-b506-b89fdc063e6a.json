  "rdfs:comment": {
    "de": [
      "Dieser Weg lädt Spaziergänger ein, in ihrem eigenen Rhythmus eine ruhige Route zu entdecken, um die Gemeinde Nassigny zu erkunden. Man durchläuft eine authentische ländliche Landschaft, die sich ideal für einen Naturausflug mit der Familie oder mit Freunden eignet."
    ],
    "en": [
      "This trail invites walkers to discover the commune of Nassigny at their own pace. It takes you through an authentic rural landscape, ideal for a nature outing with family or friends."
    ],
    "it": [
      "Questo sentiero invita gli escursionisti a scoprire il comune di Nassigny al proprio ritmo. Attraversa un autentico paesaggio rurale, ideale per una gita nella natura con la famiglia o con gli amici."
    ],
    "fr": [
      "Ce sentier invite les promeneurs à découvrir à leur rythme un itinéraire tranquille pour découvrir la commune de Nassigny. On parcoure un paysage rural authentique, idéal pour une sortie nature en famille ou entre amis."
    ],
    "es": [
      "Este sendero invita a los senderistas a descubrir el municipio de Nassigny a su propio ritmo. Atraviesa un auténtico paisaje rural, ideal para una excursión en plena naturaleza con la familia o los amigos."
    ],
    "nl": [
      "Dit pad nodigt wandelaars uit om de gemeente Nassigny op hun eigen tempo te ontdekken. Het neemt je mee door een authentiek landelijk landschap, ideaal voor een natuuruitstapje met familie of vrienden."
    ]
  },
  "rdfs:label": {
    "fr": [
      "PR4 Circuit de Champvallier"
    ]
  },
