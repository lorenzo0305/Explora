  "rdfs:comment": {
    "de": [
      "Neu in Wien! Für eine schnelle Mahlzeit, die seit dem 17. Jahrhundert Tradition hat, entdecken Sie unser Restaurant mit asiatischen Spezialitäten zum Mitnehmen."
    ],
    "en": [
      "New in Vienna! For an on-the-go meal in the tradition since the 17th century, discover our takeaway Asian specialties restaurant."
    ],
    "it": [
      "Una novità a Vienna! Per un pasto veloce secondo la tradizione del XVII secolo, scoprite il nostro ristorante di specialità asiatiche da asporto."
    ],
    "fr": [
      "Nouveauté à Vienne ! Pour un repas sur le pouce dans la tradition depuis le 17eme siècle, découvrez notre restaurant de spécialités asiatiques à emporter."
    ],
    "es": [
      "¡Nuevo en Viena! Para una comida rápida siguiendo la tradición desde el siglo XVII, descubra nuestro restaurante de especialidades asiáticas para llevar."
    ],
    "nl": [
      "Nieuw in Wenen! Ontdek voor een snelle maaltijd in de traditie sinds de 17e eeuw ons afhaalrestaurant met Aziatische specialiteiten."
    ]
  },
