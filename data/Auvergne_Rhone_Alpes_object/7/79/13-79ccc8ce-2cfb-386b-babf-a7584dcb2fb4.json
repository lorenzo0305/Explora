  "rdfs:comment": {
    "de": [
      "Begeben Sie sich auf die Spuren eines Musikhausierers und seines Heißluftballons und verfolgen Sie seine unglaubliche Reise über die Berge."
    ],
    "en": [
      "Set off along the path of a travelling music-maker and his hot air balloon, and follow his incredible journey beyond the mountains."
    ],
    "it": [
      "Segui le orme di un musicante di strada e della sua mongolfiera in un incredibile viaggio attraverso le montagne."
    ],
    "fr": [
      "Partez sur les traces d’un colporteur de musique et de sa montgolfière, et suivez son incroyable voyage par-delà les montagnes."
    ],
    "nl": [
      "Treed in de voetsporen van een muziekmaker en zijn heteluchtballon, en volg zijn ongelooflijke reis over de bergen."
    ],
    "es": [
