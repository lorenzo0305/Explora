  "rdfs:comment": {
    "de": [
      "Spielen Sie im Schnee und sausen Sie auf der gesicherten Rodelbahn von La Stèle - La Tour d'Auvergne den Hang hinunter."
    ],
    "en": [
      "Come and play in the snow and hurtle down the slope on the secure toboggan run at La Stèle - La Tour d'Auvergne."
    ],
    "it": [
      "Venite a giocare sulla neve e a sfrecciare sulla pista da slittino sicura di La Stèle - La Tour d'Auvergne."
    ],
    "fr": [
      "Venez jouer dans la neige et dévaler la pente sur la piste de luge sécurisée de la Stèle - La Tour d'Auvergne."
    ],
    "es": [
      "Ven a jugar en la nieve y deslízate por la pista de trineo segura de La Stèle - La Tour d'Auvergne."
    ],
    "nl": [
