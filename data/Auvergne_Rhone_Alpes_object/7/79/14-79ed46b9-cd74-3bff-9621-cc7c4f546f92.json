  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/4cf1427d-9924-3a7d-8715-7fb286fe2165",
      "dc:description": {
        "de": [
          "Nr. 1 für die Lieferung von Mahlzeiten nach Hause.\nGeöffnet montags bis freitags von 8:00 bis 18:00 Uhr.\nLes Menus services, das sind auch Haushaltshilfe, kleine Arbeiten, administrative Unterstützung und Tele-Assistance."
        ],
        "en": [
          "No. 1 in home delivery of meals.\nOpen Monday to Friday, 8 a.m. to 6 p.m.\nLes Menus Services also offers cleaning, odd jobs, administrative assistance and remote assistance."
        ],
        "it": [
          "Il numero 1 nella consegna di pasti a domicilio.\nAperto dal lunedì al venerdì, dalle 8.00 alle 18.00.\nLes Menus Services offre anche servizi di pulizia, lavori saltuari, assistenza amministrativa e teleassistenza."
        ],
        "fr": [
          "N°1 du portage de repas à domicile.\nOuvert du lundi au vendredi de 8 h à 18 h.\nLes Menus services, c'est aussi du ménage, des petits travaux, de l'assistance administrative et de la télé-assistance."
        ],
        "nl": [
          "Nr. 1 in thuisbezorging van maaltijden.\nGeopend van maandag tot vrijdag van 8.00 tot 18.00 uur.\nLes Menus Services biedt ook schoonmaak, klusjes, administratieve hulp en hulp op afstand."
        ],
        "es": [
          "Nº 1 en reparto de comidas a domicilio.\nAbierto de lunes a viernes, de 8.00 a 18.00 horas.\nLes Menus Services también ofrece servicios de limpieza, chapuzas, asistencia administrativa y teleasistencia."
        ]
      },
