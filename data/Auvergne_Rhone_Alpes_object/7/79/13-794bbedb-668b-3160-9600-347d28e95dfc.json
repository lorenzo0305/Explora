  "rdfs:comment": {
    "de": [
      "Das Kristallmuseum lädt Sie zu einer Reise durch die Mineralogie der Alpen, Frankreichs, Europas und der Welt ein. Entdecken Sie Sammlungen, die aufgrund ihrer Qualität, Vielfalt und Schönheit außergewöhnlich sind,"
    ],
    "en": [
      "The Musée des Cristaux offers you a journey through the mineralogy of the Alps, France, Europe and the world. Come and discover exceptional collections by their quality, their diversity and their beauty ."
    ],
    "it": [
      "Il Musée des Cristaux vi propone un viaggio nella mineralogia delle Alpi, della Francia, dell'Europa e del mondo. Venite a scoprire collezioni eccezionali in termini di qualità, diversità e bellezza"
    ],
    "fr": [
      "Le musée des Cristaux vous propose un voyage à travers la minéralogie alpine, de France, d'Europe et du Monde. Venez découvrir des collections exceptionnelles par leur qualité, leur diversité et leur beauté ."
    ],
    "nl": [
      "Het Musée des Cristaux neemt je mee op een reis door de mineralogie van de Alpen, Frankrijk, Europa en de rest van de wereld. Kom en ontdek collecties van uitzonderlijke kwaliteit, diversiteit en schoonheid."
    ],
    "es": [
      "El Musée des Cristaux le propone un viaje por la mineralogía de los Alpes, de Francia, de Europa y del mundo. Venga a descubrir colecciones excepcionales por su calidad, diversidad y belleza"
    ]
  },
