  "rdfs:comment": {
    "de": [
      "Ort, an dem das Werk der Künstlerin Geneviève Dumont aufbewahrt wird und an dem wechselnde Ausstellungen zeitgenössischer Kunst stattfinden. Das Werk von Geneviève Dumont umfasst Skulpturen, Zeichnungen, Gemälde, Texte und Projekte."
    ],
    "en": [
      "A conservation area for the works of Geneviève Dumont and a temporary art exhibition site in May, June and September and every two years in October, following our biennial Rhône-Alpes book fair (Salon Editions d'art-Livres d'artistes) devoted to art."
    ],
    "it": [
      "Un luogo per la conservazione delle opere dell'artista Geneviève Dumont e per mostre temporanee di arte contemporanea. Il lavoro di Geneviève Dumont comprende sculture, disegni, dipinti, testi e progetti."
    ],
    "fr": [
      "Lieu de conservation de l'oeuvre de l’artiste Geneviève Dumont et d'expositions temporaires d'art contemporains. L'oeuvre de Geneviève Dumont comporte des sculptures, dessins, peintures, textes et projets."
    ],
    "es": [
      "Un lugar para la conservación de la obra de la artista Geneviève Dumont y para exposiciones temporales de arte contemporáneo. La obra de Geneviève Dumont incluye esculturas, dibujos, pinturas, textos y proyectos."
    ],
    "nl": [
      "Een plek voor de conservering van het werk van kunstenares Geneviève Dumont en voor tijdelijke tentoonstellingen van hedendaagse kunst. Het werk van Geneviève Dumont omvat sculpturen, tekeningen, schilderijen, teksten en projecten."
    ]
  },
