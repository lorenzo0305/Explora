  "rdfs:comment": {
    "de": [
      "Ardèche Sport Nature & Co begleitet Sie ins Herz der Ardèche, abseits der ausgetretenen Pfade, um Ihnen den ganzen Reichtum des Gebiets näher zu bringen. Uns liegt die Entwicklung von Natursportaktivitäten in der Ardèche am Herzen."
    ],
    "en": [
      "Ardèche Sport Nature & Co guide you in the heart of Ardèche, off the beaten track, in order to share with you all the richness of its territory. We are committed to the development of outdoor sports activities in Ardèche."
    ],
    "it": [
      "Ardèche Sport Nature & Co vi porterà nel cuore dell'Ardèche, fuori dai sentieri battuti, per condividere con voi la ricchezza della regione. Ci impegniamo a sviluppare le attività sportive nella natura dell'Ardèche"
    ],
    "fr": [
      "Ardèche Sport Nature & Co vous accompagne au cœur de l'Ardèche, hors des sentiers battus, afin de vous faire partager toute la richesse de son territoire. Nous avons à cœur le développement des activités de sport nature en Ardèche"
    ],
    "nl": [
      "Ardèche Sport Nature & Co zal u begeleiden naar het hart van de Ardèche, buiten de gebaande paden, om de rijkdom van haar grondgebied met u te delen. Wij zetten ons in voor de ontwikkeling van natuursportactiviteiten in de Ardèche."
    ],
    "es": [
      "Ardèche Sport Nature & Co le llevará al corazón del Ardèche, fuera de los caminos trillados, para compartir con usted la riqueza de la región. Nos comprometemos a desarrollar actividades deportivas en la naturaleza en Ardèche"
    ]
  },
