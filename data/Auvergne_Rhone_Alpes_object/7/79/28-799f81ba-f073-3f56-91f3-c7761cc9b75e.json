  "rdfs:comment": {
    "de": [
      "Das Restaurant präsentiert in einem hellen und geräumigen Rahmen die kreative Welt unseres Küchenchefs, dessen Talent sich sowohl in traditionellen Rezepten als auch in der Gourmetküche zeigt"
    ],
    "en": [
      "The restaurant presents in a luminous and spacious setting the creative world of our chef whose talent is as much in traditional recipes as in gourmet cuisine"
    ],
    "it": [
      "Il ristorante presenta, in un ambiente luminoso e spazioso, l'universo creativo del nostro chef, il cui talento risiede tanto nelle ricette tradizionali quanto nella cucina gastronomica"
    ],
    "fr": [
      "Le restaurant présente dans un cadre lumineux et spacieux l'univers de création de notre chef dont le talent s'affirme autant dans les recettes traditionnelles que dans la cuisine gastronomique"
    ],
    "nl": [
      "Het restaurant presenteert, in een lichte en ruime omgeving, het creatieve universum van onze chef, wiens talent zowel in traditionele recepten als in de gastronomische keuken ligt"
    ],
    "es": [
      "El restaurante presenta, en un marco luminoso y espacioso, el universo creativo de nuestro chef, cuyo talento está tanto en las recetas tradicionales como en la cocina gastronómica"
    ]
  },
