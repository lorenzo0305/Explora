  "rdfs:comment": {
    "de": [
      "Montbrison entdecken oder wiederentdecken: Von den Ufern des Vizézy bis zum Kalvarienberg können Sie im Herzen und in der Umgebung der Stadt spazieren gehen.\r\nErhältlich in unseren Maison du Tourisme."
    ],
    "en": [
      "Discover or rediscover Montbrison: from the banks of the Vizézy to the Calvaire, stroll in and around the town.\r\nOn sale in our tourist offices."
    ],
    "it": [
      "Scoprite o riscoprite il Montbrison: dalle rive del Vizézy al Calvario, passeggiate in città e nei dintorni.\r\nIn vendita presso i nostri uffici turistici."
    ],
    "fr": [
      "Découvrir ou redécouvrir Montbrison : des quais du Vizézy au calvaire, baladez-vous au coeur et autour de la ville.\r\nEn vente dans nos maisons du tourisme."
    ],
    "nl": [
      "Ontdek of herontdek Montbrison: van de oevers van de Vizézy tot de Calvarieberg, maak een wandeling in en rond de stad.\r\nTe koop bij onze VVV-kantoren."
    ],
    "es": [
      "Descubra o redescubra Montbrison: desde las orillas del Vizézy hasta el Calvario, pasee por la ciudad y sus alrededores.\r\nA la venta en nuestras oficinas de turismo."
    ]
  },
