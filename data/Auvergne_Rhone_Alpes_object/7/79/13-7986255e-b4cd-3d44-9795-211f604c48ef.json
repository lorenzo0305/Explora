  "rdfs:comment": {
    "de": [
      "Testen Sie Ihre Fähigkeiten beim Mountainbiken im Ludopark von Lormay auf drei Strecken (Niveau blau, rot) und einer natürlichen Pumpline. Der Ludopark ist ein Bereich, der für Mountainbikes oder VTTAEs reserviert ist."
    ],
    "en": [
      "Test your mountain biking skills at the Ludopark in Lormay on three courses (blue, red level) and a natural pumpline. The Ludoparc is an area reserved for mountain bikes and ATVs."
    ],
    "it": [
      "Mettete alla prova le vostre abilità in mountain bike al Ludopark di Lormay su tre percorsi (livelli blu e rosso) e una pumpline naturale. Il Ludopark è un'area riservata alle mountain bike o agli ATV."
    ],
    "fr": [
      "Testez votre aptitude au VTT au Ludopark de Lormay sur trois parcours (niveau bleu, rouge) et un pumpline naturel. Le ludoparc est un espace réservé au VTT ou VTTAE."
    ],
    "nl": [
      "Test je mountainbikevaardigheden in het Ludopark in Lormay op drie parcours (blauwe en rode niveaus) en een natuurlijke pumplijn. Het Ludopark is een gebied dat is gereserveerd voor mountainbikes of ATV's."
    ],
    "es": [
      "Ponga a prueba sus habilidades en bicicleta de montaña en el Ludopark de Lormay, en tres recorridos (niveles azul y rojo) y una línea de bolas natural. El Ludopark es una zona reservada para bicicletas de montaña o todoterrenos."
    ]
  },
