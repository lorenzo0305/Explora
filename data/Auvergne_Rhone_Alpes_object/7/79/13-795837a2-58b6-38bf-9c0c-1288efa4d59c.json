  "rdfs:comment": {
    "de": [
      "Via ferrata mit Kabeln, Rampen, Achsen der Luftcharaktere, manchmal sportlich. Der Nervenkitzel der Höhen für alle Ebenen In der Nähe des Tores des Vanoise Nationalparks."
    ],
    "en": [
      "Alpine itinerary equipped with cables, ramps, echelons of aerial character and sometimes athletic. The thrill of the heights for all levels Close to the gate of the Vanoise National Park."
    ],
    "it": [
      "Un percorso alpinistico attrezzato con cavi, rampe e pioli aerei e talvolta atletici. Il brivido dell'altezza per tutti i livelli Vicino alla porta del Parco Nazionale della Vanoise."
    ],
    "fr": [
      "Itinéraire alpin équipé de câbles, rampes, échelons de caractère aérien et parfois athlétique. Le frisson des hauteurs pour tous les niveaux  A proximité de la porte du Parc national de la Vanoise."
    ],
    "es": [
      "Un recorrido alpino equipado con cables, rampas y peldaños aéreos y a veces atléticos. La emoción de las alturas para todos los niveles Cerca de la puerta del Parque Nacional de la Vanoise."
    ],
    "nl": [
      "Een alpine parcours uitgerust met kabels, hellingen en lucht- en soms atletische sporten. De sensatie van hoogtes voor alle niveaus Vlakbij de toegangspoort tot het Nationale Park Vanoise."
    ]
  },
