  "rdfs:comment": {
    "de": [
      "Poin(G) ist eine unter Spannung stehende Achterbahnfahrt, bei der jeder Schritt ein weiterer Bruch ist und das Schlimmste wie auch das Beste in uns zum Ausbruch bringt oder offenbart."
    ],
    "en": [
      "Poin(G) is a tension-filled eight clos, where every step is another rupture, bringing out or revealing the worst as well as the best in all of us."
    ],
    "it": [
      "Poin(G) è uno spettacolo teso, a porte chiuse, in cui ogni tappa rappresenta un'ulteriore frattura, che fa emergere il peggio e il meglio di tutti noi."
    ],
    "fr": [
      "Poin(G) est un huit clos sous tensions où chaque étape est une rupture de plus et fait éclater ou révèle le pire comme le meilleur qui sommeille en nous."
    ],
    "nl": [
      "Poin(G) is een gespannen show met gesloten deuren waarin elke fase een verdere breuk is, die het slechtste en het beste in ons allemaal naar boven brengt."
    ],
    "es": [
      "Poin(G) es un espectáculo tenso, a puerta cerrada, en el que cada etapa es una ruptura más, que saca lo peor y lo mejor de todos nosotros."
    ]
  },
  "rdfs:label": {
