  "rdfs:comment": {
    "de": [
      "Tourismusinformationsstelle in einem Dorf mit dem Label Village de Caractère (Dorf mit Charakter). Es werden Wanderführer, regionale Bücher, Postkarten sowie lokales Kunsthandwerk verkauft. Ausstellungsraum und Postagentur."
    ],
    "en": [
      "Tourist information point located in a village with the Village de Caractère label. Hiking guides, regional books, postcards and local crafts on sale. Showroom and postal agency."
    ],
    "it": [
      "Punto di informazione turistica situato in un villaggio con il marchio Village de Caractère. Sono in vendita guide escursionistiche, libri regionali, cartoline e artigianato locale. Sala espositiva e ufficio postale."
    ],
    "fr": [
      "Point Information tourisme situé dans un village labellisé Village de Caractère. Des guides de randonnées, livres régionaux, cartes postales sont en vente ainsi que de l'artisanat local. Salle d'exposition et agence postale."
    ],
    "nl": [
      "Toeristisch informatiepunt in een dorp met het label Village de Caractère. Er zijn wandelgidsen, regionale boeken, ansichtkaarten en plaatselijke kunstnijverheid te koop. Tentoonstellingsruimte en postkantoor."
    ],
    "es": [
      "Punto de información turística situado en un pueblo con la etiqueta Village de Caractère. Se venden guías de senderismo, libros regionales, postales y artesanía local. Sala de exposiciones y oficina de correos."
    ]
  },
  "rdfs:label": {
