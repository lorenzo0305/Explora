  "rdfs:comment": {
    "de": [
      "Willkommen bei Bouillon Frankette, dem Restaurant von Tiffine und Frankette! Hier genießen Sie zwei Speisekarten, die traditionelle französische und mediterrane Küche miteinander verbinden, um alle zusammenzubringen!"
    ],
    "en": [
      "Welcome to Bouillon Frankette, the dining room of Tiffine and Frankette! Here, enjoy two menus combining traditional French and Mediterranean cuisine to bring you all together!"
    ],
    "it": [
      "Benvenuti al Bouillon Frankette, il ristorante di Tiffine e Frankette! Qui potrete gustare due menu che combinano la cucina tradizionale francese e i piatti mediterranei per unire tutti voi!"
    ],
    "fr": [
      "Bienvenue chez Bouillon Frankette, la salle restauration de Tiffine et Frankette ! Ici, profitez de deux cartes alliant cuisine traditionnelle française et cuisine méditerranéenne pour tous vous rassembler !"
    ],
    "nl": [
      "Welkom bij Bouillon Frankette, het restaurant van Tiffine en Frankette! Hier kunt u genieten van twee menu's waarin de traditionele Franse keuken en mediterrane gerechten worden gecombineerd!"
    ],
    "es": [
      "Bienvenido a Bouillon Frankette, el restaurante de Tiffine y Frankette Aquí podrá disfrutar de dos menús que combinan la cocina tradicional francesa y los platos mediterráneos"
    ]
  },
