  "rdfs:comment": {
    "de": [
      "Kleiner Berghof mit biologischem Landbau, auf dem etwa 60 Alpenziegen gehalten werden. Die Milch wird vor Ort zu handwerklich hergestellten Käsesorten und Joghurts verarbeitet. Eine lokale und authentische Produktion, die Sie im Direktverkauf auf dem Hof entdecken können."
    ],
    "en": [
      "Small organic mountain farm, where around 60 Alpine goats are raised. The milk is processed on site into artisanal cheeses and yoghurts. Authentic local produce, sold direct from the farm."
    ],
    "it": [
      "Una piccola fattoria biologica di montagna dove vengono allevate una sessantina di capre alpine. Il latte viene trasformato in loco in formaggi e yogurt tradizionali. Prodotti locali autentici venduti direttamente dalla fattoria."
    ],
    "fr": [
      "Petite ferme de montagne en agriculture biologique, où sont élevées une soixantaine de chèvres alpines. Le lait est transformé sur place en fromages et yaourts artisanaux. Une production locale et authentique à découvrir en vente directe à la ferme."
    ],
    "es": [
      "Pequeña granja ecológica de montaña donde se crían unas sesenta cabras alpinas. La leche se transforma in situ en quesos y yogures tradicionales. Auténticos productos locales vendidos directamente en la granja."
    ],
    "nl": [
      "Een kleine biologische bergboerderij waar ongeveer zestig alpengeiten worden gehouden. De melk wordt ter plekke verwerkt tot traditionele kazen en yoghurt. Authentieke lokale producten worden rechtstreeks van de boerderij verkocht."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Ferme des fayards"
    ]
  },
