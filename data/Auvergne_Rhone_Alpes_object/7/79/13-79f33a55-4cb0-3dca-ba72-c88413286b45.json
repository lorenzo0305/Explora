  "rdfs:comment": {
    "de": [
      "Familienbetrieb, der seit mehr als fünfzehn Jahren mit großem Respekt für die Umwelt arbeitet. Unser außergewöhnliches Terroir besonnt die Weine mit Aromen von großer Typizität."
    ],
    "en": [
      "Family-run business that has been operating in the utmost respect for the environment for over fifteen years. Our exceptional region adds a touch of sunshine flavour to the typical wines."
    ],
    "it": [
      "Un'azienda a conduzione familiare che da oltre quindici anni lavora con grande rispetto per l'ambiente. Il nostro eccezionale terroir conferisce ai vini i loro aromi tipici."
    ],
    "fr": [
      "Exploitation familiale qui travaille dans le grand respect de l'environnement depuis plus de quinze ans. Notre exceptionnel terroir ensoleille les vins avec des arômes d'une grande typicité."
    ],
    "es": [
      "Una empresa familiar que lleva más de quince años trabajando con gran respeto al medio ambiente. Nuestro excepcional terruño confiere a los vinos sus aromas típicos."
    ],
    "nl": [
      "Familiebedrijf waar de activiteiten op milieuvriendelijke manier worden uitgevoerd, al meer dan vijftien jaar. Onze uitzonderlijke gunstige grond geeft karakteristieke smaken aan onze wijnen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Domaine Petit Vincent des Combes"
    ]
  },
