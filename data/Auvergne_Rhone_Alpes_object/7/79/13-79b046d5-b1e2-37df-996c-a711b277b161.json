  "rdfs:comment": {
    "de": [
      "Das Château de Corcelles bewirtschaftet 84 Hektar Weinberge, die sich über mehrere Appellationen des Beaujolais verteilen: Beaujolais blanc und rosé, Beaujolais Villages, Brouilly, Morgon und Fleurie. Sie können die Weine des Schlosses in unserer Boutique entdecken."
    ],
    "en": [
      "The Château de Corcelles cultivates 84 hectares of grapevines spread over several areas of Beaujolais appellations : white and rosé Beaujolais, Beaujolais Villages, Brouilly, Morgon and Fleurie. The estate's wines are available to purchase from our shop."
    ],
    "it": [
      "Lo Château de Corcelles possiede 84 ettari di vigneti distribuiti in diverse denominazioni del Beaujolais: Beaujolais Blanc e Rosé, Beaujolais Villages, Brouilly, Morgon e Fleurie. Potete scoprire i vini dello château nel nostro negozio."
    ],
    "fr": [
      "Le Château de Corcelles exploite 84 hectares de vignes répartis sur plusieurs appellations du Beaujolais : Beaujolais blanc et rosé, Beaujolais Villages, Brouilly, Morgon et Fleurie. Vous pourrez découvrir les vins du château dans notre boutique."
    ],
    "es": [
      "El Château de Corcelles cuenta con 84 hectáreas de viñedos repartidos en varias denominaciones de Beaujolais: Beaujolais Blanc y Rosé, Beaujolais Villages, Brouilly, Morgon y Fleurie. Puede descubrir los vinos del château en nuestra tienda."
    ],
    "nl": [
      "Château de Corcelles heeft 84 hectare wijngaarden verspreid over verschillende Beaujolais appellations: Beaujolais Blanc en Rosé, Beaujolais Villages, Brouilly, Morgon en Fleurie. Je kunt de wijnen van het château ontdekken in onze winkel."
    ]
  },
