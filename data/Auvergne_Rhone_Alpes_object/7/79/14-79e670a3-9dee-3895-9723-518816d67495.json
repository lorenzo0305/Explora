      "@id": "https://data.datatourisme.fr/8cbf665f-b64f-3687-90d4-6db5d00bca56",
      "dc:description": {
        "de": [
          "Informationen :\n\nÖffnungstage :\n\nMontag bis Samstag von 7:00 bis 12:00 Uhr und von 15:00 bis 18:30 Uhr.\n\nSonntags geschlossen\n \n \n Abholung :\n\nZu den Öffnungszeiten des Geschäfts\n\n "
        ],
        "en": [
          "Information :\n\nOpening days :\n\nMonday to Saturday, 7am to 12pm and 3pm to 6:30pm.\n\nClosed on Sunday\n \n \n Collection:\n\nDuring store opening hours\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura :\n\nDa lunedì a sabato, dalle 7 alle 12 e dalle 15 alle 18.30.\n\nChiuso la domenica\n \n \n Raccolta:\n\nDurante gli orari di apertura del negozio\n\n "
        ],
        "fr": [
          "Informations :\n\nJours d'ouverture : \n\nDu lundi au samedi de 7h à 12h et de 15h à 18h30.\n\nFermeture le dimanche\n \n \n Retrait :\n\nAux horaires d'ouverture du magasin\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen :\n\nMaandag tot zaterdag van 7u tot 12u en van 15u tot 18u30.\n\nGesloten op zondag\n \n \n Ophalen:\n\nTijdens winkelopeningstijden\n\n "
        ],
        "es": [
          "Más información :\n\nDías de apertura :\n\nDe lunes a sábado, de 7h a 12h y de 15h a 18h30.\n\nDomingos cerrado\n \n \n Recogida:\n\nDurante el horario de apertura de la tienda\n\n "
        ]
      },
