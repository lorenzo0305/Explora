  "rdfs:comment": {
    "de": [
      "Inneneinrichtungen alter Bauernhäuser, traditionelle Handwerkskünste, Werkstattnachbildungen, regionale und archäologische Bibliothek.\r\nTemporäre Ausstellung"
    ],
    "en": [
      "Old peasant interior, old looms, reconstruction of workshop, regional and archaeological library. Temporary exhibition. Guided tour of the medieval village of Crozet and of its Museum all the year round."
    ],
    "it": [
      "Il Museo di Arte e Tradizioni Popolari è ospitato in una casa del XVI secolo con torretta, l'unica casa di Crozet interamente visitabile. Ricostruzioni di botteghe, antichi mestieri, sala storica, mostra temporanea e ampia biblioteca sulla regione."
    ],
    "fr": [
      "Musée d'Art et Traditions Populaires dans un logis à tourelle du XVIe siècle, seule maison de Crozet visitable entièrement. Reconstitutions d'ateliers, métiers anciens, salle historique, exposition temporaire et bibliothèque importante sur la région."
    ],
    "nl": [
      "Het Museum voor Volkskunst en -tradities is gevestigd in een 16e-eeuws huis met een torentje, het enige huis in Crozet dat volledig kan worden bezocht. Reconstructies van werkplaatsen, oude ambachten, historische kamer, tijdelijke tentoonstelling en uitgebreide bibliotheek over de regio."
    ],
    "es": [
      "El Museo de Arte y Tradiciones Populares está instalado en una casa del siglo XVI con torreón, la única de Crozet que puede visitarse en su totalidad. Reconstrucciones de talleres, antiguos oficios, sala histórica, exposición temporal y amplia biblioteca sobre la región."
    ]
  },
  "rdfs:label": {
    "de": [
      "Museum für volkstümliche Kunst und Tradition des alten Crozet"
    ],
    "en": [
      "Museum of Popular Arts and Traditions in the old part of Le Crozet"
    ],
    "fr": [
      "Musée des Arts et Traditions Populaires du Vieux Crozet"
    ],
    "nl": [
      "Museum voor Kunsten en Volkstradities van het oude Crozet (Musée des Arts et traditions populaires du vieux Crozet)"
    ]
  },
