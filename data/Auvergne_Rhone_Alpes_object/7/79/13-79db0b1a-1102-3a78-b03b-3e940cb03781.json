  "rdfs:comment": {
    "de": [
      "Fotografin, ich führe Sitzungen durch :\r\n- Familie, Paar, Kind\r\n- Schwangerschaft, Neugeborene\r\n- Hochzeit\r\n- Immobilien und Veranstaltungen\r\n\r\nUm Ihnen wunderbare Erinnerungen voller Emotionen in einer atemberaubenden Umgebung zu hinterlassen"
    ],
    "en": [
      "Photographer, I do sessions :\r\n- Family, Couple, Child \r\n- Pregnancy, Newborn\r\n- Weddings\r\n- Real estate and events\r\n\r\nTo leave you with wonderful memories filled with emotion in a breathtaking setting."
    ],
    "it": [
      "Fotografo, realizzo sessioni :\r\n- Famiglia, coppia, bambino\r\n- Gravidanza, Neonato\r\n- Matrimoni\r\n- Immobili ed eventi\r\n\r\nPer lasciarvi ricordi meravigliosi e pieni di emozioni in uno scenario mozzafiato"
    ],
    "fr": [
      "Photographe, je réalise des séances :\r\n- Famille, Couple, Enfant \r\n- Grossesse, nouveau-né\r\n- Mariage\r\n- Immobilières et événementielles\r\n\r\nPour vous laisser de merveilleux souvenirs remplis d'émotions dans un cadre à couper le souffle"
    ],
    "nl": [
      "Fotograaf, ik realiseer sessies :\r\n- Familie, Paar, Kind\r\n- Zwangerschap, Pasgeborenen\r\n- Bruiloften\r\n- Onroerend goed en evenementen\r\n\r\nOm u achter te laten met prachtige herinneringen vol emotie in een adembenemende omgeving"
    ],
    "es": [
      "Fotógrafo, realizo sesiones :\r\n- Familia, Pareja, Niño\r\n- Embarazo, Recién nacido\r\n- Bodas\r\n- Inmobiliarias y eventos\r\n\r\nPara dejarte maravillosos recuerdos llenos de emoción en un entorno impresionante"
    ]
  },
