  "rdfs:comment": {
    "de": [
      "Begeben Sie sich auf die historischen Spuren unseres Dorfes, indem Sie die tausendjährige Route der Salzstraße begehen! Versetzen Sie sich mit der Familie oder mit Freunden in die Rolle der Händler, die durch unsere Berge zogen."
    ],
    "en": [
      "Follow in the historical footsteps of our village by following the thousand-year-old route of the salt route! With family or friends, put yourself in the shoes of the merchants who roamed our mountains."
    ],
    "it": [
      "Seguite le tracce della storia del nostro villaggio lungo la millenaria via del sale! In famiglia o con gli amici, mettetevi nei panni dei mercanti che si aggiravano sulle nostre montagne."
    ],
    "fr": [
      "Partez sur les traces historiques de notre village en parcourant l'itinéraire millénaire de la route du sel ! En famille ou entre amis, mettez-vous dans la peau des marchands qui parcouraient nos montagnes."
    ],
    "es": [
      "¡Sigue las huellas históricas de nuestro pueblo siguiendo el trazado milenario de la ruta de la sal! En familia o con amigos, ponte en la piel de los comerciantes que merodeaban por nuestras montañas."
    ],
    "nl": [
      "Treed in de voetsporen van de geschiedenis van ons dorp langs de duizend jaar oude zoutroute! Kruip met het gezin of met vrienden in de huid van de kooplieden die vroeger door onze bergen zwierven."
    ]
  },
  "rdfs:label": {
    "en": [
      "Escape Game Salt Road"
    ],
    "fr": [
      "Escape Game Route du sel"
    ],
    "es": [
      "Juego de escape Camino de la sal"
    ]
  },
