  "rdfs:comment": {
    "de": [
      "Von der Mobile Compagnie. Alles ist dabei: Verse in allen Variationen, Reime in allen Variationen, hübsche Poesie, ein bisschen Prosa und sogar eine Fabel, in der es um Schafe geht! Dauer: 35 Min. - Für alle ab 6 Jahren."
    ],
    "en": [
      "By the Mobile Compagnie. It's all about verses, rhymes, pretty poetry, a bit of prose too, and even a fable about sheep! Running time: 35 min - All ages 6 and up."
    ],
    "it": [
      "A cura della Compagnia Mobile. C'è di tutto: un po' di versi, un po' di rime, un po' di belle poesie, un po' di prosa e persino una favola sulle pecore! Durata: 35 minuti - Per tutti i bambini dai 6 anni in su."
    ],
    "fr": [
      "Par la Mobile Compagnie. Tout y passe : des vers en veux-tu, des rimes en voilà, de la poésie jolie jolie, un peu de prose aussi, même une fable où il est question de brebis ! Durée : 35 min - Tout public à partir de 6 ans."
    ],
    "es": [
      "Por la Mobile Compagnie. Lo tiene todo: un poco de verso, un poco de rima, un poco de poesía bonita, un poco de prosa también, ¡e incluso una fábula sobre ovejas! Duración: 35 minutos - A partir de 6 años."
    ],
    "nl": [
      "Door de Mobiele Compagnie. Het heeft het allemaal: een beetje versjes, een beetje rijm, een beetje mooie poëzie, ook een beetje proza, en zelfs een fabel over schapen! Duur: 35 min - Voor alle leeftijden vanaf 6 jaar."
    ]
  },
  "rdfs:label": {
