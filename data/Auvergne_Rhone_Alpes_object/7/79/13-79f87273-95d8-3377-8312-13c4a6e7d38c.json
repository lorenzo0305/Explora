  "rdfs:comment": {
    "de": [
      "Von Lapeyrouse bis Gannat überqueren fünf außergewöhnliche Bauwerke auf der Eisenbahnstrecke die Täler von Bouble und Sioule. Die Viadukte von Bouble, Bélon, Perrière, Rouzat und Neuvial sind zum Teil als historische Denkmäler und Naturdenkmäler eingetragen."
    ],
    "en": [
      "From Lapeyrouse to Gannat, 5 exceptional railroad structures cross the Bouble and Sioule valleys. Some of the viaducts at Bouble, Bélon, Perrière, Rouzat and Neuvial are listed as historic monuments and natural sites."
    ],
    "it": [
      "Da Lapeyrouse a Gannat, 5 strutture eccezionali della linea ferroviaria attraversano le valli di Bouble e Sioule. Alcuni dei viadotti di Bouble, Bélon, Perrière, Rouzat e Neuvial sono classificati come monumenti storici e siti naturali."
    ],
    "fr": [
      "De Lapeyrouse à Gannat, 5 ouvrages exceptionnels sur la voie ferrée franchissent les vallées de Bouble et Sioule. Les viaducs de Bouble, Bélon, Perrière, Rouzat, Neuvial sont inscrits pour certains au titre des monuments historiques et des sites naturels."
    ],
    "nl": [
      "Van Lapeyrouse tot Gannat, doorkruisen 5 uitzonderlijke structuren op de spoorlijn de valleien van Bouble en Sioule. De viaducten van Bouble, Bélon, Perrière, Rouzat, Neuvial, waarvan sommige zijn geklasseerd als historisch monument en natuurgebied."
    ],
    "es": [
      "De Lapeyrouse a Gannat, 5 estructuras excepcionales de la línea férrea atraviesan los valles de Bouble y Sioule. Algunos de los viaductos de Bouble, Bélon, Perrière, Rouzat y Neuvial están catalogados como monumentos históricos y parajes naturales."
    ]
  },
