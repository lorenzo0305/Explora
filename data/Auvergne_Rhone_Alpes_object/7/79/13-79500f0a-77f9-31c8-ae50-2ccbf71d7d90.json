  "rdfs:comment": {
    "de": [
      "Céline Latour und Blanche Latour für das klassische Repertoire, Helena Menachemoff für das Gospelrepertoire und Jean Marie Couttet für das Varieté."
    ],
    "en": [
      "A convivial week of choral training, supervised by our choirmasters: Céline Latour and Blanche Latour for the classical repertoire, Helena Menachemoff for the gospel repertoire and Jean Marie Couttet for variety."
    ],
    "it": [
      "Una settimana divertente di formazione corale, sotto la supervisione dei nostri direttori di coro: Céline Latour e Blanche Latour per il repertorio classico, Helena Menachemoff per il repertorio gospel e Jean Marie Couttet per il varietà."
    ],
    "fr": [
      "Une semaine conviviale de stage de chant choral, encadrée par par nos chefs de chœur : Céline Latour et Blanche Latour pour le répertoire classique, Helena Menachemoff pour le répertoire gospel et Jean Marie Couttet pour la variété."
    ],
    "es": [
      "Una semana lúdica de formación coral, supervisada por nuestros directores de coro: Céline Latour y Blanche Latour para el repertorio clásico, Helena Menachemoff para el repertorio evangélico y Jean Marie Couttet para las variedades."
    ],
    "nl": [
      "Een week vol koorscholing onder begeleiding van onze koordirigenten: Céline Latour en Blanche Latour voor het klassieke repertoire, Helena Menachemoff voor het gospelrepertoire en Jean Marie Couttet voor de variété."
    ]
