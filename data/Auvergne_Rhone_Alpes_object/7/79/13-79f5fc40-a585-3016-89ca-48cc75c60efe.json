  "rdfs:comment": {
    "de": [
      "Unsere Brennerei, die seit über 30 Jahren im Herzen der Vulkane der Auvergne produziert und destilliert, kultiviert die natürlichen Vorzüge der Pflanzen. Erleben Sie eine einzigartige Erfahrung, indem Sie sich für unsere Workshops und Führungen anmelden."
    ],
    "en": [
      "A producer and distiller for over 30 years in the heart of the Auvergne volcanoes, our distillery cultivates the natural benefits of plants. Join our workshops and guided tours for a unique experience."
    ],
    "it": [
      "Produttore e distillatore da oltre 30 anni nel cuore dei vulcani dell'Alvernia, la nostra distilleria coltiva i benefici naturali delle piante. Godetevi un'esperienza unica iscrivendovi ai nostri laboratori e alle nostre visite guidate."
    ],
    "fr": [
      "Producteur et distillateur depuis plus de 30 ans au cœur des volcans d’Auvergne, notre distillerie cultive les bienfaits naturels des plantes. Vivez une expérience unique en vous inscrivant à nos ateliers et visites guidées."
    ],
    "es": [
      "Productor y destilador desde hace más de 30 años en el corazón de los volcanes de Auvernia, nuestra destilería cultiva los beneficios naturales de las plantas. Disfrute de una experiencia única apuntándose a nuestros talleres y visitas guiadas."
    ],
    "nl": [
      "Onze distilleerderij, al meer dan 30 jaar producent en distilleerder in het hart van de vulkanen van de Auvergne, cultiveert de natuurlijke weldaden van planten. Geniet van een unieke ervaring door je in te schrijven voor onze workshops en rondleidingen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Distillerie Saint-Hilaire Auvergne"
    ]
  },
