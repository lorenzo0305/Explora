  "rdfs:comment": {
    "de": [
      "Au Bureau ist eine einzigartige Kneipe/Brasserie mit einer exotischen angelsächsischen Einrichtung. In einer entspannten und geselligen Atmosphäre werden Sie immer eine gute Ausrede haben, um spät vom Le Bureau nach Hause zu kommen."
    ],
    "en": [
      "Au Bureau is a unique pub/brasserie with an exotic Anglo-Saxon decor. In a relaxed and friendly atmosphere, you'll always have a good excuse to come home late from the Bureau."
    ],
    "it": [
      "Au Bureau è un pub/birreria unico nel suo genere, con un arredamento esotico anglosassone. In un'atmosfera rilassata e amichevole, avrete sempre una buona scusa per tornare a casa tardi dal Bureau."
    ],
    "fr": [
      "Au Bureau est un pub/Brasserie unique, au décor Anglo-saxon dépaysant. Dans une ambiance détendue et conviviale, vous aurez toujours une bonne excuse pour rentrer tard du Bureau."
    ],
    "nl": [
      "Au Bureau is een unieke pub/brouwerij met een exotisch Angelsaksisch decor. In een ontspannen en vriendelijke sfeer heb je altijd een goed excuus om laat thuis te komen van het Bureau."
    ],
    "es": [
      "Au Bureau es un pub/cervecería único con una exótica decoración anglosajona. En un ambiente relajado y acogedor, siempre tendrás una buena excusa para volver tarde del Bureau."
    ]
  },
  "rdfs:label": {
