  "rdfs:comment": {
    "de": [
      "Besuchen Sie eine handwerkliche Imkerei, die biologischen Honig verarbeitet. Entdecken Sie das Leben der Bienen und probieren Sie die zahlreichen Produkte, die im Laden angeboten werden. Ein Besuch bei Lilo Nectar bedeutet, die Leidenschaft für eine nachhaltige Bienenzucht zu teilen."
    ],
    "en": [
      "Visit an artisanal honey house processing organic honey. Discover the life of bees and taste the many products on offer in the store. To come to Lilo Nectar is to share the passion of sustainable beekeeping."
    ],
    "it": [
      "Visitate una fabbrica di miele artigianale che lavora miele biologico. Scoprite la vita delle api e assaggiate i numerosi prodotti offerti dal negozio. Venire a Lilo Nectar significa condividere la passione dell'apicoltura sostenibile."
    ],
    "fr": [
      "Visitez une miellerie artisanale transformant un miel biologique. Découvrez la vie des abeilles et dégustez les nombreux produits proposés dans la boutique. Venir à Lilo Nectar c’est partager la passion d’une apiculture durable."
    ],
    "es": [
      "Visite una fábrica artesanal de miel ecológica. Descubra la vida de las abejas y deguste los numerosos productos que se ofrecen en la tienda. Venir a Lilo Nectar significa compartir la pasión por la apicultura sostenible."
    ],
    "nl": [
      "Bezoek een ambachtelijke honingfabriek die biologische honing verwerkt. Ontdek het leven van de bijen en proef de vele producten die in de winkel worden aangeboden. Naar Lilo Nectar komen betekent het delen van de passie voor duurzame bijenteelt."
    ]
  },
  "rdfs:label": {
