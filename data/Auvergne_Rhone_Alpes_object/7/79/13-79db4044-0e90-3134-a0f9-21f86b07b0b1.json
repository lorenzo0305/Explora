  "rdfs:comment": {
    "de": [
      "Einführung in das Mini-Quad für Kinder auf einem geschlossenen und gesicherten Parcours. Hier können Sie in einer Sitzung viele Eindrücke sammeln!\r\nDie Quads sind an das Alter und die Größe der Kinder angepasst (6-15 Jahre).\r\n\r\nWIR VERFÜGEN NICHT ÜBER QUADS FÜR ERWACHSENE, DANKE!"
    ],
    "en": [
      "Introduction to mini quads for children on a secure, closed course. A session full of sensations!\r\nQuads are adapted to children's age and size (6-14 years).\r\n\r\nWE DON'T HAVE ANY ADULT QUADS, THANK YOU!"
    ],
    "it": [
      "Un'introduzione al mini quad per bambini su un percorso chiuso e sicuro. Una sessione piena di emozioni!\r\nI quad sono adattati all'età e alle dimensioni dei bambini (6-15 anni)\r\nI quad sono solo per bambini!"
    ],
    "fr": [
      "Initiation au mini quad pour enfants sur parcours fermé et sécurisé. Le plein de sensations lors d'une séance !\r\nLes quads sont adaptés à l'age et à la taille des enfants (6-15 ans)\r\nLes quads sont uniquement pour les enfant !"
    ],
    "es": [
      "Iniciación al mini quad para niños en un circuito cerrado y seguro. ¡Una sesión llena de emociones!\r\nLos quads están adaptados a la edad y el tamaño de los niños (6-15 años)\r\n¡Los quads son sólo para niños!"
    ],
    "nl": [
      "Een kennismaking met mini-quadrijden voor kinderen op een omheind, veilig parcours. Een sessie vol sensatie!\r\nDe quads zijn aangepast aan de leeftijd en grootte van de kinderen (6-14 jaar).\r\n\r\nWE HEBBEN GEEN QUADS VOOR VOLWASSENEN, DANK JE!"
    ]
  },
