  "rdfs:comment": {
    "de": [
      "Yoga eignet sich hervorragend für die Entwicklung von Kraft, Flexibilität, Gleichgewicht und Entspannung.\r\nDer Unterricht findet im Winter dienstags um 17:30-18:45 Uhr auf Englisch mit ein wenig Französisch statt.\r\nKurse für alle Niveaus ab 16 Jahren."
    ],
    "en": [
      "Yoga is a great way to build strength, gain in flexibility and balance and relax."
    ],
    "it": [
      "Lo yoga è eccellente per sviluppare forza, flessibilità, equilibrio e rilassamento.\r\nLe lezioni si tengono in inverno il martedì alle 17.30-18.45 in inglese e in parte in francese.\r\nLezioni per tutti i livelli, dai 16 anni in su."
    ],
    "fr": [
      "Le yoga est excellent pour le développement de la force, de la souplesse, de l'équilibre et relaxation.\r\nLes cours sont donnés en hiver les mardis à 17h30- 1845 en anglais avec un peu de français.\r\nCours pour tous les niveaux a' partir 16 ans."
    ],
    "nl": [
      "Yoga is zeer goed voor de ontwikkeling van kracht, lenigheid,  evenwicht en ontspanning."
    ],
    "es": [
      "El yoga es excelente para desarrollar la fuerza, la flexibilidad, el equilibrio y la relajación.\r\nLas clases se imparten en invierno los martes de 17:30 a 18:45 en inglés con algo de francés.\r\nClases para todos los niveles a partir de 16 años."
    ]
  },
