  "rdfs:comment": {
    "de": [
      "Das Hotel Le Tanargue*** befindet sich am Fuße des Mont Tanargue, einem Paradies für Wanderer, Radfahrer, Angler und alle, die die Natur, die Artenvielfalt, die Fauna und Flora lieben."
    ],
    "en": [
      "Hôtel Le Tanargue*** is located at the foot of Mont Tanargue, a paradise for hikers, bikers, fishermen and all lovers of nature, biodiversity, flora and fauna."
    ],
    "it": [
      "L'Hotel Le Tanargue*** si trova ai piedi del Mont Tanargue, un paradiso per escursionisti, ciclisti, pescatori e tutti gli amanti della natura, della biodiversità, della fauna e della flora."
    ],
    "fr": [
      "L‘Hôtel Le Tanargue*** se situe au pied du Mont Tanargue, paradis des randonneurs, des vélos, des pêcheurs et tous les amoureux de la nature, de la biodiversité, de la faune et de la flore."
    ],
    "nl": [
      "Hotel Le Tanargue*** ligt aan de voet van de Mont Tanargue, een paradijs voor wandelaars, fietsers, vissers en alle liefhebbers van natuur, biodiversiteit, fauna en flora."
    ],
    "es": [
      "El Hotel Le Tanargue*** está situado al pie del Monte Tanargue, un paraíso para los excursionistas, ciclistas, pescadores y todos los amantes de la naturaleza, la biodiversidad, la fauna y la flora."
    ]
  },
