  "rdfs:comment": {
    "de": [
      "In einem warmen, von den Vulkanen der Auvergne inspirierten Ambiente lädt Sie unser Thermalbad mit der einzigartigen Mineralität des natürlichen Thermalwassers von Châtel-Guyon zum Entspannen ein."
    ],
    "en": [
      "In a warm atmosphere inspired by the volcanoes of Auvergne, our Thermal Spa invites you to relax with the unique minerality of Châtel-Guyon?s natural thermal water."
    ],
    "it": [
      "In una calda atmosfera ispirata ai vulcani dell'Alvernia, la nostra Thermal Spa vi invita a rilassarvi con la mineralità unica dell'acqua termale naturale di Châtel-Guyon."
    ],
    "fr": [
      "Dans une ambiance chaleureuse inspirée par les volcans d’Auvergne, notre Spa Thermal vous invite au relâchement grâce à la minéralité unique de l’eau thermale naturelle de Châtel-Guyon."
    ],
    "nl": [
      "In een warme sfeer, geïnspireerd door de vulkanen van de Auvergne, nodigt onze Therme je uit om te ontspannen met de unieke mineraliteit van het natuurlijke thermale water van Châtel-Guyon."
    ],
    "es": [
      "En un ambiente cálido inspirado en los volcanes de Auvernia, nuestro Spa Termal le invita a relajarse con la mineralidad única de las aguas termales naturales de Châtel-Guyon."
    ]
  },
  "rdfs:label": {
