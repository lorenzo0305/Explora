  "rdfs:comment": {
    "de": [
      "Diese Straße ist nach dem Arzt und Inspektor der Thermalbäder von Vichy benannt, der für den reibungslosen Ablauf der Kuren von Napoleon III. sorgte."
    ],
    "en": [
      "This street is named after the doctor, inspector of the Vichy spa, who ensured that Napoleon III?s cures ran smoothly."
    ],
    "it": [
      "Questa strada prende il nome dal medico e ispettore delle terme di Vichy, che assicurava il buon funzionamento delle cure di Napoleone III."
    ],
    "fr": [
      "Cette rue porte le nom du médecin, inspecteur de l’établissement thermal de Vichy, qui a veillé au bon déroulement des cures de Napoléon III."
    ],
    "es": [
      "Esta calle debe su nombre al médico e inspector de las termas de Vichy, que velaba por el buen desarrollo de las curas de Napoleón III."
    ],
    "nl": [
      "Deze straat is vernoemd naar de dokter en inspecteur van de thermale baden van Vichy, die ervoor zorgde dat de kuren van Napoleon III goed verliepen."
    ]
  },
