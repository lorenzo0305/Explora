  "rdfs:comment": {
    "de": [
      "Wir begrüßen Sie in einer wunderschönen asiatischen Umgebung, um unsere Gerichte zu probieren. Herr Wu und sein Team werden Ihnen Mahlzeiten für die Familie, mit Freunden oder aus beruflichen Gründen anbieten."
    ],
    "en": [
      "We welcome you to enjoy our dishes in a wonderful Asian setting. Mr. Wu and his team will help you discover meals for family, friends or business."
    ],
    "it": [
      "Vi diamo il benvenuto in un meraviglioso ambiente asiatico per gustare i nostri piatti. Il signor Wu e il suo team vi faranno scoprire piatti da mangiare in famiglia, con gli amici o per lavoro."
    ],
    "fr": [
      "Nous vous accueillons dans un merveilleux cadre asiatique afin de déguster nos plats. Monsieur Wu et son équipe vous feront découvrir des repas à manger en famille, entre amis ou d’ordre professionnel."
    ],
    "nl": [
      "We verwelkomen je om van onze gerechten te genieten in een prachtig Aziatisch kader. Mr Wu en zijn team zullen u helpen bij het ontdekken van maaltijden voor familie, vrienden of zaken."
    ],
    "es": [
      "Le damos la bienvenida en un maravilloso entorno asiático para disfrutar de nuestros platos. El Sr. Wu y su equipo le harán descubrir platos para comer con la familia, los amigos o los negocios."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Royal de Drôme"
    ]
  },
