      "schema:openingHoursSpecification": [
        {
          "@id": "https://data.datatourisme.fr/1d37296e-96be-3d53-af62-314f8ee2d0fc",
          "schema:validFrom": "2026-01-01T00:00:00",
          "schema:validThrough": "2026-12-31T23:59:59",
          "@type": [
            "schema:OpeningHoursSpecification"
          ],
          "additionalInformation": {
            "de": [
              "Montag, Dienstag, Mittwoch, Donnerstag, Freitag, Samstag: offen\r\n\r\n- Das ganze Jahr über von Montag bis Samstag von 9:00 bis 12:00 Uhr und 14:00 bis 19:00 Uhr geöffnet.\r\nAn Sonn- und Feiertagen geschlossen.\r\nDer Sonntag ist für den Skiverleih geöffnet, wenn die Skigebiete in der Drôme geöffnet sind. Konsultieren Sie uns!"
            ],
            "en": [
              "Monday, Tuesday, Wednesday, Thursday, Friday, Saturday: open\r\n\r\n- Open all year round, Monday to Saturday, 9am to 12pm and 2pm to 7pm.\r\nClosed on Sundays and public holidays.\r\nSundays are open for ski rental when Drôme resorts are open. We look forward to hearing from you!"
            ],
            "it": [
              "Lunedì, martedì, mercoledì, giovedì, venerdì, sabato: aperto\r\n\r\n- Aperto tutto l'anno, dal lunedì al sabato, dalle 9.00 alle 12.00 e dalle 14.00 alle 19.00.\r\nChiuso la domenica e i giorni festivi.\r\nLe domeniche sono aperte per il noleggio sci quando le stazioni della Drôme sono aperte. Non vediamo l'ora di sentirvi!"
            ],
            "fr": [
              "Lundi, Mardi, Mercredi, Jeudi, Vendredi, Samedi : ouvert\r\n\r\n- Ouvert toute l'année du lundi au samedi de 9h à 12h et 14h à 19h.\r\nFermé dimanche et jours fériés.\r\nLe dimanche est ouvert pour la location de skis lorsque les stations de la Drôme sont ouvertes. Consultez nous !"
            ],
            "nl": [
              "Maandag, dinsdag, woensdag, donderdag, vrijdag, zaterdag: open\r\n\r\n- Het hele jaar geopend, van maandag tot en met zaterdag van 9.00 tot 12.00 uur en van 14.00 tot 19.00 uur.\r\nGesloten op zon- en feestdagen.\r\nOp zondag is de skiverhuur geopend wanneer de skigebieden in de Drôme open zijn. We horen graag van je!"
            ],
            "es": [
              "Lunes, martes, miércoles, jueves, viernes y sábado: abierto\r\n\r\n- Abierto todo el año, de lunes a sábado, de 9.00 a 12.00 y de 14.00 a 19.00 horas.\r\nCerrado los domingos y días festivos.\r\nLos domingos están abiertos para el alquiler de esquís cuando las estaciones de la Drôme están abiertas. ¡Le esperamos!"
            ]
          },
