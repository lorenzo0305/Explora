  "rdfs:comment": {
    "de": [
      "Le Basalte ist mehr als nur ein Restaurant, es ist eine Einladung, die Authentizität und kulinarische Exzellenz der Auvergne zu erkunden. Freuen Sie sich auf eine Auswahl traditioneller Gerichte, die neu interpretiert werden und bei denen lokale Produkte und die Aromen der Region im Vordergrund stehen."
    ],
    "en": [
      "Le Basalte is more than a restaurant, it's an invitation to explore the authenticity and culinary excellence of Auvergne. Expect a selection of revisited traditional dishes, featuring local produce and regional flavors."
    ],
    "it": [
      "Le Basalte è più di un semplice ristorante, è un invito a esplorare l'autenticità e l'eccellenza culinaria dell'Alvernia. Vi aspetta una selezione di piatti tradizionali rivisitati, con prodotti locali e sapori della regione."
    ],
    "fr": [
      "Le Basalte est plus qu'un restaurant, c'est une invitation à explorer l'authenticité et l'excellence culinaire auvergnate. Attendez vous à une sélection de plats traditionnels revisités, mettant à l'honneur les produits locaux et les saveurs de la région."
    ],
    "nl": [
      "Le Basalte is meer dan een restaurant, het is een uitnodiging om de authenticiteit en culinaire uitmuntendheid van de Auvergne te ontdekken. Verwacht een selectie van traditionele gerechten met lokale producten en de smaken van de regio."
    ],
    "es": [
      "Le Basalte es más que un restaurante, es una invitación a descubrir la autenticidad y la excelencia culinaria de Auvernia. Le espera una selección de platos tradicionales revisitados, con productos locales y los sabores de la región."
    ]
  },
  "rdfs:label": {
