  "rdfs:comment": {
    "de": [
      "Machen Sie Ihre Seminare in Unternehmen zu einem einzigartigen Erlebnis in einer grünen Umgebung. Ausgestattete Tagungsräume, völlig atypisch in der Jurte oder in der Berghütte.\r\nMaßgeschneiderte Formeln."
    ],
    "en": [
      "Make your corporate seminars a unique experience in a green setting. Equipped meeting rooms, totally atypical under the yurt or in the mountain chalet.\r\nCustomized formulas."
    ],
    "it": [
      "Rendete i vostri seminari aziendali un'esperienza unica in un ambiente verde. Sale riunioni completamente attrezzate, totalmente atipiche sotto la yurta o nello chalet di montagna.\r\nFormule su misura."
    ],
    "fr": [
      "Faites de vos séminaires en entreprises une expérience unique dans un cadre verdoyant. Salles de réunions équipées, totalement atypiques sous la yourte ou dans le chalet de montagne.\r\nDes formules sur mesure."
    ],
    "nl": [
      "Maak van uw bedrijfsseminaries een unieke ervaring in een groene omgeving. Volledig uitgeruste vergaderzalen, totaal atypisch onder de yurt of in het berghutje.\r\nFormules op maat."
    ],
    "es": [
      "Haga de sus seminarios de empresa una experiencia única en un entorno verde. Salas de reuniones totalmente equipadas, totalmente atípicas bajo la yurta o en el chalet de montaña.\r\nFórmulas a medida."
    ]
  },
  "rdfs:label": {
