  "rdfs:comment": {
    "de": [
      "Weltküche &amp; Frenchy-Sound, hergestellt aus überwiegend biologischen &amp; lokalen Produkten.\r\nTäglich 2 verschiedene Gerichte/2 Desserts.\r\nAperitif- und Tellergerichte am Freitagabend.\r\nAn manchen Samstagen: Brunch."
    ],
    "en": [
      "World cuisine made using mainly organic and local produce.\r\n2 different main courses & 2 desserts proposed every day.\r\nAperitif platters and  main course on Friday evening.\r\nSome Saturdays: brunch."
    ],
    "it": [
      "Cucina mondiale con un tocco francese, utilizzando principalmente prodotti biologici e locali.\r\n2 piatti/2 dessert diversi ogni giorno.\r\nAperitivo e piatto principale il venerdì sera.\r\nAlcuni sabati: brunch."
    ],
    "fr": [
      "Cuisine du monde & son frenchy confectionnée à partir de produits majoritairement bio & locaux.\r\n2 plats/2 desserts différents tous les jours.\r\nPlanches apéro & plat le vendredi soir.\r\nCertains samedis : formule brunch."
    ],
    "nl": [
      "Wereldkeuken met een Franse twist, met voornamelijk biologische en lokale producten.\r\nElke dag 2 gerechten/2 verschillende desserts.\r\nAperitief en hoofdgerechten op vrijdagavond.\r\nSommige zaterdagen: brunch."
    ],
    "es": [
      "Cocina del mundo con un toque francés, utilizando principalmente productos ecológicos y locales.\r\n2 platos/2 postres diferentes cada día.\r\nAperitivo y platos principales los viernes por la noche.\r\nAlgunos sábados: brunch."
    ]
  },
  "rdfs:label": {
