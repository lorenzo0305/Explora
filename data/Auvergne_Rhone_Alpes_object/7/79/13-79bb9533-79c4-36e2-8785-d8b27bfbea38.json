    "de": [
      "Leichte, sonnige Piste mit einem kurzen, steilen Anstieg, der über den Chemin des Avals und in der Nähe der Bauernhöfe von Pralin verläuft."
    ],
    "en": [
      "Easy, sunny trail with a short, steep climb, via the Chemin des Avals and near the Pralin farms."
    ],
    "it": [
      "Un percorso facile e soleggiato con una breve e ripida salita, che passa lungo lo Chemin des Avals e vicino alle fattorie Pralin."
    ],
    "fr": [
      "Piste facile et ensoleillée avec une courte montée raide, passant par le chemin des Avals et près des fermes de Pralin."
    ],
    "es": [
      "Un sendero fácil y soleado con una subida corta y empinada, pasando por el Chemin des Avals y cerca de las granjas de Pralin."
    ],
    "nl": [
      "Een gemakkelijke, zonnige route met een korte, steile klim, langs de Chemin des Avals en vlakbij de boerderijen van Pralin."
