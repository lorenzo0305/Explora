  "rdfs:comment": {
    "de": [
      "17H45 Beginn der Animationen.\r\n19 Uhr Start des Films.\r\nJeden Mittwochabend im Winter in Les Saisies gibt es ein anderes Programm rund um den unveröffentlichten Film \"Les gardiens des montagnes\" (Die Wächter der Berge). Ein immersives Erlebnis für die ganze Familie."
    ],
    "en": [
      "From December 17 and every Wednesday evening thereafter, Les Saisies will be ablaze with light. During the Christmas holidays, the program will be broadcast on December 25 and January 1."
    ],
    "it": [
      "A partire dal 17 dicembre e successivamente ogni mercoledì sera, Les Saisies saranno illuminate a giorno. Durante il periodo natalizio, il programma sarà trasmesso il 25 dicembre e il 1° gennaio."
    ],
    "fr": [
      "17H45 début des animations. \r\n19H lancement du film. \r\nChaque mercredi soir de l’hiver aux Saisies, retrouvez une programmation différente autour d'un film inédit \"Les gardiens des montagnes\". Une expérience immersive pour toute la famille."
    ],
    "nl": [
      "Vanaf 17 december en elke woensdagavond daarna zal Les Saisies in lichterlaaie staan. Tijdens de kerstperiode wordt het programma uitgezonden op 25 december en 1 januari."
    ],
    "es": [
      "17.45 h: comienzo de la animación.\r\n19 h: comienzo de la película.\r\nTodos los miércoles de invierno en Les Saisies, disfrute de un programa diferente en torno a una nueva película, \"Les gardiens des montagnes\". Una experiencia envolvente para toda la familia."
    ]
  },
