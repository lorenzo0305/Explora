  "rdfs:comment": {
    "de": [
      "Die Fremdenführerin Julie nimmt Sie mit auf eine Entdeckungsreise durch das Drôme-Tal und die Region Diois. Die Geschichte, die Architektur und die lokalen Traditionen laden Sie zu einer Zeitreise ein. Besichtigungen oder geführte Rundgänge für geschlossene Gruppen auf Anfrage."
    ],
    "en": [
      "Julie, our tour guide, will take you on a journey of discovery through the Drôme Valley and the Diois region. History, architecture and local traditions invite you to take a trip back in time. Guided tours for groups on request."
    ],
    "it": [
      "La guida turistica Julie vi condurrà alla scoperta della Valle della Drôme e della regione del Diois. Storia, architettura e tradizioni locali vi condurranno in un viaggio nel tempo. Visite guidate per gruppi su richiesta."
    ],
    "fr": [
      "Julie, guide conférencière, vous emmène à la découverte de la Vallée de la Drôme et du Diois. L'histoire, l'architecture et les traditions locales vous invitent à un voyage dans le temps. Visites ou circuits guidés pour groupes constitués, à la demande."
    ],
    "es": [
      "Julie, guía turística, le llevará a descubrir el valle del Drôme y la región de Diois. La historia, la arquitectura y las tradiciones locales le harán viajar en el tiempo. Visitas guiadas para grupos a petición."
    ],
    "nl": [
      "Julie, een reisleidster, neemt je mee op een ontdekkingsreis door de Drômevallei en de Diois-streek. Geschiedenis, architectuur en lokale tradities nemen je mee op een reis door de tijd. Rondleidingen voor groepen op aanvraag."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Visites de Julie"
    ]
  },
