  "rdfs:comment": {
    "de": [
      "Die ambulante Crêperie \"Les Délices de Cathou\" stellt hausgemachte Crêpes und Galettes sowie hausgemachte Marmeladen aus lokalen Produkten her. Sie ist auf Märkten & Festen unterwegs oder bietet einen Cateringservice für private Veranstaltungen an."
    ],
    "en": [
      "Les Délices de Cathou\" mobile creperie makes homemade crêpes and galettes, and home-made jams using local produce. She travels to markets & festivals or offers a catering service for private events."
    ],
    "it": [
      "Les Délices de Cathou\" è una crêperie itinerante che prepara crêpes e galettes e marmellate fatte in casa con prodotti locali. Partecipa a mercati e festival e offre un servizio di catering per eventi privati."
    ],
    "fr": [
      "La crêperie ambulante \"Les Délices de Cathou\" confectionne des crêpes et galettes maisons ainsi que des confitures artisanales  avec des produits locaux. Elle se déplace sur les marchés & fêtes ou propose un service traiteur pour des événements privés."
    ],
    "nl": [
      "Les Délices de Cathou\" is een reizende crêperie die zelfgemaakte crêpes en galettes en zelfgemaakte jam maakt van lokale producten. Het bedrijf reist naar markten en festivals en biedt een cateringservice voor privé-evenementen."
    ],
    "es": [
      "Les Délices de Cathou\" es una crepería ambulante que elabora crepes y galettes caseras y mermeladas caseras con productos locales. Viaja a mercados y festivales y ofrece un servicio de catering para eventos privados."
    ]
  },
