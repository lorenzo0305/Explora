  "rdfs:comment": {
    "de": [
      "Genießen Sie unsere zartschmelzenden Raclette-Burger, unser Fondue, unser Raclette à l'ancienne, unseren mit Raclette überbackenen Entenparmentier und unsere mit Raclette überbackene Lasagne! Profitieren Sie von unserem Mittagsangebot"
    ],
    "en": [
      "Come and enjoy our melt-in-the-mouth raclette burgers, our fondue, our traditional raclette, our duck parmentier au gratin with raclette cheese and our lasagne au gratin with raclette cheese! Enjoy our lunch menu !"
    ],
    "it": [
      "Venite a gustare i nostri hamburger da raclette che si sciolgono in bocca, la nostra fonduta, la nostra raclette all'antica, la nostra parmentier d'anatra con raclette gratinata e le nostre lasagne con raclette gratinata! Approfittate del nostro menu per il pranzo"
    ],
    "fr": [
      "Venez savourer nos burgers fondants à la raclette, notre fondue, notre raclette à l'ancienne, notre parmentier de canard gratiné à la raclette et nos lasagnes gratinés à la raclette ! Profitez de notre formule midi"
    ],
    "es": [
      "Venga y disfrute de nuestras hamburguesas de raclette que se derriten en la boca, nuestra fondue, nuestra raclette a la antigua, nuestro parmentier de pato con gratinado de raclette y nuestra lasaña con gratinado de raclette Aproveche nuestro menú de mediodía"
    ],
    "nl": [
      "Kom en geniet van onze smeltzachte racletteburgers, onze fondue, onze ouderwetse raclette, onze eendenparmentier met raclettegratin en onze lasagne met raclettegratin! Profiteer van onze lunchkaart"
    ]
  },
  "rdfs:label": {
    "en": [
