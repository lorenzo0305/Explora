  "rdfs:comment": {
    "de": [
      "La Barbière ist ein alter Bauernhof im Vercors (1800er Jahre), der renoviert und in ein \"Healthy House\" umgewandelt wurde, um Gruppen (Privatpersonen, Sportler, Unternehmen, Therapeuten, ...) rund um das Thema Wellness und LSV-Sitzungen (Licht/Klang/Vibrationen) zu empfangen"
    ],
    "en": [
      "La Barbière is an old farm in the Vercors (1800's) renovated and converted into a \"healthy house\" to welcome groups (private & individuals, sportsmen, companies, therapists, .) around well-being and LSV (Light/Sound/Vibrations) sessions"
    ],
    "it": [
      "La Barbière è un'antica fattoria del Vercors (1800) ristrutturata e trasformata in una \"casa salutare\" per accogliere gruppi (privati e individuali, sportivi, aziende, terapeuti, .) intorno al benessere e alle sessioni LSV (Luce/Suono/Vibrazioni)"
    ],
    "fr": [
      "La Barbière est une ancienne ferme du Vercors (années 1800) rénovée et reconvertie en \"healthy house\" pour accueillir des groupes (privés & particuliers, sportifs, entreprises, thérapeutes, .) autour du bien-être et de séances LSV (Lumière/Son/Vibrations)"
    ],
    "nl": [
      "La Barbière is een oude boerderij in de Vercors (1800) gerenoveerd en omgebouwd tot een \"gezond huis\" om groepen (particulieren & individuen, sporters, bedrijven, therapeuten, .) te ontvangen rond welzijn en LSV sessies (Licht/Geluid/Vibraties)"
    ],
    "es": [
      "La Barbière es una antigua granja del Vercors (1800) rehabilitada y convertida en \"casa saludable\" para acoger a grupos (particulares, deportistas, empresas, terapeutas, etc.) para sesiones de bienestar y LSV (Luz/Sonido/Vibración)"
    ]
  },
