  "rdfs:comment": {
    "de": [
      "In der Bergerie de la Rouye stellen wir Käse und Joghurt aus Schafsmilch her. Wir verarbeiten unsere gesamte Milchproduktion. Wir freuen uns, Ihnen während der Öffnungszeiten der Schäferei einen Einblick in unseren Beruf zu geben."
    ],
    "en": [
      "At the Bergerie de la Rouye, we produce cheese and yogurt from sheep. We transform all of our milk production. We will be happy to make you discover our job during the opening hours of the sheepfold."
    ],
    "it": [
      "Alla Bergerie de la Rouye produciamo formaggio di pecora e yogurt. Trasformiamo l'intera produzione di latte. Saremo lieti di mostrarvi il nostro lavoro durante gli orari di apertura dell'ovile."
    ],
    "fr": [
      "A la bergerie de la Rouye, nous produisons du fromage et du yaourt de brebis. Nous transformons l'intégralité de notre production laitière. Nous serons heureux de vous faire découvrir notre métier lors des horaires d'ouverture de la bergerie."
    ],
    "nl": [
      "In de Bergerie de la Rouye produceren we schapenkaas en yoghurt. We verwerken onze hele melkproductie. Wij laten u graag ons werk zien tijdens de openingstijden van de schaapskooi."
    ],
    "es": [
      "En la Bergerie de la Rouye, producimos queso de oveja y yogur. Procesamos toda nuestra producción de leche. Estaremos encantados de mostrarle nuestro trabajo durante el horario de apertura del redil."
    ]
  },
  "rdfs:label": {
