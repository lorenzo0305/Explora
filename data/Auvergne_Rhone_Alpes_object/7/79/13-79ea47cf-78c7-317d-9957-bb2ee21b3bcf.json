  "rdfs:comment": {
    "de": [
      "Astronomisches Observatorium: Entdeckung, Ausbildung von Animateuren, wissenschaftliche Projekte, Praktika. Planetarium, Georama, Videoprojektion und Beobachtung der Sterne und der Sonne vom Standort Isserteaux aus. Kostenlose Nachtwache am ersten Samstag jedes Monats."
    ],
    "en": [
      "Astronomy observatory: discovery, instructor training, scientific projects, internships. Planetarium, georama, video projection and observation of the stars and sun from the Isserteaux site. Free vigil on the 1st Saturday of every month."
    ],
    "it": [
      "Osservatorio astronomico: scoperta, formazione dei dirigenti, progetti scientifici, corsi. Planetario, georama, proiezione di video e osservazione delle stelle e del sole dal sito di Isserteaux. Eventi serali gratuiti il 1° sabato di ogni mese."
    ],
    "fr": [
      "Observatoire d'astronomie : découverte, formation d'animateurs, projets scientifiques, stages. Planétarium, géorama, vidéo-projection et observation des étoiles et du soleil à partir du site d'Isserteaux. Veillée gratuite le 1er samedi de chaque mois."
    ],
    "nl": [
      "Sterrenwacht: ontdekking, leiderschapstraining, wetenschappelijke projecten, cursussen. Planetarium, georama, videoprojectie en observatie van de sterren en de zon vanaf de Isserteaux site. Gratis avondevenementen op de 1e zaterdag van elke maand."
    ],
    "es": [
      "Observatorio astronómico: descubrimiento, formación de líderes, proyectos científicos, cursos. Planetario, georama, proyección de vídeos y observación de las estrellas y el sol desde el emplazamiento de Isserteaux. Veladas gratuitas el primer sábado de cada mes."
    ]
  },
