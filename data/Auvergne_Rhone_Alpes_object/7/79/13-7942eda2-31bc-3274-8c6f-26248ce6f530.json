  "rdfs:comment": {
    "de": [
      "Züchter von Limousin-Kühen. Produzent von grünen Linsen aus Le Puy. Besichtigung des Bauernhofs auf Voranmeldung.\r\nEntdecken Sie den Reichtum des Departements im Bereich der Landwirtschaft, der Gastronomie, des Handwerks..."
    ],
    "en": [
      "Breeding of Limousin cows. Producer of green Puy lentils. Farm visit by appointment.\r\nDiscover the richness of the department's agriculture, gastronomy, crafts..."
    ],
    "it": [
      "Allevamento di vacche Limousin. Produttore di lenticchie verdi di Puy. Visita della fattoria su prenotazione.\r\nScoprite la ricchezza dei prodotti agricoli, gastronomici e artigianali del dipartimento..."
    ],
    "fr": [
      "Élevage de vaches limousines. Producteur de lentilles vertes du Puy. Visite de la ferme sur réservation.\r\nDécouvrez les richesses du département dans le domaine de l'agriculture, la gastronomie, l'artisanat..."
    ],
    "nl": [
      "Fokken van Limousinkoeien. Producent van groene Puy linzen. Bezoek aan de boerderij op afspraak.\r\nOntdek de rijkdom van het departement aan landbouw-, gastronomische en ambachtelijke producten..."
    ],
    "es": [
      "Cría de vacas de raza Limusín. Productor de lentejas verdes de Puy. Visita de la granja previa concertación.\r\nDescubra la riqueza agrícola, gastronómica y artesanal del departamento..."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ferme de Damien GRASSET"
    ]
  },
