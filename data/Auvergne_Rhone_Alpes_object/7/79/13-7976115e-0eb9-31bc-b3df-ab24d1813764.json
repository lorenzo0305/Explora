  "rdfs:comment": {
    "de": [
      "Innerhalb der mittelalterlichen Stadtmauern begleiten Sie kleine und große Geschichten auf Ihrer Entdeckungsreise durch dieses schöne, hochgelegene Dorf, das Schauplatz des früheren Lebens inmitten der Natur ist"
    ],
    "en": [
      "In the medieval enclosure, small and big stories accompany you to the discovery of this beautiful perched village, theater of the life of former days in full nature!"
    ],
    "it": [
      "All'interno delle mura medievali, scoprirete storie grandi e piccole durante l'esplorazione di questo splendido villaggio in cima alla collina, scenario di tempi passati nel cuore della natura!"
    ],
    "fr": [
      "Dans l'enceinte médiévale, petites et grandes histoires vous accompagnent à la découverte de ce beau village perché, théâtre de la vie d'antan en pleine nature!"
    ],
    "es": [
      "Dentro de las murallas medievales, descubrirá grandes y pequeñas historias mientras explora este hermoso pueblo situado en lo alto de una colina, escenario de tiempos pasados en plena naturaleza"
    ],
    "nl": [
      "Binnen de middeleeuwse muren ontdek je grote en kleine verhalen terwijl je dit prachtige dorp op een heuveltop verkent, het toneel van vervlogen tijden in het hart van de natuur!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite commentée du vieil Allan suivie d'une dégustation"
    ]
  },
