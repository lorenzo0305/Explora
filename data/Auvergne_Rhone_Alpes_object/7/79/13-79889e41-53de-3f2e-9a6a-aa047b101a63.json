  "rdfs:comment": {
    "de": [
      "Freie Besichtigung. Dieses Gebäude stammt aus dem 11. und 12. Jahrhundert und wurde im 19. Jahrhundert stark umgebaut. ISMH. Die Apsis in Form eines Cul-de-four ist mit Mitrabögen verziert, die sich mit Rundbögen abwechseln."
    ],
    "en": [
      "Open house. This building dates from the 11th and 12th centuries, and was extensively altered in the 19th century. ISMH. The cul-de-four apse is decorated with mitre arches alternating with semicircular arches."
    ],
    "it": [
      "Visita gratuita. L'edificio risale ai secoli XI e XII ed è stato ampiamente modificato nel XIX secolo. ISMH. L'abside a cul-de-four è decorata da archi a sesto acuto alternati ad archi semicircolari."
    ],
    "fr": [
      "Visite libre. Cet édifice est du XIe et XIIe siècle, très remanié au XIXe siècle. ISMH. L'abside en cul-de-four est ornée d'arcs en mitre alternant avec des arcs en plein cintre."
    ],
    "es": [
      "Visita gratuita. Este edificio data de los siglos XI y XII y fue ampliamente modificado en el siglo XIX. ISMH. El ábside, en forma de cuatro, está decorado con arcos de medio punto que se alternan con arcos de medio punto."
    ],
    "nl": [
      "Gratis bezoek. Dit gebouw dateert uit de 11e en 12e eeuw en werd in de 19e eeuw ingrijpend gewijzigd. ISMH. De cul-de-four apsis is versierd met verstekbogen afgewisseld met halfronde bogen."
    ]
  },
  "rdfs:label": {
