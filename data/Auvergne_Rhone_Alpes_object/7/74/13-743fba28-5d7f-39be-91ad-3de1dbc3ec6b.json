  "rdfs:comment": {
    "de": [
      "Das Kino René Fallet bietet 129 Sitzplätze plus einen barrierefreien Platz, modernste digitale Technik, 3D und kraftvollen 7.1-Raumklang. Ganzjährig geöffnet, zeigt es Filme für alle, Kinderfilme sowie ausgewählte Art-et-Essai-Produktionen. Ein Kinoerlebnis zum Genießen!"
    ],
    "en": [
      "A 129-seat cinema with one wheelchair-accessible space, fully equipped for digital screenings, 3D films and immersive 7.1 surround sound. Open all year round, the cinema offers films for all audiences, children’s screenings and Art & Essay selections. ✨"
    ],
    "it": [
      "Il Cinema René Fallet dispone di 129 posti a sedere più un posto accessibile, con moderne attrezzature digitali, proiezioni in 3D e coinvolgente audio surround 7.1. Aperto tutto l’anno, propone film per tutti, film per bambini e una selezione Art et Essai. Un’esperienza cinematografica da vivere! ✨"
    ],
    "fr": [
      "Salle de 129 places + une PMR, équipée pour les films numériques, en 3D avec un son spatial 7.1 Le cinéma est ouvert toute l'année et propose des séances de films tout public, pour enfants et Art et Essai."
    ],
    "es": [
      "Cine con 129 butacas + una PMR, equipado para películas digitales, en 3D con sonido envolvente 7.1. El cine está abierto todo el año y ofrece películas para todos los públicos, infantiles y de autor."
    ],
    "nl": [
      "Bioscoop met 129 zitplaatsen + een PRM, uitgerust voor digitale films, in 3D met 7.1 surround sound. De bioscoop is het hele jaar geopend en biedt films voor alle doelgroepen, kinderen en arthousefilms."
    ]
  },
  "rdfs:label": {
