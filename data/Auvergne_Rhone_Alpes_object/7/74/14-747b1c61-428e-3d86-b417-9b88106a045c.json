  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/257e4bbe-a897-3361-807e-440b19ace68b",
      "dc:description": {
        "de": [
          "Restaurant \"Sur Mer\": Meeresküchenküche von Alexandre Gauthier. Strandbar, Ambiente und Terrasse mit Meerblick.\nSpezialität: Fisch und Meeresfrüchte. Aperitif auf der Terrasse zum Sonnenuntergang."
        ],
        "en": [
          "Sur Mer\" restaurant: seaside cuisine by Alexandre Gauthier. Beach bar, atmosphere and sea-view terrace.\nFish and seafood specialities. Sunset aperitifs on the terrace."
        ],
        "it": [
          "Ristorante \"Sur Mer\": cucina di mare di Alexandre Gauthier. Bar sulla spiaggia, atmosfera e terrazza con vista sul mare.\nSpecialità di pesce e frutti di mare. Aperitivi al tramonto in terrazza."
        ],
        "fr": [
          "Restaurant \"Sur Mer\" : Cuisine de bord de mer par Alexandre Gauthier. Bar de plage, ambiance et terrasse vue mer.\nSpécialité de poisson et fruits de mer. Apéritif en terrasse pour le coucher de soleil."
        ],
        "es": [
          "Restaurante \"Sur Mer\": cocina marinera de Alexandre Gauthier. Chiringuito, ambiente y terraza con vistas al mar.\nEspecialidades de pescado y marisco. Aperitivos al atardecer en la terraza."
        ],
        "nl": [
          "Restaurant \"Sur Mer\": kustkeuken van Alexandre Gauthier. Strandbar, sfeervol terras met uitzicht op zee.\nVis- en zeevruchtenspecialiteiten. Aperitief bij zonsondergang op het terras."
        ]
      },
