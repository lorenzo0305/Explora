  "rdfs:comment": {
    "de": [
      "Das Maison forte de Cursinges ist ein altes befestigtes Haus aus dem 15. Jahrhundert im gleichnamigen Weiler, dessen Ruinen sich in der Gemeinde Perrignier erheben."
    ],
    "en": [
      "The fortified house of Cursinges is an ancient 14th-century fortified house in the hamlet of Cursinges, whose ruins stand in the commune of Perrignier."
    ],
    "it": [
      "La casa fortificata di Cursinges è un'antica casa fortificata del XIV secolo, situata nell'omonima frazione, le cui rovine si trovano nel comune di Perrignier."
    ],
    "fr": [
      "La maison forte de Cursinges est une ancienne maison forte, du xive siècle, situé au hameau éponyme, dont les ruines se dressent sur la commune de Perrignier"
    ],
    "es": [
      "La casa fortificada de Cursinges es una antigua casa fortificada, del siglo XIV, situada en la aldea del mismo nombre, cuyas ruinas se encuentran en el municipio de Perrignier"
    ],
    "nl": [
      "Het versterkte huis van Cursinges is een oud versterkt huis uit de 14e eeuw, gelegen in het gehucht met dezelfde naam, waarvan de ruïnes in de gemeente Perrignier liggen."
    ]
  },
