  "rdfs:comment": {
    "de": [
      "Andréanne kreiert aus farbigen Glasstäben aus Muranoglas mit der Flamme eines Schneidbrenners ihre Perlen. Ihre Kreationen finden Sie in Ébreuil und Charroux."
    ],
    "en": [
      "Andréanne creates pearls from colorful Murano glass sticks thanks to a blowtorch. You will find her creations in Ebreuil and Charroux."
    ],
    "it": [
      "Andréanne crea le sue perle con la fiamma di un cannello a partire da bacchette di vetro di Murano colorate. Potete trovare le sue creazioni a Ébreuil e Charroux."
    ],
    "fr": [
      "Andréanne, à partir de baguettes de verre coloré de Murano, crée à la flamme d'un chalumeau ses perles. Vous trouverez ses créations à Ébreuil et Charroux."
    ],
    "es": [
