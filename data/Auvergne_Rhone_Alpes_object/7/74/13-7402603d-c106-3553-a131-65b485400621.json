  "rdfs:comment": {
    "de": [
      "Es handelt sich um ein kleines Gebiet, das in drei verschiedene Sektoren unterteilt ist, die die Erfahrung von erfahrenen Kletterern bis hin zu Experten ansprechen sollen."
    ],
    "en": [
      "It's a small site divided into three distinct sectors, designed to delight the experience of experienced to expert climbers."
    ],
    "it": [
      "Si tratta di un piccolo sito diviso in tre settori distinti, progettato per deliziare l'esperienza degli arrampicatori esperti e non."
    ],
    "fr": [
      "Il s’agit d’un petit site étagé en trois secteurs distincts, destinés à ravir l’expérience des grimpeurs confirmés à experts."
    ],
    "es": [
      "Se trata de un pequeño sitio dividido en tres sectores distintos, diseñados para deleitar la experiencia de escaladores experimentados a expertos."
    ],
    "nl": [
      "Dit is een kleine site verdeeld in drie verschillende sectoren, ontworpen om de ervaring van ervaren klimmers tot expert klimmers te verrukken."
    ]
  },
