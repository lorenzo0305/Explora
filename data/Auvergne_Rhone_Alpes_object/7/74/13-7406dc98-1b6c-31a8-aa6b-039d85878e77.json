  "rdfs:comment": {
    "de": [
      "Die zwischen Saint-Ismier und Le Versoud gelegene Freizeitanlage Bois Français ist das wichtigste stadtnahe Naturgebiet der Region. Dieser Ort bietet je nach Jahreszeit eine Vielzahl von Aktivitäten (Wassersport, Baden, Wandern...)."
    ],
    "en": [
      "Located between Saint-Ismier and Le Versoud, the Bois Français leisure park is the region's largest peri-urban natural site. Depending on the season, the site offers a multitude of activities (water sports, swimming, walking, etc.)."
    ],
    "it": [
      "Situato tra Saint-Ismier e Le Versoud, il centro ricreativo Bois Français è il sito naturale più importante della regione. A seconda della stagione, questo sito offre una moltitudine di attività (sport acquatici, nuoto, passeggiate, ecc.)."
    ],
    "fr": [
      "Située entre Saint-Ismier et le Versoud, la base de loisirs du Bois Français constitue le plus important site naturel périurbain de la région. Ce site propose en fonction des saisons une multitude d'activités (sports nautiques, baignade, promenade...)."
    ],
    "es": [
      "Situado entre Saint-Ismier y Le Versoud, el centro de ocio Bois Français es el sitio natural más importante de la región. Dependiendo de la temporada, este lugar ofrece multitud de actividades (deportes acuáticos, natación, senderismo, etc.)."
    ],
    "nl": [
      "Het Bois Français, gelegen tussen Saint-Ismier en Le Versoud, is het grootste peri-urbane natuurgebied van de regio. Afhankelijk van het seizoen biedt de camping een breed scala aan activiteiten (watersporten, zwemmen, wandelen, enz.)."
    ]
  },
