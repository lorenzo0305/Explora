  "rdfs:comment": {
    "de": [
      "Geführte und thematische Wanderungen im Sommer und Schneeschuhwanderungen im Winter. Lassen Sie sich von uns auf den herrlichen Wanderwegen in den Bergen des Vallée d'Aulps führen!"
    ],
    "en": [
      "Guided themed walks in summer and snow shoe walking in winter. Let us guide you along magnificent hiking paths in the Valley d’Aulps mountains!"
    ],
    "it": [
      "Escursioni guidate e tematiche in estate e ciaspolate in inverno. Lasciatevi guidare sui magnifici sentieri della Vallée d'Aulps!"
    ],
    "fr": [
      "Randonnées guidées et thématiques en été et raquettes en hiver. Laissez-nous vous guider sur les magnifiques sentiers de randonnée des montagnes de la Vallée d'Aulps !"
    ],
    "es": [
      "Caminatas guiadas y temáticas en verano y con raquetas de nieve en invierno. Déjese guiar por las magníficas rutas de senderismo de las montañas del Valle de Aulps"
    ],
    "nl": [
      "Begeleide en thematische wandelingen in de zomer en sneeuwschoenwandelingen in de winter. Laat ons u begeleiden op de prachtige wandelpaden van de Vallée d'Aulps!"
    ]
  },
