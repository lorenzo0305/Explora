  "rdfs:comment": {
    "de": [
      "Sommerschwimmbad mit Kinderplanschbecken, Schwimmbecken in einer grünen Umgebung. Beaufsichtigung durch einen Bademeister. Angrenzender Strand und Grünfläche. Kinderspielplatz, Angelteich, Wanderwege."
    ],
    "en": [
      "Summer swimming pool with paddling pool for children, swimming pool in a green setting. Supervised by a lifeguard. Beach and adjoining green area. Children's playground, fishing pond, hiking trails."
    ],
    "it": [
      "Piscina estiva con vasca per bambini, piscina immersa nel verde. Supervisione da parte di un bagnino. Spiaggia e spazio verde adiacente. Parco giochi per bambini, laghetto per la pesca, sentieri escursionistici."
    ],
    "fr": [
      "Piscine d'été avec pataugeoire pour enfants, bassin de natation dans un cadre verdoyant. Surveillance assurée par un maître-nageur. Plage et espace vert attenant. Aire de jeux pour enfants, étang de pêche, sentiers de randonnée."
    ],
    "nl": [
      "Zomerzwembad met kikkerbad voor kinderen, zwembad in een groene omgeving. Toezicht door een badmeester. Strand en aangrenzende groene ruimte. Kinderspeelplaats, visvijver, wandelpaden."
    ],
    "es": [
      "Piscina de verano con piscina infantil, piscina en un entorno verde. Supervisión de un socorrista. Playa y espacio verde contiguo. Parque infantil, estanque de pesca, rutas de senderismo."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Piscine municipale"
    ]
  },
