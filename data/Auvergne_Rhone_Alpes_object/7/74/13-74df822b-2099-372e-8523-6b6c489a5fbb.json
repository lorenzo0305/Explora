  "rdfs:comment": {
    "de": [
      "Sie bietet ein hochwertiges Spa-Erlebnis zu Hause in der Haute-Savoie: Massagen, Gesichtsbehandlungen und andere Wellnessleistungen, individuell und natürlich, für tiefe Entspannung und einen Moment nur für Sie."
    ],
    "en": [
      "She offers a high-end home spa experience in Haute-Savoie: massages, facials, and other wellness services, personalized and natural, for deep relaxation and a moment just for you."
    ],
    "it": [
      "Offre un'esperienza di spa a domicilio di alta gamma in Alta Savoia: massaggi, trattamenti viso e altri servizi di benessere naturali e personalizzati per un profondo relax e un momento tutto per sé."
    ],
    "fr": [
      "Elle propose une expérience spa haut de gamme à domicile en Haute-Savoie : massages, soins du visage et autres services bien-être, personnalisés et naturels, pour une relaxation profonde et un moment rien que pour vous."
    ],
    "nl": [
      "Ze biedt een eersteklas thuis-wellnesservaring in de Haute-Savoie: massages, gezichtsbehandelingen en andere gepersonaliseerde, natuurlijke welzijnsdiensten voor diepe ontspanning en een moment voor jezelf."
    ],
    "es": [
      "Ofrece una experiencia de spa de alta gama a domicilio en Alta Saboya: masajes, tratamientos faciales y otros servicios de bienestar, personalizados y naturales, para una relajación profunda y un momento solo para ti"
    ]
  },
  "rdfs:label": {
