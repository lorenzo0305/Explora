  "rdfs:comment": {
    "de": [
      "Die Touristeninformation von Lezoux empfängt Sie im Herzen des Keramikmuseums von Juni bis Ende September donnerstags und freitags. Den Rest des Jahres können Sie uns am Donnerstagmorgen antreffen."
    ],
    "en": [
      "The Lezoux tourist information point welcomes you to the heart of the Musée de la Céramique from June to the end of September on Thursdays and Fridays. The rest of the year, you can meet us on Thursday mornings."
    ],
    "it": [
      "Il punto di informazione turistica di Lezoux vi accoglie nel cuore del Musée de la Céramique da giugno a fine settembre, il giovedì e il venerdì. Per il resto dell'anno, ci si può incontrare il giovedì mattina."
    ],
    "fr": [
      "Le point d'information touristique de Lezoux vous accueille au cœur du Musée de la Céramique de juin à fin septembre le jeudi et le vendredi. Le restant de l'année vous pourrez nous rencontrer le jeudi matin."
    ],
    "nl": [
      "Het toeristisch informatiepunt van Lezoux verwelkomt je in het hart van het Musée de la Céramique van juni tot eind september op donderdag en vrijdag. De rest van het jaar kun je ons op donderdagochtend ontmoeten."
    ],
    "es": [
      "El punto de información turística de Lezoux le recibe en el corazón del Museo de la Cerámica de junio a finales de septiembre, los jueves y viernes. El resto del año, puede encontrarnos los jueves por la mañana."
    ]
  },
