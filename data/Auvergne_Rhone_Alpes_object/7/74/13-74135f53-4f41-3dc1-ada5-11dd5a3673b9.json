  "rdfs:comment": {
    "de": [
      "Das Paradis kann man auch mit dem Schlitten hinunterfahren! Fahren Sie mit dem Colorado-Schlitten über 1500 Meter hinunter und genießen Sie dabei den Blick auf den Mont-Blanc."
    ],
    "en": [
      "Sledging in Paradise ! One mile sledge run with the most spectacular view on the highest mountain in Europe : Le Mont-Blanc."
    ],
    "it": [
      "Il Paradiso può essere sceso anche in slitta! Scendete di oltre 1500 metri con il Colorado Luge, con il vantaggio di una vista sul Monte Bianco."
    ],
    "fr": [
      "Le Paradis se descend aussi en luge ! Dévalez plus de 1500 mètres sur le Colorado Luge,avec en prime la vue sur le Mont-Blanc."
    ],
    "es": [
      "El Paradiso también se puede bajar en trineo Descienda más de 1.500 metros en el trineo de Colorado, con la ventaja añadida de ver el Mont Blanc."
    ],
    "nl": [
      "De afdaling van Le Paradis kan ook op een slede !  Op een Colorado slede in volle vaart 1500 meter naar beneden glijden, met als premie een prachtig uitzicht op de Mont-Blanc... geweldig !"
    ]
  },
