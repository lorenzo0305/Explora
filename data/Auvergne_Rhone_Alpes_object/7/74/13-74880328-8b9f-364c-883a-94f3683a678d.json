  "rdfs:comment": {
    "de": [
      "Schlendern Sie bei Ihrem Besuch durch die Designerboutique, entdecken Sie ein kulturelles Programm und Ausstellungen im Laufe der Jahreszeiten und verlängern Sie Ihren Aufenthalt mit einem Besuch des Village de Caractère, das am Ufer der Loire liegt."
    ],
    "en": [
      "Take a stroll through our designer boutique, discover our cultural program and seasonal exhibitions, and visit the Village de Caractère on the banks of the Loire."
    ],
    "it": [
      "Durante la visita, passeggiate nella boutique di design, scoprite il programma culturale e le mostre che cambiano a seconda delle stagioni e continuate il vostro tour con una visita al Village de Caractère sulle rive della Loira."
    ],
    "fr": [
      "Lors de votre visite, flânez dans la boutique de créateurs, découvrez une programmation culturelle et des expositions au fil des saisons et prolongez par la visite du Village de Caractère situé en bord de Loire."
    ],
    "nl": [
      "Wandel tijdens je bezoek door de designerboetiek, ontdek het culturele programma en de tentoonstellingen die met de seizoenen veranderen, en vervolg je tocht met een bezoek aan Village de Caractère aan de oevers van de Loire."
    ],
    "es": [
      "Durante su visita, pasee por la boutique de diseño, descubra el programa cultural y las exposiciones que cambian con las estaciones, y continúe su recorrido con una visita al Village de Caractère, a orillas del Loira."
    ]
  },
  "rdfs:label": {
    "fr": [
