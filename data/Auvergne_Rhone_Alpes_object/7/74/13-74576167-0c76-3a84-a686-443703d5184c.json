  "rdfs:comment": {
    "de": [
      "Warum ein Brunnen mit Elefanten? Hat Kleon von Andran Elefanten gesehen, die aus einem Märchen aus Tausendundeiner Nacht entsprungen sind?"
    ],
    "en": [
      "Why a fountain with elephants? Did Cleon d'Andran see elephants crossing his path, straight out of a tale from the Arabian Nights?"
    ],
    "it": [
      "Perché una fontana con gli elefanti? Cleon d'Andran avrebbe visto degli elefanti attraversare il suo cammino direttamente da una fiaba?"
    ],
    "fr": [
      "Pourquoi une fontaine avec des éléphants? Cléon d'andran aurait-il vu traversé des éléphants tous droit sorti d'un conte des milles et une nuit?"
    ],
    "es": [
      "¿Por qué una fuente con elefantes? ¿Habría visto Cleon d'Andran a los elefantes cruzarse en su camino sacados de un cuento de hadas?"
    ],
    "nl": [
      "Waarom een fontein met olifanten? Zag Cleon d'Andran olifanten zijn pad kruisen, rechtstreeks uit een sprookje uit de Arabische Nachten?"
    ]
  },
  "rdfs:label": {
    "fr": [
      "la fontaine des éléphants"
    ]
  },
