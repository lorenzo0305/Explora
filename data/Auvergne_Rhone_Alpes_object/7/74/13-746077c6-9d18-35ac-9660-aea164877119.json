  "rdfs:comment": {
    "de": [
      "Das Office de la Culture et de l'Animation (OCA) ist ein Verein in Bonneville, der jedes Jahr eine Kultursaison und ganzjährige Aktivitäten für Jung und Alt anbietet."
    ],
    "en": [
      "The Office of Culture and Entertainment (OCA) is a Bonneville-based association which organises every year a season of cultural events as well as activities throughout the year for children and grown-ups."
    ],
    "it": [
      "L'Office de la Culture et de l'Animation (OCA) è un'associazione locale che offre una stagione culturale e attività tutto l'anno per grandi e piccini."
    ],
    "fr": [
      "L'Office de la Culture et de l'Animation (OCA) est une association bonnevilloise qui propose chaque année une saison culturelle et des activités toute l'année pour petits et grands."
    ],
    "es": [
      "La Oficina de la Cultura y la Animación (OCA) es una asociación local que ofrece una temporada cultural y actividades durante todo el año para jóvenes y mayores."
    ],
    "nl": [
      "Het Office de la Culture et de l'Animation (OCA) is een plaatselijke vereniging die het hele jaar door een cultureel seizoen en activiteiten aanbiedt voor jong en oud."
    ]
  },
