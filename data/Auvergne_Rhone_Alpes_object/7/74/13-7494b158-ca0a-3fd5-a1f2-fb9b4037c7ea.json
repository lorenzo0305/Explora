  "rdfs:comment": {
    "de": [
      "Für alle Liebhaber der guten italienischen Küche! Zögern Sie nicht länger, Sie haben Ihr Glück gefunden. Wir sind die Spezialisten. Unser bester Trumpf ist Ihr gut gefüllter Bauch, wenn Sie bei uns aus dem Haus gehen!"
    ],
    "en": [
      "For all lovers of good Italian food!"
    ],
    "it": [
      "Per tutti gli amanti della buona cucina italiana! Non esitate, avete trovato quello che cercate. Noi siamo gli specialisti. Il nostro miglior pregio: la pancia piena quando lasciate il nostro locale!"
    ],
    "fr": [
      "Pour tous les amoureux de la bonne cuisine italienne ! N'hésitez plus vous avez trouvé votre bonheur. Nous sommes les spécialistes. Notre meilleur atout, votre ventre bien rempli quand vous sortez de chez nous !"
    ],
    "nl": [
      "Voor alle liefhebbers van lekker Italiaans eten! Aarzel niet, je hebt gevonden wat je zocht. Wij zijn de specialisten. Onze beste troef: een volle buik als je ons pand verlaat!"
    ],
    "es": [
      "Para todos los amantes de la buena comida italiana!"
    ]
  },
