  "rdfs:comment": {
    "de": [
      "Le Baroscope, ein Café-Restaurant im Herzen von Pélussin, empfängt Sie zu jeder Jahreszeit, um hausgemachte Gerichte zu essen und handwerklich hergestellte, lokale und oftmals biologische Getränke zu entdecken."
    ],
    "en": [
      "Le Baroscope, a café-restaurant in the heart of Pélussin, welcomes you all year round for home-cooked meals and local, often organic, drinks."
    ],
    "it": [
      "Le Baroscope, un caffè-ristorante nel cuore di Pélussin, vi accoglie tutto l'anno per gustare pasti fatti in casa e bevande artigianali, locali e spesso biologiche."
    ],
    "fr": [
      "Le Baroscope, café restaurant au coeur de Pélussin, vous accueille en toutes saison pour manger des plats faits maison et découvrir des boissons artisanales, locales et souvent bio."
    ],
    "es": [
      "Le Baroscope, un café-restaurante en el corazón de Pélussin, le da la bienvenida todo el año para ofrecerle comidas caseras y bebidas caseras, locales y a menudo ecológicas."
    ],
    "nl": [
      "Le Baroscope, een café-restaurant in het hart van Pélussin, verwelkomt je het hele jaar door voor huisgemaakte maaltijden en huisgemaakte, lokale en vaak biologische drankjes."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Baroscope"
    ]
  },
