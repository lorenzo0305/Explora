  "rdfs:comment": {
    "de": [
      "Eine gemütliche Designadresse für Lyoner, aber auch für Hotelgäste. Eine authentische und leckere Marktküche, hausgemachte Gerichte mit lokalen, frischen und saisonalen Produkten."
    ],
    "en": [
      "A warm, designer address for locals and hotel guests alike. Authentic, gourmet market cuisine, home-cooked dishes made with fresh, seasonal local produce."
    ],
    "it": [
      "Un indirizzo caldo e di design per gli abitanti del luogo e per gli ospiti dell'hotel. Autentica cucina gourmet del mercato, piatti fatti in casa con prodotti locali freschi e di stagione."
    ],
    "fr": [
      "Une adresse design et chaleureuse pour les Lyonnais mais aussi les clients de l’hôtel. Une cuisine du marché authentique et gourmande, des plats préparés maison avec des produits locaux, frais et de saison."
    ],
    "es": [
      "Una dirección cálida y de diseño tanto para los lugareños como para los huéspedes del hotel. Auténtica cocina gourmet de mercado, platos caseros elaborados con productos locales frescos y de temporada."
    ],
    "nl": [
      "Een warm, design adres voor de lokale bevolking en hotelgasten. Authentieke, gastronomische marktkeuken, huisgemaakte gerechten met verse, seizoensgebonden lokale producten."
    ]
  },
