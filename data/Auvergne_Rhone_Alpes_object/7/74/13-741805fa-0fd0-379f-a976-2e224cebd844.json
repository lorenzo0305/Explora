  "rdfs:comment": {
    "de": [
      "Frau und Herr Gallay, Küchenchef, bieten Ihnen im klimatisierten Saal oder auf der Terrasse eine traditionelle Küche mit Produkten aus der Region. Abends auf Reservierung. Empfang von Gruppen, Familienessen ..."
    ],
    "en": [
      "Mrs Gallay and the Chef Mr Gallay offer a traditional cuisine based on local terroir products, in an air-conditioned room or on the terrace. Dinners by booking. We welcome groups, family gatherings...."
    ],
    "it": [
      "Gli chef Mme e M. Gallay propongono una cucina tradizionale a base di prodotti locali, in una sala da pranzo climatizzata o sulla terrazza. Serate su prenotazione. Gruppi benvenuti, pasti in famiglia..."
    ],
    "fr": [
      "Mme et M. Gallay, chef de cuisine, vous proposent une cuisine traditionnelle à base de produits du terroir, en salle climatisée ou en terrasse. Le soir sur réservation. Accueil de groupes, repas de famille..."
    ],
    "es": [
      "Mme y M. Gallay, chefs, proponen una cocina tradicional a base de productos locales, en un comedor climatizado o en la terraza. Veladas concertadas. Acogida de grupos, comidas familiares..."
    ],
    "nl": [
      "Chef Gallay en zijn echtgenote staan voor een traditionele keuken op basis van specialiteiten uit de streek. Zaal met airco of eten op het terras. 's Avonds op reservering. Groepen, familiebijeenkomsten, alles kan."
    ]
  },
