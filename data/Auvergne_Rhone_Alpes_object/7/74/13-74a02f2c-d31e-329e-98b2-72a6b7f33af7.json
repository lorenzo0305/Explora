  "rdfs:comment": {
    "de": [
      "Die unter Naturschutz stehende Parzelle umfasst eine Fläche von fast 30 ha und umfasst eine 310 m lange Höhle (in der 7 Fledermausarten leben) sowie einen Teil des umliegenden Waldes (felsige Bereiche, Garrigue, Eichen- und Pinienwälder...)."
    ],
    "en": [
      "The classified parcel covers an area of almost 30 ha and includes a 310 m-long cave (home to 7 species of bat) as well as part of the surrounding forest (rocky areas, scrubland, oak and pine woods...)."
    ],
    "it": [
      "L'area classificata si estende su una superficie di quasi 30 ettari e comprende una grotta lunga 310 m (che ospita 7 specie di pipistrelli) e parte della foresta circostante (aree rocciose, macchia, boschi di querce e pini, ecc.)."
    ],
    "fr": [
      "La parcelle classée couvre une superficie de près de 30 ha et englobe une grotte de 310 m de long (accueillant 7 espèces de chauve-souris) ainsi qu'une partie de la forêt environnante (zones rocheuses, garrigues, boisements de chênes et de pins...)."
    ],
    "es": [
      "La zona clasificada tiene una superficie de casi 30 ha e incluye una cueva de 310 m de longitud (que alberga 7 especies de murciélagos), así como parte del bosque circundante (zonas rocosas, matorrales, bosques de robles y pinos, etc.)."
    ],
    "nl": [
      "Het beschermde gebied beslaat bijna 30 ha en omvat een 310 m lange grot (waar 7 soorten vleermuizen leven) en een deel van het omringende bos (rotsachtige gebieden, struikgewas, eiken- en dennenbossen, etc.)."
    ]
  },
