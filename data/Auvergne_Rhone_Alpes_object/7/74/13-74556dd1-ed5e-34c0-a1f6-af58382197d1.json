  "rdfs:comment": {
    "de": [
      "Das Château Les Oliviers de Salettes begrüßt Sie auf einem Anwesen von außergewöhnlicher Schönheit inmitten der einzigartigen Landschaften der Drôme Provençale."
    ],
    "en": [
      "Set in an exceptionally beautiful estate, Château Les Oliviers de Salettes ***** welcomes you to the heart of the unique landscapes of the Drôme Provençale."
    ],
    "it": [
      "Situato in una tenuta di eccezionale bellezza, Le Cha?teau Les Oliviers de Salettes ***** vi accoglie nel cuore dei paesaggi unici del Dro?me Provenc ale. Partecipate a un viaggio gastronomico sottile, colorato ed erbaceo a 1 stella MICHELIN."
    ],
    "fr": [
      "Implanté sur un domaine d’une beauté exceptionnelle, Le Château Les Oliviers de Salettes ***** vous accueille au cœur des paysages uniques de la Drôme Provençale. Prenez part à un voyage gastronomique subtile, coloré et herbacé 1 étoile MICHELIN."
    ],
    "es": [
      "Situado en una finca de excepcional belleza, Le Cha?teau Les Oliviers de Salettes ***** le da la bienvenida al corazón de los paisajes únicos de la Dro?me provenzal. Participe en un viaje gastronómico sutil, colorista y herbáceo de 1 estrella MICHELIN."
    ],
    "nl": [
      "Château Les Oliviers de Salettes ligt op een gebied van uitzonderlijke schoonheid en heet u welkom in het hart van de unieke landschappen van de Drôme Provençale."
    ]
  },
