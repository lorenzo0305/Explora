  "rdfs:comment": {
    "de": [
      "Sinnliche Familientour mit Mediator: Waldgeräusche, Vogelstimmen und das Leben der Palawan lassen Groß und Klein in das Tal der Tau?t Batu eintauchen, um die Natur zu spüren und anders zu sehen."
    ],
    "en": [
      "A sensory tour for the whole family with a mediator: forest sounds, bird songs and the life of the Palawan people immerse young and old alike in the Tau?t Batu valley to experience nature and see things differently."
    ],
    "it": [
      "Un tour sensoriale per tutta la famiglia con una guida: i suoni della foresta, i canti degli uccelli e la vita degli abitanti di Palawan immergono grandi e piccini nella valle di Tau?t Batu per vivere la natura in modo diverso."
    ],
    "fr": [
      "Visite sensorielle en famille avec médiateur : sons de la forêt, chants d’oiseaux et vie des Palawan plongent petits et grands dans la vallée des Tau’t Batu pour ressentir la nature et voir autrement."
    ],
    "es": [
      "Una excursión sensorial para toda la familia con guía: los sonidos del bosque, los cantos de los pájaros y la vida de los palawanenses sumergen a pequeños y mayores en el valle de Taušt Batu para vivir la naturaleza de otra manera."
    ],
    "nl": [
      "Een zintuiglijke tocht voor het hele gezin met een gids: de geluiden van het bos, het gezang van de vogels en het leven van de Palawan bevolking dompelen jong en oud onder in de Tau't Batu vallei om de natuur op een andere manier te ervaren."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite sonore - Les voix de la Vallée"
    ]
  },
