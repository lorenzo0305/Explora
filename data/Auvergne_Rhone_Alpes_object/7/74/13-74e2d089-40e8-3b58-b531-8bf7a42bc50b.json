  "rdfs:comment": {
    "de": [
      "Bei yogaetcterra findet Yoga dort statt, wo du dich wohlfühlst: zu Hause, im Urlaub oder wo auch immer du deine Matte auslegst - immer mit den Bergen als Kulisse!"
    ],
    "en": [
      "At yogaetcterra, yoga comes to where you feel good: at home, on vacation, or anywhere you lay down your mat—with the mountains as your backdrop!"
    ],
    "it": [
      "A yogaetcterra lo yoga si fa ovunque ci si senta a proprio agio: a casa, in vacanza o ovunque si poggi il tappetino, sempre con le montagne come sfondo!"
    ],
    "fr": [
      "Chez yogaetcterra, le yoga s’invite là où vous êtes bien : chez vous, en vacances, ou n’importe où vous poserez votre tapis, toujours avec la montagne pour décor !"
    ],
    "es": [
      "Con yogaetcterra, el yoga va donde tú estés bien: en casa, de vacaciones o en cualquier lugar donde pongas tu esterilla, ¡siempre con la montaña de fondo!"
    ],
    "nl": [
      "Bij yogaetcterra is yoga overal waar je je prettig voelt: thuis, op vakantie of waar je je matje ook neerlegt - altijd met de bergen als achtergrond!"
    ]
  },
