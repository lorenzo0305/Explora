  "rdfs:comment": {
    "de": [
      "Im Herzen eines alten Steingebäudes, das in einem Nebengebäude des Schlosses Chambon eingerichtet wurde, bietet Ihnen Au Champs Bonheur einen Empfangsraum für Ihre Hochzeiten und Veranstaltungen in einem fabelhaften Rahmen, der von einer geschützten Natur umgeben ist."
    ],
    "en": [
      "In the heart of an old stone building, converted into an outbuilding of the Château du Chambon, Au Champs Bonheur offers you a reception room for your weddings and events, in a fabulous setting surrounded by unspoilt nature."
    ],
    "it": [
      "Nel cuore di un antico edificio in pietra, trasformato in una dependance del Château du Chambon, Au Champs Bonheur vi offre una sala ricevimenti per i vostri matrimoni ed eventi, in un ambiente favoloso circondato da una natura incontaminata."
    ],
    "fr": [
      "Au coeur d'une ancienne bâtisse en pierres, aménagée dans une dépendance du château du Chambon, au Champs Bonheur vous propose une salle de réception pour vos mariages, événements, dans un cadre fabuleux entouré d'une nature préservée."
    ],
    "nl": [
      "In het hart van een oud stenen gebouw, omgebouwd tot bijgebouw van het Château du Chambon, biedt Au Champs Bonheur u een receptieruimte voor uw bruiloften en evenementen, in een prachtige omgeving midden in de ongerepte natuur."
    ],
    "es": [
      "En el corazón de un antiguo edificio de piedra, convertido en dependencia del Château du Chambon, Au Champs Bonheur le ofrece una sala de recepciones para sus bodas y eventos, en un entorno fabuloso rodeado de naturaleza virgen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Salle au Champ Bonheur"
    ]
  },
