  "rdfs:comment": {
    "de": [
      "Saint-Jean-de-Maurienne liegt im Herzen des Maurienne-Tals, dem südlichsten der großen Quertäler in Savoyen."
    ],
    "en": [
      "Saint-Jean-de-Maurienne is located in the heart of the Maurienne valley, the southernmost of Savoie's major transverse valleys."
    ],
    "it": [
      "Saint-Jean-de-Maurienne si trova nel cuore della valle della Maurienne, la più meridionale delle grandi valli trasversali della Savoia."
    ],
    "fr": [
      "Saint-Jean-de-Maurienne est située au cœur de la vallée de la Maurienne, la plus méridionale des grandes vallées transversales de la Savoie."
    ],
    "nl": [
      "Saint-Jean-de-Maurienne ligt in het hart van de Maurienne-vallei, de meest zuidelijke van de grote transversale valleien van de Savoie."
    ],
