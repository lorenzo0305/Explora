      "openingDetails": {
        "de": [
          "Um 10:30 Uhr\n(Im Rahmen des multisensorischen Wochenendes)\nAlte Präsenzen ? Neue Kreationen\nAusgehend von dem Werk Ensemble von sieben Figuren, Byblos (heute Jbeil, Libanon), 800 bis 100 v. Chr."
        ],
        "en": [
          "At 10:30 a.m\n(As part of the multi-sensory weekend)\nAncient presences ? New creations\nFrom the work Set of seven figurines, Byblos (present-day Jbeil, Lebanon), 800 to 100 B.C."
        ],
        "it": [
          "Alle 10.30\n(Nell'ambito del weekend multisensoriale)\nAntiche presenze? Nuove creazioni\nTratto dall'opera Set di sette statuette, Byblos (attuale Jbeil, Libano), 800 - 100 a.C."
        ],
        "fr": [
          "A 10h30\n(Dans le cadre du week-end multi-sensoriel)\nPrésences anciennes – Créations nouvelles\nÀ partir de l’œuvre Ensemble de sept figurines, Byblos (actuelle Jbeil, Liban), 800 à 100 avant J.-C."
        ],
        "nl": [
          "Om 10.30 uur\n(Als onderdeel van het multisensoriële weekend)\nOude aanwezigheden ? Nieuwe creaties\nGebaseerd op het werk Set van zeven beeldjes, Byblos (het huidige Jbeil, Libanon), 800 tot 100 voor Christus."
        ],
        "es": [
          "A las 10.30 h\n(En el marco del fin de semana multisensorial)\nPresencias antiguas ? Nuevas creaciones\nBasado en la obra Conjunto de siete figurillas, Biblos (actual Jbeil, Líbano), 800-100 a.C."
        ]
      },
      "startDate": "2026-02-14"
