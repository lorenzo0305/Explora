  "rdfs:comment": {
    "de": [
      "Möchten Sie die Fotografie entdecken, Ihre Kenntnisse erweitern oder die Welt aus einem anderen Blickwinkel erkunden? Meine maßgeschneiderten Workshops bieten eine unterhaltsame und immersive Erfahrung, um Ihr Lernen direkt vor Ort zu beschleunigen"
    ],
    "en": [
      "Would you like to discover photography, enrich your knowledge or explore the world from a different angle? My tailor-made workshops offer a fun, immersive experience to accelerate your learning directly in the field."
    ],
    "it": [
      "Volete scoprire la fotografia, arricchire le vostre conoscenze o esplorare il mondo da una prospettiva diversa? I miei workshop su misura offrono un'esperienza divertente e coinvolgente per accelerare il vostro apprendimento direttamente sul campo"
    ],
    "fr": [
      "Vous souhaitez découvrir la photographie, enrichir vos connaissances ou explorer le monde sous un angle différent? Mes ateliers conçus sur mesure, offrent une expérience amusante et immersive pour accélérer votre apprentissage directement sur le terrain"
    ],
    "es": [
      "¿Le gustaría descubrir la fotografía, enriquecer sus conocimientos o explorar el mundo desde un ángulo diferente? Mis talleres a medida ofrecen una experiencia divertida y envolvente para acelerar tu aprendizaje directamente sobre el terreno"
    ],
    "nl": [
      "Wil je fotografie ontdekken, je kennis verrijken of de wereld van een andere kant bekijken? Mijn op maat gemaakte workshops bieden een leuke en meeslepende ervaring om je leerproces direct in het veld te versnellen."
    ]
  },
  "rdfs:label": {
    "en": [
