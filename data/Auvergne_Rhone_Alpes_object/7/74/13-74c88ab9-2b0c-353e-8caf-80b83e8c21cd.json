  "rdfs:comment": {
    "de": [
      "Im Restaurant La Pause de Pierrette ist das Prinzip immer dasselbe: eine bewusst kurz gehaltene Speisekarte, auf der alles hausgemacht, minutengenau und aus frischen Zutaten hergestellt wird."
    ],
    "en": [
      "At La Pause de Pierrette, the principle is always the same: a deliberately short menu where everything is homemade and freshly prepared."
    ],
    "it": [
      "Al ristorante La Pause de Pierrette, il principio è sempre lo stesso: un menu volutamente breve, dove tutto è fatto in casa, preparato al momento."
    ],
    "fr": [
      "Au restaurant La Pause de Pierrette le principe est toujours le même : une carte volontairement courte, où tout est fait maison, minute et à partir de produits frais."
    ],
    "nl": [
      "In La Pause de Pierrette restaurant is het principe altijd hetzelfde: een bewust kort menu, waar alles huisgemaakt en vers bereid is."
    ],
    "es": [
      "En el restaurante La Pause de Pierrette, el principio es siempre el mismo: una carta deliberadamente corta, donde todo es casero, recién preparado."
    ]
