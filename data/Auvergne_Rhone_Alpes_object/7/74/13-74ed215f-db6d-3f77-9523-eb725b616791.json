  "rdfs:comment": {
    "de": [
      "Die Domaine Désormière ist ein Familienbetrieb mit 19 ha Weinbergen. Eric und Thierry haben die Nachfolge ihres Vaters Michel angetreten. Sie bieten Ihnen ihre Weiß-, Rosé-, Schaum- und Rotweine an, die größtenteils aus der AOC Côte Roannaise stammen."
    ],
    "en": [
      "Domaine Désormière is a family business with 19 ha of vines. Eric and Thierry took over from their father Michel. They offer white, rosé, sparkling and red wines, most of them AOC Côte Roannaise."
    ],
    "it": [
      "Il Domaine Désormière è un'azienda familiare con 19 ettari di vigneti. Eric e Thierry hanno preso il posto del padre Michel. Vi offrono i loro vini bianchi, rosati, spumanti e rossi, la maggior parte dei quali sono AOC Côte Roannaise."
    ],
    "fr": [
      "Le Domaine Désormière est une exploitation familiale de 19 ha de vignes. Eric et Thierry ont succédé à leur père Michel. Ils vous proposent leurs vins blancs, rosés, pétillants et rouges pour la plupart en AOC Côte Roannaise."
    ],
    "nl": [
      "Domaine Désormière is een familiebedrijf met 19 hectare wijngaarden. Eric en Thierry hebben het overgenomen van hun vader Michel. Ze bieden je hun witte, rosé, mousserende en rode wijnen, waarvan de meeste AOC Côte Roannaise zijn."
    ],
    "es": [
      "Domaine Désormière es una empresa familiar con 19 hectáreas de viñedos. Eric y Thierry tomaron el relevo de su padre Michel. Le ofrecen sus vinos blancos, rosados, espumosos y tintos, la mayoría de los cuales son AOC Côte Roannaise."
    ]
  },
  "rdfs:label": {
