  "rdfs:comment": {
    "de": [
      "Entdecken Sie eine raffinierte thailändische und vietnamesische Küche. Dieses asiatische Restaurant empfängt Sie in einem gemütlichen Rahmen und bietet Ihnen eine feine und authentische Küche."
    ],
    "en": [
      "The Bee Mai is a cuisine based on fresh quality products to delight you from the entrance to the dessert."
    ],
    "it": [
      "Venite a scoprire una raffinata cucina thailandese e vietnamita. Questo ristorante asiatico vi accoglie in un ambiente caldo e vi offre una cucina raffinata e autentica."
    ],
    "fr": [
      "Venez découvrir une cuisine thaïlandaise et vietnamienne raffinée. Ce restaurant asiatique  vous accueille dans un cadre chaleureux et vous propose une cuisine fine et authentique."
    ],
    "es": [
      "Venga a descubrir la cocina tailandesa y refinada viétnamienne. Su restaurante asiático le da la bienvenida en un ambiente acogedor y le ofrece una cocina fina y auténtica."
    ],
    "nl": [
      "Kom en ontdek een verfijnde Thaise en Vietnamese keuken. Dit Aziatische restaurant verwelkomt u in een warm kader en biedt u een fijne en authentieke keuken."
    ]
  },
