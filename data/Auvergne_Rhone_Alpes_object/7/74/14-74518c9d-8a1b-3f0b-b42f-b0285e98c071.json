  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/4fd12803-024a-36a5-912d-c86bb1248e8d",
      "dc:description": {
        "de": [
          "Folgen Sie mit Ihrer Familie einem sanften Spaziergang zwischen Kunst & Natur! Eine Geschichte von Feen und Hexen, die die Halde und ihre Naturschätze im Spiel mit den Sinnen entdecken lässt."
        ],
        "en": [
          "Take the whole family on a gentle stroll through Art & Nature! A story of fairies and witches that lets you discover the slag heap and its natural riches while playing with your senses."
        ],
        "it": [
          "Una dolce passeggiata per tutta la famiglia tra arte e natura! Una storia di fate e streghe che permette di scoprire il cumulo di scorie e le sue ricchezze naturali giocando con i sensi."
        ],
        "fr": [
          "En famille, suivez une balade tout en douceur entre Art & Nature ! Une histoire de fées et de sorcières qui fait découvrir le terril et ses richesses naturelles en jouant avec les sens."
        ],
        "nl": [
          "Neem het hele gezin mee op een zachte wandeling door kunst en natuur! Een verhaal over feeën en heksen dat je de terril en zijn natuurlijke rijkdommen laat ontdekken door met je zintuigen te spelen."
        ],
        "es": [
          "Lleve a toda la familia a un suave paseo por el arte y la naturaleza Una historia de hadas y brujas que permite descubrir el escorial y sus riquezas naturales jugando con los sentidos."
        ]
      },
