  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Base 11/19 neu - eine Stätte, die zum UNESCO-Weltkulturerbe gehört!\nZum fünften Mal in Folge schließen sich die Partner der Base 11/19 zu den Europäischen Tagen des Kulturerbes zusammen."
    ],
    "en": [
      "Re-discover Base 11/19 - Unesco World Heritage Site!\nFor the 5th year running, Base 11/19?s partners are joining forces for the European Heritage Days."
    ],
    "it": [
      "Riscoprite la Base 11/19 - un sito del patrimonio mondiale dell'UNESCO!\nPer il quinto anno consecutivo, i partner della Base 11/19 uniscono le forze per le Giornate Europee del Patrimonio."
    ],
    "fr": [
      "Re-découvrez la Base 11/19 - site inscrit au Patrimoine mondial de l'Unesco !\nPour la 5ème année consécutive, les partenaires de la Base 11/19 s’associent pour les Journées Européennes du Patrimoine."
    ],
    "es": [
      "Redescubra la Base 11/19, Patrimonio Mundial de la UNESCO\nPor quinto año consecutivo, los socios de la Base 11/19 unen sus fuerzas en las Jornadas Europeas del Patrimonio."
    ],
    "nl": [
      "Herontdek Base 11/19 - een UNESCO Werelderfgoedlocatie!\nVoor het 5e achtereenvolgende jaar bundelen de Base 11/19 partners hun krachten voor de Europese Erfgoeddagen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Journées Européennes du Patrimoine - Le secret de Cerise sauvage"
    ]
  },
