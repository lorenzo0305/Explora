  "rdfs:comment": {
    "de": [
      "Souvigny, eine der größten Cluniazenser-Stätten und Wiege der Bourbonen, versetzt seine Besucher in das Mittelalter zurück. Von seinem Priorat bis zu seinen geschichtsträchtigen Gassen hallt jeder Schritt in diesem Dorf von der vergangenen Größe des Bourbonnais wider."
    ],
    "en": [
      "Grand Site clunisien and cradle of the Bourbons, Souvigny plunges visitors into the heart of the Middle Ages. From its priory to its narrow streets steeped in history, every step in this village resonates with the past grandeur of the Bourbonnais region."
    ],
    "it": [
      "Importante sito cluniacense e luogo di nascita dei Borboni, Souvigny riporta i visitatori nel cuore del Medioevo. Dal suo priorato alle sue stradine ricche di storia, ogni passo compiuto in questo villaggio riecheggia la passata grandezza del Bourbonnais."
    ],
    "fr": [
      "Grand Site clunisien et berceau des Bourbons, Souvigny plonge ses visiteurs au cœur du Moyen-Âge. De son prieuré à ses ruelles chargées d’histoire, chaque pas dans ce village résonne de la grandeur passée du Bourbonnais."
    ],
    "nl": [
      "Souvigny, een belangrijke Cluniac site en de geboorteplaats van de Bourbons, neemt bezoekers mee terug naar het hart van de Middeleeuwen. Van de priorij tot de smalle straatjes vol geschiedenis, elke stap die je zet in dit dorp weerspiegelt de grootsheid van de Bourbonnais uit het verleden."
    ],
    "es": [
      "Importante lugar cluniacense y cuna de los Borbones, Souvigny transporta al visitante al corazón de la Edad Media. Desde su priorato hasta sus callejuelas cargadas de historia, cada paso que se da en este pueblo es un eco de la grandeza pasada del Bourbonnais."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Grand site clunisien de Souvigny"
    ]
  },
