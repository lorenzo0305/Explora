  "rdfs:comment": {
    "de": [
      "Wir begrüßen Sie in unserem \"Logis Hôtel\" in Pontaumur, im Herzen der Combrailles, zwischen Brive und Clermont-Ferrand. Hotel mit 9 modernen, geräumigen und hellen Zimmern."
    ],
    "en": [
      "We welcome you in our \"Logis Hôtel\" in Pontaumur, in the heart of the Combrailles, between Brive and Clermont-Ferrand. Hotel with 9 modern, spacious and bright rooms."
    ],
    "it": [
      "Vi diamo il benvenuto nel nostro \"Logis Hôtel\" a Pontaumur, nel cuore delle Combrailles, tra Brive e Clermont-Ferrand. Hotel con 9 camere moderne, spaziose e luminose."
    ],
    "fr": [
      "Nous vous accueillons dans notre \"Logis Hôtel\" à Pontaumur, en plein coeur des Combrailles, entre Brive et Clermont-Ferrand. Hôtel avec 9 chambres modernes, spacieuses et lumineuses."
    ],
    "nl": [
      "Wij heten u welkom in ons \"Logis Hôtel\" in Pontaumur, in het hart van de Combrailles, tussen Brive en Clermont-Ferrand. Hotel met 9 moderne, ruime en lichte kamers."
    ],
    "es": [
      "Le damos la bienvenida a nuestro \"Logis Hôtel\" en Pontaumur, en el corazón de las Combrailles, entre Brive y Clermont-Ferrand. Hotel con 9 habitaciones modernas, amplias y luminosas."
    ]
  },
