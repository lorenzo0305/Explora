  "rdfs:comment": {
    "de": [
      "Entdecken Sie den Cave à Louise in Vichy, um französische Qualitätsweine mit einem ausgezeichneten Preis-Leistungs-Verhältnis zu entdecken. Ein Muss für Liebhaber guter Flaschen!"
    ],
    "en": [
      "Discover the Cave à Louise in Vichy to discover quality French wines at excellent value for money. A must for wine lovers!"
    ],
    "it": [
      "Scoprite la Cave à Louise di Vichy e scoprite i vini francesi di qualità con un ottimo rapporto qualità-prezzo. Un must per gli amanti del vino!"
    ],
    "fr": [
      "Découvrez la Cave à Louise à Vichy pour découvrir des vins  français de qualité avec un excellent rapport qualité prix. Un incontournable pour les amateurs de bonnes bouteilles !"
    ],
    "nl": [
      "Ontdek de Cave à Louise in Vichy en ontdek Franse kwaliteitswijnen met een uitstekende prijs-kwaliteitverhouding. Een must voor wijnliefhebbers!"
    ],
    "es": [
      "Descubra la Cave à Louise en Vichy y descubra vinos franceses de calidad con una excelente relación calidad-precio. ¡Una visita obligada para los amantes del vino!"
    ]
  },
