  "rdfs:comment": {
    "de": [
      "Eine Aufstiegspiste für Skitouren, um diese Aktivität in aller Sicherheit zu erlernen. 370 m Höhenunterschied und 2 km im Wald.\r\nZiehen Sie Ihre Felle an und los geht's!"
    ],
    "en": [
      "An uphill slope dedicated to ski touring, for a safe introduction to this activity. 370m of vertical drop and 2km."
    ],
    "it": [
      "Una pista in salita dedicata allo sci alpinismo, per un'introduzione sicura a questa attività. 370 m di dislivello e 2 km nel bosco.\r\nIndossate le pelli e partite!"
    ],
    "fr": [
      "Une piste de montée dédiée au ski de randonnée, pour s’initier à cette activité en toute sécurité. 370m de dénivelés et 2km en forêt.\r\nCollez vos peaux de phoque et c'est parti !"
    ],
    "es": [
      "Una pista cuesta arriba dedicada al esquí de travesía, para iniciarse en esta actividad con total seguridad. 370 m de desnivel y 2 km de bosque.\r\nPonte las pieles y ¡a esquiar!"
    ],
    "nl": [
      "An uphill slope dedicated to ski touring, for a safe introduction to this activity. 370m of vertical drop and 2km."
    ]
  },
  "rdfs:label": {
