  "rdfs:comment": {
    "de": [
      "Die Pfarrkirche Saint-Michel-et-Saint-Hippolyte stammt ebenfalls aus dem 12. Jahrhundert, ihre Struktur ist romanisch mit einem Schiff mit gebrochenem Tonnengewölbe."
    ],
    "en": [
      "The parish church of Saint-Michel-et-Saint-Hippolyte is also from the twelfth century, its structure is Romanesque nave with a broken barrel."
    ],
    "it": [
      "Anche la chiesa parrocchiale di Saint-Michel-et-Saint-Hippolyte risale al XII secolo e presenta una struttura romanica con navata a botte spezzata."
    ],
    "fr": [
      "L'église paroissiale Saint-Michel-et-Saint-Hippolyte est également du XIIe siècle, sa structure est romane avec une nef en berceau brisé."
    ],
    "es": [
      "La iglesia parroquial de Saint-Michel-et-Saint-Hippolyte también data del siglo XII y tiene una estructura románica con una nave de cañón roto."
    ],
    "nl": [
      "De parochiekerk van Saint-Michel-et-Saint-Hippolyte, ook uit de 12e eeuw, heeft een romaanse structuur met een spits tonvormig schip."
    ]
  },
