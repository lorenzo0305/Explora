  "rdfs:comment": {
    "de": [
      "Außenausschank inmitten des baumbestandenen Parks von La Fontaine Minérale. Erfrischungsgetränke, lokale Biere und Weine, Mocktails und Cocktails (individuell oder zum Teilen), Heißgetränke, Trockenfrüchte und Kekse. Gesellige Pause inmitten der Natur."
    ],
    "en": [
      "Outdoor refreshment bar in the heart of La Fontaine Minérale's wooded park. Cold drinks, local beers and wines, mocktails and cocktails (individual or to share), hot drinks, dried fruit and biscuits. A friendly break surrounded by nature."
    ],
    "it": [
      "Bar all'aperto nel cuore del parco alberato di La Fontaine Minérale. Bevande fredde, birre e vini locali, mocktail e cocktail (individuali o condivisi), bevande calde, frutta secca e biscotti. Una pausa conviviale nel cuore della natura."
    ],
    "fr": [
      "Buvette extérieure au cœur du parc arboré de La Fontaine Minérale. Boissons fraîches, bières et vins locaux, mocktails et cocktails (individuels ou à partager), boissons chaudes, fruits secs et cookies. Pause conviviale en pleine nature."
    ],
    "nl": [
      "Verfrissingsbar in de open lucht in het hart van het beboste park van La Fontaine Minérale. Koude dranken, lokale bieren en wijnen, mocktails en cocktails (individueel of gedeeld), warme dranken, gedroogd fruit en koekjes. Een gezellige pauze midden in de natuur."
    ],
    "es": [
      "Bar de refrescos al aire libre en el corazón del parque arbolado de La Fontaine Minérale. Bebidas frías, cervezas y vinos locales, mocktails y cócteles (individuales o para compartir), bebidas calientes, frutos secos y galletas. Una pausa agradable en plena naturaleza."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Buvette du parc de la fontaine minérale"
    ]
  },
