  "rdfs:comment": {
    "de": [
      "Das Bistrot du Pin liegt auf dem Dorfplatz gegenüber der Kirche, 2 Minuten vom Paladru-See entfernt, und bietet originelle und traditionelle Gerichte. Die Menüs bestehen hauptsächlich aus frischen Produkten, lokalen Erzeugnissen und hausgemachter Küche."
    ],
    "en": [
      "Located on the village square in front of the church, 2 min from the lake of Paladru, the Bistrot du Pin offers original and traditional dishes. The menus are mainly composed of fresh, local products and home-made cuisine."
    ],
    "it": [
      "Situato sulla piazza del paese, di fronte alla chiesa, a 2 minuti dal lago di Paladru, il Bistrot du Pin offre piatti originali e tradizionali. I menu sono composti principalmente da prodotti freschi, prodotti locali e cucina casalinga."
    ],
    "fr": [
      "Situé sur la place du village face à l'Eglise, à 2 min du lac de Paladru, le Bistrot du Pin propose des plats originaux et traditionnels. Les menus sont essentiellement composés de produits frais, produits locaux et d'une cuisine faite maison."
    ],
    "es": [
      "Situado en la plaza del pueblo, frente a la iglesia, a 2 minutos del lago de Paladru, el Bistrot du Pin ofrece platos originales y tradicionales. Los menús se componen principalmente de productos frescos, productos locales y cocina casera."
    ],
    "nl": [
      "Gelegen op het dorpsplein tegenover de kerk, op 2 minuten van het meer van Paladru, biedt de Bistrot du Pin originele en traditionele gerechten. De menu's bestaan voornamelijk uit verse producten, lokale producten en huisgemaakte gerechten."
    ]
  },
  "rdfs:label": {
