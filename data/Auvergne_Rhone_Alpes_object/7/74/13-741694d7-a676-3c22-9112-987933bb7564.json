  "rdfs:comment": {
    "de": [
      "Die afrikanische Kultur durch Veranstaltungen wie Kunsthandwerk, Musik, Filme, Tänze usw. bekannt machen Dies ermöglicht es den Menschen in unserer Region, sich für andere Kulturen zu öffnen. Das lokale Leben beleben."
    ],
    "en": [
      "Promote African culture through events: crafts, music, films, dances, etc? In this way, we open up our region to other cultures. Animate local life."
    ],
    "it": [
      "Far conoscere la cultura africana attraverso eventi: artigianato, musica, film, danze, ecc In questo modo gli abitanti della nostra regione avranno una finestra su altre culture. Animare la vita locale."
    ],
    "fr": [
      "Faire connaître la culture africaine par le biais d’événements : artisanat, musique, films, danses…etc… Ce qui permet d’offrir aux habitants de de notre région une ouverture sur d’autres cultures. Animer la vie locale."
    ],
    "es": [
      "Dar a conocer la cultura africana a través de actos: artesanía, música, películas, bailes, etc De este modo, los habitantes de nuestra región tendrán una ventana abierta a otras culturas. Animar la vida local."
    ],
    "nl": [
      "Afrikaanse cultuur onder de aandacht brengen door middel van evenementen: ambachten, muziek, films, dansen, enz Dit zal de mensen in onze regio een venster geven op andere culturen. Het plaatselijke leven verlevendigen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "25° Journées Africaines"
    ]
  },
