  "rdfs:comment": {
    "de": [
      "Bar-Brasserie, die 7 Tage die Woche geöffnet ist. Sie können zu jeder Tageszeit zum Essen kommen. Wifi-Zugang ist kostenlos. Montag- und Sonntagmittag geöffnet (abends geöffnet)"
    ],
    "en": [
      "Brasserie-bar, open every day. Come and eat at any time of the day. Free wi-fi access."
    ],
    "it": [
      "Bar-brasserie aperto 7 giorni su 7. È possibile venire a mangiare in qualsiasi momento. Accesso wifi gratuito. Lunedì e domenica a pranzo (servizio serale da concordare)"
    ],
    "fr": [
      "Bar-brasserie ouvert 7 jours sur 7. Vous pouvez venir vous restaurer à toute heure. Accès wifi gratuit. Services lundi et dimanche midi ( à voir pour le soir)"
    ],
    "es": [
      "Bar-brasserie abierto 7 días a la semana. Puede venir a comer a cualquier hora. Acceso wifi gratuito. Lunes y domingos al mediodía (servicio nocturno a convenir)"
    ],
    "nl": [
      "Bar-brasserie 7 dagen per week geopend. Je kunt op elk moment komen eten. Gratis wifi. Maandag en zondag lunchtijd (avonddienst te regelen)"
    ]
  },
