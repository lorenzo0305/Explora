  "rdfs:comment": {
    "de": [
      "Atelier für Keramik und Bildhauerei mit Raku-Brand: Kurse, Praktika auf Anfrage möglich. Besichtigung des Ladens nach Vereinbarung.\r\n\r\nDer Laden liegt neben dem Atelier und durch eine Fensterfront können Sie einen Blick auf die entstehenden Stücke werfen."
    ],
    "en": [
      "Ceramics and sculpture workshop with Raku firing: Courses and workshops available on request. Store visit by appointment.\r\n\r\nThe store is adjacent to the workshop, and through a bay window you can take a look at the pieces being created."
    ],
    "it": [
      "Laboratorio di ceramica e scultura con cottura Raku: lezioni e corsi disponibili su richiesta. Visita del negozio su appuntamento.\r\n\r\nIl negozio è adiacente al laboratorio e attraverso un bovindo si possono osservare i pezzi in lavorazione."
    ],
    "fr": [
      "Atelier de céramique et de sculpture avec cuisson Raku : cours, stage possible sur demande. Visite de la boutique sur rendez-vous.\r\n\r\nLa boutique est adjacente à l'atelier et par une baie vitrée vous pouvez jeter un œil au pièces en cours de création."
    ],
    "es": [
      "Taller de cerámica y escultura con cocción Raku: clases y cursos a petición. Visite la tienda con cita previa.\r\n\r\nLa tienda se encuentra junto al taller y, a través de un ventanal, se pueden contemplar las piezas en proceso de creación."
    ],
    "nl": [
      "Keramiek- en beeldhouwatelier met Raku stoken: Cursussen en workshops op aanvraag. Bezoek de winkel op afspraak.\r\n\r\nDe winkel grenst aan de werkplaats en door een erker kun je een kijkje nemen bij de stukken die worden gemaakt."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Danielle Simon Création"
    ]
  },
