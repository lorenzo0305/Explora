  "rdfs:comment": {
    "de": [
      "Handwerkliche Papierwerkstatt im Herzen von Livradois-Forez (Auvergne). Unser Papier wird Blatt für Blatt von Hand nach traditionellen Techniken hergestellt."
    ],
    "en": [
      "Artisanal stationery workshop in the heart of Livradois-Forez (Auvergne). Our paper is handmade sheet by sheet using traditional techniques."
    ],
    "it": [
      "Laboratorio artigianale di cartoleria nel cuore di Livradois-Forez (Auvergne). La nostra carta è realizzata a mano, foglio per foglio, con tecniche tradizionali."
    ],
    "fr": [
      "Atelier de papeterie artisanal au coeur du Livradois-Forez (Auvergne). Notre papier est fabriqué feuille à feuille à la main selon des techniques traditionnelles."
    ],
    "es": [
      "Taller artesanal de papelería en el corazón de Livradois-Forez (Auvernia). Nuestro papel se fabrica a mano hoja a hoja mediante técnicas tradicionales."
    ],
    "nl": [
      "Ambachtelijk atelier voor papierwaren in het hart van Livradois-Forez (Auvergne). Ons papier wordt vel voor vel met de hand gemaakt met behulp van traditionele technieken."
    ]
  },
