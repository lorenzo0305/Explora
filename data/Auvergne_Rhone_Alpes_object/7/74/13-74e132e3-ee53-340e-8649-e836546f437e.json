  "rdfs:comment": {
    "de": [
      "Crêperie-Restaurant, ganzjährig geöffnet. Wir bieten Ihnen eine hausgemachte, großzügige und lokale Küche: Buchweizengaletten, süße Crêpes, Tagesgerichte und Spezialitäten aus der Ardèche. Gesellige Atmosphäre im Saal oder auf der Terrasse, je nach Saison."
    ],
    "en": [
      "Crêperie-restaurant open all year round, offering generous, home-style, local cuisine: buckwheat pancakes, sweet crêpes, daily specials and Ardèche specialities. Convivial atmosphere in the dining room or on the terrace, depending on the season."
    ],
    "it": [
      "La nostra crêperie-ristorante è aperta tutto l'anno e serve generosi prodotti locali cucinati in casa: frittelle di grano saraceno, crêpes dolci, specialità del giorno e specialità dell'Ardèche. Un'atmosfera accogliente nella sala da pranzo o sulla terrazza, a seconda della stagione."
    ],
    "fr": [
      "Crêperie-restaurant ouverte toute l’année, nous vous proposons une cuisine maison, généreuse et locale : galettes de sarrasin, crêpes sucrées, plats du jour et spécialités ardéchoises. Ambiance conviviale en salle ou en terrasse selon la saison."
    ],
    "nl": [
      "Ons crêperie-restaurant is het hele jaar door geopend en serveert royale huisgemaakte streekgerechten: boekweitpannenkoeken, zoete crêpes, dagschotels en specialiteiten uit de Ardèche. Een gezellige sfeer in de eetzaal of op het terras, afhankelijk van het seizoen."
    ],
    "es": [
      "Nuestra crêperie-restaurante está abierta todo el año y sirve una generosa cocina casera de productos locales: tortitas de trigo sarraceno, crêpes dulces, platos del día y especialidades de Ardèche. Ambiente acogedor en el comedor o en la terraza, según la temporada."
    ]
  },
