  "rdfs:comment": {
    "de": [
      "Cocktails Bar"
    ],
    "ru": [
      "Модные коктейли бар"
    ],
    "en": [
      "Hotel Le Savoy's Bar is probably the most trendy bar within the 3 Valleys domain. At the helm, we have developed a winter cocktail menu as glamorous as it is daring, where delicate spirits and fine charcuterie mountains meat."
    ],
    "it": [
      "Il bar Savoy è il bar più trendy di tutta la zona delle 3 Vallées. Offriamo un menu di cocktail glamour tanto sorprendenti quanto audaci, in cui si mescolano alcolici delicati e carni pregiate di montagna."
    ],
    "fr": [
      "Le bar du Savoy est le bar le plus trendy de tout le domaine des 3 Vallées. Nous vous proposons une carte de cocktails glamour aussi surprenants qu'audacieux où peuvent se côtoyer alcools délicats et charcuteries fines des montagnes."
    ],
    "es": [
      "El bar Savoy es el más moderno de toda la zona de los 3 Valles. Ofrecemos una carta de cócteles glamurosos, tan sorprendentes como atrevidos, donde se mezclan delicados alcoholes y finas carnes de montaña."
    ],
    "nl": [
      "De Savoy bar is de meest trendy bar van de 3 Vallées. Wij bieden een menu met even verrassende als gedurfde glamoureuze cocktails, waarbij delicate alcoholen en fijne berggerechten met elkaar worden vermengd."
    ]
  },
