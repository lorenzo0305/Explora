  "rdfs:comment": {
    "de": [
      "Der Wellnessbereich des Carlina, eine Oase der Entspannung am Fuße der Pisten, ist den Hotelgästen vorbehalten: beheiztes Schwimmbad, Sauna, Jacuzzi, Modellage, Friseursalon."
    ],
    "en": [
      "The Carlina's wellness area, a haven of relaxation at the foot of the slopes, reserved for hotel guests: heated swimming pool, sauna, jacuzzi, massage, hairdressing salon."
    ],
    "it": [
      "L'area benessere della Carlina, un'oasi di relax ai piedi delle piste, riservata agli ospiti dell'hotel: piscina riscaldata, sauna, jacuzzi, massaggi e parrucchiere."
    ],
    "fr": [
      "L'espace bien-être du Carlina, un havre de détente au pied des pistes, réservé à la clientèle de l'hôtel : piscine chauffée, sauna, jacuzzi, modelage, salon de coiffure."
    ],
    "es": [
      "El espacio de bienestar del Carlina, un remanso de relajación a pie de pistas, reservado a los clientes del hotel: piscina climatizada, sauna, jacuzzi, masajes y peluquería."
    ],
    "nl": [
      "De wellnessruimte van Carlina, een oase van ontspanning aan de voet van de pistes, gereserveerd voor hotelgasten: verwarmd zwembad, sauna, jacuzzi, massage en kapsalon."
    ]
  },
