      "dc:description": {
        "de": [
          "Geheimnisse, vergessene Geschichten, ungeahnte Ursprünge?\nVerpassen Sie nicht die spannende Konferenz, die vom Lokalhistoriker Philippe RULKIN geleitet wird,"
        ],
        "en": [
          "Secrets, forgotten stories, unsuspected origins?\nDon't miss this fascinating talk by local historian Philippe RULKIN,"
        ],
        "it": [
          "Segreti, storie dimenticate, origini insospettabili?\nNon perdetevi l'affascinante conferenza dello storico locale Philippe RULKIN,"
        ],
        "fr": [
          "Des secrets, des histoires oubliées, des origines insoupçonnées…\nNe manquez pas la conférence passionnante animée par Philippe RULKIN, historien local,"
        ],
        "es": [
          "¿Secretos, historias olvidadas, orígenes insospechados?\nNo se pierda esta fascinante charla del historiador local Philippe RULKIN,"
        ],
        "nl": [
          "Geheimen, vergeten verhalen, onvermoede oorsprong?\nMis deze fascinerende lezing van lokaal historicus Philippe RULKIN niet,"
        ]
      },
