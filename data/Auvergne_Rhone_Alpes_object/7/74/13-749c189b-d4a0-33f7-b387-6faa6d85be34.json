  "rdfs:comment": {
    "de": [
      "Begeben Sie sich mit Ihrem Smartphone auf die Spuren von Raoul, dem kleinen Teufel, den alle Marnerots kennen, und entdecken Sie, welchen Streich er dem Dorf gespielt hat!"
    ],
    "en": [
      "Thanks to your smartphone, follow the tracks of Raoul, the little devil known by all the inhabitants of Marnaz and find out which trick he played to the village !"
    ],
    "it": [
      "Grazie al vostro smartphone, seguite le tracce di Raoul, il diavoletto conosciuto da tutti i Marnerot, e scoprite lo scherzo che ha fatto al villaggio!"
    ],
    "fr": [
      "Grace à votre smartphone, partez sur les traces de Raoul, ce petit diable connu par tous les marnerots et découvrez quel tour il a joué au village !"
    ],
    "nl": [
      "Treed dankzij je smartphone in de voetsporen van Raoul, het duiveltje dat alle Marnerotten kennen, en ontdek de truc die hij met het dorp heeft uitgehaald!"
    ],
    "es": [
      "Gracias a tu smartphone, sigue los pasos de Raoul, el diablillo conocido por todos los Marnerots, y descubre la jugarreta que le hizo al pueblo"
    ]
  },
  "rdfs:label": {
