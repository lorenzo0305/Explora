  "rdfs:comment": {
    "de": [
      "Traditionelles Dorfrestaurant, das von 2 Terrassen profitiert. Küche \"hausgemacht\". Formel des Tages. Imbiss an jedem ersten Sonntag des Monats. Freitagabend und Samstagmorgen nur Gerichte zum Mitnehmen."
    ],
    "en": [
      "Traditional village restaurant with 2 terraces. Home-made cuisine. Daily specials. Snack bar every 1st Sunday of the month. Friday evenings and Saturday mornings takeaway only."
    ],
    "it": [
      "Ristorante tradizionale di paese con 2 terrazze. Cucina casalinga. Specialità giornaliere. Snack bar ogni 1° domenica del mese. Venerdì sera e sabato mattina solo da asporto."
    ],
    "fr": [
      "Restaurant traditionnel de village qui bénéficie de 2 terrasses. Cuisine \"fait maison\". Formule du jour. Casse-croûte tous les 1er dimanches du mois. Vendredi soir et samedi matin plats à emporter uniquement."
    ],
    "nl": [
      "Traditioneel dorpsrestaurant met 2 terrassen. Huisgemaakte keuken. Dagelijkse specialiteiten. Snackbar elke 1e zondag van de maand. Vrijdagavond en zaterdagochtend alleen afhaalmaaltijden."
    ],
    "es": [
      "Restaurante tradicional de pueblo con 2 terrazas. Cocina casera. Menús del día. Snack-bar el primer domingo de cada mes. Viernes por la noche y sábados por la mañana sólo para llevar."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Un goût de reviens'y"
    ]
  },
