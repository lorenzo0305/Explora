  "rdfs:comment": {
    "de": [
      "Handwerkliche Brauerei mit einer Leidenschaft für die Erforschung und das Teilen der einzigartigen Aromen von Bier. Lokale, umweltbewusste Brauerei, die auf geschmackliche Exzellenz abzielt. Saal und Terrasse. Kleine Speisen und Getränke. Alkoholfreie Getränke und Weine. Besichtigungen und Verkostungen."
    ],
    "en": [
      "A passionate craft brewer dedicated to exploring and sharing the unique flavors of beer. A local, eco-friendly brewery striving for excellence in taste. Indoor seating and terrace. Light meals with local, artisanal, and high-quality products. Soft drinks and wines. Tours and tasting sessions organized."
    ],
    "it": [
      "Produttore di birra artigianale con la passione di esplorare e condividere i sapori unici della birra. Un birrificio locale ed eco-responsabile che punta all'eccellenza del gusto. Sala da pranzo e terrazza. Snack bar. Bevande analcoliche e vini. Visite e degustazioni."
    ],
    "fr": [
      "Artisan Brasseur passionné par l'exploration et le partage des saveurs uniques de la bière. Brasserie locale, éco-responsable et visant l'excellence gustative. Salle et terrasse. Petite restauration. Boissons sans alcool et vins. Visites et dégustations."
    ],
    "es": [
      "Cervecera artesanal apasionada por explorar y compartir los sabores únicos de la cerveza. Una cervecería local y eco-responsable que busca la excelencia en el sabor. Comedor y terraza. Cafetería. Bebidas sin alcohol y vinos. Visitas y degustaciones."
    ],
    "nl": [
      "Ambachtelijke brouwer met een passie voor het verkennen en delen van de unieke smaken van bier. Een lokale, ecologisch verantwoorde brouwerij die streeft naar uitmuntendheid in smaak. Eetzaal en terras. Snackbar. Niet-alcoholische dranken en wijnen. Rondleidingen en proeverijen."
    ]
  },
