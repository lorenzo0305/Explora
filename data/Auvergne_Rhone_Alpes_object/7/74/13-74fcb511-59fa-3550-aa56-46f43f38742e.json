  "rdfs:comment": {
    "de": [
      "Schattiger Picknickplatz, Badespass im Sommer im Juli\r\nAugust am Nachmittag. Food Truck in der Nähe des Strandes in der Sommerzeit. \r\nAktivitäten in allen Jahreszeiten:\r\n- Minigolfplatz\r\n- Fitnessplatz\r\n- Disc Golf Parcours\r\n- Spielplatz"
    ],
    "en": [
      "Shady picnic area, supervised swimming in summer in July\r\nand August in the afternoon. Food Truck near the beach in summer. \r\nAll Season Activities:\r\n- mini golf course\r\n- fitness area\r\n- disc golf course\r\n- playground"
    ],
    "it": [
      "Attività per tutte le stagioni: disc golf, mini golf, area giochi per bambini, area fitness (crossfit), spiaggia di sabbia, campo polisportivo."
    ],
    "fr": [
      "Activités toutes saisons : discgolf, mini golf, jeux d’enfants, aire de remise en forme (crossfit), plage de sable, terrain multi-sports."
    ],
    "nl": [
      "Schaduwrijke picknickplaats, onder toezicht zwemmen in de zomer in juli\r\nEn augustus in de middag. Food Truck in de zomer bij het strand.\r\nActiviteiten in het hele seizoen:\r\n- mini-golfbaan\r\n- fitnessruimte\r\n- de cursus van het schijfgolf\r\n- speeltuin"
    ],
    "es": [
      "Actividades durante toda la temporada: disc golf, minigolf, zona de juegos infantiles, zona de fitness (crossfit), playa de arena, pista polideportiva."
    ]
  },
