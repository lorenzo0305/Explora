  "rdfs:comment": {
    "de": [
      "Vor den Toren von Chartreuse, 12 km von Grenoble entfernt, beherbergt die Galerie de Chartreuse in der Stadtbibliothek das ganze Jahr über Ausstellungen mit Gemälden, Fotos und Skulpturen."
    ],
    "en": [
      "At the gates of Chartreuse, 12km from Grenoble, the Galerie de Chartreuse hosts, within the municipal library, exhibitions of paintings, photos and sculptures throughout the year."
    ],
    "it": [
      "Alle porte della Chartreuse, a 12 km da Grenoble, la Galerie de Chartreuse ospita, all'interno della biblioteca comunale, mostre di dipinti, foto e sculture durante tutto l'anno."
    ],
    "fr": [
      "Aux portes de la Chartreuse, à 12km de Grenoble, la Galerie de Chartreuse accueille, au sein de la bibliothèque municipale, des expositions de peintures, photos et sculptures tout au long de l’année."
    ],
    "nl": [
      "Aan de poorten van Chartreuse, op 12 km van Grenoble, organiseert de Galerie de Chartreuse, in de gemeentelijke bibliotheek, het hele jaar door tentoonstellingen van schilderijen, foto's en beeldhouwwerken."
    ],
    "es": [
      "A las puertas de la Chartreuse, a 12 km de Grenoble, la Galerie de Chartreuse acoge exposiciones de pintura, fotografía y escultura durante todo el año."
    ]
  },
