  "rdfs:comment": {
    "de": [
      "Entdecken Sie mithilfe von Informationstafeln, ob mit dem Mountainbike oder zu Fuß, die Fauna, die Flora und die Geologie der Heidelandschaft in den Schluchten des Cher, einem Natura-2000-Gebiet."
    ],
    "en": [
      "With the help of information panels, whether by mountain bike or on foot, discover the fauna, flora and geology of the moors of the Cher Gorges, a Natura 2000 listed site."
    ],
    "it": [
      "Con l'aiuto di pannelli informativi, in mountain bike o a piedi, scoprite la fauna, la flora e la geologia delle brughiere delle gole del Cher, sito Natura 2000."
    ],
    "fr": [
      "À l'aide de panneaux d'informations, que ce soit à VTT ou à pied, découvrez la faune, la flore et la géologie des landes des gorges du Cher, site classé Natura 2000."
    ],
    "nl": [
      "Ontdek met behulp van informatiepanelen, per mountainbike of te voet, de fauna, flora en geologie van de heidevelden van de Gorges du Cher, een Natura 2000-gebied."
    ],
    "es": [
      "Con la ayuda de paneles informativos, ya sea en bicicleta de montaña o a pie, descubra la fauna, la flora y la geología de los páramos de las gargantas del Cher, sitio Natura 2000."
    ]
  },
  "rdfs:label": {
    "fr": [
