  "rdfs:comment": {
    "de": [
      "Die Kopster Restaurant Bar liegt 20 Minuten vom Stadtzentrum Lyons entfernt, am Fuße des Groupama Stadiums, im Herzen des lebhaften Viertels OL Vallée, und bietet Mahlzeiten für den ganzen Tag: vom Frühstück über das Abendessen bis hin zu Snacks."
    ],
    "en": [
      "The Kopster Restaurant Bar, located 20 minutes from Lyon city centre, at the foot of Groupama Stadium, in the heart of the lively OL Vallée district, offers meals to last all day: from breakfast to lunch and snacks."
    ],
    "it": [
      "Situato a 20 minuti dal centro di Lione, ai piedi dello stadio Groupama, nel cuore del vivace quartiere OL Vallée, il Kopster Restaurant Bar offre pasti che vi accompagneranno per tutto il giorno: dalla colazione al pranzo e agli spuntini."
    ],
    "fr": [
      "Le Kopster Restaurant Bar, situé à 20 minutes du centre-ville de Lyon, au pied du Groupama Stadium, au cœur du quartier animé d'OL Vallée, propose des repas pour tenir toute la journée : du petit-déjeuner au diner en passant par le goûter."
    ],
    "es": [
      "Situado a 20 minutos del centro de Lyon, a los pies del Estadio Groupama, en el corazón del animado barrio de OL Vallée, el Restaurante Bar Kopster le propone comidas para todo el día: desde desayunos hasta almuerzos y meriendas."
    ],
    "nl": [
      "Op 20 minuten van het centrum van Lyon, aan de voet van het Groupama Stadion, in het hart van de levendige wijk OL Vallée, biedt de Kopster Restaurant Bar maaltijden om de hele dag van te genieten: van ontbijt tot lunch en snacks."
    ]
  },
