  "rdfs:comment": {
    "de": [
      "Verkostung und Weinverkauf, Marmelade."
    ],
    "en": [
      "Christophe produces a dozen different cuvées, including Viognier, Syrah Baptiste, Chatus Romain, a variety from the Ardèche reintroduced after more than 20 years, red and white sweet wines, a Carthagène and a wine made using the Champagne method."
    ],
    "it": [
      "Christophe vi farà conoscere la sua passione: il VINO\r\nVi invitiamo a venire a degustare i seguenti vini: chatus, otoctone, syrah Baptiste, pinot nero, viognier, chardonnay, Mon Coeur, l'elixir du Papé vin de liqueur, Mon Louis d'or méthode ancestrale ...."
    ],
    "fr": [
      "Christophe vous fera découvrir sa passion : LE VIN \r\nNous vous invitons à venir déguster  : le chatus cépage otoctone, la syrah Baptiste, pinot noir, viognier, chardonnay, Mon Coeur, l'élixir du Papé vin de liqueur, Mon Louis d'or méthode ancestrale ...."
    ],
    "nl": [
      "Proeverij en verkoop van wijnen, jam."
    ],
    "es": [
      "Christophe le presentará su pasión: EL VINO\r\nLe invitamos a venir y degustar los siguientes vinos: chatus, otoctone, syrah Baptiste, pinot noir, viognier, chardonnay, Mon Coeur, l'elixir du Papé vin de licor, Mon Louis d'or méthode ancestrale ...."
    ]
  },
