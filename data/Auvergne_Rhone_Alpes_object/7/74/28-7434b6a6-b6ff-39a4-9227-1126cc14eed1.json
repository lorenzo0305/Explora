  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/fc954122-97cd-34f0-848b-7be6e961a146",
      "dc:description": {
        "de": [
          "Estaminet mit der Atmosphäre von früher, in dem du regionale Gerichte probieren kannst. Sie können sich mit den traditionellen flämischen Holzspielen, die Ihnen zur Verfügung stehen, vergnügen."
        ],
        "en": [
          "Estaminet with an old-fashioned atmosphere, where you can enjoy regional dishes. Traditional Flemish wooden games are also available."
        ],
        "it": [
          "Estaminet dall'atmosfera antica dove si possono gustare piatti regionali. Sono disponibili anche giochi tradizionali fiamminghi in legno."
        ],
        "fr": [
          "Estaminet à l'ambiance d'autrefois où vous pourrez déguster des plats régionaux. Vous pourrez vous amuser avec les jeux traditionnels flamands en bois mis à votre disposition."
        ],
        "nl": [
          "Estaminet met een ouderwetse sfeer waar je kunt genieten van streekgerechten. Je kunt er ook traditionele Vlaamse houten spellen spelen."
        ],
        "es": [
          "Estaminet de ambiente antiguo donde podrá degustar platos regionales. También podrá jugar a juegos de madera tradicionales flamencos."
        ]
      },
