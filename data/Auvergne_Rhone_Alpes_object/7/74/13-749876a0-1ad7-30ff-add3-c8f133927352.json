  "rdfs:comment": {
    "de": [
      "Auf den Anhöhen von Saint-Sauveur-en-Rue, Familienbetrieb mit Aubrac-Schweinen und -Kühen mit Bio-Zertifizierung. Erklärung der Herstellungsverfahren, Verkostung der Produkte und Verkauf ab Hof."
    ],
    "en": [
      "On the heights of Saint-Sauveur-en-Rue, a family farm of pigs and Aubrac cows certified organic. Meeting with the animals on request. Explanation of the production process, tasting of products and sale at the farm."
    ],
    "it": [
      "Sulle alture di Saint-Sauveur-en-Rue, un allevamento biologico certificato di suini e bovini di Aubrac. Spiegazione dei processi produttivi, degustazione dei prodotti e vendita dell'azienda."
    ],
    "fr": [
      "Sur les hauteurs de Saint-Sauveur-en-Rue, exploitation familiale de porcs et de vaches Aubrac certifié bio. Explication des procédés de fabrication, dégustation des produits et vente à la ferme."
    ],
    "nl": [
      "Op de hoogten van Saint-Sauveur-en-Rue, een door een familie gerund, gecertificeerd biologisch Aubrac varkens- en koeienbedrijf. Uitleg over het productieproces, proeverij en verkoop op de boerderij."
    ],
    "es": [
      "En las alturas de Saint-Sauveur-en-Rue, granja de cerdos y vacas de Aubrac con certificación ecológica. Explicación de los procesos de producción, degustación de productos y venta en la granja."
    ]
  },
  "rdfs:label": {
    "fr": [
      "GAEC La Ferme de Taillard"
    ]
  },
