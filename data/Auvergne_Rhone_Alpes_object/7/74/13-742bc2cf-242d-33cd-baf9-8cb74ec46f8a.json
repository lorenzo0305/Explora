  "rdfs:comment": {
    "de": [
      "Unterkunft und Verpflegung in einem ehemaligen Schloss aus dem 18. Jahrhundert. Wir heißen Familien, Gruppen und professionelle Schulungsteilnehmer herzlich willkommen. Verschiedene Unterkünfte mit eigenem oder Gemeinschaftsbad stehen zur Verfügung. Barrierefreie Zimmer sind ebenfalls vorhanden."
    ],
    "en": [
      "Accommodation and catering in a former 18th-century castle. Welcoming families, groups, and professional training courses. A variety of accommodations with private or shared bathrooms. Rooms accessible to people with reduced mobility."
    ],
    "it": [
      "Alloggio e ristorazione in un antico castello del XVIII secolo. Sistemazione per famiglie, gruppi e corsi di formazione professionale. Una gamma di alloggi con servizi igienici individuali o condivisi. Camere con accesso PRM."
    ],
    "fr": [
      "Hébergement et restauration dans un ancien château du 18ème siècle. Accueil des familles, des groupes, des formations professionnelles. Hébergements diversifiés avec sanitaires individuels ou collectifs. Chambres accessibles PMR."
    ],
    "es": [
      "Alojamiento y restauración en un antiguo castillo del siglo XVIII. Alojamiento para familias, grupos y cursos de formación profesional. Una gama de alojamientos con instalaciones sanitarias individuales o compartidas. Habitaciones con acceso PMR."
    ],
    "nl": [
      "Accommodatie en catering in een voormalig 18e-eeuws kasteel. Wij verwelkomen gezinnen, groepen en professionele trainingscursussen. Diverse accommodaties met eigen of gedeelde badkamers. Kamers toegankelijk voor mensen met een beperkte mobiliteit."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Accueil Saint Joseph d'Allex"
    ]
  },
