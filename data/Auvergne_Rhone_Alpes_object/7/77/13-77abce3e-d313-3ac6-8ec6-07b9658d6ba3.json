  "rdfs:comment": {
    "de": [
      "Im Herzen von Vichy gelegen, empfängt Sie das Restaurant du Grand Café jeden Tag zu einem Gourmetmoment in einer geselligen Atmosphäre, eingebettet in die Parks."
    ],
    "en": [
      "Located in the heart of Vichy, the Grand Café restaurant welcomes you every day for a gourmet moment in a friendly atmosphere, nestled in the heart of the parks."
    ],
    "it": [
      "Situato nel cuore di Vichy, il ristorante Grand Café vi accoglie ogni giorno per un momento gourmet in un'atmosfera amichevole, immerso nel cuore dei parchi."
    ],
    "fr": [
      "Situé au cœur de Vichy, le restaurant du Grand Café vous accueille chaque jour pour un moment gourmand dans une ambiance conviviale, nichée au cœur des parcs."
    ],
    "es": [
      "Situado en el corazón de Vichy, el restaurante Grand Café le da la bienvenida cada día para disfrutar de un momento gastronómico en un ambiente acogedor, enclavado en el corazón de los parques."
    ],
    "nl": [
      "Gelegen in het hart van Vichy, verwelkomt het Grand Café restaurant je elke dag voor een gastronomisch moment in een vriendelijke sfeer, genesteld in het hart van de parken."
    ]
  },
  "rdfs:label": {
