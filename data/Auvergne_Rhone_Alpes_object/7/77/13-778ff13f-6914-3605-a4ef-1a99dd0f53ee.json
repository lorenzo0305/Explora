  "rdfs:comment": {
    "de": [
      "Grosser 950m² Indoor-Spielpark für Kinder zwischen 1 und 12 Jahren Geburtstags- und Weihnachtsbaumorganisation. Badaboum bietet 60 Spiele auf 4 Stockwerken und 7 Metern Höhe, davon 1 Platz für Kinder - 3 Jahre. Neu: Elektroautos, Snacks."
    ],
    "en": [
      "Huge indoor playground of 950m² for children from 1 to 12 years old. Badaboum offers 60 games spread over 4 floors and 7m high including 1 space reserved for - 3 years old. New: electric cars, snack. Organization of birthdays and Christmas events"
    ],
    "it": [
      "Un enorme parco giochi al coperto di 950 m² per bambini da 1 a 12 anni.  Badaboum offre 60 giochi distribuiti su 4 piani e alti 7 metri, tra cui un'area riservata ai bambini sotto i 3 anni. Organizzazione di compleanni e alberi di Natale."
    ],
    "fr": [
      "Immense parc de jeux indoor de 950m² pour les enfants de 1 à 12 ans.  Badaboum propose 60 jeux répartis sur 4 étages et 7m de hauteur dont 1 espace réservé aux - de 3 ans. Organisation d’anniversaires et arbres de Noël."
    ],
    "es": [
      "Una enorme zona de juegos cubierta de 950 m² para niños de 1 a 12 años.  Badaboum ofrece 60 juegos repartidos en 4 plantas y 7 m de altura, incluida 1 zona reservada a niños menores de 3 años. Organización de cumpleaños y árboles de Navidad."
    ],
    "nl": [
      "Grote overdekte speeltuin van 950m² voor kinderen van 1 tot 12 jaar oud. Organisatie van verjaardagen en kerstbomen. Badaboum biedt 60 spellen verdeeld over 4 verdiepingen en 7 meter hoog, inclusief 1 gereserveerde plaats voor - 3 jaar oud. Nieuw: Elektrische auto's, snack."
    ]
  },
