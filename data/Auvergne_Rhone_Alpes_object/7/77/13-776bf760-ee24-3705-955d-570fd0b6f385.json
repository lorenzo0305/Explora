  "rdfs:comment": {
    "de": [
      "Vier Generationen von Winzern haben auf einem Familienbetrieb mit einer Fläche von 12 ha gearbeitet, und das immer in der reinsten Tradition. Kommentierte Besichtigung der Weinberge und des Weinkellers."
    ],
    "en": [
      "Four generations of winegrowers have worked on a family exploitation of 12ha, and this always in the purest tradition. Guided tour of the vineyards and the cellar."
    ],
    "it": [
      "Quattro generazioni di viticoltori hanno lavorato in una tenuta di famiglia di 12 ettari, sempre nel rispetto della più pura tradizione. Visita guidata ai vigneti e alla cantina."
    ],
    "fr": [
      "Quatre générations de vignerons ont œuvré sur une exploitation familiale d'une superficie de 12ha, et ceci toujours dans la plus pure tradition. Visite commentée des vignes et de la cave."
    ],
    "nl": [
      "Vier generaties wijnbouwers hebben gewerkt op een familiedomein van 12 hectare, altijd in de zuiverste traditie. Rondleiding door de wijngaarden en de kelder."
    ],
    "es": [
      "Cuatro generaciones de viticultores han trabajado en una finca familiar de 12 hectáreas, siempre en la más pura tradición. Visita guiada a los viñedos y a la bodega."
    ]
  },
