  "rdfs:comment": {
    "de": [
      "Wird es dir gelingen, alle Rätsel zu lösen und rechtzeitig aus dem Klassenzimmer des Museums zu entkommen?\nDrei Schwierigkeitsstufen (Junior, Familie, Experte), die Sie mit der Familie oder mit Freunden absolvieren können!"
    ],
    "en": [
      "Can you solve all the riddles and get out of the museum classroom in time?\nThree levels of difficulty (junior, family, expert) for families and friends!"
    ],
    "it": [
      "Riuscirete a risolvere tutti gli enigmi e a uscire in tempo dall'aula del museo?\nCi sono tre livelli di difficoltà (junior, family, expert) per divertirsi con la famiglia o gli amici!"
    ],
    "fr": [
      "Réussirez-vous à résoudre l'ensemble des énigmes et à sortir à temps de la salle de classe du musée ? \nTrois niveaux de difficulté (junior, famille, expert) à faire en famille ou entre amis !"
    ],
    "es": [
      "¿Conseguirás resolver todos los enigmas y salir a tiempo del aula museo?\nHay tres niveles de dificultad (junior, familiar y experto) para que disfrutes con tu familia o amigos"
    ],
    "nl": [
      "Lukt het jou om alle raadsels op te lossen en op tijd uit het museumlokaal te komen?\nEr zijn drie moeilijkheidsniveaus (junior, familie, expert) om samen met je familie of vrienden van te genieten!"
    ]
  },
