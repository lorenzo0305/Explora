  "rdfs:comment": {
    "de": [
      "Hoch über dem Isère-Tal, unter den Ausläufern des Vercors-Massivs, bilden das Couvent des Carmes und die Überreste des Delphinpalastes aus dem 14. Jahrhundert eine denkmalgeschützte Stätte."
    ],
    "en": [
      "Overlooking the Isère valley, in the foothills of the Vercors massif, Le Couvent des Carmes and the remains of the 14th-century delphinal palace form a listed heritage site."
    ],
    "it": [
      "Affacciato sulla valle dell'Isère, ai piedi del massiccio del Vercors, il convento dei Carmelitani e i resti del palazzo delfinale del XIV secolo costituiscono un patrimonio classificato."
    ],
    "fr": [
      "Surplombant la vallée de l’Isère, sous les contreforts du massif du Vercors, Le Couvent des Carmes et les vestiges du palais delphinal du 14e siècle forment un site patrimonial classé Monuments Historiques."
    ],
    "nl": [
      "Uitkijkend over de Isère-vallei, aan de voet van het Vercors-massief, vormen het Karmelietenklooster en de overblijfselen van het 14e-eeuwse Delphinal-paleis een beschermd erfgoed."
    ],
    "es": [
      "Con vistas al valle del Isère, en las estribaciones del macizo del Vercors, el Convento de los Carmelitas y los restos del Palacio Delphinal del siglo XIV forman un conjunto patrimonial protegido."
    ]
  },
