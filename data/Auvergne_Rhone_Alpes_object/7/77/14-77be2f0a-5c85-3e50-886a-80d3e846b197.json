  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/7c246167-3a0d-31c4-b34a-039d59c92245",
      "dc:description": {
        "de": [
          "TOUR DES REMPARTS - Dauer 1,5 Std\nBegeben Sie sich auf einen Spaziergang durch die Geschichte seit der Antike, indem Sie auf den Stadtmauern spazieren gehen.\nTreffpunkt: Rue de Bernet, vor der Zugbrücke des Schlosses e \" \"\n\nPreis: 5 ? / kostenlos für Kinder unter 12 Jahren.\nEintrittskarten nur im Fremdenverkehrsamt oder online: www.reservation.boulonnaisautop.com"
        ],
        "en": [
          "TOUR OF THE REMPARTS - duration 1h30\nTake a stroll along the ramparts, a journey through history dating back to antiquity.\nRdv rue de Bernet, in front of the château drawbridge e \"\n\nPrice: 5 ? / free for children under 12.\nTickets only available at the Tourist Office or online: www.reservation.boulonnaisautop.com"
        ],
        "it": [
          "VISITA DEI RIMPARTI - durata 1h30\nPasseggiate lungo i bastioni e scoprite la storia della città dai tempi antichi.\nPunto d'incontro rue de Bernet, davanti al ponte levatoio del castello e \"\n\nPrezzo: 5 € / gratuito per i bambini sotto i 12 anni.\nBiglietti disponibili solo presso l'Ufficio del Turismo o online: www.reservation.boulonnaisautop.com"
        ],
        "fr": [
          "LE TOUR DES REMPARTS - durée 1h30\nPartez pour une promenade au fil de l’histoire depuis l’Antiquité, en cheminant sur les remparts.\nRdv rue de Bernet, devant le pont-levis du château e »\n\nTarif : 5 € / gratuit pour les moins de 12 ans.\nBilletterie uniquement à l'Office de Tourisme ou en ligne : www.reservation.boulonnaisautop.com"
        ],
        "es": [
          "VISITA DE LAS MURALLAS - duración 1h30\nPasee por las murallas y descubra la historia de la ciudad desde la antigüedad.\nPunto de encuentro rue de Bernet, frente al puente levadizo del castillo e \"\n\nPrecio: 5 euros / gratuito para menores de 12 años.\nEntradas disponibles únicamente en la Oficina de Turismo o en línea: www.reservation.boulonnaisautop.com"
        ],
        "nl": [
          "TOUR VAN DE REMPARTIJEN - duur 1u30\nMaak een wandeling langs de vestingmuren en ontdek de geschiedenis van deze oude stad.\nTrefpunt rue de Bernet, voor de ophaalbrug van het kasteel e \"\n\nPrijs: €5 / gratis voor kinderen onder de 12 jaar.\nTickets alleen verkrijgbaar bij het Office du Tourisme of online: www.reservation.boulonnaisautop.com"
        ]
      },
