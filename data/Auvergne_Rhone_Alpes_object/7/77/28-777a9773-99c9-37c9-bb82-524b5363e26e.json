  "rdfs:comment": {
    "de": [
      "Teesalon: Große Auswahl an originalen und aromatisierten Teesorten, Kaffees aus aller Welt, Schokolade, handwerklich hergestellte Erfrischungsgetränke und Lebensmittel aus der Region. Selbst hergestellte süße Leckereien. Auf der Terrasse können Sie die Sonnenstrahlen genießen!"
    ],
    "en": [
      "Tearoom: Large selection of original and flavored teas, world coffees, chocolates, fresh artisan drinks and local groceries. Sweet treats made in-house. A terrace to soak up the sun!"
    ],
    "it": [
      "Sala da tè: ampia selezione di tè originali e aromatizzati, caffè del mondo, cioccolatini, bevande fresche artigianali e prodotti alimentari locali. Dolci fatti in casa. Una terrazza per godersi il sole!"
    ],
    "fr": [
      "Salon de thé : Grand choix de thés d'origine et parfumés, cafés du monde, chocolats, boissons fraîches artisanales et épicerie de terroirs. Gourmandises sucrées confectionnées par nos soins. Une terrasse pour profiter des rayons de soleil !"
    ],
    "nl": [
      "Tearoom: Grote selectie van originele thee en gearomatiseerde thee, wereldkoffie, bonbons, verse artisanale dranken en plaatselijke kruidenierswaren. Zoete lekkernijen van het huis. Een terras om van de zon te genieten!"
    ],
    "es": [
      "Tearoom: Amplia selección de tés originales y aromatizados, cafés del mundo, chocolates, bebidas artesanas frescas y comestibles locales. Dulces de elaboración propia. Terraza para tomar el sol"
    ]
  },
