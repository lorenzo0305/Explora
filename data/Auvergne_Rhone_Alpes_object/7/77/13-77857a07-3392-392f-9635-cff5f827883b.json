  "rdfs:comment": {
    "de": [
      "An einem Ort, der von dem intriganten Wald inspiriert ist, der das Dorf Saoû bedeckt, lädt die Modistin Sie ein, ihr Atelier und ihre Boutique zu entdecken. Ich verarbeite alle Materialien, biete alle Größen, in allen Stilen und Farben an."
    ],
    "en": [
      "In the village of Saoû, capped by the intriguing forest, the milliner invites you to discover her workshop-shop."
    ],
    "it": [
      "In un luogo ispirato all'intrigante foresta sopra il villaggio di Saoû, la modista vi invita a scoprire il suo laboratorio-bottega. Lavoro con tutti i materiali e offro tutte le misure, gli stili e i colori."
    ],
    "fr": [
      "Dans un lieu inspiré de l'intrigante forêt coiffant le village de Saoû, la modiste vous invite à découvrir son atelier-boutique. Je travaille toutes les matières, je propose toutes les tailles, dans tous les styles et toutes les couleurs."
    ],
    "nl": [
      "Op een plek geïnspireerd door het intrigerende bos boven het dorp Saoû, nodigt de hoedenmaakster je uit om haar atelier-winkel te ontdekken. Ik werk met alle materialen en bied alle maten, stijlen en kleuren aan."
    ],
    "es": [
      "En un lugar inspirado en el intrigante bosque sobre el pueblo de Saoû, la sombrerera le invita a descubrir su taller-tienda. Trabajo con todos los materiales y ofrezco todas las tallas, estilos y colores."
    ]
  },
