  "rdfs:comment": {
    "de": [
      "Entdecken Sie eine Gourmetküche, die mit Leidenschaft und Kreativität zubereitet wird. Lassen Sie sich von der Weinkarte des Besitzers verführen.\r\nDieses Restaurant trägt das Label Bistrot de Pays."
    ],
    "en": [
      "Discover a gastronomic cuisine prepared with passion and creativity, let yourself be tempted by the owners' wine list."
    ],
    "it": [
      "Scoprite la cucina gastronomica preparata con passione e creatività e lasciatevi tentare dalla carta dei vini del proprietario.\r\nQuesto ristorante ha il marchio Bistrot de Pays."
    ],
    "fr": [
      "Découvrez une cuisine gastronomique préparée avec passion et créativité, laissez vous tenter par la carte de vins de propriétaires.\r\nCe restaurant est labellisé Bistrot de Pays."
    ],
    "nl": [
      "Ontdek de gastronomische keuken bereid met passie en creativiteit, en laat je verleiden door de wijnkaart van de eigenaar.\r\nDit restaurant heeft het label Bistrot de Pays."
    ],
    "es": [
      "Descubra una cocina gastronómica preparada con pasión y creatividad, y déjese tentar por la carta de vinos del propietario.\r\nEste restaurante cuenta con la etiqueta Bistrot de Pays."
    ]
  },
