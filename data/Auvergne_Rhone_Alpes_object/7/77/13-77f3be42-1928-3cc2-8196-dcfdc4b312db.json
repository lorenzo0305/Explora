  "rdfs:comment": {
    "de": [
      "Ihr Reiseleiter führt Sie durch charmante Gassen in das Herz eines kleinen Dorfes, das ein wahres Juwel in der Region Drôme Sud Provence ist."
    ],
    "en": [
      "Your guide will lead you through the charming alleyways, in the heart of a small village, a true gem nestled in the Drôme Sud Provence region."
    ],
    "it": [
      "La guida vi condurrà lungo affascinanti stradine fino al cuore di un piccolo villaggio, un vero gioiello incastonato nella regione della Drôme Sud Provence."
    ],
    "fr": [
      "Votre guide vous conduira au fil des ruelles pleines de charme, au cœur d’un petit village, véritable joyau niché dans le territoire Drôme Sud Provence."
    ],
    "es": [
      "Su guía le llevará por encantadoras callejuelas hasta el corazón de un pequeño pueblo, una auténtica joya enclavada en la región de Drôme Sud Provence."
    ],
    "nl": [
      "Je gids neemt je mee langs charmante straatjes naar het hart van een klein dorpje, een echt juweeltje genesteld in de Drôme Sud Provence."
    ]
  },
  "rdfs:label": {
    "en": [
      "Visite commentée \"Un écrin parmi les lavandes\""
    ],
