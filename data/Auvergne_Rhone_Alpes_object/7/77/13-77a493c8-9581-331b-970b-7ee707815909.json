  "rdfs:comment": {
    "de": [
      "Ob Sie nun einen Spaziergang oder einen sportlicheren Langlaufsport betreiben, die Grande Traversée du Jura à ski de fond ist ein schöner Höhenflug auf 180 km Länge, der in Frankreich einzigartig ist."
    ],
    "en": [
      "Whether you're a cross-country skier or a more sporty type, the Grande Traversée du Jura cross-country ski tour is a 180 km long flight, the only one of its kind in France."
    ],
    "it": [
      "Che siate sciatori di fondo o più sportivi, la Grande Traversée du Jura con gli sci di fondo è un'avventura di 180 km unica in Francia."
    ],
    "fr": [
      "Que vous pratiquiez le ski de fond de promenade ou un ski de fond plus sportif, la Grande Traversée du Jura à ski de fond est une belle envolée de 180 km de long, unique en France."
    ],
    "es": [
      "Ya sea un esquiador de fondo o un esquiador más deportivo, la Grande Traversée du Jura es un hermoso recorrido de esquí de fondo de 180 km, único en Francia."
    ],
    "nl": [
      "Of je nu een langlaufer of een sportieveling bent, de Grande Traversée du Jura op langlaufski's is een 180 km lang avontuur dat uniek is in Frankrijk."
    ]
  },
