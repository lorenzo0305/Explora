  "rdfs:comment": {
    "de": [
      "Der im September 2024 eröffnete Club \"ALL IN PADEL Portes-lès-Valence\" befindet sich nur wenige Schritte vom Stadtzentrum von Valencia entfernt. Dieser Club bietet 4 Indoor-Bahnen für Padel-Fans."
    ],
    "en": [
      "The \"ALL IN PADEL Portes-lès-Valence\" club is located just a stone's throw from downtown Valence. The club offers 4 indoor courts for padel enthusiasts."
    ],
    "it": [
      "il club ALL IN PADEL Portes-lès-Valence si trova a pochi passi dal centro di Valence. Il club offre 4 campi al coperto per gli appassionati di padel."
    ],
    "fr": [
      "le club \"ALL IN PADEL Portes-lès-Valence\" est situé à deux pas du centre-ville de Valence. Ce club propose 4 pistes intérieures aux amateurs de padel."
    ],
    "es": [
      "el club ALL IN PADEL Portes-lès-Valence se encuentra a dos pasos del centro de la ciudad de Valence. El club ofrece 4 pistas cubiertas para los amantes del pádel."
    ],
    "nl": [
      "De ALL IN PADEL Portes-lès-Valence club wordt geopend in september 2024 en ligt op een steenworp afstand van het centrum van Valence. De club biedt 4 overdekte banen voor padelliefhebbers."
    ]
  },
  "rdfs:label": {
    "fr": [
      "All in Padel"
    ]
  },
