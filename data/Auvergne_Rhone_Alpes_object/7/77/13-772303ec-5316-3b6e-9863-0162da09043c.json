  "rdfs:comment": {
    "de": [
      "Ein paar Kilometer von der Ausfahrt 31 der AutobahnCL F / Lyon, empfängt Sie die Familie Balichard auf ihrem Betrieb, wo Wurstwaren vom Bauernhof und Schweinefleisch aus eigener Aufzucht sowie der Fourme de Montbrison (AOP) hergestellt werden."
    ],
    "en": [
      "A few kilometres from exit 31 on the motorway between Clermont-Ferrand and Lyon, the Balichard family invite you to visit their cattle and dairy farm where they produce traditional charcuterie, pork and PDO Fourme de Montbrison cheese."
    ],
    "it": [
      "A pochi chilometri dall'uscita 31 dell'autostrada CL F / Lione, la famiglia Balichard vi accoglie nella sua azienda agricola, dove produce salumi di fattoria e carne di maiale proveniente dalla propria fattoria e dall'agriturismo Fourme de Montbrison DOP."
    ],
    "fr": [
      "A  quelques kms de la sortie 31 de l'autoroute CL F / Lyon, la famille Balichard vous accueille sur son exploitation, où est fabriquée de la charcuterie fermière et de la viande de porc issue de son élevage et de la fourme de Montbrison fermière AOP."
    ],
    "nl": [
      "Op een paar kilometer van afrit 31 van de snelweg CL F / Lyon heet de familie Balichard u welkom op hun boerderij, waar ze boerderij charcuterie en varkensvlees van hun eigen boerderij en boerderij Fourme de Montbrison BOB produceren."
    ],
    "es": [
      "A pocos kilómetros de la salida 31 de la autopista CL F / Lyon, la familia Balichard le da la bienvenida a su granja, donde producen charcutería y carne de cerdo de su propia granja y granja Fourme de Montbrison DOP."
    ]
  },
