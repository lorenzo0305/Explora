  "rdfs:comment": {
    "de": [
      "Finden Sie Merkurs geflügelte Petase, um ihn aus der Unterwelt zu holen, oder verbünden Sie sich mit Pluto, um ihn daran zu hindern, indem Sie Zerberus befreien."
    ],
    "en": [
      "Find Mercury's winged horse to rescue him from the Underworld, or join forces with Pluto to prevent this by releasing Cerberus."
    ],
    "it": [
      "Trova il petasos alato di Mercurio per farlo uscire dagli Inferi oppure alleati con Plutone per impedirglielo liberando Cerbero."
    ],
    "fr": [
      "Retrouvez le pétase ailé de Mercure pour le faire sortir des Enfers ou alliez-vous à Pluton pour l'en empêcher en libérant Cerbère."
    ],
    "nl": [
      "Vind de gevleugelde petascus van Mercurius om hem uit de Onderwereld te halen of bundel je krachten met Pluto om hem te stoppen door Cerberus te bevrijden."
    ],
    "es": [
      "Encuentra el petasco alado de Mercurio para sacarlo del Inframundo, o une fuerzas con Plutón para detenerlo liberando a Cerbero."
    ]
  },
