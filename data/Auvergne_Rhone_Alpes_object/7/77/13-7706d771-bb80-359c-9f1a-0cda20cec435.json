  "rdfs:comment": {
    "de": [
      "Dorf Domeyrat: Romanische Kirche aus dem 12. Jahrhundert mit geschnitzten Kapitellen. Beeindruckende Überreste des Schlosses aus dem 14. Jahrhundert mit Wandmalereien aus dem 16. Mittelalterliche Brücke über den Senouire. Grabhügel auf Le Chausse."
    ],
    "en": [
      "Village of Domeyrat: 12th-century Romanesque church with carved capitals. Impressive remains of 14th-century castle with 16th-century murals. Medieval bridge over the Senouire. Burial mounds on Le Chausse."
    ],
    "it": [
      "Villaggio di Domeyrat: chiesa romanica del XII secolo con capitelli scolpiti. Impressionanti resti del castello del XIV secolo con dipinti murali del XVI secolo. Ponte medievale sul Senouire. Tumuli a Le Chausse."
    ],
    "fr": [
      "Village de Domeyrat : Église romane du XIIe siècle avec chapiteaux sculptés. Impressionnants vestiges du château du XIVe siècle avec peintures murales du XVIe siècle. Pont médiéval sur la Senouire. Tertres funéraires sur Le Chausse."
    ],
    "es": [
      "Pueblo de Domeyrat: iglesia románica del siglo XII con capiteles esculpidos. Impresionantes restos del castillo del siglo XIV con pinturas murales del siglo XVI. Puente medieval sobre el Senouire. Túmulos funerarios de Le Chausse."
    ],
    "nl": [
      "Dorp Domeyrat: Romaanse kerk uit de 12e eeuw met gebeeldhouwde kapitelen. Indrukwekkende overblijfselen van het 14e-eeuwse kasteel met 16e-eeuwse muurschilderingen. Middeleeuwse brug over de Senouire. Grafheuvels in Le Chausse."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Village | Domeyrat"
    ]
  },
