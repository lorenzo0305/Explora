  "rdfs:comment": {
    "de": [
      "AU BUREAU ist ein authentischer und einzigartiger Pub mit einem exotischen angelsächsischen Dekor. Sie werden in allen Au Bureau eine entspannte und freundliche Atmosphäre vorfinden."
    ],
    "en": [
      "True place of life, AU BUREAU is an authentic and unique pub, with an exotic Anglo-Saxon decor. You will find in all Au Bureau a relaxed and friendly atmosphere"
    ],
    "it": [
      "AU BUREAU è un pub autentico e unico, con un arredamento anglosassone. In tutti gli uffici dell'Au troverete un'atmosfera rilassata e amichevole"
    ],
    "fr": [
      "Véritable lieu de vie, AU BUREAU est un pub authentique et unique, au décor anglo-saxon dépaysant. Vous retrouverez dans tous les Au Bureau une ambiance détendue et conviviale"
    ],
    "nl": [
      "AU BUREAU is een authentieke en unieke pub, met een Angelsaksisch decor. U vindt een ontspannen en vriendelijke sfeer in alle Au Bureau"
    ],
    "es": [
      "AU BUREAU es un pub auténtico y único con una exótica decoración anglosajona. Encontrará un ambiente relajado y acogedor en todos los Au Bureau."
    ]
  },
