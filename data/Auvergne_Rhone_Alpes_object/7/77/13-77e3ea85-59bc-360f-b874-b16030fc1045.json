  "rdfs:comment": {
    "de": [
      "Vom 7. Februar bis zum 30. April 2026 findet im Hérisson Social Club eine Ausstellung des Künstlers Gilles Alexandre mit dem Titel \"Les arbres du Cachalot\" statt.\r\nFreier Zugang an den Tagen und zu den Öffnungszeiten des Igel Social Club."
    ],
    "en": [
      "From February 7 to April 30, 2026, the Hérisson Social Club is hosting an exhibition by artist Gilles Alexandre entitled \"Les arbres du Cachalot\".\r\nFree access on Hérisson Social Club opening days and times."
    ],
    "it": [
      "Dal 7 febbraio al 30 aprile 2026, l'Hérisson Social Club ospita la mostra dell'artista Gilles Alexandre \"Les arbres du Cachalot\".\r\nIngresso libero nei giorni e negli orari di apertura dell'Hérisson Social Club."
    ],
    "fr": [
      "Du 7 février au 30 avril 2026, le Hérisson Social Club accueille l'exposition de l'artiste Gilles Alexandre intitulée \"Les arbres du Cachalot\".\r\nAccès libre aux jours et horaires d'ouverture du Hérisson Social Club."
    ],
    "nl": [
      "Van 7 februari tot 30 april 2026 loopt in de Hérisson Social Club een tentoonstelling van kunstenaar Gilles Alexandre getiteld \"Les arbres du Cachalot\".\r\nGratis toegang op de openingsdagen en -uren van Hérisson Social Club."
    ],
    "es": [
      "Del 7 de febrero al 30 de abril de 2026, el Club Social Hérisson acoge una exposición del artista Gilles Alexandre titulada \"Les arbres du Cachalot\".\r\nEntrada gratuita los días y horas de apertura del Club Social de Hérisson."
    ]
  },
