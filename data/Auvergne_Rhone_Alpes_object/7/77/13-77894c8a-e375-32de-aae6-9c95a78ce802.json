  "rdfs:comment": {
    "de": [
      "Hélène ist Produzentin von Bio-Ziegenkäse in der Käserei Les Biquettes in Sembadel-Bourg.\r\nDort gibt es vor Ort frischen, überzogenen, halbfrischen und halbtrockenen Sembalou, Faselle, Aufstriche und andere Spezialitäten zum Probieren."
    ],
    "en": [
      "Hélène produces organic goat's cheese at the Biquettes cheese dairy in Sembadel-Bourg.\r\nHere you'll find fresh, coated, semi-fresh, semi-dry Sembalou, faisselles, spreads and other specialties for you to enjoy."
    ],
    "it": [
      "Hélène produce formaggio di capra biologico presso il caseificio Biquettes di Sembadel-Bourg.\r\nQui si trovano Sembalou freschi, spalmati, semi-freschi e semi-secchi, faisselles, creme spalmabili e altre specialità."
    ],
    "fr": [
      "Hélène est productrice de fromages bio de chèvre à la fromagerie des Biquettes de Sembadel-Bourg.\r\nOn y trouve sur place des Sembalou frais, enrobés, mi-frais, mi-secs, des faisselles, des tartinades et autres spécialités à déguster."
    ],
    "nl": [
      "Hélène produceert biologische geitenkaas in de kaasmakerij Biquettes in Sembadel-Bourg.\r\nHier vind je verse, gecoate, halfverse en halfdroge Sembalou, faisselles, smeersels en andere specialiteiten."
    ],
    "es": [
      "Hélène produce queso de cabra ecológico en la quesería Biquettes de Sembadel-Bourg.\r\nAquí encontrará Sembalou fresco, recubierto, semicurado y semiseco, faisselles, untables y otras especialidades."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Biquettes de Sembadel"
    ]
  },
