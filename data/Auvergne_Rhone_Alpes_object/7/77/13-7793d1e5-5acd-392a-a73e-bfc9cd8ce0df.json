  "rdfs:comment": {
    "de": [
      "Die Bibliothek bietet eine große Auswahl an Büchern, Ausstellungen, betreut außerschulische Betreuungsangebote, empfängt Schulklassen und organisiert Märchenstunden für Kinder zu bestimmten Themen."
    ],
    "en": [
      "The library offers a wide range of books and exhibitions, runs after-school activities, welcomes school classes and organizes storytelling sessions for children."
    ],
    "it": [
      "La biblioteca offre un'ampia gamma di libri e mostre, gestisce attività di doposcuola, accoglie le scolaresche e organizza sessioni di narrazione a tema per i bambini."
    ],
    "fr": [
      "La bibliothèque propose un large choix d'ouvrages, des expositions, anime les accueils périscolaires, reçoit les classes et organise des séances de conte pour les enfants autour de thèmes."
    ],
    "es": [
      "La biblioteca ofrece una amplia gama de libros y exposiciones, organiza actividades extraescolares, acoge clases escolares y organiza sesiones temáticas de cuentacuentos para niños."
    ],
    "nl": [
      "De bibliotheek biedt een breed scala aan boeken en tentoonstellingen, organiseert naschoolse activiteiten, ontvangt schoolklassen en organiseert thematische vertelsessies voor kinderen."
    ]
  },
