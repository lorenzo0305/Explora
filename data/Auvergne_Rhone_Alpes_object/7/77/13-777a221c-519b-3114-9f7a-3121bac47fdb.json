  "rdfs:comment": {
    "de": [
      "Meine Schmuckstücke und Innendekorationsobjekte sind einzigartige Kreationen. Ihre leuchtenden Farben entstehen durch die alchemistische Begegnung von Kupfer und Emaille im Feuer. Kommen Sie und lassen Sie sich in diese Magie einführen."
    ],
    "en": [
      "My jewelry and home decor items are unique creations. Their luminous colors come from the alchemical encounter of copper and enamel in fire. Come and discover this magic."
    ],
    "it": [
      "I miei gioielli e gli oggetti di design sono creazioni uniche. I loro colori luminosi nascono dall'incontro alchemico tra rame e smalto nel fuoco. Venite a cimentarvi in questa magia."
    ],
    "fr": [
      "Mes bijoux et objets de décoration intérieure sont des créations uniques. Leurs couleurs lumineuses viennent de la rencontre alchimique du cuivre et des émaux dans le feu. Venez vous initier à cette magie."
    ],
    "es": [
      "Mis joyas y objetos de interiorismo son creaciones únicas. Sus colores luminosos proceden del encuentro alquímico del cobre y el esmalte en el fuego. Venga a probar esta magia."
    ],
    "nl": [
      "Mijn sieraden en interieurobjecten zijn unieke creaties. Hun heldere kleuren komen van de alchemistische ontmoeting van koper en email in het vuur. Kom en probeer deze magie zelf."
    ]
  },
  "rdfs:label": {
