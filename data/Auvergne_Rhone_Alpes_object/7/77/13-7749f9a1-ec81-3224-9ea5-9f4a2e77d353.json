  "rdfs:comment": {
    "de": [
      "Coworking Space & Vermietung von Büros/Räumen für Meetings, Schulungen, Events und Seminare. THD-Anschluss. Flexibilität: 2 Stunden, 4 Stunden, Tag. Heller und freundlicher Rahmen im Stadtzentrum. Flexibler Zugang, angepasst an Ihre Bedürfnisse"
    ],
    "en": [
      "Coworking space & office/meeting room rental, training, events and seminars. THD connection. Flexibility: 2h, 4h, full day. Bright, friendly downtown setting. Flexible access, adapted to your needs"
    ],
    "it": [
      "Spazio di coworking e affitto di uffici/sale riunioni, formazione, eventi e seminari. Connessione THD. Flessibilità: 2 ore, 4 ore, tutto il giorno. Ambiente luminoso e accogliente nel centro della città. Accesso flessibile, adattato alle vostre esigenze"
    ],
    "fr": [
      "Espace coworking & location de bureaux/salles de réunion, formation, événementiel et séminaire. Connexion THD. Flexibilité : 2h, 4h, journée. Cadre lumineux et convivial en centre-ville. Accès souple, adapté selon vos besoins"
    ],
    "es": [
      "Espacio de coworking y alquiler de oficinas/salas de reuniones, formación, eventos y seminarios. Conexión THD. Flexibilidad: 2h, 4h, todo el día. Entorno luminoso y acogedor en el centro de la ciudad. Acceso flexible, adaptado a sus necesidades"
    ],
    "nl": [
      "Coworkingruimte & verhuur van kantoren/vergaderruimten, training, evenementen en seminars. Aansluiting THD. Flexibiliteit: 2u, 4u, hele dag. Heldere, vriendelijke omgeving in het stadscentrum. Flexibele toegang, aangepast aan uw behoeften"
    ]
  },
