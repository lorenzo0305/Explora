  "rdfs:comment": {
    "de": [
      "Zusammen mit Maurs bildet Saint-Étienne-de-Maurs den viertgrößten Ballungsraum des Cantal und das wichtigste Zentrum der Châtaigneraie. Das Wohn- und Geschäftsgesicht, das die Gemeinde auf den ersten Blick zeigt, verbirgt ein reiches und vielfältiges Kulturerbe."
    ],
    "en": [
      "Along with Maurs, Saint-Étienne-de-Maurs is the fourth largest agglomeration in Cantal and the main centre of the Châtaigneraie. At first glance, the village's residential and commercial appearance masks an abundant and varied heritage."
    ],
    "it": [
      "Insieme a Maurs, Saint-Étienne-de-Maurs è la quarta città più grande del Cantal e il centro principale della regione della Châtaigneraie. A prima vista, l'aspetto residenziale e commerciale della città nasconde un patrimonio abbondante e variegato."
    ],
    "fr": [
      "Avec Maurs, Saint-Étienne-de-Maurs constitue la quatrième agglomération du Cantal et le principal pôle de la Châtaigneraie. Le visage résidentiel et commercial que présente la commune au premier abord masque un patrimoine abondant et varié."
    ],
    "nl": [
      "Saint-Étienne-de-Maurs is samen met Maurs de vierde grootste agglomeratie van de Cantal en het belangrijkste centrum van de Châtaigneraie. Op het eerste gezicht verhult het residentiële en commerciële uiterlijk van het dorp een rijk en gevarieerd erfgoed."
    ],
    "es": [
      "Saint-Étienne-de-Maurs es, junto con Maurs, la cuarta ciudad del Cantal y el centro principal de la región de Châtaigneraie. A primera vista, el aspecto residencial y comercial de la ciudad oculta un patrimonio abundante y variado."
    ]
  },
