  "rdfs:comment": {
    "de": [
      "Das in der Domaine de Gorneton in Chasse-sur-Rhône gelegene Restaurant \"Les Nymphéas\" empfängt Sie zu einem geselligen und geschmacklichen Austausch in einer wunderschönen Umgebung."
    ],
    "en": [
      "Located in the heart of Domaine de Gorneton in Chasse-sur-Rhône, \"Les Nymphéas\" restaurant welcomes you for a moment of friendly, tasty sharing in a magnificent setting."
    ],
    "it": [
      "Situato nel Domaine de Gorneton a Chasse-sur-Rhône, il ristorante \"Les Nymphéas\" vi accoglie per condividere un momento di convivialità e gusto, in un ambiente magnifico."
    ],
    "fr": [
      "Situé au sein du Domaine de Gorneton à Chasse-sur-Rhône, le restaurant \"Les Nymphéas\" vous accueille pour un moment de partage convivial et gustatif, dans un cadre magnifique."
    ],
    "es": [
      "Situado en el Domaine de Gorneton, en Chasse-sur-Rhône, el restaurante \"Les Nymphéas\" le da la bienvenida para compartir un momento de convivencia y sabor, en un marco magnífico."
    ],
    "nl": [
      "Gelegen op het Domaine de Gorneton in Chasse-sur-Rhône, verwelkomt het restaurant \"Les Nymphéas\" u voor een moment van gezelligheid en smaak, in een prachtige omgeving."
    ]
  },
