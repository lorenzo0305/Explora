      "@id": "https://data.datatourisme.fr/45a406da-7353-3bfa-9d11-5e8da54ac85c",
      "dc:description": {
        "de": [
          "Warme oder kalte Gerichte, vor Ort oder zum Mitnehmen, wir können Ihnen nach Ihrem Geschmack und Ihren Wünschen Menüs für bis zu 300 Personen zubereiten."
        ],
        "en": [
          "Hot or cold dishes, on the spot or to take away, we can prepare menus for up to 300 people according to your tastes and desires."
        ],
        "it": [
          "Piatti caldi o freddi, sul posto o da asporto, possiamo preparare menu per un massimo di 300 persone secondo i vostri gusti e desideri."
        ],
        "fr": [
          "Plats chauds ou plats froids, sur place ou à emporter, nous pouvons vous préparez selon vos goûts et vos envies des menus jusqu'à 300 personnes."
        ],
        "nl": [
          "Warme of koude gerechten, ter plaatse of om mee te nemen, wij bereiden menu's voor tot 300 personen volgens uw smaak en wensen."
        ],
        "es": [
          "Platos calientes o fríos, en el momento o para llevar, podemos preparar menús para hasta 300 personas según sus gustos y deseos."
        ]
      },
