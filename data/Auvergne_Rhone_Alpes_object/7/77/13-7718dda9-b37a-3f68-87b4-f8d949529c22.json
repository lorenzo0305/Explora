  "rdfs:comment": {
    "de": [
      "Orion pflückt, kultiviert und verarbeitet Heilpflanzen zu ätherischen Ölen, Hydrolaten, Seifen und Kosmetika.\r\nAlle Produkte stammen aus biologischem Anbau."
    ],
    "en": [
      "Orion gathers, cultivates and transforms medicinal plants into essential oils, hydrolats, soaps and cosmetics.\r\nAll products are organically grown."
    ],
    "it": [
      "Orion raccoglie, coltiva e trasforma le piante medicinali in oli essenziali, idrolati, saponi e cosmetici.\r\nTutti i nostri prodotti sono coltivati con metodo biologico."
    ],
    "fr": [
      "Orion cueille, cultive et transforme des plantes médicinales en huiles essentielles, hydrolats, savons et cosmétiques.\r\nTous les produits sont issus de l’agriculture biologique."
    ],
    "nl": [
      "Orion verzamelt, kweekt en verwerkt geneeskrachtige planten tot essentiële oliën, hydrolaten, zepen en cosmetica.\r\nAl onze producten zijn biologisch geteeld."
    ],
    "es": [
      "Orion recolecta, cultiva y transforma plantas medicinales en aceites esenciales, hidrolatos, jabones y cosméticos.\r\nTodos nuestros productos son de cultivo ecológico."
    ]
  },
