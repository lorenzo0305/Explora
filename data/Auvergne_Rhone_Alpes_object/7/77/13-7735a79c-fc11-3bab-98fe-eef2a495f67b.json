  "rdfs:comment": {
    "de": [
      "raum ganz aus Holz, sehr gemütlich mit Pelletofen, ausgestattet mit Yogamatten, Zafu, Tischen und Stühlen, einer kleinen Bühne und mit direktem Blick auf den Park mit einer schönen befestigten Esplanade (Aufbau von Barnum, Stühlen, Yoga im Freien"
    ],
    "en": [
      "wooden room, very comfortable with its pellet stove, equipped with yoga mats, zafu, tables and chairs, a small stage and directly overlooking the park with a beautiful hard esplanade (installation of barnum, chairs, outdoor yoga)"
    ],
    "it": [
      "sala in legno, molto confortevole con la sua stufa a pellet, attrezzata con tappetini per lo yoga, zafu, tavoli e sedie, un piccolo palco e che dà direttamente sul parco con una bella spianata dura (installazione di barnum, sedie, yoga all'aperto, ecc)"
    ],
    "fr": [
      "salle tout en bois, très confortable avec son poêle à granules, équipée de tapis de yoga, zafu, tables et chaises, une petite estrade et donnant directement sur le parc avec une belle esplanade en dur (installation de barnum, de chaises, yoga en plein air"
    ],
    "es": [
      "sala de madera, muy confortable con su estufa de pellets, equipada con esterillas de yoga, zafu, mesas y sillas, un pequeño escenario y dando directamente sobre el parque con una hermosa explanada dura (instalación de barnum, sillas, yoga al aire libre, etc.)"
    ],
    "nl": [
      "houten kamer, zeer comfortabel met zijn pelletkachel, uitgerust met yogamatten, zafu, tafels en stoelen, een klein podium en geeft direct aan het park met een prachtige harde esplanade (installatie van barnum, stoelen, outdoor yoga, enz.)"
    ]
  },
  "rdfs:label": {
    "fr": [
