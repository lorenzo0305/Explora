  "rdfs:comment": {
    "de": [
      "Handwerkliche und ökologisch verantwortliche Boutique. Kreative Schneiderei für Null-Abfall, Wellness und Mode.  Kreationen, die die Erde und Ihren Stil respektieren (Abschminktücher, Abdeckschalen, Haargummis, Kosmetiktaschen, Maxi-Tragetaschen, Yogakissen, Bananenbeutel usw.)"
    ],
    "en": [
      "Artisanal and eco-responsible boutique. Sewing creations for zero waste, well-being and fashion.  Creations that respect the earth and your style (make-up remover wipes, bowl covers, fabric bags, yoga cushions, etc.)."
    ],
    "it": [
      "Negozio artigianale ed eco-responsabile. Creazioni di cucito a rifiuti zero, benessere e moda.  Creazioni che rispettano la terra e il vostro stile (salviette struccanti, copriscatole, scrunchies, portamatite, maxi borse, cuscini per lo yoga, marsupi, ecc.)"
    ],
    "fr": [
      "Boutique artisanale et éco-responsable. Création couture zéro déchet, bien-être, mode.  Des créations qui respectent la terre et votre style. (lingette démaquillante, recouvre bol, chouchous, trousse, maxi cabas, coussin de yoga, sac banane, etc.)"
    ],
    "es": [
      "Tienda artesanal y eco-responsable. Creaciones de costura para el residuo cero, el bienestar y la moda.  Creaciones que respetan la tierra y tu estilo (toallitas desmaquillantes, fundas para cuencos, coleteros, estuches para lápices, maxibolsos, cojines de yoga, riñoneras, etc.)"
    ],
    "nl": [
      "Ambachtelijke en ecologisch verantwoorde winkel. Naaicreaties voor zero waste, welzijn en mode.  Creaties die de aarde en jouw stijl respecteren (make-upverwijderingsdoekjes, komhoezen, scrunchies, etuis, maxitassen, yogakussens, heuptasjes, enz.)"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Au pied de l'Aiguille"
    ]
