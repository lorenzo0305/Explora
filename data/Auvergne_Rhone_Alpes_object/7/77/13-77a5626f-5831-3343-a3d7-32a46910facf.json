  "rdfs:comment": {
    "de": [
      "Wifi ist kostenlos. Zimmer mit Aussicht und Balkon. Renovierungen jedes Jahr.Zimmer im Erdgeschoss verfügbar. Wanderer: Wanderrouten stehen zur Verfügung. Ermäßigungen für Aufenthalte außerhalb der Schulferien. Voll ausgestattete Mansarden zum kleinen Preis mit herrlicher Aussicht. Gruppen bis zu 60 Personen."
    ],
    "en": [
      "Free wifi. Rooms with view and balcony. Rooms on the ground floor available. Hikers, itineraries available. Discounts for stays outside school holidays. Fully equipped attic rooms at a low price with superb views. Groups up to 60 people"
    ],
    "it": [
      "Wi-Fi gratuito. Camere con vista e balcone. Ristrutturazione annuale. Disponibili camere al piano terra. Escursionisti: percorsi disponibili. Sconti per soggiorni al di fuori delle vacanze scolastiche. Mansarde completamente attrezzate a prezzi bassi con una vista superba. Gruppi fino a 60 persone."
    ],
    "fr": [
      "Wifi gratuit. Chambres avec vue et balcon. Rénovations chaque année.Chambres RDC disponibles. Randonneurs : itinéraires à disposition. Réductions séjours hors vac scolaires. Mansardes toutes équipées à petit prix avec superbe vue. Groupes jusqu'à 60 pers."
    ],
    "es": [
      "Wi-Fi gratuito. Habitaciones con vistas y balcón. Renovaciones todos los años.Habitaciones en planta baja disponibles. Senderistas: rutas disponibles. Descuentos en estancias fuera de vacaciones escolares. Áticos totalmente equipados a precios económicos con magníficas vistas. Grupos de hasta 60 personas."
    ],
    "nl": [
      "Gratis WiFi. Kamers met uitzicht en balkon. Renovaties elk jaar.Kamers op de begane grond beschikbaar. Wandelaars: routes beschikbaar. Kortingen op verblijf buiten de schoolvakanties. Volledig ingerichte zolders tegen lage prijzen met prachtig uitzicht. Groepen tot 60 personen."
    ]
  },
