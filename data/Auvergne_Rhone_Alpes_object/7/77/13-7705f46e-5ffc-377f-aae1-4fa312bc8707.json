  "rdfs:comment": {
    "de": [
      "Die Hütte befindet sich auf der Alm von Chardonnière. Der Empfang ist herzlich und die Atmosphäre familiär. Wir können Sie für die Nacht in einem unserer beiden Schlafsäle oder für eine authentische und reichhaltige Mahlzeit am Mittag empfangen."
    ],
    "en": [
      "The refuge is located on the Chardonnière mountain pasture. It offers a warm welcome and a family atmosphere. We can welcome you for the night in one of our two dormitories, or for a hearty authentic meal at lunchtime."
    ],
    "it": [
      "Il rifugio si trova sull'alpeggio di Chardonnière. Offre un'accoglienza calorosa e un'atmosfera familiare. Possiamo accogliervi per la notte in uno dei nostri due dormitori o per un abbondante pasto autentico a pranzo."
    ],
    "fr": [
      "Le refuge est situé sur l'alpage de Chardonnière. L'accueil y est chaleureux et l'ambiance familiale. Nous pouvons vous accueillir pour la nuit dans l'un de nos deux dortoirs, ou pour un repas authentique et copieux le midi."
    ],
    "es": [
      "El refugio está situado en los pastos de la montaña Chardonnière. Ofrece una cálida acogida y un ambiente familiar. Podemos acogerle para pasar la noche en uno de nuestros dos dormitorios, o para una comida abundante y auténtica a la hora del almuerzo."
    ],
    "nl": [
      "De berghut ligt op de alpenweide van de Chardonnière. Het biedt een warm welkom en een familiale sfeer. Je kunt bij ons overnachten in een van onze twee slaapzalen of 's middags genieten van een stevige authentieke maaltijd."
    ]
  },
  "rdfs:label": {
    "en": [
      "Chardonnière refuge"
    ],
    "fr": [
      "Refuge de Chardonnière"
    ],
    "nl": [
      "Chardonnière schuilplaats"
    ]
  },
