  "rdfs:comment": {
    "de": [
      "Die Miellerie du Trifoulou lädt Sie ein, ihre Honige aus der Ardèche und der Haute-Loire, ihren Pollen und ihre hausgemachten Lebkuchen zu entdecken. Authentische Produkte, die aus einer leidenschaftlichen und respektvollen Imkerei stammen."
    ],
    "en": [
      "La Miellerie du Trifoulou invites you to discover its Ardèche and Haute-Loire honeys, pollen and homemade gingerbread. Authentic products from passionate, respectful beekeeping."
    ],
    "it": [
      "La Miellerie du Trifoulou vi invita a scoprire i suoi mieli dell'Ardèche e dell'Alta Loira, il polline e il pan di zenzero fatto in casa. Prodotti autentici, frutto di un'apicoltura appassionata e rispettosa."
    ],
    "fr": [
      "La Miellerie du Trifoulou vous invite à découvrir ses miels d'Ardèche et de Haute-Loire, son pollen et ses pains d'épices maison. Des produits authentiques issus d'une apiculture passionnée et respectueuse."
    ],
    "es": [
      "La Miellerie du Trifoulou le invita a descubrir sus mieles de Ardèche y Alto Loira, su polen y su pan de especias casero. Productos auténticos de una apicultura apasionada y respetuosa."
    ],
    "nl": [
      "De Miellerie du Trifoulou nodigt u uit om zijn honing uit de Ardèche en de Haute-Loire, stuifmeel en zelfgemaakte peperkoek te ontdekken. Authentieke producten van gepassioneerde, respectvolle bijenteelt."
    ]
  },
  "rdfs:label": {
