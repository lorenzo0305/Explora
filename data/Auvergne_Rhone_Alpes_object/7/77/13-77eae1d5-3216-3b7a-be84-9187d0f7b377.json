  "rdfs:comment": {
    "de": [
      "Der Zugang ist frei. Der Parc des Bécauds war das Eigentum des Republikaners Georges Gallay, der im 19. Jahrhundert Bürgermeister von Neuilly-en-Donjon war. Als erbitterter Gegner von Napoleon III. nahm er an der Revolte der Republikaner in Donjon gegen den Staatsstreich vom 2. Dezember 1851 teil."
    ],
    "en": [
      "Free access. The Bécauds park was owned by the republican Georges Gallay, mayor of Neuilly-en-Donjon in the 19th century. A fierce opponent to Napoleon III, he took part in the revolt of the Republicans in Dungeon against the coup d'état of December 2, 1851."
    ],
    "it": [
      "Accesso libero. Il parco Bécauds era di proprietà del repubblicano Georges Gallay, sindaco di Neuilly-en-Donjon nel XIX secolo. Feroce oppositore di Napoleone III, partecipò alla rivolta dei repubblicani del Donjon contro il colpo di Stato del 2 dicembre 1851."
    ],
    "fr": [
      "Accès libre. Le parc des Bécauds était la propriété du républicain Georges Gallay, maire de Neuilly-en-Donjon au XIXe siècle. Farouche opposant à Napoléon III, il prit part à la révolte des républicains donjonnais contre le coup d'État du 2 décembre 1851."
    ],
    "nl": [
      "Vrije toegang. Het park Bécauds was eigendom van de republikein Georges Gallay, burgemeester van Neuilly-en-Donjon in de 19e eeuw. Als fel tegenstander van Napoleon III nam hij deel aan de opstand van de republikeinen van Donjon tegen de staatsgreep van 2 december 1851."
    ],
    "es": [
      "Acceso gratuito. El parque Bécauds era propiedad del republicano Georges Gallay, alcalde de Neuilly-en-Donjon en el siglo XIX. Feroz opositor a Napoleón III, participó en la revuelta de los republicanos de Donjon contra el golpe de Estado del 2 de diciembre de 1851."
    ]
  },
