  "rdfs:comment": {
    "de": [
      "Lust auf einen guten Burger mit hausgemachten Pommes frites? Dann ist Chez Dimo genau das Richtige für Sie! Das Bar-Restaurant lädt auch zu einem Drink mit Freunden ein und als Bonus gibt es ein Brett dazu"
    ],
    "en": [
      "Fancy a good burger with home fries? Chez Dimo is the place to be! The bar-restaurant also welcomes you to have a drink with friends and as a bonus, how about a board to accompany it?"
    ],
    "it": [
      "Avete voglia di un buon hamburger con patatine fritte? Dimo's è il posto giusto! Il bar-ristorante vi accoglie anche per bere un drink con gli amici e, come bonus, che ne dite di una tavola da accompagnare?"
    ],
    "fr": [
      "Envie d'un bon burger avec des frites maison ? C'est Chez Dimo que ça se passe ! Le bar-restaurant vous accueille également pour prendre un verre entre amis et en bonus, que diriez-vous d'une planche pour l’accompagner ?"
    ],
    "es": [
      "¿Te apetece una buena hamburguesa con patatas fritas caseras? Dimo's es el lugar ideal El bar-restaurante también te da la bienvenida para tomar una copa con los amigos y, como extra, ¿qué tal una tabla para acompañar?"
    ],
    "nl": [
      "Zin in een goede hamburger met friet? Bij Dimo's kun je terecht! In het bar-restaurant kunt u ook terecht voor een drankje met vrienden en wat dacht u van een bord erbij?"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Chez Dimo"
    ]
  },
