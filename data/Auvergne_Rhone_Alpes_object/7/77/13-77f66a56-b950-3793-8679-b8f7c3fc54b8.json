  "rdfs:comment": {
    "de": [
      "Das Hameau du Kashmir wurde wie ein kleiner Weiler im Herzen von Val Thorens erbaut und bietet im Winter wie im Sommer ein sanftes Eintauchen in die Bergwelt. Eine Welt, in der die Gipfel nicht mehr durch Grenzen getrennt sind."
    ],
    "en": [
      "Built like a small hamlet in the heart of Val Thorens, the Hameau du Kashmir offers a gentle immersion in the mountains, winter and summer alike. A world where the summits are no longer separated by borders."
    ],
    "it": [
      "Costruito come un piccolo borgo nel cuore della Val Thorens, l'Hameau du Kashmir offre una dolce immersione nella montagna, sia in inverno che in estate. Un mondo in cui le cime non sono più separate da confini."
    ],
    "fr": [
      "Construit comme un petit hameau au coeur de Val Thorens, le Hameau du Kashmir offre une douce immersion en montagne hiver comme été. Un monde où les sommets ne sont plus séparés par les frontières."
    ],
    "nl": [
      "Gebouwd als een klein gehucht in het hart van Val Thorens, biedt het Hameau du Kashmir een zachte onderdompeling in de bergen, zowel in de winter als in de zomer. Een wereld waar de toppen niet langer worden gescheiden door grenzen."
    ],
    "es": [
      "Construido como una pequeña aldea en el corazón de Val Thorens, el Hameau du Kashmir ofrece una suave inmersión en la montaña, tanto en invierno como en verano. Un mundo donde las cumbres ya no están separadas por fronteras."
    ]
  },
  "rdfs:label": {
