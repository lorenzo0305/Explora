  "rdfs:comment": {
    "de": [
      "Dieser Bereich mit Blick auf die Wasserwelt ist dem Fitness-, Kraft- und Fitnesstraining sowie dem Wellness gewidmet.\r\nZugang ab 16 Jahren."
    ],
    "en": [
      "Overlooking the pool, this area is dedicated to fitness, bodybuilding and getting back into shape without forgetting well-being.\r\nAvailable from 16 years old."
    ],
    "it": [
      "Affacciato sul mondo acquatico, questo spazio è dedicato al fitness, al bodybuilding e al rimettersi in forma senza dimenticare il benessere.\r\nDisponibile dai 16 anni."
    ],
    "fr": [
      "Surplombant l'univers aquatique, cet espace est dédié au fitness, à la musculation et remise en forme sans oublier le bien-être.\r\nAccessible à partir de 16 ans."
    ],
    "nl": [
      "Met uitzicht op het water is deze ruimte gewijd aan fitness, krachttraining en weer in vorm komen, en niet te vergeten welzijn.\r\nToegankelijk vanaf 16 jaar."
    ],
    "es": [
      "Con vistas al mundo acuático, este espacio está dedicado al fitness, la musculación y la puesta en forma, sin olvidar el bienestar.\r\nAccesible a partir de los 16 años."
    ]
  },
