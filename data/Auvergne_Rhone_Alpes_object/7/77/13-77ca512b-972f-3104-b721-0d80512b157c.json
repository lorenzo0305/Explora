  "rdfs:comment": {
    "de": [
      "Patronatsfest in Saint-Georges-d'Aurac mit folgendem Programm: Petanque-Wettbewerb, Tanz mit Folly Night, Tanzessen unter der Leitung von Dynamic Emotion, Feuerwerk, Feuershow, Zirkuseinführung und Animation der Batala Massif..."
    ],
    "en": [
      "Saint-Georges-d'Aurac patron saint's day: pétanque competition, ball with Folly Night, dinner dance with Dynamic Emotion, fireworks, fire show, circus initiation and entertainment by the Massif batala..."
    ],
    "it": [
      "La festa patronale di Saint-Georges-d'Aurac prevede una gara di pétanque, un ballo con Folly Night, una cena danzante con Dynamic Emotion, fuochi d'artificio, uno spettacolo di fuoco, un'iniziazione al circo e l'animazione del Massif batala..."
    ],
    "fr": [
      "Fête patronale de Saint-Georges-d'Aurac avec au programme, concours de pétanque, bal avec Folly Night, repas dansant animé par Dynamic Emotion, feu d'artifice, spectacle de feu, initiation de cirque et animation de la batala Massif..."
    ],
    "es": [
      "Las fiestas patronales de Saint-Georges-d'Aurac incluyen un concurso de petanca, un baile con Folly Night, una cena-baile con Dynamic Emotion, fuegos artificiales, un espectáculo de fuego, iniciación al circo y animación a cargo de la batala Massif..."
    ],
    "nl": [
      "Het patroonsfeest van Saint-Georges-d'Aurac omvat een jeu de boules wedstrijd, een bal met Folly Night, een diner dans met Dynamic Emotion, vuurwerk, een vuurshow, circus initiatie en entertainment door het Massif batala..."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Fête patronale | Saint-Georges-d'Aurac"
    ]
  },
