  "rdfs:comment": {
    "de": [
      "Misteur Couleur ist ein Illustrator, Maler und Lehrer.\r\nEr wollte ein Schneckenrennen darstellen, um die Bedeutung von Geduld und Ausdauer hervorzuheben."
    ],
    "en": [
      "Misteur Couleur is an illustrator, painter and teacher.\r\nHe wanted to depict a snail race to highlight the importance of patience and perseverance."
    ],
    "it": [
      "Misteur Couleur è un illustratore, pittore e insegnante.\r\nHa voluto raffigurare una corsa di lumache per sottolineare l'importanza della pazienza e della perseveranza."
    ],
    "fr": [
      "Misteur Couleur est un illustrateur, peintre et enseignant.\r\nIl a souhaité représenter une course d'escargots pour mettre en avant l'importance de la patience et de la persévérance."
    ],
    "nl": [
      "Misteur Couleur is illustrator, schilder en docent.\r\nHij wilde een slakkenrace uitbeelden om het belang van geduld en doorzettingsvermogen te benadrukken."
    ],
    "es": [
      "Misteur Couleur es ilustrador, pintor y profesor.\r\nQuiso representar una carrera de caracoles para destacar la importancia de la paciencia y la perseverancia."
    ]
  },
  "rdfs:label": {
