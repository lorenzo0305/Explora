  "rdfs:comment": {
    "de": [
      "Kommunikationsagentur, die mit einem Verlag für Postkarten und touristische Objekte verbunden ist, im Dienste unserer Kunden Handwerker, Händler, Landwirte, Vereine, Tourismusorganisationen und Stadtverwaltungen (Werbung, Kommunikation, Verlagswesen)."
    ],
    "en": [
      "Communication agency coupled with an activity of publishing postcards and tourist objects, at the service of our customers craftsmen, shopkeepers, farmers, associations, tourist organizations and town halls (advertising, communication, publishing)."
    ],
    "it": [
      "Agenzia di comunicazione abbinata a un'attività di pubblicazione di cartoline e oggetti turistici, al servizio dei nostri clienti artigiani, commercianti, agricoltori, associazioni, organizzazioni turistiche e municipi (pubblicità, comunicazione, editoria)."
    ],
    "fr": [
      "Agence de communication couplée à une activité d'édition de cartes postales et objets touristiques, au service de nos clients artisans, commerçants, agriculteurs, associations, organismes touristique et mairies (publicité, communication, édition)."
    ],
    "nl": [
      "Communicatiebureau gekoppeld aan een activiteit van publicatie van postkaarten en toeristische voorwerpen, ten dienste van onze klanten ambachtslieden, winkeliers, landbouwers, verenigingen, toeristische organisaties en gemeentehuizen (reclame, communicatie, publicatie)."
    ],
    "es": [
      "Agencia de comunicación asociada a una actividad de edición de tarjetas postales y objetos turísticos, al servicio de nuestros clientes artesanos, comerciantes, agricultores, asociaciones, organizaciones turísticas y ayuntamientos (publicidad, comunicación, edición)."
    ]
  },
