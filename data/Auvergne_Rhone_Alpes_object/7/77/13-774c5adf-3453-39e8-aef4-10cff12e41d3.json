  "rdfs:comment": {
    "de": [
      "Das Quatuor Résonance bietet ein Programm mit Musik, die teuflische und sardonische Wesen und Themen in Originaltranskriptionen beschwört. Mozart, Debussy, Mussorgsky, Saint-Saens, Falla?"
    ],
    "en": [
      "The Quatuor Résonance offers a program of music evoking diabolical and sardonic beings and themes, in original transcriptions. Mozart, Debussy, Moussorgsky, Saint-Saens, Falla?"
    ],
    "it": [
      "Il Quatuor Résonance propone un programma di musica che evoca esseri e temi diabolici e sardonici, in trascrizioni originali. Mozart, Debussy, Moussorgsky, Saint-Saens, Falla?"
    ],
    "fr": [
      "Le Quatuor Résonance propose un programme de musiques évoquant des êtres et des thématiques diaboliques et sardoniques, dans des transcriptions originales. Mozart, Debussy, Moussorgsky, Saint-Saens, Falla…"
    ],
    "nl": [
      "Het Quatuor Résonance biedt een programma met muziek die duivelse en sardonische wezens en thema's oproept, in originele transcripties. Mozart, Debussy, Moussorgsky, Saint-Saens, Falla?"
    ],
    "es": [
      "El Quatuor Résonance ofrece un programa de música que evoca seres y temas diabólicos y sardónicos, en transcripciones originales. Mozart, Debussy, Moussorgsky, Saint-Saens, Falla?"
    ]
  },
  "rdfs:label": {
