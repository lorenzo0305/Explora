  "rdfs:comment": {
    "de": [
      "Das Haus d'Arlandes, auch Haus der Herren genannt, hat eine Renaissancefassade aus dem 16. Jahrhundert mit zahlreichen Kreuz- und Querbalkenfenstern und einem Eckturm, hinter dem sich eine Wendeltreppe verbirgt."
    ],
    "en": [
      "The Maison d'Arlandes, also known as the Maison des Seigneurs, features a 16th-century Renaissance facade with numerous cross and transom windows and a corner tower concealing a spiral staircase."
    ],
    "it": [
      "La casa di Arlandes, nota anche come Casa dei Signori, presenta una facciata rinascimentale del XVI secolo con numerose finestre a croce e a traforo e una torre angolare che nasconde una scala a chiocciola."
    ],
    "fr": [
      "La maison d'Arlandes dite également la maison des Seigneurs, sa façade Renaissance du 16 ème siècle comporte de nombreuses fenêtres à croisée et à traverse et une tour d'angle cachant un escalier à vis."
    ],
    "nl": [
      "Maison d'Arlandes, ook bekend als Maison des Seigneurs, heeft een renaissancegevel uit de 16e eeuw, met veel kruis- en bovenramen en een hoektoren die een wenteltrap verbergt."
    ],
    "es": [
      "La casa de Arlandes, también conocida como la Casa de los Señores, tiene una fachada renacentista del siglo XVI con numerosas ventanas de cruz y travesaño y una torre de esquina que esconde una escalera de caracol."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La maison d'Arlempde"
    ]
  },
