  "rdfs:comment": {
    "de": [
      "Vinescence lädt Sie ein, in der Geselligkeit des Beaujolais die Subtilität seines Weinsortiments mit einer Diversifizierung aller Appellationen des Beaujolais-Terroirs zu entdecken. Nutzen Sie den Weinkeller, um die Jahrgänge des Jahres zu verkosten!"
    ],
    "en": [
      "Vinescence invites you to discover the subtlety of its wine range with all the appellations of the Beaujolais terroir. Enjoy the cellar to taste the crus of the year!"
    ],
    "it": [
      "Vinescence vi invita a scoprire la finezza della sua gamma di vini in un'atmosfera amichevole del Beaujolais, con una diversificazione di tutte le denominazioni del Beaujolais. Approfittate della cantina per degustare le annate dell'anno!"
    ],
    "fr": [
      "Vinescence vous invite à découvrir dans la convivialité beaujolaise la subtilité de sa gamme de vins avec une diversification de toutes les appellations du terroir Beaujolais. Profitez de la cave pour déguster les crus de l'année !"
    ],
    "nl": [
      "Vinescence nodigt je uit om de subtiliteit van zijn wijnassortiment te ontdekken in een gezellige Beaujolais-sfeer, met een diversifiëring van alle Beaujolais appellations. Profiteer van de kelder om de jaargangen te proeven!"
    ],
    "es": [
      "Vinescence le invita a descubrir la sutileza de su gama de vinos en un ambiente acogedor de Beaujolais, con una diversificación de todas las denominaciones de Beaujolais. ¡Aproveche la bodega para degustar las añadas del año!"
    ]
  },
