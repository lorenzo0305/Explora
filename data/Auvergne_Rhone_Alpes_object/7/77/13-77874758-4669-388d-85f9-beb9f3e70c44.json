  "rdfs:comment": {
    "de": [
      "Im 18. Jahrhundert war die Rue Saint-François (d'Assise) der Ort zweier bedeutender Ereignisse. Das erste ist die Begegnung zwischen dem späteren Philosophen Jean-Jacques Rousseau und Madame de Warens, das zweite der Bau eines Bischofspalastes."
    ],
    "en": [
      "In the 18th century, the rue Saint-François (d'Assise) is the site of two important events. The first is the meeting between the future philosopher Jean-Jacques Rousseau and Madame de Warens, the second is the construction of an episcopal palace."
    ],
    "it": [
      "Nel XVIII secolo, la rue Saint-François (d'Assise) fu teatro di due eventi significativi. Il primo fu l'incontro tra il futuro filosofo Jean-Jacques Rousseau e Madame de Warens, mentre il secondo fu la costruzione di un palazzo vescovile."
    ],
    "fr": [
      "Au 18e siècle, la rue Saint-François (d'Assise) est le lieu de deux faits marquants. Le premier est la rencontre entre le futur philosophe Jean-Jacques Rousseau et Madame de Warens, le deuxième est la construction d'un palais épiscopal."
    ],
    "nl": [
      "In de 18e eeuw vonden in de rue Saint-François (d'Assise) twee belangrijke gebeurtenissen plaats. De eerste was de ontmoeting tussen de toekomstige filosoof Jean-Jacques Rousseau en Madame de Warens, en de tweede was de bouw van een bisschoppelijk paleis."
    ],
    "es": [
      "En el siglo XVIII, la calle Saint-François (d'Assise) fue escenario de dos acontecimientos importantes. El primero fue el encuentro entre el futuro filósofo Jean-Jacques Rousseau y Madame de Warens, y el segundo la construcción de un palacio episcopal."
    ]
  },
