  "rdfs:comment": {
    "de": [
      "Die Ausgabe 2026 des Festivals Contes et autres Clérieuzités bietet Märchenaufführungen, Geschichten für alle Altersgruppen und für jedes Publikum rund um das Thema Migration. Animationen sr Clérieux, Saint-Bardoux und Granges-les-Beaumont."
    ],
    "en": [
      "The 2026 edition of the Contes et autres Clérieuzités festival offers storytelling performances and stories for all ages and all audiences on the theme of migration. Events in Clérieux, Saint-Bardoux and Granges-les-Beaumont."
    ],
    "it": [
      "L'edizione 2026 del festival Contes et autres Clérieuzités propone spettacoli di narrazione e storie per tutte le età e tutti i pubblici sul tema della migrazione. Eventi a Clérieux, Saint-Bardoux e Granges-les-Beaumont."
    ],
    "fr": [
      "L'édition 2026 du festival Contes et autres Clérieuzités propose des spectacles de contes, des histoires pour tous les âges et pour tous les publics autour du thème des Migrations. Animations sr Clérieux, Saint-Bardoux et Granges-les-Beaumont."
    ],
    "es": [
      "La edición 2026 del festival Contes et autres Clérieuzités propone espectáculos de cuentacuentos e historias para todas las edades y todos los públicos sobre el tema de la migración. Eventos en Clérieux, Saint-Bardoux y Granges-les-Beaumont."
    ],
    "nl": [
      "De editie 2026 van het festival Contes et autres Clérieuzités biedt vertelvoorstellingen en verhalen voor alle leeftijden en alle doelgroepen rond het thema migratie. Evenementen in Clérieux, Saint-Bardoux en Granges-les-Beaumont."
    ]
  },
