  "rdfs:comment": {
    "de": [
      "Amateurtheater in Dieulefit am Mittwochabend von 19:30 bis 22:00 Uhr.      \r\nBesitzt Beleuchtungsmaterial für Aufführungen, das für lokale Veranstaltungen genutzt werden kann."
    ],
    "en": [
      "Amateur theater in Dieulefit on Wednesday evenings from 7:30pm to 10:00pm.      \r\nHas show lighting equipment that can be used for local events."
    ],
    "it": [
      "Teatro amatoriale a Dieulefit il mercoledì sera dalle 19.30 alle 22.00.      \r\nDispone di attrezzature per l'illuminazione che possono essere utilizzate per eventi locali."
    ],
    "fr": [
      "Théâtre amateur à Dieulefit  les mercredis soirs de 19h30 à 22h00.      \r\nPossède du matériel d'éclairage de spectacle qui peut servir pour des animations locales."
    ],
    "es": [
      "Teatro aficionado en Dieulefit los miércoles por la tarde de 19.30 a 22.00 horas.      \r\nDispone de equipo de iluminación que puede utilizarse para eventos locales."
    ],
    "nl": [
      "Amateurtheater in Dieulefit op woensdagavond van 19.30 tot 22.00 uur.      \r\nBeschikt over lichtapparatuur die kan worden gebruikt voor plaatselijke evenementen."
