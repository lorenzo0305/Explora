  "rdfs:comment": {
    "de": [
      "Der Ciné-club brivadois nimmt seine Filmvorführungen im Kino Le Paris wieder auf und bietet ab dem 23. September jeden zweiten Dienstag ein Treffen an, um Filme zu entdecken, sich auszutauschen und gemeinsame Emotionen zu teilen."
    ],
    "en": [
      "The Ciné-club brivadois (Brivadois film club) is back at the Le Paris cinema, and from September 23 onwards will be meeting every other Tuesday to discover films, exchange ideas and share emotions together."
    ],
    "it": [
      "A partire dal 23 settembre, il Ciné-club Brivadois riprenderà a proiettare film al cinema Le Paris a martedì alterni per scoprire film, scambiare idee e condividere emozioni."
    ],
    "fr": [
      "Le Ciné-club brivadois reprend ses projections au cinéma Le Paris et propose, dès le 23 septembre, un rendez-vous un mardi sur deux pour découvrir des films, échanger et partager des émotions en commun."
    ],
    "nl": [
      "Vanaf 23 september vertoont de Brivadois Ciné-club weer films in de bioscoop Le Paris op wisselende dinsdagen om films te ontdekken, ideeën uit te wisselen en emoties te delen."
    ],
    "es": [
      "A partir del 23 de septiembre, el Ciné-club Brivadois vuelve a proyectar películas en el cine Le Paris, los martes alternos, para descubrir películas, intercambiar ideas y compartir emociones."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Programme Ciné-club brivadois"
    ]
  },
