  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/ed53c687-6c31-3475-a634-add9e0bde91a",
      "dc:description": {
        "de": [
          "Cocci Market, Lebensmittelgeschäft neben der Kapelle in Merlimont Plage.\nGeöffnet von April bis Oktober ganztägig von Montag bis Samstag und auch am Sonntagmorgen."
        ],
        "en": [
          "Cocci Market, food store located next to the Chapelle de Merlimont Plage.\nOpen from April to October all day, Monday to Saturday, and on Sunday mornings."
        ],
        "it": [
          "Cocci Market, negozio di alimentari situato accanto alla cappella di Merlimont Plage.\nAperto da aprile a ottobre tutto il giorno dal lunedì al sabato e anche la domenica mattina."
        ],
        "fr": [
          "Cocci Market, magasin alimentaire situé à côté de la Chapelle de Merlimont Plage.\nOuvert d'avril à octobre toute la journée du lundi au samedi et également le dimanche matin."
        ],
        "es": [
          "Cocci Market, tienda de alimentación situada junto a la capilla de Merlimont Plage.\nAbierto de abril a octubre todo el día de lunes a sábado y también los domingos por la mañana."
        ],
        "nl": [
          "Cocci Market, levensmiddelenwinkel naast de kapel in Merlimont Plage.\nGeopend van april tot oktober de hele dag van maandag tot zaterdag en ook op zondagochtend."
        ]
      },
