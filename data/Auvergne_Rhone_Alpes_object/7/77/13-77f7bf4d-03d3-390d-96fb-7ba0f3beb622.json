  "rdfs:comment": {
    "de": [
      "Ein Problem mit dem Verhalten? Wie versteht man sich? Ein Missverständnis mit Ihrem Tier? Ein verirrtes Tier?\r\nDie Tierkommunikation kann Ihnen helfen, mehr Verständnis für Ihre Tiere zu entwickeln."
    ],
    "en": [
      "A behavioral problem? A lack of understanding? A misunderstanding with your pet? A lost pet?\r\nAnimal communication can help you understand your pets better."
    ],
    "it": [
      "Un problema comportamentale? Una mancanza di comprensione? Un'incomprensione con il vostro animale? Un animale smarrito?\r\nLa comunicazione animale può aiutarvi a capire meglio i vostri animali."
    ],
    "fr": [
      "Un problème de comportement ? D’entente ? Une incompréhension avec votre animal ? Un animal égaré ? \r\nLa communication animale peut vous aider vers plus de compréhension avec vos animaux."
    ],
    "es": [
      "¿Un problema de comportamiento? ¿Comprensión? ¿Un malentendido con su mascota? ¿Un animal perdido?\r\nLa comunicación animal puede ayudarle a comprender mejor a sus animales."
    ],
    "nl": [
      "Een gedragsprobleem? Een gebrek aan begrip? Een misverstand met je huisdier? Een dier kwijt?\r\nDiercommunicatie kan je helpen om je dieren beter te begrijpen."
    ]
  },
