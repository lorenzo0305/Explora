  "rdfs:comment": {
    "de": [
      "Erleben Sie ein einzigartiges Packraft-Abenteuer in der Umgebung von Annecy! Entdecken Sie geheime und wilde Orte in Packrafts, unseren ultraleichten aufblasbaren Kajaks. Geführt von einem leidenschaftlichen Profi."
    ],
    "en": [
      "Experience a unique packraft adventure around Annecy! Discover secret and wild sites in packraft, our ultra-light inflatable kayaks. Guided by a passionate professional."
    ],
    "it": [
      "Vivete un'avventura unica in packraft intorno ad Annecy! Scoprite siti segreti e selvaggi in packraft, i nostri kayak gonfiabili ultraleggeri. Guidati da un professionista appassionato."
    ],
    "fr": [
      "Vivez une aventure unique en packraft autour d’Annecy ! Partez à la découverte de sites secrets et sauvages en packraft, nos kayaks gonflables ultra légers. Guidé par un professionnel passionné."
    ],
    "es": [
      "¡Vive una aventura única en packraft por Annecy! Descubra lugares secretos y salvajes en packraft, nuestros kayaks hinchables ultraligeros. Guiado por un profesional apasionado."
    ],
    "nl": [
      "Beleef een uniek packraft avontuur rond Annecy! Ontdek geheime en wilde plekken in packraft, onze ultralichte opblaasbare kajaks. Begeleid door een gepassioneerde professional."
    ]
  },
