  "rdfs:comment": {
    "de": [
      "Vom 16. bis 20. März 2026 beteiligt sich das Centre Social La Passerelle an der nationalen Veranstaltung La Semaine du Cerveau und bietet ein originelles Programm rund um die Funktionsweise des Gehirns, das für alle Altersgruppen zugänglich ist."
    ],
    "en": [
      "From March 16 to 20, 2026, the Centre Social La Passerelle will be taking part in the national event La Semaine du Cerveau (Brain Week), offering an original program on how the brain works, accessible to all audiences."
    ],
    "it": [
      "Dal 16 al 20 marzo 2026, il Centre Social La Passerelle parteciperà all'evento nazionale della Settimana del Cervello, offrendo un programma originale di eventi incentrati sul funzionamento del cervello, accessibile a tutti."
    ],
    "fr": [
      "Du 16 au 20 mars 2026, le Centre Social La Passerelle s’associe à l’événement national La Semaine du Cerveau et propose une programmation originale autour du fonctionnement du cerveau, accessible à tous les publics."
    ],
    "nl": [
      "Van 16 tot 20 maart 2026 neemt het Centre Social La Passerelle deel aan de nationale Hersenweek met een origineel en voor iedereen toegankelijk evenementenprogramma over de werking van de hersenen."
    ],
    "es": [
      "Del 16 al 20 de marzo de 2026, el Centro Social La Passerelle participará en la Semana Nacional del Cerebro, ofreciendo un original programa de actos centrados en el funcionamiento del cerebro y accesibles a todos."
    ]
  },
  "rdfs:label": {
