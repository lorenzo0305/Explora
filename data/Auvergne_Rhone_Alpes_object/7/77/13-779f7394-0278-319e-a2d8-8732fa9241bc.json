  "rdfs:comment": {
    "de": [
      "Unten an der Küste, in der Rue du Comte de Poitiers, die zum alten Dorf führt, öffnet Ihnen La Côte D 1000 seine Bibliothek für eine schmackhafte Küche, begleitet von einigen einfachen und ehrlichen Weinen, und bietet einen Galeriebereich für Kreative und Kreationen."
    ],
    "en": [
      "At the bottom of the hill, in Rue du Comte de Poitiers, which leads to the old part of the village, La Côte D 1000 opens its library so that you can enjoy tasty cuisine accompanies by some simple and honest wines. There is also a gallery area for creators and creations."
    ],
    "it": [
      "Ai piedi della collina, in rue du Comte de Poitiers, che conduce al vecchio villaggio, La Côte D 1000 apre la sua libreria per gustare cibi gustosi accompagnati da vini semplici e sinceri, e offre uno spazio di galleria per creatori e creazioni."
    ],
    "fr": [
      "Au bas de la côte, rue du Comte de Poitiers, qui conduit au vieux village, La Côte D 1000 vous ouvre sa bibliothèque pour une cuisine goûteuse accompagnée de quelques vins simples et honnêtes, et propose un espace galerie pour créateurs et créations."
    ],
    "nl": [
      "Onderaan de heuvel in de rue du Comte de Poitiers die naar het oude dorp leidt, opent La Côte D 1000 haar deuren voor een smakelijke keuken begeleid door eenvoudige eerlijke wijnen. Bovendien is er een galerieruimte voor kunstenaars en kunstwerken."
    ],
    "es": [
      "Al pie de la colina, rue du Comte de Poitiers, que conduce al antiguo pueblo, La Côte D 1000 abre su biblioteca para degustar sabrosas comidas acompañadas de unos vinos sencillos y honestos, y ofrece un espacio de galería para creadores y creaciones."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Côte D 1000"
    ]
  },
