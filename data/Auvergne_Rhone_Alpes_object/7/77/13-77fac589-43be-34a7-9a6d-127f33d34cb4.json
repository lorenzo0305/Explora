          "additionalInformation": {
            "de": [
              "Vom 03. bis 10. November wegen Renovierung vorübergehend geschlossen.\r\n\r\nRestaurant täglich außer Sonntagabend und Montag geöffnet.\r\nKleine Snacks für Hotelgäste an diesen Abenden verfügbar."
            ],
            "en": [
              "Temporarily closed from November 03 to 10 for renovation.\r\n\r\nRestaurant open every day except Sunday evening and Monday.\r\nSnacks available for hotel guests on these evenings."
            ],
            "it": [
              "Chiuso temporaneamente dal 03 al 10 novembre per ristrutturazione.\r\n\r\nRistorante aperto tutti i giorni tranne la domenica sera e il lunedì.\r\nIn queste serate sono disponibili spuntini per gli ospiti dell'hotel."
            ],
            "fr": [
              "Fermé temporairement du 03 au 10 novembre pour rénovation.\r\n\r\nRestaurant ouvert tous les jours sauf dimanche soir et lundi.\r\nPetite restauration disponible pour les clients de l'hôtel ces soirs-là."
            ],
            "nl": [
              "Tijdelijk gesloten van 03 tot 10 november voor renovatie.\r\n\r\nRestaurant elke dag geopend behalve zondagavond en maandag.\r\nSnacks beschikbaar voor hotelgasten op deze avonden."
            ],
            "es": [
              "Cerrado temporalmente del 03 al 10 de noviembre por reformas.\r\n\r\nRestaurante abierto todos los días excepto el domingo por la noche y el lunes.\r\nSnacks disponibles para los huéspedes del hotel en estas noches."
            ]
          },
