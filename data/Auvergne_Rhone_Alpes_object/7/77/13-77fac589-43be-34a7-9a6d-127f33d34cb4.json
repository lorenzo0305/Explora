  "rdfs:comment": {
    "de": [
      "In einer angenehmen Umgebung mit Blick auf die Rhône verfügt das Hotel-Restaurant L'Auberge de la Paillère über 10 Zimmer, die mit einem eigenen Bad ausgestattet sind. Vor Ort bietet Ihnen ein Restaurant mit Terrasse eine traditionelle Küche mit Spezialitäten."
    ],
    "en": [
      "In a charming setting with a view of the Rhône, the Hotel-Restaurant L'Auberge de la Paillère has 10 rooms equipped with private bathroom. On the spot a restaurant with terrace offering traditional cuisine and specialities."
    ],
    "it": [
      "In un ambiente piacevole con vista sul fiume Rodano, l'Hotel-Restaurant L'Auberge de la Paillère dispone di 10 camere con bagno. In loco, un ristorante con terrazza offre una cucina tradizionale con specialità."
    ],
    "fr": [
      "Dans un cadre agréable avec vue sur le Rhône, l'Hôtel-Restaurant L'Auberge de la Paillère dispose de 10 chambres équipées avec salle de bain privative. Sur place, un restaurant avec terrasse vous propose une cuisine traditionnelle avec des spécialités."
    ],
    "nl": [
      "Hotel-Restaurant L'Auberge de la Paillère ligt in een aangename omgeving met uitzicht op de rivier de Rhône en beschikt over 10 kamers met eigen badkamer. Ter plaatse biedt een restaurant met terras een traditionele keuken met specialiteiten."
    ],
    "es": [
      "El Hotel-Restaurante L'Auberge de la Paillère, situado en un entorno agradable con vistas al río Ródano, dispone de 10 habitaciones con baño. En el lugar, un restaurante con terraza ofrece cocina tradicional con especialidades."
    ]
  },
  "rdfs:label": {
    "en": [
      "Hotel-restaurant :  Auberge de la Paillère"
    ],
    "fr": [
      "Hôtel-restaurant :  Auberge de la Paillère"
    ]
  },
