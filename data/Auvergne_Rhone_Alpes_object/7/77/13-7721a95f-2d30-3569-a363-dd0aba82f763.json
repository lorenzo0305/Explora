  "rdfs:comment": {
    "de": [
      "Die Motorradstrecke von Quinssaines ist die einzige Rennstrecke in der Auvergne, die auf demselben Gelände über eine Motocross-Strecke, einen FMX-Park (Freestyle-Motorrad), eine Pitbike-Strecke und Trial-Zonen verfügt."
    ],
    "en": [
      "The Quinssaines motorcycle circuit is the only circuit in Auvergne to have on the same site, a Motocross circuit, a FMX park (freestyle motorcycle), a Pit-bike circuit and Trial zones."
    ],
    "it": [
      "Il circuito motociclistico di Quinssaines è l'unico circuito dell'Alvernia ad avere un circuito di motocross, un parco FMX (moto freestyle), un circuito di pit-bike e zone di trial nello stesso sito."
    ],
    "fr": [
      "Le circuit motos de Quinssaines est le seul circuit d'Auvergne à disposer sur le même site, d'un circuit de Motocross, d'un parc FMX (freestyle moto), d'un circuit de Pit-bike et de zones de Trial."
    ],
    "nl": [
      "Het motorcircuit van Quinssaines is het enige circuit in de Auvergne met een motorcrosscircuit, een FMX-park (freestyle motor), een pitbikecircuit en trialzones op hetzelfde terrein."
    ],
    "es": [
      "El circuito de motos de Quinssaines es el único circuito de Auvernia que cuenta con un circuito de Motocross, un parque de FMX (motos de estilo libre), un circuito de Pit-bike y zonas de Trial en el mismo lugar."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Circuit de motocross"
    ]
  },
