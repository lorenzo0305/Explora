  "rdfs:comment": {
    "de": [
      "Als handwerklicher Bäcker seit über 160 Jahren gibt das Haus Nivon sein Know-how mit Leidenschaft weiter, um frische und großzügige Produkte anzubieten.\r\nZu entdecken ist der Schweizer."
    ],
    "en": [
      "Maison Nivon is an artisanal bakery that was established over 160 years ago, and is still keeping traditional know-how alive, sharing this expertise with passion, thanks to their range of fresh, generous products.\r\nWe highly recommend the 'Suisse'."
    ],
    "it": [
      "Fornaio artigianale da oltre 160 anni, la casa Nivon trasmette il suo know-how con passione per offrire prodotti freschi e generosi.\r\nScoprite la Svizzera."
    ],
    "fr": [
      "Artisan Boulanger depuis plus de 160 ans, la maison Nivon transmet son savoir-faire avec passion afin d’offrir des produits frais et généreux.\r\nA découvrir le Suisse."
    ],
    "es": [
      "Panadero artesano desde hace más de 160 años, la casa Nivon transmite su saber hacer con pasión para ofrecer productos frescos y generosos.\r\nDescubra a los suizos."
    ],
    "nl": [
      "Het maison NIVON, al meer dan 160 jaar een ambachtelijke bakker, brengt zijn expertise met passie over en biedt verse rijke producten."
    ]
  },
