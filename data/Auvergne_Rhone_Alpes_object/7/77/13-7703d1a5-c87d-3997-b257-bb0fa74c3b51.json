  "rdfs:comment": {
    "de": [
      "Neue Pizzeria in Saint-Quentin-Fallavier, im Kyriad Hotel in einer gemütlichen und modernen Welt in den Restaurants La Pizza de Nico.\r\nGenießen Sie unsere köstlichen Pizzen, vor Ort oder zum Mitnehmen."
    ],
    "en": [
      "New pizzeria in Saint-Quentin-Fallavier, at the Kyriad Hotel in a warm and modern universe in the restaurants La Pizza de Nico.\r\nCome and enjoy our delicious pizzas, on the spot or to take away."
    ],
    "it": [
      "Nuova pizzeria a Saint-Quentin-Fallavier, presso l'Hotel Kyriad, in un ambiente caldo e moderno nel ristorante La Pizza de Nico.\r\nVenite a gustare le nostre deliziose pizze, sul posto o da asporto."
    ],
    "fr": [
      "Nouvelle pizzeria à Saint-Quentin-Fallavier, au Kyriad Hôtel dans un univers chaleureux et moderne dans les restaurants La Pizza de Nico.\r\nVenez vous régaler de nos délicieuses pizzas, sur place ou à emporter."
    ],
    "es": [
      "Nueva pizzería en Saint-Quentin-Fallavier, en el Hotel Kyriad en un ambiente cálido y moderno en los restaurantes La Pizza de Nico.\r\nVen a disfrutar de nuestras deliciosas pizzas, en el momento o para llevar."
    ],
    "nl": [
      "Nieuwe pizzeria in Saint-Quentin-Fallavier, in het Kyriad Hotel in een warme en moderne omgeving in de restaurants La Pizza de Nico.\r\nKom genieten van onze heerlijke pizza's, ter plaatse of om mee te nemen."
    ]
  },
