  "rdfs:comment": {
    "de": [
      "Die Ferme de Roche Rousse verarbeitet die Milch ihrer Tiere zu außergewöhnlichen Produkten: Bleu du Vercors-Sassenage und andere Köstlichkeiten. Der Betrieb hat sich der Qualität und dem Umweltschutz verschrieben und garantiert authentische Produkte."
    ],
    "en": [
      "La Ferme de Roche Rousse transforms the milk from its cows into exceptional products: Bleu du Vercors-Sassenage and other delights. Committed to quality and respect for the environment, we guarantee authentic products."
    ],
    "it": [
      "La Ferme de Roche Rousse trasforma il latte delle sue mucche in prodotti eccezionali: il Bleu du Vercors-Sassenage e altre delizie. Impegnata nella qualità, nel rispetto dell'ambiente e nella garanzia di prodotti autentici."
    ],
    "fr": [
      "La Ferme de Roche Rousse transforme le lait de ses en produits d'exception : Bleu du Vercors-Sassenage et autres délices. Engagée dans une démarche de qualité, dé respect de l’environnement, garantissant des produits authentiques."
    ],
    "nl": [
      "La Ferme de Roche Rousse verwerkt de melk van haar koeien tot uitzonderlijke producten: Bleu du Vercors-Sassenage en andere lekkernijen. Kwaliteit, respect voor het milieu en authentieke producten."
    ],
    "es": [
      "La Ferme de Roche Rousse transforma la leche de sus vacas en productos excepcionales: Bleu du Vercors-Sassenage y otras delicias. Comprometidos con la calidad, respetando el medio ambiente y garantizando productos auténticos."
    ]
  },
