  "rdfs:comment": {
    "de": [
      "Savoyardische Gerichte und Bauernmahlzeiten; Crêperie mit savoyardischen Spezialitäten. Heimische Gerichte und Rezepte; Fondues und Raclettes, serviert mit den Wurstdelikatessen eines savoyardischen Metzgermeisters (essen Sie soviel Sie möchten!). Spezialitäten: hausgemachte Flusskrebssoße und Bauernmahlzeit. Auch Kinder sind herzlich willkommen."
    ],
    "en": [
      "Restaurant with farmer and mountain specialities and mountain crêperie. Regional dishes and recipes. All-you-can-eat fondues and raclettes served with cold cuts made by a maître artisan from the Savoie region. Specialities: Homemade crayfish sauce and farmer's plate. Children welcome."
    ],
    "it": [
      "Ristoranti di montagna, di campagna e di frittelle. Ricette e piatti regionali. Fondute e raclettes servite con tutto il formaggio che volete e salumi di un maestro artigiano savoiardo. Specialità: Salsa di gamberi fatta in casa e piatti contadini."
    ],
    "fr": [
      "Restauration montagnarde, paysanne et crêperie montagnarde. Recettes et plats régionaux. Fondues et raclettes servies avec fromage à volonté et la charcuterie d'un maître artisan savoyard. Spécialités : Sauce écrevisses maison et plat paysan."
    ],
    "es": [
      "Restaurantes de montaña, campestres y panqueques. Recetas y platos regionales. Fondues y raclettes servidas con todo el queso que quiera y charcutería de un maestro saboyano. Especialidades: Salsa casera de cangrejos de río y platos campestres."
    ],
    "nl": [
      "Berg-, land- en pannenkoekenrestaurants. Regionale recepten en gerechten. Fondues en raclettes geserveerd met zoveel kaas als u wilt en vleeswaren van een Savoyaardse meester. Specialiteiten: Zelfgemaakte rivierkreeftsaus en landelijke gerechten."
    ]
  },
