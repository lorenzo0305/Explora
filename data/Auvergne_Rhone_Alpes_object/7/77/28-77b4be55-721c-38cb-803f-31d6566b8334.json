  "rdfs:comment": {
    "de": [
      "In der Brasserie de Fernand wird alles selbst gemacht.\nDas gesamte Team freut sich darauf, Sie in der Brasserie Cayolaise begrüßen zu dürfen! Hausgemachte Spezialitäten und Meeresfrüchte werden hier von einem leidenschaftlichen Team zubereitet."
    ],
    "en": [
      "At Fernand's brasserie, everything is homemade.\nThe whole team is looking forward to welcoming you to the Brasserie Cayolaise! House specialties and seafood will be prepared by a passionate team."
    ],
    "it": [
      "Alla brasserie Fernand, tutto è fatto in casa.\nTutto il team è pronto a darvi il benvenuto nella brasserie Cayolaise! Le specialità della casa e i frutti di mare saranno preparati da un team appassionato."
    ],
    "fr": [
      "À la brasserie de Fernand, on fait tout maison.\nToute l’équipe a hâte de vous accueillir à la brasserie cayolaise ! Spécialités de la maison, produits de la mer y seront préparés par une équipe passionnée."
    ],
    "es": [
      "En la brasserie Fernand, todo es casero.\nTodo el equipo está deseando darle la bienvenida a la brasserie Cayolaise Las especialidades de la casa y el marisco serán preparados por un equipo apasionado."
    ],
    "nl": [
      "Bij Fernand's brasserie is alles huisgemaakt.\nHet hele team kijkt ernaar uit je te verwelkomen in de Cayolaise brasserie! Huisspecialiteiten en zeevruchten worden bereid door een gepassioneerd team."
    ]
  },
  "rdfs:label": {
