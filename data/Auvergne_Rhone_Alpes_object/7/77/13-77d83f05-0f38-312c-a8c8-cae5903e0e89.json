  "rdfs:comment": {
    "de": [
      "Das Dorf Pont de Barret wird von seinen drei Bergen Sainte-Euphémie, Eson und Briesse bewacht und von den Flüssen Roubion und Rimandoule umspült."
    ],
    "en": [
      "Equidistant from Dieulefit, Montélimar and Crest is the small village of Pont-de-Barret, watched over by three hills, Sainte-Euphémie, Eson and Briesse, and bathed by the Roubion and the Rimandoule."
    ],
    "it": [
      "Il villaggio di Pont de Barret è sorvegliato dalle sue tre montagne, Sainte-Euphémie, Eson e Briesse, e bagnato dai fiumi Roubion e Rimandoule."
    ],
    "fr": [
      "Le village de Pont de Barret est veillé par ses trois montagnes, Sainte-Euphémie, Eson et Briesse, et baigné par le Roubion, et la Rimandoule."
    ],
    "nl": [
      "Het dorp Pont de Barret wordt bewaakt door zijn drie bergen, Sainte-Euphémie, Eson en Briesse, en baadt in de rivieren Roubion en Rimandoule."
    ],
    "es": [
      "El pueblo de Pont de Barret está vigilado por sus tres montañas, Sainte-Euphémie, Eson y Briesse, y bañado por los ríos Roubion y Rimandoule."
    ]
  },
