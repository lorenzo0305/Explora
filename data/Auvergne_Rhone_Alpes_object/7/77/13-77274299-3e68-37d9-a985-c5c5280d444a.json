  "rdfs:comment": {
    "de": [
      "Boutique mit vielen verschiedenen Sorten."
    ],
    "en": [
      "Boutique specialised in farm goats cheese."
    ],
    "it": [
      "La fattoria Biquettes de l'archevêque di La Garde-Adhémar è lieta di accogliervi per farvi scoprire l'intera gamma di formaggi di capra di fattoria che produciamo ogni giorno in azienda."
    ],
    "fr": [
      "La ferme des biquettes de l'archevêque de La Garde-Adhémar est heureuse de vous accueillir pour découvrir toute la gamme de fromages de chèvre fermiers au lait cru que nous fabriquons tous les jours sur l'exploitation."
    ],
    "es": [
      "La granja Biquettes de l'archevêque de La Garde-Adhémar le da la bienvenida para que descubra toda la gama de quesos de cabra de granja que elaboramos a diario en la granja."
    ],
    "nl": [
      "Fonterongeiten, geitenkaas. Verkoop bij de boerderij."
    ]
  },
