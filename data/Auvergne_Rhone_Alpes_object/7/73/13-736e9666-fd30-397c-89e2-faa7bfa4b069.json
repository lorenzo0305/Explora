  "rdfs:comment": {
    "de": [
      "Jedes Jahr in den Schulferien ist Aquaplouf ein großer Erfolg im Schwimmbad von Cusset, das sich zu diesem Anlass in einen Wasserspielplatz verwandelt, zur Freude von Kindern ab 6 Monaten und ihren Familien."
    ],
    "en": [
      "Every school vacation, Aquaplouf is a great success at the Cusset pool, which takes on the appearance of an aquatic playground to the delight of children aged 6 months and over, and their families."
    ],
    "it": [
      "Ogni anno, durante le vacanze scolastiche, l'Aquaplouf è un grande successo alla piscina Cusset, che assume l'aspetto di un parco giochi acquatico per la gioia dei bambini dai 6 mesi in su e delle loro famiglie."
    ],
    "fr": [
      "À chaque vacances scolaires, l'Aquaplouf rencontre un vif succès à la piscine de Cusset qui prend pour l'occasion des allures d’un terrain de jeu aquatique pour le plus grand plaisir des enfants, à partir de 6 mois, et de leurs familles."
    ],
    "es": [
      "Todas las vacaciones escolares, Aquaplouf es un gran éxito en la piscina de Cusset, que adopta la apariencia de un parque acuático para deleite de los niños a partir de 6 meses y sus familias."
    ],
    "nl": [
      "Elke schoolvakantie is Aquaplouf een groot succes in het zwembad van Cusset, dat de vorm aanneemt van een waterspeeltuin tot groot plezier van kinderen vanaf 6 maanden en hun familie."
    ]
  },
  "rdfs:label": {
