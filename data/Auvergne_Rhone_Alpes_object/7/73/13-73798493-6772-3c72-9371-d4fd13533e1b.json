  "rdfs:comment": {
    "de": [
      "Gastronomie mit lokalen Produkten, Burger mit Tomme-Käse, Fourme de Montbrison, Saint Nectaire oder Entrecôte mit Salat und Pommes, Salat, Käse, Aperitifplatten. Auf Reservierung."
    ],
    "en": [
      "Catering based on local products, burger with tomme, fourme, saint nectaire or entrecote accompanied by a salad and chips, salad, cheese, aperitif platters.\r\nOn reservation only."
    ],
    "it": [
      "Benvenuti a L'Authentique, il ristorante che offre il massimo della cucina casalinga. Hamburger di qualità, salsa ai funghi, carni marinate e altre proposte per deliziare il vostro palato. Sorbetti di mirtilli, lamponi e fragole vi aspettano a Chalmazel"
    ],
    "fr": [
      "Bienvenue à L'Authentique, le restaurant qui vous propose un maximum de fait maison. Burgers de qualité, sauce champignons, viandes marinées et d'autres suggestions qui raviront vos papilles. Sorbet myrtille  framboise, fraise.. vous attendent à Chalmazel"
    ],
    "nl": [
      "Welkom bij L'Authentique, het restaurant dat een maximum aan huisgemaakte gerechten biedt. Kwaliteitshamburgers, champignonsaus, gemarineerd vlees en andere suggesties om je smaakpapillen te verwennen. Bosbessen-, frambozen- en aardbeiensorbets wachten op je in Chalmazel"
    ],
    "es": [
      "Bienvenido a L'Authentique, el restaurante que ofrece el máximo de comida casera. Hamburguesas de calidad, salsa de champiñones, carnes marinadas y otras sugerencias para deleitar su paladar. Sorbetes de arándanos, frambuesas y fresas le esperan en Chalmazel"
    ]
  },
