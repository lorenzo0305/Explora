  "rdfs:comment": {
    "de": [
      "Mediterrane Küche.\r\nIm Herzen des Dorfes Roynac, auf einer schattigen Terrasse, entdecken Sie unseren Blick auf die Ebene. Chefkoch Karim lässt sich von der lokalen Umgebung, den Bauernhöfen und Obstgärten der Region inspirieren."
    ],
    "en": [
      "Mediterranean cuisine.\r\nIn the heart of the village of Roynac, on a shady terrace, come and discover our view over the plain. Chef Karim draws his inspiration from the local environment, farms and orchards."
    ],
    "it": [
      "Cucina mediterranea.\r\nNel cuore del villaggio di Roynac, su una terrazza ombreggiata, venite a scoprire la nostra vista sulla pianura. Lo chef Karim trae ispirazione dall'ambiente locale, dalle fattorie e dai frutteti della regione."
    ],
    "fr": [
      "Cuisine Méditerrannéene.\r\nAu cœur du village de Roynac, sur une terrasse ombragée venez découvrir notre vue sur la plaine. Le Chef Karim puise son inspiration dans l’environnement local, les fermes et les vergers de la région."
    ],
    "nl": [
      "Mediterrane keuken.\r\nIn het hart van het dorp Roynac, op een schaduwrijk terras, kunt u ons uitzicht over de vlakte komen ontdekken. Chef Karim haalt zijn inspiratie uit de lokale omgeving, de boerderijen en boomgaarden van de regio."
    ],
    "es": [
      "Cocina mediterránea.\r\nEn el corazón del pueblo de Roynac, en una terraza a la sombra, venga a descubrir nuestra vista sobre la llanura. El Chef Karim se inspira en el entorno local, las granjas y huertos de la región."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Petite Auberge"
    ]
  },
