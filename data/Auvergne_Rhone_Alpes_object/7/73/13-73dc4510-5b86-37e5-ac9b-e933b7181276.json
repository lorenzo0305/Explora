  "rdfs:comment": {
    "de": [
      "Die GAEC du lavoir ist ein Familienbetrieb, der Polykultur, Viehzucht und Gemüseanbau anbietet. Zu den vor Ort angebauten Produkten gehören: Kartoffeln, Kürbisse (Butternut, Potimarron und Moschus), Zwiebeln."
    ],
    "en": [
      "The GAEC du lavoir is a family-run business offering mixed farming, livestock breeding and market gardening. Produce grown on site includes potatoes, squash (butternut, pumpkin and butternut squash) and onions."
    ],
    "it": [
      "Il GAEC du lavoir è un'azienda agricola a conduzione familiare che offre agricoltura mista, allevamento e orticoltura. I prodotti coltivati in loco comprendono patate, zucche (butternut, zucca e zucca butternut) e cipolle."
    ],
    "fr": [
      "Le GAEC du lavoir est une exploitation familiale qui propose polyculture, élevage et maraîchage. Parmi les produits cultivés sur place : pommes de terre, courges (butternuts, potimarrons et musquées), oignons."
    ],
    "es": [
      "El GAEC du lavoir es una explotación familiar de agricultura mixta, ganadería y horticultura. Los productos cultivados in situ incluyen patatas, calabazas (butternut, calabaza y calabaza butternut) y cebollas."
    ],
    "nl": [
      "De GAEC du lavoir is een familieboerderij met gemengde landbouw, veeteelt en tuinbouw. De producten die ter plaatse worden geteeld zijn aardappelen, pompoen (butternut, pompoen en muskaatpompoen) en uien."
    ]
  },
  "rdfs:label": {
