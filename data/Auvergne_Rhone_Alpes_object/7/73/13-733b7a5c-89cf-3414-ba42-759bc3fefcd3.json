  "rdfs:comment": {
    "de": [
      "Modularer Arbeitsraum mit flexiblen Arbeitszeiten, stunden- oder tageweise, ohne Verpflichtungen.\r\nEin fertiger Raum für Ihre Meetings oder Seminare in einer halb-urbanen Umgebung, die mit der Natur verbunden ist."
    ],
    "en": [
      "Modular workspace with flexible hours, by the hour or day, with no commitment.\r\nA room ready for your meetings or seminars in a semi-urban environment connected to nature."
    ],
    "it": [
      "Spazio di lavoro modulare con orari flessibili, a ore o a giorni, senza impegno.\r\nUna sala pronta per le vostre riunioni o seminari in un ambiente semi-urbano connesso alla natura."
    ],
    "fr": [
      "Espace de travail modulable avec des horaires flexibles, à l'heure ou à la journée, sans engagement.\r\nUne salle prête pour vos réunions ou vos séminaires dans un environnement semi urbain et connectée à la nature."
    ],
    "nl": [
      "Modulaire werkruimte met flexibele uren, per uur of per dag, zonder verplichtingen.\r\nEen ruimte klaar voor uw vergaderingen of seminars in een semi-stedelijke omgeving verbonden met de natuur."
    ],
    "es": [
      "Espacio de trabajo modular con horarios flexibles, por horas o por días, sin compromiso.\r\nUna sala preparada para sus reuniones o seminarios en un entorno semiurbano conectado con la naturaleza."
    ]
  },
