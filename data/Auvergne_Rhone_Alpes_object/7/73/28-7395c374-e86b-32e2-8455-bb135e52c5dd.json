  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/b3de6d6b-6415-3efc-a894-6da738a1d781",
      "dc:description": {
        "de": [
          "Im Bienenhaus Vanco warten Linden-, Akazien- oder Kastanienhonig und frischer Pollen nur auf Sie! Entdecken Sie Honigbonbons, Lebkuchen und Wachssujets für Gastronomiemessen und Weihnachtsfeiern, die alle aus einer handwerklichen Herstellung stammen\n\nDer Honig ist vor Ort auf Vorbestellung und im Restaurant mit dem Gütesiegel Bistrot de Pays Chez Jako in Villeneuve-sur-Verberie erhältlich."
        ],
        "en": [
          "At Rucher Vanco, linden, acacia or chestnut tree honey and fresh pollen are just waiting for you! Discover honey sweets, gingerbread and wax subjects for gastronomic fairs and end-of-year celebrations, all made by hand\n\nThe honey is on sale on the spot by reservation and at the Bistrot de Pays Chez Jako restaurant in Villeneuve-sur-Verberie."
        ],
        "it": [
          "Da Rucher Vanco, il miele di tiglio, acacia o castagno e il polline fresco vi aspettano! Scoprite i dolci al miele, il pan di zenzero e gli oggetti in cera per le fiere gastronomiche e le feste di fine anno, tutti realizzati a mano\n\nIl miele è in vendita sul posto su prenotazione e presso il ristorante Bistrot de Pays Chez Jako a Villeneuve-sur-Verberie."
        ],
        "fr": [
          "Au Rucher Vanco, le miel de tilleul, d'acacia ou de châtaignier et le pollen frais n'attendent que vous ! Découvrez des bonbons au miel, du pains d'épice et des sujets en cire pour les salons gastronomiques et les fêtes de fin d'année, tous issus d'une fabrication artisanale. \n\nLe miel est en vente sur place sur réservation et au restaurant labellisé Bistrot de Pays Chez Jako à Villeneuve-sur-Verberie."
        ],
        "es": [
          "En Rucher Vanco le esperan la miel de tilo, de acacia o de castaño y el polen fresco Descubra los dulces de miel, el pan de jengibre y los objetos de cera para ferias gastronómicas y celebraciones de fin de año, todos ellos hechos a mano\n\nLa miel se vende in situ previa reserva y en el restaurante Bistrot de Pays Chez Jako de Villeneuve-sur-Verberie."
        ],
        "nl": [
          "Bij Rucher Vanco staan linde-, acacia- of kastanjehoning en verse pollen voor u klaar! Ontdek honingzoetigheden, peperkoek en wassen voorwerpen voor gastronomische beurzen en eindejaarsfeesten, allemaal met de hand gemaakt\n\nDe honing is ter plaatse te koop op reservering en in het restaurant Bistrot de Pays Chez Jako in Villeneuve-sur-Verberie."
        ]
      },
