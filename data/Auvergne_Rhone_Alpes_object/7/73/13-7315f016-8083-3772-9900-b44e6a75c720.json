  "rdfs:comment": {
    "de": [
      "Das E-Board: Das elektrische Allround-Board!\r\nErleben Sie das E-Board! Das E-Board, eine Mischung aus Snowboard und Skateboard, ist ein spielerisches und umweltfreundliches Board.\r\n\r\n."
    ],
    "en": [
      "The E-Board: The all-terrain electric board!\r\nExperience the E-Board! A mix of snowboard and skateboard, the E-Board is a fun, eco-friendly board.\r\n\r\n."
    ],
    "it": [
      "E-Board: la tavola elettrica per tutti i terreni!\r\nProvate la E-Board! Un mix di snowboard e skateboard, la E-Board è una tavola divertente ed ecologica.\r\n\r\n."
    ],
    "fr": [
      "La E-Board: La planche électrique tout terrain ! \r\nVivez l’Expérience E-Board ! Mélange de snowboard et de skate, la E-board est une planche ludique éco responsable. \r\n\r\n."
    ],
    "es": [
      "La E-Board: ¡la tabla eléctrica todoterreno!\r\n¡Experimenta la E-Board! Mezcla de snowboard y monopatín, la E-Board es una tabla divertida y ecológica.\r\n\r\n."
    ],
    "nl": [
      "Het E-Board: Het elektrische board voor alle terreinen!\r\nErvaar het E-Board! Het E-Board is een mix van snowboard en skateboard en is een leuk, milieuvriendelijk board.\r\n\r\n."
    ]
  },
