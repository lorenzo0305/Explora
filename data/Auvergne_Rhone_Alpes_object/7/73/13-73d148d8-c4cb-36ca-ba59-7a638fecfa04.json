  "rdfs:comment": {
    "de": [
      "Das Dorf ist um seine charmante kleine Kirche und den immer noch vorhandenen und gepflegten Waschplatz herum gebaut."
    ],
    "en": [
      "The village is built around its charming little church and its ever-present and well-kept wash-house."
    ],
    "it": [
      "Il villaggio è costruito intorno alla sua graziosa chiesetta e al suo lavatoio, ancora presente e ben tenuto."
    ],
    "fr": [
      "Le village est construit autour de sa charmante petite église et de son lavoir toujours présent et entretenu."
    ],
    "nl": [
      "Het dorp is gebouwd rond het charmante kerkje en het washuis, dat er nog steeds staat en goed onderhouden wordt."
    ],
    "es": [
      "El pueblo está construido alrededor de su pequeña y encantadora iglesia y de su lavadero, que todavía está allí y bien mantenido."
    ]
  },
