  "rdfs:comment": {
    "de": [
      "Züchter von 52 Ziegen mit Verarbeitung von Milchquark und Rohmilchkäse.\r\nVerkauf auf den Märkten von : Champagnac le Vieux am Freitagmorgen, Brioude am Samstagmorgen, Paulhaguet am Montagmorgen und Sainte-Florine am Sonntagmorgen."
    ],
    "en": [
      "Breeder of 52 goats, processing lactic curd and raw milk cheese.\r\nSales at markets in : Champagnac le Vieux on Friday mornings, Brioude on Saturday mornings, Paulhaguet on Monday mornings and Sainte-Florine on Sunday mornings."
    ],
    "it": [
      "Allevatore di 52 capre, lavorazione di cagliata lattica e formaggio a latte crudo.\r\nVenduto nei mercati di : Champagnac le Vieux il venerdì mattina, Brioude il sabato mattina, Paulhaguet il lunedì mattina e Sainte-Florine la domenica mattina."
    ],
    "fr": [
      "Eleveur de 52 chèvres avec transformation caillé lactique fromage au lait cru.\r\nVente sur les marchés de : Champagnac le Vieux le vendredi matin, Brioude le samedi matin, Paulhaguet le lundi matin et Sainte-Florine le dimanche matin."
    ],
    "nl": [
      "Fokker van 52 geiten, verwerking van melkwrongel en rauwmelkse kaas.\r\nVerkocht op markten in : Champagnac le Vieux op vrijdagochtend, Brioude op zaterdagochtend, Paulhaguet op maandagochtend en Sainte-Florine op zondagochtend."
    ],
    "es": [
      "Criador de 52 cabras, elaboración de cuajada láctica y queso de leche cruda.\r\nSe vende en los mercados de : Champagnac le Vieux los viernes por la mañana, Brioude los sábados por la mañana, Paulhaguet los lunes por la mañana y Sainte-Florine los domingos por la mañana."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Ferme des Cabris"
    ]
  },
