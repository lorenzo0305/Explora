  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/93d66ac6-c979-3f3a-8367-b6e55ccf572f",
      "dc:description": {
        "de": [
          "L'Expresso empfängt Sie mittags und abends von Montag bis Samstag zu einem Mittagessen, einem Aperitif oder einem Abendessen.\nunsere regionale und traditionelle Küche wird aus frischen und qualitativ hochwertigen Produkten zubereitet."
        ],
        "en": [
          "L'Expresso welcomes you for lunch, an aperitif or dinner, Monday to Saturday.\nour regional and traditional cuisine is prepared with fresh, high-quality produce."
        ],
        "it": [
          "L'Expresso vi accoglie per un pranzo, un aperitivo o una cena, dal lunedì al sabato.\nla nostra cucina regionale e tradizionale è preparata con prodotti freschi e di qualità."
        ],
        "fr": [
          "L’Expresso vous accueille midi et soir du lundi au samedi pour un déjeuner, un apéro ou un dîner. \nnotre cuisine régionale et traditionnelle est élaborée à partir de produits frais, et de qualités."
        ],
        "es": [
          "L'Expresso le da la bienvenida para almorzar, tomar un aperitivo o cenar, de lunes a sábado.\nnuestra cocina regional y tradicional se elabora con productos frescos y de calidad."
        ],
        "nl": [
          "L'Expresso heet je welkom voor lunch, een aperitief of diner, van maandag tot zaterdag.\nonze regionale en traditionele keuken wordt bereid met verse kwaliteitsproducten."
        ]
      },
