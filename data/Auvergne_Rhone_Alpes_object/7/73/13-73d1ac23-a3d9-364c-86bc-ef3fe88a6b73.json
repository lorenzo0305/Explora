  "rdfs:comment": {
    "de": [
      "Mel'Evasion befördert Sie in einem Minibus mit 9 Plätzen - Abfahrt vom Tourismusbüro in Varennes-sur-Allier.\r\nKurs auf Saint-Gerand-de-Vaux für eine zutiefst lokale Klammer (Château des Guichardeaux; Produzent L'Artisan des Champs; Kirche)."
    ],
    "en": [
      "Mel'Evasion transports you in a 9-seater mini-bus - Departure from Varennes-sur-Allier tourist office.\r\nHead for Saint-Gerand-de-Vaux for a deeply local interlude (château des Guichardeaux; producer L'Artisan des Champs; church)."
    ],
    "it": [
      "Mel'Evasion vi trasporta in un minibus a 9 posti - Partenza dall'ufficio turistico di Varennes-sur-Allier.\r\nDirigetevi a Saint-Gerand-de-Vaux per una vera e propria parentesi locale (castello dei Guichardeaux; produttore L'Artisan des Champs; chiesa)."
    ],
    "fr": [
      "Mel'Evasion vous transporte en mini-bus 9 places - Départ de l'office de tourisme de Varennes-sur-Allier.\r\nCap sur Saint-Gerand-de-Vaux pour une parenthèse profondément locale (château des Guichardeaux ; producteur L'Artisan des Champs ; église)."
    ],
    "nl": [
      "Mel'Evasion vervoert je in een minibus met 9 zitplaatsen - Vertrek vanaf het toeristenbureau van Varennes-sur-Allier.\r\nGa naar Saint-Gerand-de-Vaux voor een echt lokaal intermezzo (château des Guichardeaux; producent L'Artisan des Champs; kerk)."
    ],
    "es": [
      "Mel'Evasion le transporta en un minibús de 9 plazas - Salida de la oficina de turismo de Varennes-sur-Allier.\r\nDiríjase a Saint-Gerand-de-Vaux para disfrutar de una auténtica experiencia local (castillo des Guichardeaux; productor L'Artisan des Champs; iglesia)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite guidée - Là où le Bourbonnais se raconte"
    ]
  },
