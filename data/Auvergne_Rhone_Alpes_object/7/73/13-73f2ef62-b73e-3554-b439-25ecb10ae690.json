  "rdfs:comment": {
    "de": [
      "Vom Gebiet Arvan-Villards bis zum berühmten Beaufort-Käse: Erfahren Sie mehr über die verschiedenen Facetten dieser Region! Die Geschichte des Landes und der Genossenschaft, die Berglandwirtschaft und der Beaufort werden keine Geheimnisse mehr für Sie haben..."
    ],
    "en": [
      "Visit the new museum space to discover the land of the territory Arvan-Villards."
    ],
    "it": [
      "Dal territorio di Arvan-Villards al famoso formaggio Beaufort, venite a conoscere le diverse sfaccettature di questa regione! La storia della zona e della cooperativa, l'agricoltura di montagna e il formaggio Beaufort non avranno più segreti per voi..."
    ],
    "fr": [
      "Du territoire Arvan-Villards au fameux fromage Beaufort, venez en apprendre plus sur les différentes facettes de ce terroir ! L'histoire du pays et de la coopérative, l'agriculture de montagne et le Beaufort n'auront plus de secret pour vous..."
    ],
    "es": [
      "Desde el territorio de Arvan-Villards hasta el famoso queso de Beaufort, venga a conocer las diferentes facetas de esta región La historia de la zona y de la cooperativa, la agricultura de montaña y el queso de Beaufort ya no tendrán secretos para usted..."
    ],
    "nl": [
      "Bezoek de nieuwe museumruimte om de terroir te ontdekken"
    ]
  },
  "rdfs:label": {
    "en": [
      "Museum of the Cheese Dairy of the Vallée des Arves"
    ],
    "fr": [
      "Espace ludo-éducatif de la Fromagerie Coopérative de la Vallée des Arves"
    ],
    "nl": [
      "LUDIEK-PEDAGOGISCH CENTRUM : KASSMAKERIJ"
    ]
  },
