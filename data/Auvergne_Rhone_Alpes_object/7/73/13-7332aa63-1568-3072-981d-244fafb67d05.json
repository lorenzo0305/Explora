  "rdfs:comment": {
    "de": [
      "Zu Ihren Diensten 7 Tage die Woche, Interflora-Service, Florajet, Lieferung nach Hause, große Auswahl an Pflanzen, Schnittblumen, Blumenarrangements, runden Sträußen, Geschenkartikeln.\r\nParkplatz mit behindertengerechtem Zugang."
    ],
    "en": [
      "7/7, services Interflora, Florajet, home delivery, large choice of flowers, plants, cut flowers."
    ],
    "it": [
      "Al vostro servizio 7 giorni su 7, servizio Interflora, Florajet, consegna a domicilio, ampia scelta di piante, fiori recisi, composizioni floreali, bouquet rotondi, articoli da regalo.\r\nParcheggio per disabili."
    ],
    "fr": [
      "A  votre service 7j/7, service Interflora, Florajet, livraison à domicile, large choix de plantes, fleurs coupées, compositions florales, bouquets ronds, articles cadeaux.\r\nParking accès handicapé."
    ],
    "nl": [
      "Bereikbaar 7 dagen per week, service Interflora, Florajet, bezorging, grote keus aan planten, snijbloemen, bloemstukken, boeketten, cadeau artikelen."
    ],
    "es": [
      "A su servicio los 7 días de la semana, servicio Interflora, Florajet, entrega a domicilio, gran selección de plantas, flores cortadas, arreglos florales, ramos redondos, artículos de regalo.\r\nAparcamiento para discapacitados."
    ]
  },
