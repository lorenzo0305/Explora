  "rdfs:comment": {
    "de": [
      "Pullman Lyon, betreten Sie eine neue Welt! Entdecken Sie die Exklusivität der Marke Pullman in der Region Rhône-Alpes. Das Pullman Lyon, das am 27. November 2023 seine Türen öffnete, ist der neue, unumgängliche Treffpunkt."
    ],
    "en": [
      "Pullman Lyon, enter a new world! Discover the exclusivity of the Pullman brand in the Rhône-Alpes region. The Pullman Lyon, which opened its doors on 27 November 2023, is the new must-see meeting place."
    ],
    "it": [
      "Pullman Lyon, entrate in un nuovo mondo! Scoprite l'esclusività del marchio Pullman nella regione Rodano-Alpi. Il Pullman Lyon, che aprirà le sue porte il 27 novembre 2023, è il nuovo luogo d'incontro imperdibile."
    ],
    "fr": [
      "Pullman Lyon, entrez dans un nouveau monde ! Découvrez l’exclusivité de la marque Pullman en région Rhône-Alpes. Le Pullman Lyon, qui a ouvert ses portes les 27 novembre 2023, est le nouveau lieu de rendez-vous incontournable."
    ],
    "nl": [
      "Pullman Lyon, betreed een nieuwe wereld! Ontdek de exclusiviteit van het merk Pullman in de regio Rhône-Alpes. Het Pullman Lyon, dat op 27 november 2023 zijn deuren opent, is de nieuwe must-see ontmoetingsplaats."
    ],
    "es": [
      "Pullman Lyon, ¡entre en un nuevo mundo! Descubra la exclusividad de la marca Pullman en la región Rhône-Alpes. El Pullman Lyon, que abrió sus puertas el 27 de noviembre de 2023, es el nuevo punto de encuentro ineludible."
    ]
  },
