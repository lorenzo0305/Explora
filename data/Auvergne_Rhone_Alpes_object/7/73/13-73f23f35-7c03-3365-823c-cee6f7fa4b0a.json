  "rdfs:comment": {
    "de": [
      "Gaec des Perrier, geführt von Chloé und Nicolas PERRIER.\r\nAufzucht von Milchkühen und Milchkälbern.\r\nBestellung von Kalbfleischpaketen nur auf Vorbestellung"
    ],
    "en": [
      "Gaec des Perrier run by Chloé and Nicolas PERRIER.\r\nBreeding of dairy cows and milk-fed calves.\r\nVeal meat packages available by reservation only"
    ],
    "it": [
      "Gaec des Perrier gestito da Chloé e Nicolas PERRIER.\r\nAllevamento di vacche da latte e vitelli da latte.\r\nLe confezioni di carne di vitello possono essere ordinate solo su prenotazione"
    ],
    "fr": [
      "Gaec des Perrier tenu par Chloé et Nicolas PERRIER. \r\nElevage de vaches laitières et de veaux de lait.\r\nCommande de colis de viande de veau uniquement sur réservation"
    ],
    "nl": [
      "Gaec des Perrier gerund door Chloé en Nicolas PERRIER.\r\nFokken van melkkoeien en kalveren met melk.\r\nKalfsvleespakketten kunnen alleen op afspraak worden besteld"
    ],
    "es": [
      "Gaec des Perrier dirigida por Chloé y Nicolas PERRIER.\r\nCría de vacas lecheras y terneros alimentados con leche.\r\nLos paquetes de carne de ternera sólo pueden encargarse previo acuerdo"
    ]
  },
