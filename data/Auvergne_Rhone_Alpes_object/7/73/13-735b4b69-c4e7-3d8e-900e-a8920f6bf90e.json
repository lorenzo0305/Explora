  "rdfs:comment": {
    "de": [
      "Herstellung von Kakao, Schokolade und Süßwaren.\r\nEntdecken Sie den \"Caillou du Gévaudan\", eine Spezialität aus lokalen Haselnüssen, die mit Karamell umhüllt sind.\r\nVerkaufsstelle: Feinkostgeschäft Borde, Les Jardins du Gévaudan\r\nOnline-Verkauf unter https://www.borde.fr"
    ],
    "en": [
      "Production of cocoa, chocolate and confectionery products.\r\nDiscover \"Caillou du Gévaudan\", a specialty with local hazelnuts coated in caramel.\r\nPoint of sale : Epicerie fine Borde, Les Jardins du Gévaudan\r\nOnline sales at https://www.borde.fr"
    ],
    "it": [
      "Produzione di cacao, cioccolato e prodotti dolciari.\r\nScoprite il \"Caillou du Gévaudan\", una specialità con nocciole locali ricoperte di caramello.\r\nPunti vendita : Epicerie fine Borde, Les Jardins du Gévaudan\r\nVendite online su https://www.borde.fr"
    ],
    "fr": [
      "Fabrication de cacao, de chocolat et de produits de confiserie.\r\nDécouvrez le «Caillou du Gévaudan», spécialité aux noisettes locales enrobées de caramel.\r\nPoint de vente : Epicerie fine Borde, Les Jardins du Gévaudan\r\nVente en ligne sur https://www.borde.fr"
    ],
    "nl": [
      "Productie van cacao, chocolade en zoetwaren.\r\nOntdek de \"Caillou du Gévaudan\", een specialiteit met lokale hazelnoten bedekt met karamel.\r\nVerkooppunten: Epicerie Fine Borde, Tuinen van Gévaudan\r\nOnline verkoop op https://www.borde.fr"
    ],
    "es": [
      "Producción de cacao, chocolate y productos de confitería.\r\nDescubra el \"Caillou du Gévaudan\", una especialidad con avellanas locales recubiertas de caramelo.\r\nPuntos de venta : Epicerie fine Borde, Les Jardins du Gévaudan\r\nVenta en línea en https://www.borde.fr"
    ]
  },
