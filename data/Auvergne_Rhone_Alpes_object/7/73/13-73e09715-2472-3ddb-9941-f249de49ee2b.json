  "rdfs:comment": {
    "de": [
      "Entdecken Sie die lokale und savoyische Küche im Herzen von Savoyen!\r\nRestaurant im Tipi, Diots, Tartiflettes, Matouille des Bauges, Schweizer Fondue und Spezialitäten am Feuer und am Spieß.\r\nIm Sommer: Snacks, kleine Gerichte"
    ],
    "en": [
      "Unique site in Savoy Mont-Blanc, a hotel bar and restaurant under a tepee with many activities."
    ],
    "it": [
      "Venite a scoprire la cucina locale savoiarda nel cuore della Savoia!\r\nRistorante sotto un tepee, diots, tartiflettes, matouille des Bauges, fonduta svizzera e specialità intorno al fuoco e allo spiedo.\r\nIn estate: snack bar"
    ],
    "fr": [
      "Venez découvrir une cuisine locale et savoyarde au cœur de la Savoie !\r\nRestaurant sous tipi, diots, tartiflettes, matouille des Bauges, fondue Suisse, et spécialités autour du feu et à la broche.\r\nEn été : snack, petite restauration"
    ],
    "es": [
      "Venga a descubrir la cocina saboyana en el corazón de Saboya\r\nRestaurante bajo un tipi, diots, tartiflettes, matouille des Bauges, fondue suiza y especialidades al fuego y al espetón.\r\nEn verano: snack bar"
    ],
    "nl": [
      "Kom en ontdek de lokale Savoyaardse keuken in het hart van de Savoie!\r\nRestaurant onder een tipi, diots, tartiflettes, matouille des Bauges, Zwitserse fondue, en specialiteiten rond het vuur en aan het spit.\r\nIn de zomer: snackbar"
    ]
  },
  "rdfs:label": {
    "en": [
      "Village Tipi"
    ],
    "fr": [
      "Village Tipi - Snack restaurant"
    ]
  },
