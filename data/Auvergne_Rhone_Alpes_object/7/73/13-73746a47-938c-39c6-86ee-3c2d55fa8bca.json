  "rdfs:comment": {
    "de": [
      "Lou Vioulé do Vercors organisiert verschiedene umweltbezogene Veranstaltungen; zu ihren Aufgaben gehören das Blühen und die Pflege der städtischen Blumenbeete. Der Verein kümmert sich um die Pflege und Markierung der Pfade und Wege im Kanton La Chapelle."
    ],
    "en": [
      "Lou Vioulé do Vercors organizes a variety of environmental events, including the flowering and maintenance of municipal flowerbeds. The association also looks after the maintenance and marking of paths and tracks in the canton of La Chapelle."
    ],
    "it": [
      "Lou Vioulé do Vercors organizza una serie di eventi ambientali, tra cui la composizione di fiori e la manutenzione delle aiuole comunali. L'associazione si occupa anche della manutenzione e della segnaletica dei sentieri e dei percorsi pedonali nel cantone di La Chapelle."
    ],
    "fr": [
      "Lou Vioulé do Vercors organise diverses manifestations liées à l'environnement; fleurir et entretenir les massifs municipaux font parties de leurs missions. L'association s'occupe de l'entretien et balisage des sentiers et chemin du canton de La Chapelle."
    ],
    "es": [
      "Lou Vioulé do Vercors organiza diversas actividades relacionadas con el medio ambiente, como arreglos florales y mantenimiento de los parterres municipales. La asociación también se ocupa del mantenimiento y la señalización de los senderos y caminos del cantón de La Chapelle."
    ],
    "nl": [
      "Lou Vioulé do Vercors organiseert verschillende milieuactiviteiten, zoals bloemschikken en het onderhoud van de gemeentelijke bloemperken. De vereniging zorgt ook voor het onderhoud en de markering van voetpaden en paden in het kanton La Chapelle."
    ]
  },
  "rdfs:label": {
