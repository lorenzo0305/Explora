  "rdfs:comment": {
    "de": [
      "Der im SNCF-Bahnhof von Donzère untergebrachte Dritte Ort Pimms\r\nMediation bietet die Dienste der digitalen Integration und der sozialen Mediation an, die in der Region Sud Drôme eröffnet wurden."
    ],
    "en": [
      "Located in the Donzère SNCF station, where it handles reception, ticketing and passenger information, the Pimms\r\nmédiation offers digital inclusion and social mediation services for the southern Drôme region."
    ],
    "it": [
      "Situata nella stazione SNCF di Donzère, dove fornisce servizi di accoglienza, biglietteria e informazioni ai passeggeri, la Pimms\r\nmédiation offre servizi di inclusione digitale e di mediazione sociale per la regione della Drôme meridionale."
    ],
    "fr": [
      "Installé dans la gare SNCF de Donzère, dont il assure l’accueil, la billetterie et l’information voyageurs, le tiers lieu Pimms\r\nmédiation propose les services d’inclusion numérique et de médiation sociale ouverts sur le territoire sud Drôme."
    ],
    "es": [
      "Situada en la estación SNCF de Donzère, donde ofrece servicios de recepción, venta de billetes e información a los pasajeros, la Pimms\r\nofrece servicios de inclusión digital y mediación social en el sur de la Drôme."
    ],
    "nl": [
      "De Pimms médiation is gevestigd in het SNCF-station Donzère, waar het de receptie, kaartverkoop en passagiersinformatie verzorgt.\r\nmédiation digitale inclusie en sociale bemiddelingsdiensten in de hele regio Zuid-Drôme."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Pimms Médiation Portes de Provence"
    ]
  },
