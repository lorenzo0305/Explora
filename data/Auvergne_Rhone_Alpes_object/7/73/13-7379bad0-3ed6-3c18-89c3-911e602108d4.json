  "rdfs:comment": {
    "de": [
      "Das von Alexis Pinturault entworfene Winter Legacy ist ein einzigartiges Rennen und ein Tag, der 100% Spaß macht. Um die Ziellinie zu überqueren? Technik, Wagemut und eine gute Portion Verrücktheit!"
    ],
    "en": [
      "Conceived by Alexis Pinturault, the Winter Legacy is a unique race and a day of 100% fun. To cross the finish line? Technique, daring... and a healthy dose of madness!"
    ],
    "it": [
      "Progettata da Alexis Pinturault, la Winter Legacy è una gara unica e una giornata di divertimento al 100%. Per tagliare il traguardo? Tecnica, audacia e una buona dose di follia!"
    ],
    "fr": [
      "Conçu par Alexis Pinturault, le Winter Legacy, c’est une course unique et une journée 100% fun. Pour franchir la ligne d’arrivée ? De la technique, de l’audace… et une bonne dose de folie !"
    ],
    "es": [
      "Diseñada por Alexis Pinturault, la Winter Legacy es una carrera única y un día 100% divertido. ¿Para cruzar la línea de meta? Técnica, audacia... ¡y una buena dosis de locura!"
    ],
    "nl": [
      "De Winter Legacy, ontworpen door Alexis Pinturault, is een unieke race en een dag vol 100% plezier. Over de finish komen? Techniek, durf? en een flinke dosis gekte!"
    ]
  },
