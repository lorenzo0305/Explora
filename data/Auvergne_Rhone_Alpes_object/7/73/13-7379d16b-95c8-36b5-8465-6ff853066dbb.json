  "rdfs:comment": {
    "de": [
      "Das Maison du Tourisme de Marcillat-en-Combraille ist eine Einrichtung, deren Aufgabe es ist, \"den Tourismus zu empfangen, zu informieren und zu fördern\", und zwar auf dem Gebiet der Gebietskörperschaft, die sie eingerichtet hat. Es unterliegt dem Tourismusgesetz."
    ],
    "en": [
      "The Maison du Tourisme de Marcillat-en-Combraille is an organization whose mission is \"the reception, information and promotion of tourism\" on the territory of the community that established it. It comes under the Tourism Code."
    ],
    "it": [
      "La Maison du Tourisme de Marcillat-en-Combraille è un'organizzazione la cui missione è \"accogliere, informare e promuovere il turismo\" sul territorio dell'ente locale che l'ha istituita. Rientra nel Codice del Turismo."
    ],
    "fr": [
      "La Maison du Tourisme de Marcillat-en-Combraille est un organisme dont la mission est \"l'accueil, l'information et la promotion du tourisme\" sur le territoire de la collectivité qui l'a institué. Il relève du code du Tourisme."
    ],
    "es": [
      "La Maison du Tourisme de Marcillat-en-Combraille es una organización cuya misión es \"acoger, informar y promover el turismo\" en el territorio de la entidad local que la creó. Se trata del Código de Turismo."
    ],
    "nl": [
      "Het Maison du Tourisme de Marcillat-en-Combraille is een organisatie die tot taak heeft \"het toerisme te ontvangen, te informeren en te bevorderen\" op het grondgebied van de gemeente die haar heeft opgericht. Het valt onder het Wetboek van Toerisme."
    ]
  },
