  "rdfs:comment": {
    "de": [
      "Zwischen Tradition, Einfachheit und Großzügigkeit lädt Sie dieses authentische Bergrestaurant dazu ein, Savoyer Spezialitäten aus lokalen und saisonalen Produkten in einem außergewöhnlichen Rahmen zu entdecken und zu genießen."
    ],
    "en": [
      "Combining tradition, simplicity and generosity, this authentic mountain restaurant invites you to discover and enjoy Savoyard specialities made with local, seasonal produce in an exceptional setting."
    ],
    "it": [
      "Un mix di tradizione, semplicità e generosità, questo autentico ristorante di montagna vi invita a scoprire e gustare le specialità savoiarde a base di prodotti locali e di stagione in un ambiente eccezionale."
    ],
    "fr": [
      "Entre tradition, simplicité et générosité, cet authentique restaurant d’altitude vous invite à découvrir et à déguster des  spécialités savoyardes à base de produits locaux et de saison dans un cadre exceptionnel."
    ],
    "es": [
      "Mezcla de tradición, sencillez y generosidad, este auténtico restaurante de montaña le invita a descubrir y degustar especialidades saboyanas elaboradas con productos locales de temporada en un marco excepcional."
    ],
    "nl": [
      "Een mix van traditie, eenvoud en vrijgevigheid, dit authentieke bergrestaurant nodigt u uit om te ontdekken en te genieten van Savoyaardse specialiteiten gemaakt van lokale, seizoensgebonden producten in een uitzonderlijke omgeving."
    ]
  },
  "rdfs:label": {
    "en": [
