      "rdfs:comment": {
        "de": [
          "Im Herzen des Dorfes Flixecourt gelegen, empfängt Sie das Team von Aux fins gourmets dienstags bis sonntags von 6:30 bis 12:30 Uhr und von 15:00 bis 18:45 Uhr."
        ],
        "en": [
          "Located in the heart of the village of Flixecourt, the team of Aux fins gourmets welcomes you from Tuesday to Sunday from 6:30 to 12:30 and from 15:00 to 18:45."
        ],
        "it": [
          "Situato nel cuore del villaggio di Flixecourt, il team di Aux fins gourmets vi accoglie dal martedì alla domenica, dalle 6.30 alle 12.30 e dalle 15.00 alle 18.45."
        ],
        "fr": [
          "Situé au cœur du village de Flixecourt, l'équipe d'Aux fins gourmets vous accueille du mardi au dimanche de 6h30 à 12h30 et de 15h00 à 18h45."
        ],
        "es": [
          "Situado en el corazón del pueblo de Flixecourt, el equipo de Aux fins gourmets le recibe de martes a domingo de 6:30 a 12:30 y de 15:00 a 18:45."
        ],
        "nl": [
          "In het hart van het dorp Flixecourt ontvangt het team van Aux fins gourmets u van dinsdag tot zondag van 6.30 tot 12.30 uur en van 15.00 tot 18.45 uur."
        ]
      },
