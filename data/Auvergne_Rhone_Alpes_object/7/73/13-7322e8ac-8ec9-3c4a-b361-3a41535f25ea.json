  "rdfs:comment": {
    "de": [
      "Kurz nach Chouvigny, einem Monolithen links der Straße, parken Sie am Fuße des Felsens.\r\nNicht weniger als 70 Routen in drei Sektoren (Roc Armand, Les Ombres, Le Tunnel) wurden für Schwierigkeitsgrade von 4 bis 7 wiedereröffnet."
    ],
    "en": [
      "Some 70 lanes in three sectors (Roc Armand, Les Ombres, Le Tunnel) have been reopened, with levels ranging from 4 to 7."
    ],
    "it": [
      "Subito dopo Chouvigny, un monolite sulla sinistra della strada, parcheggiare ai piedi della roccia.\r\nSono state riaperte circa 70 vie in tre settori (Roc Armand, Les Ombres, Le Tunnel), con livelli che vanno da 4 a 7."
    ],
    "fr": [
      "Juste après Chouvigny, un monolithe à gauche de la route, se garer au pied du rocher.\r\nPas loin de 70 voies sur trois secteur (Roc Armand, Les Ombres, Le Tunnel) ont été réouverts pour des niveaux allant du 4 au 7."
    ],
    "nl": [
      "Vlak na Chouvigny, een monoliet aan de linkerkant van de weg, parkeer je aan de voet van de rots.\r\nOngeveer 70 routes in drie sectoren (Roc Armand, Les Ombres, Le Tunnel) zijn heropend, met niveaus van 4 tot 7."
    ],
    "es": [
      "Justo después de Chouvigny, un monolito a la izquierda de la carretera, aparcar al pie de la roca.\r\nSe han reabierto unas 70 rutas en tres sectores (Roc Armand, Les Ombres, Le Tunnel), con niveles que van del 4 al 7."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Site d'escalade Le Roc Armand"
    ]
  },
