  "rdfs:comment": {
    "de": [
      "Dieses kleine Restaurant – eine ehemalige, aus Stein gebaute, Scheune – befindet sich in Beaulieu am Fuße des Bergzugs “la Serre”. Saisonale Küche."
    ],
    "en": [
      "Carabasse is a small restaurant in an old stone barn, open all over the year in Beaulieu at the foot of the mountain called La Serre."
    ],
    "it": [
      "Carabasse è un piccolo ristorante aperto tutto l'anno nel sud dell'Ardèche, situato a Beaulieu, ai piedi della montagna Serre."
    ],
    "fr": [
      "Carabasse est un petit restaurant ouvert à l'année dans le sud de l'Ardèche situé à Beaulieu au pied de la montagne de la Serre."
    ],
    "nl": [
      "Carabasse is een klein restaurant dat het hele jaar open is in het zuiden van de Ardèche, gelegen in Beaulieu aan de voet van de Serre."
    ],
    "es": [
      "Carabasse es un pequeño restaurante abierto todo el año en el sur de la Ardèche, situado en Beaulieu, al pie de la montaña Serre."
    ]
  },
