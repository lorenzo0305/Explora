  "rdfs:comment": {
    "de": [
      "Der Transval ist das Verbindungsglied zwischen den Massiven Aiguille (vom unteren Teil der Combe des Juments) und Etale (auf der Höhe von Les Joux)."
    ],
    "en": [
      "The Transval connects the Aiguille massif to l'Etale."
    ],
    "it": [
      "Il Transval è il collegamento tra il massiccio dell'Aiguille (dal fondo della Combe des Juments) e il massiccio dell'Etale (a Les Joux)."
    ],
    "fr": [
      "Le Transval est le trait d'union entre les massifs de l'Aiguille (depuis le bas de la Combe des Juments) et de l'Etale (au niveau des Joux)."
    ],
    "es": [
      "El Transval es el enlace entre el macizo de la Aiguille (desde el fondo de la Combe des Juments) y el macizo de la Etale (en Les Joux)."
    ],
    "nl": [
      "De Transval vormt de verbinding tussen het massief van de Aiguille (vanaf de voet van de Combe des Juments) en dat van de Etale (ter hoogte van Les Joux)."
    ]
  },
  "rdfs:label": {
