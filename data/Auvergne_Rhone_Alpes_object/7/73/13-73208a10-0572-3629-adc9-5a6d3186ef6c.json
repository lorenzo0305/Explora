  "rdfs:comment": {
    "de": [
      "Besuchen Sie das Lycée des Catalins!\r\nEntdecken Sie unsere Ausbildungen, treffen Sie die Teams und besichtigen Sie unsere technischen Plattformen.\r\nWir erwarten Sie zahlreich!\r\nSehen Sie sich die Liste unserer Ausbildungsgänge an: www.catalins.fr"
    ],
    "en": [
      "Come and visit the Lycée des Catalins\r\nCome and discover our training courses, meet our teams and visit our technical facilities.\r\nWe look forward to seeing you!\r\nSee the list of our training courses at: www.catalins.fr"
    ],
    "it": [
      "Venite a visitare il Lycée des Catalins\r\nVenite a scoprire i nostri corsi, a conoscere i nostri team e a visitare le nostre strutture tecniche.\r\nNon vediamo l'ora di incontrarvi!\r\nConsultate l'elenco dei nostri corsi su: www.catalins.fr"
    ],
    "fr": [
      "Venez visiter le Lycée des Catalins\r\nVenez découvrir nos formations, rencontrer les équipes et visiter nos plateaux techniques.\r\nNous vous attendons nombreux !\r\nConsultez la liste de nos formations sur : www.catalins.fr"
    ],
    "es": [
      "Venga a visitar el Lycée des Catalins\r\nVenga a descubrir nuestros cursos, a conocer a nuestros equipos y a visitar nuestras instalaciones técnicas.\r\n¡Le esperamos!\r\nConsulte la lista de nuestros cursos en: www.catalins.fr"
    ],
    "nl": [
      "Kom het Lycée des Catalins bezoeken\r\nKom kennismaken met onze cursussen, ontmoet onze teams en bezoek onze technische faciliteiten.\r\nWe kijken ernaar uit om je daar te zien!\r\nBekijk de lijst van onze cursussen op: www.catalins.fr"
    ]
  },
  "rdfs:label": {
