  "rdfs:comment": {
    "de": [
      "Diese anspruchsvollere Route ermöglicht die Entdeckung versteckter Weinberge und die Entdeckung eines Teils des architektonischen und natürlichen Erbes von Forez (Réserve de Biterne, Schloss von Boën-sur-Lignon ...)."
    ],
    "en": [
      "This more demanding circuit takes in hidden vineyards and some of Forez's architectural and natural heritage (Réserve de Biterne, château de Boën-sur-Lignon, etc.)."
    ],
    "it": [
      "Questo percorso, più impegnativo, permette di scoprire vigneti nascosti e alcuni dei patrimoni architettonici e naturali della regione del Forez (Réserve de Biterne, château de Boën-sur-Lignon, ecc.)."
    ],
    "fr": [
      "Ce circuit plus exigeant permet la découverte des vignes cachées et la découverte d'une partie du patrimoine architectural et naturel du Forez (Réserve de Biterne, château de Boën-sur-Lignon ...)."
    ],
    "es": [
      "Esta ruta más exigente recorre viñedos escondidos y parte del patrimonio arquitectónico y natural de la región de Forez (Reserva de Biterne, castillo de Boën-sur-Lignon, etc.)."
    ],
    "nl": [
      "Deze meer veeleisende route voert langs verborgen wijngaarden en een deel van het architecturale en natuurlijke erfgoed van de Forez (Réserve de Biterne, château de Boën-sur-Lignon, enz.)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Etangs, vignes et villages - Boucle sportive - Boucle  LF 2"
    ]
  },
