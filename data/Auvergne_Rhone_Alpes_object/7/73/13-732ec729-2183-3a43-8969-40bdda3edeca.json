  "rdfs:comment": {
    "de": [
      "Leonie steht kurz vor der Entbindung! Sie ist zu früh dran... Ein Kind nach acht Monaten Ehe? Das ist eine tolle Nachricht, aber nicht jeder ist begeistert."
    ],
    "en": [
      "Léonie is about to give birth! She's ahead of schedule... A child after eight months of marriage? It's great news, but not to everyone's taste."
    ],
    "it": [
      "Léonie sta per partorire! È in anticipo sui tempi... Un figlio dopo otto mesi di matrimonio? È una bella notizia, ma non piace a tutti."
    ],
    "fr": [
      "Léonie va accoucher ! Elle est en avance... Un enfant, au bout de huit mois de mariage… C’est une grande nouvelle, mais qui n’est pas du goût de tout le monde."
    ],
    "es": [
      "¡Léonie está a punto de dar a luz! Se ha adelantado... ¿Un niño después de ocho meses de matrimonio? Es una gran noticia, pero no del gusto de todos."
    ],
    "nl": [
      "Léonie staat op het punt te bevallen! Ze ligt voor op schema... Een kind na acht maanden huwelijk? Het is geweldig nieuws, maar niet naar ieders smaak."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Théâtre : \"Léonie est en avance\" avec le Bofadon"
    ]
  },
