  "rdfs:comment": {
    "de": [
      "Züchter von Freilandschweinen, Catering auf dem Bauernhof, Camping auf dem Bauernhof, CC-Empfang, Parkbesuche. Hofladen, der die vor Ort verarbeiteten Produkte ohne Farb- und Konservierungsstoffe sowie die Produkte von über 40 lokalen Erzeugern anbietet."
    ],
    "en": [
      "Outdoor pig breeder, farm caterer, camping on the farm, CC reception, visit to the parks. Farm shop offering products processed on site without coloring or preservatives as well as products from more than 50 local producers."
    ],
    "it": [
      "Produttore di carne suina all'aperto, catering in fattoria, campeggio in fattoria, ricevimento CC, visite ai parchi. Spaccio aziendale che offre prodotti lavorati in loco senza coloranti né conservanti, oltre a prodotti di oltre 50 produttori locali."
    ],
    "fr": [
      "Eleveur de porc en plein air, traiteur fermier, camping à la ferme, accueil CC, visite des parcs. Boutique à la ferme proposant les produits transformés sur place sans colorant ni conservateur ainsi que les produits de plus de 50 producteurs locaux."
    ],
    "nl": [
      "Producent van varkensvlees in de open lucht, traiteur op de boerderij, kamperen op de boerderij, CC-ontvangst, parkbezoek. Boerderijwinkel met producten die ter plaatse worden verwerkt zonder kleurstoffen of conserveringsmiddelen, en met producten van meer dan 40 plaatselijke producenten."
    ],
    "es": [
      "Granja de cerdos al aire libre, servicio de comidas en la granja, camping en la granja, recepción CC, visitas al parque. Tienda agrícola que ofrece productos elaborados in situ sin colorantes ni conservantes, así como productos de más de 50 productores locales."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Boutique de Matt et Lili"
    ]
  },
