  "rdfs:comment": {
    "de": [
      "Unser Restaurant lädt Sie ein, hausgemachte Küche aus lokalen und saisonalen Produkten zu genießen, mit savoyischen Spezialitäten und köstlichen, herzhaften Gerichten. Genießen Sie außerdem unsere Panoramaterrasse mit Blick auf die Berge."
    ],
    "en": [
      "Our restaurant invites you to savor home-cooking based on local, seasonal produce, with Savoyard specialties and gourmet dishes. Enjoy our panoramic terrace with mountain views."
    ],
    "it": [
      "Il nostro ristorante vi invita a gustare una cucina fatta in casa, preparata con prodotti locali e di stagione, con specialità savoiarde e piatti golosi. Approfittate anche della nostra terrazza panoramica con vista sulle montagne."
    ],
    "fr": [
      "Notre restaurant vous invite à savourer une cuisine maison élaborée à partir de produits locaux et de saison, avec des spécialités savoyardes et des plats gourmands. Profitez également de notre terrasse panoramique avec vue sur les montagnes."
    ],
    "nl": [
      "Ons restaurant nodigt u uit om te genieten van huisgemaakte gerechten, bereid met lokale en seizoensgebonden producten, met Savoyaardse specialiteiten en smakelijke, royale gerechten. Geniet ook van ons panoramisch terras met uitzicht op de bergen."
    ],
    "es": [
      "Nuestro restaurante le invita a saborear platos caseros elaborados con productos locales y de temporada, con especialidades saboyanas y platos gourmet. También podrá disfrutar de nuestra terraza panorámica con vistas a las montañas."
    ]
  },
