  "rdfs:comment": {
    "de": [
      "Ein Raum für Tagungen oder Seminare zu mieten in einer Unterkunft für Gruppen und Etappen inmitten der Natur und in der Nähe des Hugenottenpfades. Vegetarische Verpflegung vor Ort. Ein Schwimmbad ist vorhanden. Bio-Frühstück angeboten."
    ],
    "en": [
      "A meeting or seminar room for rent in a gite d'étape and groups in the heart of nature, close to the sentier des Huguenots. Vegetarian catering on site. Swimming pool. Organic breakfast available."
    ],
    "it": [
      "Sala riunioni o seminari in affitto in un gite per pernottamenti e gruppi nel cuore della natura, vicino al sentiero degli Ugonotti. Ristorazione vegetariana in loco. Piscina. Colazione biologica disponibile. Capacità di 40 persone"
    ],
    "fr": [
      "Une salle de réunion ou séminaires à louer dans un gite d'étape et groupes en pleine nature et à proximité du sentier des Huguenots. Restauration végétarienne sur place. Piscine. Petit déjeuner bio proposé.Capacité de 40 personnes"
    ],
    "nl": [
      "Verhuur van een vergader- of seminarruimte in een gîte voor tussenstops en groepen midden in de natuur, vlakbij het Hugenotenpad. Vegetarische catering ter plaatse. Zwembad. Biologisch ontbijt beschikbaar."
    ],
    "es": [
      "Alquiler de una sala de reuniones o seminarios en una casa rural para escalas y grupos en plena naturaleza, cerca del sendero de los hugonotes. Restauración vegetariana in situ. Piscina. Desayuno biológico disponible. Capacidad para 40 personas"
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Fontaine des Lys"
    ]
  },
