  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/d2cbc13c-c4ad-3184-9140-6d2f3eb9441f",
      "dc:description": {
        "de": [
          "Neues Konfektionsgeschäft auf dem Grand'Place von Montreuil.\nVerkauf von Herren- und Damenbekleidung vom mittleren bis zum gehobenen Preissegment.\n\nDas Geschäft ist auch ein Teesalon und bietet Schnellrestaurants vor Ort an.\n\nÖffnungszeiten: Dienstag bis Samstag von 10 bis 19 Uhr.\n\nBildnachweis: Damien Cornille"
        ],
        "en": [
          "New ready-to-wear store on Montreuil's Grand'Place.\nSales of men's and women's clothing ranging from mid-range to high-end.\n\nThe shop also serves as a tearoom and fast-food restaurant.\n\nOpen Tuesday to Saturday, 10am to 7pm.\n\nPhoto credit: Damien Cornille"
        ],
        "it": [
          "Nuovo negozio di prêt-à-porter sulla Grand'Place di Montreuil.\nAbbigliamento uomo e donna di fascia media e alta.\n\nIl negozio funge anche da sala da tè e fast food.\n\nAperto dal martedì al sabato dalle 10.00 alle 19.00.\n\nCredito fotografico: Damien Cornille"
        ],
        "fr": [
          "Nouveau commerce de prêt-à-porter sur la Grand'Place de Montreuil.\nVente de vêtements masculins et féminins allant du milieu de gamme à du haut de gamme.\n\nLe commerce fait également salon de thé et restauration rapide sur place.\n\nOuverture du mardi au samedi de 10h à 19h.\n\nCrédit photo : Damien Cornille"
        ],
        "es": [
          "Nueva tienda de prêt-à-porter en la Grand'Place de Montreuil.\nRopa masculina y femenina de gama media y alta.\n\nLa tienda también sirve de salón de té y comida rápida.\n\nAbierto de martes a sábado de 10.00 a 19.00 h.\n\nCrédito de la foto: Damien Cornille"
        ],
        "nl": [
          "Nieuwe confectiezaak op de Grand'Place in Montreuil.\nMannen- en vrouwenkleding van middenklasse tot topklasse.\n\nDe winkel doet ook dienst als tearoom en fastfood.\n\nGeopend van dinsdag tot zaterdag van 10.00 tot 19.00 uur.\n\nFotocredit: Damien Cornille"
        ]
      },
      "@type": [
        "Description"
      ],
