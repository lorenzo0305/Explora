  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Musée Savoisien, das in einem Kloster aus dem 13. Jahrhundert untergebracht ist: 2000 Objekte, 7 Themenbereiche und eine moderne Museographie, um die Geschichte und die Kulturen Savoyens zu erkunden. Interaktive Erlebnisse und freier Eintritt für alle!"
    ],
    "en": [
      "Discover the Musée Savoisien, housed in a 13th-century convent: 2,000 objects, seven themed areas and modern museography to explore the history and cultures of Savoie. Interactive experiences and free admission for all!"
    ],
    "it": [
      "Scoprite il Museo Savoisien, ospitato in un convento del XIII secolo: 2000 oggetti, 7 aree tematiche e una museografia moderna per esplorare la storia e le culture della Savoia. Esperienze interattive e ingresso gratuito per tutti!"
    ],
    "fr": [
      "Découvrez le Musée Savoisien, installé dans un couvent du XIIIe siècle : 2000 objets, 7 espaces thématiques et une muséographie moderne pour explorer l’histoire et les cultures de Savoie. Expériences interactives et entrée gratuite pour tous !"
    ],
    "nl": [
      "Ontdek het Musée Savoisien, gevestigd in een 13e-eeuws klooster: 2000 voorwerpen, 7 thematische ruimtes en een moderne museografie om de geschiedenis en culturen van Savoye te ontdekken. Interactieve ervaringen en gratis toegang voor iedereen!"
    ],
    "es": [
      "Descubra el Museo Savoisien, instalado en un convento del siglo XIII: 2.000 objetos, 7 espacios temáticos y una museografía moderna para explorar la historia y las culturas de Saboya. Experiencias interactivas y entrada gratuita para todos"
    ]
  },
