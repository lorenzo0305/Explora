  "rdfs:comment": {
    "de": [
      "Im Herzen eines der schönsten Dörfer Frankreichs, traditionelles Restaurant, Brasserie, Spezialitäten der Auvergne. Terrasse, Innenräume, Privatisierung möglich. Reservierungen werden empfohlen, bitte kontaktieren Sie uns für unsere Öffnungszeiten."
    ],
    "en": [
      "In the heart of one of France's most beautiful villages, traditional restaurant, brasserie, Auvergne specialties. Terrace, indoor rooms, privatization possible. Reservations recommended, please contact us for opening hours."
    ],
    "it": [
      "Nel cuore di uno dei più bei villaggi di Francia, ristorante tradizionale, brasserie, specialità dell'Alvernia. Terrazza, sale interne, possibilità di noleggio privato. Si consiglia la prenotazione, per gli orari di apertura si prega di contattarci."
    ],
    "fr": [
      "Au cœur d'un des Plus Beaux Villages de France, restaurant traditionnel, brasserie, spécialités auvergnates. Terrasse, salles intérieures, possibilité privatisation. Réservations conseillées, n'hésitez pas à nous contacter pour nos horaires d'ouvertures."
    ],
    "nl": [
      "In het hart van een van de mooiste dorpen van Frankrijk, traditioneel restaurant, brasserie, specialiteiten uit de Auvergne. Terras, zalen binnen, privéverhuur mogelijk. Reserveren aanbevolen, neem contact met ons op voor de openingstijden."
    ],
    "es": [
      "En el corazón de uno de los pueblos más bellos de Francia, restaurante tradicional, brasserie, especialidades de Auvernia. Terraza, salones interiores, alquiler privado. Se recomienda reservar, contacte con nosotros para conocer los horarios."
    ]
  },
  "rdfs:label": {
