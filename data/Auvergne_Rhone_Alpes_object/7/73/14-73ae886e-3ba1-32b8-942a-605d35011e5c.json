  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/73596d00-d91a-3b0b-b284-0e4dabf2b900",
      "dc:description": {
        "de": [
          "Fauna, Flora, Geologie, Schutz und Verwaltung der natürlichen Lebensräume, Erosion und Küstenlinie: Gehen wir gemeinsam auf Entdeckungsreise durch das Gebiet der 2 Kaps, seine natürlichen Reichtümer und sein lokales Leben."
        ],
        "en": [
          "Fauna, flora, geology, protection and management of natural environments, erosion and coastline: let's set off together to discover the 2 Capes site, its natural riches and its local life."
        ],
        "it": [
          "Fauna, flora, geologia, protezione e gestione degli ambienti naturali, erosione e coste: partiamo insieme alla scoperta del sito 2 Capes, delle sue ricchezze naturali e della sua vita locale."
        ],
        "fr": [
          "Faune, flore, géologie, protection et gestion des milieux naturels, érosion et trait de côte : partons ensemble à la découverte du site des 2 caps, des ses richesses naturelles et de sa vie locale."
        ],
        "nl": [
          "Fauna, flora, geologie, bescherming en beheer van natuurlijke omgevingen, erosie en kustlijn: laten we samen op pad gaan om de site van 2 kapen, de natuurlijke rijkdommen en het plaatselijke leven te ontdekken."
        ],
        "es": [
          "Fauna, flora, geología, protección y gestión de los medios naturales, erosión y litoral: partamos juntos a descubrir el paraje de los 2 Cabos, sus riquezas naturales y su vida local."
        ]
      },
