  "rdfs:comment": {
    "de": [
      "Abwechslungsreiche Küche, bei der das Produkt im Vordergrund steht. Täglich zum Mittagessen geöffnet, Bestellungen werden 7 Tage die Woche von 12-15 Uhr entgegengenommen und von 8.30-19 Uhr geöffnet. Wunderschöner Rahmen in der Mitte des Anwesens, schattige Terrasse."
    ],
    "en": [
      "Varied cuisine with a focus on local produce, open daily for lunch, orders taken 7 days a week from 12pm to 3pm and open from 8:30am to 7pm. Magnificent setting in the center of the estate, shaded terrace."
    ],
    "it": [
      "Cucina variegata in cui viene valorizzato il prodotto, aperto tutti i giorni a pranzo, ordinazioni prese 7 giorni su 7 dalle 12.00 alle 15.00 e apertura dalle 8.30 alle 19.00. Magnifica cornice al centro della tenuta, terrazza ombreggiata."
    ],
    "fr": [
      "Cuisine variée où le produit est mis en valeur, ouvert tous les jours pour le déjeuner, prises de commandes 7j/7 de 12h à 15h et ouverture de 8h30 à 19h. Cadre magnifique au centre du domaine, terrasse ombragée."
    ],
    "nl": [
      "Gevarieerde keuken waar het product centraal staat, elke dag geopend voor de lunch, bestellingen worden 7 dagen per week opgenomen van 12.00 tot 15.00 uur en geopend van 8.30 tot 19.00 uur. Prachtige omgeving in het midden van het landgoed, schaduwrijk terras."
    ],
    "es": [
      "Cocina variada donde destaca el producto, abierto todos los días para almorzar, toma de pedidos 7 días a la semana de 12h a 15h y abierto de 8h30 a 19h. Magnífico entorno en el centro de la finca, terraza a la sombra."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Domaine de Champlong - Brasserie Le 9-18"
    ]
  },
