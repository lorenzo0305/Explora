  "rdfs:comment": {
    "de": [
      "Das Restaurant liegt nur wenige Schritte von den Plätzen und dem Bahnhof entfernt. Entdecken Sie eine familiäre und freundliche Atmosphäre sowie unsere Fisch- und Meeresfrüchtespezialitäten und nicht weniger als 20 hausgemachte Saucen, die für unsere Muscheln variiert werden."
    ],
    "en": [
      "Located just a stone's throw from the town squares and railway station, come and discover our family-friendly atmosphere, fish and seafood specialities and no fewer than 20 homemade sauces for our mussels."
    ],
    "it": [
      "A due passi dalle piazze e dalla stazione, venite a scoprire la nostra atmosfera amichevole e familiare, nonché le nostre specialità di pesce e frutti di mare e ben 20 salse fatte in casa per le nostre cozze."
    ],
    "fr": [
      "Situé à deux pas des places et de la gare, venez découvrir une ambiance familiale et conviviale ainsi que nos spécialités poissons, fruits de mer et pas moins de 20 sauces maison déclinées pour nos moules."
    ],
    "es": [
      "Situado a dos pasos de las plazas y de la estación, venga a descubrir nuestro ambiente familiar y acogedor, así como nuestras especialidades de pescado y marisco y no menos de 20 salsas caseras para nuestros mejillones."
    ],
    "nl": [
      "Kom op een steenworp afstand van de pleinen en het station onze gezellige, familiale sfeer ontdekken, evenals onze vis- en zeevruchtenspecialiteiten en niet minder dan 20 huisgemaakte sauzen voor onze mosselen."
    ]
  },
  "rdfs:label": {
