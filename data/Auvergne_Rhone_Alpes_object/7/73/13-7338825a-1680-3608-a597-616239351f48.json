  "rdfs:comment": {
    "de": [
      "Bio-Viehzucht Ecocert - Käse von Kuh, Ziege und Schaf, Joghurt - Roggen und Buchweizen und Dinkel, Markt jeden Freitag auf dem Bauernhof."
    ],
    "en": [
      "Organic farming Ecocert - Cow, goat and sheep cheeses, yoghurts - Rye flour and buckwheat and spelt, Market every Friday on the farm."
    ],
    "it": [
      "Agricoltura biologica Ecocert: formaggi di mucca, capra e pecora, yogurt, farina di segale, grano saraceno e farro. Mercato ogni venerdì presso la fattoria."
    ],
    "fr": [
      "Elevage en agriculture biologique Ecocert : fromages de vache, chèvre et brebis, yaourts, farine de seigle et sarrasin et épeautre. Marché tous les vendredis à la ferme."
    ],
    "nl": [
      "Ecocert biologische landbouw: koe-, geiten- en schapenkaas, yoghurt, rogge- en boekweitmeel en spelt. Elke vrijdag markt op de boerderij."
    ],
    "es": [
      "Agricultura ecológica Ecocert: quesos de vaca, cabra y oveja, yogures, harina de centeno y trigo sarraceno y espelta. Mercado todos los viernes en la granja."
    ]
  },
