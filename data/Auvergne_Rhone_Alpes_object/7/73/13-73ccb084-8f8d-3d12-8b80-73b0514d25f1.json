  "rdfs:comment": {
    "de": [
      "Das Café des Simples ist eine Bar und Teestube am Fuße der Altstadt von Auzon, die im Juli 2021 eröffnet wurde. Sein Name ist eine Hommage an die mittelalterliche Bezeichnung für aromatische und medizinische Pflanzen, die \"Simples\"."
    ],
    "en": [
      "Le Café des Simples is a bar-tea room at the foot of Auzon?s old town, open since July 2021. Its name pays tribute to the medieval name for aromatic and medicinal plants, \"simples\"."
    ],
    "it": [
      "Il Café des Simples è un bar e sala da tè ai piedi del centro storico di Auzon, aperto nel luglio 2021. Il suo nome è un omaggio al nome medievale delle piante aromatiche e medicinali, \"simples\"."
    ],
    "fr": [
      "Le Café des Simples est un bar- salon de thé situé au pied de la vieille ville d’Auzon, ouvert depuis juillet 2021. Son nom rend hommage à l’appellation médiévale des plantes aromatiques et médicinales, les « simples »."
    ],
    "es": [
      "El Café des Simples es un bar y salón de té al pie del casco antiguo de Auzon, inaugurado en julio de 2021. Su nombre es un homenaje a la denominación medieval de las plantas aromáticas y medicinales, \"simples\"."
    ],
    "nl": [
      "Café des Simples is een bar en tearoom aan de voet van de oude stad Auzon, geopend in juli 2021. De naam is een eerbetoon aan de middeleeuwse naam voor aromatische en geneeskrachtige planten, \"simples\"."
    ]
  },
