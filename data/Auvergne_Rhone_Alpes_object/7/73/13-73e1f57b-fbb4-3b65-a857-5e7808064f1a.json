  "rdfs:comment": {
    "de": [
      "Pierre hält eine Herde von 60 Charolais-Mutterkühen, die mit Futtermitteln (Futter und Getreide) geboren und aufgezogen werden, die auf dem Betrieb, der den Rhône-Kanal überblickt, produziert werden."
    ],
    "en": [
      "Pierre raises a herd of 60 Charolais suckler cows, which are born and raised on feed (forage and cereals) produced on the farm overlooking the Rhone canal."
    ],
    "it": [
      "Pierre alleva una mandria di 60 vacche nutrici Charolais, nate e allevate con mangimi (foraggi e cereali) prodotti nell'azienda agricola che si affaccia sul Canale del Rodano."
    ],
    "fr": [
      "Pierre élève un troupeau de 60 vaches allaitantes de type charolaise qui naissent et sont élevées avec les aliments (fourrage et céréales) produits sur l’exploitation qui domine le canal du Rhône."
    ],
    "nl": [
      "Pierre fokt een kudde van 60 Charolais zoogkoeien, die worden geboren en opgefokt met voer (voedergewassen en granen) dat wordt geproduceerd op de boerderij met uitzicht op het Rhônekanaal."
    ],
    "es": [
      "Pierre cría un rebaño de 60 vacas nodrizas Charolais, que nacen y se crían con piensos (forrajes y cereales) producidos en la explotación, con vistas al Canal del Ródano."
    ]
  },
  "rdfs:label": {
