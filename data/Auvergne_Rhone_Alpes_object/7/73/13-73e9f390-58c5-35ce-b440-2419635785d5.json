  "rdfs:comment": {
    "de": [
      "Dieses 3***-Hotel befindet sich nur wenige Schritte vom Flughafen und der Autobahn entfernt. Sehr gute Erreichbarkeit für ein Arbeitstreffen oder Seminar."
    ],
    "en": [
      "This 3*** hotel is located a stone's throw from the airport and the motorway. Very easy access for a business meeting or seminar."
    ],
    "it": [
      "Questo hotel 3*** si trova vicino all'aeroporto e all'autostrada. Accesso molto facile per una riunione di lavoro o un seminario."
    ],
    "fr": [
      "Cet hôtel 3*** se situe à deux pas de l'aéroport et de l'autoroute. Très grande facilité d'accès pour une réunion de travail ou séminaire."
    ],
    "es": [
      "Este hotel de 3*** está situado cerca del aeropuerto y de la autopista. Muy fácil acceso para una reunión de negocios o un seminario."
