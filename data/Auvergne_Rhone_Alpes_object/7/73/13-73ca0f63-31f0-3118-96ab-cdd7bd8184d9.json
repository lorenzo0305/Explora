  "rdfs:comment": {
    "de": [
      "Die Gemeinde Peyrus ist das letzte Dorf vor dem Aufstieg zum Vercors über den Col des Limouches, eingebettet in eine Falte der Monts du Matin. Sie liegt am Ausgang des Grès-Tals und hat eine Fläche von 1070 ha."
    ],
    "en": [
      "The last village before climbing the Vercors via the Col des Limouches, nestled in a fold of the Monts du Matin, the commune of Peyrus lies at the mouth of the Grès valley and covers an area of 1070 hectares."
    ],
    "it": [
      "Ultimo villaggio prima di scalare il Vercors attraverso il passo di Limouches, incastonato in una piega dei Monts du Matin, il comune di Peyrus si trova alla fine della valle di Grès e si estende su una superficie di 1070 ettari."
    ],
    "fr": [
      "Dernier village avant l'ascension du Vercors par le col des Limouches, blotti dans un pli des monts du Matin, la commune de Peyrus est située au débouché de la vallée de la Grès et présente une superficie de 1070ha."
    ],
    "es": [
      "Último pueblo antes de subir al Vercors por el puerto de Limouches, enclavado en un pliegue de los Montes del Matin, el municipio de Peyrus está situado al final del valle del Grès y tiene una superficie de 1070 hectáreas."
    ],
    "nl": [
      "Peyrus, het laatste dorp voor de beklimming van de Vercors via de Col des Limouches en genesteld in een plooi van de Monts du Matin, ligt aan het einde van de Grès-vallei en beslaat een gebied van 1070 hectare."
    ]
  },
