  "rdfs:comment": {
    "de": [
      "Begleitet von den sanften Schritten eines Esels, der Ihre Sachen tragen kann, können Sie unsere schöne Region zwischen Ebenen, Bergen und Flüssen erkunden! Das Massif de Saoû bietet eine breite Palette an kleinen und großen Spaziergängen, die Sie erkunden können."
    ],
    "en": [
      "Accompanied by the gentle steps of a donkey, who can carry your belongings, set off to discover our beautiful region, between plains, mountains and river! The Saoû massif offers a wide range of short and long walks for you to explore."
    ],
    "it": [
      "Accompagnati dai dolci passi dell'asino, che può trasportare i vostri effetti personali, partite alla scoperta della nostra bella regione, tra pianure e montagne, e del fiume! Il massiccio del Saoû offre un'ampia gamma di passeggiate brevi e lunghe da esplorare."
    ],
    "fr": [
      "Accompagné du doux pas de l’âne, qui pourra porter vos affaires, partez à la découverte de notre belle région, entre plaines montagnes, et rivière ! Le massif de Saoû permet une large palette de petites aux grandes balades que vous pourrez venir explorer."
    ],
    "nl": [
      "Begeleid door de zachte stappen van de ezel, die je spullen kan dragen, ga je op pad om onze prachtige streek te ontdekken, tussen de vlaktes en de bergen, en de rivier! Het Saoû-massief biedt een breed scala aan korte en lange wandelingen om te verkennen."
    ],
    "es": [
      "Acompañado por los suaves pasos del burro, que puede llevar sus pertenencias, salga a descubrir nuestra hermosa región, entre llanuras y montañas, ¡y el río! El macizo de Saoû ofrece una amplia gama de paseos cortos y largos que puede explorar."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Balade Âne"
    ]
  },
