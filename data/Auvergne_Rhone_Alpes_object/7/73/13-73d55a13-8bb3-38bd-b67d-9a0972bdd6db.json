  "rdfs:comment": {
    "de": [
      "La Pastorale ist eine Bio-Brauerei in den Bergen, die ihren eigenen Hopfen und ihre eigenen Heilpflanzen anbaut, um 100 % lokale Biere zu brauen. Direktverkauf in Les Estables, Verkostung vor Ort und eine große Auswahl an handwerklich gebrauten Bieren, die es zu entdecken gilt."
    ],
    "en": [
      "An organic mountain brewery, La Pastorale grows its own hops and medicinal plants to brew 100% local beers. Direct sales in Les Estables, on-site tastings and a wide range of craft beers to discover."
    ],
    "it": [
      "Birrificio biologico di montagna, La Pastorale coltiva il proprio luppolo e le proprie piante medicinali per produrre birre 100% locali. Vendita diretta a Les Estables, degustazioni in loco e un'ampia gamma di birre artigianali da scoprire."
    ],
    "fr": [
      "Brasserie de montagne en agriculture bio, La Pastorale cultive ses propres houblons et plantes médicinales pour brasser des bières 100 % locales. Vente directe aux Estables, dégustation sur place et large gamme de bières artisanales à découvrir."
    ],
    "nl": [
      "La Pastorale is een biologische bergbrouwerij die zijn eigen hop en geneeskrachtige planten kweekt om 100% lokale bieren te brouwen. Directe verkoop in Les Estables, proeverijen ter plekke en een breed assortiment ambachtelijke bieren om te ontdekken."
    ],
    "es": [
      "Cervecería ecológica de montaña, La Pastorale cultiva su propio lúpulo y plantas medicinales para elaborar cervezas 100% locales. Venta directa en Les Estables, degustaciones in situ y una amplia gama de cervezas artesanas por descubrir."
    ]
  },
