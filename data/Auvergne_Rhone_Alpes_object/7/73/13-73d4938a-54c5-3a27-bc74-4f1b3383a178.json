  "rdfs:comment": {
    "de": [
      "Der Informationspunkt von Laroquebrou empfängt Sie das ganze Jahr über in dieser wunderschönen mittelalterlichen Stadt, die als Petite Cité de Caractère (kleine Stadt mit Charakter) eingestuft wurde."
    ],
    "en": [
      "The Information Point of Laroquebrou welcomes you all year round, in the heart of this magnificent medieval city, classified as a Small City of Character."
    ],
    "it": [
      "Il punto informativo di Laroquebrou vi accoglie tutto l'anno, nel cuore di questa magnifica città medievale, classificata come \"Petite Cité de Caractère\"."
    ],
    "fr": [
      "Le Point informations de Laroquebrou vous accueil toute l'année, au sein de cette magnifique cité médiévale, classée Petite Cité de Caractère."
    ],
    "nl": [
      "Het informatiepunt van Laroquebrou verwelkomt u het hele jaar door, in het hart van deze prachtige middeleeuwse stad, geklasseerd als \"Petite Cité de Caractère\"."
    ],
    "es": [
      "El Punto de Información de Laroquebrou le da la bienvenida todo el año, en el corazón de esta magnífica ciudad medieval, clasificada como \"Petite Cité de Caractère\"."
    ]
  },
