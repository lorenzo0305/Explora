  "rdfs:comment": {
    "de": [
      "Der Chefkoch des Hotels serviert Ihnen eine traditionelle französische Speisekarte\r\nDer Saal bietet Platz für bis zu 35 Personen, bei schönem Wetter auch auf der Terrasse zur Innenhofseite."
    ],
    "en": [
      "The hotel's chef offers a traditional French menu\r\nThe room can accommodate up to 35 people, and when the weather permits, the terrace on the courtyard side."
    ],
    "it": [
      "Lo chef dell'hotel propone un menu tradizionale francese\r\nLa sala da pranzo può ospitare fino a 35 persone e, tempo permettendo, la terrazza sul cortile interno."
    ],
    "fr": [
      "Le chef de l'hôtel vous propose une carte traditionnelle française. \r\nLa salle peut accueillir jusqu'à 35 personnes, et lorsque le temps le permet, la terrasse côté cour intérieure."
    ],
    "es": [
      "El chef del hotel ofrece un menú tradicional francés\r\nEl comedor tiene capacidad para 35 personas y, si el tiempo lo permite, la terraza del patio interior."
    ],
    "nl": [
      "De chef van het hotel biedt een traditioneel Frans menu\r\nDe eetzaal biedt plaats aan maximaal 35 personen en bij mooi weer het terras op de binnenplaats."
    ]
  },
  "rdfs:label": {
