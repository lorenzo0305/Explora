  "rdfs:comment": {
    "de": [
      "Tauchen Sie in der königlichen Abtei von Chaalis in das Mittelalter ein! Ritter, Handwerker und\ntroubadoure erwarten Sie, um in die Vergangenheit einzutauchen. Auf dem Programm stehen ein Markt\nmittelalterlicher Markt, Ritterspiele, Aufführungen und Animationen."
    ],
    "en": [
      "Immerse yourself in the Middle Ages at the Royal Abbey of Chaalis! Knights, craftsmen and\nand troubadours await you for an immersion in the past. On the program: medieval\nmedieval market, jousting, shows and entertainment."
    ],
    "it": [
      "Immergetevi nel Medioevo all'Abbazia Reale di Chaalis! Cavalieri, artigiani e\ncavalieri, artigiani e trovatori. In programma: mercato medievale\nmercato medievale, giostre, spettacoli e intrattenimento."
    ],
    "fr": [
      "Plongez au cœur du Moyen Âge à l’abbaye royale de Chaalis ! Chevaliers, artisans et \ntroubadours vous attendent pour une immersion dans le passé. Au programme, marché \nmédiéval, joutes, spectacles et animations."
    ],
    "es": [
      "¡Sumérjase en la Edad Media en la Abadía Real de Chaalis! Caballeros, artesanos y\ncaballeros, artesanos y trovadores. En el programa: mercado\nmercado medieval, justas, espectáculos y animaciones."
    ],
    "nl": [
      "Dompel jezelf onder in de Middeleeuwen in de Koninklijke Abdij van Chaalis! Ridders, ambachtslieden en\nridders, ambachtslieden en troubadours. Op het programma: middeleeuwse\nmiddeleeuwse markt, steekspelen, shows en entertainment."
    ]
  },
