  "rdfs:comment": {
    "de": [
      "Fabien und Laurence Schots sind leidenschaftliche Bienenliebhaber und bieten Ihnen Honig aus ihren Bienenstöcken an. Der Honig mit seinen vielfältigen Aromen wird auf Wanderimkereien in der Auvergne Rhône-Alpes gesammelt."
    ],
    "en": [
      "Fabien and Laurence Schots are passionate about bees and offer you honeys from their beehives, honeys with a variety of fragrances, harvested during transhumance in Auvergne Rhône-Alpes."
    ],
    "it": [
      "Fabien e Laurence Schots sono appassionati di api e vi offrono i mieli dei loro alveari, mieli con una varietà di sapori, raccolti durante la transumanza in Alvernia Rodano-Alpi."
    ],
    "fr": [
      "Passionnés par les abeilles, Fabien et Laurence Schots vous proposent les miels issus de leurs ruches, des miels aux parfums variés, récoltés au fil des transhumances en Auvergne Rhône-Alpes."
    ],
    "es": [
      "Fabien y Laurence Schots son unos apasionados de las abejas y le proponen mieles de sus colmenas, mieles de sabores variados, recolectadas durante la trashumancia en Auvergne Rhône-Alpes."
    ],
    "nl": [
      "Fabien en Laurence Schots hebben een passie voor bijen en bieden u honing uit hun bijenkorven, honing met verschillende smaken, verzameld tijdens de transhumance in Auvergne Rhône-Alpes."
    ]
  },
