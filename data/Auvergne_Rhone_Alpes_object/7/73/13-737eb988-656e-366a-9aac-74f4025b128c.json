  "rdfs:comment": {
    "de": [
      "Spezialist für Fleisch und Wurstwaren aus der Ardèche seit 1946. Fleisch aus der Region\r\nTrocknungsanlagen in 1000 m Höhe, unser gesamtes Fleisch garantiert ohne GVO und unsere \"hausgemachten\" Herstellungen. Ausgewählt von \"Etapes savoureuses Ardèche®\" und \"Goûtez l'Ardèche®\"."
    ],
    "en": [
      "Specialist in meat and sausage Ardèchoise since 1946.\r\nOur dryers are located at 1000 meters altitude, all our meat is guaranteed GMO. Homemade products."
    ],
    "it": [
      "Specialista in carne e salumi dell'Ardèche dal 1946. Carne locale\r\nEssiccatoi situati a 1000 m di altitudine, tutte le nostre carni garantite senza OGM e i nostri prodotti \"fatti in casa\". Selezionato da \"Etapes savoureuses Ardèche®\" e \"Goûtez l'Ardèche®\"."
    ],
    "fr": [
      "Spécialiste en viande et charcuterie ardéchoise depuis 1946. Viande de pays\r\nSéchoirs situés à 1000 m d’altitude, toute notre viande garantie sans OGM et nos fabrications « maison ». Sélectionné par « Etapes savoureuses Ardèche® » et « Goûtez l'Ardèche® »."
    ],
    "nl": [
      "Specialist in vlees en vleeswaren uit de Ardèche sinds 1946. Lokaal vlees\r\nDrogers op 1000 m hoogte, al ons vlees gegarandeerd GGO-vrij en onze \"huisgemaakte\" producten. Geselecteerd door \"Etapes savoureuses Ardèche®\" en \"Goûtez l'Ardèche®\"."
    ],
    "es": [
      "Especialista en carne y charcutería de Ardèche desde 1946. Carne local\r\nSecaderos situados a 1000 m de altitud, toda nuestra carne garantizada sin OGM y nuestros productos \"caseros\". Seleccionado por \"Etapes savoureuses Ardèche®\" y \"Goûtez l'Ardèche®\"."
    ]
  },
