  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/6d22c28f-cc86-3bbf-9ea8-3191681a3479",
      "dc:description": {
        "de": [
          "Für Kinder ab 4 Jahren in Begleitung von mindestens einem Erwachsenen.\nKinder haben freien Eintritt, Erwachsene zahlen Eintritt.\nFreier Besuch in den Räumen.\nAb 14 Uhr."
        ],
        "en": [
          "For children aged 4 and over accompanied by at least 1 adult.\nFree admission for children, admission fee for adults.\nSelf-guided tour of the rooms.\nStarting at 2pm."
        ],
        "it": [
          "Per bambini a partire dai 4 anni accompagnati da almeno un adulto.\nIngresso gratuito per i bambini, a pagamento per gli adulti.\nVisita gratuita delle sale.\nDalle 14:00."
        ],
        "fr": [
          "Pour les enfants à partir de 4 ans accompagnés d’au moins 1 adulte.\nEntrée gratuite pour les enfants, droit d’entrée pour les adultes.\nVisite libre dans les salles.\nA partir de 14h."
        ],
        "nl": [
          "Voor kinderen vanaf 4 jaar onder begeleiding van minstens 1 volwassene.\nGratis toegang voor kinderen, toegangsprijs voor volwassenen.\nGratis rondleiding door de kamers.\nVanaf 14.00 uur."
        ],
        "es": [
          "Para niños a partir de 4 años acompañados de al menos 1 adulto.\nEntrada gratuita para los niños y de pago para los adultos.\nVisita gratuita de las salas.\nA partir de las 14 h."
        ]
      },
