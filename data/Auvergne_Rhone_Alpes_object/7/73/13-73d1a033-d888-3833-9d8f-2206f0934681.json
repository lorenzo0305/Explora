  "rdfs:comment": {
    "de": [
      "Das Restaurant in Menet empfängt Sie von Dienstag bis Freitag mittags, von Donnerstag bis Samstag abends eine Karte mit Poutine, Pizza, Burger und Bistro-Gerichte und Sonntagmittag die Froschschenkel"
    ],
    "en": [
      "The restaurant located in Menet welcomes you from Tuesday to Friday for lunch, from Thursday to Saturday evening with a menu of poutine, pizzas, burgers and bistro dishes and frog legs for Sunday lunch"
    ],
    "it": [
      "Il ristorante, situato a Menet, vi accoglie dal martedì al venerdì a pranzo, dal giovedì al sabato sera con un menu che comprende poutine, pizze, hamburger e piatti da bistrot, e cosce di rana per il pranzo della domenica"
    ],
    "fr": [
      "Le restaurant situé à Menet vous accueille du mardi au vendredi midi  ,du jeudi au samedi soir  une carte composée de poutine, pizzas, burgers et plats bistrot et dimanche midi les cuisses de grenouilles"
    ],
    "nl": [
      "Het restaurant in Menet verwelkomt je van dinsdag- tot vrijdagmiddag en van donderdag- tot zaterdagavond met een menu dat bestaat uit poutine, pizza's, hamburgers en bistrogerechten, en kikkerbilletjes voor de zondaglunch"
    ],
    "es": [
      "El restaurante, situado en Menet, le da la bienvenida de martes a viernes al mediodía, de jueves a sábado por la noche con un menú que incluye poutine, pizzas, hamburguesas y platos de bistró, y ancas de rana para el almuerzo del domingo"
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Patte d'Ours"
    ]
  },
