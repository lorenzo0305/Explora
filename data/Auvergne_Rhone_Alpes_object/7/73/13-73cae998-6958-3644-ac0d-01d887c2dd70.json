  "rdfs:comment": {
    "de": [
      "Das Broc Café bietet Ihnen neben süßen Speisen auch herzhafte Gerichte und Aperitifs, die alle hausgemacht sind."
    ],
    "en": [
      "A gourmet break in a soothing setting at the back of a family home, Broc Café offers savoury dishes and aperitifs as well as sweet treats, all homemade."
    ],
    "it": [
      "Una pausa gourmet in un ambiente rilassante nel retro di una casa di famiglia, il Broc Café offre piatti e aperitivi salati e dolci, tutti fatti in casa."
    ],
    "fr": [
      "Pause gourmande dans un cadre apaisant à l’arrière d’une maison de famille, le Broc Café vous propose plats salés et apéros en plus des mets sucrés, l’ensemble fait maison."
    ],
    "es": [
      "El Broc Café, en la parte trasera de una casa familiar, ofrece platos salados y aperitivos, así como dulces caseros."
    ],
    "nl": [
      "Broc Café, een gastronomische pauze in een rustgevende omgeving aan de achterkant van een familiehuis, biedt hartige gerechten en aperitieven, maar ook zoete lekkernijen, allemaal zelfgemaakt."
    ]
  },
