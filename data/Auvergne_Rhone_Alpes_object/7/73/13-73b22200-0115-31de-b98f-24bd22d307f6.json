  "rdfs:comment": {
    "de": [
      "Annabelle und Christian, die seit 30 Jahren als Maître Restaurateur tätig sind, heißen Sie im Herzen eines kleinen Winzerdorfes 10 Minuten von Issoire entfernt herzlich willkommen. Freundlicher Empfang, gepflegte Küche. Von Michelin verliehener Bib gourmand."
    ],
    "en": [
      "Annabelle and Christian have been Maître Restaurateurs for 30 years, and welcome you to the heart of a small winegrowing village 10 minutes from Issoire. A warm welcome and fine cuisine. Bib gourmand awarded by Michelin."
    ],
    "it": [
      "Annabelle e Christian sono Maître Restaurateur da 30 anni e vi accolgono nel cuore di un piccolo villaggio vinicolo a 10 minuti da Issoire. Un'accoglienza calorosa e una cucina raffinata. Premiato con il Bib gourmand Michelin."
    ],
    "fr": [
      "Installés depuis 30 ans et Maître Restaurateur, Annabelle et Christian vous souhaitent la bienvenue au cœur d'un petit village vigneron à 10 mn d'Issoire. Accueil sympathique, cuisine soignée. Bib gourmand décerné par Michelin."
    ],
    "es": [
      "Annabelle y Christian son Maître Restaurateurs desde hace 30 años y le dan la bienvenida al corazón de un pequeño pueblo vinícola a 10 minutos de Issoire. Una cálida bienvenida y buena cocina. Bib gourmand otorgado por Michelin."
    ],
    "nl": [
      "Annabelle en Christian zijn al 30 jaar Maître Restaurateurs en heten u welkom in het hart van een klein wijndorp op 10 minuten van Issoire. Een warm welkom en een verfijnde keuken. Bib gourmand bekroond door Michelin."
    ]
  },
  "rdfs:label": {
