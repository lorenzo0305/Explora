  "rdfs:comment": {
    "de": [
      "Genießen Sie in einem bergigen und eleganten Rahmen originelle Gerichte, aber auch rustikalere Vorschläge wie Kalbskopf mit Ravigote-Sauce oder savoyische Spezialitäten, die mit lokalem Käse zubereitet werden."
    ],
    "en": [
      "Come and enjoy original dishes in an elegant mountain setting, but also more rustic suggestions such as calf's head with ravigote sauce, or Savoyard specialities prepared with local cheese."
    ],
    "it": [
      "Venite a gustare piatti originali in un'elegante cornice di montagna, ma anche proposte più rustiche come la testina di vitello e la sua salsa ravigote, o le specialità savoiarde preparate con i formaggi locali."
    ],
    "fr": [
      "Venez dégustez dans un cadre montagnard et élégant des plats originaux mais aussi des suggestions plus rustiques comme la tête de veau et sa sauce ravigote, ou encore des spécialités savoyardes préparées avec du fromage local."
    ],
    "es": [
      "Venga a degustar platos originales en un elegante marco de montaña, así como sugerencias más rústicas como la cabeza de ternera y su salsa de ravigote, o especialidades saboyanas preparadas con queso local."
    ],
    "nl": [
      "Kom genieten van originele gerechten in een elegant kader in de bergen, maar ook van meer rustieke suggesties zoals kalfskop met ravigotesaus of Savoyaardse specialiteiten bereid met lokale kaas."
    ]
  },
