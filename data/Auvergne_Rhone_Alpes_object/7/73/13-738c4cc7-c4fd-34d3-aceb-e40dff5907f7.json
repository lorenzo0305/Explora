  "rdfs:comment": {
    "de": [
      "Der Halbmarathon in Bourg-lès-Valence bietet verschiedene Arten von Läufen, die für jedes Niveau und jede Lust geeignet sind, sodass jeder in seinem eigenen Tempo teilnehmen kann."
    ],
    "en": [
      "The Bourg-lès-Valence half-marathon offers several types of race, suitable for all levels and tastes, so that everyone can take part at their own pace."
    ],
    "it": [
      "La mezza maratona di Bourg-lès-Valence offre diversi tipi di gara, adatti a tutti i livelli e a tutti gli interessi, in modo che ognuno possa partecipare al proprio ritmo."
    ],
    "fr": [
      "Le semi-marathon de Bourg-lès-Valence propose plusieurs types de courses, adaptées à tous les niveaux et envies, pour permettre à chacun de participer à son rythme."
    ],
    "es": [
      "La media maratón de Bourg-lès-Valence ofrece varios tipos de carrera, adaptados a todos los niveles e intereses, para que cada uno pueda participar a su ritmo."
    ],
    "nl": [
      "De halve marathon van Bourg-lès-Valence biedt verschillende wedstrijdvormen, geschikt voor alle niveaus en interesses, zodat iedereen in zijn eigen tempo kan meedoen."
    ]
  },
