  "rdfs:comment": {
    "de": [
      "Die Mediathek Samuel Paty befindet sich im Stadtzentrum von Moulins. Sie vereint an einem einzigen Ort ein vielfältiges kulturelles Angebot.\r\nLesungen, Musik, Presse, aber auch Animationen und Ausstellungen machen diesen Ort zu einem von allen geschätzten Lebensraum."
    ],
    "en": [
      "The Samuel Paty multimedia library is located in the center of Moulins. It offers a wide range of cultural activities in a single location.\r\nReading, music, press, as well as events and exhibitions, make this a living space appreciated by all."
    ],
    "it": [
      "La biblioteca multimediale Samuel Paty si trova nel centro di Moulins. Offre un'ampia gamma di attività culturali in un unico luogo.\r\nLettura, musica, stampa, eventi e mostre ne fanno un luogo alla portata di tutti."
    ],
    "fr": [
      "La Médiathèque Samuel Paty est située en centre-ville de Moulins. Elle réunit en un lieu unique une offre culturelle diversifiée.\r\nLectures, musiques, presse, mais aussi animations et expositions font de ce lieu un espace de vie apprécié de tous."
    ],
    "es": [
      "La biblioteca multimedia Samuel Paty está situada en el centro de Moulins. Ofrece un amplio abanico de actividades culturales en un mismo lugar.\r\nLectura, música, prensa, eventos y exposiciones hacen de ella un lugar al alcance de todos."
    ],
    "nl": [
      "De mediatheek Samuel Paty ligt in het centrum van Moulins. Het biedt een breed scala aan culturele activiteiten op één locatie.\r\nLezen, muziek, pers, evenementen en tentoonstellingen maken dit een plek waar iedereen van kan genieten."
    ]
  },
