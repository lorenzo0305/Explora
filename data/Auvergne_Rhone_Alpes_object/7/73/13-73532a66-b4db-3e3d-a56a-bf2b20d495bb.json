  "rdfs:comment": {
    "de": [
      "Im Herzen von Val d'Isère und am Fuße der legendären Bellevarde-Piste liegt das Altitude, ein charmantes Hotel, in dem sich Komfort und Authentizität auf Geselligkeit reimen."
    ],
    "en": [
      "In the heart of Val d'Isère and at the foot of the legendary Bellevarde slope, Altitude Hotel is a charming hotel where comfort and authenticity rhyme with conviviality."
    ],
    "it": [
      "Nel cuore della Val d'Isère e ai piedi della leggendaria pista Bellevarde, l'Altitude è un hotel di charme dove comfort e autenticità fanno rima con convivialità."
    ],
    "fr": [
      "Au cœur de Val d'Isère et au pied de la piste mythique de Bellevarde, l'Altitude est un hôtel de charme où confort et authenticité riment avec convivialité."
    ],
    "nl": [
      "In het hart van Val d'Isère en aan de voet van de legendarische piste Bellevarde ligt l'Altitude, een charmant hotel waar comfort en authenticiteit hand in hand gaan met gezelligheid."
    ],
    "es": [
      "En el corazón de Val d'Isère y a los pies de la legendaria pista de Bellevarde, l'Altitude es un hotel con encanto donde el confort y la autenticidad se dan la mano con la convivencia."
    ]
  },
