  "rdfs:comment": {
    "de": [
      "Gemütliches Restaurant und Bar im Bergstil mit Kamin.\r\nIdeale Lage im Winter wie im Sommer.\r\nGenießen Sie französische und savoyardische Küche."
    ],
    "en": [
      "A cosy restaurant and bar in mountain style with a fireplace. \r\nIdeally located in both winter and summer. \r\nEnjoy French and Savoyard cuisine."
    ],
    "it": [
      "Ristorante e bar accogliente, in stile montano con camino. \r\nIn posizione ideale sia d'inverno che d'estate. \r\nGustate la cucina francese e savoiarda."
    ],
    "fr": [
      "Restaurant et Bar chaleureux, de style montagnard avec sa cheminée. \r\nIdéalement placé hiver comme été. \r\nDégustez une cuisine française et savoyarde."
    ],
    "nl": [
      "Gezellig restaurant en bar in bergstijl met open haard.\r\nIdeaal gelegen voor zowel winter als zomer.\r\nGeniet van de Franse en Savoyaardse keuken."
    ],
    "es": [
      "Acogedor restaurante y bar de montaña con chimenea.\r\nIdealmente situado tanto en invierno como en verano.\r\nDisfrute de la cocina francesa y saboyana."
    ]
  },
