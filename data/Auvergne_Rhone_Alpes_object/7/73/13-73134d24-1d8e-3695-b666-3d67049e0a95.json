  "rdfs:comment": {
    "de": [
      "Vermietung eines Tennisplatzes, der sich in der Nähe der Kinderspielplätze befindet, in Zeitfenstern von 1 oder 2 Stunden.\r\nReservierung beim Fremdenverkehrsamt von Corrençon en Vercors erforderlich."
    ],
    "en": [
      "Rental of a tennis court, located near the children's playground, for 1 or 2 hours.\r\nReservations required at the Corrençon en Vercors tourist office."
    ],
    "it": [
      "Noleggio di un campo da tennis, situato vicino all'area giochi per bambini, per 1 o 2 ore.\r\nPrenotazione obbligatoria presso l'Ufficio del Turismo di Corrençon en Vercors."
    ],
    "fr": [
      "Location d'un court de tennis, situé près des jeux pour enfants, par créneau d'1h ou 2h.\r\nRéservation obligatoire auprès de l'office de tourisme de Corrençon en Vercors."
    ],
    "nl": [
      "Verhuur van een tennisbaan, vlakbij de speeltuin, voor 1 of 2 uur.\r\nReserveren verplicht bij het toeristenbureau van Corrençon en Vercors."
    ],
    "es": [
      "Alquiler de una pista de tenis, situada cerca de la zona de juegos infantiles, durante 1 ó 2 horas.\r\nReserva obligatoria en la Oficina de Turismo de Corrençon en Vercors."
    ]
  },
  "rdfs:label": {
