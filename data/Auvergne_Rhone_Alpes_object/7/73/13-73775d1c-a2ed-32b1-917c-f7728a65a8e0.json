  "rdfs:comment": {
    "de": [
      "Traditionelles Restaurant im Stadtzentrum.\r\nWarmer, geselliger Ort, gewölbter Saal. Dekoration eines Bistros.\r\nIn der warmen Jahreszeit steht eine angenehme kleine Terrasse zur Verfügung."
    ],
    "en": [
      "Traditional downtown restaurant.\r\nWarm, friendly, vaulted room. Bistro decor.\r\nA pleasant little terrace is available in summer."
    ],
    "it": [
      "Ristorante tradizionale nel centro della città.\r\nLocale caldo e accogliente, sala a volta. Arredamento da bistrot.\r\nNella bella stagione è disponibile una piacevole terrazza."
    ],
    "fr": [
      "Restaurant traditionnel du centre ville. \r\nLieux chaleureux, convivial, salle voutée. Déco bistrot.\r\nUne agréable petite terrasse est disponible à la belle saison."
    ],
    "nl": [
      "Traditioneel restaurant in het stadscentrum.\r\nWarme, vriendelijke plek, gewelfde kamer. Bistro inrichting.\r\nBij mooi weer is er een aangenaam terrasje."
    ],
    "es": [
      "Restaurante tradicional en el centro de la ciudad.\r\nLugar cálido y acogedor, sala abovedada. Decoración de bistró.\r\nCon buen tiempo, dispone de una agradable terracita."
    ]
  },
