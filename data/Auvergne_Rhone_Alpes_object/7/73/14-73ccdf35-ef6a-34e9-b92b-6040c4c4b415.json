      "dc:description": {
        "de": [
          "R?Garage Motorcycles repariert, präpariert, restauriert und pflegt Ihre Motorräder, Roller und Quads in einer Werkstatt mit gemütlicher Atmosphäre."
        ],
        "en": [
          "R?Garage Motorcycles repairs, prepares, restores and maintains your motorcycles, scooters and quads in a warm and friendly workshop."
        ],
        "it": [
          "R?Garage Motorcycles ripara, prepara, restaura e mantiene le vostre moto, scooter e quad in un'officina accogliente."
        ],
        "fr": [
          "R’Garage Motorcycles répare, prépare, restaure et entretient vos motos, scooters et quads dans un atelier à l’ambiance chaleureuse."
        ],
        "nl": [
          "R?Garage Motorcycles repareert, prepareert, restaureert en onderhoudt uw motoren, scooters en quads in een vriendelijke werkplaats."
        ],
        "es": [
          "R?Garage Motorcycles repara, prepara, restaura y mantiene sus motos, scooters y quads en un taller acogedor."
        ]
