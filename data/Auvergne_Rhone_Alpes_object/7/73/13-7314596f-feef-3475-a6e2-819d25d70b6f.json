  "rdfs:comment": {
    "de": [
      "Ich bin Yoann Bonnardel, Landwirt in der Gemeinde PEYRUS im Departement Drôme.\r\nAls Sohn eines Viehzüchters habe ich mich seit 2018 mit aromatischen Pflanzen und Ackerbau niedergelassen. Seit 2024 habe ich den Hof mit der Produktion von Foie gras-Enten diversifiziert."
    ],
    "en": [
      "I'm Yoann Bonnardel, a farmer in the commune of PEYRUS in the Drôme.\r\nThe son of a breeder, I have been growing herbs and field crops since 2018. I have diversified the farm with duck farming since 2024."
    ],
    "it": [
      "Sono Yoann Bonnardel, un agricoltore del comune di PEYRUS, nella Drôme.\r\nFiglio di un allevatore, dal 2018 coltivo piante aromatiche e seminativi. Dal 2024 diversifico l'azienda agricola con anatre da ingrasso."
    ],
    "fr": [
      "Je suis Yoann Bonnardel, agriculteur sur la commune de PEYRUS dans la Drôme.\r\nFils d’éleveur, je suis installé en plantes aromatiques et grandes cultures depuis 2018. J’ai diversifié la ferme avec l’activité de canard gras depuis 2024."
    ],
    "es": [
      "Soy Yoann Bonnardel, agricultor en la comuna de PEYRUS, en la Drôme.\r\nHijo de ganadero, cultivo plantas aromáticas y cultivos herbáceos desde 2018. Diversifico la explotación con patos de engorde desde 2024."
    ],
    "nl": [
      "Ik ben Yoann Bonnardel, landbouwer in de gemeente PEYRUS in de Drôme.\r\nAls zoon van een veehouder kweek ik sinds 2018 aromatische planten en akkerbouwgewassen. Sinds 2024 diversifieer ik mijn bedrijf met vetgemeste eenden."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Foie gras du Vercors"
    ]
  },
