  "rdfs:comment": {
    "de": [
      "Einzigartig in den 3 Vallées. Das Restaurant Clos Bernard befindet sich im Wald des Altiports von Méribel. Entdecken Sie diesen magischen, sonnenverwöhnten Ort, um die Mini-Farm mit ihren Tieren zu besuchen und mit ihnen einen Snack zu machen."
    ],
    "en": [
      "Unique in the 3 Valleys. The Clos Bernard restaurant is located in the forest of the Méribel altiport. Come and discover this magical, sun-drenched setting, where you can visit the mini animal farm and have a snack with the animals."
    ],
    "it": [
      "Unico nelle 3 Valli. Il ristorante Clos Bernard si trova nella foresta dell'altiport di Méribel. Venite a scoprire questo ambiente magico e soleggiato, dove potrete visitare la mini fattoria degli animali e fare uno spuntino con gli animali."
    ],
    "fr": [
      "Unique dans les 3 Vallées. Le restaurant Clos Bernard est situé dans la forêt de l’altiport de Méribel. Venez découvrir ce lieu magique gorgé de soleil pour y découvrir la mini ferme des animaux, et faire le goûter avec eux."
    ],
    "es": [
      "Único en los 3 Valles. El restaurante Clos Bernard está situado en el bosque del altiport de Méribel. Venga a descubrir este entorno mágico y soleado, donde podrá visitar la minigranja de animales y merendar con ellos."
    ],
    "nl": [
      "Uniek in de 3 valleien. Het restaurant Clos Bernard ligt in het bos van het Méribel altiport. Kom deze magische, zonovergoten omgeving ontdekken, waar u de mini-dierenboerderij kunt bezoeken en een hapje kunt eten met de dieren."
    ]
  },
