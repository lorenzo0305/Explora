  "rdfs:comment": {
    "de": [
      "Seit Januar 2023 stellen wir Mehl aus Bio-Weizen her. Der Weizen wird auf unserer Farm ausgewählt, sortiert, gelagert und mit einer Steinmühle gequetscht."
    ],
    "en": [
      "Since January 2023, we have been producing organic wheat flour. The wheat is selected, sorted, stored and crushed with a stone mill on our farm."
    ],
    "it": [
      "Dal gennaio 2023 produciamo farina di grano biologico. Il grano viene selezionato, selezionato, immagazzinato e macinato con un mulino a pietra nella nostra azienda agricola."
    ],
    "fr": [
      "Depuis janvier 2023, nous produisons de la farine de blé bio. Le blé est sélectionné, trié, stocké et écrasé avec un moulin à meule de pierre sur notre exploitation."
    ],
    "nl": [
      "Sinds januari 2023 produceren we biologische tarwebloem. De tarwe wordt geselecteerd, gesorteerd, opgeslagen en gemalen in een stenen molen op onze boerderij."
    ],
    "es": [
      "Desde enero de 2023, producimos harina de trigo ecológico. El trigo se selecciona, clasifica, almacena y tritura utilizando un molino de piedra en nuestra granja."
    ]
  },
  "rdfs:label": {
