  "rdfs:comment": {
    "de": [
      "Das kleine Traditionshotel befindet sich in Saint-Privat-d'Allier in den Schluchten des Allier.  Es liegt 20 km von Le Puy-en-Velay oder Saugues entfernt und ist eine Etappe auf dem Jakobsweg (GR 65) an der Kreuzung zwischen der Bestie von Gévaudan und dem Velay."
    ],
    "en": [
      "This small, traditional hotel is located in Saint-Privat-d'Allier in the Allier gorges.  Just 20 km from Le Puy-en-Velay or Saugues, this site is a stopover on the Route de St Jacques de Compostelle (GR 65), at the crossroads between the Bête du Gévaudan and the Velay."
    ],
    "it": [
      "Questo piccolo hotel tradizionale si trova a Saint-Privat-d'Allier, nelle gole dell'Allier.  A soli 20 km da Le Puy-en-Velay o da Saugues, questo sito è una tappa della Route de St Jacques de Compostelle (GR 65) all'incrocio tra la Bête du Gévaudan e il Velay."
    ],
    "fr": [
      "Le petit hôtel de tradition est situé à Saint-Privat-d'Allier dans les gorges de l'Allier.  A 20 km du  Puy-en-Velay ou de Saugues, ce site est une étape du chemin de St Jacques de Compostelle  (GR 65) au carrefour entre la Bête du Gévaudan et le Velay."
    ],
    "es": [
      "Este pequeño hotel tradicional está situado en Saint-Privat-d'Allier, en las gargantas del Allier.  A sólo 20 km de Le Puy-en-Velay o de Saugues, este lugar es una etapa de la Route de St Jacques de Compostelle (GR 65) en el cruce entre la Bête du Gévaudan y el Velay."
    ],
    "nl": [
      "Dit traditionele hotelletje ligt in Saint-Privat-d'Allier in de Gorges de l'Allier.  Op slechts 20 km van Le Puy-en-Velay of Saugues is dit een etappe op de Route de St Jacques de Compostelle (GR 65) op het kruispunt tussen de Bête du Gévaudan en de Velay."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Bar Restaurant Hôtel la Vieille Auberge"
    ]
  },
