  "rdfs:comment": {
    "de": [
      "Während Ihres Besuches werden Sie herausfinden, in welcher Weise die Schuhmacherei die Geschichte von Alby-sur-Chéran über mehrere Jahrhunderte hinweg geprägt hat."
    ],
    "en": [
      "Over the course of your visit, you will discover the ways in which shoemaking has marked the history of Alby-sur-Chéran over many centuries."
    ],
    "it": [
      "Visita gratuita. Esposizione di vecchi strumenti e macchine utilizzati dai calzolai. Alby-sur-Chéran è l'antica capitale della calzoleria."
    ],
    "fr": [
      "En plein cœur du vieux bourg, le musée vous dévoile les différentes facettes d’un passé artisanal qui a marqué l’histoire du village."
    ],
    "nl": [
      "Tijdens de rondleiding zult u ontdekken hoe de schoenmakerij de geschiedenis van Alby-sur-Chéran gedurende meerdere eeuwen heeft bepaald."
    ],
    "es": [
      "En el corazón del casco antiguo, el museo revela las diferentes facetas de un pasado artesanal que ha marcado la historia del pueblo."
    ]
  },
