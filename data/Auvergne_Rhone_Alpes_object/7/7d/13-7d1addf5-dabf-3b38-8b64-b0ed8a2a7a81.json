  "rdfs:comment": {
    "de": [
      "Das Edelweiss wurde 1947 erbaut und heute freuen wir uns, Sie in unserem familiären 2*-Hotel zu empfangen, das aus 9 Zimmern mit Dusche, WC, TV, Telefon und Haartrockner besteht. Wir bieten Ihnen eine traditionelle, savoyische Familiengastronomie."
    ],
    "en": [
      "L'Edelweiss was built in 1947 and today we are delighted to welcome you to our family-run 2* hotel with 9 bedrooms each with shower, WC, TV, telephone and hairdryer. We offer traditional Savoyard family cuisine."
    ],
    "it": [
      "L'Edelweiss è stato costruito nel 1947 e oggi siamo lieti di darvi il benvenuto nel nostro hotel 2* a conduzione familiare, dotato di 9 camere con doccia, WC, TV, telefono e asciugacapelli. Offriamo un ristorante tradizionale savoiardo a conduzione familiare."
    ],
    "fr": [
      "L'Edelweiss a été construit en 1947 et aujourd'hui nous sommes heureux de vous recevoir dans notre hôtel familial 2* composé de 9 ch avec douche, WC, TV  téléphone et sèche-cheveux. Nous proposons une restauration familiale traditionnelle et savoyarde."
    ],
    "nl": [
      "L'Edelweiss werd gebouwd in 1947 en vandaag verwelkomen we u met veel plezier in ons door een familie gerunde 2*-hotel met 9 kamers, elk met douche, wc, tv, telefoon en haardroger. Wij bieden een traditionele Savoyaardse familiekeuken."
    ],
    "es": [
      "L'Edelweiss fue construido en 1947 y hoy estamos encantados de darle la bienvenida a nuestro hotel familiar de 2* con 9 habitaciones, cada una con ducha, WC, TV, teléfono y secador de pelo. Le ofrecemos un restaurante familiar tradicional de Saboya."
    ]
  },
