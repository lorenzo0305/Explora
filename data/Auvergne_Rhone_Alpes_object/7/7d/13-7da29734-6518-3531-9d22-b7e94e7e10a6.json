  "rdfs:comment": {
    "de": [
      "Entdecken Sie unser Team, das auf ayurvedische Behandlungen & Kräuterkunde, koreanische Entspannung, Poyet-Methode, Klangentspannung, posturale & biodynamische Balance, Massage & Fußreflexzonenmassage, Psychopraktikerin in Maïeusthésie und taoistische Massagen spezialisiert ist"
    ],
    "en": [
      "Discover our team in Ayurvedic treatments & Herbalism, Korean Relaxation, Poyet Method, Sound Relaxation, Postural & Bio-Dynamic Balance, Massage & Foot Reflexology, Maieusthesia Psychotherapy, and Taoist Massages."
    ],
    "it": [
      "Scoprite il nostro team specializzato in trattamenti ayurvedici e alle erbe, rilassamento coreano, metodo Poyet, rilassamento sonoro, equilibrio posturale e biodinamica, massaggio e riflessologia plantare, psicoterapia maestetica e massaggi taoisti"
    ],
    "fr": [
      "Découvrez notre équipe spécialisée en  soins ayurvédiques & Herboriste, Relaxation Coréenne, Méthode Poyet, Relaxations Sonores, Equilibre postural &  Bio-Dynamique, massage & réflexologie plantaire,  psychopraticienne en Maïeusthésie et Massages Taoïstes"
    ],
    "nl": [
      "Ontdek ons team dat gespecialiseerd is in Ayurvedische & Kruidenbehandelingen, Koreaanse Ontspanning, de Poyet Methode, Geluidsontspanning, Postural Balance & Bio-Dynamics, Massage & Voetreflexologie, Maeusthestic Psychotherapie en Taoïstische Massages"
    ],
    "es": [
      "Descubra nuestro equipo especializado en tratamientos ayurvédicos y herbales, relajación coreana, el método Poyet, relajación sonora, equilibrio postural y biodinámica, masaje y reflexología podal, psicoterapia maeostática y masajes taoístas"
    ]
  },
  "rdfs:label": {
    "en": [
