  "rdfs:comment": {
    "de": [
      "Genießen Sie im Herzen des Dorfes diesen Wassersportbereich mit: Schwimmbecken, Spielbecken mit Fontäne und Sprudelsitzbank, Rutsche, Snackbar mit Terrasse, Planschbecken und vielen Grünflächen."
    ],
    "en": [
      "In the heart of the village, enjoy this nautical space with: swimming pool, play pool with fountain and bubble bench, paddling pool, slide, snack bar with terrace, paddling pool and many green spaces."
    ],
    "it": [
      "Nel cuore del villaggio, godetevi questo parco acquatico con piscina, vasca di divertimento con fontana e panchina per le bolle, scivolo, snack bar con terrazza, piscina per bambini e tanto spazio verde."
    ],
    "fr": [
      "Au cœur du village, profitez de cet espace nautique avec : bassin de natation, bassin ludique avec fontaine et banquette à bulles, toboggan, snack-bar avec terrasse, pataugeoire et nombreux espaces verts."
    ],
    "nl": [
      "Geniet in het hart van het dorp van dit waterpark met zwembad, fun pool met fontein en bubbelbank, glijbaan, snackbar met terras, peuterbad en veel groen."
    ],
    "es": [
      "En el corazón del pueblo, disfrute de esta zona de deportes acuáticos con: piscina, piscina de juegos con fuente y banco de burbujas, piscina infantil, tobogán, snack bar con terraza, numerosas zonas verdes.\r\nPiscina infantil cerrada."
    ]
  },
