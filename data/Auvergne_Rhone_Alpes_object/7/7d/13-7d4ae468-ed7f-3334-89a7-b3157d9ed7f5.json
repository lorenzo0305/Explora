  "rdfs:comment": {
    "de": [
      "Das Restaurant Mertensia Lyon lädt Sie ein, eine pflanzliche, maritime und nachhaltige Küche zu entdecken. Hier soll die Gastronomie gerechter, lebendiger und engagierter sein. Und das alles in einer familiären und unverkrampften Atmosphäre!"
    ],
    "en": [
      "The Mertensia Lyon restaurant invites you to discover humane, authentic, and sustainable cuisine. Here, gastronomy is more fair, vibrant, and committed. All this in a relaxed, family atmosphere!"
    ],
    "it": [
      "Il ristorante Mertensia Lyon vi invita a scoprire una cucina vegetale, marina e sostenibile. Qui la gastronomia è più giusta, più vivace e più impegnata. Il tutto in un'atmosfera rilassata e familiare!"
    ],
    "fr": [
      "Le restaurant Mertensia Lyon vous invite à découvrir une cuisine végétale, marine et durable. Ici, la gastronomie se veut plus juste, vivante et engagée. Le tout dans une ambiance familiale et décomplexée !"
    ],
    "nl": [
      "Het restaurant Mertensia Lyon nodigt u uit om de plantaardige, mariene en duurzame keuken te ontdekken. Hier is de gastronomie eerlijker, levendiger en meer geëngageerd. En dat alles in een ontspannen, familiale sfeer!"
    ],
    "es": [
      "El restaurante Mertensia Lyon le invita a descubrir la cocina vegetal, marina y sostenible. Aquí, la gastronomía es más justa, más viva y más comprometida. ¡Todo en un ambiente relajado y familiar!"
    ]
  },
