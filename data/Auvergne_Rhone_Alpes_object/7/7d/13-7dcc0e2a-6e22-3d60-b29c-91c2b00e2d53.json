  "rdfs:comment": {
    "de": [
      "Ein Moment, um seine Favoriten auszutauschen und literarische Neuheiten zu entdecken. Der Teenager-Leseclub ist offen für alle Lesebegeisterten, also zögere nicht, dich hineinzuwagen!"
    ],
    "en": [
      "It's a time to share favorites and discover new literary releases. The teen book club is open to all reading enthusiasts, so don't hesitate to join in!"
    ],
    "it": [
      "Un'opportunità per condividere i propri libri preferiti e scoprirne di nuovi. Il club del libro per ragazzi è aperto a tutti gli amanti dei libri, quindi non esitate a partecipare!"
    ],
    "fr": [
      "Un moment pour partager ses coups de cœur et découvrir des nouveautés littéraires. Le club de lecture adolescent est ouvert à tous les férus de lecture, n'hésitez pas à vous y aventurer !"
    ],
    "es": [
      "Una oportunidad para compartir tus libros favoritos y descubrir otros nuevos. El club de lectura para adolescentes está abierto a todos los amantes de la lectura, así que no dudes en participar"
    ],
    "nl": [
      "Een kans om je favoriete boeken te delen en nieuwe te ontdekken. De tienerclub staat open voor alle boekenliefhebbers, dus aarzel niet om mee te doen!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Médiathèque : Club de lecture ado"
    ]
  },
