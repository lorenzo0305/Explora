  "rdfs:comment": {
    "de": [
      "Besichtigung mit Audioguide oder Führung (Juli-August) des vollständig unter Denkmalschutz stehenden Domaine d'Avrilly: das von Teichen umgebene Schloss aus dem 15., 17. und 19. Jahrhundert, die Kapelle, die Nebengebäude, die Stallungen und der 107 Hektar große Landschaftspark."
    ],
    "en": [
      "Audio tour or guided tour (July-August) of the Avrilly estate, entirely listed as a Historic Monument: the 15th, 17th and 19th century château surrounded by ponds, the chapel, outbuildings, stables and 107 hectares of landscaped parkland."
    ],
    "it": [
      "Audio tour o visita guidata (luglio-agosto) della tenuta di Avrilly, tutta classificata come Monumento Storico: il castello del XV, XVII e XIX secolo circondato da laghetti, la cappella, gli annessi, le scuderie e 107 ettari di parco paesaggistico."
    ],
    "fr": [
      "Visite audioguidée ou guidée (juillet-août) du domaine d'Avrilly entièrement classé Monument Historique : le château des XVe, XVIIe et XIXe siècles entouré de bassins, la chapelle, les dépendances, les écuries et le parc paysager de 107 hectares."
    ],
    "nl": [
      "Audiotour of rondleiding (juli-augustus) op het landgoed van Avrilly, dat in zijn geheel op de monumentenlijst staat: het 15e-, 17e- en 19e-eeuwse kasteel omringd door vijvers, de kapel, bijgebouwen, stallen en 107 hectare aangelegd park."
    ],
    "es": [
      "Audioguía o visita guiada (julio-agosto) de la finca de Avrilly, declarada Monumento Histórico en su totalidad: el castillo de los siglos XV, XVII y XIX rodeado de estanques, la capilla, las dependencias, las caballerizas y 107 hectáreas de parque ajardinado."
    ]
  },
  "rdfs:label": {
