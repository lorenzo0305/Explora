  "rdfs:comment": {
    "de": [
      "Nunc ist eine Kunst- und Streetart-Galerie, die sich im Viertel Championnet eingenistet hat. Es ist ein offener Raum für Kunst mit einer Mischung aus verschiedenen Künstlern. Hier findet man nicht nur die Werke der Künstler, sondern auch die Bücher von Critères Editions, dem Mutterhaus."
    ],
    "en": [
      "Nunc is an art and street art gallery nestled in the Championnet district. It's a space open to art with a mix of artists. You'll find the artists' works here, as well as books from Critères Editions, the parent company."
    ],
    "it": [
      "Nunc è una galleria d'arte e street art situata nel quartiere di Championnet. È uno spazio aperto all'arte con un mix di artisti. Qui si possono trovare le opere degli artisti e i libri di Critères Editions, la casa madre."
    ],
    "fr": [
      "Nunc est une galerie d'art et street art nichée dans le quartier Championnet. C’est un espace ouvert à l'art avec une mixité d’artistes. On y retrouve les œuvres des artistes mais aussi les livres de Critères Editions, la maison mère."
    ],
    "nl": [
      "Nunc is een kunst- en straatgalerie in de wijk Championnet. Het is een ruimte die openstaat voor kunst met een mix van kunstenaars. Je kunt hier de werken van de kunstenaars vinden, maar ook boeken van Critères Editions, het moederbedrijf."
    ],
    "es": [
      "Nunc es una galería de arte y arte callejero situada en el barrio de Championnet. Es un espacio abierto al arte con una mezcla de artistas. Aquí encontrarás las obras de los artistas, así como libros de Critères Editions, la empresa matriz."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Galerie Nunc!"
    ]
  },
