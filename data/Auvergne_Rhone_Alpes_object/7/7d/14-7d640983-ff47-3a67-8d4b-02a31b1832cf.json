  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/6ed97c59-c513-3af3-bc40-f1bb6642ad51",
      "dc:description": {
        "de": [
          "Das Office Culturel Intercommunal du Haut-Pays bietet Ihnen im Salle Francis Sagot in Fruges einen Theaterabend \"Le Canard à l'Orange\", gespielt von Les Thibautins."
        ],
        "en": [
          "The Office Culturel Intercommunal du Haut-Pays presents an evening of theater at the Salle Francis Sagot in Fruges, entitled \"Le Canard à l'Orange\", performed by Les Thibautins."
        ],
        "it": [
          "L'Office Culturel Intercommunal du Haut-Pays vi invita a una serata di teatro presso la Salle Francis Sagot di Fruges, intitolata \"Le Canard à l'Orange\", interpretata da Les Thibautins."
        ],
        "fr": [
          "L'Office Culturel Intercommunal du Haut-Pays vous propose Salle Francis Sagot à Fruges une soirée théâtre \"Le Canard à l'Orange\" jouée par Les Thibautins."
        ],
        "es": [
          "La Office Culturel Intercommunal du Haut-Pays le invita a una velada teatral en la Sala Francis Sagot de Fruges, titulada \"Le Canard à l'Orange\", interpretada por Les Thibautins."
        ],
        "nl": [
          "Het Office Culturel Intercommunal du Haut-Pays nodigt je uit voor een theateravond in de Salle Francis Sagot in Fruges, getiteld \"Le Canard à l'Orange\", opgevoerd door Les Thibautins."
        ]
      },
