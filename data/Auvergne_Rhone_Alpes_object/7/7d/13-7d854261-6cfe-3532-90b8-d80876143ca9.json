  "rdfs:comment": {
    "de": [
      "Vom originalen, neuen oder gebrauchten Schmuckstück bis zum Ankauf Ihrer Edelmetalle, von der Reparatur bis zur Wartung, von Uhrenbatterien über Uhren bis zum Aufziehen von Perlen - das Atelier Wilson begleitet Sie durch den Alltag."
    ],
    "en": [
      "From original, new or second-hand jewellery to the purchase of your precious metals, from repairs to maintenance, from watch batteries to bead threading and watchmaking, the Atelier Wilson is with you every day."
    ],
    "it": [
      "Dai gioielli originali, nuovi o di seconda mano, all'acquisto dei vostri metalli preziosi, dalle riparazioni alla manutenzione, dalle batterie degli orologi alla reinfilatura delle perle, l'Atelier Wilson vi accompagna ogni giorno."
    ],
    "fr": [
      "Du bijou original, neuf ou d’occasion au rachat de vos métaux précieux, de la réparation à l’entretien, des piles de montres au renfilage de perles en passant par l’horlogerie, l’Atelier Wilson vous accompagne au quotidien."
    ],
    "nl": [
      "Van originele, nieuwe of tweedehands juwelen tot de aankoop van uw edele metalen, van reparaties tot onderhoud, van horlogebatterijen tot het opnieuw strengen van parels, het Atelier Wilson begeleidt u elke dag."
    ],
    "es": [
      "Desde las joyas originales, nuevas o de segunda mano, hasta la compra de sus metales preciosos, desde las reparaciones hasta el mantenimiento, desde las pilas de los relojes hasta el remontaje de las perlas, el Atelier Wilson le acompaña cada día."
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'Atelier Wilson"
    ]
  },
