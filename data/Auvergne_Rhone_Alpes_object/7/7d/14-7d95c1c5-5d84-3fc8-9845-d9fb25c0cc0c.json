      "dc:description": {
        "de": [
          "Pizzas, Flammkuchen, Tartines, Calzone zum Liefern oder Mitnehmen an 7 Tagen in der Woche, von 11:00 bis 14:30 Uhr und von 18:00 bis 22:30 Uhr, je nach Andrang."
        ],
        "en": [
          "Pizzas, flammeküches, tartines, calzones for delivery or takeaway 7 days a week, from 11am to 2.30pm and from 6pm to 10.30pm depending on traffic."
        ],
        "it": [
          "Pizze, flammeküches, tartine, calzoni per consegna o asporto 7 giorni su 7, dalle 11.00 alle 14.30 e dalle 18.00 alle 22.30 a seconda dell'affluenza."
        ],
        "fr": [
          "Pizzas, flammeküches, tartines, calzones à faire livrer ou à emporter 7 jours sur 7, de 11h à 14h30 et de 18h à 22h30 selon l'affluence."
        ],
        "es": [
          "Pizzas, flammeküches, tartines, calzones a domicilio o para llevar 7 días a la semana, de 11.00 a 14.30 y de 18.00 a 22.30 según la afluencia."
        ],
        "nl": [
          "Pizza's, flammeküches, tartines, calzones om te bezorgen of af te halen 7 dagen per week, van 11.00 tot 14.30 en van 18.00 tot 22.30, afhankelijk van hoe druk het is."
        ]
