  "rdfs:comment": {
    "de": [
      "Lufttaufen im Ultraleichtflugzeug, Tandemflüge: Unser Pilot zeigt Ihnen die herrlichen Kurven der Alpen und bietet Ihnen eine außergewöhnliche Reise über Val Cenis. Zugänglich für Menschen mit Behinderungen."
    ],
    "en": [
      "First flights in the microlight: Our pilot will make you discover the magnificent curves of the Alps, and will propose you an extraordinary trip over Val Cenis. Accessible to people with disabilities."
    ],
    "it": [
      "Primi voli in ultraleggero, voli biposto: il nostro pilota vi mostrerà le magnifiche curve delle Alpi e vi offrirà un viaggio straordinario sopra la Val Cenis. Accessibile alle persone con disabilità."
    ],
    "fr": [
      "Baptêmes de l'air en ULM, vols biplaces : notre pilote vous fera découvrir les courbes magnifiques des Alpes, et vous proposera un voyage extraordinaire au-dessus de Val Cenis. Accessible aux personnes en situation de handicap."
    ],
    "es": [
      "Primeros vuelos en ultraligero, vuelos biplaza: nuestro piloto le mostrará las magníficas curvas de los Alpes y le ofrecerá un extraordinario viaje por encima de Val Cenis. Accesible para personas con discapacidad."
    ],
    "nl": [
      "Eerste vlucht in ultralichte, tandemvluchten: onze piloot zal je de prachtige bochten van de Alpen laten zien en zal je een buitengewone reis aanbieden boven Val Cenis. Toegankelijk voor mensen met een handicap."
    ]
  },
