  "rdfs:comment": {
    "de": [
      "Die Teams von Vienne Condrieu Tourisme, Experten für Beratung und Service, heißen Sie herzlich im Pavillon du Tourisme willkommen, der ideal am Ufer der Rhône gelegen ist!"
    ],
    "en": [
      "The Vienne Condrieu Tourisme teams, experts in advice and services, warmly welcome you to the Pavillon du tourisme, ideally located on the banks of the Rhône!"
    ],
    "it": [
      "Il team di Vienne Condrieu Tourisme, esperto in consulenza e servizi, vi dà un caloroso benvenuto al Padiglione del Turismo, situato in posizione ideale sulle rive del Rodano!"
    ],
    "fr": [
      "Les équipes de Vienne Condrieu Tourisme, experts en conseils et services, vous accueillent chaleureusement au Pavillon du tourisme, idéalement situé sur les berges du Rhône !"
    ],
    "es": [
      "Los equipos de Vienne Condrieu Tourisme, expertos en asesoramiento y servicios, le dan una calurosa bienvenida al Pabellón de Turismo, idealmente situado a orillas del Ródano"
    ],
    "nl": [
      "De teams van Vienne Condrieu Tourisme, experts in advies en diensten, heten u van harte welkom in het Paviljoen voor Toerisme, ideaal gelegen aan de oevers van de Rhône!"
    ]
  },
