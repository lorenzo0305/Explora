  "rdfs:comment": {
    "de": [
      "Der Lac des Gouillons ist ein schöner Bergsee, um einen Tag beim Angeln von Regenbogenforellen zu verbringen oder einfach nur um in der Nähe des Col du Petit-Saint-Bernard zu wandern und zu picknicken."
    ],
    "en": [
      "Fishing lakes Gouillons."
    ],
    "it": [
      "Il Lac des Gouillons è un lago di montagna molto piacevole per trascorrere una giornata di pesca alla trota iridea, o semplicemente per passeggiare e fare un picnic vicino al Col du Petit-Saint-Bernard."
    ],
    "fr": [
      "Le lac des Gouillons est un lac de montagne très agréable pour passer une journée à pêcher la truite arc-en-ciel, ou bien simplement pour se balader et pique-niquer près du Col du Petit-Saint-Bernard."
    ],
    "nl": [
      "Het Lac des Gouillons is een zeer aangenaam bergmeer om een dag te vissen op regenboogforel, of gewoon om te wandelen en te picknicken bij de Col du Petit-Saint-Bernard."
    ],
    "es": [
      "El Lac des Gouillons es un lago de montaña muy agradable para pasar un día pescando truchas arco iris, o simplemente para pasear y hacer un picnic cerca del Col du Petit-Saint-Bernard."
    ]
  },
