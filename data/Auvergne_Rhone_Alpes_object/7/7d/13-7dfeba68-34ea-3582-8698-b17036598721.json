  "rdfs:comment": {
    "de": [
      "Essbare und medizinische Gärten.\r\nFinden Sie alle Produktionen: Gewürz- und Heilpflanzen, frische und getrocknete Pflanzen, Kräutertees, Aromaten.\r\nDirektverkauf auf dem Bauernhof."
    ],
    "en": [
      "Edible and medicinal gardens.\r\nFind all the products: aromatic and medicinal plants, fresh and dried plants, infusions, herbs.\r\nDirect farm sales."
    ],
    "it": [
      "Giardini commestibili e medicinali.\r\nScoprite tutti i prodotti: piante aromatiche e medicinali, piante fresche ed essiccate, infusi, erbe aromatiche.\r\nVendita diretta dalla fattoria."
    ],
    "fr": [
      "Jardins comestibles et médicinaux. \r\nRetrouvez toutes les productions : plantes aromatiques et médicinales, plantes fraîches et séchées, infusions, aromates. \r\nVente directe à la ferme."
    ],
    "es": [
      "Jardines comestibles y medicinales.\r\nDescubra todos los productos: plantas aromáticas y medicinales, plantas frescas y secas, infusiones, hierbas aromáticas.\r\nVenta directa desde la granja."
    ],
    "nl": [
      "Eetbare en geneeskrachtige tuinen.\r\nOntdek alle producten: aromatische en geneeskrachtige planten, verse en gedroogde planten, infusies, kruiden.\r\nDirecte verkoop vanaf de boerderij."
    ]
  },
  "rdfs:label": {
