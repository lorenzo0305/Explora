  "rdfs:comment": {
    "de": [
      "Die Gondelbahn von Alpette befindet sich im oberen Teil des Ortes und ermöglicht den Zugang zum hochgelegenen Skigebiet Espace Alpe d'Huez ."
    ],
    "en": [
      "The Alpette lift, located in the upper part of the resort, provides access to the high-altitude area of ​​Espace Alpe d'Huez."
    ],
    "it": [
      "La funivia dell'Alpette, situata nella parte alta del resort, consente di accedere al comprensorio sciistico di alta quota Espace Alpe d'Huez."
    ],
    "fr": [
      "La télécabine de l’Alpette, située dans la partie haute de la station, permet d’accéder au domaine d'altitude de l'Espace Alpe d'Huez ."
    ],
    "es": [
      "El teleférico Alpette, situado en la parte alta de la estación, da acceso al dominio esquiable de gran altitud Espace Alpe d'Huez."
    ],
