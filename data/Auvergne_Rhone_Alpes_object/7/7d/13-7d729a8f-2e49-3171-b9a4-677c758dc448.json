  "rdfs:comment": {
    "de": [
      "Der Chappe-Telegraf war ein Kommunikationsmittel, das 1793 von Claude Chappe entwickelt wurde. Er ermöglichte die Übertragung von Signalen mit einem mehrere Meter hohen hölzernen Gelenkarm."
    ],
    "en": [
      "The Chappe telegraph was a means of communication developed by Claude Chappe in 1793. It allowed the transmission of signals with a wooden articulated arm several meters high."
    ],
    "it": [
      "Il telegrafo di Chappe era un mezzo di comunicazione sviluppato da Claude Chappe nel 1793. Permetteva di trasmettere segnali utilizzando un braccio di legno alto diversi metri."
    ],
    "fr": [
      "Le télégraphe Chappe était un moyen de communication mis au point par Claude Chappe en 1793. Il permettait de transmettre des signaux avec un bras articulé en bois de plusieurs mètres de hauteur."
    ],
    "es": [
      "El telégrafo Chappe fue un medio de comunicación desarrollado por Claude Chappe en 1793. Permitía transmitir señales con un brazo de madera de varios metros de altura."
    ],
    "nl": [
      "De Chappe-telegraaf was een communicatiemiddel ontwikkeld door Claude Chappe in 1793. Hiermee konden signalen worden overgebracht met behulp van een houten arm van enkele meters hoog."
    ]
  },
