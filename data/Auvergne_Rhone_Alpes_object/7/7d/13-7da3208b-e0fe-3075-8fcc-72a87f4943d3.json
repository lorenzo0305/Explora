  "rdfs:comment": {
    "de": [
      "Gehen Sie \"Vom Schatten zum Licht\", vom Gefängnis bis zur Befreiung des Bourbonnais im Frühherbst 1944.\r\nNur geführte Besichtigung"
    ],
    "en": [
      "Go \"From Shadow to Light\", from prison to the liberation of the Bourbonnais region in early autumn 1944.\r\nGuided tour only"
    ],
    "it": [
      "Andate \"Dall'ombra alla luce\", dalla prigione alla liberazione della regione di Bourbonnais all'inizio dell'autunno 1944.\r\nSolo visita guidata"
    ],
    "fr": [
      "Passez \"De l’Ombre à la Lumière\", de la prison à la libération du Bourbonnais en ce début d’automne 1944.\r\nVisité guidée uniquement"
    ],
    "es": [
      "Ir \"De la sombra a la luz\", de la prisión a la liberación de la región de Bourbonnais a principios del otoño de 1944.\r\nSólo visita guiada"
    ],
    "nl": [
      "Ga \"Van schaduw naar licht\", van de gevangenis tot de bevrijding van de Bourbonnais in de vroege herfst van 1944.\r\nAlleen rondleiding"
    ]
  },
  "rdfs:label": {
