  "rdfs:comment": {
    "de": [
      "Mystisch, verträumt, teuflisch, betörend: So viele qualitative Bezeichnungen für die Musik von Skrjabin, die für den Pianisten John Gade eine wahre Droge war."
    ],
    "en": [
      "Mystical, dreamy, diabolical, bewitching, bewitching: these are just some of the qualities that describe Scriabin's music, a veritable drug for pianist John Gade."
    ],
    "it": [
      "Mistica, sognante, diabolica, ammaliante, ammaliatrice: sono solo alcune delle qualità che descrivono la musica di Scriabin, una vera e propria droga per il pianista John Gade."
    ],
    "fr": [
      "Mystique, rêveur, diabolique, envoutant, ensorcelant : autant de qualitatifs pour la musique de Scriabine, véritable drogue pour le pianiste John Gade."
    ],
    "nl": [
      "Mystiek, dromerig, duivels, betoverend: dit zijn slechts enkele van de kwaliteiten die de muziek van Scriabin beschrijven, een ware drug voor pianist John Gade."
    ],
    "es": [
      "Mística, ensoñadora, diabólica, hechizante, embrujadora: éstas son sólo algunas de las cualidades que describen la música de Scriabin, una auténtica droga para el pianista John Gade."
    ]
  },
  "rdfs:label": {
