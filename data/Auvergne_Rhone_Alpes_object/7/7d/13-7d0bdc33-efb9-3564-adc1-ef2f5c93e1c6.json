  "rdfs:comment": {
    "de": [
      "Das Les 2 Mules empfängt Sie in einem modernen und gemütlichen Rahmen. Gegenüber den Skipisten von Bossonnet wird Ihnen hier eine bistronomische Küche angeboten."
    ],
    "en": [
      "Les 2 Mules welcomes you in a contemporary and warm setting. Facing the Bossonnet slopes, a nice bistronomic cuisine is offered."
    ],
    "it": [
      "Les 2 Mules offre un'accoglienza calda e contemporanea. Di fronte alle piste di Bossonnet, potrete gustare una cucina bistronomica."
    ],
    "fr": [
      "Les 2 Mules vous accueille dans un cadre contemporain et chaleureux. Face aux pistes du Bossonnet, une cuisine bistronomique vous y est proposée."
    ],
    "nl": [
      "Les 2 Mules verwelkomt u in een eigentijdse en warme omgeving. Tegenover de pisten van Bossonnet worden bistronomische gerechten aangeboden."
    ],
    "es": [
      "Les 2 Mules ofrece una acogida cálida y contemporánea. Frente a las pistas de Bossonnet, podrá degustar cocina bistronómica."
    ]
  },
