  "rdfs:comment": {
    "de": [
      "Eine einzigartige Sinnesreise, während Sie von den Vibrationen der Gongs geschaukelt werden. Eine Einladung, sich zurückzulehnen und die vibrierende Intelligenz der Obertöne wirken zu lassen, um körperliche, geistige und emotionale Spannungen zu lösen."
    ],
    "en": [
      "A unique sensory journey, lulled by the vibrations of gongs. An invitation to settle down and let the vibrational intelligence of harmonics work to release physical, mental and emotional tensions."
    ],
    "it": [
      "Un viaggio sensoriale unico, cullato dalle vibrazioni dei gong. Un invito a rilassarsi e a lasciare che l'intelligenza vibratoria degli armonici lavori per sciogliere le tensioni fisiche, mentali ed emotive."
    ],
    "fr": [
      "Un Voyage sensorielle unique en étant bercé par les vibrations des gongs. Une invitation à se déposer et laisser opérer l'intelligence vibratoire des harmoniques pour libérer les tensions physiques, mentale et émotionnelles."
    ],
    "es": [
      "Un viaje sensorial único, arrullado por las vibraciones de los gongs. Una invitación a relajarse y dejar que la inteligencia vibratoria de los armónicos trabaje para liberar tensiones físicas, mentales y emocionales."
    ],
    "nl": [
      "Een unieke zintuiglijke reis waarbij u wordt gewiegd door de trillingen van gongs. Een uitnodiging om tot rust te komen en de trillingsintelligentie van de harmonischen zijn werk te laten doen om fysieke, mentale en emotionele spanningen los te laten."
    ]
  },
  "rdfs:label": {
    "en": [
      "Sound relaxation with gongs with La Voie du Phoenix - HYGGE WINTER"
    ],
    "fr": [
      "Relaxation sonore aux gongs avec La Voie du Phoenix - HYGGE WINTER"
    ],
    "nl": [
      "Geluidsontspanning met gongs met La Voie du Phoenix - HYGGE WINTER"
    ]
  },
