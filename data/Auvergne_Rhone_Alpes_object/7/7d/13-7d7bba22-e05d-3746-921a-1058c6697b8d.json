  "rdfs:comment": {
    "de": [
      "Das Foyer des Moises empfängt Sie im Sommer und im Winter. Genießen Sie die 4-Jahreszeiten-Aktivitäten in der außergewöhnlichen Umgebung des Plateau des Moises zwischen See und Bergen."
    ],
    "en": [
      "Le Foyer des Moises welcomes you in the summer and winter alike. Enjoy the 4 seasons activities in the exceptional setting of the Plateau Moises between the lake and mountains."
    ],
    "it": [
      "Il Foyer des Moises vi accoglie in estate e in inverno. Venite a praticare attività per 4 stagioni nell'eccezionale cornice del Plateau des Moises, tra il lago e le montagne."
    ],
    "fr": [
      "Le Foyer des Moises vous accueille été comme hiver. Venez profiter des activités 4 saisons dans le cadre exceptionnel du Plateau des Moises entre lac et montagnes."
    ],
    "es": [
      "El Foyer des Moises le da la bienvenida en verano y en invierno. Venga a disfrutar de actividades 4 estaciones en el marco excepcional del Plateau des Moises, entre el lago y la montaña."
    ],
    "nl": [
      "De Foyer des Moises heet je welkom in zomer en winter. Kom genieten van activiteiten in 4 seizoenen in de uitzonderlijke omgeving van het Plateau des Moises, tussen het meer en de bergen."
    ]
  },
