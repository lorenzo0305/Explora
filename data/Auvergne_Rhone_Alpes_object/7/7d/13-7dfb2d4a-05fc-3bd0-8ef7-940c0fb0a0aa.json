  "rdfs:comment": {
    "de": [
      "Lernen Sie Albert kennen, der Ihnen mit Leidenschaft von seinem Beruf als Bergbauer erzählt. Besichtigung, Herstellung, Melken ... Albert wird Ihnen alles erklären!\n*Unter bestimmten Bedingungen, wenden Sie sich an das Tourismusbüro."
    ],
    "en": [
      "Meet Albert, who will talk passionately about his job as a mountain farmer. Tour, production, milking... Albert will explain everything!\n*Subject to conditions, contact the tourist office."
    ],
    "it": [
      "Incontrate Albert, che vi parlerà con passione del suo lavoro di agricoltore di montagna. Tour, produzione, mungitura... Albert vi spiegherà tutto!\n*Soggetto a condizioni, contattare l'ufficio turistico."
    ],
    "fr": [
      "Rencontrez Albert qui vous parlera avec passion de son métier d'agriculteur de montagne. Visite, fabrication, traite... Albert vous expliquera tout !\r\n*Sous conditions, contacter l'office de tourisme."
    ],
    "nl": [
      "Ontmoet Albert, die gepassioneerd zal vertellen over zijn werk als bergboer. Rondleiding, productie, melken... Albert zal alles uitleggen!"
    ],
    "es": [
      "Conozca a Albert, que le hablará con pasión de su trabajo como agricultor de montaña. Visita, producción, ordeño... Albert te lo explicará todo\r\n*Sujeto a condiciones, póngase en contacto con la oficina de turismo."
    ]
  },
