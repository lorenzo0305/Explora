  "rdfs:comment": {
    "de": [
      "Bei Au Petit Primeur finden Sie eine große Auswahl an Obst und Gemüse der Saison sowie sorgfältig ausgewählte Feinkostprodukte."
    ],
    "en": [
      "At Au Petit Primeur, you'll find a wide variety of seasonal fruit and vegetables, as well as carefully selected delicatessen products."
    ],
    "it": [
      "Da Au Petit Primeur troverete un'ampia gamma di frutta e verdura di stagione, oltre a prodotti di gastronomia accuratamente selezionati."
    ],
    "fr": [
      "Chez Au Petit Primeur, vous trouverez une grande variété de fruits et légumes de saison, ainsi que des produits d'épicerie fine sélectionnés avec soin."
    ],
    "es": [
      "En Au Petit Primeur, encontrará una amplia gama de frutas y verduras de temporada, así como productos delicatessen cuidadosamente seleccionados."
    ],
    "nl": [
      "Bij Au Petit Primeur vind je een breed assortiment seizoensfruit en -groenten en zorgvuldig geselecteerde delicatessen."
    ]
