  "rdfs:comment": {
    "de": [
      "Verkauf von Setzlingen für Beete und Gemüsegarten. Verkauf ab Hof und Präsenz auf dem Markt in Feurs am Samstagmorgen und auf dem Markt in Saint-Laurent-de-Chamousset am Montagmorgen."
    ],
    "en": [
      "Sales of bedding and vegetable plants. On-site sales and presence at Feurs market on Saturday mornings and Saint-Laurent-de-Chamousset market on Monday mornings."
    ],
    "it": [
      "Vendita di piante da letto e da orto. Vendita presso la proprietà e presenza al mercato di Feurs il sabato mattina e al mercato di Saint-Laurent-de-Chamousset il lunedì mattina."
    ],
    "fr": [
      "Vente de plants à massif et potager. Vente à la propriété et présent sur le marché de Feurs le samedi matin et sur celui de Saint-Laurent-de-Chamousset le lundi matin."
    ],
    "nl": [
      "Verkoop van perkgoed en groenteplanten. Verkoop op het landgoed en aanwezig op de Feurs markt op zaterdagochtend en de Saint-Laurent-de-Chamousset markt op maandagochtend."
    ],
    "es": [
      "Venta de plantas de parterre y hortalizas. Ventas en la propiedad y presente en el mercado de Feurs los sábados por la mañana y en el mercado de Saint-Laurent-de-Chamousset los lunes por la mañana."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Serres des Varennes"
    ]
  },
