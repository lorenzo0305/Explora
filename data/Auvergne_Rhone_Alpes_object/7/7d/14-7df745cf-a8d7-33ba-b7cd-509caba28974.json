  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/bd41bf65-2cd1-3c6f-bb72-2d1d9386710b",
      "dc:description": {
        "de": [
          "Die Berges de Liane und der Palais des Sports Damrémont werden von über 100 Sportvereinen und -clubs aus Boulogne belebt. Das Wochenende ist ideal, um seine neuen Aktivitäten für das ganze Jahr zu finden!"
        ],
        "en": [
          "The Berges de Liane and the Palais des Sports Damrémont come alive with more than 100 associations and sports clubs from Boulonnais for an ideal weekend to find your new activities for the year!"
        ],
        "it": [
          "Le Berges de Liane e il Palais des Sports Damrémont si animano con più di 100 associazioni e club sportivi del Boulonnais per un weekend perfetto per trovare le nuove attività dell'anno!"
        ],
        "fr": [
          "Les Berges de Liane et le Palais des Sports Damrémont s’animent avec plus de 100 associations et clubs sportifs boulonnais pour un week-end idéal pour trouver ses nouvelles activités de l’année !"
        ],
        "es": [
          "Las Berges de Liane y el Palais des Sports Damrémont se animan con más de 100 asociaciones y clubes deportivos del Boulonnais para un fin de semana perfecto para encontrar sus nuevas actividades del año"
        ],
        "nl": [
          "De Berges de Liane en het Palais des Sports Damrémont komen tot leven met meer dan 100 verenigingen en sportclubs uit de Boulonnais voor een ideaal weekend om nieuwe activiteiten voor het jaar te vinden!"
        ]
      },
