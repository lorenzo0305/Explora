  "rdfs:comment": {
    "de": [
      "Gravieren Sie die Komplizenschaft mit Ihren vierbeinigen Gefährten im Herzen der Kulisse der Drôme!  \r\nAußerhalb der Zeit werden Sie die Natur und eine freundliche und professionelle Atmosphäre genießen.\r\nErleben Sie ein neuartiges Konzept der Hundefotografie!"
    ],
    "en": [
      "Engrave the complicity with your 4-legged companions in the heart of the Drôme scenery!  \r\nOut of time, you'll enjoy nature and a friendly, professional atmosphere.\r\nExperience a new concept in dog photography!"
    ],
    "it": [
      "Create un legame con i vostri amici a 4 zampe nel cuore della campagna della Drôme!  \r\nFuori dal tempo, godrete della natura e di un'atmosfera amichevole e professionale.\r\nSperimentate un concetto completamente nuovo di fotografia cinofila!"
    ],
    "fr": [
      "Graver la complicité avec vos compagnons à 4 pattes au cœur des décors Drômois !  \r\nHors du temps, vous profiterez de la nature et d'une atmosphère amicale et professionnelle.\r\nVivez un concept inédit de la photographie canine !"
    ],
    "nl": [
      "Graaf de medeplichtigheid met je viervoetige metgezellen in het hart van het Drôme landschap!  \r\nBuiten de tijd geniet je van de natuur en een vriendelijke, professionele sfeer.\r\nBeleef een heel nieuw concept in hondenfotografie!"
    ],
    "es": [
      "Cree un vínculo con sus amigos de 4 patas en plena campiña de la Drôme  \r\nFuera del tiempo, disfrutará de la naturaleza y de un ambiente agradable y profesional.\r\nDescubra un nuevo concepto de fotografía canina"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Camille H Photographie"
    ]
  },
