  "rdfs:comment": {
    "de": [
      "Ein Eintauchen in eine sensible Durchquerung des Waldes, um auf unsere tiefste Natur zu hören und auf die Natur, die uns umgibt!"
    ],
    "en": [
      "A sensitive journey through the forest, listening to our deepest natures and the one that surrounds us!"
    ],
    "it": [
      "Un viaggio sensibile attraverso la foresta, in ascolto della nostra natura più intima e della foresta che ci circonda!"
    ],
    "fr": [
      "Une plongée dans une traversée sensible de la forêt, à l’écoute de nos natures profondes et de celle qui nous enveloppe !"
    ],
    "es": [
      "Un viaje sensitivo a través del bosque, ¡escuchando nuestra naturaleza más íntima y el bosque que nos rodea!"
    ],
    "nl": [
      "Een gevoelige reis door het bos, luisterend naar onze diepste natuur en het bos dat ons omringt!"
    ]
  },
