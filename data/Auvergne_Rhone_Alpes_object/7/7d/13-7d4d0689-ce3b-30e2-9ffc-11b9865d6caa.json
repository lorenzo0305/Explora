  "rdfs:comment": {
    "de": [
      "Probieren Sie unsere köstlichen Savoyer Pfännchen, unser Savoyer Fondue oder unser Raclette und unsere Super-Kartoffelkrapfen. Im Holzofen gegarte Küche ."
    ],
    "en": [
      "Come and taste our delicious Savoyard pans, our Savoyard fondue or our raclette and great potato fritters. Wood-fired cuisine."
    ],
    "it": [
      "Venite a provare le nostre deliziose padelle savoiarde, la fonduta savoiarda o la raclette e le ottime frittelle di patate. Cucina a legna."
    ],
    "fr": [
      "Venez déguster nos délicieux poêlons savoyards,  notre fondue savoyarde ou notre raclette et nos supers beignets de pommes de terre. Cuisine cuite au feu de bois ."
    ],
    "es": [
      "Venga a probar nuestras deliciosas sartenes saboyanas, nuestra fondue saboyana o nuestra raclette y los estupendos buñuelos de patata. Cocina a la leña."
    ],
    "nl": [
      "Kom en probeer onze heerlijke Savoyaardse koekenpannen, onze Savoyaardse fondue of onze raclette en geweldige aardappelbeignets. Houtgestookte keuken."
    ]
  },
