  "rdfs:comment": {
    "de": [
      "Aus \"L'étable des Complices\" wird \"Complices et Pizza\"\r\nJoris, Rachel und Benoît empfangen Sie mit einem Lächeln in ihrer Pizzeria. Es liegt ihnen am Herzen, Ihnen eine Feinschmeckerküche von hoher Qualität aus frischen Produkten anzubieten."
    ],
    "en": [
      "The new name of the restaurant : Complices & Pizza.  Joris,Rachel and Benoit welcome you with warmth in their restaurant : L'étable des Complices. Their wish is to offer you a gourmet and qualified cooking."
    ],
    "it": [
      "L'étable des Complices diventa Complices et Pizza\r\nJoris, Rachel e Benoît vi accolgono con un sorriso nella loro pizzeria. Si impegnano a offrire una cucina gourmet e di qualità a base di prodotti freschi."
    ],
    "fr": [
      "L'étable des Complices devient Complices et Pizza. \r\nJoris, Rachel et Benoît vous accueillent avec le sourire dans leur pizzeria. Ils ont à cœur de vous proposer une cuisine gourmande et de qualité faite avec des produits frais."
    ],
    "nl": [
      "L'étable des Complices wordt Complices et Pizza\r\nJoris, Rachel en Benoît verwelkomen u met een glimlach in hun pizzeria. Zij zetten zich in om u een gastronomische en kwaliteitsvolle keuken aan te bieden, gemaakt met verse producten."
    ],
    "es": [
      "L'étable des Complices se convierte en Complices et Pizza\r\nJoris, Rachel y Benoît te reciben con una sonrisa en su pizzería. Se comprometen a ofrecerle una cocina gourmet de calidad elaborada con productos frescos."
    ]
  },
