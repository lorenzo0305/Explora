  "rdfs:comment": {
    "de": [
      "Ungewöhnlich in der Ardèche, erleben Sie im INDY PARC ein 100%iges Naturabenteuer mit unseren Escape Games im Wald. Ausgestattet mit einem Tablet-PC begeben Sie sich auf die Suche nach versteckten Hinweisen, lösen Rätsel und erleben gemeinsam mit der Familie oder mit Freunden einen Nervenkitzel."
    ],
    "en": [
      "Experience a 100% natural adventure at INDY PARC, with our forest escapes game. Equipped with a digital tablet, set off in search of hidden clues, solve enigmas and share thrills with family and friends."
    ],
    "it": [
      "Vivete un'avventura naturale al 100% all'INDY PARC, con il nostro gioco di fuga nella foresta. Dotati di una tavoletta digitale, partite alla ricerca di indizi nascosti, risolvete gli enigmi e condividete le emozioni con la famiglia e gli amici."
    ],
    "fr": [
      "Insolite en Ardèche, vivez l’aventure 100% nature à INDY PARC, avec nos escapes game en forêt. Équipés d'une tablette numérique, partez à la recherche d'indices cachés, résolvez les énigmes et partagez des sensations fortes en famille ou entre amis."
    ],
    "es": [
      "Vive una aventura 100% natural en el INDY PARC, con nuestro juego de escape del bosque. Equipado con una tableta digital, sal en busca de pistas ocultas, resuelve los enigmas y comparte la emoción con familiares y amigos."
    ],
    "nl": [
      "Beleef een 100% natuurlijk avontuur in INDY PARC, met ons bosontsnappingsspel. Uitgerust met een digitale tablet ga je op zoek naar verborgen aanwijzingen, los je de raadsels op en deel je de spanning met familie en vrienden."
    ]
  },
