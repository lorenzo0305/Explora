  "rdfs:comment": {
    "de": [
      "12 synthetische und computergesteuerte Bowlingbahnen mit Bumpern und Dinosaurierrampen (anpassbar für 3/4-Jährige), Laser-Game-Center der neuesten Generation mit 400 m², Multiball, Quizraum, Billardraum, Videospiele und jetzt auch Karaoke-Raum."
    ],
    "en": [
      "12 computerized synthetic bowling lanes with bumpers and dinosaur ramps (suitable for children aged 3/4), 400 m² state-of-the-art laser-game center, Multiball, quiz room, billiards room, video games and now a karaoke room."
    ],
    "it": [
      "12 piste da bowling sintetiche computerizzate con bumpers e rampe per dinosauri (adatte a bambini di 3/4 anni), centro giochi laser all'avanguardia di 400 m², Multiball, sala quiz, sala biliardo, videogiochi e ora anche sala karaoke."
    ],
    "fr": [
      "12 pistes de bowling synthétiques et informatisées avec bumpers et rampes dinosaures (adaptabilité pour les 3/4ans), centre de laser game dernière génération de 400 m², Multiball, salle de quiz, salle de billards, jeux vidéo et désormais salle de karaoké."
    ],
    "es": [
      "12 pistas de bolos sintéticas informatizadas con bumpers y rampas de dinosaurios (aptas para niños de 3/4 años), centro de juegos láser de última generación de 400 m², Multiball, sala de concursos, sala de billar, videojuegos y ahora una sala de karaoke."
    ],
    "nl": [
      "12 gecomputeriseerde synthetische bowlingbanen met bumpers en dinosaurushellingen (geschikt voor kinderen van 3/4 jaar), 400 m² ultramodern lasergamecentrum, Multiball, quizzaal, biljartzaal, videogames en nu ook een karaokekamer."
    ]
  },
