  "rdfs:comment": {
    "de": [
      "Bar, Restaurant und Snack mit einer großen Sonnenterrasse in der Nähe der Abfahrt der Skilifte. Genießen Sie unsere savoyischen Spezialitäten, Crêpes, Waffeln und andere Leckereien, mittags, zum Snack, zum Aperitif oder abends!"
    ],
    "en": [
      "Bar, restaurant and snack bar with a large sunny terrace close to the start of the ski lifts. Come and enjoy our Savoyard specialities, crêpes, waffles and other delicacies, at lunchtime, as a snack, an aperitif or in the evening!"
    ],
    "it": [
      "Bar, ristorante e snack bar con un'ampia terrazza soleggiata vicino alla partenza degli impianti di risalita. Venite a gustare le nostre specialità savoiarde, crêpes, waffles e altre prelibatezze, a pranzo, come spuntino, aperitivo o la sera!"
    ],
    "fr": [
      "Bar, restaurant et snack avec une grande terrasse ensoleillée à proximité du départ des remontées mécaniques. Venez déguster nos spécialités savoyardes, crêpes, gaufres et autres gourmandises, le midi, au goûter, à l'apéro ou le soir !"
    ],
    "es": [
      "Bar, restaurante y snack bar con una gran terraza soleada cerca de la salida de los remontes mecánicos. Venga a degustar nuestras especialidades saboyanas, crepes, gofres y otras delicias, al mediodía, como tentempié, aperitivo o por la noche"
    ],
    "nl": [
      "Bar, restaurant en snackbar met een groot zonnig terras vlakbij het begin van de skiliften. Kom genieten van onze Savoyaardse specialiteiten, crêpes, wafels en andere lekkernijen, tijdens de lunch, als tussendoortje, aperitief of 's avonds!"
    ]
  },
