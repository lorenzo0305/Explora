  "rdfs:comment": {
    "de": [
      "Unsere lokale Kantine empfängt Sie mit einer außergewöhnlichen Aussicht auf den Mont Pourri\r\nZu Fuß oder auf Skiern erreichbar. Idealer Ort, um ein Glas zu trinken oder auf der Terrasse in der Sonne und in Ruhe zu essen, mit hausgemachten Gerichten."
    ],
    "en": [
      "Our local eatery welcomes you with a breathtaking view of Mont Pourri.\r\nAccessible on foot or by ski. An ideal spot to enjoy a drink or a meal on the sunny, peaceful terrace, featuring homemade dishes."
    ],
    "it": [
      "Il nostro ristorante locale vi accoglie con una vista mozzafiato sul Mont Pourri.\r\nRaggiungibile a piedi o con gli sci. Un luogo ideale per gustare un drink o un pasto sulla terrazza soleggiata e tranquilla, con piatti fatti in casa."
    ],
    "fr": [
      "Notre cantine locale vous accueille avec une vue exceptionnelle sur le Mont Pourri\r\nAccessible à pied ou à ski. Lieu idéal pour boire un verre, se restaurer en terrasse au soleil et au calme, avec des plats fait maison."
    ],
    "nl": [
      "Onze plaatselijke kantine verwelkomt je met een uitzonderlijk uitzicht op de Mont Pourri\r\nToegankelijk te voet of op ski's. De ideale plek om iets te drinken of te eten op het zonnige, rustige terras, met huisgemaakte gerechten."
    ],
    "es": [
      "Nuestra cantina local le da la bienvenida con una vista excepcional del Mont Pourri\r\nAccesible a pie o con esquís. El lugar ideal para tomar una copa o comer algo en la soleada y tranquila terraza, con platos caseros."
    ]
  },
