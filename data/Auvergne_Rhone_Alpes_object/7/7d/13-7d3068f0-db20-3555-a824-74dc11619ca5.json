  "rdfs:comment": {
    "de": [
      "Das Campanile Montélimar Les Tourettes liegt in der Nähe von Montélimar und bietet preiswerte Zimmer in einer angenehmen Umgebung. Durch die Nähe zur Autobahn A7 sind die Städte Valence im Norden und Avignon im Süden leicht zu erreichen."
    ],
    "en": [
      "On the way out of Montelimar city, le Campanile Montélimar Les Tourettes  offers you inexpensive bedrooms in an agreable setting. The proximity of motorway A7 gives you easy access to the cities of Valence (going north) and Avignon (to the south)."
    ],
    "it": [
      "Situato vicino a Montélimar, il Campanile Montélimar Les Tourettes offre sistemazioni a prezzi accessibili in un ambiente piacevole. La vicinanza dell'autostrada A7 consente di raggiungere facilmente le città di Valence a nord e Avignone a sud."
    ],
    "fr": [
      "Situé à proximité de Montélimar, le Campanile Montélimar Les Tourettes propose des chambres bon marché dans un cadre agréable. La proximité de l'autoroute A7 vous permet d'accéder facilement aux villes de Valence au nord et d'Avignon au sud."
    ],
    "es": [
      "Situado cerca de Montélimar, el Campanile Montélimar Les Tourettes ofrece un alojamiento asequible en un entorno agradable. La proximidad de la autopista A7 le permite acceder fácilmente a las ciudades de Valence, al norte, y Avignon, al sur."
    ],
    "nl": [
      "Het Campanile Montélimar Les Tourettes ligt in de buurt van Montélimar en biedt betaalbare accommodatie in een aangename omgeving. De nabijgelegen snelweg A7 biedt gemakkelijke toegang tot de steden Valence in het noorden en Avignon in het zuiden."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant Campanile Montélimar Nord - Les Tourrettes"
    ]
  },
