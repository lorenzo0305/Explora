  "rdfs:comment": {
    "de": [
      "Das Weingut AMIRA ist ein kleines, außergewöhnliches Familienweingut in Allex (Rhône-Tal) mit 4 Hektar biologisch bewirtschafteten Flächen.\r\n\r\nWir produzieren schwarze Trüffel und Weine aus den Appellationen Brézème, Saint-Joseph, Crozes-Hermitage und Saint-Péray."
    ],
    "en": [
      "The AMIRA Vineyard is a small, exceptional family estate located in Allex (Rhône Valley), encompassing 4 hectares of organically farmed land.\r\n\r\nWe produce black truffles and wines in the Brézème, Saint-Joseph, Crozes-Hermitage, and Saint-Péray appellations."
    ],
    "it": [
      "Il Vignoble AMIRA è una piccola ed eccezionale tenuta familiare situata ad Allex (Valle del Rodano) su 4 ettari di terreno coltivato con metodo biologico.\r\nProduciamo tartufi neri e vini Brézème, Saint-Joseph, Crozes-Hermitage e Saint-Péray."
    ],
    "fr": [
      "Le Vignoble AMIRA est un petit domaine familial d'exception situé à Allex (Vallée du Rhône) ancré sur 4 hectares en agriculture biologique.\r\nNous produisons des truffes noires et des vins en Brézème, Saint-Joseph, Crozes-Hermitage et Saint-Péray."
    ],
    "nl": [
      "Wijngaard AMIRA is een klein, bijzonder familiebedrijf in Allex (Rhônevallei), met 4 hectare biologisch bewerkte grond.\r\nWij produceren zwarte truffels en wijnen in de appellaties Brézème, Saint-Joseph, Crozes-Hermitage en Saint-Péray."
    ],
    "es": [
      "Vignoble AMIRA es una pequeña propiedad familiar excepcional situada en Allex (Valle del Ródano) en 4 hectáreas de terreno de cultivo ecológico.\r\nProducimos trufas negras y vinos de Brézème, Saint-Joseph, Crozes-Hermitage y Saint-Péray."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Cave Vignoble Amira"
    ]
  },
