  "rdfs:comment": {
    "de": [
      "Marie-Thé und Philippe empfangen Sie in ihrem vollständig renovierten Almrestaurant auf 2300 m Höhe, 5 Gehminuten vom Gipfel des Sessellifts Grand Jeu entfernt, in geselliger Runde und mit einem herrlichen Panorama auf die umliegenden Gipfel."
    ],
    "en": [
      "Marie-Thé and Philippe welcome you to their fully renovated alpine restaurant, at an altitude of 2300m, 5 minutes walk from the top of the Grand Jeu chairlift, in a friendly atmosphere and with a magnificent panorama of the surrounding peaks."
    ],
    "it": [
      "Marie-Thé e Philippe vi accolgono nel loro ristorante di montagna completamente rinnovato, a 2300 m di altitudine, a 5 minuti a piedi dalla cima della seggiovia Grand Jeu, in un'atmosfera amichevole e con una magnifica vista sulle cime circostanti."
    ],
    "fr": [
      "Marie-Thé et Philippe vous accueillent dans leur restaurant d'alpage entièrement rénové, à 2300m d'altitude, à 5mn à pied du sommet du télésiège du Grand Jeu, en toute convivialité et avec un magnifique panorama sur les sommets alentours."
    ],
    "es": [
      "Marie-Thé y Philippe le dan la bienvenida a su restaurante de montaña completamente renovado, a 2300 m de altitud, a 5 minutos a pie de la cima del telesilla Grand Jeu, en un ambiente acogedor y con una magnífica vista de las cumbres circundantes."
    ],
    "nl": [
      "Marie-Thé en Philippe heten u welkom in hun volledig gerenoveerde alpenrestaurant, op 2300 meter hoogte, op 5 minuten wandelen van de top van de Grand Jeu-stoeltjeslift, in een vriendelijke sfeer en met een prachtig panorama op de omliggende bergtoppen."
    ]
  },
