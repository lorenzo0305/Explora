  "rdfs:comment": {
    "de": [
      "Dieser grüne, baumbestandene Bereich mit einer Fläche von 4000 m² im Stadtteil Perrier bietet einen sicheren Spielplatz und einen Orientierungslauf für Kinder ab 2 Jahren."
    ],
    "en": [
      "Situated in the Perrier district, this 4,000 m² green and wooded area offers a safe play area and an orienteering course for children aged 2 and over."
    ],
    "it": [
      "Situato nel quartiere di Perrier, questo spazio verde alberato di 4.000 m² offre un'area giochi sicura e un percorso di orientamento per i bambini dai 2 anni in su."
    ],
    "fr": [
      "Situé dans le quartier du Perrier, cet espace verdoyant et arborisé d’une superficie de 4 000 m² propose une aire de jeux en toute sécurité et un parcours d'orientation pour les enfants à partir de 2 ans."
    ],
    "es": [
      "Situado en el barrio de Perrier, este espacio verde y arbolado de 4.000 m² ofrece una zona de juegos segura y un recorrido de orientación para niños a partir de 2 años."
    ],
    "nl": [
      "Deze groene ruimte van 4.000 m² met bomen ligt in de wijk Perrier en biedt een veilige speelruimte en een oriëntatieparcours voor kinderen vanaf 2 jaar."
    ]
  },
