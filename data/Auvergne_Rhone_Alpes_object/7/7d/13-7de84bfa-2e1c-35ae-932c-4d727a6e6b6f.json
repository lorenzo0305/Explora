  "rdfs:comment": {
    "de": [
      "Designerin von Dekorationsartikeln aus Stoffen\r\nLa Fabrique d'Elisa bietet Ihnen Kreationen aus hochwertigen Stoffen. Hier finden Sie eine große Auswahl an Dekorationsartikeln aus Stoff, wie Kissen, Plaids, Girlanden, Tragetaschen"
    ],
    "en": [
      "Designer of fabric decorative items\r\nLa Fabrique d'Elisa offers creations made from quality fabrics. You'll find a wide range of fabric decorative items, including cushions, plaids, garlands, tote bags and more"
    ],
    "it": [
      "Designer di articoli decorativi in tessuto\r\nLa Fabrique d'Elisa propone creazioni realizzate con tessuti di qualità. Troverete un'ampia gamma di articoli decorativi in tessuto, tra cui cuscini, plaid, ghirlande, tote bag e molto altro"
    ],
    "fr": [
      "Créatrice d'articles de décoration en tissus\r\nLa Fabrique d'Elisa vous propose des créations faites avec des tissus de qualité. Vous y trouverez un grand choix d'articles de décoration en tissus, tels que des coussins, plaids, guirlandes, sacs cabas"
    ],
    "nl": [
      "Ontwerper van stoffen decoratieve artikelen\r\nLa Fabrique d'Elisa biedt je creaties gemaakt van kwaliteitsstoffen. Je vindt hier een breed scala aan stoffen decoratieve artikelen, waaronder kussens, plaids, slingers, draagtassen en meer"
    ],
    "es": [
      "Diseñador de artículos de decoración de tela\r\nLa Fabrique d'Elisa le ofrece creaciones realizadas con telas de calidad. Encontrará una amplia gama de artículos de decoración de tela, como cojines, cuadros escoceses, guirnaldas, bolsos de mano y mucho más"
    ]
  },
