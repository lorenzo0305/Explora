  "rdfs:comment": {
    "de": [
      "Besichtigung auf Anfrage, um diese Anlage in reinster Natur zu erleben, mit unterschiedlichen Tierarten und -rassen (Geflügel, Ziegen, Rinder, Pferde, Schweine ...), die meisten von ihnen Zwergarten."
    ],
    "en": [
      "Visits by appointment to discover different races and species of animals in natural surroundings (poultry, goats, sheep, horses, pigs...) including many dwarf species."
    ],
    "it": [
      "Venite a trascorrere un momento unico a contatto con i piccoli animali della fattoria in questa mini fattoria familiare. Gli appassionati proprietari vi\r\ne vi faranno conoscere tutti i loro piccoli animali. I bambini ne saranno entusiasti!"
    ],
    "fr": [
      "Venez passer un moment unique au contact d’animaux de la ferme, de petite taille, au sein de cette mini ferme familiale. Les propriétaires passionnés vous\r\nparleront de leur métier et vous présenteront tous leurs petits animaux. Les enfants vont adorer !"
    ],
    "es": [
      "Venga a pasar un momento único en contacto con pequeños animales de granja en esta minigranja familiar. Los apasionados propietarios le\r\ny te presentarán a todos sus animalitos. ¡A los niños les encantará!"
    ],
    "nl": [
      "Kom en beleef een uniek moment in contact met kleine boerderijdieren op deze mini-familieboerderij. De gepassioneerde eigenaars zullen\r\nen laten je kennismaken met al hun kleine dieren. Kinderen zullen het geweldig vinden!"
    ]
  },
  "rdfs:label": {
    "de": [
      "Ferme - Au Bonheur des animaux"
    ],
    "en": [
      "Ferme - Au Bonheur des animaux"
    ],
    "fr": [
      "Ferme - Au Bonheur des Animaux"
    ]
  },
