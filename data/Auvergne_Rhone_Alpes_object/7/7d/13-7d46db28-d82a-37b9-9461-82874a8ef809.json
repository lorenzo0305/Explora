  "rdfs:comment": {
    "de": [
      "Dieses Museum hat sich zum Ziel gesetzt, ein Erbe zu entdecken, bekannt zu machen und zu schützen, nämlich das der Männer des Feuers."
    ],
    "en": [
      "This museum is intended to allow people to discover, get to know and protect the men of fire heritage."
    ],
    "it": [
      "L'obiettivo di questo museo è far scoprire, comprendere e proteggere un patrimonio, quello degli uomini del fuoco."
    ],
    "fr": [
      "Ce musée a pour objectif de faire découvrir, connaître et protéger un patrimoine, celui des hommes du feu."
    ],
    "nl": [
      "Het doel van dit museum is mensen een erfgoed, dat van de mannen van het vuur, te laten ontdekken, begrijpen en beschermen."
    ],
    "es": [
      "El objetivo de este museo es hacer descubrir, comprender y proteger un patrimonio, el de los hombres del fuego."
    ]
