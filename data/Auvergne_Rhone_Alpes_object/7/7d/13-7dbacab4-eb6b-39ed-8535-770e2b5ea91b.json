  "rdfs:comment": {
    "de": [
      "Willkommen bei ?Le Bellevarde - Maison Louly: Erhöhen Sie Ihren Aufenthalt.\r\nErleben Sie eine vielfältige und unvergessliche Erfahrung an diesem einzigartigen Ort, der auf dem Gipfel des Bellevarde thront, mit Blick auf ein meisterhaftes Panorama der symbolträchtigen Gipfel von Val d'Isère."
    ],
    "en": [
      "Welcomd to ​Le Bellevarde - Maison Louly: Elevate your stay. \r\nLive an unforgettable, multi-faceted experience in this unique spot, perched atop Bellevarde, facing a majestic panoramic view of Val d'Isère's iconic peaks."
    ],
    "it": [
      "Benvenuti da Le Bellevarde - Maison Louly: Elevate il vostro soggiorno. \r\nVivete un'esperienza multipla e indimenticabile in questo luogo unico, situato sulla cima di Bellevarde, di fronte a un panorama maestoso sulle cime emblematiche di Val d'Isère."
    ],
    "fr": [
      "Bienvenue chez ​Le Bellevarde - Maison Louly : Élevez votre séjour. \r\nVivez une expérience multiple et inoubliable dans ce lieu unique, perché au sommet de Bellevarde, face à un panorama magistral sur les sommets emblématiques de Val d'Isère."
    ],
    "nl": [
      "Welkom bij Le Bellevarde - Maison Louly: Verhoog uw verblijf.\r\nBeleef een meervoudige en onvergetelijke ervaring op deze unieke plek, gelegen op de top van Bellevarde, met uitzicht op een meesterlijk panorama van de emblematische bergtoppen van Val d'Isère."
    ],
    "es": [
      "Bienvenido a Le Bellevarde - Maison Louly: Eleve su estancia.\r\nViva una experiencia múltiple e inolvidable en este lugar único, encaramado en lo alto de Bellevarde, frente a un panorama magistral de las cumbres emblemáticas de Val d'Isère."
    ]
  },
