  "rdfs:comment": {
    "de": [
      "Begeben Sie sich in luftige Höhen, wenn Sie von Grenoble nach Saint-Nizier du Moucherotte fahren und dabei die 1260 m kumulierten Höhenunterschied überwinden, die sich auf etwa 40 km entlang der alten Straßenbahntrasse, die Grenoble mit Villard de Lans im Vercors verband, auftürmen."
    ],
    "en": [
      "Climb from Grenoble to Saint-Nizier du Moucherotte, climbing the 1260 m of ascent that follow one another for some 40 km along the old tramway that used to link Grenoble to Villard de Lans in the Vercors."
    ],
    "it": [
      "Salite da Grenoble a Saint-Nizier du Moucherotte, scalando i 1260 metri di salita che si susseguono per quaranta chilometri lungo la vecchia linea tranviaria che collegava Grenoble a Villard de Lans nel Vercors."
    ],
    "fr": [
      "Prenez de la hauteur en partant de Grenoble jusqu'à Saint-Nizier du Moucherotte en montant les 1260 m de dénivelé cumulé qui se succèdent sur une quarantaine de km le long de l'ancienne voie du tram qui reliait Grenoble à Villard de Lans dans le Vercors."
    ],
    "es": [
      "Suba desde Grenoble hasta Saint-Nizier du Moucherotte, ascendiendo un total de 1.260 m de desnivel a lo largo de unos cuarenta kilómetros por la antigua línea de tranvía que unía Grenoble con Villard de Lans, en el Vercors."
    ],
    "nl": [
      "Klim van Grenoble naar Saint-Nizier du Moucherotte, in totaal 1.260 m hoogteverschil over zo'n veertig kilometer langs de oude tramlijn die Grenoble vroeger verbond met Villard de Lans in de Vercors."
    ]
  },
