  "rdfs:comment": {
    "de": [
      "Herstellung und Verkauf von Milch, Tomes, Frischkäse, Blauschimmelkäse und Joghurt aus 100% biologischer Ziegenmilch. Meine Ziegen weiden auf 1200 m Höhe im Herzen des Sancy-Massivs: ein wahres Paradies für meine Zicklein, nur wenige Minuten von Mont-Dore und La Bourboule entfernt."
    ],
    "en": [
      "Manufacture and sale of milk, tomes, blue cheeses and yoghurts made from 100% organic goat's milk."
    ],
    "it": [
      "Produzione e vendita di latte, tomi, fromage frais, formaggi erborinati e yogurt a base di latte di capra 100% biologico. Le mie capre pascolano a 1200 m di altitudine nel cuore del Massiccio del Sancy: un vero paradiso per le mie biquettes, a pochi minuti da Le Mont-Dore e La Bourboule."
    ],
    "fr": [
      "Fabrication et vente de lait, tomes, fromage frais ,bleus et yaourts au lait de chèvre 100% bio. Mes chèvres pâturent à 1200m d'altitude au cœur du Massif du Sancy : un vrai paradis pour mes biquettes, à quelques minutes du Mont-Dore et de la Bourboule."
    ],
    "nl": [
      "Productie en verkoop van melk, tomes, fromage frais, blauwe kazen en yoghurt van 100% biologische geitenmelk. Mijn geiten grazen op 1200 meter hoogte in het hart van het Massif du Sancy: een waar paradijs voor mijn biquettes, op slechts een paar minuten van Le Mont-Dore en La Bourboule."
    ],
    "es": [
      "Producción y venta de leche, tomes, fromage frais, quesos azules y yogures elaborados con leche de cabra 100% ecológica. Mis cabras pastan a 1.200 m de altitud en el corazón del Macizo del Sancy: un auténtico paraíso para mis biquetes, a pocos minutos de Le Mont-Dore y La Bourboule."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Ferme de Chamablanc - Chèvrerie"
    ]
  },
