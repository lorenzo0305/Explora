  "rdfs:comment": {
    "de": [
      "Blanche Abel ist eine Hutmacherin aus Rom, ein historisches Hut-Know-how, das sie als Erbe beansprucht, das aus den Generationen von Modistinnen vor ihr hervorgegangen ist. Auf Anfrage werden Einführungskurse in die Hutmacherei angeboten."
    ],
    "en": [
      "Blanche Abel is a hat-maker from Roman, with a long-standing expertise in hats that she claims as a heritage handed down from generations of milliners before her. You can ask for hats lessons!"
    ],
    "it": [
      "Blanche Abel è una cappellaia romana con una lunga esperienza nel campo dei cappelli, che considera un'eredità tramandata da generazioni di modiste prima di lei. Corsi di introduzione alla creazione di cappelli sono disponibili su richiesta"
    ],
    "fr": [
      "Blanche Abel est une fabricante romanaise de chapeaux, un savoir-faire historique du chapeau qu’elle revendique comme un patrimoine issu des générations de modistes avant elle. Des cours d'initiation à la chapellerie sont proposés sur demande"
    ],
    "nl": [
      "Blanche Abel is een hoedenmaakster uit Roman, met een jarenlange expertise in hoeden die ze ziet als een erfenis die is doorgegeven door generaties hoedenmaaksters voor haar."
    ],
    "es": [
      "Blanche Abel es una sombrerera romana con una larga experiencia en sombreros que considera una herencia heredada de generaciones de sombrereros que la precedieron. Puede solicitar cursos de iniciación a la sombrerería"
    ]
  },
