  "rdfs:comment": {
    "de": [
      "Keramikwerkstatt im Herzen des Pilat!\r\nVerkauf von Geschirr, Deko-Objekten und handgefertigtem Schmuck aus Porzellan oder Steingut. Töpferkurse für Erwachsene und Kinder."
    ],
    "en": [
      "Ceramic workshop in the heart of Pilat!\r\nSales of crockery, decorative objects, handmade jewelry in porcelain or stoneware. Pottery classes for adults and children."
    ],
    "it": [
      "Laboratorio di ceramica nel cuore di Pilat!\r\nVendita di stoviglie, oggetti decorativi e gioielli fatti a mano in porcellana o gres. Corsi di ceramica per adulti e bambini."
    ],
    "fr": [
      "Atelier de céramique au coeur du Pilat ! \r\nVentes de vaisselles, objets déco, bijoux faits main en porcelaine ou en grès. Cours de poterie pour adultes et enfants."
    ],
    "es": [
      "Taller de cerámica en el corazón de Pilat\r\nVenta de vajillas, objetos de decoración y bisutería artesanal en porcelana o gres. Clases de cerámica para adultos y niños."
    ],
    "nl": [
      "Keramiekatelier in het hart van Pilat!\r\nVerkoop van serviesgoed, decoratieve objecten en handgemaakte sieraden van porselein of steengoed. Pottenbakkerslessen voor volwassenen en kinderen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Atelier céramique de La petite Chazaly"
    ]
  },
