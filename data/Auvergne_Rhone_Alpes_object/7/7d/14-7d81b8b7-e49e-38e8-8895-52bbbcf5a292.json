      "dc:description": {
        "de": [
          "Während der Konfirmation ist der Lebensmittelladen O'Yummy (japanische und amerikanische Spezialitäten) mittwochs und samstags von 15:00 bis 18:00 Uhr geöffnet."
        ],
        "en": [
          "The O'Yummy grocery store (Japanese and American specialties) is open every Wednesday and Saturday from 3pm to 6pm."
        ],
        "it": [
          "Il negozio di alimentari O'Yummy (specialità giapponesi e americane) è aperto tutti i mercoledì e i sabati dalle 15.00 alle 18.00."
        ],
        "fr": [
          "Pendant le confiement, l'épicerie O'Yummy (spécialités japonaises et américaines) est ouverte tous les mercredis et samedis de 15h à 18h."
        ],
        "es": [
          "La tienda de comestibles O'Yummy (especialidades japonesas y americanas) abre todos los miércoles y sábados de 15.00 a 18.00 h."
        ],
        "nl": [
          "De kruidenierswinkel O'Yummy (Japanse en Amerikaanse specialiteiten) is elke woensdag en zaterdag geopend van 15.00 tot 18.00 uur."
        ]
      },
