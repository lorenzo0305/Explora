  "rdfs:comment": {
    "de": [
      "Immer ein guter Grund zu kommen und wieder zu kommen, um deine italienischen Lieblingsgerichte zu probieren, um eine coole, lebendige und leckere Zeit rund um die Events zu verbringen."
    ],
    "en": [
      "There's always a good reason to come and return to enjoy your favorite Italian dishes and spend a cool, lively, tasty time around the events."
    ],
    "it": [
      "C'è sempre un buon motivo per venire e tornare a gustare i vostri piatti italiani preferiti e passare un momento fresco, vivace e gustoso in occasione degli eventi."
    ],
    "fr": [
      "Toujours une bonne raison de venir et de revenir pour déguster tes plats italiens préférés pour passer un moment cool, vivant, et savoureux autour des events."
    ],
    "es": [
      "Siempre hay un buen motivo para venir y volver a disfrutar de sus platos italianos favoritos y pasar un rato fresco, animado y sabroso en torno a los acontecimientos."
    ],
    "nl": [
      "Er is altijd een goede reden om terug te komen en te genieten van je favoriete Italiaanse gerechten."
    ]
  },
