  "rdfs:comment": {
    "de": [
      "Nehmen Sie sich Zeit - für einen Ausflug außerhalb der Zeit!\r\nVon Taisnières-en-Thiérache aus können Sie in einer bequemen Kutsche, die von stolzen Zugpferden gezogen wird, durch die grünen Landschaften des Avesnois fahren."
    ],
    "en": [
      "Take your time? for a timeless ride!\r\nFrom Taisnières-en-Thiérache, climb aboard a comfortable horse-drawn carriage pulled by proud draught horses, for a bucolic escapade through the verdant landscapes of the Avesnois."
    ],
    "it": [
      "Prendetevi un po' di tempo per un giro senza tempo!\r\nDa Taisnières-en-Thiérache, salite a bordo di una comoda carrozza trainata da fieri cavalli da tiro per una fuga bucolica attraverso i verdi paesaggi dell'Avesnois."
    ],
    "fr": [
      "Prenez le temps… celui d’une balade hors du temps !\r\nDepuis Taisnières-en-Thiérache, montez à bord d’une calèche confortable, tirée par de fiers chevaux de trait, pour une escapade bucolique à travers les paysages verdoyants de l’Avesnois."
    ],
    "es": [
      "Tómese su tiempo... ¡para un paseo eterno!\r\nDesde Taisnières-en-Thiérache, suba a bordo de un cómodo coche tirado por orgullosos caballos de tiro para una bucólica escapada por los verdes paisajes del Avesnois."
    ],
    "nl": [
      "Neem de tijd voor een tijdloze rit!\r\nKlim vanuit Taisnières-en-Thiérache aan boord van een comfortabele koets getrokken door trotse trekpaarden voor een bucolische escapade door de weelderige groene landschappen van de Avesnois."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Calèche gourmande"
    ]
  },
