  "rdfs:comment": {
    "de": [
      "Die Killy's Bar-Barserie bietet Ihnen Pizzas und Salate ... in einer gemütlichen Atmosphäre für eine kleine Pause auf der Terrasse oder drinnen!\r\nKommen Sie vorbei und entdecken Sie das Bier der Bestie!\r\nService mittags und abends in der Saison\r\nPizza vor Ort oder zum Mitnehmen"
    ],
    "en": [
      "Killy's Bar-Barserie offers pizzas and salads ...in a warm atmosphere for a break on the terrace or inside!\r\nCome and discover La Bête beer\r\nLunch and dinner service in season\r\nPizza on site or to take away"
    ],
    "it": [
      "Il Bar-Barserie di Killy offre pizze e insalate... in un'atmosfera calda per una pausa in terrazza o all'interno!\r\nVenite a scoprire la bière de la Bête\r\nServizio a pranzo e sera in stagione\r\nPizza sul posto o da asporto"
    ],
    "fr": [
      "Le Killy's Bar-Barserie vous propose des pizzas et des salades ...dans une ambiance chaleureuse pour une petite pause en terrasse ou à l'intérieur !\r\nVenez découvrir la bière de la Bête\r\nService midi et soir en saison\r\nPizza sur place ou à emporter"
    ],
    "nl": [
      "Killy's Bar-Barserie biedt pizza's en salades... in een warme sfeer voor een pauze op het terras of binnen!\r\nKom en ontdek de bière de la Bête\r\nLunchtijd- en avondservice in het seizoen\r\nPizza ter plaatse of om mee te nemen"
    ],
    "es": [
      "El Bar-Barserie de Killy le ofrece pizzas y ensaladas... ¡en un ambiente cálido para una pausa en la terraza o en el interior!\r\nVenga a descubrir la bière de la Bête\r\nServicio a mediodía y por la noche en temporada\r\nPizza in situ o para llevar"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Pub Le Killy's"
    ]
  },
