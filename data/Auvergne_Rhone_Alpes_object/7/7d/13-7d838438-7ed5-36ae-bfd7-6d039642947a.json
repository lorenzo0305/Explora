  "rdfs:comment": {
    "de": [
      "Das Atelier du Petit pois d'argent wurde 2017 gegründet. Véronique le Bescond , Artisan d'Art, verwendet eine in Frankreich noch junge Praxis: die Metallurgie mit Metallpaste."
    ],
    "en": [
      "L?atelier du Petit pois d?argent was founded in 2017. Véronique le Bescond , Artisan d'Art, uses a recent practice in France: metal paste metallurgy."
    ],
    "it": [
      "Il laboratorio Petit pois d'argent è stato fondato nel 2017. Véronique le Bescond, Artisan d'Art, utilizza una pratica recente in Francia: la metallurgia delle paste metalliche."
    ],
    "fr": [
      "L’atelier du Petit pois d’argent a vu le jour en 2017. Véronique le Bescond , Artisan d'Art utilise une pratique récente en France : la métallurgie en pâte de métaux."
    ],
    "nl": [
      "Het atelier Petit pois d?argent werd opgericht in 2017. Véronique le Bescond, Artisan d'Art, maakt gebruik van een recente praktijk in Frankrijk: de metallurgie van metaalpasta."
    ],
    "es": [
      "El taller Petit pois d'argent se fundó en 2017. Véronique le Bescond, Artisan d'Art, utiliza una práctica reciente en Francia: la metalurgia de pasta metálica."
    ]
  },
