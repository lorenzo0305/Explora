  "rdfs:comment": {
    "de": [
      "Die Bibliothek des Museums von Valencia ist auf die Bereiche spezialisiert, die mit den Sammlungen des Museums in Verbindung stehen, und verfügt über einen Bestand von über 10.000 Büchern.\r\nIn Verbindung mit dem Programm des Museums bietet sie Begegnungen und Veranstaltungen für jedes Publikum an."
    ],
    "en": [
      "The Valence museum library specializes in art and archaeology. Free entrance."
    ],
    "it": [
      "La biblioteca-museo di Valence è specializzata in arte e archeologia. Ingresso gratuito."
    ],
    "fr": [
      "La bibliothèque du musée de Valence est spécialisée en art et archéologie. Entrée libre et gratuite."
    ],
    "es": [
      "La biblioteca del museo de Valence está especializada en arte y arqueología. Entrada gratuita."
    ],
    "nl": [
      "De museumbibliotheek van Valence, die gespecialiseerd is in onderwerpen die verband houden met de collecties van het museum, heeft meer dan 10.000 boeken.\nIn combinatie met de programmering van het museum biedt het bijeenkomsten en evenementen voor het grote publiek."
    ]
  },
