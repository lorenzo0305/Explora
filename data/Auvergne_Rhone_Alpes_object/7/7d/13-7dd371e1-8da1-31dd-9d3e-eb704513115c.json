  "rdfs:comment": {
    "de": [
      "Das Bistro cocotte\" ist eine originelle Kreation von Anne-Laure und Frédéric. Mit demselben Team in der Küche und im Speisesaal bieten sie Ihnen ein Restaurantkonzept mit hausgemachten französischen und regionalen Produkten."
    ],
    "en": [
      "The Bistro Cocotte is an original creation of Anne-Laure and Frédéric. With the same team in the kitchen and in the dining room, they offer you a concept of restoration around French and regional home-made products."
    ],
    "it": [
      "Il Bistro Cocotte è una creazione originale di Anne-Laure e Frédéric. Con lo stesso team in cucina e in sala, vi offrono un concetto di ristorazione basato su prodotti francesi e regionali fatti in casa."
    ],
    "fr": [
      "Le “Bistro cocotte” est une création originale de Anne-Laure et Frédéric. Avec la même équipe en cuisine et en salle, ils vous proposent un concept de restauration autour de produits français et régionaux fait maison."
    ],
    "es": [
      "El Bistro Cocotte es una creación original de Anne-Laure y Frédéric. Con el mismo equipo en la cocina y en el comedor, le ofrecen un concepto de restauración basado en productos caseros franceses y regionales."
    ],
    "nl": [
      "Bistro Cocotte is een originele creatie van Anne-Laure en Frédéric. Met hetzelfde team in de keuken en in de eetzaal bieden zij u een cateringconcept op basis van huisgemaakte Franse en regionale producten."
    ]
  },
  "rdfs:label": {
