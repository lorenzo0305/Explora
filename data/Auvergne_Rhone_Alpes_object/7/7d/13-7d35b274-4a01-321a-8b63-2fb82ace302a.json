  "rdfs:comment": {
    "de": [
      "Der Ort vereint Brasserie, Bar, Lounge, Terrasse und Seminarräume. Dieser zeitgenössische Raum empfängt Sie für verschiedene Dienstleistungen und bietet Ihnen Live-Konzerte und DJ-Club-Mixe."
    ],
    "en": [
      "Discover a unique place combining brasserie , bar, lounge , terrace, seminar rooms and private lounge. Our contemporary space open for various prestations and offers live entertainment and DJ club mix"
    ],
    "it": [
      "La struttura combina una brasserie, un bar, una lounge, una terrazza e sale per seminari. Questo spazio contemporaneo vi accoglie per una varietà di servizi e offre concerti dal vivo ed eventi di DJ club mix."
    ],
    "fr": [
      "Le lieu allie brasserie, bar, lounge, terrasse, salles de séminaire. Cet espace contemporain vous accueille pour des prestations variées et vous propose des animations concert live et mix DJ club."
    ],
    "es": [
      "El local combina una brasserie, un bar, un salón, una terraza y salas de seminarios. Este local contemporáneo ofrece una amplia gama de servicios, como conciertos en directo y mezclas de DJ en clubes."
    ],
    "nl": [
      "De locatie combineert een brasserie, bar, lounge, terras en seminariezalen. Deze eigentijdse ruimte verwelkomt u voor verschillende diensten en biedt live concerten en DJ club mix evenementen."
    ]
  },
