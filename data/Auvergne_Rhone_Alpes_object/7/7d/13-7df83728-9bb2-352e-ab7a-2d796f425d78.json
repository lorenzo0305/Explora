  "rdfs:comment": {
    "de": [
      "Der Park ist ca. 2000 m² groß und bietet einen herrlichen Ausblick auf das Dorf und das Rhône-Tal.\r\nIm Mittelalter wurde der Schlosspark im Norden von einem mächtigen Bergfried dominiert, von dem keine Spuren mehr vorhanden sind."
    ],
    "en": [
      "Municipal park of around 2,000 m², an unmissable stroll to enjoy the view over the village and the Rhône Valley.\r\nIn medieval times, the castle park was dominated to the north by a powerful keep, of which no trace remains."
    ],
    "it": [
      "Parco comunale di circa 2000 m², una passeggiata imperdibile per apprezzare la vista sul villaggio e sulla Valle del Rodano.\r\nNel periodo medievale, il parco del castello era dominato a nord da un potente mastio di cui non rimane traccia."
    ],
    "fr": [
      "Parc municipale d’environ 2000 m², balade immanquable pour apprécier le point de vue sur le village et la Vallée du Rhône..\r\nA la période médiévale, le parc du château était dominé au nord par un puissant donjon dont il ne reste aucune trace."
    ],
    "nl": [
      "Stadspark van ongeveer 2.000 m², een niet te missen wandeling om te genieten van het uitzicht over het dorp en de Rhônevallei.\r\nIn de middeleeuwen werd het kasteeldomein in het noorden gedomineerd door een machtige donjon, waarvan geen sporen zijn overgebleven."
    ],
    "es": [
      "Parque municipal de unos 2000 m², un paseo imperdible para apreciar la vista del pueblo y del valle del Ródano.\r\nEn la época medieval, el parque del castillo estaba dominado al norte por una poderosa torre del homenaje de la que no queda ningún rastro."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Parc du château"
    ]
  },
