  "rdfs:comment": {
    "de": [
      "Im Herzen des Roannais liegt die Gravière aux oiseaux, eine ehemalige Kiesgrube, die Kiesgrube mit vielen Vogelarten"
    ],
    "en": [
      "In the heart of the Roanne region, on 100 acres by the Loire, the Gravière aux Oiseaux offers a unique location for discovering the flora and fauna with its observatory, its hides and its walking path. The former barn/cowshed, renovated and turned into a"
    ],
    "it": [
      "Nella cava di ghiaia, scoprite la Maison de la Gravière, che ospita una mostra permanente sulla fauna e la flora delle zone umide."
    ],
    "fr": [
      "Au sein de la Gravière aux Oiseaux, découvrez la Maison de la Gravière, qui abrite une exposition permanente sur la faune et la flore des milieux humides."
    ],
    "nl": [
      "Ontdek in Gravière aux Oiseaux het Maison de la Gravière, met een permanente tentoonstelling over de flora en fauna van waterrijke gebieden."
    ],
    "es": [
      "En la Gravera, descubra la Maison de la Gravière, que alberga una exposición permanente sobre la fauna y la flora de los humedales."
    ]
  },
