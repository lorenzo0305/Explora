  "rdfs:comment": {
    "de": [
      "Im Herzen des Dorfes empfängt Sie die Auberge Le P'tit Crémo in einem warmen, geselligen und eleganten Rahmen. Vorspeisenbuffet unter der Woche. Menü an den Wochenenden. Froschmenü auf Vorbestellung. Pizzas vor Ort oder zum Mitnehmen, freitags und samstags abends!"
    ],
    "en": [
      "In the heart of the village, Le P'tit Crémo welcomes you to a warm, friendly and elegant setting. Appetizer buffet weekdays. Weekend menu. Frog menu on reservation. Pizzas to eat in or take away on Friday and Saturday evenings!"
    ],
    "it": [
      "Nel cuore del villaggio, Le P'tit Crémo vi accoglie in un ambiente caldo, accogliente ed elegante. Buffet di antipasti durante la settimana. Menu del fine settimana. Menù a base di rane su prenotazione. Pizze da mangiare o da portare via il venerdì e il sabato sera!"
    ],
    "fr": [
      "Au cœur du village, l'auberge Le P'tit Crémo vous accueille dans un cadre chaleureux, convivial et élégant. Buffet d'entrées en semaine. Menu le week-end. Menu grenouilles sur réservation. Pizzas sur place ou à emporter, les vendredis et samedis soirs !"
    ],
    "nl": [
      "In het hart van het dorp heet Le P'tit Crémo u welkom in een warme, vriendelijke en elegante omgeving. Voorgerechtenbuffet tijdens de week. Menu in het weekend. Kikkermenu op afspraak. Pizza's om te eten of mee te nemen op vrijdag- en zaterdagavond!"
    ],
    "es": [
      "En el corazón del pueblo, Le P'tit Crémo le da la bienvenida en un ambiente cálido, acogedor y elegante. Buffet de entrantes entre semana. Menú de fin de semana. Menú rana con reserva previa. Pizzas para comer o llevar los viernes y sábados por la noche"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Auberge Le P'tit Crem'o"
    ]
  },
