  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Monts du Forez und alle ihre Ecken zu Pferd und unabhängig von Ihrem Niveau: Pierre Pamole, Notre Dame de l'Hermitage, Grün de Chignore, der Wald von Ayguebonne und viele andere Orte mehr..."
    ],
    "en": [
      "Come to air your head, to discover the Monts du Forez and all their corners on horseback and whatever your level : Pierre Pamole, Notre Dame de l'Hermitage, the Grün de Chignore, the forest of Ayguebonne and many other places..."
    ],
    "it": [
      "Venite a schiarirvi le idee, a scoprire i Monts du Forez e tutti i suoi angoli a cavallo, qualunque sia il vostro livello: Pierre Pamole, Notre Dame de l'Hermitage, il Grün de Chignore, la foresta di Ayguebonne e molti altri luoghi..."
    ],
    "fr": [
      "Venez vous aérer la tête, découvrir les Monts du Forez et tous leurs recoins à cheval et quelque soit votre niveau : Pierre Pamole, Notre Dame de l'Hermitage, le Grün de Chignore, la forêt d'Ayguebonne et bien d'autres lieux encore..."
    ],
    "es": [
      "Venga a despejarse, a descubrir los Monts du Forez y todos sus rincones a caballo, sea cual sea su nivel: Pierre Pamole, Notre Dame de l'Hermitage, el Grün de Chignore, el bosque de Ayguebonne y muchos otros lugares..."
    ],
    "nl": [
      "Kom uw hoofd leegmaken, ontdek de Monts du Forez en al zijn hoeken en gaten te paard, ongeacht uw niveau: Pierre Pamole, Notre Dame de l'Hermitage, de Grün de Chignore, het bos van Ayguebonne en vele andere plaatsen..."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Entre Ciel et Terre - Centre équestre"
    ]
  },
