  "rdfs:comment": {
    "de": [
      "Ein einzigartiges Konzept, das vom Team von Le Torrent, einem weiteren unumgänglichen Restaurant des Dorfes, umgesetzt wurde. Entdecken Sie diesen außergewöhnlichen Ort. Hier genießt man traditionelle, savoyische Gerichte und originelle Desserts. Online-Reservierung möglich."
    ],
    "en": [
      "A unique concept, created by the team of the Torrent, another must village restaurant. Discover this out of the ordinary place, where you can savour traditional, Savoyard dishes and original desserts. Online booking possible."
    ],
    "it": [
      "Un concetto unico, realizzato dal team del ristorante Torrent, un altro locale di Megève da non perdere. Scoprite questo luogo straordinario. Proposta di ricette tradizionali savoiarde e dessert originali. Le prenotazioni possono essere effettuate online."
    ],
    "fr": [
      "Un concept unique, réalisé par l’équipe du Torrent, autre restaurant incontournable du village. Découvrez cet endroit hors du commun. On y savoure des plats traditionnels, savoyards et des desserts originaux. Réservation possible en ligne."
    ],
    "es": [
      "Un concepto único, creado por el equipo de Le Torrent, otro de los restaurantes de visita obligada del pueblo. Descubra este lugar extraordinario. Saboree platos tradicionales saboyanos y postres originales. Reserva en línea."
    ],
    "nl": [
      "Een uniek concept, bedacht door het team van Le Torrent, nog zo'n must-visit restaurant in het dorp. Ontdek deze buitengewone plek. Geniet van traditionele Savoyaardse gerechten en originele desserts. Online reserveren mogelijk."
    ]
  },
