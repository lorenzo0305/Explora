  "rdfs:comment": {
    "de": [
      "Entdecken Sie unseren Genossenschaftsladen mit regionalem Kunsthandwerk. Wechselnde und permanente Ausstellungen erwarten Sie. Schreibwaren, Grußkarten, Seifen, Parfums, Dessous, Textilien, Nähzubehör, Keramik, Kosmetik, Glasmalerei, Holzarbeiten, Schmuck und weitere Kuriositäten!"
    ],
    "en": [
      "Discover our cooperative shop featuring local arts and crafts. Temporary and permanent exhibitions. Stationery, greeting cards, soaps, perfumes, lingerie, textiles, sewing, ceramics, cosmetics, stained glass, woodwork, jewelry, and other curiosities!"
    ],
    "it": [
      "Scoprite il nostro negozio di artigianato locale. Mostre temporanee e permanenti. Cartoleria, biglietti, sapone, profumi, lingerie, tessuti, cucito, ceramica, cosmetici, vetri colorati, legno, gioielli e altre curiosità!"
    ],
    "fr": [
      "Découvrez notre boutique associative d'art & artisanat local. Expositions temporaires et permanentes. Papeterie, carterie, savonnerie, parfumerie, lingerie, textile, couture, céramique, cosmétique, vitrail, bois, bijouterie et autres curiosités !"
    ],
    "nl": [
      "Ontdek onze coöperatieve winkel met lokale kunst en ambachten. Tijdelijke en permanente tentoonstellingen. Briefpapier, wenskaarten, zeep, parfums, lingerie, textiel, naaibenodigdheden, keramiek, cosmetica, glas-in-lood, houtsnijwerk, sieraden en andere curiositeiten!"
    ],
    "es": [
      "Descubra nuestra tienda de artesanía local. Exposiciones temporales y permanentes. Papelería, tarjetas, jabones, perfumes, lencería, textiles, costura, cerámica, cosméticos, vidrieras, madera, joyas y otras curiosidades"
    ]
  },
