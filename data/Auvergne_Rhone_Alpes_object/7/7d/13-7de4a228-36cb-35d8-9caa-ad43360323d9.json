  "rdfs:comment": {
    "de": [
      "Stéphane Cortial und sein Sohn Damien züchten im Gaec des 3 cerises Legehennen.\r\nDie Eier, die sie liefern, sind von einwandfreier Qualität und werden von den Verbrauchern besonders geschätzt."
    ],
    "en": [
      "Stéphane Cortial and his son Damien raise laying hens at the Gaec des 3 cerises.\r\nThe eggs they produce are of irreproachable quality and particularly appreciated by consumers."
    ],
    "it": [
      "Stéphane Cortial e suo figlio Damien allevano galline ovaiole al Gaec des 3 cerises.\r\nLe uova che producono sono di qualità impeccabile e sono particolarmente apprezzate dai consumatori."
    ],
    "fr": [
      "Stéphane Cortial et son fils Damien élèvent des poules pondeuses au Gaec des 3 cerises.\r\nLes œufs qu’elles donnent sont de qualité irréprochable et particulièrement appréciés par les consommateurs."
    ],
    "es": [
      "Stéphane Cortial y su hijo Damien crían gallinas ponedoras en el Gaec des 3 cerises.\r\nLos huevos que producen son de una calidad irreprochable y gozan de gran popularidad entre los consumidores."
    ],
    "nl": [
      "Stéphane Cortial en zijn zoon Damien houden legkippen in de Gaec des 3 cerises.\r\nDe eieren die ze produceren zijn van onberispelijke kwaliteit en zijn bijzonder populair bij consumenten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "GAEC De 3 Cerises"
    ]
  },
