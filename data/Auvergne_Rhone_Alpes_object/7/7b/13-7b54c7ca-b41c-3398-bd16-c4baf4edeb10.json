  "rdfs:comment": {
    "de": [
      "Willkommen auf unserem neuen Pumptrack! Dieser Sport- und Freizeitbereich im Herzen der Freizeitanlage des Club-Resorts ist für Mountainbikes, BMX-Räder, Inlineskates, Skateboards, Roller und Draisinen gedacht. Beachten Sie die Sicherheitshinweise. Viel Spaß beim Fahren!"
    ],
    "en": [
      "Welcome to our new pumptrack! Located in the heart of the Village leisure area, this sports and leisure facility is dedicated to mountain bikes, BMX bikes, rollerblades, skateboards, scooters and draisiennes. Please follow the safety instructions. Enjoy your ride!"
    ],
    "it": [
      "Benvenuti nel nostro nuovo pumptrack! Situata nel cuore dell'area ricreativa del Villaggio, questa struttura sportiva e ricreativa è dedicata a mountain bike, BMX, rollerblade, skateboard, monopattini e draisiennes. Seguite le regole e divertitevi!"
    ],
    "fr": [
      "Bienvenue sur notre nouveau pumptrack ! Situé au cœur de l'aire de loisirs du Village, cet espace de pratique sportive et de loisir est dédié aux VTT, BMX, rollers, skateboards, trottinettes et draisiennes. Respectez les consignes et bon ride à tous !"
    ],
    "es": [
      "¡Bienvenido a nuestra nueva pista de pumptrack! Situada en el corazón de la zona de ocio del Village, esta instalación deportiva y de ocio está dedicada a las bicicletas de montaña, bicicletas BMX, patines, monopatines, patinetes y draisiennes. ¡Respeta las normas y disfruta del paseo!"
    ],
    "nl": [
      "Welkom bij onze nieuwe pumptrack! Deze sport- en vrijetijdsfaciliteit ligt in het hart van het recreatiegebied Village en is bedoeld voor mountainbikes, BMX-fietsen, skeelers, skateboards, steps en draisiennes. Volg de regels en geniet van de rit!"
    ]
  },
