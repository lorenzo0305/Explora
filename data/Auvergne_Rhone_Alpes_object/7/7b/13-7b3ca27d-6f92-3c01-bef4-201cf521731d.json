  "rdfs:comment": {
    "de": [
      "Das Dorf Habère-Poche ist einer der neuen Startplätze für Heißluftballons am Mont-Blanc-Gebirge. Starten Sie vom Standort Bois Noir aus zu einem Entdeckungsflug im Heißluftballon."
    ],
    "en": [
      "The village of Habère-Poche is one of Mont-Blanc's new hot-air balloon launch sites. Take off from the Bois Noir site for a discovery hot-air balloon flight."
    ],
    "it": [
      "Il villaggio di Habère-Poche è uno dei nuovi siti di lancio delle mongolfiere del Monte Bianco. Decollate dal sito del Bois Noir per un volo in mongolfiera alla scoperta del Monte Bianco."
    ],
    "fr": [
      "Le village d'Habère-Poche est l'un des nouveaux sites d'envol des montgolfières du Mont-Blanc. Décollage depuis le site du Bois Noir pour un vol découverte en montgolfière."
    ],
    "nl": [
      "Het dorp Habère-Poche is een van de nieuwe opstijglocaties voor heteluchtballonnen in de Mont Blanc. Stijg op vanaf de site van Bois Noir voor een ontdekkingstocht in een heteluchtballon."
    ],
    "es": [
      "El pueblo de Habère-Poche es uno de los nuevos puntos de despegue de globos aerostáticos del Mont Blanc. Despegue desde el sitio Bois Noir para un vuelo de descubrimiento en globo aerostático."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Vol découverte en montgolfière en Vallée Verte"
    ]
  },
