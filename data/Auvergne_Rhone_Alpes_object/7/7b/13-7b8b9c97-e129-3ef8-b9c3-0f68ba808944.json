  "rdfs:comment": {
    "de": [
      "Die markierte Route La Croix des 7 frères führt Sie durch den Wald von Les Esserts und kommt auf dem Gipfel des Skigebiets von Morillon wieder heraus."
    ],
    "en": [
      "The signposted route La Croix des 7 frères will take you through the Esserts forest to the top of the Morillon ski area."
    ],
    "it": [
      "Il percorso segnalato La Croix des 7 frères vi porta attraverso la foresta degli Esserts fino alla cima del comprensorio sciistico di Morillon."
    ],
    "fr": [
      "L'itinéraire balisé La Croix des 7 frères vous emmènera dans la forêt des Esserts pour ressortir au sommet du domaine skiable de morillon."
    ],
    "es": [
      "La ruta señalizada La Croix des 7 frères le lleva a través del bosque de Esserts hasta la cima del área de esquí de Morillon."
    ],
