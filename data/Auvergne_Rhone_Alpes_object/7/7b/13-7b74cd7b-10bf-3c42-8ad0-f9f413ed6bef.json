  "rdfs:comment": {
    "de": [
      "Souvigny, eine große Cluniazenserstätte und ein Heiligtum des Friedens.\r\nDie elf Jahrhunderte alte Klosterstadt Souvigny, in der Kultur, Kunst und Glaube miteinander verschmelzen, ist geprägt von zwei Heiligen, Mayeul und Odilon, die sich dafür einsetzten, in einer unruhigen Welt Frieden zu schaffen."
    ],
    "en": [
      "Souvigny, a major Cluniac site and sanctuary of peace.\r\nAn 11-century-old monastic town where culture, art and faith mingle, Souvigny is marked by two saints, Mayeul and Odilon, who worked to establish peace in a troubled world."
    ],
    "it": [
      "Souvigny, importante sito cluniacense e santuario della pace.\r\nCittà monastica di 11 secoli, dove cultura, arte e fede si mescolano, Souvigny è segnata da due santi, Mayeul e Odilon, che hanno lavorato per stabilire la pace in un mondo tormentato."
    ],
    "fr": [
      "Souvigny, grand site clunisien et sanctuaire de la paix. \r\nCité monastique vieille de 11 siècles où se mêle culture, art et foi, Souvigny est marquée par deux Saints, Mayeul et Odilon, qui ont œuvré pour établir la paix dans un monde troublé."
    ],
    "es": [
      "Souvigny, gran lugar cluniacense y santuario de la paz.\r\nSouvigny, ciudad monástica de 11 siglos de antigüedad donde se mezclan cultura, arte y fe, está marcada por dos santos, Mayeul y Odilon, que trabajaron para instaurar la paz en un mundo convulso."
    ],
    "nl": [
      "Souvigny, een belangrijke Cluniac site en heiligdom van de vrede.\r\nSouvigny, een 11 eeuwen oude kloosterstad waar cultuur, kunst en geloof samenkomen, wordt gekenmerkt door twee heiligen, Mayeul en Odilon, die zich inzetten voor vrede in een onrustige wereld."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Souvigny, Ville Sanctuaire de France"
    ]
  },
