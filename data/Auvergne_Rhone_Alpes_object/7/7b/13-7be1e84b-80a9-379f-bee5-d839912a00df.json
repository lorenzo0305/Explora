  "rdfs:comment": {
    "de": [
      "1661: Die Fouquet-Affäre erschüttert das französische Königreich. Madame de Sévigné wird große Risiken eingehen, um ihren Freund Fouquet zu unterstützen. Aber auch andere ihrer Freunde werden bedroht. Wird sie auf ihre Hilfe zählen können?"
    ],
    "en": [
      "1661: the Fouquet affair shakes the kingdom of France. Madame de Sévigné took great risks to support her friend Fouquet. But other friends will also be threatened. Can she count on you to help her?"
    ],
    "it": [
      "1661: l'affare Fouquet scuote il regno di Francia. Madame de Sévigné corse grandi rischi per sostenere l'amico Fouquet. Ma anche altri amici sono minacciati. Può contare su di voi per aiutarla?"
    ],
    "fr": [
      "1661 : l'affaire Fouquet secoue le royaume de France. Madame de Sévigné va prendre de grands risques pour soutenir son ami Fouquet. Mais d'autres de ses amis seront menacés. Pourra-t-elle compter sur vous pour l'aider ?"
    ],
    "es": [
      "1661: el asunto Fouquet sacude el reino de Francia. Madame de Sévigné corrió grandes riesgos para apoyar a su amigo Fouquet. Pero otros amigos también se vieron amenazados. ¿Puede contar con su ayuda?"
    ],
    "nl": [
      "1661: de affaire-Fouquet schokte het koninkrijk Frankrijk. Madame de Sévigné nam grote risico's om haar vriend Fouquet te steunen. Maar andere vrienden werden ook bedreigd. Kan ze op jou rekenen om haar te helpen?"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Madame de Sévigné et l'affaire Fouquet"
    ]
  },
