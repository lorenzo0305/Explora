  "rdfs:comment": {
    "de": [
      "Das Restaurant Auguste genießt eine ideale Lage mit einem Panoramablick auf die wunderschöne Landschaft der Provence. Von seiner Terrasse aus können Sie den Regionalpark der Baronnies Provençales und den Mont Ventoux bewundern."
    ],
    "en": [
      "With its large bay windows, the Restaurant Plantevin offers a panoramic view of Mont Ventoux. Meals are served on the terrace or in the restaurant, depending on the season."
    ],
    "it": [
      "Il ristorante Auguste vanta una posizione ideale con vista panoramica sui magnifici paesaggi della Provenza. Dalla sua terrazza è possibile ammirare il Parc Régional des Baronnies Provençales e il Mont Ventoux."
    ],
    "fr": [
      "Le Restaurant Auguste bénéficie d'un emplacement idéal offrant une vue panoramique sur les magnifiques paysages de Provence. Depuis sa terrasse, vous pouvez admirer le Parc Régional des Baronnies Provençales et le Mont Ventoux."
    ],
    "nl": [
      "Het restaurant Plantevin biedt een panoramisch uitzicht over de Mont Ventoux van achter de grote glazen vensteropeningen. Afhankelijk van het seizoen worden de gerechten op het terras of in de restaurantzaal genuttigd."
    ],
    "es": [
      "El restaurante Auguste goza de una ubicación ideal con vistas panorámicas a los magníficos paisajes de la Provenza. Desde su terraza, podrá admirar el Parc Régional des Baronnies Provençales y el Mont Ventoux."
    ]
  },
