  "rdfs:comment": {
    "de": [
      "L'Entracte ist ein italienisches Restaurant und eine Pizzeria im Herzen von Chambéry, in der Nähe der Elefantenstatue. L'Entracte bietet Ihnen Pizza, Pasta und andere italienische Spezialitäten in einem gemütlichen, italienisch anmutenden Rahmen."
    ],
    "en": [
      "L'Entracte is an Italian restaurant and pizzeria in the heart of Chambéry, near the elephant statue. L'Entracte offers pizzas, pastas and other Italian specialties in a friendly, Italian-style setting."
    ],
    "it": [
      "L'Entracte è un ristorante e pizzeria italiano nel cuore di Chambéry, vicino alla statua degli elefanti. L'Entracte offre pizze, pasta e altre specialità italiane in un ambiente accogliente e in stile italiano."
    ],
    "fr": [
      "L'Entracte est un restaurant italien pizzeria situé au cœur de Chambéry, près de la statue des éléphants. C'est dans un cadre convivial et à l'allure italienne que l'Entracte vous proposera  ses pizzas, pâtes et  autres spécialités italiennes."
    ],
    "nl": [
      "L'Entracte is een Italiaans restaurant en pizzeria in het hart van Chambéry, vlakbij het standbeeld van de olifanten. L'Entracte biedt pizza's, pasta en andere Italiaanse specialiteiten in een vriendelijke, Italiaanse sfeer."
    ],
    "es": [
      "L'Entracte es un restaurante y pizzería italianos situados en el corazón de Chambéry, cerca de la estatua de los elefantes. L'Entracte ofrece pizzas, pasta y otras especialidades italianas en un ambiente acogedor y a la italiana."
    ]
  },
  "rdfs:label": {
    "fr": [
