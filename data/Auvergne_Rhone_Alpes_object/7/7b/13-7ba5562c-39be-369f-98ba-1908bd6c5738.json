  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Museum, einen wahren Zeitmesser für die industrielle und soziale Geschichte des Arve-Tals. Verfolgen Sie die Entwicklung vom Know-how der bäuerlichen Uhrmacher im 18. Jahrhundert bis zum Aufkommen der Drehteileherstellung während der industriellen Revolution."
    ],
    "en": [
      "Discover the Museum, a real timepiece of the industrial and social history of the Arve's valley. Follow the evolution of the farmer-watchmakers' skills from the XVIIIth century until the advent of the screwcutting technology during the industrial revolution."
    ],
    "it": [
      "Venite a scoprire la success story della valee dell’Arve e della sua specifica industria. Affascinante la storia della misura del tempo, la ricerca della precisione, stupendo la complessità dei mecanismi d’orologio!"
    ],
    "fr": [
      "Découvrez le musée, véritable garde-temps de l'histoire industrielle et sociale de la vallée de l'Arve. Suivez l'évolution du savoir-faire des paysans horlogers du XVIIIe siècle à l'émergence du décolletage pendant la révolution industrielle."
    ],
    "nl": [
      "Ontdek het museum, een waar uurwerk van de industriële en sociale geschiedenis van de Arvevallei. Volg de evolutie van de vaardigheden van de 18e-eeuwse horlogemakers tot de opkomst van het schroefsnijden tijdens de industriële revolutie."
    ],
    "es": [
      "Descubra el museo, un auténtico reloj de la historia industrial y social del Valle del Arve. Siga la evolución de los conocimientos técnicos de los campesinos relojeros desde el siglo XVIII hasta la aparición de la rosca durante la revolución industrial."
    ]
  },
  "rdfs:label": {
    "de": [
      "Museum der Uhrmacherei und des Automatendrehens"
    ],
    "en": [
      "Clockmaking and Screwmachining Museum"
    ],
    "it": [
      "Museo dell'orologio e della minuteria e torneria di precisione"
    ],
    "fr": [
      "Musée de l'Horlogerie et du Décolletage"
    ],
    "nl": [
      "Museum van horlogerie en schroefsnijden"
    ]
  },
