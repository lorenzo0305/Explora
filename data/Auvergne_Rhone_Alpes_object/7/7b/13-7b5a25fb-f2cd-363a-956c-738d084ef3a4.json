  "rdfs:comment": {
    "de": [
      "Nach zwei ausverkauften Aufführungen von \"Tenor in Flamenco\" in La Maison Nugues im Jahr 2025, die in Erinnerung geblieben sind, ist der Tenor Di Bettino wieder da, um Ihnen ein unvergessliches Erlebnis zu bescheren."
    ],
    "en": [
      "After two memorable full-length performances of \"Tenor in Flamenco\" at La Maison Nugues in 2025, Tenor Di Bettino is back to bring you an unforgettable experience."
    ],
    "it": [
      "Dopo due memorabili esibizioni di \"Tenore in Flamenco\" presso La Maison Nugues nel 2025, il Tenore Di Bettino torna per regalarvi un'esperienza indimenticabile."
    ],
    "fr": [
      "Après deux représentations complètes de \"Ténor in flamenco\" à La Maison Nugues en 2025 restées dans les mémoires, le Ténor Di Bettino est de retour pour vous faire vivre un moment inoubliable."
    ],
    "es": [
      "Tras dos actuaciones memorables de \"Tenor in Flamenco\" en La Maison Nugues en 2025, Tenor Di Bettino vuelve para ofrecerle una experiencia inolvidable."
    ],
    "nl": [
      "Na twee memorabele voorstellingen van \"Tenor in Flamenco\" in La Maison Nugues in 2025, is Tenor Di Bettino terug om je een onvergetelijke ervaring te brengen."
    ]
  },
  "rdfs:label": {
