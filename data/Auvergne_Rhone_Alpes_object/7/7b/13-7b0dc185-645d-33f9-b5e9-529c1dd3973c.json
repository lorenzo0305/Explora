  "rdfs:comment": {
    "de": [
      "Die Almhütte Avenières heißt Sie von Mai bis Oktober im Herzen der Aravis willkommen. Eine authentische Almhütte für Genießer und Bergliebhaber, mit einem atemberaubenden Panorama. Während eines Spaziergangs können Sie hier zu Mittag essen, eine Snackpause einlegen oder einen Aperitif genießen."
    ],
    "en": [
      "The Avenières alpine pasture welcomes you from May to October, in the heart of the Aravis mountains. An authentic alpine chalet for epicureans and mountain lovers, offering a breathtaking panorama. During your walk, come enjoy a lunch, take a snack break, or savor an aperitif."
    ],
    "it": [
      "L'alpeggio di Avenières vi accoglie da maggio a ottobre. Un autentico chalet di montagna per epicurei e amanti della montagna, con viste panoramiche mozzafiato. Venite per una passeggiata, un pranzo, uno spuntino o un aperitivo."
    ],
    "fr": [
      "L'alpage des Avenières vous accueille de mai à octobre. Un authentique chalet d'alpage pour les épicuriens et amoureux de la montagne, au panorama à couper le souffle. Le temps d'une balade, venez déjeuner, faire une pause goûter ou profiter d'un apéro."
    ],
    "es": [
      "Los pastos de montaña de Avenières le dan la bienvenida de mayo a octubre. Un auténtico chalet de montaña para epicúreos y amantes de la montaña, con impresionantes vistas panorámicas. Venga a pasear, comer, merendar o tomar un aperitivo."
    ],
    "nl": [
      "De Avenières bergweide verwelkomt je van mei tot oktober. Een authentiek bergchalet voor levensgenieters en bergliefhebbers, met een adembenemend panoramisch uitzicht. Kom voor een wandeling, een lunch, een snack of een aperitief."
    ]
  },
