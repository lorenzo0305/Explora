  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/84e0b457-b791-373a-ae8b-b275404dcc63",
      "dc:description": {
        "de": [
          "Informationen :\nClick and Collect\nBesuchen Sie die Facebook-Seite, um zu erfahren, welche Artikel zum Verkauf stehen.\n\nBestellung :\n\nin einer privaten Facebook-Nachricht\noder als Kommentar zu den Artikeln auf Facebook\n\nAbholung:\nZum Mitnehmen im Laden nach einem bei der Bestellung festgelegten Zeitfenster.\n\n "
        ],
        "en": [
          "Informations :\nClick and collect\nVisit our Facebook page to see what's on sale.\n\nHow to order :\n\nin a private Facebook message\nor comment on articles on Facebook\n\nPick-up:\nTo take away at the store according to a time slot defined when ordering.\n\n "
        ],
        "it": [
          "Informazioni :\nClicca e ritira\nVisitate la nostra pagina Facebook per vedere i prodotti in vendita.\n\nCome ordinare :\n\nin un messaggio privato su Facebook\no commentando gli articoli su Facebook\n\nRitiro:\nDa ritirare in negozio secondo una fascia oraria definita al momento dell'ordine.\n\n "
        ],
        "fr": [
          "Informations :\nClick and collect\nConsultez la page Facebook pour connaitre les articles en vente.\n\nCommande :\n\nen message privé Facebook\nou en commentaire des articles sur Facebook\n\nRetrait :\nÀ emporter au magasin selon un créneau défini lors de la commande.\n\n "
        ],
        "nl": [
          "Informatie :\nKlikken en ophalen\nBezoek onze Facebook-pagina om te zien wat er te koop is.\n\nHoe te bestellen :\n\nin een privé Facebook bericht\nof reageer op artikelen op Facebook\n\nAfhalen:\nOm af te halen in de winkel volgens een tijdslot dat bij de bestelling is vastgelegd.\n\n "
        ],
        "es": [
          "Información :\nClick and collect\nVisita nuestra página de Facebook para ver lo que está a la venta.\n\nCómo hacer un pedido :\n\nen un mensaje privado de Facebook\no comentando artículos en Facebook\n\nRecogida:\nPara llevar a la tienda según una franja horaria definida al hacer el pedido.\n\n "
        ]
      },
