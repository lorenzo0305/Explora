  "rdfs:comment": {
    "de": [
      "Das Hotel-Restaurant befindet sich in einem ruhigen Dorf in den Combrailles, nur einen Steinwurf vom Château Rocher entfernt, einer mittelalterlichen Festung, die über die Sioule-Schluchten und ihre Mäander wacht."
    ],
    "en": [
      "Hotel Restaurant located in a quiet village of the Combrailles, a stone's throw from Château Rocher, a medieval fortress that watches over the Sioule Gorges and its meanders."
    ],
    "it": [
      "L'hotel ristorante si trova nel tranquillo villaggio di Combrailles, a due passi da Château Rocher, una fortezza medievale che sorveglia i meandri delle gole della Sioule."
    ],
    "fr": [
      "Hôtel Restaurant situé au calme dans un village des Combrailles, à deux pas du château Rocher, forteresse médiévale qui veille sur les gorges de la Sioule et ses méandres."
    ],
    "es": [
      "Hotel restaurante situado en un tranquilo pueblo de Combrailles, a dos pasos del Château Rocher, fortaleza medieval que vigila los meandros de las gargantas del Sioule."
    ],
    "nl": [
      "Hotel Restaurant ligt in een rustig dorpje in Combrailles, op een steenworp afstand van Château Rocher, een middeleeuws fort dat uitkijkt over de meanderende kloven van de Sioule."
    ]
  },
