  "rdfs:comment": {
    "de": [
      "Das Hotel liegt in der Nähe der A43, zwischen Pont de Beauvoisin und St Genix les Villages, und ist auf dem Weg in den Urlaub leicht zu erreichen. Genießen Sie eine Pause, bevor Sie in die Alpen fahren, den Komfort dieses Familienhotels aus dem Jahr 2024."
    ],
    "en": [
      "Located close to the A43 motorway, between Pont de Beauvoisin and St Genix les Villages, the hotel is easily accessible on the vacation route. Enjoy the comfort of this family-run hotel, built in 2024, for a break before heading off to the Alps."
    ],
    "it": [
      "Situato vicino alla A43, tra Pont de Beauvoisin e St Genix les Villages, l'hotel è facilmente raggiungibile lungo l'itinerario delle vacanze. Godetevi il comfort di questo hotel a conduzione familiare, costruito nel 2024, per una pausa prima di partire per le Alpi."
    ],
    "fr": [
      "Situé à proximité de l'A43, entre Pont de Beauvoisin et St Genix les Villages, l'hôtel est facilement accessible sur la route des vacances. Savourez le temps d'une pause avant de rejoindre les Alpes, le confort de cet hôtel familial datant de 2024."
    ],
    "es": [
      "Situado cerca de la A43, entre Pont de Beauvoisin y St Genix les Villages, el hotel es fácilmente accesible en la ruta de vacaciones. Disfrute de la comodidad de este hotel familiar, construido en 2024, para descansar antes de dirigirse a los Alpes."
    ],
    "nl": [
      "Het hotel ligt dicht bij de A43, tussen Pont de Beauvoisin en St Genix les Villages, en is gemakkelijk bereikbaar via de vakantieroute. Geniet van het comfort van dit familiehotel, gebouwd in 2024, voor een pauze voordat je naar de Alpen trekt."
    ]
  },
  "rdfs:label": {
