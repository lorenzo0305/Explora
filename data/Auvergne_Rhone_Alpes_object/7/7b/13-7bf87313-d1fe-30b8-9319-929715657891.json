  "rdfs:comment": {
    "de": [
      "Begeben Sie sich mit Ihrer Familie auf eine Spazierfahrt, bei der Sie die Geschichte und den natürlichen Reichtum des Lac de Monteynard entdecken können!\r\nGehen Sie in Savel oder Treffort an Bord."
    ],
    "en": [
      "Let's board with your family on La Mira boat for a unique cruise, ideal to discover the history and all the natural ressources of Monteynard lake !"
    ],
    "it": [
      "Portate tutta la famiglia in crociera a piedi alla scoperta della storia e delle ricchezze naturali del Lago di Monteynard!\r\nImbarco a Savel o a Treffort."
    ],
    "fr": [
      "Embarquez en famille pour une croisière promenade qui vous fera découvrir l'histoire et les richesses naturelles du Lac de Monteynard ! \r\nEmbarquement à Savel ou Treffort."
    ],
    "nl": [
      "Uniek gebied in Frankrijk, enkel per boot te ontdekken, over dag en 's nachts, met een groep of onder vrienden, de cruis La Mire past zich aan aan uw verlangen."
    ],
    "es": [
      "Lleve a toda la familia a un crucero a pie para descubrir la historia y las riquezas naturales del lago de Monteynard\r\nEmbarque en Savel o Treffort."
    ]
  },
