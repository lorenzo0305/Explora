  "rdfs:comment": {
    "de": [
      "In Zusammenarbeit mit Les Écrans, dem Verband der unabhängigen Kinos in der Drôme und Ardèche, findet dieses Jahr die 23. Ausgabe des Dokumentarfilm-Frühlings statt, mit einer Auswahl an Filmen und Sondervorstellungen!"
    ],
    "en": [
      "In partnership with Les Écrans, an association of independent cinemas in Drôme and Ardèche, this year marks the 23rd edition of Printemps Documentaire, with a selection of films and special screenings!"
    ],
    "it": [
      "In collaborazione con Les Écrans, associazione di cinema indipendenti della Drôme e dell'Ardèche, quest'anno si svolge il 23° Printemps Documentaire, con una selezione di film e proiezioni speciali!"
    ],
    "fr": [
      "En partenariat avec Les Écrans, association de cinémas indépendants de Drôme et Ardèche, retrouvez cette année la 23e édition du Printemps Documentaire, avec une sélection de films et séances spéciales !"
    ],
    "nl": [
      "In samenwerking met Les Écrans, een vereniging van onafhankelijke bioscopen in de Drôme en Ardèche, vindt dit jaar de 23e Printemps Documentaire plaats, met een selectie films en speciale voorstellingen!"
    ],
    "es": [
      "En colaboración con Les Écrans, asociación de cines independientes de Drôme y Ardèche, este año se celebra la 23ª edición del Printemps Documentaire, con una selección de películas y proyecciones especiales"
    ]
  },
  "rdfs:label": {
