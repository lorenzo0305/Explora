  "rdfs:comment": {
    "de": [
      "Außergewöhnlicher Rahmen zwischen Weinbergen und Wald, Familienrestaurant, Menü \"Terroir au rythme du marché\" , \"casse-croute\", \"goûter\". Lokale und regionale Produkte in allen Variationen zubereitet."
    ],
    "en": [
      "Exceptional setting between vines and forest, family restaurant, \"Terroir au rythme du marché\" \"casse-croute” and \"goûter” menus. Local and regional products cooked in all its forms."
    ],
    "it": [
      "Ambiente eccezionale tra il vigneto e la foresta, ristorante familiare, menu \"Terroir au rythme du marché\", \"casse-croute\", \"goûter\". Prodotti locali e regionali cucinati in tutte le loro forme."
    ],
    "fr": [
      "Cadre exceptionnel entre la vigne et la forêt, restaurant familial, menu \"Terroir au rythme du marché\" ,\"casse-croute\",\"goûter\". Des produits locaux et régionaux cuisinés sous toutes leurs formes."
    ],
    "nl": [
      "Uitzonderlijke omgeving tussen de wijngaard en het bos, familierestaurant, menu \"Terroir au rythme du marché\", \"casse-croute\", \"goûter\". Lokale en regionale producten in al hun vormen gekookt."
    ],
    "es": [
      "Entorno excepcional entre el viñedo y el bosque, restaurante familiar, menú \"Terroir au rythme du marché\", \"casse-croute\", \"goûter\". Productos locales y regionales cocinados en todas sus formas."
    ]
  },
