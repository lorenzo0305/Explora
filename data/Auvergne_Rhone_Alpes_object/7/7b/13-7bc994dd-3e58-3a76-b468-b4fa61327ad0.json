  "rdfs:comment": {
    "de": [
      "Hallenbad, ganzjährig geöffnet (außer in der Zeit der Energieeinsparung) und den ganzen Sommer über: Grünflächen im Freien im Sommer mit zahlreichen Kinderanimationen plus Snack. Aquafitness-Aktivitäten das ganze Jahr über."
    ],
    "en": [
      "Indoor, heated swimming pool. Supervised bathing. Late nights Friday and Saturday. Snack bar."
    ],
    "it": [
      "Piscina coperta, aperta tutto l'anno (tranne nei periodi di risparmio energetico) e per tutta l'estate: aree verdi esterne in estate con molte attività per bambini e snack bar. Attività di fitness in acqua tutto l'anno."
    ],
    "fr": [
      "Piscine couverte, ouverte toute l'année (hors période de sobriété énergétique) et tout l'été : Espaces verts en extérieur l'été avec nombreuses animations enfants plus Snack. Activités aquaformes toute l'année."
    ],
    "es": [
      "Piscina cubierta, abierta todo el año (excepto en periodos de ahorro energético) y durante todo el verano: zonas verdes al aire libre en verano con muchas actividades infantiles y bar de aperitivos. Actividades de aquafitness durante todo el año."
    ],
    "nl": [
      "Overdekt zwembad, het hele jaar door geopend (behalve tijdens de spaarperiode) en de hele zomer: in de zomer speelterreinen buiten met veel activiteiten voor kinderen en snackbar. Het hele jaar door aquafitnessactiviteiten."
    ]
  },
  "rdfs:label": {
    "en": [
      "Piscine des Collines"
    ],
    "fr": [
      "Piscine des Collines"
    ]
  },
