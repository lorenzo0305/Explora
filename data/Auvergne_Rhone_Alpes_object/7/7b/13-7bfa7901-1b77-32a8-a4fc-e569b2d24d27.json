  "rdfs:comment": {
    "de": [
      "Die Fédération Française de Gymnastique hat den Enfants de Devoir aus Oyonnax die Organisation einer französischen Meisterschaft im Einzelturnen anvertraut. Kunstturnen für Männer und Frauen."
    ],
    "en": [
      "The French Gymnastics Federation has entrusted Les Enfants de Devoir d?Oyonnax with the organization of a French Individual Gymnastics Championship. Men's and women's artistic gymnastics."
    ],
    "it": [
      "La Federazione Francese di Ginnastica ha affidato a Les Enfants de Devoir d'Oyonnax l'organizzazione di un Campionato Francese di Ginnastica Individuale. Ginnastica artistica maschile e femminile."
    ],
    "fr": [
      "La Fédération Française de Gymnastique a confié aux Enfants de Devoir d’Oyonnax, l’organisation d’un championnat de France de Gymnastique Individuelle. Gymnastique artistique masculine et féminine."
    ],
    "es": [
      "La Federación Francesa de Gimnasia ha confiado a Les Enfants de Devoir d'Oyonnax la organización de un Campeonato de Francia de Gimnasia Individual. Gimnasia artística masculina y femenina."
    ],
    "nl": [
      "De Franse Gymnastiek Federatie heeft Les Enfants de Devoir d?Oyonnax belast met de organisatie van een Frans Kampioenschap Individuele Gymnastiek. Mannen en vrouwen artistieke gymnastiek."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Championnat de France de Gymnastique"
    ]
  },
