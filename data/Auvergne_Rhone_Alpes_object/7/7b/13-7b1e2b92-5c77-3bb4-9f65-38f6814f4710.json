  "rdfs:comment": {
    "de": [
      "Le Mazier, Ameisenhaufen im Patois Bourbonnais, ist ein Ort des Lebens mit einem Vereinscafé, einem Ort der Mediation, einem Fablab und einem gemeinsamen Arbeitsbereich."
    ],
    "en": [
      "Le Mazier, an anthill in Bourbonnais patois, is a place to live with an associative café, a place of mediation, a fablab and a shared work space."
    ],
    "it": [
      "Le Mazier, che in dialetto Bourbonnais significa \"formicaio\", è un luogo di vita con un caffè associativo, un centro di mediazione, un fablab e uno spazio di lavoro condiviso."
    ],
    "fr": [
      "Le Mazier, fourmilière en patois bourbonnais, est un lieu de vie avec un café associatif, un lieu de médiation, un fablab et un espace de travail partagé."
    ],
    "nl": [
      "Le Mazier, wat in het Bourbonnais \"mierenhoop\" betekent, is een plek van leven met een associatief café, een bemiddelingscentrum, een fablab en een gedeelde werkruimte."
    ],
    "es": [
      "Le Mazier, que significa \"hormiguero\" en dialecto bourbonés, es un lugar de vida con un café asociativo, un centro de mediación, un fablab y un espacio de trabajo compartido."
    ]
  },
  "rdfs:label": {
