  "rdfs:comment": {
    "de": [
      "Die Bibliothek von Lumbin ist für alle offen. Sie können vor Ort kostenlos in Büchern und Zeitschriften stöbern, sich Lesetipps geben lassen und Vorschläge für Anschaffungen machen. Mit der Anmeldung können Sie Dokumente ausleihen"
    ],
    "en": [
      "The Lumbin library is open to all. You can consult books and magazines free of charge on site, ask for reading advice and make suggestions for purchases. Registration allows you to borrow documents"
    ],
    "it": [
      "La biblioteca di Lumbin è aperta a tutti. È possibile consultare gratuitamente libri e riviste in loco, chiedere consigli di lettura e suggerire acquisti. La registrazione consente di prendere in prestito documenti"
    ],
    "fr": [
      "La bibliothèque de Lumbin est ouverte à tous. Vous pouvez consulter sur place et gratuitement les livres et magazines, demander des conseils de lecture et faire des suggestions d’achat. L’inscription vous permet d’emprunter des documents"
    ],
    "es": [
      "La biblioteca de Lumbin está abierta a todos. Puede consultar gratuitamente libros y revistas in situ, pedir consejos de lectura y hacer sugerencias de compra. Registrarse le permite tomar prestados documentos"
    ],
    "nl": [
      "De bibliotheek van Lumbin is voor iedereen toegankelijk. Je kunt ter plekke gratis boeken en tijdschriften raadplegen, leesadvies vragen en suggesties doen voor aankopen. Na inschrijving kun je documenten lenen"
    ]
  },
