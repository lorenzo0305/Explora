  "rdfs:comment": {
    "de": [
      "Bergbegleiter, der begleitete Wanderungen für alle Niveaus, Nordic Walking und Wassergymnastik anbietet.\r\nSeine Spezialität: Nordic Walking und \"Indianerwinter\" (Indianerabenteuer, Schneeschuhe und Tipi)."
    ],
    "en": [
      "Mountain guide offering guided hikes at all levels, Nordic walking, aqua aerobics.\r\nSpecializes in Nordic walking and \"Indian winter\" (Indian adventures, snowshoes and tepees)."
    ],
    "it": [
      "Guida alpina che offre escursioni guidate a tutti i livelli, nordic walking e aquagym.\r\nSpecialità: nordic walking e \"inverno indiano\" (avventure indiane, racchette da neve e tepee)."
    ],
    "fr": [
      "Accompagnateur en montagne proposant des randonnées accompagnées tous niveaux, marche nordique, aquagym.\r\nSa spécialité : marche nordique et \"hiver indien\" (aventures indiennes, raquttes à neige et tipi)."
    ],
    "es": [
      "Guía de montaña que ofrece excursiones guiadas de todos los niveles, marcha nórdica y aquagym.\r\nEspecialidades: marcha nórdica e \"invierno indio\" (aventuras indias, raquetas de nieve y tipis)."
    ],
    "nl": [
      "Berggids biedt begeleide wandelingen op alle niveaus, nordic walking en aquagym.\r\nSpecialiteiten: nordic walking en \"Indian winter\" (indianenavonturen, sneeuwschoenen en tipi's)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Guillaume Gagnaire - Acc. en montagne"
    ]
  },
