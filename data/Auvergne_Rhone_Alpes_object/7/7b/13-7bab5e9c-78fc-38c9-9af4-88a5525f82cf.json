  "rdfs:comment": {
    "de": [
      "Von Sarras auf der Ardèche-Seite der Rhône aus werden Sie in schönen schattigen Bereichen schnell an Höhe gewinnen, bevor Sie zu den freieren Bereichen auf den oberen Hügeln gelangen."
    ],
    "en": [
      "Starting from Sarras on the Ardéchois side of the Rhône, you'll quickly gain height in beautiful shaded areas before moving on to the more open areas on the hilltops."
    ],
    "it": [
      "Partendo da Sarras, sul versante dell'Ardèche del Rodano, si guadagna rapidamente quota in alcune belle zone d'ombra prima di passare alle zone più aperte in cima alle colline."
    ],
    "fr": [
      "Au départ de Sarras sur le côté Ardéchois du Rhône, vous prendrez rapidement de la hauteur dans de belles zones ombragées avant de rejoindre les zones plus dégagées sur le haut des collines."
    ],
    "nl": [
      "Vanuit Sarras aan de Ardèche-kant van de Rhône kom je al snel hoger in een aantal mooie schaduwrijke gebieden voordat je verder gaat naar de meer open gebieden aan de top van de heuvels."
    ],
    "es": [
      "Partiendo de Sarras, en la vertiente ardèche del Ródano, ganará altura rápidamente en algunas zonas de sombra encantadoras antes de pasar a las zonas más abiertas de la cima de las colinas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les coteaux du Saint-Joseph"
    ]
  },
