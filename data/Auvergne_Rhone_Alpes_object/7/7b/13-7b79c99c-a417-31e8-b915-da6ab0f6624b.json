  "rdfs:comment": {
    "de": [
      "Das Hotel liegt ideal zwischen der Drôme des collines und den Portes de Provence und lädt Sie zu einem Gourmet-Urlaub zwischen Lavendel und Weinreben ein, ein Ort der Ruhe, weniger als 10 Mn von der Autobahn entfernt."
    ],
    "en": [
      "This hotel is an invitation to savour local flavours on your way between the Gorges of Ardèche and the land of lavender and wine. A haven of peace, less than 10 min away from the motorway."
    ],
    "it": [
      "Il Domaine des Oliviers vi accoglie in un ambiente raffinato e contemporaneo. Si trova in un parco verde."
    ],
    "fr": [
      "Le domaine des Oliviers vous accueille dans un cadre raffiné et contemporain. Il se situe dans un parc verdoyant."
    ],
    "nl": [
      "Ideaal gelegen tussen de heuvels van de Drôme en de poorten van de Provence, nodigt het hotel u uit om een gastronomische tussenstop te maken. Het is hier, tussen de Gorges de l’Ardèche (canyon) en het land van de lavendel en de wijngaarden, waar u een oase van rust treft, op minder dan 10 minuten van de snelweg."
    ],
    "es": [
      "El Domaine des Oliviers le da la bienvenida en un ambiente refinado y contemporáneo. Está situado en un parque verde."
    ]
  },
