      "dc:description": {
        "de": [
          "Handwerkliche Herstellung\n\nWanddekorationen aus Makramee, Schmuck mit Natursteinen\nJeden Donnerstagmorgen auf dem Markt in Rang-du-Fliers vertreten"
        ],
        "en": [
          "Handcrafted products\n\nMacramé wall decorations, jewelry with natural stones\nPresent at Rang-du-Fliers market every Thursday morning"
        ],
        "it": [
          "Prodotti artigianali\n\nDecorazioni murali in macramè, gioielli con pietre naturali\nPresente al mercato di Rang-du-Fliers ogni giovedì mattina"
        ],
        "fr": [
          "Fabrication artisanale\n\nDécorations murales en macramé, bijoux avec pierres naturelles\nPrésente sur le marché de Rang-du-Fliers chaque jeudi matin"
        ],
        "es": [
          "Productos artesanales\n\nDecoraciones murales de macramé, joyas con piedras naturales\nPresente en el mercado de Rang-du-Fliers todos los jueves por la mañana"
        ],
        "nl": [
          "Handgemaakte producten\n\nMacramé wanddecoraties, sieraden met natuurstenen\nElke donderdagochtend aanwezig op de Rang-du-Fliers markt"
        ]
      },
