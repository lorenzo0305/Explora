  "rdfs:comment": {
    "de": [
      "Das Saisonbüro in Saint-Saturnin befindet sich im Herzen der Petite Cité de Caractère®, weniger als 30 km südlich von Clermont-Ferrand. Unsere Aufenthaltsberater empfangen die Besucher vom 22. Juni bis zum 8. September."
    ],
    "en": [
      "The Saint-Saturnin seasonal office is located in the heart of the Petite Cité de Caractère®, less than 30 km south of Clermont-Ferrand. Our holiday advisors welcome visitors from 22 June to 8 September."
    ],
    "it": [
      "L'ufficio stagionale di Saint-Saturnin si trova nel cuore della Petite Cité de Caractère®, a meno di 30 km a sud di Clermont-Ferrand. I nostri consulenti per le vacanze accolgono i visitatori dal 22 giugno all'8 settembre."
    ],
    "fr": [
      "Le bureau saisonnier de Saint-Saturnin est situé au cœur de la Petite Cité de Caractère®, à moins de 30 km au sud de Clermont-Ferrand. Nos conseillers en séjours accueillent les visiteurs du 22 juin au 8 septembre."
    ],
    "es": [
      "La oficina de temporada de Saint-Saturnin está situada en el corazón de la Petite Cité de Caractère®, a menos de 30 km al sur de Clermont-Ferrand. Nuestros asesores de vacaciones reciben a los visitantes del 22 de junio al 8 de septiembre."
    ],
    "nl": [
      "Het seizoenskantoor van Saint-Saturnin ligt in het hart van de Petite Cité de Caractère®, op minder dan 30 km ten zuiden van Clermont-Ferrand. Onze vakantieadviseurs verwelkomen bezoekers van 22 juni tot 8 september."
    ]
  },
