  "rdfs:comment": {
    "de": [
      "Im Stade Pompidou findet das 14. Spiel der Saison zwischen den Mannschaften von Valencia und Brive statt. Die beiden Vereine mit ihren jeweiligen Geschichten und Leidenschaften bereiten sich darauf vor, ein energiegeladenes und spannendes Spektakel zu bieten."
    ],
    "en": [
      "The Stade Pompidou will play host to the 14th match of the season between Valencia and Brive. The two clubs, with their respective histories and passions, are preparing to put on a show full of energy and suspense."
    ],
    "it": [
      "Lo Stade Pompidou ospiterà la 14ª partita della stagione tra Valencia e Brive. I due club, con le rispettive storie e passioni, si preparano a dare vita a uno spettacolo pieno di energia e suspense."
    ],
    "fr": [
      "Le stade Pompidou accueillera le 14ème match de la saison entre les équipes de Valence et Brive. Les deux clubs, avec leurs histoires et leurs passions respectives, se préparent à offrir un spectacle plein d'énergie et de suspense."
    ],
    "nl": [
      "Het Stade Pompidou zal gastheer zijn voor de 14e wedstrijd van het seizoen tussen Valencia en Brive. De twee clubs, met hun respectievelijke geschiedenis en passies, bereiden zich voor op een show vol energie en spanning."
    ],
    "es": [
      "El Stade Pompidou acogerá el 14º partido de la temporada entre el Valencia y el Brive. Los dos clubes, con sus respectivas historias y pasiones, se preparan para ofrecer un espectáculo lleno de energía y suspense."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Match VRDR vs Brive"
    ]
  },
