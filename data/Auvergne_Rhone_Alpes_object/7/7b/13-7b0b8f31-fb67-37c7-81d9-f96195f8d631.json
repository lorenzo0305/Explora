  "rdfs:comment": {
    "de": [
      "Kommen Sie zahlreich zur Konferenz \"Des archives bien hospitalières?\" von Julien Mathieu und machen Sie eine Tour d'Horizon durch die Archive, die für die Familien- und Gesundheitsgeschichte und allgemein für die lokale Geschichte von großer Bedeutung sind."
    ],
    "en": [
      "Come along to Julien Mathieu's talk \"Des archives bien hospitalières?\", and take a tour of archives that are essential to the history of families, healthcare and local history in general."
    ],
    "it": [
      "Partecipate alla conferenza di Julien Mathieu, \"Des archives bien hospitalières?\", e visitate gli archivi che sono essenziali per la storia delle famiglie, della salute e della storia locale in generale."
    ],
    "fr": [
      "Venez nombreux pour la conférence \"Des archives bien hospitalières…\" par Julien Mathieu, et faites un tour d'horizon d'archives essentielles pour l'histoire des familles, de la santé et plus généralement pour l'histoire locale."
    ],
    "nl": [
      "Kom naar de lezing van Julien Mathieu, \"Des archives bien hospitalières?\", en maak een rondleiding door archieven die essentieel zijn voor de geschiedenis van families, gezondheid en lokale geschiedenis in het algemeen."
    ],
    "es": [
      "Asista a la conferencia de Julien Mathieu, \"Archivos bien hospitalarios\", y haga un recorrido por unos archivos esenciales para la historia de las familias, la salud y la historia local en general."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Conférence : Des archives bien hospitalières ..."
    ]
  },
