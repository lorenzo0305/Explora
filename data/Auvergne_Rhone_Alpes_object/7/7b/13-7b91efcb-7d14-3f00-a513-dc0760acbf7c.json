  "rdfs:comment": {
    "de": [
      "Menüs zur Entdeckung der türkischen Kultur und Gastronomie.\r\nKüche mit Holzfeuer.\r\nTagesgerichte, Frühstück, traditionelle Gerichte.\r\nGrilltische, an denen man sein eigenes Fleisch zubereiten kann."
    ],
    "en": [
      "Menus to discover Turkish culture and gastronomy.\r\nWood-fired cooking.\r\nDaily specials, breakfasts, traditional dishes.\r\nBarbecue tables for cooking your own meat."
    ],
    "it": [
      "Menu per scoprire la cultura e la gastronomia turca.\r\nCucina a legna.\r\nSpecialità giornaliere, colazioni, piatti tradizionali.\r\nTavoli da barbecue per cucinare la propria carne."
    ],
    "fr": [
      "Menus à la découverte de la culture et la gastronomie turque.\r\nCuisine au feu de bois.\r\nPlats du jour, petits déjeuners, plats traditionnels.\r\nTables de barbecue pour faire cuire sa propre viande."
    ],
    "nl": [
      "Menu's om de Turkse cultuur en gastronomie te ontdekken.\r\nHoutgestookte keuken.\r\nDagschotels, ontbijt, traditionele gerechten.\r\nBarbecuetafels om je eigen vlees te bereiden."
    ],
    "es": [
      "Menús para descubrir la cultura y la gastronomía turcas.\r\nCocina de leña.\r\nEspecialidades del día, desayunos, platos tradicionales.\r\nMesas de barbacoa para cocinar su propia carne."
    ]
  },
  "rdfs:label": {
