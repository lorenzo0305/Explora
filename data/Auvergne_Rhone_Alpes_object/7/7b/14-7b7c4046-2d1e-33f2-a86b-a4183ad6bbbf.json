  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/50541568-1ae7-35b6-ae8a-fcb06fa2fd45",
      "dc:description": {
        "de": [
          "Für diesen Sommer bietet Ihnen der Tischtennisverein von Etaples-sur-Mer seine Turniere an!\nOffen für alle, Lizenzierte, Nichtlizenzierte und Jugendliche...\nTreten Sie gegeneinander an und amüsieren Sie sich dabei!"
        ],
        "en": [
          "For this summer, the Etaples-sur-Mer Table Tennis Association is offering you their tournaments!\nOpen to all, members, non-members and youngsters...\nCome and join in the fun!"
        ],
        "it": [
          "Quest'estate, l'Associazione di tennis da tavolo di Etaples-sur-Mer organizza una serie di tornei!\nAperto a tutti, soci, non soci e giovani...\nVenite a giocare contro gli altri e a divertirvi!"
        ],
        "fr": [
          "Pour cet été, l'association de Tennis de table d'Etaples-sur-Mer vous propose leurs tournois !\nOuvert à tous, licenciés, non licenciés et jeunes...\nVenez vous affronter tout en vous amusant !"
        ],
        "es": [
          "Este verano, la Asociación de Tenis de Mesa de Etaples-sur-Mer organiza una serie de torneos\nAbierto a todos, socios, no socios y jóvenes...\n¡Vengan a jugar unos contra otros y diviértanse!"
        ],
        "nl": [
          "Deze zomer organiseert de tafeltennisvereniging van Etaples-sur-Mer een reeks toernooien!\nOpen voor iedereen, leden, niet-leden en jongeren...\nKom tegen elkaar spelen en maak plezier!"
        ]
      },
