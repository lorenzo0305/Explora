  "rdfs:comment": {
    "de": [
      "BIO-Mikro-Bauernhof in einem 12 Hektar großen öffentlichen Park mit freiem und kostenlosem Zugang. Entdecken Sie einen Selbsterntegarten, beobachten Sie die Tiere auf dem Bauernhof, genießen Sie das Café eines kleinen Imbisses und gehen Sie mit Ihrem extra frischen Gemüse nach Hause."
    ],
    "en": [
      "Organic micro-farm in a 12-hectare public park with free access. Come and discover a pick-your-own garden, observe the farm's animals, enjoy coffee and snacks, and leave with your own extra-fresh vegetables."
    ],
    "it": [
      "Accesso gratuito a una microfattoria biologica in un parco pubblico di 12 ettari. Venite a scoprire l'orto, osservate gli animali della fattoria, godetevi uno snack bar e andate via con le vostre verdure fresche."
    ],
    "fr": [
      "Micro-ferme BIO dans un parc public de 12 hectares en accès libre et gratuit. Venez découvrir un jardin en auto-cueillette, observer les animaux de la ferme, profiter du café d'une petite restauration et repartez avec vos légumes extra frais."
    ],
    "nl": [
      "Een biologische microboerderij in een openbaar park van 12 hectare met gratis toegang. Kom en ontdek een pluktuin, observeer de dieren van de boerderij, geniet van een snackbar en vertrek met je eigen extra verse groenten."
    ],
    "es": [
      "Acceso gratuito a una microgranja ecológica en un parque público de 12 hectáreas. Venga a descubrir un huerto de cosecha propia, observe los animales de la granja, disfrute de un merendero y váyase con sus propias verduras extrafrescas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La ferme du Forezan"
    ]
  },
