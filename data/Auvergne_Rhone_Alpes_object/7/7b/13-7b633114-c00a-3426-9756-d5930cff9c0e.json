  "rdfs:comment": {
    "de": [
      "Route, die zur Barmettes-Hütte und darüber hinaus in das Hochgebirgsgebiet führt.\r\n> Start von Pont de Cavin (Höhenunterschied 600m) oder von Les Fontanettes (Höhenunterschied 400m)."
    ],
    "en": [
      "This route takes you to Les Barmettes Hut, and then beyond the ski area boundary into the high mountains. \r\n> Start at Pont de Cavin bridge (600m vertical gain) or Les Fontanettes (400m vertical gain)."
    ],
    "it": [
      "Itinerario che consente l'accesso al rifugio Barmettes e, oltre, alla zona di alta montagna.\r\n> Partenza dal Pont de Cavin (dislivello 600 m) o da Les Fontanettes (dislivello 400 m)."
    ],
    "fr": [
      "Itinéraire permettant d’accéder au refuge des Barmettes, et au-delà, au domaine haute montagne.\r\n> Départ du Pont de Cavin (dénivelé 600m) ou des Fontanettes (dénivelé 400m)."
    ],
    "nl": [
      "Route die toegang geeft tot de Barmettes refuge, en verder tot het hooggebergte.\r\n> Vertrek vanaf de Pont de Cavin (hoogteverschil 600m) of Les Fontanettes (hoogteverschil 400m)."
    ],
    "es": [
      "Itinerario de acceso al refugio de Les Barmettes ─entre otros lugares─ en la zona de alta montaña\r\n> Salida desde el puente de Cavin (600 m de desnivel) o Les Fontanettes (400 m de desnivel)."
    ]
  },
  "rdfs:label": {
