  "rdfs:comment": {
    "de": [
      "Am Fuße der Kirche, im Herzen des Dorfes, bieten Ihnen Audrey und Mickaël eine hausgemachte Küche, die je nach Jahreszeit variiert"
    ],
    "en": [
      "At the foot of the church, in the heart of the village, Audrey and Mickaël offer you a home cooking which varies according to the seasons"
    ],
    "it": [
      "Ai piedi della chiesa, nel cuore del villaggio, Audrey e Mickaël vi propongono una cucina casalinga che varia a seconda della stagione"
    ],
    "fr": [
      "Au pied de l’église, au cœur du village, Audrey et Mickaël vous propose une cuisine maison qui varie au fil des saisons"
    ],
    "es": [
      "Al pie de la iglesia, en el corazón del pueblo, Audrey y Mickaël le ofrecen una cocina casera que varía según la temporada"
    ],
    "nl": [
      "Aan de voet van de kerk, in het hart van het dorp, bieden Audrey en Mickaël u een huisgemaakte keuken die varieert naargelang het seizoen"
    ]
  },
