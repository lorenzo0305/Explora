  "rdfs:comment": {
    "de": [
      "Ihre neue Gourmet-Ecke, um Tapas zu genießen!\r\nStellen Sie sich Ihr eigenes Brett zusammen und lassen Sie sich in der symbolträchtigen Bar \"La Bastille\" nieder.\r\nUnsere Küche ist von mediterranen Aromen inspiriert und wir bevorzugen frische und qualitativ hochwertige Zutaten."
    ],
    "en": [
      "Your new gourmet spot for tapas!\r\nMake up your own board and sit down at the emblematic \"La Bastille\" bar.\r\nOur cuisine is inspired by Mediterranean flavors, and we favor fresh, quality ingredients."
    ],
    "it": [
      "Il vostro nuovo punto di ristoro per le tapas!\r\nComponete la vostra tavola e sedetevi all'emblematico bar \"La Bastille\".\r\nLa nostra cucina si ispira ai sapori mediterranei e privilegia ingredienti freschi e di qualità."
    ],
    "fr": [
      "Votre nouveau coin gourmand pour savourer des tapas ! \r\nComposer votre propre planche et installez-vous au bar emblématique « La Bastille ».\r\nNotre cuisine s’inspire des saveurs méditerranéennes, et nous privilégions des ingrédients frais et de qualité."
    ],
    "es": [
      "¡Su nuevo lugar gourmet para tapear!\r\nConfeccione su propia tabla y siéntese en el emblemático bar \"La Bastille\".\r\nNuestra cocina se inspira en los sabores mediterráneos y privilegia los ingredientes frescos y de calidad."
    ],
    "nl": [
      "Je nieuwe gastronomische plek voor tapas!\r\nStel je eigen bord samen en neem plaats aan de emblematische bar \"La Bastille\".\r\nOnze keuken is geïnspireerd op mediterrane smaken en we geven de voorkeur aan verse ingrediënten van hoge kwaliteit."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Tapas é Basta"
    ]
  },
