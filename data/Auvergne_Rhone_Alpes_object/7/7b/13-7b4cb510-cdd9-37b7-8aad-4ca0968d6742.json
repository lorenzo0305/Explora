  "rdfs:comment": {
    "de": [
      "Dorf Chassignolles: Ruinen einer Burg: Es gibt noch zwei große Rundtürme und einen quadratischen Turm (Stadtmauer aus dem 13. Jahrhundert). Romanische Kirche mit Reliquienjungfrau aus dem 12. Jahrhundert und geschnitztem Portal. Kreuz von Mandarat."
    ],
    "en": [
      "Village of Chassignolles: Castle ruins: 2 large round towers and a square tower (13th-century enclosure). Romanesque church with 12th-century reliquary virgin and sculpted portal. Mandarat cross."
    ],
    "it": [
      "Villaggio di Chassignolles: rovine del castello: 2 grandi torri rotonde e una torre quadrata (recinto del XIII secolo). Chiesa romanica con vergine reliquiario del XII secolo e portale scolpito. Croce di Mandarat."
    ],
    "fr": [
      "Village de Chassignolles : Ruines d’un château : subsistent 2 grosses tours rondes et une tour carrée (enceinte du XIIIe siècle). Église romane avec vierge reliquaire du XIIe siècle et portail sculpté. Croix de Mandarat."
    ],
    "es": [
      "Pueblo de Chassignolles: Ruinas del castillo: 2 grandes torres redondas y una torre cuadrada (recinto del siglo XIII). Iglesia románica con virgen relicario del siglo XII y portal esculpido. Cruz de Mandarat."
    ],
    "nl": [
      "Dorp Chassignolles: Kasteelruïnes: 2 grote ronde torens en een vierkante toren (13e-eeuwse omheining). Romaanse kerk met reliekschrijn uit de 12e eeuw en gebeeldhouwd portaal. Mandarat kruis."
    ]
  },
