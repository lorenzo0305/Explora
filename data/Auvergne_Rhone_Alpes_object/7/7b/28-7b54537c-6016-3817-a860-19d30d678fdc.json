  "rdfs:comment": {
    "de": [
      "Im Herzen des Gemeindewaldes von Hirson, nur wenige Schritte von der belgischen Grenze entfernt, macht die Oise einen Sprung. Der Ort ist wie geschaffen für einen erfrischenden Spaziergang mit der ganzen Familie!"
    ],
    "en": [
      "In the heart of the communal forest of Hirson, a stone's throw from the Belgian border, the river Oise makes a jump. The place is perfect for a refreshing walk with the family!"
    ],
    "it": [
      "Nel cuore della foresta comunale di Hirson, a due passi dal confine belga, il fiume Oise fa un salto. Il luogo è perfetto per una passeggiata rinfrescante in famiglia!"
    ],
    "fr": [
      "Au coeur de la forêt communale d'Hirson, à deux pas de la frontière belge, l'Oise fait un saut. L'endroit est propice pour une rafraîchissante balade en famille !"
    ],
    "nl": [
      "In het hart van het gemeentebos van Hirson, op een boogscheut van de Belgische grens, maakt de Oise een sprong. De plek is perfect voor een verfrissende gezinswandeling!"
    ],
    "es": [
      "En el corazón del bosque municipal de Hirson, a un paso de la frontera belga, el río Oise da un salto. El lugar es perfecto para un refrescante paseo en familia"
    ]
  },
  "rdfs:label": {
