  "rdfs:comment": {
    "de": [
      "Espace VTTN°1 hat sich die Förderung und Organisation von sportlichen Aktivitäten in der freien Natur für alle innerhalb des Ballungsraums Pays d'Issoire zum Ziel gesetzt. Verleih von Mountainbikes, Verleih von Elektrorollern, Orientierungslauf und Unterkünfte."
    ],
    "en": [
      "Espace VTTN°1 promotes and organizes outdoor sports activities for everyone in the Pays d'Issoire urban area. Mountain bike hire, electric scooter hire, orienteering and accommodation."
    ],
    "it": [
      "L'Espace VTTN°1 promuove e organizza attività sportive all'aperto per tutti nell'area urbana del Pays d'Issoire. Noleggio di mountain bike, scooter elettrici, orienteering e alloggio."
    ],
    "fr": [
      "Espace VTTN°1 a pour vocation la promotion et l'organisation d'activités sportives de pleine nature, pour tous, au sein de l'Agglomération Pays d'Issoire. Location de VTT,   location de trottinettes électriques, course d'orientation et hébergements."
    ],
    "es": [
      "Espace VTTN°1 promueve y organiza actividades deportivas al aire libre para todos en la zona urbana de Pays d'Issoire. Alquiler de bicicletas de montaña, alquiler de patinetes eléctricos, orientación y alojamiento."
    ],
    "nl": [
      "Espace VTTN°1 promoot en organiseert buitensportactiviteiten voor iedereen in het stedelijke gebied Pays d'Issoire. Verhuur van mountainbikes, elektrische scooters, oriëntatieloop en accommodatie."
    ]
  },
