  "rdfs:comment": {
    "de": [
      "Als historisches Hotel in Aix-les-Bains markiert das Jahr 2024 die Wiedergeburt dieses 1863 eröffneten Hauses. Das Grand Hôtel du Parc**** ist ideal im Stadtzentrum gelegen, in einem dynamischen Einkaufsviertel mit vielen Feinschmeckern, und verspricht einen individuellen Aufenthalt."
    ],
    "en": [
      "A historic hotel in Aix-les-Bains, the year 2024 marks the rebirth of this hotel opened in 1863. Ideally located in the town center, in a dynamic shopping district, the Grand Hôtel du Parc**** is the promise of a personalized stay."
    ],
    "it": [
      "Storico hotel di Aix-les-Bains, il 2024 segna la rinascita di questo albergo aperto nel 1863. Situato in posizione ideale nel centro della città, in una zona commerciale dinamica, il Grand Hôtel du Parc**** promette un soggiorno personalizzato."
    ],
    "fr": [
      "Hôtel historique d'Aix-les-Bains, l'année 2024 marque la renaissance de cette maison ouverte en 1863. Idéalement situé en centre ville, dans un quartier commerçant dynamique et gourmand, le Grand Hôtel du Parc**** est la promesse d'un séjour personnalisé."
    ],
    "es": [
      "Hotel histórico de Aix-les-Bains, 2024 marca el renacimiento de este hotel inaugurado en 1863. Idealmente situado en el centro de la ciudad, en un dinámico barrio comercial, el Grand Hôtel du Parc**** promete una estancia personalizada."
    ],
    "nl": [
      "Een historisch hotel in Aix-les-Bains, 2024 markeert de wedergeboorte van dit hotel dat in 1863 werd geopend. Het Grand Hôtel du Parc**** is ideaal gelegen in het stadscentrum, in een dynamische winkelwijk, en belooft een persoonlijk verblijf."
    ]
  },
