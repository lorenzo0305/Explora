  "rdfs:comment": {
    "de": [
      "Bar-Café der Auberge Camping du Pont, eine Einrichtung am Ufer der Drôme. \r\nCampingplatz mit etwa hundert Stellplätzen und 4 Chalets , Gasthaus mit 5 Zimmern.\r\nKeine Verpflegung."
    ],
    "en": [
      "Bar-café at the Auberge Camping du Pont, located on the banks of the Drôme River. \r\nCampsite with around 100 pitches and 4 chalets, inn with 5 rooms.\r\nNo catering facilities."
    ],
    "it": [
      "Bar-caffetteria dell'Auberge Camping du Pont, sulle rive del fiume Drôme.\r\nCampeggio con un centinaio di piazzole e 4 chalet, locanda con 5 camere.\r\nNessun ristorante."
    ],
    "fr": [
      "Bar -café de l'Auberge Camping du Pont, établissement situé au bord de la rivière Drôme. \r\nCamping d'une centaine d'emplacements et 4 chalets , auberge avec 5 chambres.\r\nPas de restauration."
    ],
    "es": [
      "Bar-cafetería en el Auberge Camping du Pont, a orillas del río Drôme.\r\nCamping con un centenar de parcelas y 4 chalets, albergue con 5 habitaciones.\r\nSin restaurante."
    ],
    "nl": [
      "Bar-café van Auberge Camping du Pont, gelegen aan de oever van de rivier de Drôme. \r\nCamping met ongeveer honderd staanplaatsen en 4 chalets , herberg met 5 kamers.\r\nGeen restaurant."
    ]
  },
