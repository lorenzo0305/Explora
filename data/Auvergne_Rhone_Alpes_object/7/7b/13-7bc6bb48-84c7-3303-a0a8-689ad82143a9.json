  "rdfs:comment": {
    "de": [
      "Die Vinaigrerie de la Carrière stellt ihren Essig aus den Äpfeln her, die in ihren eigenen Obstgärten geerntet werden. Dank der Bewahrung des althergebrachten Know-hows wird eine breite Palette angeboten: von klassischem Essig bis hin zu Balsamico-Essig..."
    ],
    "en": [
      "La vinaigrerie de la Carrière prepares its vinegars from apples harvested in its own orchards. Thanks to the preservation of ancestral know-how, a wide range is offered: from classic vinegars to balsamic vinegars..."
    ],
    "it": [
      "La vinaigrerie de la Carrière produce i suoi aceti dalle mele raccolte nei propri frutteti. Grazie alla conservazione di un know-how ancestrale, viene offerta un'ampia gamma: dagli aceti classici a quelli balsamici..."
    ],
    "fr": [
      "La vinaigrerie de la Carrière prépare ses vinaigres à partir des pommes récoltées dans ses propres vergers. Grâce à la conservation des savoirs-faire ancestraux, une large gamme est proposée : des vinaigres classiques aux vinaigres balsamiques..."
    ],
    "nl": [
      "La vinaigrerie de la Carrière maakt haar azijnen van appels die in haar eigen boomgaarden worden geoogst. Dankzij het behoud van voorouderlijke knowhow wordt een breed assortiment aangeboden: van klassieke azijnen tot balsamico-azijnen..."
    ],
    "es": [
      "La vinaigrerie de la Carrière elabora sus vinagres a partir de manzanas cosechadas en sus propios huertos. Gracias a la conservación de un saber hacer ancestral, se ofrece una amplia gama: desde vinagres clásicos a vinagres balsámicos..."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Vinaigres de la Carrière"
    ]
  },
