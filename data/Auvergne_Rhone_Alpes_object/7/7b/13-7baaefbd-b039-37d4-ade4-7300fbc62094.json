  "rdfs:comment": {
    "de": [
      "Die Vereinigung der Bürgermeister hat zum Ziel, Freundschaftsbande zwischen allen ehemaligen gewählten Vertretern Bourbonnais zu knüpfen, die jahrelang im Dienste ihrer Bevölkerung gestanden haben."
    ],
    "en": [
      "The purpose of the Association of Mayors is to create bonds of friendship between all the former elected officials of Bourbonnais who have spent years serving their population."
    ],
    "it": [
      "L'Associazione dei Sindaci si propone di creare legami di amicizia tra tutti gli ex funzionari eletti del Bourbonnais che hanno trascorso anni al servizio della popolazione."
    ],
    "fr": [
      "L'association des Maires à pour but de créer des liens d'amitié entre tous les anciens élus bourbonnais ayant passé des années à servir leur population."
    ],
    "es": [
      "La Asociación de Alcaldes pretende crear lazos de amistad entre todos los antiguos cargos electos de Bourbonnais que han pasado años al servicio de su población."
    ],
    "nl": [
      "De vereniging van burgemeesters wil vriendschapsbanden creëren tussen alle voormalige verkozenen van de Bourbonnais die jarenlang hun bevolking hebben gediend."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Association des Anciens Maires et Présidents d'Intercommunalité de l'Allier"
    ]
  },
