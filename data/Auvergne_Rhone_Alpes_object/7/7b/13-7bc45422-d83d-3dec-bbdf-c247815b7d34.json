  "rdfs:comment": {
    "de": [
      "Sie suchen einen anregenden Arbeitsplatz, der Synergien fördert, und möchten Ihr Netzwerk erweitern?  Sie suchen einen Raum für Ihre Generalversammlung oder ein Meeting?  Willkommen im D5."
    ],
    "en": [
      "Are you looking for a stimulating, synergistic workspace and would like to expand your network?  Are you looking for a room to organize your general meeting or a meeting?  Welcome to D5."
    ],
    "it": [
      "Siete alla ricerca di uno spazio di lavoro stimolante e sinergico e volete ampliare il vostro network?  Siete alla ricerca di una sala per organizzare la vostra assemblea generale o una riunione?  Benvenuti in D5."
    ],
    "fr": [
      "Vous êtes à la recherche d’un espace de travail stimulant, propice aux synergies et souhaitez élargir votre réseau?  Vous cherchez une salle pour organiser votre assemblée générale ou une réunion?  Bienvenue au D5."
    ],
    "es": [
      "¿Busca un espacio de trabajo estimulante y sinérgico y quiere ampliar su red de contactos?  ¿Busca una sala para celebrar su junta general o una reunión?  Bienvenido al D5."
    ],
    "nl": [
      "Bent u op zoek naar een stimulerende werkruimte, bevorderlijk voor synergie en wilt u uw netwerk uitbreiden?  Bent u op zoek naar een zaal voor uw algemene vergadering of een bijeenkomst?  Welkom bij D5."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le D5"
    ]
  },
