  "rdfs:comment": {
    "de": [
      "Ich praktiziere Wellness- und Sportmassage, immer nach Maß, und Rolfing® Strukturelle Integration. \r\nKommen Sie und kümmern Sie sich um sich selbst, für einen Körper und einen Geist in Harmonie."
    ],
    "en": [
      "I offer wellness and sports massage, always tailored to your needs, as well as Rolfing® Structural Integration.\r\nCome and pamper yourself, for a body and mind in harmony."
    ],
    "it": [
      "Offro massaggi benessere e sportivi, sempre personalizzati in base alle vostre esigenze, e integrazione strutturale Rolfing®.\r\nVenite a farvi coccolare, per un corpo e una mente in armonia."
    ],
    "fr": [
      "Je pratique le massage bien-être et sportif, toujours sur mesure, et le Rolfing® Intégration structurale. \r\nVenez prendre soin de vous, pour un corps et un esprit en harmonie."
    ],
    "es": [
      "Ofrezco masajes de bienestar y deportivos, siempre adaptados a sus necesidades, e Integración Estructural Rolfing®.\r\nVen a mimarte, para un cuerpo y una mente en armonía."
    ],
    "nl": [
      "Ik bied welzijns- en sportmassage, altijd afgestemd op jouw behoeften, en Rolfing® Structural Integration.\r\nKom en verwen jezelf, voor een lichaam en geest in harmonie."
    ]
  },
