  "rdfs:comment": {
    "de": [
      "Erliegen Sie dem Charme von La Guinguette in Barraux (38530): traditionelle Küche, schattige Terrasse, lokale Produkte. Gesellige Atmosphäre für ein authentisches Gourmet-Erlebnis."
    ],
    "en": [
      "Restaurant with 100% home-made, seasonal cuisine. \r\nAs far as possible and depending on the availability of our suppliers, we try to work with local natural and/or organic products and short supply chains."
    ],
    "it": [
      "Lasciatevi conquistare dal fascino de La Guinguette a Barraux (38530): cucina tradizionale, terrazza ombreggiata, prodotti locali. Un'atmosfera amichevole per un'autentica esperienza gastronomica."
    ],
    "fr": [
      "Succombez au charme de La Guinguette à Barraux (38530) : cuisine traditionnelle, terrasse ombragée, produits locaux. Ambiance conviviale pour une expérience gourmande authentique."
    ],
    "es": [
      "Sucumba al encanto de La Guinguette en Barraux (38530): cocina tradicional, terraza a la sombra, productos locales. Un ambiente acogedor para una auténtica experiencia gastronómica."
    ],
    "nl": [
      "Restaurant met 100% huisgemaakte, seizoensgebonden gerechten. \r\nVoor zover mogelijk en afhankelijk van de beschikbaarheid van onze leveranciers, proberen we te werken met lokale producten of korte lijnen, natuurlijk en/of biologisch."
    ]
  },
  "rdfs:label": {
