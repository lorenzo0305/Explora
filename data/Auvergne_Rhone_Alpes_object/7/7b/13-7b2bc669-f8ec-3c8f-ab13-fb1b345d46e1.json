  "rdfs:comment": {
    "de": [
      "Die Minigolfanlage in der Nähe des Wassersportzentrums von Evian bietet Ihnen einen 18-Loch-Parcours in einer außergewöhnlichen Umgebung mit einer Mischung aus See, Stauden, Bambus, Palmen."
    ],
    "en": [
      "Close to the Evian nautical center, the minigolf offers a course of 18 holes in an unique environment beetween lake, palm-trees and flowers."
    ],
    "it": [
      "Situato vicino al centro di sport acquatici di Evian, il minigolf offre un percorso di 18 buche in un ambiente eccezionale che combina lago, piante perenni, bambù e palme."
    ],
    "fr": [
      "Situé à proximité du centre nautique d'Evian, le minigolf vous offre un parcours de 18 trous dans un environnement d'exception mêlant lac, plantes vivaces, bambous, palmiers."
    ],
    "es": [
      "Situado cerca del centro de deportes acuáticos de Evian, el minigolf ofrece un recorrido de 18 hoyos en un entorno excepcional que combina lago, plantas perennes, bambú y palmeras."
    ],
    "nl": [
      "De minigolfbaan ligt vlakbij het watersportcentrum van Evian en biedt 18 holes in een uitzonderlijke omgeving met een meer, vaste planten, bamboe en palmbomen."
    ]
  },
