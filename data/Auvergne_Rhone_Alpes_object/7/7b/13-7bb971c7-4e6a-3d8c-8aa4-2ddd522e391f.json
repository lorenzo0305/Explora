  "rdfs:comment": {
    "de": [
      "Fleurs de Vie Chartreuse ist ein landwirtschaftlicher Betrieb mit Bio-Label, der Heilpflanzen anbaut und sammelt. Marilyne bietet Ihnen Workshops, Spaziergänge und Schulungen an, um die Wildpflanzen zu entdecken."
    ],
    "en": [
      "Fleurs de Vie Chartreuse is a certified organic farm that grows and harvests medicinal plants. Marilyne offers workshops, walks and training courses to help you discover wild plants."
    ],
    "it": [
      "Fleurs de Vie Chartreuse è un coltivatore e raccoglitore certificato di piante medicinali biologiche. Marilyne offre laboratori, passeggiate e corsi di formazione per aiutarvi a scoprire le piante selvatiche."
    ],
    "fr": [
      "Fleurs de Vie Chartreuse est une entreprise agricole labellisée bio, de culture et cueillette de plantes médicinales. Marilyne vous propose des ateliers, des balades, des formations pour découvrir les plantes sauvages."
    ],
    "nl": [
      "Fleurs de Vie Chartreuse is een gecertificeerde biologische kweker en plukker van geneeskrachtige planten. Marilyne geeft workshops, wandelingen en cursussen om wilde planten te ontdekken."
    ],
    "es": [
      "Fleurs de Vie Chartreuse es una cultivadora y recolectora ecológica certificada de plantas medicinales. Marilyne ofrece talleres, paseos y cursos de formación para ayudarte a descubrir las plantas silvestres."
    ]
  },
