  "rdfs:comment": {
    "de": [
      "Der Bau des Aigle-Damms wurde 1935 begonnen und erst 1945 fertiggestellt. Er wird auch als \"Staudamm des Widerstands\" bezeichnet."
    ],
    "en": [
      "The construction of Le barrage de l'Aigle started in 1935 and ended only in 1945. It has been aptly named \"the Resistance Dam\"."
    ],
    "it": [
      "La costruzione della diga di Aigle iniziò nel 1935 e fu completata solo nel 1945. È nota come \"diga di resistenza\"."
    ],
    "fr": [
      "Débutée en 1935, la construction du barrage de l'Aigle n’a été terminée qu’en 1945. On le surnomme \" le barrage de la résistance \"."
    ],
    "es": [
      "La construcción de la presa de Aigle comenzó en 1935 y no se terminó hasta 1945. Se conoce como \"presa de resistencia\"."
    ],
    "nl": [
      "De bouw van de stuwdam van Aigle begon in 1935 en werd pas in 1945 voltooid. Het staat bekend als de \"weerstandsdam\"."
    ]
  },
  "rdfs:label": {
    "en": [
      "Visit of the dam (barrage de l'Aigle)"
    ],
    "fr": [
      "Visites guidées du barrage de l'Aigle"
    ]
  },
