  "rdfs:comment": {
    "de": [
      "Probieren Sie unsere im Holzfeuerofen gebackenen Pizzen, die in einer behaglichen Umgebung und geselliger Atmosphäre mit Liebe zubereitet werden. 7 Tage pro Woche geöffnet!"
    ],
    "en": [
      "Come and taste our wood-fired pizzas, prepared with loving care, in a cosy venue with a friendly atmosphere. Open 7 days per week!"
    ],
    "it": [
      "Venite a gustare le nostre pizze cotte a legna, preparate con amore in un'atmosfera calda e accogliente. Aperto 7 giorni su 7!"
    ],
    "fr": [
      "Venez dégustez nos pizzas au feu de bois, préparées avec amour dans un espace chaleureux et une ambiance conviviale. Ouvert 7 jours sur 7 !"
    ],
    "es": [
      "Pruebe nuestras pizzas al horno de piedra preparadas con amor en un espacio acogedor y en un ambiente familiar. Abierto todos los días."
    ],
    "nl": [
      "Kom genieten van onze houtgestookte pizza's, met liefde bereid in een warme en vriendelijke sfeer. 7 dagen per week geopend!"
    ]
  },
