  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/22c08cde-82f4-3dc9-839e-7a463b14a93d",
      "dc:description": {
        "de": [
          "Samstag, 6. April 2024\n\nAutomobil - Karte an den Frühling.\nAbfahrt 7:30 Uhr und Rückkehr 19:00 Uhr, Thalassa Le Touquet.\nOrganisiert von der Association Le Touquet Automobiles de Collection.\nEtwa 30 Autos erwartet."
        ],
        "en": [
          "Saturday, April 6, 2024\n\nAutomobile - Carte au Printemps.\nDeparture 7:30 am and return 7 pm, Thalassa Le Touquet.\nOrganized by the Association Le Touquet Automobiles de Collection.\nAround thirty cars expected."
        ],
        "it": [
          "Sabato 6 aprile 2024\n\nAutomobile - Carta di primavera.\nPartenza alle 7.30 e ritorno alle 19.00, Thalassa Le Touquet.\nOrganizzato dall'Association Le Touquet Automobiles de Collection.\nSono attese circa trenta auto."
        ],
        "fr": [
          "Samedi 6 avril 2024\n\nAutomobile - Carte au Printemps.\nDépart 7h30 et retour 19h, Thalassa Le Touquet.\nOrganisée par l’Association Le Touquet Automobiles de Collection.\nUne trentaine de voitures attendues."
        ],
        "nl": [
          "Zaterdag 6 april 2024\n\nAuto - Lentekaart.\nVertrek 7.30 uur en terugkomst 19.00 uur, Thalassa Le Touquet.\nGeorganiseerd door de Association Le Touquet Automobiles de Collection.\nEr worden ongeveer dertig auto's verwacht."
        ],
        "es": [
          "Sábado 6 de abril de 2024\n\nAutomóvil - Carné de primavera.\nSalida a las 7h30 y regreso a las 19h, Thalassa Le Touquet.\nOrganizado por la Association Le Touquet Automobiles de Collection.\nSe espera una treintena de coches."
        ]
      },
