  "rdfs:comment": {
    "de": [
      "Eine thematische Führung im Herzen von Montélimar, die dem berühmtesten aller Montiliens (ursprünglich aus Marsanne) gewidmet ist. Er war Bürgermeister von Montélimar und wurde von 1899 bis 1906 Präsident der Französischen Republik."
    ],
    "en": [
      "A themed tour in the heart of Montélimar, dedicated to Montélimar's most famous citizen (originally from Marsanne), the mayor of Montélimar who became President of the French Republic from 1899 to 1906."
    ],
    "it": [
      "Una visita tematica nel cuore di Montélimar, dedicata al più famoso montiliano (originario di Marsanne), sindaco di Montélimar e presidente della Repubblica francese dal 1899 al 1906."
    ],
    "fr": [
      "Une visite thématique, au cœur de Montélimar, dédiée au plus célèbre des montiliens (originaire de Marsanne), maire de Montélimar devenu Président de la République Française de 1899 à 1906."
    ],
    "es": [
      "Recorrido temático por el corazón de Montélimar, dedicado al más célebre montillano (originario de Marsanne), alcalde de Montélimar y Presidente de la República Francesa de 1899 a 1906."
    ],
    "nl": [
      "Een thematische rondleiding door het hart van Montélimar, gewijd aan de beroemdste inwoner van Montélimar (oorspronkelijk uit Marsanne), de burgemeester van Montélimar die van 1899 tot 1906 president van de Franse Republiek werd."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Sur les traces d'Emile Loubet à Montélimar"
    ]
  },
