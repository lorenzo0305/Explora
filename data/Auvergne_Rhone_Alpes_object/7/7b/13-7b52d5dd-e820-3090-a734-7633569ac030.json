  "rdfs:comment": {
    "de": [
      "Bar-Restaurant - Küche aus Rohprodukten - Hausgemacht von der Vorspeise bis zum Dessert - Nette und herzliche Atmosphäre. Angenehme Terrasse in der Sonne gegenüber der Stiftskirche Saint Barnard."
    ],
    "en": [
      "Bar-restaurant - Cuisine based on local produce - Homemade from starters to desserts - Warm, friendly atmosphere. Pleasant sunny terrace facing the Collégiale Saint Barnard."
    ],
    "it": [
      "Bar-ristorante - Cucina a base di prodotti freschi - Cucina casalinga dagli antipasti ai dessert - Atmosfera calda e accogliente.\r\nPiacevole terrazza soleggiata di fronte alla Collegiata di San Barnard."
    ],
    "fr": [
      "Bar restaurant - Cuisine à partir de produits bruts - Du fait maison de l’entrée au dessert - Ambiance sympa et chaleureuse. \r\nTerrasse agréable au soleil face à la Collégiale Saint Barnard."
    ],
    "es": [
      "Bar-restaurante - Cocina basada en productos frescos - Casera desde los entrantes hasta los postres - Ambiente cálido y acogedor.\r\nAgradable terraza soleada frente a la Colegiata de Saint Barnard."
    ],
    "nl": [
      "Bar-restaurant - Keuken gebaseerd op verse producten - Huisgemaakt van voorgerechten tot nagerechten - Warme en vriendelijke sfeer. Aangenaam zonnig terras tegenover de Collégiale Saint Barnard."
    ]
  },
