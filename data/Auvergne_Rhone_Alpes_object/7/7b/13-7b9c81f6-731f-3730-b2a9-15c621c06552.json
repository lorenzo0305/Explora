  "rdfs:comment": {
    "de": [
      "Hallo an alle Liebhaber der Auvergne und von Wassersportaktivitäten. Unser Wassersportzentrum AQUALOISIRS AUVERGNE liegt an den zauberhaften Ufern des Siauve-Sees, direkt neben dem mythischen Schloss Val."
    ],
    "en": [
      "Hello to all lovers of the Auvergne and water sports. Our AQUALOISIRS AUVERGNE aquatic center is located on the enchanting shores of Lac de la Siauve, right next to the mythical Château de Val."
    ],
    "it": [
      "Ciao a tutti gli amanti dell'Alvernia e degli sport acquatici. Il nostro centro acquatico AQUALOISIRS AUVERGNE si trova sulle incantevoli rive del Lac de la Siauve, proprio accanto al mitico Château de Val."
    ],
    "fr": [
      "Bonjour à tous les amoureux de l'Auvergne et des activités nautiques. Notre centre aquatique AQUALOISIRS AUVERGNE est situé sur les rives enchanteresses du lac de la Siauve, juste à côté du mythique château de Val."
    ],
    "es": [
      "Hola a todos los amantes de Auvernia y de los deportes náuticos. Nuestro centro acuático AQUALOISIRS AUVERGNE está situado en las encantadoras orillas del Lac de la Siauve, justo al lado del mítico Château de Val."
    ],
    "nl": [
      "Hallo aan alle liefhebbers van de Auvergne en watersporten. Ons aquacentrum AQUALOISIRS AUVERGNE ligt aan de betoverende oevers van het Lac de la Siauve, vlak bij het mythische Château de Val."
    ]
  },
  "rdfs:label": {
