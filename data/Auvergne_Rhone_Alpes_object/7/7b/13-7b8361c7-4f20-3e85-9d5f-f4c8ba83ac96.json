  "rdfs:comment": {
    "de": [
      "Abwechslungsreiche Route durch Almwiesen und Unterholz, die allmählich in das Tal der Eau d'Olle hinabsteigt. Der Weg wechselt zwischen kleinen Abfahrten und Anstiegen ohne große technische Schwierigkeiten, erfordert aber eine gute Kondition."
    ],
    "en": [
      "This a varied route through pasture and woodland, descending gradually into the Eau d’Olle Valley. It switches between short descents and uphill sections, without  any major technical difficulties, although a good level of fitness is required."
    ],
    "it": [
      "Un percorso vario attraverso pascoli di montagna e sottobosco che scende gradualmente nella valle dell'Eau d'Olle. Il percorso alterna brevi discese e salite senza grosse difficoltà tecniche, ma richiede un buon livello di allenamento."
    ],
    "fr": [
      "Itinéraire varié à travers alpages et sous-bois qui descend progressivement dans la vallée de l’Eau d’Olle. Le parcours alterne de petites descentes et montées sans grandes difficultés techniques mais requiert une bonne condition physique."
    ],
    "es": [
      "Un recorrido variado a través de pastos de montaña y maleza que desciende gradualmente hacia el valle de Eau d'Olle. La ruta alterna descensos cortos y subidas sin grandes dificultades técnicas, pero requiere un buen nivel de forma física."
    ],
    "nl": [
      "Gevarieerd parcours doorheen alpenweiden en kreupelhoutbossen dat langzaam afdaalt in de vallei van de Eau d'Olle.  Het parcours is een afwisseling van kleine afdalingen en klimstukken zonder grote technische moeilijkheden maar die toch een goede conditie vereisen."
    ]
  },
  "rdfs:label": {
    "en": [
      "The Combes track"
    ],
    "fr": [
      "Le chemin des Combes"
    ],
    "nl": [
      "Het Combes-parcours"
    ]
  },
