  "rdfs:comment": {
    "de": [
      "Eine Humorszene, die einen Ort des Lachens und des kulturellen Lebens im Herzen von Valence bietet.\r\nOne-Man-Shows, Komödien, Improvisationen - wir wählen sie für Sie aus, wobei der Humor natürlich allgegenwärtig ist."
    ],
    "en": [
      "Comedy stage offering a place for laughter and cultural life in the heart of Valence.\r\nOne-man shows, comedies, improvisations, we select them for you, with humor always in mind."
    ],
    "it": [
      "Palcoscenico comico che offre un luogo di risate e di vita culturale nel cuore di Valence.\r\nOne-man-show, commedie, improvvisazioni, li selezioniamo per voi, con l'umorismo onnipresente."
    ],
    "fr": [
      "Scène d'humour qui propose un lieu de rire et de vie culturelle en plein coeur de Valence.\r\nOne-man shows, comédies, improvisations, nous les sélectionnons pour vous avec bien-sûr l'humour omniprésent."
    ],
    "es": [
      "Escenario de comedia que ofrece un lugar de risas y vida cultural en el corazón de Valence.\r\nEspectáculos unipersonales, comedias, improvisaciones, los seleccionamos para usted, con el humor omnipresente."
    ],
    "nl": [
      "Een komisch podium dat een plek biedt om te lachen en cultureel te leven in het hart van Valence.\r\nOne-man shows, komedies, improvisaties, wij selecteren ze voor u, met humor altijd aanwezig."
    ]
  },
