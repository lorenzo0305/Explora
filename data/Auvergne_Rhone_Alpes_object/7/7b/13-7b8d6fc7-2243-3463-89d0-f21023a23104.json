  "rdfs:comment": {
    "de": [
      "Um unsere Haselnusskultur aufzuwerten und nach vielen Nachmittagen, an denen sie diese kostbaren Nuggets gekocht haben, beschlossen Karen und Nicolas Perrin 2020, ihr eigenes Verarbeitungslabor zu gründen."
    ],
    "en": [
      "To enhance the value of our hazelnut crop, and after many afternoons cooking these precious nuggets, Karen and Nicolas Perrin decided in 2020 to set up their own processing laboratory."
    ],
    "it": [
      "Dopo molti pomeriggi passati a cucinare queste preziose pepite, nel 2020 Karen e Nicolas Perrin hanno deciso di creare un proprio laboratorio di trasformazione per promuovere la nostra cultura della nocciola."
    ],
    "fr": [
      "Afin de valoriser notre culture de noisette et après de nombreux après-midi à cuisiner ces précieuses pépites, Karen et Nicolas Perrin ont décidé en 2020 de créer leur propre laboratoire de transformation."
    ],
    "nl": [
      "Na vele middagen koken met deze kostbare klompjes besloten Karen en Nicolas Perrin in 2020 hun eigen verwerkingslaboratorium op te zetten om onze hazelnootcultuur te promoten."
    ],
    "es": [
      "Después de muchas tardes cocinando estas preciosas pepitas, Karen y Nicolas Perrin decidieron en 2020 crear su propio laboratorio de transformación para promover nuestra cultura de la avellana."
    ]
  },
  "rdfs:label": {
