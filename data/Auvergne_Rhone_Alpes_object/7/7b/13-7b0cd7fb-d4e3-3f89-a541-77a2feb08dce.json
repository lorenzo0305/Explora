  "rdfs:comment": {
    "de": [
      "Genießen Sie einen Moment der Entspannung auf unserer Sonnenterrasse, die ideal zwischen Méribel Centre und dem Altiport gelegen ist.\r\nUnser Team empfängt Sie von Montag bis Freitag mittags."
    ],
    "en": [
      "Come and enjoy a moment of gourmet relaxation on our sunny terrace, ideally located between Méribel Centre and the Altiport.\r\nOur team welcomes you for lunch and dinner with a menu featuring fresh, local and seasonal produce."
    ],
    "it": [
      "Venite a godervi un momento di relax gastronomico sulla nostra terrazza soleggiata, situata in posizione ideale tra Méribel Centre e l'Altiport.\r\nIl nostro team vi accoglie dal lunedì al venerdì a pranzo."
    ],
    "fr": [
      "Venez profiter d'un moment de détente gourmand sur notre terrasse ensoleillée idéalement située entre Méribel Centre et l'altiport.\r\nNotre équipe vous accueille du Lundi au Vendredi midi."
    ],
    "es": [
      "Venga a disfrutar de un momento de relajación gastronómica en nuestra soleada terraza, idealmente situada entre Méribel Centre y el Altiport.\r\nNuestro equipo le da la bienvenida de lunes a viernes al mediodía."
    ],
    "nl": [
      "."
    ]
  },
