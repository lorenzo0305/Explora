  "rdfs:comment": {
    "de": [
      "Ein Hauch von Südwest in den Alpen! Kristel und Jean-Noël empfangen Sie in einer gemütlichen Umgebung, wo Sie Spezialitäten aus Savoyen probieren und die Küche des Südwestens entdecken können."
    ],
    "en": [
      "A taste of South-West France cuisine in the Alps! Kristel and Jean-Noel offer a friendly welcome and invite you to try out some South-West specialties, as well as local ones."
    ],
    "it": [
      "Un tocco di Sud-Ovest nelle Alpi! Kristel e Jean-Noël vi accolgono in un ambiente caloroso per gustare le specialità savoiarde e scoprire la cucina del Sud-Ovest."
    ],
    "fr": [
      "Une touche de Sud-Ouest dans les Alpes ! Kristel et Jean-Noël vous accueillent dans un cadre chaleureux pour déguster des spécialités savoyardes et découvrir la cuisine du Sud-Ouest."
    ],
    "es": [
      "¡Un toque del sudoeste en los Alpes! Kristel y Jean-Noël le dan la bienvenida en un ambiente cálido para degustar las especialidades saboyanas y descubrir la cocina del suroeste."
    ],
    "nl": [
      "Een vleugje zuidwesten in de Alpen! Kristel en Jean-Noël heten Savoyaardse specialiteiten en de zuidwestelijke keuken hartelijk welkom."
    ]
  },
  "rdfs:label": {
    "en": [
      "Le Clin d'oeil"
    ],
