  "rdfs:comment": {
    "de": [
      "Die Gemeinde St Paul 3 Châteaux hat die Ehre, talentierte Pianisten aus der ganzen Welt zu diesem Wettbewerb willkommen zu heißen, der nun schon im vierten Jahr in Folge stattfindet."
    ],
    "en": [
      "The municipality of St Paul 3 Châteaux has the honor of welcoming talented pianists from all over the world for this competition, which is taking off for the 4th year running."
    ],
    "it": [
      "La città di St Paul 3 Châteaux ha l'onore di accogliere pianisti di talento provenienti da tutto il mondo per questo concorso, che si svolge per il 4° anno consecutivo."
    ],
    "fr": [
      "La municipalité de St Paul 3 Châteaux a l’honneur d’accueillir des pianistes talentueux du monde entier pour cette compétition qui prend son envol, pour la 4ème année consécutive."
    ],
    "es": [
      "La ciudad de St Paul 3 Châteaux tiene el honor de acoger a talentosos pianistas de todo el mundo para este concurso, que se celebra por cuarto año consecutivo."
    ],
    "nl": [
      "De stad St Paul 3 Châteaux heeft de eer om getalenteerde pianisten van over de hele wereld te verwelkomen voor deze wedstrijd, die voor het 4e jaar op rij van start gaat."
    ]
  },
