  "rdfs:comment": {
    "de": [
      "Das Maison du patrimoine et des lettres (Haus des Kulturerbes und der Literatur) befindet sich im Erdgeschoss des La demeure Chamoncel, einem lokalen Nugget der Renaissance, und beherbergt die Geschichte Saint-Etiennes."
    ],
    "en": [
      "Located on the first floor of La demeure Chamoncel, a local Renaissance nugget, the Maison du patrimoine et des lettres is home to the history of Saint-Étienne."
    ],
    "it": [
      "Situata al piano terra de La demeure Chamoncel, un gioiello del Rinascimento locale, la Maison du Patrimoine et des Lettres ospita la storia di Saint-Étienne."
    ],
    "fr": [
      "Située au rez-de-chaussée de La demeure Chamoncel, pépite locale de la Renaissance, la Maison du patrimoine et des lettres accueille l’histoire de Saint-Étienne."
    ],
    "es": [
      "Situada en la planta baja de La demeure Chamoncel, joya local del Renacimiento, la Maison du Patrimoine et des Lettres alberga la historia de Saint-Étienne."
    ],
    "nl": [
      "In het Maison du Patrimoine et des Lettres, gelegen op de begane grond van La demeure Chamoncel, een plaatselijk juweeltje uit de Renaissance, vind je de geschiedenis van Saint-Étienne."
    ]
  },
