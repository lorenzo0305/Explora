  "rdfs:comment": {
    "de": [
      "Das Isabelle-Romee-Zentrum ist ein Ort, der einmalig oder regelmäßig gemietet werden kann. Die kürzlich renovierten Räumlichkeiten sind dazu bestimmt, Gruppen für Proben, Seminare, Praktika und Konferenzen zu empfangen"
    ],
    "en": [
      "The Centre Isabelle Romée is available for rental on an occasional or regular basis. Recently renovated, the premises are designed to accommodate groups for rehearsals, seminars, training courses and conferences"
    ],
    "it": [
      "Il Centro Isabelle Romée può essere affittato una tantum o regolarmente. Recentemente rinnovati, i locali sono stati progettati per ospitare gruppi per prove, seminari, corsi di formazione, conferenze, ecc"
    ],
    "fr": [
      "Le centre Isabelle Romée est un lieu accessible à la location ponctuelle ou régulière . Récemment rénovés, les locaux sont destinés à recevoir des groupes pour des répétitions , des séminaires , des stages , des conférences"
    ],
    "nl": [
      "Het Isabelle Romée Centre kan eenmalig of regelmatig worden gehuurd. De onlangs gerenoveerde lokalen zijn ontworpen om groepen te ontvangen voor repetities, seminars, opleidingen, conferenties, enz"
    ],
    "es": [
      "El Centro Isabelle Romée está disponible para alquileres puntuales o regulares. Recientemente renovado, el local está diseñado para acoger a grupos para ensayos, seminarios, cursos de formación, conferencias, etc"
    ]
  },
  "rdfs:label": {
