  "rdfs:comment": {
    "de": [
      "Die Kirche ist im neogotischen Stil erbaut. Sie wurde 1890 von dem Architekten Annecien Fontaine erbaut und 1892 eingeweiht. Das Innere wurde 1967 und das Äußere 1980 renoviert."
    ],
    "en": [
      "The church is in the Neo-Gothic style. It was built by Fontaine, the architect from Annecy, in 1890 and opened in 1892. The interior was renovated in 1967 and the exterior in 1980."
    ],
    "it": [
      "La chiesa è in stile neogotico. Fu costruita dall'architetto Annecien Fontaine nel 1890 e inaugurata nel 1892. L'interno è stato ristrutturato nel 1967 e l'esterno nel 1980."
    ],
    "fr": [
      "L’église est de style néogothique. Elle a été édifiée par l’architecte annecien Fontaine en 1890 et inaugurée en 1892. L’intérieur a été rénové en 1967 et l’extérieur en 1980."
    ],
    "es": [
      "La iglesia es de estilo neogótico. Fue construida por el arquitecto Annecien Fontaine en 1890 e inaugurada en 1892. El interior se renovó en 1967 y el exterior en 1980."
    ],
    "nl": [
      "De kerk is in neogotische stijl. Het werd gebouwd door de architect Fontaine in 1890 en ingehuldigd in 1892. Het interieur werd gerenoveerd in 1967 en de buitenkant in 1980."
    ]
  },
