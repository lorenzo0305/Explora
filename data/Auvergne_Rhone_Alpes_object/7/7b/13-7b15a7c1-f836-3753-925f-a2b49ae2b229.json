  "rdfs:comment": {
    "de": [
      "Das Buena Onda Festival kehrt für eine explosive 9. Ausgabe nach Sanssac-l'Église zurück! Zwei Tage voller Musik und Geselligkeit erwarten Sie in der Salle socioculturelle für ein Wochenende im Zeichen des Teilens und der guten Laune."
    ],
    "en": [
      "The Buena Onda Festival is back for an explosive 9th edition in Sanssac-l?Église! Two days of festivities, music and conviviality await you at the Salle Socioculturelle for a weekend of sharing and good humor."
    ],
    "it": [
      "Il Buena Onda Festival torna per un'esplosiva 9a edizione a Sanssac-l'Église! Due giorni di festa, musica e convivialità vi aspettano alla Salle Socioculturelle per un fine settimana di condivisione e buonumore."
    ],
    "fr": [
      "Le Buena Onda Festival est de retour pour une 9ᵉ édition explosive à Sanssac-l’Église ! Deux jours de fête, de musique et de convivialité vous attendent à la salle socioculturelle pour un week-end sous le signe du partage et de la bonne humeur."
    ],
    "nl": [
      "Het Buena Onda Festival is terug voor een explosieve 9e editie in Sanssac-l?Église! Twee dagen van festiviteiten, muziek en gezelligheid wachten op je in de Salle Socioculturelle voor een weekend van delen en goed humeur."
    ],
    "es": [
      "El Festival Buena Onda regresa a Sanssac-l'Église para celebrar su 9ª edición Dos días de fiesta, música y convivencia le esperan en la Salle Socioculturelle para un fin de semana de convivencia y buen humor."
    ]
  },
