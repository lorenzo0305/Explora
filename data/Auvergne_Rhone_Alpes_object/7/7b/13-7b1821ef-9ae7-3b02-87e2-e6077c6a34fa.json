  "rdfs:comment": {
    "de": [
      "Les Pommes du Sauget bietet eine Apfelproduktion zum Verkauf an, aber auch Birnen und Säfte aus biologischem Anbau, sowie Kartoffeln, Kürbisse, Honig und Nüsse im Ladenbereich."
    ],
    "en": [
      "Les Pommes du Sauget sells apples, pears and juice produced using organic methods, as well as potatoes, squash, honey and walnuts in the shop."
    ],
    "it": [
      "Les Pommes du Sauget vende mele, pere e succhi di frutta biologici, oltre a patate, zucche, miele e noci."
    ],
    "fr": [
      "Les Pommes du Sauget propose à la vente une production de pommes, mais aussi des poires et jus en agriculture biologique, ainsi que des pommes de terre, des courges,  du miel et des noix dans l'espace boutique."
    ],
    "nl": [
      "Les Pommes du Sauget verkoopt appels, peren en biologisch sap, maar ook aardappelen, pompoen, honing en walnoten in de winkel."
    ],
    "es": [
      "Les Pommes du Sauget vende manzanas, peras y zumo ecológico, así como patatas, calabaza, miel y nueces en la tienda."
    ]
  },
