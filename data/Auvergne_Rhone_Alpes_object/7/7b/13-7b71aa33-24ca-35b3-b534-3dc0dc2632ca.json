  "rdfs:comment": {
    "de": [
      "in unserem Hotel bietet das Le Bellevue einen schönen Gourmet-Stopp am Ufer der Ardèche. In seinem eleganten Speisesaal mit Panoramablick auf die Ufer der Ardèche und seine Hängebrücke werden Sie die köstlichen Aromen der Ardèche genießen."
    ],
    "en": [
      "Le Bellevue offers a gourmet getaway on the banks of the Ardèche. In its elegant dining room with panoramic view of the banks of the Ardèche and its suspension bridge, you can savour the delicious flavours of the Ardèche."
    ],
    "it": [
      "Come parte del nostro hotel, Le Bellevue offre una pausa gourmet sulle rive dell'Ardèche. Nel suo elegante ristorante con vista panoramica sulle rive dell'Ardèche e sul suo ponte sospeso, potrete assaporare i deliziosi sapori dell'Ardèche"
    ],
    "fr": [
      "Au sein de notre Hôtel,  Le Bellevue offre une belle escale gourmande au bord de l’Ardèche. Dans son élégante salle de restaurant avec vue panoramique sur les rives de l’Ardèche et son pont suspendu vous dégusterez les délicieuses saveurs ardéchoises"
    ],
    "nl": [
      "Le Bellevue is een gastronomische tussenstop aan de oevers van de Ardèche. In het elegante restaurant met panoramisch uitzicht op de oevers van de Ardèche en de hangbrug kun je genieten van de heerlijke smaken van de Ardèche."
    ],
    "es": [
      "Como parte de nuestro hotel, Le Bellevue le ofrece una escapada gastronómica a orillas del Ardèche. En su elegante restaurante con vistas panorámicas a las orillas del Ardèche y su puente colgante, podrá saborear los deliciosos sabores del Ardèche"
    ]
  },
