  "rdfs:comment": {
    "de": [
      "Das Schloss wurde im 16. Jahrhundert von Jean-Antoine de Locatel, einem edlen Kaufmann aus Bergamo in Italien, erbaut und im Laufe der Jahrhunderte immer wieder umgebaut. Das Hauptgebäude ist von drei quadratischen Türmen umgeben."
    ],
    "en": [
      "Built by Jean-Antoine de Locatel, a noble merchant from Bergamo, Italy, in the 16th century, the château has been modified over the centuries. The main building is surrounded by three square towers."
    ],
    "it": [
      "Costruito da Jean-Antoine de Locatel, un nobile mercante bergamasco, nel XVI secolo, il castello è stato modificato nel corso dei secoli. L'edificio principale è circondato da tre torri quadrate."
    ],
    "fr": [
      "Construit par Jean-Antoine de Locatel, noble marchand originaire de Bergame, en Italie, au XVI° siècle, le château est remanié au fil des siècles. Le corps de logis principal est entouré de trois tours carrées."
    ],
    "nl": [
      "Het kasteel werd in de 16e eeuw gebouwd door Jean-Antoine de Locatel, een adellijke koopman uit Bergamo, Italië, en is in de loop der eeuwen veranderd. Het hoofdgebouw wordt omringd door drie vierkante torens."
    ],
    "es": [
      "Construido por Jean-Antoine de Locatel, un noble comerciante de Bérgamo (Italia), en el siglo XVI, el castillo ha sido modificado a lo largo de los siglos. El edificio principal está rodeado por tres torres cuadradas."
    ]
  },
  "rdfs:label": {
    "en": [
      "Château Manuel de Locatel"
    ],
    "fr": [
      "Château Manuel de Locatel"
    ]
  },
