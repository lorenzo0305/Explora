  "rdfs:comment": {
    "de": [
      "Eine neue Ausgabe, in der die Schülerinnen und Schüler ihre Arbeit des letzten Jahres präsentieren. Zusammen mit ihrem Lehrer und professionellen Musikern aus lokalen Bands werden sie ein Rockrepertoire präsentieren, das aber nicht ausschließlich aus Rock besteht."
    ],
    "en": [
      "A new edition showcasing the work accomplished by the students over the past year. Surrounded by their teacher and professional musicians from well-known local bands, they will deliver a rock repertoire, but not exclusively."
    ],
    "it": [
      "Questa nuova edizione presenterà il lavoro svolto dagli studenti nel corso dell'ultimo anno. Circondati dai loro insegnanti e da musicisti professionisti di note band locali, si esibiranno in un repertorio rock, ma non solo."
    ],
    "fr": [
      "Une nouvelle édition qui présentera le travail accompli par les élèves durant cette année. Entourés par leur professeur et par des musiciens pros issus de groupes locaux ayant pignon sur rue, ils vous délivreront un répertoire rock mais pas exclusivement."
    ],
    "es": [
      "Esta nueva edición mostrará el trabajo realizado por los alumnos durante el último año. Rodeados de su profesor y de músicos profesionales de conocidas bandas locales, interpretarán un repertorio de rock, pero no exclusivamente."
    ],
    "nl": [
      "Deze nieuwe editie laat het werk zien dat de studenten het afgelopen jaar hebben verricht. Omringd door hun leraar en professionele muzikanten van bekende lokale bands zullen ze een rockrepertoire ten gehore brengen, maar niet uitsluitend."
    ]
  },
  "rdfs:label": {
    "fr": [
      "109 : Concert de fin d'année Guitartitude"
    ]
  },
