  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/6ebbf8b7-06c2-33c7-ad9b-4be148d33707",
      "dc:description": {
        "de": [
          "Das Syracuse in Chauny ist ein traditionelles Restaurant, das Sie mit seiner Umgebung und seiner Gourmetgastronomie mit typisch italienischen Gerichten begeistern wird.\n\nDie Speisekarte umfasst Gerichte, die mit frischen Zutaten zubereitet werden, um Ihren Gaumen zu erfreuen und zu verblüffen."
        ],
        "en": [
          "Located in Chauny, the Syracuse is the traditional restaurant which will know how to seduce you by its framework and its greedy gastronomy with typical Italian dishes.\n\nThe menu includes dishes made with fresh ingredients, for the greatest pleasure and astonishment of your taste buds."
        ],
        "it": [
          "Situato a Chauny, il Siracusa è un ristorante tradizionale che vi sedurrà con il suo ambiente e la sua cucina gourmet con piatti tipici italiani.\n\nIl menu comprende piatti preparati con ingredienti freschi, per la gioia e lo stupore delle vostre papille gustative."
        ],
        "fr": [
          "Situé à Chauny,  le Syracuse est le restaurant traditionnel qui saura vous séduire par son cadre et sa gastronomie gourmande avec des plats typiques italiens.\n\nLa carte comprend des plats réalisés avec des ingrédients frais, pour le plus grand plaisir et l'étonnement de vos papilles."
        ],
        "nl": [
          "Syracuse, gelegen in Chauny, is een traditioneel restaurant dat u zal verleiden met zijn omgeving en zijn gastronomische keuken met typisch Italiaanse gerechten.\n\nOp het menu staan gerechten met verse ingrediënten, tot groot genoegen en verbazing van uw smaakpapillen."
        ],
        "es": [
          "Situado en Chauny, el Syracuse es un restaurante tradicional que le seducirá por su entorno y su cocina gourmet con platos típicos italianos.\n\nEl menú incluye platos elaborados con ingredientes frescos, para deleite y asombro de sus papilas gustativas."
        ]
      },
      "@type": [
        "Description"
      ],
