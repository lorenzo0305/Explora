  "rdfs:comment": {
    "de": [
      "Die Fromagerie de l'Étoile wird eine Auswahl an hochwertigen Produkten aus der benachbarten Schweiz sowie von einem Dutzend lokaler Produzenten anbieten. Die Marke wird eher auf Qualität als auf Quantität setzen."
    ],
    "en": [
      "La Fromagerie de l'Étoile will offer a selection of top-quality products from neighboring Switzerland, as well as from a dozen local producers. The emphasis will be on quality rather than quantity."
    ],
    "it": [
      "La Fromagerie de l'Étoile offrirà una selezione di prodotti di alta qualità provenienti dalla vicina Svizzera e da una dozzina di produttori locali. L'accento sarà posto sulla qualità piuttosto che sulla quantità."
    ],
    "fr": [
      "La Fromagerie de l'Étoile proposera une sélection de produits haut-de-gamme, venus de la Suisse voisine, mais aussi d'une dizaine de producteurs locaux. L'enseigne privilégiera la qualité plutôt que la quantité."
    ],
    "nl": [
      "La Fromagerie de l'Étoile zal een selectie van hoogwaardige producten uit het naburige Zwitserland en van een twaalftal lokale producenten aanbieden. De nadruk zal liggen op kwaliteit en niet op kwantiteit."
    ],
    "es": [
      "La Fromagerie de l'Étoile ofrecerá una selección de productos de primera calidad procedentes de la vecina Suiza, así como de una docena de productores locales. Se dará más importancia a la calidad que a la cantidad."
    ]
  },
  "rdfs:label": {
