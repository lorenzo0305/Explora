            "de": [
              "Montag bis Freitag von 10:00 bis 15:00 Uhr.\r\nDonnerstagabend = Themenabende.\r\nFreitags von 19:00 bis 21:00 Uhr.\r\nDer Weinkeller ist unter der Woche während der Öffnungszeiten des Restaurants geöffnet."
            ],
            "en": [
              "Monday to Friday, 10 a.m. to 3 p.m.\r\nThursday evenings = theme evenings.\r\nFriday from 7pm to 9pm.\r\nThe cellar is open weekdays during restaurant opening hours."
            ],
            "it": [
              "Dal lunedì al venerdì, dalle 10.00 alle 15.00.\r\nGiovedì sera = serate a tema.\r\nVenerdì dalle 19.00 alle 21.00.\r\nLa cantina è aperta durante gli orari di apertura del ristorante."
            ],
            "fr": [
              "Du lundi au vendredi de 10h à 15h.\r\nJeudi soir = soirées à thème.\r\nVendredi de 19h à 21h.\r\nLa cave est ouverte en semaine durant les horaires du restaurant."
            ],
            "nl": [
              "Maandag t/m vrijdag van 10.00 tot 15.00 uur.\r\nDonderdagavond = thema-avond.\r\nVrijdag van 19.00 tot 21.00 uur.\r\nDe kelder is geopend tijdens de openingstijden van het restaurant."
            ],
            "es": [
              "De lunes a viernes, de 10.00 a 15.00 horas.\r\nJueves por la noche = noches temáticas.\r\nViernes de 19.00 a 21.00 h.\r\nLa bodega está abierta durante el horario de apertura del restaurante."
            ]
