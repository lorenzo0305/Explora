  "rdfs:comment": {
    "de": [
      "Entdecken Sie ein neues Restaurant, das sich der traditionellen französischen Küche widmet, in der alles täglich vor Ort mit frischen, saisonalen und möglichst regionalen Produkten gekocht und verarbeitet wird."
    ],
    "en": [
      "Come and discover a new restaurant dedicated to traditional French cuisine, where everything is cooked and processed daily on site using fresh, seasonal and regional produce wherever possible."
    ],
    "it": [
      "Venite a scoprire un nuovo ristorante dedicato alla cucina tradizionale francese, dove tutto viene cucinato e lavorato quotidianamente in loco utilizzando, ove possibile, prodotti freschi, stagionali e regionali."
    ],
    "fr": [
      "Venez découvrir un nouveau restaurant dédié à la cuisine traditionnelle française où tout est cuisiné et transformé chaque jour sur place avec des produits frais, de saisons et régionaux autant que possible."
    ],
    "es": [
      "Venga a descubrir un nuevo restaurante dedicado a la cocina tradicional francesa, donde todo se cocina y elabora diariamente in situ, utilizando productos frescos, de temporada y regionales siempre que sea posible."
    ],
    "nl": [
      "Kom en ontdek een nieuw restaurant gewijd aan de traditionele Franse keuken, waar alles dagelijks ter plekke wordt gekookt en verwerkt met verse, seizoensgebonden en regionale producten waar mogelijk."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Brother's Fine Food - Restaurant et cave à vin"
    ]
  },
