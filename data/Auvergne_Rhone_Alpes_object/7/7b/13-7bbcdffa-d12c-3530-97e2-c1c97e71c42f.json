  "rdfs:comment": {
    "de": [
      "Snack, Bar, Brotverkauf, Frühstück, Aperitifbrettchen...\r\nSie werden in einer Bar, einem Imbiss und einem Brot- und Gebäckdepot empfangen.\r\nDiese gemütliche Bar befindet sich in der Einkaufsgalerie von L'éclose."
    ],
    "en": [
      "Snack bar, bread, breakfast, aperitif...\r\nWelcome to a bar, snack bar, bread and pastry shop.\r\nThis cosy bar is located in the L'éclose shopping mall."
    ],
    "it": [
      "Snack bar, pane, colazione, aperitivo...\r\nBenvenuti in un bar, snack bar, negozio di pane e pasticceria.\r\nQuesto accogliente bar si trova nella galleria commerciale l?éclose."
    ],
    "fr": [
      "Snack, bar, dépôt de pain, petit déjeuner, planche apéritif...\r\nVous accueil dans un bar, snack, dépôt de pains et viennoiseries.\r\nCe Bar cosy est situé dans la galerie marchande de l’éclose."
    ],
    "nl": [
      "Snackbar, brood, ontbijt, aperitief...\r\nWelkom bij een bar, snackbar, brood- en banketbakkerij.\r\nDeze gezellige bar bevindt zich in het winkelcentrum l'éclose."
    ],
    "es": [
      "Snack bar, pan, desayuno, aperitivo...\r\nBienvenido a un bar, snack bar, panadería y pastelería.\r\nEste acogedor bar se encuentra en la galería comercial l'éclose."
    ]
