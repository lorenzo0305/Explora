  "rdfs:comment": {
    "de": [
      "Träumen Sie vom Fliegen? Laurent bietet Gleitschirmtaufen für alle an, egal ob groß oder klein oder mit eingeschränkter Mobilität."
    ],
    "en": [
      "Do you dream of flying? Laurent offers you paragliding baptism flights for all, young, old and people with reduced mobility."
    ],
    "it": [
      "Sognate di volare? Laurent vi offre i primi voli in parapendio per tutti, giovani e anziani, e per le persone a mobilità ridotta."
    ],
    "fr": [
      "Vous rêvez de voler? Laurent vous propose des vols baptêmes parapente pour tous, petits, grands et personnes à mobilité réduite."
    ],
    "es": [
      "¿Sueña con volar? Laurent te ofrece vuelos en parapente para todos, jóvenes y mayores, y para personas con movilidad reducida."
    ],
    "nl": [
      "Droom je van vliegen? Laurent biedt u paragliding eerste vluchten voor iedereen, jong en oud, en voor mensen met beperkte mobiliteit."
    ]
  },
