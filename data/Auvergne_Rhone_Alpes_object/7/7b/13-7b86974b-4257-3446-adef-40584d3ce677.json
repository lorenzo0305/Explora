  "rdfs:comment": {
    "de": [
      "Boutique für Dekoration, Geschenke und Kunsthandwerk. Personalisierte Dekorationsgegenstände, handgefertigte Töpferwaren, Leuchten, Anfertigung von Vorhängen, Heimtextilien, Bilderrahmen, Souvenirs, alles in einer gemütlichen und warmen Atmosphäre im Bergstil."
    ],
    "en": [
      "Shop for decoration, gifts and crafts. Personalized decorative objects, handmade pottery, lighting, making curtains, household linen, frame, souvenirs, all in a cozy and warm atmosphere in a mountain style."
    ],
    "it": [
      "Negozio di decorazioni, regali e artigianato. Oggetti decorativi personalizzati, ceramiche fatte a mano, illuminazione, tende, biancheria per la casa, cornici, souvenir, il tutto in un'atmosfera accogliente e calda in stile montano."
    ],
    "fr": [
      "Boutique de décoration, cadeaux et artisanat. Objets de décoration personnalisés, poterie artisanale, luminaires, confection de rideaux, linge de maison, cadre, souvenirs, le tout dans une ambiance cosy et chaleureuse dans un style montagnard."
    ],
    "nl": [
      "Winkel voor decoratie, geschenken en ambachten. Gepersonaliseerde decoratieve objecten, handgemaakt aardewerk, verlichting, gordijnen maken, linnengoed, frame, souvenirs, allemaal in een gezellige en warme sfeer in bergstijl."
    ],
    "es": [
      "Compra de decoración, regalos y artesanía. Objetos de decoración personalizados, cerámica hecha a mano, iluminación, cortinas, ropa de hogar, marcos, recuerdos, todo ello en un ambiente acogedor y cálido de estilo montañés."
    ]
  },
