  "rdfs:comment": {
    "de": [
      "Der Club Canin des Sucs ist Gastgeber der französischen Meisterschaften im Rettungsschwimmen in Yssingeaux. Die Rettung wird sowohl die Suche als auch die Rettung aus Trümmern betreffen. Diese Großveranstaltung ist für alle offen. Eintritt frei."
    ],
    "en": [
      "Club Canin des Sucs hosts the French Rescue Championships in Yssingeaux. Rescue will involve both search and rescue. This large-scale event is open to all. Free admission."
    ],
    "it": [
      "Il Club Canin des Sucs ospita i campionati francesi di salvataggio a Yssingeaux. Il soccorso comprenderà sia la ricerca che il salvataggio. Questo evento su larga scala è aperto a tutti. Ingresso libero."
    ],
    "fr": [
      "Le Club Canin des Sucs accueille les championnats de France de sauvetage à Yssingeaux. Le sauvetage concernera autant la quête que les décombres. Cette manifestation de grande envergure est ouverte à tous. Entrée Gratuite."
    ],
    "es": [
      "El Club Canin des Sucs organiza en Yssingeaux los campeonatos de Francia de rescate. El rescate consistirá tanto en la búsqueda como en el salvamento. Este gran acontecimiento está abierto a todos. Entrada gratuita."
    ],
    "nl": [
      "Club Canin des Sucs organiseert de Franse reddingskampioenschappen in Yssingeaux. Redding omvat zowel opsporing als redding. Dit grootschalige evenement is voor iedereen toegankelijk. Gratis toegang."
    ]
  },
  "rdfs:label": {
    "fr": [
      "2ème Championnat de France de Chiens de Sauvetage"
    ]
  },
