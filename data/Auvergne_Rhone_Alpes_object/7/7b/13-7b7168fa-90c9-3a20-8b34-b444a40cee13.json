  "rdfs:comment": {
    "de": [
      "Vor der Seilbahn von La Logère angelegter Spielplatz für Mountainbiker.\r\nDer Crestvopark ist eine Reihe von Buckeln und Steilkurven, die Spaß machen oder einfach nur zum Aufwärmen dienen, bevor Sie die Fahrradwege des Skigebiets erkunden."
    ],
    "en": [
      "A fun area in front of the Logère gondola for mountain bikers.\r\nThe Crestvopark is a series of moguls and banked bends for fun or simply to warm up before exploring the resort's bike trails."
    ],
    "it": [
      "Un'area di divertimento di fronte alla gondola Logère per gli amanti della mountain bike.\r\nIl Crestvopark è una serie di gobbe e curve a gomito per divertirsi o semplicemente per riscaldarsi prima di esplorare le piste ciclabili del resort."
    ],
    "fr": [
      "Espace ludique aménagé devant la télécabine de la Logère destiné aux VTTistes.\r\nLe Crestvopark est une suite de bosses et virages relevés permettant de s'amuser ou tout simplement de s'échauffer avant de partir découvrir les pistes de vélos de la station."
    ],
    "es": [
      "Una zona de diversión frente al telecabina de Logère para los ciclistas de montaña.\r\nEl Crestvopark es una serie de moguls y curvas peraltadas para divertirse o simplemente para entrar en calor antes de explorar los senderos ciclistas de la estación."
    ],
    "nl": [
      "Een leuk gebied voor de Logère gondel voor mountainbikers.\r\nHet Crestvopark is een reeks buckelpistes en hellende bochten voor plezier of gewoon om op te warmen voordat je de fietspaden van het resort verkent."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Crestvopark"
    ]
  },
