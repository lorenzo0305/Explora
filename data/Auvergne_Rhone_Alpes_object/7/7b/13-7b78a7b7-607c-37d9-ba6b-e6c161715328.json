  "rdfs:comment": {
    "de": [
      "Weniger als 3km von Montbrison entfernt, heisst Sie die Mannschaft von Space kid an Bord willkommen! Entdecken Sie mehr als 120m² für Kinder von 0 bis 12 jahren. Funhouse, Minizone, Schlitten, Mini-Gocart, Geburtstagsfeiersäle, Minidiscothek.usw...."
    ],
    "en": [
      "Just outside Montbrison, the Space Kid team welcomes you aboard ! Come and discover an area of over 1200m² dedicated to children of  0 to 12 years. Funhouse, Minizone, toboggan, mini-kart, space golf fluo, birthday room, mini night club…"
    ],
    "it": [
      "Appena fuori Montbrison, l'equipaggio di Space Kid vi dà il benvenuto a bordo! Venite a scoprire gli oltre 1200 m² dedicati ai bambini da 0 a 12 anni. Funhouse, Minizone, slittino, mini-kart, crazy kart, space golf con 9 percorsi, mini night club, ecc."
    ],
    "fr": [
      "A la sortie de Montbrison, l'équipage de Space Kid vous souhaite bienvenue à bord! Venez découvrir plus de 1200m² dédiés aux enfants de 0 à 12 ans. Funhouse, Minizone, luge, mini-kart, crazy kart, space golf fluo avec 9 parcours, mini boîte de nuit, etc.."
    ],
    "nl": [
      "Iets minder dan 3 km van Montbrison, wenst het team van Space Kid u van harte welkom aan boord!  Kom en ontdek een ruimte van 1200 m ² die helemaal gewijd is aan kinderen van 0 tot 12 jaar. Funhouse, Minizone, rodelen, Mini-kart, zalen om verjaardagen te vieren, mini-nightclub, enz."
    ],
    "es": [
      "A menos de 3 km de Montbrison, ¡la tripulación de Space Kid le da la bienvenida a bordo! Venga a descubrir sus 1200 m² dedicados a los niños de 0 a 12 años. Funhouse, minizona, trineo, mini-kart, salas de cumpleaños, mini discoteca, etc."
    ]
  },
