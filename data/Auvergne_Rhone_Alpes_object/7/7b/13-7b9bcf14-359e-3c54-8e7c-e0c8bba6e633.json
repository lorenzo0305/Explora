  "rdfs:comment": {
    "de": [
      "Theater mit 160 Plätzen, das seit 1988 besteht. Aufnahme von Theatergruppen, Uraufführungen der Compagnie de l'Iris, Unterstützung junger Teams, Festival les Turbulents und Brut de Fabrique, Amateur- und berufsvorbereitende Ausbildung."
    ],
    "en": [
      "A 160-seat theatre that has existed since 1988. Hosting of companies, creations of the Compagnie de l'Iris, support for young teams, festival les Turbulents and Brut de Fabrique, amateur and pre-professional training."
    ],
    "it": [
      "Un teatro da 160 posti che esiste dal 1988. Accoglienza di aziende, creazioni della Compagnie de l'Iris, sostegno alle giovani squadre, festival Turbulents e Brut de Fabrique, formazione amatoriale e pre-professionale."
    ],
    "fr": [
      "Théâtre de 160 places existant depuis 1988. Accueil de compagnies, créations de la Compagnie de l'Iris, soutien aux jeunes équipes, festival les Turbulents et Brut de Fabrique, formation amateur et préprofessionnelle."
    ],
    "es": [
      "Un teatro de 160 plazas que existe desde 1988. Acogida de compañías, creaciones de la Compagnie de l'Iris, apoyo a los equipos jóvenes, los festivales Turbulents y Brut de Fabrique, formación amateur y preprofesional."
    ],
    "nl": [
      "Een theater met 160 plaatsen dat sinds 1988 bestaat. Ontvangst van bedrijven, creaties van de Compagnie de l'Iris, ondersteuning van jonge teams, de festivals Turbulents en Brut de Fabrique, amateur- en pre-professionele opleidingen."
    ]
  },
