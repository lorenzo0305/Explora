  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/2b9c7086-5fe5-3377-b63a-191b17aab09f",
      "dc:description": {
        "de": [
          "Reparaturwerkstatt für alle Marken\n\nLKWs, PKWs, Nutzfahrzeuge und Busse.\nZulieferungen und Zubehör für LKW, SUV, PKW.\nReparatur, Wartung, Instandhaltung, allgemeine Mechanik,"
        ],
        "en": [
          "All-makes repair workshop\n\nTrucks, passenger cars, commercial vehicles and coaches.\nSupplies and accessories for HGVs, LCVs and MPVs.\nRepairs, maintenance, servicing, general mechanics,"
        ],
        "it": [
          "Officina di riparazione per tutte le marche\n\nVeicoli pesanti, autovetture, veicoli commerciali e pullman.\nForniture e accessori per mezzi pesanti, veicoli commerciali leggeri e veicoli commerciali leggeri.\nRiparazioni, manutenzione, assistenza, meccanica generale,"
        ],
        "fr": [
          "Atelier de réparation toute marque\n\nPoids lourds, véhicules de tourisme, véhicules utilitaires et autocars.\nFournitures et accessoires pour véhicules PL, VU, VL.\nRéparation, maintenance, entretien, mécanique générale,"
        ],
        "es": [
          "Taller de reparación para todas las marcas\n\nVehículos pesados, turismos, vehículos industriales y autocares.\nSuministros y accesorios para camiones, furgonetas y vehículos industriales ligeros.\nReparaciones, mantenimiento, revisiones, mecánica general,"
        ],
        "nl": [
          "Reparatiewerkplaats voor alle merken\n\nVrachtwagens, personenauto's, bedrijfswagens en touringcars.\nBenodigdheden en accessoires voor vrachtwagens, LGV's en LCV's.\nReparaties, onderhoud, service, algemene mechanica,"
        ]
      },
      "@type": [
        "Description"
      ],
