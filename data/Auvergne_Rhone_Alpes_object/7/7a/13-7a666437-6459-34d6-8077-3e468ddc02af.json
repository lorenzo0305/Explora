  "rdfs:comment": {
    "de": [
      "Dorf Paulhaguet: historisches Zentrum mit Fachwerkhaus, Überreste der alten Stadtmauer. In Censac: Ruine des ehemaligen Priorats aus dem 12. Jahrhundert (privat)."
    ],
    "en": [
      "Village of Paulhaguet: historic center with half-timbered houses, remains of the old town wall. In Censac, ruins of the 12th-century priory (private)."
    ],
    "it": [
      "Villaggio di Paulhaguet: centro storico con case a graticcio e resti della vecchia cinta muraria. A Censac, rovine dell'antico priorato del XII secolo (privato)."
    ],
    "fr": [
      "Village de Paulhaguet : Centre historique avec maison à pans de bois, vestiges de l’ancienne enceinte. À Censac, ruine de l’ancien prieuré du XIIe siècle (privé)."
    ],
    "es": [
      "Pueblo de Paulhaguet: centro histórico con casas de entramado de madera y restos de las antiguas murallas. En Censac, ruinas del antiguo priorato del siglo XII (privado)."
    ],
    "nl": [
      "Dorp Paulhaguet: historisch centrum met vakwerkhuizen en overblijfselen van de oude stadsmuren. In Censac, ruïnes van de voormalige priorij uit de 12e eeuw (privé)."
    ]
  },
