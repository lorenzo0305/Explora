  "rdfs:comment": {
    "de": [
      "CECINAT ist ein Unternehmen für Naturkosmetik und pflanzliche Kerzen mit Sitz in St-Marcel-Lès Valence. Ich biete eine Reihe von Wellness-Produkten mit Pflanzen an, die auf dem Familienbauernhof in BOURG-LES-VALENCE angebaut werden, wo ich auch DIY-Workshops anbiete."
    ],
    "en": [
      "CECINAT is a natural cosmetics and plant-based candles company based in St-Marcel-Lès Valence. I offer a range of well-being products using plants grown on my family's farm in BOURG-LES-VALENCE, where I also run DIY workshops."
    ],
    "it": [
      "CECINAT è un'azienda di cosmetici naturali e candele a base vegetale con sede a St-Marcel-Lès Valence. Offro una gamma di prodotti per il benessere utilizzando le piante coltivate nell'azienda agricola di famiglia a BOURG-LES-VALENCE, dove tengo anche dei laboratori di bricolage."
    ],
    "fr": [
      "CECINAT est une entreprise de cosmétiques naturels et de bougies végétales, basée à St-Marcel-Lès Valence. Je propose une gamme de produits bien-être avec les plantes cultivées sur la ferme familiale à BOURG-LES-VALENCE où je dispense des ateliers DIY."
    ],
    "nl": [
      "CECINAT is een bedrijf voor natuurlijke cosmetica en kaarsen op basis van planten in St-Marcel-Lès Valence. Ik bied een reeks welzijnsproducten aan op basis van planten die groeien op de familieboerderij in BOURG-LES-VALENCE, waar ik ook doe-het-zelf workshops geef."
    ],
    "es": [
      "CECINAT es una empresa de cosmética natural y velas vegetales con sede en St-Marcel-Lès Valence. Ofrezco una gama de productos de bienestar a base de plantas cultivadas en la granja de mi familia en BOURG-LES-VALENCE, donde también imparto talleres de bricolaje."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Cécinat - Ateliers cosmétiques"
    ]
  },
