  "rdfs:comment": {
    "de": [
      "Paul Trigueiro Pires ist Steingraveur in Loupiac gare. Er arbeitet sowohl für Namensstelen, z. B. für Beerdigungen, als auch für dekorative Objekte."
    ],
    "en": [
      "Paul Trigueiro Pires is a stone engraver based at Loupiac gare. He works on name plaques, funerary steles and decorative objects."
    ],
    "it": [
      "Paul Trigueiro Pires è un incisore di pietra con sede a Loupiac gare. Lavora su targhe onomastiche, targhe funerarie e oggetti decorativi."
    ],
    "fr": [
      "Paul Trigueiro Pires est graveur sur pierre à Loupiac gare. Il travaille aussi bien pour des stèles nominatives, funéraires par exemple, ou pour des objets décoratifs."
    ],
    "nl": [
      "Paul Trigueiro Pires is een steengraveur uit Loupiac gare. Hij werkt aan naamplaten, gedenkplaten en decoratieve objecten."
    ],
    "es": [
      "Paul Trigueiro Pires es un grabador de piedra que trabaja en la estación de Loupiac. Trabaja en placas con nombre, placas funerarias y objetos decorativos."
    ]
