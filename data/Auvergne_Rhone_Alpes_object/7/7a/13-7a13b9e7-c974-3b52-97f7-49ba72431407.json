  "rdfs:comment": {
    "de": [
      "Bouchayer-Viallet war Ende des 19. Jahrhunderts Schauplatz einer Industrie, die für die Entwicklung Grenobles von großer Bedeutung war."
    ],
    "en": [
      "At the end of the 19th century, Bouchayer-Viallet was the scene of an industry that played a major role in Grenoble's development."
    ],
    "it": [
      "Alla fine del XIX secolo, Bouchayer-Viallet fu teatro di un'importante industria per lo sviluppo di Grenoble."
    ],
    "fr": [
      "Bouchayer-Viallet fut à la fin du XIXe siècle le théâtre d'une industrie majeure pour le développement de Grenoble."
    ],
    "nl": [
      "Aan het eind van de 19e eeuw was Bouchayer-Viallet het toneel van een belangrijke industrie voor de ontwikkeling van Grenoble."
    ],
    "es": [
      "A finales del siglo XIX, Bouchayer-Viallet fue el escenario de una industria que desempeñó un papel fundamental en el desarrollo de Grenoble."
    ]
