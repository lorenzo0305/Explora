  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Kulturerbe und die Traditionen des Pays Lyonnais. 2 Dauerausstellungen über die römischen Aquädukte von Lyon und die Seidensamtweberei im West Lyonnais. Jedes Jahr wechselnde Ausstellungen über das Kulturerbe."
    ],
    "en": [
      "Share the passion of this association of history, archeology and folklore for roman aqueducts, heritage and traditions of \"Pays Lyonnais\" (area of about 100 villages located in the west of Lyon)."
    ],
    "it": [
      "Scoprite il patrimonio e le tradizioni della regione lionese. 2 mostre permanenti sugli acquedotti romani di Lione e sulla tessitura del velluto di seta nel Lionese occidentale. Ogni anno, mostre temporanee sul patrimonio."
    ],
    "fr": [
      "Découvrez le patrimoine et les traditions du Pays Lyonnais. 2 expositions permanentes sur les aqueducs romains de Lyon et le tissage du velours de soie dans l'Ouest Lyonnais. Tous les ans, des expositions temporaires sur le patrimoine."
    ],
    "nl": [
      "Ontdek het erfgoed en de tradities van de regio Lyonnais. 2 permanente tentoonstellingen over de Romeinse aquaducten van Lyon en het weven van zijdefluweel in het westen van Lyonnais. Elk jaar tijdelijke tentoonstellingen over erfgoed."
    ],
    "es": [
      "Descubra el patrimonio y las tradiciones de la región del Lyonnais. 2 exposiciones permanentes sobre los acueductos romanos de Lyon y el tejido del terciopelo de seda en el oeste lionés. Cada año, exposiciones temporales sobre el patrimonio."
    ]
  },
  "rdfs:label": {
