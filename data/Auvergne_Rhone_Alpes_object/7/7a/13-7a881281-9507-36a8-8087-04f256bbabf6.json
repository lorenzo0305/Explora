  "rdfs:comment": {
    "de": [
      "Tauchen Sie ein in die bezaubernde Welt von La Rose Trémière, wo die Magie im Herzen des malerischen Dorfes Polignac wirkt. Hier können Sie unser Know-how entdecken und sogar an kreativen Workshops teilnehmen!"
    ],
    "en": [
      "Immerse yourself in the enchanting world of La Rose Trémière, where magic happens in the heart of the picturesque village of Polignac. You can discover our expertise and even take part in creative workshops!"
    ],
    "it": [
      "Immergetevi nell'incantevole mondo de La Rose Trémière, dove la magia accade nel cuore del pittoresco villaggio di Polignac. Potrete scoprire il nostro know-how e partecipare a laboratori creativi!"
    ],
    "fr": [
      "Plongez dans l'univers envoûtant de La Rose Trémière, où la magie opère au cœur du village pittoresque de Polignac. Vous pourrez découvrir notre savoir-faire et même participer à des ateliers de création !"
    ],
    "es": [
      "Sumérjase en el encantador mundo de La Rose Trémière, donde la magia sucede en el corazón del pintoresco pueblo de Polignac. Descubra nuestra experiencia y participe en talleres creativos"
    ],
    "nl": [
      "Dompel jezelf onder in de betoverende wereld van La Rose Trémière, waar magie gebeurt in het hart van het pittoreske dorpje Polignac. Je kunt onze expertise ontdekken en zelfs deelnemen aan creatieve workshops!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Savonnerie La Rose Trémière et les Bougies de Polignac"
    ]
  },
