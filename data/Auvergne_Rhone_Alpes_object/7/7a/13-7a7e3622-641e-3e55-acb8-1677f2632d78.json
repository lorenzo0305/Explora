  "rdfs:comment": {
    "de": [
      "Alpes Lasergame befindet sich in der Nähe von Chambéry im Herzen der Achse Lyon ? Annecy / Aix les Bains / Rumilly ? Grenoble.\r\n\r\nDas ganze Jahr über an sieben Tagen in der Woche geöffnet (Reservierung erforderlich)."
    ],
    "en": [
      "Alpes Lasergame is located near Chambéry in the heart of the Lyon ? Annecy / Aix les Bains / Rumilly ? Grenoble.\r\n\r\nOpen all year round, 7 days a week by reservation."
    ],
    "it": [
      "Alpes Lasergame si trova vicino a Chambéry, nel cuore della regione di Lione? Annecy / Aix les Bains / Rumilly ? Grenoble.\r\n\r\nAperto tutto l'anno, 7 giorni su 7 su prenotazione."
    ],
    "fr": [
      "Alpes Lasergame est situé proche de Chambéry au coeur de l’axe Lyon – Annecy / Aix les Bains / Rumilly – Grenoble. \r\n\r\nOuvert toute l’année 7j/7 sur réservation."
    ],
    "nl": [
      "Alpes Lasergame ligt in de buurt van Chambéry in het hart van de Lyon ? Annecy / Aix les Bains / Rumilly ? Grenoble.\r\n\r\nHet hele jaar geopend, 7 dagen per week op afspraak."
    ],
    "es": [
      "Alpes Lasergame está situado cerca de Chambéry, en el corazón de la región Lyon ? Annecy / Aix les Bains / Rumilly ? Grenoble.\r\n\r\nAbierto todo el año, 7 días a la semana con cita previa."
    ]
  },
