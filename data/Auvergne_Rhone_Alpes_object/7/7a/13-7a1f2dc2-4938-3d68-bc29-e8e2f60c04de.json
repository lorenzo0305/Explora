  "rdfs:comment": {
    "de": [
      "Mehrmarkenladen und -werkstatt in der Nähe der Dolce Via und Viarhona.\r\n Verkauf von Fahrrädern (Kinder-, Mountainbike-, Elektrofahrräder) Ausrüstung, Zubehör, Diätetik / Reparaturwerkstatt / Fahrradverleih\r\nVerleih von Mountainbikes und VTTAE und Elektro-Rennrad."
    ],
    "en": [
      "Multibrand store and workshop near Dolce Via and Viarhona.\r\nSales of bicycles (children’s, hybrid, mountain bikes, electric), equipment, accessories, nutrition products / repair workshop / bike rental.\r\nRental of mountain bikes, electric mountain bikes, and electric road bikes."
    ],
    "it": [
      "Negozio e officina multimarca vicino alla Dolce Via e a Viarhona.\r\n Vendita di biciclette (per bambini, mountain bike, MTB, bici elettriche), attrezzature, accessori, dietetica / officina di riparazione / noleggio di biciclette\r\nNoleggio di mountain bike, ATV e bici elettriche da strada."
    ],
    "fr": [
      "Magasin et atelier multimarque à proximité de la Dolce Via et Viarhona.\r\n Vente de vélos (enfant, VTC, VTT, électriques) équipement, accessoires, diététique / atelier de réparation / location de vélos\r\nLocation de VTT et VTTAE et route électrique."
    ],
    "nl": [
      "Winkel en werkplaats met meerdere merken in de buurt van de Dolce Via en Viarhona.\r\n Verkoop van fietsen (kinderfietsen, mountainbikes, MTB's, elektrische fietsen), uitrusting, accessoires, voeding / reparatiewerkplaats / fietsverhuur\r\nVerhuur van mountainbikes, ATV's en elektrische racefietsen."
    ],
    "es": [
      "Tienda multimarca y taller cerca de la Dolce Via y Viarhona.\r\n Venta de bicicletas (infantiles, de montaña, BTT, eléctricas), equipamiento, accesorios, dietética / taller de reparación / alquiler de bicicletas\r\nAlquiler de bicicletas de montaña, ATV y bicicletas eléctricas de carretera."
    ]
  },
