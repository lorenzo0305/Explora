  "rdfs:comment": {
    "de": [
      "Le coing Bio, ein Bio-Lebensmittelgeschäft, bietet Ihnen eine große Auswahl an Produkten, Obst und Gemüse, losen Waren, Getränken und Spirituosen, lokalen Weinen und Bieren, Eiscreme und Brot. Lokale Produkte und Produkte aus anderen Regionen, sorgfältig ausgewählt, um Qualität und Vielfalt zu verbinden."
    ],
    "en": [
      "Le Coing Bio, an organic grocery store, offers a wide selection of products, including fruit and vegetables, bulk goods, drinks and spirits, local wines and beers, ice cream and bread. Local and imported products are carefully selected to combine quality and diversity."
    ],
    "it": [
      "Le Coing Bio, negozio di alimentari biologici, vi offre un'ampia scelta di prodotti, frutta e verdura, prodotti sfusi, bevande e alcolici, vini e birre locali, gelati e pane. Prodotti locali e internazionali, accuratamente selezionati per combinare qualità e diversità."
    ],
    "fr": [
      "Le coing Bio, épicerie BIO, vous propose un large choix de produits, fruits et légumes, vrac, boissons et alcools, vins et bières locales, glaces et pain. Des produits locaux et d'ailleurs, soigneusement sélectionnés afin d'allier qualité et diversité."
    ],
    "es": [
      "Le Coing Bio, tienda de comestibles BIO, le ofrece una amplia selección de productos, frutas y verduras, productos a granel, bebidas y licores, vinos y cervezas locales, helados y pan. Productos locales e internacionales, cuidadosamente seleccionados para combinar calidad y diversidad."
    ],
    "nl": [
      "De biologische kruidenier Le Coing Bio biedt u een ruime keuze aan producten, fruit en groenten, bulkgoederen, dranken en alcoholische dranken, lokale wijnen en bieren, ijs en brood. Lokale en buitenlandse producten, zorgvuldig geselecteerd om kwaliteit en diversiteit te combineren."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Epicerie Le Coing Bio"
    ]
  },
