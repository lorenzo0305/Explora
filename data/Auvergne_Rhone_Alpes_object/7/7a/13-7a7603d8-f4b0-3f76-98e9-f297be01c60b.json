  "rdfs:comment": {
    "de": [
      "Unser Team bietet Ihnen eine hausgemachte Familienküche für nur 15.90 Sie haben ein Menü aus einer Vorspeise ein Gericht des Tages ein Dessert, 1/4 Wein zusammen."
    ],
    "en": [
      "Our team proposes you to taste a home-made family cooking for only 15.90 you have a menu composed of a starter a dish of the day a dessert, 1/4 of wine."
    ],
    "it": [
      "Il nostro team vi offre una cucina casalinga e familiare a soli 15,90 con un menu composto da un antipasto, un piatto del giorno, un dessert, 1/4 di vino."
    ],
    "fr": [
      "Notre équipe vous propose de déguster une cuisine familiale fait maison  pour seulement 15.90 vous avez un menu composé d’une entrée un plat du jour un dessert ,1/4 de vin ."
    ],
    "nl": [
      "Ons team biedt je een huisgemaakte familiekeuken voor slechts 15,90 je hebt een menu bestaande uit een voorgerecht een dagschotel een dessert, 1/4 wijn."
    ],
    "es": [
      "Nuestro equipo te ofrece una cocina familiar casera por solo 15,90 tienes un menú compuesto por un entrante un plato del día un postre, 1/4 de vino."
