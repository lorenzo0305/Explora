  "rdfs:comment": {
    "de": [
      "Eine Dienerin von Madame de Sévigné hat in Grignan einen Brief zurückgelassen. Doch aus einem vergessenen Brief wird ein verschollener. Finde diesen Brief und beweise dir deine Sporen als Botin der Marquise. Ein Schatzsuch- und Rätselspiel."
    ],
    "en": [
      "A servant of Madame de Sévigné has left a letter behind in Grignan. But from a forgotten letter, the letter becomes a lost one. Find this letter and earn your stripes as the Marquise's messenger. A treasure hunt and puzzle game."
    ],
    "it": [
      "Un servitore di Madame de Sévigné ha dimenticato una lettera a Grignan. Ma la lettera è passata da essere dimenticata a essere persa. Trovate la lettera e guadagnatevi i gradi di messaggero della Marchesa. Caccia al tesoro e indovinelli."
    ],
    "fr": [
      "Un domestique de madame de Sévigné a oublié une lettre à Grignan. Mais de lettre oubliée, la Lettre devient lettre perdue. Retrouvez cette lettre et gagnez vos galons de messager de la marquise. Jeu de piste et d'énigmes."
    ],
    "es": [
      "Un criado de Madame de Sévigné ha olvidado una carta en Grignan. Pero la carta ha pasado de olvidada a perdida. Encuentra la carta y gánate tus galones como mensajero de la marquesa. Búsqueda del tesoro y acertijos."
    ],
    "nl": [
      "Een bediende van Madame de Sévigné is een brief vergeten in Grignan. Maar de brief is van vergeten naar verloren gegaan. Vind de brief en verdien je strepen als de boodschapper van de markiezin. Schattenjacht en raadsels."
    ]
  },
  "rdfs:label": {
    "de": [
