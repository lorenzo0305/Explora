  "rdfs:comment": {
    "de": [
      "Wir sind bildende Künstler: Maler, Bildhauer, Ausbilder für angewandte und bildende Kunst. Wir öffnen die Türen unseres Ateliers und zeigen Ihnen unsere Welt."
    ],
    "en": [
      "We are visual artists: painters, sculptors, instructors in applied arts and plastic arts. We open the doors of our studio and invite you to discover our world."
    ],
    "it": [
      "Siamo artisti visivi: pittori, scultori, istruttori di arti applicate e arti plastiche. Vi apriamo le porte del nostro studio per farvi scoprire il nostro mondo."
    ],
    "fr": [
      "Nous sommes artistes plasticiens : peintres, sculpteurs, formateurs en arts appliqués et arts plastiques. Nous ouvrons les portes de notre atelier et nous vous ferons découvrir notre univers."
    ],
    "nl": [
      "Wij zijn beeldend kunstenaars: schilders, beeldhouwers, docenten toegepaste kunst en beeldende kunst. We openen de deuren van ons atelier voor jou om onze wereld te ontdekken."
    ],
    "es": [
      "Somos artistas plásticos: pintores, escultores, profesores de artes aplicadas y artes plásticas. Te abrimos las puertas de nuestro estudio para que descubras nuestro mundo."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Atelier Pieris - Sculpture, peinture: réalisation et création"
    ]
  },
