  "rdfs:comment": {
    "de": [
      "Freie Besichtigung der Außenanlagen das ganze Jahr über. Führungen während der Saison, jedoch nur nach vorheriger Anmeldung. Führungen sind außerhalb der Saison für Gruppen und nach vorheriger Anmeldung möglich."
    ],
    "en": [
      "Self-guided exterior visits all year round. Guided tours in season by prior arrangement. Off-season guided tours for groups by prior arrangement."
    ],
    "it": [
      "Visite esterne non guidate tutto l'anno. Le visite guidate sono disponibili in stagione, ma devono essere prenotate in anticipo. Fuori stagione sono disponibili visite guidate per gruppi su prenotazione."
    ],
    "fr": [
      "Visite libre des extérieurs toute l'année. Visites guidées en saison mais sur réservation préalable. Visite guidée possible hors saison pour les groupes et sur réservation."
    ],
    "es": [
      "Visitas no guiadas al exterior durante todo el año. Las visitas guiadas están disponibles en temporada, pero deben reservarse con antelación. Fuera de temporada, se organizan visitas guiadas para grupos con reserva previa."
    ],
    "nl": [
      "Onbegeleide rondleidingen door de buitenkant het hele jaar door. Rondleidingen met gids zijn beschikbaar tijdens het seizoen, maar moeten van tevoren worden geboekt. Buiten het seizoen zijn rondleidingen voor groepen mogelijk op afspraak."
    ]
  },
