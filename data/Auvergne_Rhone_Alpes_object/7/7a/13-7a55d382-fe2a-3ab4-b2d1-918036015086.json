  "rdfs:comment": {
    "de": [
      "Le Ginko Biloba: ein idyllischer Rahmen, ein wunderschöner, geräumiger und baumbestandener Hof mitten im Dorf, eine freundliche Atmosphäre und ein herzlicher Empfang - eine einfache und schmackhafte Küche aus frischen und saisonalen Produkten, in der alles \"hausgemacht\" ist."
    ],
    "en": [
      "Le Ginko Biloba: an idyllic setting, a magnificent, spacious courtyard planted with trees right in the heart of the village, a friendly atmosphere and a warm welcome - simple, tasty cuisine based on fresh, seasonal produce where everything is \"home-made\"."
    ],
    "it": [
      "Il Ginko Biloba: un ambiente idilliaco, un magnifico cortile, ampio e alberato nel cuore del villaggio, un'atmosfera amichevole e un'accoglienza calorosa - una cucina semplice e gustosa a base di prodotti freschi e di stagione dove tutto è \"fatto in casa\"."
    ],
    "fr": [
      "Le Ginko Biloba : un cadre idyllique, une cour magnifique, spacieuse et arborée en plein cœur du village, une ambiance conviviale et un accueil chaleureux - une cuisine simple et savoureuse à base de produits frais et de saison où tout est \"fait maison\"."
    ],
    "es": [
      "El Ginko Biloba: un entorno idílico, un magnífico patio, amplio y arbolado en el corazón del pueblo, un ambiente acogedor y una cálida bienvenida, una cocina sencilla y sabrosa basada en productos frescos y de temporada donde todo es \"casero\"."
    ],
    "nl": [
      "De Ginko Biloba: een idyllische omgeving, een prachtige binnenplaats, ruim en beplant met bomen in het hart van het dorp, een vriendelijke sfeer en een warm welkom - een eenvoudige en smakelijke keuken op basis van verse en seizoensgebonden producten waar alles \"huisgemaakt\" is."
    ]
  },
  "rdfs:label": {
