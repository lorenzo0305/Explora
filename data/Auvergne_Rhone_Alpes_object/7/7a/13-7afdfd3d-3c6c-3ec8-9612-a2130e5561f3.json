  "rdfs:comment": {
    "de": [
      "Das Conservatoire ist ein \"Garten\" mit alten Rebsorten, die früher in der Region Saint-Pourçain zur Weinherstellung verwendet wurden. Es wurde Ende der 1990er Jahre auf dem Gelände des Château de Chareil angepflanzt."
    ],
    "en": [
      "The Conservatoire will introduce you to the ancient grape varieties once used to make Saint-Pourçain wines."
    ],
    "it": [
      "Il Conservatoire è un \"giardino\" di antichi vitigni un tempo utilizzati per la produzione di vini nella regione di Saint-Pourçain, piantato alla fine degli anni '90 sul sito del Château de Chareil."
    ],
    "fr": [
      "Le Conservatoire est un \"jardin\" de cépages anciens autrefois utilisés pour produire des vins dans la région de Saint-Pourçain, planté à la fin des années 90 sur le site du château de Chareil."
    ],
    "nl": [
      "Het conservatorium laat u kennis maken met de oude druivensoorten die worden gebruikt bij het maken van Saint-Pourçain-wijnen."
    ],
    "es": [
      "El Conservatorio es un \"jardín\" de antiguas variedades de uva utilizadas antaño para producir vinos en la región de Saint-Pourçain, plantado a finales de los años 90 en el emplazamiento del castillo de Chareil."
    ]
  },
  "rdfs:label": {
    "en": [
      "Conservatory for old vine varieties"
    ],
    "fr": [
      "Conservatoire des Anciens Cépages de Saint-Pourçain"
    ],
    "nl": [
      "Conservatoire des anciens cépages"
    ]
  },
