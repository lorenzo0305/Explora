  "rdfs:comment": {
    "de": [
      "Die 1898 gegründete lokale Institution bietet Menüs aus frischen Zutaten an. Das Tagesmenü und die Vorschläge ändern sich je nach Saison und Angebot"
    ],
    "en": [
      "Founded in 1898, the Brasserie d’Aurillac is steeped in history serving delicious menus using fresh and seasonal produce. The menu of the day and our specials change with the seasons and depending on the availability of produce."
    ],
    "it": [
      "Fondata nel 1898, questa istituzione locale offre menu a base di prodotti freschi, con un menu giornaliero e proposte che cambiano con le stagioni e i nuovi arrivi"
    ],
    "fr": [
      "Fondée en 1898, cette institution locale propose des menus élaborés à partir de produits frais. Le menu du jour et les suggestions changent au fil des saisons et des arrivages. "
    ],
    "es": [
      "Fundada en 1898, esta institución local ofrece menús basados en productos frescos, con una carta diaria y sugerencias que cambian con las estaciones y las novedades"
    ],
    "nl": [
      "Dit lokale instituut werd opgericht in 1898 en biedt menu's gebaseerd op verse producten, met een dagelijks menu en suggesties die veranderen met de seizoenen en nieuwe aankomsten"
    ]
  },
