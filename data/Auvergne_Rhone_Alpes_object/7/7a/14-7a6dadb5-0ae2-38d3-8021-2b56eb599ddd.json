      "@id": "https://data.datatourisme.fr/d3e6f8ee-d15c-3f7e-896a-b3ad0013c233",
      "dc:description": {
        "de": [
          "Montag, 10. April 2023\n\nPony-Animationen - Eiersuche von 10:00 bis 12:00 Uhr.\nSpiele, Herausforderungen, Animationen im gesamten Reitpark.\nEinschreibung: 20 ?\nOffen für Reiter von 6 bis 11 Jahren."
        ],
        "en": [
          "Monday, April 10, 2023\n\nPony entertainment - Egg hunt from 10am to 12pm.\nGames, challenges, entertainment throughout the equestrian park.\nRegistration fee: 20?\nOpen to riders aged 6 to 11."
        ],
        "it": [
          "Lunedì 10 aprile 2023\n\nAnimazione con i pony - Caccia alle uova dalle 10.00 alle 12.00.\nGiochi, sfide e intrattenimento in tutto il parco equestre.\nIscrizione: 20?\nAperto ai cavalieri dai 6 agli 11 anni."
        ],
        "fr": [
          "Lundi 10 avril 2023\n\nAnimations poneys - Chasse aux oeufs de 10h à 12h.\nJeux, défis, animations dans tout le parc équestre.\nInscription : 20€\nOuvert aux cavaliers de 6 à 11 ans."
        ],
        "nl": [
          "Maandag 10 april 2023\n\nPony entertainment - Eieren zoeken van 10.00 tot 12.00 uur.\nSpelletjes, uitdagingen en entertainment in het hele ruiterpark.\nInschrijving: 20?\nOpen voor ruiters van 6 tot 11 jaar."
        ],
        "es": [
          "Lunes 10 de abril de 2023\n\nEntretenimiento para ponis - Búsqueda del huevo de 10:00 a 12:00 horas.\nJuegos, desafíos y entretenimiento en todo el parque ecuestre.\nInscripción: 20?\nAbierto a jinetes de 6 a 11 años."
        ]
      },
