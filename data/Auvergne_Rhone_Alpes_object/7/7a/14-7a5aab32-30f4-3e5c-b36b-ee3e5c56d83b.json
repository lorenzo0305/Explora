      "@id": "https://data.datatourisme.fr/38b7327e-fc8b-32eb-affb-8576cc036b65",
      "dc:description": {
        "de": [
          "Workshop zur Herstellung von Maracas\nVon 14:30 bis 16:30 Uhr in der Mediathek für Kinder ab 03 Jahren in Begleitung eines Elternteils - Kostenlos nach Anmeldung unter 03 91 90 14 00 -\nmediatheque@ville-leportel.fr"
        ],
        "en": [
          "Maracas-making workshop\nFrom 2:30 to 4:30 pm at the médiathèque for children aged 03 and over accompanied by a parent - Free on registration at 03 91 90 14 00 -\nmediatheque@ville-leportel.fr"
        ],
        "it": [
          "Laboratorio di costruzione di maracas\nDalle 14.30 alle 16.30 presso la biblioteca multimediale per bambini a partire dai 03 anni accompagnati da un genitore - Gratuito su iscrizione al numero 03 91 90 14 00 -\nmediatheque@ville-leportel.fr"
        ],
        "fr": [
          "Atelier de fabrication de maracas\nDe 14h30 à 16h30 à la médiathèque pour les enfants à partir de 03 ans accompagnés d'un parent - Gratuit sur inscriptions au 03 91 90 14 00 -\nmediatheque@ville-leportel.fr"
        ],
        "nl": [
          "Workshop maracas maken\nVan 14.30 tot 16.30 uur in de mediatheek voor kinderen vanaf 03 jaar onder begeleiding van een ouder - Gratis na inschrijving op 03 91 90 14 00 -\nmediatheque@ville-leportel.fr"
        ],
        "es": [
          "Taller de fabricación de maracas\nDe 14.30 a 16.30 h en la biblioteca multimedia para niños a partir de 3 años acompañados de sus padres - Gratuito previa inscripción en el 03 91 90 14 00 -\nmediatheque@ville-leportel.fr"
        ]
      },
