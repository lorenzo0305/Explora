  "rdfs:comment": {
    "de": [
      "Dieses Restaurant liegt im Herzen des Allier in einem kleinen traditionellen Dorf und bietet Ihnen eine traditionelle Küche, die mit lokalen Produkten aus handwerklicher Herstellung zubereitet wird. Spezialität aus der Auvergne."
    ],
    "en": [
      "Located in the heart of the Allier in a small traditional village, this restaurant shares its traditional cuisine with you, made with local artisanal products. Auvergne specialty."
    ],
    "it": [
      "Situato nel cuore dell'Allier, in un piccolo villaggio tradizionale, questo ristorante offre una cucina tradizionale a base di prodotti locali e fatti in casa. Specialità dell'Alvernia."
    ],
    "fr": [
      "Situé au cœur de l’Allier dans un petit village traditionnel, ce restaurant vous fait partager sa cuisine traditionnelle et élaborée avec des produits locaux de fabrication artisanale. Spécialité auvergnate."
    ],
    "es": [
      "Situado en el corazón del Allier, en un pequeño pueblo tradicional, este restaurante ofrece una cocina tradicional elaborada con productos locales y caseros. Especialidad de Auvergne."
    ],
    "nl": [
      "Gelegen in het hart van de Allier in een klein traditioneel dorp, deelt dit restaurant zijn traditionele keuken met u, bereid met lokale, zelfgemaakte producten. Specialiteit uit de Auvergne."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Truffade du Saint-Eloi"
    ]
  },
