  "rdfs:comment": {
    "de": [
      "Der Lac de Véron ist ein Forellenangelgebiet auf dem Plateau Nord Ardèchois in der Region Ardèche Hautes Vallées.\r\nHier können Sie mit der Natur in Kontakt treten und mit Freunden oder der Familie angeln."
    ],
    "en": [
      "The Véron lake is a trout fishing site nestled on the North Ardèchois plateau on the Ardèche Hautes Vallées territory.\r\nIn the heart of an amazing setting, reconnect with nature during a fishing trip with friends or family."
    ],
    "it": [
      "Il Lac de Véron è un lago per la pesca alla trota situato sull'altopiano del Nord Ardèchois, nella regione dell'Ardèche Hautes Vallées.\r\nNel cuore di un ambiente incantevole, riconnettetevi con la natura per una battuta di pesca con gli amici o la famiglia."
    ],
    "fr": [
      "Le lac de Véron est un site de pêche à la truite niché sur le plateau Nord Ardèchois sur le territoire Ardèche Hautes Vallées.\r\nAu sein d’un cadre émerveillant, reconnectez-vous avec la nature le temps d’une partie de pêche entre amis ou en famille."
    ],
    "nl": [
      "Lac de Véron is een meer voor het vissen op forel, gelegen op het plateau van de Nord Ardèchois in de Ardèche Hautes Vallées.\r\nIn het hart van een betoverende omgeving kunt u weer in contact komen met de natuur om te vissen met vrienden of familie."
    ],
    "es": [
      "El Lac de Véron es un lago de pesca de truchas situado en la meseta del Nord Ardèchois, en los Altos Valles de Ardèche.\r\nEn un entorno encantador, reconéctese con la naturaleza para pescar en familia o entre amigos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le lac de Véron : site de pêche à la mouche"
    ]
  },
