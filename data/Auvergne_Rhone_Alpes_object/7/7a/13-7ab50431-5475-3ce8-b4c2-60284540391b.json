  "rdfs:comment": {
    "de": [
      "Ein ganz außergewöhnliches Ensemble von Wandteppichen aus dem 16. Jh.! Ein fantastisches Bestiarium mit zehn Aubusson-Grünschnitten in einem Schloss aus dem 15. Jh....."
    ],
    "en": [
      "This castle built during the 15th century was the seat of a seigniory belonging to the Montclar family. On the two floors several tapestries are on view: “Le Bestaire Fantastique” (fantastic bestiary) and ten Aubusson Verdure tapestries from the 16th century"
    ],
    "it": [
      "Un'eccezionale collezione di arazzi del XVI secolo! Un Bestiario Fantastico con dieci verdi Aubusson in un castello del XV secolo...."
    ],
    "fr": [
      "Un ensemble de tapisseries du XVIème s. tout à fait exceptionnel ! Un Bestiaire Fantastique avec dix verdures d'Aubusson dans un château du XVème s...."
    ],
    "es": [
      "Una excepcional colección de tapices del siglo XVI Un bestiario fantástico con diez verdes de Aubusson en un castillo del siglo XV...."
    ],
    "nl": [
      "Een uitzonderlijke collectie 16e eeuwse wandtapijten! Een fantastisch bestiarium met tien Aubussons in een 15e eeuws kasteel...."
    ]
  },
