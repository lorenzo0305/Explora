  "rdfs:comment": {
    "de": [
      "Sie können die Zeitschriften, Bücher und DVDs, die Ihnen zur Verfügung stehen, entdecken, vor Ort lesen und dabei den Blick auf den Park genießen und sich anmelden, um die Dokumente mit nach Hause zu nehmen."
    ],
    "en": [
      "You can discover the magazines, books and DVDs on offer, read on site while enjoying the view of the park, and sign up to take documents home with you."
    ],
    "it": [
      "È possibile scoprire le riviste, i libri e i DVD disponibili, leggere sul posto godendo della vista del parco e registrarsi per portare a casa i documenti."
    ],
    "fr": [
      "Vous pourrez découvrir les revues, livres et DVD qui sont à votre disposition, lire sur place en profitant de la vue sur le parc, et vous inscrire pour emporter les documents chez vous."
    ],
    "es": [
      "Puede descubrir las revistas, libros y DVD disponibles, leer in situ mientras disfruta de la vista del parque y registrarse para llevarse los documentos a casa."
    ],
    "nl": [
      "Je kunt de aangeboden tijdschriften, boeken en dvd's ontdekken, ter plekke lezen terwijl je geniet van het uitzicht over het park en je inschrijven om documenten mee naar huis te nemen."
    ]
  },
