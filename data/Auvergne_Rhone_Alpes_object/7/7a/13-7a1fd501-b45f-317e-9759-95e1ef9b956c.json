  "rdfs:comment": {
    "de": [
      "Dieses Restaurant bietet Ihnen Tagesmenüs an.\r\nAn schönen Tagen ist das Restaurant den ganzen Tag über geöffnet, um die schattige Terrasse zu nutzen.\r\nAm Wochenende kann das Restaurant für Gruppen privatisiert werden."
    ],
    "en": [
      "The restaurant offers daily menus.\r\nWhen the weather is fine, the restaurant is open all day to enjoy the shady terrace.\r\nThe restaurant can be reserved for groups at weekends."
    ],
    "it": [
      "Il ristorante offre menù giornalieri.\r\nQuando il tempo è bello, il ristorante è aperto tutto il giorno e si può godere della terrazza ombreggiata.\r\nIl ristorante può essere prenotato per gruppi nei fine settimana."
    ],
    "fr": [
      "Ce restaurant vous propose des menus du jour. \r\nAux beaux jours, le restaurant est ouvert toute la journée pour profiter de la terrasse ombragée. \r\nLe restaurant peut être privatisé le week-end pour des groupes."
    ],
    "nl": [
      "Het restaurant biedt dagmenu's.\r\nBij mooi weer is het restaurant de hele dag geopend zodat je kunt genieten van het schaduwrijke terras.\r\nHet restaurant kan in het weekend gereserveerd worden voor groepen."
    ],
    "es": [
      "El restaurante ofrece menús diarios.\r\nCuando hace buen tiempo, el restaurante está abierto todo el día para disfrutar de la terraza a la sombra.\r\nEl restaurante se puede reservar para grupos los fines de semana."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant Au Rhône et Loire"
    ]
  },
