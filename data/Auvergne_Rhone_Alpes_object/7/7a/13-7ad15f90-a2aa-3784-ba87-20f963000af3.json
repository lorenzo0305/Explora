  "rdfs:comment": {
    "de": [
      "Willkommen im P'tit Bistrot, Ihrem neuen Treffpunkt für Feinschmecker im Herzen des Zentrums von Vienne! Jeden Monat bieten wir Ihnen eine neue Speisekarte, auf der frische und saisonale Produkte im Vordergrund stehen, um Ihnen ein schönes kulinarisches Erlebnis zu bieten."
    ],
    "en": [
      "Welcome to P'tit Bistrot, your new gourmet meeting place in the heart of Vienne! Every month, we offer you a new menu featuring fresh, seasonal produce, for a delightful culinary experience."
    ],
    "it": [
      "Benvenuti al P'tit Bistrot, il vostro nuovo punto d'incontro gastronomico nel cuore del centro di Vienne! Ogni mese vi proponiamo un nuovo menu a base di prodotti freschi di stagione, per un'esperienza culinaria eccezionale."
    ],
    "fr": [
      "Bienvenue au P'tit Bistrot, votre nouveau lieu de rendez-vous gourmand au cœur du centre de Vienne ! Chaque mois, nous vous proposons une nouvelle carte mettant à l'honneur des produits frais et de saison, pour vivre une belle expérience culinaire."
    ],
    "nl": [
      "Welkom bij P'tit Bistrot, uw nieuwe gastronomische ontmoetingsplaats in het hart van het centrum van Vienne! Elke maand bieden we je een nieuw menu met verse seizoensproducten, voor een geweldige culinaire ervaring."
    ],
    "es": [
      "Bienvenido a P'tit Bistrot, su nuevo punto de encuentro gastronómico en pleno centro de Vienne Cada mes, le proponemos un nuevo menú a base de productos frescos de temporada, para vivir una gran experiencia culinaria."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le P'tit Bistrot"
    ]
  },
