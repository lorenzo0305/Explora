  "rdfs:comment": {
    "de": [
      "In Partnerschaft mit dem Hispanischen Kulturzentrum, anlässlich des Festivals La Movida.  TCHAMÀN verkörpert das Zusammentreffen von Musik und Tanz, die Tradition des Flamenco in einer zeitgenössischen Neuinterpretation."
    ],
    "en": [
      "In partnership with the Centre Culturel Hispanique, on the occasion of the La Movida festival.  TCHAMÀN embodies the meeting of music and dance, the flamenco tradition in a contemporary revisitation."
    ],
    "it": [
      "In collaborazione con il Centre Culturel Hispanique, nell'ambito del festival La Movida.  TCHAMÀN incarna l'incontro tra musica e danza, la tradizione del flamenco in una rivisitazione contemporanea."
    ],
    "fr": [
      "En partenariat avec le Centre Culturel Hispanique, à l'occasion du festival La Movida.  TCHAMÀN incarne la rencontre entre la musique et la danse, la tradition du flamenco dans une revisitation contemporaine."
    ],
    "nl": [
      "In samenwerking met het Centre Culturel Hispanique, als onderdeel van het festival La Movida.  TCHAMÀN belichaamt de ontmoeting tussen muziek en dans, de traditie van de flamenco in een eigentijdse revisie."
    ],
    "es": [
      "En colaboración con el Centre Culturel Hispanique, en el marco del festival La Movida.  TCHAMÀN encarna el encuentro de la música y la danza, la tradición del flamenco en una revisitación contemporánea."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Spectacle de flamenco \"Tchamàn\""
    ]
  },
