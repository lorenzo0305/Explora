  "rdfs:comment": {
    "de": [
      "Schafwolle aus dem Zentralmassiv: Decken, Garne, Entspannungsmatten, Mode- und Bettzubehör, Kleidung, ätherische Öle, Kurzwaren, ökologische Isolierung. Entdeckungsbesuch nach Voranmeldung."
    ],
    "en": [
      "Sheep's wool from the Massif Central: blankets, yarns, relaxation rugs, fashion and bedding accessories, clothing, essential oils, haberdashery, ecological insulation. Discovery tour on reservation."
    ],
    "it": [
      "Lana di pecora del Massiccio Centrale: coperte, filati, tappeti relax, accessori moda e per il letto, abbigliamento, oli essenziali, merceria, isolamento ecologico. Visita di scoperta su prenotazione."
    ],
    "fr": [
      "Laine de mouton du Massif central  : couvertures, fils, tapis de relaxation, accessoires de mode et de literie, vêtements, huiles essentielles, mercerie, isolant écologique. Visite découverte sur réservation."
    ],
    "nl": [
      "Schapenwol uit het Centraal Massief: dekens, garens, relaxatiedekens, mode- en bedaccessoires, kleding, essentiële oliën, fournituren, ecologische isolatie. Ontdekkingstocht op afspraak."
    ],
    "es": [
      "Lana de oveja del Macizo Central: mantas, hilos, alfombras de descanso, accesorios de moda y ropa de cama, prendas de vestir, aceites esenciales, mercería, aislantes ecológicos. Visita de descubrimiento previa concertación."
    ]
  },
  "rdfs:label": {
