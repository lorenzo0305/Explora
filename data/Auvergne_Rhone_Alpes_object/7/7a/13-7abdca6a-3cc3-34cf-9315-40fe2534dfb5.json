  "rdfs:comment": {
    "de": [
      "Ruhige und natürliche Umgebung\r\nSpezialitäten: frische Frösche, Huhn in Sahnesoße, hausgemachte Foie gras. Spielfeld für Petanque. Großer Parkplatz. Überdachte und beheizte Terrasse und schattige Terrasse..."
    ],
    "en": [
      "Natural environment. Ponds of fishing nearby. \r\nSpecialities: frogs, chicken with the cream, the foie gras home made. Petanque field. Car park."
    ],
    "it": [
      "Ambiente tranquillo e naturale\r\nSpecialità: rane fresche, pollo in salsa di panna, foie gras fatto in casa. Campo da petanque. Ampio parcheggio. Terrazza coperta e riscaldata e terrazza ombreggiata."
    ],
    "fr": [
      "Cadre calme au naturel. \r\nSpécialités: grenouilles fraîches, poulet à la crème, foie gras maison. Terrain de pétanque. Grand parking. Terrasse couverte et chauffée et terrasse ombragée.."
    ],
    "nl": [
      "Rustige en natuurlijke omgeving\r\nSpecialiteiten: verse kikkers, kip in roomsaus, huisgemaakte foie gras. Petanque baan. Grote parkeerplaats. Overdekt en verwarmd terras en schaduwrijk terras."
    ],
    "es": [
      "Entorno tranquilo y natural\r\nEspecialidades: ranas frescas, pollo a la crema, foie gras casero. Pista de petanca. Amplio aparcamiento. Terraza cubierta y climatizada y terraza sombreada."
    ]
  },
  "rdfs:label": {
    "en": [
      "Au Coin Perdu"
    ],
    "fr": [
      "Au Coin Perdu"
    ]
  },
