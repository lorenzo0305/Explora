  "rdfs:comment": {
    "de": [
      "Unterricht, Entdeckung, Einführung und Perfektionierung der Kunden der Mountainbike-Praxis\r\nYann, diplomierter Lehrer - Guide MCF, begleitet Sie vom ersten Tritt in die Pedale bis zur Perfektionierung für alle Arten von Mountainbiking und Mountainbiking mit Elektrounterstützung."
    ],
    "en": [
      "Teaching, discovery, initiation and improvement of mountain biking. \r\nYann, a qualified MCF Instructor and Guide, will guide you from the first pedal stroke to advanced level for all types of mountain biking and electrically-assisted mountain biking."
    ],
    "it": [
      "Insegnare, scoprire, introdurre e perfezionare la mountain bike per i nostri clienti\r\nYann, istruttore-guida qualificato MCF, vi guiderà dalla prima pedalata fino all'allenamento avanzato per tutti i tipi di mountain bike e di mountain bike a pedalata assistita."
    ],
    "fr": [
      "Enseignement, découverte, initiation et perfectionnement de la clientèle de la pratique du VTT \r\nYann, Moniteur - Guide MCF diplômé, vous accompagne du premier coup de pédale au perfectionnement pour toutes les pratiques VTT et VTT à assistance électrique."
    ],
    "es": [
      "Enseñar, descubrir, iniciar y perfeccionar la bicicleta de montaña a nuestros clientes\r\nYann, Instructor-Guía MCF cualificado, le guiará desde la primera pedalada hasta el entrenamiento avanzado de todos los tipos de bicicleta de montaña y de bicicleta de montaña con asistencia eléctrica."
    ],
    "nl": [
      "Aanleren, ontdekken, introduceren en perfectioneren van mountainbikevaardigheden. \r\nYann, een gekwalificeerde MCF instructeur en gids, zal je begeleiden vanaf de eerste pedaalslag tot gevorderd niveau voor alle soorten mountainbiken en elektrisch ondersteund mountainbiken."
    ]
  },
