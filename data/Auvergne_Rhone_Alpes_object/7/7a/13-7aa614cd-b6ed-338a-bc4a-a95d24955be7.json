  "rdfs:comment": {
    "de": [
      "Ein raffiniertes und elegantes Wellnesskonzept für Körper und Geist in Le Vans mit einem privaten Friseurbereich und einem ganzheitlichen Bereich mit einem Angebot an Massagen (Kalifornische, Schwedische, Ayurvedische, Tantrische Massagen) und Energiebehandlungen."
    ],
    "en": [
      "A refined and elegant body and mind wellness concept at Le Vans, with a private hairdressing area and a holistic area offering massages (Californian, Swedish, Ayurvedic, Tantric) and energy treatments."
    ],
    "it": [
      "Un concetto di benessere del corpo e della mente raffinato ed elegante a Le Vans, con un'area parrucchieri privata e un'area olistica che offre massaggi (californiano, svedese, ayurvedico, tantrico) e trattamenti energetici."
    ],
    "fr": [
      "Un concept bien-être corps et esprit raffiné et élégant , au Vans . avec un espace Coiffure privatif et un espace holistique avec une  proposition de massages (Californiens, Suédois, Ayurvédique , Tantrique) et des soins énergétiques."
    ],
    "es": [
      "Un concepto de bienestar corporal y mental refinado y elegante en Le Vans, con una zona de peluquería privada y un espacio holístico que ofrece masajes (californiano, sueco, ayurvédico, tántrico) y tratamientos energéticos."
    ],
    "nl": [
      "Een geraffineerd en elegant wellnessconcept voor lichaam en geest in Le Vans, met een privékappersruimte en een holistische ruimte met massages (Californisch, Zweeds, Ayurvedisch, Tantrisch) en energiebehandelingen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Maison Bruno Di Salvio - Coiffure et Massage"
    ]
  },
