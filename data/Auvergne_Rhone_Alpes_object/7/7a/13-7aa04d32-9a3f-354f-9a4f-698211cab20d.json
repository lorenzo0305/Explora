  "rdfs:comment": {
    "de": [
      "Die Bibliothek von Rochemaure ist seit dem 18. Juni 2019 geöffnet und heißt Sie herzlich willkommen. Sie wird von einem Team geleitet, das aus einem Dutzend Freiwilliger besteht, die Ihnen mit einem Lächeln helfen, einen angenehmen Moment des Lesens zu teilen."
    ],
    "en": [
      "Open since June 18, 2019, the library of Rochemaure welcomes you. It is managed by a team of a dozen volunteers who will help you with a smile to share a pleasant moment of reading."
    ],
    "it": [
      "Aperta dal 18 giugno 2019, la biblioteca di Rochemaure vi dà il benvenuto. È gestito da un team di una dozzina di volontari che vi aiuteranno con un sorriso a condividere un piacevole momento di lettura."
    ],
    "fr": [
      "Ouverte depuis le 18 juin 2019, la bibliothèque de Rochemaure vous accueille. Elle est gérée par une équipe constituée d’une douzaine de bénévoles qui vous aideront avec le sourire à partager un moment de lecture agréable."
    ],
    "nl": [
      "Open sinds 18 juni 2019, de bibliotheek van Rochemaure heet u welkom. Het wordt beheerd door een team van een tiental vrijwilligers die u met een glimlach helpen bij een aangenaam leesmoment."
    ],
    "es": [
      "Abierta desde el 18 de junio de 2019, la biblioteca de Rochemaure le da la bienvenida. Está gestionado por un equipo de una docena de voluntarios que le ayudarán con una sonrisa a compartir un agradable momento de lectura."
    ]
  },
  "rdfs:label": {
