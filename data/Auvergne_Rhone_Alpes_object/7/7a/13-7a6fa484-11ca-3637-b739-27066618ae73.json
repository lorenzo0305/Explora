  "rdfs:comment": {
    "de": [
      "Ein Ort zur Beobachtung der forézianischen Teiche und ihrer Wildvögel sowie\r\nzur Entdeckung des natürlichen, historischen und menschlichen Erbes dieser\r\nFeuchtgebiete."
    ],
    "en": [
      "A place of observation of the Forez ponds and their wild birds and\r\na place to discover the natural, historical and human heritage of\r\nthese wetlands."
    ],
    "it": [
      "La Maison des Etangs du Forez si trova nel cuore della Riserva di Biterne. Dal 1987 accoglie i visitatori e osserva gli uccelli selvatici, con guide a disposizione tra aprile e ottobre."
    ],
    "fr": [
      "La maison des Etangs du Forez est située au cœur de la Réserve de Biterne. C'est un lieu d'accueil et d'observation d'oiseaux sauvages depuis 1987, les animateurs vous accueillent entre avril et octobre."
    ],
    "es": [
      "La Maison des Etangs du Forez está situada en el corazón de la Reserva de Biterne. Desde 1987 acoge a visitantes y observadores de aves silvestres, con guías a su disposición entre abril y octubre."
    ],
    "nl": [
      "Het Maison des Etangs du Forez ligt in het hart van het reservaat van Biterne. Het ontvangt bezoekers en observeert wilde vogels sinds 1987, met gidsen die je tussen april en oktober verwelkomen."
    ]
  },
