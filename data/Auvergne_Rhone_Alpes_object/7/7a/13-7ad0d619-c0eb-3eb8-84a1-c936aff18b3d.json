  "rdfs:comment": {
    "de": [
      "Christine hat ein Diplom in intermodaler Kunsttherapie und ist außerdem Krankenschwester und bildende Künstlerin.\r\nSie empfängt Sie in ihrem Atelier für Einzel- oder Gruppensitzungen (Samstagvormittag 1x pro Monat in Messery)Sitzungen zu Hause sind möglich."
    ],
    "en": [
      "Graduated in intermodal art therapy, Christine is also a nurse and a visual artist.\r\nShe welcomes you in her studio for individual or group sessions (Saturday mornings once a month in Messery)."
    ],
    "it": [
      "Laureata in arteterapia intermodale, Christine è anche infermiera e artista visiva\r\nVi accoglie nel suo studio per sessioni individuali o di gruppo (il sabato mattina una volta al mese a Messery)."
    ],
    "fr": [
      "Diplômée en Art thérapie intermodale, Christine est également infirmière et artiste  plasticienne  \r\nElle vous accueille dans son atelier pour des séances en individuel ou en groupe(samedi matin 1x par mois à Messery)des séances à domicile sont possibles."
    ],
    "es": [
      "Diplomada en arteterapia intermodal, Christine es también enfermera y artista plástica\r\nTe recibe en su estudio para sesiones individuales o en grupo (los sábados por la mañana una vez al mes en Messery)."
    ],
    "nl": [
      "Christine, afgestudeerd in intermodale kunstzinnige therapie, is ook verpleegster en beeldend kunstenares\r\nZij verwelkomt u in haar atelier voor individuele of groepssessies (één keer per maand op zaterdagochtend in Messery)."
    ]
  },
  "rdfs:label": {
    "de": [
      "Kunsttherapie, vom Unbekannten zum Möglichen"
    ],
    "en": [
      "Art therapy, from the unknown to the possible"
    ],
    "fr": [
      "Art-Thérapie, de l'inconnu aux possibles"
    ]
  },
