  "rdfs:comment": {
    "de": [
      "Boisset, wie die \"pays\" sagen, hat seinen Namen von einem bescheidenen Heiligtum aus dem Mittelalter, das in den riesigen Hochwäldern, die die Region bedeckten, verloren ging (boissetum auf Lateinisch bedeutet kleiner Wald)."
    ],
    "en": [
      "Boisset, as the \"countries\" say, takes its name from a modest sanctuary of the Middle Ages lost in the immensity of the forests that covered the region (boissetum in Latin meaning small wood)."
    ],
    "it": [
      "Boisset, come dicono i \"pays\", prende il nome da un modesto santuario del Medioevo perso nell'immensità delle foreste che ricoprivano la regione (boissetum in latino significa piccolo bosco)."
    ],
    "fr": [
      "Boisset, comme disent les « pays » tire son nom d’un modeste sanctuaire du Moyen Age perdu dans l’immensité des futaies qui couvraient la région (boissetum en latin signifiant petit bois)."
    ],
    "nl": [
      "Boisset, zoals de \"pays\" zeggen, ontleent zijn naam aan een bescheiden heiligdom uit de Middeleeuwen dat verloren ging in de onmetelijkheid van de bossen die de streek bedekten (boissetum in het Latijn betekent klein bos)."
    ],
    "es": [
      "Boisset, como dicen los \"pays\", toma su nombre de un modesto santuario de la Edad Media perdido en la inmensidad de los bosques que cubrían la región (boissetum en latín significa pequeño bosque)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Village Notre-Dame-de-Boisset"
    ]
  },
