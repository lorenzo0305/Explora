  "rdfs:comment": {
    "de": [
      "Von Le Bettex aus nehmen Sie die Mehrzweckpiste, die Sie durch den Grand Montaz bis zum Mont d'Arbois auf 1830 m Höhe führt. Der Anstieg ist sanft, perfekt für Mountainbikes, und Sie genießen die immer offener werdende alpine Umgebung."
    ],
    "en": [
      "From Le Bettex, take the multi-use trail through the Grand Montaz to Mont d'Arbois, at 1,830m. The ascent is gentle, perfect for VTTAE, as you enjoy an increasingly open alpine setting."
    ],
    "it": [
      "Partendo da Le Bettex, prendete il sentiero multiuso che vi porta attraverso il Grand Montaz fino al Mont d'Arbois, a 1.830 m di altitudine. La salita è dolce, perfetta per le mountain bike, e si può godere di uno scenario alpino sempre più aperto."
    ],
    "fr": [
      "Au départ du Bettex, empruntez la piste multi-usages qui vous conduit à travers la Grand Montaz jusqu’au Mont d’Arbois, à 1 830m d’altitude. La montée se fait en douceur, parfaite pour le VTTAE, en profitant d’un cadre alpin de plus en plus ouvert."
    ],
    "es": [
      "Partiendo de Le Bettex, tome el sendero polivalente que le lleva a través del Grand Montaz hasta el Mont d'Arbois, a 1.830 m de altitud. La subida es suave, perfecta para las bicicletas de montaña, y podrá disfrutar de un paisaje alpino cada vez más abierto."
    ],
    "nl": [
      "Neem vanaf Le Bettex het multifunctionele pad dat je door de Grand Montaz naar de Mont d'Arbois leidt, op een hoogte van 1.830 meter. De klim is licht, perfect voor mountainbikes, en je kunt genieten van het steeds opener wordende Alpenlandschap."
    ]
  },
