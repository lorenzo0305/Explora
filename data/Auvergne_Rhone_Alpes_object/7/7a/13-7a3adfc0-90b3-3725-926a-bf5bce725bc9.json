  "rdfs:comment": {
    "de": [
      "Am Ufer der Ardèche befindet sich die einzige Terrasse von Saint-Martin mit direktem Blick auf den Fluss. Lehnen Sie sich zurück, atmen Sie durch, genießen Sie... Zu jeder Tageszeit empfangen Sie Bar und Eisdiele für eine Schlemmerpause am Wasser."
    ],
    "en": [
      "On the banks of the Ardèche, the only terrace in Saint-Martin with a direct view of the river. Sit back, breathe and enjoy... At all hours, the bar and ice cream parlour welcome you for a gourmet break along the river."
    ],
    "it": [
      "Sulle rive dell'Ardèche, l'unica terrazza di Saint-Martin con vista diretta sul fiume. Sedetevi, rilassatevi e divertitevi A qualsiasi ora del giorno, il bar e la gelateria vi accolgono per una pausa golosa lungo il fiume."
    ],
    "fr": [
      "Au bord de l’Ardèche, la seule terrasse de Saint-Martin avec vue directe sur la rivière. Installez-vous, respirez, savourez… À toute heure, bar et glacier vous accueillent pour une pause gourmande au fil de l’eau."
    ],
    "nl": [
      "Aan de oever van de Ardèche, het enige terras in Saint-Martin met direct uitzicht op de rivier. Leun achterover, haal adem en geniet... De bar en ijssalon verwelkomen je op elk moment van de dag voor een gastronomische pauze langs de rivier."
    ],
    "es": [
      "A orillas del Ardèche, la única terraza de Saint-Martin con vistas directas al río. Siéntese, relájese y disfrute.. A cualquier hora del día, el bar y la heladería le dan la bienvenida para una pausa gastronómica junto al río."
    ]
  },
