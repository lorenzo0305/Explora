  "rdfs:comment": {
    "de": [
      "Sandra und ihre ExtraPfoten, haarige Gefährten mit großem Herzen (Schlittenhunde mit nordischen Wurzeln), lassen sich im Sommer und im Winter in Corrençon nieder."
    ],
    "en": [
      "Sandra and her ExtraPattes, furry companions with a big heart (sled dogs with Nordic origins) settle in Corrençon in summer and winter."
    ],
    "it": [
      "Sandra e i suoi ExtraPattes, compagni pelosi dal cuore grande (cani da slitta di origine nordica) si stabiliscono a Corrençon in estate e in inverno."
    ],
    "fr": [
      "Sandra et ses ExtraPattes, compagnons poilus au grand cœur (chiens de traineau aux origines nordiques) s'installent à Corrençon en été et en hiver."
    ],
    "es": [
      "Sandra y sus ExtraPattes, compañeros peludos con un gran corazón (perros de trineo de origen nórdico) se instalan en Corrençon en verano y en invierno."
    ],
    "nl": [
      "Sandra en haar ExtraPattes, harige metgezellen met een groot hart (sledehonden van Scandinavische oorsprong) vestigen zich zomer en winter in Corrençon."
    ]
  },
