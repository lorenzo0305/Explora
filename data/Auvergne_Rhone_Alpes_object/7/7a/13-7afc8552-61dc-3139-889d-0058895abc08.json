  "rdfs:comment": {
    "de": [
      "In Nantua gibt es 63 Routen von maximal 15 m Länge von 4c bis 7b, aber überwiegend 5er-Routen, mit einem schönen Panorama auf den See."
    ],
    "en": [
      "The Nantua site has 63 routes of 15 m maximum, ranging from 4c to 7b, but with a majority of routes in 5, with a lovely panorama over the lake."
    ],
    "it": [
      "Il sito Nantua dispone di 63 percorsi con un'altezza massima di 15 m, che vanno dal 4c al 7b, ma la maggior parte sono di 5 m, con una bella vista sul lago."
    ],
    "fr": [
      "Le site de Nantua compte 63 voies de 15 m maximum de 4c à 7b mais avec une majorité de voies en 5, avec un joli panorama sur le lac."
    ],
    "es": [
      "El sitio de Nantua tiene 63 rutas con una altura máxima de 15 m, que van de 4c a 7b, pero la mayoría son de 5 m, con una hermosa vista sobre el lago."
    ],
    "nl": [
      "De Nantua site heeft 63 routes met een maximale hoogte van 15m, variërend van 4c tot 7b, maar de meeste zijn 5m, met een prachtig uitzicht over het meer."
    ]
  },
