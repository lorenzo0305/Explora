  "rdfs:comment": {
    "de": [
      "Der Klettergarten befindet sich in den Aravis-Bergen (1800 m), ideale Ausrichtung."
    ],
    "en": [
      "One of the 4-star climbing areas of the Aravis Mountains. Located at 1800 meters altitude with an ideal southeast facing aspect."
    ],
    "it": [
      "La scuola di arrampicata di punta della regione degli Aravis. Altitudine ottimale (1800 m) e orientamento.\r\nAttenzione, la via Gaguistes è temporaneamente chiusa (rischio di caduta massi)."
    ],
    "fr": [
      "L'école d'escalade phare des Aravis. Altitude (1800 m) et orientation optimales.\r\nAttention, voie des Gaguistes momentanément fermée (risque de chute de pierres)."
    ],
    "es": [
      "La escuela de escalada más emblemática de la región de Aravis. Altitud óptima (1800 m) y orientación.\r\nAtención, la ruta de los Gaguistes está temporalmente cerrada (riesgo de desprendimiento de rocas)."
    ],
    "nl": [
      "Het vlaggenschip van de klimschool in de Aravis-regio. Optimale hoogte (1800 m) en oriëntatie.\r\nLet op, de route Gaguistes is tijdelijk gesloten (risico op steenval)."
    ]
  },
  "rdfs:label": {
    "de": [
      "Klettern : Klettergarten \"Falaise de la Colombière\""
    ],
    "en": [
      "Rock climbing at the La Colombière climbing area"
    ],
    "fr": [
      "Escalade : école \"Falaise de la Colombière\""
    ]
  },
