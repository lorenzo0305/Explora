  "rdfs:comment": {
    "de": [
      "Die Bienen Beebot und Bluebot haben den ganzen Morgen gesammelt und sich verirrt! Leo braucht Hilfe, um das Bienenvolk zu retten."
    ],
    "en": [
      "The Beebot and Bluebot bees have been foraging all morning and have lost their way! Leo needs help to save the colony."
    ],
    "it": [
      "Le api Beebot e Bluebot sono state in cerca di cibo per tutta la mattina e hanno perso la strada! Leo ha bisogno di aiuto per salvare la colonia."
    ],
    "fr": [
      "Les abeilles Beebot et Bluebot ont butiné toute la matinée et se sont égarées ! Léo a besoin d'aide pour sauver la colonie."
    ],
    "es": [
      "Las abejas Beebot y Bluebot han estado buscando comida toda la mañana y se han perdido Leo necesita ayuda para salvar la colonia."
    ],
    "nl": [
      "De Beebot en Bluebot bijen hebben de hele ochtend gefoerageerd en zijn de weg kwijt! Leo heeft hulp nodig om de kolonie te redden."
    ]
  },
