  "rdfs:comment": {
    "de": [
      "Das Restaurant Le Barillon liegt im Herzen des Weilers Villarly und bietet eine traditionelle Feinschmeckerküche mit hausgemachten Spezialitäten aus Savoyen.  Sonnige Terrasse."
    ],
    "en": [
      "Located in the heart of the hamlet of Villarly, Le Barillon restaurant offers traditional gourmet cuisine and homemade Savoyard specialities.  Sunny terrace."
    ],
    "it": [
      "Situato nel cuore del borgo di Villarly, il ristorante Le Barillon offre una cucina gourmet tradizionale e specialità savoiarde fatte in casa.  Terrazza soleggiata."
    ],
    "fr": [
      "Situé au coeur du hameau de Villarly, le restaurant Le Barillon propose une cuisine traditionnelle gourmande, des spécialités savoyardes, faites maison.  Terrasse ensoleillée."
    ],
    "es": [
      "Situado en el corazón de la aldea de Villarly, el restaurante Le Barillon ofrece cocina gastronómica tradicional y especialidades caseras de Saboya.  Terraza soleada."
    ],
    "nl": [
      "Restaurant Le Barillon ligt in het hart van het gehucht Villarly en biedt traditionele gastronomische gerechten en huisgemaakte Savoyaardse specialiteiten.  Zonnig terras."
    ]
  },
