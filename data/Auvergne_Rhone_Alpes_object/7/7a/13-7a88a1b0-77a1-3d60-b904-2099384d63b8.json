  "rdfs:comment": {
    "de": [
      "Umweltschonender Anbau der Reben, keine Pestizide. Landweine aus der Drôme, lieblicher Weißwein, halbtrockener und trockener Weißwein, fruchtiger Rosé. Rotwein der Rebsorte Syrah, Cuvée de Prestige vieilles vignes de 60 ans, AOP St Joseph rouge. Saft aus Trauben.\r\nDomäne in HVE 3"
    ],
    "en": [
      "Environmentally-friendly vine-growing, no pesticides. Vins de pays de la Drôme, sweet, semi-dry and dry white wines, fruity rosé. Syrah red, cuvé de prestige 60-year-old vines and AOP St Joseph red.\r\nHVE 3 certified estate"
    ],
    "it": [
      "Viticoltura ecologica, senza pesticidi. Vins de pays de la Drôme, vini bianchi dolci, semisecchi e secchi, rosé fruttati. Syrah rosso, cuvé de prestige di 60 anni, AOP St Joseph rosso. Succo d'uva\r\nTenuta HVE 3"
    ],
    "fr": [
      "Culture de la vigne en respectant l'environnement, aucun pesticide. Vins de pays de la Drôme, blanc moelleux, demi-sec et sec, rosé fruité. Rouge cépage syrah, cuvé de prestige vieilles vignes de 60 ans, AOP St Joseph rouge. Jus de raisin\r\nDomaine en HVE 3"
    ],
    "es": [
      "Viticultura respetuosa con el medio ambiente, sin pesticidas. Vins de pays de la Drôme, vinos blancos dulces, semisecos y secos, rosados afrutados. Syrah tinto, cuvé de prestige viñas de 60 años, AOP St Joseph tinto. Zumo de uva\r\nFinca HVE 3"
    ],
    "nl": [
      "Milieuvriendelijke wijnbouw, geen pesticiden. Vins de pays de la Drôme, zoete, halfdroge en droge witte wijnen, fruitige rosé. Syrah rood, cuvé de prestige 60 jaar oude wijnstokken en AOP St Joseph rood.\r\nHVE 3 gecertificeerd domein"
    ]
  },
