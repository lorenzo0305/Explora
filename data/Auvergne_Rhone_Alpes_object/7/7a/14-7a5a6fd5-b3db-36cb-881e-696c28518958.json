  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/bb7c67a6-f74f-3475-8f40-f811850955b5",
      "dc:description": {
        "de": [
          "Sehen Sie sich den Film von Hervé PAYEN an, der im Herzen der Region Hauts-de-France gedreht wurde. Er wirft ein Schlaglicht auf die Bauern, die versuchen, die Erde so zu ernähren, wie sie die Menschen ernährt."
        ],
        "en": [
          "Come and see Hervé PAYEN's film-investigation, shot in the heart of the Hauts-de-France region, which puts the spotlight on farmers who strive to feed the earth as much as it feeds people."
        ],
        "it": [
          "Venite a vedere il film d'inchiesta di Hervé PAYEN, girato nel cuore della regione Hauts-de-France, che accende i riflettori sugli agricoltori che si sforzano di nutrire la terra tanto quanto le persone."
        ],
        "fr": [
          "Venez voir le film-enquête d'Hervé PAYEN tourné au cœur des Hauts-de-France qui met un coup de projecteur sur des paysans qui cherchent à nourrir la terre autant qu'elle nourrit les Hommes."
        ],
        "es": [
          "Venga a ver la película de investigación de Hervé PAYEN, rodada en el corazón de la región de Hauts-de-France, que pone en el punto de mira a los agricultores que se esfuerzan por alimentar la tierra tanto como ésta alimenta a las personas."
        ],
        "nl": [
          "Kom kijken naar de onderzoeksfilm van Hervé PAYEN, opgenomen in het hart van de regio Hauts-de-France, die de schijnwerpers richt op boeren die ernaar streven om het land net zo goed te voeden als het mensen voedt."
        ]
      },
      "@type": [
        "Description"
