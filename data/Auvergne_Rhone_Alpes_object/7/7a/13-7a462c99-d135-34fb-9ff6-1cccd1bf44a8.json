  "rdfs:comment": {
    "de": [
      "Im Herzen des mittelalterlichen Dorfes St-Marcellin-en-Forez bietet Ihnen die Mühle Epicurius hausgemachte Gerichte aus überwiegend biologischen und lokalen Produkten.Traditionelle regionale und mediterrane Küche. Frische und saisonale Produkte."
    ],
    "en": [
      "At the heart of the medieval village of St-Marcellin-en-Forez, \"le Moulin Epicurius\" make you taste home made dishes with mainly local and organic products.\r\nTraditional cuisine of the region and Mediterranean. \r\nFresh and seasonal products."
    ],
    "it": [
      "Nel cuore di St-Marcellin-en-Forez, il Mulino Epicurius serve piatti fatti in casa con prodotti prevalentemente biologici e locali. Cucina tradizionale locale e mediterranea con prodotti freschi di stagione."
    ],
    "fr": [
      "Au cœur de St-Marcellin-en-Forez, le Moulin Epicurius vous fait déguster des plats faits maison issus de produits principalement biologiques et locaux. C'est une cuisine traditionnelle du terroir et méditerranéenne avec des produits frais et de saison."
    ],
    "nl": [
      "In het hart van St-Marcellin-en-Forez serveert de Epicurius Mill huisgemaakte gerechten van voornamelijk biologische en lokale producten. Traditionele lokale en mediterrane gerechten met verse seizoensproducten."
    ],
    "es": [
      "En el corazón de St-Marcellin-en-Forez, el Molino Epicurius sirve platos caseros elaborados principalmente con productos ecológicos y locales. Cocina tradicional local y mediterránea con productos frescos de temporada."
    ]
  },
