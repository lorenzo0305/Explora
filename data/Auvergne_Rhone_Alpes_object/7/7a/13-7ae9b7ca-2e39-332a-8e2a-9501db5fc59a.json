  "rdfs:comment": {
    "de": [
      "SOFFFA ist ein Hybridhaus im Herzen von Lyon!\r\nSlowcafé, Coworking, Kunstgalerie, Ort für Veranstaltungen und Ausdrucksmöglichkeiten.\r\nHier treffen sich die Wesen, hier kreuzen sich die Kompetenzen!"
    ],
    "en": [
      "SOFFFA is a hybrid house in the heart of Lyon!\r\nSlowcafé, coworking, art gallery, place for events and expression.\r\nPeople find themselves there, skills cross paths!"
    ],
    "it": [
      "SOFFFA è una casa ibrida nel cuore di Lione!\r\nSlowcafé, coworking, galleria d'arte, luogo di eventi e di espressione.\r\nQui le persone si incontrano, le competenze si incrociano!"
    ],
    "fr": [
      "SOFFFA est une maison hybride au coeur de Lyon !\r\nSlowcafé, coworking, galerie d’art, lieu d’événementiel et d’expression.\r\nLes êtres s’y retrouvent, les compétences s’y croisent !"
    ],
    "nl": [
      "SOFFFA is een hybride huis in het hart van Lyon!\r\nSlowcafé, coworking, kunstgalerie, plek voor evenementen en expressie.\r\nMensen ontmoeten elkaar hier, vaardigheden kruisen elkaar!"
    ],
    "es": [
      "SOFFFA es una casa híbrida en el corazón de Lyon\r\nSlowcafé, coworking, galería de arte, lugar de eventos y expresión.\r\nLa gente se encuentra aquí, las habilidades se cruzan"
    ]
  },
