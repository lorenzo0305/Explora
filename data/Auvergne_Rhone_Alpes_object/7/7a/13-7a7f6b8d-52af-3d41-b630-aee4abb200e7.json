  "rdfs:comment": {
    "de": [
      "Dieser Raum vereint an einem einzigen Standort ein Maison France Services, das Sie bei Ihren Behördengängen unterstützt, sowie die Mediathek der Gemeinde (die Lesebereiche und einen Ausleihservice für Bücher, Spiele, CDs und DVDs bietet)."
    ],
    "en": [
      "The new facility brings together on the same site a Maison des Services, a Hautes Terres Tourisme branch and the local media library (which offers reading areas and a lending service for books, games, CDs and DVDs)."
    ],
    "it": [
      "Il centro riunisce nello stesso sito una Maison France Services per aiutarvi a sbrigare le formalità amministrative e la mediateca locale (che offre spazi di lettura e un servizio di prestito di libri, giochi, CD e DVD)."
    ],
    "fr": [
      "Cet espace mutualise sur un même site une Maison France Services pour vous accompagner dans vos démarches administratives ainsi que la médiathèque communale (qui propose des espaces de lecture et un service de prêts de livres, jeux, CD et DVD)."
    ],
    "nl": [
      "Het centrum brengt op dezelfde site een Maison France Services samen om je te helpen met je administratieve formaliteiten en de plaatselijke mediatheek (met leesruimtes en een uitleendienst voor boeken, spelletjes, cd's en dvd's)."
    ],
    "es": [
      "El centro reúne en el mismo recinto una Maison France Services para ayudarle con sus trámites administrativos y la mediateca local (que ofrece espacios de lectura y un servicio de préstamo de libros, juegos, CD y DVD)."
    ]
  },
  "rdfs:label": {
    "en": [
      "Médiathèque de Neussargues Moissac - House of services and tourism"
    ],
    "fr": [
      "Maison des services et Médiathèque de Neussargues Moissac"
    ]
  },
