  "rdfs:comment": {
    "de": [
      "Traditionelle irische Musik, wie man sie im Pub in Dublin oder Galway hören kann. Traditionelle Melodien und neuere Kompositionen, begleitet von Gitarre, Bodhran, irischer Bouzouki, Akkordeon, Geige, Banjo, Uilleann Pipes, Whistles und Gesang."
    ],
    "en": [
      "Traditional Irish music as heard in the pubs of Dublin and Galway. Traditional tunes and recent compositions, accompanied by guitar, bodhran, Irish bouzouki, accordion, fiddle, banjo, uilleann pipes, whistles and vocals."
    ],
    "it": [
      "Musica tradizionale irlandese ascoltata nei pub di Dublino e Galway. Brani tradizionali e composizioni recenti, accompagnati da chitarra, bodhran, bouzouki irlandese, fisarmonica, fiddle, banjo, uilleann pipes, whistles e voce."
    ],
    "fr": [
      "Musique irlandaise traditionnelle telle qu'on peut l’entendre au pub à Dublin ou Galway. Airs traditionnels et compositions récentes, accompagnées de guitare, bodhran, bouzouki irlandais, accordéon, violon, banjo, uilleann pipes, whistles, chant."
    ],
    "nl": [
      "Traditionele Ierse muziek zoals te horen in de pubs van Dublin en Galway. Traditionele liedjes en recente composities, begeleid door gitaar, bodhran, Ierse bouzouki, accordeon, fiddle, banjo, uilleann pipes, fluitjes en zang."
    ],
    "es": [
      "Música tradicional irlandesa tal y como se escucha en los pubs de Dublín y Galway. Melodías tradicionales y composiciones recientes, acompañadas de guitarra, bodhran, bouzouki irlandés, acordeón, fiddle, banjo, uilleann pipes, whistles y voz."
    ]
  },
  "rdfs:label": {
