  "rdfs:comment": {
    "de": [
      "Produzent von Weinen aus der Region Côtes du Rhône. Weinkeller für Verkostungen, Verkauf. Besichtigung der Weinkeller nach Vereinbarung. Verkauf von Weinen in Flaschen und Bag-in-Box."
    ],
    "en": [
      "Producer of Côtes du Rhône wines. Tasting cellar, sales. Visits to wine-making cellars by appointment. Bottled and bag-in-box wine sales."
    ],
    "it": [
      "Produttore di vini della Côtes du Rhône. Cantina di degustazione, vendita. Visite alle cantine di vinificazione su appuntamento. Vendita di vini in bottiglia e bag in box."
    ],
    "fr": [
      "Producteur des vins de Côtes du Rhône. Caveau de dégustation, vente. Visite sur rendez-vous des chais de vinification. Vente de vins en bouteilles et bag in Box."
    ],
    "es": [
      "Productor de vinos Côtes du Rhône. Bodega de degustación, ventas. Visitas a las bodegas de elaboración de vinos con cita previa. Venta de vinos en botella y bag in box."
    ],
    "nl": [
      "Producent van Côtes du Rhône wijnen. Proeverij kelder, verkoop. Bezoek aan wijnkelders op afspraak. Verkoop van gebottelde wijn en wijn in zakken."
    ]
  },
