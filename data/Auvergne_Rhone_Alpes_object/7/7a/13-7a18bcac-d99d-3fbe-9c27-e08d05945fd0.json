  "rdfs:comment": {
    "de": [
      "Ich wohne in der Chartreuse und bin Bergführer. Ich kann Wanderungen in der C?ur de Chartreuse begleiten und Halbtages-, Dämmerungs-, Nacht-, Tages- oder Mehrtagesausflüge zu jeder Jahreszeit anbieten."
    ],
    "en": [
      "As a Chartreuse resident and mountain guide, I can accompany you on hikes in the heart of the Chartreuse and offer half-day, twilight, dawn, night, full-day or multi-day outings in all seasons."
    ],
    "it": [
      "Come abitante della Chartreuse e guida alpina, posso accompagnare gli escursionisti in passeggiate nel cuore della Chartreuse e proporre uscite di mezza giornata, al tramonto, all'alba, di notte, di un giorno intero o di più giorni in tutte le stagioni."
    ],
    "fr": [
      "Habitant de Chartreuse, accompagnateur en montagne, je peux accompagner des randonnées en Cœur de Chartreuse et proposer des sorties à la demi-journée, au crépuscule, à l'aube, de nuit, à la journée ou sur plusieurs jours, en toutes saisons."
    ],
    "es": [
      "Como residente en Chartreuse y guía de montaña, puedo acompañar a los excursionistas en paseos por el corazón de Chartreuse y ofrecer salidas de medio día, al atardecer, al amanecer, nocturnas, de día completo o de varios días en todas las estaciones."
    ],
    "nl": [
      "Als inwoner van de Chartreuse en berggids kan ik wandelaars begeleiden op wandelingen in het hart van de Chartreuse en bied ik halve dagen, schemering, zonsopgang, nacht, hele dagen of meerdaagse tochten in alle seizoenen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Pierre Autrand, accompagnateur en montagne"
    ]
  },
