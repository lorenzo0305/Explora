  "rdfs:comment": {
    "de": [
      "Spar Bourdeaux empfängt Sie das ganze Jahr über von Montag bis Samstag durchgehend von 8 bis 20 Uhr, sonntags von 9 bis 12.30 Uhr (im Sommer bis 20 Uhr). Lokale und BIO-Produkte (Obst, Gemüse, Fleisch, Wurst, Käse, Wein, Bier, Honig, Pognes, Brot ...)"
    ],
    "en": [
      "Spar Bourdeaux welcomes you all year round from Monday to Saturday from 8am to 8pm without interruption, Sundays from 9am to 12.30pm (and until 8pm in summer). local and ORGANIC products (fruit, vegetables, meat, charcuterie, cheeses, wine, beers, honey, pognes, bread ...)"
    ],
    "it": [
      "Spar Bourdeaux vi accoglie tutto l'anno dal lunedì al sabato dalle 8.00 alle 20.00 senza interruzioni, la domenica dalle 9.00 alle 12.30 (e fino alle 20.00 in estate). Prodotti locali e BIOLOGICI (frutta, verdura, carne, salumi, formaggi, vino, birra, miele, pane...)"
    ],
    "fr": [
      "Spar Bourdeaux vous accueille toute l'année du lundi au samedi de 8h à 20h sans interruption, le dimanche de 9h à 12h30 (et jusqu’à 20h en été). produits locaux et BIO (fruits, légumes, viande, charcuterie, fromages, vin, bières, miel, pognes, pain ...)"
    ],
    "nl": [
      "Spar Bourdeaux verwelkomt u het hele jaar door van maandag tot zaterdag van 8u tot 20u zonder onderbreking, zondags van 9u tot 12u30 (en tot 20u in de zomer). Lokale en ORGANISCHE producten (fruit, groenten, vlees, charcuterie, kazen, wijn, bier, honing, brood ...)"
    ],
    "es": [
      "Spar Bourdeaux le acoge todo el año de lunes a sábado de 8h a 20h sin interrupción, los domingos de 9h a 12h30 (y hasta las 20h en verano). Productos locales y BIO (frutas, verduras, carne, charcutería, quesos, vino, cerveza, miel, pan...)"
    ]
  },
