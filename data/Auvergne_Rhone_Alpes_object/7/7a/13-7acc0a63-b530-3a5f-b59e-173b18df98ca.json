  "rdfs:comment": {
    "de": [
      "Restaurant mit den Freuden vergangener Zeiten. Sich Bougnat zu nennen, muss man sich verdienen! Bouillon Bougnat ist die erste Bouillon in der Stadt Issoire! 100 % hausgemacht, lokale Produkte, günstige Preise..."
    ],
    "en": [
      "Restaurant with old-fashioned pleasures. You've earned the name Bougnat! Bouillon Bougnat is the first Bouillon in Issoire! 100% homemade, local produce, low prices..."
    ],
    "it": [
      "Un ristorante pieno di piaceri d'altri tempi. Il nome Bougnat va guadagnato! Bouillon Bougnat è il primo Bouillon della città di Issoire! 100% fatti in casa, prodotti locali, prezzi bassi..."
    ],
    "fr": [
      "Restaurant aux plaisirs d'antan. S'appeler Bougnat, ça se mérite ! Bouillon Bougnat est le premier Bouillon de la Ville d'Issoire ! 100% fait maison, produits locaux, tarifs tout doux..."
    ],
    "es": [
      "Un restaurante lleno de los placeres de antaño. ¡El nombre de Bougnat hay que ganárselo! Bouillon Bougnat es el primer Bouillon de la ciudad de Issoire 100% casero, productos locales, precios bajos..."
    ],
    "nl": [
      "Een restaurant vol geneugten van vroeger. De naam Bougnat moet je verdienen! Bouillon Bougnat is de eerste Bouillon in de stad Issoire! 100% huisgemaakte, lokale producten, lage prijzen..."
    ]
  },
