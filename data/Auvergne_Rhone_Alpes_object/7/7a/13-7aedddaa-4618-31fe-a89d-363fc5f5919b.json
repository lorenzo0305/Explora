  "rdfs:comment": {
    "de": [
      "Das Zigeunerquartett wird am Sonntag, den 26. Juli 2026, um 18 Uhr in der Kirche Saint-Pierre in Châteloy auftreten.\r\n\r\nÉric Slabiak: Violine\r\nFranck Anastasio: Gitarre, Kontrabass\r\nMarian Badoï: Akkordeon\r\nMarcello Marella: Kontrabass"
    ],
    "en": [
      "The Quartet Tzigane will perform at Église Saint-Pierre de Châteloy on Sunday, July 26, 2026, at 6pm.\r\n\r\nÉric Slabiak: violin\r\nFranck Anastasio: guitar, double bass\r\nMarian Badoï: accordion\r\nMarcello Marella: double bass"
    ],
    "it": [
      "Il Quartetto Tzigane si esibirà nella Chiesa di Saint-Pierre de Châteloy domenica 26 luglio 2026 alle 18.00.\r\n\r\nÉric Slabiak: violino\r\nFranck Anastasio: chitarra, contrabbasso\r\nMarian Badoï: fisarmonica\r\nMarcello Marella: contrabbasso"
    ],
    "fr": [
      "Le Quartet Tzigane se produira en l'Église Saint-Pierre de Châteloy, le Dimanche 26 juillet 2026, à 18h.\r\n\r\nÉric Slabiak: violon\r\nFranck Anastasio: guitare, contrebasse\r\nMarian Badoï: accordéon\r\nMarcello Marella: contrebasse"
    ],
    "nl": [
      "Het Kwartet Tzigane treedt op in de kerk Saint-Pierre de Châteloy op zondag 26 juli 2026 om 18.00 uur.\r\n\r\nÉric Slabiak: viool\r\nFranck Anastasio: gitaar, contrabas\r\nMarian Badoï: accordeon\r\nMarcello Marella: contrabas"
    ],
    "es": [
      "El Cuarteto Tzigane actuará en la iglesia de Saint-Pierre de Châteloy el domingo 26 de julio de 2026 a las 18:00 horas.\r\n\r\nÉric Slabiak: violín\r\nFranck Anastasio: guitarra, contrabajo\r\nMarian Badoï: acordeón\r\nMarcello Marella: contrabajo"
    ]
  },
  "rdfs:label": {
    "fr": [
      "60ème Festival de Musique en Bourbonnais : Quartet Tzigane"
    ]
  },
