  "rdfs:comment": {
    "de": [
      "Saint-Bardoux ist ein kleines, hoch gelegenes Dorf, das eine hügelige und weitläufige Gemeinde überragt. Vom Turm seiner Kirche aus kann man angeblich die Reliefs von sieben benachbarten Departements sehen."
    ],
    "en": [
      "Saint-Bardoux is a small village perched on a hill overlooking a large and hilly area. From the bell tower of its church, one can see, it is said, the reliefs of seven neighboring departments."
    ],
    "it": [
      "Saint-Bardoux è un piccolo villaggio arroccato su una collina che domina un grande comune collinare. Dal campanile della sua chiesa si può vedere, si dice, il rilievo di sette dipartimenti vicini."
    ],
    "fr": [
      "Saint-Bardoux est un petit village perché dominant une commune vallonnée et étendue. Du clocher de son église, on aperçoit, dit-on, les reliefs de sept départements voisins."
    ],
    "nl": [
      "Saint-Bardoux is een klein dorp dat hoog boven een grote, heuvelachtige gemeente uittorent. Er wordt gezegd dat je vanaf de kerktoren het reliëf van zeven naburige departementen kunt zien."
    ],
    "es": [
      "Saint-Bardoux es un pequeño pueblo encaramado en una colina que domina un extenso municipio montañoso. Desde el campanario de su iglesia se puede ver, se dice, el relieve de siete departamentos vecinos."
    ]
  },
