  "rdfs:comment": {
    "de": [
      "Jérôme Boissy stellt Ihnen sein Talent für die französische Küche als Catering-Service zur Verfügung. Der Caterer befindet sich in Montoison im Département Drôme (26) und ist in Montélimar, Valence und in einem Umkreis von 70 Kilometern tätig."
    ],
    "en": [
      "Jérôme Boissy puts all his talent for French cuisine to work for you as a caterer. Located in Montoison in the Drôme département (26), the caterer operates in Montélimar, Valence and within a 70-kilometer radius."
    ],
    "it": [
      "Jérôme Boissy mette a disposizione tutto il suo talento per la cucina francese come ristoratore. Situato a Montoison, nel dipartimento della Drôme (26), il ristoratore lavora a Montélimar, Valence e nel raggio di 70 chilometri."
    ],
    "fr": [
      "Jérôme Boissy met à votre profit tout son talent de la cuisine française en tant que service traiteur. Situé à Montoison dans le département de la Drôme (26), le traiteur intervient à Montélimar, Valence et dans un rayon de 70 kilomètres."
    ],
    "nl": [
      "Jérôme Boissy stelt al zijn talent voor de Franse keuken tot uw dienst als traiteur. De cateraar is gevestigd in Montoison in het departement Drôme (26) en werkt in Montélimar, Valence en binnen een straal van 70 kilometer."
    ],
    "es": [
      "Jérôme Boissy pone a su servicio todo su talento para la cocina francesa. Situado en Montoison, en el departamento de Drôme (26), trabaja en Montélimar, Valence y en un radio de 70 kilómetros."
    ]
  },
