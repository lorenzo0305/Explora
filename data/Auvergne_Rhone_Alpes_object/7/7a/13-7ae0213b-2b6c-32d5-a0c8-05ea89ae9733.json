  "rdfs:comment": {
    "de": [
      "Entdecken Sie den Orientierungslauf im Viertel Trois Vallons!\r\nEin spielerisches und sportliches Abenteuer, um die Gemeinde auf andere Weise zu erkunden, mit der Familie oder mit Freunden."
    ],
    "en": [
      "Discover the orienteering trails in the Trois Vallons district!\r\nA fun, sporty way to explore the town in a different way, with family or friends."
    ],
    "it": [
      "Scoprite i percorsi di orienteering nel distretto di Trois Vallons!\r\nUn modo divertente e sportivo per esplorare la città in modo diverso, con la famiglia o con gli amici."
    ],
    "fr": [
      "Découvrez les parcours d’orientation dans le quartier des Trois Vallons!\r\nUne aventure ludique et sportive pour explorer la commune autrement, en famille ou entre amis."
    ],
    "nl": [
      "Ontdek de oriëntatietochten in de wijk Trois Vallons!\r\nEen leuke en sportieve manier om de stad op een andere manier te verkennen, met familie of vrienden."
    ],
    "es": [
      "Descubra los senderos de orientación del barrio de Trois Vallons\r\nUna forma divertida y deportiva de explorar la ciudad de una manera diferente, en familia o con amigos."
    ]
  },
  "rdfs:label": {
    "fr": [
