    "de": [
      "Im Winter und Sommer mit der Seilbahn Crêt de la Brive erreichbar.\r\nZugänglich für Skifahrer, Fußgänger und Mountainbiker"
    ],
    "en": [
      "Access by the Crêt de la Brive cable car, both in the summer and winter.\r\nAccessible to skiers, hikers, MTBs.\r\nOnly open at lunchtime."
    ],
    "it": [
      "Accessibile via la cabinovia del Crêt de la Brive in estate e in inverno.\r\nAccessibile agli sciatori, pedoni e ciclisti.\r\nSolo a pranzo."
    ],
    "fr": [
      "Accessible par la télécabine du Crêt de la Brive, hiver comme été. \r\nAccessibles aux skieurs, piétons et VTT"
    ],
    "nl": [
      "Toegankelijk met de skilift van Le Crêt de la Brive, winter en zomer. \r\nVoor skiërs, wandelaars en mountainbikers\r\nAlleen tussen de middag geopend."
    ],
    "es": [
