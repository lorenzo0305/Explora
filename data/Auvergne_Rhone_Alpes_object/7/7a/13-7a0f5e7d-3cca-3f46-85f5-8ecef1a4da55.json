  "rdfs:comment": {
    "de": [
      "Diese Hochburg der Grenobler Gastronomie mit Panoramablick nimmt unter den viel besuchten Orten der Alpenhauptstadt einen besonderen Platz ein. Als gepflegtes traditionelles Restaurant erhielt Laurent Gras 2009 den Titel Maître Restaurateur, der 2013 erneuert wurde."
    ],
    "en": [
      "This panoramic bastion of Grenoble's gastronomy is one of the most popular spots in the capital of the Alps. A well-appointed traditional restaurant, Laurent Gras was awarded the title of Maître Restaurateur in 2009, a title renewed in 2013."
    ],
    "it": [
      "Questo baluardo panoramico della gastronomia di Grenoble occupa un posto d'onore tra i luoghi molto frequentati della capitale delle Alpi. Laurent Gras è un ristorante tradizionale e curato, che ha ottenuto il titolo di Maître Restaurateur nel 2009, titolo rinnovato nel 2013."
    ],
    "fr": [
      "Ce bastion panoramique de la gastronomie grenobloise tient une place de choix parmi les lieux très fréquentés de la capitale des Alpes. Restaurant traditionnel soigné, Laurent Gras a obtenu en 2009 le titre de Maître Restaurateur, titre renouvelé en 2013."
    ],
    "es": [
      "Este bastión panorámico de la gastronomía de Grenoble es uno de los lugares más concurridos de la capital de los Alpes. Laurent Gras obtuvo el título de Maître Restaurateur en 2009, título renovado en 2013."
    ],
    "nl": [
      "Dit panoramische bastion van de gastronomie van Grenoble is een van de populairste plaatsen in de hoofdstad van de Alpen. Laurent Gras is een traditioneel, goed verzorgd restaurant en kreeg in 2009 de titel Maître Restaurateur, een titel die in 2013 werd verlengd."
    ]
  },
