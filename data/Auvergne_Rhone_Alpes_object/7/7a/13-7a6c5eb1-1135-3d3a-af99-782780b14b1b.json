  "rdfs:comment": {
    "de": [
      "Manuelle und energetische Therapien.\r\nCranio Sacrale Osteopathie, Wellness-Massagen, Hypnose/PNL, Qi Gong.\r\nAls zertifizierte Heilpraktikerin begleite ich Sie auf den Wegen zu Ihrem Wohlbefinden.\r\nSitzungen von 30 Minuten bis 1,5 Stunden."
    ],
    "en": [
      "Choice of relaxing massages.\r\nTraditions of the world \r\n30 to 90 minutes sessions,"
    ],
    "it": [
      "Terapie manuali ed energetiche.\r\nOsteopatia cranio-sacrale, Massaggi del benessere, Ipnosi/PNL, Qi Gong.\r\nCome operatore certificato, posso guidarvi lungo il percorso del benessere.\r\nSedute da 30 minuti a 1h30."
    ],
    "fr": [
      "Thérapies manuelles et énergétiques. \r\nOstéopathie Cranio Sacrale, Massages Bien-être, Hypnose/PNL, Qi Gong. \r\nPraticienne certifiée, je vous accompagne sur les chemins du mieux être. \r\nSéances de 30 minutes à 1h30."
    ],
    "es": [
      "Terapias manuales y energéticas.\r\nOsteopatía Cráneo Sacra, Masajes de Bienestar, Hipnosis/PNL, Qi Gong.\r\nComo practicante certificada, puedo guiarte por el camino del bienestar.\r\nSesiones de 30 minutos a 1h30."
    ],
    "nl": [
      "Manuele energietherapieën. Wellness massages. \r\nWorkshops: Qi Gong, Ontspanning, Babymassage. \r\nAls gecertificeerde therapeute begeleid ik u op de weg naar meer welzijn. Sessies van 30 minuten tot 1.30 uur."
    ]
  },
