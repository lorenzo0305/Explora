  "rdfs:comment": {
    "de": [
      "Boutique mit Produkten aus der Normandie Picardie und dem Terroir de Picardie, die aus dem Know-how unserer regionalen Produzenten und Handwerker stammen. Der Laden befindet sich in MERS-LES-BAINS im Stadtzentrum\nNEU: Ein Restaurantbereich steht für Ihre Ausflüge und Mahlzeiten mittags und abends nach vorheriger Reservierung zur Verfügung."
    ],
    "en": [
      "Shop of Normands Picards and Terroir de Picardie products from the know-how of our regional producers and craftsmen. The shop is located in MERS-LES-BAINS in the town centre\nNEW: a restaurant area is available for your outings and lunch and dinner by reservation."
    ],
    "it": [
      "Negozio di prodotti della Normandia e della Piccardia, frutto del know-how dei nostri produttori e artigiani regionali. Il negozio si trova a MERS-LES-BAINS, nel centro della città\nNOVITÀ: un'area ristorante è disponibile per le vostre uscite e per pranzi e cene su prenotazione."
    ],
    "fr": [
      "Boutique de produits Normands Picards et du Terroir de Picardie issus du savoir-faire de nos producteurs et artisans régionaux. La boutique est située à MERS-LES-BAINS en plein centre ville. \nNOUVEAUTÉ : un espace restauration est disponible pour vos sorties et repas du midi et soir sur réservation."
    ],
    "nl": [
      "Winkel met Normandische en Picardische producten van de knowhow van onze regionale producenten en ambachtslieden. De winkel bevindt zich in MERS-LES-BAINS in het stadscentrum\nNIEUW: een restaurantgedeelte is beschikbaar voor uw uitjes en lunch en diner op reservering."
    ],
    "es": [
      "Tienda de productos de Normandía y Picardía procedentes del saber hacer de nuestros productores y artesanos regionales. La tienda está situada en MERS-LES-BAINS, en el centro de la ciudad\nNOVEDAD: una zona de restauración está disponible para sus salidas y comidas y cenas bajo reserva."
    ]
  },
  "rdfs:label": {
