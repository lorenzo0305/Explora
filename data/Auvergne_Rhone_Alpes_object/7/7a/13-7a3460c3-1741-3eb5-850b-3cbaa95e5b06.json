  "rdfs:comment": {
    "de": [
      "Die Seilbahn bietet eine kostenlose Verbindung zwischen Le Villaret (Peisey) und dem Ferienort Peisey-Vallandry/les Arcs (Plan-Peisey). Sie bietet Zugang zur Station Vanoise Express, der größten Seilbahn in Paradiski, die das Gebiet von La Plagne verbindet."
    ],
    "en": [
      "The cable car provides a free link between Le Villaret (Peisey) and the resort of Peisey-Vallandry/les Arcs (Plan-Peisey). It provides access to the Vanoise Express station, the largest cable car in Paradiski, linking the La Plagne area."
    ],
    "it": [
      "La funivia collega gratuitamente Le Villaret (Peisey) alla località di Peisey-Vallandry/les Arcs (Plan-Peisey). Fornisce l'accesso alla stazione del Vanoise Express, la più grande funivia del Paradiski, che collega la zona di La Plagne."
    ],
    "fr": [
      "Le télébenne assure gratuitement la liaison entre Le Villaret (Peisey) et la station de Peisey-Vallandry/les Arcs (Plan-Peisey). Il permet d’accéder à la gare du Vanoise Express, le plus grand téléphérique de Paradiski, reliant le domaine de la Plagne."
    ],
    "es": [
      "El teleférico ofrece un enlace gratuito entre Le Villaret (Peisey) y la estación de Peisey-Vallandry/les Arcs (Plan-Peisey). Permite acceder a la estación Vanoise Express, el mayor teleférico de Paradiski, que une la zona de La Plagne."
    ],
    "nl": [
      "De kabelbaan biedt een gratis verbinding tussen Le Villaret (Peisey) en de badplaats Peisey-Vallandry/les Arcs (Plan-Peisey). Het biedt toegang tot het station van de Vanoise Express, de grootste kabelbaan van Paradiski, die het gebied van La Plagne met elkaar verbindt."
    ]
  },
  "rdfs:label": {
    "de": [
