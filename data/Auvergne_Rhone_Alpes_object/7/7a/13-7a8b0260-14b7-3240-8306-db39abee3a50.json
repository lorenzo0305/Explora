  "rdfs:comment": {
    "de": [
      "Hausgemachte asiatische Küche mit biologischen, lokalen und saisonalen Produkten.\r\nIn seiner Auslage tummeln sich Frühlingsrollen und Samoussas, mit Rind- und Schweinefleisch, mit Huhn sowie verschiedene Reis- und Nudelrezepte."
    ],
    "en": [
      "Homemade Asian cuisine using organic, local and seasonal produce.\r\nThe stall is packed with egg rolls and samosas, beef and pork, chicken and a variety of rice and noodle recipes."
    ],
    "it": [
      "Cucina asiatica fatta in casa con prodotti biologici, locali e di stagione.\r\nIl banco è ricco di nems e samoussas, con carne di manzo, maiale e pollo, oltre a una varietà di ricette di riso e noodle."
    ],
    "fr": [
      "Cuisine asiatique faite maison avec des produits bio, locaux et de saison .\r\nSur son étal, se bousculent nems et samoussas, au bœuf et au porc, au poulet, ainsi que diverses recettes de riz et de nouilles."
    ],
    "nl": [
      "Huisgemaakte Aziatische keuken met biologische, lokale en seizoensgebonden producten.\r\nDe kraam staat vol met nems en samoussas, met rundvlees, varkensvlees en kip, evenals een verscheidenheid aan rijst- en noedelrecepten."
    ],
    "es": [
      "Cocina asiática casera con productos ecológicos, locales y de temporada.\r\nEl puesto está repleto de nems y samoussas, con carne de ternera, cerdo y pollo, así como una gran variedad de recetas de arroz y fideos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Food Truck \"Mandalasian\""
    ]
  },
