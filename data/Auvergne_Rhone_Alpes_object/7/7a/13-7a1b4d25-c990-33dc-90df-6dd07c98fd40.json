  "rdfs:comment": {
    "de": [
      "Kleiner, ruhiger, fischreicher Bergsee. Hier gibt es Rotaugen, Barsche, Schleien, Regenbogenforellen, Bachforellen, Karpfen, Rotfedern und Krebse. Verordnung 1. Kategorie."
    ],
    "en": [
      "Small mountain lake, quiet and full of fish. Here you’ll find roaches, perch, tench, rainbow trout, brown trout, carp, common rudd and crayfish. 1st category regulations."
    ],
    "it": [
      "Piccolo lago di montagna, tranquillo e ricco di pesci. Sono presenti lasche, persici, tinche, trote iridee, trote fario, carpe, rombi e gamberi di fiume. Regolamenti di 1a categoria."
    ],
    "fr": [
      "Petit lac de montagne, tranquille, poissonneux. On y trouve des gardons, des perches, des tanches, des truites arc-en-ciel, des truites farios, des carpes, des rotengles et des écrevisses. Règlement 1ère catégorie."
    ],
    "es": [
      "Pequeño y tranquilo lago de montaña con muchos peces. Hay cucarachas, percas, tencas, truchas arco iris, truchas marrones, carpas, rotengles y cangrejos de río. Reglamento de 1ª categoría."
    ],
    "nl": [
      "Klein, rustig en visrijk bergmeer. Hier vindt u voorn, snoekbaars, zeelt, regenboogforel, beekforel, karper, rietvoorn en rivierkreeft. Regelgeving: 1e categorie."
    ]
  },
  "rdfs:label": {
    "en": [
