  "rdfs:comment": {
    "de": [
      "Im Herzen des historischen Stadtkerns von Trévoux können Sie die Kunstschaffenden der Rue[s] des Arts kennenlernen! Leidenschaftliche Künstler: Maler, Bildhauer, bildende Künstlerin, Vergolder, Geigenbauer, Schneiderin, Tapeziererin... empfangen Sie in ihren Ateliers und Galerien."
    ],
    "en": [
      "In the historic heart of Trévoux, come and meet the creators of the Rue[s] des Arts! Passionate artists: painters, sculptors, visual artists, gilders, luthiers, seamstresses, upholsterers... welcome you to their studio-gallery."
    ],
    "it": [
      "Nel cuore storico di Trévoux, venite a conoscere gli artisti della Rue[s] des Arts! Artisti appassionati: pittori, scultori, artisti visivi, doratori, liutai, sarti, tappezzieri... vi danno il benvenuto nei loro atelier-galleria."
    ],
    "fr": [
      "En plein cœur historique de Trévoux, partez à la rencontre des créateurs de la Rue[s] des Arts ! Des artistes passionnés : peintres, sculptrices, artiste plasticienne, doreuse, luthier, couturière, tapissière... vous accueillent dans leur atelier-galerie."
    ],
    "nl": [
      "Kom in het historische hart van Trévoux kennismaken met de kunstenaars van de Rue des Arts! Gepassioneerde kunstenaars: schilders, beeldhouwers, beeldend kunstenaars, vergulders, vioolbouwers, kleermakers, stoffeerders... verwelkomen je in hun atelier-galerie."
    ],
    "es": [
      "En el corazón histórico de Trévoux, ¡venga a conocer a los artistas de la Rue[s] des Arts! Artistas apasionados: pintores, escultores, artistas plásticos, doradores, fabricantes de violines, modistas, tapiceros... le dan la bienvenida a su taller-galería."
    ]
  },
