  "rdfs:comment": {
    "de": [
      "Le Cellier des Bourbons wurde im Jahr 2000 gegründet und bietet den Verkauf von Weinen aus dem In- und Ausland an. 2019 hat sich das Unternehmen weiterentwickelt und den Weinkeller und das Feinkostgeschäft ausgebaut."
    ],
    "en": [
      "Founded in 2000, the Cellier des Bourbons sells wines from near and far, and has evolved in 2019 by developing its cellar and delicatessen."
    ],
    "it": [
      "Creato nel 2000, il Cellier des Bourbons vende vini vicini e lontani e nel 2019 amplierà la cantina e la gastronomia."
    ],
    "fr": [
      "Créée en 2000, le Cellier des Bourbons propose la vente de vins, d’ici et d’ailleurs, et a évolué en 2019 en développant la cave et l’épicerie fine."
    ],
    "es": [
      "Creado en 2000, el Cellier des Bourbons vende vinos de cerca y de lejos, y en 2019 ampliará su bodega y su charcutería."
    ],
    "nl": [
      "Cellier des Bourbons werd opgericht in 2000 en verkoopt wijnen van dichtbij en ver weg. In 2019 zal het zijn wijnkelder en delicatessenzaak uitbreiden."
    ]
  },
