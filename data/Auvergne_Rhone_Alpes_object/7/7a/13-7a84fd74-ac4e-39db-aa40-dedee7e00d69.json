  "rdfs:comment": {
    "de": [
      "Bereiten Sie sich auf eine authentische kulinarische Reise in das Herz der senegalesischen Küche und Kultur vor.\r\nHier erwarten Sie exotische Aromen, betörende Gewürze und eine warme, familiäre Atmosphäre."
    ],
    "en": [
      "Prepare to be transported on an authentic culinary journey to the heart of Senegalese cuisine and culture.\r\nExotic flavors, enchanting spices and a warm, family atmosphere await you."
    ],
    "it": [
      "Preparatevi a un autentico viaggio culinario nel cuore della cucina e della cultura senegalese.\r\nSapori esotici, spezie incantevoli e un'atmosfera calda e familiare vi aspettano."
    ],
    "fr": [
      "Préparez-vous à être transportés dans un voyage culinaire authentique au cœur de la cuisine et culture sénégalaise.\r\nSaveurs exotiques, épices envoûtantes , ambiance chaleureuse et familiale vous y attendent."
    ],
    "es": [
      "Prepárese para ser transportado en un auténtico viaje culinario al corazón de la cocina y la cultura senegalesas.\r\nLe esperan sabores exóticos, especias encantadoras y un ambiente cálido y familiar."
    ],
    "nl": [
      "Bereid je voor op een authentieke culinaire reis naar het hart van de Senegalese keuken en cultuur.\r\nExotische smaken, betoverende kruiden en een warme, familiale sfeer wachten op je."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Teranga"
    ]
  },
