  "rdfs:comment": {
    "de": [
      "Unsere vier Fluglehrer verfügen über 25 Jahre Erfahrung und werden ihre Leidenschaft für das Fliegen mit Ihnen teilen."
    ],
    "en": [
      "With 25 years' experience, our 4 instructors are committed to sharing their passion for hang-gliding in complete safety."
    ],
    "it": [
      "Con 25 anni di esperienza, i nostri 4 istruttori saranno lieti di condividere con voi la loro passione per il deltaplano in tutta sicurezza."
    ],
    "fr": [
      "Fort de 25 ans d'expérience, nos 4 moniteurs auront à cœur de vous faire partager leur passion du vol libre en toute sécurité."
    ],
