  "rdfs:comment": {
    "de": [
      "Coline und Karim laden Sie ein, in einem wunderschönen Steingebäude eine raffinierte lokale Küche zu entdecken. Auf der Speisekarte stehen regionale Produkte, gereiftes Fleisch und frischer Fisch, die von natürlichen Weinen begleitet werden."
    ],
    "en": [
      "Coline Zampa and Karim Geist invite you to discover a refined farm to table cuisine featuring dry aged meats from their local producers, fresh fish direct from the port of Séte, and natural wines from the area and beyond, all to be enjoyed in one of the oldest and grandest stone buildings in Les Vans"
    ],
    "it": [
      "Coline e Karim vi invitano a scoprire una raffinata cucina locale in uno splendido edificio in pietra. Nel menu: prodotti regionali, carni mature e pesce fresco, accompagnati da vini naturali."
    ],
    "fr": [
      "Coline et Karim vous invitent à découvrir une cuisine locale raffinée, dans une superbe bâtisse en pierre. Au menu : produits régionaux, viandes maturées et poissons frais, accompagnés de vins naturels."
    ],
    "es": [
      "Coline y Karim le invitan a descubrir la refinada cocina local en un magnífico edificio de piedra. En la carta: productos regionales, carnes maduradas y pescados frescos, acompañados de vinos naturales."
    ],
    "nl": [
      "Coline en Karim nodigen je uit om de verfijnde lokale keuken te ontdekken in een prachtig stenen gebouw. Op het menu: streekproducten, gerijpt vlees en verse vis, vergezeld van natuurlijke wijnen."
    ]
  },
  "rdfs:label": {
