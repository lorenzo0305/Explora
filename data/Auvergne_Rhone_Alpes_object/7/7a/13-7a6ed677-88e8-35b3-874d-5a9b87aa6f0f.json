  "rdfs:comment": {
    "de": [
      "Das ganze Jahr über 7/7 und 24/24 geöffnet, dank unseres Pizzaautomaten. Pizza, Nudeln, hausgemachte Tomatensoße, frische Produkte. Originelle und abwechslungsreiche Pizzen. Einfache und qualitativ hochwertige Schnellrestaurants und Sandwiches."
    ],
    "en": [
      "Open all year round 7/7. Pizzas, pastas with homemade fresh tomato sauce. Original and varied pizzas."
    ],
    "it": [
      "Aperto tutto l'anno 7/7 e 24/24 grazie al nostro distributore di pizza. Pizza, pasta, salsa di pomodoro fatta in casa, prodotti freschi. Pizze originali e varie. Fast food e panini, semplici e di qualità."
    ],
    "fr": [
      "Ouvert à l'année 7/7 et 24/24 grâce à notre distributeur de pizzas . Pizza, pâtes; sauce tomate maison, produits frais. Pizzas originales et variées. Restauration rapide et sandwicherie simple et de qualité."
    ],
    "nl": [
      "Het hele jaar geopend 7/7 en 24/24 dankzij onze pizza machine. Pizza, pasta, zelfgemaakte tomatensaus, verse producten. Originele en gevarieerde pizza's. Fast food en broodjes, eenvoudig en van kwaliteit."
    ],
    "es": [
      "Abierto todo el año 7/7 y 24/24 gracias a nuestra máquina de pizzas. Pizza, pasta, salsa de tomate casera, productos frescos. Pizzas originales y variadas. Comida rápida y bocadillos, sencillos y de calidad."
    ]
  },
