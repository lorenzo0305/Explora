  "rdfs:comment": {
    "de": [
      "Verleih von Wintersportgeräten im Winter. Verkauf von Bergausrüstung und Textilien mit Bootfitters und erfahrenen Verkäufern. Vermietung von Mountainbikes im Sommer. Ski- und Fahrradwerkstatt"
    ],
    "en": [
      "Mountain Story - Skiset is located next to the Palafour and Tovières ski lifts. We rent downhill and enduro bikes as well as e-bikes, skis, shoes and helmets / models of the year in all categories. Boutique with the most famous brands"
    ],
    "it": [
      "Noleggio di attrezzature per gli sport invernali. Vendita di attrezzature e tessuti per la montagna con esperti scarpinatori e personale di vendita. Noleggio di mountain bike in estate. Officina per sci e biciclette"
    ],
    "fr": [
      "Location matériel de glisse l'hiver. Vente équipements et textiles montagne avec bootfitteurs et vendeurs expériementés. Location de VTT l'été. Atelier ski - velo"
    ],
    "nl": [
      "Verhuur van wintersportuitrusting. Verkoop van berguitrusting en textiel met ervaren schoenmakers en verkopers. Verhuur van mountainbikes in de zomer. Ski- en fietswerkplaats"
    ],
    "es": [
      "Alquiler de material para deportes de invierno. Venta de material de montaña y textil con zapateros y vendedores experimentados. Alquiler de bicicletas de montaña en verano. Taller de esquí y bicicletas"
    ]
  },
