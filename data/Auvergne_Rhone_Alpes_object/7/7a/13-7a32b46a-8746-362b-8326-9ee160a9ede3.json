  "rdfs:comment": {
    "de": [
      "Wir sind seit 30 Jahren passionierte Gärtner und verkaufen Gemüse- und Beerenpflanzen, aber auch Beetpflanzen, Gräser, Chrysanthemen und Rollrasen."
    ],
    "en": [
      "A passionate horticulturist for 30 years, we sell vegetable and berry plants, as well as bedding plants, grasses, chrysanthemums and turf rolls."
    ],
    "it": [
      "Appassionato di orticoltura da 30 anni, vendiamo piante da orto e da bacca, oltre a piante da aiuola, erbe, crisantemi e tappeti erbosi."
    ],
    "fr": [
      "Horticulteur passionné depuis 30 ans, nous vendons des plants de légumes et de petits fruits mais aussi des plantes à massif, graminées, chrysanthèmes et gazon en rouleau."
    ],
    "nl": [
      "We zijn al 30 jaar een gepassioneerde tuinbouwer en verkopen groente- en bessenplanten, maar ook perkplanten, grassen, chrysanten en grasrollen."
    ],
    "es": [
      "Horticultor apasionado desde hace 30 años, vende plantas hortícolas y bayas, así como plantas de parterre, gramíneas, crisantemos y rollos de césped."
    ]
  },
