  "rdfs:comment": {
    "de": [
      "Bar-Restaurant im Weiler La Chal.\r\nTäglich von 17 Uhr bis 2 Uhr geöffnet.\r\nBar, Pub und Pizzeria mit Übertragung von Sportspielen, geselliger Atmosphäre und großer Südterrasse."
    ],
    "en": [
      "Bar-restaurant located in the hamlet of La Chal.\r\nOpen daily from 5 p.m. to 2 a.m.\r\nBar, pub and pizzeria showing sports matches, friendly atmosphere and large south-facing terrace."
    ],
    "it": [
      "Bar-ristorante nella frazione di La Chal.\r\nAperto tutti i giorni dalle 17.00 alle 2.00.\r\nBar, pub e pizzeria con trasmissioni sportive, atmosfera accogliente e ampia terrazza esposta a sud."
    ],
    "fr": [
      "Bar-restaurant situé au hameau de La Chal. \r\nOuvert tous les jours de 17h à 2h. \r\nBar, pub et pizzeria avec diffusion de matchs sportifs, ambiance conviviale et grande terrasse plein sud."
    ],
    "es": [
      "Bar-restaurante en la aldea de La Chal.\r\nAbierto todos los días de 17h a 2h.\r\nBar, pub y pizzería con retransmisiones deportivas, ambiente agradable y gran terraza orientada al sur."
    ],
    "nl": [
      "Bar-restaurant in het gehucht La Chal.\r\nDagelijks geopend van 17.00 tot 02.00 uur.\r\nBar, pub en pizzeria waar sportwedstrijden worden uitgezonden, gezellige sfeer en groot terras op het zuiden."
    ]
  },
