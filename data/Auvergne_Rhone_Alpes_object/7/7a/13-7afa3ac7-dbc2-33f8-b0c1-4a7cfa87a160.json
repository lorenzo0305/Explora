  "rdfs:comment": {
    "de": [
      "Das Ginkgo bietet Ihnen ein Tagesmenü sowie Gerichte à la carte. Es werden regelmäßig Themenabende veranstaltet."
    ],
    "en": [
      "Come and relax at the waterbody of Noirétable. Swimming, walking, petanque... spend a leisurely afternoon at the heart of the nature in a relaxing setting. Come to taste our specialities: menus frogs' legs and mussels-French fries."
    ],
    "it": [
      "Il Ginkgo offre un menù giornaliero e piatti à la carte. Vengono organizzate regolarmente serate a tema."
    ],
    "fr": [
      "Le Ginkgo vous propose un menu du jour ainsi que des plats à la carte. Des soirées à thèmes sont organisées régulièrement."
    ],
    "es": [
      "El Ginkgo ofrece un menú diario y platos a la carta. Se organizan regularmente veladas temáticas."
    ],
    "nl": [
      "De Ginkgo biedt een dagmenu en à la carte gerechten. Er worden regelmatig thema-avonden georganiseerd."
    ]
  },
