  "rdfs:comment": {
    "de": [
      "Gastronomische Küche. Hervorhebung von Qualitätsprodukten. Femininer Touch auf dem Teller. Die Menüs richten sich nach den Jahreszeiten. Eleganter Tisch, der die Freuden einer zeitgemäßen Küche und einer schönen Weinauswahl bietet. Hubert-Führer."
    ],
    "en": [
      "Gourmet cuisine that showcases quality products. With a feminine touch given to each dish, the menu varies with the season. An elegant setting serving delicious food and a great selection of wines. Guide Hubert."
    ],
    "it": [
      "Cucina gastronomica. Evidenziare i prodotti di qualità. Tocco femminile nel piatto. Menù preparati in base alle stagioni. Tavola elegante che offre i piaceri della cucina contemporanea e una raffinata selezione di vini. Guida Hubert."
    ],
    "fr": [
      "Cuisine gastronomique. Mise en avant des produits de qualité. Touche féminine dans l'assiette. Menus élaborés en fonction des saisons. Table élégante offrant les plaisirs d'une cuisine au goût du jour et d'une belle sélection de vins. Guide Hubert."
    ],
    "nl": [
      "Gastronomische keuken. Het benadrukken van kwaliteitsproducten. Vrouwelijke toets in de plaat. Menu's bereid volgens de seizoenen. Elegante tafel met de geneugten van de hedendaagse keuken en een fijne selectie wijnen. Gids Hubert."
    ],
    "es": [
      "Cocina gastronómica. Destacar los productos de calidad. Toque femenino en el plato. Menús preparados según las estaciones. Mesa elegante que ofrece los placeres de la cocina contemporánea y una fina selección de vinos. Guía Hubert."
    ]
  },
