  "rdfs:comment": {
    "de": [
      "Eine ungewöhnliche Flucht. Besuchen Sie unsere Jurte im Herzen des Waldes, um mit der Familie oder Freunden einen gemütlichen Moment bei einem savoyischen Fondue zu verbringen."
    ],
    "en": [
      "Join our yurt in the heart of the forest to share a convivial moment with family or friends around a Savoyard fondue."
    ],
    "it": [
      "Fuga insolita. Raggiungeteci nella nostra yurta nel cuore della foresta per condividere un momento conviviale con la famiglia o gli amici intorno a una fonduta savoiarda."
    ],
    "fr": [
      "Evasion insolite. Rejoignez notre yourte au cœur de la forêt pour partager un moment convivial en famille ou entre amis autour d’une fondue savoyarde."
    ],
    "es": [
      "Una fuga inusual. Acompáñenos en nuestra yurta en el corazón del bosque para compartir un momento de convivencia con la familia o los amigos en torno a una fondue saboyana."
    ],
    "nl": [
      "Sluit je aan bij onze yurt in het hart van het bos om een ​​gezellig moment met familie of vrienden te delen rond een Savoyaardse fondue."
    ]
  },
  "rdfs:label": {
    "en": [
      "The Unusual Yurt"
    ],
    "fr": [
      "Soirée Fondue sous la Yourte de Valmo'Insolite"
    ],
    "nl": [
      "De ongewone Yurt"
    ]
  },
