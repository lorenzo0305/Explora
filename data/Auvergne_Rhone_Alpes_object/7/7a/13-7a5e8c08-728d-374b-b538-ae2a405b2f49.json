  "rdfs:comment": {
    "de": [
      "Begeben Sie sich auf einen wilden Ausflug in das Herz des regionalen Naturparks Bauges und entdecken Sie die atemberaubenden Landschaften unter den höchsten Gipfeln der Bauges, zwischen Wäldern und Almen am Col de Chérel."
    ],
    "en": [
      "Set off on a wild escapade in the heart of the Bauges Regional Nature Park, and discover the breathtaking scenery beneath the highest peaks of the Bauges, between forests and mountain pastures at the Col de Chérel."
    ],
    "it": [
      "Partite per una fuga selvaggia nel cuore del Parco Naturale Regionale dei Bauges e scoprite i paesaggi mozzafiato sotto le cime più alte dei Bauges, tra boschi e pascoli di montagna al Col de Chérel."
    ],
    "fr": [
      "Partez pour une escapade sauvage en plein cœur du Parc naturel régional des Bauges, et découvrez ses paysages époustouflants sous les plus hauts sommets des Bauges, entre forêts et alpages au Col de Chérel."
    ],
    "nl": [
      "Vertrek voor een wilde escapade in het hart van het Parc Naturel Régional des Bauges en ontdek het adembenemende landschap onder de hoogste toppen van de Bauges, tussen bossen en alpenweiden op de Col de Chérel."
    ],
    "es": [
      "Embárquese en una escapada salvaje en pleno Parque Natural Regional de las Bauges y descubra los impresionantes paisajes bajo las cumbres más altas de las Bauges, entre bosques y pastos de montaña en el Col de Chérel."
    ]
  },
