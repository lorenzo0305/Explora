  "rdfs:comment": {
    "de": [
      "Ergebnis des Zusammenschlusses von zwei Gemeinden: Albiez-le-Vieux und Montrond.\r\nAlbiez-Montrond erstreckt sich auf einem Plateau, das das Maurienne-Tal gegenüber den Aiguilles d'Arves überragt."
    ],
    "en": [
      "The result of the union of two communes: Albiez-le-Vieux and Montrond.\r\nAlbiez-Montrond lies on a plateau overlooking the Maurienne valley, opposite the Aiguilles d'Arves."
    ],
    "it": [
      "Risultato dell'unione di due comuni: Albiez-le-Vieux e Montrond.\r\nAlbiez-Montrond si estende su un altopiano che domina la valle della Maurienne, di fronte alle Aiguilles d'Arves."
    ],
    "fr": [
      "Résultat de l'union de deux communes : Albiez-le-Vieux et Montrond.\r\nAlbiez-Montrond s'étend sur un plateau qui domine la vallée de la Maurienne, face aux Aiguilles d'Arves."
    ],
    "es": [
      "Resultado de la unión de dos municipios: Albiez-le-Vieux y Montrond.\r\nAlbiez-Montrond se extiende sobre una meseta que domina el valle de Maurienne, frente a las Aiguilles d'Arves."
    ],
    "nl": [
      "Resultaat van de vereniging van twee gemeenten: Albiez-le-Vieux en Montrond.\r\nAlbiez-Montrond strekt zich uit over een plateau dat de Maurienne-vallei domineert, tegenover de Aiguilles d'Arves."
    ]
  },
