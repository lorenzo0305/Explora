  "rdfs:comment": {
    "de": [
      "Lassen Sie sich in die bezaubernde Welt der Schokolade und der Süßigkeiten von früher entführen? Diese hochwertigen Produkte werden nach traditioneller Handwerkskunst hergestellt, ohne künstliche Aromen oder Konservierungsstoffe."
    ],
    "en": [
      "Let yourself be transported into the enchanting world of chocolate and confectionery of yesteryear? Top-of-the-range products, made in the pure artisanal tradition, with no artificial flavors or preservatives."
    ],
    "it": [
      "Lasciarsi trasportare nell'incantevole mondo del cioccolato e della pasticceria di un tempo? Prodotti di alta gamma, realizzati secondo la pura tradizione artigianale, senza aromi e conservanti artificiali."
    ],
    "fr": [
      "Laissez-vous transporter dans l’univers envoûtant du chocolat et des confiseries d'antan… Des produits haut de gamme, confectionnés dans la pure tradition artisanale, sans arôme artificiel, ni conservateur."
    ],
    "nl": [
      "Laat je je meevoeren naar de betoverende wereld van chocolade en zoetwaren van vroeger? Producten van topkwaliteit, gemaakt volgens de pure ambachtelijke traditie, zonder kunstmatige smaakstoffen of conserveringsmiddelen."
    ],
    "es": [
      "Déjese transportar al encantador mundo del chocolate y la repostería de antaño.. Productos de alta gama, elaborados según la más pura tradición artesanal, sin aromas artificiales ni conservantes."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Chocolaterie Sandrine Chappaz"
    ]
  },
