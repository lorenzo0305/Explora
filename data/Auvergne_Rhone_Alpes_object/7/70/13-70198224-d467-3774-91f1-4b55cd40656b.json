  "rdfs:comment": {
    "de": [
      "Der Gemüsebauer baut alle Arten von Gemüse an: Kartoffeln, Rotkohl, Rosenkohl, Romanesco, Blumenkohl, Chinakohl, Porree, Rote Bete, Tomaten, Mangold, Spinat, Rüben, Kürbisse, Zwiebeln und Melonen."
    ],
    "en": [
      "The market gardener grows all kinds of vegetables: potatoes, red cabbage, Brussels sprouts, Romanesco cabbage, cauliflower, Chinese cabbage, leeks, beet, tomatoes, Swiss chard, spinach, turnips, squash, onions and melon."
    ],
    "it": [
      "L'ortolano coltiva tutti i tipi di ortaggi: patate, cavolo rosso, cavolini di Bruxelles, cavolo romanesco, cavolfiore, cavolo cinese, porri, barbabietole, pomodori, bietole, spinaci, rape, zucche, cipolle e anche meloni."
    ],
    "fr": [
      "Le maraîcher cultive toutes sortes des légumes: pommes de terre, chou rouge, choux de Bruxelles, chou romanesco, chou-fleur, chou chinois, poireaux, betteraves, tomates, blettes,  épinards, navets ou encore courges, oignons, mais aussi du melon."
    ],
    "es": [
      "El hortelano cultiva todo tipo de verduras: patatas, col lombarda, coles de Bruselas, col romanesco, coliflor, col china, puerros, remolacha, tomates, acelgas, espinacas, nabos, calabazas, cebollas y también melones."
    ],
    "nl": [
      "De tuinder verbouwt allerlei soorten groenten: aardappelen, rode kool, spruitjes, Romanesco kool, bloemkool, Chinese kool, prei, rode bieten, tomaten, snijbiet, spinazie, rapen, pompoen, uien en ook meloenen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Maraîcher de Vorey"
    ]
  },
