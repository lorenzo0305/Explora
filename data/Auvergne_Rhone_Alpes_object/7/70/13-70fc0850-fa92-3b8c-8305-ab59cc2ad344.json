  "rdfs:comment": {
    "de": [
      "Begleiteter Besuch des landwirtschaftlichen Betriebs, der seit fünf Generationen in Betrieb ist. Aufzucht von Milchziegen und Mutterkühen. Kleine und große Tiere: Hühner, Kaninchen, Meerschweinchen, Esel, Pferd ..."
    ],
    "en": [
      "Guided tour of the farm, which has been in operation for 5 generations. Dairy goats and suckler cows. Small and large animals: chickens, rabbits, guinea pigs, donkey, horse ..."
    ],
    "it": [
      "Visita guidata della fattoria, in funzione da 5 generazioni. Allevamento di capre da latte e vacche nutrici. Animali di piccola e grande taglia: polli, conigli, porcellini d'India, asini, cavalli, ecc."
    ],
    "fr": [
      "Visite accompagnée de l'exploitation agricole en activité depuis 5 générations. Élevage de chèvres laitières et vaches allaitantes. Petits et grands animaux : poules, lapins, cochons d'inde, âne, cheval .."
    ],
    "es": [
      "Visita guiada a la explotación, que lleva 5 generaciones en funcionamiento. Cría de cabras lecheras y vacas nodrizas. Animales pequeños y grandes: gallinas, conejos, cobayas, burros, caballos, etc."
    ],
    "nl": [
      "Rondleiding over de boerderij, die al 5 generaties in bedrijf is. Fokken van melkgeiten en zoogkoeien. Kleine en grote dieren: kippen, konijnen, cavia's, ezels, paarden, enz."
    ]
  },
  "rdfs:label": {
