  "rdfs:comment": {
    "de": [
      "Das Haras d'Écotier vereint 3 sich ergänzende Aktivitäten: eine Reitschule, einen Turnierstall und eine kleine Zucht, deren Fohlen den Zwingernamen \"Écotier\" tragen."
    ],
    "en": [
      "The Haras d'Écotier combines 3 complementary activities: a riding school, a competition stable and a small breeding operation whose foals carry the \"Écotier\" affix."
    ],
    "it": [
      "L'Haras d'Écotier combina 3 attività complementari: una scuola di equitazione, una scuderia da competizione e un piccolo allevamento i cui puledri portano il marchio \"Écotier\"."
    ],
    "fr": [
      "Le Haras d'Écotier regroupe 3 activités complémentaires : une école d'équitation, une écurie de compétition et un petit élevage dont les poulains portent l'affixe \"Écotier\"."
    ],
    "es": [
      "El Haras d'Écotier combina 3 actividades complementarias: una escuela de equitación, una cuadra de competición y una pequeña explotación de cría cuyos potros llevan el afijo \"Écotier\"."
    ],
    "nl": [
      "De Haras d'Écotier combineert 3 complementaire activiteiten: een manege, een wedstrijdstal en een kleine fokkerij waarvan de veulens de toevoeging \"Écotier\" dragen."
    ]
  },
