  "rdfs:comment": {
    "de": [
      "Bläserquintett \"Aeris\". Ein Blechbläserensemble aus Toulouse, das sein Publikum mit berühmten und abwechslungsreichen Stücken von Bach, Händel, Gershwin, Nougaro, Glenn Miller ... Eintrittskarten für das Office de Tourisme, online oder vor Ort."
    ],
    "en": [
      "Aeris\" wind quintet. A brass ensemble from Toulouse, transporting its audience to a wide variety of famous pieces by Bach, Handel, Gershwin, Nougaro, Glenn Miller and more... Tickets at tourist office, online or on site."
    ],
    "it": [
      "Quintetto di fiati \"Aeris\". Un ensemble di ottoni di Tolosa che trasporta il pubblico in una varietà di brani famosi di Bach, Handel, Gershwin, Nougaro, Glenn Miller e altri. Biglietti disponibili presso l'ufficio turistico, online o in loco."
    ],
    "fr": [
      "Quintette à vents \"Aeris\". Ensemble de cuivres toulousains transportant son public dans de célèbres pièces variées, Bach, Haendel, Gershwin, Nougaro, Glenn Miller ... Billetterie office de tourisme, en ligne ou sur place."
    ],
    "es": [
      "Quinteto de viento \"Aeris\". Un conjunto de metales de Toulouse que transportará a su público a una variedad de piezas famosas de Bach, Haendel, Gershwin, Nougaro, Glenn Miller y otros. Entradas disponibles en la oficina de turismo, en línea o in situ."
    ],
    "nl": [
      "Blaaskwintet \"Aeris\". Een koperensemble uit Toulouse dat zijn publiek meeneemt naar een verscheidenheid aan beroemde stukken van Bach, Händel, Gershwin, Nougaro, Glenn Miller en anderen. Tickets verkrijgbaar bij het toeristenbureau, online of ter plaatse."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Festival Musiques en Vivarais Lignon"
    ]
  },
