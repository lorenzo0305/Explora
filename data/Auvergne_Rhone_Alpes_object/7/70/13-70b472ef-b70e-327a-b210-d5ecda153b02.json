  "rdfs:comment": {
    "de": [
      "Nehmen Sie am 11. November 2026 am Friedensmarsch in Bains teil: Solidaritätswanderungen von 8 oder 14 km Länge zugunsten einer Organisation. Start ab 13:30 Uhr, Verpflegung unterwegs und Imbiss am Ziel. Anmeldung vor Ort, gesellige Atmosphäre garantiert."
    ],
    "en": [
      "Take part in the Marche de la Paix in Bains on November 11, 2026: 8 or 14 km hikes in aid of a charity. Departure at 1:30pm, refreshments along the way and a snack at the finish. Registration on site, friendly atmosphere guaranteed."
    ],
    "it": [
      "Partecipate alla Camminata della Pace a Bains l'11 novembre 2026: una passeggiata di 8 o 14 km a favore di un'associazione benefica. Partenza alle 13.30, ristoro lungo il percorso e merenda all'arrivo. Iscrizioni in loco, atmosfera amichevole garantita."
    ],
    "fr": [
      "Participez à la Marche de la Paix à Bains le 11 novembre 2026 : randonnées solidaires de 8 ou 14 km au profit d’une association. Départ dès 13h30, ravitaillement en chemin et goûter à l’arrivée. Inscription sur place, ambiance conviviale garantie."
    ],
    "es": [
      "Participa en la Marcha de la Paz de Bains el 11 de noviembre de 2026: una marcha de 8 o 14 km a beneficio de una organización benéfica. Salida a las 13.30 h, con refrescos por el camino y un tentempié al final. Inscripciones in situ, ambiente agradable garantizado."
    ],
    "nl": [
      "Doe mee aan de Vredeswandeling in Bains op 11 november 2026: een wandeling van 8 of 14 km voor een goed doel. Start om 13.30 uur, met versnaperingen onderweg en een snack bij de finish. Inschrijving ter plaatse, gezellige sfeer gegarandeerd."
    ]
  },
