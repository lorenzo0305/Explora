  "rdfs:comment": {
    "de": [
      "Diese Geschichte war das Ergebnis der Recherchen von drei Apothekern: André Frogerais in Paris, Françoise und Catherine Nivelon in den Departements Allier und Puy de Dôme sowie Catherine Flower-Deltour, der Enkelin von Edmond Lauriat."
    ],
    "en": [
      "This story is the fruit of research by three pharmacists: André Frogerais in Paris, Françoise and Catherine Nivelon in the Allier and Puy de Dôme regions, and Catherine Flower-Deltour, Edmond Lauriat's granddaughter."
    ],
    "it": [
      "Questa storia è il risultato delle ricerche di tre farmacisti, André Frogerais a Parigi, Françoise e Catherine Nivelon nelle regioni di Allier e Puy de Dôme e Catherine Flower-Deltour, nipote di Edmond Lauriat."
    ],
    "fr": [
      "Cette histoire a été le fruit des recherches de  trois pharmaciens, André Frogerais sur Paris, Françoise et Catherine Nivelon sur l'Allier et le Puy de Dôme, ainsi que Catherine Flower-Deltour, la petite-fille d'Edmond Lauriat."
    ],
    "es": [
      "Esta historia es el resultado de la investigación de tres farmacéuticos, André Frogerais en París, Françoise y Catherine Nivelon en las regiones de Allier y Puy de Dôme, y Catherine Flower-Deltour, nieta de Edmond Lauriat."
    ],
    "nl": [
      "Dit verhaal is het resultaat van onderzoek door drie apothekers, André Frogerais in Parijs, Françoise en Catherine Nivelon in de regio's Allier en Puy de Dôme, en Catherine Flower-Deltour, de kleindochter van Edmond Lauriat."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Conférence SHAVE : Les Fructines-Vichy  une saga familiale au XXe siècle, par Françoise et Catherine NIVELON"
    ]
  },
