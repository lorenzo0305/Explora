  "rdfs:comment": {
    "de": [
      "Sie wurde schnell zu einem der Gesichter der Stand-up-Comedy in den Comedy-Clubs von Rennes, gewann im Januar 2023 den Preis der Jury beim Festival Rire & Vilaine und ist nun mit ihrer ersten Show Salé auf Tournee."
    ],
    "en": [
      "Quickly becoming one of the faces of stand-up in Rennes comedy clubs, she won the jury prize at the Festival Rire & Vilaine in January 2023, and is now touring her first show, Salé."
    ],
    "it": [
      "Diventa rapidamente uno dei volti della stand-up nei club comici di Rennes e nel gennaio 2023 vince il Premio della Giuria al Festival Rire & Vilaine e porta in tour il suo primo spettacolo, Salé."
    ],
    "fr": [
      "Rapidement devenu l’un des visages du stand-up dans les comedy-clubs de Rennes, elle remporte en janvier 2023 le prix du jury au Festival Rire & Vilaine, et livre à présent la tournée de son premier spectacle Salé."
    ],
    "nl": [
      "Ze werd al snel een van de gezichten van stand-up in de comedyclubs van Rennes en won in januari 2023 de juryprijs op het Festival Rire & Vilaine en is nu op tournee met haar eerste show, Salé."
    ],
    "es": [
      "Rápidamente se convirtió en uno de los rostros del stand-up en los clubs de comedia de Rennes, y en enero de 2023 ganó el Premio del Jurado en el Festival Rire & Vilaine, y ahora está de gira con su primer espectáculo, Salé."
    ]
  },
  "rdfs:label": {
    "fr": [
      "\" Salé\" Sarah-Anna"
    ]
  },
