      "dc:description": {
        "de": [
          "Kreative Geschichten\nKomm und dekoriere deine Maske!\n\nBibliothek der Annonciades, Jugend- und Jugendbereich\n\nAb 5 Jahren in Begleitung eines Erwachsenen.\nKostenlos, nach Anmeldung"
        ],
        "en": [
          "Creative stories\nCome and decorate your mask!\n\nAnnonciades Library, Youth Sector\n\nFrom age 5 with an adult.\nFree, registration required"
        ],
        "it": [
          "Storie creative\nVieni a decorare la tua maschera!\n\nBiblioteca Annonciades, sezione Giovani\n\nA partire dai 5 anni con un adulto.\nGratuito, iscrizione obbligatoria"
        ],
        "fr": [
          "Histoires créatives\nViens décorer ton masque !\n\nBibliothèque des Annonciades, secteur Jeunesse-Ados\n\nA partir de 5 ans avec un adulte.\nGratuit, sur inscription"
        ],
        "es": [
          "Cuentos creativos\nVen a decorar tu máscara\n\nBiblioteca Annonciades, sección Juventud\n\nA partir de 5 años con un adulto.\nGratis, inscripción obligatoria"
        ],
        "nl": [
          "Creatieve verhalen\nKom je masker versieren!\n\nBibliotheek Annonciades, afdeling Jeugd\n\nVanaf 5 jaar onder begeleiding van een volwassene.\nGratis, inschrijving verplicht"
        ]
      },
