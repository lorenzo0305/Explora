  "rdfs:comment": {
    "de": [
      "Das Casabea liegt nur wenige Schritte von der Rue Mercière entfernt und besticht durch seine Terrasse, seine Gourmetgerichte und seine entspannte Atmosphäre im Bohème-Chic. Der Chefkoch stimuliert die Geschmacksknospen mit seiner mediterran inspirierten Küche und seinen köstlichen Gourmetkreationen."
    ],
    "en": [
      "Nestling a stone's throw from rue Mercière, Casabea boasts a terrace, gourmet dishes and a relaxed, bohemian chic atmosphere. The Chef stimulates the taste buds with his Mediterranean-inspired cuisine and tasty gourmet creations."
    ],
    "it": [
      "A due passi da rue Mercière, Casabea seduce con la sua terrazza, i suoi piatti gourmet e la sua atmosfera rilassata e bohémien chic. Lo chef stimola le papille gustative con la sua cucina di ispirazione mediterranea e le sue gustose creazioni gastronomiche."
    ],
    "fr": [
      "Niché à deux pas de la rue Mercière, Casabea séduit par sa terrasse, ses plats gourmands et son ambiance bohème chic décontractée. Le Chef stimule les papilles grâce à sa cuisine d'inspiration méditerranéenne et ses savoureuses créations gourmandes."
    ],
    "es": [
      "Situado a un paso de la rue Mercière, Casabea seduce con su terraza, sus platos gourmet y su ambiente relajado y bohemio. El chef estimula las papilas gustativas con su cocina de inspiración mediterránea y sus sabrosas creaciones gourmet."
    ],
    "nl": [
      "Casabea, gelegen op een steenworp afstand van de rue Mercière, verleidt met zijn terras, zijn gastronomische gerechten en zijn ontspannen bohemien-chique sfeer. De chef prikkelt de smaakpapillen met zijn mediterraan geïnspireerde keuken en smakelijke gastronomische creaties."
    ]
  },
