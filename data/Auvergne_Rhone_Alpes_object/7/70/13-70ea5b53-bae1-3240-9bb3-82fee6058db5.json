  "rdfs:comment": {
    "de": [
      "Die Compagnons de Panaveyre organisieren in Zusammenarbeit mit der Association Forteresse Polignac Patrimoine am 30. und 31. Mai das traditionelle nationale Turnier für mittelalterliche Bogenschützen."
    ],
    "en": [
      "The Compagnons de Panaveyre, in partnership with the Association Forteresse Polignac Patrimoine, are organizing the traditional national medieval archery tournament on May 30 and 31."
    ],
    "it": [
      "I Compagnons de Panaveyre, in collaborazione con l'Associazione Forteresse Polignac Patrimoine, organizzano il 30 e 31 maggio il tradizionale torneo nazionale di tiro con l'arco medievale."
    ],
    "fr": [
      "Les Compagnons de Panaveyre en partenariat avec l’Association Forteresse Polignac Patrimoine organisent les 30 et 31 mai prochains le traditionnel tournoi national d’archerie médiévale."
    ],
    "es": [
      "Los Compagnons de Panaveyre, en colaboración con la Association Forteresse Polignac Patrimoine, organizan los días 30 y 31 de mayo el tradicional torneo nacional de tiro con arco medieval."
    ],
    "nl": [
      "De Compagnons de Panaveyre organiseren in samenwerking met de Association Forteresse Polignac Patrimoine het traditionele nationale middeleeuwse boogschiettoernooi op 30 en 31 mei."
    ]
  },
  "rdfs:label": {
