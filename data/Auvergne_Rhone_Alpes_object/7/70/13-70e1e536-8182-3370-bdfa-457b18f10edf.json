  "rdfs:comment": {
    "de": [
      "Auf der Ferme Équestre de la Renardière können Sie das Reiten im Freien entdecken! Im Unterricht, im Praktikum... verschiedene Formeln werden Ihnen angeboten. Reiten ist hier von 4 bis 77 Jahren möglich!"
    ],
    "en": [
      "La Ferme Equestre de la Renardière makes you discover outdoor horseback riding! In class, in training course... different formulas will be proposed to you. Horse riding here is from 4 years old to 77 years old !"
    ],
    "it": [
      "La Ferme Equestre de la Renardière vi invita a scoprire l'equitazione all'aperto! Lezioni, corsi... vi verranno proposte diverse formule. Qui si cavalca dai 4 ai 77 anni!"
    ],
    "fr": [
      "La Ferme Équestre de la Renardière vous fait découvrir l'équitation d'extérieur ! En cours, en stage... différentes formules vous seront proposées. L'équitation ici, c'est de 4 ans à 77 ans !"
    ],
    "es": [
      "La Ferme Equestre de la Renardière le invita a descubrir la equitación al aire libre Lecciones, cursos... se le propondrán diferentes fórmulas. Aquí se monta desde los 4 hasta los 77 años"
    ],
    "nl": [
      "De Ferme Equestre de la Renardière nodigt u uit om de buitenritten te ontdekken! Lessen, cursussen... verschillende formules worden u voorgesteld. Er wordt hier gereden van 4 tot 77 jaar oud!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Fermes Équestres du Vercors - La Chevauchée & La Renardière"
    ]
  },
