  "rdfs:comment": {
    "de": [
      "Nehmen Sie an einem sportlichen und geselligen Tag teil, der von der Association des donneurs de sang bénévoles de Montfaucon-Dunières organisiert wird! Egal, ob Sie gerne wandern oder leidenschaftlich gerne Mountainbike fahren. Wandern: 8, 14 oder 22 km - Mountainbike: 15, 33 oder 50 km"
    ],
    "en": [
      "Come and take part in a fun and sporting day organized by the Montfaucon-Dunières voluntary blood donor association! Whether you're a hiker or a mountain biker. Hiking: 8, 14 or 22 km - Mountain biking: 15, 33 or 50 km"
    ],
    "it": [
      "Partecipate alle attività ludiche e sportive organizzate dall'associazione di donatori volontari di sangue di Montfaucon-Dunières! Che siate appassionati di escursionismo o di mountain bike. Escursione a piedi: 8, 14 o 22 km - Mountain bike: 15, 33 o 50 km"
    ],
    "fr": [
      "Venez participer à une journée sportive et conviviale organisée par l’association des donneurs de sang bénévoles de Montfaucon-Dunières ! Que vous soyez amateur de randonnée ou passionné de VTT. Randonnée pédestre : 8, 14 ou 22 km -  VTT : 15, 33 ou 50 km"
    ],
    "es": [
      "Participe en las actividades lúdicas y deportivas organizadas por la asociación de donantes voluntarios de sangre de Montfaucon-Dunières Ya seas un apasionado del senderismo o de la bicicleta de montaña. Senderismo: 8, 14 o 22 km - Bicicleta de montaña: 15, 33 o 50 km"
    ],
    "nl": [
      "Kom meedoen aan de ludieke en sportieve activiteiten die worden georganiseerd door de vrijwillige bloeddonorvereniging van Montfaucon-Dunières! Of je nu een fervent wandelaar of mountainbiker bent. Wandelen: 8, 14 of 22 km - Mountainbiken: 15, 33 of 50 km"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Randonnée pédestre et VTT"
    ]
  },
