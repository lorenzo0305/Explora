  "rdfs:comment": {
    "de": [
      "Leïla Ka: Eine kraftvolle Hymne an die Schwesternschaft!\r\nLeïla Ka, ein aufsteigender Stern der jungen französischen Choreografieszene, bietet uns hier eine poetische und eindringliche Erkundung der Weiblichkeit."
    ],
    "en": [
      "Leïla Ka: A powerful hymn to sisterhood!\r\nA rising star on the young French choreographic scene, Leïla Ka offers us a poetic and powerful exploration of the feminine."
    ],
    "it": [
      "Leïla Ka: un potente inno alla sorellanza!\r\nAstro nascente della giovane scena coreografica francese, Leïla Ka ci offre un'esplorazione poetica e potente del femminile."
    ],
    "fr": [
      "Leïla Ka : Un hymne puissant à la sororité !\r\nEtoile montante de la jeune scène chorégraphique française, Leïla Ka nous offre ici une exploration poétique et percutante du féminin."
    ],
    "es": [
      "Leïla Ka: ¡Un poderoso himno a la hermandad!\r\nLeïla Ka, estrella emergente de la joven escena coreográfica francesa, nos ofrece una poética y poderosa exploración de lo femenino."
    ],
    "nl": [
      "Leïla Ka: Een krachtige lofzang op het zusterschap!\r\nLeïla Ka, een rijzende ster in de jonge Franse choreografische scene, biedt ons een poëtische en krachtige verkenning van het vrouwelijke."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Danse - Maldonne"
    ]
  },
