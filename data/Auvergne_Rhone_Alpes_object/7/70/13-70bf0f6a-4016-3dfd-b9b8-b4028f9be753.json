  "rdfs:comment": {
    "de": [
      "Diese Einrichtung mit einer Kapazität von 600 Sitzplätzen und 1200 Konzertplätzen ermöglicht es Les Houches, Aufführungen und Veranstaltungen aller Art, Festivals, Bankette, Kongresse, Konferenzen, Seminare, Messen, Ausstellungen... zu beherbergen."
    ],
    "en": [
      "This hall has 600 seatings and standing room for 1200 people. It welcomes shows, concerts, seminars, conferences, exhibitions, festivals..."
    ],
    "it": [
      "Questa struttura, con una capacità di 600 posti a sedere e 1.200 posti per i concerti, permette a Les Houches di ospitare spettacoli ed eventi di ogni tipo, festival, banchetti, congressi, conferenze, seminari, fiere, mostre, ecc."
    ],
    "fr": [
      "Cet équipement d'une capacité d'accueil de 600 places assises et 1 200 places en concert permet aux Houches d'accueillir des spectacles et animations en tous genres, festivals, banquets, congrès, conférences, séminaires, salons, expositions..."
    ],
    "es": [
      "Esta instalación, con un aforo de 600 plazas y 1.200 para conciertos, permite a Les Houches acoger espectáculos y eventos de todo tipo, festivales, banquetes, congresos, conferencias, seminarios, ferias, exposiciones, etc."
    ],
    "nl": [
      "Deze faciliteit, met een capaciteit van 600 plaatsen en 1.200 plaatsen voor concerten, stelt Les Houches in staat om allerlei voorstellingen en evenementen, festivals, banketten, congressen, conferenties, seminars, beurzen, tentoonstellingen, enz. te organiseren."
    ]
  },
  "rdfs:label": {
    "en": [
      "Conference and seminaries hall : Espace Olca"
    ],
    "fr": [
      "Espace Olca - Salle de congrès/séminaires/spectacles"
    ]
  },
