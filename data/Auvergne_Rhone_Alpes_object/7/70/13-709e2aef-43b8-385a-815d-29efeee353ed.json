  "rdfs:comment": {
    "de": [
      "Der Valléen bietet einen direkten Zugang vom Tal und dem SNCF-Bahnhof zum Herzen des Skiortes und verbessert so die Erreichbarkeit der Dörfer Le Fayet und Saint-Gervais, des Skigebiets und der touristischen Aktivitäten das ganze Jahr über."
    ],
    "en": [
      "By providing direct access from the valley to the heart of the resort, the Valléen gondola lift will improve year-round access to and from the villages of Le Fayet and Saint-Gervais, the ski area and various tourist activities."
    ],
    "it": [
      "Offrendo un accesso diretto dalla valle al cuore della località, il Valléen migliora l'accesso ai villaggi di Le Fayet e Saint-Gervais, al comprensorio sciistico e alle attività turistiche durante tutto l'anno."
    ],
    "fr": [
      "En offrant un accès direct depuis la vallée et la gare SNCF jusqu’au cœur de la station, le Valléen améliore l’accessibilité des villages du Fayet et de Saint-Gervais, domaine skiable et des activités touristiques tout au long de l’année."
    ],
    "nl": [
      "Door directe toegang te bieden vanuit de vallei en het SNCF-station naar het hart van het resort, verbetert Valléen de toegankelijkheid van de dorpen Le Fayet en Saint-Gervais, het skigebied en de toeristische activiteiten het hele jaar door."
    ],
    "es": [
      "Al ofrecer un acceso directo desde el valle y la estación SNCF hasta el corazón de la estación, el Valléen mejora la accesibilidad a los pueblos de Le Fayet y Saint-Gervais, a la zona de esquí y a las actividades turísticas durante todo el año."
    ]
  },
