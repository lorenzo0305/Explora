  "rdfs:comment": {
    "de": [
      "Im Herzen des Brevon-Tals, ausgehend vom Zentrum des Dorfes Bellevaux, bietet der Fluss Brevon eine zugängliche und gut gepflegte Angelstrecke am Fuße der Berge in einer grünen Umgebung."
    ],
    "en": [
      "In the heart of the Brevon valley, from the center of the village of Bellevaux, the Brevon river offers you an accessible, well-maintained fishing course at the foot of the mountains in a verdant setting."
    ],
    "it": [
      "Nel cuore della valle del Brevon, dal centro del villaggio di Bellevaux, il fiume Brevon vi offre un percorso di pesca accessibile e ben curato ai piedi delle montagne, in un ambiente verdeggiante."
    ],
    "fr": [
      "Au cœur de la vallée du Brevon à partir du centre du village de Bellevaux, la rivière du Brevon vous offre un parcours accessible et bien entretenu de pêche au pied des montagnes dans un décor verdoyant."
    ],
    "nl": [
      "In het hart van de Brevon vallei vanuit het centrum van het dorp Bellevaux, biedt de Brevon je een toegankelijk en goed onderhouden vispad aan de voet van de bergen in een weelderige groene omgeving."
    ],
    "es": [
      "En el corazón del valle del Brevon, desde el centro del pueblo de Bellevaux, el río Brevon le ofrece un sendero de pesca accesible y bien mantenido al pie de las montañas en un entorno verde y exuberante."
    ]
  },
