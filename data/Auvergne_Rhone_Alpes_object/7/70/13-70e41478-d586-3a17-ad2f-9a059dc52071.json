  "rdfs:comment": {
    "de": [
      "Dieses Herrenhaus wurde im 19. Jahrhundert inmitten von Weinbergen erbaut und war und ist ein Familienhaus par excellence. Die Unterkunft wurde im Erdgeschoss mit Terrasse eingerichtet."
    ],
    "en": [
      "Built during the 19th century, in the heart of the vineyards, this building was and remains an ultimate mansion. The holiday cottage has been set up on the ground floor and features a terrace."
    ],
    "it": [
      "Costruita nel XIX secolo in mezzo ai vigneti, questa casa padronale è stata e rimane una casa di famiglia per eccellenza. L'alloggio si trova al piano terra e dispone di una terrazza."
    ],
    "fr": [
      "Bâtie au cours du 19ème siècle, au beau milieu des vignes, cette maison de maître a été et reste familiale par excellence. Le gîte a été aménagé au rez-de-chaussée avec terrasse."
    ],
    "nl": [
      "Dit landhuis, gebouwd in de 19e eeuw te midden van de wijngaarden, is en blijft een familiehuis bij uitstek. De gîte bevindt zich op de begane grond en heeft een terras."
    ],
    "es": [
      "Construida en el siglo XIX en medio de los viñedos, esta casa solariega ha sido y sigue siendo un hogar familiar por excelencia. La casa rural se encuentra en la planta baja y dispone de terraza."
    ]
  },
