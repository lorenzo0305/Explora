  "rdfs:comment": {
    "de": [
      "Im Herzen des Skiortes Avoriaz entdecken Sie unser Chalet und seinen Ski-Lernbereich, der den Kleinsten gewidmet ist! Das Kinderdorf ist gleichzeitig ein Freizeitzentrum und eine Skischule für Kinder und Jugendliche zwischen 3 und 16 Jahren."
    ],
    "en": [
      "In the heart of the Avoriaz resort, discover our chalet and its snow area specially designed for little ones! The Village des Enfants is both a leisure center and a ski school for children and teenagers aged 3 to 16."
    ],
    "it": [
      "Nel cuore della stazione di Avoriaz, scoprite il nostro chalet e la sua area didattica dedicata ai più piccoli! Il Villaggio dei bambini è sia un centro ricreativo che una scuola di sci per bambini e ragazzi dai 3 ai 16 anni."
    ],
    "fr": [
      "Au cœur de la station d’Avoriaz, découvrez notre chalet et sa zone d’apprentissage de la glisse dédiée aux plus petits ! Le Village des Enfants est à la fois un centre de loisirs et une école de ski pour les enfants et les adolescents âgés de 3 à 16 ans."
    ],
    "nl": [
      "In het hart van het skioord Avoriaz ontdek je ons chalet en het oefengebied dat speciaal is ontworpen voor de kleintjes! Het Village des Enfants is zowel een recreatiecentrum als een skischool voor kinderen en tieners van 3 tot 16 jaar."
    ],
    "es": [
      "En el corazón de la estación de Avoriaz, descubra nuestro chalet y su espacio de aprendizaje dedicado a los más pequeños La Aldea de los Niños es a la vez un centro de ocio y una escuela de esquí para niños y adolescentes de 3 a 16 años."
    ]
  },
  "rdfs:label": {
    "en": [
      "Children's Village by ESF"
    ],
    "fr": [
      "Village des Enfants by ESF"
    ],
    "nl": [
      "Children's Village by ESF"
    ]
  },
