  "rdfs:comment": {
    "de": [
      "Eines der unumgänglichen Naturdenkmäler der Haute-Loire. Entdecken Sie die Schlucht von Corboeuf, einen Canyon aus buntem Lehm in Rosières zwischen den Vulkanen und den Schluchten der Suissesse."
    ],
    "en": [
      "The Corboeuf ravine is one of the most famous natural monuments in the Haute-Loire region. It is a multi-coloured clay canyon near Rosières between the volcanoes and gorges of the River Suissesse."
    ],
    "it": [
      "Uno dei monumenti naturali più importanti della Haute-Loire, scoprite la gola di Corboeuf, un canyon di argille multicolori a Rosières tra i vulcani e le gole della Suissesse."
    ],
    "fr": [
      "Un des monuments naturel incontournables de Haute-Loire, découvrez le ravin de Corboeuf, canyon d'argiles multicolores à Rosières entre les volcans et les gorges de la Suissesse."
    ],
    "es": [
      "Uno de los monumentos naturales más importantes del Alto Loira, descubra el barranco de Corboeuf, un cañón de arcillas multicolores en Rosières entre los volcanes y las gargantas de la Suissesse."
    ],
    "nl": [
      "Een van de niet te missen natuurmonumenten van de Haute-Loire, ontdek het ravijn van Corboeuf, een canyon van veelkleurige klei in Rosières tussen de vulkanen en de kloven van de Suissesse."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Ravin de Corboeuf"
    ]
  },
