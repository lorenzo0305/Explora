  "rdfs:comment": {
    "de": [
      "Das Schild bezieht sich auf die italienische Fußballmannschaft, die squadra Azzura. An den Wänden hängen Fußballtrikots und auf der Speisekarte finden Sie eine Vielzahl von Pizzen mit wohlklingenden Namen (Auxerroise, Lensoise, Marseille, PSG...)."
    ],
    "en": [
      "The sign refers to the Italian football team, the Squadra Azzura. On the walls, football shirts and a la carte a waltz of pizzas with evocative names (l'Auxerroise, la Lensoise, la Marseille or la PSG...)."
    ],
    "it": [
      "L'insegna si riferisce alla squadra di calcio italiana, la Squadra Azzura. Alle pareti, magliette di calcio e sul menu un valzer di pizze dai nomi evocativi (l'Auxerroise, la Lensoise, la Marsiglia o la PSG...)."
    ],
    "fr": [
      "L’enseigne fait référence à l’équipe de foot Italienne, la squadra Azzura. Sur les murs, maillots de foot et à la carte une valse de pizzas aux noms évocateurs (l’Auxerroise, la Lensoise, la Marseille ou la PSG...)."
    ],
    "nl": [
      "Het bord verwijst naar de Italiaanse voetbalploeg, de squadra Azzura. Aan de muren hangen voetbalshirts en op het menu staat een wals van pizza's met suggestieve namen (l'Auxerroise, la Lensoise, la Marseille of la PSG...)."
    ],
    "es": [
      "El cartel hace referencia al equipo de fútbol italiano, la squadra Azzura. En las paredes, camisetas de fútbol y en la carta un vals de pizzas con nombres evocadores (la Auxerroise, la Lensoise, la Marseille o la PSG...)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant La Squadra"
    ]
  },
