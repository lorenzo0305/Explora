  "rdfs:comment": {
    "de": [
      "Géologic Garden bietet französische geschliffene Steine, Schmuck, einzigartige, in der Auvergne hergestellte Objekte und Workshops zur Einführung in die Steinschleiferei an."
    ],
    "en": [
      "Géologic Garden offers French cut stones, jewelry, unique objects made in Auvergne and introductory stone-cutting workshops."
    ],
    "it": [
      "Il Giardino Géologic offre pietre tagliate francesi, gioielli, oggetti unici realizzati in Alvernia e laboratori di introduzione al taglio della pietra."
    ],
    "fr": [
      "Géologic Garden propose des pierres taillées françaises, de la joaillerie, des objets uniques fabriqués en Auvergne et des ateliers d’initiation à la taille de pierres."
    ],
    "es": [
      "Géologic Garden ofrece piedras talladas francesas, joyas, objetos únicos fabricados en Auvernia y talleres de iniciación a la talla de piedra."
    ],
    "nl": [
      "Géologic Garden biedt Franse geslepen stenen, sieraden, unieke voorwerpen gemaakt in de Auvergne en inleidende workshops steenhouwen."
