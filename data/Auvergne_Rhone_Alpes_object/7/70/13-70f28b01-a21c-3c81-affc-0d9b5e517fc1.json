  "rdfs:comment": {
    "de": [
      "Auf einem kleinen, diversifizierten Bauernhof, der biologisch bewirtschaftet wird, bauen wir Weizen an, um daraus Mehl und später Brot zu backen, und halten Kühe und Schafe, deren Fleisch wir direkt verkaufen."
    ],
    "en": [
      "On a small, diversified, organic farm, we grow wheat to make flour and then bread and we rear cows and sheep whose meat we sell direct."
    ],
    "it": [
      "In una piccola azienda agricola diversificata, in regime di agricoltura biologica, coltiviamo il grano per produrre farina e pane e alleviamo mucche e pecore di cui vendiamo direttamente la carne."
    ],
    "fr": [
      "Sur une petite ferme diversifiée, en agriculture biologique, nous cultivons du blé pour en faire de la farine puis du pain et nous élevons des vaches et des brebis dont nous vendons la viande en direct."
    ],
    "nl": [
      "Op een kleine, gediversifieerde biologische boerderij verbouwen we tarwe om meel en brood van te maken en we fokken koeien en schapen waarvan we het vlees direct verkopen."
    ],
    "es": [
      "En una pequeña explotación diversificada, en agricultura ecológica, cultivamos trigo para hacer harina y pan y criamos vacas y ovejas cuya carne vendemos directamente."
    ]
  },
