  "rdfs:comment": {
    "de": [
      "Wir sind eine Mikrofarm mit den Gütesiegeln AB und Nature et Progrès und bieten jede Woche Gemüse- und Eierkörbe an, die in der Gemeinde Saint Romain de Lerps zu Ihnen nach Hause geliefert werden. Wenn Sie weiter weg wohnen, können Sie Ihre Bestellung auch auf dem Hof abholen."
    ],
    "en": [
      "A micro-farm with the AB and Nature et Progrès labels, we offer weekly baskets of vegetables and eggs, delivered to your home in the commune of Saint Romain de Lerps. If you live further away, you can pick up your order at the farm."
    ],
    "it": [
      "Microfattoria con i marchi AB e Nature et Progrès, offriamo cesti settimanali di verdure e uova, consegnati a casa vostra a Saint Romain de Lerps. Se abitate più lontano, potete ritirare il vostro ordine presso la fattoria."
    ],
    "fr": [
      "Microferme labellisée AB et Nature et Progrès, nous proposons chaque semaine des paniers de légumes et d’œufs, livrés à domicile sur la commune de Saint Romain de Lerps. Si vous habitez plus loin, vous pouvez venir récupérer votre commande à la ferme."
    ],
    "es": [
      "Microgranja con las etiquetas AB y Nature et Progrès, ofrecemos cestas semanales de verduras y huevos, entregadas a domicilio en Saint Romain de Lerps. Si vives más lejos, puedes recoger tu pedido en la granja."
    ],
    "nl": [
      "Als micro-boerderij met de labels AB en Nature et Progrès bieden we wekelijkse manden met groenten en eieren aan, die aan huis worden geleverd in Saint Romain de Lerps. Als je verder weg woont, kun je je bestelling op de boerderij afhalen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Jardins de Peyni"
    ]
  },
