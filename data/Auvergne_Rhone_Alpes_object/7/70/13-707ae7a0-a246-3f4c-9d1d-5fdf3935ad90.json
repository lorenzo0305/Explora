  "rdfs:comment": {
    "de": [
      "Das Hotel Ibis St Rambert d'Albon liegt in den Obstgärten der Drôme, 60 km südlich von Lyon, in der Nähe einer Ausfahrt der A7, auf der RN7 Richtung Valence. Es befindet sich in der Nähe des Palais Idéal du Facteur Cheval, des Safariparks von Peaugres und des Golfplatzes von Albon."
    ],
    "en": [
      "Hotel Ibis in St Rambert d'Albon is situated in the Drôme's vineyards, 60 km south of Lyon and next to a Motorway Exit, on RN7 towards Valence. It is next to the\" Palais Idéal du Facteur Cheval\", \"Peaugres zoo\" and the golf course of Albon."
    ],
    "it": [
      "L'hotel Ibis St Rambert d'Albon si trova nei frutteti della Drôme, 60 km a sud di Lione, vicino a un'uscita della A7, sulla RN7 in direzione Valence. È vicino al Palais Idéal du Facteur Cheval, al Safari Parc de Peaugres e al campo da golf di Albon."
    ],
    "fr": [
      "L'hôtel Ibis St Rambert d'Albon se situe dans les vergers de la Drôme, à 60 km au sud de Lyon proche d'une sortie de l'A7, sur la RN7 direction Valence. Il est près du Palais Idéal du Facteur Cheval, du Safari Parc de Peaugres et du golf d'Albon."
    ],
    "nl": [
      "Het Ibis-hotel St Rambert d'Albon ligt in de boomgaarden van de Drôme, 60 km ten zuiden van Lyon bij een afslag van de A7, aan de RN7 richting Valence. Het ligt dicht bij het Palais Idéal du Facteur Cheval, het Safari Parc de Peaugres en de golfbaan van Albon."
    ],
    "es": [
      "El hotel Ibis St Rambert d'Albon está situado en los huertos de la Drôme, a 60 km al sur de Lyon, cerca de una salida de la A7, en la RN7 en dirección a Valence. Está cerca del Palais Idéal du Facteur Cheval, del Safari Parc de Peaugres y del campo de golf de Albon."
    ]
  },
