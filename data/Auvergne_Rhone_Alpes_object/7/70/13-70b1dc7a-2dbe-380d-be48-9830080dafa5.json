  "rdfs:comment": {
    "de": [
      "Es handelt sich um ein weitläufiges Gebäude im südgotischen Stil. Im Inneren zeigen die imposanten Ausmaße des Kirchenschiffs die Bedeutung von Marcolès im späten Mittelalter."
    ],
    "en": [
      "It is a vast building in the Southern Gothic style. Inside, the imposing dimensions of the nave testify to the importance of Marcolès in the late Middle Ages."
    ],
    "it": [
      "Si tratta di un vasto edificio in stile gotico meridionale. All'interno, le imponenti dimensioni della navata testimoniano l'importanza di Marcolès nel tardo Medioevo."
    ],
    "fr": [
      "C'est un vaste édifice de style gothique méridional. À l'intérieur, les dimensions imposantes de la nef montrent l'importance de Marcolès à la fin du Moyen Âge."
    ],
    "es": [
      "Se trata de un vasto edificio de estilo gótico meridional. En el interior, las imponentes dimensiones de la nave dan fe de la importancia de Marcolès en la Baja Edad Media."
    ],
    "nl": [
      "Het is een groot gebouw in de zuidelijke gotische stijl. Binnen getuigen de imposante afmetingen van het schip van het belang van Marcolès in de late Middeleeuwen."
    ]
  },
  "rdfs:label": {
    "en": [
      "Church of St. Martin in Marcolès"
    ],
    "fr": [
      "Église Saint-Martin"
    ],
    "nl": [
      "Sint-Martinuskerk in Marcolès"
    ]
  },
