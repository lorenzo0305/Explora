  "rdfs:comment": {
    "de": [
      "Der Batalon ist ein schöner, etwa 9 km langer Fluss, der in Maclas entspringt und dann durch die Gemeinden Lupé, Malleval fließt, bevor er in Saint Pierre de Boeuf in die Rhône mündet."
    ],
    "en": [
      "The Batalon is a lovely 9 km-long river that rises in Maclas and flows through the communes of Lupé and Malleval, before emptying into the Rhône at Saint Pierre de Boeuf."
    ],
    "it": [
      "Il Batalon è un grazioso torrente, lungo circa 9 km, che nasce a Maclas e scorre poi attraverso i comuni di Lupé e Malleval, prima di sfociare nel Rodano a Saint Pierre de Boeuf."
    ],
    "fr": [
      "Le Batalon est un joli cours d'eau d'environ 9 km qui prend sa source à Maclas et coule ensuite sur les communes de Lupé, Malleval, avant de se jeter dans le Rhône à Saint Pierre de Boeuf."
    ],
    "es": [
      "El Batalon es un bonito arroyo de unos 9 km de longitud que nace en Maclas y atraviesa los municipios de Lupé y Malleval, antes de desembocar en el Ródano en Saint Pierre de Boeuf."
    ],
    "nl": [
      "De Batalon is een mooi riviertje van ongeveer 9 km lang dat ontspringt in Maclas en vervolgens door de gemeenten Lupé en Malleval stroomt, voordat het bij Saint Pierre de Boeuf uitmondt in de Rhône."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Pêche dans la rivière Batalon"
    ]
  },
