  "rdfs:comment": {
    "de": [
      "Die Bacchus Big Band veranstaltet ein Konzert zugunsten der 16-jährigen Audry, einer jungen Gymnasiastin, die als Tänzerin ausgewählt wurde, um Frankreich bei der Tanzweltmeisterschaft in Los Angeles im Juli 2025 zu vertreten"
    ],
    "en": [
      "The Bacchus Big Band is organizing a concert to benefit Audry, the 16-year-old high school dancer selected to represent France at the World Dancing Championships in Los Angeles in July 2025"
    ],
    "it": [
      "La Bacchus Big Band organizza un concerto a favore di Audry, la ballerina liceale di 16 anni selezionata per rappresentare la Francia ai campionati mondiali di danza che si terranno a Los Angeles nel luglio 2025"
    ],
    "fr": [
      "Le Bacchus Big Band organise un concert au profit de Audry 16 ans, jeune lycéenne danseuse sélectionnée pour représenter la France au Championnat du Monde de danse à Los Angeles en juillet 2025"
    ],
    "es": [
      "La Bacchus Big Band organiza un concierto en beneficio de Audry, bailarina de instituto de 16 años seleccionada para representar a Francia en el Campeonato Mundial de Baile que se celebrará en Los Ángeles en julio de 2025"
    ],
    "nl": [
      "De Bacchus Big Band organiseert een concert om Audry te steunen, de 16-jarige danseres die geselecteerd is om Frankrijk te vertegenwoordigen op de wereldkampioenschappen dansen in Los Angeles in juli 2025"
    ]
  },
  "rdfs:label": {
