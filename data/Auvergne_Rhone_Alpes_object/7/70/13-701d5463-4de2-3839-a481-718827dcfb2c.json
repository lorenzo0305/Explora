  "rdfs:comment": {
    "de": [
      "Darstellung eines Migranten, dem man in Italien begegnet, auf fast transparente Weise, als ob die Passanten ihn nicht sehen wollten."
    ],
    "en": [
      "Representation of a migrant encountered in Italy, almost transparently, as if passers-by didn't want to see him."
    ],
    "it": [
      "Rappresentazione di un migrante incontrato in Italia, quasi in trasparenza, come se i passanti non volessero vederlo."
    ],
    "fr": [
      "Représentation d'un migrant rencontré en Italie, de façon presque transparente, comme si les passants ne voulaient pas le voir."
    ],
    "nl": [
      "Weergave van een migrant die je in Italië tegenkomt, bijna transparant, alsof voorbijgangers hem niet willen zien."
    ],
    "es": [
      "Representación de un migrante encontrado en Italia, casi con transparencia, como si los transeúntes no quisieran verlo."
    ]
  },
