  "rdfs:comment": {
    "de": [
      "Wir öffnen die Türen unseres Unternehmens, um Ihnen die verschiedenen Produktionsschritte von der Herstellung bis zur Färbung zu zeigen!\r\nMit Sitz in Saint-Pal-de-Mons bietet Ihnen unser Team aus 100 Fachleuten Kreativität und Qualität."
    ],
    "en": [
      "We're opening our doors to show you the different stages of production, from manufacturing to coloring!\r\nBased in Saint-Pal-de-Mons, our team of 100 professionals offers you creativity and quality."
    ],
    "it": [
      "Apriamo le porte della nostra azienda per mostrarvi le diverse fasi della produzione, dalla lavorazione alla colorazione!\r\nCon sede a Saint-Pal-de-Mons, il nostro team di 100 professionisti vi offre creatività e qualità."
    ],
    "fr": [
      "Nous ouvrons les portes de notre entreprise pour vous faire découvrir les différentes étapes de production, de la fabrication à la coloration !\r\nBasée à Saint-Pal-de-Mons, notre équipe de 100 professionnels vous offre créativité et qualité."
    ],
    "nl": [
      "We openen de deuren van ons bedrijf om je de verschillende productiefasen te laten zien, van productie tot kleuren!\r\nOns team van 100 professionals is gevestigd in Saint-Pal-de-Mons en biedt je creativiteit en kwaliteit."
    ],
    "es": [
      "Le abrimos las puertas de nuestra empresa para mostrarle las distintas etapas de la producción, desde la fabricación hasta la coloración\r\nCon sede en Saint-Pal-de-Mons, nuestro equipo de 100 profesionales le ofrece creatividad y calidad."
    ]
  },
