  "rdfs:comment": {
    "de": [
      "Als krönenden Abschluss ihres Praxisjahres laden alle Anhänger der künstlerischen Aktivitäten des MJC Sie zu ihrer traditionellen Gala ein."
    ],
    "en": [
      "To round off the year in style, all the MJC's artistic enthusiasts are looking forward to their traditional gala."
    ],
    "it": [
      "Per concludere l'anno in bellezza, tutti gli appassionati di arte del MJC attendono con ansia il loro tradizionale gala."
    ],
    "fr": [
      "Pour conclure en beauté leur année de pratique, tous les adeptes des activités artistiques de la MJC vous donnent rendez-vous pour leur traditionnel gala."
    ],
    "es": [
      "Para despedir el año por todo lo alto, todos los entusiastas artísticos del MJC esperan con impaciencia su tradicional gala."
    ],
    "nl": [
