  "rdfs:comment": {
    "de": [
      "Das Oh! Bugey Festival ist ein unumgängliches Ereignis in Oyonnax im Departement Ain, bei dem große Künstler Sie zur Freude aller in verschiedene musikalische Welten entführen werden!"
    ],
    "en": [
      "The Oh ! Bugey Festival is an unmissable event in Oyonnax in the Ain region, where great artists will take you on a journey through different musical universes to the delight of all!"
    ],
    "it": [
      "Il Festival Oh! Bugey è un evento imperdibile a Oyonnax, nella regione dell'Ain, dove grandi artisti vi condurranno in un viaggio attraverso diversi universi musicali per la gioia di tutti!"
    ],
    "fr": [
      "Le Oh ! Bugey Festival est un événement incontournable, à Oyonnax dans l'Ain, où de grands artistes vous embarqueront dans différents univers musicaux pour le plus grand plaisir de tous !"
    ],
    "nl": [
      "Het Oh! Bugey Festival is een niet te missen evenement in Oyonnax in de regio Ain, waar grote artiesten u meenemen op een reis door verschillende muzikale universums tot groot genoegen van iedereen!"
    ],
    "es": [
      "El Festival Oh! Bugey es una cita ineludible en Oyonnax, en la región de Ain, donde grandes artistas le harán viajar por diferentes universos musicales para deleite de todos"
    ]
  },
