  "rdfs:comment": {
    "de": [
      "Restaurant, das mittags und abends geöffnet ist und eine saisonale Küche mit frischen Produkten anbietet. Nutzen Sie auch unsere schöne Terrasse, sobald die ersten warmen Tage kommen!"
    ],
    "en": [
      "Restaurant for lunch and dinner, cooking of fresh products of seasons with a pleasant terrace for the beautiful days."
    ],
    "it": [
      "Ristorante aperto a pranzo e a cena, che propone una cucina stagionale a base di prodotti freschi. Potrete anche approfittare della nostra bella terrazza non appena il tempo diventa bello!"
    ],
    "fr": [
      "Restaurant ouvert midi et soir, offrant une cuisine de saison à base de produits frais. Profitez également de notre belle terrasse dès les premiers beaux jours !"
    ],
    "es": [
      "Restaurante abierto para el almuerzo y la cena, que ofrece cocina de temporada basada en productos frescos. También podrá disfrutar de nuestra agradable terraza en cuanto haga buen tiempo"
    ],
    "nl": [
      "Restaurant geopend voor lunch en diner, met seizoensgebonden gerechten op basis van verse producten. Zodra het mooi weer wordt, kunt u ook genieten van ons heerlijke terras!"
    ]
  },
