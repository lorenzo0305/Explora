  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Taverne Savoyarde, den idealen Ort, um die lokale Küche dank ihres Konzepts eines Savoyer All-you-can-eat-Buffets zu erkunden! Mehr als 85 hausgemachte Spezialitäten können Sie in einer gemütlichen Atmosphäre und einem immersiven Bergdekor genießen."
    ],
    "en": [
      "Discover la Taverne Savoyarde, the perfect place to explore local cuisine with its Savoyard all you can eat buffet concept! No less than 85 homemade specialities to enjoy in a warm atmosphere and immersive mountain decor."
    ],
    "it": [
      "Scoprite la Taverne Savoyarde, il luogo ideale per esplorare la cucina locale grazie al suo concetto di buffet savoiardo all-you-can-eat! Più di 85 specialità fatte in casa da assaggiare in un'atmosfera calda e in un ambiente montano coinvolgente."
    ],
    "fr": [
      "Découvrez la Taverne Savoyarde, le lieu idéal pour explorer la cuisine locale grâce à son concept de buffet savoyard à volonté ! Plus de 85 spécialités maison à déguster dans une ambiance chaleureuse et un décor montagnard immersif."
    ],
    "nl": [
      "Ontdek de Taverne Savoyarde, de ideale plek om de lokale keuken te ontdekken dankzij het all-you-can-eat Savoyaardse buffetconcept! Meer dan 85 huisgemaakte specialiteiten om te proeven in een warme sfeer en meeslepende bergomgeving."
    ],
    "es": [
      "Descubra la Taverne Savoyarde, el lugar ideal para descubrir la gastronomía local gracias a su concepto de bufé saboyano \"todo lo que pueda comer\" Más de 85 especialidades caseras para degustar en un ambiente cálido y un entorno de montaña envolvente."
    ]
  },
