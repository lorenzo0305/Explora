  "rdfs:comment": {
    "de": [
      "Der Evettes Sessellift öffnet diesen Sommer und bietet Zugang zu markierten Wanderwegen zu Fuß oder mit dem Mountainbike. Nutzen Sie die Gelegenheit und fahren Sie zum Evettes-See!"
    ],
    "en": [
      "The Evettes Chairlift opens this summer and gives you access to marked trails on foot. Take the opportunity to take a ride to Lake Evettes!\r\nAllow 20 minutes for the Flumet chairlift."
    ],
    "it": [
      "La seggiovia Evettes consente a voi e alla vostra famiglia o ai vostri amici di accedere ai sentieri segnalati a piedi.\r\nPer la seggiovia di Flumet sono necessari 20 minuti."
    ],
    "fr": [
      "Le Télésiège des Evettes vous permet d'accéder en famille ou entre amis à pied aux sentiers balisés.\r\nPrévoir 20 mn pour le télésiège de Flumet."
    ],
    "es": [
      "El telesilla Evettes le permite a usted y a su familia o amigos acceder a pie a los senderos señalizados.\r\nEl telesilla Flumet tarda 20 minutos en llegar."
    ],
    "nl": [
      "De stoeltjeslift Evettes geeft jou en je familie of vrienden te voet toegang tot de gemarkeerde paden.\r\nReken op 20 minuten voor de Flumet stoeltjeslift."
    ]
  },
  "rdfs:label": {
    "de": [
      "Sessellift Les Evettes"
    ],
    "en": [
      "Les Evettes chairlift"
    ],
    "fr": [
      "Télésiège des Evettes"
    ]
  },
