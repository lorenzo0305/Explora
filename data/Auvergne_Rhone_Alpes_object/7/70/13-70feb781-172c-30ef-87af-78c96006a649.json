  "rdfs:comment": {
    "de": [
      "Das Hotel Mercure Lyon Est Villefontaine liegt an der A43, 15 Minuten vom Flughafen Saint-Exupéry und seinem TGV-Bahnhof entfernt und verfügt über 189 Zimmer. Das Hotel ist ideal für Geschäfts- und Urlaubsreisende und bietet 7 flexible Tagungsräume."
    ],
    "en": [
      "The Mercure Lyon Est Villefontaine hotel, located on the A43 motorway, 15 minutes from Saint-Exupéry airport and its TGV station, has 189 rooms. Perfect for both business and leisure travelers, the hotel offers 7 modular meeting rooms."
    ],
    "it": [
      "L'hotel Mercure Lyon Est Villefontaine, situato sull'autostrada A43, a 15 minuti dall'aeroporto Saint-Exupéry e dalla sua stazione ferroviaria TGV, dispone di 189 camere. Perfetto sia per i viaggiatori d'affari che per i turisti, l'hotel offre 7 sale riunioni flessibili."
    ],
    "fr": [
      "L'hôtel Mercure Lyon Est Villefontaine , situé sur l'axe de l' A43, à 15 minutes de l'aéroport Saint-Exupéry et de sa gare TGV dispose de 189 chambres. Parfait pour les voyageurs d'affaires et de loisirs, l'hôtel propose 7 salles de réunion modulables."
    ],
    "nl": [
      "Het Mercure-hotel Lyon Est Villefontaine ligt aan de snelweg A43, op 15 minuten van de luchthaven Saint-Exupéry en het TGV-station en heeft 189 kamers. Het hotel is ideaal voor zowel zakenreizigers als vakantiegangers en beschikt over 7 flexibele vergaderruimten."
    ],
    "es": [
      "El hotel Mercure Lyon Est Villefontaine, situado en la autopista A43, a 15 minutos del aeropuerto Saint-Exupéry y de su estación de tren TGV, dispone de 189 habitaciones. Perfecto tanto para viajeros de negocios como de placer, el hotel ofrece 7 salas de reuniones flexibles."
    ]
  },
