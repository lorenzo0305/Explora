  "rdfs:comment": {
    "de": [
      "Die SARL ESPACE VOLAILLES ist ein Familienunternehmen, das Geflügel schlachtet und verkauft und seinen Sitz in Chabeuil hat. Wir beherrschen die gesamte Wertschöpfungskette, von der nicht intensiven und respektvollen Aufzucht des Kükens bis hin zur Schlachtung und dem Verkauf als küchenfertiges Geflügel."
    ],
    "en": [
      "SARL ESPACE VOLAILLES is a family-run poultry slaughtering and sales company based in Chabeuil. We master the entire process, from non-intensive, respectful chick rearing to slaughter and ready-to-cook sales."
    ],
    "it": [
      "SARL ESPACE VOLAILLES è un'azienda di macellazione e vendita di pollame a conduzione familiare con sede a Chabeuil. Siamo in grado di gestire l'intero processo, dall'allevamento non intensivo e rispettoso dei pulcini alla macellazione e alla vendita di prodotti pronti da cuocere."
    ],
    "fr": [
      "La SARL ESPACE VOLAILLES est une entreprise familiale d’abattage et de vente de volailles, située à Chabeuil. Nous maîtrisons l’ensemble de la filière, de l’élevage non intensif et respectueuse du poussin jusqu’à l’abattage et la vente en prêt à cuire."
    ],
    "nl": [
      "SARL ESPACE VOLAILLES is een familiebedrijf dat pluimvee slacht en verkoopt in Chabeuil. Wij beheersen het hele proces, van de niet-intensieve, respectvolle opfok van kuikens tot het slachten en de verkoop van kant-en-klare producten."
    ],
    "es": [
      "SARL ESPACE VOLAILLES es una empresa familiar de sacrificio y venta de aves de corral situada en Chabeuil. Dominamos todo el proceso, desde la cría no intensiva y respetuosa de los pollitos hasta el sacrificio y la venta lista para cocinar."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Espace Volailles"
    ]
  },
