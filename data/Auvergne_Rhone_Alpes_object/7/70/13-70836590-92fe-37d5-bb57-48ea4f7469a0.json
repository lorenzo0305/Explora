  "rdfs:comment": {
    "de": [
      "Verleih von Schneeschuhen, Langlaufskiern und Schlitten. Erhältlich auf Reservierung unter 06 03 35 82 54\r\nAbholung der Ausrüstung: Au petit Baz'AR in St Front.\r\nSaint Front escapade organisiert zwei Wanderungen: die Draille blanche im Januar und die Rando Gourmande im September."
    ],
    "en": [
      "Snowshoe, cross-country ski and toboggan rentals. Available on reservation: 06 03 35 82 54\r\nEquipment collection: at Le petit Baz'AR in St Front.\r\nSaint Front escapade organizes 2 hikes: the Draille blanche in January and the Rando Gourmande in September."
    ],
    "it": [
      "Noleggio di racchette da neve, sci di fondo e slittini. Disponibile su prenotazione al numero 06 03 35 82 54\r\nRitiro dell'attrezzatura: presso Le petit Baz'AR a St Front.\r\nSaint Front escapade organizza 2 escursioni: la Draille blanche a gennaio e la Rando Gourmande a settembre."
    ],
    "fr": [
      "Locations de raquettes, ski de fond et luge. Disponible sur réservation au 06 03 35 82 54 \r\nRetrait du matériel : Au petit Baz'AR à St Front.\r\nSaint Front escapade organise 2 randonnées: la Draille blanche en janvier et la Rando Gourmande en septembre."
    ],
    "nl": [
      "Verhuur van sneeuwschoenen, langlaufski's en sleeën. Beschikbaar op reservering op 06 03 35 82 54\r\nMateriaal ophalen: bij Le petit Baz'AR in St Front.\r\nEscapade Saint Front organiseert 2 wandeltochten: de Draille blanche in januari en de Rando Gourmande in september."
    ],
    "es": [
      "Alquiler de raquetas de nieve, esquí de fondo y trineo. Disponible previa reserva en el 06 03 35 82 54\r\nRecogida de material: en Le petit Baz'AR de St Front.\r\nLa escapada de Saint Front organiza 2 excursiones: la Draille blanche en enero y el Rando Gourmande en septiembre."
    ]
  },
