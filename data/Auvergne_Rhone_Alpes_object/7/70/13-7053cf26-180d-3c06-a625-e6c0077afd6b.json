  "rdfs:comment": {
    "de": [
      "Das Reiseziel Sumène Artense, ein geheimnisvolles und wildes Land in der Auvergne. Ein Land der Seen, des Wildwassers, der Geschichte, der Wissenschaft und des Abenteuers. Eine andere Welt direkt vor Ihrer Haustür!"
    ],
    "en": [
      "Sumène Artense, a mysterious and wild Auvergne region. A land of lakes, white water, history, science and adventure. Another world just around the corner!"
    ],
    "it": [
      "Sumène Artense, una terra misteriosa e selvaggia nell'Alvernia. Una terra di laghi, acque bianche, storia, scienza e avventura. Un altro mondo a portata di mano!"
    ],
    "fr": [
      "La destination Sumène Artense, une terre auvergnate mystérieuse et sauvage. Une terre de lacs, d'eaux-vives, d'Histoire, de science et d'aventure. Un autre monde à deux pas de chez vous !"
    ],
    "es": [
      "Sumène Artense, una tierra misteriosa y salvaje en Auvernia. Tierra de lagos, aguas bravas, historia, ciencia y aventura. Otro mundo a tiro de piedra"
    ],
    "nl": [
      "Sumène Artense, een mysterieus en wild land in de Auvergne. Een land van meren, wild water, geschiedenis, wetenschap en avontuur. Een andere wereld op een steenworp afstand!"
    ]
  },
