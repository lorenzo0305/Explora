  "rdfs:comment": {
    "de": [
      "Das 4-Sterne Radisson Hotel Clermont-Ferrand liegt im Stadtzentrum gegenüber dem Busbahnhof Salins Coubertin und bietet einfachen Zugang zu den besten Restaurants der Stadt, beliebten Attraktionen und den wichtigsten Geschäftsstandorten"
    ],
    "en": [
      "4-star hotel with 81 rooms located in the heart of downtown."
    ],
    "it": [
      "Situato nel centro della città, di fronte alla stazione degli autobus di Salins Coubertin, il Radisson Hotel Clermont-Ferrand, albergo a 4 stelle, offre un facile accesso ai migliori ristoranti della città, alle attrazioni più popolari e ai principali siti commerciali"
    ],
    "fr": [
      "Situé dans le centre-ville, en face de la gare routière Salins Coubertin, l’hôtel 4 étoiles Radisson Hotel Clermont-Ferrand offre un accès facile aux meilleurs restaurants de la ville, aux attractions populaires et aux principaux sites d’affaires"
    ],
    "es": [
      "Situado en el centro de la ciudad, frente a la estación de autobuses Salins Coubertin, el Radisson Hotel Clermont-Ferrand de 4 estrellas ofrece fácil acceso a los mejores restaurantes de la ciudad, a las atracciones más populares y a los principales lugares de negocios"
    ],
    "nl": [
      "Het 4-sterren Radisson Hotel Clermont-Ferrand ligt in het stadscentrum, tegenover het busstation Salins Coubertin, en biedt gemakkelijk toegang tot de beste restaurants, populaire attracties en belangrijke zakenlocaties van de stad"
    ]
  },
  "rdfs:label": {
