  "rdfs:comment": {
    "de": [
      "Der Parc des Dérêches bietet der gesamten Morziner Gemeinschaft, Einheimischen und Touristen, eine eigene Website, auf der alle dort angebotenen Sportaktivitäten aufgelistet und detailliert beschrieben werden."
    ],
    "en": [
      "The Park des Dérêches has its own internet site, listing all the details of the sports you can participate in, in this preserved area of Morzine. Parc des Dérêches is a piece of nature that has grown with the village and emerges along the river."
    ],
    "it": [
      "Il Parc des Dérêches ha un proprio sito web per tutta la comunità di Morzine, sia per i residenti che per i turisti, dove sono elencate e dettagliate tutte le attività sportive offerte."
    ],
    "fr": [
      "Le Parc des Dérêches propose son propre site internet à toute la communauté Morzinoise, habitants de la commune et touristes, où est répertorié et détaillé l'ensemble des activités sportives qui vous y sont proposées."
    ],
    "nl": [
      "Het Parc des Dérêches heeft een eigen website voor de hele gemeenschap van Morzine, zowel inwoners als toeristen, met een overzicht van alle sportactiviteiten die worden aangeboden."
    ],
    "es": [
      "El Parc des Dérêches tiene su propia página web para toda la comunidad de Morzine, tanto residentes como turistas, donde se enumeran y detallan todas las actividades deportivas que se ofrecen."
    ]
  },
  "rdfs:label": {
