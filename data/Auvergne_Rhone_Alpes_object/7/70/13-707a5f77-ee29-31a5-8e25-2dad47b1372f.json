  "rdfs:comment": {
    "de": [
      "Die größte Seilrutsche mit Masten der Welt: garantierte Sensationen!\r\nSie verläuft parallel zur Seilbahn von La Croix und überfliegt das Sommerberggebiet / Winterskigebiet.\r\nReservieren Sie schnell Ihren Slot online und begeben Sie sich nach Chamrousse 1650 - Recoin!"
    ],
    "en": [
      "The world's largest pylon zip line: thrills guaranteed!\r\nParallel to the La Croix gondola, it flies over the summer mountain / winter ski area.\r\nBook your time online now and come to Chamrousse 1650 - Recoin!"
    ],
    "it": [
      "La più grande teleferica del mondo: emozioni garantite!\r\nParallela alla telecabina La Croix, sorvola il comprensorio montano estivo/sciistico invernale.\r\nPrenotate subito il vostro tempo online e venite a Chamrousse 1650 - Recoin!"
    ],
    "fr": [
      "La plus grande tyrolienne à pylônes du monde : sensations garanties !\r\nParallèle à la télécabine de la Croix, elle survole le domaine de montagne été / domaine skiable hiver.\r\nRéservez vite votre créneau en ligne et rendez-vous à Chamrousse 1650 - Recoin !"
    ],
    "es": [
      "La tirolina más grande del mundo: ¡emoción garantizada!\r\nParalela a la telecabina de La Croix, sobrevuela la zona de montaña de verano / esquí de invierno.\r\n¡Reserve ya su tiempo en línea y venga a Chamrousse 1650 - Recoin!"
    ],
    "nl": [
      "De grootste tokkelbaan ter wereld: sensatie gegarandeerd!\r\nParallel aan de gondelbaan La Croix vliegt hij over het zomerberg/winterskigebied.\r\nBoek nu je tijd online en kom naar Chamrousse 1650 - Recoin!"
    ]
  },
  "rdfs:label": {
    "de": [
      "Adrenaline Park - Riesige Seilrutsche in Chamrousse"
    ],
    "en": [
      "Adrenaline Park - Chamrousse giant zip line"
    ],
    "fr": [
      "Adrenaline Park - Tyrolienne géante de Chamrousse"
    ]
  },
