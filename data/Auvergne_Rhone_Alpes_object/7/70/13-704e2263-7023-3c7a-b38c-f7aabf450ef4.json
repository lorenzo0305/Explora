  "rdfs:comment": {
    "de": [
      "Besuchen Sie die 1836 auf dem Dorfplatz errichtete Schmiede mit ihren Abfällen. Bis 1976 wechselten sich hier die Hufschmiede ab, die den Alltag mit dem Klang von Hammer und Amboss bestimmten. Der Ort ist als historisches Monument eingetragen."
    ],
    "en": [
      "Visit the blacksmith's shop and its detached buildings, built in 1836 on the village square. It was home to a succession of blacksmiths until 1976, giving rhythm to daily life with the sound of hammer and anvil. The site is listed as a Historic Monument."
    ],
    "it": [
      "Visitate la fucina del fabbro, costruita nel 1836 sulla piazza del villaggio. Fino al 1976 ha ospitato una serie di fabbri che hanno ritmato la vita quotidiana con il suono del martello e dell'incudine. Il sito è classificato come monumento storico."
    ],
    "fr": [
      "Visitez la forge, et ses détrés, construite en 1836 sur la place du village. Elle a vu se succéder des maréchaux ferrant jusqu’en 1976, rythmant le quotidien au son du marteau et de l’enclume. Ce site est inscrit au titre des Monuments Historiques."
    ],
    "es": [
      "Visite la herrería, construida en 1836 en la plaza del pueblo. Fue el hogar de una sucesión de herreros hasta 1976, dando ritmo a la vida cotidiana con el sonido del martillo y el yunque. El lugar está catalogado como Monumento Histórico."
    ],
    "nl": [
      "Bezoek de smederij, gebouwd in 1836 op het dorpsplein. Het was de thuisbasis van een opeenvolging van smeden tot 1976, die het dagelijkse leven ritme gaven met het geluid van hamer en aambeeld. De plek staat op de monumentenlijst."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La forge et le détré de Lalley"
    ]
  },
