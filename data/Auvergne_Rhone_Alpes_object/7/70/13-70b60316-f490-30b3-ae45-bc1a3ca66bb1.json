  "rdfs:comment": {
    "de": [
      "Diese Mikrobrauerei befindet sich seit 2018 in Domessin, im Herzen des savoyischen Vorlandes, wo die Departements Savoie, Isère und Ain aufeinandertreffen. .Biologische Biere aus dem savoyischen Vorland."
    ],
    "en": [
      "This microbrewery was founded in 2018 and taken over in January 2023 by a passionate brewer committed to an ecological and local approach."
    ],
    "it": [
      "Dal 2018, questo microbirrificio si trova a Domessin, nel cuore dell'avampaese savoiardo, dove si incontrano Savoia, Isère e Ain. Birre biologiche dell'avampaese savoiardo."
    ],
    "fr": [
      "Cette microbrasserie se situe depuis 2018 à Domessin, au cœur de l’avant pays savoyard, à la jonction de la Savoie, l’Isère et l’Ain. .Bières biologiques de l'Avant-pays savoyard."
    ],
    "nl": [
      "Sinds 2018 is deze microbrouwerij gevestigd in Domessin, in het hart van het voorland van de Savoie, waar Savoie, Isère en Ain samenkomen. Biologische bieren uit het voorland van de Savoie."
    ],
    "es": [
      "Desde 2018, esta microcervecería se encuentra en Domessin, en el corazón de la Precordillera Saboyana, donde confluyen Saboya, Isère y Ain. Cervezas ecológicas de la Precordillera Saboyana."
    ]
  },
  "rdfs:label": {
    "en": [
      "Microbrewery L'Ecume du Guiers"
    ],
    "fr": [
      "Micro-brasserie l'Ecume du Guiers"
    ]
