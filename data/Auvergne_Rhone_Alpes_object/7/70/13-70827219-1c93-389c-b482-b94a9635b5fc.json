  "rdfs:comment": {
    "de": [
      "Im La Grappe d'Or in Saint-Péray heißen Sie Amandine und die Küchenchefin Cécile in einer freundlichen Atmosphäre willkommen. Die Küche ist zu 100 % hausgemacht, es gibt saisonale Produkte und leckere Tagesgerichte. Ein aufrichtiger und großzügiger Tisch, den es zu entdecken gilt."
    ],
    "en": [
      "La Grappe d?Or in Saint-Péray is where Amandine and chef Cécile welcome you in a friendly atmosphere. 100% home cooking, seasonal produce and gourmet daily specials. A sincere and generous table to discover."
    ],
    "it": [
      "La Grappe d'Or a Saint-Péray è gestita da Amandine e dalla chef Cécile, che vi accolgono in un'atmosfera amichevole. Cucina 100% casalinga, prodotti di stagione e piatti gourmet del giorno. Un ristorante sincero e generoso da scoprire."
    ],
    "fr": [
      "La Grappe d’Or à Saint-Péray, c’est Amandine et la cheffe Cécile qui vous accueillent dans une ambiance conviviale. Cuisine 100 % maison, produits de saison et plat du jour gourmand. Une table sincère et généreuse à découvrir."
    ],
    "es": [
      "La Grappe d'Or, en Saint-Péray, está regentada por Amandine y la chef Cécile, que le recibirán en un ambiente acogedor. Cocina 100% casera, productos de temporada y platos gastronómicos del día. Un restaurante sincero y generoso por descubrir."
    ],
    "nl": [
      "La Grappe d'Or in Saint-Péray wordt gerund door Amandine en chef-kok Cécile, die je verwelkomen in een vriendelijke sfeer. 100% thuiskeuken, seizoensproducten en gastronomische dagschotels. Een oprecht en gul restaurant om te ontdekken."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Grappe d’Or"
    ]
  },
