  "rdfs:comment": {
    "de": [
      "Das Reitzentrum befindet sich auf einem 30 Hektar großen Gelände mit Bäumen und im Herzen der Balcons du Dauphiné. Die Kurse werden in kleinen Gruppen (nicht mehr als 8 Reiter) abgehalten, um einen qualitativ hochwertigen Unterricht zu gewährleisten."
    ],
    "en": [
      "The equestrian center is located on a 30-hectare wooded estate in the heart of the Balcons du Dauphiné. Lessons are given in small groups (no more than 8 riders) to ensure quality teaching."
    ],
    "it": [
      "Il centro di equitazione si trova in 30 ettari di terreno boscoso nel cuore dei Balcons du Dauphiné. Le lezioni sono tenute in piccoli gruppi (non più di 8 cavalieri) per garantire un elevato standard di insegnamento."
    ],
    "fr": [
      "Le centre équestre se déploie sur un domaine de 30 hectares arboré et au cœur des Balcons du Dauphiné. Les cours sont dispensés en petits groupes (pas plus de 8 cavaliers) afin de privilégier un enseignement de qualité."
    ],
    "es": [
      "El centro ecuestre está situado en un terreno arbolado de 30 hectáreas en el corazón de los Balcons du Dauphiné. Las clases se imparten en grupos reducidos (no más de 8 jinetes) para garantizar un alto nivel de enseñanza."
    ],
    "nl": [
      "De manege ligt op een bebost terrein van 30 hectare in het hart van de Balcons du Dauphiné. De lessen worden gegeven in kleine groepen (niet meer dan 8 ruiters) om een hoge kwaliteit van lesgeven te garanderen."
    ]
  },
