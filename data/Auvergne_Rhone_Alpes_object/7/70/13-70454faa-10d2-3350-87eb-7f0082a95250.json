  "rdfs:comment": {
    "de": [
      "Der City Park im Skiort Flaine ist ein vielseitiger und geselliger Ort, der eine Vielzahl von Freizeit- und Wellnessaktivitäten bieten soll. Der Park befindet sich im Herzen des Skiortes und profitiert von einer wunderschönen natürlichen Umgebung."
    ],
    "en": [
      "The City Park in the resort of Flaine is a multi-purpose, user-friendly area designed to offer a variety of leisure and well-being activities. Located in the heart of the resort, the park enjoys a magnificent natural setting."
    ],
    "it": [
      "Il parco cittadino della località di Flaine è un'area versatile e di facile utilizzo, progettata per offrire una varietà di attività per il tempo libero e il benessere. Situato nel cuore della località, il parco gode di una magnifica cornice naturale."
    ],
    "fr": [
      "Le City Park de la station de Flaine est un espace polyvalent et convivial conçu pour offrir une variété d'activités de loisirs et de bien-être. Situé au cœur de la station, le parc bénéficie d'un cadre naturel magnifique."
    ],
    "nl": [
      "Het stadspark in het skioord Flaine is een multifunctioneel, gebruiksvriendelijk gebied dat is ontworpen om een verscheidenheid aan vrijetijds- en welzijnsactiviteiten te bieden. Het park ligt in het hart van de badplaats en geniet van een prachtige natuurlijke omgeving."
    ],
    "es": [
      "El Parque de la Ciudad de la estación de Flaine es un espacio polivalente y de fácil uso diseñado para ofrecer diversas actividades de ocio y bienestar. Situado en el corazón de la estación, el parque goza de un magnífico entorno natural."
    ]
  },
