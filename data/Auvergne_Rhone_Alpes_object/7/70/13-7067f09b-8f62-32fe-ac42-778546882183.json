  "rdfs:comment": {
    "de": [
      "Das Hotel Monastère et Terminus freut sich, Sie von Mai bis Allerheiligen in La Chaise Dieu zwischen den Städten Le Puy en Velay und Ambert begrüßen zu dürfen. Hier können Sie die Abtei besichtigen und die zahlreichen Wanderwege nutzen."
    ],
    "en": [
      "The hotel Monastère et Terminus is happy to welcome you from May to All Saints Day in La Chaise Dieu located between the town of Le Puy en Velay and Ambert. You will be able to visit the abbey and take advantage of the many hiking trails."
    ],
    "it": [
      "L'hotel Monastère et Terminus è lieto di accogliervi da maggio a Ognissanti a La Chaise Dieu, tra la città di Le Puy en Velay e Ambert. Potrete visitare l'abbazia e approfittare dei numerosi sentieri escursionistici."
    ],
    "fr": [
      "L'hôtel Monastère et Terminus est heureux de vous accueillir de Mai à Toussaint à La Chaise Dieu situé entre la ville du Puy en Velay et d'Ambert. Vous pourrez ainsi visiter l'abbaye et profiter des nombreux circuits de randonnée."
    ],
    "nl": [
      "Het hotel Monastère et Terminus verwelkomt u graag van mei tot Allerheiligen in La Chaise Dieu gelegen tussen de stad Le Puy en Velay en Ambert. U kunt de abdij bezoeken en gebruik maken van de vele wandelpaden."
    ],
    "es": [
      "El hotel Monastère et Terminus se complace en acogerle de mayo a Todos los Santos en La Chaise Dieu, situada entre la ciudad de Le Puy en Velay y Ambert. Podrá visitar la abadía y aprovechar las numerosas rutas de senderismo."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Hôtel restaurant \"Monastère et Terminus\""
    ]
  },
