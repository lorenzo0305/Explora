  "rdfs:comment": {
    "de": [
      "Von Mozart bis Webern, die Wiener Dissonanzen sind köstlich unter den Bögen des Belcea Quartetts. Das Ensemble ist auf das Repertoire des 20. Jahrhunderts spezialisiert und präsentiert ein brandneues Quartett von Brett Dean."
    ],
    "en": [
      "From Mozart to Webern, Viennese dissonances are delicious under the bows of the Quatuor Belcea. Specializing in twentieth-century repertoire, the ensemble presents a brand-new quartet by Brett Dean."
    ],
    "it": [
      "Da Mozart a Webern, le dissonanze viennesi sono deliziose sotto gli archi del Quartetto Belcea. Specializzato nel repertorio del Novecento, l'ensemble presenta un quartetto inedito di Brett Dean."
    ],
    "fr": [
      "De Mozart ou de Webern, les dissonances viennoises sont délicieuses sous les archets du Quatuor Belcea. Spécialiste du répertoire du XXe siècle, l’ensemble présente un tout nouveau quatuor de Brett Dean."
    ],
    "nl": [
      "Van Mozart tot Webern, Weense dissonanten zijn heerlijk onder de bogen van het Belcea Quartet. Het ensemble is gespecialiseerd in twintigste-eeuws repertoire en presenteert een gloednieuw kwartet van Brett Dean."
    ],
    "es": [
      "De Mozart a Webern, las disonancias vienesas son deliciosas bajo los arcos del Cuarteto Belcea. Especializado en el repertorio del siglo XX, el conjunto presenta un nuevo cuarteto de Brett Dean."
    ]
  },
  "rdfs:label": {
