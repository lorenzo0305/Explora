  "rdfs:comment": {
    "de": [
      "Von Mai bis Oktober bietet dieses Open-Air-Restaurant eine hausgemachte und schmackhafte Küche, die sich ausschließlich auf savoyische und/oder biologische Produkte konzentriert. Zu genießen in einem magischen Rahmen: die Terrasse des Jardin des Cimes mit Blick auf den Mont Blanc."
    ],
    "en": [
      "From May to October, this outdoor restaurant offers a homemade and tasty cuisine, focusing exclusively on the Savoyard and/or organic sectors. To be enjoyed in a magical setting: the terrace of the Jardin des Cimes facing the Mont-Blanc."
    ],
    "it": [
      "Il ristorante Jardin des Cimes offre una cucina vegetariana gustosa e casalinga, con particolare attenzione ai prodotti savoiardi e/o biologici. Da gustare all'aperto in un ambiente magico: la terrazza panoramica con vista sul Monte Bianco."
    ],
    "fr": [
      "Le restaurant du Jardin des Cimes propose une cuisine végétale faite-maison et savoureuse, en misant sur les filières savoyardes et/ou bio. A déguster en plein air dans un cadre magique : La terrasse panorama face au Mont-Blanc."
    ],
    "nl": [
      "Het restaurant Jardin des Cimes biedt smakelijke, huisgemaakte vegetarische gerechten, met de nadruk op Savoyaardse en/of biologische producten. Geniet ervan in de buitenlucht in een magische omgeving: het panoramische terras met uitzicht op de Mont Blanc."
    ],
    "es": [
      "El restaurante Jardin des Cimes ofrece una cocina vegetariana sabrosa y casera, centrada en los productos saboyanos y/o ecológicos. Disfrútela al aire libre en un entorno mágico: la terraza panorámica frente al Mont Blanc."
    ]
  },
