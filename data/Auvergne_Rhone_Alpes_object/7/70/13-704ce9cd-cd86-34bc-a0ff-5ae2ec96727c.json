  "rdfs:comment": {
    "de": [
      "Kollektiv von 6 Künstlern / Handwerkern :\r\n- Copo: Emaille auf Metallen\r\n- Anne Robert und Claudie Do: Entwerfen von Kleidung\r\n- Michel Lefèvre: Möbel und Skulpturen aus Metall.\r\n- Sophie Ginoux: Gemälde, Gravuren, Glasmalerei.\r\n-Vinciane Dofny: Schmuck aus gesponnenem Glas"
    ],
    "en": [
      "The artists and craftsmen sale their own creations (workshop price) : enamels on metals (paintings, jewellery), clothing, paintings and illustrations, wrought iron (furniture and sculptures)."
    ],
    "it": [
      "Collettiva di 5 artisti/artigiani:\r\n- Colette Bethular (Copo): smalto su metallo\r\n- Anne Robert e Claudie Do: design di abbigliamento\r\n- Michel Lefèvre: mobili e sculture in metallo\r\n- Sophie Ginoux: dipinti, incisioni, vetrate."
    ],
    "fr": [
      "Collectif de 5 artistes / artisans : \r\n- Colette Bethular (Copo) : émaux sur métaux\r\n- Anne Robert et Claudie Do : création de vêtements\r\n- Michel Lefèvre : mobilier et sculptures de métal\r\n- Sophie Ginoux : peintures, gravures, vitraux."
    ],
    "nl": [
      "Collectief van 6 kunstenaars/ambachtslieden :\r\n- Copo: email op metaal\r\n- Anne Robert en Claudie Do: kledingontwerp\r\n- Michel Lefèvre: metalen meubels en sculpturen\r\n- Sophie Ginoux: schilderijen, gravures, glasramen.\r\n-Vinciane Dofny: sieraden van gesponnen glas"
    ],
    "es": [
      "Colectivo de 5 artistas / artesanos :\r\n- Colette Bethular (Copo): esmalte sobre metal\r\n- Anne Robert y Claudie Do: diseño de ropa\r\n- Michel Lefèvre: muebles y esculturas de metal\r\n- Sophie Ginoux: pinturas, grabados, vidrieras."
    ]
  },
