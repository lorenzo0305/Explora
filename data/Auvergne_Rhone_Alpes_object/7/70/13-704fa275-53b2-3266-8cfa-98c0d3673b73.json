  "rdfs:comment": {
    "de": [
      "Entdecken Sie Hières-sur-Amby, das im Nordwesten der Balcons du Dauphiné liegt und von der Rhône gesäumt wird. Diese Gemeinde im Norden der Isère verfügt über zahlreiche Schätze des Kulturerbes wie die archäologische Stätte von Larina, deren Besuch durch das archäologische Museum abgerundet wird."
    ],
    "en": [
      "Discover Hières-sur-Amby, in the north-western part of the Balcons du Dauphiné, on the banks of the Rhône. This commune in northern Isère boasts many heritage treasures, including the Larina archaeological site, which can be visited in its archaeological museum."
    ],
    "it": [
      "Scoprite Hières-sur-Amby, nel nord-ovest dei Balcons du Dauphiné, sulle rive del Rodano. Questo comune dell'Isère settentrionale è ricco di tesori del patrimonio, tra cui il sito archeologico di Larina, visitabile nel suo museo archeologico."
    ],
    "fr": [
      "Découvrez Hières-sur-Amby, au nord-ouest des Balcons du Dauphiné longée par le Rhône. Cette commune du nord Isère compte de nombreux trésors patrimoniaux tels que le site archéologique de Larina dont la visite se complète par le musée archéologique."
    ],
    "nl": [
      "Ontdek Hières-sur-Amby, in het noordwesten van de Balcons du Dauphiné, aan de oevers van de Rhône. Deze gemeente in het noorden van Isère heeft een schat aan erfgoed, waaronder de archeologische vindplaats Larina, die je kunt bezoeken in het archeologisch museum."
    ],
    "es": [
      "Descubra Hières-sur-Amby, en el noroeste de los Balcones del Dauphiné, a orillas del Ródano. Este municipio del norte de Isère atesora un rico patrimonio, como el yacimiento arqueológico de Larina, que puede visitarse en su museo arqueológico."
    ]
  },
