  "rdfs:comment": {
    "de": [
      "Die Ateliergalerie La Bohème ist ein Geschäft, das der lokalen Kreativität in den Bereichen Handwerk (Schmuck, Töpferwaren, Leder, Glas...) und Kunst (Malerei und Skulptur) gewidmet ist, die aus authentischem Know-how hervorgeht. Kurzfristige Ausstellungen von April bis Oktober."
    ],
    "en": [
      "L'atelier galerie La Bohème is a boutique dedicated to local creativity in crafts (jewelry, pottery, leather, glass...) and art (painting and sculpture), based on authentic know-how. Ephemeral exhibitions from April to October."
    ],
    "it": [
      "La Bohème è un negozio dedicato alla creatività locale nell'artigianato (gioielli, ceramiche, cuoio, vetro, ecc.) e nell'arte (pittura e scultura), basata su un know-how autentico. Mostre effimere da aprile a ottobre."
    ],
    "fr": [
      "L'atelier galerie La Bohème est une boutique dédiée à la créativité locale artisanale (bijoux, poteries, cuir, verre...) et artistique (peinture et sculpture), issue de savoir-faire authentique. Expos éphémères d'avril à octobre."
    ],
    "nl": [
      "La Bohème is een winkel gewijd aan lokale creativiteit in ambachten (sieraden, aardewerk, leer, glas, enz.) en kunst (schilderen en beeldhouwen), gebaseerd op authentieke knowhow. Tijdelijke tentoonstellingen van april tot oktober."
    ],
    "es": [
      "La Bohème es una tienda dedicada a la creatividad local en artesanía (joyería, cerámica, cuero, vidrio, etc.) y arte (pintura y escultura), basada en un auténtico saber hacer. Exposiciones efímeras de abril a octubre."
    ]
  },
  "rdfs:label": {
    "fr": [
