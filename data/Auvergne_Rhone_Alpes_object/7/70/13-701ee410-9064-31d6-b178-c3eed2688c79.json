  "rdfs:comment": {
    "de": [
      "Wir sind seit 1950 auf den Verleih von Skiern, Snowboards, Langlaufskiern, Schneeschuhen und Kleidung spezialisiert und befinden uns in idealer Lage im Stadtzentrum von Chamonix, 100 m von den Skipisten des Savoy entfernt."
    ],
    "en": [
      "Specializing in ski, snowboard, cross-country and snowshoe rentals, as well as clothing, since 1950, we are ideally located in downtown Chamonix, 100m from the Savoy ski slopes."
    ],
    "it": [
      "Specializzati dal 1950 nel noleggio di sci, snowboard, sci di fondo, racchette da neve e abbigliamento, siamo situati nel centro di Chamonix, a 100 metri dalle piste da sci della Savoia."
    ],
    "fr": [
      "Spécialiste de la location de skis, de snowboard, de skis de fond et de raquettes ainsi que de vêtements, depuis 1950, nous sommes idéalement situés dans le centre-ville de Chamonix à 100m des pistes de ski du Savoy."
    ],
    "nl": [
      "Sinds 1950 gespecialiseerd in ski-, snowboard-, langlauf- en sneeuwschoenverhuur en kleding. Ideaal gelegen in het centrum van Chamonix, op 100 meter van de skipistes van de Savoie."
    ],
    "es": [
      "Especializados en el alquiler de esquís, snowboards, raquetas de fondo y de nieve, así como de ropa, desde 1950, estamos idealmente situados en el centro de Chamonix, a 100 m de las pistas de esquí de Saboya."
    ]
  },
