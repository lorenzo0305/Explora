          "additionalInformation": {
            "de": [
              "Mittwoch in Boën (Parkplatz von Aldi) ab 17 Uhr.\r\nFreitag in Sail sous Couzan ab 17 Uhr.\r\nSamstag in Boën (Parkplatz von Aldi) ab 17 Uhr.\r\nSonntag in Sainte-Agathe-la-Bouteresse (hinter dem Rond Pain) ab 17 Uhr."
            ],
            "en": [
              "Wednesday in Boën (Aldi parking lot) from 5pm.\r\nFriday in Sail sous Couzan from 5pm.\r\nSaturday in Boën (Aldi parking lot) from 5pm.\r\nSunday in Sainte-Agathe-la-Bouteresse (behind Rond Pain) from 5pm."
            ],
            "it": [
              "Mercoledì a Boën (parcheggio Aldi) dalle 17.00.\r\nVenerdì a Sail sous Couzan dalle 17.00.\r\nSabato a Boën (parcheggio Aldi) dalle 17.00.\r\nDomenica a Sainte-Agathe-la-Bouteresse (dietro il Rond Pain) dalle 17.00."
            ],
            "fr": [
              "Mercredi à Boën (parking d'Aldi) dès 17h.\r\nVendredi  à Sail sous Couzan dès 17h.\r\nSamedi à Boën (parking d'Aldi) dès 17h. \r\nDimanche à Sainte-Agathe-la-Bouteresse (derrière le Rond Pain) dès 17h."
            ],
            "nl": [
              "Woensdag in Boën (parkeerplaats Aldi) vanaf 17.00 uur.\r\nVrijdag in Sail sous Couzan vanaf 17u.\r\nZaterdag in Boën (Aldi parking) vanaf 17u.\r\nZondag in Sainte-Agathe-la-Bouteresse (achter het Rond Pain) vanaf 17u."
            ],
            "es": [
              "Miércoles en Boën (aparcamiento Aldi) a partir de las 17.00 horas.\r\nViernes en Sail sous Couzan a partir de las 17.00 horas.\r\nSábado en Boën (aparcamiento Aldi) a partir de las 17.00 h.\r\nDomingo en Sainte-Agathe-la-Bouteresse (detrás del Rond Pain) a partir de las 17.00 h."
            ]
