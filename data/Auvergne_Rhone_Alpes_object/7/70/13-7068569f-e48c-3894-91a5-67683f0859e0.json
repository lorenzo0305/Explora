  "rdfs:comment": {
    "de": [
      "In einem geselligen Ambiente und einem gemütlichen orientalischen Dekor, lässt Sie L'Etoile d'Orient eine tunesische und marokkanische Halal-Küche entdecken, welche mit sanft gewürzten Aromen raffiniert wurde."
    ],
    "en": [
      "In a friendly setting with a warm oriental decorative scheme, the Etoile d’Orient will help you discover a refined Tunisian and Moroccan cuisine with its delicately spicy flavours."
    ],
    "it": [
      "In un'atmosfera cordiale e circondandoti con un'accogliente decorazione orientale, l'Étoile d'Orient ti fa scoprire una cucina tunisina e marocchina halal raffinata con sapori delicatamente speziati."
    ],
    "fr": [
      "Dans une ambiance conviviale, et un décor oriental chaleureux, l’Etoile d’Orient vous fait découvrir une cuisine tunisienne et marocaine halal raffinées aux saveurs délicatement épicées."
    ],
    "nl": [
      "In een vriendelijke sfeer en een warm oosters decor biedt de Etoile d'Orient een verfijnde Tunesische en Marokkaanse halal-keuken met delicaat gekruide smaken."
    ],
    "es": [
      "En una atmósfera acogedora con una cálida decoración oriental, L'Etoile d’Orient propone una cocina tunecina y marroquí halal refinada con sabores delicadamente especiados."
    ]
  },
