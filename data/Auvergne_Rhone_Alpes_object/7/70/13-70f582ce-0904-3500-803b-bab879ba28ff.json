  "rdfs:comment": {
    "de": [
      "Jahrhundert im neugotischen Stil, die dem Heiligen Mauritius gewidmet ist, mit einem halbkreisförmigen Platz, der mit portugiesischem Granit gepflastert ist, und dem Brunnen."
    ],
    "en": [
      "The 19th-century neo-Gothic church, dedicated to Saint-Maurice, features a semi-circular square paved with Portuguese granite and a fountain."
    ],
    "it": [
      "La chiesa neogotica del XIX secolo, dedicata a Saint-Maurice, ha una piazza semicircolare pavimentata in granito portoghese e una fontana."
    ],
    "fr": [
      "L'église du XIXe siècle, de style néogothique, est dédiée à Saint-Maurice avec sa place de forme semi-circulaire pavée en granit du Portugal et la fontaine."
    ],
    "es": [
      "La iglesia neogótica del siglo XIX, dedicada a San Mauricio, tiene una plaza semicircular pavimentada con granito portugués y una fuente."
    ],
    "nl": [
      "De 19e-eeuwse neogotische kerk, gewijd aan Saint-Maurice, heeft een halfrond plein geplaveid met Portugees graniet en een fontein."
    ]
  },
