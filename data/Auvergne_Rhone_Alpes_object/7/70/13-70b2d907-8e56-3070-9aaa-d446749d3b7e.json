  "rdfs:comment": {
    "de": [
      "Die Snackbar des Campingplatzes Le Champ Long in La Salle en Beaumont im Departement Isère zwischen dem Nationalpark Les Ecrins und dem Regionalpark Vercors ist den ganzen Tag über für Ihren kleinen Hunger, Cocktails, kalte Getränke, Pommes frites, Eis, Crêpes, Waffeln, ... geöffnet."
    ],
    "en": [
      "The snack bar at Le Champ Long campsite in La Salle en Beaumont in Isère, between the Ecrins National Park and the Vercors Regional Park, is open all day for your snacks, cocktails, cold drinks, fries, ice creams, pancakes, waffles, etc."
    ],
    "it": [
      "Lo snack bar del campeggio Le Champ Long a La Salle en Beaumont nell'Isère, tra il Parco Nazionale degli Ecrins e il Parco Regionale del Vercors, è aperto tutto il giorno per spuntini, cocktail, bevande fredde, patatine, gelati, crêpes, waffles, ecc."
    ],
    "fr": [
      "Le snack du camping Le Champ Long à La Salle en Beaumont en Isère entre le Parc National des Ecrins et le Parc Régional du Vercors est ouvert toute la journée pour vos petites faims, vos cocktails, boissons fraîches, frites, glaces, crêpes, gaufres, ..."
    ],
    "es": [
      "El snack bar del camping Le Champ Long de La Salle en Beaumont, en Isère, entre el Parque Nacional de Ecrins y el Parque Regional de Vercors, está abierto todo el día para tomar tentempiés, cócteles, bebidas frías, patatas fritas, helados, crepes, gofres, etc."
    ],
    "nl": [
      "De snackbar van camping Le Champ Long in La Salle en Beaumont in Isère, tussen het Parc National des Ecrins en het Parc Régional des Vercors, is de hele dag geopend voor snacks, cocktails, koude dranken, frietjes, ijsjes, crêpes, wafels, enz."
    ]
  },
