  "rdfs:comment": {
    "de": [
      "Bio éco vrac ist ein Bio-Lebensmittelgeschäft, das auf lose Ware spezialisiert ist und eine große Abteilung mit Kosmetika, Nahrungsergänzungsmitteln, Pflege- und Schönheitsartikeln besitzt."
    ],
    "en": [
      "Bio éco vrac is an organic food store specializing in bulk products, with a wide range of cosmetics, food supplements, skincare and beauty products."
    ],
    "it": [
      "Bio éco vrac è un negozio di alimenti biologici specializzato in prodotti sfusi, con un'ampia gamma di cosmetici, integratori alimentari, prodotti per la cura e la bellezza."
    ],
    "fr": [
      "Bio éco vrac est un magasin d'alimentation bio spécialisé dans le vrac, possédant un large rayon de cosmétiques, compléments alimentaires, soin et beauté."
    ],
    "nl": [
      "Bio éco vrac is een biologische levensmiddelenwinkel gespecialiseerd in bulkproducten, met een ruim assortiment cosmetica, voedingssupplementen, huidverzorging en schoonheidsproducten."
    ],
    "es": [
      "Bio éco vrac es una tienda de alimentación ecológica especializada en productos a granel, con una amplia gama de cosméticos, complementos alimenticios, productos de cuidado y belleza."
    ]
  },
