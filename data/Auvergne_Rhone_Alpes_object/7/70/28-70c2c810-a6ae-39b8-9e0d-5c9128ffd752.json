  "rdfs:comment": {
    "de": [
      "Das Restaurant heißt Sie herzlich willkommen. Sie werden auch von einer charmanten, ruhigen und begrünten Terrasse im Innenhof profitieren. Die Küche ist traditionell und hausgemacht, die Speisekarte variiert je nach Jahreszeit."
    ],
    "en": [
      "The restaurant welcomes you in all simplicity. You will also enjoy a charming interior terrace, quiet and planted. The cuisine is traditional, homemade, with a menu that varies with the seasons."
    ],
    "it": [
      "Il ristorante vi accoglie in tutta semplicità. Potrete anche godere di un'incantevole terrazza interna, tranquilla e verdeggiante. La cucina è tradizionale, casalinga, con un menu che varia a seconda delle stagioni."
    ],
    "fr": [
      "Le restaurant vous accueille en toute simplicité. Vous profiterez également d’une charmante terrasse intérieure, calme et végétalisée. La cuisine se veut traditionnelle, faite maison, avec un menu variant au fil des saisons."
    ],
    "nl": [
      "Het restaurant verwelkomt u in alle eenvoud. U zult ook genieten van een charmant binnenterras, rustig en groen. De keuken is traditioneel, huisgemaakt, met een menu dat varieert met de seizoenen."
    ],
    "es": [
      "El restaurante le acoge con toda sencillez. También disfrutará de una encantadora terraza interior, tranquila y verde. La cocina es tradicional, casera, con una carta que varía según las estaciones."
    ]
  },
