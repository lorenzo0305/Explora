  "rdfs:comment": {
    "de": [
      "Courtepaille empfängt Sie, um Ihnen ein gutes Grillgericht aus dem Holzofen zu servieren, das vor Ihren Augen gegart wird."
    ],
    "en": [
      "Courtepaille welcomes you to enjoy a good wood-fired grill cooked in front of your eyes."
    ],
    "it": [
      "Courtepaille vi accoglie per gustare una buona grigliata a legna cucinata davanti ai vostri occhi."
    ],
    "fr": [
      "Courtepaille vous accueille pour vous faire déguster une bonne grillade au feu de bois cuite sous vos yeux."
    ],
    "nl": [
      "Courtepaille verwelkomt u om te genieten van een goede houtgestookte grill die voor uw ogen wordt bereid."
    ],
    "es": [
      "Courtepaille le invita a disfrutar de una buena parrilla de leña cocinada ante sus ojos."
    ]
  },
