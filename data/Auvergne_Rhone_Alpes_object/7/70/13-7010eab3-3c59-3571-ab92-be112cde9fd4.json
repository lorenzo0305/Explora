  "rdfs:comment": {
    "de": [
      "Tanzen auf einer Gratlinie, in der Ruhe vor dem Sturm, oder wenn drei Choreografen, Childs, Dawson und Forsythe, sich dem Chaos der Welt stellen. Eine Aufführung zwischen minimalistischer Grafik und Bewegungspoesie."
    ],
    "en": [
      "Dancing on a razor’s edge — the calm before the storm — as choreographers Childs, Dawson, and Forsythe confront the chaos of the world. In this performance, minimalist design meets the poetry of movement."
    ],
    "it": [
      "Danzare su un crinale, nella calma prima della tempesta, o quando tre coreografi, Childs, Dawson e Forsythe, affrontano il caos del mondo. Uno spettacolo che unisce grafica minimalista e movimento poetico."
    ],
    "fr": [
      "Danser sur une ligne de crête, dans le calme d’avant la tempête, ou quand trois chorégraphes, Childs, Dawson et Forsythe, font face au chaos du monde. Un spectacle entre graphisme minimaliste et poésie du mouvement."
    ],
    "nl": [
      "Dansen op een heuvelrug, in de stilte voor de storm, of wanneer drie choreografen, Childs, Dawson en Forsythe, de chaos van de wereld trotseren. Een show die minimalistische graphics en poëtische beweging combineert."
    ],
    "es": [
      "Bailar en una cresta, en la calma que precede a la tormenta, o cuando tres coreógrafos, Childs, Dawson y Forsythe, se enfrentan al caos del mundo. Un espectáculo que combina grafismo minimalista y movimiento poético."
    ]
  },
  "rdfs:label": {
    "en": [
