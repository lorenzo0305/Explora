  "rdfs:comment": {
    "de": [
      "Die Gärten von Espaladous liegen in der Haute-Loire auf den Überresten eines alten Bauernhofs in einem schönen Tal in der Nähe von Le Puy-en-Velay."
    ],
    "en": [
      "In the Haute-Loire, on the remains of an old farm nestled in a pretty valley near Le Puy-en-Velay, you'll find Les Jardins d'Espaladous: a multi-faceted estate with a restaurant and accommodation in rooms and apartments."
    ],
    "it": [
      "Nella Haute-Loire, sui resti di un'antica fattoria immersa in una graziosa vallata vicino a Le Puy-en-Velay, si trova Les Jardins d'Espaladous: una tenuta dalle mille sfaccettature con un ristorante e alloggi in camere e appartamenti."
    ],
    "fr": [
      "En Haute-loire sur les vestiges d’une ancienne ferme nichée dans un joli vallon, proche du Puy-en-Velay,  se trouvent les jardins d’Espaladous: un domaine aux multiples facettes regroupant un restaurant et des hébergements en chambres ou appartements."
    ],
    "nl": [
      "In de Haute-Loire, op de overblijfselen van een oude boerderij genesteld in een mooie vallei in de buurt van Le Puy-en-Velay, vindt u Les Jardins d'Espaladous: een veelzijdig landgoed met een restaurant en accommodatie in kamers en appartementen."
    ],
    "es": [
      "En el Alto Loira, en los restos de una antigua granja enclavada en un bonito valle cerca de Le Puy-en-Velay, encontrará Les Jardins d'Espaladous: una finca polifacética con restaurante y alojamiento en habitaciones y apartamentos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurants les jardins d'Espaladous"
    ]
  },
