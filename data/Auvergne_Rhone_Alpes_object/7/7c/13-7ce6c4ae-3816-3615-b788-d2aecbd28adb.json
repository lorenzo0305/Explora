  "rdfs:comment": {
    "de": [
      "La Maison Rouge Restaurant, Bar, Hotel & Spa, vor den Toren von Chambéry gelegen, Atmosphäre Maison Savoyarde de Qualité, ein warmer, lebendiger und farbenfroher Ort, eine leckere, hausgemachte Küche, die aus frischen und saisonalen Produkten zubereitet wird."
    ],
    "en": [
      "The restaurant team and the Chef at the Maison Rouge will take you by surprise with their authentic cuisine, simple and rich in flavour."
    ],
    "it": [
      "Il ristorante, bar, hotel e spa La Maison Rouge, situato alla periferia di Chambéry, con la sua atmosfera da Maison Savoyarde, è un luogo caldo, vivace e colorato, che offre una cucina gourmet e casalinga preparata con prodotti freschi e di stagione."
    ],
    "fr": [
      "La Maison Rouge restaurant, bar, hôtel & spa, située aux portes de Chambéry, ambiance Maison Savoyarde de Qualité, un lieu chaleureux, vivant et coloré, une cuisine gourmande et faite maison, préparée à base de produits frais et de saison."
    ],
    "nl": [
      "La Maison Rouge restaurant, bar, hotel & spa, gelegen aan de rand van Chambéry, met zijn Maison Savoyarde kwaliteit sfeer, is een warme, levendige en kleurrijke plek, biedt gastronomische, huisgemaakte gerechten bereid met verse, seizoensgebonden producten."
    ],
    "es": [
      "El restaurante, bar, hotel y spa La Maison Rouge, situado en las afueras de Chambéry, con su ambiente de calidad de Maison Savoyarde, es un lugar cálido, animado y colorido, que ofrece cocina gourmet casera elaborada con productos frescos de temporada."
    ]
  },
