  "rdfs:comment": {
    "de": [
      "Rund um ein Glas.  Weinkeller, Feinkostladen, Wein- und Spirituosenbar, Bretter mit lokalen Produkten, begleitet von einer Auswahl an Weinen im Glas, Softdrinks, Tee oder Kaffee. Verkostung von Weinen und Spirituosen. Raum für Seminare. Veranstaltungen."
    ],
    "en": [
      "Around a glass.  Wine cellar, delicatessen, wine and spirits bar, boards of local produce accompanied by a selection of wines by the glass, softs, tea or coffee. Wine and spirits tastings. Seminar room. Special events."
    ],
    "it": [
      "Intorno a un bicchiere.  Cantina, gastronomia, bar di vini e liquori, taglieri di prodotti locali accompagnati da una selezione di vini al bicchiere, dolci, tè o caffè. Degustazioni di vini e liquori. Sala seminari. Eventi speciali."
    ],
    "fr": [
      "Autour d'un verre.  Cave à vins,  épicerie fine,  bar à vin et à spiritueux, planches de produits locaux accompagnés d’une sélection de vins au verre, de softs, de thé ou encore de café. Dégustations de vins et spiritueux. Salle de séminaire. Événements."
    ],
    "nl": [
      "Rond een glas.  Wijnkelder, delicatessen, wijn en sterke drank bar, borden met lokale producten vergezeld van een selectie van wijnen per glas, softs, thee of koffie. Proeverijen van wijn en sterke drank. Seminariezaal. Speciale evenementen."
    ],
    "es": [
      "En torno a una copa.  Bodega, delicatessen, bar de vinos y licores, tablas de productos locales acompañadas de una selección de vinos por copas, softs, té o café. Degustaciones de vinos y licores. Sala de seminarios. Eventos especiales."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Autour d'un verre - Cave, bar à vin et spiritueux, épicerie fine"
    ]
  },
