  "rdfs:comment": {
    "de": [
      "Das Hotel Valfréjus Vacances befindet sich im Herzen des Ortes und am Fuße der Pisten. Es empfängt Sie das ganze Jahr über in Zimmern mit 2 bis 6 Betten, mit der Familie, mit Freunden, in Gruppen von Erwachsenen oder Minderjährigen."
    ],
    "en": [
      "Located in the heart of the resort and at the foot of the slopes, the Valfréjus Vacances hotel welcomes you all year round in rooms with 2 to 6 beds, for families, friends, groups of adults or minors."
    ],
    "it": [
      "Situato nel cuore della località e ai piedi delle piste, l'hotel Valfréjus Vacances vi accoglie tutto l'anno in camere da 2 a 6 letti, per famiglie, amici, gruppi di adulti o minori."
    ],
    "fr": [
      "Situé en plein cœur de la station et au pied des pistes, l'hôtel Valfréjus Vacances vous accueille toute l'année dans des chambres de 2 à 6 lits, en famille, entre amis, en groupe d'adultes ou de mineurs."
    ],
    "es": [
      "Situado en pleno corazón de la estación y a pie de pistas, el hotel Valfréjus Vacances le acoge todo el año en habitaciones de 2 a 6 camas, para familias, amigos, grupos de adultos o menores."
    ],
    "nl": [
      "Het hotel Valfréjus Vacances ligt in het hart van het skioord en aan de voet van de pistes en verwelkomt u het hele jaar door in kamers met 2 tot 6 bedden, voor gezinnen, vrienden, groepen volwassenen of minderjarigen."
    ]
  },
