  "rdfs:comment": {
    "de": [
      "Morgens Imbiss mit Frühstück. Mittags Bistrokarte mit mehr als 12 verschiedenen Gerichten und Brettern zum Teilen. Tagesgericht und -menü. Teestube mit Eis, Crêpes, Waffeln und Sandwiches. Tapas mittags und abends im Juli und August."
    ],
    "en": [
      "Morning snack with breakfast. Lunchtime bistro menu with over 12 different dishes and platters to share. Daily specials and menus. Tea room with ice creams, crêpes, waffles and sandwiches. Tapas for lunch and dinner in July and August."
    ],
    "it": [
      "Spuntino mattutino e colazione. Menu del bistrot a pranzo con oltre 12 piatti e vassoi da condividere. Piatto e menu del giorno. Sala da tè con gelati, crêpes, cialde e panini. Tapas a pranzo e a cena in luglio e agosto."
    ],
    "fr": [
      "Le matin casse-croûte avec petit-déjeuner. À midi carte bistrot avec plus de 12  plats différents et des planches à partager. Plat et menu du jour. Salon de thé avec glaces, crêpes, gaufres et sandwichs. Tapas midi et soir en juillet et août."
    ],
    "nl": [
      "Ochtendsnack en ontbijt. Lunchtime bistromenu met meer dan 12 verschillende gerechten en schotels om te delen. Schotel en menu van de dag. Theesalon met ijsjes, crêpes, wafels en sandwiches. Tapas voor lunch en diner in juli en augustus."
    ],
    "es": [
      "Merienda y desayuno. Menú bistró a mediodía con más de 12 platos diferentes y bandejas para compartir. Plato y menú del día. Salón de té con helados, crepes, gofres y bocadillos. Tapas para el almuerzo y la cena en julio y agosto."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Rencard"
    ]
  },
