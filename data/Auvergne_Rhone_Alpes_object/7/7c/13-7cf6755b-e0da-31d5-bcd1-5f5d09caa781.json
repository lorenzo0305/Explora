    "de": [
      "Thema: Berg\r\nDarstellung einer Frau, die Marionetten bedient - Motive, die mit Savoyen und Portugal verbunden sind, aus denen der Künstler stammt.\r\nThema Mutter Natur?"
    ],
    "en": [
      "Theme: mountains\r\nRepresentation of a woman operating puppets - motifs linked to the artist's native Savoy and Portugal.\r\nMother Nature theme?"
    ],
    "it": [
      "Tema: le montagne\r\nRappresentazione di una donna che manovra delle marionette - motivi legati alla Savoia e al Portogallo, da cui proviene l'artista.\r\nTema: Madre Natura?"
    ],
    "fr": [
      "Thème : montagne\r\nReprésentation d'une femme actionnant des marionnettes - motifs liés à la Savoie et au Portugal dont est originaire l'artiste.\r\nThème de Dame Nature ?"
    ],
    "nl": [
      "Thema: bergen\r\nVoorstelling van een vrouw die poppen bedient - motieven die verband houden met Savoie en Portugal, waar de kunstenaar vandaan komt.\r\nThema: Moeder Natuur?"
    ],
    "es": [
      "Tema: montañas\r\nRepresentación de una mujer manejando marionetas - motivos relacionados con Saboya y Portugal, de donde es originario el artista.\r\nTema: la madre naturaleza ?"
    ]
