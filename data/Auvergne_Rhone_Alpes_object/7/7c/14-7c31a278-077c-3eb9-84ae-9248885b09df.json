  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/c3790a28-8a47-3a4f-a677-cdb3bff5119e",
      "dc:description": {
        "de": [
          "3 Rettungsstationen, die auf dem Deich verteilt sind, sorgen für die Überwachung der Bäder.\nDer Überwachungsbereich wird auf 800 Meter ausgeweitet."
        ],
        "en": [
          "3 first-aid posts distributed on the dike ensure the supervision of the baths\nThe surveillance zone is extended to 800 metres."
        ],
        "it": [
          "3 postazioni di pronto soccorso distribuite lungo la diga garantiscono la sorveglianza dei bagni.\nLa zona di sorveglianza è stata estesa a 800 metri."
        ],
        "fr": [
          "3 postes de secours répartis sur la digue assurent la surveillance des bains. \nLa zone de surveillance est étendue à 800 mètres."
        ],
        "es": [
          "3 puestos de socorro repartidos a lo largo del dique vigilan los baños.\nLa zona de vigilancia se ha ampliado a 800 metros."
        ],
        "nl": [
          "3 eerstehulpposten verspreid langs de dijk bewaken de baden.\nDe bewakingszone is uitgebreid tot 800 meter."
        ]
      },
      "@type": [
        "Description"
      ],
