  "rdfs:comment": {
    "de": [
      "Lichtdurchfluteter Raum, Dekoration im Retro-Stil und Sofas aus Samt: Die Rôtisserie ist ein für alle offenes Restaurant im Talstationsbereich von Courchevel Moriond."
    ],
    "ru": [
      "Пространство, залитое светом, декор в стиле ретро и бархатные диваны, — ресторан Rôtisserie открыт для всех у подножия лыжных трасс в Куршевель-Морионде."
    ],
    "en": [
      "Bathed in light, with its retro decoration and velvet sofas, La Rotisserie is open to everyone and is located right on the foot of the slopes of Courchevel Moriond."
    ],
    "it": [
      "In un locale illuminato di luce naturale, con decorazione retro e divani in velluto, la Rôtisserie è un ristorante aperto a tutti, che si affaccia sul fronte neve di Courchevel Moriond."
    ],
    "fr": [
      "Espace baigné de lumière, déco rétro et canapés velours, la Rôtisserie est un restaurant ouvert à tous sur le front de neige de Courchevel Moriond."
    ],
    "es": [
      "Un espacio bañado de luz, decoración retro y sofás de terciopelo, La Rôtisserie es un restaurante abierto a todos los públicos frente a la nieve de Courchevel Moriond."
    ],
    "zh": [
      "Rôtisserie是一家对外开放的餐厅，位于Courchevel Moriond的雪线上，光线充沛，装饰复古，配有天鹅绒扶手椅。"
    ],
    "nl": [
      "De Rôtisserie, een lichte ruimte met een retro decor en fluwelen banken, is een voor iedereen toegankelijk restaurant aan het sneeuwfront van Courchevel Moriond."
    ]
  },
