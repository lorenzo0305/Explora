  "rdfs:comment": {
    "de": [
      "Willkommen auf der Domaine du Coq en Pat, wo Natur und Authentizität aufeinandertreffen! Auf unserem 11 Hektar großen Bio-Bauernhof bauen wir viele Beerenfrüchte an und halten unsere Legehennen im Freien (frische Eier von hoher Qualität)."
    ],
    "en": [
      "Welcome to Domaine du Coq en Pat, where nature meets authenticity! At the heart of our 11-hectare organic farm, we grow a wide range of red fruits and raise our own free-range laying hens (high-quality fresh eggs)."
    ],
    "it": [
      "Benvenuti al Domaine du Coq en Pat, dove la natura incontra l'autenticità! Nel cuore della nostra azienda agricola biologica di 11 ettari, coltiviamo un'ampia gamma di frutti rossi e alleviamo le nostre galline ovaiole all'aperto (uova fresche e di alta qualità)."
    ],
    "fr": [
      "Bienvenue au Domaine du Coq en Pat, où nature et authenticité se rencontrent! Au cœur de notre ferme de 11 ha, en agriculture biologique, nous cultivons de nombreux fruits rouges et élevons nos poules pondeuses en plein air (œufs frais de grande qualité)."
    ],
    "nl": [
      "Welkom op Domaine du Coq en Pat, waar natuur en authenticiteit elkaar ontmoeten! In het hart van onze biologische boerderij van 11 hectare telen we een breed scala aan rood fruit en houden we onze eigen scharrelkippen (verse eieren van hoge kwaliteit)."
    ],
    "es": [
      "Bienvenido al Domaine du Coq en Pat, donde la naturaleza se encuentra con la autenticidad En el corazón de nuestra granja ecológica de 11 hectáreas, cultivamos una amplia gama de frutos rojos y criamos nuestras propias gallinas ponedoras camperas (huevos frescos de alta calidad)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le domaine du Coq en Pat - Production de petits fruits rouges et d'oeufs"
    ]
  },
