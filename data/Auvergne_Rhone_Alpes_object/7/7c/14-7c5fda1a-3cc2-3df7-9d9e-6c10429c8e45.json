  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/501954f7-d94b-37bf-8792-28f32d236898",
      "dc:description": {
        "de": [
          "Besuchen Sie den 8 Hektar großen, baumbestandenen Park. Ponyreiten für Kinder. Vorführung eines Hufschmieds am Sonntag um 15 Uhr\nSamstag und Sonntag von 10 bis 17 Uhr\n201 rue du Denacre\nEintrittspreise: 5 ? und kostenlos für Kinder unter 18 Jahren\n\nhttps://www.chateaududenacre.com/\n\nSamstag, 17. und Sonntag, 18. September von 10 bis 17 Uhr\nEintrittspreis: 5?\nKostenlos für Kinder unter 18 Jahren"
        ],
        "en": [
          "Visit the 8-hectare wooded park. Pony rides for children. Farrier demonstration on Sunday at 3pm\nSaturday and Sunday from 10am to 5pm\n201 rue du Denacre\nAdmission: 5? and free for children under 18\n\nhttps://www.chateaududenacre.com/\n\nSaturday 17th and Sunday 18th September, 10am to 5pm\nAdmission: 5?\nFree for children under 18"
        ],
        "it": [
          "Visitate il parco alberato di 8 ettari. Passeggiate con i pony per i bambini. Dimostrazione del maniscalco domenica alle 15.00\nSabato e domenica dalle 10.00 alle 17.00\n201 rue du Denacre\nIngresso: 5? e gratuito per i minori di 18 anni\n\nhttps://www.chateaududenacre.com/\n\nSabato 17 e domenica 18 settembre dalle 10.00 alle 17.00\nIngresso: 5?\nGratuito per i minori di 18 anni"
        ],
        "fr": [
          "Visite du parc arboré de 8 hectares. Tour à poney pour les enfants. Démonstration de maréchal ferrant le Dimanche à 15h\nSamedi et Dimanche de 10h à 17h\n201 rue du Denacre\nTarifs: 5€ et gratuit pour les moins de 18 ans\n\nhttps://www.chateaududenacre.com/\n\nSamedi 17 et dimanche 18 septembre de 10h à 17h\nTarif: 5€\nGratuit pour les - de 18 ans"
        ],
        "es": [
          "Visite el parque arbolado de 8 hectáreas. Paseos en poni para niños. Demostración de herrador el domingo a las 15 h\nSábado y domingo de 10.00 a 17.00 h\n201 rue du Denacre\nEntrada: 5? y gratuita para menores de 18 años\n\nhttps://www.chateaududenacre.com/\n\nSábado 17 y domingo 18 de septiembre de 10.00 a 17.00 h\nEntrada: 5?\nGratis para menores de 18 años"
        ],
        "nl": [
          "Bezoek het beboste park van 8 hectare. Ponyritjes voor kinderen. Hoefsmeerdemonstratie op zondag om 15.00 uur\nZaterdag en zondag van 10 tot 17 uur\n201 rue du Denacre\nToegangsprijs: 5 € en gratis voor kinderen onder de 18 jaar\n\nhttps://www.chateaududenacre.com/\n\nZaterdag 17 en zondag 18 september van 10 tot 17 uur\nToegangsprijs: 5?\nGratis voor kinderen onder de 18 jaar"
        ]
      },
