  "rdfs:comment": {
    "de": [
      "Haben Sie Lust auf einen einfachen und geselligen Moment? Dann ist Les Géorennes der richtige Ort für Sie. Das Bistro empfängt Sie mit einer hausgemachten Pizza oder einer Platte mit lokalen Produkten, die Sie mit anderen teilen können, und das alles in einer bergigen Umgebung."
    ],
    "en": [
      "Want to spend a simple and friendly time? It is in Georennes that you must go. His Bistrot will welcome you around a homemade pizza or a board of local products to share; all in a mountain setting."
    ],
    "it": [
      "Cercate qualcosa di semplice e conviviale? Les Géorennes è il posto giusto. Il suo Bistrot vi accoglierà per una pizza fatta in casa o un piatto di prodotti locali da condividere, il tutto in un ambiente di montagna."
    ],
    "fr": [
      "Envie de passer un moment simple et convivial ? C'est aux Géorennes qu'il faut vous rendre. Son Bistrot vous accueillera autour d'une pizza maison ou d'une planche de produits locaux à partager; le tout dans un cadre montagnard."
    ],
    "es": [
      "¿Busca algo sencillo y acogedor? Les Géorennes es el lugar ideal. Su Bistrot le acogerá para ofrecerle una pizza casera o un plato de productos locales para compartir, todo ello en un entorno de montaña."
    ],
    "nl": [
      "Op zoek naar iets eenvoudigs en gezelligs? Dan is Les Géorennes de plek om naartoe te gaan. De Bistrot verwelkomt je voor een huisgemaakte pizza of een schotel met lokale producten om te delen, allemaal in een bergachtige omgeving."
    ]
  },
