  "rdfs:comment": {
    "de": [
      "Im Norden des Departements Loire liegt das mittelalterliche Dorf Le Crozet, das stolz auf einem Felsvorsprung thront. Verweilen Sie bei der Nouvelle Église, von der aus Sie ein außergewöhnliches Panorama genießen können."
    ],
    "en": [
      "In the north of the Loire department, the medieval village of Le Crozet stands proudly on its rocky promontory. Linger at the Nouvelle Église for an exceptional panoramic view."
    ],
    "it": [
      "Nel nord del dipartimento della Loira, il villaggio medievale di Le Crozet si erge fiero sul suo promontorio roccioso. Soffermatevi sulla Nouvelle Église per godere di una vista panoramica eccezionale."
    ],
    "fr": [
      "Au Nord du département de la Loire, le village médiéval de Le Crozet campe fièrement sur son promontoire rocheux. Attardez-vous à la Nouvelle Église près de laquelle vous découvrirez un panorama exceptionnel."
    ],
    "nl": [
      "In het noorden van het departement Loire staat het middeleeuwse dorp Le Crozet trots op zijn rotsachtige kaap. Blijf hangen bij de Nouvelle Église voor een uitzonderlijk panoramisch uitzicht."
    ],
    "es": [
      "Al norte del departamento del Loira, el pueblo medieval de Le Crozet se alza orgulloso sobre su promontorio rocoso. Quédese en la Nouvelle Église para disfrutar de una vista panorámica excepcional."
    ]
  },
