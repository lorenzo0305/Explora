  "rdfs:comment": {
    "de": [
      "Gleiten Sie auf der einzigen Eisbahn der Region Drôme-Ardèche! Nur wenige Schritte vom Stadtzentrum von Valence entfernt empfängt Sie die Eislaufbahn der Agglo auf 1800 m² Eisfläche. Ob mit der Familie, allein oder mit Freunden, ein schöner Moment der Entspannung steht Ihnen bevor!"
    ],
    "en": [
      "Come and slide on the only skating rink in Drôme-Ardèche! Just a stone's throw from downtown Valence, the Agglo skating rink welcomes you to its 1,800m² of ice. Whether you're with the family, on your own or with friends, you're sure to have a great time!"
    ],
    "it": [
      "Venite a scivolare sull'unica pista di ghiaccio di Drôme-Ardèche! A due passi dal centro di Valence, la pista di pattinaggio dell'Agglo vi accoglie su 1.800 m² di ghiaccio. Che siate in famiglia, da soli o con gli amici, vi divertirete un mondo!"
    ],
    "fr": [
      "Venez glisser sur l’unique patinoire de Drôme-Ardèche ! A deux pas du centre-ville de Valence, la patinoire de l'Agglo vous accueille sur 1 800m² de glace. En famille, en solo ou entre amis, un beau moment de détente en perspective !"
    ],
    "es": [
      "Venga a deslizarse por la única pista de hielo de Drôme-Ardèche A dos pasos del centro de Valence, la pista de hielo de Agglo le da la bienvenida en 1.800 m² de hielo. Ya sea en familia, solo o con amigos, ¡se lo pasará en grande!"
    ],
    "nl": [
      "Kom glijden op de enige ijsbaan in Drôme-Ardèche! Op een steenworp afstand van het centrum van Valence verwelkomt de Agglo ijsbaan je op zijn 1.800 m² ijs. Met het gezin, alleen of met vrienden, je zult je hier prima vermaken!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Patinoire de Valence \"Jo Boyadjian\""
    ]
  },
