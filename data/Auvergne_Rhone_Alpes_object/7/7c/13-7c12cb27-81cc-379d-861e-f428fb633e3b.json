  "rdfs:comment": {
    "de": [
      "Werfen Sie einen Blick hinter die Kulissen der Werkstatt, in der die Stühle für den Jardin des Tuileries in Paris und die berühmte Promenade des Anglais in Nizza hergestellt werden!"
    ],
    "en": [
      "Take a behind-the-scenes look at how chairs are made for the Tuileries Gardens in Paris and the famous Promenade des Anglais in Nice!"
    ],
    "it": [
      "Scoprite il dietro le quinte della realizzazione delle sedie per i Giardini delle Tuileries a Parigi e per la famosa Promenade des Anglais a Nizza!"
    ],
    "fr": [
      "Venez découvrir les coulisses de l'atelier de fabrication des chaises du  jardin des Tuileries à Paris et de la la célèbre Promenade des Anglais à Nice !"
    ],
    "es": [
      "Vea entre bastidores cómo se fabrican las sillas de los Jardines de las Tullerías de París y del famoso Paseo de los Ingleses de Niza"
    ],
    "nl": [
      "Neem een kijkje achter de schermen bij hoe stoelen worden gemaakt voor de Tuilerieën Tuinen in Parijs en de beroemde Promenade des Anglais in Nice!"
    ]
  },
