  "rdfs:comment": {
    "de": [
      "Restaurant mit Streetfood, Weinstube, Bierstube, Cocktails, Partys\r\nPizzas und Burger zum Mitnehmen mittags oder abends, mittags vor Ort.\r\nAbends können Sie einen Cocktail, ein Glas Wein oder ein Bier mit Tapas genießen."
    ],
    "en": [
      "Restaurant offering Streetfood, Wine bar, Beer bar, Cocktails, Parties\r\nPizzas and burgers to take away for lunch or dinner, on the spot for lunch.\r\nFor the evening, come to sip a cocktail, a glass of wine or a beer accompanied by tapas."
    ],
    "it": [
      "Ristorante che offre Streetfood, Wine bar, Beer bar, Cocktail, Feste\r\nPizze e hamburger da asporto a pranzo o la sera, in loco a pranzo.\r\nPer la sera, venite a sorseggiare un cocktail, un bicchiere di vino o una birra con le tapas."
    ],
    "fr": [
      "Restaurant proposant de la Streetfood, Bar à vins, Bar à bières, Cocktails, Soirées\r\nPizzas et burgers a emporter le midi ou le soir, sur place le midi.\r\nPour le soir, venez siroter un cocktail, un verre de vin ou une bière accompagné de tapas."
    ],
    "es": [
      "Restaurante que ofrece Streetfood, Bar de vinos, Bar de cervezas, Cócteles, Fiestas\r\nPizzas y hamburguesas para llevar al mediodía o por la noche, in situ al mediodía.\r\nPor la noche, venga a saborear un cóctel, una copa de vino o una cerveza con tapas."
    ],
    "nl": [
      "Restaurant met Streetfood, Wijnbar, Bierbar, Cocktails, Feesten\r\nPizza's en hamburgers om 's middags of 's avonds mee te nemen, 's middags ter plaatse.\r\nKom 's avonds een cocktail, een glas wijn of een biertje drinken met tapas."
    ]
  },
  "rdfs:label": {
