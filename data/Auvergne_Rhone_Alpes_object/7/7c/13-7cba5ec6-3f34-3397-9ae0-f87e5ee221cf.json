  "rdfs:comment": {
    "de": [
      "Dieser mysteriöse Ort, der das Tal überragt, beherbergt die Ruinen der alten Pfarrkirche, die in eine private Familienkapelle umgewandelt wurde und heute im Besitz eines Vereins ist."
    ],
    "en": [
      "This mysterious site overlooking the valley is home to the ruins of the former parish church, transformed into a private family chapel and now owned by an association."
    ],
    "it": [
      "Questo misterioso sito che domina la valle ospita le rovine dell'antica chiesa parrocchiale, trasformata in cappella privata di famiglia e ora di proprietà dell'associazione."
    ],
    "fr": [
      "Ce mystérieux site qui domine la vallée accueille les ruines de l’ancienne église paroissiale transformée en chapelle privée familiale et devenue aujourd’hui propriété associative."
    ],
    "es": [
      "Este misterioso lugar que domina el valle alberga las ruinas de la antigua iglesia parroquial, transformada en capilla familiar privada y hoy propiedad de la asociación."
    ],
    "nl": [
      "Deze mysterieuze plek met uitzicht op de vallei herbergt de ruïnes van de voormalige parochiekerk, omgetoverd tot een privé familiekapel en nu eigendom van de vereniging."
    ]
  },
  "rdfs:label": {
    "en": [
      "Billard Chapel"
    ],
    "fr": [
      "Chapelle du Billard"
    ]
  },
