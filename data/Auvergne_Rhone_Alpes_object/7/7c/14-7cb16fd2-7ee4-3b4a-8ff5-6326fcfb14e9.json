  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/dff07baf-f373-3383-bebc-0ff9127f5c10",
      "dc:description": {
        "de": [
          "Dienstag, 24. Februar\n--------------------------------------\nAktivität: Handwerkliche Aktivität \"Mein lustiger Pinguin\", angeboten von der Abteilung Animation des Rathauses von Merlimont\nTreffpunkt: Fremdenverkehrsamt Merlimont, von 14:30 bis 15:30 Uhr\nPREIS: 3? pro Person\n\nSie können sich beim Service Animation im Office de Tourisme von Merlimont anmelden: 70 Avenue du Centre in Merlimont, montags bis freitags von 9 bis 12 Uhr\nKONTAKT: 03 21 94 72 18\nFOTOKREDIT: Freepik.com"
        ],
        "en": [
          "Tuesday, February 24th\n--------------------------------------\nActivity: Manual activity \"Mon Pingouin rigolo\" (My funny penguin) proposed by the Service Animation of the Mairie de Merlimont\nMeeting point: Merlimont Tourist Office, 2:30 pm to 3:30 pm\nRATE: 3? per person\n\nYou can register at the Service Animation located in the Merlimont Tourist Office: 70 Avenue du center, Merlimont, Monday to Friday, 9am to 12pm\nCONTACT : 03 21 94 72 18\nPHOTO CREDIT: Freepik.com"
        ],
        "it": [
          "Martedì 24 febbraio\n--------------------------------------\nAttività: \"Il mio buffo pinguino\", attività manuale a cura dell'Assessorato alle Manifestazioni del Comune di Merlimont\nPunto d'incontro: Ufficio del Turismo di Merlimont, dalle 14.30 alle 15.30\nTASSO: 3? a persona\n\nÈ possibile iscriversi presso il servizio di animazione situato nell'Ufficio del Turismo di Merlimont: 70 Avenue du centre, Merlimont, dal lunedì al venerdì, dalle 9.00 alle 12.00\nCONTATTO: 03 21 94 72 18\nCREDITO FOTO: Freepik.com"
        ],
        "fr": [
          "Mardi 24 février\n--------------------------------------\nActivité : Activité manuelle \"Mon Pingouin rigolo\" proposée par le Service Animation de la Mairie de Merlimont\nRendez-vous à l'Office de Tourisme de Merlimont, de 14h30 à 15h30\nTARIF : 3€ par personne\n\nVous pouvez vous inscrire au près du Service Animation situé dans l'Office de Tourisme de Merlimont : 70 Avenue du centre à Merlimont, du lundi au vendredi de 9h à 12h\nCONTACT : 03 21 94 72 18\nCREDIT PHOTO : Freepik.com"
        ],
        "es": [
          "Martes 24 de febrero\n--------------------------------------\nActividad: \"Mi divertido pingüino\" actividad manual organizada por el Departamento de Eventos del Ayuntamiento de Merlimont\nPunto de encuentro: Oficina de Turismo de Merlimont, de 14h30 a 15h30\nTARIFA : 3? por persona\n\nPuede inscribirse en el Servicio de Animación situado en la Oficina de Turismo de Merlimont: 70 Avenue du centre, Merlimont, de lunes a viernes, de 9.00 a 12.00 h\nCONTACTO: 03 21 94 72 18\nCRÉDITO FOTOGRÁFICO: Freepik.com"
        ],
        "nl": [
          "Dinsdag 24 februari\n--------------------------------------\nActiviteit: \"Mijn grappige pinguïn\" manuele activiteit georganiseerd door de Dienst Evenementen van de Stad Merlimont\nTrefpunt: Toeristische dienst van Merlimont, 14u30 tot 15u30\nTarief : 3? per persoon\n\nInschrijven kan bij de Dienst Animatie in de Dienst voor Toerisme van Merlimont: 70 Avenue du centre, Merlimont, van maandag tot vrijdag van 9u tot 12u\nCONTACT: 03 21 94 72 18\nFOTO CREDIT: Freepik.com"
        ]
      },
