  "rdfs:comment": {
    "de": [
      "Verbringen Sie einen einzigartigen Moment in einer märchenhaften Umgebung auf unserem Bauernhof. Unser neuer pädagogischer Bauernhof hat seine Türen für Familien, Schulen, Kindergärten und Freizeitzentren geöffnet, um einen unvergesslichen Einblick in die Natur und die Tiere zu erhalten."
    ],
    "en": [
      "Come and spend a unique moment in a magical setting at the farm. Our brand new educational farm has opened its doors to families, schools, nannies and leisure centres for an unforgettable experience close to the animals in the heart of nature..."
    ],
    "it": [
      "Venite a trascorrere un momento unico in un ambiente magico alla fattoria. La nostra nuovissima fattoria didattica ha aperto le porte a famiglie, scuole, tate e centri ricreativi per un'esperienza indimenticabile con gli animali nel cuore della natura..."
    ],
    "fr": [
      "Venez passer un moment unique dans un cadre féerique à la ferme. Notre toute nouvelle ferme pédagogique a ouvert ses portes aux familles, écoles, nounous et centres de loisirs pour une immersion inoubliable auprès des animaux au cœur de la nature..."
    ],
    "es": [
      "Venga a pasar un momento único en un entorno mágico en la granja. Nuestra flamante granja educativa ha abierto sus puertas a familias, colegios, guarderías y centros de ocio para vivir una experiencia inolvidable con animales en plena naturaleza..."
    ],
    "nl": [
      "Kom en beleef een uniek moment in een magische omgeving op de boerderij. Onze gloednieuwe educatieve boerderij heeft haar deuren geopend voor gezinnen, scholen, kinderdagverblijven en vrijetijdscentra voor een onvergetelijke ervaring met dieren in het hart van de natuur..."
    ]
  },
  "rdfs:label": {
    "de": [
      "Pädagogischer Bauernhof - Les Amismaux de la forêt enchantée (Die Freunde des Zauberwaldes)"
    ],
    "en": [
      "Educational farm - Les Amismaux de la forêt enchantée"
    ],
    "fr": [
      "Ferme pédagogique - Les Amismaux de la forêt enchantée"
    ]
  },
