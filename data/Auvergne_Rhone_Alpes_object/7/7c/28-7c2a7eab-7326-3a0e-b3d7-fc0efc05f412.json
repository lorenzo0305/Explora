  "rdfs:comment": {
    "de": [
      "Seit 1920 hinterlässt jede Generation durch die Kreation emblematischer Cuvées ihre Spuren in der Produktion."
    ],
    "en": [
      "Since 1920, each generation has left its mark on production through the creation of emblematic cuvées."
    ],
    "it": [
      "Dal 1920, ogni generazione ha lasciato la propria impronta sulla produzione attraverso la creazione di cuvée emblematiche."
    ],
    "fr": [
      "Depuis 1920, chaque génération laisse son empreinte sur la production par la création de cuvées emblématiques."
    ],
    "nl": [
      "Sinds 1920 heeft elke generatie zijn stempel gedrukt op de productie door emblematische cuvées te creëren."
    ],
    "es": [
      "Desde 1920, cada generación ha dejado su huella en la producción a través de la creación de cuvées emblemáticas."
    ]
