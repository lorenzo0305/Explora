  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/84443a6c-a094-3705-88aa-93a9ed82133f",
      "dc:description": {
        "de": [
          "Montag 23. Februar\n--------------------------------------\nAktivität: Sportaktivität \"Disc'Golf\", die von der Abteilung Animation des Rathauses von Merlimont angeboten wird\nTreffpunkt: Sportplatz in der Rue Camille Delacroix, von 14:30 bis 16:00 Uhr\nPreis: 3?\n\nSie können sich beim Service Animation im Office de Tourisme de Merlimont anmelden: 70 Avenue du Centre in Merlimont, montags bis freitags von 9 bis 12 Uhr\nKONTAKT: 03 21 94 72 18\nFOTOKREDIT: Freepik.com"
        ],
        "en": [
          "Monday, February 23rd\n--------------------------------------\nActivity: \"Disc'Golf\" sports activity proposed by the Merlimont Town Council's Activities Department\nMeet at the sports course on Rue Camille Delacroix, from 2.30pm to 4pm\nPrice: 3?\n\nYou can register at the Service Animation located in the Merlimont Tourist Office: 70 Avenue du center, Merlimont, Monday to Friday, 9am to 12pm\nCONTACT : 03 21 94 72 18\nPHOTO CREDIT: Freepik.com"
        ],
        "it": [
          "Lunedì 23 febbraio\n--------------------------------------\nAttività: attività sportiva \"Disc'Golf\" organizzata dal Dipartimento Eventi del Comune di Merlimont\nAppuntamento al campo sportivo di Rue Camille Delacroix, dalle 14.30 alle 16.00\nPrezzo: 3?\n\nÈ possibile iscriversi presso il servizio di animazione situato nell'Ufficio del Turismo di Merlimont: 70 Avenue du centre, Merlimont, dal lunedì al venerdì, dalle 9.00 alle 12.00\nCONTATTO: 03 21 94 72 18\nCREDITO FOTO: Freepik.com"
        ],
        "fr": [
          "Lundi 23 Février \n--------------------------------------\nActivité : Activité sportif \"Disc'Golf\" proposée par le Service Animation de la Mairie de Merlimont\nRendez-vous au parcours sportifs au Rue Camille Delacroix, de 14h30 à 16h\nTarifs : 3€\n\nVous pouvez vous inscrire au près du Service Animation situé dans l'Office de Tourisme de Merlimont : 70 Avenue du centre à Merlimont, du lundi au vendredi de 9h à 12h\nCONTACT : 03 21 94 72 18\nCREDIT PHOTO : Freepik.com"
        ],
        "nl": [
          "Maandag 23 februari\n--------------------------------------\nActiviteit: \"Disc'Golf\" sportactiviteit georganiseerd door de Dienst Evenementen van de Gemeenteraad van Merlimont\nAfspraak op het sportterrein in de Rue Camille Delacroix, van 14u30 tot 16u00\nPrijs: 3?\n\nInschrijven kan bij de Dienst Animatie in de Dienst voor Toerisme van Merlimont: 70 Avenue du centre, Merlimont, maandag tot vrijdag van 9u tot 12u\nCONTACT: 03 21 94 72 18\nFOTO CREDIT: Freepik.com"
        ],
        "es": [
          "Lunes 23 de febrero\n--------------------------------------\nActividad: Actividad deportiva \"Disc'Golf\" organizada por el Departamento de Eventos del Ayuntamiento de Merlimont\nCita en el campo de deportes de la calle Camille Delacroix, de 14.30 a 16.00 horas\nPrecio: 3?\n\nPuede inscribirse en el Servicio de Animación situado en la Oficina de Turismo de Merlimont: 70 Avenue du centre, Merlimont, de lunes a viernes, de 9h a 12h\nCONTACTO: 03 21 94 72 18\nCRÉDITO DE LA FOTO: Freepik.com"
        ]
      },
