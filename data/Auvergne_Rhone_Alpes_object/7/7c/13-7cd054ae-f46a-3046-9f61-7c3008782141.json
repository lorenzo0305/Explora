  "rdfs:comment": {
    "de": [
      "Zwischen Provence und Vercors liegt das Pays de Chabeuil im Herzen des Departements Drôme. Nur einen Katzensprung von der Sonnenautobahn entfernt, ist es ein wunderbarer Ort, um neue Energie zu tanken. Gourmetfreuden, grüner Tourismus und malerische Landschaften sind hier an der Tagesordnung."
    ],
    "en": [
      "Between Provence and Vercors, the Pays de Chabeuil is in the heart of the Drôme. Just a stone's throw from the Autoroute du Soleil, it's a wonderful place to recharge your batteries. Gourmet pleasures, green tourism and picturesque scenery are all on offer."
    ],
    "it": [
      "Tra la Provenza e il Vercors, il Pays de Chabeuil è il cuore della Drôme. A due passi dall'autostrada del sole, è un luogo ideale per ricaricare le batterie. Piaceri gastronomici, turismo verde e paesaggi pittoreschi sono tutti offerti."
    ],
    "fr": [
      "Entre Provence et Vercors, le Pays de Chabeuil est au cœur de la Drôme. A deux pas de l'autoroute du soleil, c'est un formidable lieu pour se ressourcer. Plaisirs gourmands, tourisme vert et pittoresque sont au rendez vous."
    ],
    "nl": [
      "Tussen de Provence en de Vercors ligt het Pays de Chabeuil in het hart van de Drôme. Op een steenworp afstand van de zonnesnelweg is het een geweldige plek om nieuwe energie op te doen. Gastronomisch genot, groen en pittoresk toerisme zijn hier allemaal te vinden."
    ],
    "es": [
      "Entre Provenza y Vercors, el Pays de Chabeuil está en el corazón de la Drôme. A dos pasos de la autopista del sol, es un lugar ideal para reponer fuerzas. Placeres gastronómicos, turismo verde y paisajes pintorescos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Valence Romans Tourisme : antenne de Chabeuil"
    ]
  },
