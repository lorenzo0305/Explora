  "rdfs:comment": {
    "de": [
      "Freie Besichtigung der Außenanlagen mit Informationstafel.\r\nRechteckiges Herrenhaus (15.-17. Jh.) mit zwei Pavillons, die im Winkel zueinander stehen und von runden Türmen umschlossen werden. ISMH."
    ],
    "en": [
      "Self-guided tour of the exterior, with information panel.\r\nRectangular manor house (15th-17th century) with two pavilions set at right-angles to each other and topped by round towers. ISMH."
    ],
    "it": [
      "Visita gratuita dell'esterno, con pannello informativo.\r\nCasa padronale rettangolare (XV-XVII secolo) con due padiglioni disposti ad angolo retto tra loro, con torri rotonde. ELENCO ISMH."
    ],
    "fr": [
      "Visite libre des extérieurs, avec panneau d'information. \r\nManoir rectangulaire (XVe-XVIIe) avec deux pavillons en retour d'équerre, anglés de tours rondes. ISMH."
    ],
    "es": [
      "Visita libre del exterior, con panel informativo.\r\nCasa solariega rectangular (s. XV-XVII) con dos pabellones perpendiculares entre sí y torres redondas. ISMH LISTED."
    ],
    "nl": [
      "Gratis bezoek aan de buitenkant, met informatiepaneel.\r\nRechthoekig herenhuis (15e-17e eeuw) met twee paviljoens die haaks op elkaar staan, met ronde torens. ISMH-LIJST."
    ]
  },
