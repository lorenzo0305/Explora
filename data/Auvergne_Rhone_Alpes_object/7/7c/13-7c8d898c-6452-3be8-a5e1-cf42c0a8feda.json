  "rdfs:comment": {
    "de": [
      "Entdecken Sie My Little Spa: Sauna, Hammam, Jacuzzi und Balneobereich für absolute Entspannung. Profitieren Sie auch von unseren Massageräumen, von denen einer speziell für Duos und Thai-Massagen eingerichtet wurde."
    ],
    "en": [
      "Discover My Little Spa: Sauna, hammam, jacuzzi and balneotherapy area for absolute relaxation. Take advantage of our massage rooms, including one dedicated to duos and Thai massage."
    ],
    "it": [
      "Scoprite la My Little Spa: sauna, hammam, jacuzzi e area balneoterapica per un relax assoluto. Approfittate delle nostre sale per i massaggi, tra cui una dedicata ai massaggi in coppia e al massaggio thailandese."
    ],
    "fr": [
      "Découvrez My Little Spa : Sauna, hammam, jacuzzi et espace balnéo pour une détente absolue. Profitez aussi de nos salles de massage, dont une dédiée aux duos et massage Thaï."
    ],
    "nl": [
      "Ontdek My Little Spa: Sauna, hammam, jacuzzi en balneoruimte voor absolute ontspanning. Profiteer van onze massageruimtes, waaronder een ruimte gewijd aan duo's en Thaise massage."
    ],
    "es": [
      "Descubra My Little Spa: sauna, hammam, jacuzzi y zona de balneoterapia para una relajación absoluta. También puede aprovechar nuestras salas de masajes, incluida una dedicada a los dúos y a los masajes tailandeses."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Espace bien-être - Family Center"
    ]
  },
