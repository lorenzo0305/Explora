  "rdfs:comment": {
    "de": [
      "Zimmer 6 mit Blick auf die Saône und die Berge von Lyon ist sehr angenehm, geräumig, hübsch dekoriert und ruhig."
    ],
    "en": [
      "Room 6, overlooking the Saône and the Monts du Lyonnais, is very pleasant, spacious, nicely decorated and quiet."
    ],
    "it": [
      "La camera 6, con vista sulla Saona e sui Monts du Lyonnais, è molto piacevole, spaziosa, ben arredata e tranquilla."
    ],
    "fr": [
      "La chambre 6, vue sur la Saône et les monts du Lyonnais est très agréable, spacieuse, joliment décorée et calme."
    ],
    "es": [
      "La habitación 6, con vistas al Saona y a los Montes del Lyonnais, es muy agradable, espaciosa, bellamente decorada y tranquila."
    ],
    "nl": [
      "Kamer 6, met uitzicht op de Saône en de Monts du Lyonnais, is zeer aangenaam, ruim, mooi ingericht en rustig."
    ]
