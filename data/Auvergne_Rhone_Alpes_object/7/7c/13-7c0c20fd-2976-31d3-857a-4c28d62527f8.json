  "rdfs:comment": {
    "de": [
      "Die „Ecole du Ski Français“ (ESF) von Villard-de-Lans ist ein Team von qualifizierten Skilehrern, die Ihnen gerne zu Diensten steht, ob Sie Anfänger oder Fortgeschrittener sind."
    ],
    "en": [
      "The French Ski School of Villard de Lans is a team of professionals at the service of beginners and experienced skiers."
    ],
    "it": [
      "La Scuola di sci francese di Villard de Lans è un team di professionisti al vostro servizio, sia che siate principianti o esperti."
    ],
    "fr": [
      "L'Ecole du Ski Français de Villard de Lans, c'est une équipe de professionnels qui se met à votre service, que vous soyez débutant ou skieur confirmé."
    ],
    "es": [
      "La Escuela de Esquí Francesa de Villard de Lans es un equipo de profesionales a su servicio, tanto si es un principiante como un esquiador experimentado."
    ],
    "nl": [
      "De Franse skischool Villard de Lans is een team van professionals dat tot uw dienst staat, of u nu een beginner of een ervaren skiër bent."
    ]
  },
