  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/ee00df91-025f-31b0-825a-97fc4dc396da",
      "dc:description": {
        "de": [
          "DANZA SALSA: \"La magie de danser\", bietet seinen Mitgliedern Kurse in lateinamerikanischen Tänzen (kubanische Salsa, Rumba, Tchatcha ) und einen monatlichen Bachata-Kurs, der für die Öffentlichkeit zugänglich ist."
        ],
        "en": [
          "DANZA SALSA: \"the magic of dancing\", offers its members Latin dance classes (Cuban salsa, rumba, tchatcha) and a monthly Bachata class open to the public."
        ],
        "it": [
          "DANZA SALSA: \"la magia del ballo\", offre ai suoi soci corsi di ballo latino (salsa cubana, rumba, tchatcha) e un corso mensile di Bachata aperto al pubblico."
        ],
        "fr": [
          "DANZA SALSA  : \"la magie de danser\", propose à ses adhérents,  des cours de danses latines (Salsa cubaine, rumba, tchatcha ) et un cours mensuel de Bachata ouvert au public."
        ],
        "es": [
          "DANZA SALSA: \"la magia del baile\", ofrece a sus socios clases de baile latino (salsa cubana, rumba, tchatcha) y una clase mensual de bachata abierta al público."
        ],
        "nl": [
          "DANZA SALSA: \"de magie van dansen\", biedt haar leden Latijnse danslessen (Cubaanse salsa, rumba, tchatcha) en een maandelijkse Bachata-les die open is voor het publiek."
        ]
      },
