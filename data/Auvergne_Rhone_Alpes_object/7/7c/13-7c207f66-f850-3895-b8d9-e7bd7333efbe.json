  "rdfs:comment": {
    "de": [
      "Im großen Saal des nordischen Chalets mit seinem sichtbaren Gebälk oder auf der Panoramaterrasse können Sie unsere traditionelle Küche aus lokalen und saisonalen Produkten genießen."
    ],
    "en": [
      "It is in the large hall of the Nordic chalet or on its panoramic terrace that you will  taste our traditional cooking made of local and seasonal products."
    ],
    "it": [
      "Potrete gustare la nostra cucina tradizionale a base di prodotti locali e stagionali nell'ampia sala dello chalet nordico con struttura a vista o sulla terrazza panoramica."
    ],
    "fr": [
      "C'est dans la grande salle du chalet nordique avec sa charpente apparente ou sur sa terrasse panoramique que vous pourrez déguster notre cuisine traditionnelle à base de produits locaux et de saison."
    ],
    "nl": [
      "U kunt genieten van onze traditionele keuken op basis van lokale en seizoensgebonden producten in de grote zaal van het Scandinavische chalet met zijn zichtbare raamwerk of op het panoramische terras."
    ],
    "es": [
      "Podrá disfrutar de nuestra cocina tradicional a base de productos locales y de temporada en el amplio salón del chalet nórdico con su armazón expuesto o en su terraza panorámica."
    ]
  },
  "rdfs:label": {
    "en": [
      "Restaurant \"L'Escale du Désert\""
    ],
    "fr": [
      "L'Escale du Désert"
    ]
  },
