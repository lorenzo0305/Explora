  "rdfs:comment": {
    "de": [
      "Bald 150 Jahre Tradition: Sie treten ein in die Welt der Aromen und der großen Produkte. Georges Blanc, der zu einem der besten Botschafter der französischen Gastronomie geworden ist, bietet eine Küche, die Traditionen neu interpretiert und mit hochwertigen Produkten verbindet."
    ],
    "en": [
      "At this establishment that is coming up to 150 years of tradition, you can expect an explosion of flavour and top-quality products. Georges Blanc has become one of France's most prestigious chefs, offering cuisine that blends tradition, originality and the best quality products."
    ],
    "it": [
      "Erede di 3 generazioni di cuochi, Georges Blanc è riuscito a valorizzare la regione della Bresse attraverso la sua cucina. Insignito di una stella Michelin dal 1929, vi invita a vivere una meravigliosa esperienza gastronomica."
    ],
    "fr": [
      "Héritier de 3 générations de Mères cuisinières, Georges Blanc a su mettre en valeur le terroir Bressan à travers sa cuisine. Étoilé Michelin depuis 1929, il vous invite à une merveilleuse expérience gastronomique."
    ],
    "es": [
      "Heredero de 3 generaciones de cocineros, Georges Blanc ha sabido poner de relieve la región de Bresse a través de su cocina. Galardonado con una estrella Michelin desde 1929, le invita a disfrutar de una maravillosa experiencia gastronómica."
    ],
    "nl": [
      "Als erfgenaam van 3 generaties koks is Georges Blanc erin geslaagd de Bresse-regio in de kijker te zetten met zijn keuken. Met een Michelin-ster sinds 1929 nodigt hij u uit voor een heerlijke gastronomische ervaring."
    ]
  },
  "rdfs:label": {
