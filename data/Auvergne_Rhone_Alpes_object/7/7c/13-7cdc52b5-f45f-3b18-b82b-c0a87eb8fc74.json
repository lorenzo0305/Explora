  "rdfs:comment": {
    "de": [
      "16 Uhr: Treffen mit Louise Pommeret, Autorin und Lehrerin in der Haute-Loire. Sie wird Auszüge aus ihrem Roman \"La vie fragile\" lesen.\r\n18 Uhr: Lesung des Schauspielers Laurent Soffiati mit Auszügen aus Maryline Desbiolles' Roman \"Anchise\", Femina 1999."
    ],
    "en": [
      "4pm: Meet Louise Pommeret, author and teacher in Haute-Loire. She will read extracts from her novel \"La vie fragile\".\r\n6pm: Actor Laurent Soffiati reads extracts from Maryline Desbiolles' novel \"Anchise\", Femina 1999."
    ],
    "it": [
      "ore 16.00: Incontro con Louise Pommeret, autrice e insegnante dell'Alta Loira. Leggerà alcuni brani del suo romanzo \"La vie fragile\".\r\nore 18.00: Lettura da parte dell'attore Laurent Soffiati di estratti del romanzo \"Anchise\" di Maryline Desbiolles, Femina 1999."
    ],
    "fr": [
      "16h : Rencontre avec Louise Pommeret, autrice et enseignante en Haute-Loire. Elle lira des extraits de son roman \"La vie fragile\". \r\n18h : Lecture par le comédien Laurent Soffiati d'extraits du roman de Maryline Desbiolles \"Anchise\", Femina 1999."
    ],
    "nl": [
      "16.00 uur: Ontmoeting met Louise Pommeret, schrijfster en lerares in de Haute-Loire. Ze zal fragmenten voorlezen uit haar roman \"La vie fragile\".\r\n18u: Lezing door acteur Laurent Soffiati van fragmenten uit de roman \"Anchise\" van Maryline Desbiolles, Femina 1999."
    ],
    "es": [
      "16.00 h: Encuentro con Louise Pommeret, escritora y profesora en Haute-Loire. Leerá extractos de su novela \"La vie fragile\".\r\n18.00 h: Lectura por el actor Laurent Soffiati de extractos de la novela \"Anchise\" de Maryline Desbiolles, Femina 1999."
    ]
  },
