  "rdfs:comment": {
    "de": [
      "Dorf Alleyras: Kleines Dorf mit Blick auf die Schluchten des Allier. In Pont d'Alleyras, Château de la Beaume aus dem 16. Jahrhundert (privat). Kirche aus dem 12. und 13."
    ],
    "en": [
      "Village of Alleyras: Small village overlooking the Allier gorges. At Pont d'Alleyras, 16th-century château de la Beaume (private). Twelfth- and thirteenth-century church."
    ],
    "it": [
      "Villaggio di Alleyras: piccolo villaggio affacciato sulle gole dell'Allier. A Pont d'Alleyras, castello della Beaume del XVI secolo (privato). Chiesa del XII e XIII secolo."
    ],
    "fr": [
      "Village de Alleyras : Petit village surplombant les gorges de l’Allier. À Pont d’Alleyras, château de la Beaume du XVIe siècle (privé). Église des XIIe et XIIIe siècles."
    ],
    "es": [
      "Pueblo de Alleyras: Pequeño pueblo con vistas a las gargantas del Allier. En Pont d'Alleyras, castillo de la Beaume del siglo XVI (privado). Iglesia de los siglos XII y XIII."
    ],
    "nl": [
      "Dorp Alleyras: Klein dorp met uitzicht op de kloven van de Allier. In Pont d'Alleyras, 16e-eeuws château de la Beaume (privé). Kerk uit de 12e en 13e eeuw."
    ]
  },
  "rdfs:label": {
