  "rdfs:comment": {
    "de": [
      "Das einzige Gebäude dieser Art in der Drôme. Sie ist rechteckig und besteht aus vier Schiffen mit je sieben Jochen. Die Pfosten tragen einen schönen Dachstuhl aus Eichenholz. Die Kirche soll aus dem 15."
    ],
    "en": [
      "The only building of this type in the Drôme. Rectangular in shape, it aligns 4 naves of 7 bays. The posts support a beautiful oak framework. It dates from the 15th century."
    ],
    "it": [
      "L'unico edificio di questo tipo nella Drôme. Di forma rettangolare, allinea 4 navate di 7 campate. I pali sostengono una bella struttura in rovere. Risale al XV secolo."
    ],
    "fr": [
      "Seul édifice de ce type dans la Drôme. De forme rectangulaire, elle aligne 4 nefs de 7 travées. Les poteaux supportent une belle charpente en chêne. Elle daterait du 15ème siècle."
    ],
    "nl": [
      "Het enige gebouw van dit type in de Drôme. Het is rechthoekig en heeft 4 schepen met elk 7 traveeën. De palen ondersteunen een mooie eiken dakstructuur. Het dateert uit de 15e eeuw."
    ],
    "es": [
      "El único edificio de este tipo en la Drôme. De forma rectangular, alinea 4 naves de 7 tramos. Los postes soportan un hermoso marco de roble. Data del siglo XV."
    ]
  },
