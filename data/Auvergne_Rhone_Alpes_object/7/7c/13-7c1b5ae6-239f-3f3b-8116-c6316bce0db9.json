  "rdfs:comment": {
    "de": [
      "Ein wunderschönes Restaurant mit Bar im Herzen von Chamonix. Hier können Sie eine traditionell inspirierte und zeitgenössische Küche genießen.\r\n\r\nEntdecken Sie unser Menü, das aus den unumgänglichen Gerichten wie Käsefondue, Tartiflette und hausgemachter Foie Gras besteht."
    ],
    "en": [
      "A magnificent restaurant and bar in the heart of Chamonix. Enjoy traditional and contemporary cuisine.\r\n\r\nDiscover our menu of must-tries such as cheese fondue, tartiflette and homemade foie gras."
    ],
    "it": [
      "Un magnifico ristorante e bar nel cuore di Chamonix. Gustate la cucina tradizionale e contemporanea.\r\n\r\nScoprite il nostro menu con specialità come la fonduta di formaggio, la tartiflette e il foie gras fatto in casa."
    ],
    "fr": [
      "Un magnifique restaurant et bar au coeur de Chamonix. Vous pourrez y déguster une cuisine d’inspiration traditionnelle et contemporaine.\n\nDécouvrez notre menu composé des incontournables tels que la fondue au fromage, tartiflette et foie gras maison."
    ],
    "es": [
      "Un magnífico restaurante y bar en el corazón de Chamonix. Disfrute de la cocina tradicional y contemporánea.\r\n\r\nDescubra nuestra carta con platos favoritos como la fondue de queso, la tartiflette y el foie gras casero."
    ],
    "nl": [
      "Een prachtig restaurant en bar in het hart van Chamonix. U kunt genieten van traditionele en hedendaagse gerechten.\n\nOntdek ons menu dat bestaat uit het essentiële zoals kaasfondue, tartiflette en huisgemaakte foie gras."
    ]
  },
