  "rdfs:comment": {
    "de": [
      "In mehreren Sektoren finden sich Routen von 10 m bis 35 m Länge, deren Schwierigkeitsgrad von 4A bis 8A+ reicht. Die allgemeine Ausrichtung des Felsens ist westlich. Der Fels ist stark zerklüftet und reagiert empfindlich auf Klimaschwankungen."
    ],
    "en": [
      "Rock climbing in free practise."
    ],
    "it": [
      "Diversi settori raccolgono percorsi da 10 m a 35 m, con livelli che vanno da 4A a 8A+. L'orientamento generale della roccia è verso ovest. Roccia molto fratturata e sensibile alle variazioni climatiche."
    ],
    "fr": [
      "Plusieurs secteurs rassemblent des voies de 10 m à 35 m, de niveaux allant de 4A au 8A+. L'orientation générale du rocher est ouest. Roche très fracturée sensible aux variations climatiques."
    ],
    "es": [
      "Varios sectores reúnen rutas de 10 m a 35 m, con niveles que van de 4A a 8A+. La orientación general de la roca es hacia el oeste. Roca muy fracturada y sensible a las variaciones climáticas."
    ],
    "nl": [
      "Klimmen rotsen in het vrije verkeer"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Rocher d'escalade - Rocher Charlemagne"
    ]
  },
