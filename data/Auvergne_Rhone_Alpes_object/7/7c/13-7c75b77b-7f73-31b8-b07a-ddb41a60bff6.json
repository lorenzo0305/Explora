  "rdfs:comment": {
    "de": [
      "Ein zertifizierter Bio-Garten mit ca. 30 aromatischen und medizinischen Pflanzen. Herstellung von Kräutertees, Kräutersalzen.\r\nBesichtigung des Gartens und des Trockenraums.\r\nBotanische Workshops für jedes Alter und jedes Publikum.\r\nVeranstaltungen."
    ],
    "en": [
      "A certified organic garden of some thirty aromatic and medicinal plants. Production of herbal infusions and salts.\r\nVisit the garden and drying room.\r\nBotanical workshops for all ages and all publics.\r\nEvents."
    ],
    "it": [
      "Un giardino biologico certificato con una trentina di piante aromatiche e medicinali. Produzione di infusi e sali alle erbe.\r\nVisita al giardino e all'essiccatoio.\r\nLaboratori botanici per tutte le età e tutti i pubblici.\r\nEventi."
    ],
    "fr": [
      "Un jardin certifié bio d'une trentaine de plantes aromatiques et médicinales. Fabrication d'infusions, sels aux herbes.\r\nVisite du jardin et du séchoir.\r\nAteliers botaniques tous âges, tous publics.\r\nÉvénementiel."
    ],
    "es": [
      "Huerto ecológico certificado con una treintena de plantas aromáticas y medicinales. Producción de infusiones y sales.\r\nVisita al huerto y al secadero.\r\nTalleres botánicos para todas las edades y todos los públicos.\r\nEventos."
    ],
    "nl": [
      "Een gecertificeerde biologische tuin met ongeveer dertig aromatische en geneeskrachtige planten. Productie van kruidenthee en kruidenzout.\r\nBezoek de tuin en de droogkamer.\r\nBotanische workshops voor alle leeftijden en alle soorten publiek.\r\nEvenementen."
    ]
  },
