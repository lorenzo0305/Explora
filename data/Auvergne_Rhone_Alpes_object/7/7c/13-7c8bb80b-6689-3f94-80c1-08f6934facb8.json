  "rdfs:comment": {
    "de": [
      "Les Paniers de Michelin bietet Ihnen eine Reihe von Körben, Übertöpfen und Körben aus Weidenruten an. Entdecken Sie sie vor allem auf den Märkten von Burzet am Montagabend in der Saison sowie in der Boutique \"le bocal des créateurs\" in Antraigues."
    ],
    "en": [
      "Les Paniers de Michelin offers a range of wicker baskets, pot covers and baskets. You can find them at the Burzet markets on Monday evenings in season and at the ‘le bocal des créateurs’ shop in Antraigues.."
    ],
    "it": [
      "Les Paniers de Michelin propone una gamma di cesti, fioriere e cestini in vimini. Si possono trovare nei mercati di Burzet il lunedì sera durante la stagione e nel negozio \"le bocal des créateurs\" di Antraigues."
    ],
    "fr": [
      "Les Paniers de Michelin vous proposent une gamme de paniers, caches-pots ou corbeilles en osier. Découvrez-les notamment sur les marchés de Burzet les lundis soir en saison ainsi qu'à la boutique \" le bocal des créateurs\" à Antraigues."
    ],
    "es": [
      "Les Paniers de Michelin ofrece una gama de cestas, jardineras y cestos de mimbre. Puede encontrarlos en los mercados de Burzet los lunes por la tarde durante la temporada, y en la tienda \"le bocal des créateurs\" de Antraigues."
    ],
    "nl": [
      "Les Paniers de Michelin biedt een assortiment rieten manden, plantenbakken en korven. Je vindt ze op de markten van Burzet op maandagavond tijdens het seizoen en in de winkel \"le bocal des créateurs\" in Antraigues."
    ]
  },
