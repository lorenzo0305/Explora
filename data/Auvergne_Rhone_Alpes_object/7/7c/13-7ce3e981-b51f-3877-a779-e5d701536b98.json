  "rdfs:comment": {
    "de": [
      "Anlässlich der Weihnachtsfeiertage 2026 bietet der Touristische Zug von Haut Forez, Kindern von 7 bis 77 Jahren und älter die Möglichkeit, sich an Bord seiner Weihnachtszüge auf die Suche nach dem Weihnachtsmann zu begeben."
    ],
    "en": [
      "For Christmas 2026, the Train touristique du Haut Forez is offering children aged 7 to 77 and over the chance to search for Santa Claus on board its Christmas trains."
    ],
    "it": [
      "Per il Natale 2026, il Train touristique du Haut Forez offre ai bambini dai 7 ai 77 anni e oltre la possibilità di cercare Babbo Natale a bordo dei suoi treni natalizi."
    ],
    "fr": [
      "A l'occasion des Fêtes de Noël 2026, le Train touristique du Haut Forez, propose aux enfants de 7 à 77 ans, et plus, de partir à la recherche du Père Noël à bord de ses trains de Noël."
    ],
    "nl": [
      "Voor Kerstmis 2026 biedt de Train touristique du Haut Forez kinderen van 7 tot 77 jaar en ouder de kans om de kerstman te zoeken aan boord van de kersttreinen."
    ],
    "es": [
      "Para la Navidad de 2026, el Train touristique du Haut Forez ofrece a los niños de 7 a 77 años o más la posibilidad de buscar a Papá Noel a bordo de sus trenes navideños."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Trains du Père Noël"
    ]
  },
