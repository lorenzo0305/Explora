  "rdfs:comment": {
    "de": [
      "Seine Lage sowie die herzliche Gastfreundschaft seiner Besitzer machen dieses sympathische Haus zu einer idealen Unterkunft für einen Geschäftsaufenthalt oder einen Zwischenstopp auf dem Weg in den Urlaub."
    ],
    "en": [
      "Its location as well as the warm welcome of its owners make this friendly establishment an ideal accommodation for a business stopover or a stopover on the way to your holidays."
    ],
    "it": [
      "La sua posizione e l'accoglienza calorosa dei proprietari rendono questa struttura accogliente ideale per una sosta di lavoro o per una sosta sulla strada verso la meta delle vostre vacanze."
    ],
    "fr": [
      "Son emplacement ainsi que l’accueil chaleureux de ses propriétaires font de ce sympathique établissement un hébergement idéal pour une étape affaires ou une halte sur la route des vacances."
    ],
    "es": [
      "Su ubicación y la cálida acogida de sus propietarios hacen que este acogedor establecimiento sea ideal para una escala de negocios o una parada de camino a su destino de vacaciones."
    ],
    "nl": [
      "De ligging en het warme onthaal van de eigenaars maken dit vriendelijke etablissement ideaal voor een zakenstop of een tussenstop op weg naar uw vakantiebestemming."
    ]
  },
  "rdfs:label": {
