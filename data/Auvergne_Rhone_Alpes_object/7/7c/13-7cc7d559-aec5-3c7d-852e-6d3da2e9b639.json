  "rdfs:comment": {
    "de": [
      "Alpes Aventures ist ein Team von Enthusiasten, die ihre Erfahrung in der Überwachung von konventionellen und elektrischen ATV in den Dienst ihrer Kunden stellt. Wir bieten Privatunterricht oder  Gruppen."
    ],
    "en": [
      "Alpes Aventures is a team of mountain bike enthusiasts, experienced both in conventional and e-bikes.  They offer a range of options – one-to-one lessons or group lessons."
    ],
    "it": [
      "Alpes Aventures è un team di appassionati che mette la propria esperienza di mountain bike classica ed elettrica al servizio dei propri clienti. Offriamo lezioni private e di gruppo."
    ],
    "fr": [
      "Alpes Aventures c’est une équipe de passionnés qui met au service de ses clients son expérience dans l’encadrement du VTT aussi bien classique qu’électrique. Nous proposons des cours particuliers ou collectifs."
    ],
    "nl": [
      "Alpes Aventures is een team van enthousiastelingen die hun ervaring met zowel klassiek als elektrisch mountainbiken ten dienste stellen van hun klanten. We bieden zowel privé- als groepslessen aan."
    ],
    "es": [
      "Alpes Aventures es un equipo de entusiastas que ponen su experiencia en bicicleta de montaña, tanto clásica como eléctrica, al servicio de sus clientes. Ofrecemos clases particulares y en grupo."
    ]
  },
