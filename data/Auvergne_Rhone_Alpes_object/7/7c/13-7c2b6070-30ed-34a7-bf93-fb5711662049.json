  "rdfs:comment": {
    "de": [
      "Die Straßen, die in den verschiedenen Jahrhunderten und mit unterschiedlichen Bezeichnungen durch das Gebiet dieser Gemeinde führten, brachten die Entwicklung mit sich."
    ],
    "en": [
      "The roads that have crossed the commune over the centuries and under various names have led to its development."
    ],
    "it": [
      "Le strade che hanno attraversato il comune nel corso dei secoli e con nomi diversi hanno portato al suo sviluppo."
    ],
    "fr": [
      "La traversée du territoire de cette commune par les routes aux divers siècles et aux diverses dénominations en a amené le développement."
    ],
    "es": [
      "Las carreteras que han atravesado el municipio a lo largo de los siglos y con diferentes nombres han propiciado su desarrollo."
    ],
    "nl": [
      "De wegen die de gemeente door de eeuwen heen en onder verschillende namen hebben doorkruist, hebben geleid tot haar ontwikkeling."
    ]
  },
