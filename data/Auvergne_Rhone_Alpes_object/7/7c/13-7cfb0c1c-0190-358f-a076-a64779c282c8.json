  "rdfs:comment": {
    "de": [
      "Laura und Alexis heißen Sie in einem Ambiente willkommen, das Modernität und Komfort vereint. Mit freundlichem und herzlichem Service und einer Küche, die sich an der Saison orientiert."
    ],
    "en": [
      "Laura and Alexis welcome you to a setting that combines modernity and comfort. With friendly, warm service and cuisine that respects seasonality."
    ],
    "it": [
      "Laura e Alexis vi accolgono in un ambiente che unisce modernità e comfort. Con un servizio caldo e cordiale e una cucina di stagione."
    ],
    "fr": [
      "Laura et Alexis vous accueillent dans un cadre alliant modernité et confort. Avec un service souriant et chaleureux et une cuisine respectant la saisonnalité."
    ],
    "es": [
      "Laura y Alexis le dan la bienvenida en un ambiente que combina modernidad y confort. Con un servicio cálido y amable y una cocina de temporada."
    ],
    "nl": [
      "Laura en Alexis verwelkomen je in een omgeving die moderniteit en comfort combineert. Met warme, vriendelijke service en seizoensgebonden gerechten."
    ]
  },
