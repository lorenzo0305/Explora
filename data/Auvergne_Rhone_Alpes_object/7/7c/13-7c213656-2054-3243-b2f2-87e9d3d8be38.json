  "rdfs:comment": {
    "de": [
      "Seien Sie herzlich willkommen in diesem privilegierten Schmuckkästchen, dem Prunkstück des Kulturerbes von St Martin d'Uriage, wo Begegnungen und Austausch rund um Kunst und Kultur in Form von Ausstellungen, Kino, Theater und Musik stattfinden."
    ],
    "en": [
      "Welcome to this privileged setting, a jewel in the heart of St Martin d'Uriage's heritage, where you can meet and share art and culture through exhibitions, cinema, theater and music."
    ],
    "it": [
      "Benvenuti in questo ambiente privilegiato, fiore all'occhiello del patrimonio di St Martin d'Uriage, dove potrete incontrare e condividere arte e cultura attraverso mostre, cinema, teatro e musica."
    ],
    "fr": [
      "Soyez les bienvenus dans cet écrin privilégié, fleuron du  patrimoine de St Martin d'Uriage, où se tissent rencontres et partages autour de l'art et de la culture autour d'expositions, de cinéma, de théâtre et de musique."
    ],
    "nl": [
      "Welkom in deze bevoorrechte omgeving, de kroon op het erfgoed van St Martin d'Uriage, waar u kunst en cultuur kunt ontmoeten en delen via tentoonstellingen, film, theater en muziek."
    ],
    "es": [
      "Bienvenido a este marco privilegiado, joya de la corona del patrimonio de St Martin d'Uriage, donde podrá conocer y compartir el arte y la cultura a través de exposiciones, cine, teatro y música."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Centre Culturel Jeannine Creissels - Le Belvédère"
    ]
  },
