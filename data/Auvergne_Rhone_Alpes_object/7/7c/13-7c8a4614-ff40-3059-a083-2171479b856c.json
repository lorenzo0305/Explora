  "rdfs:comment": {
    "de": [
      "Blauer Parcours: 2,7 km - 7 Posten.\r\nIm Wald von Saint-Urcize. Die Karte kann für 2? im Tourismusbüro von Saint-Urcize gekauft werden. Denken Sie daran, einen Kompass mitzunehmen."
    ],
    "en": [
      "Blue course: 2.7 Km - 7 stations.\r\nIn the Saint-Urcize forest. Map on sale for 2? at the Saint-Urcize tourist office. Remember to bring a compass."
    ],
    "it": [
      "Percorso blu: 2,7 km - 7 stazioni.\r\nNella foresta di Saint-Urcize. Mappa in vendita a 2 euro presso l'ufficio del turismo di Saint-Urcize. Ricordarsi di portare con sé una bussola."
    ],
    "fr": [
      "Parcours bleu : 2.7 Km - 7 postes.\r\nDans la forêt de Saint-Urcize. Carte en vente 2€ à l' office de tourisme de Saint-Urcize. Pensez à prendre une boussole."
    ],
    "es": [
      "Recorrido azul: 2,7 km - 7 estaciones.\r\nEn el bosque de Saint-Urcize. Mapa a la venta por 2? en la oficina de turismo de Saint-Urcize. No olvide llevar una brújula."
    ],
    "nl": [
      "Blauwe route: 2,7 km - 7 stations.\r\nIn het bos van Saint-Urcize. Kaart te koop voor 2? bij het toeristenbureau van Saint-Urcize. Vergeet niet een kompas mee te nemen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parcours d'orientation de St Urcize - vert 2.7kms"
    ]
  },
