  "rdfs:comment": {
    "de": [
      "Rémy zeigt Ihnen seine Arbeit vom rohen Holzbrett bis zur Herstellung eines Vornamens.\r\nTeesalon im Obergeschoss auf der Terrasse.\r\nEistee & hausgemachte Kuchen...."
    ],
    "en": [
      "Discover woodworking in Remy’s shop. From raw wood planks to the manufacture of a name."
    ],
    "it": [
      "Rémy vi mostrerà il suo lavoro, dalla tavola di legno grezza alla creazione di un nome di battesimo.\r\nSala da tè al piano superiore della terrazza\r\nTè freddo e torte fatte in casa...."
    ],
    "fr": [
      "Rémy vous fera découvrir son travail de la planche de bois brute à la fabrication d'un prénom.\r\nSalon de Thé à l'étage sur la terrasse\r\nThé glacé & gâteaux maison...."
    ],
    "es": [
      "Rémy le mostrará su trabajo, desde la tabla de madera en bruto hasta la creación de un nombre de pila.\r\nSalón de té en la terraza\r\nTé helado y pasteles caseros...."
    ],
    "nl": [
      "Rémy laat je zijn werk zien, van de ruwe plank hout tot de creatie van een voornaam.\r\nTheesalon boven op het terras\r\nIjsthee & huisgemaakte cakes...."
    ]
  },
