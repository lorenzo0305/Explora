  "rdfs:comment": {
    "de": [
      "Vorführung des Trüffelhöhlens mit meinem Hund Houra in einer Parzelle meiner Trüffelfelder. Sensorik-Workshop, Verkauf, Versand möglich."
    ],
    "en": [
      "Fabienne and Philippe welcome you and present their selection of fresh truffles (Tuber Melanosporum and Tuber Brumales) from the region of Richerenches and Saint-Restitut.\r\nSale, truffle hunting by appointment, product shipment possible."
    ],
    "it": [
      "Dimostrazione di scavo di tartufi con il mio cane Houra in una delle mie tartufaie. Laboratorio sensoriale, vendita, possibile spedizione."
    ],
    "fr": [
      "Démonstration de cavage de truffes avec mon chien Houra dans une parcelle de mes truffières. Atelier sensoriel, vente, expédition possible."
    ],
    "nl": [
      "Fabienne en Philippe ontvangen u graag om u hun selectie van verse truffel (Tuber Melanosporum en Tuber Brumales) te presenteren, afkomstig uit het gebied rond Richerenches en Saint-Restitut.\r\nVerkoop, truffels zoeken op afspraak, verzenden mogelijk."
    ],
    "es": [
      "Demostración de excavación de trufas con mi perro Houra en uno de mis campos de trufas. Taller sensorial, venta, posible envío."
    ]
  },
  "rdfs:label": {
