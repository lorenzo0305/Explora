  "rdfs:comment": {
    "de": [
      "Sie werden eine traditionelle Küche mit Inspirationen aus aller Welt entdecken, die mit frischen und möglichst lokalen Produkten schmackhaft ist und auf Authentizität setzt!\r\nMittags- und Abendservice mit einer wechselnden Schiefertafel voller Überraschungen."
    ],
    "en": [
      "You'll discover a traditional cuisine inspired by the world, tasty and made with the freshest, most local produce possible, with an emphasis on authenticity!\r\nLunch and dinner services with an ever-changing menu full of surprises"
    ],
    "it": [
      "Scoprirete una cucina tradizionale ispirata al mondo, gustosa con prodotti freschi e il più possibile locali, con un occhio di riguardo all'autenticità!\r\nServizio di pranzo e cena con un menu mutevole e ricco di sorprese"
    ],
    "fr": [
      "Vous allez découvrir une cuisine traditionnelle à inspirations du monde, savoureuse avec des produits frais et les plus locaux possible, privilégiant l’authenticité !\r\nServices midi et soir avec une ardoise évolutive et pleine de surprises"
    ],
    "nl": [
      "Je ontdekt een traditionele keuken geïnspireerd door de wereld, lekker met verse producten en zo lokaal mogelijk, met de nadruk op authenticiteit!\r\nLunch en diner met een wisselend menu vol verrassingen."
    ],
    "es": [
      "Descubrirá una cocina tradicional inspirada en el mundo, sabrosa con productos frescos y lo más local posible, ¡con un enfoque en la autenticidad!\r\nServicios de almuerzo y cena con un menú cambiante y lleno de sorpresas"
    ]
  },
  "rdfs:label": {
