  "rdfs:comment": {
    "de": [
      "Frauen, Männer, Kühe und Ziegen im Tal der Chartreuse.Wir laden Sie ein, unsere Käse- und Fleischproduktion zu entdecken."
    ],
    "en": [
      "Women, men, cows and goats in the Chartreuse valley. The ferme de Plantimay invites you to discover its cheese and meat production. Open tour all year during the opening hours of the shop."
    ],
    "it": [
      "Donne, uomini, mucche e capre nella valle della Chartreuse, vi invitiamo a scoprire la nostra produzione di formaggio e carne."
    ],
    "fr": [
      "Des femmes, des hommes, des vaches et des chèvres en vallée de Chartreuse.Nous vous invitons à découvrir notre production de fromages et de viande."
    ],
    "nl": [
      "Vrouwen, mannen, koeien en geiten in de vallei van de Chartreuse, wij nodigen u uit om onze kaas- en vleesproductie te ontdekken."
    ],
    "es": [
      "Mujeres, hombres, vacas y cabras en el valle de la Chartreuse, le invitamos a descubrir nuestra producción de queso y carne."
    ]
  },
