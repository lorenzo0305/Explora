  "rdfs:comment": {
    "de": [
      "Mit Liebe zubereitete, handgemachte Pizzen aus frischen und hochwertigen Zutaten! Wählen Sie aus unseren Klassikern oder lassen Sie sich von den aktuellen Sonderkreationen überraschen!"
    ],
    "en": [
      "Artisanal pizzas made with love and fresh, quality ingredients! Choose from our classics or be surprised by our special creations of the moment!"
    ],
    "it": [
      "Pizze fatte in casa con amore e ingredienti freschi e di qualità! Scegliete tra i nostri classici o lasciatevi sorprendere dalle nostre creazioni speciali del momento!"
    ],
    "fr": [
      "Des pizzas artisanales préparées avec amour, des ingrédients frais et de qualité ! Choisissez parmi nos classiques ou laissez-vous surprendre par les créations spéciales du moment !"
    ],
    "es": [
      "¡Pizzas caseras hechas con amor e ingredientes frescos y de calidad! ¡Elige entre nuestros clásicos o déjate sorprender por nuestras creaciones especiales del momento!"
