  "rdfs:comment": {
    "de": [
      "Laden mit Lebensmitteln aus der Region und herkömmlichen Lebensmitteln. Gemütliches Multiservice-Geschäft in Saint-Front mit einer Mischung aus lokalen und regionalen Produkten, Brot, Wurstwaren und Souvenirs. Ein geselliger Ort, den Sie bei einem Glas auf der Terrasse entdecken können."
    ],
    "en": [
      "Boutique with local and conventional groceries. Cosy multi-service shop in Saint-Front, combining local and terroir products, bread, delicatessen and souvenirs. A convivial space to discover over a drink on the terrace."
    ],
    "it": [
      "Negozio di prodotti alimentari locali e convenzionali. Un accogliente negozio unico a Saint-Front, che combina prodotti locali e regionali, pane, salumi e souvenir. Un luogo accogliente dove sorseggiare un drink in terrazza."
    ],
    "fr": [
      "Boutique avec épicerie du terroir et épicerie conventionnelle. Commerce multiservice chaleureux à Saint-Front, mêlant produits locaux et du terroir, pain, charcuterie et souvenirs. Un espace convivial à découvrir autour d’un verre en terrasse."
    ],
    "nl": [
      "Winkel met lokale en conventionele kruidenierswaren. Een gezellige one-stop shop in Saint-Front, met lokale en regionale producten, brood, vleeswaren en souvenirs. Een gezellige plek om iets te drinken op het terras."
    ],
    "es": [
      "Tienda de comestibles locales y convencionales. Una acogedora ventanilla única en Saint-Front, que combina productos locales y regionales, pan, charcutería y souvenirs. Un lugar acogedor para disfrutar de una copa en la terraza."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Au petit baz’AR"
    ]
  },
