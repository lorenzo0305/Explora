  "rdfs:comment": {
    "de": [
      "Von Freiwilligen geleitete Gemeindebibliothek, die Kindergarten- und Grundschulklassen sowie Kindergärtnerinnen mit ihren Kleinkindern empfängt."
    ],
    "en": [
      "Municipal library run by volunteers who welcome nursery and elementary school classes, as well as nursery assistants with their little ones."
    ],
    "it": [
      "La biblioteca comunale è gestita da volontari che accolgono le classi della scuola materna ed elementare, nonché le assistenti del nido con i loro piccoli."
    ],
    "fr": [
      "Bibliothèque municipale gérée par des bénévoles qui accueillent les classes des écoles maternelles et primaires ainsi que les assistantes maternelles avec les touts petits."
    ],
    "es": [
      "La biblioteca municipal está atendida por voluntarios que acogen a clases de guardería y primaria, así como a auxiliares de guardería con sus pequeños."
    ],
    "nl": [
      "De gemeentelijke bibliotheek wordt gerund door vrijwilligers die kleuter- en lagere schoolklassen verwelkomen, evenals kleuterleidsters met hun kleintjes."
