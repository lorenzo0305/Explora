  "rdfs:comment": {
    "de": [
      "Traditionelle hausgemachte Küche. Restaurant/ Brasserie/ Teestube. Burger, Omelettes, Salate, hausgemachtes Gebäck, Gegrilltes, gemischte Salate. Cidre und Wein im Glas. Frühstück und Brunch."
    ],
    "en": [
      "Traditional home cooking. Restaurant/ brasserie/ tearoom. Burgers, omelettes, salads, home-made pastries, grilled meats, mixed salads. Cider and wine by the glass. Breakfast and brunch."
    ],
    "it": [
      "Cucina casalinga tradizionale. Ristorante/ brasserie/ sala da tè. Hamburger, omelette, insalate, dolci fatti in casa, carni alla griglia, insalate miste. Sidro e vino al bicchiere. Colazione e brunch."
    ],
    "fr": [
      "Cuisine traditionnelle maison. Restaurant/ brasserie/ salon de thé. Burgers, omelettes, salades, pâtisseries maison, grillades, salades composées. Cidre et vin au verre. Petit déjeuner et brunch."
    ],
    "nl": [
      "Traditionele thuiskeuken. Restaurant/ brasserie/ tearoom. Burgers, omeletten, salades, huisgemaakt gebak, gegrild vlees, gemengde salades. Cider en wijn per glas. Ontbijt en brunch."
    ],
    "es": [
      "Cocina casera tradicional. Restaurante/brasserie/salón de té. Hamburguesas, tortillas, ensaladas, repostería casera, carnes a la brasa, ensaladas variadas. Sidra y vino por copas. Desayuno y brunch."
    ]
  },
