  "rdfs:comment": {
    "de": [
      "Bis zum 29. März 2026 werden in den Galeries des Expositions de Vichy die Bilder von Pierre-Adrien Sollier zu sehen sein, einem Maler, der berühmte Gemälde verfremdet, indem er... Playmobil® einsetzt!"
    ],
    "en": [
      "Until March 29, 2026, Vichy's Galeries des Expositions will host paintings by Pierre-Adrien Sollier, a painter who transforms famous paintings by inlaying them with... Playmobil®!"
    ],
    "it": [
      "Fino al 29 marzo 2026, le Galeries des Expositions di Vichy esporranno i quadri di Pierre-Adrien Sollier, un pittore che ha stravolto quadri famosi intarsiandoli con... Playmobil®!"
    ],
    "fr": [
      "Jusqu'au 29 mars 2026, les Galeries des Expositions de Vichy accueilleront les tableaux de Pierre-Adrien Sollier, peintre qui détourne de célèbres tableaux en y incrustant... des Playmobil® !"
    ],
    "nl": [
      "Tot 29 maart 2026 zullen in de Galeries des Expositions in Vichy schilderijen te zien zijn van Pierre-Adrien Sollier, een schilder die beroemde schilderijen op hun kop zet door ze in te leggen met... Playmobil®!"
    ],
    "es": [
      "Hasta el 29 de marzo de 2026, las Galeries des Expositions de Vichy expondrán cuadros de Pierre-Adrien Sollier, un pintor que da la vuelta a cuadros famosos incrustándoles... ¡Jugmobil®!"
    ]
  },
  "rdfs:label": {
    "fr": [
