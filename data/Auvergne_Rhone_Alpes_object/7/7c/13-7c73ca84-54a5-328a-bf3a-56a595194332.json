  "rdfs:comment": {
    "de": [
      "Geführte Besichtigung durch das Fremdenverkehrsamt oder freie Besichtigung mit Dokument zum Herunterladen auf www.montlucon-tourisme.fr (erhältlich im Fremdenverkehrsamt). Am Fuße des herzoglichen Schlosses bieten die engen Gassen der mittelalterlichen Stadt einen friedlichen Spaziergang."
    ],
    "en": [
      "Guided tour by the tourist office or self-guided tour with downloadable document at www.montlucon-tourisme.fr (available from the tourist office). At the foot of the ducal castle, the narrow streets of the medieval town offer a peaceful stroll."
    ],
    "it": [
      "Visita guidata dall'ufficio turistico o visita autogestita con documento scaricabile dal sito www.montlucon-tourisme.fr (disponibile presso l'ufficio turistico). Ai piedi del castello ducale, le stradine della città medievale offrono una passeggiata tranquilla."
    ],
    "fr": [
      "Visite guidée par l'office de tourisme ou visite libre avec document en téléchargement sur www.montlucon-tourisme.fr (disponible à l'office de tourisme). Au pied du château ducal, les ruelles étroites de la cité médiévale offrent une balade paisible."
    ],
    "es": [
      "Visita guiada por la oficina de turismo o autoguiada con documento descargable en www.montlucon-tourisme.fr (disponible en la oficina de turismo). A los pies del castillo ducal, las callejuelas de la ciudad medieval invitan a pasear tranquilamente."
    ],
    "nl": [
      "Rondleiding door het VVV-kantoor of zelf rondleiding met downloadbaar document op www.montlucon-tourisme.fr (verkrijgbaar bij het VVV-kantoor). Aan de voet van het hertogelijke kasteel zorgen de smalle straatjes van de middeleeuwse stad voor een rustige wandeling."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Cité médiévale de Montluçon"
    ]
  },
