  "rdfs:comment": {
    "de": [
      "Die Mediathek ist ein Ort der Geselligkeit und Entspannung und bietet Ihnen 5 Bereiche: Jugend- und Erwachsenenbereich, Multimedia, Musik/Kino und Aktuelles.\r\nDie Konsultation vor Ort ist frei und kostenlos"
    ],
    "en": [
      "Everyone is welcome at the inter-communal media library, with free access  to the three separate areas (1400 m²) : one space dedicated totally to activiities and events, including youth area, music and film area and a multi-media area."
    ],
    "it": [
      "Luogo di convivialità e relax, la mediateca vi accoglie in 5 aree: settore giovanile, adulti, multimedia, musica/cinema e notizie.\r\nLa consulenza in loco è gratuita"
    ],
    "fr": [
      "Lieu de convivialité et des détente, la médiathèque vous accueille au sein de 5 espaces : secteur jeunesse, adulte, multimédia, musique/cinéma et actualité.\r\nLa consultation sur place est libre et gratuite"
    ],
    "es": [
      "Lugar de convivencia y relajación, la mediateca le acoge en 5 áreas: sector juvenil, adultos, multimedia, música/cine y noticias.\r\nLa consulta in situ es gratuita"
    ],
    "nl": [
      "Als plaats van gezelligheid en ontspanning ontvangt de mediatheek u in 5 domeinen: jeugd, volwassenen, multimedia, muziek/bioscoop en nieuws.\r\nDe raadpleging ter plaatse is gratis"
    ]
  },
