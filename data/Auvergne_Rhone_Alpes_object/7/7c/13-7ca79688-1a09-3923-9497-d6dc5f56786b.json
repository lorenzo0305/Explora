  "rdfs:comment": {
    "de": [
      "Handwerksbrauerei, die ein Dutzend verschiedene biologische und lokale Biere anbietet. Der Laden ist unter der Woche ab dem späten Nachmittag geöffnet. Vollständige Besichtigungen und Verkostungen sind nach Vereinbarung möglich. Touristenunterkunft auf dem Gelände. Label Nature et Progrès."
    ],
    "en": [
      "Craft brewery offering a dozen different organic and local beers. The store is open late afternoon on weekdays. Full tours and tastings by appointment."
    ],
    "it": [
      "Birrificio artigianale che offre una dozzina di birre biologiche e locali. Il negozio è aperto nel tardo pomeriggio dei giorni feriali. Visite e degustazioni complete su appuntamento. Alloggio turistico in loco. Marchio Nature et Progrès."
    ],
    "fr": [
      "Brasserie artisanale proposant une douzaines de bières biologiques et locales différentes. Le magasin est ouvert en fin d'après-midi en semaine. Possibilité de visites complètes et dégustations sur rdv. Gîte touristique sur place. Label Nature et Progrès."
    ],
    "es": [
      "Cervecería artesanal que ofrece una docena de cervezas ecológicas y locales diferentes. La tienda abre a última hora de la tarde los días laborables. Visitas guiadas y degustaciones con cita previa. Alojamiento turístico in situ. Etiqueta Nature et Progrès."
    ],
    "nl": [
      "Ambachtelijke brouwerij met een dozijn verschillende biologische en lokale bieren. De winkel is doordeweeks laat in de middag geopend. Volledige rondleidingen en proeverijen op afspraak. Toeristische accommodatie ter plaatse. Label Nature et Progrès."
    ]
  },
