  "rdfs:comment": {
    "de": [
      "L?Étape, bietet Ihnen eine schmackhafte und großzügige Küche: Rotisserie, hausgemachte Burger, Sandwiches, handgemachte Pizzas und Tagesgerichte, die von der ganzen Welt inspiriert sind. Frische Produkte, freundliche Atmosphäre und schneller Service. Zum Genießen vor Ort oder zum Mitnehmen!"
    ],
    "en": [
      "L'Étape, a snack pizzeria in Valmorel, offers you tasty and generous cuisine: rotisserie, homemade burgers, sandwiches, home-made pizzas and daily specials inspired by dishes from all over the world. Fresh produce, a friendly atmosphere and fast service. To eat in or take away!"
    ],
    "it": [
      "L'Étape offre una cucina generosa e saporita, che comprende piatti di rosticceria, hamburger fatti in casa, panini, pizze fatte in casa e specialità giornaliere ispirate a piatti di tutto il mondo. Prodotti freschi, atmosfera accogliente e servizio veloce. Da mangiare o da portare via!"
    ],
    "fr": [
      "L’Étape, vous propose une cuisine savoureuse et généreuse : rôtisserie, burgers maison, sandwiches, pizzas artisanales et plats du jour inspirés du monde entier. Produits frais, ambiance conviviale et service rapide. À déguster sur place ou à emporter !"
    ],
    "nl": [
      "L'Étape, a snack pizzeria in Valmorel, offers you tasty and generous cuisine: rotisserie, homemade burgers, sandwiches, home-made pizzas and daily specials inspired by dishes from all over the world. Fresh produce, a friendly atmosphere and fast service. To eat in or take away!"
    ],
    "es": [
      "L'Étape ofrece una cocina generosa y sabrosa, que incluye platos asados, hamburguesas caseras, sándwiches, pizzas caseras y platos del día inspirados en platos de todo el mundo. Productos frescos, ambiente agradable y servicio rápido. Para comer en el restaurante o para llevar"
    ]
  },
