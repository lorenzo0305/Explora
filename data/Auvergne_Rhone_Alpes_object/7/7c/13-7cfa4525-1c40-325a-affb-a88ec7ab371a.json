  "rdfs:comment": {
    "de": [
      "Im Herzen des nordischen Skigebiets von Herbouilly empfängt die Auberge de Roybon Skifahrer und Wanderer. Genießen Sie traditionelle Küche und Gerichte aus aller Welt in einer idyllischen Umgebung im Wald."
    ],
    "en": [
      "In the heart of the Herbouilly Nordic area, the Auberge de Roybon welcomes skiers and hikers. Enjoy traditional cuisine and dishes from around the world in an idyllic forest setting."
    ],
    "it": [
      "Nel cuore dell'area nordica di Herbouilly, l'Auberge de Roybon accoglie sciatori ed escursionisti e propone una cucina tradizionale e piatti del mondo in un ambiente idilliaco nella foresta."
    ],
    "fr": [
      "Au cœur de l'espace nordique d'Herbouilly, l'Auberge de Roybon accueille les skieurs et les randonneurs, Dégustez une cuisine traditionnelle et des plats du monde dans un cadre idyllique en forêt."
    ],
    "es": [
      "En el corazón de la zona nórdica de Herbouilly, el Auberge de Roybon acoge a esquiadores y excursionistas. Disfrute de la cocina tradicional y de platos del mundo en un idílico entorno forestal."
    ],
    "nl": [
      "De Auberge de Roybon ligt in het hart van het Nordic gebied van Herbouilly en verwelkomt skiërs en wandelaars. Geniet van de traditionele keuken en wereldgerechten in een idyllische bosrijke omgeving."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Auberge - refuge de Roybon"
    ]
  },
