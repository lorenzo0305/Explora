  "rdfs:comment": {
    "de": [
      "Die Brasserie du Slalom ist eine handwerkliche Brauerei, die zu 100 % biologisch braut!\r\n \r\nEntdecken Sie das gesamte Sortiment, das vollständig in Vercors-Drôme mit lokalen Malzsorten gebraut wird!\r\n\r\nDirektverkauf an die Öffentlichkeit, Drive-In-Service rund um die Uhr."
    ],
    "en": [
      "Brasserie du Slalom is a 100% organic craft brewery!\r\n \r\nDiscover the full range, brewed entirely in Vercors-Drôme with local malts!\r\n\r\nDirect sales to the public, 24-hour drive service."
    ],
    "it": [
      "La Brasserie du Slalom è un birrificio artigianale che produce birra al 100% biologica!\r\n \r\nScoprite l'intera gamma, prodotta interamente nella regione del Vercors-Drôme con malti locali!\r\n\r\nVendita diretta al pubblico, servizio drive 24 ore su 24."
    ],
    "fr": [
      "La Brasserie du Slalom est une brasserie artisanale qui brasse 100% en bio !\r\n \r\nDécouvrez toute la gamme, intégralement brassée en Vercors-Drôme avec des malts locaux !\r\n\r\nVente directe au public, service drive 24h/24h."
    ],
    "nl": [
      "La Brasserie du Slalom is een ambachtelijke brouwerij die 100% biologisch brouwt!\r\n \r\nOntdek het hele gamma, volledig gebrouwen in de streek Vercors-Drôme met lokale moutsoorten!\r\n\r\nDirecte verkoop aan het publiek, 24-uurs service."
    ],
    "es": [
      "La Brasserie du Slalom es una cervecería artesanal 100% ecológica\r\n \r\nDescubra toda la gama, elaborada íntegramente en la región de Vercors-Drôme con maltas locales\r\n\r\nVenta directa al público, servicio en coche las 24 horas."
    ]
  },
