  "rdfs:comment": {
    "de": [
      "Unabhängige Familienbrauerei, die 17 verschiedene Biersorten braut, die in Bars, Restaurants, Weinkellern, Feinkostläden und lokal in Supermärkten vertrieben werden. Vor kurzem kam eine Reihe von 4 Limonaden (Zitrone, Kaktus, grüner Apfel, Vichy-Pastillen) und eine Cola hinzu."
    ],
    "en": [
      "Independent family brewery, brewing 17 types of beer distributed in bars, restaurants, cellars, delicatessens and locally in supermarkets. Recently added a range of 4 lemonades (lemon, cactus, green apple, Vichy pastilles) and a cola."
    ],
    "it": [
      "Birrificio indipendente a conduzione familiare, produce 17 tipi di birra distribuiti in bar, ristoranti, cantine, gastronomie e localmente nei supermercati. Recentemente ha aggiunto una gamma di 4 limonate (limone, cactus, mela verde, pastiglie di Vichy) e una cola."
    ],
    "fr": [
      "Brasserie familiale indépendante, brassant 17 sortes de bières distribuées dans les bars, restaurants, caves, épiceries fines et localement en GMS. Ajoutant récemment une gamme de 4 limonades (citron, cactus, pomme verte, pastilles Vichy) et un cola."
    ],
    "nl": [
      "Onafhankelijke familiebrouwerij, brouwt 17 soorten bier die worden gedistribueerd in bars, restaurants, kelders, delicatessenwinkels en lokaal in supermarkten. Sinds kort heeft het een assortiment van 4 limonades (citroen, cactus, groene appel, Vichy pastilles) en een cola."
    ],
    "es": [
      "Cervecería familiar independiente que fabrica 17 tipos de cerveza distribuidos en bares, restaurantes, bodegas, tiendas de delicatessen y, localmente, en supermercados. Recientemente ha añadido una gama de 4 limonadas (limón, cactus, manzana verde, pastillas de Vichy) y un refresco de cola."
    ]
  },
  "rdfs:label": {
