  "rdfs:comment": {
    "de": [
      "Züchter von Schweinen und Schafen\r\nVerkauf ab Hof: traditionelles Schweinefleisch und Wurstwaren sowie Schaffleisch (rufen Sie an, bevor Sie vorbeikommen)\r\nAuf den Märkten von Saugues , Langeac und Issoire vertreten\r\nVerkaufsstellen in Saugues: Boutique Borde , Jardins du Gévaudan"
    ],
    "en": [
      "Pork and sheep farmer\r\nOn-farm sales: traditional pork and sheep meat and charcuterie (call before you come)\r\nPresent at markets in Saugues , Langeac and Issoire\r\nSales outlets in Saugues: Boutique Borde , Jardins du Gévaudan"
    ],
    "it": [
      "Allevatore di suini e ovini\r\nVendita in fattoria: carne tradizionale di maiale e di pecora e salumi (telefonare prima di venire)\r\nPresente nei mercati di Saugues, Langeac e Issoire\r\nPunti vendita a Saugues: Boutique Borde , Jardins du Gévaudan"
    ],
    "fr": [
      "Éleveur de porcs et d'ovins \r\nVente à la ferme : viande et charcuterie traditionnelle de porc et viande ovine (appeler avant de passer)\r\nPrésent sur les marchés de Saugues , Langeac et Issoire\r\nPoints de vente à Saugues : Boutique Borde , Jardins du Gévaudan"
    ],
    "nl": [
      "Varkens- en schapenboer\r\nVerkoop op de boerderij: ambachtelijk varkens- en schapenvlees en vleeswaren (bel voordat je komt)\r\nAanwezig op markten in Saugues, Langeac en Issoire\r\nVerkooppunten in Saugues: Boutique Borde , Jardins du Gévaudan"
    ],
    "es": [
      "Ganadero de porcino y ovino\r\nVenta en granja: charcutería y carne tradicional de cerdo y oveja (llamar antes de venir)\r\nPresente en los mercados de Saugues, Langeac e Issoire\r\nPuntos de venta en Saugues: Boutique Borde , Jardins du Gévaudan"
    ]
  },
