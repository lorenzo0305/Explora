  "rdfs:comment": {
    "de": [
      "Fleisch und Pökelfleisch aus französischer Zucht in unserer Produktionsstätte. Laden, in dem unsere Produkte verkauft werden, ergänzt durch regionale Produkte, die auf kurzen Wegen hergestellt werden."
    ],
    "en": [
      "Meat and cured meats from French livestock raised in our own workshop. A store where you can buy our products, with a selection of regional products, all part of a short distribution chain."
    ],
    "it": [
      "Carni e salumi provenienti da bestiame francese allevato nel nostro laboratorio. Un negozio dove è possibile acquistare i nostri prodotti, insieme a quelli regionali che fanno parte della filiera corta."
    ],
    "fr": [
      "Viandes et Salaisons issues de l'élevage Français auprès de notre atelier de fabrication. Magasin de vente de nos produits, agrémenté de produits régionaux dont la démarche s'inscrit dans les circuits courts."
    ],
    "nl": [
      "Vlees en vleeswaren van Frans vee dat in onze eigen werkplaats wordt gekweekt. Een winkel waar je onze producten kunt kopen, samen met regionale producten van korte distributiekanalen."
    ],
    "es": [
      "Carnes y embutidos de ganado francés criado en nuestro propio obrador. Una tienda donde podrá comprar nuestros productos, junto con productos regionales que forman parte de la cadena de distribución corta."
    ]
  },
  "rdfs:label": {
    "en": [
      "'Diois Salaisons' Local Produce Shop"
    ],
    "fr": [
      "Diois Salaisons"
    ]
  },
