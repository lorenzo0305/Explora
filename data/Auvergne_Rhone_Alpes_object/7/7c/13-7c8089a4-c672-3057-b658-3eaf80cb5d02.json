  "rdfs:comment": {
    "de": [
      "SaintPalou ChezMag bietet Ihnen hausgemachte Pizzas zum Mitnehmen am Montag-, Dienstag-, Freitag- und Samstagabend. Mittagsformel nur unter der Woche. Gerichte zum Mitnehmen sind möglich."
    ],
    "en": [
      "SaintPalou ChezMag offers home-made pizzas to take away on Monday, Tuesday, Friday and Saturday evenings. Weekday lunchtime menus only. Takeaway available."
    ],
    "it": [
      "SaintPalou ChezMag offre pizze fatte in casa da asporto il lunedì, martedì, venerdì e sabato sera. Menu per il pranzo solo nei giorni feriali. Possibilità di asporto."
    ],
    "fr": [
      "SaintPalou ChezMag vous propose des pizzas maison, à emporter le lundi, mardi, vendredi et samedi soir. Formule du midi uniquement en semaine. Plat à emporter possible."
    ],
    "es": [
      "SaintPalou ChezMag ofrece pizzas caseras para llevar los lunes, martes, viernes y sábados por la noche. Menú de mediodía sólo entre semana. Comida para llevar."
    ],
    "nl": [
      "SaintPalou ChezMag biedt huisgemaakte pizza's om mee te nemen op maandag-, dinsdag-, vrijdag- en zaterdagavond. Lunchtijdmenu alleen op weekdagen. Afhaalmaaltijden beschikbaar."
    ]
  },
