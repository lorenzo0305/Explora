  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/73962c16-0ed2-3e6f-a6ef-7ca15f92c30d",
      "dc:description": {
        "de": [
          "Informationen :\n\nProdukte: Brot und Gebäck\nSpezialität: Macarons\n\nTage der Öffnung:\n\nMontag bis Samstag von 7:15 bis 14:00 Uhr\n\nSonntag geschlossen\n \n Abholung :\n\nZum Mitnehmen während der Ladenöffnungszeiten\n\nBestellung :\n\nTelefonische Bestellung unter 03 21 51 38 10 möglich\n\n "
        ],
        "en": [
          "Information :\n\nProducts: breads and pastries\nSpecialty: macaroons\n\nOpening days:\n\nMonday to Saturday, 7.15am to 2pm\n\nClosed on Sunday\n \n Pick-up:\n\nTakeaway during store opening hours\n\nHow to order:\n\nOrder by phone 03 21 51 38 10\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nProdotti: pane e pasticceria\nSpecialità: amaretti\n\nGiorni di apertura:\n\nDa lunedì a sabato dalle 7.15 alle 14.00\n\nChiuso la domenica\n \n Ritiro:\n\nDa asporto durante gli orari di apertura del negozio\n\nCome ordinare :\n\nSi può ordinare per telefono al numero 03 21 51 38 10\n\n "
        ],
        "fr": [
          "Informations :\n\nProduits : pains et pâtisseries\nSpécialité: macarons\n\nJours d'ouverture:\n\nDu lundi au samedi de 7h15 à 14h\n\nFermeture le dimanche\n \n Retrait :\n\nÀ emporter aux horaires d'ouverture du magasin\n\nCommande :\n\nPossibilité de commander par téléphone au 03 21 51 38 10\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nProducten: brood en gebak\nSpecialiteit: bitterkoekjes\n\nOpeningsdagen:\n\nMaandag t/m zaterdag van 7.15 tot 14.00 uur\n\nZondag gesloten\n \n Ophalen:\n\nAfhalen tijdens openingstijden winkel\n\nHoe te bestellen :\n\nU kunt telefonisch bestellen op 03 21 51 38 10\n\n "
        ],
        "es": [
          "Más información :\n\nProductos: pan y bollería\nEspecialidad: macarrones\n\nDías de apertura:\n\nDe lunes a sábado de 7h15 a 14h00\n\nDomingos cerrado\n \n Recogida:\n\nPara llevar durante el horario de apertura de la tienda\n\nCómo hacer un pedido :\n\nPuede hacer su pedido por teléfono llamando al 03 21 51 38 10\n\n "
        ]
      },
