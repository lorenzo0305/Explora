  "rdfs:comment": {
    "de": [
      "Freier Tag in Turin, einer italienischen Stadt, die für ihr Kulturerbe und ihre Gastronomie bekannt ist.\r\nAbfahrt um 6:32 Uhr in La Chal, Office de Tourisme und um 6:35 Uhr an der Kreuzung in Les Chambons.\r\nRückkehr gegen 19 Uhr.\r\nAnmeldung unter www.trans-alpes.com oder im Tourismusbüro."
    ],
    "en": [
      "Free day in Turin, Italian city known for its heritage and gastronomy.\r\nDepartures at 6:32 am at La Chal, Tourist Office and at 6:35 am at the crossroads of Les Chambons.\r\nReturn around 7 PM.\r\nRegistration on www.trans-alpes.com or at the tourist office."
    ],
    "it": [
      "Giornata libera a Torino, città italiana rinomata per il suo patrimonio e la sua gastronomia.\r\nPartenza alle 6.32 da La Chal, Ufficio del Turismo e alle 6.35 dall'incrocio di Chambons.\r\nRitorno verso le 19.00.\r\nIscrizioni su www.trans-alpes.com o presso l'Ufficio del Turismo."
    ],
    "fr": [
      "Journée libre à Turin, ville italienne connue pour son patrimoine et sa gastronomie.\r\nDéparts à 6h32 à La Chal, Office de Tourisme et à 6h35 au croisement des Chambons.\r\nRetour vers 19h.\r\nInscription sur www.trans-alpes.com ou en Office de Tourisme."
    ],
    "nl": [
      "Vrije dag in Turijn, Italiaanse stad die bekend staat om zijn erfgoed en gastronomie.\r\nVertrek om 6.32 uur in La Chal, VVV en om 6.35 uur op het kruispunt van Les Chambons.\r\nKeer rond 19.00 uur terug.\r\nRegistratie op www.trans-alpes.com of op VVV kantoor."
    ],
    "es": [
      "Día libre en Turín, ciudad italiana famosa por su patrimonio y su gastronomía.\r\nSalidas a las 6.32 h desde La Chal, Oficina de Turismo, y a las 6.35 h desde el cruce de Chambons.\r\nRegreso hacia las 19 h.\r\nInscripciones en www.trans-alpes.com o en la Oficina de Turismo."
    ]
  },
