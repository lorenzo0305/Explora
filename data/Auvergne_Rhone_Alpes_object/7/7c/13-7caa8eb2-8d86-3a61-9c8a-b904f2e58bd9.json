  "rdfs:comment": {
    "de": [
      "Wir stellen Pizzas zum Mitnehmen her, die aus frischen und qualitativ hochwertigen Produkten hergestellt werden. Unser Team hat eine Leidenschaft für die italienische Küche und bemüht sich, Ihnen ein unvergessliches kulinarisches Erlebnis zu bieten."
    ],
    "en": [
      "Take away pizza, with fresh and quality produces. The team is trully passionated by italian food and offers you a remarquable experience !"
    ],
    "it": [
      "Prepariamo pizze da asporto con ingredienti freschi e di qualità. Il nostro team è appassionato di cucina italiana e si impegna per offrirvi un'esperienza culinaria indimenticabile."
    ],
    "fr": [
      "Nous réalisons des pizzas à emporter, avec des produits frais et de qualité. Notre équipe est passionnée par la cuisine italienne et s'efforce de vous offrir une expérience culinaire inoubliable."
    ],
    "nl": [
      "We maken afhaalpizza's met verse kwaliteitsingrediënten. Ons team heeft een passie voor de Italiaanse keuken en streeft ernaar je een onvergetelijke culinaire ervaring te bieden."
    ],
    "es": [
      "Elaboramos pizzas para llevar con ingredientes frescos y de calidad. Nuestro equipo es un apasionado de la cocina italiana y se esfuerza por ofrecerle una experiencia culinaria inolvidable."
    ]
  },
