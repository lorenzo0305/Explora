  "rdfs:comment": {
    "de": [
      "Die Brasserie des Plantes ist die Idee einer handwerklichen Herstellung von Likören und Kräutertees aus vergessenen Pflanzen mit zahlreichen positiven Eigenschaften.\r\nSie wurde 2025 beim World Drinks Award in der Kategorie Likör zum besten Digestif der Welt gewählt!"
    ],
    "en": [
      "La Brasserie des Plantes is the idea of producing artisanal liqueurs and infusions from forgotten plants with multiple virtues.\r\nIt was voted best digestif in the world in 2025 at the World Drinks Award in the liqueur category!"
    ],
    "it": [
      "La Brasserie des Plantes è l'idea alla base di una produzione tradizionale di liquori e infusi a base di piante dimenticate dalle molteplici virtù.\r\nNel 2025 è stato eletto miglior digestivo del mondo al World Drinks Award nella categoria liquori!"
    ],
    "fr": [
      "La Brasserie des Plantes, c’est l’idée d’une production artisanale de liqueurs et d’infusions, à partir de plantes oubliées aux vertus multiples.\r\nElle a été élue meilleure digestif du monde en 2025 au World Drinks Award dans la catégorie liqueur !"
    ],
    "nl": [
      "La Brasserie des Plantes is het idee achter een traditionele productie van likeuren en infusies gemaakt van vergeten planten met meerdere deugden.\r\nHet werd in 2025 bij de World Drinks Award uitgeroepen tot beste digestief ter wereld in de categorie likeur!"
    ],
    "es": [
      "La Brasserie des Plantes es la idea de una producción artesanal de licores e infusiones elaborados a partir de plantas olvidadas con múltiples virtudes.\r\n¡Fue elegida mejor digestivo del mundo en 2025 en el World Drinks Award en la categoría de licores!"
    ]
  },
  "rdfs:label": {
    "en": [
