  "rdfs:comment": {
    "de": [
      "Das Poker Bowl Casino ist ein Freizeit- und Unterhaltungszentrum, das aus einem Spielkasino, 12 Bowlingbahnen, einem Restaurant, einem Arcade-Bereich und einem Quizraum besteht. Außerdem stehen Empfangsräume zur Verfügung."
    ],
    "en": [
      "The Poker Bowl is a leisure and entertainment space comprising a gaming Casino, 12 Bowling lanes, a restaurant, and an arcade games area. Reception rooms ranging from 35m² to 110m² are also available for rent."
    ],
    "it": [
      "Il Poker Bowl è uno spazio dedicato al tempo libero e all'intrattenimento composto da un Casinò di giochi, 12 piste da Bowling, un ristorante e un'area giochi arcade. Sono inoltre disponibili per il noleggio sale di ricevimento da 35m² a 110m²."
    ],
    "fr": [
      "Le Casino Poker Bowl est un espace dédié aux loisirs et au divertissement composé d'un Casino de jeux, de 12 pistes de Bowling, d'un restaurant, d'un espace jeux d'arcades, et d'une salle de quiz. Des salles de réception sont également disponibles."
    ],
    "nl": [
      "Het Poker Bowl Casino is een ruimte gewijd aan ontspanning en entertainment, met een speelcasino, 12 bowlingbanen, een restaurant, een speelhal en een quizzaal. Er zijn ook receptieruimtes beschikbaar."
    ],
    "es": [
      "El Casino Poker Bowl es un espacio dedicado al ocio y el entretenimiento, con un casino de juegos, 12 pistas de bolos, un restaurante, una sala de máquinas recreativas y una sala de concursos. También dispone de salas de recepción."
    ]
  },
