      "dc:description": {
        "de": [
          "Treffen Sie sich im Freien oder im Cabinet Bien-être in der 177 rue Carnot in Wimereux\nYoga für Erwachsene in den Gärten 10€, Yoga für Erwachsene 3 Freundinnen 45€, Yoga für Erwachsene VJF-Beerdigung 95€, Komfortbehandlung Sonotherapie 40€, Mediatation mit tibetanischen Klangschalen 20€, Yoga für Kinder oder für die Familie 45€"
        ],
        "en": [
          "Appointment in the open air or at the Cabinet Bien-être at 177 rue Carnot in Wimereux\nYoga adult in the gardens 10€, Yoga adult session 3 girlfriends 45€, Yoga adult funeral VJF 95€, Comfort care Sonotherapie 40€, mediation with Tibetan bowls 20€, Yoga children or for the family 45€"
        ],
        "it": [
          "Appuntamento all'aperto o presso il Cabinet Bien-être al 177 di rue Carnot a Wimereux\nYoga per adulti nei giardini 10?, Yoga per adulti con 3 amici 45?, Yoga per adulti con funerale VJF 95?, Trattamento di comfort sonoterapico 40?, Mediazione con le ciotole tibetane 20?, Yoga per bambini o famiglia 45?"
        ],
        "fr": [
          "Rendez vous en plein air ou au Cabinet Bien-être au 177 rue Carnot à Wimereux\nYoga adulte dans les jardins 10€, Yoga adulte séance 3 copines 45€, yoga adulte enterrement VJF 95€, Soin confort Sonotherapie 40€, médiattion aux bols tibétains 20€, Yoga enfants ou pour la famille 45€"
        ],
        "es": [
          "Cita al aire libre o en el Cabinet Bien-être, en el número 177 de la calle Carnot, en Wimereux\nYoga para adultos en los jardines 10?, Yoga para adultos con 3 amigos 45?, Yoga para adultos en el funeral de la VJF 95?, Tratamiento de confort con sonoterapia 40?, Mediación con cuencos tibetanos 20?, Yoga para niños o en familia 45?"
        ],
        "nl": [
          "Afspraak in de open lucht of in het Cabinet Bien-être op 177 rue Carnot in Wimereux\nYoga voor volwassenen in de tuinen 10?, Yoga voor volwassenen met 3 vrienden 45?, Yoga voor volwassenen bij VJF begrafenis 95?, Sonotherapie comfort behandeling 40?, Tibetaanse schalen mediation 20?, Yoga voor kinderen of familie 45?"
        ]
      },
