  "rdfs:comment": {
    "de": [
      "Die Evian Resort Golf Club Academy ist ein einzigartiger Ort von 15 Hektar, der dem Lernen und der Praxis des Golfsports gewidmet ist. Es beherbergt The Lake Course, einen 6 PAR 3 (885 Meter) Platz, der als technische Alternative zum 18-Loch-Kurs konzipiert wurde."
    ],
    "en": [
      "The Evian Resort Golf Club Academy is a unique 15-hectare venue, dedicated to learning and practicing golf. It is home to The Lake Course, a 6 PAR 3 course (885 meters) designed as a technical alternative to the 18-hole layout."
    ],
    "it": [
      "L'Accademia dell'Evian Resort Golf Club è un sito unico di 15 ettari dedicato all'apprendimento e al gioco del golf. Ospita il Lake Course, un percorso di 6 PAR 3 (885 metri) progettato come alternativa tecnica alle 18 buche."
    ],
    "fr": [
      "L'Evian Resort Golf Club Academy est un lieu unique de 15 hectares, dédié à l’apprentissage et à la pratique du golf. Il abrite The Lake Course, un parcours de 6 PAR 3 (885 mètres) conçu comme une alternative technique au tracé 18 trous."
    ],
    "es": [
      "La Academia del Evian Resort Golf Club es un lugar único de 15 hectáreas dedicado al aprendizaje y la práctica del golf. Alberga The Lake Course, un recorrido de 6 PAR 3 (885 metros) diseñado como alternativa técnica al trazado de 18 hoyos."
    ],
    "nl": [
      "De Evian Resort Golf Club Academy is ontworpen door een team van specialisten (ontwerpers, spelers, kampioenen en pro's) om het golfspel opnieuw uit te vinden."
    ]
  },
