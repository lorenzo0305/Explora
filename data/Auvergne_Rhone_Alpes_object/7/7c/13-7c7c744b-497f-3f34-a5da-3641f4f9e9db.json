  "rdfs:comment": {
    "de": [
      "Restaurant Höhenchalet an der Kreuzung der Pisten von Mont de la Chambre und Alpage auf 2470 m Höhe. Direkter Zugang und Rückfahrt von Les Menuires oder Val Thorens. Große Terrasse und Panoramablick. Traditionelle und hausgemachte Küche."
    ],
    "en": [
      "Chalet d'altitude restaurant located at the intersection of the Mont de la Chambre and Alpage slopes, at 2470m altitude. Direct access and return from Les Menuires or Val Thorens. Large terrace with panoramic views. Traditional, homemade cuisine."
    ],
    "it": [
      "Ristorante Chalet d'altitudine situato all'incrocio delle piste del Mont de la Chambre e dell'Alpage, a 2470 m di altitudine. Accesso e ritorno diretto da Les Menuires o Val Thorens. Ampia terrazza con vista panoramica. Cucina tradizionale e casalinga."
    ],
    "fr": [
      "Restaurant Chalet d'altitude situé à l'intersection des pistes du Mont de la Chambre et de l'Alpage, à 2470m d'altitude. Accès et retour direct depuis les Menuires ou Val Thorens. Grande terrasse et vue panoramique. Cuisine traditionnelle et fait maison."
    ],
    "es": [
      "Restaurante Chalet d'altitude situado en el cruce de las pistas Mont de la Chambre y Alpage, a 2470 m de altitud. Acceso directo y regreso desde Les Menuires o Val Thorens. Amplia terraza con vistas panorámicas. Cocina tradicional y casera."
    ],
    "nl": [
      "Chalet d'altitude restaurant gelegen op de kruising van de Mont de la Chambre en Alpage pistes, op een hoogte van 2470m. Directe toegang en terugkeer vanuit Les Menuires of Val Thorens. Groot terras met panoramisch uitzicht. Traditionele, huisgemaakte keuken."
    ]
  },
