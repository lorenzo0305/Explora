  "rdfs:comment": {
    "de": [
      "Der Doron des Allues ist ein französischer Fluss, der am linken Ufer des Doron de Bozel fließt und somit ein Nebenfluss der Isère und später der Rhône ist. Der Doron des Allues fließt in der Region Rhône-Alpes im Département Savoie."
    ],
    "en": [
      "The Doron des Allues is a French river, a left-bank tributary of the Doron de Bozel, and therefore a sub-tributary of the Isère and Rhône rivers. The Doron des Allues flows in the Rhône-Alpes region, in the Savoie department."
    ],
    "it": [
      "Il Doron des Allues è un fiume francese, affluente di sinistra del Doron de Bozel, e quindi un sotto-tributo dell'Isère e poi del Rodano. Il Doron des Allues scorre nella regione Rodano-Alpi, nel dipartimento della Savoia."
    ],
    "fr": [
      "Le Doron des Allues est une rivière française, affluent de la rive gauche du Doron de Bozel, et donc sous-affluent de l'Isère puis du Rhône. Le Doron des Allues coule en région Rhône-Alpes, dans le département de la Savoie."
    ],
    "es": [
      "El Doron des Allues es un río francés, afluente por la margen izquierda del Doron de Bozel y, por tanto, subfluente del Isère y luego del Ródano. El Doron des Allues fluye en la región de Ródano-Alpes, en el departamento de Saboya."
    ],
    "nl": [
      "De Doron des Allues is een Franse rivier, een zijrivier aan de linkeroever van de Doron de Bozel, en daardoor een zijrivier van de Isère en vervolgens de Rhône. De Doron des Allues stroomt in de regio Rhône-Alpes, in het departement Savoie."
    ]
  },
