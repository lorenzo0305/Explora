  "rdfs:comment": {
    "de": [
      "Willkommen in Courtenay, einer Gemeinde im Zentrum der Balcons du Dauphiné in der Region Nord-Isère. Entdecken Sie das Observatorium am Etang de Salette, den Fischteich im Marais de Lancin, die mittelalterlichen Schlösser, die Kirche und die für unsere Region typischen Dächer."
    ],
    "en": [
      "Welcome to Courtenay, a village in the heart of the Balcons du Dauphiné in the Nord-Isère region. Discover the Salette pond observatory, the Lancin marsh fishing pond, the medieval castles, the church and the typical roofs of our region."
    ],
    "it": [
      "Benvenuti a Courtenay, un villaggio al centro dei Balcons du Dauphiné, nella regione Nord-Isère. Scoprite l'osservatorio dello stagno della Salette, lo stagno di pesca della palude di Lancin, i castelli medievali, la chiesa e i tetti tipici della nostra regione."
    ],
    "fr": [
      "Bienvenue à Courtenay, commune située au centre des Balcons du Dauphiné dans le Nord-Isère. Découvrez l'observatoire de l’étang de Salette, l'étang de pêche du marais de Lancin, les châteaux médiévaux, l'église et les toits typiques de notre région."
    ],
    "nl": [
      "Welkom in Courtenay, een dorp in het centrum van de Balcons du Dauphiné in de regio Nord-Isère. Ontdek het observatorium van de vijver van Salette, de visvijver van het moeras van Lancin, de middeleeuwse kastelen, de kerk en de typische daken van onze streek."
    ],
    "es": [
      "Bienvenido a Courtenay, pueblo situado en el centro de los Balcones del Dauphiné, en la región de Nord-Isère. Descubra el observatorio del estanque de la Salette, el estanque de pesca del pantano de Lancin, los castillos medievales, la iglesia y los tejados típicos de nuestra región."
    ]
  },
