  "rdfs:comment": {
    "de": [
      "Willkommen in der Ferme Auberge Les Blancs Moutons & Filles. Entdecken Sie einen Ort, an dem Sie ein Menü mit den Produkten des Bauernhofs und seiner Umgebung in einer freundlichen und fröhlichen Atmosphäre genießen können. Unverbaute Aussicht und Lebensfreude garantiert!"
    ],
    "en": [
      "Welcome to the farm inn Les Blancs Moutons & Filles. Come and discover a place where you can enjoy a menu with products from the farm and its surroundings, in a friendly and cheerful atmosphere. Breathtaking views and joie de vivre guaranteed!"
    ],
    "it": [
      "Benvenuti all'agriturismo Les Blancs Moutons & Filles. Venite a scoprire un luogo dove potrete gustare un menu a base di prodotti della fattoria e dei dintorni, in un'atmosfera amichevole e allegra. Panorami mozzafiato e gioia di vivere garantiti!"
    ],
    "fr": [
      "Bienvenue à la ferme auberge Les Blancs Moutons & Filles, venez découvrir un lieu où vous pouvez déguster un menu avec les produits de la ferme et ses alentours, dans une ambiance conviviale et joyeuse. Vue imprenable et joie de vivre garanties !"
    ],
    "nl": [
      "Welkom op de boerderijherberg Les Blancs Moutons & Filles. Kom en ontdek een plek waar je kunt genieten van een menu op basis van producten van de boerderij en de omgeving, in een vriendelijke en vrolijke sfeer. Adembenemend uitzicht en levensvreugde gegarandeerd!"
    ],
    "es": [
      "Bienvenido al agroturismo Les Blancs Moutons & Filles. Venga a descubrir un lugar donde podrá degustar un menú a base de productos de la granja y de los alrededores, en un ambiente acogedor y alegre. Vistas impresionantes y alegría de vivir garantizada"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ferme auberge - Les Blancs Moutons & Filles"
    ]
  },
