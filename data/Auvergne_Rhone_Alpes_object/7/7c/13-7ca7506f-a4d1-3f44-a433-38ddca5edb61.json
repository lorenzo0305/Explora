  "rdfs:comment": {
    "de": [
      "Die Portes du Soleil bieten Nicht-Bergsteigern eine Wanderung an, um das französisch-schweizerische Gebiet der Portes du Soleil zu entdecken. Ein Moment der Flucht vor den Gipfeln, der unvergessliche Erinnerungen verspricht."
    ],
    "en": [
      "The Portes du Soleil offer non-mountain bikers a hike to discover the Franco-Swiss territory of the Portes du Soleil. A moment of escape to the summits that promises unforgettable memories."
    ],
    "it": [
      "Le Portes du Soleil offrono ai non veterani la possibilità di scoprire il territorio franco-svizzero delle Portes du Soleil. È un ottimo modo per evadere dal ritmo frenetico delle montagne, che promette ricordi indimenticabili."
    ],
    "fr": [
      "Les Portes du Soleil proposent aux non-vététistes une randonnée à la découverte du territoire franco-suisse des Portes du Soleil. Un moment d’évasion à l’assaut des sommets qui promet des souvenirs inoubliables."
    ],
    "es": [
      "Portes du Soleil ofrece a los no veteranos la oportunidad de descubrir el territorio franco-suizo de Portes du Soleil. Es una forma estupenda de escapar del ritmo frenético de la montaña, que promete recuerdos inolvidables."
    ],
    "nl": [
      "De Portes du Soleil biedt niet-mountainbikers de kans om het Frans-Zwitserse gebied van de Portes du Soleil te voet te ontdekken. Het is een geweldige manier om er even tussenuit te zijn en naar de top van een berg te klimmen die onvergetelijke herinneringen belooft."
    ]
  },
