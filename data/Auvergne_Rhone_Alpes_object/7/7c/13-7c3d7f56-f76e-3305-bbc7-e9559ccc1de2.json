  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Ardèche in Freiheit mit unseren halbstarren Mountainbikes, die Sie mieten können. Nutzen Sie unsere empfohlenen Strecken für einen Tag in der Natur!"
    ],
    "en": [
      "Discover the Ardèche on your own with our semi-rigid mountain bikes for hire. Take advantage of our recommended routes for an independent day out!"
    ],
    "it": [
      "Scoprite l'Ardèche da soli con le nostre mountain bike semirigide a noleggio. Approfittate dei nostri itinerari consigliati per una giornata autogestita!"
    ],
    "fr": [
      "Découvrez l’Ardèche en liberté avec nos VTT semi-rigides à louer. Profitez de nos parcours conseillés pour une journée nature en autonomie !"
    ],
    "nl": [
      "Ontdek de Ardèche op eigen houtje met onze halfverharde mountainbikes die je kunt huren. Maak gebruik van onze aanbevolen routes voor een dag op eigen houtje!"
    ],
    "es": [
      "Descubra la Ardèche a su aire con nuestras bicicletas de montaña semirrígidas de alquiler. ¡Aproveche nuestras rutas recomendadas para una jornada autoguiada!"
    ]
  },
