  "rdfs:comment": {
    "de": [
      "Service: Fotokopien, Faxgeräte\r\nWifi ist kostenlos,\r\nZum Verkauf stehende Dokumente: Wander- und Mountainbike-Karten, Barockpfade, Poster, Angelscheine, Boutique-Produkte\r\nInformationen und Buchungen Ja Busse und Ausflüge SAT."
    ],
    "en": [
      "Services: Photocopies, faxes\r\nFree Wifi,\r\nDocuments for sale : Hiking map and mountain bike routes, baroque trails, posters, fishing permits, products Shop\r\nInformation and reservations Yes Bus and SAT excursions."
    ],
    "it": [
      "Servizi: Fotocopie, fax\r\nWifi gratuito,\r\nDocumenti in vendita : Cartine per escursioni e mountain bike, sentieri barocchi, poster, permessi di pesca, prodotti del negozio\r\nInformazioni e prenotazioni Sì Escursioni in autobus e SAT."
    ],
    "fr": [
      "Services: Photocopies, télécopies\r\nWifi gratuit,\r\nDocuments en vente : Carte de randonnées et itinéraires VTT, sentiers du baroque, affiches, permis de pêche, produits Boutique\r\nInformations et réservation Oui Bus et excursions SAT."
    ],
    "es": [
      "Servicios: Fotocopias, faxes\r\nWifi gratuito,\r\nDocumentos a la venta : Mapas de senderismo y bicicleta de montaña, rutas barrocas, carteles, permisos de pesca, productos de la tienda\r\nInformación y reservas Sí Excursiones en autobús y SAT."
    ],
    "nl": [
      "Diensten: Fotokopieën, faxen\r\nGratis Wifi,\r\nDocumenten te koop: Wandel- en mountainbikekaarten, barokke routes, posters, visvergunningen, winkelproducten\r\nInformatie en reserveringen Ja Bus en SAT excursies."
    ]
  },
