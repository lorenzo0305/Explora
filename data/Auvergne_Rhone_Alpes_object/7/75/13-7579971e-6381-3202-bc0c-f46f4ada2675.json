  "rdfs:comment": {
    "de": [
      "Kommt und amüsiert euch auf unserem Pumptrack, einer Strecke mit Buckeln und Steilkurven, und werdet zu echten \"Baujus Riders\"!"
    ],
    "en": [
      "Come and have fun on our Pump track, a circuit of bumps and banked turns, to become real \"Baujus riders\"!"
    ],
    "it": [
      "Venite a divertirvi sulla nostra pista Pump, un circuito di dossi e curve a gomito, per diventare dei veri \"Baujus riders\"!"
    ],
    "fr": [
      "Venez vous amuser sur notre Pump track, un circuit de bosses et virages relevés, pour devenir de vrais \"Baujus riders\" !"
    ],
    "es": [
      "Ven a divertirte en nuestra Pump track, un circuito de baches y curvas peraltadas, ¡para convertirte en un auténtico \"jinete Baujus\"!"
    ],
    "nl": [
      "Kom plezier maken op onze Pump track, een circuit met hobbels en schuine bochten, om echte \"Baujus rijders\" te worden!"
    ]
  },
