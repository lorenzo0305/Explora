  "rdfs:comment": {
    "de": [
      "Außergewöhnlich: Wiedereröffnung nach Restaurierung! Diese Kirche ist ein typisches Beispiel für den savoyischen Barock, stammt aber aus dem Mittelalter. Staunen Sie über die Reliquien des Heiligen Landry, Mönch der Abtei von Novalaise, und begeben Sie sich auf eine Zeitreise?"
    ],
    "en": [
      "Exceptional: reopening after restoration! Characteristic of Savoyard Baroque, this church dates back to the Middle Ages. Marvel at the relics of Saint Landry, a monk from the Novalaise abbey, and take a trip back in time..."
    ],
    "it": [
      "Eccezionale: riapertura dopo il restauro! Caratteristica del barocco savoiardo, questa chiesa risale al Medioevo. Ammirate le reliquie di San Landry, monaco dell'abbazia di Novalaise, e fate un viaggio nel tempo..."
    ],
    "fr": [
      "Exceptionnel : réouverture après restauration ! Caractéristique du baroque savoyard, cette église date pourtant du Moyen-Âge. Etonnez-vous face aux reliques de Saint Landry, moine de l’abbaye de la Novalaise et offrez-vous un voyage dans le temps…"
    ],
    "nl": [
      "Uitzonderlijk: heropening na restauratie! Deze kerk is kenmerkend voor de Savoyaardse barok en dateert uit de Middeleeuwen. Bewonder de relikwieën van Saint Landry, een monnik uit de Novalaise abdij, en maak een reis terug in de tijd..."
    ],
    "es": [
      "Excepcional: ¡reapertura tras restauración! Característica del barroco saboyano, esta iglesia data de la Edad Media. Maravíllese ante las reliquias de San Landry, monje de la abadía de Novalaise, y haga un viaje en el tiempo.."
    ]
  },
