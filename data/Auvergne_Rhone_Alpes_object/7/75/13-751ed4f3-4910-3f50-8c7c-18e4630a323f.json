  "rdfs:comment": {
    "de": [
      "Fordern Sie Ihre Lieben, Familie oder Freunde im Herzen der Stadt Voiron mit diesem Orientierungskurs zum Thema Résistance und der Geschichte von Voiron während des Zweiten Weltkriegs heraus. Nehmen Sie die Herausforderung an und finden Sie die 10 Leuchtfeuer."
    ],
    "en": [
      "Challenge your loved ones, family or friends in the heart of the city of Voiron, with this orientation course on the theme of the Resistance and the history of Voiron during the Second World War. Take up the challenge by finding the 10 beacons."
    ],
    "it": [
      "Sfidate i vostri amici e la vostra famiglia nel cuore di Voiron con questo percorso di orienteering sul tema della Resistenza e della storia di Voiron durante la Seconda Guerra Mondiale. Raccogliete la sfida trovando i 10 indicatori."
    ],
    "fr": [
      "Défiez vos proches, en famille ou entre amis au cœur de la ville de Voiron, avec ce parcours d'orientation sur le thème de la Résistance et l'histoire de Voiron pendant la seconde guerre mondiale. Relevez le défi en retrouvant les 10 balises."
    ],
    "es": [
      "Desafíe a sus amigos y familiares en el corazón de Voiron con este recorrido de orientación sobre el tema de la Resistencia y la historia de Voiron durante la Segunda Guerra Mundial. Acepte el reto encontrando las 10 balizas."
    ],
    "nl": [
      "Daag je vrienden en familie uit in het hart van Voiron met dit oriëntatieparcours met als thema het verzet en de geschiedenis van Voiron tijdens de Tweede Wereldoorlog. Ga de uitdaging aan door de 10 markers te vinden."
    ]
  },
  "rdfs:label": {
    "en": [
      "Heritage orienteering course in Voiron"
    ],
    "fr": [
      "Parcours d'orientation patrimoine à Voiron"
    ]
  },
