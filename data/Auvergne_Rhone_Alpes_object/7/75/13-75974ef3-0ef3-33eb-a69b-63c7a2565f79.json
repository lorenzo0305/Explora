  "rdfs:comment": {
    "de": [
      "Suchen Sie den besten Schnee im Skigebiet?\r\nGenießen Sie die beiden herrlichen Pisten Julie und Bartavelle und lassen Sie sich das Foto auf dem Massivholzmodul auf dem Gipfel nicht entgehen. Ein Muss für Ihren Urlaub!"
    ],
    "en": [
      "Looking for the best snow in the ski area? \r\nEveryday after snowfall, set your alarm clock to be the first one to ski the 2 ungroomed slopes from Julie and Bartavelle, and taste the fresh snow without any risk!"
    ],
    "it": [
      "Cercate la migliore neve del comprensorio sciistico?\r\nGodetevi le due superbe piste di Julie e Bartavelle e non perdetevi la foto sul modulo in legno massiccio in cima. Un must per le vostre vacanze!"
    ],
    "fr": [
      "Vous cherchez la meilleure neige du domaine skiable ?\r\nProfitez des deux superbes pistes de Julie et Bartavelle et ne manquez pas la photo sur le module en bois massif au sommet. Un incontournable de vos vacances !"
    ],
    "es": [
      "¿Buscas la mejor nieve de la estación de esquí?\r\nDisfrute de las dos magníficas pistas de Julie y Bartavelle y no se pierda la foto en el módulo de madera maciza de la cima. ¡Imprescindible para sus vacaciones!"
    ],
    "nl": [
      "Op zoek naar de beste sneeuw in het skigebied?\r\nGeniet van de twee schitterende pistes van Julie en Bartavelle en mis de foto op de massief houten module bovenaan niet. Een must voor uw vakantie!"
    ]
  },
  "rdfs:label": {
    "ru": [
      "Назад к дикой природе - зона фрирайда и \"большого\" катания"
    ],
    "en": [
      "Back to the Wild - Great skiers area"
    ],
    "fr": [
      "Back to the Wild - Secteur Grand ski"
    ],
    "nl": [
      "Terug naar de wildernis - Grand Ski Area"
    ]
  },
