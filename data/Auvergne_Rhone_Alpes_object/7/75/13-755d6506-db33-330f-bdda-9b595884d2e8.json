  "rdfs:comment": {
    "de": [
      "40 Spielbereiche, ökologische Karussells, mechanische und akustische Kuriositäten, pädagogischer Bauernhof und Garten, Panoramaterrasse, Ausstellungen und Aufführungen: ein Vergnügungspark der „neuen Generation“... wo man die Alm mit der ganzen Familie entdecken kann!"
    ],
    "en": [
      "40 play areas, ecological rides, mechanical and sound curiosities, educational farm and garden, panoramic terrace, exhibitions and shows: a ‘new generation’ theme park... where the whole family can discover 'l'Alpe'!"
    ],
    "it": [
      "40 aree gioco, giostre ecologiche, curiosità meccaniche e sonore, fattoria didattica e giardino, terrazza panoramica, mostre e spettacoli: un parco tematico di \"nuova generazione\"... dove tutta la famiglia può scoprire le Alpi!"
    ],
    "fr": [
      "40 espaces de jeux, manèges écologiques, curiosités mécaniques et sonores, ferme et jardin pédagogiques, terrasse panoramique, expositions et spectacles : un parc d’attractions «nouvelle génération»... où découvrir l’Alpe en famille !"
    ],
    "nl": [
      "40 speeltuinen, ecologische attracties, mechanische en geluidscuriosa, educatieve boerderij en tuin, panoramisch terras, tentoonstellingen en shows: een themapark van de \"nieuwe generatie\"... waar het hele gezin de Alpen kan ontdekken!"
    ],
    "es": [
      "40 áreas de juego, atracciones ecológicas, curiosidades mecánicas y sonoras, granja y jardín educativos, terraza panorámica, exposiciones y espectáculos: un parque temático de \"nueva generación\"... ¡donde toda la familia podrá descubrir los Alpes!"
    ]
  },
