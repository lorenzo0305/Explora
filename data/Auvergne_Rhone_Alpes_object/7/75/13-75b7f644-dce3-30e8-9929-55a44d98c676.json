  "rdfs:comment": {
    "de": [
      "Die 5. Etappe des Radrennens Paris-Nizza 2026 zwischen Morzine und Les Saisies führt durch Le Grand-Bornand. Die Fahrer nehmen den Col de la Colombière in Angriff, bevor sie auf der place de la Grenette eine Verpflegungspause einlegen."
    ],
    "en": [
      "The fifth stage of the 2026 Paris-Nice cycling race, between Morzine and Les Saisies, will pass through Le Grand-Bornand. The riders will take the Col de la Colombière before stopping for refreshments at place de la Grenette."
    ],
    "it": [
      "La 5ª tappa della Parigi-Nizza 2026, tra Morzine e Les Saisies, passerà per Le Grand-Bornand. I corridori affronteranno il Col de la Colombière prima di fermarsi per un rinfresco a Place de la Grenette."
    ],
    "fr": [
      "La 5ème du Paris-Nice cyclo 2026, entre Morzine et Les Saisies, passera par le Grand-Bornand. Les coureurs emprunteront le col de la Colombière avant de faire une halte pour un ravitaillement place de la Grenette."
    ],
    "es": [
      "La 5ª etapa del ciclo París-Niza 2026, entre Morzine y Les Saisies, pasará por Le Grand-Bornand. Los ciclistas tomarán el Col de la Colombière antes de parar a tomar un refrigerio en la Place de la Grenette."
    ],
    "nl": [
      "De 5e etappe van de Paris-Nice cyclo 2026, tussen Morzine en Les Saisies, komt door Le Grand-Bornand. De renners nemen de Col de la Colombière voordat ze stoppen voor een verfrissing op Place de la Grenette."
    ]
  },
