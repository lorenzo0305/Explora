  "rdfs:comment": {
    "de": [
      "Komfortabler Coworking Space mit 5 Gemeinschaftsbüros im Herzen des Ortes.\r\nHighspeed-Glasfaser, ergonomische Schreibtische und Möbel, Bildschirme, Whiteboard, Entspannungsecke... Stundenweise, tageweise, monatsweise!"
    ],
    "en": [
      "Three hotel rooms, in the heart of the charming village of Saint-Didier-sur-Rochefort: one double room, one triple room, one room for 5 people. Possibility to rent the whole floor with a common space.\r\nReservation is required."
    ],
    "it": [
      "Confortevole spazio di coworking con 5 uffici condivisi nel centro della città.\r\nFibra a banda larga, scrivanie e mobili ergonomici, schermi, lavagne, area relax... A ore, a giorni, a mesi!"
    ],
    "fr": [
      "Espace de coworking tout confort, équipé de 5 bureaux partagés en plein coeur de bourg.\r\nFibre haut débit, bureaux et mobilier ergonomiques, écrans, tableau blanc, coin détente... A l'heure, à la journée, au mois !"
    ],
    "nl": [
      "Comfortabele coworkingruimte met 5 gedeelde kantoren in het centrum van de stad.\r\nBreedbandvezel, ergonomische bureaus en meubels, schermen, whiteboards, ontspanningsruimte... Per uur, per dag, per maand!"
    ],
    "es": [
      "Cómodo espacio de coworking con 5 despachos compartidos en pleno centro de la ciudad.\r\nFibra de banda ancha, escritorios y mobiliario ergonómicos, pantallas, pizarras, zona de descanso... Por horas, por días, por meses.."
    ]
  },
