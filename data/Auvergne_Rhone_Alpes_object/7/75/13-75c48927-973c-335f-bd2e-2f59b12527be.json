  "rdfs:comment": {
    "de": [
      "Erfreuen Sie sich das ganze Jahr über an den grandiosen Landschaften des Vercors aus der Vogelperspektive – gleich wohin der Wind Sie treibt... Unvergessliche Erinnerungen garantiert!  Vorbehaltlich geeigneter Wetterbedingungen."
    ],
    "en": [
      "Throughout the year, fly like a bird while taking in the spectacular mountain scenery from above, for long-lasting memories! Subject to favourable weather conditions."
    ],
    "it": [
      "Navigate con il vento tutto l'anno e godetevi lo scenario mozzafiato visto dall'alto: ricordi che dureranno tutta la vita! Condizioni meteorologiche permettendo."
    ],
    "fr": [
      "Toute l'année, voguer au gré du vent, se délecter des paysages grandioses vus d'en haut, des souvenirs impérissables ! Sous réserve de bonnes conditions météorologiques."
    ],
    "nl": [
      "Zeil het hele jaar door met de wind mee en geniet van het adembenemende landschap van bovenaf - herinneringen voor het leven! Als het weer het toelaat."
    ],
    "es": [
      "Navegue con el viento durante todo el año y disfrute del impresionante paisaje visto desde arriba: ¡recuerdos para toda la vida! Si las condiciones meteorológicas lo permiten."
    ]
  },
