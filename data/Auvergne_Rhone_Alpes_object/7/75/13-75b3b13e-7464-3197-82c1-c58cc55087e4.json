  "rdfs:comment": {
    "de": [
      "Am Rande des Waldes Grands Bois gelegen, können Sie in einer grünen Umgebung an diesem Gewässer, das vom Fluss Furan gespeist wird, dem Angeln frönen."
    ],
    "en": [
      "Located on the edge of the Grands Bois forest, you can enjoy fishing in a green setting on this lake fed by the Furan river."
    ],
    "it": [
      "Situato ai margini della foresta di Grands Bois, questo lago alimentato dal fiume Furan offre la possibilità di pescare nel verde."
    ],
    "fr": [
      "Situé en lisière de la forêt des Grands Bois, c'est dans un écrin de verdure que vous pourrez vous adonner à la pêche sur ce plan d'eau alimenté par la rivière Furan."
    ],
    "es": [
      "Situado en la linde del bosque de Grands Bois, podrá pescar en este lago alimentado por el río Furan."
    ],
    "nl": [
      "Aan de rand van het bos van Grands Bois kun je in een groene omgeving vissen op dit meer dat gevoed wordt door de rivier de Furan."
    ]
  },
