  "rdfs:comment": {
    "de": [
      "Die Flon und die Méline sind schöne, wilde Bäche in der Ebene. Hier können Sie in der wilden Umgebung des Vorlandes Forellen fangen."
    ],
    "en": [
      "The Flon and the Méline are beautiful wild streams of the plain. Come and tease the trout in the wild setting of the Avant-Pays."
    ],
    "it": [
      "Il Flon e la Méline sono bellissimi e selvaggi corsi d'acqua della pianura. Venite a pescare la trota nella cornice selvaggia dell'Avant-Pays."
    ],
    "fr": [
      "Le Flon et la Méline sont de jolis ruisseaux sauvages de plaine. Venez donc y taquiner la truite, dans le cadre sauvage de l'Avant-Pays."
    ],
    "es": [
      "El Flon y el Méline son hermosos y salvajes arroyos de la llanura. Venga a pescar truchas en el entorno salvaje del Avant-Pays."
    ],
    "nl": [
      "De Flon en de Méline zijn mooie, wilde stromen van de vlakte. Kom vissen op forel in de wilde omgeving van de Avant-Pays."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Flon et la Méline"
    ]
  },
