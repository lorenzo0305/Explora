  "rdfs:comment": {
    "de": [
      "Ungewöhnlich, aber wahr.\r\nSelbst bei Überschwemmungen drang nie Wasser in die Kapelle oder den benachbarten Bauernhof ein."
    ],
    "en": [
      "Unusual but true.\r\nEven in times of flooding, the water never entered the chapel or the neighboring farm."
    ],
    "it": [
      "Insolito ma vero.\r\nAnche nei periodi di inondazione, l'acqua non è mai entrata nella cappella o nella fattoria vicina."
    ],
    "fr": [
      "Insolite mais vrai.\r\nMême en période d'inondation, l'eau n’est jamais entrée ni dans la chapelle, ni d’ailleurs dans la ferme avoisinante."
    ],
    "nl": [
      "Ongebruikelijk maar waar.\r\nZelfs in tijden van overstroming liep het water nooit de kapel of de naburige boerderij binnen."
    ],
    "es": [
      "Insólito pero cierto.\r\nIncluso en tiempos de inundación, el agua nunca entró en la capilla ni en la granja vecina."
    ]
  },
  "rdfs:label": {
