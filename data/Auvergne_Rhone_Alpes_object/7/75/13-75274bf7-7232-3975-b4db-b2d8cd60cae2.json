  "rdfs:comment": {
    "de": [
      "Eine unvergessliche Flugreise, bei der Sie mit dem Wind, über Bergreliefs und Flüsse schweben und die einzigartige Stille einer Ballonfahrt genießen."
    ],
    "en": [
      "An unforgettable aerial journey where you float on the wind, over mountains and rivers, in the unique silence of a hot-air balloon flight."
    ],
    "it": [
      "Un viaggio aereo indimenticabile in cui si fluttua nel vento, sopra montagne e fiumi, nel silenzio unico di un volo in mongolfiera."
    ],
    "fr": [
      "Un voyage aérien inoubliable où vous flottez au gré du vent, des reliefs montagneux et des rivières, dans le silence unique du vol en montgolfière."
    ],
    "es": [
      "Un viaje aéreo inolvidable en el que flotarás en el viento, sobre montañas y ríos, en el silencio único de un vuelo en globo."
    ],
    "nl": [
      "Een onvergetelijke luchtreis waarbij je zweeft op de wind, over bergen en rivieren, in de unieke stilte van een vlucht met een heteluchtballon."
    ]
  },
