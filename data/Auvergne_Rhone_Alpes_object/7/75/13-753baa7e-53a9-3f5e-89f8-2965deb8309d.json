  "rdfs:comment": {
    "de": [
      "Les Garçons Bouchers ist ein authentisches Steakhaus im Herzen von Les Halles de Lyon Paul Bocuse. Genießen Sie in einer freundlichen und herzlichen Atmosphäre an der Theke oder im Bistrosaal im Obergeschoss ein gutes Stück Fleisch."
    ],
    "en": [
      "Les Garçons Bouchers is an authentic steakhouse in the heart of Les Halles de Lyon Paul Bocuse. Come and enjoy a good piece of meat in a warm and friendly atmosphere, at the counter or in the bistro room upstairs."
    ],
    "it": [
      "Les Garçons Bouchers è un'autentica steakhouse nel cuore di Les Halles de Lyon Paul Bocuse. Venite a gustare un buon pezzo di carne in un'atmosfera calda e accogliente, al banco o nel bistrot al piano superiore."
    ],
    "fr": [
      "Les Garçons Bouchers est une authentique steakhouse au cœur des Halles de Lyon Paul Bocuse. Venez déguster, dans une ambiance conviviale et chaleureuse, au comptoir ou dans la salle bistrot à l’étage, une bonne pièce de viande."
    ],
    "nl": [
      "Les Garçons Bouchers is een authentiek steakhouse in het hart van Les Halles de Lyon Paul Bocuse. Kom genieten van een goed stuk vlees in een warme en vriendelijke sfeer, aan de counter of in de bistro boven."
    ],
    "es": [
      "Les Garçons Bouchers es un auténtico asador en el corazón de Les Halles de Lyon Paul Bocuse. Venga a degustar un buen trozo de carne en un ambiente cálido y acogedor, en la barra o en el bistró de arriba."
    ]
  },
