  "rdfs:comment": {
    "de": [
      "30 Jahre Karriere, Hunderte von Auftritten und Festivals auf der ganzen Welt, die jeden Abend so gespielt werden, als wäre es das letzte Mal, Stade de France mit ACDC und Zeniths, Frankreich-Tourneen mit Motörhead, Guns N? Roses, ein Moment der Gnade beim Hellfest 2019?"
    ],
    "en": [
      "30 years of career, hundreds of dates and festivals around the world played every night as if it were the last time, Stade de France with ACDC and zeniths, French tours with Motörhead, Guns N? Roses, a moment of grace at Hellfest 2019?"
    ],
    "it": [
      "30 anni di carriera, centinaia di date e festival in tutto il mondo suonati ogni sera come se fosse l'ultima volta, Stade de France con ACDC e Zeniths, tour francesi con Motörhead, Guns N? Roses, un momento di grazia all'Hellfest 2019?"
    ],
    "fr": [
      "30 ans de carrière, des centaines de dates et festivals dans le monde jouées chaque soir comme si c’était la dernière fois, Stade de France avec ACDC et des zéniths, les tournées françaises avec Motörhead, Guns N’ Roses, moment de grâce au Hellfest 2019…"
    ],
    "nl": [
      "30 jaar carrière, honderden data en festivals over de hele wereld elke avond gespeeld alsof het de laatste keer was, Stade de France met ACDC en zeniths, Franse tournees met Motörhead, Guns N? Roses, een moment van genade op Hellfest 2019?"
    ],
    "es": [
      "30 años de carrera, cientos de fechas y festivales por todo el mundo tocando cada noche como si fuera la última vez, Stade de France con ACDC y zeniths, giras francesas con Motörhead, Guns N? Roses, ¿un momento de gracia en el Hellfest 2019?"
    ]
  },
