  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/3215d898-92ea-3e10-b6d0-6e598c79ed5e",
      "dc:description": {
        "de": [
          "Auf dem Place du Centenaire und im Palais des Congrès können Sie sich kostenlos in das bereitgestellte WLAN-Netzwerk einloggen\nDarüber hinaus bieten auch viele Einrichtungen Verbindungen an."
        ],
        "en": [
          "You can connect free of charge to the Wifi network available on the Place du Centenaire and at the Palais des Congrès\nIn addition, many establishments also offer connections."
        ],
        "it": [
          "È possibile collegarsi gratuitamente alla rete Wifi presso la Place du Centenaire e il Palais des Congrès\nAnche molte altre strutture offrono connessioni."
        ],
        "fr": [
          "Vous pouvez vous connecter gratuitement au réseau Wifi mis à disposition sur la Place du Centenaire et au Palais des Congrès \nPar ailleurs, de nombreux établissement proposent également des connexions."
        ],
        "es": [
          "Puede conectarse gratuitamente a la red Wifi en la Plaza del Centenario y el Palacio de Congresos\nMuchos otros establecimientos también ofrecen conexiones."
        ],
        "nl": [
          "Je kunt gratis verbinding maken met het Wifi-netwerk op de Place du Centenaire en het Palais des Congrès\nVeel andere etablissementen bieden ook verbindingen aan."
        ]
      },
