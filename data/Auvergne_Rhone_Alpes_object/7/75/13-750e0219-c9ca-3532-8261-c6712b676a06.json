  "rdfs:comment": {
    "de": [
      "Entdecken Sie unsere Bretter, die von lokalen Produzenten stammen, unsere hausgemachten Tapas, unsere Fertiggerichte und unsere Desserts, die von unserem Konditor zubereitet werden.\r\n\r\nLust auf einen Cocktail oder einen Drink mit Freunden? Dann sind Sie hier genau richtig, mit Animation und DJ jeden Abend!"
    ],
    "en": [
      "Discover our locally sourced boards, homemade tapas, ready-made meals and desserts prepared by our pastry chef.\r\n\r\nFancy a cocktail, or a drink with friends? You've come to the right place, with live entertainment and a DJ every evening!"
    ],
    "it": [
      "Scoprite i nostri taglieri di produttori locali, le nostre tapas fatte in casa, i nostri piatti pronti e i nostri dessert preparati dal nostro pasticcere.\r\n\r\nAvete voglia di un cocktail o di un aperitivo con gli amici? Siete nel posto giusto, con intrattenimento e DJ ogni sera!"
    ],
    "fr": [
      "Découvrez nos planches issues de producteurs locaux, nos tapas maison, nos plats cuisinés et nos desserts préparés par notre pâtissier.\r\n\r\nEnvie d'un cocktail, ou d'un verre entre amis ? Vous êtes au bon endroit avec animation et DJ chaque soir !"
    ],
    "nl": [
      "Ontdek onze schotels van lokale producenten, onze huisgemaakte tapas, onze kant-en-klare gerechten en onze desserts bereid door onze patissier.\r\n\r\nZin in een cocktail of een drankje met vrienden? Dan ben je bij ons aan het juiste adres, met elke avond entertainment en een DJ!"
    ],
    "es": [
      "Descubra nuestros platos de productores locales, nuestras tapas caseras, nuestros platos preparados y nuestros postres elaborados por nuestro pastelero.\r\n\r\n¿Le apetece un cóctel o una copa con los amigos? Está en el lugar adecuado, con animación y DJ todas las noches"
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'imprévu"
    ]
  },
