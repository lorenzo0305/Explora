  "rdfs:comment": {
    "de": [
      "Dieser Ort fördert die Begegnung zwischen Publikum und Kunstschaffenden in einem lebendigen und offenen Raum. Er wird durch Ausstellungen von Malerei, Skulpturen, ?uvres éphémères, Street Art, Fotos, Videos, Theater,... belebt."
    ],
    "en": [
      "This venue promotes encounters between the public and artists in a lively, open-plan setting. It is enlivened by exhibitions of paintings, sculptures, ephemeral works, street art, photos, videos, theater, etc."
    ],
    "it": [
      "Questo luogo favorisce l'incontro tra pubblico e artisti creativi in uno spazio aperto e vivace. È animato da mostre di dipinti, sculture, opere effimere, street art, foto, video, teatro, ecc."
    ],
    "fr": [
      "Ce lieu favorise la rencontre entre public et créateurs dans un lieu vivant et ouvert. Il est animé par des expositions de peinture, sculptures, œuvres éphémères, street art, photos, vidéos, théâtre,..."
    ],
    "es": [
      "Este lugar propicia el encuentro entre el público y los creadores en un espacio vivo y abierto. Está animado por exposiciones de pintura, escultura, obras efímeras, arte callejero, fotos, vídeos, teatro, etc."
    ],
    "nl": [
      "Deze locatie moedigt het publiek en creatieve kunstenaars aan elkaar te ontmoeten in een levendige, open ruimte. Het wordt verlevendigd door tentoonstellingen van schilderijen, beeldhouwwerken, efemere werken, straatkunst, foto's, video's, theater, enz."
    ]
  },
