  "rdfs:comment": {
    "de": [
      "Liebhaber der portugiesischen Küche werden in unserem Lokal rundum zufrieden sein. Unser schöner Außenbereich lädt bei gutem Wetter zum Entspannen ein."
    ],
    "en": [
      "Lovers of Portuguese cuisine will be completely satisfied in our establishment. Our beautiful exterior allows you to relax when the weather is nice."
    ],
    "it": [
      "Gli amanti della cucina portoghese saranno completamente soddisfatti nel nostro locale. Il nostro bellissimo esterno vi permette di rilassarvi quando il tempo è bello."
    ],
    "fr": [
      "Les amateurs de cuisine portugaise seront entièrement satisfaits dans notre établissement. Notre bel extérieur vous permet de vous détendre lorsqu’il fait bon."
    ],
    "es": [
      "Los amantes de la cocina portuguesa quedarán completamente satisfechos en nuestro establecimiento. Nuestro hermoso exterior le permite relajarse cuando hace buen tiempo."
    ],
    "nl": [
      "Liefhebbers van de Portugese keuken komen in ons etablissement volledig aan hun trekken. Dankzij onze mooie buitenkant kunt u zich bij mooi weer ontspannen."
    ]
  },
