  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/8bf54950-4a07-3403-b341-1eafdf429b3a",
      "dc:description": {
        "de": [
          "Das Restaurant des Tennisplatzes wird zu La Nonna!\nEin Restaurant, das Ihnen typisch italienische Gerichte in einer gemütlichen Atmosphäre anbietet!\nZwischen Pizza, Pasta und authentischem Aperitivo gibt es etwas, das Ihre Geschmacksknospen wecken wird!"
        ],
        "en": [
          "The tennis restaurant becomes La Nonna!\nA restaurant offering typical Italian dishes in a warm atmosphere!\nWith authentic pizzas, pasta and aperitivo, there's plenty to tantalize your taste buds!"
        ],
        "it": [
          "Il ristorante del tennis diventa La Nonna!\nUn ristorante che offre piatti tipici italiani in un'atmosfera accogliente!\nCon pizze autentiche, pasta e aperitivi, c'è di che deliziare il vostro palato!"
        ],
        "fr": [
          "Le restaurant du tennis devient La Nonna !\nUn restaurant, vous proposant des plats typiques d'Italie avec une ambiance chaleureuse !\nEntre pizza, pasta et aperitivo authentiques, il y a de quoi éveiller vos papilles !"
        ],
        "es": [
          "¡El restaurante de tenis se convierte en La Nonna!\nUn restaurante que ofrece platos típicos italianos en un ambiente acogedor\nAuténticas pizzas, pastas y aperitivos para todos los gustos"
        ],
        "nl": [
          "Het tennisrestaurant wordt La Nonna!\nEen restaurant met typisch Italiaanse gerechten in een warme sfeer!\nMet authentieke pizza's, pasta's en aperitivo is er genoeg om je smaakpapillen te verleiden!"
        ]
      },
