      "@id": "https://data.datatourisme.fr/0f88b2ce-dd00-3ab7-ba0c-aa35be4b6376",
      "dc:description": {
        "de": [
          "Treffen Sie sich am Sonntag, den 8. Juni ab 15 Uhr im Jardin Paisible zu einem musikalischen Spaziergang\nVerpassen Sie nicht die Veranstaltung \"Rendez-vous aux jardins\" vom 6. bis 8. Juni"
        ],
        "en": [
          "Rendezvous at the Jardin Paisible on Sunday June 8 from 3pm for a musical stroll\nDon't miss the \"Rendez-vous aux jardins\" event from June 6 to 8"
        ],
        "it": [
          "Appuntamento al Jardin Paisible domenica 8 giugno dalle 15.00 per una passeggiata musicale\nNon perdete l'evento \"Rendez-vous nei giardini\" dal 6 all'8 giugno"
        ],
        "fr": [
          "Rendez-vous au Jardin Paisible le dimanche 8 juin à partir 15h pour une balade musicale\nNe manquez pas l'événement \"Rendez-vous aux jardins\" du 6 au 8 juin"
        ],
        "es": [
          "Cita en el Jardín Paisible el domingo 8 de junio a partir de las 15.00 h para un paseo musical\nNo se pierda la \"Cita en los jardines\" del 6 al 8 de junio"
        ],
        "nl": [
          "Afspraak in de Jardin Paisible op zondag 8 juni vanaf 15u voor een muzikale wandeling\nMis het evenement \"Rendez-vous in de Tuinen\" niet van 6 tot 8 juni"
        ]
      },
