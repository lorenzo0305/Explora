  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/636f3deb-ab19-3e44-a9fd-ab9daf476b03",
      "dc:description": {
        "de": [
          "Start der Weihnachtsbeleuchtung\nFreitag, den 05. Dezember 2025 um 17.30 Uhr\nJardin de l'Eglise, rue de l'Eglise, Heiße Getränke und Verteilung von Süßigkeiten durch Saint Nicolas\nVollständiges Programm der Stadt unter: www.ville-neufchatel-hardelot.fr"
        ],
        "en": [
          "Christmas Lights Launch\nFriday, December 05, 2025 at 5:30pm\nJardin de l'Eglise, rue de l'Eglise, Hot drinks and distribution of sweets by Saint Nicolas\nFull town program at: www.ville-neufchatel-hardelot.fr"
        ],
        "it": [
          "Lancio delle luci di Natale\nVenerdì 05 dicembre 2025 alle 17.30\nJardin de l'Eglise, rue de l'Eglise, bevande calde e distribuzione di dolci da parte di Saint Nicolas\nProgramma completo della città su: www.ville-neufchatel-hardelot.fr"
        ],
        "fr": [
          "Lancement des Illuminations de Noël\nVendredi 05 décembre 2025 à 17h30\nJardin de l'Eglise, rue de l'Eglise, Boissons chaudes et distribution de friandises par Saint Nicolas\nProgramme de la ville complet sur : www.ville-neufchatel-hardelot.fr"
        ],
        "nl": [
          "Lancering kerstverlichting\nVrijdag 05 december 2025 om 17.30 uur\nJardin de l'Eglise, rue de l'Eglise, Warme dranken en uitdelen van snoepgoed door Sinterklaas\nVolledig stadsprogramma op: www.ville-neufchatel-hardelot.fr"
        ],
        "es": [
          "Inauguración de las luces de Navidad\nViernes 05 de diciembre 2025 a las 17h30\nJardin de l'Eglise, rue de l'Eglise, bebidas calientes y distribución de dulces por San Nicolás\nPrograma completo de la ciudad en: www.ville-neufchatel-hardelot.fr"
        ]
      },
