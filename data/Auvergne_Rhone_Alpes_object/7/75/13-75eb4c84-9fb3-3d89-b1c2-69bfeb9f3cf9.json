  "rdfs:comment": {
    "de": [
      "Angehende Ermittler, Liebhaber kleiner Wanderungen, begeisterte Anhänger der Via Fluvia - dieses Spiel ist für Sie! Diese Schatzsuche führt Sie zwischen Champagne und Peyraud, um die Ufer der Rhône bis zur alten Eisenbahnstrecke zu entdecken."
    ],
    "en": [
      "Whether you're a budding investigator, a keen hiker or a Via Fluvia enthusiast, this game is for you! This treasure hunt will take you from Champagne to Peyraud, along the banks of the Rhône to the old railroad line."
    ],
    "it": [
      "Se siete investigatori in erba, appassionati di escursioni o fan della Via Fluvia, questo gioco fa per voi! Questa caccia al tesoro vi porterà tra Champagne e Peyraud alla scoperta delle rive del Rodano fino alla vecchia linea ferroviaria."
    ],
    "fr": [
      "Enquêteurs en herbe, amateurs de petite randonnée, fervent pratiquants de la Via Fluvia, ce jeu est pour vous ! Cette chasse aux trésors vous emmènera entre Champagne et Peyraud afin de découvrir les berges du Rhône jusqu'à l'ancienne voie ferrée."
    ],
    "es": [
      "Si es un investigador en ciernes, un senderista entusiasta o un apasionado de la Vía Fluvial, ¡este juego es para usted! Esta búsqueda del tesoro le llevará entre Champagne y Peyraud para descubrir las orillas del Ródano hasta la antigua vía férrea."
    ],
    "nl": [
      "Of je nu een onderzoeker in de dop, een fervente wandelaar of een enthousiaste Via Fluvia fan bent, dit spel is voor jou! Deze speurtocht brengt je tussen Champagne en Peyraud om de oevers van de Rhône te ontdekken tot aan de oude spoorlijn."
    ]
  },
  "rdfs:label": {
    "en": [
      "Fun on foot N°6: The spell of the Via Fluvia and the banks of the Rhône"
    ],
    "fr": [
      "Enquête ludique à pied N°6 : Le sortilège de la Via Fluvia et des berges du Rhône"
    ]
  },
