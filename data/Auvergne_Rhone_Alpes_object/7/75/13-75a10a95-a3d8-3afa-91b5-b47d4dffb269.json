  "rdfs:comment": {
    "de": [
      "Eröffnung des Restaurants am 27. Februar.\r\nÀ la carte-Gerichte, Themenmenüs, Tellergerichte, Tagesmenu : Vorspeise, Hauptgang, Käse, Dessert, 1/4 Wein, Kaffee.\r\nTruffade, gratinierte Schweinefüße, Essen zum Mitnehmen.\r\nMittag- und Abendessen für Gruppen nach Voranmeldung."
    ],
    "en": [
      "Welcome to the Guinguette of Biollet.\r\nÀ la carte meals, themed menus, platters, worker meals: starter, main course, cheese, dessert, coffee.\r\nTruffade, pig's trotters au gratin, dish to take away.\r\nGroups for lunch and dinner by reservation."
    ],
    "it": [
      "Benvenuti alla Guinguette de Biollet! Pasti à la carte nel fine settimana, menu a tema, vassoi.\r\nPasto: antipasto, piatto principale, formaggio, dessert, caffè.\r\nTruffade e zampone gratinato su prenotazione.\r\nDa asporto.\r\nPranzi e serate per gruppi su prenotazione."
    ],
    "fr": [
      "Bienvenue à la Guinguette de Biollet! Repas à la Carte du week-end, menus à thème, planches.\r\nRepas ouvrier: entrée, plat, fromage, dessert, café. \r\nTruffade et pieds de cochon gratinés sur réservation.\r\nPlat à emporter.\r\nGroupes midi et soir sur réservation."
    ],
    "es": [
      "¡Bienvenido a la Guinguette de Biollet! Comidas a la carta los fines de semana, menús temáticos, bandejas.\r\nComida obrera: entrante, plato principal, queso, postre, café.\r\nTruffade y manitas de cerdo gratinadas previa reserva.\r\nComida para llevar.\r\nGrupos a mediodía y por la noche con reserva previa."
    ],
    "nl": [
      "Welkom bij Guinguette de Biollet! Maaltijden à la carte, themamenu's, schotels, arbeidersmaaltijden: voorgerecht, hoofdgerecht, kaas, dessert, 1/4 wijn, koffie. Truffel, gegratineerde varkenspoot, afhaalmaaltijden.\r\nGroepen 's middags en 's avonds op afspraak."
    ]
  },
