  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/1594c2d1-0b77-3c5e-a5ac-529fe56dcb44",
      "dc:description": {
        "de": [
          "Entdecken Sie Kimlee, ein Familienrestaurant, in dem die koreanische Küche zum Leben erweckt wird! Genießen Sie Spezialitäten wie Bibimbap, die verschiedenen Jjigae oder das koreanische Barbecue. Lassen Sie sich von einem einzigartigen kulinarischen Erlebnis in einer warmen und freundlichen Umgebung verführen. Eine echte Einladung zu einer geschmacklichen Reise, die von Kim und Céline mit Leidenschaft zubereitet wird."
        ],
        "en": [
          "Discover Kimlee, a family-run restaurant where Korean cuisine comes to life! Enjoy specialties such as bibimbap, various jjigae and Korean barbecue. Let yourself be tempted by a unique culinary experience in a warm and friendly setting. A true invitation to a gustatory voyage, prepared with passion by Kim and Céline."
        ],
        "it": [
          "Scoprite Kimlee, un ristorante a conduzione familiare dove la cucina coreana prende vita! Assaggiate specialità come il bibimbap, vari jjigae e il barbecue coreano. Lasciatevi tentare da un'esperienza culinaria unica in un ambiente caldo e accogliente. È un invito a un viaggio culinario, preparato con passione da Kim e Céline."
        ],
        "fr": [
          "Découvrez Kimlee, un restaurant familial où la cuisine coréenne prend vie ! Savourez des spécialités comme le bibimbap, les différents jjigae, ou encore le barbecue coréen. Laissez-vous tenter par une expérience culinaire unique dans un cadre chaleureux et convivial. Une véritable invitation au voyage gustatif, préparée avec passion par Kim et Céline."
        ],
        "nl": [
          "Ontdek Kimlee, een familierestaurant waar de Koreaanse keuken tot leven komt! Geniet van specialiteiten zoals bibimbap, verschillende jjigae en Koreaanse barbecue. Laat je verleiden door een unieke culinaire ervaring in een warme en vriendelijke omgeving. Het is een uitnodiging voor een culinaire reis, met passie bereid door Kim en Céline."
        ],
        "es": [
          "Descubra Kimlee, un restaurante familiar donde la cocina coreana cobra vida Disfrute de especialidades como el bibimbap, varios jjigae y la barbacoa coreana. Déjese tentar por una experiencia culinaria única en un ambiente cálido y acogedor. Es una invitación a un viaje culinario, preparado con pasión por Kim y Céline."
        ]
      },
