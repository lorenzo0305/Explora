  "rdfs:comment": {
    "de": [
      "Das Fremdenverkehrsamt von Bramans informiert Sie über die natürlichen und kulturellen Reichtümer, die es zu entdecken gilt, um Ihren Urlaub in den Bergen zu verschönern. Auskünfte über Animationen, Aktivitäten, Spaziergänge."
    ],
    "en": [
      "The Bramans Tourist Office can tell you all about the natural and cultural treasures to be discovered during your mountain holiday. Information on events, activities and walks."
    ],
    "it": [
      "L'Ente di Turismo di Bramans vi racconta i tesori naturali e culturali da scoprire durante la vostra vacanza in montagna. Informazioni su eventi, attività e passeggiate."
    ],
    "fr": [
      "L'Office de Tourisme de Bramans vous renseigne sur les richesses naturelles et culturelles à découvrir pour agrémenter vos vacances en montagne. Renseignements sur les animations, activités, balades."
    ],
    "es": [
      "La Oficina de Turismo de Bramans le informará sobre los tesoros naturales y culturales que podrá descubrir durante sus vacaciones en la montaña. Información sobre eventos, actividades y paseos."
    ],
    "nl": [
      "Het Bramans Toeristenbureau kan je alles vertellen over de natuurlijke en culturele schatten die je tijdens je vakantie in de bergen kunt ontdekken. Informatie over evenementen, activiteiten en wandelingen."
    ]
  },
