  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/2a3e408b-12da-30e0-9695-dde93c698758",
      "dc:description": {
        "de": [
          "In diesem magischen Garten des Engelkekses, in Natur- und Gourmetfarben.<br> Wunderschöne, raffinierte Kekse, eingeschlossen in hübschen, dekorierten Pappelschachteln, begleitet von kristallisierten Blättern und Blumen"
        ],
        "en": [
          "In this magical angelic cookie garden, with its natural and gourmet colors <br>Magnificent refined cookies, confined in beautifully decorated poplar boxes, accompanied by crystallized leaves and flowers"
        ],
        "it": [
          "In questo magico giardino di biscotti all'angelica, dai colori naturali e golosi, meravigliosi e raffinati biscotti, racchiusi in graziose scatole di pioppo decorate, accompagnati da foglie e fiori cristallizzati"
        ],
        "fr": [
          "Dans ce jardin magique du biscuit angélique, aux couleurs nature et gourmande.<br>Des merveilleux biscuit raffinés, confinés dans de jolies écrins en peuplier décorés, accompagnés de feuilles et de fleurs cristallisées"
        ],
        "nl": [
          "In deze magische engelachtige koekjestuin, met zijn natuurlijke en gastronomische kleuren, zijn prachtige verfijnde koekjes verpakt in mooie versierde populierenhouten doosjes, vergezeld van gekristalliseerde bladeren en bloemen"
        ],
        "es": [
          "En este mágico jardín de galletas de angélica, con sus colores naturales y gourmet, maravillosas galletas refinadas, confinadas en bonitas cajas de álamo decoradas, acompañadas de hojas y flores cristalizadas"
        ]
      },
      "@type": [
        "Description"
      ],
