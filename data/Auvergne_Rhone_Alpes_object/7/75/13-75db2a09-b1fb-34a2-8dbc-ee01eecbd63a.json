  "rdfs:comment": {
    "de": [
      "Fanny: Ich baue Biogemüse an, das natürlich, schmackhaft und voller Lebenskraft ist.\r\nFred: Gibt Theaterunterricht für Jung und Alt, sowohl Text als auch Improvisation."
    ],
    "en": [
      "Fanny: I grow organic vegetables, natural, tasty and full of vitality.\r\nFred: I give acting lessons for young and old, both text and improv."
    ],
    "it": [
      "Fanny: coltivo ortaggi biologici, naturali, gustosi e pieni di vitalità.\r\nFred: do lezioni di teatro per grandi e piccini, sia di testo che di improvvisazione."
    ],
    "fr": [
      "Fanny : Je cultive des légumes bio, naturels, savoureux et pleins de vitalités. \r\nFred : donne des cours de théâtre pour petits et grands, aussi bien du texte que de l'impro."
    ],
    "nl": [
      "Fanny: Ik verbouw biologische groenten die natuurlijk, lekker en vitaal zijn.\r\nFred: Ik geef toneellessen voor jong en oud, zowel tekst als improvisatie."
    ],
    "es": [
      "Fanny: Cultivo verduras ecológicas, naturales, sabrosas y llenas de vitalidad.\r\nFred: Doy clases de teatro para jóvenes y mayores, que incluyen tanto texto como improvisación."
    ]
  },
  "rdfs:label": {
