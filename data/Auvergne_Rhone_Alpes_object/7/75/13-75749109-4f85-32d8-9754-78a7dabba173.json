  "rdfs:comment": {
    "de": [
      "Unsere Verpflichtungen: Wir wählen für Sie die besten Modelle jeder Marke aus und liefern Ihnen Ski- und Snowboardausrüstung in perfektem Zustand sowie getrocknete und keimfreie Schuhe."
    ],
    "en": [
      "Our commitment: to select the best models from each brand and supply you with ski and snowboard equipment in perfect condition and boots that are dried and sanitized."
    ],
    "it": [
      "Il nostro impegno: selezionare i migliori modelli di ogni marca e fornirvi attrezzatura da sci e snowboard in perfette condizioni e scarponi asciugati e igienizzati."
    ],
    "fr": [
      "Nos engagements : sélectionner pour vous les meilleurs modèles de chaque marque et vous fournir un matériel de ski et de snowboard en parfait état et des chaussures séchées et aseptisées."
    ],
    "nl": [
      "Onze belofte: de beste modellen van elk merk selecteren en je ski- en snowboarduitrusting in perfecte staat en schoenen die gedroogd en gezuiverd zijn, leveren."
    ],
    "es": [
      "Nuestro compromiso: seleccionar los mejores modelos de cada marca y suministrarle material de esquí y snowboard en perfecto estado y botas secas e higienizadas."
    ]
  },
