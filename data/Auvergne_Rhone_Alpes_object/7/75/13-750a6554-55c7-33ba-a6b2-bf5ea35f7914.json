  "rdfs:comment": {
    "de": [
      "Das Maison Pour Tous belebt das lokale Leben mit kulturellen, künstlerischen und sportlichen Aktivitäten und geselligen Veranstaltungen. Es wird von Freiwilligen verwaltet und funktioniert dank ehrenamtlicher Tätigkeit und solidarischer Beiträge. Teilen Sie Ihre Leidenschaften mit ihnen!"
    ],
    "en": [
      "The Maison Pour Tous brings local life to life with cultural, artistic and sporting activities, as well as convivial events. Run by volunteers, it operates on a voluntary basis and through solidarity contributions. Share your passions with them!"
    ],
    "it": [
      "La Maison Pour Tous anima la vita locale con attività culturali, artistiche e sportive, oltre a eventi conviviali. Gestita da volontari, opera sulla base del volontariato e dei contributi di solidarietà. Condividete con loro le vostre passioni!"
    ],
    "fr": [
      "La Maison Pour Tous anime la vie locale avec des activités culturelles, artistiques, sportives et des événements conviviaux. Gérée par des bénévoles, elle fonctionne grâce au volontariat et à des cotisations solidaires. Partagez vos passions avec eux !"
    ],
    "es": [
      "La Maison Pour Tous anima la vida local con actividades culturales, artísticas y deportivas, así como actos amistosos. Dirigida por voluntarios, funciona a base de trabajo voluntario y contribuciones solidarias. ¡Comparta con ellos sus pasiones!"
    ],
    "nl": [
      "Het Maison Pour Tous brengt het lokale leven tot leven met culturele, artistieke en sportieve activiteiten en gezellige evenementen. Het wordt gerund door vrijwilligers en werkt op basis van vrijwilligerswerk en solidariteitsbijdragen. Deel je passies met hen!"
    ]
  },
