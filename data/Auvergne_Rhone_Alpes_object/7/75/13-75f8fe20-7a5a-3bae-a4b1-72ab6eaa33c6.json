  "rdfs:comment": {
    "de": [
      "Stadtzentrum Saint Gervais, offen für alle, Hotel C?UR DES NEIGES Massagen RELAXANTS Tischheizung professionelle Öle gegen Verspannungen und Müdigkeit. NEUE SPORTIFER-MASSAGE®, belebend mit starkem Druck, bessere Erholung vor oder nach dem Sport."
    ],
    "en": [
      "Saint Gervais town centre, open to all, hotel CŒUR DES NEIGES RELAXING massages heated table professional oils for tension and fatigue. NEW SPORTSMASSAGE®, toning massage with strong pressure, for better recovery before or after exercise."
    ],
    "it": [
      "Centro città di Saint Gervais, aperto a tutti, hotel CŒUR DES NEIGES Massaggi rilassanti su tavolo riscaldato con oli professionali per le tensioni e la fatica. NUOVO SPORTSMASSAGE®, massaggio tonificante con forti pressioni, per un migliore recupero prima o dopo l'attività fisica."
    ],
    "fr": [
      "Centre ville Saint Gervais, ouvert à tous, hôtel CŒUR DES NEIGES massages RELAXANTS table chauffée huiles professionnelles pour tensions et fatigue. NOUVEAU massage du SPORTIF®, tonique à pression forte, meilleure récupération avant ou après l’effort."
    ],
    "nl": [
      "Saint Gervais centrum, open voor iedereen, hotel C?UR DES NEIGES RELAXING massages verwarmde tafel professionele oliën voor spanning en vermoeidheid. NIEUWE SPORTSMASSAGE®, verstevigende massage met sterke druk, voor een beter herstel voor of na het sporten."
    ],
    "es": [
      "Centro de la ciudad de Saint Gervais, abierto a todos, hotel C'UR DES NEIGES MASAJES RELAJANTES mesa caliente aceites profesionales para la tensión y la fatiga. NUEVO SPORTSMASSAGE®, masaje tonificante con fuertes presiones, para una mejor recuperación antes o después del ejercicio."
    ]
  },
