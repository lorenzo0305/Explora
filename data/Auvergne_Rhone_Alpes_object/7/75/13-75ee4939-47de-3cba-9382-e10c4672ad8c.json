  "rdfs:comment": {
    "de": [
      "Ein französischer und authentischer Coffeeshop!\r\nColumbus Café & Co verpflichtet sich, so viel wie möglich mit lokalen Lieferanten zu arbeiten, um die Beschäftigung und das französische Know-how zu fördern."
    ],
    "en": [
      "An authentic French coffee shop!\r\nColumbus Café & Co is committed to working with local suppliers as much as possible, in order to promote employment and French know-how."
    ],
    "it": [
      "Un'autentica caffetteria francese!\r\nColumbus Café & Co si impegna a lavorare il più possibile con fornitori locali per promuovere l'occupazione e il know-how francese."
    ],
    "fr": [
      "Un coffee shop français et authentique !\r\nColumbus Café & Co s’engage à travailler le plus possible avec des fournisseurs locaux afin de favoriser l’emploi et le savoir-faire français."
    ],
    "es": [
      "Un auténtico café francés\r\nColumbus Café & Co se compromete a trabajar en la medida de lo posible con proveedores locales para fomentar el empleo y el saber hacer francés."
    ],
    "nl": [
      "Een authentiek Frans koffiehuis!\r\nColumbus Café & Co doet er alles aan om zoveel mogelijk met lokale leveranciers te werken om de werkgelegenheid en Franse knowhow te bevorderen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Columbus Café & Co - Intermarché Valence"
    ]
  },
