  "rdfs:comment": {
    "de": [
      "Kurse im Schwimmbad Serge Buttet samstags nach vorheriger Anmeldung.\r\nVor- und Nachgeburtskurse mit dem Ehepartner.\r\nAnpassung des Kleinkindes an das Wassermilieu von 6 Monaten bis 6 Jahren mit den Eltern.\r\nKurse für Senioren"
    ],
    "en": [
      "Classes at the Serge Buttet swimming pool on Saturdays by prior arrangement.\r\nPre- and post-natal classes with your partner.\r\nAdapting young children to the aquatic environment, from 6 months to 6 years, with their parents.\r\nSenior courses"
    ],
    "it": [
      "Corsi presso la piscina Serge Buttet il sabato mattina su prenotazione.\r\nCorsi pre e post parto con il proprio partner.\r\nAdattamento dei bambini piccoli all'ambiente acquatico da 6 mesi a 6 anni con i loro genitori.\r\nCorsi per anziani"
    ],
    "fr": [
      "Cours à la piscine Serge Buttet les samedis matins sur réservation.\r\nCours Pré et post-natal avec le conjoint. \r\nAdaptation du jeune enfant au milieu aquatique de 6 mois à 6 ans avec leurs parents.\r\nCours séniors"
    ],
    "nl": [
      "Lessen in het Serge Buttet zwembad op zaterdag op afspraak.\r\nPre- en postnatale lessen met je partner.\r\nAanpassing van jonge kinderen aan het water van 6 maanden tot 6 jaar met hun ouders.\r\nCursussen voor senioren"
    ],
    "es": [
      "Clases en la piscina Serge Buttet los sábados por la mañana con cita previa.\r\nClases prenatales y postnatales con su pareja.\r\nAdaptación de niños pequeños al medio acuático de 6 meses a 6 años con sus padres.\r\nCursos para mayores"
    ]
  },
