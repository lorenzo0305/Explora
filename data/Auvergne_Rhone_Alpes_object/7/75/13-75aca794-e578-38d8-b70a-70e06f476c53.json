  "rdfs:comment": {
    "de": [
      "Vom Tischfußball bis zu den Veteranen und nicht zu vergessen 3 Frauenmannschaften.\r\nDie Trainings und Spiele finden auf den verschiedenen Plätzen der Gemeinden des Kartells statt."
    ],
    "en": [
      "From table soccer to veterans, not forgetting 3 women's teams.\r\nTraining and matches take place on the various pitches in the communes of the association."
    ],
    "it": [
      "Dai baby calciatori ai veterani, senza dimenticare le 3 squadre femminili.\r\nGli allenamenti e le partite si svolgono sui vari campi dei comuni convenzionati."
    ],
    "fr": [
      "Du baby foot aux vétérans sans oublier 3 équipes féminines.\r\nLes entrainements et matchs se déroulent sur les différents terrains des communes de l'entente."
    ],
    "nl": [
      "Van tafelvoetbal tot veteranen en niet te vergeten 3 vrouwenteams.\r\nDe trainingen en wedstrijden vinden plaats op de verschillende velden in de gemeenten van de vereniging."
    ],
    "es": [
      "Desde el baby fútbol hasta los veteranos, sin olvidar 3 equipos femeninos.\r\nLas sesiones de entrenamiento y los partidos tienen lugar en los distintos campos de los municipios del acuerdo."
    ]
  },
  "rdfs:label": {
