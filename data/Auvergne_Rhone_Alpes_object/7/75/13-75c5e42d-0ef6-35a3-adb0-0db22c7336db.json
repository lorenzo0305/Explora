  "rdfs:comment": {
    "de": [
      "St. Patrick's Day-Konzert mit 2 Gruppen\r\nLa Sialyre, ein irisches Musikduo, die Harmonie und Energie von Saiteninstrumenten.\r\nKalänn, keltischer Rock, der nach Meer und endlosen Abenden riecht! Sechs entfesselte Piraten..."
    ],
    "en": [
      "St. Patrick's Day concert with 2 groups\r\nLa Sialyre, an Irish music duo with the harmony and energy of stringed instruments.\r\nKalänn, Celtic rock that smells of the open sea and endless parties! Six wild pirates..."
    ],
    "it": [
      "Concerto di San Patrizio con 2 gruppi\r\nLa Sialyre, un duo di musica irlandese con l'armonia e l'energia degli strumenti a corda.\r\nKalänn, rock celtico che profuma di mare aperto e feste infinite! Sei pirati selvaggi..."
    ],
    "fr": [
      "Concert de la St Patrick avec 2 goupes \r\nLa Sialyre, duo de musique irlandaise, l'harmonie et l'énergie des instruments à cordes.\r\nKalänn, du rock celtique qui sent bon le large et les soirées sans fin ! Six pirates déchaînés..."
    ],
    "nl": [
      "St Patrick's Day concert met 2 groepen\r\nLa Sialyre, een Iers muziekduo met de harmonie en energie van snaarinstrumenten.\r\nKalänn, Keltische rock die ruikt naar de open zee en eindeloze feesten! Zes wilde piraten..."
    ],
    "es": [
      "Concierto del Día de San Patricio con 2 grupos\r\nLa Sialyre, un dúo de música irlandesa con la armonía y la energía de los instrumentos de cuerda.\r\nKalänn, ¡rock celta que huele a mar abierto y a fiestas interminables! Seis piratas salvajes..."
    ]
  },
