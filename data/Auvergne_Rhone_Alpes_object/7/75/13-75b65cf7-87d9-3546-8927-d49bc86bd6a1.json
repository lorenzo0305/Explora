  "rdfs:comment": {
    "de": [
      "Entdecken Sie ein neues Sport-Erlebnis in der virtuellen Realität, treten Sie gegen Ihre Freunde auf der 500 m² großen Arena an und nutzen Sie die CyberBar (Getränke und Snacks). Organisieren Sie Ihre private Veranstaltung (Konferenzraum, Privatisierung, Afterwork, Team Building, ?)"
    ],
    "en": [
      "Discover a new esport experience in virtual reality, take on your friends on the 500 m² arena and enjoy the CyberBar (drinks and snacks). Organize your private event (conference room, privatization, afterwork, team building, etc.)"
    ],
    "it": [
      "Scoprite una nuova esperienza di esport in realtà virtuale, sfidate i vostri amici nell'arena di 500 m² e godetevi il CyberBar (bevande e snack). Organizzate il vostro evento privato (sala conferenze, privatizzazione, afterwork, team building, ecc.)"
    ],
    "fr": [
      "Découvrez une nouvelle expérience de esport en réalité virtuelle, affrontez vos amis sur l’aréne de 500 m² et profitez du CyberBar (boissons et snacking). Organisez votre événement privé (salle de conférence, privatisation, afterwork, team building,…)"
    ],
    "nl": [
      "Ontdek een nieuwe esportervaring in virtual reality, neem het op tegen je vrienden in de arena van 500 m² en geniet van de CyberBar (drankjes en snacks). Organiseer je privé-evenement (vergaderzaal, privatisering, afterwork, teambuilding enz.)"
    ],
    "es": [
      "Descubra una nueva experiencia esport en realidad virtual, enfréntese a sus amigos en la arena de 500 m² y disfrute del CyberBar (bebidas y aperitivos). Organice su evento privado (sala de conferencias, privatización, afterwork, team building, etc.)"
    ]
  },
  "rdfs:label": {
    "fr": [
      "EVA Réalité virtuelle"
    ]
  },
