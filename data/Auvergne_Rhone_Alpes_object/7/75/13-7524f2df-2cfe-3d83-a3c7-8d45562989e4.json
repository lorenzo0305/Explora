  "rdfs:comment": {
    "de": [
      "Der Parc de la Croix de Garry ist ein 16 ha großer Naturraum in der Nähe des Zentrums von Saint-Genest-Malifaux und ein echter Ort der Entspannung.\r\nDie Wasserfläche und der Fluss Semène heißen Sie für Ihre Angelpartien willkommen.\r\nIn der Nähe: Spielplatz, botanischer Pfad."
    ],
    "en": [
      "The Parc de la Croix de Garry is a 16-hectare natural area close to the center of Saint-Genest-Malifaux.\r\nThe lake and the Semène river are ideal for fishing.\r\nNearby: playground, botanical trail."
    ],
    "it": [
      "Il Parc de la Croix de Garry è una riserva naturale di 16 ettari vicino al centro di Saint-Genest-Malifaux.\r\nIl lago e il fiume Semène sono ideali per la pesca.\r\nNelle vicinanze: parco giochi, percorso botanico."
    ],
    "fr": [
      "Véritable lieu de détente, le Parc de la Croix de Garry est un espace naturel de 16ha, proche du centre de Saint-Genest-Malifaux.\r\nLe plan d'eau et la rivière Semène vous accueille pour vos parties de pêche.\r\nA proximité : aire de jeux, sentier botanique."
    ],
    "nl": [
      "Het Parc de la Croix de Garry is een natuurreservaat van 16 hectare vlakbij het centrum van Saint-Genest-Malifaux.\r\nHet meer en de rivier Semène zijn ideaal om te vissen.\r\nIn de buurt: speeltuin, botanisch pad."
    ],
    "es": [
      "El Parque de la Croix de Garry es una reserva natural de 16 hectáreas cerca del centro de Saint-Genest-Malifaux.\r\nEl lago y el río Semène son ideales para pescar.\r\nCerca: parque infantil, sendero botánico."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Plan d'eau de la Croix de Garry"
    ]
  },
