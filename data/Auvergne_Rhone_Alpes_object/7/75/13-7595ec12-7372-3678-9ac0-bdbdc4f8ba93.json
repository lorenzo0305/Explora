  "rdfs:comment": {
    "de": [
      "Geländezentrum, das Aktivitäten für Kinder ab 9 Jahren und Erwachsene anbietet. Kurze Einführungskurse auf privatem Gelände für Kinder, eineinhalbstündige bis ganztägige Ausflüge für Erwachsene mit Quads oder Motorrädern."
    ],
    "en": [
      "All-terrain centre offering activities for children from 9 years old and adults. Short-term initiation on private terrain for children, 1.5 hour rides for adults, on quad or motorbike."
    ],
    "it": [
      "Centro all terrain che offre attività per bambini dai 9 anni in su e per adulti. Brevi corsi introduttivi su terreni privati per i bambini, escursioni di un'ora e mezza o di un'intera giornata per gli adulti, in quad o in moto."
    ],
    "fr": [
      "Centre tout terrain proposant des activités pour enfants dès 9 ans et adultes. Initiation sur courte durée sur terrain privé pour les enfants, randonnées d'une heure trente à la journée pour les adultes, en quad ou moto."
    ],
    "nl": [
      "Terreincentrum met activiteiten voor kinderen vanaf 9 jaar en volwassenen. Korte introductiecursussen op privéterrein voor kinderen, tochten van anderhalf uur tot een hele dag voor volwassenen, op quad of motor."
    ],
    "es": [
      "Centro todoterreno que ofrece actividades para niños a partir de 9 años y adultos. Cursos cortos de iniciación en terrenos privados para niños, excursiones de una hora y media a un día completo para adultos, en quads o motos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Auvergne motos loisirs - randonnées, initiation"
    ]
  },
