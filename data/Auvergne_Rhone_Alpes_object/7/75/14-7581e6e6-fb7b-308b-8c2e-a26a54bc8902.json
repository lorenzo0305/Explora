  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/b605f1e5-f739-3ca3-bbe3-df990e5d7d8b",
      "dc:description": {
        "de": [
          "Für 3- bis 10-Jährige - Kommt verkleidet!\nDienstag, 17. Februar von 14:30 bis 16:00 Uhr\nDer Bauernhof meiner Kindheit\n-------------------------\nVerkleide dein Pony für einen Ausritt zum Preis von 20?\n\nEin Erwachsener muss anwesend sein\nJeder Reiter erhält einen Crêpe\nReservierungen: 06 11 01 84 93\n\nCredit: Pixabay"
        ],
        "en": [
          "For ages 3-10 - Come in costume!\nTuesday, February 17, 2:30 pm to 4 pm\nMy Childhood Farm\n-------------------------\nDress up your pony for a ride for 20?\n\nAn adult must be present\nPancakes offered to each rider\nReservations: 06 11 01 84 93\n\nCredit : Pixabay"
        ],
        "it": [
          "Per bambini dai 3 ai 10 anni - Venite vestiti!\nMartedì 17 febbraio dalle 14.30 alle 16.00\nLa fattoria della mia infanzia\n-------------------------\nVesti il tuo pony per una cavalcata di 20?\n\nDeve essere presente un adulto\nFrittelle offerte ad ogni cavaliere\nPrenotazioni: 06 11 01 84 93\n\nCredito : Pixabay"
        ],
        "fr": [
          "Pour les 3-10 ans - Venez déguisés !\nMardi 17 février de 14h30 à 16h\nLa Ferme de mon Enfance\n-------------------------\nDéguise ton poney pour une balade au tarif de 20€ !\n\nPrésence d’un adulte obligatoire\nCrêpe offerte à chaque cavalier\nRéservations : 06 11 01 84 93\n\nCrédit : Pixabay"
        ],
        "nl": [
          "Voor kinderen van 3-10 jaar - Kom verkleed!\nDinsdag 17 februari van 14.30 tot 16.00 uur\nBoerderij uit mijn kindertijd\n-------------------------\nJe pony aankleden voor een ritje van 20?\n\nEen volwassene moet aanwezig zijn\nPannenkoeken aangeboden aan elke ruiter\nBoekingen: 06 11 01 84 93\n\nKrediet : Pixabay"
        ],
        "es": [
          "Para niños de 3 a 10 años - ¡Ven disfrazado!\nMartes 17 de febrero de 14h30 a 16h00\nLa granja de mi infancia\n-------------------------\nDisfraza a tu poni para dar un paseo de 20?\n\nUn adulto debe estar presente\nTortitas ofrecidas a cada jinete\nReservas: 06 11 01 84 93\n\nCrédito : Pixabay"
        ]
      },
