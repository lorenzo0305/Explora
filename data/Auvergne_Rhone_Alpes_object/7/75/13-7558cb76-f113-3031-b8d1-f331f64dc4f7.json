  "rdfs:comment": {
    "de": [
      "4 außergewöhnliche Lodges mit privatem Jacuzzi und Panoramablick auf den Mézenc. 32m² große Suiten mit allem Komfort, bioklimatische Pergola-Terrasse. Aufnahme von 2 bis 4 Personen. Eine intime und erholsame Klammer in der Haute-Loire, in Dunières."
    ],
    "en": [
      "4 exceptional lodges with private Jacuzzi and panoramic view of the Mezenc. Comfortable 32m² suites, bioclimatic pergola terrace. Sleeps 2 to 4. An intimate and rejuvenating interlude in Dunières, Haute-Loire."
    ],
    "it": [
      "4 lodge eccezionali con vasca idromassaggio privata e vista panoramica sul Mezenc. Confortevoli suite di 32 m², terrazza con pergola bioclimatica. Posti letto da 2 a 4 persone. Una parentesi intima e rigenerante a Dunières, nell'Alta Loira."
    ],
    "fr": [
      "4 lodges d'exception avec jacuzzi privatif et vue panoramique sur le Mézenc. Suites de 32m² tout confort, terrasse pergola bioclimatique. Accueil 2 à 4 personnes. Une parenthèse intimiste et ressourçante en Haute-Loire, à Dunières."
    ],
    "nl": [
      "4 uitzonderlijke lodges met privéjacuzzi en panoramisch uitzicht op de Mezenc. Comfortabele suites van 32 m², bioklimatologisch pergolaterras. Voor 2 tot 4 personen. Een intiem en verjongend intermezzo in Dunières, Haute-Loire."
    ],
    "es": [
      "4 alojamientos excepcionales con jacuzzi privado y vista panorámica del Mezenc. Confortables suites de 32 m², terraza con pérgola bioclimática. Capacidad de 2 a 4 personas. Un paréntesis íntimo y rejuvenecedor en Dunières, Alto Loira."
    ]
  },
