  "rdfs:comment": {
    "de": [
      "Das Château des Comtes de Challes bietet eine traumhafte Kulisse, um Ihren Urlaubs- oder Geschäftsaufenthalt in einen unvergesslichen Moment zu verwandeln."
    ],
    "en": [
      "This 15th century castle blends the features of an aristocratic residence with functional modernity.\r\nThree Gault et Millau keys and approved by the Châteaux et Hôtels Collection.\r\nGastronomic restaurant (3 forks in the Michelin guide) open seven days a week."
    ],
    "it": [
      "Lo Château des Comtes de Challes offre una cornice da sogno per trasformare il vostro soggiorno di vacanza o di lavoro in un momento indimenticabile."
    ],
    "fr": [
      "Le Château des Comtes de Challes offre un cadre de rêve pour transformer votre séjour de vacances ou d'affaires en un instant inoubliable."
    ],
    "nl": [
      "Het Château des Comtes de Challes biedt een droomomgeving om van uw vakantie- of zakenverblijf een onvergetelijk moment te maken."
    ],
    "es": [
      "El Château des Comtes de Challes ofrece un marco de ensueño para convertir su estancia de vacaciones o de negocios en un momento inolvidable."
    ]
  },
