  "rdfs:comment": {
    "de": [
      "Das Amt verfügt über einen warmen und geräumigen Empfangsbereich, in dem die Besucher Broschüren, Informationstafeln und einen Kinderbereich vorfinden."
    ],
    "en": [
      "The office has a warm and spacious reception area where visitors will find brochures, information panels and a children's area."
    ],
    "it": [
      "L'ufficio dispone di una reception accogliente e spaziosa, dove i visitatori troveranno opuscoli, pannelli informativi e un'area per i bambini."
    ],
    "fr": [
      "L'office dispose d'un espace d'accueil chaleureux et spacieux où les visiteurs trouveront des brochures, des panneaux d'information et un espace enfant."
    ],
    "es": [
      "La oficina cuenta con una recepción cálida y espaciosa donde los visitantes encontrarán folletos, paneles informativos y una zona infantil."
    ],
    "nl": [
      "Het kantoor heeft een warme en ruime receptie waar bezoekers brochures, informatiepanelen en een kinderhoek vinden."
    ]
