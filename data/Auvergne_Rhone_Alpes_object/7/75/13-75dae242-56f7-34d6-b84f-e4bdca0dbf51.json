  "rdfs:comment": {
    "de": [
      "Quentin Petit hat sich schon immer für Design begeistert, zunächst in der Automobilbranche. Er hat schon immer gerne entworfen, hergestellt und war bei jedem Schritt des kreativen Prozesses dabei."
    ],
    "en": [
      "Quentin Petit has always been passionate about design, initially in the automotive field. He has always enjoyed designing, manufacturing and being present at every stage of the creative process."
    ],
    "it": [
      "Quentin Petit ha sempre avuto la passione per il design, iniziando nel settore automobilistico. Gli è sempre piaciuto progettare, produrre ed essere coinvolto in ogni fase del processo creativo."
    ],
    "fr": [
      "Quentin Petit a toujours été passionné de design, au départ dans l’ automobile. Il a toujours aimé concevoir, fabriquer, être présent à chaque étape d’un processus de création."
    ],
    "es": [
      "Quentin Petit siempre ha sentido pasión por el diseño, empezando en la industria del automóvil. Siempre ha disfrutado diseñando, fabricando y participando en todas las fases del proceso creativo."
    ],
    "nl": [
      "Quentin Petit heeft altijd een passie gehad voor ontwerpen en is begonnen in de auto-industrie. Hij heeft er altijd van genoten om te ontwerpen, te produceren en betrokken te zijn bij elke fase van het creatieve proces."
    ]
  },
