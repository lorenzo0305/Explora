  "rdfs:comment": {
    "de": [
      "Besuch des Weinguts von Francine & Clément, junge Bio-Winzer, die sich seit 2022 niedergelassen haben. Besuchen Sie uns, um unsere Weine und unsere Arbeitsmethoden kennenzulernen, die die Erde und das Leben respektieren. Bio-zertifiziert für den Condrieu."
    ],
    "en": [
      "Visit the winery of Francine & Clément, young organic winemakers established in 2022. Come and meet us to discover our wines and our working methods, which respect the earth and living organisms. Certified organic for Condrieu."
    ],
    "it": [
      "Visitate la cantina di Francine & Clément, giovani viticoltori biologici nati nel 2022. Venite a conoscerci per saperne di più sui nostri vini e sui nostri metodi di lavoro, che rispettano la terra e tutti gli esseri viventi. Certificato biologico per Condrieu."
    ],
    "fr": [
      "Visite du domaine viticole de Francine & Clément, jeunes vignerons en bio installés depuis 2022. Venez nous rencontrer pour découvrir nos vins et nos méthodes de travail respectueuses de la terre et du vivant. Certifié Bio pour le Condrieu."
    ],
    "es": [
      "Visite la bodega de Francine & Clément, jóvenes viticultores ecológicos establecidos en 2022. Venga a conocernos para saber más sobre nuestros vinos y nuestros métodos de trabajo, respetuosos con la tierra y todos los seres vivos. Certificado ecológico para Condrieu."
    ],
    "nl": [
      "Bezoek het wijnhuis van Francine & Clément, jonge biologische wijnboeren opgericht in 2022. Kom en ontmoet ons om meer te weten te komen over onze wijnen en onze werkmethodes, die de aarde en alle levende wezens respecteren. Gecertificeerd biologisch voor Condrieu."
    ]
  },
  "rdfs:label": {
