  "rdfs:comment": {
    "de": [
      "Brotautomat der Bäckerei von Gregory Celle aus dem Dorf Araules.\r\n7 Tage die Woche finden Sie Baguettes und Flûtes am Automaten, praktisch, einfach und im Zentrum des Dorfes!"
    ],
    "en": [
      "Distributor of bread by the bakery of Grégory Celle, in the village of Araules.\r\n7 days / 7 find the baguettes and flutes at the dispenser, practical, simple and in the centre of the village!"
    ],
    "it": [
      "Distributore di pane della panetteria di Grégory Celle nel villaggio di Araules.\r\n7 giorni su 7 potete trovare baguette e flauti al distributore, pratico, semplice e al centro del villaggio!"
    ],
    "fr": [
      "Distributeur de pain par la boulangerie de Grégory Celle, du village d'Araules.\r\n7 jours / 7 retrouvez les baguettes et les flûtes au distributeur, pratique, simple et  dans le centre du village !"
    ],
    "es": [
      "Dispensador de pan de la panadería de Grégory Celle en el pueblo de Araules.\r\nlos 7 días de la semana podrá encontrar baguettes y flautas en el dispensador, práctico, sencillo y en el centro del pueblo"
    ],
    "nl": [
      "Broodautomaat van de bakkerij van Grégory Celle in het dorp Araules.\r\n7 dagen per week kunt u bij de automaat terecht voor stokbrood en fluiten, praktisch, eenvoudig en midden in het dorp!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Boulangerie - Distributeur de pain"
    ]
  },
