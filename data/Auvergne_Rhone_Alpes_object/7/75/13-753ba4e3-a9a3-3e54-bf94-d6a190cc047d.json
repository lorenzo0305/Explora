  "rdfs:comment": {
    "de": [
      "Willkommen bei Sphère Airsoft: Das ultimative Outdoor-Abenteuer!\r\nTauchen Sie mitten in die Action ein, nur 10 Minuten von Valence entfernt.\r\nSphère Airsoft bietet Ihnen das eindringlichste Airsoft-Erlebnis der Region mit Freunden oder der Familie."
    ],
    "en": [
      "Welcome to Sphère Airsoft: The Ultimate Outdoor Adventure\r\nDive into the heart of the action just 10 minutes from Valence.\r\nSphère Airsoft offers the region's most immersive airsoft experience for friends and family."
    ],
    "it": [
      "Benvenuti a Sphère Airsoft!\r\nAttività ricreative con gli amici, EVG/EVJF, uscite di gruppo o team building a soli 10 minuti da Valence.\r\nSphère Airsoft vi offre l'esperienza airsoft più coinvolgente della regione, con gli amici o in squadra."
    ],
    "fr": [
      "Bienvenue chez Sphère Airsoft !\r\nLoisir entre amis, EVG/EVJF, sortie cohésion ou Team building à seulement 10 minutes de Valence.\r\nSphère Airsoft vous offre l’expérience airsoft la plus immersive de la région entre amis ou en équipe."
    ],
    "es": [
      "¡Bienvenido a Sphère Airsoft!\r\nActividades de ocio con amigos, EVG/EVJF, salidas en grupo o team building a sólo 10 minutos de Valence.\r\nSphère Airsoft le ofrece la experiencia de airsoft más envolvente de la región, con amigos o en equipo."
    ],
    "nl": [
      "Welkom bij Sphère Airsoft: Het ultieme buitenavontuur\r\nDuik in het hart van de actie op slechts 10 minuten van Valence.\r\nSphère Airsoft biedt u de meest meeslepende airsoft ervaring in de regio, met vrienden of familie."
    ]
  },
