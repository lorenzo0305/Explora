  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/46f7cbd3-ada9-3ac0-bb18-2d7cd7ff61ec",
      "dc:description": {
        "de": [
          "Informationen :\n\nProdukte: Besuchen Sie die Website von Le Verger d'Epinoy\n\n\nÖffnungszeiten:\n\nDer Laden ist montags bis samstags von 9:30 bis 12:00 Uhr und von 14:00 bis 18:00 Uhr geöffnet\n\nBestellungen:\n\nKontaktieren Sie den Laden telefonisch unter 06 10 15 68 23.\n\nDrive :\n\nDrive ist am Samstagmorgen auf dem Drive de la Ferme möglich.\n\n "
        ],
        "en": [
          "Information :\n\nProducts: Visit the Verger d'Epinoy website\n\n\nOpening days:\n\nThe store is open Monday to Saturday, 9.30am to 12pm and 2pm to 6pm\n\nOrdering :\n\nContact the store by telephone on 06 10 15 68 23.\n\nDrive :\n\nDrive possible on Saturday mornings at Drive de la Ferme.\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nProdotti: Visita il sito web di Verger d'Epinoy\n\n\nGiorni di apertura:\n\nIl negozio è aperto da lunedì a sabato dalle 9.30 alle 12.00 e dalle 14.00 alle 18.00\n\nOrdini :\n\nContattare il negozio telefonicamente al numero 06 10 15 68 23.\n\nGuida :\n\nIl sabato mattina è possibile accedere al Drive de la Ferme.\n\n "
        ],
        "fr": [
          "Informations :\n\nProduits: Consultez le site le Verger d'Epinoy\n\n\nJours d'ouverture: \n\nLe magasin est ouvert du lundi au samedi de 9h30 à 12h et de 14h à 18h\n\nCommandes :\n\nContacter le magasin par téléphone au 06 10 15 68 23.\n\nDrive :  \n\nDrive possible le samedi matin sur le Drive de la Ferme.\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nProducten: Bezoek de website van Verger d'Epinoy\n\n\nOpeningsdagen:\n\nDe winkel is geopend van maandag tot zaterdag van 9.30 tot 12.00 uur en van 14.00 tot 18.00 uur\n\nBestellingen :\n\nNeem telefonisch contact op met de winkel op 06 10 15 68 23.\n\nRijden :\n\nDrive-through beschikbaar op zaterdagochtend op de Drive de la Ferme.\n\n "
        ],
        "es": [
          "Más información :\n\nProductos: Visite la página web del Verger d'Epinoy\n\n\nDías de apertura:\n\nLa tienda está abierta de lunes a sábado de 9.30 a 12 h y de 14 h a 18 h\n\nPedidos :\n\nPóngase en contacto con la tienda por teléfono llamando al 06 10 15 68 23.\n\nConducir :\n\nDrive-through disponible los sábados por la mañana en el Drive de la Ferme.\n\n "
        ]
      },
