  "rdfs:comment": {
    "de": [
      "Bergbegleiter und Lehrer für nordischen Skisport. Ganzjährige Betreuung von Entdeckungs- und Sportwanderungen mit naturkundlichem Ansatz: zu Fuß, mit Schneeschuhen, mit Mountainbikes, mit Trails und mit Nordic Ski."
    ],
    "en": [
      "Mountain leader and Nordic ski instructor. Year-round supervision of discovery and sporting hikes with a naturalist approach: on foot, snowshoe, mountain bike, trail and Nordic ski."
    ],
    "it": [
      "Guida alpina e istruttore di sci nordico. Supervisione tutto l'anno di escursioni di scoperta e sportive con approccio naturalistico: a piedi, con le racchette da neve, in mountain bike, su sentiero e con lo sci nordico."
    ],
    "fr": [
      "Accompagnateur en montagne et moniteur de ski nordique. Encadrement toute l'année, de randonnées découvertes et sportives avec approche naturaliste: à pied, en raquette, en VTT, en trail et en ski nordique."
    ],
    "es": [
      "Monitor de montaña y monitor de esquí nórdico. Supervisión durante todo el año de excursiones de descubrimiento y deportivas con un enfoque naturalista: a pie, con raquetas de nieve, en bicicleta de montaña, por senderos y esquí nórdico."
    ],
    "nl": [
      "Bergleider en nordic-skileraar. Het hele jaar door begeleiding van ontdekkingstochten en sportieve wandelingen met een naturalistische aanpak: te voet, op sneeuwschoenen, mountainbike, trail en nordic ski."
    ]
  },
  "rdfs:label": {
