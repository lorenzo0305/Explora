  "rdfs:comment": {
    "de": [
      "Weingut in St-Haon-le-Vieux. Géraldine und Christophe arbeiten seit 2007 mit Respekt für den Boden und die Pflanze.\r\nDie Weinbereitung erfolgt im Sinne des Weinbergs, ohne jegliche Hilfsmittel oder Sulfite."
    ],
    "en": [
      "Located in St-Haon-le-Vieux, Géraldine and Christophe have been working with respect for the soil and the plant since 2007.\r\nThe winemaking process is in keeping with the spirit of the vine, with no inputs or sulfites."
    ],
    "it": [
      "Géraldine e Christophe lavorano in questa tenuta a St-Haon-le-Vieux dal 2007, rispettando il suolo e la pianta.\r\nLa vinificazione avviene nello spirito della vite, senza apporti né solfiti."
    ],
    "fr": [
      "Domaine situé à St-Haon-le-Vieux, Géraldine et Christophe travaillent dans le respect du sol et de la plante depuis 2007.\r\nLa vinification est dans l'esprit de la vigne, sans aucun intrants ni sulfites."
    ],
    "es": [
      "Géraldine y Christophe trabajan en esta finca de St-Haon-le-Vieux desde 2007, respetando el suelo y la planta.\r\nLa vinificación sigue el espíritu de la vid, sin insumos ni sulfitos."
    ],
    "nl": [
      "Géraldine en Christophe werken sinds 2007 op dit domein in St-Haon-le-Vieux, met respect voor de bodem en de plant.\r\nDe vinificatie gebeurt in de geest van de wijnstok, zonder inputs of sulfieten."
    ]
  },
  "rdfs:label": {
