  "rdfs:comment": {
    "de": [
      "Ein einzigartiger Ort am Ufer der Loire!  Jachthafen, Wassersportbasis, Bar und Strohhütte am Wasser von Mai bis Oktober.  Verleih von Tretbooten, Kanus, Motorbooten mit oder ohne Führerschein. Zuwasserlassen von Jetskis."
    ],
    "en": [
      "A unique site on the banks of the Loire!  Marina, nautical base, bar and straw hut on the waterfront from May to October.  Pedalos, canoes, kayaks and motorboats for hire, with or without a license. Jet-ski launch."
    ],
    "it": [
      "Un sito unico sulle rive della Loira!  Marina, base nautica, bar e capanna di paglia sul lungomare da maggio a ottobre.  Noleggio di pedalò, canoe, kayak e barche a motore, con o senza patente. Lancio di moto d'acqua."
    ],
    "fr": [
      "Un site unique en bord de Loire !  Port de plaisance, base nautique, bar et paillote en bord d'eau de mai à octobre.  Location de pédalos, canoës-kayaks, bateaux à moteur avec ou sans permis. Mise à l'eau de départ de jet-skis."
    ],
    "es": [
      "Un lugar único a orillas del Loira  Puerto deportivo, base náutica, bar y cabaña de paja en el paseo marítimo de mayo a octubre.  Alquiler de pedalós, canoas, kayacs y lanchas motoras con o sin licencia. Lanzadera de motos acuáticas."
    ],
    "nl": [
      "Een unieke plek aan de oevers van de Loire!  Jachthaven, nautische basis, bar en strohut aan de waterkant van mei tot oktober.  Verhuur van waterfietsen, kano's, kajaks en motorboten, met of zonder vaarbewijs. Jet-ski te water laten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Port de Bully"
    ]
  },
