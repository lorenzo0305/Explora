  "rdfs:comment": {
    "de": [
      "Hotel mit 20 Doppel- oder Familienzimmern, ausgestattet mit Badezimmer und Sanitäranlagen. Restaurant mit gepflegter gastronomischer Küche, aber auch Spezialitäten aus Savoyen - Kinderermäßigungen je nach Alter und Zeitraum. Empfang von Gruppen, Catering."
    ],
    "en": [
      "A typical mountain Hotel - restaurant, with a warm atmosphere. Convenient location for skiing (close to the ski area, shuttles) and also in the village.  Located 50 m from the ski slopes. 20 family double rooms, equipped with bathroom, toilet. Restaurant with traditional cuisine, but also, Savoyard specialities - Discounts children according to age and period. Welcome groups, take-away meals, catering."
    ],
    "it": [
      "Hotel con 20 camere doppie o familiari, tutte con bagno privato. Ristorante con cucina gourmet e specialità savoiarde - Sconti per bambini in base all'età e alla stagione. Accoglienza gruppi, catering."
    ],
    "fr": [
      "Hôtel de 20 chambres doubles ou familiales, équipées de salle d'eau, sanitaires. Restaurant cuisine gastronomique soignée, mais également, spécialités savoyardes - Réductions enfants suivant âge et période. Accueil groupes, traiteur."
    ],
    "nl": [
      "Hotel met 20 tweepersoonskamers of familiekamers, uitgerust met doucheruimte, toiletten. Restaurant gastronomische keuken, maar ook Savoyaardse specialiteiten - Korting voor kinderen afhankelijk van leeftijd en periode. Welkomstgroepen, traiteur."
    ],
    "es": [
      "Hotel con 20 habitaciones dobles o familiares, todas con baño. Restaurante con cocina gastronómica y especialidades saboyanas - Descuentos para niños según edad y temporada. Admite grupos, servicio de catering."
    ]
  },
