      "dc:description": {
        "de": [
          "Der Verein \"Amis de l'orgue de l'abbatiale Saint-Saulve\" unter dem Vorsitz von Anne Loriette setzt sich seit mehreren Jahren für die Restaurierung dieses majestätischen Instruments ein."
        ],
        "en": [
          "The \"Amis de l?orgue de l?abbatiale Saint-Saulve\" association, chaired by Anne Loriette, has been working for several years to restore this majestic instrument."
        ],
        "it": [
          "L'Associazione Amici dell'Organo dell'Abbazia di Saint-Saulve, presieduta da Anne Loriette, lavora da diversi anni al restauro di questo maestoso strumento."
        ],
        "fr": [
          "L’association des « Amis de l’orgue de l’abbatiale Saint-Saulve » présidée par Anne Loriette se mobilise depuis plusieurs années pour restaurer ce majestueux instrument."
        ],
        "es": [
          "La Asociación de Amigos del Órgano de la Abadía de Saint-Saulve, presidida por Anne Loriette, trabaja desde hace varios años en la restauración de este majestuoso instrumento."
        ],
        "nl": [
          "De Vereniging Vrienden van het Abdijorgel van Saint-Saulve, voorgezeten door Anne Loriette, werkt al enkele jaren aan de restauratie van dit majestueuze instrument."
        ]
      },
