  "rdfs:comment": {
    "de": [
      "Zur Feier des Starts der Videospiel-Ausleihe in der Mediathek können Sie bei einem Schwarmtausch einige Videospiel-Nuggets entdecken."
    ],
    "en": [
      "To celebrate the launch of video game lending at the mediatheque, come and discover videogame nuggets during a \"coup de c?ur\" exchange."
    ],
    "it": [
      "Per celebrare il lancio del prestito di videogiochi presso la biblioteca multimediale, venite a scoprire alcune chicche videoludiche durante uno scambio \"coup de c'ur\"."
    ],
    "fr": [
      "Pour fêter le lancement du prêt de jeux vidéo à la médiathèque, venez découvrir des pépites vidéoludiques lors d'un échange de coup de cœur."
    ],
    "es": [
      "Para celebrar el lanzamiento del préstamo de videojuegos en la biblioteca multimedia, venga a descubrir algunas pepitas de videojuegos durante un intercambio \"coup de cœur\"."
    ],
    "nl": [
      "Om de lancering van het uitlenen van videogames in de mediatheek te vieren, kun je tijdens een \"coup de c?ur\"-uitwisseling kennismaken met videogame-nuggets."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Quinzaine des jeux vidéo : Vos coups de cœur jeux vidéo"
    ]
  },
