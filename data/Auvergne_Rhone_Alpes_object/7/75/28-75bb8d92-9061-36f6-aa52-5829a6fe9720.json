  "rdfs:comment": {
    "de": [
      "Kaufen Sie Ihre Bio-Äpfel vor den Toren von Soissons.\nDie Obstplantagen von Ambrief bieten 14 Sorten Bio-Äpfel, 2 Sorten Bio-Birnen und Weinbergpfirsiche an."
    ],
    "en": [
      "Come and buy your organic apples just outside Soissons.\nThe Ambrief orchards offer 14 varieties of organic apples, 2 varieties of organic pears and vine peaches."
    ],
    "it": [
      "Venite a comprare le vostre mele biologiche alle porte di Soissons.\nI frutteti di Ambrief offrono 14 varietà di mele biologiche, 2 varietà di pere biologiche e pesche di vigna."
    ],
    "fr": [
      "Venez acheter vos pommes Bio aux portes de Soissons. \nLes vergers d'Ambrief proposent 14 variétés de pommes Bio, 2 variétés de poires Bio et de la pêche de vigne."
    ],
    "es": [
      "Venga a comprar sus manzanas ecológicas a las afueras de Soissons.\nLos huertos de Ambrief ofrecen 14 variedades de manzanas ecológicas, 2 variedades de peras ecológicas y melocotones de viña."
    ],
    "nl": [
      "Kom net buiten Soissons je biologische appels kopen.\nDe boomgaarden van Ambrief bieden 14 soorten biologische appels, 2 soorten biologische peren en trosperziken."
    ]
  },
