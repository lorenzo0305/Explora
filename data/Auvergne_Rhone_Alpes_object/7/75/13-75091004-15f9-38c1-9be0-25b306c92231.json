  "rdfs:comment": {
    "de": [
      "Le Bois Sauvage empfängt Sie in einem 1 Hektar großen Park mit Bäumen, 5 Minuten zu Fuß vom Stadtzentrum entfernt. Hotel mit 20 Nichtraucherzimmern, gemütlich und komfortabel. Traditionelle Restauration mit lokalen und saisonalen Produkten, bevorzugt kurze Wege."
    ],
    "en": [
      "Le Bois Sauvage welcomes you to a one-hectare wooded park just a 5-minute walk from the town centre. Hotel with 20 non-smoking, warm and comfortable rooms. Traditional cuisine using local, seasonal produce, with an emphasis on short distribution channels."
    ],
    "it": [
      "Le Bois Sauvage vi accoglie in un parco alberato di un ettaro a 5 minuti a piedi dal centro città. Hotel con 20 camere non fumatori, calde e confortevoli. Cucina tradizionale a base di prodotti locali e stagionali, con particolare attenzione ai canali di distribuzione brevi."
    ],
    "fr": [
      "Le Bois Sauvage vous accueille dans un parc arboré d'un hectare à 5 mn à pied du centre-ville. Hôtel de 20 chambres non-fumeurs, chaleureuses, confortables. Restauration traditionnelle élaborée avec produits locaux, de saison, circuits courts privilégiés."
    ],
    "nl": [
      "Le Bois Sauvage verwelkomt u in een bebost park van een hectare op slechts 5 minuten lopen van het stadscentrum. Hotel met 20 rookvrije, warme en comfortabele kamers. Traditionele keuken met lokale, seizoensgebonden producten, met de nadruk op korte distributiekanalen."
    ],
    "es": [
      "Le Bois Sauvage le da la bienvenida en un parque arbolado de una hectárea a sólo 5 minutos a pie del centro de la ciudad. Hotel con 20 habitaciones para no fumadores, cálidas y confortables. Cocina tradicional a base de productos locales de temporada, con especial atención a los circuitos cortos de distribución."
    ]
  },
