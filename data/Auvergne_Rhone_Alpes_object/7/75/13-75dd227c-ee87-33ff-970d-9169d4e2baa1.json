  "rdfs:comment": {
    "de": [
      "In Morzine findet das größte Treffen von Riders statt, das von der HOG France organisiert wird. Die Veranstaltung findet im Herzen des Dorfes statt und bietet zahlreiche Animationen!"
    ],
    "en": [
      "Morzine welcomes the world's largest gathering of Riders to the sound of an exceptional Rock line-up, organized by HOG France. The event will take place right in the heart of the village, with plenty of entertainment!"
    ],
    "it": [
      "Morzine ospiterà il più grande raduno di motociclisti di sempre, con un'eccezionale line-up di rockstar, organizzato da HOG France. L'evento si svolgerà nel cuore del villaggio, con un'ampia offerta di intrattenimento!"
    ],
    "fr": [
      "Morzine accueille le plus grand rassemblement de Riders au son d’une affiche Rock exceptionnelle organisé par le HOG France. La manifestation se déroulera en plein cœur du village avec de très nombreux pôles d’animations!"
    ],
    "nl": [
      "Morzine verwelkomt de grootste bijeenkomst van rijders op de klanken van een uitzonderlijke Rock line-up georganiseerd door HOG France. Het evenement vindt plaats in het hart van het dorp, met veel entertainment!"
    ],
    "es": [
      "Morzine acoge la mayor concentración de motoristas de la historia, con un cartel excepcional de estrellas del rock, organizada por HOG France. El evento se desarrollará en pleno centro del pueblo, ¡con una gran oferta de entretenimiento!"
    ]
  },
  "rdfs:label": {
