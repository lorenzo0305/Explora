  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Mérilys, ein Hotel & Spa mit einer idealen Lage für Skifahrer in Méribel. Die warme Atmosphäre, das alte Holz und die Dekoration im Stil der Berge werden Sie in eine einzigartige und authentische Erfahrung eintauchen lassen, die Ihnen einen totalen Tapetenwechsel im Herzen der 3 Vallées ermöglicht."
    ],
    "en": [
      "Discover Le Mérilys, Hotel & Spa ideally located ski in ski out in Méribel. The warm ambience, old wood and mountain decor will immerse you in a unique and authentic experience for a complete change of scenery in the heart of the 3 Valleys."
    ],
    "it": [
      "Scoprite Le Mérilys, un Hotel & Spa situato in posizione ideale per lo ski in ski out a Méribel. La calda atmosfera, il legno antico e l'arredamento di montagna vi faranno immergere in un'esperienza unica e autentica per un completo cambiamento di scenario nel cuore delle 3 Valli."
    ],
    "fr": [
      "Découvrez Le Mérilys, Hôtel & Spa avec une situation idéale ski au pieds à Méribel. Ambiance chaleureuse, vieux bois et décoration montagnarde vous plongeront dans une expérience unique et authentique pour un dépaysement total au cœur des 3 Vallées."
    ],
    "nl": [
      "Ontdek Le Mérilys, een Hotel & Spa ideaal gelegen ski in ski out in Méribel. De warme sfeer, het oude hout en het bergdecor dompelen u onder in een unieke en authentieke ervaring voor een complete verandering van omgeving in het hart van de 3 Valleien."
    ],
    "es": [
      "Descubra Le Mérilys, un Hotel & Spa idealmente situado para esquiar en Méribel. El ambiente cálido, la madera antigua y la decoración de montaña le sumergirán en una experiencia única y auténtica para un cambio completo de escenario en el corazón de los 3 Valles."
    ]
  },
