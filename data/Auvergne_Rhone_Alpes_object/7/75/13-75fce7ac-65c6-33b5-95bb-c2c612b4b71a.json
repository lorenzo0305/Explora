  "rdfs:comment": {
    "de": [
      "Aubenas befindet sich an einem Knotenpunkt. Seine geografische Lage macht es zu einem touristischen und kulturellen Zentrum.\r\n\r\n- Reservierungsservice für Ihre Aktivitäten.\r\n- Kartenverkaufsservice für France-Billet-Shows und lokale Veranstaltungen."
    ],
    "en": [
      "Aubenas occupies a crossroads position. Its geographical situation makes it a tourist and cultural pole.\r\n\r\n- Reservation service for your activities.\r\n- Ticketing service for France Billetterie spectacle and local animations."
    ],
    "it": [
      "Aubenas occupa una posizione di crocevia. La sua posizione geografica la rende un centro turistico e culturale.\r\n\r\n- Servizio di prenotazione per le vostre attività.\r\n- Servizio di biglietteria per gli spettacoli di France Billet e per gli eventi locali."
    ],
    "fr": [
      "Aubenas occupe une position carrefour. Sa situation géographique en fait un pôle touristique et culturel.\r\n\r\n- Service de réservation pour vos activités.\r\n- Service Billetterie spectacle France Billet et animations locales."
    ],
    "es": [
      "Aubenas ocupa una posición de encrucijada. Su situación geográfica la convierte en un centro turístico y cultural.\r\n\r\n- Servicio de reservas para sus actividades.\r\n- Servicio de venta de entradas para los espectáculos de France Billet y los eventos locales."
    ],
    "nl": [
      "Aubenas ligt op een kruispunt van wegen. Door zijn geografische ligging is het een toeristisch en cultureel centrum.\r\n\r\n- Reserveringsdienst voor uw activiteiten.\r\n- Ticketing service voor France Billet shows en lokale evenementen."
    ]
  },
