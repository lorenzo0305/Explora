  "rdfs:comment": {
    "de": [
      "Nach Ihren schlammigen Mountainbike-Touren steht Ihnen zwischen der Schule und dem Wohnmobilstellplatz eine Waschanlage zur Verfügung, um Ihr treues Gefährt zu reinigen!"
    ],
    "en": [
      "After your muddy biking outings, a bike wash is at your disposal, between the school and the campers parking area, to clean your faithful mount."
    ],
    "it": [
      "Dopo le fangose gite in mountain bike, tra la scuola e l'area dei camper c'è una stazione di lavaggio dove potrete pulire la vostra fedele cavalcatura!"
    ],
    "fr": [
      "Après vos sorties de VTT bien boueuses, une station de lavage est à votre disposition, entre l'école et l'aire de camping car, pour nettoyer votre fidèle monture !"
    ],
    "nl": [
      "Na uw modderige mountainbiketochten is er een wasplaats tussen de school en de kampeerautoplaats, waar u uw trouwe rijdier kunt schoonmaken!"
    ],
    "es": [
      "Después de tus fangosos paseos en bicicleta de montaña, hay una estación de lavado entre la escuela y la zona del camping car, donde podrás limpiar tu fiel montura"
    ]
  },
