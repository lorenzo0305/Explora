  "rdfs:comment": {
    "de": [
      "Von Medizin bis Freizeit...Das Grand Hôtel-Dieu, eines der ältesten Krankenhäuser Lyons, wurde im Frühjahr 2018 nach einer vierjährigen kolossalen Bauzeit für die Öffentlichkeit zugänglich gemacht und enthüllt seine Räumlichkeiten."
    ],
    "en": [
      "From medicine to leisure... The Grand Hôtel-Dieu, one of Lyon’s oldest hospitals, reopened to the general public in the spring of 2018 to reveal its spaces following large-scale renovation works that lasted four years."
    ],
    "it": [
      "Dalla medicina alle attività ricreative... Aperto al pubblico nella primavera del 2018, dopo un colossale progetto di costruzione durato 4 anni, il Grand Hôtel-Dieu, uno dei più antichi ospedali di Lione, svela i suoi spazi."
    ],
    "fr": [
      "De la médecine aux loisirs…Ouvert au public au printemps 2018, après un chantier colossal de 4 ans, le Grand Hôtel-Dieu, l’un des plus anciens hôpitaux de Lyon, dévoile ses espaces."
    ],
    "nl": [
      "Van geneeskunde naar vrije tijd...Het Grand Hôtel-Dieu, een van de oudste ziekenhuizen van Lyon, is in het voorjaar van 2018 voor het publiek geopend, na een kolossaal bouwproject van 4 jaar."
    ],
    "es": [
      "De la medicina al ocio... Abierto al público en la primavera de 2018, tras un colosal proyecto de construcción de 4 años, el Grand Hôtel-Dieu, uno de los hospitales más antiguos de Lyon, estrena sus espacios."
    ]
  },
  "rdfs:label": {
    "en": [
      "The history of the Grand Hôtel-Dieu"
    ],
    "fr": [
      "Le Grand Hôtel-Dieu de Lyon, au fil de l'histoire"
    ]
  },
