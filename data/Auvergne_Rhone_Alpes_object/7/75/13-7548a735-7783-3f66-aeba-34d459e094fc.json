  "rdfs:comment": {
    "de": [
      "La Causette befindet sich auf einer Anhöhe mit einer atemberaubenden Aussicht und empfängt Sie im Winter auf den Pisten und im Sommer in den Bergen. Herzliche Atmosphäre und schmackhafte Küche sind hier an der Tagesordnung!"
    ],
    "en": [
      "Situated at altitude with a breathtaking view, La Causette welcomes you to the slopes in winter and to the mountains in summer. A warm atmosphere and delicious cuisine!"
    ],
    "it": [
      "Situata in quota con una vista mozzafiato, La Causette vi accoglie sulle piste in inverno e in montagna in estate. Un'atmosfera calorosa e una cucina deliziosa vi aspettano!"
    ],
    "fr": [
      "Situé en altitude avec une vue imprenable, La Causette vous accueille sur les pistes en hiver et en montagne l’été. Ambiance chaleureuse et cuisine savoureuse au rendez-vous !"
    ],
    "es": [
      "Situado en altitud con unas vistas impresionantes, La Causette le da la bienvenida a las pistas en invierno y a la montaña en verano. ¡Un ambiente cálido y una cocina deliciosa le esperan!"
    ],
    "nl": [
      "La Causette ligt op een hoogte met een adembenemend uitzicht en verwelkomt je op de pistes in de winter en in de bergen in de zomer. Een warme sfeer en een heerlijke keuken wachten op je!"
    ]
  },
  "rdfs:label": {
