  "rdfs:comment": {
    "de": [
      "Verleih von Kanus und Kajaks auf dem Fluss Loire in Briennon. Für alle zugänglich.\r\nKombinierte Formel möglich: Kanu und Rückfahrt mit dem Fahrrad auf der Véloire."
    ],
    "en": [
      "Canoe and kayak rental on the Loire River at Briennon. Accessible to all.\r\nCombined package possible: canoe and bike return on the Véloire."
    ],
    "it": [
      "Noleggio di canoe e kayak sul fiume Loira a Briennon. Accessibile a tutti.\r\nPossibilità di opzione combinata: canoa e ritorno in bicicletta lungo la Véloire."
    ],
    "fr": [
      "Location de canoës et kayaks sur le fleuve Loire à Briennon. Accessible à tous. \r\nFormule combinée possible : canoë et retour vélo par la Véloire."
    ],
    "nl": [
      "Kano- en kajakverhuur op de Loire bij Briennon. Toegankelijk voor iedereen.\r\nGecombineerde optie mogelijk: kanoën en terugkeer met de fiets langs de Véloire."
    ],
    "es": [
      "Alquiler de canoas y kayacs en el Loira, en Briennon. Accesible a todos.\r\nOpción combinada disponible: canoa y regreso en bicicleta por el Véloire."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Canoë Loire Aventure - Location de Canoë / Kayak"
    ]
  },
