  "rdfs:comment": {
    "de": [
      "Sève de Forez ist ein landwirtschaftliches Unternehmen, das im Herzen des Chorsin-Tals angesiedelt ist. Unsere Ernteparzellen (zertifiziert für biologische Landwirtschaft) erstrecken sich von 800 m bis 1300 m Höhe auf natürlichen Flächen, die vor jeglicher landwirtschaftlicher Verschmutzung geschützt sind."
    ],
    "en": [
      "Sève de Forez is an agricultural structure located in the heart of the Chorsin valley. Our harvesting plots (certified organic) range in altitude from 800m to 1300m, in natural areas protected from all agricultural pollution."
    ],
    "it": [
      "Sève de Forez è un'azienda agricola situata nel cuore della valle del Chorsin. Le nostre parcelle di raccolta (certificate biologiche) hanno un'altitudine compresa tra 800 e 1300 metri, in aree naturali protette dall'inquinamento agricolo."
    ],
    "fr": [
      "Sève de Forez est une structure agricole implantée au cœur de la vallée de Chorsin, nos parcelles (certifiées en agriculture biologique) de récolte s’étalent de 800m à 1300m d’altitude sur des espaces naturels protégés de toutes pollutions agricoles."
    ],
    "nl": [
      "Sève de Forez is een boerderij in het hart van de Chorsin vallei. Onze oogstpercelen (gecertificeerd biologisch) variëren in hoogte van 800m tot 1300m, in natuurlijke gebieden beschermd tegen landbouwvervuiling."
    ],
    "es": [
      "Sève de Forez es una explotación situada en el corazón del valle de Chorsin. Nuestras parcelas de cosecha (certificadas ecológicas) tienen una altitud que oscila entre los 800 y los 1300 metros, en zonas naturales protegidas de la contaminación agrícola."
    ]
  },
