  "rdfs:comment": {
    "de": [
      "Genießen Sie in einem Gastraum oder auf der Terrasse köstliche handgemachte Pizzen, die in einem authentischen italienischen Ofen gebacken werden. Wir bieten Ihnen auch den Verkauf zum Mitnehmen an.  Eine Reservierung ist erforderlich."
    ],
    "en": [
      "In a brand new restaurant or on the terrace, come and enjoy delicious home-made pizzas, baked in an authentic Italian oven. We also offer takeaway service.  Reservations required."
    ],
    "it": [
      "Venite a gustare le nostre deliziose pizze fatte in casa, cotte in un autentico forno italiano, nel nostro ristorante o sulla terrazza. Offriamo anche il servizio da asporto.  Prenotazione obbligatoria."
    ],
    "fr": [
      "Dans une salle de restaurant ou sur la terrasse, venez savourer de délicieuses pizzas artisanales, cuites dans un authentique four italien. Nous vous proposons également de la vente à emporter.  La réservation est requise."
    ],
    "es": [
      "Ven a disfrutar de nuestras deliciosas pizzas caseras, cocinadas en un auténtico horno italiano, en nuestro restaurante o en la terraza. También ofrecemos servicio de comida para llevar.  Es necesario reservar."
    ],
    "nl": [
      "Kom genieten van onze heerlijke huisgemaakte pizza's, gebakken in een authentieke Italiaanse oven, in ons restaurant of op het terras. We bieden ook afhaalservice.  Reserveren verplicht."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Simone et Odette Pizzeria"
    ]
  },
