  "rdfs:comment": {
    "de": [
      "Ericksonsche Hypnose, Massagen, Reflexzonenmassage nach der chinesischen Energetik und Ayla Naturel Aromatherapie. Nach Terminvereinbarung in der Praxis oder mögliche Fahrt zu den Kunden nach Hause oder an den Urlaubsort."
    ],
    "en": [
      "Ericksonian hypnosis, massage, Chinese energy reflexology and Ayla Naturel aromatherapy. Appointments at the practice or possible travel to clients' homes or vacation destinations."
    ],
    "it": [
      "Ipnosi ericksoniana, massaggio, riflessologia energetica cinese e aromaterapia Ayla Naturel. Su appuntamento presso lo studio o con possibili spostamenti a casa dei clienti o in luoghi di vacanza."
    ],
    "fr": [
      "Hypnose Ericksonienne, massages, réflexologie selon l'énergétique chinoise et aromathérapie Ayla Naturel. Sur rendez-vous au cabinet ou déplacement possible au domicile des clients ou sur les lieux de vacances."
    ],
    "es": [
      "Hipnosis ericksoniana, masajes, reflexología energética china y aromaterapia Ayla Naturel. Con cita previa en la consulta o posibilidad de desplazamiento al domicilio del cliente o a su lugar de vacaciones."
    ],
    "nl": [
      "Ericksoniaanse hypnose, massage, Chinese energiereflexologie en Ayla Naturel aromatherapie. Op afspraak in de praktijk of eventueel reizen naar klanten thuis of op vakantiebestemmingen."
    ]
  },
