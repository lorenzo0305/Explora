  "rdfs:comment": {
    "de": [
      "Das Kunst- und Begegnungszentrum Curiox hat es sich zur Aufgabe gemacht, den Uginesern und der Öffentlichkeit in der Region die künstlerischen Ausdrucksformen von heute zu präsentieren."
    ],
    "en": [
      "Curiox it's an art center. The goal of this center it's to present all the artistic types nowadays, to the resident of Ugine or for the public in the region."
    ],
    "it": [
      "Il Centro d'arte e d'incontro Curiox si propone di presentare le espressioni artistiche di oggi alla popolazione di Ugin e della regione."
    ],
    "fr": [
      "Le Centre d'art et de rencontres Curiox a pour vocation de présenter les expressions artistiques d'aujourd'hui aux Uginois et au public de la région."
    ],
    "nl": [
      "Het kunst- en ontmoetingscentrum Curiox wil de hedendaagse kunstuitingen aan de bevolking van Ugin en de regio presenteren."
    ],
    "es": [
      "El Centro de Arte y Encuentro Curiox tiene como objetivo presentar las expresiones artísticas actuales a los habitantes de Ugin y de la región."
    ]
  },
