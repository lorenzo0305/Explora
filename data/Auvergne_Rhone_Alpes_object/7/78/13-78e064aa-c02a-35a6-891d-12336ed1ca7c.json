  "rdfs:comment": {
    "de": [
      "\"L'Abri-Livres\" (Bücherschuppen) in der Nähe der Grundschule und des Rathauses.\r\nNach Belieben ausleihen, lesen, einwerfen und austauschen - das ist der Grund für die Existenz dieser großen Bücherkiste!"
    ],
    "en": [
      "\"L'Abri-Livres\" located near the elementary school and town hall.\r\nBorrow, read, drop off and swap books at will - that's what this big bookbox is all about!"
    ],
    "it": [
      "\"L'Abri-Livres\" si trova vicino alla scuola elementare e al municipio.\r\nPrendere in prestito, leggere, consegnare e scambiare libri a piacimento: questo è lo scopo di questa grande libreria!"
    ],
    "fr": [
      "\"L'Abri-Livres\" situé  à proximité de l'école primaire et de la mairie. \r\nEmprunter, lire, déposer, échanger à volonté, c'est la raison d'être de cette grande boite à livre !"
    ],
    "es": [
      "\"L'Abri-Livres\" se encuentra cerca de la escuela primaria y del ayuntamiento.\r\nToma prestados, lee, deja e intercambia los libros que quieras: ¡de eso se trata en esta gran caja de libros!"
    ],
    "nl": [
      "\"L'Abri-Livres\" bevindt zich vlakbij de basisschool en het gemeentehuis.\r\nBoeken lenen, lezen, afgeven en ruilen wat je wilt - daar draait het om in deze grote boekenkast!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'Abri Livres"
    ]
  },
