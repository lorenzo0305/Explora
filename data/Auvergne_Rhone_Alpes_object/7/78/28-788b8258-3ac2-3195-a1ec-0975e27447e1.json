  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/4fd9952e-54e1-34d1-9e17-7dab45febda3",
      "dc:description": {
        "de": [
          "Traditionelles Restaurant, regionale und bodenständige Gerichte.\nEinrichtung mit großer Kapazität, ideal für Bankette und Seminare, an der westlichen Ausfahrt von Saint-Quentin auf der Straße nach Amiens, in der Nähe der Autobahnausfahrt A 26 gelegen. Fischspezialitäten"
        ],
        "en": [
          "Traditional restaurant, regional and local dishes.\nLarge capacity establishment, ideal for banquets and seminars, located at the western exit of Saint-Quentin on the road to Amiens, near the A 26 motorway exit. Fish speciality"
        ],
        "it": [
          "Ristorante tradizionale, piatti regionali e locali.\nStruttura di grande capacità, ideale per banchetti e seminari, situata all'uscita ovest di Saint-Quentin sulla strada di Amiens, vicino all'uscita dell'autostrada A26. Specialità di pesce"
        ],
        "fr": [
          "Restaurant traditionnel, plats régionaux et du terroir.\nEtablissement de grande capacité, idéal pour les banquets et les séminaires, situé à la sortie ouest de Saint-Quentin sur la route d'Amiens, près de la sortie autoroute A 26. Spécialité de poissons"
        ],
        "nl": [
          "Traditioneel restaurant, regionale en lokale gerechten.\nEtablissement met grote capaciteit, ideaal voor banketten en seminars, gelegen aan de westelijke uitgang van Saint-Quentin op de weg naar Amiens, vlakbij de afrit van de snelweg A26. Vis specialiteit"
        ],
        "es": [
          "Restaurante tradicional, platos regionales y locales.\nEstablecimiento de gran capacidad, ideal para banquetes y seminarios, situado en la salida oeste de Saint-Quentin en la carretera de Amiens, cerca de la salida de la autopista A26. Especialidad de pescado"
        ]
      },
      "@type": [
        "Description"
