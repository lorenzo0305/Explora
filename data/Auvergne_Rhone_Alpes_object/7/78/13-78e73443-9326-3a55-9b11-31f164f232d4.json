  "rdfs:comment": {
    "de": [
      "Entdecken Sie den Sales Mountain in komprimierter Form. Nach einem Start mit einem\r\nleicht abfallendem Profil, bei dem sich Pisten im Unterholz und Balkonwege abwechseln,\r\nsie erreichen schnell den Fuß des Anstiegs zum Col de la Pousterle."
    ],
    "en": [
      "Discover Sales Mountain in condensed form. After a slightly\r\nslightly downhill profile, alternating wooded slopes and balcony trails,\r\nyou'll soon reach the foot of the ascent to Col de la Pousterle."
    ],
    "it": [
      "Scoprite la montagna delle vendite in forma condensata. Dopo un profilo in leggera\r\nprofilo in leggera discesa, alternando sentieri nel bosco e balconate,\r\nsi arriva presto ai piedi della salita al Col de la Pousterle."
    ],
    "fr": [
      "Découvrez la montagne des Ventes en version condensée. Après un départ au\r\nprofil légèrement descendant, alternant pistes sous-bois et sentiers en balcon,\r\nvous atteindrez rapidement le pied de la montée vers le Col de la Pousterle."
    ],
    "nl": [
      "Ontdek Sales Mountain in verkorte vorm. Na een licht\r\nlicht bergafwaarts profiel, afgewisseld door bospaden en balkonpaden,\r\nbereik je al snel de voet van de klim naar de Col de la Pousterle."
    ],
    "es": [
      "Descubra la Montaña de las Ventas en formato condensado. Tras un\r\nperfil ligeramente descendente, alternando pistas forestales y senderos de balcones,\r\npronto llegará al pie de la subida al Col de la Pousterle."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Trail 4 - Grimpée de la Pousterele"
    ]
  },
