  "rdfs:comment": {
    "de": [
      "Sara Vandermersch stellt Schmuck in Handarbeit her, wobei sie Buchsbaumholz und Kupfer verwendet. Ich benutze auch ein wenig Silber. Alle meine Schmuckstücke sind handgefertigt."
    ],
    "en": [
      "Sara Vandermersch creates jewellery in a traditional way, using boxwood and copper. I also use a little silver. All my jewellery is handmade."
    ],
    "it": [
      "Sara Vandermersch crea gioielli a mano, utilizzando legno di bosso e rame, ma anche argento. Tutti i miei gioielli sono fatti a mano."
    ],
    "fr": [
      "Sara Vandermersch crée des bijoux de façon artisanale, en utilisant le bois de buis et du cuivre. j'utilise également un peu d'argent. Tous mes bijoux sont fait à la main."
    ],
    "nl": [
      "Sara Vandermersch maakt sieraden met de hand, met buxus en koper. Ik gebruik ook wat zilver. Al mijn sieraden zijn handgemaakt."
    ],
    "es": [
      "Sara Vandermersch crea joyas a mano, utilizando madera de boj y cobre. También uso algo de plata. Todas mis joyas están hechas a mano."
    ]
  },
