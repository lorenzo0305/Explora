  "rdfs:comment": {
    "de": [
      "An den Ausläufern des Plateau de Retord gelegen, bietet dieser angelegte See das ganze Jahr über verschiedene Aktivitäten. Baden, Spaziergänge, Boulespiel...\r\nBeaufsichtigtes Baden im Sommer von 13:00 bis 19:00 Uhr."
    ],
    "en": [
      "Located in the foothills of the Plateau de Retord, the newly constructed lake offers various activities throughout the year. Swimming, strolling, bowling, relaxation in summer."
    ],
    "it": [
      "Situato ai piedi del Plateau de Retord, questo lago paesaggistico offre una varietà di attività tutto l'anno. Nuoto, passeggiate, bocce...\r\nNuoto sorvegliato in estate dalle 13.00 alle 19.00."
    ],
    "fr": [
      "Situé sur les contreforts du Plateau de Retord, ce plan d'eau aménagé offre diverses activités tout au long de l'année. Baignade, balade, jeux de boules...\r\nBaignade surveillée en été de 13h à 19h."
    ],
    "es": [
      "Situado en las estribaciones del Plateau de Retord, este lago ajardinado ofrece diversas actividades durante todo el año. Natación, senderismo, petanca...\r\nNatación vigilada en verano de 13:00 a 19:00."
    ],
    "nl": [
      "Dit aangelegde meer ligt aan de voet van het Plateau de Retord en biedt het hele jaar door verschillende activiteiten. Zwemmen, wandelen, jeu de boules...\r\nZwemmen onder toezicht in de zomer van 13.00 tot 19.00 uur."
    ]
  },
  "rdfs:label": {
    "en": [
      "Swimming at Lalleyriat Lake"
    ],
    "fr": [
      "Baignade au lac de Lalleyriat"
    ]
  },
