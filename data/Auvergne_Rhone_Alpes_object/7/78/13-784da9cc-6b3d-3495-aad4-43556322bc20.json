  "rdfs:comment": {
    "de": [
      "Die Ferme de Boisy ist seit den 1960er Jahren in Pouilly-les-Nonains ansässig. Sie verarbeitet mehr als 90 % der von ihren 60 Milchkühen produzierten Milch zu Käse (Milchsäurekäse und ungekochter Presskäse), der im Hofladen verkauft wird."
    ],
    "en": [
      "Ferme de Boisy has been established in Pouilly-les-Nonains since the 1960s. It transforms over 90% of its milk production from 60 dairy cows into cheeses (lactic and pressed uncooked) sold in the farm store."
    ],
    "it": [
      "La Ferme de Boisy è presente a Pouilly-les-Nonains dagli anni Sessanta. Trasforma oltre il 90% della produzione di latte di 60 vacche da latte in formaggio (lattico e pressato non cotto) venduto nel negozio della fattoria."
    ],
    "fr": [
      "La ferme de Boisy est installée à Pouilly-les-Nonains depuis les années 60. Elle transforme plus de 90% de sa production laitière issue de ses 60 vaches laitières en fromages (à pâte lactique et pâte pressé non cuite) vendus au magasin de la ferme."
    ],
    "es": [
      "La Ferme de Boisy está establecida en Pouilly-les-Nonains desde los años sesenta. Transforma más del 90% de su producción de leche, procedente de 60 vacas lecheras, en queso (láctico y prensado sin cocer) que se vende en la tienda de la granja."
    ],
    "nl": [
      "Ferme de Boisy is sinds de jaren 1960 gevestigd in Pouilly-les-Nonains. Het bedrijf verwerkt meer dan 90% van de melkproductie van 60 melkkoeien tot kaas (melkzuur en ongekookte geperste kaas) die wordt verkocht in de boerderijwinkel."
    ]
  },
  "rdfs:label": {
