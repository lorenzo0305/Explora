  "rdfs:comment": {
    "de": [
      "Im Herzen der Einkaufspassage Chamrousse 1750 gelegen. Wir begrüßen Sie in einem gemütlichen Rahmen, in dem Ihnen typische Gerichte angeboten werden."
    ],
    "en": [
      "Located in the middle of the gallery in Chamrousse 1750. Wewelcome you in a warm setting where typical dishes are suggested"
    ],
    "it": [
      "Situato nel cuore del centro commerciale Chamrousse 1750, vi accogliamo in un'atmosfera calda dove vi verranno proposti piatti tipici."
    ],
    "fr": [
      "Situé au coeur de la galerie marchande Chamrousse 1750. Nous vous accueillons dans un cadre chaleureux où des plats typiques vous seront proposés."
    ],
    "es": [
      "Situado en el corazón del centro comercial Chamrousse 1750, le damos la bienvenida en un ambiente cálido en el que se le propondrán platos típicos."
    ],
    "nl": [
      "Gelegen in het hart van het winkelcentrum Chamrousse 1750, verwelkomen wij u in een warme sfeer waar typische gerechten worden voorgesteld."
    ]
