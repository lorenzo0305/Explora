  "rdfs:comment": {
    "de": [
      "Der Yooner auf dem Grand Massif... die moderne Version des uralten Parets aus Hochsavoyen!\r\nMit seinen Kantengriffen und seinem niedrigen Schwerpunkt bietet der Yooner ungeahnte und gefahrlose Gleitmöglichkeiten für Groß und Klein."
    ],
    "en": [
      "Come and learn to Yooner, discover this new way of slipping. Very fun and easy, the yooner, also called mono-sledge is accessible to all! One run enough to control the aircraft !!"
    ],
    "it": [
      "Lo yooner del Grand Massif... la versione moderna dell'antico paret dell'Alta Savoia!\r\nCon i suoi bordi affilati e il baricentro basso, lo yooner è un modo sicuro di scivolare giù per la montagna per grandi e piccini."
    ],
    "fr": [
      "Le yooner sur le Grand Massif... la version moderne de l'antique paret de Haute-Savoie !\r\nAvec ses prises de carre et son centre de gravité surbaissé, le yooner offre une glisse insoupçonnée et sans danger pour les petits et les grands."
    ],
    "es": [
      "El yooner del Grand Massif... ¡la versión moderna del antiguo paret de la Alta Saboya!\r\nCon sus bordes afilados y su bajo centro de gravedad, el yooner es una forma segura de deslizarse por la montaña para jóvenes y mayores."
    ],
    "nl": [
      "De Grand Massif yooner... de moderne versie van de oude paret uit de Haute-Savoie!\nMet zijn scherpe randen en lage zwaartepunt is de yooner een veilige manier om van de berg af te glijden voor jong en oud."
    ]
  },
  "rdfs:label": {
    "en": [
      "Renting Yooner and Paret"
    ],
    "fr": [
      "Location Yooner et Paret"
    ],
    "nl": [
      "Yooner en Paret huren"
    ]
  },
