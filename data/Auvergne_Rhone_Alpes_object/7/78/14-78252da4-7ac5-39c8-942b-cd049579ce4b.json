      "dc:description": {
        "de": [
          "GEDENKFEIER ZUM GEDENKEN AN DEN SIEG AM 8. MAI\nfindet am Freitag, den 8. Mai um 11:30 Uhr statt.\n\nKranzniederlegung am Kriegerdenkmal"
        ],
        "en": [
          "MAY 8TH VICTORY COMMEMORATION CEREMONY\nwill be held on Friday May 8 at 11:30 a.m.\n\nWreath laying at the Monument aux Morts"
        ],
        "it": [
          "CERIMONIA DI COMMEMORAZIONE DELLA VITTORIA DELL'8 MAGGIO\nsi terrà venerdì 8 maggio alle 11.30.\n\nDeposizione di corone al Monument aux Morts"
        ],
        "fr": [
          "CEREMONIE DE COMMEMORATION DE LA VICTOIRE DU 8 MAI\naura lui le vendredi 8 mai à 11 h 30. \n\nDépôt de gerbe au Monument aux Morts"
        ],
        "nl": [
          "CEREMONIE TER HERDENKING VAN DE OVERWINNING OP 8 MEI\nwordt gehouden op vrijdag 8 mei om 11.30 uur.\n\nKranslegging bij het Monument aux Morts"
        ],
        "es": [
          "CEREMONIA CONMEMORATIVA DE LA VICTORIA DEL 8 DE MAYO\nse celebrará el viernes 8 de mayo a las 11.30 horas.\n\nColocación de coronas de flores en el Monument aux Morts"
        ]
      },
