  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/d2aa27ce-64db-36ca-a19d-856f4a7952c9",
      "dc:description": {
        "de": [
          "Informationen :\n\nBesuchen Sie die Website, um den Katalog der Blumensträuße kennenzulernen\n\n\nBestellung:\nper Telefon oder auf der Website\n\n\nAbholung :\n\nLieferung möglich in Bapaume, Achiet, Bertincourt oder Bucquoy (bitte bei der Bestellung erfragen)\n\n "
        ],
        "en": [
          "Information :\n\nVisit the website for the bouquet catalog\n\n\nHow to order :\nby telephone or on the website\n\n\nCollection:\n\nDelivery possible to Bapaume, Achiet, Bertincourt or Bucquoy (please enquire when ordering)\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nVisita il sito web per il catalogo dei bouquet\n\n\nCome ordinare :\nper telefono o sul sito web\n\n\nCollezione:\n\nConsegna possibile a Bapaume, Achiet, Bertincourt o Bucquoy (chiedere al momento dell'ordine)\n\n "
        ],
        "fr": [
          "Informations :\n\nConsultez le site internet pour connaitre le catalogue des bouquets\n\n\nCommande :\npar téléphone ou sur le site \n\n\nRetrait :\n\nLivraison possible à Bapaume, Achiet, Bertincourt ou Bucquoy (se renseigner lors de la commande)\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nBezoek de website voor de boeketcatalogus\n\n\nHoe te bestellen :\ntelefonisch of via de website\n\n\nCollectie:\n\nLevering mogelijk in Bapaume, Achiet, Bertincourt of Bucquoy (vraag ernaar tijdens het bestellen)\n\n "
        ],
        "es": [
          "Más información :\n\nVisite el sitio web para ver el catálogo de ramos\n\n\nCómo hacer un pedido :\npor teléfono o en el sitio web\n\n\nRecogida:\n\nEntrega posible en Bapaume, Achiet, Bertincourt o Bucquoy (preguntar al hacer el pedido)\n\n "
        ]
      },
