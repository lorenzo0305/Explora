  "rdfs:comment": {
    "de": [
      "Florence bietet Ihnen die Möglichkeit, ihre Leidenschaft für das Kochen zu teilen und traditionelle Gerichte mit lokalen Produkten zu probieren (ein Tagesmenü sowie auvergnatische Rezepte am Wochenende)."
    ],
    "en": [
      "Florence invites you to share her passion for cooking by sampling traditional dishes made with local produce (a daily menu and Auvergne recipes at weekends)."
    ],
    "it": [
      "Florence vi invita a condividere la sua passione per la cucina assaggiando piatti tradizionali a base di prodotti locali (menù giornaliero e ricette dell'Alvernia nei fine settimana)."
    ],
    "fr": [
      "Florence vous propose de partager sa passion pour la cuisine en venant déguster des plats traditionnels avec des produits locaux (un menu du jour ainsi que des recettes auvergnates le weekend)."
    ],
    "nl": [
      "Florence nodigt je uit om haar passie voor koken te delen door te proeven van traditionele gerechten op basis van lokale producten (een dagmenu en recepten uit de Auvergne in het weekend)."
    ],
    "es": [
      "Florence le invita a compartir su pasión por la cocina degustando platos tradicionales elaborados con productos locales (menú diario y recetas de Auvernia los fines de semana)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Terrasse du Sully"
    ]
  },
