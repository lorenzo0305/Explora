  "rdfs:comment": {
    "de": [
      "Hélène, die Hüttenwartin der Vallonbrun-Hütte, bietet Ihnen kleine Mahlzeiten und Tagesgerichte an. Mit Leidenschaft wählt sie ihre Zutaten aus lokalen, regionalen und biologischen Quellen aus und verfeinert den Geschmack mit Gewürzen."
    ],
    "en": [
      "Hélène, the guardian of the Vallonbrun refuge, offers you light meals and daily specials. She passionately selects her ingredients locally, regionally, organically and enhances the flavors with spices."
    ],
    "it": [
      "Hélène, la custode del rifugio Vallonbrun, propone spuntini e specialità del giorno. È appassionata di selezione di ingredienti locali, regionali e biologici e utilizza le spezie per esaltare i sapori."
    ],
    "fr": [
      "Hélène, la gardienne du refuge de Vallonbrun, vous propose petite restauration et plats du jour. Elle sélectionne avec passion ses ingrédients en local, régional, bio et rehausse les saveurs grâce aux épices."
    ],
    "es": [
      "Hélène, la cuidadora del refugio de Vallonbrun, ofrece aperitivos y platos del día. Le apasiona seleccionar ingredientes locales, regionales y ecológicos, y utiliza especias para realzar los sabores."
    ],
    "nl": [
      "Hélène, de bewaker van het toevluchtsoord Vallonbrun, biedt u lichte maaltijden en dagschotels aan. Ze selecteert haar ingrediënten met passie lokaal, regionaal, biologisch en versterkt de smaken met kruiden."
    ]
  },
  "rdfs:label": {
    "en": [
      "Vallonbrun refuge restaurant"
    ],
    "fr": [
      "Restaurant du refuge de Vallonbrun"
    ],
    "nl": [
      "Restaurant in het toevluchtsoord Vallonbrun"
    ]
  },
