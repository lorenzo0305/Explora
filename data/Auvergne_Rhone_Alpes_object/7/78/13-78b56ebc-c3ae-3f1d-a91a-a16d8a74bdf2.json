  "rdfs:comment": {
    "de": [
      "Verleih von Elektrofahrrädern für 1/2 Tag auf dem grünen Weg \"Via Ardèche\". Entdecken Sie unsere Viadukte und Tunnel, unsere wunderschönen Landschaften mit Blick auf den Fluss, auf die Felsen und unsere charaktervollen Dörfer."
    ],
    "en": [
      "Electric bike hire for 1/2 days on the \"Via Ardèche\" greenway. Come and discover our viaducts and tunnels, our magnificent landscapes, with views of the river, the cliffs and our picturesque villages."
    ],
    "it": [
      "Noleggio di biciclette elettriche per mezza giornata sulla greenway \"Via Ardèche\". Venite a scoprire i nostri viadotti e le nostre gallerie, i nostri magnifici paesaggi, con viste sul fiume, sulle scogliere e sui nostri villaggi di carattere."
    ],
    "fr": [
      "Location de vélos électriques à la 1/2 journée sur la voie verte « Via Ardèche ». Venez découvrir nos viaducs et tunnels, nos magnifiques paysages, avec vue sur la rivière, sur les falaises et nos villages de caractère ."
    ],
    "nl": [
      "Verhuur van elektrische fietsen voor 1/2 dagen op de groene route \"Via Ardèche\". Ontdek onze viaducten en tunnels, onze prachtige landschappen met uitzicht op de rivier, de kliffen en onze pittoreske dorpjes."
    ],
    "es": [
      "Alquiler de bicicletas eléctricas para medio día en la vía verde \"Via Ardèche\". Venga a descubrir nuestros viaductos y túneles, nuestros magníficos paisajes, con vistas al río, los acantilados y nuestros pueblos de carácter."
    ]
  },
