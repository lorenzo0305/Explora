  "rdfs:comment": {
    "de": [
      "Tag der Sensibilisierung für ALS (Amyotrophe Lateralsklerose) oder Charcot-Krankheit. Treffen mit den Mitgliedern der ARSLA von St-Etienne. Musikalische Intermezzi von Rolland CHAPARD (Klavier)."
    ],
    "en": [
      "ALS (Amyotrophic Lateral Sclerosis) awareness day. Meeting with members of ARSLA St-Etienne. Musical interludes by Rolland CHAPARD (piano)."
    ],
    "it": [
      "Giornata di sensibilizzazione sulla SLA (Sclerosi Laterale Amiotrofica) o malattia di Charcot. Incontro con i membri dell'ARSLA St-Etienne. Intermezzi musicali di Rolland CHAPARD (pianoforte)."
    ],
    "fr": [
      "Journée de sensibilisation à la SLA (Sclérose Latérale Amyotrophique) ou Maladie de Charcot. Rencontre avec les membres de l'ARSLA de St-Etienne. Intermèdes musicaux par Rolland CHAPARD (piano)."
    ],
    "es": [
      "Jornada de sensibilización sobre la ELA (Esclerosis Lateral Amiotrófica) o enfermedad de Charcot. Encuentro con miembros de ARSLA St-Etienne. Interludios musicales a cargo de Rolland CHAPARD (piano)."
    ],
    "nl": [
      "Een dag om aandacht te vragen voor ALS (Amyotrofische Lateraal Sclerose) of de ziekte van Charcot. Ontmoeting met leden van ARSLA St-Etienne. Muzikale intermezzo's door Rolland CHAPARD (piano)."
    ]
  },
