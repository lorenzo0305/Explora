  "rdfs:comment": {
    "de": [
      "Hausgemachte Küche, die von Ihrem Handwerkskoch mit Liebe aus frischen, lokalen, saisonalen und möglichst biologischen Produkten zubereitet wird.\r\n1000 frei zugängliche Gesellschafts- und Rollenspiele für alle Altersgruppen. Regelmäßige Veranstaltungen: Entdeckungen, Prototypen, Neuheiten."
    ],
    "en": [
      "Home cooking made with love by your artisan chef using fresh, local, seasonal and, wherever possible, organic produce.\r\n1,000 board and role-playing games for the general public, freely available. Regular events: discoveries, prototypes, new releases."
    ],
    "it": [
      "Cucina casalinga fatta con amore dal vostro cuoco artigiano con prodotti freschi, locali, stagionali e il più possibile biologici.\r\n1.000 giochi da tavolo e di ruolo a libero accesso per il pubblico. Eventi periodici: scoperte, prototipi, nuovi prodotti."
    ],
    "fr": [
      "Une cuisine maison faite avec amour par votre artisan cuisinier avec des produits frais, locaux, de saison et le plus possible bio.\r\n1000 jeux de société et de rôle tout public en libre accès. Des événements réguliers: découvertes, prototypes, nouveautés."
    ],
    "nl": [
      "Thuis koken met liefde gemaakt door uw ambachtelijke kok met verse, lokale, seizoensgebonden en zoveel mogelijk biologische producten.\r\n1.000 bord- en rollenspellen voor het grote publiek met vrije toegang. Regelmatige evenementen: ontdekkingen, prototypes, nieuwe producten."
    ],
    "es": [
      "Cocina casera hecha con amor por su chef artesano con productos frescos, locales, de temporada y, en la medida de lo posible, ecológicos.\r\n1.000 juegos de mesa y de rol para todas las edades, de libre acceso. Eventos regulares: descubrimientos, prototipos, novedades."
    ]
  },
  "rdfs:label": {
    "en": [
      "K play fairy"
    ],
    "fr": [
      "K fée des jeux"
    ]
  },
