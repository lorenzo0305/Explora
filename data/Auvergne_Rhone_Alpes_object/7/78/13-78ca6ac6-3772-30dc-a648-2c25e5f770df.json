  "rdfs:comment": {
    "de": [
      "Qualitativ hochwertiges Selbstbedienungsrestaurant, das eine traditionelle, familiäre und großzügige Küche anbietet.\r\nIdeale Lage am Fuße des Pisaillas-Gletschers und nur wenige Schritte vom mythischen Col de l'Iseran entfernt."
    ],
    "en": [
      "A high-quality self-service restaurant offering generous, traditional family-style cuisine. \r\nIdeally located at the foot of the Pisaillas glacier and just steps from the legendary Col de l’Iseran."
    ],
    "it": [
      "Ristorante self-service di qualità, che offre una cucina tradizionale, familiare e generosa. \r\nIdealmente situato ai piedi del ghiacciaio di Pisaillas e a due passi dal mitico Colle dell'Iseran."
    ],
    "fr": [
      "Self-service de qualité, offrant une cuisine traditionnelle, familiale et généreuse. \r\nIdéalement situé au pied du glacier du Pisaillas et à deux pas du mythique col de l’Iseran."
    ],
    "nl": [
      "Zelfbedieningsrestaurant van hoge kwaliteit met een traditionele, familiale en royale keuken.\r\nIdeaal gelegen aan de voet van de Pisaillas-gletsjer en op een steenworp afstand van de legendarische Iseran-pas."
    ],
    "es": [
      "Restaurante autoservicio de calidad que ofrece una cocina tradicional, familiar y generosa.\r\nIdealmente situado a los pies del glaciar de Pisaillas y a un paso del legendario puerto de Iseran."
    ]
  },
