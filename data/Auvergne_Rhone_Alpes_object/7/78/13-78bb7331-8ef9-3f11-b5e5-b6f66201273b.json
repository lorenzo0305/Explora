  "rdfs:comment": {
    "de": [
      "Das Petit Clerc öffnet seine Türen wieder im Zeichen der Geselligkeit mit einem neuen Konzept der Küche zum Teilen. Cocotte, Raclette, Fondue - Klassiker, die man gerne mit der Familie oder mit Freunden teilt."
    ],
    "en": [
      "Le Petit Clerc reopens its doors in a friendly atmosphere, with a new concept of cuisine to share. Cocotte, raclette, fondue: classics that we love to share with family and friends."
    ],
    "it": [
      "Le Petit Clerc riapre le sue porte all'insegna della convivialità con un nuovo concetto di cucina da condividere. Cocotte, raclette, fonduta, classici che ci piace condividere con la famiglia e gli amici."
    ],
    "fr": [
      "Le Petit Clerc réouvre ses portes sous le signe de la convivialité avec un nouveau concept de cuisine à partager. Cocotte, raclette, fondue, des classiques que l'on aime partager en famille ou entre amis."
    ],
    "es": [
      "Le Petit Clerc reabre sus puertas bajo el signo de la convivencia con un nuevo concepto de cocina para compartir. Cocotte, raclette, fondue, clásicos que nos gusta compartir con la familia y los amigos."
    ],
    "nl": [
      "Le Petit Clerc heropent zijn deuren onder de vlag van gezelligheid, met een nieuw concept van koken om te delen. Cocotte, raclette, fondue, klassiekers die we graag delen met familie en vrienden."
    ]
  },
  "rdfs:label": {
