  "rdfs:comment": {
    "de": [
      "Hausgemachte Bretter für den Aperitif, eine große Auswahl an Weinen zur Verkostung. Für einen geselligen und authentischen Moment mit einer herzlichen und sympathischen Atmosphäre."
    ],
    "en": [
      "Wine bar, perfect for an afterwork or just a drink. You have also tapas and fondue"
    ],
    "it": [
      "Taglieri fatti in casa per l'aperitivo, un'ampia scelta di vini da degustare. Per un momento conviviale e autentico con un'atmosfera calda e amichevole."
    ],
    "fr": [
      "Des planches maisons pour l'apéro, un large choix de vins à déguster. Pour un moment convivial et authentique avec une ambiance chaleureuse et sympathique."
    ],
    "nl": [
      "Zelfgemaakte plankjes voor het aperitief, een ruime keuze aan wijnen om te proeven. Voor een gezellig en authentiek moment met een warme en vriendelijke sfeer."
    ],
    "es": [
      "Tablas caseras para el aperitivo, una amplia selección de vinos para degustar. Para un momento de convivencia y autenticidad con un ambiente cálido y acogedor."
    ]
  },
