  "rdfs:comment": {
    "de": [
      "Laurent Gerra ist ein Meister der Imitation und des bissigen Humors. Auf der Bühne reiht er Sketche, Karikaturen und Gesangsdarbietungen aneinander, um eine lebhafte, witzige und unwiderstehliche Show zu bieten!"
    ],
    "en": [
      "Laurent Gerra is a master of imitation and biting humor. On stage, he combines sketches, caricatures and vocal performances for a lively, funny and irresistible show!"
    ],
    "it": [
      "Laurent Gerra è un maestro della mimica e dell'umorismo pungente e sul palco trasforma sketch, caricature e performance vocali in uno spettacolo vivace, divertente e irresistibile!"
    ],
    "fr": [
      "Laurent Gerra est un maître de l’imitation et de l’humour mordant, sur scène il enchaîne sketches, caricatures et performances vocales pour un spectacle vif, drôle et irrésistible !"
    ],
    "nl": [
      "Laurent Gerra is een meester in mimiek en bijtende humor, en op het podium verandert hij sketches, karikaturen en vocale optredens in een levendige, grappige en onweerstaanbare show!"
    ],
    "es": [
      "Laurent Gerra es un maestro de la mímica y el humor mordaz, y sobre el escenario convierte sketches, caricaturas e interpretaciones vocales en un espectáculo vivo, divertido e irresistible"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Spectacle : Laurent Gerra se met à table"
    ]
  },
