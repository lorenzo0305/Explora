  "rdfs:comment": {
    "de": [
      "Im Atelier/Shop finden Sie eine große Anzahl von Textilkreationen. Sie können auch Ihre eigenen Werke anfertigen lassen. Ich kann auch Ihre Artikel mit meiner Stickerin personalisieren."
    ],
    "en": [
      "The workshop/boutique offers a wide range of textile creations. You can also have your own creations made. I can also personalize your items with my embroiderer."
    ],
    "it": [
      "Nel laboratorio/negozio troverete una vasta gamma di creazioni tessili. Potete anche far realizzare le vostre creazioni. Posso anche personalizzare i vostri articoli con la mia ricamatrice."
    ],
    "fr": [
      "Vous trouverez à l’atelier/boutique un grand nombre de créations textiles. Vous pouvez également faire faire vos réalisations. Je peux également personnalisé vos articles avec ma brodeuse."
    ],
    "nl": [
      "In de werkplaats/winkel vind je een breed scala aan textielcreaties. Je kunt ook je eigen creaties laten maken. Ik kan je items ook personaliseren met mijn borduurster."
    ],
    "es": [
      "En el taller/tienda encontrará una amplia gama de creaciones textiles. También puede encargar sus propias creaciones. También puedo personalizar sus artículos con mi bordadora."
    ]
  },
