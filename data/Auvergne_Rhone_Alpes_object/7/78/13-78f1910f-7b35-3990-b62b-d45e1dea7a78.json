  "rdfs:comment": {
    "de": [
      "Leckere Salate, Gänseleberterrinen, Wurstwaren, Frösche in Persillade, Kalbskopf in Sauce Gribiche stehen auf der Karte und ein Tagesmenü sowie das Tagesgericht werden Ihre Geschmacksnerven wecken."
    ],
    "en": [
      "Delicious salads, foie gras terrines, charcuterie, frogs en persillade and calf's head with gribiche sauce are all available à la carte, and a daily menu and specials will tantalize your taste buds."
    ],
    "it": [
      "Deliziose insalate, terrine di foie gras, salumi, rane en persillade e testa di vitello in salsa gribiche sono disponibili alla carta, mentre il menu giornaliero e le specialità stuzzicheranno il vostro palato."
    ],
    "fr": [
      "De succulentes salades, terrines de foie gras,  charcuteries, grenouilles en persillade, tête de veau sauce gribiche sont proposés à la carte et un menu du jour ainsi que le plat du jour sauront éveiller vos papilles."
    ],
    "nl": [
      "Heerlijke salades, terrines van foie gras, vleeswaren, kikkers en persillade en kalfskop in gribichesaus zijn allemaal à la carte verkrijgbaar, en een dagmenu en specials prikkelen je smaakpapillen."
    ],
    "es": [
      "Deliciosas ensaladas, terrinas de foie gras, embutidos, ranas en persillade y cabeza de ternera en salsa gribiche están disponibles a la carta, y un menú diario y especiales tentarán sus papilas gustativas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Petite Auberge"
    ]
  },
