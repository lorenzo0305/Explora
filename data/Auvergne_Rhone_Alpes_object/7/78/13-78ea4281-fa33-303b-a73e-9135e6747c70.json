  "rdfs:comment": {
    "de": [
      "Die Alpine French School befindet sich im Chamonix-Tal und bietet Ihnen die außergewöhnliche Gelegenheit, das Erlernen einer Sprache mit Ihren bevorzugten sportlichen Aktivitäten zu verbinden."
    ],
    "en": [
      "Located in the Chamonix valley, Alpine French School offers you the extraordinary opportunity to combine language study with your favorite sporting activities."
    ],
    "it": [
      "Situata nella valle di Chamonix, l'Alpine French School vi offre la straordinaria opportunità di combinare lo studio della lingua con le vostre attività sportive preferite."
    ],
    "fr": [
      "Situé dans la vallée de Chamonix, Alpine French School vous offre l’extraordinaire opportunité d’allier l’étude d’une langue à vos activités sportives préférées."
    ],
    "es": [
      "Situada en el valle de Chamonix, la Escuela de Francés de los Alpes le ofrece la extraordinaria oportunidad de combinar el estudio del idioma con sus actividades deportivas favoritas."
    ],
    "nl": [
      "Alpine French School ligt in de vallei van Chamonix en biedt je de buitengewone mogelijkheid om taalstudie te combineren met je favoriete sportactiviteiten."
    ]
  },
