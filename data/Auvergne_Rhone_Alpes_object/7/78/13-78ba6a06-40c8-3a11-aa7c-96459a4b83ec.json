  "rdfs:comment": {
    "de": [
      "Handwerkliche Floristin seit 2001.\r\n- Blumenvermittlung, die an Interflora und Florajet angeschlossen ist.\r\n- Lieferung bei Ihnen zu Hause.\r\n- Hochzeiten und Trauerfälle.\r\nTelefonische Bestellung mit CB-Zahlung."
    ],
    "en": [
      "Artisan florist since 2001.\r\n- Floral transmission affiliated with Interflora and Florajet.\r\n- Home delivery.\r\n- Weddings, bereavements.\r\nOrder by phone with CB payment."
    ],
    "it": [
      "Fiorista artigiano dal 2001.\r\n- Trasmissione floreale affiliata a Interflora e Florajet.\r\n- Consegna a domicilio.\r\n- Matrimoni, lutti.\r\nOrdini telefonici con pagamento con carta di credito."
    ],
    "fr": [
      "Artisan fleuriste depuis 2001.\r\n- Transmission florale affiliée à Interflora et Florajet.\r\n- Livraison à domicile.\r\n- Mariage, deuil.\r\nCommande par téléphone avec paiement CB."
    ],
    "es": [
      "Floristería artesanal desde 2001.\r\n- Transmisión floral afiliada a Interflora y Florajet.\r\n- Entrega a domicilio.\r\n- Bodas, duelos.\r\nPedidos por teléfono con pago por tarjeta de crédito."
    ],
    "nl": [
      "Ambachtelijke bloemist sinds 2001.\r\n- Bloemenverzending aangesloten bij Interflora en Florajet.\r\n- Levering aan huis.\r\n- Bruiloften, rouw.\r\nTelefonisch bestellen met betaling per creditcard."
    ]
  },
  "rdfs:label": {
