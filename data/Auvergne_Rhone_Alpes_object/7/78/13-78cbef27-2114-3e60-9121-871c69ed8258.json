  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Arbeit in den Weinbergen und die Lebensgewohnheiten der Bewohner des Forez mit Hilfe von Videos,\r\nAudiodateien, Modellen und Spielen in einem Schloss aus dem achtzehnten\r\nJahrhundert."
    ],
    "en": [
      "Catch a glimpse of life of Forez winegrowers at home and at work in a 18th century castle thanks to reconstructions, video and audio display."
    ],
    "it": [
      "Classificato come Monumento Storico, il castello, costruito alla fine del XVIII secolo, è di architettura neoclassica e presenta un'imponente facciata che si affaccia su un giardino di piacere composto da due terrazze."
    ],
    "fr": [
      "Classé Monument Historique, le château construit à la fin du XVIIIe siècle, d'architecture néo classique offre une façade imposante sur un jardin d'agrément composé de deux terrasses."
    ],
    "nl": [
      "Het kasteel, geklasseerd als Historisch Monument, is gebouwd aan het einde van de 18e eeuw, heeft een neoklassieke architectuur en een imposante gevel die uitkijkt op een lusthof bestaande uit twee terrassen."
    ],
    "es": [
      "Clasificado como Monumento Histórico, el castillo, construido a finales del siglo XVIII, es de arquitectura neoclásica y tiene una imponente fachada que da a un jardín de recreo compuesto por dos terrazas."
    ]
  },
