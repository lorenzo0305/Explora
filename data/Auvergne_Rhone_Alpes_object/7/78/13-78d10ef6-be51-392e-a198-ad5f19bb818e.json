  "rdfs:comment": {
    "de": [
      "Wagen Sie eine Westernwanderung in Combrailles!!! Ausritte von 1 Stunde, 2 Stunden, 3 Stunden zu Pferd, 1/2 oder 1 Tag, entdecken Sie das Morge-Tal und seine Mühlen oder den Gour de Tazenat. 2- bis 10-tägige Stern- oder Wanderwanderungen"
    ],
    "en": [
      "Dare to go western hiking in Combrailles!!! Rides of 1 hour, 2 hours, 3 hours on horseback, 1/2 or 1 day, discover the Morge valley and its mills or the Gour de Tazenat. 2 to 10 day star or itinerant hikes."
    ],
    "it": [
      "Osate fare la monta western a Combrailles!!! Escursioni a cavallo di 1h, 2h, 3h, 1/2 o 1 giorno, alla scoperta della valle della Morge e dei suoi mulini o della Gour de Tazenat. Escursioni da 2 a 10 giorni, in formazione stellare o itinerante."
    ],
    "fr": [
      "Osez la rando western en Combrailles !!! Balades de 1h, 2h, 3h à cheval, 1/2 ou 1 journée, découvrez la vallée de la Morge et ses moulins ou le Gour de Tazenat. Randonnées de 2 à 10 jours en étoile ou itinérantes."
    ],
    "es": [
      "¡¡¡Atrévete con la equitación western en Combrailles !!! Paseos de 1h, 2h, 3h a caballo, 1/2 o 1 día, descubra el valle de Morge y sus molinos o el Gour de Tazenat. Caminatas de 2 a 10 días, en formación estelar o itinerante."
    ],
    "nl": [
      "Ervaar het wilde westen met zwerftochten door de Combrailles, van\r\n2 tot 6 dagen, er zijn verschillende circuits."
    ]
  },
  "rdfs:label": {
