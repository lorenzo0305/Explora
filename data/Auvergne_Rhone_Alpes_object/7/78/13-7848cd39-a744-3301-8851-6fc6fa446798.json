  "rdfs:comment": {
    "de": [
      "Mit diesem Bus können Sie von Tence zur Gemeinde Yssingeaux fahren, Verbindung nach Le Puy en Velay (Linie H30).\r\nDiese Linie verkehrt nur während der Schulzeit."
    ],
    "en": [
      "This bus takes you from Tence to the town of Yssingeaux, on the way to Le Puy en Velay (line H30).\r\nThis service is only available during the school year."
    ],
    "it": [
      "Questo autobus vi porterà da Tence a Yssingeaux, sulla strada per Le Puy en Velay (linea H30).\r\nQuesto servizio è attivo solo durante le vacanze scolastiche."
    ],
    "fr": [
      "Ce bus vous permet de vous rendre depuis Tence  à la commune d'Yssingeaux, liaison vers Le Puy en Velay (ligne H30). \r\nCette ligne ne fonctionne qu'en période scolaire."
    ],
    "es": [
      "Este autobús le llevará de Tence a Yssingeaux, camino de Le Puy en Velay (línea H30).\r\nEste servicio sólo funciona durante las vacaciones escolares."
    ],
    "nl": [
      "Deze bus brengt je van Tence naar Yssingeaux, op weg naar Le Puy en Velay (lijn H30).\r\nDeze dienst rijdt alleen tijdens schoolvakanties."
    ]
  },
  "rdfs:label": {
