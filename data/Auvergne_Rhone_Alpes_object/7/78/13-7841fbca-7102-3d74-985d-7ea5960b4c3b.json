  "rdfs:comment": {
    "de": [
      "Dieses Viadukt ist für Wanderungen geöffnet. Er ist der ideale Aussichtspunkt, um den schönen Blick auf die Dörfer Neaux und Lay zu betrachten."
    ],
    "en": [
      "This viaduct is open to hikers. It's the ideal vantage point from which to contemplate the beautiful views over the villages of Neaux and Lay."
    ],
    "it": [
      "Questo viadotto è aperto agli escursionisti. È il punto di osservazione ideale per contemplare la splendida vista sui villaggi di Neaux e Lay."
    ],
    "fr": [
      "Ce viaduc est ouvert à la randonnée. C'est le belvédère idéal pour contempler le beau point de vue sur les villages de Neaux et de Lay."
    ],
    "es": [
      "Este viaducto está abierto a los senderistas. Es el mirador ideal para contemplar las hermosas vistas sobre los pueblos de Neaux y Lay."
    ],
    "nl": [
      "Dit viaduct is toegankelijk voor wandelaars. Het is het ideale uitkijkpunt voor een prachtig uitzicht over de dorpen Neaux en Lay."
    ]
  },
  "rdfs:label": {
