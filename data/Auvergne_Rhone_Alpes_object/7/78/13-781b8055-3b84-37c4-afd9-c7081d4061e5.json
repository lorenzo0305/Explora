  "rdfs:comment": {
    "de": [
      "Diese für die Gegend typische Kirche ist ein Muss in Carladès. Sie werden vom Reichtum ihrer Verzierungen, von ihren Schieferdächern und von ihrem Glockenturm mit Kamm überrascht sein."
    ],
    "en": [
      "Typical of the area, this church is a must-see in the Carladès region. You'll be amazed by the richness of its decoration, its slate roofs and its combed bell tower."
    ],
    "it": [
      "Tipica della zona, questa chiesa è una tappa obbligata del Carladès: vi sorprenderà per la ricchezza delle sue decorazioni, per i suoi tetti di ardesia e per il suo campanile a pettine."
    ],
    "fr": [
      "Typique du territoire cette église est un passage obligé dans le Carladès. vous serez surpris par la richesse de ses décors, par son toits en lauzes et par son clocher à peigne."
    ],
    "es": [
      "Típica de la región, esta iglesia es una visita obligada en el Carladès. Le sorprenderá la riqueza de su decoración, su tejado de pizarra y su campanario peinado."
    ],
    "nl": [
      "Deze kerk, typisch voor de streek, is een must in de Carladès. U zult verrast zijn door de rijkdom van de versieringen, de leistenen daken en de gekamde klokkentoren."
    ]
  },
  "rdfs:label": {
    "en": [
      "Notre Dame de l'Assomption Church"
    ],
    "fr": [
      "L'Eglise Notre Dame de l'Assomption"
    ],
    "es": [
      "Iglesia de Jou sous Monjou"
    ]
  },
