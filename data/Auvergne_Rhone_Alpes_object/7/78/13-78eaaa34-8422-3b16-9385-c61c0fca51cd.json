  "rdfs:comment": {
    "de": [
      "Teilen Sie ein reiches und hochwertiges Erlebnis mit Patricia De Gorostarzu, einer international anerkannten Berufsfotografin. Portraitshooting in idyllischer Umgebung mit Blick auf den Mont-Blanc."
    ],
    "en": [
      "Share a rich, high-quality experience with internationally-renowned professional photographer Patricia De Gorostarzu. A portrait session in an idyllic setting overlooking Mont Blanc."
    ],
    "it": [
      "Condividete un'esperienza ricca e di qualità con la fotografa professionista di fama internazionale Patricia De Gorostarzu. Una sessione di ritratti in un ambiente idilliaco con vista sul Monte Bianco."
    ],
    "fr": [
      "Partagez une expérience riche et de qualité avec Patricia De Gorostarzu, photographe professionnelle de renommée internationale. Séance de portrait dans un cadre idyllique face au Mont-Blanc."
    ],
    "nl": [
      "Deel een rijke ervaring van hoge kwaliteit met de internationaal gerenommeerde professionele fotograaf Patricia De Gorostarzu. Een portretsessie in een idyllische omgeving met uitzicht op de Mont Blanc."
    ],
    "es": [
      "Comparta una experiencia enriquecedora y de gran calidad con la fotógrafa profesional de renombre internacional Patricia De Gorostarzu. Una sesión de retrato en un entorno idílico con vistas al Mont Blanc."
    ]
  },
