  "rdfs:comment": {
    "de": [
      "Bar-Restaurant am Fuße des Sessellifts Mont Corbier mit hausgemachter Küche, die auf einer schönen Sonnenterrasse mit Blick auf die Aiguilles d'Arves genossen werden kann. Savoyische Abende, Fondue-Bar und Grill auf Reservierung."
    ],
    "en": [
      "High-altitude bar-restaurant at the foot of the Mont Corbier chairlift, serving home-cooked food on a sunny terrace facing the Aiguilles d'Arves. Savoyard evenings, fondue bar and grill available on reservation."
    ],
    "it": [
      "Bar-ristorante d'alta quota ai piedi della seggiovia del Mont Corbier, con cucina casalinga su una terrazza soleggiata di fronte alle Aiguilles d'Arves. Serate savoiarde, fondue bar e grigliate su prenotazione."
    ],
    "fr": [
      "Bar restaurant d’altitude situé au pied du télésiège Mont Corbier, proposant une cuisine maison, à déguster sur une belle terrasse ensoleillée face aux Aiguilles d’Arves. Soirées savoyardes, bar à fondue et grill sur réservation."
    ],
    "es": [
      "Bar-restaurante de gran altitud a los pies del telesilla del Mont Corbier, que sirve comida casera en una terraza soleada frente a las Agujas de Arves. Veladas saboyanas, bar de fondue y parrilla con reserva previa."
    ],
    "nl": [
      "Bar-restaurant op grote hoogte aan de voet van de stoeltjeslift Mont Corbier, serveert huisgemaakte gerechten op een zonnig terras met uitzicht op de Aiguilles d'Arves. Savoyaardse avonden, fonduebar en grill op afspraak."
    ]
  },
