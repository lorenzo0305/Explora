  "rdfs:comment": {
    "de": [
      "Der Chefkoch und sein Team empfangen Sie in einer freundlichen Atmosphäre und präsentieren Ihnen eine gepflegte, lokal inspirierte Bistroküche."
    ],
    "en": [
      "In a friendly atmosphere, the chef and his team welcome you with their carefully-crafted, locally-inspired bistronomic cuisine."
    ],
    "it": [
      "Lo chef e il suo team saranno lieti di accogliervi in un'atmosfera amichevole, servendovi una cucina bistrot accuratamente preparata e di ispirazione locale."
    ],
    "fr": [
      "C’est dans une ambiance conviviale que le chef et son équipe vous reçoivent, vous présentant une cuisine bistronomique soignée d’inspiration locale."
    ],
    "es": [
      "El chef y su equipo estarán encantados de recibirle en un ambiente acogedor, sirviéndole cocina de bistró cuidadosamente preparada e inspirada en la cocina local."
    ],
    "nl": [
      "De chef en zijn team verwelkomen je graag in een vriendelijke sfeer en serveren zorgvuldig bereide, lokaal geïnspireerde bistrogerechten."
    ]
  },
