  "rdfs:comment": {
    "de": [
      "Der D'Sybell Club Diskothek empfängt Sie in einer freundlichen Atmosphäre.\r\nIn Le Plan du Moulin gibt es einen großen kostenlosen Parkplatz.\r\nKonsultieren Sie unser Abendprogramm auf der Website der Diskothek.\r\nEmpfang von Gruppen Privatisierung."
    ],
    "en": [
      "The D'Sybell nightclub with its friendly atmosphere welcomes you every night.\r\nNightclub located in Plan du Moulin, access to car park.\r\nCheck out our evening programme on the night club's website.\r\nGroups/private bookings welcome."
    ],
    "it": [
      "Il disco club D'Sybell vi accoglie in un'atmosfera amichevole.\r\nAmpio parcheggio gratuito al Plan du Moulin.\r\nConsultate il programma delle serate sul sito web della discoteca.\r\nPrivatizzazione per gruppi."
    ],
    "fr": [
      "Le D'Sybell club discothèque vous accueille dans une ambiance conviviale.\r\nAu Plan du Moulin, grand parking gratuit.\r\nConsultez notre programme des soirées sur le site internet de la discothèque.\r\nAccueil de groupe privatisation."
    ],
    "es": [
      "La discoteca D'Sybell le da la bienvenida en un ambiente agradable.\r\nAmplio aparcamiento gratuito en Plan du Moulin.\r\nConsulte nuestra programación nocturna en la página web de la discoteca.\r\nPrivatización para grupos."
    ],
    "nl": [
      "Discotheek D'Sybell verwelkomt je elke avond in een gezellige sfeer.\r\nDiscotheek in Plan du Moulin, toegang tot de parkeerplaats.\r\nBekijk ons avondprogramma op de website van de discotheek.\r\nAf te huren voor groepen."
    ]
  },
  "rdfs:label": {
    "en": [
      "D'Sybell Nightclub"
    ],
