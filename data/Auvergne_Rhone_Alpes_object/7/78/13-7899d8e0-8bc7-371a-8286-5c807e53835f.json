  "rdfs:comment": {
    "de": [
      "Nach einer besonders festlichen 20. Jubiläumsausgabe setzt das Festival Mélodies sur Arzon sein Abenteuer fort und bekräftigt mehr denn je seine künstlerische und territoriale Verankerung."
    ],
    "en": [
      "After a particularly festive 20th anniversary edition, the Mélodies sur Arzon Festival continues its adventure and asserts more than ever its artistic and territorial roots."
    ],
    "it": [
      "Dopo un'edizione del ventennale particolarmente festosa, il Festival Mélodies sur Arzon continua la sua avventura e afferma più che mai le sue radici artistiche e locali."
    ],
    "fr": [
      "Après une 20ᵉ édition anniversaire particulièrement festive, le Festival Mélodies sur Arzon poursuit l’aventure et affirme plus que jamais son ancrage artistique et territorial."
    ],
    "es": [
      "Tras una edición del 20º aniversario especialmente festiva, el Festival Mélodies sur Arzon prosigue su aventura y afirma más que nunca sus raíces artísticas y locales."
    ],
    "nl": [
      "Na een bijzonder feestelijke editie van de 20e verjaardag zet het Festival Mélodies sur Arzon zijn avontuur voort en bevestigt het meer dan ooit zijn artistieke en lokale wortels."
    ]
  },
