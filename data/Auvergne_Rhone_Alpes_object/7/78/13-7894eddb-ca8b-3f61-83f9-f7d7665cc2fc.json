  "rdfs:comment": {
    "de": [
      "La Farlodoise empfängt Sie in seinem Restaurant mittags von Dienstag bis Samstag und abends von Dienstag bis Freitag. Ob auf der Terrasse oder im Speisesaal, es besteht die Möglichkeit, warme Menüs und Tapas zu genießen!"
    ],
    "en": [
      "La Farlodoise welcomes you to its restaurant for lunch from Tuesday to Saturday and for dinner from Tuesday to Friday. Enjoy hot menus and tapas on the terrace or in the dining room!"
    ],
    "it": [
      "La Farlodoise vi accoglie nel suo ristorante a pranzo dal martedì al sabato e a cena dal martedì al venerdì. Potrete gustare menu caldi e tapas sulla terrazza o nella sala da pranzo!"
    ],
    "fr": [
      "La Farlodoise vous accueille dans son restaurant les midis du mardi au samedi et les soirs du mardi au vendredi. Que ce soit en terrasse ou dans la salle de restaurant, possibilité de déguster menus chauds et tapas !"
    ],
    "nl": [
      "La Farlodoise verwelkomt je in haar restaurant voor de lunch van dinsdag tot en met zaterdag en voor het diner van dinsdag tot en met vrijdag. Je kunt genieten van warme menu's en tapas op het terras of in de eetzaal!"
    ],
    "es": [
      "La Farlodoise le da la bienvenida a su restaurante para el almuerzo de martes a sábado y para la cena de martes a viernes. Podrá degustar menús calientes y tapas en la terraza o en el comedor"
    ]
  },
