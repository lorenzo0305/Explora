  "rdfs:comment": {
    "de": [
      "Dieses gemütliche Restaurant im Herzen der Bauges bietet Ihnen eine traditionelle hausgemachte Küche aus frischen Produkten."
    ],
    "en": [
      "In the heart of the Bauges Mountains, this cozy restaurant offers traditional home-made cuisine using fresh produces.\r\nTwo menus to choose from to discover all the flavors of the dishes concocted by Cyril."
    ],
    "it": [
      "Nel cuore dei Bauges, questo accogliente ristorante offre una cucina casalinga tradizionale con prodotti freschi."
    ],
    "fr": [
      "En plein cœur des Bauges, ce restaurant chaleureux vous propose une cuisine traditionnelle maison à base de produits frais."
    ],
    "es": [
      "En el corazón de las Bauges, este acogedor restaurante ofrece cocina casera tradicional con productos frescos."
    ],
    "nl": [
      "Dit gezellige restaurant ligt midden in Les Bauges. Een traditionele keuken met verse producten. Twee menu's om de zeer smakelijke, huisgemaakte gerechten van Cyrille te ontdekken."
    ]
  },
