  "rdfs:comment": {
    "de": [
      "Ein von Geschichte und Innovation geprägter Ort, der das Fremdenverkehrsamt von Matheysine, einen Co-Working-Raum (nomadischer Raum) sowie Räume beherbergt, die für Schulungen, Seminare oder Meetings genutzt werden können."
    ],
    "en": [
      "A place steeped in history and innovation, it is home to the Matheysine Tourist Office, a co-working space (nomadic space) and areas for training courses, seminars and meetings."
    ],
    "it": [
      "Luogo ricco di storia e innovazione, ospita l'Ufficio del Turismo di Matheysine, uno spazio mobile di co-working e aree per corsi di formazione, seminari e riunioni."
    ],
    "fr": [
      "Un lieu empreint d’histoire et d’innovation qui accueille l’Office de Tourisme de la Matheysine, un espace de co-working (espace nomade) ainsi que des espaces pouvant recevoir des formations, séminaires ou réunions."
    ],
    "es": [
      "Lugar cargado de historia e innovación, alberga la Oficina de Turismo de Matheysine, un espacio móvil de cotrabajo y espacios para cursos de formación, seminarios y reuniones."
    ],
    "nl": [
      "Het is een plek met een rijke geschiedenis en innovatie en biedt onderdak aan het Matheysine Toeristenbureau, een mobiele co-working ruimte en ruimtes voor trainingen, seminars en vergaderingen."
    ]
  },
