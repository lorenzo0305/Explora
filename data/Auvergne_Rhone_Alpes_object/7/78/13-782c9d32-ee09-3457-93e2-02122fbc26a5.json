  "rdfs:comment": {
    "de": [
      "Eine Umgebung mit Steinmauern und Holzbalken, ein Blick auf die Saône: Das ist die Kulisse, in der Grégory Cuilleron an der Seite seines Bruders Thibault und Antoine Larmaraud täglich wechselnde Gerichte aus frischen Qualitätsprodukten zaubert."
    ],
    "en": [
      "A setting with exposed stones and beams, a view of the Saône: this is the setting where Grégory Cuilleron concocts cuisine renewed every day with fresh quality products, alongside his brother Thibault and Antoine Larmaraud."
    ],
    "it": [
      "Un ambiente con pietre e travi a vista, una vista sulla Saona: è questo l'ambiente in cui Grégory Cuilleron elabora ogni giorno una nuova cucina con prodotti freschi e di qualità, insieme al fratello Thibault e ad Antoine Larmaraud."
    ],
    "fr": [
      "Un cadre avec des pierres et poutres apparentes, une vue sur la Saône : voici le décor où Grégory Cuilleron concocte  cuisine renouvelée chaque jour avec des produits frais de qualité, aux côtés de son frère Thibault et d'Antoine Larmaraud."
    ],
    "es": [
      "Un entorno con piedras y vigas a la vista, una vista del Saona: este es el escenario donde Grégory Cuilleron elabora cada día una nueva cocina con productos frescos de calidad, junto a su hermano Thibault y Antoine Larmaraud."
    ],
    "nl": [
      "Een omgeving met zichtbare stenen en balken, een uitzicht op de Saône: dit is de omgeving waar Grégory Cuilleron elke dag een nieuwe keuken samenstelt met verse kwaliteitsproducten, samen met zijn broer Thibault en Antoine Larmaraud."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Cinq Mains"
    ]
  },
