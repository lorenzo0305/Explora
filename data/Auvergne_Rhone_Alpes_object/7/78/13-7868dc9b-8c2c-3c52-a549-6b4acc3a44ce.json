  "rdfs:comment": {
    "de": [
      "Nach 52 Serpentinen im Herzen eines tiefen Waldes taucht das Plateau von Albiez-le-Jeune auf, ein Juwel in seinem grünen Schmuckkästchen mit den majestätischen Aiguilles d'Arves als Diamant."
    ],
    "en": [
      "After 52 twists and turns through deep forest, the Albiez-le-Jeune plateau emerges, a jewel in its green setting, with the majestic Aiguilles d'Arves as its diamond."
    ],
    "it": [
      "Dopo 52 curve e tornanti nel cuore di una profonda foresta, emerge l'altopiano di Albiez-le-Jeune, un gioiello nella sua cornice verde con le maestose Aiguilles d'Arves come diamante."
    ],
    "fr": [
      "Après 52 lacets au cœur d’une forêt profonde surgit le plateau d’Albiez-le-Jeune, bijou dans son écrin de verdure avec comme diamant les majestueuses Aiguilles d’Arves."
    ],
    "es": [
      "Tras 52 curvas en el corazón de un profundo bosque, emerge la meseta de Albiez-le-Jeune, una joya en su verde entorno con las majestuosas Aiguilles d'Arves como diamante."
    ],
    "nl": [
      "Na 52 kronkels in het hart van een diep bos, duikt het plateau van Albiez-le-Jeune op, een juweel in zijn groene omgeving met de majestueuze Aiguilles d'Arves als diamant."
    ]
  },
