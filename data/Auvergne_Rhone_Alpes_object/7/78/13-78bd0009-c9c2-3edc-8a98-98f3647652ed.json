  "rdfs:comment": {
    "de": [
      "Une Note de Partage - Compagnie des Papillons Bleus hat als Ziel die Kreation, die Verbreitung und die Produktion von Live-Shows. Die in Dieulefit ansässige Kompanie ist auf Musik- und Marionettenaufführungen für ein junges Publikum spezialisiert."
    ],
    "en": [
      "Une Note de Partage - Compagnie des Papillons Bleus creates, presents and produces live shows. Based in Dieulefit, the company specializes in music and puppet shows for young audiences."
    ],
    "it": [
      "Une Note de Partage - La Compagnie des Papillons Bleus si propone di creare, distribuire e produrre spettacoli dal vivo. Con sede a Dieulefit, la compagnia è specializzata in spettacoli di musica e burattini per un pubblico giovane."
    ],
    "fr": [
      "Une Note de Partage - Compagnie des Papillons Bleus a pour but la création, la diffusion et la production de spectacles vivants. Basée à Dieulefit, la compagnie est spécialisée dans les spectacles musique et marionnettes à destination du jeune public."
    ],
    "es": [
      "Une Note de Partage - Compagnie des Papillons Bleus tiene como objetivo crear, distribuir y producir espectáculos en directo. Con sede en Dieulefit, la compañía está especializada en espectáculos de música y marionetas para el público infantil."
    ],
    "nl": [
      "Une Note de Partage - Compagnie des Papillons Bleus creëert, presenteert en produceert live voorstellingen. Het bedrijf is gevestigd in Dieulefit en is gespecialiseerd in muziek- en poppenvoorstellingen voor een jong publiek."
    ]
  },
