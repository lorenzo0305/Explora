  "rdfs:comment": {
    "de": [
      "Ein historischer Ort, eine besondere Stätte... Für Ihre Veranstaltungen: Versammlungen, Hochzeiten, Seminare, Arbeitsgruppen, Tagungen, Ausstellungen, Konzerte..."
    ],
    "en": [
      "An exceptional venue for your private receptions: wedding, birthday, baptism, communion, …and your corporate events: seminars, team building, conference, corporate evening, product launch … 20 minutes from Geneva and Annecy. At the foot of the “Salève”."
    ],
    "it": [
      "Un luogo storico eccezionale per i vostri ricevimenti privati: matrimoni, compleanni, battesimi... e per i vostri eventi aziendali: seminari, team building, conferenze, serate aziendali, lanci di prodotti... A 20 minuti da Ginevra e Annecy, ai piedi della Salève."
    ],
    "fr": [
      "Un lieu historique d'exception pour vos réceptions privées : mariage, anniversaire, baptême...et vos événements d'entreprise : séminaire, team building, conférence, soirée d'entreprise, lancement de produits..A 20mn de Genève et Annecy, au pied du Salève."
    ],
    "es": [
      "Un lugar histórico excepcional para sus recepciones privadas: bodas, cumpleaños, bautizos... y sus eventos corporativos: seminarios, team building, conferencias, veladas de empresa, lanzamientos de productos... A 20 minutos de Ginebra y Annecy, al pie de la Salève."
    ],
    "nl": [
      "Een uitzonderlijke historische plek voor uw privé-recepties: bruiloften, verjaardagen, doopfeesten...en uw bedrijfsevenementen: seminars, teambuilding, conferenties, bedrijfsfeesten, productlanceringen...op 20 minuten van Genève en Annecy, aan de voet van de Salève."
    ]
  },
