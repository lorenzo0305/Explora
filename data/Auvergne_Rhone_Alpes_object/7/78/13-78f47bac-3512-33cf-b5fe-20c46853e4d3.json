  "rdfs:comment": {
    "de": [
      "Das 2015 gegründete Pain du Montagnard ist ein Energieprodukt für Trailrunner, das aus einem Dutzend verschiedener Früchte, Akazienhonig, Zimt und Ingwer besteht."
    ],
    "en": [
      "Created in 2015, Pain du Montagnard is an energy product for trailers made from a dozen different fruits, acacia honey, cinnamon and ginger."
    ],
    "it": [
      "Creato nel 2015, Pain du Montagnard è un prodotto energetico per i trail runner a base di una dozzina di frutti diversi, miele di acacia, cannella e zenzero."
    ],
    "fr": [
      "Crée en 2015, le Pain du Montagnard est un produit énergétique à destination des trailers constitué d'une douzaine de fruits différents, de miel d’acacia, de cannelle et de gingembre."
    ],
    "nl": [
      "Pain du Montagnard werd gecreëerd in 2015 en is een energieproduct voor trailrunners gemaakt van een dozijn verschillende vruchten, acaciahoning, kaneel en gember."
    ],
    "es": [
      "Creado en 2015, Pain du Montagnard es un producto energético para corredores de trail elaborado con una docena de frutas diferentes, miel de acacia, canela y jengibre."
    ]
  },
