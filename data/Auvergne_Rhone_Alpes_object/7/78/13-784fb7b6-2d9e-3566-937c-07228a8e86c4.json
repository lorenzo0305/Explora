  "rdfs:comment": {
    "de": [
      "Handwerker und Kaufmann für gemischte Frisuren. Haarpflege, Hochzeitspaket. Färben, Dauerwellen, Brushing, Hochsteckfrisuren. Verkauf von Accessoires. System Professional-Serie, Sebastian-Produkte. Personalisierter Geschenkgutschein."
    ],
    "en": [
      "Mixed-race hairdresser. Hair care, wedding packages. Colorations, perms, blow-dries, chignons... Sale of accessories. System Professional range, Sebastian products. Personalized gift vouchers."
    ],
    "it": [
      "Artigiano-commerciante di parrucchieri misti. Trattamenti per capelli, pacchetti per matrimoni. Colorazione, permanenti, asciugatura, chignon... Vendita di accessori. Gamma System Professional, prodotti Sebastian. Buoni regalo personalizzati."
    ],
    "fr": [
      "Artisan-commerçant en coiffure mixte. Soins capillaires, forfait mariage. Colorations, permanentes, brushing, chignons... Vente d'accessoires. Gamme System Professional, produits Sebastian. Bon Cadeau personnalisé."
    ],
    "es": [
      "Artesano en peluquería mixta. Tratamientos capilares, paquetes de boda. Coloración, permanentes, secado, moños... Venta de accesorios. Gama System Professional, productos Sebastian. Cheques regalo personalizados."
    ],
    "nl": [
      "Ambachtelijke handelaar in gemengde kapsels. Haarbehandelingen, bruiloftsarrangementen. Kleuren, permanenten, föhnen, chignons... Verkoop van accessoires. Professioneel assortiment System, Sebastian producten. Gepersonaliseerde cadeaubonnen."
    ]
  },
