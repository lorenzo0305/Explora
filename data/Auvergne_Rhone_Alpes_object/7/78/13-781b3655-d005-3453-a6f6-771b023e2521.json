  "rdfs:comment": {
    "de": [
      "Sébastien und Sylvie leiten diese 1901 gegründete Mühle seit 1998 und bieten verschiedene Mehlsorten für Profis und Privatpersonen an."
    ],
    "en": [
      "Sébastien and Sylvie have been at the head of this mill founded in 1901 since 1998 and offer several types of flours for professionals and individuals."
    ],
    "it": [
      "Sébastien e Sylvie gestiscono questo mulino, fondato nel 1901, dal 1998 e offrono diversi tipi di farina per professionisti e privati."
    ],
    "fr": [
      "Sébastien et Sylvie sont à la tête de ce moulin fondé en 1901 depuis 1998 et proposent plusieurs types de farines pour professionnels et particuliers."
    ],
