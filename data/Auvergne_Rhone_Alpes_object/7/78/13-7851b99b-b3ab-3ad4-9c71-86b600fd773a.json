  "rdfs:comment": {
    "de": [
      "L'Écrin à Bijou und Ihr Bijou präsentieren Ihnen eine kabarettistische Mittagsshow, die zu 100% aus Transformatoren besteht. Emotionen, aber vor allem eine große Portion Humor sorgen für unvergessliche Momente. Ein einzigartiges und modernes Kabarett, das den größten Pariser Music-Halls würdig ist."
    ],
    "en": [
      "L'Écrin à Bijou and your Bijou present their 100% transformist cabaret lunchtime show. Emotion? but above all a good dose of humor for unforgettable moments. A unique, modern cabaret worthy of the greatest Parisian music halls."
    ],
    "it": [
      "L'Écrin à Bijou e il vostro Bijou presentano il loro spettacolo di cabaret 100% trasformista all'ora di pranzo. Emozione, ma soprattutto una buona dose di umorismo per momenti indimenticabili. Un cabaret unico e moderno, degno dei più grandi music-hall parigini."
    ],
    "fr": [
      "L’Écrin à Bijou et votre Bijou vous présentent son déjeuner-spectacle cabaret 100% transformiste. De l’émotion… mais surtout une bonne dose d’humour pour des moments inoubliables. Cabaret unique et moderne, digne des plus grands music-halls parisiens."
    ],
    "es": [
      "L'Écrin à Bijou y su Bijou presentan su espectáculo de mediodía de cabaret 100% transformista. Emoción... pero sobre todo una buena dosis de humor para momentos inolvidables. Un cabaret único y moderno digno de los más grandes music-halls parisinos."
    ],
    "nl": [
      "L'Écrin à Bijou en Jouw Bijou presenteren hun 100% transformistische cabaret middagvoorstelling. Emotie, maar vooral een flinke dosis humor voor onvergetelijke momenten. Een uniek, modern cabaret dat de grootste Parijse muziekzalen waardig is."
    ]
  },
  "rdfs:label": {
    "fr": [
