  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/e71dab44-3467-37bc-85d0-b467802b22e4",
      "dc:description": {
        "de": [
          "Einfache Küche aufgrund der Qualität der angebotenen lokalen und regionalen Produkte<br>Estaminet-Spiele, Aufführungen (Musik, Theater, Geschichtenerzähler auf dem Land, Diskussionsabende, Spieleabende...)"
        ],
        "en": [
          "Simple cooking thanks to the quality of the local and regional products on offer<br> Games, shows (music, theatre, storytellers in the countryside, debate evenings, game evenings...)"
        ],
        "it": [
          "Cucina semplice grazie alla qualità dei prodotti locali e regionali offerti<br>Giochi semplici, spettacoli (musica, teatro, cantastorie in campagna, serate di dibattito, serate di giochi...)"
        ],
        "fr": [
          "Cuisine simple de part la qualité des produits locaux et régionaux proposés<br>Jeux d'estaminet, spectacles (musique, théâtre, conteurs en campagne, soirées débat, soirée jeux...)"
        ],
        "nl": [
          "Eenvoudige keuken dankzij de kwaliteit van de aangeboden lokale en regionale producten<br>Publieksspelen, voorstellingen (muziek, theater, verhalenvertellers op het platteland, debatavonden, spelletjesavonden...)"
        ],
        "es": [
          "Cocina sencilla gracias a la calidad de los productos locales y regionales ofrecidos<br>Juegos públicos, espectáculos (música, teatro, cuentacuentos en el campo, veladas de debate, noches de juegos...)"
        ]
      },
