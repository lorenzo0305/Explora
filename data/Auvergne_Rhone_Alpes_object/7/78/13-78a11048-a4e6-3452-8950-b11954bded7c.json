  "rdfs:comment": {
    "de": [
      "Traditionelle Küche in diesem brandneuen Restaurant, das über zwei Speisesäle verfügt. Außerdem können Sie in ihrem Lounge-Bereich einen Drink genießen und dabei ruhig sitzen! Das Sandjo bietet auch Themenabende an."
    ],
    "en": [
      "Traditional cuisine in this brand-new restaurant with two dining rooms. What's more, you can enjoy a quiet drink in their lounge area! Sandjo also offers themed evenings."
    ],
    "it": [
      "Cucina tradizionale in questo nuovissimo ristorante con due sale da pranzo. Inoltre, potrete sorseggiare un drink in tutta tranquillità nell'area lounge! Il Sandjo offre anche serate a tema."
    ],
    "fr": [
      "Cuisine traditionnelle pour ce restaurant tout neuf qui dispose de deux salles de restaurant. De plus, vous pourrez boire un verre en étant au calme dans leur espace Lounge ! Le Sandjo propose également des soirées à thèmes."
    ],
    "nl": [
      "Traditionele gerechten in dit gloednieuwe restaurant met twee eetzalen. Bovendien kun je in alle rust genieten van een drankje in hun loungeruimte! Sandjo biedt ook thema-avonden."
    ],
    "es": [
      "Cocina tradicional en este flamante restaurante con dos comedores. Además, podrá disfrutar de una copa tranquilamente en su salón Sandjo también ofrece veladas temáticas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Sandjo Caferestau"
    ]
  },
