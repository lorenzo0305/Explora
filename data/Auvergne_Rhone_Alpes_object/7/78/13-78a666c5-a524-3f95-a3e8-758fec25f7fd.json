  "rdfs:comment": {
    "de": [
      "Wegen ihrer Größe und der reichen Innenausstattung wird sie auch die Kathedrale der Berge genannt. Sie wurde ab 1869 erbaut. Neogotischer Stil, daher der Glockenturm mit einer großen durchbrochenen Spitze, die mit einer dreiseitigen Rosette verziert ist."
    ],
    "en": [
      "Nicknamed the Cathedral of the mountains because of its size and the richness of it's interior decoration. Built from 1869 in a Neo-Gothic style, its bell tower has a large open spire adorned with a rosette."
    ],
    "it": [
      "È soprannominata la Cattedrale delle Montagne per la sua imponenza e la ricchezza delle sue decorazioni interne. Costruita nel 1869. Stile neogotico, da cui il campanile con una grande guglia traforata ornata da un rosone trilobato."
    ],
    "fr": [
      "Elle est surnommée la Cathédrale des Montagnes à cause de sa grandeur et de la richesse de sa décoration intérieure. Bâtie à partir de 1869. Style néo-gothique, d'où son clocher présentant une grande flèche ajourée, ornée d'une rosace trilobée."
    ],
    "es": [
      "Recibe el sobrenombre de Catedral de las Montañas por su grandiosidad y la riqueza de su decoración interior. Construida en 1869. De estilo neogótico, de ahí su campanario con una gran aguja calada adornada con un rosetón trilobulado."
    ],
    "nl": [
      "Het heeft de bijnaam de Kathedraal van de Bergen vanwege de grootsheid en de rijkdom van de interieurdecoratie. Gebouwd in 1869. Neogotische stijl, vandaar de klokkentoren met een grote opengewerkte spits versierd met een drielobbig roosvenster."
    ]
  },
  "rdfs:label": {
    "en": [
      "Church Saint Jean-Baptiste"
    ],
    "fr": [
      "Église Saint-Jean-Baptiste"
    ]
  },
