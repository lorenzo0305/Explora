  "rdfs:comment": {
    "de": [
      "Auf dieser geführten Tour entdecken Sie die ungeahnten Schätze von Suze-la-Rousse, einem malerischen Dorf, das sich am Fuße einer beeindruckenden Festung im Stil des Mittelalters und der Renaissance eingenistet hat."
    ],
    "en": [
      "This guided tour will allow you to discover the unsuspected treasures of Suze-la-Rousse, a picturesque village nestled at the foot of an impressive medieval and Renaissance style fortress."
    ],
    "it": [
      "Grazie a questa visita guidata, potrete scoprire i tesori insospettabili di Suze-la-Rousse, un pittoresco villaggio adagiato ai piedi di un'imponente fortezza medievale e rinascimentale."
    ],
    "fr": [
      "Cette visite commentée vous permettra de découvrir les trésors insoupçonnés de Suze-la-Rousse, village pittoresque niché au pied d’une impressionnante forteresse de style médiéval et Renaissance."
    ],
    "nl": [
      "Tijdens deze rondleiding ontdek je de onvermoede schatten van Suze-la-Rousse, een pittoresk dorpje aan de voet van een indrukwekkend fort uit de middeleeuwen en de renaissance."
    ],
    "es": [
      "En esta visita guiada, podrá descubrir los tesoros insospechados de Suze-la-Rousse, un pintoresco pueblo enclavado a los pies de una impresionante fortaleza medieval y renacentista."
    ]
  },
  "rdfs:label": {
    "en": [
      "Visite commentée \"Suze-la-Rousse la médiévale\""
    ],
    "fr": [
      "Visite commentée \"Suze-la-Rousse la médiévale\""
    ]
  },
