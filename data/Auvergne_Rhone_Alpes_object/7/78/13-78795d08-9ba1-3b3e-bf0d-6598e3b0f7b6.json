  "rdfs:comment": {
    "de": [
      "Kostenlose Verkostung. Führungen für Gruppen (min. 6 Pers.) auf Anfrage. Produzent von Clairette und Bio-Weinen aus Châtillon (rot, weiß und rosé). Präsentation eines Jahres der Weinbereitung auf dem Weingut und der Arbeit in den Weinbergen auf einem Bildschirm im Weinkeller."
    ],
    "en": [
      "Free wine tasting. Individual or group guided-tour by appointment. We produce Clairette white sweet sparkling wine and Châtillon wines (red, white and rosé). At the wine cellar, screen presentation of the various steps of wine production and the work carried out in the vine over a year. Duration 30mn"
    ],
    "it": [
      "Degustazione gratuita. Visite guidate per gruppi (min. 6 persone) su richiesta. Produttore di vini Clairette e Châtillon biologico (rosso, bianco e rosé). Presentazione di un anno di vinificazione della tenuta e del lavoro in vigna su schermo in cantina."
    ],
    "fr": [
      "Dégustation gratuite. Visite guidée en groupe (min 6 pers) sur demande. Producteur de Clairette et de vins bio de Châtillon (rouges, blancs et rosé). Présentation d'une année de vinification au domaine et du travail de la vigne sur écran au caveau."
    ],
    "nl": [
      "Gratis proeven. Rondleidingen voor groepen (min. 6 personen) op aanvraag. Producent van Clairette en biologische Châtillon wijnen (rood, wit en rosé). Presentatie van een jaar wijnmaken op het domein en werk in de wijngaard op scherm in de kelder."
    ],
    "es": [
      "Degustación gratuita. Visitas guiadas para grupos (mínimo 6 personas) previa petición. Productor de vinos Clairette y Châtillon bio (tinto, blanco y rosado). Presentación de un año de viticultura en la finca y trabajo en el viñedo en pantalla en la bodega."
    ]
  },
  "rdfs:label": {
    "en": [
      "Cave Jérôme Cayol - Domaine de Maupas - Guided-Tour"
    ],
    "fr": [
      "Visite Guidée - Domaine de Maupas - Cave Jérôme et Zoé Cayol - Père & fille"
    ]
  },
