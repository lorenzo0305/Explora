  "rdfs:comment": {
    "de": [
      "Ein Familienrestaurant, in dem mit Herz und Lächeln gekocht wird\r\nHier werden Sie auf eine Reise zwischen Argentinien und Italien mitgenommen, mit frischer hausgemachter Pasta und großzügigen Rezepten."
    ],
    "en": [
      "A family restaurant where we cook with a heart and a smile\r\nHere, we take you on a journey between Argentina and Italy, with fresh homemade pasta and generous recipes."
    ],
    "it": [
      "Un ristorante familiare dove cuciniamo con il cuore e con il sorriso\r\nQui vi portiamo in un viaggio tra Argentina e Italia, con pasta fresca fatta in casa e ricette generose."
    ],
    "fr": [
      "Un restaurant familial où l’on cuisine avec le cœur et le sourire \r\nIci, on vous fait voyager entre l’Argentine  et l’Italie , à travers des pâtes fraîches maison et des recettes généreuses."
    ],
    "es": [
      "Un restaurante familiar donde cocinamos con el corazón y la sonrisa\r\nAquí te llevamos de viaje entre Argentina e Italia, con pastas frescas caseras y recetas generosas."
    ],
    "nl": [
      "Een familierestaurant waar we koken met een hart en een glimlach\r\nHier nemen we je mee op een reis tussen Argentinië en Italië, met verse zelfgemaakte pasta en royale recepten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La main à la pâte"
    ]
  },
