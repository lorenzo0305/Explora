  "rdfs:comment": {
    "de": [
      "Teestube - Restaurant. Gerichte, die ausschließlich aus frischen Produkten bestehen, wobei die lokale Produktionskette bevorzugt wird. Salate, Sandwiches, Tagesgerichte, hausgemachtes Gebäck. Gerichte zum Mitnehmen."
    ],
    "en": [
      "Tea room - restaurant. Dishes made up only of fresh products with a preference for local produce. Salads, sandwiches, dishes of the day, home-made pastries. Dishes to take away."
    ],
    "it": [
      "Sala da tè - ristorante. Piatti composti esclusivamente da prodotti freschi, con particolare attenzione ai prodotti locali. Insalate, panini, specialità del giorno, dolci fatti in casa. Pasti da asporto."
    ],
    "fr": [
      "Salon de thé - restaurant. Plats composés uniquement de produits frais en privilégiant la filière locale. Salades, sandwichs, plats du jour, pâtisseries maison. Plats à emporter."
    ],
    "nl": [
      "Theesalon - restaurant. Gerechten die uitsluitend bestaan uit verse producten, met de nadruk op lokale producten. Salades, sandwiches, dagschotels, huisgemaakt gebak. Afhaalmaaltijden."
    ],
    "es": [
      "Salón de té - restaurante. Platos compuestos exclusivamente por productos frescos, con énfasis en los productos locales. Ensaladas, sándwiches, especialidades del día, bollería casera. Comidas para llevar."
    ]
  },
