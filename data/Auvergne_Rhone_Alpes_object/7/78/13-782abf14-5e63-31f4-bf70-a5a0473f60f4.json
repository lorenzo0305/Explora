  "rdfs:comment": {
    "de": [
      "Der Kunstverein LES ARTS LIBRES freut sich, Ihnen in seinem 59\r\nfrühlingssalon die Gemälde seiner Mitglieder zu präsentieren, die im Laufe des vergangenen Jahres entstanden sind."
    ],
    "en": [
      "The LES ARTS LIBRES art association is pleased to present its 59th spring exhibition\r\nthe paintings created by its members over the past year."
    ],
    "it": [
      "L'associazione d'arte LES ARTS LIBRES è lieta di presentare la sua 59a mostra di primavera\r\ni dipinti realizzati dai suoi membri nel corso dell'ultimo anno."
    ],
    "fr": [
      "L'association artistique LES ARTS LIBRES a le plaisir de vous présenter, pour son 59ème salon\r\nde printemps, les peintures de ses adhérents réalisées tout au long de l'année écoulée."
    ],
    "es": [
      "La asociación artística LES ARTS LIBRES se complace en presentar su 59ª exposición de primavera\r\nlos cuadros creados por sus miembros a lo largo del año pasado."
    ],
    "nl": [
      "De kunstvereniging LES ARTS LIBRES presenteert met veel plezier haar 59e voorjaarstentoonstelling\r\nde schilderijen die de leden het afgelopen jaar hebben gemaakt."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Exposition peinture - 59ème salon de printemps"
    ]
  },
