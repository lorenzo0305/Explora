  "rdfs:comment": {
    "de": [
      "Die Steinbrüche veranschaulichen eine faszinierende Vergangenheit von Châteauneuf: Die Gewinnung und das Schneiden von Stein waren eine wichtige wirtschaftliche Aktivität für das Dorf."
    ],
    "en": [
      "The quarries illustrate Châteauneuf?s fascinating past: stone quarrying and cutting were important economic activities for the village."
    ],
    "it": [
      "Le cave illustrano l'affascinante passato di Châteauneuf: l'estrazione e il taglio della pietra erano attività economiche importanti per il villaggio."
    ],
    "fr": [
      "Les carrières illustrent un passé fascinant de Châteauneuf : l’extraction et la taille de la pierre ont été une activité économique importante pour le village."
    ],
    "es": [
      "Las canteras ilustran el fascinante pasado de Châteauneuf: la extracción y el corte de piedra eran actividades económicas importantes para el pueblo."
    ],
    "nl": [
      "De steengroeven illustreren het fascinerende verleden van Châteauneuf: steengroeven en steenhouwen waren belangrijke economische activiteiten voor het dorp."
    ]
