  "rdfs:comment": {
    "de": [
      "Gönnen Sie sich eine Pause in unserem ruhigen und bezaubernden Geheimgarten, der nur wenige Schritte vom See entfernt liegt. Chefkoch Steve Casali bietet Ihnen eine hausgemachte, delikate und schmackhafte Küche mit Respekt für frische und lokale Produkte."
    ],
    "en": [
      "Take a break in our quiet and enchanting secret garden just a stone's throw from the lake. Chef Steve Casali offers you a delicate and tasty home cooking, respecting fresh and local products."
    ],
    "it": [
      "Concedetevi una pausa nel nostro tranquillo e incantevole giardino segreto a due passi dal lago. Lo chef Steve Casali propone una cucina casalinga delicata e gustosa, a base di prodotti freschi e locali."
    ],
    "fr": [
      "Faites une pause dans notre jardin secret calme et enchanteur à deux pas du lac. Le chef Steve Casali vous propose une cuisine maison, délicate et savoureuse dans le respect des produits frais et locaux."
    ],
    "es": [
      "Tómese un descanso en nuestro tranquilo y encantador jardín secreto, a tiro de piedra del lago. El chef Steve Casali ofrece una cocina casera, delicada y sabrosa, elaborada con productos frescos de la zona."
    ],
    "nl": [
      "Neem een pauze in onze rustige, betoverende geheime tuin op een steenworp afstand van het meer. Chef-kok Steve Casali biedt een verfijnde, smakelijke keuken met verse, lokale producten."
    ]
  },
