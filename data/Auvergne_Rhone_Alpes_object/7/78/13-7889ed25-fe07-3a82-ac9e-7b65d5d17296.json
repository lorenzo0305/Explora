  "rdfs:comment": {
    "de": [
      "Die Kirche Sainte-Madeleine stammt aus dem 12. bis 13. Jahrhundert. Sie war von der mächtigen Limousin-Abtei Port-Dieu abhängig. Die Wandmalereien, deren Ursprung mysteriös ist, sollen aus dem 17. und 19. Jahrhundert stammen: Sternenhimmel und Pflanzenmotive bedecken die Gewölbe."
    ],
    "en": [
      "The church of Sainte Madeline dates from the 12th &13th centuries. The murals have a mysterious origin and date from the 17th and 19th centuries. The vaults are covered in starry skies, and vegetable motifs."
    ],
    "it": [
      "La chiesa di Sainte-Madeleine risale al XII-XIII secolo. Apparteneva alla potente abbazia limosina di Port-Dieu. Le pitture murali, di origine misteriosa, risalgono al XVII e al XIX secolo: cieli stellati e motivi vegetali ricoprono le volte."
    ],
    "fr": [
      "L'église Sainte-Madeleine date des XII-XIIIe siècles. Elle dépendait de la puissante abbaye limousine de Port-Dieu. Les peintures murales, d'origine mystérieuse, dateraient des XVIIe et XIXe siècles : ciel étoilé, motifs végétaux couvrent les voûtes."
    ],
    "es": [
      "La iglesia Sainte-Madeleine data de los siglos XII-XIII. Perteneció a la poderosa abadía lemosina de Port-Dieu. Las pinturas murales, de origen misterioso, datan de los siglos XVII y XIX: cielos estrellados y motivos vegetales cubren las bóvedas."
    ],
    "nl": [
      "De kerk Sainte-Madeleine dateert uit de 12e-13e eeuw. Ze behoorde toe aan de machtige Limousin abdij van Port-Dieu. De mysterieuze muurschilderingen dateren uit de 17e en 19e eeuw: sterrenhemels en plantenmotieven bedekken de gewelven."
    ]
  },
  "rdfs:label": {
    "en": [
      "Church of Saint Madeleine"
    ],
    "fr": [
      "Église Sainte-Madeleine"
    ]
  },
