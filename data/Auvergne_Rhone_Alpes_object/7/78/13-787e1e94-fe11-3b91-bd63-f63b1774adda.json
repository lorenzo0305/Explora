  "rdfs:comment": {
    "de": [
      "Basilic & Co Voiron bietet Ihnen Pizzas, Focaccias, Ravioli-Gratins und Salate, die mit regionalen und außergewöhnlichen Produkten zubereitet werden. Zum Verzehr vor Ort oder zum Mitnehmen. Es besteht auch die Möglichkeit, sich beliefern zu lassen."
    ],
    "en": [
      "Basilic & Co Voiron offers pizzas, focaccias and salads made with exceptional local produce. To eat in or take away. Delivery service available."
    ],
    "it": [
      "Basilic & Co Voiron offre pizze, focacce, ravioli gratinati e insalate realizzate con eccezionali prodotti locali. Da mangiare o da portare via. Servizio di consegna disponibile."
    ],
    "fr": [
      "Basilic & Co Voiron vous propose des pizzas, des focaccias, des gratins de ravioles et des salades élaborées avec des produits du terroir et d'exceptions. À déguster sur place ou bien à emporter. Possibilité de se faire livrer."
    ],
    "es": [
      "Basilic & Co Voiron ofrece pizzas, focaccias, raviolis gratinados y ensaladas elaboradas con excepcionales productos locales. Para comer en el restaurante o para llevar. Servicio a domicilio disponible."
    ],
    "nl": [
      "Basilic & Co Voiron biedt pizza's, focaccia's, ravioli gratins en salades gemaakt met uitzonderlijke lokale producten. Om te eten of om mee te nemen. Bezorgservice beschikbaar."
    ]
  },
  "rdfs:label": {
    "en": [
