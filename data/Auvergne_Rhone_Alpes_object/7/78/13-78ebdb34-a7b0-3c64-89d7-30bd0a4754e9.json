  "rdfs:comment": {
    "de": [
      "Traditioneller Bauernhof auf der Alm. Spezialitäten aus Savoyen. Aubrac-Fleisch aus eigener Zucht. Skizugang über die Ankunft des Skilifts von Les Lanchettes und Rochefort. Zugang zu Fuß über den Gipfel der Seilbahn von Rochebrune und des Sessellifts von Petite Fontaine."
    ],
    "en": [
      "Traditional high pasture farmhouse. Savoyard specialities. Aubrac beef originating from our farm. Access on skis via the top of the Lanchettes and Rochefort draglifts. Access on foot via the summit of the Rochebrune cable car and the Petite Fontaine chairlift."
    ],
    "it": [
      "Tradizionale fattoria di alpeggio. Specialità savoiarde. Carne Aubrac del nostro allevamento. Accesso in sci dallo skilift di Lanchettes e Rochefort. Accesso a piedi dalla teleferica di Rochebrune e dalla seggiovia di Petite Fontaine."
    ],
    "fr": [
      "Ferme traditionnelle d’alpage. Spécialités savoyardes. Viande Aubrac issue de notre élevage. Accès ski par l’arrivée du téléski des Lanchettes et de Rochefort. Accès piéton par le sommet du téléphérique de Rochebrune et du télésiège de Petite Fontaine."
    ],
    "nl": [
      "Traditionele boerderij op bergweiden. Savoyaardse specialiteiten. Aubrac vlees van eigen boerderij. Skitoegang vanaf de skiliften van Lanchettes en Rochefort. Toegang voor voetgangers vanaf de kabelbaan van Rochebrune en de stoeltjeslift Petite Fontaine."
    ],
    "es": [
      "Granja tradicional de pastos de montaña. Especialidades saboyanas. Carne de Aubrac de nuestra propia granja. Acceso para esquiadores desde los remontes de Lanchettes y Rochefort. Acceso peatonal desde lo alto del teleférico de Rochebrune y del telesilla Petite Fontaine."
    ]
  },
