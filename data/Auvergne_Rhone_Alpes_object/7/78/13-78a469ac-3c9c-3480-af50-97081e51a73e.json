  "rdfs:comment": {
    "de": [
      "Alexandra bietet eine Vielzahl von Aktivitäten zu Pferd und auf Ponys mit Ausritten, Mini-Camps, Ponytaufen, Entdeckungspraktika, Begegnungen mit Kleintieren, einen Tag lang oder einen Aufenthalt lang."
    ],
    "en": [
      "Alexandra offers a wide range of horse and pony activities, including rides, mini-camps, pony baptisms, discovery courses and encounters with small animals, for a day or a longer stay."
    ],
    "it": [
      "Alexandra offre un'ampia gamma di attività con cavalli e pony, tra cui passeggiate, mini-campi, battesimi di pony, corsi di scoperta e incontri con piccoli animali, per un giorno o una vacanza."
    ],
    "fr": [
      "Alexandra propose une multitude d'activité à cheval et à poneys avec des balades, des mini-camps, des baptêmes poneys, stages découvertes, rencontre avec les petits animaux, le temps d'une journée ou d'un séjour."
    ],
    "es": [
      "Alexandra ofrece una amplia gama de actividades con caballos y ponis, como paseos, minicampamentos, bautismos con ponis, cursos de descubrimiento y encuentros con pequeños animales, para un día o unas vacaciones."
    ],
    "nl": [
      "Alexandra biedt een breed scala aan paarden- en ponyactiviteiten, waaronder ritten, minicampings, dopen van pony's, ontdekkingscursussen en ontmoetingen met kleine dieren, voor een dag of een vakantie."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ferme équestre Les Paturâles"
    ]
  },
