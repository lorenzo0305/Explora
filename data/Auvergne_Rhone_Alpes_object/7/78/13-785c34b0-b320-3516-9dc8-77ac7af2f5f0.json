  "rdfs:comment": {
    "de": [
      "Mars prend ses quartiers kehrt im 9. Jahr zurück: Ausstellungen, kommentierte Führungen, Dokumentarfilme... RDV mit dem Pays d'Art et d'Histoire für eine kommentierte historische und architektonische Besichtigung des \"Château Chambriard\"."
    ],
    "en": [
      "Mars prend ses quartiers returns for the 9th year: exhibitions, guided tours, documentaries... Join the Pays d'Art et d'Histoire for a guided tour of the history and architecture of \"Château Chambriard\"."
    ],
    "it": [
      "Mars prend ses quartiers torna per il nono anno: mostre, visite guidate, documentari... Unitevi al Pays d'Art et d'Histoire per una visita guidata alla storia e all'architettura di \"Château Chambriard\"."
    ],
    "fr": [
      "Mars prend ses quartiers revient pour la 9e année : expositions, visites commentées, documentaires... RDV avec le Pays d'Art et d'Histoire pour une visite commentée historique et architecturale du \"château Chambriard\"."
    ],
    "es": [
      "Mars prend ses quartiers vuelve por noveno año: exposiciones, visitas guiadas, documentales... Únase al Pays d'Art et d'Histoire para una visita guiada por la historia y la arquitectura del \"Château Chambriard\"."
    ],
    "nl": [
      "Mars prend ses quartiers is terug voor het 9e jaar: tentoonstellingen, rondleidingen, documentaires... Ga mee met het Pays d'Art et d'Histoire voor een rondleiding door de geschiedenis en architectuur van \"Château Chambriard\"."
    ]
  },
  "rdfs:label": {
    "fr": [
