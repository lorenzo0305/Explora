  "rdfs:comment": {
    "de": [
      "Die Sancy-Seilbahn ist der schnellste und einfachste Weg, um den Puy de Sancy, den höchsten Vulkan Frankreichs, zu entdecken!"
    ],
    "en": [
      "The Sancy Cable Car is the fastest and easiest way to discover the Puy de Sancy, the highest volcano in France!"
    ],
    "it": [
      "La funivia del Sancy è il modo più semplice e veloce per scoprire il Puy de Sancy, il vulcano più alto della Francia!"
    ],
    "fr": [
      "Le Téléphérique du Sancy est le moyen le plus rapide et le plus facile de découvrir le Puy de Sancy, le plus haut volcan de France !"
    ],
    "es": [
      "El teleférico de Sancy es la forma más rápida y sencilla de descubrir el Puy de Sancy, el volcán más alto de Francia"
    ],
    "nl": [
      "De Sancy Cable Car is de snelste en gemakkelijkste manier om de Puy de Sancy, de hoogste vulkaan van Frankrijk, te ontdekken!"
    ]
