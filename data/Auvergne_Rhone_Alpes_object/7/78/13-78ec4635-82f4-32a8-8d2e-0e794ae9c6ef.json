  "rdfs:comment": {
    "de": [
      "Die Stiftskirche Notre-Dame, die auf eine schöne mittelalterliche Legende zurückgeht, nimmt einen zentralen Platz in der Stadt Burgund und insbesondere in den Herzen ihrer Bewohner ein. Der Bau wurde im Spätmittelalter begonnen und erst 190 Jahre später abgeschlossen!"
    ],
    "en": [
      "The collegiate church of Notre-Dame, the stuff of medieval legend, occupies a central place in the city of Burgundy, and particularly in the hearts of its inhabitants. Construction began in the late Middle Ages, but was not completed until 190 years later!"
    ],
    "it": [
      "La collegiata di Notre-Dame, oggetto di leggende medievali, occupa un posto centrale nella città di Borgogna e soprattutto nel cuore dei suoi abitanti. La sua costruzione iniziò nel tardo Medioevo, ma fu completata solo 190 anni dopo!"
    ],
    "fr": [
      "La collégiale Notre-Dame, issue d'une belle légende médiévale, occupe une place centrale dans la cité burgienne et plus particulièrement dans le cœur de ses habitants. Débutée à la fin du Moyen-Age, la construction ne s'achèvera que 190 ans plus tard !"
    ],
    "es": [
      "La colegiata de Notre-Dame, objeto de leyendas medievales, ocupa un lugar central en la ciudad de Borgoña y, más concretamente, en el corazón de sus habitantes. Su construcción comenzó a finales de la Edad Media, pero no se terminó hasta 190 años más tarde"
    ],
    "nl": [
      "De collegiale kerk Notre-Dame, een middeleeuwse legende, neemt een centrale plaats in in de stad Bourgondië en vooral in de harten van haar inwoners. De bouw begon in de late middeleeuwen, maar werd pas 190 jaar later voltooid!"
    ]
  },
