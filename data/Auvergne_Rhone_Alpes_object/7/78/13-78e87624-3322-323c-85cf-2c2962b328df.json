  "rdfs:comment": {
    "de": [
      "Die Burg beherbergte eine Grundherrschaft, die Familie von Ternier, die eine kleine lokale Gerichtsbarkeit genoss. Die Burg bestand aus einem Bergfried, einem Hof, Wohngebäuden und einer Kapelle, die Saint-Nicolas geweiht war."
    ],
    "en": [
      "The château was home to a seigneury, the Ternier family, with a small local jurisdiction. The château comprised a keep, a courtyard, living quarters and a chapel dedicated to Saint-Nicolas."
    ],
    "it": [
      "Il castello ospitava una signoria, la famiglia Ternier, che aveva una piccola giurisdizione locale. Il castello era composto da un mastio, un cortile, alloggi e una cappella dedicata a Saint-Nicolas."
    ],
    "fr": [
      "Le château abritait une seigneurie, la Famille de Ternier, qui jouissait d'une petite juridiction local. Le château était composé d'un donjon, d'une cour, de logements et d'une chapelle dédiée à Saint-Nicolas."
    ],
    "nl": [
      "Het kasteel was de thuisbasis van een heerlijkheid, de familie Ternier, die een kleine lokale jurisdictie had. Het kasteel bestond uit een donjon, een binnenplaats, woonvertrekken en een kapel gewijd aan Saint-Nicolas."
    ],
    "es": [
      "El castillo albergaba un señorío, la familia Ternier, que tenía una pequeña jurisdicción local. El castillo constaba de una torre del homenaje, un patio, alojamientos y una capilla dedicada a San Nicolás."
    ]
  },
