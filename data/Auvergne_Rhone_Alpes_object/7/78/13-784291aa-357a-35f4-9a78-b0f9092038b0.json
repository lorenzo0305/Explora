  "rdfs:comment": {
    "de": [
      "Hallo! Ich bin Micka, Höhlenführer. Ich biete Ihnen an, die Schönheiten der unterirdischen Welt meiner Region zu entdecken. Ab 6 Jahren finden Sie den Ausflug, der zu Ihnen passt. Für Neugierige oder Sportler, ein Abenteuer, das Sie mit der Familie oder mit Freunden erleben können!"
    ],
    "en": [
      "Hi, I'm Micka, caving guide. I invite you to discover the beauties of the underground world in my region. From 6 years old, find the outing that suits you. For the curious or the sporty, an adventure to enjoy with family and friends!"
    ],
    "it": [
      "Ciao, sono Micka, una guida speleologica. Vorrei invitarvi a venire a scoprire la bellezza del mondo sotterraneo nella mia regione. A partire dai 6 anni, trovate l'escursione che fa per voi. Che siate curiosi o sportivi, questa è un'avventura da vivere con la famiglia o con gli amici!"
    ],
    "fr": [
      "Salut ! Je suis Micka, guide spéléo. Je vous propose de venir découvrir les beautés du monde souterrain de ma région. A partir de 6 ans, trouvez la sortie qui vous convient. Pour les curieux ou les sportifs, une aventure à vivre en famille ou entre amis !"
    ],
    "es": [
      "Hola, soy Micka, guía de espeleología. Me gustaría invitarte a que vengas a descubrir la belleza del mundo subterráneo de mi región. A partir de 6 años, encuentra la excursión que más te convenga. Ya seas curioso o deportista, ¡ésta es una aventura que puedes disfrutar con tu familia o amigos!"
    ],
    "nl": [
      "Hallo, ik ben Micka, een speleologiegids. Ik nodig je graag uit om de schoonheid van de ondergrondse wereld in mijn regio te komen ontdekken. Vanaf 6 jaar kun je de tocht vinden die bij je past. Of je nu nieuwsgierig of sportief bent, dit is een avontuur waar je samen met je familie of vrienden van kunt genieten!"
    ]
  },
