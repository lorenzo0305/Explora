  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/c948ceee-5c16-39af-903a-845461b65711",
      "dc:description": {
        "de": [
          "Das Blasorchester von Boulogne-sur-Mer unter der Leitung von Marc Lajouanique wird sein traditionelles Neujahrskonzert mit dem Ensemble Vibrations am kommenden Sonntag, den 29. Januar um 15:30 Uhr im Espace de la Faïencerie geben. Der Eintritt ist frei."
        ],
        "en": [
          "The Orchestre d'Harmonie de Boulogne-sur-Mer, conducted by Marc Lajouanique, will be giving its traditional New Year's concert with the Vibrations ensemble on Sunday January 29 at 3.30pm at the Espace de la Faïencerie. Free admission."
        ],
        "it": [
          "L'Orchestre d'Harmonie de Boulogne-sur-Mer, diretta da Marc Lajouanique, terrà il suo tradizionale concerto di Capodanno con l'ensemble Vibrations domenica 29 gennaio alle 15.30 all'Espace de la Faïencerie. L'ingresso è gratuito."
        ],
        "fr": [
          "L'orchestre d'Harmonie de Boulogne-sur-Mer, sous la direction de Marc Lajouanique, donnera son traditionnel concert de l'An Neuf avec l'ensemble Vibrations dimanche 29 janvier prochain à 15h30 à l'espace de la Faïencerie. Entrée gratuite."
        ],
        "es": [
          "La Orchestre d'Harmonie de Boulogne-sur-Mer, dirigida por Marc Lajouanique, ofrecerá su tradicional concierto de Año Nuevo con el conjunto Vibrations el domingo 29 de enero a las 15:30 h en el Espace de la Faïencerie. La entrada es gratuita."
        ],
        "nl": [
          "Het Orchestre d'Harmonie de Boulogne-sur-Mer, onder leiding van Marc Lajouanique, geeft zijn traditionele nieuwjaarsconcert met het ensemble Vibrations op zondag 29 januari om 15.30 uur in de Espace de la Faïencerie. De toegang is gratis."
        ]
      },
