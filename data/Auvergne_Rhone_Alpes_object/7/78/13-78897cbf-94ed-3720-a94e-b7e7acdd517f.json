  "rdfs:comment": {
    "de": [
      "Das verrückteste Improvisationsturnier deiner Region kehrt für eine 4. Saison zurück: Wer werden die neuen Champions sein?\r\nFür das GRANDE FINALE 2 Runden, 2 Teams, 1 Sieger! Bühne frei für die Improvisation!"
    ],
    "en": [
      "Your region's craziest improv tournament is back for a 4th season: who will be the new champions?\r\nFor the GRANDE FINALE 2 Rounds, 2 teams, 1 winner! Make way for improvisation!"
    ],
    "it": [
      "Il torneo di improvvisazione più pazzo della vostra regione torna per la quarta stagione: chi saranno i nuovi campioni?\r\nPer la GRANDE FINALE 2 turni, 2 squadre, 1 vincitore! Largo all'improvvisazione!"
    ],
    "fr": [
      "Le Tournoi d'impro le plus fou de ta région revient pour une 4ème saison : qui seront les nouveaux champions ?\r\nPour la GRANDE FINALE 2 Rounds, 2 équipes, 1 vainqueur ! Place à l'improvisation !"
    ],
    "nl": [
      "Het gekste improvisatietoernooi in jouw regio is terug voor een 4e seizoen: wie worden de nieuwe kampioenen?\r\nVoor de GROTE FINALE 2 ronden, 2 teams, 1 winnaar! Maak plaats voor improvisatie!"
    ],
    "es": [
      "El torneo de improvisación más loco de tu región vuelve para una 4ª temporada: ¿quiénes serán los nuevos campeones?\r\nPara la GRAN FINAL: ¡2 rondas, 2 equipos, 1 ganador! ¡Abran paso a la improvisación!"
    ]
  },
  "rdfs:label": {
    "fr": [
