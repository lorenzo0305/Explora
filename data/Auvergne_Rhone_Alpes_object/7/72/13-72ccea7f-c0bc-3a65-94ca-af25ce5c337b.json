  "rdfs:comment": {
    "de": [
      "Die 2005 gegründete Galerie Mirabilla befindet sich inmitten einer Heide-Landschaft und präsentiert zeitgenössische Kunstwerke 14 km von der \"Grotte Chauvet 2-Ardèche\"."
    ],
    "en": [
      "The Galerie Mirabilia, created in 2005 and located in the heart of a garrigue landscape, presents contemporary works of art, 14 km from the Grotte Chauvet 2-Ardèche. Exhibitions, readings, artist meetings, conferences are regularly offered to the public"
    ],
    "it": [
      "Situata in un tipico borgo dell'Ardèche meridionale, nel cuore delle garrigues, la galleria Mirabilia espone arte contemporanea dal 2005. È uno dei luoghi d'arte del percorso artistico \"Partage des eaux\", a 14 km dalla Grotta Chauvet 2."
    ],
    "fr": [
      "Située dans un hameau typique du sud-Ardèche au coeur des garrigues, la galerie Mirabilia présente depuis 2005 des œuvres d’art contemporain. Elle est un des lieux d’art du Parcours artistique du \"Partage des eaux\", à 14 km de la Grotte Chauvet 2."
    ],
    "es": [
      "Situada en una aldea típica del sur de Ardèche, en el corazón de las garrigues, la galería Mirabilia expone arte contemporáneo desde 2005. Es una de las sedes artísticas del itinerario artístico \"Partage des eaux\", a 14 km de la Gruta Chauvet 2."
    ],
    "nl": [
      "De Galerie Mirabilia, geopend in 2015, ze is gelegen in het hartje van de garrigues. Je kan er hedendaagse kunstwerken vinden. Ze is op 14 km afstand van de \"Grotte Chauvet 2-Ardèche\"."
    ]
  },
