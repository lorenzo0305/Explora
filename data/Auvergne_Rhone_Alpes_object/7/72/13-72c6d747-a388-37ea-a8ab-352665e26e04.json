  "rdfs:comment": {
    "de": [
      "Auf 2800 m Höhe gibt es Kaffee und kleine Snacks. Qualitativ hochwertige Pause und unglaubliches Panorama. Die Qualität der Produkte des Hauses Falcoz, selbstgebackenes Brot und Bio-Getränke."
    ],
    "en": [
      "Coffee and snacks at 2800m altitude. Quality break and incredible panorama. Quality products from Maison Falcoz, homemade bread and organic drinks."
    ],
    "it": [
      "Caffè e spuntini a 2800 m di altitudine. Una pausa di qualità con un panorama incredibile. Prodotti di qualità della Maison Falcoz, pane fatto in casa e bevande biologiche."
    ],
    "fr": [
      "A 2800m d'altitude, café et petite restauration. Pause de qualité et panorama incroyable. La qualité des produits de la Maison Falcoz, pain maison, et boissons bio."
    ],
    "nl": [
      "Koffie en snacks op 2800m hoogte. Een kwaliteitspauze met een ongelooflijk panorama. Kwaliteitsproducten van Maison Falcoz, zelfgebakken brood en biologische dranken."
    ],
    "es": [
      "Café y tentempiés a 2800 m de altitud. Una pausa de calidad con un panorama increíble. Productos de calidad de Maison Falcoz, pan casero y bebidas ecológicas."
    ]
  },
