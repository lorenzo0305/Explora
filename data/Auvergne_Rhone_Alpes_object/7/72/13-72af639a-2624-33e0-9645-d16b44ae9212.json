  "rdfs:comment": {
    "de": [
      "Hilary Sharp, Anglo French Hiking Guide. Kommen Sie und entdecken Sie die geheimen, weniger begangenen Wege der atemberaubenden Region Baronnies. Alle Niveaus, ganztägige und halbtägige Führungen. Wanderungen auch für Franzosen, vor allem für diejenigen, die Fortschritte in Englisch machen wollen."
    ],
    "en": [
      "Hilary Sharp, English teacher and montain guide propose hiking in the region. To learn english in a relax way. English particular courses. Also hikes in French."
    ],
    "it": [
      "Hilary Sharp, guida escursionistica anglo-francese. Venite a scoprire i sentieri segreti meno battuti della splendida regione delle Baronnies. Tutti i livelli, guida di un giorno o di mezza giornata. Passeggiate anche per i francesi, soprattutto per coloro che vogliono migliorare il loro inglese."
    ],
    "fr": [
      "Hilary Sharp, Anglo French Hiking Guide. Come and discover the secret less travelled trails of the stunning Baronnies region. All levels, day and half day guiding. Randonnées aussi pour les Français, surtout ceux qui veulent faire des progrès en anglais."
    ],
    "es": [
      "Hilary Sharp, guía anglofrancesa de senderismo. Venga a descubrir los senderos secretos menos transitados de la impresionante región de Baronnies. Todos los niveles, guía de un día y de medio día. Paseos también para franceses, especialmente para los que quieren mejorar su inglés."
    ],
    "nl": [
      "Hilary Sharp, Anglo French Hiking Guide. Kom de minder gekende paden van de prachtige Baronnies ontdekken. Alle niveaus, dag- en halve dagbegeleiding. Ook voor Fransen, vooral zij die hun Engels willen verbeteren."
    ]
  },
  "rdfs:label": {
    "en": [
      "Hiking in the Baronnies with Hilary Sharp"
    ],
    "fr": [
      "Hiking in the Baronnies with Hilary Sharp"
    ],
    "nl": [
      "Wandelen in de Baronnies met Hilary Sharp"
    ]
  },
