  "rdfs:comment": {
    "de": [
      "Direktverkauf von echten Ravioles du Dauphiné IGP / Label Rouge, Knödeln und frischen Nudeln.\r\nEin idealer Ort, um alle Feinschmecker und Liebhaber authentischer Rezepte aus der Region zufrieden zu stellen."
    ],
    "en": [
      "Direct sales of genuine IGP / Label Rouge Dauphiné ravioli, quenelles and fresh pasta.\r\nAn ideal place to satisfy all gourmets and lovers of authentic, local recipes."
    ],
    "it": [
      "Vendita diretta di ravioli, quenelle e pasta fresca autentici IGP / Label Rouge Dauphiné.\r\nÈ il luogo ideale per i buongustai e gli amanti delle ricette autentiche e locali."
    ],
    "fr": [
      "Vente directe de véritables ravioles du Dauphiné IGP / Label Rouge, de quenelles et de pâtes fraîches.\r\nUn lieu idéal pour satisfaire tous les gourmands et les amateurs de recettes authentiques, issues du terroir."
    ],
    "es": [
      "Venta directa de auténticos raviolis IGP / Label Rouge Dauphiné, quenelles y pasta fresca.\r\nEs el lugar ideal para los gourmets y los amantes de las recetas auténticas y locales."
    ],
    "nl": [
      "Directe verkoop van echte IGP / Label Rouge Dauphiné ravioli, quenelles en verse pasta.\r\nDe ideale plek voor fijnproevers en liefhebbers van authentieke, lokale recepten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ravioles à l'ancienne"
    ]
  },
