  "rdfs:comment": {
    "de": [
      "Das Ende des Römischen Reiches, 476.Ende der Antike. Absetzung des letzten westlichen Kaisers. Das Oströmische Reich besteht fort und wird zum Byzantinischen Reich.... Kulturelles und politisches Erbe des Römischen Reiches im Laufe der Zeit."
    ],
    "en": [
      "The end of the Roman Empire, 476 - the end of Antiquity. Deposition of the last Western Emperor. The Eastern Roman Empire survives to become the Byzantine Empire... Cultural and political heritage of the Roman Empire over time."
    ],
    "it": [
      "La fine dell'Impero romano, 476 - la fine dell'Antichità. Deposizione dell'ultimo imperatore d'Occidente. L'Impero Romano d'Oriente sopravvive e diventa l'Impero Bizantino... L'eredità culturale e politica dell'Impero romano nel tempo."
    ],
    "fr": [
      "La fin de l'Empire Romain, 476.Fin de l'Antiquité. Déposition du dernier Empereur d'Occident. L'Empire romain d'Orient perdure et devient l'Empire byzantin... Héritage culturel et politique de l'empire romain au fil du temps."
    ],
    "nl": [
      "Het einde van het Romeinse Rijk, 476 - het einde van de Oudheid. De laatste Westerse keizer wordt afgezet. Het Oost-Romeinse Rijk overleeft en wordt het Byzantijnse Rijk... Het culturele en politieke erfgoed van het Romeinse Rijk door de tijd heen."
    ],
    "es": [
      "Fin del Imperio Romano, 476 - fin de la Antigüedad. Deposición del último emperador de Occidente. El Imperio Romano de Oriente sobrevive y se convierte en el Imperio Bizantino... Herencia cultural y política del Imperio Romano a lo largo del tiempo."
    ]
  },
  "rdfs:label": {
    "fr": [
      "8èmes rencontres d'histoires d'histoire"
    ]
  },
