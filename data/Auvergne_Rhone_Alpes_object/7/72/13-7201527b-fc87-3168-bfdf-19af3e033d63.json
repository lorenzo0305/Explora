  "rdfs:comment": {
    "de": [
      "Workshops, Kurse Praktika – Ausdruck durch bildende Kunst / Malerei, Bildhauerei – Verkauf –  Veranstaltungen für Schulen – Workshop für Erwachsene/Kinder – Veranstaltungen für Behinderte und ältere Menschen – Besichtigung des Ateliers (auf Anfrage)."
    ],
    "en": [
      "Workshops, courses, internships - Visual expression / Painting, Sculpture - Sale - School activities - Workshops for adults/children - Activities for persons with disabilities and for the elderly - Studio visits by appointment - “"
    ],
    "it": [
      "L'Art Oseur offre laboratori, corsi e workshop di espressione plastica, pittura e scultura. Vengono organizzate anche attività per le scuole, i disabili e gli anziani."
    ],
    "fr": [
      "L'Art Oseur vous propose des ateliers, des cours, des stages d'expression plastique, de peinture, de sculpture. Des animations scolaires, des animations pour personnes handicapées et pour personnes âgées sont également organisés."
    ],
    "es": [
      "L'Art Oseur ofrece talleres, cursos y cursillos de expresión plástica, pintura y escultura. También se organizan actividades para escuelas, discapacitados y ancianos."
    ],
    "nl": [
      "L'Art Oseur biedt workshops, cursussen en opleidingen in plastische expressie, schilderen en beeldhouwen. Er worden ook activiteiten voor scholen, gehandicapten en ouderen georganiseerd."
    ]
  },
