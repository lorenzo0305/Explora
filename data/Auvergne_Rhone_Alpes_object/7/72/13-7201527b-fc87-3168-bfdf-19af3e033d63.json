          "additionalInformation": {
            "de": [
              "Ein Samstag pro Monat.\r\n\"Le samedi c'est permis\": Offene Samstagvormittage von 9:30 bis 12:30 Uhr - Erwachsene/Adoleszente (1 Samstag pro Monat).\r\nAuch während der Schulferien geöffnet. Siehe die genauen Daten auf der Website."
            ],
            "en": [
              "One Saturday a month.\r\n\"Le samedi c'est permis\": Saturday mornings open from 9:30am to 12:30pm - Adults-Adolescents (1 Saturday a month).\r\nOpen during school vacations. See website for exact dates."
            ],
            "it": [
              "Un sabato al mese.\r\n\"Le samedi c'est permis\": sabato mattina dalle 9.30 alle 12.30 - Adulti e ragazzi (1 sabato al mese).\r\nAperto durante le vacanze scolastiche. Vedere le date precise sul sito web."
            ],
            "fr": [
              "Un samedi par mois.\r\n\"Le samedi c'est permis\" : les samedis matins d'ouverture de 9h30 à 12h30 - Adultes-Ados (1 samedi par mois).\r\nOuvert pendant les vacances scolaires. Voir les dates précises sur le site internet."
            ],
            "es": [
              "Un sábado al mes.\r\n\"Le samedi c'est permis\": sábados por la mañana de 9.30 a 12.30 - Adultos y adolescentes (1 sábado al mes).\r\nAbierto durante las vacaciones escolares. Consulte las fechas exactas en la página web."
            ],
            "nl": [
              "Een zaterdag per maand.\r\n\"Le samedi c'est permis': zaterdagochtend van 9.30 tot 12.30 uur - Volwassenen en tieners (1 zaterdag per maand).\r\nOpen tijdens schoolvakanties. Zie de precieze data op de website."
            ]
          },
