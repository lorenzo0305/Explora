  "rdfs:comment": {
    "de": [
      "Folgen Sie an 8 interaktiven Stationen der Tour von Ginette, die Sie auf eine Entdeckungsreise durch das Kulturerbe und die Geschichte des Dorfes mitnimmt. Nehmen Sie dazu die Postkarte mit, die Sie im Restaurant l'Oustaou ausfüllen können."
    ],
    "en": [
      "Follow Ginette's 8 interactive stations as she takes you on a tour of the village's heritage and history, using the postcard to complete at the Oustaou restaurant."
    ],
    "it": [
      "Seguite il tour di Ginette attraverso le 8 stazioni interattive, che vi porterà alla scoperta del patrimonio e della storia del villaggio e vi consegnerà una cartolina da completare al ristorante Oustaou."
    ],
    "fr": [
      "Au fil des 8 stations interactives, suivez la tournée de Ginette qui vous entraîne à la découverte du patrimoine et de l'histoire du village en vous munissant de la carte postale à compléter au restaurant  l'Oustaou."
    ],
    "nl": [
      "Volg Ginette op 8 interactieve stations voor een rondleiding door het erfgoed en de geschiedenis van het dorp, waarbij je een ansichtkaart krijgt om in te vullen in het restaurant Oustaou."
    ],
    "es": [
      "Siga el recorrido de Ginette a través de las 8 estaciones interactivas mientras le lleva a descubrir el patrimonio y la historia del pueblo, proporcionándole una postal que podrá completar en el restaurante Oustaou."
    ]
  },
  "rdfs:label": {
