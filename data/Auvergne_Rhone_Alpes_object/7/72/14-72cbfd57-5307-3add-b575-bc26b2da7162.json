  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/9577e6b9-c62f-34a6-b185-bca986a28609",
      "dc:description": {
        "de": [
          "Freitag, 7. Juli 2023\n\nIm Parc des pins, Kiosk Serge Gainsbourg von 11:30 bis 12:30 Uhr.\nOffizielle Einführung des Labels \"Toutourisme\" in Le Touquet-Paris-Plage.\nZusammenkunft von Herrchen und Hund \"Garden Party\"!"
        ],
        "en": [
          "Friday, July 7, 2023\n\nParc des pins, Kiosque Serge Gainsbourg from 11:30 a.m. to 12:30 p.m.\nOfficial launch of the \"Toutourisme\" label at Le Touquet-Paris-Plage.\nGathering of owners and dogs \"Garden Party\"!"
        ],
        "it": [
          "Venerdì 7 luglio 2023\n\nNel Parc des Pins, chiosco Serge Gainsbourg dalle 11.30 alle 12.30.\nLancio ufficiale del marchio \"Toutourisme\" a Le Touquet-Paris-Plage.\nRaduno di proprietari e cani \"Garden Party\"!"
        ],
        "fr": [
          "Vendredi 7 juillet 2023\n\nAu parc des pins, Kiosque Serge Gainsbourg de 11h30 à 12h30.\nLancement officiel du label \"Toutourisme\" au Touquet-Paris-Plage.\nRassemblement maitres et chiens \"Garden Party\" !"
        ],
        "nl": [
          "Vrijdag 7 juli 2023\n\nIn het Parc des Pins, Kiosk Serge Gainsbourg van 11.30 tot 12.30 uur.\nOfficiële lancering van het label \"Toutourisme\" in Le Touquet-Paris-Plage.\nSamenkomst van meesters en honden \"Garden Party\"!"
        ],
        "es": [
          "Viernes 7 de julio de 2023\n\nEn el Parc des Pins, Kiosco Serge Gainsbourg de 11.30 a 12.30 h.\nLanzamiento oficial del sello \"Toutourisme\" en Le Touquet-Paris-Plage.\n¡Reunión de amos y perros \"Garden Party\"!"
        ]
      },
      "@type": [
        "Description"
      ],
