  "rdfs:comment": {
    "de": [
      "Die Destillerie von Saint Gervais ist eine einzigartige und authentische Einrichtung!\r\nIhr Besuch oder die Verkostung einer ihrer Spirituosen gehört von nun an zu den unverzichtbaren Ereignissen während eines Aufenthalts in Saint Gervais!"
    ],
    "en": [
      "The Distillerie de Saint Gervais is a unique and authentic small cabin! \r\nA visit to the distillery or a tasting of one of its spirits is now one of the must-dos during your stay in Saint Gervais!"
    ],
    "it": [
      "La distilleria di Saint Gervais è una struttura unica e autentica! \r\nUna visita alla distilleria o una degustazione di uno dei suoi liquori è ormai uno dei must del vostro soggiorno a Saint Gervais!"
    ],
    "fr": [
      "La distillerie de Saint Gervais est un établissement unique et authentique ! \r\nSa visite ou la dégustation de l'un de ses spiritueux fait désormais partie des immanquables lors d'un séjour à Saint Gervais !"
    ],
    "es": [
      "La destilería de Saint Gervais es un establecimiento único y auténtico\r\nUna visita a la destilería o una degustación de uno de sus licores es ya una de las citas obligadas durante su estancia en Saint Gervais"
    ],
    "nl": [
      "De distilleerderij van Saint Gervais is een uniek en authentiek etablissement!\r\nEen bezoek aan de distilleerderij of een proeverij van een van haar gedistilleerde dranken is nu een van de must-dos tijdens je verblijf in Saint Gervais!"
    ]
  },
