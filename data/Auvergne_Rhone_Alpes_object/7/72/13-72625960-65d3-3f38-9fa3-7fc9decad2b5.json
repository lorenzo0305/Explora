  "rdfs:comment": {
    "de": [
      "Wunderschöne Strecken für Skating oder klassisches Laufen. Von Tannenwäldern bis zu sonnigen Hochebenen, profitieren Sie von einer Auswahl an verschiedenen Strecken, die von Anfängerkursen bis zu sehr technischen Schleifen reichen."
    ],
    "en": [
      "Magnificent cross-country ski areas, through pine forests and sunny plateaus, offering trails groomed for both classic and skate skiing, for beginners to very technical trails for experienced skiers."
    ],
    "it": [
      "Magnifiche tracce per il pattinato o la tecnica classica tra pinete su altipiani soleggiati. Potete usufruire di una scelta di percorsi molto vari, da quello adatto ai principianti fino agli anelli molto tecnici."
    ],
    "fr": [
      "De magnifiques tracés pour le skating ou le classique. De forêts de sapins en plateaux ensoleillés, profitez d'un choix de parcours variés allant de l'initiation aux boucles très techniques."
    ],
    "nl": [
      "Prachtige routes om te skaten of klassiek te skiën. Van dennenbossen tot zonovergoten hoogvlaktes, profiteer van een gevarieerd aanbod aan routes van beginners tot zeer technische lussen."
    ],
    "es": [
      "Magníficas rutas para patinaje o esquí clásico. Desde bosques de pinos hasta mesetas bañadas por el sol, disfrute de una variada selección de rutas, desde principiantes hasta bucles muy técnicos."
    ]
  },
  "rdfs:label": {
    "en": [
      "La Livraz- Megève cross-country ski area"
    ],
    "it": [
      "Area sci di fondo La Livraz - Megève"
    ],
    "fr": [
      "Domaine de ski de fond de La Livraz - Megève"
    ],
    "nl": [
      "Langlaufgebied La Livraz-Megève"
    ]
  },
