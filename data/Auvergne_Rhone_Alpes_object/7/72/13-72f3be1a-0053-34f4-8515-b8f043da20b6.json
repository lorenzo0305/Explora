  "rdfs:comment": {
    "de": [
      "Sie sind auf der Suche nach frischen, lokalen und qualitativ hochwertigen Produkten? Dann lernen Sie uns kennen! Verkauf auf dem Bauernhof, Biogemüse der Saison, frische oder getrocknete Kräuter, Beerenobst und Gemüsekörbe im Abonnement."
    ],
    "en": [
      "If you're looking for fresh, local, quality produce, come and meet us! Farm sales, organic seasonal vegetables, fresh or dried herbs, red fruit and vegetable baskets by subscription."
    ],
    "it": [
      "Se cercate prodotti freschi, locali e di qualità, venite a conoscerci! Vendita in azienda, verdure biologiche di stagione, erbe aromatiche fresche o essiccate, cesti di frutta rossa e verdura in abbonamento."
    ],
    "fr": [
      "Vous êtes à la recherche de produits frais, locaux et de qualité, venez nous rencontrer ! Vente à la ferme, légumes bio de saison, de plantes aromatiques frais ou sec, fruits rouges et paniers de légumes sur abonnement."
    ],
    "es": [
      "Si busca productos frescos, locales y de calidad, ¡venga a conocernos! Venta en la granja, verduras ecológicas de temporada, hierbas frescas o secas, cestas de frutos rojos y verduras por suscripción."
    ],
    "nl": [
      "Als je op zoek bent naar verse, lokale kwaliteitsproducten, kom dan naar ons! Boerderijverkoop, seizoensgebonden biologische groenten, verse of gedroogde kruiden, rode fruit- en groentemanden per abonnement."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le potager des 1000 saveurs"
    ]
  },
