  "rdfs:comment": {
    "de": [
      "Es ist ein origineller, geselliger und familiärer Ort. Man kommt mittags, um eine frische, lokale Küche zu genießen, oder tagsüber in Wohnzimmeratmosphäre."
    ],
    "en": [
      "It's an original, friendly and family-friendly place. You can come for lunch to enjoy fresh, local cuisine, or during the day to relax in the lounge."
    ],
    "it": [
      "È un locale originale, accogliente e familiare. Si può venire a pranzo per gustare una cucina fresca e locale, oppure durante il giorno per rilassarsi nella lounge."
    ],
    "fr": [
      "C'est un lieu original, convivial et familial. On y vient le midi pour déguster une cuisine fraîche et locale ou dans la journée en ambiance salon."
    ],
    "nl": [
      "Het is een originele, gezellige en gezinsvriendelijke plek. Je kunt er komen lunchen en genieten van verse, lokale gerechten, of overdag ontspannen in de lounge."
    ],
    "es": [
      "Es un lugar original, acogedor y familiar. Puedes venir a comer para disfrutar de la cocina fresca y local, o durante el día para relajarte en el salón."
    ]
  },
  "rdfs:label": {
