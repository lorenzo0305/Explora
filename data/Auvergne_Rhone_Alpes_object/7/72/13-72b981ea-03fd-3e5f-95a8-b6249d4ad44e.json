  "rdfs:comment": {
    "de": [
      "Eine geführte Besichtigung ist obligatorisch.\r\nDie Besichtigung ermöglicht eine Reise in die Vergangenheit, von der Gefängnisvergangenheit des Ortes (deutsches Gefängnis während des Zweiten Weltkriegs und 200 Jahre lang französisches Gefängnis) bis zur Gründung des Schlosses durch die Herzöge von Bourbon im 14."
    ],
    "en": [
      "Guided tour compulsory.\r\nThe tour takes you back in time, from the site's prison past (German prison during WWII and French prison for 200 years) to the castle's creation by the Dukes of Bourbon in the 14th century."
    ],
    "it": [
      "Visita guidata obbligatoria.\r\nLa visita vi porterà indietro nel tempo, dal passato carcerario del sito (prigione tedesca durante la Seconda Guerra Mondiale e prigione francese per 200 anni) alla creazione del castello da parte dei duchi di Borbone nel XIV secolo."
    ],
    "fr": [
      "Visite guidée obligatoire.\r\nLa visite permet une remontée dans le temps, du passé carcéral du site (prison allemande durant la Seconde guerre mondiale et prison française pendant 200 ans) à la création du château par les ducs de Bourbon au XIVe siècle."
    ],
    "es": [
      "Visita guiada obligatoria.\r\nLa visita le hará retroceder en el tiempo, desde el pasado carcelario del lugar (prisión alemana durante la Segunda Guerra Mundial y prisión francesa durante 200 años) hasta la creación del castillo por los duques de Borbón en el siglo XIV."
    ],
    "nl": [
      "Rondleiding verplicht.\r\nDe rondleiding neemt je mee terug in de tijd, van het gevangenisverleden van de locatie (Duitse gevangenis tijdens de Tweede Wereldoorlog en Franse gevangenis gedurende 200 jaar) tot de oprichting van het kasteel door de hertogen van Bourbon in de 14e eeuw."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Château des ducs de Bourbon"
    ]
  },
