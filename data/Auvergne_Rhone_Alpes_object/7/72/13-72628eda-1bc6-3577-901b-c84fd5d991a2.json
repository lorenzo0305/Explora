  "rdfs:comment": {
    "de": [
      "Ein Hotel zum Leben und vor allem zum Teilen, ein Hotel, in dem man sich wohlfühlt, 69 Zimmer, darunter 22 Suiten, ein Restaurant und seine Bar, ein Nuxe-Spa, ein Fitnessraum, Seminarräume, ein Kids Club, Aktivitäten mitten in den Bergen."
    ],
    "en": [
      "I.L.Y HOTELS LA ROSIERE, a hotel to live in and to share, a hotel where you feel good, 69 rooms including 22 suites, a restaurant and its bar, a high-end spa, a fitness room, seminar rooms, a Kids Club, activities in the heart of the mountains."
    ],
    "it": [
      "Un hotel da vivere e soprattutto da condividere, un hotel dove sentirsi bene, 69 camere di cui 22 suite, un ristorante e il suo bar, una spa di alto livello, una sala fitness, sale per seminari, un Kids Club, attività in cuore delle montagne."
    ],
    "fr": [
      "Un hôtel à vivre et surtout à partager, un hôtel où l’on se sent bien, 69 chambres dont 22 suites, un restaurant et son bar, un spa Nuxe, une salle de fitness, des salles de séminaires, un Kids Club, des activités en plein cœur des montagnes."
    ],
    "es": [
      "Un hotel para vivir y, sobre todo, para compartir, un hotel donde sentirse bien, con 69 habitaciones, 22 de ellas suites, restaurante y bar, spa Nuxe, sala de fitness, salas para seminarios, Kids Club y actividades en plena montaña."
    ],
    "nl": [
      "Een hotel om te beleven en vooral om te delen, een hotel waar je je goed voelt, met 69 kamers waarvan 22 suites, een restaurant en bar, een Nuxe spa, fitnessruimte, seminarruimten, Kids Club en activiteiten midden in de bergen."
    ]
  },
