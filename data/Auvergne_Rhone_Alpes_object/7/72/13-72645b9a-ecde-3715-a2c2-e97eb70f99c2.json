  "rdfs:comment": {
    "de": [
      "Jami Delivery bietet Ihnen qualitativ hochwertige Gerichte, die Sie direkt von Ihrem Sofa aus genießen können, als Lieferservice oder zum Mitnehmen!\r\nOder vor Ort, lassen Sie sich in der Bar les Tontons drinnen oder auf der Terrasse nieder!"
    ],
    "en": [
      "Jami Delivery offers you quality dishes, for delivery or takeaway, to enjoy directly on your sofa!\r\nOr on site, sit down at the Bar les Tontons inside or on the terrace!"
    ],
    "it": [
      "Jami Delivery ti offre piatti di qualità, a domicilio o da asporto, da gustare direttamente sul tuo divano!\r\nOppure, in loco, sedetevi al Bar les Tontons all'interno o sulla terrazza!"
    ],
    "fr": [
      "Jami Delivery vous propose des plats de qualité, en livraison ou à emporter, à déguster directement dans votre canapé !\r\nOu sur place, installez vous au Bar les Tontons à l'intérieur ou en terrasse !"
    ],
    "es": [
      "Jami Delivery le ofrece platos de calidad, a domicilio o para llevar, para degustar directamente desde su sofá\r\nO siéntese y relájese en el Bar les Tontons, en el interior o en la terraza"
    ],
    "nl": [
      "Jami Delivery biedt je kwaliteitsgerechten, bezorgd of om mee te nemen, om direct vanuit je luie stoel van te genieten!\r\nOf leun achterover en ontspan in Bar les Tontons, binnen of buiten op het terras!"
    ]
  },
