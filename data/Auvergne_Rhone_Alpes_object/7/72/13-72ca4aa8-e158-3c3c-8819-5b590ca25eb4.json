  "rdfs:comment": {
    "de": [
      "Schnellrestaurants vor Ort oder zum Mitnehmen. Kebab aus 100% französischem Kalbfleisch, hausgemachter Spieß und hausgemachte Pommes frites. Wir bieten auch Menüs und Teller an."
    ],
    "en": [
      "Fast food to eat in or take away. 100% French veal kebab, home-made spit and home-made chips. We also offer menus and plates."
    ],
    "it": [
      "Fast food da mangiare o da portare via. Kebab di vitello 100% francese, spiedo fatto in casa e patatine fritte. Offriamo anche menu e piatti."
    ],
    "fr": [
      "Restauration rapide sur place ou à emporter. Kebab 100% veau français, broche faite maison et frites maison. Nous proposons aussi des menus et des assiettes."
    ],
    "nl": [
      "Fast food om te eten of mee te nemen. 100% Franse kalfskebab, huisgemaakt spit en huisgemaakte frietjes. We bieden ook menu's en borden."
    ],
    "es": [
      "Comida rápida para comer en casa o para llevar. Brocheta de ternera 100% francesa, espeto casero y patatas fritas caseras. También ofrecemos menús y platos."
    ]
  },
