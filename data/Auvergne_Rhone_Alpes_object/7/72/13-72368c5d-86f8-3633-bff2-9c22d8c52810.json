  "rdfs:comment": {
    "de": [
      "Die Haute Bresse umfasst das Tal der Reyssouze, einer natürlichen Grenze, und bildet die Vorformen der anderen Bresse-Regionen im Jura und in Burgund.\r\nEine große Schleife, um diese Region zwischen Reyssouze und der nördlichen Bresse zu entdecken."
    ],
    "en": [
      "Haute Bresse covers the valley of the Reyssouze, a natural border, and is the precursor to the other Bresse regions of the Jura and Burgundy.\r\nA great loop to discover this region between the Reyssouze and northern Bresse."
    ],
    "it": [
      "La Haute Bresse copre la valle della Reyssouze, un confine naturale, ed è il precursore delle altre regioni della Bresse del Giura e della Borgogna.\r\nUn ottimo anello per scoprire questa regione tra la Reyssouze e la Bresse settentrionale."
    ],
    "fr": [
      "La Haute Bresse domaine la vallée de la Reyssouze, frontière naturelle, et dessine les prémisses des autres Bresse du Jura et de Bourgogne.\r\nUne grande boucle pour découvrir cette région entre Reyssouze et Bresse du nord."
    ],
    "es": [
      "La Alta Bresse cubre el valle del Reyssouze, una frontera natural, y es la precursora de las otras regiones bresesas del Jura y Borgoña.\r\nUn gran bucle para descubrir esta región entre el Reyssouze y el norte de Bresse."
    ],
    "nl": [
      "Haute Bresse beslaat de vallei van de Reyssouze, een natuurlijke grens, en is de voorloper van de andere Bresse-regio's in de Jura en Bourgondië.\r\nEen geweldige lus om deze regio tussen de Reyssouze en noordelijke Bresse te ontdekken."
    ]
  },
  "rdfs:label": {
    "en": [
      "Circuit Gravel n°15 (red) - Grand tour de la Haute Bresse"
    ],
    "fr": [
      "Circuit Gravel n°15 (rouge) - Grand tour de la Haute Bresse"
    ]
  },
