  "rdfs:comment": {
    "de": [
      "Praktische Brettspiele mit ausgewählten Titeln mit dem Co-libris-Team. Die ideale Gelegenheit, um mit der Familie oder mit Freunden eine schöne Zeit zu verbringen. Ab 6 Jahren."
    ],
    "en": [
      "Play board games on a selection of titles with the Co-libris team. The perfect opportunity to spend some quality time with family and friends. Ages 6 and up."
    ],
    "it": [
      "Giocate a giochi da tavolo su una selezione di titoli con il team di Co-libris. L'occasione perfetta per trascorrere del tempo di qualità con la famiglia e gli amici. A partire dai 6 anni."
    ],
    "fr": [
      "Pratique de jeux de société sur une sélection de titres avec l’équipe Co-libris. L’occasion idéale de passer un bon moment en famille ou entre amis. Dès 6 ans."
    ],
    "nl": [
      "Speel bordspellen op een selectie titels met het Co-libris team. De perfecte gelegenheid om wat quality time door te brengen met familie en vrienden. Vanaf 6 jaar."
    ],
    "es": [
      "Juegue a juegos de mesa sobre una selección de títulos con el equipo de Co-libris. La oportunidad perfecta para pasar un rato agradable con la familia y los amigos. A partir de 6 años."
    ]
  },
