  "rdfs:comment": {
    "de": [
      "Die Wallace Bar ist das erste Pub-Restaurant, das 2005 in Lyon eröffnet wurde! Entdecken Sie eine große Auswahl an Whisky aus aller Welt, über 30 Gins, 16 Fassbiere, darunter viele unserer lokal gebrauten IPAs, 20+ Craft Cans und lagerfähige Flaschen."
    ],
    "en": [
      "The Wallace Bar was the very first pub restaurant to open in Lyon in 2005! It boasts a huge selection of whiskies from Scotland and all over the world, over 30 brands of gin, 16 draught beers including a selection our own locallly brewed IPAs, over 20 canned craft beers, and bottles fit for ageing."
    ],
    "it": [
      "Il Wallace Bar è stato il primo pub ristorante ad aprire a Lione nel 2005! Scoprite un'ampia selezione di whisky provenienti da tutto il mondo, oltre 30 gin, 16 birre alla spina tra cui diverse IPA di produzione locale, oltre 20 lattine artigianali e bottiglie da posare."
    ],
    "fr": [
      "Le Wallace Bar est le premier pub restaurant ouvert à Lyon en 2005 ! Découvrez une vaste sélection de whisky du monde entier, plus de 30 gins, 16 bières pression dont plusieurs de nos IPAs brassées localement, 20+ craft cans, et des bouteilles de garde."
    ],
    "es": [
      "El Wallace Bar fue el primer pub restaurante que abrió sus puertas en Lyon en 2005 Descubra una amplia selección de whiskies de todo el mundo, más de 30 ginebras, 16 cervezas de barril, incluidas varias de nuestras IPA locales, más de 20 latas artesanales y botellas de guarda."
    ],
    "nl": [
      "De Wallace Bar was het eerste caférestaurant dat in 2005 in Lyon werd geopend! Ontdek een brede selectie whisky's van over de hele wereld, meer dan 30 gins, 16 bieren van het vat waaronder verschillende van onze lokaal gebrouwen IPA's, meer dan 20 ambachtelijke blikjes en flessen om neer te leggen."
    ]
  },
