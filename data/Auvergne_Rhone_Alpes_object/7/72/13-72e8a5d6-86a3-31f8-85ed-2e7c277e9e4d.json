  "rdfs:comment": {
    "de": [
      "Mal- und Zeichenkurse für Kinder und Erwachsene, alle Niveaus, jedes Alter, alle Techniken.\r\nEinrahmung nach Maß. Restaurierung und Konservierung von Gemälden. Verkauf von schönen Künsten."
    ],
    "en": [
      "Painting and drawing courses for children and adults, all levels, all ages, all techniques.\r\nCustom framing. Restoration and conservation of paintings. Fine art sales."
    ],
    "it": [
      "Lezioni di pittura e disegno per bambini e adulti, tutti i livelli, tutte le età, tutte le tecniche.\r\nIncorniciatura personalizzata. Restauro e conservazione di dipinti. Vendita di opere d'arte."
    ],
    "fr": [
      "Cours de peinture et dessin pour enfants et adultes, tout niveau, tout âge, toutes techniques.\r\nEncadrement sur mesure. Restauration et conservation d'oeuvres picturales. Vente de beaux-Arts."
    ],
    "nl": [
      "Schilder- en tekenlessen voor kinderen en volwassenen, alle niveaus, alle leeftijden, alle technieken.\r\nInlijsten op maat. Restauratie en conservering van schilderijen. Verkoop van kunst."
    ],
    "es": [
      "Clases de pintura y dibujo para niños y adultos, todos los niveles, todas las edades, todas las técnicas.\r\nEnmarcado a medida. Restauración y conservación de cuadros. Venta de obras de arte."
    ]
  },
