  "rdfs:comment": {
    "de": [
      "Ein Theater mit menschlichem Maßstab im Herzen von Saint-Etienne. 50 Sitzplätze, ein geselliger Raum, der nach jeder Vorstellung geöffnet ist, sowohl am Abend als auch am Nachmittag. Eine Bühne und ein Team, das für Sie da ist!"
    ],
    "en": [
      "A theater on a human scale in the heart of Saint-Etienne. seating for 50, a convivial space open after each performance, evenings and afternoons. A stage and a team available for you!"
    ],
    "it": [
      "Un teatro a misura d'uomo nel cuore di Saint-Etienne. 50 posti a sedere, uno spazio conviviale aperto dopo ogni spettacolo, la sera e il pomeriggio. Un palcoscenico e un'équipe a vostra disposizione!"
    ],
    "fr": [
      "Un théâtre à échelle humaine au cœur de Saint-Etienne. 50 places assises, un espace de convivialité ouvert après chaque représentation, en soirée comme en après-midi. Une scène et une équipe disponible pour vous !"
    ],
    "es": [
      "Un teatro a escala humana en el corazón de Saint-Etienne. asientos para 50 personas, un espacio de convivencia abierto después de cada representación, por la noche y por la tarde. Un escenario y un equipo a su disposición"
    ],
    "nl": [
      "Een theater op mensenmaat in het hart van Saint-Etienne. zitplaatsen voor 50 personen, een gezellige ruimte die open is na elke voorstelling, 's avonds en 's middags. Een podium en een team staan voor je klaar!"
    ]
  },
