      "rdfs:comment": {
        "de": [
          "Holen Sie sich Ihr Bio-Gemüse, ?eier, Ziegenkäse, Geflügel und Brot, um Ihren Gaumen zu verwöhnen!\n\nVerteilung donnerstags von 18:00 bis 18:30 Uhr in der Mehrzweckhalle in der Rue de Coucy."
        ],
        "en": [
          "Come and pick up your organic vegetables, eggs, goat's cheese, poultry and bread to delight your taste buds!\n\nDistribution on Thursdays from 6pm to 6:30pm at the Salle Polyvalente, rue de Coucy."
        ],
        "it": [
          "Venite a prendere le vostre verdure biologiche, le uova, il formaggio di capra, il pollame e il pane per deliziare il vostro palato!\n\nDistribuzione il giovedì dalle 18.00 alle 18.30 presso la Salle Polyvalente in rue de Coucy."
        ],
        "fr": [
          "Venez chercher vos légumes, œufs, fromages de chèvre, volailles et pain biologiques pour régaler vos papilles !\n\nDistribution le jeudi de 18h à 18h30 à la salle polyvalente située rue de Coucy."
        ],
        "es": [
          "Venga a comprar verduras, huevos, queso de cabra, aves de corral y pan ecológicos para deleitar su paladar\n\nDistribución los jueves de 18:00 a 18:30 en la Salle Polyvalente de la rue de Coucy."
        ],
        "nl": [
          "Kom en haal je biologische groenten, eieren, geitenkaas, gevogelte en brood om je smaakpapillen te verwennen!\n\nDistributie op donderdag van 18.00 tot 18.30 uur in de Salle Polyvalente in de rue de Coucy."
        ]
      },
