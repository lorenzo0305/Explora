  "rdfs:comment": {
    "de": [
      "Workshops für Perlenstickerei mit Lunéville-Häkelnadel, mit Band, traditionell, Nadelperlen, nach Vereinbarung. Gruppen max. 6 bis 10 Pers., ab 15 Jahren. Karine Larivière bietet auch Modeaccessoires und gestickten Schmuck an."
    ],
    "en": [
      "The art of embroidery opens up to you! Perle qui roule is the embroidery workshop of Karine Larivière, a Paris-trained haute couture embroiderer. If you want to relax, an embroidery course will bring you the joy of learning to create beauty with threads, pearls and ribbons.\r\nBased in Saint-Pierreville, Karine offers embroidery workshops in a range of techniques, from beginner level upwards. Workshops are organised on request to introduce you to Lunéville crochet (a needle used for haute couture embroidery), ribbon embroidery, traditional stitch friezes and needlework beads.\r\nSale of quality materials, kits and supplies for embroidery.\r\nAlso embroidered jewellery and accessories. Tailor-made embroidery services (weddings, parties, etc.).\r\nIf you would like to take part in an embroidery course or would like more information about creating a custom embroidery project, please send an e-mail to\r\nkarine@perlequiroule.com"
    ],
    "it": [
      "Corsi di perline a Lunéville di uncinetto, nastro, tradizionale, perline ad ago, su appuntamento. Gruppi di massimo 6-10 persone, a partire da 15 anni. Karine Larivière offre anche accessori di moda e gioielli ricamati."
    ],
    "fr": [
      "Stages de broderie perlée au crochet de Lunéville, au ruban, traditionnelle, perles à l'aiguille, sur rendez-vous. Groupes max. 6 à 10 pers., à partir de 15 ans. Karine Larivière propose aussi des accessoires de mode et bijoux brodés."
    ],
    "nl": [
      "Kralencursussen in Lunéville haken, lint, traditioneel, naaldwerk kralen, op afspraak. Groepen max. 6 tot 10 personen, vanaf 15 jaar. Karine Larivière biedt ook modeaccessoires en geborduurde sieraden aan."
    ],
    "es": [
      "Cursos de abalorios en Lunéville ganchillo, cinta, tradicional, abalorios de aguja, con cita previa. Grupos máx. de 6 a 10 personas, a partir de 15 años. Karine Larivière también ofrece accesorios de moda y bisutería bordada."
    ]
  },
