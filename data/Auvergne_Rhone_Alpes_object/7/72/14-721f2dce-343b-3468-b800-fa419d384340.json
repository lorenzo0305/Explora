      "@id": "https://data.datatourisme.fr/bd0a5b7a-8f36-32d3-a90a-412c0f1cb516",
      "dc:description": {
        "de": [
          "Informationen :\n\nSpeisekarte :\nBesuchen Sie die Facebook-Seite, um die Karte zu sehen\n\nÖffnungszeiten: nur abends in Gouy en Artois\nMontag: 17:30-21:00 Uhr\n \n Bestellung:\nBestellung per Telefon unter 06 86 10 53 96 möglich\n\n \n Abholung:\nZum Mitnehmen während der Öffnungszeiten der ambulanten Pizzeria\n\n "
        ],
        "en": [
          "Information :\n\nMenu :\nVisit the Facebook page to see the map\n\nOpening days: evenings only in Gouy en Artois\nMonday: 5:30pm-9pm\n \n Ordering :\nOrder by phone 06 86 10 53 96\n\n \n Pick-up:\nTakeaway during the pizzeria's opening hours\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nMenu :\nVisita la pagina Facebook per vedere la mappa\n\nGiorni di apertura: solo la sera a Gouy en Artois\nLunedì: dalle 17.30 alle 21.00\n \n Ordinazioni :\nPossibilità di ordinare per telefono 06 86 10 53 96\n\n \n Ritiro:\nDa asporto durante gli orari di apertura della pizzeria mobile\n\n "
        ],
        "fr": [
          "Informations :\n\nMenu : \nConsultez la page Facebook afin de connaîte la carte\n\nJours d'ouverture : uniquement le soir à Gouy en Artois\nLe lundi: 17h30-21h\n \n Commande : \nPossibilité de commander par téléphone au 06 86 10 53 96\n\n \n Retrait :\nÀ emporter aux horaires d'ouverture de la pizzeria ambulante\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nMenu :\nBezoek de Facebook-pagina om de kaart te zien\n\nOpeningsdagen: alleen 's avonds in Gouy en Artois\nMaandag: 17.30-9.00\n \n Bestellen :\nMogelijkheid om telefonisch te bestellen op 06 86 10 53 96\n\n \n Afhalen:\nAfhalen tijdens de openingstijden van de mobiele pizzeria\n\n "
        ],
        "es": [
          "Más información :\n\nMenú :\nVisite la página de Facebook para ver el mapa\n\nDías de apertura: sólo por la noche en Gouy en Artois\nLunes: de 17.30 a 21.00 h\n \n Pedidos :\nPosibilidad de hacer pedidos por teléfono 06 86 10 53 96\n\n \n Recogida:\nPara llevar durante el horario de apertura de la pizzería móvil\n\n "
        ]
      },
