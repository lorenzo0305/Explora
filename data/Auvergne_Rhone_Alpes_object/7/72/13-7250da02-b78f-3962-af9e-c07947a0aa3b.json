  "rdfs:comment": {
    "de": [
      "Lust auf einen savoyischen Burger? Testen Sie das Konzept der American Taverne, wo verschiedene Käsesorten in dieses amerikanische Sandwich einziehen: Raclette, Ziegenkäse oder der klassischere Cheddar..."
    ],
    "en": [
      "Craving a Savoyard burger? Give the concept a try at the American Taverne, where different kinds of cheese complete this American sandwich: raclette, goat cheese or the more classical cheddar..."
    ],
    "it": [
      "Avete voglia di un hamburger savoiardo? Provate il concetto di American Taverne, dove vengono utilizzati diversi formaggi per questo panino americano: raclette, formaggio di capra o il più classico cheddar..."
    ],
    "fr": [
      "Envie d'un burger savoyard ? Testez le concept de l'American Taverne, où différents fromages s'invitent dans ce sandwich américain : raclette, fromage de chèvre ou le plus classique cheddar..."
    ],
    "es": [
      "¿Le apetece una hamburguesa saboyana? Pruebe el concepto American Taverne, en el que se utilizan diferentes quesos en este sándwich americano: raclette, queso de cabra o el más clásico cheddar..."
    ],
    "nl": [
      "Zin in een Savoyaardse burger? Probeer het American Taverne concept, waar verschillende kazen worden gebruikt in dit Amerikaanse broodje: raclette, geitenkaas of de meer klassieke cheddar..."
    ]
  },
  "rdfs:label": {
