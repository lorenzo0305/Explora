  "rdfs:comment": {
    "de": [
      "Tauchen Sie bei einer spannenden und lebendigen Führung in die Geschichte und die Geheimnisse der Mühle von Vignal ein. Eine Reise ins Herz des Kulturerbes, die Sie sich nicht entgehen lassen sollten!"
    ],
    "en": [
      "Immerse yourself in the history and secrets of the Moulin de Vignal during an exciting and lively guided tour. A not-to-be-missed journey into the heart of our heritage!"
    ],
    "it": [
      "Immergetevi nella storia e nei segreti del Moulin de Vignal durante un'affascinante e vivace visita guidata. Un viaggio nel cuore del nostro patrimonio da non perdere!"
    ],
    "fr": [
      "Plongez dans l’histoire et les secrets du moulin de Vignal lors d’une visite guidée passionnante et vivante. Un voyage au cœur du patrimoine à ne pas manquer !"
    ],
    "es": [
      "Sumérjase en la historia y los secretos del Moulin de Vignal durante una fascinante y animada visita guiada. ¡Un viaje al corazón de nuestro patrimonio que no debe perderse!"
    ],
    "nl": [
      "Dompel jezelf onder in de geschiedenis en de geheimen van de Moulin de Vignal tijdens een spannende en levendige rondleiding. Een niet te missen reis naar het hart van ons erfgoed!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Journées du patrimoine de pays et des moulins"
    ]
  },
