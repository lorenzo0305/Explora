  "rdfs:comment": {
    "de": [
      "Im Rahmen des Programms Oper im Kino bietet das Ciné Planète eine Vorführung von Tristan und Isolde durch die Metropolitan Opera an. Ausstrahlung in HD Live, unveröffentlichte Produktion."
    ],
    "en": [
      "As part of its Opera au Cinéma program, Ciné Planète offers a screening of Tristan et Isolde by the Metropolitan Opera. Broadcast in HD Live, never-before-seen production."
    ],
    "it": [
      "Nell'ambito del programma Opera at the Movies, Ciné Planète proietta Tristano e Isotta del Metropolitan Opera. Trasmessa in HD Live, questa è una nuova produzione."
    ],
    "fr": [
      "Dans le cadre de la programmation Opéra au Cinéma, le Ciné Planète propose une projection de Tristan et Isolde par le Metropolitan Opera. Diffusion en HD Live, production inédite."
    ],
    "es": [
      "En el marco de su programa Ópera en el cine, Ciné Planète proyecta Tristán e Isolda, de la Metropolitan Opera. Retransmitida en HD Live, se trata de una producción inédita."
    ],
    "nl": [
      "Als onderdeel van het programma Opera at the Movies vertoont Ciné Planète Tristan en Isolde van de Metropolitan Opera. Uitgezonden in HD Live is dit een gloednieuwe productie."
    ]
  },
