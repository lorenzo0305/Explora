  "rdfs:comment": {
    "de": [
      "Spielerische Reitaktivitäten in Chambon-sur-lignon. Ein freundlicher Empfang, um Sie an unserer Leidenschaft teilhaben zu lassen. Eine auf Ihre Bedürfnisse zugeschnittene Pädagogik. Im Herzen der 20 Hektar großen Domäne leben die Pferde so nah wie möglich an ihren natürlichen Bedingungen."
    ],
    "en": [
      "Fun equestrian activities at Le Chambon-sur-lignon. A friendly welcome to share our passion. Teaching adapted to your needs. At the heart of our 20-hectare estate, horses live as close as possible to their natural environment."
    ],
    "it": [
      "Attività equestri divertenti a Le Chambon-sur-lignon. Un'accoglienza amichevole per condividere con voi la nostra passione. Insegnamento adattato alle vostre esigenze. Nel cuore della nostra tenuta di 20 ettari, i cavalli vivono il più vicino possibile al loro ambiente naturale."
    ],
    "fr": [
      "Activités équestres ludiques au Chambon-sur-lignon. Un accueil convivial pour vous faire partager notre passion. Une pédagogie adaptée à vos besoins. Au cœur du domaine de 20 hectares, les chevaux vivent au plus près de leurs conditions naturelles."
    ],
    "nl": [
      "Leuke ruiteractiviteiten in Le Chambon-sur-Lignon. Een vriendelijk onthaal om onze passie met jou te delen. Les aangepast aan jouw behoeften. In het hart van ons domein van 20 hectare leven de paarden zo dicht mogelijk bij hun natuurlijke omgeving."
    ],
    "es": [
      "Actividades ecuestres divertidas en Le Chambon-sur-lignon. Una acogida cordial para compartir nuestra pasión con usted. Enseñanza adaptada a sus necesidades. En el corazón de nuestra finca de 20 hectáreas, los caballos viven lo más cerca posible de su entorno natural."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Pray d'Aunay Equitation"
    ]
  },
