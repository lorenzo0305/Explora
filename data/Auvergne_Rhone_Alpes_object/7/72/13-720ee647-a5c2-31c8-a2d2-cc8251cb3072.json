  "rdfs:comment": {
    "de": [
      "Unser Weinberg in Chalus ist ein kleiner Familienbetrieb von 6,5 ha. Er ist mit den Rebsorten Gamay, Pinot und Chardonnay bepflanzt und liegt auf einem mit Vulkanasche vermischten Lehm-Kalk-Boden. Handwerklich hergestellte Liköre aus Lembron Eisenkraut, Minze, Holunder...."
    ],
    "en": [
      "A small 6.5 ha family estate, our vineyard in Chalus is planted with Gamay, Pinot and Chardonnay grapes on clay-limestone soil mixed with volcanic ash. Liqueurs artisanales du Lembron verbena, mint, elderberry...."
    ],
    "it": [
      "Piccola azienda familiare di 6,5 ettari, il nostro vigneto a Chalus è piantato con uve Gamay, Pinot e Chardonnay su un terreno argilloso-calcareo misto a cenere vulcanica. Liquori artigianali del Lembron verbena, menta, sambuco...."
    ],
    "fr": [
      "Petite exploitation familiale de 6,5 ha, notre vignoble situé à Chalus est planté en cépages Gamay, Pinot et Chardonnay sur un sol argilo-calcaire mêlé de cendres volcaniques. Liqueurs artisanales du Lembron verveine, menthe, sureau...."
    ],
    "es": [
      "Pequeña empresa familiar de 6,5 hectáreas, nuestro viñedo de Chalus está plantado con uvas Gamay, Pinot y Chardonnay en un suelo arcillo-calcáreo mezclado con ceniza volcánica. Licores artesanales du Lembron verbena, menta, saúco...."
    ],
    "nl": [
      "Onze wijngaard in Chalus, een klein familiebedrijf van 6,5 hectare, is beplant met gamay-, pinot- en chardonnaydruiven op klei-kalksteengrond gemengd met vulkanische as. Likeuren artisanales du Lembron verbena, munt, vlierbes...."
    ]
  },
