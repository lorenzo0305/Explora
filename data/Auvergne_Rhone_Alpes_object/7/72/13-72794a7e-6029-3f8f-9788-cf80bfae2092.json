  "rdfs:comment": {
    "de": [
      "Die 13 Hektar große Wasserfläche bietet einen Wasserskilift (kostengünstige und umweltfreundliche Antriebsart) mit Wakepark (verschiedene Sprungschanzen und Slidebars)."
    ],
    "en": [
      "The artificial lake of 13ha offers a nautical button lift (with an economic and ecologic pulling) with a wakepark (diverse springboards and slide’s bars)."
    ],
    "it": [
      "Il lago di 13 ettari offre un impianto di risalita per lo sci nautico (un mezzo di trasporto economico ed ecologico) con un wake park (vari salti e barre di scivolo)."
    ],
    "fr": [
      "Le plan d'eau de 13 hectares propose un téléski nautique (mode de traction économique et écologique) avec wakepark (divers tremplins et barres de slide)."
    ],
    "nl": [
      "Het meer van 13 hectare biedt een waterskilift (een economisch en ecologisch vervoermiddel) met een wakepark (diverse sprongen en glijbanen)."
    ],
    "es": [
      "El lago de 13 hectáreas ofrece un remonte de esquí acuático (un medio de transporte económico y ecológico) con un parque de estela (varios saltos y barras de deslizamiento)."
    ]
  },
