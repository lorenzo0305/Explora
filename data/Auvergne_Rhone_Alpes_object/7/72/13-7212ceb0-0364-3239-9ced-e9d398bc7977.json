  "rdfs:comment": {
    "de": [
      "Anspruchsvolle Aufstiegsstrecke mit Tourenski bis zum Kreuz von etwa 3,5 km Länge und 630 m Höhenunterschied.\r\n⚠ Neuer Ausgangspunkt: Bachat-Brücke: Schnallen Sie die Skier am Ecrin-Sessellift an und gehen Sie dann auf die andere Seite der Piste."
    ],
    "en": [
      "Challenging ski touring ascent to La Croix, approx. 3.5 km and 630 m ascent.\r\n⚠ New starting point: Pont de Bachat: put on your skis at the Ecrin chairlift, then join the other side of the piste."
    ],
    "it": [
      "Difficile salita scialpinistica a La Croix di circa 3,5 km e 630 metri di dislivello.\r\n? Nuovo punto di partenza: Pont de Bachat: si mettono gli sci alla seggiovia Ecrin, poi si va dall'altra parte della pista."
    ],
    "fr": [
      "Parcours de montée difficile en ski de randonnée jusqu’à la Croix d'environ 3.5 km et de 630 mètres de dénivelé.\r\n⚠ Nouveau point de départ : pont de Bachat : chaussez les skis au niveau du télésiège de l'Ecrin, puis rejoignez l'autre côté de la piste."
    ],
    "nl": [
      "Moeilijke skitocht naar La Croix van ongeveer 3,5 km en 630 meter klimmen.\r\n? Nieuw vertrekpunt: Pont de Bachat: trek je ski's aan bij de stoeltjeslift Ecrin en ga vervolgens naar de andere kant van de piste."
    ],
    "es": [
      "Difícil ascenso en esquí de travesía hasta La Croix de unos 3,5 km y 630 metros de desnivel.\r\n? Nuevo punto de partida: Pont de Bachat: calzarse los esquís en el telesilla Ecrin y dirigirse al otro lado de la pista."
    ]
  },
  "rdfs:label": {
    "de": [
      "Aufstiegsroute für Skitouren: Neuer Start 24-25: Pont de Bachat-Bouloud - Croix de Chamrousse - nicht gesichert"
    ],
    "en": [
      "New start 24-25: Pont de Bachat-Bouloud - Croix de Chamrousse - not secured"
    ],
    "fr": [
      "Parcours de montée en ski de randonnée :  Nouveau départ 24-25 : Pont de Bachat-Bouloud - Croix de Chamrousse - non sécurisé"
    ]
  },
