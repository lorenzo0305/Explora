  "rdfs:comment": {
    "de": [
      "Der Stand 65 Jahre zu Ihren Diensten, unser junges und innovatives Team empfängt Sie unter der Woche jeden Mittag in seinen drei klimatisierten Räumen und auf seinen zwei Terrassen."
    ],
    "en": [
      "The 65 year old stand at your service, our young and innovative team will welcome you every lunchtime during the week in its three air-conditioned rooms and its two terraces."
    ],
    "it": [
      "Lo stand di 65 anni è al vostro servizio, il nostro team giovane e innovativo vi accoglierà a pranzo nei giorni feriali nelle sue tre sale climatizzate e nelle due terrazze."
    ],
    "fr": [
      "Le stand 65 ans à votre service, notre équipe jeune et innovante vous accueillera tous les midis en semaine dans ses trois salles climatisées et ses deux terrasses."
    ],
    "es": [
      "El stand de 65 años a su servicio, nuestro equipo joven e innovador le acogerá cada mediodía entre semana en sus tres salas climatizadas y dos terrazas."
    ],
    "nl": [
      "De 65 jaar oude stand tot uw dienst, ons jong en innovatief team ontvangt u elke middag op weekdagen in zijn drie zalen met airconditioning en twee terrassen."
    ]
  },
