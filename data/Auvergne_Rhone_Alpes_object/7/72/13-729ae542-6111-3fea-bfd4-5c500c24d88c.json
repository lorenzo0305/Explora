  "rdfs:comment": {
    "de": [
      "Unser Hotel-Restaurant befindet sich an der Kreuzung der Nord/Süd Hauptstraßen. Es ist sowohl ein idealer Ort für Geschäftstreffen oder einen Kurzurlaub.\r\n "
    ],
    "en": [
      "Our hotel- restaurant is located at the crossroads of major Northern/Southern routes. It is both an ideal place for business meetings or a leisure break."
    ],
    "it": [
      "Il nostro albergo e ristorante si trova al crocevia di importanti rotte. E 'sia un luogo ideale per incontri di lavoro o soggiorno di piacere."
    ],
    "fr": [
      "Notre hôtel-restaurant est situé au carrefour des grands axes Nord/Sud. Il est à la fois le lieu idéal pour les rencontres professionnelles ou pour un séjour de loisirs."
    ],
    "nl": [
      "Ons hotel-restaurant ligt op het kruispunt van de grote Noord/Zuidroutes. Het is de ideale plek voor zakelijke bijeenkomsten of een vrijetijdsverblijf."
    ],
    "es": [
      "Nuestro hotel-restaurante está situado en la intersección de los principales ejes norte/sur. Un lugar perfecto para organizar una reunión de negocios o disfrutar de una estancia de ocio.\r\n "
    ]
  },
