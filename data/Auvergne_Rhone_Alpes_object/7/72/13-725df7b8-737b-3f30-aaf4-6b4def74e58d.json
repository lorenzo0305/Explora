          "additionalInformation": {
            "de": [
              "Geöffnet am Montag von 14h bis 20h. Mittwochs von 10:00 bis 12:00 Uhr und 14:00 bis 20:00 Uhr. Donnerstags von 14 bis 21 Uhr. Freitags von 14 Uhr bis 22 Uhr. Samstags von 10 Uhr bis 22 Uhr.  Sonntag von 10 bis 19 Uhr. Dienstag außerhalb der Schulferien geschlossen."
            ],
            "en": [
              "Open Mondays from 2pm to 8pm. Wednesdays from 10am to 12pm then 2pm to 8pm. Thursday, 2pm to 9pm. Friday, 2pm to 10pm. Saturday from 10am to 10pm.  Sunday from 10am to 7pm. Closed Tuesdays outside school vacations."
            ],
            "it": [
              "Aperto il lunedì dalle 14.00 alle 20.00. Mercoledì dalle 10.00 alle 12.00 e dalle 14.00 alle 20.00. Giovedì dalle 14.00 alle 21.00. Venerdì dalle 14.00 alle 22.00. Sabato dalle 10.00 alle 22.00.  Domenica dalle 10.00 alle 19.00. Chiuso il martedì al di fuori delle vacanze scolastiche."
            ],
            "fr": [
              "Ouverture le lundi de 14h à 20h. Le mercredi de 10h à 12h puis 14h à 20h. Le jeudi de 14h à 21h. Le vendredi de 14h à 22h. Le samedi de 10h à 22h.  Le dimanche de 10h à 19h. Fermé le mardi hors vacances scolaires."
            ],
            "nl": [
              "Geopend op maandag van 14.00 tot 20.00 uur. Woensdag van 10.00 tot 12.00 uur en van 14.00 tot 20.00 uur. Donderdag van 14.00 tot 21.00 uur. Vrijdag van 14.00 tot 22.00 uur. Zaterdag van 10 tot 22 uur.  Zondag van 10.00 tot 19.00 uur. Buiten de schoolvakanties op dinsdag gesloten."
            ],
            "es": [
              "Abierto los lunes de 14.00 a 20.00 h. Miércoles de 10.00 a 12.00 y de 14.00 a 20.00 horas. Jueves de 14.00 a 21.00 h. Viernes de 14.00 a 22.00 h. Sábados de 10.00 a 22.00 h.  Domingos de 10.00 a 19.00 h. Cerrado los martes no festivos."
            ]
