  "rdfs:comment": {
    "de": [
      "Innovative Freizeitbeschäftigung, die auf einer immersiven Technologie basiert, die auf jeden Spieler zugeschnitten ist. Das Ziel ist es, Ihnen ein magisches und geselliges Erlebnis in einer Welt zu bieten, in der alles möglich ist. Escape Game, Multiplayer TIR-Spiel, kooperative oder kompetitive Spiele."
    ],
    "en": [
      "Innovative leisure based on immersive technology adapted to each player. The objective is to offer you a magical and friendly experience in a world where everything is possible. Escape Game, multiplayer TIR game, cooperative or competitive games."
    ],
    "it": [
      "Un intrattenimento innovativo basato su una tecnologia immersiva adattata a ciascun giocatore. L'obiettivo è offrire un'esperienza magica e amichevole in un mondo in cui tutto è possibile. Gioco di fuga, gioco TIR multiplayer, giochi cooperativi o competitivi."
    ],
    "fr": [
      "Loisir innovant basé sur une technologie immersive adaptée à chaque joueur. L'objectif est de vous offrir une expérience magique et conviviale dans un monde où tout est possible. Escape Game, jeu de TIR multijoueur, jeux coopératifs ou compétitifs."
    ],
    "es": [
      "Un entretenimiento innovador basado en una tecnología inmersiva adaptada a cada jugador. El objetivo es ofrecerle una experiencia mágica y amigable en un mundo donde todo es posible. Juego de escape, juego TIR multijugador, juegos cooperativos o competitivos."
    ],
    "nl": [
      "Innovatief entertainment op basis van meeslepende technologie, aangepast aan elke speler. Het doel is u een magische en vriendelijke ervaring te bieden in een wereld waar alles mogelijk is. Ontsnappingsspel, TIR-spel voor meerdere spelers, coöperatief of competitief spel."
    ]
  },
  "rdfs:label": {
