  "rdfs:comment": {
    "de": [
      "Tincave (1300 m) liegt 6 km von Bozel entfernt und zählt 50 Einwohner. Dieser Weiler beherbergt die Kapelle Saint Bernard de Menthon sowie die Überreste der Minen aus dem letzten Jahrhundert."
    ],
    "en": [
      "Located at 6 km from Bozel, Tincave (1300 m height) has got nearly 50 resident. This hamlet has got its Chapel Saint Bernard of Menthon and also some relics of mines from the last century."
    ],
    "it": [
      "Situata a 6 km da Bozel, Tincave (1300 m) conta 50 abitanti. Questa frazione ospita la cappella di San Bernardo di Mentone e i resti di miniere risalenti al secolo scorso."
    ],
    "fr": [
      "Situé à 6 km de Bozel, Tincave (1300 m) compte 50 habitants. Ce hameau abrite la chapelle Saint Bernard de Menthon ainsi que les vestiges des mines datant du siècle dernier."
    ],
    "nl": [
      "Tincave (1300 m) ligt op 6 km van Bozel en telt 50 inwoners. Dit gehucht herbergt de kapel Saint Bernard de Menthon en de overblijfselen van mijnen uit de vorige eeuw."
    ],
    "es": [
      "Situada a 6 km de Bozel, Tincave (1300 m) tiene una población de 50 habitantes. Esta aldea alberga la capilla de San Bernardo de Menthon y restos de minas del siglo pasado."
    ]
  },
