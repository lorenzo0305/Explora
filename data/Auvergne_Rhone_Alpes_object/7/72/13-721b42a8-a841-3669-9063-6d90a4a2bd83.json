  "rdfs:comment": {
    "de": [
      "Ludivine und Thierry befinden sich im Winter gegenüber den Skipisten und im Sommer in der Nähe der Wanderwege. Sie empfangen Sie das ganze Jahr über in einer herzlichen und familiären Atmosphäre."
    ],
    "en": [
      "Facing the slopes in winter and close to the hiking trails in summer, Christiane, Ludivine and Thierry welcome you all year round in a warm, family atmosphere."
    ],
    "it": [
      "Affacciati sulle piste in inverno e vicini ai sentieri escursionistici in estate, Ludivine e Thierry vi accolgono tutto l'anno in un'atmosfera calda e familiare."
    ],
    "fr": [
      "Situé face aux pistes l'hiver et proche des sentiers de randonnées l'été, Ludivine et Thierry vous accueillent toute l'année dans une ambiance chaleureuse et familiale."
    ],
    "nl": [
      "Met uitzicht op de pistes in de winter en dicht bij de wandelpaden in de zomer, verwelkomen Christiane, Ludivine en Thierry je het hele jaar door in een warme, familiale sfeer."
    ],
    "es": [
      "Frente a las pistas en invierno y cerca de las rutas de senderismo en verano, Ludivine y Thierry le dan la bienvenida todo el año en un ambiente cálido y familiar."
    ]
  },
