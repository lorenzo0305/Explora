  "rdfs:comment": {
    "de": [
      "Noé Galifet : Bergbegleiter - Camille Bonnet: Yogalehrerin bieten Ihnen einen sanften und sensiblen Ansatz des Wanderns in Verbindung mit Yoga, um den Menschen wieder in seine Umwelt zu stellen."
    ],
    "en": [
      "Noé Galifet : Mountain leader - Camille Bonnet: Yoga teacher - offer a gentle, sensitive approach to hiking, combined with yoga to place the human being in his or her environment."
    ],
    "it": [
      "Noé Galifet : Camille Bonnet: insegnante di yoga - vi propongono un approccio dolce e sensibile all'escursionismo, combinato con lo yoga per reinserire le persone nel loro ambiente."
    ],
    "fr": [
      "Noé Galifet : Accompagnateur en montagne - Camille Bonnet : Professeure de yoga vous proposent une approche douce et sensible de la randonnée allié au yoga pour replacer l'être humain dans son environnement."
    ],
    "es": [
      "Noé Galifet : Líder de montaña - Camille Bonnet: Profesora de yoga - le ofrecen un enfoque suave y sensible del senderismo, combinado con el yoga para devolver a las personas a su entorno."
    ],
    "nl": [
      "Noé Galifet : Bergleider - Camille Bonnet: Yogalerares - bieden je een zachte, gevoelige benadering van wandelen, gecombineerd met yoga om mensen terug te brengen in hun omgeving."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Randonner en conscience - Au rythme de la montagne"
    ]
  },
