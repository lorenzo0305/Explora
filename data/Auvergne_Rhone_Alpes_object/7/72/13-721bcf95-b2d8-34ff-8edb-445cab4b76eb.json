  "rdfs:comment": {
    "de": [
      "Clinic'ART Beauté bietet eine neue Generation von Expertenbehandlungen für Gesicht, Körper und Haare an, die von der ästhetischen Medizin inspiriert sind, wirksam und individuell sind.\r\nWissenschaft und Wohlwollen im Dienste Ihrer Schönheit."
    ],
    "en": [
      "Clinic'ART Beauté offers a new generation of expert face, body and hair treatments inspired by aesthetic medicine, effective and personalized.\r\nScience and kindness at the service of your beauty."
    ],
    "it": [
      "Clinic'ART Beauté offre una nuova generazione di trattamenti esperti per viso, corpo e capelli ispirati alla medicina estetica, efficaci e personalizzati.\r\nScienza e gentilezza al servizio della vostra bellezza."
    ],
    "fr": [
      "Clinic'ART Beauté propose une nouvelle génération de soins experts visage ,corps et cheveux inspirés de la médecine esthétique, efficaces et personnalisés.\r\nLa science et la bienveillance au service de votre beauté."
    ],
    "es": [
      "Clinic'ART Beauté ofrece una nueva generación de tratamientos expertos faciales, corporales y capilares inspirados en la medicina estética, eficaces y personalizados.\r\nCiencia y amabilidad al servicio de su belleza."
    ],
    "nl": [
      "Clinic'ART Beauté biedt een nieuwe generatie deskundige behandelingen voor gezicht, lichaam en haar, geïnspireerd door de esthetische geneeskunde, die doeltreffend en gepersonaliseerd zijn.\r\nWetenschap en vriendelijkheid ten dienste van uw schoonheid."
    ]
  },
