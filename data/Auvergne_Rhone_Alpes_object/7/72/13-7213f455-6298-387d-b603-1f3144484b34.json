  "rdfs:comment": {
    "de": [
      "Dieses casa dei-Priorat, wurde als Kulturdenkmal eingestuft. Es steht auf einer Basaltbergkuppe im Herzen der Ebene des Forez und bietet einen 360° -Rundblick über die Berge des Forez bis zu den Bergen bei Lyon."
    ],
    "en": [
      "This ancient Casadean priory (attached to the Abbey of La Chaise- Dieu), classified as a Historic Monument, is set on a basaltic peak in the heart of Forez, and offers a panoramically view on the Forez and Lyonnais mountains."
    ],
    "it": [
      "Questo priorato casadese (congregazione di La Chaise-Dieu), classificato come monumento storico, sorge su un picco di basalto nel cuore della piana del Forez. La vetta offre una vista a 360° sulle montagne del Forez e sulle montagne del Lyonnais."
    ],
    "fr": [
      "Ce prieuré casadéen (congrégation de la Chaise-Dieu), classé Monument Historique, s'élève sur un pic basaltique au cœur de la plaine du Forez. Le pic offre une vue à 360° sur les monts du Forez et les monts du Lyonnais."
    ],
    "es": [
      "Este priorato casadeano (congregación de la Chaise-Dieu), clasificado como monumento histórico, se eleva sobre una cima de basalto en el corazón de la llanura de Forez. La cima ofrece una vista de 360° de los montes de Forez y de las montañas del Lyonnais."
    ],
    "nl": [
      "Deze Casadeense priorij (congregatie van La Chaise-Dieu), geklasseerd als historisch monument, verheft zich op een basalttop in het hart van de Forez-vlakte. De top biedt een uitzicht van 360° op de bergen van de Forez en de Lyonnais."
    ]
  },
