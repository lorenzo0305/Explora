  "rdfs:comment": {
    "de": [
      "In Costaros, zwischen dem Lac du Bouchet und den Schluchten der Loire, auf dem Marktplatz, begrüßen Sie Didier und sein Team in seinem Lokal, um Ihnen ein einzigartiges Menü und seine berühmten Pizzas anzubieten."
    ],
    "en": [
      "In Costaros, between Lac du Bouchet and the Loire gorges, on the Place du Marché, Didier and his team welcome you to his establishment, offering a unique menu and his famous pizzas."
    ],
    "it": [
      "A Costaros, tra il Lac du Bouchet e le Gorges de la Loire, sulla Place du Marché, Didier e il suo team vi danno il benvenuto nel loro locale, dove propongono un menu unico e le loro famose pizze."
    ],
    "fr": [
      "À Costaros, entre le Lac du Bouchet et les gorges de la Loire, sur la place du Marché, Didier et son équipes, vous accueillent dans son établissement, pour vous proposer un menu unique et ses fameuses pizzas."
    ],
    "nl": [
      "In Costaros, tussen het Lac du Bouchet en de Gorges de la Loire, op de Place du Marché, heten Didier en zijn team je welkom in hun zaak, waar ze een uniek menu en hun beroemde pizza's aanbieden."
    ],
    "es": [
      "En Costaros, entre el Lago del Bouchet y las Gargantas del Loira, en la Place du Marché, Didier y su equipo le dan la bienvenida a su establecimiento, donde le ofrecen una carta única y sus famosas pizzas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Chez Borel - Bar du Marché | Costaros"
    ]
  },
