  "rdfs:comment": {
    "de": [
      "Eine handwerkliche Brennerei, die auf die Herstellung von Spirituosen spezialisiert ist. Entdecken Sie unser vielfältiges Angebot an Aperitifs und Digestifs: Gin, Pastis, Wermut, Obstbrände, Carthagena, Fleurs du Malt und unsere unverwechselbare Signatur, die Grüne Ziege..."
    ],
    "en": [
      "Artisan distillery specialising in the production of exceptional spirits. Discover our varied range including Gin, Pastis, and our distinctive signature, la Chèvre verte..."
    ],
    "it": [
      "Distilleria artigianale specializzata nella produzione di liquori. Scoprite la nostra vasta gamma di aperitivi e digestivi: gin, pastis, vermouth, acquaviti di frutta, carthagène, Fleurs du Malt e la nostra firma distintiva, Chèvre Verte..."
    ],
    "fr": [
      "Distillerie artisanale spécialisée dans la production de spiritueux. Découvrez notre gamme variée d’apéritifs et de digestifs : gin, pastis, vermouth, eaux-de-vie de fruits, carthagène, Fleurs du Malt et notre signature distinctive, la Chèvre Verte..."
    ],
    "es": [
      "Destilería artesanal especializada en la producción de bebidas espirituosas. Descubra nuestra amplia gama de aperitivos y digestivos: ginebra, pastis, vermut, aguardientes de frutas, carthagène, Fleurs du Malt y nuestra firma distintiva, Chèvre Verte..."
    ],
    "nl": [
      "Ambachtelijke distilleerderij gespecialiseerd in de productie van sterke dranken. Ontdek ons uitgebreide assortiment aperitieven en digestieven: gin, pastis, vermouth, vruchtenbrandewijn, carthagène, Fleurs du Malt en onze kenmerkende signatuur, Chèvre Verte..."
    ]
  },
  "rdfs:label": {
    "en": [
      "LA FRAP - Fabrique Rurale d’Alcool à Partager"
    ],
    "fr": [
      "LA FRAP - Fabrique Rurale d’Alcool à Partager"
    ]
  },
