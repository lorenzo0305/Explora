      "dc:description": {
        "de": [
          "Spezialist für Straßenfahrräder seit 1983. Pinarello, De Rosa, Wilier, Colnago, Enve & Preuss. Haltungsstudie, Montage, Maßanpassungen & Werkstatt."
        ],
        "en": [
          "Road bike specialist since 1983. Pinarello, De Rosa, Wilier, Colnago, Enve & Preuss. Postural study, assembly, custom adjustments & Workshop."
        ],
        "it": [
          "Specialista della bicicletta da strada dal 1983. Pinarello, De Rosa, Wilier, Colnago, Enve e Preuss. Studio posturale, montaggio, regolazioni personalizzate e officina."
        ],
        "fr": [
          "Spécialiste du Velo de Route depuis 1983. Pinarello, De Rosa, Wilier, Colnago, Enve & Preuss. Étude posturale, montage, réglages sur-mesure & Atelier."
        ],
        "nl": [
          "Racefietsspecialist sinds 1983. Pinarello, De Rosa, Wilier, Colnago, Enve & Preuss. Houdingsstudie, montage, aanpassingen op maat & werkplaats."
        ],
        "es": [
          "Especialista en bicicletas de carretera desde 1983. Pinarello, De Rosa, Wilier, Colnago, Enve & Preuss. Estudio postural, montaje, ajustes a medida & Taller."
