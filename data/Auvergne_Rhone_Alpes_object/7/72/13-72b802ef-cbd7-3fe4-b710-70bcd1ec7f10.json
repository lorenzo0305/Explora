  "rdfs:comment": {
    "de": [
      "Chahübohu weil \"Tohu-Bohu\"\r\nTohu-Bohu weil \"DÉSORDRE, confusion de choses mêlées\" (Unordnung, Verwirrung von vermischten Dingen)\r\nKünstlerisches Durcheinander mit Aufführungen und Konzerten, drinnen und draußen, zum Tanzen, zum Singen, zum Lachen und zum Nachdenken, zum Öffnen und Entdecken"
    ],
    "en": [
      "Chahübohu because \"Tohu-Bohu\r\nTohu-Bohu because \"DISORDER, confusion of mixed things\r\nArtistic disorder with shows and concerts, indoors and outdoors, to dance, to sing, to laugh and reflect, to open up and discover"
    ],
    "it": [
      "Chahübohu perché \"Tohu-Bohu\"\r\nTohu-Bohu perché \"DISORDINE, confusione di cose mescolate\"\r\nDisordine artistico con spettacoli e concerti, al chiuso e all'aperto, per ballare e cantare, ridere e riflettere, aprirsi e scoprire.."
    ],
    "fr": [
      "Chahübohu parce que « Tohu-Bohu »\r\nTohu-Bohu parce que « DÉSORDRE, confusion de choses mêlées »\r\nDésordre artistique avec des spectacles et des concerts, en salle et en extérieur, pour danser, pour chanter, pour rire et réfléchir, pour s’ouvrir et découvrir"
    ],
    "es": [
      "Chahübohu porque \"Tohu-Bohu\r\nTohu-Bohu porque \"DESORDEN, confusión de cosas mezcladas\"\r\nDesorden artístico con espectáculos y conciertos, en interiores y al aire libre, para bailar y cantar, reír y reflexionar, abrirse y descubrir.."
    ],
    "nl": [
      "Chahübohu omdat \"Tohu-Bohu\r\nTohu-Bohu omdat \"DISORDER, verwarring van gemengde dingen\"\r\nArtistieke wanorde met voorstellingen en concerten, binnen en buiten, om te dansen en te zingen, te lachen en na te denken, te openen en te ontdekken.."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Festival Chahübohu"
    ]
  },
