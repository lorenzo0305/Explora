  "rdfs:comment": {
    "de": [
      "Hochgebirgsführer, Bergbegleiter, Canyoninglehrer.\r\nAlle Ihre Bergaktivitäten im Winter wie im Sommer: Bergsteigen, Skitouren, Skifahren abseits der Pisten, Klettern, Via-Ferrata, Canyoning..."
    ],
    "en": [
      "Creator of mountain experiences: mountaineering, climbing, skiing, trekking, trail, nature and environment hikes, autonomous nature stays."
    ],
    "it": [
      "Guida di alta montagna, accompagnatore di montagna, istruttore di canyoning.\r\nTutte le attività montane invernali ed estive: alpinismo, sci alpinismo, sci fuori pista, arrampicata, via-ferrata, canyoning..."
    ],
    "fr": [
      "Guide de haute montagne, accompagnateur en montagne, moniteur de canyoning. \r\nToutes vos activités montagne d'hiver comme d'été : alpinisme, ski  de randonnée, ski hors-pistes, escalade, via-ferrata, canyoning..."
    ],
    "es": [
      "Guía de alta montaña, monitor de montaña, monitor de barranquismo.\r\nTodas las actividades de montaña de invierno y verano: alpinismo, esquí de travesía, esquí fuera de pista, escalada, vías ferratas, barranquismo..."
    ],
    "nl": [
      "Berggids, bergleider, canyoning-instructeur.\r\nAl uw winter- en zomeractiviteiten in de bergen: bergbeklimmen, skitochten, off-piste skiën, klimmen, via-ferrata, canyoning..."
    ]
  },
