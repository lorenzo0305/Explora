  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/393b5854-ae81-33b3-8174-9a61c916ed5b",
      "dc:description": {
        "de": [
          "Von John Gade\n\nDer Pianist John Gade, der durch den Wettbewerb Les Étoiles du piano bekannt wurde, bietet ein intensives und romantisches Klavierspiel. Hier bietet er uns einen Streifzug durch die Geschichte des Klaviers von Chopin bis Ravel, zwischen leidenschaftlichen Impulsen und Modernität."
        ],
        "en": [
          "By John Gade\n\nRevealed by the Étoiles du piano competition, pianist John Gade offers intense and romantic piano playing. Here he offers us a journey through the history of the piano from Chopin to Ravel, between passionate impulses and modernity."
        ],
        "it": [
          "Di John Gade\n\nRivelato dal concorso Étoiles du piano, il pianista John Gade propone un pianismo intenso e romantico. Qui ci accompagna in un viaggio attraverso la storia del pianoforte, da Chopin a Ravel, un viaggio tra passione e modernità."
        ],
        "fr": [
          "Par John Gade\n\nRévélé par le concours Les Étoiles du piano, le pianiste John Gade offre un jeu de piano intense et romantique. Il nous propose ici une traversée de l’histoire du piano de Chopin à Ravel, entre élans passionnés et modernité."
        ],
        "es": [
          "Por John Gade\n\nRevelado por el concurso Étoiles du piano, el pianista John Gade ofrece un pianismo intenso y romántico. Aquí nos lleva en un viaje a través de la historia del piano, de Chopin a Ravel, un viaje entre la pasión y la modernidad."
        ],
        "nl": [
          "Door John Gade\n\nOntdekt door het Étoiles du piano concours, biedt pianist John Gade intens, romantisch pianospel. Hier neemt hij ons mee op een reis door de geschiedenis van de piano, van Chopin tot Ravel, een reis tussen passie en moderniteit."
        ]
      },
      "@type": [
        "Description"
