  "rdfs:comment": {
    "de": [
      "Nach einem anstrengenden Arbeitstag können Sie mit Freunden und Kollegen die Magie eines Live-Konzerts erleben und große Klassiker oder überraschende Werke in einem kurzen Format entdecken, das ideal für eine erste Begegnung mit dem Auditorium ist."
    ],
    "en": [
      "After a day at work, come and experience the magic of a live concert with friends and colleagues, and discover great classics or more surprising works in a short format, ideal for a first encounter with the Auditorium."
    ],
    "it": [
      "Dopo una dura giornata di lavoro, venite con amici e colleghi per vivere la magia di un concerto dal vivo e scoprire grandi classici o opere più sorprendenti in un formato breve, ideale per un primo incontro con l'Auditorium."
    ],
    "fr": [
      "Après une journée de travail, venez entre amis et collègues vivre la magie du concert live et découvrir de grands classiques ou des œuvres plus surprenantes dans un format court, idéal pour une première rencontre avec l’Auditorium."
    ],
    "nl": [
      "Kom na een dag hard werken samen met vrienden en collega's om de magie van een live concert te ervaren en ontdek grote klassiekers of meer verrassende werken in een kort formaat, ideaal voor een eerste kennismaking met het Auditorium."
    ],
    "es": [
      "Después de un duro día de trabajo, venga con amigos y compañeros a vivir la magia de un concierto en directo y descubra grandes clásicos u obras más sorprendentes en un formato breve, ideal para un primer encuentro con el Auditorio."
    ]
  },
  "rdfs:label": {
