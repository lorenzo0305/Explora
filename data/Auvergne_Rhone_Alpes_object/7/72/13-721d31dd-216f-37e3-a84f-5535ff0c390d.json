  "rdfs:comment": {
    "de": [
      "Die Oberge du Barrage bietet Ihnen eine traditionelle Küche in einer einzigartigen ländlichen und ländlichen Umgebung mit Panoramablick auf den See von Villerest. Froschmenü das ganze Jahr über à la carte."
    ],
    "en": [
      "Traditional cuisine in a bucolic countryside setting, unique with its panoramic view over the villerest Lake.  Once a month l’Oberge offers a Parisian cabaret evening"
    ],
    "it": [
      "L'Oberge du Barrage offre una cucina tradizionale in un ambiente di campagna unico con vista panoramica sul lago di Villerest. Menù a base di rane alla carta tutto l'anno."
    ],
    "fr": [
      "L'Oberge du Barrage vous propose une cuisine traditionnelle dans un cadre champêtre et campagnard unique avec sa vue panoramique sur le lac de Villerest. Menu grenouilles à la carte toute l'année."
    ],
    "es": [
      "L'Oberge du Barrage ofrece cocina tradicional en un entorno campestre único con vistas panorámicas al lago Villerest. Menú de rana a la carta todo el año."
    ],
    "nl": [
      "L'Oberge du Barrage biedt een traditionele keuken in een unieke landelijke omgeving met panoramisch uitzicht over het meer van Villerest. Kikkermenu à la carte het hele jaar door."
    ]
  },
