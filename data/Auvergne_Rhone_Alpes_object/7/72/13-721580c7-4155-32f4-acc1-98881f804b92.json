  "rdfs:comment": {
    "de": [
      "Winzer mit Leidenschaft für biologischen Weinbau, Garten in Permakultur, Besichtigung der Weinberge und Verkostung auf Anfrage.\r\nVor Ort Gruppenunterkunft für 12/14 Personen, Weinprobe Direktverkauf auf dem Weingut."
    ],
    "en": [
      "Winegrower with a passion for organic viticulture, permaculture garden, vineyard tour and tasting on request.\r\nGroup gite for 12/14 people, tasting and sale direct from the estate."
    ],
    "it": [
      "Viticoltore con la passione per la viticoltura biologica, giardino in permacultura, tour del vigneto e degustazione su richiesta.\r\nGite di gruppo in loco per 12/14 persone, degustazione e vendita direttamente dalla tenuta."
    ],
    "fr": [
      "Vigneron passionné par la viticulture biologique, jardin en permaculture, visite des vignes et dégustation sur demande.\r\nSur place Gite de groupe 12/14 personnes, Dégustation vente directe à la propriété."
    ],
    "nl": [
      "Wijnbouwer met een passie voor biologische wijnbouw, permacultuurtuin, rondleiding door de wijngaard en proeverij op aanvraag.\r\nGroepsgite op het domein voor 12/14 personen, proeverij en verkoop rechtstreeks van het domein."
    ],
    "es": [
      "Viticultor apasionado por la viticultura biológica, jardín de permacultura, visita del viñedo y degustación previa petición.\r\nCasa rural para grupos de 12/14 personas, degustación y venta directa en la finca."
    ]
