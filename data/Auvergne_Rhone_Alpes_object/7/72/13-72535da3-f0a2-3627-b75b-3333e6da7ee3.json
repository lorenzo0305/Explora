  "rdfs:comment": {
    "de": [
      "Restaurant mit savoyischen Spezialitäten und frischem Fisch aus unseren Seen. Die Weine wählen wir bei unseren befreundeten Winzern der Region aus. Frühstück und Brunch an allen Wochentagen."
    ],
    "en": [
      "Restaurant serving specialities from Savoy and fresh fish from the lakes nearby. Enjoy our wines directly selected from local wine-growers. Breakfast and brunch 7 days a week."
    ],
    "it": [
      "Ristorante con specialità della Savoia e pesce fresco dei nostri laghi. Vini scelti dai nostri amici viticoltori. Colazioni e brunch 7 giorni su 7."
    ],
    "fr": [
      "Restaurant de spécialités savoyardes et cuisine traditionnelle. Vins choisis chez nos amis viticulteurs. Petits déjeuners et brunchs 7 jours sur 7."
    ],
    "es": [
      "Restaurante de especialidades saboyanas y cocina tradicional. Vinos seleccionados por nuestros amigos viticultores. Desayunos y almuerzos 7 días a la semana."
    ],
    "nl": [
      "Restaurant met savoyardse specialiteiten, en verse vis uit onze meren. Wijnen geselecteerd bij onze wijnbouwvrienden. Dagelijks ontbijt en brunch."
    ]
  },
