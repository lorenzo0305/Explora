          "additionalInformation": {
            "de": [
              "Wir bieten unsere Produkte auf dem Markt in Saint-Jeoire (Freitagmorgen von 8:15 bis 12:30 Uhr), auf dem Markt in Sevraz (Samstagmorgen von 8:30 bis 12:30 Uhr), auf dem Markt in Bogève (am zweiten Freitag des Monats von 16 bis 20 Uhr) und auch auf einigen punktuellen Festen an."
            ],
            "en": [
              "We sell our products at the Saint-Jeoire market (8:15am to 12:30pm on Friday mornings), the Sevraz market (8:30am to 12:30pm on Saturday mornings), the Bogève market (second Friday of the month, 4pm to 8pm) and also at a few special events."
            ],
            "it": [
              "Vendiamo i nostri prodotti al mercato di Saint-Jeoire (dalle 8.15 alle 12.30 il venerdì mattina), al mercato di Sevraz (dalle 8.30 alle 12.30 il sabato mattina), al mercato di Bogève (il secondo venerdì del mese dalle 16.00 alle 20.00) e in occasione di alcuni eventi speciali."
            ],
            "fr": [
              "Nous proposons nos produits sur le marché de Saint-Jeoire (de 8h15 à 12h30 le vendredi matin), le marché de Sevraz  (de 8h30 à 12h30 le samedi matin), sur le marché de Bogève (le deuxième vendredi du mois de 16h à 20h) et également sur quelques fêtes ponctuelles."
            ],
            "nl": [
              "We verkopen onze producten op de markt van Saint-Jeoire (op vrijdagochtend van 8.15 tot 12.30 uur), de markt van Sevraz (op zaterdagochtend van 8.30 tot 12.30 uur), de markt van Bogève (op de tweede vrijdag van de maand van 16.00 tot 20.00 uur) en op een aantal speciale evenementen."
            ],
            "es": [
              "Vendemos nuestros productos en el mercado de Saint-Jeoire (de 8.15 a 12.30 los viernes por la mañana), en el mercado de Sevraz (de 8.30 a 12.30 los sábados por la mañana), en el mercado de Bogève (el segundo viernes de cada mes de 16.00 a 20.00) y en numerosos eventos especiales."
            ]
          },
