  "rdfs:comment": {
    "de": [
      "Anne und Denis halten 80 Ziegen, deren Milch vor Ort zu einer breiten Palette von Käsesorten verarbeitet wird, die Sie vom 20. Februar bis 20. Dezember täglich außer dienstags und sonntags von 16:30 bis 18:30 Uhr im Hofverkaufsladen finden können."
    ],
    "en": [
      "Anne and Denis raise 80 goats, whose milk is processed on site into a wide range of cheeses that you can find at the farm shop every day from 4.30pm to 6.30pm, except Tuesdays and Sundays, from 20 February to 20 December."
    ],
    "it": [
      "Anne e Denis allevano 80 capre, il cui latte viene trasformato in loco in una vasta gamma di formaggi che si possono acquistare presso il negozio della fattoria tutti i giorni dalle 16.30 alle 18.30, tranne il martedì e la domenica, dal 20 febbraio al 20 dicembre."
    ],
    "fr": [
      "Anne et Denis élèvent 80 chèvres dont le lait est transformé sur place en une large gamme de fromages que vous pourrez retrouver sur le point de vente à la ferme tous les jours de 16h30 à 18h30, sauf le mardi et le dimanche, du 20 février au 20 décembre."
    ],
    "es": [
      "Anne y Denis crían 80 cabras, cuya leche se transforma in situ en una amplia gama de quesos que podrá comprar en la tienda de la granja todos los días de 16.30 a 18.30 horas, excepto los martes y domingos, del 20 de febrero al 20 de diciembre."
    ],
    "nl": [
      "Anne en Denis houden 80 geiten, waarvan de melk ter plekke wordt verwerkt tot een breed scala aan kazen die je van 20 februari tot 20 december elke dag van 16.30 tot 18.30 uur in de boerderijwinkel kunt kopen, behalve op dinsdag en zondag."
    ]
  },
  "rdfs:label": {
    "en": [
      "Goat farm of Trappaz"
    ],
    "fr": [
      "Chèvrerie de la Trappaz"
    ]
  },
