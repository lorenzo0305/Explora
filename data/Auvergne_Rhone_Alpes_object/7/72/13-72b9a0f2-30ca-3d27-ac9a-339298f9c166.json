  "rdfs:comment": {
    "de": [
      "Die Tour du Mont-Blanc Cyclo ist eine Referenz unter den Ultra-Radsportveranstaltungen. Von Les Saisies aus müssen die Fahrer an einem einzigen Tag 330 km und 8.300 positive Höhenmeter bewältigen"
    ],
    "en": [
      "The Tour du Mont-Blanc Cyclo is a benchmark among ultra-cycling events. Starting from Les Saisies, riders will have to cover 330 km and 8,300 m of elevation gain in a single day."
    ],
    "it": [
      "Il Tour du Mont-Blanc Cyclo è un punto di riferimento tra gli eventi di ultra-ciclismo. Partendo da Les Saisies, i corridori percorreranno 330 km e 8.300 metri di dislivello in un solo giorno"
    ],
    "fr": [
      "Le Tour du Mont-Blanc Cyclo est une référence parmi les épreuves d’ultra-cyclisme. Au départ des Saisies, les coureurs devront parcourir 330 km et 8 300 m de dénivelé positif en une seule journée"
    ],
    "es": [
      "El Tour du Mont-Blanc Cyclo es una referencia entre las pruebas de ultraciclismo. Con salida en Les Saisies, los ciclistas recorrerán 330 km y 8.300 m de desnivel en un solo día"
    ],
    "nl": [
      "De Tour du Mont-Blanc Cyclo is een referentie onder de ultrawielerevenementen. Vanaf Les Saisies leggen de renners 330 km en 8.300 m klimmen af op één dag"
    ]
  },
