  "rdfs:comment": {
    "de": [
      "Ferme auberge in einem Buron inmitten der Sommerweiden auf 1300 m Höhe auf dem Plateau von Trizac.\r\nEin authentischer Buron, der mit Geschmack und Respekt für die ursprüngliche Architektur zur Geltung gebracht wurde."
    ],
    "en": [
      "Farm inn in a \"buron\" (traditional mountain dairy), situated in the pastures at an altitude of 1300m. Regional cooking: delicatessen, Salers meat, bourriols, pounti, truffade with the majority of ingredients coming from the farm and other local producers."
    ],
    "it": [
      "Agriturismo in un Buron situato in mezzo agli alpeggi a 1300 m di altitudine, sull'altopiano del Trizac.\r\nUn autentico burrone, restaurato con gusto secondo l'architettura originale."
    ],
    "fr": [
      "Ferme auberge dans un Buron situé au milieu des estives à 1300m d'altitude, sur le plateau de Trizac.\r\nUn authentique buron mis en valeur avec goût et respect de l’architecture originelle."
    ],
    "es": [
      "Granja posada en un Burón situado en medio de los pastos de montaña a 1300m de altitud, en la meseta de Trizac.\r\nUn auténtico burón, restaurado con gusto en su arquitectura original."
    ],
    "nl": [
      "Boerderijherberg in een Buron gelegen te midden van de bergweiden op 1300m hoogte, op het Trizac plateau.\r\nEen authentieke buron gerestaureerd met smaak en respect voor de oorspronkelijke architectuur."
    ]
  },
  "rdfs:label": {
    "en": [
      "Buron du Chaussedier"
    ],
    "fr": [
      "Le Buron du Chaussedier"
    ]
  },
