  "rdfs:comment": {
    "de": [
      "Am Ortseingang von Aix-les-Bains können Sie sich entspannen und diesen im Sommer bewachten Badebereich nutzen. Es besteht die Möglichkeit, Tretboote, Katamarane und Kanus zu mieten.\r\nÜberwachung: vom 28/06 bis 31/08 von 13 bis 19 Uhr"
    ],
    "en": [
      "At the entrance to Aix-les-Bains, relax and enjoy this supervised swimming area in summer. Pedalos, catamarans and canoes available for hire.\r\nSupervision: 28/06 to 31/08, 1 pm to 7 pm"
    ],
    "it": [
      "All'ingresso di Aix-les-Bains, rilassatevi e godetevi questo spazio balneare, sorvegliato in estate. Pedalò, catamarani e canoe a noleggio.\r\nSorveglianza: dal 28/06 al 31/08 dalle 13:00 alle 19:00."
    ],
    "fr": [
      "A l'entrée d'Aix-les-Bains, détendez-vous et profitez de cet espace de baignade surveillée en été. Possibilité de louer des pédalos, catamarans, canoës.\r\nSurveillance : du 28/06 au 31/08 de 13h à 19 h"
    ],
    "nl": [
      "Bij de ingang van Aix-les-Bains kunt u ontspannen en genieten van dit zwemgebied, dat in de zomer onder toezicht staat. Er zijn waterfietsen, catamarans en kano's te huur.\r\nToezicht: van 28/06 tot 31/08 van 13u tot 19u"
    ],
    "es": [
      "A la entrada de Aix-les-Bains, relájese y disfrute de esta zona de baño vigilada en verano. Alquiler de patines, catamaranes y canoas.\r\nVigilancia: del 28/06 al 31/08 de 13:00 a 19:00 h"
    ]
  },
  "rdfs:label": {
    "en": [
      "Rowing Beach"
    ],
    "it": [
      "Spiaggia del Rowing"
    ],
    "fr": [
      "Plage du Rowing"
    ]
  },
