  "rdfs:comment": {
    "de": [
      "7. Segensfeier.  Ausstellung alter Autos, Motorräder, Mopeds, Solex, Fahrräder, Traktoren...  Offen für alle Liebhaber und Fans von 2 cvs und Derivaten. Reservierung von Mahlzeiten vor dem 23. März 2026."
    ],
    "en": [
      "7th Benediction.  Exhibition of old cars, motorcycles, mopeds, solexes, bicycles, tractors...  Open to all 2CV and related enthusiasts and supporters. Meal reservations by March 23, 2026."
    ],
    "it": [
      "7a Benedizione.  Esposizione di auto d'epoca, moto, ciclomotori, solex, biciclette, trattori...  Aperto a tutti gli appassionati e sostenitori di 2CV e affini. Prenotazione dei pasti entro il 23 marzo 2026."
    ],
    "fr": [
      "7ème Bénédiction.  Exposition vieilles voitures, motos, mobylette, solex, vélos, tracteurs...  Ouvert à tous les amoureux et supporters de 2 cv et dérivés. Réservation repas avant le 23 mars 2026."
    ],
    "nl": [
      "7e Blessing.  Tentoonstelling van oude auto's, motoren, bromfietsen, solexen, fietsen, tractoren...  Open voor alle 2CV en aanverwante liefhebbers en supporters. Reserveren voor maaltijden vóór 23 maart 2026."
    ],
    "es": [
      "7ª Bendición.  Exposición de coches antiguos, motos, ciclomotores, solex, bicicletas, tractores...  Abierto a todos los aficionados y simpatizantes del 2CV y afines. Reserva de comidas antes del 23 de marzo de 2026."
    ]
  },
