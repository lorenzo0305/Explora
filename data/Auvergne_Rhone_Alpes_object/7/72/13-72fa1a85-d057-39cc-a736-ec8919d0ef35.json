  "rdfs:comment": {
    "de": [
      "Gilles und sein Team erwarten Sie, um eine frische und leckere Pause mit einer atemberaubenden Aussicht im Golfrestaurant zu genießen.\r\n\r\nWährend der Saison, in der der Golfplatz geöffnet ist, ist das Restaurant jeden Mittag geöffnet."
    ],
    "en": [
      "Gilles and his team look forward to welcoming you to the golf restaurant for a fresh, gourmet break with a breathtaking view.\r\n\r\nOpen every lunchtime during the golf season."
    ],
    "it": [
      "Gilles e il suo team vi aspettano per darvi il benvenuto al ristorante del golf per una pausa fresca e gourmet con una vista mozzafiato.\r\n\r\nAperto ogni ora di pranzo durante la stagione golfistica."
    ],
    "fr": [
      "Gilles et son équipe vous attendent  pour profiter d'une pause fraicheur et gourmande avec une vue époustouflante au restaurant du golf.\r\n\r\nOuvert tous les midis pendant la saison d'ouverture du golf."
    ],
    "es": [
      "Gilles y su equipo le esperan en el restaurante del golf para ofrecerle una pausa gastronómica y fresca con unas vistas impresionantes.\r\n\r\nAbierto todos los mediodías durante la temporada de golf."
    ],
    "nl": [
      "Gilles en zijn team heten je van harte welkom in het golfrestaurant voor een frisse, gastronomische pauze met een adembenemend uitzicht.\r\n\r\nTijdens het golfseizoen elke middag geopend."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Tee Resto"
    ]
  },
