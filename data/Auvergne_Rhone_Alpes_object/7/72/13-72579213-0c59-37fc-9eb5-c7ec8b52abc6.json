  "rdfs:comment": {
    "de": [
      "Französische Komödie von Romane Gueret (1h52) folgt zwei jungen Frauen, Shaï und Djeneba, die als Betreuerinnen in einem Feriencamp in der Drôme tätig sind. Sommerlicher Film über Kindheit und Freundschaft. Die Vorstellung wird vom Cinéma itinérant du Livradois-Forez angeboten ."
    ],
    "en": [
      "French comedy by Romane Gueret (1:52) follows two young women, Shaï and Djeneba, who work at a summer camp in the Drôme region. A summer film about childhood and friendship. Presented by Cinéma itinérant du Livradois-Forez."
    ],
    "it": [
      "Commedia francese di Romane Gueret (1:52) segue due giovani donne, Shaï e Djeneba, che lavorano in un campo vacanze nella Drôme. Un film estivo sull'infanzia e sull'amicizia. Offerto dal Cinéma itinérant du Livradois-Forez."
    ],
    "fr": [
      "Comédie française de Romane Gueret (1h52) suit deux jeunes femmes, Shaï et Djeneba, animatrices en colonie de vacances dans la Drôme. Film estival sur l'enfance et l'amitié. Séance proposée par le Cinéma itinérant du Livradois-Forez ."
    ],
    "nl": [
      "Franse komedie van Romane Gueret (1:52) volgt twee jonge vrouwen, Shaï en Djeneba, die werken op een vakantiekamp in de Drôme. Een zomerfilm over kindertijd en vriendschap. Voorgestelde vertoning door de Cinéma itinérant du Livradois-Forez."
    ],
    "es": [
      "Comedia francesa de Romane Gueret (1:52) que sigue a dos jóvenes, Shaï y Djeneba, que trabajan en un campamento de vacaciones en la Drôme. Una película de verano sobre la infancia y la amistad. Ofrecida por el Cinéma itinérant du Livradois-Forez."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Séance de cinéma \"Ma Frère\""
    ]
  },
