  "rdfs:comment": {
    "de": [
      "Kapelle, die im 15. Jahrhundert erbaut wurde. Im Inneren befinden sich ein Gemälde, das Maria Magdalena darstellt, und eine Gipsstatuette der Heiligen Magdalena."
    ],
    "en": [
      "this church was built in the 15th century.\r\nInside there is a painting with Marie Madeleine on it and a statue of Sainte Madeleine"
    ],
    "it": [
      "Cappella costruita nel XV secolo. All'interno si trovano un dipinto di Maria Maddalena e una statuetta in gesso di Santa Maddalena."
    ],
    "fr": [
      "Chapelle construite au XVème siècle. On trouve à l'intérieur un tableau représentant Marie-Madeleine et une statuette en plâtre de Sainte-Madeleine."
    ],
    "nl": [
      "Kapel gebouwd in de 15e eeuw. Binnen hangt een schilderij van Maria Magdalena en een gipsen beeldje van de heilige Magdalena."
    ],
    "es": [
      "Capilla construida en el siglo XV. En su interior hay un cuadro de María Magdalena y una estatuilla de yeso de Santa Magdalena."
    ]
  },
  "rdfs:label": {
