  "rdfs:comment": {
    "de": [
      "Authentische, französische Küche in diesem kleinen Gasthaus mit typischer Dauphin-Atmosphäre. Dieser Ort eignet sich hervorragend für einen Zwischenstopp mit dem Auto oder für einen einfachen Moment mit Kollegen.\r\nReli-Punkt/Paketdienst (Mondial Relay)."
    ],
    "en": [
      "Authentic and French cuisine in this small hostel with a dolphin-like atmosphere. It is a perfect place for a stopover by car, or a simple moment between colleagues.\r\nPoint relai/colis (Mondial Relay affiliate)."
    ],
    "it": [
      "Autentica cucina francese in questa piccola locanda dall'atmosfera del Delfinato. È un luogo perfetto per una sosta in auto o per un semplice momento con i colleghi.\r\nPunto di raccolta/pacchetto (affiliato a Mondial Relay)."
    ],
    "fr": [
      "Cuisine authentique et française, dans cette petite auberge à l'ambiance type dauphinoise. C'est un lieu qui convient parfaitement pour une halte en voiture, ou un moment simple entre collègues.\r\nPoint relai/colis (affilié Mondial Relay)."
    ],
    "nl": [
      "Authentieke Franse keuken in deze kleine herberg met een Dauphinoise sfeer. Het is een perfecte plek voor een tussenstop in de auto, of een eenvoudig moment met collega's.\r\nRelais/pakketpunt (aangesloten bij Mondial Relay)."
    ],
    "es": [
      "Auténtica cocina francesa en esta pequeña posada de ambiente dauphinoise. Es un lugar perfecto para una parada en el coche, o un simple momento con los colegas.\r\nPunto de relevo/paquete (afiliado a Mondial Relay)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Petite Auberge"
    ]
  },
