  "rdfs:comment": {
    "de": [
      "Nehmen Sie sich Zeit für eine Mittagspause oder ein Essen mit der Familie im Dekor eines Speisewagens.\r\nRestaurant Typ \"Bistro\"; hausgemachte Küche mit saisonalen und lokalen Produkten."
    ],
    "en": [
      "Take time out for lunch or a family meal in a restaurant car setting.\r\nA bistro-style restaurant serving home-cooked, seasonal and local produce."
    ],
    "it": [
      "Prendetevi il tempo per una pausa pranzo o per un pasto in famiglia in un ambiente di auto ristorante.\r\nRistorante in stile bistrot; cucina casalinga, con prodotti stagionali e locali."
    ],
    "fr": [
      "Prenez le temps d’une pause déjeuner ou d’un repas en famille dans un décor de wagon-restaurant.\r\nRestaurant type \"bistro\" ; cuisine faite maison, avec des produits de saison et locaux."
    ],
    "es": [
      "Tómese el tiempo necesario para almorzar o comer en familia en un coche restaurante.\r\nRestaurante tipo bistró; comida casera, con productos de temporada y locales."
    ],
    "nl": [
      "Neem de tijd voor een lunchpauze of een gezinsmaaltijd in de auto van een restaurant.\r\nBistro-restaurant; huisgemaakte gerechten, met seizoensgebonden en lokale producten."
    ]
  },
