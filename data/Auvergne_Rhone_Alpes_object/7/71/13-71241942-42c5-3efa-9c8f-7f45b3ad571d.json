  "rdfs:comment": {
    "de": [
      "Berger Story ist eine musikalische Hommage an Michel Berger, die vom Ch?ur Spectacul'Art getragen wird. Mehrere hundert Chorsänger, Live-Musiker und die stimmliche Inszenierung von Vincent Fuchs zelebrieren die großen Lieder des Komponisten"
    ],
    "en": [
      "Berger Story is a musical tribute to Michel Berger by the Ch?ur Spectacul'Art. Several hundred choristers, live musicians and Vincent Fuchs' vocal staging celebrate the composer's greatest hits"
    ],
    "it": [
      "Berger Story è un tributo musicale a Michel Berger eseguito dalla Ch?ur Spectacul'Art. Diverse centinaia di coristi, musicisti dal vivo e la direzione vocale di Vincent Fuchs celebrano i più grandi successi del compositore"
    ],
    "fr": [
      "Berger Story propose un hommage musical à Michel Berger porté par le Chœur Spectacul'Art. Plusieurs centaines de choristes, musiciens live et mise en scène vocale de Vincent Fuchs célèbrent les grands titres du compositeur"
    ],
    "nl": [
      "Berger Story is een muzikaal eerbetoon aan Michel Berger uitgevoerd door de Ch?ur Spectacul'Art. Enkele honderden achtergrondzangers, live muzikanten en de vocale leiding van Vincent Fuchs vieren de grootste hits van de componist"
    ],
    "es": [
      "Berger Story es un homenaje musical a Michel Berger interpretado por el Ch?ur Spectacul'Art. Varios centenares de coristas, músicos en directo y la dirección vocal de Vincent Fuchs celebran los grandes éxitos del compositor"
    ]
  },
  "rdfs:label": {
