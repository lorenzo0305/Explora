  "rdfs:comment": {
    "de": [
      "Dieses Restaurant liegt ideal in der Altstadt von Lyon und wird alle Liebhaber des Viertels Saint-Jean begeistern. Hier finden Sie eine traditionelle, neu interpretierte Küche und gute, typisch lyonesische Gerichte. Der Chefkoch bietet jede Woche wechselnde Vorschläge an."
    ],
    "en": [
      "Located in Old Lyon, this restaurant is guaranteed to delight all lovers of the Saint-Jean district. Enjoy revisited traditional cuisine and typically Lyonnais dishes. The Chef offers different suggestions every week."
    ],
    "it": [
      "Situato in posizione ideale nella Vieux-Lyon, questo ristorante sedurrà gli amanti del quartiere Saint-Jean. Troverete una cucina tradizionale rivisitata e ottimi piccoli piatti tipicamente lionesi. Lo chef propone ogni settimana proposte diverse."
    ],
    "fr": [
      "Idéalement situé dans le Vieux-Lyon, ce restaurant séduira les amoureux du quartier Saint-Jean. Retrouvez une cuisine traditionnelle revisitée et de bons petits plats typiquement lyonnais. Le Chef propose des suggestions différentes toutes les semaines."
    ],
    "es": [
      "Idealmente situado en el Vieux-Lyon, este restaurante seducirá a los amantes del barrio de Saint-Jean. Encontrará una cocina tradicional revisada y buenos pequeños platos típicamente lioneses. El chef propone diferentes sugerencias cada semana."
    ],
    "nl": [
      "Dit restaurant, ideaal gelegen in het Vieux-Lyon, zal de liefhebbers van de wijk Saint-Jean verleiden. U vindt er een traditionele keuken die in ere wordt hersteld en goede kleine gerechten die typisch Lyonnais zijn. De chef stelt elke week andere suggesties voor."
    ]
  },
