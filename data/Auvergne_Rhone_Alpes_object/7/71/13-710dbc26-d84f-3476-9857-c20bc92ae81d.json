  "rdfs:comment": {
    "de": [
      "Am Fuße des Puy Griou haben sich Anaïs und Sylvain entschieden, den Familienbetrieb weiterzuführen! Sie halten 40 Milchkühe der Rasse Montbéliarde. Ihre Milchproduktion wird zu Cantal fermier und anderen Milchprodukten verarbeitet."
    ],
    "en": [
      "It's at the foot of Puy Griou that Anaïs and Sylvain have chosen to take over the family farm! They raise 40 Montbéliarde dairy cows. Their milk is transformed into farmhouse Cantal and other dairy products."
    ],
    "it": [
      "Anaïs e Sylvain hanno scelto di rilevare l'azienda agricola di famiglia ai piedi del Puy Griou! Allevano 40 mucche da latte Montbéliarde. Il loro latte viene trasformato in Cantal di fattoria e in altri prodotti caseari."
    ],
    "fr": [
      "C'est au pied du Puy Griou qu'Anaïs et Sylvain ont choisi de reprendre le flambeau de la ferme familiale ! Ils élèvent 40 vaches laitières de race Montbéliarde. Leur production de lait est transformée en Cantal fermier et autres produits laitiers."
    ],
    "es": [
      "Anaïs y Sylvain decidieron hacerse cargo de la granja familiar situada al pie del Puy Griou. Crían 40 vacas lecheras de raza Montbéliarde. Su leche se transforma en Cantal de granja y otros productos lácteos."
    ],
    "nl": [
      "Anaïs en Sylvain hebben ervoor gekozen om de familieboerderij aan de voet van de Puy Griou over te nemen! Ze houden 40 Montbéliarde melkkoeien. Hun melk wordt verwerkt tot boeren Cantal en andere zuivelproducten."
    ]
  },
  "rdfs:label": {
