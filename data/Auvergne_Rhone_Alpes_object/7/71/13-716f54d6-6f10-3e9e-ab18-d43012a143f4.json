  "rdfs:comment": {
    "de": [
      "Das Restaurant \"Le Mojo\" empfängt Sie in einem gemütlichen Rahmen. Mittags ganze Pizza oder 1/2 Pizza mit gemischtem Salat. Auswahl aus 29 Pizzen und 3 oder 4 Desserts."
    ],
    "en": [
      "The restaurant \"Le Mojo\" welcomes you in a warm atmosphere. Lunchtime whole pizza or 1/2 pizza with mixed salad. Choice of 29 pizzas and 3 or 4 desserts."
    ],
    "it": [
      "Il ristorante \"Le Mojo\" vi accoglie in una calda atmosfera. A pranzo pizze intere o 1/2 pizze con insalata mista. Scelta tra 29 pizze e 3 o 4 dessert."
    ],
    "fr": [
      "Le restaurant \"Le Mojo\" vous reçoit dans un cadre chaleureux. Le midi pizza entiere ou 1/2 pizza avec salade composée. Choix de 29 pizzas et 3 ou 4 desserts."
    ],
    "nl": [
      "Het restaurant \"Le Mojo\" verwelkomt je in een warme sfeer. S Middags hele pizza's of 1/2 pizza met gemengde salade. Keuze uit 29 pizza's en 3 of 4 desserts."
    ],
    "es": [
      "El restaurante \"Le Mojo\" le da la bienvenida en un ambiente acogedor. Al mediodía pizzas enteras o 1/2 pizzas con ensalada mixta. Elección de 29 pizzas y 3 o 4 postres."
    ]
  },
