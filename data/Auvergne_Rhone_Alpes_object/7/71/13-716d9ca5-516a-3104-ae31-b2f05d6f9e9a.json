  "rdfs:comment": {
    "de": [
      "Das Feriendorf Le Bérouze öffnet sein Restaurant für Gruppen nach vorheriger Reservierung. Entdecken Sie unsere savoyardischen Spezialitäten, aber auch schmackhafte und ausgewogene Menüs. Käseplatte mit regionalen Käsesorten. Hausgemachte Desserts und Gebäck."
    ],
    "en": [
      "Le Bérouze Holiday Village opens its restaurant to groups by reservation. Discover our Savoyard specialties but also tasty and balanced menus. Regional cheese platter. Homemade desserts and pastries."
    ],
    "it": [
      "Il Village Vacances Le Bérouze apre il suo ristorante ai gruppi su prenotazione. Scoprite le nostre specialità savoiarde e i menu gustosi ed equilibrati. Piatto di formaggi regionali. Dolci e pasticcini fatti in casa."
    ],
    "fr": [
      "Le Village Vacances Le Bérouze ouvre son restaurant aux groupes sur réservation. Découvrez nos spécialités savoyardes mais aussi des menus savoureux et équilibrés. Plateau de fromages régionaux. Desserts et pâtisseries faits maison."
    ],
    "es": [
      "Village Vacances Le Bérouze abre su restaurante a los grupos previa concertación. Descubra nuestras especialidades saboyanas así como menús sabrosos y equilibrados. Tabla de quesos regionales. Postres y pasteles caseros."
    ],
    "nl": [
      "Le Bérouze Holiday Village stelt zijn restaurant open voor groepen op reservering. Ontdek onze specialiteiten uit de Savoie, maar ook smakelijke en uitgebalanceerde menu's. Regionaal kaasplateau. Huisgemaakte desserts en gebak."
    ]
  },
  "rdfs:label": {
    "en": [
      "Restaurant Le Bérouze for groups"
    ],
    "fr": [
      "Restaurant Le Bérouze pour les groupes"
    ],
    "nl": [
      "Restaurant Le Bérouze voor groepen"
    ]
  },
