  "rdfs:comment": {
    "de": [
      "La Maison, Abende, um Ihnen Künstler aus der Region vorzustellen, ohne festgelegten Stil. Weil es hier viele Talente gibt und sie bei uns zu Hause sind.\r\nCB und Bar vor Ort, kein Catering."
    ],
    "en": [
      "La Maison, evenings to introduce you to artists from the region, with no defined style. Because there's a lot of talent around here, and they're right at home with us.\r\nCB and bar on site, no catering."
    ],
    "it": [
      "La Maison, serate per farvi conoscere artisti della regione, senza uno stile definito. Perché qui i talenti non mancano e sono di casa da noi.\r\nCB e bar in loco, nessun catering."
    ],
    "fr": [
      "La Maison, soirées pour vous présenter des artistes de la région, sans style défini. Parce que les talents sont nombreux par ici, et qu’ils sont chez nous chez eux.\r\nCB et bar sur place, pas de restauration."
    ],
    "es": [
      "La Maison, veladas para presentarle artistas de la región, sin estilo definido. Porque aquí hay talento de sobra, y con nosotros están como en casa.\r\nCB y bar in situ, sin catering."
    ],
    "nl": [
      "La Maison, avonden om je kennis te laten maken met artiesten uit de regio, zonder vastomlijnde stijl. Want talent is er genoeg hier, en ze zijn helemaal thuis bij ons.\r\nCB en bar ter plaatse, geen catering."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Maison #1 / EYES & LEGS / DEATH IS GONE"
    ]
  },
