  "rdfs:comment": {
    "de": [
      "Sie ermöglicht Ihnen die Verbindung zwischen dem Centre des Coches & dem Plateau der Eisbahn für den Zugang zum Salle Marcel Pignard, zum Schneekindergarten für die Kinder, zum Start des E-Spot ..."
    ],
    "en": [
      "The Télébufette gondola links the centre of Les Coches to the top of the village, with access to the Marcel Pignard hall, the children's snow garden, etc."
    ],
    "it": [
      "Il collegamento tra il Centre des Coches e l'altopiano della pista di pattinaggio consente di accedere alla Salle Marcel Pignard, al giardino di neve per i bambini, al punto di partenza dell'E-Spot, ecc."
    ],
    "fr": [
      "Elle vous permet de faire la liaison entre le Centre des Coches & le plateau de la patinoire pour l'accès à la Salle Marcel Pignard, au jardin des neiges pour les enfants, au départ du E-Spot ..."
    ],
    "nl": [
      "Zij laat U toe de verbinding te maken tussen het Centrum van les Coches & le haut des Coches voor de toegang tot de zaal Marcel Pignard, in de \"jardin des neiges\" voor de kinderen."
    ],
    "es": [
      "Sirve de enlace entre el Centre des Coches y la meseta de la pista de patinaje para acceder a la Salle Marcel Pignard, el jardín de nieve para niños, el punto de salida del E-Spot, etc."
    ]
  },
