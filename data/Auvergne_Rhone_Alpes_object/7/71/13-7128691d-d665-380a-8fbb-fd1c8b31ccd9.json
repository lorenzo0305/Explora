  "rdfs:comment": {
    "de": [
      "Rund um die Sauna, das Dampfbad, die Sinnesduschen, die norwegischen Duschen und die Fußbäder genießen Sie eine Blase des Wohlbefindens in der kokonartigen und warmen Atmosphäre der Bergchalets der Résidence Pierre & Vacances Premium Les Terrasses d'Hélios in Flaine."
    ],
    "en": [
      "Take advantage of the sauna, hammam, sensory and Norwegian showers and footbaths to enjoy a wellness bubble in the warm, cocooning atmosphere of the mountain chalets in the Pierre & Vacances Premium Les Terrasses d'Hélios residence in Flaine."
    ],
    "it": [
      "Approfittate della sauna, dell'hammam, delle docce sensoriali e norvegesi e dei pediluvi per godervi una bolla di benessere nell'atmosfera calda e avvolgente degli chalet di montagna del residence Pierre & Vacances Premium Les Terrasses d'Hélios a Flaine."
    ],
    "fr": [
      "Autour du sauna, hammam, douches sensorielle et norvégienne, des bains de pieds, profitez d'une bulle de bien-être dans l'ambiance cocooning et chaleureuse des chalets de montagne de la Résidence Pierre & Vacances Premium Les Terrasses d'Hélios de Flaine."
    ],
    "nl": [
      "Profiteer van de sauna, hammam, zintuiglijke en Noorse douches en voetenbaden om te genieten van een wellness-bubbel in de warme, cocooning sfeer van de bergchalets in de Pierre & Vacances Premium Les Terrasses d'Hélios residentie in Flaine."
    ],
    "es": [
      "Aproveche la sauna, el hammam, las duchas sensoriales y noruegas y los pediluvios para disfrutar de una burbuja de bienestar en el ambiente cálido y envolvente de los chalets de montaña de la residencia Pierre & Vacances Premium Les Terrasses d'Hélios en Flaine."
    ]
  },
  "rdfs:label": {
    "en": [
      "Deep Nature Spa"
    ],
    "fr": [
      "Spa Deep Nature"
    ],
    "nl": [
      "Deep Nature Spa"
    ]
  },
