  "rdfs:comment": {
    "de": [
      "Die Burg wurde Anfang des 13. Jahrhunderts von Philipp II., genannt August, erbaut und vervollständigte das Festungsnetz der Stadt. Während des Ersten Weltkriegs wurde sie beschädigt und anschließend restauriert. Seit 1992 beherbergt sie das Historial de la Grande Guerre."
    ],
    "en": [
      "Built in the early 13th century by Philippe II dit Auguste, this château completed the city's fortification network. Damaged and restored during the Great War, it has been home to the Historial de la Grande Guerre since 1992."
    ],
    "it": [
      "Costruito all'inizio del XIII secolo da Filippo II, detto Auguste, questo castello completava la rete di fortificazioni della città. Danneggiato durante la Grande Guerra e successivamente restaurato, dal 1992 è sede dell'Historial de la Grande Guerre."
    ],
    "fr": [
      "Construit au début du XIIIe siècle par Philippe II dit Auguste, ce château vint compléter le réseau de fortification de la ville. Endommagé pendant la Grande Guerre puis restauré, il accueil depuis 1992 l'Historial de la Grande Guerre."
    ],
    "nl": [
      "Dit kasteel werd in het begin van de 13e eeuw gebouwd door Philippe II, beter bekend als Auguste, en voltooide het versterkingsnetwerk van de stad. Beschadigd tijdens de Grote Oorlog en vervolgens gerestaureerd, is het sinds 1992 de thuisbasis van de Historial de la Grande Guerre."
    ],
    "es": [
      "Construido a principios del siglo XIII por Felipe II, llamado Augusto, este castillo completaba la red de fortificaciones de la ciudad. Dañado durante la Gran Guerra y restaurado posteriormente, alberga desde 1992 el Historial de la Grande Guerre."
    ]
  },
