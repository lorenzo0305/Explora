  "rdfs:comment": {
    "de": [
      "Im Herzen Vieux-Lyons gelegen, nimmt dieses Hotel die Züge eines Stadtschlosses an, dessen Dekoration Sie in die italienische Renaissance eintauchen lässt."
    ],
    "en": [
      "Located in the heart of Old Lyon, this striking hotel resembles a city centre palace with decoration that takes you straight back to the Italian Renaissance."
    ],
    "it": [
      "Collocato nel cuore della Lione Vecchia, questo hotel sembra un castello cittadino, con una decorazione che ti immergerà nel Rinascimento italiano."
    ],
    "fr": [
      "Situé au cœur du Vieux-Lyon, cet hôtel prend des allures de château en ville dont la décoration vous replonge dans la Renaissance italienne."
    ],
    "es": [
      "Situado en pleno barrio de Vieux-Lyon, este hotel tiene el aspecto de un palacio urbano y una decoración que traslada al Renacimiento italiano."
    ],
    "nl": [
      "Dit hotel, gelegen in het hart van het oude Lyon, lijkt op een kasteel in de stad en de inrichting brengt u terug naar de Italiaanse Renaissance."
    ]
  },
