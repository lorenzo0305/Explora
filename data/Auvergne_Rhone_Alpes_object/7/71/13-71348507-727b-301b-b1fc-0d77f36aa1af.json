  "rdfs:comment": {
    "de": [
      "von 8 bis 10 Uhr Verkauf von Sandwiches und Salaten zum Mitnehmen, mittags Gericht des Tages Brett Wurst oder Käse Salate abends Brett Wurst oder Käse Weinbar Aperitif nachmittags Eis vom Bauernhof Dessert Verkauf von Wurst zum Mitnehmen"
    ],
    "en": [
      "The team of La Martille’s restaurant welcomes you and offers you a local old-fashionned home cooking."
    ],
    "it": [
      "dalle 8 alle 10 vendita di panini e insalate da asporto, pranzo tagliere di salumi o formaggi insalate sera tagliere di salumi o formaggi wine bar aperitivo pomeridiano gelato della fattoria dessert vendita di salumi da asporto"
    ],
    "fr": [
      "de 8h a 10h vente de sandwichs et salades a emporter, le midi plat du jours planche de charcuterie ou de fromage salades le soir planche charcuterie ou fromage bar a vin  apéro l après midi glace de la ferme dessert vente de charcuterie a emporter"
    ],
    "nl": [
      "van 8 tot 10 uur verkoop van broodjes en salades om mee te nemen, lunchschotel van vleeswaren of kaassalades 's avonds schotel van vleeswaren of kaas wijnbar 's middags aperitief ijs van de boerderij dessert verkoop van vleeswaren om mee te nemen"
    ],
    "es": [
      "de 8h a 10h venta de bocadillos y ensaladas para llevar, almuerzo tabla de embutidos o queso ensaladas por la noche tabla de embutidos o queso bar de vinos aperitivo por la tarde helado de la granja postre venta de embutidos para llevar"
    ]
  },
  "rdfs:label": {
    "en": [
      "Les casse-croûte de la Martille"
    ],
    "fr": [
      "Les casse-croûte de la Martille"
    ]
