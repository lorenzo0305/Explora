  "rdfs:comment": {
    "de": [
      "Erbe und Geschichte der Bergleute. Eineinhalb Jahrhunderte Bergbau: Hängestube, Fördergerüst, Bergbaumaschine. Enthalten: Auvergne im Miniaturformat, animierte Reproduktion mit ihren kleinen Zügen; Video. Sommer: Fahrrad-Schiene und kleiner Zug. Exposition."
    ],
    "en": [
      "We demonstrate the heritage and history of miners following one and a half centuries of mining and extraction machinery. We look at he Auvergne in minature, via an animated reproduction with a small train and video. In summer rail bike and train. Exhibition."
    ],
    "it": [
      "Patrimonio e storia dei minatori. Un secolo e mezzo di attività mineraria: sala d'attesa, telaio di testa, macchina da miniera. Include: l'Alvernia in miniatura, riproduzione animata con trenini, video. Estate: vélorail e trenino. Mostra"
    ],
    "fr": [
      "Patrimoine et histoire des mineurs. Un siècle et demi d'exploitation minière: salle des pendus, chevalement, machine d'extraction. Inclus: L'Auvergne en miniature, reproduction animée avec ses petits trains, vidéo. Été: vélorail et petit train. Exposition"
    ],
    "es": [
      "Patrimonio e historia de los mineros. Siglo y medio de minería: sala de colgadura, cabezal, máquina minera. Incluye: Auvernia en miniatura, reproducción animada con trenes en miniatura, vídeo. Verano: vélorail y trenecito. Exposición"
    ],
    "nl": [
      "Het verleden en de geschiedenis van de mijnen in hun oorspronkelijke omgeving."
    ]
  },
  "rdfs:label": {
    "en": [
