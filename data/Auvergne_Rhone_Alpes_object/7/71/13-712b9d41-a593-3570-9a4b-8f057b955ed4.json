  "rdfs:comment": {
    "de": [
      "In diesem wilden Gebiet können Sie unter den Hängen von Casse Massion Skitouren unternehmen. Dieser Rundweg ist ideal für Skitouren in einem ruhigen und geschützten Gebiet."
    ],
    "en": [
      "This wilderness area lets you experience ski touring under the slopes of Casse Massion. This loop is ideal for ski touring in a quiet, protected area."
    ],
    "it": [
      "Quest'area selvaggia offre la possibilità di provare lo sci alpinismo sotto le pendici della Casse Massion. Questo anello è ideale per lo scialpinismo in un'area sicura, tranquilla e incontaminata."
    ],
    "fr": [
      "Cet espace sauvage vous permet d’expérimenter le ski de randonnée sous les pentes de Casse Massion. Cette boucle est idéale pour pour faire du ski de randonnée dans un endroit sécurisé calme et préservé."
    ],
    "es": [
      "Este espacio natural le brinda la oportunidad de probar el esquí de travesía bajo las pistas de Casse Massion. Este bucle es ideal para practicar esquí de travesía en una zona segura, tranquila y virgen."
    ],
    "nl": [
      "Dit wildernisgebied geeft je de kans om te proberen te toerskiën onder de hellingen van Casse Massion. Deze lus is ideaal voor skitochten in een veilig, rustig en ongerept gebied."
    ]
  },
  "rdfs:label": {
    "en": [
      "Ascent to Crêt de l'âne"
    ],
    "fr": [
      "Montée au Crêt de l'âne"
    ]
  },
