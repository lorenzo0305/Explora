  "rdfs:comment": {
    "de": [
      "Benjamin, schlägt Ihnen eine Auswahl an Wanderungen vor, um unser fantastisches Tal zu entdecken. In kleinen Gruppen von maximal 8 Personen oder privat mit Ihrer Familie oder Ihren Freunden."
    ],
    "en": [
      "Benjamin, offers you a selection of hikes to discover our wonderful valley. In small groups of 8 or less, or privately with your family or friends."
    ],
    "it": [
      "Benjamin vi offre una selezione di passeggiate per scoprire la nostra meravigliosa valle. In piccoli gruppi di massimo 8 persone o privatamente con la famiglia o gli amici."
    ],
    "fr": [
      "Benjamin, vous propose une sélection de randonnées pour découvrir notre formidable vallée. En petit groupe de 8 personnes maximum ou en privé avec votre familles ou vos amis."
    ],
    "es": [
      "Benjamin le ofrece una selección de paseos para descubrir nuestro maravilloso valle. En pequeños grupos de 8 personas como máximo o en privado con tu familia o amigos."
    ],
    "nl": [
      "Benjamin biedt je een selectie wandelingen om onze prachtige vallei te ontdekken. In kleine groepen van maximaal 8 personen of privé met je familie of vrienden."
    ]
