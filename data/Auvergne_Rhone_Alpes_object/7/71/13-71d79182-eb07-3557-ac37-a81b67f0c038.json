  "rdfs:comment": {
    "de": [
      "Der Straßenname entstand nach den Seilereien, die am Canal des Moulins Leder verarbeiteten. Das Hotel der Prinzen von Monaco, die seit 1647 die Lehnsherren von Chabeuil waren, war ihr Zweitwohnsitz."
    ],
    "en": [
      "The name of the street was given after the leather workers who worked the Canal des Moulins. The Hotel of the Princes of Monaco, suzerains of Chabeuil since 1647, was their secondary house."
    ],
    "it": [
      "L'Hôtel des Princes de Monaco, signori di Chabeuil dal 1647, era la loro seconda casa.\r\nLa strada prende il nome dai corroyeurs che lavoravano il cuoio al Canal des Moulins."
    ],
    "fr": [
      "L'Hôtel des Princes de Monaco, suzerains de Chabeuil depuis 1647, a été leur maison secondaire.\r\nLe nom de la rue a été donné suite aux corroyeurs qui travaillaient le cuir au Canal des Moulins."
    ],
    "es": [
      "El Hôtel des Princes de Monaco, señores de Chabeuil desde 1647, era su segunda residencia.\r\nLa calle debe su nombre a los corroyeurs que trabajaban el cuero en el Canal des Moulins."
    ],
    "nl": [
      "De naam van de straat werd gegeven naar de corroyeurs die het leer bewerkten aan het Canal des Moulins. Het Hôtel des Princes de Monaco, heren van Chabeuil sinds 1647, was hun tweede huis."
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'Hôtel des Princes de Monaco"
    ]
  },
