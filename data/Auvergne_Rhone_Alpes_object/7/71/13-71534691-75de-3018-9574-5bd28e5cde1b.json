  "rdfs:comment": {
    "de": [
      "Der unter den Firnfeldern des Grand-Arc gelegene Plan d'eau de Barouchat wird vom Fischereiverband Savoyen verwaltet und ist das ganze Jahr über geöffnet (siehe Öffnungszeiten und Preise: 3 Angelperioden). Getränke und Speisen vor Ort, Verleih von Angelausrüstung möglich."
    ],
    "en": [
      "Located under the firns of the Grand-Arc, the lake of Barouchat (managed by the fishing federation of Savoy) is open during the whole year (2 periods of fishing). Food and beverage on site, possibility to rent fishing gear ."
    ],
    "it": [
      "Situato sotto i nevai del Grand-Arc, il lago di Barouchat, gestito dalla Federazione di Pesca della Savoia, è aperto tutto l'anno (vedi aperture e prezzi: 2 periodi di pesca). Bevande e spuntini in loco e noleggio di attrezzatura da pesca."
    ],
    "fr": [
      "Situé sous les névés du Grand-Arc, le plan d’eau de Barouchat, géré par la Fédération de Pêche Savoie, est ouvert toute l’année (voir ouvertures et tarifs : 3 périodes de pêche). Boisson et restauration sur place, location de matériel de pêche possible."
    ],
    "es": [
      "Situado bajo las nieves del Grand-Arc, el lago de Barouchat, gestionado por la Federación de Pesca de Saboya, está abierto todo el año (ver aperturas y tarifas: 3 periodos de pesca). Bebidas y tentempiés in situ, alquiler de material de pesca."
    ],
    "nl": [
      "Het meer van Barouchat ligt onder de sneeuwvelden van de Grand-Arc en wordt beheerd door de Savoie Fishing Federation. Het meer is het hele jaar geopend (zie openingstijden en prijzen: 2 visperiodes). Drankjes en snacks ter plaatse en verhuur van visgerei."
    ]
  },
  "rdfs:label": {
    "en": [
      "Pêche de Savoie from Barouchat lake"
    ],
    "it": [
      "Lago di pesca savoiardo di Barouchat"
    ],
    "fr": [
      "Pôle Pêche de Barouchat"
    ],
    "nl": [
      "Savoie vismeer van Barouchat"
    ]
  },
