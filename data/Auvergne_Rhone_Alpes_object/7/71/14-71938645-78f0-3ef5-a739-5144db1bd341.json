      "@id": "https://data.datatourisme.fr/4c2e92c1-a56a-3ccc-a873-c42a6adab444",
      "dc:description": {
        "de": [
          "Frische Produkte, Traditionelle Küche, Hausgemacht, Regionale Küche\n\nÖffnungszeiten:\nMontag bis Donnerstag von 12h bis 13h45\nFreitags von 12:00 bis 13:45 Uhr und von 19:00 bis 21:00 Uhr\nSamstags von 19:00 bis 21:00 Uhr"
        ],
        "en": [
          "Fresh produce, Traditional cuisine, Home-made, Terroir\n\nOpening hours :\nMonday to Thursday, 12pm to 1:45pm\nFriday from 12h to 13h45 and from 19h to 21h\nSaturday from 7pm to 9pm"
        ],
        "it": [
          "Prodotti freschi, Cucina tradizionale, Cucina casalinga, Prodotti locali\n\nOrari di apertura :\nDa lunedì a giovedì dalle 12h alle 13h45\nVenerdì dalle 12h alle 13h45 e dalle 19h alle 21h\nSabato dalle 19 alle 21"
        ],
        "fr": [
          "Produits frais, Cuisine Traditionnelle, Fait maison, Terroir\n\nHoraires d'ouverture : \nDu Lundi au Jeudi de 12h à 13h45\nLe Vendredi de 12h à 13h45 et de 19h à 21h\nLe Samedi de 19h à 21h"
        ],
        "nl": [
          "Verse producten, Traditionele keuken, Huisgemaakt, Lokale producten\n\nOpeningstijden :\nMaandag tot donderdag van 12u tot 13u45\nVrijdag van 12u tot 13u45 en van 19u tot 21u\nZaterdag van 19u tot 21u"
        ],
        "es": [
          "Productos frescos, Cocina tradicional, Casera, Productos locales\n\nHorario de apertura :\nDe lunes a jueves de 12h a 13h45\nViernes de 12h a 13h45 y de 19h a 21h\nSábado de 19h a 21h"
        ]
      },
