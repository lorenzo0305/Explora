  "rdfs:comment": {
    "de": [
      "Les Quatre Sources ist ein bistronomisches Restaurant, das eine \"hausgemachte\" Küche anbietet, die mit lokalen Produkten in einem gemütlichen und geselligen Rahmen zubereitet wird."
    ],
    "en": [
      "Les Quatre Sources is a bistronomic restaurant offering \"home-made\" cuisine using local produce in a cosy, friendly setting."
    ],
    "it": [
      "Les Quatre Sources è un ristorante bistronomico che serve piatti fatti in casa con prodotti locali in un ambiente accogliente e amichevole."
    ],
    "fr": [
      "Les Quatre Sources est un restaurant bistronomique proposant une cuisine \"fait maison\" élaborée avec des produits locaux dans un cadre cosy et convivial."
    ],
    "nl": [
      "Les Quatre Sources is een bistronomisch restaurant waar huisgemaakte gerechten met lokale producten worden geserveerd in een gezellige, vriendelijke omgeving."
    ],
    "es": [
      "Les Quatre Sources es un restaurante bistronómico que sirve comida casera elaborada con productos locales en un ambiente acogedor y agradable."
    ]
  },
