  "rdfs:comment": {
    "de": [
      "Das Rathaus von Cournon-d'Auvergne ist in einem Schloss untergebracht, das aus dem Ende des 17. Jahrhunderts. An dieser Stelle befand sich zuvor eine mittelalterliche Burg, die in einem Konflikt zerstört wurde."
    ],
    "en": [
      "The town hall of Cournon-d’Auvergne is housed in a château from the late 17th century. It is the site of a former medieval château that was destroyed during a conflict."
    ],
    "it": [
      "Il municipio di Cournon-d'Auvergne è ospitato in un castello risalente alla fine del XVII secolo. Un tempo su questo sito sorgeva un castello medievale distrutto durante una guerra."
    ],
    "fr": [
      "La mairie de Cournon-d’Auvergne est abritée au sein d’un château datant de la fin du 17e siècle. À cet emplacement, existait encore auparavant un château médiéval détruit lors d’un conflit."
    ],
    "nl": [
      "Het stadhuis van Cournon-d'Auvergne is gevestigd in een kasteel uit het einde van de 17e eeuw. Op deze plek stond ooit een middeleeuws kasteel dat tijdens een oorlog werd verwoest."
    ],
    "es": [
      "El Ayuntamiento de Cournon-d'Auvergne ocupa un castillo de finales del siglo XVII. En este lugar hubo un castillo medieval destruido durante una guerra."
    ]
  },
  "rdfs:label": {
