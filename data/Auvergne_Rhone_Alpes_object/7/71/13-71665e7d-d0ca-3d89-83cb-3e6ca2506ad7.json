  "rdfs:comment": {
    "de": [
      "Lust auf einen Ausflug? In Uriage erwartet Sie das Hotel Les Mésanges in einer grünen Oase in der Nähe von Grenoble und Chamrousse, am Fuße der Belledonne. Der ideale Ort, um die Füße hochzulegen, neue Energie zu tanken und Ihre Lieben in vollen Zügen zu genießen."
    ],
    "en": [
      "Just 10 minutes from Grenoble, in the heart of the Uriage spa, the hotel/restaurant “les mésanges” boasts a unique view of the Vercors and Chartreuse massifs, and a glimpse of the Belledonne range."
    ],
    "it": [
      "Siete alla ricerca di una fuga? Andate a Uriage, dove vi aspetta l'Hôtel Les Mésanges, in un ambiente verde vicino a Grenoble e Chamrousse, ai piedi delle montagne di Belledonne. Il luogo ideale per staccare la spina, fare il pieno di energia e godersi appieno i propri cari."
    ],
    "fr": [
      "Envie d’une escapade ? Direction Uriage où vous attend l’hôtel Les Mésanges, dans un écrin de verdure à proximité de Grenoble et de Chamrousse, au pied de Belledonne. L’idéal pour lever le pied, se ressourcer et profiter pleinement de vos proches."
    ],
    "es": [
      "¿Busca una escapada? Diríjase a Uriage, donde le espera el Hôtel Les Mésanges, en un entorno verde cerca de Grenoble y Chamrousse, a los pies de los montes Belledonne. El lugar ideal para desconectar, reponer fuerzas y disfrutar plenamente de los suyos."
    ],
    "nl": [
      "Op slechts tien minuten van Grenoble, in het hart van het kuuroord Uriage, biedt het hotel/restaurant “les mésanges” een uniek uitzicht op de Vercors en de Chartreuse, met een glimp van de bergketen van Belledonne."
    ]
  },
