  "rdfs:comment": {
    "de": [
      "In einem Zirkuszelt. Show: Ein Zirkusvisual um 22:30 Uhr. Tanz auf der zentralen Manege: spanische Musik, Varieté 70/80er Jahre. Menüs von 29 € bis 46 €, inklusive Wein. Südwestliche und spanische Küche. Überdachter Außenbereich für Raucher."
    ],
    "en": [
      "Under a circus tent. Show: a circus visual at 10:30 pm. Dancing on the central dance floor: Spanish music, variety shows from the 70s and 80s. Menus from 29 € to 46 €, wine included. Southwestern and Spanish cuisine. Outdoor covered area for smokers."
    ],
    "it": [
      "Sotto il tendone di un circo. Spettacolo: un circo visivo alle 22.30. Ballo sulla pista centrale: musica spagnola, varietà anni 70/80. Menu da 29 a 46 euro, vino compreso. Cucina sud-occidentale e spagnola. Area esterna coperta per i fumatori."
    ],
    "fr": [
      "Sous un chapiteau de cirque. Spectacle : un visuel de cirque à 22h30. Dansant sur la piste centrale : musique espagnole, variétés années 70/80. Menus de 29 € à 46 €, vin compris. Cuisine du sud-ouest et espagnole. Zone couverte extérieure pour fumeurs."
    ],
    "nl": [
      "Onder een circustent. Show: een circusvoorstelling om 22.30 uur. Dansen op de centrale dansvloer: Spaanse muziek, 70's/80's variëteiten. Menu's van 29 € tot 46 €, inclusief wijn. Zuidwesterse en Spaanse keuken. Overdekte buitenruimte voor rokers."
    ],
    "es": [
      "Bajo una carpa de circo. Espectáculo: un visual de circo a las 22:30 horas. Baile en la pista central: música española, variedades de los 70/80. Menús desde 29€ hasta 46€ incluyendo el vino. Cocina del suroeste y española. Zona exterior cubierta para fumadores."
    ]
  },
  "rdfs:label": {
