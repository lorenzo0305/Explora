  "rdfs:comment": {
    "de": [
      "Handgefertigter Schmuck aus Natursteinen, handgefertigt nach der Kupfer-Wirewrapping-Technik.\r\nEine Designerin, die aus der traditionellen Schmuckherstellung stammt und über 15 Jahre Erfahrung hat."
    ],
    "en": [
      "Handcrafted jewellery made from natural stones, handmade using the copper wire wrapping technique.\r\nA designer with a background in traditional jewellery making and over 15 years of experience."
    ],
    "it": [
      "Gioielli artigianali realizzati con pietre naturali, utilizzando la tecnica del filo di rame.\r\nUn designer con una formazione in gioielleria tradizionale e oltre 15 anni di esperienza."
    ],
    "fr": [
      "Bijoux artisanaux en pierres naturelles, fabriqués à la main selon  la technique du wirewrapping cuivre.\r\nUne créatrice issue de la bijouterie traditionnelle, avec plus de 15 ans d'expérience."
    ],
    "es": [
      "Joyas artesanales elaboradas con piedras naturales, mediante la técnica del alambrado de cobre.\r\nDiseñadora con formación en joyería tradicional y más de 15 años de experiencia."
    ],
    "nl": [
      "Handgemaakte sieraden van natuurlijke stenen, met behulp van de koperdraad-techniek.\r\nEen ontwerper met een achtergrond in traditionele sieraden en meer dan 15 jaar ervaring."
    ]
  },
