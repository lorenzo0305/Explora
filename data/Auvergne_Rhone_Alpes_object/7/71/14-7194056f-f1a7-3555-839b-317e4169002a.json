  "rdfs:comment": {
    "de": [
      "Im Herzen des Dorfes Ablain-Saint-Nazaire, unterhalb des Hügels Notre-Dame-de-Lorette, empfängt Sie die Ferme Auberge du Pré Molaine mit Herzlichkeit und Freundlichkeit an ihrem Tisch."
    ],
    "en": [
      "Located in the heart of the village of Ablain-Saint-Nazaire, just below the hill of Notre-Dame-de-Lorette, the Ferme Auberge du Pré Molaine offers a warm and friendly welcome."
    ],
    "it": [
      "Situata nel cuore del villaggio di Ablain-Saint-Nazaire, proprio sotto la collina di Notre-Dame-de-Lorette, la Ferme Auberge du Pré Molaine offre un'accoglienza calorosa e amichevole."
    ],
    "fr": [
      "Située au coeur du village d'Ablain-Saint-Nazaire, en contrebas de la colline Notre-Dame-de-Lorette, la Ferme Auberge du Pré Molaine vous accueille à sa table, avec chaleur et convivialité."
    ],
    "es": [
      "Situada en el corazón del pueblo de Ablain-Saint-Nazaire, justo debajo de la colina de Notre-Dame-de-Lorette, la Ferme Auberge du Pré Molaine le ofrece una cálida y acogedora bienvenida."
    ],
    "nl": [
      "Gelegen in het hart van het dorp Ablain-Saint-Nazaire, net onder de heuvel Notre-Dame-de-Lorette, biedt de Ferme Auberge du Pré Molaine een warm en vriendelijk onthaal."
    ]
  },
