  "rdfs:comment": {
    "de": [
      "Dieser familiengeführte Bio-Bauernhof mit einem Dutzend Tarine- und Jersiaises-Kühen bietet gereiften Käse sowie frische Milchprodukte zum Verkauf an und bietet die Möglichkeit, ab 18 Uhr beim Melken zuzusehen."
    ],
    "en": [
      "This family-run organic farm, with a dozen Tarines and Jersey cows sales mature cheeses and fresh dairy-products and offers the opportunity to see cow milking from 6 pm."
    ],
    "it": [
      "Questa fattoria biologica a conduzione familiare, con una dozzina di mucche Tarines e Jersiaises, offre formaggi stagionati e prodotti caseari freschi in vendita e offre la possibilità di assistere alla mungitura dalle 18:00."
    ],
    "fr": [
      "Cette ferme familiale en bio, avec une douzaine de vaches Tarines et Jersiaises, propose à la vente des fromages affinés ainsi que des produits laitiers frais et offre la possibilité d'assister à la traite à partir de 18h."
    ],
    "es": [
      "Esta granja familiar ecológica, con una docena de vacas Tarines y Jersiaises, ofrece quesos madurados y productos lácteos frescos a la venta y ofrece la posibilidad de asistir al ordeño a partir de las 18 horas."
    ],
    "nl": [
      "Dit biologische familiebedrijf met een dozijn Tarine- en Jerseykoeien produceert kazen en andere verse zuivelproducten. Vanaf 6 uur 's avonds kun je het melken bijwonen."
    ]
  },
  "rdfs:label": {
