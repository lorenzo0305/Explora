  "rdfs:comment": {
    "de": [
      "Atelier für Gebrauchs- und dekorative Konkurs-Töpferei. Herstellung von einzigartigen und künstlerischen Objekten. Gebrauchskeramik aus Konkurs von Murielle Gachet.  Verkauf in der Boutique \"Les 4 mains\" in Le Puy en Velay. Direktverkauf in der Werkstatt nach Vereinbarung."
    ],
    "en": [
      "Workshop for utilitarian and decorative pottery. Creation of unique and artistic objects. Utilitarian glazed pottery by Murielle Gachet.  For sale at the 4 Hands boutique in Le Puy en Velay. Direct sales at the workshop by appointment."
    ],
    "it": [
      "Laboratorio di ceramiche utilitarie e decorative. Creazione di oggetti unici e artistici. Ceramiche d'uso realizzate da Murielle Gachet.  In vendita nel negozio Les 4 mains di Le Puy en Velay. Vendita diretta presso il laboratorio su appuntamento."
    ],
    "fr": [
      "Atelier de poterie de faillance utilitaire et décoratives. Création d'objets uniques et artistiques. Poteries utilitaires en faillance de Murielle Gachet.  Vente à la boutique les 4 mains au Puy en Velay. Vente directe à l'atelier sur rendez vous."
    ],
    "nl": [
      "Werkplaats voor gebruiks- en sieraardewerk. Creatie van unieke en artistieke objecten. Gebruiksaardewerk gemaakt door Murielle Gachet.  Te koop in de winkel Les 4 mains in Le Puy en Velay. Directe verkoop in het atelier op afspraak."
    ],
    "es": [
      "Taller de cerámica utilitaria y decorativa. Creación de objetos únicos y artísticos. Cerámica utilitaria realizada por Murielle Gachet.  Venta en la tienda Les 4 mains de Le Puy en Velay. Venta directa en el taller con cita previa."
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'atelier de la terre"
    ]
  },
