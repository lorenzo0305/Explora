  "rdfs:comment": {
    "de": [
      "Bewegen Sie sich dank der blauen Nordic-Ski-Piste \"l'Arbaron\" über das Arbaron-Plateau. Bewegen Sie sich auf einer 2 km langen, gespurten Loipe zwischen Tannen und einem offenen Plateau und machen Sie in Ihrem eigenen Rhythmus Fortschritte beim klassischen oder Skating-Langlauf."
    ],
    "en": [
      "Glide across the Arbaron plateau on the blue \"Arbaron\" Nordic ski trail. Glide along a 2km groomed track, between fir trees and an open plateau, and progress at your own pace on classic or skating cross-country skis."
    ],
    "it": [
      "Scivolate sull'altopiano di Arbaron sulla pista blu di sci nordico \"Arbaron\". Scivolate su una pista battuta di 2 km, tra abeti e un altopiano aperto, e procedete al vostro ritmo con gli sci da fondo classici o skating."
    ],
    "fr": [
      "Évoluez à travers le plateau de l'Arbaron grâce à la piste bleu de ski nordique \"l'Arbaron\". Évoluez sur une piste damée de 2km, entre sapin et plateau dégagé et progressez à votre rythme en ski de fond classique ou skating."
    ],
    "nl": [
      "Glijd over het Arbaron-plateau op de blauwe noordse loipe \"Arbaron\". Glijd over een geprepareerde loipe van 2 km, tussen dennenbomen en een open plateau, en volg je eigen tempo op klassieke of skating langlaufski's."
    ],
    "es": [
      "Deslícese por la meseta de Arbaron en la pista azul de esquí nórdico \"Arbaron\". Deslícese por una pista preparada de 2 km, entre abetos y una meseta abierta, y avance a su ritmo con esquís de fondo clásicos o de patinaje."
    ]
  },
  "rdfs:label": {
    "en": [
      "\"L'Arbaron\" blue nordic ski run"
    ],
    "fr": [
      "Piste bleue de ski nordique « l'Arbaron »"
    ],
    "nl": [
      "Blauwe noordse skipiste \"L'Arbaron\""
    ]
  },
