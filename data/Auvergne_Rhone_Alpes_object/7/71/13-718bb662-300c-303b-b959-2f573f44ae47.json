  "rdfs:comment": {
    "de": [
      "Das ultimative Freizeiterlebnis. Ab 3 Jahren\r\n\r\nÖffentliche Tarife :\r\nMit dem Pass Classique : 9€\r\nMit dem Essential und Piéton+ Pass erhalten Sie -50% Rabatt auf Ihre Rodelbahn.\r\nMit dem Premium Pass ist die Schlittenfahrt in Ihrem Pass enthalten."
    ],
    "en": [
      "Luge 1800\r\nThe ultimate recreational experience. From 3 years old\r\n\r\nPublic price :\r\nWith the Classical Pass: €9\r\nWith the Essential and Piéton+ Pass, get -50% off your toboggan run.\r\nWith the Premium Pass, the sled ride is unlimited !"
    ],
    "it": [
      "Slitta 1800\r\nL'esperienza ludica per eccellenza. Da 3 anni\r\n\r\nPrezzo al pubblico:\r\nCon il Pass Classic: 9?\r\nCon i Pass Essentiel e Piéton+, sconto del 50% sulle slitte.\r\nCon il Pass Premium, slittate senza limiti!"
    ],
    "fr": [
      "Luge 1800\r\nL'expérience récréative par excellence. À partir de 3 ans\r\n\r\nTarif public :\r\nAvec le Pass Classique : 9€\r\nAvec les Pass Essentiel et Piéton+ bénéficiez de -50% sur votre descente en luge.\r\nAvec le Pass Premium, les descentes en luge sont illimitées!"
    ],
    "es": [
      "Trineo 1800\r\nLa experiencia recreativa definitiva. A partir de 3 años\r\n\r\nPrecio público :\r\nCon el Pase Clásico: 9?\r\nCon los Pases Essentiel y Piéton+, consigue un 50% de descuento en tus paseos en trineo.\r\nCon el Pase Premium, ¡podrás tirarte en trineo de forma ilimitada!"
    ],
    "nl": [
      "1800 slee\r\nDe ultieme recreatieve ervaring. Vanaf 3 jaar\r\n\r\nPublieksprijs :\r\nMet de Classic Pass: 9?\r\nMet de Essentiel en Piéton+ passen krijg je 50% korting op sleeën.\r\nMet de Premium Pass kun je onbeperkt sleeën!"
    ]
  },
