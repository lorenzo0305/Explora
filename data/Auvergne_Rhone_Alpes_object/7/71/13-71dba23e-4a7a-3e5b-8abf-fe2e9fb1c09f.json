  "rdfs:comment": {
    "de": [
      "Saint-Constant und Fournoulès bilden seit 2016 eine einzige Gemeinde. Dennoch herrschen dort zwei ganz unterschiedliche Atmosphären: In Saint-Constant weht ein Hauch von Aveyron, während Fournoulès ein eher bergiges Gesicht zeigt."
    ],
    "en": [
      "Saint-Constant and Fournoulès have been a single commune since 2016. Yet two very different atmospheres prevail: Saint-Constant looks a little like Aveyron, while Fournoulès has a more mountainous atmosphere."
    ],
    "it": [
      "Saint-Constant e Fournoulès sono un unico comune dal 2016. Tuttavia, prevalgono due atmosfere molto diverse: Saint-Constant ha un'atmosfera da Aveyron, mentre Fournoulès ha un'atmosfera più montana."
    ],
    "fr": [
      "Saint-Constant et Fournoulès ne forment plus qu'une seule commune depuis 2016. Deux atmosphères bien différentes y règnent pourtant : un air d'Aveyron flotte à Saint-Constant alors que Fournoulès présente un visage plus montagnard."
    ],
    "nl": [
      "Saint-Constant en Fournoulès zijn sinds 2016 één gemeente. Toch heersen er twee heel verschillende sferen: Saint-Constant heeft de sfeer van Aveyron, terwijl Fournoulès meer bergachtig aandoet."
    ],
    "es": [
      "Desde 2016, Saint-Constant y Fournoulès forman un solo municipio. Sin embargo, tienen dos ambientes muy diferentes: Saint-Constant tiene un aire de Aveyron, mientras que Fournoulès es más montañoso."
    ]
  },
