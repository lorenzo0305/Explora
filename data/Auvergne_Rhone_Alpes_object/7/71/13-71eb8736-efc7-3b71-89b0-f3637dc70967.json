  "rdfs:comment": {
    "de": [
      "Das Hotel liegt auf dem Plateau von Avoriaz und gegenüber den Tennisplätzen. Das Le Yéti empfängt Sie das ganze Jahr über auf seiner großen Sonnenterrasse oder in seinem gemütlichen Saal. Brasserie-Küche, gesellige Atmosphäre und ein atemberaubender Blick auf die Berge!"
    ],
    "en": [
      "Located on the Avoriaz plateau, facing the tennis courts, Le Yéti welcomes you all year round on its large sunny terrace or in its warm and cozy dining room. Brasserie-style cuisine, a friendly atmosphere, and stunning mountain views await!"
    ],
    "it": [
      "Situato sull'altopiano di Avoriaz, di fronte ai campi da tennis. Le Yéti vi accoglie tutto l'anno sulla sua grande terrazza soleggiata o nella sua accogliente sala da pranzo. Cucina in stile brasserie, atmosfera amichevole e splendida vista sulle montagne!"
    ],
    "fr": [
      "Situé sur le plateau d’Avoriaz et face aux terrains de tennis. Le Yéti vous accueille toute l’année sur sa grande terrasse ensoleillée ou dans sa salle chaleureuse. Cuisine de brasserie, cadre convivial et vue imprenable sur les montagnes !"
    ],
    "es": [
      "Situado en la meseta de Avoriaz, frente a las pistas de tenis. Le Yéti le recibe todo el año en su gran terraza soleada o en su acogedor comedor. Cocina de brasserie, ambiente acogedor y magníficas vistas a la montaña"
    ],
    "nl": [
      "Gelegen op het plateau van Avoriaz, tegenover de tennisbanen, heet Le Yéti je het hele jaar door welkom op het grote zonnige terras of in de warme, gezellige eetzaal. Brasseriegerechten, een gemoedelijke sfeer en een adembenemend uitzicht op de bergen!"
    ]
  },
  "rdfs:label": {
    "en": [
      "Le Yéti Restaurant"
    ],
    "fr": [
      "Restaurant Le Yéti"
    ],
    "nl": [
      "Restaurant Le Yéti"
    ]
  },
