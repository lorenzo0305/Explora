  "rdfs:comment": {
    "de": [
      "Produzent von Erdbeeren und Gemüse in Selbstpflückung auf dem Feld. Selbstpflücken von Erdbeeren verschiedener Sorten im Freiland. Eröffnung voraussichtlich Ende Mai bis Anfang Juli, je nach Wetter."
    ],
    "en": [
      "Producer of strawberries and free-range vegetables in the field. Self-service picking of strawberries of different varieties in the field. Open from the end of May to the beginning of July depending on the weather."
    ],
    "it": [
      "Produttore di fragole e ortaggi in campo che si auto-raccoglie. Auto-raccolta di fragole in campo di diverse varietà. L'apertura è prevista per la fine di maggio fino all'inizio di luglio, a seconda del tempo."
    ],
    "fr": [
      "Producteur de fraises et légumes en libre cueillette au champ. Cueillette de fraises pleine terre de différentes variétés en libre service. Ouverture à prévoir fin mai jusque début juillet selon le temps."
    ],
    "es": [
      "Productor de fresas y hortalizas de cosecha propia en el campo. Recogida automática de fresas en el campo de diferentes variedades. La apertura está prevista para finales de mayo hasta principios de julio, dependiendo del tiempo."
    ],
    "nl": [
      "Producent van zelfplukkende aardbeien en groenten op het veld. Zelfpluk van aardbeien op het veld van verschillende rassen. Geopend van eind mei tot begin juli, afhankelijk van het weer."
    ]
  },
