  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/af0aed96-a2b4-3aee-9ee2-90ebd5a572b4",
      "dc:description": {
        "de": [
          "- Im Rahmen des Festes des Meeres der Küsten -\nHobbymaler aus der Region stellen ihre Werke aus. Treffen Sie sie und teilen Sie ihre Leidenschaft von 10 bis 18 Uhr."
        ],
        "en": [
          "- As part of the coastal sea festival -\nLocal amateur painters exhibit their creations. Come and meet them and share their passion from 10am to 6pm."
        ],
        "it": [
          "- Nell'ambito del festival del mare costiero -\nI pittori dilettanti della regione esporranno le loro opere. Venite a conoscerli e a condividere la loro passione dalle 10.00 alle 18.00."
        ],
        "fr": [
          "- Dans le cadre de la fête de la mer des littoraux - \nLes artistes peintres amateurs de la région exposent leurs créations. Venez les rencontrer et partager leur passion de 10h à 18h."
        ],
        "es": [
          "- En el marco del festival marítimo costero -\nPintores aficionados de la región expondrán sus obras. Venga a conocerlos y a compartir su pasión de 10:00 a 18:00."
        ],
        "nl": [
          "- Als onderdeel van het kustzeefestival\nZullen amateurschilders uit de regio hun werk tentoonstellen. Kom ze ontmoeten en deel hun passie van 10.00 tot 18.00 uur."
        ]
      },
