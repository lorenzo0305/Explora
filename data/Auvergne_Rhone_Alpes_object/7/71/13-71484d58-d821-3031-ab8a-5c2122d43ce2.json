  "rdfs:comment": {
    "de": [
      "Neuheit Mountainbike im Nordischen Skigebiet! Nutzen Sie die 11 spielerischen Module für Groß und Klein und machen Sie spielerisch Fortschritte. Freier Zugang unter der Verantwortung eines Erwachsenen. Helmpflicht."
    ],
    "en": [
      "At the Nordic Area, enjoy 11 playful mountain biking modules for all ages. Learn and improve while having fun ! Free access under adult supervision. Helmets required."
    ],
    "it": [
      "Nuove mountain bike nell'area nordica! Godetevi 11 moduli divertenti per grandi e piccini e fate progressi divertendovi. Accesso libero sotto la responsabilità di un adulto. Casco obbligatorio."
    ],
    "fr": [
      "Nouveauté VTT au domaine nordique ! Profitez de 11 modules ludiques pour petits et grands, et progressez en vous amusant. Accès libre sous la responsabilité d’un adulte. Casque obligatoire."
    ],
    "es": [
      "¡Nuevo ciclismo de montaña en la zona nórdica! Disfruta de 11 divertidos módulos para grandes y pequeños, y progresa mientras te diviertes. Acceso libre bajo la responsabilidad de un adulto. Casco obligatorio."
    ],
    "nl": [
      "Nieuw mountainbiken in Scandinavië! Geniet van 11 leuke modules voor jong en oud, en boek vooruitgang terwijl je plezier hebt. Gratis toegang onder de verantwoordelijkheid van een volwassene. Helm verplicht."
    ]
  },
