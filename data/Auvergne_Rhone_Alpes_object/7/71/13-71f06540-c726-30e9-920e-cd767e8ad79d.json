  "rdfs:comment": {
    "de": [
      "Marie-Aline bietet Ihnen ihre gepflückte Ware und ihre lokale Produktion von Gemüse, Gewürzen für die Küche und aromatischen Pflanzen an, made in Auris!\r\nLassen Sie sich verführen, Ihre Geschmacksknospen werden es Ihnen mit Sicherheit danken."
    ],
    "en": [
      "Marie-Aline sells her locally-picked and produced vegetables, kitchen condiments and herbs, made in Auris!\r\nLet yourself be tempted, your taste buds are sure to thank you."
    ],
    "it": [
      "Marie-Aline vi propone la sua raccolta e la sua produzione locale di verdure, condimenti per la cucina e piante aromatiche, made in Auris!\r\nLasciatevi tentare, le vostre papille gustative vi ringrazieranno di sicuro."
    ],
    "fr": [
      "Marie-Aline vous propose ses cueillettes et sa production locale de légumes, de condiments pour la cuisine et de plantes aromatiques, made in Auris ! \r\nLaissez-vous tenter, vos papilles vous en remercieront à coup sûr."
    ],
    "es": [
      "Marie-Aline le ofrece sus cosechas y su producción local de verduras, condimentos para la cocina y plantas aromáticas, ¡hechas en Auris!\r\nDéjate tentar, tus papilas gustativas te lo agradecerán seguro."
    ],
    "nl": [
      "Marie-Aline biedt je haar lokaal geplukte en geproduceerde groenten, keukenkruiden en aromatische planten, gemaakt in Auris!\r\nGeef toe aan de verleiding, je smaakpapillen zullen je dankbaar zijn."
    ]
  },
  "rdfs:label": {
