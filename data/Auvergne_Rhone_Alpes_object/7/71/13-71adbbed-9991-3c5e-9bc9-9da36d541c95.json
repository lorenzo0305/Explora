  "rdfs:comment": {
    "de": [
      "Dieser Grasstrand verfügt über Einrichtungen, die ihn zu einem idealen Spielplatz für alle machen. Er ist leicht mit dem Bus und direkt über die Fahrradpromenade erreichbar."
    ],
    "en": [
      "This grassy beach has facilities that make it an ideal playground for everyone. Easily accessible by bus and directly from the cycle path."
    ],
    "it": [
      "Questa spiaggia erbosa è dotata di strutture che la rendono un parco giochi ideale per tutti. Facilmente raggiungibile in autobus e direttamente dalla pista ciclabile."
    ],
    "fr": [
      "Cette plage d'herbe bénéficie d'équipements qui en font un terrain de jeux idéal pour tous. Accessible facilement en bus et directement par la promenade cyclable."
    ],
    "es": [
      "Esta playa de hierba cuenta con instalaciones que la convierten en un lugar de recreo ideal para todos. Fácilmente accesible en autobús y directamente desde el carril bici."
    ],
    "nl": [
      "Dit grasstrand heeft voorzieningen die het een ideaal speelterrein maken voor iedereen. Gemakkelijk bereikbaar met de bus en direct vanaf het fietspad."
    ]
  },
