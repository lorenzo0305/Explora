  "rdfs:comment": {
    "de": [
      "Entdecken Sie das vertikale Oisans: betreutes Klettern und Klettersteige.\r\nIm Winter bietet Ihnen Christelle die Möglichkeit, das alpine Skifahren und Skitourengehen mit Engagement zu entdecken"
    ],
    "en": [
      "Discover the Oisans verticalities: rock climbs and via ferratas!\nAt winter, Christelle invites you to discover alpine skiing and ski touring."
    ],
    "it": [
      "Scoprite l'Oisans verticale: arrampicate e vie ferrate supervisionate.\r\nIn inverno, Christelle vi offre la possibilità di scoprire lo sci alpino e lo sci alpinismo con impegno"
    ],
    "fr": [
      "Découvrez l'Oisans vertical : escalades et via ferratas encadrées.\r\nEn hiver, Christelle vous propose de découvrir le ski alpin et la randonnée à ski à l'engagement"
    ],
    "nl": [
      "Ontdek het verticale Oisans : klimmen en via ferrata's onder begeleiding.\r\nIn de winter stelt Christelle u skilessen voor."
    ],
    "es": [
      "Descubra el Oisans vertical: escalada supervisada y vías ferratas.\r\nEn invierno, Christelle te propone descubrir el esquí alpino y el esquí de travesía con compromiso"
    ]
  },
