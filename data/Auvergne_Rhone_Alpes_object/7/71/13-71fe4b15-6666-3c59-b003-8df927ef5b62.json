  "rdfs:comment": {
    "de": [
      "Die Pizzeria Le Tour de Pizz, seit 2005 in Saint-Eloy-les-Mines ansässig, bietet jeden Tag köstliche hausgemachte Pizzen!"
    ],
    "en": [
      "The pizzeria Le tour de Pizz, settled Saint-Eloy-les-Mines since 2005 offers delicious homemade pizzas everyday!"
    ],
    "it": [
      "La pizzeria Le Tour de Pizz, con sede a St-Eloy-les-Mines (63) dal 2005, vi invita a venire a gustare le sue pizze fatte in casa 7 giorni su 7!\r\nIl venerdì è a Combronde."
    ],
    "fr": [
      "La pizzeria Le Tour de Pizz, installée à St-Eloy-les-Mines (63) depuis 2005, vous propose de venir savourer ses pizzas artisanales 7 jours sur 7 !\r\nLe vendredi c'est à Combronde."
    ],
    "es": [
      "La pizzería Le Tour de Pizz, situada en St-Eloy-les-Mines (63) desde 2005, le invita a disfrutar de sus pizzas caseras los 7 días de la semana\r\nLos viernes está en Combronde."
    ],
    "nl": [
      "De pizzeria Le Tour de Pizz, sinds 2005 gevestigd in St-Eloy-les-Mines (63), nodigt je uit om 7 dagen per week te komen genieten van zijn huisgemaakte pizza's!\r\nOp vrijdag is het in Combronde."
    ]
  },
