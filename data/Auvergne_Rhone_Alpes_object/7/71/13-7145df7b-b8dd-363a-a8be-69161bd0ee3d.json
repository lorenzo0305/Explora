  "rdfs:comment": {
    "de": [
      "Océane und Florian bieten Ihnen eine gepflegte traditionelle Küche aus Rohprodukten in einer gemütlichen Umgebung. Es besteht die Möglichkeit, unsere schöne Terrasse auf dem Platz der mittelalterlichen Stadt Conflans zu nutzen."
    ],
    "en": [
      "Océane and Florian offer you traditional, carefully prepared cuisine using local produce, in a warm and welcoming setting. You can also enjoy our terrace on the square in the medieval town of Conflans."
    ],
    "it": [
      "Océane e Florian propongono una cucina tradizionale, preparata con cura e basata su prodotti freschi, in un'atmosfera calda e accogliente. Potrete anche godervi la nostra bella terrazza sulla piazza della città medievale di Conflans."
    ],
    "fr": [
      "Océane et Florian vous proposent une cuisine traditionnelle soignée, à partir de produits bruts, dans un cadre chaleureux. Possibilité de profiter de notre belle terrasse sur la place de la cité médiévale de Conflans."
    ],
    "es": [
      "Océane y Florian sirven una cocina tradicional y cuidada, basada en productos frescos, en un ambiente cálido y acogedor. También podrá disfrutar de nuestra encantadora terraza en la plaza de la ciudad medieval de Conflans."
    ],
    "nl": [
      "Océane en Florian serveren traditionele, zorgvuldig bereide gerechten op basis van verse producten, in een warme en vriendelijke sfeer. Je kunt ook genieten van ons mooie terras op het plein in het middeleeuwse stadje Conflans."
    ]
  },
  "rdfs:label": {
    "en": [
      "Ô Besoin d'Air"
    ],
    "fr": [
      "Ô Besoin d'Air"
    ]
  },
