  "rdfs:comment": {
    "de": [
      "Der Bauernhof „le soleil des p'tits bleus“ hat sich auf den biologischen Anbau von Arnika spezialisiert. Er bietet Direktverkauf von Arnikaprodukten, Saatgut und zu 100 % in der Auvergne angebauten Arnikapflanzen an."
    ],
    "en": [
      "The \"le soleil des p'tits bleus\" farm specializes in the organic cultivation of Arnica. It offers direct sales of Arnica-based products, seeds, and 100% Auvergne-grown Arnica plants."
    ],
    "it": [
      "La ferme du soleil des p?tits bleus è specializzata nella coltivazione biologica dell'Arnica. Offre la vendita diretta di prodotti a base di Arnica e di semi e piante di Arnica 100% Auvergne."
    ],
    "fr": [
      "La ferme du soleil des p’tits bleus est spécialisée dans la culture d'Arnica en agriculture biologique. Elle propose en vente directe des produits à base d'Arnica, des semences et plants d’Arnica 100% auvergnate."
    ],
    "nl": [
      "La ferme du soleil des pits bleus is gespecialiseerd in de biologische teelt van Arnica. Het biedt directe verkoop van producten op basis van Arnica en zaden en planten van 100% Arnica uit de Auvergne."
    ],
    "es": [
      "La ferme du soleil des p?tits bleus está especializada en el cultivo ecológico del árnica. Ofrece venta directa de productos a base de árnica y semillas y plantas de árnica 100% de Auvernia."
    ]
  },
  "rdfs:label": {
    "de": [
      "Farm Die Sonne der blauen Kinder"
    ],
    "en": [
      "Farm The sun of the little blue"
    ],
    "fr": [
      "Ferme Le soleil des p’tits bleus"
    ]
  },
