      "rdfs:comment": {
        "de": [
          "Als handwerkliche Kaffeerösterei in Abbeville seit 1920 biete ich Ihnen eine große Auswahl an ausgewählten Kaffeesorten, aber auch Tees, regionale und lokale Produkte.\nFreude bereiten, sich selbst Freude bereiten. English spoken."
        ],
        "en": [
          "An Abbevillois artisan roaster since 1920, I offer a wide choice of selected coffees as well as teas and regional and local products.\nTreat yourself, treat yourself. English spoken."
        ],
        "it": [
          "Torrefattore artigianale di Abbevillois dal 1920, vi offro un'ampia scelta di caffè selezionati, oltre a tè e prodotti regionali e locali.\nRegalatevi, regalatevi. Si parla inglese."
        ],
        "fr": [
          "Artisan torréfacteur abbevillois depuis 1920, je vous propose un large choix de cafés sélectionnés mais également de thés, produits régionaux et locaux.\nFaire plaisir, se faire plaisir. English spoken."
        ],
        "es": [
          "Tostador artesano de Abbevillois desde 1920, le propongo una amplia selección de cafés, tés y productos regionales y locales.\nDese un capricho. Se habla inglés."
        ],
        "nl": [
          "Als ambachtelijke brander uit Abbevillois sinds 1920 bied ik je een ruime keuze aan geselecteerde koffies, thee en regionale en lokale producten.\nVerwen uzelf, trakteer uzelf. Engels gesproken."
        ]
      },
