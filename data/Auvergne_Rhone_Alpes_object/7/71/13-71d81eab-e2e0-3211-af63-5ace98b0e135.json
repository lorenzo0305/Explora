  "rdfs:comment": {
    "de": [
      "Bauernladen auf dem Bauernhof Les Praves. Biologische und lokale Produkte. Gemüse, Obst, Joghurt/Ziegenkäse, Terrinen, Hühner, Ei, Brot, verarbeitete Produkte aus aromatischen und medizinischen Pflanzen, Honig..."
    ],
    "en": [
      "Producers' store on the Praves farm. Organic and local products. Vegetables, fruits, yogurts/goat cheeses, terrines, chickens, eggs, bread, processed aromatic and medicinal plant products, honey.."
    ],
    "it": [
      "Negozio in fattoria presso l'azienda agricola Praves. Prodotti biologici e locali. Ortaggi, frutta, yogurt/formaggi di capra, terrine, polli, uova, pane, prodotti trasformati da piante aromatiche e medicinali, miele..."
    ],
    "fr": [
      "Magasin de producteurs sur la ferme des Praves. Produits bio et locaux. Légumes, fruits, yaourts/ fromages de chèvre, terrines, poules, œuf, pain, produits transformés de plantes aromatiques et médicinales, miel.."
    ],
    "es": [
      "Tienda en la granja de Praves. Productos ecológicos y locales. Verduras, frutas, yogures/quesos de cabra, terrinas, pollos, huevos, pan, productos elaborados a partir de plantas aromáticas y medicinales, miel..."
    ],
    "nl": [
      "Produzentenladen auf dem Praves-Hof. Bio- und lokale Produkte. Gemüse, Obst, Joghurt/Ziegenkäse, Terrinen, Hühner, Eier, Brot, verarbeitete Aroma- und Heilpflanzenprodukte, Honig."
    ]
