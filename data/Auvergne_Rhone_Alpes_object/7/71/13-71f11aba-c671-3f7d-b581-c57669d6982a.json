  "rdfs:comment": {
    "de": [
      "Dieser sehr schöne Felsen, der zahlreiche schwierige und sehr schwierige Routen bietet, ist ein Muss für alle Sportkletterer."
    ],
    "en": [
      "This beautiful cliff, with its many difficult and very difficult routes, is a must for sport climbing enthusiasts."
    ],
    "it": [
      "Questa bellissima falesia, con le sue numerose vie difficili e molto difficili, è un must per gli appassionati di arrampicata sportiva."
    ],
    "fr": [
      "Cette très belle falaise qui propose de nombreuses voies difficiles et très difficiles, est un lieu incontournable pour les passionnés d’escalade sportive."
    ],
    "es": [
      "Este hermoso peñasco, con sus numerosas rutas de dificultad alta y muy alta, es una visita obligada para los aficionados a la escalada deportiva."
    ],
