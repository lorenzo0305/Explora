  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/162c780e-38f1-39f2-94c2-28dfcc3b8f07",
      "dc:description": {
        "de": [
          "Friseur und Barbier, Mann, Frau, Kind Retro-Stil verrückte Atmosphäre.\n\nDienstag bis Freitag: 9h/19h nonstop\nSamstag: 9h/18h nonstop\nMontags nach Vereinbarung geöffnet"
        ],
        "en": [
          "Hairdressing and barbering salon, for men, women and children, retro style, crazy atmosphere.\n\nTuesday to Friday: 9h/19h non-stop\nSaturday: 9h/18h non-stop\nOpen Mondays by appointment"
        ],
        "it": [
          "Salone di parrucchieri e barbieri, uomini, donne, bambini, stile retrò, atmosfera folle.\n\nDa martedì a venerdì: 9.00/7.00 ininterrottamente\nSabato: 9.00/18.00 non stop\nAperto il lunedì su appuntamento"
        ],
        "fr": [
          "Salon de coiffure et barbier, homme, femme, enfant style retro ambiance de folie.\n\nDu mardi au vendredi : 9h/19h non-stop\nSamedi : 9h/18h non-stop\nOuverture le lundi sur rdv"
        ],
        "es": [
          "Peluquería y barbería, hombres, mujeres, niños, estilo retro, ambiente loco.\n\nDe martes a viernes: de 9.00 a 19.00 h ininterrumpidamente\nSábado: 9h-18h sin interrupción\nAbierto los lunes con cita previa"
        ],
        "nl": [
          "Kapsalon en barbier, mannen, vrouwen, kinderen, retrostijl, gekke sfeer.\n\nDinsdag tot vrijdag: 9u/7u non-stop\nZaterdag: 9u/6u non-stop\nMaandag op afspraak geopend"
        ]
      },
      "@type": [
        "Description"
      ],
