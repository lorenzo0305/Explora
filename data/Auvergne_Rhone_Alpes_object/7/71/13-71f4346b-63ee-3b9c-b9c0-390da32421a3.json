  "rdfs:comment": {
    "de": [
      "La Flambée ist das italienische Restaurant in Meribel. Mit seinen Pizzen aus dem Holzofen, seiner umfangreichen Speisekarte und seinem erstaunlichen Weinkeller ist es ein Muss, Italien zu entdecken. Natürlich erwarten Sie auch savoyische Spezialitäten in diesem zweistöckigen Chalet-Dekor."
    ],
    "en": [
      "The Flambée is the Italian restaurant of Meribel; must-be place with its wood fire baked pizzas, its impressive menu and its amazing cellar to discover the Italy. Of course Savoyard specialities also await you in this chalet style on 2 floors."
    ],
    "it": [
      "La Flambée è il ristorante italiano di Meribel; un must con le sue pizze cotte a legna, il suo ampio menu e la sua incredibile cantina per scoprire l'Italia. Naturalmente, anche le specialità savoiarde vi aspettano in questo chalet su 2 piani."
    ],
    "fr": [
      "La Flambée est le restaurant italien de Meribel; lieu incontournable avec ses pizzas au four à bois, sa large carte et son étonnante cave pour découvrir l'Italie. Bien sûr les spécialités savoyardes vous attendent aussi dans ce décor chalet sur 2 étages."
    ],
    "nl": [
      "La Flambée is het Italiaanse restaurant van Meribel; een must met zijn houtgestookte pizza's, zijn uitgebreide kaart en zijn geweldige kelder om Italië te ontdekken. Natuurlijk wachten ook Savoyaardse specialiteiten op u in dit chalet met 2 verdiepingen."
    ],
    "es": [
      "La Flambée es el restaurante italiano de Meribel; una visita obligada con sus pizzas a la leña, su amplia carta y su increíble bodega para descubrir Italia. Por supuesto, las especialidades de Saboya también le esperan en este chalet de 2 plantas."
    ]
  },
