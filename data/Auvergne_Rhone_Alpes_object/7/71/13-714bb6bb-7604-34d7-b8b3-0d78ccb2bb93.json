  "rdfs:comment": {
    "de": [
      "Das 3 km von Langeac entfernte Hotel les Rives d'Allier liegt am Ufer des Flusses Allier und an der Touristenroute Lavoûte-Chilhac. Es bietet Ihnen 22 komfortable Nichtraucherzimmer und eine einfache und schmackhafte Küche.\r\nBeheizter Swimmingpool."
    ],
    "en": [
      "Hotel 3 kilometres from Langeac. Heated swimming pool.\r\nThe Hotel les Rives d'Allier, located on the banks of the river Allier and on the tourist road to Lavoûte-Chilhac, offers 22 comfortable non-smoking rooms as well as a simple and tasty cuisine (Catering only for hotel guests: dinner and breakfast. No catering at lunchtime)."
    ],
    "it": [
      "A 3 km da Langeac, l'Hôtel les Rives d'Allier, sulle rive del fiume Allier e sull'itinerario turistico Lavoûte-Chilhac, offre 22 camere confortevoli e non fumatori e una cucina semplice e gustosa.\r\nPiscina riscaldata."
    ],
    "fr": [
      "A 3 kilomètres de Langeac, l'Hôtel les Rives d'Allier, situé sur les bords de la rivière Allier et sur la route touristique de Lavoûte-Chilhac, vous propose 22 chambres confortables et non fumeur ainsi qu'une cuisine simple et goûteuse.\r\nPiscine chauffée."
    ],
    "nl": [
      "Op 3 kilometer van Langeac biedt Hôtel les Rives d'Allier, aan de oever van de rivier de Allier en op de toeristische route Lavoûte-Chilhac, 22 comfortabele rookvrije kamers en een eenvoudige, smakelijke keuken.\r\nVerwarmd zwembad."
    ],
    "es": [
      "A 3 kilómetros de Langeac, el Hôtel les Rives d'Allier, a orillas del río Allier y en la ruta turística Lavoûte-Chilhac, ofrece 22 cómodas habitaciones para no fumadores y una cocina sencilla y sabrosa.\r\nPiscina climatizada."
    ]
  },
  "rdfs:label": {
    "en": [
      "Les Rives d'Allier"
    ],
    "fr": [
      "Les Rives d'Allier"
    ]
  },
