  "rdfs:comment": {
    "de": [
      "Als Bergbegleiter & Geschichtenerzähler ist Patrick Vermittler für den Geoparc du Chablais. Folgen Sie ihm, um die Kohlemine von Bonnevaux und die kleine Tierwelt des Flusses zu entdecken, und hören Sie ihm zu, wenn er bei Einbruch der Dunkelheit Legenden und Märchen erzählt."
    ],
    "en": [
      "Mountain guide and storyteller, Patrick is also mediator for the Chablais Geopark. Follow him to discover the Bonnevaux coal mine or the river’s little animal world and listen to him recount the legends and tales at nightfall."
    ],
    "it": [
      "Guida alpina e narratore, Patrick è un mediatore del Geoparco dello Chablais. Seguitelo alla scoperta della miniera di carbone di Bonnevaux, del piccolo mondo animale del fiume e ascoltatelo raccontare leggende e storie al calar del sole."
    ],
    "fr": [
      "Accompagnateur en montagne & conteur, Patrick est médiateur pour le Géoparc du Chablais. Suivez-le pour découvrir la mine de charbon de Bonnevaux, le petit monde animal de la rivière et écoutez-le raconter les légendes et les contes à la nuit tombée."
    ],
    "nl": [
      "Patrick is bergleider en verhalenverteller en bemiddelaar voor het Chablais Geopark. Volg hem om de kolenmijn van Bonnevaux te ontdekken, de kleine dierenwereld van de rivier en luister hoe hij 's avonds legendes en verhalen vertelt."
    ],
    "es": [
      "Montañero y cuentacuentos, Patrick es mediador del Geoparque del Chablais. Síguele para descubrir la mina de carbón de Bonnevaux, el pequeño mundo animal del río y escúchale contar leyendas y cuentos al caer la noche."
    ]
  },
  "rdfs:label": {
    "en": [
