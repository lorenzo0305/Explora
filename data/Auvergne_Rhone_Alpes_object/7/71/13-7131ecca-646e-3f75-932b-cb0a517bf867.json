  "rdfs:comment": {
    "de": [
      "Raffinesse, Eleganz und Gastfreundschaft machen dieses Gourmetrestaurant zu einem sehr schönen Tisch in der Drôme. Die beiden BERTRAND-Brüder führen das Haus mit Professionalität und Leidenschaft, gedämpfter Dekoration und einer ehrlichen, geschmackvollen Küche."
    ],
    "en": [
      "Refinement, elegance and conviviality make this gastronomic restaurant one of the finest in the Drôme. The two BERTRAND brothers run the restaurant with professionalism and passion, offering hushed decor and sincere, tasteful cuisine."
    ],
    "it": [
      "Raffinatezza, eleganza e convivialità fanno di questo ristorante gastronomico uno dei migliori della Drôme. I due fratelli BERTRAND gestiscono il ristorante con professionalità e passione, con un arredamento accogliente e una cucina sincera e di gusto."
    ],
    "fr": [
      "Raffinement, élégance et convivialité font de ce restaurant gastronomique une très belle table de la Drôme. Les deux frères BERTRAND dirigent la Maison avec professionnalisme et passion, décoration feutrée, cuisine sincère et de goût."
    ],
    "nl": [
      "Verfijning, elegantie en gezelligheid maken dit gastronomische restaurant tot een van de beste van de Drôme. De twee broers BERTRAND runnen het restaurant met professionaliteit en passie, met een gezellig decor en een oprechte, smaakvolle keuken."
    ],
    "es": [
      "Refinamiento, elegancia y convivencia hacen de este restaurante gastronómico uno de los mejores de la Drôme. Los dos hermanos BERTRAND dirigen el restaurante con profesionalidad y pasión, con una decoración acogedora y una cocina sincera y de buen gusto."
    ]
  },
