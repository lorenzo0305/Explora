  "rdfs:comment": {
    "de": [
      "Das sanfte Relief und die Spuren der Vergangenheit bringen den ganzen Charme der Gemeinde Estivareilles zur Geltung und bieten Wanderern einen schönen, sportlichen Spaziergang."
    ],
    "en": [
      "The gentle relief and traces of the past enhance the charm of the Estivareilles commune and make it a great place for hikers."
    ],
    "it": [
      "Il paesaggio dolce e le tracce del passato evidenziano il fascino di Estivareilles e ne fanno un luogo ideale per gli escursionisti."
    ],
    "fr": [
      "Le relief doux et les traces du passé mettent en valeur tout le charme de la commune d’Estivareilles et offrent une belle balade sportive aux randonneurs."
    ],
    "es": [
      "La suavidad del terreno y las huellas del pasado realzan el encanto de Estivareilles y lo convierten en un lugar ideal para los senderistas."
    ],
    "nl": [
      "Het glooiende landschap en de sporen uit het verleden benadrukken de charme van Estivareilles en maken het een geweldige plek voor wandelaars."
    ]
  },
