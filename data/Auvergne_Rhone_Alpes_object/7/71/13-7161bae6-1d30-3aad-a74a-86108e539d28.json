  "rdfs:comment": {
    "de": [
      "Evolution2 Peisey-Vallandry ist eine kleine, familiäre Skischule mit qualifizierten Skilehrern, die sich auf maßgeschneiderte Privatkurse spezialisiert haben. Sie bietet individuelle Betreuung und eine Vielzahl an winterlichen Outdoor-Aktivitäten – alles in absoluter Sicherheit."
    ],
    "en": [
      "Evolution2 Peisey-Vallandry is a small, friendly ski school with qualified instructors specializing in tailor-made private lessons. It offers personalized support and a variety of winter outdoor activities, all in complete safety."
    ],
    "it": [
      "Evolution2 Peisey-Vallandry è una scuola di sci a misura d'uomo, con istruttori qualificati specializzati in lezioni private su misura. Offre una guida personalizzata e una varietà di attività invernali sicure all'aperto."
    ],
    "fr": [
      "Evolution2 Peisey-Vallandry est une école de ski à taille humaine, avec des moniteurs diplômés spécialisés dans les cours privés sur mesure. Elle propose un accompagnement personnalisé et des activités outdoor hivernales variées, en toute sécurité."
    ],
    "nl": [
      "Evolution2 Peisey-Vallandry is een skischool op mensenmaat, met gekwalificeerde instructeurs die gespecialiseerd zijn in privélessen op maat. Het biedt persoonlijke begeleiding en een verscheidenheid aan veilige buitenactiviteiten in de winter."
    ],
    "es": [
      "Evolution2 Peisey-Vallandry es una escuela de esquí a escala humana, con monitores cualificados especializados en clases particulares a medida. Ofrece orientación personalizada y una gran variedad de actividades invernales al aire libre y seguras."
    ]
  },
  "rdfs:label": {
