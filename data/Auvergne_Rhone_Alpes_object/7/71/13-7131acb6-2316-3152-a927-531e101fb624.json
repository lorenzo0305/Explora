  "rdfs:comment": {
    "de": [
      "Die Snackbar befindet sich in der Nähe des Campingplatzes und des städtischen Schwimmbads, 5 Minuten vom Dorf entfernt. Auf drei schattigen Terrassen können Sie den Sommer genießen! Schnellrestaurants: Burger, Salate, Gegrilltes ..."
    ],
    "en": [
      "The snack is located 5 minutes’ walk from the village, near the campsite and the municipal swimming pool. It has three shaded terraces where you can enjoy the summer! Fast food: burgers, salads, grills…"
    ],
    "it": [
      "Lo Snack Bar si trova vicino al campeggio e alla piscina comunale, a 5 minuti dal villaggio. Tre terrazze ombreggiate dove godersi l'estate! Fast food: hamburger, insalate, grigliate?"
    ],
    "fr": [
      "Le Snack est situé à proximité du camping et de la piscine municipale à 5 min du village. Trois terrasses ombragées où vous pourrez profiter de l'été ! Restauration rapide : burgers, salades, grillades …"
    ],
    "es": [
      "El Snack Bar está situado cerca del camping y de la piscina municipal, a 5 minutos del pueblo. Tres terrazas a la sombra para disfrutar del verano Comida rápida: hamburguesas, ensaladas, parrilladas?"
    ],
    "nl": [
      "De snackbar bevindt zich vlakbij de camping en het gemeentelijk zwembad, op 5 minuten van het dorp. Drie schaduwrijke terrassen waar u kunt genieten van de zomer! Fast food: hamburgers, salades, gegrild vlees..."
    ]
  },
  "rdfs:label": {
    "en": [
      "Chez Eve, pool snack"
    ],
    "fr": [
      "Chez Eve, snack de la piscine"
    ],
    "nl": [
      "Bij Eve, snack van het zwembad"
    ]
  },
