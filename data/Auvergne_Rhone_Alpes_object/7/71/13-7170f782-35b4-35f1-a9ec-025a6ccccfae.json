  "rdfs:comment": {
    "de": [
      "Verbringen Sie einen geselligen Moment mit Freunden des Vereins hinter den Kulissen des Elabo. Alle sind herzlich willkommen: Nachbarn, Freiwillige, Partner, Troubadoure und Neugierige!"
    ],
    "en": [
      "Come and spend a convivial moment with friends of the association, backstage at the élabo. Everyone's welcome: neighbors, volunteers, partners, troubadours and the curious!"
    ],
    "it": [
      "Venite a trascorrere un momento di convivialità con gli amici dell'associazione nel backstage dell'élabo. Tutti sono i benvenuti: vicini, volontari, partner, trovatori e curiosi!"
    ],
    "fr": [
      "Venez passer un moment de convivialité entre ami.e.s de l'asso dans les coulisses de l'élabo. Tout le monde est bienvenu : voisins, bénévoles, partenaires, troubadours et curieux !"
    ],
    "es": [
      "Venga a pasar un rato agradable con los amigos de la asociación entre bastidores en el élabo. Todos son bienvenidos: vecinos, voluntarios, socios, trovadores y curiosos"
    ],
    "nl": [
      "Kom een gezellig moment doorbrengen met vrienden van de vereniging achter de schermen van het élabo. Iedereen is welkom: buren, vrijwilligers, partners, troubadours en nieuwsgierigen!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les apéros de Paulette - \"Dans les coulisses de l'Elabo\""
    ]
  },
