  "rdfs:comment": {
    "de": [
      "Wanderungen auf der Hochebene der Ardèche von 1 Stunde, 1 1/2 Stunden, 2 Stunden, 1/2 Tag. Kurse für Kinder und Erwachsene. Verschiedene Disziplinen, die von Pferdeprofis angeboten werden. Ab einem Alter von 7 Jahren.\r\nArbeit zu Fuß, Reittherapie.\r\nPonykurse und Ausritte ab 10 Monaten."
    ],
    "en": [
      "Walks on the Ardèche plateau of 1h, 1h1/2, 2 h, 1/2 day. Lessons for children and adults. Various disciplines taught by horse professionals. From age 7.\r\nWork on foot, equi-therapy.\r\nPony lessons and rides from 10 months."
    ],
    "it": [
      "Passeggiate di 1h, 1h1/2, 2h, 1/2 giornata sull'altopiano dell'Ardèche. Lezioni per bambini e adulti. Varie discipline proposte da professionisti del cavallo. Per bambini a partire dai 7 anni.\r\nLavoro a piedi, equiterapia.\r\nLezioni e passeggiate con i pony a partire da 10 mesi."
    ],
    "fr": [
      "Promenades sur plateau ardéchois de 1h, 1h1/2,  2 h, 1/2 journée. Cours enfants adultes. Diverses disciplines proposées par des  professionnels du cheval. A partir de 7 ans.\r\nTravail à pied, équi-thérapie.\r\nCours de poney et balade à partir de 10 mois."
    ],
    "nl": [
      "Wandelingen van 1u, 1u1/2, 2u, 1/2 dag op het plateau van de Ardèche. Lessen voor kinderen en volwassenen. Verschillende disciplines aangeboden door paardenprofessionals. Voor kinderen vanaf 7 jaar.\r\nWerk te voet, equi-therapie.\r\nPonylessen en ritten vanaf 10 maanden."
    ],
    "es": [
      "Paseos de 1h, 1h1/2, 2h, 1/2 día por la meseta de Ardèche. Clases para niños y adultos. Diversas disciplinas ofrecidas por profesionales del caballo. Para niños a partir de 7 años.\r\nTrabajo a pie, equiterapia.\r\nClases y paseos en poni a partir de 10 meses."
    ]
  },
