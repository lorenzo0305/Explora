  "rdfs:comment": {
    "de": [
      "Le Petit Vélo Rouge bietet den Verleih von Mountainbikes und Rennrädern sowie Reparaturen an.\r\nOrganisation von Ausflügen, die von diplomierten MCF-Lehrern im Gebiet der 3 Vallées und in Bozel betreut werden. Sie bieten individuell gestaltbare Ausflüge an."
    ],
    "en": [
      "Renting of mountain bike and cycling. Tour compagny on 3 Valleys and Bozel with an instructor."
    ],
    "it": [
      "Le Petit Vélo Rouge offre noleggio e riparazione di mountain bike e bici da strada.\r\nOrganizzazione di uscite con la supervisione di istruttori qualificati MCF nelle 3 valli e a Bozel. Offrono uscite personalizzate."
    ],
    "fr": [
      "Le Petit Vélo Rouge propose de la location VTT et vélo de route ainsi que de la réparation. \r\nOrganisation de sorties encadrées par des moniteurs diplômés MCF sur le domaine des 3 vallées et sur Bozel. Ils proposent des sorties personnalisable."
    ],
    "nl": [
      "Le Petit Vélo Rouge verhuurt en repareert mountainbikes en racefietsen.\r\nOrganisatie van tochten onder begeleiding van gediplomeerde MCF-instructeurs in de 3 valleien en Bozel. Ze bieden uitstapjes op maat."
    ],
    "es": [
      "Le Petit Vélo Rouge ofrece alquiler y reparación de bicicletas de montaña y de carretera.\r\nOrganización de salidas supervisadas por monitores MCF cualificados en los 3 valles y Bozel. Ofrecen salidas personalizadas."
    ]
  },
