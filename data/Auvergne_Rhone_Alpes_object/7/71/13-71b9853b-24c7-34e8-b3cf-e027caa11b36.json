  "rdfs:comment": {
    "de": [
      "Campero' s ist ein familiengeführter Foodtruck, der Camperos Malaguenos anbietet, typische warme Sandwiches aus Andalusien, die mit hochwertigen Produkten hausgemacht sind. Ein schnelles, originelles und freundliches Essen, ideal für Veranstaltungen und die Tourismussaison."
    ],
    "en": [
      "Campero's is a family-run food truck offering camperos malaguenos, hot sandwiches typical of Andalusia, homemade with quality products. Fast, original and friendly, ideal for events and the tourist season."
    ],
    "it": [
      "Campero's è un food truck a conduzione familiare che serve camperos malaguenos, panini caldi tipici dell'Andalusia, fatti in casa con prodotti di qualità. Un ristorante veloce, originale e accogliente, ideale per gli eventi e la stagione turistica."
    ],
    "fr": [
      "Campero' s est un food truck familial proposant des camperos malaguenos, sandwichs chauds typiques d'Andalousie, faits maison avec des produits de qualité. Une restauration rapide, originale et conviviale idéal pour évènements et saison touristique."
    ],
    "nl": [
      "Campero's is een foodtruck die door een familie wordt gerund en camperos malaguenos serveert, warme broodjes die typisch zijn voor Andalusië, zelfgemaakt met kwaliteitsproducten. Een snel, origineel en vriendelijk restaurant, ideaal voor evenementen en het toeristische seizoen."
    ],
    "es": [
      "Campero's es un food truck familiar que sirve camperos malagueños, bocadillos calientes típicos de Andalucía, elaborados artesanalmente con productos de calidad. Un restaurante rápido, original y acogedor, ideal para eventos y temporada turística."
    ]
  },
