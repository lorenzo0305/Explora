  "rdfs:comment": {
    "de": [
      "Bei Mangio Pizza finden Sie handwerklich hergestellte Pizzen nach sizilianischer Art.\r\nGenießen Sie einen einzigartigen Teig, der Sie auf eine Reise mitnehmen wird."
    ],
    "en": [
      "At Mangio Pizza, you will discover pizzas made in the traditional Sicilian style.\r\nEnjoy a unique dough that will take you on a journey."
    ],
    "it": [
      "Da Mangio Pizza scoprirete pizze fatte in casa in stile siciliano.\r\nGodetevi un impasto unico che vi porterà in viaggio."
    ],
    "fr": [
      "Chez Mangio Pizza, vous découvrirez des pizzas réalisées de façon artisanales à la Sicilienne.\r\nProfitez d’une pâte unique en son genre qui vous fera voyager."
    ],
    "es": [
      "En Mangio Pizza, descubrirá pizzas caseras al estilo siciliano.\r\nDisfrute de una masa única que le llevará de viaje."
    ],
    "nl": [
      "Bij Mangio Pizza ontdek je zelfgemaakte pizza's in Siciliaanse stijl.\r\nGeniet van een uniek deeg dat je meeneemt op reis."
    ]
  },
