  "rdfs:comment": {
    "de": [
      "Moi #purjus Les Halles ist ein Restaurant mit veganer Burger-Bar, Salatbar & Bar für kaltgepresste Bio-Säfte. Laktose- und glutenfreies Angebot. Ob Veganer, Vegetarier, Flexitarier oder Omnivore - hier findet jeder sein Glück!"
    ],
    "en": [
      "Moi #purjus Les Halles is a vegan burger bar, salad bar and cold-pressed organic juice bar. Lactose and gluten-free food. Whether you're a vegan, vegetarian, flexitarian or omnivore, you're sure to find something to your taste!"
    ],
    "it": [
      "Moi #purjus Les Halles è un burger bar vegano, un salad bar e un bar di succhi biologici spremuti a freddo. Senza lattosio e senza glutine. Che siate vegani, vegetariani, flexitariani o onnivori, ce n'è per tutti i gusti!"
    ],
    "fr": [
      "Moi #purjus Les Halles est un restaurant bar à burger vegan, bar à salade & bar à jus pressés à froid bio. Offre sans lactose et sans gluten. Que l’on soit végan, végétarien, fléxitarien ou omnivore, on trouve tous son bonheur !"
    ],
    "nl": [
      "Moi #purjus Les Halles is een veganistische burgerbar, saladebar & biologische koudgeperste sapbar. Lactosevrij en glutenvrij. Of je nu veganist, vegetariër, flexitariër of omnivoor bent, er is voor elk wat wils!"
    ],
    "es": [
      "Moi #purjus Les Halles es una hamburguesería vegana, un bar de ensaladas y un bar de zumos ecológicos prensados en frío. Sin lactosa y sin gluten. Ya sea vegano, vegetariano, flexitariano u omnívoro, hay algo para todos"
    ]
  },
  "rdfs:label": {
    "fr": [
      "MOI #purjus Corner Halles de la Martinière"
    ]
  },
