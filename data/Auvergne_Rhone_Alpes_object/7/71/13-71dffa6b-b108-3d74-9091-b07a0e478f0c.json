  "rdfs:comment": {
    "de": [
      "Unser Geschäft SKISET Ginabelle liegt mitten im Zentrum von Chamonix und bietet Ihnen Material für Groß und Klein und die Beratung durch unser spezialisiertes Team an"
    ],
    "en": [
      "Located in the heart of Chamonix, our SKISET Ginabelle store offers equipment for young and old and advice from our specialized team."
    ],
    "it": [
      "Situato nel centro di Chamonix, il nostro negozio SKISET Ginabelle offre attrezzature per grandi e piccini e la consulenza del nostro team specializzato."
    ],
    "fr": [
      "Situé en plein centre de Chamonix, notre magasin SKISET Ginabelle vous propose du matériel pour petits et grands et les conseils de notre équipe spécialisée"
    ],
    "es": [
      "Situada en el centro de Chamonix, nuestra tienda SKISET Ginabelle ofrece material para grandes y pequeños y el asesoramiento de nuestro equipo de especialistas."
    ],
    "nl": [
      "Onze SKISET Ginabelle winkel ligt in het centrum van Chamonix en biedt materiaal voor jong en oud en advies van ons gespecialiseerde team"
    ]
