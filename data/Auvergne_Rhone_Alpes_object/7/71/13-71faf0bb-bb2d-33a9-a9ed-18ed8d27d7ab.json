  "rdfs:comment": {
    "de": [
      "Gehen Sie in St. Vallier an Bord des Canotiers-Bootes und erleben Sie einen einzigartigen Moment auf der Rhône. Fahren Sie zwischen Arras und Andance, genießen Sie die Landschaft und die Schönheit des Flusses, während Sie Ihre Mahlzeit (kalt und einzigartig) in Gläsern serviert bekommen (0 Abfall und lokal)."
    ],
    "en": [
      "Embark in St Vallier on the Canotiers boat for a unique experience on the Rhône. Sail between Arras and Andance, taking in the scenery and beauty of the river while enjoying your meal (cold and unique) served in jars (0 waste and local)."
    ],
    "it": [
      "Salite a bordo del battello Canotiers a St Vallier per un'esperienza unica sul Rodano. Navigate tra Arras e Andance, godetevi il paesaggio e la bellezza del fiume mentre gustate il vostro pasto (freddo e unico) servito in barattoli (0 rifiuti e locale)."
    ],
    "fr": [
      "Embarquez à St Vallier sur le bateau des Canotiers pour un moment unique sur le Rhône. Naviguez entre Arras et Andance,  profitez du paysage et de la beauté du fleuve en dégustant votre repas (froid et unique) servi dans des bocaux (0 déchet et du local)."
    ],
    "es": [
      "Suba a bordo del barco Canotiers en St Vallier para vivir una experiencia única en el Ródano. Navegue entre Arras y Andance, disfrute del paisaje y la belleza del río mientras degusta su comida (fría y única) servida en tarros (0 residuos y local)."
    ],
    "nl": [
      "Kom aan boord van de Canotiers boot in St Vallier voor een unieke ervaring op de Rhône. Vaar tussen Arras en Andance, geniet van het landschap en de schoonheid van de rivier terwijl je proeft van je maaltijd (koud en uniek) geserveerd in kruiken (0 afval en lokaal)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Déjeuner-croisière sur le Rhône"
    ]
  },
