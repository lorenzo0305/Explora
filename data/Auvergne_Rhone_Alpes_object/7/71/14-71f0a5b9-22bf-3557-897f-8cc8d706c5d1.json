  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/30c34134-0d44-3575-a431-7875741d7d46",
      "dc:description": {
        "de": [
          "Neue Pizzeria in Stella-Plage in der Nähe des Deichs am Boulevard Labrasse.\n\nGeschäft ganzjährig geöffnet von 11:30 bis 14:00 Uhr und von 18:00 bis 21:30 Uhr täglich während der Schulferien.\nDonnerstag ganztägig und Freitagmittag außerhalb der Ferien geschlossen.\nLieferungen in einem Umkreis von 10 km."
        ],
        "en": [
          "New pizzeria in Stella-Plage near the sea wall on Boulevard Labrasse.\n\nOpen year-round from 11:30 a.m. to 2 p.m. and from 6 p.m. to 9:30 p.m. daily during school vacations.\nClosed all day Thursday and lunchtime Friday outside school vacations.\nDeliveries within a 10 km radius."
        ],
        "it": [
          "Nuova pizzeria a Stella-Plage, vicino al lungomare di Boulevard Labrasse.\n\nAperto tutto l'anno dalle 11.30 alle 14.00 e dalle 18.00 alle 21.30 tutti i giorni durante le vacanze scolastiche.\nChiuso tutto il giovedì e il venerdì a pranzo al di fuori delle vacanze scolastiche.\nConsegne nel raggio di 10 km."
        ],
        "fr": [
          "Nouvelle pizzeria à Stella-Plage près de la digue sur le Boulevard Labrasse.\n\nCommerce ouvert à l'année de 11h30 à 14h et de 18h à 21h30 tous les jours pendant les vacances scolaires.\nFermeture le jeudi toute la journée et vendredi midi hors vacances.\nLivraisons dans un rayon de 10 km."
        ],
        "es": [
          "Nueva pizzería en Stella-Plage, cerca del dique, en el bulevar Labrasse.\n\nAbierto todo el año de 11h30 a 14h00 y de 18h00 a 21h30 todos los días durante las vacaciones escolares.\nCerrado los jueves todo el día y los viernes al mediodía fuera de las vacaciones escolares.\nEntregas en un radio de 10 km."
        ],
        "nl": [
          "Nieuwe pizzeria in Stella-Plage bij de zeedijk op Boulevard Labrasse.\n\nHet hele jaar geopend van 11.30 tot 14.00 uur en van 18.00 tot 21.30 uur tijdens schoolvakanties.\nBuiten de schoolvakanties de hele dag gesloten op donderdag en vrijdagmiddag.\nLeveringen binnen een straal van 10 km."
        ]
      },
