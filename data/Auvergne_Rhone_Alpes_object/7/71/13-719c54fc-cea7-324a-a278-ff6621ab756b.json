  "rdfs:comment": {
    "de": [
      "Durchatmen, sich befreien, weitergehen... Das ist es, was Odile Ihnen mithilfe der lösungsorientierten Kurzzeittherapie, der Analyse der Berufspraxis und kreativen Workshops anbietet."
    ],
    "en": [
      "Breathing, taking your life back, freeing yourself... Here is what Odile - personal development consultant - offers you. Her techniques? Short therapy and creative workshops. She helps you find solutions for a more serene life."
    ],
    "it": [
      "Respirare, liberarsi, andare avanti... Questo è ciò che Odile vi offre attraverso la Terapia Breve Orientata alla Soluzione, l'Analisi della Pratica Professionale e i laboratori creativi."
    ],
    "fr": [
      "Respirer, se libérer, avancer... Voilà ce que vous propose Odile grâce à la Thérapie Brève Centrée Solution, l'Analyse de la Pratique Professionnelle et les ateliers de création."
    ],
    "es": [
      "Respira, libérate, avanza... Eso es lo que te ofrece Odile a través de la Terapia Breve Centrada en Soluciones, el Análisis de Prácticas Profesionales y los talleres creativos."
    ],
    "nl": [
      "Ademhalen, jezelf bevrijden, vooruitkomen... Dat is wat Odile je biedt via Oplossingsgerichte Korte Therapie, Professionele Praktijkanalyse en creatieve workshops."
    ]
  },
  "rdfs:label": {
