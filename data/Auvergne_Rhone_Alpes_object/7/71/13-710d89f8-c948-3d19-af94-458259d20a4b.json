  "rdfs:comment": {
    "de": [
      "Der Chevril-Stausee ist mit seinen 167 m der höchste Stausee Frankreichs und tief und beherbergt daher sehr große Fische."
    ],
    "en": [
      "The Chevril reservoir is the highest reservoir in France at 167m and is deep, thus welcoming very large fish."
    ],
    "it": [
      "Il bacino di Chevril è il più alto di tutta la Francia, con i suoi 167 metri di altezza, ed è profondo, quindi accoglie pesci molto grandi."
    ],
    "fr": [
      "Plus haute retenue de France du haut de ses 167m, la retenue du Chevril est profonde et accueille ainsi de très gros poissons."
    ],
    "nl": [
      "Het stuwmeer van Chevril is met 167 m het hoogste stuwmeer van Frankrijk en is diep, waardoor het zeer grote vissen verwelkomt."
    ],
    "es": [
      "El embalse de Chevril es el más alto de Francia, con 167 m, y es profundo, por lo que acoge peces muy grandes."
    ]
  },
  "rdfs:label": {
