  "rdfs:comment": {
    "de": [
      "Im Herzen von Lyon und seiner Halbinsel, zwischen Rhône und Saône, empfängt Sie das Bouchon Palais Grillet in einer herzlichen Atmosphäre, um traditionelle Lyoner Küche aus frischen und saisonalen Produkten zu genießen."
    ],
    "en": [
      "Located right in the heart of Lyon and its Presqu'île, between the Rhône and Saône rivers, the Bouchon Palais Grillet welcomes you in a warm atmosphere to enjoy traditional Lyonnais cuisine made from fresh, seasonal produce."
    ],
    "it": [
      "Situato nel cuore di Lione e della sua Presqu'île, tra il Rodano e la Saona, il Bouchon Palais Grillet vi accoglie in un'atmosfera calorosa per gustare la tradizionale cucina lionese a base di prodotti freschi e di stagione."
    ],
    "fr": [
      "Situé en plein cœur de Lyon et sa Presqu’île, entre Rhône et Saône, le Bouchon Palais Grillet vous accueille dans une ambiance chaleureuse pour déguster une cuisine lyonnaise traditionnelle élaborée à partir de produits frais et de saison."
    ],
    "es": [
      "Situado en el corazón de Lyon y su Presqu'île, entre el Ródano y el Saona, el Bouchon Palais Grillet le da la bienvenida en un ambiente cálido para disfrutar de la cocina tradicional lionesa elaborada con productos frescos y de temporada."
    ],
    "nl": [
      "Gelegen in het hart van Lyon en zijn Presqu?île, tussen de Rhône en de Saône, verwelkomt Bouchon Palais Grillet u in een warme sfeer om te genieten van de traditionele Lyonnaise keuken gemaakt met verse en seizoensgebonden producten."
    ]
  },
