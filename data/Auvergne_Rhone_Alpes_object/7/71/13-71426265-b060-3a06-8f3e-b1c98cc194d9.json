  "rdfs:comment": {
    "de": [
      "Ein Büffelkopf am Eingang, einige Poster von Gesetzlosen, die von Kopfgeldjägern gesucht werden, ein sehr farbenfrohes Ensemble für eine Reise nach Mexiko, sowohl in der Einrichtung als auch auf dem Teller...!"
    ],
    "en": [
      "A buffalo head at the entrance, a few posters of outlaws wanted by bounty hunters on the road, a very colorful set, for a trip to Mexico both in the decor and on the plate ...!"
    ],
    "it": [
      "Una testa di bufalo all'ingresso, alcuni poster di fuorilegge ricercati da cacciatori di taglie a caccia, un insieme molto colorato, per un viaggio in Messico tanto nell'arredamento quanto nel piatto...!"
    ],
    "fr": [
      "Une tête de bison à l'entrée, quelques affiches de hors-la-loi recherchés par les chasseurs de primes en vadrouille, un ensemble très coloré, pour un voyage au Mexique tant dans la décor que dans l'assiette...!"
    ],
    "es": [
      "Una cabeza de búfalo en la entrada, unos cuantos carteles de forajidos buscados por los cazarrecompensas al acecho, un conjunto muy colorido, ¡para un viaje a México tanto en la decoración como en el plato!"
    ],
    "nl": [
      "Een buffelkop bij de ingang, een paar posters van outlaws gezocht door premiejagers op jacht, een zeer kleurrijk decor, voor een reis naar Mexico evenzeer in het decor als in het bord...!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant L'Iguane Tex Mex"
    ]
  },
