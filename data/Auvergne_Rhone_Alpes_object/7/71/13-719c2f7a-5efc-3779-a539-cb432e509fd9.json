  "rdfs:comment": {
    "de": [
      "Eine authentische Adresse mit Steinen und Holzbalken.\r\nBei La Jeanne handelt es sich um die Bar der Freunde, die auch eine hochwertige Küche anbietet. Ankerpunkt für Stammgäste, gute Erinnerung für Reisende..."
    ],
    "en": [
      "An authentic address with stonework and exposed beams.\r\nChez La Jeanne is a friends' bar that also serves quality cuisine. An anchor for regulars, a fond memory for travelers..."
    ],
    "it": [
      "Un indirizzo autentico con pietre e travi a vista.\r\nChez La Jeanne è il bar degli amici che offre anche una cucina di qualità. Punto di riferimento per gli habitué, buon ricordo per i viaggiatori..."
    ],
    "fr": [
      "Une adresse authentique avec pierres et poutres apparentes.\r\nChez La Jeanne, c'est le bar des amis qui propose également une cuisine de qualité. Point d'ancrage pour les habitués, bon souvenir pour les voyageurs..."
    ],
    "es": [
      "Una dirección auténtica con piedras y vigas a la vista.\r\nChez La Jeanne es el bar de los amigos que también ofrece una cocina de calidad. Punto de anclaje para los habituales, buen recuerdo para los viajeros..."
    ],
    "nl": [
      "Een authentiek adres met steenwerk en zichtbare balken.\r\nChez La Jeanne is de bar van de vrienden die ook een kwaliteitskeuken aanbiedt. Ankerpunt voor stamgasten, goed geheugen voor reizigers..."
    ]
  },
