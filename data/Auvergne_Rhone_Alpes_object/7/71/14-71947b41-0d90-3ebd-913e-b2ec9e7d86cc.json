  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/f26455ef-102b-315e-8d9f-e40d1773a43d",
      "dc:description": {
        "de": [
          "Die Eleganz der kulinarischen Tradition.\n\nDie Belle Histoire hat das Flavio wieder auferstehen lassen\n\"Club de la Forêt\" unter den Institutionen von Touquettois, mit einem renommierten Chefkoch, der von seiner Brigade begleitet wird.\n\nWer den traditionellen Service und seine Großzügigkeit liebt, wird Flavio zu schätzen wissen."
        ],
        "en": [
          "The elegance of culinary tradition.\n\nLa Belle Histoire has revived the Flavio\nthe \"Club de la Forêt\" has become a Touquett institution, with a renowned chef and his brigade.\n\nLovers of traditional service and generosity will appreciate Flavio to the full."
        ],
        "it": [
          "L'eleganza della tradizione culinaria.\n\nLa Belle Histoire ha fatto rivivere il \"Club de la Forêt\" di Flavio in un'istituzione di Touquet\n\"Club de la Forêt\" in un'istituzione del Touquet, con uno chef rinomato e la sua brigata.\n\nGli amanti del servizio tradizionale e della generosità apprezzeranno Flavio fino in fondo."
        ],
        "fr": [
          "L'élégance de la tradition culinaire.\n\nLa Belle Histoire a fait renaître le Flavio\n« Club de la Forêt » parmi les institutions Touquettoises, avec un chef de renom accompagné de sa brigade.\n\nLes amoureux du service traditionnel, de sa générosité, apprécieront Flavio à sa juste valeur."
        ],
        "es": [
          "La elegancia de la tradición culinaria.\n\nLa Belle Histoire ha resucitado el Flavio\n\"Club de la Forêt\" en una institución de Touquet, con un chef de renombre y su brigada.\n\nLos amantes del servicio tradicional y de la generosidad sabrán apreciar plenamente Flavio."
        ],
        "nl": [
          "De elegantie van culinaire traditie.\n\nLa Belle Histoire heeft de Flavio\n\"Club de la Forêt\" nieuw leven ingeblazen in een instituut in Touquet, met een gerenommeerde chef-kok en zijn brigade.\n\nLiefhebbers van traditionele service en vrijgevigheid zullen Flavio ten volle waarderen."
        ]
      },
