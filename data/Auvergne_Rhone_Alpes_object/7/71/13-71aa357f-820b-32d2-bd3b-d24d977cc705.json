  "rdfs:comment": {
    "de": [
      "Das große Epos der amerikanischen Indianer in einer kühnen und kulturellen Show: Pferde, Stuntmen, Schauspieler, Voltigierer, Kämpfe - entdecken Sie das wahre Leben dieses großen Reitervolkes.\r\nShow im Freien"
    ],
    "en": [
      "The great epic of the American Indians in a daring cultural show: horses, stuntmen, actors, acrobats, fights, discover the true life of this great horse-riding people.\r\nOutdoor show"
    ],
    "it": [
      "La grande epopea degli Indiani d'America in uno spettacolo rocambolesco e culturale: cavalli, stuntman, attori, acrobati, combattimenti, per scoprire la vera vita di questo grande popolo a cavallo.\r\nSpettacolo all'aperto"
    ],
    "fr": [
      "La grande épopée des indiens d'Amérique dans un spectacle audacieux et culturel : chevaux, cascadeurs, acteurs, voltigeurs, combats, découvrez la véritable vie de ce grand peuple cavalier.\r\nSpectacle en extérieur"
    ],
    "es": [
      "La gran epopeya de los indios americanos en un espectáculo audaz y cultural: caballos, dobles, actores, acróbatas, luchas, descubra la vida real de este gran pueblo de jinetes.\r\nEspectáculo al aire libre"
    ],
    "nl": [
      "Het grote epos van de Amerikaanse Indianen in een gedurfde en culturele show: paarden, stuntmannen, acteurs, acrobaten, gevechten, ontdek het echte leven van dit grote paardrijdende volk.\r\nOpenluchtshow"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Spectacle nocturne équestre \"Géronimo\""
    ]
  },
