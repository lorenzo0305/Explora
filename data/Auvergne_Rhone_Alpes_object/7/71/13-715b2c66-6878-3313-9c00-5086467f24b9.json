  "rdfs:comment": {
    "de": [
      "L'atelier d'Émilie bietet Ihnen die Kreation von Blumenarrangements für alle Anlässe (Geburtstag, Geburt, Taufe, Hochzeit...) auf Bestellung an. Möglichkeit der Abholung im Atelier oder Lieferung nach Hause (mit Versandkosten)."
    ],
    "en": [
      "L'atelier d'Émilie creates floral arrangements for all events (birthdays, anniversaries, christenings, weddings...) to order. Pick-up at the studio or home delivery (with postage)."
    ],
    "it": [
      "L'atelier d'Émilie crea composizioni floreali su ordinazione per tutti gli eventi (compleanni, battesimi, matrimoni, ecc.). È possibile ritirarle presso l'atelier o farle recapitare a domicilio (spese di spedizione incluse)."
    ],
    "fr": [
      "L'atelier d'Émilie vous propose des créations de compositions florales pour tous événements (anniversaire, naissance, baptême, mariage...) sur commande. Possibilité de récupérer à l'atelier ou livraison à domicile (avec frais de port)."
    ],
    "nl": [
      "L'atelier d'Émilie maakt bloemstukken op bestelling voor alle evenementen (verjaardagen, doopfeesten, huwelijken, enz.). Je kunt ze afhalen in het atelier of thuis laten bezorgen (porto inbegrepen)."
    ],
    "es": [
      "L'atelier d'Émilie crea arreglos florales por encargo para todo tipo de eventos (cumpleaños, bautizos, bodas, etc.). Puede recogerlos en el taller o recibirlos en su domicilio (gastos de envío incluidos)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'atelier d'Emilie"
    ]
  },
