  "rdfs:comment": {
    "de": [
      "Die Salamander-Töpferei bietet Alltagsgegenstände in einem reinen, schlichten und eleganten Stil an. Die Stücke und Glasuren werden in der Werkstatt hergestellt.\r\nEntdecken Sie Steinzeug und Porzellan und lassen Sie sich in die Welt der hohen Temperaturen entführen."
    ],
    "en": [
      "Salamandre pottery offers everyday pieces in a pure, sober and elegant style. Pieces and glazes made in the workshop.\r\nCome and discover stoneware and porcelain and let yourself be drawn into the world of high temperature."
    ],
    "it": [
      "La ceramica Salamandre offre pezzi di uso quotidiano in uno stile puro, sobrio ed elegante. Pezzi e smalti realizzati nel laboratorio.\r\nVenite a scoprire il gres e la porcellana e lasciatevi coinvolgere dal mondo delle alte temperature."
    ],
    "fr": [
      "Salamandre poterie propose des pièces du quotidien dans un style pur, sobre et élégant. Pièces et émaux fabriqués à l’atelier. \r\nVenez découvrir le grès et la porcelaine et laissez-vous entrainer dans le monde de la haute température."
    ],
    "nl": [
      "Salamandre aardewerk biedt alledaagse stukken in een pure, sobere en elegante stijl. Stukken en glazuren gemaakt in het atelier.\r\nKom steengoed en porselein ontdekken en laat je meeslepen in de wereld van hoge temperaturen."
    ],
    "es": [
      "La alfarería Salamandre ofrece piezas de uso cotidiano en un estilo puro, sobrio y elegante. Piezas y esmaltes realizados en el taller.\r\nVenga a descubrir el gres y la porcelana y déjese arrastrar por el mundo de las altas temperaturas."
    ]
  },
  "rdfs:label": {
