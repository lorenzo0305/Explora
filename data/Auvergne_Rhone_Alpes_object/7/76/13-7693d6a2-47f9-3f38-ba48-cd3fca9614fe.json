  "rdfs:comment": {
    "de": [
      "Metzgerei und Restaurant am selben Ort, das garantiert Frische und Qualität. Das Restaurant bietet frisches Fleisch, hausgemachte Zubereitungen, Geflügel, Fertiggerichte und Partyservice mit der Möglichkeit, Bestellungen nach Maß zu tätigen."
    ],
    "en": [
      "Butchery and restaurant in the same location, a guarantee of freshness and quality. The restaurant offers fresh meat, homemade preparations, poultry, ready-cooked meals and catering services, with the possibility of custom orders."
    ],
    "it": [
      "Macelleria e ristorante nello stesso sito, una garanzia di freschezza e qualità. Il ristorante offre carne fresca, preparazioni casalinghe, pollame, piatti pronti e servizi di catering, con la possibilità di ordini su misura."
    ],
    "fr": [
      "Boucherie et Restaurant au même emplacement, c'est un gage de fraîcheur et de qualité. Le restaurant propose de la viande fraîche, des préparations maison, volailles, plats cuisinés et services traiteur, avec possibilité de commandes sur mesure."
    ],
    "es": [
      "Una carnicería y un restaurante en el mismo lugar, garantía de frescura y calidad. El restaurante ofrece carne fresca, preparaciones caseras, aves de corral, platos preparados y servicios de catering, con la posibilidad de hacer pedidos a medida."
    ],
    "nl": [
      "Een slagerij en restaurant op dezelfde locatie, een garantie voor versheid en kwaliteit. Het restaurant biedt vers vlees, huisgemaakte bereidingen, gevogelte, kant-en-klare maaltijden en cateringdiensten, met de mogelijkheid om bestellingen op maat te maken."
    ]
  },
  "rdfs:label": {
