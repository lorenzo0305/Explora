  "rdfs:comment": {
    "de": [
      "Via Allier markiert hier den Übergang zwischen der fruchtbaren Ebene der Limagne und dem vulkanischen Charakter des Großraums Clermont-Ferrand und der am Horizont aufragenden Puys-Kette."
    ],
    "en": [
      "Via Allier marks the transition between the fertile Limagne plain and the volcanic character of the Clermont-Ferrand conurbation, with the Chaîne des Puys on the horizon."
    ],
    "it": [
      "Via Allier segna la transizione tra la fertile pianura del Limagne e il carattere vulcanico dell'agglomerato di Clermont-Ferrand, con la Chaîne des Puys che si staglia all'orizzonte."
    ],
    "fr": [
      "Via Allier marque ici la transition entre la plaine fertile de la Limagne et le caractère volcanique de l’agglomération clermontoise et la chaîne des Puys qui se dresse à l'horizon."
    ],
    "nl": [
      "Via Allier markeert de overgang tussen de vruchtbare vlakte van de Limagne en het vulkanische karakter van de agglomeratie Clermont-Ferrand, met de Chaîne des Puys aan de horizon."
    ],
    "es": [
      "La Via Allier marca la transición entre la fértil llanura de Limagne y el carácter volcánico de la aglomeración de Clermont-Ferrand, con la Chaîne des Puys elevándose en el horizonte."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Via Allier à vélo - Étape 07 - Puy-Guillaume > Pont-du-Château"
    ]
  },
