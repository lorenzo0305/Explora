  "rdfs:comment": {
    "de": [
      "Da die Workshops nicht nur für Kinder gedacht sind, bieten wir Ihnen die Möglichkeit, die Kunst des Mosaiks durch ein gemeinsames Werk zu entdecken, das für alle offen ist!"
    ],
    "en": [
      "Because workshops aren't just for kids, we're offering you the chance to discover the art of mosaic through a collective project open to all!"
    ],
    "it": [
      "Poiché i laboratori non sono solo per i bambini, vi offriamo la possibilità di scoprire l'arte del mosaico attraverso una creazione collettiva aperta a tutti!"
    ],
    "fr": [
      "Parce que les ateliers ne sont pas consacrés qu'aux enfants, nous vous proposons de découvrir l'art de la mosaïque au travers d'une réalisation collective ouverte à tous !"
    ],
    "es": [
      "Porque los talleres no son sólo para niños, te ofrecemos la posibilidad de descubrir el arte del mosaico a través de una creación colectiva ¡abierta a todos!"
    ],
    "nl": [
      "Omdat de workshops niet alleen voor kinderen zijn, bieden we je de kans om de kunst van mozaïeken te ontdekken door middel van een collectieve creatie die voor iedereen toegankelijk is!"
    ]
  },
  "rdfs:label": {
