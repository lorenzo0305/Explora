  "rdfs:comment": {
    "de": [
      "Restaurant auf den Pisten, das mit Skiern und zu Fuß erreichbar ist. \r\nAuf der Speisekarte stehen typische Gerichte aus den Bergen. Raclette, savoyisches Fondue, Tartiflette, Pierrades,"
    ],
    "en": [
      "Restaurant on the ski slopes that you can ski or walk to. \r\nOn the menu, typical mountain fare: raclette, cheese fondue, tartiflette, pierrades (hot stone),"
    ],
    "it": [
      "Ristorante situato sulle piste, accessibile con gli sci e a piedi.\r\nNel menu, piatti tipici della montagna. Raclette, fonduta savoiarda, tartiflette, pierrades,"
    ],
    "fr": [
      "Restaurant situé sur les pistes accessible à ski et à pied. \r\nAu menu, des plats typiques de montagne. Raclette, fondue savoyarde, tartiflette, pierrades,"
    ],
    "es": [
      "Restaurante situado en las pistas, accesible esquiando y a pie.\r\nEn el menú, platos típicos de montaña. Raclette, fondue saboyana, tartiflette, pierrades,"
    ],
    "nl": [
      "Restaurant op de pistes, bereikbaar op de ski's en te voet. Menukaart met typische bergspecialiteiten zoals raclette, kaasfondue, tartiflette, steengrillen..."
    ]
