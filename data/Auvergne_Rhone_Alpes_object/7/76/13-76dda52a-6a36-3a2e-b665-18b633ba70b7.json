  "rdfs:comment": {
    "de": [
      "Im Zentrum des Dorfes stehen Ihnen vier Tennisplätze und eine Mauer zur Verfügung. Sie haben Zugang dazu, indem Sie entweder dem Club beitreten oder die Plätze stundenweise im Tourismusbüro mieten."
    ],
    "en": [
      "Four tennis courts and a wall in the village center. You can either join the club or rent the courts by the hour from the Tourist Office."
    ],
    "it": [
      "Nel centro del paese sono disponibili quattro campi da tennis e un muro. È possibile accedervi iscrivendosi al club o affittando i campi a ore presso l'Ufficio del Turismo."
    ],
    "fr": [
      "Quatre terrains de tennis et un mur à votre disposition au centre du village. Vous pouvez y accéder soit en adhérant au club, soit en louant les courts à l'heure à l'Office de Tourisme."
    ],
    "nl": [
      "In het centrum van het dorp liggen vier tennisbanen en een muur. Je kunt lid worden van de club of de banen per uur huren bij het VVV-kantoor."
    ],
    "es": [
      "En el centro del pueblo hay cuatro pistas de tenis y un muro. Puede acceder a ellas haciéndose socio del club o alquilando las pistas por horas en la Oficina de Turismo."
    ]
  },
  "rdfs:label": {
