  "rdfs:comment": {
    "de": [
      "Das Schloss Treffort im Departement Ain, ein ehemaliges Landgut der Grafen von Savoyen und des Architekten Tony Ferret, überblickt von den Bergen des Revermont aus die Bresse."
    ],
    "en": [
      "A former estate of the Counts of Savoy and architect Tony Ferret, Château de Treffort in the Ain department overlooks Bresse from the Revermont mountains."
    ],
    "it": [
      "Antica tenuta dei conti di Savoia e dell'architetto Tony Ferret, il castello di Treffort, nel dipartimento dell'Ain, domina la regione della Bresse dalle montagne di Revermont."
    ],
    "fr": [
      "Ancien domaine des comtes de Savoie et de l’architecte Tony Ferret, le Château de Treffort, dans le département de l’Ain, surplombe la Bresse depuis les monts du Revermont."
    ],
    "nl": [
      "Château de Treffort, een voormalig landgoed van de graven van Savoye en de architect Tony Ferret, in het departement Ain, kijkt uit over de Bresse-regio vanaf de bergen van Revermont."
    ],
    "es": [
      "Antigua propiedad de los condes de Saboya y del arquitecto Tony Ferret, el castillo de Treffort, en el departamento de Ain, domina la región de Bresse desde los montes Revermont."
    ]
  },
