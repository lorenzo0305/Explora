  "rdfs:comment": {
    "de": [
      "Das 1978 eingeweihte Fresko \"Le chef d'orchestre\" wurde von Alain Coutty, einem Künstler aus Oyonnax, der als Maler, Bildhauer und Schöpfer aller Art tätig ist, angefertigt."
    ],
    "en": [
      "The fresco \"Le chef d'orchestre\", inaugurated in 1978, was created by Alain Coutty, an artist from Oyonnax, painter, sculptor and creator of all kinds."
    ],
    "it": [
      "L'affresco \"Le chef d'orchestre\", inaugurato nel 1978, è stato realizzato da Alain Coutty, artista di Oyonnax, pittore, scultore e creatore di ogni genere."
    ],
    "fr": [
      "La fresque « Le chef d’orchestre » inaugurée en 1978 a été réalisée par Alain Coutty, artiste oyonnaxien, peintre, sculpteur et créateur en tous genres."
    ],
    "nl": [
      "Het fresco \"Le chef d'orchestre\", ingehuldigd in 1978, werd gemaakt door Alain Coutty, een kunstenaar uit Oyonnax, schilder, beeldhouwer en schepper van allerlei soorten."
    ],
    "es": [
      "El fresco \"Le chef d'orchestre\", inaugurado en 1978, es obra de Alain Coutty, artista de Oyonnax, pintor, escultor y creador de todo tipo."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Fresques et murs peints - Le chef d'orchestre"
    ]
  },
