  "rdfs:comment": {
    "de": [
      "Im Sommer geht die GAEC de la Cluse auf die Sommerweide und empfängt Sie direkt auf der Alm! Herstellung und Verkauf von Bauernkäse vor Ort (Tome des Bauges und Käse aus dem Revard: Crémeuh)."
    ],
    "en": [
      "Manufacture and sales of farm produced cheese. In summer, in the pastures on Mont Revard. In the winter, at the farm in Montcel. Tomes des Bauges, Revard cheese."
    ],
    "it": [
      "Produzione e vendita di formaggi di malga in estate negli alpeggi di Le Revard. Inverno alla fattoria di Montcel. Toma dei Bauges, formaggio Revard."
    ],
    "fr": [
      "En été, le GAEC de la Cluse monte en estive et vous accueille directement en alpage ! Fabrication et vente de fromages fermiers sur place (tome des Bauges et fromage du Revard : le Crémeuh)."
    ],
    "nl": [
      "In de zomer gaat de GAEC de la Cluse de bergweiden op en heet je direct welkom! Productie en verkoop ter plaatse van boerenkazen (Tome des Bauges en Crémeuh, een Revard kaas)."
    ],
    "es": [
      "En verano, el GAEC de la Cluse sube a los pastos de montaña y le recibe directamente Producción y venta in situ de quesos de granja (Tome des Bauges y Crémeuh, un queso de Revard)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Alpage de la Cluse - vente directe"
    ]
  },
