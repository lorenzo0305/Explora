  "rdfs:comment": {
    "de": [
      "Haben Sie Lust, einen geselligen Abend mit Freunden zu verbringen?\r\nMöchten Sie gute Biere, Musik und eine festliche Atmosphäre genießen?\r\nKommen Sie und feiern Sie mit uns diese allererste Ausgabe... wir zählen auf Sie, um das Feuer zu entfachen!"
    ],
    "en": [
      "Want to spend a convivial evening with friends?\r\nDiscover some great beers, enjoy some music and a festive atmosphere?\r\nCome and celebrate with us this very first edition? we're counting on you to set the place alight!"
    ],
    "it": [
      "Volete trascorrere una serata conviviale con gli amici?\r\nVolete scoprire alcune buone birre, godervi un po' di musica e un'atmosfera festosa?\r\nUnitevi a noi per festeggiare questa primissima edizione: contiamo su di voi per infiammare la festa!"
    ],
    "fr": [
      "Envie de passer une soirée conviviale entre amis ?\r\nDe découvrir de bonnes bières, profiter de musique et d’une ambiance festive ?\r\nVenez célébrer avec nous cette toute première édition… on compte sur vous pour mettre le feu !"
    ],
    "es": [
      "¿Quiere pasar una velada de convivencia con amigos?\r\n¿Quieres descubrir buenas cervezas, disfrutar de la música y de un ambiente festivo?\r\nVen a celebrar con nosotros esta primera edición... ¡contamos contigo para encender la fiesta!"
    ],
    "nl": [
      "Zin in een gezellige avond met vrienden?\r\nWil je lekkere bieren ontdekken, genieten van muziek en een feestelijke sfeer?\r\nKom deze allereerste editie samen met ons vieren en we rekenen op jullie om het feest te laten losbarsten!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Fête de la bière"
    ]
  },
