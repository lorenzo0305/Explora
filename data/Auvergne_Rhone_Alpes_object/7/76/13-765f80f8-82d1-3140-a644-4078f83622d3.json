  "rdfs:comment": {
    "de": [
      "Mythischer Wettkampf im Skibergsteigen, an dem etwa 200 Zweierteams teilnehmen, darunter zahlreiche Nationalitäten. 10000m positiver Höhenunterschied sind an 4 Tagen zu bewältigen. Jugendrennen vom 13. bis 14. März."
    ],
    "en": [
      "The mythical competition takes place on Arêches-Beaufort mountains during four intense days. It's about 200 teams of 2 competitors  riding with skis, 10000 meters of positive denivellé."
    ],
    "it": [
      "Questa leggendaria gara di scialpinismo riunisce circa 200 squadre di 2 persone, di diverse nazionalità. 10000 m di dislivello positivo in 4 giorni. Gara giovanile dal 13 al 14 marzo."
    ],
    "fr": [
      "Compétition mythique de ski alpinisme qui regroupe environ 200 équipes de 2, dont de nombreuses nationalités. 10000m de dénivelée positive à parcourir sur 4 jours. Course jeunes du 13 au 14 mars."
    ],
    "es": [
      "Esta legendaria competición de esquí de montaña reúne a unos 200 equipos de 2 personas de numerosas nacionalidades. 10000m de desnivel positivo en 4 días. Carrera juvenil del 13 al 14 de marzo."
    ],
    "nl": [
      "De 38e editie van deze legendarische wedstrijd van ski-alpinisme: 4 dagen wedstrijden over een positief hoogteverschil van bijna 10.000m! 4 dagen gekte waarbij het hele dorp op de been is en leeft volgens het ritme van de wedstrijden."
    ]
  },
