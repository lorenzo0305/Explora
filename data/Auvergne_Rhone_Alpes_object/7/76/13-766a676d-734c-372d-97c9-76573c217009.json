  "rdfs:comment": {
    "de": [
      "Von der Weinprobe bis zum Spaziergang durch die Weinberge, verbringen Sie einen geselligen Moment auf dem Weingut Sauvat. Annie, eine handwerkliche Winzerin, wird ihr Wissen und ihre Leidenschaft für den Wein mit Ihnen teilen."
    ],
    "en": [
      "From wine tasting to a walk in the vineyards, come and spend a convivial moment at the Sauvat estate. Annie, the winemaker, will share with you her knowledge and her passion for wine through unique and intimate moments."
    ],
    "it": [
      "Dalle degustazioni alle passeggiate tra le vigne, venite a trascorrere un momento di convivialità al Domaine Sauvat. Annie, produttrice di vino artigianale, condividerà con voi le sue conoscenze e la sua passione per il vino in un ambiente unico e intimo."
    ],
    "fr": [
      "De la dégustation à la balade dans les vignes, venez passer un moment convivial au domaine Sauvat . Annie artisane vigneronne, saura vous partager son savoir faire et sa passion du vin au travers de moments intimistes et uniques."
    ],
    "nl": [
      "Van proeverijen tot wandelingen door de wijngaarden, kom een gezellig moment doorbrengen op Domaine Sauvat. Annie, een ambachtelijke wijnmaker, zal haar kennis en passie voor wijn met je delen in een unieke en intieme setting."
    ],
    "es": [
      "Desde degustaciones hasta paseos por las viñas, venga a pasar un momento agradable en Domaine Sauvat. Annie, enóloga artesana, compartirá con usted sus conocimientos y su pasión por el vino en un marco único e íntimo."
    ]
  },
  "rdfs:label": {
    "en": [
      "Wine Grower Annie Sauvat"
    ],
    "fr": [
      "Domaine Annie Sauvat vigneronne"
    ]
  },
