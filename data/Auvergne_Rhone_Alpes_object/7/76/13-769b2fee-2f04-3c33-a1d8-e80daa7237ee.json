  "rdfs:comment": {
    "de": [
      "Die Bergführer des Collectif Pied Vert betreuen das ganze Jahr über Entdeckungswanderungen und Naturaktivitäten, die in den Dörfern Autrans und Méaudre, Lans en Vercors, Villard de Lans oder Corrençon beginnen."
    ],
    "en": [
      "The mountain guides of the Pied Vert Group lead discovery hikes and nature activities from the villages of Autrans and Méaudre, Lans-en-Vercors, Villard de Lans and Corrençon, throughout the year."
    ],
    "it": [
      "Gli accompagnatori di montagna Pied Vert conducono escursioni di scoperta, escursioni sportive, attività naturalistiche e giochi dai villaggi di Autrans-Méaudre, Lans en Vercors, Villard de Lans e Corrençon, aperti 7/7 tutto l'anno."
    ],
    "fr": [
      "Les Accompagnateurs en Montagne Pied Vert encadrent des randos-découvertes, rando-sportives et des activités nature et des jeux au départ des villages de Autrans-Méaudre, Lans en Vercors, Villard de Lans et Corrençon, ouvert 7/7 toute l'année."
    ],
    "es": [
      "Los monitores de montaña de Pied Vert dirigen excursiones de descubrimiento, excursiones deportivas, actividades en la naturaleza y juegos desde los pueblos de Autrans-Méaudre, Lans en Vercors, Villard de Lans y Corrençon, abiertos 7/7 todo el año."
    ],
    "nl": [
      "Berggidsen van Pied Vert leiden ontdekkingswandelingen, sportieve wandelingen, natuuractiviteiten en spelletjes vanuit de dorpen Autrans-Méaudre, Lans en Vercors, Villard de Lans en Corrençon, open 7/7 het hele jaar door."
    ]
  },
  "rdfs:label": {
    "de": [
      "Bergführer Pied Vert"
    ],
    "en": [
      "Pied Vert Mountain Guide"
    ],
    "fr": [
      "Accompagnateurs en Montagne Pied Vert"
    ]
  },
