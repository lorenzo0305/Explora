  "rdfs:comment": {
    "de": [
      "Das Hotel-Restaurant Volcan Sancy empfängt Sie in einer warmen und familiären Umgebung im Herzen des Regionalparks der Vulkane der Auvergne (20 km von Clermont-Ferrand, 30 min von der A89 und 25 km von Mont Dore entfernt)."
    ],
    "en": [
      "The Volcan Sancy hotel-restaurant welcomes you in a warm and family atmosphere in the heart of the Auvergne Volcanoes Regional Park (20 km from Clermont-Ferrand, 30 min from the A89 motorway and 25 km from Mont Dore)."
    ],
    "it": [
      "L'hotel-ristorante Volcan Sancy offre un'accoglienza calorosa e familiare nel cuore del Parc Régional des Volcans d'Auvergne (a 20 km da Clermont-Ferrand, a 30 minuti dalla A89 e a 25 km da Le Mont Dore)."
    ],
    "fr": [
      "L’hôtel-restaurant Volcan Sancy vous accueille dans un cadre chaleureux et familial au cœur du Parc Régional des Volcans d’Auvergne (20 km de Clermont-Ferrand, 30 min de l’ A89 et 25 km du Mont Dore)."
    ],
    "nl": [
      "Hotel-restaurant Volcan Sancy biedt een warm en familiair welkom in het hart van het Parc Régional des Volcans d'Auvergne (20 km van Clermont-Ferrand, 30 min van de A89 en 25 km van Le Mont Dore)."
    ],
    "es": [
      "El hotel-restaurante Volcan Sancy ofrece una cálida acogida familiar en el corazón del Parc Régional des Volcans d'Auvergne (a 20 km de Clermont-Ferrand, a 30 min de la A89 y a 25 km de Le Mont Dore)."
    ]
  },
