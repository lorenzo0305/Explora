  "rdfs:comment": {
    "de": [
      "Diese vom Col du Mollard ausgehende Piste beginnt auf dem Weg, der die Tour du Chatel bildet, und führt dann in den Hang des Waldes von Rival."
    ],
    "en": [
      "Departing from the Col du Mollard, this trail starts on the Tour du Chatel path and then plunges down the slope of the Rival forest, offering thrills and technical singles."
    ],
    "it": [
      "Partendo dal Col du Mollard, questo percorso, che inizia sul sentiero della Tour du Chatel per poi scendere lungo il pendio della foresta di Rival, farà la gioia di tutti gli amanti del brivido e dei singletrack tecnici."
    ],
    "fr": [
      "Au départ du Col du Mollard, cette piste qui commence sur le sentier faisant le Tour du Chatel avant de piquer dans la pente de la forêt du Rival comblera tous les adeptes de sensations fortes et singles techniques."
    ],
    "nl": [
      "Vertrekkend vanaf de Col du Mollard, zal dit pad, dat begint op het pad van de Tour du Chatel en dan afdaalt langs de helling van het bos van Rival, alle sensatiezoekers en liefhebbers van technische singletracks bekoren."
    ],
    "es": [
      "A partir del Col du Mollard, este sendero, que comienza en el camino de la Tour du Chatel antes de descender por la ladera del bosque de Rival, hará las delicias de los amantes de las sensaciones fuertes y de los senderos técnicos."
    ]
  },
