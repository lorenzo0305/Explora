  "rdfs:comment": {
    "de": [
      "Die Mitarbeiter der PM in Livron üben ihre Befugnisse auf dem Gemeindegebiet aus, das etwa 40 km² groß ist und eine Bevölkerung von fast 10 000 Einwohnern hat."
    ],
    "en": [
      "Livron's PM staff carry out their duties on the municipal territory, some 40 km², with a population approaching 10,000."
    ],
    "it": [
      "Il personale del deputato Livron esercita le proprie prerogative sul territorio comunale, circa 40 km², con una popolazione che si avvicina ai 10.000 abitanti."
    ],
    "fr": [
      "Les personnels de la PM de Livron, exercent leurs prérogatives sur le territoire communal, environ 40 km², avec une population approchant des 10 000 habitants."
    ],
    "nl": [
      "Het personeel van de lokale politie van Livron oefent zijn bevoegdheden uit in de hele gemeente, die ongeveer 40 km² beslaat en bijna 10.000 inwoners telt."
    ],
    "es": [
      "El personal del diputado de Livron, ejerce sus prerrogativas en el territorio municipal, de unos 40 km², con una población que se acerca a los 10.000 habitantes."
    ]
  },
