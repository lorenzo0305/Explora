  "rdfs:comment": {
    "de": [
      "Neu und einzigartig in Les Menuires, im Viertel Les Bruyères, ist \"La bulle\" des Restaurants Le Cocon des Neiges, das den ganzen Winter über für alle geöffnet ist."
    ],
    "en": [
      "Come and eat at ”La Bulle\" and enjoy the view, whatever the weather conditions.\r\nThe Chef and his team offer brunch, a cocktail reception or a gala dinner, send us your requirements."
    ],
    "it": [
      "Uno spazio nuovo e unico a Les Menuires, nel quartiere di Bruyères, \"La bulle\" del ristorante Cocon des Neiges è aperto a tutti, per tutto l'inverno."
    ],
    "fr": [
      "Nouvel espace et unique aux Menuires, dans le quartier aux Bruyères, « La bulle » du restaurant le Cocon des Neiges est ouverte à tous, tout au long de l’hiver."
    ],
    "es": [
      "Un espacio nuevo y único en Les Menuires, en el barrio de Bruyères, \"La bulle\" del restaurante Cocon des Neiges está abierta a todos, durante todo el invierno."
    ],
    "nl": [
      "Kom bij \"La Bulle\" eten en geniet van een uitstekend uitstekend, wat het weer ook doet.\r\nDe chef-kok en wijn team stellen u een Brunch voor, een uitstekende cocktail of een zalig diner. Vraag naar de mogelijkheden."
    ]
  },
