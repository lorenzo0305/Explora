  "rdfs:comment": {
    "de": [
      "Traditionelle Metzgerei im Viertel Châteauvert in Valence.\r\nLokales Qualitätsfleisch, das überwiegend aus der Drôme, der Ardèche und den Hochebenen der Auvergne stammt. Wir bieten auch einen Partyservice an."
    ],
    "en": [
      "Traditional butcher's shop in the Châteauvert district of Valence.\r\nQuality local meats, mostly from the Drôme, Ardèche and Auvergne plateaus. We also offer a catering service."
    ],
    "it": [
      "Macelleria tradizionale nel quartiere Châteauvert di Valence.\r\nCarni locali di qualità, provenienti soprattutto dagli altipiani della Drôme, dell'Ardèche e dell'Auvergne. Offriamo anche un servizio di catering."
    ],
    "fr": [
      "Boucherie traditionnelle située dans le quartier de Châteauvert à Valence. \r\nViandes de qualité et locales, venant en grande majorité de Drôme, d'Ardèche et des plateaux d'Auvergne. Nous proposons aussi un service traiteur."
    ],
    "nl": [
      "Traditionele slagerij in de wijk Châteauvert in Valence.\r\nLokale kwaliteitsvleeswaren, voornamelijk uit de Drôme, Ardèche en Auvergne. We bieden ook een traiteurdienst."
    ],
    "es": [
      "Carnicería tradicional en el barrio de Châteauvert de Valence.\r\nCarnes locales de calidad, principalmente de las mesetas de Drôme, Ardèche y Auvernia. También ofrecemos un servicio de catering."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Marquise - Boucherie"
    ]
  },
