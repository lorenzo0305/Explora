  "rdfs:comment": {
    "de": [
      "Unser Weingut befindet sich im Norden der AOC Côtes d'Auvergne auf den Hängen von Madargue im Herzen von Terra Volcana. Es wird seit 2020 biologisch bewirtschaftet und erstreckt sich über 10 Hektar."
    ],
    "en": [
      "Our vineyard is located north of the AOC Côtes d?Auvergne on the slopes of Madargue in the heart of Terra Volcana. Organic since 2020, it extends over 10 hectares."
    ],
    "it": [
      "Il nostro vigneto si trova a nord della AOC Côtes d'Auvergne, sulle pendici della Madargue, nel cuore della Terra Volcana. Biologico dal 2020, si estende su 10 ettari."
    ],
    "fr": [
      "Notre domaine viticole est situé au nord de l’AOC Côtes d’Auvergne sur les coteaux de Madargue au coeur de Terra Volcana. Conduit en Agriculture Biologique depuis 2020, il s’étend sur 10 hectares."
    ],
    "nl": [
      "Onze wijngaard ligt ten noorden van de AOC Côtes d'Auvergne op de hellingen van Madargue in het hart van Terra Volcana. De wijngaard is biologisch sinds 2020 en beslaat 10 hectare."
    ],
    "es": [
      "Nuestro viñedo está situado al norte de la AOC Côtes d'Auvergne, en las laderas de Madargue, en el corazón de Terra Volcana. Ecológico desde 2020, abarca 10 hectáreas."
    ]
  },
