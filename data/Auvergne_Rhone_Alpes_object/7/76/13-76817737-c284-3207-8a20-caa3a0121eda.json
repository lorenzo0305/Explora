  "rdfs:comment": {
    "de": [
      "Das CCAS von langeac bietet kostenlose Filmvorführungen für Personen ab 60 Jahren um 14:30 Uhr an jedem letzten Freitag im Monat von September bis Juni im Centre Culturel de langeac an."
    ],
    "en": [
      "The CCAS de langeac offers free cinema screenings for people aged 60 and over at 2.30pm every last Friday of the month from September to June at the Centre Culturel de langeac."
    ],
    "it": [
      "Il CCAS di Langeac offre proiezioni cinematografiche gratuite per persone di 60 anni e oltre alle 14.30 ogni ultimo venerdì del mese da settembre a giugno presso il Centro culturale di Langeac."
    ],
    "fr": [
      "Le CCAS de langeac propose des séances de cinéma gratuites pour les personnes de 60 ans et plus à 14h30, tous les derniers vendredis du mois, de septembre à juin au Centre Culturel de langeac."
    ],
    "nl": [
      "Het CCAS Langeac biedt van september tot juni elke laatste vrijdag van de maand om 14.30 uur gratis bioscoopvoorstellingen voor mensen van 60 jaar en ouder in het Cultureel Centrum Langeac."
    ],
    "es": [
      "El CCAS de Langeac ofrece proyecciones de cine gratuitas para mayores de 60 años, a las 14.30 h, todos los últimos viernes de mes, de septiembre a junio, en el Centro Cultural de Langeac."
    ]
  },
  "rdfs:label": {
