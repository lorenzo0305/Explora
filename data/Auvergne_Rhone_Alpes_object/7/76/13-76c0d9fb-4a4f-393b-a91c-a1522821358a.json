  "rdfs:comment": {
    "de": [
      "Nehmen Sie an der dritten Ausgabe der Shifumania-Tour teil, der französischen Meisterschaft im Chi Fou Mi! Festliche Atmosphäre, Herausforderungen und gute Laune stehen auf dem Programm. Erleben Sie das Ereignis, das für alle Liebhaber von Stein, Blatt und Schere ein Muss ist!"
    ],
    "en": [
      "Take part in edition 3 of the Shifumania tour, the French Chi Fou Mi championship! A festive atmosphere, challenges and good humor are on the agenda. Come and experience the must-see event for rock-leaf-scissors enthusiasts!"
    ],
    "it": [
      "Partecipate alla terza edizione del tour Shifumania, il campionato francese di Chi Fou Mi! Il programma prevede un'atmosfera festosa, sfide e buon umore. Venite a godervi questo evento imperdibile per gli appassionati di sasso, carta e forbici!"
    ],
    "fr": [
      "Participez à l’édition 3 de la tournée Shifumania, le championnat de France de Chi Fou Mi ! Ambiance festive, défis et bonne humeur au programme. Venez vivre l’événement incontournable des passionnés de pierre-feuille-ciseaux !"
    ],
    "es": [
      "Participe en la 3ª edición de la gira Shifumania, ¡el campeonato francés de Chi Fou Mi! Ambiente festivo, desafíos y buen humor. Venga a disfrutar de esta cita ineludible para los amantes del piedra, papel o tijera"
    ],
    "nl": [
      "Doe mee aan editie 3 van de Shifumania tour, het Franse Chi Fou Mi kampioenschap! Een feestelijke sfeer, uitdagingen en veel humor staan op het programma. Kom genieten van dit niet te missen evenement voor liefhebbers van rock, paper en scissors!"
    ]
  },
