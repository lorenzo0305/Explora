  "rdfs:comment": {
    "de": [
      "Für Vereine, Unternehmen oder für eine Afterwork-Party können Sie im Chénou den Barbereich privatisieren, um Ihre Veranstaltung in einer fröhlichen, geselligen Atmosphäre zu organisieren. (50 Sitzplätze im Inneren und 50 Sitzplätze auf der Terrasse)"
    ],
    "en": [
      "For associations, companies or after-work events, La Chénou offers you the opportunity to privatize the bar area and organize your event in a cheerful, friendly atmosphere. (50 seats inside and 50 on the terrace)"
    ],
    "it": [
      "Per associazioni, aziende o eventi post-lavorativi, La Chénou offre un'area bar privata per organizzare il vostro evento in un'atmosfera allegra e amichevole. (50 posti all'interno e 50 posti sulla terrazza)"
    ],
    "fr": [
      "Pour les associations,  les entreprises ou pour un afterwork, la Chénou vous propose de privatiser l'espace Bar pour organiser votre événement dans une ambiance  joyeuse, conviviale. (50 places assises à l 'intérieur et 50 places assises en terrasse)"
    ],
    "nl": [
      "Voor verenigingen, bedrijven of evenementen na het werk biedt La Chénou een privébarruimte om uw evenement te organiseren in een vrolijke, gezellige sfeer. (50 zitplaatsen binnen en 50 zitplaatsen op het terras)"
    ],
    "es": [
      "Para asociaciones, empresas o eventos afterwork, La Chénou ofrece una zona de bar privada para organizar su evento en un ambiente alegre y acogedor. (50 plazas en el interior y 50 plazas en la terraza)"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Privatisation du Bar Microbrasserie La Chénou"
    ]
  },
