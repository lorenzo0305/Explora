  "rdfs:comment": {
    "de": [
      "Modeschmuck (ZAG Bijoux, YAYA FACTORY Natursteine...), Lederwaren (Paul Marius, Zede), Feinkost (Mate, hausgemachte Konfitüren, Nougat...), Halstücher, Durance-Artikel. Terrasse im Sommer mit handgemachtem Eis und gekühlten Getränken."
    ],
    "en": [
      "Dress jewellery, decoration, delicatessen, scarves. All styles for all ages."
    ],
    "it": [
      "Bigiotteria (ZAG Bijoux, YAYA FACTORY pietre naturali, ecc.), pelletteria (Paul Marius, Zede), gastronomia (mate, marmellate fatte in casa, torrone, ecc.), sciarpe, articoli Durance. Terrazza estiva con gelati fatti in casa e bevande fredde."
    ],
    "fr": [
      "Bijoux fantaisie (ZAG Bijoux, YAYA FACTORY pierres naturelles...), maroquinerie (Paul Marius, Zede), épicerie fine (maté, confitures artisanales, nougat...), foulards, articles Durance. Terrasse l'été avec glaces artisanales et boissons fraiches."
    ],
    "nl": [
      "Kostuumjuwelen (ZAG Bijoux, YAYA FACTORY natuurstenen...), lederwaren (Paul Marius, Zede), delicatessen (mate, huisgemaakte jam, nougat...), sjaals, Durance-artikelen. Zomerterras met huisgemaakt ijs en koude dranken."
    ],
    "es": [
      "Bisutería (ZAG Bijoux, piedras naturales YAYA FACTORY, etc.), marroquinería (Paul Marius, Zede), delicatessen (mate, mermeladas caseras, turrones, etc.), bufandas, artículos Durance. Terraza de verano con helados caseros y bebidas frías."
    ]
  },
