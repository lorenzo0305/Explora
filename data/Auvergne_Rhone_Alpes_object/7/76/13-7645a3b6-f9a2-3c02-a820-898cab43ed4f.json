  "rdfs:comment": {
    "de": [
      "Es handelt sich um einen geselligen Spielbereich, der sowohl für die Kleinsten, insbesondere Babys (Spiele zur Förderung der Entwicklung, Nachahmungsspiele), als auch für die Größeren geeignet ist\r\nältere Kinder (Gesellschaftsspiele von 0 bis 99 Jahren)"
    ],
    "en": [
      "It is a friendly play area adapted to the youngest, especially babies (games for children, imitation games), as well as to the more experienced\r\nlarge (board games from 0 to 99 years old)"
    ],
    "it": [
      "Si tratta di un'area di gioco amichevole adatta ai più piccoli, in particolare ai neonati (giochi di apprendimento precoce, giochi di imitazione), così come ai più grandi (giochi da tavolo da 0 a 99 anni)\r\n(giochi da tavolo da 0 a 99 anni)"
    ],
    "fr": [
      "C'est un espace de jeux convivial adapté aux plus petits, notamment aux bébés (jeux d'éveil, jeux d'imitation), comme aux plus\r\ngrands (jeux de société de 0 à 99 ans)"
    ],
    "nl": [
      "Het is een gezellige speelruimte, aangepast aan de allerkleinsten, vooral baby's (spelletjes voor het vroegtijdig leren, imitatiespelletjes), maar ook aan de oudsten (gezelschapsspelletjes van 0 tot 99 jaar)\r\n(bordspellen van 0 tot 99 jaar)"
    ],
    "es": [
      "Es un espacio de juego amigable y adaptado tanto a los más pequeños, especialmente a los bebés (juegos de aprendizaje temprano, juegos de imitación), como a los mayores (juegos de mesa de 0 a 99 años)\r\n(juegos de mesa de 0 a 99 años)"
    ]
  },
  "rdfs:label": {
