  "rdfs:comment": {
    "de": [
      "PICO MOUTO besteht aus 12 Teilhabern, denen sich ein Dutzend Partner in Verkaufslagern anschließen. Alle Bauern und Bäuerinnen sind als Biobauern zertifiziert und produzieren in einem (sehr) nahen Umkreis."
    ],
    "en": [
      "PICO MOUTO is made up of 12 associates, joined by a dozen partners in the sales depot. All the farmers are certified organic and produce within a (very) close radius."
    ],
    "it": [
      "PICO MOUTO è composto da 12 soci, ai quali si aggiungono una decina di magazzinieri. Tutti gli agricoltori sono certificati biologici e producono in un raggio (molto) ristretto."
    ],
    "fr": [
      "PICO MOUTO est composé de 12 associé.es auxquels se joignent une dizaine de partenaires en dépôt vente. Tous les paysans et paysans sont certifiés en agriculture biologique et produisent dans un rayon (très) proche."
    ],
    "es": [
      "PICO MOUTO está formado por 12 socios, a los que se suman una docena de socios almacenistas. Todos los agricultores tienen certificación ecológica y producen en un radio (muy) cercano."
    ],
    "nl": [
      "PICO MOUTO bestaat uit 12 partners, die worden aangevuld door een tiental magazijnpartners. Alle boeren zijn biologisch gecertificeerd en produceren binnen een (zeer) kleine straal."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Magasin de producteurs Pico Mouto"
    ]
  },
