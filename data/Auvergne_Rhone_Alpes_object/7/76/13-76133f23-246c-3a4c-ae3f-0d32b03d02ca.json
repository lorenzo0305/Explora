  "rdfs:comment": {
    "de": [
      "Im Rahmen der Convention Générations Star Wars et Science-Fiction bietet das Conservatoire de Vichy Communauté eine musikalische Reise in das Herz der größten Leinwandepen an."
    ],
    "en": [
      "As part of the Star Wars and Science Fiction Generations convention, the Conservatoire de Vichy Communauté offers a musical immersion into the heart of the greatest epics of the silver screen."
    ],
    "it": [
      "Nell'ambito della convention Star Wars and Science Fiction Generations, il Conservatoire de Vichy Communauté propone un'immersione musicale nel cuore delle più grandi epopee del grande schermo."
    ],
    "fr": [
      "Dans le cadre de la convention Générations Star Wars et Science-Fiction, le Conservatoire de Vichy Communauté vous propose une immersion musicale au coeur des plus grandes épopées du grand écran."
    ],
    "es": [
      "En el marco de la convención Star Wars y Generaciones de Ciencia Ficción, el Conservatorio de Vichy Communauté propone una inmersión musical en el corazón de las mayores epopeyas de la gran pantalla."
    ],
    "nl": [
      "Als onderdeel van de conventie Star Wars and Science Fiction Generations biedt het Conservatoire de Vichy Communauté een muzikale onderdompeling in het hart van de grootste heldendaden van het witte doek."
    ]
  },
