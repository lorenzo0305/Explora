  "rdfs:comment": {
    "de": [
      "31 Zimmer umfasst dieses Hotel in Firminy, darunter Doppel-, Dreibett- und Familienzimmer.\r\nDas Bistrot bietet eine französische Küche. in einer warmen und freundlichen Atmosphäre."
    ],
    "en": [
      "31 rooms make up this hotel in Firminy, including double, triple and family rooms.\r\nThe Bistro offers French cuisine in a warm and friendly atmosphere."
    ],
    "it": [
      "questo hotel di Firminy dispone di 31 camere, tra cui doppie, triple e familiari.\r\nIl Bistrot offre cucina francese in un'atmosfera calda e accogliente."
    ],
    "fr": [
      "31 chambres composent cet hôtel de Firminy, dont des chambres doubles, triples et familiales.\r\nLe Bistrot propose une cuisine française. dans une ambiance chaleureuse et conviviale."
    ],
    "es": [
      "este hotel de Firminy dispone de 31 habitaciones, entre dobles, triples y familiares.\r\nEl Bistrot ofrece cocina francesa en un ambiente cálido y acogedor."
    ],
    "nl": [
      "dit hotel in Firminy heeft 31 kamers, waaronder tweepersoons-, driepersoons- en familiekamers.\r\nDe Bistrot biedt een Franse keuken in een warme en vriendelijke sfeer."
    ]
  },
