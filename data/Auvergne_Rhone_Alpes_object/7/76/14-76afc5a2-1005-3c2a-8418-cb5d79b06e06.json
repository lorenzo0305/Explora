      "dc:description": {
        "de": [
          "Treffen Sie sich am Sonntag, den 6. Juli 2025, zu den Animationen der Tour de France in Hucqueliers.\nBitte beachten Sie Parken auf der Strecke verboten."
        ],
        "en": [
          "Join us on Sunday July 6, 2025 for the Tour de France in Hucqueliers.\nPlease note! No parking on the route."
        ],
        "it": [
          "Domenica 6 luglio 2025, il Tour de France si svolgerà a Hucqueliers.\nAttenzione! Non è possibile parcheggiare lungo il percorso."
        ],
        "fr": [
          "Rendez-vous le dimanche 6 juillet 2025 pour les animations du Tour de France à Hucqueliers.\nAttention ! Stationnement interdit sur le parcours."
        ],
        "es": [
          "Únase a nosotros el domingo 6 de julio de 2025 para asistir a las pruebas del Tour de Francia en Hucqueliers.\n¡Atención! No se puede aparcar en el recorrido."
        ],
        "nl": [
          "Kom op zondag 6 juli 2025 naar de Tour de France in Hucqueliers.\nLet op! Geen parkeergelegenheid op de route."
        ]
      },
