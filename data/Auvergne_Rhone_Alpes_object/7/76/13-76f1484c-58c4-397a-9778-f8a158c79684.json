  "rdfs:comment": {
    "de": [
      "9-Loch-Golfplatz.\r\nErwachsenenkurse - Von einem professionellen Golflehrer geleitete Golfschule, die Kurse und Ratschläge erteilt (auch für Erwachsene) - Wettbewerbe - Ausflüge ins Freie - Praktika für Jugendliche und Erwachsene auf allen Niveaustufen.\r\nStändiger Zugang."
    ],
    "en": [
      "9-hole golf course.\r\nAdult tuition - Golf lessons and golfing tips with a professional instructor (children and adults) - Competitions - Golfing excursions - Courses for adults and children of all levels.\r\nPermanently open."
    ],
    "it": [
      "Percorso a 9 buche.\r\nCorsi per adulti - Scuola di golf con la supervisione di un istruttore professionista che impartisce lezioni e consigli (anche agli adulti) - Gare - Uscite all'aperto - Corsi per giovani e adulti a tutti i livelli.\r\nAccesso permanente."
    ],
    "fr": [
      "Parcours 9 trous.\r\nCours adultes - École de golf encadrée par un éducateur professionnel qui dispense cours et conseils (aux adultes également) - Compétitions - Sorties extérieures - Stages jeunes et adultes tous niveaux.\r\nAccès permanent."
    ],
    "es": [
      "Campo de 9 hoyos.\r\nCursos para adultos - Escuela de golf supervisada por un instructor profesional que da clases y consejos (también a los adultos) - Competiciones - Salidas al aire libre - Cursos para jóvenes y adultos de todos los niveles.\r\nAcceso permanente."
    ],
    "nl": [
      "9-holes baan.\r\nLessen voor volwassenen - Golfschool onder toezicht van een professionele instructeur die lessen en advies geeft (ook aan volwassenen) - Wedstrijden - Buitenritten - Jeugd- en volwassenentrainingen op alle niveaus.\r\nPermanente toegang."
    ]
  },
