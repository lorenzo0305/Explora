  "rdfs:comment": {
    "de": [
      "Freie Besichtigung mit Dokument. Die Kirche Sainte-Anne (ISMH) ist eine ehemalige herrschaftliche Kapelle (12. Jh.). Sie wurde restauriert und beherbergt 3 Glasfenster aus der 2013 abgerissenen Kirche Saint-Blaise. Sehenswert: der Glockenturm mit Mauer und der Grabstein von Alix du Breuil (MH)"
    ],
    "en": [
      "Free visit with a leaflet. This church is an ancient seigniorial chapel (12th century). It was restored and welcome 3 stained-glass windows of the demolished Saint-Blaise chruch. Tosee : architectural elements and the tombstone of Alix de Breuil (1300)."
    ],
    "it": [
      "Visita gratuita con documentazione. La chiesa di Sainte-Anne (ISMH) è un'antica cappella signorile (XII secolo). È stata restaurata e ospita 3 vetrate provenienti dalla chiesa di Saint-Blaise demolita nel 2013. Da vedere: il muro del campanile e la lapide di Alix du Breuil (MH)"
    ],
    "fr": [
      "Visite libre avec document. L'église Sainte-Anne (ISMH) est une ancienne chapelle seigneuriale (XIIe). Elle a été restaurée et accueille 3 vitraux de l'église Saint-Blaise démolie en 2013. A voir : le clocher-mur et la pierre tombale d'Alix du Breuil (MH)"
    ],
    "es": [
      "Visita gratuita con documentación. La iglesia de Sainte-Anne (ISMH) es una antigua capilla señorial (siglo XII). Ha sido restaurada y alberga 3 vidrieras de la iglesia de Saint-Blaise demolida en 2013. Para ver: el muro del campanario y la lápida de Alix du Breuil (MH)"
    ],
    "nl": [
      "Gratis bezoek met documentatie. De kerk Sainte-Anne (ISMH) is een voormalige seigneuriale kapel (12e eeuw). Het is gerestaureerd en herbergt 3 gebrandschilderde ramen van de in 2013 gesloopte Saint-Blaise kerk. Te zien: de klokkentoren-muur en de grafsteen van Alix du Breuil (MH)"
    ]
  },
  "rdfs:label": {
    "en": [
      "Sainte-Anne Church"
    ],
