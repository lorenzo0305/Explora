  "rdfs:comment": {
    "de": [
      "Die \"Taverne Maître Kanter\" ist der ideale Ort für alle Ihre Mahlzeiten, ob Geschäftsessen oder einfach im Freundeskreis – mein Team und ich freuen uns darauf, Sie in gastfreundlichem Ambiente zu empfangen. Für einen Vorgeschmack auf die sommerliche Freiheit sorgt unsere schattige Terrasse."
    ],
    "en": [
      "Feel like sauerkraut or a platter of seafood? Head for the Taverne de Maître Kanter. We're easy to find, just follow the directions to Châteaucreux stations, we are just across the road."
    ],
    "it": [
      "Avete voglia di un piatto di crauti o di frutti di mare, o semplicemente di un piatto da brasserie? Andate alla Taverne Brasserie!\r\nI piatti sono fatti in casa, dall'antipasto al dessert!"
    ],
    "fr": [
      "Envie d’une choucroute ou d’un plateau de fruits de mer ou tout simplement d'un plat \"brasserie\" ? Direction la Taverne Brasserie!\r\nLes plats sont fait maison de l'entrée au dessert !"
    ],
    "es": [
      "¿Le apetece un plato de chucrut o de marisco, o simplemente un plato de brasserie? Diríjase a la Taverne Brasserie\r\nLos platos son caseros, desde el entrante hasta el postre"
    ],
    "nl": [
      "Zin in een zuurkool- of zeevruchtenschotel, of gewoon een brasserieschotel? Ga dan naar de Taverne Brasserie!\r\nDe gerechten zijn huisgemaakt van voorgerecht tot dessert!"
    ]
  },
