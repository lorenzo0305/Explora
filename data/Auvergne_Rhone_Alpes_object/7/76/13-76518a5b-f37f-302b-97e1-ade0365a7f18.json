  "rdfs:comment": {
    "de": [
      "Caleden ist mit einem Hotel** und einer Residenz verbunden und empfängt Kurgäste für Thermalkuren und Gesundheitsaufenthalte (6 bis 12 Tage) auf einer Etage, die ausschließlich für die Behandlung von Rheumatologie reserviert ist."
    ],
    "en": [
      "Linked to a hotel** and a residence, Caleden welcomes visitors for thermal cures and health stays (6 to 12 days) on a floor exclusively reserved for rheumatology treatment."
    ],
    "it": [
      "Collegato a un hotel** e a un residence, Caleden accoglie i curisti per cure termali e soggiorni di salute (da 6 a 12 giorni) su un piano riservato esclusivamente alle cure reumatologiche."
    ],
    "fr": [
      "Relié à un hôtel** et à une résidence, Caleden accueille les curistes pour des cures thermales et des séjours santé (6 à 12 jours) sur un étage exclusivement réservé au traitement de la rhumatologie."
    ],
    "nl": [
      "Verbonden met een hotel** en een residentie, verwelkomt Caleden curisten voor thermale kuren en gezondheidsverblijven (6 tot 12 dagen) op een verdieping die exclusief gereserveerd is voor reumatologische behandelingen."
    ],
    "es": [
      "Conectado a un hotel** y a una residencia, Caleden acoge a curistas para curas termales y estancias de salud (de 6 a 12 días) en una planta reservada exclusivamente a tratamientos reumatológicos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Thermes de Chaudes-Aigues - Centre thermal Caleden"
    ]
  },
