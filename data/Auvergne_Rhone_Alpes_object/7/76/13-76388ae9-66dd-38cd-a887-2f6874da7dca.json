  "rdfs:comment": {
    "de": [
      "Ein Sportparcours im Freien, der Fitness und Street-Parkour miteinander verbindet. Ein vernetzter Sportparcours.\r\nDie Route beginnt auf dem Vorplatz des Alain-Colas-Gymnasiums und verläuft in aufeinanderfolgenden Phasen bis zum neuen Platz am Schwimmbad."
    ],
    "en": [
      "An open-air fitness trail combining fitness and street-parkour. A connected sports trail.\r\nThe route, which begins on the forecourt of the Alain Colas gymnasium, stretches in successive phases to the new swimming pool square."
    ],
    "it": [
      "Un percorso di fitness all'aperto che combina fitness e street-parkour. Un percorso sportivo collegato.\r\nIl percorso, che inizia nel piazzale della palestra Alain Colas, si estende in fasi successive fino alla piazza della nuova piscina."
    ],
    "fr": [
      "Un parcours sportif plein-air qui mêle fitness et street-parkour. Un parcours sportif connecté.\r\nL’itinéraire, qui débute sur le parvis du gymnase Alain Colas, s’étire par phases successives jusqu’au nouveau square de la piscine."
    ],
    "es": [
      "Un sendero de fitness al aire libre que combina fitness y street-parkour. Un recorrido deportivo conectado.\r\nEl recorrido, que comienza en la explanada del gimnasio Alain Colas, se extiende en fases sucesivas hasta la plaza de la nueva piscina."
    ],
    "nl": [
      "Een outdoor fitnessparcours dat fitness en streetparkour combineert. Een aaneengesloten sportparcours.\r\nDe route, die begint op het voorplein van de Alain Colas-gymzaal, strekt zich in opeenvolgende fasen uit tot aan het nieuwe zwembadplein."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parcours Sportif de Villefontaine"
    ]
  },
