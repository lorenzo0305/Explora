  "rdfs:comment": {
    "de": [
      "Sympathische Bar im Zentrum von Châtillon-en-Diois, nur wenige Schritte vom mittelalterlichen Dorf entfernt. Kaffee, Bier vom Fass, Aperitif, Sirup und Fruchtsäfte..."
    ],
    "en": [
      "Friendly bar in the center of Châtillon-en-Diois, a stone's throw from the medieval village. Coffee, draught beer, aperitifs, syrups and fruit juices..."
    ],
    "it": [
      "Bar accogliente nel centro di Châtillon-en-Diois, a due passi dal borgo medievale. Caffè, birra alla spina, aperitivo, sciroppo e succo di frutta..."
    ],
    "fr": [
      "Bar sympathique, au centre de Châtillon-en-Diois, à deux pas du village médiéval. Café, bière à la pression, apéritif, sirop et jus de fruits..."
    ],
    "nl": [
      "Gezellige bar in het centrum van Châtillon-en-Diois, op een steenworp afstand van het middeleeuwse dorp. Koffie, bier van het vat, aperitieven, siropen en vruchtensappen..."
    ],
    "es": [
      "Bar acogedor en el centro de Châtillon-en-Diois, a un paso del pueblo medieval. Café, cerveza de barril, aperitivo, jarabe y zumo de frutas..."
    ]
  },
