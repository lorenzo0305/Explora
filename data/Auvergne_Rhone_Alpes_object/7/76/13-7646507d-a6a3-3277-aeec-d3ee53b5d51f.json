  "rdfs:comment": {
    "de": [
      "Die ehemalige Sterne-Pâtissière Émilie empfängt Sie in ihrem Feinkostladen am Ausgang von Grignan. Entdecken Sie eine anspruchsvolle Auswahl an Köstlichkeiten, unentbehrlichen Produkten aus der Region, und lassen Sie sich von ihren Pâtisserie-Workshops verführen."
    ],
    "en": [
      "Former star pastry chef, Émilie welcomes you to her gourmet grocery store at the exit of Grignan. Discover a curated selection of delicacies, essential products from the region, and let yourself be tempted by her pastry workshops."
    ],
    "it": [
      "Ex chef pâtissière stellata, Émilie vi accoglie nel suo negozio di delicatessen all'uscita di Grignan. Scoprite una selezione raffinata di golosità, prodotti imperdibili della regione, e lasciatevi tentare dai suoi corsi di pasticceria."
    ],
    "fr": [
      "Ancienne cheffe pâtissière étoilée, Émilie vous accueille dans son épicerie fine à la sortie de Grignan.\r\nDécouvrez une sélection pointue de gourmandises, produits incontournables de la région, et laissez-vous tentez par ses ateliers pâtisserie."
    ],
    "es": [
      "Émilie, antigua chef pastelera galardonada con una estrella Michelin, le da la bienvenida a su tienda de delicatessen a las afueras de Grignan.\r\nDescubra una selección de manjares y productos típicos de la región y déjese seducir por sus talleres de pastelería."
    ],
    "nl": [
      "Voormalig sterchef-patissier, Émilie verwelkomt u in haar delicatessenwinkel aan de uitgang van Grignan. Ontdek een verfijnde selectie lekkernijen, onmisbare producten uit de regio, en laat u verleiden door haar patisserie-workshops."
    ]
  },
