  "rdfs:comment": {
    "de": [
      "Treten Sie ein in die duftende Welt der Rose. Entdecken Sie einen Beruf und nehmen Sie an der Ernte und Destillation der Rose teil."
    ],
    "en": [
      "Enter the fragrant world of roses. As you discover a craft, you'll take part in rose harvesting and distillation."
    ],
    "it": [
      "Entrate nel mondo profumato delle rose. Scoprendo un mestiere, parteciperete alla raccolta e alla distillazione della rosa."
    ],
    "fr": [
      "Entrez dans le monde parfumé de la rose. A la découverte d’un métier, vous participerez à la récolte et à la distillation de la rose."
    ],
    "nl": [
      "Betreed de geurige wereld van rozen. Terwijl je een vak ontdekt, neem je deel aan het oogsten en destilleren van de roos."
    ],
    "es": [
      "Adéntrate en el fragante mundo de las rosas. Mientras descubres un oficio, participarás en la recolección y destilación de la rosa."
    ]
  },
