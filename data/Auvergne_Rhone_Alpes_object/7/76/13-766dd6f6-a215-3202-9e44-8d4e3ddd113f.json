  "rdfs:comment": {
    "de": [
      "Rosette Olivier öffnet Ihnen die Türen ihres Chalet Magique. Treten Sie ein in seine Welt und entdecken Sie seine Kinderbücher, seine gravierten Glaskrüge, seine dekorierten Schiefertafeln oder seine Pyrogravur. Sie werden bestimmt ein Souvenir mit nach Hause nehmen?"
    ],
    "en": [
      "Rosette Olivier opens the doors of her Chalet Magique. Enter her world and discover her children's albums, engraved glass mugs, decorated slates and pyrography. You're sure to leave with a souvenir..."
    ],
    "it": [
      "Rosette Olivier apre le porte del suo Chalet Magique. Entrate nel suo mondo e scoprite i suoi libri per bambini, le tazze di vetro incise, le lavagne decorate e la pirografia. Non mancherete di lasciare un souvenir?"
    ],
    "fr": [
      "Rosette Olivier vous ouvre les portes de son Chalet Magique. Entrez dans son univers et venez découvrir ses albums jeunesse, ses choppes en verre gravé, ses ardoises décorées ou encore sa pyrogravure. Vous repartirez sans doute avec un souvenir…"
    ],
    "nl": [
      "Rosette Olivier opent de deuren van haar Chalet Magique. Betreed haar wereld en ontdek haar kinderboeken, gegraveerde glazen mokken, gedecoreerde leien en pyrografie. Je gaat zeker weg met een souvenir?"
    ],
    "es": [
      "Rosette Olivier le abre las puertas de su Chalet Magique. Entre en su mundo y descubra sus libros infantiles, tazas de cristal grabadas, pizarras decoradas y pirograbados. Seguro que se lleva un recuerdo.."
    ]
  },
  "rdfs:label": {
    "en": [
      "Le Chalet Magique"
    ],
    "fr": [
      "Le Chalet Magique"
    ]
  },
