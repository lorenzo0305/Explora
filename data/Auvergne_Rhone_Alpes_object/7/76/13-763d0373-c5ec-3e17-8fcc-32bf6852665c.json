  "rdfs:comment": {
    "de": [
      "Designerboutique: Textilkreationen, Silberschmuck, Töpferwaren, Seifen, Draht, Blumenpapier, Stifte und Holzbretter, Karten?\r\n Lokale und vielfältige Kreationen, die es zu entdecken gilt!"
    ],
    "en": [
      "Discover the creations of 2 potters and a textile designer. Anne, Ariane and Aurélia will show you their world in this little shop. Utility pottery and colourful textile creations mingle with a small selection of stationery.\r\nVisitors stream in for their favourite items and you will discover a wide variety of creations.\r\nAn ideal place to buy gifts or souvenirs of Bauges!"
    ],
    "it": [
      "Negozio di design: creazioni tessili, gioielli in argento, ceramiche, saponi, filo di ferro, carta per fioristi, penne e tavole di legno, creazione di carte?\r\n Scoprite una vasta gamma di creazioni locali!"
    ],
    "fr": [
      "Boutique de créateurs : créations textiles, bijoux en argent, poterie, savons, fil de fer, paper fleuriste, stylos et planches en bois, carterie…\r\n Des créations locales et variées à découvrir !"
    ],
    "es": [
      "Tienda de diseño: creaciones textiles, joyas de plata, cerámica, jabones, alambre, papel de floristería, bolígrafos y tableros de madera, tarjetería..\r\n Descubra una amplia gama de creaciones locales"
    ],
    "nl": [
      "Atelier van twee pottenbaksters en een textielontwerpster."
    ]
  },
  "rdfs:label": {
    "en": [
      "Designer shop : Entrée en matières"
    ],
