  "rdfs:comment": {
    "de": [
      "Potenzialentfalterin - Spezialistin für berufliche Begleitung. \r\nProfessionelle Persönlichkeitsanalytikerin / Dynamische Neurofeedback-Praktikerin / Resilienzcoach."
    ],
    "en": [
      "Revealing potential - Specialist in professional coaching. \r\nProfessional Personality Analyst / Dynamic Neurofeedback Practitioner / Resilience Coach."
    ],
    "it": [
      "Mettete in risalto il vostro talento e costruite sulle vostre capacità naturali!\r\nLe nostre storie di vita sono freni e acceleratori delle nostre capacità.  \r\nRisvegliamo quindi questi tesori dimenticati e troviamo il posto che ci spetta!"
    ],
    "fr": [
      "Mettez en lumière votre talent et misez sur vos aptitudes naturelles !\r\nNos histoires de vie sont des freins comme des accélérateurs de nos capacités.  \r\nAlors réveillons ses trésors oubliés pour trouver notre juste place !"
    ],
    "nl": [
      "Zet je talent in de kijker en bouw verder op je natuurlijke capaciteiten!\r\nOnze levensverhalen zijn zowel remmen als versnellers van onze capaciteiten.  \r\nDus laten we deze vergeten schatten wakker maken en onze rechtmatige plaats vinden!"
    ],
    "es": [
      "Destaque su talento y potencie sus habilidades naturales\r\nNuestras historias vitales son a la vez frenos y aceleradores de nuestras capacidades.  \r\nDespertemos estos tesoros olvidados y encontremos el lugar que nos corresponde"
    ]
  },
  "rdfs:label": {
    "de": [
      "Orientiere deine Sinne - um dein Potenzial zu entfalten"
    ],
    "en": [
      "Guide your senses - to reveal your potential"
    ],
    "fr": [
      "Oriente tes sens - Révélez votre potentiel"
    ]
  },
