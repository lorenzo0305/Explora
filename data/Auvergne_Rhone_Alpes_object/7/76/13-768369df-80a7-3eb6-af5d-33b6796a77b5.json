  "rdfs:comment": {
    "de": [
      "Diese Barockkirche befindet sich im oberen Teil des Dorfes Valezan und wurde zwischen 1727 und 1730 erbaut."
    ],
    "en": [
      "Located in the upper part of the village of Valezan, this baroque church was built between 1727 and 1730."
    ],
    "it": [
      "Situata nella parte alta del villaggio di Valezan, questa chiesa barocca fu costruita tra il 1727 e il 1730."
    ],
    "fr": [
      "Située dans la partie haute du village de Valezan, cette église baroque a été édifiée entre 1727 et 1730."
    ],
    "es": [
      "Situada en la parte alta del pueblo de Valezan, esta iglesia barroca fue construida entre 1727 y 1730."
    ],
    "nl": [
      "Deze barokke kerk ligt in het hoger gelegen deel van het dorp Valezan en werd gebouwd tussen 1727 en 1730."
    ]
