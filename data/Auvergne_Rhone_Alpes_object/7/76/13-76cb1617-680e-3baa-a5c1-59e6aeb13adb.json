  "rdfs:comment": {
    "de": [
      "The White Bear ist der unumgängliche Ort in Montalbert, um in einer warmen und entspannten Atmosphäre etwas zu trinken oder zu essen.\n\nNach 23 Uhr herrscht Nachtbar- und Feststimmung mit zahlreichen Abendveranstaltungen!"
    ],
    "en": [
      "The White Bear is the place to be in Montalbert for a drink or a bite to eat, in a warm and relaxed atmosphere.\r\n\r\nAfter 11pm, it's a nightclub with a festive atmosphere and lots of parties!"
    ],
    "it": [
      "L'Orso Bianco è il posto giusto a Montalbert per un drink o un boccone, in un'atmosfera calda e rilassata.\n\nDopo le 23.00 si respira un'atmosfera da bar notturno, con tante feste tra cui scegliere!"
    ],
    "fr": [
      "The White Bear est le lieu incontournable de Montalbert pour boire un verre ou manger, dans une ambiance chaleureuse et décontractée.\n\nAprès 23h, ambiance bar de nuit et festive avec de nombreuses soirées !"
    ],
    "es": [
      "El Oso Blanco es el lugar ideal en Montalbert para tomar una copa o comer algo, en un ambiente cálido y relajado.\n\nA partir de las 23:00, el ambiente es de bar nocturno y festivo"
    ],
    "nl": [
      "De Witte Beer is dé plek in Montalbert voor een drankje of een hapje, in een warme en ontspannen sfeer.\r\n\r\nNa 23.00 uur heerst er een feestelijke barsfeer, met genoeg feestjes om uit te kiezen!"
    ]
  },
  "rdfs:label": {
    "de": [
      "Stimmungsvoller Pub / Bar \"The White Bear"
    ],
    "en": [
      "Pub, Snack the White Bear"
    ],
    "fr": [
      "Pub / Bar d'ambiance \"The White Bear\""
    ],
    "nl": [
      "Pub Snack, Lounge Bar \"the White Bear\""
    ]
  },
