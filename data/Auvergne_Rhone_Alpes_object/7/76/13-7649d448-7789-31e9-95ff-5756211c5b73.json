  "rdfs:comment": {
    "de": [
      "Trip Tribu lädt Sie zu Abenteuern ein und vermietet komfortabel ausgestattete Vans, die sich perfekt für die Erkundung des Ain und darüber hinaus eignen. Entdecken Sie selbstständig mit einem lokalen Unternehmen, das Nähe, Freundlichkeit und Respekt für die Natur verbindet."
    ],
    "en": [
      "Trip Tribu invites you to explore the Ain and beyond by renting comfortable, fully-equipped vans. Explore independently with a local company that combines proximity, conviviality and respect for nature."
    ],
    "it": [
      "Trip Tribu vi invita a partire all'avventura noleggiando furgoni attrezzati e confortevoli, perfetti per esplorare l'Ain e non solo. Esplorate in modo indipendente con una compagnia locale che unisce vicinanza, convivialità e rispetto per la natura."
    ],
    "fr": [
      "Trip Tribu vous invite à l’aventure en louant des vans aménagés tout confort, parfaits pour explorer l’Ain et au-delà. Partez à la découverte en autonomie avec une entreprise locale qui allie proximité, convivialité et respect de la nature."
    ],
    "nl": [
      "Trip Tribu nodigt u uit om op avontuur te gaan door het huren van volledig uitgeruste, comfortabele busjes, perfect om de Ain en daarbuiten te verkennen. Ga op een onafhankelijke manier op verkenning met een lokaal bedrijf dat nabijheid, gezelligheid en respect voor de natuur combineert."
    ],
    "es": [
      "Trip Tribu le invita a embarcarse en una aventura alquilando furgonetas totalmente equipadas y confortables, perfectas para explorar el Ain y más allá. Explore de forma independiente con una empresa local que combina proximidad, convivencia y respeto por la naturaleza."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Trip Tribu - Location de van aménagé"
    ]
  },
