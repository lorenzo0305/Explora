  "rdfs:comment": {
    "de": [
      "Claire und Séverine freuen sich, Ihnen Essenti'elle Institut et Spa vorzustellen, einen Bereich für Gesichts- und Körperbehandlungen, Modellage, Make-up zur Entspannung und zum Wohlbefinden, der einzigartig in Le Puy en Velay ist"
    ],
    "en": [
      "Claire and Séverine are happy to introduce you to Essenti'elle Institut et Spa, a unique space for face and body care, modelling, make-up, relaxation and well-being in Le Puy en Velay"
    ],
    "it": [
      "Claire e Séverine sono liete di presentarvi l'Essenti'elle Institut et Spa, uno spazio unico per la cura del viso e del corpo, la modellazione, il trucco e il relax a Le Puy en Velay"
    ],
    "fr": [
      "Claire et Séverine sont heureuses de vous faire découvrir Essenti'elle Institut et Spa, un espace de soins visage et corps, modelage, maquillage de détente et de bien-être unique au Puy en Velay"
    ],
    "es": [
      "Claire y Séverine se complacen en presentarle Essenti'elle Institut et Spa, un espacio único para el cuidado del rostro y del cuerpo, el modelado, el maquillaje y la relajación en Le Puy en Velay"
    ],
    "nl": [
      "Claire en Séverine stellen u graag voor aan Essenti'elle Institut et Spa, een unieke ruimte voor gezichts- en lichaamsverzorging, modellenwerk, make-up en ontspanning in Le Puy en Velay"
    ]
  },
