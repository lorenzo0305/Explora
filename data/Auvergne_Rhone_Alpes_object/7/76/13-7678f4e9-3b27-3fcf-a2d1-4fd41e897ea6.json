  "rdfs:comment": {
    "de": [
      "Diese Route führt von Moûtiers aus zum höchstgelegenen Skigebiet Europas!\r\nEine sportliche Rundtour über Saint-Laurent-de-la-Côte, Saint-Martin-de-Belleville, Les Menuires vor der Ankunft in Val Thorens und zurück über Saint-Jean-de-Belleville."
    ],
    "en": [
      "This route from Moûtiers leads to Europe's highest ski resort!\r\nA sporty loop passing through Saint-Laurent-de-la-Côte, Saint-Martin-de-Belleville, Les Menuires before arriving in Val Thorens and returning via Saint-Jean-de-Belleville."
    ],
    "it": [
      "Questo itinerario da Moûtiers conduce alla stazione più alta d'Europa!\r\nUn anello sportivo che tocca Saint-Laurent-de-la-Côte, Saint-Martin-de-Belleville e Les Menuires prima di arrivare in Val Thorens e tornare via Saint-Jean-de-Belleville."
    ],
    "fr": [
      "Cet itinéraire au départ de Moûtiers mène à la plus haute station d'Europe !\r\nUne boucle sportive passant par Saint-Laurent-de-la-Côte, Saint-Martin-de-Belleville, les Menuires avant l'arrivée à Val Thorens et retour par Saint-Jean-de-Belleville."
    ],
    "es": [
      "Esta ruta desde Moûtiers conduce a la estación más alta de Europa\r\nUn bucle deportivo que pasa por Saint-Laurent-de-la-Côte, Saint-Martin-de-Belleville y Les Menuires antes de llegar a Val Thorens y regresar por Saint-Jean-de-Belleville."
    ],
    "nl": [
      "Deze route vanuit Moûtiers leidt naar het hoogst gelegen skioord van Europa!\r\nEen sportieve lus die Saint-Laurent-de-la-Côte, Saint-Martin-de-Belleville en Les Menuires aandoet voordat je aankomt in Val Thorens en terugkeert via Saint-Jean-de-Belleville."
    ]
  },
  "rdfs:label": {
    "en": [
      "Moûtiers - Val Thorens"
    ],
    "fr": [
      "Moûtiers - Val Thorens"
    ]
  },
