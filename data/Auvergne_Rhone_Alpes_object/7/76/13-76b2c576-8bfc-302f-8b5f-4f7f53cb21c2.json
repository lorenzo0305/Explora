  "rdfs:comment": {
    "de": [
      "Die Bibliothek von Ceyssat ist in einem alten Backofen untergebracht. Sie bietet einen vielfältigen Bestand an Büchern, DVDs und CDs aus eigenen Beständen, aus der Mediathek des Departements und aus dem Lesenetzwerk Dômes Sancy Artense."
    ],
    "en": [
      "The Ceyssat library is housed in an old oven. It offers a varied selection of books, DVDs and CDs from its own collections, from the departmental media library and from the Dômes Sancy Artense reading network."
    ],
    "it": [
      "La biblioteca di Ceyssat è ospitata in un vecchio forno. Offre un'ampia gamma di libri, DVD e CD provenienti dalle proprie collezioni, dalla mediateca dipartimentale e dalla rete di lettura Dômes Sancy Artense."
    ],
    "fr": [
      "La bibliothèque de Ceyssat est abritée dans un ancien four. Elle propose un fonds varié avec livres DVD, CD provenant de ses collections propres, de la médiathèque départementale et du réseau de lecture Dômes Sancy Artense."
    ],
    "es": [
      "La biblioteca de Ceyssat está instalada en un antiguo horno. Ofrece una amplia gama de libros, DVD y CD procedentes de sus propias colecciones, de la mediateca departamental y de la red de lectura Dômes Sancy Artense."
    ],
    "nl": [
      "De bibliotheek van Ceyssat is gevestigd in een oude oven. Het biedt een breed scala aan boeken, dvd's en cd's uit de eigen collecties, uit de mediatheek van het departement en uit het leesnetwerk Dômes Sancy Artense."
    ]
  },
