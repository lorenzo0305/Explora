  "rdfs:comment": {
    "de": [
      "Ort der Aufbewahrung, Ausstellung und Aufwertung von Künstlerbüchern. Le Manoir des livres ist eine Erbschaftsbibliothek, die sich der Erschließung von Künstlerbüchern widmet."
    ],
    "en": [
      "A place which conserves, displays and appreciates artist books. The 'Manoir des Livres' is a heritage library dedicated to showcasing artist books."
    ],
    "it": [
      "Un luogo per la conservazione, l'esposizione e la promozione dei libri d'artista. Le Manoir des livres è una biblioteca dedicata alla presentazione di libri d'artista."
    ],
    "fr": [
      "Niché sur le massif des Voirons, à Lucinges, le Manoir des livres est une bibliothèque patrimoniale, un véritable écrin dédié à l'écrivain Michel Butor et aux livres d'artiste."
    ],
    "es": [
      "Un lugar para la conservación, exposición y promoción de libros de artista. Le Manoir des livres es una biblioteca patrimonial dedicada a mostrar libros de artista."
    ],
    "nl": [
      "De Manoir des livres, genesteld in de Voirons in Lucinges, is een erfgoedbibliotheek, een echte vitrine gewijd aan de schrijver Michel Butor en aan kunstenaarsboeken."
    ]
  },
