  "rdfs:comment": {
    "de": [
      "Der Fluss Reyssouze und sein Kanal bilden das Rückgrat dieses Naturparks. Die Atmosphäre des Wassers lädt zu einem ruhigen Spaziergang ein, nur wenige Schritte von der Apotheke und dem königlichen Kloster von Brou entfernt."
    ],
    "en": [
      "The Reyssouze and its canal form the backbone of this natural park. The watery atmosphere invites you to take a peaceful stroll, just a stone?s throw from the apothecary and the royal monastery of Brou."
    ],
    "it": [
      "La Reyssouze e il suo canale costituiscono la spina dorsale di questo parco naturale. L'atmosfera acquatica invita a una passeggiata tranquilla, a due passi dalla farmacia e dal monastero reale di Brou."
    ],
    "fr": [
      "La Reyssouze et son canal tracent l’épine dorsale de ce parc naturel. Une atmosphère d’eau appelle à une flânerie paisible à deux pas de l’apothicairerie et du monastère royal de Brou."
    ],
    "es": [
      "El Reyssouze y su canal forman la espina dorsal de este parque natural. El ambiente acuático invita a pasear tranquilamente, a dos pasos de la botica y del monasterio real de Brou."
    ],
    "nl": [
      "De Reyssouze en het kanaal vormen de ruggengraat van dit natuurpark. De waterige sfeer nodigt uit tot een rustige wandeling, op een steenworp afstand van de apotheek en het koninklijke klooster van Brou."
    ]
  },
  "rdfs:label": {
