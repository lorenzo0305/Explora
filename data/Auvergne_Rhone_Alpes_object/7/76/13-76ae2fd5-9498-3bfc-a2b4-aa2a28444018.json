  "rdfs:comment": {
    "de": [
      "Reitzentrum und Tourismuszentrum in einer familiären Atmosphäre.\r\nIch biete alle Arten von Aktivitäten im Zusammenhang mit dem Reiten an.\r\nVon der Entdeckung bis zur Perfektionierung."
    ],
    "en": [
      "Equestrian center and tourism center in a family atmosphere.\r\nI offer all types of riding-related activities.\r\nFrom discovery to improvement."
    ],
    "it": [
      "Il centro di equitazione Etoiles Versoises, situato a Vers sur Méouge (26560), in mezzo alle montagne, vi offre: passeggiate, passeggiate a mano, lezioni, corsi di formazione, acrobazie, lavoro a piedi, ecc\r\nBambini, adulti, principianti e avanzati."
    ],
    "fr": [
      "Le centre équestre les Etoiles Versoises, situé à Vers sur Méouge (26560), au milieu des montagnes, vous propose : randonnée, balade en main, cours, stage, voltige, travail à pied...etc \r\nEnfants, adultes, débutant et confirmé."
    ],
    "nl": [
      "Manege en toeristisch centrum in een familiale sfeer.\r\nIk bied alle soorten paardrij-gerelateerde activiteiten aan.\r\nVan ontdekking tot verbetering."
    ],
    "es": [
      "El centro ecuestre Etoiles Versoises, situado en Vers sur Méouge (26560), en plena montaña, le ofrece: paseos por senderos, paseos a mano, clases, cursillos, acrobacias, trabajo a pie, etc\r\nNiños, adultos, jinetes principiantes y avanzados."
    ]
  },
  "rdfs:label": {
