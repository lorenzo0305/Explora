  "rdfs:comment": {
    "de": [
      "Seit 1991 produziert und kreiert die Coutellerie Le Fidèle Klapp- und Tischmesser im Becken von Thiernois.\r\nGegründet von den Eltern des aktuellen Geschäftsführers, führt Thomas Boitel seit 2008 ihre Qualitätspolitik bei seinen Messern fort."
    ],
    "en": [
      "Le Fidèle Knife Makers is a family-run knife factory where several models of knives are produced (the Laguiole and regional mo- dels Le THIERS® and our own créations)."
    ],
    "it": [
      "La Coutellerie Le Fidèle produce e progetta coltelli da tavola e pieghevoli nella zona di Thiers dal 1991.\r\nFondata dai genitori dell'attuale direttore generale, Thomas Boitel porta avanti la sua politica di coltelli di qualità dal 2008."
    ],
    "fr": [
      "Depuis 1991, la Coutellerie Le Fidèle fabrique et créée des couteaux pliants et de table dans le bassin thiernois.\r\nFondée par les parents du gérant actuel, Thomas Boitel perpétue depuis 2008 leur politique de qualité sur ses couteaux."
    ],
    "es": [
      "La Coutellerie Le Fidèle fabrica y diseña cuchillos plegables y de mesa en la región de Thiers desde 1991.\r\nFundada por los padres del actual director general, Thomas Boitel perpetúa su política de cuchillos de calidad desde 2008."
    ],
    "nl": [
      "Coutellerie Le Fidèle maakt en ontwerpt al sinds 1991 vouw- en tafelmessen in de buurt van Thiers.\r\nOpgericht door de ouders van de huidige directeur, zet Thomas Boitel sinds 2008 zijn beleid van kwaliteitsmessen voort."
    ]
  },
