  "rdfs:comment": {
    "de": [
      "Merlyn Escape Game bietet Ihnen Escape Games in Form einer mobilen App an. Ein Einwohner von Peisey hat sich die verschiedenen Szenarien ausgedacht, entworfen und entwickelt. Sie können das Spiel alleine oder zu mehreren spielen, zum Beispiel mit Ihrer Familie!"
    ],
    "en": [
      "Merlyn Escape Game offers escape games in the form of a mobile application. The different scenarios have been devised, designed and developed by a resident of Peisey. You can play alone or with friends and family!"
    ],
    "it": [
      "Merlyn Escape Game trasforma le vostre escursioni in divertenti avventure!\r\nGrazie a un'applicazione mobile creata a Peisey, voi e la vostra famiglia potrete risolvere gli enigmi lungo il percorso. Prenotate online, scaricate l'app e partite per la vostra avventura!"
    ],
    "fr": [
      "Merlyn Escape Game transforme vos randonnées en aventures ludiques ! \r\nGrâce à une appli mobile créée à Peisey, résolvez des énigmes en famille tout au long du parcours. Réservez en ligne, téléchargez l’appli et partez à l’aventure !"
    ],
    "nl": [
      "Merlyn Escape Game verandert je wandelingen in leuke avonturen!\r\nDankzij een mobiele app die in Peisey is gemaakt, kunnen jij en je gezin onderweg puzzels oplossen. Reserveer online, download de app en ga op avontuur!"
    ],
    "es": [
      "Merlyn Escape Game convierte tus excursiones en divertidas aventuras\r\nGracias a una aplicación móvil creada en Peisey, tú y tu familia podréis resolver rompecabezas por el camino. Reserva online, descarga la app y ¡lánzate a la aventura!"
    ]
  },
