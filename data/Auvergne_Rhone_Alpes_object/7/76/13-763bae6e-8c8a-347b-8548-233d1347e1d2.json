  "rdfs:comment": {
    "de": [
      "Die Ferme Auberge des Combes empfängt bis zu 50 Gäste nur nach vorheriger Reservierung. Die angebotenen Mahlzeiten werden zu mehr als der Hälfte aus eigenen Erzeugnissen zubereitet und an einem großen Tisch geteilt. Es wird nur ein Menü serviert."
    ],
    "en": [
      "The ferme auberge des Combes welcomes up to 50 guests by reservation only. Meals are cooked with more than half of the farm's produce, and are shared around a large table. Only one menu is served."
    ],
    "it": [
      "La ferme auberge des Combes accoglie fino a 50 ospiti solo su prenotazione. I pasti offerti sono cucinati utilizzando più della metà dei prodotti della fattoria e vengono condivisi intorno a un grande tavolo. Viene servito un solo menu."
    ],
    "fr": [
      "La ferme auberge des Combes accueille jusqu'à 50 convives sur réservation uniquement les repas proposés sont cuisinés avec plus de la moitié des productions de la ferme et se partagent autour d'une grande table. Un seul menu est servi."
    ],
    "es": [
      "La ferme auberge des Combes acoge hasta 50 comensales sólo con reserva previa. Las comidas que se ofrecen se cocinan con más de la mitad de los productos de la granja y se comparten alrededor de una gran mesa. Sólo se sirve un menú."
    ],
    "nl": [
      "De ferme auberge des Combes verwelkomt tot 50 gasten op reservering. De aangeboden maaltijden worden bereid met meer dan de helft van de producten van de boerderij en worden gedeeld rond een grote tafel. Er wordt slechts één menu geserveerd."
    ]
  },
