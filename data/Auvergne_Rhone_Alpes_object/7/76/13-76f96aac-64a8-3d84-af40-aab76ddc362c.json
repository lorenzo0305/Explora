  "rdfs:comment": {
    "de": [
      "Vermietung von 3 Räumen für Besprechungen, Seminare, Termine... Verfügt außerdem über ein Openspace, in dem man punktuell arbeiten kann. Telefonischer Empfang von Montag bis Freitag von 8 bis 16 Uhr, außer mittwochs für Reservierungen."
    ],
    "en": [
      "Rental of 3 rooms for meetings, seminars, appointments... An openspace is also available for occasional work. Telephone reception Monday to Friday, 8am to 4pm, except Wednesdays for reservations."
    ],
    "it": [
      "Noleggio di 3 sale per riunioni, seminari, appuntamenti, ecc. C'è anche un openspace dove è possibile lavorare di tanto in tanto. Ricezione telefonica dal lunedì al venerdì, dalle 8.00 alle 16.00, tranne il mercoledì per le prenotazioni."
    ],
    "fr": [
      "Location de 3 salles de réunions, séminaires, rendez-vous... Dispose également d'un openspace dans lequel il est possible de venir y travailler ponctuellement. Accueil téléphonique du Lundi au Vendredi de 8h à 16h hormis les mercredis pour réservation."
    ],
    "nl": [
      "Verhuur van 3 zalen voor vergaderingen, seminars, afspraken, enz. Er is ook een open ruimte waar je af en toe kunt werken. Telefonische receptie van maandag tot vrijdag van 8.00 tot 16.00 uur, behalve op woensdag voor boekingen."
    ],
    "es": [
      "Alquiler de 3 salas para reuniones, seminarios, citas, etc. También hay un espacio abierto donde se puede trabajar de vez en cuando. Recepción telefónica de lunes a viernes, de 8.00 a 16.00 horas, excepto los miércoles para reservas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Salle co-working le 4puissance3"
    ]
  },
