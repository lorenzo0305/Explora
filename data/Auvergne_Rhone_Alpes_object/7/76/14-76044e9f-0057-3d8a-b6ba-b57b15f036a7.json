        "de": [
          "Ab Dienstag, dem 2. August, um 11.15 Uhr können Sie sich mit 100% hausgemachten handwerklichen Pizzen, Pasta Box und Trattoria verwöhnen lassen."
        ],
        "en": [
          "From Tuesday, August 2 at 11.15am, treat yourself to 100% artisanal homemade pizzas, pasta boxes and trattoria."
        ],
        "it": [
          "A partire da martedì 2 agosto alle 11.15, concedetevi pizze, scatole di pasta e trattorie 100% fatte in casa."
        ],
        "fr": [
          "Dès le mardi 2 août à 11h15, régalez-vous avec pizzas 100% artisanales faites maison, pasta box et trattoria."
        ],
        "nl": [
          "Vanaf dinsdag 2 augustus om 11.15 uur kun je jezelf trakteren op 100% zelfgemaakte pizza's, pastadozen en trattoria."
        ],
        "es": [
          "A partir del martes 2 de agosto a las 11.15 h, deléitese con pizzas 100% caseras, cajas de pasta y trattoria."
        ]
