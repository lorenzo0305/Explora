  "rdfs:comment": {
    "de": [
      "Ein Mittagessen, ein Abendessen, eine Entspannungspause am See?\r\nProbieren Sie Qualitätsprodukte, Spezialitäten aus Savoyen und dem Südwesten, Froschschenkel und Seefische, delikates Fleisch.\r\nSchöner Blick auf den See und die Dent du Chat."
    ],
    "en": [
      "Lunch, dinner, a relaxing break by the lake?\r\nCome and enjoy quality products, Savoyard and south-western specialities, frogs' legs and lake fish, delicate meats. Beautiful view of the lake and Dent du Chat."
    ],
    "it": [
      "Pranzo, cena, una pausa rilassante in riva al lago?\r\nVenite a gustare i nostri prodotti di qualità, specialità savoiarde e sud-occidentali, cosce di rana e pesci di lago, carni delicate. Splendida vista sul lago e sulla Dent du Chat."
    ],
    "fr": [
      "Un déjeuner, un dîner, une pause détente au bord du lac ?\r\nVenez déguster des produits de qualité,  spécialités savoyardes et du sud ouest, cuisses de grenouilles et poissons de lac, viandes délicates.\r\nBelle vue sur le Lac et la Dent du Chat."
    ],
    "es": [
      "¿Almuerzo, cena, descanso a orillas del lago?\r\nVenga a degustar nuestros productos de calidad, especialidades saboyanas y del suroeste, ancas de rana y pescados de lago, carnes delicadas.\r\nHermosas vistas al lago y a la Dent du Chat."
    ],
    "nl": [
      "Lunch, diner, een ontspannende pauze aan het meer?\r\nKom proeven van onze kwaliteitsproducten, Savoyaardse en zuidwestelijke specialiteiten, kikkerbilletjes en vis uit het meer, verfijnd vlees.\r\nPrachtig uitzicht op het meer en de Dent du Chat."
    ]
  },
  "rdfs:label": {
    "en": [
      "Le San Fermin"
    ],
    "it": [
      "Le San Fermin"
    ],
    "fr": [
      "Le San Fermin"
    ]
  },
