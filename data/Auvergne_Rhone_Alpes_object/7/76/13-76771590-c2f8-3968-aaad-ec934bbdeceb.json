  "rdfs:comment": {
    "de": [
      "Entdecken Sie den Charme des Kanals auf zwei Arten von Kreuzfahrten, die ideal für Natur- und Geschichtsliebhaber sind! 1h oder 2h an Bord der \"L'Escapade\"."
    ],
    "en": [
      "Discover the charm of the canal on two types of cruise, ideal for nature and history lovers! 1h or 2h aboard the \"Escapade\"."
    ],
    "it": [
      "Scoprite il fascino del canale con due tipi di crociera, ideali per gli amanti della natura e della storia! 1 o 2 ore a bordo della \"Escapade\"."
    ],
    "fr": [
      "Venez découvrir le charme du canal à travers deux types de croisières, idéales pour les amoureux de nature et d'histoire ! 1h ou 2h à bord de \"l'Escapade\"."
    ],
    "nl": [
      "Ontdek de charme van het kanaal tijdens twee soorten boottochten, ideaal voor natuur- en geschiedenisliefhebbers! 1 of 2 uur aan boord van de \"Escapade\"."
    ],
    "es": [
      "Descubra el encanto del canal en dos tipos de crucero, ¡ideales para los amantes de la naturaleza y la historia! 1 o 2 horas a bordo del \"Escapade\"."
    ]
  },
