  "rdfs:comment": {
    "de": [
      "Das Zentrum Néréides Plongée bietet verschiedene Aktivitäten rund um das Tauchen an, hauptsächlich mit der Tauchflasche, aber auch freies Tauchen (Apnoe) oder ganz einfach Unterwasserwanderungen in den umliegenden Gewässern."
    ],
    "en": [
      "The center Néréides Plongée offers many activities such as diving, snorkeling and underwater rides."
    ],
    "it": [
      "Il centro Nereides Plongée offre diverse attività subacquee, principalmente immersioni con autorespiratore, ma anche immersioni in apnea (apnea) o semplicemente escursioni subacquee nelle acque circostanti."
    ],
    "fr": [
      "Le centre Néréides Plongée propose diverses activités autour de la plongée, principalement en bouteille, mais également en libre (apnée) ou tout simplement en randonnée subaquatique, dans les plans d’eau environnants."
    ],
    "nl": [
      "Het centrum Nereides Plongée biedt verschillende duikactiviteiten aan, voornamelijk diepzeeduiken, maar ook vrijduiken (apneu) of gewoon onderwaterexcursies in het omringende water."
    ],
    "es": [
      "El centro Nereides Plongée ofrece diversas actividades de buceo, principalmente submarinismo, pero también apnea o simplemente excursiones submarinas por las aguas circundantes."
    ]
  },
