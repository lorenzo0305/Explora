  "rdfs:comment": {
    "de": [
      "Die sanft abfallenden Ufer dieses Teichs sind günstig für Amphibien wie Laubfrösche, Laubfrösche und Erdkröten, die sich in der Randvegetation fortpflanzen."
    ],
    "en": [
      "The gently sloping banks of this pond are favourable for amphibians such as green frogs and tree frogs, common toads that breed in the border vegetation."
    ],
    "it": [
      "Le sponde in leggera pendenza di questo stagno sono favorevoli agli anfibi, come rane verdi e raganelle, e ai rospi comuni che si riproducono nella vegetazione circostante."
    ],
    "fr": [
      "Les berges en pente douce de cette mare sont favorables aux amphibiens tels que les grenouilles et rainettes vertes, les crapauds communs qui se reproduisent dans la végétation bordière."
    ],
    "es": [
      "Las orillas ligeramente inclinadas de este estanque son favorables para los anfibios, como las ranas verdes y las ranas arborícolas, y los sapos comunes que se reproducen en la vegetación circundante."
    ],
    "nl": [
      "De zacht glooiende oevers van deze vijver zijn gunstig voor amfibieën zoals groene kikkers en boomkikkers, en padden die in de omringende vegetatie broeden."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Mare communale des Gannes"
    ]
  },
