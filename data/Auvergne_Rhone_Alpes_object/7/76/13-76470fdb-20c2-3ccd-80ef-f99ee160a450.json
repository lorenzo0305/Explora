  "rdfs:comment": {
    "de": [
      "Club de Randonnée Vinsobrais (Wanderclub Vinsobrais). Ausflüge jeden Mittwoch. Für alle offen. Ausgehanzeige auf der Tafel des CATV neben dem Tourismusbüro."
    ],
    "en": [
      "Club de Randonnée Vinsobrais. Outings every Wednesday. Open to all. Outings posted on the CATV board next to the Tourist Office."
    ],
    "it": [
      "Club de Randonnée Vinsobrais. Gita ogni mercoledì. Aperto a tutti. Le uscite sono affisse sul tabellone del CATV accanto all'Ufficio del Turismo."
    ],
    "fr": [
      "Club de Randonnée Vinsobrais. Sortie tous les mercredis. Ouvert à tous. Affichage de sortie sur le panneau du CATV à côté de l'Office de Tourisme."
    ],
    "nl": [
      "Club de Randonnée Vinsobrais. Uitstapjes elke woensdag. Voor iedereen toegankelijk. Informatie over uitstapjes op het CATV-bord naast het VVV-kantoor."
    ],
    "es": [
      "Club de Randonnée Vinsobrais. Salida todos los miércoles. Abierto a todos. Las salidas se publican en el tablón de anuncios del CATV, junto a la Oficina de Turismo."
    ]
  },
