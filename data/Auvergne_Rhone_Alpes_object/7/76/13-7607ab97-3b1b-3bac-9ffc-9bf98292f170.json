  "rdfs:comment": {
    "de": [
      "Eine Reihe von Buckeln und Kurven, auf denen sich Groß und Klein nach Herzenslust austoben können! BMX, Mountainbike, Roller, Inlineskates oder Draisine - Sie haben die Wahl!"
    ],
    "en": [
      "A series of bumps and turns on which young and old alike will have a blast! BMX, mountain bike, scooter, roller or balance bike, the choice is yours!"
    ],
    "it": [
      "Una serie di dossi e curve per il divertimento di grandi e piccini! BMX, mountain bike, monopattino, rollerblade o draisienne, a voi la scelta!"
    ],
    "fr": [
      "Une série de bosses et de virages sur lesquelles petits et grands s'en donnent à cœur joie ! BMX, VTT, trottinette, roller ou draisienne, à vous de choisir !"
    ],
    "es": [
      "Una serie de baches y curvas para disfrute de grandes y pequeños BMX, bicicleta de montaña, patinete, roller o draisienne, ¡tú eliges!"
    ],
    "nl": [
      "Een reeks hobbels en bochten voor jong en oud om van te genieten! BMX, mountainbike, step, skeeler of draisienne, de keuze is aan jou!"
    ]
  },
