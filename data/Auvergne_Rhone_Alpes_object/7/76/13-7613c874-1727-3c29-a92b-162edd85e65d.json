  "rdfs:comment": {
    "de": [
      "Der kuppelbare 6er-Sessellift Le Linga liegt 1,2 km vom Dorfzentrum entfernt und bringt Sie auf eine Höhe von etwa 1500 Metern."
    ],
    "en": [
      "Located at 1.2km from the center of the village, the Linga chairlift takes you at an altitude of 15000m."
    ],
    "it": [
      "Situata a 1,2 km dal centro del paese, la seggiovia ad agganciamento automatico Linga a 6 posti vi porta a circa 1.500 m di altitudine."
    ],
    "fr": [
      "Située à 1,2 km du centre du village, le télésiège débrayable 6 places du Linga vous amène à une altitude d'environ 1500 m."
    ],
    "es": [
      "Situado a 1,2 km del centro del pueblo, el telesilla desembragable de 6 plazas Linga le llevará a una altitud de unos 1.500 m."
    ],
    "nl": [
      "De stoeltjeslift Linga ligt op 1,2 km van het dorpscentrum en neemt u mee naar hoogte van ongeveer 1500 meter."
    ]
  },
