  "rdfs:comment": {
    "de": [
      "Yannick und Audrey Pascal sind Bio-Züchter von Aubrac-Kühen und Lacaune-Schafen. Sie stellen Produkte aus der Milch ihrer Schafe her, die auf Märkten und in lokalen Bioläden erhältlich sind."
    ],
    "en": [
      "Organic farmers of Aubrac cows and Lacaune ewes, Yannick and Audrey Pascal make products from their ewes' milk, available at local markets and organic stores."
    ],
    "it": [
      "Allevatori biologici di mucche di Aubrac e pecore di Lacaune, Yannick e Audrey Pascal producono prodotti con il latte delle loro pecore, disponibili nei mercati locali e nei negozi biologici."
    ],
    "fr": [
      "Eleveurs en agriculture biologique de vaches Aubrac et de brebis Lacaune, Yannick et Audrey Pascal fabriquent des produits issus du lait de leurs brebis, disponible sur les marchés et dans les magasins bio locaux."
    ],
    "es": [
      "Yannick y Audrey Pascal, ganaderos ecológicos de vacas Aubrac y ovejas Lacaune, elaboran productos con la leche de sus ovejas, disponibles en mercados locales y tiendas ecológicas."
    ],
    "nl": [
      "Yannick en Audrey Pascal, biologische boeren van koeien uit Aubrac en ooien uit Lacaune, maken producten van de melk van hun ooien die verkrijgbaar zijn op lokale markten en in biologische winkels."
    ]
  },
  "rdfs:label": {
    "fr": [
      "GAEC Pascal"
    ]
  },
