  "rdfs:comment": {
    "de": [
      "Der Technologiepark Porte des Alpes umschließt ein Industriegebiet mit 200 Unternehmen und ist ein atypischer, 140 Hektar großer Park, in dem Unternehmen und Natur nebeneinander liegen."
    ],
    "en": [
      "Surrounding an industrial zone with 200 companies, the Porte des Alpes technology park is an atypical 140-hectare park where business and nature meet."
    ],
    "it": [
      "Circondato da una zona industriale con 200 aziende, il parco tecnologico Porte des Alpes è un parco atipico di 140 ettari in cui si incontrano affari e natura."
    ],
    "fr": [
      "Encerclant une zone industrielle comptant 200 entreprises, le parc technologique de la Porte des Alpes est un parc atypique de 140 hectares où entreprises et nature se côtoient."
    ],
    "es": [
      "Rodeado de una zona industrial con 200 empresas, el parque tecnológico de Porte des Alpes es un parque atípico de 140 hectáreas donde confluyen negocios y naturaleza."
    ],
    "nl": [
      "Het technologiepark Porte des Alpes omringt een industriegebied met 200 bedrijven en is een atypisch park van 140 hectare waar bedrijven en natuur elkaar ontmoeten."
    ]
  },
