  "rdfs:comment": {
    "de": [
      "Blick auf das Panorama. Herberge auf dem Land (725 m über dem Meeresspiegel). Wanderwege, darunter der GR 76. Bereich für Kinder. Spezialitäten: traditionelle Küche und ländliche Mahlzeiten für Wanderer, die zu jeder Tageszeit serviert werden (Wurst, Omelette, Käse)"
    ],
    "en": [
      "Panoramic view. Inn located in the countryside (725 m altitude). Hiking trails including the GR 76. Space for children. Specialities: traditional cuisine and country meals for hikers served at all times (charcuterie, omelette cheese)"
    ],
    "it": [
      "Vista panoramica. Locanda situata in campagna (725 m di altitudine). Sentieri, compreso il GR 76. Spazio per i bambini. Specialità: cucina tradizionale e pasti contadini per escursionisti serviti a qualsiasi ora (salumi, frittata e formaggio)"
    ],
    "fr": [
      "Vue panoramique. Auberge située dans la campagne (725 m d'altitude). Sentiers pédestres dont le GR 76. Espace pour les enfants. Spécialités : cuisine traditionnelle et repas campagnard pour randonneurs servi à toute heure (charcuterie, omelette fromage)"
    ],
    "es": [
      "Vista panorámica. Posada situada en el campo (725 m de altitud). Senderos, incluido el GR 76. Espacio para los niños. Especialidades: cocina tradicional y comidas campestres para excursionistas servidas a cualquier hora (embutidos, tortilla y queso)"
    ],
    "nl": [
      "Panoramisch uitzicht. Herberg gelegen op het platteland (725 m hoogte). Voetpaden waaronder de GR 76. Ruimte voor kinderen. Specialiteiten: traditionele keuken en landelijke maaltijden voor wandelaars die op elk moment worden geserveerd (vleeswaren, omelet en kaas)"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Auberge le Chatoux Fleuri"
    ]
  },
