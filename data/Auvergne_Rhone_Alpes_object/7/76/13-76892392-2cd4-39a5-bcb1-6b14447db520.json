  "rdfs:comment": {
    "de": [
      "Ihr Fahrradgeschäft, das seit über 15 Jahren in Montbrison ansässig ist und sich auf den Verkauf, die Wartung und die Reparatur aller Fahrradmarken spezialisiert hat, empfängt Sie und berät Sie gerne."
    ],
    "en": [
      "Established for over 15 years in Montbrison, your cycle store specializing in the sale, maintenance and repair of all brands of bicycles welcomes and advise you."
    ],
    "it": [
      "Con sede da oltre 15 anni a Montbrison, la vostra ciclofficina specializzata nella vendita, manutenzione e riparazione di tutte le marche di biciclette vi accoglie e vi consiglia."
    ],
    "fr": [
      "Installé depuis plus de 15 ans à Montbrison, votre magasin de cycles spécialisé dans la vente, l'entretien et la réparation de toute marque de vélo vous accueille et vous conseille."
    ],
    "es": [
      "Establecida desde hace más de 15 años en Montbrison, tu tienda de bicicletas especializada en la venta, el mantenimiento y la reparación de todas las marcas de bicicletas te acoge y te aconseja."
    ],
    "nl": [
      "Al meer dan 15 jaar gevestigd in Montbrison, uw fietsenwinkel gespecialiseerd in de verkoop, het onderhoud en de reparatie van alle merken fietsen verwelkomt en adviseert u."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Cycles sprint"
    ]
  },
