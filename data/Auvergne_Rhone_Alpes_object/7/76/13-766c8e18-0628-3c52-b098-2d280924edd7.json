  "rdfs:comment": {
    "de": [
      "Hausgemachte Küche, die französische Traditionen mit asiatischer Küche (thailändisch und kambodschanisch) verbindet. Mittags gibt es ein Tagesmenü (Gerichte mit und ohne Fleisch), dazu Gerichte und Desserts à la carte und abends verschiedene Tapas: kalt, warm, süß, salzig..."
    ],
    "en": [
      "Home-cooked cuisine blending French tradition and Asian cuisine (Thai and Cambodian). Lunchtime menu of the day (with or without meat) + à la carte dishes and desserts and evening tapas of various kinds: cold, hot, sweet, savoury..."
    ],
    "it": [
      "Cucina casalinga che unisce la tradizione francese alla cucina asiatica (thailandese e cambogiana). A pranzo menu del giorno (con o senza carne) + piatti à la carte e dessert e la sera tapas varie: fredde, calde, dolci, salate..."
    ],
    "fr": [
      "Cuisine maison mélangeant tradition française et cuisine asiatique (thaïlandaise et cambodgienne). Le midi proposition de menu du jour (plat avec et sans viande) + plats et desserts à la carte et le soir tapas divers: froid, chaud, sucré, salé..."
    ],
    "nl": [
      "Huiselijke keuken met een combinatie van Franse traditie en Aziatische keuken (Thais en Cambodjaans). Lunchmenu van de dag (met of zonder vlees) + à la carte gerechten en desserts en 's avonds verschillende tapas: koud, warm, zoet, hartig..."
    ],
    "es": [
      "Cocina casera que combina la tradición francesa y la cocina asiática (tailandesa y camboyana). Menú del día a mediodía (con o sin carne) + platos a la carta y postres y por la noche tapas variadas: frías, calientes, dulces, saladas..."
    ]
  },
  "rdfs:label": {
    "fr": [
      "A la Niche"
    ]
  },
