  "rdfs:comment": {
    "de": [
      "Die Tour de France wird auf der 10. Etappe von Aurillac nach Le Lioran zunächst die Gemeinden Roannes-Saint-Mary, Marcolès, Lacapelle-del-Fraisse, Lafeuillade-en-Vézie und Prunet durchqueren."
    ],
    "en": [
      "The Tour de France will pass through Marcolès during the 10th stage between Aurillac and Le Lioran."
    ],
    "it": [
      "Il Tour de France passerà per la prima volta da Roannes-Saint-Mary, Marcolès, Lacapelle-del-Fraisse, Lafeuillade-en-Vézie e Prunet nella 10ª tappa tra Aurillac e Le Lioran."
    ],
    "fr": [
      "Le Tour de France traversera d'abord les communes de Roannes-Saint-Mary, Marcolès, Lacapelle-del-Fraisse, Lafeuillade-en-Vézie et Prunet à l'occasion de la 10e étape entre Aurillac et Le Lioran."
    ],
    "es": [
      "El Tour de Francia pasará primero por Roannes-Saint-Mary, Marcolès, Lacapelle-del-Fraisse, Lafeuillade-en-Vézie y Prunet en la 10ª etapa, entre Aurillac y Le Lioran."
    ],
    "nl": [
      "De Tour de France komt door Marcolès tijdens de 10e etappe tussen Aurillac en Le Lioran."
    ]
  },
