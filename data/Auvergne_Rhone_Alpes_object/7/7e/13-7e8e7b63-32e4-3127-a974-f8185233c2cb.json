  "rdfs:comment": {
    "de": [
      "Eine Woche voller Gesang, in der sich 400 Chorsänger um 6 internationale Chorleiter versammeln, um 21 Titel einzustudieren und am Samstag, den 19. Juli ein kostenloses Konzert in Anwesenheit eines anerkannten Künstlers (Joyce JONATHAN, TIBZ, Lilian RENAUD) zu bieten"
    ],
    "en": [
      "A week of singing in which 400 choristers, led by 6 international choirmasters, work on 21 songs, culminating in a free concert on Saturday, July 19, featuring a renowned artist (Joyce JONATHAN, TIBZ, Lilian RENAUD)"
    ],
    "it": [
      "Una settimana di canto in cui 400 coristi e 6 direttori di coro internazionali lavoreranno su 21 canzoni e offriranno un concerto gratuito sabato 19 luglio alla presenza di un noto artista (Joyce JONATHAN, TIBZ, Lilian RENAUD)"
    ],
    "fr": [
      "Une semaine de chants où 400 choristes se retrouvent autour de 6 chefs de choeurs internationaux pour travailler 21 titres et proposer un concert gratuit le samedi 19 juillet en présence d'un artiste reconnu (Joyce JONATHAN, TIBZ, Lilian RENAUD)"
    ],
    "es": [
      "Una semana de canto en la que 400 coristas y 6 directores de coro internacionales trabajarán 21 canciones y ofrecerán un concierto gratuito el sábado 19 de julio en presencia de un artista de renombre (Joyce JONATHAN, TIBZ, Lilian RENAUD)"
    ],
    "nl": [
      "Een zangweek waarin 400 koorleden en 6 internationale koordirigenten werken aan 21 liederen en een gratis concert geven op zaterdag 19 juli in aanwezigheid van een bekende artiest (Joyce JONATHAN, TIBZ, Lilian RENAUD)"
    ]
  },
