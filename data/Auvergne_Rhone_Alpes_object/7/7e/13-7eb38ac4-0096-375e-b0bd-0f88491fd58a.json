  "rdfs:comment": {
    "de": [
      "Das Le Renaissance empfängt Sie täglich in seinem Restaurant in Aurillac. Mit seiner Leidenschaft für gute Produkte und die französische Gastronomie wird der Küchenchef Ihre Geschmacksknospen wecken."
    ],
    "en": [
      "The Renaissance is pleased to welcome you every day to its restaurant in Aurillac. Passionate about good quality products and French gastronomy, the chef is well-accomplished in the art of awakening your taste buds."
    ],
    "it": [
      "Il Renaissance vi accoglie ogni giorno nel suo ristorante di Aurillac. Appassionato di buoni prodotti e della gastronomia francese, lo chef risveglierà le vostre papille gustative."
    ],
    "fr": [
      "Le Renaissance vous reçoit tous les jours au sein de son restaurant à Aurillac. Passionné par les bons produits et la gastronomie française, le chef cuisinier saura éveiller vos papilles."
    ],
    "es": [
      "El Renaissance le da la bienvenida cada día en su restaurante de Aurillac. Apasionado por los buenos productos y la gastronomía francesa, el chef despertará sus papilas gustativas."
    ],
    "nl": [
      "De Renaissance ontvangt u dagelijks in haar restaurant in Aurillac. Gepassioneerd door goede producten en de Franse gastronomie zal de chef uw smaakpapillen prikkelen."
    ]
  },
