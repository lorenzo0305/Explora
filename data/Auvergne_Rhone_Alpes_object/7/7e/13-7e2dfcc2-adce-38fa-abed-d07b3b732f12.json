  "rdfs:comment": {
    "de": [
      "Die Pizzeria Chez Wam empfängt Sie im Herzen der Geschäfte, in Les Coches. Neben Pizzen können Sie hier auch Burger, Salate, Tacos, Waffeln und Churros am Nachmittag bestellen!"
    ],
    "en": [
      "Chez Wam pizzeria welcomes you in the very heart of les Coches shopping area. Apart from pizzas, you can order takeaway meals including burgers, salads and even sandwiches."
    ],
    "it": [
      "La pizzeria Chez Wam vi accoglie nel cuore dei negozi, a Les Coches. Oltre alle pizze, nel pomeriggio è possibile ordinare hamburger, insalate, tacos, waffle e churros!"
    ],
    "fr": [
      "La pizzeria Chez Wam vous accueille au cœur des commerces, aux Coches. En plus des pizzas, vous pourrez commander des burgers, des salades, tacos, gaufres, churros l'après-midi !"
    ],
    "es": [
      "La pizzería Chez Wam le da la bienvenida en el corazón de las tiendas, en Les Coches. Además de pizzas, puedes pedir hamburguesas, ensaladas, tacos, gofres y churros por la tarde"
    ],
    "nl": [
      "De pizzeria Chez Wam bevindt zich in het midden der handelszaken, te Coches.  Buiten de pizza's kan U \"take-away\" schotels bestellen, hamburgers, slaatjes, en ook belegde broodjes."
    ]
  },
  "rdfs:label": {
