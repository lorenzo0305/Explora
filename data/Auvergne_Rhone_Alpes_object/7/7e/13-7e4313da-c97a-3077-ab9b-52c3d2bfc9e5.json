  "rdfs:comment": {
    "de": [
      "Vom Weingut aus führt ein frei zugänglicher Entdeckungspfad, der Ihnen die verschiedenen Rebsorten sowie die Sommer- und Winterarbeit erklärt. Verkostung von Condrieu, Côte-Rôtie und Saint-Joseph auf dem Weingut"
    ],
    "en": [
      "There's a self-guided discovery trail departing from the estate to learn about the different grape varieties and the work done in the vineyard all year round. Come and sample Condrieu, Côte-Rôtie and Saint-Joseph wines at the estate."
    ],
    "it": [
      "All'inizio della tenuta, un percorso di scoperta ad accesso libero spiegherà i diversi vitigni, le lavorazioni estive e invernali. Degustazione di vini Condrieu, Côte-Rôtie e Saint-Joseph alla tenuta"
    ],
    "fr": [
      "Au départ du domaine, un sentier de découverte en libre accès vous expliquera les différents cépages, les travaux d’été et d’hiver. Dégustation de Condrieu, Côte-Rôtie et Saint-Joseph au domaine"
    ],
    "es": [
      "Al principio de la finca, un recorrido de descubrimiento de acceso libre explicará las diferentes variedades de uva, el trabajo de verano y de invierno. Degustación de vinos de Condrieu, Côte-Rôtie y Saint-Joseph en la finca"
    ],
    "nl": [
      "Aan het begin van het domein geeft een gratis toegankelijk ontdekkingspad uitleg over de verschillende druivenrassen, het zomer- en winterwerk. Proeverij van Condrieu, Côte-Rôtie en Saint-Joseph wijnen op het domein"
    ]
  },
  "rdfs:label": {
    "en": [
      "Domaine Pierre Gaillard"
    ],
    "fr": [
      "Domaine Pierre Gaillard"
    ]
  },
