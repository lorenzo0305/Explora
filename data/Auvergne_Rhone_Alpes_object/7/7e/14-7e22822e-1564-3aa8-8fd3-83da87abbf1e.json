  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/b9f30114-0e5c-3f46-b1d9-0a7c81ffa02a",
      "dc:description": {
        "de": [
          "Der Umzug der Riesen - mit etwa 15 Musikkapellen - wird durch die Straßen des Stadtzentrums führen und gegen 17.00-18.00 Uhr vor dem Rathaus zu einem krönenden Finale führen."
        ],
        "en": [
          "The parade of giants - with about fifteen marching bands - will follow the streets of the city center for a grand finale in front of the town hall at about 5-6 pm."
        ],
        "it": [
          "La parata di giganti - con una quindicina di bande di ottoni - si snoderà per le strade del centro cittadino, culminando in un gran finale davanti al Municipio intorno alle 17.00-18.00."
        ],
        "fr": [
          "Le défilé de géants - avec une quinzaine de fanfares - empruntera les rues du centre-ville pour un final en apothéose devant la mairie vers 17h-18h."
        ],
        "es": [
          "El desfile de gigantes -con una quincena de bandas de música- recorrerá las calles del centro de la ciudad y culminará con una gran final frente al Ayuntamiento hacia las 17.00 y 18.00 horas."
        ],
        "nl": [
          "De parade van reuzen - met zo'n vijftien brassbands - zal door de straten van het stadscentrum slingeren, met als hoogtepunt een grote finale voor het stadhuis rond 17.00 en 18.00 uur."
        ]
      },
