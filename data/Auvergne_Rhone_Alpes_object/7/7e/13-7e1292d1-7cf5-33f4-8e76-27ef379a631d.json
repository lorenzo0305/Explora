  "rdfs:comment": {
    "de": [
      "Als authentischer und geschichtsträchtiger Ort ist diese Brasserie der unumgängliche Treffpunkt der Lyoner Gastronomie. Die Reichhaltigkeit des Dekors, der überschwängliche Service und die Küche machen ihren guten Ruf aus."
    ],
    "en": [
      "Enjoy a little taste of history with your food. This brasserie is a must for anyone keen to really sample Lyonnais cooking. The sumptuous decor, the warm and friendly service and, of course, the delicious food have all helped forge its impressive reputation."
    ],
    "it": [
      "Vero e proprio luogo storico, questa brasserie è un appuntamento imprescindibile della gastronomia lionese. La ricchezza della decorazione, il servizio accogliente e la cucina sono alla base della sua fama."
    ],
    "fr": [
      "Authentique lieu d’histoire, cette brasserie est le rendez-vous incontournable de la gastronomie lyonnaise. La richesse du décor, le service chaleureux et la cuisine ont fait sa renommée."
    ],
    "es": [
      "Esta brasserie, lugar auténtico cargado de historia, es el punto de encuentro indispensable de la gastronomía lionesa. La riqueza de la decoración, un servicio cuidado y su cocina han construido su fama."
    ],
    "nl": [
      "Deze brasserie, een echte plek met geschiedenis, is een must voor de gastronomie van Lyon. De rijkdom van het decor, de warme bediening en de keuken hebben voor de reputatie gezorgd."
    ]
  },
