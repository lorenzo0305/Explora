  "rdfs:comment": {
    "de": [
      "Dieser acht Hektar große Teich, in dem sich Karpfen, Schleien und Hechte tummeln, hat eine schattige Umgebung und wird vom Fischereiverband des Departements Allier verwaltet."
    ],
    "en": [
      "This eight-hectare pond, home to carp, tench and pike, has shady surroundings and is managed by the Allier fishing federation."
    ],
    "it": [
      "Questo stagno di otto ettari, che ospita carpe, tinche e lucci, è circondato da zone ombreggiate ed è gestito dalla Federazione di pesca dell'Allier."
    ],
    "fr": [
      "Cet étang de huit hectares où évoluent carpes, tanches et brochets, présente des abords ombragés, géré par la fédération de pêche de l'Allier."
    ],
    "es": [
      "Este estanque de ocho hectáreas, hogar de carpas, tencas y lucios, está rodeado de sombra y gestionado por la federación de pesca de Allier."
    ],
    "nl": [
      "Deze vijver van acht hectare, waar karper, zeelt en snoek leven, heeft een schaduwrijke omgeving en wordt beheerd door de hengelsportfederatie van de Allier."
    ]
  },
