  "rdfs:comment": {
    "de": [
      "Von Chamonix aus: zunächst mit der Gondelbahn nach Planpraz auf 2000 m, dann mit der Seilbahn nach Le Brévent auf 2525 m Höhe. Von dort aus haben Sie ein 360°-Panorama sowie einen Blick auf die Bergkette des Mont-Blanc."
    ],
    "en": [
      "From Chamonix: first a gondola to Planpraz at 2000m, then a cable car to Le Brévent at 2525m. Here you'll enjoy 360° panoramic views of the Mont-Blanc chain."
    ],
    "it": [
      "Da Chamonix: prima una funivia fino a Planpraz a 2000 m, poi una funivia fino a Brévent a 2525 m. Qui potrete godere di una vista panoramica a 360° sulla catena del Monte Bianco."
    ],
    "fr": [
      "Au départ de Chamonix : d'abord une télécabine pour Planpraz à 2000m, puis un  téléphérique pour le Brévent à 2525m. Vous y découvrirez un panorama à 360° ainsi que sur la chaîne du Mont-Blanc."
    ],
    "nl": [
      "Vanuit Chamonix: eerst een kabelbaan naar Planpraz op 2000m, dan een kabelbaan naar Brévent op 2525m. Hier geniet je van een 360° panoramisch uitzicht op de Mont-Blanc."
    ],
    "es": [
      "Desde Chamonix: primero un teleférico hasta Planpraz, a 2000 m, y después otro hasta Brévent, a 2525 m. Aquí disfrutará de una vista panorámica de 360° del macizo del Mont-Blanc."
    ]
  },
  "rdfs:label": {
