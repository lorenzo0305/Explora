  "rdfs:comment": {
    "de": [
      "Das Novotel Grenoble Centre, das in das Kongresszentrum Europole integriert ist, liegt 1 Min. vom Bahnhof und 10 Min. zu Fuß vom Stadtzentrum und der Bastille entfernt. Ideal für Ihre Reisen mit Tagungsräumen für Seminare und Konferenzen, einem einladenden Restaurant und einer Bar."
    ],
    "en": [
      "The Novotel Grenoble Centre is part of the Europole Convention Center, 1 minute from the train station and 10 minutes' walk from the city center and Bastille. Ideal for your travels, with meeting rooms for seminars and conferences, and a welcoming restaurant and bar."
    ],
    "it": [
      "Il Novotel Grenoble Centre integrato al Centro Congressi Europole, a 1 minuto dalla stazione ferroviaria e a 10 minuti a piedi dal centro città e dalla Bastiglia. Ideale per i suoi viaggi con sale riunioni per seminari e convegni, ristorante e bar accoglienti."
    ],
    "fr": [
      "Le Novotel Grenoble Centre intégré au Centre de Congrès Europole, à 1 mn de la gare et à 10 mn à pied du centre ville et de la Bastille. Idéal pour vos voyages avec des salles de réunion pour séminaires et conférences, un restaurant et un bar accueillants"
    ],
    "nl": [
      "Het Novotel Grenoble Centre maakt deel uit van het Europole Congress Centre, op 1 minuut van het treinstation en op 10 minuten lopen van het stadscentrum en de Bastille. Ideaal voor uw reizen met vergaderzalen voor seminars en conferenties, een gastvrij restaurant en bar"
    ],
    "es": [
      "El Novotel Grenoble Centre forma parte del Centro de Convenciones Europole, a 1 minuto de la estación de tren y a 10 minutos a pie del centro de la ciudad y de la Bastilla. Ideal para sus viajes con salas de reuniones para seminarios y conferencias, un acogedor restaurante y bar."
    ]
  },
