  "rdfs:comment": {
    "de": [
      "Ziel des Vereins Les Bobos d'Hugo ist es, einem Kind mit Hämophilie (Hugo) und seiner Familie Hilfe zukommen zu lassen. Mit den Spendengeldern werden auch medizinische Maßnahmen und Forschungen im Zusammenhang mit dieser seltenen Krankheit unterstützt."
    ],
    "en": [
      "The Association Les Bobos d'Hugo aims to help a child with hemophilia (Hugo) and his family. Funds raised also support medical research into this rare disease."
    ],
    "it": [
      "L'Associazione Les Bobos d'Hugo si propone di aiutare un bambino affetto da emofilia (Hugo) e la sua famiglia. I fondi raccolti sostengono anche la ricerca medica su questa malattia rara."
    ],
    "fr": [
      "L'Association Les Bobos d'Hugo a pour objectif : d’apporter de l’aide à un enfant hémophile (Hugo) ainsi qu'à sa famille. Les fonds permettent également d’apporter de l’aide aux actions et recherches médicales concernant cette maladie rare."
    ],
    "es": [
      "La Asociación Les Bobos d'Hugo tiene como objetivo ayudar a un niño con hemofilia (Hugo) y a su familia. Los fondos recaudados también se destinan a la investigación médica de esta enfermedad rara."
    ],
    "nl": [
      "De Association Les Bobos d'Hugo heeft als doel een kind met hemofilie (Hugo) en zijn familie te helpen. Met het ingezamelde geld wordt ook medisch onderzoek naar deze zeldzame ziekte gesteund."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Association les Bobos d'Hugo"
    ]
  },
