  "rdfs:comment": {
    "de": [
      "Zwischen dem Place Jean-Jaurès und dem Place Fourneyron, mitten im Herzen der Stadt, sind Sie bestimmt schon einmal an einer roten Fassade, karierten Tischdecken und Kellnern mit Baskenmütze vorbeigekommen?"
    ],
    "en": [
      "Between Place Jean-Jaurès and Place Fourneyron, right in the heart of the city, you're bound to have come across a red facade, checkered tablecloths and waiters in berets?"
    ],
    "it": [
      "Tra Place Jean-Jaurès e Place Fourneyron, nel cuore della città, vi sarete sicuramente imbattuti in una facciata rossa, in tovaglie a quadretti e in camerieri con il berretto?"
    ],
    "fr": [
      "Entre la place Jean-Jaurès et la place Fourneyron, en plein cœur de ville, vous avez forcément croisé une façade rouge, des nappes à carreaux et des serveurs en béret ?"
    ],
    "nl": [
      "Tussen Place Jean-Jaurès en Place Fourneyron, midden in het hart van de stad, ben je vast wel eens een rode gevel, geruite tafelkleden en obers met baretten tegengekomen?"
    ],
    "es": [
      "Entre la plaza Jean-Jaurès y la plaza Fourneyron, en pleno centro de la ciudad, seguro que se ha topado con una fachada roja, manteles de cuadros y camareros con boina.."
    ]
  },
  "rdfs:label": {
    "fr": [
