  "rdfs:comment": {
    "de": [
      "Auf fast 200 Metern entlang des Flusses Riaille werden nun ein Dutzend Workshops angeboten, die sowohl für Sonntagsläufer als auch für erfahrene Sportler geeignet sind."
    ],
    "en": [
      "Along nearly 200 meters of the Riaille River, a dozen workshops are now available to Sunday runners and more experienced athletes alike."
    ],
    "it": [
      "Lungo quasi 200 metri del fiume Riaille, una dozzina di laboratori sono ora disponibili per i corridori della domenica e per gli sportivi più esperti."
    ],
    "fr": [
      "Sur près de 200 mètres le long de la Riaille, une dizaine d’ateliers sont désormais offerts aux coureurs du dimanche comme aux sportifs plus avertis."
    ],
    "nl": [
      "Langs de Riaille, die zich over bijna 200 meter uitstrekt, zijn nu een dozijn workshops beschikbaar voor zowel hardlopers op zondag als meer ervaren atleten."
    ],
    "es": [
      "A lo largo de casi 200 metros del río Riaille, una docena de talleres están ahora disponibles para los corredores dominicales, así como para los deportistas más experimentados."
    ]
  },
