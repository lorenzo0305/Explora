  "rdfs:comment": {
    "de": [
      "Besuchen Sie den Vortrag von Henri Rodier und Robert Montel von der LPO (Ligue pour la Protection des Oiseaux): \"Territoires ruraux et territoires urbains, la biodiversité des oiseaux en milieu bâti\" (Ländliche Gebiete und städtische Gebiete, die Artenvielfalt der Vögel in bebauten Gebieten)."
    ],
    "en": [
      "Join Henri Rodier and Robert Montel from the LPO (Ligue pour la Protection des Oiseaux) for a talk on \"Rural and urban territories, bird biodiversity in built-up areas\"."
    ],
    "it": [
      "Venite ad ascoltare Henri Rodier e Robert Montel della LPO (Ligue pour la Protection des Oiseaux - Lega per la Protezione degli Uccelli) che parleranno di \"Territoires ruraux et territoires urbains, la biodiversité des oiseaux en milieu bâti\"."
    ],
    "fr": [
      "Venez assister à la conférence d'Henri Rodier et Robert Montel de la LPO (Ligue pour la Protection des Oiseaux) : \"Territoires ruraux et territoires urbains, la biodiversité des oiseaux en milieu bâti\"."
    ],
    "es": [
      "Venga a escuchar a Henri Rodier y Robert Montel, de la LPO (Liga para la Protección de las Aves), que pronunciarán una conferencia sobre \"Territorios rurales y urbanos, la biodiversidad de las aves en el medio rural\"."
    ],
    "nl": [
      "Kom luisteren naar een lezing van Henri Rodier en Robert Montel van de LPO (Ligue pour la Protection des Oiseaux) over \"Territoires ruraux et territoires urbains, la biodiversité des oiseaux en milieu bâti\"."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Mardi-Culture : Conférence sur la biodiversité des oiseaux en milieu bâti"
    ]
  },
