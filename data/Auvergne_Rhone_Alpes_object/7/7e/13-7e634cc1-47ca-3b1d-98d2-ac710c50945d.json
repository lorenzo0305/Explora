  "rdfs:comment": {
    "de": [
      "Yes We Canyon bietet Ausflüge zu Natursportarten an. Canyoning, Klettern, Klettersteige und Höhlenforschung in den Massiven des Vercors und der Chartreuse. Entdecken Sie diese wunderbaren Umgebungen mit zwei begeisterten Guides."
    ],
    "en": [
      "Yes We Canyon offers nature sports outings. Canyoning, climbing, via ferrata and caving in the Vercors and Chartreuse massifs. Come and discover these wonderful environments with two passionate guides."
    ],
    "it": [
      "Yes We Canyon offre una serie di sport all'aria aperta. Canyoning, arrampicata, via ferrata e speleologia nei massicci del Vercors e della Chartreuse. Venite a scoprire questi ambienti meravigliosi con due guide appassionate."
    ],
    "fr": [
      "Yes We Canyon propose des sorties de sport de nature. Le canyoning, l'escalade, la via ferrata et la spéléologie dans les massifs du Vercors et de Chartreuse. Venez découvrir ces merveilleux environnements avec deux guides passionnés."
    ],
    "es": [
      "Yes We Canyon ofrece una gama de deportes al aire libre. Barranquismo, escalada, vía ferrata y espeleología en los macizos de Vercors y Chartreuse. Venga a descubrir estos maravillosos entornos con dos guías apasionados."
    ],
    "nl": [
      "Yes We Canyon biedt een scala aan buitensporten. Canyoning, klimmen, klettersteigen en speleologie in de Vercors en Chartreuse massieven. Kom deze prachtige omgevingen ontdekken met twee gepassioneerde gidsen."
    ]
  },
  "rdfs:label": {
