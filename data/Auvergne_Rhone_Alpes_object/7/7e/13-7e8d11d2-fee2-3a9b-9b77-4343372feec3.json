  "rdfs:comment": {
    "de": [
      "Entdecken Sie Noémie Massages in Aussois, Ihrer Oase des Wohlbefindens. Gönnen Sie sich eine Entspannungspause mit maßgeschneiderten Behandlungen inmitten einer Oase der Ruhe oder an Ihrem Urlaubsort. Die ideale Auszeit für Ihren Körper und Geist."
    ],
    "en": [
      "Discover Noémie Massages in Aussois, your haven of well-being. Treat yourself to a relaxing break with tailor-made treatments in the heart of a tranquil oasis or at your vacation destination. The ideal getaway for your body and mind."
    ],
    "it": [
      "Scoprite i Massaggi Noémie ad Aussois, la vostra oasi di benessere. Concedetevi una pausa di relax con trattamenti su misura nel cuore di un'oasi di pace o nella vostra destinazione di vacanza. La fuga ideale per il corpo e la mente."
    ],
    "fr": [
      "Découvrez Noémie Massages à Aussois, votre havre de bien-être. Offrez-vous une pause détente avec des soins sur-mesure en plein cœur d'une oasis de tranquillité ou sur votre lieu de vacances. L'escapade idéale pour votre corps et esprit."
    ],
    "nl": [
      "Ontdek Noémie Massages in Aussois, uw oase van welzijn. Trakteer uzelf op een ontspannende vakantie met behandelingen op maat in het hart van een oase van rust of op uw vakantiebestemming. De ideale vakantie voor lichaam en geest."
    ],
    "es": [
      "Descubra los Masajes Noémie en Aussois, su remanso de bienestar. Regálese una pausa relajante con tratamientos a medida en el corazón de un oasis de paz o en su destino de vacaciones. La escapada ideal para su cuerpo y su mente."
    ]
  },
