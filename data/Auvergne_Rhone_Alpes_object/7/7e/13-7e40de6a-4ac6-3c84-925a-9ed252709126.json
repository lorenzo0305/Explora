  "rdfs:comment": {
    "de": [
      "Das Odyssée ist ein Ort des Empfangs, der Praxis, des Austauschs, der Kreation und der Ausstrahlung, eine Einrichtung, die aus dem Leben von Eybino nicht wegzudenken ist und das kulturelle Herz der Stadt darstellt."
    ],
    "en": [
      "The Odyssée cultural Centre is a municipal facility which offers a performance hall, a library, the Conservatory of music and dance and the Youth Information Service."
    ],
    "it": [
      "L'Odyssée è un luogo in cui le persone possono incontrarsi, praticare, condividere, creare e presentare, ed è una struttura chiave nella vita di Eybois, il cuore culturale della città."
    ],
    "fr": [
      "Lieu d’accueil des publics, de pratiques, de partage, de création et de diffusion, l’Odyssée est un équipement incontournable de la vie eybinoise, véritable cœur culturel de la ville."
    ],
    "nl": [
      "L'Odyssée is een plek waar mensen elkaar kunnen ontmoeten, oefenen, delen, creëren en presenteren, en is een belangrijke faciliteit in het leven van Eybois, het culturele hart van de stad."
    ],
    "es": [
      "L'Odyssée es un lugar donde la gente puede reunirse, practicar, compartir, crear y presentar, y es una instalación clave en la vida de Eybois, el corazón cultural de la ciudad."
    ]
  },
  "rdfs:label": {
    "en": [
