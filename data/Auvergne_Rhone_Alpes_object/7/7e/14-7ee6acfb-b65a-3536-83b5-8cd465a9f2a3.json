  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/e6895f9f-e4aa-3751-ab58-5f3ec1a6a545",
      "dc:description": {
        "de": [
          "Die Cité des électriciens befindet sich in Bruay-la-Buissière, 25 Minuten von Lens entfernt, und ist zu einem Referenzort für die Entdeckung der Landschaft, des Städtebaus und der Wohnkultur des Bergbaubeckens geworden."
        ],
        "en": [
          "Located in Bruay-la-Buissière, 25 minutes from Lens, the Cité des électriciens has become a reference point for discovering the landscape, town planning and habitat of the mining basin."
        ],
        "it": [
          "Situata a Bruay-la-Buissière, a 25 minuti da Lens, la Cité des électriciens è diventata un punto di riferimento per scoprire il paesaggio, l'urbanistica e le abitazioni del bacino minerario."
        ],
        "fr": [
          "Situé à Bruay-la-Buissière, à 25 mn de Lens, la Cité des électriciens est devenu un lieu de référence dans la découverte du paysage, de l'urbanisme et de l'habitat du Bassin minier."
        ],
        "es": [
          "Situada en Bruay-la-Buissière, a 25 minutos de Lens, la Cité des électriciens se ha convertido en un punto de referencia para descubrir el paisaje, el urbanismo y la vivienda de la cuenca minera."
        ],
        "nl": [
          "Gelegen in Bruay-la-Buissière, op 25 minuten van Lens, is de Cité des électriciens een referentiepunt geworden om het landschap, de stedenbouw en de huisvesting van het mijnbekken te ontdekken."
        ]
      },
