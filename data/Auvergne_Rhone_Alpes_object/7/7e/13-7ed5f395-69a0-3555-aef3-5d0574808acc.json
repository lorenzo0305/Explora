  "rdfs:comment": {
    "de": [
      "Von 15:00 bis 18:30 Uhr verrät Ihnen der Küchenchef seine Geheimnisse, wie man Süßwasserfische am besten zubereitet. Lernen Sie einen Nachmittag lang, wie man Forelle, Zander, Hecht usw. zubereitet und verbringen Sie einen angenehmen kulinarischen Moment.55?\r\nReservierung unter 04 71 66 86 66."
    ],
    "en": [
      "From 3pm to 6:30pm, the chef reveals his secrets for sublimating freshwater fish. Spend an afternoon learning how to prepare trout, pike-perch, pike... and enjoy a pleasant culinary experience.55?\r\nBook on 04 71 66 86 66."
    ],
    "it": [
      "Dalle 15.00 alle 18.30, lo chef vi svelerà i suoi segreti per ottenere il massimo dal pesce d'acqua dolce. Trascorrete un pomeriggio imparando a preparare trote, lucioperca, lucci... e godetevi una deliziosa esperienza culinaria.55?\r\nPrenotare al numero 04 71 66 86 66."
    ],
    "fr": [
      "De 15h à 18h30, le chef vous révèle ses secrets pour sublimer les poissons d'eau douce. Le temps d'un après-midi, apprenez à préparer truite, sandre, brochet... et passez un agréable moment culinaire.55€ \r\nRéservation au 04 71 66 86 66."
    ],
    "nl": [
      "Van 15.00 tot 18.30 uur onthult de chef-kok zijn geheimen om het beste uit zoetwatervis te halen. Breng een middag door met het leren bereiden van forel, snoekbaars, snoek... en geniet van een heerlijke culinaire ervaring.55?\r\nReserveer op 04 71 66 86 66."
    ],
    "es": [
      "De 15:00 a 18:30, el chef le revelará sus secretos para sublimar el pescado de agua dulce. Pase una tarde aprendiendo a preparar truchas, luciopercas, lucios... y disfrute de una deliciosa experiencia culinaria.55?\r\nReserve en el 04 71 66 86 66."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Cours de cuisine: la coquille St Jacques"
    ]
  },
