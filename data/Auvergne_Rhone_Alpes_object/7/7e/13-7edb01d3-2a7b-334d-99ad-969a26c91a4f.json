  "rdfs:comment": {
    "de": [
      "die Handwerkskammer der Drôme, die Mission Locale Drôme des Collines?Royans?Vercors, France Travail und die Industrie- und Handelskammer der Drôme setzen sich gemeinsam für die Förderung der dualen Berufsausbildung ein."
    ],
    "en": [
      "the Chambre de Métiers et de l?Artisanat de la Drôme, the Mission Locale Drôme des Collines?Royans?Vercors, France Travail and the Chambre de Commerce et d?Industrie de la Drôme are joining forces to promote work-linked training."
    ],
    "it": [
      "la Camera dei mestieri della Drôme, la Missione locale Drôme des Collines?Royans?Vercors, France Travail e la Camera di commercio e dell'industria della Drôme uniscono le forze per promuovere la formazione in alternanza."
    ],
    "fr": [
      "la Chambre de Métiers et de l’Artisanat de la Drôme, la Mission Locale Drôme des Collines–Royans–Vercors, France Travail et la Chambre de Commerce et d’Industrie de la Drôme unissent leurs forces pour promouvoir l’alternance."
    ],
    "es": [
      "la Cámara de Oficios de Drôme, la Misión Local de Drôme des Collines-Royans-Vercors, France Travail y la Cámara de Comercio e Industria de Drôme se unen para promover la formación en alternancia."
    ],
    "nl": [
      "de Kamer van Ambachten en Nijverheid van de Drôme, de Plaatselijke Missie Drôme des Collines Royans Vercors, France Travail en de Kamer van Koophandel en Industrie van de Drôme bundelen hun krachten om alternerende opleidingen te promoten."
    ]
  },
  "rdfs:label": {
