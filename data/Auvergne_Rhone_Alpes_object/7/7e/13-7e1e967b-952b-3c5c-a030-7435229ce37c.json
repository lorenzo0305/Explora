  "rdfs:comment": {
    "de": [
      "Mémoire de la Drôme sammelt und archiviert mit einem historischen, ethnologischen und soziologischen Ansatz Foto-, Ton- und audiovisuelle Dokumente, die das Département Drôme betreffen."
    ],
    "en": [
      "Mémoire de la Drôme collects and archives photographic, sound and audiovisual documents relating to the Drôme department, using a historical, ethnological and sociological approach."
    ],
    "it": [
      "Mémoire de la Drôme raccoglie e archivia, con un approccio storico, etnologico e sociologico, documenti fotografici, sonori e audiovisivi relativi al dipartimento della Drôme."
    ],
    "fr": [
      "Mémoire de la Drôme collecte et archive, avec une approche historique, ethnologique et sociologique, des documents photographiques, sonores et audiovisuels concernant le département de la Drôme."
    ],
    "nl": [
      "Mémoire de la Drôme verzamelt en archiveert fotografische, audio- en audiovisuele documenten met betrekking tot het departement Drôme vanuit een historische, etnologische en sociologische benadering."
    ],
    "es": [
      "Mémoire de la Drôme recoge y archiva, con un enfoque histórico, etnológico y sociológico, documentos fotográficos, sonoros y audiovisuales relativos al departamento de la Drôme."
    ]
  },
