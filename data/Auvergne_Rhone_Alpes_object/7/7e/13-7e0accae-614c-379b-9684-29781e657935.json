  "rdfs:comment": {
    "de": [
      "Traditionelle Restauration und Spezialitäten: Savoyer Fondue, Raclette mit Pfännchen, Tartiflette, Planchetta, usw. ... sowie zahlreiche Pizzas, frische \"hausgemachte\" Pasta und unsere großen Salate."
    ],
    "en": [
      "Traditional catering and specialities: Savoyard fondue, pan-fried raclette, tartiflette, planchetta, etc. ... as well as numerous pizzas, fresh homemade pastas and our large salads."
    ],
    "it": [
      "Cucina tradizionale e specialità: fonduta savoiarda, raclette in padella, tartiflette, planchetta, ecc... oltre a un'ampia scelta di pizze, pasta fresca fatta in casa e le nostre insalatone."
    ],
    "fr": [
      "Restauration traditionnelle et spécialités: fondue savoyarde, raclette à poêlons, tartiflette, planchetta, etc ... ainsi que de nombreuses pizzas, pâtes fraîches \"maison\" et nos grandes salades."
    ],
    "nl": [
      "Traditionele keuken en specialiteiten: Savoyaardse fondue, gebakken raclette, tartiflette, planchetta, enz... evenals een breed scala aan pizza's, verse huisgemaakte pasta en onze grote salades."
    ],
    "es": [
      "Cocina tradicional y especialidades: fondue saboyana, raclette a la sartén, tartiflette, planchetta, etc... así como una amplia gama de pizzas, pasta fresca casera y nuestras grandes ensaladas."
    ]
  },
