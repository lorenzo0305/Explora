  "rdfs:comment": {
    "de": [
      "Entdecke den Biathlon!\r\n\r\nDie Lehrer der ESF in Les Contamines bieten verschiedene Möglichkeiten an: 10-Meter-Schießen, 50-Meter-Schießen oder auch mehrtägige Kurse."
    ],
    "en": [
      "Discover biathlon!\r\n\r\nThe ESF instructors at Les Contamines offer a range of options: 10-meter shooting, 50-meter shooting or multi-day courses."
    ],
    "it": [
      "Scoprite il biathlon!\r\n\r\nGli istruttori dell'ESF di Les Contamines offrono una gamma di opzioni: tiro a 10 metri, tiro a 50 metri o corsi di più giorni."
    ],
    "fr": [
      "Découvrez le biathlon !\r\n\r\nDifférentes formules sont proposées par les moniteurs de l'ESF des Contamines : tir à 10 mètres, tir à 50 mètres ou encore stages sur plusieurs jours."
    ],
    "nl": [
      "Ontdek biatlon!\r\n\r\nDe ESF-instructeurs in Les Contamines bieden verschillende mogelijkheden: 10 meter schieten, 50 meter schieten of meerdaagse cursussen."
    ],
    "es": [
      "Descubre el biatlón\r\n\r\nLos monitores de la ESF de Les Contamines te proponen varias opciones: tiro de 10 metros, tiro de 50 metros o cursos de varios días."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Cours de biathlon avec l'ESF"
    ]
  },
