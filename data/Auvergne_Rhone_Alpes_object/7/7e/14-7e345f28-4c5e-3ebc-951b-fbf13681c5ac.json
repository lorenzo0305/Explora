  "rdfs:comment": {
    "de": [
      "Thema der Ausgabe 2025: \"Architekturen des Alltags\"\nDas Thema 2025 legt den Schwerpunkt auf Bauwerke, die oft als \"banal\" wahrgenommen werden, aber dennoch unseren Alltag und das Lebensumfeld jedes Einzelnen prägen."
    ],
    "en": [
      "2025 theme: \"Everyday architecture\nThe 2025 theme puts the spotlight on buildings that are often perceived as \"banal\", but which nonetheless shape our daily lives and the environment in which we all live."
    ],
    "it": [
      "Tema 2025: \"Architettura quotidiana\nIl tema 2025 si concentra sugli edifici che spesso vengono percepiti come \"ordinari\", ma che tuttavia plasmano la nostra vita quotidiana e l'ambiente in cui tutti viviamo."
    ],
    "fr": [
      "Thème de l'édition 2025 : « Architectures du quotidien »\nLa thématique 2025 met l’accent sur ces réalisations souvent perçues comme « banales » mais qui façonnent pourtant notre quotidien et le cadre de vie de chacun."
    ],
    "es": [
      "Tema 2025: \"Arquitectura cotidiana\nEl tema 2025 se centra en los edificios que a menudo se perciben como \"cotidianos\", pero que sin embargo conforman nuestra vida diaria y el entorno en el que todos vivimos."
    ],
    "nl": [
      "2025 thema: \"Alledaagse architectuur\nHet thema 2025 richt zich op gebouwen die vaak als \"gewoon\" worden gezien, maar die niettemin ons dagelijks leven en de leefomgeving waarin we allemaal leven vormgeven."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les journées nationales de l'Architecture à la Maison Syndicale des Mineurs"
    ]
  },
