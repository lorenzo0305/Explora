  "rdfs:comment": {
    "de": [
      "Machen Sie einen Tag lang eine Reise in das Mittelalter mit Spiel- und Lernangeboten.\r\nRitterparcours, Shows, Bogenschießen, Armbrust, Holzspiele, Schwertkampf... Aktivitäten à la carte für Kinder und Erwachsene."
    ],
    "en": [
      "Travel back in time to the Middle Ages with fun and educational activities.\r\nA knight's course, shows, archery, crossbow, wooden games, sword fighting... A la carte activities for children and adults."
    ],
    "it": [
      "Fate un viaggio di un giorno nel Medioevo con attività divertenti ed educative.\r\nPercorso cavalleresco, spettacoli, tiro con l'arco, balestra, giochi in legno, combattimenti con la spada... Attività alla carta per bambini e adulti."
    ],
    "fr": [
      "Voyagez le temps d'une journée au cœur du Moyen Âge avec des activités ludiques et éducatives.\r\nParcours de chevalier, spectacles, tir à l'arc, arbalète, jeux en bois, combat à l'épée... Des activités à la carte pour enfants et adultes."
    ],
    "es": [
      "Haga un viaje de un día a la Edad Media con actividades divertidas y educativas.\r\nUn curso de caballería, espectáculos, tiro con arco, ballesta, juegos de madera, lucha con espadas... Actividades a la carta para niños y adultos."
    ],
    "nl": [
      "Ga een dagje terug naar de middeleeuwen met leuke en leerzame activiteiten.\r\nEen ridderparcours, shows, boogschieten, kruisboog, houten spelen, zwaardvechten... Activiteiten à la carte voor kinderen en volwassenen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Kot de Maye - Campement Médiéval"
    ]
  },
