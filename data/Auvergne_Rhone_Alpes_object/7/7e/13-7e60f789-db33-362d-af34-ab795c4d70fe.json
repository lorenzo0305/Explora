  "rdfs:comment": {
    "de": [
      "Auf dem Weg zu einer Begegnung mit den Pferden und zu einem Reiten, bei dem die Unterschiede zwischen Pferd und Reiter respektiert werden. Einzelsitzungen, Kleingruppen, Praktika, à la carte nach Ihren Bedürfnissen. Auf Reservierung."
    ],
    "en": [
      "Towards an encounter with horses and horsemanship that respects the differences between horse and rider. Individual sessions, small groups, courses, à la carte according to your needs. Reservations required."
    ],
    "it": [
      "Verso un incontro con i cavalli e un'equitazione che rispetti le differenze tra cavallo e cavaliere. Sessioni individuali, piccoli gruppi, corsi, à la carte secondo le vostre esigenze. Su prenotazione."
    ],
    "fr": [
      "Vers une rencontre avec les chevaux et d'une équitation dans le respect des différences de chacun, cheval et cavalier. Séances individuelles, en petits groupes, stages, à la carte selon vos besoins. Sur réservation."
    ],
    "nl": [
      "Naar een ontmoeting met paarden en rijkunst die de verschillen tussen paard en ruiter respecteert. Individuele sessies, kleine groepen, cursussen, à la carte volgens uw behoeften. Op afspraak."
    ],
    "es": [
      "Hacia un encuentro con el caballo y la equitación que respete las diferencias entre caballo y jinete. Sesiones individuales, grupos reducidos, cursos, a la carta según sus necesidades. Previo acuerdo."
    ]
  },
  "rdfs:label": {
