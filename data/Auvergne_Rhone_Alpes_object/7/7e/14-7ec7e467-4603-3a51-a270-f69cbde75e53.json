  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/a76559bf-a0dd-3e6c-ad6d-fb2e0b461856",
      "dc:description": {
        "de": [
          "Rindfleisch der Rasse Limousin mit dem Zertifikat Bleu - Blanc - Coeur, Limousin-Kälber, die von der Mutter gefüttert werden, kleine Schweine, die auf Stroh gehalten und mit Getreide gefüttert werden, traditionelle Lämmer, mit Gras gefütterte Rinder, Wurstwaren nach alter Art."
        ],
        "en": [
          "Beef Limousin breed certified Blue - White - Heart, Limousin calves fed under the mother, small pigs raised on straw and fed with cereals, traditional lambs, grass-fed cattle, old-fashioned charcuterie."
        ],
        "it": [
          "Carne di manzo Limousin certificata Bleu - Blanc - Coeur, vitelli Limousin alimentati con latte materno, maialini allevati con paglia e nutriti con cereali, agnelli tradizionali, bovini nutriti con erba, salumi all'antica."
        ],
        "fr": [
          "Viande de boeuf race Limousine certifiée Bleu - Blanc - Coeur, veaux Limousin nourris sous la mère, petits porcs élevés sur la paille et nourris aux céréales, agneaux traditionnels, bovins nourris à l'herbe, charcuterie à l'ancienne."
        ],
        "nl": [
          "Limousin rundvlees gecertificeerd Bleu - Blanc - Coeur, Limousin kalveren gevoed onder de melk van de moeder, kleine varkens opgevoed met stro en gevoed met granen, traditionele lammeren, grasgevoerde runderen, ouderwetse vleeswaren."
        ],
        "es": [
          "Carne de vacuno de Limousin certificada Bleu - Blanc - Coeur, terneros de Limousin alimentados con leche materna, cerdos pequeños criados con paja y alimentados con cereales, corderos tradicionales, ganado alimentado con hierba, charcutería a la antigua."
        ]
      },
      "@type": [
        "Description"
      ],
