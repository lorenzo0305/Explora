  "rdfs:comment": {
    "de": [
      "Die markierte und gesicherte Skitourenroute Au fil de l'Aup führt um das Skigebiet von Flaine herum und bietet Ihnen einen beruhigenden Wanderausflug."
    ],
    "en": [
      "The Au fil de l'Aup ski touring route, which is signposted and safe so you can enjoy the great outdoors, skirts around the Flaine ski area and offers you a relaxing outing."
    ],
    "it": [
      "L'itinerario di scialpinismo Au fil de l'Aup, segnalato e sicuro per godersi la vita all'aria aperta, costeggia il comprensorio sciistico di Flaine e offre un'uscita rilassante."
    ],
    "fr": [
      "Balisé et sécurisé pour évoluer en pleine nature, l'itinéraire de ski de randonnée, d'Au fil de l'Aup contourne le domaine skiable de Flaine et vous offre une sortie randonnée apaisante."
    ],
    "es": [
      "La ruta de esquí de travesía Au fil de l'Aup, señalizada y segura para disfrutar al aire libre, bordea el dominio esquiable de Flaine y le ofrece un paseo relajante."
    ],
    "nl": [
      "De Au fil de l'Aup skitourroute, die bewegwijzerd en veilig is zodat je kunt genieten van de buitenlucht, loopt rond het skigebied van Flaine en biedt je een ontspannen uitje."
    ]
  },
  "rdfs:label": {
    "en": [
      "Au fil de l'Aup ski touring itinerary"
    ],
    "fr": [
      "Itinéraire de ski de randonnée Au fil de l'Aup"
    ],
    "nl": [
      "Au fil de l'Aup skiroute"
    ]
  },
