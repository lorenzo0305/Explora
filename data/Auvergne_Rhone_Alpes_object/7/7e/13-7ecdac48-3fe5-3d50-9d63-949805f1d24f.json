  "rdfs:comment": {
    "de": [
      "Ehemalige Kathedrale Notre-Dame de l'Assomption (11.-13. Jh.), die von den Protestanten abgerissen und im 17. Jahrhundert wieder aufgebaut wurde.\nFührung möglich in Verbindung mit der Stadtbesichtigung von Die."
    ],
    "en": [
      "Former Notre-Dame de l'Assomption Cathedral (IX-XIII century) demolished by Protestants and rebuilt in the XVII century.\nGuided visit possible with the guided tour of the town of Die."
    ],
    "it": [
      "Ex cattedrale di Notre-Dame de l'Assomption (XI-XIII secolo) demolita dai protestanti e ricostruita nel XVII secolo\nPossibilità di visita guidata con la visita della città di Die."
    ],
    "fr": [
      "Ancienne cathédrale Notre-Dame de l'Assomption (11ème-13ème) démolie par les protestants et reconstruite au 17ème siècle. \nVisite guidée possible avec la visite de la ville de Die."
    ],
    "nl": [
      "De voormalige kathedraal Notre-Dame de l'Assomption (11e-13e eeuw) werd afgebroken door de protestanten en herbouwd in de 17e eeuw.\nRondleiding mogelijk in combinatie met een bezoek aan de stad Die."
    ],
    "es": [
      "Antigua catedral de Notre-Dame de l'Assomption (siglos XI-XIII) demolida por los protestantes y reconstruida en el siglo XVII\nPosibilidad de visita guiada con la visita de la ciudad de Die."
    ]
  },
