  "rdfs:comment": {
    "de": [
      "La Grange Gourmande baut Austernpilze und Shiitake in kurzer Lieferkette an. Ultrafrische, lokal produzierte Pilze mit kurzen Transportwegen – besser für den Geschmack und für die Umwelt."
    ],
    "en": [
      "La Grange Gourmande grows oyster mushrooms and shiitake in a short supply chain. Ultra-fresh, locally produced mushrooms with minimal transport distance — better for the taste and for the environment."
    ],
    "it": [
      "La Grange Gourmande coltiva funghi ostrica e shiitake in un breve circuito. Funghi freschissimi, prodotti localmente per ridurre il numero di chilometri percorsi: meglio per il gusto e meglio per l'ambiente."
    ],
    "fr": [
      "La Grange Gourmande cultive pleurotes et shiitakés en circuit court. Des champignons ultra-frais, produits localement pour réduire les kilomètres parcourus : meilleur pour le goût et pour l’environnement."
    ],
    "nl": [
      "La Grange Gourmande kweekt oesterzwammen en shiitake paddenstoelen in een kort circuit. Ultraverse champignons, lokaal geproduceerd om het aantal afgelegde kilometers te verminderen: beter voor de smaak en beter voor het milieu."
    ],
    "es": [
      "La Grange Gourmande cultiva setas ostra y setas shiitake en un circuito corto. Setas ultrafrescas, producidas localmente para reducir el número de kilómetros recorridos: mejor para el sabor y mejor para el medio ambiente."
    ]
  },
  "rdfs:label": {
    "de": [
      "Die Gourmet-Scheune"
    ],
    "en": [
      "The gourmet barn"
    ],
    "fr": [
      "La grange gourmande"
    ]
  },
