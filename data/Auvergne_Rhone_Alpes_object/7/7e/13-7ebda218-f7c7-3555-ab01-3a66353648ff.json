  "rdfs:comment": {
    "de": [
      "Alizée und Alexandre begrüßen Sie das ganze Jahr über auf der Ziegenfarm zum Verkauf von Käse. Frischer, normaler oder aromatisierter Ziegenkäse, Wildleder, Joghurt, Serac, Tommes und Raclette."
    ],
    "en": [
      "Alizée and Alexandre welcome you to the goat farm all year round for the sale of cheeses. Fresh, plain or flavored goat cheese, buckskin, yogurt, serac, tommes and raclette."
    ],
    "it": [
      "Alizée e Alexandre vi accolgono nella fattoria delle capre per vendere formaggi. Formaggio fresco di capra, semplice o aromatizzato, chevrotin DOP, yogurt, sformati, serac, tommes e raclette."
    ],
    "fr": [
      "Alizée et Alexandre vous accueillent à la chèvrerie pour la vente de fromages. Fromages de chèvre frais, natures ou aromatisés, AOP chevrotin, yaourts, flans, sérac, tommes et raclette."
    ],
    "es": [
      "Alizée y Alexandre le dan la bienvenida a la granja de cabras para vender queso. Queso fresco de cabra, natural o aromatizado, chevrotin DOP, yogures, flanes, serac, tommes y raclette."
    ],
    "nl": [
      "Alizée en Alexandre heten u welkom op de geitenboerderij om kaas te verkopen. Verse geitenkaas, puur of gearomatiseerd, BOB chevrotin, yoghurts, vlaaien, serac, tommes en raclette."
    ]
  },
