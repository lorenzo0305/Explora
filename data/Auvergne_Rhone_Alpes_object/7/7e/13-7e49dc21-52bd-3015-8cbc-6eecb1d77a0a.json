  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Hochebene von Arbaron mithilfe der roten Nordic-Skipiste \"Pierre Carrée\". Bewegen Sie sich auf einer gespurten Loipe zwischen Tannen und einem offenen Plateau und machen Sie in Ihrem eigenen Rhythmus Fortschritte beim klassischen oder Skating-Langlauf."
    ],
    "en": [
      "Discover the Arbaron plateau on the red \"Pierre Carrée\" Nordic ski trail. Glide along a groomed track, between fir trees and an open plateau, and progress at your own pace on classic or skating cross-country skis."
    ],
    "it": [
      "Scoprite l'altopiano di Arbaron sulla pista rossa di sci nordico \"Pierre Carrée\". Scivolate su una pista battuta, tra abeti e un altopiano aperto, e procedete al vostro ritmo con gli sci da fondo classici o da skating."
    ],
    "fr": [
      "Découvrez le plateau de l'Arbaron grâce à la piste rouge de ski nordique \"Pierre Carrée\". Évoluez sur une piste damée, entre sapin et plateau dégagé et progressez à votre rythme en ski de fond classique ou skating."
    ],
    "nl": [
      "Ontdek het Arbaron plateau op de rode langlaufloipe \"Pierre Carrée\". Glijd over een geprepareerd spoor, tussen dennenbomen en een open plateau, en vorder in je eigen tempo op klassieke of skating langlaufski's."
    ],
    "es": [
      "Descubra la meseta de Arbaron en la pista roja de esquí nórdico \"Pierre Carrée\". Deslícese por una pista preparada, entre abetos y una meseta abierta, y progrese a su ritmo con esquís de fondo clásicos o de patinaje."
    ]
  },
  "rdfs:label": {
    "en": [
      "\"Pierre Carrée\" red nordic ski run"
    ],
    "fr": [
      "Piste rouge de ski nordique « Pierre Carrée »"
    ],
    "nl": [
      "Rode noordse skipiste “Pierre Carrée“"
    ]
  },
