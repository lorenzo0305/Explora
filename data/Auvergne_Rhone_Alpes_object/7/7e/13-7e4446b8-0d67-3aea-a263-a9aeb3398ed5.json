  "rdfs:comment": {
    "de": [
      "Der gemeinnützige Verein \"Centre International d'Art et d'Animation Raymond du Puy \" hat zum Ziel, kulturelle Veranstaltungen im alten Dorf Poët-Laval zu organisieren.Das Zentrum Yvon Morin wird von dem Verein verwaltet."
    ],
    "en": [
      "The non-profit association \"Centre International d'Art et d'Animation Raymond du Puy\" organizes cultural events in the old village of Le Poët-Laval, and runs the Yvon Morin center."
    ],
    "it": [
      "L'associazione senza scopo di lucro \"Centre International d'Art et d'Animation Raymond du Puy\" si propone di organizzare eventi culturali nell'antico villaggio di Le Poët-Laval."
    ],
    "fr": [
      "L'association a but non lucratif, d’intérêt général \"Centre International d’Art et d’Animation Raymond du Puy » a pour but d’organiser des manifestations culturelles au vieux village du Poët-Laval.Le centre Yvon Morin est géré par l'association."
    ],
    "es": [
      "La asociación sin ánimo de lucro \"Centre International d'Art et d'Animation Raymond du Puy\" tiene como objetivo organizar eventos culturales en el antiguo pueblo de Le Poët-Laval."
    ],
    "nl": [
      "Het doel van de vereniging zonder winstoogmerk \"Centre International d'Art et d'Animation Raymond du Puy\" is het organiseren van culturele evenementen in het oude dorp Le Poët-Laval. Het Centrum Yvon Morin wordt beheerd door de vereniging."
    ]
  },
  "rdfs:label": {
