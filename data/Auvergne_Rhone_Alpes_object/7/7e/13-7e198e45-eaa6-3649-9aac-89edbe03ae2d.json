  "rdfs:comment": {
    "de": [
      "Bergisches Ambiente, großer Kamin, Steindekor und sichtbare Balken. Große schattige Terrasse im Sommer. Traditionelle Speisekarte und zahlreiche savoyische Spezialitäten. Tartiflettes, Fondues, Raclettes. An das Restaurant angeschlossener Pub."
    ],
    "en": [
      "Mountain atmosphere, large fireplace, stone décor and exposed beams. Large shaded terrace in summer. Traditional menu and many Savoyard specialities. Tartiflettes, fondues, raclettes. Pub adjoining the restaurant."
    ],
    "it": [
      "Atmosfera di montagna, grande camino, arredamento in pietra e travi a vista. Ampia terrazza ombreggiata in estate. Menu tradizionale e molte specialità savoiarde. Tartiflettes, fondues, raclettes. Pub adiacente al ristorante."
    ],
    "fr": [
      "Ambiance montagnarde, grande cheminée, décor de pierres et poutres apparentes. Grande terrasse ombragée l'été. Carte traditionnelle et nombreuses spécialités savoyardes. Tartiflettes, fondues, raclettes. Pub attenant au restaurant."
    ],
    "nl": [
      "Bergsfeer, grote open haard, stenen decor en zichtbare balken. Groot schaduwrijk terras in de zomer. Traditioneel menu en veel Savoyaardse specialiteiten. Tartiflettes, fondues, raclettes. Pub naast het restaurant."
    ],
    "es": [
      "Ambiente de montaña, gran chimenea, decoración en piedra y vigas vistas. Gran terraza sombreada en verano. Menú tradicional y muchas especialidades saboyanas. Tartiflettes, fondues, raclettes. Pub adyacente al restaurante."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant Au Feu de Bois"
    ]
  },
