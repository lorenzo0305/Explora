  "rdfs:comment": {
    "de": [
      "Die Landschaft und das Kulturerbe verdienen es, gepflegt zu werden. Dafür sorgen Vereine. Sie organisieren Kurse, bei denen jeder seinen Beitrag leisten kann."
    ],
    "en": [
      "The landscape and heritage deserve to be maintained. Associations take care of this. They organize courses where everyone can make a contribution."
    ],
    "it": [
      "Il paesaggio e il patrimonio meritano di essere mantenuti. Le associazioni se ne occupano. Organizzano corsi in cui tutti possono dare il loro contributo."
    ],
    "fr": [
      "Le paysage et le patrimoine méritent d'être entretenus. Des association y veillent. Elles organisent des stages où tout le monde peut apporter sa pierre à l'édifice."
    ],
    "nl": [
      "Het landschap en het erfgoed verdienen het om onderhouden te worden. Verenigingen zorgen hiervoor. Ze organiseren cursussen waar iedereen een bijdrage aan kan leveren."
    ],
    "es": [
      "El paisaje y el patrimonio merecen ser mantenidos. Las asociaciones se ocupan de ello. Organizan cursos en los que todo el mundo puede contribuir."
    ]
  },
