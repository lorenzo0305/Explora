  "rdfs:comment": {
    "de": [
      "Verkauf von Parfüms „Fragonard“ aus Grasse, Wachsen mit Pflanzenharzen, Augenbrauenkorrektur, Bio-Gesichtsbehandlungen von Estime&Sens, Körperbehandlungen, Sauna, Einzel- oder Doppelmassage, SWEET PALPING zum Abnehmen und für Anti-Aging, Maniküre und Pediküre und VSP."
    ],
    "en": [
      "Sale of Grasse \"Fragonard\" perfumes, plant resin waxing, eyebrow reshaping, organic facials from Estime&Sens, body treatments, sauna, solo or duo massage, SWEET PALPING for slimming and anti-aging, manicure and pedicure, and VSP."
    ],
    "it": [
      "Vendita di profumi \"Fragonard\" di Grasse, Depilazione con resina vegetale, Ristrutturazione delle sopracciglia,\r\nTrattamenti viso biologici Estime&Sens,\r\nTrattamenti corpo,\r\nSauna,\r\nMassaggio individuale o in coppia,\r\nSWEET PALPING dimagrante e anti-età,\r\nBellezza di mani e piedi, VSP."
    ],
    "fr": [
      "Vente de parfums de Grasse \"Fragonard\", Épilations à la résine végétale, Restructuration des sourcils,\r\nSoins du visage bio Estime&Sens, \r\nSoins du corps,\r\nSauna,\r\nMassage solo ou duo, \r\nSWEET PALPING minceur & anti-âge, \r\nBeauté des mains, pieds, VSP."
    ],
    "nl": [
      "Verkoop van Grasse \"Fragonard\" parfums, harsbehandelingen met plantenhars, wenkbrauwen bijwerken, biologische gezichtsbehandelingen van Estime&Sens, lichaamsbehandelingen, sauna, solo- of duo-massage, SWEET PALPING voor afslanking en anti-aging, manicure en pedicure en VSP."
    ],
    "es": [
      "Venta de perfumes \"Fragonard\" de Grasse, Depilación con resina vegetal, Reestructuración de cejas,\r\nTratamientos faciales orgánicos Estime&Sens,\r\nTratamientos corporales,\r\nSauna,\r\nMasaje en solitario o en dúo,\r\nAdelgazamiento y antiedad SWEET PALPING,\r\nBelleza de manos y pies, VSP."
    ]
