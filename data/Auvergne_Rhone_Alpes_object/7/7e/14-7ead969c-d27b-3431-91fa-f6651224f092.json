  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/736aa7b5-7b41-3518-9897-98741028e3da",
      "dc:description": {
        "de": [
          "Samstag und Sonntag, 27. und 28. April 2024 um 16H30.\nBeobachten Sie in Begleitung des Zeitmeisters die Spuren der einzelnen Epochen, um die Geschichte des Schlosses zu rekonstruieren.\nKostenlos mit Reservierung unter 03 21 10 02 20.\nFreier Eintritt in das Schloss von 9:30 bis 12:30 Uhr und von 14:00 bis 17:30 Uhr."
        ],
        "en": [
          "Saturday and Sunday, April 27 and 28, 2024 at 4:30 pm.\nIn the company of the master of time, observe the traces of each era to reconstruct the history of the château.\nFree with reservation on 03 21 10 02 20.\nFree admission to the château from 9.30 a.m. to 12.30 p.m. and from 2 p.m. to 5.30 p.m."
        ],
        "it": [
          "Sabato e domenica 27 e 28 aprile 2024 alle 16.30.\nIn compagnia del maestro del tempo, osservate le tracce di ogni epoca per ricostruire la storia del castello.\nGratuito su prenotazione al numero 03 21 10 02 20.\nIngresso gratuito al castello dalle 9.30 alle 12.30 e dalle 14.00 alle 17.30."
        ],
        "fr": [
          "Samedi et dimanche 27 et 28 avril 2024 à 16H30.\nEn compagnie du maître du temps, observez les traces de chaque époque pour reconstituer l'histoire du château.\nGratuit sur réservation au 03 21 10 02 20.\nEntrée libre au château de 9H30 à 12H30 et de 14H à 17H30."
        ],
        "nl": [
          "Zaterdag en zondag 27 en 28 april 2024 om 16.30 uur.\nObserveer in gezelschap van de meester van de tijd de sporen van elk tijdperk om de geschiedenis van het kasteel te reconstrueren.\nGratis na reservering op 03 21 10 02 20.\nGratis toegang tot het kasteel van 9u30 tot 12u30 en van 14u tot 17u30."
        ],
        "es": [
          "Sábado y domingo 27 y 28 de abril de 2024 a las 16.30 h.\nEn compañía del maestro del tiempo, observe las huellas de cada época para reconstruir la historia del castillo.\nGratuito con reserva en el 03 21 10 02 20.\nEntrada gratuita al castillo de 9.30 a 12.30 h y de 14.00 a 17.30 h."
        ]
      },
