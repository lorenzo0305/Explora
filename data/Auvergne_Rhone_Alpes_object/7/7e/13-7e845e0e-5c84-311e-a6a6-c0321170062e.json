  "rdfs:comment": {
    "de": [
      "Dieses neu übernommene Restaurant bietet Ihnen eine qualitativ hochwertige, hausgemachte und saisonale Küche in einer grünen Umgebung am Ufer des Flusses. Unsere moderne, feine und leckere Speisekarte wird auch den kühnsten Gaumen überraschen."
    ],
    "en": [
      "Newly taken over, this restaurant offers quality, home-cooked, seasonal cuisine in a leafy setting on the riverbank. Our modern, fine and gourmet menu will surprise even the most daring palates."
    ],
    "it": [
      "Recentemente ristrutturato, questo ristorante offre una cucina di qualità, casalinga e stagionale in un ambiente verdeggiante in riva al mare. Il nostro menu moderno, raffinato e gourmet sorprenderà anche i palati più audaci."
    ],
    "fr": [
      "Nouvellement repris, ce restaurant vous offrira une cuisine de qualité, faite maison et de saison le tout dans un cadre verdoyant au bord de l’eau. Notre carte à la fois moderne, fine et gourmande saura surprendre les palais les plus audacieux."
    ],
    "es": [
      "Recién inaugurado, este restaurante ofrece una cocina casera, de temporada y de calidad en un frondoso entorno junto al agua. Nuestro menú moderno, fino y gourmet sorprenderá incluso a los paladares más atrevidos."
    ],
    "nl": [
      "Dit restaurant is pas overgenomen en biedt een huisgemaakte seizoenskeuken van hoge kwaliteit in een groene omgeving aan het water. Ons moderne, verfijnde en gastronomische menu zal zelfs de meest gewaagde fijnproevers verrassen."
    ]
  },
  "rdfs:label": {
    "en": [
      "Restaurant La Voile Blanche"
    ],
    "fr": [
      "Restaurant La Voile Blanche"
    ]
  },
