  "rdfs:comment": {
    "de": [
      "Ein gesicherter Bereich, der vom Dorfzentrum aus zu Fuß erreichbar ist. Er ist nach einem 15-minütigen Spaziergang vom Etringa-Weg aus nach Forme d'O erreichbar."
    ],
    "en": [
      "A secured area accessible on foot from the center of the village, 15mn walk from the Chemin de l'Etringa after the water park Forme d'O. Admission free."
    ],
    "it": [
      "Area protetta accessibile a piedi dal centro del paese, raggiungibile dopo 15 minuti di cammino dal sentiero Etringa dopo Forme d'O."
    ],
    "fr": [
      "Une aire sécurisée accessible à pied depuis le centre du village, accessible après 15 minutes de marche depuis le chemin de l'Etringa après Forme d'O."
    ],
    "es": [
      "Una zona segura accesible a pie desde el centro del pueblo, a la que se accede tras un paseo de 15 minutos desde el camino de Etringa después de Forme d'O."
    ],
    "nl": [
      "Een beveiligde piste, te voet bereikbaar vanaf het centrum van Châtel. Gratis toegang."
    ]
  },
