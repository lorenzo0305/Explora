  "rdfs:comment": {
    "de": [
      "Dieser Slopestyle verknüpft 2 doppelte Erd-Jumps, Wall Ride, Step Down, 2 große doppelte Erd-Jumps und 2 große Metallrampen Typ Motocross mit Landung in Spänen."
    ],
    "en": [
      "This slopestyle features 2 double dirt jumps, a wall ride, a step down, 2 big double dirt jumps and 2 big moto cross type metal ramps with a chip landing."
    ],
    "it": [
      "Questo slopestyle presenta 2 doppi salti nel terreno, un wall ride, uno step down, 2 grandi doppi salti nel terreno e 2 grandi rampe metalliche di tipo motocross con un chip landing."
    ],
    "fr": [
      "Ce slopestyle enchaînant enchaînant 2 doubles jumps en terre, wall ride, step down, 2 grosses doubles en terre et 2 grosses rampes métalliques type moto cross avec réception en copeaux ."
    ],
    "es": [
      "Este slopestyle cuenta con 2 saltos dobles en el suelo, un wall ride, un step down, 2 grandes saltos dobles en el suelo y 2 grandes rampas metálicas tipo motocross con un chip landing."
    ],
    "nl": [
