  "rdfs:comment": {
    "de": [
      "Der Verein VESPA hat sich zum Ziel gesetzt, das historische und kulturelle Erbe von Vassivain anhand verschiedener Dokumente zu erforschen und zu studieren: schriftlich, mündlich, durch Gebäude oder Natur. Der Verein hat die Restaurierung der Mühlen von Le Mure initiiert."
    ],
    "en": [
      "The VESPA association aims to research and study Vassivain's historical and cultural heritage through a variety of documents: written, oral, built or natural. The association is behind the restoration of the Moulins de le Mure."
    ],
    "it": [
      "L'associazione VESPA si propone di ricercare e studiare il patrimonio storico e culturale di Vassivain attraverso vari documenti: scritti, orali, costruiti o naturali. L'associazione è responsabile del restauro dei Moulins de le Mure."
    ],
    "fr": [
      "L'association VESPA  a pour but de rechercher, d'étudier le patrimoine historique et culturel Vassivain à travers divers documents : écrit, oral, bâti ou naturel. L'association est à l'initiative de la restauration des Moulins de le Mure."
    ],
    "nl": [
      "Het doel van de vereniging VESPA is het onderzoeken en bestuderen van het historisch en cultureel erfgoed van Vassivain aan de hand van verschillende documenten: geschreven, mondeling, gebouwd of natuurlijk. De vereniging staat aan de basis van de restauratie van de Moulins de le Mure."
    ],
    "es": [
      "El objetivo de la asociación VESPA es investigar y estudiar el patrimonio histórico y cultural de Vassivain a través de diversos documentos: escritos, orales, construidos o naturales. La asociación está detrás de la restauración de los Moulins de le Mure."
    ]
  },
