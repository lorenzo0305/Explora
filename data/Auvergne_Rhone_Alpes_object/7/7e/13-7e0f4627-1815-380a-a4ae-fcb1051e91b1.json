  "rdfs:comment": {
    "de": [
      "Von Cize oder Corveissiat aus eine große Schleife über die Höhen des Mont du Couloir (668 m), Côte du Fay, Arnans oder die Schluchten des Ain, über die Felsen der Klippen von Echazeaux und Chatillon durch den Bois du Tanay."
    ],
    "en": [
      "Starting from Cize or Corveissiat, a long loop on the heights of Mont du Couloir (668 m), Côte du Fay, Arnans or the Ain gorges, on the rocks of the Echazeaux and Chatillon cliffs, passing through the Bois du Tanay."
    ],
    "it": [
      "Partendo da Cize o Corveissiat, un lungo anello sulle alture del Mont du Couloir (668 m), della Côte du Fay, di Arnans o delle Gorges de l'Ain, sulle rocce delle falesie di Echazeaux e Chatillon, passando per il Bois du Tanay."
    ],
    "fr": [
      "Au départ de Cize ou de Corveissiat, une grande boucle sur les hauteurs du Mont du Couloir (668 m), côte du Fay, Arnans ou des gorges de l'Ain, sur les roches des falaises d'Echazeaux et de Chatillon en passant par le Bois du Tanay."
    ],
    "nl": [
      "Vertrek vanuit Cize of Corveissiat, een lange lus over de hoogten van de Mont du Couloir (668 m), Côte du Fay, Arnans of de Gorges de l'Ain, over de rotsen van de Echazeaux en Chatillon kliffen, door het Bois du Tanay."
    ],
    "es": [
      "Partiendo de Cize o Corveissiat, un largo bucle en las alturas del Mont du Couloir (668 m), la Côte du Fay, Arnans o las Gorges de l'Ain, sobre las rocas de los acantilados de Echazeaux y Chatillon, pasando por el Bois du Tanay."
    ]
  },
  "rdfs:label": {
    "en": [
      "Circuit VTTAE n°30 (noir) - Monts de Corveissiat - Belvédères d'Echazeaux"
    ],
    "fr": [
      "Circuit VTTAE n°30 (noir) - Monts de Corveissiat - Belvédères d'Echazeaux"
    ]
  },
