  "rdfs:comment": {
    "de": [
      "Willkommen in einem Raum, der sich zwischen Bar - Restaurant - Club und allgemeinem Lebensraum bewegt!\r\n\r\nUnser Programm ist vielfältig, eklektisch und kann zwischen elektronischer Musik, urbaner Musik, Rock, Blues, Reggae, von den 80er Jahren′, 90′, 2000′ bis heute jonglieren."
    ],
    "en": [
      "Welcome to Comptoir Général Valence, a space that's part bar, part restaurant, part club, and part lifestyle!\r\n\r\nOur programming is varied, eclectic and can juggle electronic, urban, rock, blues, reggae music, from the 80′, 90′, 2000′ to the present day."
    ],
    "it": [
      "Benvenuti in uno spazio che si muove tra Bar ? Ristorante? Club e spazio abitativo generale!\r\n\r\nLa nostra programmazione è varia ed eclettica, con musica elettronica, urbana, rock, blues e reggae degli anni '80, '90, 2000 e oltre."
    ],
    "fr": [
      "Bienvenue dans un espace évoluant entre Bar – Restaurant – Club et lieu de vie en général !\r\n\r\nNotre programmation est variée, éclectique et peut jongler entre musiques électroniques, urbaines, rock, blues, reggae, des années 80′, 90′, 2000′ à nos jours."
    ],
    "nl": [
      "Welkom bij Comptoir Général Valence, een ruimte die deels bar, deels restaurant, deels club en in het algemeen een geweldige plek om te wonen is!\r\n\r\nOnze programmering is gevarieerd en eclectisch, met elektronische, urban, rock-, blues- en reggaemuziek uit de jaren 80, 90 en 2000 tot nu."
    ],
    "es": [
      "Bienvenido a un espacio que se mueve entre Bar ? ¿Restaurante? ¡Club y espacio de vida en general!\r\n\r\nNuestra programación es variada y ecléctica, haciendo malabares con música electrónica, urbana, rock, blues y reggae de los 80, 90, 2000 y más allá."
    ]
  },
