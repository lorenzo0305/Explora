  "rdfs:comment": {
    "de": [
      "Im intimen Raum einer Küche liefert Sylvain Levey den autobiografischen, sensiblen und witzigen Bericht eines übergewichtigen Teenagers, der sich unter dem diskriminierenden Blick der anderen aufbauen musste."
    ],
    "en": [
      "In the intimate space of a kitchen, Sylvain Levey delivers the autobiographical, sensitive and funny story of an overweight teenager who had to build himself under the discriminating gaze of others."
    ],
    "it": [
      "Nell'ambiente intimo di una cucina, Sylvain Levey racconta la storia autobiografica, sensibile e divertente, di un adolescente sovrappeso che ha dovuto costruire la sua vita sotto lo sguardo discriminatorio degli altri."
    ],
    "fr": [
      "Dans l’espace intime d’une cuisine, Sylvain Levey livre le récit autobiographique, sensible et drôle d’un adolescent en surpoids qui a dû se construire sous le regard discriminant de l’autre."
    ],
    "nl": [
      "In de intieme setting van een keuken vertelt Sylvain Levey het gevoelige en grappige autobiografische verhaal van een tiener met overgewicht die zijn leven heeft moeten opbouwen onder de discriminerende blik van anderen."
    ],
    "es": [
      "En el marco íntimo de una cocina, Sylvain Levey cuenta la sensible y divertida historia autobiográfica de un adolescente con sobrepeso que ha tenido que construir su vida bajo la mirada discriminatoria de los demás."
    ]
  },
