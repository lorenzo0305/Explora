  "rdfs:comment": {
    "de": [
      "Diese drei Musiker entführen und misshandeln mit ihren Stimmen, Gitarren, Kontrabass und Schlagzeug im Stil der Guinguette fröhlich das internationale Chanson."
    ],
    "en": [
      "With their vocals, guitars, double bass and guinguette-style percussion, these three musicians happily kidnap and mishandle international chanson."
    ],
    "it": [
      "Questi tre musicisti usano le loro voci, le chitarre, il controfagotto e le percussioni in stile guinguette per rapire e manipolare la chanson internazionale."
    ],
    "fr": [
      "Ces trois musiciens par l'entremise de leurs voix, guitares, contrebassine et percuterie façon guinguette, kidnappent et malmènent allègrement la chanson internationale."
    ],
    "es": [
      "Estos tres músicos utilizan sus voces, guitarras, contrafagot y percusión estilo guinguette para secuestrar y maltratar la chanson internacional."
    ],
    "nl": [
      "Deze drie muzikanten gebruiken hun stemmen, gitaren, contrafagot en guinguette-achtige percussie om het internationale chanson te ontvoeren en te mishandelen."
    ]
  },
  "rdfs:label": {
    "fr": [
