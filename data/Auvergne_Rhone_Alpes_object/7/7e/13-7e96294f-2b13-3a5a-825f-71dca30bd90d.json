  "rdfs:comment": {
    "de": [
      "4 Plätze im Freien. Tennisschule, Freizeit oder Wettkampf.\r\nStundenpass im Office de Tourisme oder in der MMA-Agentur (1, rue de Metz, gegenüber der Kirche) erhältlich."
    ],
    "en": [
      "4 outdoor courts. Tennis school, leisure or competition.\r\nHourly passes available from the Tourist Office or the MMA agency (1, rue de Metz, opposite the church)."
    ],
    "it": [
      "4 campi all'aperto. Scuola di tennis, tempo libero o competizione.\r\nTessera oraria disponibile presso l'Ufficio del Turismo o presso l'agenzia MMA (1, rue de Metz, di fronte alla chiesa)."
    ],
    "fr": [
      "4 courts extérieurs. École de tennis, loisirs ou compétition.\r\nPass horaire délivrable à l'Office de Tourisme ou à l'agence MMA (1, rue de Metz, face à l'église)."
    ],
    "es": [
      "4 pistas exteriores. Escuela de tenis, ocio o competición.\r\nAbono disponible en la Oficina de Turismo o en la agencia MMA (1, rue de Metz, frente a la iglesia)."
    ],
    "nl": [
      "4 buitenbanen. Tennisschool, vrije tijd of competitie.\r\nTijdkaart verkrijgbaar bij het VVV-kantoor of bij het MMA-agentschap (1, rue de Metz, tegenover de kerk)."
    ]
  },
