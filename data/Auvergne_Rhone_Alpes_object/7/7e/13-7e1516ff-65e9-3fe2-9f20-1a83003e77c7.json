  "rdfs:comment": {
    "de": [
      "Auf dieser langen Strecke lernen Sie die vielen Facetten der Nordseite des Bosse-Massivs kennen\r\nEin Wechselspiel aus mehr oder weniger steilen Pfaden und Wegen führt Sie bis zum Fluss Bouble."
    ],
    "en": [
      "This long trail reveals the many facets of the northern slopes of the Bosse massif.\r\nAlternating paths and tracks of varying steepness lead you down to the Bouble river."
    ],
    "it": [
      "Questo lungo percorso permette di scoprire le molteplici sfaccettature del versante settentrionale del massiccio del Bosse\r\nUn'alternanza di sentieri e percorsi più o meno ripidi conduce al fiume Bouble."
    ],
    "fr": [
      "Ce long parcours vous fait découvrir les multiples facettes du versant Nord du massif de la Bosse. \r\nUne alternance de sentiers et de chemins plus ou moins abrupts vous conduit jusqu’à la rivière la Bouble."
    ],
    "es": [
      "Esta larga ruta permite descubrir las múltiples facetas de la vertiente norte del macizo del Bosse\r\nUna alternancia de senderos y pistas más o menos empinadas le lleva al río Bouble."
    ],
    "nl": [
      "Deze lange route laat u de vele facetten van de noordelijke helling van het Bosse massief ontdekken\r\nEen afwisseling van paden en min of meer steile wegen leidt u naar de rivier de Bouble."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Spot Trail de La Bosse - De La Bouble aux Colettes"
    ]
  },
