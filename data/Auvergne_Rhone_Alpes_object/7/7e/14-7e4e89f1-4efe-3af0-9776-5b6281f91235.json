      "dc:description": {
        "de": [
          "Geselliges Restaurant, das traditionelle Küche in einem gemütlichen Rahmen anbietet.\n\nEs ist von Dienstag bis Sonntag mittags geöffnet.\n\nWeitere Informationen und Reservierungen unter 03.21.01.59.02"
        ],
        "en": [
          "Convivial restaurant offering traditional cuisine in a warm setting.\n\nOpen Tuesday to Sunday lunchtime.\n\nFurther information and reservations on 03.21.01.59.02"
        ],
        "it": [
          "Un ristorante accogliente che serve cucina tradizionale in un ambiente accogliente.\n\nAperto dal martedì alla domenica a pranzo.\n\nUlteriori informazioni e prenotazioni allo 03.21.01.59.02"
        ],
        "fr": [
          "Restaurant convivial proposant de la cuisine traditionnelle dans un cadre chaleureux.\n\nIl est ouvert du mardi au dimanche midi.\n\nPlus d'informations et réservation au 03.21.01.59.02"
        ],
        "nl": [
          "Een vriendelijk restaurant dat traditionele gerechten serveert in een gezellige omgeving.\n\nGeopend van dinsdag tot zondag tijdens lunchtijd.\n\nMeer informatie en reserveringen op 03.21.01.59.02"
        ],
        "es": [
          "Acogedor restaurante de cocina tradicional.\n\nAbierto de martes a domingo a mediodía.\n\nMás información y reservas en el 03.21.01.59.02"
        ]
      },
