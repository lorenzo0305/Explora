  "rdfs:comment": {
    "de": [
      "Ptit plat mobil, die Lösung für Ihre Mittagspause! Sie brauchen nicht mehr herumzulaufen, sondern Ihr Essen kommt zu Ihnen (in der Gegend von Ambert Courpière) mit einem 100%igen Schlemmermenü! Reservierung am Vortag vor 19 Uhr."
    ],
    "en": [
      "P’tit plat mobil, the perfect solution for your lunch break! No need to run out\r\nfor lunch, your meal can come to you (in the Ambert / Courpière sector) with\r\na 100% gourmet menu! Reservations the previous evening before 7 p.m."
    ],
    "it": [
      "Ptit plat mobil, la soluzione per la vostra pausa pranzo! Non c'è bisogno di correre, il pasto viene da voi (nella zona di Ambert Courpière) con un menu 100% gourmet! Prenotazione il giorno prima entro le ore 19.00."
    ],
    "fr": [
      "Ptit plat mobil, la solution pour votre pause-déjeuner ! Plus besoin de courir partout c'est votre repas qui vient à vous (dans le secteur Ambert Courpière) avec un menu 100% gourmand ! Réservation la veille avant 19h."
    ],
    "nl": [
      "Ptit plat mobil, de oplossing voor uw lunchpauze! U hoeft niet rond te lopen, uw maaltijd komt naar u toe (in de wijk Ambert Courpière) met een 100% gastronomisch menu! Reservering de dag ervoor voor 19.00 uur."
    ],
    "es": [
      "Ptit plat mobil, ¡la solución para la pausa del almuerzo! No hay que correr, su comida viene a usted (en la zona de Ambert Courpière) con un menú 100% gourmet Reservar el día anterior antes de las 19:00 horas."
    ]
  },
  "rdfs:label": {
    "en": [
      "P'tit Plat mobil"
    ],
