  "rdfs:comment": {
    "de": [
      "Ein 39° warmes NORWEGISCHES BAD sowie eine SAUNA-TONNEAU mit einem riesigen Bullauge thronen inmitten der Wälder auf den Höhen des Hauses und bilden den Rahmen für eine Umgebung, die ganz auf Ihr Wohlbefinden ausgerichtet ist!"
    ],
    "en": [
      "A NORWEGIAN BATH at 39° and a SAUNA TONNEAU with its giant porthole sit vapidly in the middle of the woods high above the house, setting the scene for an environment entirely designed for your well-being!"
    ],
    "it": [
      "Un BAGNO NORVEGIANO a 39° e una SAUNA TONNEAU con un gigantesco oblò si trovano in mezzo al bosco sopra la casa, creando un ambiente interamente progettato per il vostro benessere!"
    ],
    "fr": [
      "Un BAIN NORVEGIEN à 39°ainsi qu'un TONNEAU SAUNA avec son hublot géant trônent vaporeusement au milieu des bois sur les hauteurs de la maison et pose le cadre d'un environnement entièrement aménagé pour votre bien-être !"
    ],
    "es": [
      "Un BAÑO NORUEGO a 39° y una SAUNA TONNEAU con su ojo de buey gigante se asientan vaporosamente en medio del bosque, muy por encima de la casa, creando el escenario de un entorno totalmente diseñado para su bienestar"
    ],
    "nl": [
      "Een NORWEGIAN BATH van 39° en een SAUNA TONNEAU met een gigantische patrijspoort liggen dampend midden in het bos hoog boven het huis en vormen het decor voor een omgeving die helemaal is ontworpen voor jouw welzijn!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Espace détente à la Roche Aux Fées"
    ]
  },
