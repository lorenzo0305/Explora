  "rdfs:comment": {
    "de": [
      "Der Leysse ist ein reißender, wilder Bach, der aus dem Bauges-Massiv fließt und ab Chambéry bis zum Lac du Bourget zu einem Fluss der Ebene wird."
    ],
    "en": [
      "The Leysse is a torrential and wild stream flowing from the Bauges massif, which becomes a plain river from Chambéry to the Bourget lake."
    ],
    "it": [
      "La Leysse è un torrente torrenziale e selvaggio che scorre dal massiccio dei Bauges e che diventa un fiume di pianura da Chambéry al lago del Bourget."
    ],
    "fr": [
      "La Leysse est un ruisseau torrentueux et sauvage s'écoulant du massif des Bauges, qui devient une rivière de plaine à partir de Chambéry jusqu'au lac du Bourget."
    ],
    "es": [
      "El Leysse es un torrente torrencial y salvaje que fluye desde el macizo de Bauges y se convierte en río de llanura desde Chambéry hasta el lago Bourget."
    ],
    "nl": [
      "De Leysse is een onstuimige en wilde beek die uit het Bauges-massief stroomt en vanaf Chambéry overgaat in een vlakke rivier tot aan het meer van Bourget."
    ]
  },
  "rdfs:label": {
