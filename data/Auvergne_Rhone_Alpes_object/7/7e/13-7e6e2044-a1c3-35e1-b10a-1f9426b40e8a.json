  "rdfs:comment": {
    "de": [
      "Traditionelle indische Küche. Typische scharfe Gerichte (ohne Chili). Naan im traditionellen Tandoori-Ofen gebacken. Zahlreiche Spezialitäten der indischen Gastronomie."
    ],
    "en": [
      "Traditional Indian cuisine. Typical spicy dishes (without chilli pepper). Naan cooked in traditional tandoori oven. Numerous specialties of Indian gastronomy."
    ],
    "it": [
      "Cucina tradizionale indiana. Piatti tipici piccanti (senza peperoncino). Naan cotto nel tradizionale forno tandoori. Molte specialità della gastronomia indiana."
    ],
    "fr": [
      "Cuisine indienne traditionnelle. Plats typiques épicés (sans piment). Naan cuits au four tandoori traditionnel. Nombreuses spécialités de la gastronomie indienne."
    ],
    "nl": [
      "Traditionele Indiase keuken. Typische pittige gerechten (zonder chili). Naan gebakken in een traditionele tandoori oven. Veel specialiteiten van de Indiase gastronomie."
    ],
    "es": [
      "Cocina tradicional india. Platos típicos picantes (sin guindilla). Naan cocinado en un horno tandoori tradicional. Muchas especialidades de la gastronomía india."
    ]
  },
