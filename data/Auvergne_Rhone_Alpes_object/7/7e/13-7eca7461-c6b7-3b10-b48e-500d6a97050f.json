  "rdfs:comment": {
    "de": [
      "Le Délice des Elfes heißt Sie am Parkeingang willkommen – hier können Sie Ihre Tickets kaufen und ein heißes oder kaltes Getränk genießen. Ein köstlicher Halt vor dem Zauber!"
    ],
    "en": [
      "Le Délice des Elfes welcomes you at the entrance of the park to buy your tickets and enjoy a hot or cold drink. A tasty stop before your magical adventure!"
    ],
    "it": [
      "Le Délice des Elfes ti accoglie all’ingresso del parco per acquistare i biglietti e gustare una bevanda calda o fresca. Una tappa golosa prima dell’avventura magica!"
    ],
    "fr": [
      "Le Délice des Elfes vous accueille à l’entrée du parc pour acheter vos billets et savourer une boisson chaude ou fraîche. Un passage gourmand avant l’aventure féerique !"
    ],
    "es": [
      "Le Délice des Elfes te da la bienvenida en la entrada del parque para comprar tus entradas y disfrutar de una bebida caliente o fría. ¡Una parada deliciosa antes de la aventura mágica!"
    ],
    "nl": [
      "Le Délice des Elfes heet je welkom bij de ingang van het park voor tickets en een warme of frisse drank. Een smakelijke stop voor je magisch avontuur!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Délice des Elfes"
    ]
  },
