  "rdfs:comment": {
    "de": [
      "Lust auf einen ungewöhnlichen Berg? Ein authentisches & geheimes Gebirge, das Tal von Haut-Bréda... Wanderungen mit Schneeschuhen. Eine unberührte Natur & Seen, wenig begangene \"Passagen\". Die Entdeckung der Alpenflora durch verschiedene Bergmassive."
    ],
    "en": [
      "Looking for an unusual mountain? An authentic & secret mountain, the Haut-Bréda Valley... Snowshoe hikes. Unspoiled nature and lakes, uncrowded \"passages\". Discover Alpine flora through a variety of massifs."
    ],
    "it": [
      "Cercate una montagna insolita? Una montagna autentica e segreta, la Valle dell'Haut-Bréda... Escursioni con le racchette da neve. Natura incontaminata e laghi, \"passaggi\" poco frequentati. Scoprite la flora delle Alpi attraverso una varietà di massicci."
    ],
    "fr": [
      "Envie de Montagne insolite ? Une Montagne authentique & secrète, la Vallée du Haut-Bréda... Randonnées en raquettes. Une Nature & des lacs préservés, des \"passages\" peu courus. La découverte de la Flore alpine à travers des massifs variés."
    ],
    "es": [
      "¿Busca una montaña insólita? Una montaña auténtica y secreta, el valle de Haut-Bréda... Excursiones con raquetas de nieve. Naturaleza virgen y lagos, \"pasajes\" sin masificar. Descubra la flora de los Alpes a través de diversos macizos."
    ],
    "nl": [
      "Op zoek naar een ongewone berg? Een authentieke en geheime berg, de vallei van de Haut-Bréda... Wandelingen met sneeuwschoenen. Ongerepte natuur en meren, niet-bevolkte \"doorgangen\". Ontdek de flora van de Alpen via verschillende massieven."
    ]
  },
  "rdfs:label": {
    "en": [
      "Guide Mountain Eric PICOLLET"
    ],
    "fr": [
      "Eric PICOLLET Accompagnateur Montagne"
    ]
  },
