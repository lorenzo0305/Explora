  "rdfs:comment": {
    "de": [
      "Mitten im Dorf am Fuß der Hänge, 30 m von der Skischule entfernt.  Verleih- und Verkauf von Skiern, Snowboards, Skiwanderungen, Sicherheitspakete, Zubehör für kinder und erwaschsene ... Neu: Sie können am Fuß der Hänge Ihr beheizbares Schließfach (für Skier, Skistöcke und Skischuhe) mieten."
    ],
    "en": [
      "In the heart of the village, at the bottom of the slopes, 30m away from the ski school. Rental, sale of skis, snowboards, ski touring, safety pack, accessories for children and adult... New : rent a heated ski locker (shoes, skis and poles) at the bottom of the slopes."
    ],
    "it": [
      "Nel cuore del villaggio, ai piedi delle piste, a 30 m dalla scuola di sci. Noleggio, vendita di sci, snowboard, accessori... per bambini e adulti. Noleggio dell'armadietto riscaldato (scarponi, sci e bastoncini) ai piedi delle piste."
    ],
    "fr": [
      "Au cœur du village, au pied des pistes, à 30m de l'école de ski. Location, vente skis, surfs, accessoires... enfant et adulte. Louez votre casier chauffant (chaussures, skis et bâtons) au pied des pistes."
    ],
    "nl": [
      "In het hart van het dorp, aan de voet van de pistes, op 30 meter van de skischool. Verhuur, verkoop van ski's, snowboards, accessoires... voor kinderen en volwassenen. Verhuur van verwarmde kluisjes (schoenen, ski's en stokken) aan de voet van de pistes."
    ],
    "es": [
      "En el corazón del pueblo, al pie de las pistas, a 30 m de la escuela de esquí. Alquiler, venta de esquís, snowboards, accesorios... para niños y adultos. Alquile su taquilla climatizada (botas, esquís y bastones) a pie de pistas."
    ]
  },
