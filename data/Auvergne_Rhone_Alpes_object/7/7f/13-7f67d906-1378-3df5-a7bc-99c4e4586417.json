  "rdfs:comment": {
    "de": [
      "Nathalie servieren Ihnen eine traditionelle Küche auf Basis von Terroir-Produkten und empfangen Sie in 2 mit einem Kinderbereich ausgestatteten Restaurant-Räumen. Das Restaurant verfügt auch über eine Terrasse und liegt in der Nähe des Freilichtmuseums \"Écomusée des Monts du Forez\"."
    ],
    "en": [
      "Nathalie welcomes you to her restaurant located in the heart of the green resort of Usson. Young and old alike will be able to enjoy a traditional cuisine of quality based on fresh products. Former Rival restaurant."
    ],
    "it": [
      "Nathalie è un'istituzione nella vita locale di Ussonnaise e vi accoglie nel suo ristorante situato nel cuore del villaggio. Grandi e piccini potranno gustare una cucina tradizionale di qualità basata su prodotti freschi, senza rinunciare alle specialità locali."
    ],
    "fr": [
      "Institution de la vie locale Ussonnaise, Nathalie vous reçoit dans son restaurant situé en plein cœur du village. Petits et grands pourront y déguster une cuisine traditionnelle de qualité à base de produits frais sans manquer les spécialités locales."
    ],
    "nl": [
      "Nathalie, een instituut in het lokale leven van Ussonnaise, heet u welkom in haar restaurant in het hart van het dorp. Jong en oud kunnen genieten van een traditionele kwaliteitskeuken op basis van verse producten zonder de lokale specialiteiten te missen."
    ],
    "es": [
      "Nathalie es una institución en la vida local de Ussonnaise y le da la bienvenida a su restaurante situado en el corazón del pueblo. Tanto los jóvenes como los mayores pueden disfrutar de una cocina tradicional de calidad basada en productos frescos, sin perderse las especialidades locales."
    ]
  },
  "rdfs:label": {
