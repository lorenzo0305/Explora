  "rdfs:comment": {
    "de": [
      "Die handwerkliche Brauerei l'Etincelle wurde 2018 in Granges du Poizat gegründet. Sie ist nun in Nantua ansässig und stellt ausschließlich zertifizierte Bio-Biere her. Das ganze Augenmerk liegt auf der Qualität und Originalität der Produktion."
    ],
    "en": [
      "The Etincelle craft brewery was created in 2018 at Les Granges du Poizat. Now based in Nantua, it produces only certified organic beers. The focus is on quality and originality."
    ],
    "it": [
      "Il birrificio artigianale Etincelle è stato creato nel 2018 a Les Granges du Poizat. Ora ha sede a Nantua e produce solo birre biologiche certificate. Tutta l'attenzione è rivolta alla qualità e all'originalità della produzione."
    ],
    "fr": [
      "La brasserie artisanale l'Etincelle a été créée en 2018 aux Granges du Poizat. Désormais installée à Nantua, elle ne produit que des bières certifiées Bio. Toute l'attention se porte sur la qualité et l'originalité de la production."
    ],
    "es": [
      "La cervecería artesanal Etincelle se creó en 2018 en Les Granges du Poizat. Ahora, con sede en Nantua, sólo produce cervezas ecológicas certificadas. Toda la atención se centra en la calidad y originalidad de la producción."
    ],
    "nl": [
      "De ambachtelijke brouwerij Etincelle werd in 2018 opgericht in Les Granges du Poizat. Nu gevestigd in Nantua, produceert het alleen gecertificeerde biologische bieren. Alle aandacht gaat uit naar de kwaliteit en de originaliteit van de productie."
    ]
  },
  "rdfs:label": {
