  "rdfs:comment": {
    "de": [
      "Diese Stadtstrecke ist sehr leicht zugänglich und wird zur Freude der Angler regelmäßig mit Regenbogenforellen besetzt."
    ],
    "en": [
      "This urban course is very easy to access and regularly restocked with rainbow trout for the great pleasure of fishermen."
    ],
    "it": [
      "Questo percorso urbano è molto facile da raggiungere e viene regolarmente ripopolato con trote iridee per il grande piacere dei pescatori."
    ],
    "fr": [
      "Ce parcours urbain est très facile d'accès et repeuplé régulièrement en truite arc-en-ciel pour le plus grand plaisir des pêcheurs."
    ],
    "es": [
      "Este recorrido urbano es de muy fácil acceso y se repobla regularmente con truchas arco iris para gran placer de los pescadores."
    ],
    "nl": [
      "Deze stedelijke baan is zeer goed toegankelijk en wordt regelmatig aangevuld met regenboogforel tot groot genoegen van de vissers."
    ]
  },
  "rdfs:label": {
