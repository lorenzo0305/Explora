  "rdfs:comment": {
    "de": [
      "Von Gesichtern zu Ufern in Hérisson. Von den Ufern und Brücken des Aumance über die mittelalterlichen Gassen bis hin zum Schloss erfahren Sie, wie die Bewohner und Akteure des örtlichen Lebens die Nähe zu einem wichtigen Element der Szenerie erleben."
    ],
    "en": [
      "From faces to shores in Hérisson. From the banks and bridges of the Aumance to the castle, via the medieval streets, you'll discover how local residents and players experience this proximity to a major element of the scenery."
    ],
    "it": [
      "Dai volti alle rive a Hérisson. Dalle rive e dai ponti dell'Aumance al castello, passando per le strade medievali, scoprirete come la gente del posto e gli attori della vita locale vivono questa vicinanza a un elemento importante del paesaggio."
    ],
    "fr": [
      "De visages en rivages à Hérisson. Des rives et ponts de l'Aumance jusqu'au château en passant par les ruelles médiévales, vous découvrirez comment habitants et acteurs de la vie locale vivent cette proximité avec un élément majeur du décor."
    ],
    "nl": [
      "Van gezichten tot oevers in Hérisson. Van de oevers en bruggen van de Aumance tot het kasteel, via de middeleeuwse straatjes, ontdekt u hoe de lokale bevolking en de mensen die betrokken zijn bij het lokale leven deze nabijheid van een belangrijk element van het landschap ervaren."
    ],
    "es": [
      "De los rostros a las orillas en Hérisson. Desde las orillas y los puentes de la Aumance hasta el castillo, pasando por las calles medievales, descubrirá cómo viven los habitantes y los actores de la vida local esta proximidad a un elemento importante del paisaje."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parcours sonore de Hérisson- De visages en rivages"
    ]
  },
