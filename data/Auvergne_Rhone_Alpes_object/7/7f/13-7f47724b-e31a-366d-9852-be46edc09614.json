  "rdfs:comment": {
    "de": [
      "Andreas Staier experimentiert gerne mit Repertoires auf allen Tasteninstrumenten. Er dirigiert das Orchestre National de Lyon vom Pianoforte aus auf einer nuancenreichen Reise, die uns nach Wien führt."
    ],
    "en": [
      "Andreas Staier likes to experiment with repertoires on all keyboards. He leads the Orchestre National de Lyon from the fortepiano on a nuanced journey to Vienna."
    ],
    "it": [
      "Andreas Staier ama sperimentare repertori su tutte le tastiere. Conduce l'Orchestre National de Lyon dal fortepiano in un viaggio ricco di sfumature verso Vienna."
    ],
    "fr": [
      "Andreas Staier aime expérimenter les répertoires sur tous les claviers. Il dirige l’Orchestre national de Lyon du piano-forte pour un voyage tout en nuances qui nous mène à Vienne."
    ],
    "nl": [
      "Andreas Staier experimenteert graag met repertoires op alle keyboards. Hij leidt het Orchestre National de Lyon vanaf de fortepiano op een genuanceerde reis naar Wenen."
    ],
    "es": [
      "A Andreas Staier le gusta experimentar con repertorios en todos los teclados. Dirige a la Orquesta Nacional de Lyon desde el fortepiano en un matizado viaje a Viena."
    ]
  },
