  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/e53b5b30-c305-3b06-818f-555085a8febe",
      "dc:description": {
        "de": [
          "Informationen :\n\nProdukte: Brote, Backwaren und Kuchen\n\nTage der Öffnung:\n\nTäglich von 7 Uhr bis 19:30 Uhr\nMittwochs von 7:00 bis 13:30 Uhr\n \n Abholung :\n\nZum Mitnehmen während der Ladenöffnungszeiten\n\nBestellungen:\n\nMöglichkeit, nur telefonisch unter 03 21 59 95 63 zu bestellen\n\n "
        ],
        "en": [
          "Information :\n\nProducts: breads, pastries and cakes\n\nOpening days:\n\nDaily from 7am to 7:30pm\nWednesdays from 7am to 1:30pm\n \n Pick-up :\n\nTakeaway during store opening hours\n\nOrdering :\n\nOrders can only be placed by telephone on 03 21 59 95 63\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nProdotti: pane, pasticceria e dolci\n\nGiorni di apertura:\n\nTutti i giorni dalle 7.00 alle 19.30\nMercoledì dalle 7.00 alle 13.30\n \n Raccolta :\n\nDa asporto durante gli orari di apertura del negozio\n\nOrdini :\n\nLe ordinazioni possono essere effettuate solo per telefono al numero 03 21 59 95 63\n\n "
        ],
        "fr": [
          "Informations :\n\nProduits : pains, vienoisseries et gâteaux\n\nJours d'ouverture:\n\nTous les jours de 7h à 19h30\nLe mercredi de 7h à 13h30\n \n Retrait :\n\nÀ emporter aux horaires d'ouverture du magasin\n\nCommandes :\n\nPossibilité de commander uniquement par téléphone au 03 21 59 95 63\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nProducten: brood, gebak en taarten\n\nOpeningsdagen:\n\nElke dag van 7.00 tot 19.30 uur\nWoensdag van 7.00 tot 13.30 uur\n \n Ophalen :\n\nAfhalen tijdens openingstijden winkel\n\nBestellen :\n\nBestellingen kunnen alleen telefonisch worden geplaatst op 03 21 59 95 63\n\n "
        ],
        "es": [
          "Más información :\n\nProductos: pan, bollería y pastelería\n\nDías de apertura:\n\nTodos los días de 7h a 19h30\nMiércoles de 7h a 13h30\n \n Recogida :\n\nPara llevar durante el horario de apertura de la tienda\n\nPedidos :\n\nSólo se pueden hacer pedidos por teléfono llamando al 03 21 59 95 63\n\n "
        ]
      },
