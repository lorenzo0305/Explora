  "rdfs:comment": {
    "de": [
      "Pub & Burgers\r\nMittwoch bis Montag von 12H bis Mitternacht geöffnet\r\nSamstags von 09H bis 00H geöffnet\r\nDurchgehende Bewirtung von 12H bis 22H\r\nEntspannte Atmosphäre, Pub, Softs, 8 Zapfanlagen, große Auswahl an Burgern, Snacks und Salat vor Ort oder zum Mitnehmen"
    ],
    "en": [
      "Pub & Burgers\r\nOpen from 12H to Midnight from Wednesday to Monday\r\nOpen Saturday 09H to 00H\r\nContinuous catering from 12H to 22H\r\nCasual atmosphere, pub, softs, 8 draughts, wide choice of burgers, snacks and salads to eat in or take away"
    ],
    "it": [
      "Pub e hamburger\r\nAperto dalle 12.00 alle 24.00 da mercoledì a lunedì\r\nAperto il sabato dalle 09H alle 00H\r\nRistorazione tutto il giorno dalle 12.00 alle 22.00\r\nAtmosfera rilassata, pub, poltrone, 8 birre alla spina, ampia scelta di hamburger, snack e insalate da consumare all'interno o da asporto"
    ],
    "fr": [
      "Pub & Burgers\r\nOuvert de 12H à Minuit du mercredi au lundi\r\nOuvert le samedi de 09H à 00H\r\nRestauration continue de 12H à 22H\r\nAmbiance décontractée, pub, softs, 8 tirages pressions, large choix de burgers, snacks et salade sur place ou à emporter"
    ],
    "es": [
      "Pub y Hamburguesas\r\nAbierto de 12H a 24H de miércoles a lunes\r\nAbierto el sábado de 09H a 00H\r\nCena todo el día de 12h a 22h\r\nAmbiente relajado, pub, sofás, 8 cervezas de barril, amplia selección de hamburguesas, bocadillos y ensaladas para comer en el local o para llevar"
    ],
    "nl": [
      "Pub & Burgers\r\nOpen van 12 uur tot middernacht van woensdag tot maandag\r\nOpen op zaterdag van 09H tot 00H\r\nDe hele dag door eten van 12 tot 22 uur\r\nOngedwongen sfeer, pub, sofa's, 8 tapbieren, ruime keuze aan burgers, snacks en salades om te eten of mee te nemen"
    ]
  },
