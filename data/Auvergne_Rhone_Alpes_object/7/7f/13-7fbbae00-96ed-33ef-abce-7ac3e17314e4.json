  "rdfs:comment": {
    "de": [
      "Pizzeria und traditionelles Essen (Frösche, Sauerkraut, Paella, Couscous, etc...) vor Ort und zum Mitnehmen. Bar, Tabakwaren, Brasserie. Pmu\r\nJeden Freitagmittag eine Spezialität"
    ],
    "en": [
      "Pizzeria and traditional catering (frogs, sauerkraut, paella, couscous, etc.) on site and to take away. Bar, tobacco shop, brasserie. Pmu\r\nEvery Friday lunchtime a speciality"
    ],
    "it": [
      "Pizzeria e ristorante tradizionale (rane, crauti, paella, couscous, ecc.) in loco e da asporto. Bar, tabaccheria, brasserie. Pmu\r\nOgni venerdì a pranzo una specialità"
    ],
    "fr": [
      "Pizzeria et restauration traditionnelle (grenouilles, choucroute, paella, couscous, etc...)  sur place et à emporter. Bar, tabac, brasserie. Pmu\r\nTous les vendredi midi une spécialitée"
    ],
    "nl": [
      "Pizzeria en traditioneel restaurant (kikkers, zuurkool, paella, couscous, enz.) ter plaatse en om mee te nemen. Bar, tabakswinkel, brasserie. Pmu\r\nElke vrijdagmiddag een specialiteit"
    ],
    "es": [
      "Pizzería y restaurante tradicional (ranas, chucrut, paella, cuscús, etc.) en el mismo local y para llevar. Bar, estanco, brasserie. Pmu\r\nTodos los viernes al mediodía una especialidad"
    ]
