  "rdfs:comment": {
    "de": [
      "1 Stunde, 1 Welt, 1 Team - erleben Sie den Nervenkitzel! Betreten Sie Orte mit Filmkulissen und versuchen Sie, die Folgen von Rätseln und Manipulationen zu lösen, damit die Geschichten ein gutes Ende nehmen."
    ],
    "en": [
      "1 hour, 1 world, 1 team, experience the thrill! Enter cinematic locations and try to solve a series of enigmas and manipulations to ensure a happy ending."
    ],
    "it": [
      "1 ora, 1 mondo, 1 squadra, vivi il brivido! Entrate in luoghi con set cinematografici e cercate di risolvere una serie di enigmi e manipolazioni per garantire il lieto fine della storia."
    ],
    "fr": [
      "1 heure, 1 univers, 1 équipe, vivez le frisson ! Entrez dans des lieux aux décors de cinéma et tentez de résoudre les suites d’énigmes et de manipulations afin que les histoires se terminent bien."
    ],
    "nl": [
      "1 uur, 1 wereld, 1 team, ervaar de spanning! Betreed een bioscoopomgeving en probeer een reeks raadsels en trucs op te lossen om het verhaal tot een goed einde te brengen."
    ],
    "es": [
      "1 hora, 1 mundo, 1 equipo, ¡viva la emoción! Entra en localizaciones con decorados de cine e intenta resolver una serie de enigmas y manipulaciones para que la historia tenga un final feliz."
    ]
  },
