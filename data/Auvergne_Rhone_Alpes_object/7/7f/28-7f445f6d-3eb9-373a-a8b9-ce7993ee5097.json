  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/2b1848ff-3a2b-3f7d-8f9e-3c7d9d10850f",
      "dc:description": {
        "de": [
          "\"Das Restaurant Le Bonavis in Valenciennes. Der gute Geschmack von ausgewähltem Fleisch, das im Kaminfeuer gebräunt wird.\n\nDer gute Geschmack einer authentischen und raffinierten Küche, am Eingang von Valenciennes, gegenüber dem Gaumont-Kino.\"  -  Le Bonavis"
        ],
        "en": [
          "\"Restaurant Le Bonavis in Valenciennes. The good taste of selected meat, browned over an open fire.\n\nThe good taste of authentic, refined cuisine, at the entrance to Valenciennes, opposite the Gaumont cinema. \"  -  Le Bonavis"
        ],
        "it": [
          "\"Ristorante Le Bonavis\" a Valenciennes. Il buon gusto di carni selezionate rosolate a fuoco aperto.\n\nIl buon gusto di una cucina autentica e raffinata, all'ingresso di Valenciennes, di fronte al cinema Gaumont\"  -  Le Bonavis"
        ],
        "fr": [
          "« Le Restaurant Le Bonavis à Valenciennes. Le bon goût d’une viande sélectionnée et dorée au feu de cheminée. \n\nLe bon goût d’une cuisine authentique et raffinée, à l’entrée de Valenciennes, face au cinéma Gaumont. »  -  Le Bonavis"
        ],
        "es": [
          "\"Restaurante Le Bonavis\" en Valenciennes. El buen sabor de la carne seleccionada y dorada al fuego.\n\nEl buen gusto de una cocina auténtica y refinada, a la entrada de Valenciennes, frente al cine Gaumont\"  -  Le Bonavis"
        ],
        "nl": [
          "\"Restaurant Le Bonavis in Valenciennes. De goede smaak van geselecteerd vlees dat boven een open vuur is gebraden.\n\nDe goede smaak van een authentieke, verfijnde keuken, bij de ingang van Valenciennes, tegenover de Gaumont bioscoop\"  -  Le Bonavis"
        ]
      },
      "@type": [
        "Description"
      ],
