  "rdfs:comment": {
    "de": [
      "Die Domaine de la Ricottière stellt Ihnen ihren Weinkeller für Familienfeiern oder Firmenseminare zur Verfügung. Möglichkeit eines Mâchon mit Verkostung\r\n(bis zu 30 Personen)"
    ],
    "en": [
      "The Domaine de la Ricottière puts its cellar at your disposal for your family reunions or company seminars. Possibility of mâchon with tasting\r\n(up to 30 people)"
    ],
    "it": [
      "Il Domaine de la Ricottière mette a disposizione la sua cantina per le vostre riunioni di famiglia o seminari aziendali. Possibilità di mâchon con degustazione\r\n(fino a 30 persone)"
    ],
    "fr": [
      "Le Domaine de la Ricottière met sa cave à votre disposition pour vos réunions de famille ou séminaires d'entreprise. Possibilité de mâchon avec dégustation \r\n(jusqu'à 30 personnes)"
    ],
    "nl": [
      "Het Domaine de la Ricottière stelt zijn kelder ter beschikking voor uw familiereünies of bedrijfsseminaries. Mogelijkheid van mâchon met proeverij\r\n(tot 30 personen)"
    ],
    "es": [
      "El Domaine de la Ricottière pone su bodega a su disposición para sus reuniones familiares o seminarios de empresa. Posibilidad de mâchon con degustación\r\n(hasta 30 personas)"
    ]
  },
