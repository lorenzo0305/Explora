  "rdfs:comment": {
    "de": [
      "Die Kunsthandwerkerin hat eine Schmuckkollektion (Phytijou) entwickelt, die von einem mittelalterlichen Schmuckstück, dem « Pomme d’Ambre » inspiriert ist. Eine zeitgemäße Version eines Schmuckstücks, das früher zur Verlobung verschenkt wurde."
    ],
    "en": [
      "Artisan creator of a jewelry line (Phytijou) inspired by the Pommandé \"Amber Apple\": jewelry used in medieval times. A revisited Holy Spirit jewel (once offered for engagements)."
    ],
    "it": [
      "Artigiano creatore di una linea di gioielli (Phytijou) ispirata al Pommandé \"Pomme d'ambre\": gioiello utilizzato in epoca medievale. Gioiello dello Spirito Santo rivisitato (precedentemente offerto per il fidanzamento)."
    ],
    "fr": [
      "Artisan créateur d’une ligne de bijoux (Phytijou) inspirée du Pommandé « Pomme d’ambre » : bijou utilisé dans les temps médiévaux. Bijou du Saint-Esprit revisité (autrefois offert pour les fiançailles)."
    ],
    "es": [
      "Artesano creador de una línea de joyas (Phytijou) inspirada en la Pommandé \" Pomme d'ambre \" : joya utilizada en la época medieval. Joya revisitada del Espíritu Santo (anteriormente ofrecida por compromiso)."
    ],
    "nl": [
      "Ambachtelijke maker van een sieradenlijn (Phytijou) geïnspireerd op de Pommandé \"Appel van Amber\": juweel gebruikt in de middeleeuwen. Revisited Holy Spirit juweel (voorheen aangeboden voor verloven)."
    ]
  },
  "rdfs:label": {
