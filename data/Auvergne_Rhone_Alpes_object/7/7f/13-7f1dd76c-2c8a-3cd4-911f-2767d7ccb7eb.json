  "rdfs:comment": {
    "de": [
      "L'Anguille liegt im Herzen des Bifurk und ist ein gemeinnütziger Ort, an dem zeitgenössische Kunst geschaffen und ausgestellt wird. Es ist ein Tor zur lebendigen Kultur, das sich allen öffnet, die eine Lust auf Entdeckung umarmen."
    ],
    "en": [
      "Located in the heart of the Bifurk district, l'Anguille is a not-for-profit venue for the creation and exhibition of contemporary art. It's a gateway to living culture open to all those who embrace a desire for discovery."
    ],
    "it": [
      "Scoprite l'Anguille a La Bifurk, una sala espositiva di Grenoble che offre intrattenimento culturale, mostre e diverse attività sportive. Ingresso gratuito!"
    ],
    "fr": [
      "Découvrez l'Anguille à La Bifurk, une salle d'exposition à Grenoble offrant des loisirs culturels, des expositions et des activités sportives variées. Entrée gratuite !"
    ],
    "es": [
      "Situado en el corazón del Bifurk, l'Anguille es un lugar de creación y exposición de arte contemporáneo sin ánimo de lucro. Es una puerta a la cultura viva, abierta a todos los que abrazan el deseo de descubrir."
    ],
    "nl": [
      "Ontdek l'Anguille in La Bifurk, een expositiehal in Grenoble met cultureel vermaak, tentoonstellingen en verschillende sportactiviteiten. Gratis toegang!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "l’Anguille - salle d'exposition de La Bifurk"
    ]
  },
