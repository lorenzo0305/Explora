  "rdfs:comment": {
    "de": [
      "Dieser 7 Hektar große Weinberg liegt zwischen der Enclave des Papes und Rasteau, zwischen Rhône und Ventoux. Er profitiert von einem Mikroklima, in dem die angebauten Rebsorten für eine einzigartige Besonderheit sorgen."
    ],
    "en": [
      "The Domaine des Césars is located in the heart of the Southern Rhône Valley, in Tulette, near Avignon, capital of the Côtes du Rhône region."
    ],
    "it": [
      "Questo vigneto di 7 ettari si trova tra l'Enclave des Papes e Rasteau, tra il Rodano e il Ventoux, e beneficia di un microclima in cui i vitigni coltivati conferiscono una specificità unica."
    ],
    "fr": [
      "Ce vignoble de 7 hectares est situé entre l’Enclave des Papes et Rasteau, entre Rhône et Ventoux, bénéficie d’un micro climat où les cépages cultivés donnent une spécificité unique."
    ],
    "nl": [
      "Het Domaine des Césars bevindt zich in het hart van het zuidelijke Rhônedal, in Tulette, in de buurt van Avignon, de hoofdstad van de Côtes du Rhône."
    ],
    "es": [
      "Este viñedo de 7 hectáreas está situado entre el Enclave des Papes y Rasteau, entre el Ródano y el Ventoux, y se beneficia de un microclima en el que las variedades de uva cultivadas dan una especificidad única."
    ]
  },
  "rdfs:label": {
