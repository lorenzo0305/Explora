  "rdfs:comment": {
    "de": [
      "La Table de Déodat ist der Gourmet-Tisch der Domaine de Dolomieu. Eine raffinierte und lebendige französische Küche, die von der Natur inspiriert und von der Saisonalität getragen wird und die lokalen Erzeuger in den Vordergrund stellt. Ein elegantes und geselliges Erlebnis."
    ],
    "en": [
      "A gastronomic restaurant with a luxury dinning hall. A beautiful place for a romantic dinner."
    ],
    "it": [
      "La Table de Déodat è il ristorante gourmet del Domaine de Dolomieu. Cucina francese raffinata e vivace, ispirata alla natura e alla stagionalità, con particolare attenzione ai produttori locali. Un'esperienza elegante e conviviale."
    ],
    "fr": [
      "La Table de Déodat est la table gastronomique du Domaine de Dolomieu. Une cuisine française raffinée et vivante, inspirée par la nature et portée par la saisonnalité, qui met à l’honneur les producteurs locaux. Une expérience élégante et conviviale."
    ],
    "nl": [
      "La Table de Déodat is het gastronomische restaurant van Domaine de Dolomieu. Verfijnde, levendige Franse gerechten geïnspireerd door de natuur en seizoensgebondenheid, met een focus op lokale producenten. Een elegante en gezellige ervaring."
    ],
    "es": [
      "La Table de Déodat es el restaurante gastronómico del Domaine de Dolomieu. Cocina francesa refinada y viva, inspirada en la naturaleza y la estacionalidad, con especial atención a los productores locales. Una experiencia elegante y acogedora."
    ]
  },
  "rdfs:label": {
    "en": [
