  "rdfs:comment": {
    "de": [
      "2,5 km langer Gedenkweg ab dem Rathaus von Montagne mit drei Tafeln, die das Leben von Willi Münzenberg, einer deutschen Anti-Nazi-Figur der Zwischenkriegszeit, seinen Tod im Jahr 1940 und die Geschichte seines Grabes erzählen."
    ],
    "en": [
      "A 2.5 km memorial trail starting from Montagne town hall, with three panels tracing the life of Willi Münzenberg, a German anti-Nazi figure of the interwar period, his death in 1940 and the history of his grave."
    ],
    "it": [
      "Un percorso commemorativo di 2,5 km che parte dal municipio di Montagne, con tre pannelli che ripercorrono la vita di Willi Münzenberg, figura tedesca antinazista del periodo tra le due guerre, la sua morte nel 1940 e la storia della sua tomba."
    ],
    "fr": [
      "Parcours mémoriel de 2,5 km au départ de la mairie de Montagne, ponctué de trois panneaux retraçant la vie de Willi Münzenberg, figure allemande antinazie de l’entre-deux-guerres, sa mort en 1940 et l’histoire de sa tombe."
    ],
    "es": [
      "Recorrido conmemorativo de 2,5 km que parte del ayuntamiento de Montagne, con tres paneles que recorren la vida de Willi Münzenberg, figura alemana antinazi del periodo de entreguerras, su muerte en 1940 y la historia de su tumba."
    ],
    "nl": [
      "Een gedenkpad van 2,5 km dat begint bij het gemeentehuis van Montagne, met drie panelen over het leven van Willi Münzenberg, een Duitse anti-nazi-figuur uit het interbellum, zijn dood in 1940 en de geschiedenis van zijn graf."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parcours mémoriel Willi Münzenberg"
    ]
  },
