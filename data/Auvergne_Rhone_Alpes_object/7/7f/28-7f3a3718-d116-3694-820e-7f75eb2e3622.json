  "rdfs:comment": {
    "de": [
      "Restaurant in Mers-les-Bains gelegen.\nParkplatz des Einkaufszentrums von Auchan. Map'Monde Café ist das 1. Lokal in den Einkaufsgalerien.\nBar - Brasserie - Pizzeria. Tagesgericht, Express-Menü, Verkauf zum Mitnehmen. 70 Gedecke, 20 auf der Terrasse. WIFI.\nSonntags geschlossen.\nEmpfang von Gruppen. Zugänglichkeit für Rollstuhlfahrer\nPartnereinrichtung des Office de Tourisme."
    ],
    "en": [
      "Restaurant located in Mers-les-Bains.\nParking of the shopping center of Auchan. Map'Monde Café is the 1st establishment of the shopping galleries.\nBar - Brasserie - Pizzeria. Dish of the day, express menu, takeaway. 70 covers, 20 on the terrace. WIFI.\nClosed on Sundays.\nReception of groups. Wheelchair access\nPartner establishment of the Tourist Office."
    ],
    "it": [
      "Ristorante situato a Mers-les-Bains.\nParcheggio del centro commerciale Auchan. Il Map'Monde Café è il primo locale dei centri commerciali.\nBar - Brasserie - Pizzeria. Specialità del giorno, menù espresso, da asporto. 70 coperti, 20 in terrazza. WIFI.\nChiuso la domenica.\nI gruppi sono benvenuti. Accesso con sedia a rotelle\nIstituzione partner dell'Ufficio del Turismo."
    ],
    "fr": [
      "Restaurant situé à Mers-les-Bains.\nParking du centre commercial d'Auchan. Map'Monde Café est le 1er établissement des galeries marchandes.\nBar - Brasserie - Pizzeria. Plat du jour, menu express, vente à emporter. 70 couverts, 20 en terrasse. WIFI.\nFermé le dimanche.\nAccueil de groupes. Accessibilité fauteuil roulant\nEtablissement partenaire de l'Office de Tourisme."
    ],
    "es": [
      "Restaurante situado en Mers-les-Bains.\nAparcamiento del centro comercial Auchan. Map'Monde Café es el primer establecimiento de los centros comerciales.\nBar - Brasserie - Pizzería. Ofertas del día, menú exprés, comida para llevar. 70 cubiertos, 20 en la terraza. WIFI.\nCerrado los domingos.\nLos grupos son bienvenidos. Acceso en silla de ruedas\nEstablecimiento de la Oficina de Turismo."
    ],
    "nl": [
      "Restaurant gelegen in Mers-les-Bains.\nParkeerplaats van het Auchan winkelcentrum. Map'Monde Café is de eerste vestiging in de winkelcentra.\nBar - Brasserie - Pizzeria. Dagschotel, snelmenu, afhaalmaaltijden. 70 couverts, 20 op het terras. WIFI.\nGesloten op zondag.\nGroepen zijn welkom. Toegang voor rolstoelen\nPartner oprichting van de VVV."
    ]
  },
