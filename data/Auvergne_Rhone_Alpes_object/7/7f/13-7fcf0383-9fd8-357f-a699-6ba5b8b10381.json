  "rdfs:comment": {
    "de": [
      "Das Bar Restaurant \"la Grange\" empfängt Sie in seinem bergischen Rahmen mit dem Charme vergangener Zeiten, seiner Kaminecke und seiner sonnigen Südterrasse. Traditionelle Küche nach alter Art mit Gerichten und Menüs aus Savoyen."
    ],
    "en": [
      "The Bar Restaurant \"la Grange\" welcomes you in its mountain setting with the charm of yesteryear, its chimney corner, its sunny terrace south facing. Traditional cuisine in the old style, with its Savoyards dishes and menus."
    ],
    "it": [
      "Il Bar-Ristorante \"La Grange\" vi accoglie nel suo ambiente montano con il suo fascino antico, il suo camino e la sua terrazza soleggiata esposta a sud. Cucina tradizionale, con piatti e menu savoiardi."
    ],
    "fr": [
      "Le Bar Restaurant « la Grange » vous accueille dans son cadre montagnard au charme d’autrefois, son coin cheminée, sa terrasse ensoleillée exposée plein sud. Cuisine de tradition à l’ancienne, avec ses plats et menus Savoyards."
    ],
    "es": [
      "El Bar-Restaurante \"La Grange\" le da la bienvenida en su entorno de montaña con su encanto de antaño, su chimenea y su soleada terraza orientada al sur. Cocina tradicional, con platos y menús saboyanos."
    ],
    "nl": [
      "Bar Restaurant “la Grange” verwelkomt u in zijn charmant kader van de montagnards van weleer, gezellig bij de open haard, op zijn zonnig terras dat volop op het zuiden gericht is. Traditionele keuken met schotels en menu’s van de Savoye."
    ]
  },
