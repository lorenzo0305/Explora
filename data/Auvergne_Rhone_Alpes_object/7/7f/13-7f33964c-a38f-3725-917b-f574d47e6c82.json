  "rdfs:comment": {
    "de": [
      "\"360\" ist ein passender Name für den Panoramablick, den das Restaurant auf dem Plateau du Fornelet in Plagne-Montalbert genießt!"
    ],
    "en": [
      "\"360\" gets its name, obviously enough, because of the panoramic view restaurant enjoys, on the Fornelet  plateau at Plagne-Montalbert!"
    ],
    "it": [
      "360? è un nome appropriato per la vista panoramica che si gode dal ristorante sull'altopiano del Fornelet a Plagne-Montalbert!"
    ],
    "fr": [
      "“360” est un nom tout trouvé avec la vue panoramique dont bénéficie le restaurant, sur le plateau du Fornelet à Plagne-Montalbert !"
    ],
    "nl": [
      "\"360\" is een passende naam, gezien het panoramische uitzicht vanuit het restaurant op het plateau van Fornelet in Plagne-Montalbert!"
    ],
    "es": [
