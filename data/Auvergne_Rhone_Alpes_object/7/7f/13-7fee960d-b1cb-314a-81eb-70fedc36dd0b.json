  "rdfs:comment": {
    "de": [
      "Das Lehrerteam der ESF Nordic in La Clusaz heißt Sie herzlich in den Aravis willkommen und hofft, Sie bald auf den Pisten des Espace Nordique des Confins begrüßen zu dürfen!"
    ],
    "en": [
      "The team of instructors of the ESF Nordique de La Clusaz welcomes you to the Aravis and hopes to see you soon on the slopes of the Espace Nordique des Confins!"
    ],
    "it": [
      "Il team di istruttori dell'ESF Nordique de La Clusaz vi dà il benvenuto negli Aravis e spera di vedervi presto sulle piste dell'Espace Nordique des Confins!"
    ],
    "fr": [
      "L'équipe de moniteurs de L'ESF Nordique de La Clusaz, vous souhaite la bienvenue dans les Aravis et espère vous retrouver très vite sur les pistes de l'Espace Nordique des Confins!"
    ],
    "nl": [
      "Het team van instructeurs van de ESF Nordique de La Clusaz heet u welkom in de Aravis en hoopt u binnenkort te zien op de hellingen van het Espace Nordique des Confins!"
    ],
    "es": [
      "El equipo de monitores de la ESF Nordique de La Clusaz le da la bienvenida a Aravis y espera verle pronto en las pistas del Espace Nordique des Confins"
    ]
  },
