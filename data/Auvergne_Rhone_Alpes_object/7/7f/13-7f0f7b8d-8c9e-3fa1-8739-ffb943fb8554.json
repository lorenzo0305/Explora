  "rdfs:comment": {
    "de": [
      "Mit einer Mischung aus Zirkus, Mapping und Live-Musik erforscht das Ensemble Solfasirc die Verbindung zwischen den physikalischen Gesetzen und der künstlerischen Vorstellungskraft."
    ],
    "en": [
      "Combining circus, mapping and live music, the Solfasirc company explores the link between physical laws and the artistic imagination."
    ],
    "it": [
      "Combinando circo, mapping e musica dal vivo, la compagnia Solfasirc esplora il legame tra le leggi fisiche e l'immaginazione artistica."
    ],
    "fr": [
      "Mêlant cirque, mapping et musique live, la compagnie Solfasirc explore l’articulation entre les lois physiques et l’imaginaire artistique."
    ],
    "nl": [
      "Door circus, cartografie en live muziek te combineren, verkent het gezelschap Solfasirc het verband tussen natuurkundige wetten en de artistieke verbeelding."
    ],
    "es": [
      "Combinando circo, mapping y música en directo, la compañía Solfasirc explora el vínculo entre las leyes físicas y la imaginación artística."
    ]
  },
