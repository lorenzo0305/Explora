  "rdfs:comment": {
    "de": [
      "Restaurant, in der Nähe des Loire-Ufers, in einem schönen, gemütlichen Rahmen mit Terrasse. Hier können Sie ein gutes Essen wie zu Hause genießen..."
    ],
    "en": [
      "Restaurant, close to the banks of the Loire, in a beautiful warm setting with terrace. You can enjoy a good meal as at home..."
    ],
    "it": [
      "Ristorante a due passi dalle rive della Loira, in un ambiente bello e accogliente con terrazza. Potrete gustare un buon pasto come a casa vostra..."
    ],
    "fr": [
      "Restaurant, à deux pas des bords de Loire, dans un beau cadre chaleureux avec terrasse . Vous pouvez déguster une bon repas comme à la maison..."
    ],
    "es": [
      "Restaurante, a dos pasos de las orillas del Loira, en un marco bello y acogedor con terraza. Podrá disfrutar de una buena comida como en casa..."
    ],
    "nl": [
      "Restaurant, op een steenworp afstand van de oevers van de Loire, in een mooie, gastvrije omgeving met terras. U kunt hier net als thuis genieten van een goede maaltijd..."
    ]
  },
