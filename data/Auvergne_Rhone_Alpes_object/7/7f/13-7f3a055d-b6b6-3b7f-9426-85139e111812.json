  "rdfs:comment": {
    "de": [
      "Treten Sie durch das Tor einer beeindruckenden Festung und entdecken Sie den Ehrenhof aus der Renaissance und seine raffinierten Dekorationen. Entdecken Sie spielerisch seinen weitläufigen, bewaldeten Park und seine Appartements."
    ],
    "en": [
      "Step through the gates of this impressive fortress and discover its Renaissance main courtyard and refined decor. Discover its vast wooded park and apartments."
    ],
    "it": [
      "Varcate i cancelli di questa imponente fortezza e scoprite il suo cortile principale rinascimentale e l'arredamento raffinato. Scoprite in modo giocoso il suo vasto parco alberato e gli appartamenti."
    ],
    "fr": [
      "Passez la porte d’une impressionnante forteresse et découvrez sa cour d’honneur Renaissance et ses décors raffinés. Découverte ludique de son vaste parc boisé et de ses appartements."
    ],
    "nl": [
      "Stap door de poorten van dit indrukwekkende fort en ontdek de renaissance binnenplaats en het verfijnde decor. Geniet van een speelse ontdekkingstocht door het uitgestrekte beboste park en de flats."
    ],
    "es": [
      "Atraviese las puertas de esta impresionante fortaleza y descubra su patio principal renacentista y su refinada decoración. Disfrute de un descubrimiento lúdico de su vasto parque arbolado y sus pisos."
    ]
  },
