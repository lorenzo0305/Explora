  "rdfs:comment": {
    "de": [
      "Sie ist Johannes dem Täufer gewidmet und wurde 1868 erbaut, als sie die alte Kirche von Le Crêt ersetzte.\r\nSie wurde 1927 und 1981 renoviert."
    ],
    "en": [
      "Dedicated to Saint Jean Baptiste and erected in 1868, it replaced the old Crêt Church.\r\nIt was renovated in 1927 and in1981."
    ],
    "it": [
      "Dedicata a San Giovanni Battista e costruita nel 1868, sostituì l'antica chiesa di Le Crêt.\r\nÈ stato ristrutturato nel 1927 e nel 1981."
    ],
    "fr": [
      "Dédiée à Saint Jean Baptiste et construite en 1868, elle a remplacé l'ancienne Église du Crêt.\r\nElle fut rénovée en 1927 et 1981."
    ],
    "nl": [
      "Gewijd aan Johannes de Doper en gebouwd in 1868, verving het de voormalige kerk van Le Crêt.\r\nHet werd gerenoveerd in 1927 en 1981."
    ],
    "es": [
      "Dedicada a San Juan Bautista y construida en 1868, sustituyó a la antigua iglesia de Le Crêt.\r\nFue renovado en 1927 y 1981."
    ]
  },
