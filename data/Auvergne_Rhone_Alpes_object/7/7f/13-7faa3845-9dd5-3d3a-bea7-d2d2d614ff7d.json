  "rdfs:comment": {
    "de": [
      "Galerie für zeitgenössische Kunst. Die Galerie Art du Temps präsentiert rund fünfzig renommierte internationale Maler und Bildhauer. Das ganze Jahr über werden Ausstellungen in sehr unterschiedlichen Stilen organisiert."
    ],
    "en": [
      "Contemporary art gallery. The Art du Temps gallery presents some fifty painters, sculptors and photographers from all over the world and of international renown. Exhibitions are organized all year round."
    ],
    "it": [
      "Galleria d'arte contemporanea. La galleria Art du Temps presenta una cinquantina di pittori e scultori di fama internazionale. Durante tutto l'anno vengono organizzate mostre in un'ampia varietà di stili."
    ],
    "fr": [
      "Galerie d'art contemporain. La galerie Art du Temps présente une cinquantaine d'artistes peintres et sculpteurs internationaux de renommée. Des expositions das des styles très différents sont organisées toute l'année."
    ],
    "nl": [
      "Galerie voor hedendaagse kunst. In de galerie Art du Temps werken zo'n vijftig internationaal bekende schilders en beeldhouwers. Het hele jaar door worden er tentoonstellingen georganiseerd in de meest uiteenlopende stijlen."
    ],
    "es": [
      "Galería de arte contemporáneo. La galería Art du Temps presenta a una cincuentena de pintores y escultores de renombre internacional. A lo largo del año se celebran exposiciones de muy diversos estilos."
    ]
  },
  "rdfs:label": {
