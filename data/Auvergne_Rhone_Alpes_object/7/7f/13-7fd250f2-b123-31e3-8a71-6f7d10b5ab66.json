  "rdfs:comment": {
    "de": [
      "Im Herzen des Parc des Sources und des Stadtzentrums von Vichy befindet sich das Casino du Grand Café: Spielautomaten, elektronisches englisches Roulette und Black Jack sowie traditionelle Spiele mit einem Tisch für englisches Roulette und zwei Black Jack-Tischen."
    ],
    "en": [
      "In the heart of Vichy's Parc des Sources and city center, discover the Casino du Grand Café: slot machines, English roulette and electronic black jack as well as traditional games with an English roulette table and two black jack tables."
    ],
    "it": [
      "Nel cuore del Parc des Sources e del centro di Vichy, scoprite il Casino du Grand Café: slot machine, roulette inglese e black jack elettronico, oltre ai giochi tradizionali con un tavolo di roulette inglese e due tavoli di black jack."
    ],
    "fr": [
      "Au cœur du parc des sources et du centre-ville de Vichy, découvrez le Casino du Grand Café : machines à sous, roulette anglaise et black jack électroniques ainsi que les jeux traditionnels avec une table de roulette anglaise et deux tables de black jack."
    ],
    "nl": [
      "Ontdek in het hart van het Parc des Sources en het stadscentrum van Vichy het Casino du Grand Café: speelautomaten, Engels roulette en elektronisch black jack, maar ook traditionele spellen met een Engelse roulettetafel en twee black jack-tafels."
    ],
    "es": [
      "En el corazón del Parc des Sources y del centro de Vichy, descubra el Casino du Grand Café: máquinas tragaperras, ruleta inglesa y black jack electrónico, así como juegos tradicionales con una mesa de ruleta inglesa y dos mesas de black jack."
    ]
  },
