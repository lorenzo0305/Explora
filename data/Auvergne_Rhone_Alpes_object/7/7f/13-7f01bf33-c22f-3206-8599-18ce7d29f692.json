  "rdfs:comment": {
    "de": [
      "Laser & Beers verfügt über einen 600 m² großen Spielbereich und einen Bereich, der auch der Bierbar gewidmet ist, und verbindet so alle Freuden, insbesondere die, sich mit Freunden oder der Familie zu treffen, um eine angenehme Zeit zu verbringen. In der Woche wird mittags ein Tagesgericht angeboten."
    ],
    "en": [
      "With a 600 m² play area and a dedicated beer bar, Laser & Beers combines all kinds of pleasures, not least those of getting together with friends and family for a good time. Daily specials at lunchtime on weekdays."
    ],
    "it": [
      "Con un'area giochi di 600 m² e una birreria, Laser & Beers è un luogo ideale per incontrarsi con gli amici o la famiglia e divertirsi. Piatto del giorno disponibile a pranzo nei giorni feriali."
    ],
    "fr": [
      "Doté d’un espace de jeu sur 600 m² avec un espace dédié aussi au bar à bières, Laser & Beers mêle ainsi tous les plaisirs et notamment ceux de se retrouver entre amis ou en famille pour passer un agréable moment. Plat du jour proposé le midi en semaine."
    ],
    "nl": [
      "Met een speelruimte van 600 m² en een bierbar is Laser & Beers een geweldige plek om af te spreken met vrienden of familie en te genieten van een leuke tijd. Dagschotel beschikbaar voor de lunch op weekdagen."
    ],
    "es": [
      "Con una zona de juegos de 600 m² y un bar de cerveza, Laser & Beers es un lugar ideal para reunirse con amigos o familiares y pasar un buen rato. Plato del día disponible para comer entre semana."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Laser & Beers - Laser game"
    ]
  },
