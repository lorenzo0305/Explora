  "rdfs:comment": {
    "de": [
      "Wir stellen handwerklich hergestellte Liköre aus Früchten, Beeren und Pflanzen der Haute-Loire sowie einen lokalen Pastis her. Unser Ziel ist es, dass Sie ursprüngliche Düfte und Aromen ohne künstliche Hilfsmittel entdecken."
    ],
    "en": [
      "We make artisanal liqueurs from fruit, berries and plants from the Haute-Loire region, as well as a local pastis. Our aim is to introduce you to original, unadulterated flavors and aromas."
    ],
    "it": [
      "Produciamo liquori tradizionali a base di frutta, bacche e piante della regione dell'Alta Loira, oltre a un pastis locale. Il nostro obiettivo è quello di farvi conoscere sapori e aromi originali e non adulterati."
    ],
    "fr": [
      "Nous fabriquons des liqueurs artisanales à base de fruits, de baies et de plantes de Haute-Loire ainsi qu'un pastis local. Notre volonté est de vous faire découvrir des parfums et arômes orignaux, sans artifices."
    ],
    "nl": [
      "Wij maken traditionele likeuren van fruit, bessen en planten uit de Haute-Loire en een lokale pastis. Ons doel is om u kennis te laten maken met originele, onvervalste smaken en aroma's."
    ],
    "es": [
      "Elaboramos licores tradicionales a partir de frutas, bayas y plantas de la región del Alto Loira, así como un pastis local. Nuestro objetivo es presentarle sabores y aromas originales y no adulterados."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Vellavie - Eau de Grenouille"
    ]
  },
