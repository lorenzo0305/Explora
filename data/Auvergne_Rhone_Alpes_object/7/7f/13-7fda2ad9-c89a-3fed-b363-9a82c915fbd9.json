  "rdfs:comment": {
    "de": [
      "Der Verein Les Éleveurs du Vercors verteidigt die lokale Landwirtschaft, wertet sie auf und unterstützt die Züchter der Region durch Veranstaltungen, Schulungen und Initiativen, um die Traditionen zu bewahren und die Qualität der Produkte aus dem Vercors zu fördern."
    ],
    "en": [
      "The association Les Éleveurs du Vercors defends and promotes local agriculture and supports the region's breeders through events, training and initiatives to preserve traditions and promote the quality of Vercors products."
    ],
    "it": [
      "L'associazione Les Éleveurs du Vercors difende e promuove l'agricoltura locale e sostiene gli allevatori della regione attraverso eventi, formazione e iniziative per preservare le tradizioni e promuovere la qualità dei prodotti del Vercors."
    ],
    "fr": [
      "L'association Les Éleveurs du Vercors défend, valorise l'agriculture locale et soutient les éleveurs de la région à travers des événements, des formations et des initiatives pour préserver les traditions et promouvoir la qualité des produits du Vercors."
    ],
    "es": [
      "La asociación Les Éleveurs du Vercors defiende y promueve la agricultura local y apoya a los ganaderos de la región mediante actos, formación e iniciativas para preservar las tradiciones y promover la calidad de los productos del Vercors."
    ],
    "nl": [
      "De vereniging Les Éleveurs du Vercors verdedigt en promoot de lokale landbouw en ondersteunt de veehouders in de regio door middel van evenementen, training en initiatieven om tradities te behouden en de kwaliteit van Vercors-producten te promoten."
    ]
  },
  "rdfs:label": {
