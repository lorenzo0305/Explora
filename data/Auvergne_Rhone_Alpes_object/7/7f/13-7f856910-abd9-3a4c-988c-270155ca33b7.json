  "rdfs:comment": {
    "de": [
      "Inmitten des Golf du Forez, in einer Oase der Ruhe gelegen, bietet Le Birdie eine traditionelle, aber vor allem saisonale Küche."
    ],
    "en": [
      "In a haven of peace right in the middle of the Forez golf course, Le Birdie serves traditional cuisine and, above all, dishes that follow the seasons."
    ],
    "it": [
      "Situato al centro del campo da golf del Forez, in un'oasi di pace, Le Birdie offre una cucina tradizionale ma anche e soprattutto stagionale."
    ],
    "fr": [
      "Situé au milieu du golf du Forez, dans un havre de paix, Le Birdie propose une cuisine traditionnelle mais aussi et surtout de saison."
    ],
