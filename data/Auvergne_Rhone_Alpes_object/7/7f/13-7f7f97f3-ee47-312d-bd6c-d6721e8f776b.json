  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Cosmo im Herzen von Chambéry: Restaurant/Bar/Café, klimatisierter Saal, Sonnenterrasse, behindertengerecht, traditionelle Hausmannskost, die von der ganzen Welt inspiriert ist. Gemütliche Atmosphäre mit ständiger Kunstausstellung.\r\nEmpfängt Gruppen und Seminare."
    ],
    "en": [
      "Discover Cosmo in the heart of Chambéry: Restaurant/Bar/Café, air-conditioned room, sunny terrace, PMR, traditional home cooking inspired by the world. Warm atmosphere with permanent art exhibition.\r\nWelcomes groups and seminars."
    ],
    "it": [
      "Scoprite Cosmo nel cuore di Chambéry: ristorante/bar/caffè, sala climatizzata, terrazza soleggiata, PRM, cucina tradizionale casalinga ispirata al mondo. Atmosfera accogliente con mostra d'arte permanente.\r\nAccoglie gruppi e seminari."
    ],
    "fr": [
      "Découvrez le Cosmo au coeur de Chambéry: Restaurant/Bar/Café, salle climatisée, terrasse ensoleillée, PMR, cuisine maison traditionnelle et inspirée du monde entier. Ambiance chaleureuse avec exposition d'art permanente. \r\nAccueille groupes et séminaires."
    ],
    "nl": [
      "Ontdek Cosmo in het hart van Chambéry: Restaurant/Bar/Café, zaal met airconditioning, zonnig terras, PRM, traditionele thuiskeuken geïnspireerd door de wereld. Warme sfeer met permanente kunsttentoonstelling.\r\nGeschikt voor groepen en seminars."
    ],
    "es": [
      "Descubra Cosmo en el corazón de Chambéry: Restaurante/Bar/Cafetería, sala climatizada, terraza soleada, PMR, cocina casera tradicional inspirada en el mundo. Ambiente cálido con exposición permanente de arte.\r\nAcoge grupos y seminarios."
    ]
  },
  "rdfs:label": {
