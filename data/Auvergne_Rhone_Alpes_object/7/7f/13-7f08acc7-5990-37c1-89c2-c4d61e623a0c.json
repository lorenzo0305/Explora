  "rdfs:comment": {
    "de": [
      "Förderung und Entwicklung von Outdoor-Aktivitäten, urbanen Gleitsportarten, künstlerischen und kulturellen Aktivitäten, insbesondere durch multidisziplinäre und multikulturelle Veranstaltungen, die eine lokale Szene darstellen."
    ],
    "en": [
      "Promote and develop outdoor activities, urban sports, artistic and cultural activities, particularly through multidisciplinary and multicultural events on a local scene."
    ],
    "it": [
      "Promuovere e sviluppare le attività all'aperto, gli sport urbani, le attività artistiche e culturali, in particolare attraverso eventi multidisciplinari e multiculturali sulla scena locale"
    ],
    "fr": [
      "Promouvoir et développer des activités de plein air , de glisse urbaine, des activités artistiques et culturelles notamment au travers d'événements pluridisciplinaires et multiculturel sir une scène locale"
    ],
    "es": [
      "Promover y desarrollar las actividades al aire libre, los deportes urbanos y las actividades artísticas y culturales, en particular mediante eventos multidisciplinarios y multiculturales en el ámbito local"
    ],
    "nl": [
      "Buitenactiviteiten, stadssporten, artistieke en culturele activiteiten promoten en ontwikkelen, met name via multidisciplinaire en multiculturele evenementen op lokaal niveau."
    ]
  },
