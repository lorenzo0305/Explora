  "rdfs:comment": {
    "de": [
      "Das Hotelrestaurant Les Rosières heißt Sie mit Skiern am Croix Fry Pass willkommen. Neben dem herrlichen Plateau de Beauregard stehen Ihnen im Sommer viele Wanderungen in warmer Atmosphäre zur Verfügung."
    ],
    "en": [
      "The hotel restaurant Les Rosières welcomes you to the Croix Fry pass, skis on. Located next to the magnificent Plateau de Beauregard, many hiking departures are available to you in a warm atmosphere in summer."
    ],
    "it": [
      "Il ristorante dell'hotel Les Rosières vi accoglie al passo della Croix Fry, con gli sci ai piedi. Situato accanto al magnifico Plateau de Beauregard, vi sono numerosi sentieri escursionistici in un'atmosfera calda in estate."
    ],
    "fr": [
      "L'hôtel restaurant Les Rosières vous accueille au col de la Croix Fry, skis aux pieds. Situé à côté du magnifique Plateau de Beauregard, de nombreux départs de randonnées s'offrent à vous dans une ambiance chaleureuse en été."
    ],
    "nl": [
      "Het hotelrestaurant Les Rosières verwelkomt u op de Croix Fry pas, met ski's aan. Gelegen naast het prachtige Plateau de Beauregard, zijn er talrijke wandelpaden in een warme sfeer in de zomer."
    ],
    "es": [
      "El restaurante del hotel Les Rosières le da la bienvenida al paso de la Croix Fry, con los esquís puestos. Situada junto a la magnífica meseta de Beauregard, hay numerosas rutas de senderismo en un ambiente cálido en verano."
    ]
  },
  "rdfs:label": {
    "de": [
      "Les Rosières Restaurant"
    ],
    "en": [
      "Les Rosières restaurant"
    ],
    "fr": [
      "Restaurant Les Rosières"
    ]
  },
