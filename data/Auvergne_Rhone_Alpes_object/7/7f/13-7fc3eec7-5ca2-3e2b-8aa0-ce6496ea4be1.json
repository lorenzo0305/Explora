  "rdfs:comment": {
    "de": [
      "Georges Brassens' Blick auf seine Zeit anhand eines Chansons, das vom \"Trio Sans Prétention\" untersucht und illustriert wird. Ein Streifzug durch seine Jugend anhand seiner Chansons, aber nicht nur."
    ],
    "en": [
      "Georges Brassens's view of his time through a song studied and illustrated by \"le Trio Sans Prétention\", a stroll through his youth through his songs but not only."
    ],
    "it": [
      "Lo sguardo di Georges Brassens sul suo tempo attraverso una canzone studiata e illustrata da \"le Trio Sans Prétention\", una passeggiata nella sua giovinezza attraverso le sue canzoni ma non solo."
    ],
    "fr": [
      "Le regard de Georges Brassens sur son époque à travers une chanson étudiée et illustrée par \"le Trio Sans Prétention\", une balade dans sa jeunesse à travers ses chansons mais pas seulement."
    ],
    "es": [
      "La mirada de Georges Brassens sobre su época a través de una canción estudiada e ilustrada por \"le Trio Sans Prétention\", un paseo por su juventud a través de sus canciones pero no sólo."
    ],
    "nl": [
      "Georges Brassens' kijk op zijn tijd door middel van een lied, bestudeerd en geïllustreerd door \"le Trio Sans Prétention\", een wandeling door zijn jeugd door middel van zijn liedjes, maar niet alleen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Concert : \"Dans les yeux de Brassens\""
    ]
  },
