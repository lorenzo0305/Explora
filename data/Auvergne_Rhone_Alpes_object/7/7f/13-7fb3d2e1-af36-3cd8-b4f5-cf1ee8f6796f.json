  "rdfs:comment": {
    "de": [
      "Mitten in einem grünen Park ganz nahe der Fußgängerzone bietet das Thermalzentrum verschiedene Kuren, Wellnessbehandlungen und Fitnesstraining an."
    ],
    "en": [
      "The spa centre was fully renovated in 2012 and has a selection of packages: relaxation, spring water, gym, wellbeing and recreational."
    ],
    "it": [
      "Nel cuore di un parco verde, vicino alle vie pedonali, il centro termale offre diversi tipi di cure, trattamenti di relax e fitness."
    ],
    "fr": [
      "Au coeur d'un parc verdoyant, tout proche des rues piétonnes, le centre thermal propose différents types de cures, de soins de détente et remise en forme."
    ],
    "nl": [
      "In het hart van een groen park, dicht bij de voetgangersstraten, biedt het thermale centrum verschillende soorten kuren, ontspannings- en fitnessbehandelingen."
    ],
    "es": [
      "En el corazón de un parque verde, cerca de las calles peatonales, el centro termal ofrece diferentes tipos de curas, tratamientos de relajación y fitness."
    ]
  },
