  "rdfs:comment": {
    "de": [
      "Unser Projekt ? Wir bauen verschiedene saisonale Gemüsesorten aus biologischem Anbau an, um das ganze Jahr über einen kurzen Versorgungskreislauf zu gewährleisten."
    ],
    "en": [
      "Our project? To grow a diverse range of organically grown seasonal vegetables to ensure a year-round supply of short-distance produce."
    ],
    "it": [
      "Il nostro progetto? Coltivare un'ampia gamma di ortaggi biologici di stagione, per fornire un circuito di approvvigionamento a breve termine durante tutto l'anno."
    ],
    "fr": [
      "Notre projet ? Cultiver des légumes diversifiés de saison en agriculture biologique afin d’assurer une offre en circuit court tout au long de l'année."
    ],
    "es": [
      "¿Nuestro proyecto? Cultivar una amplia gama de hortalizas ecológicas de temporada, con el fin de proporcionar un circuito de abastecimiento a lo largo de todo el año."
    ],
    "nl": [
      "Ons project? Een breed assortiment biologisch geteelde groenten telen in het seizoen, om zo het hele jaar door te kunnen voorzien in een kort bevoorradingscircuit."
    ]
  },
  "rdfs:label": {
