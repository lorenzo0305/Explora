  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/e04968e6-4430-3d39-981d-a7f6fcb4945f",
      "dc:description": {
        "de": [
          "Farbenfrohe Augen!\n\nTreffen Sie sich mit uns am Strand, um eine außergewöhnliche Erfahrung zu machen: das Überqueren eines riesigen Drachens!\n\n24/07 und 14/08 um 10 Uhr\nFreier Zugang\nTreffpunkt am Strand gegenüber dem Place de l'Entonnoir"
        ],
        "en": [
          "Color for the eyes!\n\nJoin us on the beach for an extraordinary experience: flying a giant kite!\n\njuly 24 and August 14 at 10 a.m\nFree access\nMeet on the beach opposite Place de l'Entonnoir"
        ],
        "it": [
          "Colore per gli occhi!\n\nUnitevi a noi sulla spiaggia per un'esperienza straordinaria: far volare un aquilone gigante!\n\n24/07 e 14/08 alle 10:00\nAccesso libero\nRitrovo sulla spiaggia di fronte a Place de l'Entonnoir"
        ],
        "fr": [
          "Des couleurs pleins les yeux ! \n\nRejoignez-nous sur la plage pour vivre une expérience hors du commun : la traversée d'un cerf-volant géant !\n\n24/07 et 14/08 à 10h\nAccès libre\nRendez-vous sur la plage en face de la place de l'Entonnoir"
        ],
        "es": [
          "¡Color para los ojos!\n\nÚnete a nosotros en la playa para vivir una experiencia extraordinaria: ¡volar una cometa gigante!\n\n24/07 y 14/08 a las 10h\nAcceso gratuito\nEncuentro en la playa, frente a la Place de l'Entonnoir"
        ],
        "nl": [
          "Kleur voor de ogen!\n\nGa met ons mee naar het strand voor een buitengewone ervaring: vliegeren met een reuzenvlieger!\n\n24/07 en 14/08 om 10 uur\nGratis toegang\nAfspraak op het strand tegenover Place de l'Entonnoir"
        ]
      },
      "@type": [
        "Description"
