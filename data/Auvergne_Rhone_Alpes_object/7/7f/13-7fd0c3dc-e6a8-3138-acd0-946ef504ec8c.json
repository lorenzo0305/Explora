  "rdfs:comment": {
    "de": [
      "Imkereibetrieb, der seit 1930 in Betrieb ist. Er besteht aus 900 Bienenstöcken, die über die Departements der Region Berry / Auvergne du Nivernais (Cher, Allier, Nièvre, Puy de Dôme) verteilt sind. De facto ist die Honigernte unterschiedlich und vielfältig."
    ],
    "en": [
      "Beekeeping operation in operation since 1930. It comprises 900 hives, spread across the Berry / Auvergne du Nivernais departments (Cher, Allier, Nièvre, Puy de Dôme). As a result, the honey harvest is diverse and varied."
    ],
    "it": [
      "Apicoltura attiva dal 1930. Dispone di 900 alveari, distribuiti nella regione del Berry/Auvergne du Nivernais (Cher, Allier, Nièvre, Puy de Dôme). Di conseguenza, il raccolto di miele è vario e diversificato."
    ],
    "fr": [
      "Exploitation Apicole qui fonctionne depuis 1930. Elle se compose de 900 ruches, réparties sur les départements de la région Berry / Auvergne du Nivernais (Cher, Allier, Nièvre, Puy de Dôme). De fait, la récolte de miels est différente et variée."
    ],
    "es": [
      "Explotación apícola desde 1930. Cuenta con 900 colmenas repartidas por la región de Berry / Auvergne du Nivernais (Cher, Allier, Nièvre, Puy de Dôme). Por ello, la cosecha de miel es diversa y variada."
    ],
    "nl": [
      "Bijenteeltbedrijf dat al sinds 1930 bestaat. Het heeft 900 bijenkasten, verspreid over de regio Berry / Auvergne du Nivernais (Cher, Allier, Nièvre, Puy de Dôme). Hierdoor is de honingoogst divers en gevarieerd."
    ]
  },
