  "rdfs:comment": {
    "de": [
      "Anerkanntes Know-how.\r\nFondue, Crêpes und Galettes?\r\nVon einem Maître Restaurateur signiert. Der Unterschied liegt auf dem Teller!\r\nMitglied des \"Collège culinaire de France\" und der \"Confédération des Glaciers de France\""
    ],
    "en": [
      "Recognized know-how.\r\nFondue, crêpes and galettes...\r\nSigned by a Maître Restaurateur. The difference is in the plate!\r\nMember of the Collège Culinaire de France and the Confédération des Glaciers de France"
    ],
    "it": [
      "Competenze riconosciute.\r\nFonduta, crêpes e galettes?\r\nFirmati da un Maître Restaurateur. La differenza è nel piatto!\r\nMembro del Collège Culinaire de France e della Confédération des Glaciers de France"
    ],
    "fr": [
      "Savoir-faire reconnu. \r\nFondue, crêpes et galettes…\r\nSignées par un Maître Restaurateur. La différence est dans l’assiette !\r\nMembre du collège culinaire de France et de la Confédération des Glaciers de France"
    ],
    "es": [
      "Experiencia reconocida.\r\n¿Fondue, crêpes y galettes?\r\nFirmadas por un Maître Restaurateur. ¡La diferencia está en el plato!\r\nMiembro del Collège Culinaire de France y de la Confédération des Glaciers de France"
    ],
    "nl": [
      "Erkende expertise.\r\nFondue, crêpes en galettes?\r\nGesigneerd door een Maître Restaurateur. Het verschil zit in het bord!\r\nLid van het Collège Culinaire de France en de Confédération des Glaciers de France"
    ]
  },
