  "rdfs:comment": {
    "de": [
      "La Fruitière de la Folie Douce ist eine authentische französische Brasserie mit dem Flair einer Molkereigenossenschaft und lädt Sie dazu ein, 100% hausgemachte Gerichte vor einem außergewöhnlichen Panorama und einer außergewöhnlichen Show zu genießen. Ein geschmackliches und visuelles Rendezvous, das über das Gewöhnliche hinausgeht."
    ],
    "en": [
      "An authentic French brasserie, La Fruitière de la Folie douce serves 100% home-cooked dishes in front of an exceptional show, opposite Mont-Blanc. A feast for the eyes and the taste buds."
    ],
    "it": [
      "Autentica brasserie francese con l'atmosfera di una cooperativa lattiero-casearia, La Fruitière vi invita a gustare piatti 100% fatti in casa, in un contesto di panorama e spettacolo eccezionale. Un'esperienza gustativa e visiva che trascende l'ordinario."
    ],
    "fr": [
      "Authentique brasserie française aux accents de coopérative laitière, La Fruitière de la Folie Douce vous invite à savourer des plats 100% maison, face à un panorama et un show d’exception. Un rendez-vous gustatif et visuel qui transcende l'ordinaire."
    ],
    "nl": [
      "La Fruitière de la Folie Douce, een authentieke Franse brasserie met de sfeer van een zuivelcoöperatie, nodigt je uit om te genieten van 100% huisgemaakte gerechten tegen een uitzonderlijk panorama en spektakel. Een smaak- en visuele ervaring die het gewone overstijgt."
    ],
    "es": [
      "La Fruitière de la Folie Douce, auténtica brasserie francesa con aire de cooperativa lechera, le invita a saborear platos 100% caseros, enmarcados en un panorama y un espectáculo excepcionales. Una experiencia gustativa y visual que trasciende lo ordinario."
    ]
  },
