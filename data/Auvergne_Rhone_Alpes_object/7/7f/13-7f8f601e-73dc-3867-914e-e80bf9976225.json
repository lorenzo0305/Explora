  "rdfs:comment": {
    "de": [
      "Wir sind ein Unternehmen, das sich auf die Herstellung von Mosaikkunstwerken spezialisiert hat, die zu 100 % handgemacht sind.\r\nGanzjährige Kurse und Workshops zu bestimmten Themen. Besichtigung des Ateliers nur nach Vereinbarung."
    ],
    "en": [
      "We create 100% handmade mosaic artworks—unique, custom-made pieces for businesses and individuals. Free quotes available. Year-round classes and themed workshops offered. Studio visits by appointment only."
    ],
    "it": [
      "Creazione di opere musive 100% artigianali, uniche, su misura e personalizzate per aziende e privati, preventivo gratuito.\r\nCorsi e laboratori tematici durante tutto l'anno. Visite allo studio solo su appuntamento."
    ],
    "fr": [
      "Création d’œuvres en mosaïque 100% fait main, uniques, sur-mesures et personnalisées pour entreprises et particuliers, devis gratuit. \r\nCours à l'année et stage à thème . Visite de l'atelier sur rendez-vous uniquement."
    ],
    "nl": [
      "Creatie van 100% handgemaakte, unieke, op maat gemaakte en gepersonaliseerde mozaïekwerken voor bedrijven en particulieren, gratis prijsopgave.\r\nHet hele jaar door cursussen en thematische workshops. Bezoek aan de studio alleen op afspraak."
    ],
    "es": [
      "Creación de obras de mosaico 100% artesanales, únicas, a medida y personalizadas para empresas y particulares, presupuesto gratuito.\r\nCursos y talleres temáticos durante todo el año. Visitas al taller con cita previa."
    ]
  },
