  "rdfs:comment": {
    "de": [
      "Im Sommer wie im Winter empfängt Sie Giroud sports am Col de la Faucille. Dank der Beratung durch die fachkundigen Verkäufer finden Sie hier das richtige Qualitätsmaterial für Ihre Sportart."
    ],
    "en": [
      "Summer and winter alike, Giroud sports welcomes you to Col de la Faucille. Thanks to the advice of our expert sales staff, you'll be able to find the quality equipment that's just right for you."
    ],
    "it": [
      "Sia d'estate che d'inverno, Giroud sport vi accoglie al Col de la Faucille. Grazie ai consigli dei suoi esperti venditori, potrete trovare l'attrezzatura di qualità che si adatta perfettamente al vostro studio."
    ],
    "fr": [
      "Eté comme hiver, Giroud sports vous accueille au Col de la Faucille. Grâce aux conseils de ses vendeurs experts, vous saurez trouver le matériel de qualité qui conviendra parfaitement à votre pratique."
    ],
    "nl": [
      "Zowel in de zomer als in de winter heet Giroud sports u welkom op de Col de la Faucille. Dankzij het advies van zijn deskundige verkopers kunt u de kwaliteitsapparatuur vinden die perfect bij uw praktijk past."
    ],
    "es": [
      "Tanto en verano como en invierno, Giroud sports le da la bienvenida al Col de la Faucille. Gracias al asesoramiento de sus expertos vendedores, podrá encontrar el equipo de calidad que se adapte perfectamente a su consulta."
    ]
  },
