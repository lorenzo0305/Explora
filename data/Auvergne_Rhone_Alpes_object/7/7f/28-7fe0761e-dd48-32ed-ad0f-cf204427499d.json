  "rdfs:comment": {
    "de": [
      "L'Étoile du jour, ein authentisches und symbolträchtiges Restaurant im Abbevillois, in einem historischen Gebäude aus dem 16.\nJahrhundert. Eine Küche mit lokalen und regionalen Produkten, mit einer regelmäßig wechselnden, saisonalen Speisekarte."
    ],
    "en": [
      "L'Étoile du jour, an authentic restaurant emblematic of the Abbevillois region, in a historic 16th-century building.\nA cuisine based on local and regional produce, with a regularly renewed seasonal menu."
    ],
    "it": [
      "L'Étoile du jour, un autentico ristorante emblematico della zona di Abbevillois, in un edificio storico del XVI secolo.\nLa cucina si basa su prodotti locali e regionali, con un menu stagionale che cambia regolarmente."
    ],
    "fr": [
      "L’Étoile du jour, un restaurant authentique et emblématique de l’Abbevillois, dans un lieu historique du 16ème siècle.\nUne cuisine de produits locaux et régionaux, avec une carte régulièrement renouvelée et de saison."
    ],
    "es": [
      "L'Étoile du jour, un auténtico restaurante emblemático de la zona de Abbevillois, en un edificio histórico del siglo XVI.\nLa cocina se basa en productos locales y regionales, con un menú de temporada que cambia regularmente."
    ],
    "nl": [
      "L'Étoile du jour, een authentiek restaurant dat symbool staat voor de Abbevillois, in een historisch gebouw uit de 16e eeuw.\nDe keuken is gebaseerd op lokale en regionale producten, met een regelmatig wisselend seizoensmenu."
    ]
  },
