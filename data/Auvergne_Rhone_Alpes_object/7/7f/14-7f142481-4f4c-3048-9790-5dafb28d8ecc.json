  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/1c26e1d8-c804-3472-980d-ca3b72fc31a4",
      "dc:description": {
        "de": [
          "Ein kleiner Hunger zwischendurch? Wie wäre es, wenn wir uns einen gesunden, saisonalen Snack zubereiten, ganz spontan und mit den Mitteln, die uns zur Verfügung stehen.\nNehmen Sie diese Gourmet-Herausforderung an!"
        ],
        "en": [
          "Feeling peckish? How about preparing a healthy, seasonal snack, on the go and with the means at hand?\nCome and take up this gourmet challenge!"
        ],
        "it": [
          "Avete un certo languorino? Che ne dite di preparare uno spuntino sano e di stagione al volo, utilizzando ciò che vi avanza.\nVenite a raccogliere questa sfida gastronomica!"
        ],
        "fr": [
          "Un petit creux ? Et si on se préparait un encas sain, de saison, sur le pouce et avec les moyens du bord.\nVenez relever ce défi gourmand !"
        ],
        "es": [
          "¿Tienes hambre? Prepárese un tentempié sano y de temporada sobre la marcha, con lo que le sobre.\nAcepte este reto gastronómico"
        ],
        "nl": [
          "Trek? Waarom maak je geen gezonde seizoenssnack voor onderweg, met wat je maar kunt missen.\nKom en ga deze gastronomische uitdaging aan!"
        ]
      },
      "@type": [
        "Description"
