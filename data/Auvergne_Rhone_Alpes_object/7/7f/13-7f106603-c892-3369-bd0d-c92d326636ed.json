  "rdfs:comment": {
    "de": [
      "Bar - Restaurant - Lebensmittelgeschäft - Multiservice? in einer traumhaften Umgebung\r\nIm Herzen des Regionalen Naturparks Monts d'Ardèche lädt Sie Véronique in ihr Restaurant und Lebensmittelgeschäft am Ufer des Wasserfalls unseres schönen Flusses Talaron ein."
    ],
    "en": [
      "Throughout the summer, it offers a variety of events in a warm, family atmosphere: concerts, barbecues, pétanque, blind tests, etc.\r\nA simple and generous cuisine made from local produce, to be found in the grocery corner. Véronique's signature burger is on the menu, and there's also time for a pizza night!\r\nFor various events, specialities from the Ardèche will be on offer (caillette, bombine, crique, etc...)."
    ],
    "it": [
      "Bar - Ristorante - Drogheria - Multiservizi? in un ambiente da sogno\r\nNel cuore del Parco Naturale Regionale dei Monts d'Ardèche, Véronique vi invita nel suo ristorante-gastronomia accanto alla cascata del nostro bellissimo fiume Le Talaron."
    ],
    "fr": [
      "Bar - Restaurant - Épicerie - Multiservices… dans un cadre de rêve \r\nEn plein cœur du Parc Naturel Régional des Monts d'Ardèche, Véronique vous invite dans son restaurant-épicerie au bord de la cascade de notre belle rivière Le Talaron."
    ],
    "es": [
      "Bar - Restaurante - Ultramarinos - Multiservicios... en un entorno de ensueño\r\nEn pleno corazón del Parque Natural Regional de los Montes de Ardèche, Véronique le invita a su restaurante-tienda de ultramarinos junto a la cascada de nuestro hermoso río Le Talaron."
    ],
    "nl": [
      "Bar - Restaurant - Kruidenier - Multiservice? in een droomomgeving\r\nIn het hart van het Regionale Natuurpark van de Monts d'Ardèche nodigt Véronique je uit in haar restaurant-kruidenierszaak naast de waterval van onze prachtige rivier Le Talaron."
    ]
  },
