  "rdfs:comment": {
    "de": [
      "Dieses nordische Chalet in Le Blanchot empfängt Langläufer, die vom nordischen Gebiet Altiport aus starten. Dokumentation vor Ort."
    ],
    "ru": [
      "Шале для любителей беговых лыж у трассы Blanchot, приветствует бегунов в Альтипор (Altiport). Информация на месте."
    ],
    "en": [
      "This chalet situated at the Blanchot, at the start of the cross-country pistes of the Altiport, provides shelter and information to cross-country skiers."
    ],
    "it": [
      "Questo chalet nordico, situato a Le Blanchot, accoglie gli sciatori di fondo del comprensorio nordico Altiport. Documentazione in loco."
    ],
    "fr": [
      "Ce chalet nordique situé au Blanchot, accueille les fondeurs au départ du domaine nordique de l'Altiport. Documentation sur place."
    ],
    "es": [
      "Este chalet nórdico situado en Le Blanchot, acoge a los esquiadores de fondo de la zona nórdica de Altiport. Documentación in situ."
    ],
    "nl": [
      "Dit Noordse chalet in Le Blanchot verwelkomt langlaufers uit het Noordse gebied van Altiport. Documentatie ter plaatse."
    ]
  },
