  "rdfs:comment": {
    "de": [
      "Auf einer Fläche von sechzig Quadratmetern finden im Cavalier Rouge Ausstellungen mit Werken des Bildhauers Jérôme Danikowski und seiner Künstlerfreunde statt."
    ],
    "en": [
      "Over an area of sixty square meters, the Cavalier Rouge hosts exhibitions of works by sculptor Jérôme Danikowski and his artist friends."
    ],
    "it": [
      "Su una superficie di sessanta metri quadrati, il Cavalier Rouge ospita mostre di opere dello scultore Jérôme Danikowski e dei suoi amici artisti."
    ],
    "fr": [
      "Sur une superficie de soixante mètres carrés, le Cavalier Rouge accueille des expositions d'œuvres du sculpteur Jérôme Danikowski et de ses amis artistes."
    ],
    "nl": [
      "Op een oppervlakte van zestig vierkante meter worden in de Cavalier Rouge tentoonstellingen gehouden met werken van beeldhouwer Jérôme Danikowski en zijn bevriende kunstenaars."
    ],
    "es": [
      "Con una superficie de sesenta metros cuadrados, el Cavalier Rouge acoge exposiciones de obras del escultor Jérôme Danikowski y de sus amigos artistas."
    ]
  },
