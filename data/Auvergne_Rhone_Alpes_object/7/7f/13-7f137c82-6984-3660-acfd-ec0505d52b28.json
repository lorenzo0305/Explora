  "rdfs:comment": {
    "de": [
      "Beneath - Story Teller, der von Geschichten angetrieben wird, nimmt Sie mit in seine eigenen, indem er Wein und Gastronomie nutzt, um ein Universum rund um Emotionen und Gefühle zu erschaffen."
    ],
    "en": [
      "Beneath - Story Teller, driven by stories, takes you into his own, using wine and gastronomy to create a world of emotions and feelings."
    ],
    "it": [
      "Beneath - Story Teller, guidato dalle storie, vi porta in un viaggio tutto suo, utilizzando il vino e la gastronomia per creare un mondo di emozioni e sentimenti."
    ],
    "fr": [
      "Beneath - Story Teller, animé par les histoires, vous embarque dans les siennes, en s’aidant du vin et de la gastronomie pour créer un univers autour des émotions et des ressentis."
    ],
    "es": [
      "Beneath - Story Teller, impulsado por las historias, te lleva en un viaje propio, utilizando el vino y la gastronomía para crear un mundo de emociones y sentimientos."
    ],
    "nl": [
      "Beneath - Story Teller, gedreven door verhalen, neemt je mee op een eigen reis, waarbij wijn en gastronomie worden gebruikt om een wereld van emoties en gevoelens te creëren."
    ]
  },
