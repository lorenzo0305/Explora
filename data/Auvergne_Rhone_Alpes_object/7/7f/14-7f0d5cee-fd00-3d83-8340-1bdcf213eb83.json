  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/e2408357-df34-36d9-a3a8-c37db66c87b9",
      "dc:description": {
        "de": [
          "Farben, Federn und Glitzer...\nKomm und kreiere deine eigene Maske und lass deiner Kreativität freien Lauf, angeleitet von der Animateurin der Mediathek - Kostenlos\nFür Kinder von 6 bis 10 Jahren.\nAnmeldung beim Fremdenverkehrsamt erforderlich."
        ],
        "en": [
          "Colors, feathers and sequins...\nCome and create your own mask and give free rein to your creativity, guided by the media library animator - Free\nFor ages 6 to 10.\nRegistration essential at the Tourist Office."
        ],
        "it": [
          "Colori, piume e paillettes...\nVenite a creare la vostra maschera e date libero sfogo alla vostra creatività, guidati dall'animatore della mediateca - Gratuito\nPer bambini dai 6 ai 10 anni.\nIscrizione obbligatoria presso l'Ufficio del Turismo."
        ],
        "fr": [
          "Couleurs, plumes et paillettes...\nViens créer ton propre masque et laisse libre cours à ta créativité, guidé(e) par l'animatrice de la médiathèque - Gratuit\nPour les 6 à 10 ans.\nInscription indispensable à l'Office de Tourisme."
        ],
        "nl": [
          "Kleuren, veren en lovertjes...\nKom je eigen masker maken en laat je creativiteit de vrije loop onder begeleiding van de activiteitenbegeleider van de mediatheek - Gratis\nVoor kinderen van 6 tot 10 jaar.\nAanmelding noodzakelijk bij het VVV-kantoor."
        ],
        "es": [
          "Colores, plumas y lentejuelas...\nVen a crear tu propia máscara y da rienda suelta a tu creatividad, guiado por el animador de la mediateca - Gratis\nPara niños de 6 a 10 años.\nImprescindible inscribirse en la Oficina de Turismo."
        ]
      },
      "@type": [
        "Description"
      ],
