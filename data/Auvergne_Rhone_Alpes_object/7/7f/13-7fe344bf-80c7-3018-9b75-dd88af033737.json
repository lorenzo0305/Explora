  "rdfs:comment": {
    "de": [
      "Des cartes pour le dire ist eine handwerkliche Boutique, in der jede Karte mit Leidenschaft von einer Designerin handgefertigt wird, die die Kunst des Stampings, der Aquarellmalerei, des Ankerns, des Schneidens und des Klebens beherrscht, um einzigartige Botschaften zu verschenken."
    ],
    "en": [
      "Des cartes pour le dire is an artisanal boutique where each card is handmade with passion by a designer who masters the art of stamping, watercoloring, anchoring, cutting and gluing, to offer unique messages."
    ],
    "it": [
      "Des cartes pour le dire è una boutique artigianale dove ogni biglietto è fatto a mano con passione da una designer che ha imparato l'arte del timbro, dell'acquerello, dell'ancoraggio, del taglio e del collage, per creare messaggi unici."
    ],
    "fr": [
      "Des cartes pour le dire est une boutique artisanale où chaque carte est faite main avec passion par une créatrice qui maîtrise l’art du stamping, de l’aquarelle, de l’ancrage, de la découpe et du collage, pour offrir des messages uniques."
    ],
    "nl": [
      "Des cartes pour le dire is een ambachtelijke boetiek waar elke kaart met passie met de hand wordt gemaakt door een ontwerper die de kunst van het stempelen, aquarelleren, verankeren, knippen en collages onder de knie heeft om unieke boodschappen te creëren."
    ],
    "es": [
      "Des cartes pour le dire es una boutique artesanal donde cada tarjeta está hecha a mano con pasión por un diseñador que domina el arte de la estampación, la acuarela, el anclaje, el recorte y el collage, para crear mensajes únicos."
    ]
  },
