  "rdfs:comment": {
    "de": [
      "Mahaut ist Kolumnistin bei France Inter und leidenschaftliche Politikerin. Sie hat ihr Abitur in \"écriture inclusive\", spé féminisme, option queerness, gemacht."
    ],
    "en": [
      "A columnist on France Inter with a passion for politics, Mahaut took her baccalaureate in inclusive writing, specializing in feminism, with a queerness option."
    ],
    "it": [
      "Opinionista di France Inter e appassionata di politica, Mahaut ha conseguito la maturità in scrittura inclusiva, con specializzazione in femminismo e opzione queerness."
    ],
    "fr": [
      "Chroniqueuse sur France Inter et passionnée de politique, Mahaut a obtenu son bac écriture inclusive, spé féminisme, option queerness."
    ],
    "nl": [
      "Mahaut is columniste bij France Inter en een fervent politica. Ze haalde haar A-niveau in inclusief schrijven, met als specialisatie feminisme en een optie homoseksualiteit."
    ],
    "es": [
      "Columnista en France Inter y política entusiasta, Mahaut cursó el bachillerato en escritura integradora, especializándose en feminismo, con una opción de \"queerness\"."
    ]
  },
