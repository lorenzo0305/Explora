  "rdfs:comment": {
    "de": [
      "La Tabl?a Boom, ein traditionelles Restaurant in Le Pont-de-Beauvoisin, zelebriert die authentische französische Küche in einer warmen und freundlichen Atmosphäre. Genießen Sie hausgemachte Gerichte, die mit frischen Zutaten zubereitet werden."
    ],
    "en": [
      "La Tabl'a Boom, traditional restaurant at Pont-de-Beauvoisin, celebrates authentic French cuisine in a warm and friendly atmosphere. Come enjoy homemade dishes, prepared with fresh products."
    ],
    "it": [
      "La Tabl?a Boom, ristorante tradizionale di Pont-de-Beauvoisin, celebra l'autentica cucina francese in un'atmosfera calda e accogliente. Venite a gustare piatti fatti in casa e preparati con prodotti freschi."
    ],
    "fr": [
      "La Tabl’a Boom, restaurant traditionnel au Pont-de-Beauvoisin, célèbre la cuisine française authentique dans une ambiance chaleureuse et conviviale. Venez savourer des plats faits maison, préparés avec des produits frais."
    ],
    "es": [
      "La Tabl?a Boom, restaurante tradicional de Pont-de-Beauvoisin, celebra la auténtica cocina francesa en un ambiente cálido y acogedor. Venga y disfrute de platos caseros preparados con productos frescos."
    ],
    "nl": [
      "La Tabl?a Boom, een traditioneel restaurant in Pont-de-Beauvoisin, viert authentieke Franse gerechten in een warme en vriendelijke sfeer. Kom genieten van huisgemaakte gerechten bereid met verse producten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La tabl'à Boom"
    ]
  },
