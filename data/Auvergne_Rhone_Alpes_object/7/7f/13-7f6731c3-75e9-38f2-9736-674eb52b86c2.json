  "rdfs:comment": {
    "de": [
      "Coin Nordic lädt Sie zu einer Wellness-Pause in einem außergewöhnlichen Rahmen ein: Genießen Sie die beruhigende Wärme unserer Saunen mit Panoramablick auf den Genfersee und lassen Sie sich, wenn Sie möchten, von der belebenden Frische des Sees verführen."
    ],
    "en": [
      "Coin Nordic invites you to take a wellness break in an exceptional setting: enjoy the soothing warmth of our saunas with panoramic views of Lake Geneva, and if you wish, indulge in the invigorating freshness of the lake."
    ],
    "it": [
      "Coin Nordic vi invita a concedervi una pausa di benessere in un ambiente eccezionale: godetevi il calore rilassante delle nostre saune con vista panoramica sul Lago di Ginevra e, se volete, lasciatevi tentare dal fresco rinvigorente del lago."
    ],
    "fr": [
      "Coin Nordic vous invite à une parenthèse de bien-être dans un cadre exceptionnel : profitez de la chaleur apaisante de nos saunas avec vue panoramique sur le Léman, et laissez-vous tenter, si vous le souhaitez, par la fraîcheur vivifiante du lac."
    ],
    "nl": [
      "Coin Nordic nodigt je uit voor een wellnessvakantie in een uitzonderlijke omgeving: geniet van de weldadige warmte van onze sauna's met panoramisch uitzicht over het meer van Genève, en laat je desgewenst verleiden door de verkwikkende koelte van het meer."
    ],
    "es": [
      "Coin Nordic le invita a una pausa de bienestar en un marco excepcional: disfrute del calor relajante de nuestras saunas con vistas panorámicas al lago Lemán y, si lo desea, déjese tentar por el frescor tonificante del lago."
    ]
  },
  "rdfs:label": {
    "de": [
      "Saunen Coin Nordic"
    ],
    "en": [
      "Nordic Corner"
    ],
    "fr": [
      "Saunas de Coin Nordic"
    ],
    "nl": [
      "Sauna's van Coin Nordic"
    ]
  },
