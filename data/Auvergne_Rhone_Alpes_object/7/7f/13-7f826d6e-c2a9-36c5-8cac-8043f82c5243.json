  "rdfs:comment": {
    "de": [
      "Erkunden Sie das alte Zentrum von Romans! Diese Tour bietet einen Bummel durch die Straßen, Plätze und schönen Häuser des historischen Zentrums..."
    ],
    "en": [
      "Explore the old town of Romans! This tour takes you on a stroll through the streets, squares and beautiful homes of the historic center..."
    ],
    "it": [
      "Esplorate il centro storico di Roma! Questo tour vi porta a spasso per le strade, le piazze e le belle case del centro storico..."
    ],
    "fr": [
      "Explorez le centre ancien de Romans ! Cette visite propose une flânerie dans les rues, les places et dans les belles demeures du centre historique..."
    ],
    "es": [
      "¡Explore el casco antiguo de Roma! Este tour le llevará a pasear por las calles, plazas y hermosas casas del centro histórico..."
    ],
    "nl": [
      "Verken de oude stad van Rome! Deze tour neemt je mee op een wandeling door de straten, pleinen en prachtige huizen van het historische centrum..."
    ]
  },
