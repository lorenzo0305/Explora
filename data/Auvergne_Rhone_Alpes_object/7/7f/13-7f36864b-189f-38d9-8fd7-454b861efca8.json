  "rdfs:comment": {
    "de": [
      "Speziell: Oh Mädchen!\r\nEntdecken Sie das Werk von Artemisia Gentileschi (1593-1656), die sich in einer von Männern dominierten Umgebung durchsetzte und ihre Unabhängigkeit erlangte."
    ],
    "en": [
      "Special Oh Girls!\r\nDiscover the work of Artemisia Gentileschi (1593-1656), who won her independence in a very masculine environment."
    ],
    "it": [
      "Speciale Oh Girls!\r\nScoprite l'opera di Artemisia Gentileschi (1593-1656), che ha conquistato la sua indipendenza in un ambiente molto maschile."
    ],
    "fr": [
      "Spéciale Oh les filles !\r\nDécouvrez l’Œuvre de Artemisia Gentileschi (1593-1656) qui a su s’imposer et gagner son indépendance dans un milieu très masculin."
    ],
    "nl": [
      "Speciaal Oh Meisjes!\r\nOntdek het werk van Artemisia Gentileschi (1593-1656), die haar onafhankelijkheid won in een zeer mannelijke omgeving."
    ],
    "es": [
      "Especial ¡Oh, chicas!\r\nDescubra la obra de Artemisia Gentileschi (1593-1656), que conquistó su independencia en un entorno muy masculino."
    ]
