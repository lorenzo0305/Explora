  "rdfs:comment": {
    "de": [
      "Ideal gelegen am Fuße der Seilbahn \"Aiguille du Midi\", bietet Ihnen unser SKISET -Shop \"Aiguille du Midi\" eine große Auswahl an Material zum Mieten und Kaufen."
    ],
    "en": [
      "Ideally located at the foot of the Aiguille du Midi\" cable car, our SKISET \"Aiguille du Midi\" store offers a wide range of equipment for hire and sale."
    ],
    "it": [
      "Situato in posizione ideale ai piedi della funivia dell'Aiguille du Midi, il nostro negozio SKISET  \"Aiguille du Midi\" offre un'ampia gamma di attrezzature a noleggio e in vendita."
    ],
    "fr": [
      "Idéalement située au pied du téléphérique de l'Aiguille du Midi\", notre boutique SKISET \"Aiguille du Midi\" vous propose un large choix de matériel à la location et à la vente."
    ],
    "es": [
      "Idealmente situada al pie del teleférico de la Aiguille du Midi\", nuestra tienda SKISET  \"Aiguille du Midi\" ofrece una amplia gama de material de alquiler y venta."
    ],
    "nl": [
      "Ideaal gelegen aan de voet van de \"Aiguille du Midi\" kabelbaan, biedt onze SKISET \"Aiguille du Midi\" winkel een breed scala aan materiaal te huur en te koop."
    ]
  },
