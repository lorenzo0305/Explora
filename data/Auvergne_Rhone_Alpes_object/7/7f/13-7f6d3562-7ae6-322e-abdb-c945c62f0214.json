  "rdfs:comment": {
    "de": [
      "Das Le Bouchon Rouge ist ein Ort zwischen einem traditionellen Bouchon, einer modernen und eleganten Kantine und einer geselligen Bar. Das Restaurant im Viertel Saint-Jean verbirgt hinter seinen Vorhängen zwei Ebenen sowie mehrere hintereinander liegende Räume."
    ],
    "en": [
      "Le Bouchon Rouge is somewhere between a traditional bouchon, an elegant, modern canteen and a convivial bar. Hidden behind the curtains of this restaurant, located in the Saint-Jean neighbourhood, there are two floors and several rooms leading into each other."
    ],
    "it": [
      "Le Bouchon Rouge è un luogo a metà strada tra il bouchon tradizionale, la mensa moderna ed elegante e il bar accogliente. Il ristorante, situato nel quartiere Saint-Jean, nasconde dietro le sue tende due livelli e diverse sale adiacenti."
    ],
    "fr": [
      "Le Bouchon Rouge est un lieu à mi-chemin entre le bouchon traditionnel, la cantine moderne et élégante et le bar convivial. Le restaurant, situé dans le quartier Saint-Jean, cache derrière ses rideaux deux niveaux ainsi que plusieurs salles en enfilade."
    ],
    "nl": [
      "Le Bouchon Rouge is een plek die het midden houdt tussen de traditionele bouchon, de moderne en elegante kantine en de gezellige bar. Het restaurant, gelegen in de wijk Saint-Jean, verbergt achter zijn gordijnen twee niveaus en verschillende aangrenzende zalen."
    ],
    "es": [
      "Le Bouchon Rouge es un lugar a medio camino entre el bouchon tradicional, la cantina moderna y elegante y el bar acogedor. El restaurante, situado en el barrio de Saint-Jean, esconde tras sus cortinas dos niveles y varias salas contiguas."
    ]
  },
