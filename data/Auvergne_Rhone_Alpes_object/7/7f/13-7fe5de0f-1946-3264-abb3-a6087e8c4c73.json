  "rdfs:comment": {
    "de": [
      "In einer mittelalterlichen Umgebung in einem der schönsten Dörfer Frankreichs vereinen Nico Pizza und unser italienischer Pizzakoch Giovanni ihr Know-how, um Ihnen qualitativ hochwertige Pizzen zu versprechen."
    ],
    "en": [
      "In a medieval setting, in one of France's most beautiful villages, Nico Pizza and our Italian pizzailo chef Giovanni combine their know-how to promise you quality pizzas."
    ],
    "it": [
      "In un ambiente medievale, in uno dei più bei villaggi della Francia, Nico Pizza e il nostro pizzaiolo italiano Giovanni uniscono il loro know-how per promettervi pizze di qualità."
    ],
    "fr": [
      "Dans un cadre médiéval, dans un des plus beaux villages de France Nico Pizza et notre chef pizzailo Italien Giovanni allient leur savoir-faire afin de vous promettre des pizzas de qualité."
    ],
    "nl": [
      "In een middeleeuws kader, in een van de mooiste dorpen van Frankrijk, combineren Nico Pizza en onze Italiaanse pizzakok Giovanni hun knowhow om je kwaliteitspizza's te beloven."
    ],
    "es": [
      "En un entorno medieval, en uno de los pueblos más bonitos de Francia, Nico Pizza y nuestro pizzero italiano Giovanni combinan su saber hacer para prometerle pizzas de calidad."
    ]
  },
