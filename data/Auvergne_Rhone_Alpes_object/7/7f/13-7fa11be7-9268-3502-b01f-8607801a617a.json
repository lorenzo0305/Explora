  "rdfs:comment": {
    "de": [
      "Ein ca. 17 km langer grüner Wanderweg, der Cheyssac (Gemeinde Vebret) über Ydes mit Bort-les-Orgues verbindet. Er wurde auf einer ehemaligen Eisenbahnlinie angelegt."
    ],
    "en": [
      "A 17 km green trail linking Cheyssac (commune of Vebret) to Bort-les-Orgues via Ydes. It is built on a former railroad line."
    ],
    "it": [
      "Un sentiero verde di 17 km che collega Cheyssac (comune di Vebret) a Bort-les-Orgues passando per Ydes. È costruito su un'ex linea ferroviaria."
    ],
    "fr": [
      "Piste Verte d'envrion 17 km qui relie Cheyssac (commune de Vebret) à Bort-les-Orgues en passant par Ydes. Elle est aménagée sur une ancienne ligne de chemin de fer."
    ],
    "es": [
      "Vía verde de 17 km que une Cheyssac (municipio de Vebret) con Bort-les-Orgues pasando por Ydes. Está construida sobre una antigua línea de ferrocarril."
    ],
    "nl": [
      "Een groen pad van 17 km dat Cheyssac (gemeente Vebret) via Ydes met Bort-les-Orgues verbindt. Het is aangelegd op een voormalige spoorlijn."
    ]
  },
