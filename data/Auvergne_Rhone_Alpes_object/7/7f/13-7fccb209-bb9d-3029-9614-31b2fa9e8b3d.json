  "rdfs:comment": {
    "de": [
      "Entdecken Sie rund um den Mont Ventoux, Nyons oder Buis-les-Baronnies die ganze Magie eines Gleitschirmflugs.\r\nIn aller Sicherheit überfliegen Sie das Massiv der Baronnies Provençales und erleben einen einzigartigen Moment der Freiheit, der Flucht aus dem Alltag und des Wohlbefindens."
    ],
    "en": [
      "Around Mont Ventoux, Nyons or Buis-les-Baronnies, discover the magic of paragliding.\r\nIn total safety, fly over the Baronnies Provençales massif and experience a unique moment of freedom, escape and well-being."
    ],
    "it": [
      "Nei dintorni del Mont Ventoux, di Nyons o di Buis-les-Baronnies, scoprite la magia del parapendio\r\nIn tutta sicurezza, sorvolate il massiccio delle Baronnies Provençales e vivete un momento unico di libertà, evasione e benessere."
    ],
    "fr": [
      "Autour du Mont Ventoux, de Nyons ou de Buis-les-Baronnies, découvrez toute la magie d'un vol en parapente. \r\nEn toute sécurité, survolez le massif des Baronnies Provençales et vivez un moment unique de liberté, d’évasion et de bien-être."
    ],
    "nl": [
      "Ontdek rond de Mont Ventoux, Nyons of Buis-les-Baronnies de magie van paragliding.\r\nVlieg in alle veiligheid over het massief van de Baronnies Provençales en beleef een uniek moment van vrijheid, ontsnapping en welzijn."
    ],
    "es": [
      "Alrededor del Mont Ventoux, Nyons o Buis-les-Baronnies, descubra la magia del parapente\r\nCon total seguridad, sobrevuele el macizo de las Baronnies Provençales y viva un momento único de libertad, evasión y bienestar."
    ]
  },
  "rdfs:label": {
    "de": [
      "Baronnies- Paragliding - \" Lou Ventoun \" (Gleitschirmfliegen)"
    ],
    "en": [
      "Baronnies- Paragliding - « Lou Ventoun »"
    ],
    "fr": [
      "Baronnies- Parapente - « Lou Ventoun »"
    ],
    "nl": [
      "Baronnies- Paragliding - \"Lou Ventoun\""
    ]
  },
