  "rdfs:comment": {
    "de": [
      "Montbloy war um 1190 eine der Verteidigungsburgen der Benediktinerabtei Savigny und wurde im 15. Jahrhundert zum Wohnsitz der Äbte. Die Besichtigung zeigt die Bedeutung der Burg seit dem Mittelalter, Fresken und das Panorama vom Turm aus."
    ],
    "en": [
      "This defensive château, which once belonged to Savigny's Benedictine abbey, became home to the abbots of Albon in the 15th century. Remains of the 12th century wall and chapel and 15th century buildings can still be seen."
    ],
    "it": [
      "Montbloy era uno dei castelli difensivi dell'abbazia benedettina di Savigny intorno al 1190 e divenne la residenza degli abati nel XV secolo. La visita evidenzia l'importanza del castello a partire dal Medioevo, oltre ad affreschi e a una vista panoramica dalla cima della torre."
    ],
    "fr": [
      "Montbloy fut l'un des châteaux de défense de l'abbaye bénédictine de Savigny vers 1190 et est devenu au XVème siècle la demeure des abbés. La visite présente l’importance du château dès le moyen-âge, des fresques et le panorama du haut de la tour."
    ],
    "nl": [
      "Montbloy was rond 1190 een van de verdedigingskastelen van de benedictijnenabdij van Savigny en werd in de 15e eeuw de residentie van de abten. De rondleiding belicht het belang van het kasteel vanaf de middeleeuwen, evenals fresco's en een panoramisch uitzicht vanaf de top van de toren."
    ],
    "es": [
      "Montbloy fue uno de los castillos defensivos de la abadía benedictina de Savigny hacia 1190 y se convirtió en la residencia de los abades en el siglo XV. La visita destaca la importancia del castillo a partir de la Edad Media, así como frescos y una vista panorámica desde lo alto de la torre."
    ]
  },
  "rdfs:label": {
    "en": [
      "Le Château de Montbloy"
    ],
    "fr": [
      "Le Château de Montbloy"
    ]
  },
