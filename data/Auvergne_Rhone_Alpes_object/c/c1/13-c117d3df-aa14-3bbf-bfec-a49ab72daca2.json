  "rdfs:comment": {
    "de": [
      "Intersport, der Spezialist für Sportgeräte, empfängt Sie an einem freundlichen Ort, wo Sie bei Ihren Entscheidungen von echten Sportbegeisterten unterstützt werden."
    ],
    "en": [
      "Intersport, the specialist in sports equipment sales, welcomes you to a friendly place, where you will be supported in your choices by true enthusiasts."
    ],
    "it": [
      "Intersport, lo specialista nella vendita di attrezzature sportive, vi accoglie in un luogo amichevole dove sarete supportati nelle vostre scelte da veri appassionati."
    ],
    "fr": [
      "Intersport, le spécialiste de la vente de matériel de sport, vous accueille dans un lieu convivial, où vous serez épaulés dans vos choix par de vrais passionnés."
    ],
    "es": [
      "Intersport, especialista en la venta de material deportivo, le da la bienvenida a un lugar acogedor en el que será apoyado en sus elecciones por auténticos apasionados."
    ],
    "nl": [
      "Intersport, de gespecialiseerde verkoper van sportartikelen, verwelkomt je op een vriendelijke plek waar je in je keuzes wordt bijgestaan door echte enthousiastelingen."
    ]
  },
