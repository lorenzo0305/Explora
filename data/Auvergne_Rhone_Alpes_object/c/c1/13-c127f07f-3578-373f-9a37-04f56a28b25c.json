  "rdfs:comment": {
    "de": [
      "Das an den Hang geschmiegte Dorf Vaunaveys-la-Rochette lädt Sie zu einer Zeitreise ein. Seine mittelalterlichen Straßen offenbaren Stadtmauern, Türme und gotische Tore, während der Glockenturm von Massonnes ein atemberaubendes Panorama bietet."
    ],
    "en": [
      "Clinging to the hillside, the village of Vaunaveys-la-Rochette invites you on a journey through time. Its medieval streets reveal ramparts, towers, and Gothic gates, while the Massonnes bell tower offers a stunning panorama."
    ],
    "it": [
      "Aggrappato alla collina, il villaggio di Vaunaveys-la-Rochette invita a fare un viaggio nel tempo. Le sue strade medievali rivelano bastioni, torri e porte gotiche, mentre il campanile di Massonnes offre un panorama sorprendente."
    ],
    "fr": [
      "Accroché au relief, le village de Vaunaveys-la-Rochette vous invite à un voyage dans le temps. Ses ruelles médiévales dévoilent remparts, tours et portes gothiques, tandis que le clocher des Massonnes offre un panorama étonnant."
    ],
    "nl": [
      "Het tegen de heuvel aanleunende dorp Vaunaveys-la-Rochette nodigt u uit voor een reis door de tijd. De middeleeuwse straatjes onthullen wallen, torens en gotische poorten, terwijl de klokkentoren van Massonnes een adembenemend panorama biedt."
    ],
    "es": [
      "Aferrado a la ladera, el pueblo de Vaunaveys-la-Rochette invita a un viaje en el tiempo. Sus calles medievales revelan murallas, torres y puertas góticas, mientras que el campanario de Massonnes ofrece un panorama asombroso."
    ]
  },
