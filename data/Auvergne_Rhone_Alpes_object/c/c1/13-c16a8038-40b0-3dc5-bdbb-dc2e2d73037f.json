  "rdfs:comment": {
    "de": [
      "Die Arbeit von Olivier Loup dreht sich um Verwerfungen und Brüche. Seine Stücke, die wie lebende Materialien gedacht sind, laden zur Sensibilität und Wahrnehmung ein."
    ],
    "en": [
      "Olivier Loup?s work revolves around faults and fractures. His pieces, conceived as living materials, invite sensitivity and perception."
    ],
    "it": [
      "Il lavoro di Olivier Loup ruota attorno a crepe e fratture. I suoi pezzi, concepiti come materiali vivi, invitano alla sensibilità e alla percezione."
    ],
    "fr": [
      "Le travail d’Olivier Loup s’articule autour des failles et des fractures. Ses pièces, pensées comme des matières vivantes, invitent à la sensibilité et à la perception."
    ],
    "es": [
      "La obra de Olivier Loup gira en torno a grietas y fracturas. Sus piezas, concebidas como materiales vivos, invitan a la sensibilidad y a la percepción."
    ],
    "nl": [
      "Het werk van Olivier Loup draait om scheuren en breuken. Zijn stukken, opgevat als levende materialen, nodigen uit tot gevoeligheid en perceptie."
    ]
  },
