  "rdfs:comment": {
    "de": [
      "Ein herzlicher Empfang, voll ausgestattete Zimmer mit kostenlosem WLAN und für Ihr leibliches Wohl gibt es Buffets nach Belieben und saisonale, schmackhafte und abwechslungsreiche Gerichte."
    ],
    "en": [
      "A warm welcome, rooms all equipped with free wifi and to restore you, all-you-can-eat buffets and seasonal dishes, tasty and varied."
    ],
    "it": [
      "Un'accoglienza calorosa, camere completamente attrezzate con connessione Wi-Fi gratuita e, per il vostro piacere gastronomico, buffet a volontà e piatti stagionali gustosi e variegati."
    ],
    "fr": [
      "Un accueil chaleureux, des chambres toutes équipées avec le wifi gratuit et pour vous restaurer, des buffets à volonté et des plats de saison, savoureux et variés."
    ],
    "es": [
      "Una cálida bienvenida, habitaciones totalmente equipadas con Wi-Fi gratuito y, para su placer gastronómico, buffets con todo incluido y sabrosos y variados platos de temporada."
    ],
    "nl": [
      "Een warm welkom, volledig uitgeruste kamers met gratis WiFi en, voor uw eetplezier, all-you-can-eat buffetten en smakelijke en gevarieerde seizoensgerechten."
    ]
  },
