  "rdfs:comment": {
    "de": [
      "Restaurantsaal mit savoyischem Ambiente und Kamin. Traditionelle, hochwertige und raffinierte Küche, savoyische Spezialitäten, Fleisch, Hausmannskost. Barbereich mit gemütlicher Lounge."
    ],
    "en": [
      "Savoyard-style restaurant with fireplace. Refined, high-quality traditional cuisine, Savoyard specialities, meats, home cooking. Bar area with cosy lounge."
    ],
    "it": [
      "Ristorante in stile savoiardo con camino aperto. Cucina tradizionale raffinata e di qualità, specialità savoiarde, carni, cucina casalinga. Area bar con accogliente salotto."
    ],
    "fr": [
      "Salle de restaurant ambiance savoyarde avec cheminée. Cuisine traditionnelle de qualité et raffinée, spécialités savoyardes, viandes, cuisine maison. Coin bar avec salon cosy."
    ],
    "es": [
      "Restaurante de estilo saboyano con chimenea. Cocina tradicional refinada y de calidad, especialidades saboyanas, carnes, cocina casera. Zona de bar con acogedor salón."
    ],
    "nl": [
      "Restaurant in Savoyaardse stijl met open haard. Verfijnde traditionele keuken van hoge kwaliteit, specialiteiten uit de Savoie, vleeswaren, huisgemaakte gerechten. Bar met gezellige lounge."
    ]
  },
