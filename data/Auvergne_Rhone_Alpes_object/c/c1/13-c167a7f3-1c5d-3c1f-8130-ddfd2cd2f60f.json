  "rdfs:comment": {
    "de": [
      "Dieses Museum zeigt die Geschichte bis zur Gegenwart des Handwerks der Schleiferei von Edelsteinen und Schmucksteinen. Ausstellung einer großen Mineraliensammlung."
    ],
    "en": [
      "History of the gem-cutting trade up to the present day. How these stones are used to create jewellery. Movie, stones and gems collection."
    ],
    "it": [
      "Questo museo ripercorre la storia del mestiere di tagliatore di pietre fini e preziose fino ai giorni nostri. È esposta un'ampia collezione di minerali."
    ],
    "fr": [
      "Ce musée retrace l'histoire jusqu'à aujourd'hui du métier de la taillerie de pierres fines et précieuses. Exposition d'une grande collection de minéraux."
    ],
    "es": [
      "Este museo recorre la historia del oficio de tallador de piedras finas y preciosas hasta nuestros días. Se expone una amplia colección de minerales."
    ],
    "nl": [
      "Dit museum schetst de geschiedenis van de handel in fijne en kostbare stenen tot op de dag van vandaag. Er wordt een grote collectie mineralen tentoongesteld."
    ]
  },
  "rdfs:label": {
    "de": [
      "Museum der Steine und des Lapidariums"
    ],
    "en": [
      "Stones and lapidary museum"
    ],
    "fr": [
      "Musée des pierres et du lapidaire"
    ]
  },
