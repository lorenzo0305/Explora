  "rdfs:comment": {
    "de": [
      "Die Post ist da, um Ihren Bedarf an Post-Paket-Frankierung zu decken und Sie mit den Bank- und Versicherungslösungen von La Banque Postale zu begleiten."
    ],
    "en": [
      "La Poste is there to meet your mail and parcel postage needs, and to support you with banking and insurance solutions from La Banque Postale."
    ],
    "it": [
      "La Poste è a disposizione per soddisfare le vostre esigenze di affrancatura dei pacchi postali e per supportarvi con le soluzioni bancarie e assicurative de La Banque Postale."
    ],
    "fr": [
      "La poste est là pour répondre à vos besoins d'affranchissement Courrier-Colis et vous accompagner avec les solutions banque et assurance de La Banque Postale."
    ],
    "nl": [
      "La Poste is er om te voldoen aan je frankeerbehoeften en je te ondersteunen met de bank- en verzekeringsoplossingen van La Banque Postale."
    ],
    "es": [
      "La Poste está a su disposición para satisfacer sus necesidades de franqueo de paquetes postales y apoyarle con las soluciones bancarias y de seguros de La Banque Postale."
    ]
