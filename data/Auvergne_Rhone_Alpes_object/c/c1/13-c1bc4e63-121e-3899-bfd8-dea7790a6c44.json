  "rdfs:comment": {
    "de": [
      "Seit 1871 Herstellung von Trockenwürsten, Schinken und Wurstwaren, die typisch für die Ardèche sind\r\nLes Estivales: (Juli-August: Montag): Geführte Besichtigung der Salaisons Teyssier, Anmeldung beim Fremdenverkehrsamt, Kostprobe am Ende der Besichtigung."
    ],
    "en": [
      "Since 1871, production of dry sausages, hams and charcuterie typical of the Ardèche region. \r\nLes Estivales: (July-August: Monday): guided tour of the Salaisons Teyssier, by registration at the Tourist Office, tasting at the end of the visit."
    ],
    "it": [
      "Dal 1871, produzione di salsicce secche, prosciutti e salumi tipici della regione dell'Ardèche\r\nLes Estivales : (luglio-agosto: lunedì) : visita guidata delle Salaisons Teyssier, previa iscrizione all'Ufficio del Turismo, degustazione al termine della visita."
    ],
    "fr": [
      "Depuis 1871, fabrication de saucissons secs, jambons et charcuteries typiques du terroir ardéchois. \r\nLes Estivales : (juillet-août : lundi) : visite guidée des Salaisons Teyssier, sur inscription à l'Office de Tourisme, dégustation en fin de visite."
    ],
    "nl": [
      "Sinds 1871, productie van droge worsten, hammen en vleeswaren die typisch zijn voor de Ardèche\r\nLes Estivales : (juli-augustus : maandag) : rondleiding door de Salaisons Teyssier, op inschrijving bij het Office du Tourisme, proeverij aan het eind van de rondleiding."
    ],
    "es": [
      "Desde 1871, producción de embutidos secos, jamones y charcutería típica de la región de Ardèche\r\nLes Estivales : (Julio-Agosto : lunes) : visita guiada a las Salaisons Teyssier, previa inscripción en la Oficina de Turismo, degustación al final de la visita."
    ]
  },
