  "rdfs:comment": {
    "de": [
      "Essen vor Ort oder zum Mitnehmen den ganzen Tag über. Sie können Ihre Einkaufsliste aus dem Laden bei uns lassen, während Sie zu Mittag essen, und wir stellen Ihren Korb zusammen!"
    ],
    "en": [
      "Catering on site or to take away all day long. You can leave your shopping list with us while you have lunch, and we'll prepare your basket for you!"
    ],
    "it": [
      "Catering in loco o da asporto per tutto il giorno. Potete lasciarci la vostra lista della spesa mentre pranzate e noi prepareremo il vostro cestino per voi!"
    ],
    "fr": [
      "Restauration sur place ou à emporter toute la journée. Possibilité de nous laisser votre liste de course du magasin pendant que vous déjeunez, nous préparons votre panier!"
    ],
    "nl": [
      "Catering op locatie of afhaalmaaltijden de hele dag door. Je kunt je boodschappenlijstje bij ons achterlaten terwijl je luncht, en wij maken je mandje voor je klaar!"
    ],
    "es": [
      "Catering in situ o para llevar durante todo el día. Puede dejarnos su lista de la compra mientras almuerza, ¡y le prepararemos su cesta!"
    ]
  },
