  "rdfs:comment": {
    "de": [
      "Süße Pause auf der Kastanienfarm: Entdecken Sie die herzhaften Crêpes garniert vom Chefkoch."
    ],
    "en": [
      "A sweet break at the chestnut farm: come and discover the chef's savoury crêpes."
    ],
    "it": [
      "Una dolce pausa nella fattoria delle castagne: venite a scoprire le crêpes salate dello chef."
    ],
    "fr": [
      "Pause douceur à la ferme du châtaignier : venez découvrir les crêpes garnies salés du chef."
    ],
    "es": [
      "Una pausa dulce en la granja de castañas: venga a descubrir los crêpes salados del chef."
    ],
    "nl": [
      "Een zoete pauze in de kastanjeboerderij: kom en ontdek de hartige crêpes van de chef."
    ]
