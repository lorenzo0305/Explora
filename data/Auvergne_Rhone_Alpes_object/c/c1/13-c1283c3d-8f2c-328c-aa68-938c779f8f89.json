  "rdfs:comment": {
    "de": [
      "Ein Team von Freiwilligen freut sich, Sie in der renovierten Stadtbibliothek neben dem Rathaus begrüßen zu dürfen. Hier können Sie zahlreiche Werke finden: Bücher, Comics, Dokumente und CDs. Außerdem stehen Ihnen zwei Computer zur Verfügung."
    ],
    "en": [
      "A team of volunteers is delighted to welcome you to the renovated Municipal Library, located next to the Town Hall. You'll find a wide range of books, comics, documents and CDs. Two computers are also at your disposal."
    ],
    "it": [
      "Un team di volontari è lieto di darvi il benvenuto nella rinnovata Biblioteca Comunale, situata accanto al Municipio. Troverete una vasta gamma di libri, fumetti, documenti e CD. Sono disponibili anche due computer."
    ],
    "fr": [
      "Une équipe de bénévoles a le plaisir de vous accueillir dans la Bibliothèque Municipale rénovée, située à côté de la Mairie. Vous pourrez trouver de nombreux ouvrages : livres, BD, documents et CD. Deux ordinateurs sont également à votre disposition."
    ],
    "es": [
      "Un equipo de voluntarios está encantado de darle la bienvenida a la renovada Biblioteca Municipal, situada junto al Ayuntamiento. Encontrará una amplia gama de libros, cómics, documentos y CD. También hay dos ordenadores a su disposición."
    ],
    "nl": [
      "Een team van vrijwilligers heet je van harte welkom in de gerenoveerde Gemeentelijke Bibliotheek, gelegen naast het stadhuis. Je vindt er een ruim aanbod aan boeken, strips, documenten en cd's. Er zijn ook twee computers beschikbaar."
    ]
  },
