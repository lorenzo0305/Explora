  "rdfs:comment": {
    "de": [
      "Ein bisschen Gaumenfreude, Freude und Glück in Ihren Geschmacksknospen?\r\n\r\nIhr neues Geschäft mit handgefertigten Pralinen hat gerade in Nyons seine Türen geöffnet.\r\n\r\nKommen Sie vorbei und entdecken Sie die Produkte von Chaloin Chocolats."
    ],
    "en": [
      "A little bit of greed, joy and happiness in your taste buds?\r\n\r\nYour new artisan chocolate boutique has just opened its doors in Nyons.\r\n\r\nCome and discover Chaloin Chocolats products."
    ],
    "it": [
      "Un po' di avidità, gioia e felicità nelle vostre papille gustative?\r\n\r\nLa vostra nuova cioccolateria artigianale ha appena aperto i battenti a Nyons.\r\n\r\nVenite a scoprire i prodotti di Chaloin Chocolats."
    ],
    "fr": [
      "Un peu de gourmandise, de joie et de bonheur dans vos papilles ?\r\n\r\nVotre nouvelle boutique de chocolats artisanaux vient d'ouvrir ses portes à Nyons.\r\n\r\nVenez découvrir les produits de Chaloin Chocolats."
    ],
    "es": [
      "¿Un poco de codicia, alegría y felicidad en tus papilas gustativas?\r\n\r\nSu nueva chocolatería artesanal acaba de abrir sus puertas en Nyons.\r\n\r\nVenga a descubrir los productos de Chaloin Chocolats."
    ],
    "nl": [
      "Een beetje hebzucht, vreugde en geluk in je smaakpapillen?\r\n\r\nJe nieuwe ambachtelijke chocoladewinkel is net geopend in Nyons.\r\n\r\nKom en ontdek de producten van Chaloin Chocolats."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le goût du chocolat"
    ]
  },
