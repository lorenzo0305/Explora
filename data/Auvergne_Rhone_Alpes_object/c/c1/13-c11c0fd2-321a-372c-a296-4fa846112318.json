  "rdfs:comment": {
    "de": [
      "Gute Nachrichten! Mit ihrer sanften und kraftvollen Stimme, ihrer sonnigen Energie und ihrer fesselnden Persönlichkeit fügt die musikalische Entdeckung Helena ihrer Tournee einen weiteren Termin hinzu: Treffen Sie sie am 22. November 2026 in der LDLC Arena in Lyon-Décines."
    ],
    "en": [
      "Great news! With her sweet, powerful voice, sunny energy and endearing personality, musical revelation Helena is adding a new date to her tour: join her on November 22, 2026 at the LDLC Arena in Lyon-Décines."
    ],
    "it": [
      "Una grande notizia! Con la sua voce dolce e potente, la sua energia solare e la sua personalità accattivante, la rivelazione musicale Helena sta aggiungendo una nuova data al suo tour: raggiungetela il 22 novembre 2026 all'Arena LDLC di Lione-Décines."
    ],
    "fr": [
      "Bonne nouvelle ! Avec sa voix douce et puissante, son énergie solaire et sa personnalité attachante, la révélation musicale Helena ajoute une nouvelle date à sa tournée : retrouvez-la le 22 novembre 2026 à la LDLC Arena de Lyon-Décines."
    ],
    "es": [
      "¡Una gran noticia! Con su voz dulce y potente, su energía solar y su personalidad entrañable, la revelación musical Helena añade una nueva fecha a su gira: únete a ella el 22 de noviembre de 2026 en el LDLC Arena de Lyon-Décines."
    ],
    "nl": [
      "Goed nieuws! Met haar zoete, krachtige stem, zonnige energie en innemende persoonlijkheid voegt muzikale revelatie Helena een nieuwe datum toe aan haar tour: kom op 22 november 2026 naar de LDLC Arena in Lyon-Décines."
    ]
  },
