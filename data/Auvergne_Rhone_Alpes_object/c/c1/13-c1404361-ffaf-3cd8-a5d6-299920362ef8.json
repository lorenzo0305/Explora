  "rdfs:comment": {
    "de": [
      "Erleben Sie eine immersive Erfahrung in einem der 5 Escape Games, die Puzzle Animation anbietet. Mitten im historischen Zentrum von Grenoble können Sie in unsere Welten eintauchen, die in der Geschichte der Region verankert sind."
    ],
    "en": [
      "Come and enjoy an immersive experience in one of Puzzle Animation's 5 escape games. Right in the heart of Grenoble's historic center, come and immerse yourself in our worlds rooted in the region's history."
    ],
    "it": [
      "Venite a vivere un'esperienza coinvolgente in uno dei 5 giochi di fuga proposti da Puzzle Animation. Nel cuore del centro storico di Grenoble, venite a immergervi nei nostri mondi radicati nella storia della regione."
    ],
    "fr": [
      "Venez vivre une expérience immersive dans l'un des 5 escape game que propose Puzzle Animation. En plein centre historique de Grenoble, venez vous plonger dans nos univers ancrés dans l’histoire de la région."
    ],
    "es": [
      "Venga y disfrute de una experiencia inmersiva en uno de los 5 juegos de escape que ofrece Puzzle Animation. En pleno centro histórico de Grenoble, venga a sumergirse en nuestros mundos anclados en la historia de la región."
    ],
    "nl": [
      "Kom en beleef een meeslepende ervaring in een van de 5 ontsnappingsspellen van Puzzle Animation. In het historische centrum van Grenoble kun je je onderdompelen in onze werelden die geworteld zijn in de geschiedenis van de regio."
    ]
  },
