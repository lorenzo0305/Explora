  "rdfs:comment": {
    "de": [
      "Geführte Besichtigung für Gruppen. Entdecken Sie die vielen Facetten des Pays de Tronçais und dieses prestigeträchtigen Staatswaldes, der mit dem Label Forêt d'Exception ® ausgezeichnet wurde: Forstwirtschaft, große Eichen, Legenden..."
    ],
    "en": [
      "Guided tours for groups. Come and discover the many facets of the Pays de Tronçais and this prestigious state forest, which has been awarded the Forêt d'Exception ® label: forestry, great oaks, legends..."
    ],
    "it": [
      "Visita guidata per gruppi. Venite a scoprire le molteplici sfaccettature del Pays de Tronçais e di questa prestigiosa foresta nazionale, che ha ottenuto il marchio Forêt d'Exception ®: silvicoltura, grandi querce, leggende..."
    ],
    "fr": [
      "Visite guidée pour les groupes. Venez découvrir les multiples facettes du Pays de Tronçais et de cette forêt domaniale de prestige, labellisée Forêt d'Exception ® : sylviculture, grands chênes, légendes..."
    ],
    "es": [
      "Visita guiada para grupos. Venga a descubrir las múltiples facetas del Pays de Tronçais y de este prestigioso bosque nacional, galardonado con la etiqueta Forêt d'Exception ®: silvicultura, grandes robles, leyendas..."
    ],
    "nl": [
      "Rondleiding voor groepen. Kom en ontdek de vele facetten van het Pays de Tronçais en dit prestigieuze nationale bos, dat het label Forêt d'Exception ® heeft gekregen: bosbouw, grote eiken, legendes..."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite guidée groupe en Forêt Domaniale de Tronçais par l'Office de Tourisme"
    ]
  },
