  "rdfs:comment": {
    "de": [
      "Kalligraphie und Illumination. Texte für alle Anlässe. Arbeit für offizielle Texte: Rathäuser, Kirchen, ... Postkarten. Illumination der Tierkreiszeichen. Jede Idee kann untersucht werden. Pressbook vor Ort und auf der Website einzusehen."
    ],
    "en": [
      "Calligraphy and illumination. Texts for all occasions. Work for official texts : town halls, churches, ... Postcards. Illumination of the signs of the Zodiac. Any idea can be studied. Pressbook to be consulted on the spot and on the website."
    ],
    "it": [
      "Calligrafia e illuminazione. Testi per tutte le occasioni. Lavori per testi ufficiali: municipi, chiese, ... Cartoline. Illuminazione dei segni zodiacali. Ogni idea può essere studiata. Pressbook da consultare in loco e sul sito web."
    ],
    "fr": [
      "Calligraphie et enluminure. textes pour toutes occasions. Travail pour textes officiels : mairies, églises, ... Cartes postales. Enluminure des signes du Zodiaque. Toute idée peut être étudiée. Pressbook à consulter sur place et sur le site Internet."
    ],
    "nl": [
      "Kalligrafie en illuminatie. Teksten voor alle gelegenheden. Werk voor officiële teksten: gemeentehuizen, kerken, ... Ansichtkaarten. Verlichting van de tekens van de dierenriem. Elk idee kan bestudeerd worden. Persboek te raadplegen ter plaatse en op de website."
    ],
    "es": [
      "Caligrafía e iluminación. Textos para todas las ocasiones. Trabajos para textos oficiales: ayuntamientos, iglesias, ... Tarjetas postales. Iluminación de los signos del Zodiaco. Cualquier idea puede ser estudiada. Pressbook para consultar in situ y en el sitio web."
    ]
  },
