  "rdfs:comment": {
    "de": [
      "Das Hotel ist leicht zu erreichen und ideal für einen Wochenendtrip, den nächsten Urlaub oder einen Geschäftsaufenthalt in Lyon. Das B&B HOTEL Lyon Nord empfängt Sie im Nordwesten von Lyon, in Dardilly, einer Gemeinde, die sich durch ihre ruhige Lebensumgebung auszeichnet."
    ],
    "en": [
      "Easy to reach, this hotel is ideal for a weekend, a holiday or a business trip in Lyon. The B&B HOTEL Lyon Nord welcomes you to the north-west of Lyon, in Dardilly, a city characterised by its peaceful surroundings."
    ],
    "it": [
      "Facile da raggiungere, questo hotel è ideale per un weekend, una vacanza o un viaggio d'affari a Lione. Il B&B HOTEL Lyon Nord vi dà il benvenuto a nord-ovest di Lione, a Dardilly, città rinomata per la sua tranquillità."
    ],
    "fr": [
      "Facile d’accès, cet hôtel est idéal pour séjourner à Lyon pour un week-end, des prochaines vacances ou un séjour d'affaires. Le B&B HOTEL Lyon Nord vous accueille au nord-ouest de Lyon, à Dardilly, commune qui se distingue par son cadre de vie paisible."
    ],
    "nl": [
      "Dit gemakkelijk te bereiken hotel is ideaal voor een weekendje weg, een vakantie of een zakenreis in Lyon. B&B HOTEL Lyon Nord heet je welkom in het noordwesten van Lyon, in Dardilly, een stad die bekend staat om zijn rustige omgeving."
    ],
    "es": [
      "De fácil acceso, este hotel es ideal para una escapada de fin de semana, unas vacaciones o un viaje de negocios en Lyon. El B&B HOTEL Lyon Nord le da la bienvenida al noroeste de Lyon, en Dardilly, una ciudad famosa por su entorno tranquilo."
    ]
  },
