  "rdfs:comment": {
    "de": [
      "Le Bac à Traille ist das Bistro, das Masashi Ijichi, Chefkoch des Restaurants La Cachette*, 2020 eröffnete, bevor er 2021 seinen Bib Gourmand erhielt. Hier finden Sie eine großzügige Küche voller Aromen, die sich auf saisonale und regionale Produkte konzentriert."
    ],
    "en": [
      "Le Bac à Traille is the bistro opened by Masashi Ijichi, chef of La Cachette* restaurant in 2020, before earning his Bib Gourmand in 2021. Here you'll find generous, flavorful cuisine focused on seasonal and local produce."
    ],
    "it": [
      "Le Bac à Traille è il bistrot aperto da Masashi Ijichi, chef del ristorante La Cachette* nel 2020, prima di ottenere il Bib Gourmand nel 2021. Troverete una cucina generosa, ricca di sapori e incentrata su prodotti stagionali e regionali."
    ],
    "fr": [
      "Le Bac à Traille est le bistrot ouvert par Masashi Ijichi, chef du restaurant La Cachette* en 2020, avant d'obtenir son Bib Gourmand en 2021. Vous y trouverez une cuisine généreuse, pleine de saveurs et centrée sur les produits de saison et de la région."
    ],
    "nl": [
      "Le Bac à Traille is de bistro die in 2020 werd geopend door Masashi Ijichi, chef-kok van het restaurant La Cachette*, voor het behalen van zijn Bib Gourmand in 2021. Hier vind je een gulle, smaakvolle keuken met seizoensgebonden en lokale producten."
    ],
    "es": [
      "Le Bac à Traille es el bistró abierto por Masashi Ijichi, chef del restaurante La Cachette* en 2020, antes de obtener su Bib Gourmand en 2021. Encontrará una cocina generosa, llena de sabores y centrada en los productos de temporada y regionales."
    ]
  },
