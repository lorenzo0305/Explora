  "rdfs:comment": {
    "de": [
      "Traditionelle, im Holzofen gebackene Pizzas zum Mitnehmen. Mit der Hand geformt. Teig und Tomatensoße werden vor Ort aus frischen Produkten hergestellt. Etwa 20 originelle Pizzen zum Mitnehmen oder zum Verzehr vor Ort. Getränke und hausgemachte Desserts."
    ],
    "en": [
      "Traditional pizzas baked in a wood-fired oven and home-made. Pasta and tomato sauce with fresh products. About 10 Pizzas to take away or ready to eat on high tables installed on site. Drink et homemade desserts"
    ],
    "it": [
      "Pizze tradizionali cotte a legna da portare via. Realizzato a mano. Impasto e salsa di pomodoro fatti sul posto con prodotti freschi. Una ventina di pizze originali da portare via o da gustare sul posto. Bevande e dessert fatti in casa."
    ],
    "fr": [
      "Pizzas traditionnelles cuites au feu de bois à emporter. Façonnées à la main. Pâte et sauce tomate élaborées sur place avec produits frais. Une vingtaine de pizzas originales à emporter ou à déguster sur place. Boissons et desserts maison."
    ],
    "nl": [
      "Traditionele houtgestookte pizza's om mee te nemen. Handgemaakt. Deeg en tomatensaus ter plaatse gemaakt met verse producten. Een twintigtal originele pizza's om mee te nemen of ter plaatse te proeven. Zelfgemaakte drankjes en desserts."
    ],
    "es": [
      "Pizzas tradicionales de leña para llevar. Hecho a mano. Masa y salsa de tomate hechas al momento con productos frescos. Una veintena de pizzas originales para llevar o degustar en el momento. Bebidas y postres caseros."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Pizzeria \"Somewhere Else\""
    ]
  },
