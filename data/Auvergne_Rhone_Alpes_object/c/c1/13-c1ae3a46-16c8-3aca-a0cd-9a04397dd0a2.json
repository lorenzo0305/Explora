  "rdfs:comment": {
    "de": [
      "Reisebüro für Urlaub in den Bergen, Fuß- und Schneeschuhwanderungen, nordische Skiwanderungen, Radtouren oder vielfältiges Sportprogramm (Kanufahren, Klettersteig, Rafting, Seekajak...) ... Über 400 Aufenthaltsorte in Europa... Unternehmungen in den Bergen möglich."
    ],
    "en": [
      "Travel agency specialising in mountain holidays and activities including hiking, snowshoeing, cross-country skiing, mountain-biking and multi-sports (canyoning, via ferrata, rafting, sea kayaking).  Inbound agency for mountain activities."
    ],
    "it": [
      "Agenzia di viaggi specializzata in escursioni a piedi, con le racchette da neve, in bicicletta, nello sci nordico, nello sci alpino o in attività multiattività (canyoning, via ferrata, rafting, kayak da mare). Ricettivo per le attività in montagna."
    ],
    "fr": [
      "Agence de Voyages Spécialiste de la Randonnée à pied, à raquettes, à vélo, ski de randonnée nordique, ski de randonnée alpine ou multiactivités (canyoning, via ferrata, rafting, kayak de mer). Réceptif pour activités montagne."
    ],
    "nl": [
      "Reisbureau gespecialiseerd in wandelen, sneeuwschoenwandelen, fietsen, Noordse skitochten, alpineskitochten of multi-activiteiten (canyoning, via ferrata, raften, zeekajakken). Ontvankelijk voor activiteiten in de bergen."
    ],
    "es": [
      "Agencia de viajes especializada en senderismo, raquetas de nieve, ciclismo, esquí nórdico de travesía, esquí alpino de travesía o actividades multiaventura (barranquismo, vía ferrata, rafting, kayak de mar). Receptivo para actividades de montaña."
    ]
  },
