  "rdfs:comment": {
    "de": [
      "Nehmen Sie an einer faszinierenden Führung durch den Lorient-Park teil, bei der Sie die Vielfalt der Baumarten, die den Park säumen, kennen lernen."
    ],
    "en": [
      "Join us on a fascinating guided tour of Lorient Park, where you'll discover the diversity of tree species that line the park."
    ],
    "it": [
      "Partecipate a un'affascinante visita guidata del Parco di Lorient, dove scoprirete la diversità delle specie arboree che popolano il parco."
    ],
    "fr": [
      "Participez à une visite guidée fascinante du parc de Lorient où vous découvrirez la diversité des espèces d'arbres qui le jalonnent."
    ],
    "es": [
      "Participe en una fascinante visita guiada por el Parque de Lorient, donde descubrirá la diversidad de especies arbóreas que lo pueblan."
    ],
    "nl": [
      "Neem deel aan een fascinerende rondleiding door het Lorient Park, waar je de diversiteit van de boomsoorten in het park ontdekt."
    ]
