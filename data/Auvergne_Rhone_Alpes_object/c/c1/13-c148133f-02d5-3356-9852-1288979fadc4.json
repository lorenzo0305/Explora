  "rdfs:comment": {
    "de": [
      "Machen Sie einen Spaziergang an den Ufern der Teiche und Tümpel der Zone Humide de Bachassier. Sie ist auch als Zone Naturelle d'Intérêt Ecologique Faunistique et Floristique klassifiziert und das LPO führt hier regelmäßig Arteninventuren durch."
    ],
    "en": [
      "Come and stroll along the banks of the ponds and puddles of the Bachassier Wetland. It is also classified as a Natural Zone of Ecological, Faunistic and Floristic Interest, and species inventories are regularly carried out by the LPO."
    ],
    "it": [
      "Venite a passeggiare sulle rive degli stagni e delle piscine della zona umida di Bachassier. È inoltre classificata come Zona Naturale di Interesse Ecologico, Faunistico e Floristico e vi si svolgono regolarmente inventari di specie da parte della LPO."
    ],
    "fr": [
      "Venez vous balader aux bords des étangs et mares de la Zone Humide de Bachassier. Elle est également classées Zone Naturelle d’Intérêt Ecologique Faunistique et Floristique et des inventaires d'espèce y sont régulièrement menés par la LPO."
    ],
    "es": [
      "Venga a dar un paseo por los bordes de los estanques y charcas del Humedal de Bachassier. También está clasificada como Zona Natural de Interés Ecológico, Faunístico y Florístico y en ella se realizan periódicamente inventarios de especies por parte de la LPO."
    ],
    "nl": [
      "Kom wandelen langs de oevers van de vijvers en plassen van het Bachassiermoeras. Het is ook geklasseerd als Natuurgebied van Ecologisch, Faunistisch en Floristisch Belang en er worden regelmatig soorteninventarisaties uitgevoerd door de LPO."
    ]
  },
  "rdfs:label": {
    "fr": [
      "L’Espace Naturel Sensible des mares de Bachassier"
    ]
  },
