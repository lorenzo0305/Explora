      "dc:description": {
        "de": [
          "Das Ensemble Il Buranello ehrt die Muse der lyrischen Poesie in einem musikalischen Rundgang, um die Galerie der Zeit auf andere Weise (wieder) zu entdecken."
        ],
        "en": [
          "The Ensemble Il Buranello pays tribute to the Muse of lyric poetry in a musical journey to (re)discover the Galerie du temps in a whole new way."
        ],
        "it": [
          "L'Ensemble Il Buranello rende omaggio alla Musa della poesia lirica in un viaggio musicale che offre un nuovo modo di (ri)scoprire la Galerie du Temps."
        ],
        "fr": [
          "L’Ensemble Il Buranello rend hommage à la Muse de la poésie lyrique dans un parcours musical pour (re)découvrir autrement la Galerie du temps."
        ],
        "nl": [
          "Het Ensemble Il Buranello brengt een ode aan de Muze van de lyrische poëzie in een muzikale reis die een nieuwe manier biedt om de Galerie du Temps te (her)ontdekken."
        ],
        "es": [
          "El Ensemble Il Buranello rinde homenaje a la Musa de la poesía lírica en un viaje musical que ofrece una nueva forma de (re)descubrir la Galerie du Temps."
        ]
      },
