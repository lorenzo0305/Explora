  "rdfs:comment": {
    "de": [
      "Die Auberge de Mazayes wurde in einem authentischen Bauernhaus aus Steinen der Region eingerichtet und hat es geschafft, modernen Komfort mit der Treue zum Geist des Ortes zu verbinden. 15 Zimmer (Doppel-, Dreibett- und Familienzimmer)."
    ],
    "en": [
      "Housed in an authentic stone farmhouse, the Auberge de Mazayes combines modern comfort with the spirit of the place. 15 rooms (double, triple and family)."
    ],
    "it": [
      "Ospitato in un'autentica casa colonica in pietra, l'Auberge de Mazayes unisce il comfort moderno allo spirito del luogo. 15 camere (doppie, triple e familiari)."
    ],
    "fr": [
      "Aménagée dans une authentique ferme en pierres du pays, l'Auberge de Mazayes a su concilier confort moderne et fidélité à l'esprit des lieux. 15 chambres (doubles, triples et familiales)."
    ],
    "es": [
      "Ubicado en una auténtica granja de piedra, el Auberge de Mazayes combina el confort moderno con el espíritu del lugar. 15 habitaciones (dobles, triples y familiares)."
    ],
    "nl": [
      "De Auberge de Mazayes is gevestigd in een authentieke stenen boerderij en combineert modern comfort met de geest van de plaats. 15 kamers (tweepersoons-, driepersoons- en familiekamers)."
    ]
  },
