  "rdfs:comment": {
    "de": [
      "Um eine Strategie zur Aufwertung und Förderung des Departements und seiner Gebiete umzusetzen, hat der Departementsrat die Agentur für die Attraktivität des Bourbonnais gegründet."
    ],
    "en": [
      "In order to implement a strategy for the development and promotion of the department and its territories, the Departmental Council has created the Bourbonnais Attractiveness Agency."
    ],
    "it": [
      "Per attuare una strategia di sviluppo e promozione del dipartimento e dei suoi territori, il Consiglio dipartimentale ha creato l'Agenzia per l'attrattività del Bourbonnais."
    ],
    "fr": [
      "Pour mettre en œuvre une stratégie de valorisation et de promotion du département et de ses territoires, le Conseil départemental a créé l’Agence d’Attractivité du Bourbonnais."
    ],
    "es": [
      "Para poner en marcha una estrategia de desarrollo y promoción del departamento y sus territorios, el Consejo Departamental ha creado la Agencia de Atracción de Bourbonnais."
    ],
    "nl": [
      "Met het oog op de uitvoering van een strategie om het departement en zijn gebieden te versterken en te promoten, heeft de departementale raad het agentschap voor de aantrekkingskracht van Bourbonnais opgericht."
    ]
  },
