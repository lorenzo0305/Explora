  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/97496a73-aedb-321b-b3c8-a31dc8f8437f",
      "dc:description": {
        "de": [
          "In Merlimont-Plage bietet die Poissonnerie Le Pêcheur seit über 11 Jahren täglich frischen Fisch, Meeresfrüchteplatten, Zubereitungen, die von einer treuen Kundschaft geschätzt werden."
        ],
        "en": [
          "In Merlimont-Plage for over 11 years, Poissonnerie Le Pêcheur offers fresh fish every day, as well as a seafood platter, which is appreciated by a loyal clientele."
        ],
        "it": [
          "Presente a Merlimont-Plage da oltre 11 anni, la Poissonnerie Le Pêcheur offre ogni giorno pesce fresco e piatti di pesce, tutti apprezzati da una clientela affezionata."
        ],
        "fr": [
          "À Merlimont-Plage depuis plus de 11 ans, la Poissonnerie Le Pêcheur propose du poisson frais chaque jour, plateau de fruits de mer, préparations apprécié par une clientèle fidèle."
        ],
        "nl": [
          "Poissonnerie Le Pêcheur is al meer dan 11 jaar gevestigd in Merlimont-Plage en biedt elke dag verse vis en zeevruchtenschotels, die allemaal worden gewaardeerd door een trouwe klantenkring."
        ],
        "es": [
          "En Merlimont-Plage desde hace más de 11 años, la Poissonnerie Le Pêcheur ofrece pescado fresco todos los días, así como platos de marisco, todos ellos apreciados por una clientela fiel."
        ]
      },
