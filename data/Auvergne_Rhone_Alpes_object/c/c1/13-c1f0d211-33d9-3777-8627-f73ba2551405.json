  "rdfs:comment": {
    "de": [
      "Zimmer mit allem Komfort und Bergblick. Ideale Lage im Winter gegenüber den Pisten und im Sommer am Fuße des prestigeträchtigen Col du Mont-Cenis. Gastronomie zu jeder Tageszeit, gastronomische und familiäre Küche, regionale Spezialitäten."
    ],
    "en": [
      "Comfortable rooms with mountain views. Ideally located in winter facing the slopes and in summer at the foot of the prestigious Col du Mont-Cenis. Catering at any time, gourmet and family cuisine, regional specialties."
    ],
    "it": [
      "Camere confortevoli con vista sulle montagne. Situato in posizione ideale in inverno di fronte alle piste e in estate ai piedi del prestigioso Col du Mont-Cenis. Ristorante a qualsiasi ora, cucina gastronomica e familiare, specialità regionali."
    ],
    "fr": [
      "Chambres tout confort avec vue montagne. Idéalement situé l'hiver face aux pistes et l'été au pied du prestigieux Col du Mont-Cenis. Restauration à toute heure, cuisine gastronomique et familiale, spécialités régionales."
    ],
    "es": [
      "Habitaciones confortables con vistas a la montaña. Idealmente situado en invierno frente a las pistas y en verano al pie del prestigioso Col du Mont-Cenis. Restaurante a cualquier hora, cocina gastronómica y familiar, especialidades regionales."
    ],
    "nl": [
      "Comfortabele kamers met uitzicht op de bergen. Ideaal gelegen in de winter met uitzicht op de hellingen en in de zomer aan de voet van de prestigieuze Col du Mont-Cenis. Catering op elk moment, gastronomische en familiale keuken, regionale specialiteiten."
    ]
  },
