  "rdfs:comment": {
    "de": [
      "Takamaka, Ihr Büro für Reiseführer und Outdoor-Sport, befindet sich im Stadtzentrum von Clermont-Ferrand, am Fuße der Kathedrale! Rennradverleih , VTTAE, VTC auch im Laden erhältlich."
    ],
    "en": [
      "Takamaka, your outdoor sports and guide office, located in downtown Clermont-Ferrand, at the foot of the cathedral! Rental of racing bikes, VTTAE, VTC also available in store."
    ],
    "it": [
      "Takamaka, il vostro ufficio guida, sport all'aria aperta, situato nel centro di Clermont-Ferrand, ai piedi della cattedrale! Noleggio di biciclette da corsa, VTTAE, VTC disponibile anche in negozio."
    ],
    "fr": [
      "Takamaka, votre bureau des guides, des sports outdoor, installé dans le centre ville de Clermont-Ferrand, au pied de la cathédrale ! Location de vélo de course , VTTAE, VTC également disponible en magasin."
    ],
    "nl": [
      "Takamaka, uw gidsenbureau, buitensporten, gelegen in het centrum van Clermont-Ferrand, aan de voet van de kathedraal! Verhuur van racefietsen, VTTAE, VTC ook beschikbaar in de winkel."
    ],
    "es": [
      "Takamaka, su oficina de guías, deportes al aire libre, situada en el centro de la ciudad de Clermont-Ferrand, ¡a los pies de la catedral! Alquiler de bicicletas de carreras, VTTAE, VTC también disponible en la tienda."
    ]
  },
