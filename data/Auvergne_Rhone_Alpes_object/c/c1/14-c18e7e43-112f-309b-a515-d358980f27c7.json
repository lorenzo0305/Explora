  "rdfs:comment": {
    "de": [
      "Marie vibriert wie die Schnur eines Drachens, sie zündet die Sterne wieder an, sie ist niemandem ähnlich."
    ],
    "en": [
      "Marie vibrates like a kite string, she lights up the stars, she looks like nobody else."
    ],
    "it": [
      "Marie vibra come la corda di un aquilone, illumina le stelle, non assomiglia a nessun altro."
    ],
    "fr": [
      "Marie vibre comme une ficelle de cerf-volant, elle rallume les étoiles, elle ne ressemble à personne."
    ],
    "es": [
      "Marie vibra como la cuerda de una cometa, ilumina las estrellas, no se parece a nadie."
    ],
    "nl": [
      "Marie trilt als een vliegertouw, ze laat de sterren oplichten, ze ziet eruit als niemand anders."
    ]
