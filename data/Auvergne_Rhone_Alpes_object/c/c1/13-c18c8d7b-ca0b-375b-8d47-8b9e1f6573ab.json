  "rdfs:comment": {
    "de": [
      "Im Zentrum des Skigebiets gelegen ist das Gergovia ein Familienbetrieb mit einer Terrasse, einem Aufenthaltsraum, einem Spielzimmer und einem Fitnessbereich mit Sauna, Whirlpool und Fitnessraum."
    ],
    "en": [
      "The hotel is located in the centre of the ski resort \r\nInternet access is free of charge throughout the hotel. \r\nSophie is at your disposal to prepare your excursion, she advises you: visits, walks, hikes to do."
    ],
    "it": [
      "Situato proprio nel centro della stazione sciistica, il Gergovia è una struttura a conduzione familiare con terrazza, lounge, sala giochi e area fitness con sauna, vasca idromassaggio e palestra."
    ],
    "fr": [
      "Situé en plein centre de la station de ski le Gergovia est un établissement familial doté d'une terrasse, d'un salon, d'une salle de jeu et d'un espace forme avec sauna, bain bouillonnant et salle de sport."
    ],
    "es": [
      "Situado en pleno centro de la estación de esquí, el Gergovia es un establecimiento de gestión familiar con terraza, salón, sala de juegos y zona de fitness con sauna, bañera de hidromasaje y gimnasio."
    ],
    "nl": [
      "Het Gergovia ligt midden in het skigebied en is een familiebedrijf met een terras, lounge, speelkamer en fitnessruimte met sauna, bubbelbad en fitnessruimte."
    ]
  },
