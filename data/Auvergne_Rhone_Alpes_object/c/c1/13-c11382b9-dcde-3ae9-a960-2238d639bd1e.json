  "rdfs:comment": {
    "de": [
      "Genießen Sie eine großzügige lokale Küche in einer herzlichen Atmosphäre. Traditionelle Gerichte aus Royans, neu interpretierte Burger und Ravioli-Gratins erwarten Sie!"
    ],
    "en": [
      "Enjoy generous local cuisine in a warm atmosphere. Traditional Royans dishes, revisited burgers and ravioli gratins await you!"
    ],
    "it": [
      "Gustate la generosa cucina locale in un'atmosfera calda e accogliente. Piatti tradizionali di Royans, hamburger rivisitati e ravioli gratinati vi aspettano!"
    ],
    "fr": [
      "Savourez une cuisine locale généreuse dans une ambiance chaleureuse. Plats traditionnels du Royans, burgers revisités et gratins de ravioles vous attendent !"
    ],
    "nl": [
      "Geniet van royale lokale gerechten in een warme en vriendelijke sfeer. Traditionele Royans gerechten, vernieuwde hamburgers en ravioli gratins wachten op je!"
    ],
    "es": [
      "Disfrute de la generosa cocina local en un ambiente cálido y acogedor. Le esperan platos tradicionales de Royans, hamburguesas revisitadas y raviolis gratinados"
    ]
  },
