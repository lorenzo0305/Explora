  "rdfs:comment": {
    "de": [
      "La Crémaillère liegt zwischen dem Lac de Montriond und Avoriaz in einem kleinen Dorf, in dem die Ziegen frei herumlaufen. Es ist eine ehemalige Almhütte, die in ein Höhenrestaurant (1470m) umgewandelt wurde."
    ],
    "en": [
      "Located between Montriond Lake and Avoriaz, in a small village where goats roam freely. La Crémaillère is an old mountain chalet that has been restored and converted to a high-altitude restaurant (1470 m)."
    ],
    "it": [
      "Situato tra il lago di Montriond e Avoriaz, in un piccolo villaggio dove le capre vagano liberamente, La Crémaillère è un vecchio chalet di montagna trasformato in un ristorante d'alta quota (1470 m)."
    ],
    "fr": [
      "Situé entre le lac de Montriond et Avoriaz, dans un petit village où les chèvres se promènent en liberté, La Crémaillère est un ancien chalet d'alpage transformé en restaurant d'altitude (1470m)."
    ],
    "es": [
      "Situado entre el lago de Montriond y Avoriaz, en un pequeño pueblo donde las cabras vagan libremente, La Crémaillère es un antiguo chalet de montaña transformado en un restaurante de altura (1470 m)."
    ],
    "nl": [
      "La Crémaillère, tussen het Lac de Montriond en Avoriaz, in een dorpje waar de geiten vrij rondlopen, is een oude alpenweidechalet omgebouwd tot bergrestaurant (1470 m)."
    ]
  },
