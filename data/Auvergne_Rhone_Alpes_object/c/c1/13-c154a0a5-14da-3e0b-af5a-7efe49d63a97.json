  "rdfs:comment": {
    "de": [
      "Öffnen Sie die Türen des B4 und entdecken Sie: eine moderne und gemütliche Bowlingbahn, ein Gourmet-Burger-Restaurant und eine Bierbar. Salate und Grillgerichte gehören ebenfalls zu Ihrer Speisenauswahl."
    ],
    "en": [
      "Push open the doors of B4 to discover: a modern and welcoming bowling alley, a gourmet burger restaurant and a beer bar. Salads and grilled meats are also on the menu."
    ],
    "it": [
      "Aprite le porte del B4 per scoprire una pista da bowling moderna e accogliente, un ristorante di hamburger gourmet e una birreria. Il menu comprende anche insalate e carni alla griglia."
    ],
    "fr": [
      "Poussez les portes du B4 pour y découvrir : un bowling moderne et chaleureux, un restaurant de burgers gourmets et un bar à bières. Salades et grillades font également partie de votre sélection de plats."
    ],
    "nl": [
      "Duw de deuren van B4 open en ontdek een moderne en gezellige bowlingbaan, een hamburgerrestaurant voor fijnproevers en een bierbar. Salades en gegrild vlees staan ook op het menu."
    ],
    "es": [
      "Abre las puertas de B4 y descubre una bolera moderna y acogedora, una hamburguesería gourmet y una cervecería. Las ensaladas y las carnes a la parrilla también están en el menú."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Bowling le B4"
    ]
  },
