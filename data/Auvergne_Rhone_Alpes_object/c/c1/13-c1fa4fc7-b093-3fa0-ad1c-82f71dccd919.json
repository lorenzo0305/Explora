  "rdfs:comment": {
    "de": [
      "Große Herbarien, 50 000 Gesteinsproben, Fossilien und Mineralien. Nicht zu vergessen die Pascaline, eine von Blaise Pascal erfundene Rechenmaschine."
    ],
    "en": [
      "Monumental herbarium collection, 50,000 samples of rocks, fossils and minerals and La Pascaline: a calculating machine invented by Blaise Pascal."
    ],
    "it": [
      "Nella dimora in pietra di Henri Lecoq, ammirate il patrimonio naturale della regione e le ricche collezioni del museo."
    ],
    "fr": [
      "Dans l’hôtel particulier en pierre de Volvic d’Henri Lecoq, admirez le patrimoine naturel de la région et les riches collections du muséum."
    ],
    "es": [
      "herbarios monumentales, 50 000 muestras de rocas, fósiles y minerales. Y la Pascaline: la calculadora inventada por Blaise Pascal."
    ],
    "nl": [
      "Bijzondere, historische, gedroogde planten- en bloemenverzamelingen (herbaria), maar liefst 50.000 soorten stenen, fossielen en mineralen. En ook uniek : de allereerste rekenmachine ter wereld - de Pascaline -, uitgevonden door Blaise Pascal, één van Frankrijks grootste geleerden, die in Clermont-Ferrand werd geboren."
    ]
  },
