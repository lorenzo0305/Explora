  "rdfs:comment": {
    "de": [
      "Entdecken Sie Lyon mit einer Flotte hochwertiger Hollandräder, die eine bequeme und angenehme Fahrt auf jeder Etappe garantieren. Dieses Abenteuer durch Lyon verspricht ein unvergessliches Erlebnis zu werden, voller Geschichte und atemberaubender Ausblicke."
    ],
    "en": [
      "Discover Lyon with a fleet of quality Dutch bikes, guaranteeing a comfortable and enjoyable ride every step of the way. This adventure through Lyon promises to be an unforgettable experience, filled with history and breathtaking views."
    ],
    "it": [
      "Scoprite Lione con una flotta di biciclette olandesi di qualità, che vi garantiranno un viaggio confortevole e piacevole a ogni passo. Questa avventura attraverso Lione promette di essere un'esperienza indimenticabile, ricca di storia e di panorami mozzafiato."
    ],
    "fr": [
      "Découvrez Lyon avec une flotte de vélos hollandais de qualité, garantissant une balade confortable et agréable à chaque étape. Cette aventure à travers Lyon promet d’être une expérience inoubliable, remplie d’histoire et de vues à couper le souffle."
    ],
    "nl": [
      "Ontdek Lyon met een vloot van Nederlandse kwaliteitsfietsen, die garant staan voor een comfortabele en plezierige rit. Dit avontuur door Lyon belooft een onvergetelijke ervaring te worden, vol geschiedenis en adembenemende uitzichten."
    ],
    "es": [
      "Descubra Lyon con una flota de bicicletas holandesas de calidad, que garantizan un viaje cómodo y agradable a cada paso del camino. Esta aventura por Lyon promete ser una experiencia inolvidable, llena de historia y vistas impresionantes."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite des Incontournables de Lyon sur un confortable vélo Hollandais"
    ]
  },
