  "rdfs:comment": {
    "de": [
      "Tritt in einem riesigen Mario Kart-Turnier gegen andere an! Erreiche die Spitze der Rangliste, um in das Team deiner Einrichtung aufgenommen zu werden und am großen Finale teilzunehmen."
    ],
    "en": [
      "Come and compete in a giant Mario Kart tournament! Climb to the top of the leaderboard to join your structure?s team and take part in the grand final."
    ],
    "it": [
      "Vieni a misurarti con gli altri in un gigantesco torneo di Mario Kart! Raggiungi la vetta della classifica per unirti alla tua squadra e partecipare alla grande finale."
    ],
    "fr": [
      "Viens te mesurer aux autres dans un tournoi Mario Kart géant ! Hisse toi au sommet du classement pour intégrer l’équipe de ta structure et participer à la grande finale."
    ],
    "es": [
      "¡Ven y mídete con los demás en un torneo gigante de Mario Kart! Sube a lo más alto de la clasificación para unirte a tu equipo y participar en la gran final."
    ],
    "nl": [
      "Kom en meet jezelf met de anderen in een gigantisch Mario Kart-toernooi! Klim naar de top van het klassement om je aan te sluiten bij je team en deel te nemen aan de grote finale."
    ]
  },
  "rdfs:label": {
