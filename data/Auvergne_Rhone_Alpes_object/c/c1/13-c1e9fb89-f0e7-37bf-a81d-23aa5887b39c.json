  "rdfs:comment": {
    "de": [
      "Casatoto empfängt Sie in einer gemütlichen Umgebung zwischen Terrasse, Garten und einem gemütlichen Saal. Hausgemachte Küche mit frischen Produkten, lokalen Aromen, Pizzen, Salaten und Fleischgerichten. Eine Gourmet-Pause, die Authentizität, Leidenschaft und Gastfreundschaft vereint."
    ],
    "en": [
      "Casatoto welcomes you to a warm setting with terrace, garden and cosy dining room. Home cooking with fresh produce, local flavors, pizzas, salads and meats. A gourmet interlude combining authenticity, passion and conviviality."
    ],
    "it": [
      "Il Casatoto vi accoglie nella sua accogliente terrazza, nel giardino e nella sala da pranzo. Cucina casalinga con prodotti freschi, sapori locali, pizze, insalate e carni. Una parentesi gastronomica che unisce autenticità, passione e convivialità."
    ],
    "fr": [
      "Casatoto vous accueille dans un cadre chaleureux entre terrasse, jardin et salle cosy. Cuisine maison à base de produits frais, saveurs locales, pizzas, salades et viandes. Une parenthèse gourmande alliant authenticité, passion et convivialité."
    ],
    "es": [
      "Casatoto le da la bienvenida en su acogedora terraza, jardín y comedor. Cocina casera con productos frescos, sabores locales, pizzas, ensaladas y carnes. Un interludio gastronómico que combina autenticidad, pasión y cordialidad."
    ],
    "nl": [
      "Casatoto heet je welkom op het gezellige terras, in de tuin en in de eetzaal. Huisgemaakte gerechten met verse producten, lokale smaken, pizza's, salades en vlees. Een gastronomisch intermezzo dat authenticiteit, passie en gezelligheid combineert."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Bistrot pizzeria café Casatoto"
    ]
  },
