  "rdfs:comment": {
    "de": [
      "Eine reine Waldstrecke, die Sie begeistern wird\r\ndie Liebhaber des Unterholzes. Eine Note eines Baches veredelt diese Reise ins Land der Bäume."
    ],
    "en": [
      "An entirely forested circuit that will delight\r\nundergrowth lovers. A hint of a stream completes this journey through the land of trees."
    ],
    "it": [
      "Un percorso interamente boschivo che farà la gioia degli\r\ngli amanti del sottobosco. Un accenno di ruscello completa questo viaggio nella terra degli alberi."
    ],
    "fr": [
      "Un circuit entièrement forestier qui ravira\r\nles amoureux des sous-bois. Une note de ruisseau agrémente ce voyage au pays des arbres."
    ],
    "es": [
      "Un sendero totalmente arbolado que hará las delicias\r\nlos amantes de la maleza. Una pizca de arroyo completa este recorrido por el país de los árboles."
    ],
    "nl": [
      "Een volledig bospad dat liefhebbers van\r\nliefhebbers van kreupelhout. Een beekje maakt deze tocht door het land van de bomen compleet."
    ]
  },
