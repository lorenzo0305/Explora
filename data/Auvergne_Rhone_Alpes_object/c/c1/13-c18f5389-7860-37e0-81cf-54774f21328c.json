  "rdfs:comment": {
    "de": [
      "Besichtigung des Weinguts und des Weinkellers mit Erläuterungen zum Anbau und zur Weinherstellung. Romanische Kapelle aus dem 12. Jahrhundert. Jahrhundert. Kostenlose Verkostung. Mâchon, auf Reservierung."
    ],
    "en": [
      "Overlooked by its 12th century Romanesque chapel, the estate is a reminder of gentle living in age-old residences in the midst of the vines. While respecting the old stone and woodwork, inside has been made comfortable for modern living."
    ],
    "it": [
      "Visita della tenuta e della tinaia con spiegazioni sulla coltivazione e la vinificazione. Cappella romanica del XII secolo. Degustazione gratuita di vini. Mâchon, su prenotazione."
    ],
    "fr": [
      "Visite du domaine et du cuvage avec explications sur la culture, la vinification. Chapelle romane du 12è siècle. Dégustation gratuite. Mâchon, sur réservation."
    ],
    "es": [
      "Visita a la finca y a la bodega con explicaciones sobre el cultivo y la vinificación. Capilla románica del siglo XII. Cata de vinos gratuita. Mâchon, en la reserva."
    ],
    "nl": [
      "Bezoek aan het landgoed en de wijnmakerij met uitleg over de teelt en de vinificatie. Romaanse kapel uit de 12e eeuw. Gratis wijnproeverij. Mâchon, onder voorbehoud."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Domaine de La Chapelle de Vatre"
    ]
  },
