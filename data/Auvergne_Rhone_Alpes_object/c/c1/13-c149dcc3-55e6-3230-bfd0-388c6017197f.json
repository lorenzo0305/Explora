  "rdfs:comment": {
    "de": [
      "Bar in der Weinstube. Flavien ist Weinhändler und möchte seine Liebe zum Wein mit anderen teilen. Er bietet Verkostungen und den Kauf von lokalen Weinen und Bieren an."
    ],
    "en": [
      "Flavien is a cellar master and wishes to share his passion for wine. He offers tastings and wines' and local beer' sales."
    ],
    "it": [
      "Enoteca. Flavien è un commerciante di vini che vuole condividere il suo amore per il vino. Offre degustazioni e acquisti di vini e birre locali."
    ],
    "fr": [
      "Bar à vins. Flavien est caviste et souhaite partager son amour du vin. Il propose des dégustations et de l'achat de vins et bières locales."
    ],
    "nl": [
      "Wijnbar. Flavien is een wijnhandelaar die zijn liefde voor wijn wil delen. Hij biedt proeverijen en aankopen van lokale wijnen en bieren."
    ],
    "es": [
      "Bar de vinos. Flavien es un comerciante de vinos que quiere compartir su amor por el vino. Ofrece catas y compras de vinos y cervezas locales."
    ]
  },
  "rdfs:label": {
