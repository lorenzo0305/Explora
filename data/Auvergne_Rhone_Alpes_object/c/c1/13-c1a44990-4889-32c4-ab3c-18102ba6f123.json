  "rdfs:comment": {
    "de": [
      "Dieses offizielle Symphoniekonzert bietet einen tiefen Einblick in das Herz von Azeroth und lässt die Höhepunkte des legendären Videospiels mit seinen ikonischen Kompositionen wieder aufleben."
    ],
    "en": [
      "This official symphony concert offers an immersive plunge into the heart of Azeroth, bringing to life the highlights of this legendary video game through its iconic compositions."
    ],
    "it": [
      "Questo concerto sinfonico ufficiale offre un viaggio coinvolgente nel cuore di Azeroth, facendo rivivere i momenti salienti di questo leggendario videogioco attraverso le sue composizioni iconiche."
    ],
    "fr": [
      "Ce concert symphonique officiel propose une plongée immersive au cœur d'Azeroth, faisant revivre les moments forts de ce jeu vidéo légendaire grâce à ses compositions emblématiques."
    ],
    "es": [
      "Este concierto sinfónico oficial ofrece un viaje inmersivo al corazón de Azeroth, dando vida a los mejores momentos de este legendario videojuego a través de sus composiciones icónicas."
    ],
    "nl": [
      "Dit officiële symfonieconcert biedt een meeslepende reis naar het hart van Azeroth en brengt de hoogtepunten van deze legendarische videogame tot leven via de iconische composities."
    ]
  },
