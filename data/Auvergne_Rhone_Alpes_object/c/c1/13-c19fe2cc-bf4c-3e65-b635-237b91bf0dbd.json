  "rdfs:comment": {
    "de": [
      "Der viereckige Turm aus dem 13. Jahrhundert war ein Wachraum mit einem großen gewölbten Raum und einer Treppe in der Wand."
    ],
    "en": [
      "Its 13th-century quadrangular tower was a guardroom with a large vaulted room and a staircase in the wall."
    ],
    "it": [
      "La sua torre quadrangolare, risalente al XIII secolo, era una sala di guardia con un'ampia sala a volta e una scala nel muro."
    ],
    "fr": [
      "Sa tour quadrangulaire datant du XIII ème siècle était une salle de garde avec une grande pièce voûtée et un escalier dans le mur."
    ],
    "es": [
      "Su torre cuadrangular del siglo XIII era una sala de guardia con una gran sala abovedada y una escalera en la pared."
    ],
    "nl": [
      "De 13e-eeuwse vierhoekige toren was een wachtkamer met een grote gewelfde kamer en een trap in de muur."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le donjon du château"
    ]
  },
