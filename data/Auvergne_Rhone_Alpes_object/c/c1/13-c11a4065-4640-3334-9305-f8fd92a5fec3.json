  "rdfs:comment": {
    "de": [
      "Nur wenige Minuten vom Herzen der Alpenhauptstadt entfernt hat das Maison Badine die Mauern dieses imposanten, lichtdurchfluteten Gebäudes bezogen, um Ihnen die Kunst des Weins und der Gastronomie nach den Vorstellungen des Küchenchefs Florian Poyet näher zu bringen."
    ],
    "en": [
      "Just a few minutes from the heart of the Alps' capital, Maison Badine has taken over the walls of this imposing, luminous building to introduce you to the art of wine and gastronomy according to chef Florian Poyet."
    ],
    "it": [
      "A pochi minuti dal cuore della capitale alpina, la Maison Badine ha preso possesso delle mura di questo imponente e luminoso edificio per introdurvi all'arte del vino e della gastronomia secondo lo chef Florian Poyet."
    ],
    "fr": [
      "À quelques minutes du cœur de la capitale des Alpes, la Maison Badine a investi les murs de cette imposante bâtisse lumineuse pour vous faire découvrir l'art du vin et de la gastronomie selon le chef Florian Poyet."
    ],
    "nl": [
      "Op enkele minuten van het hart van de Alpenhoofdstad heeft het Maison Badine de muren van dit imposante, lichte gebouw overgenomen om u kennis te laten maken met de kunst van wijn en gastronomie volgens chef-kok Florian Poyet."
    ],
    "es": [
      "A pocos minutos del corazón de la capital de los Alpes, la Maison Badine ha tomado las paredes de este imponente y luminoso edificio para introducirle en el arte del vino y la gastronomía vistos a través de los ojos del chef Florian Poyet."
    ]
  },
  "rdfs:label": {
