  "rdfs:comment": {
    "de": [
      "Jahrhundert, die unter Denkmalschutz steht, ist das größte im Departement Ain errichtete neoklassizistische Kirchengebäude. Sie ist durch ihre Trompe-l'oeil-Malereien und ihre einzigartige Fassade originell."
    ],
    "en": [
      "This nineteenth-century listed church is the largest neoclassical edifice in the Ain département. Its originality lies in its trompe-l'oeil paintings and its curious façade."
    ],
    "it": [
      "Questa chiesa del XIX secolo, classificata come monumento storico, è il più grande edificio religioso neoclassico del dipartimento dell'Ain, originale per i suoi dipinti trompe-l'oeil e la sua singolare facciata."
    ],
    "fr": [
      "Cette église du XIXème siècle, classée Monument historique, est le plus grand édifice religieux néo-classique construit dans le département de l'Ain, originale par ses peintures en trompe-l'oeil et sa façade singulière."
    ],
    "es": [
      "Esta iglesia del siglo XIX es el edificio religioso neo-clasico más grande construido en la región del Ain."
    ],
    "nl": [
      "Deze kerk uit de 19e eeuw, geklasseerd als historisch monument, is het grootste neoklassieke religieuze gebouw van het departement Ain, origineel vanwege de trompe-l'oeil-schilderingen en de bijzondere voorgevel."
    ]
  },
