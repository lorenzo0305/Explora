  "rdfs:comment": {
    "de": [
      "Vertical Aventure führt Sie beim Canyoning, Höhlenwandern, Klettersteiggehen, Paragliding und Klettern rund um Grenoble. Erleben Sie unvergessliche Erlebnisse in aller Sicherheit mit unseren leidenschaftlichen Lehrern. Sensationen und Natur sind für alle Niveaus garantiert."
    ],
    "en": [
      "Vertical Aventure guides you in canyoning, caving, via ferrata, paragliding and climbing around Grenoble. Enjoy unforgettable experiences in complete safety with our passionate instructors. Sensations and nature guaranteed for all levels."
    ],
    "it": [
      "Vertical Aventure vi guida nel canyoning, nella speleologia, nelle vie ferrate, nel parapendio e nell'arrampicata nei dintorni di Grenoble. Vivete esperienze indimenticabili in tutta sicurezza con i nostri istruttori appassionati. Emozioni e natura garantite per tutti i livelli."
    ],
    "fr": [
      "Vertical Aventure vous guide en canyoning, spéléologie, via ferrata, parapente et escalade autour de Grenoble. Vivez des expériences inoubliables en toute sécurité avec nos moniteurs passionnés. Sensations et nature garanties pour tous les niveaux."
    ],
    "es": [
      "Vertical Aventure le guía en barranquismo, espeleología, vía ferrata, parapente y escalada en los alrededores de Grenoble. Disfrute de experiencias inolvidables con total seguridad de la mano de nuestros apasionados monitores. Emociones y naturaleza garantizadas para todos los niveles."
    ],
    "nl": [
      "Vertical Aventure begeleidt je bij canyoning, speleologie, via ferrata, paragliding en klimmen rond Grenoble. Geniet van onvergetelijke ervaringen in alle veiligheid met onze gepassioneerde instructeurs. Sensatie en natuur gegarandeerd voor alle niveaus."
    ]
  },
  "rdfs:label": {
