  "rdfs:comment": {
    "de": [
      "Die Auberge du Pastoureau, eine ehemalige Poststation, empfängt Sie in geselliger Runde mit einer einfachen und großzügigen traditionellen und Lyoner Küche."
    ],
    "en": [
      "A former coaching inn, the Auberge du Pastoureau offers a warm welcome and traditional Lyonnais cuisine, simple and generous."
    ],
    "it": [
      "Ex locanda per allenatori, l'Auberge du Pastoureau offre un'accoglienza calorosa e una cucina tradizionale lionese, semplice e generosa."
    ],
    "fr": [
      "Ancien relais de poste, l'auberge du Pastoureau vous accueille en toute convivialité autour d'une cuisine traditionnelle et lyonnaise, simple et généreuse."
    ],
    "es": [
      "El Auberge du Pastoureau, antigua posada, ofrece una cálida acogida y una cocina tradicional lionesa, sencilla y generosa."
    ],
    "nl": [
      "De Auberge du Pastoureau is een voormalige herberg en biedt een warm welkom en een traditionele Lyonnais keuken, eenvoudig en royaal."
    ]
  },
