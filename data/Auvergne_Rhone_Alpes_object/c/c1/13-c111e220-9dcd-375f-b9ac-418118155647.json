  "rdfs:comment": {
    "de": [
      "MONTJOUX-LA PAILLETTE (Alt 480m) besteht aus vier Weilern: Montjoux, ein Dorf aus dem 15. Jahrhundert mit der Kirche St Étienne (XIII. Jahrhundert), La Paillette, wo sich das Rathaus und die Schule befinden, Barjol und Serre de Truc."
    ],
    "en": [
      "MONTJOUX-LA PAILLETTE (Alt 480m) comprises four hamlets: Montjoux, a 15th-century village with St. Etienne church (13th century), La Paillette where the town hall and school are located, Barjol and Serre de Truc."
    ],
    "it": [
      "MONTJOUX-LA PAILLETTE (alt. 480 m) è composta da quattro frazioni: Montjoux, villaggio del XV secolo con la chiesa di St Etienne (XIII secolo), La Paillette, dove si trovano il municipio e la scuola, Barjol e la Serre de Truc."
    ],
    "fr": [
      "MONTJOUX-LA PAILLETTE (Alt 480m) constitué de quatre hameux : Montjoux, village du XVème avec l'église St Étienne (XIIIè), La Paillette où se trouve la mairie et l'école, Barjol et le Serre de Truc."
    ],
    "es": [
      "MONTJOUX-LA PAILLETTE (Alt 480m) se compone de cuatro aldeas: Montjoux, pueblo del siglo XV con la iglesia de St Etienne (siglo XIII), La Paillette donde se encuentra el ayuntamiento y la escuela, Barjol y la Serre de Truc."
    ],
    "nl": [
      "MONTJOUX-LA PAILLETTE (Alt 480m) bestaat uit vier gehuchten: Montjoux, een dorp uit de 15e eeuw met de kerk St Etienne (13e eeuw), La Paillette waar het gemeentehuis en de school zijn gevestigd, Barjol en Serre de Truc."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Village de Montjoux-La paillette"
    ]
  },
