  "rdfs:comment": {
    "de": [
      "Handgefertigte Kerzen, die in der Auvergne von Hand hergestellt werden. Verkauf das ganze Jahr über im Atelier nach Vereinbarung und auf den Märkten der Haute-Loire und in der Nähe von Puy-de-dôme."
    ],
    "en": [
      "Artisanal candles, handmade in Auvergne. On sale all year round at the workshop by appointment, and at markets in Haute-Loire and nearby Puy-de-dôme."
    ],
    "it": [
      "Candele artigianali dell'Alvernia. In vendita tutto l'anno presso il laboratorio su appuntamento e nei mercati della Haute-Loire e del vicino Puy-de-Dôme."
    ],
    "fr": [
      "Bougies artisanales, fabriquées à la main en Auvergne. Vente toute l'année à l'atelier sur rendez-vous et sur les marchés de Haute-Loire et proche Puy-de-dôme."
    ],
    "es": [
      "Velas artesanales de Auvernia. A la venta todo el año en el taller con cita previa y en los mercados del Alto Loira y del cercano Puy-de-Dôme."
    ],
    "nl": [
      "Handgemaakte kaarsen uit de Auvergne. Het hele jaar door te koop in het atelier op afspraak en op markten in de Haute-Loire en het nabijgelegen Puy-de-Dôme."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La petite fabrique de bougies"
    ]
  },
