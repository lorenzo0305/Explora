  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/a69807a5-70cf-30db-b030-fb3f929cc60b",
      "dc:description": {
        "de": [
          "Während die anderen die Standards überarbeiten, sprengt der JFC sie, indem er den Jazz wie eine Verfolgungsjagd angeht, bei der Randy Brecker, Bob Mintzer und Earth, Wind & Fire immer in der Rückwärtsbewegung laufen."
        ],
        "en": [
          "While the others revisit standards, JFC explodes them, approaching jazz as a chase in which Randy Brecker, Bob Mintzer and Earth, Wind & Fire are always running in reverse."
        ],
        "it": [
          "Mentre gli altri rivisitano gli standard, JFC li fa esplodere, avvicinandosi al jazz come a un inseguimento in cui Randy Brecker, Bob Mintzer ed Earth, Wind & Fire corrono sempre al contrario."
        ],
        "fr": [
          "Pendant que les autres revisitent les standards, le JFC, lui les explose, abordant le jazz comme une course-poursuite où Randy Brecker, Bob Mintzer et Earth, Wind & Fire courent toujours dans le rétro."
        ],
        "nl": [
          "Terwijl de anderen standards herzien, laat JFC ze exploderen en benadert jazz als een achtervolging waarin Randy Brecker, Bob Mintzer en Earth, Wind & Fire altijd in zijn achteruit rennen."
        ],
        "es": [
          "Mientras los demás revisitan los estándares, JFC los explota, abordando el jazz como una persecución en la que Randy Brecker, Bob Mintzer y Earth, Wind & Fire corren siempre a la inversa."
        ]
      },
