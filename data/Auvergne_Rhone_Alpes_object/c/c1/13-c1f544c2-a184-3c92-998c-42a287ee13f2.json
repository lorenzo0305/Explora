  "rdfs:comment": {
    "de": [
      "Direktverkauf von Olivenprodukten durch den Erzeuger: Olivenöl, Tafeloliven, Tapenade, Affinade, Olivenpulpe mit Tomate, Olivenkonfit.  Produkte mit geschützter Ursprungsbezeichnung DE NYONS. Die Oliven werden bei voller Reife geerntet und vollständig von Hand gepflückt."
    ],
    "en": [
      "Direct sale from the producer of olive products: olive oil, table olives, tapenade, ripening, olive pulp with tomato, olive confit. Products AOP Nyons. The olives are picked manually at full maturity."
    ],
    "it": [
      "Vendita diretta di prodotti a base di olive del produttore: olio d'oliva, olive da tavola, tapenade, affinade, polpa di olive con pomodoro, confit di olive.  Prodotti DOP di NYONS. Le olive vengono raccolte a piena maturazione e sono raccolte interamente a mano."
    ],
    "fr": [
      "Vente directe du producteur de produits oléicoles : huile d'olive, olives de table, tapenade, affinade, pulpe d'olive à la tomate, confit d'olive.  Produits AOP DE NYONS. Les olives sont récoltées en pleine maturité  et cueillies entièrement manuellement."
    ],
    "es": [
      "Venta directa de productos de aceituna del productor: aceite de oliva, aceitunas de mesa, tapenade, affinade, pulpa de aceituna con tomate, aceituna confitada.  Productos DOP de NYONS. Las aceitunas se cosechan cuando están completamente maduras y se recogen totalmente a mano."
    ],
    "nl": [
      "Rechtstreekse verkoop van olijfproducten : olijfolie, tafelolijven, tapenade, affinade, olijfpulp met tomaat, olijvenconfit.  BOB-producten van NYONS. De olijven worden geoogst wanneer ze volledig rijp zijn en enkel met de hand."
    ]
  },
