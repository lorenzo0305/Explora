  "rdfs:comment": {
    "de": [
      "Die Website pistesalpedhuez.com ist ein interaktiver, inoffizieller Führer für das Skigebiet Espace Alpe d'Huez, der Skifahrern helfen soll, individuelle Routen entsprechend ihrem Können, ihren Wünschen und dem Wetter zu planen."
    ],
    "en": [
      "The pistesalpedhuez.com website is an interactive, unofficial guide to the Espace Alpe d'Huez ski area, designed to help skiers prepare personalized itineraries according to their level, their desires and the weather."
    ],
    "it": [
      "Il sito pistesalpedhuez.com è una guida interattiva e non ufficiale del comprensorio dell'Espace Alpe d'Huez, pensata per aiutare gli sciatori a preparare itinerari personalizzati in base al loro livello, ai loro desideri e alle condizioni meteorologiche."
    ],
    "fr": [
      "Le site pistesalpedhuez.com est un guide interactif et non officiel pour le domaine skiable de l’Espace Alpe d’Huez, destiné à aider les skieurs à préparer des itinéraires personnalisés en fonction de leur niveau, de leurs envies et de la météo."
    ],
    "es": [
      "El sitio web pistesalpedhuez.com es una guía interactiva y no oficial del dominio esquiable del Espace Alpe d'Huez, diseñada para ayudar a los esquiadores a preparar itinerarios personalizados en función de su nivel, sus deseos y la meteorología."
    ],
    "nl": [
      "De website pistesalpedhuez.com is een interactieve, onofficiële gids van het skigebied Espace Alpe d'Huez, ontworpen om skiërs te helpen gepersonaliseerde routes samen te stellen op basis van hun niveau, hun wensen en het weer."
    ]
  },
