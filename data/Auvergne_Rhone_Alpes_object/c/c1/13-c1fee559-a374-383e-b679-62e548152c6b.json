  "rdfs:comment": {
    "de": [
      "Die Kirche von La Giettaz, die dem Heiligen Pierre-aux-Liens geweiht ist, wurde Mitte des 19. Jahrhunderts anstelle des mittelalterlichen Gebäudes wieder aufgebaut. Ihr Zwiebelturm und ihre Ausstattung machen sie zu einem schönen Beispiel des savoyischen Spätbarocks."
    ],
    "en": [
      "The church at La Giettaz, dedicated to Saint Pierre-aux-Liens, was rebuilt in the mid-19th century to replace the medieval edifice. Its bulbous bell tower and furnishings make it a fine example of late Savoyard Baroque."
    ],
    "it": [
      "La chiesa di La Giettaz, dedicata a Saint-Pierre-aux-Liens, fu ricostruita a metà del XIX secolo in sostituzione dell'edificio medievale. Il suo campanile a bulbo e i suoi arredi ne fanno un bell'esempio di tardo barocco savoiardo."
    ],
    "fr": [
      "L'église de La Giettaz, dédiée à Saint Pierre-aux-Liens, a été reconstruite au milieu du XIXe siècle en remplacement de l'édifice médiéval. Son clocher à bulbe et son mobilier en font un bel exemple de baroque tardif savoyard."
    ],
    "es": [
      "La iglesia de la Giettaz, dedicada a Saint Pierre-aux-Liens, fue reconstruida a mediados del siglo XIX para sustituir el edificio medieval. Su campanario bulboso y su mobiliario son un buen ejemplo del barroco tardío saboyano."
    ],
    "nl": [
      "De kerk van La Giettaz, gewijd aan Saint Pierre-aux-Liens, werd halverwege de 19e eeuw herbouwd ter vervanging van het middeleeuwse gebouw. De bolvormige klokkentoren en het meubilair maken het tot een mooi voorbeeld van late Savoyaardse barok."
    ]
  },
