  "rdfs:comment": {
    "de": [
      "Activ'Gym ist ein 900 m² großer, perfekt ausgestatteter Raum in Saint-Jean-de-Maurienne, in dem Sie alle Arten von Aktivitäten ausüben können: Krafttraining, Kardio- und Cross-Training... und sich für eine große Auswahl an Gruppenkursen anmelden können."
    ],
    "en": [
      "Activ'Gym is a fully-equipped 900 m² gym in Saint-Jean-de-Maurienne, where you can practice all kinds of activities: weight training, cardio, cross training... and sign up for a wide choice of group classes."
    ],
    "it": [
      "Activ'Gym è una palestra di 900 m² completamente attrezzata a Saint-Jean-de-Maurienne, dove è possibile praticare tutti i tipi di attività: pesi, cardio, cross training... e iscriversi a un'ampia scelta di corsi di gruppo."
    ],
    "fr": [
      "Activ'Gym c'est une salle de 900 m² à Saint-Jean-de-Maurienne parfaitement équipée, dans laquelle vous pourrez pratiquer toutes sortes d'activités : musculation, cardio, cross training... et vous inscrire à un large choix de cours collectifs."
    ],
    "nl": [
      "Activ'Gym is een volledig uitgeruste fitnesszaal van 900 m² in Saint-Jean-de-Maurienne, waar je allerlei activiteiten kunt beoefenen: krachttraining, cardio, crosstraining... en je kunt inschrijven voor een ruime keuze aan groepslessen."
    ],
    "es": [
      "Activ'Gym es un gimnasio totalmente equipado de 900 m² en Saint-Jean-de-Maurienne, donde podrá practicar todo tipo de actividades: musculación, cardio, cross training... e inscribirse en una amplia oferta de clases colectivas."
    ]
  },
