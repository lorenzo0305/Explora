  "rdfs:comment": {
    "de": [
      "Zwischen dem Rhône- und dem Galaure-Tal bietet diese abwechslungsreiche Wanderung von den Plateaus von Montrebut und Isnards aus Panoramablicke auf die natürliche Umgebung."
    ],
    "en": [
      "Between the Rhône and Galaure valleys, this varied walk offers panoramic views of the natural environment from the Montrebut and Isnards plateaus."
    ],
    "it": [
      "Tra le valli del Rodano e del Galaure, questa variegata passeggiata offre una vista panoramica sull'ambiente naturale dagli altopiani del Montrebut e dell'Isnards. Questa passeggiata è disponibile sull'app \"MHIKES\" e sulla nostra guida escursionistica."
    ],
    "fr": [
      "Entre vallée du Rhône et de la Galaure, cette randonnée variée propose des regards panoramiques sur le milieu naturel depuis les plateaux de Montrebut et des Isnards. Balade à retrouver dans l'application \"MHIKES\" et dans notre guide de randonnées."
    ],
    "nl": [
      "Tussen de Rhône- en Galaurevallei biedt deze gevarieerde wandeling panoramische uitzichten op de natuur vanaf de Montrebut- en Isnardsplateaus."
    ],
    "es": [
      "Entre los valles del Ródano y de Galaure, este variado paseo ofrece vistas panorámicas del entorno natural desde las mesetas de Montrebut e Isnards. Este paseo se puede encontrar en la aplicación \"MHIKES\" y en nuestra guía de senderismo."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Montrebut et Isnards"
    ]
  },
