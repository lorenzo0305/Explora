  "rdfs:comment": {
    "de": [
      "Tauchen Sie mit Jean Régis Tardiou in die Geschichte von Montfaucon-en-Velay, der ehemaligen Hauptstadt des Velay, ein. Fesselnde Anekdoten und Erzählungen über das mittelalterliche Leben entführen Sie in die glorreiche Vergangenheit dieser charaktervollen Stadt. Ein spannender Besuch ist garantiert!"
    ],
    "en": [
      "Immerse yourself in the history of Montfaucon-en-Velay, the ancient capital of Velay, with Jean Régis Tardiou. Captivating anecdotes and tales of medieval life transport you to the glorious past of this city of character. A fascinating visit guaranteed!"
    ],
    "it": [
      "Immergetevi nella storia di Montfaucon-en-Velay, l'antica capitale del Velay, con Jean Régis Tardiou. Aneddoti accattivanti e racconti di vita medievale vi trasporteranno nel cuore del glorioso passato di questa città di carattere. Una visita affascinante garantita!"
    ],
    "fr": [
      "Plongez dans l'histoire de Montfaucon-en-Velay, ancienne capitale du Velay, avec Jean Régis Tardiou. Anecdotes captivantes et récits de la vie médiévale vous transportent au cœur du passé glorieux de cette cité de caractère. Visite passionnante garantie !"
    ],
    "es": [
      "Sumérjase en la historia de Montfaucon-en-Velay, antigua capital de Velay, de la mano de Jean Régis Tardiou. Cautivadoras anécdotas y relatos de la vida medieval le transportarán al corazón del glorioso pasado de esta ciudad con carácter. Una visita fascinante garantizada"
    ],
    "nl": [
      "Dompel je onder in de geschiedenis van Montfaucon-en-Velay, de oude hoofdstad van Velay, met Jean Régis Tardiou. Boeiende anekdotes en verhalen over het middeleeuwse leven voeren je mee naar het hart van het roemrijke verleden van deze karaktervolle stad. Een fascinerend bezoek gegarandeerd!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ambassadeurs de territoire: histoire de Montfaucon en Velay"
    ]
  },
