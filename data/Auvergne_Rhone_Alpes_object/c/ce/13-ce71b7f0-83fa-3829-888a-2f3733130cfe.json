  "rdfs:comment": {
    "de": [
      "Ihr SUBWAY® Restaurant CC Cap Emeraude bietet Ihnen eine gesellige Pause, die Sie individuell gestalten können! Stellen Sie Ihre Sandwiches, Salate oder Wraps ganz nach Ihrem Geschmack zusammen!\r\nDas Plus: Gourmet-Pause - Eis\r\nVegane und vegetarische Spezialitäten"
    ],
    "en": [
      "Your SUBWAY® CC Cap Emeraude restaurant offers you a convivial break to personalize! Compose your sandwiches, salads or wraps to suit your mood!\r\nBonus: gourmet break - ice cream\r\nVegan and vegetarian specialties"
    ],
    "it": [
      "Il vostro ristorante SUBWAY® CC Cap Emeraude vi offre una pausa amichevole e personalizzata! Create i vostri panini, le vostre insalate o i vostri wrap in base ai vostri gusti!\r\nIl + : pausa gourmet - gelati\r\nSpecialità vegane e vegetariane"
    ],
    "fr": [
      "Votre restaurant SUBWAY® CC Cap Emeraude vous offre une pause conviviale à personnaliser! Composez vos sandwiches, salades ou wraps selon votre envie du moment!\r\nLe + : pause gourmande - glaces\r\nSpécialité végan et végétarienne"
    ],
    "nl": [
      "Uw SUBWAY® CC Cap Emeraude restaurant biedt u een vriendelijke, persoonlijke pauze! Stel uw eigen sandwiches, salades of wraps samen naar uw eigen smaak!\r\nDe + : gastronomische pauze - ijsjes\r\nVeganistische en vegetarische specialiteiten"
    ],
    "es": [
      "Su restaurante SUBWAY® CC Cap Emeraude le ofrece una pausa agradable y personalizada Cree sus propios sándwiches, ensaladas o wraps a su gusto\r\nBonus: pausa gourmet - helados\r\nEspecialidades veganas y vegetarianas"
    ]
  },
