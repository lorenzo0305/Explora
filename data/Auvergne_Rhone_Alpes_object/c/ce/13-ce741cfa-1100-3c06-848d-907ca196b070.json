  "rdfs:comment": {
    "de": [
      "VARENNES CYCLO ist ein Verein, der die Ausübung des Radtourismus auf der Straße oder mit dem Mountainbike fördert. Die Ausflüge finden ohne jeglichen Wettbewerbsgeist statt, jeder bewegt sich in seinem eigenen Rhythmus oder in dem der angetroffenen Landschaften."
    ],
    "en": [
      "VARENNES CYCLO is an association that encourages the practice of bicycle touring on roads or mountain bikes. The outings are done without any spirit of competition, each one evolving at its own pace or at the pace of the landscapes encountered."
    ],
    "it": [
      "VARENNES CYCLO è un'associazione che incoraggia la pratica del cicloturismo su strada o in mountain bike. Le uscite si svolgono senza alcuno spirito di competizione, ognuna evolve al proprio ritmo o a quello dei paesaggi incontrati."
    ],
    "fr": [
      "VARENNES CYCLO est une association qui encourage la pratique du cyclotourisme sur route ou en VTT. Les sorties se font sans aucun esprit de compétition, chacun évoluant à son rythme ou à celui des paysages rencontrés."
    ],
    "nl": [
      "VARENNES CYCLO is een vereniging die de beoefening van fietstochten op de weg of op de mountainbike aanmoedigt. De tochten vinden plaats zonder competitiegeest, waarbij elke tocht zich ontwikkelt in zijn eigen tempo of in dat van de aangetroffen landschappen."
    ],
    "es": [
      "VARENNES CYCLO es una asociación que fomenta la práctica del cicloturismo en carretera o en bicicleta de montaña. Las salidas se realizan sin ningún espíritu de competición, cada una evoluciona a su ritmo o al de los paisajes encontrados."
    ]
  },
  "rdfs:label": {
