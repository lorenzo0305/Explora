  "rdfs:comment": {
    "de": [
      "Willkommen auf der Domaine des Hautes Blâches in den Côteaux Nyonsais, die auf Familienland gegründet wurde, das früher den Mönchen der Abtei St-Victor in Marseille gehörte. Entdecken Sie unsere authentischen Weine, die aus 30 Jahren biologischem & biodynamischem Weinbau hervorgegangen sind."
    ],
    "en": [
      "Welcome to Domaine des Hautes Blâches, on the Nyonsais hillsides, founded on family land once owned by the monks of St-Victor Abbey in Marseille. Discover our authentic wines from 30 years of organic & biodynamic viticulture."
    ],
    "it": [
      "Benvenuti al Domaine des Hautes Blâches, sulle colline di Nyonsais, fondato su terreni di famiglia un tempo di proprietà dei monaci dell'Abbazia di St-Victor a Marsiglia. Scoprite i nostri vini autentici, frutto di 30 anni di viticoltura biologica e biodinamica"
    ],
    "fr": [
      "Bienvenue au Domaine des Hautes Blâches, sur les côteaux Nyonsais, fondé sur des terres familiales, autrefois propriété des moines de l’abbaye St-Victor de Marseille. Découvrez nos vins authentiques issus de 30 ans de viticulture biologique & biodynamique"
    ],
    "nl": [
      "Welkom op het Domaine des Hautes Blâches, op de hellingen van de Nyonsais, gesticht op familiegrond die ooit eigendom was van de monniken van de abdij St Victor in Marseille. Ontdek onze authentieke wijnen, de vrucht van 30 jaar biologische en biodynamische wijnbouw."
    ],
    "es": [
      "Bienvenido al Domaine des Hautes Blâches, en las laderas de Nyonsais, fundado en tierras familiares que pertenecieron a los monjes de la abadía de St-Victor de Marsella. Descubra nuestros vinos auténticos, fruto de 30 años de viticultura ecológica y biodinámica"
    ]
  },
