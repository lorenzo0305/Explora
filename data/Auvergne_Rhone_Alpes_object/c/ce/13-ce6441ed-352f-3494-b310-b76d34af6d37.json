  "rdfs:comment": {
    "de": [
      "Ruhiges Hotel in der Nähe des Zentrums, am Ufer der Isère gelegen.\r\n\r\nProdukte aus der Rotisserie, unsere großen Salate, unsere Tagesvorschläge, unsere hausgemachten Desserts."
    ],
    "en": [
      "Calm Hotel near the city centre, along the Isère river."
    ],
    "it": [
      "Hotel tranquillo situato vicino al centro storico di Romans sur Isère, sulle rive del fiume Isère.\r\nRistorazione in loco: rosticceria, insalatone, specialità del giorno, dolci fatti in casa."
    ],
    "fr": [
      "Hôtel calme situé près du centre historique de Romans sur Isère, au bord de l'Isère.\r\nRestauration sur place : rôtisserie, grandes salades, suggestions du jour, desserts maison."
    ],
    "nl": [
      "Rustig hotel vlakbij het centrum, aan de oever van de Isère.\r\n\r\nProducten uit de rotisserie, onze grote salades, onze dagelijkse suggesties, huisgemaakte desserts."
    ],
    "es": [
      "Hotel tranquilo situado cerca del centro histórico de Romans sur Isère, a orillas del río Isère.\r\nRestauración in situ: asador, grandes ensaladas, platos del día, postres caseros."
    ]
  },
