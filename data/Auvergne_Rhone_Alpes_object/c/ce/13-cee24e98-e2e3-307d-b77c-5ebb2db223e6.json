  "rdfs:comment": {
    "de": [
      "Ob für Sportler, die ihre körperliche Kondition konsequent aufbauen wollen oder ob Sie einfach nur auf Gesundheit und Wohlbefinden bedacht sind, der „Espace Forme“ von Villard-de-Lans heißt Sie willkommen! Ein einzigartiges Gelände mit einer über 300 m2 großen Fläche, eine Mannschaft, ein Geist, individuelle Leistungen und Beratung."
    ],
    "en": [
      "The Villard de Lans Gym awaits fitness enthusiastsmonitoring their physical performance or those simply concerned about their well-being. A unique venue of more than 300m2, a dedicated team with a uniquephilosophy, offering personalised services and advice."
    ],
    "it": [
      "Sportivi che stanno sviluppando le loro prestazioni fisiche o che semplicemente si preoccupano del loro benessere. Il centro fitness di Villard de Lans vi aspetta. Un luogo unico su oltre 300 m2."
    ],
    "fr": [
      "Sportifs en plein développement de vos performances physiques ou tout simplement soucieux de votre bien-être. L'espace Forme de Villard de Lans vous attend. Un lieu unique sur plus de 300 m2."
    ],
    "nl": [
      "Sporters die hun fysieke prestaties willen ontwikkelen of gewoon bezorgd zijn over hun welzijn. Het fitnesscentrum van Villard de Lans wacht op u. Een unieke plek op meer dan 300 m2."
    ],
    "es": [
      "Deportistas en proceso de desarrollo de su rendimiento físico o simplemente preocupados por su bienestar. El centro de fitness de Villard de Lans le espera. Un lugar único en más de 300 m2."
    ]
  },
  "rdfs:label": {
    "de": [
      "Saal von Muskeltraining"
    ],
    "en": [
      "Fitness Center - Weight room"
    ],
    "fr": [
      "Espace Forme - Musculation / Fitness"
    ]
  },
