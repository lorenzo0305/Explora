  "rdfs:comment": {
    "de": [
      "Jardi'Nature, ein Ort, der für den Garten bestimmt ist. Werkzeuge, Ausrüstungen, Pflanzen/Blumen, Bäume, Tiernahrung. Ein Bereich für Motorgeräte mit einer Reparaturwerkstatt. Außerdem ein Team von Landschaftsgärtnern."
    ],
    "en": [
      "Jardi'Nature, a place dedicated to gardening. Tools, equipment, plants/flowers, trees, animal feed. An area dedicated to power tools, with a repair workshop. And a landscaping team."
    ],
    "it": [
      "Jardi'Nature, un luogo dedicato al giardinaggio. Strumenti, attrezzature, piante/fiori, alberi e mangimi. Un'area dedicata agli elettroutensili, con un'officina per le riparazioni. E un team di paesaggisti."
    ],
    "fr": [
      "Jardi'Nature, un lieu destiné au jardin. De l'outillage, des équipements, des plantes/fleurs, des arbres, de l'alimentation animale. Un espace dédié à la motoculture avec un atelier de réparation. Et aussi une équipe de paysagiste."
    ],
    "es": [
      "Jardi'Nature, un lugar dedicado a la jardinería. Herramientas, equipamiento, plantas/flores, árboles y piensos. Un espacio dedicado a las herramientas eléctricas, con un taller de reparación. Y un equipo de paisajistas."
    ],
    "nl": [
      "Jardi'Nature, een plek gewijd aan tuinieren. Gereedschap, apparatuur, planten/bloemen, bomen en diervoeder. Een ruimte gewijd aan elektrisch gereedschap, met een reparatiewerkplaats. En een team van tuinarchitecten."
    ]
  },
