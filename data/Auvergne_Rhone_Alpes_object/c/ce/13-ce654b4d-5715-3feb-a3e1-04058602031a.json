  "rdfs:comment": {
    "de": [
      "Ich bin seit drei Jahrzehnten in der Terre Arverne ansässig und erforsche seit etwa 20 Jahren die Bildhauerei aus Sandstein. Ich lasse mich von der Natur und dem Zauber der Wälder und anderer natürlicher Umgebungen inspirieren, um kraftvolle und zarte Kreationen zu modellieren."
    ],
    "en": [
      "Based in Terre Arverne for the past three decades, I have been exploring stoneware sculpture for the past twenty years. I draw my inspiration from nature and the enchantment of forests and other natural environments to shape powerful yet delicate creations."
    ],
    "it": [
      "Vivendo a Terre Arverne da tre decenni, esploro la scultura in gres da circa vent'anni. Mi ispiro alla natura e all'incanto delle foreste e di altri ambienti naturali per realizzare creazioni potenti ma delicate."
    ],
    "fr": [
      "Installée en Terre Arverne depuis trois décennies, j'explore la sculpture en terre à grès depuis une vingtaine d'année. Je m'inspire de la nature et de la féérie des forêts et des autres milieux naturels pour modeler des créations puissantes et délicates."
    ],
    "es": [
      "Tras tres décadas viviendo en Terre Arverne, llevo unos veinte años explorando la escultura en gres. Me inspiro en la naturaleza y en el encanto de los bosques y otros entornos naturales para crear obras poderosas y delicadas a la vez."
    ],
    "nl": [
      "Ik woon al drie decennia in Terre Arverne en verken al zo'n twintig jaar steengoed sculpturen. Ik haal mijn inspiratie uit de natuur en de betovering van bossen en andere natuurlijke omgevingen om krachtige en toch delicate creaties te maken."
    ]
  },
  "rdfs:label": {
    "fr": [
      "SyB Sculpture : Créatrice de sculpture en céramique"
    ]
  },
