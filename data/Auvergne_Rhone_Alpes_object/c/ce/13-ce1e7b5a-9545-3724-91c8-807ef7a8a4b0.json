  "rdfs:comment": {
    "de": [
      "Dieses große, sonnendurchflutete Savoyer Chalet verbindet harmonisch den gepflegten Empfang der Gäste und den Service für Ihr Wohlbefinden."
    ],
    "en": [
      "This large Savoyard chalet bathed in sunlight harmoniously combines a warm welcome for guests and service for your greater well-being."
    ],
    "it": [
      "Questo grande e soleggiato chalet savoiardo combina armoniosamente un'accoglienza calorosa per gli ospiti e un servizio per il vostro benessere."
    ],
    "fr": [
      "Ce grand chalet savoyard baigné de soleil conjugue harmonieusement accueil soigné des hôtes et service pour votre plus grand bien-être."
    ],
    "es": [
      "Este gran chalet saboyano, bañado por el sol, combina armoniosamente una cálida acogida para los huéspedes y un servicio para su bienestar."
    ],
    "nl": [
      "Dit grote, zonovergoten Savoyaardse chalet combineert op harmonieuze wijze een warm welkom voor de gasten en service voor uw welzijn."
    ]
  },
