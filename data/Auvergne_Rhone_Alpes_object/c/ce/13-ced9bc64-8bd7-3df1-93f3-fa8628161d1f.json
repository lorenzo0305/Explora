  "rdfs:comment": {
    "de": [
      "Die Ferme des Grillons befindet sich in Lurcy-Lévis, in der Bocage Bourbonnais,im Nordwesten der Region Auvergne-Rhône-Alpes.\r\nWir bewirtschaften dort, seit 1993 nach den Richtlinien des ökologischen Landbaus, Wiesen und Getreide."
    ],
    "en": [
      "Ferme des Grillons is located in Lurcy-Lévis, in the Bourbonnais bocage, northwest of the Auvergne-Rhône-Alpes region.\r\nSince 1993, we have been cultivating meadows and cereals in compliance with organic farming specifications."
    ],
    "it": [
      "La Ferme des Grillons si trova a Lurcy-Lévis, nel bocage di Bourbonnais, nel nord-ovest della regione Alvernia-Rodano-Alpi.\r\nQui coltiviamo prati e cereali dal 1993, nel rispetto delle specifiche dell'agricoltura biologica."
    ],
    "fr": [
      "La Ferme des Grillons est située à Lurcy-Lévis, dans le bocage Bourbonnais,au nord-ouest de la région Auvergne-Rhône-Alpes.\r\nNous y cultivons, en respectant le cahier des charges de l'agriculture biologique depuis 1993, des prairies et des céréales."
    ],
    "es": [
      "La Ferme des Grillons está situada en Lurcy-Lévis, en el bocage de Bourbonnais, al noroeste de la región de Auvernia-Ródano-Alpes.\r\nAquí cultivamos prados y cereales desde 1993, respetando el pliego de condiciones de la agricultura ecológica."
    ],
    "nl": [
      "Ferme des Grillons ligt in Lurcy-Lévis, in het Bourbonnais-bocage in het noordwesten van de regio Auvergne-Rhône-Alpes.\r\nSinds 1993 verbouwen we hier weiden en granen volgens de voorschriften van de biologische landbouw."
    ]
  },
  "rdfs:label": {
