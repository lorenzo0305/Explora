  "rdfs:comment": {
    "de": [
      "Bistronomisches Restaurant mit hausgemachter saisonaler Küche. Die Adresse wurde schnell zu einer Referenz für gutes Essen in Saint-Étienne."
    ],
    "en": [
      "Bistro restaurant with seasonal home-made food. In Saint-Étienne, this is quickly becoming known as a place in which to eat well. Somewhere that knows how to delight young and old alike with well-balanced dishes prepared by our chef and served in the elegant, refined designer surroundings of our leading bistro."
    ],
    "it": [
      "Ristorante bistronomico, con cucina stagionale fatta in casa. L'indirizzo è diventato rapidamente un punto di riferimento per la buona cucina a Saint-Etienne."
    ],
    "fr": [
      "Restaurant bistronomique, avec une cuisine de saison fait maison. L’adresse est vite devenue une référence dans le bien manger à Saint-Étienne."
    ],
    "es": [
      "Restaurante bistronómico, con cocina casera de temporada. La dirección se ha convertido rápidamente en una referencia de la buena comida en Saint-Etienne."
    ],
    "nl": [
      "Bistronomisch restaurant, met huisgemaakte seizoensgebonden gerechten. Het adres is al snel een referentie geworden voor lekker eten in Saint-Étienne."
    ]
  },
