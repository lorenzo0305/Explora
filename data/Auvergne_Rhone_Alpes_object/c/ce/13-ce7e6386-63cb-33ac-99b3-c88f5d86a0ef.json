  "rdfs:comment": {
    "de": [
      "Kirche aus dem 19. Jahrhundert mit Wandmalereien aus dem 16. und 17.\r\n Kreuz mit Granitkugeln aus dem 19. Jahrhundert.\r\nRocher de Bounou, Überreste des ehemaligen Schlosses von Rochelaure, das auf einem Granit-Torus errichtet wurde.\r\nWasserfall von La Besque"
    ],
    "en": [
      "19th-century church with 16th- and 17th-century murals.\r\n 19th-century granite ball cross.\r\nRocher de Bounou, remains of the ancient Rochelaure castle built on a granite torus.\r\nLa Besque waterfall"
    ],
    "it": [
      "Chiesa del XIX secolo con dipinti murali del XVI e XVII secolo.\r\n Croce con sfere di granito del XIX secolo.\r\nRocher de Bounou, resti dell'antico castello di Rochelaure costruito su un toro di granito.\r\nCascata di La Besque"
    ],
    "fr": [
      "Église du XIXe siècle avec peintures murales des XVIe et XVIIe siècles.\r\n Croix à boules de granite du XIXe siècle. \r\nRocher de Bounou, vestiges de l’ancien château de Rochelaure construit sur un tore granitique. \r\nCascade de La Besque"
    ],
    "es": [
      "Iglesia del siglo XIX con pinturas murales de los siglos XVI y XVII.\r\n Cruz con bolas de granito del siglo XIX.\r\nRocher de Bounou, restos del antiguo castillo de Rochelaure construido sobre un toro de granito.\r\nCascada de la Besque"
    ],
    "nl": [
      "19e-eeuwse kerk met 16e- en 17e-eeuwse muurschilderingen.\r\n Kruis met granieten ballen uit de 19e eeuw.\r\nRocher de Bounou, overblijfselen van het oude kasteel van Rochelaure gebouwd op een granieten torus.\r\nLa Besque waterval"
    ]
  },
