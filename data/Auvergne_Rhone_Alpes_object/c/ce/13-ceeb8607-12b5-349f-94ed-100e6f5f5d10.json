  "rdfs:comment": {
    "de": [
      "Der Slopestyle Skiweltcup kehrt nach Tignes zurück, um einen außergewöhnlichen und symbolträchtigen Wettbewerb zu veranstalten. Genießen Sie das Spektakel am 17. und 19. März am Fuße der mythischen Piste 'Double M', die speziell für dieses Ereignis angelegt wurde."
    ],
    "en": [
      "The Slopestyle Ski World Cup returns to Tignes for an extraordinary and iconic competition. Come and enjoy the show on March 17 and 19 at the foot of the legendary 'Double M' slope, specially prepared for the event."
    ],
    "it": [
      "La Coppa del Mondo di Sci Slopestyle torna a Tignes per una competizione unica e iconica. Venite a godervi lo spettacolo il 17 e il 19 marzo ai piedi della leggendaria pista \"Double M\", allestita appositamente per l'evento."
    ],
    "fr": [
      "La Coupe du Monde de ski Slopestyle revient à Tignes pour une compétition hors normes et emblématique. Venez profiter du spectacle le 17 et 19 mars au pied de la piste mythique 'Double M' spécialement aménagée pour l'évènement."
    ],
    "es": [
      "La Copa del Mundo de Esquí Slopestyle vuelve a Tignes para una competición única y emblemática. Ven a disfrutar del espectáculo los días 17 y 19 de marzo a los pies de la legendaria pista \"Doble M\", especialmente acondicionada para el evento."
    ],
    "nl": [
      "De Slopestyle Ski World Cup keert terug naar Tignes voor een unieke en iconische wedstrijd. Kom op 17 en 19 maart genieten van het spektakel aan de voet van de legendarische 'Double M'-piste, die speciaal voor het evenement is aangelegd."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Coupe du Monde  de Ski Slopestyle  - Festival Mountain Shaker hiver 2026"
    ]
  },
