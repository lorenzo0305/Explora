  "rdfs:comment": {
    "de": [
      "\"Die Korrespondenz, Porträt einer Epoche\" Thema dieses 30\r\nAuf dem Programm stehen: Aufführungen, literarische Begegnungen, Lesungen aus der Korrespondenz berühmter Persönlichkeiten, Ausstellungen...\r\nAb Mittwoch wird Ihnen ein Markt mit antiquarischen Büchern angeboten."
    ],
    "en": [
      "\"La Correspondance, portrait d'une époque\" theme of the 30th Festival\r\nOn the program: Shows, literary encounters, readings of famous people's correspondence, exhibitions...\r\nFrom Wednesday onwards, an antiquarian book market."
    ],
    "it": [
      "\"La Correspondance, portrait d'une époque\", tema di questo 30° Festival\r\nIn programma: spettacoli, incontri letterari, letture di corrispondenze di personaggi famosi, mostre...\r\nA partire da mercoledì, si terrà un mercato del libro antiquario."
    ],
    "fr": [
      "\"La Correspondance, portrait d'une époque\" thème de ce 30ème Festival\r\nAu programme : Spectacles, rencontres littéraires, lectures de correspondance de personnages célèbres, expositions...\r\nA partir du mercredi, un marché de livres anciens vous est proposé."
    ],
    "nl": [
      "\"La Correspondance, portrait d'une époque\" thema van dit 30e Festival\r\nOp het programma: optredens, literaire ontmoetingen, voordrachten van correspondentie van beroemde personen, tentoonstellingen...\r\nVanaf woensdag is er een antiquarische boekenmarkt."
    ],
    "es": [
      "\"La Correspondance, portrait d'une époque\" tema de esta 30ª edición del Festival\r\nEn el programa: espectáculos, encuentros literarios, lecturas de correspondencia de personajes célebres, exposiciones...\r\nA partir del miércoles, habrá un mercado de libros antiguos."
    ]
  },
