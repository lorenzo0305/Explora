      "dc:description": {
        "de": [
          "18 Uhr: Suppenworkshop\n19 Uhr: Vorführung des Dokumentarfilms \"Leurs champs du c?ur\" mit anschließender Diskussion mit lokalen Produzenten\n20h45 : Verkostung\n\nIn Partnerschaft mit CA2BM, Projet Alimentaire Territorial (PAT) und ARTEC Cinémas"
        ],
        "en": [
          "6pm: Soup workshop\n7pm: Screening of the documentary film \"Leurs champs du c?ur\" followed by a discussion with local producers\n8:45pm: Soup tasting\n\nIn partnership with CA2BM, Projet Alimentaire Territorial (PAT) and ARTEC Cinémas"
        ],
        "it": [
          "18.00: Laboratorio di zuppa\n19.00: Proiezione del film documentario \"Leurs champs du c?ur\" seguita da un dibattito con i produttori locali\n20.45: Degustazione\n\nIn collaborazione con il CA2BM, il Projet Alimentaire Territorial (PAT) e ARTEC Cinémas"
        ],
        "fr": [
          "18h : Atelier soupe\n19h : Projection du film documentaire « Leurs champs du cœur » suivie d’une discussion avec des producteurs locaux\n20h45 : Dégustation\n\nEn partenariat avec la CA2BM, Projet Alimentaire Territorial (PAT) et ARTEC Cinémas"
        ],
        "nl": [
          "18.00 uur: Soepworkshop\n19u: Vertoning van de documentaire \"Leurs champs du c?ur\" gevolgd door een discussie met lokale producenten\n20.45 uur: Proeverij\n\nIn samenwerking met CA2BM, Projet Alimentaire Territorial (PAT) en ARTEC Cinémas"
        ],
        "es": [
          "18.00 h: Taller de sopa\n19.00 h: Proyección del documental \"Leurs champs du cœur\" seguida de un debate con los productores locales\n20.45 h: Degustación\n\nEn colaboración con el CA2BM, Projet Alimentaire Territorial (PAT) y ARTEC Cinémas"
        ]
      },
