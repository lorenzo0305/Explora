  "rdfs:comment": {
    "de": [
      "Eine sehr angenehme Wanderung zwischen einem wilden, tief eingeschnittenen Tal, dem Plateau der Ardèche und den Hängen des Saint Joseph. Diese Wanderung finden Sie in der App \"MHIKES\", um die Strecke zu entdecken, und in unserem Wanderführer."
    ],
    "en": [
      "A very pleasant walk between a wild and steep valley, the Ardèche plateau and the Saint Joseph hillsides. You can find this walk in our application \"MHIKES\" to discover the route and in our walking guide."
    ],
    "it": [
      "Una passeggiata molto piacevole tra una valle selvaggia e profonda, l'altopiano dell'Ardèche e le colline di Saint Joseph. L'itinerario è disponibile sull'applicazione \"MHIKES\" e nella nostra guida escursionistica."
    ],
    "fr": [
      "Une randonnée très agréable entre une vallée sauvage et encaissée, le plateau ardéchois et les coteaux du Saint Joseph. Balade à retrouver dans l'application \"MHIKES\"pour découvrir le parcours et dans notre guide de randonnées."
    ],
    "es": [
      "Un paseo muy agradable entre un valle salvaje y profundo, la meseta de Ardèche y las colinas de Saint Joseph. Encontrará el itinerario en la aplicación \"MHIKES\" y en nuestra guía de senderismo."
    ],
    "nl": [
      "Een zeer aangename wandeling tussen een wilde, diepe vallei, het plateau van de Ardèche en de heuvels van Saint Joseph. Je vindt de route op de \"MHIKES\" applicatie en in onze wandelgids."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le sentier des vignes"
    ]
  },
