  "rdfs:comment": {
    "de": [
      "Ebo, eine Bar/Restaurant am Port d'Albigny in Annecy, bietet Ihnen eine Küche des Austauschs am Feuerkorb. Lokale und saisonale Produkte verwöhnen Ihren Gaumen."
    ],
    "en": [
      "Ebo, a bar/restaurant in Annecy's Port d'Albigny, offers you the chance to share its cuisine over a brazier. Local, seasonal produce to delight your taste buds."
    ],
    "it": [
      "Ébo, un bar-ristorante nel Port d'Albigny di Annecy, vi offre la possibilità di condividere la sua cucina davanti a un braciere. Prodotti locali e di stagione per deliziare il vostro palato."
    ],
    "fr": [
      "Ébo, bar/restaurant situé au Port d'Albigny à Annecy, vous propose une cuisine de partage au brasero. Des produits locaux et de saison qui raviront vos papilles."
    ],
    "nl": [
      "Ébo, een bar/restaurant in de Port d'Albigny in Annecy, biedt je de kans om zijn gerechten te delen boven een vuurtje. Lokale, seizoensgebonden producten om je smaakpapillen te verwennen."
    ],
    "es": [
      "Ébo, bar restaurante del Port d'Albigny de Annecy, le ofrece la posibilidad de compartir su cocina a la brasa. Productos locales y de temporada para deleitar su paladar."
    ]
  },
