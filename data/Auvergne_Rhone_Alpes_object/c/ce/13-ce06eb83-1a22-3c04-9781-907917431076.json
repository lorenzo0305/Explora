  "rdfs:comment": {
    "de": [
      "Die Miellerie des Balcons ist ein Familienbetrieb, der von Yohan und Alexandra geführt wird, zwei Imkern, die sich leidenschaftlich für die faszinierende Welt der Bienen interessieren.\r\nDer Großteil des Honigs trägt das Gütesiegel für biologischen Landbau."
    ],
    "en": [
      "La Miellerie des Balcons is a family-run business run by Yohan and Alexandra, two beekeepers with a passion for the fascinating world of bees. \r\nMost of the honeys are certified organic."
    ],
    "it": [
      "La Miellerie des Balcons è un'azienda a conduzione familiare gestita da Yohan e Alexandra, due apicoltori appassionati dell'affascinante mondo delle api.\r\nLa maggior parte dei mieli è certificata biologica."
    ],
    "fr": [
      "La Miellerie des Balcons est une exploitation familiale tenue par Yohan et Alexandra, deux apiculteurs passionnés par l'univers fascinant des abeilles. \r\nLa majorité des miels sont labellisés Agriculture Biologique."
    ],
    "nl": [
      "La Miellerie des Balcons is een familiebedrijf dat wordt gerund door Yohan en Alexandra, twee imkers met een passie voor de fascinerende wereld van bijen.\r\nDe meeste honing is biologisch gecertificeerd."
    ],
    "es": [
      "La Miellerie des Balcons es una empresa familiar dirigida por Yohan y Alexandra, dos apicultores apasionados por el fascinante mundo de las abejas.\r\nLa mayoría de las mieles tienen certificación ecológica."
    ]
  },
