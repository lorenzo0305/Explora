  "rdfs:comment": {
    "de": [
      "Die Reitschule von Peillonnex bietet Ihnen zahlreiche Aktivitäten an. Reitunterricht für alle, Freizeit oder Wettkampf. Pension und Arbeit mit Pferden und Ausflüge in die Natur."
    ],
    "en": [
      "The Peillonnex horse-riding school offers a wide range of activities.\r\nRiding lessons for everyone, leisure or competition.  Livery and training as well as  hacking in the surrounding countryside."
    ],
    "it": [
      "Il maneggio Peillonnex offre un'ampia gamma di attività. Lezioni di equitazione per tutti, sia per il tempo libero che per le competizioni. Pensione e cavalli da lavoro e uscite nella natura."
    ],
    "fr": [
      "L'école d'équitation de Peillonnex vous propose de nombreuses activtés. Enseignement de l'équitation pour tous, loisirs ou compétition. Pension et travail de chevaux et sorties nature."
    ],
    "es": [
      "La escuela de equitación Peillonnex ofrece una amplia gama de actividades. Clases de equitación para todos, tanto de ocio como de competición. Pensión y caballos de trabajo y salidas a la naturaleza."
    ],
    "nl": [
      "De manege van Peillonnex biedt een breed scala aan activiteiten. Paardrijlessen voor iedereen, zowel recreatief als in wedstrijdverband. Stalling en werkpaarden en uitstapjes in de natuur."
    ]
  },
  "rdfs:label": {
