  "rdfs:comment": {
    "de": [
      "Reparaturen aller Marken. Tankstelle, Abschleppdienst. Taxistand für alle Entfernungen, 7 Tage pro Woche und 24 Stunden pro Tag, zugelassener medizinischer Sitztransport. Service Transdrôme (Fahrten auf Vorbestellung und mit Anschluss an das Netz des Departements und SNCF-Transport)."
    ],
    "en": [
      "All-make repairs. Service station, towing. Cab rank for all distances 24/7, approved for seated medical transport. Transdrôme service (journeys on reservation and in connection with the departmental network and SNCF transport)."
    ],
    "it": [
      "Riparazioni di tutte le marche. Stazione di servizio, rimorchio. Taxi per tutte le distanze 7 giorni su 7 e 24 ore su 24, omologati per il trasporto medico seduto. Servizio Transdrôme (viaggi su prenotazione e in collegamento con la rete dipartimentale e il trasporto SNCF)."
    ],
    "fr": [
      "Réparations toutes marques. Station service, remorquage. Station taxi toutes distances 7j/7 et 24h/24, conventionnée transport médical assis. Service Transdrôme (trajet sur réservation et en correspondance avec le réseau départemental et transport SNCF)."
    ],
    "nl": [
      "Reparaties van alle merken. Tankstation, slepen. Taxistandplaats voor alle afstanden 7 dagen per week en 24 uur per dag, goedgekeurd voor zittend medisch vervoer. Transdrôme service (ritten op reservering en verbindingen met het departementale netwerk en SNCF vervoer)."
    ],
    "es": [
      "Reparaciones de todas las marcas. Estación de servicio, remolque. Parada de taxis para todas las distancias los 7 días de la semana y las 24 horas del día, homologados para el transporte sanitario sentado. Servicio Transdrôme (viajes con reserva y en conexión con la red departamental y el transporte SNCF)."
    ]
  },
