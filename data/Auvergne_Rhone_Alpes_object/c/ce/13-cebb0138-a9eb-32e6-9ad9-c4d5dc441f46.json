  "rdfs:comment": {
    "de": [
      "Die Classic Racing School bietet auf der Rennstrecke von Charade für Fans und Firmengruppen Fahrerlebnisse in historischen Einsitzern (Crosslé 90F) in einer Atmosphäre, die das Eintauchen in die 1960er Jahre ermöglicht."
    ],
    "en": [
      "The Classic Racing School offers driving experiences on the Charade circuit for enthusiasts and corporate groups, at the wheel of historic single-seaters (Crosslé 90F), in an atmosphere that lets you immerse yourself in the 1960s."
    ],
    "it": [
      "La Classic Racing School offre esperienze di guida sul circuito della Charade per appassionati e gruppi aziendali, al volante di monoposto storiche (Crosslé 90F), in un'atmosfera che permette di immergersi negli anni '60."
    ],
    "fr": [
      "La Classic Racing School propose des expériences de pilotage sur le circuit de Charade pour passionnés et groupes d’entreprise, au volant de monoplaces historiques (Crosslé 90F), dans une ambiance permettant de s’immerger dans les années 1960."
    ],
    "es": [
      "La Escuela de Carreras Clásicas ofrece experiencias de conducción en el circuito de Charade para aficionados y grupos de empresas, al volante de monoplazas históricos (Crosslé 90F), en un ambiente que permite sumergirse en los años 60."
    ],
    "nl": [
      "De Classic Racing School biedt rijervaringen op het circuit van Charade voor liefhebbers en bedrijfsgroepen, aan het stuur van historische eenzitters (Crosslé 90F), in een sfeer waarin u zich kunt onderdompelen in de jaren zestig."
    ]
  },
  "rdfs:label": {
