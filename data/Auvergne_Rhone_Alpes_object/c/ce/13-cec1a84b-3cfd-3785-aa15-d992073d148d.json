  "rdfs:comment": {
    "de": [
      "Die Moulin des Gardelles bietet Ihnen die Möglichkeit, zwei Tagungsräume zu mieten.\r\nDie Räume können ganz- oder halbtägig gemietet werden."
    ],
    "en": [
      "The Moulin des Gardelles offers you the rental of 2 meeting rooms.\r\nThe rooms are available for hire by the day or half-day."
    ],
    "it": [
      "Il Moulin des Gardelles offre 2 sale riunioni a noleggio.\r\nLe sale sono disponibili per il noleggio a giornata o a mezza giornata."
    ],
    "fr": [
      "Le Moulin des Gardelles vous propose la location de 2 salles de réunion.\r\nLes salles sont proposées en location à la journée ou à la demi-journée."
    ],
    "es": [
      "El Moulin des Gardelles ofrece 2 salas de reuniones para alquilar.\r\nLas salas se pueden alquilar por día o por medio día."
    ],
