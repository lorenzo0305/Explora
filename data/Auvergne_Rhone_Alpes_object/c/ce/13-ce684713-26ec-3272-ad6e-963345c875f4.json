  "rdfs:comment": {
    "de": [
      "Das Team des Restaurants lädt Sie ein, unsere Savoyer Spezialitäten sowie eine traditionelle Speisekarte zu entdecken, die zu jeder Jahreszeit neu zusammengestellt wird."
    ],
    "en": [
      "As the name suggests, the restaurant Petit Montagnard is an invitation to discover the nice Savoyard specialties."
    ],
    "it": [
      "Il team del ristorante vi invita a scoprire le nostre specialità savoiarde e un menu tradizionale che viene rinnovato ogni stagione."
    ],
    "fr": [
      "L'équipe du restaurant vous invite à découvrir nos spécialités Savoyardes ainsi qu'une carte traditionnelle renouvelée à chaque saison."
    ],
    "nl": [
      "Zoals de naam suggereert, is het restaurant Petit Montagnard een uitnodiging om de mooie Savoyard-specialiteiten te ontdekken."
    ],
