  "rdfs:comment": {
    "de": [
      "Die Weberin Iga Borkowska und der Maler Mikolaj Nowotniak begrüßen Sie in ihrem Atelier Galerie La Trame, einem Ausstellungs- und Verkaufsraum für diese beiden aus Polen stammenden Künstler."
    ],
    "en": [
      "Exhibition and sale of Iga’s tapestries and Mikolaj’s paintings."
    ],
    "it": [
      "Iga Borkowska, tessitrice, e Mikolaj Nowotniak, pittore, vi danno il benvenuto nel loro Atelier Galerie La Trame, uno spazio espositivo e di vendita per questi due artisti polacchi."
    ],
    "fr": [
      "Iga Borkowska, tisserande et Mikolaj Nowotniak, artiste peintre, vous accueillent dans leur Atelier Galerie La Trame, un espace d'exposition et de vente pour ces deux artistes venus de Pologne."
    ],
    "nl": [
      "Iga Borkowska, weefster en Mikolaj Nowotniak, schilder, heten u welkom in hun Atelier Galerie La Trame, een expositie- en verkoopruimte voor deze twee kunstenaars uit Polen."
    ],
    "es": [
      "Iga Borkowska, tejedora, y Mikolaj Nowotniak, pintor, le dan la bienvenida a su Atelier Galerie La Trame, un espacio de exposición y venta para estos dos artistas de Polonia."
    ]
  },
  "rdfs:label": {
    "en": [
