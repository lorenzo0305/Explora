  "rdfs:comment": {
    "de": [
      "Dorf Saint-Pal-de-Senouire: Gotische Kirche aus dem 15. Jahrhundert, Überbleibsel eines alten Priorats aus Casadéen, das es seit dem 11. Jahrhundert gibt, mit dem angrenzenden Gebäude, in dem heute das Rathaus untergebracht ist. Monumentales schmiedeeisernes Kreuz, Waschhaus."
    ],
    "en": [
      "Village of Saint-Pal-de-Senouire: 15th-century Gothic church, remnant of a former Casade priory dating back to the 11th century, with adjacent building now housing the town hall. Monumental wrought-iron cross, wash-house."
    ],
    "it": [
      "Villaggio di Saint-Pal-de-Senouire: chiesa in stile gotico del XV secolo, residuo di un antico priorato casadiano dell'XI secolo, con l'edificio adiacente che oggi ospita il municipio. Croce monumentale in ferro battuto, lavatoio."
    ],
    "fr": [
      "Village de Saint-Pal-de-Senouire : Église de style gothique du XVe siècle, vestige d’un ancien prieuré casadéen présent depuis le XIe siècle, avec le bâtiment adjacent qui abrite aujourd’hui la mairie. Croix monumentale en fer forgé, lavoir."
    ],
    "es": [
      "Pueblo de Saint-Pal-de-Senouire: iglesia de estilo gótico del siglo XV, vestigio de un antiguo priorato casadio del siglo XI, cuyo edificio adyacente alberga actualmente el ayuntamiento. Cruz monumental de hierro forjado, lavadero."
    ],
    "nl": [
      "Dorp Saint-Pal-de-Senouire: 15e-eeuwse kerk in gotische stijl, overblijfsel van een voormalige Casadische priorij uit de 11e eeuw, in het aangrenzende gebouw is nu het gemeentehuis gevestigd. Monumentaal smeedijzeren kruis, wasplaats."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Village | Saint-Pal-De-Senouire"
    ]
  },
