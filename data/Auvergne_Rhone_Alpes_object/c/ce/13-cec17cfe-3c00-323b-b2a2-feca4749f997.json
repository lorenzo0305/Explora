  "rdfs:comment": {
    "de": [
      "Saint-Vincent-la-Commanderie ist ein sehr hübsches Dorf am Fuße der Monts du Matin, den ersten Gipfeln des Vercors und der Raille. Es liegt im Departement Drôme in der Region Rhône Alpes."
    ],
    "en": [
      "Saint-Vincent-la-Commanderie is a pretty village at the foot of the Monts du Matin, the first crests of the Vercors and Raille mountains. It is located in the Drôme in the Rhône Alpes region."
    ],
    "it": [
      "Saint-Vincent-la-Commanderie è un grazioso villaggio ai piedi dei Monts du Matin, le prime cime del Vercors e della Raille. Si trova nella Drôme, nella regione del Rodano-Alpi."
    ],
    "fr": [
      "Saint-Vincent-la-Commanderie est un très joli village aux pieds des Monts du Matin, premières crêtes du Vercors et de la Raille. Il est situé dans la Drôme en région Rhône Alpes."
    ],
    "nl": [
      "Saint-Vincent-la-Commanderie is een heel mooi dorp aan de voet van de Monts du Matin, de eerste toppen van de Vercors en de Raille. Het ligt in de Drôme in de regio Rhône Alpes."
    ],
    "es": [
      "Saint-Vincent-la-Commanderie es un pueblo muy bonito a los pies de los Montes del Matin, las primeras cumbres del Vercors y de la Raille. Está situado en la Drôme, en la región de Rhône Alpes."
    ]
  },
