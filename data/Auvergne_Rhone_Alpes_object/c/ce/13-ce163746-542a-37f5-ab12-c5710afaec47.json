  "rdfs:comment": {
    "de": [
      "Das Savoy bietet eine von den Produkten der Savoyer Region inspirierte Küche und eine gemütliche Bar, in der Sie jeden Abend einen Aperitif und Live-Musik genießen können.  Ganztägig geöffnet, durchgehende Küche von 12:00 bis 22:00 Uhr."
    ],
    "en": [
      "Le Savoy offers cuisine inspired by local Savoyard produce and a cosy bar where you can enjoy aperitifs and live music every evening.  Open all day, continuous cooking from 12pm to 10pm."
    ],
    "it": [
      "Il Savoy offre una cucina ispirata ai prodotti locali savoiardi e un accogliente bar dove gustare un aperitivo e musica dal vivo ogni sera.  Aperto tutto il giorno, cucina continua dalle 12.00 alle 22.00."
    ],
    "fr": [
      "Le Savoy propose une cuisine inspirée des produits du terroir savoyard et un bar chaleureux pour profiter de l'apéritif et de la musique Live tous les soirs.  Ouvert Toute la journée, cuisine en continue de 12h à 22h."
    ],
    "nl": [
      "Het Savoy biedt een keuken geïnspireerd op lokale Savoyaardse producten en een gezellige bar waar je elke avond kunt genieten van een aperitief en livemuziek.  De hele dag geopend, doorlopend koken van 12.00 tot 22.00 uur."
    ],
    "es": [
      "El Savoy ofrece una cocina inspirada en los productos locales de Saboya y un acogedor bar donde podrá disfrutar de un aperitivo y música en directo todas las noches.  Abierto todo el día, cocina continua de 12h a 22h."
    ]
  },
