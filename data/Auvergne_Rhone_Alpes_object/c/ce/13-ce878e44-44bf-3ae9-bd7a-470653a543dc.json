  "rdfs:comment": {
    "de": [
      "Das ganze Jahr über. RDV auf dem Gemeindegrundstück von Esfacy. Start: 13 Uhr am Dienstag und Donnerstag | 8:30 Uhr am Sonntag. Auf dem Programm stehen: Entdeckungswanderung, Gesundheitswanderung und Tageswanderung. Sanfte Wanderung (mäßige Intensität, Dauer: 2,5-3 Stunden) am Freitag, Start 13:30 Uhr."
    ],
    "en": [
      "All year round. RDV at the Esfacy communal field. Departure: 1pm Tuesdays and Thursdays | 8:30am Sundays. On the program: discovery hikes, health hikes and day hikes. Gentle hikes (moderate intensity, duration: 2h30-3h) on Fridays, departing at 1:30pm."
    ],
    "it": [
      "Tutto l'anno. Punto di ritrovo presso il campo comunale di Esfacy. Partenza: martedì e giovedì alle 13.00; domenica alle 8.30. In programma: escursioni di scoperta, escursioni salutari ed escursioni giornaliere. Escursioni dolci (intensità moderata, durata: 2h30-3h) il venerdì, a partire dalle 13.30."
    ],
    "fr": [
      "Toute l’année. RDV au terrain communal d’Esfacy. Départ : 13h le mardi et jeudi | 8h30 le dimanche. Au programme : randonnée découverte, rando santé et rando à la journée. Rando douce (intensité modérée, durée : 2h30-3h) le vendredi, départ 13h30."
    ],
    "es": [
      "Todo el año. Punto de encuentro en el campo comunal de Esfacy. Salida: martes y jueves a las 13.00 h; domingos a las 8.30 h. En el programa: excursiones de descubrimiento, excursiones de salud y excursiones de un día. Caminatas suaves (intensidad moderada, duración: 2h30-3h) los viernes, a partir de las 13h30."
    ],
    "nl": [
      "Het hele jaar door. Trefpunt bij het Esfacy-gemeenschapsveld. Vertrek: 13.00 uur op dinsdag en donderdag; 8.30 uur op zondag. Op het programma: ontdekkingswandelingen, gezondheidswandelingen en dagwandelingen. Gemakkelijke wandelingen (matige intensiteit, duur: 2u30-3u) op vrijdag, vanaf 13u30."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Randonnées hebdomadaires"
    ]
  },
