  "rdfs:comment": {
    "de": [
      "Vom Chevrotin AOP bis zum Tomme de chèvre des Savoie, über die frischen, mit Kräutern verfeinerten Crottins, die Bûches cendrées, das Ziegenraclette, den Serac und zum Schluss den Bleu de chèvre - Sie werden Ihr Glück finden!"
    ],
    "en": [
      "Chevrotin AOP, Tomme de Chèvre des Savoie, fresh crottin goat’s cheese, soft cheese with herbs, Bûches Cendrées, goat's milk raclette, Sérac and finally Bleu de Chèvre blue goat's cheese - we have something for everyone!"
    ],
    "it": [
      "Dallo Chevrotin AOP alla Tomme de chèvre des Savoie, dai crottin freschi a quelli stagionati alle erbe, dai bûches cendrées alla raclette de chèvre, dal sérac al Bleu de chèvre, ce n'è per tutti i gusti!"
    ],
    "fr": [
      "Du Chevrotin AOP à la Tomme de chèvre des Savoie, en passant par les crottins frais, affinés aux herbes, les bûches cendrées, la raclette de chèvre, le sérac et pour finir le Bleu de chèvre, vous trouverez votre bonheur !"
    ],
    "nl": [
      "Van Chevrotin AOP tot Tomme de chèvre des Savoie, met verse crottins, met kruiden gerijpte crottins, bûches cendrées, raclette de chèvre, sérac en tot slot Bleu de chèvre, u vindt wat u zoekt!"
    ],
    "es": [
      "En \"La ferme du Petit Mont\" vendemos quesos de cabra y productos de la granja (charcutería, mermeladas, siropes...)."
    ]
  },
