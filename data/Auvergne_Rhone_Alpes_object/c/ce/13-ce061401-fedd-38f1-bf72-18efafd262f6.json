  "rdfs:comment": {
    "de": [
      "Das Stade Gabriel Montpied befindet sich an der Kreuzung der Autobahnen A75, A89 und A71. Es befindet sich außerdem ganz in der Nähe des Flughafens Clermont-Ferrand Auvergne."
    ],
    "en": [
      "The Gabriel Montpied stadium is located at the junction of the A75, A89 and A71 freeways. It is also very close to Clermont-Ferrand Auvergne airport."
    ],
    "it": [
      "Lo stadio Gabriel Montpied si trova all'incrocio delle autostrade A75, A89 e A71. È anche molto vicino all'aeroporto di Clermont-Ferrand Auvergne."
    ],
    "fr": [
      "Le stade Gabriel Montpied est situé au croisement des autoroutes A75, A89 et A71. Il se trouve également très proche de l’aéroport Clermont-Ferrand Auvergne."
    ],
    "nl": [
      "Het Gabriel Montpied stadion ligt op het kruispunt van de snelwegen A75, A89 en A71. Het is ook zeer dicht bij de luchthaven van Clermont-Ferrand Auvergne."
    ],
    "es": [
      "El estadio Gabriel Montpied está situado en la intersección de las autopistas A75, A89 y A71. También está muy cerca del aeropuerto de Clermont-Ferrand Auvergne."
    ]
  },
