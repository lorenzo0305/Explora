  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/db7f8fe6-9c6b-38ce-b8c2-801b376b709f",
      "dc:description": {
        "de": [
          "Informationen :\n\nÖffnungstage:\n \nMontag bis Freitag von 9:00 bis 12:15 Uhr und von 14:00 bis 19:15 Uhr\n\nSamstags von 9.00 bis 12.15 Uhr\n\nAbholung:\n\nWährend der Öffnungszeiten der Apotheke\n "
        ],
        "en": [
          "Information :\n\nOpening days:\n \nMonday to Friday, 9:00 am to 12:15 pm and 2:00 pm to 7:15 pm\n\nSaturday from 9h00 to 12h15\n\nPick-up:\n\nDuring pharmacy opening hours\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura:\n \nDal lunedì al venerdì, dalle 9.00 alle 12.15 e dalle 14.00 alle 19.15\n\nSabato dalle 9.00 alle 12.15\n\nRitiro:\n\nDurante gli orari di apertura della farmacia\n "
        ],
        "fr": [
          "Informations :\n\nJours d'ouverture:\n \nDu lundi au vendredi de 9h00 à 12h15 et de 14h00 à 19h15\n\nLe samedi de 9h00 à 12h15\n\nRetrait:\n\nAux horaires d'ouverture de la pharmacie\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen:\n \nMaandag tot vrijdag, 9u tot 12u15 en 14u tot 19u15\n\nZaterdag van 9u00 tot 12u15\n\nOphalen:\n\nTijdens de openingsuren van de apotheek\n "
        ],
        "es": [
          "Más información :\n\nDías de apertura:\n \nDe lunes a viernes, de 9.00 a 12.15 h. y de 14.00 a 19.15 h\n\nSábado de 9h00 a 12h15\n\nRecogida:\n\nDurante el horario de apertura de la farmacia\n "
        ]
      },
