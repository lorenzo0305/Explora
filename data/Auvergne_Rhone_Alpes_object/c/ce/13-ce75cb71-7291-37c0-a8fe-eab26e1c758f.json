  "rdfs:comment": {
    "de": [
      "Sie beginnt in Beauvoir au Royans: Empfang 8:30 Uhr, Beginn der Zeremonie\r\nbeginn der Zeremonie 9 Uhr.\r\nDanach geht es in St Nazaire en Royans weiter: Empfang 10:45 Uhr, Beginn der Zeremonie 11:00 Uhr, gefolgt von einem Ehrenwein."
    ],
    "en": [
      "It will start in Beauvoir au Royans: welcome at 8:30 am, ceremony begins\r\nceremony at 9am.\r\nIt continues in St Nazaire en Royans: welcome 10:45am, ceremony 11am, followed by a vin d'honneur."
    ],
    "it": [
      "Si inizierà a Beauvoir au Royans: accoglienza alle 8.30, inizio della cerimonia\r\ncerimonia alle 9.00.\r\nSi proseguirà poi a St Nazaire en Royans: accoglienza alle 10.45, cerimonia alle 11.00, seguita dal vin d'honneur."
    ],
    "fr": [
      "Elle débutera à Beauvoir au Royans : accueil 8h30, début de la\r\ncérémonie 9h.\r\nPour ensuite ce poursuivre à St Nazaire en Royans : accueil 10h45, début de la cérémonie 11h suivi du vin d'honneur."
    ],
    "nl": [
      "Het begint in Beauvoir au Royans: welkom om 8.30 uur, ceremonie begint\r\nceremonie om 9 uur.\r\nDaarna gaat het verder in St Nazaire en Royans: ontvangst om 10.45 uur, ceremonie om 11.00 uur, gevolgd door de vin d'honneur."
    ],
    "es": [
      "Comenzará en Beauvoir au Royans: bienvenida a las 8.30 horas, inicio de la ceremonia\r\nceremonia a las 9h.\r\nContinuará en St Nazaire en Royans: bienvenida a las 10.45 h, ceremonia a las 11 h, seguida del vin d'honneur."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Cérémonie Wesermünde en mémoire des déportés et des maquisards exécutés"
    ]
  },
