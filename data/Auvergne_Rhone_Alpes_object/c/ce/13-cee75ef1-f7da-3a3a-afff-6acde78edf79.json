  "rdfs:comment": {
    "de": [
      "Am Ufer des Privatsees Saint Félix, ein hübscher Pavillon mit gedämpfter Atmosphäre.\r\nSpezialität des Küchenchefs: Trüffelmenü das ganze Jahr über. Möglichkeit, zwei Menüvorschläge mit einer freien Küche zwischen Meer, See und Bergen zu entdecken."
    ],
    "en": [
      "Gastronomic restaurant. Intimate ambience where the finest cuisine can be enjoyed in the most splendid settings, above a private lake. Specialty of the chef: truffle all year long. Discovery of 2 menus following the chef's inspiration and local products."
    ],
    "it": [
      "Sulle rive del lago privato di Saint Félix, un grazioso padiglione dall'atmosfera accogliente.\r\nSpecialità dello chef: menù al tartufo tutto l'anno. È possibile scegliere tra due opzioni di menu, con una libera scelta di cucina di mare, lago e montagna."
    ],
    "fr": [
      "Au bord du lac privé Saint Félix, un joli pavillon avec une ambiance feutrée. \r\nSpécialité du chef : menu truffé toute l'année. Possibilité de découvrir deux propositions de menus avec une cuisine libre entre mer, lac et montagne."
    ],
    "nl": [
      "Aan de oever van het privémeer Saint-Félix, een mooi paviljoen met een gezellige sfeer.\r\nSpecialiteit van de chef: truffelmenu het hele jaar door. Je kunt ook kiezen uit twee verschillende menu's, met een keuze uit de zee-, meer- en bergkeuken."
    ],
    "es": [
      "A orillas del lago privado Saint Félix, un bonito pabellón de ambiente acogedor.\r\nEspecialidad del chef: menú a base de trufas todo el año. Puede elegir entre dos opciones de menú, con libre elección de cocina de mar, lago y montaña."
    ]
  },
