  "rdfs:comment": {
    "de": [
      "Zwischen Roeulx und Bouchain können Sie den Gipfel dieser Halde erklimmen, deren Umgebung rehabilitiert wurde und die Entdeckung von Feuchtgebieten und Pionierwäldern ermöglicht."
    ],
    "en": [
      "Between Roeulx and Bouchain, you can climb to the top of this slag heap, whose environment has been rehabilitated to reveal wetlands and pioneer woodland."
    ],
    "it": [
      "Tra Roeulx e Bouchain, è possibile salire in cima a questo cumulo di scorie, dove l'ambiente è stato riabilitato per rivelare zone umide e boschi pionieri."
    ],
    "fr": [
      "Entre Roeulx et Bouchain, vous pourrez grimper au sommet de ce terril dont l'environnement a été réhabilité et permet de découvrir des zones humides et des boisements pionniers."
    ],
    "nl": [
      "Tussen Roeulx en Bouchain kun je naar de top van deze terril klimmen, waar de omgeving is hersteld om moeraslanden en pionierbossen te onthullen."
    ],
    "es": [
      "Entre Roeulx y Bouchain, puede subir a la cima de este escorial, cuyo entorno ha sido rehabilitado para revelar humedales y bosques pioneros."
    ]
  },
  "rdfs:label": {
