  "rdfs:comment": {
    "de": [
      "Shop / Atelier für Keramik. Handwerkliche Kreationen aus Steingutkeramik, gedreht und dekoriert: Geschirr, Dekorationsgegenstände, Skulpturen. Die Boutique beherbergt außerdem drei Kunsthandwerker: Zeichnungen, Leuchten, Fotografien."
    ],
    "en": [
      "Store / Ceramic workshop. Hand-crafted stoneware creations, turned and decorated: tableware, decorative objects, sculptures. The store is also home to three artists: drawings, lighting and photography."
    ],
    "it": [
      "Negozio / Laboratorio di ceramica. Creazioni artigianali in gres, tornite e decorate: stoviglie, oggetti decorativi, sculture. Il negozio ospita anche tre artisti: disegni, illuminazione e fotografia."
    ],
    "fr": [
      "Boutique / Atelier de céramique. Créations artisanales de céramique en grès, tournées et décorées : vaisselles, objets de décoration, sculptures. La boutique accueille également trois artisans d'art : dessins, luminaires, photographies."
    ],
    "nl": [
      "Winkel / Keramisch atelier. Handgemaakte steengoed creaties, gedraaid en gedecoreerd: servies, decoratieve objecten, sculpturen. In de winkel werken ook drie kunstenaars: tekeningen, verlichting en fotografie."
    ],
    "es": [
      "Tienda / Taller de cerámica. Creaciones artesanales en gres, torneado y decorado: vajillas, objetos decorativos, esculturas. La tienda también acoge a tres artistas: dibujos, iluminación y fotografía."
    ]
  },
