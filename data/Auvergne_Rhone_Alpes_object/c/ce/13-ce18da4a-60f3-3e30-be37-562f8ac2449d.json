  "rdfs:comment": {
    "de": [
      "Restaurant mit traditioneller Küche im Herzen des historischen Zentrums von Clermont-Fd. Auf halbem Weg zwischen dem Place de Jaude und dem Place de la Victoire bietet Ihnen das La Fille à Papa eine Auswahl an Gerichten der französischen Gastronomie.\r\nEmpfang von Gruppen."
    ],
    "en": [
      "Traditional cuisine restaurant nestled in the heart of Clermont-Fd's historic center. Halfway between Place de Jaude and Place de la Victoire, La Fille à Papa offers a selection of French gastronomic highlights.\r\nGroups welcome."
    ],
    "it": [
      "Ristorante di cucina tradizionale nel cuore del centro storico di Clermont-Fd. A metà strada tra Place de Jaude e Place de la Victoire, La Fille à Papa offre una scelta di specialità gastronomiche francesi.\r\nAccoglienza gruppi."
    ],
    "fr": [
      "Restaurant de cuisine traditionnelle lové au cœur du centre historique de Clermont-Fd. À mi-chemin de la place de Jaude et de la Place de la Victoire, la Fille à Papa vous propose un choix de plats phares de la gastronomie française .\r\nAccueil de groupes."
    ],
    "es": [
      "Restaurante de cocina tradicional en pleno centro histórico de Clermont-Fd. A medio camino entre la Place de Jaude y la Place de la Victoire, La Fille à Papa ofrece una selección de platos gastronómicos franceses.\r\nSe aceptan grupos."
    ],
    "nl": [
      "Restaurant met traditionele keuken in het hart van het historische centrum van Clermont-Fd. La Fille à Papa ligt halverwege de Place de Jaude en de Place de la Victoire en biedt een keur aan Franse gastronomische hoogtepunten.\r\nGroepen zijn welkom."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Fille à Papa"
    ]
  },
