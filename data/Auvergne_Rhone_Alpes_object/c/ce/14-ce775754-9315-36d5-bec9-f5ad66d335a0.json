  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/e55b7877-424a-3fca-bd17-704c6fd6f542",
      "dc:description": {
        "de": [
          "Bar-Pub, 7 Tage pro Woche geöffnet\nFestliche und freundliche Atmosphäre\nGroße Auswahl an frisch gezapften Bieren\nÜbertragung von Sportereignissen (Fußball, Rugby, Golf...)\nBillard-, Darts- und Flipperraum\nTerrasse mit 40 Plätzen\n\nGeöffnet Montag bis Donnerstag von 8.30 bis 01.00 Uhr\nFreitag und Samstag von 8.30 bis 02.00 Uhr\nSonntag von 8.30 bis 01.00 Uhr\n\nVon Juni bis September täglich von 8:30 bis 02:00 Uhr geöffnet"
        ],
        "en": [
          "Bar-Pub open 7/7\nFestive, friendly atmosphere\nWide selection of draught beers\nSports broadcasts (soccer, rugby, golf...)\nBilliards, darts and pinball room\n40-seat terrace\n\nOpen Monday to Thursday, 8:30am to 01:00am\nFriday and Saturday, 8:30am to 2:00am\nSunday 8:30am - 01:00am\n\nOpen daily from 8:30 am to 02:00 am from June to September"
        ],
        "it": [
          "Bar-Pub aperto 7 giorni su 7\nAtmosfera festosa e amichevole\nAmpia scelta di birre alla spina\nTrasmissioni sportive (calcio, rugby, golf, ecc.)\nSala biliardo, freccette e flipper\nTerrazza da 40 posti\n\nAperto dal lunedì al giovedì, dalle 8.30 all'1 di notte\nVenerdì e sabato, dalle 8.30 alle 2 di notte\nDomenica, dalle 8.30 all'1.00\n\nAperto tutti i giorni dalle 8.30 alle 2 da giugno a settembre"
        ],
        "fr": [
          "Bar-Pub ouvert 7j/7\nAmbiance festive et conviviale\nGrand choix de bières pressions\nRetransmissions des évènements sportifs (foot, rugby, golf...)\nSalle de billards, fléchettes, flipper\nTerrasse de 40 places\n\nOuvert du lundi au jeudi de 8h30 à 01h00\nVendredi et samedi de 8h30 à 02h00\nDimanche de 8h30 à 01h00\n\nOuvert tous les jours de 8h30 à 02h00 de de juin à septembre"
        ],
        "es": [
          "Bar-Pub abierto 7 días a la semana\nAmbiente festivo y acogedor\nAmplia selección de cervezas de barril\nRetransmisiones deportivas (fútbol, rugby, golf, etc.)\nSala de billar, dardos y pinball\nTerraza de 40 plazas\n\nAbierto de lunes a jueves de 8.30 a 1.00 h\nViernes y sábado, de 8.30 a 2.00 h\nDomingo, de 8.30 a 1.00\n\nAbierto todos los días de junio a septiembre de 8.30 a 2.00 h"
        ],
        "nl": [
          "Bar-Pub 7 dagen per week geopend\nFeestelijke en vriendelijke sfeer\nRuime keuze aan bieren van het vat\nSportuitzendingen (voetbal, rugby, golf, enz.)\nBiljart-, dart- en flipperkastruimte\nTerras met 40 zitplaatsen\n\nGeopend van maandag tot donderdag van 8.30 tot 1.00 uur\nVrijdag en zaterdag van 8.30 tot 2.00 uur\nZondag van 8.30 tot 1.00 uur\n\nVan juni tot september dagelijks geopend van 8.30 tot 2.00 uur"
        ]
      },
