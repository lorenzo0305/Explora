  "rdfs:comment": {
    "de": [
      "Geschäft für Outdoor-Sportgeräte.\r\nVerkauf, Wartung, Reparatur und Verleih aller Arten von Elektro- und Muskelfahrrädern.\r\nVerleih und Verkauf von Alpinskiern, nordischen Skiern und Tourenskiern. Via Ferrata."
    ],
    "en": [
      "We are an outdoor sports equipment shop. Sales, repairs, servicing and hire of all types of bikes. Downhill, nordic and touring skis for hire or sale. Via ferrata equipment."
    ],
    "it": [
      "Negozio di attrezzature sportive per esterni.\r\nVendita, manutenzione, riparazione e noleggio di tutti i tipi di biciclette elettriche e muscolari.\r\nNoleggio e vendita di sci alpini, nordici e da turismo. Via ferrata."
    ],
    "fr": [
      "Magasin de matériel de Sports Outdoors. \r\nVente, entretien, réparation et location de tous types de Vélos électriques et musculaires.\r\nLocation et vente de skis alpins, nordiques et randonnées. Via ferrata."
    ],
    "es": [
      "Tienda de material deportivo al aire libre.\r\nVenta, mantenimiento, reparación y alquiler de todo tipo de bicicletas eléctricas y musculosas.\r\nAlquiler y venta de esquís alpinos, nórdicos y de travesía. Vías ferratas."
    ],
    "nl": [
      "Sportzaak. Verkoop van fietsen, ski's, kampeerspullen, jeu-de-boule-ballen, voetbal- en rugbyspullen, kleding, schoenen, badkleding, fiets- en klimaccessoires, rugzakken. Verhuur en reparatie van fietsen en ski's."
    ]
  },
  "rdfs:label": {
    "en": [
      "Bike store and workshop, outdoor sports equipment - Yéti !"
    ],
    "fr": [
      "Magasin et atelier vélo, équipement sports outdoor - Yéti !"
    ],
    "nl": [
      "Fietsenwinkel en werkplaats, buitensportartikelen - Yéti !"
    ]
  },
