  "rdfs:comment": {
    "de": [
      "Im Herzen der Monts du Lyonnais freuen sich Hervé und Sophie Coche, Sie im Nézel Restaurant begrüßen zu dürfen. Sie werden eine Küche in der ganzen Tradition des Terroirs in einem beruhigenden Rahmen entdecken, in dem wir hoffen, Ihre 5 Sinne zu wecken."
    ],
    "en": [
      "In the heart of the Monts du Lyonnais, Hervé and Sophie Coche are pleased to welcome you to the Nézel Restaurant. You will discover traditional, regional cuisine in a relaxing atmosphere where we hope to stimulate your 5 senses."
    ],
    "it": [
      "Nel cuore dei Monts du Lyonnais, Hervé e Sophie Coche sono lieti di darvi il benvenuto al ristorante Nézel. Scoprirete una cucina tradizionale locale in un ambiente rilassante dove speriamo di risvegliare i vostri cinque sensi."
    ],
    "fr": [
      "En plein coeur des Monts du Lyonnais, Hervé et Sophie Coche ont le plaisir de vous accueillir au Nézel Restaurant. Vous allez découvrir une cuisine dans toute la tradition du terroir dans un cadre apaisant où nous espérons éveiller vos 5 sens."
    ],
    "nl": [
      "In het hart van de Monts du Lyonnais verwelkomen Hervé en Sophie Coche u graag in restaurant Nézel. U zult een traditionele lokale keuken ontdekken in een rustgevende omgeving waar we hopen uw vijf zintuigen te prikkelen."
    ],
    "es": [
      "En el corazón de los Monts du Lyonnais, Hervé y Sophie Coche se complacen en darle la bienvenida al restaurante Nézel. Descubrirá una cocina tradicional local en un entorno relajante en el que esperamos despertar sus cinco sentidos."
    ]
  },
