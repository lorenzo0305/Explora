  "rdfs:comment": {
    "de": [
      "Seit 40 Jahren empfängt Sie Ski Cool in Val Thorens in einem Geist der Freundlichkeit und des Teilens, um Ihnen einen außergewöhnlichen Aufenthalt in unserem schönen Skiort und in Les 3 Vallées zu ermöglichen."
    ],
    "en": [
      "For 40 years, Ski Cool in Val Thorens has been welcoming you in a spirit of conviviality and sharing so that you can enjoy an exceptional stay in our beautiful resort and in Les 3 Vallées."
    ],
    "it": [
      "Da 40 anni, Ski Cool in Val Thorens vi accoglie in uno spirito di convivialità e condivisione per farvi trascorrere un soggiorno eccezionale nella nostra bella località e a Les 3 Vallées."
    ],
    "fr": [
      "Depuis 40 ans, Ski Cool à Val Thorens vous accueille dans un esprit de convivialité et de partage afin de vous faire passer un séjour exceptionnel dans notre belle station et dans Les 3 Vallées."
    ],
    "nl": [
      "Ski Cool in Val Thorens verwelkomt je al 40 jaar in een geest van gezelligheid en delen, zodat je kunt genieten van een uitzonderlijk verblijf in ons mooie resort en in Les 3 Vallées."
    ],
    "es": [
      "Desde hace 40 años, Ski Cool en Val Thorens le acoge en un espíritu de convivencia y de compartir para que disfrute de una estancia excepcional en nuestra bonita estación y en Les 3 Vallées."
    ]
  },
  "rdfs:label": {
