  "rdfs:comment": {
    "de": [
      "Zur Feier seines 30-jährigen Bestehens lädt der Verein Montélimar Mosaïque Sie ein, eine Ausstellung zu entdecken, die Fragen zur Gleichheit und zu den verschiedenen Kriterien der Diskriminierung stellt."
    ],
    "en": [
      "To celebrate its 30th anniversary, the Montélimar Mosaïque association invites you to discover an exhibition that looks at equality and the different criteria for discrimination."
    ],
    "it": [
      "Per celebrare il suo 30° anniversario, l'associazione Mosaico di Montélimar vi invita a scoprire una mostra che analizza l'uguaglianza e i diversi criteri di discriminazione."
    ],
    "fr": [
      "Pour fêter ses 30 ans, l'association Montélimar Mosaïque vous invite à découvrir une exposition qui interroge sur l'égalité et les différents critères de discrimination."
    ],
    "nl": [
      "Ter gelegenheid van haar 30e verjaardag nodigt de vereniging Montélimar Mosaïque je uit voor een tentoonstelling over gelijkheid en de verschillende criteria voor discriminatie."
    ],
    "es": [
      "Para celebrar su 30 aniversario, la asociación Montélimar Mosaïque le invita a descubrir una exposición que aborda la igualdad y los diferentes criterios de discriminación."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Exposition : L'égalité, parlons-en !"
    ]
  },
