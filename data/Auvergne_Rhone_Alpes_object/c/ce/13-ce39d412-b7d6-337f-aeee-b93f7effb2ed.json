  "rdfs:comment": {
    "de": [
      "L'atelier de Chloé ist ein Atelier in den schönen Bergen der Alpen, im Herzen von Savoyen, das von Chloé im Juli 2024 gegründet wurde.\r\n\r\nDesignerin von bestickten Textilien und gravierten Objekten Made in Savoie \"Ich personalisiere Ihre Textilien und Objekte!\""
    ],
    "en": [
      "L?atelier de Chloé is a workshop located in the beautiful Alps, in the heart of Savoie, created by Chloé in July 2024.\r\n\r\nCreator of embroidered textiles and engraved objects Made in Savoie \"I personalize your textiles and objects!\""
    ],
    "it": [
      "L'atelier di Chloé è un laboratorio situato tra le splendide montagne delle Alpi, nel cuore della Savoia, creato da Chloé nel luglio 2024.\r\n\r\nDesigner di tessuti ricamati e oggetti incisi Made in Savoia \"Personalizzo i vostri tessuti e oggetti!\""
    ],
    "fr": [
      "L’atelier de Chloé, c’est un atelier situé dans les belles montagnes des Alpes, au cœur de la Savoie, créé par Chloé en Juillet 2024. \r\n\r\nCréatrice de textiles brodés et d'objets gravés Made in Savoie \"je personnalise vos textiles et objets !\""
    ],
    "nl": [
      "L'atelier de Chloé is een atelier in de prachtige bergen van de Alpen, in het hart van de Savoie, opgericht door Chloé in juli 2024.\r\n\r\nOntwerper van geborduurd textiel en gegraveerde objecten Made in Savoie \"Ik personaliseer uw textiel en objecten!\""
    ],
    "es": [
      "L'atelier de Chloé es un taller situado en las bellas montañas de los Alpes, en el corazón de Saboya, creado por Chloé en julio de 2024.\r\n\r\nDiseñador de textiles bordados y objetos grabados Made in Savoie \"¡Personalizo sus textiles y objetos!\""
    ]
  },
