  "rdfs:comment": {
    "de": [
      "Restaurant inmitten der Natur und in ruhiger Lage. Der Besitzer Pascal Premat kocht für Sie regionale Spezialitäten und Kreationen mit savoyischem Einschlag. Gepflegter Empfang durch Jocelyne."
    ],
    "en": [
      "Very calm setting, located in the middle of nature. The owner, Pascal Premat, prepares local specialties and creates an interesting cuisine with a hint of Savoie. Jocelyne is your attentive host."
    ],
    "it": [
      "Ristorante in mezzo alla natura e in un luogo tranquillo. Pascal Premat, il proprietario, cucina per voi specialità regionali e creazioni con accento savoiardo. Jocelyne vi accoglie con cura."
    ],
    "fr": [
      "Restaurant en pleine nature et au calme. Pascal Premat, propriétaire, cuisine pour vous des spécialités régionales et des créations aux accents savoyards. Accueil soigné par Jocelyne."
    ],
    "es": [
      "Restaurante en plena naturaleza y en un lugar tranquilo. Pascal Premat, el propietario, cocina para usted especialidades y creaciones regionales con acento saboyano. Jocelyne le da la bienvenida con cuidado."
    ],
    "nl": [
      "Een restaurant midden in de natuur, in een rustige omgeving. Eigenaar Pascal Premat kookt regionale specialiteiten en creaties met een Savoyaards tintje. Een warm welkom van Jocelyne."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant Les Prodains"
    ]
  },
