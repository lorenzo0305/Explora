      "dc:description": {
        "de": [
          "Die Chevaliers du Créquier organisieren das Tournoi du Créquier im Schloss von Fressin\nWir treffen uns am 23. und 24. August ab 10 Uhr!\nEintritt 5 ? - Informationen unter 03 21 86 56 11"
        ],
        "en": [
          "The Chevaliers du Créquier organize the Tournoi du Créquier at Château de Fressin\nSee you from 10 a.m. on August 23 and 24!\nAdmission 5? - Information on 03 21 86 56 11"
        ],
        "it": [
          "Gli Chevaliers du Créquier organizzano il Tournoi du Créquier al Château de Fressin\nCi vediamo il 23 e 24 agosto dalle ore 10!\nIngresso: 5? - Per maggiori informazioni, chiamare il numero 03 21 86 56 11"
        ],
        "fr": [
          "Les Chevaliers du Créquier organise le Tournoi du Créquier au Château de Fressin\nRendez-vous à partir de 10h le 23 et 24 août prochain !\nEntrée 5€ - Informations au 03 21 86 56 11"
        ],
        "es": [
          "Los Chevaliers du Créquier organizan el Tournoi du Créquier en el Château de Fressin\n¡Nos vemos a partir de las 10 h los días 23 y 24 de agosto!\nEntrada: 5? - Para más información, llame al 03 21 86 56 11"
        ],
        "nl": [
          "De Chevaliers du Créquier organiseren het Tournoi du Créquier op het Château de Fressin\nTot ziens vanaf 10 uur op 23 en 24 augustus!\nToegangsprijs: 5? - Voor meer informatie, bel 03 21 86 56 11"
        ]
      },
