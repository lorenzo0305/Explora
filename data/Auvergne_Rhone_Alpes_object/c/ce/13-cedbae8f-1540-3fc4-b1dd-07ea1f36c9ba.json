  "rdfs:comment": {
    "de": [
      "Le Saint-Gal ist ein Bar-Restaurant im Stadtzentrum von Langeac, das Snacks, hausgemachte Tagesgerichte in der Nebensaison und süße und herzhafte Crêpes in der Sommersaison sowie Brunch an jedem Sonntagmorgen im Jahr anbietet."
    ],
    "en": [
      "Le Saint-Gal is a bar-restaurant in the center of Langeac, offering snacks, homemade dishes of the day in the off-season and sweet and savory crêpes in the summer, as well as brunches every Sunday morning throughout the year."
    ],
    "it": [
      "Le Saint-Gal è un bar-ristorante nel centro di Langeac che offre spuntini, piatti del giorno fatti in casa in bassa stagione e crêpes dolci e salate in estate, oltre a brunch ogni domenica mattina durante tutto l'anno."
    ],
    "fr": [
      "Le Saint-Gal est un bar-restaurant en centre ville de Langeac qui propose du snack, des plats du jour fait maison en hors saison et des crêpes salées ou sucrées pour la saison estivales, ainsi des brunchs tous les dimanches matins de l'année."
    ],
    "nl": [
      "Le Saint-Gal is een bar-restaurant in het centrum van Langeac met snacks, huisgemaakte dagschotels in het laagseizoen en zoete en hartige crêpes in de zomer, evenals brunches elke zondagochtend gedurende het hele jaar."
    ],
    "es": [
      "Le Saint-Gal es un bar-restaurante situado en el centro de Langeac que ofrece aperitivos, platos caseros del día en temporada baja y crepes dulces y salados en verano, así como brunches todos los domingos por la mañana durante todo el año."
    ]
  },
  "rdfs:label": {
