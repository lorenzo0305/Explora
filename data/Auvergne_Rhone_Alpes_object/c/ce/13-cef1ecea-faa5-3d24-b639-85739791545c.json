  "rdfs:comment": {
    "de": [
      "Willkommen in Vyonnais, vor Ort oder zum Mitnehmen genießen Sie unsere traditionellen Croque-monsieurs salzig, aber auch süß, die zum Nachtisch oder als Snack genossen werden können"
    ],
    "en": [
      "Welcome to the Vyonnais, on the spot or to take away, come and taste our traditional croque monsieur, both savoury and sweet, which can be eaten as a dessert or as a snack"
    ],
    "it": [
      "Benvenuti nel Vyonnais, sul posto o da asporto, venite a gustare i nostri croque-monsieurs tradizionali, sia salati che dolci, che possono essere consumati come dessert o come spuntino"
    ],
    "fr": [
      "Bienvenue au Vyonnais, sur place ou à emporter venez déguster nos traditions croque-monsieurs salés mais aussi sucrés pouvant être dégustés au moment du dessert ou du goûter"
    ],
    "nl": [
      "Welkom bij de Vyonnais, ter plaatse of om mee te nemen, kom proeven van onze traditionele croque monsieur, zowel hartig als zoet, die kan worden gegeten als dessert of als tussendoortje"
    ],
    "es": [
      "Bienvenido al Vyonnais, en el lugar o para llevar, venga a degustar nuestros tradicionales croque-monsieurs, tanto salados como dulces, que se pueden comer como postre o como merienda"
    ]
  },
