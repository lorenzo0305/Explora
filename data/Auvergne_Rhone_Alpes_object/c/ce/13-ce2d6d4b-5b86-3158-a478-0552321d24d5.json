  "rdfs:comment": {
    "de": [
      "Ein Augenblick unserer Erde, der für das Vergnügen der Sinne einfriert. Rohe, von jeglicher Giftigkeit entblößte Objekte für Ihr Universum. Willkommen."
    ],
    "en": [
      "A sublime moment  frozen in time for the pleasure of the senses. Natural crafted objects, free of all toxicity for your environment. Welcome."
    ],
    "it": [
      "Un momento della nostra terra che si congela per il piacere dei sensi. Oggetti grezzi, spogliati di ogni tossicità per il vostro universo. Benvenuti nel mondo."
    ],
    "fr": [
      "Un instant de notre terre qui se fige pour le plaisir des sens. Objets bruts, dénudés de toute toxicité pour votre univers. Bienvenue."
    ],
    "es": [
      "Un momento de nuestra tierra que se congela para el placer de los sentidos. Objetos crudos, despojados de toda toxicidad para su universo. Bienvenido al mundo."
    ],
    "nl": [
      "Een uniek moment waarbij uw zintuigen optimaal worden geprikkeld. Onbewerkte voorwerpen, zonder giftige en schadelijke stoffen. Welkom."
    ]
  },
