  "rdfs:comment": {
    "de": [
      "Viet vo Dao. Ab 6 Jahren\r\nFür alle zugänglich.\r\nKomplette Kampfkunst, die ein Bewusstsein für den eigenen Körper durch Angriffs- und Verteidigungstechniken mit bloßen Händen oder Waffen (Stock, Säbel...) vermittelt.\r\nDas Ziel: Selbstbeherrschung"
    ],
    "en": [
      "Viet vo Dao. Ages 6 and up\r\nAccessible to all.\r\nA complete martial art that teaches body awareness through attack and defense techniques using bare hands or weapons (stick, saber, etc.).\r\nThe goal: self-mastery"
    ],
    "it": [
      "Viet vo Dao. Da 6 anni\r\nAccessibile a tutti.\r\nUn'arte marziale completa che propone la consapevolezza del proprio corpo attraverso tecniche di attacco e difesa a mani nude o con armi (bastone, sciabola...)\r\nL'obiettivo: l'autocontrollo"
    ],
    "fr": [
      "Viet vo Dao. Dès 6 ans\r\nAccessible à tous.\r\nArt martial complet qui propose une prise de conscience de son corps par le biais de technique d'attaque et de défense à mains nues ou avec armes (baton, sabre..)\r\nLe but : la maîtrise de soi"
    ],
    "nl": [
      "Viet vo Dao. Vanaf 6 jaar\r\nToegankelijk voor iedereen.\r\nEen complete krijgskunst die lichaamsbewustzijn aanleert door middel van aanvals- en verdedigingstechnieken met blote handen of wapens (stok, sabel, enz.).\r\nHet doel: zelfbeheersing"
    ],
    "es": [
      "Viet vo Dao. A partir de 6 años\r\nAccesible para todos.\r\nUn arte marcial completo que propone un conocimiento del propio cuerpo a través de técnicas de ataque y defensa con las manos desnudas o con armas (bastón, sable..)\r\nEl objetivo: el autocontrol"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Dong Fang Hong lONG"
    ]
  },
