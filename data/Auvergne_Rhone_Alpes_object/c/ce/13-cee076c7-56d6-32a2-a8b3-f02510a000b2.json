  "rdfs:comment": {
    "de": [
      "Nur einen Katzensprung vom Stadtzentrum entfernt, inmitten eines jahrhundertealten Gartens, können Sie die überraschenden und vielfältigen Sammlungen des Musée Crozatier entdecken. Ein Ort für die ganze Familie, der Tradition und Moderne verbindet."
    ],
    "en": [
      "Just a stone's throw from the city center, in the heart of a centuries-old garden, discover the surprising and varied collections of the Crozatier Museum. A place for the whole family, combining tradition and modernity."
    ],
    "it": [
      "A due passi dal centro città, nel cuore di un giardino secolare, scoprite le sorprendenti e varie collezioni del Museo Crozatier. Un luogo per tutta la famiglia che unisce tradizione e modernità."
    ],
    "fr": [
      "À deux pas du centre-ville, au cœur d’un jardin séculaire, découvrez les collections surprenantes et variées du musée Crozatier. Un lieu pour toute la famille alliant tradition et modernité."
    ],
    "nl": [
      "Op een steenworp afstand van het stadscentrum, in het hart van een eeuwenoude tuin, ontdekt u de verrassende en gevarieerde collecties van het Crozatier Museum. Een plek voor het hele gezin die traditie en moderniteit combineert."
    ],
    "es": [
      "A dos pasos del centro de la ciudad, en el corazón de un jardín centenario, descubra las sorprendentes y variadas colecciones del Museo Crozatier. Un lugar para toda la familia que combina tradición y modernidad."
    ]
  },
