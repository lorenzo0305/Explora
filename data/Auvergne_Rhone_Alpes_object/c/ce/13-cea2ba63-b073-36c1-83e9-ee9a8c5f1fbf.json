  "rdfs:comment": {
    "de": [
      "Die Pont des Fayettes ist eine Straßenbrücke über den Fluss La Bonne in der Gemeinde Valbonnais. Sie ist ein seltenes Exemplar einer überdachten Brücke in Frankreich."
    ],
    "en": [
      "The Pont des Fayettes is a road bridge over the River Bonne in the commune of Valbonnais. It is a rare example of a covered bridge in France."
    ],
    "it": [
      "Il Pont des Fayettes è un ponte stradale sul fiume Bonne nel comune di Valbonnais. È un raro esempio di ponte coperto in Francia."
    ],
    "fr": [
      "Le pont des Fayettes est un pont routier sur la rivière la Bonne, sur la commune de Valbonnais. C'est un spécimen rare de pont couvert en France."
    ],
    "es": [
      "El Pont des Fayettes es un puente de carretera sobre el río Bonne, en el municipio de Valbonnais. Es un raro ejemplo de puente cubierto en Francia."
    ],
    "nl": [
      "De Pont des Fayettes is een verkeersbrug over de rivier de Bonne in de gemeente Valbonnais. Het is een zeldzaam voorbeeld van een overdekte brug in Frankrijk."
    ]
  },
