  "rdfs:comment": {
    "de": [
      "Dieses unumgängliche libanesische Restaurant im Herzen der Altstadt von Lyon bietet ein kulinarisches Erlebnis voller authentischer Aromen, perfekt für eine Gourmetpause nach einem Spaziergang durch die historischen Gassen."
    ],
    "en": [
      "Located in the heart of Old Lyon, this must-visit Lebanese restaurant offers a culinary experience rich in authentic flavours, perfect for a gourmet break after a stroll through the historic streets."
    ],
    "it": [
      "Situato nel cuore della Vieux-Lyon, questo imperdibile ristorante libanese offre un'esperienza culinaria ricca di sapori autentici, perfetta per una pausa gastronomica dopo una passeggiata nelle vie storiche."
    ],
    "fr": [
      "Situé en plein cœur du Vieux-Lyon, ce restaurant libanais incontournable propose une expérience culinaire riche en saveurs authentiques, parfaite pour une pause gourmande après une promenade dans les ruelles historiques."
    ],
    "es": [
      "Situado en el corazón del Vieux-Lyon, este restaurante libanés de visita obligada ofrece una experiencia culinaria rica en sabores auténticos, perfecta para una pausa gastronómica tras un paseo por las calles históricas."
    ],
    "nl": [
      "Dit Libanese restaurant in het hart van Vieux-Lyon is een must-visit en biedt een culinaire ervaring rijk aan authentieke smaken, perfect voor een gastronomische pauze na een wandeling door de historische straten."
    ]
  },
