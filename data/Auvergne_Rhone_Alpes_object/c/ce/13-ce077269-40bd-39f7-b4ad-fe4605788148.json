  "rdfs:comment": {
    "de": [
      "Von Marion Kormann, Dokumentalistin, zusammengestellte Ausstellung.\r\n50 Tafeln, die über Feminismus, Bildung, Frauen unter dem Vichy-Regime und in der Résistance berichten.\r\nEin pädagogisches Begleitheft, das vom Team der BU erstellt wurde, begleitet die Ausstellung."
    ],
    "en": [
      "Exhibition created by Marion Kormann, librarian.\r\n50 panels on feminism, education, women under the Vichy regime and in the Resistance.\r\nAn educational booklet, produced by the BU team, accompanies the exhibition."
    ],
    "it": [
      "Mostra creata da Marion Kormann, bibliotecaria.\r\n50 pannelli sul femminismo, l'istruzione e le donne sotto il regime di Vichy e nella Resistenza.\r\nLa mostra è accompagnata da un opuscolo didattico realizzato dall'équipe della BU."
    ],
    "fr": [
      "Exposition réalisée par Marion Kormann, documentaliste.\r\n50 panneaux qui parlent du féminisme, de l'éducation, des femmes sous le Régime de Vichy et dans la Résistance.\r\nUn livret pédagogique, réalisé par l'équipe de la BU, accompagne l'exposition."
    ],
    "nl": [
      "Tentoonstelling gemaakt door Marion Kormann, bibliothecaresse.\r\n50 panelen over feminisme, onderwijs en vrouwen onder het Vichy-regime en in het verzet.\r\nBij de tentoonstelling hoort een educatief boekje, gemaakt door het BU-team."
    ],
    "es": [
      "Exposición creada por Marion Kormann, bibliotecaria.\r\n50 paneles sobre el feminismo, la educación y las mujeres bajo el régimen de Vichy y en la Resistencia.\r\nUn folleto pedagógico, realizado por el equipo de la BU, acompaña la exposición."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les droits des femmes, vers l'égalité"
    ]
  },
