      "dc:description": {
        "de": [
          "Kommen Sie zu uns auf die Esplanade de Sainte Cécile, um die Gruppe \"Marée Basse\" zu entdecken, die eine große Auswahl an französischen Sorten anbietet."
        ],
        "en": [
          "Join us on the Esplanade de Sainte Cécile to discover the group \"Marée Basse\", offering a wide choice of French varieties."
        ],
        "it": [
          "Venite a trovarci sull'Esplanade de Sainte Cécile per scoprire il gruppo \"Marée Basse\", che propone un'ampia scelta di varietà francesi."
        ],
        "fr": [
          "Venez nous rejoindre sur l'Esplanade de Sainte Cécile pour découvrir le groupe \"Marée Basse\", qui propose un large choix de variétés Française."
        ],
        "nl": [
          "Kom naar de Esplanade de Sainte Cécile en ontdek de groep \"Marée Basse\", die een ruime keuze aan Franse variëteiten biedt."
        ],
        "es": [
          "Acompáñenos en la explanada de Sainte Cécile para descubrir al grupo \"Marée Basse\", que le ofrece una amplia selección de variedades francesas."
        ]
      },
