  "rdfs:comment": {
    "de": [
      "\"Lust, eine originelle Küche zu entdecken, die aus frischen, saisonalen Produkten besteht und in der Glut gegart wird?\r\nLernen Sie uns kennen und genießen Sie einen Moment mit der Familie oder mit Freunden in Bords de Saône."
    ],
    "en": [
      "\"Would you like to discover an original cuisine made with fresh, seasonal products and cooked over an open fire?\r\nCome and meet us and enjoy a moment with family or friends on the banks of the Saône."
    ],
    "it": [
      "\"Volete scoprire una cucina originale a base di prodotti freschi e di stagione, cucinati a fuoco aperto?\r\nVenite a trovarci e godetevi un momento in famiglia o con gli amici sulle rive della Saona."
    ],
    "fr": [
      "\" Envie de découvrir une cuisine originale faite à base de produits frais, de saison et cuits à la Braise ? \r\nVenez nous rencontrer et profiter d'un moment en famille ou entre amis en Bords de Saône."
    ],
    "es": [
      "\"¿Le apetece descubrir una cocina original elaborada con productos frescos de temporada y cocinada a la brasa?\r\nVenga a conocernos y disfrute de un momento en familia o entre amigos a orillas del Saona."
    ],
    "nl": [
      "\"Wilt u een originele keuken ontdekken op basis van verse, seizoensgebonden producten en gekookt boven een open vuur?\r\nKom kennismaken en geniet van een moment met familie of vrienden aan de oevers van de Saône."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant Braises et Condiments"
    ]
  },
