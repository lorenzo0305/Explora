  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Sammlungen, die mit diesem symbolträchtigen Berg verbunden sind, und begeben Sie sich auf die Spuren der Männer und Frauen, die ihn erobert haben."
    ],
    "en": [
      "Discover the collections linked to this emblematic mountain and follow in the footsteps of the men and women who conquered it."
    ],
    "it": [
      "Scoprite le collezioni legate a questa montagna emblematica e seguite le orme degli uomini e delle donne che l'hanno conquistata."
    ],
    "fr": [
      "Découvrez les collections liées à cette montagne emblématique et partez sur les traces des hommes et des femmes qui l'ont conquise."
    ],
    "nl": [
      "Ontdek de collecties die verbonden zijn met deze emblematische berg en treed in de voetsporen van de mannen en vrouwen die deze berg veroverden."
    ],
    "es": [
      "Descubra las colecciones vinculadas a esta emblemática montaña y siga los pasos de los hombres y mujeres que la conquistaron."
    ]
  },
  "rdfs:label": {
