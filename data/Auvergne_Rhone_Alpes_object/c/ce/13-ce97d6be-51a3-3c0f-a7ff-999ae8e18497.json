  "rdfs:comment": {
    "de": [
      "Die unterirdischen Schätze und das Bergbauerbe des Beaufortain und ihre Geschichte zu entdecken, ist das Ziel des neuen Abenteuers \"Le secret du bagnard\" (Das Geheimnis des Sträflings), das von der Station Arêches-Beaufort angeboten wird."
    ],
    "en": [
      "Discovering the underground treasures and mining heritage of Beaufortain and their history, this is the goal of the new adventure \"Le secret du bagnard\" proposed by the station of Arêches-Beaufort."
    ],
    "it": [
      "Scoprire i tesori sotterranei e il patrimonio minerario del Beaufortain e la loro storia: questo è l'obiettivo della nuova avventura \"Le secret du bagnard\" (Il segreto del galeotto) proposta dalla stazione di Arêches-Beaufort."
    ],
    "fr": [
      "Partir à la découverte des trésors souterrains et du patrimoine miniers du Beaufortain et de leur histoire, tel est l'objectif de la nouvelle aventure \"Le secret du bagnard\" proposée par la station d’Arêches-Beaufort."
    ],
    "nl": [
      "Ontdek de ondergrondse schatten en het mijnerfgoed van Beaufortain en hun geschiedenis, dit is het doel van het nieuwe avontuur \"Le secret du bagnard\" voorgesteld door het station van Arêches-Beaufort."
    ],
    "es": [
      "Descubrir los tesoros subterráneos y el patrimonio minero de Beaufortain y su historia, ése es el objetivo de la nueva aventura \"Le secret du bagnard\" (El secreto del convicto) que propone la estación de Arêches-Beaufort."
    ]
  },
  "rdfs:label": {
    "en": [
      "The mystery of the mines of Arêches Beaufort"
    ],
    "fr": [
      "Le mystère des mines d'Arêches Beaufort"
    ],
    "nl": [
      "Het mysterie van de mijnen van Arêches Beaufort"
    ]
  },
