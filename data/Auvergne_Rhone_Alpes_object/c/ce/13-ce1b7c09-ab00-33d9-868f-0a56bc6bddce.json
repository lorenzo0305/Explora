  "rdfs:comment": {
    "de": [
      "Florian Legrand bietet das ganze Jahr über Fotokurse im Pays d'Evian und im Vallée d'Abondance zu Themen wie Tierfotografie, Landschaftsfotografie, Astrofotografie oder Makrofotografie an."
    ],
    "en": [
      "All year round, Florian Legrand offers photo workshops in the Evian region and the Vallée d'Abondance on subjects such as wildlife photography, landscapes, astrophotography and macro photography."
    ],
    "it": [
      "Durante tutto l'anno, Florian Legrand offre corsi di fotografia nella regione di Evian e nella Vallée d'Abondance su temi quali la fotografia naturalistica, i paesaggi, l'astrofotografia e la macrofotografia."
    ],
    "fr": [
      "Florian Legrand propose toute l’année des stages photo dans le Pays d’Evian et la vallée d’Abondance sur des thèmes comme la photographie animalière, le paysage, l’astrophotographie ou encore la macrophotographie."
    ],
    "nl": [
      "Florian Legrand biedt het hele jaar door fotocursussen aan in de regio Evian en de Vallée d'Abondance over onderwerpen als natuurfotografie, landschappen, astrofotografie en macrofotografie."
    ],
    "es": [
      "Durante todo el año, Florian Legrand ofrece cursos de fotografía en la región de Evian y el Valle de Abondance sobre temas como la fotografía de fauna, paisajes, astrofotografía y macrofotografía."
    ]
  },
