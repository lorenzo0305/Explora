  "rdfs:comment": {
    "de": [
      "Jahrhunderts von Gilbert de Chabannes, dem Herrn von Madic, gegründet und markiert die Gründung der unabhängigen Pfarrei des Dorfes, das damals zu Ydes gehörte."
    ],
    "en": [
      "Founded at the end of the 15th century by Gilbert de Chabannes, Seigneur de Madic, this church marks the creation of an independent parish for the village, which was then attached to Ydes."
    ],
    "it": [
      "Fondata alla fine del XV secolo da Gilbert de Chabannes, signore di Madic, questa chiesa segna la creazione di una parrocchia indipendente per il villaggio, allora annesso a Ydes."
    ],
    "fr": [
      "Fondée à la fin du XVe siècle par Gilbert de Chabannes, seigneur de Madic, cette église marque la création de la paroisse indépendante du village, alors rattaché à Ydes."
    ],
    "es": [
      "Fundada a finales del siglo XV por Gilbert de Chabannes, señor de Madic, esta iglesia marca la creación de una parroquia independiente para el pueblo, entonces adscrito a Ydes."
    ],
    "nl": [
      "Deze kerk werd aan het einde van de 15e eeuw gesticht door Gilbert de Chabannes, heer van Madic, en markeert de oprichting van een onafhankelijke parochie voor het dorp, dat toen nog bij Ydes hoorde."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Église Saint-Quirin, Saint-Eutrope"
    ]
  },
