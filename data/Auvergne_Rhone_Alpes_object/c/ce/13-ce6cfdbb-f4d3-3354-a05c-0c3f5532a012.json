  "rdfs:comment": {
    "de": [
      "Dieses Restaurant ist auf Fisch, Meeresfrüchte und Bouillabaisse sowie auf Pizzen spezialisiert. Sonntags können Sie sie auf dem Markt von Charavines treffen, um neben dem Tourismusbüro leckere Austern zu probieren."
    ],
    "en": [
      "Our restaurant specializes in fish, seafood and bouillabaisse. On Sundays, enjoy delicious oysters and a breathtaking view of the lake."
    ],
    "it": [
      "Questo ristorante è specializzato in pesce, frutti di mare e bouillabaisse, oltre che in pizze. La domenica li trovate al mercato di Charavines, a degustare deliziose ostriche accanto all'ufficio turistico."
    ],
    "fr": [
      "Ce restaurant est spécialisé dans le poisson, les fruits de mer et la bouillabaisse, ainsi que les pizzas. Les dimanches vous pouvez les retrouver sur le marché de Charavines pour déguster de délicieuses huîtres à côté de l’office du tourisme."
    ],
    "es": [
      "Este restaurante está especializado en pescado, marisco y bullabesa, así como en pizzas. Los domingos se les puede encontrar en el mercado de Charavines, degustando deliciosas ostras junto a la oficina de turismo."
    ],
    "nl": [
      "Dit restaurant is gespecialiseerd in vis, zeevruchten en bouillabaisse, maar ook in pizza's. Op zondag kun je ze vinden op de Charavines markt, waar ze heerlijke oesters proeven naast het toeristenbureau."
    ]
  },
