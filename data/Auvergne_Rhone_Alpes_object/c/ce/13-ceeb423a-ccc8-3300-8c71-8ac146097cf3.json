  "rdfs:comment": {
    "de": [
      "À Travers Champs ist ein 100 % Bio-Produzentenladen, der rund hundert lokale Bauernhöfe vereint.\r\nDort finden Sie alle lokalen Produkte: Obst, Gemüse, Brot, Käse, Lebensmittel .."
    ],
    "en": [
      "À Travers Champs is a 100% organic producer store which brings together around a hundred local farms.\r\nYou will find all the local products there: fruits, vegetables, bread, cheese, groceries..."
    ],
    "it": [
      "À Travers champs è un negozio di prodotti agricoli 100% biologici che riunisce un centinaio di aziende agricole locali.\r\nTroverete tutti i prodotti locali di cui avete bisogno: frutta, verdura, pane, formaggio, alimentari..."
    ],
    "fr": [
      "À Travers champs c'est un magasin de producteurs 100 % Bio qui regroupe une centaine de fermes locales.\r\nVous y trouverez tous les produits du terroir : fruits, légumes, pain, fromage, épicerie..."
    ],
    "nl": [
      "À Travers champs is een 100% biologische boerenwinkel die ongeveer honderd lokale boerderijen samenbrengt.\r\nJe vindt er alle streekproducten die je nodig hebt: fruit, groenten, brood, kaas, kruidenierswaren..."
    ],
    "es": [
      "À Travers champs es una tienda de productos agrícolas 100% ecológicos que reúne a un centenar de granjas locales.\r\nEncontrará todos los productos locales que necesite: fruta, verdura, pan, queso, ultramarinos..."
    ]
  },
