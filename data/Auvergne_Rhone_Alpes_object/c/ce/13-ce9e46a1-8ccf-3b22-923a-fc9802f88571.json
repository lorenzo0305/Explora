  "rdfs:comment": {
    "de": [
      "Liqueurs Granier ist eine handwerkliche Destillerie in Annecy, Haute-Savoie. Unser Haus wurde von Stéphane Granier gegründet und zelebriert Tradition, Authentizität und Kreativität in jeder Flasche."
    ],
    "en": [
      "Liqueurs Granier is an artisan distillery located in Annecy, Haute-Savoie. Founded by Stéphane Granier, our house celebrates tradition, authenticity and creativity in every bottle."
    ],
    "it": [
      "Liqueurs Granier è una distilleria artigianale con sede ad Annecy, in Alta Savoia. Fondata da Stéphane Granier, la nostra azienda celebra la tradizione, l'autenticità e la creatività in ogni bottiglia."
    ],
    "fr": [
      "Liqueurs Granier est une distillerie artisanale située à Annecy, en Haute-Savoie. Fondée par Stéphane Granier, notre maison célèbre la tradition, l’authenticité et la créativité dans chaque bouteille."
    ],
    "nl": [
      "Likeuren Granier is een ambachtelijke distilleerderij gevestigd in Annecy, Haute-Savoie. Opgericht door Stéphane Granier, viert ons bedrijf traditie, authenticiteit en creativiteit in elke fles."
    ],
    "es": [
      "Licores Granier es una destilería artesanal con sede en Annecy, Alta Saboya. Fundada por Stéphane Granier, nuestra empresa celebra la tradición, la autenticidad y la creatividad en cada botella."
    ]
  },
