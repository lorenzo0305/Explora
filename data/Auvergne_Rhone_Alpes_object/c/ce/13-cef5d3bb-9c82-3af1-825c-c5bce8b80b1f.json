  "rdfs:comment": {
    "de": [
      "Das Atelier musée du chapeau empfängt Sie auf der Anlage La Chapellerie. Hier können Sie einen der letzten Zeugen der Hutmacherei von Chazelles-sur-Lyon kennenlernen, der im industriellen Stil restauriert wurde und sich der Kreativität verschrieben hat."
    ],
    "en": [
      "The Atelier-Musée du Chapeau [hat museum and workshop] welcomes you to La Chapellerie. Come and see the last of the great milliners in Chazelles-sur-Lyon, restored as a factory museum to revive the creative spirit."
    ],
    "it": [
      "L'Atelier-Musée du Chapeau vi dà il benvenuto nel sito de La Chapellerie. Venite a scoprire l'ultimo esempio di cappelleria rimasto a Chazelles-sur-Lyon, restaurato secondo lo spirito della fabbrica e orientato verso la creazione contemporanea."
    ],
    "fr": [
      "L'Atelier-Musée du Chapeau vous accueille sur le site de La Chapellerie. Venez découvrir le dernier témoin de l'activité chapelière de Chazelles-sur-Lyon, restauré dans l'esprit de l'usine et tourné vers la création contemporaine."
    ],
    "nl": [
      "Het Hoedenatelier-museum is gevestigd op La Chapellerie. Bezoek de laatste grote getuige van de hoedenindustrie van Chazelles-sur-Lyon. De restauratie van de fabriek respecteert het industriële karakter zonder het moderne te verwaarlozen."
    ],
    "es": [
      "El Atelier-Musée du Chapeau le da la bienvenida al recinto de La Chapellerie. Venga a descubrir el último ejemplo de sombrerería de Chazelles-sur-Lyon, restaurado según el espíritu de la fábrica y orientado hacia la creación contemporánea."
    ]
  },
