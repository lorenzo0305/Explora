  "rdfs:comment": {
    "de": [
      "Une mémoire pour l'avenir (Ein Gedächtnis für die Zukunft) ist ein Verein, der es sich zum Ziel gesetzt hat, das Wissen unserer Vorfahren im Bourbonnais zu erforschen, zu bewahren und weiterzugeben."
    ],
    "en": [
      "Une mémoire pour l'avenir is an association dedicated to researching, safeguarding and passing on the knowledge of our ancestors in the Bourbonnais region."
    ],
    "it": [
      "Une mémoire pour l'avenir è un'associazione dedicata alla ricerca, alla salvaguardia e alla trasmissione della conoscenza dei nostri antenati nella regione di Bourbonnais."
    ],
    "fr": [
      "Une mémoire pour l’avenir, est une association qui a pour vocation rechercher, sauvegarder et transmettre les savoirs de nos ancêtres dans le Bourbonnais."
    ],
    "nl": [
      "Une mémoire pour l'avenir is een vereniging die zich inzet voor het onderzoeken, beschermen en doorgeven van de kennis van onze voorouders in de regio Bourbonnais."
    ],
    "es": [
      "Une mémoire pour l'avenir es una asociación dedicada a investigar, salvaguardar y transmitir los conocimientos de nuestros antepasados de la región de Bourbonnais."
    ]
  },
  "rdfs:label": {
    "fr": [
