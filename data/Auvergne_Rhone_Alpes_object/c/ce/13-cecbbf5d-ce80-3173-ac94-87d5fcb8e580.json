  "rdfs:comment": {
    "de": [
      "Baumschule in Familienbesitz seit 1890. Auf einer Fläche von fast 70 Hektar werden 1600 Arten und Sorten von Obst- und Zierbäumen, Pflanzen und Sträuchern für öffentliche Einrichtungen, Gartencenter, Architekten, Landschaftsgärtner und Privatpersonen angepflanzt."
    ],
    "en": [
      "Fruit trees, rose bushes, trees for avenues and trees for shade, conifers, flowering shrubs, ornamental grasses, decorative plants."
    ],
    "it": [
      "Vivaio a conduzione familiare dal 1890. Una tenuta di quasi 70 ettari e 1600 specie e varietà di alberi da frutto, alberi ornamentali, piante e arbusti per enti locali, centri di giardinaggio, architetti, paesaggisti e privati."
    ],
    "fr": [
      "Pépinière familiale depuis 1890. Domaine de près de 70 hectares et 1600 espèces et variétés d'arbres fruitiers, d'ornement, plantes et arbustes au services des collectivités, jardineries, architectes, paysagistes et des particuliers. "
    ],
    "es": [
      "Vivero familiar desde 1890. Una finca de casi 70 hectáreas y 1600 especies y variedades de árboles frutales, ornamentales, plantas y arbustos para colectividades, centros de jardinería, arquitectos, paisajistas y particulares."
    ],
    "nl": [
      "Fruitbomen, rozenstruiken, laanbomen, schaduwbomen, coniferen, bloemstruiken, siergras, decoratieplanten."
    ]
  },
  "rdfs:label": {
