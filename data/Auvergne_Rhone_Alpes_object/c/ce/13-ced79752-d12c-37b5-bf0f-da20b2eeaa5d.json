  "rdfs:comment": {
    "de": [
      "Parfum de Jazz, das 2025 zum 26. Mal stattfindet, ist ein Jazzfestival in der Drôme Provençale, das in den Baronnies seinen Ursprung hat und sich später auf das Gebiet des Tricastin ausgedehnt hat."
    ],
    "en": [
      "Parfum de Jazz, which will celebrate its 26th edition in 2025, is a jazz festival in the Drôme provençale region, which originated in the Baronnies and has since spread to the Tricastin area."
    ],
    "it": [
      "Il Parfum de Jazz, che celebrerà la sua 26a edizione nel 2025, è un festival jazz della Drôme provenzale, nato nelle Baronnies e poi diffusosi nella zona di Tricastin."
    ],
    "fr": [
      "Parfum de Jazz, qui connaîtra en 2025 sa 26ème édition, est un festival de jazz en Drôme provençale, né dans les Baronnies et qui s'est ensuite étendu au territoire du Tricastin."
    ],
    "es": [
      "Parfum de Jazz, que celebrará su 26ª edición en 2025, es un festival de jazz de la región de Drôme provençale, que se originó en las Baronnies y luego se extendió a la zona de Tricastin."
    ],
    "nl": [
      "Parfum de Jazz, dat in 2025 zijn 26e editie viert, is een jazzfestival in de Drôme provençale dat zijn oorsprong vindt in de Baronnies en zich vervolgens uitbreidde naar de Tricastin."
    ]
  },
