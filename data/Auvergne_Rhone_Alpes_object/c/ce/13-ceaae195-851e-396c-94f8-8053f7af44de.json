  "rdfs:comment": {
    "de": [
      "Erleben Sie den \"Aufgang der drei Sonnen\" auf dem Gipfel des Mont felletin. Abfahrt um 4.15 Uhr vor dem Rathaus in Saint-Julien-Molhesabate oder um 5 Uhr in Bellevue! Die Sonne wird um 5.54 Uhr aufgehen . Frühstück auf dem Rückweg mit \"au fil des pages\" angeboten."
    ],
    "en": [
      "Attend the \"Lever des 3 soleils\" at the summit of Mont Felletin. Departure at 4.15 a.m. from Saint-Julien-Molhesabate town hall, or at 5 a.m. from Bellevue! The sun will rise at 5.54 a.m. Breakfast on the way back with \"au fil des pages\"."
    ],
    "it": [
      "Osservate il \"sorgere dei 3 soli\" sulla cima del Mont Felletin. Partenza alle 4.15 dal municipio di Saint-Julien-Molhesabate o alle 5 da Bellevue! Il sole sorgerà alle 5.54. La colazione sarà servita al ritorno con \"au fil des pages\"."
    ],
    "fr": [
      "Assistez au \"Lever des 3 soleils\" au sommet du Mont felletin. Départ à 4 h 15 du matin devant la mairie de Saint-Julien-Molhesabate, ou à 5 heures à Bellevue ! Le soleil se lèvera à 5 h 54 . petit-déjeuner offert au retour avec  au fil des pages\"."
    ],
    "es": [
      "Contemple la salida de los 3 soles en la cima del Monte Felletin. Salida a las 4.15 h desde el ayuntamiento de Saint-Julien-Molhesabate, o a las 5 h desde Bellevue El sol saldrá a las 5.54 h. A su regreso, le ofreceremos un desayuno \"au fil des pages\"."
    ],
    "nl": [
      "Bekijk de \"3 zonnen die opkomen\" op de top van de Mont Felletin. Vertrek om 4.15 uur vanaf het gemeentehuis van Saint-Julien-Molhesabate, of om 5.00 uur vanaf Bellevue! De zon komt op om 5.54 uur. Bij terugkomst is er ontbijt voorzien met \"au fil des pages\"."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Lever des 3 soleils"
    ]
  },
