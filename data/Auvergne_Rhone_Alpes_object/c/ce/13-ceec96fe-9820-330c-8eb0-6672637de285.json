  "rdfs:comment": {
    "de": [
      "The Common Line, ein Projekt von Lucas Beaufort, ist ein Kunst- und Gemeinschaftsevent, das die Essenz des Snowboardens feiert: Leidenschaft, Teilen und Freiheit. Wir sehen uns am 4. und 5. April in Avoriaz zu diesem einzigartigen Schritt."
    ],
    "en": [
      "The Common Line, a project by Lucas Beaufort, is an artistic and community-driven event celebrating the essence of snowboarding — passion, sharing, and freedom.\r\nJoin us on April 4th and 5th in Avoriaz for this unique stop of the tour."
    ],
    "it": [
      "The Common Line, un progetto di Lucas Beaufort, è un evento artistico e comunitario che celebra l'essenza dello snowboard: passione, condivisione e libertà. Vi aspettiamo il 4 e 5 aprile ad Avoriaz per questo evento unico."
    ],
    "fr": [
      "The Common Line, un projet de Lucas Beaufort, est un événement artistique et communautaire célébrant l’essence du snowboard : la passion, le partage et la liberté. Nous vous donnons rendez-vous les 4 et 5 avril à Avoriaz pour cette étape unique."
    ],
    "es": [
      "The Common Line, un proyecto de Lucas Beaufort, es un evento artístico y comunitario que celebra la esencia del snowboard: pasión, compartir y libertad. Te esperamos los días 4 y 5 de abril en Avoriaz para este evento único."
    ],
    "nl": [
      "The Common Line, een project van Lucas Beaufort, is een artistiek en gemeenschapsevenement dat de essentie van snowboarden viert — passie, samen delen en vrijheid. Kom op 4 en 5 april naar Avoriaz voor deze unieke stop van de tour."
    ]
  },
