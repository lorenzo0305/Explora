  "rdfs:comment": {
    "de": [
      "Für Groß und Klein: Nutzen Sie die eingerichtete Fläche, um den Schnee und das Gleiten zu entdecken, auf dem Schlitten/Part oder auf Skiern!"
    ],
    "en": [
      "Whatever your age, come and enjoy the Prachanié fun zone on sleds or skis!"
    ],
    "it": [
      "Grandi e piccini possono approfittare delle strutture dell'area per scoprire la neve e lo sci, su slitte, trappole o sci!"
    ],
    "fr": [
      "Pour petits et grands, profitez de l'espace aménagé à la découverte de la neige et de la glisse, en luge/paret ou à ski !"
    ],
    "es": [
      "Pequeños y mayores pueden aprovechar las instalaciones de la zona para descubrir la nieve y deslizarse, ¡en trineos, trampas o esquís!"
    ],
    "nl": [
      "Jong en oud kunnen genieten van het gebied dat is gereserveerd voor het ontdekken van sneeuw en glijden, op sleeën of op ski's!"
    ]
  },
  "rdfs:label": {
