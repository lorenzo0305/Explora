  "rdfs:comment": {
    "de": [
      "Saint-Haon-le-Vieux liegt in der Côte Roannaise, an einem Hang zwischen der Ebene von Roannaise und dem Mittelgebirge der Monts de la Madeleine."
    ],
    "en": [
      "Saint-Haon-le-Vieux is located in the Côte Roannaise, on a hillside between the Roannaise plain and the middle mountains of the Madeleine Mountains."
    ],
    "it": [
      "Saint-Haon-le-Vieux si trova nella Côte Roannaise, su una collina tra la pianura della Roannaise e le medie montagne della Madeleine."
    ],
    "fr": [
      "Saint-Haon-le-Vieux est situé en Côte Roannaise, à flanc de coteau entre la plaine roannaise et la moyenne montagne des monts de la Madeleine."
    ],
    "nl": [
      "Saint-Haon-le-Vieux ligt in de Côte Roannaise, op een heuvel tussen de Roannaise vlakte en het middengebergte van de Madeleine."
    ],
    "es": [
      "Saint-Haon-le-Vieux está situado en la Côte Roannaise, en una ladera entre la llanura de la Roannaise y los montes medios de la Madeleine."
    ]
  },
