  "rdfs:comment": {
    "de": [
      "Spaziergänge mit Eseln, Workshops auf dem Bauernhof, Kühe melken und Abend auf der Alm, Wanderungen auf den Höhen..."
    ],
    "en": [
      "Discover the village of Montaimont and its mountain pastures to experience unforgettable moments in an authentic setting: walks with donkeys, workshops on the farm, milking cows and evening in the mountain pastures, hikes on the heights ..."
    ],
    "it": [
      "Passeggiate con gli asini, laboratori in fattoria, mungitura delle mucche e serate in alpeggio, escursioni in collina..."
    ],
    "fr": [
      "Balades avec les ânes, ateliers à la ferme, traite des vaches et soirée en alpage, randonnées sur les hauteurs..."
    ],
    "nl": [
      "Wandelingen met ezels, workshops op de boerderij, koeien melken en avonden in de alpenweiden, wandelingen in de heuvels..."
    ],
    "es": [
      "Paseos con burros, talleres en la granja, ordeño de vacas y veladas en los pastos de montaña, excursiones por las colinas..."
    ]
  },
