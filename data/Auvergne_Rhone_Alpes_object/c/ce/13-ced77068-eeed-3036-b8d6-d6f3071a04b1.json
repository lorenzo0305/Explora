  "rdfs:comment": {
    "de": [
      "Seit drei Generationen bewahrt das Haus Montilienne Val Roubion ein außergewöhnliches Know-how in der Entwicklung seines Nougat in der Nähe der Ufer des Roubion in der Avenue d'Aygu 3 bis in Montélimar."
    ],
    "en": [
      "For three generations, the house of Val Roubion in Montélimar has been perpetuating an exceptional know-how in the elaboration of its nougat near the banks of the Roubion river at 3 bis Avenue d'Aygu in Montélimar."
    ],
    "it": [
      "Per tre generazioni, la casa Montilienne Val Roubion ha perpetuato un know-how eccezionale nello sviluppo del suo torrone vicino alle rive del Roubion al 3 bis Avenue d'Aygu a Montélimar."
    ],
    "fr": [
      "Depuis trois générations, la maison montilienne Val Roubion perpétue un savoir-faire exceptionnel dans l’élaboration de son nougat à proximité des berges du Roubion au 3 bis Avenue d'Aygu à Montélimar."
    ],
    "nl": [
      "Sinds drie generaties houdt het huis van Val Roubion in Montélimar een uitzonderlijke knowhow in stand bij de bereiding van zijn nougat aan de oevers van de Roubion op 3 bis Avenue d'Aygu in Montélimar."
    ],
    "es": [
      "Desde hace tres generaciones, la casa Val Roubion de Montélimar perpetúa un saber hacer excepcional en la elaboración de sus turrones cerca de las orillas del Roubion, en el 3 bis de la Avenue d'Aygu de Montélimar."
    ]
  },
