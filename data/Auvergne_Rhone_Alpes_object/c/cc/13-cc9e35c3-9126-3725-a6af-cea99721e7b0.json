  "rdfs:comment": {
    "de": [
      "Im Herzen des Dorfes Les Vans empfängt Sie das Touristeninformationsbüro Cévennes d'Ardèche, um Ihren Aufenthalt vorzubereiten. Persönliche Beratung, Karten, Ausflugstipps und ein Laden mit lokalen Produkten helfen Ihnen, die Gegend zu entdecken."
    ],
    "en": [
      "In the heart of Les Vans, the Cévennes d'Ardèche tourist information office welcomes you to help you plan your stay. Personalised advice, maps, ideas for outings and a shop selling local products to help you discover the region."
    ],
    "it": [
      "Nel cuore del villaggio di Les Vans, l'ufficio informazioni turistiche Cévennes d'Ardèche vi accoglie per aiutarvi a preparare il vostro soggiorno. Consigli personali, mappe, idee per gite e un negozio di prodotti locali per aiutarvi a scoprire la zona."
    ],
    "fr": [
      "Au cœur du village des Vans, le bureau d’information touristique Cévennes d’Ardèche vous accueille pour préparer votre séjour. Conseils personnalisés, cartes, idées de sorties et une boutique de produits locaux pour découvrir le territoire."
    ],
    "nl": [
      "In het hart van het dorp Les Vans verwelkomt het VVV-kantoor van de Cevennen d'Ardèche je om je te helpen bij de voorbereiding van je verblijf. Persoonlijk advies, kaarten, ideeën voor uitstapjes en een winkel met streekproducten om je te helpen de omgeving te ontdekken."
    ],
    "es": [
      "En el corazón del pueblo de Les Vans, la oficina de turismo de Cévennes d'Ardèche le da la bienvenida para ayudarle a preparar su estancia. Consejos personalizados, mapas, ideas para excursiones y una tienda de productos locales para descubrir la región."
    ]
  },
  "rdfs:label": {
    "en": [
      "Cévennes d'Ardèche - Bureau des Vans"
    ],
    "fr": [
      "Office de Tourisme Cévennes d'Ardèche - Bureau des Vans"
    ]
  },
