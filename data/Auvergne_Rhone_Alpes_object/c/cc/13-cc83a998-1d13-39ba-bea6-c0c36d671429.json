  "rdfs:comment": {
    "de": [
      "Claude Giraud entwirft handgefertigte Einzelstücke aus wertvollen Materialien: Messer, Schmuck, Stifte usw. Er ist leidenschaftlicher Messerschmied und leitet Kurse (Anfänger, Fortgeschrittene, Profis)."
    ],
    "en": [
      "Claude Giraud creates, from precious matters, unique handmade pieces : knives, jewelleries, pens... Pasionnate about art of cutlery, he proposes training courses (introduction, improvment, profesional)."
    ],
    "it": [
      "Claude Giraud crea pezzi unici e artigianali a partire da materiali preziosi: coltelli, gioielli, penne, ecc. Appassionato dell'arte della coltelleria, tiene corsi (introduttivi, avanzati e professionali)."
    ],
    "fr": [
      "Claude Giraud crée des pièces uniques fabriquées à la main à partir de matières précieuses : couteaux, bijoux, stylos... Passionné par l’art de la coutellerie, il encadre des stages (initiation, perfectionnement, professionnel)."
    ],
    "nl": [
      "Claude Giraud maakt unieke, handgemaakte stukken van kostbare materialen: messen, sieraden, pennen, enz. Hij is gepassioneerd door de kunst van het bestek en geeft cursussen (inleidend, gevorderd en professioneel)."
    ],
    "es": [
      "Claude Giraud crea piezas únicas y artesanales a partir de materiales preciosos: cuchillos, joyas, bolígrafos, etc. Apasionado del arte de la cuchillería, imparte cursos (de iniciación, perfeccionamiento y profesionales)."
    ]
  },
  "rdfs:label": {
    "en": [
      "Art of cutlery : Claude Giraud"
    ],
    "fr": [
      "Coutellerie d'art Claude Giraud"
    ]
  },
