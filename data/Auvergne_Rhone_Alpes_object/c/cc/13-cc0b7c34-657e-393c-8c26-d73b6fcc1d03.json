  "rdfs:comment": {
    "de": [
      "Restaurant und Brauerei,\r\nÜberdachte Terrasse im Winter und Saal im Inneren,\r\nAn schönen Tagen große Außenterrasse am Fuße des Schlosses der Herzöge von Savoyen\r\nHausgemachte Küche, frische Produkte, die in unserer Küche zubereitet werden\r\nLokale und französische Weine, Cocktails"
    ],
    "en": [
      "Restaurant-Brasserie,\r\nCovered terrace in winter and room inside,\r\nLarge outdoor terrace at the foot of the Castle of the Dukes of Savoy in fine weather\r\nHome-made cooking, fresh products prepared in our kitchen\r\nLocal and French wines, Cocktails"
    ],
    "it": [
      "Ristorante-brasserie,\r\nTerrazza coperta in inverno e sala da pranzo interna,\r\nAmpia terrazza all'aperto ai piedi del Castello dei Duchi di Savoia nella bella stagione\r\nCucina casalinga, prodotti freschi preparati nella nostra cucina\r\nVini locali e francesi, cocktail"
    ],
    "fr": [
      "Restaurant-Brasserie,\r\nTerrasse couverte en hiver et salle à l'interieur,\r\nGrande terrasse exterieure au pied du Château des Ducs de Savoie aux beaux jours\r\nCuisine maison, produits frais et préparés dans notre cuisine\r\nVins locaux et de France, Cocktails"
    ],
    "es": [
      "Restaurante-Brasería,\r\nTerraza cubierta en invierno y comedor interior,\r\nAmplia terraza al aire libre a los pies del Castillo de los Duques de Saboya cuando hace buen tiempo\r\nComida casera, productos frescos preparados en nuestra cocina\r\nVinos locales y franceses, Cócteles"
    ],
    "nl": [
      "Restaurant-Brasserie,\r\nOverdekt terras in de winter en overdekte eetzaal,\r\nGroot buitenterras aan de voet van het kasteel van de hertogen van Savoye bij mooi weer\r\nThuis koken, verse producten bereid in onze keuken\r\nLokale en Franse wijnen, cocktails"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Grand Joseph"
    ]
  },
