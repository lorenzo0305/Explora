  "rdfs:comment": {
    "de": [
      "Teilen Sie intensive Momente des Wanderns oder Gleitens, begleitet von begeisterten und herzlichen Hunden, auf den Ebenen, Pisten und Wegen des Vercors...\r\nBetreuung durch staatlich geprüfte Fachleute."
    ],
    "en": [
      "Share intense moments of hiking or sliding, accompanied by enthusiastic and warm dogs, on the plains, tracks and paths of the Vercors...\r\nSupervision by state-qualified professionals."
    ],
    "it": [
      "Condividete momenti intensi di trekking o di sci, accompagnati da cani entusiasti e simpatici, sulle pianure, le piste e i sentieri del Vercors...\r\nSupervisione da parte di professionisti qualificati dallo Stato."
    ],
    "fr": [
      "Partagez des moments intenses de randonnée ou de glisse, accompagnés par des chiens enthousiastes et chaleureux, sur les plaines, pistes et chemins du Vercors...\r\nEncadrement par des professionnels diplômés d'état."
    ],
    "nl": [
      "Deel intense momenten van wandelen of skiën, vergezeld van enthousiaste en vriendelijke honden, op de vlaktes, paden en wegen van de Vercors...\r\nToezicht door gekwalificeerde professionals."
    ],
    "es": [
      "Comparta momentos intensos de senderismo o de esquí, acompañado de perros entusiastas y simpáticos, en las llanuras, pistas y caminos del Vercors...\r\nSupervisión por parte de profesionales cualificados por el Estado."
    ]
  },
