  "rdfs:comment": {
    "de": [
      "Das Art-Terre wird von Ana geleitet, die es vor zehn Jahren gegründet hat. Sie wird von Christine unterstützt. Zusammen leiten sie ein dynamisches und aufmerksames Team, das Ihnen gerne einen schönen Tag bereitet."
    ],
    "en": [
      "L'Art-Terre is run by Ana, who founded it 9 years ago. She is assisted by Christine, and together they manage a dynamic and attentive team who are happy to help you have a great time."
    ],
    "it": [
      "L'Art-Terre è gestito da Ana, che lo ha fondato 11 anni fa. Assistita da Christine, gestisce un'équipe dinamica e attenta, che sarà lieta di farvi trascorrere un'esperienza indimenticabile."
    ],
    "fr": [
      "L'Art-Terre est mené par Ana qui l'a crée voici 11 ans. Elle est secondée par Christine, ensemble elles managent une équipe dynamique et attentive qui a plaisir à vous faire passer un très bon moment."
    ],
    "nl": [
      "L'Art-Terre wordt gerund door Ana, die het 9 jaar geleden heeft opgericht. Ze wordt bijgestaan door Christine, en samen leiden ze een dynamisch en attent team dat er graag voor zorgt dat je een geweldige tijd hebt."
    ],
    "es": [
      "L'Art-Terre está dirigido por Ana, que lo creó hace 11 años. Cuenta con la ayuda de Christine, y juntas dirigen un equipo dinámico y atento que estará encantado de que lo pases en grande."
    ]
  },
