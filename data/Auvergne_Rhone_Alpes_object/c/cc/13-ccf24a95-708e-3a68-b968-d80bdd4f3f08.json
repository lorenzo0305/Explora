  "rdfs:comment": {
    "de": [
      "Im Rahmen der Sonderausstellung \"Deportierte in Ravensbrück, 1942 - 1945\" empfängt das Museum den Historiker Philippe Mezzasalma für einen Vortrag über die aus Frankreich deportierten Frauen."
    ],
    "en": [
      "As part of the temporary exhibition \"Deported to Ravensbrück, 1942 - 1945\", the museum welcomes historian Philippe Mezzasalma for a lecture on women deported from France."
    ],
    "it": [
      "Nell'ambito della mostra temporanea \"Deportati a Ravensbrück, 1942-1945\", il museo accoglie lo storico Philippe Mezzasalma per una conferenza sulle donne deportate dalla Francia."
    ],
    "fr": [
      "Dans le cadre de l'exposition temporaire \"Déportées à Ravensbrück, 1942 - 1945\", le musée accueille l'historien Philippe Mezzasalma pour une conférence sur les femmes déportées de France."
    ],
    "es": [
      "En el marco de la exposición temporal \"Deportados a Ravensbrück, 1942-1945\", el museo recibe al historiador Philippe Mezzasalma para una conferencia sobre las mujeres deportadas de Francia."
    ],
    "nl": [
      "Als onderdeel van de tijdelijke tentoonstelling \"Gedeporteerd naar Ravensbrück, 1942-1945\", ontvangt het museum historicus Philippe Mezzasalma voor een lezing over vrouwen gedeporteerd uit Frankrijk."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Conférence - Les femmes déportées de France"
    ]
  },
