  "rdfs:comment": {
    "de": [
      "Großer Spaziergang auf dem Land, auf dem Plateau von Feydaux, durch Wälder und Felder."
    ],
    "en": [
      "A long walk in the countryside, on the Feydaux plateau, through woods and fields."
    ],
    "it": [
      "Una bella passeggiata in campagna, sull'altopiano di Feydaux, attraverso boschi e campi. L'itinerario è disponibile sull'app \"MHIKES\" e sulla nostra guida escursionistica."
    ],
    "fr": [
      "Grande balade dans la campagne, sur le plateau des Feydaux, à travers bois et champs. Balade à retrouver dans l'application \"MHIKES\" pour découvrir le parcours et dans notre guide de randonnées."
    ],
    "es": [
      "Un gran paseo por el campo, en la meseta de Feydaux, a través de bosques y campos. Encontrarás la ruta en la aplicación \"MHIKES\" y en nuestra guía de senderismo."
    ],
    "nl": [
      "Een lange wandeling op het platteland, op het plateau van Feydaux, door bossen en velden."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le tour des plateaux"
    ]
  },
