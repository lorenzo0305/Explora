  "rdfs:comment": {
    "de": [
      "Bauernhof am Ortseingang von Saoû: Weintrauben, Ziegen und Picodons. Es wird biologischer Landbau betrieben.  Direktverkauf auf dem Hof täglich von 7:30 bis 10 Uhr. Verkauf auf dem Markt von Saoû am Samstagmorgen."
    ],
    "en": [
      "Farm at the entrance to Saoû: grapes, goats and picodons. Organic farming.  Direct sales at the farm every day from 7.30am to 10am. Sale at the Saoû market on Saturday morning."
    ],
    "it": [
      "Fattoria all'ingresso di Saoû: vini, capre e picodons. Agricoltura biologica.  Vendita diretta in azienda tutti i giorni dalle 7.30 alle 10.00. Vendita al mercato di Saoû il sabato mattina. Possibilità di assistere alla mungitura delle capre dalle 7.30 alle 8.15."
    ],
    "fr": [
      "Ferme située à l'entrée de Saoû: vins, chèvres et picodons. Agriculture Biologique.  Vente directe à la ferme tous les jours de 7h30 à 10h. Vente sur le marché de Saoû le samedi matin. Possibilité d'assister à la traite des chèvre de 7h30 à 8h15."
    ],
    "es": [
      "Granja a la entrada de Saoû: vinos, cabras y picodones. Agricultura ecológica.  Venta directa en la granja todos los días de 7h30 a 10h00. Venta en el mercado de Saoû los sábados por la mañana. Posibilidad de ver cómo se ordeñan las cabras de 7.30 a 8.15 h."
    ],
    "nl": [
      "Boerderij bij de ingang van Saoû: druiven, geiten en picodons. Biologische landbouw.  Directe verkoop op de boerderij elke dag van 7.30 tot 10.00 uur. Verkoop op de markt van Saoû op zaterdagochtend."
    ]
  },
