  "rdfs:comment": {
    "de": [
      "Picknickplatz mit Tisch in der Nähe eines Kinderspielplatzes und eines City-Stadions sowie in der Nähe der Dorfkirche. Museum-Konservatorium für das landwirtschaftliche und ländliche Leben im Departement Oise in der Nähe"
    ],
    "en": [
      "Picnic area with a table near a children's playground and a city stadium, and near the village church. Museum-conservatory of the agricultural and rural life of the Oise nearby"
    ],
    "it": [
      "Area picnic con tavolo vicino a un parco giochi per bambini e a uno stadio cittadino, e vicino alla chiesa del paese. Museo-conservatorio della vita agricola e rurale dell'Oise nelle vicinanze"
    ],
    "fr": [
      "Aire de pique-nique aménagée d'une table près d'une aire de jeux pour enfants et d'un city stade, et à proximité de l'église du village. Musée-conservatoire de la vie agricole et rurale de l'Oise à proximité"
    ],
    "es": [
      "Zona de picnic con una mesa cerca de un parque infantil y un estadio municipal, y cerca de la iglesia del pueblo. Museo-conservatorio de la vida agrícola y rural del Oise en las cercanías"
    ],
    "nl": [
      "Picknickplaats met tafel in de buurt van een kinderspeelplaats en een stadsstadion, en in de buurt van de dorpskerk. Museum-conservatorium van het landbouw- en plattelandsleven van de Oise in de buurt"
    ]
  },
