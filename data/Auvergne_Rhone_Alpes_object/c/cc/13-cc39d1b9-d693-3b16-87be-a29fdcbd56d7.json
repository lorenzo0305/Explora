  "rdfs:comment": {
    "de": [
      "Die Gemeindeverwaltung von Saint Denis-les-Bourg bietet den Saal des Foyers zur Vermietung an:\r\n- An die Einwohner der Gemeinde\r\n- An Vereine der Gemeinde und externe Vereine\r\n- An die Verwaltungen\r\n- An lokale und externe Unternehmen"
    ],
    "en": [
      "The Mairie de Saint Denis-les-Bourg offers the Foyer room for rental:\r\n- Local residents\r\n- Local and outside associations\r\n- Administrations\r\n- Local and external companies"
    ],
    "it": [
      "Il Municipio di Saint Denis-les-Bourg mette a disposizione la sala del Foyer:\r\n- Residenti locali\r\n- Associazioni locali e associazioni esterne\r\n- Amministrazioni\r\n- Aziende locali ed esterne"
    ],
    "fr": [
      "La Mairie de Saint Denis-les-Bourg propose à la location la salle du Foyer : \r\n- Aux habitants de la commune\r\n- Aux Associations de la commune et associations extérieures\r\n- Aux Administrations\r\n- Aux Entreprises locales et extérieures"
    ],
    "nl": [
      "Het stadhuis van Saint Denis-les-Bourg biedt de Foyerzaal te huur aan:\r\n- Buurtbewoners\r\n- Plaatselijke verenigingen en externe verenigingen\r\n- Administraties\r\n- Lokale en externe bedrijven"
    ],
    "es": [
      "El Ayuntamiento de Saint Denis-les-Bourg ofrece en alquiler la sala Foyer:\r\n- Vecinos\r\n- Asociaciones locales y asociaciones externas\r\n- Administraciones\r\n- Empresas locales y externas"
    ]
  },
