  "rdfs:comment": {
    "de": [
      "Nur einen Steinwurf vom Stadtzentrum entfernt liegt L'aventure, ein Park im Wald, in dem Sie sich auf acht sich entwickelnden Hochseilgärten in den Bäumen (ab 3 Jahren) austoben können. Erfrischungsstände vor Ort."
    ],
    "en": [
      "Just a stone's throw from the town center, L'aventure is a forest park where you can adventure on eight progressive tree courses (from 3 years). Refreshment bar on site."
    ],
    "it": [
      "A pochi passi dal centro città, L'aventure è un parco forestale dove potrete cimentarvi in otto percorsi progressivi di arrampicata sugli alberi (dai 3 anni in su). Bar per il ristoro in loco."
    ],
    "fr": [
      "À deux pas du centre-ville, L'aventure est un parc situé en forêt dans lequel vous pourrez vous aventurer sur huit parcours accrobranche évolutifs dans les arbres (dès 3 ans). Buvette sur place."
    ],
    "nl": [
      "L'aventure, op een steenworp afstand van het stadscentrum, is een bospark waar je acht progressieve boomklimparcoursen kunt proberen (vanaf 3 jaar). Ter plaatse is er een snackbar."
    ],
    "es": [
      "A dos pasos del centro de la ciudad, L'aventure es un parque forestal en el que podrá probar ocho recorridos progresivos de escalada de árboles (a partir de 3 años). También hay un bar."
    ]
  },
  "rdfs:label": {
    "de": [
      "Abenteuer - Hochseilgarten"
    ],
    "en": [
      "L'aventure - Treetop adventure park"
    ],
    "it": [
      "L'aventure - Parco di arrampicata sugli alberi"
    ],
    "fr": [
      "L'aventure - Parc accrobranche"
    ],
    "nl": [
      "Adventure park in the treetops"
    ]
  },
