  "rdfs:comment": {
    "de": [
      "Sind Sie auf der Suche nach einem Souvenir von Ihrem Besuch in Wien? Schauen Sie sich in unserem Shop um! Zwischen Gaumenfreuden, römischen Weinen, Spielen für Kinder und handgefertigten Kreationen finden Sie hier alles, was das Herz begehrt - und sich selbst!"
    ],
    "en": [
      "Looking for a souvenir of your visit to Vienna? Take a look in our shop! From gourmet delights to Roman wines, children's games and handcrafted creations, you'll find something for everyone... and yourself!"
    ],
    "it": [
      "Cercate un souvenir della vostra visita a Vienna? Date un'occhiata al nostro negozio! Dalle delizie gastronomiche ai vini romani, dai giochi per bambini alle creazioni artigianali, troverete qualcosa per tutti e per voi stessi!"
    ],
    "fr": [
      "Vous êtes à la recherche d'un souvenir de votre passage à Vienne ? Faites un tour dans notre boutique ! Entre délices gourmands, vins romains, jeux pour enfants et créations artisanales, vous y trouverez de quoi faire plaisir à tous… et à vous-même !"
    ],
    "es": [
      "¿Busca un recuerdo de su visita a Viena? ¡Eche un vistazo a nuestra tienda! Desde delicias gourmet y vinos romanos hasta juegos infantiles y creaciones artesanales, encontrará algo para todos... ¡y para usted mismo!"
    ],
    "nl": [
      "Op zoek naar een souvenir van je bezoek aan Wenen? Neem een kijkje in onze winkel! Van gastronomische lekkernijen en Romeinse wijnen tot kinderspelletjes en handgemaakte creaties, je vindt hier voor elk wat wils? en voor jezelf!"
    ]
  },
  "rdfs:label": {
    "de": [
      "Geschäfte und Know-how"
    ],
    "en": [
      "Pavillon Shop"
    ],
    "fr": [
      "Boutique du Pavillon"
    ]
  },
