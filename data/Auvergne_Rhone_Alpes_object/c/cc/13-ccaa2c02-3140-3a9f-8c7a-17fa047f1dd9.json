  "rdfs:comment": {
    "de": [
      "Mit Blick auf den See, auf der Terrasse oder in der Veranda können Sie Fisch aus dem See oder frittierte Barsche genießen. Traditionelle Küche 10 Minuten von Aix-les-Bains entfernt."
    ],
    "en": [
      "Facing the lake, on the terrace or the veranda, come and taste lake fish or fried perch. Traditional cuisine 10 minutes from Aix-les-Bains."
    ],
    "it": [
      "Di fronte al lago, sulla terrazza o in veranda, gustate il pesce del lago o il pesce persico fritto. Cucina tradizionale a 10 minuti da Aix-les-Bains."
    ],
    "fr": [
      "Face au lac, sur la terrasse ou dans la véranda, venez déguster les poissons du lac ou la friture de perchots. Cuisine traditionnelle à 10 minutes d'Aix-les-Bains."
    ],
    "nl": [
      "Kom met uitzicht op het meer, op het terras of in de veranda, de vis uit het meer of de gebakken baars proeven. Traditionele keuken op 10 minuten van Aix-les-Bains."
    ],
    "es": [
      "Frente al lago, en la terraza o en la veranda, venga a degustar el pescado del lago o la perca frita. Cocina tradicional a 10 minutos de Aix-les-Bains."
    ]
  },
