  "rdfs:comment": {
    "de": [
      "Der Lac Bleu liegt auf fast 2000 m Höhe und blickt auf das Tal von Courchevel. Vielleicht haben Sie Glück und können fliegende Forellen beobachten."
    ],
    "en": [
      "The Blue Lake is located at an altitude of nearly 2000m and overlooks the Courchevel Valley. You may have the chance to observe flying trout."
    ],
    "it": [
      "Il Lac Bleu si trova a quasi 2000 metri di altitudine e domina la valle di Courchevel. Potreste avere la fortuna di avvistare qualche trota volante."
    ],
    "fr": [
      "Le lac Bleu est situé à près de 2000m d'altitude et donne sur la Vallée de Courchevel. Vous aurez peut-être la chance d'y observer des truites volantes."
    ],
    "nl": [
      "Lac Bleu ligt op bijna 2000 meter hoogte en kijkt uit over de vallei van Courchevel. Misschien heb je geluk en zie je vliegende forellen."
    ],
    "es": [
      "Lac Bleu está situado a casi 2000 m de altitud, con vistas al valle de Courchevel. Puede que tenga la suerte de avistar alguna trucha voladora."
    ]
  },
