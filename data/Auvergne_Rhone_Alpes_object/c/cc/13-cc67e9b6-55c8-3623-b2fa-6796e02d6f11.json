  "rdfs:comment": {
    "de": [
      "Der Étang du Chomeil in Saint-Paulien mit seiner gepflegten Pflanzenwelt ist bei Anglern mit einem gültigen Angelschein beliebt."
    ],
    "en": [
      "The Chomeil de Saint-Paulien pond, with its well-tended vegetation, is a favorite with anglers who hold a valid fishing licence."
    ],
    "it": [
      "Il lago Chomeil de Saint-Paulien, con la sua vegetazione ben curata, è molto apprezzato dai pescatori in possesso di una licenza di pesca valida."
    ],
    "fr": [
      "L’étang du Chomeil  de Saint-Paulien avec un environnement végétal soigné est prisé par les pêcheurs ayant une carte de pêche en cours de validité."
    ],
    "nl": [
      "Het meer van Chomeil de Saint-Paulien, met zijn verzorgde vegetatie, is populair bij vissers met een geldige visvergunning."
    ],
    "es": [
      "El lago de Chomeil de Saint-Paulien, con su cuidada vegetación, es popular entre los pescadores que poseen una licencia de pesca válida."
    ]
  },
