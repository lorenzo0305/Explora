  "rdfs:comment": {
    "de": [
      "Trekkingagentur und Bergführerbüro seit 1995, mit Sitz im Herzen des Massif des Bauges. Als leidenschaftliche Bergsteiger sind wir \"Schöpfer von Abenteuern\": Sportaufenthalt, Tagesaktivitäten und Ausrüstungsverleih."
    ],
    "en": [
      "The Mountain Office - Reception & information - Agency for holidays & weekends - Rental of canyoning and via ferrata equipment. Our profession: we are “adventure creators” guides and mountain guides\"."
    ],
    "it": [
      "Agenzia di trekking e ufficio guide dal 1995, con sede nel cuore del massiccio dei Bauges. Con la nostra passione per la montagna, creiamo avventure: vacanze sportive, attività giornaliere e noleggio di attrezzature."
    ],
    "fr": [
      "Agence de trekking et bureau des guides depuis 1995, basée dans le cœur du massif des Bauges. Passionnés de montagne, nous sommes des \"créateurs d'aventures\" : séjour sportif, activités à la journée et location de matériel."
    ],
    "nl": [
      "Informatie over activiteiten in de bergen - Toeristeninformatie - Verblijven & weekenden- Verhuur van canyoning en via-ferrata materiaal\r\nOns beroep: berggidsen en \"ontwerpers van avonturen\"."
    ],
    "es": [
      "Agencia de senderismo y oficina de guías desde 1995, situada en el corazón del macizo de Bauges. Con nuestra pasión por la montaña, creamos aventuras: vacaciones deportivas, actividades de un día y alquiler de material."
    ]
  },
