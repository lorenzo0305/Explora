  "rdfs:comment": {
    "de": [
      "Jahrhundert war Sedaiges ein militärischer Zufluchtsort und Zeuge und Akteur der französisch-englischen Kämpfe in der mittelalterlichen Auvergne..."
    ],
    "en": [
      "Military hideout since the 12th century, Sédaiges Castle played an important part in thre fighting between the English and the French during Medieval times in Auvergne."
    ],
    "it": [
      "Roccaforte militare fin dall'XI secolo, Sedaiges è stata testimone e protagonista delle lotte franco-inglesi nell'Alvernia medievale..."
    ],
    "fr": [
      "Repaire militaire dès le XIe siècle, Sedaiges fut témoin et acteur des luttes franco-anglaises dans l'Auvergne médiévale..."
    ],
    "es": [
      "Fortaleza militar desde el siglo XI, Sedaiges fue testigo y protagonista de las luchas franco-inglesas en la Auvernia medieval..."
    ],
    "nl": [
      "Als militair bolwerk sinds de 11e eeuw was Sedaiges getuige en speler in de Frans-Engelse strijd in de middeleeuwse Auvergne..."
    ]
  },
