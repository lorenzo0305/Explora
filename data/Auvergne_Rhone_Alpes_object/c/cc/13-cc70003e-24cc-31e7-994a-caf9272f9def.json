  "rdfs:comment": {
    "de": [
      "Das macLYON lädt Giulia Andreani für eine monografische Ausstellung ein. Unter dem Titel Kalte Malerei untersucht die Ausstellung die Repräsentation von Macht im 20. Jahrhundert, sei es in Kriegen, in der Kunst, in der offiziellen Geschichte oder in der Geschichte der Ränder."
    ],
    "en": [
      "The macLYON invites Giulia Andreani for a solo exhibition. Entitled Peinture froide (Cold Painting), the exhibition explores the representation of power in the 20th century, whether in wars, art, official history or marginalised history."
    ],
    "it": [
      "MacLYON ha invitato Giulia Andreani a presentare una mostra personale. Intitolata Peinture froide, la mostra esplora la rappresentazione del potere nel XX secolo, in termini di guerra, arte, storia ufficiale o storia dei margini."
    ],
    "fr": [
      "Le macLYON invite Giulia Andreani pour une exposition monographique. Intitulée Peinture froide, l’exposition explore la représentation des pouvoirs au 20e siècle, qu’il s’agisse de guerres, d’art, de l’histoire officielle ou de celle des marges."
    ],
    "nl": [
      "MacLYON heeft Giulia Andreani uitgenodigd voor een solotentoonstelling. Onder de titel Peinture froide onderzoekt de tentoonstelling de representatie van macht in de 20e eeuw, of het nu gaat om oorlog, kunst, officiële geschiedenis of de geschiedenis van de marges."
    ],
    "es": [
      "MacLYON ha invitado a Giulia Andreani a presentar una exposición individual. Titulada Peinture froide, la exposición explora la representación del poder en el siglo XX, ya sea en términos de guerra, arte, historia oficial o historia de los márgenes."
    ]
  },
  "rdfs:label": {
    "en": [
      "Cold paint -  Giulia Andreani"
    ],
    "fr": [
      "Exposition Peinture froide. Giulia Andreani"
    ]
  },
