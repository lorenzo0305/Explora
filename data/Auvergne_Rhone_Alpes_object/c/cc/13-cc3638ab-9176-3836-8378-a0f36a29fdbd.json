  "rdfs:comment": {
    "de": [
      "Die Auberge de Mégevette liegt inmitten der Berge von Hochsavoyen und empfängt Sie in einer warmen und authentischen Umgebung, in der Tradition und Kreativität aufeinandertreffen."
    ],
    "en": [
      "Let yourself be carried away by a family place and enjoy a fresh and authentic cooking. Discovered a little menu which change twice a year and Savoyards specialties like potatoes fritted."
    ],
    "it": [
      "Situato nel cuore delle montagne dell'Alta Savoia, l'Auberge de Mégevette vi accoglie in un ambiente caldo e autentico, dove tradizione e creatività si incontrano. Godetevi le nostre frittelle di patate."
    ],
    "fr": [
      "Située au cœur des montagnes de Haute-Savoie, l'Auberge de Mégevette vous accueille dans un cadre chaleureux et authentique, où tradition et créativité se rencontrent. vous y déguterez notament nos beignets de pommes de terre."
    ],
    "es": [
      "Situado en el corazón de las montañas de la Alta Saboya, el Auberge de Mégevette le da la bienvenida a un entorno cálido y auténtico, donde tradición y creatividad se dan la mano. Disfrute de nuestros buñuelos de patata."
    ],
    "nl": [
      "De Auberge de Mégevette, gelegen in het hart van de Haute-Savoie, verwelkomt u in een warme en authentieke omgeving, waar traditie en creativiteit elkaar ontmoeten. Geniet van onze aardappelbeignets."
    ]
  },
  "rdfs:label": {
    "en": [
