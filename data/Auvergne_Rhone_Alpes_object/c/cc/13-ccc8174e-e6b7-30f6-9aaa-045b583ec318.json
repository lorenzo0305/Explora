  "rdfs:comment": {
    "de": [
      "Das 1962 gegründete Maison Guillet bietet Ihnen: Entremets, Entremets glacés, Schokolade, Gourmandises, Macarons, hausgemachtes Eis und Sorbets, individuelle Patisserien."
    ],
    "en": [
      "Founded in 1962, Maison Guillet offers: entremets, entremets glacés, chocolates, gourmandises, macaroons, home-made ice creams and sorbets, individual pastries."
    ],
    "it": [
      "Fondata nel 1962, la Maison Guillet offre: entremets, entremets congelati, cioccolatini, dolcetti, macaron, gelati e sorbetti fatti in casa, pasticceria individuale."
    ],
    "fr": [
      "Fondée en 1962, la Maison Guillet vous propose : entremets, entremets glacés, chocolats, gourmandises, macarons, glaces et sorbets maison, pâtisseries individuelles."
    ],
    "nl": [
      "Maison Guillet werd opgericht in 1962 en biedt tussengerechten, geglazuurde tussengerechten, chocolade, zoete lekkernijen, bitterkoekjes, huisgemaakt ijs en sorbets, en individueel gebak."
    ],
    "es": [
      "Fundada en 1962, la Maison Guillet le ofrece: entremets, entremets congelados, chocolates, golosinas, macarrones, helados y sorbetes artesanales, pastas individuales."
