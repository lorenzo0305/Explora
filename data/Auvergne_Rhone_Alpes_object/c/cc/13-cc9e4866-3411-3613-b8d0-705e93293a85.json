  "rdfs:comment": {
    "de": [
      "Odile empfängt Sie das ganze Jahr über in ihrem Zigeunerwagen in Susville für eine Pflege-Massage und um eine Auszeit von der Tiefenentspannung zu genießen. Nutzen Sie diese Zeit, um die Empfindungen Ihres Körpers wiederzuentdecken."
    ],
    "en": [
      "Odile welcomes you all year long in her trail at Susville for a care-massage and to enjoy a deep relaxation parenthesis. Enjoy this time to find back your body sensations."
    ],
    "it": [
      "Odile vi accoglie tutta l'anno nella sua roulotte a Susville per un massaggio-cura e approfittare di un momento di relax profondo. Approfittate di questo tempo per ritrovare le sensazioni del vostro corpo."
    ],
    "fr": [
      "Odile vous accueille tout au long de l’année dans sa roulotte à Susville pour un soin-massage et pour profiter d'une parenthèse de relaxation profonde. Profitez de ce temps pour retrouver les sensations de votre corps."
    ],
    "nl": [
      "Odile verwelkomt je het hele jaar door in haar woonwagen in Susville voor een massagebehandeling en een moment van diepe ontspanning. Profiteer van dit moment om de sensaties in je lichaam te herontdekken."
    ],
    "es": [
      "Odile le recibe todo el año en su caravana gitana de Susville para un tratamiento de masaje y un momento de profunda relajación. Aproveche para redescubrir las sensaciones de su cuerpo."
    ]
  },
