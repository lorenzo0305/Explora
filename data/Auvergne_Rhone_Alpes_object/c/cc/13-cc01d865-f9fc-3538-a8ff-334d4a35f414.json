  "rdfs:comment": {
    "de": [
      "Wagen Sie eine Geschmacksexplosion, indem Sie die Türen unserer Trattoria aufstoßen. Die italienische Kochkunst verdichtet sich in unseren Pizzen, Lasagne..."
    ],
    "en": [
      "Dare to experience an explosion of flavors at our Trattoria. The art of Italian cuisine condensed in our fresh homemade pasta, gnocchi, pizzas, lasagne..."
    ],
    "it": [
      "Osate sperimentare un'esplosione di sapori quando varcate le porte della nostra Trattoria. L'arte della cucina italiana è condensata nella nostra pasta fresca fatta in casa, negli gnocchi, nelle pizze, nelle lasagne..."
    ],
    "fr": [
      "Osez l'explosion des saveurs en poussant les portes de notre Trattoria. L'art culinaire Italien condensé dans nos pâtes fraiches maison, gnocchis,  pizzas, lasagnes..."
    ],
    "nl": [
      "Durf een explosie van smaken te ervaren als je door de deuren van onze Trattoria stapt. De kunst van de Italiaanse keuken gecondenseerd in onze verse huisgemaakte pasta, gnocchi, pizza's, lasagne..."
    ],
    "es": [
      "Atrévase a experimentar una explosión de sabores cuando atraviese las puertas de nuestra Trattoria. El arte de la cocina italiana condensado en nuestra pasta fresca casera, ñoquis, pizzas, lasañas..."
    ]
  },
