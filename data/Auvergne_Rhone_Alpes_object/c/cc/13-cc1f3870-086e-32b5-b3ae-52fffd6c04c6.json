  "rdfs:comment": {
    "de": [
      "Polignac gehört zu den schönsten Dörfern Frankreichs und besticht durch seine mittelalterliche Festung, seine Kirche mit Wandmalereien und seine Wanderungen inmitten einer Vulkanlandschaft vor den Toren von Le Puy-en-Velay. Kostenpflichtige Besichtigung, Anmeldung erforderlich."
    ],
    "en": [
      "Listed as one of France?s most beautiful villages, Polignac boasts a medieval fortress, a church with mural paintings and hiking trails in the heart of a volcanic landscape at the gateway to Le Puy-en-Velay. Visits subject to admission."
    ],
    "it": [
      "Annoverato tra i Borghi più belli di Francia, Polignac vanta una fortezza medievale, una chiesa con dipinti murali e passeggiate nel cuore di un paesaggio vulcanico alla periferia di Le Puy-en-Velay. Visite a pagamento e soggette a registrazione."
    ],
    "fr": [
      "Classé parmi Les Plus Beaux Villages de France, Polignac séduit par sa forteresse médiévale, son église aux peintures murales et ses randonnées au cœur d’un paysage volcanique, aux portes du Le Puy-en-Velay. Visite payante, sur inscription."
    ],
    "nl": [
      "Polignac staat op de lijst van Mooiste Dorpen van Frankrijk en heeft een middeleeuws fort, een kerk met muurschilderingen en wandelingen in het hart van een vulkaanlandschap aan de rand van Le Puy-en-Velay. Bezoek tegen betaling en registratie."
    ],
    "es": [
      "Catalogado como uno de los Pueblos Más Bonitos de Francia, Polignac cuenta con una fortaleza medieval, una iglesia con pinturas murales y paseos en el corazón de un paisaje volcánico a las afueras de Le Puy-en-Velay. Visitas sujetas a pago e inscripción."
    ]
  },
  "rdfs:label": {
