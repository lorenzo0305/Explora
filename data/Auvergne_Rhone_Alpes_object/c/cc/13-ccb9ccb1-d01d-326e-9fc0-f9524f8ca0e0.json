  "rdfs:comment": {
    "de": [
      "Abfahrt auf der Ardèche mit Kanu und Kajak. Mehrere Strecke zur Auswahl : 7-12-18 km . Für alle Altersgruppen ab 7 Jahren. Durchfahrt durch das Dorf, zugelassen für Kanus."
    ],
    "en": [
      "Canoe kayak trip down the Ardèche. A range of trails: 7-12-18km. Suitable for anyone who can swim aged 7 and over. Village crossing allowed for canoes."
    ],
    "it": [
      "In canoa lungo il fiume Ardèche. Diversi percorsi tra cui scegliere: 7-12-18 km. Per tutti coloro che sanno nuotare a partire dai 7 anni. Attraversamento del villaggio autorizzato per le canoe."
    ],
    "fr": [
      "Descente de l'Ardèche en canoë kayak. Plusieurs parcours au choix: 7-12-18 km. Pour tout public sachant nager à partir de 7 ans. Traversée du village autorisée pour les canoës."
    ],
    "nl": [
      "Parcours van 6, 12 of 20 km tussen Vogüé en Ruoms, of in de Gorges"
    ],
    "es": [
      "Descenso en canoa por el río Ardèche. Varios recorridos a elegir: 7-12-18 km. Para todos los que saben nadar a partir de los 7 años. Cruce del pueblo autorizado para las canoas."
    ]
  },
