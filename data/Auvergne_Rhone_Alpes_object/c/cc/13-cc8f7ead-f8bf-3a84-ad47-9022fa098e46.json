  "rdfs:comment": {
    "de": [
      "Hinter dem Rathaus, im Herzen des historischen Zentrums, finden Sie eine kleine Perle: Les Feuillantines. Mittagsangebote ab 12,50 ? (1 salziges Gericht + 1 Salat + 1 Dessert nach Wahl) vor Ort oder zum Mitnehmen. Mahlzeiten zu jeder Tageszeit."
    ],
    "en": [
      "Behind the town hall, in the heart of the historic center, you will find a little gem: Les Feuillantines. Lunch formulas from 12,50 ? (1 salted + 1 salad + 1 dessert of your choice) on the spot or to take away. Meals at any time."
    ],
    "it": [
      "Dietro il municipio, nel cuore del centro storico, si trova un piccolo gioiello: Les Feuillantines. Formule pranzo a partire da 12,50 ? (1 piatto salato + 1 insalata + 1 dessert a scelta) sul posto o da asporto. Pasti a qualsiasi ora."
    ],
    "fr": [
      "Derrière la mairie, au coeur du centre historique, vous dénicherez une petite perle : Les Feuillantines. Formules du midi à partir de 12,50 € (1 salé + 1 salade + 1 dessert au choix) sur place ou à emporter. Repas à toute heure."
    ],
    "es": [
      "Detrás del ayuntamiento, en pleno centro histórico, encontrará una pequeña joya: Les Feuillantines. Fórmulas de almuerzo a partir de 12,50 € (1 salado + 1 ensalada + 1 postre a elegir) in situ o para llevar. Comidas a cualquier hora."
    ],
    "nl": [
      "Achter het stadhuis, in het hart van het historische centrum, vindt u een juweeltje: Les Feuillantines. Lunchformules vanaf 12,50 ? (1 hartig + 1 salade + 1 dessert naar keuze) ter plaatse of om mee te nemen. Maaltijden op elk moment."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Snacking : Les Feuillantines"
    ]
  },
