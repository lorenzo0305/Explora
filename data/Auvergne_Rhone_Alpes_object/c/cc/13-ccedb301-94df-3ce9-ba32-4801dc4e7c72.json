  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Mikro-Makramee mit der Schmuckdesignerin Laura in geselligen und kreativen Workshops, die für alle zugänglich sind. In der Halle, zu Hause oder in den Ferien, für Erwachsene, Kinder ab 8 Jahren oder Eltern-Kind-Duos. Ein Moment der Entspannung und des Austauschs ist garantiert!"
    ],
    "en": [
      "Discover micro macramé with jewelry designer Laura, in friendly, creative workshops open to all. Indoors, at home or on vacation, for adults, children aged 8 and over, or as a parent-child duo. A moment of relaxation and sharing guaranteed!"
    ],
    "it": [
      "Scoprite il micro macramè con Laura, designer di gioielli, in laboratori creativi e amichevoli aperti a tutti. In casa, a casa o in vacanza, per adulti, bambini a partire dagli 8 anni o in coppia con i genitori. Un momento di relax e condivisione garantito!"
    ],
    "fr": [
      "Découvrez le micro macramé avec Laura, créatrice de bijoux, lors d'ateliers conviviaux et créatifs accessibles à tous. En salle, à domicile ou en vacances, pour adultes, enfants dès 8 ans ou en duo parent-enfant. Un moment de détente et de partage assuré!"
    ],
    "nl": [
      "Ontdek micro macramé met Laura, een sieradenontwerpster, in gezellige, creatieve workshops die voor iedereen toegankelijk zijn. Binnen, thuis of op vakantie, voor volwassenen, kinderen vanaf 8 jaar of als ouder-kind duo. Een moment van ontspanning en samen delen gegarandeerd!"
    ],
    "es": [
      "Descubra el micro macramé de la mano de Laura, diseñadora de joyas, en talleres amistosos, creativos y abiertos a todos. En interior, en casa o de vacaciones, para adultos, niños a partir de 8 años o en dúo padres-hijos. ¡Un momento de relajación y de compartir garantizado!"
    ]
  },
