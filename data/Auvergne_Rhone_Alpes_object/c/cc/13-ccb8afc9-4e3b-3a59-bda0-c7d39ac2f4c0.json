  "rdfs:comment": {
    "de": [
      "Das Freizeitzentrum Les Marmottons empfängt Kinder von 4 bis 11 Jahren während aller Schulferien der Zone A (mit Ausnahme der Weihnachtsferien). Große Spiele, handwerkliche und sportliche Aktivitäten, Ausdrucksworkshops, Ausflüge in die Natur..."
    ],
    "en": [
      "Les Marmottons leisure centre welcomes children from 4 to 11 years old during all school holidays in zone A (except Christmas holidays). Big games, manual and sports activities, expression workshops, nature outings..."
    ],
    "it": [
      "Il centro ricreativo Marmottons accoglie i bambini dai 4 agli 11 anni durante tutte le vacanze scolastiche della zona A (ad eccezione delle vacanze di Natale). Giochi, attività manuali e sportive, laboratori espressivi, uscite nella natura..."
    ],
    "fr": [
      "Le centre de loisirs les Marmottons accueille les enfants de 4 à 11 ans pendant toutes les vacances scolaires de la zone A (à l'exception des vacances de Noël). Grands jeux, activités manuelles et sportives, ateliers d'expression, sorties nature..."
    ],
    "nl": [
      "Het vrijetijdscentrum Marmottons verwelkomt kinderen van 4 tot 11 jaar tijdens alle schoolvakanties in zone A (met uitzondering van de kerstvakantie). Spelletjes, manuele en sportieve activiteiten, expressieworkshops, natuuruitstapjes..."
    ],
    "es": [
      "El centro de ocio Marmottons acoge a niños de 4 a 11 años durante todas las vacaciones escolares de la zona A (excepto las vacaciones de Navidad). Juegos, actividades manuales y deportivas, talleres de expresión, salidas a la naturaleza..."
    ]
  },
