  "rdfs:comment": {
    "de": [
      "Graines de Buisson ist Konfitürenhersteller, Kräuterhändler, Gartenbaubetrieb... 2 Naturliebhaber, die beschlossen haben, ein kleines Stück Paradies in der Ardèche neu zu beleben."
    ],
    "en": [
      "Come and discover our rustic, wild farm, observe living nature, reconnect with the natural world, and delight your taste buds!\r\nVegetable seedlings, plant-based recipes, and hands-on farm education."
    ],
    "it": [
      "Venite a scoprire la nostra selvaggia fattoria di campagna, a osservare gli esseri viventi, a riconnettervi con la natura e a stuzzicare il vostro palato!\r\nPiante da orto, ricette a base vegetale e attività didattiche in fattoria."
    ],
    "fr": [
      "Venez découvrir notre ferme paysanne et sauvage, observer le  vivant, vous reconnecter à la nature et émoustiller vos papilles!\r\nPlants potagers, recettes végétales & pédagogie à la ferme."
    ],
    "es": [
      "Venga a descubrir nuestra granja rural salvaje, observe los seres vivos, vuelva a conectar con la naturaleza y deleite su paladar\r\nPlantas hortícolas, recetas a base de plantas y actividades educativas en la granja."
    ],
    "nl": [
      "Graines de Buisson is confituurmaker, kruidendokter en tuinder... 2 natuurliefhebbers die besloten hebben een stukje paradijs in de Ardèche weer tot leven te brengen."
    ]
  },
