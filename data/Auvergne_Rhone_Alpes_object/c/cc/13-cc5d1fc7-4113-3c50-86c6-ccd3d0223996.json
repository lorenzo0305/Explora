  "rdfs:comment": {
    "de": [
      "Fanny Gerland-Burel, Atelier Fanny et ses Arts, Kunsthandwerkerin in Saint Fortunat sur Eyrieux, in der Ardèche.\r\nIn meinem Atelier fertige ich Schmuck und Webarbeiten an.\r\nDas Ganze in einem ethnischen Bohème-, Zen- und Natur-Universum."
    ],
    "en": [
      "I'm Fanny Gerland-Burel, from Atelier Fanny et ses Arts, an artisan in Saint Fortunat sur Eyrieux, in Ardèche, France.\r\nIn my studio, I create jewelry, paintings and decorative objects.\r\nAll in a bohemian, zen and natural ethnic style."
    ],
    "it": [
      "Fanny Gerland-Burel, Atelier Fanny et ses Arts, artigiana a Saint Fortunat sur Eyrieux, Ardèche.\r\nRealizzo gioielli e tessitura nel mio atelier.\r\nIl tutto in un universo etnico bohémien, zen e naturale."
    ],
    "fr": [
      "Fanny Gerland-Burel, Atelier Fanny et ses Arts, artisane à Saint Fortunat sur Eyrieux, en Ardèche. \r\nJe réalise dans mon atelier des bijoux et du tissage.\r\nLe tout dans un univers ethnique bohème, zen et nature."
    ],
    "nl": [
      "Fanny Gerland-Burel, Atelier Fanny et ses Arts, handwerkster in Saint Fortunat sur Eyrieux, Ardèche.\r\nIk maak sieraden en weef in mijn atelier.\r\nAlles in een bohemien, zen en natuurlijk etnisch universum."
    ],
    "es": [
      "Fanny Gerland-Burel, Atelier Fanny et ses Arts, artesana en Saint Fortunat sur Eyrieux, Ardèche.\r\nHago joyas y tejidos en mi taller.\r\nTodo en un universo étnico bohemio, zen y natural."
    ]
  },
