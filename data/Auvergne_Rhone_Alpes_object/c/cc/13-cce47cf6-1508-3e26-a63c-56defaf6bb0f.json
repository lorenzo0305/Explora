  "rdfs:comment": {
    "de": [
      "Entfliehen Sie dem Alltag auf dem Genfersee, indem Sie ein Boot mit Führerschein mieten. Entdecken Sie auch den Boots-Aperitif!  Wasserski für Erwachsene und Kinder."
    ],
    "en": [
      "Escape to Lake Geneva by renting a boat with a license. Also, discover the boat aperitif! Water skiing for adults and children."
    ],
    "it": [
      "Allontanatevi da tutto sul Lago di Ginevra noleggiando una barca con patente nautica. Scoprite la barca dell'aperitivo!  Sci nautico per adulti e bambini."
    ],
    "fr": [
      "Évadez-vous sur le Léman, en louant un bateau avec permis. Découvrez également l'apéro bateau!  Ski nautique pour adultes et enfants."
    ],
    "nl": [
      "Ga er even tussenuit op het Meer van Genève door een boot met vaarbewijs te huren. Ontdek de aperitiefboot!  Waterskiën voor volwassenen en kinderen."
    ],
    "es": [
      "Escápese de todo en el lago Lemán alquilando un barco con licencia. Descubra el barco del aperitivo  Esquí acuático para adultos y niños."
    ]
  },
