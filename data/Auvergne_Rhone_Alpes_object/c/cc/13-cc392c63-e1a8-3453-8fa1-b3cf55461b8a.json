  "rdfs:comment": {
    "de": [
      "Ein Abend mit Animation, um die Museen von Loire Forez ins rechte Licht zu rücken. Entdecken Sie sie aus einem ungewöhnlichen Blickwinkel. Finden Sie die Liste der teilnehmenden Stätten auf www.rendezvousenforez.com oder fragen Sie in unseren Fremdenverkehrsbüros nach dem Programm."
    ],
    "en": [
      "An evening of entertainment to showcase the museums of Loire Forez. Come and discover them from an unusual angle. For a list of participating sites, visit www.rendezvousenforez.com or ask for the program at one of our tourist offices."
    ],
    "it": [
      "Una serata di intrattenimento per presentare i musei del Forez Loire. Venite a scoprirli da una prospettiva insolita. Per l'elenco dei siti partecipanti, visitate il sito www.rendezvousenforez.com o richiedete il programma presso uno dei nostri uffici turistici."
    ],
    "fr": [
      "Une soirée d'animation pour mettre en valeur les musées de Loire Forez. Venez les découvrir sous un angle inhabituel. Retrouvez la liste des sites participants sur www.rendezvousenforez.com ou venez nous demander le programme dans nos offices de tourisme."
    ],
    "es": [
      "Una velada de entretenimiento para dar a conocer los museos de Loire Forez. Venga a descubrirlos desde un ángulo insólito. Para consultar la lista de los lugares participantes, visite www.rendezvousenforez.com o solicite el programa en una de nuestras oficinas de turismo."
    ],
    "nl": [
      "Een avond vol entertainment om de musea van de Loire Forez onder de aandacht te brengen. Kom en ontdek ze vanuit een ongebruikelijke hoek. Ga voor de lijst met deelnemende locaties naar www.rendezvousenforez.com of vraag naar het programma bij een van onze VVV-kantoren."
    ]
  },
