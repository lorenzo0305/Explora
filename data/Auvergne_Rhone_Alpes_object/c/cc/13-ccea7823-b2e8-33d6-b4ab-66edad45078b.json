  "rdfs:comment": {
    "de": [
      "Von Anne Jochum | 57 Minuten\r\nEin Eintauchen in die Welt der Kindheit durch Sequenzen, in denen das Kind bei seinem Umhergehen, seiner Erkundung im freien Spiel, seinen Interaktionen und seinen Erfahrungen mit der Welt des Lebendigen und der Natur beobachtet wird."
    ],
    "en": [
      "By Anne Jochum | 57 minutes\r\nAn immersion into the world of childhood, through sequences of observation of children wandering, exploring in free play, interacting and experimenting with the living world and nature."
    ],
    "it": [
      "Di Anne Jochum | 57 minuti\r\nUn'immersione nel mondo dell'infanzia attraverso sequenze di osservazione di bambini che vagano, esplorano nel gioco libero, interagiscono e sperimentano con il mondo vivente e la natura."
    ],
    "fr": [
      "Par Anne Jochum | 57 minutes\r\nUne immersion dans le monde de l'enfance par des séquences d'observation de l'enfant dans sa déambulation, son exploration en jeu libre, ses interactions et ses expériences avec le monde du vivant et de la nature."
    ],
    "es": [
      "Por Anne Jochum | 57 minutos\r\nUna inmersión en el mundo de la infancia a través de secuencias de observación de niños deambulando, explorando en el juego libre, interactuando y experimentando con el mundo vivo y la naturaleza."
    ],
    "nl": [
      "Door Anne Jochum | 57 minuten\r\nEen onderdompeling in de wereld van de kindertijd door middel van sequenties van observatie van kinderen die ronddwalen, op onderzoek uitgaan in vrij spel, interactie hebben en experimenteren met de leefwereld en de natuur."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Gare fait son cinéma : \" Tous dehors\""
    ]
  },
