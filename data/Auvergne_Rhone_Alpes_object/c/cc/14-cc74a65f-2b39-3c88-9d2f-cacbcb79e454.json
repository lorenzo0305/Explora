  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/ae620d77-2141-31a3-a668-ef1ce4c387b3",
      "dc:description": {
        "de": [
          "Originelle Adaption des Podcasts von France Inter als animierter Dokumentarfilm.\nDer Film verfolgt das Leben zweier afghanischer Frauen nach der Einnahme Kabuls durch die Taliban. Die eine ist geflohen, die andere ist geblieben."
        ],
        "en": [
          "Original adaptation of the France Inter podcast into an animated documentary.\nThis film follows the lives of two Afghan women after the Taliban took over Kabul. One fled, the other stayed."
        ],
        "it": [
          "Adattamento originale del podcast di France Inter come documentario animato.\nQuesto film segue la vita di due donne afghane dopo che i Talebani hanno preso il controllo di Kabul. Una è fuggita, l'altra è rimasta."
        ],
        "fr": [
          "Adaptation originale du podcast de France Inter en documentaire animé.\nCe film suit la vie de deux afghanes après la prise de Kaboul par les talibans. L’une a fui, l’autre est restée."
        ],
        "nl": [
          "Originele bewerking van de podcast van France Inter als geanimeerde documentaire.\nDeze film volgt het leven van twee Afghaanse vrouwen nadat de Taliban Kabul hadden overgenomen. De ene vluchtte, de andere bleef."
        ],
        "es": [
          "Adaptación original del podcast de France Inter en forma de documental animado.\nEsta película sigue la vida de dos mujeres afganas tras la toma de Kabul por los talibanes. Una huyó, la otra se quedó."
        ]
      },
