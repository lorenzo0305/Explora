  "rdfs:comment": {
    "de": [
      "Regie: Caroline Gillet und Denis Walgenwitz ? Künstlerische Leitung Luciano Lepinay\nRealisation der Originalzeichnungen Kubra Khademi\nAnschließend Treffen mit der Künstlerin Kubra Khademi, Marwa und Raha, deren Geschichte der Podcast und der Film erzählen."
    ],
    "en": [
      "Directed by Caroline Gillet and Denis Walgenwitz ? Art direction Luciano Lepinay\nOriginal drawings by Kubra Khademi\nFollowed by a meeting with artist Kubra Khademi, Marwa and Raha, whose story is told in the podcast and film."
    ],
    "it": [
      "Regia di Caroline Gillet e Denis Walgenwitz ? Direttore artistico Luciano Lepinay\nDisegni originali di Kubra Khademi\nSeguirà un incontro con l'artista Kubra Khademi, Marwa e Raha, la cui storia è raccontata nel podcast e nel film."
    ],
    "fr": [
      "Réalisé par Caroline Gillet et Denis Walgenwitz – Direction artistique Luciano Lepinay\nRéalisation des dessins originaux Kubra Khademi\nSuivie d’une rencontre avec l’artiste Kubra Khademi, Marwa et Raha dont le podcast et le film racontent l’histoire."
    ],
    "nl": [
      "Regie: Caroline Gillet en Denis Walgenwitz ? Artistiek directeur Luciano Lepinay\nOriginele tekeningen van Kubra Khademi\nGevolgd door een ontmoeting met de kunstenaar Kubra Khademi, Marwa en Raha, wiens verhaal wordt verteld in de podcast en de film."
    ],
    "es": [
      "Dirigida por Caroline Gillet y Denis Walgenwitz ? Dirección artística Luciano Lepinay\nDibujos originales de Kubra Khademi\nSeguido de un encuentro con la artista Kubra Khademi, Marwa y Raha, cuya historia se cuenta en el podcast y la película."
    ]
  },
