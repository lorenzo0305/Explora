  "rdfs:comment": {
    "de": [
      "GRAND CENTRAL STATION - NEW YORK CITY, 1930\r\nElliot hat den kleinen Hafen in England verlassen, um sein Glück in den USA zu versuchen."
    ],
    "en": [
      "GRAND CENTRAL STATION - NEW YORK CITY, 1930\r\nElliot, inspired by the hope of a better life, has left the small port of England to try his luck in the United States."
    ],
    "it": [
      "GRAND CENTRAL STATION - NEW YORK CITY, 1930\r\nElliot, con la speranza di una vita migliore, ha lasciato il piccolo porto inglese per tentare la fortuna negli Stati Uniti."
    ],
    "fr": [
      "GRAND CENTRAL STATION - NEW YORK CITY, 1930\r\nElliot, secoué d’un formidable espoir de vie meilleure, a quitté le petit port d’Angleterre pour tenter sa chance aux États-Unis."
    ],
    "es": [
      "GRAND CENTRAL STATION - NUEVA YORK, 1930\r\nElliot, lleno de la esperanza de una vida mejor, ha dejado el pequeño puerto de Inglaterra para probar suerte en los Estados Unidos."
    ],
    "nl": [
      "GRAND CENTRAL STATION - NEW YORK CITY, 1930\r\nElliot, vervuld van de hoop op een beter leven, heeft de kleine haven van Engeland verlaten om zijn geluk te beproeven in de Verenigde Staten."
    ]
  },
