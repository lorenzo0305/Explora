  "rdfs:comment": {
    "de": [
      "Der Staat, der die Quellen von Vichy seit 1523 besaß, übertrug die Nutzung ab 1853 einem privaten Unternehmen, der Compagnie Fermière."
    ],
    "en": [
      "Owners of the Vichy springs since 1523, the State entrusted their operation to a private company, Compagnie Fermière, from 1853 onwards."
    ],
    "it": [
      "Proprietario delle sorgenti di Vichy dal 1523, lo Stato ne affidò la gestione a una società privata, la Compagnie Fermière, a partire dal 1853."
    ],
    "fr": [
      "Propriétaire des sources de Vichy depuis 1523, l’État en a confié l’exploitation à une société privée, la Compagnie Fermière, à partir de 1853."
    ],
    "es": [
      "Propietario de los manantiales de Vichy desde 1523, el Estado confió su explotación a una empresa privada, la Compagnie Fermière, a partir de 1853."
    ],
    "nl": [
      "Eigenaar van de bronnen van Vichy sinds 1523, vertrouwde de staat vanaf 1853 de exploitatie toe aan een privéonderneming, Compagnie Fermière."
    ]
  },
