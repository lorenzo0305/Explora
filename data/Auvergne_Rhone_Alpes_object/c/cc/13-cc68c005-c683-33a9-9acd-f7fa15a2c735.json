  "rdfs:comment": {
    "de": [
      "Das Touristeninformationsbüro hilft Ihnen bei der Organisation Ihres Aufenthalts: Auskünfte und persönliche Beratung zu sportlichen und kulturellen Aktivitäten, Dokumentationen und Informationen über Anbieter, Dienstleistungen und Transportmöglichkeiten."
    ],
    "en": [
      "The Tourist Information Office will help you organize your stay: information and personalized advice on sporting and cultural activities, documentation and information on service providers, services and transport."
    ],
    "it": [
      "L'Ufficio del Turismo organizza il vostro soggiorno: informazione e prenotazione di vostre attività sportive e culturali, la documentazione e le informazioni sui fornitori, servizi e trasporti."
    ],
    "fr": [
      "Le Bureau d'Information Touristique vous aide à organiser votre séjour :  renseignements et conseils personnalisés sur les activités sportives et culturelles, documentations et informations sur les prestataires, les services et les transports."
    ],
    "es": [
      "La Oficina de Turismo le ayudará a organizar su estancia: información y asesoramiento personalizado sobre actividades deportivas y culturales, documentación e información sobre proveedores, servicios y transportes."
    ],
    "nl": [
      "Het VVV-kantoor helpt je bij het organiseren van je verblijf: informatie en persoonlijk advies over sportieve en culturele activiteiten, documentatie en informatie over dienstverleners, diensten en vervoer."
    ]
  },
