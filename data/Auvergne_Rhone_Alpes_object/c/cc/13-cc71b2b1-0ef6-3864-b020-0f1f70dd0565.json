  "rdfs:comment": {
    "de": [
      "Im Rahmen des Bibliotheksfrühlings 2026 laden die Bibliothèque départementale und die Bibliothek von Valigny Sie ein, \"MUSEUM\", das zoopoetische Kuriositätenkabinett des Petit Théâtre Dakôté, zu entdecken."
    ],
    "en": [
      "As part of Printemps des Bibliothèques 2026, the Bibliothèque Départementale and the Valigny Library invite you to discover \"MUSEUM\", the Petit Théâtre Dakôté's cabinet of zoopoetic curiosities."
    ],
    "it": [
      "Nell'ambito del Printemps des Bibliothèques 2026, la biblioteca dipartimentale e la biblioteca di Valigny vi invitano a scoprire \"MUSEUM\", il gabinetto di curiosità zoopoetiche del Petit Théâtre Dakôté."
    ],
    "fr": [
      "Dans le cadre du Printemps des Bibliothèques 2026, la bibliothèque départementale et la bibliothèque de Valigny vous invitent à découvrir \"MUSEUM\", le cabinet de curiosités zoopoétiques du Petit Théâtre Dakôté."
    ],
    "nl": [
      "In het kader van Printemps des Bibliothèques 2026 nodigen de departementale bibliotheek en de bibliotheek van Valigny je uit om \"MUSEUM\" te ontdekken, het rariteitenkabinet van de dierentuin in het Petit Théâtre Dakôté."
    ],
    "es": [
      "En el marco de Printemps des Bibliothèques 2026, la biblioteca departamental y la biblioteca de Valigny le invitan a descubrir \"MUSEUM\", el gabinete de curiosidades zoopoéticas del Petit Théâtre Dakôté."
    ]
  },
  "rdfs:label": {
