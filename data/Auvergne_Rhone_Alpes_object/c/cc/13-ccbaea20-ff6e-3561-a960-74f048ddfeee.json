  "rdfs:comment": {
    "de": [
      "Mvélo+ verleiht (kurz- und langfristig) Fahrräder in Grenoble und seinem Umland. Den Mvélo+-Service finden Sie in der Touristeninformation von Vizille"
    ],
    "en": [
      "Mvélo+ provides short- and long-term bike rentals in Grenoble and the surrounding area. Find the Mvélo+ service in the Vizille Tourist Information Office"
    ],
    "it": [
      "Mvélo+ offre il noleggio di biciclette a breve e lungo termine a Grenoble e dintorni. Il servizio Mvélo+ si trova presso l'Ufficio del Turismo di Vizille"
    ],
    "fr": [
      "Mvélo+ assure  la location (courte et longue durée) de vélos sur Grenoble et son agglomération. Retrouvez le service Mvélo+ dans le Bureau d'Information Touristique de Vizille"
    ],
    "es": [
      "Mvélo+ ofrece alquiler de bicicletas a corto y largo plazo en Grenoble y sus alrededores. Encontrará el servicio Mvélo+ en la Oficina de Turismo de Vizille"
    ],
    "nl": [
      "Mvélo+ biedt korte- en langetermijnverhuur van fietsen in Grenoble en omgeving. Je vindt de Mvélo+ service bij het VVV-kantoor in Vizille"
    ]
  },
  "rdfs:label": {
