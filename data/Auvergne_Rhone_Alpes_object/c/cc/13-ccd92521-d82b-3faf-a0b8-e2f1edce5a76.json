  "rdfs:comment": {
    "de": [
      "Der Küchenchef Paul Attia bietet Ihnen eine abwechslungsreiche Speisekarte vor Ort oder zum Mitnehmen: Tagesmenü, Pizzas,... Gruppenmahlzeiten, Cateringservice... Schattige Terrasse in der warmen Jahreszeit."
    ],
    "en": [
      "The chef Paul Attia offers a varied menu on the spot or to take away: daily menu, pizzas,... Group meals, catering service... Shaded terrace in the summer."
    ],
    "it": [
      "Lo chef Paul Attia propone un menù vario sul posto o da asporto: menù del giorno, pizze,... Pasti di gruppo, servizio di catering... Terrazza ombreggiata in estate."
    ],
    "fr": [
      "Le chef de cuisine Paul Attia vous propose une carte variée sur place ou à emporter: menu du jour, pizzas,.. Repas de groupe, service traiteur... Terrasse ombragée à la belle saison."
    ],
    "es": [
      "El chef Paul Attia ofrece un menú variado en el lugar o para llevar: menú del día, pizzas,... Comidas en grupo, servicio de catering... Terraza sombreada en verano."
    ],
    "nl": [
      "Chef-kok Paul Attia biedt een gevarieerd menu om te eten of mee te nemen: dagschotels, pizza's, enz. Groepsmaaltijden, traiteurdienst... Schaduwrijk terras bij mooi weer."
    ]
  },
  "rdfs:label": {
    "en": [
      "Restaurant La Châtaigneraie"
    ],
    "fr": [
      "Restaurant La Châtaigneraie"
    ]
