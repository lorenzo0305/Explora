  "rdfs:comment": {
    "de": [
      "Das AvanC liegt 10 Minuten vom Place de Jaude entfernt in einer grünen Oase in Royat und bietet alle professionellen Einrichtungen, die für den reibungslosen Ablauf von Firmenveranstaltungen erforderlich sind."
    ],
    "en": [
      "Located 10 minutes from the Place de Jaude, in a green setting in Royat, l'AvanC offers all the professional facilities needed for a successful corporate event."
    ],
    "it": [
      "Situato a 10 minuti da Place de Jaude, nel verde di Royat, l'AvanC offre tutte le strutture professionali necessarie per un evento aziendale di successo."
    ],
    "fr": [
      "Située à 10 minutes de la Place de Jaude, dans un écrin de verdure à Royat, l’AvanC propose tous les équipements professionnels nécessaires au bon déroulement d’événements d’entreprises."
    ],
    "es": [
      "Situado a 10 minutos de la Place de Jaude, en un entorno verde en Royat, l'AvanC ofrece todas las instalaciones profesionales que necesita para un evento corporativo de éxito."
    ],
    "nl": [
      "Op 10 minuten van de Place de Jaude, in een groene omgeving in Royat, biedt l'AvanC alle professionele faciliteiten die u nodig hebt voor een geslaagd bedrijfsevenement."
    ]
  },
