  "rdfs:comment": {
    "de": [
      "Das am Ufer des Allier gelegene Maison La Rotonde ? Bocuse verkörpert einen Ort, an dem sich das Erbe der französischen Haute Cuisine mit der Lebensart von Vichyssois vereint, in einem eleganten, zeitlosen und erschwinglichen Rahmen."
    ],
    "en": [
      "Nestled on the banks of the Allier River, Maison La Rotonde ? Bocuse embodies a place where the heritage of French haute cuisine blends with the Vichy art of living, in a setting that is elegant, timeless and resolutely accessible."
    ],
    "it": [
      "Adagiata sulle rive del fiume Allier, la Maison La Rotonde ? Bocuse incarna un luogo dove l'eredità dell'alta cucina francese incontra l'arte di vivere di Vichy, in un ambiente elegante, senza tempo e decisamente accessibile."
    ],
    "fr": [
      "Nichée au bord de l’Allier, la Maison La Rotonde – Bocuse incarne un lieu où l’héritage de la haute cuisine française s’unit à l’art de vivre vichyssois, dans un cadre élégant, intemporel et résolument accessible."
    ],
    "es": [
      "Situada a orillas del río Allier, la Maison La Rotonde ? Bocuse encarna un lugar donde la herencia de la alta cocina francesa se encuentra con el arte de vivir de Vichy, en un entorno elegante, atemporal y decididamente accesible."
    ],
    "nl": [
      "Genesteld aan de oevers van de Allier, belichaamt Maison La Rotonde ? Bocuse een plaats waar het erfgoed van de Franse haute cuisine samenkomt met de levenskunst van Vichy, in een kader dat elegant, tijdloos en resoluut toegankelijk is."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Maison La Rotonde - Bocuse"
    ]
  },
