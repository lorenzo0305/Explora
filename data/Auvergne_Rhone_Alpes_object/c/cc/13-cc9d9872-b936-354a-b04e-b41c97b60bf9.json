  "rdfs:comment": {
    "de": [
      "Die im Dorfzentrum gelegene Auberge des Tilleuls befindet sich in den Monts du Lyonnais, zwischen Lyon und Saint-Etienne. Traditionelle Küche und regionale Zutaten."
    ],
    "en": [
      "Located in the heart of the village, the Auberge des Tilleuls is located in the Monts du Lyonnais, between Lyon and Saint-Etienne. Traditional cuisine and local products."
    ],
    "it": [
      "Locanda di campagna situata nel cuore del villaggio di Châtelus, vicino al castello medievale. Cucina tradizionale e prodotti locali. Terrazza tranquilla con vista. Organizzazione di serate di intrattenimento e a tema."
    ],
    "fr": [
      "Auberge de campagne situé au cœur du village de Châtelus, proche du château médiéval. Cuisine traditionnelle et produits locaux. Terrasse calme avec vue. Organisation d'animations et soirées à thème."
    ],
    "es": [
      "Posada rural situada en el corazón del pueblo de Châtelus, cerca del castillo medieval. Cocina tradicional y productos locales. Terraza tranquila con vistas. Organización de veladas de entretenimiento y temáticas."
    ],
    "nl": [
      "Landelijke herberg gelegen in het hart van het dorp Châtelus, vlakbij het middeleeuwse kasteel. Traditionele keuken en lokale producten. Rustig terras met uitzicht. Organisatie van animaties en thema-avonden."
    ]
  },
