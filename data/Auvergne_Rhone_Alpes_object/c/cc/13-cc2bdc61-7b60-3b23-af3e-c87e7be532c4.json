  "rdfs:comment": {
    "de": [
      "Lust auf Höhe? \"Mein erster 3000-Meter-Gipfel\", ein zugänglicher Gipfel im Herzen des Massif de la Vanoise. Entdecken Sie auch leichte Wanderungen mit Panoramablick für die ganze Familie."
    ],
    "en": [
      "Looking for altitude? \"Mon premier 3000 mètres\", an accessible summit in the heart of the Vanoise Massif. Discover easy, panoramic hikes for the whole family."
    ],
    "it": [
      "In cerca di altitudine? \"La mia prima vetta di 3000 metri nel cuore del Massiccio della Vanoise. Ci sono anche escursioni panoramiche facili e adatte a tutta la famiglia."
    ],
    "fr": [
      "Envie d’altitude ? «Mon premier 3000 mètres», sommet accessible au cœur du Massif de la Vanoise. Découvrez également des randos faciles et panoramiques pour toute la famille."
    ],
    "es": [
      "¿Busca altitud? \"Mi primera cumbre de 3000 metros en el corazón del macizo de la Vanoise. También hay excursiones fáciles y panorámicas para toda la familia."
    ],
    "nl": [
      "Op zoek naar hoogte? \"Mijn eerste top van 3000 meter in het hart van het Vanoise massief. Er zijn ook gemakkelijke, panoramische wandelingen voor het hele gezin."
    ]
  },
