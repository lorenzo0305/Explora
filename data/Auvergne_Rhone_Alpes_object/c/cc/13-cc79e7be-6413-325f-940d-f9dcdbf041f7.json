  "rdfs:comment": {
    "de": [
      "Jean-Pierre Granger kreiert Metalltiere (Frosch, Ente, Hahn, Katze, Maus...) aus wiederverwerteten Gegenständen. Diese Werke sind nur in den Empfangsbüros des Fremdenverkehrsamtes in Bâgé-le-Châtel und Pont-de-Vaux erhältlich."
    ],
    "en": [
      "Jean-Pierre Granger creates metal animals (frog, duck, rooster, cat, mouse...) from recycled objects. These works are on sale only at the tourist information offices in Bâgé-le-Châtel and Pont-de-Vaux."
    ],
    "it": [
      "Jean-Pierre Granger crea animali in metallo (rane, anatre, galli, gatti, topi, ecc.) a partire da oggetti riciclati. Queste opere sono in vendita solo presso le reception degli uffici turistici di Bâgé-le-Châtel e Pont-de-Vaux."
    ],
    "fr": [
      "Jean-Pierre Granger crée des des animaux en métal (grenouille, canard, coq, chat, souris...) à partir d'objets de récupération. Ces oeuvres sont en vente uniquement dans les bureaux d'accueil de l'office de tourisme à Bâgé-le-Châtel et Pont-de-Vaux."
    ],
    "nl": [
      "Jean-Pierre Granger maakt metalen dieren (kikkers, eenden, hanen, katten, muizen, enz.) van gerecyclede voorwerpen. Deze werken zijn alleen te koop bij de receptie van het toeristenbureau in Bâgé-le-Châtel en Pont-de-Vaux."
    ],
    "es": [
      "Jean-Pierre Granger crea animales de metal (ranas, patos, gallos, gatos, ratones, etc.) a partir de objetos reciclados. Estas obras están a la venta únicamente en los mostradores de recepción de las oficinas de turismo de Bâgé-le-Châtel y Pont-de-Vaux."
    ]
  },
  "rdfs:label": {
    "en": [
      "Art ironwork"
    ],
    "fr": [
      "Feronnerie d'art"
    ],
    "nl": [
      "Ijzerwerk"
    ]
  },
