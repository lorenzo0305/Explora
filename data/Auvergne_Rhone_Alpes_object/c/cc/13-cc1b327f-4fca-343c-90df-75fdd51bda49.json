  "rdfs:comment": {
    "de": [
      "Gaec Subrin bietet eine schöne Produktion in biologischer Landwirtschaft an. Milch, Rindfleisch, Hacksteaks (auf Bestellung) und Bier. Finden Sie die Produkte in Click & Collect auf www.nosproduitslocaux-copler.fr."
    ],
    "en": [
      "Gaec Subrin offers a fine range of organic produce. Milk, beef, minced steaks (to order), and beers. Click & Collect products at www.nosproduitslocaux-copler.fr."
    ],
    "it": [
      "Gaec Subrin produce un'ottima gamma di prodotti biologici. Latte, carne di manzo, bistecche macinate (su ordinazione) e birra. Prodotti Click & Collect su www.nosproduitslocaux-copler.fr."
    ],
    "fr": [
      "La Gaec Subrin propose une belle production en Agriculture Biologique. Lait, viande bovine, steaks hachés (sur commande), et bières. Retrouvez les produits en Click & Collect sur www.nosproduitslocaux-copler.fr."
    ],
    "nl": [
      "Gaec Subrin produceert een mooi assortiment biologische producten. Melk, rundvlees, gehakt (op bestelling) en bier. Click & Collect producten op www.nosproduitslocaux-copler.fr."
    ],
    "es": [
      "Gaec Subrin produce una excelente gama de productos ecológicos. Leche, ternera, filetes picados (por encargo) y cerveza. Productos Click & Collect en www.nosproduitslocaux-copler.fr."
    ]
  },
