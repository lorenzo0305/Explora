  "rdfs:comment": {
    "de": [
      "Neben dem Parkplatz Notre-Dame de la Gorge gelegen, entdecken Sie diese drei geodätischen Holzkuppeln des Naturschutzgebiets."
    ],
    "en": [
      "Located next to the Notre-Dame de la Gorge car park, discover these 3 geodesic wooden domes of the Nature Reserve."
    ],
    "it": [
      "Situate accanto al parcheggio di Notre-Dame de la Gorge, scoprite queste 3 cupole geodetiche in legno nella Riserva Naturale."
    ],
    "fr": [
      "Situés à côté du parking de Notre-Dame de la Gorge, découvrez ces 3 dômes géodésiques en bois de la Réserve Naturelle."
    ],
    "es": [
      "Situadas junto al aparcamiento de Notre-Dame de la Gorge, descubra estas 3 cúpulas geodésicas de madera en el Parque Natural."
    ],
