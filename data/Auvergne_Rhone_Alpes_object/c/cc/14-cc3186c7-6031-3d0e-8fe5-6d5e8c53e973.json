  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/e8691747-ab5a-32be-8984-bf5de7c43db1",
      "dc:description": {
        "de": [
          "Interbourgs Kegeln 2025\nVom 22. September bis zum 5. Oktober 2025\nPlace du Général de Gaulle - Montreuil\n--------------------------------\nDer Kegelwettbewerb \"Concours de Quilles entre villages autour\" kehrt nach Montreuil-sur-Mer zurück und bietet zwei Wochen lang Geselligkeit, Wettkampf und gute Laune!\n\nDie Auslosung der Pools findet am Montag, den 15. September 2025 statt.\n\nBildnachweis: Stadt Montreuil-sur-Mer"
        ],
        "en": [
          "Interbourgs Bowling 2025\nSeptember 22 to October 5, 2025\nPlace du Général de Gaulle - Montreuil\n--------------------------------\nThe Interbourgs Bowling Competition returns to Montreuil-sur-Mer for two weeks of conviviality, competition and good humor!\n\nPools will be drawn on Monday, September 15, 2025.\n\nPhoto credit : Ville de Montreuil-sur-Mer"
        ],
        "it": [
          "Interbourgs Bowling 2025\nDal 22 settembre al 5 ottobre 2025\nPiazza del Generale de Gaulle - Montreuil\n--------------------------------\nLa gara di bowling Interbourgs torna a Montreuil-sur-Mer per quindici giorni di divertimento, competizione e buon umore!\n\nI sorteggi saranno effettuati lunedì 15 settembre 2025.\n\nCrediti fotografici: Ville de Montreuil-sur-Mer"
        ],
        "fr": [
          "Interbourgs Quilles 2025\nDu 22 septembre au 5 octobre 2025\nPlace du Général de Gaulle - Montreuil\n--------------------------------\nLe Concours de Quilles entre villages autour revient à Montreuil-sur-Mer pour deux semaines de convivialité, de compétition et de bonne humeur !\n\nLe Tirage au sort des poules se fera le lundi 15 septembre 2025.\n\nCrédit photo : Ville de Montreuil-sur-Mer"
        ],
        "nl": [
          "Interbourgs Bowling 2025\nVan 22 september tot 5 oktober 2025\nGeneraal de Gaulleplein - Montreuil\n--------------------------------\nDe Interbourgs Bowling Competitie keert terug naar Montreuil-sur-Mer voor twee weken plezier, competitie en goede humor!\n\nDe loting vindt plaats op maandag 15 september 2025.\n\nFoto krediet: Ville de Montreuil-sur-Mer"
        ],
        "es": [
          "Interbourgs Bowling 2025\nDel 22 de septiembre al 5 de octubre de 2025\nPlace du Général de Gaulle - Montreuil\n--------------------------------\nLa competición de bolos Interbourgs vuelve a Montreuil-sur-Mer para una quincena de diversión, competición y buen humor\n\nLas quinielas se sortearán el lunes 15 de septiembre de 2025.\n\nCrédito de la foto: Ville de Montreuil-sur-Mer"
        ]
      },
