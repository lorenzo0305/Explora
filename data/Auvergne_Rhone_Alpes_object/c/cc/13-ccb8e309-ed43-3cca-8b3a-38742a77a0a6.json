  "rdfs:comment": {
    "de": [
      "Die Maquisards errichteten auf dem Mandallaz ein Trainingslager und insbesondere am Rocher du Maquis 1944 einen Stützpunkt. Eine Gedenktafel zeugt von ihren Aktivitäten. Damit wird die natürliche Schönheit des Ortes um eine historische Kuriosität ergänzt."
    ],
    "en": [
      "The Maquisards set up a training camp on the Mandallaz, and particularly a base at Rocher du Maquis in 1944. A commemorative plaque bears witness to their activities. Adding a historical curiosity to the natural beauty of the site."
    ],
    "it": [
      "I Maquis stabilirono un campo di addestramento sul Mandallaz e in particolare una base al Rocher du Maquis nel 1944. Una targa commemorativa testimonia le loro attività. Questo aggiunge una curiosità storica alla bellezza naturale del luogo."
    ],
    "fr": [
      "Les Maquisards ont établi un camp d'entraînement sur la Mandallaz, et particulièrement une base au Rocher du Maquis en 1944. Une plaque commémorative témoigne de leurs activités. De quoi ajouter une curiosité historique à la beauté naturelle du lieu."
    ],
    "es": [
      "Los maquis establecieron un campo de entrenamiento en el Mandallaz, y particularmente una base en el Rocher du Maquis en 1944. Una placa conmemorativa atestigua sus actividades. Esto añade una curiosidad histórica a la belleza natural del lugar."
    ],
    "nl": [
      "De Maquis vestigde een trainingskamp op de Mandallaz, en vooral een basis op de Rocher du Maquis in 1944. Een gedenkplaat getuigt van hun activiteiten. Dit voegt een historische nieuwsgierigheid toe aan de natuurlijke schoonheid van de plaats."
    ]
  },
  "rdfs:label": {
    "en": [
      "Rocher du Maquis - Mandallaz"
    ],
    "fr": [
      "Rocher du Maquis - Mandallaz"
    ]
  },
