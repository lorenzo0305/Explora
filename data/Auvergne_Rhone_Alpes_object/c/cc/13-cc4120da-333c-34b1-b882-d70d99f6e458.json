  "rdfs:comment": {
    "de": [
      "Verleih von Mountainbikes (mehrere Größen verfügbar), elektrischen VTCs und Zubehör (Babytrage und Anhänger) für einen Tag, einen halben Tag oder eine Woche.\r\nVerkauf und Reparatur von Fahrrädern, Motorrädern und Quads.\r\nReservierung im Juli und August empfohlen."
    ],
    "en": [
      "Mountain bike (several sizes available) and electric bike hire for the day, half-day or week. Bike, motorbike and quad sales and repairs."
    ],
    "it": [
      "Noleggio di mountain bike (diverse misure disponibili), mountain bike elettriche e accessori (marsupio e rimorchio) a giornata, mezza giornata o settimana.\r\nVendita e riparazione di biciclette, moto e quad.\r\nSi consiglia la prenotazione nei mesi di luglio e agosto."
    ],
    "fr": [
      "Location de VTT (plusieurs tailles disponibles), VTC électriques et accessoires (porte-bébé et remorque) à la journée, demi journée ou semaine. \r\nVente et réparation de cycles, motos et quads.\r\nRéservation conseillée en juillet-août."
    ],
    "nl": [
      "Verhuur van mountainbikes (verschillende maten beschikbaar), elektrische mountainbikes en accessoires (draagzak en aanhanger) per dag, halve dag of week.\r\nVerkoop en reparatie van fietsen, motoren en quads.\r\nReserveren aanbevolen in juli en augustus."
    ],
    "es": [
      "Alquiler de bicicletas de montaña (varios tamaños disponibles), bicicletas de montaña eléctricas y accesorios (portabebés y remolque) por días, medias jornadas o semanas.\r\nVenta y reparación de bicicletas, motos y quads.\r\nSe recomienda reservar en julio y agosto."
    ]
  },
