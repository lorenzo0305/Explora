  "rdfs:comment": {
    "de": [
      "Verleih von Elektrobooten ohne Führerschein auf dem Lac d'Allier\r\nund Verkauf von Produkten für Snacks aus lokalen Produkten.\r\nMaßgeschneiderte Veranstaltungen können auf Anfrage organisiert werden."
    ],
    "en": [
      "Rental of electric boats on Lac d?Allier without a license\r\nand sale of products for snacks based on local produce.\r\nTailor-made events can be organized on request."
    ],
    "it": [
      "Noleggio di imbarcazioni elettriche senza licenza sul Lac d'Allier\r\ne vendita di prodotti per spuntini a base di prodotti locali.\r\nSu richiesta è possibile organizzare eventi su misura."
    ],
    "fr": [
      "Location de bateaux électriques sans permis sur le Lac d’Allier\r\net vente de produits pour des collations à base de produits locaux.\r\nDes évènements sur-mesure peuvent être organisés sur demande."
    ],
    "nl": [
      "Verhuur van elektrische boten zonder vaarbewijs op het Lac d'Allier\r\nen verkoop van snacks op basis van lokale producten.\r\nOp verzoek kunnen er evenementen op maat worden georganiseerd."
    ],
    "es": [
      "Alquiler de embarcaciones eléctricas sin licencia en el Lac d'Allier\r\ny venta de productos para aperitivos a base de productos locales.\r\nSe pueden organizar eventos a medida previa petición."
    ]
  },
