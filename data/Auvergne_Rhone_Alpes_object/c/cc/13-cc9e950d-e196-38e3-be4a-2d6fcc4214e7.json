  "rdfs:comment": {
    "de": [
      "KONZEPT VON MAMMA PIZZA\r\nEin Teig, den man ruhen lässt.\r\nMit der Hand ausrollen.\r\nEin hochwertiges italienisches Mehl.\r\nEine geschälte San Marzano DOP-Tomate.\r\nFrische, authentische, natürliche und handwerklich hergestellte Produkte."
    ],
    "en": [
      "MAMMA PIZZA CONCEPT\r\nDough left to rest.\r\nHand rolled.\r\nQuality Italian flour.\r\nSan Marzano DOP peeled tomatoes.\r\nFresh, authentic, natural and artisanal products."
    ],
    "it": [
      "CONCETTO DI PIZZA MAMMA\r\nImpasto lasciato riposare.\r\nSteso a mano.\r\nFarina italiana di qualità.\r\nPomodoro pelato San Marzano DOP.\r\nProdotti freschi, autentici, naturali e tradizionali."
    ],
    "fr": [
      "CONCEPT DE MAMMA PIZZA \r\nUne pâte qu’on laisse reposer.\r\nÉtalage à la main.\r\nUne farine italienne de qualité.\r\nUne tomate pelée San Marzano DOP.\r\nProduits frais, authentiques, naturels et artisanaux."
    ],
    "nl": [
      "MAMMA PIZZA CONCEPT\r\nDeeg laten rusten.\r\nMet de hand gerold.\r\nItaliaanse kwaliteitsbloem.\r\nEen San Marzano DOP gepelde tomaat.\r\nVerse, authentieke, natuurlijke en ambachtelijke producten."
    ],
    "es": [
      "CONCEPTO MAMMA PIZZA\r\nMasa dejada reposar.\r\nEnrollada a mano.\r\nHarina italiana de calidad.\r\nTomate pelado San Marzano DOP.\r\nProductos frescos, auténticos, naturales y tradicionales."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Mamma Pizza"
    ]
  },
