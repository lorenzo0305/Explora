  "rdfs:comment": {
    "de": [
      "La Dolce Vita ist ein italienisches Restaurant, das authentische und gesellige Hausmannskost anbietet. Der Chefkoch bietet jeden Abend einen Vorschlag an, und Sie können unsere Pizzen und italienischen Produkte auch mitnehmen."
    ],
    "en": [
      "La Dolce Vita is an Italian restaurant offering authentic and friendly home cooking. The chef offers a suggestion every evening, and you can take away our pizzas and Italian products."
    ],
    "it": [
      "La Dolce Vita è un ristorante italiano che offre una cucina casalinga autentica e accogliente. Lo chef propone ogni sera un suggerimento, ed è possibile portare via le nostre pizze e i nostri prodotti italiani."
    ],
    "fr": [
      "La Dolce Vita est un restaurant italien proposant une cuisine maison authentique et conviviale. Le chef propose une suggestion chaque soir, et vous pouvez emporter nos pizzas et produits italiens."
    ],
    "nl": [
      "La Dolce Vita is een Italiaans restaurant met een authentieke en vriendelijke thuiskeuken. De chef biedt elke avond een suggestie en u kunt onze pizza's en Italiaanse producten meenemen."
    ],
    "es": [
      "La Dolce Vita es un restaurante italiano que ofrece cocina casera, auténtica y acogedora. El chef ofrece una sugerencia cada noche, y puedes llevarte nuestras pizzas y productos italianos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Dolce Vita"
    ]
  },
