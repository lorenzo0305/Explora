  "rdfs:comment": {
    "de": [
      "Der Galeriebereich von Mélanie Veyrond befindet sich im Herzen der Rue du Bourg in Dieulefit. Sie können\r\ndie Dauerausstellung ihrer Gemälde und Skulpturen entdecken. Außerdem organisiert sie regelmäßig Kurse und Workshops rund um das Thema Kunst."
    ],
    "en": [
      "Mélanie Veyrond?s gallery is located in the heart of the Rue du Bourg in Dieulefit. Here you can\r\ndiscover a permanent exhibition of her paintings and sculptures. Mélanie also regularly organizes creative workshops and courses."
    ],
    "it": [
      "La galleria di Mélanie Veyrond si trova nel cuore di Rue du Bourg a Dieulefit. Potrete scoprire\r\nscoprire l'esposizione permanente dei suoi dipinti e delle sue sculture. Mélanie organizza regolarmente corsi e workshop sul tema della creazione."
    ],
    "fr": [
      "L’Espace galerie de Mélanie Veyrond se trouve au coeur de la rue du Bourg à Dieulefit. Vous pourrez\r\ndécouvrir l’exposition permanente de ses peintures et sculptures. Ainsi que l’organisation régulière de stages et d’ateliers autour de la Création."
    ],
    "es": [
      "La galería de Mélanie Veyrond está situada en el corazón de la Rue du Bourg, en Dieulefit. Podrá\r\ndescubrir la exposición permanente de sus pinturas y esculturas. Mélanie también organiza regularmente cursos y talleres sobre el tema de la creación."
    ],
    "nl": [
      "De galerie van Mélanie Veyrond ligt in het hart van de Rue du Bourg in Dieulefit. Je kunt er\r\nde permanente tentoonstelling van haar schilderijen en beeldhouwwerken ontdekken. Mélanie organiseert ook regelmatig cursussen en workshops over het thema creatie."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Atelier Galerie Mélanie Veyrond"
    ]
  },
