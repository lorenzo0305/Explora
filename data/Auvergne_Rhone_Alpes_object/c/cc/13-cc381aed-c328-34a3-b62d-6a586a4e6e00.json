  "rdfs:comment": {
    "de": [
      "Octopus 43 ist eine traditionelle Schuhmacherei, die auch verschiedene Dienstleistungen im Bereich der Kommunikation sowie die Herstellung von Minutenschlüsseln und den Verkauf von Lederwaren und Besteck anbietet."
    ],
    "en": [
      "Octopus 43 is a traditional cobbler's shop that also offers a range of communication services, as well as the manufacture of wrenches and the sale of leather goods and cutlery."
    ],
    "it": [
      "Octopus 43 è una tradizionale calzoleria che offre anche una serie di servizi di comunicazione, oltre alla produzione di chiavi inglesi e alla vendita di articoli in pelle e posate."
    ],
    "fr": [
      "Octopus 43 est une cordonnerie traditionnelle qui propose également plusieurs services au niveau de la communication ainsi que de la fabrication de clefs minute et de la vente de produits de maroquinerie et coutellerie."
    ],
    "nl": [
      "Octopus 43 is een traditionele schoenmakerij die ook een reeks communicatiediensten aanbiedt, evenals de vervaardiging van steeksleutels en de verkoop van lederwaren en bestek."
    ],
    "es": [
      "Octopus 43 es una zapatería tradicional que también ofrece diversos servicios de comunicación, así como la fabricación de llaves inglesas y la venta de artículos de cuero y cuchillería."
    ]
  },
  "rdfs:label": {
