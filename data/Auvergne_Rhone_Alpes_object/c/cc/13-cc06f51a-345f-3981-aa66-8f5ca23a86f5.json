  "rdfs:comment": {
    "de": [
      "Finden Sie frisches Obst und Gemüse in Ihrem Primeurladen \"Le drômois\" an der Seite eines Metzgers und eines Bäckers/Patissiers."
    ],
    "en": [
      "Find fresh fruit and vegetables in your \"Le drômois\" greengrocer's store, alongside a butcher and a baker/patissier."
    ],
    "it": [
      "Trovate frutta e verdura fresca nel vostro fruttivendolo \"Le drômois\", accanto a un macellaio e a un panettiere/pasticciere."
    ],
    "fr": [
      "Retrouvez des fruits et légumes frais dans votre magasin primeur \"Le drômois\" au côté d'un boucher et d'un boulanger/patissier."
    ],
    "nl": [
      "Vind verse groenten en fruit in je groentewinkel \"Le drômois\", naast een slager en een bakker/patissier."
    ],
    "es": [
      "Encontrará frutas y verduras frescas en su frutería \"Le drômois\", junto a un carnicero y un panadero/pastelero."
    ]
  },
