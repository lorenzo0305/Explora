  "rdfs:comment": {
    "de": [
      "Das Restaurant Sylvestre wurde mit zwei Michelin-Sternen ausgezeichnet und bietet ein außergewöhnliches gastronomisches Erlebnis, das Raffinesse, Kreativität und kulinarische Emotionen auf subtile Weise miteinander verbindet."
    ],
    "en": [
      "The restaurant \"Sylvestre\" recognized for its cuisine linking the colors and features of the Alpilles to the Alps, strong in meaning and character by its travel inspirations."
    ],
    "it": [
      "Insignito di due stelle dalla Guida Michelin, il ristorante Sylvestre offre un'esperienza gastronomica eccezionale, mescolando sottilmente raffinatezza, creatività ed emozione culinaria."
    ],
    "fr": [
      "Distingué par deux étoiles au Guide Michelin, le restaurant Sylvestre offre une expérience gastronomique d’exception, mêlant subtilement raffinement, créativité et émotion culinaire."
    ],
    "nl": [
      "Het restaurant Sylvestre, bekroond met twee sterren in de Michelin-gids, biedt een uitzonderlijke gastronomische ervaring, waarbij verfijning, creativiteit en culinaire emotie op subtiele wijze worden gecombineerd."
    ],
    "es": [
      "Galardonado con dos estrellas en la Guía Michelin, el restaurante Sylvestre ofrece una experiencia gastronómica excepcional, mezclando sutilmente refinamiento, creatividad y emoción culinaria."
    ]
  },
