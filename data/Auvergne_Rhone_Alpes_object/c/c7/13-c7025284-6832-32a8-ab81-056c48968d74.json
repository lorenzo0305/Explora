  "rdfs:comment": {
    "de": [
      "Der Etang Brenot ist ein touristisches Gewässer, das von der AAPPMA \"Les pêcheurs du Lignon\" verwaltet wird. Er ist gut besetzt (Rotaugen, Karpfen, Schleie, Hechte...) und kann das ganze Jahr über befischt werden."
    ],
    "en": [
      "Etang Brenot is a tourist lake managed by the AAPPMA \"Les pêcheurs du Lignon\". Well stocked with roach, carp, tench and pike, it is open all year round."
    ],
    "it": [
      "L'Etang Brenot è un lago turistico gestito dall'AAPPMA \"Les pêcheurs du Lignon\". Ben fornito di pesci (lasche, carpe, tinche, lucci, ecc.), è aperto tutto l'anno."
    ],
    "fr": [
      "L'étang Brenot est un plan d'eau touristique, géré par l'AAPPMA \"Les pêcheurs du Lignon\". Bien empoissonné (gardons, carpes, tanches, brochets...), il permet la pêche toute l'année."
    ],
    "nl": [
      "Het Etang Brenot is een toeristisch meer dat wordt beheerd door de AAPPMA \"Les pêcheurs du Lignon\". Het meer is goed gevuld met vis (voorn, karper, zeelt, snoek, enz.) en is het hele jaar geopend."
    ],
    "es": [
      "El Etang Brenot es un lago turístico gestionado por la AAPPMA \"Les pêcheurs du Lignon\". Bien surtido de peces (cucarachas, carpas, tencas, lucios, etc.), está abierto todo el año."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Etang Brenot - Plan d'eau touristique"
    ]
  },
