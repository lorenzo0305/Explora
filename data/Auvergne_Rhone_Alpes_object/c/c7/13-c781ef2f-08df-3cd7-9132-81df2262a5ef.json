  "rdfs:comment": {
    "de": [
      "Das Weingut (8,5 ha) liegt auf den Côteaux de la Remonde im Herzen des Dorfes Saint-Savin in der Region Nord-Isère (38300) und produziert eine ganze Reihe von geselligen Weinen, die sich ideal als Aperitif oder zum Essen eignen.\r\nSiegel der Marke ISHERE."
    ],
    "en": [
      "The Domaine (8,5ha) is located on the slopes of the Rémonde in the heart of the village of Saint-Savin, in the Nord-Isère region (38300), and produces a whole range of convivial wines, ideal for the aperitif or to share during a meal.\r\nLabel of the ISHERE brand."
    ],
    "it": [
      "Il Domaine (8,5ha) si trova sulle pendici della Rémonde nel cuore del villaggio di Saint-Savin, nella regione Nord-Isère (38300), e produce una gamma di vini conviviali, ideali per l'aperitivo o da condividere durante un pasto.\r\nEtichetta del marchio ISHERE."
    ],
    "fr": [
      "Le Domaine (8,5ha) est situé sur les côteaux de la Rémonde au cœur du village de Saint-Savin, dans le Nord-Isère (38300),  et produit toute une gamme de vins conviviaux, idéaux pour l'apéritif ou à partager au cour d'un repas.\r\nLabel de la marque ISHERE."
    ],
    "nl": [
      "Het Domaine (8,5ha) is gelegen op de hellingen van de Rémonde in het hart van het dorp Saint-Savin, in de regio Nord-Isère (38300), en produceert een reeks gezellige wijnen, ideaal voor het aperitief of om te delen tijdens een maaltijd.\r\nISHERE merklabel."
    ],
    "es": [
      "El Domaine (8,5 ha) está situado en las laderas del Rémonde, en el corazón del pueblo de Saint-Savin, en la región de Nord-Isère (38300), y produce una gama de vinos conviviales, ideales para el aperitivo o para compartir durante una comida.\r\nEtiqueta de la marca ISHERE."
    ]
  },
