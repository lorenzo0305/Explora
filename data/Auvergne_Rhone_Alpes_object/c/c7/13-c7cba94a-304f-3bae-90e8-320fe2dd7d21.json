  "rdfs:comment": {
    "de": [
      "Diese Burg steht seit über 400 Jahren auf den Ebenen, die sich bis nach Saint-Léon und den ersten Mont d'Auvergne erstrecken."
    ],
    "en": [
      "For over 400 years, this castle has stood on the plains stretching as far as Saint-Léon and the first Monts d'Auvergne."
    ],
    "it": [
      "Questo castello si erge da oltre 400 anni sulla pianura che si estende fino a Saint-Léon e ai primi Monts d'Auvergne."
    ],
    "fr": [
      "Ce château se dresse depuis plus de 400 ans sur les plaines qui s'étendent jusqu'à Saint-Léon et les premiers Mont d'Auvergne."
    ],
    "es": [
      "Este castillo se alza desde hace más de 400 años en la llanura que se extiende hasta Saint-Léon y los primeros Montes de Auvernia."
    ],
    "nl": [
      "Dit kasteel staat al meer dan 400 jaar op de vlaktes die zich uitstrekken tot Saint-Léon en de eerste Monts d'Auvergne."
    ]
  },
