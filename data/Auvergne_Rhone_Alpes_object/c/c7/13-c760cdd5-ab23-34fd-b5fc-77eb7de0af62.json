  "rdfs:comment": {
    "de": [
      "Als frischgebackener Rentner hat Dominique seine Kunstmesserschmiede gegründet. Dort teilt er seine Leidenschaft für Messer und fertigt gleichzeitig einzigartige Modelle an."
    ],
    "en": [
      "Recently retired, Dominique has set up his own cutlery workshop. Here, he shares his passion for knives while creating unique models."
    ],
    "it": [
      "Da poco in pensione, Dominique ha avviato la sua attività di coltelleria. Qui condivide la sua passione per i coltelli e crea modelli unici."
    ],
    "fr": [
      "Jeune retraité, Dominique a créé sa coutellerie d'art. Il y partage sa passion pour les couteaux tout en réalisant des modèles uniques."
    ],
    "es": [
      "Recientemente jubilado, Dominique ha creado su propia empresa de cuchillería. Aquí comparte su pasión por los cuchillos y crea modelos únicos."
    ],
    "nl": [
      "Dominique is onlangs met pensioen gegaan en heeft zijn eigen bestekzaak opgezet. Hier deelt hij zijn passie voor messen en creëert hij unieke modellen."
    ]
  },
  "rdfs:label": {
