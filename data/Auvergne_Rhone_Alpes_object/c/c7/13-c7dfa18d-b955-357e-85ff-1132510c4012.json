  "rdfs:comment": {
    "de": [
      "Für alle zugänglich, an abgelegenen Orten voller Gelassenheit und Authentizität. Sie werden sich in den Charme dieser Aktivität verlieben, die es Ihnen ermöglicht, die Natur zu entdecken und gleichzeitig neue Energie zu tanken. Kontaktieren Sie die ESF für weitere Informationen & Reservierungen."
    ],
    "en": [
      "Accessible to all, in secluded places full of serenity and authenticity. You'll fall under the spell of this activity that lets you discover nature and recharge your batteries at the same time. Contact the ESF for more information & reservations."
    ],
    "it": [
      "Accessibile a tutti, in luoghi appartati, pieni di serenità e autenticità. Vi lascerete incantare da questa attività che vi permetterà di scoprire la natura e di ricaricarvi allo stesso tempo. Contattare l'ESF per ulteriori informazioni e prenotazioni."
    ],
    "fr": [
      "Accessible à tous, dans des lieux à l'écart, pleins de sérénité et d'authenticité. Vous tomberez sous le charme de cette activité qui permet à la fois de découvrir la nature et de se ressourcer. Contactez l'ESF pour plus d'informations & réservation."
    ],
    "nl": [
      "Toegankelijk voor iedereen, op afgelegen plaatsen, vol sereniteit en authenticiteit. U zult in de ban raken van deze activiteit die u in staat stelt de natuur te ontdekken en tegelijkertijd nieuwe energie op te doen. Neem contact op met de ESF voor meer informatie en boekingen."
    ],
    "es": [
      "Accesible para todos, en lugares apartados, llenos de serenidad y autenticidad. Caerás en el encanto de esta actividad que te permite descubrir la naturaleza y recargar las pilas al mismo tiempo. Póngase en contacto con el FSE para obtener más información y reservar."
    ]
  },
  "rdfs:label": {
    "en": [
      "Snowshoeing with ESF"
    ],
    "fr": [
      "Balade en raquettes avec l'ESF"
    ],
    "nl": [
      "Sneeuwschoenwandeling met de ESF"
    ]
  },
