  "rdfs:comment": {
    "de": [
      "Rund 800 Objekte: Weinbau, Posamentenherstellung, Holzschuhmacher, Schmied, Gegenstände aus früheren Zeiten, regionale Mineralogie, Bergwerk, Schule aus den 50er Jahren, altes Spielzeug."
    ],
    "en": [
      "Nearly 800 objects: vineyards, trimmings, clog makers, blacksmiths, objects of yesteryear, regional mineralogy, mining, schools of the 50s, antique toys."
    ],
    "it": [
      "Quasi 800 oggetti: vigneti, passamanerie, zoccolai, fabbri, oggetti del passato, mineralogia regionale, miniere, scuole degli anni '50, vecchi giocattoli."
    ],
    "fr": [
      "Près de 800 objets : la vigne, la passementerie, le sabotier, le forgeron, les objets d'autrefois, la minéralogie régionale, la mine, l'école des années 50, les jouets anciens."
    ],
    "es": [
      "Cerca de 800 objetos: viñedos, guarniciones, fabricantes de zuecos, herreros, objetos del pasado, mineralogía regional, minería, escuelas de los años 50, juguetes antiguos."
    ],
    "nl": [
      "Bijna 800 objecten: wijngaarden, snoeisel, klompenmakers, smeden, voorwerpen uit het verleden, regionale mineralogie, mijnbouw, scholen uit de jaren 1950, oud speelgoed."
    ]
  },
