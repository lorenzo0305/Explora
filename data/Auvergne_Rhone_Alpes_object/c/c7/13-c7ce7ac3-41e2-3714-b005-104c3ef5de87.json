  "rdfs:comment": {
    "de": [
      "Es handelt sich um einen kleinen, 50 cm breiten Durchgang, der die Rue du Courreau mit der Porte du Portalet und dem Platz \"Grand Pous\" verbindet. Diese Gasse existierte bereits auf dem Kataster von 1409."
    ],
    "en": [
      "It's a small, 50 cm-wide passageway linking the rue du Courreau to the Porte du Portalet and the Place du Grand Pous. This alleyway already existed on the 1409 land register."
    ],
    "it": [
      "Si tratta di un piccolo passaggio largo 50 cm che collega la rue du Courreau alla porta del Portalet e alla place du \"Grand Pous\". Questo vicolo esisteva già nel catasto del 1409."
    ],
    "fr": [
      "C'est un petit passage de 50 cm de large qui relie la rue du Courreau à la porte du Portalet et à la place du \" Grand Pous \". Cette venelle existait déjà sur le cadastre de 1409."
    ],
    "es": [
      "Se trata de un pequeño pasillo de 50 cm de ancho que conecta la rue du Courreau con la puerta del Portalet y la plaza del \"Grand Pous\". Este callejón ya existía en el catastro de 1409."
    ],
    "nl": [
      "Dit is een kleine doorgang van 50 cm breed die de rue du Courreau verbindt met de Porte du Portalet en de Place du Grand Pous. Dit steegje bestond al in het kadaster van 1409."
    ]
  },
