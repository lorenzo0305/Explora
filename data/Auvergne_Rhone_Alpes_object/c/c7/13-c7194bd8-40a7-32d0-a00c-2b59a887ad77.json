  "rdfs:comment": {
    "de": [
      "Wenig schwierige Skitourenroute, Ausgangspunkt Maison du Grand Veymont, mit einem Aufstieg im Wald Sektor Bois des fayolles (Odyssée Verte) und einer Abfahrt auf der blauen Piste piochanet"
    ],
    "en": [
      "Itinerary not very difficult for ski touring, departure from the Grand Veymont house, with an ascent in the forest in the Bois des Fayolles sector (Odyssée Verte) and a descent on the blue Piochanet trail"
    ],
    "it": [
      "Facile itinerario di scialpinismo, con partenza dalla casa Grand Veymont, con salita nella foresta del Bois des Fayolles (Odyssée Verte) e discesa sulla pista blu del Piochanet"
    ],
    "fr": [
      "Itinéraire peu difficile de ski de randonnée, départ maison du Grand Veymont, avec une montée en forêt secteur bois des fayolles (Odyssée Verte) et une descente sur piste bleue piochanet"
    ],
    "es": [
      "Itinerario de esquí de travesía fácil, partiendo de la casa Grand Veymont, con un ascenso en el bosque Bois des Fayolles (Odyssée Verte) y un descenso en la pista azul Piochanet"
    ],
    "nl": [
      "Eenvoudige toerskiroute vanaf het Grand Veymont huis, met een klim in het Bois des Fayolles bos (Odyssée Verte) en een afdaling op de blauwe Piochanet piste"
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'Odyssée Blanche"
    ]
  },
