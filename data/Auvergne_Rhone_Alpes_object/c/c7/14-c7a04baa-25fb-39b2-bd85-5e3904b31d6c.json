  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/308da578-d24c-3ef6-aeca-3cf7bac85102",
      "dc:description": {
        "de": [
          "Will war 2017 Halbfinalist bei The Voice und wurde von Zazie ausgewählt.\nEr nahm auch an The Voice All Stars im Jahr 2020 teil. Sänger von Rock-, Country- und Soulmusik... tritt weltweit auf."
        ],
        "en": [
          "Will was a semi-finalist in The Voice in 2017, Zazie's protégé.\nHe also participated in The Voice All Stars in 2020. Rock, country and soul music singer... performs all over the world."
        ],
        "it": [
          "Will è stato un semifinalista di The Voice nel 2017, pupillo di Zazie.\nHa partecipato anche a The Voice All Stars nel 2020. Cantante di musica rock, country e soul, si esibisce in tutto il mondo."
        ],
        "fr": [
          "Will à été demi finaliste The Voice en 2017, poulain de Zazie. \nIl a participé également à The Voice All Stars en 2020. Chanteur de rock, country et soul musique... se produit dans le monde entier."
        ],
        "nl": [
          "Will was een halve finalist in The Voice in 2017, Zazie's protegé.\nHij nam ook deel aan The Voice All Stars in 2020. Als zanger van rock-, country- en soulmuziek treedt hij over de hele wereld op."
        ],
        "es": [
          "Will fue semifinalista en The Voice en 2017, protegido de Zazie.\nTambién participó en The Voice All Stars en 2020. Cantante de música rock, country y soul, actúa por todo el mundo."
        ]
      },
