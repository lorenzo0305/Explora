  "rdfs:comment": {
    "de": [
      "Verpflegen Sie sich bei guten Gerichten aus den Bergen: Fondue jurassienne...\r\nVerkauf auch von handwerklichen Produkten zum Mitnehmen."
    ],
    "en": [
      "Enjoy mountain dishes such as Jura fondue...\r\nWe also sell artisanal products to take away."
    ],
    "it": [
      "Cenate con deliziosi piatti di montagna: fonduta del Giura...\r\nVendiamo anche prodotti fatti in casa da portare via."
    ],
    "fr": [
      "Restaurez-vous autour de bons plats montagnards : fondue jurassienne...\r\nVente également de produits artisanaux à emporter."
    ],
    "nl": [
      "Dineer met heerlijke berggerechten: fondue uit de Jura...\r\nWe verkopen ook zelfgemaakte producten om mee te nemen."
    ],
    "es": [
      "Cene deliciosos platos de montaña: fondue del Jura...\r\nTambién vendemos productos caseros para llevar."
    ]
  },
