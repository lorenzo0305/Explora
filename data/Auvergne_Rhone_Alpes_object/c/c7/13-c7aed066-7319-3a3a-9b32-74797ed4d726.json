  "rdfs:comment": {
    "de": [
      "Die Pfarrei Sainte Marie en Royans-Vercors ist ein Kultverein, der Dienstleistungen und Aktivitäten für Mitglieder der katholischen Kirche anbietet, sowohl für Erwachsene (Krankenbesuche, Kommunion, Bibelteilen) als auch für Jugendliche (Katechese)."
    ],
    "en": [
      "The Sainte Marie en Royans-Vercors parish is a religious association offering services and activities for members of the Catholic Church, both adults (visiting the sick, communion, Bible sharing) and young people (catechesis)."
    ],
    "it": [
      "La parrocchia di Sainte Marie en Royans-Vercors è un'associazione religiosa che offre servizi e attività ai membri della Chiesa cattolica, sia per gli adulti (visita ai malati, comunione, condivisione della Bibbia) che per i giovani (catechesi)."
    ],
    "fr": [
      "La paroisse Sainte Marie en Royans-Vercors est une association cultuelle qui propose des services et activités aux membres de l'église catholique tant pour les adultes (visites aux malades, communion, partage biblique) que pour jeunes (catéchèse)."
    ],
    "es": [
      "La parroquia Sainte Marie en Royans-Vercors es una asociación religiosa que ofrece servicios y actividades a los miembros de la Iglesia católica, tanto para adultos (visita a enfermos, comunión, compartir la Biblia) como para jóvenes (catequesis)."
    ],
    "nl": [
      "De parochie Sainte Marie en Royans-Vercors is een religieuze vereniging die diensten en activiteiten aanbiedt aan leden van de katholieke kerk, zowel voor volwassenen (ziekenbezoek, communie, Bijbeluitleg) als voor jongeren (catechese)."
    ]
  },
  "rdfs:label": {
