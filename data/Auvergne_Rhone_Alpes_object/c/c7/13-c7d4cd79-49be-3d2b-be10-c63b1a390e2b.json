  "rdfs:comment": {
    "de": [
      "Liebhaber von Wasser- und Natursportarten sind hier genau richtig: Vor Ort ist alles vorhanden, um einen angenehmen Tag zu verbringen und dabei die Kniffe des Windsurfens zu erlernen."
    ],
    "en": [
      "If you're a water sports or nature sports enthusiast, this is the place for you: everything you need to spend a pleasant day learning the ropes of windsurfing is on site."
    ],
    "it": [
      "Se siete appassionati di sport acquatici o di natura, questo è il posto che fa per voi: tutto ciò che serve per trascorrere una piacevole giornata imparando le corde del windsurf è in loco."
    ],
    "fr": [
      "Amoureux des sports nautiques et des sports nature, le site est fait pour vous : tout est prévu sur place pour passer une agréable journée en apprenant les ficelles de la planche à voile."
    ],
    "es": [
      "Si te gustan los deportes acuáticos o de naturaleza, éste es tu sitio: todo lo que necesitas para pasar un agradable día aprendiendo windsurf está allí mismo."
    ],
    "nl": [
      "Als je van watersport of natuursport houdt, is dit de plek voor jou: alles wat je nodig hebt om een aangename dag door te brengen en de kneepjes van het windsurfen te leren, is ter plaatse."
    ]
  },
  "rdfs:label": {
