  "rdfs:comment": {
    "de": [
      "Ich habe mich als Produzentin von Duft-, Heil- und Aromapflanzen niedergelassen und habe das Vergnügen, die Pflanzen zu säen, zu pflanzen, zu ernten und zu trocknen, damit Sie diese Köstlichkeiten der Natur entdecken und genießen können."
    ],
    "en": [
      "Established as a producer of pharmaceutical, medicinal and aromatic plants, since August 2016, I have the pleasure of sowing, planting, harvesting and drying the plants of my garden in order to be able to make everyone discover these delights of Nature."
    ],
    "it": [
      "Come produttrice di piante profumate, medicinali e aromatiche, ho il piacere di seminare, piantare, raccogliere ed essiccare le piante affinché possiate scoprire e godere di queste delizie naturali."
    ],
    "fr": [
      "Installée en tant que productrice de plantes à parfums, médicinales et aromatiques, j'ai le plaisir de semer, planter, récolter et sécher les plantes afin de vous faire découvrir, deguster ces délices de la Nature."
    ],
    "es": [
      "Como productora de plantas perfumadas, medicinales y aromáticas, tengo el placer de sembrar, plantar, cosechar y secar las plantas para que usted pueda descubrir y disfrutar de estas delicias naturales."
    ],
    "nl": [
      "Als producent van geparfumeerde, geneeskrachtige en aromatische planten heb ik het genoegen de planten te zaaien, te planten, te oogsten en te drogen zodat u deze natuurlijke heerlijkheden kunt ontdekken en ervan kunt genieten."
    ]
  },
