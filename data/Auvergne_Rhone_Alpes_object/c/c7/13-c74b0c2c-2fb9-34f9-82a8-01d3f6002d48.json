  "rdfs:comment": {
    "de": [
      "Disc-Golf-Parcours im Freien, der selbstständig begangen werden kann.\r\nEin Einführungsparcours für Frisbee-Golf / Flying Disc mit 6-9 verschiedenen Abschlägen. Ziel ist es, den Korb mit der Scheibe (gleichzusetzen mit dem Loch beim Golf) mit einem Minimum an Würfen zu erreichen."
    ],
    "en": [
      "Self-guided outdoor disc golf course.\r\nIntroductory Frisbee golf / flying disc course with 6-9 different starts. The aim is to reach the basket with the disc (assimilated to the hole in golf) in as few throws as possible."
    ],
    "it": [
      "Campo da disc golf all'aperto autoguidato.\r\nUn percorso introduttivo di frisbee golf/disco volante con 6-9 partenze diverse. L'obiettivo è raggiungere il canestro con il disco (simile alla buca nel golf) nel minor numero di lanci possibile."
    ],
    "fr": [
      "Parcours de disc golf en extérieur accessible en autonomie.\r\nParcours d’initiation de frisbee golf / flying disc avec 6-9 départs différents. L’objectif est d’atteindre le panier avec le disque (assimilé au trou en golf) en un minimum de lancer."
    ],
    "nl": [
      "Zelfbegeleid outdoor disc golf parcours.\r\nEen inleidend frisbeegolf- / vliegende-schijfparcours met 6-9 verschillende starts. Het doel is om de basket te bereiken met de disc (vergelijkbaar met de hole in golf) in zo min mogelijk worpen."
    ],
    "es": [
      "Recorrido autoguiado de disc golf al aire libre.\r\nUn recorrido de iniciación al frisbee golf / disco volador con 6-9 salidas diferentes. El objetivo es llegar a la cesta con el disco (similar al hoyo en el golf) en el menor número de lanzamientos posible."
    ]
  },
  "rdfs:label": {
    "de": [
      "Disc-Golf-Parcours"
    ],
    "en": [
      "Disc Golf course"
    ],
    "fr": [
      "Parcours de disc golf"
    ]
  },
