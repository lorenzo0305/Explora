  "rdfs:comment": {
    "de": [
      "Zur Freude von Groß und Klein werden Ihnen zwei Hochseilgärten angeboten: einer für Jugendliche ab 1,10 m und einer für Erwachsene und Jugendliche ab 1,40 m. Der Parcours befindet sich im Herzen der Domaine de Coudrée mit ihren jahrhundertealten Eichen."
    ],
    "en": [
      "For the pleasure of young and old alike, two accrobranche courses are offered: one for children from 1.10 m and one for adults and children from 1.40 m. The course is located in the heart of the domain of Coudrée and its hundred-year-old oaks."
    ],
    "it": [
      "Per il divertimento di grandi e piccini, sono disponibili due percorsi di accrobranche: uno per i bambini a partire da 1,10 m e uno per adulti e bambini a partire da 1,40 m. Il campo si trova nel cuore della tenuta Coudrée e delle sue querce centenarie."
    ],
    "fr": [
      "Pour le plaisir des grands comme des petits, deux parcours accrobranche vous sont proposés : un pour les jeunes dès 1.10 m et un pour les adultes et les jeunes dès 1.40m. Le parcours est situé au cœur du domaine de Coudrée et de ses chênes centenaires."
    ],
    "nl": [
      "Voor het plezier van jong en oud zijn er twee accrobranche parcoursen: een voor kinderen vanaf 1.10m en een voor volwassenen en kinderen vanaf 1.40m. Het parcours ligt in het hart van het landgoed Coudrée en de honderd jaar oude eikenbomen."
    ],
    "es": [
      "Para el disfrute de grandes y pequeños, se ofrecen dos recorridos de accrobranche: uno para niños a partir de 1,10 m y otro para adultos y niños a partir de 1,40 m. El recorrido está situado en el corazón de la finca de Coudrée y sus robles centenarios."
    ]
  },
