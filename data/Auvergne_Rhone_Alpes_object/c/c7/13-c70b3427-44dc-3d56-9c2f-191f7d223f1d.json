  "rdfs:comment": {
    "de": [
      "Indoor- und Outdoor-Spielplatz für Kinder von 0 bis 14 Jahren.\r\nDer größte Indoor- und Outdoor-Spielplatz Frankreichs, 2000 m², ausgestattet mit dem imposantesten Modulspielplatz von 3500 m², Arboretum und Außenspielen."
    ],
    "en": [
      "Indoor and outdoor playground for children aged 0 to 14.\r\nFrance's largest indoor and outdoor playground, 2000 m², equipped with the world's largest modular playground (3500 m²), arboretum and outdoor games."
    ],
    "it": [
      "Parco giochi interno ed esterno per bambini da 0 a 14 anni.\r\nIl più grande parco giochi indoor e outdoor di Francia, 2000 m², dotato del più grande gioco modulare di 3500 m², arboreto e giochi all'aperto."
    ],
    "fr": [
      "Plaine de jeux couverte et de plein air pour les enfants de 0 à 14 ans.\r\nLa plus grande plaine de jeux couverte et de plein air de France, 2000 m², équipée du plus imposant jeu modulaire de 3500 m², arboretum et jeux extérieurs."
    ],
    "es": [
      "Parque infantil interior y exterior para niños de 0 a 14 años.\r\nEl mayor parque infantil interior y exterior de Francia, de 2000 m², equipado con el mayor juego modular de 3500 m², arboreto y juegos al aire libre."
    ],
    "nl": [
      "Binnen- en buitenspeeltuin voor kinderen van 0 tot 14 jaar.\r\nDe grootste binnen- en buitenspeeltuin in Frankrijk, 2000 m², uitgerust met de grootste modulaire speeltuin van 3500 m², arboretum en buitenspelen."
    ]
  },
