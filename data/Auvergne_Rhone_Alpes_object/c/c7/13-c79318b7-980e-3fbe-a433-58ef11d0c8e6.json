  "rdfs:comment": {
    "de": [
      "Villefranche lüftet den Schleier über seinem architektonischen Erbe und bietet einen Stadtrundgang rund um die wichtigsten Orte der Stadt an. Die Innenhöfe der Renaissance und die Fassaden der Stadthäuser bilden ein denkmalgeschütztes Renaissance-Ensemble."
    ],
    "en": [
      "Villefranche reveals its architectural heritage and proposes an urban route around the city's important sites. Renaissance interior courtyards, facades of mansions constitute a Renaissance listed ensemble."
    ],
    "it": [
      "Villefranche svela il suo patrimonio architettonico e propone un tour urbano dei luoghi più importanti della città. I cortili rinascimentali e le facciate delle case cittadine costituiscono un insieme rinascimentale classificato."
    ],
    "fr": [
      "Villefranche lève le voile sur son patrimoine architectural et propose un parcours urbain autour des lieux importants de la ville. Les cours intérieures Renaissance, les façades d'hôtels particuliers constituent un ensemble Renaissance classé."
    ],
    "nl": [
      "Villefranche onthult haar architecturale erfgoed en biedt een stadswandeling langs de belangrijkste bezienswaardigheden van de stad. De binnenplaatsen uit de renaissance en de gevels van de herenhuizen vormen samen een beschermd ensemble uit de renaissance."
    ],
    "es": [
      "Villefranche da a conocer su patrimonio arquitectónico y propone un recorrido urbano por los monumentos más importantes de la ciudad. Los patios renacentistas y las fachadas de las casas de la ciudad forman un conjunto renacentista catalogado."
    ]
  },
  "rdfs:label": {
    "de": [
      "Rundgand der versteckten Schätze"
    ],
    "en": [
      "The Hidden Treasures Tour"
    ],
    "fr": [
      "Circuit des Trésors Cachés"
    ]
  },
