  "rdfs:comment": {
    "de": [
      "Bertrand Pothin eröffnet mit der Hilfe seiner Frau das Restaurant Aux 4 saveurs\" am Hafen von L'Épervière. Das Angebot an Bars, Restaurants und Familienunterhaltung dürfte Spaziergänger, Radfahrer und Segler begeistern!"
    ],
    "en": [
      "With the help of his wife, Bertrand Pothin opens ?Aux 4 saveurs? on the port de l?Épervière. A bar, restaurant and family entertainment offer that should delight walkers, cyclists and yachtsmen alike!"
    ],
    "it": [
      "Bertrand Pothin, con l'aiuto di sua moglie, apre \"Aux 4 saveurs\" sul porto di l'Épervière. Un bar, un ristorante e un'offerta di intrattenimento per famiglie che farà la gioia di escursionisti, ciclisti e diportisti!"
    ],
    "fr": [
      "Bertrand Pothin ouvre, avec l’aide de son épouse, “Aux 4 saveurs”, sur le port de l’Épervière. Une offre de bar, restauration et animation familiale qui devrait ravir promeneurs, cyclistes et plaisanciers !"
    ],
    "es": [
      "Bertrand Pothin, con la ayuda de su esposa, abre \"Aux 4 saveurs\" en el puerto de l'Épervière. Una oferta de bar, restaurante y ocio familiar que hará las delicias de paseantes, ciclistas y navegantes"
    ],
    "nl": [
      "Bertrand Pothin opent samen met zijn vrouw \"Aux 4 saveurs\" aan de haven van l'Épervière. Een bar, restaurant en amusementsaanbod voor het hele gezin waar zowel wandelaars, fietsers als zeilers blij mee zullen zijn!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Guinguette \"Aux 4 saveurs\""
    ]
  },
