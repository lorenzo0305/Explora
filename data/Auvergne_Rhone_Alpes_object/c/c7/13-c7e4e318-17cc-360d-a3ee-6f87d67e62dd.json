  "rdfs:comment": {
    "de": [
      "Ich stelle Gebrauchs- und Dekorationskeramik her, um\r\ndie Rituale des Alltags begleiten, in einem Stil, der gleichzeitig\r\nrustikal und ganz fein."
    ],
    "en": [
      "I make utilitarian and decorative pottery to accompany\r\nto accompany everyday rituals, in a style that is both rustic\r\nrustic style."
    ],
    "it": [
      "Realizzo ceramiche in gres per accompagnare dolcemente i vostri riti quotidiani, ma anche per le piante, il giardino e la biodiversità. Le mie ceramiche artigianali sono smaltate e decorate con argille selvatiche della Drôme."
    ],
    "fr": [
      "Je réalise à la main des céramiques en grès pour accompagner vos rituels du quotidien en douceur, mais également pour les plantes, le jardin et la biodiversité. Mes poteries artisanales sont émaillées et décorées d'argiles sauvages de la Drôme."
    ],
    "nl": [
      "Ik maak gebruiks- en sieraardewerk als begeleiding\r\nom alledaagse rituelen te begeleiden, in een stijl die zowel rustiek\r\nrustieke stijl."
    ],
    "es": [
      "Hago a mano cerámicas de gres para acompañar con delicadeza sus rituales cotidianos, pero también para las plantas, el jardín y la biodiversidad. Mi cerámica artesanal está esmaltada y decorada con arcillas silvestres de Drôme."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Pâquerette - Artisane potière"
    ]
  },
