  "rdfs:comment": {
    "de": [
      "Das Restaurant Ma Grand Mère liegt in Vienne im Departement Isère und lädt Sie in eine warme und freundliche Umgebung ein, um Ihnen eine schmackhafte Küche mit Lyoner Spezialitäten, Fleisch und Fisch aus dem Holzofen zu präsentieren!"
    ],
    "en": [
      "Located in Vienne in Isère, the restaurant Ma Grand Mère invites you in a warm and friendly environment to discover a tasty cuisine, with specialties from Lyon, meat and fish cooked in a wood oven!"
    ],
    "it": [
      "Situato a Vienne, nell'Isère, il ristorante Ma Grand-Mère vi invita a scoprire la sua atmosfera calda e accogliente e la sua deliziosa cucina, con specialità lionesi e carne e pesce cotti nel forno a legna!"
    ],
    "fr": [
      "Situé à Vienne en Isère, le restaurant Ma Grand-Mère vous invite dans un cadre chaleureux et convivial pour vous faire découvrir une savoureuse cuisine, avec spécialités lyonnaises, viandes et poissons cuits au four à bois !"
    ],
    "es": [
      "Situado en Vienne, en Isère, el restaurante Ma Grand-Mère le invita a descubrir su ambiente cálido y acogedor y su deliciosa cocina, con especialidades lionesas y carnes y pescados cocinados en horno de leña"
    ],
    "nl": [
      "Het restaurant Ma Grand-Mère ligt in Vienne in Isère en nodigt je uit om de warme en gezellige sfeer en de heerlijke keuken te ontdekken, met specialiteiten uit Lyon en vlees en vis bereid in een houtoven!"
    ]
  },
