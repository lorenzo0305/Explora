  "rdfs:comment": {
    "de": [
      "Sie schöpft ihre Inspiration aus der gewöhnlichen Menschheit, ihre Stücke sind meist figurativ, von Poesie und Fantasie geprägt."
    ],
    "en": [
      "She draws her inspiration from ordinary humanity, her pieces are mostly figurative, full of poetry and fantasy."
    ],
    "it": [
      "Trae ispirazione dall'umanità comune, le sue opere sono per lo più figurative, piene di poesia e fantasia."
    ],
    "fr": [
      "Elle puise son inspiration dans l'humanité ordinaire, ses pièces sont pour la plupart figuratives, empreintes de poésie et de fantaisie."
    ],
