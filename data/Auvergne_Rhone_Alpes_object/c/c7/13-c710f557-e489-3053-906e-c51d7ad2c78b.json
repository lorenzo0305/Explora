  "rdfs:comment": {
    "de": [
      "In Morestel, in den Balcons du Dauphiné, weniger als eine Stunde von Lyon entfernt, bieten Manon und Vincent Ihnen die Möglichkeit, ihre 6 vor Ort hergestellten Biere aus dem festen Sortiment in einer gemütlichen Atmosphäre mit Blick auf das Sudhaus zu probieren."
    ],
    "en": [
      "Located in Morestel, in the Balcons du Dauphiné, less than an hour from Lyon, Manon and Vincent invite you to sample their 6 beers from the fixed range, made on site in a cosy atmosphere overlooking the brewhouse."
    ],
    "it": [
      "Situati a Morestel, nei Balcons du Dauphiné, a meno di un'ora da Lione, Manon e Vincent vi invitano a degustare le loro 6 birre della gamma fissa, prodotte in loco in un'atmosfera accogliente con vista sul birrificio."
    ],
    "fr": [
      "Situés à Morestel, aux Balcons du Dauphiné, à moins d'une heure de Lyon, Manon et Vincent vous proposent de déguster leurs 6 bières de la gamme fixe  fabriquées sur place dans une ambiance chaleureuse, avec vue sur la salle de brassage."
    ],
    "es": [
      "Situados en Morestel, en los Balcons du Dauphiné, a menos de una hora de Lyon, Manon y Vincent le invitan a degustar sus 6 cervezas de la gama fija, elaboradas in situ en un ambiente acogedor con vistas a la fábrica de cerveza."
    ],
    "nl": [
      "Gelegen in Morestel, in de Balcons du Dauphiné, op minder dan een uur van Lyon, nodigen Manon en Vincent je uit om hun 6 bieren uit het vaste assortiment te proeven, ter plaatse gemaakt in een gezellige sfeer met uitzicht op de brouwerij."
    ]
  },
  "rdfs:label": {
    "en": [
      "Brasserie des Balcons, la Taproom"
    ],
    "fr": [
      "Brasserie des Balcons, la Taproom"
    ]
  },
