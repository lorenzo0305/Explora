  "rdfs:comment": {
    "de": [
      "Effusiv, explosiv oder Maar. Kommen Sie mit auf die Reise und lassen Sie sich von unzähligen Entdeckungen in unberührter Schönheit und atemberaubenden Panoramen verzaubern."
    ],
    "en": [
      "Effusive, explosive or maar. Come travel and soak up countless discoveries in unspoilt beauty and breathtaking panoramas."
    ],
    "it": [
      "Effusivo, esplosivo o maar. Partite alla scoperta di bellezze incontaminate e panorami mozzafiato."
    ],
    "fr": [
      "Effusif, explosif ou maar. Venez voyager et vous imprégner d'innombrables découvertes dans une beauté préservée et des panoramas à vous couper le souffle."
    ],
    "es": [
      "Efusivo, explosivo o maar. Embárquese en un viaje de descubrimiento a través de una belleza intacta y panoramas sobrecogedores."
    ],
    "nl": [
      "Effusief, explosief of maar. Ga mee op ontdekkingsreis door ongerepte schoonheid en adembenemende panorama's."
    ]
  },
