  "rdfs:comment": {
    "de": [
      "Das La Place verbindet Eleganz und Gastlichkeit in einem raffinierten Rahmen.\nWir erwarten Sie mittags und abends, um jeden Tag ein anderes Menü zu entdecken?\n& alles ist hausgemacht!"
    ],
    "en": [
      "La Place combines elegance and conviviality in a refined setting.\nWe look forward to welcoming you for lunch and dinner to discover a different menu every day!\neverything is home-made!"
    ],
    "it": [
      "La Place unisce eleganza e convivialità in un ambiente raffinato.\nVi aspettiamo a pranzo e a cena per scoprire un menu diverso ogni giorno!\ntutto è fatto in casa!"
    ],
    "fr": [
      "La Place allie élégance et convivialité dans un cadre raffiné.\nNous vous attendons midi et soir pour découvrir chaque jour un menu différent !\n& tout est fait maison !"
    ],
    "nl": [
      "La Place combineert elegantie en gezelligheid in een verfijnde omgeving.\nWe verwelkomen je graag voor lunch en diner om elke dag een ander menu te ontdekken!\nalles is huisgemaakt!"
    ],
    "es": [
      "La Place combina elegancia y convivencia en un ambiente refinado.\nEstaremos encantados de recibirle para comer y cenar y descubrir un menú diferente cada día\n¡Todo es casero!"
    ]
  },
