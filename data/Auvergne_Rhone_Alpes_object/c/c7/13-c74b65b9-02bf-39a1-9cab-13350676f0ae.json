  "rdfs:comment": {
    "de": [
      "Ob Sie nach atypischen Orten für Ihr Firmenseminar suchen oder eine Veranstaltung bei sich zu Hause organisieren, unsere Teams stehen Ihnen für schlüsselfertige Leistungen von 30 bis 1000 Personen zur Verfügung!"
    ],
    "en": [
      "Whether you're looking for atypical venues for your corporate seminar or organizing an event at home, our teams are at your disposal for turnkey services from 30 to 1000 people!"
    ],
    "it": [
      "Che siate alla ricerca di luoghi insoliti per il vostro seminario aziendale o che stiate organizzando un evento a casa vostra, i nostri team sono a disposizione per fornire servizi chiavi in mano per 30-1.000 persone!"
    ],
    "fr": [
      "Que vous cherchiez des lieux atypiques pour votre séminaire d'entreprise ou que vous organisiez un évènement chez vous, nos équipes sont à votre disposition pour des prestations clé en main de 30 à 1000 personnes !"
    ],
    "es": [
      "Tanto si busca lugares insólitos para su seminario de empresa como si desea organizar un evento en su propia casa, nuestros equipos están a su disposición para ofrecerle servicios llave en mano para 30 a 1.000 personas"
    ],
    "nl": [
      "Of je nu op zoek bent naar ongewone locaties voor je bedrijfsseminar of een evenement organiseert in je eigen huis, onze teams staan klaar om kant-en-klare diensten te leveren voor 30 tot 1.000 personen!"
    ]
  },
