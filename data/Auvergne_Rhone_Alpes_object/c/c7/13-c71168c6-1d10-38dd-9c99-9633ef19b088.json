  "rdfs:comment": {
    "de": [
      "Gönnen Sie sich eine Wellness-Pause im Spa des Hotels Le Saint Gervais: Sauna, Jacuzzi, Schwimmbäder und Teestube für einen einzigartigen Moment der Entspannung. Entdecken Sie unser Head Spa und unsere maßgeschneiderten Behandlungen: Massagen, Körper-/Gesichtsbehandlungen und Schönheitsbehandlungen."
    ],
    "en": [
      "Treat yourself to a wellness break at the Spa de l'Hôtel Le Saint Gervais: sauna, jacuzzi, pools and herbal tea room for a unique moment of relaxation. Discover our Head Spa and our made-to-measure treatments: massages, body/face treatments and beauty care."
    ],
    "it": [
      "Concedetevi una pausa benessere nella Spa dell'Hôtel Le Saint Gervais: sauna, jacuzzi, piscine e tisaneria per un momento di relax unico. Scoprite la nostra Head Spa e i nostri trattamenti su misura: massaggi, trattamenti corpo/viso e trattamenti di bellezza."
    ],
    "fr": [
      "Offrez-vous une pause bien-être au Spa de l'Hôtel Le Saint Gervais : sauna, jacuzzi, piscines et tisanerie pour un moment de relaxation unique. Découvrez notre Head Spa et nos soins sur mesure : massages, soins corps / visage, et soins esthétiques."
    ],
    "nl": [
      "Trakteer jezelf op een wellnessvakantie in de Spa van Hôtel Le Saint Gervais: sauna, jacuzzi, zwembaden en theesalon met kruiden voor een uniek moment van ontspanning. Ontdek onze Head Spa en onze behandelingen op maat: massages, lichaams-/gezichtsbehandelingen en schoonheidsbehandelingen."
    ],
    "es": [
      "Regálese una pausa de bienestar en el Spa del Hôtel Le Saint Gervais: sauna, jacuzzi, piscinas y sala de tisanas para un momento de relajación único. Descubra nuestro Head Spa y nuestros tratamientos a medida: masajes, tratamientos corporales y faciales y tratamientos de belleza."
    ]
  },
