  "rdfs:comment": {
    "de": [
      "Der Skatepark von Samoëns befindet sich am Ende der Freizeitanlage Lac au Dames, neben den Fußball- und Rugbystadien. Er ist das ganze Jahr über für Skater, Inlineskater, Roller und BMX-Räder frei zugänglich."
    ],
    "en": [
      "Located at the end of the Lac au Dames leisure park, next to the soccer and rugby stadiums, the Samoëns skatepark is open all year round to skateboarders, rollerbladers, scooters and BMX riders."
    ],
    "it": [
      "Situato alla fine del parco divertimenti Lac au Dames, vicino agli stadi di calcio e rugby, lo skatepark di Samoëns è aperto tutto l'anno a skateboarder, rollerbladers, monopattini e BMX."
    ],
    "fr": [
      "Situé au bout de la base de Loisirs du Lac au Dames, à coté des stades de foot et rugby, le skatepark de Samoëns est en accès libre toute l’année  à skate, rollers, trottinettes et BMX."
    ],
    "es": [
      "Situado al final del parque de ocio Lac au Dames, junto a los estadios de fútbol y rugby, el skatepark de Samoëns está abierto todo el año a patinadores, patinadores, patinetes y ciclistas de BMX."
    ],
    "nl": [
      "Het skatepark van Samoëns ligt aan het einde van het recreatiepark Lac au Dames, naast het voetbal- en rugbystadion en is het hele jaar geopend voor skateboarders, skeeleraars, steppers en BMX-rijders."
    ]
  },
