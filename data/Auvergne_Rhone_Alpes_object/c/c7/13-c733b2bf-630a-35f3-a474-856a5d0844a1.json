  "rdfs:comment": {
    "de": [
      "Ornon liegt unterhalb des gleichnamigen Passes an der natürlichen Grenze zwischen Oisans und Valbonnais in einer angenehmen Lage, die eine große Vielfalt an Landschaften bietet, von Wäldern bis zum Taillefer-Plateau."
    ],
    "en": [
      "Ornon sits just below the mountain pass of the same name (marking the natural boundary between Oisans and the Valbonnais), in a lovely site featuring a wide variety of scenery, from woods to the Taillefer plateau."
    ],
    "it": [
      "Ornon si trova sotto l'omonimo passo, al confine naturale tra le regioni dell'Oisans e del Valbonnais, in un ambiente piacevole che offre una grande varietà di paesaggi, dai boschi all'altopiano di Taillefer."
    ],
    "fr": [
      "Ornon est située sous le col du même nom, à la limite naturelle entre l'Oisans et le Valbonnais, dans un site agréable, offrant une grande variété de paysages, depuis les bois jusqu'au plateau du Taillefer."
    ],
    "es": [
      "Ornon se encuentra bajo el puerto del mismo nombre, en la frontera natural entre las regiones de Oisans y Valbonnais, en un entorno agradable que ofrece una gran variedad de paisajes, desde los bosques hasta la meseta de Taillefer."
    ],
    "nl": [
      "Ornon ligt onder de gelijknamige pas, op de natuurlijke grens tussen de Oisans en de Valbonnais, in een aangename omgeving met een grote verscheidenheid aan landschappen, van de bossen tot het Taillefer plateau."
    ]
  },
