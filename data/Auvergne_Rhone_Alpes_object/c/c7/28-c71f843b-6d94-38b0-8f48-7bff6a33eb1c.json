  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/4244c21d-f289-37aa-b490-2a174e8fd0dc",
      "dc:description": {
        "de": [
          "Charmantes 20m² großes Chalet, das vollständig ausgestattet und liebevoll dekoriert ist.  Sie können sich auf der Südterrasse, die Ihnen einen freien Blick auf den Wald bietet, sonnen und erholen!\nAbwechslung garantiert!"
        ],
        "en": [
          "Charming chalet of 20m², fully equipped and decorated with care.  You will be able to sunbathe and relax on the south-facing terrace which offers you a clear view of the forest!\nA change of scenery guaranteed!"
        ],
        "it": [
          "Grazioso chalet di 20m², completamente attrezzato e decorato con cura.  Potrete prendere il sole e rilassarvi sulla terrazza esposta a sud, che offre una chiara vista sulla foresta!\nUn cambio di scenario garantito!"
        ],
        "fr": [
          "Charmant chalet de 20m², entièrement équipé et décoré avec soin.  Vous pourrez prendre le soleil et vous ressourcer sur la terrasse plein sud qui  vous offre une vue dégagée sur la forêt ! \nDépaysement assuré !"
        ],
        "es": [
          "Encantador chalet de 20m², totalmente equipado y decorado con esmero.  Puede tomar el sol y relajarse en la terraza orientada al sur, que ofrece una vista clara del bosque\n¡Un cambio de escenario garantizado!"
        ],
        "nl": [
          "Charmant chalet van 20m², volledig uitgerust en met zorg ingericht.  U kunt zonnebaden en ontspannen op het terras op het zuiden, dat een vrij uitzicht op het bos biedt!\nEen verandering van omgeving gegarandeerd!"
        ]
      },
      "@type": [
        "Description"
      ],
