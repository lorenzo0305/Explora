  "rdfs:comment": {
    "de": [
      "Haben Sie Lust, der Natur näher zu kommen? Es gibt nichts Besseres als eine Nacht (oder mehrere!) in einem Chalet. Das Chalet Lavande garantiert Ihnen eine umfassende Erholung."
    ],
    "en": [
      "Want to get closer to nature? Nothing beats a night (or several!) in a chalet. Chalet Lavande guarantees you complete rejuvenation."
    ],
    "it": [
      "Volete avvicinarvi alla natura? Niente di meglio di una notte (o più notti!) in uno chalet. Lo Chalet Lavande vi farà fare il pieno di energia."
    ],
    "fr": [
      "Envie de vous rapprocher de la nature ? Rien de mieux qu’une nuit (ou plusieurs !) dans un chalet. Le Chalet Lavande vous garantit un ressourcement complet."
    ],
    "es": [
      "¿Quiere acercarse a la naturaleza? Nada mejor que una noche (¡o varias!) en un chalet. El Chalet Lavande le garantiza recargar las pilas."
    ],
    "nl": [
      "Wil je dichter bij de natuur komen? Er gaat niets boven een nacht (of meerdere!) in een chalet. Chalet Lavande laadt je batterijen gegarandeerd weer op."
    ]
  },
