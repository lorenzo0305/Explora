  "rdfs:comment": {
    "de": [
      "Dieses Gebäude aus dem 19. Jahrhundert, das zu einem charmanten Hotel-Restaurant umgebaut wurde, befindet sich im oberen Teil der Stadt in der Nähe des Schlosses, der Kirche und gegenüber dem Rathaus."
    ],
    "en": [
      "This 19th-century building, renovated into a charming hotel-restaurant, is located in the upper part of the town near the castle, the church and opposite the town hall."
    ],
    "it": [
      "Questo edificio del XIX secolo, ristrutturato in un affascinante hotel-ristorante, si trova nella parte alta della città, vicino al castello, alla chiesa e di fronte al municipio."
    ],
    "fr": [
      "Cette bâtisse du 19e siècle rénovée en hôtel-restaurant de charme, se situe dans la partie haute de la ville à proximité du château, de l'église et face à l'hôtel de ville."
    ],
    "es": [
      "Este edificio del siglo XIX, reformado en un encantador hotel-restaurante, está situado en la parte alta de la ciudad, cerca del castillo, la iglesia y frente al ayuntamiento."
    ],
    "nl": [
      "Dit 19e-eeuwse gebouw, gerenoveerd tot een charmant hotel-restaurant, ligt in het hoger gelegen deel van de stad in de buurt van het kasteel, de kerk en tegenover het stadhuis."
    ]
  },
  "rdfs:label": {
    "en": [
      "Hotel-restaurant du Bourbonnais"
    ],
    "fr": [
      "Hôtel-restaurant du Bourbonnais"
    ]
  },
