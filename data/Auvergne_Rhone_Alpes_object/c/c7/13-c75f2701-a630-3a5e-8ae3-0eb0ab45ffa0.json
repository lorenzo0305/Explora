  "rdfs:comment": {
    "de": [
      "Jenzat ist nicht die einzige Heimat für die Herstellung von Drehleiern. Von Paris bis in die Normandie und Lothringen erzählt Jean-François Chassaing, der Konservator des Museums, die Geschichte der französischen Geigenbauer vom 18."
    ],
    "en": [
      "Jenzat isn't the only place where hurdy-gurdies are made. From Paris to Normandy and Lorraine, museum curator Jean-François Chassaing traces the history of French luthiers from the 18th century to the present day."
    ],
    "it": [
      "Jenzat non è l'unico luogo in cui si producono ghironde. Da Parigi alla Normandia e alla Lorena, il curatore del museo Jean-François Chassaing ripercorre la storia dei liutai francesi dal XVIII secolo a oggi."
    ],
    "fr": [
      "Jenzat n'est pas le seul foyer de fabrication de vielles à roue. De Paris à la Normandie et la Lorraine, Jean-François Chassaing, conservateur du musée, retrace l'histoire des luthiers français du XVIIIe siècle à nos jours."
    ],
    "es": [
      "Jenzat no es el único lugar donde se fabrican zanfonas. De París a Normandía y Lorena, el conservador del museo Jean-François Chassaing recorre la historia de los fabricantes franceses de violines desde el siglo XVIII hasta nuestros días."
    ],
    "nl": [
      "Jenzat is niet de enige plek waar draailieren worden gemaakt. Van Parijs tot Normandië en Lotharingen traceert museumcurator Jean-François Chassaing de geschiedenis van de Franse vioolbouwers van de 18e eeuw tot nu."
    ]
  },
  "rdfs:label": {
