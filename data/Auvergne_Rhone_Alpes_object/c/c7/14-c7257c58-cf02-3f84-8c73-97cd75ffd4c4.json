  "rdfs:comment": {
    "de": [
      "\"Die Odyssee der Generationen\" knüpft eine Verbindung zwischen Vergangenheit und Gegenwart, indem sie die Teilnehmer durch verschiedene kulturelle und technologische Epochen reisen lässt."
    ],
    "en": [
      "the \"Generations Odyssey\" weaves a link between past and present, taking participants on a journey through different cultural and technological eras."
    ],
    "it": [
      "\"L'Odissea delle generazioni intreccia un legame tra passato e presente, portando i partecipanti in un viaggio attraverso diverse epoche culturali e tecnologiche."
    ],
    "fr": [
      "\"L'Odyssée des Générations\" tisse un lien entre le passé et le présent, en faisant voyager les participants à travers différentes époques culturelles et technologiques."
    ],
    "es": [
      "\"La Odisea de las Generaciones teje un vínculo entre el pasado y el presente, llevando a los participantes en un viaje a través de diferentes épocas culturales y tecnológicas."
    ],
    "nl": [
      "\"De Generations Odyssey weeft een link tussen heden en verleden en neemt deelnemers mee op een reis door verschillende culturele en technologische tijdperken."
    ]
  },
