  "rdfs:comment": {
    "de": [
      "Die Bibliothek bietet Ihnen eine große Auswahl an Büchern für Kinder und Erwachsene, die in Verbindung mit Savoie Biblio und dem Kauf von Neuheiten im Laufe des Jahres regelmäßig erneuert werden. Gebühr: 10 ? pro Jahr und Familie."
    ],
    "en": [
      "The library offers a vast choice of books for children and adults, regularly renewed in connection with Savoie Biblio and the purchase of new books throughout the year. Price : 10 € per year and per family."
    ],
    "it": [
      "La biblioteca offre un'ampia gamma di libri per bambini e adulti, rinnovati regolarmente in collaborazione con Savoie Biblio e nuovi acquisti effettuati durante l'anno. Prezzo: 10 euro all'anno per famiglia."
    ],
    "fr": [
      "La bibliothèque vous propose un vaste choix de livres pour enfants et adultes, renouvelés régulièrement en lien avec Savoie Biblio et les achats de nouveautés effectués tout au long de l’année. Tarif : 10 € par an et par famille."
    ],
    "es": [
      "La biblioteca ofrece una amplia gama de libros para niños y adultos, que se renuevan regularmente en colaboración con Savoie Biblio y se realizan nuevas compras a lo largo del año. Precio: 10 € por familia y año."
    ],
    "nl": [
      "De bibliotheek biedt een breed scala aan boeken voor kinderen en volwassenen, regelmatig vernieuwd in samenwerking met Savoie Biblio en nieuwe aankopen gedurende het hele jaar. Prijs: €10 per jaar per gezin."
    ]
  },
