  "rdfs:comment": {
    "de": [
      "Garou veröffentlichte im April 2025 sein erstes Album als Songwriter, Un meilleur lendemain (Ein besserer Morgen). Der Künstler griff zur Feder, weil er etwas zu sagen hatte! Das Ergebnis sind zehn sehr intime Lieder"
    ],
    "en": [
      "Garou released Un meilleur lendemain in April 2025, his very first album as a songwriter. The artist took up his pen because he had things to say! The result: ten very intimate songs."
    ],
    "it": [
      "Garou ha pubblicato Un meilleur lendemain nell'aprile del 2025, il suo primo album come autore. L'artista ha preso in mano la penna perché aveva delle cose da dire! Il risultato: dieci canzoni molto intime"
    ],
    "fr": [
      "Garou a fait paraître Un meilleur lendemain en avril 2025, son tout premier album à titre d’auteur-compositeur. L’artiste a pris la plume parce qu’il avait des choses à dire ! Le résultat : dix chansons très intimes"
    ],
    "es": [
      "Garou publicó Un meilleur lendemain en abril de 2025, su primer álbum como compositor. El artista tomó la pluma porque tenía cosas que decir El resultado: diez canciones muy íntimas"
    ],
    "nl": [
      "Garou bracht Un meilleur lendemain uit in april 2025, zijn allereerste album als songwriter. De artiest nam de pen ter hand omdat hij dingen te zeggen had! Het resultaat: tien zeer intieme liedjes"
    ]
  },
