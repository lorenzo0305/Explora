  "rdfs:comment": {
    "de": [
      "2 komfortable Säle mit 115 und 233 Plätzen, klimatisiert, digitale und 3D-Ausstattung, Art et Essai-Klassifizierung, täglich geöffnet, das ganze Jahr über, nachmittags und abends. Großer Parkplatz in der Nähe. Kulturpass, Regionalpass und Top Start werden akzeptiert!"
    ],
    "en": [
      "2 comfortable, air-conditioned halls with 118 and 233 seats; Digital sound. Classified art-house cinema."
    ],
    "it": [
      "2 sale confortevoli da 115 e 233 posti, climatizzate, con attrezzature digitali e 3D, classificate Art et Essai, aperte tutti i giorni, tutto l'anno, al pomeriggio e alla sera. Ampio parcheggio nelle vicinanze. Si accettano pass culturali, pass regionali e partenze top!"
    ],
    "fr": [
      "2 salles confortables de 115 et 233 places, climatisées, équipement numérique et 3D, classement Art et Essai, ouvert tous les jours, toute l’année, en après-midi et en soirée. Grand parking à proximité. Pass culture, pass région et top départ acceptés !"
    ],
    "es": [
      "2 confortables salas de 115 y 233 localidades, climatizadas, con equipos digitales y 3D, calificadas Art et Essai, abiertas todos los días, todo el año, por la tarde y por la noche. Amplio aparcamiento en las inmediaciones. Se aceptan el Culture pass, el regional pass y el top departure"
    ],
    "nl": [
      "2 comfortabele bioscopen met 115 en 233 stoelen, airconditioning, digitale en 3D-apparatuur, met Art et Essai classificatie, elke dag geopend, het hele jaar door, 's middags en 's avonds. Ruime parkeergelegenheid in de buurt. Cultuurpas, regionale pas en topdepart geaccepteerd!"
    ]
  },
