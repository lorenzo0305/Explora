  "rdfs:comment": {
    "de": [
      "Der Busbahnhof, der an den SNCF-Bahnhof im Stadtzentrum angebaut ist, empfängt die Busse der Region, aber auch des Unternehmens Flixbus sowie einige Linien des öffentlichen Verkehrsnetzes Citéa."
    ],
    "en": [
      "Adjacent to the SNCF train station in the city center, the bus station is used by regional and Flixbus coaches, as well as by some Citéa public transport lines."
    ],
    "it": [
      "Adiacente alla stazione ferroviaria SNCF nel centro della città, la stazione degli autobus è utilizzata dai pullman della Regione, oltre che dalla compagnia Flixbus e da alcune linee della rete di trasporto pubblico Citéa."
    ],
    "fr": [
      "Accolée à la gare SNCF du centre-ville, la gare routière accueille les autocars de la Région, mais aussi de la compagnie Flixbus ainsi que certaines lignes du réseaux de transports en commun Citéa."
    ],
    "nl": [
      "Het busstation ligt naast het SNCF-station in het stadscentrum en wordt gebruikt door regionale bussen, Flixbus en sommige openbaarvervoerslijnen van Citéa."
    ],
    "es": [
      "Adyacente a la estación de ferrocarril de la SNCF en el centro de la ciudad, la estación de autobuses es utilizada por los autocares de la Región, así como por la compañía Flixbus y algunas líneas de la red de transporte público Citéa."
    ]
  },
