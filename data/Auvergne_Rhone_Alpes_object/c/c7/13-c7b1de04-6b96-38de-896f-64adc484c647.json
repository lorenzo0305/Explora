  "rdfs:comment": {
    "de": [
      "Treten Sie ein in die sowohl technische als auch musikalische Welt von Louis Boffard, Musiklehrer, Klavierbauer und leidenschaftlicher Sammler von Tasteninstrumenten aus allen Zeiten.  Zugänglich an einem Freitag und Sonntag pro Monat von 14.00 bis 17.00 Uhr"
    ],
    "en": [
      "Welcome to the technical and musical universe of Louis Boffard, a passionate collector of pianos and organs of all periods. He will present you unique pieces: Franck Liszt's piano, Chopin's piano and the \"Pleyel\" harpsichord."
    ],
    "it": [
      "Entrate nel mondo tecnico e musicale di Louis Boffard, insegnante di musica, costruttore di pianoforti e appassionato collezionista di strumenti a tastiera di tutte le epoche.  Aperto un venerdì e una domenica al mese dalle 14.00 alle 17.00"
    ],
    "fr": [
      "Entrez dans l'univers à la fois technique et musical de Louis Boffard, professeur de musique, facteur de pianos, collectionneur passionné d'instruments à claviers de tout temps.  Accessible un vendredi et dimanche par mois de 14h00 à 17h00"
    ],
    "nl": [
      "Treed binnen in de technische en muzikale wereld van Louis Boffard, muziekleraar, pianomaker en gepassioneerd verzamelaar van toetsinstrumenten uit alle tijden.  Een vrijdag en zondag per maand geopend van 14.00 tot 17.00 uur"
    ],
    "es": [
      "Entre en el universo técnico y musical de Louis Boffard, profesor de música, fabricante de pianos y apasionado coleccionista de instrumentos de teclado de todas las épocas.  Abierto un viernes y un domingo al mes de 14:00 a 17:00"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Musée Toccata"
    ]
  },
