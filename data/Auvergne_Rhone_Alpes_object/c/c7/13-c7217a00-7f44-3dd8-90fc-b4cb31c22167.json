  "rdfs:comment": {
    "de": [
      "Die Gaule Romaine bewirtschaftet 5 km Fluss der 1. Kategorie am Oignin, von Pont Royat an der D979 (Gemeinde Béard-Géovreissiat) bis zum Werk Trablettes (Gemeinde Izernore). Hier treffen die Angler auf Äschen und Forellen."
    ],
    "en": [
      "The Oignin River, from Pont Royat (Béard Géovreissiat) to the Trablettes electric factory, is an abounding in fish 1st category river."
    ],
    "it": [
      "La Gaule Romaine gestisce 5 km di fiume di 1a categoria sull'Oignin, da Pont Royat sulla D979 (comune di Béard-Géovreissiat) allo stabilimento di Trablettes (comune di Izernore). I pescatori potranno incontrare temoli e trote."
    ],
    "fr": [
      "La Gaule Romaine gère 5 km de rivière de 1ère catégorie sur l'Oignin, depuis Pont Royat sur la D979 (commune de Béard-Géovreissiat) jusqu'à l'usine des Trablettes (commune d'Izernore). Les pêcheurs y rencontreront ombres et truites."
    ],
    "es": [
      "La Gaule Romaine gestiona 5 km de río de 1ª categoría en el Oignin, desde Pont Royat en la D979 (municipio de Béard-Géovreissiat) hasta la fábrica de Trablettes (municipio de Izernore). Los pescadores encontrarán tímalos y truchas."
    ],
    "nl": [
      "De Gaule Romaine beheert 5 km rivier van 1ste categorie op de Oignin, van Pont Royat op de D979 (gemeente Béard-Géovreissiat) tot de fabriek van Trablettes (gemeente Izernore). Vissers zullen vlagzalm en forel tegenkomen."
    ]
  },
  "rdfs:label": {
    "en": [
      "Fishing in the Oignin River"
    ],
    "fr": [
      "Pêcher autour d'Izernore"
    ]
  },
