  "rdfs:comment": {
    "de": [
      "1998 ernannt zum Weltkulturerbe der UNESCO im Rahmen des Jakobsweges"
    ],
    "en": [
      "Cathedral Notre-Dame du Puy, listed as a UNESCO World Heritage site since 1998 Viewers on the France 2 channel voted the cathedral their second favourite French monument in 2015."
    ],
    "it": [
      "La Cattedrale di Le Puy-en-Velay, iscritta al Patrimonio dell'Umanità dell'UNESCO dal 1998, è stata votata come secondo monumento francese da Stéphane Bern in un programma presentato su France 2 nel 2015."
    ],
    "fr": [
      "La Cathédrale du Puy-en-Velay, Inscrite au patrimoine mondial de l’UNESCO depuis 1998 se classe 2ème monument préféré des Français dans l’émission présentée sur France 2 par Stéphane Bern en 2015."
    ],
    "es": [
      "La catedral de Le Puy-en-Velay, inscrita en la lista del Patrimonio Mundial de la UNESCO desde 1998, fue elegida el segundo monumento favorito de Francia por Stéphane Bern en un programa presentado en France 2 en 2015."
    ],
    "nl": [
      "De kathedraal van Le Puy-en-Velay, die sinds 1998 op de Werelderfgoedlijst van UNESCO staat, werd in 2015 door Stéphane Bern in een programma op France 2 uitgeroepen tot het op één na favoriete monument van Frankrijk."
    ]
  },
  "rdfs:label": {
