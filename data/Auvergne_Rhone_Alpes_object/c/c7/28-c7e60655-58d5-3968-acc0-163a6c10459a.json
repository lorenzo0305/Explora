  "rdfs:comment": {
    "de": [
      "Im Zentrum von Denain gelegen, heißen Sie Eric und Paula in ihrem Lokal herzlich willkommen. Sobald Sie durch die Tür treten, werden Sie von der Einrichtung in sanften Farben und der herzlichen Atmosphäre begeistert sein."
    ],
    "en": [
      "Located in the center of Denain, Eric and Paula welcome you to their establishment. Once you enter, you will be seduced by the softly colored decor and the warm atmosphere."
    ],
    "it": [
      "Situato nel centro di Denain, Eric e Paula vi danno il benvenuto nel loro locale. Una volta varcata la porta, sarete sedotti dall'arredamento dai colori tenui e dalla calda atmosfera."
    ],
    "fr": [
      "Situé en plein centre de Denain, Eric et Paula vous accueillent dans leur établissement. Une fois franchi la pas de la porte, vous serez séduit par le décor aux couleurs douces et par l'ambiance chaleureuse."
    ],
    "es": [
      "Situados en el centro de Denain, Eric y Paula le dan la bienvenida a su establecimiento. Nada más cruzar la puerta, le seducirán la decoración de colores suaves y el ambiente cálido."
    ],
    "nl": [
      "In het centrum van Denain heten Eric en Paula u welkom in hun zaak. Zodra u door de deur stapt, wordt u verleid door het zachtgekleurde decor en de warme sfeer."
    ]
  },
