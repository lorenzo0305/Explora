  "rdfs:comment": {
    "de": [
      "Die Rondine ? Fotografische Reiseausstellung\r\n\r\nEntdecken Sie die Welt durch das Objektiv von Giorgia Tirocchi.\r\nVon majestätischen Bergen bis hin zu einsamen Stränden fängt jede Fotografie einen einzigartigen Moment des Reisens und Entdeckens ein."
    ],
    "en": [
      "Explore the world through the lens of Giorgia Tirocchi.\r\nFrom majestic mountains to remote beaches, each photograph captures a unique moment of travel and discovery."
    ],
    "it": [
      "La Rondine? Mostra di fotografia di viaggio\r\n\r\nScoprite il mondo attraverso l'obiettivo di Giorgia Tirocchi.\r\nDa montagne maestose a spiagge remote, ogni fotografia cattura un momento unico di viaggio e di scoperta."
    ],
    "fr": [
      "La Rondine – Exposition photographique de voyage\r\n\r\nDécouvrez le monde à travers l’objectif de Giorgia Tirocchi.\r\nDes montagnes majestueuses aux plages isolées, chaque photographie capture un instant unique de voyage et de découverte."
    ],
    "nl": [
      "La Rondine ? Tentoonstelling reisfotografie\r\n\r\nOntdek de wereld door de lens van Giorgia Tirocchi.\r\nVan majestueuze bergen tot afgelegen stranden, elke foto legt een uniek moment van reizen en ontdekken vast."
    ],
    "es": [
      "La Rondine ? Exposición de fotografía de viajes\r\n\r\nDescubra el mundo a través del objetivo de Giorgia Tirocchi.\r\nDesde majestuosas montañas hasta playas remotas, cada fotografía captura un momento único de viaje y descubrimiento."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Exposition Photo - La Rondine"
    ]
  },
