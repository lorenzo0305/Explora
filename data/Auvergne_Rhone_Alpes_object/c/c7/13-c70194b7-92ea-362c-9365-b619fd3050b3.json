  "rdfs:comment": {
    "de": [
      "Chalet Buvette neben dem wunderschönen, 20 m hohen Wasserfall. Blick auf die Bergkette der Aiguilles Rouges, den Bossons-Gletscher und den Mont-Blanc."
    ],
    "en": [
      "Chalet buvette next to the superb 20 meter high waterfall. View on the Aiguilles Rouges chain, the Bossons glacier and the Mont-Blanc."
    ],
    "it": [
      "Chalet buvette vicino alla superba cascata alta 20 metri. Vista sulla catena delle Aiguilles Rouges, sul ghiacciaio dei Bossons e sul Monte Bianco."
    ],
    "fr": [
      "Chalet buvette à côté de la superbe cascade de 20 mètres de hauteur. Vue sur la chaîne des Aiguilles Rouges, le glacier des Bossons et du Mont-Blanc."
    ],
    "nl": [
      "Chalet buvette naast de prachtige 20 meter hoge waterval. Uitzicht op de keten van de Aiguilles Rouges, de Bossons-gletsjer en de Mont Blanc."
    ],
    "es": [
      "Chalet buvette junto a la magnífica cascada de 20 metros de altura. Vista de la cadena de las Agujas Rojas, el glaciar de Bossons y el Mont Blanc."
    ]
