  "rdfs:comment": {
    "de": [
      "Erleben Sie das Abenteuer des Wanderns mit einem Esel. Er wird Ihr Gepäck tragen und in Ihrem Tempo wandern. Mit einem Esel zu wandern bedeutet, mit leichtem Gepäck zu wandern. Ideales Tier, um mit der Familie durch die Berge zu wandern!"
    ],
    "en": [
      "Enjpy the adventure of hiking with a donkey. It will carry your bags and walk at your pace. An ideal way to discover the mountains with your family."
    ],
    "it": [
      "L’asino porterà gli zaini e camminerà al tuo ritmo. Animale ideale per attraversare la montagna in famiglia!"
    ],
    "fr": [
      "Vivez l'aventure de la randonnée avec un âne. Il portera vos sacs et marchera à votre rythme. Randonner avec un âne signifie randonner léger. Animal idéal pour parcourir la montagne en famille !"
    ],
    "es": [
      "Vive la aventura de hacer senderismo con un burro. Llevará tu equipaje y caminará a tu ritmo. Ir de excursión con un burro significa ir ligero. El animal ideal para explorar las montañas en familia"
    ],
    "nl": [
      "Ervaar het avontuur van wandelen met een ezel. Hij draagt je tassen en loopt op jouw tempo. Wandelen met een ezel betekent licht wandelen. Het ideale dier om samen met je gezin de bergen te verkennen!"
    ]
  },
  "rdfs:label": {
    "de": [
      "Anes et Mômes : votre randonnée avec un âne"
    ],
    "ru": [
      "Anes et Mômes : votre randonnée avec un âne"
    ],
    "en": [
      "Donkeys and Children: hiking with a donkey"
    ],
    "it": [
      "Asini e bambini: la tua escursione con un asino"
    ],
