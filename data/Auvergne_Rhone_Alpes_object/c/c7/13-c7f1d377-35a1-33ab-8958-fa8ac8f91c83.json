  "rdfs:comment": {
    "de": [
      "Im Herzen der Naturregion Veinazès und im weiteren Sinne der Châtaigneraie Cantalienne liegt Sansac-Veinazès. Das Dorf ist von einer für die Umgebung typischen Hügellandschaft umgeben und wird von einem Pfad durchzogen, der herrliche Ausblicke bietet."
    ],
    "en": [
      "Sansac-Veinazès lies at the heart of the Veinazès natural region and, more broadly, the Châtaigneraie Cantalienne. The village is surrounded by the rolling countryside which is typical of the area and criss-crossed by a footpath offering superb views."
    ],
    "it": [
      "Sansac-Veinazès si trova nel cuore della regione naturale di Veinazès e, più in generale, della Châtaigneraie cantaliana. Il villaggio è circondato dalla campagna ondulata tipica della zona e attraversato da un sentiero che offre viste superbe."
    ],
    "fr": [
      "Au cœur de la région naturelle du Veinazès et plus largement de la Châtaigneraie Cantalienne, se trouve Sansac-Veinazès. Le village se trouve entouré d’un paysage vallonné typique des environs et sillonné par un sentier qui offre de superbes vues."
    ],
    "es": [
      "Sansac-Veinazès se encuentra en el corazón de la región natural de Veinazès y, más ampliamente, de la Châtaigneraie cantalienne. El pueblo está rodeado por el paisaje ondulado típico de la zona y atravesado por un sendero que ofrece magníficas vistas."
    ],
    "nl": [
      "Sansac-Veinazès ligt in het hart van het natuurgebied Veinazès en meer in het algemeen van de Châtaigneraie Cantalienne. Het dorp wordt omringd door het glooiende landschap dat typisch is voor deze streek en wordt doorkruist door een wandelpad dat prachtige uitzichten biedt."
    ]
  },
