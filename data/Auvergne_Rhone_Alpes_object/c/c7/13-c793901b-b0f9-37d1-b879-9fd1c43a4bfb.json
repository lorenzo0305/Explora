  "rdfs:comment": {
    "de": [
      "Touristisches Informationsbüro, das sich am oberen Rand des Dorfes Saint Sorlin d'Arves befindet.\r\nVor Ort gibt es einen gemütlichen Empfangsbereich, in dem die Besucher Broschüren und Informationstafeln finden."
    ],
    "en": [
      "Tourist Information Office located at the top of the Saint Sorlin d'Arves village.\r\nOn site, a welcoming reception area where visitors can find brochures, information boards and events."
    ],
    "it": [
      "Ufficio informazioni turistiche situato nella parte alta del villaggio di Saint Sorlin d'Arves.\r\nI visitatori troveranno un'accogliente reception con opuscoli e pannelli informativi."
    ],
    "fr": [
      "Bureau d'Information Touristique situé au sommet du village de Saint Sorlin d'Arves.\r\nSur place, un espace d'accueil chaleureux où les visiteurs trouveront des brochures et des panneaux d'information."
    ],
    "nl": [
      "VVV bovenin het dorp Saint Sorlin d'Arves.\r\nTer plaatse is er een knusse ontvangstruimte met brochures, informatie en evenementen."
    ],
    "es": [
      "Oficina de Turismo situada en lo alto del pueblo de Saint Sorlin d'Arves.\r\nLos visitantes encontrarán una recepción acogedora con folletos y paneles informativos."
    ]
  },
