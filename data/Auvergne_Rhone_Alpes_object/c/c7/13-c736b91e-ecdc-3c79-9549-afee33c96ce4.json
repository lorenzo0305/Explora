  "rdfs:comment": {
    "de": [
      "Probieren Sie bretonische Spezialitäten: Galettes aus Buchweizen, Crêpes und Cidre. Die Bergkulisse wird Sie in Stimmung bringen. Es ist sogar möglich, in einer alten Gondelbahn des Skiortes Les 2 Alpes zu essen!"
    ],
    "en": [
      "Come and taste Breton specialties: buckwheat pancakes, pancakes and cider. The mountain decor will put you in the mood, it is even possible to eat in an old cable car of the resort of Les 2 Alpes!"
    ],
    "it": [
      "Venite a gustare le specialità bretoni: frittelle di grano saraceno, crêpes e sidro. L'arredamento di montagna vi metterà di buon umore, è persino possibile mangiare in una vecchia funivia del resort 2 Alpes!"
    ],
    "fr": [
      "Venez déguster des spécialités bretonnes : galettes au sarrasin, crêpes et cidre. Le décor montagnard vous mettra dans l'ambiance, il est même possible de manger dans une ancienne télécabine de la station des 2 Alpes !"
    ],
    "es": [
      "Venga a degustar las especialidades bretonas: tortitas de trigo sarraceno, crêpes y sidra. El entorno montañoso le pondrá de buen humor, ¡e incluso podrá comer en un antiguo teleférico de la estación de 2 Alpes!"
    ],
    "nl": [
      "Kom Bretonse specialiteiten proeven: boekweitpannenkoeken, crêpes en cider. Het bergdecor zal u in de stemming brengen, het is zelfs mogelijk om te eten in een oude kabelbaan van het 2 Alpes resort!"
    ]
  },
  "rdfs:label": {
    "en": [
      "La crêperie de gordes"
    ],
    "fr": [
      "La crêperie de Gordes"
    ]
  },
