  "rdfs:comment": {
    "de": [
      "Dieser Weg, der in Parrot beginnt, bietet herrliche Ausblicke auf das Massif Cantalien und den Sancy. Sie bietet außerdem die Möglichkeit, die unendliche Weite des Cézallier zu entdecken."
    ],
    "en": [
      "Leaving from Parrot, this route offers magnificent views of the Cantalien Massif and the Sancy. It also allows you to discover the vastness of the Cézallier."
    ],
    "it": [
      "Questo percorso da Parrot offre magnifiche viste sul Massiccio del Cantalien e sul Sancy. È anche un ottimo modo per scoprire la vastità del Cézallier."
    ],
    "fr": [
      "Ce parcours au départ de Parrot offre de magnifiques points de vue sur le Massif Cantalien et du Sancy. Il permet également de découvrir l'immensité du Cézallier."
    ],
    "es": [
      "Esta ruta desde Parrot ofrece magníficas vistas del macizo del Cantalien y del Sancy. También es una buena manera de descubrir la inmensidad del Cézallier."
    ],
    "nl": [
      "Deze route vanuit Parrot biedt prachtige uitzichten op het massief van de Cantalien en de Sancy. Het is ook een geweldige manier om de uitgestrektheid van de Cézallier te ontdekken."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Circuit VTT n°27 - Les gentianes"
    ]
  },
