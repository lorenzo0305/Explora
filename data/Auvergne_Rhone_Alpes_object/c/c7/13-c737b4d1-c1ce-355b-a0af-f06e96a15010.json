  "rdfs:comment": {
    "de": [
      "Mr Probus begleitet Sie bei geführten Touren, um die Weinbau-Exzellenz der renommierten Weinberge von Côte-Rôtie, Condrieu, Saint-Joseph und Vienne Seyssuel zu erkunden."
    ],
    "ru": [
      "Мистер Пробус сопровождает вас на экскурсию для изучения винодельческого мастерства знаменитых виноградников Кот-Роти, Кондрие, Сент-Жозеф и Витис Виенна во время своих экскурсий."
    ],
    "en": [
      "Mr. Probus accompanies you to explore the viticultural excellence of the renowned vineyards of Côte-Rôtie, Condrieu, Saint-Joseph, and Vienne Seyssuel during his guided tours."
    ],
    "it": [
      "Mr Probus vi accompagna a esplorare l'eccellenza viticola dei rinomati vigneti di Côte-Rôtie, Condrieu, Saint-Joseph e Vienne Seyssuel durante le sue visite guidate."
    ],
    "fr": [
      "Mr Probus Ampuis, vous accompagne pour explorer l'excellence viticole des vignobles renommés de Saint-Joseph, Condrieu, Côte-Rôtie et Vienne Seyssuel lors de ses visites guidées."
    ],
    "zh": [
      "普罗布斯先生在他的导览活动中陪同您探索科特罗蒂、孔德里厄、圣约瑟夫和维蒂斯维也纳等知名葡萄园的葡萄种植卓越。"
    ],
    "es": [
      "Mr Probus lo acompaña para explorar la excelencia vitivinícola de los renombrados viñedos de Côte-Rôtie, Condrieu, Saint-Joseph y Vienne Seyssuel durante sus visitas guiadas."
    ],
    "nl": [
      "Meneer Probus begeleidt u om de wijnbouwexcellentie van de gerenommeerde wijngaarden van Côte-Rôtie, Condrieu, Saint-Joseph en Vienne Seyssuel te verkennen tijdens zijn rondleidingen."
    ]
  },
