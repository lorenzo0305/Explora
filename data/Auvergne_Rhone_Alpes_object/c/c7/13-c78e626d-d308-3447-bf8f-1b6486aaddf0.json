  "rdfs:comment": {
    "de": [
      "Chalet Restaurant und Bar in der Höhe im Herzen der Natur.\r\nLokale und hausgemachte Küche, Bar, lebendige Weine, warme Atmosphäre und gesellige Musik.\r\nReservierung dringend empfohlen."
    ],
    "en": [
      "Chalet restaurant and mountain bar in the heart of nature.\r\nLocal and homemade cuisine, bar, warm atmosphere and friendly music."
    ],
    "it": [
      "Ristorante e bar di chalet d'alta quota nel cuore della natura.\r\nCucina locale fatta in casa, bar, vini vivaci, atmosfera calda e musica amichevole.\r\nSi consiglia vivamente la prenotazione."
    ],
    "fr": [
      "Chalet restaurant et bar d'altitude au cœur de la nature.\r\nCuisine locale et faite maison, bar, vins vivants, ambiance chaleureuse et musique conviviale.\r\nRéservation fortement recommandée."
    ],
    "nl": [
      "Hooggelegen chaletrestaurant en bar midden in de natuur.\r\nHuisgemaakte lokale gerechten, bar, levendige wijnen, warme sfeer en vriendelijke muziek.\r\nReserveren sterk aanbevolen."
    ],
    "es": [
      "Chalet restaurante y bar de gran altitud en plena naturaleza.\r\nCocina local casera, bar, vinos animados, ambiente cálido y música agradable.\r\nSe recomienda encarecidamente reservar."
    ]
  },
