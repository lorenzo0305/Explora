  "rdfs:comment": {
    "de": [
      "Lassen Sie uns gemeinsam Lieder und Stimmspiele teilen, Bewegungen von den Fußspitzen bis zu den Fingerspitzen, Instrumente für alle Hände, ... Alle Sinne werden geweckt, um Geschmack an der Musik zu finden!"
    ],
    "en": [
      "Let's share songs and voice games, movements from toe to fingertips, instruments for all hands... All the senses awakened to get a taste for music!"
    ],
    "it": [
      "Cantiamo e suoniamo con le nostre voci, muoviamoci dalla punta dei piedi alla punta delle dita, suoniamo strumenti per tutte le mani... Tutti i sensi saranno risvegliati per assaporare il gusto della musica!"
    ],
    "fr": [
      "Partageons ensemble chants et jeux de voix, mouvements du bout des pieds aux bout des doigts, des instruments pour toutes les mains,...Tous les sens en éveil pour prendre goût à la musique !"
    ],
    "nl": [
      "Laten we zingen en spelen met onze stemmen, bewegen van onze tenen tot onze vingertoppen, instrumenten bespelen voor alle handen... Alle zintuigen worden geprikkeld om de smaak van muziek te pakken te krijgen!"
    ],
    "es": [
      "Cantemos y toquemos con nuestras voces, movámonos desde los dedos de los pies hasta las puntas de los dedos de las manos, toquemos instrumentos para todas las manos... ¡Se despertarán todos los sentidos para cogerle el gusto a la música!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Printemps des p'tites pousses - Atelier : Eveil musical"
    ]
  },
