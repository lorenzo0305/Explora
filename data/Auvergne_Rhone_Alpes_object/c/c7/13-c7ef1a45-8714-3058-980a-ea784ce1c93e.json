  "rdfs:comment": {
    "de": [
      "Weinkeller, Gourmet-Bar und traditionelle Mittagsgerichte (nur unter der Woche). Am Freitagmittag können Sie das Pelaud-Menü probieren: Lyoner Salat, Wurst/Knödel, 1/2 Saint-Marcellin, Dessert nach Wahl.\r\nVerpflegung vor Ort oder zum Mitnehmen."
    ],
    "en": [
      "Wine cellar, gourmet bar and traditional lunchtime catering (weekdays only). Friday lunchtime, enjoy the Pelaud menu: Lyonnaise salad, sausage/quenelle, 1/2 saint-Marcellin, choice of dessert.\r\nCatering on site or to take away."
    ],
    "it": [
      "Cantina, bar gourmet e ristorante tradizionale a pranzo (solo nei giorni feriali). Il venerdì a pranzo, venite a provare il menu Pelaud: insalata lionese, salsiccia/quenelle, 1/2 saint-Marcellin, dessert a scelta.\r\nRistorazione in loco o da asporto."
    ],
    "fr": [
      "Cave à vin, bar gourmand et restauration traditionnelle le midi (en semaine uniquement). Le vendredi midi, venez déguster le menu Pelaud : salade lyonnaise, saucisson/quenelle, 1/2 saint-Marcellin, dessert au choix. \r\nRestauration sur place ou à emporter."
    ],
    "nl": [
      "Wijnkelder, gastronomische bar en traditioneel restaurant voor de lunch (alleen doordeweeks). Kom op vrijdagmiddag het Pelaud-menu proberen: salade Lyonnaise, worst/quenelle, 1/2 saint-Marcellin, dessert naar keuze.\r\nCatering ter plaatse of om mee te nemen."
    ],
    "es": [
      "Bodega, bar gastronómico y restaurante tradicional para el almuerzo (sólo entre semana). Los viernes al mediodía, pruebe el menú Pelaud: ensalada lionesa, embutido/quenelle, 1/2 saint-Marcellin, postre a elegir.\r\nRestauración in situ o para llevar."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant - Cave La Belle Epoque"
    ]
  },
