  "rdfs:comment": {
    "de": [
      "Ein idealer Spielplatz, um sich auf Buckeln und Steilkurven auszuprobieren. Hier können Sie Ihre Fahrradfähigkeiten verbessern und gleichzeitig Spaß haben."
    ],
    "en": [
      "An ideal playground for experimenting with bumps, banked turns and other modules. It's an opportunity to improve cycling skills while having fun."
    ],
    "it": [
      "Un terreno di gioco ideale per sperimentare dossi e curve strette. È un'opportunità per migliorare le proprie capacità ciclistiche divertendosi."
    ],
    "fr": [
      "Un terrain de jeu idéal pour s'expérimenter sur des bosses, des virages relevés. C'est l'occasion d'améliorer ses compétences en vélo tout en s'amusant."
    ],
    "es": [
      "Un terreno de juego ideal para experimentar con baches y curvas cerradas. Es una oportunidad para mejorar tus habilidades ciclistas mientras te diviertes."
    ],
    "nl": [
      "Een ideale speeltuin om te experimenteren met hobbels en scherpe bochten. Het is een kans om je fietsvaardigheden te verbeteren terwijl je plezier hebt."
    ]
  },
