  "rdfs:comment": {
    "de": [
      "Das Restaurant Chalet de la Masse bietet reichhaltige und schmackhafte Gerichte. Den Nachmittag können Sie bei einer Waffel oder Crêpe auf einem der Liegestühle auf der Terrasse verbringen."
    ],
    "en": [
      "Bar/restaurant situated on the pistes coming down from La Masse.\r\nSunny south facing terrace with panoramic views of Les Menuires and Val Thorens.\r\n\r\nThe bar is open all day and the restaurant opens at 11.30am."
    ],
    "it": [
      "Bar/ristorante situato sulle piste di Mass.\r\nTerrazza soleggiata esposta a sud con vista panoramica sulla bassa valle, Les Menuires e Val Thorens."
    ],
    "fr": [
      "Bar / restaurant situé sur les pistes versant de la masse.\r\nTerrasse ensoleillée plein sud avec vue panoramique sur le bas de la vallée, les Menuires et Val Thorens."
    ],
    "nl": [
      "Le Chalet de la Masse restaurant biedt u goed gevulde en smaakvolle lunchschotels. Las 's middags een pauze in op het terras op de ligstoelen onder het genot van een wafel of een pannenkoek."
    ],
    "es": [
      "Bar-restaurante situado en las pistas de Mass.\r\nTerraza soleada orientada al sur con vistas panorámicas sobre el valle inferior, Les Menuires y Val Thorens."
    ]
  },
