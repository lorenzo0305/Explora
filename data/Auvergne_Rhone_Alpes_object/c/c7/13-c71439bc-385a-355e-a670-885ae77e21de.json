  "rdfs:comment": {
    "de": [
      "Teestube, hausgemachte Backwaren, Geschenkideen, handwerklich hergestelltes Eis, große Auswahl an Bio- und Fairtrade-Tees.\r\nIm Sommer werden kleine Menüs angeboten: Spezialität ist die \"Tourte Médiévale\" (Brunch auf Reservierung)."
    ],
    "en": [
      "Tea room - Homemade pastries - Sweets - artisanal ice creams."
    ],
    "it": [
      "Sala da tè, dolci fatti in casa, idee regalo, gelati artigianali, ampia scelta di tè biologici ed equosolidali.\r\nPiccoli menu estivi: specialità \"Tourte Médiévale\" (brunch su prenotazione)."
    ],
    "fr": [
      "Salon de thé, pâtisseries maison, idées cadeaux, glaces artisanales, grande diversité de thés bio et commerce équitable.\r\nPetits menus proposés l'été : spécialité la \"Tourte Médiévale\" (brunch sur réservation)."
    ],
    "nl": [
      "Theesalon - Zelfgemaakt gebak - Zoetwaren - Ambachtelijk ijs."
    ],
    "es": [
      "Tearoom, pastelería casera, ideas para regalos, helados artesanos, amplia gama de tés ecológicos y de comercio justo.\r\nPequeños menús de verano: especialidad \"Tourte Médiévale\" (brunch con reserva previa)."
    ]
  },
