  "rdfs:comment": {
    "de": [
      "Die Salle des Orgues verfügt über eine Fläche von 1.900 m², darunter ein großer Saal von 1663 m², ein Clubhaus von 150 m² mit einer Eingangsschleuse, Sanitäranlagen, ein Heizraum und Außensanitäranlagen. Ein Parkplatz mit 200 Plätzen steht am Eingang des Geländes zur Verfügung."
    ],
    "en": [
      "The Salle des Orgues has a surface area of 1,900 m², including a large 1,663 m2 hall, a 150 m2 club house with an airlock, sanitary facilities, a boiler room and outdoor sanitary facilities. A 200-space parking lot is available at the entrance to the site."
    ],
    "it": [
      "La Salle des Orgues ha una superficie di 1.900 m², tra cui una grande sala di 1.663 m2, una club house di 150 m2 con una serratura d'ingresso, servizi igienici, un locale caldaia e servizi igienici all'aperto. All'ingresso del sito si trova un parcheggio da 200 posti auto."
    ],
    "fr": [
      "La salle des Orgues dispose de 1.900 m² de surface dont une grande salle de 1663 m2, un club house de 150 m2 avec un sas d'entrée, des sanitaires, une chaufferie, des sanitaires extérieurs. Un parking de 200 places est à disposition à l’entrée du site."
    ],
    "es": [
      "La Salle des Orgues tiene una superficie de 1.900 m², que incluye un gran vestíbulo de 1.663 m2, una casa club de 150 m2 con esclusa de entrada, instalaciones sanitarias, sala de calderas e instalaciones sanitarias exteriores. A la entrada del recinto hay un aparcamiento de 200 plazas."
    ],
    "nl": [
      "De Salle des Orgues heeft een oppervlakte van 1.900 m², inclusief een grote hal van 1.663 m2, een clubhuis van 150 m2 met een toegangssluis, sanitaire voorzieningen, een stookruimte en sanitaire voorzieningen buiten. Er is een parkeerplaats met 200 plaatsen bij de ingang van het terrein."
    ]
  },
