  "rdfs:comment": {
    "de": [
      "Es erwartet Sie ein außergewöhnlicher Reittag mit einem Fahrwettbewerb, einer Dressurprüfung und einem Wanderritt. Bewundern Sie die Eleganz und das Können der Reiter!"
    ],
    "en": [
      "An exceptional equestrian day awaits you, with driving competitions, dressage tests and trail rides. Come and admire the elegance and mastery of our riders!"
    ],
    "it": [
      "Vi aspetta una giornata equestre eccezionale, con una gara di guida, una prova di dressage e un trail ride. Venite ad ammirare l'eleganza e l'abilità dei cavalieri!"
    ],
    "fr": [
      "Une journée équestre exceptionnelle vous attend avec concours d'attelage, épreuve de dressage et randonnée. Venez admirer l'élégance et la maîtrise des cavaliers !"
    ],
    "es": [
      "Le espera una jornada ecuestre excepcional, con un concurso de enganches, una prueba de doma y un paseo a caballo. ¡Venga a admirar la elegancia y la destreza de los jinetes!"
    ],
    "nl": [
      "Er staat je een uitzonderlijke ruiterdag te wachten, met een menwedstrijd, dressuurproef en trailrit. Kom en bewonder de elegantie en vaardigheid van de ruiters!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Caval'Attelage - Concours d'attelage de chevaux"
    ]
  },
