  "rdfs:comment": {
    "de": [
      "Der 2014 angelegte Garten des Musée de l'Ancien Évêché erstreckt sich über ein Grundstück, das in einer \"L\"-Form um den ehemaligen Bischofspalast, der heute ein Museum ist, und das Kopfende der Kathedrale Notre-Dame angeordnet ist."
    ],
    "en": [
      "The garden of the Musée de l'Ancien Évêché, laid out in 2014, is laid out on a plot of land arranged in an \"L\" shape around the former episcopal palace, now a museum, and the chevet of Notre-Dame Cathedral."
    ],
    "it": [
      "Il giardino del Musée de l'Ancien Évêché, creato nel 2014, si sviluppa su un terreno disposto a \"L\" intorno all'ex palazzo episcopale, oggi museo, e al chevet della Cattedrale di Notre-Dame."
    ],
    "fr": [
      "Le jardin du Musée de l’Ancien Évêché, aménagé en 2014, se déploie sur une parcelle de terrain disposé en \"L\" autour de l’ancien palais épiscopal devenu musée et le chevet de la cathédrale Notre-Dame."
    ],
    "es": [
      "El jardín del Museo del Antiguo Évêché, creado en 2014, se extiende sobre un terreno dispuesto en forma de \"L\" alrededor del antiguo palacio episcopal, hoy convertido en museo, y de la cabecera de la catedral de Notre-Dame."
    ],
    "nl": [
      "De tuin van het Musée de l'Ancien Évêché, aangelegd in 2014, is verspreid over een terrein dat in een \"L\"-vorm rond het voormalige bisschoppelijk paleis, nu een museum, en de chevet van de kathedraal Notre-Dame is aangelegd."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Jardin du Musée de l'Ancien Evêché"
    ]
