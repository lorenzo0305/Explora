  "rdfs:comment": {
    "de": [
      "Die Kirche von Saint-André-le-Puy stammt aus dem 16. Jahrhundert. Jahrhundert. Zu entdecken gibt es: Glasfenster des Baldomer Glasermeisters Mauvernay, ein wunderschönes hölzernes Altarbild, das Taufbecken aus bemaltem und vergoldetem Holz und eine Grablitra..."
    ],
    "en": [
      "Saint-André-le-Puy Church dates from the 16th century. Its architecture is a mixture of Romanesque and Gothic styles."
    ],
    "it": [
      "La chiesa di Saint-André-le-Puy risale al XVI secolo. Da scoprire: vetrate realizzate dal maestro vetraio Mauvernay, una magnifica pala d'altare in legno, il fonte battesimale in legno dipinto e dorato e un litro funerario..."
    ],
    "fr": [
      "L’église de Saint-André-le-Puy date du XVIème siècle. A découvrir : vitraux réalisés par le maître-verrier baldomérien Mauvernay, un magnifique retable en bois, les fonts baptismaux, en bois peint et doré et une litre funéraire..."
    ],
    "es": [
      "La iglesia de Saint-André-le-Puy data del siglo XVI. A descubrir: vidrieras realizadas por el maestro vidriero Mauvernay, un magnífico retablo de madera, la pila bautismal, de madera pintada y dorada y una litera funeraria..."
    ],
    "nl": [
      "De kerk van Saint-André-le-Puy dateert uit de 16e eeuw. Te ontdekken: gebrandschilderde ramen van de meester-glasblazer Mauvernay, een prachtig houten altaarstuk, de doopvont, in beschilderd en verguld hout en een..."
    ]
  },
