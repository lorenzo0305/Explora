  "rdfs:comment": {
    "de": [
      "Spezialist für Rinderkotelett. Alle Fleischsorten und\r\nalle Fische werden ausschließlich am offenen Kamin gegart. In der Saison nur abends geöffnet (außer montags). Kinderwagen und Maxi-Cosy nicht geeignet."
    ],
    "en": [
      "Prime beef rib specialist. All meat and fish is cooked on the fireplace. Not suitable for pushchairs and strollers. Open every evening during the season with late sitting. Strollers and maxi-cozy not adapted."
    ],
    "it": [
      "Specializzato in costate di manzo. Tutte le carni e i pesci\r\ntutte le carni e i pesci vengono cucinati solo nel camino. Aperto solo la sera durante la stagione (tranne il lunedì). Passeggini e maxi-cosy non sono adatti."
    ],
    "fr": [
      "Spécialiste de la côte de boeuf. Toutes les viandes et \r\ntous les poissons sont cuits uniquement à la cheminée. Ouvert uniquement le soir en saison (sauf lundi). Poussettes et maxi-cosy non adaptés."
    ],
    "nl": [
      "Gespecialiseerd in rundvlees. Alle vlees en vis wordt enkel  gebakken op haardvuur. Enkel Open: open ‘s avonds tijdens het seizoen. Kinderwagens en maxi-gezellig niet aangepast."
    ],
    "es": [
      "Especialista en costillas. Todas las carnes y pescados\r\ntoda la carne y el pescado se cocinan únicamente en la chimenea. Abierto sólo por la noche durante la temporada (excepto los lunes). No son aptos los cochecitos ni los maxi-cosy."
    ]
  },
  "rdfs:label": {
    "en": [
      "Le Gron restaurant"
    ],
    "fr": [
      "Bistro-grill Le Gron"
    ],
    "nl": [
      "Le Gron restaurant"
    ]
  },
