  "rdfs:comment": {
    "de": [
      "Hausgemachte, familiäre und großzügige Küche. Auf der Südterrasse können Sie sich in der Sonne entspannen und dabei die Gipfel und den Ort betrachten."
    ],
    "en": [
      "Generous home cooking. The south-facing terrace lets you relax in the sun while gazing at the peaks and the resort."
    ],
    "it": [
      "Cucina casalinga generosa. La terrazza esposta a sud permette di rilassarsi al sole ammirando le cime e il resort."
    ],
    "fr": [
      "Cuisine maison familiale et généreuse. La terrasse plein sud vous permettra de vous relaxer au soleil en contemplant les sommets et la station."
    ],
    "nl": [
      "Rijkelijke thuiskeuken. Op het terras op het zuiden kun je ontspannen in de zon terwijl je uitkijkt over de bergtoppen en het resort."
    ],
    "es": [
      "Generosa cocina casera. La terraza orientada al sur permite relajarse al sol contemplando las cumbres y la estación."
    ]
  },
