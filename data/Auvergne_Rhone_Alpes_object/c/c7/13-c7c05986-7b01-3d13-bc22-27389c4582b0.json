  "rdfs:comment": {
    "de": [
      "Cédric und Fabrice empfangen Sie in einer herzlichen Atmosphäre. Hier ist die Küche ein Mosaik aus Geschmäckern, Farben, Leidenschaft und Kunst."
    ],
    "en": [
      "You'll get a warm welcome from Cédric and Fabrice. The dishes here are bursting with flavour, colour, passion and style."
    ],
    "it": [
      "Cédric e Fabrice vi accolgono in un'atmosfera calorosa. Qui la cucina è un mosaico di sapori, colori, passione e arte."
    ],
    "fr": [
      "Cédric et Fabrice vous accueillent dans une ambiance chaleureuse. Ici, la cuisine est une mosaïque de goûts, de couleurs, de passion et d'art."
    ],
    "es": [
      "Cédric y Fabrice le dan la bienvenida en un ambiente cálido. Aquí, la cocina es un mosaico de sabores, colores, pasión y arte."
    ],
    "nl": [
      "Cédric en Fabrice heten je van harte welkom. Hier is koken een mozaïek van smaken, kleuren, passie en kunst."
    ]
  },
