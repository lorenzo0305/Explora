  "rdfs:comment": {
    "de": [
      "Entdecken Sie eine Kollektion einzigartiger, handgefertigter Stücke: Alltagsgegenstände und dekorative Stücke mit einem rohen und zeitgenössischen Universum, inspiriert von der urbanen Kunst."
    ],
    "en": [
      "Come and discover a collection of unique, hand-crafted pieces: everyday objects and decorative pieces in a raw, contemporary universe, inspired by urban art."
    ],
    "it": [
      "Venite a scoprire una collezione di pezzi unici, realizzati a mano: oggetti di uso quotidiano e pezzi decorativi con un taglio grezzo e contemporaneo, ispirati all'arte urbana."
    ],
    "fr": [
      "Venez découvrir une collection de pièces uniques, façonnées à la main : objets du quotidien et pièces décoratives à l'univers brut et contemporain, inspirés de l'art urbain."
    ],
    "es": [
      "Venga a descubrir una colección de piezas únicas hechas a mano: objetos cotidianos y piezas decorativas con un toque crudo y contemporáneo, inspiradas en el arte urbano."
    ],
    "nl": [
      "Kom en ontdek een collectie unieke, handgemaakte stukken: alledaagse voorwerpen en decoratieve stukken met een rauw, eigentijds randje, geïnspireerd door urban art."
    ]
  },
