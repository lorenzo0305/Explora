  "rdfs:comment": {
    "de": [
      "Kleine Snacks vor Ort (Wurst-/Käseplatten) Pizza\r\n8 Bier vom Fass, das regelmäßig wechselt, um möglichst viele gute Produkte zu entdecken. Übertragung von Sportereignissen auf Großbildschirmen, Konzerte,..."
    ],
    "en": [
      "On-site snacks (charcuterie/cheese boards) Pizza\r\n8 regularly changing draught beers to discover as many good products as possible. Sporting events broadcast on giant screens, concerts, etc."
    ],
    "it": [
      "Spuntini in loco (taglieri di salumi/formaggi) Pizza\r\n8 birre alla spina che cambiano regolarmente, per farvi scoprire il maggior numero possibile di buoni prodotti. Eventi sportivi trasmessi su schermi giganti, concerti, ecc."
    ],
    "fr": [
      "Petites restauration sur place (planches de charcuterie/fromage) Pizza\r\n8 bières pressions qui changent régulièrement histoire de découvrir un maximum de bon produits. Diffusion d'événements sportifs sur écrans géants, concerts,..."
    ],
    "nl": [
      "Snacks ter plaatse (vleeswaren/kaasplankjes) Pizza\r\n8 bieren van het vat die regelmatig veranderen, zodat je zoveel mogelijk goede producten kunt ontdekken. Sportevenementen uitgezonden op reuzenschermen, concerten, enz."
    ],
    "es": [
      "Aperitivos in situ (tablas de embutidos/quesos) Pizza\r\n8 cervezas de barril que cambian regularmente, para que pueda descubrir el mayor número posible de buenos productos. Eventos deportivos retransmitidos en pantallas gigantes, conciertos, etc."
    ]
  },
