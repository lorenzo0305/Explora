  "rdfs:comment": {
    "de": [
      "Bahnhof in einem Eisenbahnknotenpunkt, Eisenbahndrehscheibe, höchster Verzweigungsbahnhof der PLM, von dem aus die Linien nach Vichy oder Le Puy-en-Velay oder Bonson von1901 bis 1987 verliefen."
    ],
    "en": [
      "Station integrated into a railway junction, railway hub, the highest branch station of the PLM through which the lines radiated towards Vichy or Le Puy-en-Velay or Bonson from 1901 to 1987."
    ],
    "it": [
      "Stazione integrata in un nodo ferroviario, snodo ferroviario, la più alta stazione di diramazione del PLM attraverso cui si irradiavano le linee per Vichy o Le Puy-en-Velay o Bonson dal 1901 al 1987."
    ],
    "fr": [
      "Gare intégrée dans un noeud ferroviaire, plaque tournante ferroviaire, la plus haute gare de bifurcation du PLM par laquelle rayonnaient les lignes vers Vichy ou Le Puy-en-Velay ou Bonson de1901 à 1987."
    ],
    "nl": [
      "Station geïntegreerd in een spoorwegknooppunt, spoorwegknooppunt, het hoogste aftakkingsstation van de PLM waardoor de lijnen naar Vichy of Le Puy-en-Velay of Bonson liepen van 1901 tot 1987."
    ],
    "es": [
      "Estación integrada en un nudo ferroviario, nudo ferroviario, la estación más alta del ramal de la PLM por la que irradiaban las líneas a Vichy o Le Puy-en-Velay o Bonson desde 1901 hasta 1987."
    ]
  },
