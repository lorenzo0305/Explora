  "rdfs:comment": {
    "de": [
      "Snowboxx kehrt vom 14. bis 21. März 2026 für seine 12. Ausgabe nach Avoriaz zurück. Eine Mischung aus Skifahren, Konzerten und Après-Ski. Verbringen Sie eine Woche in einer unvergesslichen Atmosphäre mit einer echten Vielfalt an Musikrichtungen."
    ],
    "en": [
      "Snowboxx returns to Avoriaz from 14 to 21 March 2026 for its 12th edition.\r\nA mix of skiing, concerts and après-ski. Spend an unforgettable week filled with great vibes and a true diversity of music."
    ],
    "it": [
      "Snowboxx torna ad Avoriaz dal 14 al 21 marzo 2026 per la sua 12ª edizione. Un mix di sci, concerti e après-ski. Trascorrete una settimana in un'atmosfera indimenticabile, con una vera e propria diversità musicale."
    ],
    "fr": [
      "Snowboxx revient à Avoriaz du 14 au 21 Mars 2026 pour sa 12ème édition. Un mix de glisses, concerts et après-ski. Passez une semaine dans une ambiance inoubliable, avec une véritable diversité de musiques."
    ],
    "es": [
      "Snowboxx vuelve a Avoriaz del 14 al 21 de marzo de 2026 en su 12ª edición. Una mezcla de esquí, conciertos y après-ski. Pase una semana en un ambiente inolvidable, con una auténtica diversidad musical."
    ],
    "nl": [
      "Snowboxx keert terug naar Avoriaz van 14 tot 21 maart 2026 voor de 12e editie.\r\nEen mix van skiën, concerten en après-ski. Beleef een onvergetelijke week met een geweldige sfeer en een brede diversiteit aan muziek."
    ]
  },
