  "rdfs:comment": {
    "de": [
      "Mos?Eky events widmet sich dem Wohlbefinden von Pferden und Reitern, indem es Veranstaltungen und Taufen organisiert. Es ist auch ein Familien- und Freundschaftsabenteuer."
    ],
    "en": [
      "Mos?Eky events is dedicated to the well-being of horses and riders, organizing events and baptisms. It's also a friendly family adventure."
    ],
    "it": [
      "Mos?Eky events si dedica al benessere di cavalli e cavalieri, organizzando eventi e battesimi. È anche un'avventura familiare e amichevole."
    ],
    "fr": [
      "Mos’Eky events se consacre au bien-être du cheval et des cavaliers, en organisant des événements et des baptêmes. C’est aussi une aventure familiale et amicale."
    ],
    "nl": [
      "Mos?Eky events zet zich in voor het welzijn van paarden en ruiters en organiseert evenementen en dopen. Het is ook een gezinsvriendelijk avontuur."
    ],
    "es": [
      "Mos?Eky events se dedica al bienestar de caballos y jinetes, organizando eventos y bautismos. También es una aventura familiar y amistosa."
    ]
  },
