  "rdfs:comment": {
    "de": [
      "Das kleine Dorf Gigors, ein integraler Bestandteil des regionalen Naturparks Vercors, schmiegt sich auf einer Höhe von 600 Metern an die Hänge unterhalb der Klippen von Savel und bietet eine der schönsten Aussichten der Region."
    ],
    "en": [
      "The small village of Gigors, an integral part of the Vercors Regional Natural Park, clings, at an altitude of 600 meters, to the slopes below the cliffs of Savel, offering one of the most beautiful views in the region."
    ],
    "it": [
      "Il piccolo villaggio di Gigors, parte integrante del Parco Naturale Regionale del Vercors, si aggrappa a 600 metri di altitudine alle pendici delle falesie di Savel, offrendo uno dei panorami più belli della regione."
    ],
    "fr": [
      "Le petit village de Gigors, partie intégrante du Parc Naturel Régional du Vercors, s’accroche, à une altitude de 600 mètres, aux pentes se situant sous les falaises du Savel, offrant une des plus belles vues de la région."
    ],
    "nl": [
      "Het kleine dorpje Gigors, dat deel uitmaakt van het Regionaal Natuurpark van de Vercors, ligt op een hoogte van 600 meter aan de hellingen aan de voet van de kliffen van Savel en biedt een van de mooiste uitzichten in de regio."
    ],
    "es": [
      "El pequeño pueblo de Gigors, parte integrante del Parque Natural Regional de Vercors, se aferra a 600 metros de altitud a las laderas bajo los acantilados de Savel, ofreciendo una de las mejores vistas de la región."
    ]
  },
