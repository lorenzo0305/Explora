  "rdfs:comment": {
    "de": [
      "Manas ist das östlichste Dorf des Pays de Marsanne, ein kleines Dorf, das einst von einer Stadtmauer umgeben war. Das Dorf ist um sein Schloss aus dem 16. Jahrhundert herum gebaut, das an seinem Türmchen mit Wetterfahne zu erkennen ist, und ist ein Labyrinth aus Gassen und ..."
    ],
    "en": [
      "Once surrounded by ramparts, Manas is the most easterly village in the Pays de Marsanne. Wrapped around its 16th-century château, recognizable by its turret topped with a weather vane, the village is a maze of narrow streets and alleyways ..."
    ],
    "it": [
      "Piccolo villaggio un tempo circondato da bastioni, Manas è il villaggio più orientale del Pays de Marsanne. Avvolto attorno al suo castello del XVI secolo, riconoscibile dalla torretta sormontata da una banderuola, il villaggio è un labirinto di stradine e vicoli..."
    ],
    "fr": [
      "Petit village jadis entouré de remparts, Manas est le village le plus à l’est du Pays de Marsanne. Enroulé autour de son château du XVIème siècle, reconnaissable à sa tourelle coiffée d’une girouette, le village est un dédale de ruelles et de venelles ..."
    ],
    "es": [
      "Manas, un pequeño pueblo antaño rodeado de murallas, es el más oriental del Pays de Marsanne. Envuelto en su castillo del siglo XVI, reconocible por su torreta coronada por una veleta, el pueblo es un laberinto de calles estrechas y callejones..."
    ],
    "nl": [
      "Manas, ooit omringd door vestingmuren, is het meest oostelijke dorp van de Marsanne. Het dorp ligt rond het 16e-eeuwse kasteel, herkenbaar aan het torentje met de windwijzer, en is een doolhof van smalle straatjes en steegjes ..."
    ]
  },
