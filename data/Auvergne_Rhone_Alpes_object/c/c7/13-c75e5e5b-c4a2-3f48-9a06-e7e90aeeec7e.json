  "rdfs:comment": {
    "de": [
      "Wanderung in der Nähe der Skigebiete, durch Wälder und Almen.\r\nBreite Wege, ideal zum Fahren mit der Familie."
    ],
    "ru": [
      "Прогулки рядом с курортами, по лесам и горным пастбищам.\r\nШирокие тропинки, идеальные для семейного отдыха."
    ],
    "en": [
      "Walks close to resorts, through woods and mountain pastures.\r\nWide paths, ideal for families."
    ],
    "it": [
      "Passeggiate vicino ai resort, attraverso boschi e pascoli di montagna.\r\nAmpi sentieri, ideali per le famiglie."
    ],
    "fr": [
      "Promenade à proximité des stations, dans les bois et alpages.\r\nChemins larges, idéal pour rouler en famille."
    ],
    "nl": [
      "Wandelingen in de buurt van de resorts, door bossen en alpenweiden.\r\nBrede paden, ideaal voor gezinnen."
    ],
