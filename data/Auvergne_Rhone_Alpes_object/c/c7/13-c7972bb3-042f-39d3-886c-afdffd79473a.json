  "rdfs:comment": {
    "de": [
      "In der Bibliothek können Sie Bücher, Zeitschriften, DVDs und CDs mit einem Jahresabonnement ausleihen. Sie können sich auch niederlassen, um Zeitschriften zu konsultieren\r\nIm Multimedia-Bereich können Sie kostenlos das Internet nutzen."
    ],
    "en": [
      "The Library allows you to borrow books, magazines, DVDs and CDs with an annual subscription. You can also settle down to consult periodicals\r\nThe multimedia area offers you free Internet consultation."
    ],
    "it": [
      "La Biblioteca permette di prendere in prestito libri, riviste, DVD e CD con un abbonamento annuale. È anche possibile accontentarsi di consultare le riviste periodiche\r\nL'area multimediale offre l'accesso gratuito a Internet."
    ],
    "fr": [
      "La Bibliothèque vous permet d'emprunter livres, revues, DVD et CD avec un abonnement annuel. Vous pouvez également vous installer pour consulter des périodiques \r\nL'espace multimédia vous offre la consultation gratuite d'Internet."
    ],
    "es": [
      "La Biblioteca permite el préstamo de libros, revistas, DVDs y CDs con una suscripción anual. También puedes acomodarte para consultar publicaciones periódicas\r\nLa zona multimedia ofrece acceso gratuito a Internet."
    ],
    "nl": [
      "In de bibliotheek kunt u boeken, tijdschriften, dvd's en cd's lenen met een jaarabonnement. U kunt ook tijdschriften raadplegen\r\nDe multimediaruimte biedt gratis internettoegang."
    ]
  },
