  "rdfs:comment": {
    "de": [
      "Die Cave de Saint-Désirat vereint die Erzeuger der Weine mit den Appellationen Saint-Joseph, Condrieu, Croze-Hermitage und der IGP-Weine Collines Rhôdaniennes Syrah, Gamay, Viognier und Marsanne."
    ],
    "en": [
      "The Saint Desirat's cellar gather appellations wines producers : Saint- Joseph, Condrieu,  and grape varities from Pays Syrah, Gamay, Viognier and Marsanne"
    ],
    "it": [
      "La Cave de Saint-Désirat riunisce i produttori dei vini Saint-Joseph, Condrieu, Croze-Hermitage e IGP Collines Rhôdaniennes Syrah, Gamay, Viognier e Marsanne."
    ],
    "fr": [
      "La Cave de Saint-Désirat réunit les producteurs des vins d'appellations Saint-Joseph, Condrieu, Croze-Hermitage et des vins IGP Collines Rhôdaniennes Syrah, Gamay, Viognier et Marsanne."
    ],
    "es": [
      "La Cave de Saint-Désirat reúne a productores de vinos Saint-Joseph, Condrieu, Croze-Hermitage e IGP Collines Rhôdaniennes Syrah, Gamay, Viognier y Marsanne."
    ],
    "nl": [
      "De Cave de Saint-Désirat verenigt producenten van Saint-Joseph, Condrieu, Croze-Hermitage en IGP Collines Rhôdaniennes Syrah, Gamay, Viognier en Marsanne wijnen."
    ]
  },
