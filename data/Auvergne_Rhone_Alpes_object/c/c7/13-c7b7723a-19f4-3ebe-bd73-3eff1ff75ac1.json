  "rdfs:comment": {
    "de": [
      "Ein voller Tag auf dem Programm: Fütterung und Interaktion mit den Lemuren, Erkundung des Zoos, Papageienanimation, Einführung in die Falknerei, Pelikan-Snack, Fütterung und Show der Vögel."
    ],
    "en": [
      "A busy day: feeding and interaction with the lemurs, discovery of the zoo, parrot animation, introduction to falconry, pelican snack, bird feeding and show."
    ],
    "it": [
      "Il programma prevede una giornata intensa: alimentazione e interazione con i lemuri, scoperta dello zoo, animazione con i pappagalli, introduzione alla falconeria, tea party con i pellicani, alimentazione e spettacolo degli uccelli."
    ],
    "fr": [
      "Journée chargée au programme : nourrissage et interaction avec les lémuriens, découverte du zoo, animation des perroquets, initiation à la fauconnerie, goûter des pélicans, nourrissage et spectacle des oiseaux ."
    ],
    "es": [
      "Un día ajetreado en el programa: alimentación e interacción con los lémures, descubrimiento del zoo, entretenimiento con loros, introducción a la cetrería, merienda con pelícanos, alimentación y espectáculo con aves."
    ],
    "nl": [
      "Een drukke dag op het programma: voeren en interactie met de maki's, ontdekking van de dierentuin, papegaaienanimatie, inleiding tot de valkerij, pelikaan-theekransje, vogels voeren en show."
    ]
  },
  "rdfs:label": {
