  "rdfs:comment": {
    "de": [
      "Dieser Park befindet sich neben der Sporthalle Jeanie Longo und umfasst eine Fläche von 600 m2, die für Inline-Skates und Skateboards bestimmt ist. Ein Feld grenzt an den Entwicklungsbereich, in dem Erdhügel für BMX-Räder vorgesehen sind."
    ],
    "en": [
      "This park, located next to the gymnasium Jeanie Longo,  an area of 600m2 for roller skating and skateboarding."
    ],
    "it": [
      "Questo parco, situato accanto alla palestra Jeanie Longo, si estende su una superficie di 600 m2 per pattini e skateboard. Un campo confina con l'area di sviluppo dove sono presenti dossi in terra dedicati alle BMX."
    ],
    "fr": [
      "Ce parc, situé à côté du gymnase Jeanie Longo, couvre une surface de 600m2 destiné aux rollers et skate board. Un terrain jouxte l'espace d'évolution où des bosses de terre sont dédiées aux BMX."
    ],
    "es": [
      "Este parque, situado junto al gimnasio Jeanie Longo, tiene una superficie de 600 m2 para patinar y montar en monopatín. Un campo contiguo a la zona de urbanización en el que los baches de tierra están dedicados al BMX."
    ],
    "nl": [
      "Dit park ligt naast de Jeanie Longo gymzaal en heeft een oppervlakte van 600 m2 voor rolschaatsen en skateboarden. Er is ook een veld naast het ontwikkelingsgebied, met moguls voor BMX-fietsen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Street park"
    ]
  },
