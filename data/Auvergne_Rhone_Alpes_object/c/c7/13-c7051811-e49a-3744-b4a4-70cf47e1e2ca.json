  "rdfs:comment": {
    "de": [
      "Bewundern Sie den denkmalgeschützten Altaraufsatz aus dem 18. Jahrhundert im Stil des Bergbarocks, den größten in Hochsavoyen.\r\nMit dem Label \"Patrimoine Juniors\" ausgezeichnet."
    ],
    "en": [
      "Admire the heritage-listed framed altarpiece from the 18th century."
    ],
    "it": [
      "Ammirate la pala d'altare del XVIII secolo in stile barocco montano, la più grande dell'Alta Savoia.\r\nEtichettato \"Junior Heritage\"."
    ],
    "fr": [
      "Admirez le retable classé du 18ème siècle, de style baroque montagnard, le plus grand de Haute-Savoie.\r\nLabellisé \"Patrimoine Juniors\"."
    ],
    "nl": [
      "Bewonder het geklasseerde altaarstuk uit de 18e eeuw in bergbarokstijl, het grootste van de Haute-Savoie.\r\nMet het label \"Junior Heritage\"."
    ],
    "es": [
      "Admire el retablo catalogado del siglo XVIII de estilo barroco montañés, el más grande de la Alta Saboya.\r\nEtiquetado como \"Patrimonio Junior\"."
    ]
  },
  "rdfs:label": {
