  "rdfs:comment": {
    "de": [
      "Die Boutique Maison COMBIER ist ein einzigartiger Ort, an dem man die Seidenstoffe eines großen Lyoner Hauses sowie eine große Auswahl an außergewöhnlichen Tüchern und Schals findet."
    ],
    "en": [
      "The Maison COMBIER shop is a unique location where you can find the silk products produced by a major Lyonnais manufacturer in addition to a wide range of outstanding scarves and headscarves."
    ],
    "it": [
      "La boutique Maison COMBIER è un luogo unico dove si possono trovare le sete di una grande casa lionese e un'ampia gamma di sciarpe e fasce eccezionali."
    ],
    "fr": [
      "La boutique Maison COMBIER est un lieu unique où l'on trouve les soieries d'une grande maison lyonnaise ainsi qu'une large gamme de foulards et écharpes d'exception."
    ],
    "es": [
      "La boutique de la Maison COMBIER es un lugar único donde podrá encontrar las sedas de una gran casa lionesa, así como una amplia gama de pañuelos y fulares excepcionales."
    ],
    "nl": [
      "De boetiek van Maison COMBIER is een unieke plek waar u de zijde van een groot huis uit Lyon kunt vinden, evenals een ruim assortiment uitzonderlijke sjaals en omslagdoeken."
    ]
  },
