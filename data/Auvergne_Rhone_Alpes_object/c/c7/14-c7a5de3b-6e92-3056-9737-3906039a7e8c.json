  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/24f0c794-2a7e-39e3-9ff4-ee5d24aae791",
      "dc:description": {
        "de": [
          "Das Anbaugebiet der Erdbeere von Samer erstreckt sich über das gesamte Gebiet und wird seit über einem Jahrhundert angebaut.\nFrau Forestier gehört zu den Erdbeerproduzenten von Samer."
        ],
        "en": [
          "The Samer strawberry-growing area extends over the whole territory, and has been cultivated for over a century.\nMrs Forestier is one of the Samer strawberry growers."
        ],
        "it": [
          "La zona di coltivazione delle fragole di Samer copre l'intera regione e viene coltivata da oltre un secolo.\nLa signora Forestier è una delle coltivatrici di fragole di Samer."
        ],
        "fr": [
          "La zone de culture de la fraise de Samer s'étend sur tout le territoire, elle est cultivée depuis plus d'un siècle. \nMrs Forestier font partis des Producteur de fraises de Samer."
        ],
        "es": [
          "La zona fresera de Samer abarca toda la región y se cultiva desde hace más de un siglo.\nLa Sra. Forestier es una de las freseras de Samer."
        ],
        "nl": [
          "Het aardbeiengebied van de Samer strekt zich uit over de hele regio en wordt al meer dan een eeuw geteeld.\nMevrouw Forestier is een van de aardbeientelers van Samer."
        ]
      },
