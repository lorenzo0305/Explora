  "rdfs:comment": {
    "de": [
      "Erzeuger (GAEC) von frischem und trockenem Kuhkäse, Tomme in Salaten, Blue Joghurt...\r\nVerkauf auf dem Markt in Tournon am Freitagnachmittag (Erzeugermarkt auf den Iles Férays ), am Samstagmorgen."
    ],
    "en": [
      "Producer GAEC  fresh and dry cows cheese, Tomme, cheese with herbs and spices, butter. \r\nAll made traditionnally. Sale on the market of Tournon on Saturday morning and in the farm."
    ],
    "it": [
      "Produttore di formaggio vaccino fresco e secco, insalata di tomme, yogurt blu, ecc.\r\nVendita al mercato di Tournon il venerdì pomeriggio (mercato dei produttori di Iles Férays) e il sabato mattina."
    ],
    "fr": [
      "Producteur en GAEC de fromages de vaches frais et secs, tomme  en salade, bleu yaourt...\r\nVente sur le marché de Tournon le vendredi après midi (marché de producteur aux Iles Férays ), le samedi matin."
    ],
    "es": [
      "Productor GAEC de queso de vaca fresco y seco, ensalada de tomme, yogur azul, etc.\r\nVenta en el mercado de Tournon los viernes por la tarde (mercado de productores de Iles Férays) y los sábados por la mañana."
    ],
    "nl": [
      "GAEC producent van verse en gedroogde koeienkaas, tomme salade, blauwe yoghurt, etc.\r\nVerkoop op de markt van Tournon op vrijdagmiddag (producentenmarkt op Iles Férays) en zaterdagochtend."
    ]
  },
