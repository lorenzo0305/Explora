  "rdfs:comment": {
    "de": [
      "Winter: Verkauf und Verleih von Skiern, Tourenskiern, Snowboards, Schlitten, Schneeschuhen. Spezialisiert auf Bootfitting und Vorbereitung von Rennskiern.\r\nSommer: Verleih von Elektro-Mountainbikes und Mountainbikes, Klettersteig, BMX. Verkauf von Wanderschuhen und -ausrüstung."
    ],
    "en": [
      "Winter: Ski selling and rental, ski touring, snowboarding, sledges, snowshoes. Specialising in Bootfitting and preparation of Racing skis. \r\nSummer: Electric and mountain bike rentals, via ferrata, BMX. Hiking boots and equipment selling."
    ],
    "it": [
      "Inverno: Vendita e noleggio di sci, sci alpinismo, snowboard, slitte e racchette da neve. Specializzato nel montaggio degli scarponi e nella preparazione degli sci da gara.\r\nEstate: noleggio di biciclette elettriche e mountain bike, vie ferrate, BMX. Vendita di scarponi e attrezzatura da trekking."
    ],
    "fr": [
      "Hiver : Vente et Location de ski, ski de rando, Snowboard, Luges, raquettes. Spécialisé Bootfitting et préparation de skis Racing. \r\nEté : Location VTT Electrique et vtt, via ferrata, BMX. Vente chaussures et matériel de randonnée."
    ],
    "nl": [
      "Winter: verkoop en verhuur van ski's, toerski's, snowboards, sleeën en sneeuwschoenen. Gespecialiseerd in het aanmeten van schoenen en het prepareren van race-ski's.\nZomer: Verhuur van elektrische en mountainbikes, via ferrata, BMX. Verkoop van wandelschoenen en uitrusting."
    ],
    "es": [
      "Invierno: Venta y alquiler de esquís, esquí de travesía, snowboards, trineos y raquetas de nieve. Especializado en el ajuste de botas y la preparación de esquís de competición.\r\nVerano: Alquiler de bicicletas eléctricas y de montaña, vías ferratas, BMX. Venta de botas y material de senderismo."
    ]
  },
