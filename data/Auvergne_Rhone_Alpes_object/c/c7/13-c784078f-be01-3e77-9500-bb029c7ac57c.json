          "@type": [
            "schema:OpeningHoursSpecification"
          ],
          "additionalInformation": {
            "de": [
              "Öffnungszeiten des Büros :\r\nmontag bis Freitag von 9.00 bis 12.30 Uhr und von 14.00 bis 17.30 Uhr. Samstag und Sonntag geschlossen.\r\nAlle privaten und/oder geschäftlichen Leistungen sind auf Anfrage und vorbehaltlich der Verfügbarkeit unserer Teams und unserer verschiedenen Partner ganzjährig durchführbar."
            ],
            "en": [
              "Office opening hours:\r\nmonday to Friday, 9:00 am to 12:30 pm and 2:00 pm to 5:30 pm. Saturday and Sunday closed.\r\nAll private and/or professional services are available on request, subject to the availability of our teams and partners, all year round."
            ],
            "it": [
              "Orari di apertura dell'ufficio:\r\ndal lunedì al venerdì, dalle 9 alle 12.30 e dalle 14 alle 17.30. Sabato e domenica chiuso.\r\nTutti i servizi privati e/o professionali sono disponibili su richiesta, in base alla disponibilità dei nostri team e dei nostri vari partner, tutto l'anno."
            ],
            "fr": [
              "Horaires d'ouverture du bureau : \r\ndu lundi au vendredi de 9h00 à 12h30 et de 14h à 17h30. Samedi et dimanche fermés.\r\nToute prestation privée et/ou professionnelle est réalisable sur demande sous réserve de disponibilités de nos équipes et de nos différents partenaires, à l'année."
            ],
            "nl": [
              "Openingstijden kantoor:\r\nmaandag t/m vrijdag van 9.00 tot 12.30 uur en van 14.00 tot 17.30 uur. Zaterdag en zondag gesloten.\r\nAlle particuliere en/of professionele diensten zijn op aanvraag beschikbaar, afhankelijk van de beschikbaarheid van onze teams en onze verschillende partners, het hele jaar door."
            ],
            "es": [
              "Horario de oficina:\r\nde lunes a viernes, de 9.00 a 12.30 y de 14.00 a 17.30 horas. Sábado y domingo cerrado.\r\nTodos los servicios privados y/o profesionales están disponibles previa solicitud, en función de la disponibilidad de nuestros equipos y de nuestros distintos socios, durante todo el año."
            ]
          },
