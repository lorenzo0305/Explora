  "rdfs:comment": {
    "de": [
      "An einem Donnerstag im Monat öffnen die Studios ihre Türen!\r\nHier können sich Musikerinnen und Musiker aus der Region treffen, Kontakte knüpfen, Projekte starten oder einfach nur einen Abend lang zusammen spielen."
    ],
    "en": [
      "One Thursday a month, the studios open their doors!\r\nA rallying point for local musicians, it's an opportunity to meet, forge links, launch projects or simply play together for an evening."
    ],
    "it": [
      "Un giovedì al mese, gli studi aprono le loro porte!\r\nUn punto d'incontro per i musicisti locali, un'occasione per conoscere, stringere legami, lanciare progetti o semplicemente suonare insieme per una sera."
    ],
    "fr": [
      "Un jeudi par mois, les studios ouvrent leurs portes !\r\nPoint de ralliement pour les musicien-nes du territoire, c'est l'occasion de se rencontrer, tisser des liens, lancer des projets ou tout simplement jouer ensemble le temps d'une soirée."
    ],
    "es": [
      "Un jueves al mes, los estudios abren sus puertas\r\nPunto de encuentro de los músicos locales, es la ocasión de reunirse, estrechar lazos, lanzar proyectos o simplemente tocar juntos durante una tarde."
    ],
    "nl": [
      "Een donderdag per maand openen de studio's hun deuren!\r\nEen ontmoetingsplaats voor lokale muzikanten, een kans om elkaar te ontmoeten, banden te smeden, projecten te lanceren of gewoon een avond samen te spelen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Apéro Jam du 109"
    ]
  },
