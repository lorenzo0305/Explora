  "rdfs:comment": {
    "de": [
      "Das DoubleTree by Hilton Lyon Eurexpo & Spa, eines der erfolgreichsten HQE-Gebäude, befindet sich im Herzen des Technologieparks von St-Priest, in der Nähe von Eurexpo, dem größten Kongress- und Ausstellungszentrum der Region."
    ],
    "en": [
      "The Hôtel Doubletree by Hilton is a pioneer in terms of sustainable development, this establishment is the first entirely \"High Environmental Quality\" hotel in France. Located in the area of St-Priest, close to the famous exposition center “EUREXPO”."
    ],
    "it": [
      "Il DoubleTree by Hilton Lyon Eurexpo & Spa, uno degli edifici di maggior successo in termini di costruzione HQE, si trova nel cuore del Parc Technologique de St-Priest, vicino a Eurexpo, il più grande centro congressi ed esposizioni della regione."
    ],
    "fr": [
      "DoubleTree by Hilton Lyon Eurexpo & Spa, l’un des bâtiments les plus aboutis en matière de construction HQE, est situé au cœur du Parc Technologique de St-Priest, à proximité d'Eurexpo, le plus grand centre de conventions et d’expositions de la région."
    ],
    "es": [
      "DoubleTree by Hilton Lyon Eurexpo & Spa, uno de los edificios más exitosos en términos de construcción HQE, está situado en el corazón del Parc Technologique de St-Priest, cerca de Eurexpo, el mayor centro de convenciones y exposiciones de la región."
    ],
    "nl": [
      "DoubleTree by Hilton Lyon Eurexpo & Spa, een van de meest succesvolle gebouwen op het gebied van HQE-bouw, ligt in het hart van het Parc Technologique de St-Priest, vlakbij Eurexpo, het grootste congres- en expositiecentrum in de regio."
    ]
  },
