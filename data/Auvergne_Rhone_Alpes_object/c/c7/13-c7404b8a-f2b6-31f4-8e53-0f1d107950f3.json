  "rdfs:comment": {
    "de": [
      "Entdecken Sie handwerklich gebraute Biere in dieser unabhängigen und biologischen Brauerei in Saint-Agrève. Charaktervolle Biere, lokale Getränke, in Flaschen und Fässern. Die Taverne belebt sich regelmäßig mit Konzerten und punktuellen Animationen."
    ],
    "en": [
      "Discover craft beers at this independent, organic brewery in Saint-Agrève. Beers with character, local beverages, in bottles and kegs. The Taverne regularly hosts concerts and special events."
    ],
    "it": [
      "Scoprite le birre artigianali di questo birrificio indipendente e biologico di Saint-Agrève. Birre di carattere, bevande locali, in bottiglia e in fusto. La Taverne ospita regolarmente concerti ed eventi speciali."
    ],
    "fr": [
      "Découvrez des bières artisanales dans cette brasserie indépendante et biologique de Saint-Agrève. Bières de caractère, des boissons locales, en bouteilles et en fût. La Taverne s’anime régulièrement de concerts et animations ponctuelles."
    ],
    "nl": [
      "Ontdek ambachtelijke bieren in deze onafhankelijke, biologische brouwerij in Saint-Agrève. Karaktervolle bieren, lokale dranken, in flessen en vaten. In de Taverne worden regelmatig concerten en speciale evenementen georganiseerd."
    ],
    "es": [
      "Descubra las cervezas artesanales de esta cervecería independiente y ecológica de Saint-Agrève. Cervezas con carácter, bebidas locales, en botella y barril. La Taverne acoge regularmente conciertos y eventos especiales."
    ]
  },
