          "@type": [
            "schema:OpeningHoursSpecification"
          ],
          "additionalInformation": {
            "de": [
              "Öffnungszeiten des Empfangsbüros (außerhalb der Schulferien) :\r\nMontag, Dienstag, Donnerstag: von 10:00 bis 12:00 Uhr und von 14:30 bis 18:30 Uhr\r\nFreitag: 10:00 bis 12:00 Uhr\r\nSamstag: Ein Freiwilliger ist von 10:00 bis 12:00 Uhr anwesend\r\nMittwoch (nur Freizeitbetreuung) :\r\n8:30 bis 9:30 Uhr und 16:30 bis 18:00 Uhr"
            ],
            "en": [
              "Office hours (except during school vacations) :\r\nMonday, Tuesday, Thursday: 10am to 12pm and 2:30pm to 6:30pm\r\nFriday: 10am to 12pm\r\nSaturday: Volunteer presence from 10am to 12pm\r\nWednesday (Leisure Center only) :\r\n8:30am to 9:30am and 4:30pm to 6:00pm"
            ],
            "it": [
              "Orari d'ufficio (eccetto durante le vacanze scolastiche) :\r\nLunedì, martedì, giovedì: dalle 10.00 alle 12.00 e dalle 14.30 alle 18.30\r\nVenerdì dalle 10.00 alle 12.00\r\nSabato: presenza dei volontari dalle 10.00 alle 12.00\r\nMercoledì (solo per il Centro ricreativo) :\r\ndalle 8.30 alle 9.30 e dalle 16.30 alle 18.00"
            ],
            "fr": [
              "Permanence Bureau Accueil (Hors Vacances Scolaires) :\r\nLundi, Mardi, Jeudi: de 10h à 12h et de 14h30 à 18h30\r\nVendredi de 10h à 12h\r\nSamedi: Permanence d'un bénévole de 10h à 12h\r\nMercredi (Uniquement accueil de loisirs) :\r\n8h30 à 9h30 et 16h30 à 18h00"
            ],
            "nl": [
              "Kantooruren (behalve tijdens schoolvakanties) :\r\nMaandag, dinsdag, donderdag: 10u tot 12u en 14u30 tot 18u30\r\nVrijdag van 10u tot 12u\r\nZaterdag: Vrijwilligers aanwezigheid van 10u tot 12u\r\nWoensdag (alleen vrijetijdscentrum) :\r\n8u30 tot 9u30 en 16u30 tot 18u00"
