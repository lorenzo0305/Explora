  "rdfs:comment": {
    "de": [
      "Das Sozialzentrum ist ein Ort des Empfangs, des Zuhörens, der Begegnung, der Schaffung von Verbindungen, der Begleitung, der Beteiligung der Einwohner, der Aufgaben in Bezug auf Familien, ein kultureller Ort der Debatten und der Volksbildung."
    ],
    "en": [
      "The social center is a place of welcome, listening, meetings, creation of links, support, participation of the inhabitants, missions with the families, a cultural place of debates and popular education."
    ],
    "it": [
      "Il Centro sociale è un luogo di accoglienza, ascolto e incontro, dove si creano legami, si offre sostegno, si partecipa ai residenti, si realizzano missioni con le famiglie, ma è anche un luogo culturale di dibattito e di educazione popolare."
    ],
    "fr": [
      "Le Centre social est un lieu d'accueil, d'écoute, de rencontres, créateur de lien, d'accompagnement, de participation des habitants, de missions auprès des familles, un lieu culturel de débats et d'éducation populaire."
    ],
    "nl": [
      "Het Sociaal Centrum is een plaats waar mensen worden ontvangen, waar naar hen wordt geluisterd en waar ze elkaar ontmoeten, waar banden worden gesmeed, waar steun wordt verleend, waar bewoners participeren en waar missies met gezinnen worden uitgevoerd. Het is ook een culturele plaats voor debat en volksopvoeding."
    ],
    "es": [
      "El Centro Social es un lugar de acogida, de escucha y de encuentro, de creación de vínculos, de apoyo, de participación de los residentes, de misiones con las familias... También es un lugar cultural de debate y de educación popular."
    ]
  },
