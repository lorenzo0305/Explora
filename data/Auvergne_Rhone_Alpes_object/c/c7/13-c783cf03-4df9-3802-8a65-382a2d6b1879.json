  "rdfs:comment": {
    "de": [
      "Das Hotel Restaurant Sous les Pins, 5 Minuten von der Autobahnausfahrt Valence Sud (Ausfahrt Nr. 15) entfernt, empfängt Sie in einem angenehmen Rahmen mit Garten, Schwimmbad und Privatparkplatz, sei es für Zwischenstopps oder für Arbeitsseminare."
    ],
    "en": [
      "The hotel Restaurant Sous les Pins, 5 minutes from the Valence Sud freeway exit (exit 15), welcomes you in a pleasant setting with garden, swimming pool and private parking, whether for stopovers or business seminars."
    ],
    "it": [
      "L'hotel Restaurant Sous les Pins, a 5 minuti dall'uscita autostradale di Valence Sud (uscita N° 15), vi accoglie in un ambiente piacevole con giardino, piscina e parcheggio privato, sia per una sosta che per un seminario di lavoro."
    ],
    "fr": [
      "L’hôtel Restaurant Sous les Pins à 5 mn de la sortie d’autoroute Valence Sud (sortie N° 15) vous accueille dans un cadre agréable avec jardin, piscine, parking privé, que ce soit pour des étapes ou pour des séminaires de travail."
    ],
    "nl": [
      "Het hotel Restaurant Sous les Pins, op slechts 5 minuten van de afrit van de snelweg Valence Sud (afrit 15), verwelkomt u in een aangename omgeving met tuin, zwembad en privéparkeerplaats, zowel voor tussenstops als voor zakelijke seminars."
    ],
    "es": [
      "El hotel Restaurant Sous les Pins, a 5 minutos de la salida de la autopista Valence Sud (salida nº 15), le acoge en un entorno agradable con jardín, piscina y aparcamiento privado, tanto para escalas como para seminarios de negocios."
    ]
  },
