  "rdfs:comment": {
    "de": [
      "Feinkostladen and Weinkeller im Herzen der Fussgângerzone von Valence, die BOUTIQUE LAURENT ist Treffpunkt fûr Feinschmecker und Geniesser, ebenso wie angehende und erfahrene Kôche. Es bietet eine grosse Auswahl an regionalen, kulinarischen Produkten, die guten Geschmack mit hoher Qualitat vereinen, fûr alle Neugierigen, die auf der Suche nach aussergewôhnlichen Spezialitâten oder besonderen Geschencken sind."
    ],
    "en": [
      "A deli and wine cellar in the heart of Valence City center, BOUTIQUE LAURENT is a meeting place for gourmets and connoisseurs as well as aspiring and experienced chefs. It offers a large selection of regional and culinary products which combine delicious taste and high quality for all curious, looking for extraordinary specialties or gifts."
    ],
    "it": [
      "Una gastronomia a Valence dal 1986! Situata nella principale via pedonale di Valence, la Boutique Laurent è una gastronomia che da molti anni delizia gourmet, buongustai e curiosi."
    ],
    "fr": [
      "Épicerie fine à Valence depuis 1986 ! Située dans la rue piétonne principale de Valence, la Boutique Laurent est une épicerie fine avec de nombreux produits régionaux pour  le bonheur des gourmands, des gourmets et des curieux depuis de nombreuses années."
    ],
    "es": [
      "¡Delicatessen en Valence desde 1986! Situada en la principal calle peatonal de Valence, la Boutique Laurent es una charcutería que lleva muchos años haciendo las delicias de los amantes de la gastronomía, los gourmets y los curiosos."
    ],
    "nl": [
      "Delicatessenwinkel in Valence sinds 1986! Boutique Laurent, gelegen in de belangrijkste voetgangersstraat van Valence, is een delicatessenzaak die al vele jaren fijnproevers, fijnproevers en nieuwsgierigen verrukt."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Boutique Laurent"
    ]
  },
