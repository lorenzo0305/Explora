  "rdfs:comment": {
    "de": [
      "Entdecken Sie auf 4000 m² diesen Landschaftsraum: Kastanienbäume, skulpturale Blumen, Springbrunnen und Symbole, die in rosa, weißen und Porphyr-Granit gemeißelt sind."
    ],
    "en": [
      "Discover this 4000 m² landscaped garden: chestnut trees, flower sculptures, fountains and symbols carved into pink and white granite and porphyry."
    ],
    "it": [
      "Su oltre 4000 m², scoprite questo spazio paesaggistico: castagni, fiori scolpiti, fontane e simboli incisi in granito rosa, bianco e porfido."
    ],
    "fr": [
      "Sur 4000 m², découvrez cet espace paysager : marronniers, fleurs sculptures, fontaines et symboles gravés dans le granit rose, blanc et porphyre."
    ],
    "nl": [
      "Ontdek op meer dan 4000 m² dit landschap: kastanjebomen, gebeeldhouwde bloemen, fonteinen en symbolen gegraveerd in roze, wit en porfiergraniet."
    ],
    "es": [
      "En más de 4000 m², descubra este espacio ajardinado: castaños, flores esculpidas, fuentes y símbolos grabados en granito rosa, blanco y pórfido."
    ]
  },
