  "rdfs:comment": {
    "de": [
      "Dorf Lafarre: Kirche aus dem 12. Jahrhundert mit Kammglockenturm. Jahrhundert, Maison forte du Cros aus dem 13. Jahrhundert (privat)."
    ],
    "en": [
      "Village of Lafarre: 12th-century church with combed steeple. Mariac tower, remains of 13th-century castle, 13th-century Cros fortified house (private)."
    ],
    "it": [
      "Villaggio di Lafarre: chiesa del XII secolo con campanile a pettine. Torre di Mariac, resti di un castello del XIII secolo, casa fortificata Cros del XIII secolo (privata)."
    ],
    "fr": [
      "Village de Lafarre : Église du XIIe siècle à clocher peigne. Tour de Mariac, vestiges du château du XIIIe siècle, maison forte du Cros du XIIIe siècle (privée)."
    ],
    "es": [
      "Pueblo de Lafarre: iglesia del siglo XII con campanario peinado. Torre de Mariac, restos de castillo del siglo XIII, casa fortificada de Cros del siglo XIII (privada)."
    ],
    "nl": [
      "Dorp Lafarre: 12e-eeuwse kerk met gekamde klokkentoren. Mariac-toren, overblijfselen van kasteel uit de 13e eeuw, versterkte woning Cros uit de 13e eeuw (privé)."
    ]
  },
