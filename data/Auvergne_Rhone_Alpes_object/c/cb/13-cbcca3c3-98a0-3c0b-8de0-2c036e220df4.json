  "rdfs:comment": {
    "de": [
      "Der spielerische Orientierungsparcours führt Sie auf eine Entdeckungsreise durch die Biodiversität des Arboretums von Saint Georges sur Allier. In Form eines Quiz beantworten Sie an jeder Markierung eine Frage, um das letzte Rätsel zu lösen."
    ],
    "en": [
      "This fun orienteering trail takes you on a discovery of the biodiversity of the Saint Georges sur Allier arboretum. In the form of a quiz, you'll answer a question at each marker, enabling you to solve the final enigma."
    ],
    "it": [
      "Il divertente percorso di orienteering vi porta alla scoperta della biodiversità dell'arboreto di Saint Georges sur Allier. Sotto forma di quiz, ad ogni indicatore risponderete a una domanda che vi permetterà di risolvere l'enigma finale."
    ],
    "fr": [
      "Le parcours d’orientation ludique vous emmène à la découverte de la biodiversité de l’arboretum de Saint Georges sur Allier. Sous forme de quizz, vous répondrez à une question à chaque balise, vous permettant ainsi de résoudre l’énigme finale."
    ],
    "es": [
      "El divertido recorrido de orientación le llevará a descubrir la biodiversidad del arboreto de Saint Georges sur Allier. En forma de concurso, responderá a una pregunta en cada baliza, lo que le permitirá resolver el enigma final."
    ],
    "nl": [
      "De ludieke oriëntatieloop neemt je mee op ontdekking naar de biodiversiteit van het arboretum van Saint Georges sur Allier. In de vorm van een quiz beantwoord je bij elke markering een vraag, zodat je het uiteindelijke raadsel kunt oplossen."
    ]
  },
  "rdfs:label": {
    "en": [
      "Arboretum orienteering course (children's level)"
    ],
    "fr": [
      "Parcours d'orientation l'arborétum (niveau enfant)"
    ]
  },
