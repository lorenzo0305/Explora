  "rdfs:comment": {
    "de": [
      "Stück von der Compagnie Imbroglio. Regie: Stéphane Courtial. Dauer: 1 Stunde, für alle Altersgruppen. Drei Personen, die sich nicht kennen, treffen sich bei einer Blablacar-Fahrt."
    ],
    "en": [
      "Play by Compagnie Imbroglio. Directed by Stéphane Courtial. Running time: 1h, all audiences. Three people who don't know each other meet on a Blablacar trip."
    ],
    "it": [
      "Spettacolo della compagnia Imbroglio. Regia di Stéphane Courtial. Durata: 1 ora, per tutti i pubblici. Tre persone che non si conoscono si incontrano durante un viaggio in Blablacar."
    ],
    "fr": [
      "Pièce par la compagnie Imbroglio. Mise en scène : Stéphane Courtial. Durée : 1h, tout public. Trois personnes qui ne se connaissent pas se rencontrent à l’occasion d’un trajet Blablacar."
    ],
    "nl": [
      "Toneelstuk van het gezelschap Imbroglio. Regie: Stéphane Courtial. Duur: 1 uur, alle toeschouwers. Drie mensen die elkaar niet kennen ontmoeten elkaar op een Blablacar reis."
    ],
    "es": [
      "Obra de teatro de la compañía Imbroglio. Dirigida por Stéphane Courtial. Duración: 1 hora, todos los públicos. Tres personas que no se conocen se encuentran en un viaje en Blablacar."
    ]
  },
