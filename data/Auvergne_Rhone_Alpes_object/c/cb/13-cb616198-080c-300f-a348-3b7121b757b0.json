  "rdfs:comment": {
    "de": [
      "Das Geflügel wird ohne Antibiotikabehandlung im Freien gehalten und mit unseren eigenen Kulturen ohne Pestizide oder GVO gefüttert.\r\nDie Kälber werden von der Mutter aufgezogen."
    ],
    "en": [
      "Poultry is raised in the open air without antibiotic treatment and fed on our own crops without pesticides or GMOs.\r\nCalves are raised with their mothers."
    ],
    "it": [
      "Il pollame è allevato all'aria aperta senza trattamenti antibiotici e alimentato con colture proprie senza pesticidi o OGM.\r\nI vitelli sono allevati con le loro madri."
    ],
    "fr": [
      "Les volailles sont élevées en plein air sans traitement antibiotique et nourries de nos cultures sans pesticides, ni OGM.\r\nLes veaux sont élevés sous la mère."
    ],
    "es": [
      "Las aves de corral se crían al aire libre sin tratamiento antibiótico y se alimentan de nuestros propios cultivos sin pesticidas ni OMG.\r\nLos terneros se crían con sus madres."
    ],
    "nl": [
      "Het pluimvee wordt in de open lucht gekweekt zonder behandeling met antibiotica en gevoed met onze eigen gewassen zonder pesticiden of GGO's.\r\nKalveren worden bij hun moeder grootgebracht."
    ]
  },
