  "rdfs:comment": {
    "de": [
      "Entdecken Sie eine wunderbare Welt, die sich in den Abgründen des Massif des Bauges verbirgt.\r\nOb Groß oder Klein, ob in der Gruppe, mit der Familie oder mit Freunden, entdecken Sie die märchenhafte unterirdische Umgebung sowie die damit verbundenen Sensationen."
    ],
    "en": [
      "Discover a wonderful world hidden in the depths of the Massif des Bauges.\r\nYoung and old, in a group, with family or friends, discover the enchantment of the underground environment and the sensations it provides."
    ],
    "it": [
      "Scoprite un mondo meraviglioso nascosto nelle profondità del Massiccio dei Bauges.\r\nGrandi e piccini, in gruppo, con la famiglia o con gli amici, scoprite l'incanto dell'ambiente sotterraneo e le sensazioni che offre."
    ],
    "fr": [
      "Découvrez un merveilleux monde caché dans les abimes du Massif des Bauges.\r\nPetits et grands, en groupe, en famille, entre amis, découvrez la féérie du milieu souterrain ainsi que les sensations qu'il procure."
    ],
    "nl": [
      "Ontdek een wondere wereld die verborgen ligt in de diepten van het Massif des Bauges.\r\nJong en oud, in een groep, met familie of vrienden, ontdek de betovering van de ondergrondse omgeving en de sensaties die het biedt."
    ],
    "es": [
      "Descubra un mundo maravilloso escondido en las profundidades del Massif des Bauges.\r\nJóvenes y mayores, en grupo, en familia o con amigos, descubra el encanto del medio subterráneo y las sensaciones que proporciona."
    ]
  },
