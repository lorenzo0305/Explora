  "rdfs:comment": {
    "de": [
      "Die Metzgerei Robin bietet Ihnen lokales Fleisch, hausgemachte Wurstwaren oder Wurstwaren von lokalen Handwerkern sowie einen Feinkostbereich mit selbst zubereiteten Gerichten."
    ],
    "en": [
      "The Boucherie Robin offers local meats, home-made charcuterie and delicatessen dishes prepared by local artisans."
    ],
    "it": [
      "La Boucherie Robin offre carni locali, salumi fatti in casa o preparati da artigiani locali, oltre a un servizio di catering con piatti fatti in casa."
    ],
    "fr": [
      "La Boucherie Robin vous propose des viandes locales, de la charcuterie faite maison ou par des artisans locaux ainsi qu'une partie traiteur avec des plats préparés maison."
    ],
    "es": [
      "La Boucherie Robin ofrece carnes locales, charcutería casera o charcutería preparada por artesanos locales, así como un servicio de catering con platos caseros."
    ],
    "nl": [
      "De Boucherie Robin biedt lokale vleeswaren, huisgemaakte vleeswaren of vleeswaren bereid door lokale ambachtslieden, evenals een cateringservice met huisgemaakte gerechten."
    ]
  },
