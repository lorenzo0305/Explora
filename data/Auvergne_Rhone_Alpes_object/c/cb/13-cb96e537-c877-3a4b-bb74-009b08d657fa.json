  "rdfs:comment": {
    "de": [
      "Kleine handwerkliche Brauerei \"VDL\" (Virginie, David, Loïc) stellt im Sudhaus im Untergeschoss Biere her und bietet im Erdgeschoss einen gemütlichen Pub an.\r\nEssen und Trinken: lokale Getränke und hausgemachte Speisen. Vor Ort oder zum Mitnehmen."
    ],
    "en": [
      "Small craft brewery \"VDL\" (Virginie, David, Loïc) brews beers in the basement brewhouse and offers a friendly pub on the ground floor.\r\nFood and drink: local drinks and home-cooked food. On site or to take away."
    ],
    "it": [
      "Il piccolo birrificio artigianale \"VDL\" (Virginie, David, Loïc) produce birre nella cantina e offre un accogliente pub al piano terra.\r\nCibo e bevande: bevande locali e cibo fatto in casa. Sul posto o da portare via."
    ],
    "fr": [
      "Petite brasserie artisanale \"VDL\" (Virginie, David, Loïc) fabrique des bières dans la salle de brassage au sous-sol et propose au rdc un pub convivial.\r\nA boire et à manger : des boissons locales et une cuisine faite maison. Sur place ou à emporter."
    ],
    "es": [
      "La pequeña cervecería artesanal \"VDL\" (Virginie, David, Loïc) elabora cervezas en la fábrica del sótano y ofrece un agradable bar en la planta baja.\r\nComida y bebida: bebidas locales y comida casera. En el acto o para llevar."
    ],
    "nl": [
      "Kleine ambachtelijke brouwerij \"VDL\" (Virginie, David, Loïc) maakt bieren in de brouwerij in de kelder en biedt een gezellige pub op de begane grond.\r\nEten en drinken: lokale dranken en huisgemaakte gerechten. Ter plaatse of om mee te nemen."
    ]
  },
  "rdfs:label": {
    "en": [
      "Brew VDL"
    ],
    "fr": [
      "Brasserie VDL"
    ]
  },
