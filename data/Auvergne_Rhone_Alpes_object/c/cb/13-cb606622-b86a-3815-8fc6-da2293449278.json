  "rdfs:comment": {
    "de": [
      "Tauchen Sie ein in das Rätsel der Abteikirche von Cruas, einem in einem Geheimnis erstarrten Juwel aus dem 12. Jahrhundert. Seine Wächterskulpturen warten und enthüllen eine tausendjährige Geschichte, die in den Tiefen seiner faszinierenden Krypta vergraben liegt."
    ],
    "en": [
      "The abbey is a jewel of Romanesque art in Ardèche. It bears witness to the turbulent history of the former abbey of Cruas. Don't miss this beautiful place. \r\nIts very rare monastic gallery rediscovered 50 years ago, as well as its crypt and the mosaic."
    ],
    "it": [
      "Scoprite il nostro gioiello del XII secolo. La chiesa di Cruas è un tesoro. Testimonia la storia movimentata dell'antica abbazia di Cruas. Non perdetevi le sue sculture autentiche e la sua cripta, che fanno parte di questa visita straordinaria."
    ],
    "fr": [
      "Découvrez notre joyau du 12e siècle. L'église de Cruas possède de nombreux trésors. Elle témoigne de l'histoire mouvementée de l'ancienne abbaye de Cruas. Ne manquez pas ses sculptures authentiques et sa crypte qui jalonnent cette visite étonnante."
    ],
    "nl": [
      "Ontdek ons juweel uit de 12e eeuw. De kerk van Cruas is een schatkamer. Ze getuigt van de bewogen geschiedenis van de voormalige abdij van Cruas. Mis de authentieke beeldhouwwerken en de crypte niet, die deel uitmaken van deze verbazingwekkende rondleiding."
    ],
    "es": [
      "Descubra nuestra joya del siglo XII. La iglesia de Cruas es un tesoro. Es testigo de la agitada historia de la antigua abadía de Cruas. No se pierda sus auténticas esculturas y su cripta, que forman parte de esta sorprendente visita."
    ]
  },
