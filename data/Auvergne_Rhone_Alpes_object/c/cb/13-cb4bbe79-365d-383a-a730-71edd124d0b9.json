  "rdfs:comment": {
    "de": [
      "Dank der Verwendung von Blütenwasser, die für die Kleinsten geeignet sind, nähert sich diese Führung der Sonderausstellung \"Hubert Robert & Fragonard. Das Gefühl der Natur\" durch das Prisma der Düfte."
    ],
    "en": [
      "Using floral waters suitable for younger visitors, this tour approaches the temporary exhibition \"Hubert Robert & Fragonard. The Sense of Nature\" through the prism of scents."
    ],
    "it": [
      "Utilizzando acque floreali adatte ai visitatori più giovani, questa visita si avvicina alla mostra temporanea \"Hubert Robert & Fragonard. Il sentimento della natura\" attraverso il prisma dei profumi."
    ],
    "fr": [
      "Grâce à l’utilisation d’eaux florales adaptées aux plus jeunes, cette visite aborde l’exposition temporaire « Hubert Robert & Fragonard. Le sentiment de la nature » par le prisme des senteurs."
    ],
    "nl": [
      "Met bloemenwaters die geschikt zijn voor jongere bezoekers benadert deze rondleiding de tijdelijke tentoonstelling \"Hubert Robert & Fragonard. Het gevoel van de natuur\" door het prisma van geuren."
    ],
    "es": [
      "A través de aguas florales aptas para los más pequeños, este recorrido se acerca a la exposición temporal \"Hubert Robert & Fragonard. El sentimiento de la naturaleza\" a través del prisma de los aromas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite olfactive en famille - Les mercredis en famille"
    ]
  },
