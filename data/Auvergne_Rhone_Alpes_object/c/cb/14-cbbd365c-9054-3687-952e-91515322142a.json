  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/ae69763a-737a-396a-b687-585b029a8849",
      "dc:description": {
        "de": [
          "Agentur für die Vermietung von Pkw und Nutzfahrzeugen.\nMontag bis Freitag von 9 bis 12 Uhr und von 14 bis 18 Uhr sowie samstags von 9 bis 12 Uhr und von 13 bis 17 Uhr.\nKostenloser Pick-up-Service am Bahnhof während der Öffnungszeiten der Agentur"
        ],
        "en": [
          "Rental agency for passenger and commercial vehicles.\nMonday to Friday 9am to 12pm and 2pm to 6pm and Saturday 9am-12pm / 1pm-5pm.\nFree pick-up service at the station on branch opening days and times"
        ],
        "it": [
          "Agenzia di noleggio di autovetture e veicoli commerciali leggeri.\nDal lunedì al venerdì dalle 9.00 alle 12.00 e dalle 14.00 alle 18.00 e il sabato dalle 9.00 alle 12.00 / dalle 13.00 alle 17.00.\nServizio di ritiro gratuito in stazione nei giorni e negli orari di apertura della filiale"
        ],
        "fr": [
          "Agence de location de véhicules tourisme et utilitaires.\nLundi au vendredi de 9h à 12h et de 14h à 18h et le samedi 9h-12h / 13h-17h.\nService Pick up en gare gratuit aux jours et horaires d’ouverture de l’agence"
        ],
        "nl": [
          "Verhuur van personenauto's en lichte bedrijfswagens.\nMaandag t/m vrijdag van 9.00 tot 12.00 en van 14.00 tot 18.00 en zaterdag van 9.00 tot 12.00 en van 13.00 tot 17.00.\nGratis ophaalservice bij het station op openingsdagen en -tijden van de filialen"
        ],
        "es": [
          "Agencia de alquiler de turismos y vehículos comerciales ligeros.\nDe lunes a viernes de 9:00 a 12:00 y de 14:00 a 18:00 y sábados de 9:00 a 12:00 y de 13:00 a 17:00.\nServicio gratuito de recogida en la estación en los días y horarios de apertura de la sucursal"
        ]
      },
      "@type": [
        "Description"
      ],
