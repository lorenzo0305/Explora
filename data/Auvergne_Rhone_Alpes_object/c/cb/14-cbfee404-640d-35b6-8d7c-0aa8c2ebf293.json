  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/049de034-0eca-37c7-ae8c-d24de2eb8d10",
      "dc:description": {
        "de": [
          "Die Nocturne Calotteroise\nFreitag, 20. März - Start 20:30 Uhr\nSchule von La Calotterie\n------------------------\nOrganisiert von Multi Extrem Passion\nStrecke von 35 kms\n\nAnmeldung vor Ort ab 10 Uhr\nVerpflegung auf halber Strecke und am Ziel\nLichthelm, reflektierende Weste OBLIGATORISCH\n\nInformationen: 06 25 34 43 45\nStart: Place de l'Eglise (Platz der Kirche)\nKredit: Multi Extrem Passion"
        ],
        "en": [
          "La Nocturne Calotteroise\nFriday, March 20 - Departure 8:30pm\nCalotterie School\n------------------------\nOrganized by Multi Extrem Passion\n35 km course\n\nOn-site registration from 10am\nRefreshments at mid-course and finish\nLight helmet, reflective vest MANDATORY\n\nInformation: 06 25 34 43 45\nStart : Place de l'Eglise\nCredit: Multi Extrem Passion"
        ],
        "it": [
          "La Nocturne Calotteroise\nVenerdì 20 marzo - Inizio alle 20.30\nScuola La Calotterie\n------------------------\nOrganizzato da Multi Extrem Passion\nPercorso di 35 km\n\nIscrizioni in loco dalle 10.00\nRistoro a metà percorso e all'arrivo\nCasco leggero, gilet riflettente OBBLIGATORI\n\nInformazioni: 06 25 34 43 45\nPartenza: Place de l'Eglise\nCredito : Multi Extrem Passion"
        ],
        "fr": [
          "La Nocturne Calotteroise\nVendredi 20 mars - Départ 20h30\nEcole de la Calotterie\n------------------------\nOrganisé par Multi Extrem Passion\nParcours de 35 kms\n\nInscriptions sur place à partir de 10h\nRavitaillement à mi-parcours et à l’arrivée\nCasque lumière, gilet réfléchissant OBLIGATOIRE\n\nRenseignements : 06 25 34 43 45\nDépart : Place de l’Eglise \nCrédit : Multi Extrem Passion"
        ],
        "es": [
          "La Nocturne Calotteroise\nViernes 20 de marzo - Inicio a las 20.30 h\nEscuela La Calotterie\n------------------------\nOrganizado por Multi Extrem Passion\nRecorrido de 35 km\n\nInscripciones in situ a partir de las 10h\nAvituallamiento a mitad de recorrido y en meta\nCasco ligero, chaleco reflectante OBLIGATORIO\n\nInformación: 06 25 34 43 45\nSalida : Place de l'Eglise\nCrédito : Multi Extrem Passion"
        ],
        "nl": [
          "Calotteroise Nocturne\nVrijdag 20 maart - Aanvang 20.30 uur\nLa Calotterie School\n------------------------\nGeorganiseerd door Multi Extrem Passion\n35 km parcours\n\nInschrijving ter plaatse vanaf 10 uur\nVersnaperingen halverwege het parcours en bij de finish\nLichthelm, reflecterend vest VERPLICHT\n\nInformatie: 06 25 34 43 45\nStart : Place de l'Eglise\nKrediet : Multi Extrem Passion"
        ]
      },
