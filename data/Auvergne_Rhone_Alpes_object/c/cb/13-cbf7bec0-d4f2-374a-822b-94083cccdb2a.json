  "rdfs:comment": {
    "de": [
      "Der ECE Espace Culturel Européen ist ein Verein mit Sitz in Le Monastier-sur-Gazeille, der verschiedene kulturelle Veranstaltungen für jedes Publikum organisiert (Straßentheaterfestival, Aufführungen, Führungen durch das Kulturerbe von Le Monastier...)"
    ],
    "en": [
      "The ECE Espace Culturel Européen is an association based in Le Monastier-sur-Gazeille, organizing a variety of cultural events for the general public (street theater festival, shows, guided tours of Le Monastier's heritage, etc.)"
    ],
    "it": [
      "L'ECE Espace Culturel Européen è un'associazione con sede a Le Monastier-sur-Gazeille, che organizza una serie di eventi culturali per il grande pubblico (festival di teatro di strada, spettacoli, visite guidate al patrimonio di Le Monastier, ecc.)"
    ],
    "fr": [
      "L'ECE Espace Culturel Européen est une association basée au Monastier-sur-Gazeille, organisant des évènements culturels divers pour tout public (festival du théâtre de rue, spectacles, visites guidées du patrimoine du Monastier...)"
    ],
    "es": [
      "El ECE Espace Culturel Européen es una asociación con sede en Le Monastier-sur-Gazeille, que organiza diversas manifestaciones culturales para el gran público (festival de teatro de calle, espectáculos, visitas guiadas al patrimonio de Le Monastier, etc.)"
    ],
    "nl": [
      "De ECE Espace Culturel Européen is een vereniging gevestigd in Le Monastier-sur-Gazeille, die verschillende culturele evenementen organiseert voor het grote publiek (straattheaterfestival, voorstellingen, rondleidingen door het erfgoed van Le Monastier, enz.)"
    ]
  },
