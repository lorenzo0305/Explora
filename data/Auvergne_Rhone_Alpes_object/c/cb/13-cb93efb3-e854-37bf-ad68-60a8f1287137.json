  "rdfs:comment": {
    "de": [
      "Speisen Sie in einem wunderbaren Rahmen und der gediegenen Atmosphäre von Spieltischen. Elegant und komfortabel, bietet dieses Restaurant eine raffinierte Küche aus hochwertigen Produkten zubereitet werden."
    ],
    "en": [
      "The Baccara restaurant is located right inside Evian Casino and offers a subdued atmosphere around the table games. Chef Franck Miglierini and his teams serve fine, elegant cuisine using high-quality ingredients."
    ],
    "it": [
      "Il ristorante Baccara si trova all'interno del Casinò di Evian, in un'atmosfera silenziosa intorno ai tavoli da gioco. Scoprite la serenità del ristorante, la sua raffinatezza gastronomica e il suo servizio attento."
    ],
    "fr": [
      "Le restaurant le Baccara se situe dans l’enceinte même du Casino d’Evian, dans une ambiance feutrée autour des tables de jeux. Découvrez la sérénité du restaurant, son raffinement gastronomique et son service attentionné."
    ],
    "nl": [
      "Het restaurant Baccara bevindt zich in het Casino d'Evian, in een gezellige sfeer rond de speeltafels. Ontdek de sereniteit van het restaurant, de gastronomische verfijning en de attente service."
    ],
    "es": [
      "El restaurante Baccara está situado en el Casino Evian, en un ambiente silencioso alrededor de las mesas de juego. Descubra la serenidad del restaurante, su refinamiento gastronómico y su atento servicio."
    ]
  },
