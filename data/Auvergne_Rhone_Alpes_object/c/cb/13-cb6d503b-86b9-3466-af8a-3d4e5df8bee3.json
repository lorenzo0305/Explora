  "rdfs:comment": {
    "de": [
      "Chefkoch Alain Perrillat bietet eine Gourmetküche im Einklang mit dem Terroir der Pays de Savoie & des Lac du Bourget, der dem Restaurant als Kulisse dient.\r\n(Ausgezeichnet mit dem Michelin-Stern 2025, dem Grünen Stern, 3 Hauben & 15.5/20 im Gault-Millau)."
    ],
    "en": [
      "Chef Alain Perrillat offers gourmet cuisine inspired by the local produce of the Savoie region and Lake Bourget, which provides a stunning backdrop to the restaurant.\r\n(Awarded a Michelin star in 2025, a Green Star, 3 toques, and 15.5/20 in Gault-Millau)."
    ],
    "it": [
      "Lo chef Alain Perrillat propone una cucina gastronomica in armonia con il territorio della Savoia e del Lago del Bourget, che fa da cornice al ristorante.\r\n(Insignito della Stella Michelin 2025, Stella Verde, 3 cappelli e 15,5/20 dalla guida Gault-Millau)."
    ],
    "fr": [
      "Le Chef Alain Perrillat propose une cuisine gastronomique en accord avec le terroir des Pays de Savoie & du Lac du Bourget qui sert d'écrin au restaurant.\r\n(Auréolée de l'Etoile au Michelin 2025, Etoile Verte, de 3 toques & 15.5/20 au Gault-Millau)."
    ],
    "es": [
      "El Chef Alain Perrillat ofrece una cocina gastronómica en consonancia con el terruño de la región de Saboya y el Lac du Bourget, que sirve de marco al restaurante.\r\n(Ganador de la Etoile en Michelin 2025, Etoile Verte, 3 toques & 15,5/20 en Gault-Millau)."
    ],
    "nl": [
      "Chef-kok Alain Perrillat biedt gastronomische gerechten die passen bij het terroir van de Savoie en het Lac du Bourget, dat als decor dient voor het restaurant.\r\n(Winnaar van de Etoile bij Michelin 2025, Etoile Verte, 3 toques & 15,5/20 bij Gault-Millau)."
    ]
  },
