  "rdfs:comment": {
    "de": [
      "Das Central Park in Sainte-Foy-lès-Lyon bietet Ihnen eine Bistronomieküche mit traditionellen, hausgemachten Gerichten und Lyoner Spezialitäten, die mit Produkten aus der Region zubereitet werden\r\nregion und der Saison zubereitet werden."
    ],
    "en": [
      "Located in Sainte-Foy-lès-Lyon, Central Park offers bistronomic cuisine with traditional, homemade dishes and Lyonnais specialties, made with local and seasonal produce\r\nand seasonal produce."
    ],
    "it": [
      "Situato a Sainte-Foy-lès-Lyon, il Central Park offre una cucina bistronomica con piatti tradizionali e casalinghi e specialità lionesi, realizzati con prodotti locali e di stagione\r\ne prodotti di stagione."
    ],
    "fr": [
      "Situé à Sainte-Foy-lès-Lyon, le Central Park vous propose une cuisine bistronomique avec des plats traditionnels et faits maison et des spécialités lyonnaises, élaborés avec des produits du \r\nterroir et de saison."
    ],
    "nl": [
      "Central Park, gelegen in Sainte-Foy-lès-Lyon, biedt een bistronomische keuken met traditionele, huisgemaakte gerechten en specialiteiten uit Lyon, bereid met lokale en seizoensgebonden producten\r\nen seizoensproducten."
    ],
