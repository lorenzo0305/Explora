  "rdfs:comment": {
    "de": [
      "Unser Hof liegt im Herzen der Ardèche, in der Gemeinde Saint-Andéol-de-Fourchades auf 1000 m Höhe. Wir stellen Bio-Ziegenkäse vom Bauernhof her, wobei wir unsere Traditionen respektieren."
    ],
    "en": [
      "Our farm is located in the heart of the Ardèche, in the commune of Saint-Andéol-de-Fourchades at an altitude of 1000m. We produce organic farmhouse goat's cheese in keeping with our traditions."
    ],
    "it": [
      "La nostra azienda agricola si trova nel cuore dell'Ardèche, nel comune di Saint-Andéol-de-Fourchades, a 1000 metri di altitudine. Produciamo formaggio di capra biologico nel rispetto delle nostre tradizioni."
    ],
    "fr": [
      "Notre ferme se situe en plein cœur de l’Ardèche, sur la commune de Saint-Andéol-de-Fourchades à 1000m d’altitude. Nous produisons du fromage de chèvre fermier bio dans le respect  de nos traditions."
    ],
    "nl": [
      "Onze boerderij ligt in het hart van de Ardèche, in de gemeente Saint-Andéol-de-Fourchades op 1000m hoogte. Wij produceren biologische geitenkaas met respect voor onze tradities."
    ],
    "es": [
      "Nuestra granja está situada en el corazón de la Ardèche, en el municipio de Saint-Andéol-de-Fourchades, a 1000 metros de altitud. Producimos queso de cabra ecológico respetando nuestras tradiciones."
    ]
  },
  "rdfs:label": {
