  "rdfs:comment": {
    "de": [
      "Wenn Sie Lust auf Italien haben, sollten Sie unbedingt ins Monte Cassino kommen. Die Küche ist familiär, und die Produkte sind garantiert aus Italien. Herzlicher Empfang, Terrasse und Feinkostecke: Sie werden begeistert sein."
    ],
    "en": [
      "Feel like eating Italian? Don't hesitate to come to Monte Cassino. The home-made cuisine is prepared using Italian ingredients, the welcome is friendly and the terrace will suit you down to the ground."
    ],
    "it": [
      "Se avete voglia di Italia, non esitate a recarvi a Montecassino. La cucina è di tipo familiare e i prodotti sono garantiti di origine italiana. La calda accoglienza, la terrazza e il parcheggio vi aspettano!"
    ],
    "fr": [
      "Si l'envie d'Italie vous prend, n'hésitez surtout pas et rendez-vous au Monte Cassino. La cuisine est familiale et les produits sont garantis d'origine italienne. L'accueil chaleureux, la terrasse et son parking vous attendent !"
    ],
    "es": [
      "Si le apetece Italia, no dude en ir a Monte Cassino. La cocina es familiar y los productos son de origen italiano garantizado. La cálida bienvenida, la terraza y el aparcamiento te están esperando"
    ],
    "nl": [
      "Als je zin hebt in Italië, aarzel dan niet om naar Monte Cassino te gaan. De keuken is familiair en de producten zijn gegarandeerd van Italiaanse oorsprong. De warme ontvangst, het terras en de parkeerplaats wachten op u!"
    ]
  },
