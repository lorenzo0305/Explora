  "rdfs:comment": {
    "de": [
      "Murielle empfängt Kinder und Erwachsene zu Entdeckungsworkshops rund um das Mosaik. Ort der Begegnung und des Austauschs verschiedener Praktiken, Mini-Ausstellungen, Veranstaltungen."
    ],
    "en": [
      "Murielle welcomes children and adults to take part in mosaic workshops. A place to meet and share different practices, mini-exhibitions and events."
    ],
    "it": [
      "Murielle accoglie bambini e adulti per laboratori di scoperta del mosaico. Un luogo di incontro e condivisione di pratiche diverse, mini-mostre ed eventi."
    ],
    "fr": [
      "Murielle accueille enfants ou adultes pour des ateliers découverte autour de la mosaïque. Lieu de rencontre et de partage  de plusieurs pratiques, mini-expositions, animations évènementielles."
    ],
    "nl": [
      "Murielle verwelkomt kinderen en volwassenen voor ontdekkingsworkshops mozaïek. Een plek voor ontmoetingen en het delen van verschillende praktijken, mini-tentoonstellingen en evenementen."
    ],
    "es": [
      "Murielle acoge a niños y adultos en talleres de descubrimiento del mosaico. Un lugar para encontrarse y compartir diferentes prácticas, miniexposiciones y eventos."
    ]
  },
  "rdfs:label": {
