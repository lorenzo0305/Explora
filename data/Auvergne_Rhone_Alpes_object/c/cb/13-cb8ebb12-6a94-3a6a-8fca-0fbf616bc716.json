  "rdfs:comment": {
    "de": [
      "Der Lac d'Arvouin (1669m) ist zu Fuß in 45 min von Sevan in La Chapelle d'Abondance aus erreichbar. Fischbestand: Cristivomer, wilde Bachforelle."
    ],
    "en": [
      "Lac d'Arvouin (1669m) is a 45-minute walk from Sevan, in La Chapelle d'Abondance. Fish population: cristivomer, wild fario trout."
    ],
    "it": [
      "Il lago d'Arvouin (1669 m) è raggiungibile a piedi in 45 minuti da Sevan, presso La Chapelle d'Abondance. Popolazione ittica: cristivomero, trota fario selvatica."
    ],
    "fr": [
      "Le lac d'Arvouin (1669m) est accessible à pied en 45 min depuis Sevan, à La Chapelle d'Abondance. Peuplement piscicole : cristivomer, truite fario sauvage."
    ],
    "nl": [
      "Lac d'Arvouin (1669 m) kan te voet worden bereikt in 45 minuten vanaf Sevan, bij La Chapelle d'Abondance. Vispopulatie: cristivomer, wilde fario forel."
    ],
    "es": [
      "Al Lac d'Arvouin (1669 m) se llega a pie en 45 minutos desde Sevan, en La Chapelle d'Abondance. Población piscícola: cristivomer, trucha fario salvaje."
    ]
  },
  "rdfs:label": {
    "en": [
      "Fishing at Lake Arvouin"
    ],
    "fr": [
      "Pêche au lac d'Arvouin"
    ],
    "nl": [
      "Vissen bij het meer van Arvouin"
    ]
  },
