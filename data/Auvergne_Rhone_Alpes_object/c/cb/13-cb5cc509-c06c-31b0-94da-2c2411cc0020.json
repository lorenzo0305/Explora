  "rdfs:comment": {
    "de": [
      "Das Museum befindet sich im festen Haus (Maison forte) von Crest-Cherel, das zwischen dem 13. und 16. Jahrhundert errichtet wurde. Sie tauchen ein in das tägliche ländliche Leben der Bergbevölkerung von Ugine und dem Val d’Arly vom Ende des 19. bis zum Beginn des 20. Jahrhunderts."
    ],
    "en": [
      "Located in the Crest-Cherel fortified manor, the museum was built between the 13th and 16th centuries. You will discover the daily local, rural, and mountain life of the inhabitants of Ugine and the Val d'Arly from the late 19th to the early 20th century."
    ],
    "it": [
      "Situato nella casa forte di Crest-Cherel, il museo è stato costruito tra il XIII e il XVI secolo. Scoprirete la vita quotidiana locale, rurale e montana degli abitanti di Ugine e della Val d'Arly tra la fine del XIX e l'inizio del XX secolo."
    ],
    "fr": [
      "Situé dans la maison forte du Crest-Cherel, le musée a été bâti entre le XIIIème et le XVI ème siècle. Vous suivrez la vie locale quotidienne, rurale et montagnarde des habitants d’Ugine et du Val d’Arly de la fin du XIXème au début du XXème siècle."
    ],
    "es": [
      "Situado en la casa fortificada de Crest-Cherel, el museo fue construido entre los siglos XIII y XVI. Podrá seguir la vida cotidiana local, rural y montañesa de los habitantes de Ugine y del Val d'Arly desde finales del siglo XIX hasta principios del XX."
    ],
    "nl": [
      "Het museum is gevestigd in het versterkte huis van Crest-Cherel, gebouwd tussen de 13e en 16e eeuw. U ontdekt er het dagelijkse lokale, landelijke en bergachtige leven van de inwoners van Ugine en de Val d'Arly van het einde van de 19e tot het begin van de 20e eeuw."
    ]
  },
  "rdfs:label": {
