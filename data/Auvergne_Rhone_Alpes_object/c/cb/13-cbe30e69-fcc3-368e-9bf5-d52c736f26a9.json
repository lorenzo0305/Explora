  "rdfs:comment": {
    "de": [
      "Um die Skigebiete La Plagne und Les Arcs zu verbinden, fahren Sie mit der größten und prestigeträchtigsten Seilbahn der Welt: Vanoise Express."
    ],
    "en": [
      "To get between the ski areas of La Plagne and Les Arcs, you take the world's biggest and most prestigious cable car: the Vanoise Express."
    ],
    "it": [
      "Per collegare le aree sciistiche di La Plagne e Les Arcs, si prende la funivia più grande e prestigiosa del mondo: Vanoise Express."
    ],
    "fr": [
      "Pour relier les domaines skiables de la Plagne et des Arcs, vous empruntez le plus grand et le plus prestigieux téléphérique au monde : Vanoise Express."
    ],
    "es": [
      "Para unir las zonas de esquí de La Plagne y Les Arcs, se toma el mayor y más prestigioso teleférico del mundo: el Vanoise Express."
    ],
    "nl": [
      "Om de skigebieden van la Plagne en les Arcs te vervoegen, kan U gebruik maken van de grootste en meest prestigieuse gondelbaan van de wereld : de Vanoise Express."
    ]
  },
  "rdfs:label": {
