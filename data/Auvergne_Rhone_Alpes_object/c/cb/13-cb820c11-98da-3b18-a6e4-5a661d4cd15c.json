  "rdfs:comment": {
    "de": [
      "Geolokalisierte Spiele mit Tablet, die Logik- und Schnelligkeitsrätsel auf einem 3 km langen Rundweg im Wald miteinander verbinden.  Eine Aktivität für die ganze Familie oder mit Freunden."
    ],
    "en": [
      "Geolocation-based games with a tablet, combining logic and speed puzzles on a 3 km forest loop.  An activity to enjoy with family and friends."
    ],
    "it": [
      "Giochi basati sulla geolocalizzazione con un tablet che combinano puzzle di logica e velocità su un percorso di 3 km nella foresta.  Un'attività da praticare con la famiglia e gli amici."
    ],
    "fr": [
      "Jeux géolocalisés avec tablette mêlant des énigmes de logique et de rapidité sur une boucle de 3 km en forêt.  Une activité à faire en famille ou entre amis."
    ],
    "nl": [
      "Op geolocatie gebaseerde spellen met een tablet die logica en snelheidspuzzels combineren op een lus van 3 km in het bos.  Een activiteit om van te genieten met familie en vrienden."
    ],
    "es": [
      "Juegos basados en la geolocalización con una tableta que combinan puzles de lógica y velocidad en un bucle de 3 km en el bosque.  Una actividad para disfrutar con la familia y los amigos."
    ]
  },
