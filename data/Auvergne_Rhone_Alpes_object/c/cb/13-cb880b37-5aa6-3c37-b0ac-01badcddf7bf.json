  "rdfs:comment": {
    "de": [
      "Wählen Sie ein Erlebnis mit einem geländegängigen Elektroroller!\r\nAuf der Suche nach Naturlandschaften, einer kulturellen Tour durch die Isle-Crémieu oder einer Schatzsuche? Entdecken Sie die schönen Wege der Balcons du Dauphiné mit dem Elektroroller."
    ],
    "en": [
      "Choose an electric scooter experience!\r\nLooking for nature scenery, a cultural visit of the Isle-Crémieu or a treasure hunt... Discover the beautiful paths of the Balcons du Dauphiné on an electric scooter."
    ],
    "it": [
      "Scegliete un'esperienza in scooter elettrico!\r\nAlla ricerca di paesaggi naturali, di una visita culturale dell'Isle-Crémieu o di una caccia al tesoro... Scoprite gli splendidi sentieri dei Balcons du Dauphiné a bordo di uno scooter elettrico."
    ],
    "fr": [
      "Choisissez une expérience en trottinette électrique tout terrain! \r\nA la recherche de paysage nature, d'une visite culturelle de l'Isle-Crémieu ou d'une chasse aux trésors... Découvrez les beaux chemins des Balcons du Dauphiné en trottinette électrique."
    ],
    "es": [
      "¡Elija una experiencia en scooter eléctrico!\r\nEn busca de paisajes naturales, una visita cultural de la Isle-Crémieu o una búsqueda del tesoro... Descubre los hermosos senderos de los Balcons du Dauphiné en patinete eléctrico."
    ],
    "nl": [
      "Kies voor een elektrische scooter ervaring!\r\nOp zoek naar natuurschoon, een cultureel bezoek aan het Isle-Crémieu of een schattenjacht... Ontdek de prachtige paden van de Balcons du Dauphiné op een elektrische scooter."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Benj Aventures"
    ]
  },
