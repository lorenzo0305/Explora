  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/bd32de7f-cdc9-37f0-89ec-eb0e51e4400a",
      "dc:description": {
        "de": [
          "Ein seit 10 Jahren bestehender Laden, der nicht weniger als 350 Weine sowie eine wunderbare Auswahl an Spirituosen, Bieren und sogar ein Feinkostgeschäft anbietet."
        ],
        "en": [
          "Boutique open for 10 years, offering no less than 350 wines, as well as a wonderful selection of spirits, beers and even a delicatessen."
        ],
        "it": [
          "Un negozio aperto da 10 anni, che offre non meno di 350 vini, oltre a una splendida selezione di liquori, birre e persino una gastronomia."
        ],
        "fr": [
          "Boutique ouverte depuis 10 ans, qui propose pas moins de 350 vins ainsi qu’une merveilleuse sélection de spiritueux, bières et même une épicerie fine."
        ],
        "es": [
          "Una tienda abierta desde hace 10 años, que ofrece nada menos que 350 vinos, así como una magnífica selección de licores, cervezas e incluso una charcutería."
        ],
        "nl": [
          "Een winkel die al 10 jaar open is en niet minder dan 350 wijnen aanbiedt, evenals een prachtige selectie sterke dranken, bieren en zelfs een delicatessenwinkel."
        ]
      },
