  "rdfs:comment": {
    "de": [
      "Kommen Sie ein Glas in der Fourmilière trinken! Die \"Ameisen\" bieten ihnen ebenfalls eine hausgemachte Küche mit handwerklichen, lokalen und/oder Bioprodukten in einem warmherzigen und geselligen Ambiente an!"
    ],
    "en": [
      "Come and have a drink at the Anthill! The 'ants' also offer homemade food, made with artisan, local and organic produce, in a warm and friendly atmosphere!"
    ],
    "it": [
      "Vieni a bere un drink alla Fourmilière, il migliore dei formicai! Le nostre formiche ti proporranno una cucina tradizionale fatta di prodotti artigianali, a chilometro zero e/o biologici, in un clima accogliente e conviviale!"
    ],
    "fr": [
      "Venez boire un verre à la Fourmilière ! Les fourmis vous proposent également une cuisine maison avec des produits artisanaux, locaux et/ou bio dans une ambiance chaleureuse et conviviale !"
    ],
    "nl": [
      "Kom iets drinken in de Fourmilière! De mieren bieden ook home cooking met lokale en/of biologische producten in een warme en vriendelijke sfeer!"
    ],
    "es": [
      "En La Foumilière (el hormiguero) nuestras hormigas proponen una cocina casera con productos artesanales, locales y ecológicos en un entorno cálido y acogedor."
    ]
  },
