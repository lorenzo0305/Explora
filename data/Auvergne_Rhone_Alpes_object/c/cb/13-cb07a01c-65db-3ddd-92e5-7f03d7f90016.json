  "rdfs:comment": {
    "de": [
      "Das Spa Ô des Cimes du Nevada bietet Wellness-Massagen und -Modellagen sowie Schönheitsbehandlungen an. Vor oder nach Ihrer Behandlung können Sie Sauna, Hammam, Schwimmbad und Jacuzzi nutzen."
    ],
    "en": [
      "Our spaces for serenity are just magical: the moods and colors allow you at any time of the day to relax. Our whirlpool, our hammams, and saunas, can be enjoyed without moderation."
    ],
    "it": [
      "La Spa Ô des Cimes du Nevada offre massaggi benessere, trattamenti modellanti e di bellezza. Prima o dopo il trattamento, è possibile usufruire di saune, sale vapore, piscina e jacuzzi."
    ],
    "fr": [
      "Le Spa Ô des Cimes du Nevada offre des massages et modelages de bien être et des soins esthétiques. Avant ou après votre soin, vous pouvez profitez des saunas, hammams, piscine et jacuzzi."
    ],
    "es": [
      "El Spa Ô des Cimes du Nevada ofrece masajes de bienestar, modelado y tratamientos de belleza. Antes o después de su tratamiento, puede aprovechar las saunas, los baños de vapor, la piscina y el jacuzzi."
    ],
    "nl": [
      "De Spa Ô des Cimes du Nevada biedt wellnessmassages, modelleer- en schoonheidsbehandelingen. Voor of na je behandeling kun je gebruikmaken van de sauna's, stoombaden, het zwembad en de jacuzzi."
    ]
  },
  "rdfs:label": {
