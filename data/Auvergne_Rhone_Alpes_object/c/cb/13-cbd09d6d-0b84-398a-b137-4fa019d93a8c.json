  "rdfs:comment": {
    "de": [
      "Gemütliches Restaurant mit einer schönen Aussicht auf die umliegenden Berge.\nBergdekoration und rustikaler Rahmen. \nFamiliäre und lokale Küche\nHausgemachte Küche mit frischen Produkten"
    ],
    "en": [
      "Cosy and friendly restaurant with a nice view of the surrounding mountains.\r\nFamily cooking at reasonable prices.\r\nMountain decor."
    ],
    "it": [
      "Ristorante accogliente con splendida vista sulle montagne circostanti.\nArredamento di montagna e ambiente rustico\nCucina locale e familiare\nCucina casalinga con prodotti freschi"
    ],
    "fr": [
      "Restaurant convivial avec une jolie vue sur les montagnes environnantes.\nDécoration montagne et cadre rustique \nCuisine familiale et locale\nCuisine faite maison avec des produits frais"
    ],
    "nl": [
      "Gezellig restaurant met een mooi uitzicht op de omliggende bergen.\r\nBergdecoraite en rustiek kader.\r\nFamiliale en lokale keuken aan redelijke prijzen."
    ],
    "es": [
      "Acogedor restaurante con preciosas vistas de las montañas circundantes.\nDecoración montañesa y ambiente rústico\nCocina local y familiar\nCocina casera con productos frescos"
    ]
  },
