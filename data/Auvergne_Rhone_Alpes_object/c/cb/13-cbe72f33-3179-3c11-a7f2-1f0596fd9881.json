  "rdfs:comment": {
    "de": [
      "Die Kirche war vom Cluniazenserpriorat Lavoûte-Chilhac abhängig. Sie beherbergt eine polychrome Holzgrablegung aus dem 15. Jahrhundert mit sieben lebensgroßen Figuren, die den liegenden Christus umgeben. Romanischer Ch?ur aus dem 12."
    ],
    "en": [
      "The church was part of the Cluniac priory of Lavoûte-Chilhac, and features a 15th-century polychrome wooden tombstone with seven life-size figures surrounding the recumbent Christ. 12th-century Romanesque choir."
    ],
    "it": [
      "La chiesa apparteneva al priorato cluniacense di Lavoûte-Chilhac e ospita una tomba in legno policromo del XV secolo con sette figure a grandezza naturale che circondano il Cristo reclinato. Coro romanico del XII secolo."
    ],
    "fr": [
      "L'église dépendait du prieuré clunisien de Lavoûte-Chilhac, elle abrite une mise au tombeau en bois polychrome du XVème siècle avec sept personnages grandeur nature entourant le Christ gisant. Chœur roman du XIIe siècle."
    ],
    "es": [
      "La iglesia perteneció al priorato cluniacense de Lavoûte-Chilhac y alberga un sepulcro de madera policromada del siglo XV con siete figuras de tamaño natural que rodean al Cristo yacente. Coro románico del siglo XII."
    ],
    "nl": [
      "De kerk behoorde toe aan de Cluniacenpriorij van Lavoûte-Chilhac en herbergt een 15e-eeuws polychroom houten grafmonument met zeven levensgrote figuren die de liggende Christus omringen. Romaans koor uit de 12e eeuw."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Eglise Saint-Laurent"
    ]
  },
