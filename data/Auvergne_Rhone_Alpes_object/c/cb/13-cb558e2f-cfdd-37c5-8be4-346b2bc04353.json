  "rdfs:comment": {
    "de": [
      "Ein Berghütte mit atemberaubendem Blick auf den Aravis. Abwechslungsreiche Menüs mit frischen regionalen Produkten zugunsten von Kurzschlüssen. Unser Tagesangebot wird jeden Tag neu erfunden, im Winter in einer Selbstbedienungsvariante, im Sommer in einer Speisekarte mit Savoyer-Gerichten."
    ],
    "en": [
      "A mountain chalet with a breathtaking view of the Aravis. Varied menus with fresh regional products in favour of short circuits. Our daily special is reinvented every day, in winter in a self-service version, in summer in a menu with Savoyard dishes."
    ],
    "it": [
      "Uno chalet di montagna con una vista mozzafiato sui monti Aravis. Menù variati con prodotti freschi regionali a favore di circuiti brevi. Il nostro piatto del giorno viene reinventato ogni giorno, in inverno in versione self-service, in estate come menu con piatti savoiardi."
    ],
    "fr": [
      "Un chalet montagnard avec vue imprenable sur les Aravis. Menus variés avec des produits frais régionaux en faveur des circuits courts. Notre plat du jour est réinventé tous les jours, l'hiver en version self-service, l'été en menu avec plats savoyards."
    ],
    "es": [
      "Un chalet de montaña con una vista impresionante de las montañas de Aravis. Menús variados con productos regionales frescos a favor de los circuitos cortos. Nuestro plato del día se reinventa cada día, en invierno como versión de autoservicio, en verano como menú con platos saboyanos."
    ],
    "nl": [
      "Een bergchalet met een adembenemend uitzicht op het Aravis-gebergte. Gevarieerde menu's met verse streekproducten ten gunste van korte circuits. Onze dagschotel wordt elke dag opnieuw uitgevonden, in de winter als een zelfbedieningsversie, in de zomer als een menu met Savoyaardse gerechten."
    ]
  },
  "rdfs:label": {
    "de": [
      "Bergrestaurant \"La Duche\""
    ],
    "en": [
      "Altitude Restaurant La Duche"
    ],
    "fr": [
      "Restaurant d'altitude La Duche"
    ]
  },
