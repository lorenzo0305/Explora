  "rdfs:comment": {
    "de": [
      "Die Einwohner von Saint-Médard-en-Forez werden san-miardères genannt. Das Dorf trägt das Label \"village fleuri 2 fleurs\" (Blumendorf mit 2 Blumen). Entdecken Sie die sehr schöne Kirche, die auf dem Jakobsweg liegt, und die zum Wandern geeigneten Wege."
    ],
    "en": [
      "The inhabitants of Saint-Médard-en-Forez are called san-miardères. The village has been awarded the \"Village fleuri 2 fleurs\" label. Don't miss the beautiful church, on the route to Santiago de Compostela, and the hiking trails."
    ],
    "it": [
      "Gli abitanti di Saint-Médard-en-Forez sono chiamati san-miardères. Il villaggio ha ottenuto il marchio \"2 fiori\". Da non perdere la bella chiesa, che si trova sul percorso di pellegrinaggio verso Santiago de Compostela, e i sentieri per le passeggiate."
    ],
    "fr": [
      "Les habitants de Saint-Médard-en-Forez sont appelés les san-miardères. Le village est labellisé \"village fleuri 2 fleurs\". A découvrir la très belle église qui se trouve sur le chemin de St Jacques de Compostelle, et les sentiers propices à la randonnée."
    ],
    "nl": [
      "De inwoners van Saint-Médard-en-Forez worden san-miardères genoemd. Het dorp heeft het label \"2 bloemen\" gekregen. Mis de mooie kerk niet, die op de pelgrimsroute naar Santiago de Compostela ligt, en de wandelpaden."
    ],
    "es": [
      "A los habitantes de Saint-Médard-en-Forez se les llama san-miardères. El pueblo ha sido galardonado con la etiqueta \"2 flores\". No se pierda la hermosa iglesia, que se encuentra en la ruta de peregrinación a Santiago de Compostela, ni los senderos para pasear."
    ]
  },
