  "rdfs:comment": {
    "de": [
      "Achillea, Trésors glanés, das sind handgefertigte Kreationen rund um die Pflanze: Kränze aus Trockenblumen, Gestecke aus gepressten Blumen, Stickereien und Pflanzendrucke. Jedes Stück ist handgefertigt, vom Anbau der Blumen bis zur Endmontage."
    ],
    "en": [
      "Achillée, Trésors glanés, are handcrafted creations based around plants: dried flower wreaths, pressed flower arrangements, embroidery and plant prints. Each piece is handmade, from the cultivation of the flowers to the final assembly."
    ],
    "it": [
      "Achillée, Trésors glanés, è una gamma di creazioni artigianali basate sulle piante: corone di fiori secchi, composizioni di fiori pressati, ricami e stampe di piante. Ogni pezzo è fatto a mano, dalla coltivazione dei fiori all'assemblaggio finale."
    ],
    "fr": [
      "Achillée, Trésors glanés, ce sont des créations artisanales autour du végétal : couronnes de fleurs séchées, compositions en fleurs pressées, broderies et impressions végétales. Chaque pièce est faite main, de la culture des fleurs à l’assemblage final."
    ],
    "nl": [
      "Achillée, Trésors glanés, is een reeks handgemaakte creaties rond planten: kransen van gedroogde bloemen, arrangementen van geperste bloemen, borduurwerk en plantenprints. Elk stuk is handgemaakt, van het kweken van de bloemen tot de uiteindelijke assemblage."
    ],
    "es": [
      "Achillée, Trésors glanés, es una gama de creaciones hechas a mano en torno a las plantas: coronas de flores secas, arreglos de flores prensadas, bordados y estampados de plantas. Cada pieza está hecha a mano, desde el cultivo de las flores hasta el montaje final."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Achillée, Trésors glanés. Créations fleuries"
    ]
  },
