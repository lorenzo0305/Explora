  "rdfs:comment": {
    "de": [
      "Man geht ins Exil, um vor Krieg, Hunger, politischen oder familiären Konflikten zu fliehen; man geht auf Reisen, um die große weite Welt zu entdecken und den Horizont zu verändern."
    ],
    "en": [
      "People go into exile to escape war, famine, political or family conflicts; they travel to discover the wide world, to change their horizons."
    ],
    "it": [
      "Le persone vanno in esilio per sfuggire a guerre, carestie, conflitti politici o familiari; viaggiano per scoprire il mondo, per cambiare i propri orizzonti."
    ],
    "fr": [
      "On part en exil pour fuir la guerre, la famine, des conflits politiques ou familiaux ; on part en voyage pour découvrir le vaste monde, changer d’horizon."
    ],
    "nl": [
      "Mensen gaan in ballingschap om te ontsnappen aan oorlog, hongersnood, politieke of familieconflicten; ze reizen om de wijde wereld te ontdekken, om hun horizon te verruimen."
    ],
    "es": [
      "La gente se exilia para escapar de la guerra, el hambre, los conflictos políticos o familiares; viaja para descubrir el ancho mundo, para cambiar de horizonte."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Conférence : Revenir, l'érpreuve du retour"
    ]
  },
