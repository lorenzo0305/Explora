  "rdfs:comment": {
    "de": [
      "Die Tribünen des Ehrenplatzes bieten Platz für 350 Personen, der Rekordbesuch liegt bei 3500 Personen. 2 Spielfelder, von denen eines von einer 400 m langen Aschenbahn umgeben ist."
    ],
    "en": [
      "The grandstands on the main field welcomed 350 people, with a record attendance of 3,500. 2 evolution fields, one of which is surrounded by a 400-metre cinder track."
    ],
    "it": [
      "Le tribune del campo principale possono ospitare 350 persone, il record di presenze è di 3500 persone. 2 campi di evoluzione, uno dei quali è circondato da una pista di atletica in asfalto di 400 metri."
    ],
    "fr": [
      "Les tribunes du terrain d'honneur accueillent 350 personnes, l'affluence record est de 3500 personnes. 2 terrains d'évolution, dont un entourré d'une piste d'athlétisme en cendrée de 400 mètres."
    ],
    "es": [
      "Las tribunas del campo principal tienen capacidad para 350 personas, el récord de asistencia es de 3500. 2 campos de evolución, uno de los cuales está rodeado por una pista de atletismo de 400 metros de asfalto."
    ],
    "nl": [
      "De tribunes van het hoofdveld bieden plaats aan 350 mensen, de recordopkomst is 3500. 2 evolutievelden, waarvan één omgeven door een geasfalteerde atletiekbaan van 400 meter."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Stade de rugby Gérard Armand"
    ]
  },
