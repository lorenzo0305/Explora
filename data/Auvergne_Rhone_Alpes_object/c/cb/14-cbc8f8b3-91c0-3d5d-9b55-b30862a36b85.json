      "@id": "https://data.datatourisme.fr/a2ee20aa-f7fd-305e-a3f3-231891b809ae",
      "dc:description": {
        "de": [
          "Dienstag, 17. bis Samstag, 28. Februar 2026\n----------------------------------------------------\nDer Verein \"A.S. CUCQ TENNIS\" bietet Ihnen einen Tenniskurs an\nwährend der Schulferien\nEs werden Ihnen 1,5 Stunden pro Tag angeboten\nKONTAKT: 06.21.54.98.87\nFOTOKREDIT: AS Cucq Tennis"
        ],
        "en": [
          "Tuesday, February 17 to Saturday, February 28, 2026\n----------------------------------------------------\nThe \"A.S. CUCQ TENNIS\" association offers a tennis training course\nduring the school vacations\nSessions of 1h30 are offered 100? per day\nCONTACT : 06.21.54.98.87\nPHOTO CREDIT: AS Cucq Tennis"
        ],
        "it": [
          "Da martedì 17 a sabato 28 febbraio 2026\n----------------------------------------------------\nL'associazione \"A.S. CUCQ TENNIS\" propone un corso di tennis\ndurante le vacanze scolastiche\nLe sessioni di 1h30 sono offerte 100? al giorno\nCONTATTO: 06.21.54.98.87\nCREDITO FOTO: AS Cucq Tennis"
        ],
        "fr": [
          "Du mardi 17 au samedi 28 février 2026\n----------------------------------------------------\nL'association \"A.S. CUCQ TENNIS\" vous propose un stage de tennis\npendant les vacances scolaires \nDes séances de 1h30 vous sont proposés 100€ par jour\nCONTACT : 06.21.54.98.87\nCREDIT PHOTO : AS Cucq Tennis"
        ],
        "nl": [
          "Van dinsdag 17 tot zaterdag 28 februari 2026\n----------------------------------------------------\nDe vereniging \"A.S. CUCQ TENNIS\" biedt een tennisclinic aan\ntijdens de schoolvakanties\nSessies van 1u30 worden aangeboden 100? per dag\nCONTACT: 06.21.54.98.87\nFOTO CREDIT: AS Cucq Tennis"
        ],
        "es": [
          "Del martes 17 al sábado 28 de febrero de 2026\n----------------------------------------------------\nLa asociación \"A.S. CUCQ TENNIS\" ofrece un clinic de tenis\ndurante las vacaciones escolares\nSe ofrecen sesiones de 1h30 100? al día\nCONTACTO: 06.21.54.98.87\nFOTO CRÉDITO: AS Cucq Tennis"
        ]
      },
