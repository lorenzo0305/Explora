  "rdfs:comment": {
    "de": [
      "Vereinigung von Freiwilligen, die folgende Ziele verfolgt:\r\n- den Kauf von gebrauchter Kleidung zu sehr niedrigen Preisen zu ermöglichen (Unterwäsche, Kleidung, Schuhe, Haushaltswäsche...)\r\n- alle Einnahmen an verschiedene Wohltätigkeitsorganisationen zu spenden."
    ],
    "en": [
      "Voluntary association with the following objectives:\r\n- enable the purchase of second-hand clothing at very low prices (underwear, clothes, shoes, household linen, etc.)\r\n- donate all proceeds to various charities."
    ],
    "it": [
      "Associazione di volontari i cui obiettivi sono\r\n- consentire l'acquisto di abiti di seconda mano a prezzi molto bassi (biancheria intima, vestiti, scarpe, biancheria per la casa...)\r\n- di devolvere tutti i proventi a varie associazioni di beneficenza."
    ],
    "fr": [
      "Asssociation de bénévoles qui a pour objectifs:\r\n- permettre l'achat de vêtements d'occasion à très bas prix (sous-vêtements, vêtements, chaussures, linge de maison...)\r\n- verser la totalité des recettes à des associations caritatives diverses."
    ],
    "nl": [
      "Een vereniging van vrijwilligers met als doel\r\n- mensen in staat te stellen tegen zeer lage prijzen tweedehands kleding te kopen (ondergoed, kleding, schoenen, huishoudlinnen, enz.)\r\n- alle opbrengsten te schenken aan verschillende goede doelen."
    ],
    "es": [
      "Asociación de voluntarios cuyos objetivos son\r\n- permitir la compra de ropa de segunda mano a precios muy bajos (ropa interior, ropa, zapatos, ropa de casa...)\r\n- para donar todo lo recaudado a diversas organizaciones benéficas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Vestiaire"
    ]
  },
