  "rdfs:comment": {
    "de": [
      "Doux Joaillier ist eine Familiengeschichte. Als Wiederverkäufer der größten Uhren- und Schmuckhäuser besitzt Doux Joaillier auch eigene Werkstätten für die Kreation von maßgeschneiderten und zertifizierten Schmuckstücken sowie Uhrendienste."
    ],
    "en": [
      "Doux Joaillier is a family affair. Reseller for the world's leading watch and jewelry houses, Doux Joaillier also has its own workshops for the creation of bespoke, certified jewelry and watchmaking services."
    ],
    "it": [
      "Doux Joaillier è una storia di famiglia. Rivenditore di alcune delle più importanti case di orologi e gioielli del mondo, Doux Joaillier dispone anche di propri laboratori per la creazione di gioielli su misura e certificati e di propri servizi di orologeria."
    ],
    "fr": [
      "Doux Joaillier est une histoire de famille. Revendeur des plus grandes maisons d'horlogerie et de joaillierie, Doux Joaillier possède également ses propres ateliers pour la création de bijoux sur-mesure et certifiés et ses services d'horlogerie."
    ],
    "nl": [
      "Doux Joaillier is een familieverhaal. Doux Joaillier is een detailhandelaar voor enkele van 's werelds grootste horloge- en juwelenhuizen en heeft ook eigen ateliers voor het maken van gecertificeerde juwelen op maat en eigen horlogemakersdiensten."
    ],
    "es": [
      "Doux Joaillier es una historia de familia. Minorista de algunas de las principales casas relojeras y joyeras del mundo, Doux Joaillier también tiene sus propios talleres para la creación de joyas certificadas a medida y sus propios servicios de relojería."
    ]
  },
