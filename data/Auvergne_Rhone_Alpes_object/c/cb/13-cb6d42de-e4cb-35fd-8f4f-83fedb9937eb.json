  "rdfs:comment": {
    "de": [
      "Dieser Snowpoark liegt auf der Verdons-Piste in Courchevel 1850 und bietet Serienbuckel, Big Air, Rails, Tables, Boarder Cross und Spielbereiche! Ideal für die ganze Familie."
    ],
    "en": [
      "Located on the Verdons piste in Courchevel 1850, this snowpoark offers a series of bumps, Big Air, rails, tables, boarder cross and fun areas! Ideal for all the family."
    ],
    "it": [
      "Situato sulla pista Verdons di Courchevel 1850, questo snowpoark offre una serie di gobbe, Big Air, rail, tavoli, boarder cross e aree di divertimento! Ideale per tutta la famiglia."
    ],
    "fr": [
      "Situé sur la piste des Verdons, à Courchevel 1850, ce snowpoark propose des bosses en séries, Big air, rails, tables, boarder cross et espaces ludiques ! Idéal pour toute la famille."
    ],
    "es": [
      "Situado en la pista de Verdons, en Courchevel 1850, este snowpoark ofrece una serie de moguls, Big Air, rails, tablas, boarder cross y zonas de diversión Ideal para toda la familia."
    ],
    "nl": [
      "Dit snowpark ligt op de piste Verdons in Courchevel 1850 en biedt een reeks moguls, Big Air, rails, tables, boarder cross en fun areas! Ideaal voor het hele gezin."
    ]
  },
