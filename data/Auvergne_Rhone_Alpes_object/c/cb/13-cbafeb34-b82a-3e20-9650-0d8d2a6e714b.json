  "rdfs:comment": {
    "de": [
      "Gekühlte Feinschmeckerfächer mit Spezialitäten aus der Auvergne und anderen mit regionalen Produkten und bevorzugten Kurzstrecken. Schließfächer für süße Leckereien. Rund um die Uhr geöffnet."
    ],
    "en": [
      "Refrigerated gourmet racks with specialties from Auvergne and other regions. Sweet gourmet racks. Open 24 hours a day."
    ],
    "it": [
      "Cestini gourmet refrigerati con specialità dell'Alvernia e di altre regioni, con particolare attenzione ai prodotti locali e ai canali di distribuzione brevi. Scaffali gourmet dolci. Aperto 24 ore su 24."
    ],
    "fr": [
      "Casiers gourmands réfrigérés avec des spécialités auvergnates et autres avec des produits régionaux et circuit court privilégié. Casiers gourmands sucrés. Ouvert 24h/24."
    ],
    "es": [
      "Racks gourmet refrigerados con especialidades de Auvernia y otras regiones, con especial atención a los productos locales y a los canales de distribución cortos. Estanterías gastronómicas dulces. Abierto las 24 horas del día."
    ],
    "nl": [
      "Gekoelde gourmetrekken met specialiteiten uit de Auvergne en andere regio's, met de nadruk op lokale producten en korte distributiekanalen. Zoete gastronomische rekken. 24 uur per dag geopend."
    ]
  },
  "rdfs:label": {
