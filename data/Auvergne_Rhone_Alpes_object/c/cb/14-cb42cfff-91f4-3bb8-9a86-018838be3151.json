      "dc:description": {
        "de": [
          "Haben Sie Lust, den Star in Ihnen zu entfesseln? Machen Sie mit bei einem Karaoke-Abend voller Lachen, guter Laune und unumgänglicher Hits!"
        ],
        "en": [
          "Want to unleash your inner star? Join us for an evening of karaoke, laughter, good humor and chart-topping hits!"
        ],
        "it": [
          "Volete liberare la star che è in voi? Unisciti a noi per una serata di karaoke piena di risate, buonumore e hit da classifica!"
        ],
        "fr": [
          "Envie de libérer la star qui sommeille en vous ? Rejoignez nous pour une soirée karaoké pleines de rires, de bonne humeur et de tubes incontournables !"
        ],
        "es": [
          "¿Quieres dar rienda suelta a la estrella que llevas dentro? Únete a nosotros en una noche de karaoke llena de risas, buen humor y éxitos de las listas de éxitos"
        ],
        "nl": [
          "Wil je je innerlijke ster ontketenen? Kom bij ons voor een avond vol karaoke, gelach, goede humor en hitparadehits!"
        ]
      },
