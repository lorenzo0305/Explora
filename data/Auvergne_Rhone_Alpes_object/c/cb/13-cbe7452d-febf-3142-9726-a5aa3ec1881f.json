  "rdfs:comment": {
    "de": [
      "Laden mit lokalen Erzeugern.\r\nHerberge und Gite d'étape auf dem St Jacques.\r\nEin Kollektiv von 31 Landwirten bietet Ihnen die Möglichkeit, Produkte aus ihren Betrieben zu entdecken:\r\n- bauernkäse, Wurstwaren, Fleisch, Joghurt, Eis, Marmeladen..."
    ],
    "en": [
      "Local producers' store.\r\nInn and B&B on the St Jacques.\r\nA group of 31 farmers invite you to discover products from their farms:\r\n- farmhouse cheeses, charcuterie, meat, yoghurts, ice creams, jams..."
    ],
    "it": [
      "Negozio di produttori locali.\r\nLocanda e gite di sosta sul St Jacques.\r\nUn gruppo di 31 agricoltori vi invita a scoprire i prodotti delle loro fattorie:\r\n- formaggi di fattoria, salumi, carne, yogurt, gelati, marmellate, ecc."
    ],
    "fr": [
      "Boutique de producteurs locaux.\r\nAuberge et gite d'étape sur le St Jacques.\r\nUn collectif de 31 agriculteurs vous propose de découvrir des produits issus de leurs exploitations :\r\n- fromages fermiers, charcuterie, viande,  yaourts, glaces, confitures..."
    ],
    "nl": [
      "Winkel van plaatselijke producenten.\r\nHerberg en gîte aan de St Jacques.\r\nEen groep van 31 boeren nodigt u uit om de producten van hun boerderijen te ontdekken:\r\n- boerenkazen, charcuterie, vlees, yoghurt, ijs, jam, enz."
    ],
    "es": [
      "Tienda de productores locales.\r\nPosada y casa rural en St Jacques.\r\nUn grupo de 31 agricultores le invita a descubrir los productos de sus granjas:\r\n- quesos de granja, charcutería, carne, yogures, helados, mermeladas, etc."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Terroir en Gévaudan - Domaine du Sauvage"
    ]
  },
