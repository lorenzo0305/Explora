  "rdfs:comment": {
    "de": [
      "Die Bibliothek von Combloux bietet Ihnen einen freien und kostenlosen Zugang für alle, zum Lesen und zur Konsultation vor Ort.\r\n8.000 Bücher stehen Ihnen zur Verfügung, CDs und DVDs können ausgeliehen werden. Kostenloses WLAN."
    ],
    "en": [
      "Free access to the library for reading and consulting on the spot.\r\n8 000 items are available, books, CDs, DVDs. Free WIFI."
    ],
    "it": [
      "Accesso libero e gratuito per tutti, per la lettura e la consultazione in loco.\r\n8.000 libri sono a vostra disposizione, CD, DVD disponibili in prestito (gratuito fino a 18 anni). 2 computer con accesso gratuito e wifi gratuito."
    ],
    "fr": [
      "La bibliothèque de Combloux vous offre un accès libre et gratuit pour tous, pour la lecture et la consultation sur place.\r\n8 000 ouvrages sont à votre disposition, CD, DVD disponibles à l'emprunt. Wifi gratuit."
    ],
    "es": [
      "La biblioteca de Combloux le ofrece acceso libre y gratuito para todos, para la lectura y la consulta in situ.\r\n8.000 libros están a su disposición, CD, DVD disponibles para préstamo."
    ],
    "nl": [
      "De bibliotheek van Combloux is gratis toegankelijk voor iedereen, om ter plaatse te lezen en te raadplegen.\r\ner zijn 8.000 boeken, cd's en dvd's te leen. Gratis Wifi."
    ]
  },
