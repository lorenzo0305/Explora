  "rdfs:comment": {
    "de": [
      "Der Bosporus bietet Ihnen türkische Spezialitäten vor Ort (auf Reservierung) oder zum Mitnehmen an\r\nSie finden eine ganze Reihe von Sandwiches (Kebab, Burger, Tacos), Tellern oder Salaten."
    ],
    "en": [
      "Le Bosphore offers you Turkish specialities on the spot (by reservation) or to take away\r\nYou will find a whole range of sandwiches (kebabs, burgers, tacos), plates or salads."
    ],
    "it": [
      "Le Bosphore vi offre specialità turche sul posto (su prenotazione) o da asporto\r\nTroverete un'intera gamma di panini (kebab, hamburger, tacos), piatti o insalate."
    ],
    "fr": [
      "Le Bosphore vous propose des spécialités turques sur place (sur réservation) ou à emporter. \r\nVous trouverez toute une gamme de sandwichs (kebabs, burgers, tacos), assiettes ou salades."
    ],
    "es": [
      "Le Bosphore le ofrece especialidades turcas in situ (previa reserva) o para llevar\r\nEncontrará toda una gama de bocadillos (kebabs, hamburguesas, tacos), platos o ensaladas."
    ],
    "nl": [
      "Le Bosphore biedt u Turkse specialiteiten ter plaatse (op reservering) of om mee te nemen\r\nU vindt er een hele reeks broodjes (kebab, burgers, taco's), borden of salades."
    ]
  },
