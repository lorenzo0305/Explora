  "rdfs:comment": {
    "de": [
      "Der Parc des Trinitaires in Valence erstreckt sich über eine Fläche von fast 6 Hektar. Früher gehörte der Park dem Orden der Trinitarier, heute beherbergt er eine Art Naturschutzgebiet, in dem Sie verschiedene Arten beobachten können."
    ],
    "en": [
      "The Trinitarians' park in Valencia covers an area of 4 hectares. Formerly the property of the Trinitarian Order, this park is now a kind of nature reserve where you can observe different species."
    ],
    "it": [
      "Il Parc des Trinitaires di Valence si estende su una superficie di quasi 6 ettari. Ex proprietà dell'Ordine Trinitario, il parco è oggi una sorta di riserva naturale dove è possibile osservare una varietà di specie."
    ],
    "fr": [
      "Le parc des Trinitaires à Valence s'étend sur une superficie de près de 6 hectares. Autrefois propriété de l'Ordre des Trinitaires, ce parc abrite désormais une sorte de réserve naturelle où vous pourrez observer différentes espèces."
    ],
    "nl": [
      "Het park van de Trinitariërs in Valencia heeft een oppervlakte van 4 hectare. Dit park, dat vroeger eigendom was van de Trinitaire Orde, is nu een soort natuurreservaat waar u verschillende diersoorten kunt observeren."
    ],
    "es": [
      "El Parque de los Trinitarios de Valence ocupa una superficie de casi 6 hectáreas. Antiguamente propiedad de la Orden de los Trinitarios, el parque es ahora una especie de reserva natural donde se puede observar una gran variedad de especies."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Parc des Trinitaires"
    ]
  },
