  "rdfs:comment": {
    "de": [
      "Traditionelle chinesische Energiesitzungen, innerer Dialog und Wellness-Massagen.\r\nSolenne hat sich seit 2006 in all diesen Techniken für Ihr Wohlbefinden ausbilden lassen.\r\nNach vorheriger Vereinbarung. Möglichkeit, für traditionelle chinesische Energetik nach Hause zu kommen."
    ],
    "en": [
      "Traditional Chinese energy sessions, inner dialogue and well-being massages.\r\nSolenne has been trained since 2006 in all these techniques for your well-being.\r\nBy appointment. Possibility of travelling to your home for traditional Chinese energy."
    ],
    "it": [
      "Sessioni di energia tradizionale cinese, dialogo interiore e massaggi di benessere.\r\nSolenne è addestrata dal 2006 a tutte queste tecniche per il vostro benessere.\r\nSu appuntamento. Possibilità di recarsi a casa vostra per l'energia tradizionale cinese."
    ],
    "fr": [
      "Séance énergétique traditionnelle chinoise, dialogue intérieur et massages bien-être.\r\nSolenne s'est formée dès 2006 à toutes ces techniques pour votre bien-être.\r\nSur RDV. Possibilité de déplacement à domicile pour l'énergétique traditionnelle chinoise."
    ],
    "nl": [
      "Traditionele Chinese energiesessies, innerlijke dialoog en welzijnsmassages.\r\nSolenne is sinds 2006 opgeleid in al deze technieken voor uw welzijn.\r\nOp afspraak. Mogelijkheid om naar uw huis te reizen voor traditionele Chinese energie."
    ],
    "es": [
      "Sesiones de energía tradicional china, diálogo interior y masajes de bienestar.\r\nSolenne se ha formado desde 2006 en todas estas técnicas para su bienestar.\r\nCon cita previa. Posibilidad de desplazarse a su domicilio para recibir la energía tradicional china."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Énergétique traditionnelle chinoise"
    ]
  },
