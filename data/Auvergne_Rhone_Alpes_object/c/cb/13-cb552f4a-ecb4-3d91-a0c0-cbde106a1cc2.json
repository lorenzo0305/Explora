  "rdfs:comment": {
    "de": [
      "Eric und Antonin Linard bieten Ihnen eine große Auswahl an Drucken und künstlerischen Kreationen: Siebdruck, Digigrafie, Lithografie, Fotoabzüge, Beflockung, Klebstoffe, Glasmalerei, Tapeten, Einrahmung... auf allen Arten von Trägern."
    ],
    "en": [
      "Two exhibition rooms of 420 m² with a 540 m² workshop.Silkscreen printing activities, lithography. Guided and commented visit of the workshops with demonstrations for groups. Engraving, embossment and other printing works with around 80 different artists"
    ],
    "it": [
      "Eric e Antonin Linard vi offrono un'ampia scelta di stampe e creazioni artistiche: serigrafia, digigrafia, litografia, stampa fotografica, floccatura, adesivi, vetrate, carta da parati, cornici... su tutti i tipi di supporti."
    ],
    "fr": [
      "Eric et Antonin Linard vous proposent un large choix d'impression et de créations artistiques : sérigraphie, digigraphie, lithographie, tirage photos, flocage, adhésifs, vitrail, papier peint, encadrement... sur tout type de support."
    ],
    "es": [
      "Eric y Antonin Linard le proponen una amplia gama de impresiones y creaciones artísticas: serigrafía, digigrafía, litografía, impresión fotográfica, flocado, adhesivos, vidrieras, papel pintado, enmarcado... en todo tipo de soportes."
    ],
    "nl": [
      "Eric en Antonin Linard bieden je een ruime keuze aan drukwerk en artistieke creaties: zeefdruk, digigrafie, lithografie, fotodruk, flocking, lijmen, glas-in-lood, behang, inlijsten... op alle soorten media."
    ]
  },
