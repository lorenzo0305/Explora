  "rdfs:comment": {
    "de": [
      "In Chichilianne, dem Tor zu den Hauts-Plateaux du Vercors, informiert Sie der Touristeninformationspunkt über das Dorf und seine Weiler, Trièves, Mont-Aiguille, den Pnr du Vercors, das nationale Naturschutzgebiet und den benachbarten Sektor Diois."
    ],
    "en": [
      "In Chichilianne, gateway to the Hauts-Plateaux du Vercors, the tourist information point provides information on the village and its hamlets, the Trièves, Mont-Aiguille, the Pnr du Vercors, the National Nature Reserve and the neighboring Diois area."
    ],
    "it": [
      "A Chichilianne, porta degli Hauts-Plateaux du Vercors, il punto di informazione turistica fornisce informazioni sul villaggio e le sue frazioni, sulle Trièves, sul Mont-Aiguille, sul Pnr du Vercors, sulla Riserva Naturale Nazionale e sulla vicina area del Diois."
    ],
    "fr": [
      "A Chichilianne, Porte des Hauts-Plateaux du Vercors, le point d'information touristique vous renseigne sur le village et ses hameaux, le Trièves, le Mont-Aiguille, le Pnr du Vercors, la Réserve naturelle nationale et le secteur voisin du Diois."
    ],
    "nl": [
      "In Chichilianne, de toegangspoort tot de Hauts-Plateaux du Vercors, biedt het toeristisch informatiepunt informatie over het dorp en de gehuchten, de Trièves, de Mont-Aiguille, het Pnr du Vercors, het Nationaal Natuurreservaat en het aangrenzende Diois-gebied."
    ],
    "es": [
      "En Chichilianne, puerta de entrada a los Hauts-Plateaux du Vercors, el punto de información turística ofrece información sobre el pueblo y sus aldeas, los Trièves, el Mont-Aiguille, el Pnr du Vercors, la Reserva Natural Nacional y la vecina zona de Diois."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Point d'information touristique et randos de Chichilianne"
    ]
  },
