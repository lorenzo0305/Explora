  "rdfs:comment": {
    "de": [
      "Der Aquadôme in Langeac bekommt ein neues Gesicht!\r\nSportbecken, Spielbecken (Blasenbank und Strömungsfluss), ausgestattetes Planschbecken, Wellnessbereich (Sauna/Hammam), Rutsche und Naturstrand. Aktivitätenprogramm."
    ],
    "en": [
      "The Aquadôme in Langeac is getting a makeover!\r\nSports pool, leisure pool (bubble bench and current river), equipped paddling pool, wellness area (sauna/hammam), slide and natural beach. Activity program."
    ],
    "it": [
      "L'Aquadôme di Langeac si rinnova!\r\nPiscina sportiva, piscina per il tempo libero (panca per le bolle e fiume corrente), piscina per bambini attrezzata, area benessere (sauna/hammam), scivolo e spiaggia naturale. Programma di attività."
    ],
    "fr": [
      "L'Aquadôme de Langeac fait peau neuve !\r\nBassin sportif, bassin ludique (banquette à bulle et rivière à courant), pataugeoire équipée, espace bien-être (sauna/hammam), toboggan et plage naturelle. Programme d'activités."
    ],
    "nl": [
      "Het Aquadôme in Langeac krijgt een make-over!\r\nSportbad, recreatiebad (bubbelbank en stroomrivier), uitgerust peuterbad, wellnessruimte (sauna/hammam), glijbaan en natuurstrand. Activiteitenprogramma."
    ],
    "es": [
      "El Aquadôme de Langeac se renueva\r\nPiscina deportiva, piscina lúdica (banco de burbujas y río de corriente), piscina infantil equipada, espacio de bienestar (sauna/hammam), tobogán y playa natural. Programa de actividades."
    ]
  },
