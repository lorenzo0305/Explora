  "rdfs:comment": {
    "de": [
      "Jahrhundert erbaute und 2002 restaurierte Eiskeller ist ein kegelförmiges, halb verschüttetes Gebäude, in dem Eis gelagert wurde, das im Château de la Tourette für Lebensmittel oder therapeutische Zwecke benötigt wurde."
    ],
    "en": [
      "This rare and unusual ice storage building was built in the 18th century and restored in 2002. It is cone shaped and half buried, and was used to store the ice used by Château de la Tourette for the purpose of preserving food and therapeutic uses."
    ],
    "it": [
      "Edificio raro e insolito, questa ghiacciaia, costruita nel XVIII secolo e restaurata nel 2002, è una costruzione conica, semisepolta, che serviva a conservare il ghiaccio necessario al Castello della Tourette per scopi alimentari o terapeutici."
    ],
    "fr": [
      "Edifice rare et insolite, cette glacière, bâtie au XVIIIème siècle et restaurée en 2002, est une construction conique, à demi enfouie, qui servait à stocker la glace nécessaire au château de la Tourette à des fins alimentaires ou thérapeutiques."
    ],
    "nl": [
      "Een zeldzaam en ongewoon gebouw, dit ijshuis, gebouwd in de 18e eeuw en gerestaureerd in 2002, is een kegelvormige constructie, half ingegraven, die werd gebruikt om het ijs dat nodig was voor het Château de la Tourette op te slaan voor voedsel of therapeutische doeleinden."
    ],
    "es": [
      "Edificio raro e insólito, esta casa de hielo, construida en el siglo XVIII y restaurada en 2002, es una construcción cónica, semienterrada, que servía para almacenar el hielo necesario para el castillo de la Tourette con fines alimentarios o terapéuticos."
    ]
  },
  "rdfs:label": {
    "en": [
