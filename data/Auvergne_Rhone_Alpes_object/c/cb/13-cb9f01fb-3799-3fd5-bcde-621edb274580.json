  "rdfs:comment": {
    "de": [
      "Der Chefkoch lädt Sie morgens zu einem Kaffee, Tee oder einer heißen Schokolade ein, bevor Sie Ihren Tag beginnen. Mittags und abends serviert er Ihnen \"hausgemachte\" Gerichte."
    ],
    "en": [
      "Traditional cuisine restaurant"
    ],
    "it": [
      "Lo chef vi invita a bere un caffè, un tè o una cioccolata calda prima di iniziare la giornata. A pranzo e la sera vi servirà piatti fatti in casa."
    ],
    "fr": [
      "Le Chef  vous invite dés le matin pour un café , thé ou chocolat chaud avant de débuter votre journée. Les midis et soirs, il vous propose des plats ''fait maison''."
    ],
    "es": [
      "El Chef le invita a un café, té o chocolate caliente antes de empezar el día. Al mediodía y por la noche, le servirá platos caseros."
    ],
    "nl": [
      "De chef nodigt je uit voor een kopje koffie, thee of warme chocolademelk voordat je aan je dag begint. Tussen de middag en 's avonds serveert hij huisgemaakte gerechten."
    ]
  },
  "rdfs:label": {
