  "rdfs:comment": {
    "de": [
      "Entdecken Sie Gaïa, einen einzigartigen Ort für Ihre Abende in Courchevel, oder das Menü bietet einen köstlichen Einklang zwischen Asien und Hochgebirge."
    ],
    "en": [
      "Discover Gaïa, a unique place to pass the evening in Courchevel, where the menu offer a succulent mix between Asia and high mountains."
    ],
    "it": [
      "Scoprite Gaïa, un luogo unico per le vostre serate a Courchevel, dove il menu offre una succulenta combinazione di Asia e alta montagna."
    ],
    "fr": [
      "Découvrez Gaïa, un lieu unique pour vos soirées à Courchevel, ou le menu propose un accord succulent entre Asie et haute-montagne."
    ],
    "nl": [
      "Ontdek Gaïa, een unieke plek voor uw avonden in Courchevel, waar het menu een sappige combinatie van Azië en het hooggebergte biedt."
    ],
    "es": [
      "Descubra Gaïa, un lugar único para sus veladas en Courchevel, donde el menú ofrece una suculenta combinación de Asia y alta montaña."
    ]
