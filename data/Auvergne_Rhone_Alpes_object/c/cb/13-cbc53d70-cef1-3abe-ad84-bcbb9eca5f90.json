  "rdfs:comment": {
    "de": [
      "Am Fuße der Seilbahn von La Croix empfängt Sie das Restaurant im Dekor eines Alpenchalets und bietet Ihnen rund um den Kamin eine Küche für Feinschmecker und regionale Traditionen."
    ],
    "en": [
      "Located at the departure of \"La Croix\" gondola at Chamrousse 1650 - Recoin, the restaurant welcomes you in an alpine chalet setting, and offers you a cuisine for gourmets and of regional tradition."
    ],
    "it": [
      "Ai piedi della funivia di La Croix, il ristorante vi accoglie in un ambiente da chalet alpino e offre una cucina gourmet e tradizionale regionale attorno al camino."
    ],
    "fr": [
      "Au pied de la télécabine de la Croix, le restaurant vous accueille dans un décor de chalet alpin et vous propose autour de la cheminée une cuisine de gourmets et de tradition régionale."
    ],
    "es": [
      "Al pie del teleférico de La Croix, el restaurante le acoge en un entorno de chalet alpino y le ofrece una cocina gastronómica y tradicional regional alrededor de la chimenea."
    ],
    "nl": [
      "Aan de voet van de kabelbaan La Croix verwelkomt het restaurant u in een alpine chalet-setting en biedt gastronomische en traditionele regionale gerechten rond de open haard."
    ]
  },
