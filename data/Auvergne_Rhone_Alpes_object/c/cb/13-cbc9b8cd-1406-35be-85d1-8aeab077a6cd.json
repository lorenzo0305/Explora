  "rdfs:comment": {
    "de": [
      "Am Rande der ViaRhona empfängt Sie das Restaurant Terrasses du Rhône schon am Morgen. Saisonale Küche, alle 3 Monate wechselnde Speisekarte, Themenabende, abends Pizzas zum Mitnehmen oder vor Ort. Ideal für Einheimische, Touristen, Radfahrer und Arbeiter!"
    ],
    "en": [
      "On the banks of the Rhône and the ViaRhona, Les Terrasses du Rhône welcomes you from the morning. Seasonal cuisine, menu updated every 3 months, themed nights, catering service, and pizzas to take away or enjoy on-site. Perfect for locals, tourists, cyclists, and workers!"
    ],
    "it": [
      "Lungo la Via Rhona, Les Terrasses du Rhône vi accoglie al mattino. Cucina stagionale, nuovo menu ogni 3 mesi, serate a tema, pizze da asporto o da mangiare in casa. Ideale per locali, turisti, ciclisti e lavoratori!"
    ],
    "fr": [
      "En bordure de la ViaRhona, les Terrasses du Rhône vous accueillent dès le matin. Cuisine de saison, carte renouvelée tous les 3 mois, soirées à thème, le soir pizzas à emporter ou sur place. Idéal pour locaux, touristes, cyclistes et travailleurs !"
    ],
    "nl": [
      "Langs de Via Rhona heet Les Terrasses du Rhône je 's ochtends welkom. Seizoensgebonden keuken, elke 3 maanden een nieuw menu, thema-avonden, pizza's om mee te nemen of om op te eten. Ideaal voor inwoners, toeristen, fietsers en werknemers!"
    ],
    "es": [
      "Junto a la Via Rhona, Les Terrasses du Rhône le dan la bienvenida por la mañana. Cocina de temporada, nueva carta cada 3 meses, veladas temáticas, pizzas para llevar o para comer en el restaurante. Ideal para locales, turistas, ciclistas y trabajadores"
    ]
  },
