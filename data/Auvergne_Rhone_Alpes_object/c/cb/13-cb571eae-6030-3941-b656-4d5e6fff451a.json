  "rdfs:comment": {
    "de": [
      "Im La Bellissima in Crémieu wird die italienische Gastronomie mit einer kurzen und gepflegten Speisekarte neu interpretiert, die von den Inspirationen des Küchenchefs getragen wird. Hier werden bei jedem Gericht edle Produkte und authentische Aromen in einem schicken und zeitgenössischen Ambiente geehrt."
    ],
    "en": [
      "In Crémieu, La Bellissima brings a fresh take on Italian gastronomy with a refined, concise menu inspired by the Chef’s creativity. Each dish showcases quality ingredients and authentic flavours, all served in a chic, contemporary setting."
    ],
    "it": [
      "A Crémieu, La Bellissima rivisita la gastronomia italiana con un breve menu accuratamente elaborato e ispirato dallo chef. Ogni piatto è caratterizzato dai migliori prodotti e da sapori autentici, in un ambiente chic e contemporaneo."
    ],
    "fr": [
      "A Crémieu, La Bellissima revisite la gastronomie italienne avec une carte courte et soignée, portée par les inspirations du Chef. Ici, chaque plat met à l’honneur des produits nobles et des saveurs authentiques, dans une ambiance chic et contemporaine."
    ],
    "nl": [
      "In Crémieu herleeft La Bellissima de Italiaanse gastronomie met een kort, zorgvuldig samengesteld menu geïnspireerd door de chef. Elk gerecht bevat de beste producten en authentieke smaken, in een chique, eigentijdse omgeving."
    ],
    "es": [
      "En Crémieu, La Bellissima revisita la gastronomía italiana con un menú breve y cuidadosamente elaborado, inspirado por el chef. Cada plato incluye los mejores productos y sabores auténticos, en un ambiente elegante y contemporáneo."
    ]
  },
