  "rdfs:comment": {
    "de": [
      "Ein befestigter Ort in der Ebene von Valence, der von einem majestätischen Schloss aus dem 16. Jahrhundert beherrscht wird, das im 19. und 20. Jahrhundert umgebaut wurde. Das Dorfzentrum weist nur noch wenige Spuren der alten Stadtmauer auf, verfügt aber über eine schöne alte und erhaltene Bebauung."
    ],
    "en": [
      "A fortified village on the Valence plain, dominated by a majestic castle built in the 16th century and remodeled in the 19th and 20th centuries. The village center retains few traces of its ancient walls, but boasts an attractive, well-preserved old housing estate."
    ],
    "it": [
      "Villaggio fortificato nella pianura di Valence, dominato da un maestoso castello costruito nel XVI secolo e ridisegnato nel XIX e XX secolo. Il centro del paese conserva poche tracce delle sue antiche mura, ma ha un bell'habitat antico e conservato."
    ],
    "fr": [
      "Bourg fortifié de la plaine de Valence, dominé par un majestueux château construit au XVIe siècle, remaniée au XIXe siècle puis XXe siècle. Le centre village conserve peu de traces de son enceinte ancienne, mais présente un bel habitat ancien et préservé."
    ],
    "es": [
      "Pueblo fortificado en la llanura de Valence, dominado por un majestuoso castillo construido en el siglo XVI, rediseñado en los siglos XIX y XX. El centro del pueblo conserva pocos vestigios de sus antiguas murallas, pero tiene un hermoso hábitat antiguo y conservado."
    ],
    "nl": [
      "Een versterkt dorp op de vlakte van Valence, gedomineerd door een majestueus kasteel gebouwd in de 16e eeuw en verbouwd in de 19e en 20e eeuw. Het dorpscentrum heeft weinig sporen van zijn oude muren, maar heeft een mooie oude, goed bewaarde nederzetting."
    ]
  },
