  "rdfs:comment": {
    "de": [
      "Ob Kaffee, schnelles Mittagessen (leckere, reichhaltige und ausgewogene Mahlzeiten) oder ein Snack für zwischendurch - im Mountains Coffee wird alles zu 100 % hausgemacht.\r\nVor Ort oder zum Mitnehmen, Sie haben die Wahl!"
    ],
    "en": [
      "Whether you're looking for coffee, a quick lunch (hearty, well-balanced gourmet meals) or a snack, at Mountains Coffee it's 100% homemade.\r\nOn the spot or to go, it's up to you!"
    ],
    "it": [
      "Caffè, fast food per il pranzo (pasti gustosi, sostanziosi ed equilibrati) o spuntino, da Mountains Coffee è 100% fatto in casa.\r\nSul posto o da asporto, a voi la scelta!"
    ],
    "fr": [
      "Café, repas rapide pour le déjeuner (repas gourmands, copieux et équilibrés) ou venir pour le goûter, au Mountains Coffee c'est 100% fait maison.\r\nSur place ou à emporter, c'est vous qui décidez !"
    ],
    "nl": [
      "Koffie, fastfood voor de lunch (lekkere, stevige en evenwichtige maaltijden) of een tussendoortje, bij Mountains Coffee is het 100% huisgemaakt.\r\nTer plekke of afhalen, aan jou de keuze!"
    ],
    "es": [
      "Café, comida rápida para almorzar (sabrosa, abundante y equilibrada) o un tentempié, en Mountains Coffee es 100% casero.\r\nEn el momento o para llevar, ¡usted decide!"
    ]
  },
