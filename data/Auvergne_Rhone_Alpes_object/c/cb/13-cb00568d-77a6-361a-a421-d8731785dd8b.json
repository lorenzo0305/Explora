  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Herstellung der Verveine du Velay, vom Feld der Zitronenverbene bis zu den Destillierapparaten, von den Eichenfässern bis zur Verkostung... 45 Minuten voller erstaunlicher Entdeckungen!"
    ],
    "en": [
      "Discover how Verveine du Velay is made, from the lemon verbena fields to the stills, from the oak barrels to the tasting... 45 minutes of amazing discoveries!"
    ],
    "it": [
      "Scoprite la produzione della Verveine du Velay, dai campi di verbena al limone agli alambicchi, dalle botti di rovere alla degustazione... 45 minuti di scoperte straordinarie!"
    ],
    "fr": [
      "Découvrez la fabrication de la Verveine du Velay, du champs de verveine citronnelle aux alambics, des fûts de chêne à la dégustation... 45 minutes de découvertes étonnantes !"
    ],
    "nl": [
      "Ontdek het maken van Verveine du Velay, van de citroenverbena velden tot de distilleerkolven, van de eiken vaten tot de proeverij... 45 minuten van verbazingwekkende ontdekkingen!"
    ],
    "es": [
      "Descubra la elaboración de Verveine du Velay, desde los campos de hierba luisa hasta los alambiques, desde las barricas de roble hasta la degustación... ¡45 minutos de increíbles descubrimientos!"
    ]
  },
