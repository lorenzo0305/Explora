  "rdfs:comment": {
    "de": [
      "Kurzlebiges Sommerrestaurant, das von Mitte April bis Mitte Oktober inmitten der Weinberge gegenüber dem Berg Granier geöffnet ist\r\nBrasero-Abende am Freitag- und Samstagabend"
    ],
    "en": [
      "Ephemeral summer restaurant open from mid-April to mid-October in the middle of vineyards facing Mont Granier\r\nBrasero evenings on Friday and Saturday evenings"
    ],
    "it": [
      "Ristorante estivo effimero aperto da metà aprile a metà ottobre in mezzo ai vigneti di fronte al Mont Granier\r\nSerate con braciere il venerdì e il sabato sera"
    ],
    "fr": [
      "Restaurant estival éphémère ouvert de mi-avril à mi-octobre au milieu des vignes face au mont Granier\r\nSoirées Brasero le vendredi et samedi soir"
    ],
    "es": [
      "Restaurante efímero de verano abierto de mediados de abril a mediados de octubre en medio de los viñedos frente al Mont Granier\r\nVeladas con brasero los viernes y sábados por la noche"
    ],
    "nl": [
      "Efemeer zomerrestaurant geopend van half april tot half oktober midden in de wijngaarden tegenover de Mont Granier\r\nBraderie-avonden op vrijdag- en zaterdagavond"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Table Bohème"
    ]
  },
