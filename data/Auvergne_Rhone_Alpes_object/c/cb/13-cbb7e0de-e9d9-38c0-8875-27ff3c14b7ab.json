  "rdfs:comment": {
    "de": [
      "Die Bar Qui Mange lädt Sie ein, eine junge und gemütliche Atmosphäre zu genießen, die ideal ist, um am Fuße der Pisten eine Mahlzeit zu genießen oder ein Getränk zu trinken."
    ],
    "en": [
      "The Bar Qui Mange invites you to enjoy a young and friendly atmosphere, ideal for savouring a meal or a drink at the foot of the slopes."
    ],
    "it": [
      "Il Bar Qui Mange vi invita a godere di un'atmosfera giovane e accogliente, ideale per gustare un pasto o un drink ai piedi delle piste."
    ],
    "fr": [
      "Le Bar Qui Mange vous invite à profiter d’une ambiance jeune et chaleureuse, idéale pour savourer un repas ou boire un verre au pied des pistes."
    ],
    "es": [
      "El Bar Qui Mange le invita a disfrutar de un ambiente joven y acogedor, ideal para disfrutar de una comida o una copa a pie de pistas."
    ],
    "nl": [
      "De Bar Qui Mange nodigt je uit om te genieten van een jonge en gezellige sfeer, ideaal om te genieten van een maaltijd of een drankje aan de voet van de pistes."
    ]
  },
