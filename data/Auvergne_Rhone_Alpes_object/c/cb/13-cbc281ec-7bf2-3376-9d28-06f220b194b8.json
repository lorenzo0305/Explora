  "rdfs:comment": {
    "de": [
      "Gehen Sie durch den Park Auguste Borel und suchen Sie die 10 Markierungen, die auf diesem Orientierungslauf installiert sind. Beantworten Sie die Fragen auf dem Faltblatt, um etwas mehr über den Park und die würdige Marceline zu erfahren."
    ],
    "en": [
      "Set off through the Auguste Borel park in search of the 10 markers installed on this orienteering course, and answer the questions in the leaflet to find out a little more about the park and the worthy Marceline."
    ],
    "it": [
      "Attraversate il parco Auguste Borel alla ricerca dei 10 marcatori installati su questo percorso di orienteering e rispondete alle domande dell'opuscolo per saperne di più sul parco e sulla benemerita Marceline."
    ],
    "fr": [
      "A travers le parc Auguste Borel, partez à la recherche des 10 balises installés sur ce parcours d’orientation et répondez aux questions du dépliant pour en savoir un peu plus sur le parc et la digne Marceline."
    ],
    "nl": [
      "Trek door het park Auguste Borel op zoek naar de 10 markeringen die op dit oriëntatieparcours zijn aangebracht en beantwoord de vragen in de folder om iets meer te weten te komen over het park en de waard Marceline."
    ],
    "es": [
      "Recorra el parque Auguste Borel en busca de las 10 balizas instaladas en este recorrido de orientación y responda a las preguntas del folleto para saber un poco más sobre el parque y la benemérita Marceline."
    ]
  },
  "rdfs:label": {
