  "rdfs:comment": {
    "de": [
      "Die im Herzen des mittelalterlichen Dorfes gelegene Kirche, die nach den Religionskriegen wieder aufgebaut wurde, weist die Besonderheit eines doppelten Glockenturms auf."
    ],
    "en": [
      "Located in the heart of the medieval village, the church was rebuilt after the Wars of Religion and features a distinctive double bell tower."
    ],
    "it": [
      "Situata nel cuore del borgo medievale, la chiesa, ricostruita dopo le guerre di religione, presenta la particolarità di un doppio campanile."
    ],
    "fr": [
      "Située au cœur du village médiéval, l'église reconstruite après les guerres de Religions présente la particularité d'un double clocher."
    ],
    "es": [
      "Situada en el corazón del pueblo medieval, la iglesia, reconstruida tras las Guerras de Religión, tiene la particularidad de un doble campanario."
    ],
    "nl": [
      "De kerk, herbouwd na de godsdienstoorlogen, ligt in het hart van het middeleeuwse dorp en heeft een kenmerkende dubbele klokkentoren."
    ]
  },
