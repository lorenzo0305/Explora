  "rdfs:comment": {
    "de": [
      "Bresse-Bauernhof mit einem sarazenischen Schornstein, der Bresse-Paprika und Brennnesseln anbaut und verarbeitet. Hier wird der Bressico hergestellt!"
    ],
    "en": [
      "Bresse farm with its Saracen chimney producing Bresse peppers, nettles, luffa squash... among other things..."
    ],
    "it": [
      "Un'azienda agricola bresciana con camino saraceno che produce e lavora peperoncini di Bresse e ortiche. Qui si produce il Bressico!"
    ],
    "fr": [
      "Ferme bressane avec sa cheminée sarrasine qui produit des piments de Bresse, des orties et les transforme. C'est ici qu'est produit le Bressico!"
    ],
    "es": [
      "Una granja de Bresse con chimenea sarracena que produce y transforma chiles de Bresse y ortigas. ¡Aquí se produce el Bressico!"
    ],
    "nl": [
      "Een Bresse boerderij met een Saraceense schoorsteen die Bresse pepers en brandnetels produceert en verwerkt. Hier wordt Bressico geproduceerd!"
    ]
  },
