  "rdfs:comment": {
    "de": [
      "Der neue Museumsbereich zeigt 32 Schätze der Malerei, die vom Impressionismus inspiriert sind, zur Freude aller Kunstliebhaber. Vier Sammlungen laden zu einem Spaziergang durch die Jahreszeiten inmitten der von Victor Charreton so geliebten Landschaften ein"
    ],
    "en": [
      "The new museum space presents 32 Impressionist-inspired painting treasures for the enjoyment of art lovers. Four collections invite you to take a stroll through the seasons, among the landscapes so loved by Victor Charreton"
    ],
    "it": [
      "Il nuovo museo espone 32 tesori pittorici di ispirazione impressionista per il piacere degli amanti dell'arte. Quattro collezioni invitano a passeggiare attraverso le stagioni, tra i paesaggi tanto amati da Victor Charreton"
    ],
    "fr": [
      "Le nouvel espace muséal présente 32 trésors de la peinture, d'inspiration impressionniste, pour le plus grand plaisir des amateurs d'art. Quatre collections invitent à une promenade à travers les saisons parmi les paysages tant aimés par  Victor Charreton"
    ],
    "nl": [
      "In het nieuwe museum kunnen kunstliefhebbers genieten van 32 impressionistische schilderijen. Vier collecties nodigen uit tot een wandeling door de seizoenen, tussen de landschappen waar Victor Charreton zo van hield"
    ],
    "es": [
      "El nuevo museo expone 32 tesoros pictóricos de inspiración impresionista para disfrute de los amantes del arte. Cuatro colecciones le invitan a pasear por las estaciones, entre los paisajes tan amados por Victor Charreton"
    ]
  },
  "rdfs:label": {
