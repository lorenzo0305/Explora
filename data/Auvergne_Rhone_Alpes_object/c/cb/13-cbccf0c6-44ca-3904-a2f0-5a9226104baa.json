  "rdfs:comment": {
    "de": [
      "Seit über 20 Jahren stellt Didier Giron seine ganze Leidenschaft für den Beruf des Metzgers und Feinkosthändlers in den Dienst seiner Kunden. Er empfängt Sie in seinem Restaurant, das frische und hausgemachte Produkte anbietet."
    ],
    "en": [
      "For over 20 years this passionate butcher and caterer has been aiming to please his customers. Didier Giron's has recently opened his own restaurant where he offers fresh and homemade produce."
    ],
    "it": [
      "Da oltre 20 anni, Didier Giron mette al servizio dei suoi clienti tutta la sua passione per la norcineria. Vi accoglie nel suo ristorante, che offre prodotti freschi e fatti in casa."
    ],
    "fr": [
      "Depuis plus de 20 ans, Didier Giron met toute sa passion du métier de charcutier traiteur au service de ses clients. Il vous accueille dans son restaurant proposant des produits frais et maison."
    ],
    "es": [
      "Desde hace más de 20 años, Didier Giron pone toda su pasión por el oficio de carnicero al servicio de sus clientes. Le da la bienvenida a su restaurante, que ofrece productos frescos y caseros."
    ],
    "nl": [
      "Al meer dan 20 jaar stelt Didier Giron al zijn passie voor het slagersvak ten dienste van zijn klanten. Hij heet u welkom in zijn restaurant met verse, zelfgemaakte producten."
    ]
  },
