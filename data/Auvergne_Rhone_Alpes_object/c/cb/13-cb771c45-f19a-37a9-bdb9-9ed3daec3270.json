  "rdfs:comment": {
    "de": [
      "Sébastien und sein Team heißen Sie in ihrem Lokal willkommen, wo Sie Pizzas und italienische Spezialitäten genießen können, die sie selbst zubereiten. Tagesmenü von Dienstag bis Freitag mittags. Vor Ort und zum Mitnehmen von Dienstag bis Samstag."
    ],
    "en": [
      "Sébastien and his team welcome you in their establishment to taste pizzas and Italian specialities, prepared by their care. Daily menu from Tuesday to Friday for lunch. On the spot and to go from Tuesday to Saturday."
    ],
    "it": [
      "Sébastien e il suo team vi danno il benvenuto nel loro locale per gustare pizze e specialità italiane, preparate da loro. Menu giornaliero da martedì a venerdì a pranzo. Sul posto e da asporto dal martedì al sabato."
    ],
    "fr": [
      "Sébastien et son équipe vous accueillent dans leur établissement pour déguster pizzas et spécialités italiennes, préparées par leurs soins. Menu du jour du mardi au vendredi midi. Sur place et à emporter du mardi au samedi."
    ],
    "es": [
      "Sébastien y su equipo le dan la bienvenida a su establecimiento para disfrutar de pizzas y especialidades italianas, preparadas por ellos mismos. Menú del día de martes a viernes al mediodía. En el acto y para llevar de martes a sábado."
    ],
    "nl": [
      "Sébastien en zijn team heten u welkom in hun zaak om te genieten van pizza's en Italiaanse specialiteiten, door henzelf bereid. Dagmenu van dinsdag tot vrijdagmiddag. Ter plaatse en om mee te nemen van dinsdag tot zaterdag."
    ]
  },
  "rdfs:label": {
    "en": [
      "Restaurant L'Origan"
    ],
    "fr": [
      "L'Origan"
    ]
  },
