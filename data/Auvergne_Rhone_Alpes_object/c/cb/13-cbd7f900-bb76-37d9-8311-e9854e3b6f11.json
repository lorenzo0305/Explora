  "rdfs:comment": {
    "de": [
      "Fliegen Sie mit dem Gleitschirm vor dem schönsten Panorama auf den Mont Blanc. Airmania bietet Tandemtaufen für Anfänger von 5 bis 90 Jahren und Kurse, in denen Sie lernen können, alleine zu fliegen."
    ],
    "en": [
      "Fly your paraglider in front of the most beautiful panorama of Mont Blanc. Airmania offers tandem first flights for novices from 5 to 90 years old, as well as courses to help you learn to fly on your own."
    ],
    "it": [
      "Alzate i cieli in parapendio con la più bella vista panoramica sul Monte Bianco. Airmania offre primi voli in tandem per principianti dai 5 ai 90 anni e corsi per imparare a volare da soli."
    ],
    "fr": [
      "Volez en parapente face au plus beau panorama sur le Mont Blanc. Airmania propose des baptêmes en biplace pour les novices de 5 à 90 ans et des stages pour apprendre à voler seul."
    ],
    "es": [
      "Vuele en parapente frente al panorama más bello del Mont Blanc. Airmania ofrece bautizos en biplaza para los novatos de 5 a 90 años y cursos para aprender a volar solo."
    ],
    "nl": [
      "Ga de lucht in met een paraglider met het mooiste panoramische uitzicht op de Mont Blanc. Airmania biedt eerste tandemvluchten voor beginners van 5 tot 90 jaar en cursussen om zelfstandig te leren vliegen."
    ]
  },
