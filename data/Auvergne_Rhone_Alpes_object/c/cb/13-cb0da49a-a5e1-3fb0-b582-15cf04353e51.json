  "rdfs:comment": {
    "de": [
      "2 Hektar große Wasserfläche am Rande des Waldes von Tronçais.\r\nAngeln mit Tageskarte (Gemeindekarte oder spezielle Karte für den Wasserplan zum Angeln). Wochenkarte für Camper."
    ],
    "en": [
      "2-hectare lake bordering the Tronçais forest.\r\nFishing with day pass (carte communale or specific fishing pass for the lake). Week pass for campers."
    ],
    "it": [
      "Lago di 2 ettari ai margini della foresta di Tronçais.\r\nPesca con tessera giornaliera (tessera comunale o tessera di pesca specifica per il lago). Tessera settimanale per i campeggiatori."
    ],
    "fr": [
      "Plan d'eau de 2 hectares en bordure de forêt de Tronçais. \r\nPêche avec carte journée (carte communale ou carte spécifique au plan d'eau pour pêcher). Carte semaine pour les campeurs."
    ],
    "nl": [
      "Meer van 2 hectare aan de rand van het bos van Tronçais.\r\nVissen met dagpas (gemeentepas of specifieke vispas voor het meer). Weekpas voor kampeerders."
    ],
    "es": [
      "Lago de 2 hectáreas al borde del bosque de Tronçais.\r\nPesca con un pase de un día (pase comunal o pase de pesca específico para el lago). Pase semanal para los campistas."
    ]
  },
