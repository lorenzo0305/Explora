  "rdfs:comment": {
    "de": [
      "Spezieller Abend \"10 Jahre Comptoir des Légendes du Ski\".\r\nIn einer Vintage-Atmosphäre, Riesenslalom der Legenden, Treffen von Champions, Vorführungen, Fackelabfahrt, Aperitif und Abendessen für alle!"
    ],
    "en": [
      "Special evening \"The 10 years of the Comptoir des Légendes du Ski\". In a vintage atmosphere, giant slalom of the Legends, champion meetings, demonstrations, torchlight descent, aperitif dinner...open to all!"
    ],
    "it": [
      "Serata speciale: \"10 anni del Comptoir des Légendes du Ski\".\r\nIn un'atmosfera vintage, Slalom Gigante delle Leggende, incontri con i campioni, dimostrazioni, discesa in fiaccolata, aperitivo e cena aperta a tutti!"
    ],
    "fr": [
      "Soirée spéciale \"Les 10 ans du Comptoir des Légendes du Ski \". \r\nDans une ambiance vintage, Slalom géant des Légendes, rencontres de champions, démonstrations, descente aux flambeaux, apéritif dînatoire ouvert à tous !"
    ],
    "es": [
      "Velada especial: \"10 años del Comptoir des Légendes du Ski\".\r\nEn un ambiente vintage, Slalom Gigante de las Leyendas, encuentros con campeones, demostraciones, descenso con antorchas, aperitivo y cena ¡abierta a todos!"
    ],
    "nl": [
      "Speciale avond: \"10 jaar Comptoir des Légendes du Ski\".\r\nIn een vintage sfeer, Reuzenslalom van de Legendes, ontmoetingen met kampioenen, demonstraties, fakkelafdaling, aperitief en diner open voor iedereen!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Slalom géant des Légendes"
    ]
  },
