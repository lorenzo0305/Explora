  "rdfs:comment": {
    "de": [
      "Das Spa Lou Capitelle befindet sich in Vogüé in der südlichen Ardèche. Genießen Sie eine entspannende und wohltuende Auszeit inmitten einer außergewöhnlichen Naturkulisse: beheiztes Balneoschwimmbad, seine zwei Kräuterteezimmer, Sauna, Hammam und Behandlungsräume."
    ],
    "en": [
      "The SPA Lou Capitelle welcomes you to Vogüé in southern Ardèche. Treat yourself to a relaxing & cocooning break in the heart of a 400m² space entirely dedicated to well-being: heated spa pool, hammam, sauna, herbal tea room & treatment cabins."
    ],
    "it": [
      "La SPA Lou Capitelle vi accoglie a Vogüé, nel sud dell'Ardèche. Concedetevi una pausa rilassante e rigenerante nel cuore di uno spazio di 400 m² interamente dedicato al benessere: piscina riscaldata per la balneoterapia, hammam, sauna, tisaneria e sale per trattamenti."
    ],
    "fr": [
      "Le SPA Lou Capitelle vous accueille à Vogüé en Ardèche méridionale. Offrez-vous une pause détente & cocooning au cœur d'un espace de 400m² entièrement dédié au bien-être : piscine balnéo chauffée, hammam, sauna, tisanerie & cabines de soins."
    ],
    "nl": [
      "Lou Capitelle Spa ligt in Vogüé in het zuiden van de Ardèche. Geniet van een ontspannen vakantie en welzijn in het hart van een uitzonderlijke natuurlijke omgeving: Verwarmd spa-zwembad, twee thee-salons, sauna, stoombad en behandelkamers."
    ],
    "es": [
      "El SPA Lou Capitelle le da la bienvenida a Vogüé, en el sur de Ardèche. Regálese una pausa relajante y reconfortante en el corazón de un espacio de 400 m² totalmente dedicado al bienestar: piscina climatizada de balneoterapia, hammam, sauna, sala de tisanas y salas de tratamientos."
    ]
  },
