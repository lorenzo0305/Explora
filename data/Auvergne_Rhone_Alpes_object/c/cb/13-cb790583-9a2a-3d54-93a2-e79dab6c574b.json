  "rdfs:comment": {
    "de": [
      "Wie spricht man über psychische Krankheiten? Nach Fuck Me und Love Me vervollständigt Kill Me den autofiktionalen Zyklus der argentinischen Regisseurin und Choreographin Marina Otero."
    ],
    "en": [
      "How do you talk about mental illness? After Fuck Me and Love Me, Kill Me completes the autofictional cycle of Argentine director and choreographer Marina Otero."
    ],
    "it": [
      "Come si parla di malattia mentale? Dopo Fuck Me e Love Me, Kill Me completa il ciclo di autofiction della regista e coreografa argentina Marina Otero."
    ],
    "fr": [
      "Comment parler de maladie mentale? Après Fuck Me et Love Me, Kill Me complète le cycle autofictionnel de la metteuse en scène et chorégraphie argentin Marina Otero."
    ],
    "es": [
      "¿Cómo se habla de las enfermedades mentales? Después de Fóllame y Quiéreme, Mátame completa el ciclo autoficcional de la directora y coreógrafa argentina Marina Otero."
    ],
    "nl": [
      "Hoe praat je over geestesziekten? Na Fuck Me en Love Me voltooit Kill Me de autofictionele cyclus van de Argentijnse regisseur en choreograaf Marina Otero."
    ]
  },
