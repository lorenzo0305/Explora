  "rdfs:comment": {
    "de": [
      "Am Fuße des Anfängersektors von Planay wird der Passenger Ihre Ohren und Ihren Gaumen erfreuen. Schnellrestaurants mit lokalen Produkten, vor Ort oder zum Mitnehmen. Burger, Paninis, Crêpes-Snacks und Glühwein. Gesellige Après-Ski-Bar."
    ],
    "en": [
      "Takeaway, bar, wifi and crepes. Down the beginners Planay's area, the restaurant \"The Passenger\" will delight you. Eco-friendly snack, local products, on site or just takeaway. Taste crepes, warm drinks or mulled wine."
    ],
    "it": [
      "Ai piedi del settore dei principianti di Planay, il Passenger delizierà le vostre orecchie e le vostre papille gustative. Fast food con prodotti locali, sul posto o da asporto. Hamburger, panini, crêpe e vin brulé. Bar accogliente per il doposci."
    ],
    "fr": [
      "Au pied du secteur débutant du Planay, le Passenger saura ravir vos oreilles et vos papilles. Restauration rapide avec des produits locaux, sur place ou à emporter. Burgers, Paninis, goûter crêpes et vin chaud. Bar après-ski convivial."
    ],
    "es": [
      "Al pie del sector de principiantes de Planay, el Passenger hará las delicias de sus oídos y papilas gustativas. Comida rápida con productos locales, en el mismo local o para llevar. Hamburguesas, paninis, crêpes y vino caliente. Agradable bar après-ski."
    ],
    "nl": [
      "Afhaalmaaltijden, bar, wifi en pannenkoeken. In het gebied van beginners Planay zal het restaurant \"The Passenger\" u verrassen. Milieuvriendelijke snack, lokale producten, ter plaatse of gewoon afhalen. Proef pannenkoeken, warme dranken of glühwein."
    ]
  },
  "rdfs:label": {
    "en": [
      "The Passenger"
    ],
