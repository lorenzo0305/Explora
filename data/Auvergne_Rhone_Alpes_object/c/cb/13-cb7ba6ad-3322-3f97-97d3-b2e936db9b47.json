  "rdfs:comment": {
    "de": [
      "Traditionelle französische Brasserie im historischen Zentrum von Romans-sur-Seine.\r\nRomans-sur-Isère seit 1981, berühmt für seine wunderbaren hausgemachten Bistro-Gerichte, seine Ravioli aller Art und seinen provenzalischen Markt am Sonntagmorgen (Austern auf der Terrasse!)."
    ],
    "en": [
      "Since 1981, Au Petit Maxime is an informal, neighborhood rendez-vous serving a traditional french brasserie menu from breakfast to morning coffee through to lunch and mid-afternoon snacks. \r\nIt is located at the heart of the historic center, in front of St Barnard’s collegiate."
    ],
    "it": [
      "Brasserie tradizionale francese situata nel centro storico di Romans-sur-Isère\r\nRomans-sur-Isère dal 1981, rinomato per i suoi meravigliosi piatti da bistrot fatti in casa, i suoi ravioles di tutti i tipi e il suo mercato provenzale della domenica mattina (ostriche in terrazza!)"
    ],
    "fr": [
      "Brasserie Française traditionnelle située dans le Centre Historique de \r\nRomans-sur-Isère depuis 1981, réputée pour ses merveilleux plats bistrotiers fait maison, ses ravioles en tous genres et son Marché Provencal du Dimanche matin (huitres en terrasse!)"
    ],
    "nl": [
      "Traditionele Franse brasserie gelegen in het historische centrum van Romans-sur-Isère sinds\nRomans-sur-Isère sinds 1981, bekend om zijn heerlijke huisgemaakte bistrogerechten, allerlei soorten ravioli en de Provençaalse markt op zondagochtend (oesters op het terras!)"
    ],
    "es": [
      "Brasserie tradicional francesa situada en el centro histórico de Romans-sur-Isère\r\nRomans-sur-Isère desde 1981, conocido por sus maravillosos platos caseros de bistró, sus ravioles de todo tipo y su mercado provenzal de los domingos por la mañana (¡ostras en la terraza!)"
    ]
  },
  "rdfs:label": {
    "en": [
