  "rdfs:comment": {
    "de": [
      "Höhenrestaurant, Selbstbedienungsrestaurant, im Winter 7/7Tage geöffnet\r\nMittwoch- und Freitagabend auf Reservierung, Gruppenempfang\r\nAuch im Sommer geöffnet\r\nZugang für Skifahrer und Fußgänger."
    ],
    "en": [
      "Self-service mountain restaurant, open every day in winter. Thursday and Friday evenings on reservation, groups catered for."
    ],
    "it": [
      "Ristorante d'alta quota, self service, aperto 7 giorni su 7 in inverno\r\nMercoledì e venerdì sera su prenotazione, ricevimenti di gruppo\r\nAperto in estate\r\nAccesso sciistico e pedonale."
    ],
    "fr": [
      "Restaurant d'altitude, self service, ouverture l'hiver 7/7J. \r\nSoirée mercredi et vendredi sur réservation, réception de groupe. \r\nOuvert l'été. \r\nAccès skieurs et piétons."
    ],
    "es": [
      "Restaurante de altura, autoservicio, abierto los 7 días de la semana en invierno\r\nMiércoles y viernes por la noche, con reserva previa, recepciones de grupos\r\nAbierto en verano\r\nAcceso para esquiadores y peatones."
    ],
    "nl": [
      "Hooggelegen restaurant, zelfbediening, in de winter 7 dagen per week geopend\r\nWoensdag- en vrijdagavond op reservering, groepsrecepties\r\nOpen in de zomer\r\nToegang voor skiërs en voetgangers."
    ]
