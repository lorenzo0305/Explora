  "rdfs:comment": {
    "de": [
      "Das Ibis Lyon Est Bron befindet sich am östlichen Stadtrand von Lyon, in Bron, nur 15 Minuten mit dem Taxi vom Flughafen Lyon Saint-Exupéry entfernt. Das Hotel ist ideal für Geschäfts- und Urlaubsreisen. Es verfügt über 100 klimatisierte Zimmer mit dem Komfort von \"Sweet Bed By Ibis\"-Betten."
    ],
    "en": [
      "The ibis Lyon Est Bron hotel is located in Bron on the eastern edge of Lyon, 15 minutes by taxi from Lyon Saint-Exupéry Airport. Ideal for business trips or vacations, our hotel has 100 air-conditioned rooms equipped with Sweet Bed by ibis bedding."
    ],
    "it": [
      "Il nostro hotel ti riceve in un ambiente accogliente, moderno e dotato di tutti i comfort. Ti sentirai come a casa tua."
    ],
    "fr": [
      "L'Ibis Lyon Est Bron est situé porte Est de Lyon, à Bron, à 15 minutes en taxi de l'aéroport Lyon Saint-Exupéry. Idéal pour vos déplacements affaires ou loisirs, l'hôtel dispose de 100 chambres climatisées, avec confort de literie « Sweet Bed By Ibis »."
    ],
    "nl": [
      "Het Ibis Lyon Est Bron ligt aan de oostelijke poort van Lyon, in Bron, op 15 minuten met de taxi van de luchthaven Lyon Saint-Exupéry. Het hotel is ideaal voor uw zaken- of vakantiereizen en beschikt over 100 kamers met airconditioning en \"Sweet Bed By Ibis\"-beddengoed."
    ],
    "es": [
      "Este hotel ofrece un entorno cálido, moderno y cómodo. Para que nuestros clientes se sientan como en casa."
    ]
  },
