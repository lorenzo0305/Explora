  "rdfs:comment": {
    "de": [
      "DIE SUBLIME ÄRA DER GEIGE IM 18. Jahrhundert\r\nVirtuosität, Sensibilität und Musikalität stehen auf dem Programm dieses Recitals von Nicolas Dautricourt, einem der brillantesten und einnehmendsten französischen Violinisten seiner Zeit\r\ngeneration."
    ],
    "en": [
      "The sublime era of the violin in the 18th century\r\nVirtuosity, sensitivity and musicality are the hallmarks of this recital by Nicolas Dautricourt, one of the most brilliant and engaging French violinists of his generation\r\nof his generation."
    ],
    "it": [
      "IL PERIODO SUBLIME DEL VIOLINO NEL XVIII SECOLO\r\nVirtuosismo, sensibilità e musicalità sono le caratteristiche di questo recital di Nicolas Dautricourt, uno dei violinisti francesi più brillanti e coinvolgenti della sua generazione\r\ndella sua generazione."
    ],
    "fr": [
      "LA SUBLIME ÉPOQUE DU VIOLON AU XVIIIe siècle\r\nVirtuosité, sensibilité, musicalité au programme de ce récital proposé par Nicolas Dautricourt, l’un des violonistes français les plus brillants et attachants de sa\r\ngénération."
    ],
    "es": [
      "LA ÉPOCA SUBLIME DEL VIOLÍN EN EL SIGLO XVIII\r\nVirtuosismo, sensibilidad y musicalidad son las señas de identidad de este recital de Nicolas Dautricourt, uno de los violinistas franceses más brillantes y atractivos de su generación\r\nde su generación."
    ],
    "nl": [
      "DE SUBLIME PERIODE VAN DE VIOLIN IN DE 18e Eeuw\r\nVirtuositeit, gevoeligheid en muzikaliteit zijn de kenmerken van dit recital door Nicolas Dautricourt, een van de meest briljante en innemende Franse violisten van zijn generatie\r\nvan zijn generatie."
    ]
  },
