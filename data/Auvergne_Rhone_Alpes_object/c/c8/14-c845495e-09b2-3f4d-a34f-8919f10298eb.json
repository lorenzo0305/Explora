      "dc:description": {
        "de": [
          "SUPER LOTO in Fruges\nSamstag, den 15. März\norganisiert vom Edison Café und dem Comité de la Saint-Gilliet\nLotto zu Gunsten der Parade von Saint-Gilliet!"
        ],
        "en": [
          "SUPER LOTO in Fruges\nSaturday March 15th\norganized by Edison Café and Comité de la Saint-Gilliet\nLotto in aid of the Défilé de la Saint-Gilliet!"
        ],
        "it": [
          "SUPER LOTO a Fruges\nSabato 15 marzo\norganizzato dall'Edison Café e dal Comitato di Saint-Gilliet\nLotto a favore della parata di Saint-Gilliet!"
        ],
        "fr": [
          "SUPER LOTO à Fruges\nSamedi 15 mars\norganisé par l'Edison Café et le Comité de la Saint-Gilliet\nLoto au profit du Défilé de la Saint-Gilliet !"
        ],
        "nl": [
          "SUPER LOTO in Fruges\nZaterdag 15 maart\ngeorganiseerd door het Edison Café en het Comité de la Saint-Gilliet\nLotto ten voordele van de Sint-Gillietenparade!"
        ],
        "es": [
          "SUPER LOTO en Fruges\nSábado 15 de marzo\norganizado por el Café Edison y el Comité de la Saint-Gilliet\nLotería a beneficio del desfile de Saint-Gilliet"
        ]
      },
