  "rdfs:comment": {
    "de": [
      "Gemütliches französisches Restaurant mit Klimaanlage und Terrasse, das eine abwechslungsreiche traditionelle Küche aus der Auvergne anbietet, die mit frischen Produkten von lokalen Erzeugern zubereitet wird. Pizzas aus dem Holzofen. Ebenerdig gelegener Betrieb und angrenzender Parkplatz."
    ],
    "en": [
      "Cosy French restaurant with air conditioning and terrace offering a varied traditional cuisine from Auvergne, all prepared with fresh produce from local producers. Pizzas on wood fire. Establishment and adjoining car park on the same level."
    ],
    "it": [
      "Accogliente ristorante francese con aria condizionata e terrazza che offre una varietà di piatti della cucina tradizionale dell'Alvernia, tutti preparati con prodotti freschi provenienti da produttori locali. Pizze cotte a legna. Il ristorante dispone di un parcheggio pianeggiante."
    ],
    "fr": [
      "Restaurant français cosy avec climatisation et terrasse proposant une cuisine traditionnelle variée d'Auvergne, le tout élaboré avec des produits frais issus de producteurs locaux. Pizzas au feu de bois. Établissement et parking attenant de plain-pied."
    ],
    "nl": [
      "Gezellig Frans restaurant met airconditioning en terras met een verscheidenheid aan traditionele gerechten uit de Auvergne, allemaal bereid met verse producten van lokale producenten. Houtgestookte pizza's. Het restaurant heeft een vlakke parkeerplaats."
    ],
    "es": [
      "Acogedor restaurante francés con aire acondicionado y terraza que ofrece una variedad de cocina tradicional de Auvernia, todo preparado con productos frescos de los productores locales. Pizzas al horno de leña. El restaurante dispone de un aparcamiento a nivel del suelo."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Chapeau Rouge"
    ]
  },
