  "rdfs:comment": {
    "de": [
      "Rutschvergnügen auf einer abgesicherten, schienengeführten Bahn. 400 m Abfahrt durch den Wald."
    ],
    "en": [
      "The sensations of sledging in complete security on a toboggan specially fitted onto rails. Toboggan down the 400 m slope through the forest."
    ],
    "it": [
      "Mettetevi comodi e lasciatevi trasportare: 400 metri di velocità in discesa nel cuore della foresta, su uno slittino su rotaie. Un'attività sicura, accessibile ed emozionante da condividere con la famiglia e gli amici."
    ],
    "fr": [
      "Installez-vous confortablement et laissez-vous emporter : 400 mètres de descente à toute vitesse au cœur de la forêt, sur une luge sur rails. Une activité sécurisée, accessible et pleine de sensations, à partager en famille ou entre amis."
    ],
    "es": [
      "Póngase cómodo y déjese llevar: 400 metros de descenso a toda velocidad en pleno bosque, en un tobogán sobre raíles. Una actividad segura, accesible y emocionante para compartir con la familia y los amigos."
    ],
    "nl": [
      "Maak het jezelf gemakkelijk en laat je meevoeren: 400 meter snelheid bergafwaarts in het hart van het bos, op een slee op rails. Een veilige, toegankelijke en spannende activiteit om te delen met familie en vrienden."
    ]
  },
  "rdfs:label": {
    "de": [
      "Sommerrodelbahn \"Déval'luge\""
    ],
    "en": [
      "Sledging “Deval’luge”"
    ],
    "fr": [
      "Déval'luge"
    ]
  },
