  "rdfs:comment": {
    "de": [
      "Die Pow Grayon Ranch bietet eine einzigartige Westernkulisse. Geführte Reitausflüge, Übernachtungs- oder Etappenunterkünfte und gesellige Mahlzeiten. Zwischen majestätischen Landschaften und einer herzlichen Atmosphäre ist ein totaler Tapetenwechsel für Groß und Klein garantiert."
    ],
    "en": [
      "Ranch Pow Grayon offers a unique western setting. Guided horseback outings, self-catering or overnight stays, and convivial meals. With its majestic landscapes and warm atmosphere, it's a complete change of scenery for young and old alike."
    ],
    "it": [
      "Il Ranch Pow Grayon offre un ambiente western unico. Escursioni guidate a cavallo, sistemazioni con angolo cottura e pasti cordiali. Con i suoi paesaggi maestosi e la sua calda atmosfera, è un completo cambiamento di scenario per grandi e piccini."
    ],
    "fr": [
      "Le Ranch Pow Grayon, offre un cadre western unique. Sorties équestres guidées, gîte de séjour ou d’étape, et repas conviviaux. Entre paysages majestueux et ambiance chaleureuse, un dépaysement total est assuré pour petits et grands."
    ],
    "es": [
      "Ranch Pow Grayon ofrece un entorno único en el oeste. Salidas guiadas a caballo, alojamiento con cocina y comidas acogedoras. Con su majestuoso paisaje y su cálido ambiente, es un completo cambio de aires para grandes y pequeños."
    ],
    "nl": [
      "Ranch Pow Grayon biedt een unieke westernomgeving. Begeleide paardrijtochten, self-catering accommodatie en gezellige maaltijden. Met zijn majestueuze landschap en warme sfeer is het een complete verandering van omgeving voor jong en oud."
    ]
  },
