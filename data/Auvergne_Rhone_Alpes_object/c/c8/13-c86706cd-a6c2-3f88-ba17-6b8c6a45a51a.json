  "rdfs:comment": {
    "de": [
      "Der ideale City Break.\r\nKleines Familienhotel mit einfachen und gepflegten Zimmern im Herzen des Stadtzentrums.\r\nGroßer öffentlicher Parkplatz 50m von der Unterkunft entfernt.\r\nHausgemachtes Frühstück, das im Sommer im Garten serviert wird."
    ],
    "en": [
      "Small family hotel, simple and charming rooms on the road side and on the courtyard. Big public car park at 50 m. Different formulas of breakfast. Brunch at weekend."
    ],
    "it": [
      "La vacanza ideale in città.\r\nPiccolo hotel a conduzione familiare con camere semplici e ordinate nel cuore del centro città.\r\nAmpio parcheggio pubblico a 50 m dall'hotel.\r\nColazione fatta in casa servita in giardino in estate"
    ],
    "fr": [
      "Le City Break idéal.\r\nPetit hôtel familial aux chambres simples et soignées au coeur du centre ville.\r\nGrand parking public à 50m de l’établissement.\r\nPetit-déjeuner maison servi dans le jardin en été"
    ],
    "es": [
      "La escapada urbana ideal.\r\nPequeño hotel familiar con habitaciones sencillas y cuidadas en pleno centro de la ciudad.\r\nAmplio aparcamiento público a 50 metros del hotel.\r\nDesayuno casero servido en el jardín en verano"
    ],
    "nl": [
      "De ideale citytrip.\r\nKlein familiaal hotel met eenvoudige, nette kamers in het hart van het stadscentrum.\r\nGrote openbare parkeerplaats op 50m van het hotel.\r\nHuisgemaakt ontbijt geserveerd in de tuin in de zomer.\r\nTerras."
    ]
  },
