  "rdfs:comment": {
    "de": [
      "Nicole und Jacques bieten Ihnen ein einzigartiges Erlebnis in der Ardèche: 2-stündiger Ausritt mit Abfahrt in den Fluss auf 1 km Länge für alle Niveaus ab 10 Jahren. Pony-Taufen von 2 bis 9 Jahren."
    ],
    "en": [
      "Nicole and Jacques offer you a unique experience in the Ardèche: 2-hour horseback ride with a 1 km river descent for all levels from age 10. Pony baptisms for ages 2 to 9."
    ],
    "it": [
      "Nicole e Jacques vi propongono un'esperienza unica nell'Ardèche: una passeggiata a cavallo di 2 ore con discesa di 1 km nel fiume per tutti i livelli, dai 10 anni in su. Introduzione ai pony dai 2 ai 9 anni."
    ],
    "fr": [
      "Nicole et Jacques vous proposent une expérience unique en Ardèche  : Promenade à cheval de 2h avec descente dans la rivière sur 1 km de long pour tous niveaux à partir de 10 ans. Baptêmes poneys de 2 à 9 ans."
    ],
    "es": [
      "Nicole y Jacques le proponen una experiencia única en Ardèche: un paseo a caballo de 2 horas con un descenso de 1 km por el río para todos los niveles a partir de 10 años. Iniciación a los ponis de 2 a 9 años."
    ],
    "nl": [
      "Nicole en Jacques bieden je een unieke ervaring in de Ardèche: een 2 uur durende paardrijtocht met een afdaling van 1 km in de rivier voor alle niveaus vanaf 10 jaar. Kennismaking met pony's van 2 tot 9 jaar."
    ]
  },
