  "rdfs:comment": {
    "de": [
      "In einer außergewöhnlichen Umgebung ist der Landgasthof Le Mollard in einem alten Dombiste-Bauernhof untergebracht. Die Auberge empfängt nach Voranmeldung unter der Woche Gruppen ab 10 Personen und ist an allen Wochenenden geöffnet."
    ],
    "en": [
      "In an exceptional setting, the Mollard country inn is housed in an old Dombist farmhouse. The inn welcomes groups of 10 people or more by reservation during the week and is open every weekend."
    ],
    "it": [
      "In un contesto eccezionale, la locanda di campagna Mollard è ospitata in un'antica casa colonica di Dombist. La locanda accoglie gruppi di almeno 10 persone nei giorni feriali ed è aperta tutti i fine settimana."
    ],
    "fr": [
      "Dans un cadre exceptionnel, l’auberge de campagne du Mollard est aménagée dans une ancienne ferme dombiste. L'auberge accueille sur réservation en semaine, les groupes à partir de 10 personnes, elle est ouverte toutes les fins de semaine."
    ],
    "es": [
      "En un entorno excepcional, la posada Mollard se encuentra en una antigua granja dombista. La posada acoge a grupos de 10 personas o más entre semana y está abierta todos los fines de semana."
    ],
    "nl": [
      "De plattelandsherberg Mollard ligt in een uitzonderlijke omgeving en is gevestigd in een oude Dombistaanse boerderij. De herberg verwelkomt groepen vanaf 10 personen op weekdagen en is elk weekend geopend."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Auberge de campagne du Mollard"
    ]
  },
