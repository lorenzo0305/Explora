  "rdfs:comment": {
    "de": [
      "Mit Freunden oder der Familie können Sie den Nervenkitzel des Paintball in einer außergewöhnlichen Umgebung auskosten: ein wunderschöner Wald, der zu einem atypischen Freizeitbereich umgestaltet wurde. Für alle ab 16 Jahren zugänglich."
    ],
    "en": [
      "Come and share the joys of paintball fever with friends and family in an exceptional setting: a magnificent forest adapted to create this unusual recreational centre. You must be at least 16 to play."
    ],
    "it": [
      "Con gli amici o la famiglia, godetevi il brivido del paintball in un contesto eccezionale: una magnifica foresta adattata a zona ricreativa atipica. Accessibile a tutti a partire dai 16 anni."
    ],
    "fr": [
      "Entre amis ou en famille, goûtez aux frissons du paintball dans un cadre exceptionnal : une magnifique forêt adaptée en espace récréatif atypique. Accessible à tous à partir de 16 ans révolus."
    ],
    "nl": [
      "Geniet met vrienden of familie van de kick van paintball in een uitzonderlijk kader: een prachtig bos dat is aangepast als atypisch recreatiegebied. Toegankelijk voor iedereen vanaf 16 jaar."
    ],
    "es": [
      "Con los amigos o la familia, disfrute de la emoción del paintball en un entorno excepcional: un magnífico bosque adaptado como área recreativa atípica. Accesible para todos a partir de los 16 años."
    ]
  },
  "rdfs:label": {
    "en": [
      "Cible et Nature, paintball fun and nature"
    ],
    "fr": [
      "Paintball Cible et nature"
    ]
  },
