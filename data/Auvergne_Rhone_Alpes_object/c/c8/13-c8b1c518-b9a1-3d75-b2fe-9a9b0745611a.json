  "rdfs:comment": {
    "de": [
      "Entfliehen Sie mit Acvride in die Auvergne: Entdecken Sie atemberaubende Landschaften an Bord unserer SSV-Buggys. Abenteuer\r\nund Sensationen sind garantiert und sorgen für ein unvergessliches Erlebnis. Buchen Sie Ihr Abenteuer jetzt!"
    ],
    "en": [
      "Escape to Auvergne with Acvride: discover breathtaking landscapes aboard our SSV Buggies. Adventure\r\nfor an unforgettable experience. Book your adventure now!"
    ],
    "it": [
      "Fuga in Alvernia con Acvride: scoprite paesaggi mozzafiato a bordo dei nostri SSV Buggies. Avventura\r\ne brividi garantiti per un'esperienza indimenticabile. Prenotate subito la vostra avventura!"
    ],
    "fr": [
      "Évadez-vous en Auvergne avec Acvride : découvrez des paysages époustouflants à bord de nos Buggy SSV. Aventure\r\net sensations garanties pour une expérience inoubliable. Réservez votre aventure dès maintenant !"
    ],
    "nl": [
      "Ontsnap naar de Auvergne met Acvride: ontdek adembenemende landschappen aan boord van onze SSV Buggy's. Avontuur\r\nen sensatie gegarandeerd voor een onvergetelijke ervaring. Boek nu uw avontuur!"
    ],
    "es": [
      "Escápate a Auvernia con Acvride: descubre paisajes impresionantes a bordo de nuestros Buggies SSV. Aventura\r\naventura y emoción garantizadas para una experiencia inolvidable. ¡Reserve ya su aventura!"
    ]
  },
  "rdfs:label": {
