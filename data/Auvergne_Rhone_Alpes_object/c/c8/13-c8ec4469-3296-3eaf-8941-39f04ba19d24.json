          "additionalInformation": {
            "de": [
              "Donnerstags Konzertabend mit Thementeller auf Vorbestellung\r\nIm Sommer täglich vom Frühstück bis zum Abendessen, mit Snacks, Eis, Waffeln, Bar und Restaurant"
            ],
            "en": [
              "Thursday concert evenings with themed dishes on reservation\r\nEvery day in summer from breakfast to dinner, with snack, ice cream, waffles, bar and restaurant"
            ],
            "it": [
              "Giovedì sera concerto con piatti a tema su prenotazione\r\nTutti i giorni d'estate dalla colazione alla cena, con spuntini, gelati, cialde, bar e ristorante"
            ],
            "fr": [
              "Les jeudis soirée concert avec plat à thème sur réservation\r\nTous les jours l'été du petit déjeuner au dîner, avec snack, glaces, gaufres, bar et restaurant"
            ],
            "es": [
              "Los jueves, veladas de conciertos con platos temáticos previa reserva\r\nTodos los días en verano, desde el desayuno hasta la cena, con aperitivos, helados, gofres, bar y restaurante"
            ],
            "nl": [
              "Donderdag concertavonden met themagerechten op reservering\r\nElke dag in de zomer van ontbijt tot diner, met snacks, ijsjes, wafels, bar en restaurant"
            ]
          },
