  "rdfs:comment": {
    "de": [
      "Kreationen aus Porzellan: gedrehte Stücke mit klaren, weichen Linien. Jedes Dekor ist einzigartig, mit Relief, bei dem das Porzellan eine schöne Transluzenz bietet. Ich entwerfe auch Schmuck und Skulpturen. Einzelstücke."
    ],
    "en": [
      "Porcelain creations: turned pieces with clean, soft lines. Each decoration is unique, in relief, where the porcelain offers a beautiful translucence. I also create jewelry and sculptures. One-of-a-kind pieces."
    ],
    "it": [
      "Creazioni in porcellana: pezzi torniti dalle linee pulite e morbide. Ogni decorazione è unica, in rilievo, dove la porcellana offre una bella traslucenza. Creo anche gioielli e sculture. Pezzi unici."
    ],
    "fr": [
      "Créations en porcelaine : pièces tournées, aux lignes épurées et douces. Chaque décor est unique, en relief, où la porcelaine offre une belle translucidité. Je crée également des bijoux et des sculptures. Pièces uniques."
    ],
    "nl": [
      "Creaties van porselein: gedraaide stukken met strakke, zachte lijnen. Elke decoratie is uniek, in reliëf, waarbij het porselein een prachtige doorschijnendheid heeft. Ik maak ook sieraden en sculpturen. Unieke stukken."
    ],
    "es": [
      "Creaciones de porcelana: piezas torneadas de líneas limpias y suaves. Cada decoración es única, en relieve, donde la porcelana ofrece una hermosa translucidez. También creo joyas y esculturas. Piezas únicas."
    ]
  },
