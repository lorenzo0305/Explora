  "rdfs:comment": {
    "de": [
      "Food Truck (fahrender Anhänger): Bio-Restaurants vor Ort und zum Mitnehmen, im Holzofen gebacken. Pizzas, Empanadas, Falafel, Crêpes, vegetarische Fladenbrote, Blätterteiggebäck, Suppen, Salate, Desserts."
    ],
    "en": [
      "Food truck (mobile trailer): organic food to eat in or take away, cooked in a wood-fired oven. Pizzas, empanadas, falafels, crepes, vegetable patties, puff pastries, soups, salads, desserts."
    ],
    "it": [
      "Food truck (rimorchio mobile): cibo biologico da consumare o da portare via, cotto in un forno a legna. Pizze, empanadas, falafel, crêpes, frittelle di verdure, bignè, zuppe, insalate, dessert."
    ],
    "fr": [
      "Food truck (remorque ambulante) : restauration bio sur place et à emporter, cuisson au four à bois. Pizzas, empanadas, falafels, crêpes, galettes végétales, feuilletés, soupes, salades, desserts."
    ],
    "es": [
      "Food truck (remolque móvil): comida ecológica para comer o llevar, cocinada en horno de leña. Pizzas, empanadas, falafels, crepes, tortitas vegetales, hojaldres, sopas, ensaladas, postres."
    ],
    "nl": [
      "Food truck (mobiele trailer): biologisch eten om te eten of om mee te nemen, bereid in een houtoven. Pizza's, empanadas, falafels, crêpes, groentepannenkoeken, bladerdeeg, soepen, salades, desserts."
    ]
  },
