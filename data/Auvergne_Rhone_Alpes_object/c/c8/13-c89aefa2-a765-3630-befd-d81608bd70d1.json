  "rdfs:comment": {
    "de": [
      "Das Skigebiet Col de la Loge verfügt über einen Ausrüstungsverleih.\r\nMöglichkeit, Langlaufausrüstung (alternativ Skifahren oder Skating), Paar Schneeschuhe (Erwachsene und Kinder) sowie Schlitten und Schutzhelme zu mieten."
    ],
    "en": [
      "The Col de la Loge resort has an equipment rental point.\r\nPossibility to rent cross-country ski equipment (alternative skiing or skating), pairs of snowshoes (adult and child), as well as sledges and protective helmets."
    ],
    "it": [
      "Il resort Col de la Loge dispone di un punto di noleggio attrezzature.\r\nÈ possibile noleggiare attrezzature per lo sci di fondo (alternato o skating), paia di racchette da neve (adulti e bambini), nonché slitte e caschi."
    ],
    "fr": [
      "La station du Col de la Loge dispose d’un point de location de matériel.\r\nPossibilité de louer équipements de skis de fond (ski alternatif ou skating), paires de raquettes à neige (adulte et enfant), ainsi que des luges et des casques de protection."
    ],
    "es": [
      "La estación de Col de la Loge dispone de un punto de alquiler de material.\r\nEs posible alquilar equipos de esquí de fondo (alternativo o de patinaje), pares de raquetas de nieve (adultos y niños), así como trineos y cascos."
    ],
    "nl": [
      "Het resort Col de la Loge beschikt over een verhuurpunt voor materiaal.\r\nHet is mogelijk om langlaufmateriaal te huren (afwisselend of skating), paren sneeuwschoenen (volwassenen en kinderen), evenals sleeën en helmen."
    ]
  },
