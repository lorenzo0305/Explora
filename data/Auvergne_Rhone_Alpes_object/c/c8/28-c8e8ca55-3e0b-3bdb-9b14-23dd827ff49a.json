  "rdfs:comment": {
    "de": [
      "Der Bauernhof Pont des Loups führt vor Ort geführte Besichtigungen durch (mit Reservierung), freie Besichtigungen (ohne Reservierung) und bietet vor Ort Verkostungen von Käsebrettern und Flamiche an."
    ],
    "en": [
      "La ferme du pont des loups offers guided tours (booking required), self-guided tours (no booking required) and tastings of cheese boards and flamiche on site."
    ],
    "it": [
      "La fattoria Pont des Loups offre visite guidate (su prenotazione) e autoguidate (senza prenotazione), oltre a degustazioni di formaggi e flamiche in loco."
    ],
    "fr": [
      "La ferme du pont des loups réalise des visites guidées sur place (sur réservation), des visites libres (sans réservation) et propose des dégustations de planches de fromages et flamiche sur place."
    ],
    "es": [
      "La granja de Pont des Loups ofrece visitas guiadas (con reserva previa) y autoguiadas (sin reserva previa), así como degustaciones de queso y flamiche in situ."
    ],
    "nl": [
      "De boerderij Pont des Loups biedt rondleidingen (op afspraak) en rondleidingen op eigen gelegenheid (zonder afspraak), evenals kaas- en flamicheproeverijen ter plaatse."
    ]
  },
