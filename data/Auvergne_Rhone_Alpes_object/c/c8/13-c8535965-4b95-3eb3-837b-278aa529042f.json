  "rdfs:comment": {
    "de": [
      "Brigitte und Denis (Maitres-Restaurateurs) begrüßen Sie im Herzen von Saint François 1650, auf der Terrasse mit Panoramablick auf die Berge oder im gemütlichen Innenbereich."
    ],
    "en": [
      "Brigitte and Denis welcome you to the heart of Saint François 1650, on the terrace with panoramic mountain views or in a cozy interior."
    ],
    "it": [
      "Brigitte e Denis (Maitres-Restaurateurs) vi accolgono nel cuore di Saint François 1650, sulla terrazza con vista panoramica sulle montagne o nell'accogliente interno."
    ],
    "fr": [
      "Brigitte et Denis (Maitres-Restaurateurs) vous accueillent au cœur de Saint François 1650, en terrasse avec vue panoramique sur la montagne ou en intérieur cosy."
    ],
    "es": [
      "Brigitte y Denis (Maitres-Restaurateurs) le dan la bienvenida al corazón de Saint François 1650, en la terraza con vistas panorámicas a la montaña o en el acogedor interior."
    ],
    "nl": [
      "Brigitte en Denis heten je welkom in het hart van Saint François 1650, op het terras met panoramisch uitzicht op de bergen of in het gezellige interieur."
    ]
