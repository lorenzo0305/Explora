  "rdfs:comment": {
    "de": [
      "Der Boardercross an der Ankunft des Sessellifts Petit Vallon ist eine Strecke, die aus Steilkurven, Buckeln und Sprüngen besteht. Diese Piste mit ihrem gezackten Relief kann sowohl mit Skiern als auch mit dem Snowboard befahren werden."
    ],
    "en": [
      "The boardercross from the top of Petit Vallon chairlift is a course made up of banked turns, bumps and jumps. This rugged terrain is passable on skis or snowboard."
    ],
    "it": [
      "Il boardercross all'arrivo della seggiovia Petit Vallon è un percorso di curve a gomito, dossi e salti. È possibile sciare o fare snowboard su questa pista dal terreno accidentato."
    ],
    "fr": [
      "Le boardercross à l'arrivée du télésiège du Petit Vallon est un parcours constitué de virages relevés, de bosses et de sauts. Cette piste au relief tourmenté est praticable en skis ou en snowboard."
    ],
    "es": [
      "El boardercross, a la llegada del telesilla Petit Vallon, es un recorrido de curvas peraltadas, baches y saltos. Se puede esquiar o hacer snowboard en esta pista de terreno accidentado."
    ],
    "nl": [
      "De boardercross aan het einde van de Petit Vallon stoeltjeslift is een parcours met schuine bochten, bulten en sprongen. Je kunt dit parcours met zijn ruige terrein skiën of snowboarden."
    ]
  },
