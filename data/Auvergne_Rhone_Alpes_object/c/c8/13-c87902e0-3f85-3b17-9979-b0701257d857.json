  "rdfs:comment": {
    "de": [
      "Der Clos Saint Marc bewirtschaftet 15 ha Weinberge in der Gemeinde Taluyers. Der Weinkeller befindet sich im Herzen unseres Weinbergs, um Sie zu empfangen und Ihnen unsere Weinpalette vorzustellen: Chardonnay, Gamay, Syrah."
    ],
    "en": [
      "Clos Saint Marc cultivates 15 ha of vines in the commune of Taluyers. The cellar is at the heart of our vineyard, where you can discover our range of wines: Chardonnay, Gamay, Syrah."
    ],
    "it": [
      "Clos Saint Marc coltiva 15 ettari di vigneto nel comune di Taluyers. La cantina si trova nel cuore del nostro vigneto, dove potrete scoprire la nostra gamma di vini: Chardonnay, Gamay e Syrah."
    ],
    "fr": [
      "Le Clos Saint Marc cultive 15 ha de vignes sur la commune de Taluyers. Le caveau se situe au cœur de notre vignoble pour vous accueillir et faire découvrir la gamme de vins : Chardonnay, Gamay, Syrah."
    ],
    "nl": [
      "Clos Saint Marc cultiveert 15 hectare wijngaarden in de gemeente Taluyers. De kelder bevindt zich in het hart van onze wijngaard, waar u ons wijnassortiment kunt ontdekken: Chardonnay, Gamay en Syrah."
    ],
    "es": [
      "Clos Saint Marc cultiva 15 hectáreas de viñedo en el municipio de Taluyers. La bodega se encuentra en el corazón de nuestro viñedo, donde podrá descubrir nuestra gama de vinos: Chardonnay, Gamay y Syrah."
    ]
  },
  "rdfs:label": {
