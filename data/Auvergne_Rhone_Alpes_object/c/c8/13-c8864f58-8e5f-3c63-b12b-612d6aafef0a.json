  "rdfs:comment": {
    "de": [
      "Wir begrüßen Sie in unseren 5 ganzjährig geöffneten Büros (Privas, La Voulte-sur-Rhône, Les Ollières-sur-Eyrieux, Saint-Sauveur-de-Montagut, Vernoux-en-Vivarais) und in unseren 3 saisonalen Büros, die im Juli/August geöffnet sind (Beauchastel, Chalencon und Coux)."
    ],
    "en": [
      "We welcome you in our 4 open year-round desks (Privas, La Voulte-sur-Rhône, Les Ollières-sur-Eyrieux, Vernoux-en-Vivarais) and in our 3 seasonal desks open in July/August (Beauchastel, Chalencon and Saint-Sauveur-de-Montagut)."
    ],
    "it": [
      "Vi diamo il benvenuto nei nostri 5 uffici aperti tutto l'anno (Privas, La Voulte-sur-Rhône, Les Ollières-sur-Eyrieux, Saint-Sauveur-de-Montagut, Vernoux-en-Vivarais) e nei nostri 3 uffici stagionali aperti in luglio/agosto (Beauchastel, Chalencon e Coux)."
    ],
    "fr": [
      "Nous vous accueillons dans nos 5 bureaux ouverts à l'année (Privas, La Voulte-sur-Rhône, Les Ollières-sur-Eyrieux, Saint-Sauveur-de-Montagut, Vernoux-en-Vivarais) et dans nos 3 bureaux saisonniers ouverts en juillet/août (Beauchastel, Chalencon et Coux)."
    ],
    "nl": [
      "We verwelkomen je in onze 5 kantoren die het hele jaar open zijn (Privas, La Voulte-sur-Rhône, Les Ollières-sur-Eyrieux, Saint-Sauveur-de-Montagut, Vernoux-en-Vivarais) en onze 3 seizoenskantoren die in juli/augustus open zijn (Beauchastel, Chalencon en Coux)."
    ],
    "es": [
      "Le damos la bienvenida a nuestras 5 oficinas abiertas todo el año (Privas, La Voulte-sur-Rhône, Les Ollières-sur-Eyrieux, Saint-Sauveur-de-Montagut, Vernoux-en-Vivarais) y a nuestras 3 oficinas de temporada abiertas en julio/agosto (Beauchastel, Chalencon y Coux)."
    ]
  },
