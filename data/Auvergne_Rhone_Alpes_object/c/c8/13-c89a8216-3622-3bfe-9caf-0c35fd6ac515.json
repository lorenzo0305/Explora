  "rdfs:comment": {
    "de": [
      "Das Restaurant befindet sich an der Schneefront von Plagne Soleil und bietet eine große Sonnenterrasse mit Blick auf die Pisten. \r\nDas Lokal bietet eine Brasserie- und Pizzakarte von 11:30 bis 15:00 Uhr und von 18:30 bis 21:30 Uhr.\r\nDer Pub öffnet seine Türen um 16 Uhr bis 1 Uhr."
    ],
    "en": [
      "LE MONICA’S - PLAGNE SOLEIL\r\n Restaurant/bar/pizzeria on the ski slopes\r\n⏰ 9am-2am | ☎️ 04.79.09.21.21 (outside of mealtimes please)\r\nSavoyard specialities, Neapolitan pizzas and quality meat dishes\r\nHappy Hour 4-7pm, DJ sets \r\n Friendly atmosphere & dog-friendly"
    ],
    "it": [
      "LE MONICA?S - PLAGNE SOLEIL\r\n Ristorante/bar/pizzeria di fronte alle piste\r\n9h-2h | 04.79.09.21.21 (evitare il servizio completo)\r\nSpecialità savoiarde, pizze napoletane e carni eccezionali\r\n Happy Hour dalle 16.00 alle 19.00, DJ set\r\n Atmosfera amichevole e adatta ai cani"
    ],
    "fr": [
      "LE MONICA’S - PLAGNE SOLEIL\r\n Resto/bar/pizzeria face aux pistes\r\n⏰ 9h-2h | ☎️ 04.79.09.21.21 (évitez plein service)\r\nSpécialités savoyardes, pizzas napolitaines & viandes d’exception\r\n Happy Hour 16h-19h, DJ set \r\n Ambiance friends & dog-friendly"
    ],
    "es": [
      "LE MONICA?S - PLAGNE SOLEIL\r\n Restaurante/bar/pizzería frente a las pistas\r\n? 9h-2h | ? 04.79.09.21.21 (evitar servicio completo)\r\nEspecialidades saboyanas, pizzas napolitanas y carnes excepcionales\r\n Happy Hour de 16h a 19h, DJ set\r\n Ambiente acogedor y apto para perros"
    ],
    "nl": [
      "LE MONICA'S - PLAGNE SOLEIL\r\n Restaurant/bar/pizzeria met uitzicht op de pistes\r\n⏰ 9h-2h | ☎️ 04.79.09.21.21 (vermijd full service)\r\nSavoyaardse specialiteiten, Napolitaanse pizza's & uitzonderlijke vleeswaren\r\n Happy Hour van 16.00 tot 19.00 uur, DJ-set\r\n Vriendelijke & hondvriendelijke sfeer"
    ]
  },
