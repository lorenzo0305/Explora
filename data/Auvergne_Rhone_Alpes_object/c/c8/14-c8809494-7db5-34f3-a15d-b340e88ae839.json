      "@id": "https://data.datatourisme.fr/41f76fca-84a5-3d82-819e-d7a04aa0d591",
      "dc:description": {
        "de": [
          "Immobilienagentur in Sainte Cécile in der Nähe des Strandes. Verkäufe, saisonale Vermietungen, ganzjährige Vermietungen\nAgentur sonntags geschlossen - Geöffnet von 9h bis 12h30 und von 13h30 bis 17"
        ],
        "en": [
          "Real estate agency located in Sainte Cécile near the beach. Sales, seasonal rentals, year-round rentals\nAgency closed on Sundays - Open from 9am to 12:30pm and from 1:30pm to 5pm"
        ],
        "it": [
          "Agenzia immobiliare situata a Sainte Cécile, vicino alla spiaggia. Vendite, affitti stagionali, affitti per tutto l'anno\nAgenzia chiusa la domenica - Aperta dalle 9.00 alle 12.30 e dalle 13.30 alle 17.00"
        ],
        "fr": [
          "Agence immobilière située à Sainte Cécile à proximité de la plage. Ventes, locations saisonnières, locations à l'année\nAgence fermée le dimanche - Ouvert de 9h à 12h30 et de 13h30 à 17"
        ],
        "nl": [
          "Makelaarskantoor in Sainte Cécile vlakbij het strand. Verkoop, seizoensverhuur, verhuur het hele jaar door\nMakelaar gesloten op zondag - Open van 9.00 tot 12.30 en van 13.30 tot 17.00"
        ],
        "es": [
          "Agencia inmobiliaria situada en Sainte Cécile, cerca de la playa. Ventas, alquileres de temporada, alquileres todo el año\nAgencia cerrada los domingos - Abierto de 9h a 12h30 y de 13h30 a 17h"
        ]
      },
