  "rdfs:comment": {
    "de": [
      "Gönnen Sie sich eine Blase des Wohlbefindens in Ihrem Alltag. Dieser brandneue Raum wurde umgebaut und soll am 3. Juni 2024 wiedereröffnet werden."
    ],
    "en": [
      "Treat yourself to a bubble of well-being in your everyday life. Having been refurbished and reopened on June 3, 2024, this brand-new space welcomes you all year round for moments of well-being."
    ],
    "it": [
      "Concedetevi una bolla di benessere nella vostra vita quotidiana. Ristrutturato e riaperto il 3 giugno 2024, questo nuovissimo spazio vi accoglie tutto l'anno per momenti di benessere."
    ],
    "fr": [
      "Offrez vous une bulle de Bien Être dans votre quotidien. Ayant fait l’objet de travaux d’aménagement avec une réouverture au 3 juin 2024, cet espace flambant neuf vous accueille toute l’année pour des moments de bien-être."
    ],
    "nl": [
      "Trakteer jezelf op een bubbel van welzijn in je dagelijks leven. Deze gloednieuwe ruimte is gerenoveerd en heropend op 3 juni 2024 en verwelkomt je het hele jaar door voor momenten van welzijn."
    ],
    "es": [
      "Regálese una burbuja de bienestar en su vida cotidiana. Reformado y reabierto el 3 de junio de 2024, este flamante espacio le da la bienvenida todo el año para regalarle momentos de bienestar."
    ]
  },
  "rdfs:label": {
    "en": [
      "Wellness area at Ozen"
    ],
    "fr": [
      "SPA Ozen"
    ]
  },
