  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/4391d8fb-5087-3af5-8491-48238e56c881",
      "dc:description": {
        "de": [
          "Besuchen Sie uns im Menadel & St-Hubert, um Kürbisse für Halloween zu dekorieren.\n\nNichts geht verloren, das Fleisch unserer geopferten Kürbisse wird in unserem Kochworkshop verwendet, um köstliche Gerichte zu zaubern."
        ],
        "en": [
          "Join us at Ménadel & St-Hubert to decorate pumpkins for Halloween.\n\nNothing goes to waste: the flesh of our sacrificed pumpkins will be used in our cooking workshop to concoct delicious dishes."
        ],
        "it": [
          "Unisciti a noi a Ménadel & St-Hubert per decorare le zucche per Halloween.\n\nNiente va sprecato: la polpa delle zucche sacrificate sarà utilizzata nel nostro laboratorio di cucina per preparare piatti deliziosi."
        ],
        "fr": [
          "Rejoignez-nous au Ménadel & St-Hubert pour décorer des citrouilles pour Halloween.\n\nRien ne se perd, la chair de nos citrouilles sacrifiées sera utilisée dans notre atelier cuisine pour concocter de délicieux plats."
        ],
        "es": [
          "Únete a nosotros en Ménadel & St-Hubert para decorar calabazas para Halloween.\n\nNada se desperdicia: la carne de nuestras calabazas sacrificadas se utilizará en nuestro taller de cocina para preparar deliciosos platos."
        ],
        "nl": [
          "Kom naar Ménadel & St-Hubert om pompoenen te versieren voor Halloween.\n\nNiets gaat verloren: het vlees van onze opgeofferde pompoenen wordt gebruikt in onze kookworkshop om heerlijke gerechten te maken."
        ]
      },
      "@type": [
        "Description"
      ],
