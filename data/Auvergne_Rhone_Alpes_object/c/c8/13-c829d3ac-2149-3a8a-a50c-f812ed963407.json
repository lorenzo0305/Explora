  "rdfs:comment": {
    "de": [
      "Das in der Gemeinde Brullioles gelegene Château de Charfetain ist ein wunderschönes architektonisches Ensemble aus dem 15. Jahrhundert inmitten eines grünen Parks mit einem historischen Rahmen voller Ruhe und ist ideal für die Organisation Ihrer Veranstaltungen"
    ],
    "en": [
      "Nestled in the commune of Brullioles, Château de Charfetain is a magnificent 15th-century architectural ensemble set in a verdant park with a serene historic setting, ideal for organizing your events"
    ],
    "it": [
      "Situato nel comune di Brullioles, lo Château de Charfetain è un magnifico complesso architettonico del XV secolo immerso in un parco verdeggiante con un ambiente storico sereno, ideale per organizzare i vostri eventi"
    ],
    "fr": [
      "Niché dans la commune de Brullioles, le Château de Charfetain constitue un magnifique ensemble architectural du XVe siècle au sein d’un parc verdoyant doté d’une cadre historique empli de sérénité est idéal pour l’organisation de vos événements"
    ],
    "es": [
      "Enclavado en la comuna de Brullioles, el castillo de Charfetain es un magnífico conjunto arquitectónico del siglo XV situado en un verde parque con un sereno marco histórico, ideal para organizar sus eventos"
    ],
    "nl": [
      "Château de Charfetain, gelegen in de gemeente Brullioles, is een prachtig 15e-eeuws architecturaal geheel in een groen park met een serene historische omgeving, ideaal voor het organiseren van uw evenementen"
    ]
  },
