  "rdfs:comment": {
    "de": [
      "Im nordischen Skigebiet \"le Plateau de l'Arselle\" gelegen. Panoramaterrasse in Südlage. Bezaubernde Landschaft, in der sich die Sanftheit des Ortes auf Glück und Geschmack reimt."
    ],
    "en": [
      "Located on the Plateau de l'Arselle Nordic ski area. Panoramic south-facing terrace. An enchanting landscape where the gentleness of the place rhymes with happiness and flavors."
    ],
    "it": [
      "Situato nel comprensorio sciistico nordico del Plateau de l'Arselle. Terrazza panoramica esposta a sud. Un paesaggio incantevole dove la dolcezza del luogo fa rima con allegria e gusto."
    ],
    "fr": [
      "Situé sur le domaine de ski nordique \"le Plateau de l'Arselle\".  terrasse panoramique plein sud. Paysage enchanteur où la douceur du lieu rime avec bonheur et saveurs."
    ],
    "es": [
      "Situado en el dominio de esquí nórdico del Plateau de l'Arselle. Terraza panorámica orientada al sur. Un paisaje encantador donde la dulzura del lugar rima con felicidad y sabor."
    ],
    "nl": [
      "Gelegen op het Plateau de l'Arselle Nordic skigebied. Panoramisch terras op het zuiden. Een betoverend landschap waar de zachtheid van de plaats rijmt met geluk en smaak."
    ]
  },
