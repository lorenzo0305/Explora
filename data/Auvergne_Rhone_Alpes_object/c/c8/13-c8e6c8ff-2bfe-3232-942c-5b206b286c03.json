  "rdfs:comment": {
    "de": [
      "Ein Restaurant mit zeitgenössischem Ambiente und einer schattigen Terrasse.\r\nDas Restaurant des Hotels Campanile de Chambéry bietet Ihnen eine hochwertige französische Küche und köstliche regionale Spezialitäten.\r\nKleines Plus: Die Speisekarte wechselt je nach Jahreszeit!"
    ],
    "en": [
      "A contemporary restaurant with a shaded terrace.\r\nThe Campanile Hotel's restaurant in Chambéry offers quality French cuisine and delicious regional specialties."
    ],
    "it": [
      "Il ristorante ha un ambiente contemporaneo e una terrazza ombreggiata.\r\nIl ristorante dell'hotel Campanile di Chambéry offre una cucina francese di qualità e deliziose specialità regionali.\r\nIl menu cambia a seconda delle stagioni!"
    ],
    "fr": [
      "Un restaurant au cadre contemporain et doté d’une terrasse ombragée.\r\nLe restaurant de l’hôtel Campanile de Chambéry vous propose une cuisine française de qualité et de délicieuses spécialités régionales.\r\nPetit plus : la carte change au fil des saisons !"
    ],
    "nl": [
      "Het restaurant heeft een eigentijdse inrichting en een schaduwrijk terras.\r\nHet restaurant van het Campanile hotel in Chambéry biedt een Franse kwaliteitskeuken en heerlijke regionale specialiteiten.\r\nHet menu verandert met de seizoenen!"
    ],
    "es": [
      "El restaurante tiene un ambiente contemporáneo y una terraza con sombra.\r\nEl restaurante del hotel Campanile de Chambéry ofrece cocina francesa de calidad y deliciosas especialidades regionales.\r\nEl menú cambia con las estaciones"
    ]
  },
