  "rdfs:comment": {
    "de": [
      "Das Museum umfasst gallo-römische Überreste, die vor Ort gefunden wurden, und lädt zur Entdeckung der gallo-römischen Zivilisation ein. Sammlung gallo-römischer Überreste: Keramik, Darstellungen von Gottheiten, Säulen, Fresken, Alltagsgegenstände."
    ],
    "en": [
      "The museum gathers Gallo-Roman vestiges found locally and invites to the discovery of the Gallo-Roman civilization. Collection of Gallo-Roman remains: ceramics, representations of divinities, columns, frescoes, everyday objects."
    ],
    "it": [
      "Il museo riunisce i resti gallo-romani ritrovati in loco e invita a scoprire la civiltà gallo-romana. Collezione di reperti gallo-romani: ceramiche, rappresentazioni di divinità, colonne, affreschi, oggetti di uso quotidiano."
    ],
    "fr": [
      "Le musée regroupe des vestiges gallo-romains retrouvés localement et invite à la découverte de la civilisation gallo-romaine. Collection de vestiges gallo-romains : céramiques, représentations de divinités, colonnes, fresques, objets du quotidien."
    ],
    "nl": [
      "Het museum brengt ter plaatse gevonden Gallo-Romeinse overblijfselen samen en nodigt u uit om de Gallo-Romeinse beschaving te ontdekken. Verzameling Gallo-Romeinse overblijfselen: keramiek, voorstellingen van godheden, zuilen, fresco's, alledaagse voorwerpen."
    ],
    "es": [
      "El museo reúne restos galo-romanos encontrados en la zona e invita a descubrir la civilización galo-romana. Colección de vestigios galo-romanos: cerámicas, representaciones de divinidades, columnas, frescos, objetos de uso cotidiano."
    ]
  },
  "rdfs:label": {
