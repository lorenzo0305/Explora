  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/96a21dd8-35d5-3e16-a221-0c6c50b3f419",
      "dc:description": {
        "de": [
          "Besuchen Sie den Wohnwagen von Lens Tourisme, um alle Informationen über das Festival zu erhalten und mit einem Souvenir nach Hause zu gehen\nProbieren Sie auch das Bier von Sainte Barbe, das ausschließlich anlässlich des Festivals gebraut wird."
        ],
        "en": [
          "Visit the Lens Tourisme caravan to find out all about the festival and take home a souvenir\nTaste the Sainte Barbe beer, brewed exclusively for the festival."
        ],
        "it": [
          "Visitate il caravan di Lens Tourisme per scoprire tutto sul festival e portare a casa un souvenir\nÈ inoltre possibile provare la birra Sainte Barbe, prodotta esclusivamente per il festival."
        ],
        "fr": [
          "Rendez-vous à la caravane de Lens Tourisme pour avoir toutes les infos sur le festival et repartir avec un souvenir\nGoûtez également la bière de Sainte Barbe, brassée exclusivement à l’occasion du festival."
        ],
        "es": [
          "Visite la caravana de Lens Tourisme para informarse sobre el festival y llevarse un recuerdo\nTambién podrá probar la cerveza Sainte Barbe, elaborada exclusivamente para el festival."
        ],
        "nl": [
          "Bezoek de caravan van Lens Tourisme om alles te weten te komen over het festival en een souvenir mee naar huis te nemen\nJe kunt ook het Sainte Barbe bier proeven, dat exclusief voor het festival wordt gebrouwen."
        ]
      },
