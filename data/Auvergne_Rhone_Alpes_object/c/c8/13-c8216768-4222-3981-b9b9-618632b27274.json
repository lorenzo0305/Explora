  "rdfs:comment": {
    "de": [
      "Wir begrüßen Sie im Bouchon des Halles ein wenig wie zu Hause. Atmosphäre und Geselligkeit stehen bei uns an der Tagesordnung, mit traditionellen Gerichten aus Brasserie und Bouchon Lyonnais. Bis bald!"
    ],
    "en": [
      "You are welcomed to Le Bouchon des Halles as if it were home.  There is no lack of conviviality and atmosphere, with traditional brasserie dishes and Lyonnaise specialities.  See you very soon."
    ],
    "it": [
      "Vi accogliamo al Bouchon des Halles come se foste a casa vostra. Atmosfera e convivialità sono all'ordine del giorno, con piatti tradizionali della brasserie e del bouchon di Lione. A presto!"
    ],
    "fr": [
      "Nous vous accueillons au Bouchon des Halles un peu comme à la maison. Ambiance et convivialité sont au rendez-vous avec des plats traditionnels de brasserie et de bouchons lyonnais. À très vite !"
    ],
    "nl": [
      "Wij ontvangen u in de Bouchon des Halles alsof u thuis bent. Sfeer en gezelligheid zijn aan de orde van de dag, met traditionele brasserie- en bouchongerechten uit Lyon. Tot ziens!"
    ],
    "es": [
      "Le damos la bienvenida al Bouchon des Halles como si estuviera en casa. El ambiente y la convivencia están a la orden del día, con platos tradicionales de brasserie y bouchon de Lyon. Hasta pronto"
    ]
  },
