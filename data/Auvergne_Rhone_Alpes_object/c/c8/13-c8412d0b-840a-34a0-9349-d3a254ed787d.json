  "rdfs:comment": {
    "de": [
      "Zeitgleich mit dem Priorat, von den Benediktinern um 1085 gegründet, besteht aus drei Teilen, die drei Epochen entsprechen. Im Zusatzinventar der Historischen Monumente eingetragen und als eines der originellsten Bauwerke klassifiziert."
    ],
    "en": [
      "Contemporary with the Priory founded by the Benedictines around 1085, it is made up of 3 parts corresponding to 3 periods and is listed in the supplementary inventory of historic monuments as one of the most original."
    ],
    "it": [
      "Contemporaneo al Priorato fondato dai Benedettini intorno al 1085, è composto da 3 parti corrispondenti a 3 periodi ed è elencato nell'inventario supplementare dei monumenti storici come uno dei più originali."
    ],
    "fr": [
      "Contemporaine du Prieuré, fondée par les Bénédictins vers 1085, composée de 3 parties correspondant à 3 époques. Inscrite à l'inventaire supplémentaire des Monuments Historiques et classée comme une des plus originales."
    ],
    "nl": [
      "Eigentijds aan de Priorij, gesticht door de Benedictijnen rond 1085, bestaat uit 3 delen die overeenkomen met 3 periodes. Opgenomen in de aanvullende inventaris van historische monumenten en geclassificeerd als een van de meest originele."
    ],
    "es": [
      "Contemporáneo del Priorato, fundado por los benedictinos hacia 1085, se compone de 3 partes correspondientes a 3 épocas. Inscrito en el inventario suplementario de Monumentos Históricos y clasificado como uno de los más originales."
    ]
  },
  "rdfs:label": {
    "en": [
