  "rdfs:comment": {
    "de": [
      "Nehmen Sie eine Auszeit und vergessen Sie den Stress der Stadt! Der Bereich La Gentilhommière begrüsst Sie ganzjährig mit 85 Schlafzimmern, 3 ha Park, Sauna, Hamam, beheiztem Schwimbad."
    ],
    "en": [
      "Give yourself a break and forget the stress of the city! The Domaine La Gentilhommière welcomes you all the year  for your professional or personal stays with its 85 rooms, its 3 ha park, its sauna, hammam, heated indoor pool."
    ],
    "it": [
      "Prendete una pausa dallo stress della città! Il Domaine La Gentilhommière vi accoglie nel cuore della natura incontaminata, con il suo parco alberato e le sue ampie strutture."
    ],
    "fr": [
      "Offrez-vous une parenthèse et oubliez le stress de la ville ! Le Domaine La Gentilhommière vous accueille au cœur d'une nature préservée avec son parc arboré et ses nombreux équipements."
    ],
    "es": [
      "¡Tómese un respiro del estrés de la ciudad! El Domaine La Gentilhommière le da la bienvenida en plena naturaleza virgen, con su parque arbolado y sus amplias instalaciones."
    ],
    "nl": [
      "Even weg van de stress van de stad! Domaine La Gentilhommière verwelkomt je in het hart van de ongerepte natuur, met een bosrijk park en uitgebreide faciliteiten."
    ]
  },
