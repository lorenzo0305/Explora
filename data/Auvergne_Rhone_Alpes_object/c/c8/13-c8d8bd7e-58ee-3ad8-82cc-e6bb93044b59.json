  "rdfs:comment": {
    "de": [
      "Verkauf zum Mitnehmen und Verkostung von handwerklich hergestellten Bieren und Getränken vor Ort: Genießen Sie Ihren Abend auf der Terrasse und naschen Sie von den Wurst- und Käsebrettern der lokalen Produzenten."
    ],
    "en": [
      "Take away beers and drinks."
    ],
    "it": [
      "Vendita take off e degustazione diretta di birre e bevande artigianali : approfittate della vostra serata in terrazza per cenare le taglieri di salumi e formaggi dei prodottori locali."
    ],
    "fr": [
      "Vente à emporter et dégustation sur place de bières et boissons artisanales  : profitez de votre soirée en terrasse pour grignoter les planches charcuterie et fromages des producteurs locaux."
    ],
    "es": [
      "Venta para llevar y degustación in situ de cervezas y bebidas artesanales: disfrute de la velada en la terraza, saboreando tablas de embutidos y quesos de productores locales."
    ],
    "nl": [
      "Een artisanale bierbrouwerij met een lage energie consumptie, een ecologish- brouwsysteem, verpakkingssysteem  en een recyclage systeem voor de flesjes."
    ]
  },
