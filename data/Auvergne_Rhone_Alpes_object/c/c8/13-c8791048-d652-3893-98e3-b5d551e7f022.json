  "rdfs:comment": {
    "de": [
      "Entdecken Sie Saint Jean François Régis, diese sympathische Figur in großen Schuhen und mit einem Pilgerstock.\r\nDas Museum ist interaktiv und ermöglicht es Ihnen, in die Geschichte des Dorfes und seiner großen Pilgerfahrten einzutauchen."
    ],
    "en": [
      "The Saint Régis Museum has a diorama of 19 paintings by Georges Serraz retracing the life of Saint Régis (1597-1640). \r\nA relief map of the zone and the route taken by St Régis and a display with some old objects"
    ],
    "it": [
      "Scoprite Saint Jean François Régis, questo simpatico personaggio che indossa grandi scarpe e porta un bastone da pellegrino.\r\nIl museo interattivo immerge i visitatori nella storia del villaggio e dei suoi grandi pellegrinaggi."
    ],
    "fr": [
      "Découvrez Saint Jean François Régis, ce sympathique personnage chaussé de grands souliers et muni d'une canne de pèlerin.\r\nLe musée est interactif et permet une immersion dans l'histoire du village et de ses grands pèlerinages."
    ],
    "nl": [
      "Ontdek Saint Jean François Régis, dit sympathieke personage met grote schoenen en een pelgrimsstok.\r\nHet interactieve museum dompelt bezoekers onder in de geschiedenis van het dorp en zijn grote pelgrimstochten."
    ],
    "es": [
      "Descubra a Saint Jean François Régis, ese simpático personaje que calza zapatos grandes y lleva un bastón de peregrino.\r\nEl museo interactivo sumerge al visitante en la historia del pueblo y sus grandes peregrinaciones."
    ]
  },
