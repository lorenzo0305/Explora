  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/71ee9ad8-684c-3612-a50b-9cec55203fb0",
      "dc:description": {
        "de": [
          "Fotograf in Le Touquet, halten Sie im einzigen professionellen Studio des Ortes Ihre Momente im Leben fest!\nOb im Studio oder am Strand, lassen Sie uns gemeinsam Ihre Schwangerschafts-, Geburts- und sogar Familienfotos für einzigartige Erinnerungen realisieren!\n\nNur nach Vereinbarung."
        ],
        "en": [
          "Le Touquet photographer, immortalize your special moments in the resort's only professional studio!\nWhether in the studio or on the beach, we'll work together to capture your pregnancy, birth and even family photos for unique memories!\n\nBy appointment only."
        ],
        "it": [
          "Fotografo di Le Touquet, immortala i tuoi momenti di vita nell'unico studio professionale della località!\nIn studio o in spiaggia, lavoreremo insieme per scattare le foto della gravidanza, del parto e persino della famiglia, per ricordi unici!\n\nSolo su appuntamento."
        ],
        "fr": [
          "Photographe au Touquet, immortalisez dans le seul studio professionnel de la station vos moments de vie !\nEn studio ou sur la plage, réalisons ensemble vos photos de grossesse, naissance et même en famille pour des souvenirs uniques !\n\nSur Rendez-Vous uniquement."
        ],
        "nl": [
          "Fotograaf van Le Touquet, vereeuwig uw levensmomenten in de enige professionele studio van het resort!\nIn de studio of op het strand maken we samen uw zwangerschaps-, geboorte- en zelfs familiefoto's voor unieke herinneringen!\n\nAlleen op afspraak."
        ],
        "es": [
          "Fotógrafo de Le Touquet, inmortalice los momentos de su vida en el único estudio profesional de la estación\nEn el estudio o en la playa, trabajaremos juntos para hacer fotos de su embarazo, parto e incluso de su familia, ¡un recuerdo único!\n\nSólo con cita previa."
        ]
      },
      "@type": [
        "Description"
