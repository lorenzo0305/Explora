  "rdfs:comment": {
    "de": [
      "Begeben Sie sich auf eine sensationelle Abfahrt an Bord eines Zuges mit Gelenkschlitten, wenn die Pisten geschlossen sind. Garantierte Sensationen für eine unvergessliche Après-Ski-Abfahrt durch das Skigebiet!"
    ],
    "en": [
      "Embark on a sensational descent aboard a train of articulated sledges when the slopes close. Guaranteed sensations for an unforgettable après-ski descent of the ski area!"
    ],
    "it": [
      "Intraprendete una discesa sensazionale a bordo di un treno di slitte articolate quando le piste si chiudono. Sensazioni garantite per una discesa indimenticabile sull'area sciistica dopo lo sci!"
    ],
    "fr": [
      "Embarquez pour une descente sensationnelle à bord d'un train de luges articulées à la fermeture des pistes. Sensations garanties pour une descente inoubliable sur le domaine skiable en après-ski !"
    ],
    "es": [
      "Embárquese en un sensacional descenso a bordo de un tren de trineos articulados cuando se cierren las pistas. ¡Sensaciones garantizadas para un descenso inolvidable en la zona de esquí después de esquiar!"
    ],
    "nl": [
      "Begin aan een sensationele afdaling aan boord van een trein van gelede sleeën wanneer de pistes sluiten. Een onvergetelijke après-ski afdaling gegarandeerd!"
    ]
  },
  "rdfs:label": {
    "en": [
      "Snake Gliss"
    ],
