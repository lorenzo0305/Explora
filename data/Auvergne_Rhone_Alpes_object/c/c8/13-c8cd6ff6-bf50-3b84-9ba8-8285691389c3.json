  "rdfs:comment": {
    "de": [
      "Wir haben uns einen Ort mit dem Geist der Wildnis vorgestellt, der zu den Ursprüngen des Geschmacks zurückkehrt, einen Ort des Abenteuers, der Erkundung und der Freiheit."
    ],
    "en": [
      "We have imagined a place with a Sauvage spirit that goes back to the origins of taste, a place of adventure, exploration and freedom."
    ],
    "it": [
      "Abbiamo immaginato un luogo dallo spirito sauvage che ritorna alle origini del gusto, un luogo di avventura, esplorazione e libertà."
    ],
    "fr": [
      "Nous avons imaginé un lieu à l’esprit Sauvage qui revient aux origines du goût, un lieu d’aventure, d’exploration et de liberté."
    ],
    "nl": [
      "Wij hebben ons een plek voorgesteld met een Sauvage-geest die terugkeert naar de oorsprong van de smaak, een plek van avontuur, verkenning en vrijheid."
    ],
    "es": [
      "Hemos imaginado un lugar con espíritu sauvage que vuelve a los orígenes del gusto, un lugar de aventura, exploración y libertad."
    ]
