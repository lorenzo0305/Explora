  "rdfs:comment": {
    "de": [
      "Tauchen Sie ein in die Kulissen einer imaginären Musikkarriere, in der ein Schauspieler-Sänger-Improvisator einen berühmten Künstler des französischen Chansons verkörpert, der aus den Vorschlägen des Publikums frei erfunden wurde!"
    ],
    "en": [
      "Take a behind-the-scenes look at an imaginary musical career, where an actor-singer-improviser takes on the role of a famous French chanson artist, invented from scratch based on suggestions from the audience!"
    ],
    "it": [
      "Andate dietro le quinte di una carriera musicale immaginaria, dove un attore-cantante-improvvisatore interpreta il ruolo di un famoso artista di chanson francese, inventato di sana pianta sulla base dei suggerimenti del pubblico!"
    ],
    "fr": [
      "Plongez dans les coulisses d'une carrière musicale imaginaire, où un comédien-chanteur-improvisateur incarne un célèbre artiste de la chanson française, inventé de toutes pièces à partir des suggestions du public !"
    ],
    "nl": [
      "Neem een kijkje achter de schermen van een denkbeeldige muzikale carrière, waar een acteur-zanger-improvisator de rol speelt van een beroemde Franse chansonartiest, die vanuit het niets is verzonnen op basis van suggesties van het publiek!"
    ],
    "es": [
      "Adéntrese entre bastidores en una carrera musical imaginaria, en la que un actor-cantante-animador interpreta el papel de un famoso artista de la chanson francesa, ¡inventado desde cero a partir de las sugerencias del público!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Théâtre : L'entretien"
    ]
  },
