  "rdfs:comment": {
    "de": [
      "Auf der Terrasse oder vor dem Kamin empfängt Sie die Buchhandlung Les Espelines ganz unkompliziert, um ein Glas zu trinken, sich auszutauschen, zu spielen, zu lesen, sich auszuruhen?"
    ],
    "en": [
      "On the terrace or by the fire, the bookshop Les Espelines welcomes you to have a drink, chat, play games, read, relax?"
    ],
    "it": [
      "Sulla terrazza o accanto al fuoco, la libreria Les Espelines vi accoglie per bere qualcosa, chiacchierare, giocare, leggere, rilassarsi?"
    ],
    "fr": [
      "En terrasse ou au coin du feu, la librairie Les Espelines vous accueille en toute simplicité pour boire un verre, échanger, jouer, lire, vous reposer…"
    ],
    "nl": [
      "Op het terras of bij het haardvuur verwelkomt de boekhandel Les Espelines je om iets te drinken, te kletsen, spelletjes te spelen, te lezen, te ontspannen?"
    ],
    "es": [
      "En la terraza o junto al fuego, la librería Les Espelines le recibe para tomar una copa, charlar, jugar, leer, relajarse.."
    ]
  },
  "rdfs:label": {
