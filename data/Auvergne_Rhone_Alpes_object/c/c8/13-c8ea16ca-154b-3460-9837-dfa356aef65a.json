  "rdfs:comment": {
    "de": [
      "Bewegen Sie sich in aller Sicherheit von Baum zu Baum, allein, mit der Familie oder mit Freunden.\r\nParcours für Kinder, Jugendliche und Erwachsene, die Sie in Ihrem eigenen Tempo entdecken können"
    ],
    "en": [
      "Evolve to safely tree to tree, alone, with family or friends.\r\nChildren course, teenagers, adults to discover at your rhythm."
    ],
    "it": [
      "Arrampicarsi da un albero all'altro in tutta sicurezza, da soli, con la famiglia o con gli amici.\r\nCorsi per bambini, adolescenti e adulti da scoprire al proprio ritmo"
    ],
    "fr": [
      "Évoluez d'arbre en arbre en toute sécurité, seul, en famille ou entre amis.\r\nDes parcours enfants, ados, adultes à découvrir à votre rythme"
    ],
    "es": [
      "Suba de árbol en árbol con total seguridad, solo, en familia o con amigos.\r\nCursos para niños, adolescentes y adultos para descubrir a su propio ritmo"
    ],
    "nl": [
      "Leer veilig van boom naar boom klimmen, alleen, met familie of vrienden.\r\nCursussen voor kinderen, tieners en volwassenen om op uw eigen tempo te ontdekken."
    ]
  },
