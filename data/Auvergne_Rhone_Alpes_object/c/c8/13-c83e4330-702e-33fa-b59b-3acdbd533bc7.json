  "rdfs:comment": {
    "de": [
      "L'avenue du kebab bietet Ihnen eine große Auswahl an Tacos, Kebabs und Burgern mit Qualitätsprodukten. Von süß bis herzhaft können Sie vor Ort, auf der Terrasse oder zum Mitnehmen essen."
    ],
    "en": [
      "L'Avenue du Kebab offers a wide choice of tacos, kebabs and burgers made with high quality ingredients. A selection of sweet and savoury choices to eat on site, on the terrace or take away."
    ],
    "it": [
      "L'avenue du kebab vi offre un'ampia scelta di tacos, kebab e hamburger con prodotti di qualità. Dal dolce al salato, si può mangiare sul posto, in terrazza o da asporto."
    ],
    "fr": [
      "L'avenue du kebab vous propose un large choix de tacos, kebabs, burgers avec des produits de qualité. Du sucré au salé, vous pourrez manger sur place, en terrasse ou à emporter."
    ],
    "nl": [
      "L'avenue du kebab stelt U een ruime keuze voor van tacos, kebabs, hamburgers vervaardigd met kwaliteitsproducten.  Zoet of gezouten, U zal ter plaatse kunnen eten, op het terras of take-away."
    ],
    "es": [
      "L'avenue du kebab le ofrece una amplia selección de tacos, kebabs y hamburguesas con productos de calidad. De lo dulce a lo salado, se puede comer allí mismo, en la terraza o para llevar."
    ]
  },
