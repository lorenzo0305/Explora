  "rdfs:comment": {
    "de": [
      "Rouffiac gehört zur Xaintrie, einer kleinen Naturregion, die sich hauptsächlich im Osten des Departements Corrèze erstreckt, an das die Gemeinde angrenzt. Sie bewahrt eine Reihe schöner, mit Schiefer gedeckter Granithäuser."
    ],
    "en": [
      "Rouffiac is part of Xaintrie, a small natural region that extends mainly into the east of Corrèze, which the commune borders. It boasts a range of beautiful granite houses covered in local slate roofs."
    ],
    "it": [
      "Rouffiac fa parte della Xaintrie, una piccola regione naturale che si estende principalmente nella parte orientale della Corrèze, con cui il comune confina. Vanta una serie di belle case in granito ricoperte da tetti in ardesia."
    ],
    "fr": [
      "Rouffiac appartient à la Xaintrie, petite région naturelle qui s'étend principalement dans l'est de la Corrèze, dont la commune est limitrophe. Elle conserve un éventail de belles demeures de granit recouvertes de lauzes."
    ],
    "nl": [
      "Rouffiac maakt deel uit van de Xaintrie, een klein natuurgebied dat zich voornamelijk uitstrekt in het oosten van de Corrèze, waar de gemeente aan grenst. Het heeft een reeks prachtige granieten huizen met lokale leisteen."
    ],
    "es": [
      "Rouffiac forma parte de la Xaintrie, una pequeña región natural que se extiende principalmente al este de la Corrèze, con la que limita el municipio. Cuenta con una serie de hermosas casas de granito cubiertas con tejados de pizarra."
    ]
  },
