  "rdfs:comment": {
    "de": [
      "Die Bibliothek ist das ganze Jahr über (außer an Feiertagen) 20 Stunden pro Woche geöffnet, während der Schulferien gelten unveränderte Öffnungszeiten. Die Benutzung der Bücher vor Ort ist kostenlos. Die Bibliothek umfasst etwa 15.000 Bücher."
    ],
    "en": [
      "The library is open 20 hours a week throughout the year, including during the school holidays. You can come and read any document on-the-spot for free. You can find here almost 15 000 books."
    ],
    "it": [
      "La biblioteca è aperta 20 ore alla settimana tutto l'anno (esclusi i giorni festivi) e durante le vacanze scolastiche. La consultazione in loco è gratuita. Troverete quasi 15.000 libri."
    ],
    "fr": [
      "La bibliothèque est ouverte 20 heures par semaine toute l'année (sauf jours fériés) et sans changement d'horaires durant les vacances scolaires. La consultation sur place des ouvrages est gratuite. Vous pourrez trouver prés de 15000 ouvrages."
    ],
    "es": [
      "La biblioteca está abierta 20 horas a la semana durante todo el año (excepto festivos) y durante las vacaciones escolares. La consulta in situ es gratuita. Encontrará cerca de 15.000 libros."
    ],
    "nl": [
      "De bibliotheek is het hele jaar door (behalve op feestdagen) en tijdens schoolvakanties 20 uur per week geopend. Raadpleging ter plaatse is gratis. Je vindt er bijna 15.000 boeken."
    ]
  },
