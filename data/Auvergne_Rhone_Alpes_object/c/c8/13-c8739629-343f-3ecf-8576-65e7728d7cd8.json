    "de": [
      "Dorf Sainte-Florine: Alte Kirche mit Altarbild aus dem 18. Jahrhundert und Statue des Heiligen Jakobus aus dem 18. Jahrhundert. Viereckiger Turm aus dem 15. Jahrhundert mit Wandmalereien."
    ],
    "en": [
      "Village of Sainte-Florine: Old church with 18th-century altarpiece and 18th-century statue of Saint Jacques. 15th-century square tower with wall paintings."
    ],
    "it": [
      "Villaggio di Sainte-Florine: antica chiesa con pala d'altare del XVIII secolo e statua di Saint-Jacques del XVIII secolo. Torre quadrata del XV secolo con dipinti murali."
    ],
    "fr": [
      "Village de Sainte-Florine : Église ancienne avec retable du XVIIIe siècle et statue de Saint Jacques du XVIIIe siècle. Tour carrée du XVe siècle avec peintures murales."
    ],
    "es": [
      "Pueblo de Sainte-Florine: Antigua iglesia con retablo del siglo XVIII y estatua de Santiago del siglo XVIII. Torre cuadrada del siglo XV con pinturas murales."
    ],
    "nl": [
      "Dorp Sainte-Florine: Oude kerk met altaarstuk uit de 18e eeuw en beeld van Saint Jacques uit de 18e eeuw. Vierkante toren uit de 15e eeuw met muurschilderingen."
    ]
  },
