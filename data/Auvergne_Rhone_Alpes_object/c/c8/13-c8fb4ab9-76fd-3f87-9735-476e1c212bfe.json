  "rdfs:comment": {
    "de": [
      "Franck Pelliciolli, Maître-Restaurateur, bietet in der Auberge de Contrevoz eine Qualitätsküche aus frischen und lokalen Produkten, die fein verarbeitet werden, im Herzen eines typischen Bugistendorfes."
    ],
    "en": [
      "Franck Pelliciolli, master restaurateur, offers high-quality cuisine made from finely prepared fresh, local produce at the Auberge de Contrevoz, in the heart of a typical Bugiste village."
    ],
    "it": [
      "Franck Pelliciolli, maestro ristoratore, propone una cucina di qualità all'Auberge de Contrevoz, utilizzando prodotti freschi e locali, nel cuore di un tipico villaggio bugista."
    ],
    "fr": [
      "Franck Pelliciolli, maître-restaurateur, propose à l'Auberge de Contrevoz, une cuisine de qualité composée de produits frais et locaux finement travaillés, au cœur d'un village typiquement bugiste."
    ],
    "nl": [
      "Franck Pelliciolli, meester-restaurateur, biedt in de Auberge de Contrevoz een kwaliteitskeuken met verse en lokale producten, in het hart van een typisch Bugistisch dorp."
    ],
    "es": [
      "Franck Pelliciolli, maestro restaurador, ofrece una cocina de calidad en el Auberge de Contrevoz, con productos frescos y locales, en el corazón de un típico pueblo bugista."
    ]
  },
  "rdfs:label": {
