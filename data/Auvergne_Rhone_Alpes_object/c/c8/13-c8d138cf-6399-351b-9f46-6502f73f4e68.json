  "rdfs:comment": {
    "de": [
      "Das ist Free-Ride-Skiing gemischt mit einer Portion Fallschirmspringen, einer Portion Gleitschirmfliegen, einer Portion Kiten, einem Hauch Freestyle, einer Prise Kunstflug und schließlich einer großen Prise Berge?"
    ],
    "en": [
      "It's free ride skiing mixed with a dose of skydiving, a dose of paragliding, a dose of kiteboarding, a dash of free style, a pinch of aerobatics, and finally a big zest of mountain..."
    ],
    "it": [
      "Si tratta di sci free-ride mescolato con una dose di paracadutismo, una dose di parapendio, una dose di kiteboarding, un pizzico di free style, un pizzico di acrobazia aerea e infine una grande scorza di montagna?"
    ],
    "fr": [
      "C’est le ski free-ride mélangé à une dose de parachutisme, une dose de parapente, une dose de kite, un soupçon de free style, une pincée de voltige, et enfin un gros zeste de montagne…"
    ],
    "nl": [
      "Het is free ride skiën vermengd met een dosis parachutespringen, een dosis paragliding, een dosis kite, een vleugje free style, een snufje aerobatics en tot slot een flinke berg pit ..."
    ],
    "es": [
      "Es esquí libre mezclado con una dosis de paracaidismo, una dosis de parapente, una dosis de kitesurf, una pizca de estilo libre, una pizca de acrobacia aérea y, por último, una gran dosis de montaña?"
    ]
  },
