  "rdfs:comment": {
    "de": [
      "Das Team von HORIZONS Nature et Montagnes empfängt Sie in Valmeinier, um Sauerstoff zu tanken, neue Eindrücke zu sammeln und Leckereien zu genießen.\r\nIm Sommer: Riesling, Spaziergänge, Wanderungen und Mountainbikes mit elektrischer Unterstützung.\r\nIm Winter: Spaziergänge und Schneeschuhwanderungen."
    ],
    "en": [
      "Every day, in the morning, afternoon or evening, Horizons Nature et Montagne offers you snowshoe outings and/or hikes in the Valmeinier Valley."
    ],
    "it": [
      "Il team di HORIZONS Nature et Montagnes vi accoglie a Valmeinier per fare il pieno di ossigeno, sensazioni e prelibatezze.\r\nIn estate: ruisseling, passeggiate, escursioni e mountain bike a pedalata assistita.\r\nIn inverno: passeggiate ed escursioni con le racchette da neve."
    ],
    "fr": [
      "L’équipe d’HORIZONS Nature et Montagnes vous accueille à Valmeinier pour faire le plein d’oxygène, de sensations et de gourmandises.\r\nEn été : ruisseling, balades, randonnées et VTT à assistance électrique.\r\nEn hiver : balades et randonnées en raquettes."
    ],
    "nl": [
      "Elke dag's morgens, 's middags of 's avonds, stellen Horizons Nature et Montagne sneeuwschoen- en/of wandeltochten voor in het Valmeinier-dal."
    ],
    "es": [
      "El equipo de HORIZONS Nature et Montagnes le da la bienvenida a Valmeinier para que se llene de oxígeno, sensaciones y manjares.\r\nEn verano: ruisseling, paseos, excursiones y bicicleta de montaña con asistencia eléctrica.\r\nEn invierno: paseos y excursiones con raquetas de nieve."
    ]
  },
