  "rdfs:comment": {
    "de": [
      "Die Fee Vichéia, die Schwestern Adelaide und Victoire, Letizia Bonaparte, die Marquise de Sévigné, die Herzogin von Angoulême, Coco Chanel?\r\nOb sie Prinzessinnen, Gräfinnen oder die erste weibliche Rennfahrerin waren? Sie alle haben eine Gemeinsamkeit: Vichy!"
    ],
    "en": [
      "La Fée Vichéia, the sisters Adelaïde and Victoire, Letizia Bonaparte, the Marquise de Sévigné, the Duchesse d?Angoulême, Coco Chanel?\r\nPrincesses, Countesses, the 1st woman racing driver? They all have one thing in common: Vichy!"
    ],
    "it": [
      "La fata Vichéia, le sorelle Adelaïde e Victoire, Letizia Bonaparte, la marchesa di Sévigné, la duchessa di Angoulême, Coco Chanel?\r\nPrincipesse, contesse, la prima donna pilota? Tutte hanno una cosa in comune: Vichy!"
    ],
    "fr": [
      "La  Fée Vichéia,  les soeurs Adelaïde et Victoire,  Letizia Bonaparte,  la Marquise de Sévigné, la Duchesse d’Angoulême,  Coco Chanel…\r\nQu’elles soient, Princesses, Comtesses, 1ère femme pilote automobile… Elles ont toutes un point commun : Vichy !"
    ],
    "es": [
      "¿El hada Vichéia, las hermanas Adelaïde y Victoire, Letizia Bonaparte, la marquesa de Sévigné, la duquesa de Angulema, Coco Chanel?\r\n¿Princesas, condesas, la primera mujer piloto? Todas ellas tienen algo en común: ¡Vichy!"
    ],
    "nl": [
      "De fee Vichéia, de zusjes Adelaïde en Victoire, Letizia Bonaparte, de markiezin van Sévigné, de hertogin van Angoulême, Coco Chanel?\r\nPrinsessen, gravinnen, de 1e vrouwelijke autocoureur? Ze hebben allemaal één ding gemeen: Vichy!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite guidée : \"Les Reines de la ville d'eaux\""
    ]
  },
