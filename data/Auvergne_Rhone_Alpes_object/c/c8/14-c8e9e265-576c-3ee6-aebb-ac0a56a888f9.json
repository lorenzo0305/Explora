  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/54479cc6-950a-3252-bf66-7e7b6bbe19f6",
      "dc:description": {
        "de": [
          "Informationen :\n\nSpeisekarte:\nBesuchen Sie die Facebook-Seite, um die Speisekarte zu sehen\n\nÖffnungszeiten:\nTäglich\nMontag bis Sonntag: 11:00-14:00 Uhr / 18:00-21:30 Uhr\n\nBestellung:\nÜber die Apps \"Déliveroo\" oder \"Uber Eat\"\n\nAbholung:\nZum Mitnehmen während der Öffnungszeiten der Pommesbude\nLieferung möglich über \"Deliveroo\" oder \"Uber Eat\""
        ],
        "en": [
          "Information :\n\nMenu:\nSee the Facebook page for the menu\n\nOpening days :\nEvery day\nMonday to Sunday: 11am-2pm / 6pm-9:30pm\n\nOrdering :\nVia the \"Déliveroo\" or \"Uber Eat\" apps\n\nPick-up :\nTakeaway during friterie opening hours\nDelivery possible via \"Deliveroo\" or \"Uber Eat\""
        ],
        "it": [
          "Ulteriori informazioni :\n\nMenu:\nControllare la pagina Facebook per il menu\n\nGiorni di apertura :\nTutti i giorni\nDa lunedì a domenica: 11.00-14.00 / 18.00-21.30\n\nOrdini :\nTramite le app \"Déliveroo\" o \"Uber Eat\"\n\nRitiro :\nDa asporto durante gli orari di apertura della fritteria\nConsegna possibile tramite \"Deliveroo\" o \"Uber Eat\""
        ],
        "fr": [
          "Informations :\n\nMenu: \nConsultez la page Facebook pour connaitre le menu \n\nJours d'ouverture : \nTous les jours\nDu lundi au dimanche: 11h-14h / 18h-21h30\n\nCommande : \nVia les applications \"Déliveroo\" ou \"Uber Eat\" \n\nRetrait :\nÀ emporter aux horaires d'ouverture de la friterie\nLivraison possible via \"Deliveroo\" ou \"Uber Eat\" "
        ],
        "nl": [
          "Meer informatie :\n\nMenu:\nKijk op de Facebookpagina voor het menu\n\nOpeningsdagen :\nElke dag\nMaandag tot zondag: 11u tot 14u / 18u tot 21u30\n\nBestellen :\nVia de \"Déliveroo\" of \"Uber Eat\" apps\n\nAfhalen :\nAfhalen tijdens openingstijden van de friterie\nLevering mogelijk via \"Deliveroo\" of \"Uber Eat\""
        ],
        "es": [
          "Más información :\n\nMenú:\nConsulta el menú en la página de Facebook\n\nDías de apertura :\nTodos los días\nDe lunes a domingo: 11.00-14.00 / 18.00-21.30\n\nPedidos :\nA través de las aplicaciones \"Déliveroo\" o \"Uber Eat\n\nRecogida :\nPara llevar durante el horario de apertura de la friterie\nEntrega posible a través de \"Deliveroo\" o \"Uber Eat\""
        ]
      },
