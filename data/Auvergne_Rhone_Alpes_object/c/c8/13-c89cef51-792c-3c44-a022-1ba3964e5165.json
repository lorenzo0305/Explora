  "rdfs:comment": {
    "de": [
      "Die verschiedenen Namen, die der Gemeinde im Laufe der Jahrhunderte gegeben wurden, enthalten alle die Vorstellung von Stein, Fels oder Steinbruch."
    ],
    "en": [
      "The various names given to the commune over the centuries all contain the idea of stone, rock or quarry."
    ],
    "it": [
      "I vari nomi dati al comune nel corso dei secoli contengono tutti l'idea di pietra, roccia o cava."
    ],
    "fr": [
      "Les différents noms donnés à la commune au fil des siècles contiennent tous l'idée de pierre, de rocher ou de carrière."
    ],
    "es": [
      "Los distintos nombres que ha recibido el municipio a lo largo de los siglos contienen la idea de piedra, roca o cantera."
    ],
    "nl": [
      "Dit dorp in de heuvels heeft zijn landelijk karakter weten te behouden en besteedt veel zorg aan de bescherming van deze prachtige locatie en het milieu. Een gemarkeerde wandeling voert naar een uitzichtpunt met een panoramawijzer en een prachtig uitzicht over de omgeving."
    ]
  },
