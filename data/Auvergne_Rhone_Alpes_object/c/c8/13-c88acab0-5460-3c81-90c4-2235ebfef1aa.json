  "rdfs:comment": {
    "de": [
      "La Virgule ist eine handwerkliche Brauerei, die sich in Champagne en Valromey am Fuße des Grand Colombier niedergelassen hat. Sie bietet eine Reihe von Bio-Bieren und -Limonaden mit originellen und abwechslungsreichen Rezepten an, die die unerschöpfliche Vielfalt dieses Produkts erkunden."
    ],
    "en": [
      "La Virgule is a craft brewery based in Champagne en Valromey, at the foot of the Grand Colombier. It offers a range of organic beers and lemonades with original and varied recipes that explore the inexhaustible diversity of this product."
    ],
    "it": [
      "La Virgule è un birrificio artigianale con sede a Champagne-en-Valromey, ai piedi del Grand Colombier. Offre una gamma di birre e limonate biologiche con ricette originali e varie che esplorano l'inesauribile diversità di questo prodotto."
    ],
    "fr": [
      "La Virgule est une brasserie artisanale installée à Champagne-en-Valromey, au pied du Grand Colombier. Elle propose une gamme de bières et limonades bio avec des recettes originales et variées qui explorent la diversité inépuisable de ce produit."
    ],
    "nl": [
      "La Virgule is een ambachtelijke brouwerij gevestigd in Champagne-en-Valromey, aan de voet van de Grand Colombier. Ze biedt een gamma biologische bieren en limonades met originele, gevarieerde recepten die de onuitputtelijke diversiteit van dit product verkennen."
    ],
    "es": [
      "La Virgule es una cervecería artesanal situada en Champagne-en-Valromey, al pie del Grand Colombier. Ofrece una gama de cervezas y limonadas ecológicas con recetas originales y variadas que exploran la inagotable diversidad de este producto."
    ]
  },
  "rdfs:label": {
    "de": [
      "Mikrobrauerei la Virgule"
    ],
    "en": [
      "Micro Brasserie la Virgule"
    ],
    "fr": [
      "Micro Brasserie la Virgule"
    ]
  },
