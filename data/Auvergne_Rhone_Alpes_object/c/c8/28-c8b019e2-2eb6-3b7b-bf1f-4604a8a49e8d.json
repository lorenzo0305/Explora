  "rdfs:comment": {
    "de": [
      "Verein für urbane Kultur, der urbane Gleitsportarten in den Vordergrund stellt.\nVerleih von BMX-Rädern mit Schutz vor Ort\nEmpfang von kleinen Gruppen\nZugänglich ab 11J\nSchule für Gleitsportarten\nErzieher-Animateur vor Ort\nSpezifische Anfrage möglich\nSchnupperkurs pro Tag von 1 bis 5 Std\nErweiterte Öffnungszeiten während der Schulferien\nUrbane Kunst sehr präsent (Graffiti, urbane Kultur...) über den Verein CURB"
    ],
    "en": [
      "Urban culture association promoting urban board sports.\nBMX rental with on-site protection\nSmall groups welcome\nAccessible from age 11\nSnow sports school\nInstructor on site\nSpecific requests possible\n1 to 5-hour day-long discovery courses\nExtended opening period during school vacations\nUrban art (graffiti, urban culture...) via the CURB association"
    ],
    "it": [
      "Associazione di cultura urbana che promuove gli sport da tavola urbani.\nNoleggio BMX con protezione in loco\nAccoglienza di piccoli gruppi\nAccessibile a partire da 11 anni\nScuola di sport sulla neve\nIstruttore in loco\nPossibilità di richieste specifiche\nCorso giornaliero di scoperta da 1 a 5 ore\nApertura prolungata durante le vacanze scolastiche\nArte urbana con una forte presenza (graffiti, cultura urbana, ecc.) tramite l'associazione CURB"
    ],
    "fr": [
      "Association de culture urbaine mettant en avant les sports urbains de glisse.\nLocation de BMX avec protection sur place\nAccueil de petit groupe\nAccessible des 11ans\nEcole de glisse \nEducateur-Animateur sur place\nDemande spécifique possible\nStage découverte à la journée de 1 à 5h\nPériode d'ouverture élargie pendant les vacances scolaires\nArt urbain très présent (graff, culture urbaine...) via l'association CURB"
    ],
    "nl": [
      "Vereniging voor stedelijke cultuur die stedelijke boardsporten promoot.\nVerhuur van BMX's met bescherming ter plaatse\nKleine groepen welkom\nToegankelijk vanaf 11 jaar\nSneeuwsportschool\nInstructeur ter plaatse\nSpecifieke wensen mogelijk\n1 tot 5 uur durende ontdekkingsdagcursus\nVerlengde openingsperiode tijdens schoolvakanties\nStadskunst met een sterke aanwezigheid (graffiti, stadscultuur, enz.) via de vereniging CURB"
    ],
    "es": [
      "Asociación de cultura urbana que promueve los deportes urbanos de tabla.\nAlquiler de BMX con protección in situ\nSe admiten grupos reducidos\nAccesible a partir de 11 años\nEscuela de deportes de nieve\nInstructor in situ\nPosibilidad de peticiones específicas\nJornada de descubrimiento de 1 a 5 horas\nApertura prolongada durante las vacaciones escolares\nArte urbano muy presente (graffiti, cultura urbana, etc.) a través de la asociación CURB"
    ]
  },
