  "rdfs:comment": {
    "de": [
      "Erleben Sie Nervenkitzel pur auf einem Rundflug mit dem Ultraleichtflugzeug: 15, 30, 60 min oder mehr über den Bergketten des Cantal, des Aubrac und der Margeride … oder Sie lassen sich bei einem Entdeckungsflug 90 min lang in die Geheimnisse der Flugkunst einweisen (30 min Einweisung am Boden und 60 min Flugkurs)."
    ],
    "en": [
      "Come and experience a mind-boggling flying baptism: 15, 30, 60 min or more above the Monts du Cantal, of the Aubrac or the Margeride. Or you can initiate yourself as a pilot with a flight of discovery of 1 and a half hours (30 mins of instruction on the ground followed by 1 hour in the air as a trainee pilot)."
    ],
    "it": [
      "Azur Passion ULM vi offre un'esperienza unica, con primi voli o lezioni di volo sui vulcani dell'Alvernia."
    ],
    "fr": [
      "Azur Passion ULM vous propose une expérience unique grâce à des baptêmes de l’air ou des initiations au pilotage au-dessus des volcans d’Auvergne."
    ],
    "es": [
      "Azur Passion ULM le ofrece una experiencia única, con primeros vuelos o clases de vuelo sobre los volcanes de Auvernia."
    ],
    "nl": [
      "Azur Passion ULM biedt u een unieke ervaring, met eerste vluchten of vlieglessen boven de vulkanen van de Auvergne."
    ]
  },
  "rdfs:label": {
    "de": [
