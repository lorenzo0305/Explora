  "rdfs:comment": {
    "de": [
      "Carine und Jean empfangen Sie in einer freundlichen Atmosphäre; ein gemeinsam genutzter Raum, in dem jeder bei einer Mahlzeit, einem Kaffee oder einem Kartenspiel einen angenehmen Moment der Entspannung verbringen kann."
    ],
    "en": [
      "bar/restaurant located in a small village. traditional french cuisine. enjoy in summer the shady terrace."
    ],
    "it": [
      "Carine e Jean vi accolgono in un'atmosfera amichevole; uno spazio condiviso dove tutti possono, durante un pasto, un caffè o una partita a carte, trascorrere un piacevole momento di relax."
    ],
    "fr": [
      "Carine et Jean vous accueillent dans une ambiance conviviale ; un espace partagé où chacun pourra, le temps d’un repas, d’un café ou d’une partie de carte, passer un moment de détente agréable."
    ],
    "es": [
      "Carine y Jean le dan la bienvenida en un ambiente acogedor; un espacio compartido donde todos pueden, durante una comida, un café o una partida de cartas, pasar un agradable momento de relajación."
    ],
    "nl": [
      "Carine en Jean ontvangen u in een gezellige sfeer; een gemeenschappelijke ruimte waar iedereen, tijdens een maaltijd, een kopje koffie of een spelletje kaart, een aangenaam moment van ontspanning kan doorbrengen."
    ]
  },
