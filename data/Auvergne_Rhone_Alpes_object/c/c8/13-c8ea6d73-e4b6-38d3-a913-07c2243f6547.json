  "rdfs:comment": {
    "de": [
      "Sie werden vom idealen Palast des Postboten Pferd und dem hübschen Dorf Hauterives auf ruhigen und sehr wenig befahrenen Strecken schnell an Höhe gewinnen."
    ],
    "en": [
      "You'll quickly gain height from the horse factor's ideal palace and the pretty village of Hauterives on quiet, little-traveled routes."
    ],
    "it": [
      "Potrete presto librarvi in alto sopra il palazzo ideale del fattore cavallo e il grazioso villaggio di Hauterives su percorsi tranquilli e poco battuti."
    ],
    "fr": [
      "Vous prendre rapidement de la hauteur depuis le palais idéal du facteur cheval et le joli village d'Hauterives sur des parcours calmes et très peu fréquentés."
    ],
    "es": [
      "Pronto podrá sobrevolar el palacio ideal del factor caballo y el bonito pueblo de Hauterives por rutas tranquilas y poco transitadas."
    ],
    "nl": [
      "Al snel zweef je hoog boven het ideale paleis van de paardenfactor en het mooie dorpje Hauterives over rustige, weinig bereden routes."
    ]
  },
  "rdfs:label": {
