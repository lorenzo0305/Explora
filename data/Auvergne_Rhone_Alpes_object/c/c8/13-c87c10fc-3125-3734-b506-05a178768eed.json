  "rdfs:comment": {
    "de": [
      "Bereite dich darauf vor, dass du rennen, schreien, dich verstecken und vor allem eine Menge Spaß haben wirst! Keine Wurfgeschosse, nur Licht, Action und Lachen!\r\nein ländlicher Spielplatz im Freien für die ganze Familie, Freunde und Kollegen!"
    ],
    "en": [
      "Get ready to run, scream, hide and, above all, have lots of fun! No projectiles, just light, action and laughter!\r\nan outdoor country playground for families, friends and colleagues!"
    ],
    "it": [
      "Preparatevi a correre, urlare, nascondervi e, soprattutto, a divertirvi! Niente proiettili, solo luce, azione e risate!\r\nun parco giochi all'aperto da vivere con la famiglia, gli amici o i colleghi!"
    ],
    "fr": [
      "Préparez vous à courir, crier, vous cacher et surtout à beaucoup vous amuser ! Pas de projectiles, que de la lumière, de l’action et des fous rires !\r\n​Un terrain de jeu champêtre en extérieur, à faire en famille, entre amis ou avec les collègues!"
    ],
    "es": [
      "Prepárate para correr, gritar, esconderte y, sobre todo, ¡diviértete a lo grande! Sin proyectiles, ¡sólo luz, acción y risas!\r\nun parque infantil campestre al aire libre para disfrutar con la familia, los amigos o los colegas"
    ],
    "nl": [
      "Bereid je voor op rennen, gillen, verstoppen en vooral heel veel plezier! Geen projectielen, alleen licht, actie en gelach!\r\neen buitenspeeltuin op het platteland om van te genieten met familie, vrienden of collega's!"
    ]
  },
