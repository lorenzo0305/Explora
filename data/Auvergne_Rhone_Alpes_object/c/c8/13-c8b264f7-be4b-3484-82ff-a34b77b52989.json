  "rdfs:comment": {
    "de": [
      "Naturresort mit vier Jahreszeiten, in dem Sie Mountainbikes und Mountainbikes mieten können, sowie Material für sanfte Wintersportarten (Schneeschuhe, Hok-Ski, Langlaufski, Rodeln). Ausgebaute Mountainbike-Pisten, Wanderungen und kleine Restaurants vor Ort."
    ],
    "en": [
      "4-season nature resort offering mountain bike and ATV rentals, as well as soft winter sports equipment (snowshoes, hok ski, cross-country ski, toboggan). Mountain bike trails, hikes and snack bars on site."
    ],
    "it": [
      "Resort naturalistico 4 stagioni che offre noleggio di mountain bike e ATV, nonché attrezzature per sport invernali soft (racchette da neve, sci hok, sci di fondo, slittino). Percorsi per mountain bike, escursioni e snack bar in loco."
    ],
    "fr": [
      "Station de pleine nature 4 saisons proposant la location de VTT et VTTAE, ainsi que de matériel de sports d’hiver doux (raquettes, ski hok, ski de fond, luge). Pistes VTT aménagées, randonnées et petite restauration sur place."
    ],
    "nl": [
      "Natuurresort voor 4 seizoenen waar mountainbikes en ATV's worden verhuurd, evenals zachte wintersportuitrusting (sneeuwschoenen, hokski's, langlaufski's, rodel). Mountainbikeroutes, wandelingen en snackbars ter plaatse."
    ],
    "es": [
      "Estación natural de 4 estaciones que ofrece alquiler de bicicletas de montaña y todoterrenos, así como material para deportes de invierno (raquetas de nieve, hok ski, esquí de fondo, tobogán). Rutas de bicicleta de montaña, senderismo y merenderos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Domaine du Montoncel"
    ]
  },
