  "rdfs:comment": {
    "de": [
      "Der Verein Synergie Partage Langeac empfängt Sie mit Unterstützung des CCAS in seinen Räumlichkeiten zu einem ständigen Flohmarkt, auf dem Sie Nippes, Bücher, Möbel, Kleidung usw. finden. Sie können das ganze Jahr über auch Spenden machen."
    ],
    "en": [
      "The Association Synergie Partage Langeac, with the support of the CCAS, welcomes you to its premises for a permanent flea market where you can find knick-knacks, books, furniture, clothes, etc. You can also make donations throughout the year."
    ],
    "it": [
      "L'Associazione Synergie Partage Langeac, con il sostegno della CCAS, vi accoglie nei suoi locali per un mercatino delle pulci permanente in cui potrete trovare soprammobili, libri, mobili, vestiti, ecc."
    ],
    "fr": [
      "L'Association Synergie Partage Langeac en soutien avec le CCAS vous accueille dans ses locaux pour une brocante permanente où vous trouverez : bibelots, livres, meubles, vêtements etc...Vous pouvez également faire des dons tout au long de l'année."
    ],
    "es": [
      "La Asociación Synergie Partage Langeac, con el apoyo de la CCAS, le da la bienvenida a sus locales para un mercadillo permanente en el que podrá encontrar chucherías, libros, muebles, ropa, etc. También puede hacer donaciones durante todo el año."
    ],
    "nl": [
      "De Association Synergie Partage Langeac, met de steun van het CCAS, verwelkomt u op haar terrein voor een permanente rommelmarkt waar u snuisterijen, boeken, meubels, kleding, enz. kunt vinden. U kunt ook het hele jaar door donaties doen."
    ]
  },
  "rdfs:label": {
