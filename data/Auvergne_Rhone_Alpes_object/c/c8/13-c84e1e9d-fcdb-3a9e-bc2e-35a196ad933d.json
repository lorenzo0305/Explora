  "rdfs:comment": {
    "de": [
      "Willkommen bei Pif Paf, Ihrem Feinschmecker-Bistro und Crêperie im Herzen von Morzine. Hier verbindet sich Gastronomie mit Geselligkeit, um Ihnen ein sympathisches Erlebnis zu bieten."
    ],
    "en": [
      "Welcome to Pif Paf, your gourmet bistro and crêperie in the heart of Morzine. Here, gastronomy blends with conviviality to offer you a delightful experience."
    ],
    "it": [
      "Benvenuti al Pif Paf, il vostro bistrot e crêperie gourmet, situato nel cuore di Morzine. Qui la gastronomia si unisce alla convivialità per offrirvi un'esperienza deliziosa."
    ],
    "fr": [
      "Bienvenue chez Pif Paf, votre bistrot gourmand et crêperie, niché au cœur de Morzine. Ici, la gastronomie se marie à la convivialité pour vous offrir une expérience sympathique."
    ],
    "nl": [
      "Welkom bij Pif Paf, uw gastronomische bistro en crêperie, genesteld in het hart van Morzine. Hier wordt gastronomie gecombineerd met gezelligheid om u een heerlijke ervaring te bieden."
    ],
    "es": [
      "Bienvenido a Pif Paf, su restaurante gastronómico y crepería en el corazón de Morzine. Aquí, la gastronomía se combina con la convivencia para ofrecerle una experiencia deliciosa."
    ]
  },
