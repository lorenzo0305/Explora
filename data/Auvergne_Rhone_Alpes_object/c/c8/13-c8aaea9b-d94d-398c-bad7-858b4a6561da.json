  "rdfs:comment": {
    "de": [
      "Laden mit regionalen, lokalen und bäuerlichen Produkten (Wurstwaren, Spirituosen, Honig, Marmeladen, Käse - Milch von\r\nkuh, Ziege, Schaf...). Formeln für Raclette und Fondue. Tanken Sie neue Geschmackserlebnisse dank des Know-hows unserer Erzeuger\r\nunserer handwerklichen Erzeuger."
    ],
    "en": [
      "At La Fromagerie, regional, local and farm products (charcuterie, spirits, honeys, jams, cheeses - especially\r\nlocal goats). Raclette and fondue formulas. Come and fill up on flavours thanks to the know-how of our artisan\r\nproducers."
    ],
    "it": [
      "Negozio di prodotti regionali, locali e di fattoria (salumi, liquori, mieli, marmellate, formaggi - latte di mucca, di capra e di pecora, ecc.)\r\nlatte di mucca, capra e pecora). Formule di raclette e fonduta. Venite a fare il pieno di sapori grazie alla competenza dei nostri\r\ndei nostri produttori artigianali."
    ],
    "fr": [
      "Magasin de produits régionaux, locaux et fermiers (charcuteries, alcools, miels, confitures, fromages - lait de\r\nvache, chèvre, brebis...). Formules raclette et fondue. Venez faire le plein de saveurs grâce au savoir-faire de\r\nnos artisans producteurs."
    ],
    "es": [
      "Tienda de productos regionales, locales y de granja (embutidos, licores, mieles, mermeladas, quesos - leche de vaca, cabra y oveja)\r\nleche de vaca, cabra y oveja). Fórmulas de raclette y fondue. Venga y llénese de sabores gracias a la experiencia\r\nde nuestros productores artesanos."
    ],
    "nl": [
      "Bij La Fromagerie, regionale, lokale en boerderijproducten (vleeswaren, sterke drank, honing, jam, kazen -\r\nvooral lokale geiten). Raclette en fondue formules. Kom en vul u met smaken dankzij de knowhow van onze\r\nambachtelijke producenten."
    ]
  },
