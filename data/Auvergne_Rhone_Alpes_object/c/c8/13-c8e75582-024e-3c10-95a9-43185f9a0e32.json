  "rdfs:comment": {
    "de": [
      "Das Cinéma le Roxy ist ein unabhängiges Kino mit einer Leinwand und 183 Plätzen, das als Art et Essai klassifiziert und für Personen mit eingeschränkter Mobilität zugänglich ist.\r\nDigitale Projektion, Ton: Dolby Surround 7.1.\r\nDas Programm finden Sie unter diesem Link: https://www.cinebaroxy.fr"
    ],
    "en": [
      "Cinema classified Art et Essai. Program at the Tourist Office"
    ],
    "it": [
      "Il Cinéma le Roxy è un cinema indipendente, monosala, da 183 posti, classificato come Art et Essai, accessibile alle persone con mobilità ridotta.\r\nProiezione digitale, audio: Dolby Surround 7.1.\r\nPer il programma completo, cliccare qui: https://www.cinebaroxy.fr"
    ],
    "fr": [
      "Le Cinéma le Roxy est une salle indépendante, mono-écran, 183 places classé Art et Essai, accessible aux personnes à mobilité réduite.\r\nProjection numérique, son : Dolby Surround 7.1.\r\nRetrouvez le programme sur ce lien : https://www.cinebaroxy.fr"
    ],
    "nl": [
      "Cinéma le Roxy is een onafhankelijke bioscoop met één zaal en 183 zitplaatsen, geclassificeerd als Art et Essai, toegankelijk voor mensen met beperkte mobiliteit.\r\nDigitale projectie, geluid: Dolby Surround 7.1.\r\nVoor het volledige programma, klik hier: https://www.cinebaroxy.fr"
    ],
    "es": [
      "Cinéma le Roxy es un cine independiente, de una sola pantalla, con 183 butacas, clasificado como Art et Essai, accesible a las personas con movilidad reducida.\r\nProyección digital, sonido: Dolby Surround 7.1.\r\nPara consultar el programa completo, pulse aquí: https://www.cinebaroxy.fr"
    ]
  },
