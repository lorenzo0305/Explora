  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Aromen Südostasiens in Pont-en-Royans! Zubereitungen nach Art des Hauses! (Nems, Ravioli, Banh Mi, Frühlingsrollen, Sushi, Nudeln und gebratene Gerichte etc. ) zum Verzehr vor Ort, zum Mitnehmen oder Click and Collect von Ihrem Smartphone aus ."
    ],
    "en": [
      "Discover the flavours of Southeast Asia in Pont-en-Royans! Home-made preparations! (Nems, Raviolis, Banh Mi, Spring rolls, sushi, noodles and stir-fried dishes, etc. ) to eat in, take away, or Click and Collect from your smartphone."
    ],
    "it": [
      "Scoprite i sapori del Sud-Est asiatico a Pont-en-Royans! Preparazioni fatte in casa! (Nems, Ravioli, Banh Mi, Involtini primavera, sushi, noodles e piatti saltati in padella, ecc. ) da consumare, da portare via o da ritirare con lo smartphone."
    ],
    "fr": [
      "Découvrez les saveurs de l'Asie du Sud-Est à Pont-en-Royans ! Préparations maison ! (Nems, Raviolis, Banh Mi, Rouleaux printemps, sushis, nouilles et plats sautés etc. )  à consommer sur place, à emporter, ou Click and Collect depuis votre smartphone ."
    ],
    "es": [
      "¡Descubra los sabores del sudeste asiático en Pont-en-Royans! ¡Preparaciones caseras! (Nems, raviolis, banh mi, rollitos de primavera, sushi, fideos y platos salteados, etc. ) para comer en casa, llevar o hacer clic y recoger desde su smartphone."
    ],
    "nl": [
      "Ontdek de smaken van Zuidoost-Azië in Pont-en-Royans! Huisgemaakte bereidingen! (Nems, Ravioli, Banh Mi, loempia's, sushi, noedels en roerbakgerechten, enz. ) om te eten, mee te nemen of om af te halen met je smartphone."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Phoenix Pontois"
    ]
  },
