  "rdfs:comment": {
    "de": [
      "Das Logis hôtel du Haut Bugey*** empfängt Sie an 365 Tagen im Jahr. Geschäftsreise, touristischer Aufenthalt, Sportwettkampf... eine erstklassige Unterkunft im Stadtzentrum."
    ],
    "en": [
      "The Logis Hôtel du Haut Bugey*** welcomes you 365 days a year. Whether you're travelling on business, visiting tourists or taking part in a sporting event, the Logis Hotel du Haut Bugey is the perfect choice of accommodation in the town center."
    ],
    "it": [
      "Il Logis Hôtel du Haut Bugey*** vi accoglie 365 giorni all'anno. Che siate in viaggio per affari o per piacere, o che partecipiate a un evento sportivo, il Logis Hôtel du Haut Bugey offre una scelta di alloggi nel centro della città."
    ],
    "fr": [
      "Le Logis hôtel du Haut Bugey*** vous accueille 365 jours par an. Déplacement professionnel, séjour touristique, compétition sportive... un hébergement de choix en centre-ville."
    ],
    "nl": [
      "Het Logis Hôtel du Haut Bugey*** verwelkomt je 365 dagen per jaar. Of je nu op reis bent voor zaken of plezier, of deelneemt aan een sportevenement, het Logis Hôtel du Haut Bugey biedt een keuze aan accommodatie in het stadscentrum."
    ],
    "es": [
      "El Logis Hôtel du Haut Bugey*** le da la bienvenida los 365 días del año. Tanto si viaja por negocios como por placer o para participar en un evento deportivo, el Logis Hôtel du Haut Bugey le ofrece una selección de alojamientos en el centro de la ciudad."
    ]
  },
