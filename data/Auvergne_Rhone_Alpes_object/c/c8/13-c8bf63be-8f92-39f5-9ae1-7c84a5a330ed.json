  "rdfs:comment": {
    "de": [
      "An der Grenze zwischen der Provence und der Dauphiné bieten sich Ihnen eine Vielzahl von Landschaften, Farben, mittelalterlichen und hochgelegenen Dörfern. Ein gastfreundliches Gebiet, in dem Sie Wanderungen, Natur, Kulturerbe, Kunsthandwerk... erwarten."
    ],
    "en": [
      "On the border between Provence and the Dauphiné, a multitude of landscapes, colors, medieval villages and hilltop villages await you. A welcoming region where hiking, nature, heritage and arts and crafts await you..."
    ],
    "it": [
      "Al confine tra la Provenza e il Delfinato, una moltitudine di paesaggi, colori, villaggi medievali e collinari sono a vostra disposizione. Un territorio accogliente dove vi aspettano escursioni, natura, patrimonio, artigianato..."
    ],
    "fr": [
      "À la limite entre Provence et Dauphiné, une multitude de paysages, de couleurs, de villages médiévaux et perchés, s'offrent à vous. Un territoire accueillant où vous attendent randonnées, nature, patrimoine, métiers d'art..."
    ],
    "nl": [
      "Op de grens tussen de Provence en de Dauphiné wacht je een veelheid aan landschappen, kleuren en middeleeuwse en hooggelegen dorpjes. Het is een gastvrije plek waar je kunt genieten van wandelen, natuur, erfgoed, kunst en ambachten..."
    ],
    "es": [
      "En la frontera entre la Provenza y el Dauphiné, tiene a su disposición una multitud de paisajes, colores, pueblos medievales y de montaña. Un territorio acogedor donde le esperan el senderismo, la naturaleza, el patrimonio, la artesanía..."
    ]
  },
  "rdfs:label": {
    "fr": [
