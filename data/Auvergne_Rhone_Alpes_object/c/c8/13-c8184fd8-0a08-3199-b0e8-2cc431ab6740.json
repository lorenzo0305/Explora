  "rdfs:comment": {
    "de": [
      "Traditionelles Restaurant - Pizzeria - raffinierte Küche - gesellige Atmosphäre.\r\nFür eine schnelle Pause am Mittag oder bei einem guten Tropfen am Abend ... hier ist für jeden Geschmack etwas dabei!\r\nBei uns ist alles hausgemacht, sogar die Pommes frites!"
    ],
    "en": [
      "Traditional restaurant - pizzeria - fine cuisine - friendly atmosphere\r\nWhether for a quick lunch or an evening meal over a good bottle of wine... we have something for everyone!\r\nEverything is home-made, even the fries!"
    ],
    "it": [
      "Ristorante tradizionale - pizzeria - cucina raffinata - atmosfera accogliente.\r\nPer una pausa veloce a pranzo o con una buona bottiglia di vino la sera... ce n'è per tutti i gusti!\r\nTutto è fatto in casa, anche le patatine!"
    ],
    "fr": [
      "Restaurant traditionnel - pizzeria - cuisine raffinée - ambiance conviviale.\r\nPour une pause rapide le midi ou autour d'une bonne bouteille le soir ... il y en a pour tous les goûts !\r\nChez nous, tout est maison, même les frites !"
    ],
    "nl": [
      "Traditioneel restaurant - pizzeria - geraffineerde keuken - gemoedelijke sfeer.\r\nVoor een snelle middagpauze of met een heerlijke fles wijn 's avonds ... er is voor elk wat wils !\r\nBij ons is alles huisbereid, zelfs de frieten !"
    ],
    "es": [
      "Restaurante tradicional - pizzería - cocina refinada - ambiente acogedor.\r\nPara una pausa rápida a la hora de comer o con una buena botella de vino por la noche... ¡hay para todos los gustos!\r\nTodo es casero, ¡hasta las patatas fritas!"
    ]
  },
