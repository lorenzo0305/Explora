  "rdfs:comment": {
    "de": [
      "Gourmetküche in freundlicher und einladender Atmosphäre. Traditionelle französische Küche, Mitglied im Verband der Meister der Gastronomie („Maîtres Restaurateurs“); sehr schöne Terrasse mit Swimminpool im Sommer."
    ],
    "en": [
      "A gourmet restaurant in a friendly and warm setting. Traditional French cuisine and regional specialties (Vercors trout and ravioles du Dauphiné), a member of the Maîtres Restaurateurs. Very pleasant terrace with swimming pool in summer."
    ],
    "it": [
      "Il ristorante dell'hotel, Le Tétras, vi invita a un viaggio gastronomico in un ambiente eccezionale. Di fronte alle montagne del Vercors, godrete innanzitutto dello spettacolare panorama che la natura vi offre."
    ],
    "fr": [
      "Le restaurant de l'hôtel, le Tétras, vous invite à un voyage gourmand dans un cadre exceptionnel. Face aux montagnes du Vercors, vous goûterez tout d'abord au spectaculaire panorama que la nature vous offre."
    ],
    "nl": [
      "Het restaurant van het hotel, Le Tétras, nodigt u uit voor een gastronomische reis in een uitzonderlijk kader. Met uitzicht op het Vercors-gebergte zult u eerst genieten van het spectaculaire panorama dat de natuur biedt."
    ],
    "es": [
      "El restaurante del hotel, Le Tétras, le invita a un viaje gastronómico en un entorno excepcional. Frente a las montañas del Vercors, disfrutará primero del espectacular panorama que le ofrece la naturaleza."
    ]
  },
