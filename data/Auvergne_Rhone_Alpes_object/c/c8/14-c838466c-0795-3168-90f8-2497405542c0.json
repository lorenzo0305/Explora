  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/3680b813-8d0a-358a-bd12-6e9b6b965dfc",
      "dc:description": {
        "de": [
          "Das Festkomitee von Verchocq veranstaltet am Sonntag, den 3. August 2025 sein traditionelles Feldfest\nFür eine 11. Ausgabe! Freier Eintritt, Getränkestand, Verpflegung und Animationen vor Ort, kommen Sie zahlreich!"
        ],
        "en": [
          "The Comité des Fêtes de Verchocq organizes its traditional fête champêtre on Sunday, August 3, 2025\nFor the 11th time! Free admission, refreshments, food and entertainment on site, so come one, come all!"
        ],
        "it": [
          "Il Comitato delle Feste di Verchocq organizza la sua tradizionale festa campestre domenica 3 agosto 2025\nPer l'undicesima volta! Ingresso libero, bar, cibo e intrattenimento sul posto, quindi venite tutti!"
        ],
        "fr": [
          "Le Comité des Fêtes de Verchocq organise sa traditionnelle fête champêtre le dimanche 3 août 2025\nPour une 11ème édition ! Entrée gratuite, buvette, restauration et animations sur place, venez nombreux !"
        ],
        "nl": [
          "Het Comité des Fêtes de Verchocq organiseert zijn traditionele fête champêtre op zondag 3 augustus 2025\nVoor de 11e keer! Gratis toegang, bar, eten en entertainment ter plaatse, dus komt allen!"
        ],
        "es": [
          "El Comité des Fêtes de Verchocq organiza su tradicional fiesta de champán el domingo 3 de agosto de 2025\nPor undécima vez Entrada gratuita, bar, comida y animación in situ, así que ¡vengan todos!"
        ]
      },
