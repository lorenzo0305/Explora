  "rdfs:comment": {
    "de": [
      "Das Hotel Eliova L'Eau Vive*** befindet sich 100m von den Linga-Liften entfernt, die den Zugang zum Skigebiet \"Les Portes du Soleil\" gewährleisten."
    ],
    "en": [
      "The Hotel Eliova L'Eau Vive*** is located 100m from the ski lifts of the Linga that provide access to the ski area « Les Portes du Soleil »."
    ],
    "it": [
      "L'hotel Eliova L'Eau Vive*** si trova a 100 metri dagli impianti di risalita Linga, che danno accesso al comprensorio sciistico \"Les Portes du Soleil\"."
    ],
    "fr": [
      "L'hôtel Eliova L'Eau Vive*** est situé à 100m des remontées mécaniques du Linga, qui assurent l'accès au domaine skiable « Les Portes du Soleil »."
    ],
    "nl": [
      "Het Eliova L'Eau Vive*** hotel ligt op 100 meter van de Linga skiliften, die toegang bieden tot het \"Les Portes du Soleil\" skigebied."
    ],
    "es": [
      "El hotel Eliova L'Eau Vive*** se encuentra a 100 m de los remontes de Linga, que dan acceso al dominio esquiable de \"Les Portes du Soleil\"."
    ]
  },
