  "rdfs:comment": {
    "de": [
      "Angelstrecke in einem Fluss der ersten Kategorie, die von der AAPPMA de l'Albanais verwaltet wird, in einem natürlichen Rahmen, der für das Angeln in Wildwasser geeignet ist. Vorkommen von Bachforelle, Äsche, Groppe, Schmerle und Cypriniden."
    ],
    "en": [
      "First category river fishing course, managed by AAPPMA de l'Albanais, in a natural setting ideal for whitewater fishing. Species include brown trout, grayling, sculpin, loche franche and cyprinids."
    ],
    "it": [
      "Corso di pesca fluviale di prima categoria, gestito dall'AAPPMA de l'Albanais, in un ambiente naturale favorevole alla pesca in acque bianche. Ospita trote fario, temoli, sculpin, loche fario e ciprinidi."
    ],
    "fr": [
      "Parcours de pêche en rivière de première catégorie, géré par l’AAPPMA de l'Albanais, dans un cadre naturel propice à la pêche en eau vive. Présence de truite fario, ombre commun, chabot, loche franche et cyprinidés."
    ],
    "nl": [
      "Riviervisbaan van de eerste categorie, beheerd door de AAPPMA de l'Albanais, in een natuurlijke omgeving die bevorderlijk is voor wildwatervissen. De habitat van beekforel, vlagzalm, schartong, bruine loche en karperachtigen."
    ],
    "es": [
      "Curso de pesca fluvial de primera categoría, gestionado por la AAPPMA de l'Albanais, en un entorno natural propicio para la pesca en aguas bravas. Acoge truchas marrones, tímalos, escórporas, lochas marrones y ciprínidos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parcours pêche \"Le Chéran \" - Rumilly"
    ]
  },
