  "rdfs:comment": {
    "de": [
      "Dieses viertägige Festival feiert Amerika und insbesondere den Country mit Country-Konzerten, Tanzkursen, Reitvorführungen, Kunsthandwerk und Unterhaltung für die ganze Familie."
    ],
    "en": [
      "This 4-day festival celebrates America, and especially country music, with country concerts, dance workshops, horse shows, crafts and entertainment for the whole family."
    ],
    "it": [
      "Questo festival di 4 giorni celebra l'America e la musica country in particolare, con concerti country, workshop di danza, spettacoli di cavalli, arti e mestieri e intrattenimento per tutta la famiglia."
    ],
    "fr": [
      "Ce festival de 4 jours célèbre l’Amérique et tout particulièrement la country à travers des concerts de country, des stages de danses, des spectacles équestres, de l’artisanat et des animations pour toute la famille."
    ],
    "es": [
      "Este festival de 4 días celebra América y la música country en particular, con conciertos de country, talleres de baile, espectáculos ecuestres, artesanía y entretenimiento para toda la familia."
    ],
    "nl": [
      "Dit 4-daagse festival viert Amerika en countrymuziek in het bijzonder, met countryconcerten, dansworkshops, paardenshows, ambachten en entertainment voor het hele gezin."
    ]
  },
  "rdfs:label": {
