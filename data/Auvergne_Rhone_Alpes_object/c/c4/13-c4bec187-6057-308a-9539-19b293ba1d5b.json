  "rdfs:comment": {
    "de": [
      "Folgen Sie dem kleinen Julien und seinem Opa auf einer herzlichen Entdeckungsreise durch dieses kleine Dorf in der Drôme...\r\n\r\nJulien hat ungefähr eine Stunde Zeit, bevor Opa sein Mittagsschläfchen machen möchte, also seien Sie nicht zu spät!"
    ],
    "en": [
      "Follow little Julien, and his grandpa, for a warm-hearted discovery of this little Drôme village...\r\n\r\nJulien has about 1 hour before Grandpa wants to take his nap, so don't be late!"
    ],
    "it": [
      "Seguite il piccolo Julien e suo nonno nell'esplorazione di questo piccolo villaggio della Drôme...\r\n\r\nJulien ha circa un'ora prima che il nonno faccia il suo pisolino, quindi non fate tardi!"
    ],
    "fr": [
      "Suivez le petit Julien, et son papi, pour une découverte chaleureuse de ce petit village drômois...\r\n\r\nJulien dispose d'environ 1h avant que papi veuille faire sa sieste, ne soyez pas en retard !"
    ],
    "nl": [
      "Volg de kleine Julien en zijn opa terwijl ze dit kleine dorpje in de Drôme verkennen...\r\n\r\nJulien heeft ongeveer 1 uur voordat opa zijn dutje wil doen, dus kom niet te laat!"
    ],
    "es": [
      "Siga al pequeño Julien y a su abuelo mientras exploran este pequeño pueblo de la Drôme...\r\n\r\nJulien tiene aproximadamente 1 hora antes de que el abuelo quiera echarse la siesta, ¡así que no llegues tarde!"
    ]
  },
