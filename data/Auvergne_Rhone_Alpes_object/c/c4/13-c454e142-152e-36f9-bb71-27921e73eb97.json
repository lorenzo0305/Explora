  "rdfs:comment": {
    "de": [
      "In meinem Geschäft am Place de l'Hôtel de Ville produziere ich in reiner Handarbeit einzigartige Keramiken oder Keramiken in limitierter Auflage, sowohl für künstlerische Zwecke als auch für den Gebrauch. Ich gebe auch Kurse."
    ],
    "en": [
      "Based in my boutique on Place de l'Hôtel de Ville, I produce one-of-a-kind and limited edition ceramics, both artistic and utilitarian, using entirely traditional methods."
    ],
    "it": [
      "Nel mio negozio di Place de l'Hôtel de Ville, produco interamente a mano ceramiche uniche o in edizione limitata, sia artistiche che utilitarie, e tengo anche corsi."
    ],
    "fr": [
      "Installé dans ma boutique place de l'hôtel de ville, je produis de manière entièrement artisanale des céramiques uniques ou en série limitée, tant artistiques, qu'utilitaires. je donne également des cours."
    ],
    "nl": [
      "Vanuit mijn winkel op het Place de l'Hôtel de Ville maak ik eenmalige keramiek of beperkte oplages, zowel artistiek als utilitair, volledig met de hand. Ik geef ook cursussen."
    ],
    "es": [
      "Desde mi tienda de la Place de l'Hôtel de Ville, realizo cerámicas únicas o ediciones limitadas, tanto artísticas como utilitarias, totalmente a mano. También imparto cursos."
    ]
  },
  "rdfs:label": {
