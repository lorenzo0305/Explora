  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/22d4b133-5142-3c2f-b1cb-14f0d1d08eb2",
      "dc:description": {
        "de": [
          "Entdecken Sie die ungeahnten Wunder des Bodenlebens, wo Insekten und andere kleine Tiere in Harmonie zusammenarbeiten, um unseren Boden zu ernähren und zu belüften."
        ],
        "en": [
          "Come and discover the unsuspected wonders of soil life, where insects and other small creatures work in harmony to nourish and aerate our soil."
        ],
        "it": [
          "Venite a scoprire le insospettabili meraviglie della vita del suolo, dove insetti e altre piccole creature lavorano in armonia per nutrire e aerare il nostro terreno."
        ],
        "fr": [
          "Venez découvrir les merveilles insoupçonnées de la vie du sol, où les insectes et d’autres petites bêtes travaillent en harmonie pour nourrir et aérer notre sol."
        ],
        "es": [
          "Venga a descubrir las insospechadas maravillas de la vida del suelo, donde insectos y otras pequeñas criaturas trabajan en armonía para nutrir y airear nuestra tierra."
        ],
        "nl": [
          "Kom en ontdek de onvermoede wonderen van het bodemleven, waar insecten en andere kleine wezens in harmonie samenwerken om onze bodem te voeden en te beluchten."
        ]
      },
