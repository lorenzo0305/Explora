  "rdfs:comment": {
    "de": [
      "Lassen Sie sich in eine Welt der Entspannung entführen, mit Dampfbad, Sauna, eigenem Jacuzzi, Peeling, Solo- oder Duo-Massage und Schönheitsbehandlungen. Bodhi spa lädt Sie ein, ein erholsames Wellnesszentrum zu entdecken."
    ],
    "en": [
      "We'll take you to a world of relaxation with a hammam, sauna, private jacuzzi, body scrub, solo or duo massage and beauty treatments. Come and discover a relaxing wellness center."
    ],
    "it": [
      "Lasciatevi trasportare in un mondo di relax con un bagno turco, una sauna, una vasca idromassaggio privata, uno scrub per il corpo, un massaggio individuale o in coppia e trattamenti di bellezza. La Bodhi spa vi invita a scoprire un centro benessere rilassante."
    ],
    "fr": [
      "Laissez-vous flotter dans un univers de détente dépaysant avec hammam, sauna, jacuzzi privatif, gommage, massage solo ou duo et soins esthétiques. Bodhi spa vous invite à découvrir un centre de bien-être reposant."
    ],
    "nl": [
      "Laat je meevoeren naar een wereld van ontspanning met een stoombad, sauna, privéjacuzzi, bodyscrub, solo- of duomassage en schoonheidsbehandelingen. Bodhi spa nodigt je uit om een ontspannend wellnesscentrum te ontdekken."
    ],
    "es": [
      "Déjese llevar a un mundo de relajación con un baño de vapor, sauna, jacuzzi privado, exfoliación corporal, masajes en solitario o en dúo y tratamientos de belleza. El spa Bodhi le invita a descubrir un relajante centro de bienestar."
    ]
  },
