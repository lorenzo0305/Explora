  "rdfs:comment": {
    "de": [
      "Dieser einfache grüne Pfad führt durch den Wald, und es macht Spaß, die Tiere und ihre Rufe zu erkennen"
    ],
    "ru": [
      "Пройдите по лесной тропе, развлекаясь в поисках животных, узнавая их крики..."
    ],
    "en": [
      "Follow the slope through the forest; learn about the animal tracks and have fun learning to recognise their calls..."
    ],
    "it": [
      "Seguite questo facile sentiero verde attraverso la foresta e divertitevi a individuare gli animali e a riconoscere i loro richiami?"
    ],
    "fr": [
      "Parcourez cette piste verte très facile qui chemine dans la forêt, et amusez-vous à repérer les animaux et à reconnaître leurs cris…"
    ],
    "nl": [
      "Volg dit gemakkelijke groene pad door het bos en beleef plezier aan het spotten van de dieren en het herkennen van hun roep... Dit jaar heeft het dierenpad een nieuwe look met nieuwe spelletjes en meer mooie en realistische dieren dan ooit."
    ],
    "es": [
      "Siga este sencillo sendero verde a través del bosque y diviértase observando a los animales y reconociendo sus gritos.."
    ]
  },
  "rdfs:label": {
    "ru": [
      "Трасса диких животных"
    ],
    "en": [
      "Animals tracks"
    ],
    "fr": [
      "La Piste des animaux"
    ],
    "nl": [
      "Het dierenspoor"
    ]
  },
