  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/1a7ec9c9-0a99-3bad-8235-fb24ea039ea0",
      "dc:description": {
        "de": [
          "Herstellung von Mehl aus alten Sorten: Weizen-, Roggen- und Einkornmehl, Bio-Futtermischung für Hühner und Schafe.\nVerkauf von kleinen Strohballen.\nDirektverkauf ab Hof (auf Bestellung) und andere Vertriebsnetze."
        ],
        "en": [
          "Production of flours of old varieties: wheat, rye and small spelt flour, organic fodder mix for chickens and sheep.\nSale of small bales of straw.\nDirect sale on the farm (to order) and other distribution networks."
        ],
        "it": [
          "Produzione di farine all'antica: farina di frumento, di segale e di farro piccolo, miscela di mangimi biologici per polli e pecore.\nVendita di piccole balle di paglia.\nVendita diretta in azienda (su ordinazione) e altre reti di distribuzione."
        ],
        "fr": [
          "Production de farines de variétés anciennes : farine de blé, de seigle et petit épeautre, mélange fourrager bio pour poules et moutons.\nVente de petits ballots de paille.\nVente directe sur exploitation (sur commande) et autres réseaux de distribution."
        ],
        "nl": [
          "Productie van ouderwets meel: tarwe-, rogge- en klein speltmeel, biologische voedermix voor kippen en schapen.\nVerkoop van kleine strobalen.\nRechtstreekse verkoop op de boerderij (op bestelling) en andere distributienetwerken."
        ],
        "es": [
          "Producción de harinas artesanales: harina de trigo, centeno y espelta pequeña, mezcla de piensos ecológicos para pollos y ovejas.\nVenta de pequeñas balas de paja.\nVenta directa en la explotación (por encargo) y otras redes de distribución."
        ]
      },
      "@type": [
        "Description"
      ],
