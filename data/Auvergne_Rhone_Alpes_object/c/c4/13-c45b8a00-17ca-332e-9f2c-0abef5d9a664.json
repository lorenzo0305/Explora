  "rdfs:comment": {
    "de": [
      "Le Burger Bressan bietet Burger aus Aindino an.\r\nSie arbeiten mit Produkten von lokalen Produzenten wie Brot, Fleisch und Kartoffeln, aber vor allem ohne Tiefkühlprodukte."
    ],
    "en": [
      "Le Burger Bressan offers burgers from Aindin.\r\nIt's run by a duo who work with products sourced from local producers, such as bread, meat and potatoes; but above all, no frozen products."
    ],
    "it": [
      "Le Burger Bressan offre hamburger di Aindin.\r\nÈ gestito da un duo che lavora con prodotti di produttori locali, come pane, carne e patate, ma soprattutto senza prodotti surgelati."
    ],
    "fr": [
      "Le Burger Bressan propose des burgers aindinois.\r\nÀ sa tête, un duo qui travaille avec des produits provenant de producteurs locaux comme le pain, la viande, les pommes de terre ; mais surtout sans produit surgelé."
    ],
    "es": [
      "Le Burger Bressan ofrece hamburguesas de Aindin.\r\nEstá regentado por un dúo que trabaja con productos de productores locales, como pan, carne y patatas, pero sobre todo sin productos congelados."
    ],
    "nl": [
      "Le Burger Bressan biedt burgers uit Aindin.\r\nHet wordt gerund door een duo dat werkt met producten van lokale producenten, zoals brood, vlees en aardappelen, maar vooral geen diepvriesproducten."
    ]
  },
  "rdfs:label": {
