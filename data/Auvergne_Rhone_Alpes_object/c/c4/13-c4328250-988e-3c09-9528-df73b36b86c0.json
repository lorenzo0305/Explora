  "rdfs:comment": {
    "de": [
      "Lassen Sie Ihr Fahrrad oder Ihren Roller reparieren oder warten! Bruno empfängt Sie in seiner Werkstatt in Montmerle sur Saône, 100 Meter von der Voie Bleue entfernt, von Dienstag bis Sonntag und steht Ihnen mit Rat und Tat zur Seite!"
    ],
    "en": [
      "Get your bike or scooter repaired or serviced! Bruno welcomes you to his workshop in Montmerle sur Saône, 100 metres from the Voie Bleue, from Tuesday to Sunday, where you can benefit from his advice and expertise! Second-hand bikes and spare parts are also available on site."
    ],
    "it": [
      "Fate riparare o revisionare la vostra bicicletta o il vostro scooter! Bruno vi accoglie nella sua officina di Montmerle sur Saône, a 100 metri dalla Voie Bleue, dal martedì alla domenica, dove potrete beneficiare dei suoi consigli e della sua esperienza!"
    ],
    "fr": [
      "Faites réparer ou entretenir votre vélo ou votre trottinette ! Bruno vous accueille dans son atelier à Montmerle sur Saône, à 100 mètres de la Voie Bleue, du mardi au dimanche et vous apporte son conseil et son expertise !"
    ],
    "es": [
      "Repare o revise su bicicleta o scooter Bruno te recibe en su taller de Montmerle sur Saône, a 100 metros de la Voie Bleue, de martes a domingo, donde podrás beneficiarte de sus consejos y experiencia"
    ],
    "nl": [
      "Laat je fiets of scooter repareren of onderhouden! Bruno verwelkomt je van dinsdag tot zondag in zijn werkplaats in Montmerle sur Saône, op 100 meter van de Voie Bleue, waar je kunt profiteren van zijn advies en expertise!"
    ]
  },
