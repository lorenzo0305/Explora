  "rdfs:comment": {
    "de": [
      "Entdecken Sie mit Fifamé das Spiel \"L'Ouïe\", ein Spiel zum Zuhören und Teilen.\r\n\r\nEs ist die Lust, das Schöne im Leben zu feiern und das, was noch nicht so schön ist, zu verschönern."
    ],
    "en": [
      "Come and discover the game of hearing, a game of listening and sharing with Fifamé.\r\n\r\nIt's about celebrating what's beautiful in life and embellishing what's not yet beautiful."
    ],
    "it": [
      "Venite a scoprire il gioco dell'udito, un gioco di ascolto e condivisione con Fifamé.\r\n\r\nSi tratta di celebrare ciò che di bello c'è nella vita e di abbellire ciò che non è ancora bello."
    ],
    "fr": [
      "Venez découvrir le jeu de l'Ouïe, jeu d'écoute et de partage avec Fifamé.\r\n\r\nC'est l'envie de célébrer ce qu'il y a de beau dans la vie et d'enjoliver ce qui ne l'est pas encore."
    ],
    "es": [
      "Venga a descubrir el juego del oído, un juego de escuchar y compartir con Fifamé.\r\n\r\nSe trata de celebrar lo que es bello en la vida y embellecer lo que aún no lo es."
    ],
    "nl": [
      "Kom en ontdek het spel van horen, luisteren en delen met Fifamé.\r\n\r\nHet gaat over vieren wat mooi is in het leven en verfraaien wat nog niet mooi is."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Slam théâtre \"le jeu de l'ouïe\""
    ]
  },
