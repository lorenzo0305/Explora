  "rdfs:comment": {
    "de": [
      "Willkommen im MÖKKI, Ihrer hoch gelegenen Gourmethütte, wo sich Authentizität und Gastfreundschaft vor einem der schönsten Panoramen der Region begegnen."
    ],
    "en": [
      "Welcome to MÖKKI, your gourmet retreat perched high in the mountains, where authenticity and conviviality come together against one of the region's most beautiful panoramas."
    ],
    "it": [
      "Benvenuti al MÖKKI, il vostro rifugio gastronomico in alta montagna, dove autenticità e convivialità si fondono con uno dei panorami più belli della regione."
    ],
    "fr": [
      "Bienvenue au MÖKKI, votre refuge gourmand perché en altitude, où authenticité et convivialité se rencontrent face à l'un des plus beaux panoramas de la région."
    ],
    "nl": [
      "Welkom bij MÖKKI, uw gastronomische toevluchtsoord hoog in de bergen, waar authenticiteit en gezelligheid samenkomen met een van de mooiste uitzichten van de regio."
    ],
    "es": [
      "Bienvenido a MÖKKI, su refugio gastronómico encaramado en lo alto de la montaña, donde autenticidad y convivencia se dan la mano frente a uno de los panoramas más bellos de la región."
    ]
  },
