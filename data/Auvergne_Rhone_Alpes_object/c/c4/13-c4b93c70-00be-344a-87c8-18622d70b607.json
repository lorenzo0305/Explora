  "rdfs:comment": {
    "de": [
      "Das Le Mékong liegt nur wenige Schritte vom alten Zentrum von Chambéry entfernt und lädt Sie ein, seine chinesischen und vietnamesischen Spezialitäten zu probieren.\r\nSarom, Sothea und Dinette empfangen Sie mit einem Lächeln und bieten Ihnen eine Palette an hausgemachten und authentischen Gerichten an."
    ],
    "en": [
      "Chinese and Vietnamese cuisine"
    ],
    "it": [
      "Situato a pochi passi dal centro storico di Chambéry, Le Mékong vi invita a gustare le sue specialità cinesi e vietnamite.\r\nSarom, Sothea e Dinette vi accoglieranno con un sorriso e vi offriranno una gamma di piatti autentici e casalinghi."
    ],
    "fr": [
      "Situé à deux pas du centre ancien de Chambéry, Le Mékong vous invite à déguster ses spécialités chinoises et vietnamiennes.\r\nSarom, Sothea et Dinette vous recevront avec le sourire et vous proposeront une palette de mets faits maison et authentiques."
    ],
    "es": [
      "Situado a dos pasos del casco antiguo de Chambéry, Le Mékong le invita a degustar sus especialidades chinas y vietnamitas.\r\nSarom, Sothea y Dinette le recibirán con una sonrisa y le ofrecerán platos auténticos y caseros."
    ],
    "nl": [
      "Le Mékong ligt op een steenworp afstand van het oude stadscentrum van Chambéry en nodigt je uit om zijn Chinese en Vietnamese specialiteiten te proeven.\r\nSarom, Sothea en Dinette verwelkomen je met een glimlach en bieden je een reeks authentieke, huisgemaakte gerechten."
    ]
  },
  "rdfs:label": {
    "en": [
      "Le Mekong"
    ],
