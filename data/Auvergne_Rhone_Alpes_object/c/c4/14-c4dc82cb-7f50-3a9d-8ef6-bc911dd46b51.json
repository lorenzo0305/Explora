        "de": [
          "Kleidung aus Kaschmir und Leinen für Frauen und Männer.\n\nTäglich von 10:00 bis 13:00 Uhr und von 14:30 bis 19:00 Uhr geöffnet."
        ],
        "en": [
          "Cashmere and linen garments for women and men.\n\nOpen daily from 10am to 1pm and from 2.30pm to 7pm."
        ],
        "it": [
