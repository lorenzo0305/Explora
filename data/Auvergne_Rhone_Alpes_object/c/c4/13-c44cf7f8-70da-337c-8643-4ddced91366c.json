  "rdfs:comment": {
    "de": [
      "Wir bieten Ihnen Privatunterricht im alpinen Skilauf, Skitouren abseits der Pisten und Freeride, Skitouren, Entdeckungsreisen zwischen den Skigebieten in der Haute Maurienne Vanoise, Sicherheitstrainings abseits der Pisten und Heliskiing."
    ],
    "en": [
      "We offer private alpine skiing lessons, off-piste and freeride skiing, cross-country skiing, inter-station discovery in Haute Maurienne Vanoise, off-piste safety training and heliskiing."
    ],
    "it": [
      "Offriamo lezioni private di sci alpino, sci fuoripista e freeride, sci alpinismo, scoperta interregionale della Haute Maurienne Vanoise, corsi di sicurezza fuoripista ed eliski."
    ],
    "fr": [
      "Nous vous proposons des cours particuliers de ski alpin, des sorties en ski hors-pistes et freeride, du ski de randonnée, de la découverte inter-stations en Haute Maurienne Vanoise, des formations sécurité hors-piste et de l'héliski."
    ],
    "nl": [
      "We bieden privélessen alpineskiën, off-piste en freeride skiën, langlaufen, ontdekking tussen stations in de Haute Maurienne Vanoise, veiligheidstrainingen buiten de piste en heliskiën."
    ],
    "es": [
      "Ofrecemos clases particulares de esquí alpino, esquí fuera de pista y freeride, esquí de travesía, descubrimiento entre estaciones en Haute Maurienne Vanoise, formación en seguridad fuera de pista y heliski."
    ]
  },
