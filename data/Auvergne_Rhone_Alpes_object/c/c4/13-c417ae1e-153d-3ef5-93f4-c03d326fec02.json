  "rdfs:comment": {
    "de": [
      "Sylviane Fourets imService. Julien Magne in der Küche. Diese beiden bilden ein unvergleichliches Duo,um eine Mahlzeit zu einem einzigartigen Moment werden zu lassen! Der Michelin-Führer hat sich nicht geirrt. Er hat ihnen einen Bib Gourmand verliehen..."
    ],
    "en": [
      "In this village of character, come discover a cuisine rich in flavours. \r\nFresh cuisine with flowers and plants. \r\nThe menu changes every month."
    ],
    "it": [
      "Sylviane Fourets, in servizio. Julien Magne, in cucina. Questi due formano un duo impareggiabile per rendere il vostro pasto un'esperienza unica!"
    ],
    "fr": [
      "Sylviane Fourets, au service. Julien Magne, en cuisine. Ces deux-là forment un duo sans pareil pour faire d’un repas un moment unique !"
    ],
    "nl": [
      "Sylviane Fourets, van dienst. Julien Magne, in de keuken. Deze twee vormen een ongeëvenaard duo om van uw maaltijd een unieke ervaring te maken!"
    ],
    "es": [
      "Sylviane Fourets, de servicio. Julien Magne, en la cocina. Ambos forman un dúo inigualable para hacer de su comida una experiencia única"
    ]
  },
