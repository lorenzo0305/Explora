  "rdfs:comment": {
    "de": [
      "Fühlen Sie sich bedrückt, müde, gestresst?\r\n\r\nWarum gönnen Sie sich nicht eine kleine Auszeit und kümmern sich um sich selbst?\r\nUnser Spa - Espace \"Bien être\" wird Sie mit einem idyllischen Rahmen verwöhnen!"
    ],
    "en": [
      "Feeling oppressed, tired, stressed?\r\n\r\nWhy don’t you take a little break and take care of yourself?\r\nOur SPA - Space \"Wellness\" will satisfy you, combining well-being and sweetness to an idyllic setting!"
    ],
    "it": [
      "Vi sentite oppressi, stanchi o stressati?\r\n\r\nPerché non prendersi una piccola pausa per rilassarsi e coccolarsi?\r\nLa nostra area SPA - Benessere vi delizierà, combinando benessere e morbidezza in un ambiente idilliaco!"
    ],
    "fr": [
      "Vous vous sentez oppressé, fatigué, stressé ?\r\n\r\nPourquoi ne pas vous offrir une petite pause détente, et prendre soin de vous ?\r\nNotre SPA - Espace \"Bien être\" saura vous combler, alliant bien-être et douceur à un cadre idyllique !"
    ],
    "es": [
      "¿Se siente oprimido, cansado o estresado?\r\n\r\n¿Por qué no se toma un pequeño descanso para relajarse y mimarse?\r\nNuestro espacio SPA - Bienestar le encantará, ya que combina bienestar y suavidad en un entorno idílico"
    ],
    "nl": [
      "Voel je je onderdrukt, moe of gestrest?\r\n\r\nWaarom neem je niet een kleine pauze om te ontspannen en jezelf te verwennen?\r\nOnze SPA - Wellnessruimte zal je verrukken, een combinatie van welzijn en zachtheid in een idyllische omgeving!"
    ]
  },
  "rdfs:label": {
    "de": [
      "Spa & Espace bien-être du Grand Hôtel de Paris"
    ],
    "en": [
      "Spa & Espace bien-être du Grand Hôtel de Paris"
    ],
    "fr": [
      "Spa & Espace bien-être du Grand Hôtel de Paris"
    ]
  },
