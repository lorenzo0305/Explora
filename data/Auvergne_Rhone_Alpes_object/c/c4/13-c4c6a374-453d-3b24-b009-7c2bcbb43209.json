  "rdfs:comment": {
    "de": [
      "Willkommen im Relais Cyné in St Sulpice les Rivoires. Wir können Sie für die Dauer eines Picknicks empfangen. Picknicktisch, Unterstand und Anbindestange für Pferde stehen Ihnen zur Verfügung."
    ],
    "en": [
      "Welcome to Relais Cyné in St Sulpice les Rivoires. We can welcome you for a picnic. We have a picnic table, a shelter and a tie-up bar for horses."
    ],
    "it": [
      "Benvenuti al Relais Cyné a St Sulpice les Rivoires. Possiamo accogliervi per un picnic. Abbiamo un tavolo da picnic, un riparo e una barra per legare i cavalli."
    ],
    "fr": [
      "Bienvenue au Relais Cyné de St Sulpice les Rivoires. Nous pouvons vous accueillir le temps d'un pique nique. Table de pique-nique, abri et barre d'attache pour chevaux sont mis à votre disposition."
    ],
    "nl": [
      "Welkom bij Relais Cyné in St Sulpice les Rivoires. We verwelkomen je graag voor een picknick. We hebben een picknicktafel, een schuilhut en een aanleghok voor paarden."
    ],
    "es": [
      "Bienvenido al Relais Cyné en St Sulpice les Rivoires. Podemos darle la bienvenida para un picnic. Tenemos una mesa de picnic, un refugio y un bar de amarre para caballos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Relais Cyné de St Suplice des Rivoires"
    ]
  },
