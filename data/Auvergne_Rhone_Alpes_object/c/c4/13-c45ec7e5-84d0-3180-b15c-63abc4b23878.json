  "rdfs:comment": {
    "de": [
      "\"Schwebende Tinte\". Yo eignet sich eine uralte japanische Technik an, \"Suminagashi\", bei der die Tinte mit dem Papier in einen Dialog tritt, bevor sie zu einer einzigartigen und unverwechselbaren Zeichnung führt."
    ],
    "en": [
      "\"Floating inks\". Yo appropriates an ancestral Japanese technique, \"Suminagashi\", in which the ink dialogues with the paper before resulting in a singular and unique drawing."
    ],
    "it": [
      "\"Inchiostri fluttuanti. Yo si appropria di una tecnica giapponese ancestrale, il \"Suminagashi\", in cui l'inchiostro dialoga con la carta per produrre un disegno unico e singolare."
    ],
    "fr": [
      "\"Encres flottantes\". Yo s'approprie une technique japonaise ancestrale, \"Suminagashi\", l'encre dialogue avec le papier avant d'aboutir à un dessin singulier et unique."
    ],
    "nl": [
      "\"Zwevende inkt. Yo maakt gebruik van een voorouderlijke Japanse techniek, \"Suminagashi\", waarbij de inkt in dialoog gaat met het papier om een unieke en bijzondere tekening te produceren."
    ],
    "es": [
      "\"Tintas flotantes Yo se apropia de una técnica ancestral japonesa, el \"Suminagashi\", en la que la tinta dialoga con el papel para producir un dibujo único y singular."
    ]
  },
