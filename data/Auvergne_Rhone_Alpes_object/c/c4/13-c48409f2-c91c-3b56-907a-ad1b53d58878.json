  "rdfs:comment": {
    "de": [
      "2 Gebrauchtwarenläden, Cusset für Möbel und schöne Dekorationsgegenstände, neue Matratzen und Lattenroste, große Haushaltsgeräte.\r\nCharmeil für den Trödelmarkt mit allem, was man in einer Wohnung finden kann."
    ],
    "en": [
      "2 second hand shops, Cusset for the furniture and beautiful decorative objects, new mattresses and bedsprings, large household appliances.\r\nCharmeil for the second-hand part with all that one can find in a house."
    ],
    "it": [
      "2 negozi di seconda mano, Cusset per mobili e splendidi oggetti decorativi, materassi e reti nuovi, grandi elettrodomestici.\r\nCharmeil per la parte di seconda mano con tutto ciò che si può trovare in una casa."
    ],
    "fr": [
      "2 magasin d'occasion , Cusset pour la partie mobilier et bel objet de décoration, matelas et sommiers neuf, gros électroménager.\r\nCharmeil pour la partie brocante avec tout ce qu'on peut trouver dans une habitation."
    ],
    "nl": [
      "2 tweedehands winkels, Cusset voor meubels en mooie decoratieve voorwerpen, nieuwe matrassen en bedsprings, grote huishoudelijke apparaten.\r\nCharmeil voor het tweedehands gedeelte met alles wat je in een huis kunt vinden."
    ],
    "es": [
      "2 tiendas de segunda mano, Cusset para muebles y bellos objetos de decoración, colchones y muelles nuevos, grandes electrodomésticos.\r\nCharmeil para la parte de segunda mano con todo lo que se puede encontrar en una casa."
    ]
  },
