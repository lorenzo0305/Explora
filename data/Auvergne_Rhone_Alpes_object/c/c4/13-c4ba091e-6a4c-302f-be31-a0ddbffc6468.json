  "rdfs:comment": {
    "de": [
      "Fünf Tagungsräume, darunter ein modulierbarer Konferenzraum für bis zu 200 Personen (Großleinwand, Led-Laser-Beamer Ful HD, Laptop, Mikrofone, PC-Anschlüsse, WLAN), geschlossener Parkplatz."
    ],
    "en": [
      "Five meeting rooms, including 1 modular conference room for up to 200 people (large screen, full HD Led laser video projector, laptop, microphones, PC sockets, wifi), enclosed parking lot."
    ],
    "it": [
      "Cinque sale riunioni, tra cui 1 sala conferenze modulare per un massimo di 200 persone (grande schermo, videoproiettore laser full HD Led, laptop, microfoni, prese per PC, wifi), parcheggio recintato."
    ],
    "fr": [
      "Cinq salles de réunion dont 1 salle de conférence modulable pouvant accueillir jusqu'à 200 personnes (grand écran, vidéoprojecteur Led laser ful HD, ordinateur portable, micros, prises PC, wifi), un parking clos."
    ],
    "nl": [
      "Vijf vergaderzalen, waaronder 1 flexibele conferentieruimte voor maximaal 200 personen (groot scherm, Full HD Led-laservideoprojector, laptop, microfoons, pc-aansluitingen, wifi), afgesloten parkeerplaats."
    ],
    "es": [
      "Cinco salas de reuniones, incluida 1 sala de conferencias modular para un máximo de 200 personas (pantalla grande, proyector de vídeo láser Led Full HD, ordenador portátil, micrófonos, enchufes para PC, wifi), aparcamiento cerrado."
    ]
  },
