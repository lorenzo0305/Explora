      "schema:openingHoursSpecification": [
        {
          "@id": "https://data.datatourisme.fr/59ca5d57-0170-3b55-a65a-e841df863637",
          "schema:validFrom": "2026-01-01T00:00:00",
          "schema:validThrough": "2026-12-31T23:59:59",
          "@type": [
            "schema:OpeningHoursSpecification"
          ],
          "additionalInformation": {
            "de": [
              "Empfang nur von Montag bis Freitag von 9:00 bis 12:00 Uhr und von 14:00 bis 17:00 Uhr möglich. Samstagvormittag nach Vereinbarung je nach Verfügbarkeit.\r\n\r\nGruppen können nach Absprache auch außerhalb dieser Zeiten empfangen werden.\r\n\r\nDie Mahlzeiten müssen 48 Stunden im Voraus bestellt werden und für Gruppen ist eine Vorreservierung mindestens 10 Tage im Voraus erforderlich."
            ],
            "en": [
              "Open Monday to Friday, 9am to 12pm and 2pm to 5pm. Saturday mornings by appointment ? to be agreed according to availability.\r\n\r\nGroups welcome by appointment outside these hours.\r\n\r\nMeals must be ordered 48 hours in advance, and for groups a pre-reservation is required at least 10 days in advance."
            ],
            "it": [
              "Aperto dal lunedì al venerdì, dalle 9.00 alle 12.00 e dalle 14.00 alle 17.00. Sabato mattina su appuntamento da concordare in base alla disponibilità.\r\n\r\nI gruppi sono benvenuti su appuntamento al di fuori di questi orari.\r\n\r\nI pasti devono essere ordinati con 48 ore di anticipo e i gruppi devono prenotare con almeno 10 giorni di anticipo."
            ],
            "fr": [
              "Accueil uniquement possible du lundi au vendredi de 9h à 12h et de 14h à 17h. Le samedi matin sur rdv – à convenir en fonction de nos disponibilités.\r\n\r\nAccueil groupes possible sur rendez-vous en dehors de ces horaires.\r\n\r\nLes repas doivent être commandés 48h à l'avance et pour les groupes une pré-réservation est nécessaire au minimum 10 jours auparavant."
            ],
            "nl": [
              "Open van maandag tot vrijdag van 9 tot 12 uur en van 14 tot 17 uur. Zaterdagochtend op afspraak, afhankelijk van beschikbaarheid.\r\n\r\nGroepen zijn welkom op afspraak buiten deze tijden.\r\n\r\nMaaltijden moeten 48 uur van tevoren worden besteld en groepen moeten ten minste 10 dagen van tevoren reserveren."
            ],
            "es": [
              "Abierto de lunes a viernes, de 9.00 a 12.00 y de 14.00 a 17.00 horas. Sábados por la mañana con cita previa a convenir según disponibilidad.\r\n\r\nSe admiten grupos con cita previa fuera de estos horarios.\r\n\r\nLas comidas deben encargarse con 48 horas de antelación y los grupos deben reservar con al menos 10 días de antelación."
            ]
          },
