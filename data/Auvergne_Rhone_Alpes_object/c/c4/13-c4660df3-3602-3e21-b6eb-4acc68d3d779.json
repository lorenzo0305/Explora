  "rdfs:comment": {
    "de": [
      "In meinem Atelier in Doizieux bringe ich Stühle, Sessel, Bänke und Sofas mithilfe traditioneller (Gurte, Federn, Pflanzenhaar, Jutegewebe) oder moderner (Schaumstoff) Polstertechniken wieder in Form."
    ],
    "en": [
      "In my workshop in Doizieux, I refurbish chairs, armchairs, benches and sofas using traditional upholstery techniques (webbing, springs, horsehair, jute cloth) or modern ones (foam)."
    ],
    "it": [
      "Nel mio laboratorio di Doizieux, restauro sedie, poltrone, panche e divani utilizzando tecniche di rivestimento tradizionali (fettucce, molle, peli di piante, tela di juta) o moderne (schiuma)."
    ],
    "fr": [
      "Dans mon atelier à Doizieux, je remets en état chaises, fauteuils, banquettes et canapés par le biais de techniques de tapisserie traditionnelles (sangles, ressorts, crins végétal, toiles de jute) ou modernes (en mousse)."
    ],
    "nl": [
      "In mijn atelier in Doizieux restaureer ik stoelen, fauteuils, banken en sofa's met behulp van traditionele stofferingstechnieken (singels, veren, plantenhaar, jutedoek) of moderne technieken (schuim)."
    ],
    "es": [
      "En mi taller de Doizieux, restauro sillas, sillones, bancos y sofás utilizando técnicas de tapicería tradicionales (cinchas, muelles, pelo vegetal, tela de yute) o modernas (espuma)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Strega Tapisserie"
    ]
  },
