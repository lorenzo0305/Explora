  "rdfs:comment": {
    "de": [
      "Bei Crescendo Couture entwerfe ich Zero-Waste-Textilaccessoires und ökologisch verantwortungsvolle Produkte, die in meinem Atelier in Saint Ennemond mit Sorgfalt hergestellt werden. Mein Ziel ist es, Ästhetik, Praktikabilität und Umweltschutz miteinander zu verbinden."
    ],
    "en": [
      "At Crescendo Couture, I create zero-waste textile accessories and eco-responsible products, carefully crafted in my workshop in Saint Ennemond. My aim is to combine aesthetics, practicality and respect for the environment."
    ],
    "it": [
      "In Crescendo Couture creo accessori tessili a zero rifiuti e prodotti eco-responsabili, realizzati con cura nel mio laboratorio di Saint Ennemond. Il mio obiettivo è coniugare estetica, praticità e rispetto per l'ambiente."
    ],
    "fr": [
      "Chez Crescendo Couture, je crée des accessoires textiles zéro déchet et des produits éco-responsables, confectionnés avec soin dans mon atelier à Saint Ennemond. Mon objectif est d’allier esthétique, praticité et respect de l’environnement."
    ],
    "es": [
      "En Crescendo Couture, creo accesorios textiles de residuo cero y productos ecorresponsables, cuidadosamente elaborados en mi taller de Saint Ennemond. Mi objetivo es combinar estética, practicidad y respeto por el medio ambiente."
    ],
    "nl": [
      "Bij Crescendo Couture creëer ik zero-waste textielaccessoires en eco-verantwoorde producten, zorgvuldig vervaardigd in mijn atelier in Sint Ennemond. Mijn doel is om esthetiek, functionaliteit en respect voor het milieu te combineren."
    ]
  },
