      "dc:description": {
        "de": [
          "Le Germoir lädt Sie ein, um sein 20-jähriges Bestehen zu feiern!\nWir treffen uns am Samstag, den 28. Juni ab 15 Uhr in Ambricourt\nInformationen unter 03 21 04 39 69"
        ],
        "en": [
          "Le Germoir invites you to celebrate its 20th anniversary!\nJoin us on Saturday June 28 at 3pm in Ambricourt\nInformation on 03 21 04 39 69"
        ],
        "it": [
          "Le Germoir vi invita a festeggiare il suo 20° anniversario!\nUnitevi a noi sabato 28 giugno alle 15:00 ad Ambricourt\nPer maggiori informazioni, chiamare il numero 03 21 04 39 69"
        ],
        "fr": [
          "Le Germoir vous invite pour célébrer ses 20 ans ! \nRendez-vous le samedi 28 juin dès 15h à Ambricourt\nInformations au 03 21 04 39 69"
        ],
        "nl": [
          "Le Germoir nodigt u uit om zijn 20e verjaardag te vieren!\nKom op zaterdag 28 juni om 15u naar Ambricourt\nVoor meer informatie, bel 03 21 04 39 69"
        ],
        "es": [
          "Le Germoir le invita a celebrar su 20 aniversario\nÚnase a nosotros el sábado 28 de junio a las 15.00 horas en Ambricourt\nPara más información, llame al 03 21 04 39 69"
        ]
      },
