  "rdfs:comment": {
    "de": [
      "Am Ausgang der Gorges des Gâts empfängt Sie Barbara auf ihrem rustikalen und authentischen Reiterhof für Ponyausritte und Wanderungen, Kurse und Wanderritte im Herzen des Naturparks Vercors zwischen den Bergen Toussière und Jocou."
    ],
    "en": [
      "At the mouth of the Gorges des Gâts, Barbara welcomes you to her rustic, authentic equestrian farm for pony treks, trail rides, lessons and horseback riding in the heart of the Vercors Natural Park, between the Toussière and Jocou mountains."
    ],
    "it": [
      "All'imboccatura delle Gorges des Gâts, Barbara vi accoglie nella sua fattoria equestre rustica e autentica per passeggiate con i pony, percorsi, lezioni ed escursioni a cavallo nel cuore del Parco Naturale del Vercors, tra le montagne Toussière e Jocou."
    ],
    "fr": [
      "Au débouché des gorges des Gâts, Barbara vous accueille dans sa ferme équestre rustique et authentique pour des balades à poney et des randos, cours et itinérance à cheval au coeur du parc naturel du Vercors entre les montagnes de Toussière et du Jocou."
    ],
    "es": [
      "En la desembocadura de las Gorges des Gâts, Barbara le da la bienvenida a su granja ecuestre rústica y auténtica para realizar excursiones en poni, paseos por senderos, clases y paseos a caballo en el corazón del Parque Natural de Vercors, entre las montañas de Toussière y Jocou."
    ],
    "nl": [
      "Aan de monding van de Gorges des Gâts heet Barbara je welkom op haar rustieke en authentieke paardenboerderij voor ponytochten, buitenritten, lessen en paardrijden in het hart van het Natuurpark Vercors tussen de bergen Toussière en Jocou."
    ]
  },
  "rdfs:label": {
