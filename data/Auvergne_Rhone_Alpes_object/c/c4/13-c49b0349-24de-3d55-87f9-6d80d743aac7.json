  "rdfs:comment": {
    "de": [
      "Am Rande der Drôme Provençale, im Herzen des malerischen Dorfes, auf dem Platz, wo jeden Montagmorgen der Markt stattfindet, erwartet Sie ein freundlicher und persönlicher Empfang. Vor Ort: kostenloses WIFI Cigale, Boutique."
    ],
    "en": [
      "At the gateway to the Drôme Provençale, at the heart of the picturesque village, overlooking the market square of the village, we offer you a personnalised welcoming and a rich documentation at your disposal."
    ],
    "it": [
      "Alle porte della Drôme Provençale, nel cuore del pittoresco villaggio, sulla piazza dove si svolge il mercato ogni lunedì mattina, un'accoglienza cordiale e personale. In loco: WIFI gratuito Cigale, negozio."
    ],
    "fr": [
      "Aux portes de la Drôme Provençale, au cœur du village pittoresque, sur la place où se déroule le marché chaque lundi matin, un accueil convivial et personnalisé. Sur place : WIFI Cigale gratuit, boutique."
    ],
    "nl": [
      "Aan de poort van de Drôme Provençale, in het hart van het pittoreske dorpje, op het plein waar elke maandagochtend de markt plaatsvindt, wacht u een vriendelijk en persoonlijk onthaal. Ter plaatse: gratis Cigale WIFI, winkel."
    ],
    "es": [
      "A las puertas de la Drôme Provençale, en el corazón del pintoresco pueblo, en la plaza donde se celebra el mercado cada lunes por la mañana, una acogida cordial y personal. En el lugar: WIFI Cigale gratuito, tienda."
    ]
  },
  "rdfs:label": {
