  "rdfs:comment": {
    "de": [
      "Teams Connect: Agentur, die sich auf Team Buildings für Unternehmen spezialisiert hat, in Form von Präsenz- oder Fernveranstaltungen, die den Teamzusammenhalt, das Zugehörigkeitsgefühl und die Motivation mit einer spielerischen, digitalen und dynamischen Tonalität fördern!"
    ],
    "en": [
      "Teams Connect : agency specialised in team building for companies, in person or remotely, developing team cohesion, the feeling of belonging and motivation with a fun, digital and dynamic tone !"
    ],
    "it": [
      "Aumentate la coesione e la motivazione dei vostri team con Teams Connect! Specializzata in team building indoor e outdoor, la nostra agenzia offre esperienze divertenti, digitali e dinamiche per rafforzare lo spirito di squadra e il senso di appartenenza"
    ],
    "fr": [
      "Boostez la cohésion et la motivation de vos équipes avec Teams Connect ! Spécialiste du team building indoor et outdoor, notre agence propose des expériences ludiques, digitales et dynamiques pour renforcer l’esprit d’équipe et le sentiment d’appartenance"
    ],
    "es": [
      "¡Aumente la cohesión y la motivación de sus equipos con Teams Connect! Como especialista en team building indoor y outdoor, nuestra agencia ofrece experiencias divertidas, digitales y dinámicas para reforzar el espíritu de equipo y el sentimiento de pertenencia"
    ],
    "nl": [
      "Boost de cohesie en motivatie van je teams met Teams Connect! Als specialist in indoor en outdoor teambuilding biedt ons bureau leuke, digitale en dynamische ervaringen om de teamgeest en het saamhorigheidsgevoel te versterken"
    ]
  },
