  "rdfs:comment": {
    "de": [
      "Der Parking du Saint-Jacques in Saint-Germain Laprade empfängt alle Arten von Fahrzeugen während Ihres Aufenthalts in Le Puy-en-Velay: Wohnmobile, Vans, Lieferwagen (Übernachtungen möglich) und Leichtfahrzeuge. Videoüberwachung rund um die Uhr und Zugang zwischen 6 und 22 Uhr an sieben Tagen in der Woche."
    ],
    "en": [
      "Parking du Saint-Jacques in Saint-Germain Laprade welcomes all types of vehicles during your stay in Le Puy-en-Velay: campers, vans, vans (overnight stays possible) and light vehicles. 24-hour video surveillance and access between 6 a.m. and 10 p.m., 7 days a week."
    ],
    "it": [
      "Il parcheggio Saint-Jacques di Saint-Germain Laprade può ospitare tutti i tipi di veicoli durante il vostro soggiorno a Le Puy-en-Velay: camper, furgoni (possibilità di pernottamento) e veicoli leggeri. Videosorveglianza 24 ore su 24 e accesso dalle 6 alle 22, 7 giorni su 7."
    ],
    "fr": [
      "Le Parking du Saint-Jacques à Saint-Germain Laprade accueille tous types de véhicules pendant votre séjour au Puy-en-Velay : camping-cars, vans, fourgons (nuitées possibles) et véhicules légers. Vidéosurveillance 24h/24 et accès entre 6h et 22h, 7j7."
    ],
    "es": [
      "El parking Saint-Jacques de Saint-Germain Laprade puede acoger todo tipo de vehículos durante su estancia en Le Puy-en-Velay: autocaravanas, furgonetas (posibilidad de pernoctar) y vehículos ligeros. Videovigilancia 24 horas y acceso entre las 6.00 y las 22.00 horas, los 7 días de la semana."
    ],
    "nl": [
      "De Saint-Jacques parkeerplaats in Saint-Germain Laprade biedt plaats aan alle soorten voertuigen tijdens je verblijf in Le Puy-en-Velay: campers, bestelwagens (overnachting mogelijk) en lichte voertuigen. 24-uurs videobewaking en toegang tussen 6.00 en 22.00 uur, 7 dagen per week."
    ]
  },
