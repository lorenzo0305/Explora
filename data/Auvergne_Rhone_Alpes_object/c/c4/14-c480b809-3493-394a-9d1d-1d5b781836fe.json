  "rdfs:comment": {
    "de": [
      "Sind Sie noch nie geflogen oder träumen Sie davon, das Gefühl des Fliegens in einem \"kleinen Flugzeug\" zu erleben?"
    ],
    "en": [
      "Have you never flown before, or do you dream of experiencing the thrill of flying in a \"small plane\"?"
    ],
    "it": [
      "Non avete mai volato prima o sognate di provare l'emozione di volare in un \"piccolo aereo\"?"
    ],
    "fr": [
