  "rdfs:comment": {
    "de": [
      "Willkommen bei Ihrem Fahrradspezialisten im Herzen der Drôme Black&Cycles: Fahrradgeschäft & Guide-Monitor.\r\nVerkauf, Vermietung, Reparatur und geführte Touren. Entdecken Sie mit dem Muskel- oder Elektro-Mountainbike eine spielerische und sportliche Aktivität im Herzen der Natur."
    ],
    "en": [
      "Welcome to your bicycle specialist in the heart of Drôme Black&Cycles: Bike shop & Guide Monitor \r\n Services: sales, rental, repair, and guiding.\r\n On a muscular or electric mountain bike, discover a fun and sporting activity in the heart of nature."
    ],
    "it": [
      "Benvenuti nel vostro specialista di ciclismo nel cuore della Drôme Black&Cycles: negozio di biciclette e istruttore di guide.\r\nVendita, noleggio, riparazioni ed escursioni guidate. Che si tratti di una mountain bike o di una bici elettrica, scoprite un'attività sportiva e divertente nel cuore della natura."
    ],
    "fr": [
      "Bienvenue chez votre spécialiste vélo en cœur de Drôme Black&Cycles : Magasin de vélos & Moniteur Guide. \r\nVente, location, réparation et sorties guidées. En VTT musculaire ou électrique, découvrez une activité ludique et sportive au cœur de la nature."
    ],
    "nl": [
      "Welkom bij uw fietsspecialist in het hart van de Drôme Black&Cycles: Fietsenwinkel & Gidseninstructeur.\r\nVerkoop, verhuur, reparaties en begeleide uitstapjes. Op een mountainbike of een elektrische fiets, ontdek een leuke en sportieve activiteit midden in de natuur."
    ],
    "es": [
      "Bienvenido a su especialista en ciclismo en el corazón de la Drôme Black&Cycles: Tienda de bicicletas e instructor de guías.\r\nVenta, alquiler, reparaciones y salidas guiadas. En bicicleta de montaña o eléctrica, descubra una actividad lúdica y deportiva en plena naturaleza."
    ]
  },
