      "dc:description": {
        "de": [
          "Kapazität: 140 Personen\n\nGeöffnet Montag bis Donnerstag von 11:00 bis 0:00 Uhr, Freitag von 11:00 bis 1:00 Uhr, Samstag von 11:00 bis 2:00 Uhr, Sonntag von 10:00 bis 0:00 Uhr\n\nArt der Kundschaft: 25 Jahre\n\nArt der Musik: abwechslungsreich"
        ],
        "en": [
          "Capacity: 140 people\n\nOpen Monday-Thursday 11am-0am, Friday 11am-1am, Saturday 11am-2am, Sunday 10am-0am\n\nClientele : 25 years old\n\nType of music: varied"
        ],
        "it": [
          "Capacità: 140 persone\n\nAperto da lunedì a giovedì dalle 11.00 alle 12.00, venerdì dalle 11.00 all'1.00, sabato dalle 11.00 alle 2.00, domenica dalle 10.00 alle 12.00\n\nClientela : 25 anni\n\nTipo di musica: varia"
        ],
        "fr": [
          "Capacité : 140 personnes\n\nOuvert du lundi au jeudi de 11h à 0h, le vendredi de 11h à 1h, le samedi de 11h à 2h, le dimanche de 10h à 0h\n\nType de clientèle : 25 ans\n\nType de musique : variée"
        ],
        "nl": [
          "Capaciteit: 140 personen\n\nOpen van maandag tot donderdag van 11.00 tot 12.00 uur, vrijdag van 11.00 tot 1.00 uur, zaterdag van 11.00 tot 2.00 uur, zondag van 10.00 tot 12.00 uur\n\nKlantenkring : 25 jaar oud\n\nSoort muziek: gevarieerd"
        ],
        "es": [
          "Capacidad: 140 personas\n\nAbierto de lunes a jueves de 11.00 a 12.00 h, viernes de 11.00 a 1.00 h, sábados de 11.00 a 2.00 h y domingos de 10.00 a 12.00 h\n\nClientela : 25 años\n\nTipo de música: variada"
        ]
      },
