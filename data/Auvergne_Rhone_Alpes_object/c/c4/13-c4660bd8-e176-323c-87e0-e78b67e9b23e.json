  "rdfs:comment": {
    "de": [
      "Das Restaurant Léon de Bruxelles steht für frische und \"hausgemachte\" Muscheln an 365 Tagen im Jahr! Hier erwartet Sie eine Qualitätsküche, in der Sie einen geselligen Moment mit der Familie oder mit Freunden in einer Brasserie-Atmosphäre verbringen können!"
    ],
    "en": [
      "The Léon de Bruxelles restaurant offers fresh, home-made mussels 365 days a year! High-quality cuisine awaits you: the perfect place to spend a convivial moment with family and friends, in a brasserie atmosphere!"
    ],
    "it": [
      "Il ristorante Léon de Bruxelles offre cozze fresche e fatte in casa 365 giorni all'anno! Vi aspetta una cucina di qualità: un luogo ideale per trascorrere un momento conviviale con la famiglia o gli amici, in un'atmosfera da brasserie!"
    ],
    "fr": [
      "Le restaurant Léon de Bruxelles c’est des moules fraîches et « fait-maison » 365 jours par an ! Une cuisine de qualité vous y attend : de quoi passer un moment convivial en famille ou entre amis, dans une ambiance brasserie !"
    ],
    "nl": [
      "Restaurant Léon de Bruxelles biedt 365 dagen per jaar verse, huisbereide mosselen! De kwaliteitskeuken wacht op u, zodat u kunt genieten van een gezellige maaltijd met familie en vrienden in een brasseriesfeer!"
    ],
    "es": [
      "El restaurante Léon de Bruxelles ofrece mejillones frescos y caseros los 365 días del año Le espera una cocina de calidad: ¡un lugar ideal para pasar un momento de convivencia con la familia o los amigos, en un ambiente de brasserie!"
    ]
  },
  "rdfs:label": {
