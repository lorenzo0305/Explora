  "rdfs:comment": {
    "de": [
      "Die Galerie d'étoiles im Herzen von Montélimar lädt Sie ein, in die Welt zweier Maler mit kontrastierenden Stilen, aber einer gemeinsamen Leidenschaft einzutauchen."
    ],
    "en": [
      "Galerie d'étoiles, in the heart of Montélimar, invites you to immerse yourself in the world of two painters with contrasting styles but a shared passion."
    ],
    "it": [
      "La Galerie d'étoiles, nel cuore di Montélimar, vi invita a immergervi nel mondo di due pittori dallo stile contrastante ma dalla passione comune."
    ],
    "fr": [
      "La Galerie d'étoiles, située au cœur de Montélimar, vous propose une immersion dans l'univers de deux artistes peintres aux styles contrastés mais à la passion commune."
    ],
    "es": [
      "La Galerie d'étoiles, en el corazón de Montélimar, le invita a sumergirse en el universo de dos pintores con estilos opuestos pero una pasión compartida."
    ],
    "nl": [
      "Galerie d'étoiles, in het hart van Montélimar, nodigt je uit om je onder te dompelen in de wereld van twee schilders met contrasterende stijlen maar een gedeelde passie."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Exposition de peinture : Dualité et Passion - JL Dubois et MChapuy"
    ]
  },
