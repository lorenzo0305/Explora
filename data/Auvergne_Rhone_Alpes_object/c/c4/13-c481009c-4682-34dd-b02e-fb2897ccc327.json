  "rdfs:comment": {
    "de": [
      "Das Restaurant \"La Source\" bietet Ihnen eine traditionelle Bio-, lokale und saisonale Küche mit vegetarischen Angeboten ... aber nicht nur ... . Delphine arbeitet mit lokalen Produzenten und 95% Bio-Produkten (Biocoop und Bio-Produzenten )."
    ],
    "en": [
      "The \"La Source\" restaurant offers traditional, organic, local and seasonal cuisine with vegetarian options ... but not only ... . Delphine works with local producers and 95% organic products (Biocoop and organic producers)."
    ],
    "it": [
      "Il ristorante \"La Source\" offre una cucina tradizionale, biologica, locale e stagionale con opzioni vegetariane... ma non è tutto... . Delphine lavora con produttori locali e con il 95% di prodotti biologici (Biocoop e produttori biologici)."
    ],
    "fr": [
      "Le restaurant \"La Source\" vous propose une cuisine traditionnelle bio, locale et de saison avec des propositions végétariennes ... mais pas que ... . Delphine travaille avec les producteurs locaux et 95% de produits bio (Biocoop et producteurs bio )."
    ],
    "nl": [
      "Het restaurant \"La Source\" biedt een traditionele, biologische, lokale en seizoensgebonden keuken met vegetarische opties ... maar dat is niet alles ... . Delphine werkt met lokale producenten en 95% biologische producten (Biocoop en biologische producenten)."
    ],
    "es": [
      "El restaurante \"La Source\" ofrece cocina tradicional, ecológica, local y de temporada con opciones vegetarianas ... pero eso no es todo ... . Delphine trabaja con productores locales y un 95% de productos ecológicos (Biocoop y productores ecológicos)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Source"
    ]
  },
