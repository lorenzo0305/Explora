  "rdfs:comment": {
    "de": [
      "Aquaventure ist das erste professionelle Tauchzentrum des Genfer Sees. Diese Tauchschule bietet Ihnen Einführungen in den Tauchsport im See, Ausbildungen, Kurse, Erkundungstouren, Eistauchen, Tauchen mit Nitrox an. Betreuung durch staatliche geprüfte Lehrer."
    ],
    "en": [
      "Aquaventure is Lake Geneva’s top diving centre. This diving school teaches beginners courses, training courses, ice diving and nitrox diving with qualified instructors."
    ],
    "it": [
      "Aquaventure è il primo centro subacqueo professionale sul Lago di Ginevra. Questa scuola subacquea offre prime immersioni sul lago, corsi di formazione, esplorazioni, immersioni nel ghiaccio e immersioni nitrox supervisionate da istruttori professionisti."
    ],
    "fr": [
      "Aquaventure est le premier centre de plongée professionnel du Léman. Cette école de plongée vous propose des baptêmes au lac, formations, stages, explorations, plongées sous glace, nitrox encadrés par des moniteurs professionnels."
    ],
    "nl": [
      "Aquaventure is het eerste professionele duikcentrum aan het meer van Genève. Deze duikschool biedt eerste duiken op het meer, trainingen, verkenningen, ijsduiken en nitroxduiken onder begeleiding van professionele instructeurs."
    ],
    "es": [
      "Aquaventure es el primer centro de buceo profesional del lago Lemán. Esta escuela de buceo ofrece primeras inmersiones en el lago, cursos de formación, exploraciones, inmersiones en hielo e inmersiones con nitrox supervisadas por instructores profesionales."
    ]
  },
