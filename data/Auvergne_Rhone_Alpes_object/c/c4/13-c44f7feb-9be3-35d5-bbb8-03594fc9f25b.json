  "rdfs:comment": {
    "de": [
      "Entdecken Sie eine einfallsreiche, vegetarische, biologische und lokale Küche. Mittags und abends: Tagesteller, Burger und Ravioli."
    ],
    "en": [
      "Come and try a creative, local vegetarian cuisine. At lunchtime and dinner we offer a platter of the day, burgers and raviole pasta."
    ],
    "it": [
      "Venite a scoprire una cucina vegetariana, inventiva, biologica e locale. Pranzo e cena: specialità del giorno, hamburger e ravioli."
    ],
    "fr": [
      "Venez découvrir une cuisine végétarienne, inventive, bio et locale. Le midi et le soir : assiette du jour, burgers et ravioles."
    ],
    "nl": [
      "\"Geniet van onze vindingrijke, vegetarische, plaatselijke gerechten.\r\nLunch: dagschotel, burgers en ravioles. 's Avonds: het menu van Jerem, iets chiquer en ravioles.\""
    ],
    "es": [
      "Venga a descubrir una cocina vegetariana, inventiva, ecológica y local. Comida y cena: platos del día, hamburguesas y raviolis."
    ]
  },
