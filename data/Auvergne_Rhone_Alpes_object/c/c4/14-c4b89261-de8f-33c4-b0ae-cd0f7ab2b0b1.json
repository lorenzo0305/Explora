  "rdfs:comment": {
    "de": [
      "Wie wäre es, wenn Sie sich auf eine poetische Reise begeben würden? 5 Zwischenstopps, 5 Kapitel, um die Landschaften zu lesen, zu hören und zu fühlen?"
    ],
    "en": [
      "How about embarking on a poetic journey? 5 stops, 5 chapters, to read, hear and feel the landscapes?"
    ],
    "it": [
      "Perché non intraprendere un viaggio poetico? 5 tappe, 5 capitoli, per leggere, ascoltare e sentire i paesaggi?"
    ],
    "fr": [
      "Et si vous embarquiez pour un voyage poétique ? 5 escales, 5 chapitres, pour lire, entendre et ressentir les paysages…"
    ],
    "es": [
      "¿Por qué no embarcarse en un viaje poético? 5 paradas, 5 capítulos, para leer, oír y sentir los paisajes?"
    ],
    "nl": [
      "Waarom niet beginnen aan een poëtische reis? 5 haltes, 5 hoofdstukken, om de landschappen te lezen, te horen en te voelen?"
    ]
  },
