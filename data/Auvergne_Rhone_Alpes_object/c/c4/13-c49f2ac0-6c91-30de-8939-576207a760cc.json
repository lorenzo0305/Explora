  "rdfs:comment": {
    "de": [
      "Unser Entspannungsbereich mit Sauna und Jacuzzi bietet Platz für bis zu 4 Erwachsene oder 4 Erwachsene und 2 Kinder (-12 Jahre). Genießen Sie einen atemberaubenden Blick auf das Tal und die Berge, ohne Gegenüber."
    ],
    "en": [
      "Our relaxation area with sauna and jacuzzi can accommodate up to 4 adults or 4 adults and 2 children (under 12 years old). Come and enjoy a breathtaking view of the valley and the mountains, without any opposite."
    ],
    "it": [
      "La nostra area relax con sauna e jacuzzi può ospitare fino a 4 adulti o 4 adulti e 2 bambini (sotto i 12 anni). Godetevi la vista ininterrotta sulla valle e sulle montagne."
    ],
    "fr": [
      "Notre espace détente sauna et jacuzzi peut accueillir jusqu' à 4 adultes ou bien 4 adultes et 2 enfants (-12 ans). Venez bénéficier d'une vue imprenable sur la vallée et la montagne, sans vis-à-vis."
    ],
    "nl": [
      "Onze ontspanningsruimte met sauna en jacuzzi is geschikt voor maximaal 4 volwassenen of 4 volwassenen en 2 kinderen (-12 jaar). Kom en geniet van een adembenemend uitzicht op de vallei en de bergen, zonder enige tegenpool."
    ],
    "es": [
      "Nuestra zona de relax con sauna y jacuzzi tiene capacidad para 4 adultos o 4 adultos y 2 niños (menores de 12 años). Disfrute de vistas ininterrumpidas del valle y las montañas."
    ]
  },
  "rdfs:label": {
    "en": [
      "Relaxation & leisure area"
    ],
    "fr": [
      "Espace détente & loisirs"
    ],
    "nl": [
      "Ontspannings- en ontspanningsruimte"
    ]
  },
