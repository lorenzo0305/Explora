  "rdfs:comment": {
    "de": [
      "Seit fast 50 Jahren stellen wir unser Wissen in den Dienst der regionalen Küche und sind stolz darauf, Sie in unserer Auberge Paysanne d'Ally bedienen zu dürfen."
    ],
    "en": [
      "For nearly 50 years, we've been putting our expertise at the service of local cuisine and are proud to serve you in our Auberge Paysanne d'Ally."
    ],
    "it": [
      "Da quasi 50 anni mettiamo la nostra esperienza al servizio della cucina locale e siamo orgogliosi di servirvi nel nostro Auberge Paysanne d'Ally."
    ],
    "fr": [
      "Depuis bientôt 50 ans, nous mettons notre savoir faire au service de la cuisine du terroir et sommes fières de vous servir dans notre Auberge Paysanne d'Ally."
    ],
    "es": [
      "Desde hace casi 50 años, ponemos nuestra experiencia al servicio de la cocina local y estamos orgullosos de servirle en nuestro Auberge Paysanne d'Ally."
    ],
    "nl": [
      "Al bijna 50 jaar stellen we onze expertise ten dienste van de lokale keuken en we zijn er trots op je te kunnen bedienen in onze Auberge Paysanne d'Ally."
    ]
  },
