  "rdfs:comment": {
    "de": [
      "Das symbolträchtige Bergrestaurant Refuge du Plomb (Bergstation der Seilbahn) empfängt Sie auf seiner Sonnenterrasse oder in seinem Panoramasaal."
    ],
    "en": [
      "New owner for the emblematic Refuge du Plomb (cable car top station)\r\nHigh-altitude cafeteria with panoramic views, self-service offering dishes prepared with local produce and its terrace bar."
    ],
    "it": [
      "Emblematico ristorante di montagna, il Refuge du Plomb (stazione superiore della funivia) vi accoglie sulla sua terrazza soleggiata o nella sua sala da pranzo panoramica."
    ],
    "fr": [
      "Emblématique restaurant d'altitude, le Refuge du Plomb (gare supérieure du téléphérique) vous accueille sur sa terrasse ensoleillée ou sa salle panoramique."
    ],
    "es": [
      "Restaurante emblemático de montaña, el Refuge du Plomb (estación superior del teleférico) le da la bienvenida en su soleada terraza o en su comedor panorámico."
    ],
    "nl": [
      "Een emblematisch bergrestaurant, de Refuge du Plomb (bovenste station van de kabelbaan) verwelkomt je op het zonnige terras of in de panoramische eetzaal."
    ]
  },
