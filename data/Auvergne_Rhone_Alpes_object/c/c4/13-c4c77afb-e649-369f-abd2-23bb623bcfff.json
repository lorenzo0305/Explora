  "rdfs:comment": {
    "de": [
      "Machen Sie einen Tandem-Fallschirmsprung über der Côte Roannaise und den Windungen der Loire! Der freie Fall dauert etwa 30/40 Sekunden bei einer Geschwindigkeit von 200 km/h! Das gesamte Team von Ciel d'Aventure erwartet Sie, um diesen einzigartigen Moment mit Ihnen zu teilen!"
    ],
    "en": [
      "Take a tandem skydive over the Côte Roannaise and the meandering Loire River! Thrills guaranteed with a 30/40-second freefall at 200 km/h! The whole Ciel d'Aventure team is waiting to share this unique moment with you!"
    ],
    "it": [
      "Fate un paracadute in tandem sulla Côte Roannaise e sui meandri della Loira! Vi sarà garantita un'emozionante caduta libera di 30/40 secondi a 200 km/h! Tutto il team di Ciel d'Aventure vi aspetta per condividere con voi questo momento unico!"
    ],
    "fr": [
      "Réalisez un saut en parachute tandem au-dessus de la Côte Roannaise et des méandres de la Loire ! Sensations garanties avec  environ 30/40 secondes de chute libre à 200 km/h ! Toute l'équipe de Ciel d'Aventure vous attend pour partager ce moment unique !"
    ],
    "es": [
      "Realice un salto en paracaídas biplaza sobre la Côte Roannaise y los meandros del Loira Le garantizamos una emocionante caída libre de 30/40 segundos a 200 km/h Todo el equipo de Ciel d'Aventure le espera para compartir con usted este momento único"
    ],
    "nl": [
      "Maak een tandemsprong boven de Côte Roannaise en de meanderende Loire! Je bent verzekerd van een spannende vrije val van 30/40 seconden met een snelheid van 200 km/u! Het hele Ciel d'Aventure team staat klaar om dit unieke moment met jou te delen!"
    ]
  },
