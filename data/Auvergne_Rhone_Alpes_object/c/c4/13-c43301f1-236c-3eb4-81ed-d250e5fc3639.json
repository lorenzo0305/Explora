  "rdfs:comment": {
    "de": [
      "In der gemütlichen Atmosphäre eines altmodischen Bistros wird eine traditionelle, vollständig \"hausgemachte\" Küche serviert. Im Sommer schöne schattige Terrasse unter den Platanen vor der Kirche."
    ],
    "en": [
      "Entirely 'homemade' traditional cuisine served in the warm and friendly atmosphere of an old-style bistro.\r\nIn the summer, you can sit on the beautiful terrace in the shade of the plane trees just in front of the church."
    ],
    "it": [
      "Nella calda atmosfera di un bistrot d'altri tempi, cucina tradizionale fatta in casa. In estate c'è una bella terrazza ombreggiata sotto i platani di fronte alla chiesa."
    ],
    "fr": [
      "Dans l’ambiance chaleureuse d’un bistrot à l’ancienne, une cuisine traditionnelle entièrement « faite maison ». L'été, belle terrasse ombragée sous les platanes devant l'église."
    ],
    "nl": [
      "In de hartelijke sfeer van een ouderwetse bistrot ontdekt u een huisgemaakte traditionele keuken. \r\nIn de zomer op het schaduwrijke terras onder de platanen voor de kerk."
    ],
    "es": [
      "En el cálido ambiente de un bistró a la antigua usanza, cocina casera tradicional. En verano, hay una hermosa terraza sombreada bajo los plátanos frente a la iglesia."
    ]
  },
