  "rdfs:comment": {
    "de": [
      "Das Kollektiv La Maise ist eine Vereinigung von Künstlern und Enthusiasten, die aus etwa zehn Personen besteht, die sich um das künstlerische Schaffen versammelt haben. Es hat sich zum Ziel gesetzt, die Kunst auf seine Weise zu entwickeln und zu experimentieren."
    ],
    "en": [
      "The La Maise collective is an association of artists and enthusiasts, made up of a dozen people united around artistic creation. Its aim is to develop and experiment with art in its own way."
    ],
    "it": [
      "Il collettivo La Maise è un'associazione di artisti e appassionati, composta da una decina di persone riunite intorno alla creazione artistica. Il suo obiettivo è sviluppare e sperimentare l'arte a modo suo."
    ],
    "fr": [
      "Le collectif de La Maise est une association d'artistes et de passionnés, composée d'une dizaine de personnes réunis autour de la création artistique. Il a pour volonté de développer et expérimenter l'art à sa manière."
    ],
    "nl": [
      "Het collectief La Maise is een vereniging van kunstenaars en liefhebbers, bestaande uit een tiental mensen die verenigd zijn rond artistieke creatie. Het doel is om kunst op een eigen manier te ontwikkelen en ermee te experimenteren."
    ],
    "es": [
      "El colectivo La Maise es una asociación de artistas y aficionados, formada por una decena de personas unidas en torno a la creación artística. Su objetivo es desarrollar y experimentar el arte a su manera."
    ]
  },
