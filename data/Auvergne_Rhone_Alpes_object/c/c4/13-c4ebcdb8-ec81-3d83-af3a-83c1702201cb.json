  "rdfs:comment": {
    "de": [
      "Entdecken Sie den Skatepark von Doussard: ein moderner und geselliger Spot im Herzen der Alpen, ideal für Anfänger und Fortgeschrittene. Rampen, Schienen, Kurven? garantierte Sensationen in einer außergewöhnlichen natürlichen Umgebung!"
    ],
    "en": [
      "Discover the Doussard Skate Park: a modern, friendly spot in the heart of the Alps, ideal for beginners and experienced riders alike. Ramp, rails, curves? sensations guaranteed in an exceptional natural setting!"
    ],
    "it": [
      "Scoprite il Doussard Skate Park: un luogo moderno e accogliente nel cuore delle Alpi, ideale per principianti ed esperti. Rampe, rail, curve, emozioni garantite in un contesto naturale eccezionale!"
    ],
    "fr": [
      "Découvrez le Skate Park de Doussard : un spot moderne et convivial au cœur des Alpes, idéal pour riders débutants et confirmés. Rampe, rails, courbes… sensations garanties dans un cadre naturel exceptionnel !"
    ],
    "nl": [
      "Ontdek het Doussard Skatepark: een moderne, gezellige plek in het hart van de Alpen, ideaal voor zowel beginners als ervaren rijders. Ramp, rails, bochten? gegarandeerd sensatie in een uitzonderlijke natuurlijke omgeving!"
    ],
    "es": [
      "Descubra el Doussard Skate Park: un lugar moderno y acogedor en el corazón de los Alpes, ideal tanto para principiantes como para riders experimentados. Rampa, raíles, curvas... ¡emociones garantizadas en un entorno natural excepcional!"
    ]
  },
