  "rdfs:comment": {
    "de": [
      "Ungewöhnlicher Besuch einer Lama-Farm. Annäherung an die Tiere, Aktivitäten mit den Lamas: Hindernisparcours, Pflege der Lamas. Nur nach vorheriger Anmeldung."
    ],
    "en": [
      "Unusual visit of a llama farm. Approach to animals, activities with llamas: obstacle course, walk towards the ponds of Crosagny with llamas kept in a lanyard.Only on reservation."
    ],
    "it": [
      "Visita insolita di un allevamento di lama. Approccio agli animali, attività con i lama: percorso a ostacoli, passeggiata in direzione degli stagni di Crosagny con i lama tenuti in cordino.Solo su prenotazione."
    ],
    "fr": [
      "Visite insolite d'un élevage de lamas. Approche des animaux, activités avec les lamas : parcours d'obstacles, soin aux lamas. Uniquement sur réservation."
    ],
    "es": [
      "Una visita insólita a una granja de llamas. Acérquese a los animales, participe en actividades con las llamas: carrera de obstáculos, cuidado de llamas. Sólo con reserva previa."
    ],
    "nl": [
      "Een ongewoon bezoek aan een lama-boerderij. Kom dicht bij de dieren, doe mee aan activiteiten met de lama's: hindernisbaan, verzorging van de lama's. Alleen op reservering."
    ]
  },
