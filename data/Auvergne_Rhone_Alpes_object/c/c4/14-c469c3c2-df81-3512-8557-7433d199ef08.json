  "rdfs:comment": {
    "de": [
      "Die Brasserie Le Saint Hubert liegt im Herzen von Calais und empfängt Sie in einer warmen und freundlichen Atmosphäre. Die Gaststätte ist eine echte lokale Institution, die für ihre traditionelle und großzügige Küche geschätzt wird."
    ],
    "en": [
      "Nestled in the heart of Calais, Brasserie Le Saint Hubert welcomes you in a warm and friendly atmosphere. This establishment is a true local institution, appreciated for its traditional and generous cuisine."
    ],
    "it": [
      "Situata nel cuore di Calais, la Brasserie Le Saint Hubert vi accoglie in un'atmosfera calda e accogliente. Questo locale è una vera e propria istituzione locale, apprezzato per la sua cucina tradizionale e generosa."
    ],
    "fr": [
      "Nichée au cœur de Calais, la Brasserie Le Saint Hubert vous accueille dans une ambiance chaleureuse et conviviale. Cet établissement est une véritable institution locale, appréciée pour sa cuisine traditionnelle et généreuse."
    ],
    "es": [
      "Situada en el corazón de Calais, la Brasserie Le Saint Hubert le da la bienvenida en un ambiente cálido y acogedor. Este establecimiento es una auténtica institución local, apreciada por su cocina tradicional y generosa."
    ],
    "nl": [
      "In het hart van Calais heet Brasserie Le Saint Hubert u welkom in een warme en vriendelijke sfeer. Dit etablissement is een echt plaatselijk instituut, gewaardeerd om zijn traditionele en gulle keuken."
    ]
  },
