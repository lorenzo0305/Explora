    "de": [
      "Restaurant, das vorschlägt eine kreative Küche, Weinstube und Weinkeller. Eines Ort gewidmet für Feinschmecker und Weinliebhaber. Verkostung mit Einzelausschank von Wein."
    ],
    "en": [
      "Restaurant serving creative dishes with a wine bar and cellar. The atmosphere revolves around wine/fine food and great cooking. Wine tasting by the glass ..."
    ],
    "it": [
      "Ristorante con cucina creativa, enoteca e cantina. Un luogo che ruota attorno al vino e/o alla gastronomia e al buon cibo. Degustazione di vini al bicchiere..."
    ],
    "fr": [
      "Restaurant à la cuisine créative, bar à vin et cave. Lieu qui tourne autour du vin et / ou de la gastronomie et de la bonne cuisine. Dégustation de vin au verre..."
    ],
    "es": [
      "Restaurante con cocina creativa, bar de vinos y bodega. Un lugar que gira en torno al vino y/o la gastronomía y la buena comida. Cata de vinos por copas..."
    ],
    "nl": [
      "Restaurant met creatieve keuken, wijnbar en kelder. Een plek die draait om wijn en/of gastronomie en lekker eten. Wijnproeven per glas..."
