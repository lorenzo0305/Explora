  "rdfs:comment": {
    "de": [
      "Ein Gewässer mit einer Fläche von 2,21 Hektar, das an diesem Standort in die 1. Kategorie für Fische eingestuft ist. Für den Plan d'eau des Oudins ist eine Angelkarte erforderlich, die im Tourismusbüro gekauft werden kann."
    ],
    "en": [
      "The 2.21-hectare lake is classified as a 1st category fishing lake at this location. The Oudins lake requires a fishing permit, which can be purchased from the tourist office."
    ],
    "it": [
      "Questo lago di 2,21 ettari è classificato come lago di pesca di 1ª categoria. Il lago di Oudins richiede una licenza di pesca, che può essere acquistata presso l'ufficio turistico."
    ],
    "fr": [
      "Plan d'eau d'une surface de 2.21 hectares classé en 1ère catégorie piscicole à cet emplacement. Le plan d'eau des Oudins nécessite une carte de pêche qui peut s'acheter à l'office de tourisme."
    ],
    "es": [
      "Este lago de 2,21 hectáreas está clasificado como lago de pesca de 1ª categoría. El lago de Oudins requiere una licencia de pesca, que se puede adquirir en la oficina de turismo."
    ],
    "nl": [
      "Dit meer van 2,21 hectare is geklasseerd als vismeer van de 1e categorie. Voor het Oudins meer heb je een visvergunning nodig, die je kunt kopen bij het toeristenbureau."
    ]
  },
  "rdfs:label": {
    "en": [
      "Fishing at the Oudins lake"
    ],
    "fr": [
      "Pêche au plan d'eau des Oudins"
    ]
  },
