  "rdfs:comment": {
    "de": [
      "Chez Mamie-Chou steht für eine großzügige, hausgemachte Küche, die mit frischen Produkten und viel Liebe zubereitet wird. In einem warmen und nostalgischen Ambiente kann man bei einem guten Gericht die Geschmäcker und Erinnerungen an die Kindheit wiederfinden."
    ],
    "en": [
      "At Mamie-Chou’s, it’s hearty homemade cooking, prepared with fresh products and lots of love. In a warm and nostalgic setting, you’ll rediscover the flavors and memories of childhood around a good meal."
    ],
    "it": [
      "Da Mamie-Chou vi aspetta una cucina casalinga e generosa, preparata con prodotti freschi e tanto amore. In un ambiente caldo e nostalgico, ritroverete i sapori e i ricordi d’infanzia attorno a un buon piatto."
    ],
    "fr": [
      "Chez Mamie-Chou, c’est une cuisine maison généreuse, préparée avec des produits frais et beaucoup d’amour. Dans un décor chaleureux et nostalgique, on y retrouve les saveurs et les souvenirs d’enfance autour d’un bon plat."
    ],
    "es": [
      "Chez Mamie-Chou ofrece una generosa cocina casera, preparada con productos frescos y mucho amor. En un ambiente cálido y nostálgico, podrá redescubrir los sabores y recuerdos de su infancia en torno a una buena comida."
    ],
    "nl": [
      "Chez Mamie-Chou biedt een royale thuiskeuken, bereid met verse producten en veel liefde. In een warme, nostalgische omgeving kun je de smaken en herinneringen uit je kindertijd herontdekken tijdens een goede maaltijd."
    ]
  },
