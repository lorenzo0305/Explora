  "rdfs:comment": {
    "de": [
      "In einer wunderschönen Umgebung in den Monts du Cézallier können Sie einen Buron entdecken, der im Respekt der Traditionen vollständig renoviert wurde. In einer fabelhaften Landschaft können Sie Minigolf auf einem 9-Loch-Parcours spielen."
    ],
    "en": [
      "In a magnificent setting of the Monts du Cézallier, come and discover a buron entirely renovated in the respect of the traditions, you will be able to practice mini-golf in a fabulous landscape on a 9-hole course."
    ],
    "it": [
      "In una magnifica cornice sulle montagne del Cézallier, venite a scoprire un buron completamente rinnovato nel rispetto della tradizione. Potrete giocare a minigolf in un paesaggio favoloso su un campo a 9 buche."
    ],
    "fr": [
      "Dans un cadre magnifique des Monts du Cézallier, venez découvrir un buron entièrement rénové dans le respect des traditions, vous pourrez pratiquer le mini-golf dans un paysage fabuleux sur un parcours de 9 trous."
    ],
    "nl": [
      "In een prachtige omgeving in de bergen van Cézallier kunt u een buron ontdekken die geheel volgens de traditie is gerenoveerd. U kunt er minigolfen in een prachtig landschap op een baan met 9 holes."
    ],
    "es": [
      "En un magnífico entorno en los montes de Cézallier, venga a descubrir un burón completamente renovado según la tradición. Podrá jugar al minigolf en un fabuloso paisaje en un campo de 9 hoyos."
    ]
  },
  "rdfs:label": {
