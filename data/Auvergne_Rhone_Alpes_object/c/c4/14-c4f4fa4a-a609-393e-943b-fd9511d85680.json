  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/255a5586-860a-3cfb-95fb-25cec6d296bf",
      "dc:description": {
        "de": [
          "Eine neue Ausstellung wird im Stadtarchiv enthüllt! Wie sah das Leben in Boulogne in den 1960er Jahren zwischen Optimismus, großen Bauarbeiten und dem Wunsch nach Veränderungen wirklich aus? Das Stadtarchiv lädt Sie vom 6. Oktober bis zum 6. Dezember zu seiner Ausstellung Boulogne 60's ein."
        ],
        "en": [
          "A new exhibition unveiled at the Archives Municipales! Between optimism, major works and the desire for change, what was life really like in Boulogne in the sixties? From October 6 to December 6, the Archives Municipales invite you to their Boulogne 60's exhibition."
        ],
        "it": [
          "Una nuova mostra viene presentata agli Archives Municipales! Tra ottimismo, grandi opere e voglia di cambiamento, com'era davvero la vita a Boulogne negli anni '60? Dal 6 ottobre al 6 dicembre, gli Archivi Municipali vi invitano alla mostra Boulogne anni '60."
        ],
        "fr": [
          "Une nouvelle exposition se dévoile aux Archives Municipales ! Entre optimisme, grands travaux et envies de changements, quelle était réellement la vie à Boulogne dans les années soixante ? Les Archives municipales vous invitent, du 6 octobre au 6 décembre, à leur exposition Boulogne 60's."
        ],
        "es": [
          "¡Se inaugura una nueva exposición en los Archivos Municipales! Entre optimismo, grandes obras y ganas de cambio, ¿cómo era realmente la vida en Boulogne en los años 60? Del 6 de octubre al 6 de diciembre, los Archivos Municipales le invitan a su exposición Boulogne 60's."
        ],
        "nl": [
          "Een nieuwe tentoonstelling wordt onthuld in de Archives Municipales! Tussen optimisme, grote werken en een verlangen naar verandering, hoe zag het leven er echt uit in Boulogne in de jaren 1960? Van 6 oktober tot 6 december nodigen de Gemeentelijke Archieven je uit op hun tentoonstelling Boulogne 60's."
        ]
      },
      "@type": [
        "Description"
      ],
