  "rdfs:comment": {
    "de": [
      "Klassisches und vegetarisches Restaurant mit saisonalen Produkten. Teestube.\r\nPatrick und Bénédicte sind leidenschaftliche Köche: aber die gute, die, die Zeit braucht! Die, die man teilt und die zusammenbringt..."
    ],
    "en": [
      "Vegetarian restaurant serving seasonal products."
    ],
    "it": [
      "Ristorante classico e vegetariano con prodotti di stagione. Sala da tè.\r\nPatrick e Bénédicte sono appassionati di cucina: ma di una buona cucina, quella che richiede tempo! Il tipo di condivisione che unisce le persone..."
    ],
    "fr": [
      "Restaurant classique et végétarien à base de produits de saison. Salon de thé.\r\nPatrick et Bénédicte sont des passionnés de cuisine : mais de la bonne, celle qui prend du temps ! Celle qui se partage et qui rassemble..."
    ],
    "nl": [
      "Vegetarisch restaurant op basis van seizoensproducnten."
    ],
    "es": [
      "Restaurante clásico y vegetariano con productos de temporada. Salón de té.\r\nPatrick y Bénédicte son unos apasionados de la cocina: pero de la buena, de la que lleva tiempo Del tipo que se comparte y que une a la gente..."
    ]
  },
