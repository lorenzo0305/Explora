  "rdfs:comment": {
    "de": [
      "Feiern Sie mit uns den ersten Tag des Frühlings und tanzen Sie zu den zeitlosen Liedern von Golman!\r\nFood Truck vor Ort.\r\nPreis: 10 ? / kostenlos für Kinder unter 12 Jahren.\r\nVerkaufsstelle: Maison des Services Au Public,"
    ],
    "en": [
      "Come celebrate the first day of spring with us by dancing to Golman's timeless songs!\r\nFood Truck on site.\r\nPrices: 10 ? / free for children under 12.\r\nPoint of sale: Maison des Services Au Public,"
    ],
    "it": [
      "Venite a festeggiare con noi il primo giorno di primavera ballando le canzoni senza tempo di Golman!\r\nFood Truck in loco.\r\nPrezzi: 10 ? / gratis per i bambini sotto i 12 anni.\r\nPunto vendita: Maison des Services Au Public,"
    ],
    "fr": [
      "Venez célébrer le premier jour du printemps avec nous en dansant sur les chansons intemporelles de Golman!\r\nFood Truck sur place.\r\nTarifs: 10 € / gratuit pour les - 12 ans.\r\nPoint de vente: Maison des Services Au Public,"
    ],
    "es": [
      "Ven a celebrar con nosotros el primer día de la primavera bailando las canciones eternas de Golman\r\nFood Truck en el lugar.\r\nPrecios: 10€ / gratis para menores de 12 años.\r\nPunto de venta: Maison des Services Au Public,"
    ],
    "nl": [
      "Kom en vier met ons de eerste dag van de lente door te dansen op de tijdloze liedjes van Golman!\r\nFood Truck op het terrein.\r\nPrijzen: 10 € / gratis voor kinderen onder 12 jaar.\r\nVerkooppunt: Maison des Services Au Public,"
    ]
  },
