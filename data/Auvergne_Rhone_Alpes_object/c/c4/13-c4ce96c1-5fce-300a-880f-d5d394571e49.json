  "rdfs:comment": {
    "de": [
      "\"La Tablée, Cantine de quartier\" ist eine Anlaufstelle, die allen offen steht, um zu kochen und/oder zu essen und gesellige Momente rund um die Mahlzeiten zu teilen."
    ],
    "en": [
      "\"La Tablée, Cantine de quartier\" is a place where everyone can cook and/or eat, and share convivial moments over meals."
    ],
    "it": [
      "\"La Tablée, Cantine de quartier\" è un luogo dove tutti possono cucinare e/o mangiare e condividere momenti di convivialità durante i pasti."
    ],
    "fr": [
      "\"La Tablée, Cantine de quartier\" est un lieu d'accueil, ouvert à tous.te pour cuisiner et/ou manger, partager des moments conviviaux autour de repas."
    ],
    "nl": [
      "\"La Tablée, Cantine de quartier\" is een plek waar iedereen kan koken en/of eten en gezellige momenten kan delen tijdens de maaltijden."
    ],
    "es": [
      "\"La Tablée, Cantine de quartier\" es un lugar donde todos pueden cocinar y/o comer, y compartir momentos de convivencia durante las comidas."
    ]
  },
