  "rdfs:comment": {
    "de": [
      "Das Kollektiv \"Arts pluriels 26\" hat sich vor einigen Jahren zusammengefunden. Das Konzept besteht darin, verschiedene künstlerische Ansätze zu kombinieren und zu verzahnen, dabei aber die Individualität jedes einzelnen Künstlers zu bewahren."
    ],
    "en": [
      "The \"Arts pluriels 26\" collective came together a few years ago. The concept is to combine and interweave different artistic approaches while retaining the individuality of each artist."
    ],
    "it": [
      "Il collettivo \"Arts pluriels 26\" è nato qualche anno fa. Il concetto è quello di combinare e intrecciare diversi approcci artistici, pur mantenendo l'individualità di ogni artista."
    ],
    "fr": [
      "Le collectif \"Arts pluriels 26\" s’est réuni il y a quelques années. Le concept est de combiner et d’imbriquer différentes approches artistiques tout en gardant l’individualité de chaque artiste."
    ],
    "nl": [
      "Het collectief \"Arts pluriels 26\" ontstond enkele jaren geleden. Het concept is het combineren en verweven van verschillende artistieke benaderingen met behoud van de individualiteit van elke kunstenaar."
    ],
    "es": [
      "El colectivo \"Arts pluriels 26\" se creó hace unos años. El concepto consiste en combinar y entrelazar diferentes enfoques artísticos conservando la individualidad de cada artista."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Exposition : Arts pluriels 26"
    ]
  },
