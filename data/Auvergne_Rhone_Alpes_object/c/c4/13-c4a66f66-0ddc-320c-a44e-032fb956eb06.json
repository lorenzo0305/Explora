  "rdfs:comment": {
    "de": [
      "3-Sterne-Hotel in Porcieu-Amblagnieu, in unmittelbarer Nähe zur ViaRhôna. 17 komfortable Zimmer, darunter ein barrierefreies Zimmer. Restaurant im Haus, fahrradfreundlicher Empfang, gesicherter Fahrradraum und individuelle Serviceleistungen."
    ],
    "en": [
      "3-star hotel in Porcieu-Amblagnieu, right next to the ViaRhôna cycle route. 17 comfortable rooms, including one accessible for guests with reduced mobility. On-site restaurant, cyclist-friendly services, secure bike storage, and personalised assistance."
    ],
    "it": [
      "Hotel 3 stelle a Porcieu-Amblagnieu, proprio accanto alla ViaRhôna. 17 camere confortevoli, di cui una con accesso PRM. Ristorante in loco, reception adatta ai ciclisti, garage custodito per biciclette, servizi personalizzati."
    ],
    "fr": [
      "Hôtel 3 étoiles à Porcieu-Amblagnieu, à proximité immédiate de la ViaRhôna. 17 chambres confortables, dont une accessible PMR. Restaurant sur place, accueil adapté aux cyclotouristes, garage à vélos sécurisé, services personnalisés."
    ],
    "es": [
      "Hotel de 3 estrellas en Porcieu-Amblagnieu, junto a la ViaRhôna. 17 habitaciones confortables, una de ellas con acceso PMR. Restaurante in situ, recepción adaptada a los ciclistas, garaje seguro para bicicletas, servicios personalizados."
    ],
    "nl": [
      "3-sterrenhotel in Porcieu-Amblagnieu, direct naast de ViaRhôna. 17 comfortabele kamers, waarvan één met PRM-toegang. Restaurant ter plaatse, receptie aangepast aan fietsers, beveiligde fietsenstalling, gepersonaliseerde diensten."
    ]
  },
