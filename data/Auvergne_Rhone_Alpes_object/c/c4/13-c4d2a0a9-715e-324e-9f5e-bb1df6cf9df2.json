  "rdfs:comment": {
    "de": [
      "Im Stadtzentrum gibt es einen ruhigen Park, in dem Kinder spielen."
    ],
    "en": [
      "Just a stone's throw from the city center, the thermal park is a relaxing spot filled with flowers and trees, offering a bird's-eye view of Lake Geneva.\r\nThe paths and ornamental pond lend the place a romantic charm."
    ],
    "it": [
      "A pochi passi dal centro città, il parco termale è un luogo di relax con fiori e alberi e una vista mozzafiato sul Lago di Ginevra.\r\nI sentieri e la piscina ornamentale conferiscono al sito un fascino romantico."
    ],
    "fr": [
      "A deux pas du centre-ville, le parc thermal est un lieu de détente fleuri et arboré qui offre une vue plongeante sur le Léman. \r\nLes cheminements et le bassin d’agrément confèrent au lieu un charme romantique."
    ],
    "nl": [
      "Het kuurpark, op een steenworp afstand van het stadscentrum, is een plek om te ontspannen met bloemen en bomen en een adembenemend uitzicht over het meer van Genève.\r\nDe paden en het sierzwembad geven het terrein een romantische charme."
    ],
    "es": [
      "A un tiro de piedra del centro de la ciudad, el parque del balneario es un lugar para relajarse con flores y árboles, y una vista impresionante sobre el lago Lemán.\r\nLos senderos y la piscina ornamental confieren al lugar un encanto romántico."
    ]
  },
