  "rdfs:comment": {
    "de": [
      "Juliette de Soultrait ist Modistin, aber seit einigen Jahren entwirft sie hauptsächlich Accessoires, Headbands und Schmuck aus ihren schönen Modistenstoffen!"
    ],
    "en": [
      "Juliette de Soultrait is a milliner, but for the past few years she has mainly been creating accessories, headbands and jewelry with her beautiful millinery materials!"
    ],
    "it": [
      "Juliette de Soultrait è una modista, ma da qualche anno crea soprattutto accessori, fasce e gioielli utilizzando i suoi bellissimi materiali di modisteria!"
    ],
    "fr": [
      "Juliette de Soultrait est modiste, mais depuis quelques années elle crée principalement des accessoires, des headbands et des bijoux avec ses belles matières de modiste !"
    ],
    "nl": [
      "Juliette de Soultrait is hoedenmaakster, maar de laatste jaren maakt ze vooral accessoires, hoofdbanden en sieraden met haar prachtige hoedenmaterialen!"
    ],
    "es": [
      "Juliette de Soultrait es sombrerera, pero en los últimos años se ha dedicado sobre todo a crear accesorios, diademas y joyas utilizando sus hermosos materiales de sombrerería"
    ]
  },
  "rdfs:label": {
