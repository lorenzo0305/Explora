  "rdfs:comment": {
    "de": [
      "Atelier für Kunsthandwerk: Holzschnitzerei, Blattvergoldung, Intarsienarbeiten, bemalte Möbel, Zeichnen, Malen, Gravur und Pastellkreide. Kurse und Praktika für Erwachsene und Kinder (Zeichnen/Malen).\r\nEinführungskurs in die Holzschnitzerei."
    ],
    "en": [
      "Arts and crafts workshop: wood sculpture, gilded leaf-work, paint-decorated furniture, drawing, painting on different materials such as canvas. Classes and training courses for both children and adults."
    ],
    "it": [
      "Laboratorio di arti e mestieri: scultura del legno, doratura a foglia, intarsio, mobili dipinti, disegno, pittura, incisione e pastelli. Corsi e laboratori per adulti e bambini (disegno/pittura).\r\nCorso introduttivo di scultura del legno."
    ],
    "fr": [
      "Atelier d'artisanat d'art :  sculpture sur bois, dorure à la feuille, marqueterie, meubles peints, dessin, peinture, gravure et pastels. Cours et stages adultes et enfants (dessin/peinture).\r\nStage initiation à la sculpture sur bois."
    ],
    "es": [
      "Taller de artesanía: talla de madera, dorado de hojas, marquetería, muebles pintados, dibujo, pintura, grabado y pasteles. Cursos y talleres para adultos y niños (dibujo/pintura).\r\nCurso de iniciación a la talla en madera."
    ],
    "nl": [
      "Atelier houtbewerken, blad vergulden, meubels beschilderen, tekenen, schilderen (doek, porselein). Cursussen voor volwassenen en kinderen."
    ]
  },
