  "rdfs:comment": {
    "de": [
      "Marine bietet Ihnen zeitgenössischen Schmuck an.\r\nSie bietet Workshops zur Herstellung von Schmuck aus Gusseisen sowie einen Workshop zur Anfertigung von Eheringen für Paare an (Reservierung erforderlich)."
    ],
    "en": [
      "Marine offers contemporary jewelry.\r\nShe offers cast-iron jewelry-making workshops, as well as a workshop for couples to make their own wedding rings (reservation required)."
    ],
    "it": [
      "Marine propone gioielli contemporanei.\r\nOffre laboratori di creazione di gioielli in ghisa e un laboratorio per coppie per la realizzazione delle proprie fedi nuziali (su prenotazione)."
    ],
    "fr": [
      "Marine vous propose des bijoux contemporains. \r\nElle propose des ateliers de fabrication de bijoux en fonte, ainsi qu'un atelier pour confectionner ses alliances en couple (sur réservation)."
    ],
    "es": [
      "Marine ofrece joyería contemporánea.\r\nOfrece talleres de joyería en hierro fundido, así como un taller para que las parejas hagan sus propias alianzas (previa reserva)."
    ],
    "nl": [
      "Marine biedt eigentijdse sieraden aan.\r\nZe geeft workshops in het maken van gietijzeren sieraden en een workshop voor bruidsparen om hun eigen trouwringen te maken (reserveren verplicht)."
    ]
  },
