  "rdfs:comment": {
    "de": [
      "Traditionelle Herberge auf dem Land, in einer angenehmen Umgebung am Fuße des Mont Meygal gelegen. Die Herberge befindet sich in einem hübschen Dorf, das für seine atypische Kirche bekannt ist, die Sie unbedingt entdecken sollten."
    ],
    "en": [
      "Traditional inn located in the countryside, in a pleasant setting at the foot of Mont Meygal. The inn is located in a pretty village known for its atypical church, to be discovered absolutely."
    ],
    "it": [
      "Ostello tradizionale situato in campagna, in un ambiente piacevole ai piedi del Mont Meygal. L'ostello si trova in un grazioso villaggio noto per la sua chiesa atipica, assolutamente da vedere."
    ],
    "fr": [
      "Auberge traditionnelle située à la campagne, dans un cadre agréable au pied du Mont Meygal. L'auberge est située dans un joli village connu pour son église atypique, à découvrir absolument."
    ],
    "nl": [
      "Traditionele herberg gelegen op het platteland, in een aangename omgeving aan de voet van de Mont Meygal. De herberg ligt in een mooi dorp dat bekend staat om zijn atypische kerk, die u beslist moet zien."
    ],
    "es": [
      "Albergue tradicional situado en el campo, en un entorno agradable a los pies del Monte Meygal. El albergue se encuentra en un bonito pueblo conocido por su atípica iglesia, que es de visita obligada."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Auberge du Meygal"
    ]
  },
