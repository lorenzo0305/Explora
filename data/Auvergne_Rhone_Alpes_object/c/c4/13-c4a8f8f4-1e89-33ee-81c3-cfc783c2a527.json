  "rdfs:comment": {
    "de": [
      "Die Cateringfirma Green nach Maß bietet Salate, warme und kalte Pasta, salzige Kuchen, Baguette-Sandwiches, warme Suppen, Gazpachos und Desserts, die aus frischen Produkten nach Maß zusammengestellt werden."
    ],
    "en": [
      "The tailor-made Green restaurant chain offers salads, hot and cold pastas, savory tarts, baguette sandwiches, hot soups, gazpachos and desserts, all made to order from fresh produce."
    ],
    "it": [
      "La catena di ristoranti Green su misura offre insalate, paste calde e fredde, torte salate, panini con baguette, zuppe calde, gazpachos e dessert, tutti preparati su misura con prodotti freschi."
    ],
    "fr": [
      "L’enseigne de restauration Green sur mesure propose des salades, pâtes chaudes et froides, tartes salées, sandwichs baguette, soupes chaudes, gaspachos et desserts, le tout à composer sur-mesure à partir de produits frais."
    ],
    "es": [
      "La cadena de restaurantes Green, hecha a medida, ofrece ensaladas, pastas frías y calientes, tartas saladas, sándwiches de baguette, sopas calientes, gazpachos y postres, todo hecho a medida con productos frescos."
    ],
    "nl": [
      "De op maat gemaakte restaurantketen Green biedt salades, warme en koude pasta's, hartige taarten, baguettesandwiches, warme soepen, gazpachos en desserts, allemaal op bestelling gemaakt met verse producten."
    ]
  },
