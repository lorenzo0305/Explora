  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/cb03676b-2b44-3df2-810e-716534c23998",
      "dc:description": {
        "de": [
          "Entdecken Sie mit Ihrer Familie die Schätze des Museums und setzen Sie das Erlebnis in einem Workshop fort. Das ist eine gute Gelegenheit, den Austausch zwischen Jung und Alt zu fördern und einen gemeinsamen Moment zu erleben."
        ],
        "en": [
          "Bring the whole family and discover its treasures, then continue the experience in a workshop. It's a great opportunity for young and old alike to exchange ideas and share experiences."
        ],
        "it": [
          "In famiglia, scoprite i suoi tesori e poi continuate l'esperienza in un laboratorio. È un ottimo modo per grandi e piccini di conoscersi e condividere un momento di scoperta."
        ],
        "fr": [
          "En famille, découvrez ses trésors puis poursuivez l’expérience en atelier. L’occasion de favoriser l’échange entre plus jeunes et plus grands et de vivre un moment de partage."
        ],
        "nl": [
          "Ontdek als gezin de schatten en zet de ervaring voort in een workshop. Het is een geweldige manier voor jong en oud om elkaar te leren kennen en een moment van ontdekking te delen."
        ],
        "es": [
          "En familia, descubra sus tesoros y luego continúe la experiencia en un taller. Es una forma estupenda de que pequeños y mayores se conozcan y compartan un momento de descubrimiento."
        ]
      },
