  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/e38101c2-ba60-3598-866c-8e71f1f66e9c",
      "dc:description": {
        "de": [
          "\"Chez Loulou\" in Camiers im Stadtzentrum gelegen, bietet Ihnen Restaurants und Snacks. Sie können sich auch auf der Terrasse niederlassen, um mit Freunden ein Glas zu trinken."
        ],
        "en": [
          "\"Chez Loulou\" is located in Camiers, in the center of town, and offers food and snacks. You can also enjoy a drink with friends on the terrace."
        ],
        "it": [
          "il \"Chez Loulou\", situato a Camiers nel centro della città, offre una serie di ristoranti e snack bar. Potrete anche sorseggiare un drink con gli amici sulla terrazza."
        ],
        "fr": [
          "\"Chez Loulou \" situé à Camiers en centre ville vous propose de la restauration, du snacking. Vous pouvez également vous installer en terrasse pour boire un verre entre amis."
        ],
        "es": [
          "\"Chez Loulou\", situado en Camiers, en el centro de la ciudad, ofrece diversos restaurantes y bares de aperitivos. También puede disfrutar de una copa con los amigos en la terraza."
        ],
        "nl": [
          "\"Chez Loulou\", gelegen in Camiers in het stadscentrum, biedt een scala aan restaurants en snackbars. Je kunt ook genieten van een drankje met vrienden op het terras."
        ]
      },
