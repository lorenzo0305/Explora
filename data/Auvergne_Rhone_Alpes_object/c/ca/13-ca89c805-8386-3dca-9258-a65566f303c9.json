  "rdfs:comment": {
    "de": [
      "Am Strand von Le Sougey, der gut beschattet ist und einen herrlichen Blick auf den See bietet, können Sie eine Snackpause einlegen! Produkte aus der Region, handwerklich hergestelltes Eis, Sandwiches, Pommes frites, Fish & Chips..."
    ],
    "en": [
      "On the Sougey beach, nicely shaded with a breathtaking view of the lake, take a snack break! Local products, artisanal ice cream, sandwiches, fries, fish & chips…"
    ],
    "it": [
      "Fate una pausa per uno spuntino sulla spiaggia di Sougey, ben ombreggiata e con una vista mozzafiato sul lago! Prodotti locali, gelati fatti in casa, panini, patatine, fish & chips..."
    ],
    "fr": [
      "Sur la plage du Sougey, bien ombragée avec vue imprenable sur le lac, faites une pause snacking ! Produits du terroir, glaces artisanales, sandwiches, frites, fish & chips..."
    ],
    "es": [
      "Tome un tentempié en la sombreada playa de Sougey, con sus impresionantes vistas al lago Productos locales, helados caseros, sándwiches, patatas fritas, fish & chips..."
    ],
    "nl": [
      "Neem een snackpauze op het goed beschaduwde Sougey strand, met een adembenemend uitzicht over het meer! Lokale producten, zelfgemaakt ijs, sandwiches, friet, fish & chips..."
    ]
  },
  "rdfs:label": {
    "en": [
      "Snack of the Sougey beach"
    ],
    "fr": [
      "Snack de la plage du Sougey"
    ]
  },
