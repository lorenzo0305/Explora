  "rdfs:comment": {
    "de": [
      "Das Museum ist in der Burgfestung der Herren von Bourbon untergebracht, die später in ein Gefängnis umgewandelt wurde, und bietet den Besuchern eine Reise durch unsere lokale Geschichte, von der Vorgeschichte bis zum Zweiten Weltkrieg."
    ],
    "en": [
      "The museum, settled in the fortified castle of the Bourbon Lords converted into prison, offers a travel through our local history to visitors. Museum of France. Workshops and animations during school holidays."
    ],
    "it": [
      "Ospitato nel castello-fortezza dei signori di Borbone, poi trasformato in prigione, il museo offre ai visitatori un viaggio nella storia locale, dalla preistoria alla Seconda Guerra Mondiale."
    ],
    "fr": [
      "Installé dans le château-forteresse des seigneurs de Bourbon, transformé par la suite en prison, le musée offre aux visiteurs un voyage dans notre histoire locale, de la préhistoire à la Seconde guerre mondiale."
    ],
    "es": [
      "Ubicado en el castillo-fortaleza de los señores de Borbón, transformado posteriormente en prisión, el museo ofrece a los visitantes un recorrido por nuestra historia local, desde la prehistoria hasta la Segunda Guerra Mundial."
    ],
    "nl": [
      "Het museum, gehuisvest in het kasteel-fort van de heren van Bourbon, biedt bezoekers een reis naar onze lokale geschiedenis. Workshops en animaties tijdens de schoolvakanties."
    ]
  },
  "rdfs:label": {
