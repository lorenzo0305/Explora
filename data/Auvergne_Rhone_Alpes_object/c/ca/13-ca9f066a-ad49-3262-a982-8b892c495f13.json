  "rdfs:comment": {
    "de": [
      "Abfahrt vom Jachthafen von Pont-de-Vaux. Zweistündige kommentierte Bootsfahrt auf dem Kanal von Pont-de-Vaux und der Saône bis Jean-de-Saône hin und zurück. Passieren der Schleuse von Pont-de-Vaux."
    ],
    "en": [
      "Departure from the Pont-de-Vaux marina. 2-hour guided cruise on the canal from Pont-de-Vaux and the Saône to Jean-de-Saône and back. Passage of the Pont-de-Vaux lock."
    ],
    "it": [
      "Partenza dal porto turistico di Pont-de-Vaux. Crociera commentata di 2 ore sul canale di Pont-de-Vaux e sulla Saona fino a Jean-de-Saône e ritorno. Passaggio della chiusa di Pont-de-Vaux."
    ],
    "fr": [
      "Départ du Port de Plaisance de Pont-de-Vaux. Croisière commentée de 2 heures sur le canal de Pont-de-Vaux et la Saône jusqu'à Jean-de-Saône aller et retour. Passage de l’écluse de Pont-de-Vaux."
    ],
    "nl": [
      "Vertrek uit de jachthaven van Pont-de-Vaux. 2 uur durende tocht over het kanaal van Pont-de-Vaux en de Saône naar Jean-de-Saône en terug. Doorvaart door de sluis van Pont-de-Vaux."
    ],
    "es": [
      "Salida del puerto deportivo de Pont-de-Vaux. Crucero comentado de 2 horas por el canal de Pont-de-Vaux y el Saona hasta Jean-de-Saône y vuelta. Paso de la esclusa de Pont-de-Vaux."
    ]
  },
  "rdfs:label": {
    "de": [
      "Kreuzfahrt Spaziergang Pont-de-Vaux Jean-de-Saône"
    ],
    "en": [
      "Pont-de-Vaux Jean-de-Saône cruise"
    ],
    "fr": [
      "Croisière balade Pont-de-Vaux Jean-de-Saône"
    ],
    "nl": [
      "Pont-de-Vaux Jean-de-Saône cruise"
    ]
  },
