  "rdfs:comment": {
    "de": [
      "Bun J Ride, eine Kombination aus Bungeespringen und Schanzenabfahrt. Noch mehr Spaß und Nervenkitzel, für jedermann und zu jeder Jahreszeit."
    ],
    "en": [
      "Bungee jumping revisited by Bun J Ride, taking off from a new kind of springboard. More fun, more accessible, and more thrilling !"
    ],
    "it": [
      "Il bungee jumping è rivisitato da Bun J Ride ed è preceduto da uno slancio sulla pedana senza precedenti. Per tutte le stagioni. Più divertimento, maggiore accessibilità e sensazioni forti."
    ],
    "fr": [
      "Le saut à l'élastique revisité par Bun J Ride, précédé d'une prise d'élan sur tremplin inédite. Plus de fun, plus accessible, et plus de sensations !"
    ],
    "nl": [
      "Voor het bungeejumpen nieuwe stijl van Bun J Ride wordt eerst een aanloop genomen. Meer fun, toegankelijker en meer sensaties in ieder seizoen."
    ],
    "es": [
      "Puenting revisitado por Bun J Ride, precedido de un nuevo trampolín. Más divertido, más accesible y más emocionante"
    ]
  },
