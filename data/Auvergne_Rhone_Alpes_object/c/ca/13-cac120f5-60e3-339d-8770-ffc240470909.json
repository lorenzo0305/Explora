  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Boutique des Glasspinners und -bläsers auf der Place Saint Médard. Loïc Bouedec verkauft seine Kreationen und gibt sein Wissen mit Freude weiter!"
    ],
    "en": [
      "Come and discover the Place Saint Médard boutique of the glass spinner and blower. Loïc Bouedec sells his creations and gladly passes on his expertise!"
    ],
    "it": [
      "Venite a scoprire il negozio di Place Saint Médard del filatore e soffiatore di vetro. Loïc Bouedec vende le sue creazioni ed è felice di trasmettere la sua esperienza!"
    ],
    "fr": [
      "Venez découvrir la boutique de la Place Saint Médard du fileur et souffleur de verre. Loïc Bouedec vend ses créations et transmet avec plaisir son savoir-faire !"
    ],
    "es": [
      "Venga a descubrir la tienda de la Place Saint Médard del hilandero y soplador de vidrio. Loïc Bouedec vende sus creaciones y está encantado de transmitirle sus conocimientos"
    ],
    "nl": [
      "Kom en ontdek de Place Saint Médard winkel van de glasspinner en -blazer. Loïc Bouedec verkoopt zijn creaties en geeft graag zijn expertise door!"
    ]
  },
  "rdfs:label": {
