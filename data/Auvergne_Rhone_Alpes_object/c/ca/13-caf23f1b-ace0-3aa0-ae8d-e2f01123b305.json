  "rdfs:comment": {
    "de": [
      "Kunstgalerie, die ganz dem BERG gewidmet ist.\r\nKonzept eines Kuriositätenkabinetts, das alte und zeitgenössische Werke mischt.\r\nMalerei, Fotografie, Gravur, Zeichnungen, Design, Schmuck"
    ],
    "en": [
      "An art gallery entirely dedicated to the MOUNTAINS.\r\nA cabinet of curiosities concept that blends antique and contemporary works.\r\nPaintings, Photography, Engravings, Drawings, Design, Jewelry, etc."
    ],
    "it": [
      "Galleria d'arte interamente dedicata alla MONTAGNA.\r\nUn concetto di gabinetto delle curiosità che combina opere antiche e contemporanee.\r\nPittura, Fotografia, Incisione, Disegni, Design, Gioielli"
    ],
    "fr": [
      "Galerie d'Art entièrement dédié à la MONTAGNE.\r\nConcept de cabinet de curiosité qui mixte des œuvres anciennes et contemporaines .\r\nPeinture, Photographie, Gravure, dessins, Design, Bijoux"
    ],
    "nl": [
      "Kunstgalerie geheel gewijd aan de MOUNTAIN.\r\nEen curiositeitenkabinetconcept dat oude en hedendaagse werken combineert.\r\nSchilderkunst, fotografie, gravure, tekeningen, design, sieraden"
    ],
    "es": [
      "Galería de arte enteramente dedicada a la MONTAÑA.\r\nUn concepto de gabinete de curiosidades que combina obras antiguas y contemporáneas.\r\nPintura, Fotografía, Grabado, Dibujos, Diseño, Joyería"
    ]
  },
