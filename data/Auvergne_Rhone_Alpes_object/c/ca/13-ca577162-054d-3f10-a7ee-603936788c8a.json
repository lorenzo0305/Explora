  "rdfs:comment": {
    "de": [
      "Die Châtel Micro Brasserie ist ein gemütlicher und geselliger Ort, an dem sich die Leidenschaft für das handwerkliche Brauen mit der Lust, schöne Momente zu teilen, vermischt. Hier nimmt man sich nicht zu ernst, außer wenn es darum geht, gute Biere zu brauen!"
    ],
    "en": [
      "Châtel Micro Brasserie is a warm, friendly place where a passion for craft brewing meets a desire to share good times. We don't take ourselves too seriously here, except when it comes to brewing great beers!"
    ],
    "it": [
      "Châtel Micro Brasserie è un luogo caldo e accogliente dove la passione per la produzione di birra artigianale incontra il desiderio di condividere bei momenti. Qui non ci prendiamo troppo sul serio, tranne quando si tratta di produrre ottime birre!"
    ],
    "fr": [
      "Châtel Micro Brasserie est un lieu chaleureux et convivial où la passion du brassage artisanal se mêle à l’envie de partager de bons moments. Ici, on ne se prend pas au sérieux, sauf quand il s'agit de brasser de bonnes bières !"
    ],
    "nl": [
      "Châtel Micro Brasserie is een warme, vriendelijke plek waar een passie voor ambachtelijk brouwen samenkomt met een verlangen om goede momenten te delen. We nemen onszelf hier niet al te serieus, behalve als het gaat om het brouwen van geweldige bieren!"
    ],
    "es": [
      "Châtel Micro Brasserie es un lugar cálido y acogedor donde la pasión por la cerveza artesanal se une al deseo de compartir buenos momentos. Aquí no nos tomamos demasiado en serio, ¡excepto cuando se trata de elaborar grandes cervezas!"
    ]
  },
  "rdfs:label": {
    "en": [
      "C.M.B: Châtel Micro Brasserie"
    ],
    "fr": [
      "C.M.B : Châtel Micro Brasserie"
    ],
    "nl": [
      "C.M.B: Châtel Micro Brasserie"
    ]
  },
