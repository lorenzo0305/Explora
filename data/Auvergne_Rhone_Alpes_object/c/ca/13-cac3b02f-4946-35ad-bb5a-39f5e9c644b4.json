  "rdfs:comment": {
    "de": [
      "Sie sind auf der Suche nach einem Restaurant mit Spezialitäten aus den Bergen wie Raclette, Fondue, Pierrade, Vacherin usw.? Dann sind Sie hier genau richtig!\r\nWir freuen uns darauf, Sie zu verwöhnen."
    ],
    "en": [
      "If you are looking for a restaurant with mountain specialities such as raclettes, fondues, pierrades, vacherin, etc... you have come to the right place!\r\nWe look forward to serving you."
    ],
    "it": [
      "Se cercate un ristorante con specialità di montagna come raclettes, fondues, pierrades, vacherin, ecc... siete nel posto giusto!\r\nNon vediamo l'ora di servirvi."
    ],
    "fr": [
      "Vous êtes à la recherche d'un restaurant à spécialités montagnardes telles que raclettes, fondues, pierrades, vacherin, etc... vous frappez à la bonne porte !\r\nAu plaisir de vous régaler."
    ],
    "es": [
      "Si busca un restaurante con especialidades de montaña como raclettes, fondues, pierrades, vacherin, etc... ¡ha llegado al lugar adecuado!\r\nEsperamos poder servirle."
    ],
    "nl": [
      "Als u op zoek bent naar een restaurant met bergspecialiteiten zoals raclettes, fondues, pierrades, vacherin, enz... dan bent u hier aan het juiste adres!\r\nWe kijken ernaar uit u van dienst te zijn."
    ]
  },
