  "rdfs:comment": {
    "de": [
      "Das Rendez-vous des Chasseurs liegt in 800m Höhe an der Grenze zwischen Forez,Auvergne und Bourbonnais und empfängt Sie in einem herzlichen Rahmen. Die vollständig renovierten Zimmer verbinden Komfort mit Modernität."
    ],
    "en": [
      "800 metres high, on the borders of Forez, Auvergne and Bourbonnais, the Rendez-vous des Chasseurs welcomes you in a warm and friendly  atmosphere. The fully renovated rooms combine comfort and modernity."
    ],
    "it": [
      "Situato a 800 metri di altitudine, ai confini del Forez, dell'Auvergne e del Bourbonnais, il Rendez-vous des Chasseurs vi accoglie in un ambiente caloroso. Le camere, completamente rinnovate, combinano comfort e modernità."
    ],
    "fr": [
      "Situé à 800 mètres d'altitude, aux confins du Forez, de l'Auvergne et du Bourbonnais, le Rendez-vous des Chasseurs vous accueille dans un cadre chaleureux. Les chambres entièrement rénovées allient confort et modernité."
    ],
    "es": [
      "Situado a 800 metros de altitud, en las fronteras de Forez, Auvergne y Bourbonnais, el Rendez-vous des Chasseurs le da la bienvenida en un entorno cálido. Las habitaciones, totalmente renovadas, combinan confort y modernidad."
    ],
    "nl": [
      "De Rendez-vous des Chasseurs ligt op 800 meter hoogte, op de grens van de Forez, de Auvergne en de Bourbonnais, en ontvangt u in een warm kader. De volledig gerenoveerde kamers combineren comfort en moderniteit."
    ]
  },
