      "@id": "https://data.datatourisme.fr/f489b01a-e294-35fe-9b52-b1c8b71a6869",
      "dc:description": {
        "de": [
          "Fischgeschäft Einzelhandel: Fisch, Filets, Muscheln, Krustentiere, Gepökeltes, Meeresfrüchteplatte, Fertiggerichte.\nBefindet sich auf dem Boulevard Edmond Labrasse in Stella-Plage."
        ],
        "en": [
          "Fish retail: fish, fillets, shellfish, cured meats, seafood platters, ready-made meals.\nLocated on Boulevard Edmond Labrasse, Stella-Plage."
        ],
        "it": [
          "Pescheria al dettaglio: pesce, filetti, crostacei, salumi, piatti di pesce, piatti pronti.\nSituato in Boulevard Edmond Labrasse a Stella-Plage."
        ],
        "fr": [
          "Poissonnerie détail : poissons, filets, coquillages, crustacés, salaisons, plateau de fruits de mer, plats cuisinés.\nSitué sur le Boulevard Edmond Labrasse à Stella-Plage."
        ],
        "es": [
          "Pescadería al por menor: pescados, filetes, mariscos, embutidos, bandejas de marisco, platos preparados.\nSituado en el Boulevard Edmond Labrasse en Stella-Plage."
        ],
        "nl": [
          "Detailhandel in vis: vis, filets, schaaldieren, vleeswaren, visgerechten, kant-en-klaarmaaltijden.\nGevestigd op de Edmond Labrasse Boulevard in Stella-Plage."
        ]
      },
