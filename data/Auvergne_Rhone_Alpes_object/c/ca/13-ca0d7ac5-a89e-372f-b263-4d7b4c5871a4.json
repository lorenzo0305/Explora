  "rdfs:comment": {
    "de": [
      "Wir sind unabhängig und setzen auf qualitativ hochwertige, meist lokale oder regionale Produkte, um Ihnen ein einzigartiges Erlebnis zu bieten und gleichzeitig die Umwelt so wenig wie möglich zu belasten."
    ],
    "en": [
      "Independent, we put forward high quality products, most often local or regional, to bring you a unique experience while having the least possible impact on the environment."
    ],
    "it": [
      "Indipendenti, ci concentriamo su prodotti di alta qualità, per lo più locali o regionali, per offrirvi un'esperienza unica con il minor impatto possibile sull'ambiente."
    ],
    "fr": [
      "Indépendant, nous mettons en avant des produits ultra qualitatifs le plus souvent locaux ou régionaux pour vous apporter une expérience unique tout en impactant le moins possible l’environnement."
    ],
    "nl": [
      "Onafhankelijk, richten wij ons op producten van hoge kwaliteit, meestal lokaal of regionaal, om u een unieke ervaring te bieden met zo min mogelijk impact op het milieu."
    ],
    "es": [
      "Independientes, nos centramos en productos de alta calidad, en su mayoría locales o regionales, para ofrecerle una experiencia única con el menor impacto posible en el medio ambiente."
    ]
  },
  "rdfs:label": {
