  "rdfs:comment": {
    "de": [
      "Gras- und Laubfrösche, Erdkröten und Kammmolche bevölkern den üppig bewachsenen Teich von Frontenat."
    ],
    "en": [
      "Red and agile frogs, common toads, webbed newts populate the Frontenat pond with abundant vegetation."
    ],
    "it": [
      "Rane rosse, rane agili, rospi comuni e tritoni palmati popolano lo stagno Frontenat con la sua abbondante vegetazione."
    ],
    "fr": [
      "Grenouilles rousses et agiles, crapauds communs, tritons palmés peuplent la mare de Frontenat à la végétation abondante."
    ],
    "nl": [
      "Rode kikkers, beweeglijke kikkers, gewone padden en ringsalamanders bevolken de vijver van Frontenat met zijn overvloedige vegetatie."
    ],
    "es": [
      "Ranas rojas, ranas ágiles, sapos comunes y tritones palmeados pueblan el estanque del Frontenat con su abundante vegetación."
