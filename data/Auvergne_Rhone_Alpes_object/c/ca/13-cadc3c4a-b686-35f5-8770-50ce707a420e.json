  "rdfs:comment": {
    "de": [
      "Zwischen Cluses und Annemasse, im Herzen des Dorfes Saint-Jeoire und in der Nähe des Massif des Brasses gelegen, bieten wir Ihnen einen gastronomischen Zwischenstopp. Themenabende im Jahr."
    ],
    "en": [
      "Located between Cluses and Annemasse in the heart of the charming town of Saint-Jeoire, we offer you a gourmet stopover."
    ],
    "it": [
      "Situato tra Cluses e Annemasse, nel cuore del villaggio di Saint-Jeoire e vicino al Massiccio degli Ottoni, vi offriamo una sosta gastronomica. Serate a tema durante tutto l'anno."
    ],
    "fr": [
      "Situé entre Cluses et Annemasse, au coeur du village de Saint-Jeoire et à proximité du Massif des Brasses, nous vous proposons une étape gastronomique. Soirée à thème dans l'année."
    ],
    "es": [
      "Situado entre Cluses y Annemasse, en el corazón del pueblo de Saint-Jeoire y cerca del Macizo de los Bronces, le ofrecemos una parada gastronómica. Veladas temáticas durante todo el año."
    ],
    "nl": [
      "Gelegen tussen Cluses en Annemasse, in het hart van het dorp Saint-Jeoire en dicht bij het Massif des Brasses, bieden wij u een gastronomische tussenstop. Thema-avonden gedurende het hele jaar."
    ]
  },
