  "rdfs:comment": {
    "de": [
      "Mazarotte et Cie ist ein sozialer Club, der das ganze Jahr über verschiedene Animationen und Aktivitäten organisiert, die für alle zugänglich sind: Nähen, Capoeira, bildende Kunst, Kochworkshops, Pony- und Zirkuspraktika..."
    ],
    "en": [
      "Mazarotte et Cie is a social club that organizes various activities throughout the year, accessible to all: sewing, capoeira, plastic arts, cooking workshop, pony and circus training..."
    ],
    "it": [
      "Mazarotte et Cie è un club sociale che organizza diverse attività durante l'anno, accessibili a tutti: cucito, capoeira, arti plastiche, laboratori di cucina, corsi di formazione sui pony e sul circo, ecc."
    ],
    "fr": [
      "Mazarotte et Cie est un club social organisant tout au long de l'année des animations et activités variées accessibles à tous : couture, capoeira, art plastique, atelier cuisine, stage poney et cirque..."
    ],
    "nl": [
      "Mazarotte et Cie is een sociale club die het hele jaar door verschillende activiteiten organiseert die voor iedereen toegankelijk zijn: naaien, capoeira, plastische kunsten, kookworkshops, pony- en circuslessen, enz."
    ],
    "es": [
      "Mazarotte et Cie es un club social que organiza diversas actividades a lo largo del año, accesibles a todos: costura, capoeira, artes plásticas, talleres de cocina, cursos de adiestramiento para ponis y circo, etc."
    ]
  },
  "rdfs:label": {
