  "rdfs:comment": {
    "de": [
      "Die Diskothek Lamartine befindet sich im Stadtzentrum von Grenoble auf dem Place Victor Hugo und empfängt Sie jedes Wochenende bis 7 Uhr morgens in einer allgemeinen Atmosphäre. Außergewöhnlicher Sound, Dj Guest, Shows, Künstler und Animationen."
    ],
    "en": [
      "Located in the heart of Grenoble on Place Victor Hugo, the Lamartine discotheque welcomes you every weekend until 7am in a generalist atmosphere. Exceptional sound, Dj Guest, Shows, Artists and Animations."
    ],
    "it": [
      "Situata nel pieno centro di Grenoble, in Place Victor Hugo, la discoteca Lamartine vi accoglie ogni fine settimana fino alle 7 del mattino in un'atmosfera generalista. Suono eccezionale, DJ ospiti, spettacoli, artisti e intrattenimento."
    ],
    "fr": [
      "Située en plein centre ville de Grenoble sur la place Victor Hugo, la discothèque Lamartine vous accueille tous les week-ends jusqu'à 7h du matin dans une ambiance généraliste. Son d'exception, Dj Guest, Spectacles, Artistes et Animations."
    ],
    "es": [
      "Situada en pleno centro de Grenoble, en la Place Victor Hugo, la discoteca Lamartine le acoge todos los fines de semana hasta las 7 de la mañana en un ambiente generalista. Sonido excepcional, DJ invitados, espectáculos, artistas y animación."
    ],
    "nl": [
      "De nachtclub Lamartine, gelegen in het centrum van Grenoble op de Place Victor Hugo, verwelkomt je elk weekend tot 7 uur in een generalistische sfeer. Uitzonderlijk geluid, gast-DJ's, shows, artiesten en entertainment."
    ]
  },
  "rdfs:label": {
