  "rdfs:comment": {
    "de": [
      "Nur wenige Schritte vom Dorf entfernt, in der Drôme Provençale, beherbergt der 40 Hektar große Parc Réjaubert das Hotelgut Les Sources de Dieulefit, das nach Süden ausgerichtet ist und in einer außergewöhnlichen Umgebung liegt. Entdecken Sie unser Restaurant Lucas, in dem unser Küchenchef Sie verwöhnen wird."
    ],
    "en": [
      "Just a stone's throw from the village in Drôme Provençale, the 40-hectare Réjaubert park is home to Les Sources de Dieulefit, a south-facing hotel estate in an exceptional setting. Discover our restaurant Lucas where our Chef will delight you."
    ],
    "it": [
      "A pochi passi dal villaggio nella Drôme Provençale, il parco Réjaubert di 40 ettari ospita Les Sources de Dieulefit, un hotel esposto a sud in un contesto eccezionale. Scoprite il nostro ristorante Lucas dove il nostro Chef vi delizierà."
    ],
    "fr": [
      "A quelques pas du village, en Drôme Provençale, le parc Réjaubert de 40 hectares, accueille un domaine hôtelier Les Sources de Dieulefit, orienté plein sud dans un cadre exceptionnel. Découvrez notre restaurant Lucas où notre Chef vous régalera."
    ],
    "nl": [
      "Op een steenworp afstand van het dorp in de Drôme Provençale ligt in het park Réjaubert van 40 hectare Les Sources de Dieulefit, een hotel op het zuiden in een uitzonderlijke omgeving. Ontdek ons restaurant Lucas waar onze chef-kok u in verrukking zal brengen."
    ],
    "es": [
      "A dos pasos del pueblo, en la Drôme provenzal, el parque de 40 hectáreas de Réjaubert alberga Les Sources de Dieulefit, un hotel orientado al sur en un marco excepcional. Descubra nuestro restaurante Lucas donde nuestro Chef le deleitará."
    ]
  },
