  "rdfs:comment": {
    "de": [
      "Auch die Kleinsten können auf den Schlittenplätzen des Skigebiets in aller Sicherheit die Hänge hinuntersausen! \r\nAlso, lassen Sie sie rutschen!"
    ],
    "en": [
      "Even the very youngest can slide down the pistes in complete safety in the resort's toboggan areas! \r\nGo on! Let 'em slide!"
    ],
    "it": [
      "Anche i bambini più piccoli possono scivolare sulle piste in tutta sicurezza nelle aree di slittino del resort!\r\nQuindi lasciateli scivolare!"
    ],
    "fr": [
      "Même les plus petits pourront dévaler les pentes en toute sécurité sur les espaces luges de la station ! \r\nAlors, laissez les glisser !"
    ],
    "nl": [
      "Zelfs de kleinsten zullen in alle veiligheid naar beneden glijden op de sleepistes van het skioord!\r\nVooruit dus ! Glijden !"
    ],
    "es": [
      "Incluso los más pequeños pueden deslizarse por las pistas con total seguridad en las zonas de trineo de la estación\r\n¡Así que déjenlos pasar!"
    ]
  },
