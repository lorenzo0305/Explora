  "rdfs:comment": {
    "de": [
      "Poetischer Spaziergang\r\n\r\nIhre gemeinsame Sensibilität führt sie auf den Weg der Kreation.\r\nRecherche, Geduld und Reflexion führen zur Begegnung mit Autoren. ..."
    ],
    "en": [
      "Poetic stroll\r\n\r\nTheir shared sensibility guides them along the paths of creation.\r\nResearch, patience and reflection lead to encounters with authors..."
    ],
    "it": [
      "Passeggiata poetica\r\n\r\nLa loro sensibilità comune li conduce sulla strada della creazione.\r\nLa ricerca, la pazienza e la riflessione portano all'incontro con gli autori..."
    ],
    "fr": [
      "Balade poétique\r\n\r\nLeur sensibilité commune les oriente sur les chemins de la création.\r\nRecherche, patience, réflexion, aboutissent à la rencontre d'auteurs. ..."
    ],
    "nl": [
      "Poëtische wandeling\r\n\r\nHun gedeelde gevoeligheid leidt hen op het pad van de creatie.\r\nOnderzoek, geduld en reflectie leiden tot ontmoetingen met auteurs..."
    ],
    "es": [
      "Paseo poético\r\n\r\nSu sensibilidad compartida les lleva por el camino de la creación.\r\nInvestigación, paciencia y reflexión conducen a encuentros con autores..."
    ]
