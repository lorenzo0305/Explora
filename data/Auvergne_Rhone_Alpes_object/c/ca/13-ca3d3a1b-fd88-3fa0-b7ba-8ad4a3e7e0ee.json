  "rdfs:comment": {
    "de": [
      "Die Gemeinde Châteauvilain hat in der Nähe des Spielplatzes und des City-Stadions einen Pumptrack/Skatepark eingerichtet. Die 37 m lange Strecke ist für Fahrräder, Mountainbikes, BWX, Skateboards, Inlineskates und Roller bestimmt!"
    ],
    "en": [
      "The commune of Châteauvilain has installed a Pumptrack/Skate Park near the playground and the city stadium. This 37m track is intended for users of bikes, mountain bikes, BWX, skateboards, rollerblades, scooters!"
    ],
    "it": [
      "Il comune di Châteauvilain ha installato un Pumptrack/Skate Park accanto al parco giochi e allo stadio cittadino. Questa pista di 37 metri è progettata per gli utenti di biciclette, mountain bike, BWX, skateboard, rollerblade e monopattini!"
    ],
    "fr": [
      "La commune de Châteauvilain a installé un Pumptrack/Skate Park à proximité de l'aire de jeux et du city stade. Cette piste de 37m est destinée aux utilisateurs de vélos, VTT, BWX, Skateboards, rollers, trottinettes!"
    ],
    "es": [
      "El municipio de Châteauvilain ha instalado un Pumptrack/Skate Park junto al parque infantil y el estadio municipal. Esta pista de 37 metros está diseñada para usuarios de bicicletas, bicicletas de montaña, BWX, monopatines, patines y patinetes"
    ],
    "nl": [
      "De gemeente Châteauvilain heeft een Pumptrack/Skate Park geïnstalleerd naast de speeltuin en het stadsstadion. Deze baan van 37 meter is ontworpen voor gebruikers van fietsen, mountainbikes, BWX, skateboards, skeelers en steps!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "City Stade de Châteauvilain"
    ]
  },
