  "rdfs:comment": {
    "de": [
      "Gut gelegenes Lokal an der Kreuzung der Straßen nach Bourg-en-Bresse und Mâcon mit zwei gemütlichen, neu renovierten Sälen mit Lounge-Atmosphäre. Neu: \"hausgemachte Burger\". Gruppenmenü auf Anfrage."
    ],
    "en": [
      "Conveniently located at the intersection of the Bourg-en-Bresse and Mâcon roads, with two recently renovated rooms and a lounge atmosphere. New: \"homemade burger\". Group menu on request."
    ],
    "it": [
      "Locale ben posizionato all'incrocio tra le strade di Bourg-en-Bresse e Mâcon, con due accoglienti camere recentemente rinnovate e un'atmosfera lounge. Novità: \"hamburger fatto in casa\". Menu per gruppi su richiesta."
    ],
    "fr": [
      "Etablissement bien situé à l'intersection des routes de Bourg-en-Bresse et Mâcon avec deux salles conviviales récemment rénovées, ambiance Lounge. Nouveauté:  \"burger maison\". Menu groupe sur demande."
    ],
    "nl": [
      "Goed gelegen etablissement op de kruising van de wegen Bourg-en-Bresse en Mâcon, met twee vriendelijke, onlangs gerenoveerde kamers en een loungesfeer. Nieuw: \"huisgemaakte hamburger\". Groepsmenu op aanvraag."
    ],
    "es": [
      "Establecimiento bien situado en el cruce de las carreteras de Bourg-en-Bresse y Mâcon, con dos habitaciones acogedoras recientemente renovadas y un ambiente de salón. Novedad: \"hamburguesa casera\". Menú para grupos previa petición."
    ]
  },
  "rdfs:label": {
