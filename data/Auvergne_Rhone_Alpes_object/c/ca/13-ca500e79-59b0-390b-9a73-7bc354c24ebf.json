  "rdfs:comment": {
    "de": [
      "Das Hotel liegt im Herzen der Stadt, gegenüber dem Lecoq-Garten, neben dem Kulturhaus und 5 Gehminuten vom Place de Jaude entfernt."
    ],
    "en": [
      "Located in the heart of town, opposite the Jardin Lecoq, next to the Maison de la Culture and a 5-minute walk from Place de Jaude."
    ],
    "it": [
      "Situato nel cuore della città, di fronte al giardino Lecoq, accanto alla Maison de la Culture e a 5 minuti a piedi da Place de Jaude."
    ],
    "fr": [
      "Situé au cœur de la ville, en face du jardin Lecoq, à côté de la maison de la culture et à 5 min à pied de la place de Jaude."
    ],
    "es": [
      "Situado en el corazón de la ciudad, frente al jardín Lecoq, junto a la Maison de la Culture y a 5 minutos a pie de la Place de Jaude."
    ],
    "nl": [
      "Gelegen in het hart van de stad, tegenover de Lecoq-tuin, naast het Maison de la Culture en op 5 minuten lopen van het Place de Jaude."
    ]
  },
