  "rdfs:comment": {
    "de": [
      "Das Restaurant Kern liegt im Herzen des Vallée d'Aulps, zwischen dem Genfer See und den Tälern von Morzine. Es bietet Ihnen eine friedliche Etappe in einem kleinen Dorf in Hochsavoyen."
    ],
    "en": [
      "Situated in the heart of the Vallee d'Aulps, between Lake Geneva and the Morzine valley, Kern Restaurant provides the perfect setting for a relaxing stay in a small village in the Haute-Savoie."
    ],
    "it": [
      "Situato nel cuore della Vallée d'Aulps, tra il Lago di Ginevra e le valli di Morzine, il ristorante Kern vi offre una sosta tranquilla in un piccolo villaggio dell'Alta Savoia."
    ],
    "fr": [
      "Située au coeur de la Vallée d'Aulps, entre le lac Léman et les vallées de Morzine, le restaurant Kern vous offre une étape paisible dans un petit village haut savoyard."
    ],
    "es": [
      "Situado en el corazón de la Vallée d'Aulps, entre el lago Lemán y los valles de Morzine, el restaurante Kern le ofrece una parada tranquila en un pequeño pueblo del Alto Saboya."
    ],
    "nl": [
      "Gelegen in het hart van de Vallée d'Aulps, tussen het meer van Genève en de valleien van Morzine, biedt het restaurant Kern u een rustige tussenstop in een klein dorpje in de Haut Savoie."
    ]
  },
  "rdfs:label": {
