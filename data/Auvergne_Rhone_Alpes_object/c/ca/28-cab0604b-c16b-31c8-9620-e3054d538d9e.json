  "rdfs:comment": {
    "de": [
      "Willkommen im Keller und in der Bar, die dem Craft Beer gewidmet sind: ein Keller mit mehr als 250 Referenzen, eine gemütliche Bar mit 8 Zapfhähnen, Bier in \"loser Schüttung\" und alles, was Ihren Gaumen verwöhnt!"
    ],
    "en": [
      "Welcome to the cellar and bar dedicated to craft beer: a cellar with more than 250 references, a cosy bar with 8 spouts, beer in \"bulk\" and everything to delight your taste buds!"
    ],
    "it": [
      "Benvenuti nella cantina e nel bar dedicati alla birra artigianale: una cantina con oltre 250 referenze, un bar accogliente con 8 spine, birra sfusa e tutto ciò che serve per deliziare il vostro palato!"
    ],
    "fr": [
      "Bienvenue dans la cave et bar dédiés à la bière craft : une cave avec plus de 250 références, un bar cosy et ses 8 becs, de la bière en \"vrac\" et de quoi ravir vos papilles!"
    ],
    "nl": [
      "Welkom in de kelder en bar gewijd aan ambachtelijk bier: een kelder met meer dan 250 referenties, een gezellige bar met 8 tuiten, bier in bulk en alles om je smaakpapillen te verwennen!"
    ],
    "es": [
      "Bienvenido a la bodega y al bar dedicados a la cerveza artesanal: una bodega con más de 250 referencias, un acogedor bar con 8 surtidores, cerveza a granel y ¡todo para deleitar su paladar!"
    ]
  },
