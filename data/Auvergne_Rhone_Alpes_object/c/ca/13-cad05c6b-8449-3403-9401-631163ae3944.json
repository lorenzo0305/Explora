  "rdfs:comment": {
    "de": [
      "Das Jungle Hotel bietet Ihnen hochwertige Zimmer in einer Umgebung im Motelstil. Unsere 29 ebenerdigen Zimmer sind geräumig, schallisoliert und klimatisiert, einige davon sind speziell für Personen mit eingeschränkter Mobilität geeignet."
    ],
    "en": [
      "A motel-type hotel (all the rooms are on the ground floor), with very quiet rooms. Weekday catering with buffet breakfast, meeting room, seminars."
    ],
    "it": [
      "Il Jungle Hotel offre sistemazioni di qualità in un ambiente in stile motel. Le nostre 29 camere a un piano sono spaziose, insonorizzate e dotate di aria condizionata, con alcune appositamente progettate per gli ospiti disabili."
    ],
    "fr": [
      "Le Jungle Hotel vous offre des chambres de qualité dans un cadre de style motel. Nos 29 chambres de plain-pied sont spacieuses, insonorisées et climatisées, certaines étant spécialement conçues pour les personnes à mobilité réduite."
    ],
    "nl": [
      "Het Jungle Hotel biedt kwaliteitsaccommodatie in een motelachtige omgeving. Onze 29 kamers met één verdieping zijn ruim, geluiddicht en voorzien van airconditioning, waarvan sommige speciaal zijn ontworpen voor gasten met een lichamelijke beperking."
    ],
    "es": [
      "El Jungle Hotel ofrece alojamiento de calidad en un ambiente de motel. Nuestras 29 habitaciones de una sola planta son espaciosas, están insonorizadas y cuentan con aire acondicionado, y algunas están especialmente diseñadas para huéspedes discapacitados."
    ]
  },
  "rdfs:label": {
    "en": [
      "Hotel 'Inattendu"
    ],
    "fr": [
      "Hôtel In Jungle"
    ]
  },
