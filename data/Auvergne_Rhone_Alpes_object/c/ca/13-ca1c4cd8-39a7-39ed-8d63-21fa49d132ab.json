  "rdfs:comment": {
    "de": [
      "Aux C?urs Fidèles, ehemals La Ruche, bleibt unseren Wurzeln in der Ardèche und den Klassikern der Bistros und Bouchons treu. Lokale Produkte, die mit Leidenschaft verarbeitet werden, eine schöne Auswahl an Weinen und eine gesellige Atmosphäre für Bon vivants!"
    ],
    "en": [
      "Aux Cœurs Fidèles, formerly La Ruche, stays true to its Ardèche roots and the classics of bistros and bouchons. Local products crafted with passion, a fine selection of wines, and a warm atmosphere for true food lovers!"
    ],
    "it": [
      "Aux C?urs Fidèles, ex La Ruche, è fedele alle nostre radici nell'Ardèche e ai classici bistrot e bouchon. Prodotti locali preparati con passione, un'ottima selezione di vini e un'atmosfera amichevole per i bon vivants!"
    ],
    "fr": [
      "Aux Cœurs Fidèles, anciennement La Ruche, fidèle à nos racines ardéchoises et aux classiques des bistrots et bouchons. Des produits locaux travaillés avec passion, une belle sélection de vins et une ambiance conviviale pour bons vivants !"
    ],
    "es": [
      "Aux Cœurs Fidèles, antes La Ruche, es fiel a nuestras raíces de Ardèche y a los clásicos de los bistrós y bouchons. Productos locales preparados con pasión, una buena selección de vinos y un ambiente acogedor para los bon vivants"
    ],
    "nl": [
      "Aux C?urs Fidèles, voorheen La Ruche, is trouw aan onze wortels in de Ardèche en aan de klassiekers van bistro's en bouchons. Met passie bereide streekproducten, een fijne selectie wijnen en een gezellige sfeer voor levensgenieters!"
    ]
  },
