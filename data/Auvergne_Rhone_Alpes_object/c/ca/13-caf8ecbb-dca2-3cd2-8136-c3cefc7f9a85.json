  "rdfs:comment": {
    "de": [
      "Die Bibliothek befindet sich im ehemaligen Rathaus und öffnet ihre Türen für alle. Dieser Ort bietet Ihnen einen geselligen Raum zur Entspannung. Hier können Sie sich Zeit nehmen, um sich mit einer großen Auswahl an Büchern weiterzubilden."
    ],
    "en": [
      "Located in the former town hall, the library is open to all. It's a friendly place to relax. You'll be able to take your time and enjoy a wide selection of books."
    ],
    "it": [
      "Situata nell'ex municipio, la biblioteca è aperta a tutti. È un luogo accogliente dove rilassarsi. Potrete prendervi il vostro tempo e godervi un'ampia selezione di libri."
    ],
    "fr": [
      "Située dans l'ancienne mairie, la bibliothèque ouvre ses portes à tous. Ce lieu vous offre un espace de détente convivial. Vous pourrez prendre le temps de vous cultiver avec un large choix de livres."
    ],
    "es": [
      "Situada en el antiguo ayuntamiento, la biblioteca está abierta a todos. Es un lugar acogedor donde relajarse. Podrá tomarse su tiempo y disfrutar de una amplia selección de libros."
    ],
    "nl": [
      "De bibliotheek is gevestigd in het voormalige stadhuis en is voor iedereen toegankelijk. Het is een vriendelijke plek om te ontspannen. Je kunt er rustig de tijd nemen en genieten van een brede selectie boeken."
    ]
  },
  "rdfs:label": {
