  "rdfs:comment": {
    "de": [
      "Elise und Arnaud sind Musher, Gemüsebauern und Bienenzüchter. Sie leben das ganze Jahr über mit ihren Hunden in ihrem kleinen Dorf Vassieux-en-Vercors."
    ],
    "en": [
      "Elise and Arnaud are mushers, market gardeners and beekeepers. They live year-round with their dogs in their little village of Vassieux-en-Vercors."
    ],
    "it": [
      "Elise e Arnaud sono mushers, ortolani e apicoltori. Vivono tutto l'anno con i loro cani nel piccolo villaggio di Vassieux-en-Vercors."
    ],
    "fr": [
      "Elise et Arnaud sont mushers, maraîchers et apiculteurs. Ils vivent à l'année avec leurs chiens dans leur petit village de Vassieux-en-Vercors."
    ],
    "es": [
      "Elise y Arnaud son mushers, horticultores y apicultores. Viven todo el año con sus perros en su pequeño pueblo de Vassieux-en-Vercors."
    ],
    "nl": [
      "Elise en Arnaud zijn mushers, tuinders en imkers. Ze wonen het hele jaar door met hun honden in hun dorpje Vassieux-en-Vercors."
    ]
  },
