  "rdfs:comment": {
    "de": [
      "Sicherer Rodelhang in der Nähe des Skigebiets Le Plan. Zugänglich für alle, Kinder unter Aufsicht der Eltern."
    ],
    "en": [
      "A safe sledging slope created close to Le Plan ski area.  Open to everyone, children must be accompanied by parents/adults."
    ],
    "it": [
      "Area slittino per bambini dai 6 anni in su, attrezzata e protetta vicino al comprensorio sciistico Portes du Mont-Blanc\r\nAccesso libero, sotto la responsabilità dei genitori."
    ],
    "fr": [
      "Espace luge pour les enfants de 6 ans et + aménagé et sécurisé à proximité du domaine skiable des  Portes du Mont-Blanc. \r\nAccès libre, sous la responsabilité des parents."
    ],
    "es": [
      "Zona de trineos para niños a partir de 6 años, acondicionada y asegurada cerca del dominio esquiable de Portes du Mont-Blanc\r\nAcceso libre, bajo la responsabilidad de los padres."
    ],
    "nl": [
      "Ingericht en beveiligd sleegebied voor kinderen vanaf 6 jaar in de buurt van het skigebied Portes du Mont-Blanc\r\nVrije toegang, onder verantwoordelijkheid van de ouders."
    ]
  },
