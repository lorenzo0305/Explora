  "rdfs:comment": {
    "de": [
      "Authentische Pizzen aus dem Holzofen, zubereitet mit frischen Zutaten und einer unvergleichlichen italienischen Leidenschaft. Unser handgemachter Teig, unsere hausgemachte Tomatensauce und unsere hochwertigen Zutaten sind die Grundlage für unsere einzigartigen Kreationen."
    ],
    "en": [
      "Authentic wood-fired pizzas, prepared with fresh ingredients and unrivalled Italian passion. Our artisanal dough, homemade tomato sauce and quality ingredients are the foundation of our unique creations."
    ],
    "it": [
      "Autentiche pizze cotte a legna realizzate con ingredienti freschi e un'impareggiabile passione italiana. L'impasto fatto in casa, la salsa di pomodoro artigianale e gli ingredienti di qualità sono alla base delle nostre creazioni uniche."
    ],
    "fr": [
      "Des pizzas authentiques cuites au feu de bois, préparées avec des ingrédients frais et une passion italienne inégalée. Notre pâte artisanale, notre sauce tomate maison et nos ingrédients de qualité sont la base de nos créations uniques."
    ],
    "nl": [
      "Authentieke houtovenpizza's gemaakt met verse ingrediënten en ongeëvenaarde Italiaanse passie. Ons zelfgemaakte deeg, zelfgemaakte tomatensaus en kwaliteitsingrediënten vormen de basis van onze unieke creaties."
    ],
    "es": [
      "Auténticas pizzas al horno de leña elaboradas con ingredientes frescos y una pasión italiana sin igual. Nuestra masa casera, salsa de tomate casera e ingredientes de calidad son la base de nuestras creaciones únicas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Pizzeria Esposito"
    ]
  },
