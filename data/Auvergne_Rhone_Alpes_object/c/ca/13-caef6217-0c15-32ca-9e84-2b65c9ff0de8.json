  "rdfs:comment": {
    "de": [
      "Ich bin Steuerungs- und Managementberater für die Chefs von Kleinstunternehmen in der Region mit der Rivalis-Gruppe als Partner (mehr als 30 Jahre Erfahrung in der Begleitung und Steuerung von Kleinstunternehmen)."
    ],
    "en": [
      "I'm a management consultant for small business owners in the region, working in partnership with the Rivalis group (over 30 years' experience in supporting and managing small businesses)."
    ],
    "it": [
      "Sono un consulente di gestione per le piccolissime imprese della regione, in collaborazione con il gruppo Rivalis (oltre 30 anni di esperienza nel sostegno e nella gestione di piccolissime imprese)."
    ],
    "fr": [
      "Je suis conseiller de pilotage et de gestion auprès des patrons de TPE de la région avec comme partenaire le groupe Rivalis (plus de 30 ans d'expérience dans l'accompagnement et le pilotage de TPE)."
    ],
    "es": [
      "Soy consultor de gestión para los propietarios de muy pequeñas empresas de la región, y trabajo en colaboración con el grupo Rivalis (más de 30 años de experiencia en el apoyo y la gestión de muy pequeñas empresas)."
    ],
    "nl": [
      "Ik ben managementconsultant voor eigenaren van zeer kleine bedrijven in de regio en werk samen met de Rivalis-groep (meer dan 30 jaar ervaring in het ondersteunen en managen van zeer kleine bedrijven)."
    ]
  },
  "rdfs:label": {
