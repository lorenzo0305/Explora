  "rdfs:comment": {
    "de": [
      "Zwischen Evian und Lausanne werden von der CGN, die auch über sehr schöne Raddampfer verfügt, das ganze Jahr über Bootsverbindungen über angeboten."
    ],
    "en": [
      "All year, the “Compagnie Générale de Navigation” (CGN) ferries passengers across the lake between France and Switzerland. In summer, the CGN also offers a variety of themed tours and crossings on board beautiful paddle-wheel steamboats."
    ],
    "it": [
      "Le navette per il lago sono fornite tutto l'anno tra Evian e Losanna dalla CGN (costo di andata e ritorno in 2a classe: 36 € a persona)."
    ],
    "fr": [
      "Les navettes lacustres sont assurées toute l'année entre Evian et Lausanne par la CGN (coût aller-retour en 2eme classe : 36 € par personne)."
    ],
    "es": [
      "La CGN ofrece durante todo el año lanzaderas lacustres entre Evian y Lausana (coste del viaje de ida y vuelta en 2ª clase: 36 € por persona)."
    ],
    "nl": [
      "Het hele jaar door rijden er pendeldiensten tussen Evian en Lausanne op de CGN (2e klas retour: €36 per persoon)."
    ]
  },
  "rdfs:label": {
