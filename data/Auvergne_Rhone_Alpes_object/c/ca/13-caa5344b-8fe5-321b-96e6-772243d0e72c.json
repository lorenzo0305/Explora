  "rdfs:comment": {
    "de": [
      "Das Team der Mediathek in Bellentre bietet dem Publikum eine breite Palette an Lesestoff. Ob Erwachsene oder Kinder, für jeden Geschmack ist etwas dabei!"
    ],
    "en": [
      "The team from Bellentre public library offers a wide range of reading. We have something for everyone -children and adults!"
    ],
    "it": [
      "Il team della mediateca di Bellentre offre al pubblico una vasta gamma di letture. Che siate adulti o bambini, ce n'è per tutti i gusti!"
    ],
    "fr": [
      "L'équipe de la médiathèque de Bellentre offre au public un large panel de lectures. Que l'on soit adulte ou enfant, il y en a pour tous les goûts !"
    ],
    "nl": [
      "Het bibliotheekteam van Bellentre biedt het publiek een ruime keuze aan leesmateriaal. Of u nu een volwassene of een kind bent, er is voor elk wat wils!"
    ],
    "es": [
      "El equipo de la mediateca de Bellentre ofrece al público un amplio abanico de lecturas. Tanto para adultos como para niños, ¡hay para todos los gustos!"
    ]
  },
