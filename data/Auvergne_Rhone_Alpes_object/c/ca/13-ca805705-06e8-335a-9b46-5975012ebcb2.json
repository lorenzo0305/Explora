  "rdfs:comment": {
    "de": [
      "Entdecken Sie Méribel auf einer geführten Schneeschuhwanderung. Das ist der ideale Weg, um frische Luft zu schnappen und die Berge in vollen Zügen zu genießen!"
    ],
    "en": [
      "Discover Méribel on a guided snowshoe walk. It's the ideal way to get a breath of fresh air and enjoy the mountains to the full!"
    ],
    "it": [
      "Scoprite Méribel con una passeggiata guidata con le racchette da neve. È il modo perfetto per prendere una boccata d'aria fresca e godersi appieno le montagne!"
    ],
    "fr": [
      "Découvrez Méribel lors d’une balade en raquettes accompagnée. C’est l’idéal pour prendre un grand bol d’air et de profiter pleinement de la montagne !"
    ],
    "nl": [
      "Ontdek Méribel tijdens een begeleide sneeuwschoentocht. Het is de ideale manier om uit te waaien en volop van de berg te genieten!"
    ],
    "es": [
      "Descubra Méribel con un paseo guiado con raquetas de nieve. Es la forma perfecta de respirar aire fresco y disfrutar al máximo de la montaña"
    ]
  },
  "rdfs:label": {
