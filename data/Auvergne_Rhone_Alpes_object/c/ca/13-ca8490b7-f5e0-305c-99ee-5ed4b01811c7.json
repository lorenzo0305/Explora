  "rdfs:comment": {
    "de": [
      "Die Musikschule von Langeac, die von der Musikschule Brivadoise geleitet wird, bietet Gesangs-, Musiktheorie-, Schlagzeug-, Percussion-, Gitarren-, Klavier- und Geigenunterricht sowie eine musikalische Früherziehung (5-6 Jahre) und einen Eltern-Kind-Workshop (3-4 Jahre) im Rathaus an."
    ],
    "en": [
      "The Langeac music school, run by the Ecole de Musique Brivadoise, offers classes in singing, music theory, drums, percussion, guitar, piano and violin, as well as a musical awakening program (5-6 years) and a parents-children workshop (3-4 years) at the Mairie."
    ],
    "it": [
      "La scuola di musica di Langeac, gestita dall'Ecole de Musique Brivadoise, offre lezioni di canto, teoria musicale, batteria, percussioni, chitarra, pianoforte e violino, oltre a un corso di introduzione alla musica (per bambini di 5-6 anni) e un laboratorio genitori-bambini (per bambini di 3-4 anni) presso la Mairie."
    ],
    "fr": [
      "L'école de musique de Langeac, dirigée par l'école de musique Brivadoise, propose des cours de chant, de solfège, de batterie percussions, guitare, piano, violon ainsi qu'un éveil musical (5-6 ans) et un atelier parents enfants (3-4 ans) à la Mairie."
    ],
    "es": [
      "La escuela de música de Langeac, dirigida por la Ecole de Musique Brivadoise, ofrece clases de canto, solfeo, batería, percusión, guitarra, piano y violín, así como un curso de iniciación a la música (para niños de 5 a 6 años) y un taller para padres e hijos (para niños de 3 a 4 años) en la Mairie."
    ],
    "nl": [
      "De muziekschool van Langeac, gerund door de Ecole de Musique Brivadoise, biedt zang-, muziektheorie-, drum-, percussie-, gitaar-, piano- en vioollessen, evenals een inleidende muziekcursus (voor kinderen van 5-6 jaar) en een ouder-kind workshop (voor kinderen van 3-4 jaar) in de Mairie."
    ]
  },
