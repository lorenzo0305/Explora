  "rdfs:comment": {
    "de": [
      "Bruno MONTCOUDIOL ist der König der Technik und wurde mit den ehrenvollsten Titeln wie Meilleur Ouvrier de France (2004) und Weltmeister (2006 Phoenix) ausgezeichnet."
    ],
    "en": [
      "Bruno MONTCOUDIOL's technical skills have earned him such honors as Meilleur Ouvrier de France (2004) and World Champion (2006 Phoenix)."
    ],
    "it": [
      "Maestro di abilità tecniche, Bruno MONTCOUDIOL è stato insignito dei titoli più prestigiosi, tra cui Meilleur Ouvrier de France (2004) e Campione del Mondo (2006 Phoenix)."
    ],
    "fr": [
      "Roi de la technicité, Bruno MONTCOUDIOL est reconnu par les titres les plus honorifiques comme Meilleur Ouvrier de France (2004), Champion du Monde (2006 Phoenix)."
    ],
    "es": [
      "Maestro de la técnica, Bruno MONTCOUDIOL ha sido galardonado con los títulos más prestigiosos, entre ellos Meilleur Ouvrier de France (2004) y Campeón del Mundo (2006 Phoenix)."
    ],
    "nl": [
      "Bruno MONTCOUDIOL is een meester in technische vaardigheden en is bekroond met de meest prestigieuze titels, waaronder Meilleur Ouvrier de France (2004) en Wereldkampioen (2006 Phoenix)."
    ]
  },
