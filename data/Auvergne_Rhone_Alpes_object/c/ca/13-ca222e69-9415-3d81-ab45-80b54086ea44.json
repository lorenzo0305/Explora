  "rdfs:comment": {
    "de": [
      "Paysans Direct ist ein Laden mit lokalen Produzentinnen und Produzenten, die eine Auswahl an biologischen und handwerklichen Produkten in einem kurzen Kreislauf ohne Zwischenhändler anbieten."
    ],
    "en": [
      "Paysans Direct is a store for local producers, offering a selection of organic and artisanal products in a short circuit, without intermediaries."
    ],
    "it": [
      "Paysans Direct è un negozio di produttori locali che offre una selezione di prodotti biologici e artigianali in un circuito breve, senza intermediari."
    ],
    "fr": [
      "Paysans Direct est un magasin de productrices et producteurs locaux, offrant une sélection de produits bio et artisanaux en circuit court, sans intermédiaires."
    ],
    "nl": [
      "Paysans Direct is een winkel voor lokale producenten, die een selectie biologische en ambachtelijke producten aanbiedt in een kort circuit, zonder tussenpersonen."
    ],
    "es": [
      "Paysans Direct es una tienda para productores locales, que ofrece una selección de productos ecológicos y artesanales en un circuito corto, sin intermediarios."
    ]
