  "rdfs:comment": {
    "de": [
      "Die Langlaufloipe beginnt am Parkplatz von Nyon, am Fuße der gleichnamigen Seilbahn: (Zugang mit dem Auto oder dem kostenlosen Pendelbus ? Linien N oder E Haltestelle ?téléphérique de Nyon?)."
    ],
    "en": [
      "The route from Nyon from l’Erigné is suitable for everyone. Access by car or free shuttle (N or E circuits, “telepherique de Nyon” stop)."
    ],
    "it": [
      "La corsa campestre parte dal parcheggio di Nyon, ai piedi dell'omonima funivia: (accesso in auto o con bus navetta gratuito - linee N o E - fermata funivia di Nyon)."
    ],
    "fr": [
      "La  piste  de  fond  débute  au  parking  de  Nyon, au pied du téléphérique du même nom : (accès en voiture ou en navette gratuite – lignes N ou E arrêt “téléphérique de Nyon”)."
    ],
    "es": [
      "La carrera campo a través comienza en el aparcamiento de Nyon, al pie del teleférico del mismo nombre: (acceso en coche o autobús lanzadera gratuito - líneas N o E - parada del teleférico de Nyon)."
    ],
    "nl": [
      "De langlaufloipe begint op de parkeerplaats van Nyon, aan de voet van de gelijknamige kabelbaan: (toegang met de auto of gratis pendelbus - lijn N of E halte \"téléphérique de Nyon\")."
    ]
  },
  "rdfs:label": {
    "en": [
      "Cross-country skiing in vallée de la Manche - col de Coux-Paradis"
    ],
    "fr": [
      "Ski de fond dans la vallée de la Manche - col de Coux-Paradis"
    ]
  },
