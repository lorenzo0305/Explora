  "rdfs:comment": {
    "de": [
      "Ein Reiher mit ausgebreiteten Flügeln angelt eine Dose und nicht einen Fisch: Menschen gefährden die Tierwelt."
    ],
    "en": [
      "A heron with outstretched wings catches a can, not a fish: humans are endangering wildlife."
    ],
    "it": [
      "Un airone con le ali spiegate prende una lattina invece di un pesce: l'uomo mette in pericolo la fauna selvatica."
    ],
    "fr": [
      "Un héron les ailes déployées pêche une canette et non un poisson : les humains mettent en danger la faune."
    ],
    "es": [
      "Una garza con las alas desplegadas atrapa una lata en lugar de un pez: los humanos están poniendo en peligro la vida salvaje."
    ],
    "nl": [
      "Een reiger met gespreide vleugels vangt een blikje in plaats van een vis: mensen brengen wilde dieren in gevaar."
    ]
  },
  "rdfs:label": {
    "de": [
