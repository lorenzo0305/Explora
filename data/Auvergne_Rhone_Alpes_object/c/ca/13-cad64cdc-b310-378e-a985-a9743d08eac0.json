    ],
    "en": [
      "Fresco: The heron - the pond changes"
    ],
    "it": [
      "Affresco: L'airone - lo stagno cambia"
    ],
    "fr": [
      "Fresque : Le héron - l’étang change"
    ],
    "nl": [
      "Fresco: De reiger - de vijver verandert"
    ]
  },
