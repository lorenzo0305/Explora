  "rdfs:comment": {
    "de": [
      "Justa-Film von Teresa Villaverde mit Madalena Cunha, Betty Faria, Ricardo Vidal. Im Jahr 2017 wird eine Region in Portugal von riesigen Bränden heimgesucht, die ganze Wälder und Menschenleben auslöschen."
    ],
    "en": [
      "Justa film directed by Teresa Villaverde with Madalena Cunha, Betty Faria, Ricardo Vidal. In 2017, a region of Portugal is ravaged by gigantic fires that sweep away entire forests? and lives."
    ],
    "it": [
      "Film Justa diretto da Teresa Villaverde, con Madalena Cunha, Betty Faria, Ricardo Vidal. Nel 2017, una regione del Portogallo è devastata da giganteschi incendi che spazzano via intere foreste? e vite."
    ],
    "fr": [
      "Film Justa réalisé par Teresa Villaverde avec Madalena Cunha, Betty Faria, Ricardo Vidal. En 2017, une région du Portugal est ravagée par de gigantesques incendies qui emportent des forêts entières… et des vies."
    ],
    "es": [
      "Película Justa dirigida por Teresa Villaverde, protagonizada por Madalena Cunha, Betty Faria, Ricardo Vidal. En 2017, una región de Portugal es asolada por gigantescos incendios que arrasan bosques enteros... y vidas."
    ],
    "nl": [
      "Film Justa geregisseerd door Teresa Villaverde, met in de hoofdrollen Madalena Cunha, Betty Faria, Ricardo Vidal. In 2017 wordt een regio in Portugal geteisterd door gigantische branden die hele bossen en levens wegvagen."
    ]
  },
  "rdfs:label": {
