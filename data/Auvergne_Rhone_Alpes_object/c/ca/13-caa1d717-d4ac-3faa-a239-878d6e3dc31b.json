  "rdfs:comment": {
    "de": [
      "Kauf von Büchern für Erwachsene und Kinder - Ausleihe von Büchern an ca. 100 Abonnenten nach Wahl: Romane, Biografien, Geschichten, Reisen usw. - Empfang von Kindern - Lesung in Seniorenheimen am Mittwochmorgen"
    ],
    "en": [
      "Purchase of books for adults and children - Lending of books to a hundred or so subscribers of their choice: novels, biographies, stories, travels, etc. - Reading in a retirement home on Wednesday mornings"
    ],
    "it": [
      "Acquisto di libri per adulti e bambini - Prestito di libri a un centinaio di abbonati: romanzi, biografie, racconti, viaggi, ecc. - Accoglienza dei bambini? Lettura nelle case di riposo il mercoledì mattina"
    ],
    "fr": [
      "Achat de livres pour adultes et enfants - Prêts de livres à une centaine d’abonnés au choix : romans, biographies, histoires, voyages, etc. - Accueil d’enfants – Lecture en Maison de retraite le mercredi matin"
    ],
    "es": [
      "Compra de libros para adultos y niños - Préstamo de libros a un centenar de suscriptores: novelas, biografías, cuentos, viajes, etc. - Acogida de niños ? Lectura en residencias de ancianos los miércoles por la mañana"
    ],
    "nl": [
      "Aankoop van boeken voor volwassenen en kinderen - Uitlenen van boeken aan een honderdtal abonnees: romans, biografieën, verhalen, reizen, enz. - Lezen in bejaardentehuizen op woensdagochtend"
    ]
  },
