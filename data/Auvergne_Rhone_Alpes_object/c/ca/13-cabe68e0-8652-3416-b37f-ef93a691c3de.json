  "rdfs:comment": {
    "de": [
      "Nach einem Winterspaß auf der Piste oder während eines \"Entdeckungsausflugs\" im Sommer können Sie in der Ferme des Lindarets eine Schlemmerpause einlegen."
    ],
    "en": [
      "Take time out from your winter skiing or summer excursions to enjoy a gourmet break at La Ferme des Lindarets. Our menu includes hearty traditional specialities, all served by a fun, friendly team."
    ],
    "it": [
      "Dopo un momento di sci in inverno o durante una gita \"alla scoperta\" in estate, concedetevi una pausa gastronomica alla Ferme des Lindarets."
    ],
    "fr": [
      "Après un moment de glisse en hiver, ou au cours d'une sortie \"découverte\" en été, faites une pause gourmande à la Ferme des Lindarets."
    ],
    "nl": [
      "Na een dagje wintersporten of tijdens een kennismakingstocht in de zomer, kunt u even stoppen bij Ferme des Lindarets. Op het menu: culinaire specialiteiten uit de streek, in een vriendelijke sfeer."
    ],
    "es": [
      "Después de un momento de esquí en invierno, o durante una excursión de \"descubrimiento\" en verano, haga una pausa gastronómica en la Ferme des Lindarets."
    ]
  },
