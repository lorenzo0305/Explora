  "rdfs:comment": {
    "de": [
      "Die Kirche von Vernols fällt durch ihre robuste Architektur auf. In ihrer Struktur romanisch, wurde sie im 15. Jh. als monumentale, denkmalgeschützte Vorhalle mit sechs Rundbogenwölbungen."
    ],
    "en": [
      "The church at Vernols is striking for its robust architecture. Romanesque in structure, it was restored in the 15th century. Monumental, listed porch with six semicircular arches and ball architecture."
    ],
    "it": [
      "La chiesa di Vernols colpisce per la sua robusta architettura. Di struttura romanica, fu restaurata nel XV secolo. Portico monumentale a sei archi, con architettura sferica."
    ],
    "fr": [
      "L'église de Vernols frappe par son architecture robuste. Roman dans sa structure, elle a été restaurée au XVe siècle. Porche monumental classé avec six voussures plein cintre, avec une architecture à boules."
    ],
    "es": [
      "La iglesia de Vernols llama la atención por su robusta arquitectura. De estructura románica, fue restaurada en el siglo XV. Porche monumental con seis arcos de medio punto, con una arquitectura en forma de bola."
    ],
    "nl": [
      "De kerk van Vernols valt op door zijn robuuste architectuur. De Romaanse structuur werd in de 15e eeuw gerestaureerd. Monumentaal portaal met zes bogen, met een bolvormige architectuur."
    ]
  },
  "rdfs:label": {
    "en": [
      "Saint-Jean Baptiste Church in Vernols"
    ],
    "fr": [
      "Eglise Saint-Jean Baptiste de Vernols"
    ]
  },
