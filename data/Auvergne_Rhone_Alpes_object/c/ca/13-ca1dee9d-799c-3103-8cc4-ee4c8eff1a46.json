  "rdfs:comment": {
    "de": [
      "In der Nähe der Kirche im schönen Dorf St Jeures gibt es Picknicktische, von denen einer bei schlechtem Wetter überdacht ist. Die Toiletten befinden sich unter dem Rathaus."
    ],
    "en": [
      "Towards the church in the beautiful village of St Jeures, picnic tables, one of which is covered in case of bad weather. Toilets under the town hall."
    ],
    "it": [
      "Vicino alla chiesa nel bellissimo villaggio di St Jeures, tavoli da picnic, uno dei quali è coperto in caso di maltempo. I servizi igienici si trovano sotto il municipio."
    ],
    "fr": [
      "Vers l'église dans le beau village de St Jeures, tables de pique-nique dont une couverte en cas de mauvais temps. Les toilettes sont sous la mairie."
    ],
    "es": [
      "Cerca de la iglesia del bonito pueblo de St Jeures, mesas de picnic, una de ellas cubierta en caso de mal tiempo. Los aseos están debajo del ayuntamiento."
    ],
    "nl": [
      "Bij de kerk in het mooie dorpje St Jeures staan picknicktafels, waarvan er een overdekt is in geval van slecht weer. De toiletten bevinden zich onder het gemeentehuis."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Aires de pique-nique de Saint Jeures"
    ]
  },
