  "rdfs:comment": {
    "de": [
      "La Coursive des Alpes im ehemaligen Kino von Méribel im Zentrum des Ortes ist eine Brasserie, die traditionelle französische Küche, Pizzas, Fondues und Burger anbietet, die vollständig hausgemacht sind."
    ],
    "en": [
      "La Coursive des Alpes is situated in amazing spot in the center of Méribel, where was in the past the old cinéma. Everything is homemade here: French typical cooking, pizzas and burgers... and at the barman propose also beautiful cocktails all the day!"
    ],
    "it": [
      "La Coursive des Alpes, situata nell'ex cinema di Méribel nel centro del resort, è una brasserie che serve cucina tradizionale francese, pizze, fondute e hamburger preparati interamente in casa."
    ],
    "fr": [
      "La Coursive des Alpes située dans l'ancien cinéma de Méribel au centre de la station est une brasserie proposant des plats de cuisine française traditionnelle, des pizzas, des fondues et burgers entièrement faits maison."
    ],
    "es": [
      "La Coursive des Alpes, situada en el antiguo cine Méribel, en el centro de la estación, es una brasserie que sirve cocina tradicional francesa, pizzas, fondues y hamburguesas de elaboración propia."
    ],
    "nl": [
      "La Coursive des Alpes is de nieuwe verrassing in het centrum van Méribel, waar vroeger de oude bioscoop stond. Het restaurant is onlangs opgenomen in de MICHELIN-gids en biedt een traditionele Franse keuken in een modern en creatief kader!"
    ]
  },
