  "rdfs:comment": {
    "de": [
      "Etablissement am Boulevard de Courtais, wo man eine gute Zeit bei einem Getränk, einem Crêpe oder einer guten Mahlzeit verbringen kann.\r\nZu jeder Tageszeit: warme oder kalte Tapas. Durchgehender Service."
    ],
    "en": [
      "Establishment located on the Boulevard de Courtais where it is possible to spend a good time around a drink, a pancake or a good meal.\r\nAt any time of the day: hot or cold tapas. Continuous service."
    ],
    "it": [
      "Locale situato sul Boulevard de Courtais dove è possibile divertirsi con un drink, una crêpe o un buon pasto.\r\nA qualsiasi ora del giorno: tapas calde o fredde. Servizio continuo."
    ],
    "fr": [
      "Établissement situé sur le Boulevard de Courtais où il est possible de passer un bon moment autour d'un verre, d'une crêpe ou d'un bon repas.\r\nA toute heure de la journée : tapas chauds ou froids. Service continu."
    ],
    "nl": [
      "Etablissement gelegen aan de Boulevard de Courtais waar het mogelijk is om gezellig iets te drinken, een crêpe of een goede maaltijd te nuttigen.\r\nOp elk moment van de dag: warme of koude tapas. Continue dienst."
    ],
    "es": [
      "Establecimiento situado en el Boulevard de Courtais donde es posible pasar un buen rato tomando una copa, un crêpe o una buena comida.\r\nA cualquier hora del día: tapas frías o calientes. Servicio continuo."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Brasserie Le Glacier"
    ]
  },
