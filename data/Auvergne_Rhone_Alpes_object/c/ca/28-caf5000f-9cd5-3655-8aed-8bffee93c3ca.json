  "rdfs:comment": {
    "de": [
      "Picknickplatz im Parc de Géresme in Crépy-en-Valois\nSpielplatz, Tische, kostenloser Parkplatz\nGeöffnet vom 1. April bis 30. September von 6:00 bis 22:00 Uhr und vom 1. Oktober bis 31. März von 8:00 bis 17:00 Uhr.\nKostenloser Eintritt"
    ],
    "en": [
      "Picnic area located in the park of Géresme in Crépy-en-Valois\nPlayground, tables, free parking\nOpen from April 1st to September 30th from 6am to 10pm and from October 1st to March 31st from 8am to 5pm.\nFree admission"
    ],
    "it": [
      "Area picnic situata nel parco Géresme a Crépy-en-Valois\nParco giochi, tavoli, parcheggio gratuito\nAperto dal 1° aprile al 30 settembre dalle 6.00 alle 22.00 e dal 1° ottobre al 31 marzo dalle 8.00 alle 17.00.\nIngresso libero"
    ],
    "fr": [
      "Aire de pique-nique située dans le parc de Géresme à Crépy-en-Valois\nAire de jeux, tables, parking gratuit\nOuvert du 1er avril au 30 septembre de 6h à 22h et du 1er octobre au 31 mars de 8h à 17h.\nEntrée gratuite"
    ],
    "es": [
      "Área de picnic situada en el parque de Géresme en Crépy-en-Valois\nParque infantil, mesas, aparcamiento gratuito\nAbierto del 1 de abril al 30 de septiembre de 6 a 22 horas y del 1 de octubre al 31 de marzo de 8 a 17 horas.\nEntrada gratuita"
    ],
    "nl": [
      "Picknickplaats gelegen in het Géresme park in Crépy-en-Valois\nSpeeltuin, tafels, gratis parkeren\nOpen van 1 april tot 30 september van 6 tot 22 uur en van 1 oktober tot 31 maart van 8 tot 17 uur.\nGratis toegang"
    ]
  },
