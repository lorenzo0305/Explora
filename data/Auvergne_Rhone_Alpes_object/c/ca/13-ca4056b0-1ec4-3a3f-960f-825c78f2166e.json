  "rdfs:comment": {
    "de": [
      "100% lokales Grafikdesign und Siebdruck: T-Shirts, Taschen, Notizbücher und Tragetaschen, die in der Ardèche von Hand entworfen und gedruckt werden (Farben auf Wasserbasis). Entdecken Sie ihre Ziegenmaskottchen und ihre schelmischen Wortspiele in den Farben der Ardèche."
    ],
    "en": [
      "100% local graphic design and screen printing: t-shirts, bags, notebooks and tote bags designed and printed by hand in the Ardèche (water-based inks). Discover their goat mascots and their mischievous puns in the colours of the Ardèche."
    ],
    "it": [
      "Grafica e serigrafia 100% locale: t-shirt, borse, quaderni e tote bag disegnati e stampati a mano nell'Ardèche (inchiostri a base d'acqua). Scoprite le loro mascotte caprine e i loro giochi di parole maliziosi nei colori dell'Ardèche."
    ],
    "fr": [
      "Graphisme et sérigraphie 100% locale : t-shirts, sacs, carnets et tote bags dessinés et imprimés à la main en Ardèche (encres à l'eau). Découvrez leurs mascottes chèvres et leurs jeux de mots malicieux aux couleurs de l'Ardèche."
    ],
    "es": [
      "Diseño gráfico y serigrafía 100% locales: camisetas, bolsos, cuadernos y tote bags diseñados e impresos a mano en Ardèche (tintas al agua). Descubre sus mascotas caprinas y sus traviesos juegos de palabras con los colores de la Ardèche."
    ],
    "nl": [
      "100% lokaal grafisch ontwerp en zeefdruk: t-shirts, tassen, notitieboekjes en draagtassen ontworpen en met de hand gedrukt in de Ardèche (inkt op waterbasis). Ontdek hun geitenmascottes en hun ondeugende woordspelingen in de kleuren van de Ardèche."
    ]
  },
  "rdfs:label": {
