  "rdfs:comment": {
    "de": [
      "Restaurant mit viel Charme und Charakter, das Ihnen eine Speisekarte mit lokalen Produkten in einem Retro-Chic-Rahmen außerhalb von Clermont-Ferrand anbietet.\r\nAuf der Speisekarte stehen Feinschmeckerteller voller guter, frischer Produkte!"
    ],
    "en": [
      "A restaurant full of charm and character, offering a menu based on local produce in a retro-chic setting just outside Clermont-Ferrand.\r\nOn the menu, gourmet plates full of fresh produce!"
    ],
    "it": [
      "Un ristorante pieno di fascino e carattere, che propone un menu a base di prodotti locali in un ambiente retrò-chic alle porte di Clermont-Ferrand.\r\nNel menu, piatti gourmet ricchi di prodotti freschi!"
    ],
    "fr": [
      "Restaurant plein de charme et de caractère qui vous propose une carte travaillée à base de produits locaux dans un cadre rétro-chic à la sortie de Clermont-Ferrand.\r\nAu menu, des assiettes gourmandes pleines de bons produits frais !"
    ],
    "es": [
      "Un restaurante lleno de encanto y carácter, que ofrece un menú basado en productos locales en un entorno retro-chic a las afueras de Clermont-Ferrand.\r\nEn la carta, ¡platos gourmet repletos de productos frescos!"
    ],
    "nl": [
      "Een restaurant vol charme en karakter, met een menu op basis van lokale producten in een retro-chique omgeving net buiten Clermont-Ferrand.\r\nOp het menu staan gastronomische gerechten met verse producten!"
    ]
  },
