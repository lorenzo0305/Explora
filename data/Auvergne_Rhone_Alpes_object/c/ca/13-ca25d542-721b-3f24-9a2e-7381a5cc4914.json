  "rdfs:comment": {
    "de": [
      "Traditionelles Hotel im Herzen des Dorfes und 2 Schritte vom Jachthafen entfernt, das seit über einem Jahrhundert besteht. Im angeschlossenen Gourmetrestaurant können Sie die Spezialitäten der Bresse (Bresse-Huhn, Frösche, Zander) genießen."
    ],
    "en": [
      "Traditional hotel in the middle of the village, near the marina, existed since more than a century. The gastronomic restaurant of the hotel proposes Bresse chicken, frog legs, pike-perch..."
    ],
    "it": [
      "Hotel tradizionale nel cuore del villaggio e a due passi dal porto turistico, esistente da oltre un secolo, dove potrete gustare le specialità della Bresse (pollo di Bresse, rane, luccioperca) nell'annesso ristorante gastronomico."
    ],
    "fr": [
      "Hôtel traditionnel au coeur du village et à 2 pas du port de plaisance, existant depuis plus d'un siècle, où l'on peut déguster les spécialités de la Bresse (poulet de Bresse, grenouilles, sandre) dans le restaurant gastronomique attenant."
    ],
    "es": [
      "Hotel tradicional en el corazón del pueblo y a dos pasos del puerto deportivo, existente desde hace más de un siglo, donde podrá degustar las especialidades de Bresse (pollo de Bresse, ranas, lucioperca) en el restaurante gastronómico contiguo."
    ],
    "nl": [
      "Een traditioneel hotel in het hart van het dorp, op een steenworp afstand van de jachthaven, die al meer dan een eeuw bestaat, waar u de Bresse-specialiteiten (Bresse-kip, kikkers, snoekbaars) kunt proeven in het aangrenzende gastronomische restaurant."
    ]
  },
