  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/1f7aa76a-e028-3c16-b30b-e9a51d39bdb3",
      "dc:description": {
        "de": [
          "Cycleco richtet vom 11. bis 14. Dezember 2024 von 10 bis 18 Uhr am Place des Capucins ( ehemals Cycles Berquez ) einen vorübergehenden Laden für den Verkauf von gebrauchten Fahrrädern ein."
        ],
        "en": [
          "Cycleco is setting up an ephemeral boutique from December 11 to 14, 2024 from 10am to 6pm at Place des Capucins (formerly known as Cycles Berquez) to sell second-hand bicycles."
        ],
        "it": [
          "Cycleco allestirà un negozio temporaneo dall'11 al 14 dicembre 2024 dalle 10 alle 18 in Place des Capucins (ex Cycles Berquez) per vendere biciclette di seconda mano."
        ],
        "fr": [
          "Cycleco crée une boutique éphémère du 11 au 14 décembre 2024 de 10h à 18h Place des Capucins ( anciennement cycles Berquez ) pour une vente de vélos d'occasion."
        ],
        "nl": [
          "Cycleco richt van 11 tot en met 14 december 2024 van 10.00 tot 18.00 uur een tijdelijke winkel in op Place des Capucins (voorheen bekend als Cycles Berquez) om tweedehands fietsen te verkopen."
        ],
        "es": [
          "Cycleco instalará una tienda temporal del 11 al 14 de diciembre de 2024, de 10.00 a 18.00 horas, en la Place des Capucins (antigua Cycles Berquez) para vender bicicletas de segunda mano."
        ]
      },
