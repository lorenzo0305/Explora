  "rdfs:comment": {
    "de": [
      "Tony Kenny, Gitarrist, Sänger, Mundharmonikaspieler und Komponist, macht uns die Freude, zugunsten von \"Une rose, un espoir\" in den Käfer zu kommen, einer Motorradfahrervereinigung, deren Ziel es ist, Geld für den Kampf gegen Krebs zu sammeln."
    ],
    "en": [
      "Tony Kenny, guitarist, singer, harmonica player and composer, is delighted to be coming to La Coccinelle to raise funds for \"Une rose, un espoir\", a bikers' association dedicated to the fight against cancer."
    ],
    "it": [
      "Tony Kenny, chitarrista, cantante, armonicista e compositore, è lieto di venire a La Coccinelle per aiutare \"Une rose, un espoir\", un'associazione di motociclisti che si dedica alla raccolta di fondi per la lotta contro il cancro."
    ],
    "fr": [
      "Tony Kenny, guitariste, chanteur, harmoniciste et compositeur, nous fait le plaisir de venir à la Coccinelle au profit de \"Une rose, un espoir\", association de motards dont le but est de récolter des fonds au profit de la lutte contre le cancer."
    ],
    "es": [
      "Tony Kenny, guitarrista, cantante, armonicista y compositor, está encantado de venir a La Coccinelle a beneficio de \"Une rose, un espoir\", una asociación de moteros dedicada a recaudar fondos para la lucha contra el cáncer."
    ],
    "nl": [
      "Tony Kenny, gitarist, zanger, harmonicaspeler en componist, is verheugd om naar La Coccinelle te komen voor \"Une rose, un espoir\", een motorrijdersvereniging die geld inzamelt voor de strijd tegen kanker."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Concert de Tony Kenny, au profit d'Une Rose, Un Espoir"
    ]
  },
