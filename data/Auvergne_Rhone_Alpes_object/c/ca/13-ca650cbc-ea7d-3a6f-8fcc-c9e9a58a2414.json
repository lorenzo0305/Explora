  "rdfs:comment": {
    "de": [
      "Selbstständiges Unternehmen für Emaillierung auf Lava.\r\nPuy d'Émaux bietet Kreationen für Tischkultur und dekorative Objekte, die durch farbenfrohe und schlichte Designs erneuert werden. Individuelle Bestellungen und Einführungen möglich."
    ],
    "en": [
      "Self-employed lava enameling company.\r\nPuy d?Émaux offers creations in tableware and decorative objects renewed by colorful and refined designs. Personalized orders and initiations available."
    ],
    "it": [
      "Azienda autonoma di smaltatura della lava.\r\nPuy d'Émaux crea stoviglie e oggetti decorativi con disegni colorati e raffinati. Sono disponibili ordini personalizzati e corsi introduttivi."
    ],
    "fr": [
      "Auto-entreprise d'émaillage sur lave.\r\nPuy d’Émaux propose des créations en arts de la table et des objets décoratifs renouvelés par des dessins colorés et épurés. Commandes personnalisées et initiations possibles."
    ],
    "nl": [
      "Zelfstandig lavameubelbedrijf.\r\nPuy d'Émaux maakt serviesgoed en decoratieve voorwerpen met kleurrijke, verfijnde ontwerpen. Bestellingen op maat en introductiecursussen mogelijk."
    ],
    "es": [
      "Empresa autónoma de esmaltado en lava.\r\nPuy d'Émaux crea vajillas y objetos decorativos con diseños coloristas y refinados. Encargos personalizados y cursos de iniciación."
    ]
  },
