  "rdfs:comment": {
    "de": [
      "Drei leidenschaftliche Freunde haben sich zusammengetan, um ein gemeinsames Projekt zu verwirklichen: das erste autonome Indoor-Padel-Center Frankreichs zu eröffnen!"
    ],
    "en": [
      "Three passionate friends have joined forces to realize a common project: to open France's first stand-alone indoor padel center!"
    ],
    "it": [
      "Tre amici appassionati hanno unito le forze per realizzare un progetto comune: aprire il primo centro di padel indoor indipendente in Francia!"
    ],
    "fr": [
      "Trois amis passionnés ont uni leurs forces pour réaliser un projet commun : ouvrir le premier centre de padel indoor autonome de France !"
    ],
    "es": [
      "Tres amigos apasionados han unido sus fuerzas para llevar a cabo un proyecto común: ¡abrir el primer centro de pádel indoor independiente de Francia!"
    ],
