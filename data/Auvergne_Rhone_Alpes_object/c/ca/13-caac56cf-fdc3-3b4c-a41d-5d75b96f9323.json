  "rdfs:comment": {
    "de": [
      "Ein großes Gebiet mit einer großen Auswahl an Routen für alle Schwierigkeitsgrade. Der Luisset ist ein wunderschöner Balkon mit einer atemberaubenden Aussicht auf das Grésivaudon-Tal, das Belledonne-Massiv und Grenoble."
    ],
    "en": [
      "An extensive site with a wide choice of routes for all levels. Le Luisset is a magnificent balcony offering breathtaking views over the Grésivaudon valley, the Belledonne massif and Grenoble."
    ],
    "it": [
      "Un grande sito con una vasta gamma di itinerari per tutti i livelli. Il Luisset è un magnifico balcone che offre una vista mozzafiato sulla valle del Grésivaudon, sul massiccio di Belledonne e su Grenoble."
    ],
    "fr": [
      "Site d'ampleur présentant un grand choix d'itinéraires de tous niveaux. Le Luisset est un magnifique balcon offrant une vue imprenable sur la vallée du Grésivaudon, le massif de Belledonne et Grenoble."
    ],
    "es": [
      "Un gran sitio con una amplia gama de itinerarios para todos los niveles. El Luisset es un magnífico balcón que ofrece una impresionante vista del valle de Grésivaudon, el macizo de Belledonne y Grenoble."
    ],
    "nl": [
      "Een uitgebreide plek met een ruime keuze aan routes voor alle niveaus. Le Luisset is een prachtig balkon met een adembenemend uitzicht over de Grésivaudon-vallei, het Belledonne-massief en Grenoble."
    ]
  },
  "rdfs:label": {
    "en": [
      "Le Luisset climbing site"
    ],
    "fr": [
      "Site d’escalade du Luisset"
    ],
    "nl": [
      "Luisset klimplek"
    ]
  },
