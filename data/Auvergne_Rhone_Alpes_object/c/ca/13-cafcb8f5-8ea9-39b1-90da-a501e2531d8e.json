  "rdfs:comment": {
    "de": [
      "Die Brasserie du Général befindet sich gegenüber dem Eingang der Standseilbahn am Anfang der Fußgängerzone und empfängt Sie das ganze Jahr über mittags und abends in einer Bistro-Atmosphäre. Sie werden hier eine traditionelle und qualitativ hochwertige Küche entdecken."
    ],
    "en": [
      "Located opposite the funicular entrance, at the start of the pedestrian streets, La Brasserie du Général welcomes you for lunch and dinner all year round, in a bistro atmosphere. You'll discover traditional, high-quality cuisine."
    ],
    "it": [
      "Situata di fronte all'ingresso della funicolare, all'inizio delle strade pedonali, La Brasserie du Général vi accoglie tutto l'anno per pranzo e cena in un'atmosfera da bistrot. Scoprirete una cucina tradizionale e di qualità."
    ],
    "fr": [
      "Située en face de l'entrée du funiculaire, au début des rues piétonnes, La Brasserie du Général vous accueille, midi et soir toute l'année, dans une ambiance bistrot . Vous y découvrirez une cuisine traditionnelle et de qualité."
    ],
    "es": [
      "Situada frente a la entrada del funicular, al principio de las calles peatonales, La Brasserie du Général le recibe para comer y cenar todo el año en un ambiente de bistró. Descubrirá una cocina tradicional y de calidad."
    ],
    "nl": [
      "Gelegen tegenover de ingang van de kabelbaan, aan het begin van de voetgangersstraten, ontvangt La Brasserie du Général u het hele jaar door voor lunch en diner in een bistrosfeer. U zult een traditionele en kwaliteitsvolle keuken ontdekken."
    ]
  },
