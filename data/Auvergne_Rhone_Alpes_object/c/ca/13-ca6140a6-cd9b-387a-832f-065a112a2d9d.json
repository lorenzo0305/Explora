  "rdfs:comment": {
    "de": [
      "Centre équestre l'Étoile befindet sich in Les Quairelles, in der Gemeinde Beaulieu (43). Pferdepension, Coaching, Einzelunterricht, Vorbereitung auf eidgenössische und berufliche Prüfungen."
    ],
    "en": [
      "Center équestre l'Étoile is located in Les Quairelles, in the commune of Beaulieu (43). Horse boarding, coaching, private lessons, preparation for federal and professional exams."
    ],
    "it": [
      "Il Centre équestre l'Étoile si trova a Les Quairelles, nel comune di Beaulieu (43). Pensione per cavalli, coaching, lezioni private, preparazione agli esami federali e professionali."
    ],
    "fr": [
      "Centre équestre l'Étoile est située aux Quairelles, sur la commune de Beaulieu (43). Pension chevaux, coaching, cours particulier, préparation examens fédéraux et professionnels."
    ],
    "es": [
      "El Centre équestre l'Étoile está situado en Les Quairelles, en el municipio de Beaulieu (43). Pupilaje de caballos, entrenamiento, clases particulares, preparación para exámenes federativos y profesionales."
    ],
    "nl": [
      "Centre équestre l'Étoile ligt in Les Quairelles, in de gemeente Beaulieu (43). Paardenpension, coaching, privélessen, voorbereiding op federale en professionele examens."
    ]
