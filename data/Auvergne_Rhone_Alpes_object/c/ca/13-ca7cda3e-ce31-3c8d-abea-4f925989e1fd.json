  "rdfs:comment": {
    "de": [
      "Treffpunkt unter der Kuppel! Im Herzen des Grand Hôtel-Dieu lässt das InterContinental seine 5 Sterne an einem außergewöhnlichen Ort erstrahlen. Das Hotel ist das Juwel der Lyoner Hotellerie und öffnet die Türen dieses historischen und symbolträchtigen Gebäudes weit."
    ],
    "en": [
      "See you under the dome! In the heart of the Grand Hôtel-Dieu, the 5-star InterContinental shines in an exceptional setting. A nugget of Lyon's hotel industry, the hotel is opening wide the doors of this historic building, emblematic of the city."
    ],
    "it": [
      "Ci vediamo sotto la cupola! Nel cuore del Grand Hôtel-Dieu, l'InterContinental fa brillare le sue 5 stelle in una posizione eccezionale. Una perla dell'industria alberghiera lionese, l'hotel apre le porte di questo edificio storico ed emblematico alla città."
    ],
    "fr": [
      "Rendez-vous sous le dôme ! Au cœur du Grand Hôtel-Dieu, l’InterContinental fait briller ses 5 étoiles dans un site d’exception. Pépite de l’hôtellerie lyonnaise, l'hôtel ouvre en grand les portes de ce bâtiment historique et emblématique de la ville."
    ],
    "es": [
      "¡Nos vemos bajo la cúpula! En el corazón del Grand Hôtel-Dieu, el InterContinental hace brillar sus 5 estrellas en una ubicación excepcional. Pepita de la hostelería lionesa, el hotel abre las puertas de este edificio histórico y emblemático a la ciudad."
    ],
    "nl": [
      "Tot ziens onder de koepel! In het hart van het Grand Hôtel-Dieu laat het InterContinental zijn 5 sterren stralen op een uitzonderlijke locatie. Het hotel, een pareltje van het hotelwezen in Lyon, opent de deuren van dit historische en emblematische gebouw voor de stad."
    ]
  },
