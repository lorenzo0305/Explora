  "rdfs:comment": {
    "de": [
      "Breite Auswahl von Romanen, Comics,  Zeitschriften, CD-ROM,  Enzyklopädien...... für Erwachsene und Kinder.\r\nKostenlose Konsultation\r\nAusleihdauer  für Bücher: 3 Wochen."
    ],
    "en": [
      "A wide range of works intended for children and for adults: albums, novels, books, documentaries, comic strips, works about Savoy, journals... Free on-spot consultation. The loan is of a 3 week period."
    ],
    "it": [
      "Biblioteca che offre libri per bambini, romanzi, saggistica, fumetti, libri sulla Savoia, riviste, manga, libri a caratteri grandi, CD e nuove uscite letterarie."
    ],
    "fr": [
      "Bibliothèque proposant des albums enfants, romans, livres documentaires, bandes dessinées, ouvrages sur la Savoie, revues, mangas, livres en gros caractères, cd  et nouveautés littéraires."
    ],
    "nl": [
      "Bibliotheek met kinderalbums, romans, non-fictieboeken, stripverhalen, boeken over Savoie, tijdschriften, manga's, grootletterboeken, cd's en nieuwe literaire uitgaven."
    ],
    "es": [
      "Biblioteca que ofrece álbumes infantiles, novelas, libros de no ficción, cómics, libros sobre Saboya, revistas, mangas, libros de gran formato, CD y novedades literarias."
