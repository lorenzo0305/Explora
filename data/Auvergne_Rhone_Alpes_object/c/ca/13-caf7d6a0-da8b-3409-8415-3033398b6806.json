  "rdfs:comment": {
    "de": [
      "Antarès Wellness Méribel? ist mehr als nur ein Spa: Gönnen Sie sich ein maßgeschneidertes Wellness-Erlebnis, das traditionelle Rituale mit modernster medizinischer Technologie verbindet, um Harmonie, Vitalität und Gelassenheit im Herzen der Alpen zu finden."
    ],
    "en": [
      "Antarès Wellness Méribel — more than a spa: indulge in personalised, results-driven treatments that combine traditional wellness rituals with medical-grade technology to restore balance, energy, and well-being in the heart of the Alps."
    ],
    "it": [
      "Antarès Wellness Méribel ? molto più di una spa: concedetevi un'esperienza di benessere su misura, che combina rituali tradizionali e tecnologie mediche all'avanguardia, per ritrovare armonia, vitalità e serenità nel cuore delle Alpi."
    ],
    "fr": [
      "Antarès Wellness Méribel — bien plus qu’un spa : offrez-vous une expérience de bien-être sur-mesure, alliant rituels traditionnels et technologies médicales de pointe, pour retrouver harmonie, vitalité et sérénité au cœur des Alpes."
    ],
    "nl": [
      "Antarès Wellness Méribel is veel meer dan een spa: trakteer uzelf op een op maat gemaakte wellnesservaring, waarbij traditionele rituelen worden gecombineerd met geavanceerde medische technologieën, om harmonie, vitaliteit en sereniteit te herontdekken in het hart van de Alpen."
    ],
    "es": [
      "Antarès Wellness Méribel ? mucho más que un spa: regálese una experiencia de bienestar a medida, combinando rituales tradicionales y tecnologías médicas de vanguardia, para redescubrir la armonía, la vitalidad y la serenidad en el corazón de los Alpes."
    ]
  },
