  "rdfs:comment": {
    "de": [
      "Gehen Sie diese Route nicht in die andere Richtung, da der Pariettes-Pfad auf der Nordseite rutschig sein kann."
    ],
    "en": [
      "Do not use this in the other direction, the Pariettes trail on the north side can be be slippery."
    ],
    "it": [
      "Non percorrere questo itinerario nell'altra direzione, poiché il sentiero Les Pariettes, esposto a nord, può essere scivoloso."
    ],
    "fr": [
      "N’empruntez pas cet itinéraire dans l’autre sens, le sentier des Pariettes situé versant nord peut-être glissant."
    ],
    "es": [
      "No tome esta ruta en sentido contrario, ya que el camino de Pariettes en el lado norte puede ser resbaladizo."
    ],
    "nl": [
      "Neem deze route niet in de andere richting, want het naar het noorden gerichte Les Pariettes pad kan glad zijn."
    ]
  },
