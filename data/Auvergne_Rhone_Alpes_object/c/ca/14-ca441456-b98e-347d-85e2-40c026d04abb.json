  "rdfs:comment": {
    "de": [
      "Joël Pommerat setzt seine Arbeit, die er in der Haftanstalt von Arles begonnen hat, außerhalb der Mauern fort. Er schrieb eine intime und viszerale Partitur über die Liebesbindungen."
    ],
    "en": [
      "Joël Pommerat continues the work he began at the Maison d?arrêt d?Arles. His intimate, visceral score explores the bonds of love."
    ],
    "it": [
      "Joël Pommerat prosegue il lavoro iniziato fuori dalle mura della prigione della Maison d'arrêt d'Arles. Ha scritto una partitura intima e viscerale sui legami d'amore."
    ],
    "fr": [
      "Joël Pommerat poursuit, hors les murs, un travail entamé à la Maison d’arrêt d’Arles. Il signe une partition intime et viscérale sur les liens amoureux."
    ],
    "nl": [
      "Joël Pommerat zet het werk voort dat hij buiten de gevangenismuren begon in het Maison d'arrêt d'Arles. Hij heeft een intieme, viscerale partituur geschreven over de banden van de liefde."
    ],
    "es": [
      "Joël Pommerat prosigue en la Maison d'arrêt d'Arles el trabajo que inició fuera de los muros de la prisión. Ha escrito una partitura íntima y visceral sobre los lazos del amor."
    ]
  },
