  "rdfs:comment": {
    "de": [
      "Sie wurde im 9. Jahrhundert in der Karolingerzeit unter dem Patronat des Heiligen Stephanus erbaut und war Teil der Metropolitankirche von Lyon."
    ],
    "en": [
      "Built in the 9th century during the Carolingian period under the patronage of Saint Stephen, it was part of the Metropolitan Church of Lyon."
    ],
    "it": [
      "Costruita nel IX secolo in epoca carolingia sotto il patronato di Santo Stefano, faceva parte della Chiesa Metropolitana di Lione."
    ],
    "fr": [
      "Construite au IXe siècle à l’époque carolingienne sous le patronage de Saint Étienne, elle faisait partie de l’Église métropolitaine de Lyon."
    ],
    "nl": [
      "Gebouwd in de 9e eeuw tijdens de Karolingische periode onder de bescherming van Sint Stefanus, maakte het deel uit van de Metropolitaanse Kerk van Lyon."
    ],
    "es": [
      "Construida en el siglo IX, durante el periodo carolingio, bajo la advocación de San Esteban, formaba parte de la Iglesia Metropolitana de Lyon."
    ]
