  "rdfs:comment": {
    "de": [
      "Entdecken Sie unsere Region und unseren sehr schönen Laden mit lokalen Produkten (Biere, Terrinen, Fruchtsäfte, Weine, Safran, Marmeladen, Seifen aus Eselsmilch, Schmuck...). Kaufen Sie auch Ihre Eintrittskarten für Aktivitäten oder Sehenswürdigkeiten."
    ],
    "en": [
      "Discover our territory and our beautiful shop with local products (beers, terrines, fruit juices, wines, saffron, jams, donkey milk soaps, jewellery...). You can also buy tickets for activities or tourist sites."
    ],
    "it": [
      "Scoprite il nostro territorio e il nostro bel negozio di prodotti locali (birre, terrine, succhi di frutta, vini, zafferano, marmellate, saponi al latte d'asina, gioielli...). È inoltre possibile acquistare biglietti per attività o siti turistici."
    ],
    "fr": [
      "Découvrez notre territoire et notre très belle boutique de produits du terroir locaux (bières, terrines, jus de fruits, vins, safran, confitures, savons au lait d'ânesse, bijoux...). Achetez aussi vos places pour des activités ou sites touristiques."
    ],
    "nl": [
      "Ontdek onze streek en onze mooie winkel met streekproducten (bieren, terrines, vruchtensappen, wijnen, saffraan, jam, ezelinnenzeep, sieraden, enz.) Je kunt er ook kaartjes kopen voor activiteiten en toeristische bezienswaardigheden."
    ],
    "es": [
      "Descubra nuestro territorio y nuestra bonita tienda con productos locales (cervezas, terrinas, zumos de frutas, vinos, azafrán, mermeladas, jabones de leche de burra, bisutería...). También puede comprar entradas para actividades o lugares turísticos."
    ]
  },
