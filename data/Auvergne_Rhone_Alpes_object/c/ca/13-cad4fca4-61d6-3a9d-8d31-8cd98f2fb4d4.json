  "rdfs:comment": {
    "de": [
      "Die Ferme des Noës befindet sich im Herzen der Monts de la Madeleine. Die Zucht von Milchziegen und Legehennen ermöglicht es, gute regionale Produkte zu verkosten. Täglich können die Produkte dank der Automaten verkauft werden."
    ],
    "en": [
      "Ferme des Noës is located in the heart of the Monts de la Madeleine. The farm's dairy goats and laying hens provide an opportunity to enjoy delicious local produce. Products on sale every day from vending machines."
    ],
    "it": [
      "La Ferme des Noës si trova nel cuore dei Monts de la Madeleine. Le capre da latte e le galline ovaiole della fattoria offrono l'opportunità di assaggiare deliziosi prodotti locali. Prodotti in vendita tutti i giorni presso i distributori automatici."
    ],
    "fr": [
      "La Ferme des Noës est située au cœur des monts de la Madeleine. L'élevage de chèvres laitières et de poules pondeuses donne à déguster de bons produits du terroir. Produits à la vente tous les jours grâce aux distributeurs automatiques."
    ],
    "es": [
      "La Ferme des Noës está situada en el corazón de los Montes de la Madeleine. Las cabras lecheras y las gallinas ponedoras de la granja permiten degustar deliciosos productos locales. Productos a la venta todos los días en máquinas expendedoras."
    ],
    "nl": [
      "Ferme des Noës ligt in het hart van de Monts de la Madeleine. De melkgeiten en legkippen van de boerderij bieden de mogelijkheid om heerlijke streekproducten te proeven. Er zijn elke dag producten te koop uit automaten."
    ]
  },
