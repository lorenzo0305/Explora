  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/d4844470-d087-3b30-afbf-f7853136d02f",
      "dc:description": {
        "de": [
          "Ein Film von Thierry Donard und eine große Verlosung: Versuchen Sie, ein Surfbrett, Kite-Surf-Material, Ponchos, Textilien & Goodies zu gewinnen!\nUm 20:30 Uhr im Kino Le Cinos (Place du 18 juin)\nPreis 17? -\nInformationen und Reservierungen an der Kinokasse oder auf cinos.fr"
        ],
        "en": [
          "A film by Thierry Donard, and a big draw: try to win a surfboard, kite surfing equipment, ponchos, textiles & goodies!\nAt 8.30pm at Le Cinos cinema (place du 18 juin)\nPrice 17? -\nInformation and reservations at the box office or at cinos.fr"
        ],
        "it": [
          "Un film di Thierry Donard e un grande sorteggio: provate a vincere una tavola da surf, attrezzatura da kitesurf, poncho, abbigliamento e altre cose!\nOre 20.30 al cinema Cinos (place du 18 juin)\nPrezzo 17? -\nInformazioni e prenotazioni al botteghino o su cinos.fr"
        ],
        "fr": [
          "Un film de Thierry Donard, et un grand tirage au sort : tentez de gagner une planche de surf, du matériel de Kite surf, des ponchos, du textile & des goodies ! \nA 20h30 au cinéma Le Cinos (place du 18 juin) \nTarif 17€ -\nInformations et réservations en billetterie ou sur cinos.fr"
        ],
        "es": [
          "Una película de Thierry Donard y un gran sorteo: ¡pruebe y gane una tabla de surf, material de kitesurf, ponchos, ropa y regalos!\n20.30 h en el cine Cinos (place du 18 juin)\nPrecio 17? -\nInformación y reservas en taquilla o en cinos.fr"
        ],
        "nl": [
          "Een film van Thierry Donard en een grote verloting: probeer een surfplank, kitesurfmateriaal, poncho's, kleding en goodies te winnen!\n20.30 uur in de bioscoop van Cinos (place du 18 juin)\nPrijs 17? -\nInformatie en reserveringen bij de kassa of op cinos.fr"
        ]
      },
