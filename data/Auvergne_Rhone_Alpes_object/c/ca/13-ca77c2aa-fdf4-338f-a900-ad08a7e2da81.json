  "rdfs:comment": {
    "de": [
      "Sandstrand am Ende eines Naturschutzgebiets zwischen Le Bourget-du-Lac und Aix les Bains. Der ideale Ort für ein Picknick oder einen Grillabend. Kinderspiele für Groß und Klein, Inlineskate- und Skateboardbahn."
    ],
    "en": [
      "Beach located at the end of a large nature reserve between the Lac du Bourget and Aix-les-Bains"
    ],
    "it": [
      "Spiaggia ubicata in fondo a una grande riserva naturale tra il lago del Bourget e Aix les Bains."
    ],
    "fr": [
      "Plage de sable située à l'extrémité d'une réserve naturelle entre le Bourget-du-Lac et Aix les Bains. L'endroit idéal pour un pique nique ou un barbecue. Jeux d'enfants pour petits et grands, piste de rollers et de skate-board."
    ],
    "es": [
      "Una playa de arena situada al final de una reserva natural entre Le Bourget-du-Lac y Aix les Bains. El lugar ideal para un picnic o una barbacoa. Juegos infantiles para grandes y pequeños, pista de patinaje y skate."
    ],
    "nl": [
      "Een zandstrand gelegen aan het einde van een natuurreservaat tussen Le Bourget-du-Lac en Aix les Bains. De ideale plek voor een picknick of een barbecue. Kinderspelen voor jong en oud, skeeler- en skateboardbaan."
    ]
  },
