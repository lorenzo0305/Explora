  "rdfs:comment": {
    "de": [
      "Das Hôtel Restaurant de la Sorelle ist ein magischer Ort auf einem für alle offenen Golfplatz zwischen Lyon und Bourg en Bresse, ideal für entspannende Momente mit der Familie, Golfurlaube, Wohnseminare oder Geschäftsessen."
    ],
    "ru": [
      "Hôtel Restaurant de la Sorelle - это волшебное место, расположенное на открытом для всех гольф-поле, между Лионом и Бур-ан-Брезом. Оно идеально подходит для отдыха с семьей, перерыва в игре в гольф, проведения семинаров или деловых обедов."
    ],
    "en": [
      "The Hotel Restaurant de la Sorelle is a magical place, located on a golf course open to all, between Lyon and Bourg en Bresse, ideal for family relaxation, golfing breaks, residential seminars or business meals."
    ],
    "it": [
      "L'Hôtel Restaurant de la Sorelle è un luogo magico, situato su un campo da golf aperto a tutti, tra Lione e Bourg en Bresse, ideale per rilassarsi con la famiglia, per pause golfistiche, per seminari residenziali o per pranzi di lavoro."
    ],
    "fr": [
      "L'Hôtel restaurant de la Sorelle est un endroit magique, situé sur un golf ouvert à tous, entre Lyon et Bourg en Bresse, idéal pour les moments de détente en famille, séjours golfiques, séminaires résidentiels ou repas d'affaires."
    ],
    "zh": [
      "索莱尔餐厅酒店（Hôtel Restaurant de la Sorelle）是一个神奇的地方，坐落在里昂和布尔格-恩-布雷斯（Bourg en Bresse）之间一个对所有人开放的高尔夫球场上，是与家人一起放松、打高尔夫球、举办住宅研讨会或商务用餐的理想场所。"
    ],
    "nl": [
      "Hôtel Restaurant de la Sorelle is een magische plek, gelegen aan een golfbaan die voor iedereen toegankelijk is, tussen Lyon en Bourg en Bresse, ideaal voor ontspanning met het gezin, golfverblijven, residentiële seminars of zakendiners."
    ],
    "es": [
      "El Hôtel Restaurant de la Sorelle es un lugar mágico, situado en un campo de golf abierto a todos, entre Lyon y Bourg en Bresse, ideal para relajarse en familia, escapadas para jugar al golf, seminarios residenciales o comidas de negocios."
    ]
  },
