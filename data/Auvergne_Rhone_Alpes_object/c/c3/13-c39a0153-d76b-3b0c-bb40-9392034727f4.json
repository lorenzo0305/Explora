  "rdfs:comment": {
    "de": [
      "Zu jeder Tageszeit können Sie sich auf der beheizten Terrasse dieser bistronomischen Adresse im Herzen des Dorfes entspannen. Café, Brasserie und Cocktailbar zugleich, ob mit der Familie oder mit Freunden, die Weiße Eule wird Sie begeistern."
    ],
    "en": [
      "Come and relax at any time of day on this bistro's heated terrace located in the heart of the village. Both a café, brasserie and a cocktail bar, Le Hibou Blanc is a delightful place to enjoy with family and friends."
    ],
    "it": [
      "In qualsiasi momento della giornata, venite a rilassarvi sulla terrazza soleggiata di questo locale bistronomico nel cuore del villaggio. Caffè, birreria e cocktail bar, in famiglia o tra amici, Le Hibou Blanc vi affascinerà."
    ],
    "fr": [
      "A toute heure de la journée, venez vous détendre sur la terrasse chauffée de cette adresse bistronomique située au cœur du village. A la fois café, brasserie et bar à cocktails, en famille ou entre amis, le Hibou Blanc saura vous séduire."
    ],
    "nl": [
      "Kom op elk moment van de dag ontspannen op het verwarmde terras van dit bistronomische adres in het hart van het dorp. De Hibou Blanc is een café, een brasserie en een cocktailbar, of u nu met familie of vrienden bent."
    ],
    "es": [
      "A cualquier hora del día, venga a relajarse en la terraza climatizada de esta dirección bistronómica situada en el corazón del pueblo. El Hibou Blanc es un café, una brasserie y un bar de cócteles, ya sea en familia o con amigos."
    ]
  },
