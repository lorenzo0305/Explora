  "rdfs:comment": {
    "de": [
      "Tanzabend mit 80'/90'? Moderiert von DJ Alain COUSTON.\r\nKleine Snacks, Getränke, Food Trucks (süß und salzig). 1 Getränk gratis, wenn Sie kostümiert sind. Holen Sie Ihre schönsten Outfits der 80er und 90er Jahre heraus!"
    ],
    "en": [
      "80'/90' Dance Party? Hosted by DJ Alain COUSTON.\r\nSnacks, refreshments, food trucks (savoury and sweet). 1 free drink if you're in costume. So get out your best 80's and 90's outfits!"
    ],
    "it": [
      "Festa da ballo anni '80/'90? Organizzata dal DJ Alain COUSTON.\r\nSnack, rinfreschi, food truck (dolce e salato). 1 drink gratuito se siete in costume. Tirate fuori i vostri migliori abiti anni '80 e '90!"
    ],
    "fr": [
      "Soirée Dansante 80'/90'? Animée par le DJ Alain COUSTON.\r\nPetite restauration, Buvette, Food Trucks (salé et sucré). 1 Boisson est offerte, si vous êtes costumé. Sortez donc vos plus belles tenues dignes des années 80 et 90 !"
    ],
    "es": [
      "Fiesta de baile 80'/90'? Organizada por DJ Alain COUSTON.\r\nSnacks, refrescos, food trucks (dulces y salados). 1 bebida gratis si vas disfrazado. Así que saca tus mejores disfraces de los 80 y 90"
    ],
    "nl": [
      "80'/90' dansfeest? Gehost door DJ Alain COUSTON.\r\nSnacks, drankjes, foodtrucks (zoet en hartig). 1 gratis drankje als je verkleed bent. Dus trek je beste jaren 80 en 90 outfits uit de kast!"
    ]
  },
  "rdfs:label": {
