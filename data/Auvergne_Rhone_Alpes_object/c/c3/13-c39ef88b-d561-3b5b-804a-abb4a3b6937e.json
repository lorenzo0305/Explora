  "rdfs:comment": {
    "de": [
      "Lassen Sie sich vom ältesten und authentischsten Bistro der Stadt verführen: eine erstaunliche und außergewöhnliche Atmosphäre herrscht an diesem Ort. Eine unumgängliche Adresse in Lyon!"
    ],
    "en": [
      "Allow yourself to be carried away by the town's oldest and most authentic bistro: a unique and exceptional atmosphere awaits you. This is an address you won't want to forget in Lyon!"
    ],
    "it": [
      "Lasciati conquistare dal bistrot più antico e autentico della città: un'atmosfera particolare e d'eccezione regna su questi luoghi...  Un locale imprescindibile a Lione!"
    ],
    "fr": [
      "Laissez-vous séduire par le plus vieux et le plus authentique bistrot de la ville : une ambiance singulière et d’exception règne sur les lieux. Une adresse incontournable à Lyon !"
    ],
    "nl": [
      "Laat u verleiden door de oudste en meest authentieke bistro van de stad: hier heerst een unieke en uitzonderlijke sfeer. Een niet te missen adres in Lyon!"
    ],
    "es": [
      "Déjate seducir por el bistró más antiguo y auténtico de la ciudad donde reina un ambiente singular y excepcional. ¡Un rincón imprescindible en Lyon!"
    ]
  },
