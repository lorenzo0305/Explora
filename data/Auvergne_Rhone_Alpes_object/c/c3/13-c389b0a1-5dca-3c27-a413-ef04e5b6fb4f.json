  "rdfs:comment": {
    "de": [
      "Das Festival Les Envolées Baroques besteht vor allem aus öffentlichen Aufführungen der Workshops des Workshops für Alte Musik, der von Oktober bis Mai stattfindet."
    ],
    "en": [
      "The Les Envolées Baroques festival is organized around public performances of early music workshops, which run from October to May."
    ],
    "it": [
      "Il festival Les Envolées Baroques è organizzato intorno alle esibizioni pubbliche dei laboratori del corso di musica antica, che si svolge da ottobre a maggio."
    ],
    "fr": [
      "Le festival Les Envolées Baroques s’organise notamment autour de restitutions publiques des ateliers du stage de musique ancienne qui se déroule du mois d’octobre au mois de mai."
    ],
    "nl": [
      "Het festival Les Envolées Baroques wordt georganiseerd rond openbare optredens van workshops uit de cursus oude muziek, die loopt van oktober tot mei."
    ],
    "es": [
      "El festival Les Envolées Baroques se organiza en torno a las representaciones públicas de los talleres del curso de música antigua, que se imparte de octubre a mayo."
    ]
  },
  "rdfs:label": {
