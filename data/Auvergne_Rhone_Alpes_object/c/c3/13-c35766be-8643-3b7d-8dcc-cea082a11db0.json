  "rdfs:comment": {
    "de": [
      "Eine Schleife mit dem Mont Blanc als Hintergrund, ein Marathontag mit Pässen außerhalb der Kategorien, einfach 330km und 8.300m/d+, das ist das Programm, das die Teilnehmer der 13. Ausgabe der Tour du Mont Blanc am Samstag, den 12. Juli erwartet."
    ],
    "en": [
      "A loop with Mont Blanc as a backdrop, a marathon day with uncategorized passes, simply 330km and 8,300m/d+, this is the program that awaits the participants of the 13th edition of the Tour du Mont Blanc, on Saturday July 12."
    ],
    "it": [
      "Un giro con il Monte Bianco sullo sfondo, una giornata di maratona con passi senza categoria, semplicemente 330 km e 8.300 m/d+, questo il programma che attende i partecipanti alla 13a edizione del Tour du Mont Blanc, sabato 12 luglio."
    ],
    "fr": [
      "Une boucle avec le Mont Blanc comme toile de fond, une journée marathon avec des cols hors catégories, simplement 330km et 8 300m/d+, voilà le programme qui attend les participants de la 13ème édition du Tour du Mont Blanc, le samedi 12 juillet."
    ],
    "es": [
      "Un recorrido en bucle con el Mont Blanc como telón de fondo, una jornada maratoniana con algunos puertos de montaña excepcionales, simplemente 330km y 8.300m/d+: ese es el programa que espera a los participantes en la 13ª edición del Tour du Mont Blanc el sábado 12 de julio."
    ],
    "nl": [
      "Eine Schleife mit dem Mont Blanc im Hintergrund, ein Marathontag mit nicht kategorisierten Pässen, einfach 330 km und 8.300 m/d+, das ist das Programm, das die Teilnehmer der 13. Ausgabe der Tour du Mont Blanc am Samstag, den 12. Juli, erwartet."
    ]
  },
