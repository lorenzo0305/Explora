  "rdfs:comment": {
    "de": [
      "Sie betreten ein geschütztes Naturgebiet, in dem viele empfindliche Arten leben.\r\nBleiben Sie unauffällig, hören Sie zu und halten Sie die Augen offen! Entdecken Sie zwei kleine Spaziergänge: den Eulenpfad und den Köhlerpfad."
    ],
    "en": [
      "You are entering a protected natural area where many sensitive species live.\r\nBe discreet, listen and keep your eyes open! Discover two short walks: the Owl Trail and the Coal Trail."
    ],
    "it": [
      "State entrando in un'area naturale protetta dove vivono molte specie sensibili.\r\nMantenete un profilo basso, ascoltate attentamente e tenete gli occhi aperti! Scoprite due brevi passeggiate: il Sentiero dei gufi e il Sentiero del carbone."
    ],
    "fr": [
      "Vous rentrez dans un espace naturel protégé où vivent de nombreuses espèces sensibles.\r\nRestez discrets, écoutez et ouvrez l’oeil ! Découvrez deux petites balades le sentier des Chouettes et le sentier des charbonnier."
    ],
    "nl": [
      "Je betreedt een beschermd natuurgebied waar veel gevoelige soorten leven.\r\nHoud je gedeisd, luister goed en let goed op! Ontdek twee korte wandelingen: het Uilenpad en het Kolenpad."
    ],
    "es": [
      "Estás entrando en una zona natural protegida donde viven muchas especies sensibles.\r\nPase desapercibido, escuche con atención y esté atento Descubra dos paseos cortos: el Sendero de la Lechuza y el Sendero del Carbón."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Sentiers des Chouettes et des Charbonniers"
    ]
  },
