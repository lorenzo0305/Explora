  "rdfs:comment": {
    "de": [
      "Qualitativ hochwertiges Fastfood für leckere Burger!\r\nLokale Produkte, die mit Sorgfalt gekocht werden... und Musik!\r\nLe Pick'Nic kommt auch zu Ihren Veranstaltungen, zögern Sie nicht, mich zu kontaktieren!"
    ],
    "en": [
      "Quality fast food for delicious burgers!\r\nLocal produce cooked with care... and music!\r\nLe Pick'Nic also caters to your events, so don't hesitate to contact us!"
    ],
    "it": [
      "Ristorazione rapida di qualità per dei burgers deliziosi !\r\nProdotti locali cucinati con cura ...e musica !\r\nIl Pick'Nic si muvoe anche sui vostri eventi, non esitate a conttatarmi !"
    ],
    "fr": [
      "Restauration rapide de qualité, pour des burgers délicieux !\r\nProduit locaux cuisinés avec soin... et musique !\r\nLe Pick'Nic se déplace aussi sur vos évènements, n'hésitez pas à me contacter !"
    ],
    "nl": [
      "Kwaliteits fastfood, voor heerlijke hamburgers!\r\nLokale producten met zorg bereid... en muziek!\r\nThe Pick'Nic komt ook naar uw evenementen, aarzel niet om mij te contacteren!"
    ],
    "es": [
      "Comida rápida de calidad, ¡para unas hamburguesas deliciosas!\r\nProductos locales cocinados con esmero... ¡y música!\r\nThe Pick'Nic también se desplaza a tus eventos, ¡no dudes en ponerte en contacto conmigo!"
    ]
  },
