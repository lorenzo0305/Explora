  "rdfs:comment": {
    "de": [
      "Colin, Elliot und Dorian haben eine Schwäche für gegorene Getränke. Die Brasserie des Gens Sérieux ist eine Hommage an die pedantische Unverschämtheit der drei Kumpels. Entdecken Sie vor Ort die groben Schaumweine der Gens Sérieux, vom Fass oder aus der Flasche."
    ],
    "en": [
      "Colino, Ellioti and Dodhino are crazy about fermented drinks. Les Gens Sérieux Brewing Co. is a tribute to the craziness of the three friends. Come and share draft or bottle beers at the brewpub. Cheers!"
    ],
    "it": [
      "Colin, Elliot e Dorian hanno un debole per le bevande fermentate. La Brasserie des Gens Sérieux è un omaggio alla smodata pignoleria dei tre compagni. Venite a scoprire le grandi birre di Les Gens Sérieux, alla spina o in bottiglia."
    ],
    "fr": [
      "Colin, Elliot et Dorian ont un faible pour la boisson fermentée. La Brasserie des Gens Sérieux est un hommage à l'outrecuidance tatillonne des trois compères. Venez découvrir sur place, en pression ou en bouteille, les grosses mousses des Gens Sérieux."
    ],
    "es": [
      "Colin, Elliot y Dorian tienen debilidad por las bebidas fermentadas. La Brasserie des Gens Sérieux es un homenaje a la desmesura de estos tres amigos. Venga a descubrir las grandes cervezas de Les Gens Sérieux, de barril o en botella."
    ],
    "nl": [
      "Colin, Elliot en Dorian hebben een zwak voor gegiste dranken. La Brasserie des Gens Sérieux is een eerbetoon aan de buitensporigheid van de drie vrienden. Kom en ontdek het grote sop van Les Gens Sérieux, van het vat of op fles."
    ]
  },
