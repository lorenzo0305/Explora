  "rdfs:comment": {
    "de": [
      "Erlernen Sie das Filzen von Wolle mit der Filzmacherin Mylène Chaput und gestalten Sie in einem halbtägigen Workshop Ihr eigenes Pflanzennest aus gefilzter Wolle."
    ],
    "en": [
      "Initiate yourself to wool felting with Mylène Chaput, felting artist, and create your own felted wool plant nest during a half-day discovery workshop."
    ],
    "it": [
      "Imparate a infeltrire la lana con Mylène Chaput, feltraia, e create il vostro nido di piante in lana infeltrita durante un laboratorio di scoperta di mezza giornata."
    ],
    "fr": [
      "Initiez-vous au feutrage de la laine avec Mylène Chaput, feutrière et créez votre nid pour plante en laine feutrée lors d’un atelier découverte d’une demi-journée."
    ],
    "nl": [
      "Leer wol vilten met Mylène Chaput, viltmaakster, en maak je eigen gevilte wollen plantennest tijdens een ontdekkingsworkshop van een halve dag."
    ],
    "es": [
      "Aprenda a fieltrar la lana con Mylène Chaput, artesana del fieltro, y cree su propio nido de plantas de lana fieltrada durante un taller de descubrimiento de media jornada."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Atelier feutrage : Nid pour plantes"
    ]
  },
