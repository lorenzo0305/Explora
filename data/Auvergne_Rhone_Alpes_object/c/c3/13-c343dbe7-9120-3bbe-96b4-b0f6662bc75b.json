  "rdfs:comment": {
    "de": [
      "BôM Cosmétique steht für handwerklich hergestellte, biologische, SIMPLES-zertifizierte Kosmetik aus lokalen Pflanzen, die Ihre Haut besonders schont."
    ],
    "en": [
      "BôM Cosmétique is a handcrafted, organic, SIMPLES-certified cosmetics line, made from local plants for the utmost respect of your skin."
    ],
    "it": [
      "BôM Cosmétique è un cosmetico artigianale, biologico e certificato SIMPLES, realizzato con piante locali coltivate in azienda, per il massimo rispetto della vostra pelle."
    ],
    "fr": [
      "BôM Cosmétique, c'est une cosmétique artisanale, bio, certifiée SIMPLES, issue de plantes locales cultivées à la ferme, pour un grand respect de votre peau."
    ],
