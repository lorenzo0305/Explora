  "rdfs:comment": {
    "de": [
      "Die Reitställe von Le Rosey liegen mitten im Grünen, wo Groß und Klein die Freude am Reiten in qualitativ hochwertigen Kursen erleben können."
    ],
    "en": [
      "The stables of the Rosey are located in full greenery, where young and old can taste the joy of horseback riding by following quality courses."
    ],
    "it": [
      "Il maneggio Rosey si trova in mezzo al verde, dove grandi e piccini possono provare la gioia dell'equitazione seguendo lezioni di qualità."
    ],
    "fr": [
      "Les écuries du Rosey sont situées en pleine verdure, où petits et grands peuvent goûter à la joie de l’équitation en suivant des cours de qualité."
    ],
    "es": [
      "Los establos Rosey están situados en medio de la vegetación, donde jóvenes y mayores pueden disfrutar del placer de montar a caballo siguiendo lecciones de calidad."
    ],
    "nl": [
      "De manege Rosey ligt midden in het groen, waar jong en oud kunnen genieten van het plezier van paardrijden door het volgen van kwaliteitslessen."
    ]
  },
  "rdfs:label": {
