  "rdfs:comment": {
    "de": [
      "Willkommen in MALP zu einer fesselnden Zeitreise in die Jungsteinzeit und ins Jahr 1000. Treffen Sie durch die außergewöhnlichen Überreste, die unter dem Wasser des Sees entdeckt wurden, die Männer, die vor so langer Zeit dort lebten."
    ],
    "en": [
      "Welcome to MALP for a captivating time travel to the Neolithic and the year 1000. Through the exceptional remains discovered under the waters of the lake, meet the men who lived there so long ago."
    ],
    "it": [
      "Benvenuti al MALP per un affascinante viaggio nel tempo fino al Neolitico e all'anno 1000. Attraverso gli eccezionali resti scoperti sotto le acque del lago, incontrerete le persone che vivevano lì tanto tempo fa."
    ],
    "fr": [
      "Bienvenue au MALP pour un voyage temporel captivant vers le Néolithique et l’an Mil. A travers les vestiges exceptionnels découverts sous les eaux du lac, partez à la rencontre des hommes qui vécurent là il y a si longtemps."
    ],
    "nl": [
      "Welkom in het MALP voor een boeiende reis terug in de tijd naar het neolithicum en het jaar 1000. Aan de hand van de uitzonderlijke overblijfselen die onder het water van het meer zijn ontdekt, maak je kennis met de mensen die hier zo lang geleden leefden."
    ],
    "es": [
      "Bienvenido al MALP para un cautivador viaje en el tiempo hasta el Neolítico y el año 1000. A través de los excepcionales restos descubiertos bajo las aguas del lago, conozca a las gentes que vivieron allí hace tanto tiempo."
    ]
  },
  "rdfs:label": {
    "de": [
      "Archäologisches Museum am Lac de Paladru"
    ],
    "en": [
      "Lake Paladru Archeological Museum"
    ],
    "fr": [
      "Musée archéologique du lac de Paladru - MALP"
    ]
  },
