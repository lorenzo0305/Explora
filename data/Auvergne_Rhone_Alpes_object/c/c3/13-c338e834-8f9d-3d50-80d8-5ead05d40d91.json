  "rdfs:comment": {
    "de": [
      "Le PAL, ein einzigartiger Park in der Auvergne Rhône-Alpes.\r\nEntdecken Sie 31 Attraktionen ? 1000 Tiere ? 3 pädagogische Tierdarstellungen ? 2 Unterkunftsangebote und 1500 Pflanzenarten!"
    ],
    "en": [
      "Le PAL is the only park in France that combines park attractions with animals and unusual accommodation. Le PAL offers 31 attractions, 1000 animals and 3 animals shows and educational presentations on a 50 ha natural site."
    ],
    "it": [
      "Le PAL, un parco unico in Alvernia Rodano-Alpi.\r\nScoprite 31 attrazioni ? 1000 animali ? 3 spettacoli educativi sugli animali ? 2 offerte di alloggio e 1500 specie di piante!"
    ],
    "fr": [
      "Le PAL, un parc unique en son genre, en Auvergne Rhône-Alpes. \r\nDécouvrez 31 attractions – 1000 animaux – 3 représentations animalières pédagogiques – 2 offres d’hébergements et 1500 essences végétales !"
    ],
    "es": [
      "Le PAL, un parque único en Auvernia Ródano-Alpes.\r\nDescubra 31 atracciones ? 1000 animales ? 3 espectáculos educativos con animales ? 2 ofertas de alojamiento y ¡1.500 especies de plantas!"
    ],
    "nl": [
      "Le PAL, een uniek park in Auvergne Rhône-Alpes.\r\nOntdek 31 attracties ? 1000 dieren ? 3 educatieve dierenshows ? 2 verblijfsmogelijkheden en 1500 plantensoorten!"
    ]
  },
  "rdfs:label": {
    "en": [
