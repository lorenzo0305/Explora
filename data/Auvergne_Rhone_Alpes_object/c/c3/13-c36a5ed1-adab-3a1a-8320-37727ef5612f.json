  "rdfs:comment": {
    "de": [
      "Diese Route, die für eine erste Erfahrung mit Skitouren vorgesehen ist, führt Sie entlang des Skigebiets in Richtung Les Aplanes. Nach einem Aufstieg von 257 m haben Sie einen herrlichen Blick auf die Aiguilles d'Arves und den Glacier de l'Étendard."
    ],
    "en": [
      "This itinerary, designed for first-time ski tourers, takes you along the ski area towards Les Aplanes. After a 257m ascent, you'll have a breathtaking view of the Aiguilles d'Arves and the Glacier de l'Étendard."
    ],
    "it": [
      "Questo itinerario, pensato per chi si avvicina per la prima volta allo sci alpinismo, vi porta lungo il comprensorio sciistico in direzione di Les Aplanes. Dopo un'ascesa di 257 metri, avrete una vista mozzafiato sulle Aiguilles d'Arves e sul Ghiacciaio dell'Étendard."
    ],
    "fr": [
      "Cet itinéraire, prévu pour une première expérience en ski de randonnée, vous permettra de longer le domaine skiable en direction des Aplanes. Après une ascension de 257m, vous aurez une vue imprenable sur les Aiguilles d’Arves et le Glacier de l’Étendard."
    ],
    "es": [
      "Este itinerario, diseñado para esquiadores noveles, le llevará por el dominio esquiable en dirección a Les Aplanes. Tras un ascenso de 257 m, disfrutará de una vista impresionante de las Aiguilles d'Arves y el Glacier de l'Étendard."
    ],
    "nl": [
      "Deze route, ontworpen voor beginnende skitoeristen, neemt je mee langs het skigebied richting Les Aplanes. Na een klim van 257 m heb je een adembenemend uitzicht op de Aiguilles d'Arves en de Glacier de l'Étendard."
    ]
  },
  "rdfs:label": {
    "en": [
      "Ascent to Aplanes"
    ],
    "fr": [
      "Montée aux Aplanes"
    ]
  },
