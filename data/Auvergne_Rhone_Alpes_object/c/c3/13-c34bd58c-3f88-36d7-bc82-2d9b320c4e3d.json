  "rdfs:comment": {
    "de": [
      "Die Autorin Sarah Séguigne schreibt prickelnde Romane, die dich inspirieren und ermutigen sollen, deinen Träumen zu folgen, auch wenn sie abseits der üblichen Pfade liegen."
    ],
    "en": [
      "Author Sarah Séguigne writes sparkling novels to inspire and encourage you to follow your dreams, even those off the beaten track."
    ],
    "it": [
      "L'autrice Sarah Séguigne scrive romanzi frizzanti per ispirarvi e incoraggiarvi a seguire i vostri sogni, anche quelli che sono fuori dai sentieri battuti."
    ],
    "fr": [
      "Sarah Séguigne, autrice, écrit des romans pétillants, pour vous inspirer et vous encourager à suivre vos rêves, même ceux qui sortent des sentiers battus."
    ],
    "nl": [
      "Schrijfster Sarah Séguigne schrijft sprankelende romans om je te inspireren en aan te moedigen je dromen te volgen, zelfs als die buiten de gebaande paden liggen."
    ],
    "es": [
      "La autora Sarah Séguigne escribe novelas chispeantes para inspirarle y animarle a seguir sus sueños, incluso los que están fuera de los caminos trillados."
    ]
  },
