  "rdfs:comment": {
    "de": [
      "Kulinarisches Bistro mit einer grosszügigen Küche aus frischen Produkten. Schöne Weinkarte und grosse Auswahl an \"Glaswein\". Menü ab 25 €"
    ],
    "en": [
      "Gourmet bistro offering gourmet and generous cuisine made from fresh produce. Nice wine list and large choice of \"wine by the glass\". Menu from 25 €"
    ],
    "it": [
      "Bistrot gastronomico che serve una generosa cucina gourmet a base di prodotti freschi. Eccellente carta dei vini e ampia scelta di vini al bicchiere. Menu a partire dal 29?"
    ],
    "fr": [
      "Bistro gastronomique proposant une cuisine gourmande et généreuse élaborée à partir de produits frais. Belle carte des vins et grand choix de \"vin au verre\". Menu à partir de 29 €"
    ],
    "nl": [
      "Gastronomische bistro serveert royale gastronomische gerechten bereid met verse producten. Uitstekende wijnkaart en ruime keuze aan wijnen per glas. Menu vanaf 29?"
    ],
    "es": [
      "Bistró gastronómico que sirve una generosa cocina gourmet elaborada con productos frescos. Excelente carta de vinos y amplia selección de vinos por copas. Menú a partir de 29?"
    ]
  },
