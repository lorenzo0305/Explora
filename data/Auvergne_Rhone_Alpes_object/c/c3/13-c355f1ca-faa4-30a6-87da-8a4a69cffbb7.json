  "rdfs:comment": {
    "de": [
      "Traditionelle regionale Küche mit Käsewagen und hausgemachtem Gebäck.\r\nVon Februar bis Juli können Sie den \"Fin gras du Mézenc\" probieren.\r\n\r\nHotel für Geschäftsleute geöffnet, mit Zimmerservice.\r\nAkzeptiert die Schecks T'CAP des Dorfes Tence"
    ],
    "en": [
      "Traditional local cuisine with cheese carts and home-made pastries.\r\nFrom February to July, come and taste the \"Fin gras du Mézenc\".\r\n\r\nHotel open to professionals, with room service.\r\nAccepts T'CAP vouchers from the village of Tence"
    ],
    "it": [
      "Cucina tradizionale locale con carrelli di formaggi e dolci fatti in casa.\r\nDa febbraio a luglio, venite a gustare il \"Fin gras du Mézenc\".\r\n\r\nHotel aperto ai professionisti, con servizio in camera.\r\nAccetta i buoni T'CAP del villaggio di Tence"
    ],
    "fr": [
      "Cuisine traditionnelle du terroir avec chariots de fromages et pâtisseries maison.\r\nDe février à juillet, venez déguster le \"Fin gras du Mézenc\".\r\n\r\nHôtel ouvert aux professionnels, avec room service.\r\nAccepte les chèques T'CAP du village de Tence"
    ],
    "nl": [
      "Traditionele lokale keuken met kaaswagens en huisgemaakt gebak.\r\nKom van februari tot juli de \"Fin gras du Mézenc\" proeven.\r\n\r\nHotel open voor professionals, met roomservice.\r\nAccepteert T'CAP vouchers van het dorp Tence"
    ],
    "es": [
      "Cocina tradicional local con carritos de quesos y repostería casera.\r\nDe febrero a julio, venga a degustar el \"Fin gras du Mézenc\".\r\n\r\nHotel abierto a profesionales, con servicio de habitaciones.\r\nAcepta vales T'CAP del pueblo de Tence"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Hotel-Restaurant de la Poste"
    ]
  },
