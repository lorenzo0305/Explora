  "rdfs:comment": {
    "de": [
      "Magna Tempus Machina\r\nDas Museum hat die Zeitmaschine angeworfen, damit Sie auf unkonventionelle Weise das Leben im antiken Viertel kennen lernen und in die Begegnung mit den Bewohnern von Vienna eintauchen können."
    ],
    "en": [
      "Magna Tempus Machina\r\nThe museum has started up a time machine to give you an offbeat look at life in the ancient quarter, and a chance to immerse yourself in the life of Vienna's inhabitants."
    ],
    "it": [
      "Magna Tempus Machina\r\nIl museo ha messo in moto la macchina del tempo, permettendo di scoprire la vita dell'antico quartiere in modo diverso e di immergersi nell'incontro con la gente di Vienna."
    ],
    "fr": [
      "Magna Tempus Machina\r\nLe musée a démarré la machine à remonter le temps pour vous permettre de découvrir de manière décalée la vie du quartier antique et de partir en immersion à la rencontre des habitants de Vienna."
    ],
    "nl": [
      "Magna Tempus Machina\r\nHet museum heeft de tijdmachine in beweging gezet, zodat je het leven in de oude wijk op een andere manier kunt ontdekken en je kunt onderdompelen in een ontmoeting met de mensen van Wenen."
    ],
    "es": [
      "Magna Tempus Machina\r\nEl museo ha puesto en marcha la máquina del tiempo, permitiéndole descubrir la vida del barrio antiguo de una forma diferente y sumergirse en el encuentro con la gente de Viena."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Nuit Européenne des Musées"
    ]
  },
