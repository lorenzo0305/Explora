  "rdfs:comment": {
    "de": [
      "Fremdenverkehrsamt und Departementsantenne des Regionalen Naturparks Volcans d'Auvergne. Im Herzen des Massif Cantalien ist das Büro in Murat der Sitz von Hautes Terres Tourisme. Informationsbüros sind über das gesamte Gebiet verteilt."
    ],
    "en": [
      "Tourist Office and departmental branch of the Parc Naturel Régional des Volcans d'Auvergne. In the heart of the Cantalien Massif, the Murat office is the headquarters of Hautes Terres Tourisme. Information offices are spread all over the territory."
    ],
    "it": [
      "Ufficio del turismo e sede dipartimentale del Parc Naturel Régional des Volcans d'Auvergne. Nel cuore del Massiccio del Cantalien, l'ufficio di Murat è la sede di Hautes Terres Tourisme. Gli uffici di informazione sono sparsi in tutta la regione."
    ],
    "fr": [
      "Office de Tourisme et antenne départementale du Parc Naturel Régional des Volcans d'Auvergne. Au cœur du Massif Cantalien, le bureau de Murat est le siège de Hautes Terres Tourisme. Des bureaux d'informations sont répartis sur l'ensemble du territoire."
    ],
    "nl": [
      "Toeristische dienst en departementale afdeling van het Parc Naturel Régional des Volcans d'Auvergne. In het hart van het massief van de Cantalien is het kantoor van Murat het hoofdkantoor van Hautes Terres Tourisme. Informatiebureaus zijn verspreid over de hele regio."
    ],
    "es": [
      "Oficina de Turismo y delegación departamental del Parque Natural Regional de los Volcanes de Auvernia. En el corazón del Macizo Cantábrico, la oficina de Murat es la sede de Hautes Terres Tourisme. Las oficinas de información están repartidas por toda la región."
    ]
  },
  "rdfs:label": {
