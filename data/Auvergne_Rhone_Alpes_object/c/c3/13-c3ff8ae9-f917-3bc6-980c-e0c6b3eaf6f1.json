  "rdfs:comment": {
    "de": [
      "Centre Présence - Wellness-Pool\r\nMehrere Praktiker im Dienste Ihres Wohlbefindens.\r\nSophrologie, Hypnose, Meditation, Zirkel.\r\nManuelle Praktiken nach der Poyet-Methode, Somatopathie.\r\nNaturopathie.\r\nMassage für das Wohlbefinden.\r\nFeldenkrais-Praxis."
    ],
    "en": [
      "Center Présence - Wellness centre\r\nSeveral practitioners at the service of your well-being.\r\nSophrology, hypnosis, meditation, circles.\r\nManual practice (Poyet method), somatopathy.\r\nNaturopathy.\r\nWellness massage.\r\nFeldenkrais practice."
    ],
    "it": [
      "Centre Présence - Centro di benessere\r\nDiversi operatori al vostro servizio per il vostro benessere.\r\nSofrologia, ipnosi, meditazione, cerchi.\r\nPratica manuale secondo il metodo Poyet, somatopatia.\r\nNaturopatia.\r\nMassaggio del benessere.\r\nPratica Feldenkrais."
    ],
    "fr": [
      "Centre Présence - Pôle bien-être\r\nPlusieurs praticiens au service de votre bien-être.\r\nSophrologie, hypnose, méditation, cercles.\r\nPratique manuelle méthode Poyet, somatopathie.\r\nNaturopathie.\r\nMassage bien-être.\r\nPratique Feldenkrais."
    ],
    "nl": [
      "Centre Présence - Centrum voor welzijn\r\nVerschillende beoefenaars tot uw dienst voor uw welzijn.\r\nSofrologie, hypnose, meditatie, cirkels.\r\nManuele praktijk volgens de methode Poyet, somatopathie.\r\nNatuurgeneeskunde.\r\nMassage voor welzijn.\r\nFeldenkrais praktijk."
    ],
    "es": [
      "Centre Présence - Centro de bienestar\r\nVarios profesionales a su servicio para su bienestar.\r\nSofrología, hipnosis, meditación, círculos.\r\nPráctica manual según el método Poyet, somatopatía.\r\nNaturopatía.\r\nMasaje de bienestar.\r\nPráctica Feldenkrais."
    ]
  },
