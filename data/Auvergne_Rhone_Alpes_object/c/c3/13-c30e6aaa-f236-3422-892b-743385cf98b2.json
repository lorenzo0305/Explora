  "rdfs:comment": {
    "de": [
      "Yoga-Technik Eva Ruchpaul und Qi-Gong. Eine sanfte Antwort auf bestimmte Übel unserer Zivilisation: nervöse Erschöpfung, Überanstrengung, Verlangsamung der inneren Funktionen. Es erweist sich als wertvolle Waffe gegen das Altern."
    ],
    "en": [
      "Yoga Eva Ruchpaul Technical and Qi-Gong. A gentle response to certain ailments in our civilization: nervous fatigue, overwork, slowing down of internal functions. It turns out to be a valuable weapon against aging."
    ],
    "it": [
      "Tecnica yoga Eva Ruchpaul e Qi-Gong. Una risposta gentile ad alcuni mali della nostra civiltà: stanchezza nervosa, superlavoro, rallentamento delle funzioni interne. Si rivela un'arma preziosa contro l'invecchiamento."
    ],
    "fr": [
      "Yoga technique Eva Ruchpaul et Qi-Gong. Une réponse douce à certains maux de notre civilisation : fatigue nerveuse, surmenage, ralentissement des fonctions internes. Il se révèle être une arme précieuse contre le vieillissement."
    ],
    "es": [
      "Técnica de yoga Eva Ruchpaul y Qi-Gong. Una respuesta suave a algunos de los males de nuestra civilización: fatiga nerviosa, exceso de trabajo, ralentización de las funciones internas. Resulta ser un arma preciosa contra el envejecimiento."
    ],
    "nl": [
      "Eva Ruchpaul en Qi-Gong technische yoga. Een zachte reactie op bepaalde kwalen in onze beschaving: nerveuze vermoeidheid, overwerk, vertraging van interne functies. Het blijkt een waardevol wapen tegen veroudering."
    ]
  },
  "rdfs:label": {
    "en": [
      "Andrée Anselmet - Yoga & Qi-Gong"
    ],
    "fr": [
