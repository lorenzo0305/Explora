  "rdfs:comment": {
    "de": [
      "Die Auberge Arthéa in Laviolle bietet eine reizvolle Umgebung mit Blick auf die Berge und Zugang zum Fluss. Hausgemachte Küche, saisonal und mit lokalen Produkten."
    ],
    "en": [
      "Located in Laviolle, Auberge Arthéa offers a charming setting with mountain views and river access. Homemade, seasonal cuisine is made with local produce. Theme nights and takeout meals are available."
    ],
    "it": [
      "Situato a Laviolle, l'Auberge Arthéa offre un ambiente incantevole con vista sulle montagne e accesso al fiume. Cucina casalinga e stagionale con prodotti locali."
    ],
    "fr": [
      "Situé à Laviolle, l'Auberge Arthéa offre un cadre charmant avec vue sur la montagne et accès à la rivière. Cuisine maison, respectueuse des saisons, à base de produits locaux."
    ],
    "es": [
      "Situado en Laviolle, el Auberge Arthéa ofrece un entorno encantador con vistas a la montaña y acceso al río. Cocina casera de temporada elaborada con productos locales."
    ],
    "nl": [
      "Auberge Arthéa ligt in Laviolle en biedt een charmante omgeving met uitzicht op de bergen en toegang tot de rivier. Huisgemaakte keuken, met respect voor de seizoenen, op basis van lokale producten. Er worden thema-avonden en afhaalmaaltijden aangeboden."
    ]
  },
