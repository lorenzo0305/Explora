  "rdfs:comment": {
    "de": [
      "Auf 2100 Metern Höhe, an der Mittelstation von Saulire, öffnet La Folie Douce Méribel-Courchevel im Winter täglich von 9:00 bis 16:45 Uhr ihre Türen für Sie."
    ],
    "en": [
      "Located at 2100 meters high , at the Saulire's intermediate station, La Folie Douce welcomes you every day from 9 am to 5 pm during the winter. Show and lunch. Take away Butcher shop : 11:30pm - 3pm."
    ],
    "it": [
      "Arroccata a 2100 metri di altitudine, alla stazione intermedia di Saulire, La Folie Douce Méribel-Courchevel vi apre le sue porte tutti i giorni dalle 9:00 alle 16:45 in inverno."
    ],
    "fr": [
      "Perchée à 2100 mètres d'altitude, à la gare intermédiaire de Saulire, La Folie Douce Méribel-Courchevel vous ouvre ses portes tous les jours de 9h à 16h45 en hiver."
    ],
    "nl": [
      "Gelegen op 2100 meter hoogte, bij het tussenstation Saulire, verwelkomt La Folie Douce u elke dag van 9 tot 17 uur in de winter. Restaurant en voorstelling. Afhaalmaaltijden slagerij: 11.30 - 15.00 uur."
    ],
    "es": [
      "Encaramado a 2.100 metros de altitud, en la estación intermedia de Saulire, La Folie Douce Méribel-Courchevel le abre sus puertas todos los días de 9.00 a 16.45 en invierno."
    ]
  },
