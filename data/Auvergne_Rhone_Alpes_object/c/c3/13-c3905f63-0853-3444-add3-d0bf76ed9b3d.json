  "rdfs:comment": {
    "de": [
      "Valchevrière, ein Ort der Stille und Besinnlichkeit, ist einer der ergreifendsten Orte, an dem die Erinnerung an die Zeit des Widerstands im Vercors noch allgegenwärtig ist."
    ],
    "en": [
      "Valchevrière, a place of silence and contemplation, is one of the most moving and evocative sites of the Resistance in the Vercors."
    ],
    "it": [
      "Valchevrière, luogo di silenzio e di memoria, è uno dei luoghi più toccanti e suggestivi della Resistenza nel Vercors."
    ],
    "fr": [
      "Valchevrière, lieu de silence et de recueillement, est un des sites les plus émouvants et les plus évocateurs de la Résistance en Vercors."
    ],
    "es": [
      "Valchevrière, lugar de silencio y recuerdo, es uno de los lugares más conmovedores y evocadores de la Resistencia en el Vercors."
    ],
    "nl": [
      "Valchevrière, een plaats van stilte en herinnering, is een van de meest ontroerende en suggestieve plaatsen van het verzet in de Vercors."
    ]
  },
