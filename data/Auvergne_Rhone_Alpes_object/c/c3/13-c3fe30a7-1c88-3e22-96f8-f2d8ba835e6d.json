  "rdfs:comment": {
    "de": [
      "Unser Keller befindet sich in der Nähe des Schlosses und bietet Ihnen eine große Auswahl an Bieren, Naturweinen, Softdrinks und anderen Getränken, die perfekt zu Ihrem Mittagessen oder Ihrer abendlichen Knabberei passen."
    ],
    "en": [
      "Located close to the château, our cellar offers a wide selection of beers, natural wines, softs and other drinks to accompany your lunch or evening snack."
    ],
    "it": [
      "Situata nei pressi dello château, la nostra cantina offre un'ampia selezione di birre, vini naturali, softs e altre bevande per accompagnare gli spuntini serali."
    ],
    "fr": [
      "Située près du château, notre cave vous propose un large choix de bières, de vins naturels, de softs et  autres boissons qui accompagneront votre grignote du soir."
    ],
    "es": [
      "Situada cerca del castillo, nuestra bodega ofrece una amplia selección de cervezas, vinos naturales, softs y otras bebidas para acompañar sus aperitivos nocturnos."
    ],
    "nl": [
      "Onze kelder ligt vlakbij het kasteel en biedt een ruime keuze aan bieren, natuurlijke en biodynamische wijnen, ciders, whisky's, rum en sterke dranken om mee te nemen.\r\nTer plaatse: bieren van het vat, 150 flessen en andere dranken (zie de kaart)."
    ]
  },
