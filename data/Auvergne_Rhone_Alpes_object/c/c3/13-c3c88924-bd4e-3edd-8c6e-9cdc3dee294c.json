  "rdfs:comment": {
    "de": [
      "Wir bieten Ihnen einen Customization-Workshop an: Die Eisendosen unserer Großmütter oder Schuhkartons werden zu echten Deko-Objekten. Vergessen Sie nicht, sich anzumelden, da die Plätze begrenzt sind."
    ],
    "en": [
      "We're offering a customization workshop: our grandmothers' tins and shoeboxes will become real decorative objects. Don't forget to sign up, places are limited."
    ],
    "it": [
      "Proponiamo un laboratorio di personalizzazione: le lattine e le scatole di scarpe delle nostre nonne diventeranno veri e propri oggetti decorativi. Non dimenticate di iscrivervi, i posti sono limitati."
    ],
    "fr": [
      "Nous vous proposons un atelier customisation : boîtes en fer de nos grands-mères ou boîtes à chaussures vont devenir de véritables objets déco. N'oubliez pas de vous inscrire, places limitées."
    ],
    "nl": [
      "We bieden een workshop maatwerk aan: de blikken en schoenendozen van onze grootmoeders worden echte decoratieve objecten. Vergeet niet in te schrijven, de plaatsen zijn beperkt."
    ],
    "es": [
      "Te proponemos un taller de personalización: las latas y cajas de zapatos de nuestras abuelas se convertirán en auténticos objetos de decoración. No olvides apuntarte, las plazas son limitadas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Atelier customisation Boîte à bijoux ou à secrets"
    ]
  },
