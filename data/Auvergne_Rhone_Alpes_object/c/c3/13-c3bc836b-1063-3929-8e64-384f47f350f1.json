  "rdfs:comment": {
    "de": [
      "Rivière Kwai bietet Ihnen die Möglichkeit, im Herzen von Lyon traditionelle thailändische Küche zu genießen und dabei neue Geschmacksrichtungen zu entdecken."
    ],
    "en": [
      "Rivière Kwai provides an opportunity to sample traditional Thai cuisine in the very heart of Lyon and discover some exciting new flavours."
    ],
    "it": [
      "Rivière Kwai vi offre l'opportunità di gustare la cucina tradizionale tailandese nel cuore di Lione, scoprendo nuovi sapori."
    ],
    "fr": [
      "Rivière Kwai vous propose de déguster, au cœur de Lyon, une cuisine traditionnelle thaïlandaise, à la découverte de nouvelles saveurs."
    ],
    "es": [
      "Rivière Kwai le ofrece la oportunidad de degustar la cocina tradicional tailandesa en el corazón de Lyon, mientras descubre nuevos sabores."
    ],
    "nl": [
      "Rivière Kwai biedt u de mogelijkheid om in het hart van Lyon de traditionele Thaise keuken te proeven en nieuwe smaken te ontdekken."
    ]
  },
