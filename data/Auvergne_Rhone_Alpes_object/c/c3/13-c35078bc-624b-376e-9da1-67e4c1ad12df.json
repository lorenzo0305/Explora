  "rdfs:comment": {
    "de": [
      "Produzent von Biogemüse der Saison, Geflügel und Eiern. Sie finden uns jeden Samstagmorgen auf den Märkten von Noirétable und Montbrison. Direktverkauf im Garten dienstags und freitags von 9 Uhr bis 11:30 Uhr"
    ],
    "en": [
      "\"Producer of seasonal organic vegetables, poultry and eggs. Find us at the markets of Noirétable and Montbrison every Saturday morning. \r\nProduce sold direct from the market gardens on Tuesdays and Fridays from 9am to 11.30am.\""
    ],
    "it": [
      "Produttore di verdure di stagione, uova e funghi biologici. Venite a trovarci al mercato di Montbrison ogni sabato mattina.\r\nVendita diretta dall'orto il martedì e il venerdì dalle 9.00 alle 11.30."
    ],
    "fr": [
      "Producteur de légumes bio de saison, d'oeufs et de champignons. Retrouvez-nous sur le marché de Montbrison tous les samedis matin. \r\nVente directe au jardin les mardis et vendredis de 9h à 11h30."
    ],
    "es": [
      "Productor de verduras, huevos y setas ecológicas de temporada. Visítenos en el mercado de Montbrison todos los sábados por la mañana.\r\nVenta directa desde el huerto los martes y viernes de 9.00 a 11.30 h."
    ],
    "nl": [
      "Producent van biologische seizoensgroenten, eieren en paddenstoelen. Bezoek ons elke zaterdagochtend op de markt in Montbrison.\r\nDirecte verkoop vanuit de tuin op dinsdag en vrijdag van 9.00 tot 11.30 uur."
    ]
  },
