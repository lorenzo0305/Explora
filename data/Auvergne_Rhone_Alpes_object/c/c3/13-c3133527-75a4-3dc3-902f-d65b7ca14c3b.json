  "rdfs:comment": {
    "de": [
      "Erleben Sie in einer idyllischen Umgebung ein immersives Wellness-Erlebnis! 1,5 Stunden Entspannung mit Whirlpool und Sauna, mit einem atemberaubenden Blick auf die Berge."
    ],
    "en": [
      "Come and enjoy an immersive wellness experience in an idyllic setting at the La Norma leisure park! 1h30 of relaxation in a whirlpool bath and sauna, with a breathtaking view of the mountains."
    ],
    "it": [
      "Venite a vivere un'esperienza di benessere coinvolgente in un ambiente idilliaco! 1h30 di relax in vasca idromassaggio e sauna, con una vista mozzafiato sulle montagne."
    ],
    "fr": [
      "Dans un cadre idyllique, venez vivre une expérience bien-être immersive ! 1h30 de détente avec bain bouillonnant et sauna, avec une vue imprenable sur les montagnes."
    ],
    "es": [
      "Venga y disfrute de una experiencia de bienestar envolvente en un entorno idílico 1h30 de relajación en bañera de hidromasaje y sauna, con una vista impresionante de las montañas."
    ],
    "nl": [
      "Kom in een idyllische omgeving in het vrijetijdscentrum La Norma genieten van een meeslepende wellnesservaring! 1u30 ontspanning in een bubbelbad en sauna, met een adembenemend uitzicht op de bergen."
    ]
  },
