  "rdfs:comment": {
    "de": [
      "Entdecken Sie zwischen Provence und Vulkanmassiv die Juwelen der romanischen und antiken Kunst (Abteikirche von Cruas, Schloss von Rochemaure, antike Stätte von Alba la Romaine) für einen Tag oder eine geführte Besichtigung, die in unseren 15 Gemeinden angeboten werden (Ab 10 Personen)."
    ],
    "en": [
      "Between Provence and volcanic massif, come and discover masterpieces of Romanesque and Roman art (Sainte Marie’s abbey church of Cruas, Rochemaure castle, Ancient Alba-la-Romaine site) for one day or a guided tour offered on our 15 villages (a minimum of 10 people is required)."
    ],
    "it": [
      "Tra la Provenza e il massiccio vulcanico, scoprite i gioielli dell'arte romanica e antica (l'Abbazia di Cruas, il Castello di Rochemaure, l'antico sito di Alba la Romaine) per una giornata o una visita guidata offerta nei nostri 15 comuni (a partire da 10 persone)."
    ],
    "fr": [
      "Entre Provence et massif volcanique, découvrez les joyaux de l'art roman et antique (abbatiale de Cruas, Château de Rochemaure, site antique d'Alba la Romaine) pour une journée ou une visite guidée proposées sur nos 15 communes (A partir de 10 personnes)."
    ],
    "nl": [
      "Tussen de Provence en het vulkanisch massief, ontdek de juwelen van de Romaanse en oude kunst (de abdij van Cruas, het kasteel van Rochemaure, de oude site van Alba la Romaine) voor een dag of een rondleiding aangeboden in onze 15 gemeenten (vanaf 10 personen)."
    ],
    "es": [
      "Entre la Provenza y el macizo volcánico, descubra las joyas del arte románico y antiguo (la abadía de Cruas, el castillo de Rochemaure, el antiguo yacimiento de Alba la Romaine) en una jornada o en una visita guiada ofrecida en nuestros 15 municipios (a partir de 10 personas)."
    ]
  },
  "rdfs:label": {
