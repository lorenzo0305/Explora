  "rdfs:comment": {
    "de": [
      "Dieser hübsche Fluss mit kristallklarem Wasser ist besonders für das Angeln auf Sicht geeignet und erfordert ein hohes Maß an Diskretion, um Forellen und Äschen zu fangen."
    ],
    "en": [
      "Specially adapted for sight fishing, this pretty river with crystalline waters will require great discretion to fish trout and grayling."
    ],
    "it": [
      "Particolarmente adatto alla pesca a vista, questo bel fiume dalle acque cristalline richiede grande discrezione per catturare trote e temoli."
    ],
    "fr": [
      "Spécialement adaptée pour la pêche à vue, cette jolie rivière aux eaux cristallines demandera une grande discrétion pour pêcher truites et ombres."
    ],
    "es": [
      "Especialmente adaptado para la pesca a vista, este bonito río de aguas cristalinas requerirá gran discreción para capturar truchas y tímalos."
    ],
    "nl": [
      "Deze mooie rivier met kristalhelder water is speciaal geschikt voor zichtvissen en vereist grote discretie om forel en vlagzalm te vangen."
    ]
  },
  "rdfs:label": {
