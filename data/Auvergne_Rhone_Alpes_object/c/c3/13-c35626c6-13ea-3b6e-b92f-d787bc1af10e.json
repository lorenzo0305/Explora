  "rdfs:comment": {
    "de": [
      "Fahrradtouren zur Erkundung der Gegend mit diplomierten Betreuern. Fahrradkurse für die Schulferien der Kinder entsprechend ihrem Alter."
    ],
    "en": [
      "Bike rides to discover the region with qualified instructors. Cycling courses during the school holidays for children of all ages."
    ],
    "it": [
      "Escursioni in bicicletta alla scoperta della regione con istruttori qualificati. Corsi di ciclismo durante le vacanze scolastiche per bambini di diverse età."
    ],
    "fr": [
      "Balade à vélo à la découverte du territoire avec des moniteurs diplômés. Stage vélo pour les vacances scolaires des enfants en fonction de leurs âges."
    ],
    "es": [
      "Paseos en bicicleta para descubrir la región con monitores cualificados. Cursos de ciclismo durante las vacaciones escolares para niños de diferentes edades."
    ],
    "nl": [
      "Fietstochten om de regio te ontdekken met gekwalificeerde instructeurs. Fietscursussen tijdens de schoolvakanties voor kinderen van verschillende leeftijden."
