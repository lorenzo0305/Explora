  "rdfs:comment": {
    "de": [
      "Willkommen im Café des Loisirs in La Chapelle-en-Vercors! Ein geselliger Ort, an dem sich Café, Buchhandlung, lokales Kunsthandwerk und Spiele vermischen. Probieren Sie biologische und lokale Produkte, tauchen Sie in ein Buch ein oder teilen Sie ein Spiel mit der Familie. Eine Pause voller Überraschungen!"
    ],
    "en": [
      "Welcome to the Café des Loisirs in La Chapelle-en-Vercors! A friendly place where coffee, books, local crafts and games come together. Enjoy organic and local produce, immerse yourself in a book or share a game with the family. A break full of surprises!"
    ],
    "it": [
      "Benvenuti al Café des Loisirs di La Chapelle-en-Vercors! Un luogo accogliente dove troverete caffè, libreria, artigianato locale e giochi. Assaggiate prodotti biologici e locali, immergetevi in un libro o condividete un gioco con la famiglia. Una pausa piena di sorprese!"
    ],
    "fr": [
      "Bienvenue au Café des Loisirs à La Chapelle-en-Vercors ! Un lieu convivial où se mêlent café, librairie, artisanat local et jeux. Dégustez des produits bio et locaux, plongez dans un livre ou partagez une partie en famille. Une pause pleine de surprises !"
    ],
    "nl": [
      "Welkom bij Café des Loisirs in La Chapelle-en-Vercors! Een gezellige plek waar je een café, boekwinkel, lokale ambachten en spelletjes vindt. Proef biologische en lokale producten, duik in een boek of deel een spel met het gezin. Een pauze vol verrassingen!"
    ],
    "es": [
      "Bienvenido al Café des Loisirs de La Chapelle-en-Vercors Un lugar acogedor donde encontrará un café, una librería, artesanía local y juegos. Deguste productos ecológicos y locales, sumérjase en un libro o comparta un juego con la familia. ¡Una escapada llena de sorpresas!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Café des Loisirs"
    ]
  },
