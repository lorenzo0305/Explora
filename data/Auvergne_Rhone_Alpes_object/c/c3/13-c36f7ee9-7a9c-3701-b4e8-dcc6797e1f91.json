  "rdfs:comment": {
    "de": [
      "Vereinsbar\r\nKonzerte, Tee, Austern, Rugby, Boulespiel, Tischfußball, Tauschhandel, Karaoke, Quiz, literarischer Treffpunkt: Es gibt viele Angebote, um alle Geschmäcker zu befriedigen und alle Horizonte und alle Altersgruppen zufrieden zu stellen!"
    ],
    "en": [
      "Bar associatif\r\nConcerts, tea, oysters, rugby, pétanque, table soccer, bartering practices, karaoke, quizzes, literary barbecues: there's something for everyone, of all ages and from all walks of life!"
    ],
    "it": [
      "Bar associato\r\nConcerti, tè, ostriche, rugby, bocce, calcio balilla, pratiche di baratto, karaoke, quiz, barbecue letterari: tante proposte per soddisfare tutti i gusti, tutti gli orizzonti e tutte le età!"
    ],
    "fr": [
      "Bar associatif\r\nConcerts, thé, huîtres, rugby, pétanque, baby foot, troc des pratiques, karaoké, quizz, troquet littéraire : autant de propositions pour sustenter tous les goûts tenter de satisfaire toutes les envies de tous les horizons et tous les âges !"
    ],
    "nl": [
      "Gemeenschapsbar\r\nConcerten, thee, oesters, rugby, jeu de boules, tafelvoetbal, ruilhandel, karaoke, quizzen, literaire barbecues: er is voor elk wat wils, voor elke achtergrond en voor alle leeftijden!"
    ],
    "es": [
      "Bar asociado\r\nConciertos, té, ostras, rugby, petanca, futbolín, prácticas de trueque, karaoke, concursos, barbacoas literarias: ¡tantas propuestas para satisfacer todos los gustos, todos los horizontes y todas las edades!"
    ]
  },
  "rdfs:label": {
