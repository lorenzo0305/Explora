  "rdfs:comment": {
    "de": [
      "Mit einer traditionellen, saisonalen und hausgemachten Küche empfängt Sie Le virage 16 im Winter jeden Mittag von Montag bis Freitag und abends von Freitag bis Sonntag.\r\n\r\nAm Donnerstagabend ist das Restaurant nur mit Reservierung geöffnet."
    ],
    "en": [
      "With traditional, seasonal, home-cooked cuisine, Le virage 16 welcomes you in winter every lunchtime from Monday to Friday and every evening from Friday to Sunday.\r\n\r\nOn Thursday evenings, the restaurant is open by reservation only."
    ],
    "it": [
      "Le Virage 16 serve una cucina casalinga tradizionale di stagione ogni giorno a pranzo dal lunedì al venerdì e ogni sera dal venerdì alla domenica.\r\n\r\nIl giovedì sera il ristorante è aperto solo su prenotazione."
    ],
    "fr": [
      "Avec une cuisine traditionnelle de saison et maison, Le virage 16 vous accueille en hiver tous les midis du lundi au vendredi et les soirs du vendredi au dimanche.\r\n\r\nLe jeudi soir le restaurant est ouvert uniquement sur réservation."
    ],
    "es": [
      "Le Virage 16 sirve cocina casera tradicional de temporada todos los mediodías de lunes a viernes y todas las noches de viernes a domingo.\r\n\r\nLos jueves por la noche, el restaurante solo abre con reserva previa."
    ],
    "nl": [
      "Le Virage 16 serveert traditionele seizoensgebonden huisgemaakte gerechten elke lunch van maandag tot vrijdag en elke avond van vrijdag tot zondag.\r\n\r\nOp donderdagavond is het restaurant alleen op reservering geopend."
    ]
  },
