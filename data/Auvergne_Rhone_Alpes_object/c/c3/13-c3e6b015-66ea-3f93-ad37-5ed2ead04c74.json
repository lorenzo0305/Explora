  "rdfs:comment": {
    "de": [
      "Das 2A Dance Festival freut sich, Sie bei seiner zweiten Ausgabe von MOVES ON THE TOP wiederzusehen, die vom 2. bis 8. August 2025 an einem außergewöhnlichen Ort in Les 2 Alpes, 1,5 Stunden von Grenoble entfernt, stattfinden wird."
    ],
    "en": [
      "The 2A Dance Festival is delighted to welcome you to its 2nd edition of MOVES ON THE TOP, which will take place from 2 to 8 August 2025 on an exceptional site in Les 2 Alpes, 1h30 from Grenoble."
    ],
    "it": [
      "Il 2A Dance Festival è lieto di darvi il benvenuto alla seconda edizione di MOVES ON THE TOP, che si svolgerà dal 2 al 8 agosto 2025 in un sito eccezionale a Les 2 Alpes, a 1h30 da Grenoble."
    ],
    "fr": [
      "Les 2A Dance Festival sont heureux de vous retrouver pour leur 2ème édition de MOVES ON THE TOP, qui va se dérouler du 2 au 8 août 2025 sur un site exceptionnel aux 2 Alpes, à 1h30 de Grenoble."
    ],
    "nl": [
      "Het 2A Dance Festival heet u van harte welkom op de 2e editie van MOVES ON THE TOP, die plaatsvindt van 2 tot 8 augustus 2025 op een uitzonderlijke locatie in Les 2 Alpes, op 1u30 van Grenoble."
    ],
    "es": [
      "El 2A Dance Festival se complace en darle la bienvenida a su 2ª edición de MOVES ON THE TOP, que se celebrará del 2 al 8 de agosto de 2025 en un lugar excepcional de Les 2 Alpes, a 1h30 de Grenoble."
    ]
  },
