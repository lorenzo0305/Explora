  "rdfs:comment": {
    "de": [
      "Das Wassersportzentrum besteht innen aus: 1 25m-Becken, 1 Spielbecken mit atypischer Form, 1 Planschbecken, 1 Wellnessbereich; außen von Juni bis August geöffnet: 1 Spielbecken-Planschbecken, 1 Rutsche/Pentagliss, 1 Splash-pad..."
    ],
    "en": [
      "The aqualudic center comprises indoors: 1 x 25m pool, 1 x unusually shaped leisure pool, 1 x paddling pool, 1 x wellness area; outdoors, open from June to August: 1 x leisure pool-paddling pool, 1 x slide/pentagliss, 1 x Splash-pad..."
    ],
    "it": [
      "Il centro acquatico interno comprende: 1 piscina da 25 m, 1 piscina per il tempo libero di forma particolare, 1 piscina per bambini, 1 area benessere; all'esterno, aperto da giugno ad agosto: 1 piscina per il tempo libero/piscina per bambini, 1 scivolo/pentagliss, 1 Splash-pad..."
    ],
    "fr": [
      "Le centre aqualudique est composé à l'intérieur : 1 bassin de 25m, 1 bassin ludique de forme atypique, 1 pataugeoire, 1 espace bien-être ; à l'extérieur ouverture de juin à août : 1 bassin ludique-pataugeoire, 1 toboggan/pentagliss, 1 Splash-pad..."
    ],
    "nl": [
      "Het overdekte aqualudicentrum bestaat uit: 1 x 25m bad, 1 x ongewoon gevormd recreatiebad, 1 x kikkerbad, 1 x wellnessruimte; buiten, geopend van juni tot augustus: 1 x recreatiebad-kikkerbad, 1 x glijbaan/pentagliss, 1 x Splash-pad..."
    ],
    "es": [
      "El centro acuático cubierto consta de: 1 piscina de 25 m, 1 piscina lúdica de formas inusuales, 1 piscina infantil, 1 zona de bienestar; en el exterior, abierto de junio a agosto: 1 piscina lúdica-piscina infantil, 1 tobogán-pentagliss, 1 Splash-pad..."
    ]
  },
