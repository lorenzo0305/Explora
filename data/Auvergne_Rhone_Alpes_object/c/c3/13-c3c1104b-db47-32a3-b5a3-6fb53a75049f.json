  "rdfs:comment": {
    "de": [
      "Entdecken Sie Nordic Walking, betreut von einem diplomierten Nordic Walking-Instruktor, in einer Gruppensitzung. Eine Progression während der gesamten Saison in Form eines Zyklus. Die Übungsorte variieren, eine Gelegenheit, die umliegenden Landschaften zu entdecken!"
    ],
    "en": [
      "Discover Nordic walking, supervised by a qualified Nordic walking instructor, in a group session. Progress throughout the season in cycles. Practice locations vary, giving you the chance to discover the surrounding countryside!"
    ],
    "it": [
      "Scoprite il nordic walking, sotto la supervisione di un istruttore qualificato, in una sessione di gruppo. Progredire durante la stagione in cicli. Le sedi variano, dandovi la possibilità di esplorare la campagna circostante!"
    ],
    "fr": [
      "Découvrir la marche nordique, encadrée par un instructeur en marche nordique diplômé, en séance collective. Une progression tout au long de la saison sous forme de cycle. Les lieux de pratiques varie, l'occasion de découvrir les paysages  alentours !"
    ],
    "nl": [
      "Ontdek nordic walking onder begeleiding van een gekwalificeerde nordic walking-instructeur in een groepssessie. Ga het hele seizoen door in cycli. De locaties variëren, zodat je de kans krijgt om het omliggende platteland te verkennen!"
    ],
    "es": [
      "Descubra la marcha nórdica, bajo la supervisión de un monitor de marcha nórdica cualificado, en una sesión de grupo. Progrese a lo largo de la temporada en ciclos. Los lugares varían, lo que le permite explorar los alrededores"
    ]
  },
  "rdfs:label": {
    "en": [
      "Association Marche Nordic'Evasion"
    ],
    "fr": [
      "Association Marche Nordic'Evasion"
    ]
  },
