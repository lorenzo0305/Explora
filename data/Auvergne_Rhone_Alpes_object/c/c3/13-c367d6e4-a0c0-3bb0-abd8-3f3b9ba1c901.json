  "rdfs:comment": {
    "de": [
      "Die Robert Devaux-Halle, eine ehemalige Kirche im Zentrum des Dorfes, ist heute ein Ausstellungsraum, in dem jedes Jahr eine reichhaltige Kultursaison stattfindet."
    ],
    "en": [
      "Formerly a church located in the centre of the village, the Robert Devaux hall is now an exhibition hall which hosts a rich cultural season every year."
    ],
    "it": [
      "La Sala Robert Devaux, un tempo chiesa nel centro del villaggio, è oggi una sala espositiva che ospita ogni anno una ricca stagione culturale."
    ],
    "fr": [
      "Ancienne église située au centre du village, la salle Robert Devaux est aujourd’hui une salle d’exposition qui accueille chaque année une riche saison culturelle."
    ],
    "es": [
      "La sala Robert Devaux, antigua iglesia situada en el centro del pueblo, es ahora una sala de exposiciones que acoge cada año una rica temporada cultural."
    ],
    "nl": [
      "De Robert Devaux Hall, vroeger een kerk in het centrum van het dorp, is nu een tentoonstellingsruimte waar elk jaar een rijk cultureel seizoen plaatsvindt."
    ]
  },
