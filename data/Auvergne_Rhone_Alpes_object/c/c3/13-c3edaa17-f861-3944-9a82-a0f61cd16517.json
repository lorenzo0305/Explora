  "rdfs:comment": {
    "de": [
      "Erleben Sie eine magische Erfahrung, die für alle geeignet ist: Das Iglu-Dorf!\r\nDie Eisgrotte empfängt Fußgänger und Skifahrer mit unglaublichen vereisten Skulpturen!\r\nDas Thema ist \"Alice im Wunderland\""
    ],
    "en": [
      "A magical experience for everyone: The Igloo Village!\nThe Grotte de Glace welcomes pedestrians and skiers with incredible frosted sculptures!\nThe theme is \"Alice in Wonderland\"."
    ],
    "it": [
      "Un'esperienza magica per tutti: Il Villaggio Igloo!\r\nLa Grotta di ghiaccio accoglie pedoni e sciatori con incredibili sculture ghiacciate!\r\nIl tema è \"Alice nel paese delle meraviglie\""
    ],
    "fr": [
      "Vivez une expérience magique, adaptée à tous : Le Village Igloo !\r\nLa Grotte de Glace accueille piétons et skieurs avec d'incroyables sculptures givrées !\r\nLa thématique est \"Alice aux pays des merveilles\""
    ],
    "es": [
      "Una experiencia mágica para todos: ¡La Aldea de los Iglús!\r\nLa Gruta de Hielo da la bienvenida a peatones y esquiadores con increíbles esculturas heladas\r\nEl tema es \"Alicia en el País de las Maravillas\""
    ],
    "nl": [
      "Een magische ervaring voor iedereen: The Igloo Village!\nDe Ice Grotto verwelkomt voetgangers en skiërs met ongelooflijke berijpte sculpturen!\nHet thema is \"Alice in Wonderland\"."
    ]
  },
  "rdfs:label": {
    "en": [
      "Visit the Igloo"
    ],
    "fr": [
      "Visite de l'Igloo"
    ]
  },
