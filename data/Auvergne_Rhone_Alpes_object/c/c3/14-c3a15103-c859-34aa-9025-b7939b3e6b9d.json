      "dc:description": {
        "de": [
          "Der Verein le Baladin de Torcy organisiert seine Kirmes am Sonntag, den 17. August\nTreffpunkt ist der Garten des Repère de Torcy von 15 bis 19 Uhr"
        ],
        "en": [
          "The Baladin de Torcy association organizes its fair on Sunday August 17\nMeet in the garden of the Repère de Torcy from 3pm to 7pm"
        ],
        "it": [
          "L'associazione Baladin de Torcy organizza la sua fiera domenica 17 agosto\nAppuntamento nel giardino del Repère de Torcy dalle 15.00 alle 19.00"
        ],
        "fr": [
          "L'association le Baladin de Torcy organise sa kermesse le dimanche 17 août\nRendez-vous dans le jardin du Repère de Torcy de 15h à 19h"
        ],
        "es": [
          "La asociación Baladin de Torcy celebra su feria el domingo 17 de agosto\nCita en el jardín de la Repère de Torcy de 15:00 a 19:00"
        ],
        "nl": [
          "De vereniging Baladin de Torcy houdt haar beurs op zondag 17 augustus\nAfspraak in de tuin van de Repère de Torcy van 15u tot 19u"
        ]
      },
