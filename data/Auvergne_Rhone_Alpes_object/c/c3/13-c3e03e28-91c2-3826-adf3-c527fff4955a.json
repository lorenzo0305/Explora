  "rdfs:comment": {
    "de": [
      "Ein Ort zum Entspannen in einer grünen Umgebung. Gerichte in puristischer \r\nEinfachheit gearbeitet. Ein Bistro, in das man immer wieder zurückkehrt, um die Ruhe des Ortes zu genießen."
    ],
    "en": [
      "The place is relaxing, in a green setting. The quality food is prepared in \r\nall simplicity - you will come back to this bistro for the tranquillity of the place."
    ],
    "it": [
      "Situato nel cuore del Domaine du Colombier, il Bistrot 270 offre una cucina stagionale a base di prodotti locali. Questo ristorante bistronomico \"Bib Gourmand\" accoglie gli ospiti per pranzo e cena in un ambiente contemporaneo"
    ],
    "fr": [
      "Situé au cœur du Domaine du Colombier, le Bistrot 270 propose une cuisine de saison mettant en valeur les produits du terroir. Ce restaurant bistronomique reconnu « Bib Gourmand » accueille ses hôtes pour des déjeuners et dîners dans un cadre contemporain"
    ],
    "es": [
      "Situado en el corazón del Domaine du Colombier, el Bistrot 270 ofrece cocina de temporada basada en productos locales. Este restaurante bistronómico \"Bib Gourmand\" recibe a sus clientes para almorzar y cenar en un ambiente contemporáneo"
    ],
    "nl": [
      "Een plek om te ontspannen in een groene natuurlijke omgeving. Eenvoudige \r\ngerechten, een bistro waar u terugkomt voor de rust van deze plaats."
    ]
  },
