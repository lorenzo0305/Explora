  "rdfs:comment": {
    "de": [
      "In der Nähe des Vercors und der Ardèche, weniger als 5 Autominuten von der Autobahn A7 und dem Zentrum von Valence sowie 10 Minuten vom TGV-Bahnhof entfernt, empfängt Sie das Hotel The original city Valence-Est in einer freundlichen Atmosphäre. Nichtraucherhotel."
    ],
    "en": [
      "Close to the Vercors and Ardèche regions, less than 5 minutes by car from the A7 freeway and the center of Valence, 10 minutes from the TGV train station, the hotel The original city Valence-Est welcomes you in a friendly atmosphere. Non-smoking hotel."
    ],
    "it": [
      "Vicino al Vercors e all'Ardèche, a meno di 5 minuti d'auto dall'autostrada A7 e dal centro di Valence, a 10 minuti dalla stazione dei treni TGV, l'hotel The original city Valence-Est vi accoglie in un'atmosfera amichevole. Hotel non fumatori."
    ],
    "fr": [
      "Proche du Vercors et de l'Ardèche, à moins de 5 minutes en voiture de l'Autoroute A7 et du centre de Valence, à 10 minutes de la gare TGV, l'hôtel The original city Valence-Est vous accueille dans une ambiance conviviale. Hôtel non fumeur."
    ],
    "nl": [
      "Dicht bij de Vercors en de Ardèche, op minder dan 5 minuten rijden van de snelweg A7 en het centrum van Valence, op 10 minuten van het TGV-station, heet hotel The original city Valence-Est je welkom in een vriendelijke sfeer. Rookvrij hotel."
    ],
    "es": [
      "Cerca del Vercors y de la Ardèche, a menos de 5 minutos en coche de la autopista A7 y del centro de Valence, a 10 minutos de la estación de tren TGV, El hotel original de la ciudad Valence-Est le da la bienvenida en un ambiente acogedor. Hotel para no fumadores."
    ]
  },
