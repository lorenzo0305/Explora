  "rdfs:comment": {
    "de": [
      "Dominique Gutierrez und Gaelle Champmartin heißen Sie herzlich willkommen, um die Vorteile einer helfenden Beziehung mit dem Pferd zu entdecken.\r\nBei BiodynamiCaval verbinden wir das \"Savoir-être\" der biodynamischen Psychologie mit den therapeutischen Qualitäten der Pferde."
    ],
    "en": [
      "Dominique Gutierrez and Gaelle Champmartin welcome you to discover the benefits of helping others with horses.\r\nAt BiodynamiCaval, we combine the \"savoirs-être\" of Biodynamic Psychology with the therapeutic qualities of equines."
    ],
    "it": [
      "Dominique Gutierrez e Gaelle Champmartin vi danno il benvenuto per scoprire i benefici di aiutare gli altri con i cavalli.\r\nA BiodynamiCaval combiniamo il \"know-how\" della psicologia biodinamica con le qualità terapeutiche dei cavalli."
    ],
    "fr": [
      "Dominique Gutierrez et Gaelle Champmartin, vous accueillent pour découvrir les bienfaits de la relation d’aide avec le cheval.\r\nChez BiodynamiCaval nous allions les « savoirs-être » de la Psychologie Biodynamique et les qualités thérapeutiques des équidés."
    ],
    "es": [
      "Dominique Gutierrez y Gaelle Champmartin le invitan a descubrir los beneficios de ayudar a los demás con los caballos.\r\nEn BiodynamiCaval combinamos el \"saber hacer\" de la psicología biodinámica con las cualidades terapéuticas de los caballos."
    ],
    "nl": [
      "Dominique Gutierrez en Gaelle Champmartin heten je welkom om de voordelen te ontdekken van het helpen van anderen met paarden.\r\nBij BiodynamiCaval combineren we de \"knowhow\" van de biodynamische psychologie met de therapeutische kwaliteiten van paarden."
    ]
  },
