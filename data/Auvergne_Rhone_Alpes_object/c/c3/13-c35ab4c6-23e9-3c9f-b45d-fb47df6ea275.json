  "rdfs:comment": {
    "de": [
      "Hotel-Restaurant mit atemberaubendem Blick auf die Rhône und die alte Brücke von Seyssel. Genießen Sie Zimmer mit Balkon oder Terrasse mit Blick auf die Rhône."
    ],
    "en": [
      "Hotel-restaurant with breathtaking views of the Rhône and Seyssel's old bridge. Enjoy rooms with balcony or terrace overlooking the Rhône."
    ],
    "it": [
      "Hotel-ristorante con vista mozzafiato sul Rodano e sul vecchio ponte di Seyssel. Camere con balcone o terrazza con vista sul Rodano."
    ],
    "fr": [
      "Hôtel-restaurant avec vue imprenable sur le Rhône et le vieux pont de Seyssel. Venez profiter de chambres avec balcon ou terrasse sur le Rhône."
    ],
    "es": [
      "Hotel-restaurante con impresionantes vistas al Ródano y al puente viejo de Seyssel. Disfrute de habitaciones con balcón o terraza con vistas al Ródano."
    ],
    "nl": [
      "Hotel-restaurant met adembenemend uitzicht op de Rhône en de oude brug in Seyssel. Geniet van kamers met balkon of terras met uitzicht op de Rhône."
