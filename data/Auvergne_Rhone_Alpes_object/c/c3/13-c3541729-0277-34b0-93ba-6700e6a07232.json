  "rdfs:comment": {
    "de": [
      "Ein alternativer Ort, an dem Sie aufstrebende Künstler entdecken können. Aufführungen: Konzerte, Tanz, Ausstellungen... Der Bühnenbereich bietet Platz für bis zu 150 Zuschauer. Bar und Restaurants."
    ],
    "en": [
      "An alternative place where you can discover emerging artists. Shows: concerts, dance, exhibitions... The stage area can accommodate up to 150 spectators. Bar and restaurant."
    ],
    "it": [
      "Un luogo alternativo dove scoprire artisti emergenti. Spettacoli: concerti, danza, mostre... L'area del palco può ospitare fino a 150 spettatori. Bar e ristorante."
    ],
    "fr": [
      "Un lieu alternatif où vous pourrez découvrir des artistes émergents. Spectacle : concerts, danse, expositions... L'espace scénique peut accueillir jusqu'à 150 spectateurs. Bar et restauration."
    ],
    "es": [
      "Un lugar alternativo donde descubrir artistas emergentes. Espectáculos: conciertos, danza, exposiciones... La zona del escenario puede albergar hasta 150 espectadores. Bar y restaurante."
    ],
    "nl": [
      "Een alternatieve plek waar je opkomende artiesten kunt ontdekken. Voorstellingen: concerten, dans, tentoonstellingen... Het podium biedt plaats aan 150 toeschouwers. Bar en restaurant."
    ]
  },
