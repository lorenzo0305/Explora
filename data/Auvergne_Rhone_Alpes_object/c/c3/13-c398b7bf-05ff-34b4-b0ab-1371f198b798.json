  "rdfs:comment": {
    "de": [
      "Wir begrüßen Sie zu einem einzigartigen kulinarischen Erlebnis, das authentische Aromen und eine freundliche Atmosphäre miteinander verbindet.\nKommen Sie zu uns und entdecken Sie unsere köstlichen Gerichte, die mit Leidenschaft zubereitet werden."
    ],
    "en": [
      "We welcome you to a unique culinary experience, combining authentic flavors and a friendly atmosphere.\nJoin us to discover our tasty dishes, prepared with passion."
    ],
    "it": [
      "Vi diamo il benvenuto in un'esperienza culinaria unica, che unisce sapori autentici a un'atmosfera amichevole.\nUnitevi a noi per scoprire i nostri gustosi piatti, preparati con passione."
    ],
    "fr": [
      "Nous vous accueillions pour une experience culinaire unique, alliant saveurs authentiques et ambiance conviviale.\nRejoignez-nous pour découvrir nos plats savoureux, préparés avec passion."
    ],
    "nl": [
      "We verwelkomen je voor een unieke culinaire ervaring, waarbij authentieke smaken worden gecombineerd met een vriendelijke sfeer.\nDoe met ons mee en ontdek onze smakelijke gerechten, bereid met passie."
    ],
    "es": [
      "Le damos la bienvenida a una experiencia culinaria única, que combina sabores auténticos con un ambiente acogedor.\nÚnase a nosotros para descubrir nuestros sabrosos platos, preparados con pasión."
    ]
  },
  "rdfs:label": {
