  "rdfs:comment": {
    "de": [
      "Im Herzen von La Clusaz werden nur hochwertige und möglichst biologische Produkte verarbeitet. Große Auswahl an Weinen und eine Bar-Ecke."
    ],
    "en": [
      "In the heart of La Clusaz, working only top-of-the-range products and as organic as possible. A large choice of wines, and a bar area."
    ],
    "it": [
      "Nel cuore di La Clusaz, lavora solo con prodotti di alta gamma e il più possibile biologici. Ampia scelta di vini e area bar."
    ],
    "fr": [
      "En plein cœur de La Clusaz, ne travaillant que des produits haut de gamme et les plus bio possible. Un grand choix de vins, et un coin bar."
    ],
    "nl": [
      "In het hart van La Clusaz, alleen werken aan topklasse producten en zo biologisch mogelijk. Een grote keuze aan wijnen, en een bar gebied."
    ],
    "es": [
      "En el corazón de La Clusaz, trabaja sólo con productos de gama alta y lo más ecológicos posible. Gran selección de vinos y zona de bar."
    ]
  },
