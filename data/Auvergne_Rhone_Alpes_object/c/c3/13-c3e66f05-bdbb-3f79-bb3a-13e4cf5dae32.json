  "rdfs:comment": {
    "de": [
      "Das Restaurant L'Olympia empfängt Sie in einem gemütlichen Ambiente und bietet Ihnen Pizzas aus dem Holzofen an, die Sie vor Ort, zum Mitnehmen oder als Lieferung nach Hause genießen können."
    ],
    "en": [
      "The L'Olympia restaurant welcomes you in a cosy setting to enjoy wood-fired pizzas, on site, to take away or for home delivery."
    ],
    "it": [
      "L'Olympia è un ristorante accogliente dove si possono gustare pizze cotte a legna sul posto, da asporto o con consegna a domicilio."
    ],
    "fr": [
      "Le restaurant L'Olympia, vous accueille dans un lieu cosy et vous propose de déguster des Pizzas cuites au feu de bois, sur place, à emporter ou en livraison à domicile."
    ],
    "nl": [
      "L'Olympia is een gezellig restaurant waar je kunt genieten van houtovenpizza's ter plekke, om mee te nemen of om thuis te laten bezorgen."
    ],
    "es": [
      "L'Olympia es un acogedor restaurante donde podrá degustar pizzas al horno de leña en el propio local, para llevar o a domicilio."
    ]
  },
