  "rdfs:comment": {
    "de": [
      "Biologische Landwirtschaft. Familienbetrieb, der Weine von den Hängen der Baronnies produziert. Als unabhängige Winzer stammen unsere Trauben aus einem geschützten Terroir, das seine Authentizität bewahrt hat. Wir haben es geschafft, Modernität mit traditionellem Know-how zu verbinden."
    ],
    "en": [
      "Organic agriculture on a family estate producing \"Coteaux des Baronnies\" wines. Independent grower, our grapes come from a protected \"terroir\" which has preserved its authenticity. Our knowledge and skills combine with tradition and modernity."
    ],
    "it": [
      "Agricoltura biologica. Azienda agricola a conduzione familiare che produce vini dalle colline di Baronnies. Viticoltori indipendenti, le nostre uve provengono da un terroir preservato che ha mantenuto la sua autenticità. Siamo riusciti a combinare modernità e know-how tradizionale."
    ],
    "fr": [
      "Agriculture Biologique. Ferme familiale produisant des vins des coteaux des Baronnies. Vignerons indépendants, nos raisins sont issus d'un terroir préservé qui a gardé son authenticité. Nous avons su allier modernité et savoir-faire traditionnel."
    ],
    "es": [
      "La agricultura ecológica. Granja familiar que produce vinos de las laderas de las Baronnies. Viticultores independientes, nuestras uvas proceden de un terruño preservado que ha mantenido su autenticidad. Hemos conseguido combinar la modernidad y el saber hacer tradicional."
    ],
    "nl": [
      "Biologische landbouw. Familiebedrijf dat \"coteaux des Baronnies\" wijnen produceert. Onafhankelijke wijnboeren. Onze druiven zijn afkomstig uit een beschermd gebied dat zijn authenticiteit heeft behouden. Wij gebruiken onze traditionele ambachtelijke kennis en combineren dit met moderniteit."
    ]
  },
