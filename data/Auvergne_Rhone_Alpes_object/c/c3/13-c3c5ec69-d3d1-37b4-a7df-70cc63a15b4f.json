  "rdfs:comment": {
    "de": [
      "Canyoning, Via Ferrata, Klettern für alle Niveaus: mit Freunden, Familie, Gemeinschaften, CE, EVJF/EVG.\r\nVertic'O steht Ihnen zur Verfügung, um Sie bei der Ausübung von Outdoor-Aktivitäten in aller Sicherheit zu begleiten!"
    ],
    "en": [
      "Canyoning, via ferrata, climbing for all levels: friends, family, groups, CE, EVJF/EVG.\r\nVertic'O is here to help you enjoy outdoor activities in complete safety!"
    ],
    "it": [
      "Canyoning, via ferrata, arrampicata per tutti i livelli: con gli amici, la famiglia, i gruppi, i consigli di fabbrica, la EVJF/EVG.\r\nVertic'O è qui per aiutarvi a praticare attività all'aperto in tutta sicurezza!"
    ],
    "fr": [
      "Canyoning, via ferrata, escalade pour tous niveaux : entre amis, famille, collectivités, CE, EVJF/EVG.\r\nVertic'O est à votre écoute pour vous accompagner dans la pratique des activités outdoors en toute sécurité !"
    ],
    "es": [
      "Descenso de barrancos, vías ferratas, escalada para todos los niveles: con amigos, familia, grupos, comités de empresa, EVJF/EVG.\r\nVertic'O está aquí para ayudarte a disfrutar de las actividades al aire libre con total seguridad"
    ],
    "nl": [
      "Canyoning, klettersteigen, klimmen voor alle niveaus: met vrienden, familie, groepen, ondernemingsraden, EVJF/EVG.\r\nVertic'O is er om je in alle veiligheid te laten genieten van outdooractiviteiten!"
    ]
  },
