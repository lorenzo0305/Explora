  "rdfs:comment": {
    "de": [
      "Wir sind eine gemütliche, aber lebhafte Bar am Seeufer zwischen Le Lac und Val Claret mit der besten unterbrochenen Aussicht aller Bars in Tignes. Wir bieten eine große Auswahl an alkoholischen und nicht-alkoholischen, heißen und kalten Getränken."
    ],
    "en": [
      "We're a cosy but lively bar on the lakeside between Le Lac and Val Claret, with the best interrupted view of any bar in Tignes. We offer a wide selection of alcoholic and non-alcoholic beverages, hot and cold."
    ],
    "it": [
      "Siamo un bar accogliente ma vivace sul lungolago tra Le Lac e la Val Claret, con la migliore vista ininterrotta di tutti i bar di Tignes. Offriamo un'ampia scelta di bevande alcoliche e analcoliche, calde e fredde."
    ],
    "fr": [
      "Nous sommes un bar confortable mais animé, situé au bord du lac entre Le Lac et Val Claret, avec la meilleure vue interrompue de tous les bars de Tignes. Nous proposons une grande sélection de boissons alcoolisées et non alcoolisées, chaudes et froides."
    ],
    "nl": [
      "Wij zijn een gezellige maar levendige bar aan de oever van het meer tussen Le Lac en Val Claret, met het beste ononderbroken uitzicht van alle bars in Tignes. We bieden een grote keuze aan alcoholische en niet-alcoholische dranken, warm en koud."
    ],
    "es": [
      "Somos un bar acogedor pero animado situado a orillas del lago, entre Le Lac y Val Claret, con la mejor vista ininterrumpida de todos los bares de Tignes. Ofrecemos una gran selección de bebidas alcohólicas y no alcohólicas, frías y calientes."
    ]
  },
  "rdfs:label": {
