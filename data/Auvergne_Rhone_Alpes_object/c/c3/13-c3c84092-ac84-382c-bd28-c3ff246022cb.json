  "rdfs:comment": {
    "de": [
      "Das Haus Piron vinifiziert etwa 50 Hektar Weinberge, die zu den schönsten parzellierten Terroirs des Beaujolais gehören, vor allem in Morgon.\r\nDas in 70 Ländern vertretene Haus ist einer der starken Akteure bei der neuen Anerkennung der großen Beaujolais-Weine."
    ],
    "en": [
      "Maison Piron vinifies around 50 hectares of vines in some of the finest parcel-based terroirs in Beaujolais, particularly in Morgon.\r\nPresent in 70 countries, it is one of the key players in the new recognition of the great Beaujolais wines."
    ],
    "it": [
      "La Maison Piron vinifica circa 50 ettari di vigneti, tra i più bei terroir del Beaujolais, in particolare a Morgon.\r\nCon una presenza in 70 paesi, è uno dei protagonisti del nuovo riconoscimento dei grandi vini del Beaujolais."
    ],
    "fr": [
      "La Maison Piron vinifie environ 50 hectares de vignes, parmi les plus beaux terroirs parcellaires du Beaujolais, en particulier à Morgon.\r\nPrésente dans 70 pays, elle est l’un des acteurs forts de la nouvelle reconnaissance des grands vins du Beaujolais."
    ],
    "es": [
      "La Maison Piron vinifica unas 50 hectáreas de viñedos, entre los terruños más bellos del Beaujolais, en particular en Morgon.\r\nPresente en 70 países, es uno de los protagonistas del nuevo reconocimiento de los grandes vinos de Beaujolais."
    ],
    "nl": [
      "Het Maison Piron vinifieert ongeveer 50 hectare wijngaarden, tussen de mooiste terroirs van de Beaujolais, met name in Morgon.\r\nMet haar aanwezigheid in 70 landen is zij een van de hoofdrolspelers in de nieuwe erkenning van de grote wijnen van de Beaujolais."
    ]
  },
  "rdfs:label": {
