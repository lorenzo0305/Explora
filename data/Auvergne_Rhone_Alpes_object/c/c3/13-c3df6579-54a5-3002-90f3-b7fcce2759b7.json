    "de": [
      "Restaurant mit Panoramablick, 5 Minuten vom Zentrum entfernt mit der Seilbahn von Super Venosc.\r\nEin unumgänglicher Ort in der Höhe, um die Berge einmal anders zu genießen."
    ],
    "en": [
      "Restaurant with a panoramic view, 5 minutes from the center via the Super Venosc cable car.\r\nAn unmissable high-altitude spot to enjoy the mountains in a different way."
    ],
    "it": [
      "Ristorante con vista panoramica, a 5 minuti dal centro tramite la funivia di Super Venosc.\r\nUn luogo imperdibile in quota per gustare la montagna in modo diverso."
    ],
    "fr": [
      "Restaurant avec vue panoramique, à 5 minutes du centre  par la Télécabine de Super Venosc.\r\nUn lieu incontournable en altitude pour savourer la montagne autrement."
    ],
    "es": [
      "Restaurante con vistas panorámicas, a 5 minutos del centro en el teleférico Super Venosc.\r\nEl lugar perfecto para disfrutar de la montaña de una forma diferente."
    ],
