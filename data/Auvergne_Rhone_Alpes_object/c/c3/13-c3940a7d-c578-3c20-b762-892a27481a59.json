  "rdfs:comment": {
    "de": [
      "Wir sind in den Monts du Lyonnais ansässig und reisen mit einem Lächeln und guter Laune in die ganze Region, um zu verwöhnen!"
    ],
    "en": [
      "Based in the Monts du Lyonnais, we travel throughout the region with a smile and a good mood to delight!"
    ],
    "it": [
      "Con sede nei Monts du Lyonnais, viaggiamo in tutta la regione con il sorriso e il buon umore per deliziare i vostri ospiti!"
    ],
    "fr": [
      "Basé dans les Monts du Lyonnais, nous nous déplaçons dans toute la région avec le sourire et la bonne humeur pour régaler !"
    ],
    "nl": [
      "Wij zijn gevestigd in de Monts du Lyonnais en reizen door de hele regio met een glimlach en een goed humeur om uw gasten te verblijden!"
    ],
    "es": [
      "Desde Monts du Lyonnais, nos desplazamos por toda la región con una sonrisa y buen humor para deleitar a sus invitados"
    ]
  },
