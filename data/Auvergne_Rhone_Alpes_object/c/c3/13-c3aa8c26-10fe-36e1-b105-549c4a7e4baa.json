  "rdfs:comment": {
    "de": [
      "Restaurant im Herzen des Dorfes, neben der romanischen Kirche, schöne Terrasse mit Blick auf die 3 Becs. Restaurant ganzjährig mittags und abends geöffnet, außer dienstags. Tagesmenü für Firmen und Privatpersonen. Mahlzeitentabletts in der Umgebung von Saillans lieferbar."
    ],
    "en": [
      "Restaurant in the heart of the village, next to the Romanesque church, with a lovely terrace overlooking the Trois Becs peaks. Open year-round for lunch and dinner, except Tuesdays. Daily menu available for businesses and individuals. Meal trays delivered around Saillans."
    ],
    "it": [
      "Ristorante nel cuore del villaggio, accanto alla chiesa romanica, con una bella terrazza che si affaccia sulle 3 Bec. Ristorante aperto tutto l'anno per pranzo e cena, tranne il martedì. Menu giornaliero per aziende e privati. Vassoi di pasti disponibili nei dintorni di Saillans."
    ],
    "fr": [
      "Restaurant au cœur du village, à côté de l'église romane, belle terrasse avec vue sur les 3 Becs. Restaurant ouvert toute l'année midi et soir sauf le mardi. Menu du jour pour les entreprises et particuliers. Plateaux repas livrables autour de Saillans ."
    ],
    "es": [
      "Restaurante en el corazón del pueblo, junto a la iglesia románica, con una bonita terraza con vistas a los 3 Becs. Restaurante abierto todo el año para almuerzos y cenas, excepto los martes. Menú diario para empresas y particulares. Bandejas de comida disponibles en los alrededores de Saillans."
    ],
    "nl": [
      "Restaurant in het hart van het dorp, naast de Romaanse kerk, met een mooi terras dat uitkijkt over de 3 Becs. Restaurant het hele jaar geopend voor lunch en diner behalve op dinsdag. Dagmenu voor bedrijven en particulieren. Maaltijdschotels beschikbaar rond Saillans."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Tunnel"
    ]
  },
