  "rdfs:comment": {
    "de": [
      "Bei einem Zwischenstopp auf der Tour durch die Truyère-Schlucht im charmanten Dorf Faverolles können Sie die besten Rezepte der Küche der Auvergne kennenlernen."
    ],
    "en": [
      "A stopover on the circuit of the Gorges de la Truyère, in the charming village of Faverolles, to discover the best recipes of Auvergne cuisine."
    ],
    "it": [
      "Una tappa del circuito delle Gole della Truyère, nell'affascinante villaggio di Faverolles, per scoprire le migliori ricette della cucina alverniate."
    ],
    "fr": [
      "Une étape sur le circuit des Gorges de la Truyère, dans le charmant village de Faverolles, pour découvrir les meilleures recettes de la cuisine auvergnate."
    ],
    "es": [
      "Una parada en el circuito de las Gargantas del Truyère, en el encantador pueblo de Faverolles, para descubrir las mejores recetas de la cocina de Auvernia."
    ],
    "nl": [
      "Een stop op het circuit van de Truyère Gorges, in het charmante dorpje Faverolles, om de beste recepten van de keuken van de Auvergne te ontdekken."
    ]
  },
