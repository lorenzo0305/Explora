  "rdfs:comment": {
    "de": [
      "Christian lädt Sie ein, in der Privatsphäre eines Gewölbesaals und der ländlichen Atmosphäre einer Terrasse mit Holzpavillons zu speisen."
    ],
    "en": [
      "Christian invites you to eat in the intimate atmosphere of a vaulted room and or the bucolic terrace under wooden kiosks. Born in the North of France, they will cook up regional dishes with fresh local produce."
    ],
    "it": [
      "Christian vi invita a cenare nell'intimità di una sala a volta e nell'atmosfera bucolica di una terrazza con chioschi in legno."
    ],
    "fr": [
      "Christian vous invite à vous restaurer dans l'intimité d'une salle voûtée et l'atmosphère bucolique d'une terrasse avec kiosques en bois.Originaire du Nord, il mitonne une cuisine de nos régions et des plats aux produits locaux et frais."
    ],
    "es": [
      "Christian le invita a cenar en la intimidad de una sala abovedada y en el ambiente bucólico de una terraza con quioscos de madera."
    ],
    "nl": [
      "Christian heten u van harte welkom voor een hapje en een drankje in de knusse sfeer van de overwelfde zaal en de idyllische setting van het terras met houten tuinhuisjes. Ze komen oorspronkelijk uit het noorden en bereiden gerechten voor geïnspireerd op onze regio's en de gerechten van onze moeders."
    ]
  },
  "rdfs:label": {
    "de": [
      "L'Arbre à Miel"
    ],
    "en": [
      "L'Arbre à Miel Restaurant"
    ],
    "fr": [
      "L'Arbre à Miel"
    ],
    "nl": [
      "L'Arbre à Miel"
    ]
  },
