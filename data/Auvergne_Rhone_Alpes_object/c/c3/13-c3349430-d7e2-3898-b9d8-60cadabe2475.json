  "rdfs:comment": {
    "de": [
      "Entdecken Sie unsere Burger, Salate, Fleischstücke, Vorschläge des Chefs, hausgemachte Pommes frites... aber auch verschiedene Bretter und hausgemachte Desserts!"
    ],
    "en": [
      "Discover our burgers, salads, meats, chef's suggestions, homemade french fries... but also various boards and homemade desserts!"
    ],
    "it": [
