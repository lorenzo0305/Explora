  "rdfs:comment": {
    "de": [
      "Restaurant, Bar, Themenabende in einer idyllischen und natürlichen Umgebung. Warme und freundliche Atmosphäre. Weltküche, Pizzas aus dem Holzofen, lokale Produkte, wechselnde Speisekarte. Kostenvoranschlag für Gruppen und maßgeschneiderte Leistungen."
    ],
    "en": [
      "Bar and restaurant, night events in an idyllic and natural setting. Warm and friendly atmosphere. World cuisine, wood-fired pizzas, local products, changing menu. Quotes for groups and tailor-made services."
    ],
    "it": [
      "Ristorante, bar, serate a tema in un ambiente idilliaco e naturale. Atmosfera calda e amichevole. Cucina mondiale, pizze cotte a legna, prodotti locali, menù variabile. Preventivi di gruppo e servizi su misura."
    ],
    "fr": [
      "Restaurant, bar, soirées à thème dans un cadre idyllique et naturel. Ambiance chaleureuse et conviviale. Cuisine du monde, pizzas au feu de bois, produits locaux, carte évolutive. Devis de groupes et prestations sur mesure."
    ],
    "es": [
      "Restaurante, bar, veladas temáticas en un entorno idílico y natural. Ambiente cálido y acogedor. Cocina del mundo, pizzas al horno de leña, productos locales, menú cambiante. Presupuestos para grupos y servicios a medida."
    ],
    "nl": [
      "Restaurant, bar en thema-avonden in een idyllische natuurlijke omgeving. Warme en vriendelijke sfeer. Wereldkeuken, houtovenpizza's, lokale producten, steeds wisselend menu. Offertes voor groepen en diensten op maat."
    ]
  },
