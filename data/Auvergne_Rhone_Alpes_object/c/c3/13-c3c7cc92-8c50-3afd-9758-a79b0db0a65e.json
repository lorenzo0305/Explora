  "rdfs:comment": {
    "de": [
      "Der Pumptrack von Saint-Pierre-d?Albigny liegt am Ortseingang der Gemeinde, in der Nähe des Stadions, des Schwimmbads und des Spielplatzes. Er bietet Spiel- und Sportmöglichkeiten für alle Altersgruppen und Niveaus."
    ],
    "en": [
      "Located at the entrance to the town, close to the stadium, swimming pool and playground, the Saint-Pierre-d?Albigny pumptrack offers a fun and sporting area for all ages and levels."
    ],
    "it": [
      "Situata all'ingresso della città, vicino allo stadio, alla piscina e al parco giochi, la pista di Saint-Pierre-d'Albigny offre uno spazio ludico e sportivo per tutte le età e le capacità."
    ],
    "fr": [
      "Situé à l’entrée de la commune, à proximité du stade, de la piscine et de l’aire de jeux, le pumptrack de Saint-Pierre-d’Albigny offre un espace ludique et sportif pour tous les âges et niveaux."
    ],
    "es": [
      "Situado a la entrada de la ciudad, cerca del estadio, la piscina y el parque infantil, el pumptrack de Saint-Pierre-d'Albigny ofrece un espacio lúdico y deportivo para todas las edades y capacidades."
    ],
    "nl": [
      "De pumptrack van Saint-Pierre-d?Albigny ligt bij de ingang van de stad, dicht bij het stadion, het zwembad en de speeltuin en biedt een leuke en sportieve plek voor alle leeftijden en vaardigheden."
    ]
  },
  "rdfs:label": {
