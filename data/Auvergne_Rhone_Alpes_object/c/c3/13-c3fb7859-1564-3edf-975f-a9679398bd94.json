  "rdfs:comment": {
    "de": [
      "Die Mediathek von Cluses ist ein Ort der Entspannung, des Vergnügens und des Zuhörens. Sie ist für alle offen und das Lesen vor Ort sowie die Suche nach Informationen sind kostenlos."
    ],
    "en": [
      "Space for relaxation, fun, listening, the Cluses media library has the quality of being multiple. It is open to everyone and reading on site and finding information is free."
    ],
    "it": [
      "Luogo di relax, divertimento e ascolto, la mediateca di Cluses ha la qualità di essere multipla. È aperto a tutti e la lettura sul posto e la ricerca di informazioni sono gratuite."
    ],
    "fr": [
      "Espace de détente, d'amusement, d'écoute, la médiathèque de Cluses a la qualité d'être multiple. Elle est ouverte à tous et la lecture sur place ainsi que la recherche d'informations sont gratuites."
    ],
    "es": [
      "Un lugar para relajarse, divertirse y escuchar, la mediateca de Cluses tiene la cualidad de ser múltiple. Está abierto a todos y la lectura in situ, así como la búsqueda de información, son gratuitas."
    ],
    "nl": [
      "De mediatheek van Cluses is een plek om te ontspannen, plezier te maken en te luisteren. Het is voor iedereen toegankelijk en het lezen ter plaatse en het vinden van informatie is gratis."
    ]
  },
