  "rdfs:comment": {
    "de": [
      "Stellen Sie sich der Haute Route Alpes, der höchsten und härtesten Veranstaltung der Serie. Die Haute Route Alpes hat sich einen Namen als das härteste Amateurradrennen der Welt gemacht."
    ],
    "en": [
      "Come and take on the Haute Route Alpes, the highest and toughest event in the series. The Haute Route Alpes has made a name for itself as the toughest amateur cycling race in the world."
    ],
    "it": [
      "Venite ad affrontare la Haute Route Alpes, l'evento più alto e più duro della serie. La Haute Route Alpes si è fatta un nome come la gara ciclistica amatoriale più dura del mondo."
    ],
    "fr": [
      "Venez vous confronter à la Haute Route Alpes, l’évènement le plus haut et le plus difficile de la série. La Haute Route Alpes s’est taillée un nom en tant que course cycliste amateur la plus difficile au monde."
    ],
    "es": [
      "Venga y enfréntese a la Haute Route Alpes, la prueba más alta y dura de la serie. La Haute Route Alpes se ha hecho un nombre como la carrera ciclista amateur más dura del mundo."
    ],
    "nl": [
      "Kom en neem het op tegen de Haute Route Alpes, het hoogste en zwaarste evenement in de serie. De Haute Route Alpes heeft naam gemaakt als de zwaarste amateurwedstrijd ter wereld."
    ]
  },
