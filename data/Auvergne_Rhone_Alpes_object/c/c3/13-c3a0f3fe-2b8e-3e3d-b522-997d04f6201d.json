  "rdfs:comment": {
    "de": [
      "Angelaktivität (2. Kategorie = hauptsächlich Raubfische): Angelschein erforderlich, erhältlich unter www.cartedepeche.fr oder auf dem Campingplatz Paradis La Gineste (Gemeinde Arnac)."
    ],
    "en": [
      "The lake is home to one of Europe's largest heronries, and predator fishing is an unforgettable experience."
    ],
    "it": [
      "Pesca (2a categoria = principalmente pesci carnivori): è necessario un permesso di pesca, in vendita su www.cartedepeche.fr o presso il Camping Paradis La Gineste (Arnac)."
    ],
    "fr": [
      "Activité pêche (2e catégorie = carnassiers principalement) : permis de pêche nécessaire, en vente sur www.cartedepeche.fr ou au Camping Paradis La Gineste (commune d'Arnac)."
    ],
    "es": [
      "Pesca (2ª categoría = principalmente peces carnívoros): se requiere permiso de pesca, a la venta en www.cartedepeche.fr o en el Camping Paradis La Gineste (Arnac)."
    ],
    "nl": [
      "Het meer herbergt een van de grootste reigerijen van Europa, en het vissen op roofvissen is een onvergetelijke ervaring."
    ]
  },
