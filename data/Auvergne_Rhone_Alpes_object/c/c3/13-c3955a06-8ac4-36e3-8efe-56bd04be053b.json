  "rdfs:comment": {
    "de": [
      "Hochgebirgsführer und Skilehrer mit Sitz in Courchevel und La Tania.\r\nAngebotene Aktivitäten: Bergsteigen, Klettern, Via Ferrata, Canyoning, Heliskiing, Freeride-Skifahren, Wandern, Skifahren."
    ],
    "ru": [
      "Горные и лыжные инструкторы в Куршевеле и Ла-Танья.\r\nПредлагаемые виды спорта: альпинизм, скалолазание, виа феррата, каньонинг, хелиски, бег на лыжах вне установленной лыжни, пешеходные походы, лыжный спорт."
    ],
    "en": [
      "High-mountain guides and ski instructors based in Courchevel and La Tania.\r\nActivities available: heliskiing, off-piste skiing, hiking, skiing."
    ],
    "it": [
      "Guide di alta montagna e istruttori di sci a Courchevel e La Tania.\r\nAttività proposte: alpinismo, scalata, via ferrata, canoa, heliski, sci fuori pista, escursioni pedestri, sci."
    ],
    "fr": [
      "Guides de haute montagne et moniteurs de ski basés à Courchevel et La Tania.\r\nActivités proposées : alpinisme, héliski, ski hors-pistes, randonnée, ski."
    ],
    "es": [
      "Guías de alta montaña e instructores de esquí con base en Courchevel y La Tania.\r\nActividades propuestas: alpinismo, escalada, vía ferrata, barranquismo, heliesquí, esquí fuera de pista, senderismo y esquí."
    ],
    "nl": [
      "Berggidsen en skileraren gevestigd in Courchevel en La Tania.\r\nAangeboden activiteiten: bergbeklimmen, heliskiën, off-piste skiën, wandelen, skiën."
    ]
  },
