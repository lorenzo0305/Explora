  "rdfs:comment": {
    "de": [
      "Genießen Sie die Landschaft der Cher-Schlucht am besten beim Klettern. Der Felsen von Lignerolles ist ein sehr gut ausgestattetes Sportgebiet mit mehreren eingerichteten Routen, die sich zum Entdecken eignen oder von erfahrenen Kletterern trainiert werden können."
    ],
    "en": [
      "Make the most of the landscapes of the Cher gorges thanks to rock climbing. Le rocher de Lignerolles is a well-developed sports site with several equipped routes ideal for discovery or training for the most experienced climbers."
    ],
    "it": [
      "Approfittate dei paesaggi delle gole dello Cher con l'arrampicata. Il rocher de Lignerolles è un sito sportivo ben sviluppato con diverse vie attrezzate ideali per la scoperta o l'allenamento degli scalatori più esperti."
    ],
    "fr": [
      "Profitez au mieux des paysages des gorges du Cher grâce à l'escalade. Le rocher de Lignerolles est un site sportif très bien aménagé comportant plusieurs voies équipées propices à la découverte ou à l'entraînement pour les grimpeurs les plus chevronnés."
    ],
    "nl": [
      "Geniet van de landschappen van de kloven van de Cher door te klimmen. De rots van Lignerolles is een zeer goed uitgeruste sportlocatie met verschillende uitgeruste routes die geschikt zijn voor ontdekking of training voor de meest ervaren klimmers."
    ],
    "es": [
      "Aproveche los paisajes de las gargantas del Cher para practicar la escalada. El rocher de Lignerolles es un sitio deportivo muy bien equipado con varias vías equipadas ideales para el descubrimiento o el entrenamiento de los escaladores más experimentados."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Rocher d'escalade"
    ]
  },
