  "rdfs:comment": {
    "de": [
      "Seit 1971 lassen die Bergführer von Val-d'Isère Sie an ihrer Leidenschaft für die Berge teilhaben, wobei Sicherheit und Geselligkeit im Vordergrund stehen."
    ],
    "en": [
      "Since 1971, the high mountain guides of Val-d'Isère have been sharing their passion for the mountains, emphasizing safety and conviviality."
    ],
    "it": [
      "Dal 1971, le guide alpine della Val d'Isère condividono con voi la loro passione per la montagna, mettendo al primo posto la sicurezza e la convivialità."
    ],
    "fr": [
      "Depuis 1971, les guides de hautes montagne de Val-d’Isère vous font partager leur passion de la montagne en mettant en avant la sécurité et la convivialité."
    ],
    "nl": [
      "Sinds 1971 delen de berggidsen van Val-d?Isère hun passie voor de bergen met jou op een veilige en vriendelijke manier."
    ],
    "es": [
      "Desde 1971, los guías de montaña de Val-d'Isère comparten con usted su pasión por la montaña de forma segura y amistosa."
    ]
  },
