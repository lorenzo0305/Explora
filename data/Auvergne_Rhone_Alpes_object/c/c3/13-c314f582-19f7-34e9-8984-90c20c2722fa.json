  "rdfs:comment": {
    "de": [
      "La Baraque d'Olivier in Lozanne empfängt Sie in einem einzigartigen Rahmen, der sich ideal für die Gestaltung Ihrer Empfänge eignet.  Profitieren Sie von 800 m2 Veranstaltungsfläche und einem Bistronomierestaurant für Ihre Mittag- und Abendessen."
    ],
    "en": [
      "La Baraque d?Olivier in Lozanne welcomes you to a unique setting, ideal for all your receptions.  Enjoy 800m2 of reception space and a Bistronomic restaurant for your lunches and dinners."
    ],
    "it": [
      "La Baraque d'Olivier a Lozanne vi accoglie in un ambiente unico, ideale per tutti i vostri ricevimenti.  Godetevi 800 m2 di spazio per ricevimenti e un ristorante bistronomico per i vostri pranzi e le vostre cene."
    ],
    "fr": [
      "La Baraque d’Olivier située à Lozanne, vous accueille dans un cadre unique, idéal pour imaginer toutes vos réceptions.  Bénéficiez de 800m2 d'espaces réceptifs et un restaurant Bistronomique pour vos déjeuners et diners."
    ],
    "nl": [
      "La Baraque d'Olivier in Lozanne verwelkomt u in een unieke omgeving, ideaal voor al uw recepties.  Geniet van 800m2 receptieruimte en een Bistronomisch restaurant voor uw lunches en diners."
    ],
    "es": [
      "La Baraque d'Olivier en Lozanne le da la bienvenida a un marco único, ideal para todas sus recepciones.  Disfrute de 800m2 de espacio de recepción y de un restaurante Bistronómico para sus almuerzos y cenas."
    ]
  },
