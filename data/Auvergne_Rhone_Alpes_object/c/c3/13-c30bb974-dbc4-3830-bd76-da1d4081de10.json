  "rdfs:comment": {
    "de": [
      "Der Konferenzsaal liegt 10 Minuten von der Place de Jaude entfernt im Thermalpark von Royat und verfügt über eine angemessene Ausstattung für Ihre Firmenveranstaltungen, Konferenzen und Meetings"
    ],
    "en": [
      "Located just 10 minutes from the Place de Jaude in Royat's Parc Thermal, the conference room is ideally equipped to host your corporate events, conferences, meetings, etc"
    ],
    "it": [
      "Situata a 10 minuti da Place de Jaude, nel Parc Thermal di Royat, la sala conferenze dispone di tutte le strutture necessarie per ospitare eventi aziendali, conferenze, riunioni, ecc"
    ],
    "fr": [
      "Située à 10 minutes de la Place de Jaude dans le Parc thermal de Royat, la salle des conférences dispose d'équipements adéquats pour accueillir vos évènements d'entreprises, conférences, réunions…"
    ],
    "es": [
      "Situada a 10 minutos de la plaza de Jaude, en el Parque Termal de Royat, la sala de conferencias dispone de todas las instalaciones necesarias para acoger sus actos de empresa, conferencias, reuniones, etc"
    ],
    "nl": [
      "De conferentieruimte ligt op 10 minuten van de Place de Jaude in het Parc Thermal van Royat en beschikt over alle faciliteiten die u nodig hebt voor het organiseren van uw bedrijfsevenementen, conferenties, vergaderingen, enz"
    ]
  },
  "rdfs:label": {
    "fr": [
