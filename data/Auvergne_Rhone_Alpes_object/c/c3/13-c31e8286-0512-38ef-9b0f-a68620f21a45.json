  "rdfs:comment": {
    "de": [
      "Seit 1964 steht die Charcuterie Bancel für Qualität und Seriosität.\r\nLaurent Bancel öffnet die Türen seines Restaurants, um eine traditionelle Küche anzubieten, in der alles hausgemacht ist."
    ],
    "en": [
      "Established in Romans-sur-Isère in 1964, the Bancel delicatessen is a guarantee of quality and reliability. Laurent Bancel's restaurant invites you to come try out the local delicacies! Everything is homemade."
    ],
    "it": [
      "Dal 1964, la Charcuterie Bancel è sinonimo di qualità e affidabilità.\r\nLaurent Bancel apre le porte del suo ristorante per offrire una cucina tradizionale dove tutto è fatto in casa."
    ],
    "fr": [
      "Depuis 1964, la Charcuterie Bancel est gage de qualité et de sérieux. \r\nLaurent Bancel ouvre les portes de son Restaurant pour proposer une cuisine traditionnelle où tout est fait maison."
    ],
    "es": [
      "Desde 1964, Charcuterie Bancel es sinónimo de calidad y fiabilidad.\r\nLaurent Bancel abre las puertas de su restaurante para ofrecer una cocina tradicional donde todo es casero."
    ],
    "nl": [
      "De charcuterie (vleeswarenhandel) Bancel, opgericht in 1964 in Romans-sur-Isère, staat garant voor hoge kwaliteit en expertise. Laurent Bancel stelt zijn restaurant open, zodat zijn gasten lokale gerechten kunnen ontdekken! Alles is huisgemaakt."
    ]
  },
