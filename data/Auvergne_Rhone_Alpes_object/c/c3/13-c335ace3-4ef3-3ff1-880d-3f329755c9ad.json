  "rdfs:comment": {
    "de": [
      "Künstlerin und Malerin. Meine Malerei entwickelt eine fantastische, traumhafte, märchenhafte und humorvolle Welt, in der sich Elemente der Aktualität und des Reisens vermischen.\r\nÖl und Aquerella sind meine bevorzugten Ausdrucksmittel.\r\nAtelier vor Ort."
    ],
    "en": [
      "Artist painter. My painting develops a fantastic, dreamlike, fairy-tale and humorous universe where elements of current events and travel mingle.\r\nOil and aquerelle are my favorite means of expression.\r\nWorkshop on site."
    ],
    "it": [
      "Pittore. La mia pittura sviluppa un universo fantastico, onirico, fiabesco e umoristico in cui si mescolano elementi di attualità e di viaggio.\r\nL'olio e l'acquerello sono i miei mezzi espressivi preferiti.\r\nLaboratorio in loco."
    ],
    "fr": [
      "Artiste peintre. Ma peinture développe un univers fantastique, onirique, féérique et humoristique où se mêlent des éléments d'actualité et de voyage.\r\nL'huile et l'aquerelle sont mes moyens d'expression favoris.\r\nAtelier sur place."
    ],
    "nl": [
      "Schilder. Mijn schilderkunst ontwikkelt een fantastisch, dromerig, sprookjesachtig en humoristisch universum waarin elementen van de actualiteit en reizen met elkaar worden vermengd.\r\nOlieverf en aquarel zijn mijn favoriete expressiemiddelen.\r\nWorkshop op locatie."
    ],
    "es": [
      "Pintora. Mi pintura desarrolla un universo fantástico, onírico, de cuento de hadas y humorístico en el que se mezclan elementos de actualidad y viajes.\r\nEl óleo y la acuarela son mis medios de expresión preferidos.\r\nTaller in situ."
    ]
  },
