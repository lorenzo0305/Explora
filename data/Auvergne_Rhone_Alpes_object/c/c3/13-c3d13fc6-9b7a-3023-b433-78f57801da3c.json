  "rdfs:comment": {
    "de": [
      "Eine Strecke, die mit Mountainbike oder Gravelbike zurückgelegt werden kann, um den Wald von Colettes auf Waldwegen oder kleinen Pfaden zu entdecken. Kartografie und Fragen zum Herunterladen auf der Website www.valdesioule.com. Dauer: 2 Stunden."
    ],
    "en": [
      "A mountain bike or gravel trail to discover the Colettes forest along forest tracks or small paths. Map and questions can be downloaded from www.valdesioule.com. Duration: 2 hours."
    ],
    "it": [
      "Un percorso in mountain bike o su ghiaia per scoprire la foresta di Colettes lungo piste forestali o piccoli sentieri. Le mappe e le domande possono essere scaricate dal sito www.valdesioule.com. Durata: 2 ore."
    ],
    "fr": [
      "Un parcours à réaliser en VTT ou gravel pour découvrir la forêt des Colettes par les pistes forestières ou petits sentiers. Cartographie et questions en téléchargement sur le site www.valdesioule.com. Durée 2h."
    ],
    "es": [
      "Una ruta en bicicleta de montaña o de gravilla para descubrir el bosque de Colettes por pistas forestales o pequeños senderos. Los mapas y las preguntas pueden descargarse de www.valdesioule.com. Duración: 2 horas."
    ],
    "nl": [
      "Oriëntatielopen race"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parcours d'orientation VTT et Gravel"
    ]
  },
