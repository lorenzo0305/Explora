  "rdfs:comment": {
    "de": [
      "\"La Montagne de Téo\" ist die Spiel- und Familienpiste von Chamrousse par excellence.\r\nNeu im Winter 2023: Entspannungszone, Picknick und Holzspiele."
    ],
    "en": [
      "\"La Montagne de Téo\" is the best familial ski slope of Chamrousse. You could discover funny ski equipments/games, accompagnied by our mascot Téo.\r\nNew for winter 2023: relaxation and picnic area and outdoor wooden games."
    ],
    "it": [
      "\"La Montagne de Téo\" è il percorso ludico e familiare di Chamrousse per eccellenza.\r\nNovità dell'inverno 2023: area relax, picnic e giochi in legno."
    ],
    "fr": [
      "\"La Montagne de Téo\" est la piste ludique et familiale de Chamrousse par excellence.\r\nNouveauté hiver 2023 : zone de détente, pique-nique et jeux en bois."
    ],
    "nl": [
      "\"La Montagne de Téo\" is het ludieke en familiale parcours van Chamrousse bij uitstek.\r\nNieuw voor winter 2023: ontspanningsruimte, picknick en houten spelen."
    ],
    "es": [
      "\"La Montagne de Téo\" es el sendero divertido y familiar por excelencia de Chamrousse.\r\nNovedad para el invierno 2023: zona de relax, picnic y juegos de madera."
    ]
  },
  "rdfs:label": {
