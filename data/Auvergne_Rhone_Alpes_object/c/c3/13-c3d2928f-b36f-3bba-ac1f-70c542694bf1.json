  "rdfs:comment": {
    "de": [
      "Künstlerin und Vermittlerin, um einen Ort, ein Ereignis oder einen Wert aufzuwerten.\r\nAls Kreuzung zwischen kollektiver Intelligenz und der Welt der Grafik biete ich Animationen und künstlerische Darstellungen an. Mit einem Know-how über grafische Synthese."
    ],
    "en": [
      "Artist and facilitator, I promote a place, an event, a value.\r\nBetween collective intelligence and the world of graphics, I offer animations and artistic representations. With know-how in graphic synthesis."
    ],
    "it": [
      "Artista e facilitatore per valorizzare un luogo, un evento, un valore.\r\nAll'incrocio tra l'intelligenza collettiva e il mondo della grafica, propongo eventi e performance artistiche. La mia competenza è la sintesi grafica."
    ],
    "fr": [
      "Artiste et facilitatrice pour valoriser un lieu, un évènement, une valeur.\r\nCroisement entre l’intelligence collective et le monde du graphisme, je propose des animations et des représentation artistique. Avec un savoir faire sur la synthèse graphique."
    ],
    "nl": [
      "Kunstenaar en facilitator om een plek, een evenement, een waarde te verbeteren.\r\nOp het kruispunt van collectieve intelligentie en de wereld van grafisch ontwerp, bied ik evenementen en artistieke voorstellingen aan. Mijn expertise ligt in grafische synthese."
    ],
    "es": [
      "Artista y facilitador para realzar un lugar, un evento, un valor.\r\nEn la encrucijada de la inteligencia colectiva y el mundo del diseño gráfico, ofrezco eventos y actuaciones artísticas. Mi especialidad es la síntesis gráfica."
    ]
  },
