  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/818f249f-8c48-3ded-b881-87c47014ff47",
      "dc:description": {
        "de": [
          "Eine Show für die ganze Familie, von 2 bis 99 Jahren! Die schönsten Lieder aus Disney, Zeichentrickfilmen, Fernsehsendungen, Weihnachten? Gesang, Tanz, Comedy. Flashmob mit Kindern und Eltern!"
        ],
        "en": [
          "A show for the whole family, from 2 to 99! The most beautiful songs from Disney, cartoons, TV shows, Christmas.... Singing, dancing, comedy. Flashmob with kids and parents!"
        ],
        "it": [
          "Uno spettacolo per tutta la famiglia, dai 2 ai 99 anni! Le migliori canzoni della Disney, dei cartoni animati, dei telefilm, del Natale? Canti, balli, comicità. Flashmob con bambini e genitori!"
        ],
        "fr": [
          "Un spectacle pour toute la famille, de 2 à 99 ans ! Les plus belles chansons de Disney, dessins animés, rési tv, Noël…. Chants, danse, comédie. Flashmob avec les enfants et les parents !"
        ],
        "es": [
          "Un espectáculo para toda la familia, ¡de 2 a 99 años! Las mejores canciones de Disney, dibujos animados, programas de televisión, Navidad? Canto, baile, comedia. ¡Flashmob con niños y padres!"
        ],
        "nl": [
          "Een show voor het hele gezin, van 2 tot 99! De beste liedjes van Disney, tekenfilms, tv-shows, kerst? Zingen, dansen, komedie. Flashmob met kinderen en ouders!"
        ]
      },
