  "rdfs:comment": {
    "de": [
      "Erhalten Sie Ihre Gesundheit und Lebensfreude durch Sport und manuelle Pflege. Profitieren Sie von den besten aktuellen Techniken, die Ihren Körper schonen, und von einer professionellen, persönlichen Betreuung."
    ],
    "en": [
      "Maintain your health and joie de vivre through sport and manual care. Come and benefit from today's best techniques, respectful of your body and with personalized professional guidance."
    ],
    "it": [
      "Area sport, pilates e yoga / Area massaggi e trattamenti. Venite a beneficiare delle migliori tecniche attuali nel rispetto del vostro corpo, con una supervisione professionale personalizzata."
    ],
    "fr": [
      "Espace Sports, Pilates et yoga / Espace massage et soin. Venez bénéficier des meilleures techniques actuelles respectueuses de votre corps avec un encadrement professionnel personnalisé."
    ],
    "es": [
      "Área de deporte, pilates y yoga / Área de masajes y tratamientos. Venga y benefíciese de las mejores técnicas actuales que respetan su cuerpo, con una supervisión profesional personalizada."
    ],
    "nl": [
      "Behoud je gezondheid en levenslust door sport en manuele zorg. Kom en profiteer van de beste huidige technieken die je lichaam respecteren, met persoonlijke professionele begeleiding."
    ]
  },
  "rdfs:label": {
