  "rdfs:comment": {
    "de": [
      "Ausgabe der Montmich werden von der Amicale des Collines verschiedene Strecken angeboten. Auf dem Programm stehen 4 Wanderstrecken (6 bis 22 km) und 4 Mountainbike-Strecken (6 bis 48 km)! Kommen Sie zahlreich!"
    ],
    "en": [
      "Come and surpass your limits on the various courses proposed by the Amicale des Collines for the 14th edition of the Montmich, with 4 walking courses (6 to 22km) and 4 mountain bike courses (6 to 48km) on the programme! Come one, come all!"
    ],
    "it": [
      "Venite a superare i vostri limiti sui vari percorsi proposti dall'Amicale des Collines per la 14ª edizione della Montmich, con 4 percorsi a piedi (da 6 a 22 km) e 4 percorsi in mountain bike (da 6 a 48 km) in programma! Venite uno, venite tutti!"
    ],
    "fr": [
      "Venez dépasser vos limites lors des différents parcours proposés par l'Amicale des Collines pour la 14ème édition de la Montmich avec au programme 4 parcours pédestres (6 à 22km) et 4 parcours VTT (6 à 48km) ! Venez nombreux !"
    ],
    "es": [
      "Ven a superar tus límites en los diferentes recorridos propuestos por la Amicale des Collines para la 14ª edición de la Montmich, con 4 recorridos a pie (de 6 a 22 km) y 4 recorridos en bicicleta de montaña (de 6 a 48 km) en el programa ¡Venga uno, vengan todos!"
    ],
    "nl": [
      "Kom je grenzen verleggen op de verschillende routes die de Amicale des Collines voorstelt voor de 14e editie van de Montmich, met 4 wandelroutes (6 tot 22km) en 4 mountainbikeroutes (6 tot 48km) op het programma! Komt allen!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "La MontMich'"
    ]
  },
