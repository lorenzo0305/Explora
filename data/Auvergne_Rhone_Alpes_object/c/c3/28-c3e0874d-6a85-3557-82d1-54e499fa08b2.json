  "rdfs:comment": {
    "de": [
      "Familienrestaurant (mit Pension), das die ganze Woche über geöffnet ist (außer sonntags) und am westlichen Eingang des Chemin des Dames liegt.\nGeschlossen über Weihnachten und Neujahr und 3 Wochen im August."
    ],
    "en": [
      "Family restaurant (offering board) open all week (except Sunday) located at the western entrance to the Chemin des Dames.\nClosed Christmas-New Year and 3 weeks in August."
    ],
    "it": [
      "Ristorante familiare (pensione offerta) aperto tutta la settimana (tranne la domenica) situato all'ingresso occidentale dello Chemin des Dames.\nChiuso nel periodo di Natale-Capodanno e per 3 settimane in agosto."
    ],
    "fr": [
      "Restaurant familial (offrant pension) ouvert toute la semaine (hormis le dimanche) situé à l'entrée occidentale du Chemin des Dames.\nFermé pendant la période de Noël-Nouvel An et 3 semaines en Août."
    ],
    "es": [
      "Restaurante familiar (ofrece pensión completa) abierto toda la semana (excepto los domingos) situado en la entrada oeste del Chemin des Dames.\nCerrado en Navidad y Año Nuevo y 3 semanas en agosto."
    ],
    "nl": [
      "Familierestaurant (pension) de hele week geopend (behalve op zondag) bij de westelijke ingang van de Chemin des Dames.\nGesloten tijdens de kerst- en nieuwjaarsperiode en gedurende 3 weken in augustus."
    ]
  },
