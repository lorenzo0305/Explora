  "rdfs:comment": {
    "de": [
      "Mountainbiken im Winter? Erleben Sie neue Eindrücke auf einem elektrischen Mountainbike mit übergroßen Reifen. Genießen Sie Ausflüge, die von einer Schlemmerpause unterbrochen werden."
    ],
    "en": [
      "Mountain biking in winter? Discover new sensations on an electric mountain bike with oversized tires. Enjoy rides punctuated by a gourmet break."
    ],
    "it": [
      "Mountain bike in inverno? Scoprite nuove sensazioni su una mountain bike elettrica con pneumatici maggiorati. Godetevi le gite intervallate da una pausa gastronomica."
    ],
    "fr": [
      "Du VTT en hiver ? Venez découvrir de nouvelles sensations en VTT électrique à pneus surdimensionnés. Profitez de randonnées ponctuées d'une pause gourmande."
    ],
    "es": [
      "¿Bicicleta de montaña en invierno? Descubra nuevas sensaciones en una bicicleta de montaña eléctrica con neumáticos sobredimensionados. Disfrute de paseos puntuados por un descanso gourmet."
    ],
    "nl": [
      "Mountainbiken in de winter? Ontdek nieuwe sensaties op een elektrische mountainbike met oversized banden. Geniet van tochten die worden onderbroken door een gastronomische pauze."
    ]
  },
  "rdfs:label": {
    "en": [
      "VTT Winter Tour: VTTAE / Fat Bike stand and tour"
    ],
    "fr": [
