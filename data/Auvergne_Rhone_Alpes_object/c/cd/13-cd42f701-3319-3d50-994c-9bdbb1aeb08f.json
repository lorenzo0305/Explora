  "rdfs:comment": {
    "de": [
      "L?Angle, der Raum für zeitgenössische Kunst des MJC Centre Social, ist ein lebendiger Ort, an dem man die Kunst von heute in all ihren Formen entdecken kann."
    ],
    "en": [
      "L'Angle, the contemporary art space of the MJC Centre Social, is a lively place where you can discover today's art in all its forms."
    ],
    "it": [
      "L'Angle, lo spazio d'arte contemporanea del MJC Centre Social, è un luogo vivace dove scoprire l'arte contemporanea in tutte le sue forme."
    ],
    "fr": [
      "L’Angle, l’espace d’art contemporain de la MJC Centre Social, un lieu vivant où l’on découvre l’art d’aujourd’hui sous toutes ses formes."
    ],
    "es": [
      "L'Angle, el espacio de arte contemporáneo del MJC Centre Social, es un lugar lleno de vida donde podrá descubrir el arte contemporáneo en todas sus formas."
