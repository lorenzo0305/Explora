  "rdfs:comment": {
    "de": [
      "Ich bin Agrarwissenschaftlerin und begleite Kinder bei der Entdeckung der pflanzlichen Biodiversität durch pädagogische botanische Animationen, die für Schulklassen, Freizeitzentren und Ferienlager geeignet sind."
    ],
    "en": [
      "I'm an agronomist and I help children discover plant biodiversity through botanical educational activities, adapted to schoolchildren, leisure centers and summer camps."
    ],
    "it": [
      "Sono un agronomo e aiuto i bambini a scoprire la biodiversità delle piante attraverso attività didattiche di botanica per scuole, centri ricreativi e campi di vacanza."
    ],
    "fr": [
      "Je suis agronome et j’accompagne les enfants vers la découverte de la biodiversité végétale à travers des animations botaniques pédagogiques, adaptées aux scolaires, centres de loisirs et colonies de vacances."
    ],
    "es": [
      "Soy ingeniero agrónomo y ayudo a los niños a descubrir la biodiversidad vegetal mediante actividades educativas botánicas para colegios, centros de ocio y colonias de vacaciones."
    ],
    "nl": [
      "Ik ben landbouwkundige en ik help kinderen de biodiversiteit van planten te ontdekken door middel van botanische educatieve activiteiten voor scholen, vrijetijdscentra en vakantiekampen."
    ]
  },
