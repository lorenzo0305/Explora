  "rdfs:comment": {
    "de": [
      "Das The Ruck Hotel liegt im Herzen von Gerland in Lyon und nur wenige Schritte vom Matmut Stadium entfernt und wurde im Dezember 2022 eröffnet. Das Hotel verfügt über 134 harmonisch gestaltete Zimmer, 5 Seminarräume und ein Bistronomierestaurant."
    ],
    "en": [
      "Located in the heart of Gerland in Lyon and a near the Matmut Stadium, The Ruck Hotel opened its doors in December 2022. The hotel has 134 design and harmonious rooms, 5 seminar rooms and a bistronomic restaurant."
    ],
    "it": [
      "Situato nel cuore del quartiere Gerland di Lione, a pochi passi dallo stadio Matmut, il Ruck Hôtel ha aperto le sue porte nel dicembre 2022. L'hotel dispone di 134 camere eleganti e armoniose, 5 sale per seminari e un ristorante bistronomico."
    ],
    "fr": [
      "Situé au cœur de Gerland à Lyon et à deux pas du Matmut Stadium, The Ruck Hotel a ouvert ses portes en décembre 2022. L’hôtel dispose de 134 chambres design et harmonieuses, 5 salles de séminaires et d’un restaurant bistronomique."
    ],
    "nl": [
      "The Ruck Hotel ligt in het hart van het Gerland in Lyon en op een steenworp afstand van het Matmut-stadion. Het opende zijn deuren in december 2022. Het hotel beschikt over 134 stijlvolle en harmonieuze kamers, 5 seminariezalen en een bistronomisch restaurant."
    ],
    "es": [
      "Situado en el corazón de Gerland, en Lyon, y a dos pasos del estadio Matmut, el Hotel Ruck abrió sus puertas en diciembre de 2022. El hotel cuenta con 134 habitaciones elegantes y armoniosas, 5 salas de seminarios y un restaurante bistronómico."
    ]
  },
