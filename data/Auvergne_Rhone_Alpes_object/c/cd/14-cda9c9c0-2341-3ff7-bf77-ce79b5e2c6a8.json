  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/26639aed-44d4-3169-a541-a3449194fe5e",
      "dc:description": {
        "de": [
          "Informationen :\n\nProdukte :\n\nIn Schließfächern werden Ihnen saisonale Bauernprodukte angeboten: Karotten, Eier, Kartoffeln, Zwiebeln, Schalotten, Marmeladen, Suppen, Honig von lokalen Produzenten.\n\nÖffnungstage:\n\n24 Stunden am Tag und 7 Tage die Woche zugänglich.\n\n\n "
        ],
        "en": [
          "Information :\n\nProducts :\n\nYou'll find seasonal farm produce in racks: carrots, eggs, potatoes, onions, shallots, jams, soups and honey from local producers.\n\nOpening days:\n\nOpen 24/7.\n\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nProdotti :\n\nTroverete prodotti agricoli di stagione in scaffali: carote, uova, patate, cipolle, scalogni, marmellate, zuppe e miele di produttori locali.\n\nGiorni di apertura:\n\nAperto 24 ore su 24, 7 giorni su 7.\n\n\n "
        ],
        "fr": [
          "Informations : \n\nProduits :\n\nDans des casiers vous sont proposés des produits fermiers de saison : carottes, oeufs, pommes de terre, oignons, échalotes, confitures, soupes, miel des producteurs locaux.\n\nJours d'ouverture: \n\nAccessible 24h/24 et 7 jours/7.\n\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nProducten :\n\nJe vindt seizoensproducten van de boerderij in rekken: wortelen, eieren, aardappelen, uien, sjalotten, jam, soep en honing van lokale producenten.\n\nOpeningsdagen:\n\n24 uur per dag, 7 dagen per week geopend.\n\n\n "
        ],
        "es": [
          "Más información :\n\nProductos :\n\nEncontrará productos agrícolas de temporada en estanterías: zanahorias, huevos, patatas, cebollas, chalotas, mermeladas, sopas y miel de productores locales.\n\nDías de apertura:\n\nAbierto 24 horas al día, 7 días a la semana.\n\n\n "
        ]
      },
