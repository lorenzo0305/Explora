  "rdfs:comment": {
    "de": [
      "Los Cailletos de Chabeuil feiern ihr 20-jähriges Bestehen.\r\nEin Familientag voller guter Laune, gefolgt von einer großen Geburtstagsparty mit vielen Überraschungen auf dem Programm: musikalische Unterhaltung, Hüpfburg, Paquito, Riesenquiz, Ausstellung..."
    ],
    "en": [
      "Los Cailletos de Chabeuil celebrate their 20th anniversary.\r\nA fun-filled family day, followed by a big birthday party with lots of surprises on the program: musical entertainment, bouncy castle, paquito, giant quiz, exhibition..."
    ],
    "it": [
      "Los Cailletos de Chabeuil festeggiano il loro 20° anniversario.\r\nUna giornata all'insegna del divertimento per tutta la famiglia, seguita da una grande festa di compleanno con tante sorprese in programma: intrattenimento musicale, castello gonfiabile, paquito, quiz gigante, mostra..."
    ],
    "fr": [
      "Los Cailletos de Chabeuil fêtent leurs 20 ans.\r\nUne journée familiale pleine de bonne humeur, suivie d’une grande soirée d’anniversaire avec de nombreuses surprises au programme : animation musicale, château gonflable, paquito, quizz géant, expo..."
    ],
    "nl": [
      "Los Cailletos de Chabeuil vieren hun 20e verjaardag.\r\nEen gezellige familiedag, gevolgd door een groot verjaardagsfeest met veel verrassingen op het programma: muzikale animatie, springkasteel, paquito, reuzenquiz, tentoonstelling..."
    ],
    "es": [
      "Los Cailletos de Chabeuil celebran su 20º aniversario.\r\nUn día familiar lleno de diversión, seguido de una gran fiesta de cumpleaños con muchas sorpresas en el programa: animación musical, castillo hinchable, paquito, concurso gigante, exposición..."
    ]
  },
  "rdfs:label": {
