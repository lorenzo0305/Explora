  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/8cae5e35-739c-31de-8821-c9f9a305d3dc",
      "dc:description": {
        "de": [
          "Das Festkomitee von Senlis organisiert sein Ducasse-Essen.\nTreffpunkt ist am Samstag, den 24. August, für eine Messe um 19.00 Uhr und am Sonntag, den 25. August, für das Essen um 12.30 Uhr.\n\nAchtung begrenzte Anzahl an Anmeldungen!\nAll das bei Akkordeonmusik mit Sandy Devos."
        ],
        "en": [
          "The Comité des Fêtes de Senlis organizes its Ducasse meal.\nJoin us on Saturday August 24 for mass at 7:00 pm, and on Sunday August 25 for lunch at 12:30 pm.\n\nRegistration is limited!\nAll set to accordion music by Sandy Devos."
        ],
        "it": [
          "Il Comité des Fêtes de Senlis organizza il pranzo di Ducasse.\nUnitevi a noi sabato 24 agosto per la Messa delle 19.00 e domenica 25 agosto per il pranzo delle 12.30.\n\nLe iscrizioni sono limitate!\nIl tutto a suon di fisarmonica con Sandy Devos."
        ],
        "fr": [
          "Le Comité des Fêtes de Senlis organise son repas de Ducasse.\nRendez-vous le samedi 24 août pour une messe à 19h00 et le dimanche 25 août pour le repas à 12h30.\n\nAttention nombre d'inscription limité ! \nTout ça sur un air d'accordéon avec Sandy Devos."
        ],
        "nl": [
          "Het Comité des Fêtes de Senlis organiseert zijn Ducasse maaltijd.\nKom op zaterdag 24 augustus naar de mis om 19.00 uur en op zondag 25 augustus naar de maaltijd om 12.30 uur.\n\nDe inschrijving is beperkt!\nAlles op de melodie van een accordeon met Sandy Devos."
        ],
        "es": [
          "El Comité des Fêtes de Senlis organiza su comida Ducasse.\nÚnase a nosotros el sábado 24 de agosto para la misa a las 19:00 y el domingo 25 de agosto para la comida a las 12:30.\n\nLas inscripciones son limitadas\nTodo al son del acordeón con Sandy Devos."
        ]
      },
      "@type": [
