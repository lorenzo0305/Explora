  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/fb881f98-9af5-3ede-b59e-8b592de02910",
      "dc:description": {
        "de": [
          "Entdecken Sie von der Grube 11/19 bis zu den Zwillingshalden von Loos-en-Gohelle die Geschichte des Bassin minier, vom Kohleabbau bis zu seiner ökologischen Umgestaltung."
        ],
        "en": [
          "From pit 11/19 to the twin slag heaps at Loos-en-Gohelle, discover the history of the mining basin, from coal mining to ecological conversion."
        ],
        "it": [
          "Dalla fossa 11/19 ai due cumuli di scorie di Loos-en-Gohelle, scoprite la storia del bacino carbonifero, dall'estrazione del carbone alla sua conversione ecologica."
        ],
        "fr": [
          "Au départ de la fosse 11/19 jusqu’aux terrils jumeaux de Loos-en-Gohelle, découvrez l’histoire du Bassin minier, de l’exploitation du charbon à sa reconversion écologique."
        ],
        "nl": [
          "Van mijn 11/19 tot de dubbele terrils van Loos-en-Gohelle: ontdek de geschiedenis van het steenkoolgebied, van de steenkoolwinning tot de ecologische omschakeling."
        ],
        "es": [
          "Del pozo 11/19 a los escoriales gemelos de Loos-en-Gohelle, descubra la historia de la cuenca minera, desde la extracción del carbón hasta su reconversión ecológica."
        ]
      },
