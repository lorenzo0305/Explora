  "rdfs:comment": {
    "de": [
      "Le Réché liegt auf 1900m Höhe, 100m von der Seilbahnstation Signal entfernt und empfängt Sie im Sommer wie im Winter mit Blick auf den Mont-Blanc."
    ],
    "en": [
      "Located at 1900m altitude, 100m from the Signal cable car station, the Réché welcomes you facing the Mont-Blanc in summer and winter."
    ],
    "it": [
      "Situato a 1900 m di altitudine, a 100 m dalla stazione della funivia Signal, il Réché vi accoglie di fronte al Monte Bianco in estate e in inverno."
    ],
    "fr": [
      "Situé à 1900m d'altitude, à 100m de la gare de la télécabine du Signal, le Réché vous accueille face au Mont-Blanc été comme hiver."
    ],
    "es": [
      "Situado a 1.900 m de altitud, a 100 m de la estación del teleférico Signal, el Réché le da la bienvenida frente al Mont-Blanc en verano y en invierno."
    ],
    "nl": [
      "Gelegen op 1900m hoogte, op 100m van het kabelbaanstation Signal, verwelkomt de Réché u met uitzicht op de Mont-Blanc in zomer en winter."
    ]
  },
