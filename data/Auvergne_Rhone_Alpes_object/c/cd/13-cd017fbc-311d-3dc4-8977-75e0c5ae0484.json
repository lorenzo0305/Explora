  "rdfs:comment": {
    "de": [
      "Philippe ist ein leidenschaftlicher Messerschmied, der in Handarbeit einzigartige Messer, Werkzeuge und handgefertigte Gegenstände herstellt. Er vermischt Materialien und Texturen und lässt sich bei der Gestaltung seiner Werke von der Natur, der Mythologie, der Geschichte und der Musik inspirieren."
    ],
    "en": [
      "Philippe is a passionate knifemaker and blacksmith, creating unique, hand-crafted knives, tools and objects. He blends materials and textures, drawing inspiration from nature, mythology, history and music to shape his work."
    ],
    "it": [
      "Philippe è un appassionato coltellinaio e fabbro che crea coltelli, utensili e oggetti unici e artigianali. Mescola materiali e texture, traendo ispirazione dalla natura, dalla mitologia, dalla storia e dalla musica per plasmare il suo lavoro."
    ],
    "fr": [
      "Philippe est un coutelier-forgeron passionné, créant à la main des couteaux, outils et objets artisanaux uniques. Il mêle matières et textures, s'inspirant de la nature, de la mythologie, de l'histoire et de la musique pour façonner ses œuvres."
    ],
    "nl": [
      "Philippe is een gepassioneerd messenmaker en smid en creëert unieke, handgemaakte messen, gereedschappen en objecten. Hij mengt materialen en texturen en haalt inspiratie uit de natuur, mythologie, geschiedenis en muziek om zijn werk vorm te geven."
    ],
    "es": [
      "Philippe es un apasionado cuchillero y herrero que crea cuchillos, herramientas y objetos únicos hechos a mano. Mezcla materiales y texturas, inspirándose en la naturaleza, la mitología, la historia y la música para dar forma a su trabajo."
    ]
  },
