  "rdfs:comment": {
    "de": [
      "Geöffnet bei Sportveranstaltungen in der Eishalle.\r\n\r\nEntdecken Sie die neue Atmosphäre und das neue Dekor der Bar der Eislaufbahn. Ein Ort, der 100% Sport, 100% Chamonix und den größten Champions des Tals gewidmet ist."
    ],
    "en": [
      "Open during sporting events at the rink.\r\n\r\nCome and discover the new atmosphere and decor of the skating rink bar. A 100% sports venue, 100% Chamonix, featuring the Valley's greatest champions."
    ],
    "it": [
      "Aperto durante gli eventi sportivi presso la pista di pattinaggio.\r\n\r\nVenite a scoprire la nuova atmosfera e il nuovo arredamento del bar della pista di ghiaccio. Un luogo che è 100% sport, 100% Chamonix, e una vetrina per i più grandi campioni della Valle."
    ],
    "fr": [
      "Ouvert lors des événements sportifs à la patinoire. \r\n\r\nVenez découvrir la nouvelle ambiance et le nouveau décor du bar de la patinoire. Un lieu 100% Sport, 100% Chamonix qui fait la part belle aux plus grands champions de la Vallée."
    ],
    "nl": [
      "Geopend tijdens sportevenementen op de ijsbaan.\r\n\r\nKom en ontdek de nieuwe sfeer en inrichting van de ijsbaanbar. Een plek die 100% sport is, 100% Chamonix, en een showcase voor de grootste kampioenen van de vallei."
    ],
    "es": [
      "Abierto durante los acontecimientos deportivos en la pista de hielo.\r\n\r\nVenga a descubrir el nuevo ambiente y la nueva decoración del bar de la pista de hielo. Un lugar 100% deportivo, 100% Chamonix, escaparate de los grandes campeones del Valle."
    ]
  },
  "rdfs:label": {
    "en": [
      "Le Bar des Légendes"
    ],
    "fr": [
      "Le Bar des Légendes"
    ]
  },
