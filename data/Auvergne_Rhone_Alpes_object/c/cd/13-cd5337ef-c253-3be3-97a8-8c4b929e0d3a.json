  "rdfs:comment": {
    "de": [
      "Kanu-Kajak und Paddelboot Cahuète auf dem Fluss Allier\r\nKanu-Kajak-Verleih von April bis Oktober für Gruppen, Seminare, Familien, Schulen, Freizeitzentren, Siedlungen,...  \r\n\r\n& Kanu-Kajak-Club für das Erlernen und die föderale Perfektionierung."
    ],
    "en": [
      "Canoe-kayak and paddle Cahuète on the Allier river\r\nInitiation, coaching, improvement, rental"
    ],
    "it": [
      "Canoa-kayak e pagaia Cahuète sul fiume Allier\r\nNoleggio di canoe-kayak da aprile a ottobre per gruppi, seminari, famiglie, scuole, centri ricreativi, campeggi, ecc.  \r\n\r\nclub di canoa e kayak per principianti e avanzati."
    ],
    "fr": [
      "Canoë-kayak et paddle Cahuète sur la rivière Allier\r\nLocation de canoë-Kayak d'avril à octobre pour groupes, séminaires, familles, écoles, centre de loisirs, colonies,...  \r\n\r\n& Club de canoë-kayak pour l'apprentissage et le perfectionnement fédéral."
    ],
    "nl": [
      "Cahuète kano-kajak en peddelen op de Allier\r\nKano-kajakverhuur van april tot oktober voor groepen, seminars, gezinnen, scholen, vrijetijdscentra, kampen, enz.  \r\n\r\nkano- en kajakclub voor beginners en gevorderden."
    ],
    "es": [
      "Cahuète canoa-kayak y remo en el río Allier\r\nAlquiler de canoas-kayak de abril a octubre para grupos, seminarios, familias, escuelas, centros de ocio, campamentos, etc.  \r\n\r\nclub de piragüismo y kayak para principiantes y avanzados."
    ]
  },
