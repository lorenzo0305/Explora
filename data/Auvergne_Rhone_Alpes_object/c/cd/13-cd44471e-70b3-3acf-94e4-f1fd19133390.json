  "rdfs:comment": {
    "de": [
      "Das Restaurant Domaine de la Caille empfängt Feinschmecker in seinem Gasthof etwa 15 km von Annecy entfernt in der Haute-Savoie. In einer ruhigen, ländlichen Umgebung ist die gepflegte Einrichtung von den umliegenden Bergen inspiriert."
    ],
    "en": [
      "The Domaine de la Caille restaurant welcomes gourmets in its inn, about fifteen kilometres from Annecy in Haute-Savoie. In a quiet, rural setting, the careful decor is inspired by the mountains that surround it."
    ],
    "it": [
      "Il ristorante Domaine de la Caille accoglie i buongustai nella sua locanda, situata a circa 15 chilometri da Annecy, in Alta Savoia. In un ambiente tranquillo e rurale, l'arredamento progettato con cura si ispira alle montagne circostanti."
    ],
    "fr": [
      "Le restaurant du Domaine de la Caille accueille les gourmands dans son auberge à une quinzaine de kilomètres d’Annecy en Haute-Savoie. Dans un cadre champêtre et tranquille, le décor soigné s’inspire des montagnes qui l’entourent."
    ],
    "nl": [
      "Het restaurant Domaine de la Caille verwelkomt fijnproevers in zijn herberg, op ongeveer 15 kilometer van Annecy in de Haute-Savoie. In een rustige landelijke omgeving is de zorgvuldig ontworpen inrichting geïnspireerd op de omliggende bergen."
    ],
    "es": [
      "El restaurante Domaine de la Caille acoge a los gastrónomos en su posada, situada a unos 15 kilómetros de Annecy, en la Alta Saboya. En un entorno tranquilo y rural, la cuidada decoración se inspira en las montañas de los alrededores."
    ]
  },
  "rdfs:label": {
    "en": [
      "Auberge de la Caille"
    ],
    "fr": [
      "L'Auberge de la Caille"
    ]
  },
