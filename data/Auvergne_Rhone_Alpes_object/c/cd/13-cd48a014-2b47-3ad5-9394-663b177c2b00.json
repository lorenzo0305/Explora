  "rdfs:comment": {
    "de": [
      "Das Hotel Le Monal bietet komfortable Zimmer in einer warmen und freundlichen Atmosphäre. Das Le Monal bietet Ihnen auch eine elegante Tafel mit einer herzhaften und saisonalen Küche."
    ],
    "en": [
      "The hotel Le Monal offers you comfortable rooms in a welcoming atmosphere. Le Monal also provides a home cooked an seasonal menu."
    ],
    "it": [
      "L'Hotel Le Monal offre camere confortevoli in un'atmosfera calda e accogliente. Le Monal offre anche una ristorazione elegante con una cucina di stagione e di cuore."
    ],
    "fr": [
      "L'hôtel Le Monal propose des chambres confortables, dans une atmosphère chaleureuse et conviviale. Le Monal vous propose également une table élégante à travers une cuisine de cœur et de saison."
    ],
    "nl": [
      "Hotel Le Monal biedt comfortabele kamers in een warme en vriendelijke sfeer. Le Monal biedt ook een elegant diner met een stevige, seizoensgebonden keuken."
    ],
    "es": [
      "El Hotel Le Monal ofrece habitaciones confortables en un ambiente cálido y acogedor. Le Monal también ofrece elegantes cenas con cocina de corazón y de temporada."
    ]
  },
