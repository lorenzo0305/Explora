  "rdfs:comment": {
    "de": [
      "Die Bibliothek präsentiert die Ausstellung der beiden Künstler Chrystel Fermond und Bernard Huftier, die seit vielen Jahren befreundet sind. Sie präsentieren in einem wunderschönen Traumparcours die Zeichnungen von Chrystel, in die sich die Worte von Bernard einfügen."
    ],
    "en": [
      "The library presents an exhibition by 2 artists, Chrystel Fermond and Bernard Huftier, accomplices for many years. Chrystel's drawings are accompanied by Bernard's words, in a superb dreamlike journey."
    ],
    "it": [
      "La biblioteca presenta una mostra di due artisti, Chrystel Fermond e Bernard Huftier, che lavorano insieme da molti anni. I disegni di Chrystel sono accompagnati dalle parole di Bernard in un superbo viaggio onirico."
    ],
    "fr": [
      "La bibliothèque présente l’exposition des 2 artistes, Chrystel Fermond et Bernard Huftier, complices depuis de nombreuses années. Ils présentent dans un superbe parcours onirique, les dessins de Chrystel dans lesquels se glissent les mots de Bernard."
    ],
    "es": [
      "La biblioteca presenta una exposición de dos artistas, Chrystel Fermond y Bernard Huftier, que trabajan juntos desde hace muchos años. Los dibujos de Chrystel van acompañados de las palabras de Bernard en un soberbio viaje onírico."
    ],
    "nl": [
      "De bibliotheek presenteert een tentoonstelling van 2 kunstenaars, Chrystel Fermond en Bernard Huftier, die al vele jaren samenwerken. De tekeningen van Chrystel worden begeleid door de woorden van Bernard in een prachtige droomachtige reis."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Exposition  \"la plume et le pinceau\""
    ]
  },
