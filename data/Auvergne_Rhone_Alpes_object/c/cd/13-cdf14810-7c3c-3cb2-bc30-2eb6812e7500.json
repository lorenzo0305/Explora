  "rdfs:comment": {
    "de": [
      "Im Hameau de la Savouillane befindet sich ein biologischer und biodynamischer Weinkeller mit Weinen und Spirituosen aus Frankreich und der ganzen Welt (Italien, Spanien, Portugal, Ungarn, Chile, Argentinien, Australien, Neuseeland, Deutschland, Südafrika, USA...). Verkostungen vor Ort."
    ],
    "en": [
      "At the “Hameau de la Savouillane” you will find an organic and biodynamic cellar of wines and spirits from France and the world (Italy, Spain, Portugal, Hungary, Chile, Argentina, Australia, New Zealand, Germany, South Africa, United States...). Tastings on site."
    ],
    "it": [
      "All'Hameau de la Savouillane troverete una cantina biologica e biodinamica di vini e liquori provenienti dalla Francia e da tutto il mondo (Italia, Spagna, Portogallo, Ungheria, Cile, Argentina, Australia, Nuova Zelanda, Germania, Sudafrica, USA...). Degustazioni in loco."
    ],
    "fr": [
      "Au Hameau de la Savouillane se trouve une Cave bio et biodynamique de vins et spiritueux de France et du monde (Italie, Espagne, Portugal, Hongrie, Chili, Argentine, Australie, Nouvelle-Zélande, Allemagne, Afrique-du-Sud, USA...). Dégustations sur place."
    ],
    "nl": [
      "In de Hameau de la Savouillane vindt u een biologische en biodynamische kelder met wijnen en sterke dranken uit Frankrijk en de rest van de wereld (Italië, Spanje, Portugal, Hongarije, Chili, Argentinië, Australië, Nieuw-Zeeland, Duitsland, Zuid-Afrika, de VS...). Proeverijen ter plaatse."
    ],
    "es": [
      "En el Hameau de la Savouillane encontrará una bodega ecológica y biodinámica de vinos y licores de Francia y de todo el mundo (Italia, España, Portugal, Hungría, Chile, Argentina, Australia, Nueva Zelanda, Alemania, Sudáfrica, Estados Unidos...). Degustaciones in situ."
    ]
  },
