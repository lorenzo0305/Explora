  "rdfs:comment": {
    "de": [
      "BCHEF VICHY, das sind Leckereien für jedermann im Herzen des Stadtzentrums von Vichy. Unser Restaurant bietet eine große Auswahl an Burgern, Bagels, Salaten, Gebäck und Getränken zu jeder Tageszeit!"
    ],
    "en": [
      "BCHEF VICHY is a gourmet restaurant in the heart of downtown Vichy. Our restaurant offers a range of burgers, bagels, salads, pastries and drinks at all hours!"
    ],
    "it": [
      "BCHEF VICHY è un ristorante gourmet nel cuore del centro di Vichy. Il nostro ristorante offre una gamma di hamburger, bagel, insalate, dolci e bevande in ogni momento!"
    ],
    "fr": [
      "BCHEF VICHY, c'est la gourmandise accessible à tous en plein cœur du centre ville de Vichy. Notre restaurant propose une gamme de burgers, bagels, salades, pâtisseries et boissons à toute heure !"
    ],
    "nl": [
      "BCHEF VICHY is een gastronomisch restaurant in het hart van het centrum van Vichy. In ons restaurant kun je altijd terecht voor hamburgers, bagels, salades, gebak en drankjes!"
    ],
    "es": [
      "BCHEF VICHY es un restaurante gastronómico situado en pleno centro de Vichy. Nuestro restaurante ofrece hamburguesas, bagels, ensaladas, bollería y bebidas a todas horas"
    ]
  },
