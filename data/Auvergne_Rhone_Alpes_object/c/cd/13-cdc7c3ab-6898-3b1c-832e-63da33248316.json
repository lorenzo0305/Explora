  "rdfs:comment": {
    "de": [
      "Das Moxy Lyon Airport liegt im Herzen des Terminals 2 des Flughafens Lyon und nur wenige Minuten vom TGV-Bahnhof entfernt. Es bietet ein modernes Design und einen atemberaubenden Blick auf die Flugzeuge. Das Restaurant bietet lokale und internationale Küche."
    ],
    "en": [
      "The Moxy Lyon Airport, located in the heart of Lyon Airport's Terminal 2 and just a few minutes from the TGV station, offers a modern design and a breathtaking view of the airplanes. The restaurant serves local and international cuisine."
    ],
    "it": [
      "Il Moxy Lyon Airport, situato nel cuore del Terminal 2 dell'aeroporto di Lione e a pochi minuti dalla stazione dei treni TGV, offre un design moderno e una vista mozzafiato sugli aerei. Il ristorante serve piatti della cucina locale e internazionale."
    ],
    "fr": [
      "Le Moxy Lyon Airport, situé au cœur du Terminal 2 de l’aéroport de Lyon et à quelques minutes de la gare TGV, offre un design moderne et une vue imprenable sur les avions. Le restaurant propose une cuisine locale et internationale."
    ],
    "nl": [
      "Het Moxy Lyon Airport, gelegen in het hart van Terminal 2 op de luchthaven van Lyon en op slechts een paar minuten van het TGV-treinstation, biedt een modern design en een adembenemend uitzicht op de vliegtuigen. Het restaurant serveert lokale en internationale gerechten."
    ],
    "es": [
      "El Moxy Lyon Airport, situado en el corazón de la Terminal 2 del aeropuerto de Lyon y a pocos minutos de la estación de tren TGV, ofrece un diseño moderno y unas vistas impresionantes de los aviones. El restaurante sirve cocina local e internacional."
    ]
  },
