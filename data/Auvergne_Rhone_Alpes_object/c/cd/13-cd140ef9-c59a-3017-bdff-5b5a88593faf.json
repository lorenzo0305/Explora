  "rdfs:comment": {
    "de": [
      "Das Hotel Le Moulin de Savin empfängt Sie jeden Morgen, auf Reservierung von Dienstagabend bis Donnerstagabend und an allen Wochenenden (10:00 - 23:00 Uhr). Unser Guinguette ist jeden Sonntag, Montag und an Feiertagen geöffnet. Wir organisieren auch Konzerte."
    ],
    "en": [
      "The hotel Le Moulin de Savin welcomes you every morning, on reservation from Tuesday evening to Thursday evening and every weekend (10am - 11pm). Our guinguette is open every Sunday, Monday and public holidays. We also organize concerts."
    ],
    "it": [
      "L'hotel Le Moulin de Savin vi accoglie ogni mattina, su prenotazione dal martedì sera al giovedì sera e tutti i fine settimana (dalle 10.00 alle 23.00). La nostra guinguette è aperta ogni domenica, lunedì e giorni festivi. Organizziamo anche concerti."
    ],
    "fr": [
      "L'hôtel Le Moulin de Savin vous accueille tous les matins, sur réservation du mardi soir au jeudi soir et tous les week-end (10h - 23h). Notre guinguette est ouverte tous les dimanches, lundis et jours fériés. Nous organisons également des concerts."
    ],
    "nl": [
      "Hotel Le Moulin de Savin ontvangt u elke ochtend, op reservering van dinsdagavond tot donderdagavond en elk weekend (10.00 - 23.00 uur). Onze guinguette is elke zondag, maandag en op feestdagen geopend. We organiseren ook concerten."
    ],
    "es": [
      "El hotel Le Moulin de Savin le da la bienvenida todas las mañanas, bajo reserva de martes a jueves por la noche y todos los fines de semana (de 10 a 23 horas). Nuestra guinguette está abierta todos los domingos, lunes y festivos. También organizamos conciertos."
    ]
  },
  "rdfs:label": {
