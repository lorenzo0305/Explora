  "rdfs:comment": {
    "de": [
      "Erleben Sie am 29. April ab 19 Uhr im Auditorium des Ateliers des Arts das Talent und die Energie der Schülerinnen und Schüler bei einem abwechslungsreichen Repertoire zwischen Jazzstandards und eigenen Kreationen."
    ],
    "en": [
      "Come and discover the talent and energy of our students in a varied repertoire of jazz standards and original creations, on April 29 at 7pm in the Auditorium des Ateliers des Arts."
    ],
    "it": [
      "Venite a scoprire il talento e l'energia degli studenti che si esibiranno in un repertorio vario di standard jazz e creazioni originali, il 29 aprile alle 19.00 presso l'Auditorium degli Ateliers des Arts."
    ],
    "fr": [
      "Venez découvrir le talent et l'énergie des élèves autour d'un répertoire varié, entre standards du jazz et créations originales, le 29 avril dès 19h à l'Auditorium des Ateliers des Arts."
    ],
    "es": [
      "Venga a descubrir el talento y la energía de los alumnos, que interpretarán un variado repertorio de estándares de jazz y creaciones originales, el 29 de abril a las 19.00 horas en el Auditorium des Ateliers des Arts."
    ],
    "nl": [
      "Kom het talent en de energie van de studenten ontdekken tijdens een gevarieerd repertoire van jazzstandards en originele creaties, op 29 april om 19.00 uur in het Auditorium des Ateliers des Arts."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ateliers des Arts : Concert de jazz"
    ]
  },
