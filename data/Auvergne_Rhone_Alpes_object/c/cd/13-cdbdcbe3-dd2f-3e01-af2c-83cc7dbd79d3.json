  "rdfs:comment": {
    "de": [
      "Les Petites Cantines Perrache ist ein partizipatives Restaurant, das für alle offen ist. Hier kommen Menschen zusammen, um gemeinsam zu kochen und/oder eine gute Mahlzeit zu essen, die zu einem freien Preis serviert wird. Es ist ein Ort, an dem sich gutes Essen auf Geselligkeit reimt!"
    ],
    "en": [
      "Les Petites Cantines Perrache is a community restaurant open to everyone. People come together to cook and/or eat a good meal at a free price. It's a place where good food goes hand in hand with conviviality!"
    ],
    "it": [
      "Les Petites Cantines Perrache è un ristorante partecipativo aperto a tutti. Le persone si riuniscono per cucinare e/o mangiare un buon pasto a prezzo libero. È un luogo dove il buon cibo va di pari passo con la convivialità!"
    ],
    "fr": [
      "Les Petites Cantines Perrache est un restaurant participatif ouvert à toutes et tous. On s'y rassemble pour cuisiner et/ou manger un bon repas servi à prix libre. C'est un lieu où bien manger rime avec convivialité !"
    ],
    "nl": [
      "Les Petites Cantines Perrache is een participatief restaurant dat openstaat voor iedereen. Mensen komen er samen om gratis een lekkere maaltijd te koken en/of te eten. Het is een plek waar lekker eten hand in hand gaat met gezelligheid!"
    ],
    "es": [
      "Les Petites Cantines Perrache es un restaurante participativo abierto a todos. La gente se reúne para cocinar y/o comer una buena comida a precio libre. Es un lugar donde la buena comida va de la mano de la convivencia"
    ]
  },
