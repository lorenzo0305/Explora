    "de": [
      "Auf Kunstrasen können Sie Basketball, Handball, Tennis, Fußball, Volleyball und Badminton spielen. Informationen im Rathaus."
    ],
    "en": [
      "You can play basketball, handball, tennis, soccer, volleyball and badminton on artificial turf. Information at the Town Hall."
    ],
    "it": [
      "Potrete giocare a pallacanestro, pallamano, tennis, calcio, pallavolo e badminton su erba artificiale. Informazioni presso il Municipio."
    ],
    "fr": [
      "Vous pourrez pratiquer sur gazon synthétique du basket, du hand, du tennis, du foot et du volley ainsi que le badminton. Renseignement en Mairie."
    ],
