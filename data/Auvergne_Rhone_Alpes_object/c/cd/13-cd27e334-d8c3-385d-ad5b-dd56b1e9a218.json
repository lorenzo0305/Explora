  "rdfs:comment": {
    "de": [
      "Ein Rundweg, der mit den Wäldern, Niederwäldern und Büschen von Foissiat und Etrez spielt.\r\nWege, die die Kurven der Bresse zwischen Bergen, Teichen und Bächen betonen, von denen aus manchmal ein Weiler oder eine Aussicht auftaucht, die der Landschaft einen großen Anteil gibt."
    ],
    "en": [
      "A loop through the woods, coppices and bushes of Foissiat and Etrez.\r\nPaths highlighting the curves of the Bresse region between hills, ponds and streams, from which a hamlet or perspective sometimes emerges, giving pride of place to the landscape."
    ],
    "it": [
      "Un anello tra i boschi, i cedui e i cespugli di Foissiat ed Etrez.\r\nSentieri che accentuano le curve della regione di Bresse tra colline, stagni e ruscelli, da cui talvolta emerge un borgo o un punto panoramico che dà lustro al paesaggio."
    ],
    "fr": [
      "Une boucle jouant avec les bois, taillis et buissons de Foissiat et d'Etrez.\r\nDes chemins qui soulignent les courbes bressanes entre monts, étangs et ruisseaux d'où quelques fois apparaissent un hameau ou une perspective faisant la part belle au paysage."
    ],
    "es": [
      "Un bucle a través de los bosques, sotos y matorrales de Foissiat y Etrez.\r\nSenderos que acentúan las curvas de la región de Bresse entre colinas, estanques y arroyos, de los que a veces surge un caserío o un mirador que enorgullece el paisaje."
    ],
    "nl": [
      "Een lus door de bossen, kreupelbossen en bosjes van Foissiat en Etrez.\r\nPaden die de krommingen van de Bresse accentueren tussen heuvels, vijvers en beken, waaruit soms een gehucht of een uitkijkpunt opduikt dat het landschap een ereplaats geeft."
    ]
  },
  "rdfs:label": {
    "en": [
      "MTB track no. 10 - Lé prô, lé beû de Foissiat-Etrez (meadows and woods)"
    ],
    "fr": [
      "Circuit VTT n°10 - Lé prô, lé beû de Foissiat-Etrez (prés et bois)"
    ]
  },
