  "rdfs:comment": {
    "de": [
      "Wir halten eine Herde von 70 Alpenziegen und bieten eine vielfältige Auswahl an Käse und Tommes aus Rohmilch an. Außerdem stellen wir Eis aus Ziegenmilch her und produzieren Grenoble-Nüsse und Nussöl."
    ],
    "en": [
      "We raise a herd of 70 Alpine goats and offer a wide range of raw-milk cheeses and tommes. We also make goat's milk ice cream and produce walnuts and walnut oilWe raise a herd of 70 Alpine goats and offer a wide range of raw-milk cheeses and tommes. We also make goat's milk ice creams and produce walnuts and walnut oil."
    ],
    "it": [
      "Alleviamo una mandria di 70 capre alpine e offriamo un'ampia gamma di formaggi e tomini a latte crudo. Produciamo anche gelato al latte di capra e noci e olio di noci."
    ],
    "fr": [
      "Nous élevons un troupeau de 70 chèvres Alpines et proposons une gamme variée de fromages et tommes au lait cru. Nous fabriquons également des glaces au lait de chèvre et produisons des noix de Grenoble et de l'huile de noix."
    ],
    "nl": [
      "We houden een kudde van 70 alpengeiten en bieden een breed assortiment rauwmelkse kazen en tommes. We maken ook ijs van geitenmelk en produceren walnoten en walnootolie."
    ],
    "es": [
      "Mantenemos un rebaño de 70 cabras alpinas y ofrecemos una amplia gama de quesos de leche cruda y tommes. También elaboramos helados de leche de cabra y producimos nueces y aceite de nuez."
    ]
  },
  "rdfs:label": {
