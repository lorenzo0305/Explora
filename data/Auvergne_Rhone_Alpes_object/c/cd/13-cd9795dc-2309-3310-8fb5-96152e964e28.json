  "rdfs:comment": {
    "de": [
      "Im Herzen des Skiortes empfängt Sie Les Bains de Belle Plagne zu einer Wellness-Pause in einem einzigartigen Dekor, umgeben von Schnee. 1500m2 sind dem Wohlbefinden gewidmet, mit einem Panoramablick inmitten der Natur, gegenüber den Bergen."
    ],
    "en": [
      "In the heart of the ski resort, Les Bains de Belle Plagne welcomes you for a moment of relaxation and wellbeing in a unique decor of snow-capped mountains. 1500m2 dedicated to your wellbeing with a panoramic view of the mountains."
    ],
    "it": [
      "Nel cuore della stazione sciistica, Les Bains de Belle Plagne vi accoglie per una pausa benessere in un ambiente unico circondato dalla neve. 1500 m2 dedicati al benessere con una vista panoramica in mezzo alla natura, di fronte alle montagne."
    ],
    "fr": [
      "Au cœur de la station de ski, Les Bains de Belle Plagne vous accueille pour une parenthèse de bien-être dans un décor unique entouré de neige. 1500m2 dédiés au bien-être avec une vue panoramique en pleine nature, face aux montagnes."
    ],
    "es": [
      "En el corazón de la estación de esquí, Les Bains de Belle Plagne le da la bienvenida para una escapada de bienestar en un entorno único rodeado de nieve. 1500m2 dedicados al bienestar con una vista panorámica en plena naturaleza, frente a las montañas."
    ],
    "nl": [
      "Deep Nature Bains & Spa La Plagne, met een uniek uitzicht op de bergen, nodigt u in het centrum van Belle Plagne uit in een wellnesscocon van 1500 m², toegankelijk voor jong en oud."
    ]
  },
