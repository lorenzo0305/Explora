      "@id": "https://data.datatourisme.fr/457f915e-ef02-3c38-bdba-b3f8263b397d",
      "dc:description": {
        "de": [
          "Öffnungszeiten:\nMontags geschlossen\nDienstag bis Donnerstag von 11:30 bis 14:00 Uhr und von 18:30 bis 22:30 Uhr\nFreitags bis samstags von 11:30 bis 14:00 Uhr und von 18:30 bis 23:00 Uhr\nSonntags von 11:30 bis 14 Uhr und von 18:30 bis 22:30 Uhr\n "
        ],
        "en": [
          "Opening hours :\nClosed on Mondays\nTuesday to Thursday, 11:30am to 2pm and 6:30pm to 10:30pm\nFriday to Saturday, 11:30am to 2pm and 6:30pm to 11pm\nSunday, 11:30am to 2pm and 6:30pm to 10:30pm\n "
        ],
        "it": [
          "Orari di apertura :\nChiuso il lunedì\nDa martedì a giovedì, dalle 11.30 alle 14.00 e dalle 18.30 alle 22.30\nDa venerdì a sabato, dalle 11.30 alle 14.00 e dalle 18.30 alle 23.00\nDomenica dalle 11.30 alle 14.00 e dalle 18.30 alle 22.30\n "
        ],
        "fr": [
          "Horaires : \nFermé le lundi \nDu mardi au jeudi de 11h30 à 14h et de 18h30 à 22h30\nDu vendredi au samedi de 11h30 à 14h et de 18h30 à 23h\nLe dimanche de 11h30 à 14h et de 18h30 à 22h30\n "
        ],
        "nl": [
          "Openingstijden :\nGesloten op maandag\nDinsdag tot donderdag van 11u30 tot 14u en van 18u30 tot 22u30\nVrijdag tot zaterdag van 11u30 tot 14u en van 18u30 tot 23u\nZondag van 11.30 tot 14.00 en van 18.30 tot 22.30\n "
        ],
        "es": [
          "Horario de apertura :\nCerrado los lunes\nDe martes a jueves, de 11.30 a 14 h y de 18.30 a 22.30 h\nDe viernes a sábado, de 11.30 h a 14 h y de 18.30 h a 23 h\nDomingo de 11.30 h a 14 h y de 18.30 h a 22.30 h\n "
        ]
      },
