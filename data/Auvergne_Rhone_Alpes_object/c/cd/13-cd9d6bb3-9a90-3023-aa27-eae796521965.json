  "rdfs:comment": {
    "de": [
      "Saint-Jeand'Arves liegt im oberen Teil des Arvan-Tals,\r\nauthentisches Dorf mit grandiosen Landschaften wie den berühmten Aiguilles d'Arves, hält seine Almen dank einer ausgeprägten landwirtschaftlichen Tätigkeit in Schuss."
    ],
    "en": [
      "Located in the upper Arvan valley, Saint-Jeand'Arves,\r\nan authentic village with grandiose landscapes such as the famous Aiguilles d'Arves, maintains its alpine pastures thanks to a strong agricultural activity."
    ],
    "it": [
      "Situato nell'alta valle dell'Arvan, Saint-Jeand'Arves,\r\nun autentico villaggio con magnifici paesaggi, come le famose Aiguilles d'Arves, mantiene i suoi pascoli di montagna grazie a un'intensa attività agricola."
    ],
    "fr": [
      "Situé dans la partie supérieure de la vallée de l’Arvan, Saint-Jeand’Arves,\r\nvillage authentique doté de paysages grandioses à l’image des fameuses Aiguilles d’Arves, entretient ses alpages grâce à une activité agricole bien présente."
    ],
    "es": [
      "Situado en la parte alta del valle de Arvan, Saint-Jeand'Arves,\r\nun auténtico pueblo con paisajes grandiosos como las famosas Aiguilles d'Arves, mantiene sus pastos de montaña gracias a una actividad agrícola muy presente."
    ],
    "nl": [
      "Saint-Jeand'Arves ligt aan de bovenloop van de Arvan-vallei,\r\neen authentiek dorp met prachtige landschappen, zoals de beroemde Aiguilles d'Arves, dat zijn bergweiden behoudt dankzij een sterke landbouwactiviteit."
    ]
  },
