  "rdfs:comment": {
    "de": [
      "Die Tam-Tam Montluçon Drum School organisiert ihre nächste jährliche Masterclass!\r\nFür die fünfte Auflage des Workshops hat sich die Schule etwas Besonderes einfallen lassen und wird Kevin Plutta und Nathan Maliba als Duo begrüßen, die ihr Talent unter Beweis stellen werden."
    ],
    "en": [
      "The Tam-Tam Montluçon Drum School is organizing its next annual Masterclass!\r\nFor its 5th edition, the school is pulling out all the stops, and will be welcoming Kevin Plutta and Nathan Maliba as a duo to showcase the full extent of their talent."
    ],
    "it": [
      "La Tam-Tam Montluçon Drum School organizza la sua prossima Masterclass annuale!\r\nPer la sua 5a edizione, la scuola si prepara ad accogliere Kevin Plutta e Nathan Maliba in duo per mostrare tutto il loro talento."
    ],
    "fr": [
      "L’Ecole de Batterie Tam-Tam Montluçon organise sa prochaine Masterclass annuelle !\r\nPour sa 5ème édition, l’école met les petits plats dans les grands et accueillera en duo Kevin Plutta et Nathan Maliba qui viendront nous démontrer l’étendu de leur talent."
    ],
    "es": [
      "La Tam-Tam Montluçon Drum School organiza su próxima Masterclass anual\r\nEn su 5ª edición, la escuela da la bienvenida a Kevin Plutta y Nathan Maliba en dúo para mostrar todo su talento."
    ],
    "nl": [
      "De Tam-Tam Montluçon Drum School organiseert haar volgende jaarlijkse Masterclass!\r\nVoor de 5e editie trekt de school alles uit de kast en verwelkomt Kevin Plutta en Nathan Maliba als duo om hun talent ten volle te laten horen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Concert : MasterClass Batterie - Kevin Plutta & Nathan Maliba"
    ]
  },
