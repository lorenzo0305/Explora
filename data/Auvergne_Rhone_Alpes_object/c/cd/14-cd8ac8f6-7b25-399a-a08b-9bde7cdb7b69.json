  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/078b445f-a704-360d-ae8b-13cc69ffbe1a",
      "dc:description": {
        "de": [
          "Ein höllischer Look, einfaches und sofortiges Fahrvergnügen, 100% elektrisch, ein Ride-Feeling und sehr süchtig machend. Probieren Sie es sofort aus."
        ],
        "en": [
          "It looks great, it's easy to ride, 100% electric, it feels like riding, and it's highly addictive. Try it now."
        ],
        "it": [
          "Ha un aspetto magnifico, è divertente da guidare, è semplice e immediato, è 100% elettrico, sembra di guidare ed è altamente coinvolgente. Provatelo subito."
        ],
        "fr": [
          "Un look d'enfer, un plaisir de piloter simple et immédiat, 100% électrique, une sensation de ride et très addictif. Essayez-la tout de suite."
        ],
        "es": [
          "Tiene un aspecto estupendo, es divertido de conducir, es sencillo e inmediato, es 100% eléctrico, se siente como un paseo y es altamente adictivo. Pruébala ahora."
        ],
        "nl": [
          "Het ziet er geweldig uit, het is leuk om te rijden, het is eenvoudig en direct, het is 100% elektrisch, het voelt als een rit en het is zeer verslavend. Probeer het nu."
        ]
      },
      "@type": [
        "Description"
