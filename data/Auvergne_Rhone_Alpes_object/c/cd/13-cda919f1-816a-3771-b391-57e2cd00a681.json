  "rdfs:comment": {
    "de": [
      "Didier Trouvel, Mitglied des Moniteur Cycliste Français, begleitet Sie bei der Betreuung von Mountainbikes, Fahrrädern mit elektrischer Unterstützung, Wanderungen, Kursen, Seminaren und Aufenthalten."
    ],
    "en": [
      "Didier Trouvel, affiliated with the Moniteur Cycliste Français, will accompany you for mountain bike and electric bike coaching, excursions, training courses, seminars and stays."
    ],
    "it": [
      "Didier Trouvel, affiliato al Moniteur Cycliste Français, vi accompagnerà per allenamenti in mountain bike e bici elettriche, escursioni, corsi, seminari e soggiorni."
    ],
    "fr": [
      "Didier Trouvel, affilié au Moniteur Cycliste Français, vous accompagnera pour des encadrement en VTT, vélo à assistance électrique, des randonnées, stages, séminaires et séjours."
    ],
    "es": [
      "Didier Trouvel, afiliado al Moniteur Cycliste Français, le acompañará en sus entrenamientos de bicicleta de montaña y bicicleta eléctrica, excursiones, cursos, seminarios y estancias."
    ],
    "nl": [
      "Didier Trouvel, aangesloten bij het Moniteur Cycliste Français, begeleidt u bij mountainbike- en elektrische fietstrainingen, excursies, cursussen, seminars en verblijven."
    ]
  },
  "rdfs:label": {
