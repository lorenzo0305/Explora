  "rdfs:comment": {
    "de": [
      "Das Museum Pomarat, das sich in der ehemaligen Kapelle der Büßer in Saint-Paulien befindet, enthüllt den Reichtum der ehemaligen gallorömischen Hauptstadt des Velay. Das Museum ist für Familien geeignet und bietet eine spielerische Zeitreise durch die Augen eines Archäologen."
    ],
    "en": [
      "An audio-guide and the voice of an archaeologist lead visitors through the ages and the vestiges unearthed in the ancient capital of the Vellavi people.\r\n\r\nOur exploration of the history of Saint-Paulien continues with a visit to the town."
    ],
    "it": [
      "Il Musée Pomarat, ospitato nell'antica cappella dei Pénitents a Saint-Paulien, rivela le ricchezze dell'antica capitale gallo-romana di Velay. Adatto alle famiglie, offre un divertente viaggio nel tempo attraverso gli occhi di un archeologo."
    ],
    "fr": [
      "Le musée Pomarat, situé dans l'ancienne chapelle des Pénitents à Saint-Paulien, dévoile la richesse de l'ancienne capitale gallo-romaine du Velay. Adapté aux familles, il propose un voyage ludique dans le temps à travers les yeux d'un archéologue."
    ],
    "nl": [
      "Het Musée Pomarat, gehuisvest in de voormalige kapel van de Pénitents in Saint-Paulien, onthult de rijkdommen van de oude Gallo-Romeinse hoofdstad Velay. Het is geschikt voor gezinnen en biedt een leuke reis terug in de tijd door de ogen van een archeoloog."
    ],
    "es": [
      "El Museo Pomarat, instalado en la antigua capilla de los Penitentes de Saint-Paulien, revela las riquezas de la antigua capital galo-romana de Velay. Apto para familias, ofrece un divertido viaje en el tiempo a través de los ojos de un arqueólogo."
    ]
  },
