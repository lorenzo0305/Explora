  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/e14e4ce0-b36d-3502-a80f-49071162a3b0",
      "dc:description": {
        "de": [
          "Fahrradverleih für die ganze Familie. Fahrräder, Elektrofahrräder, Tandems, Kinder- und Tieranhänger.\nMit Führung nach Reservierung und Kostenvoranschlag.\nReparaturen."
        ],
        "en": [
          "Bicycle rental for the whole family. Bicycles, electric bikes, tandems, children's trailers and animals.\nWith guide on reservation and estimate.\nRepairs."
        ],
        "it": [
          "Noleggio di biciclette per tutta la famiglia. Biciclette, biciclette elettriche, tandem, rimorchi per bambini e animali.\nCon guida alla prenotazione e al preventivo.\nServizio di riparazione."
        ],
        "fr": [
          "Location de cycles pour toute la famille. Cycles, vélos électriques, tandems, remorques enfants et animaux.\nAvec guide sur réservation et devis.\nRéparation."
        ],
        "nl": [
          "Fietsverhuur voor het hele gezin. Fietsen, elektrische fietsen, tandems, kinderwagens en dieren.\nMet gids voor reservering en schatting.\nReparatiedienst."
        ],
        "es": [
          "Alquiler de bicicletas para toda la familia. Ciclos, bicicletas eléctricas, tándems, remolques para niños y animales.\nCon guía de reserva y presupuesto.\nServicio de reparación."
        ]
      },
