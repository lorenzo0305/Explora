  "rdfs:comment": {
    "de": [
      "Kleiner Familienbetrieb, der auf die Produktion von Lavandin in biologischer Landwirtschaft umgestellt wurde.\r\nBearbeitung des Bodens ohne Dünger und Pestizide.\r\nVerkauf von ätherischem Bio-Lavandinöl ab dem Anwesen"
    ],
    "en": [
      "Small family farm converted to the production of lavandin in Organic Farming\r\nWorking the land without fertilizers or pesticides\r\nSale of organic lavandin essential oil at the property"
    ],
    "it": [
      "Piccola azienda agricola familiare convertita alla produzione di lavanda biologica\r\nLavorare la terra senza fertilizzanti né pesticidi\r\nOlio essenziale di lavandina biologico venduto presso la proprietà"
    ],
    "fr": [
      "Petite exploitation familiale reconvertie dans la production de lavandin en Agriculture Biologique\r\nTravail de la terre sans engrais ni pesticides\r\nVente d’huile essentielle de lavandin bio à la propriété"
    ],
    "es": [
      "Pequeña explotación familiar reconvertida a la producción ecológica de lavanda\r\nTrabajo de la tierra sin fertilizantes ni pesticidas\r\nAceite esencial de lavandín ecológico vendido en la propiedad"
    ],
    "nl": [
      "Kleine familieboerderij omgeschakeld naar biologische lavendelproductie\nHet land bewerken zonder kunstmest of pesticiden\nVerkoop van biologische lavandin etherische olie op het landgoed"
    ]
  },
