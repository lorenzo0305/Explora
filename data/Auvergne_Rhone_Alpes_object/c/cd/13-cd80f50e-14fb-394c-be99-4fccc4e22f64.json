  "rdfs:comment": {
    "de": [
      "Das Musée des Berthalais, eine Erinnerung an das Leben von früher, zeigt rund 100 Maschinen, fast 6000 Werkzeuge und Gegenstände, die auf einer 700 m2 großen Entdeckungsfläche zur Geltung gebracht werden und von der handwerklichen, industriellen und landwirtschaftlichen Geschichte des Drôme-Tals zeugen."
    ],
    "en": [
      "The Berthalais Museum, a memory of life in bygone days, presents around one hundred machines, nearly 6000 tools and objects, showcased in a 700 m2 discovery area, bearing witness to the artisanal, industrial and agricultural history of the Drôme Valley."
    ],
    "it": [
      "Il Musée des Berthalais, che ricorda la vita di un tempo, espone un centinaio di macchine e quasi 6.000 utensili e oggetti in un'area scoperta di 700 m2 , testimoniando la storia artigianale, industriale e agricola della Valle della Drôme."
    ],
    "fr": [
      "Le Musée des Berthalais, mémoire de la vie d’antan, présente une centaine de machines, près de 6000 outils et objets, mis en valeur sur un espace de découverte de 700 m2, témoins de l'histoire artisanale, industrielle et agricole de la Vallée de la Drôme."
    ],
    "nl": [
      "Het Musée des Berthalais, een herinnering aan het leven van vroeger, heeft een honderdtal machines en bijna 6.000 gereedschappen en voorwerpen tentoongesteld in een ontdekkingsruimte van 700 m2, die getuigen van de ambachtelijke, industriële en agrarische geschiedenis van de Drômevallei."
    ],
    "es": [
      "El Museo des Berthalais, recuerdo de la vida de antaño, cuenta con un centenar de máquinas y cerca de 6.000 herramientas y objetos expuestos en un espacio de descubrimiento de 700 m2, testigos de la historia artesanal, industrial y agrícola del valle del Drôme."
    ]
  },
  "rdfs:label": {
    "de": [
      "Museum von Berthalais – Landwirtschafts-, Industrie- und Handwerksausstellung"
    ],
    "en": [
      "Museum of Berthalais - Agricultural, industrial and craft exhibition"
    ],
    "fr": [
      "Musée agricole, industriel et artisanal des Berthalais"
    ],
    "nl": [
      "Museum van Berthalais - Tentoonstelling over landbouw, industrie en ambachten"
    ]
  },
