  "rdfs:comment": {
    "de": [
      "Die Kirche Sainte-Suzanne stammt aus dem Jahr 1769, wie das in den Sturz der Kapellentür eingravierte Datum belegt."
    ],
    "en": [
      "Sainte-Suzanne church dates back to 1769, as attested by the date engraved on the lintel of the chapel door."
    ],
    "it": [
      "La chiesa di Sainte-Suzanne risale al 1769, come testimonia la data incisa sull'architrave della porta della cappella."
    ],
    "fr": [
      "L'église Sainte-Suzanne date de 1769 comme l'atteste la date gravée sur le linteau de la porte de la chapelle."
    ],
    "es": [
      "La iglesia Sainte-Suzanne data de 1769, como atestigua la fecha grabada en el dintel de la puerta de la capilla."
    ],
    "nl": [
      "De kerk Sainte-Suzanne dateert uit 1769, zoals blijkt uit de datum die op de bovendorpel van de kapeldeur is gegraveerd."
    ]
  },
