  "rdfs:comment": {
    "de": [
      "Künstlerin, die das Papier, die Bäume und den Boden liebt\r\nLeiterin kreativer Workshops für Erwachsene, allein oder mit Angehörigen (Erwachsene oder Kinder), um sich mit sich selbst und anderen zu verbinden"
    ],
    "en": [
      "Artist in love with paper, trees and soil\r\nFacilitator of creative workshops for adults, alone or with loved ones (adults or children), to connect with oneself, to connect with others"
    ],
    "it": [
      "Artista innamorata della carta, degli alberi e della terra\r\nFacilitatrice di laboratori creativi per adulti, da soli o con persone care (adulti o bambini), per connettersi con se stessi, per connettersi con gli altri"
    ],
    "fr": [
      "Artiste amoureuse du papier, des arbres et du sol\r\nAnimatrice d'ateliers créatifs pour adultes, seuls ou avec des proches (adultes ou enfants), pour se relier à soi-même, pour se relier aux autres"
    ],
    "nl": [
      "Kunstenaar verliefd op papier, bomen en aarde\r\nFacilitator van creatieve workshops voor volwassenen, alleen of met geliefden (volwassenen of kinderen), om in contact te komen met zichzelf, om in contact te komen met anderen"
    ],
    "es": [
      "Artista enamorada del papel, los árboles y la tierra\r\nFacilitadora de talleres creativos para adultos, solos o con seres queridos (adultos o niños), para conectar con uno mismo, para conectar con los demás"
    ]
  },
