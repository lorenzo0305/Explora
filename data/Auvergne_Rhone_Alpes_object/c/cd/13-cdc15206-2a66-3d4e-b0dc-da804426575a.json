  "rdfs:comment": {
    "de": [
      "Familienverband, der 3 Arten von Aktivitäten anbietet: Babygymnastik ab dem jüngsten Alter und dem perfekten Erwerb des Gehens, Modern Jazz Dance und rhythmische Gymnastik ab 3 Jahren."
    ],
    "en": [
      "Rhythmic and Sports Gymnastics: classes from 4 years old. Association of flexibility, coordination, endurance, musculation, music, space and machines. (ball, clubs, hoop, ribbon, rope)"
    ],
    "it": [
      "Associazione familiare che offre 3 tipi di attività: baby gym fin dalla più tenera età e perfetta acquisizione della camminata, danza modern jazz e ginnastica ritmica a partire dai 3 anni."
    ],
    "fr": [
      "Association familiale proposant 3 types d'activité : la baby gym dès le plus jeune âge et l'acquisition parfaite de la marche, la danse modern jazz et la gymnastique rythmique dès l'âge de  3 ans."
    ],
    "nl": [
      "Gezinsvereniging die 3 soorten activiteiten aanbiedt: babygym vanaf zeer jonge leeftijd en perfecte verwerving van lopen, moderne jazzdans en ritmische gymnastiek vanaf 3 jaar."
    ],
    "es": [
      "Asociación familiar que ofrece 3 tipos de actividades: gimnasia para bebés desde muy temprana edad y perfecta adquisición de la marcha, danza jazz moderna y gimnasia rítmica a partir de los 3 años."
    ]
  },
