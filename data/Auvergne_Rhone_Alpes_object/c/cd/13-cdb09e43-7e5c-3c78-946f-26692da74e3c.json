  "rdfs:comment": {
    "de": [
      "Ein Bauernhof, der auf Tierschutz und Naturschutz basiert. Zucht von Irish Cob-Pferden, Ausritte und Wanderungen zu Pferd, Pferdevermittlung und Mensch-Pferd-Verbindung, Farmbesuche und Entdeckung von Herdenschutzhunden."
    ],
    "en": [
      "A farm based on animal welfare and nature conservation. Breeding Irish Cob horses, horse riding, equine mediation and the human/horse connection, farm visits and discovery of herding dogs."
    ],
    "it": [
      "Una fattoria basata sul benessere degli animali e sulla protezione della natura. Allevamento di cavalli Cob irlandesi, passeggiate ed escursioni a cavallo, mediazione equina e connessione uomo-cavallo, visite alla fattoria e scoperta dei cani da protezione delle mandrie."
    ],
    "fr": [
      "Une ferme basée sur le bien être animal et la protection de la nature. Elevage de chevaux Irish Cob, balades et randonnées à cheval, médiation équine et connexion homme/cheval, visite de ferme et découverte des chiens de protection de troupeaux."
    ],
    "es": [
      "Una granja basada en el bienestar animal y la protección de la naturaleza. Cría de caballos Irish Cob, paseos y excursiones a caballo, mediación equina y conexión entre el hombre y el caballo, visitas a la granja y descubrimiento de los perros protectores de rebaños."
    ],
    "nl": [
      "Een boerderij gebaseerd op dierenwelzijn en de bescherming van de natuur. Fokken van Ierse Cob-paarden, paardrijden en excursies, paardenbemiddeling en de band tussen mens en paard, boerderijbezoeken en ontdekking van kuddebeschermingshonden."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Cros de L'Oume"
    ]
  },
