  "rdfs:comment": {
    "de": [
      "Esther empfängt Sie in einer herzlichen, savoyischen Atmosphäre, in der Sie lokale Spezialitäten und ihre köstlichen Desserts probieren können."
    ],
    "en": [
      "Esther welcome you in a friendly Savoy atmosphere so that you will discover local dishes and their house specials : chocolate fondue, café gourmand, Nivolet Bolet and many more..."
    ],
    "it": [
      "Esther vi accoglie in una calda atmosfera savoiarda per farvi assaggiare le specialità locali e i loro dolci gourmet."
    ],
    "fr": [
      "Esther vous accueille dans une ambiance savoyarde et chaleureuse pour vous faire déguster les spécialités locales ainsi que leurs desserts gourmands."
    ],
    "nl": [
      "Esther ontvangt u in een warme Savoyaardse sfeer om u de lokale specialiteiten en hun gastronomische desserts te laten proeven."
    ],
    "es": [
      "Esther le acoge en un cálido ambiente saboyano para hacerle probar las especialidades locales así como sus postres gourmet."
    ]
  },
