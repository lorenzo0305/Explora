  "rdfs:comment": {
    "de": [
      "Vom Col de Porte aus gibt es einen Parcours mit 12 Markierungen, der sich ideal für den Einstieg in den Orientierungslauf eignet. An jeder Markierung ist die Broschüre mit einer Frage oder einem kleinen Quiz versehen."
    ],
    "en": [
      "Starting from the Col de Porte, a 12-marker course ideal for beginners in orienteering. Each marker is accompanied by a question or quiz."
    ],
    "it": [
      "Partendo dal Col de Porte, un percorso di 12 marcatori è ideale per un'introduzione all'orienteering. Ogni punto è accompagnato da una domanda o da un quiz."
    ],
    "fr": [
      "Au départ du Col de Porte, un parcours de 12 balises idéal pour s’initier à la course d’orientation. A chaque balise le dépliant est agrémenté d’une question ou d’un petit quizz."
    ],
    "es": [
      "Partiendo del Col de Porte, un recorrido de 12 balizas ideal para iniciarse en la orientación. Cada baliza va acompañada de una pregunta o test."
    ],
    "nl": [
      "Beginnend bij de Col de Porte is een route van 12 markers ideaal voor een inleiding tot oriëntatielopen. Bij elke markering hoort een vraag of quiz."
    ]
  },
  "rdfs:label": {
    "fr": [
      "A la découverte de la forêt domaniale de la Grande Chartreuse - Parcours d'orientation ludique enfant"
    ]
  },
