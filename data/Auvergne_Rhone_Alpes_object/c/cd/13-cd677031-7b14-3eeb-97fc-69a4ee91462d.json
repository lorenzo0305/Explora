  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Kunsttischlerei in Workshops, in denen ein Fachmann Ihnen sein Wissen und seine Techniken vermittelt, um Ihre Projekte für Holzobjekte und Möbel zu gestalten."
    ],
    "en": [
      "Discover cabinetmaking in workshops where a professional shares his know-how and techniques to help you create your own wooden objects and furniture."
    ],
    "it": [
      "Scoprite l'ebanisteria nei laboratori dove un professionista vi trasmetterà il suo know-how e le sue tecniche per aiutarvi a creare i vostri oggetti e mobili in legno."
    ],
    "fr": [
      "Découvrez l'ébénisterie lors d'ateliers où un professionnel vous transmettra son savoir-faire et ses techniques pour créer vos projets d'objets en bois et meubles."
    ],
    "nl": [
      "Ontdek meubelmaken tijdens workshops waar een professional zijn kennis en technieken doorgeeft om je te helpen je eigen houten voorwerpen en meubels te maken."
    ],
    "es": [
      "Descubra la ebanistería en talleres donde un profesional le transmitirá sus conocimientos y técnicas para ayudarle a crear sus propios objetos y muebles de madera."
    ]
  },
