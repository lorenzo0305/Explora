  "rdfs:comment": {
    "de": [
      "In der Drôme des collines werden in der Tradition der biologischen Landwirtschaft aromatische und medizinische Pflanzen angebaut und geerntet."
    ],
    "en": [
      "Founded in 2015 in the village of St Michel sur Savasse, this family-run, artisanal business grows organic fresh herbs like tarragon, thyme, oregano, as well as medicinal plants used by our ancestors."
    ],
    "it": [
      "Nella Drôme des collines, coltivazione e raccolta di piante aromatiche e medicinali nella tradizione dell'agricoltura biologica."
    ],
    "fr": [
      "En Drôme des collines, cultures et cueillettes de plantes aromatiques et médicinales dans la tradition de l'agriculture biologique."
    ],
    "es": [
      "En la Drôme des collines, cultivo y recolección de plantas aromáticas y medicinales en la tradición de la agricultura ecológica."
    ],
    "nl": [
      "Dit ambachtelijke familiebedrijf, opgericht in 2015 in de gemeente St Michel sur Savasse, is gespecialiseerd in biologische landbouw van aromatische planten zoals dragon, tijm, oregano, maar ook in geneeskrachtige planten die door onze voorvaders werden gebruikt."
    ]
  },
