  "rdfs:comment": {
    "de": [
      "Ihr deutschsprachiger Spezialist für Ihre Wanderreisen im Beaujolais, in Frankreich, Großbritannien und Irland. Eine Reihe von außergewöhnlichen Aufenthalten durch das Beaujolais mit Wanderungen von 1 bis 12 Tagen und allen Schwierigkeitsgraden."
    ],
    "en": [
      "High Point Holidays specializes in providing independent and guided walking holidays in France to English speakers, with a large collection of self-guided multi-day holidays in the beautiful Beaujolais region, close to the historic city of Lyon. Our unique holidays of between 2 and 12 days are designed to let you discover the real identity of each region, allowing you time to appreciate what makes its special and unique, whilst walking at your own pace."
    ],
    "it": [
      "Il vostro specialista francofono per le vacanze a piedi nel Beaujolais, in Francia, Gran Bretagna e Irlanda. Una gamma di vacanze eccezionali nel Beaujolais con escursioni da 1 a 12 giorni e per tutti i livelli."
    ],
    "fr": [
      "Votre spécialiste francophone pour vos séjours de randonnées pédestres en Beaujolais, en France, en Grande Bretagne et en Irlande. Une gamme de séjours exceptionnels à travers le Beaujolais avec des randonnées de 1 à 12 jours et de tous les niveaux."
    ],
    "nl": [
      "Uw Franstalige specialist voor wandelvakanties in de Beaujolais, Frankrijk, Groot-Brittannië en Ierland. Een reeks uitzonderlijke vakanties door de Beaujolais met wandelingen van 1 tot 12 dagen en voor alle niveaus."
    ],
    "es": [
      "Su especialista francófono en vacaciones de senderismo en el Beaujolais, Francia, Gran Bretaña e Irlanda. Una gama de vacaciones excepcionales por el Beaujolais con excursiones de 1 a 12 días y para todos los niveles."
    ]
  },
  "rdfs:label": {
    "en": [
      "Hikes across the Channel"
    ],
