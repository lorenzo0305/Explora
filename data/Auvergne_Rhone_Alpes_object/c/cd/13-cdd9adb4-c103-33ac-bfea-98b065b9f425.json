  "rdfs:comment": {
    "de": [
      "Hier gibt es alles zum Mitnehmen: Pizzas, Paninis, Bagels, Kebabs, Sandwiches, Pasta, Crêpes, Waffeln... und im Sommer unser handgemachtes Eis. Bestellungen sind auch telefonisch möglich. Speisekarten auf der Website www.duselausucre.fr"
    ],
    "en": [
      "Take away : pizzas, paninis, bagels, kebabs, sandwiches, pastas, pancakes, waffles... In Summer our home-made ice creams. Possibility to order by phone. Menus available on the website www.duselausucre.fr"
    ],
    "it": [
      "Qui tutto è da asporto: pizze, panini, bagel, kebab, sandwich, pasta, crêpe, cialde, ecc. E per l'estate i nostri gelati artigianali. Possibilità di ordinare per telefono. Menu disponibili sul sito: www.duselausucre.fr"
    ],
    "fr": [
      "Ici tout est à emporter : pizzas, paninis, bagels, kebabs, sandwiches, pâtes, crêpes, gaufres... et pour l'été nos glaces artisanales. Commandes possibles par téléphone. Menus disponibles sur le site www.duselausucre.fr"
    ],
    "nl": [
      "Hier kun je van alles afhalen: pizza's, panini's, bagels, kebab, sandwiches, pasta, crêpes, wafels... en voor de zomer onze huisgemaakte ijsjes. Bestellingen kunnen telefonisch worden doorgegeven. Menu's beschikbaar op www.duselausucre.fr"
    ],
    "es": [
      "Aquí se puede llevar de todo: pizzas, paninis, bagels, kebabs, sándwiches, pasta, crêpes, gofres... y para el verano nuestros helados caseros. Los pedidos se pueden hacer por teléfono. Menús disponibles en www.duselausucre.fr"
    ]
  },
