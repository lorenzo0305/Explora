  "rdfs:comment": {
    "de": [
      "Das Restaurant l'Impasse bietet Ihnen eine einfache und innovative Küche, die auf frischen, vor Ort zubereiteten Produkten basiert. Das Restaurant beherbergt ein Konditoreiatelier, das eine große Auswahl an Kuchen anbietet. Das Restaurant verfügt außerdem über eine gemütliche Terrasse."
    ],
    "en": [
      "The restaurant l'Impasse offers you a simple and innovative cuisine, based on fresh products, cooked on the spot. The restaurant has a pastry shop that offers a wide range of cakes. The restaurant also has a pleasant terrace."
    ],
    "it": [
      "Il ristorante l'Impasse offre una cucina semplice e innovativa, basata su prodotti freschi, cucinati in loco. Il ristorante dispone di una pasticceria che offre una vasta gamma di dolci. Il ristorante dispone anche di una piacevole terrazza."
    ],
    "fr": [
      "Le restaurant l'Impasse vous propose une cuisine simple et innovante, à base de produits frais, cuisinés sur place. Le restaurant abrite un atelier pâtisserie qui propose une large gamme de gâteaux. Le restaurant est aussi doté d’une terrasse agréable."
    ],
    "nl": [
      "Het restaurant l'Impasse biedt eenvoudige en innovatieve gerechten op basis van verse producten, die ter plaatse worden bereid. Het restaurant heeft een banketbakkerij die een breed scala aan gebak aanbiedt. Het restaurant heeft ook een aangenaam terras."
    ],
    "es": [
      "El restaurante l'Impasse ofrece una cocina sencilla e innovadora, basada en productos frescos, cocinados in situ. El restaurante cuenta con una pastelería que ofrece una amplia gama de pasteles. El restaurante también cuenta con una agradable terraza."
    ]
  },
