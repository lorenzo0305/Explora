  "rdfs:comment": {
    "de": [
      "Das Restaurant Ibis Kitchen im Hotel Ibis Centre im Herzen von Le Puy-en-Velay bietet Ihnen einen einzigartigen Moment rund um die Gerichte, die mit den Produkten und Akteuren unserer Region zusammengestellt werden."
    ],
    "en": [
      "Discover our specialties, local menu, with our new chef and his home-made dishes"
    ],
    "it": [
      "Il ristorante Ibis Kitchen dell'hotel Ibis Centre, proprio nel cuore di Le Puy-en-Velay, vi offre un'opportunità unica di gustare piatti preparati con prodotti e ingredienti locali."
    ],
    "fr": [
      "Le restaurant Ibis Kitchen de l'hôtel Ibis Centre, en plein coeur du Puy-en-Velay, vous offre un moment unique autour des plats composés avec les produits et les acteurs de notre région."
    ],
    "nl": [
      "Het Ibis Kitchen restaurant in het Ibis Centre hotel, in het hart van Le Puy-en-Velay, biedt u een unieke gelegenheid om te genieten van gerechten gemaakt met lokale producten en ingrediënten."
    ],
    "es": [
      "El restaurante Ibis Kitchen del hotel Ibis Centre, en pleno centro de Le Puy-en-Velay, le ofrece una oportunidad única para degustar platos elaborados con productos e ingredientes locales."
    ]
  },
