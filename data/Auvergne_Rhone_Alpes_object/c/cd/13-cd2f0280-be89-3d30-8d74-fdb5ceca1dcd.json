  "rdfs:comment": {
    "de": [
      "Minigolf mit 18 Bahnen in einem schattigen Park, am Fuße des Casinos des Imperial Palace. Kostenlose Parkplätze in der Nähe. Snack, Bar, Eis. Verleih von Fahrrädern, Inlineskates, Kajaks, Paddles."
    ],
    "en": [
      "18-lane miniature golf course in a shady park, at the foot of the Casino de l'Impérial Palace, next to the beaches. Free parking nearby. Snack bar, bar, ice creams. Bicycle, rollerblade, kayak and paddle rentals."
    ],
    "it": [
      "Campo da minigolf a 18 corsie in un parco ombreggiato, ai piedi del Casinò Impérial Palace, vicino alle spiagge. Parcheggio gratuito nelle vicinanze. Snack bar, bar, gelati. Noleggio di biciclette, rollerblade, kayak e pedalò."
    ],
    "fr": [
      "Minigolf 18 pistes dans un parc ombragé, au pied du Casino de l'Impérial Palace, à côté des plages. Parkings gratuits à proximité. Snack, bar, glaces. Locations vélos, rollers, kayaks, Stand up paddles."
    ],
    "es": [
      "Minigolf de 18 carriles en un parque sombreado, al pie del Casino Impérial Palace, junto a las playas. Aparcamiento gratuito en las inmediaciones. Cafetería, bar, helados. Alquiler de bicicletas, patines, kayaks y stand-up paddles."
    ],
    "nl": [
      "Midgetgolfbaan met 18 banen in een schaduwrijk park, aan de voet van het Impérial Palace Casino, naast de stranden. Gratis parkeren in de buurt. Snackbar, bar, ijsjes. Verhuur van fietsen, skeelers, kajaks en stand-up paddles."
    ]
  },
