  "rdfs:comment": {
    "de": [
      "Chabal-Fitnessstudio (benannt nach dem ehemaligen dreifarbigen Rugbyspieler)\r\nDie 100 m2 große Sportplattform namens Sport Lib Duo wurde von Philippe Starck entworfen. Sie besteht aus 32 Übungen und kann zehn Personen gleichzeitig aufnehmen."
    ],
    "en": [
      "Chabal fitness structure (named after the former French rugby player)\r\nThe 100 m2 Sport Lib Duo fitness platform, designed by Philippe Starck, features 32 exercises and can accommodate ten people at a time."
    ],
    "it": [
      "Struttura fitness Chabal (dal nome dell'ex giocatore di rugby francese)\r\nLa piattaforma fitness Sport Lib Duo di 100 m2 , progettata da Philippe Starck, comprende 32 esercizi e può ospitare dieci persone alla volta."
    ],
    "fr": [
      "Structure de fitness Chabal (du nom de l’ex-rugbyman tricolore)\r\nSur 100 m2, cette plateforme sportive dénommée Sport Lib Duo, conçue par Philippe Starck, se compose de 32 exercices et peur accueillir dix personnes à la fois."
    ],
    "es": [
      "Estructura de fitness Chabal (nombre del ex jugador de rugby francés)\r\nLa plataforma de fitness Sport Lib Duo, de 100 m2 y diseñada por Philippe Starck, consta de 32 ejercicios y puede acoger a diez personas a la vez."
    ],
    "nl": [
      "Chabal fitnessstructuur (genoemd naar de voormalige Franse rugbyspeler)\r\nHet 100 m2 Sport Lib Duo fitnessplatform, ontworpen door Philippe Starck, omvat 32 oefeningen en biedt plaats aan tien personen tegelijk."
    ]
  },
