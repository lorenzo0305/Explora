  "rdfs:comment": {
    "de": [
      "Abends, ab Mittwoch, verwandelt sich La Frégate in eine Rum- und Tapas-Bar mit exotischem Ambiente! Entdecken Sie eine Auswahl an hochwertigen Rums, kreativen Cocktails, Bieren und Weinen, die zu Ihren Tapas passen."
    ],
    "en": [
      "From Wednesday evening, La Frégate transforms itself into an exotic rum and tapas bar! Discover a selection of quality rums, creative cocktails, beers and wines to accompany your tapas."
    ],
    "it": [
      "Dal mercoledì sera, La Frégate si trasforma in un esotico rum e tapas bar! Scoprite una selezione di rum di qualità, cocktail creativi, birre e vini da accompagnare alle vostre tapas."
    ],
    "fr": [
      "En soirée, à partir de mercredi, La Frégate se transforme en bar à rhum et tapas aux ambiances exotiques ! Découvrez une sélection de rhums de qualités, de cocktails créatifs, de bières et de vins pour accompagner vos tapas."
    ],
    "nl": [
      "Vanaf woensdagavond wordt La Frégate omgetoverd tot een exotische rum- en tapasbar! Ontdek een selectie kwaliteitsrums, creatieve cocktails, bieren en wijnen voor bij je tapas."
    ],
    "es": [
      "A partir del miércoles por la noche, La Frégate se transforma en un exótico bar de ron y tapas Descubra una selección de rones de calidad, cócteles creativos, cervezas y vinos para acompañar sus tapas."
    ]
  },
