  "rdfs:comment": {
    "de": [
      "Im Herzen der mittelalterlichen Stadt Crémieu bietet das Restaurant La Batisse eine kreative und traditionelle Küche, die aus frischen und lokalen Produkten zubereitet wird. Ein geselliger Tisch, ideal für eine Schlemmerpause nur wenige Schritte vom historischen Zentrum entfernt."
    ],
    "en": [
      "In the heart of the medieval town of Crémieu, La Batisse restaurant offers creative and traditional cuisine made from fresh, local produce. A friendly place to eat, ideal for a gourmet break just a stone's throw from the historic centre."
    ],
    "it": [
      "Nel cuore della città medievale di Crémieu, il ristorante La Batisse offre una cucina creativa e tradizionale, utilizzando prodotti freschi locali. Un ristorante accogliente, ideale per una pausa gourmet a due passi dal centro storico."
    ],
    "fr": [
      "Au cœur de la cité médiévale de Crémieu, le restaurant La Batisse propose une cuisine créative et traditionnelle, élaborée à partir de produits frais et locaux. Une table conviviale, idéale pour une pause gourmande à deux pas du centre historique."
    ],
    "nl": [
      "In het hart van de middeleeuwse stad Crémieu biedt restaurant La Batisse een creatieve en traditionele keuken met verse streekproducten. Een gezellig restaurant, ideaal voor een gastronomische pauze op een steenworp afstand van het historische centrum."
    ],
    "es": [
      "En el corazón de la ciudad medieval de Crémieu, el restaurante La Batisse le propone una cocina creativa y tradicional, elaborada con productos frescos de la región. Un restaurante acogedor, ideal para una escapada gastronómica a dos pasos del centro histórico."
    ]
  },
