  "rdfs:comment": {
    "de": [
      "Entdecken Sie diese 187 km lange Gravel-Strecke. Die Strecke verläuft über 30,4 km Straßen und 3,9 km Waldwege. Der Gesamtanstieg beträgt mehr als 5930 m. Die Strecke ist sehr anspruchsvoll."
    ],
    "en": [
      "Discover this 187 km Gravel course. The route comprises 30.4 km of roads and 3.9 km of forest tracks. The total ascent is over 5930m."
    ],
    "it": [
      "Scoprite questo percorso sterrato di 187 km. Il percorso comprende 30,4 km di strade e 3,9 km di sentieri forestali. L'ascesa totale è di oltre 5930 metri."
    ],
    "fr": [
      "Découvrez ce parcours de Gravel de 187 km. Ce parcours emprunte 30,4 km de routes et 3,9 km de pistes forestières. Il présente une ascension cumulée de plus de 5930m."
    ],
    "nl": [
      "Ontdek dit 187 km lange gravelparcours. De route bestaat uit 30,4 km wegen en 3,9 km bospaden. Het heeft een totale stijging van meer dan 5930m."
    ],
    "es": [
      "Descubra este recorrido de grava de 187 km. El recorrido comprende 30,4 km de carreteras y 3,9 km de pistas forestales. Tiene un ascenso total de más de 5930 m."
    ]
  },
