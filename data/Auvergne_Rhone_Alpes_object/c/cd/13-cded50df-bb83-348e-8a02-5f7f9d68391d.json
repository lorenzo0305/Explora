  "rdfs:comment": {
    "de": [
      "4 km südlich von Montélimar (Ausfahrt 18 auf der A7). Marion & Romain werden Sie herzlich willkommen heissen und während Ihres Urlaubs auf dem Weg in die Ferien für Ihren Komfort sorgen."
    ],
    "en": [
      "Only 4km from Montélimar, for business or pleasure, Marion & Romain welcome you to convivial and warm surroundings. 16 air-conditioned room (private bathrooms and WC), telephone, digital TV LCD and free Wi-Fi connection."
    ],
    "it": [
      "4 km a sud di Montélimar (uscita 18 della A7). Marion e Romain vi daranno un caloroso benvenuto e si occuperanno del vostro comfort mentre siete in viaggio per le vostre vacanze."
    ],
    "fr": [
      "A 4 km au sud de Montélimar (sortie 18 sur l'A7). Marion et Romain vous accueilleront chaleureusement et veilleront à votre confort pendant votre séjour sur la route de vos vacances."
    ],
    "nl": [
      "Op 4 km ten zuiden van Montélimar (afrit 18 van de A7) wordt u hartelijk welkom geheten door  Marion & Romain van harte, die ook toezien op uw comfort tijdens uw overnachting op weg naar uw vakantiebestemming."
    ],
    "es": [
      "A 4 km al sur de Montélimar (salida 18 de la A7). Marion y Romain le darán una cálida bienvenida y velarán por su comodidad durante sus vacaciones."
    ]
  },
