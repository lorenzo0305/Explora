  "rdfs:comment": {
    "de": [
      "Im Zig Zag Café haben wir uns einen Ort vorgestellt, an dem man eine Pause einlegen, sich treffen und einfache Momente in einer warmen und behaglichen Atmosphäre genießen kann."
    ],
    "en": [
      "At Zig Zag Café, we have imagined a place where you can take a break, meet up and enjoy simple moments in a warm and comforting atmosphere."
    ],
    "it": [
      "Allo Zig Zag Café abbiamo immaginato un luogo dove le persone possono fare una pausa, incontrarsi e godersi momenti semplici in un'atmosfera calda e confortevole."
    ],
    "fr": [
      "Au Zig Zag Café, nous avons imaginé un lieu où l'on peut faire une pause, se retrouver et savourer des moments simples dans une ambiance chaleureuse et réconfortante."
    ],
    "es": [
      "En Zig Zag Café, hemos imaginado un lugar donde la gente pueda tomarse un respiro, reunirse y disfrutar de momentos sencillos en un ambiente cálido y reconfortante."
    ],
    "nl": [
      "Bij Zig Zag Café hebben we een plek gecreëerd waar je even kunt pauzeren, afspreken en genieten van de kleine dingen in een warme en gezellige sfeer."
    ]
  },
