  "rdfs:comment": {
    "de": [
      "Verwöhnen Sie Ihren Gaumen mit kreativen Gerichten, die aus frischen, respektvoll verarbeiteten Produkten zubereitet werden, in einer modernen und entspannenden Umgebung. Unsere Karte ist von der Provence inspiriert und entwickelt sich mit den Jahreszeiten.\r\nGault & Millau, Ecotable, Slow Food"
    ],
    "en": [
      "Give your taste buds a treat with the delicious and creative dishes prepared with fresh products in a modern and relaxing setting. Our menu is inspired by Provence and changes with the seasons. \r\nGault & Millau, Ecotable, Slow-Food"
    ],
    "it": [
      "Concedete alle vostre papille gustative piatti creativi preparati con prodotti freschi trattati con rispetto in un ambiente moderno e rilassante. Il nostro menu di ispirazione provenzale si evolve con le stagioni\r\nGault & Millau, Ecotable, Slow Food"
    ],
    "fr": [
      "Régalez vos papilles avec des plats créatifs préparés avec des produits frais traités avec respect dans un cadre moderne et relaxant. D'inspiration provençale, notre carte évolue au fil des saisons. \r\nGault & Millau, Ecotable, Slow Food"
    ],
    "nl": [
      "Trakteer uw smaakpapillen op creatieve gerechten, bereid met verse producten en geserveerd in een zaal met moderne inrichting en ontspannen sfeer. Lunchmenu. Seizoensmenu's. Gault & Millau, Ecotable, Slow-Food"
    ],
    "es": [
      "Deleite su paladar con platos creativos preparados con productos frescos tratados con respeto en un entorno moderno y relajante. Nuestro menú de inspiración provenzal evoluciona con las estaciones\r\nGault & Millau, Ecotable, Slow Food"
    ]
  },
  "rdfs:label": {
    "en": [
      "D'un Goût à l'Autre restaurant"
    ],
    "fr": [
      "D'un goût à l'autre"
    ],
    "nl": [
      "D'un goût à l'autre"
    ]
  },
