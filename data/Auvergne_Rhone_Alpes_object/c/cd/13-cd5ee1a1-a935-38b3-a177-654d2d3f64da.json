  "rdfs:comment": {
    "de": [
      "Zentrum für Balneotherapie mit Schwimmbecken (Becken mit Hydro-Massagedüsen, Gegenschwimmanlage, Wasserfall, Blower), Sauna und Hammam. Verschiedene Wellnessangebote: Massagen, Sprudelbad, Jet-Duschen, Peelings, Körperpackungen, Gesichtspflege."
    ],
    "en": [
      "Balneotherapy center with balneo circuit: active swimming pool, sauna, hammam and balneo packages (massages, exfoliation, bubbling bath…). Cares provided with essential oils."
    ],
    "it": [
      "Centro di balneoterapia con circuito balneo: piscina attiva, sauna, hammam e pacchetti balneo: massaggi, gommage, idromassaggio... Questi trattamenti sono a base di oli essenziali."
    ],
    "fr": [
      "Centre de balnéothérapie avec circuit balnéo : pisicine active, sauna, hammam et forfaits balnéo : massages, gommage, bain bouillonnant... Ces soins sont prodigués à base d'huiles essentielles."
    ],
    "es": [
      "Centro de balneoterapia con circuito de balneoterapia: piscina activa, sauna, hammam y paquetes de balneoterapia: masajes, exfoliación, bañera de hidromasaje... Estos tratamientos se basan en aceites esenciales."
    ],
    "nl": [
      "Balneotherapiecentrum met balneocircuit: actief zwembad, sauna, hammam en balneo-arrangementen: massages, scrubben, bubbelbad... Deze behandelingen zijn gebaseerd op essentiële oliën."
    ]
  },
