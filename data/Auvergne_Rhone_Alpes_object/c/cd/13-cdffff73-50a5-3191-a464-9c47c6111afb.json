  "rdfs:comment": {
    "de": [
      "Das Kunstzentrum La Halle empfängt Sie in einem Raum, der über dem Fluss schwebt. Hier können Sie regelmäßig wechselnde Ausstellungen entdecken.\r\nBegleiten Sie uns bei einem Besuch, einem Treffen oder einem Workshop!"
    ],
    "en": [
      "The La Halle art center welcomes you to a space suspended above the river. Here, you'll discover regularly renewed exhibitions.\r\nJoin us for a visit, a meeting or a workshop!"
    ],
    "it": [
      "Il centro d'arte La Halle vi accoglie in uno spazio sospeso sul fiume. Qui scoprirete mostre che cambiano regolarmente.\r\nUnitevi a noi per una visita, un incontro o un workshop!"
    ],
    "fr": [
      "Le centre d'art la Halle vous accueille dans un espace suspendu au-dessus de la rivière. Ici, vous découvrirez des expositions renouvelées régulièrement. \r\nRejoignez-nous le temps d'une visite, d'une rencontre ou d'un atelier !"
    ],
    "nl": [
      "Het kunstcentrum La Halle verwelkomt je in een ruimte die boven de rivier hangt. Hier ontdek je regelmatig wisselende tentoonstellingen.\r\nKom langs voor een bezoek, een vergadering of een workshop!"
    ],
    "es": [
      "El centro de arte La Halle le da la bienvenida a un espacio suspendido sobre el río. Aquí descubrirá exposiciones que cambian regularmente.\r\nÚnase a nosotros para una visita, una reunión o un taller"
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Halle, Centre d'art"
    ]
  },
