  "rdfs:comment": {
    "de": [
      "Im Winter in der Veranda und im Sommer auf der Terrasse im Schatten zweihundertjähriger Bäume mit Blick auf die Hügel: Hier empfangen Sie Daniel und Sophie Jerez, mit ihrem Tierpark als Kulisse."
    ],
    "en": [
      "In winter on the veranda and in summer on the terrace in the shade of two-hundred-year-old trees overlooking the hills, this is where Daniel and Sophie Jerez welcome you, with their wildlife park as a backdrop."
    ],
    "it": [
      "In inverno nella veranda e in estate sulla terrazza all'ombra di alberi bicentenari con vista sulle colline, è qui che Daniel e Sophie Jerez vi accolgono, con il loro parco faunistico come sfondo."
    ],
    "fr": [
      "L'hiver dans la véranda et l'été sur la terrasse à l'ombre des arbres bicentenaires avec vue sur les collines, c'est là que Daniel et Sophie Jerez vous reçoivent, avec leur parc animalier pour décor."
    ],
    "nl": [
      "In de winter in de veranda en in de zomer op het terras in de schaduw van tweehonderd jaar oude bomen met uitzicht op de heuvels, dit is waar Daniel en Sophie Jerez je verwelkomen, met hun wildpark als achtergrond."
    ],
    "es": [
      "En invierno en la veranda y en verano en la terraza a la sombra de árboles bicentenarios con vistas a las colinas, aquí es donde Daniel y Sophie Jerez le dan la bienvenida, con su parque de vida salvaje como telón de fondo."
    ]
  },
  "rdfs:label": {
