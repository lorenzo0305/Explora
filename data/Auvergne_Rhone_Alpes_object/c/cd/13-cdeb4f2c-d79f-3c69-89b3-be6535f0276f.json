  "rdfs:comment": {
    "de": [
      "Die Hostellerie du Centrotel et Spa verfügt über eine eigene Aktivität \"Spa und Modelage Bien-Etre\", die das ganze Jahr über an sieben Tagen in der Woche von 7:30 bis 20:00 Uhr geöffnet ist: ein Moment der Ruhe und des Wohlbefindens in einem idyllischen Rahmen!"
    ],
    "en": [
      "The Hostellerie du Centrotel et Spa has a fully-fledged \"Spa and Well-Being Modelage\" activity, open all year round, 7 days a week from 7:30 a.m. to 8 p.m.: a moment of tranquillity and well-being, in an idyllic setting!"
    ],
    "it": [
      "L'Hostellerie du Centrotel et Spa ha una propria attività di \"Modellazione Spa e Benessere\", aperta tutto l'anno, 7 giorni su 7, dalle 7.30 alle 20.00: un momento di tranquillità e benessere in un ambiente idilliaco!"
    ],
    "fr": [
      "L’Hostellerie du Centrotel et Spa dispose d’une activité à part entière « Spa et Modelage Bien-Etre », ouverte toute l’année, 7j/7 de 7h30 à 20h : un moment de tranquillité et de bien-être, dans un cadre idyllique !"
    ],
    "es": [
      "La Hostellerie du Centrotel et Spa dispone de su propia actividad \"Modelado Spa y Bienestar\", abierta todo el año, los 7 días de la semana de 7.30 a 20.00: ¡un momento de tranquilidad y bienestar en un entorno idílico!"
    ],
    "nl": [
      "Het Hostellerie du Centrotel et Spa heeft zijn eigen activiteit \"Kuur- en wellnessmodellering\", het hele jaar door, 7 dagen per week van 7.30 tot 20.00 uur: een moment van rust en welzijn in een idyllische omgeving!"
    ]
  },
