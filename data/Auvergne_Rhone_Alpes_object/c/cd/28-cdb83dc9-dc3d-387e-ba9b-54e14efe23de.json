  "rdfs:comment": {
    "de": [
      "Für einen sauberen Strand!\nMülltriathlon: Laufen, sammeln, wiegen!\n\nVerleihung von recycelten Medaillen am Ende des Sammelns.\nMaterialien werden bereitgestellt."
    ],
    "en": [
      "For a clean beach!\nWaste triathlon: walk, collect, weigh!\n\nRecycled medals awarded at end of collection.\nEquipment provided."
    ],
    "it": [
      "Per una spiaggia pulita!\nTriathlon dei rifiuti: camminare, raccogliere, pesare!\n\nMedaglie riciclate assegnate al termine della raccolta.\nAttrezzatura fornita."
    ],
    "fr": [
      "Pour une plage propre !\nTriathlon des déchets : marcher, ramasser, peser !\n\nRemise de médailles recyclées à la fin du ramassage.\nMatériels fournis."
    ],
    "es": [
      "¡Por una playa limpia!\nTriatlón de residuos: ¡caminar, recoger, pesar!\n\nEntrega de medallas recicladas al final de la recogida.\nMaterial proporcionado."
    ],
    "nl": [
      "Voor een schoon strand!\nAfval triatlon: lopen, verzamelen, wegen!\n\nGerecyclede medailles uitgereikt aan het einde van de inzameling.\nMateriaal aanwezig."
    ]
  },
