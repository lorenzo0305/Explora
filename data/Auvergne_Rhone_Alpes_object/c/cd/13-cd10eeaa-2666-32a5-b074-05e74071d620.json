  "rdfs:comment": {
    "de": [
      "Der Verein « Les lacs du Maroly » bietet den ganzen Sommer Angelaktivitäten am See \"Lac de la Cour\" an. Hochkarätiges Fischangebot mit regelmäßiger Aussetzung von Regenbogenforellen."
    ],
    "en": [
      "The association « Les lacs du Maroly » offers during summer, a fishing activity in Lake La Cour. Attractive fishing as rainbow and fario trouts are regularly released."
    ],
    "it": [
      "L'associazione \"Les lacs du Maroly\" offre per tutta l'estate un'attività di pesca sul lago di La Cour. Pesca interessante con rilascio regolare di trote iridee e fario."
    ],
    "fr": [
      "L’association « Les lacs du Maroly » propose tout l’été une activité pêche sur le lac de La Cour. Pêche attractive avec lâché régulier de truites arc en ciel et fario."
    ],
    "es": [
      "Pesca atractiva con liberación regular de truchas."
    ],
    "nl": [
      "De vereniging \"Les lacs du Maroly\" biedt de hele zomer een visactiviteit aan op het meer van La Cour. Aantrekkelijk vissen met regelmatige uitzetting van regenboog- en fario-forel."
    ]
  },
  "rdfs:label": {
