  "rdfs:comment": {
    "de": [
      "Ardes ist die Brücke zwischen den goldenen Ebenen des Lembron und den Graslandschaften der vulkanischen Hochebenen des Cézallier. Die ehemalige Hauptstadt des Herzogtums Mercoeur erhebt ihre Häuser terrassenförmig über eine bewaldete Schlucht, die von der Couze (Fluss) von Ardes gebildet wird."
    ],
    "en": [
      "From St Germain-Lembron, follow the mountain route. Ardes is at 12 km away on the edge of a valley. To visit : in the lower part of the town is the church, and in upper part of the town is the main street, further on from there is the zoo."
    ],
    "it": [
      "Ardes è la porta tra le pianure dorate del Lembron e le praterie degli altopiani vulcanici del Cézallier. L'ex capitale del Ducato di Mercoeur ha case a schiera sopra una gola boscosa formata dal couze (fiume) di Ardes."
    ],
    "fr": [
      "Ardes est la passerelle entre les plaines dorées du Lembron et les herbages des plateaux volcaniques du Cézallier. L'ancienne capitale du duché de Mercoeur étage ses maisons en terrasses au-dessus d'une gorge boisée formée par la couze (rivière) d'Ardes."
    ],
    "nl": [
      "Ardes is de poort tussen de gouden vlaktes van de Lembron en de graslanden van de vulkanische plateaus van Cézallier. De voormalige hoofdstad van het hertogdom Mercoeur heeft rijtjeshuizen boven een beboste kloof gevormd door de couze (rivier) van de Ardes."
    ],
    "es": [
      "Ardes es la puerta entre las llanuras doradas del Lembron y las praderas de las mesetas volcánicas de Cézallier. La antigua capital del ducado de Mercoeur tiene casas adosadas sobre un desfiladero boscoso formado por el couze (río) de Ardes."
    ]
  },
  "rdfs:label": {
    "en": [
      "The village of Ardes"
    ],
    "fr": [
      "Village d'Ardes"
    ]
  },
