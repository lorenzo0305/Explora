  "rdfs:comment": {
    "de": [
      "Vincent empfängt Sie in einem einzigartigen Raum, der dem Loslassen und der Entspannung gewidmet ist. Kalifornische, Hot-Stone-, Drainage-, Ayurveda-Ancestral-, Fuß- und Gesichtsreflexzonenmassage oder eine von Vincent erdachte Massage von 2 Stunden Dauer."
    ],
    "en": [
      "Vincent welcomes you to a unique space dedicated to letting go and relaxation. Californian, hot stone, draining, Ayurvedic Ancestral, foot and facial reflexology, or Vincent's own 2-hour massage."
    ],
    "it": [
      "Vincent vi accoglie in uno spazio unico, dedicato al lasciarsi andare e al relax. Massaggio californiano, hot stone, drenante, ayurvedico ancestrale, riflessologia plantare e facciale, o massaggio immaginato da Vincent per 2 ore."
    ],
    "fr": [
      "Vincent vous accueil dans un espace unique, dédié au lâcher-prise et à la relaxation. Californien, pierres chaudes, drainant, Ayurvédique Ancestral, réflexologie plantaire et facial, ou massage imaginé par Vincent de 2H."
    ],
    "es": [
      "Vincent le acoge en un espacio único, dedicado a la relajación y al abandono. Californiano, piedras calientes, drenaje, ancestral ayurvédico, reflexología podal y facial, o masaje imaginado por Vincent durante 2 horas."
    ],
    "nl": [
      "Vincent heet je welkom in een unieke ruimte gewijd aan loslaten en ontspanning. Californische, hot stone, drainerende, voorouderlijke Ayurvedische, voet- en gezichtsreflexologie, of een 2-uur durende massage bedacht door Vincent."
    ]
  },
  "rdfs:label": {
    "fr": [
      "A fleurs de peau"
    ]
  },
