  "rdfs:comment": {
    "de": [
      "Eine traditionelle Küche mit verschiedenen Gerichten, bei denen die Produkte der Region im Vordergrund stehen. Sie werden in einem geräumigen und malerischen Saal oder auf der Terrasse mit Blick auf den See von Samognat genossen."
    ],
    "en": [
      "Family mood, regional cooking with fresh products, quiet and situated along the riverside."
    ],
    "it": [
      "Nel cuore della regione Haut-Bugey, l'hotel-ristorante Au Moulin du Pont vi accoglie in un ambiente caldo e autentico sulle rive del lago Val d'Oignin.\r\nIl ristorante ha ottenuto il marchio Table remarquable Saveurs de l'Ain."
    ],
    "fr": [
      "Au cœur du Haut-Bugey, l'hôtel-restaurant Au Moulin du Pont vous accueille dans un cadre authentique et chaleureux, au bord du lac du Val d'Oignin.\r\nLe restaurant est labellisé Table remarquable Saveurs de l'Ain."
    ],
    "nl": [
      "In het hart van de Haut-Bugey heet hotel-restaurant Au Moulin du Pont je welkom in een warme, authentieke omgeving aan de oevers van het meer van Val d'Oignin.\r\nHet restaurant is bekroond met het label Table remarquable Saveurs de l'Ain."
    ],
    "es": [
      "En el corazón de la región de Haut-Bugey, el hotel-restaurante Au Moulin du Pont le da la bienvenida en un entorno cálido y auténtico a orillas del lago Val d'Oignin.\r\nEl restaurante ha sido galardonado con la etiqueta Table remarquable Saveurs de l'Ain."
    ]
  },
