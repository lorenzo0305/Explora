  "rdfs:comment": {
    "de": [
      "Als Freiluftrestaurant und Cocktailbar ist La Crique ein Muss am Ufer des Lac d'Aiguebelette. In einer geselligen Atmosphäre lassen Sie sich auf der schattigen Terrasse nieder, von der aus Sie einen herrlichen Blick auf den See und die Berge über ihm haben."
    ],
    "en": [
      "An open-air restaurant and cocktail bar, a must-visit spot by the shores of Lake Aiguebelette. In a warm and friendly atmosphere, settle in on the shaded terrace and enjoy the incredible view of the lake and the towering mountains."
    ],
    "it": [
      "Ristorante e cocktail bar all'aperto, La Crique è una tappa obbligata sulle rive del lago di Aiguebelette. In un'atmosfera amichevole, sedetevi sulla terrazza ombreggiata, con una vista mozzafiato sul lago e sulle montagne sovrastanti."
    ],
    "fr": [
      "Restaurant de plein air et bar à cocktails, La Crique est un lieu incontournable au bord du lac d’Aiguebelette. Dans une atmosphère conviviale, installez-vous sur la terrasse ombragée, avec une vue imprenable sur le lac et la montagne qui le surplombe."
    ],
    "es": [
      "Restaurante al aire libre y bar de cócteles, La Crique es una visita obligada a orillas del lago de Aiguebelette. En un ambiente acogedor, siéntese en la terraza a la sombra, con una vista impresionante del lago y las montañas que lo dominan."
    ],
    "nl": [
      "La Crique is een openluchtrestaurant en cocktailbar aan de oevers van het meer van Aiguebelette. Ga in een gezellige sfeer zitten op het schaduwrijke terras, met een adembenemend uitzicht op het meer en de bergen erboven."
    ]
  },
  "rdfs:label": {
    "en": [
      "La Crique · Outdoor restaurant"
    ],
    "fr": [
      "La Crique · Restaurant de plein air"
    ]
  },
