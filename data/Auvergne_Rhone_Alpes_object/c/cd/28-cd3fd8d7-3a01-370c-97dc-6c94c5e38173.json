  "rdfs:comment": {
    "de": [
      "Handwerkliche Herstellung von einzigartigem, originellem Schmuck, der vollständig von Hand gefertigt wird, mit Kupfer-, Silber- und Aluminiumdraht und hochwertigen handgefertigten Perlen oder Edelsteinen (Halbedelsteinen)."
    ],
    "en": [
      "Handcrafted creation of unique, original jewelry, entirely handmade, with copper, silver and aluminum wire and high-quality artisan pearls or semi-precious stones."
    ],
    "it": [
      "Creazione artigianale di gioielli unici e originali, interamente fatti a mano, utilizzando fili di rame, argento e alluminio e perle o pietre semipreziose artigianali di alta qualità."
    ],
    "fr": [
      "Création artisanale de bijoux uniques, originaux, entièrement réalisés à la main, avec du fil de cuivre, d'argent et d'aluminium et des perles artisanales de grande qualité ou pierres fines (semi-précieuses)."
    ],
    "es": [
      "Creación artesanal de joyas únicas y originales, totalmente hechas a mano, con alambre de cobre, plata y aluminio y perlas o piedras semipreciosas artesanales de alta calidad."
    ],
    "nl": [
      "Ambachtelijke creatie van unieke, originele sieraden, volledig met de hand gemaakt, met koper-, zilver- en aluminiumdraad en hoogwaardige ambachtelijke parels of halfedelstenen."
    ]
  },
