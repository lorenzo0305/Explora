  "rdfs:comment": {
    "de": [
      "Wunderschöne Klippe in einer wunderschönen Umgebung. Das Lesen ist schwierig, die Platten sind super und die Überhänge schwierig. Die Routen sind im Allgemeinen recht kurz."
    ],
    "en": [
      "Superb cliff in a beautiful setting. The reading is difficult, the slabs are superb and the overhangs difficult. The routes are generally quite short."
    ],
    "it": [
      "Una falesia superba in un ambiente magnifico. La lettura è difficile, le placche sono superbe e gli strapiombi difficili. Le vie sono generalmente piuttosto brevi."
    ],
    "fr": [
      "Superbe falaise dans un cadre magnifique. La lecture est difficile, les dalles sont superbes et les surplombs difficiles. Les voies sont d'une manière générale assez courtes."
    ],
    "es": [
      "Un acantilado soberbio en un entorno magnífico. La lectura es difícil, las losas son soberbias y los desplomes difíciles. Las rutas suelen ser bastante cortas."
    ],
    "nl": [
      "Een prachtige klif in een schitterende omgeving. Het lezen is moeilijk, de platen zijn prachtig en de overhangen moeilijk. De routes zijn over het algemeen vrij kort."
    ]
  },
  "rdfs:label": {
