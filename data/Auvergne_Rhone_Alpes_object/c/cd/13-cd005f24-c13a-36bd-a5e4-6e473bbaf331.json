  "rdfs:comment": {
    "de": [
      "Willkommen im Relais Cyné in Ville sur Anjou. Wir können Sie für die Dauer eines Picknicks begrüßen.\r\nEin Picknicktisch, eine Anbindestange für Pferde, ein Unterstand und ein Parkplatz stehen Ihnen zur Verfügung."
    ],
    "en": [
      "Welcome to Relais Cyné de Ville sur Anjou. We can welcome you for a picnic.\r\nPicnic table, horse tie-up bar, shelter and parking are at your disposal."
    ],
    "it": [
      "Benvenuti al Relais Cyné di Ville sur Anjou. Possiamo ospitarvi per un picnic.\r\nAbbiamo un tavolo da picnic, una barra per legare i cavalli, una tettoia e un parcheggio."
    ],
    "fr": [
      "Bienvenue au Relais Cyné de Ville sur Anjou. Nous pouvons vous accueillir le temps d'un pique nique.\r\nTable de pique-nique, barre d’attache pour chevaux, abri et parking sont mis à votre disposition."
    ],
    "nl": [
      "Welkom bij Relais Cyné in Ville sur Anjou. Bij ons kun je terecht voor een picknick.\r\nWe hebben een picknicktafel, een tui voor paarden, een schuilhut en een parkeerplaats."
    ],
    "es": [
      "Bienvenido al Relais Cyné en Ville sur Anjou. Podemos acogerle para un picnic.\r\nDisponemos de una mesa de picnic, una barra de amarre para caballos, un refugio y un aparcamiento."
    ]
  },
  "rdfs:label": {
