  "rdfs:comment": {
    "de": [
      "Der pädagogische Bauernhof von Vercors\r\nBietet Ihnen nach vorheriger Anmeldung geführte Besichtigungen des Bauernhofs im Kontakt mit den Tieren an.\r\nAngoraziegen, Kaninchen, Schlittenhunde, Esel, Hühner, verschiedenes Geflügel und Vorführung des Wollspinnens."
    ],
    "en": [
      "The Vercors Educational Farm\r\nGuided tours of the farm with animals, by reservation.\r\nAngora goats, rabbits, sled dogs, donkeys, chickens, poultry and wool spinning demonstrations."
    ],
    "it": [
      "La fattoria didattica del Vercors\r\nVisite guidate alla fattoria con gli animali, su prenotazione.\r\nCapre d'angora, conigli, cani da slitta, asini, galline, pollame vario e dimostrazione di filatura della lana."
    ],
    "fr": [
      "La Ferme pédagogique du Vercors \r\nVous propose des visites guidées de la ferme au contact des animaux, sur réservation.\r\nChèvres Angora, lapins, chiens de traîneau, ânes,  poules, volaille diverses et démonstration du filage de la laine."
    ],
    "es": [
      "La granja pedagógica de Vercors\r\nVisitas guiadas a la granja con los animales, previa concertación.\r\nCabras de angora, conejos, perros de trineo, burros, gallinas, aves diversas y demostración de hilado de lana."
    ],
    "nl": [
      "De educatieve boerderij in de Vercors\r\nRondleidingen op de boerderij met de dieren, op afspraak.\r\nAngorageiten, konijnen, sledehonden, ezels, kippen, divers pluimvee en demonstratie wol spinnen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ferme pédagogique du Vercors"
    ]
  },
