  "rdfs:comment": {
    "de": [
      "Selectour Génération Voyages und seine Marke GVMICE sind für Sie da, wenn es um maßgeschneiderte Reisen für Einzelpersonen, Freunde oder die Familie sowie um Geschäftsveranstaltungen in Frankreich oder im Ausland geht."
    ],
    "en": [
      "Selectour Génération Voyages and its GVMICE brand are at your service for all your tailor-made travel needs for individuals, friends or family, as well as your business events in France or abroad."
    ],
    "it": [
      "Selectour Génération Voyages e il suo marchio GVMICE sono al vostro servizio per tutte le vostre esigenze di viaggio su misura per singoli, amici o familiari, nonché per i vostri eventi aziendali in Francia o all'estero."
    ],
    "fr": [
      "Selectour Génération Voyages et sa marque GVMICE sont à votre écoute pour toutes envies de voyages sur mesure pour individuel, entre amis ou en famille ainsi que vos événements professionnels en France ou à l'étranger."
    ],
    "es": [
      "Selectour Génération Voyages y su marca GVMICE están a su servicio para todas sus necesidades de viajes a medida para particulares, amigos o familia, así como para sus eventos de negocios en Francia o en el extranjero."
    ],
    "nl": [
      "Selectour Génération Voyages en haar merk GVMICE staan tot uw dienst voor al uw reizen op maat voor individuen, vrienden of familie, evenals uw zakelijke evenementen in Frankrijk of in het buitenland."
    ]
  },
