  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/4ace9b3b-1331-34c0-a975-5a6064b1ecfa",
      "dc:description": {
        "de": [
          "Ein Reitzentrum im Herzen von Le Crotoy, in dem Sie verschiedene Angebote finden werden: Kurse, Ausflüge, Fahrten mit dem Gespann, Kurse, Pferdepension. Reittiere: Pferde und Ponys."
        ],
        "en": [
          "An equestrian centre in the heart of Le Crotoy where you will find various formulas: training courses, trekking, carriage rides, lessons, horse boarding. Type of mounting: horses and ponies."
        ],
        "it": [
          "Un centro ippico nel cuore di Le Crotoy dove troverete varie formule: corsi, passeggiate, gite in carrozza, lezioni, pensione per cavalli. Tipo di cavallo: cavalli e pony."
        ],
        "fr": [
          "Un centre équestre au coeur du Crotoy dans lequel vous retrouverez diverses formules : stages, randonnées, promenades en attelage, cours, pension chevaux. Type de monture : chevaux et poneys."
        ],
        "es": [
          "Un centro ecuestre en el corazón de Le Crotoy donde encontrará diversas fórmulas: cursos, paseos, paseos en carruaje, clases, pupilaje. Tipo de caballo: caballos y ponis."
        ],
        "nl": [
          "Een manege in het hart van Le Crotoy waar u verschillende formules vindt: cursussen, ritten, koetsritten, lessen, paardenpension. Type paard: paarden en pony's."
        ]
      },
      "@type": [
        "Description"
