  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Kalligraphie mit der Dozentin Claire Moulas in einer ca. 1,5-stündigen Sitzung im MJC Robert Martin.\r\nDie Kurse finden alle zwei Wochen statt, d.h. 15 Kurse in der Saison 2025-2026. Begrenzte Teilnehmerzahl (max. 10 Personen)"
    ],
    "en": [
      "Come and discover calligraphy with Claire Moulas during a 1h30 session at MJC Robert Martin.\r\nSession every 15 days, i.e. 15 sessions for the 2025-2026 season. Places limited to 10 people max."
    ],
    "it": [
      "Venite a scoprire la calligrafia con Claire Moulas durante una sessione di circa 1h30 presso il MJC Robert Martin.\r\nSessioni ogni 15 giorni, cioè 15 sessioni per la stagione 2025-2026. Posti limitati a 10 persone al massimo."
    ],
    "fr": [
      "Venez découvrir la calligraphie avec l'intervenante Claire Moulas lors d'une séance de 1h30 environ à la MJC Robert Martin.\r\nSéance tous les 15 jours soit 15 séances pour la saison 2025-2026. Places limitées à 10 pers max."
    ],
    "es": [
      "Venga a descubrir la caligrafía con Claire Moulas durante una sesión de aproximadamente 1h30 en el MJC Robert Martin.\r\nSesiones cada 15 días, es decir, 15 sesiones para la temporada 2025-2026. Plazas limitadas a 10 personas máximo."
    ],
    "nl": [
      "Kom en ontdek kalligrafie met Claire Moulas tijdens een sessie van ongeveer 1u30 in het MJC Robert Martin.\r\nSessies om de 15 dagen, dus 15 sessies voor het seizoen 2025-2026. Plaatsen beperkt tot maximaal 10 personen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Séances de calligraphie avec Claire Moulas (ados-adultes)"
    ]
  },
