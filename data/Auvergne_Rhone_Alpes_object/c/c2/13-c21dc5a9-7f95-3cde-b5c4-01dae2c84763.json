  "rdfs:comment": {
    "de": [
      "Regenbogenforellen, Fario, Omble Chevalier, Cristivomer.  Marke \"Truites et Salmonidés du Vercors\".\r\nVerkauf von verarbeiteten Produkten: geräucherte Forellen, Forellenrillettes, Terrinen, Suppen, frische Filets."
    ],
    "en": [
      "Rainbow trout, Brown trout, Artic Char, Cristivomer. \"Truites et Salmonidés du Vercors\" label.  Sale of processed products: smoked trout, trout rillettes, terrines, soups, fresh fillets."
    ],
    "it": [
      "Allevatori di trote iridee, fario, salmerino alpino e Cristivomero.  Marchio \"Truites et Salmonidés du Vercors\".\r\nProdotti trasformati venduti nei mercati: trote affumicate, rillettes di trota, terrine, filetti freschi."
    ],
    "fr": [
      "Eleveurs de truites Arc-en-ciel, Fario, Omble Chevalier, Cristivomer.  Marque \"Truites et Salmonidés du Vercors\".\r\nVente de produits transformés sur les marchés : truites fumées, rillettes de truites, terrines, filets frais."
    ],
    "nl": [
      "Forel Arc-en-ciel, Fario, Omble Chevalier, Cristivomer.  Merk \"Truites et Samonidés du Vercors\".\r\nVerkoop van getransformeerde producten: gerookte forel, forelrillettes, terrines, soep, verse filets."
    ],
    "es": [
      "Criadores de truchas arco iris, fario, trucha ártica y trucha cristivomer.  Marca \"Truites et Salmonidés du Vercors\".\r\nProductos transformados vendidos en los mercados: trucha ahumada, rillettes de trucha, terrinas, filetes frescos."
    ]
  },
