  "rdfs:comment": {
    "de": [
      "Daniel und Murielle, die Besitzer der Ferme aux Fromages, verfügen über einen Picknickbereich im Freien und im Haus! Sandwiches, Getränke, Eis, Gebäck, Bauernsnacks zum Mitnehmen... Und die Möglichkeit, die Käserei zu besichtigen!"
    ],
    "en": [
      "Daniel and Murielle, owners of Ferme aux Fromages, have an outdoor and indoor picnic area! Sandwiches, drinks, ice creams, pastries, farm snacks to take away... And you can even visit the cheese dairy!"
    ],
    "it": [
      "Daniel e Murielle, proprietari de La Ferme aux Fromages, dispongono di un'area picnic all'aperto e al coperto! Panini, bevande, gelati, dolci, spuntini da asporto... E si può anche visitare il caseificio!"
    ],
    "fr": [
      "Daniel et Murielle, propriétaires de la Ferme aux Fromages, disposent d'une aire de pique-nique en extérieur et en intérieur ! Sandwiches, boissons, glaces, pâtisseries, casse-croûte fermier à emporter... Et possibilité de visiter la fromagerie !"
    ],
    "es": [
      "Daniel y Murielle, propietarios de La Ferme aux Fromages, disponen de un merendero exterior e interior Bocadillos, bebidas, helados, bollería, aperitivos de granja para llevar... E incluso se puede visitar la quesería"
    ],
    "nl": [
      "Daniel en Murielle, de eigenaars van La Ferme aux Fromages, hebben een picknickruimte buiten en binnen! Broodjes, drankjes, ijs, gebak, boerderijhapjes om mee te nemen... En je kunt zelfs de kaasmakerij bezoeken!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Petite restauration sur le GR65 | La ferme aux fromages"
    ]
  },
