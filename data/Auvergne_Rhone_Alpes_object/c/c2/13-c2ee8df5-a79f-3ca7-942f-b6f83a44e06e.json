  "rdfs:comment": {
    "de": [
      "Das Baraban Café ist ein Dorfbistro, das unter der Woche ein Tagesmenü nur mit Reservierung und freitags und samstags abends hausgemachte Pizzen (vor Ort oder zum Mitnehmen) anbietet."
    ],
    "en": [
      "The Baraban Café is a village bistro offering a daily menu during the week by reservation only, and homemade pizzas on Friday and Saturday evenings (eat-in or takeaway)."
    ],
    "it": [
      "Il Baraban Café è un bistrot del villaggio che serve un menù giornaliero durante la settimana (solo su prenotazione) e pizze fatte in casa il venerdì e il sabato sera (da mangiare o da portare via)."
    ],
    "fr": [
      "Le Baraban Café est un bistrot de village qui propose un menu du jour en semaine sur réservation uniquement et des pizzas maison le vendredi et samedi soir (sur place ou à emporter)."
    ],
    "nl": [
      "Het Baraban Café is een dorpsbistro waar doordeweeks een dagmenu wordt geserveerd (alleen op reservering) en op vrijdag- en zaterdagavond zelfgemaakte pizza's (om te eten of om mee te nemen)."
    ],
    "es": [
      "El Baraban Café es un bistró de pueblo que sirve un menú diario durante la semana (sólo con reserva) y pizzas caseras los viernes y sábados por la noche (para comer o llevar)."
    ]
  },
  "rdfs:label": {
