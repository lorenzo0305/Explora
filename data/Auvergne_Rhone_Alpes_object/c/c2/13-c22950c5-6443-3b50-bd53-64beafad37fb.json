  "rdfs:comment": {
    "de": [
      "DIE Überquerung des Grandes-Rousses-Massivs von Le Bourg-d?Oisans oder St Sorlin aus, vorbei am Fuße des Glacier de l'Etendard. Sie mögen Seen? Sie werden in der Nähe von 12 bemerkenswerten Seen vorbeikommen und ein Rundweg führt am Fuße des Pic de l'Etendard vorbei"
    ],
    "en": [
      "THE crossing of the Grandes Rousses massif from Le Bourg-d'Oisans or St Sorlin, passing at the foot of the Glacier de l'Etendard. Do you like lakes? You'll pass by 12 remarkable lakes and a loop passing at the foot of Pic de l'Etendard."
    ],
    "it": [
      "La traversata del massiccio delle Grandes Rousses da Le Bourg-d'Oisans o St Sorlin, passando ai piedi del Ghiacciaio dell'Etendard. Vi piacciono i laghi? Passerete vicino a 12 laghi notevoli e a un anello che passa ai piedi del Pic de l'Etendard"
    ],
    "fr": [
      "LA  traversée du massif des Grandes Rousses depuis le Bourg-d’Oisans ou St Sorlin, en passant au pied du Glacier de l’Etendard. Vous aimez les lacs ? Vous passerez à proximité de 12 lacs remarquables  et une boucle passant au pied du Pic de l’Etendard"
    ],
    "es": [
      "LA travesía del macizo de las Grandes Rousses desde Le Bourg-d'Oisans o St Sorlin, pasando al pie del Glaciar de l'Etendard. ¿Le gustan los lagos? Pasará cerca de 12 lagos notables y un bucle que pasa al pie del Pic de l'Etendard"
    ],
    "nl": [
      "DE oversteek van het Grandes Rousses massief vanuit Le Bourg-d'Oisans of St Sorlin, langs de voet van de Glacier de l'Etendard. Hou je van meren? Je komt langs 12 opmerkelijke meren en een lus aan de voet van de Pic de l'Etendard."
    ]
  },
