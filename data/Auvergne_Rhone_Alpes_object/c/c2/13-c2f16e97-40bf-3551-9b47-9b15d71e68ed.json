  "rdfs:comment": {
    "de": [
      "Der Gebirgsfluss Le Foron du Reposoir ist ein beliebtes Ziel für Liebhaber von reißenden Gewässern. Dieser Fluss, der in die 1. Kategorie eingestuft ist, bietet einen idealen Rahmen für alle, die die technischen Anforderungen von Berggewässern schätzen."
    ],
    "en": [
      "The mountain river Le Foron du Reposoir is a destination of choice for torrential water enthusiasts. Classed as a 1st category river, it offers an ideal setting for those who appreciate the technicality of mountain waters."
    ],
    "it": [
      "Il fiume di montagna Le Foron du Reposoir è una meta ideale per chi ama le acque torrenziali. Classificato come fiume di 1a categoria, offre un ambiente ideale per chi apprezza la natura tecnica delle acque di montagna."
    ],
    "fr": [
      "La rivière de montagne Le Foron du Reposoir est une destination de choix pour les passionnés de milieux torrentiels. Classée en 1ère catégorie, cette rivière offre un cadre de pratique idéal pour ceux qui apprécient la technicité des eaux de montagne."
    ],
    "es": [
      "El río de montaña Le Foron du Reposoir es un destino ideal para los amantes de las aguas torrenciales. Clasificado como río de 1ª categoría, ofrece un marco ideal para los que aprecian el carácter técnico de las aguas de montaña."
    ],
    "nl": [
      "De bergrivier Le Foron du Reposoir is een ideale bestemming voor liefhebbers van woest water. De rivier is ingedeeld in de 1e categorie en biedt een ideale omgeving voor liefhebbers van het technische karakter van bergwater."
    ]
  },
  "rdfs:label": {
    "en": [
      "Fishing trail Le Foron du Reposoir"
    ],
    "fr": [
      "Parcours pêche Le Foron du Reposoir"
    ]
  },
