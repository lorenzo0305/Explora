  "rdfs:comment": {
    "de": [
      "Von der Schneefront in Méribel-Mottaret aus können Sie die französischen Meisterschaften im Buckelpistenskifahren miterleben, mit dem Einzelrennen am Samstag, den 28. März und dem Dual am Sonntag, den 29. März. Die besten französischen Skifahrer werden im Herzen des Skigebiets gegeneinander antreten."
    ],
    "en": [
      "From the Méribel-Mottaret snow front, come and watch the French Mogul Skiing Championships with the Single event on Saturday, March 28th and the Dual on Sunday, March 29th. The best French skiers will compete in the heart of the resort."
    ],
    "it": [
      "Dal fronte della neve di Méribel-Mottaret, venite a vedere i Campionati francesi di sci a gobbe, con la gara di singolo sabato 28 marzo e la gara di doppio domenica 29 marzo. I migliori sciatori francesi si sfideranno nel cuore della località."
    ],
    "fr": [
      "Depuis le front de neige de Méribel-Mottaret, venez assister aux Championnats de France de ski de bosses avec l’épreuve Single le samedi 28 mars et le Dual le dimanche 29 mars. Les meilleurs skieurs français s’affronteront au cœur de la station."
    ],
    "nl": [
      "Kom op het sneeuwfront van Méribel-Mottaret kijken naar de Franse kampioenschappen buckelskiën, met de Single op zaterdag 28 maart en de Dual op zondag 29 maart. De beste Franse skiërs nemen het tegen elkaar op in het hart van het skigebied."
    ],
    "es": [
      "Desde el frente de nieve de Méribel-Mottaret, venga a ver los Campeonatos de Francia de Esquí de Mogul, con la prueba Single el sábado 28 de marzo y la Dual el domingo 29 de marzo. Los mejores esquiadores franceses competirán en el corazón de la estación."
    ]
  },
