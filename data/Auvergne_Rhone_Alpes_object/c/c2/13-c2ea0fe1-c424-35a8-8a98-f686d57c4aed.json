  "rdfs:comment": {
    "de": [
      "Eingebettet in den Vercors im Herzen des Dorfes Autrans empfängt Sie das Hotel-Restaurant*** La Buffe im Sommer wie im Winter für eine Erkundung der Region."
    ],
    "en": [
      "Nestled in the Vercors in the heart of the village of Autrans, the hotel-restaurant*** La Buffe is open for you to discover the region in summer and winter."
    ],
    "it": [
      "Immerso nel Vercors, nel cuore del villaggio di Autrans, l'hotel-ristorante*** La Buffe vi accoglie in estate e in inverno per farvi scoprire la regione."
    ],
    "fr": [
      "Niché dans le Vercors au coeur du village d'Autrans, l'hôtel-restaurant*** La Buffe vous accueille été comme hiver pour une découverte de la région."
    ],
    "nl": [
      "Genesteld in de Vercors in het hart van het dorp Autrans, verwelkomt het hotel-restaurant*** La Buffe u in zomer en winter om de streek te ontdekken."
    ],
    "es": [
      "Enclavado en el Vercors, en el corazón del pueblo de Autrans, el hotel-restaurante*** La Buffe le acoge en verano y en invierno para descubrir la región."
    ]
  },
