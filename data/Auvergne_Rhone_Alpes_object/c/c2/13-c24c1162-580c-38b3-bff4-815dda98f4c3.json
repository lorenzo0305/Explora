  "rdfs:comment": {
    "de": [
      "Willkommen in unserem Restaurant La Dîme in Yvoire! Wir bieten Ihnen eine Auswahl an Pizzen aus dem Holzofen.\r\nUm Ihnen einen authentischen Geschmack zu garantieren, werden alle unsere Gerichte aus hochwertigen Zutaten zubereitet."
    ],
    "en": [
      "Welcome to our restaurant La Dîme in Yvoire! We offer you a selection of pizzas cooked on wood fire.\r\nIn order to assure you an authentic taste, all our dishes are concocted from quality ingredients."
    ],
    "it": [
      "Benvenuti nel nostro ristorante La Dîme a Yvoire! Offriamo una selezione di pizze cotte a legna.\r\nPer garantire un gusto autentico, tutti i nostri piatti sono preparati con ingredienti di qualità."
    ],
    "fr": [
      "Bienvenue dans notre restaurant La Dîme à Yvoire! Nous mettons à votre disposition une sélection de pizzas cuites au feu de bois.\r\nAfin de vous assurer un goût authentique, tous nos mets sont concoctés à partir d'ingrédients de qualité."
    ],
    "nl": [
      "Welkom in ons restaurant La Dîme in Yvoire! Wij bieden een selectie houtovenpizza's.\r\nOm een authentieke smaak te garanderen, zijn al onze gerechten gemaakt van kwaliteitsingrediënten."
    ],
    "es": [
      "Bienvenido a nuestro restaurante La Dîme de Yvoire Le ofrecemos una selección de pizzas al horno de leña.\r\nPara garantizar un sabor auténtico, todos nuestros platos se elaboran con ingredientes de calidad."
    ]
  },
