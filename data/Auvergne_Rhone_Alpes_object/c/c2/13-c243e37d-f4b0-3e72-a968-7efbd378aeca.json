  "rdfs:comment": {
    "de": [
      "In einer idyllischen Umgebung können Sie die Tiere des Bauernhofs kennen lernen: Ziegen, Schafe, Esel, Kaninchen, Enten, Hühner, Gänse und Monsieur Cochon! Außerdem: Naturanimationen, Spaziergänge, Workshops..."
    ],
    "en": [
      "In a bucolic setting, come and meet the farm animals: goats, sheep, donkeys, rabbits, ducks, chickens, geese and Monsieur Cochon! Also: nature activities, walks, workshops..."
    ],
    "it": [
      "In un ambiente bucolico, venite a conoscere gli animali della fattoria: capre, pecore, asini, conigli, anatre, galline, oche e Mr Pig! E' anche: attività naturalistiche, passeggiate, laboratori..."
    ],
    "fr": [
      "Dans un cadre bucolique, venez faire connaissance avec les animaux de la ferme : chèvres, moutons, ânes, lapins, canards, poules, oies et Monsieur Cochon! C'est aussi : des animations nature, des balades, des ateliers..."
    ],
    "nl": [
      "Kom in een landelijke omgeving kennismaken met de dieren van de boerderij: geiten, schapen, ezels, konijnen, eenden, kippen, ganzen en Mr. Pig! Het is ook: natuuractiviteiten, wandelingen, workshops..."
    ],
    "es": [
      "En un entorno bucólico, venga a conocer a los animales de la granja: cabras, ovejas, burros, conejos, patos, gallinas, gansos y el Sr. Cerdo También: actividades en la naturaleza, paseos, talleres..."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Aire de Pique-nique chez Marie à la ferme"
    ]
  },
