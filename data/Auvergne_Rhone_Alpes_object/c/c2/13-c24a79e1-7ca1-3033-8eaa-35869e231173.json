  "rdfs:comment": {
    "de": [
      "Das Unternehmen Douillet entstand aus einer Familiengeschichte mit Bio-Ethik und öffnete seine Türen im Jahr 2001. Hier finden Sie frisches, täglich geerntetes Gemüse, Fleisch, Mehl, Getreide, Eier und verarbeitete Produkte."
    ],
    "en": [
      "Born of a family business with an organic ethic, Douillet opened its doors in 2001 in the Balcons du Dauphiné. You'll find fresh vegetables picked daily, meat, flour, cereals, eggs and processed products."
    ],
    "it": [
      "Nato da un'azienda familiare con un'etica biologica, Douillet ha aperto le sue porte nel 2001. Troverete verdure fresche raccolte ogni giorno, carne, farina, cereali, uova e prodotti trasformati."
    ],
    "fr": [
      "Née d’une histoire de famille ayant pour éthique le Bio, l’entreprise Douillet a ouvert ses portes en 2001. Vous y trouverez des légumes frais cueillis du jour, viandes, farines, céréales, œufs, produits transformés."
    ],
    "es": [
      "Nacido de una empresa familiar con una ética ecológica, Douillet abrió sus puertas en 2001. Encontrará verduras frescas recolectadas a diario, carne, harina, cereales, huevos y productos transformados."
    ],
    "nl": [
      "Douillet is ontstaan uit een familiebedrijf met een biologische ethiek en opende zijn deuren in 2001. Je vindt er dagelijks geplukte verse groenten, vlees, meel, granen, eieren en verwerkte producten."
    ]
  },
  "rdfs:label": {
    "en": [
      "Douillet Gilles, organic market gardener"
    ],
    "fr": [
      "Douillet Gilles, maraîcher bio"
    ]
  },
