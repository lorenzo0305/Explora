  "rdfs:comment": {
    "de": [
      "Von Les Communailles aus starten Sie zu einem schönen Ausflug zwischen verschneiten Wäldern und unberührten Almen in Richtung des Gipfels des Sessellifts von La Croix, direkt unterhalb des Mont Joux."
    ],
    "en": [
      "From Les Communailles, set off on a beautiful escape through snow-covered forests and alpine pastures towards the top of the La Croix chairlift, just below Mont Joux."
    ],
    "it": [
      "Da Les Communailles, partite per una splendida escursione tra boschi innevati e alpeggi immacolati, in direzione della cima della seggiovia La Croix, proprio sotto il Mont Joux."
    ],
    "fr": [
      "Depuis les Communailles, partez pour une belle escapade entre forêts enneigées et alpages immaculés, en direction du sommet du télésiège de La Croix, juste sous le Mont Joux."
    ],
    "nl": [
      "Vertrek vanuit Les Communailles voor een prachtige tocht door besneeuwde bossen en ongerepte bergweiden naar de top van de stoeltjeslift La Croix, net onder de Mont Joux."
    ],
    "es": [
      "Desde Les Communailles, emprenda un hermoso viaje a través de bosques nevados y pastos de montaña inmaculados, hacia la cima del telesilla de La Croix, justo debajo del Mont Joux."
    ]
  },
