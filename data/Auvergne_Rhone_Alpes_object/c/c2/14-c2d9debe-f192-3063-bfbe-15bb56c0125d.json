  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/f2f7aa27-99e0-37c8-8040-678b61459c71",
      "dc:description": {
        "de": [
          "Start: Wailly-Beaucamp (Kirche)\n15km - 4h - Für Mountainbikes zugänglich\nZwischen Feldern und Wiesen führt dieser reizvolle Weg durch Wailly-Beaucamp und die umliegenden Weiler. Unterwegs sollten Sie sich die überraschende Kapelle Notre-Dame de la Salette im neobyzantinischen Stil nicht entgehen lassen."
        ],
        "en": [
          "Start : Wailly-Beaucamp (Church)\n15km - 4h - Accessible to mountain bikes\nBetween fields and meadows, this charming trail crosses Wailly-Beaucamp and the surrounding hamlets. Don't miss the surprising neo-Byzantine Notre-Dame de la Salette chapel along the way."
        ],
        "it": [
          "Partenza : Wailly-Beaucamp (Chiesa)\n15 km - 4 ore - Accessibile alle mountain bike\nTra campi e prati, questo affascinante percorso attraversa Wailly-Beaucamp e le frazioni circostanti. Non perdete la sorprendente cappella neobizantina di Notre-Dame de la Salette lungo il percorso."
        ],
        "fr": [
          "Départ : Wailly-Beaucamp (Église)\n15km - 4h - Accessible aux VTT\nEntre champs et prairies, ce charmant sentier traverse Wailly-Beaucamp et les hameaux environnants. À ne pas manquer en chemin : la surprenante chapelle Notre-Dame de la Salette, de style néo-byzantin."
        ],
        "nl": [
          "Start : Wailly-Beaucamp (Kerk)\n15km - 4u - Toegankelijk voor mountainbikes\nTussen velden en weiden loopt deze charmante route door Wailly-Beaucamp en de omliggende gehuchten. Mis onderweg de verrassende neo-Byzantijnse kapel Notre-Dame de la Salette niet."
        ],
        "es": [
          "Salida : Wailly-Beaucamp (Iglesia)\n15km - 4h - Accesible para bicicletas de montaña\nEntre campos y prados, este encantador sendero atraviesa Wailly-Beaucamp y las aldeas de los alrededores. No se pierda por el camino la sorprendente capilla neobizantina de Notre-Dame de la Salette."
        ]
      },
