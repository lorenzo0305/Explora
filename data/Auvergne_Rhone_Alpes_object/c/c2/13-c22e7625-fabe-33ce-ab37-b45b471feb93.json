  "rdfs:comment": {
    "de": [
      "Saisonale und regionale Produkte werden in einer originellen und vielfältigen Auswahl an kompletten Tellern angeboten ... Eine nette Adresse, die für alle offen ist! Reservierung empfohlen."
    ],
    "en": [
      "Seasonal and local products in an original and varied range of complete dishes... A friendly address, open to all! Reservations recommended."
    ],
    "it": [
      "Prodotti di stagione e locali in una gamma originale e varia di piatti completi... Un posto fantastico, aperto a tutti! Prenotazione consigliata."
    ],
    "fr": [
      "Produits de saison et du pays déclinés sur une gamme originale et variée d'assiettes complètes ... Une adresse sympa, ouverte à tous ! Réservation conseillée."
    ],
    "nl": [
      "Seizoens- en streekproducten in een origineel en gevarieerd aanbod van complete gerechten ... Een geweldige plek, open voor iedereen! Reserveren aanbevolen."
    ],
    "es": [
      "Productos de temporada y locales en una gama original y variada de platos completos... Un gran lugar, ¡abierto a todos! Se recomienda reservar."
    ]
  },
