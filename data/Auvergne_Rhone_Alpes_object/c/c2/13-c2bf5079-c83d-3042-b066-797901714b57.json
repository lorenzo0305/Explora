  "rdfs:comment": {
    "de": [
      "Interkommunale Mediathek Darodes in St Antoine l'Abbaye, gegenüber den Markthallen, Hauptstraße im unteren Teil des Dorfes.\r\nBestand von mehr als 6000 Dokumenten, Mitglied des Passthèque-Netzwerks.\r\nAusleihe von 20 Dokumenten pro Monat, kostenlose Mitgliedschaft.\r\nVermittlung und Animation"
    ],
    "en": [
      "Médiathèque Intercommunale Darodes located in St Antoine l'Abbaye, opposite the Halles, in the main street at the bottom of the village.\r\nMore than 6,000 documents in stock, member of the Passthèque network.\r\nLoan of 20 documents per month, free membership.\r\nMediation and animation"
    ],
    "it": [
      "La Mediateca Intercomunale di Darodes si trova a St Antoine l'Abbaye, di fronte al mercato coperto nella via principale in fondo al villaggio.\r\nPossiede oltre 6.000 documenti, è membro della rete Passthèque.\r\nPrestito di 20 documenti al mese, iscrizione gratuita.\r\nMediazione ed eventi"
    ],
    "fr": [
      "Médiathèque Intercommunale Darodes située à St Antoine l'Abbaye, en face des halles, rue principale du bas du village.\r\nFonds de plus de 6000 documents, membre du réseau Passthèque.\r\nPrêts de 20 documents par mois, adhésion gratuite.\r\nMédiation et animation"
    ],
    "es": [
      "La Mediateca Intercomunal de Darodes se encuentra en St Antoine l'Abbaye, frente al mercado cubierto de la calle principal, al fondo del pueblo.\r\nFondo de más de 6.000 documentos, miembro de la red Passthèque.\r\nPréstamo de 20 documentos al mes, afiliación gratuita.\r\nMediación y eventos"
    ],
    "nl": [
      "De mediatheek van de intercommunale Darodes bevindt zich in St Antoine l'Abbaye, tegenover de overdekte markt in de hoofdstraat onderaan het dorp.\r\nBevat meer dan 6.000 documenten, lid van het Passthèque-netwerk.\r\nUitleen van 20 documenten per maand, gratis lidmaatschap.\r\nBemiddeling en evenementen"
    ]
  },
  "rdfs:label": {
