  "rdfs:comment": {
    "de": [
      "Bewege dich mithilfe der Karte um den Lac de la Mirande, um die Markierungen und die verschiedenen Rätsel zu entdecken."
    ],
    "en": [
      "Using the map, navigate your way around the heart of the village of Allevard to find the markers that have been placed near historic sites."
    ],
    "it": [
      "Utilizzate la mappa per orientarvi nel Lac de la Mirande e scoprite i marcatori e gli enigmi proposti."
    ],
    "fr": [
      "A l'aide la carte, déplacez-vous atout du lac de la Mirande afin de découvrir les balises, et les différentes énigmes proposées."
    ],
    "nl": [
      "Verplaats je met behulp van de kaart door het hart van het dorp Allevard om de merkpalen te ontdekken die in de buurt van historische locaties zijn aangebracht."
    ],
    "es": [
      "Utilizando el mapa, desplázate por el lago de Mirande para descubrir los marcadores y los distintos rompecabezas que se te proponen."
    ]
  },
  "rdfs:label": {
