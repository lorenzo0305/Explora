  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Lyoner Küche von Fabien. Spezialitäten: Sapeurschürze, Geflügelleberkuchen, hausgemachte Hechtklößchen.  Küche \"hausgemacht\"."
    ],
    "en": [
      "Come and discover Fabien's Lyon-style cuisine. Specialities: tablier de sapeur, poultry liver cake, homemade pike quenelles.  Home-made cuisine."
    ],
    "it": [
      "Venite a scoprire la cucina lionese di Fabien. Specialità: tablier de sapeur, torta di fegato di pollame, quenelles di luccio fatte in casa.  Cucina casalinga."
    ],
    "fr": [
      "Venez découvrir la cuisine lyonnaise de Fabien. Spécialités : tablier de sapeur, gâteau de foie de volailles, quenelles de brochet maison.  Cuisine \"fait maison\"."
    ],
    "es": [
      "Venga a descubrir la cocina lionesa de Fabien. Especialidades: tablier de sapeur, pastel de hígado de ave, quenelles caseras de lucio.  Cocina casera."
    ],
    "nl": [
      "Kom de keuken van Fabien in Lyon ontdekken. Specialiteiten: tablier de sapeur, gevogeltelevertaart, huisgemaakte quenelles van snoek.  Huisgemaakte keuken."
    ]
  },
  "rdfs:label": {
    "fr": [
      "LF restaurant"
    ]
  },
