  "rdfs:comment": {
    "de": [
      "Das B'Rock befindet sich im Herzen des Dorfes der Trödler und bietet Ihnen das ganze Jahr über hochwertige Konzerte in einer herzlichen Atmosphäre."
    ],
    "en": [
      "In the heart of the Village des Brocanteurs, you can enjoy delicious seasonal dishes, created by Mélanie. The B'rock café is also a gallery for pictures, paintings, and a venue for concerts de poches, bringing the big names to rural areas..."
    ],
    "it": [
      "Situato nel cuore del Village des Brocanteurs, il B'Rock offre tutto l'anno concerti di qualità in un'atmosfera calda e accogliente."
    ],
    "fr": [
      "Situé au coeur du Village des Brocanteurs, le B'Rock vous propose tout au long de l'année des concerts de qualité dans une ambiance chaleureuse."
    ],
    "es": [
      "Situado en el corazón del Village des Brocanteurs, B'Rock ofrece conciertos de calidad durante todo el año en un ambiente cálido y acogedor."
    ],
    "nl": [
      "B'Rock ligt in het hart van de Village des Brocanteurs en biedt het hele jaar door kwaliteitsconcerten in een warme en vriendelijke sfeer."
    ]
  },
  "rdfs:label": {
