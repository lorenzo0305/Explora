  "rdfs:comment": {
    "de": [
      "Wir bieten Ihnen eine traditionelle, einfache und authentische Küche, die im Laufe der Jahreszeiten und in einer freundlichen Atmosphäre erdacht wurde.\r\nDie Küche wird zu 100 % hausgemacht."
    ],
    "en": [
      "We offer you a traditional, simple and authentic cuisine, imagined according to the seasons and in a friendly atmosphere."
    ],
    "it": [
      "Offriamo una cucina tradizionale, semplice e autentica, creata in base alle stagioni e in un'atmosfera amichevole.\r\nLa cucina è al 100% casalinga."
    ],
    "fr": [
      "Nous vous proposons une cuisine traditionnelle, simple et authentique, imaginée au fil des saisons et dans une ambiance conviviale.\r\nLa cuisine est réalisée 100% faite maison."
    ],
    "nl": [
      "Wij bieden een traditionele, eenvoudige en authentieke keuken, gemaakt met de seizoenen in gedachten en in een vriendelijke sfeer.\r\nAl onze gerechten zijn 100% huisgemaakt."
    ],
    "es": [
      "Ofrecemos una cocina tradicional, sencilla y auténtica, creada según las estaciones y en un ambiente acogedor.\r\nLa cocina es 100% casera."
    ]
  },
