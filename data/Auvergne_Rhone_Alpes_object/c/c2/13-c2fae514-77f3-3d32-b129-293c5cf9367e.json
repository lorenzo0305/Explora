  "rdfs:comment": {
    "de": [
      "Mountainbike-Führung und -Coaching Enduro und E-Bike. Bike Laps hat seinen Sitz in Sainte Foy Tarentaise und nimmt Sie mit auf eine Entdeckungsreise mit dem Mountainbike durch die Tarentaise und die umliegenden Täler wie Maurienne und Beaufortain, begleitet von einem staatlich geprüften, erfahrenen Guide."
    ],
    "en": [
      "Enduro and E-Bike MTB guiding and coaching. Based in Sainte Foy Tarentaise, Bike Laps takes you on mountain bike adventures to discover the Tarentaise and surrounding valleys such as the Maurienne and the Beaufortain, guided by a certified expert instructor."
    ],
    "it": [
      "Guida e coaching di mountain bike Enduro e E-Bike. Con sede a Sainte Foy Tarentaise, Bike Laps vi accompagna in un tour in mountain bike della Tarentaise e delle valli circostanti, come la Maurienne e la Beaufortain, sotto la supervisione di una guida esperta qualificata."
    ],
    "fr": [
      "Guiding et coaching VTT Enduro et E-Bike. Basé à Sainte Foy Tarentaise, Bike Laps vous emmène en VTT à la découverte de la Tarentaise et des vallées alentours comme la Maurienne et le Beaufortain, encadré par un Guide expert diplômé d'Etat."
    ],
    "es": [
      "Orientación y coaching en bicicleta de montaña Enduro y E-Bike. Con sede en Sainte Foy Tarentaise, Bike Laps te lleva a recorrer en bicicleta de montaña la Tarentaise y los valles circundantes, como el de Maurienne y Beaufortain, supervisado por un guía experto cualificado por el Estado."
    ],
    "nl": [
      "Enduro- en E-Bike MTB-gidsbeurten en coaching. Vanuit Sainte Foy Tarentaise neemt Bike Laps je mee op mountainbike-avonturen om de Tarentaise en de omliggende valleien zoals de Maurienne en de Beaufortain te ontdekken, onder begeleiding van een gediplomeerde expertgids."
    ]
  },
