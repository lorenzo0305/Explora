  "rdfs:comment": {
    "de": [
      "Der See liegt am Ausgangspunkt der Wanderung zum Lac du Lou und beherbergt ein bemerkenswertes Ökosystem mit Fröschen, Libellen, Forellen und Bachforellen. Ideal für Picknicks, zum Angeln und für Spaziergänge am Wasser im Sommer. Schöner Spaziergang im Winter."
    ],
    "en": [
      "Located at the start of the Lac du Lou hiking trail, the lake is home to a remarkable eco-system: frogs, dragonflies, trout and brook salmon. Ideal for picnics, fishing and waterside walks in summer. Lovely winter walk."
    ],
    "it": [
      "Situato all'inizio della passeggiata del Lac du Lou, questo lago ospita un notevole ecosistema: rane, libellule, trote e salmoni di fontana. Ideale per picnic, pesca e passeggiate in riva al lago in estate. Bella passeggiata invernale."
    ],
    "fr": [
      "Situé au départ de la randonnée du lac du Lou, le plan d'eau abrite un éco-système remarquable: grenouilles, libellules, truites et saumons de fontaine. Idéal pour le pique-nique, la pêche, et les balades au bord de l'eau l'été. Jolie balade d'hiver."
    ],
    "es": [
      "Situado al comienzo del paseo del Lago del Lou, este lago alberga un ecosistema extraordinario: ranas, libélulas, truchas y salmones fuente. Ideal para picnics, pesca y paseos por la orilla en verano. Bonito paseo invernal."
    ],
    "nl": [
      "Dit meer ligt aan het begin van de Lac du Lou wandeling en herbergt een opmerkelijk ecosysteem: kikkers, libellen, forel en fonteinzalm. Ideaal voor picknicks, vissen en wandelingen langs het water in de zomer. Prachtige winterwandeling."
    ]
  },
