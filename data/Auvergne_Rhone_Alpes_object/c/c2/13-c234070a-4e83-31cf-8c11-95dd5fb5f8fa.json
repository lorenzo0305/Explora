  "rdfs:comment": {
    "de": [
      "Dieulefit ist eine sensible und gastfreundliche Kleinstadt mit 3 100 Seelen. Sie liegt auf 400 m Höhe, die reine und trockene Luft ist günstig für die Erholung und ein bevorzugter Ort, der für die Behandlung von Atemwegs- und Herzkrankheiten bekannt ist."
    ],
    "en": [
      "Dieulefit is a small, sensitive and welcoming town of 3,100 souls, situated at an altitude of 400 m. The pure, dry air is ideal for resting, and the area is renowned for its treatment of respiratory and cardiac ailments."
    ],
    "it": [
      "Dieulefit è un piccolo comune di 3.100 anime, sensibile e accogliente, situato a 400 m di altitudine. L'aria pura e secca è favorevole al riposo, è un luogo privilegiato e rinomato per la cura delle affezioni respiratorie e cardiache."
    ],
    "fr": [
      "Petite ville de 3 100 âmes, sensible et accueillante, Dieulefit est située à 400 m d'altitude, l'air pur et sec est favorable au repos, c'est un lieu privilégié réputé pour le traitement des affections respiratoires et cardiaques."
    ],
    "nl": [
      "Dieulefit is een kleine stad van 3100 zielen, gevoelig en gastvrij, gelegen op 400 m hoogte. De zuivere, droge lucht is ideaal om uit te rusten en de stad staat bekend om zijn behandeling van ademhalings- en hartkwalen."
    ],
    "es": [
      "Dieulefit es una pequeña ciudad de 3.100 almas, sensible y acogedora, situada a 400 m de altitud. El aire puro y seco es propicio para el descanso, es un lugar privilegiado reconocido para el tratamiento de afecciones respiratorias y cardíacas."
    ]
  },
