  "rdfs:comment": {
    "de": [
      "Drei Musiker, Yom und die Brüder Ceccaldi, drei Instrumente ? Klarinette, Violine, Cello ? vereint in einem Atemzug laden uns zu einer Klangexpedition an die Grenzen des Sichtbaren ein."
    ],
    "en": [
      "Three musicians, Yom and the Ceccaldi brothers, three instruments - clarinet, violin, cello - united in a single breath, invite us on a sonic expedition to the frontiers of the visible."
    ],
    "it": [
      "Tre musicisti, Yom e i fratelli Ceccaldi, tre strumenti - clarinetto, violino, violoncello - uniti dallo stesso respiro, ci invitano a una spedizione sonora alle frontiere del visibile."
    ],
    "fr": [
      "Trois musiciens, Yom et les frères Ceccaldi, trois instruments – clarinette, violon, violoncelle – unis dans une même respiration nous invitent à une expédition sonore aux frontières du visible."
    ],
    "es": [
      "Tres músicos, Yom y los hermanos Ceccaldi, tres instrumentos -clarinete, violín, violonchelo- unidos por el mismo aliento, nos invitan a una expedición sonora a las fronteras de lo visible."
    ],
    "nl": [
      "Drie muzikanten, Yom en de gebroeders Ceccaldi, drie instrumenten - klarinet, viool, cello - verenigd door dezelfde adem, nodigen ons uit op een sonische expeditie naar de grenzen van het zichtbare."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Yom x Ceccaldi - Le rythme du silence"
    ]
  },
