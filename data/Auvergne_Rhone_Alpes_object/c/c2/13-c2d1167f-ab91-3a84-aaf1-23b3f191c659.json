  "rdfs:comment": {
    "de": [
      "Als Hommage an die savoyische Gastronomie und die in Megève so beliebten kulinarischen Traditionen bietet das La Table des Cochers eine ehrliche und authentische traditionelle Küche, die mit Respekt für die lokalen Produkte zusammengestellt wird."
    ],
    "en": [
      "La Table des Cochers pays homage to the gastronomy of Savoie and the local culinary traditions so dear to the hearts of Megève. The traditional cuisine is honest, authentic and respectful of the local ingredients from which it is prepared."
    ],
    "it": [
      "Omaggio alla gastronomia savoiarda e alle tradizioni culinarie tanto care a Megève, La Table des Cochers propone una cucina tradizionale sincera e autentica, elaborata nel rispetto dei prodotti locali."
    ],
    "fr": [
      "Hommage à la gastronomie savoyarde et aux traditions culinaires si chères à Megève, La Table des Cochers propose une cuisine traditionnelle sincère et authentique, concoctée dans le respect des produits locaux."
    ],
    "nl": [
      "La Table des Cochers, een eerbetoon aan de Savoyaardse gastronomie en de culinaire tradities die Megève zo dierbaar zijn, biedt oprechte en authentieke traditionele gerechten, samengesteld met respect voor lokale producten."
    ],
    "es": [
      "Homenaje a la gastronomía saboyana y a las tradiciones culinarias tan apreciadas en Megève, La Table des Cochers ofrece una cocina tradicional sincera y auténtica, elaborada con respeto a los productos locales."
    ]
  },
