  "rdfs:comment": {
    "de": [
      "Freie Besichtigung mit Dokument und Informationstafel. Beim Betreten der Kirche im burgundischen romanischen Stil wird man von einer seltsamen Figur begrüßt, die sich auf einen Stab stützt und von zwei Reptilien umgeben ist."
    ],
    "en": [
      "Entering this Burgundian Romanesque style church (MH), you are welcome by a strange character, leaning on a stick and surrounded by 2 reptiles."
    ],
    "it": [
      "Visita autoguidata con documentazione e pannello informativo. Entrando nella chiesa romanica borgognona, si viene accolti da una strana figura, appoggiata a un bastone e circondata da due rettili."
    ],
    "fr": [
      "Visite libre avec document et panneau d'information. En entrant dans l'église de style roman bourguignon, on est accueilli par un personnage étrange, appuyé sur un bâton et entouré de deux reptiles."
    ],
    "es": [
      "Visita autoguiada con documentación y panel informativo. Al entrar en la iglesia románica borgoñona, le recibe una extraña figura, apoyada en un palo y rodeada de dos reptiles."
    ],
    "nl": [
      "Gratis bezoek met document en informatiepaneel. Als u de Bourgondische Romaanse kerk binnengaat, wordt u begroet door een vreemde figuur, leunend op een stok en omringd door twee reptielen."
    ]
  },
