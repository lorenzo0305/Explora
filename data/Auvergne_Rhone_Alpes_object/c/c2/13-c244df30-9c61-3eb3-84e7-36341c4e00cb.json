  "rdfs:comment": {
    "de": [
      "Direkter Verkauf von Ziegenkäse Pächter: Picodon, tommes frisch, cavet Bohnenkraut, lernt Pächterin, besonder von Ziege warm. Reinigung von Ziegenkäse Qualitätswein mit Prädikat. Picodon Dieulefites."
    ],
    "en": [
      "Direct sale of farmhouse goat milk cheese: Picodon cheese, fresh tomme cheese, cavet sarriette, farmhouse log, special hot goat milk cheese. Maturing of A.O.C. Picodon de Dieulefit goat milk  cheese."
    ],
    "it": [
      "Vendita diretta di formaggi di capra di fattoria: Picodon, tomini freschi, cavet sarriette, tronchetto di fattoria, specialità di formaggio di capra caldo. Stagionatura del formaggio di capra A.O.C. Picodon de Dieulefit. Vendita di prodotti regionali"
    ],
    "fr": [
      "Vente directe de Fromage de chèvres fermiers : Picodon, tommes fraîches, cavet sarriette, bûche fermière, spécial chèvre chaud. Affinage de fromage de chèvre A.O.C. Picodon de Dieulefit. Vente de produits régionaux"
    ],
    "es": [
      "Venta directa de queso de cabra de granja: Picodon, tommes frescos, cavet sarriette, tronco de granja, especial queso de cabra caliente. Maduración del queso de cabra A.O.C. Picodon de Dieulefit. Venta de productos regionales"
    ],
    "nl": [
      "Directe verkoop van boerengeitenkaas: picodon kaas, verse tommekaas, cavet sarriette, bûche fermière, speciale warme geitenkaas. Affinage van geitenkaas A. O. C. Picodon uit Dieulefit."
    ]
  },
