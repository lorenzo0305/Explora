  "rdfs:comment": {
    "de": [
      "Kulturstätte, in der jedes Jahr verschiedene Spielzeiten stattfinden: Theater, Musik, junges Publikum und Tanz."
    ],
    "en": [
      "A cultural venue that hosts various types of live entertainment : classical and amplified music, dance, comedy, adult and children's theater."
    ],
    "it": [
      "Il Théâtre de la Ville offre una stagione culturale aperta a tutti gli orizzonti. Ogni anno vanno in scena più di trenta spettacoli: teatro, commedia, teatro per bambini, danza e, naturalmente, tutti i tipi di musica!"
    ],
    "fr": [
      "Le Théâtre de la Ville propose une saison culturelle ouverte à tous les horizons. Chaque année, plus d’une trentaine de spectacles s'y jouent sur ses planches: théâtre, comédie, jeune public, danse et bien sûr toutes les musiques !"
    ],
    "es": [
      "El Théâtre de la Ville ofrece una temporada cultural abierta a todos los horizontes. Cada año, más de treinta espectáculos suben al escenario: teatro, comedia, teatro infantil, danza y, por supuesto, ¡todo tipo de música!"
    ],
    "nl": [
      "Een cultureel trefpunt met jaarlijkse seizoenen van theater, muziek, kindervoorstellingen en dans."
    ]
  },
