  "rdfs:comment": {
    "de": [
      "Seine Weinreben und Mauern, seine landwirtschaftlich genutzte Ebene, seine Wasserkraftwerke.\r\nEin grünes Dorf, das sich an das Massif de la lauzière anlehnt."
    ],
    "en": [
      "Its vineyards and murgers, its agricultural plain, its hydroelectric power stations.\r\nA green village set against the Lauzière Massif."
    ],
    "it": [
      "I suoi vigneti e i suoi murger, la sua pianura agricola, le sue centrali idroelettriche.\r\nUn villaggio verde incastonato nel massiccio del Lauzière."
    ],
    "fr": [
      "Ses treilles et ses murgers, sa plaine agricole, ses centrales hydroélectriques.\r\nVillage vert adossé au Massif de la lauzière."
    ],
    "nl": [
      "Zijn wijngaarden en boeren, zijn landbouwvlakte, zijn waterkrachtcentrales.\r\nEen groen dorp tegen het massief van de Lauzière."
    ],
    "es": [
      "Sus viñedos y huertas, su llanura agrícola, sus centrales hidroeléctricas.\r\nUn pueblo verde enclavado en el macizo de Lauzière."
    ]
  },
