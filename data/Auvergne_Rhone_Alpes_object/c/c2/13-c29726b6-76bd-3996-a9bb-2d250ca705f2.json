  "rdfs:comment": {
    "de": [
      "Hersteller von Quark, aber auch von Würsten, Andouillettes, Graton, Terrinen, Blutwurst, Godivaux, Merguez...\r\n\r\nMeister des Handwerks.\r\nMitglied der Confrérie des Chevaliers Taste Caillette."
    ],
    "en": [
      "Producer of caillettes, as well as sausages, andouillettes, graton, terrines, boudins, godivaux, merguez...\n\nMaster craftsman.\nMember of the Confrérie des Chevaliers Taste Caillette."
    ],
    "it": [
      "Produttore di caillettes, ma anche di salsicce, andouillettes, graton, terrine, boudins, godivaux, merguez...\r\n\r\nMaestro artigiano.\r\nMembro della Confrérie des Chevaliers Taste Caillette."
    ],
    "fr": [
