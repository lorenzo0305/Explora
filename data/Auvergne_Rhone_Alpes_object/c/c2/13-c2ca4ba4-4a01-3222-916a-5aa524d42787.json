  "rdfs:comment": {
    "de": [
      "Eine erfinderische und raffinierte Bistroküche mit frischen und leckeren Gerichten, die lokale Produkte hervorheben. Geselligkeit, Großzügigkeit und Genuss für ein Geschäftsessen, ein romantisches Dinner zu zweit oder einen Brunch mit der Familie."
    ],
    "en": [
      "A bistronomic, inventive, and refined cuisine, with fresh and gourmet dishes highlighting local products. Warmth, generosity, and enjoyment for a business dinner, a romantic evening, or a family brunch."
    ],
    "it": [
      "Una cucina bistronomica, inventiva e raffinata, con piatti freschi e gourmet che mettono in risalto i prodotti locali. Convivialità, generosità e piacere per una cena d'affari, una serata romantica o un brunch in famiglia."
    ],
    "fr": [
      "Une cuisine bistronomique, inventive et raffinée, des plats frais et gourmands mettant en valeur les produits locaux. Convivialité, générosité et plaisir pour un dîner d'affaires, en amoureux ou un brunch en famille."
    ],
    "es": [
      "Una cocina bistronómica, inventiva y refinada, platos frescos y gourmet que ponen de relieve los productos locales. Convivencia, generosidad y placer para una cena de negocios, una cena romántica o un brunch familiar."
    ],
    "nl": [
      "Een bistronomische, inventieve en geraffineerde keuken, verse en gastronomische gerechten met aandacht voor lokale producten. Gezelligheid, gulheid en plezier voor een zakendiner, een romantisch diner of een familiebrunch."
    ]
  },
