  "rdfs:comment": {
    "de": [
      "Als Holzbildhauer liegt Jean Camille die Weitergabe und Förderung der traditionellen Volkskunst der Bildhauerei in den Savoyer Ländern und im Alpenraum wirklich am Herzen."
    ],
    "en": [
      "A woodcarver, Jean Camille is truly committed to passing on and promoting the traditional art of folk sculpture from the Pays de Savoie and the Alpine Arc."
    ],
    "it": [
      "Scultore del legno, Jean Camille è sinceramente impegnato a trasmettere e promuovere l'arte tradizionale della scultura popolare della Savoia e dell'arco alpino."
    ],
    "fr": [
      "Sculpteur sur bois, Jean Camille a réellement à cœur la transmission et la promotion de l'art traditionnel de la sculpture d'art populaire des Pays de Savoie et de l'Arc alpin."
    ],
    "es": [
      "Escultor en madera, Jean Camille está realmente comprometido con la transmisión y la promoción del arte tradicional de la escultura popular de la región de Saboya y del Arco Alpino."
    ],
    "nl": [
      "Als houtsnijder zet Jean Camille zich oprecht in voor het doorgeven en promoten van de traditionele kunst van de volkssculptuur uit de Savoie en het Alpengebied."
    ]
  },
