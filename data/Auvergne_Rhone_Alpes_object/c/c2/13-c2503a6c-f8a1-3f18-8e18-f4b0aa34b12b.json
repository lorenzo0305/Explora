  "rdfs:comment": {
    "de": [
      "Pizzas vor Ort oder zum Mitnehmen, Fleisch, Pasta, Salate, Tagesgerichte, Chocolatier. Parkplätze sind garantiert. Restaurant gegenüber dem Bricomarché.\r\nTraditionelle italienische Küche"
    ],
    "en": [
      "Pizzas to be enjoyed in house or to take away, grilled meat, pasta dishes, salads, daily specials. This restaurant is located next to Baratier and Ambiance Mariage and has its own car park."
    ],
    "it": [
      "Pizze da mangiare o da portare via, carne, pasta, insalate, specialità del giorno, cioccolatiera. Parcheggio previsto. Ristorante situato di fronte al Bricomarché.\r\nCucina tradizionale italiana"
    ],
    "fr": [
      "Pizzas sur place ou à emporter, viandes, pâtes, salades, plats du jour, chocolatier. Parking assuré. Restaurant situé en face de Bricomarché.\r\nCuisine traditionnelle italienne"
    ],
    "es": [
      "Pizzas para comer o llevar, carnes, pastas, ensaladas, platos del día, chocolatería. Se facilita aparcamiento. Restaurante situado frente al Bricomarché.\r\nCocina tradicional italiana"
    ],
    "nl": [
      "Pizza's om te eten of om mee te nemen, vlees, pasta's, salades, dagschotels, chocolademaker. Parkeerplaats voorzien. Restaurant gelegen tegenover Bricomarché.\r\nTraditionele Italiaanse keuken"
    ]
  },
