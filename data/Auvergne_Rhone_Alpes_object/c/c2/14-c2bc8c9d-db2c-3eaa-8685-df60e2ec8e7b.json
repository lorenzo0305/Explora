      "@id": "https://data.datatourisme.fr/45928ee5-7709-3ba1-9fb9-a78878d603f6",
      "dc:description": {
        "de": [
          "6 km langer Wanderweg - 1,5 Std\nLEICHTER NIVEAU\nSTART AUF DEM RATHAUSPLATZ VON COLEMBERT\nGELBE MARKIERUNG\n\nFinden Sie den Verlauf des Rundwegs in der Wander-App CIRKWI auf Ihrem Smartphone."
        ],
        "en": [
          "6 KM PEDESTRIAN TRAIL - 1h30\nEASY LEVEL\nDEPARTS FROM COLEMBERT TOWN HALL SQUARE\nYELLOW MARKINGS\n\nFind the route on the CIRKWI hiking application on your Smartphone."
        ],
        "it": [
          "PERCORSO PEDONALE 6 KM - 1h30\nLIVELLO FACILE\nPARTE DALLA PIAZZA DEL MUNICIPIO DI COLEMBERT\nSEGNALETICA GIALLA\n\nTrovate il percorso sull'applicazione escursionistica CIRKWI sul vostro smartphone."
        ],
        "fr": [
          "SENTIER PEDESTRE DE 6 KM - 1h30 \nNIVEAU FACILE\nDEPART DE LA PLACE DE LA MAIRIE DE  COLEMBERT\nBALISAGE EN JAUNE \n\nRetrouvez le tracé du circuit sur l'application Randonnée CIRKWI sur votre Smartphone."
        ],
        "nl": [
          "PEDESTRIAN TRAIL 6 KM - 1u30\nLAAG NIVEAU\nSTART VANAF HET STADHUISPLEIN IN COLEMBERT\nGELE MARKERINGEN\n\nVind de route op de CIRKWI wandelapplicatie op je smartphone."
        ],
        "es": [
          "CAMINO PEDESTRE 6 KM - 1h30\nNIVEL FÁCIL\nSALE DE LA PLAZA DEL AYUNTAMIENTO DE COLEMBERT\nSEÑALIZACIÓN AMARILLA\n\nEncuentre la ruta en la aplicación de senderismo CIRKWI en su smartphone."
        ]
      },
