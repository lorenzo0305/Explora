  "rdfs:comment": {
    "de": [
      "Vor den Toren der Stadt Annecy liegt das Le greet hotel Annecy, das nur 10 min von der Altstadt und dem See von Annecy entfernt ist und Sie rund um die Uhr empfängt."
    ],
    "en": [
      "At the gateway to Annecy, Le greet hôtel Annecy is located 10 minutes from the old town and Lake Annecy and welcomes you 24 hours a day."
    ],
    "it": [
      "Alle porte di Annecy, Le greet hôtel Annecy si trova a 10 minuti dal centro storico e dal lago di Annecy e vi accoglie 24 ore al giorno."
    ],
    "fr": [
      "Aux portes de la ville d'Annecy, Le greet hôtel Annecy est situé à 10 min de la vieille ville et du lac d'Annecy et vous accueille 24h/24."
    ],
    "nl": [
      "Le greet hôtel Annecy ligt aan de poort van Annecy, op 10 minuten van de oude stad en het meer van Annecy en verwelkomt je 24 uur per dag."
    ],
    "es": [
      "A las puertas de Annecy, Le greet hôtel Annecy está situado a 10 minutos del casco antiguo y del lago de Annecy y le da la bienvenida las 24 horas del día."
    ]
  },
