  "rdfs:comment": {
    "de": [
      "Ein eingespieltes und lächelndes Team empfängt Sie in den modernen und gemütlichen Räumen oder draußen auf der Terrasse gegenüber dem Rathaus."
    ],
    "en": [
      "Our friendly team of staff is looking forward to welcoming you in the restaurant in a modern or outside on the terrace looking out towards  the Town Hall. \r\nWe serve gourmet and local seasonal dishes. Possibility of welcoming groups and catering for banquets."
    ],
    "it": [
      "Un team unito e sorridente vi dà il benvenuto, sia nelle camere moderne e accoglienti che all'esterno, sulla terrazza di fronte al Municipio."
    ],
    "fr": [
      "Une équipe soudée et souriante qui vous accueille, que ce soit dans les salles moderne et cosy ou à l’extérieur, sur la terrasse face à l’Hôtel de Ville."
    ],
    "es": [
      "Un equipo unido y sonriente le da la bienvenida, ya sea en las modernas y acogedoras habitaciones o al aire libre en la terraza frente al Ayuntamiento."
    ],
    "nl": [
      "Een verenigd en glimlachend team heet u welkom, zowel in de moderne en gezellige kamers als buiten op het terras tegenover het stadhuis."
    ]
  },
