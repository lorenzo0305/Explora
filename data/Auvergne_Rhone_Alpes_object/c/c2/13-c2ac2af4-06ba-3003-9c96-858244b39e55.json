  "rdfs:comment": {
    "de": [
      "Verkauf ab Hof auf Bestellung. Sylvain und Yann freuen sich, Sie auf ihrem Betrieb begrüßen zu dürfen, auf dem Aubrac-Kühe, Schafe und Geflügel gezüchtet werden."
    ],
    "en": [
      "Farm sale to order. Sylvain and Yann are happy to welcome you on their farm where Aubrac cows, ewes and poultry are raised."
    ],
    "it": [
      "Vendita in azienda su ordinazione. Sylvain e Yann sono lieti di accogliervi nella loro fattoria, dove allevano mucche, pecore e pollame di razza Aubrac."
    ],
    "fr": [
      "Vente à la ferme sur commande. Sylvain et Yann sont heureux de vous accueillir sur leur exploitation où sont élevées vaches Aubrac, brebis et volailles."
    ],
    "nl": [
      "Verkoop op de boerderij op bestelling. Sylvain en Yann verwelkomen u graag op hun boerderij waar ze Aubrac koeien, schapen en pluimvee houden."
    ],
    "es": [
      "Venta en la granja por encargo. Sylvain y Yann estarán encantados de recibirle en su granja, donde crían vacas, ovejas y aves de corral Aubrac."
    ]
  },
  "rdfs:label": {
