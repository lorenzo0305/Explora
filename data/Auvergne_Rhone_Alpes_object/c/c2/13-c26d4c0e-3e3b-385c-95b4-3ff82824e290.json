  "rdfs:comment": {
    "de": [
      "7 Kunsthandwerkerinnen zeigen Ihnen diesen Ausstellungs- und Verkaufsraum für ihre Kreationen:\r\nKeramik, Hüte und Accessoires, Mohairknäuel und -strickwaren, Postkarten und Siebdruck, gedrechseltes Holz, Schmuck aus Glasperlen, Accessoires aus recycelten Stoffen."
    ],
    "en": [
      "Five artisans in one space, exhibiting and selling their products for you:\r\nMélina Peyre: ceramics\r\nEstelle Boudes: hats and accessories\r\nIsabelle Aubert: wools and items out of mohair\r\nMarion Freyre: enamels on copper\r\nClodine Bernard: earthenware"
    ],
    "it": [
      "7 artigiane saranno a disposizione per presentare e vendere le loro creazioni:\r\nCeramica, cappelli e accessori, gomitoli di mohair e maglieria, cartoline e serigrafia, legno tornito, gioielli con perle di vetro e accessori in tessuto riciclato."
    ],
    "fr": [
      "7 artisanes vous font découvrir cet espace d'exposition - vente de leurs créations:\r\nCéramique, chapeaux et accessoires,  pelotes et tricot mohair, cartes postales et sérigraphie, bois tourné, bijoux en perles de verre, accessoires en tissu recyclé."
    ],
    "es": [
      "7 artesanas expondrán y venderán sus creaciones:\r\nCerámica, sombreros y accesorios, ovillos de mohair y punto, postales y serigrafía, madera torneada, bisutería de cuentas de vidrio y accesorios de tela reciclada."
    ],
    "nl": [
      "4 ambachten in één een expositieruimte (en verkoop):\r\nMélina Peyre: aardewerk\r\nEstelle Boudes: hoeden en accessoires\r\nEstel Laouaty: emaille op koper en staal\r\nIsabelle Aubert  wollen en artikelen van mohair"
    ]
  },
