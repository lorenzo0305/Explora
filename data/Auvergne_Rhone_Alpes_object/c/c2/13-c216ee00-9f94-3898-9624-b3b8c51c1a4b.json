  "rdfs:comment": {
    "de": [
      "Le Dandy freut sich Sie von Montag bis Samstag im Zentrum Lyons in intimer Atmosphäre empfangen zu können. Unser Chefkoch bietet Ihnen eine raffinierte, reichhaltige und saisonale Küche an."
    ],
    "en": [
      "The Dandy is pleased to welcome you from Monday to Saturday, at the heart of Lyon in an intimist setting. Fine cuisine, hearty and of season will be proposed by our Chef."
    ],
    "it": [
      "Le Dandy è lieto di darvi il benvenuto nel cuore di Lione in un'atmosfera intimista. Una cucina raffinata, abbondante e di stagione è all'ordine del giorno."
    ],
    "fr": [
      "Le Dandy est heureux de vous accueillir au cœur de Lyon dans un cadre intimiste. Une cuisine raffinée, copieuse et de saison vous sera proposée par notre chef."
    ],
    "nl": [
      "Le Dandy verwelkomt u graag in het hart van Lyon in een intiem kader. Een verfijnde, overvloedige en seizoensgebonden keuken zal worden voorgesteld door onze chef-kok."
    ],
    "es": [
      "Le Dandy abre sus puertas en el centro de Lyon en un marco intimista. Nuestro chef propone una cocina refinada, copiosa y de temporada."
    ]
  },
