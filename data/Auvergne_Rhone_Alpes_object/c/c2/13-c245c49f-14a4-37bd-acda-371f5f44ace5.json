  "rdfs:comment": {
    "de": [
      "Le Hangar: Boho-Chic direkt an der Drôme. Ein entspanntes Chill-Resto für lokale Küche unter unserem Nomadenzelt. Ein eleganter, natürlicher Rahmen für Ihre Abende, Jazzy-Konzerte und Momente der Ruhe. Smart Camping pur in herrlicher Natur!"
    ],
    "en": [
      "Le Hangar at Les Chamberts: boho-chic vibes by the Drôme. A chill, relaxed eatery to enjoy local food under our stretch tent. An elegant, natural setting for your evenings, jazzy concerts & downtime. Smart camping at its best!"
    ],
    "it": [
      "Le Hangar aux Chamberts: bohemien chic sulle rive della Drôme. Un ristorante rilassato dove potrete gustare la cucina locale sotto la nostra tenda nomade. Un ambiente elegante e naturale per le vostre serate, concerti jazz e momenti di relax. Il campeggio intelligente!"
    ],
    "fr": [
      "Le Hangar aux Chamberts : l'esprit bohème chic en bord de Drôme. Un resto chill et décontracté pour savourer une cuisine locale sous notre tente nomade. Un cadre élégant et naturel pour vos soirées, concerts Jazzy et moments de détente. Le smart camping !"
    ],
    "nl": [
      "Le Hangar bij Les Chamberts: boho-chic aan de Drôme. Een chill en relaxed resto voor lokale gerechten onder onze stretchtent. Een elegant, natuurlijk decor voor uw avonden, jazzy concerten en ontspanning. Het ultieme smart camping gevoel!"
    ],
    "es": [
      "Le Hangar aux Chamberts: bohemia chic a orillas de la Drôme. Un restaurante chill y relajado donde disfrutar de la cocina local bajo nuestra tienda nómada. Un marco elegante y natural para sus veladas, conciertos de jazz y momentos de relax. El camping inteligente"
    ]
  },
  "rdfs:label": {
