  "rdfs:comment": {
    "de": [
      "Besichtigung der Honigfabrik nach telefonischer Anmeldung. Unsere Produkte: Wildblumen-, Berg-, Akazien-, Linden-, Lavendel- und Kastanienhonig. Nebenprodukte wie Bonbons und Propolis, Gelee Royale."
    ],
    "en": [
      "Honey house visits. Reservations by telephone. Our products: wild-flower honey, mountain honey, acacia honey, lime tree honey, lavender honey, chestnut honey. By-products such as confectionery, propolis, royal jelly."
    ],
    "it": [
      "Visite alla Casa del Miele su prenotazione telefonica. I nostri prodotti: mieli di fiori selvatici, di montagna, di acacia, di tiglio, di lavanda e di castagno. Sottoprodotti come dolci e propoli, pappa reale."
    ],
    "fr": [
      "Visites de la Miellerie sur réservation téléphonique. Nos produits : miels de fleurs sauvages, de montagne, d'acacia, de tilleul, de lavande, de chataîgnier. Produits dérivés comme bonbons et propolis, gelée royale."
    ],
    "es": [
      "Visitas a la Casa de la Miel con reserva telefónica. Nuestros productos: mieles de flores silvestres, de montaña, de acacia, de tilo, de lavanda y de castaño. Subproductos como caramelos y propóleos, jalea real."
    ],
    "nl": [
      "Bezoek aan de Miellerie (imkerij) na telefonische afspraak. Onze producten: honing van wilde bloemen, bergbloemen, acacia's, linde, lavendel en kastanjebomen. Aanverwante producten zoals snoep, propolis, koninginnengelei."
    ]
  },
