  "rdfs:comment": {
    "de": [
      "Die Association Multimédia Informatique Biachette organisiert einen Workshop für Erwachsene und Kinder, der von Pascal NORRE, dem Leiter des Video-Workshops, geleitet wird.\r\nBegrenzt auf 8 Teilnehmer, die ihre eigene Kamera mitbringen müssen."
    ],
    "en": [
      "The Association Multimédia Informatique Biachette is organizing a workshop open to adults and children, supervised by Pascal NORRE, leader of the video workshop.\r\nLimited to 8 participants, who must bring their own camera."
    ],
    "it": [
      "L'Associazione Multimédia Informatique Biachette organizza un corso aperto ad adulti e bambini e curato da Pascal NORRE, responsabile del laboratorio video.\r\nLimitato a 8 partecipanti, che devono portare la propria videocamera."
    ],
    "fr": [
      "L’Association Multimédia Informatique Biachette organise un stage ouvert aux adultes et enfants et encadré par Pascal NORRE, animateur de l’atelier vidéo.\r\nLimité à 8 participants, qui devront venir avec leur propre appareil photo."
    ],
    "es": [
      "La Association Multimédia Informatique Biachette organiza un curso abierto a adultos y niños y supervisado por Pascal NORRE, responsable del taller de vídeo.\r\nLimitado a 8 participantes, que deberán traer su propia cámara."
    ],
    "nl": [
      "De Association Multimédia Informatique Biachette organiseert een cursus voor volwassenen en kinderen onder leiding van Pascal NORRE, leider van de videoworkshop.\r\nBeperkt tot 8 deelnemers, die hun eigen camera moeten meebrengen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Stage photo : initiation à la prise de vue"
    ]
  },
