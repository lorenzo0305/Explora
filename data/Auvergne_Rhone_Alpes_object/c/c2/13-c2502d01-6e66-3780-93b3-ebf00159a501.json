  "rdfs:comment": {
    "de": [
      "La Grande Lessive ist ein künstlerisches, geselliges und generationenübergreifendes Ereignis. Diese Kunstausstellung unter freiem Himmel bietet sowohl Profis als auch Amateuren die Möglichkeit, ihr Talent zu einem bestimmten Thema zu enthüllen."
    ],
    "en": [
      "La Grande Lessive is an artistic, convivial and intergenerational event. This open-air art exhibition allows both professionals and amateurs to showcase their talent on a given theme."
    ],
    "it": [
      "La Grande Lessive è un evento artistico, conviviale e intergenerazionale. Questa mostra d'arte all'aperto permette a professionisti e dilettanti di mostrare il proprio talento su un tema specifico."
    ],
    "fr": [
      "La Grande Lessive est un évènement artistique, convivial et intergénérationnel. Cette exposition d'art à ciel ouvert permet aussi bien à des professionnels qu'à des amateurs de dévoiler leur talent sur un thème donné."
    ],
    "nl": [
      "La Grande Lessive is een artistiek, gezellig en intergenerationeel evenement. Deze kunsttentoonstelling in de open lucht stelt zowel professionals als amateurs in staat om hun talent rond een bepaald thema te laten zien."
    ],
    "es": [
      "La Grande Lessive es un acontecimiento artístico, de convivencia e intergeneracional. Esta exposición de arte al aire libre permite a profesionales y aficionados mostrar su talento sobre un tema determinado."
    ]
  },
