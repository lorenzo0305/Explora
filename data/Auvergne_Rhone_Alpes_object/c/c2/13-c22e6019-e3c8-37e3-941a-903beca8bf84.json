  "rdfs:comment": {
    "de": [
      "Freier Zugang zur Rodelbahn am Fuße des Skigebiets Crêt-Béni. Die Rodelbahn befindet sich rechts von der Abfahrt des Sessellifts Crêt-Béni.\r\nSie können sie mit dem kostenlosen Pendelbus oder über den fußläufigen Schneeweg erreichen (5 Minuten vom Dorfzentrum entfernt)."
    ],
    "en": [
      "Free access to the toboggan run at the foot of the Crêt-Béni ski area, located to the right of the Crêt-Béni chairlift departure point.\r\nYou can take the free shuttle bus or the pedestrian snow trail (5 minutes from the village center)."
    ],
    "it": [
      "Accesso gratuito alla pista per slittini ai piedi del comprensorio sciistico Crêt-Béni, situata a destra della partenza della seggiovia Crêt-Béni.\r\nÈ possibile raggiungerla con il bus navetta gratuito o con il sentiero pedonale (5 minuti dal centro del paese)."
    ],
    "fr": [
      "Accès libre à la piste de luge au pied du domaine skiable de Crêt-Béni, piste située à droite du départ du télésiège du Crêt-Béni. \r\nVous pouvez y accéder par la navette gratuite ou par le chemin de neige piétonnier (5 minutes du centre du village)."
    ],
    "nl": [
      "Gratis toegang tot de rodelbaan aan de voet van het skigebied Crêt-Béni, rechts van het begin van de stoeltjeslift Crêt-Béni.\r\nJe kunt er komen met de gratis pendelbus of via het voetpad (5 minuten van het dorpscentrum)."
    ],
    "es": [
      "Acceso gratuito a la pista de trineo al pie del dominio esquiable de Crêt-Béni, situada a la derecha del inicio del telesilla de Crêt-Béni.\r\nSe puede llegar en el autobús lanzadera gratuito o por el sendero (a 5 minutos del centro del pueblo)."
    ]
  },
  "rdfs:label": {
    "en": [
      "CRÊT-BÉNI SLEDGING SLOPE"
    ],
    "fr": [
      "Piste de luge du Crêt-Béni"
    ],
    "nl": [
      "Rodelbaan Crêt-Béni"
    ]
  },
