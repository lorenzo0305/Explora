  "rdfs:comment": {
    "de": [
      "Am Ruder dieses Restaurants stehen Julie und Caroline, die Töchter von Andrée Malartre und Gilbert Allard, die die dritte Generation repräsentieren und Sie zu einer Reise in die kulinarische Tradition Lyons einladen."
    ],
    "en": [
      "At the helm of this restaurant, Julie and Caroline, Malartre Andree and Gilbert Allard daughters, who represent the third generation, invite you for a trip in the Lyon culinary tradition."
    ],
    "it": [
      "Alla direzione di questo ristorante, Julie e Caroline, figlie di Andrée Malartre e di Gilbert Allard e rappresentanti della terza generazione, ti invitano a un viaggio nella tradizione culinaria lionese."
    ],
    "fr": [
      "Aux commandes de ce restaurant, Julie et Caroline, les filles d'Andrée Malartre et de Gilbert Allard, qui représentent la troisième génération vous invitent pour un voyage dans la tradition culinaire lyonnaise."
    ],
    "es": [
      "Al mando de este restaurante, Julie y Caroline, las hijas de Andrée Malartre y de Gilbert Allard, que representan la tercera generación, proponen un viaje por la tradición culinaria lionesa."
    ],
    "nl": [
      "Aan het roer van dit restaurant nodigen Julie en Caroline, de dochters van Andrée Malartre en Gilbert Allard, die de derde generatie vertegenwoordigen, u uit voor een reis door de culinaire traditie van Lyon."
    ]
  },
