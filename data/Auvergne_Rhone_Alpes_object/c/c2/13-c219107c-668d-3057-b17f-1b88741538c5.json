  "rdfs:comment": {
    "de": [
      "Seit 1934 bewirtschaftet dieser Familienbetrieb das Land im weitesten Sinne, mit einem Weinbauteil, aber auch einem landwirtschaftlichen Teil (Milch und Eier vom Bauernhof)."
    ],
    "en": [
      "Since 1934, this family farm has been cultivating the land in the broadest sense of the word, with a wine-growing part but also a dairy part."
    ],
    "it": [
      "Dal 1934, questa azienda a conduzione familiare coltiva la terra nel senso più ampio del termine, con una componente vitivinicola e una componente agricola (latte e uova da allevamento)."
    ],
    "fr": [
      "Depuis 1934, cette exploitation familiale cultive la terre au sens large, avec une partie viticole mais également une partie agricole (lait et œufs de ferme)."
    ],
    "nl": [
      "Sinds 1934 bewerkt dit familiebedrijf het land in de breedste zin van het woord, met zowel een wijnbouwcomponent als een landbouwcomponent (melk en eieren van de boerderij)."
    ],
    "es": [
      "Desde 1934, esta empresa familiar cultiva la tierra en el sentido más amplio del término, con un componente vitícola y otro agrícola (leche y huevos de granja)."
    ]
  },
