  "rdfs:comment": {
    "de": [
      "Ob mit Freunden oder der Familie – genießen Sie 6 Bowlingbahnen, 4 Billardtische, eine Cocktailbar, Pizza, Spiele (Darts, Gesellschaftsspiele, Münzspiele…) und Sport auf Großbildleinwand. Dienstags und samstags erleben Sie mitreißende Musikabende mit DJ oder Live-Band!"
    ],
    "en": [
      "With friends or family, enjoy 6 bowling lanes, 4 pool tables, a cocktail bar, pizzas, games (darts, board games, coin-operated games…) and sports on the big screen. On Tuesdays and Saturdays, feel the rhythm of our music nights with a DJ or live band!"
    ],
    "it": [
      "Con amici o in famiglia, godetevi 6 piste da bowling, 4 biliardi, un cocktail bar, pizze, giochi (freccette, da tavolo, a gettoni…) e sport su grande schermo. Il martedì e il sabato, lasciatevi coinvolgere dalle nostre serate musicali con DJ o gruppo live!"
    ],
    "fr": [
      "Entre amis ou en famille, profitez de 6 pistes de bowling, 4 billards, d’un bar à cocktails, de pizzas, de jeux (darts, société, pièces...) et sport sur grand écran. Les mardis et samedis, vibrez au rythme de nos soirées musicales avec DJ ou groupe live !"
    ],
    "nl": [
      "Met vrienden of familie, geniet van 6 bowlingbanen, 4 biljarts, een cocktailbar, pizza’s, spelletjes (darts, bordspellen, muntenmachines…) en sport op groot scherm. Op dinsdag en zaterdag geniet je van onze muziekavonden met DJ of liveband!"
    ],
    "es": [
      "Con amigos o en familia, disfrute de 6 pistas de bolos, 4 mesas de billar, un bar de cócteles, pizzas, juegos (dardos, juegos de mesa, monedas...) y deporte en la gran pantalla. Los martes y sábados, disfrute de música en directo con un DJ o una banda en vivo"
    ]
  },
