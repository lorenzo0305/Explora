  "rdfs:comment": {
    "de": [
      "Unser Team besteht aus Fachleuten, die sich für die Region des Drôme-Tals, des Diois und des südlichen Vercors begeistern. Wir kennen uns in diesen Gebieten gut aus und möchten ihre Geheimnisse mit Ihnen teilen."
    ],
    "en": [
      "Our team is made up of professionals with a passion for the Drôme Valley, Diois and South Vercors regions. As connoisseurs of these areas, we are eager to share their secrets with you."
    ],
    "it": [
      "Il nostro team è composto da professionisti con la passione per la Valle della Drôme, il Diois e il Vercors meridionale. In quanto conoscitori di queste zone, siamo desiderosi di condividere con voi i loro segreti."
    ],
    "fr": [
      "Notre équipe rassemble des professionnels passionnés par le territoire  de la Vallée de la Drôme, du Diois et du Vercors Sud. En fin connaisseurs de ces domaines, nous avons à cœur de vous en partager les secrets."
    ],
    "nl": [
      "Ons team bestaat uit professionals met een passie voor de Drômevallei, de Diois en de zuidelijke Vercors. Als kenners van deze gebieden delen we graag hun geheimen met jou."
    ],
    "es": [
      "Nuestro equipo está formado por profesionales apasionados por el valle del Drôme, Diois y el sur del Vercors. Como conocedores de estas zonas, estamos deseando compartir sus secretos con usted."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Bureau des accompagnateurs Montagne Drôme Vercors"
    ]
  },
