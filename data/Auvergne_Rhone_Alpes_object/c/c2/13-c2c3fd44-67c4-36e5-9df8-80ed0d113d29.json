  "rdfs:comment": {
    "de": [
      "Das Kern ist eine Wein- und Bierbar, aber auch ein Veranstaltungsraum mit Veranstaltungen am Donnerstag- und Freitagabend und Konzerten an Samstagen im Sommer."
    ],
    "en": [
      "At Kern, we don't only serve wine and beer, but we also hold events on Thursday and Friday evenings and concerts on Saturdays in the summer.\r\n\r\nYou can also enjoy homemade dishes made with as many organic, local and seasonal products as possible, as well as platters to share."
    ],
    "it": [
      "Le Kern non è solo un wine e beer bar, ma anche un luogo di intrattenimento con eventi il giovedì e il venerdì sera e concerti il sabato in estate."
    ],
    "fr": [
      "Le Kern, c'est un bar à vin et à bière, mais aussi une salle de spectacle avec des événements les jeudis et vendredis soirs, des concerts les samedis d'été."
    ],
    "es": [
      "Le Kern no es sólo un bar de vinos y cervezas, sino también un local de ocio con eventos los jueves y viernes por la noche y conciertos los sábados en verano."
    ],
    "nl": [
      "Le Kern is niet alleen een wijn- en bierbar, maar ook een uitgaansgelegenheid met evenementen op donderdag- en vrijdagavond en concerten op zaterdag in de zomer."
    ]
  },
