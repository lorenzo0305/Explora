  "rdfs:comment": {
    "de": [
      "Werde ein richtiger kleiner Bauer! Füttere die Tiere, striegele die Kaninchen, geh auf Eierjagd und hilf beim Saubermachen der Gehege. Ein einstündiges spielerisches und pädagogisches Erlebnis, um spielerisch auf dem Bauernhof zu lernen."
    ],
    "en": [
      "Become a real little farmer! Feed the animals, brush the rabbits, hunt for eggs and help clean the pens. A fun and educational 1-hour experience to learn while having fun on the farm."
    ],
    "it": [
      "Diventa un vero piccolo contadino! Dai da mangiare agli animali, spazzola i conigli, vai a caccia di uova e aiuta a pulire i recinti. È un modo divertente ed educativo per conoscere la fattoria in un'ora."
    ],
    "fr": [
      "Deviens un vrai petit fermier ! Nourris les animaux, brosse les lapins, pars à la chasse aux œufs et aide à nettoyer les enclos. Une expérience ludique et pédagogique d'1 heure pour apprendre en s'amusant à la ferme."
    ],
    "es": [
      "¡Conviértete en un pequeño granjero de verdad! Alimenta a los animales, cepilla a los conejos, busca huevos y ayuda a limpiar los corrales. Es una experiencia divertida y educativa de 1 hora para aprender mientras te diviertes en la granja."
    ],
    "nl": [
      "Word een echt boertje! Voer de dieren, borstel de konijnen, zoek eieren en help met het schoonmaken van de hokken. Het is een leuke, leerzame 1 uur durende ervaring om te leren terwijl je plezier hebt op de boerderij."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les samedis à la ferme - Les petits ateliers"
    ]
  },
