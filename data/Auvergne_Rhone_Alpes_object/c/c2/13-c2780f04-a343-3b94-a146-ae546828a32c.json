  "rdfs:comment": {
    "de": [
      "Der höchste Punkt des Hochplateaus von Hauteville, der Mont Planachat, erreicht eine Höhe von 1.234 Metern. Der Blick nach Osten zeigt das Massiv des Grand Colombier, das durch zahlreiche Etappen der Tour de France bekannt geworden ist, sowie die schneebedeckten Gipfel der Alpen."
    ],
    "en": [
      "The highest point of the Hauteville plateau, Mont Planachat reaches an altitude of 1,234 meters. The view to the east reveals the Grand Colombier massif, now famous due to its many Tour de France stages, as well as the snow-capped peaks of the Alps."
    ],
    "it": [
      "Il punto più alto dell'altopiano di Hauteville, il Mont Planachat, raggiunge un'altitudine di 1234 metri. La vista a est rivela il massiccio del Grand Colombier, ormai famoso in seguito alle numerose visite del Tour de France, e le cime innevate delle Alpi."
    ],
    "fr": [
      "Point culminant du plateau d'Hauteville, le mont Planachat atteint 1234 m d'altitude. La vue vers l'est révèle le massif du Grand Colombier, désormais célèbre suite aux nombreux passages du Tour de France, ainsi que les sommets enneigés des Alpes."
    ],
    "nl": [
      "Het hoogste punt van het plateau van Hauteville, de Mont Planachat, bereikt een hoogte van 1234 m. Het uitzicht in het oosten laat het Grand Colombier-massief zien, nu beroemd door de vele bezoeken van de Tour de France, evenals de besneeuwde toppen van de Alpen."
    ],
    "es": [
      "El punto más alto de la meseta de Hauteville, el Monte Planachat, alcanza una altitud de 1234 m. La vista hacia el este revela el macizo del Grand Colombier, hoy famoso tras las numerosas visitas del Tour de Francia, así como las cumbres nevadas de los Alpes."
    ]
  },
  "rdfs:label": {
    "de": [
      "Aussichtspunkt Planachat"
    ],
    "en": [
      "Planachat lookout"
    ],
    "fr": [
      "Belvédère de Planachat"
    ]
  },
