  "rdfs:comment": {
    "de": [
      "Der Strand von La Beunaz ist ein Freizeitbereich, der um einen natürlichen, temperierten Bergsee herum angelegt wurde. Er bietet zahlreiche Aktivitäten, die für alle Altersgruppen zugänglich sind."
    ],
    "en": [
      "La Beunaz beach is a leisure area built around a natural mountain lake. It offers multiple activities accessible to all age groups."
    ],
    "it": [
      "La spiaggia di La Beunaz è un'area di svago costruita attorno a un lago naturale di montagna temperato. Offre un'ampia gamma di attività accessibili a tutte le fasce d'età."
    ],
    "fr": [
      "La plage de la Beunaz est un espace de loisirs aménagé autour d’un lac naturel de montagne tempéré. Il propose de multiples activités accessibles à toutes les tranches d’âges."
    ],
    "es": [
      "La playa de La Beunaz es una zona de ocio construida alrededor de un lago natural de montaña templado. Ofrece una amplia gama de actividades accesibles para todos los grupos de edad."
    ],
    "nl": [
      "Het strand van La Beunaz is een recreatiegebied dat rond een natuurlijk, gematigd bergmeer is gebouwd. Het biedt een breed scala aan activiteiten voor alle leeftijden."
    ]
  },
