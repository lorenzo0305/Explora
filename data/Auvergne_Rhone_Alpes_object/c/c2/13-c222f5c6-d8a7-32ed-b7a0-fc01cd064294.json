  "rdfs:comment": {
    "de": [
      "Orientierungslauf mit den Schwierigkeitsgraden grün, blau und rot, damit jeder seine Orientierungswanderung in vollen Zügen genießen kann. Sie bewegen sich im Herzen des Waldes von Auteyrac - Saint-Julien-Chapteuil."
    ],
    "en": [
      "Orienteering course with green, blue, red difficulties so that everyone can fully enjoy their orienteering hike. You evolve in the heart of the forest of Auteyrac - Saint-Julien-Chapteuil."
    ],
    "it": [
      "Percorso di orienteering con difficoltà verdi, blu e rosse, in modo che tutti possano godere appieno della loro escursione di orienteering. Si evolve nel cuore della foresta di Auteyrac - Saint-Julien-Chapteuil."
    ],
    "fr": [
      "Parcours d'orientation avec les difficultés vert, bleu, rouge pour que chacun profite pleinement de sa rando'orientation. Vous évoluez  au coeur de la forêt d'Auteyrac - Saint-Julien-Chapteuil."
    ],
    "es": [
      "Recorrido de orientación con dificultades verdes, azules y rojas para que todo el mundo pueda disfrutar plenamente de su caminata de orientación. Usted evoluciona en el corazón del bosque de Auteyrac - Saint-Julien-Chapteuil."
    ],
    "nl": [
      "Oriëntatieloop met groene, blauwe en rode moeilijkheden zodat iedereen ten volle kan genieten van zijn oriëntatieloop. U ontwikkelt zich in het hart van het bos van Auteyrac - Saint-Julien-Chapteuil."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Course d'orientation - Parcours d'Auteyrac"
    ]
  },
