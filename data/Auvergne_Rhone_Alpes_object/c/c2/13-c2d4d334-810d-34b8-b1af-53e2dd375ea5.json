  "rdfs:comment": {
    "de": [
      "Jérôme Cazanave ist der Chefkoch dieses hübschen Gasthauses. Er ist ein talentierter Koch, der seine Ausbildung bei den ganz Großen (Bocuse, Bras...) absolviert hat. Jérôme Cazanave bietet eine stets abwechslungsreiche und erneuerte Küche, um Ihren Gaumen zu verwöhnen!"
    ],
    "en": [
      "Jérôme Cazanave is the chef of this charming inn. Talented chef, he has been trained by the greatest (Bocuse, Bras...). Jérôme Cazanave offers a varied and renewed cuisine for the pleasure of your taste buds!"
    ],
    "it": [
      "Jérôme Cazanave è lo chef di questa affascinante locanda. È uno chef di talento che ha lavorato con alcuni dei più grandi chef (Bocuse, Bras...). Jérôme Cazanave propone una cucina varia e rinnovata per il piacere del vostro palato!"
    ],
    "fr": [
      "Jérôme Cazanave est le chef de cette coquette auberge. Cuisinier talentueux, il a fait ses classes chez les plus grands (Bocuse, Bras...). Jérôme Cazanave propose une cuisine toujours variée et renouvelée pour le plaisir de vos papilles !"
    ],
    "nl": [
      "Jérôme Cazanave is de chef van deze charmante herberg. Hij is een getalenteerde chef die met enkele van de grootste chefs heeft gewerkt (Bocuse, Bras...). Jérôme Cazanave biedt een gevarieerde en vernieuwde keuken voor het genot van uw smaakpapillen!"
    ],
    "es": [
      "Jérôme Cazanave es el chef de esta encantadora posada. Es un chef con talento que ha trabajado con algunos de los más grandes chefs (Bocuse, Bras...). Jérôme Cazanave ofrece una cocina variada y renovada para el placer de sus papilas"
    ]
  },
