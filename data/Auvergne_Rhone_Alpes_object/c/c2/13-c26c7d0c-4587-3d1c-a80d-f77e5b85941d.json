  "rdfs:comment": {
    "de": [
      "Auf dem Gipfel des 3-Stufen-Rocks sind Sie von majestätischen Gipfeln umgeben, die sich so weit das Auge reicht erstrecken."
    ],
    "en": [
      "At the top of the 3-step rock, you are surrounded by majestic peaks that stretch as far as the eye can see."
    ],
    "it": [
      "In cima alla roccia a tre gradini, si è circondati da cime maestose che si estendono a perdita d'occhio."
    ],
    "fr": [
      "Au sommet du Roc de 3 marches, vous êtes entouré de sommets majestueux qui s'étendent à perte de vue."
    ],
    "nl": [
      "Op de top van de rots met 3 treden word je omringd door majestueuze bergtoppen die zich uitstrekken zover het oog reikt."
    ],
    "es": [
      "En la cima de la roca de 3 escalones, le rodean majestuosos picos que se extienden hasta donde alcanza la vista."
    ]
  },
