  "rdfs:comment": {
    "de": [
      "Entdecken Sie unsere verschiedenen Räume für einen Moment des Austauschs und des Genusses.\r\nWir bieten Ihnen abwechslungsreiche Menüs und flexible Räumlichkeiten für Geschäftsessen, Firmenveranstaltungen oder unvergessliche Themenabende."
    ],
    "en": [
      "Come and discover our different rooms, for a moment of sharing and pleasure.\r\nWe offer a variety of menus and flexible spaces for business meals, corporate events or unforgettable theme evenings."
    ],
    "it": [
      "Venite a scoprire le nostre diverse sale, per un momento di condivisione e piacere.\r\nOffriamo una varietà di menu e spazi flessibili per pranzi di lavoro, eventi aziendali o indimenticabili serate a tema."
    ],
    "fr": [
      "Venez  découvrir nos différentes salles, pour un moment de partage et de plaisir. \r\nNous vous proposons des menus variés et des espaces modulables, pour des repas d’affaires, des événements d’entreprises ou des soirées à thèmes inoubliables."
    ],
    "es": [
      "Venga a descubrir nuestros diferentes salones, para un momento de convivencia y placer.\r\nOfrecemos una gran variedad de menús y espacios flexibles para comidas de negocios, eventos corporativos o veladas temáticas inolvidables."
    ],
    "nl": [
      "Kom en ontdek onze verschillende zalen, voor een moment van delen en plezier.\r\nWe bieden verschillende menu's en flexibele ruimtes voor zakendiners, bedrijfsevenementen of onvergetelijke thema-avonden."
    ]
  },
