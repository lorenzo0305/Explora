  "rdfs:comment": {
    "de": [
      "Die Scourtinerie wurde 1882 gegründet und ist die letzte Scourtins-Fabrik in Frankreich. Sie öffnet Ihnen ihre Türen und lädt Sie ein, in ihrem Scourtin-Museum, ihrer Werkstatt und ihrer Boutique eine ganze Welt zu entdecken."
    ],
    "en": [
      "Founded in 1882, La Scourtinerie is France's last remaining scourtin factory. We invite you to discover our world through our scourtin museum, workshop and boutique."
    ],
    "it": [
      "Fondata nel 1882, la Scourtinerie è l'ultima fabbrica di scourtin in Francia. La Scourtinerie vi apre le sue porte e vi invita a scoprire un mondo intero attraverso il suo museo della scourtin, il suo laboratorio e il suo negozio."
    ],
    "fr": [
      "Fondée en 1882, la Scourtinerie est la dernière fabrique de scourtins de France. Elle vous ouvre ses portes et vous invite à découvrir tout un univers à travers son musée du scourtin, son atelier et sa boutique."
    ],
    "es": [
      "Fundada en 1882, la Scourtinerie es la última fábrica de scourtin de Francia. La Scourtinerie le abre sus puertas y le invita a descubrir todo un mundo a través de su museo del scourtin, su taller y su tienda."
    ],
    "nl": [
      "De Scourtinerie werd opgericht in 1882 en is de laatste scourtinefabriek in Frankrijk. De Scourtinerie opent haar deuren voor je en nodigt je uit om een hele wereld te ontdekken via het scourtinemuseum, de werkplaats en de winkel."
    ]
  },
