  "rdfs:comment": {
    "de": [
      "Das Restaurant Le Grizzly befindet sich im Zentrum des Skiortes und bietet Ihnen eine traditionelle Küche von hoher Qualität! Savoyard de Montagne Restaurant, Sommerkarte - Winterkarte mit lokalen Produkten."
    ],
    "en": [
      "Located in the center of the resort, the Grizzly restaurant offers traditional, high-quality cuisine! Savoyard mountain restaurant, summer and winter menus featuring local produce."
    ],
    "it": [
      "Situato nel centro del resort, il ristorante Grizzly offre una cucina tradizionale e di qualità! Ristorante savoiardo di montagna, menu estivo e invernale con prodotti locali."
    ],
    "fr": [
      "Situé dans le centre de la station, le restaurant le Grizzly vous propose une cuisine traditionnelle de qualité ! Restaurant Savoyard de Montagne, carte été - carte hiver de produits locaux."
    ],
    "es": [
      "Situado en el centro de la estación, el restaurante Grizzly ofrece una cocina tradicional de calidad Restaurante saboyano de montaña, menús de verano e invierno con productos locales."
    ],
    "nl": [
      "Het restaurant Grizzly ligt in het centrum van het resort en biedt een traditionele keuken van hoge kwaliteit! Savoyaards bergrestaurant, zomer- en wintermenu's met streekproducten."
    ]
  },
