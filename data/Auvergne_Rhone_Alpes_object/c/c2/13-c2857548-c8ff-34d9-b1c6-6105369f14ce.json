  "rdfs:comment": {
    "de": [
      "Gemeindesaal, der von Privatpersonen, Vereinen oder jeder anderen Struktur gemietet werden kann.\r\nInformationen über die Reservierungsbedingungen und die Belegungsplanung erhalten Sie bei der Gemeindeverwaltung (04 70 98 69 12)."
    ],
    "en": [
      "This room can be rented by individuals, associations or any other structure.\r\nInformation from the town hall for booking conditions and occupation schedule (04 70 98 69 12)."
    ],
    "it": [
      "La sala può essere affittata da privati, associazioni o qualsiasi altra struttura.\r\nInformazioni presso il municipio per le condizioni di prenotazione e gli orari di occupazione (04 70 98 69 12)."
    ],
    "fr": [
      "Salle communale pouvant être louée par des particuliers, des associations ou toute autre structure. \r\nRenseignements auprès de la mairie pour les conditions de réservation et planning d'occupation (04 70 98 69 12)."
    ],
    "es": [
      "La sala puede ser alquilada por particulares, asociaciones o cualquier otra estructura.\r\nInformación en el ayuntamiento sobre las condiciones de reserva y el calendario de ocupación (04 70 98 69 12)."
    ],
    "nl": [
      "De zaal kan worden gehuurd door particulieren, verenigingen of andere structuren.\r\nInformatie van het gemeentehuis voor reserveringsvoorwaarden en bezettingsschema (04 70 98 69 12)."
    ]
  },
  "rdfs:label": {
