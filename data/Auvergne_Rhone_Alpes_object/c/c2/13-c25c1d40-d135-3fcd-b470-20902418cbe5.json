  "rdfs:comment": {
    "de": [
      "Kleï Café Céramique in Cluses lädt Sie zu einem einzigartigen Erlebnis ein, bei dem Sie Ihre eigene Keramik bemalen und dabei eine hausgemachte Mahlzeit oder einen Kaffee genießen können."
    ],
    "en": [
      "Kleï Café Céramique in Cluses invites you to enjoy a unique experience where you can paint your own ceramics while enjoying a home-cooked meal or a coffee."
    ],
    "it": [
      "Il Kleï Café Céramique di Cluses vi invita a vivere un'esperienza unica in cui potrete dipingere le vostre ceramiche mentre gustate un pasto fatto in casa o un caffè."
    ],
    "fr": [
      "Kleï Café Céramique à Cluses vous invite à vivre une expérience unique où vous pouvez peindre votre propre céramique tout en dégustant un repas maison ou un café."
    ],
    "nl": [
      "Kleï Café Céramique in Cluses nodigt je uit voor een unieke ervaring waar je je eigen keramiek kunt beschilderen onder het genot van een huisgemaakte maaltijd of een kopje koffie."
    ],
    "es": [
      "Kleï Café Céramique de Cluses le invita a disfrutar de una experiencia única en la que podrá pintar sus propias cerámicas mientras disfruta de una comida casera o un café."
    ]
  },
  "rdfs:label": {
    "en": [
      "Kleï - Ceramic Coffee"
    ],
    "fr": [
      "Kleï - Café Céramique"
    ]
  },
