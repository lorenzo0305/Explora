  "rdfs:comment": {
    "de": [
      "Spaziergang, um die Porträts von Frauen zu entdecken, die die Stadt geprägt haben. Für alle zugänglich - wetterangepasste Kleidung mitbringen."
    ],
    "en": [
      "Stroll to discover the portraits of women who have left their mark on the city. Accessible to all - bring weather-appropriate clothing."
    ],
    "it": [
      "Passeggiate e scoprite i ritratti delle donne che hanno lasciato un segno nella città. Accessibile a tutti - portare un abbigliamento adatto alle condizioni atmosferiche."
    ],
    "fr": [
      "Balade pour découvrir le portrait de femmes qui ont marqué la ville. Accessible à tous - prévoir vêtements adaptés aux conditions climatiques."
    ],
    "es": [
      "Pasee y descubra retratos de mujeres que han dejado su huella en la ciudad. Accesible a todos - traiga ropa adecuada para el tiempo."
    ],
    "nl": [
      "Maak een wandeling en ontdek portretten van vrouwen die hun stempel op de stad hebben gedrukt. Toegankelijk voor iedereen - breng voor het weer geschikte kleding mee."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Balade autour des femmes remarquables"
    ]
  },
