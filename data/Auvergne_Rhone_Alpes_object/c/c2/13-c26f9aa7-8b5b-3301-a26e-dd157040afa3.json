  "rdfs:comment": {
    "de": [
      "Skulpturenausstellung von Valérie Berthéas und Sylvaine Martel.\r\nVom 2. Dezember bis zum 14. März, während der Öffnungszeiten der Bibliothek.\r\nDie Künstlerinnen sind am Mittwoch, den 18. Februar und 4. März von 14 bis 17 Uhr anwesend."
    ],
    "en": [
      "Sculpture exhibition by Valérie Berthéas and Sylvaine Martel.\r\nFrom December 2 to March 14, during library opening hours.\r\nThe artists will be present from 2pm to 5pm on Wednesdays, February 18 and March 4."
    ],
    "it": [
      "Mostra di sculture di Valérie Berthéas e Sylvaine Martel.\r\nDal 2 dicembre al 14 marzo, durante gli orari di apertura della biblioteca.\r\nLe artiste saranno a disposizione dalle 14.00 alle 17.00 di mercoledì 18 febbraio e mercoledì 4 marzo."
    ],
    "fr": [
      "Exposition de sculptures de Valérie Berthéas et Sylvaine Martel.\r\nDu 2 décembre au 14 mars, aux horaires d'ouverture de la bibliothèque.\r\nLes artistes seront présentes de 14h à 17h les mercredis 18 février et 4 mars."
    ],
    "nl": [
      "Tentoonstelling van beelden van Valérie Berthéas en Sylvaine Martel.\r\nVan 2 december tot 14 maart, tijdens openingsuren van de bibliotheek.\r\nDe kunstenaars zijn aanwezig van 14.00 tot 17.00 uur op woensdag 18 februari en woensdag 4 maart."
    ],
    "es": [
      "Exposición de esculturas de Valérie Berthéas y Sylvaine Martel.\r\nDel 2 de diciembre al 14 de marzo, durante el horario de apertura de la biblioteca.\r\nLas artistas estarán presentes de 14.00 a 17.00 h el miércoles 18 de febrero y el miércoles 4 de marzo."
    ]
  },
