  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Terrakotta-Skulpturen von Sébastien Alibert, in denen sich Materialien und Emotionen begegnen. Die Ausstellung ist in der Galerie Jean-Claude Simon im Hôtel du Département zu finden."
    ],
    "en": [
      "Discover the terracotta sculptures of Sébastien Alibert, where materials and emotions meet. Exhibition at the Jean-Claude Simon Gallery, Hôtel du Département."
    ],
    "it": [
      "Scoprite le sculture in terracotta di Sébastien Alibert, dove materiali ed emozioni si incontrano. Mostra presso la galleria Jean-Claude Simon, Hôtel du Département."
    ],
    "fr": [
      "Découvrez les sculptures en terre cuite de Sébastien Alibert, où matières et émotions se rencontrent. Exposition à retrouver à la galerie Jean-Claude Simon, à l'Hôtel du Département."
    ],
    "nl": [
      "Ontdek de terracotta sculpturen van Sébastien Alibert, waar materialen en emoties elkaar ontmoeten. Tentoonstelling in de galerie Jean-Claude Simon, Hôtel du Département."
    ],
    "es": [
      "Descubra las esculturas de terracota de Sébastien Alibert, en las que confluyen materiales y emociones. Exposición en la galería Jean-Claude Simon, Hôtel du Département."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Exposition : « Mutatis Mutandis » par Sébastien Alibert"
    ]
  },
