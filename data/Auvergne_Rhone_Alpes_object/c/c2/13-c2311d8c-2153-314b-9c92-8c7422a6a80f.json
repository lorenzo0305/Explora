  "rdfs:comment": {
    "de": [
      "Week&Sport wurde 2019 gegründet und ist eine Eventagentur in Roanne, die sich auf die Konzeption und Organisation von Sportveranstaltungen für alle im Großraum Roanne, in der AURA und darüber hinaus spezialisiert hat."
    ],
    "en": [
      "Founded in 2019, Week&Sport is a Roanne-based event agency specializing in the design and organization of sporting events for all, in the Roanne conurbation, AURA and beyond."
    ],
    "it": [
      "Creata nel 2019, Week&Sport è un'agenzia di eventi con sede a Roanne specializzata nella progettazione e nell'organizzazione di eventi sportivi per tutti, nell'agglomerato di Roanne, nell'AURA e oltre."
    ],
    "fr": [
      "Créée en 2019, Week&Sport est une agence événementielle roannaise spécialisée dans la conception et l’organisation d’événements sportifs pour tous, sur le territoire de l’agglomération roannaise, AURA et au-delà."
    ],
    "nl": [
      "Week&Sport, opgericht in 2019, is een evenementenbureau uit Roanne dat gespecialiseerd is in het bedenken en organiseren van sportevenementen voor iedereen, in de agglomeratie Roanne, AURA en daarbuiten."
    ],
    "es": [
      "Creada en 2019, Week&Sport es una agencia de eventos con sede en Roanne especializada en el diseño y la organización de eventos deportivos para todos, en la aglomeración de Roanne, AURA y más allá."
    ]
  },
