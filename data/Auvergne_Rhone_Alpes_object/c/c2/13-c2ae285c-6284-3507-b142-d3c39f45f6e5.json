  "rdfs:comment": {
    "de": [
      "Les Monts d'Argent, so hieß die Gemeinde Peisey während der französischen Revolution, was von der Bedeutung der Blei- und Silberminen zeugt."
    ],
    "en": [
      "Les Monts d'Argent was the name of the municipality of Peisey during the French Revolution, reflecting the importance of the lead and silver mines"
    ],
    "it": [
      "Les Monts d'Argent era il nome del comune di Peisey durante la rivoluzione francese, che rifletteva l'importanza delle miniere di piombo e argento"
    ],
    "fr": [
      "Les Monts d'Argent, tel était le nom de la commune de Peisey sous la révolution française, témoignant l'importance des mines de plomb et d'argent"
    ],
    "nl": [
      "Les Monts d'Argent was de naam van de gemeente Peisey tijdens de Franse revolutie, als gevolg van het belang van de lood- en zilvermijnen"
    ],
    "es": [
      "Les Monts d'Argent era el nombre de la comuna de Peisey durante la revolución francesa, reflejando la importancia de las minas de plomo y plata"
    ]
  },
