  "rdfs:comment": {
    "de": [
      "Was auch immer das Wetter ist, wir sind auf dem Wasser! Rêve d'eau empfängt Sie in seiner Basis in Gotthard neben der Wasserfläche des Freizeitzentrums Les Versants d'Aime."
    ],
    "en": [
      "Whatever the weather, we're on the water! Rêve d'Eau welcomes you to its Gothard base beside the water at Macôt, the leisure centre of the islands"
    ],
    "it": [
      "Qualunque sia il tempo, siamo in acqua! Rêve d'eau vi accoglie nella sua base di Le Gothard, vicino al lago del centro ricreativo delle piste di Aime"
    ],
    "fr": [
      "Quelle que soit la mété'eau on est sur l'eau ! Rêve d'eau vous accueille dans sa base du Gothard à coté du plan d'eau de la base de loisirs des versants d'Aime"
    ],
    "nl": [
      "Wat voor weer het ook is, wij zijn op het water! Rêve d'eau verwelkomt je op zijn basis in Le Gothard, naast het meer bij het recreatiecentrum Aime slopes."
    ],
    "es": [
      "Haga el tiempo que haga, ¡estamos en el agua! Rêve d'eau le da la bienvenida en su base de Le Gothard, junto al lago del centro de ocio de las pistas de Aime"
    ]
  },
  "rdfs:label": {
