  "rdfs:comment": {
    "de": [
      "Route nur bergauf.\r\nVon der Kédeuze-Gondelbahn aus folgen Sie dem Combe-Pfad am Waldrand auf der rechten Seite und schließen sich dann der Schneeschuhroute an. Das Ziel befindet sich auf dem Gipfel von Kédeuze."
    ],
    "en": [
      "Track for going up only.\r\nStart from the Kédeuze télécabine, follow the Combe piste on the right side then on theright, follow the snowshoe trail up to L'Anfionne restaurant. The arrival is at the top the Kédeuze telecabine. Follow the forest."
    ],
    "it": [
      "Itinerario solo in salita.\r\nDalla funivia di Kédeuze, seguire il sentiero della Combe ai margini del bosco sulla destra, quindi unirsi al percorso con le racchette da neve. L'arrivo è in cima a Kédeuze."
    ],
    "fr": [
      "Itinéraire seulement en montée.\r\nAu départ de la télécabine de la Kédeuze, suivre la piste Combe à la  lisière de la forêt sur votre droite, puis rejoindre l'itinéraire raquettes. L'arrivée se situe au sommet de Kédeuze."
    ],
    "nl": [
      "Start vanaf de Kédeuze télécabine, volg de Combe piste aan de rechterzijde vervolgens op theright, volg dan de sneeuwschoentrail tot L'Anfionne restaurant. De aankomst is op de top van de Kédeuze telecabine. Volg het bos."
    ],
    "es": [
      "Itinerario sólo cuesta arriba.\r\nDesde el teleférico de Kédeuze, siga el sendero Combe en el linde del bosque, a la derecha, y luego incorpórese a la ruta de raquetas de nieve. La llegada es en la cima de Kédeuze."
    ]
  },
  "rdfs:label": {
    "en": [
      "Plein Soleil - Ski touring"
    ],
    "fr": [
      "Itinéraire de ski de randonnée en journée - Plein Soleil"
    ],
    "nl": [
      "Plein Soleil - Ski touring"
    ]
  },
