  "rdfs:comment": {
    "de": [
      "Das Office de Tourisme du Pays Rochois befindet sich im Maison du Pays Rochois, mitten im Stadtzentrum und am Fuße des Andrevetan-Parkplatzes. Es ist das ganze Jahr über von Montag bis Samstag geöffnet."
    ],
    "en": [
      "The Pays Rochois Tourist Office is located in the Maison du Pays Rochois, right in the town centre and next to the Andrevetan car park. It is open all year round from Monday to Saturday."
    ],
    "it": [
      "L'Ufficio del Turismo del Pays Rochois si trova nella Maison du Pays Rochois, nel centro della città e ai piedi del parcheggio Andrevetan. È aperto tutto l'anno dal lunedì al sabato."
    ],
    "fr": [
      "L'Office de Tourisme du Pays Rochois est situé dans la Maison du Pays Rochois, en plein centre de la ville et au pied du parking Andrevetan. Il est ouvert toute l’année du lundi au samedi."
    ],
    "es": [
      "La Oficina de Turismo del Pays Rochois se encuentra en la Maison du Pays Rochois, en pleno centro de la ciudad y al pie del aparcamiento Andrevetan. Está abierta todo el año, de lunes a sábado."
    ],
    "nl": [
      "Het VVV-kantoor van Pays Rochois bevindt zich in het Maison du Pays Rochois, in het centrum van de stad en aan de voet van de Andrevetan parkeerplaats. Het is het hele jaar geopend van maandag tot zaterdag."
    ]
  },
