  "rdfs:comment": {
    "de": [
      "Schöne, frische, regionale Früchte, ein wenig Zucker und eine altmodische Technik, wie sie schon unsere Großmütter auf völlig handwerkliche Weise anwandten."
    ],
    "en": [
      "Beautiful fresh regional fruit, a little sugar and an old-fashioned technique just like our grandmothers used to make, in a completely artisanal way."
    ],
    "it": [
      "Bella frutta fresca regionale, un po' di zucchero e una tecnica all'antica come facevano le nostre nonne, in modo del tutto tradizionale."
    ],
    "fr": [
      "De beaux fruits frais régionaux, un peu de sucre et une technique à l’ancienne comme le faisaient nos grands-mères, de manière complètement artisanale."
    ],
    "nl": [
      "Mooi vers streekfruit, een beetje suiker en een ouderwetse techniek zoals onze grootmoeders vroeger deden, op geheel ambachtelijke wijze."
    ],
    "es": [
      "Hermosa fruta fresca de la región, un poco de azúcar y una técnica anticuada como la que hacían nuestras abuelas, de forma totalmente tradicional."
    ]
  },
