  "rdfs:comment": {
    "de": [
      "Café, Restaurant, Lebensmittelgeschäft und Weinbar in einem industriellen Dekor mit 2 Sälen und einer Terrasse. Ein echter Ort des Austauschs und der Geselligkeit rund um eine hochwertige Familienküche."
    ],
    "en": [
      "Café, restaurant, grocery store and wine bar in an industrial setting with 2 rooms and a terrace. A real place for sharing and conviviality around a quality family cuisine."
    ],
    "it": [
      "Caffè, ristorante, drogheria ed enoteca in un ambiente industriale con 2 sale e una terrazza. Un vero e proprio luogo di condivisione e convivialità attorno a una cucina familiare di qualità."
    ],
    "fr": [
      "Café, restaurant, épicerie et bar à vins dans un décor industriel avec 2 salles et une terrasse. Véritable lieu de partages et de convivialité autour d'une cuisine familiale de qualité."
    ],
    "es": [
      "Café, restaurante, tienda de comestibles y bar de vinos en un entorno industrial con 2 salas y una terraza. Un verdadero lugar para compartir y convivir en torno a una cocina familiar de calidad."
    ],
    "nl": [
      "Café, restaurant, kruidenier en wijnbar in een industriële omgeving met 2 zalen en een terras. Een echte plek voor samen delen en gezelligheid rond een kwaliteitsvolle familiekeuken."
    ]
  },
  "rdfs:label": {
