  "rdfs:comment": {
    "de": [
      "Hast du schon einmal um Hilfe gebeten? Kann man als Kind helfen? Gibt es verschiedene Arten zu helfen? Wie würde eine Welt aussehen, in der niemand dem anderen hilft?"
    ],
    "en": [
      "Have you ever asked for help? Can you help as a child? Are there different ways of helping? What would a world be like where nobody ever helped each other?"
    ],
    "it": [
      "Avete mai chiesto aiuto? Siete in grado di aiutare da bambini? Esistono diversi modi di aiutare? Come sarebbe un mondo in cui nessuno si aiuta mai?"
    ],
    "fr": [
      "As-tu déjà demandé de l’aide ? Peut-on aider quand on est enfants ? Y a-t-il différentes façons d’aider ? Que serait un monde où personne ne s’aide jamais ?"
    ],
    "es": [
      "¿Has pedido ayuda alguna vez? ¿Puedes ayudar de niño? ¿Hay distintas formas de ayudar? ¿Cómo sería un mundo en el que nadie se ayudara nunca?"
    ],
    "nl": [
      "Heb je ooit om hulp gevraagd? Kun je als kind helpen? Zijn er verschillende manieren om te helpen? Hoe zou een wereld eruit zien waarin niemand elkaar ooit hielp?"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les P'tits philosophes : \"Aider, c'est quoi ?\""
    ]
  },
