  "rdfs:comment": {
    "de": [
      "In den Monts de la Madeleine ernten und kultivieren wir von Hand Pflanzen und Früchte aus biologischem Anbau. Kräutertees, Aromaten, Marmeladen, Sirupe, Honig, Hydrolate... Entdecken Sie alles, was die Natur für unser Vergnügen und Wohlbefinden zu bieten hat."
    ],
    "en": [
      "In the Monts de la Madeleine, we harvest and grow organic plants and fruit by hand. Herbal teas, aromatics, jams, syrups, honeys, hydrolats... discover all that nature has to offer for our pleasure and well-being."
    ],
    "it": [
      "Nei Monts de la Madeleine, raccogliamo e coltiviamo a mano piante e frutti biologici. Tisane, aromi, marmellate, sciroppi, mieli, idrolati... scoprite tutto ciò che la natura ci offre per il nostro piacere e benessere."
    ],
    "fr": [
      "Dans les monts de la Madeleine, nous récoltons et cultivons à la main, plantes et fruits en Agriculture Biologique. Tisanes, aromates, confitures, sirops, miels, Hydrolats... découvrez tout ce que la nature offre pour notre plaisir et notre bien-être."
    ],
    "nl": [
      "In de Monts de la Madeleine oogsten en telen we met de hand biologische planten en fruit. Kruidenthee, aromaten, jam, siroop, honing, hydrolaat... ontdek alles wat de natuur te bieden heeft voor ons plezier en welzijn."
    ],
    "es": [
      "En los Monts de la Madeleine, cosechamos y cultivamos a mano plantas y frutos ecológicos. Tisanas, aromáticas, mermeladas, siropes, mieles, hidrolatos... descubra todo lo que la naturaleza nos ofrece para nuestro placer y bienestar."
    ]
  },
  "rdfs:label": {
    "fr": [
