  "rdfs:comment": {
    "de": [
      "Die Pizzeria Chez Pierrot bietet seit 1979 eine traditionelle und authentische Küche. Die Familie Lillaz ist italienischen Ursprungs und empfängt Sie in einem typisch savoyischen Rahmen. Entdecken Sie unsere Familienrezepte in einem Dekor aus handgefertigtem Holz."
    ],
    "en": [
      "Pizzeria Chez Pierrot has been serving traditional, authentic cuisine since 1979. Of Italian origin, the Lillaz family welcomes you in a typically Savoyard setting. Come and discover our family recipes in a handmade wooden décor."
    ],
    "it": [
      "La Pizzeria Chez Pierrot propone una cucina tradizionale e autentica dal 1979. Di origine italiana, la famiglia Lillaz vi accoglie in un ambiente tipicamente savoiardo. Venite a scoprire le nostre ricette di famiglia in un ambiente in legno fatto a mano."
    ],
    "fr": [
      "La Pizzeria Chez Pierrot propose une cuisine traditionnelle et authentique depuis 1979. D'origine italienne, la famille Lillaz vous accueille dans un cadre typiquement savoyard. Venez découvrir nos recettes familiales dans un décor en bois fait main."
    ],
    "nl": [
      "Pizzeria Chez Pierrot serveert sinds 1979 een traditionele, authentieke keuken. De van oorsprong Italiaanse familie Lillaz ontvangt u in een typisch Savoyaards decor. Ontdek onze familierecepten in een handgemaakt houten decor."
    ],
    "es": [
      "La pizzería Chez Pierrot sirve cocina tradicional y auténtica desde 1979. De origen italiano, la familia Lillaz le da la bienvenida en un ambiente típicamente saboyano. Venga a descubrir nuestras recetas familiares en un decorado artesanal de madera."
    ]
  },
