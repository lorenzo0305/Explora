  "rdfs:comment": {
    "de": [
      "Nach einem Tag auf der Skipiste können Sie sich in der Bodega aufwärmen. Sie liegt am Fuße der Pisten und neben dem Restaurant Le Dahu."
    ],
    "en": [
      "After a day skiing, come and relax at La Bodega bar, right next to le Dahu restaurant."
    ],
    "it": [
      "Dopo una giornata sulle piste, venite a riscaldarvi alla Bodega, situata ai piedi delle piste e accanto al ristorante Dahu."
    ],
    "fr": [
      "Après une journée au ski, venez vous réchauffer à la Bodega, situé au pied des pistes et à côté du restaurant le Dahu."
    ],
    "nl": [
      "Na een dag skiën, kom je opwarmen in de Bodega, gelegen aan de voet van de pistes en naast het Dahu-restaurant."
    ],
    "es": [
      "Después de un día en las pistas, ven a calentarte en la Bodega, situada a pie de pistas y junto al restaurante Dahu."
    ]
