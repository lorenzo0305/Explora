  "rdfs:comment": {
    "de": [
      "Entdecken Sie ô Des Cimes Spas d'Altitude. Ein einzigartiges Spa, in dem Körper und Geist eins werden.\r\nEntdecken Sie unsere außergewöhnlichen Behandlungen mit der Marke CODAGE, Gesichts- und Körperbehandlungen, maßgeschneiderte Modellagen."
    ],
    "en": [
      "Discover ô Des Cimes Spas d'Altitude. A unique Spa where body and mind are one.\r\nDiscover our exceptional treatments with the CODAGE brand, face and body treatments, tailor-made massages."
    ],
    "it": [
      "Scoprite ô Des Cimes Spas d'Altitude. Una Spa unica dove corpo e mente sono un tutt'uno.\r\nScoprite i nostri trattamenti eccezionali con il marchio CODAGE, i trattamenti viso e corpo, la modellazione su misura."
    ],
    "fr": [
      "Découvrez ô Des Cimes Spas d'Altitude. Un Spa unique où corps et esprit ne font qu'un. \r\nDécouvrez nos soins d'exception avec la marque CODAGE, soins visages et corps, modelages sur mesure."
    ],
    "nl": [
      "Ontdek ô Des Cimes Spas d'Altitude. Een unieke spa waar lichaam en geest één zijn.\r\nOntdek onze uitzonderlijke behandelingen met het merk CODAGE, gezichts- en lichaamsbehandelingen, massages op maat."
    ],
    "es": [
      "Descubra ô Des Cimes Spas d'Altitude. Un Spa único donde cuerpo y mente son uno.\r\nDescubra nuestros tratamientos excepcionales con la marca CODAGE, tratamientos faciales y corporales, modelado a medida."
    ]
  },
