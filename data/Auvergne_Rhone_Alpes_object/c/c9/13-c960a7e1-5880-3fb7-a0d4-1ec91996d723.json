  "rdfs:comment": {
    "de": [
      "Hauptsächlich für unsere englischsprachigen Freunde, mit dem Ziel, die Unterrichtstechniken des Skifahrens und seiner Derivate zu diversifizieren.\r\nInternational ESF bietet Ihnen dank seiner angepassten Organisation Kurse in einem anderen Geist an."
    ],
    "en": [
      "Mainly for our English-speaking friends, with the aim of diversifying the teaching techniques of skiing and other snow disciplines.\r\nInternational ESF adapts its organisation to offer a different style of lesson."
    ],
    "it": [
      "Principalmente per i nostri amici di lingua inglese, con l'obiettivo di diversificare le tecniche di insegnamento dello sci e dei suoi derivati.\r\nIl FSE internazionale, grazie alla sua organizzazione adattata, vi offre lezioni con uno spirito diverso."
    ],
    "fr": [
      "Principalement pour nos amis de langue anglaise, dans le but de diversifier les techniques d'enseignements du ski et de ses dérivés.\r\nInternational ESF grâce à son organisation adaptée, vous propose des cours dans un esprit différent."
    ],
    "es": [
      "Principalmente para nuestros amigos de habla inglesa, con el objetivo de diversificar las técnicas de enseñanza del esquí y sus derivados.\r\nEl FSE Internacional, gracias a su organización adaptada, le ofrece lecciones con un espíritu diferente."
    ],
    "nl": [
      "Hoofdzakelijk voor onze Engelstalige vrienden, met als doel de onderwijstechnieken van ski en afgeleide sporten te diversifieren.\r\nDank zij zijn aangepaste organisatie stelt International ESF U lessen voor in een andere geest."
    ]
  },
