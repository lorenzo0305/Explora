  "rdfs:comment": {
    "de": [
      "Ausstellung alter Gegenstände, Werkzeuge aus der Zeit und Ölmühle.\r\nErklärendes Video über die Herstellung von Olivenöl.\r\nDie Ausstellung ist hinter einer Glasscheibe sichtbar. Kostenlose Führungen an Mittwochvormittagen im Juli und August."
    ],
    "en": [
      "Exhibition of old objects, period tools and oil mill.\r\nExplanatory video on the production of olive oil.\r\nFree access. Free guided tours on Wednesday mornings in July and August."
    ],
    "it": [
      "Esposizione di oggetti antichi, attrezzi d'epoca e un frantoio.\r\nVideo che spiega come si produce l'olio d'oliva.\r\nMuseo accessibile dall'esterno e visite guidate gratuite il mercoledì mattina (ore 10) in luglio e agosto."
    ],
    "fr": [
      "Exposition d'objets anciens, outils d'époque et moulin à huile.\r\nVidéo explicative sur la fabrication de l'huile d'olive.\r\nMusée accessible de l'extérieur et visites guidées gratuites les mercredis matins (10h) en juillet août."
    ],
    "nl": [
      "Tentoonstelling van historische voorwerpen, oud gereedschap en een oliemolen.\r\nToelichtende video over het maken van olijfolie.\r\nTentoonstelling zichtbaar achter glas. Gratis rondleidingen op woensdagochtend in juli en augustus."
    ],
    "es": [
      "Exposición de objetos antiguos, herramientas de época y un molino de aceite.\r\nVídeo explicativo sobre la elaboración del aceite de oliva.\r\nMuseo accesible desde el exterior y visitas guiadas gratuitas los miércoles por la mañana (10 h) en julio y agosto."
    ]
  },
  "rdfs:label": {
    "en": [
