  "rdfs:comment": {
    "de": [
      "Die Association Horticole de Cusset lädt Sie zu ihren monatlichen Treffen ein, die für alle Gartenliebhaber offen sind! Praktische Ratschläge, Austausch, Tipps zur Jahreszeit? Ein geselliger Moment, um Ihre Leidenschaft zu pflegen und Ihre Ideen zum Blühen zu bringen."
    ],
    "en": [
      "The Association Horticole de Cusset invites you to its monthly meetings, open to all gardening enthusiasts! Practical advice, discussion, seasonal tips? A convivial moment to cultivate your passion and let your ideas blossom."
    ],
    "it": [
      "L'Associazione Orticola di Cusset vi invita alle sue riunioni mensili, aperte a tutti gli appassionati di giardinaggio! Consigli pratici, discussioni, suggerimenti stagionali? È un ottimo modo per coltivare la vostra passione e far decollare le vostre idee."
    ],
    "fr": [
      "L’Association Horticole de Cusset vous invite à ses réunions mensuelles, ouvertes à tous les amoureux du jardinage ! Conseils pratiques, échanges, astuces de saison… Un moment convivial pour cultiver votre passion et faire fleurir vos idées."
    ],
    "es": [
      "La Association Horticole de Cusset le invita a sus reuniones mensuales, abiertas a todos los aficionados a la jardinería Consejos prácticos, debates, trucos de temporada.. Es una buena manera de cultivar su pasión y poner en marcha sus ideas."
    ],
    "nl": [
      "De Association Horticole de Cusset nodigt je uit op haar maandelijkse bijeenkomsten, open voor alle tuinliefhebbers! Praktisch advies, discussie, seizoensgebonden tips? Het is een geweldige manier om je passie te cultiveren en je ideeën van de grond te krijgen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Réunions mensuelles • Association horticole de Cusset"
    ]
  },
