  "rdfs:comment": {
    "de": [
      "Diese Route führt über die gleichen Wege wie die \"Quellen der Gourdonne\". Sie verlängern die Route durch die Überreste der Bergbauvergangenheit des Standorts La Bosse; Kaolin- und Wolframbergwerke."
    ],
    "en": [
      "This itinerary follows the same paths as those of the \"Sources de la Gourdonne\". The route continues through the remains of La Bosse's mining past: kaolin and wolfram mines."
    ],
    "it": [
      "Questo itinerario segue gli stessi percorsi delle \"sources de la Gourdonne\". Il percorso si estende attraverso i resti del passato minerario del sito di La Bosse: miniere di caolino e wolframio."
    ],
    "fr": [
      "Cet itinéraire  emprunte les mêmes sentiers que ceux des « sources de la Gourdonne ». Vous prolongez l'itinéraire à travers les vestiges du passé minier du site de La Bosse ; mines de kaolin et de wolfram."
    ],
    "es": [
      "Este itinerario sigue los mismos caminos que los de las \"fuentes de la Gourdonne\". Se prolonga la ruta por los restos del pasado minero del yacimiento de La Bosse; minas de caolín y de wolframio."
    ],
    "nl": [
      "Deze route volgt dezelfde paden als die van de \"sources de la Gourdonne\". U verlengt de route door de overblijfselen van het mijnverleden van de site van La Bosse; kaolien- en wolframmijnen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Spot Trail de La Bosse - Le Puy Juillat et ses mines"
    ]
  },
