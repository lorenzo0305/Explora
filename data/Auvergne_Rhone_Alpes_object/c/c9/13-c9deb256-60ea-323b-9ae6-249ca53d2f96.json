  "rdfs:comment": {
    "de": [
      "Neu in Morillon! Forellenangeln im Winter ist möglich! Der Lac Bleu wird für den Winter zum Angelreservoir.\r\nBitte befolgen Sie die Regeln und setzen Sie Ihre Fische zurück ins Wasser und versorgen Sie sie gut mit Sauerstoff, um ein Sterben zu verhindern."
    ],
    "en": [
      "New in Morillon! Trout fishing in winter is now possible! Lac Bleu has become a winter fishing reservoir.\r\nPlease follow the rules and return your fish to the water, oxygenating them well to avoid mortality."
    ],
    "it": [
      "Novità a Morillon! La pesca alla trota in inverno è ora possibile! Il Lac Bleu è stato trasformato in un lago artificiale per la pesca invernale.\r\nVi preghiamo di rispettare le regole e di riportare i vostri pesci in acqua e di ossigenarli bene per evitare la mortalità."
    ],
    "fr": [
      "Nouveau à Morillon ! La pêche à la truite en hiver c'est possible ! Le lac Bleu devient pour l'hiver un réservoir de pêche.\r\nMerci de suivre les règles et de remettre vos poissons à l'eau et de bien les oxygéner afin d'éviter la mortalité."
    ],
    "es": [
      "¡Nuevo en Morillon! Ya es posible pescar truchas en invierno Lac Bleu se ha convertido en un embalse para la pesca invernal.\r\nLe rogamos que respete las normas, devuelva los peces al agua y los oxigene bien para evitar su mortandad."
    ],
    "nl": [
      "Nieuw in Morillon! Forelvissen in de winter is nu mogelijk! Lac Bleu is omgevormd tot een stuwmeer voor wintervissen.\r\nVolg de regels en breng je vissen terug naar het water en geef ze goed zuurstof om sterfte te voorkomen."
    ]
  },
  "rdfs:label": {
    "en": [
      "Blue lake fishing in winter"
    ],
    "fr": [
      "Pêche dans le lac bleu en hiver"
    ],
    "nl": [
      "Vissen in het Blauwe Meer in de winter"
    ]
  },
