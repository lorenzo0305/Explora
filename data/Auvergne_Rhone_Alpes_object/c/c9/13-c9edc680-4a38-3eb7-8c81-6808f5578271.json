  "rdfs:comment": {
    "de": [
      "Bergbegleiterin und Coach Expertin für Rückverbindung und Körperpsychotherapie. Wiedererlangen des Gleichgewichts und der Körper-Geist-Verbindung für ein ganzheitliches, energiereiches Wohlbefinden, um Ihre Beziehung zur Welt und zu sich selbst zu harmonisieren"
    ],
    "en": [
      "Mountain Leader and Coach Expert in Reconnection and Body-Psychotherapy. Rediscover balance and the mind-body connection for a global well-being rich in energy to harmonize your relationship with the world and with yourself"
    ],
    "it": [
      "Leader e coach di montagna, esperto di riconnessione e terapia mente-corpo. Riscoprire l'equilibrio e la connessione mente-corpo per un benessere globale ricco di energia per armonizzare il rapporto con il mondo e con se stessi"
    ],
    "fr": [
      "Accompagnatrice en montagne et Coach Experte en reconnexion et Thérapie psycho-corporel. Retrouver l'équilibre et le lien corps-esprit pour un bien-être global riche en énergie pour harmoniser votre relation au monde et à vous même"
    ],
    "es": [
      "Líder y coach de montaña, experto en reconexión y terapia mente-cuerpo. Redescubre el equilibrio y la conexión mente-cuerpo para un bienestar general rico en energía que armonice tu relación con el mundo y contigo mismo"
    ],
    "nl": [
      "Bergleider en coach, expert in herverbinding en mind-body therapie. Herontdek balans en de mind-body connectie voor een algeheel welzijn rijk aan energie om je relatie met de wereld en met jezelf te harmoniseren"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Olivia accompagnatrice en montagne spécialisée dans le bien-être et le sport santé."
    ]
  },
