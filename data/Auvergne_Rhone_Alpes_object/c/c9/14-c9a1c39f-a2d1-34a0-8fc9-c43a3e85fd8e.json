  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/11ac9f17-df8a-394b-80a9-62079ec18e3e",
      "dc:description": {
        "de": [
          "Die Gemeinde Campagne-les-Boulonnais organisiert einen Flohmarkt und eine Ducasse\nVon 06.30 bis 18.00 Uhr\n\nEs wird verschiedene Animationen und Spiele sowie Karussells geben ... und noch viel mehr!\nDie Standplätze sind kostenlos, aber nur mit Reservierung"
        ],
        "en": [
          "The commune of Campagne-les-Boulonnais organizes a garage sale and a ducasse\nFrom 06h30 to 18h00\n\nThere will be entertainment and various games as well as merry-go-rounds...and much more!\nPitches are free, but reservations are required"
        ],
        "it": [
          "Il Comune di Campagne-les-Boulonnais organizza un mercatino dell'usato e un luna park\nDalle 06h30 alle 18h00\n\nCi saranno animazioni e giochi vari, giostre... e molto altro ancora!\nLe piazzole sono gratuite ma devono essere prenotate in anticipo"
        ],
        "fr": [
          "La Commune de Campagne-les-Boulonnais organise un vide grenier et une ducasse\nDe 06h30 à 18h00\n\nIl y aura des animations et des jeux divers ainsi que des manèges...et bien plus encore !\nLes emplacements sont gratuits mais sur réservation"
        ],
        "es": [
          "El Ayuntamiento de Campagne-les-Boulonnais organiza una venta de garaje y un parque de atracciones\nDe 06h30 a 18h00\n\nHabrá animaciones y juegos diversos, así como tiovivos... ¡y mucho más!\nLas parcelas son gratuitas pero deben reservarse con antelación"
        ],
        "nl": [
          "De gemeente Campagne-les-Boulonnais organiseert een garageverkoop en kermis\nVan 06u30 tot 18u00\n\nEr zijn animaties, verschillende spelletjes en draaimolens... en nog veel meer!\nDe staanplaatsen zijn gratis, maar moeten van tevoren worden gereserveerd"
        ]
      },
      "@type": [
