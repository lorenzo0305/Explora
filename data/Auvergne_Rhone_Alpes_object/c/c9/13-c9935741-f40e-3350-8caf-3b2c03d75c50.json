  "rdfs:comment": {
    "de": [
      "Das im Herzen des Bourbonnais gelegene Haus Fayet baut einen außergewöhnlichen Safran an und bietet ihn in Form einer Reihe von Produkten an, die ebenso köstlich wie originell sind."
    ],
    "en": [
      "Visit of the saffron farm and its by-products.\r\nProducts offered: saffron syrup, cider vinegar / saffron mustard, white wine jelly with saffron, saffron jams (apple, apricot, banana / rum, plum ...)."
    ],
    "it": [
      "Situata nel cuore della regione del Bourbonnais, la Maison Fayet coltiva uno zafferano eccezionale e offre una gamma di prodotti deliziosi e originali."
    ],
    "fr": [
      "Installée au coeur du Bourbonnais, la Maison Fayet, cultive un safran d’exception et le décline sous forme d'une gamme de produits  aussi gourmands qu’originaux."
    ],
    "es": [
      "Situada en el corazón de la región de Bourbonnais, la Maison Fayet cultiva un azafrán excepcional y ofrece una gama de productos a la vez deliciosos y originales."
    ],
    "nl": [
      "Maison Fayet, gelegen in het hart van de Bourbonnais, kweekt uitzonderlijke saffraan en biedt een reeks producten die zowel heerlijk als origineel zijn."
    ]
  },
  "rdfs:label": {
    "en": [
