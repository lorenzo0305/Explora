  "rdfs:comment": {
    "de": [
      "Ein spitzer Hut, lokale Wolle und ein Hauch von Magie: Komm und filze deinen eigenen Gandalf-Hut und geh mit deinem ultimativen Zauberzubehör nach Hause! (Bart nicht im Lieferumfang enthalten)."
    ],
    "en": [
      "A pointy hat, local wool and a touch of magic: come and felt your very own Gandalf hat and leave with your ultimate magic accessory! (beard not included)."
    ],
    "it": [
      "Un cappello a punta, un po' di lana locale e un pizzico di magia: venite a provare il vostro cappello da Gandalf e partite con il vostro accessorio magico definitivo! (barba non inclusa)."
    ],
    "fr": [
      "Un chapeau pointu, de la laine locale et un soupçon de magie : Viens feutrer ton propre chapeau de Gandalf et repars avec ton accessoire de magie ultime ! (barbe non fournie)."
    ],
    "es": [
      "Un sombrero puntiagudo, un poco de lana local y un toque de magia: ¡venga a sentir su propio sombrero de Gandalf y váyase con su accesorio mágico definitivo! (barba no incluida)."
    ],
    "nl": [
      "Een puntige hoed, wat lokale wol en een vleugje magie: kom je eigen Gandalf-hoed vilten en vertrek met je ultieme magische accessoire! (baard niet inbegrepen)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Atelier initiation : Chapeau de Gandalf"
    ]
  },
