  "rdfs:comment": {
    "de": [
      "Hotel Restaurant Pizzeria in einer wunderschönen Umgebung, wir empfangen Sie mittags und abends in einer herzlichen Atmosphäre.\r\nOrganisation von Themenabenden, aber auch Geschäftsseminare und Lebensereignisse."
    ],
    "en": [
      "Hotel restaurant pizzeria in a magnificent setting, we welcome you for lunch and dinner in a warm atmosphere.\r\nWe can organize theme evenings, business seminars and special events."
    ],
    "it": [
      "Hotel ristorante pizzeria in una magnifica cornice, vi accogliamo per pranzo e cena in una calda atmosfera.\r\nOrganizzazione di serate a tema, ma anche di seminari aziendali ed eventi di vita"
    ],
    "fr": [
      "Hôtel restaurant pizzeria dans un cadre magnifique, nous vous accueillons midi et soir dans une ambiance chaleureuse.\r\nOrganisation de soirées à thème, mais aussi séminaires d’affaires et événements de la vie"
    ],
    "es": [
      "Hotel restaurante pizzería en un magnífico entorno, le damos la bienvenida para almorzar y cenar en un ambiente cálido.\r\nPodemos organizar veladas temáticas, seminarios de negocios y eventos especiales."
    ],
    "nl": [
      "Hotel restaurant pizzeria in een prachtige omgeving, verwelkomen wij u voor lunch en diner in een warme sfeer.\r\nOrganisatie van thema-avonden, maar ook business seminars en life events"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Hôtel Brasserie Pizzeria Le Repère"
    ]
  },
