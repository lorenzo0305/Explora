  "rdfs:comment": {
    "de": [
      "Portabéraud oder La Folie Mercier, ein Haus mit Charme und Zierde.\r\nNicht zu vergessen seine Gärten!\r\nEntdecken Sie die Orte, indem Sie den für Groß und Klein konzipierten Schnitzeljagden folgen."
    ],
    "en": [
      "Portabéraud or the Folie Mercier, a charming and pleasant house.\r\nNot to mention its gardens!\r\nDiscover the place by following the trail games designed for young and old."
    ],
    "it": [
      "Portabéraud o La Folie Mercier, una casa affascinante e piacevole.\r\nSenza dimenticare i suoi giardini!\r\nScoprite il luogo seguendo i giochi di percorso pensati per grandi e piccini."
    ],
    "fr": [
      "Portabéraud ou la Folie Mercier, maison de charme et d'agrément.\r\nSans oublier ses jardins !\r\nDécouvrez les lieux en suivant les jeux de piste conçus pour petits et grands."
    ],
    "nl": [
      "Portabéraud of La Folie Mercier, een charmant en aangenaam huis.\r\nEn niet te vergeten zijn tuinen!\r\nOntdek de plek door het volgen van de spelletjesroute die voor jong en oud is ontworpen."
    ],
    "es": [
      "Portabéraud o La Folie Mercier, una casa encantadora y agradable.\r\n¡Sin olvidar sus jardines!\r\nDescubra el lugar siguiendo los juegos de pistas diseñados para grandes y pequeños."
    ]
  },
  "rdfs:label": {
    "de": [
