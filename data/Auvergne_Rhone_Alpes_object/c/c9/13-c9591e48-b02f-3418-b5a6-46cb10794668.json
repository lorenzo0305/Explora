  "rdfs:comment": {
    "de": [
      "Pech, das nicht mit Harz verwechselt werden darf, wird aus Nadelholzscheiten, die teilweise in Öfen verbrannt werden, oder aus Steinkohlenteer gewonnen."
    ],
    "en": [
      "Pitch, which should not be confused with resin, is obtained from softwood logs partially consumed in furnaces or from coal tar."
    ],
    "it": [
      "La pece, che non va confusa con la resina, si ottiene da tronchi di conifere parzialmente bruciati nelle fornaci o dal catrame di carbone."
    ],
    "fr": [
      "La poix, qui ne doit pas être confondue avec la résine, est obtenue à partir de bûchettes de résineux partiellement consumées dans les fours ou de goudrons de houille."
    ],
    "nl": [
      "Pek, dat niet verward moet worden met hars, wordt verkregen uit zachthouten stammen die gedeeltelijk verbrand worden in ovens of uit koolteer."
    ],
    "es": [
      "La brea, que no debe confundirse con la resina, se obtiene a partir de troncos de coníferas parcialmente quemados en hornos o de alquitrán de hulla."
    ]
  },
