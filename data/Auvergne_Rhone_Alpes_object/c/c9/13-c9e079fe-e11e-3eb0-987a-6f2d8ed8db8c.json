  "rdfs:comment": {
    "de": [
      "Dieses Wandgemälde, das Graffmat 2021 anfertigen wird, spiegelt den Werdegang des 1986 in Chambéry geborenen Künstlers wider. Er stammt aus einer Künstlerfamilie und zeichnete schon als Kind leidenschaftlich gern, bevor er sich in Lyon dem Grafikdesign zuwandte."
    ],
    "en": [
      "This fresco, created by Graffmat in 2021, reflects the career of the artist born in 1986 in Chambéry. Born into a family of artists and passionate about drawing since childhood, he turned to graphic design in Lyon."
    ],
    "it": [
      "Questo affresco, realizzato da Graffmat nel 2021, riflette la carriera dell'artista, nato nel 1986 a Chambéry. Nato in una famiglia di artisti e appassionato di disegno fin dall'infanzia, si è dedicato alla grafica a Lione."
    ],
    "fr": [
      "Cette fresque, réalisée par Graffmat en 2021, reflète le parcours de l'artiste né en 1986 à Chambéry. Issu d'une famille d'artistes et passionné de dessin depuis l'enfance, il s'est tourné vers le graphisme à Lyon."
    ],
    "es": [
      "Este fresco, creado por Graffmat en 2021, refleja la trayectoria del artista, nacido en 1986 en Chambéry. Nacido en una familia de artistas y apasionado del dibujo desde la infancia, se orientó hacia el diseño gráfico en Lyon."
    ],
    "nl": [
      "Dit fresco, gemaakt door Graffmat in 2021, weerspiegelt de carrière van de kunstenaar, die in 1986 werd geboren in Chambéry. Geboren in een familie van kunstenaars en gepassioneerd door tekenen sinds zijn kindertijd, wendde hij zich tot grafisch ontwerp in Lyon."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Fresques et murs peints - Angelina de Graffmat"
    ]
  },
