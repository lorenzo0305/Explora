  "rdfs:comment": {
    "de": [
      "Ambiance Léman et Nuage: Ihre Wohlfühlblase am Wasser. Genießen Sie die wohltuende Wirkung des Warm-Kalt-Kontrasts mit unseren Saunen mit Seeblick. Eine ungewöhnliche Pause, um Ihr Immunsystem diesen Winter in Sciez zu stärken."
    ],
    "en": [
      "Ambiance Léman et Nuage: your wellness bubble by the water. Enjoy the benefits of the hot-cold contrast with our lake view saunas. An unusual break to boost your immunity this winter in Sciez."
    ],
    "it": [
      "Ambiance Léman et Nuage: la vostra bolla di benessere in riva al lago. Godetevi i benefici del contrasto caldo-freddo con le nostre saune vista lago. Una pausa insolita per rafforzare le vostre difese immunitarie quest'inverno a Sciez."
    ],
    "fr": [
      "Ambiance Léman et Nuage : votre bulle de bien-être au bord de l'eau. Profitez des bienfaits du contraste chaud-froid avec nos saunas vue lac. Une pause insolite pour booster votre immunité cet hiver à Sciez."
    ],
    "nl": [
      "Ambiance Léman et Nuage: uw wellness-bubbel aan het water. Geniet van de weldaden van het contrast tussen warm en koud in onze sauna's met uitzicht op het meer. Een ongewone pauze om je immuniteit deze winter in Sciez op te krikken."
    ],
    "es": [
      "Ambiance Léman et Nuage: su burbuja de bienestar junto al agua. Disfrute de los beneficios del contraste frío-calor con nuestras saunas con vistas al lago. Una pausa insólita para reforzar su inmunidad este invierno en Sciez."
    ]
  },
