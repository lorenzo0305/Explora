  "rdfs:comment": {
    "de": [
      "Das Chamonix Film Festival ist ein Filmfestival, das den Bergen, dem Abenteuer und der Kultur gewidmet ist.\r\nFilmvorführungen, Begegnungen, Talks und Inspiration auf dem Gipfel: ein unumgänglicher Termin im Herzen der Alpen."
    ],
    "en": [
      "The Chamonix Film Festival is the film festival dedicated to mountains, adventure and culture.\r\nScreenings, meetings, talks and inspiration at the summit: an unmissable event in the heart of the Alps."
    ],
    "it": [
      "Il Chamonix Film Festival è un festival cinematografico dedicato alla montagna, all'avventura e alla cultura.\r\nProiezioni, incontri, conferenze e ispirazioni in vetta: un evento imperdibile nel cuore delle Alpi."
    ],
    "fr": [
      "Le Chamonix Film Festival, c’est le festival de films dédié à la montagne, l’aventure et la culture. \r\nProjections, rencontres, talks et inspiration au sommet : un rendez-vous immanquable au cœur des Alpes."
    ],
    "nl": [
      "Het Chamonix Film Festival is een filmfestival gewijd aan bergen, avontuur en cultuur.\r\nVertoningen, ontmoetingen, lezingen en inspiratie op de top: een niet te missen evenement in het hart van de Alpen."
    ],
    "es": [
      "El Festival de Cine de Chamonix es un festival de cine dedicado a la montaña, la aventura y la cultura.\r\nProyecciones, encuentros, charlas e inspiración en la cumbre: una cita ineludible en el corazón de los Alpes."
    ]
  },
