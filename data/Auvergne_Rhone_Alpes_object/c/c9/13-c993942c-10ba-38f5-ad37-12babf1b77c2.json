  "rdfs:comment": {
    "de": [
      "Quad-Touren ab 4 Jahren- Motorrad/Buggy 6 Jahre. Quad-Touren ab 12 Jahren. Buggy, Führerschein B erforderlich. Abenteuer und Sensationen garantiert!\r\nBetreuung durch diplomierte Lehrer. Empfang von Einzelpersonen, Gruppen, MJC, Seminaren (Kostenvoranschlag auf Anfrage)."
    ],
    "en": [
      "Quad tours from age 4 - Motorcycle/Buggy tours from age 6. Quad tours from age 12. Buggy, B driving license required. Escape and thrills guaranteed!\r\nSupervision by qualified instructors. Individuals, groups, youth clubs, seminars (estimate on request)."
    ],
    "it": [
      "Tour in quad a partire dai 4 anni - Tour in moto/buggy a partire dai 6 anni. Tour in quad a partire da 12 anni. Buggy, è richiesta la patente B. Fuga ed emozioni garantite!\r\nSotto la supervisione di istruttori qualificati. Individuali, gruppi, club giovanili, seminari (preventivo su richiesta)."
    ],
    "fr": [
      "Circuit Quad à partir de 4 ans - Moto/Buggy 6 ans. Randos Quad à partir de 12 ans. Buggy, permis B obligatoire. Évasion et sensations garanties !\r\nEncadrement par moniteurs diplômés. Accueil particuliers, groupes, MJC, séminaires (devis sur demande)."
    ],
    "nl": [
      "Wij heten u welkom op een bijzonder terrein van 12 hectare gewijd aan all-terrain sporten.\r\nHier is alles aanwezig om u een onvergetelijke tijd te bieden!\r\nOntvangst van particulieren, groepen, jeugdcentra, seminars (offerte op aanvraag)."
    ],
    "es": [
      "Excursiones en quad a partir de 4 años - Excursiones en moto/buggy a partir de 6 años. Excursiones en quad a partir de 12 años. Buggy, se requiere permiso de conducir B. Evasión y emoción garantizadas\r\nSupervisado por monitores cualificados. Particulares, grupos, clubes de jóvenes, seminarios (presupuesto a petición)."
    ]
  },
