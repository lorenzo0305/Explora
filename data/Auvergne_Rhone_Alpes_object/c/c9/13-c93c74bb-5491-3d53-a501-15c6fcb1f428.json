  "rdfs:comment": {
    "de": [
      "Das Restaurant empfängt Sie im Herzen eines vollständig restaurierten Schlosses. Hier können Sie Mahlzeiten genießen, die von unserem Küchenchef mit regionalen Produkten von lokalen Erzeugern zubereitet werden. Empfänge und Veranstaltungen nach Kostenvoranschlag"
    ],
    "en": [
      "The restaurant welcomes you to the heart of a fully restored Château. Enjoy meals concocted by our chef using local produce from local producers.panoramic terrace. Receptions and events on request"
    ],
    "it": [
      "Il ristorante vi accoglie nel cuore di un castello completamente restaurato. Gustate i piatti preparati dal nostro chef con prodotti locali provenienti da produttori locali.Terrazza panoramica. Ricevimenti ed eventi su richiesta"
    ],
    "fr": [
      "Le restaurant vous accueille au cœur d'un Château entièrement restauré. Vous y dégusterez des repas concoctés par notre chef avec les produits du terroir issus de producteurs locaux.Terrasse panoramique. Réception et événementiel sur devis"
    ],
    "nl": [
      "Het restaurant verwelkomt je in het hart van een volledig gerestaureerd kasteel. Geniet van maaltijden die door onze chef-kok zijn samengesteld met lokale producten van plaatselijke producenten. panoramisch terras. Recepties en evenementen op aanvraag"
    ],
    "es": [
      "El restaurante le recibe en el corazón de un castillo totalmente restaurado. Disfrute de los platos elaborados por nuestro chef con productos de la tierra procedentes de productores locales.Terraza panorámica. Recepciones y eventos a petición"
    ]
  },
