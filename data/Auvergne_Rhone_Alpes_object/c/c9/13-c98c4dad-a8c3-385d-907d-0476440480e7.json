  "rdfs:comment": {
    "de": [
      "Nehmen Sie an der Schatzsuche im alten Dorf Sahune teil! Entdecken Sie mit Ihrer Familie das Dorf und lüften Sie die Geheimnisse der alten Steine! Wenn Sie die verschiedenen Rätsel lösen, können Sie ein kleines Geschenk gewinnen!"
    ],
    "en": [
      "Discover the Tresur Hunt  with your family, visit the old village of Sahune.\r\nIf you answer to the differents puzzles, you will win a little gift!"
    ],
    "it": [
      "Partecipate a una caccia al tesoro nell'antico villaggio di Sahune! Scoprite il villaggio in famiglia e scoprite i segreti delle vecchie pietre! Rispondendo ai vari indovinelli, vincerete un distintivo da collezione!"
    ],
    "fr": [
      "Participez à la chasse aux trésors du vieux village de Sahune! Découvrez en famille le village, venez percer les secrets des vieilles pierres ! En répondant aux différentes énigmes, vous gagnerez un badge à collectionner !"
    ],
    "es": [
      "Participe en una búsqueda del tesoro en el antiguo pueblo de Sahune ¡Descubre el pueblo en familia y descubre los secretos de las viejas piedras! Al responder a los distintos enigmas, ¡ganarás una insignia coleccionable!"
    ],
    "nl": [
      "Ontdek met de hele familie het historisch stadscentrum met onze schattenjacht !\r\nDoor te antwoorden op enkele vragen, winnen de kinderen een klein kado !"
    ]
  },
  "rdfs:label": {
    "en": [
      "Tresur Hunt in Sahune"
    ],
    "fr": [
      "Jeu de piste : balade ludique pour petits et grands à Sahune"
    ],
    "nl": [
      "Schattenjacht en Sahune"
    ]
  },
