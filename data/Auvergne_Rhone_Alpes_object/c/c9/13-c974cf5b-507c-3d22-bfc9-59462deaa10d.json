  "rdfs:comment": {
    "de": [
      "Die Bewohner von Vichyssois mussten bis 1935 warten, um ihre Toten aus dem Ersten Weltkrieg zu ehren. Nach dem Krieg wurde jedoch ein Komitee gegründet und eine Subskription aufgelegt."
    ],
    "en": [
      "The people of Vichy had to wait until 1935 to pay tribute to their fallen in the Great War. However, in the aftermath of the war, a committee was set up and a subscription launched."
    ],
    "it": [
      "La popolazione di Vichy dovette aspettare fino al 1935 per rendere omaggio ai caduti della Grande Guerra. Tuttavia, all'indomani della guerra, fu istituito un comitato e fu lanciata una campagna di sottoscrizione."
    ],
    "fr": [
      "Les Vichyssois ont dû attendre 1935 pour que soit rendu hommage à leurs morts de la Grande Guerre. Au lendemain de celle-ci, un comité est pourtant constitué et une souscription lancée."
    ],
    "es": [
      "Los habitantes de Vichy tuvieron que esperar hasta 1935 para que se rindiera homenaje a los caídos en la Gran Guerra. Sin embargo, tras la guerra, se creó un comité y se lanzó una campaña de suscripción."
    ],
    "nl": [
      "De inwoners van Vichy moesten tot 1935 wachten op eerbetoon aan degenen die in de Grote Oorlog waren omgekomen. In de nasleep van de oorlog werd er echter een comité opgericht en een inschrijvingscampagne gestart."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Monument aux morts"
    ]
  },
