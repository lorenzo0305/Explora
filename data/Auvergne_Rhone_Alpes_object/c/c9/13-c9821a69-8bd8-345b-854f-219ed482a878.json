  "rdfs:comment": {
    "de": [
      "Die Stadtmauer wurde 1399 errichtet und zieht einen perfekten Kreis um das Dorf. Einige Wachtürme und Ziegelmauern (Privatbesitz) sind die Spuren dieser mittelalterlichen Vergangenheit. Es ist möglich, den Rundgang über den Wehrgang zu machen."
    ],
    "en": [
      "The ramparts were built in 1399, forming a perfect circle around the village. A few watchtowers and brick walls (privately owned) bear witness to this medieval past. It's possible to take a walk around the ramparts."
    ],
    "it": [
      "I bastioni furono costruiti nel 1399 e formano un cerchio perfetto intorno al villaggio. Alcune torri di guardia e mura in mattoni (di proprietà privata) testimoniano il passato medievale. È possibile fare una passeggiata intorno ai bastioni."
    ],
    "fr": [
      "La construction des remparts date de 1399 et dessine autour du village un cercle parfait. Quelques tours de guêt et murs de brique (propriétés privées) sont les traces de ce passé médiéval. Il est possible de faire le tour par le chemin de ronde."
    ],
    "es": [
      "Las murallas se construyeron en 1399 y forman un círculo perfecto alrededor del pueblo. Algunas torres de vigilancia y muros de ladrillo (de propiedad privada) son testigos de este pasado medieval. Puede dar un paseo alrededor de las murallas."
    ],
    "nl": [
      "De stadswallen werden gebouwd in 1399 en vormen een perfecte cirkel rond het dorp. Een paar wachttorens en bakstenen muren (privébezit) getuigen van dit middeleeuwse verleden. Je kunt een wandeling maken rond de wallen."
    ]
  },
  "rdfs:label": {
    "en": [
      "Remains of Bâgé-le-Châtel medieval city walls"
    ],
    "fr": [
      "Bâgé-le-Châtel, Village et vestiges des remparts"
    ],
    "nl": [
      "Bâgé-le-Châtel, dorp en overblijfselen van de stadsmuren"
    ]
  },
