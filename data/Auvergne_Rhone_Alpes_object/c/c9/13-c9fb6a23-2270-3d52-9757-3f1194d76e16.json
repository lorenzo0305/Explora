  "rdfs:comment": {
    "de": [
      "Produzent von Beetpflanzen im Frühjahr, Stiefmütterchen, Chrysanthemen, Kräutern und Gemüsepflanzen.\nErzeuger von Erdbeeren, Himbeeren und neuen Kartoffeln, die direkt in unseren Betrieben verkauft werden."
    ],
    "en": [
      "Producer of bedding plants in spring, pansies, chrysanthemums, herbs, market garden plants.\nStrawberries, raspberries and new potatoes sold directly on our farms."
    ],
    "it": [
      "Produttore di piante da aiuola in primavera, viole del pensiero, crisantemi, erbe aromatiche, piante da orto.\nProduttore di fragole, lamponi e patate novelle vendute direttamente dalla nostra azienda agricola."
    ],
    "fr": [
      "Producteur plantes à massifs au printemps, pensées, chrysanthèmes, aromatiques, plants maraîchers.\nProducteur fraise, framboises, et pomme de terre nouvelles vendus directement  dans notre exploitations."
    ],
    "es": [
      "Productor de plantas de parterre en primavera, pensamientos, crisantemos, hierbas aromáticas, plantas hortícolas.\nProductor de fresas, frambuesas y patatas nuevas vendidas directamente en nuestra explotación."
    ],
    "nl": [
      "Producent van perkplanten in het voorjaar, viooltjes, chrysanten, kruiden, tuinplanten.\nProducent van aardbeien, frambozen en nieuwe aardappelen die rechtstreeks van onze boerderij worden verkocht."
    ]
  },
  "rdfs:label": {
    "fr": [
