  "rdfs:comment": {
    "de": [
      "Unser Küchenchef lädt Sie ein, eine authentische Küche zu entdecken, die Tradition und regionale Aromen verbindet. Lassen Sie sich jeden Tag von einem neuen Tagesmenü überraschen, das aus frischen Zutaten zubereitet wird. Genießen Sie ein Gourmet-Erlebnis."
    ],
    "en": [
      "Our chef invites you to discover an authentic cuisine, combining tradition and local flavors. Every day, you'll be surprised by a freshly prepared menu of the day. Come and enjoy a gourmet experience."
    ],
    "it": [
      "Il nostro chef vi invita a scoprire una cucina autentica, che unisce tradizione e sapori locali. Ogni giorno, lasciatevi sorprendere da un nuovo menu del giorno, realizzato con prodotti freschi. Venite a vivere un'esperienza gourmet."
    ],
    "fr": [
      "Notre chef vous invite à découvrir une cuisine authentique, alliant tradition et saveurs du terroir. Chaque jour, laissez-vous surprendre par un menu du jour renouvelé, élaboré à partir de produits frais. Venez savourer une expérience gourmande."
    ],
    "nl": [
      "Onze chef nodigt je uit om de authentieke keuken te ontdekken, een combinatie van traditie en lokale smaken. Laat je elke dag verrassen door een nieuw dagmenu, bereid met verse producten. Kom en geniet van een gastronomische ervaring."
    ],
    "es": [
      "Nuestro chef le invita a descubrir una cocina auténtica, que combina tradición y sabores locales. Cada día, déjese sorprender por un nuevo menú del día, elaborado con productos frescos. Venga a disfrutar de una experiencia gastronómica."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant la Source"
    ]
  },
