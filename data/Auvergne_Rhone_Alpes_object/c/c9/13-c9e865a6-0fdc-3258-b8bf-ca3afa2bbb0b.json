  "rdfs:comment": {
    "de": [
      "Im Bosporus können Sie Tacos, süße oder salzige Paninis, Kebab, Fladenbrot, Hamburger, Sandwiches, Tenders, Cordon Bleu, Nuggets, amerikanisches Brot, Fleisch mit Pommes frites, Gemüse, Desserts usw. probieren Zum Essen vor Ort oder zum Mitnehmen."
    ],
    "en": [
      "Le Bosphore invites you to enjoy tacos, sweet or savory paninis, kebabs, patties, hamburgers, sandwiches, tenders, cordon bleu, nuggets, American bread, meats with fries, vegetables, desserts? To eat in or take away."
    ],
    "it": [
      "Presso Le Bosphore potrete gustare tacos, panini dolci o salati, kebab, polpette, hamburger, panini, tender, cordon bleu, nuggets, pane americano, carne con patatine, verdure, dessert? Da mangiare o da portare via."
    ],
    "fr": [
      "Le Bosphore vous propose de venir déguster des tacos, paninis sucrés ou salés, kebabs, galettes, hamburgers, sandwichs, tenders, cordons bleus, nuggets, pain américain, viandes accompagnées de frites, légumes, desserts… A manger sur place ou à emporter."
    ],
    "es": [
      "En Le Bosphore podrá disfrutar de tacos, paninis dulces o salados, kebabs, hamburguesas, sándwiches, tenders, cordon bleu, nuggets, pan americano, carne con patatas fritas, verduras, postres? Para comer en el restaurante o para llevar."
    ],
    "nl": [
      "Bij Le Bosphore kun je genieten van taco's, zoete of hartige panini's, kebab, pasteitjes, hamburgers, sandwiches, tenders, cordon bleu, nuggets, Amerikaans brood, vlees met friet, groenten, desserts? Om te eten of om mee te nemen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Bar restaurant Kébab Le Bosphore"
    ]
  },
