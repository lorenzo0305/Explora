  "rdfs:comment": {
    "de": [
      "Julien Perez, ein leidenschaftlicher Feuerkünstler und heißer Stahlarbeiter, ist Kunstschmiedemeister und einer der besten Handwerker Frankreichs. Er bietet Kreationen aus Eisen für Innen- und Außeneinrichtungen an."
    ],
    "en": [
      "With a passion for fire and hot-rolled steel, Julien Perez, master craftsman and one of France's \"Meilleurs Ouvriers de France\", offers iron creations for interior and exterior fittings."
    ],
    "it": [
      "Julien Perez, maestro artigiano del ferro battuto e uno dei migliori lavoratori francesi, ha una passione per il fuoco e l'acciaio lavorato a caldo, e propone creazioni in ferro per allestimenti interni ed esterni."
    ],
    "fr": [
      "Passionné par le feu et le travail de l'acier à chaud, Julien Perez, maître artisan ferronnier d'art et l'un des Meilleurs Ouvriers de France, propose des créations en fer pour des aménagements intérieurs et extérieurs."
    ],
    "es": [
      "Julien Perez, maestro artesano del hierro forjado y uno de los mejores obreros de Francia, apasionado por el fuego y el acero trabajado en caliente, propone creaciones en hierro para el acondicionamiento interior y exterior."
    ],
    "nl": [
      "Julien Perez, een meester-ambachtsman in smeedijzer en een van de beste werkers van Frankrijk, heeft een passie voor vuur en heet bewerkt staal en biedt ijzeren creaties voor binnen- en buiteninrichting."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Julien Perez, ferronnier d'art"
    ]
  },
