  "rdfs:comment": {
    "de": [
      "\"City Hall\" ist ein Dokumentarfilm von Frederick Wiseman aus dem Jahr 2020.\r\n\r\nSitzung zu Ehren eines der größten Dokumentarfilmer, der im Februar dieses Jahres verstorben ist."
    ],
    "en": [
      "\"City Hall\" is a documentary directed by Frederick Wiseman in 2020.\r\n\r\nA tribute to one of the world?s greatest documentary filmmakers, who passed away last February."
    ],
    "it": [
      "\"City Hall\" è un documentario diretto da Frederick Wiseman nel 2020.\r\n\r\nQuesta proiezione è un omaggio a uno dei più grandi documentaristi, scomparso lo scorso febbraio."
    ],
    "fr": [
      "\"City Hall\" est un documentaire réalisé par Frederick Wiseman en 2020.\r\n\r\nSéance en hommage à l’un des plus grands documentaristes, décédé en février dernier."
    ],
    "nl": [
      "\"City Hall\" is een documentaire geregisseerd door Frederick Wiseman in 2020.\r\n\r\nDeze vertoning is een eerbetoon aan een van de grootste documentairemakers, die afgelopen februari overleed."
    ],
    "es": [
      "\"City Hall\" es un documental dirigido por Frederick Wiseman en 2020.\r\n\r\nEsta proyección es un homenaje a uno de los más grandes documentalistas, fallecido el pasado mes de febrero."
    ]
  },
  "rdfs:label": {
