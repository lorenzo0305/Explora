  "rdfs:comment": {
    "de": [
      "Ziyá präsentiert eine Auswahl an geistlichen und traditionellen Stücken sowie Originalkompositionen. Das Repertoire hebt die Musik Istanbuls hervor, die durch die kosmopolitische Interaktion der verschiedenen Gemeinschaften geprägt wurde"
    ],
    "en": [
      "Ziyá presents a selection of sacred and traditional pieces, as well as original compositions. The repertoire highlights the music of Istanbul, shaped by the cosmopolitan interaction of different communities, me"
    ],
    "it": [
      "Ziyá presenta una selezione di brani sacri e tradizionali, oltre a composizioni originali. Il repertorio evidenzia la musica di Istanbul, plasmata dall'interazione cosmopolita di diverse comunità, me"
    ],
    "fr": [
      "Ziyá présente une sélection de pièces sacrées et traditionnelles, ainsi que des compositions originales. Le répertoire met en valeur la musique d'Istanbul, façonnée par l'interaction cosmopolite des différentes communautés, me"
    ],
    "nl": [
      "Ziyá presenteert een selectie van sacrale en traditionele stukken, evenals originele composities. Het repertoire belicht de muziek van Istanbul, gevormd door de kosmopolitische interactie van verschillende gemeenschappen, me"
    ],
    "es": [
      "Ziyá presenta una selección de piezas sacras y tradicionales, así como composiciones originales. El repertorio destaca la música de Estambul, moldeada por la interacción cosmopolita de diferentes comunidades, me"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ziyá | Christ Church"
    ]
