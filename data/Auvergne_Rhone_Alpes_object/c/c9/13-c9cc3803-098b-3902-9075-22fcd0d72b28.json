  "rdfs:comment": {
    "de": [
      "Die Christian-Réal-Stiftung in La Cour de L'Abbaye ist ein geschichtsträchtiges Bauwerk aus dem 16. Jahrhundert, das von Christian Réal zu einem Ausstellungszentrum für zeitgenössische Kunst umgebaut wurde und über einen Skulpturenpark verfügt."
    ],
    "en": [
      "The Christian Réal Foundation located at La Cour de L'Abbaye is a 16th century monument steeped in history, magnificently rehabilitated by Christian Réal to make it an exhibition centre for contemporary art. You can also discover its sculpture park."
    ],
    "it": [
      "La Fondazione Christian Réal, situata a La Cour de L'Abbaye, è un monumento del XVI secolo ricco di storia, magnificamente restaurato da Christian Réal per farne un centro per esposizioni d'arte contemporanea. È inoltre possibile scoprire il suo parco di sculture."
    ],
    "fr": [
      "La fondation Christian Réal située à La Cour de L'Abbaye est un monument du XVIeme siècle chargée d'histoire magnifiquement réhabilité par Christian Réal pour en faire un centre d'expositions d'Art contemporain, On y découvre aussi son parc à sculptures."
    ],
    "es": [
      "La Fundación Christian Réal, situada en La Cour de L'Abbaye, es un monumento del siglo XVI cargado de historia, magníficamente restaurado por Christian Réal para convertirlo en un centro de exposiciones de arte contemporáneo. También podrá descubrir su parque de esculturas."
    ],
    "nl": [
      "De Christian Réal Foundation in La Cour de L'Abbaye is een monument uit de 16e eeuw met een rijke geschiedenis dat door Christian Réal prachtig is gerestaureerd om er een centrum voor hedendaagse kunsttentoonstellingen van te maken. U kunt er ook zijn beeldenpark ontdekken."
    ]
  },
