  "rdfs:comment": {
    "de": [
      "Mehr als 100 Aussteller, die besten Spezialisten der Pflanzenwelt, Handwerker und Künstler laden Sie am 26. und 27. April 2025 zu einer neuen Ausgabe von Plantes en folie ein."
    ],
    "en": [
      "More than 100 exhibitors, the best specialists in the plant world, craftsmen and artists will be on hand on April 26 and 27, 2025 for another edition of Plantes en folie."
    ],
    "it": [
      "Più di 100 espositori, i migliori specialisti del mondo delle piante, artigiani e artisti saranno presenti il 26 e 27 aprile 2025 per un'altra edizione di Plantes en folie."
    ],
    "fr": [
      "Plus de 100 exposants, les meilleurs spécialistes du monde végétal, artisans et artistes vous donnent rendez-vous les 26 et 27 avril 2025 pour une nouvelle édition de Plantes en folie."
    ],
    "nl": [
      "Meer dan 100 exposanten, de beste specialisten in de plantenwereld, ambachtslieden en kunstenaars zullen op 26 en 27 april 2025 aanwezig zijn voor een nieuwe editie van Plantes en folie."
    ],
    "es": [
      "Más de 100 expositores, los mejores especialistas del mundo de las plantas, artesanos y artistas se darán cita los días 26 y 27 de abril de 2025 en una nueva edición de Plantes en folie."
    ]
  },
