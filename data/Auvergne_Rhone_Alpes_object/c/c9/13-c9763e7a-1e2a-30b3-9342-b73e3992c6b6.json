  "rdfs:comment": {
    "de": [
      "Das soziokulturelle Zentrum ist ein Ort, an dem jedermann Zugang zu Informationen hat. Es verfügt über Zweigstellen in den Stadtvierteln und beherbergt in seinen Räumlichkeiten einen Jugendinformationspunkt und eine Cyber-Base."
    ],
    "en": [
      "The Centre Socioculturel is a local reception and information center open to all. It has branches in different parts of the city, and hosts a youth information point and a cyber-base."
    ],
    "it": [
      "Il Centro socio-culturale è un centro di accoglienza e informazione locale aperto a tutti. Ha sedi in diversi quartieri della città e ospita nei suoi locali un punto di informazione per i giovani e una cyber-base."
    ],
    "fr": [
      "Le Centre socioculturel est un lieu d’accueil et d’information de proximité ouvert à tous. Il dispose d’antennes au sein de quartiers de la ville et accueille dans ses locaux un point information jeunesse et une cyber-base."
    ],
    "nl": [
      "Het Socio-Cultureel Centrum is een plaatselijk onthaal- en informatiecentrum dat voor iedereen toegankelijk is. Het heeft filialen in verschillende delen van de stad en huisvest een informatiepunt voor jongeren en een cyberbasis."
    ],
    "es": [
      "El Centro Sociocultural es un centro local de acogida e información abierto a todos. Tiene sucursales en distintos puntos de la ciudad y alberga en sus locales un punto de información juvenil y una cibersede."
    ]
  },
