  "rdfs:comment": {
    "de": [
      "Unser Restaurant ist ein auf Fleisch spezialisierter Grill (einzelne oder geteilte Rindfleischstücke, Huhn, Ente, Lamm, Schwein), das wir mit einer großen Auswahl an Beilagen und Soßen als Beilage anbieten."
    ],
    "en": [
      "Our restaurant specialises in grilled meats (with beef cuts for one or to share, chicken, duck, lamb and pork), accompanied by a large selection of garnishes and sauces."
    ],
    "it": [
      "Il nostro ristorante è una griglieria specializzata in carne (tagli singoli o condivisi di manzo, pollo, anatra, agnello, maiale) che proponiamo con un'ampia scelta di contorni e salse."
    ],
    "fr": [
      "Notre restaurant est un grill spécialisé dans la viande (pièces de bœuf individuelles ou à partager, poulet, canard, agneau, porc) que nous proposons avec un large choix de garnitures et de sauces en accompagnement."
    ],
    "nl": [
      "Ons restaurant is een grill gespecialiseerd in vlees (individuele of gedeelde stukken rundvlees, kip, eend, lam, varkensvlees) dat wij aanbieden met een ruime keuze aan bijgerechten en sauzen."
    ],
    "es": [
      "Nuestro restaurante es un asador especializado en carnes (cortes individuales o compartidos de ternera, pollo, pato, cordero, cerdo) que ofrecemos con una amplia selección de guarniciones y salsas."
    ]
  },
