  "rdfs:comment": {
    "de": [
      "Reitzentrum - Unterricht von der Einführung bis zum Wettkampf Pony und Pferd.\r\nHindernisse, Dressur, Freizeit, Ethologie, Fußarbeit Transport Gruppen- und Privatunterricht\r\nLassen Sie uns gemeinsam Fortschritte machen, ohne das Wichtigste zu vergessen: Spaß haben!"
    ],
    "en": [
      "Equestrian center - Teaching from initiation to competition for ponies and horses.\r\nObstacles, Dressage, Leisure, Ethology, Walking Transport Group and private lessons\r\nLet's make progress together, without forgetting what's most important: having fun!"
    ],
    "it": [
      "Centro ippico - Insegnamento dall'iniziazione alla competizione per pony e cavalli.\r\nOstacoli, Dressage, Tempo libero, Etologia, Trasporto a piedi Lezioni di gruppo e private\r\nFacciamo progressi insieme, senza dimenticare la cosa più importante: divertirsi!"
    ],
    "fr": [
      "Centre équestre - Enseignement de l'Initiation à la Compétition Poney et Cheval. \r\nObstacles, Dressage, Loisir, Ethologie, Travail à pied Transport Cours collectifs et particuliers\r\nProgressons ensemble sans oublier l'essentiel : Se faire plaisir !"
    ],
    "nl": [
      "Hippisch Centrum - Lesgeven van beginners tot wedstrijd voor pony's en paarden.\r\nHindernissen, Dressuur, Vrije tijd, Ethologie, Looptransport Groeps- en privélessen\r\nLaten we samen vooruitgang boeken, zonder het belangrijkste te vergeten: plezier hebben!"
    ],
    "es": [
      "Centro ecuestre - Enseñanza desde la iniciación hasta la competición para ponis y caballos.\r\nObstáculos, Doma Clásica, Ocio, Etología, Transporte a pie Clases en grupo y particulares\r\nProgresemos juntos, sin olvidar lo más importante: ¡divertirnos!"
    ]
  },
  "rdfs:label": {
