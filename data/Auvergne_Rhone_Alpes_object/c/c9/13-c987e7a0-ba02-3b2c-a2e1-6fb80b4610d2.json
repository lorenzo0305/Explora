  "rdfs:comment": {
    "de": [
      "Fabienne Caulet bietet Ihnen poetische Bilder (Diois, Val de Drôme, Show...).  Kurse und Ausflüge. Künstlerische Gestaltung, Szenografie. Beratung in Bezug auf das Image. Reportagen, Auftragsarbeit."
    ],
    "en": [
      "Fabienne Caulet offers poetic images (Diois, Drôme Valley, show ...).  Lessons and outings. Artistic creation, scenography. Image consulting. Reports, works on demand."
    ],
    "it": [
      "Fabienne Caulet vi offre immagini poetiche (Diois, Val de Drôme, spettacolo...).  Corsi e uscite. Creazione artistica, scenografia. Consulenza per le immagini. Rapporti, lavoro su ordinazione."
    ],
    "fr": [
      "Fabienne Caulet vous propose des images poétiques (Diois, Val de Drôme, spectacle...).  Cours et sorties. Création artistique, scénographie. Conseil en image. Reportages, travail sur commande."
    ],
    "es": [
      "Fabienne Caulet le ofrece imágenes poéticas (Diois, Val de Drôme, espectáculo...).  Cursos y salidas. Creación artística, escenografía. Consultoría de imagen. Informes, trabajo por encargo."
    ],
    "nl": [
      "Fabienne Caulet biedt u poëtische beelden (Diois, Val de Drôme, voorstellingen...).  Cursussen en uitstapjes. Artistieke creatie, scenografie. Beeldadvies. Reportage, werk in opdracht."
    ]
  },
