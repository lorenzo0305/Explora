  "rdfs:comment": {
    "de": [
      "Hundeschlittenschule. Alain, seit 1994 professioneller Musher, freut sich, Sie zu empfangen und seine Leidenschaft mit Ihnen zu teilen, während er Ihnen den Vercors auf eine andere Art und Weise zeigt."
    ],
    "en": [
      "Dog sledding school. Alain, a professional musher since 1994, is delighted to welcome you and to share his passion with you while helping you discover the Vercors in a different way."
    ],
    "it": [
      "Scuola di sleddog. Alain, musher professionista dal 1994, è felice di accogliervi e di condividere con voi la sua passione, aiutandovi a scoprire il Vercors in modo diverso."
    ],
    "fr": [
      "Ecole de traîneau à chiens. Alain, musher professionnel depuis 1994 est heureux de vous accueillir et de vous faire partager sa passion tout en vous faisant découvrir le Vercors autrement."
    ],
    "nl": [
      "Hondensleeën school. Alain, professioneel musher sinds 1994, verwelkomt u graag en deelt zijn passie met u terwijl hij u de Vercors op een andere manier laat ontdekken."
    ],
    "es": [
      "Escuela de trineos tirados por perros. Alain, musher profesional desde 1994, estará encantado de recibirle y de compartir con usted su pasión, haciéndole descubrir el Vercors de una manera diferente."
    ]
  },
