  "rdfs:comment": {
    "de": [
      "Das Jean-Vilar-Theater der Stadt Bourgoin-Jallieu bietet eine reiche, dichte und abwechslungsreiche Kultursaison mit fast fünfzig Terminen für jedes Publikum und für jeden Geschmack.\r\nWir erwarten Sie auch dieses Jahr wieder zahlreich."
    ],
    "en": [
      "The Jean-Vilar Theatre of the city of Bourgoin-Jallieu offers a rich, dense and varied cultural season with nearly fifty events for all audiences and for all tastes."
    ],
    "it": [
      "Il Théâtre Jean-Vilar di Bourgoin-Jallieu offre una stagione culturale ricca, densa e variegata, con quasi cinquanta eventi per tutti i pubblici e tutti i gusti.\r\nCi auguriamo di vedervi numerosi quest'anno."
    ],
    "fr": [
      "Le Théâtre Jean-Vilar de la ville de Bourgoin-Jallieu propose une saison culturelle riche, dense et variée avec près d'une cinquantaine de rendez-vous pour tous les publics et pour tous les goûts.\r\nNous vous attendons encore nombreux cette année."
    ],
    "es": [
      "El Théâtre Jean-Vilar de Bourgoin-Jallieu ofrece una temporada cultural rica, densa y variada, con casi medio centenar de eventos para todos los públicos y todos los gustos.\r\nEsperamos verles a muchos más este año."
    ],
    "nl": [
      "Bourgoin-Jallieu's Théâtre Jean-Vilar biedt een rijk, dicht en gevarieerd cultureel seizoen, met bijna vijftig evenementen voor elk publiek en elke smaak.\r\nWe kijken ernaar uit om nog veel meer van jullie te zien dit jaar."
    ]
  },
  "rdfs:label": {
