  "rdfs:comment": {
    "de": [
      "Vom Office de Tourisme aus wird ein Rundgang durch das Kulturerbe angeboten. Er erzählt die Geschichte des Kurortes von der Römerzeit bis heute."
    ],
    "en": [
      "A heritage trail has been proposed... It relates the history of the spa from Roman times to the present day."
    ],
    "it": [
      "Dall'Ufficio del Turismo parte un sentiero del patrimonio. Racconta la storia delle terme dall'epoca romana ai giorni nostri."
    ],
    "fr": [
      "Un parcours patrimonial est proposé au départ Office de Tourisme. Il relate l'histoire de la station thermale depuis l'époque romaine jusqu'à nos jours."
    ],
    "es": [
      "En la Oficina de Turismo comienza un recorrido por el patrimonio. Cuenta la historia del balneario desde la época romana hasta nuestros días."
    ],
    "nl": [
      "Bij het VVV-kantoor begint een erfgoedroute. Het vertelt de geschiedenis van het kuuroord van de Romeinse tijd tot nu."
    ]
  },
