  "rdfs:comment": {
    "de": [
      "Das Schmuckatelier \"Mes Tau Précieux\" bietet Ihnen handgefertigten Schmuck aus 99,9% reinem Silber in Form von Einzelstücken sowie Modeschmuck. Sonderbestellungen möglich."
    ],
    "en": [
      "L'atelier du bijou \"Mes Tau Précieux\" offers handcrafted 99.9% pure silver jewelry in unique pieces, as well as costume jewelry. Special orders available."
    ],
    "it": [
      "L'atelier del bijou \"Mes Tau Précieux\" propone gioielli artigianali in argento puro al 99,9% in pezzi unici e bigiotteria. Ordini speciali disponibili."
    ],
    "fr": [
      "L'atelier du bijou \"Mes Tau Précieux\" vous propose des bijoux en argent pur à 99.9% de fabrication artisanale en pièces uniques ainsi que des bijoux fantaisies. Possibilité de commandes spéciales."
    ],
    "es": [
      "L'atelier du bijou \"Mes Tau Précieux\" le ofrece joyas artesanales de plata pura al 99,9% en piezas únicas, así como bisutería. Pedidos especiales disponibles."
    ],
    "nl": [
      "L'atelier du bijou \"Mes Tau Précieux\" biedt je handgemaakte 99,9% puur zilveren sieraden in unieke stukken, maar ook kostuumjuwelen. Speciale bestellingen mogelijk."
    ]
  },
  "rdfs:label": {
