  "rdfs:comment": {
    "de": [
      "Neuheit 2025!\r\nDie Cocotterie Giraud in Le Vilhain gründet ihren Bauernladen auf dem Bauernhof La Maillerie.\r\nRund 30 Produzenten mit kurzen Vertriebswegen sind hier gelistet! Eier, Fleisch, Mehl, Nudeln, Gemüse, Honig, Kerzen, Marmeladen, Kosmetika ..."
    ],
    "en": [
      "New in 2025!\r\nCocotterie Giraud in Le Vilhain sets up a producers' store at La Maillerie farm.\r\nSome thirty short-circuit producers listed! Eggs, meats, flour, pasta, vegetables, honey, candles, jams, cosmetics..."
    ],
    "it": [
      "Novità per il 2025!\r\nLa Cocotterie Giraud di Le Vilhain sta allestendo un negozio di produttori presso la fattoria La Maillerie.\r\nSono elencati una trentina di produttori del cortocircuito! Uova, carne, farina, pasta, verdure, miele, candele, marmellate, cosmetici..."
    ],
    "fr": [
      "Nouveauté 2025!\r\nLa Cocotterie Giraud à Le Vilhain crée son magasin de producteurs à la ferme de La Maillerie.\r\nUne trentaine de producteurs en circuit court référencés! Oeufs, viandes, farine, pâtes, légumes, miel, bougies, confitures, cosmétiques..."
    ],
    "es": [
      "Novedad para 2025\r\nLa Cocotterie Giraud de Le Vilhain crea una tienda de productores en la granja La Maillerie.\r\n¡Una treintena de productores del circuito corto están inscritos! Huevos, carne, harina, pasta, verduras, miel, velas, mermeladas, cosméticos..."
    ],
    "nl": [
      "Nieuw voor 2025!\r\nCocotterie Giraud in Le Vilhain richt een producentenwinkel in op de boerderij La Maillerie.\r\nEen dertigtal producenten uit de kortste omtrek zijn er vermeld! Eieren, vlees, meel, pasta, groenten, honing, kaarsen, jam, cosmetica..."
    ]
  },
