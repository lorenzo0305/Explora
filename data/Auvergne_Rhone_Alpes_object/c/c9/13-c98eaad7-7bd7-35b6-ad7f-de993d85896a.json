  "rdfs:comment": {
    "de": [
      "Restaurant im Herzen des Skigebiets von Samoëns in einem authentischen Chalet abseits jeglicher Urbanisierung, wo Sie unsere traditionellen Gerichte und savoyischen Spezialitäten genießen können. Im Winter mit den Skiern leicht erreichbar."
    ],
    "en": [
      "Restaurant in the heart of the Samoëns ski area in an authentic chalet away from any urbanisation where you can taste our traditional dishes and Savoyard specialities. Easily accessible by ski in winter."
    ],
    "it": [
      "Ristorante nel cuore del comprensorio sciistico di Samoëns, in un autentico chalet lontano da qualsiasi urbanizzazione, dove potrete gustare i nostri piatti tradizionali e le specialità savoiarde. Facilmente raggiungibile con gli sci in inverno."
    ],
    "fr": [
      "Restaurant au cœur du domaine skiable de Samoëns dans un chalet authentique à l'écart de toute urbanisation où vous pourrez déguster nos plats traditionnels et nos spécialités savoyardes. Facilement accessible en ski l'hiver."
    ],
    "es": [
      "Restaurante en el corazón del dominio esquiable de Samoëns, en un auténtico chalet alejado de cualquier urbanización, donde podrá degustar nuestros platos tradicionales y especialidades saboyanas. Fácilmente accesible en esquí en invierno."
    ],
    "nl": [
      "Restaurant in het hart van het skigebied van Samoëns in een authentiek chalet, weg van elke urbanisatie, waar u onze traditionele gerechten en Savoyaardse specialiteiten kunt proeven. Gemakkelijk bereikbaar met de ski in de winter."
    ]
  },
  "rdfs:label": {
