  "rdfs:comment": {
    "de": [
      "Auf der Tour du Beaufortain bietet Ihnen die Berghütte Le refuge de la Coire mittags ein À-la-carte-Restaurant an."
    ],
    "en": [
      "On the Beaufortain course, the Coire refuge propose some \"A la carte menu\", salads, assorted pok meat, cheese, omelet, sandwiches, but the dinner is reserved for people who sleep in the refuge."
    ],
    "it": [
      "Durante il tour di Beaufortain, Le refuge de la Coire offre una cena à la carte all'ora di pranzo."
    ],
    "fr": [
      "Sur le tour du Beaufortain, Le refuge de la Coire, vous propose le midi une restauration à la carte."
    ],
    "nl": [
      "Tijdens de rondleiding door Beaufortain, het toevluchtsoord van Chur, biedt u lunch à la carte catering."
    ],
    "es": [
      "En el recorrido de Beaufortain, Le refuge de la Coire ofrece cenas a la carta a la hora del almuerzo."
    ]
