  "rdfs:comment": {
    "de": [
      "Dieses Restaurant befindet sich in einem ehemaligen Stall in Val-Cenis Lanslevillard. Gemütliche und freundliche Atmosphäre, Küche aus frischen und lokalen Produkten, aber auch savoyische Spezialitäten, frischer Fisch und vegetarisches Menü."
    ],
    "en": [
      "This restaurant is located in an old stable in Val-Cenis Lanslevillard. Cosy and friendly atmosphere, cuisine made from fresh and local products, but also Savoyard specialities, fresh fish and vegetarian menu."
    ],
    "it": [
      "Questo ristorante si trova in una vecchia stalla nella Val-Cenis Lanslevillard. Ambiente accogliente e cordiale, cucina a base di prodotti freschi e locali, ma anche specialità savoiarde, pesce fresco e menù vegetariano."
    ],
    "fr": [
      "Ce restaurant est installé dans une ancienne étable à Val-Cenis Lanslevillard. Ambiance cosy et amicale, cuisine élaborée à partir de produits frais et locaux, mais aussi spécialités savoyarde, poisson frais et menu végétarien."
    ],
    "es": [
      "Este restaurante se encuentra en un antiguo establo de Val-Cenis Lanslevillard. Ambiente acogedor y agradable, cocina elaborada con productos frescos y locales, pero también especialidades saboyanas, pescado fresco y menú vegetariano."
    ],
    "nl": [
      "Dit restaurant is gevestigd in een oude stal in Val-Cenis Lanslevillard. Gezellige en vriendelijke sfeer, keuken op basis van verse en lokale producten, maar ook specialiteiten uit de Savoie, verse vis en vegetarisch menu."
    ]
  },
