  "rdfs:comment": {
    "de": [
      "Unter der Leitung von Philippe Girardon, einem Koch mit unbestreitbarer Leidenschaft und Erfahrung, werden aus frischen hochwertigen Produkten Bistrogerichte zubereitet und im großen Speisesaal oder auf der Terrasse im Schatten der Platanen serviert."
    ],
    "en": [
      "The country house has been totaly transformed into a hotel in contemporary style. The modern cuisine served in the restaurant is based on local produce. A room with a capacity for 130 can be used for banquets, and there are 3 meeting rooms to rent."
    ],
    "it": [
      "Guidato da Philippe Girardon, chef e proprietario del Domaine stellato Michelin e del Bib gourmand Cottage.\r\nI pasti, preparati in casa e a base di prodotti freschi, sono serviti nell'ampia e confortevole sala da pranzo o sulla terrazza, all'ombra del grande platano."
    ],
    "fr": [
      "Emmené par Philippe Girardon, Chef et propriétaire du Domaine étoilé et du Cottage Bib gourmand. \r\nUne cuisine  maison à base de beaux produits frais que l'on dévore dans la grande salle à manger confortable ou en terrasse, à l'ombre du grand platane."
    ],
    "nl": [
      "Onder leiding van Philippe Girardon, chef-kok en eigenaar van het met een Michelin-ster bekroonde Domaine en de Bib gourmand Cottage.\r\nHuisgemaakte maaltijden op basis van verse producten worden geserveerd in de grote, comfortabele eetzaal of op het terras, in de schaduw van de grote plataan."
    ],
    "es": [
      "Dirigido por Philippe Girardon, Chef y propietario del Domaine, galardonado con una estrella Michelin, y del Bib gourmand Cottage.\r\nLas comidas caseras a base de productos frescos se sirven en el amplio y confortable comedor o en la terraza, a la sombra del gran plátano."
    ]
  },
