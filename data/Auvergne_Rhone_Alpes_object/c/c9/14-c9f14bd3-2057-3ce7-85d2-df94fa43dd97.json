      "@id": "https://data.datatourisme.fr/0f92ae8a-590a-35e0-ae3e-905d6582cb25",
      "dc:description": {
        "de": [
          "Samstag, den 14. März 2026\n16 Uhr - \"Le passage de Victor Hugo à Montreuil-sur-mer\", moderiert von Gérard Robette-Papet.\nEintritt 5?\n\nSamstag, 18. April 2026\n16 Uhr - \"Das religiöse Erbe im Zentrum der Geschichte von Montreuil-sur-Mer\", moderiert von Bruno Béthouart.\nEintritt 5?"
        ],
        "en": [
          "Saturday, March 14, 2026\n4pm - \"Victor Hugo's passage through Montreuil-sur-mer\", hosted by Gérard Robette-Papet.\nAdmission 5?\n\nSaturday, April 18, 2026\n16h - \"Religious heritage at the heart of Montreuil-sur-mer's history\" hosted by Bruno Béthouart.\nAdmission 5?"
        ],
        "it": [
          "Sabato 14 marzo 2026\nore 16.00 - \"Il passaggio di Victor Hugo a Montreuil-sur-mer\", conferenza di Gérard Robette-Papet.\nIngresso 5?\n\nSabato 18 aprile 2026\nore 16.00 - \"Il patrimonio religioso al centro della storia di Montreuil-sur-mer\", conferenza di Bruno Béthouart.\nIngresso: 5 €?"
        ],
        "fr": [
          "Samedi 14 mars 2026\n16h - \"Le passage de Victor Hugo à Montreuil-sur-mer\" animée par Gérard Robette-Papet.\nEntrée 5€\n\nSamedi 18 avril 2026\n16h - \"Le patrimoine religieux au coeur de l'histoire de Montreuil-sur-mer\" animée par Bruno Béthouart.\nEntrée 5€"
        ],
        "nl": [
          "Zaterdag 14 maart 2026\n16.00 uur - \"Victor Hugo's passage door Montreuil-sur-mer\", lezing door Gérard Robette-Papet.\nToegang 5?\n\nZaterdag 18 april 2026\n16u00 - \"Religieus erfgoed in het hart van de geschiedenis van Montreuil-sur-mer\", lezing door Bruno Béthouart.\nToegang: €5?"
        ],
        "es": [
          "Sábado 14 de marzo de 2026\n16:00 h - \"El paso de Victor Hugo por Montreuil-sur-mer\", conferencia de Gérard Robette-Papet.\nEntrada 5?\n\nSábado 18 de abril de 2026\n16:00 h - \"El patrimonio religioso en el corazón de la historia de Montreuil-sur-mer\", conferencia a cargo de Bruno Béthouart.\nEntrada: 5?"
        ]
      },
