  "rdfs:comment": {
    "de": [
      "Es ist jetzt möglich, Zug und Fahrrad zu kombinieren, dank der Chemin de Fer de la Baie de Somme, die es Reisenden ermöglicht, ihr Fahrrad kostenlos zu transportieren!"
    ],
    "en": [
      "It is now possible to combine train and bike thanks to the Chemin de Fer de la Baie de Somme which allows travelers to transport their bikes for free!"
    ],
    "it": [
      "Ora è possibile combinare treno e bicicletta grazie al Chemin de Fer de la Baie de Somme che permette ai viaggiatori di trasportare gratuitamente le loro biciclette!"
    ],
    "fr": [
      "Il est maintenant possible d'allier train et vélo grâce au Chemin de Fer de la Baie de Somme qui permet aux voyageurs de transporter leur vélo gratuitement !"
    ],
    "nl": [
      "Het is nu mogelijk om trein en fiets te combineren dankzij de Chemin de Fer de la Baie de Somme, die reizigers toestaat hun fiets gratis te vervoeren!"
    ],
    "es": [
      "Ahora es posible combinar tren y bicicleta gracias al Chemin de Fer de la Baie de Somme, que permite a los viajeros transportar gratuitamente sus bicicletas"
    ]
  },
  "rdfs:label": {
