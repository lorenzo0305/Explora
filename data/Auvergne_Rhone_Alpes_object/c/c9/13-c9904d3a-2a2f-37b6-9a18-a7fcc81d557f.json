  "rdfs:comment": {
    "de": [
      "Entdecken Sie im Zig Zag Café in gemütlicher Atmosphäre traditionelle Küche.\r\nFür Empfänge oder größere Gruppen steht Ihnen ein ausgezeichneter Partyservice zur Verfügung."
    ],
    "en": [
      "Enjoy traditional dishes at Le Zig Zag Café in a friendly atmosphere.\r\nThe restaurant has a great catering service for functions and groups."
    ],
    "it": [
      "Lo Zig Zag Café vi invita a scoprire una cucina tradizionale in un ambiente conviviale.\r\nE per i ricevimenti il ristorante garantisce anche un eccellente servizio di catering."
    ],
    "fr": [
      "Brasserie avec bar, menus, plat du jour. Restaurant avec cuisine de tradition, carte et spécialités. \r\nMagasin traiteur du plat à emporter à la réception."
    ],
    "nl": [
      "Brasserie met bar, menu's en dagschotels. Restaurant met traditionele keuken, à la carte en specialiteiten.\r\nHorecazaak van afhaalmaaltijden tot receptie."
    ],
    "es": [
      "Brasserie con bar, menús, ofertas diarias. Restaurante con cocina tradicional, menú y especialidades\r\nTienda de catering desde la comida para llevar hasta la recepción."
    ]
  },
