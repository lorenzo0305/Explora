  "rdfs:comment": {
    "de": [
      "Produzent von Obst, Gemüse, Setzlingen und Obstbäumen, Apfelsaft und Konfitüren.\r\nAB-Label und Werte für den regionalen Naturpark Vercors.\r\nJede Woche Markt in Autrans am Mittwoch.\r\nAlle 15 Tage im Sommer Markt in Villard am Sonntag."
    ],
    "en": [
      "Producer of fruit, vegetables, fruit plants and trees, apple juice and jams.\r\nLabel AB and Valeurs Parc naturel régional du Vercors.\r\nWeekly market in Autrans on Wednesdays.\r\nEvery 15 days in summer, Villard market on Sunday."
    ],
    "it": [
      "Produttore di frutta, verdura, piantine e alberi da frutto, succo di mela e marmellata.\r\nMarchio AB e valori del Parco Naturale Regionale del Vercors.\r\nMercato settimanale a Autrans il mercoledì.\r\nOgni 15 giorni in estate, mercato di Villard la domenica."
    ],
    "fr": [
      "Producteur de fruits, légumes, plants et arbres fruitiers, jus de pomme et confitures.\r\nLabel AB et Valeurs Parc naturel régional du Vercors.\r\nChaque semaine marché d'Autrans le mercredi.\r\nTous les 15j en été marché de Villard le dimanche."
    ],
    "es": [
      "Productor de frutas, hortalizas, plantones y árboles frutales, zumo de manzana y mermelada.\r\nEtiqueta AB y valores del Parque Natural Regional de Vercors.\r\nMercado semanal en Autrans los miércoles.\r\nCada 15 días en verano, mercado de Villard los domingos."
    ],
    "nl": [
      "Producent van fruit, groenten, zaailingen en fruitbomen, appelsap en jam.\r\nAB-label en waarden Regionaal Natuurpark Vercors.\r\nWekelijkse markt in Autrans op woensdag.\r\nIn de zomer om de 15 dagen markt in Villard op zondag."
    ]
  },
