  "rdfs:comment": {
    "de": [
      "Diese Kapelle der Diözese Saint-Paul-trois-châteaux wurde am Fuße des Felsens errichtet, auf dem sich die Burg befindet, innerhalb der befestigten Stadtmauern des Dorfes."
    ],
    "en": [
      "Saint Felix (Norman and Moorish style chapel) is dated from the 11th century and was built in the village enclosure, at the foot of the castle."
    ],
    "it": [
      "La cappella di Saint-Félix dell'XI secolo, costruita nella roccia in stile romanico-moresco, fa parte della diocesi di Saint-Paul-trois-châteaux ed è stata edificata ai piedi della roccia che ospita il castello, all'interno delle mura fortificate del villaggio."
    ],
    "fr": [
      "La chapelle saint-Félix du XIe siècle implantée dans le rocher, de style roman et mauresque.Cette chapelle du diocèse de Saint-Paul-trois-châteaux a été construite au pied du rocher portant le château, à l'intérieur de l'enceinte fortifiée du village."
    ],
    "es": [
      "La capilla de Saint-Félix, del siglo XI, construida en la roca en estilo románico-morisco, pertenece a la diócesis de Saint-Paul-trois-châteaux y fue edificada al pie de la roca que alberga el castillo, dentro de las murallas fortificadas del pueblo."
    ],
    "nl": [
      "De 11e-eeuwse kapel Saint-Félix, gebouwd in de rots in Romaans-Moorse stijl, maakt deel uit van het bisdom Saint-Paul-trois-châteaux en werd gebouwd aan de voet van de rots met het kasteel, binnen de versterkte dorpsmuren."
    ]
  },
