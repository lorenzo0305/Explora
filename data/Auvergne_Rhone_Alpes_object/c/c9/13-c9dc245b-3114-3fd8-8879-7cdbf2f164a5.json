  "rdfs:comment": {
    "de": [
      "Stickerei aus Lunéville und Perlenweberei.\r\nNathalie Teissier ist seit April 2022 Gründerin von Féérie de perles und bietet handgefertigte Bilder, Schmuck und Modeaccessoires an."
    ],
    "en": [
      "Lunéville embroidery and pearl weaving.\r\nCreator of Féérie de perles in April 2022, Nathalie Teissier designs handmade paintings, jewelry and fashion accessories."
    ],
    "it": [
      "Ricamo Lunéville e tessitura di perle.\r\nCreata la Féérie de perles nell'aprile 2022, Nathalie Teissier crea a mano dipinti, gioielli e accessori di moda."
    ],
    "fr": [
      "Broderie de Lunéville et tissage de perles.\r\nCréatrice de Féérie de perles en avril 2022, Nathalie Teissier propose des créations de tableaux, bijoux et accessoires de mode réalisés à la main."
    ],
    "nl": [
      "Lunéville borduurwerk en parelweven.\r\nNathalie Teissier richtte in april 2022 Féérie de perles op en maakt handgemaakte schilderijen, sieraden en modeaccessoires."
    ],
    "es": [
      "Bordado de Lunéville y tejido de perlas.\r\nCreó Féérie de perles en abril de 2022, Nathalie Teissier crea cuadros hechos a mano, joyas y accesorios de moda."
    ]
  },
