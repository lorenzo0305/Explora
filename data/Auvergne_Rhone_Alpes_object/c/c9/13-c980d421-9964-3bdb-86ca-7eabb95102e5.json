  "rdfs:comment": {
    "de": [
      "Erliegen Sie dem Charme der Ufer des Genfersees, des größten Süßwassersees in Westeuropa, und verbringen Sie ein paar Tage im Hotel-Restaurant. La Riviera Victoria**** befindet sich im Herzen des mittelalterlichen Dorfes gegenüber dem Jachthafen von Yvoire.\nJachthafen von Yvoire."
    ],
    "en": [
      "Succumb to the charm of the shores of Lake Geneva, Western Europe's largest body of fresh water, by spending a few days at the Hôtel-Restaurant. La Riviera Victoria**** located in the heart of the medieval village, opposite Yvoire's\r\nthe Yvoire marina."
    ],
    "it": [
      "Lasciatevi conquistare dal fascino delle rive del Lago di Ginevra, la più grande distesa d'acqua dolce dell'Europa occidentale, trascorrendo qualche giorno all'Hôtel-Restaurant. La Riviera Victoria**** situato nel cuore del villaggio medievale, di fronte al porto turistico di Yvoire\r\nil porto turistico di Yvoire."
    ],
    "fr": [
      "Succombez au charme des rives du Léman, la plus vaste étendue d’eau douce d’Europe occidentale, en venant passer quelques jours à l’Hôtel-Restaurant. La Riviera Victoria**** situé en plein coeur du village médiéval, face au port de\r\nplaisance d’Yvoire."
    ],
    "es": [
      "Sucumba al encanto de las orillas del lago Lemán, la mayor extensión de agua dulce de Europa Occidental, pasando unos días en el Hôtel-Restaurant La Riviera Victoria**** situado en el corazón del pueblo medieval, frente al puerto deportivo de Yvoire\r\nel puerto deportivo de Yvoire."
    ],
    "nl": [
      "Laat je verleiden door de charme van de oevers van het Meer van Genève, de grootste zoetwatervlakte van West-Europa, door een paar dagen door te brengen in Hôtel-Restaurant. La Riviera Victoria**** ligt in het hart van het middeleeuwse dorp, tegenover de jachthaven van Yvoire\r\nde jachthaven van Yvoire."
    ]
  },
