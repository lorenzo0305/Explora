  "rdfs:comment": {
    "de": [
      "Willkommen im Relais Cyné in Saint Antoine de l'Abbaye; wir können Sie für ein Picknick oder einen Biwak empfangen. Ein Picknicktisch, eine Anbindestange für Pferde und ein Unterstand stehen Ihnen zur Verfügung."
    ],
    "en": [
      "Welcome to Relais Cyné in Saint Antoine de l'Abbaye; we can welcome you for a picnic or a bivouac. Picnic table, horse tie-up bar and shelter are at your disposal."
    ],
    "it": [
      "Benvenuti al Relais Cyné a Saint Antoine de l'Abbaye; possiamo ospitarvi per un picnic o un bivacco. Abbiamo un tavolo da picnic, una barra per legare i cavalli e un riparo."
    ],
    "fr": [
      "Bienvenue au Relais Cyné de Saint Antoine de l'Abbaye; nous pouvons vous accueillir le temps d'un pique nique ou pour une étape en bivouac. Table de pique-nique, barre d'attache pour chevaux, et abri sont mis à votre disposition."
    ],
    "nl": [
      "Welkom bij Relais Cyné in Saint Antoine de l'Abbaye; je kunt bij ons terecht voor een picknick of een bivak. We hebben een picknicktafel, een tui voor paarden en een schuilhut."
    ],
    "es": [
      "Bienvenido al Relais Cyné en Saint Antoine de l'Abbaye; podemos acogerle para un picnic o un vivac. Disponemos de una mesa de picnic, una barra de amarre para caballos y un refugio."
    ]
  },
  "rdfs:label": {
