  "rdfs:comment": {
    "de": [
      "Thibault und Grégory Cuilleron verweisen auf ihre Großmutter Paulette und bieten eine einfache Küche aus sorgfältig ausgewählten lokalen Produkten an."
    ],
    "en": [
      "Thibault and Grégory Spoilleron make a little nod to their grandmother Paulette by offering a simple cuisine made with carefully selected local products."
    ],
    "it": [
      "Thibault e Grégory Cuilleron fanno un piccolo omaggio alla nonna Paulette proponendo una cucina semplice a base di prodotti locali accuratamente selezionati."
    ],
    "fr": [
      "Thibault et Grégory Cuilleron font un petit clin d'oeil à leur grand-mère Paulette en proposant une cuisine simple faite de produits locaux soigneusement sélectionnés."
    ],
    "es": [
      "Thibault y Grégory Cuilleron hacen un pequeño guiño a su abuela Paulette ofreciendo una cocina sencilla elaborada con productos locales cuidadosamente seleccionados."
    ],
    "nl": [
      "Thibault en Grégory Cuilleron maken een kleine knipoog naar hun grootmoeder Paulette door een eenvoudige keuken aan te bieden, gemaakt van zorgvuldig geselecteerde lokale producten."
    ]
  },
