  "rdfs:comment": {
    "de": [
      "Entdecken Sie auf den Höhen von Gannat einen Kiefernwald, der den Hang von Les Chapelles bedeckt, einen geschützten Ort, an dem sich zahlreiche wilde Orchideen und damit verbundene Insekten entwickeln."
    ],
    "en": [
      "Orchids trail , remarkable site, lookout point offering spectacular views"
    ],
    "it": [
      "Sulle alture di Gannat, scoprite la pineta che sovrasta la collina delle Chapelles, un sito protetto dove prosperano numerose orchidee selvatiche e insetti associati."
    ],
    "fr": [
      "Découvrez sur les hauteurs de Gannat une pinède qui coiffe le coteau des Chapelles, un site préservé où se développent de nombreuses orchidées sauvages et insectes associés."
    ],
    "nl": [
      "Ontdek op de hoogten van Gannat het dennenbos op de heuvel Chapelles, een beschermd gebied waar veel wilde orchideeën en bijbehorende insecten gedijen."
    ],
    "es": [
      "En las alturas de Gannat, descubra el pinar que corona la ladera de las Chapelles, un lugar protegido donde prosperan numerosas orquídeas silvestres e insectos asociados."
    ]
  },
  "rdfs:label": {
    "en": [
      "Orchides trail"
    ],
    "fr": [
      "Coteau des Chapelles/Sentier des Orchidées"
    ]
  },
