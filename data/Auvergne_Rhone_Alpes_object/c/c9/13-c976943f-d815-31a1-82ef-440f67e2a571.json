  "rdfs:comment": {
    "de": [
      "Die im 19. und 20. Jahrhundert restaurierte Kirche beherbergt eine außergewöhnliche Sammlung von 12 flämischen Gemälden aus dem 16. Jahrhundert, die Statue von Notre-Dame de Montfaucon und einen Hochaltar aus weißem italienischem Marmor."
    ],
    "en": [
      "Restored in the 19th and 20th centuries, the church houses an exceptional collection of 12 16th-century Flemish paintings, the statue of Notre-Dame de Montfaucon and a high altar in white Italian marble."
    ],
    "it": [
      "Restaurata nel XIX e XX secolo, la chiesa ospita un'eccezionale collezione di 12 dipinti fiamminghi del XVI secolo, la statua di Notre-Dame de Montfaucon e un altare maggiore in marmo bianco italiano."
    ],
    "fr": [
      "Restaurée aux XIXe et XXe siècles, l'église abrite une collection exceptionnelle de 12 tableaux flamands du XVIe siècle, la statue de Notre-Dame de Montfaucon et un maître-autel en marbre blanc d'Italie."
    ],
    "es": [
      "Restaurada en los siglos XIX y XX, la iglesia alberga una excepcional colección de 12 pinturas flamencas del siglo XVI, la estatua de Notre-Dame de Montfaucon y un altar mayor de mármol blanco italiano."
    ],
    "nl": [
      "De kerk werd in de 19e en 20e eeuw gerestaureerd en herbergt een uitzonderlijke collectie van 12 Vlaamse schilderijen uit de 16e eeuw, het standbeeld van Notre-Dame de Montfaucon en een hoogaltaar van wit Italiaans marmer."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Chapelle Notre-Dame"
    ]
  },
