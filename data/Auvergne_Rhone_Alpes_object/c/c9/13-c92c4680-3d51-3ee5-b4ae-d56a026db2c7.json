  "rdfs:comment": {
    "de": [
      "Ideaal gelegen halverwege tussen Valence en Montélimar en op een steenworp afstand van de Ardèche, het Château de Freycinet verwelkomt u in het restaurant het hele jaar door."
    ],
    "en": [
      "Ideally located halfway between Valence and Montélimar and a stone’s throw from the Ardèche, the Château de Freycinet welcomes you in its restaurant all year round."
    ],
    "it": [
      "Situato in posizione ideale a metà strada tra Valence e Montélimar e a due passi dall'Ardèche.\r\nIl ristorante Le Rose vi accoglie tutto l'anno dal giovedì sera alla domenica a pranzo e al lunedì a pranzo."
    ],
    "fr": [
      "Idéalement situé à mi-chemin entre Valence et Montélimar et à deux pas de l’Ardèche. \r\nLe Rose restaurant vous accueille toute l'année du jeudi soir au dimanche midi et le lundi midi ."
    ],
    "es": [
      "Idealmente situado a medio camino entre Valence y Montélimar y a dos pasos de la Ardèche.\r\nEl restaurante Le Rose le da la bienvenida todo el año, desde el jueves por la noche hasta el domingo al mediodía y el lunes al mediodía."
    ],
    "nl": [
      "Ideaal gelegen halverwege tussen Valence en Montélimar en op een steenworp afstand van de Ardèche, het Château de Freycinet verwelkomt u in het restaurant het hele jaar door."
    ]
  },
