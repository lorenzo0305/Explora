  "rdfs:comment": {
    "de": [
      "Ein Familienparcours, auf dem Sie das Dorf Roche en Régnier mit seinen kleinen Gassen, den Stadtmauern und dem auf einem Hügel stehenden Turm entdecken können. An jeder Markierung ist der Weg mit Texten und kleinen Quizfragen versehen, um die Geschichte des Dorfes besser kennenzulernen."
    ],
    "en": [
      "A family trail to discover the village of Roche en Régnier, with its narrow streets, ramparts and hilltop tower. At each marker, the route is enhanced by texts and quizzes to help you learn more about the village?s history."
    ],
    "it": [
      "Un percorso per famiglie alla scoperta del villaggio di Roche en Régnier, delle sue stradine, dei bastioni e della torre arroccata su una collina. A ogni tappa, il percorso è arricchito da testi e brevi quiz che aiutano a conoscere meglio la storia del villaggio."
    ],
    "fr": [
      "Parcours familial pour découvrir le village de Roche en Régnier, ses petites ruelles, les remparts et la Tour juchée sur une colline. A chaque balise, le parcours est agrémenté de textes et de petits quizz pour mieux connaître l’histoire du village."
    ],
    "es": [
      "Un recorrido familiar para descubrir el pueblo de Roche en Régnier, sus callejuelas, sus murallas y su torre encaramada en una colina. En cada hito, el itinerario se completa con textos y pequeñas preguntas para conocer mejor la historia del pueblo."
    ],
    "nl": [
      "Een familiewandeling om het dorp Roche en Régnier met zijn smalle straatjes, vestingmuren en toren op een heuvel te ontdekken. Bij elke markering wordt de route aangevuld met teksten en korte quizzen om meer te weten te komen over de geschiedenis van het dorp."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parcours d'orientation Patrimoine à Roche-en-Régnier"
    ]
  },
