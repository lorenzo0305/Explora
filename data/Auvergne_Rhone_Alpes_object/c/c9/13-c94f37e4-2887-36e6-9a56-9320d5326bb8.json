  "rdfs:comment": {
    "de": [
      "Genieben sie eine ponyfahrt mit der familie."
    ],
    "en": [
      "Come discover the equestrian activities at Ferme Les Fougères. \r\nEquitation session, hiking and careers on pony or horse.\r\nEquipraticie session (the mediating horse).\r\n\r\nEnjoy horse riding with family."
    ],
    "it": [
      "Siete alla ricerca di una passeggiata in famiglia con i pony, di un trekking a cavallo o di un momento individuale per ricaricare le batterie e scoprire voi stessi (mediazione animale)? Scoprite tutte le attività equestri supervisionate da Patricia Valentin."
    ],
    "fr": [
      "Envie d’une balade en famille à poney, d’une randonnée à cheval ou d’un temps individuel pour se ressourcer et se découvrir (médiation avec l’animal). Découvrez toutes les activités équestres encadrées par Patricia Valentin."
    ],
    "es": [
      "¿Busca un paseo en poni en familia, una excursión a caballo o un momento individual para recargar las pilas y descubrirse a sí mismo (mediación animal)? Descubra todas las actividades ecuestres supervisadas por Patricia Valentin."
    ],
    "nl": [
      "Op zoek naar een ponyrit met het gezin, een trektocht te paard of een individuele tijd om nieuwe energie op te doen en jezelf te ontdekken (dierlijke bemiddeling)? Ontdek alle ruiteractiviteiten onder begeleiding van Patricia Valentin."
    ]
  },
  "rdfs:label": {
    "de": [
      "Reiterhof 'Les Fougères'"
    ],
    "en": [
      "Equestrian Farm 'Les Fougères'"
    ],
    "fr": [
      "Ferme équestre Les Fougères"
    ]
  },
