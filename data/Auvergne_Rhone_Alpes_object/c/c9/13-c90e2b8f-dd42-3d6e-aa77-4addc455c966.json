  "rdfs:comment": {
    "de": [
      "Die Semène wird auf einer Strecke von etwa 40 km an elf Gemeinden in zwei Departements (Loire und Haute-Loire) vorbeifließen, bevor sie in die Loire mündet."
    ],
    "en": [
      "The Semène will flow through eleven communes in two départements (Loire and Haute-Loire) over a distance of some forty kilometers before emptying into the Loire."
    ],
    "it": [
      "Il Semène attraverserà undici comuni in due dipartimenti (Loira e Alta Loira) per una distanza di circa quaranta chilometri prima di sfociare nella Loira."
    ],
    "fr": [
      "La Semène va côtoyer onze communes de deux départements (Loire et Haute-Loire) sur un parcours d'une quarantaine de kilomètres avant de se jeter dans la Loire."
    ],
    "es": [
      "El Semène atravesará once municipios de dos departamentos (Loira y Alto Loira) a lo largo de unos cuarenta kilómetros antes de desembocar en el Loira."
    ],
    "nl": [
      "De Semène stroomt door elf gemeenten in twee departementen (Loire en Haute-Loire) over een afstand van ongeveer veertig kilometer voordat hij uitmondt in de Loire."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Pêche dans la rivière Semène"
    ]
  },
