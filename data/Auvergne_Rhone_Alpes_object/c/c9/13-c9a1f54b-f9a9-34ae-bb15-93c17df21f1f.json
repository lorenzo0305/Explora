  "rdfs:comment": {
    "de": [
      "Diese Abtei aus dem 12. Jahrhundert ist Eigentum der Gemeinde Sixt-Fer-à-Cheval und des Departements Haute-Savoie.\r\nSie beherbergt jeden Sommer eine Ausstellung zu einem bestimmten Thema."
    ],
    "en": [
      "This 12th-century abbey is owned by the commune of Sixt-Fer-à-Cheval and the Département de la Haute-Savoie.\nIt hosts a themed exhibition every summer."
    ],
    "it": [
      "Questa abbazia del XII secolo è di proprietà del comune di Sixt-Fer-à-Cheval e del Dipartimento dell'Alta Savoia.\r\nOgni estate ospita una mostra a tema."
    ],
    "fr": [
      "Cette abbaye du XIIe siècle est propriété de la commune de Sixt-Fer-à-Cheval et du Département de la Haute-Savoie.\r\nElle accueille tous les été une exposition à thème."
    ],
    "es": [
      "Esta abadía del siglo XII es propiedad del municipio de Sixt-Fer-à-Cheval y del departamento de Alta Saboya.\r\nCada verano acoge una exposición temática."
    ],
    "nl": [
      "Deze 12e-eeuwse abdij is eigendom van de gemeente Sixt-Fer-à-Cheval en het departement Haute-Savoie.\r\nElke zomer is er een thematentoonstelling."
    ]
  },
