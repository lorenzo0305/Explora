  "rdfs:comment": {
    "de": [
      "ACCRO?NAT organisiert angepasste Ferienaufenthalte in der Haute-Loire und anderswo: Aufenthalte mit Schwerpunkt auf Tourismus, Entdeckung von Freizeitaktivitäten für Erwachsene mit geistiger Behinderung, geistig Behinderte mit guter und großer Autonomie (ESAT-Arbeiter,...)"
    ],
    "en": [
      "ACCRO?NAT organizes Adapted Vacation Stays in the Haute-Loire and elsewhere: stays focusing on tourism, discovery of leisure activities for intellectually disabled adults, mentally handicapped people with good and great autonomy (ESAT workers, etc.)"
    ],
    "it": [
      "L'ACCRO?NAT organizza vacanze adattate nell'Alta Loira e altrove: vacanze incentrate sul turismo, sulla scoperta di attività ricreative per adulti con disabilità intellettiva, persone con disabilità mentale con buona o grande autonomia (operatori ESAT, ecc.)"
    ],
    "fr": [
      "ACCRO’NAT organise des Séjours de Vacances Adaptées en Haute-Loire et Ailleurs : séjours axés sur le tourisme, découverte des loisirs à destination d’adultes déficients intellectuels, handicapés mentaux de bonne et grande autonomie (travailleurs ESAT,..)"
    ],
    "es": [
      "ACCRO?NAT organiza Vacaciones Adaptadas en la Haute-Loire y otros lugares: vacaciones centradas en el turismo, el descubrimiento de actividades de ocio para adultos con discapacidad intelectual, discapacitados psíquicos con buena o gran autonomía (trabajadores de ESAT, etc.)"
    ],
    "nl": [
      "ACCRO?NAT organiseert aangepaste vakanties in de Haute-Loire en elders: vakanties gericht op toerisme, ontdekking van vrijetijdsactiviteiten voor volwassenen met een verstandelijke beperking, verstandelijk gehandicapten met een goede of grote zelfstandigheid (ESAT-medewerkers, enz.)"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Accro'Nat  Organisation de Séjours"
    ]
  },
