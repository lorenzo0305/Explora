  "rdfs:comment": {
    "de": [
      "Haben Sie Lust typische Küche des Forez zu probieren? Kommen Sie zum Landgasthof Trabuches am Fusse des Berges Pic de St-Romain-le-Puy. David schlägt Ihnen in diesem typischen Bauernhaus Froschschenkel auf traditionelle Art oder mit Fourme (Käse) vor aber auch Kartoffelpuffer und andere örtliche Spezialitäten."
    ],
    "en": [
      "Between Saint-Etienne and Montbrison, discover or rediscover the local dishes in a restaurant that will charm you with its authentic setting and the warmth of its owners."
    ],
    "it": [
      "Tra Saint-Etienne e Montbrison, scoprite o riscoprite la cucina della nostra regione in un ristorante che vi affascinerà con il suo ambiente autentico e verdeggiante e il calore dei suoi proprietari."
    ],
    "fr": [
      "Entre Saint-Etienne et Montbrison, découvrez ou redécouvrez la cuisine de notre terroir dans un restaurant qui saura vous charmer par son cadre authentique et verdoyant ainsi que par la chaleur de ses propriétaires."
    ],
    "nl": [
      "Tussen Saint-Etienne en Montbrison kunt u de keuken van onze streek ontdekken of herontdekken in een restaurant dat u zal bekoren met zijn authentieke, lommerrijke omgeving en de hartelijkheid van de eigenaars."
    ],
    "es": [
      "Entre Saint-Etienne y Montbrison, descubra o redescubra la cocina de nuestra región en un restaurante que le encantará por su entorno auténtico y frondoso y por la calidez de sus propietarios."
    ]
  },
