  "rdfs:comment": {
    "de": [
      "An der Bergstation der Seilbahn Les Prodains empfängt Sie das Le Spot Café für ein Getränk oder eine hausgemachte Mahlzeit. Frühstück, Brunch, Burger oder Tagesgericht: eine großzügige Küche mit Blick auf das Skigebiet von Avoriaz."
    ],
    "en": [
      "At the arrival of the Prodains cable car, Le Spot Café welcomes you for a drink or a homemade meal. Breakfast, brunch, burgers, or the dish of the day – enjoy generous cuisine with a view over the Avoriaz ski area."
    ],
    "it": [
      "Appena fuori dalla funivia Prodains, Le Spot Café vi accoglie per un drink o un pasto fatto in casa. Colazione, brunch, hamburger o specialità del giorno: una cucina generosa con vista sul comprensorio sciistico di Avoriaz."
    ],
    "fr": [
      "À l’arrivée du téléphérique des Prodains, Le Spot Café vous accueille pour un verre ou un repas maison. Petit déj’, brunch, burgers ou plat du jour : une cuisine généreuse avec vue sur le domaine d’Avoriaz."
    ],
    "es": [
      "Justo al lado del teleférico de Prodains, Le Spot Café le da la bienvenida para tomar una copa o una comida casera. Desayuno, brunch, hamburguesas o platos del día: cocina generosa con vistas al dominio esquiable de Avoriaz."
    ],
    "nl": [
      "Bij aankomst van de kabelbaan van Les Prodains heet Le Spot Café je welkom voor een drankje of een huisgemaakte maaltijd. Ontbijt, brunch, burgers of het dagmenu – geniet van een rijke keuken met uitzicht op het skigebied van Avoriaz."
    ]
  },
