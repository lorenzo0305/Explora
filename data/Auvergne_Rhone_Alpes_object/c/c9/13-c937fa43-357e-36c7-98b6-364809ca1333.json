  "rdfs:comment": {
    "de": [
      "Direktverkauf von Ziegen- und Kuhkäse sowie von regionalen Produkten (Marmeladen, Terrinen, Bonbons, Honig, Kuchen und Wurstwaren).\r\nKleine Speisen und Getränke\r\nPonyreiten während der Sommerferien und an den Wochenenden im September"
    ],
    "en": [
      "Sale of cheeses made from goat's milk and cow's milk, as well as other regional products (jams, pâtés, sweets, honey, cakes and saucission)."
    ],
    "it": [
      "Vendita diretta di formaggi di capra e di mucca e di prodotti regionali (marmellate, terrine, dolci, mieli, torte e salsicce).\r\nPiccolo ristorante\r\nPasseggiate su pony durante le vacanze estive e nei fine settimana di settembre"
    ],
    "fr": [
      "Vente directe de fromages de chèvres et de vaches ainsi que des produits régionaux  (confitures,terrines, bonbons, miels,gâteaux et saucissons).\r\nPetite restauration\r\nBalade à poney durant les vacances d'été et les week-end de septembre"
    ],
    "es": [
      "Venta directa de quesos de cabra y vaca, así como de productos regionales (mermeladas, terrinas, dulces, mieles, pasteles y embutidos).\r\nPequeño restaurante\r\nPaseos en poni durante las vacaciones de verano y los fines de semana de septiembre"
    ],
    "nl": [
      "Directe verkoop van geiten- en koeienkazen en regionale producten (jam, terrines, snoep, honing, gebak en worst).\r\nKlein restaurant\r\nPonyrijden tijdens de zomervakantie en in het weekend in september"
    ]
  },
  "rdfs:label": {
    "en": [
      "Chalet de Laura"
    ],
