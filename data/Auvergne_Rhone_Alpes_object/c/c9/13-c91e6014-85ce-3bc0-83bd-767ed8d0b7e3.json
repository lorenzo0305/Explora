  "rdfs:comment": {
    "de": [
      "Sie können à la carte wählen oder sich für die handwerklich hergestellten Pizzen aus dem Holzofen vor Ort oder zum Mitnehmen entscheiden."
    ],
    "en": [
      "You can choose from the à la carte menu or opt for the artisanal pizzas cooked in the wood fire on the spot or to take away."
    ],
    "it": [
      "Potete scegliere dal menu à la carte o optare per le pizze fatte in casa cotte nel forno a legna in loco o da asporto."
    ],
    "fr": [
      "Vous pourrez choisir à la carte ou opter pour les pizzas artisanales cuites au feu de bois sur place ou à emporter."
    ],
    "nl": [
      "U kunt kiezen uit het à la carte menu of kiezen voor de huisgemaakte pizza's die ter plaatse in de houtoven worden bereid of om mee te nemen."
    ],
    "es": [
      "Puedes elegir entre el menú a la carta o decantarte por las pizzas caseras cocinadas en el horno de leña in situ o para llevar."
    ]
  },
