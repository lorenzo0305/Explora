  "rdfs:comment": {
    "de": [
      "Der Club ist der Fédération Française de cyclotourisme angeschlossen. Wir praktizieren Straßenradfahren und Mountainbiking ohne Wettbewerbsgedanken.\r\nVereinsausfahrten am Sonntagmorgen. Ausfahrten unter der Woche am Dienstag und Donnerstag."
    ],
    "en": [
      "Affiliated with the Fédération Française de cyclotourisme, we offer non-competitive road and mountain biking.\r\nClub outings on Sunday mornings. Weekday outings on Tuesdays and Thursdays."
    ],
    "it": [
      "Club affiliato alla Federazione Ciclistica Francese, pratichiamo la bicicletta su strada e la mountain bike senza spirito competitivo.\r\nUscite del club la domenica mattina. Uscite feriali il martedì e il giovedì."
    ],
    "fr": [
      "Club affilié à la Fédération Française de cyclotourisme, nous pratiquons le vélo de route et VTT sans esprit de compétition.\r\nSortie club le dimanche matin. Sorties en semaine les mardi et jeudi."
    ],
    "es": [
      "Club afiliado a la Federación Francesa de Ciclismo, practicamos el ciclismo de carretera y de montaña sin espíritu competitivo.\r\nSalidas del club los domingos por la mañana. Salidas entre semana los martes y jueves."
    ],
    "nl": [
      "Aangesloten bij de Fédération Française de Cyclotourisme, bieden we niet-competitief fietsen op de weg en mountainbiken.\r\nClubuitstapjes op zondagochtend. Doordeweekse tochten op dinsdag en donderdag."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Cyclotouristes Pierrelattins"
    ]
  },
