  "rdfs:comment": {
    "de": [
      "Auf dem Gipfel der Station La Sambuy: Hotdiot, kalte und warme Getränke, Käse und lokale Produkte. 100% made in Là Haut!\r\nPanoramaterrasse mit 360°-Blick auf den See von Annecy und den Mont-Blanc, Musik, Stimmung..."
    ],
    "en": [
      "At the top of the La Sambuy ski area, enjoy tasty diot sausages, hot and cold drinks, cheeses, and local products. 100% made in Là Haut!\r\nDeck with 360° panoramic views of Lake Annecy, Mont Blanc, music, a great atmosphere..."
    ],
    "it": [
      "In cima alla stazione di Sambuy: Hotdiot, bevande calde e fredde, formaggi e prodotti locali. 100% made in Là Haut!\r\nTerrazza panoramica con vista a 360° sul lago di Annecy e sul Monte Bianco, musica, atmosfera..."
    ],
    "fr": [
      "Au sommet de la station de la Sambuy : Hotdiot, boissons fraîches et chaudes, fromages et produits locaux. 100% made in Là Haut ! \r\nTerrasse panoramique avec vue à 360° sur le lac d'Annecy et le Mont-Blanc, musique, ambiance..."
    ],
    "nl": [
      "Op de top van het Sambuy resort: Hotdiot, warme en koude dranken, kaas en lokale producten. 100% gemaakt in Là Haut!\r\nPanoramisch terras met 360° uitzicht op het meer van Annecy en de Mont Blanc, muziek, sfeer..."
    ],
    "es": [
      "En la cima de la estación de Sambuy: Hotdiot, bebidas calientes y frías, queso y productos locales. ¡100% made in Là Haut!\r\nTerraza panorámica con una vista de 360° sobre el lago de Annecy y el Mont Blanc, música, ambiente..."
    ]
  },
  "rdfs:label": {
    "en": [
      "Le Comptoir Là Haut"
    ],
    "fr": [
      "Le Comptoir Là Haut"
    ]
  },
