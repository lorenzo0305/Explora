  "rdfs:comment": {
    "de": [
      "Fly Mont Blanc, ein auf Flugaktivitäten spezialisiertes Unternehmen, bietet Ihnen Erstflüge mit dem Gleitschirm an. Entdecken Sie das Tal von Chamonix und das Mont-Blanc-Massiv, wie Sie es noch nie zuvor gesehen haben!"
    ],
    "en": [
      "Fly Mont Blanc, a company specialized in aerial activities, offers you first flights in paragliding. Discover the Chamonix valley and the Mont-Blanc massif as you have never seen them before!"
    ],
    "it": [
      "Fly Mont Blanc, una società specializzata in attività aeree, vi offre i primi voli in parapendio. Scoprite la valle di Chamonix e il massiccio del Monte Bianco come non li avete mai visti prima!"
    ],
    "fr": [
      "Fly Mont Blanc, société spécialisée dans les activités aériennes vous propose des baptêmes de l'air en parapente. Découvrez la vallée de Chamonix et le massif du Mont-Blanc comme vous ne les avez jamais vus !"
    ],
    "es": [
      "Fly Mont Blanc, empresa especializada en actividades aéreas, le ofrece los primeros vuelos en parapente. Descubra el valle de Chamonix y el macizo del Mont Blanc como nunca antes los había visto."
    ],
    "nl": [
      "Fly Mont Blanc, een bedrijf gespecialiseerd in luchtactiviteiten, biedt je eerste vluchten in een paraglider. Ontdek de vallei van Chamonix en het Mont Blanc-massief zoals je ze nog nooit hebt gezien!"
    ]
  },
