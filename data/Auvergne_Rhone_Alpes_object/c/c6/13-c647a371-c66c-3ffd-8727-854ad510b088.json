  "rdfs:comment": {
    "de": [
      "Justine und Thomas empfangen Sie in einer warmen und freundlichen Atmosphäre. Die Speisekarte wird mit frischen und saisonalen Produkten zusammengestellt, ebenso wie die Tagesformel unter der Woche am Mittag."
    ],
    "en": [
      "Justine and Thomas welcome you in a warm and friendly atmosphere. The menu features fresh, seasonal produce, as well as a daily lunch menu."
    ],
    "it": [
      "Justine e Thomas vi accolgono in un'atmosfera calda e accogliente. Il menu si basa su prodotti freschi e di stagione, così come il menu del pranzo giornaliero durante la settimana."
    ],
    "fr": [
      "Justine et Thomas vous accueillent dans une ambiance chaleureuse et conviviale. La carte est élaborée avec des produits frais et de saison ainsi que la formule du jour en semaine le midi."
    ],
    "es": [
      "Justine y Thomas le dan la bienvenida en un ambiente cálido y acogedor. El menú se basa en productos frescos de temporada, al igual que el menú diario de mediodía entre semana."
    ],
    "nl": [
      "Justine en Thomas verwelkomen je in een warme en vriendelijke sfeer. Het menu is gebaseerd op verse, seizoensgebonden producten, net als het dagelijkse lunchmenu doordeweeks."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant \"La Croisée des gourmets\""
    ]
  },
