  "rdfs:comment": {
    "de": [
      "Auf dem Gipfel von Crève Tête finden Sie ein Kreuz und ein außergewöhnliches 360°-Panorama, das den Blick nach Les Aravis, Beaufortain, Mont Blanc, La Vanoise, Les Encombres, La Lauzière...und ganz hinten nach La Meije und Les Ecrins führt!"
    ],
    "en": [
      "At the top, a cross and an exceptional 360° panorama that leads the eye to Les Aravis, the Beaufortain, the Mont Blanc, La Vanoise, Les Encombres, La Lauzière...and in the background the Meije and the Ecrins!"
    ],
    "it": [
      "In cima alla Crève Tête si trova una croce e un panorama eccezionale a 360° che comprende Les Aravis, Beaufortain, il Monte Bianco, La Vanoise, Les Encombres, La Lauzière... e sullo sfondo La Meije e Les Ecrins!"
    ],
    "fr": [
      "Au sommet de Crève Tête, vous trouverez une croix et un panorama exceptionnel à 360° qui conduit le regard vers Les Aravis, le Beaufortain, le Mont Blanc, La Vanoise, Les Encombres, La Lauzière...et tout au fond la Meije et les Ecrins !"
    ],
    "nl": [
      "Op de top van Crève Tête vind je een kruis en een uitzonderlijk 360° panorama met Les Aravis, Beaufortain, Mont Blanc, La Vanoise, Les Encombres, La Lauzière... en op de achtergrond La Meije en Les Ecrins!"
    ],
    "es": [
      "En la cima de Crève Tête, encontrará una cruz y un panorama excepcional de 360° que abarca Les Aravis, Beaufortain, Mont Blanc, La Vanoise, Les Encombres, La Lauzière... ¡y al fondo, La Meije y Les Ecrins!"
    ]
  },
