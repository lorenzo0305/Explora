  "rdfs:comment": {
    "de": [
      "Seit über 28 Jahren bietet Sportkids Méribel sichere Sportaktivitäten im Freien für Kinder von 8-10 Jahren, Jugendliche von 11-13 Jahren und Teenager von 14-16 Jahren. In Form von 5-tägigen Kursen oder ganztägigen Kursen von Montag bis Freitag, von 9 bis 17 Uhr."
    ],
    "en": [
      "For more than 27 years Sportkids Méribel offers a range of outdoor activities in a safe and professionally supervised environment for your Kids aged 8-10, juniors agred 11-13, and Ados aged 14-16. Inscription for the whole week or on a daily basis."
    ],
    "it": [
      "Da oltre 28 anni, Sportkids Méribel offre attività sportive sicure e all'aria aperta per bambini di 8-10 anni, ragazzi di 11-13 anni e adolescenti di 14-16 anni. Sotto forma di corsi di 5 giorni o di un giorno intero, dal lunedì al venerdì, dalle 9.00 alle 17.00."
    ],
    "fr": [
      "Depuis plus de 28 ans, Sportkids Méribel vous propose, en toute sécurité, des activités sportives, en plein air, pour les Kids 8-10 ans, Juniors 11-13 ans, Ados 14-16 ans. Sous forme de stages 5 jours ou à la journée du lundi au vendredi, de 9h à 17h."
    ],
    "nl": [
      "For more than 27 years Sportkids Méribel offers a range of outdoor activities in a safe and professionally supervised environment for your Kids aged 8-10, juniors agred 11-13, and Ados aged 14-16. Inscription for the whole week or on a daily basis."
    ],
    "es": [
      "Desde hace más de 28 años, Sportkids Méribel ofrece actividades deportivas seguras al aire libre para niños de 8 a 10 años, juniors de 11 a 13 años y adolescentes de 14 a 16 años. En forma de cursos de 5 días o de jornada completa, de lunes a viernes, de 9.00 a 17.00 h."
    ]
  },
