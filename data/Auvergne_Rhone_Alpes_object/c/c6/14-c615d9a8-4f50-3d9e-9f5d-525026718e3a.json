  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/2008f53a-730f-3098-a1f7-6c14949e1289",
      "dc:description": {
        "de": [
          "Studenten des Institut de Genech organisieren am Sonntag, den 5. März 2023, eine Gourmetwanderung in Créquy. Auf dem Programm stehen Wanderung und Verkostung von lokalen Produkten. Abfahrten zwischen 8:30 und 10:30 Uhr."
        ],
        "en": [
          "Students from the Institut de Genech are organizing a gourmet walk in Créquy on Sunday, March 5, 2023. The program includes a hike and tasting of local products. Departures between 8:30 and 10:30 am."
        ],
        "it": [
          "Gli studenti dell'Institut de Genech organizzano una passeggiata gastronomica a Créquy domenica 5 marzo 2023. Il programma prevede un'escursione e una degustazione di prodotti locali. Partenza tra le 8.30 e le 10.30."
        ],
        "fr": [
          "Des étudiants de l'Institut de Genech organisent une marche gourmande à Créquy le dimanche 5 mars 2023. Au programme randonnée et dégustation de produits locaux. départs entre 8h30 et 10h30."
        ],
        "nl": [
          "Studenten van het Institut de Genech organiseren op zondag 5 maart 2023 een gastronomische wandeling in Créquy. Op het programma staan een wandeling en een proeverij van lokale producten. Vertrek tussen 8.30 en 10.30 uur."
        ],
        "es": [
          "Los estudiantes del Institut de Genech organizan un paseo gastronómico en Créquy el domingo 5 de marzo de 2023. El programa incluye un paseo y una degustación de productos locales. Salidas entre las 8h30 y las 10h30."
        ]
      },
