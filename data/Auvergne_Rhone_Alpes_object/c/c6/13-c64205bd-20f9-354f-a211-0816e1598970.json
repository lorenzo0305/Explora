  "rdfs:comment": {
    "de": [
      "Bei diesem unvergleichlichen Sportereignis, das seine 39. Ausgabe feiert, trifft sich die Weltelite der Quad- und Enduro-Cross-Country-Fahrer 72 Stunden lang hintereinander. Parade am Donnerstagabend in der Stadt Pont-de-Vaux!"
    ],
    "en": [
      "Celebrating its 39th edition, this unrivalled sporting event brings together the world's elite quad and enduro cross-country riders for 72 consecutive hours. Parade on Thursday evening in the town of Pont-de-Vaux!"
    ],
    "it": [
      "Festeggiando la sua 39a edizione, questo evento sportivo impareggiabile riunisce l'élite mondiale dei piloti di quad e di enduro cross-country per 72 ore consecutive. Sfilata giovedì sera nella città di Pont-de-Vaux!"
    ],
    "fr": [
      "Un rendez-vous sportif inégalé, célébrant sa 39e édition, rassemble pendant 72h consécutives les élites mondiales des pilotes de quad et d'enduro cross-country. Parade le jeudi soir dans la ville de Pont-de-Vaux !"
    ],
    "es": [
      "Este acontecimiento deportivo sin parangón, que celebra su 39ª edición, reúne a la élite mundial del quad y del enduro cross-country durante 72 horas consecutivas. ¡Desfile el jueves por la noche en la ciudad de Pont-de-Vaux!"
    ],
    "nl": [
      "Dit ongeëvenaarde sportevenement, dat zijn 39e editie viert, brengt 's werelds beste quad- en endurocrosscountryrijders 72 uur lang samen. Parade op donderdagavond in Pont-de-Vaux!"
    ]
  },
