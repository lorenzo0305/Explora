    "de": [
      "Diesen Sommer am Strand: Bewegen wir uns, während wir vor der Sonne geschützt sind!"
    ],
    "en": [
      "This summer, let's get moving on the beach while staying protected from the sun!"
    ],
    "it": [
      "Quest'estate, muoviamoci in spiaggia rimanendo protetti dal sole!"
    ],
    "fr": [
      "Cet été, à la plage, bougeons tout en étant protégés du soleil !"
    ],
    "nl": [
      "Laten we deze zomer in beweging komen op het strand terwijl we beschermd blijven tegen de zon!"
    ],
    "es": [
      "Este verano, ¡a moverse en la playa protegiéndose del sol!"
    ]
  },
