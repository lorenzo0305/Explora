  "rdfs:comment": {
    "de": [
      "Gemütliches Café, Brotlager, Lebensmittelgeschäft mit lokalen Produkten und handwerklichen Kreationen. Kaffee wie Teestube, wo man Gebäck mit einem heißen oder kalten Getränk genießen kann. Möglichkeit, einen Teller Aufschnitt zu essen. Spiele und Bücher zur Verfügung der Gäste."
    ],
    "en": [
      "Friendly coffee, bread, grocery store of local products and craft creations. Tea room type coffee shop where you can enjoy a pastry while drinking a hot or cold drink. Possibility to eat snack. Games and books available to guests."
    ],
    "it": [
      "Negozio di alimentari che vende prodotti locali e creazioni fatte in casa, deposito di pane, caffetteria dove si può gustare una pasticceria dolce o salata con una bevanda (caffè, cioccolata, tè... o birra o vino di produttori locali). Giochi e libri a disposizione dei clienti."
    ],
    "fr": [
      "Épicerie de produits locaux et créations artisanales, dépôt de pain, café où l'on peut déguster une pâtisserie salée ou sucrée avec une boisson (café, chocolat, thé... ou bière ou vin de producteurs locaux). Jeux et livres à disposition des clients."
    ],
    "es": [
      "Tienda de comestibles que vende productos locales y creaciones caseras, depósito de pan, cafetería donde se puede disfrutar de una pastelería dulce o salada con una bebida (café, chocolate, té... o cerveza o vino de productores locales). Juegos y libros a disposición de los clientes."
    ],
    "nl": [
      "Kruidenierswinkel met lokale producten en zelfgemaakte creaties, brooddepot, café waar je kunt genieten van een zoet of hartig gebakje met een drankje (koffie, chocolade, thee... of bier of wijn van lokale producenten). Spelletjes en boeken beschikbaar voor klanten."
    ]
  },
