  "rdfs:comment": {
    "de": [
      "Die Crêperie feiert in Bourgoin-Jallieu ihr Comeback und sorgt für süße und herzhafte Genüsse!\r\nL'Hydromel ist ein charmanter Ort, um köstliche Crêpes zu genießen. Diese Adresse sollten Sie sich nicht entgehen lassen, wenn Sie Liebhaber französischer Crêpes sind!"
    ],
    "en": [
      "The crêperie is back in Bourgoin-Jallieu for sweet and savoury delights!\r\nL'Hydromel is a charming place to enjoy delicious crêpes. It's an address not to be missed if you're a fan of French crêpes!"
    ],
    "it": [
      "La crêperie torna a Bourgoin-Jallieu per delizie dolci e salate!\r\nL'Hydromel è un luogo incantevole dove gustare deliziose crêpes. È un indirizzo da non perdere se siete amanti delle crêpes francesi!"
    ],
    "fr": [
      "La crêperie fait son grand retour à Bourgoin-Jallieu pour des plaisirs salés et sucrés !\r\nL'Hydromel est un endroit charmant pour déguster de délicieuses crêpes. C'est une adresse à ne pas manquer si vous êtes amateur de crêpes françaises !"
    ],
    "es": [
      "La crêperie vuelve a Bourgoin-Jallieu para ofrecer delicias dulces y saladas\r\nL'Hydromel es un lugar encantador donde degustar deliciosos crêpes. Si le gustan los crêpes franceses, ¡no se lo pierda!"
    ],
    "nl": [
      "De crêperie is terug in Bourgoin-Jallieu voor zoete en hartige lekkernijen!\r\nL'Hydromel is een charmante plek om te genieten van heerlijke crêpes. Het is een adres dat je niet mag missen als je fan bent van Franse crêpes!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'Hydromel Crêperie"
    ]
  },
