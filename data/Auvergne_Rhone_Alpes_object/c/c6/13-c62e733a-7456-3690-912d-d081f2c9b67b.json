  "rdfs:comment": {
    "de": [
      "Der aus Cérilly stammende Künstler José Dubois präsentiert seine neue Ausstellung mit abstrakten und farbenfrohen Werken.\r\nDiese Ausstellung setzt auf Bewegung und Leuchtkraft."
    ],
    "en": [
      "Cérilly artist José Dubois presents his new exhibition of abstract and colorful works.\r\nThe exhibition focuses on movement and luminosity."
    ],
    "it": [
      "L'artista José Dubois, nato a Cérilly, presenta la sua nuova mostra di opere astratte e colorate.\r\nQuesta mostra privilegia il movimento e la luminosità."
    ],
    "fr": [
      "L'artiste José Dubois, originaire de Cérilly, présente sa nouvelle exposition d'œuvres abstraites et colorées.\r\nCette exposition fait la part belle au mouvement et à la luminosité."
    ],
    "es": [
      "El artista nacido en Cérilly José Dubois presenta su nueva exposición de obras abstractas y coloristas.\r\nEsta exposición privilegia el movimiento y la luminosidad."
    ],
    "nl": [
      "De in Cérilly geboren kunstenaar José Dubois presenteert zijn nieuwe tentoonstelling met abstracte en kleurrijke werken.\r\nIn deze tentoonstelling staan beweging en helderheid centraal."
    ]
  },
