  "rdfs:comment": {
    "de": [
      "Charmantes kleines Restaurant im Herzen des alten Zentrums von Aubenas, sehr angenehme Terrasse abseits von Störungen. Küche mit überwiegend frischen und lokalen Produkten. Ein Genuss für den Gaumen !"
    ],
    "en": [
      "Charming little restaurant in the heart of the old centre of Aubenas, with a very pleasant terrace away from the hustle and bustle. Cuisine based on fresh, local produce. A treat for the taste buds !"
    ],
    "it": [
      "Piccolo ristorante di charme nel cuore del centro storico di Aubenas, con una terrazza molto piacevole al riparo dalla confusione. La cucina si basa su prodotti freschi e locali. Una delizia per il palato! Catering, piatti da asporto su ordinazione."
    ],
    "fr": [
      "Charmant petit  restaurant au cœur du centre ancien d'Aubenas, terrasse très agréable à l'écart des nuisances. Cuisine à base de produits essentiellement frais et locaux. Un régal pour les papilles ! Traiteur, plats à emporter sur commande."
    ],
    "es": [
      "Pequeño restaurante con encanto en el corazón del casco antiguo de Aubenas, con una terraza muy agradable alejada del bullicio. La cocina se basa en productos frescos y locales. Un placer para el paladar Catering, platos para llevar por encargo."
    ],
    "nl": [
      "Charmant klein restaurant in het hart van het oude centrum van Aubenas, met een zeer aangenaam terras weg van de drukte. Keuken gebaseerd op verse, lokale producten. Een traktatie voor de smaakpapillen !"
    ]
  },
