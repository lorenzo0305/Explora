  "rdfs:comment": {
    "de": [
      "Ich biete meine Dienste als Hausmeisterin an, verwalte Ihre Wohnung, empfange Sie, übergebe Ihnen die Schlüssel und putze Ihre Wohnung.\r\nIch bin auch für persönliche Dienstleistungen zugelassen."
    ],
    "en": [
      "I offer concierge services, home management, reception, key delivery and cleaning.\r\nI am also certified in personal services."
    ],
    "it": [
      "Offro servizi di portineria, gestione della casa, accoglienza, ritiro chiavi e pulizie.\r\nSono abilitata anche per i servizi alla persona."
    ],
    "fr": [
      "J’offre mes services en conciergerie,  gestion de votre logement, accueil, remise de clés et ménage.\r\nJe suis également agréée au service à la personne."
    ],
    "es": [
      "Ofrezco servicios de conserjería, gestión del hogar, recepción, recogida de llaves y limpieza.\r\nTambién estoy autorizada para servicios personales."
