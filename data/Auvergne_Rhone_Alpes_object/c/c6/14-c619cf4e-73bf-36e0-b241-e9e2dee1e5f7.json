        "de": [
          "Mietdauer: Wochenende mit Schlüsselübergabe am Freitag ab 19 Uhr und Rückgabe am Sonntag vor 19 Uhr.\nKaution von 150?"
        ],
        "en": [
          "Length of rental: weekend with keys handed over on Friday from 7pm and returned on Sunday before 7pm.\nDeposit of 150?"
        ],
        "it": [
          "Affitto per il fine settimana, con consegna delle chiavi il venerdì dalle 19:00 e restituzione la domenica entro le 19:00.\nDeposito cauzionale di 150?"
        ],
        "fr": [
          "Durée de la location : le week-end avec remise des clés le vendredi à partir de 19h et restitution le dimanche avant 19h.\nCaution de 150€"
        ],
        "nl": [
          "Weekendverhuur, sleuteloverdracht op vrijdag vanaf 19.00 uur en terugbrengen op zondag voor 19.00 uur.\nBorg van 150?"
        ],
        "es": [
          "Alquiler fin de semana, con entrega de llaves el viernes a partir de las 19h y devolución el domingo antes de las 19h.\nFianza de 150?"
        ]
