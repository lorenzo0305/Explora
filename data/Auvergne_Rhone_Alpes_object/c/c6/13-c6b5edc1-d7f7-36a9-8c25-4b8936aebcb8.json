  "rdfs:comment": {
    "de": [
      "Das Spa des Fouquet's Courchevel ist ein Refugium der Gelassenheit, in dem Fachwissen und Forschung zusammenkommen, um eine tiefe Regeneration zu bieten, die sowohl körperlich als auch emotional ist."
    ],
    "en": [
      "The Spa du Fouquet's Courchevel is a haven of serenity, where expertise and research combine to offer deep physical and emotional regeneration."
    ],
    "it": [
      "La Spa del Fouquet's Courchevel è un'oasi di serenità, dove competenza e ricerca si uniscono per offrire una profonda rigenerazione fisica ed emotiva."
    ],
    "fr": [
      "Le Spa du Fouquet's Courchevel est un refuge de sérénité, où l’expertise et la recherche s’unissent pour offrir une régénération profonde, à la fois physique et émotionnelle."
    ],
    "es": [
      "El Spa del Fouquet's Courchevel es un remanso de serenidad, donde la experiencia y la investigación se combinan para ofrecer una profunda regeneración física y emocional."
    ],
    "nl": [
      "De Spa van Fouquet's Courchevel is een oase van rust, waar expertise en onderzoek worden gecombineerd om een diepgaand fysiek en emotioneel herstel te bieden."
    ]
  },
