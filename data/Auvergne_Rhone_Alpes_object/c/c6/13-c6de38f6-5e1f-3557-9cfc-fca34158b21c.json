  "rdfs:comment": {
    "de": [
      "Das Atelier des Gourmets empfängt Sie montags bis samstags von 6:00 bis 19:00 Uhr und sonntags von 6:00 bis 13:00 Uhr.\r\nWöchentliche Schließung am Mittwoch."
    ],
    "en": [
      "L'Atelier des Gourmets welcomes you Monday to Saturday from 6:00 to 19:00 and Sunday from 6:00 to 13:00.\r\nWeekly closing on Wednesday."
    ],
    "it": [
      "L'Atelier des Gourmets è aperto dal lunedì al sabato dalle 6.00 alle 19.00 e la domenica dalle 6.00 alle 13.00.\r\nChiuso il mercoledì."
    ],
    "fr": [
      "L'Atelier des Gourmets vous accueille du lundi au samedi de 6h00 à 19h00 et le dimanche de 6h00 à 13h00. \r\nFermeture hebdomadaire le mercredi."
    ],
    "nl": [
      "L'Atelier des Gourmets is geopend van maandag tot en met zaterdag van 6.00 tot 19.00 uur en op zondag van 6.00 tot 13.00 uur.\r\nGesloten op woensdag."
    ],
    "es": [
      "L'Atelier des Gourmets abre de lunes a sábado de 6.00 a 19.00 h. y los domingos de 6.00 a 13.00 h.\r\nCerrado los miércoles."
    ]
  },
