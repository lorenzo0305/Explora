  "rdfs:comment": {
    "de": [
      "Mama Alpina, die neue italienische Trattoria in Avoriaz, lädt Sie ein, den Winter mit einer neu interpretierten italienischen Küche mit alpinen Aromen zu genießen. Gemütlicher Rahmen, Spritz zum Aperitif, Raclette in neuem Gewand und musikalische Untermalung."
    ],
    "en": [
      "Mama Alpina, a new Italian trattoria in Avoriaz, invites you to savor winter with Italian cuisine reimagined with alpine flavors. A warm setting, Spritz for aperitif, reinvented raclettes, and a vibrant musical atmosphere."
    ],
    "it": [
      "Mama Alpina, la nuova trattoria italiana di Avoriaz, vi invita a gustare l'inverno con una cucina italiana rivisitata con sapori alpini. Ambiente caldo, Spritz come aperitivo, raclette rivisitata e atmosfera musicale."
    ],
    "fr": [
      "Mama Alpina, nouvelle trattoria italienne à Avoriaz, vous invite à savourer l’hiver avec une cuisine italienne revisitée aux saveurs alpines. Cadre chaleureux, Spritz à l'apéritif, raclettes revisitées et ambiance musicale."
    ],
    "es": [
      "Mama Alpina, la nueva trattoria italiana de Avoriaz, le invita a saborear el invierno con una cocina italiana revisitada con sabores alpinos. Ambiente cálido, Spritz como aperitivo, raclette revisitada y ambiente musical."
    ],
    "nl": [
      "Mama Alpina, de nieuwe Italiaanse trattoria in Avoriaz, nodigt je uit om de winter te proeven met Italiaanse gerechten, heruitgevonden met alpine smaken. Een warme sfeer, Spritz als aperitief, vernieuwde raclettes en een levendige muzikale ambiance."
    ]
  },
  "rdfs:label": {
