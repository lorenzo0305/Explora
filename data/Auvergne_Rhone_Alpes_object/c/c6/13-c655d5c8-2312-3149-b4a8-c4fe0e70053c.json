  "rdfs:comment": {
    "de": [
      "Mirabel ist ein befestigtes, hoch gelegenes Dorf aus dem Mittelalter, das früher im Besitz des Bischofs von Die war und über dem Fluss Drôme thront, gegenüber den 3 Becs, den emblematischen Gipfeln der Drôme."
    ],
    "en": [
      "Mirabel is a  fortified hilltop village, dating from the Middle Age, owned by  the bishop of Die and dominant of the river Drôme, facing the \"3 Becs\", iconic Drôme summits."
    ],
    "it": [
      "Mirabel è un villaggio fortificato e arroccato risalente al Medioevo, ex possedimento del vescovo di Die e affacciato sul fiume Drôme, di fronte ai 3 Becs, le cime emblematiche della Drôme."
    ],
    "fr": [
      "Mirabel est un village fortifié et perché, datant du Moyen Âge, ancienne possession de l’évêque de Die et dominant la rivière Drôme, face aux 3 Becs, emblématiques sommets drômois."
    ],
    "nl": [
      "Mirabel is een versterkt dorp op een heuvel uit de Middeleeuwen, vroeger eigendom van de bisschop van Die, met uitzicht op de rivier de Drôme en op de 3 Becs, de emblematische bergtoppen van de Drôme."
    ],
    "es": [
      "Mirabel es un pueblo fortificado y encaramado que data de la Edad Media, antigua posesión del obispo de Die y que domina el río Drôme, frente a los 3 Becs, los picos emblemáticos de la Drôme."
    ]
  },
