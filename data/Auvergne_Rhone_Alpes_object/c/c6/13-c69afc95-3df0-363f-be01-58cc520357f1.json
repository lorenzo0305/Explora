  "rdfs:comment": {
    "de": [
      "Entdecken Sie die gepflegte Küche des Küchenchefs! Froschmenü am Sonntagmittag. Bitte reservieren Sie spätestens am Freitagmorgen."
    ],
    "en": [
      "Come and discover the chef's fine cuisine! Frog menu on Sunday lunchtime, to be reserved by Friday morning at the latest."
    ],
    "it": [
      "Venite a scoprire la raffinata cucina dello chef! Menù a base di rane la domenica a pranzo, prenotare entro e non oltre il venerdì mattina."
    ],
    "fr": [
      "Venez découvrir la cuisine soignée du chef ! Menu grenouilles le Dimanche midi à réserver au plus tard le vendredi matin."
    ],
    "es": [
      "Venga a descubrir la buena cocina del chef Menú de rana los domingos al mediodía, reserva como muy tarde el viernes por la mañana."
    ],
    "nl": [
      "Kom en ontdek de fijne keuken van de chef! Kikkermenu op zondagmiddag, reserveer uiterlijk vrijdagochtend."
    ]
  },
