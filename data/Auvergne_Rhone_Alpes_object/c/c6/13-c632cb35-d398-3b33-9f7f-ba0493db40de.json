  "rdfs:comment": {
    "de": [
      "Seit 2013 gehen Sie auf Entdeckungsreise zu den Santons\r\nTeilen Sie mit Frédéric seine Leidenschaft.\r\nBesuchen Sie sein Atelier: Er erzählt Ihnen von der Herkunft und der Herstellung dieser kleinen Tonfiguren."
    ],
    "en": [
      "Since 2013, discover santons\r\nShare his passion with Frédéric.\r\nCome and visit his workshop: he will tell you about the origin and the making of these small clay objects."
    ],
    "it": [
      "Dal 2013, scoprite i santoni\r\nCondividete la sua passione con Frédéric.\r\nVenite a visitare il suo laboratorio: vi racconterà l'origine e la realizzazione di questi piccoli oggetti in argilla."
    ],
    "fr": [
      "Depuis 2013, partez à la découverte des santons. \r\nPartagez avec Frédéric sa passion.\r\nVenez visiter son atelier : il vous racontera l'origine, la fabrication de ces petits sujets en argile."
    ],
    "nl": [
      "Sinds 2013, ontdek santons\r\nDeel zijn passie met Frédéric.\r\nKom langs in zijn atelier: hij zal u vertellen over het ontstaan en het maken van deze kleine kleiobjecten."
    ],
    "es": [
      "Desde 2013, descubre los santones\r\nComparte su pasión con Frédéric.\r\nVenga a visitar su taller: le contará el origen y la fabricación de estos pequeños objetos de arcilla."
    ]
  },
