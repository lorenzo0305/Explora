  "rdfs:comment": {
    "de": [
      "Montagne Expériences Tignes Val Claret: Erleben Sie das Abenteuer im Herzen der Alpen! Einzigartige Aktivitäten, grandiose Landschaften und Nervenkitzel, Sommer wie Winter, für unvergessliche Momente auf dem Gipfel."
    ],
    "en": [
      "Montagne Expériences Tignes Val Claret: experience adventure in the heart of the Alps! Unique activities, breathtaking scenery and thrills, summer and winter alike, for unforgettable moments at the summit."
    ],
    "it": [
      "Montagne Expériences Tignes Val Claret: vivete l'avventura nel cuore delle Alpi! Attività uniche, paesaggi mozzafiato ed emozioni forti, sia in estate che in inverno, per momenti indimenticabili in vetta."
    ],
    "fr": [
      "Montagne Expériences Tignes Val Claret : vivez l’aventure au cœur des Alpes ! Activités uniques, paysages grandioses et sensations fortes, été comme hiver, pour des moments inoubliables au sommet."
    ],
    "nl": [
      "Montagne Expériences Tignes Val Claret: beleef avontuur in het hart van de Alpen! Unieke activiteiten, adembenemende landschappen en sensaties, zomer en winter, voor onvergetelijke momenten op de top."
    ],
    "es": [
      "Montagne Expériences Tignes Val Claret: ¡vive la aventura en el corazón de los Alpes! Actividades únicas, paisajes impresionantes y emociones fuertes, tanto en verano como en invierno, para vivir momentos inolvidables en la cumbre."
    ]
  },
