  "rdfs:comment": {
    "de": [
      "Die Stadtbibliothek verfügt über eine umfangreiche Sammlung von Zeitungen und Zeitschriften, englischsprachigen Büchern, Comics für Erwachsene und Kinder, Büchern über Lyon und die Region sowie Büchern in Großdruck."
    ],
    "en": [
      "The municipal library has an important collection of newspapers and magazines, English books, comic books for adults and children, books on Lyon and the region, books in large print."
    ],
    "it": [
      "La biblioteca comunale dispone di un'ampia collezione di giornali e riviste, libri in inglese, fumetti per adulti e bambini, libri su Lione e la regione, libri a caratteri grandi."
    ],
    "fr": [
      "La bibliothèque municipale possède une collection importante de journaux et revues, d’ouvrages en anglais, de bandes dessinées pour adultes et enfants, ouvrages sur Lyon et région, livres en gros caractères."
    ],
    "es": [
      "La biblioteca municipal dispone de una amplia colección de periódicos y revistas, libros en inglés, cómics para adultos y niños, libros sobre Lyon y la región, libros de gran formato."
    ],
    "nl": [
      "De gemeentelijke bibliotheek heeft een grote collectie kranten en tijdschriften, boeken in het Engels, strips voor volwassenen en kinderen, boeken over Lyon en de regio, grootletterboeken."
    ]
  },
