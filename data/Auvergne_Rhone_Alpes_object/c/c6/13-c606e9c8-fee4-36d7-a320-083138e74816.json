  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Biscuiterie de Provence, eine Familiengeschichte seit 1833, indem Sie in eine freie und kostenlose Besichtigung eintauchen, ein Feinschmeckererlebnis, das Groß und Klein begeistern wird."
    ],
    "en": [
      "Discover Biscuiterie de Provence, a family affair since 1833, on a free, self-guided tour, a gourmet experience that will delight young and old alike."
    ],
    "it": [
      "Scoprite la Biscuiterie de Provence, una storia di famiglia dal 1833, con una visita gratuita, un'esperienza gastronomica che delizierà grandi e piccini."
    ],
    "fr": [
      "Découvrez la Biscuiterie de Provence, un histoire de famille depuis 1833 en vous plongeant dans une visite libre et gratuite, une expérience gourmande qui enchantera petits et grands."
    ],
    "nl": [
      "Ontdek de Biscuiterie de Provence, een familiegeschiedenis sinds 1833, tijdens een gratis rondleiding, een gastronomische ervaring die jong en oud in verrukking zal brengen."
    ],
    "es": [
      "Descubra la Biscuiterie de Provence, una historia familiar desde 1833, en una visita gratuita, una experiencia gastronómica que hará las delicias de grandes y pequeños."
    ]
  },
