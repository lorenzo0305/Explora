  "rdfs:comment": {
    "de": [
      "Chez Rita lädt Sie ein, seine bunte und gemischte Küche im Herzen des Dorfes Hautecourt-Romanèche, nur wenige Schritte von der Ain-Schlucht entfernt, zu entdecken.\r\nGenießen Sie hausgemachte Spezialitäten aus Réunion, zum Mitnehmen, vor Ort, Catering, Lieferung möglich."
    ],
    "en": [
      "Chez Rita is located in the heart of the village of Hautecourt-Romanèche, a stone's throw from the Gorges de l'Ain.\r\nEnjoy home-made Reunion specialties, takeaway, on-site, catering, delivery possible."
    ],
    "it": [
      "Chez Rita vi invita a scoprire la sua cucina colorata e mista nel cuore del villaggio di Hautecourt-Romanèche, a due passi dalle Gole dell'Ain.\r\nGustate le specialità della Riunione fatte in casa, da portare via, in loco, con catering o a domicilio."
    ],
    "fr": [
      "Chez Rita vous propose de découvrir sa cuisine métissée et colorée au cœur du village d'Hautecourt-Romanèche, à deux pas des Gorges de l'Ain.\r\nSavourez des spécialités réunionnaises faites maison, à emporter, sur place, traiteur, livraison possible."
    ],
    "nl": [
      "Chez Rita nodigt je uit om haar kleurrijke, gemengde keuken te ontdekken in het hart van het dorp Hautecourt-Romanèche, op een steenworp afstand van de Gorges de l'Ain.\r\nGeniet van huisgemaakte specialiteiten uit Réunion, om mee te nemen, ter plaatse te serveren of te laten bezorgen."
    ],
    "es": [
      "Chez Rita le invita a descubrir su colorida cocina mixta en el corazón del pueblo de Hautecourt-Romanèche, a dos pasos de las Gargantas del Ain.\r\nDisfrute de las especialidades caseras de la Reunión, para llevar, in situ, por encargo o a domicilio."
    ]
  },
