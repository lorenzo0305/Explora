  "rdfs:comment": {
    "de": [
      "L?Hostellerie du Centrotel et Spa (3 Sterne) liegt ideal an der Ausfahrt 11 der A71 und an der Route Centre Europe Atlantique und kann Sie im Restaurant oder auf der Terrasse begrüßen."
    ],
    "en": [
      "Ideally located at exit 11 of the A71 and on the Route Center Europe Atlantique, L'Hostellerie du Centrotel et Spa (3 stars) can welcome you in the restaurant or on the terrace and has 21 rooms, Wellness and massage area."
    ],
    "it": [
      "Situato in posizione ideale allo svincolo 11 dell'autostrada A71 e sulla Route Centre Europe Atlantique, l'Hostellerie du Centrotel and Spa, a 3 stelle, dispone di un ristorante e una terrazza, 21 camere e un'area benessere e massaggi."
    ],
    "fr": [
      "Idéalement situé à la sortie 11 de l'A71 et sur la Route Centre Europe Atlantique, L’Hostellerie du Centrotel et Spa (3 étoiles) peut vous accueillir au restaurant ou en terrasse et dispose de 21 chambres, Espace Bien- être et modelage."
    ],
    "es": [
      "Idealmente situado en la salida 11 de la autopista A71 y en la Route Centre Europe Atlantique, el Hostellerie du Centrotel and Spa de 3 estrellas dispone de restaurante y terraza, 21 habitaciones y una zona de bienestar y masajes."
    ],
    "nl": [
      "Het 3-sterren Hostellerie du Centrotel and Spa is ideaal gelegen bij knooppunt 11 van de snelweg A71 en aan de Route Centre Europe Atlantique, en heeft een restaurant en terras, 21 slaapkamers en een wellness- en massageruimte."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Hostellerie du Centrotel et Spa"
