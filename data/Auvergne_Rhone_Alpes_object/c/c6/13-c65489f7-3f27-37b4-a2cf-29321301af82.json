  "rdfs:comment": {
    "de": [
      "Saubere Luft, atemberaubende Gletscher und Panorama-Whirlpools: Die Sinnesreise von QC Terme Chamonix ist eingebettet in eine Landschaft von unvergleichlicher Schönheit, die die Verbindung zwischen Wellness und Bergen stärkt."
    ],
    "en": [
      "Fresh air, breathtaking glaciers and panoramic whirlpools: the sensory journey of QC Terme Chamonix is set in a landscape of incomparable beauty, which reinforces the link between well-being and the mountains."
    ],
    "it": [
      "Aria fresca, ghiacciai mozzafiato e vasche idromassaggio panoramiche: il percorso sensoriale di QC Terme Chamonix è immerso in un paesaggio di incomparabile bellezza, che rafforza il legame tra benessere e montagna."
    ],
    "fr": [
      "Air pur, glaciers à couper le souffle et bains à remous panoramiques : le voyage sensoriel de QC Terme Chamonix s'inscrit dans un paysage d'une beauté incomparable, qui renforce le lien entre bien-être et montagne."
    ],
    "nl": [
      "Frisse lucht, adembenemende gletsjers en panoramische whirlpools: de zintuiglijke reis van QC Terme Chamonix speelt zich af in een landschap van onvergelijkbare schoonheid, dat de band tussen welzijn en de bergen versterkt."
    ],
    "es": [
      "Aire puro, glaciares impresionantes y bañeras de hidromasaje panorámicas: el viaje sensorial de QC Terme Chamonix se enmarca en un paisaje de incomparable belleza, que refuerza el vínculo entre el bienestar y la montaña."
    ]
  },
