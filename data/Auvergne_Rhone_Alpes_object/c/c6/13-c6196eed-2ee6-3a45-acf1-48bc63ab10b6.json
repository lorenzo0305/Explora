  "rdfs:comment": {
    "de": [
      "Das Bistrot Auvergnat wurde im November 2024 eröffnet. Hier können Sie regionale Spezialitäten genießen, die mit lokalen Produkten zubereitet werden."
    ],
    "en": [
      "Le Bistrot Auvergnat opened its doors in November 2024. Enjoy regional specialities, prepared with local produce."
    ],
    "it": [
      "Le Bistrot Auvergnat ha aperto le sue porte nel novembre 2024. Si possono gustare specialità regionali preparate con prodotti locali."
    ],
    "fr": [
      "Le Bistrot Auvergnat a ouvert ses portes en novembre 2024. Vous pourrez apprécier des spécialités régionales, préparées avec des produits locaux."
    ],
    "nl": [
      "Le Bistrot Auvergnat opende zijn deuren in november 2024. Je kunt er genieten van regionale specialiteiten bereid met lokale producten."
    ],
