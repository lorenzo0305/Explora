  "rdfs:comment": {
    "de": [
      "Die Domaine Blard & Fils ist ein familiengeführter Weinproduzent in Porte-de-Savoie. Er stellt Savoyer AOP-Weine aus lokalen Rebsorten her, indem er das savoyische Terroir und ihr Weinbau-Know-how aufwertet."
    ],
    "en": [
      "Domaine Blard & Fils is a family-run winegrower based in Porte-de-Savoie. They make AOP Savoie wines from local grape varieties, promoting the Savoyard terroir and their winemaking expertise."
    ],
    "it": [
      "Il Domaine Blard & Fils è un'azienda vinicola familiare con sede a Porte-de-Savoie. Produce vini AOP della Savoia da vitigni locali, promuovendo il terroir savoiardo e la propria esperienza enologica."
    ],
    "fr": [
      "Le Domaine Blard & Fils est un producteur viticole familial situé à Porte-de-Savoie. Il élabore des vins de Savoie AOP à partir de cépages locaux, en valorisant le terroir savoyard et leur savoir-faire viticole."
    ],
    "es": [
      "El Domaine Blard & Fils es un viñedo familiar de Porte-de-Savoie. Elaboran vinos AOP Savoie a partir de variedades de uva locales, promocionando el terruño saboyano y su saber hacer vitivinícola."
    ],
    "nl": [
      "Domaine Blard & Fils is een familiewijnproducent gevestigd in Porte-de-Savoie. Ze maken AOP Savoie-wijnen van lokale druivensoorten en promoten het Savoyaardse terroir en hun expertise in wijnmaken."
    ]
  },
