  "rdfs:comment": {
    "de": [
      "Öko-Site, die versucht, die Möglichkeit zu demonstrieren, autonom und in Harmonie mit der Natur zu leben: ungewöhnliche Unterkünfte, Trockentoiletten, Kompostierung, Solarofen, Pflanzenkläranlage, pädagogischer Teich, Lebenszeugnis... Dauer des Besuchs: 2 Stunden."
    ],
    "en": [
      "The ecosite attempts to show options to live self-sufficiently and in harmony with nature: unusual accommodations, dry toilets, compost, solar panels, phyto-purification, observation and educational pond... Duration of the visit: 2 hours."
    ],
    "it": [
      "Eco-sito che cerca di dimostrare la possibilità di vivere in autonomia e in armonia con la natura: habitat insoliti, bagni a secco, compostaggio, forno solare, fitodepurazione, laghetto didattico, testimonianza di vita? Durata della visita: 2 ore."
    ],
    "fr": [
      "Eco-site tentant de démontrer la possibilité de vivre en autonomie et en harmonie avec la nature : habitats insolites, toilettes sèches, compostage, four solaire, phytoépuration, mare pédagogique, témoignage de vie… Durée de la visite : 2h."
    ],
    "nl": [
      "Een eco-locatie waar we proberen aan te tonen dat de mens de mogelijkheid heeft om onafhankelijk en in harmonie met de natuur te leven. We bieden: bijzondere accommodatie, tuinen, droge toiletten, oven op zonne-energie, phytoépuration (waterzuivering), educatieve vijver, etc. Duur van het bezoek: 2 u."
    ],
    "es": [
      "Ecositio que intenta demostrar la posibilidad de vivir en autonomía y en armonía con la naturaleza: hábitats insólitos, baños secos, compostaje, horno solar, fitodepuración, estanque educativo, testimonio de vida.. Duración de la visita: 2 horas."
    ]
  },
  "rdfs:label": {
    "de": [
      "Ökoanwesen Oasis Bellecombe"
    ],
    "en": [
      "Oasis Bellecombe Eco-site"
    ],
    "fr": [
      "Eco-site Oasis Bellecombe"
    ]
  },
