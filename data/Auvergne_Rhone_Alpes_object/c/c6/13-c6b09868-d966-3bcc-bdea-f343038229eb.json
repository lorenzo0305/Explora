  "rdfs:comment": {
    "de": [
      "Gilles führt Sie bei einer aufregenden Flusswanderung durch die Schluchten der Sumène. Ein Ausflug mit der Familie oder mit Freunden, ideal, um neue Energie zu tanken und die Natur zu genießen. Offen für alle, Kombination kostenlos zur Verfügung."
    ],
    "en": [
      "Gilles will guide you through the Sumène gorges on an exhilarating river walk. An ideal outing with family or friends to recharge your batteries and enjoy nature. Open to all, free wetsuit available."
    ],
    "it": [
      "Gilles vi guiderà attraverso le gole del Sumène in un'emozionante passeggiata sul fiume. Un modo ideale per ricaricare le batterie e godersi la natura con la famiglia e gli amici. Aperto a tutti, muta gratuita a disposizione."
    ],
    "fr": [
      "Gilles vous guidera dans les gorges de la Sumène lors d'une marche en rivière exaltante. Une sortie en famille ou entre amis, idéale pour se ressourcer et apprécier la nature. Ouvert à tous, combinaison à disposition gratuitement."
    ],
    "nl": [
      "Gilles leidt je door de kloven van de Sumène tijdens een opwindende rivierwandeling. Een ideale manier om nieuwe energie op te doen en samen met familie en vrienden van de natuur te genieten. Open voor iedereen, gratis wetsuit beschikbaar."
    ],
    "es": [
      "Gilles le guiará por las gargantas del Sumène en un estimulante paseo fluvial. Una forma ideal de recargar las pilas y disfrutar de la naturaleza con la familia y los amigos. Abierto a todos, traje de neopreno gratuito."
    ]
  },
  "rdfs:label": {
    "en": [
      "Randorespi - River walking"
    ],
    "fr": [
      "Randorespi - Marche en rivière"
    ]
  },
