  "rdfs:comment": {
    "de": [
      "Große, sonnige Terrasse und schöner Saal. Pizzas, Salate, Fleisch, Fisch...hauptsächlich aus frischen und lokalen Produkten zubereitet. Muscheln und Pommes frites am Freitagabend. An der Bar: große Auswahl an belgischen Bieren. In der Saison 7 Tage die Woche geöffnet."
    ],
    "en": [
      "Large sunny terrace and nice room. Pizzas, salads, meats, fish...made with fresh and local products. Mussels & French fries every Friday evening. Wide selection of Belgian beers at the bar. Open everyday in summer."
    ],
    "it": [
      "Ampia terrazza soleggiata e bella camera. Pizze, insalate, carne, pesce... preparati principalmente con prodotti freschi e locali. Cozze e patatine il venerdì sera. Al bar: ampia scelta di birre belghe. Aperto 7 giorni su 7 in stagione."
    ],
    "fr": [
      "Grande terrasse bien exposée et jolie salle. Pizzas, salades repas, viandes, poissons...préparés principalement à base de produits frais et locaux. Moules-Frites le vendredi soir. Au bar : grand choix de bières belges. Ouvert 7j/7 en saison."
    ],
    "nl": [
      "Groot mooigelegen terrras et prachtige zaal. Pizzas, grote salades, vlees, vis... bijna uitsluitend bereid met verse en lokale produkten. Vrijdagavond mosselen-friet. Aan de bar : grote keus aan belgische bieren. In het hoogseizoen open 7/7"
    ],
    "es": [
      "Amplia y soleada terraza y bonita habitación. Pizzas, ensaladas, carnes, pescados... preparados principalmente con productos frescos y locales. Mejillones y patatas fritas el viernes por la noche. En el bar: gran variedad de cervezas belgas. Abierto 7 días a la semana en temporada."
    ]
  },
