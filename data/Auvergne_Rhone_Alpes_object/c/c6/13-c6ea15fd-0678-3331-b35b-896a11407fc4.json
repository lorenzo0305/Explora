  "rdfs:comment": {
    "de": [
      "Der Jardin des Sables ist ein landschaftliches Wunder. Die Komposition des Gartens, die einige der Codes der englischen Gärten aufgreift, besticht durch ihren Wechsel zwischen bukolischem Treiben und friedlichen Wiesen."
    ],
    "en": [
      "Le jardin des sables is a landscape marvel. Taking its cue from English gardens, its composition marvels at the alternation between bucolic effervescence and peaceful meadows."
    ],
    "it": [
      "Il Jardin des Sables è un paese delle meraviglie paesaggistiche. Prendendo spunto dai giardini all'inglese, la sua composizione stupisce per l'alternanza tra effervescenza bucolica e prati tranquilli."
    ],
    "fr": [
      "Le jardin des sables est une merveille paysagère. Reprenant certains codes des jardins à l’anglaise, sa composition émerveille par son alternance entre effervescence bucolique et paisibles prairies."
    ],
    "es": [
      "El Jardin des Sables es un paraíso paisajístico. Inspirado en los jardines de estilo inglés, su composición sorprende por la alternancia entre la efervescencia bucólica y la tranquilidad de las praderas."
    ],
    "nl": [
      "De Jardin des Sables is een landschappelijk wonderland. De compositie is geïnspireerd op tuinen in Engelse stijl en bewondert de afwisseling tussen bucolische levendigheid en vredige weiden."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite guidée : Analyse et composition du jardin des Sables - Rendez-vous aux jardins"
    ]
  },
