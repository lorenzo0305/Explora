  "rdfs:comment": {
    "de": [
      "die \"Magischen Tiere\" bieten einen wohlwollenden und sicheren Raum, um pflegende Angehörige und Eltern einen Tag oder einen halben Tag lang zu unterstützen, indem sie Kindern, Erwachsenen und Senioren einen besonderen Moment mit den Tieren bieten."
    ],
    "en": [
      "\"Les Zanimaux Magiques\" offers a safe, caring place to support caregivers and parents for a day or half-day, giving children, adults and senior citizens a special time with animals."
    ],
    "it": [
      "\"Les Zanimaux Magiques\" offre un luogo sicuro e attento per supportare badanti e genitori per una giornata o mezza giornata, regalando a bambini, adulti e anziani un momento speciale con gli animali."
    ],
    "fr": [
      "\" Les Zanimaux Magiques\" proposent un espace bienveillant et sécurisé pour soutenir les aidants et épauler les parents sur une journée ou une demie journée en offrant aux enfants, adultes, seniors un moment privilégiée avec les animaux."
    ],
    "es": [
      "\"Les Zanimaux Magiques\" ofrece un lugar seguro y afectuoso para apoyar a cuidadores y padres durante un día o medio día, proporcionando a niños, adultos y ancianos un tiempo especial con animales."
    ],
    "nl": [
      "\"Les Zanimaux Magiques\" biedt een veilige, zorgzame plek om verzorgers en ouders een dag of een halve dag te ondersteunen, zodat kinderen, volwassenen en senioren een bijzondere tijd met dieren kunnen doorbrengen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Relais Multi Accueil Nord Isère 38 : les Zanimaux Magiques"
    ]
  },
