  "rdfs:comment": {
    "de": [
      "Auf dem Hauptplatz von Salers können Sie einen Moment der Entspannung auf unserer Terrasse verbringen, unsere regionalen Produkte probieren und die unter Denkmalschutz stehenden Häuser mit Türmchen betrachten."
    ],
    "en": [
      "On the main square in Salers, come and relax on the terrace, savour one of our famous “tartines” (toasts) and contemplate the famous turreted houses."
    ],
    "it": [
      "Sulla piazza principale di Salers, venite a trascorrere un momento di relax sulla nostra terrazza, a degustare i nostri prodotti regionali e a contemplare le case con torrette classificate come Monumenti storici."
    ],
    "fr": [
      "Sur la place principale de Salers, venez passer un moment de détente sur notre terrasse, déguster nos produits régionaux et contempler les maisons à tourelles classées Monuments Historiques."
    ],
    "nl": [
      "Op het hoofdplein van Salers kunt u een ontspannen moment doorbrengen op ons terras, onze streekproducten proeven en de huizen met torentjes, die als Historisch Monument zijn geclassificeerd, bekijken."
    ],
    "es": [
      "En la plaza principal de Salers, venga a pasar un momento de relax en nuestra terraza, deguste nuestros productos regionales y contemple las casas con torretas clasificadas como Monumentos Históricos."
    ]
  },
  "rdfs:label": {
    "en": [
      "Chez la Préfète"
    ],
    "fr": [
      "Chez la Préfète"
    ]
  },
