  "rdfs:comment": {
    "de": [
      "Dank des Telemixte des Sûres können Sie als Fußgänger oder Mountainbiker Spaziergänge in luftiger Höhe genießen und dabei auch noch eine atemberaubende Aussicht genießen!"
    ],
    "en": [
      "Thanks to the Les Sûres cable car, you can enjoy high altitude rides for both pedestrians and mountain bikers, with breathtaking views to boot!"
    ],
    "it": [
      "Grazie alla funivia di Sûres, potrete fare passeggiate a piedi o in mountain bike in alta quota, con panorami mozzafiato!"
    ],
    "fr": [
      "Grâce au télémixte des Sûres, venez profiter de balades en hauteur que vous soyez piétons ou vététistes avec en prime, une vue à couper le souffle !"
    ],
    "es": [
      "Gracias al teleférico de Sûres, podrá disfrutar de paseos a pie o en bicicleta de montaña por las alturas, ¡con unas vistas impresionantes!"
    ],
    "nl": [
      "Dankzij de kabelbaan van Sûres kun je genieten van wandelingen of mountainbiketochten in de hoogte, met een adembenemend uitzicht!"
    ]
  },
