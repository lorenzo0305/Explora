  "rdfs:comment": {
    "de": [
      "Ledergürtel und Zubehöre werden hier vor Ihren Augen hergestellt. \r\nDie Kollektion wird in unserem Laden-Atelier im Geschäft hergestellt. Alles ist 100% Leder und 100% Made in France !!!"
    ],
    "en": [
      "Leather belts and accessories made before your eyes.\r\nCollection entirely designed and made in our workshop next to the shop. Everything is 10% leather and 100% made in France !!!"
    ],
    "it": [
      "Cinture, pelletteria, gioielli e accessori in pelle realizzati sotto i vostri occhi\r\nTutti gli articoli sono realizzati nel laboratorio adiacente al negozio. Tutto è 100% pelle e 100% made in France!"
    ],
    "fr": [
      "Ceintures, maroquinerie, bijoux et accessoires cuir fabriqués sous vos yeux. \r\nTous les articles sont réalisés dans l'atelier accolé à la boutique. Tout est 100% cuir et 100% made in France !!!"
    ],
    "nl": [
      "Riemen, lederwaren, sieraden en leren accessoires die voor je ogen worden gemaakt.\r\nAlle artikelen worden gemaakt in het atelier naast de boetiek. Alles is 100% leer en 100% gemaakt in Frankrijk!"
    ],
    "es": [
      "Cinturones, artículos de cuero, joyas y accesorios de cuero hechos ante sus ojos\r\nTodos los artículos se fabrican en el taller contiguo a la tienda. Todo es 100% cuero y 100% fabricado en Francia"
    ]
  },
  "rdfs:label": {
