  "rdfs:comment": {
    "de": [
      "Die Brasserie Le 205 im Herzen der Domaine de Dolomieu lädt Sie dazu ein, die großen Klassiker der französischen und bistronomischen Küche in kreativer Neuinterpretation zu genießen. Genießen Sie ein elegantes Ambiente inmitten einer 20 Hektar großen Naturlandschaft."
    ],
    "en": [
      "The Brasserie Le 205, located in the heart of the Domaine de Dolomieu, invites you to savour the great classics of French cuisine and bistronomique, revisited with creativity. Enjoy an elegant atmosphere nestled in a natural setting of 20 hectares."
    ],
    "it": [
      "La Brasserie Le 205, nel cuore del Domaine de Dolomieu, vi invita a gustare i grandi classici della cucina francese e bistrot, rivisitati con creatività. Godetevi un ambiente elegante immerso in un contesto naturale di 20 ettari."
    ],
    "fr": [
      "La Brasserie Le 205, située au cœur du Domaine de Dolomieu, vous invite à savourer les grands classiques de la cuisine française et bistronomique, revisités avec créativité. Profitez d’une ambiance élégante nichée dans un écrin de nature de 20 hectares."
    ],
    "es": [
      "La Brasserie Le 205, en el corazón del Domaine de Dolomieu, le invita a saborear los grandes clásicos de la cocina francesa y de bistró, revisitados con creatividad. Disfrute de un ambiente elegante en un entorno natural de 20 hectáreas."
    ],
    "nl": [
      "Brasserie Le 205, in het hart van het Domaine de Dolomieu, nodigt u uit om te genieten van de grote klassiekers van de Franse en bistrokeuken, opnieuw herzien met creativiteit. Geniet van een elegante ambiance genesteld in een natuurlijke omgeving van 20 hectare."
    ]
  },
