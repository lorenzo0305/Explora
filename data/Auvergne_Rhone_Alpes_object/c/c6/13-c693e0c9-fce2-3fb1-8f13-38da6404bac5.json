  "rdfs:comment": {
    "de": [
      "Der Tempel von Beaufort stammt aus dem Jahr 1849. Seine hohe West-Ost-Fassade erhebt sich am Ufer des Flusses Gervanne. Im Inneren befindet sich ein 1951 von Schweizer Künstlern geschaffenes Fresko, das das Pfingstfest darstellt."
    ],
    "en": [
      "The Beaufort temple dates from 1849. Its high west-east façade stands on the banks of the Gervanne. Inside, a fresco painted in 1951 by Swiss artists depicts Pentecost."
    ],
    "it": [
      "Il tempio di Beaufort risale al 1849. La sua alta facciata ovest-est si erge sulle rive del Gervanne. All'interno, un affresco realizzato nel 1951 da artisti svizzeri rappresenta la Pentecoste."
    ],
    "fr": [
      "Le temple de Beaufort date de 1849. Sa haute façade ouest est s'élève au bord  de la Gervanne. A l'intérieur, une fresque réalisée en 1951, par des artistes suisses, représente la Pentecôte."
    ],
    "es": [
      "El templo de Beaufort data de 1849. Su alta fachada oeste-este se levanta a orillas del Gervanne. En el interior, un fresco realizado en 1951 por artistas suizos representa Pentecostés."
    ],
    "nl": [
      "De kerk van Beaufort dateert uit 1849. De hoge west-oost gevel staat aan de oever van de Gervanne. Binnen verbeeldt een fresco dat in 1951 door Zwitserse kunstenaars werd geschilderd Pinksteren."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Temple"
    ]
  },
