  "rdfs:comment": {
    "de": [
      "Der Verein Chants des Terres hat sich zum Ziel gesetzt, Menschen rund um den polyphonen Gesang zusammenzubringen und sie bei Konzerten mit dem Publikum zu teilen."
    ],
    "en": [
      "The Chants des Terres association aims to bring together polyphonic singers and share them with the public through concerts."
    ],
    "it": [
      "L'associazione Chants des Terres si occupa di riunire i cantanti polifonici e di condividerli con il pubblico in occasione di concerti."
    ],
    "fr": [
      "L'association Chants des Terres a pour vocation de regrouper autour du chant polyphonique et de les faire partager au public lors de concerts."
    ],
    "es": [
      "La asociación Chants des Terres se dedica a reunir a cantantes polifónicos y compartirlos con el público en conciertos."
    ],
    "nl": [
      "De vereniging Chants des Terres zet zich in om polyfone zangers samen te brengen en met het publiek te delen tijdens concerten."
    ]
  },
