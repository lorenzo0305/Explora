  "rdfs:comment": {
    "de": [
      "Verein, der Sport- und Spielveranstaltungen organisiert. O'Bi Sport Events hat sich zum Ziel gesetzt, den Sport für alle durch Lasergewehrschießen und Orientierungslauf zu fördern."
    ],
    "en": [
      "An association that organizes sports and leisure events. O'Bi Sport Events aims to promote sport for all through laser rifle shooting and orienteering courses."
    ],
    "it": [
      "Associazione che organizza eventi sportivi e ricreativi. O'Bi Sport Events si propone di promuovere lo sport per tutti attraverso il tiro al laser e i corsi di orienteering."
    ],
    "fr": [
      "Association qui organise des événements sportifs et ludiques. O'Bi Sport Events a pour vocation de promouvoir le sport pour tous au travers du tir à la carabine laser et des parcours d'orientation."
    ],
    "nl": [
      "Een vereniging die sport- en vrijetijdsevenementen organiseert. O'Bi Sport Events wil sport voor iedereen promoten door middel van lasergeweerschieten en oriëntatieloopcursussen."
    ],
    "es": [
      "Asociación que organiza eventos deportivos y de ocio. O'Bi Sport Events pretende fomentar el deporte para todos a través del tiro con rifle láser y los cursos de orientación."
    ]
  },
