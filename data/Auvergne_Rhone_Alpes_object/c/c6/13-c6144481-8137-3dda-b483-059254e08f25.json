  "rdfs:comment": {
    "de": [
      "\"CHEZ AMIR\": Schnell gemacht! Gut gekühlt!!!\r\nMit einer sehr reichhaltigen Speisekarte bietet Ihnen unser Restaurant \"CHEZ AMIR\" eine große Auswahl an Sandwiches, Pizzas, Tex Mex und Gerichten.\r\nUnser gesamtes Fleisch wird frisch zubereitet, unsere Pommes frites sind hausgemacht."
    ],
    "en": [
      "\"CHEZ AMIR: Quickly done! Freshly made!\r\nWith an extensive menu, our restaurant \"CHEZ AMIR\" offers a wide range of sandwiches, pizzas, tex mex and other dishes.\r\nAll our meat is fresh, and our fries are homemade."
    ],
    "it": [
      "\"CHEZ AMIR\": fatto in fretta! Appena fatto!\r\nCon un ampio menu, il nostro ristorante \"CHEZ AMIR\" offre una vasta gamma di panini, pizze, tex mex e piatti principali.\r\nTutta la carne è fresca e le patatine fritte sono fatte in casa."
    ],
    "fr": [
      "« CHEZ AMIR » : Vite fait ! Bien frais !!\r\nAvec une carte très riche en choix, notre restaurant « CHEZ AMIR » vous propose une large gamme de sandwichs, pizzas, tex mex et plats.\r\nToute notre viande est fraîche, nos frites sont faites maison."
    ],
    "nl": [
      "\"CHEZ AMIR : Snel gedaan ! Vers gemaakt!\r\nMet een uitgebreide menukaart biedt ons restaurant \"CHEZ AMIR\" een ruime keuze aan broodjes, pizza's, tex mex en hoofdgerechten.\r\nAl ons vlees is vers en onze frieten zijn huisgemaakt."
    ],
    "es": [
      "\" CHEZ AMIR : ¡Recién hecho! ¡Recién hecho!\r\nCon un extenso menú, nuestro restaurante \"CHEZ AMIR\" ofrece una amplia gama de sándwiches, pizzas, tex mex y platos principales.\r\nToda nuestra carne es fresca y nuestras patatas fritas son caseras."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Chez Amir"
    ]
  },
