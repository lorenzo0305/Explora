  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/e134038a-9c16-37d1-b372-08849b5ec40b",
      "dc:description": {
        "de": [
          "Workshops für Kinder\nDonnerstag, 23. Oktober um 15 Uhr\nLand und Schokolade - Beutin\n------------------------------\nHerstellung von Schokoladenmonstern!\n\nAuf dem Programm stehen:\n-Entdeckung der bean to bar-Schokolade\n-Herstellung von kleinen Monstern, Kürbissen und Geistern aus Schokolade\n-Verkostung und gute Laune garantiert!\n\nBegrenzte Plätze, denken Sie daran, unter 06 13 01 10 74 oder auf ihrer Facebook-Seite zu reservieren\nOrt: 3 route nationale\n\nKredit: Campagne et Chocolat"
        ],
        "en": [
          "Children's workshops\nThursday, October 23 at 3pm\nCampagne et Chocolat - Beutin\n------------------------------\nMaking chocolate monsters!\n\nOn the program:\n-Discover bean-to-bar chocolate\n-Creation of chocolate monsters, pumpkins and ghosts\n-Tasting and fun guaranteed!\n\nPlaces are limited, so book ahead on 06 13 01 10 74 or on their facebook page\nLocation: 3 route nationale\n\nCredit: Campagne et Chocolat"
        ],
        "it": [
          "Laboratori per bambini\nGiovedì 23 ottobre alle 15.00\nCampagne et Chocolat - Beutin\n------------------------------\nCreare mostri di cioccolato!\n\nIn programma:\n-Scoprire il cioccolato dalla fava alla tavoletta\n-Creazione di piccoli mostri, zucche e fantasmi di cioccolato\n-Degustazione e divertimento garantiti!\n\nI posti sono limitati, quindi non dimenticate di prenotare al numero 06 13 01 10 74 o sulla loro pagina Facebook\nUbicazione: 3 route nationale\n\nCredito: Campagne et Chocolat"
        ],
        "fr": [
          "Ateliers pour Enfants\nJeudi 23 octobre à 15h\nCampagne et Chocolat - Beutin\n------------------------------\nFabrication de monstres en chocolat !\n\nAu programme :\n-Découverte du chocolat bean to bar\n-Création de petits monstres, citrouilles et fantômes en chocolat\n-Dégustation et bonne humeur garantie !\n\nPlaces limitées, pensez à réserver au 06 13 01 10 74 ou sur leur page facebook\nLieu : 3 route nationale\n\nCrédit : Campagne et Chocolat"
        ],
        "nl": [
          "Workshops voor kinderen\nDonderdag 23 oktober om 15.00 uur\nCampagne en Chocolade - Beutin\n------------------------------\nChocolademonsters maken!\n\nOp het programma:\n-Ontdek chocolade van boon tot reep\n-Maak kleine chocolademonsters, pompoenen en spoken\n-Proeven en plezier gegarandeerd!\n\nDe plaatsen zijn beperkt, dus vergeet niet te reserveren op 06 13 01 10 74 of op hun facebookpagina\nLocatie: 3 route nationale\n\nKrediet: Campagne et Chocolat"
        ],
        "es": [
          "Talleres para niños\nJueves 23 de octubre a las 15h00\nCampagne et Chocolat - Beutin\n------------------------------\nCreación de monstruos de chocolate\n\nEn el programa:\n-Descubrir el chocolate \"bean to bar\n-Crear pequeños monstruos, calabazas y fantasmas de chocolate\n-Degustación y diversión garantizadas\n\nLas plazas son limitadas, así que no olvide reservar en el 06 13 01 10 74 o en su página de facebook\nUbicación: 3 route nationale\n\nCrédito: Campagne et Chocolat"
        ]
      },
