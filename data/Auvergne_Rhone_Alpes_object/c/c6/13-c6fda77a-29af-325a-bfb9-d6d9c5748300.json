  "rdfs:comment": {
    "de": [
      "Das Rathaus wurde 1913 fertiggestellt.\r\nMan sollte sein hübsches Dach und seine schöne Konstruktion bewundern.\r\nLinks die Fassade des Rathauses, Plan des Architekten."
    ],
    "en": [
      "The Town Hall was built in 1913.\r\nYou have to admire its beautiful roof and construction.\r\nOn the left, the façade of the Town Hall, architect?s drawing."
    ],
    "it": [
      "Il municipio è stato costruito nel 1913.\r\nDa ammirare il suo bel tetto e la sua bella costruzione.\r\nA sinistra, la facciata del Municipio, pianta dell'architetto."
    ],
    "fr": [
      "La Mairie a été réalisée en 1913.\r\nIl faut admirer sa jolie toiture et sa belle construction.\r\nA gauche, la façade de la Mairie, plan de l’architecte."
    ],
    "nl": [
      "Het stadhuis werd gebouwd in 1913.\r\nJe moet het mooie dak en de mooie constructie bewonderen.\r\nLinks de gevel van het stadhuis, plattegrond van de architect."
    ],
    "es": [
      "El Ayuntamiento se construyó en 1913.\r\nHay que admirar su atractivo tejado y su fina construcción.\r\nA la izquierda, la fachada del Ayuntamiento, plano del arquitecto."
    ]
  },
