  "rdfs:comment": {
    "de": [
      "Nur 5 Minuten vom Zentrum von Valence und 10 Minuten vom Messegelände entfernt liegt das Hotel Ibis Valence Sud an der Kreuzung der A7, der A49 und des TGV-Bahnhofs. Wir begrüßen Sie in einer modernen Umgebung, die sich ideal für Ihren Geschäfts- oder Freizeitaufenthalt eignet."
    ],
    "en": [
      "Just 5 minutes from the center of Valence and 10 minutes from the exhibition center, the Ibis Valence Sud hotel is at the crossroads of the A7 and A49 motorways and the TGV train station. We welcome you in a modern setting, ideal for your business or leisure stays."
    ],
    "it": [
      "A 5 minuti dal centro di Valence e a 10 minuti dal centro espositivo, l'hotel Ibis Valence Sud si trova all'incrocio tra la A7, la A49 e la stazione dei treni TGV. L'hotel vi accoglie in un ambiente moderno, ideale per i vostri soggiorni di lavoro o di piacere."
    ],
    "fr": [
      "A 5 minutes du centre de Valence et à 10 minutes du Parc des expositions, l'hôtel Ibis Valence Sud est situé au carrefour de l'A7, de l'A49 et de la gare TGV. Nous vous accueillons dans un cadre moderne, idéal pour vos séjours d'affaires ou de loisirs."
    ],
    "nl": [
      "Het Ibis-hotel Valence Sud ligt op slechts 5 minuten van het centrum van Valence en 10 minuten van het expositiecentrum, op het kruispunt van de snelwegen A7 en A49 en het TGV-treinstation. We verwelkomen u in een moderne omgeving, ideaal voor uw zaken- of vakantieverblijf."
    ],
    "es": [
      "A 5 minutos del centro de Valence y a 10 minutos del recinto ferial, el hotel Ibis Valence Sud está situado en el cruce de la A7, la A49 y la estación de tren TGV. El hotel le da la bienvenida en un entorno moderno, ideal para sus estancias de negocios o de ocio."
    ]
  },
