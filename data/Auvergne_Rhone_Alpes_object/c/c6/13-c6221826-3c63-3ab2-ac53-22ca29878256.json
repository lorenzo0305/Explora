  "rdfs:comment": {
    "de": [
      "Melken der Salers-Kuh. Herstellung des Salers Tradition. Reifung des Salers tradition. Entdecken Sie mit uns die Aufzucht der Salers-Kuh, das Melken und die Herstellung ihres Käses. Obligatorische Verkostung des Salers Tradition in unserem Reifungskeller."
    ],
    "en": [
      "Milking Salers cows. Making Salers tradition. Refining Salers tradition. Come and discover with us the breeding of the Salers cow, milking and cheese making. Obligatory tasting of Salers Tradition in our maturing cellar."
    ],
    "it": [
      "Mungere le mucche di Salers. Fare la tradizione Salers. Maturazione della tradizione di Salers. Venite a scoprire con noi come si alleva, si munge e si produce il formaggio di Salers. La degustazione del Salers Tradition è obbligatoria nella nostra cantina di stagionatura."
    ],
    "fr": [
      "Traite de la vache Salers. Fabrication du Salers tradition. Affinage du Salers tradition. Venez découvrir avec nous l'élevage de la salers, traite et fabrication de son fromage. Dégustation du salers tradition obligatoire dans notre cave d'affinage."
    ],
    "nl": [
      "Salers koeien melken. Het maken van Salers traditie. Rijping van de Salers traditie. Kom samen met ons ontdekken hoe de Salers koe wordt gehouden, gemolken en hoe de kaas wordt gemaakt. Proeven van Salers Tradition is verplicht in onze rijpingskelder."
    ],
    "es": [
      "Ordeñar vacas Salers. Elaboración de la tradición Salers. Maduración de la tradición Salers. Venga a descubrir con nosotros cómo se cría la vaca Salers, se ordeña y se elabora su queso. La degustación del Salers Tradition es obligatoria en nuestra bodega de maduración."
    ]
  },
  "rdfs:label": {
    "fr": [
      "GAEC Galvaing Père et Fils"
    ]
  },
