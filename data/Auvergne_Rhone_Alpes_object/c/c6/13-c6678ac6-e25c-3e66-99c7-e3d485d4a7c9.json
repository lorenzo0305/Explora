  "rdfs:comment": {
    "de": [
      "Die ESF-Lehrer bieten das Erlernen und Verbessern verschiedener Praktiken: Skifahren, Snowboarden, Telemark, Langlauf, Tourenski, Privat- oder Gruppenunterricht für Kinder und Erwachsene."
    ],
    "en": [
      "The ESF instructors offer the learning and improvement of different practices: skiing, snowboarding, telemark, cross-country skiing, ski touring, private or group lessons, for children and adults."
    ],
    "it": [
      "I maestri ESF offrono una gamma di attività di apprendimento e miglioramento: sci, snowboard, telemark, sci di fondo, sci alpinismo, lezioni private o di gruppo, per bambini e adulti."
    ],
    "fr": [
      "Les moniteurs ESF proposent l'apprentissage et le perfectionnement de différentes pratiques : ski, snowboard, télémark, ski de fond, ski de randonnée, leçons particulières ou collectives, pour les enfants et les adultes."
    ],
    "es": [
      "Los monitores de ESF ofrecen una amplia gama de actividades de aprendizaje y perfeccionamiento: esquí, snowboard, esquí de telemark, esquí de fondo, esquí de travesía, clases particulares o en grupo, para niños y adultos."
    ],
    "nl": [
      "ESF-instructeurs bieden een scala aan leer- en verbeteractiviteiten: skiën, snowboarden, telemarken, langlaufen, skitouren, privé- of groepslessen, voor kinderen en volwassenen."
    ]
  },
