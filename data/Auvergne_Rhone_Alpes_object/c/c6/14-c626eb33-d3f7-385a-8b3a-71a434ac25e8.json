  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/810600fb-270b-3674-b8c9-e7d122728548",
      "dc:description": {
        "de": [
          "Informationen :\n\nÖffnungstage:\n\nDienstag bis Freitag von 6:30 bis 13:00 Uhr\nSamstag und Sonntag von 7:00 bis 13:00 Uhr\n\nMontag geschlossen\n\nBestellungen:\nBestellung möglich, 48 Stunden im Voraus, per Telefon unter 03 21 55 92 35\n \n Abholung:\nZum Mitnehmen während der Öffnungszeiten des Geschäfts\n\n "
        ],
        "en": [
          "Information :\n\nOpening days:\n\nTuesday to Friday, 6:30am to 1pm\nSaturday and Sunday from 7am to 1pm\n\nClosed on Mondays\n\nOrders :\nOrders can be placed 48 hours in advance by telephone on 03 21 55 92 35\n \n Pick-up:\nTakeaway during store opening hours\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura:\n\nDa martedì a venerdì dalle 6.30 alle 13.00\nSabato e domenica dalle 7.00 alle 13.00\n\nChiuso il lunedì\n\nOrdini :\nLe ordinazioni possono essere effettuate con 48 ore di anticipo telefonando al numero 03 21 55 92 35\n \n Ritiro:\nDa asporto durante gli orari di apertura del negozio\n\n "
        ],
        "fr": [
          "Informations :\n\nJours d'ouverture:\n\nDu mardi au vendredi de 6h30 à 13h \nSamedi et dimanche  de 7h à 13h00\n\nFermeture le lundi\n\nCommandes :\nPossibilité de commande, 48h avant, par téléphone au 03 21 55 92 35\n \n Retrait :\nÀ emporter aux horaires d'ouverture du magasin\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen:\n\nDinsdag tot vrijdag van 6u30 tot 13u00\nZaterdag en zondag van 7u tot 13u\n\nMaandag gesloten\n\nBestellingen :\nBestellingen kunnen 48 uur van tevoren telefonisch worden doorgegeven op 03 21 55 92 35\n \n Afhalen:\nAfhalen tijdens openingstijden van de winkel\n\n "
        ],
        "es": [
          "Más información :\n\nDías de apertura:\n\nDe martes a viernes de 6h30 a 13h00\nSábado y domingo de 7h a 13h\n\nLunes cerrado\n\nPedidos :\nLos pedidos pueden realizarse con 48 horas de antelación por teléfono llamando al 03 21 55 92 35\n \n Recogida:\nPara llevar durante el horario de apertura de la tienda\n\n "
        ]
      },
