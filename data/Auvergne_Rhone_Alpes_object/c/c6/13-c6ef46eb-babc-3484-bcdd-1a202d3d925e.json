  "rdfs:comment": {
    "de": [
      "Die Auberge des Hurtières, eine angenehme Panorama-Etappe auf dem Weg zum Col du Cucheron, an der Kreuzung der Täler der Maurienne und der Tarentaise."
    ],
    "en": [
      "Auberge des Hurtières, a pleasant panoramic stage on the Col du Cucheron road, at the crossroads of the Maurienne and Tarentaise valleys.\r\nRelay motorcycle, step night for bikers: dinner and overnight at the hostel."
    ],
    "it": [
      "L'Auberge des Hurtières, una piacevole sosta panoramica sulla strada per il Col du Cucheron, all'incrocio delle valli della Maurienne e della Tarentaise."
    ],
    "fr": [
      "L'Auberge des Hurtières, une agréable étape panoramique sur la route du Col du Cucheron, au carrefour des vallées de la Maurienne et de la Tarentaise."
    ],
    "es": [
      "El Auberge des Hurtières, una agradable parada panorámica en la carretera del Col du Cucheron, en el cruce de los valles de la Maurienne y la Tarentaise."
    ],
    "nl": [
      "De Auberge des Hurtières, een aangename panoramische tussenstop op de weg naar de Col du Cucheron, op het kruispunt van de Maurienne en de Tarentaise vallei."
    ]
