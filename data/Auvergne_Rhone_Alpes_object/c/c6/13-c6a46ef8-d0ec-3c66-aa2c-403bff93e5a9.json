  "rdfs:comment": {
    "de": [
      "Das 100 m vom Stadtzentrum in der Rue du Lyret gelegene \"Casa Valerio\" hat sich seit 39 Jahren mit Leidenschaft und Liebe zur Gastronomie einen guten Ruf erworben."
    ],
    "en": [
      "Located 100m from the city center in the Rue du Lyret, Casa Valerio has made its reputation for 39 years with passion and love for gastronomy."
    ],
    "it": [
      "Situata a 100 metri dal centro della città, in Rue du Lyret, Casa Valerio ha costruito la sua reputazione negli ultimi 39 anni con passione e amore per la gastronomia."
    ],
    "fr": [
      "Située à 100m du centre ville dans la rue du Lyret « Casa Valerio » a fait sa réputation depuis 39 ans avec passion et amour pour la gastronomie."
    ],
    "es": [
      "Situada a 100 metros del centro de la ciudad, en la Rue du Lyret, la Casa Valerio ha construido su reputación durante los últimos 39 años con pasión y amor por la gastronomía."
    ],
    "nl": [
      "Op 100m van het stadscentrum in de Rue du Lyret heeft Casa Valerio de afgelopen 39 jaar met passie en liefde voor gastronomie haar reputatie opgebouwd."
    ]
