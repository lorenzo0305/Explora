  "rdfs:comment": {
    "de": [
      "Seit 1946 garantiert Ihnen das Haus Dorey die Exzellenz des französischen Kunsthandwerks. Seit über 75 Jahren steht Ihnen unser Atelier in unserem Geschäft zur Seite, in dem Ihr Schmuck hergestellt, repariert und umgewandelt wird."
    ],
    "en": [
      "Since 1946, Dorey has guaranteed the excellence of French craftsmanship. At your side for over 75 years, our in-store workshop creates, repairs and transforms your jewelry."
    ],
    "it": [
      "Dal 1946, Dorey garantisce l'eccellenza dell'artigianato francese. Al vostro fianco da oltre 75 anni, il nostro laboratorio nel cuore del negozio crea, ripara e trasforma i vostri gioielli."
    ],
    "fr": [
      "Depuis 1946, la maison Dorey vous garantie l’excellence de l’artisanat français. À vos côtés depuis plus de 75 ans, notre atelier au sein même de notre magasin crée, répare et transforme vos bijoux."
    ],
    "nl": [
      "Sinds 1946 staat Dorey garant voor de uitmuntendheid van het Franse vakmanschap. Ons atelier in het hart van onze winkel staat al meer dan 75 jaar aan uw zijde en creëert, repareert en transformeert uw sieraden."
    ],
    "es": [
      "Desde 1946, Dorey garantiza la excelencia de la artesanía francesa. A su lado desde hace más de 75 años, nuestro taller en el corazón de nuestra tienda crea, repara y transforma sus joyas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Maison Dorey Joaillier"
    ]
  },
