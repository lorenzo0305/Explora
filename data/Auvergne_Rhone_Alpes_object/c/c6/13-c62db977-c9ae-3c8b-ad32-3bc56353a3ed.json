  "rdfs:comment": {
    "de": [
      "In der Nähe des Vercors und der Ardèche empfängt Sie das Hotel-Restaurant originals city Valence Est in einer freundlichen Atmosphäre. Das Restaurant präsentiert eine traditionelle Küche, die aus saisonalen Gerichten besteht, die im Restaurant oder auf der Terrasse angeboten werden."
    ],
    "en": [
      "Close to the Vercors and Ardèche regions, the hotel-restaurant originals city Valence Est welcomes you in a friendly atmosphere. The restaurant offers traditional cuisine, with seasonal dishes served in the restaurant or on the terrace."
    ],
    "it": [
      "Vicino al Vercors e all'Ardèche, l'hotel-ristorante Originals City Valence Est vi accoglie in un'atmosfera amichevole. Il ristorante offre una cucina tradizionale, con piatti di stagione serviti nel ristorante o sulla terrazza."
    ],
    "fr": [
      "Proche du Vercors et de l'Ardèche, l'hôtel-restaurant  originals city Valence Est vous accueille dans une ambiance conviviale. Le restaurant présente une cuisine traditionnelle, composée de plats de saison proposés dans le restaurant ou sur la terrasse."
    ],
    "nl": [
      "Vlakbij de Vercors en de Ardèche verwelkomt hotel-restaurant Originals City Valence Est je in een vriendelijke sfeer. Het restaurant biedt een traditionele keuken, met seizoensgebonden gerechten die in het restaurant of op het terras worden geserveerd."
    ],
    "es": [
      "Cerca del Vercors y de la Ardèche, el hotel-restaurante Originals City Valence Est le acoge en un ambiente acogedor. El restaurante ofrece cocina tradicional, con platos de temporada que se sirven en el restaurante o en la terraza."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Table des Couleures"
    ]
  },
