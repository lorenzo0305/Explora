  "rdfs:comment": {
    "de": [
      "Gelingt es Ihnen, alle Geschmacksrichtungen zu erkennen? Spielen Sie mit Ihren Geschmacksknospen und lernen Sie, Wein anders zu verkosten."
    ],
    "en": [
      "Can you recognise all the flavours? Come and play with your taste buds and learn to taste wine in a different way."
    ],
    "it": [
      "Riuscite a riconoscere tutti i sapori? Venite a giocare con le vostre papille gustative e imparate a gustare il vino in modo diverso."
    ],
    "fr": [
      "Arrivez-vous à reconnaitre toutes les saveurs ? Venez jouer avec vos papilles et apprenez à déguster le vin autrement."
    ],
