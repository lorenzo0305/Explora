  "rdfs:comment": {
    "de": [
      "Als leidenschaftliche Dekorateurin hat Anne-Sophie einen Ort eröffnet, der ihr ähnelt: warm, inspirierend und einladend. Hier reimt sich Töpferei auf Ästhetik und Harmonie."
    ],
    "en": [
      "A keen decorator, Anne-Sophie has opened a place that's just like her: warm, inspiring and welcoming. Here, pottery rhymes with aesthetics and harmony."
    ],
    "it": [
      "Appassionata di decorazione, Anne-Sophie ha aperto un locale che è proprio come lei: caldo, stimolante e accogliente. Qui la ceramica fa rima con estetica e armonia."
    ],
    "fr": [
      "Passionnée de décoration, Anne-Sophie a ouvert un lieu qui lui ressemble : chaleureux, inspirant et accueillant. Ici, la poterie rime avec esthétique et harmonie."
    ],
    "es": [
      "Anne-Sophie, apasionada de la decoración, ha abierto un local que es como ella: cálido, inspirador y acogedor. Aquí, la cerámica rima con estética y armonía."
    ],
    "nl": [
      "Als enthousiaste decorateur heeft Anne-Sophie een zaak geopend die net als zij is: warm, inspirerend en gastvrij. Hier rijmt aardewerk met esthetiek en harmonie."
    ]
  },
