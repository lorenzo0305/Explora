      "@id": "https://data.datatourisme.fr/20e903c8-39d3-384b-8426-d1d9ed0cc4dc",
      "dc:description": {
        "de": [
          "Produzent von BIO-Äpfeln - Calvados, Aperitif aus der grünen Picardie, Cidre Brut et Doux, Cidre-Essig,\nPétillant de Pomme, Apfelsaft, Apfelsaft Birne, Apfelsaft Rhabarber, Konfitüren Apfel Zimt, Apfel Karamell, Apfelgelee, Apfelgelee Calvados, Confit Cidre au Calvados Pomme et Poire lors de la saison"
        ],
        "en": [
          "Organic Apple Producer - Calvados, Aperitif de Picardie Verte, Cidre Brut et Doux, Cider Vinegar,\nPétillant de Pomme, Jus de Pomme, Jus Pomme Poire, Jus Pomme Rhubarbe, Confitures Pomme Cannelle, Pomme Caramel, Gelée Pomme, Gelée Pomme Calvados, Confit Cidre au Calvados Pomme et Poire in season"
        ],
        "it": [
          "Produttore biologico di mele - Calvados, Aperitivo di Picardie Verte, Cidre Brut et Doux, Aceto di sidro,\nPétillant de Pomme, Succo di Mela, Succo di Pera, Succo di Rabarbaro, Marmellata di Mele alla Cannella, Marmellata di Mele al Caramello, Gelatina di Mele, Gelatina di Mele al Calvados, Sidro Confit di Mele e Pere al Calvados in stagione"
        ],
        "fr": [
          "Producteur de Pommes BIO -  Calvados, Apéritif de Picardie Verte, Cidre Brut et Doux, Vinaigre de Cidre, \nPétillant de Pomme, Jus de Pomme, Jus Pomme Poire, Jus Pomme Rhubarbe, Confitures Pomme Cannelle, Pomme Caramel, Gelée Pomme, Gelée Pomme Calvados, Confit Cidre au Calvados Pomme et Poire lors de la saison"
        ],
        "es": [
          "Productor de Manzanas Ecológicas - Calvados, Aperitivo de Picardía Verde, Cidre Brut et Doux, Vinagre de Sidra,\nPétillant de Pomme, Zumo de Manzana, Zumo de Manzana y Pera, Zumo de Manzana y Ruibarbo, Mermelada de Manzana y Canela, Mermelada de Manzana y Caramelo, Jalea de Manzana, Jalea de Manzana y Calvados, Sidra confitada de Manzana y Pera en temporada"
        ],
        "nl": [
          "Biologische appelproducent - Calvados, Aperitif de Picardie Verte, Cidre Brut et Doux, Cider Vinegar,\nPétillant de Pomme, Appelsap, Appelperensap, Appelrabarbersap, Appel kaneeljam, Appel karameljam, Appelgelei, Appel Calvados Gelei, Appel en Peer Calvados Cider Confit in het seizoen"
        ]
      },
