  "rdfs:comment": {
    "de": [
      "In einer warmen und freundlichen Atmosphäre empfängt Sie das Skiro die ganze Saison über am Fuße der Pisten, gegenüber dem Sessellift La Colomba, um unsere Bergspezialitäten, Süßigkeiten und Cocktails zu genießen"
    ],
    "en": [
      "In a warm and friendly atmosphere, the Skiro welcomes you all season long at the foot of the slopes, opposite the Colomba chairlift, to enjoy our mountain specialities, sweets and cocktails."
    ],
    "it": [
      "In un'atmosfera calda e accogliente, lo Skiro vi accoglie per tutta la stagione ai piedi delle piste, di fronte alla seggiovia Colomba, per gustare le nostre specialità di montagna, i dolci e i cocktail"
    ],
    "fr": [
      "Dans une ambiance chaleureuse et conviviale, le Skiro vous accueille toute la saison au pied des pistes, face au télésiège de la Colomba, pour déguster nos spécialités de montagne, douceurs et cocktails"
    ],
    "nl": [
      "In een warme en vriendelijke sfeer verwelkomt de Skiro je het hele seizoen aan de voet van de pistes, tegenover de stoeltjeslift Colomba, om te genieten van onze bergspecialiteiten, zoetigheden en cocktails."
    ],
    "es": [
      "En un ambiente cálido y acogedor, el Skiro le da la bienvenida toda la temporada a pie de pistas, frente al telesilla Colomba, para degustar nuestras especialidades de montaña, dulces y cócteles"
    ]
  },
