  "rdfs:comment": {
    "de": [
      "Entdecken Sie unsere köstlichen Suppen, umwerfenden Tartines und leckeren Tartelettes! Hausgemachtes\", das in einer herzlichen und familiären Atmosphäre serviert wird."
    ],
    "en": [
      "Taste our delicious soups, our fabulous sandwiches and our mouthwatering tartlets! Home made fare served in a warm and family atmosphere."
    ],
    "it": [
      "Venite a scoprire le nostre deliziose zuppe, le nostre splendide tartine e le nostre crostate gourmet! Cibo fatto in casa servito in un'atmosfera calda e familiare."
    ],
    "fr": [
      "Venez découvrir nos délicieuses soupes, nos tartines renversantes, nos tartelettes gourmandes ! Du \"fait maison\" servi dans une ambiance chaleureuse et familiale."
    ],
    "es": [
      "Venga a descubrir nuestras deliciosas sopas, nuestros impresionantes tartines y nuestras tartas gourmet Comida casera servida en un ambiente cálido y familiar."
    ],
    "nl": [
      "Kom en ontdek onze heerlijke soepen, onze prachtige toasts, onze gastronomische taarten! Huisgemaakt\" geserveerd in een warme en familiale sfeer."
    ]
  },
