  "rdfs:comment": {
    "de": [
      "Durchqueren Sie die Teiche von Feurs ganz sanft mit dieser kleinen Fahrradschleife. Vielleicht sehen Sie Reiher und andere Vögel, die hier beheimatet sind."
    ],
    "en": [
      "Cross the ponds of Feurs gently with this short cycling loop. Perhaps you'll spot the herons and other birds that inhabit the area."
    ],
    "it": [
      "Pedalate dolcemente attraverso gli stagni di Feurs su questo breve anello ciclabile. Potreste anche avvistare gli aironi e gli altri uccelli che popolano la zona."
    ],
    "fr": [
      "Traversez les étangs de Feurs tout en douceur avec cette petite boucle vélo. Peut-être verrez vous les hérons et autres oiseaux qui habitent ces lieux."
    ],
    "nl": [
      "Rijd zachtjes door de vijvers van Feurs op deze korte fietslus. Misschien zie je wel de reigers en andere vogels die in dit gebied leven."
    ],
    "es": [
      "Recorra suavemente los estanques de Feurs en este corto circuito ciclista. Puede que incluso vea las garzas y otras aves que habitan la zona."
    ]
  },
