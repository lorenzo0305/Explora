  "rdfs:comment": {
    "de": [
      "Postamt (Bureau de Poste)\nUm La Poste aus Frankreich telefonisch unter 3631 zu kontaktieren\nKostenloser Dienst + Anrufpreis. Geöffnet montags bis freitags von 8:30 bis 19:00 Uhr und samstags von 8:30 bis 13:00 Uhr (außer an Feiertagen)."
    ],
    "en": [
      "Post office\nTo contact La Poste by telephone from France: 3631\nFree service + call charge. Open Monday to Friday from 8:30am to 7:00pm and Saturday from 8:30am to 1:00pm (excluding public holidays)."
    ],
    "it": [
      "Ufficio postale\nPer contattare La Poste per telefono dalla Francia: 3631\nServizio gratuito + costo della chiamata. Aperto dal lunedì al venerdì dalle 8.30 alle 19.00 e il sabato dalle 8.30 alle 13.00 (esclusi i giorni festivi)."
    ],
    "fr": [
      "Bureau de Poste\nPour contacter La Poste par téléphone depuis la France au 3631\nService Gratuit + prix d'appel. Ouvert du lundi au vendredi de 8h30 à 19h00 et le samedi de 8h30 à 13h00 (hors jours fériés)."
    ],
    "nl": [
      "Postkantoor\nTelefonisch contact opnemen met La Poste vanuit Frankrijk: 3631\nGratis service + gesprekskosten. Open van maandag tot vrijdag van 8.30 tot 19.00 uur en op zaterdag van 8.30 tot 13.00 uur (behalve op feestdagen)."
    ],
    "es": [
      "La Poste\nPara contactar con La Poste por teléfono desde Francia: 3631\nServicio gratuito + gastos de llamada. Abierto de lunes a viernes de 8h30 a 19h00 y los sábados de 8h30 a 13h00 (excepto festivos)."
    ]
  },
