  "rdfs:comment": {
    "de": [
      "Familienbetrieb mit Viehzucht am Eingang des Naturschutzgebiets Marais de Lavours. Hausgemachtes Fleisch und Wurstwaren. Freilandschweine, Kühe und Kälber der Highland-Rasse, Graslämmer."
    ],
    "en": [
      "Family-run livestock farm at the entrance to the Marais de Lavours nature reserve. Home-made meats and charcuterie. Free-range pigs, Highland cows and calves, grass-fed lambs. Plant and vegetable garden!"
    ],
    "it": [
      "Azienda zootecnica a conduzione familiare all'ingresso della riserva naturale del Marais de Lavours. Carni e salumi di produzione propria. Maiali ruspanti, mucche e vitelli delle Highlands, agnelli nutriti con erba."
    ],
    "fr": [
      "Ferme d’élevage familiale à l'entrée de la réserve naturelle du Marais de Lavours. Viandes et charcuteries maison. Porcs en plein air, vaches et veaux de race Highlands, agneaux d'herbe."
    ],
    "nl": [
      "Familieboerderij aan de ingang van het natuurreservaat Marais de Lavours. Huisgemaakte vleeswaren en vleeswaren. Scharrelvarkens, Highland koeien en kalveren, grasgevoerde lammeren."
    ],
    "es": [
      "Explotación ganadera familiar a la entrada de la reserva natural del Marais de Lavours. Carnes y embutidos caseros. Cerdos camperos, vacas y terneros Highland, corderos alimentados con pasto."
    ]
  },
