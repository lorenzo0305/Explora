  "rdfs:comment": {
    "de": [
      "Bereich, der den Blumen gewidmet ist. Entdecken Sie unsere Auswahl an frischen Blumen. Wir fertigen Blumenarrangements und Sträuße für alle Anlässe und Ereignisse an. Jede Kreation wird mit Leidenschaft, Originalität und Kreativität erarbeitet."
    ],
    "en": [
      "Space dedicated to flowers. Come and discover our selection of fresh flowers. We create floral arrangements and bouquets for all occasions and events. Each creation is crafted with passion, originality and creativity."
    ],
    "it": [
      "Spazio dedicato ai fiori. Venite a scoprire la nostra selezione di fiori freschi. Creiamo composizioni floreali e bouquet per tutte le occasioni e gli eventi. Ogni creazione è realizzata con passione, originalità e creatività."
    ],
    "fr": [
      "Espace dédié aux fleurs. Venez découvrir notre sélection de fleurs fraîches. Nous réalisons des compositions florales et des bouquets pour toutes les occasions et événements. Chaque création est élaborée avec passion, originalité et créativité."
    ],
    "nl": [
      "Ruimte gewijd aan bloemen. Kom en ontdek onze selectie verse bloemen. Wij creëren bloemstukken en boeketten voor alle gelegenheden en evenementen. Elke creatie is gemaakt met passie, originaliteit en creativiteit."
    ],
    "es": [
      "Espacio dedicado a las flores. Venga a descubrir nuestra selección de flores frescas. Creamos arreglos florales y ramos para todas las ocasiones y eventos. Cada creación se realiza con pasión, originalidad y creatividad."
    ]
  },
  "rdfs:label": {
