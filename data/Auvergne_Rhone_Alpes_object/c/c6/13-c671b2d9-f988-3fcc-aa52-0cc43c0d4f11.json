  "rdfs:comment": {
    "de": [
      "Im Jardin d'Asie können Sie chinesische, vietnamesische, kambodschanische und thailändische Spezialitäten sowie einige Klassiker der japanischen und koreanischen Küche probieren."
    ],
    "en": [
      "Le Jardin d'Asie offers Chinese, Vietnamese, Cambodian and Thai specialties, as well as Japanese and Korean classics, to eat in, take away or deliver."
    ],
    "it": [
      "Le Jardin d'Asie offre specialità cinesi, vietnamite, cambogiane e thailandesi, oltre ad alcuni classici della cucina giapponese e coreana."
    ],
    "fr": [
      "Le Jardin d'Asie vous propose de découvrir ses plats de spécialités chinoises, vietnamiennes, cambodgiennes et thaïlandaises, ainsi que quelques classiques de la cuisine japonaise et coréenne .Sur place ou à emporter ou en livraison."
    ],
    "es": [
      "Le Jardin d'Asie sirve especialidades chinas, vietnamitas, camboyanas y tailandesas, así como algunos clásicos japoneses y coreanos, para comer en el restaurante, para llevar o a domicilio."
    ],
    "nl": [
      "Le Jardin d'Asie biedt Chinese, Vietnamese, Cambodjaanse en Thaise specialiteiten, evenals enkele klassiekers uit de Japanse en Koreaanse keuken."
    ]
  },
