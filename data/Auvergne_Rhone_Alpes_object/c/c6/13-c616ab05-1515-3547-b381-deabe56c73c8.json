  "rdfs:comment": {
    "de": [
      "Das Fast-Food-Restaurant \"Le Cas d'Al\" ist ein 2003 gegründeter Familienbetrieb, der von Vater und Sohn geführtwird. Sie bieten Ihnen Kebabs, Sandwichs oder Menüs nach Wahl."
    ],
    "en": [
      "Created in 2003, “Le Cas d’Al” is a family-run fast-food business handed down from father to son, serving kebabs, tacos, sandwiches, and various meal deals."
    ],
    "it": [
      "Il fast-food \"Le Cas d'Al\", creato nel 2003, è un'azienda a conduzione familiare, da padre a figlio, che vi offre kebab, tacos, panini o la formula che preferite."
    ],
    "fr": [
      "Le fast-food \"Le Cas d'Al\" créé en 2003 est une entreprise familiale, de père en fils, vous proposant des kebabs, des tacos, des sandwichs ou alors la formule de votre choix."
    ],
    "nl": [
      "Het in 2003 opgerichte fastfoodrestaurant \"Le Cas d'Al\" is een familiebedrijf, van vader op zoon, dat u kebabs, taco's, broodjes of de formule van uw keuze aanbiedt."
    ],
    "es": [
      "El restaurante de comida rápida \"Le Cas d'Al\", creado en 2003, es un negocio familiar, de padre a hijo, que le ofrece kebabs, tacos, sándwiches o la fórmula que desee."
    ]
  },
