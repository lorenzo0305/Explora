  "rdfs:comment": {
    "de": [
      "5 Minuten von der A7 und 13 Minuten vom Place Bellecour entfernt, auf dem Weg in den Süden oder in die Alpen, bietet Ihnen unser Haus 74 komplett renovierte, klimatisierte Zimmer, die Ihnen Ruhe und Komfort bieten. Familienzimmer und Zimmer für Personen mit eingeschränkter Mobilität"
    ],
    "en": [
      "5 minutes from the A7 motorway, 13 minutes from Place Bellecour, on the road to the South or the Alps, our establishment offers 74 fully renovated, air-conditioned rooms for your peace and comfort. Family rooms and rooms for people with reduced mobility"
    ],
    "it": [
      "A 5 minuti dall'autostrada A7 e a 13 minuti da Place Bellecour, sulla strada per il Sud o le Alpi, la nostra struttura offre 74 camere completamente rinnovate e climatizzate per la vostra tranquillità e il vostro comfort. Camere familiari e camere per persone a mobilità ridotta"
    ],
    "fr": [
      "A 5mn de l'A7, 13mn de la Place Bellecour, sur la route du Sud ou des Alpes, notre établissement vous propose 74 chambres totalement rénovées, climatisées qui vous apporteront calme et confort. Chambres familiales et pour personnes à mobilité réduite"
    ],
    "nl": [
      "Op slechts 5 minuten van de snelweg A7 en 13 minuten van Place Bellecour, op weg naar het zuiden of de Alpen, biedt ons etablissement 74 volledig gerenoveerde kamers met airconditioning voor uw rust en comfort. Familiekamers en kamers voor personen met beperkte mobiliteit"
    ],
    "es": [
      "A 5 minutos de la autopista A7 y a 13 minutos de la plaza Bellecour, en la carretera del Sur o de los Alpes, nuestro establecimiento ofrece 74 habitaciones totalmente renovadas y climatizadas para su tranquilidad y comodidad. Habitaciones familiares y para personas con movilidad reducida"
    ]
  },
