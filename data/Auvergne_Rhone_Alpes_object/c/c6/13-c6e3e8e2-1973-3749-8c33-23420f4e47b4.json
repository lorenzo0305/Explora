  "rdfs:comment": {
    "de": [
      "Ein so britisches Pub in Valence. Dieses Lokal, das seine Stammgäste hat, bietet die größte Auswahl an Bieren in der Stadt, und zwar in allen Farben! Auch die Auswahl an Whiskys kann sich sehen lassen.\r\nNeu: Tagesgericht von Montag bis Freitag!"
    ],
    "en": [
      "A sobritish pub in Valence. This loyal establishment boasts the city's largest selection of beers, all colors included! The whisky selection also stands up well.\r\nNew: daily specials from Monday to Friday!"
    ],
    "it": [
      "Un pub così british a Valence. Questo locale fedele offre la più ampia scelta di birre della città, con tutti i colori inclusi! Anche la scelta dei whisky è piuttosto buona.\r\nNovità: specialità giornaliere dal lunedì al venerdì!"
    ],
    "fr": [
      "Un pub so british à Valence. Cet établissement qui a ses fidèles, propose le plus grand choix de bières de la ville, toutes couleurs confondues ! Le choix en whiskies se défend pas mal aussi.\r\nNouveau : plat du jour du lundi au vendredi !"
    ],
    "es": [
      "Un pub tan británico en Valence. Este fiel establecimiento ofrece la mayor oferta de cervezas de la ciudad, ¡con todos los colores incluidos! La selección de whiskies también es bastante buena.\r\nNovedad: ¡especiales diarios de lunes a viernes!"
    ],
    "nl": [
      "Een sober café in Valence. Dit trouwe etablissement biedt de ruimste keuze aan bieren in de stad, alle kleuren bij elkaar! De keuze aan whisky's is ook niet slecht.\r\nNieuw: dagelijkse specials van maandag tot vrijdag!"
    ]
  },
