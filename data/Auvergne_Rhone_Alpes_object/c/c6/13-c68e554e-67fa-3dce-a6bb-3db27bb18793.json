  "rdfs:comment": {
    "de": [
      "Goyon-Chazeau ist eine familiengeführte Messerschmiede, die seit den 1950er Jahren in Thiers ansässig ist. Sie entwirft und fertigt alle ihre Messer und Tafelbestecke, Küchenmesser und Taschenmesser."
    ],
    "en": [
      "Goyon-Chazeau has been a family-owned cutlery business in Thiers since the 1950s. It designs and manufactures all its knives and flatware, kitchen knives and pocket knives."
    ],
    "it": [
      "Goyon-Chazeau è un'azienda di coltelleria a conduzione familiare con sede a Thiers dagli anni Cinquanta. Progetta e produce tutti i suoi coltelli e posate, coltelli da cucina e coltelli da tasca."
    ],
    "fr": [
      "Goyon-Chazeau est une coutellerie familiale installée à Thiers depuis les années 50. Elle crée et fabrique l’ensemble de ses couteaux et couverts de table, couteaux de cuisine et couteaux de poche."
    ],
    "nl": [
      "Goyon-Chazeau is een familiebedrijf in bestek dat sinds de jaren 1950 gevestigd is in Thiers. Het ontwerpt en produceert al zijn messen en bestek, keukenmessen en zakmessen."
    ],
    "es": [
      "Goyon-Chazeau es una empresa familiar de cuchillería establecida en Thiers desde los años cincuenta. Diseña y fabrica todos sus cuchillos y cubiertos, cuchillos de cocina y navajas de bolsillo."
    ]
  },
  "rdfs:label": {
