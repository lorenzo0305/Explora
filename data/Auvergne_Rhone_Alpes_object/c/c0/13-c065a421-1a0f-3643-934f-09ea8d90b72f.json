  "rdfs:comment": {
    "de": [
      "In ihren malerischen Kreationen bewegt sich Tima zwischen den subtilen Grenzen von Kindheit und Erwachsensein und fängt traumhafte Visionen von Frauen ein, die sich in ihren Gedanken verlieren."
    ],
    "en": [
      "In her pictorial creations, Tima navigates the subtle boundaries between childhood and adulthood, capturing dreamlike visions of women lost in their own thoughts."
    ],
    "it": [
      "Nelle sue creazioni pittoriche, Tima naviga nei sottili confini tra infanzia ed età adulta, catturando visioni oniriche di donne perse nei propri pensieri."
    ],
    "fr": [
      "Dans ses créations picturales, Tima navigue entre les frontières subtiles de l'enfance et de l'âge adulte, capturant des visions oniriques de femmes perdues dans leurs pensées."
    ],
    "nl": [
      "In haar picturale creaties navigeert Tima over de subtiele grenzen tussen kindertijd en volwassenheid en legt ze droomachtige visioenen vast van vrouwen die verdwalen in hun eigen gedachten."
    ],
    "es": [
      "En sus creaciones pictóricas, Tima navega por las sutiles fronteras entre la infancia y la edad adulta, capturando visiones oníricas de mujeres perdidas en sus propios pensamientos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Street art de Tima - Walls & Love"
    ]
  },
