  "rdfs:comment": {
    "de": [
      "Der Wasserfall Cascade de la Beaume, ein erfrischender Spaziergang an einem spektakulären Ort!\r\nDer Wasserfall befindet sich in der Nähe des Dorfes Agizoux auf 900 m Höhe zwischen Solignac-sur-Loire und Le Brignon auf der RD 54."
    ],
    "en": [
      "The Beaume Waterfall,  A refreshing outing to a spectacular site!\r\nThe waterfall is near the village of Agizoux, at an altitude of 900 metres, between Solignac-sur-Loire and Le Brignon along the RD 54 road."
    ],
    "it": [
      "La Cascade de la Beaume, una passeggiata rinfrescante in un ambiente spettacolare!\r\nLa cascata si trova vicino al villaggio di Agizoux, ad un'altitudine di 900 metri, tra Solignac-sur-Loire e Le Brignon sulla RD 54."
    ],
    "fr": [
      "La Cascade de la Beaume, une balade rafraîchissante dans un site spectaculaire !\r\nLa cascade se situe près du village d’Agizoux, à 900 mètres d’altitude, entre Solignac-sur-Loire et le Brignon par la RD 54."
    ],
    "es": [
      "La Cascade de la Beaume, ¡un paseo refrescante en un entorno espectacular!\r\nLa cascada se encuentra cerca del pueblo de Agizoux, a 900 metros de altitud, entre Solignac-sur-Loire y Le Brignon por la RD 54."
    ],
    "nl": [
      "De Cascade de la Beaume, een verfrissende wandeling in een spectaculaire omgeving!\r\nDe waterval ligt bij het dorpje Agizoux, op 900 meter hoogte, tussen Solignac-sur-Loire en Le Brignon aan de RD 54."
    ]
  },
