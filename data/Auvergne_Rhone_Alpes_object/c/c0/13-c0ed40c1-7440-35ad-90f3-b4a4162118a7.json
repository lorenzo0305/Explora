  "rdfs:comment": {
    "de": [
      "Das Don Camillo ist eine Einladung zu einer Reise, natürlich nach Italien!\r\nIn einem happy brouhaha erwarten Sie der Chef Vito und seine \"squadra azzura\", um einen angenehmen Moment zu teilen."
    ],
    "en": [
      "The Don Camillo is an invitation to travel, in Italy of course!\r\nIt is in a happy hubbub that the chef Vito and his \"squadra azzura\" await you to share a pleasant moment."
    ],
    "it": [
      "Don Camillo è un invito al viaggio, in Italia naturalmente!\r\nÈ in un allegro baccano che lo chef Vito e la sua \"squadra azzura\" vi aspettano per condividere un momento piacevole."
    ],
    "fr": [
      "Le Don Camillo est une invitation au voyage, en Italie bien sûr ! \r\nC’est dans un happy brouhaha que le chef Vito et sa \"squadra azzura\" vous attendent pour partager un moment agréable."
    ],
    "nl": [
      "Don Camillo is een uitnodiging tot reizen, naar Italië natuurlijk!\r\nHet is in een vrolijk rumoer dat de chef Vito en zijn \"squadra azzura\" u opwachten voor een aangenaam moment."
    ],
    "es": [
      "Don Camillo es una invitación a viajar, ¡a Italia, por supuesto!\r\nEn un alegre bullicio, el chef Vito y su \"squadra azzura\" le esperan para compartir un agradable momento."
    ]
  },
