  "rdfs:comment": {
    "de": [
      "Der Fremdenverkehrsverein befindet sich im Herzen von Granier und bietet Ihnen zahlreiche Dienstleistungen in Ihrer Nähe an: Touristeninformationen / Brotverkauf / Lebensmittelgeschäft, lokale Veranstaltungen."
    ],
    "en": [
      "The tourist office is in the centre of Granier and offers a number of local services: Tourist information / Sale of bread / Groceries / Organisation of local events."
    ],
    "it": [
      "L'ufficio turistico si trova nel cuore di Granier e offre un'ampia gamma di servizi locali: informazioni turistiche / panetteria / negozio di alimentari, eventi locali."
    ],
    "fr": [
      "Le syndicat d'initiative est situé au cœur de Granier et vous propose de nombreux services de proximité : Informations touristiques / Dépôt de pains / Épicerie, animations locales."
    ],
    "es": [
      "La oficina de turismo está situada en el corazón de Granier y ofrece una amplia gama de servicios locales: información turística / panadería / tienda de comestibles, eventos locales."
    ],
    "nl": [
      "Het VVV-kantoor ligt in het hart van Granier en biedt een breed scala aan plaatselijke diensten: toeristische informatie, brood, levensmiddelen en plaatselijke evenementen."
    ]
  },
