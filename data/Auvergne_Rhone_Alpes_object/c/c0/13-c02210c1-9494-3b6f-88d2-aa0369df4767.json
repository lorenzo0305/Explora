  "rdfs:comment": {
    "de": [
      "Restaurant mit chinesischen Spezialitäten im Herzen des Hameau de Montfort in der Gemeinde Saint-Marcel. Das Gasthaus empfängt Sie in einem gemütlichen Rahmen mit einer Panoramaterrasse mit Blick auf das Massif de la Lauzière."
    ],
    "en": [
      "Chinese specialty restaurant in the heart of the hamlet of Montfort in the municipality of Saint Marcel"
    ],
    "it": [
      "Ristorante di specialità cinesi nel cuore dell'Hameau de Montfort, nel comune di Saint-Marcel. La locanda offre un'accoglienza calorosa e una terrazza panoramica con vista sul massiccio della Lauzière."
    ],
    "fr": [
      "Restaurant de spécialité chinoise au coeur du Hameau de Montfort sur la commune de Saint-Marcel. L'auberge vous accueille dans un cadre chaleureux avec une terrasse panoramique sur le massif de la Lauzière."
    ],
    "es": [
      "Restaurante de especialidades chinas en el corazón del Hameau de Montfort, en la comuna de Saint-Marcel. La posada ofrece una cálida bienvenida y una terraza panorámica con vistas al macizo de Lauzière."
    ],
    "nl": [
      "Chinees specialiteitenrestaurant in het hart van de Hameau de Montfort in de gemeente Saint-Marcel. De herberg biedt een warm welkom en een panoramisch terras met uitzicht op het Lauzière-massief."
    ]
  },
  "rdfs:label": {
    "en": [
      "Auberge de Montfort"
