  "rdfs:comment": {
    "de": [
      "Weinbauer seit 7 Generationen, erzeugt Raphaël POMMIER seine Bioweine ohne zugesetzte Sulfite mit Begeisterung. Beim Weingut besteht es die Möglichkeit, Erklärungen über Weine zu erhalten, aber auch Weine zu verkosten und zu kaufen."
    ],
    "en": [
      "An organic-certified vineyard, bearing the High Environmental Value label, and member of the French National Biodiversity Observatory.\r\nTop-quality AOC wines, with no added sulphites, to enjoy with friends, out on the terrace, at the estate's organic restaurant or while staying in our guestrooms in the summer."
    ],
    "it": [
      "Un vigneto biologico con il marchio Alto Valore Ambientale, membro dell'Osservatorio Nazionale della Biodiversità.\r\nVini AOC di qualità, senza solfiti aggiunti, da gustare con gli amici, sulla terrazza, nel ristorante biologico della tenuta o nelle nostre camere in estate"
    ],
    "fr": [
      "Un vignoble Bio, labellisé Haute Valeur environnementale, membre de l'Observatoire National de la Biodiversité.\r\nDes vins AOC qualitatifs, sans sulfites ajoutés, à déguster entre amis, en terrasse, au restaurant BIO du domaine ou nos chambres d'hôtes l'été"
    ],
    "es": [
      "Un viñedo ecológico con la etiqueta de Alto Valor Medioambiental, miembro del Observatorio Nacional de la Biodiversidad.\r\nVinos AOC de calidad, sin sulfitos añadidos, para disfrutar con los amigos, en la terraza, en el restaurante ecológico de la finca o en nuestras habitaciones en verano"
    ],
    "nl": [
      "Het hele jaard geopend van 15u tot 19u. Gesloten in het weekend en op feestdagen. Côtes du Rhône. 's Zomers dagelijks geopend."
    ]
  },
