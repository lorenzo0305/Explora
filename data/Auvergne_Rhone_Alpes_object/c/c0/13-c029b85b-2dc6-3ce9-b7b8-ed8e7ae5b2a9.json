  "rdfs:comment": {
    "de": [
      "1 Tennisplatz ermöglicht es den Anhängern dieses Sports, in einer privilegierten Umgebung in der Nähe des Camping de la Bédisse und des Flusses zu spielen."
    ],
    "en": [
      "1 tennis court gives tennis fans the chance to play in a privileged setting close to the Bédisse campsite and the river."
    ],
    "it": [
      "1 campo da tennis offre agli appassionati la possibilità di giocare in un ambiente privilegiato vicino al campeggio Bédisse e al fiume."
    ],
    "fr": [
      "1 court de Tennis permet aux adeptes de ce sport de jouer dans un cadre privilégié à proximité du camping  de la Bédisse et de la rivière."
    ],
    "nl": [
      "1 tennisbaan biedt tennisliefhebbers de kans om te spelen in een bevoorrechte omgeving dicht bij de camping Bédisse en de rivier."
    ],
    "es": [
      "1 pista de tenis ofrece a los aficionados la posibilidad de jugar en un entorno privilegiado, cerca del camping Bédisse y del río."
    ]
  },
