  "rdfs:comment": {
    "de": [
      "Das Grand Casino de Lyon Le Pharaon liegt ideal in der Cité Internationale und in der Nähe des Parc de la Tête d'Or. Es bietet eine große Auswahl an Tischspielen, Spielautomaten und Poker."
    ],
    "en": [
      "Ideally located in the Cité Internationale and close to the Parc de la Tête d'Or, the Grand Casino de Lyon Le Pharaon offers a wide selection of table games, slot machines and poker."
    ],
    "it": [
      "Situato in posizione ideale nella Cité Internationale e vicino al Parc de la Tête d'Or, il Grand Casino de Lyon Le Pharaon offre un'ampia selezione di giochi da tavolo, slot machine e poker."
    ],
    "fr": [
      "Idéalement situé à la Cité Internationale et proche du parc de la Tête d'Or, le Grand Casino de Lyon Le Pharaon propose une large sélection de jeux de tables, machines à sous et poker."
    ],
    "es": [
      "Idealmente situado en la Cité Internationale y cerca del Parc de la Tête d'Or, el Grand Casino de Lyon Le Pharaon ofrece una amplia selección de juegos de mesa, máquinas tragaperras y póquer."
    ],
    "nl": [
      "Het Grand Casino de Lyon Le Pharaon is ideaal gelegen in de Cité Internationale en dicht bij het Parc de la Tête d'Or, en biedt een ruim aanbod aan tafelspellen, speelautomaten en poker."
    ]
