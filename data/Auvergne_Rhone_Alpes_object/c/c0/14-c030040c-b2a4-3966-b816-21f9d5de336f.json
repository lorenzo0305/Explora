  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/2b685f28-0b89-381b-9def-94596e6ad930",
      "dc:description": {
        "de": [
          "Eine schmackhafte italienische Küche mit den besten Produkten, die direkt aus Italien kommen: Wurstwaren, Käse und Olivenöl... Nathalies Spezialitäten: Aperitifbretter, Focaccia, Lasagne, Spargelrisotto und Tiramisu in tausend Variationen..."
        ],
        "en": [
          "Tasty Italian cuisine based on the finest products direct from Italy: cold meats, cheeses and olive oil... Nathalie's specialities: aperitif boards, focaccia, lasagne, asparagus risotto and tiramisu in a thousand variations..."
        ],
        "it": [
          "Gustosa cucina italiana con i migliori prodotti direttamente dall'Italia: salumi, formaggi e olio d'oliva... Le specialità di Nathalie: taglieri di aperitivi, focacce, lasagne, risotto agli asparagi e tiramisù in mille varianti..."
        ],
        "fr": [
          "Une cuisine italienne savoureuse à base des meilleurs produits venant directement d'Italie : charcuteries, fromages et huile d'olive... Les spécialités de Nathalie : les planches apéritives, les focaccia, les lasagnes, le risotto aux asperges et le tiramisu décliné de mille manières..."
        ],
        "nl": [
          "Smakelijke Italiaanse keuken met de beste producten rechtstreeks uit Italië: vleeswaren, kazen en olijfolie... Specialiteiten van Nathalie: aperitiefschotels, focaccia, lasagne, aspergerisotto en tiramisu in duizend variaties..."
        ],
        "es": [
          "Sabrosa cocina italiana con los mejores productos llegados directamente de Italia: embutidos, quesos y aceite de oliva... Especialidades de Nathalie: platos de aperitivo, focaccia, lasaña, risotto de espárragos y tiramisú en mil variaciones..."
        ]
      },
      "@type": [
        "Description"
