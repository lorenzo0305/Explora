  "rdfs:comment": {
    "de": [
      "Das Restaurant La Cachette* versteckt sich im Viertel der Altstadt. Der Chefkoch Masashi Ijichi, der aus dem Süden Japans stammt, bietet hier seither raffinierte, überraschende Gerichte an, die immer im Einklang mit den Jahreszeiten und den lokalen Produkten stehen."
    ],
    "en": [
      "The restaurant La Cachette* is tucked away in the Old Town district. Chef Masashi Ijichi, a native of southern Japan, has been offering refined, surprising dishes, always in tune with the seasons and local produce."
    ],
    "it": [
      "Il ristorante La Cachette* è nascosto nel centro storico della città. Lo chef, Masashi Ijichi, originario del sud del Giappone, propone piatti raffinati e sorprendenti, sempre in accordo con le stagioni e i prodotti locali."
    ],
    "fr": [
      "Le restaurant La Cachette* se dissimule dans le quartier de la vieille ville. Le chef, Masashi Ijichi, originaire du sud du Japon,  y propose depuis des plats raffinés, surprenants et toujours en accord avec les saisons et les produits locaux."
    ],
    "nl": [
      "Het restaurant La Cachette* is te vinden in de oude binnenstad. Chef Masashi Ijichi, afkomstig uit het zuiden van Japan, maakt verrassende, verfijnde schotels die met de seizoenen meedraaien en gebaseerd zijn op streekproducten."
    ],
    "es": [
      "El restaurante La Cachette* está escondido en el casco antiguo. El chef, Masashi Ijichi, originario del sur de Japón, ofrece platos refinados y sorprendentes, siempre de acuerdo con las estaciones y los productos locales."
    ]
  },
