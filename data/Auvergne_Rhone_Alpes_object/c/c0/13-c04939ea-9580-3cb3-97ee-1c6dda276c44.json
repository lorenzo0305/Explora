  "rdfs:comment": {
    "de": [
      "Jedes Jahr am letzten Wochenende des Monats von März bis Oktober organisiert Aurec Auto Passion monatliche Treffen von Sammlerfahrzeugen (Autos, Motorräder und Ausnahmen, die älter als 30 Jahre sind)!"
    ],
    "en": [
      "Every year, on the last weekend of the month from March to October, Aurec Auto Passion organizes monthly gatherings of classic vehicles (cars, motorcycles and exceptions over 30 years old)!"
    ],
    "it": [
      "Ogni anno, l'ultimo fine settimana del mese da marzo a ottobre, Aurec Auto Passion organizza raduni mensili di veicoli d'epoca (auto, moto ed eccezioni con più di 30 anni)!"
    ],
    "fr": [
      "Chaque année, le dernier week-end du mois de mars à octobre, Aurec Auto Passion organise des rendez-vous mensuels de véhicules de collection (autos, motos et exceptions de plus de 30 ans) !"
    ],
    "nl": [
      "Elk jaar, tijdens het laatste weekend van de maand van maart tot oktober, organiseert Aurec Auto Passion maandelijkse bijeenkomsten van klassieke voertuigen (auto's, motoren en uitzonderingen van meer dan 30 jaar oud)!"
    ],
    "es": [
      "Cada año, el último fin de semana del mes, de marzo a octubre, Aurec Auto Passion organiza concentraciones mensuales de vehículos clásicos (coches, motos y excepciones de más de 30 años)"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Rassemblement de véhicules anciens"
    ]
  },
