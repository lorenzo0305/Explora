  "rdfs:comment": {
    "de": [
      "Hier finden Sie eine schicke Brasserie mit einem gastronomischen Buffet, die nur zwei Minuten vom Zentrum von Bourgoin-Jallieu entfernt liegt.\r\nFür jeden Anlass können Sie die Tür der Brasserie du Domaine des Séquoïas aufstoßen und sich mit uns auf einen außergewöhnlichen Moment freuen."
    ],
    "en": [
      "Discover a chic brasserie with a gourmet buffet just 2 minutes from the center of Bourgoin-Jallieu.\r\nFor any occasion, come and push open the door of the Brasserie du Domaine des Séquoïas and join us for an exceptional moment."
    ],
    "it": [
      "Godetevi una brasserie chic con buffet gourmet a soli 2 minuti dal centro di Bourgoin-Jallieu.\r\nPer qualsiasi occasione, venite a spalancare la porta della Brasserie du Domaine des Séquoïas e unitevi a noi per un momento eccezionale."
    ],
    "fr": [
      "Retrouvez la brasserie chic avec un buffet gastronique située à 2 minutes du centre de Bourgoin-Jallieu.\r\nPour toute occasion, venez pousser la porte de la Brasserie du Domaine des Séquoïas et rejoignez-nous pour un moment d’exception."
    ],
    "nl": [
      "Geniet van een chique brasserie met een gastronomisch buffet op slechts 2 minuten van het centrum van Bourgoin-Jallieu.\r\nKom voor elke gelegenheid de deur van de Brasserie du Domaine des Séquoïas openduwen en kom bij ons voor een uitzonderlijk moment."
    ],
    "es": [
      "Disfrute de una brasserie chic con buffet gastronómico a 2 minutos del centro de Bourgoin-Jallieu.\r\nPara cualquier ocasión, venga a empujar la puerta de la Brasserie du Domaine des Séquoïas y únase a nosotros para disfrutar de un momento excepcional."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Brasserie du Domaine des Séquoïas"
    ]
  },
