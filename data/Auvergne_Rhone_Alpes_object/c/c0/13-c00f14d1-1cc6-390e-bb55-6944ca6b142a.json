  "rdfs:comment": {
    "de": [
      "Bei den französischen Meisterschaften für Behindertensportler treten unsere Sportler in den Disziplinen Biathlon und Skilanglauf an. Ein nationales Treffen, bei dem die französische Elite der paralympischen Disziplinen zusammenkommt."
    ],
    "en": [
      "Meet our competitors in biathlon and cross-country skiing events at the French Handisport Championships. A national event bringing together the French elite in Paralympic disciplines."
    ],
    "it": [
      "Incontrate i nostri concorrenti nelle gare di biathlon e sci di fondo di questi campionati francesi per disabili. Un evento nazionale che riunisce l'élite francese delle discipline paralimpiche."
    ],
    "fr": [
      "Retrouvez nos compétiteurs sur des épreuves de biathlon et de ski de fond lors de ces championnats de France handisport. Un rendez-vous national réunissant l'élite française des disciplines paralympiques."
    ],
    "nl": [
      "Ontmoet onze deelnemers aan de onderdelen biatlon en langlaufen tijdens deze Franse kampioenschappen voor gehandicapten. Een nationaal evenement dat de Franse elite in Paralympische disciplines samenbrengt."
    ],
    "es": [
      "Conozca a nuestros competidores en las pruebas de biatlón y esquí de fondo de estos campeonatos franceses para discapacitados. Un acontecimiento nacional que reúne a la élite francesa de las disciplinas paralímpicas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Championnat de France de paraski nordique"
    ]
  },
