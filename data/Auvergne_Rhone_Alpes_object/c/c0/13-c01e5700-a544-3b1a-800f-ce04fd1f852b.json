  "rdfs:comment": {
    "de": [
      "Hoch über Hauteville zeigt der Aussichtspunkt Curnillon die Dichte des Waldes von Cormaranche. Der Panoramablick umfasst zudem das Vaux-Moor, den Lésines-Weiher sowie die umliegenden Steinbrüche."
    ],
    "en": [
      "High above Hauteville, the Curnillon Lookout reveals the density of the Cormaranche forest. A sweeping view also reveals the Vaux marsh, the Lésines pond, as well as the surrounding stone quarries."
    ],
    "it": [
      "Sulle alture di Hauteville, il belvedere di Curnillon rivela la densità della foresta di Cormaranche. Si gode di una vista panoramica sulla palude di Vaux, sullo stagno di Lésines e sulle cave di pietra."
    ],
    "fr": [
      "Sur les hauteurs d’Hauteville, le belvédère de Curnillon révèle la densité de la forêt de Cormaranche. Une vue d’ensemble laisse apparaître le marais de Vaux, l’étang des Lésines ainsi que sur les carrières de pierre."
    ],
    "nl": [
      "Op de hoogten van Hauteville onthult het uitkijkpunt van Curnillon de dichtheid van het bos van Cormaranche. Er is een panoramisch uitzicht op het moeras van Vaux, het meer van Lésines en de steengroeven."
    ],
    "es": [
      "En las alturas de Hauteville, el mirador de Curnillon revela la densidad del bosque de Cormaranche. Hay una vista panorámica del pantano de Vaux, el estanque de Lésines y las canteras de piedra."
    ]
  },
  "rdfs:label": {
    "de": [
