  "rdfs:comment": {
    "de": [
      "Ein gemütlicher Ort, sorgfältig ausgewählte Qualitätsprodukte, vor Ort, zum Mitnehmen oder geliefert. Von der Pizza Buffala über den legendären Pepper Bacon Burger bis hin zu unseren aus Quebec importierten Spirituosen - Sie haben die Wahl!"
    ],
    "en": [
      "Winter Café: a welcoming place, quality products carefully sourced, on site, to take away or have delivered. From the Buffala Pizza to the mythical Pepper Bacon Burger, via our alcohols imported from Quebec, you’re spoilt for choice!"
    ],
    "it": [
      "Winter Café: un locale accogliente, con prodotti di qualità accuratamente selezionati da consumare nel locale, oppure per acquisti o consegne a domicilio. Dalla pizza Bufala al mitico Pepper Bacon Burger, passando dalle bevande alcoliche importate dal Quebec. A voi la scelta!"
    ],
    "fr": [
      "Un lieu chaleureux, des produits de qualité sourcés avec soin, sur place, à emporter ou livrés. De la Pizza Buffala au mythique Pepper Bacon Burger, en passant par nos alcools importés du quebec, à vous de choisir !"
    ],
    "es": [
      "Winter Café: un lugar acogedor, con productos de calidad seleccionados con esmero, listos para consumir en el propio establecimiento, para llevar o con entrega a domicilio. Nuestra carta incluye desde la Pizza Bufala hasta la mítica Pepper Bacon Burger, pasando por nuestros licores importados de Quebec."
    ],
    "nl": [
      "Winter Café: een gezellige plek, zorgvuldig gekozen kwaliteitsproducten, om ter plaatse op te eten, mee te nemen of te laten leveren. Van de pizza buffala tot de mythische pepper bacon burger, via onze alcohol ingevoerd vanuit Quebec, aan u de keuze!"
    ]
  },
