  "rdfs:comment": {
    "de": [
      "Die Umgebung ist ein wunderschönes Anwesen mit zwei Teichen, die mit Forellen, Karpfen, Weißfisch, Rotaugen, Schleien und Hechten besetzt sind.  Vor jedem Wettbewerb werden Forellen ausgesetzt."
    ],
    "en": [
      "The environment is a magnificent property with 2 ponds stocked with trout, carp, grass carp, roach, tench and pike.  We release trout before every competition."
    ],
    "it": [
      "L'ambiente è una magnifica tenuta con 2 laghetti popolati da trote, carpe, carpe erbivore, lasche, tinche e lucci.  Rilasciamo le trote prima di ogni gara."
    ],
    "fr": [
      "L’environnement est une magnifique propriété regroupant 2 étangs peuplés de truites, carpes, amour blanc, gardons, tanches et brochets.  Nous effectuons des lâchers de truites avant chaque concours."
    ],
    "es": [
      "El entorno es una magnífica finca con 2 estanques repletos de truchas, carpas, carpas herbívoras, cucarachas, tencas y lucios.  Liberamos las truchas antes de cada competición."
    ],
    "nl": [
      "De omgeving is een prachtig landgoed met 2 vijvers die gevuld zijn met forel, karper, graskarper, voorn, zeelt en snoek.  Voor elke wedstrijd laten we forellen vrij."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Étangs des Tuileries"
    ]
  },
