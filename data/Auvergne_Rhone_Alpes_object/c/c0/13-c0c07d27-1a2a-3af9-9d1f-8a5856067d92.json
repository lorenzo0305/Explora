  "rdfs:comment": {
    "de": [
      "Diese Kapelle mit ihrem untypischen Charme und ihrer untypischen Lage lädt Sie dazu ein, ganz in der Nähe den Weg zu gehen, der zum Hügel Saint-Roch führt..."
    ],
    "en": [
      "This atypically charming chapel in an atypical location invites you to take the nearby path to Saint-Roch hill..."
    ],
    "it": [
      "Questa cappella, dal fascino insolito e dalla posizione insolita, invita a percorrere il vicino sentiero che conduce alla collina di Saint-Roch..."
    ],
    "fr": [
      "Cette chapelle au charme atypique et à l'emplacement atypique vous invite à parcourir tout proche le chemin qui mène à la colline Saint-Roch..."
    ],
    "es": [
      "Esta capilla, con su inusual encanto y su insólita ubicación, le invita a tomar el sendero cercano que conduce a la colina de Saint-Roch..."
    ],
    "nl": [
      "Deze kapel, met haar ongewone charme en ongewone ligging, nodigt u uit om het nabijgelegen pad te nemen dat leidt naar de heuvel van Saint-Roch..."
    ]
  },
