  "rdfs:comment": {
    "de": [
      "Truppe Wir sind eine auf Kosaken-Kunstflug spezialisierte Pferdeshow-Truppe. Wir bieten Einführungskurse für alle Niveaus an. Kosakenkunstflug, eine anregende Disziplin für Jung und Alt!"
    ],
    "en": [
      "Troupe we are a horse show troupe specializing in Cossack aerobatics. We offer introductory courses for all levels. Cossack aerobatics, an energizing discipline for young and old!"
    ],
    "it": [
      "Spettacolo equestre e fuochi d'artificio su richiesta. Introduzione all'acrobazia cosacca, doma e riabilitazione dei cavalli, allevamento. Creazioni artigianali in crine di cavallo"
    ],
    "fr": [
      "Spectacle équestre et pyrotechnique sur devis. Initiation à la voltige cosaque, débourrage et rééducation du Cheval , élevage. Créations artisanales en crin de cheval"
    ],
    "nl": [
      "Paardenshow en vuurwerk op aanvraag. Kennismaking met Kozakkenacrobatiek, dressuur en revalidatie van paarden, fokkerij. Handgemaakte creaties van paardenhaar"
    ],
    "es": [
      "Espectáculo ecuestre y fuegos artificiales previa solicitud. Iniciación a la acrobacia cosaca, doma y rehabilitación de caballos, cría. Creaciones artesanales en crin de caballo"
    ]
  },
