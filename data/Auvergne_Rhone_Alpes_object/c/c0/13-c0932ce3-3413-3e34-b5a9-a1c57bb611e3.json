  "rdfs:comment": {
    "de": [
      "Der Zugang zur interkommunalen Mediathek ist frei, kostenlos und für alle zugänglich. Sie können vor Ort Bücher, Zeitschriften, Musik, Filme und Internet konsultieren... Eine Anmeldung ermöglicht es Ihnen, diese Dokumente auszuleihen."
    ],
    "en": [
      "The access to the intercommunal media library is free and accessible to all. You will be able to consult books, magazines, music, films, access the internet... A registration will allow you to borrow these documents."
    ],
    "it": [
      "L'accesso alla mediateca intercomunale è gratuito e accessibile a tutti. Si possono consultare libri, riviste, musica, film, accedere a Internet... Una registrazione vi permetterà di prendere in prestito questi documenti."
    ],
    "fr": [
      "L'accès à la médiathèque intercommunale est libre, gratuit et accessible à toutes et à tous. Vous pourrez consulter sur place des livres, revues, musiques, filmes, accéder à internet... Une inscription vous permettra d'emprunter ces documents."
    ],
    "es": [
      "El acceso a la mediateca intercomunal es gratuito y accesible a todos. Puede consultar libros, revistas, música, películas, acceder a Internet... Un registro le permitirá tomar prestados estos documentos."
    ],
    "nl": [
      "Bij deze mediatheek kunt u gratis documenten inlezen, muziek luisteren, multimedia documenten bekijken en gebruikmaken van internet."
    ]
  },
