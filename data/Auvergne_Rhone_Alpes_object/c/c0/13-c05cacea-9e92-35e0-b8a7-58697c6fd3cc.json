  "rdfs:comment": {
    "de": [
      "Am Fuße der Abteikirche genießen Sie eine Terrasse in einer außergewöhnlichen Umgebung. Traditionelles Restaurant mit lokalen und saisonalen Produkten. Getränke und Eis aus eigener Herstellung.\r\nMenüs für Gruppen"
    ],
    "en": [
      "At the foot of the abbey church, enjoy a terrace in an exceptional setting. Traditional restaurant using local, seasonal produce. Artisanal drinks and ice creams.\r\nMenus for groups"
    ],
    "it": [
      "Ai piedi della chiesa abbaziale, godetevi una terrazza in un ambiente eccezionale. Ristorante tradizionale con prodotti locali e di stagione. Bevande e gelati fatti in casa.\r\nMenu per gruppi"
    ],
    "fr": [
      "Au pied de l’église abbatiale, profitez d’une terrasse dans un cadre exceptionnel. Restaurant traditionnel à base de produits locaux et de saison. Boissons et glaces artisanales.\r\nMenus pour groupes"
    ],
    "nl": [
      "Geniet aan de voet van de abdijkerk van een terras in een uitzonderlijke omgeving. Traditioneel restaurant met lokale en seizoensgebonden producten. Huisgemaakte dranken en ijsjes.\r\nMenu's voor groepen"
    ],
    "es": [
      "Al pie de la iglesia abacial, disfrute de una terraza en un marco excepcional. Restaurante tradicional con productos locales y de temporada. Bebidas y helados caseros.\r\nMenús para grupos"
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Table de l'Abbaye"
    ]
  },
