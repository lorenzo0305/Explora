      "dc:description": {
        "de": [
          "Workshops für Kinder, die von einem Mediator von \"Maréis\" betreut werden. Die Anwesenheit eines Elternteils ist für Kinder bis 7 Jahre obligatorisch (darüber hinaus fakultativ)."
        ],
        "en": [
          "Workshops for children, supervised by a \"Maréis\" mediator. A parent must be present for children up to 7 years of age (optional for older children)."
        ],
        "it": [
          "Laboratori per bambini, supervisionati da un mediatore \"Maréis\". Per i bambini fino a 7 anni è necessaria la presenza di un genitore (facoltativo per i bambini sopra i 7 anni)."
        ],
        "fr": [
          "Ateliers pour enfants, encadrés par un médiateur de \"Maréis\". La présence d’un parent est obligatoire pour les enfants jusqu’à 7 ans (facultatif au-delà)."
        ],
        "nl": [
          "Workshops voor kinderen, begeleid door een \"Maréis\"-mediator. Voor kinderen tot 7 jaar moet een ouder aanwezig zijn (optioneel voor kinderen ouder dan 7 jaar)."
        ],
        "es": [
          "Talleres para niños, supervisados por un mediador \"Maréis\". Los niños de hasta 7 años deben ir acompañados de uno de sus padres (opcional para los mayores de 7 años)."
        ]
      },
