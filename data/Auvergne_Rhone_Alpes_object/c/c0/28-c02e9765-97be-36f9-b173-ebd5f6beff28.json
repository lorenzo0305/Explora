  "rdfs:comment": {
    "de": [
      "In Fourmies befindet sich das Museum für Textilien und soziales Leben in einer Spinnerei aus dem Jahr 1863. Es beherbergt eine der größten Sammlungen von funktionstüchtigen Textilmaschinen in Europa. Rekonstruktionen und Manipulationen lassen Sie in die Welt der Arbeiter eintauchen."
    ],
    "en": [
      "In Fourmies, the museum of textile and social life is located in a spinning mill dating from 1863. It houses one of the most important collections of textile machines in working order in Europe. Reconstitutions and manipulations plunge you into the heart of the working world."
    ],
    "it": [
      "A Fourmies, il Museo del Tessuto e della Vita Sociale è ospitato in una filanda del 1863. Ospita una delle più grandi collezioni di macchine tessili funzionanti in Europa. Ricostruzioni e manipolazioni vi porteranno nel cuore del mondo del lavoro."
    ],
    "fr": [
      "A Fourmies, le musée du textile et de la vie sociale se déploie dans une filature de 1863. Il abrite une des plus importantes collections de machines textiles en état de marche, en Europe. Reconstitutions et manipulations vous plongent au cœur du monde ouvrier."
    ],
    "nl": [
      "In Fourmies is het Textiel- en Sociaal Museum gevestigd in een spinnerij uit 1863. Het herbergt een van de grootste collecties werkende textielmachines in Europa. Reconstructies en manipulaties nemen u mee naar het hart van de werkende wereld."
    ],
    "es": [
      "En Fourmies, el Museo Textil y de la Vida Social está instalado en una hilandería de 1863. Alberga una de las mayores colecciones de máquinas textiles en funcionamiento de Europa. Reconstrucciones y manipulaciones le llevarán al corazón del mundo laboral."
    ]
  },
  "rdfs:label": {
    "fr": [
