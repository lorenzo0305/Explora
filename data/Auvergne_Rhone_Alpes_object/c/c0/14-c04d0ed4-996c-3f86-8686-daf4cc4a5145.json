  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/81d44301-12af-3dda-ab35-13a0fab5c014",
      "dc:description": {
        "de": [
          "Wir treffen uns um 16 Uhr auf dem Vorplatz des alten Gerichtsgebäudes. Jean-Patrice Matysiak führt uns mitten in die Stadt, um einige Straßen von Carvin mit einem einzigartigen Blick zu entdecken, der mit historischen und skurrilen Anekdoten gespickt ist ..."
        ],
        "en": [
          "Meet in front of the old courthouse at 4 p.m. Jean-Patrice Matysiak takes us into the heart of the city to discover some of Carvin's streets with a singular eye, punctuated by historical and colourful anecdotes..."
        ],
        "it": [
          "Appuntamento davanti al vecchio tribunale alle ore 16.00. Jean-Patrice Matysiak ci condurrà nel cuore della città per scoprire alcune strade di Carvin con una prospettiva unica, punteggiata da aneddoti storici e colorati..."
        ],
        "fr": [
          "Rendez-vous sur le parvis de l'ancien Tribunal à 16 h. Jean-Patrice Matysiak nous emmène en pleine ville pour découvrir quelques rues de Carvin avec un regard singulier ponctué d'anecdotes historiques et truculentes ..."
        ],
        "nl": [
          "Verzamelen voor het oude gerechtsgebouw om 16.00 uur. Jean-Patrice Matysiak neemt ons mee naar het hart van de stad om enkele straten van Carvin te ontdekken vanuit een uniek perspectief, doorspekt met historische en kleurrijke anekdotes..."
        ],
        "es": [
          "Encuentro frente al antiguo palacio de justicia a las 16:00. Jean-Patrice Matysiak nos llevará al corazón de la ciudad para descubrir algunas calles de Carvin con una perspectiva única, salpicada de anécdotas históricas y pintorescas...."
        ]
      },
