  "rdfs:comment": {
    "de": [
      "La Tour d'Auvergne beginnt nach und nach mit der Aufwertung des Dorfkerns.\r\nEinwohner und gewählte Vertreter dokumentieren ihr Kulturerbe."
    ],
    "en": [
      "La Tour d?Auvergne is gradually upgrading the village center.\r\nResidents and elected officials document their heritage."
    ],
    "it": [
      "La Tour d'Auvergne sta gradualmente valorizzando il centro del paese.\r\nI residenti e i rappresentanti eletti stanno documentando il loro patrimonio."
    ],
    "fr": [
      "La Tour d’Auvergne entreprend peu à peu la valorisation du centre du village.\r\nHabitants et élus documentent leurs patrimoines."
    ],
    "nl": [
      "La Tour d'Auvergne is het dorpscentrum geleidelijk aan het opwaarderen.\r\nBewoners en gekozen vertegenwoordigers documenteren hun erfgoed."
    ],
    "es": [
      "La Tour d'Auvergne está revalorizando poco a poco el centro del pueblo.\r\nSus habitantes y representantes electos documentan su patrimonio."
    ]
  },
