  "rdfs:comment": {
    "de": [
      "Jeden Sommer empfängt Sie Xtram auf seinem 8000 m² großen Gelände, um Paintball inmitten des Waldes und in einer entdeckungsfreudigen, kinderfreundlichen Atmosphäre zu praktizieren."
    ],
    "en": [
      "Every summer Xtram welcomes you on its 8000 m² of land to practice paintball in the middle of the forest."
    ],
    "it": [
      "Ogni estate Xtram vi dà il benvenuto sui suoi 8000 m² di terreno per praticare paintball in mezzo alla foresta."
    ],
    "fr": [
      "Tous les étés, Xtram vous accueille sur son terrain de 8000 m² pour pratiquer le paintball en pleine forêt et dans une ambiance découverte, bon enfant."
    ],
    "nl": [
      "Verwelkomt Xtram u elke zomer op zijn 8000 m² grote terrein om paintball te oefenen midden in het bos en in een vriendelijke sfeer."
    ],
    "es": [
      "Todos los veranos, Xtram le da la bienvenida a su campo de paintball de 8.000 m², donde podrá jugar al paintball en el corazón del bosque en un ambiente cordial y abierto."
    ]
  },
