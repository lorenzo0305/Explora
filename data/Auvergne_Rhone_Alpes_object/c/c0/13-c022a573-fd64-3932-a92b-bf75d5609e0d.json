  "rdfs:comment": {
    "de": [
      "Eine Naturblase in unmittelbarer Nähe des Stadtzentrums. Von den Jüngsten bis zu den Ältesten ist dieser Pfad der ideale Ort für einen generationenübergreifenden Spaziergang. Das Wasser und die Natur bilden eine gute Verbindung für einen ruhigen Spaziergang."
    ],
    "en": [
      "A bubble of nature just a stone's throw from the town center, this trail is the ideal place for an intergenerational stroll. Water and nature go hand in hand for a peaceful stroll."
    ],
    "it": [
      "Una bolla di natura a due passi dal centro città, questo sentiero è il luogo ideale per una passeggiata intergenerazionale. Acqua e natura vanno di pari passo per una passeggiata tranquilla."
    ],
    "fr": [
      "Une bulle de nature à deux pas du centre-ville, du plus jeune au plus ancien ce sentier est le lieu idéal pour une balade intergénérationnel. L’eau et la nature font bon ménage pour une promenade au calme."
    ],
    "es": [
      "Una burbuja de naturaleza a tiro de piedra del centro de la ciudad, este sendero es el lugar ideal para un paseo intergeneracional. Agua y naturaleza se dan la mano para un paseo tranquilo."
    ],
    "nl": [
      "Op een steenworp afstand van het stadscentrum ligt dit natuurparcours, de ideale plek voor een generatieoverschrijdende wandeling. Water en natuur gaan hand in hand voor een rustige wandeling."
    ]
  },
  "rdfs:label": {
    "de": [
      "Komfortabler Spaziergang - Freizeitgebiet La Combe"
    ],
    "en": [
      "Promenade confort - Zone de loisirs de la Combe"
    ],
    "it": [
      "Passeggiata confortevole - Area di svago di La Combe"
    ],
    "fr": [
      "Promenade confort - Zone de loisirs de la Combe"
    ],
    "nl": [
      "Comfortwandeling - La Combe recreatiegebied"
    ]
  },
