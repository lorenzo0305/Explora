  "rdfs:comment": {
    "de": [
      "Eine große Wanderung von der Refuge du Saut aus ermöglicht es Ihnen, die Aiguille du Fruit vollständig zu umrunden.\nEs besteht die Möglichkeit, eine Nacht in der Refuge des Lacs Merlet zu verbringen."
    ],
    "en": [
      "A long hike starting from the Refuge du Saut, will allow you to do a complete tour of the Aiguille du Fruit. \nPossibility of spending a night at the Lacs Merlet refuge."
    ],
    "it": [
      "Una lunga escursione dal Refuge du Saut vi porterà fino all'Aiguille du Fruit.\nÈ anche possibile pernottare al rifugio Lacs Merlet."
    ],
    "fr": [
      "Une grande randonnée au départ du Refuge du Saut, vous permettra de faire le tour complet de l'Aiguille du fruit. \nPossibilité de faire une nuit au refuge des Lacs Merlet."
    ],
    "es": [
      "Una larga caminata desde el Refugio du Saut le llevará a rodear la Aiguille du Fruit.\nTambién puede pasar la noche en el refugio Lacs Merlet."
    ],
    "nl": [
      "Een lange wandeling die begint bij de Refuge du Saut, stelt u in staat de Aiguille du Fruit volledig te verkennen.\r\nMogelijkheid om te overnachten in de refuge Lacs Merlet."
    ]
  },
  "rdfs:label": {
    "en": [
      "S1 - Tour of the Aiguille du Fruit - from the Refuge du Saut"
    ],
    "fr": [
      "Sentier piéton - S1 - Tour de l'aiguille du fruit - depuis le Refuge du Saut"
    ],
    "nl": [
      "S1 - Tocht van de Aiguille du Fruit - vanaf de Refuge du Saut"
    ]
  },
