  "rdfs:comment": {
    "de": [
      "Traditionelles Restaurant, in dem Sie savoyische Spezialitäten und viele andere typische Gerichte à la carte finden.\r\nWir bieten auch Pizzas vor Ort oder zum Mitnehmen am Sonntagabend an (keine Karte am Sonntagabend)."
    ],
    "en": [
      "Traditional restaurant serving Savoyard specialities and many other typical dishes, à la carte.\r\nWe also offer pizzas to eat in or take away on Sunday evenings (no menu on Sunday evenings)."
    ],
    "it": [
      "Ristorante tradizionale che serve specialità savoiarde e molti altri piatti tipici, à la carte.\r\nLa domenica sera offriamo anche pizze da mangiare o da portare via (la domenica sera non c'è il menu)."
    ],
    "fr": [
      "Restaurant traditionnel où vous trouverez des spécialités savoyardes et bien d'autres plats typiques, à la carte.\r\nNous proposons également des pizzas sur place ou à emporter le dimanche soir (pas de carte le dimanche soir)."
    ],
    "nl": [
      "Traditioneel restaurant met specialiteiten uit de Savoie en vele andere typische gerechten, à la carte.\r\nWe bieden ook pizza's om te eten of om mee te nemen op zondagavond (geen menu op zondagavond)."
    ],
    "es": [
      "Restaurante tradicional que sirve especialidades saboyanas y muchos otros platos típicos, a la carta.\r\nTambién ofrecemos pizzas para comer en el restaurante o para llevar los domingos por la noche (no hay menú los domingos por la noche)."
    ]
  },
