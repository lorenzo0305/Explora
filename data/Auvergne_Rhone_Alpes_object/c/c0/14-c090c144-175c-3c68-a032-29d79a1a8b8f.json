  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/67f0f610-8996-3822-8a2a-a2cdf81f6e83",
      "dc:description": {
        "de": [
          "Die junge Küchenchefin Solène Elliott und ihr Team bieten Ihnen eine saisonale Küche, die nach Möglichkeit aus frischen und lokalen Produkten zubereitet wird. Das Menü umfasst 4 Vorspeisen, 4 Hauptgerichte und 4 Desserts."
        ],
        "en": [
          "Young chef Solène Elliott and her team offer seasonal cuisine using fresh, local produce wherever possible. The menu comprises 4 starters, 4 main courses and 4 desserts."
        ],
        "it": [
          "La giovane chef Solène Elliott e il suo team propongono una cucina stagionale realizzata, per quanto possibile, con prodotti freschi e locali. Il menu comprende 4 antipasti, 4 piatti principali e 4 dessert."
        ],
        "fr": [
          "La jeune cheffe Solène Elliott et son équipe vous proposent une cuisine de saison élaborée à partir de produits frais et locaux dans la mesure du possible. Le menu comporte 4 entrées, 4 plats et 4 desserts."
        ],
        "es": [
          "La joven chef Solène Elliott y su equipo ofrecen cocina de temporada elaborada con productos frescos y locales siempre que sea posible. El menú incluye 4 entrantes, 4 platos principales y 4 postres."
        ],
        "nl": [
          "De jonge chef-kok Solène Elliott en haar team bieden seizoensgebonden gerechten, waar mogelijk gemaakt met verse, lokale producten. Op het menu staan 4 voorgerechten, 4 hoofdgerechten en 4 desserts."
        ]
      },
