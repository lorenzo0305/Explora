  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/5495cc10-3978-3a13-ab9f-afde7d3d3e18",
      "dc:description": {
        "de": [
          "Vorplatz der Kathedrale. Terrasse. Stadtzentrum von Beauvais. Empfang von Gruppen. Private Salons, Frühstücksangebot. Selbst gereiftes Fleisch, Snacks, Eis, Tee, hausgemachtes Gebäck.\n\nAnzahl der Gedecke: 80\nEmpfang von Gruppen: 100 Personen\nLetzter Dienst: 14.30 Uhr\nAn allen Abenden der Woche geschlossen."
        ],
        "en": [
          "Cathedral square. Terrace. Downtown Beauvais. Groups welcome. Private rooms, breakfast formula. Home-cured meats, snacks, ice creams, tea, home-made pastries.\n\nNumber of covers: 80\nGroups welcome: 100 people\nLast service: 2:30 pm\nClosed every evening of the week."
        ],
        "it": [
          "Piazzale della cattedrale. Terrazza. Centro città di Beauvais. Accoglienza gruppi. Camere private, formula colazione. Salumi nostrani, snack, gelati, tè, dolci fatti in casa.\n\nNumero di coperti: 80\nGruppi: 100 persone\nUltimo servizio: 14.30\nChiuso tutte le sere della settimana."
        ],
        "fr": [
          "Parvis de la cathédrale. Terrasse. Centre-ville de Beauvais. Accueil groupes. Salons privés, formule petit déjeuner. Viande affinée par nos soins, snack, glaces, thé, pâtisseries maison.\n\nNombre de couverts : 80\nAccueil groupes : 100 personnes\nDerniers services : 14h30\nFermé tous les soirs de la semaine."
        ],
        "es": [
          "Patio de la catedral. Terraza. Centro de Beauvais. Admite grupos. Habitaciones privadas, fórmula desayuno. Embutidos, bocadillos, helados, té, bollería casera.\n\nNúmero de cubiertos: 80\nGrupos: 100 personas\nÚltimo servicio: 14.30 h\nCerrado todas las tardes de la semana."
        ],
        "nl": [
          "Kathedraal voorplein. Terras. Centrum van Beauvais. Geschikt voor groepen. Privékamers, ontbijtformule. Huisgemaakte vleeswaren, snacks, ijsjes, thee, huisgemaakt gebak.\n\nAantal couverts: 80\nGroepen: 100 personen\nLaatste dienst: 14.30 uur\nElke avond van de week gesloten."
        ]
      },
