  "rdfs:comment": {
    "de": [
      "Die zwischen Clermont-Ferrand und Vichy gelegene Domaine royal de Randan wurde ab 1821 von Louis-Philippe d'Orléans, dem späteren König der Franzosen, und seiner Schwester Adelaide gegründet. Hochburg der Romantik und der Moderne des 19."
    ],
    "en": [
      "Located between Clermont-Ferrand and Vichy, the Domaine Royal de Randan was created in 1821 by Louis-Philippe d'Orléans, future King of France, and his sister Adélaïde. A mecca for 19th-century romanticism and modernity."
    ],
    "it": [
      "Situato tra Clermont-Ferrand e Vichy, il Domaine Royal de Randan fu creato nel 1821 da Luigi Filippo d'Orléans, futuro re di Francia, e da sua sorella Adélaïde. Una mecca del romanticismo e della modernità del XIX secolo."
    ],
    "fr": [
      "Situé entre Clermont-Ferrand et Vichy, le Domaine royal de Randan a été créé à partir de 1821 par Louis-Philippe d'Orléans, futur roi des Français, et sa sœur Adélaïde. Haut lieu du romantisme et de la modernité du XIXe siècle."
    ],
    "es": [
      "Situado entre Clermont-Ferrand y Vichy, el Domaine Royal de Randan fue creado en 1821 por Luis Felipe de Orleans, futuro rey de Francia, y su hermana Adélaïde. Meca del romanticismo y la modernidad del siglo XIX."
    ],
    "nl": [
      "Het Domaine Royal de Randan, gelegen tussen Clermont-Ferrand en Vichy, werd in 1821 opgericht door Louis-Philippe d'Orléans, de toekomstige koning van Frankrijk, en zijn zus Adélaïde. Een mekka voor 19e-eeuwse romantiek en moderniteit."
    ]
  },
