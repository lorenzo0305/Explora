  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/76c90ef8-543d-386b-8475-8dfcaa19ebc0",
      "dc:description": {
        "de": [
          "Leseshow \"Dans le regard de la Madone Sixtine\" (Im Blick der Sixtinischen Madonna).\nAuszüge aus Texten von Wassili Grossman.\n\nInmitten der dunkelsten Stunden der Geschichte (von Stalin verursachte Hungersnot in der Ukraine zwischen 1932 und 1933), eine Ode an die Freude und die Hoffnung, die von den Pinselstrichen des Meisters Raffael inspiriert wurde."
        ],
        "en": [
          "Lecture-performance \"Dans le regard de la Madone Sixtine\".\nExtracts from texts by Vassili Grossman.\n\nIn the midst of history's darkest hours (the famine provoked by Stalin in Ukraine between 1932 and 1933), an ode to joy and hope inspired by the brushstrokes of the master Raphael."
        ],
        "it": [
          "Conferenza-spettacolo \"Dans le regard de la Madone Sixtine\" (Negli occhi della Madonna Sistina).\nEstratti da testi di Vassili Grossman.\n\nNel mezzo delle ore più buie della storia (la carestia provocata da Stalin in Ucraina tra il 1932 e il 1933), un inno alla gioia e alla speranza ispirato alle pennellate del maestro Raffaello."
        ],
        "fr": [
          "Lecture spectacle \"Dans le regard de la Madone Sixtine\".\nExtraits de textes de Vassili Grossman.\n\nAu coeur des heures les plus sombres de l'Histoire (famine provoquée par Staline en Ukraine entre 1932 et 1933), une ode à la joie et à l'espoir inspirée par les traits de pinceau du maître Raphaël."
        ],
        "nl": [
          "Lezing-voorstelling \"Dans le regard de la Madone Sixtine\" (In de ogen van de Sixtijnse Madonna).\nFragmenten uit teksten van Vassili Grossman.\n\nMidden in de donkerste uren van de geschiedenis (de door Stalin veroorzaakte hongersnood in Oekraïne tussen 1932 en 1933), een ode aan vreugde en hoop geïnspireerd door de penseelstreken van de meester Rafaël."
        ],
        "es": [
          "Conferencia-espectáculo \"Dans le regard de la Madone Sixtine\" (A los ojos de la Virgen Sixtina).\nExtractos de textos de Vassili Grossman.\n\nEn medio de las horas más oscuras de la historia (la hambruna provocada por Stalin en Ucrania entre 1932 y 1933), una oda a la alegría y la esperanza inspirada en las pinceladas del maestro Rafael."
        ]
      },
