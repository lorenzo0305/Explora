  "rdfs:comment": {
    "de": [
      "Multimuseen für alle: Bonbons, Nougat Handwerksfabrik, Spielwaren, Museum N7, Santons, Bär/Puppen, Automaten, Elektrozüge, lebende Bienenstöcke, Ahorn... Badaboum Indoor-Spielplatz, Mini-Gebäude, Spielplatz, Restaurant, Picknickplatz."
    ],
    "en": [
      "A range of museums with something for everyone: Sweets, homemade nougat, Toys, N7 Museum, Santons (figurines), Bears/Dolls, automatons, electric trains, a real beehive, maple, etc. Badaboum indoor play area, small farm, playground, restaurant, picnic area."
    ],
    "it": [
      "Da non perdere! la terza destinazione turistica più popolare della Drôme.\r\nDolci, fabbrica di torrone artigianale, giocattoli, museo N7, santoni, orsetti/dolls, città Lego, automi, trenini elettrici, alveare vivente..."
    ],
    "fr": [
      "Incontournable ! 3ème site touristique de la Drôme.\r\nBonbons, Fabrique artisanale de Nougat, Jouets, Musée N7, Santons, Ours/Poupées,  ville en Légo, automates, trains électriques, ruche vivante..."
    ],
    "es": [
      "No se lo pierda el 3er destino turístico más popular de la Drôme.\r\nDulces, fábrica artesanal de turrón, juguetes, Museo N7, Santons, osos/muñecos, ciudad de Lego, autómatas, trenes eléctricos, colmena viviente..."
    ],
    "nl": [
      "Multi-musea voor iedereen: Candy, Nougat ambachtelijke fabriek, Speelgoed, N7 Museum, Santons, Beren/poppen, automata, elektrische treinen, levende bijenkorf, esdoorn... Badaboum overdekte speeltuin, mini-boerderij, speeltuin, restaurant, picknickplaats."
    ]
  },
