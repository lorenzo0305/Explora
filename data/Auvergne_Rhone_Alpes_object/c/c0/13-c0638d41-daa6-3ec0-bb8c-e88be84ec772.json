  "rdfs:comment": {
    "de": [
      "Diese Veranstaltung der \"Jeunes Agriculteurs de Haute-Loire\", der Junglandwirte der Haute-Loire, soll Jung und Alt einen \"Bauernhof der Haute-Loire\" mit allem, was dazu gehört, näher bringen."
    ],
    "en": [
      "The aim of this event organized by the Jeunes Agriculteurs de Haute-Loire (Young Farmers of Haute-Loire) is to introduce young and not-so-young people to a \"farm in Haute-Loire\" and everything that goes to make it up."
    ],
    "it": [
      "L'obiettivo di questo evento organizzato dai Jeunes Agriculteurs de Haute-Loire (Giovani Agricoltori dell'Alta Loira) è quello di far conoscere a giovani e meno giovani una \"fattoria dell'Alta Loira\" e tutto ciò che la compone."
    ],
    "fr": [
      "Cette manifestation des Jeunes Agriculteurs de Haute-Loire, a pour but de faire découvrir aux jeunes, et aux moins jeunes, une « ferme de Haute-Loire » avec tout ce qui la compose."
    ],
    "nl": [
      "Het doel van dit evenement, georganiseerd door de Jeunes Agriculteurs de Haute-Loire (Jonge Landbouwers van de Haute-Loire), is om jong en oud kennis te laten maken met een \"boerderij in de Haute-Loire\" en alles wat daarbij komt kijken."
    ],
    "es": [
      "El objetivo de esta manifestación organizada por los Jóvenes Agricultores del Alto Loira es dar a conocer a grandes y pequeños una \"granja del Alto Loira\" y todo lo que la compone."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La ferme s'invite en ville"
    ]
  },
