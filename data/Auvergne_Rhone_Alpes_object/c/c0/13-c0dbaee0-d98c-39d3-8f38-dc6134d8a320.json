  "rdfs:comment": {
    "de": [
      "Ein Konzentrat aus technischen und spielerischen Abschnitten im Wald, die Sie bis zur Plaine d'Herbouilly führen, einer Hochburg des Widerstands, vorbei an der majestätischen, 226 Jahre alten Tanne Bellier, die den Namen Son Forestier\" trägt."
    ],
    "en": [
      "A concentration of technical and playful forest singles that will take you all the way to the Plaine d'Herbouilly, a Mecca of the French Resistance, passing at the foot of the majestic 226-year-old Bellier Fir, which bears the name ?Son Forestier? (Forest Sound)."
    ],
    "it": [
      "Un concentrato di singoli tecnici e divertenti nella foresta che vi porterà fino alla Plaine d'Herbouilly, mecca della Resistenza francese, passando ai piedi del maestoso abete Bellier di 226 anni, che porta il nome di \"Son Forestier\"."
    ],
    "fr": [
      "Un concentré de singles techniques et ludiques en forêt qui vous conduira jusqu’à la Plaine d’Herbouilly, haut lieu de la résistance en passant au pied du majestueux Sapin Bellier, âgé de 226 ans et qui porte le nom de “Son Forestier”."
    ],
    "es": [
      "Una concentración de singles técnicos y divertidos en el bosque que le llevará hasta la Plaine d'Herbouilly, meca de la resistencia francesa, pasando al pie del majestuoso abeto de Bellier, de 226 años, que lleva el nombre de \"Son Forestier\"."
    ],
    "nl": [
      "Een concentratie van technische en leuke singles in het bos die je helemaal naar de Plaine d'Herbouilly brengen, een mekka van het Franse verzet, langs de voet van de majestueuze 226 jaar oude Bellier-spar, die de naam \"Son Forestier\" draagt."
    ]
  },
  "rdfs:label": {
    "fr": [
      "N°48 Le Sapin Bellier VTTAE"
    ]
  },
