  "rdfs:comment": {
    "de": [
      "Entdecken Sie unseren Mineralien- und Schmuckladen, der ideal im Herzen der Stadt Vichy gelegen ist. Hier finden Sie viele moderne Formen und Inspirationen aus aller Welt!"
    ],
    "en": [
      "Come and discover our mineral and jewelry store, ideally located in the heart of the city of Vichy, you will find many modern shapes and inspirations from all over the world!"
    ],
    "it": [
      "Venite a scoprire il nostro negozio di minerali e gioielli, situato in posizione ideale nel cuore della città di Vichy, dove troverete una vasta gamma di forme moderne e ispirazioni provenienti da tutto il mondo!"
    ],
    "fr": [
      "Venez découvrir notre magasin de minéraux et bijoux, idéalement situé au cœur de la Ville de Vichy, vous trouverez beaucoup de formes et d'inspirations modernes en prévenance du monde entier!"
    ],
    "es": [
      "Venga a descubrir nuestra tienda de minerales y joyas, idealmente situada en el corazón de la ciudad de Vichy, donde encontrará una amplia gama de formas modernas e inspiraciones de todo el mundo"
    ],
    "nl": [
      "Kom en ontdek onze mineralen- en sieradenwinkel, ideaal gelegen in het hart van de stad Vichy, waar je een breed scala aan moderne vormen en inspiraties van over de hele wereld vindt!"
    ]
  },
