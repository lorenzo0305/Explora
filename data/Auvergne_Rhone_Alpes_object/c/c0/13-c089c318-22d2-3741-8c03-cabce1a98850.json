  "rdfs:comment": {
    "de": [
      "Entdecken Sie das größte Freizeitzentrum von Livradois-Forez: Spielplätze, sportliche Aktivitäten, gemeinsames Grillen, Snacks... Der Strand trägt das Gütesiegel \"Pavillon Bleu\" (Blaue Flagge)."
    ],
    "en": [
      "Come and explore the largest leisure centre in Livradois-Forez in its green setting, and participate in all sorts of activities."
    ],
    "it": [
      "Scoprite il più grande centro ricreativo della regione di Livradois-Forez: aree gioco, attività sportive, barbecue in comune, snack bar... La spiaggia è stata premiata con la Bandiera Blu."
    ],
    "fr": [
      "Découvrez la plus grande base de loisirs du Livradois-Forez : aires de jeux, activités sportives, barbecues collectifs, snack... La plage est labellisée Pavillon Bleu."
    ],
    "nl": [
      "Ontdek het grootste recreatiecentrum in de regio Livradois-Forez: speeltuinen, sportactiviteiten, gemeenschappelijke barbecues, snackbar... Het strand is bekroond met de Blauwe Vlag."
    ],
    "es": [
      "Descubra el mayor centro de ocio de la región de Livradois-Forez: zonas de juegos, actividades deportivas, barbacoas comunitarias, snack bar... La playa ha sido galardonada con la Bandera Azul."
    ]
  },
  "rdfs:label": {
    "en": [
      "Nautical and leisure center of Aubusson d'Auvergne's lake"
    ],
    "fr": [
      "Base de loisirs du Lac d'Aubusson d'Auvergne"
    ]
  },
