          "additionalInformation": {
            "de": [
              "Beaufsichtigtes Baden nur vom 20. Juni bis 31. August.\r\nJuni: Samstag von 13:30 bis 18:30 Uhr und Sonntag von 11:00 bis 19:00 Uhr.\r\nJuli / August: Montag bis Samstag von 13:30 bis 18:30 Uhr und Sonntag und Feiertage von 11:00 bis 19:00 Uhr"
            ],
            "en": [
              "Supervised swimming only from June 20 to August 31.\r\nJune: Saturday, 1:30 pm to 6:30 pm and Sunday, 11 am to 7 pm.\r\nJuly / August: Monday to Saturday, 1:30 pm to 6:30 pm and Sundays and public holidays, 11 am to 7 pm"
            ],
            "it": [
              "Nuoto solo con supervisione dal 20 giugno al 31 agosto.\r\nGiugno: sabato dalle 13.30 alle 18.30 e domenica dalle 11.00 alle 19.00.\r\nLuglio/Agosto: dal lunedì al sabato dalle 13.30 alle 18.30 e la domenica e i giorni festivi dalle 11.00 alle 19.00"
            ],
            "fr": [
              "Baignade surveillée uniquement du 20 juin au 31 aout.\r\nJuin : samedi de 13h30 à 18h30 et dimanche de 11h à 19h.\r\nJuillet / Août : du lundi au samedi, de 13h30 à 18h30 et dimanche et jours fériés, de 11h à 19h"
            ],
            "es": [
              "Natación vigilada únicamente del 20 de junio al 31 de agosto.\r\nJunio: sábados de 13.30 h a 18.30 h y domingos de 11.00 h a 19.00 h.\r\nJulio / agosto: de lunes a sábado, de 13.30 a 18.30 h y domingos y festivos, de 11.00 a 19.00 h"
            ],
            "nl": [
              "Alleen zwemmen onder toezicht van 20 juni tot 31 augustus.\r\nJuni: zaterdag van 13.30 tot 18.30 uur en zondag van 11 tot 19 uur.\r\nJuli / augustus: maandag t/m zaterdag van 13.30 tot 18.30 uur en zon- en feestdagen van 11.00 tot 19.00 uur"
            ]
          },
