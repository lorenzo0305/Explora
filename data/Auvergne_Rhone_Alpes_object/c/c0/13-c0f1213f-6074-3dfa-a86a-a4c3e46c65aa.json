  "rdfs:comment": {
    "de": [
      "Der Küchenchef Sébastien Geay empfängt Sie in seinem Restaurant, das den Fischen der Seen und Meere gewidmet ist. Seine Leidenschaft für die Schätze der Seen und Meere führte ihn zu einer privilegierten Partnerschaft mit dem renommierten Fischhändler von Evian-les-Bains."
    ],
    "en": [
      "Chef Sébastien Geay welcomes you in his restaurant dedicated to the pleasures of lakes and seas. His passion for the treasures of lakes and seas led him to establish a privileged partnership with the prestigious fishmonger of Evian-les-Bains."
    ],
    "it": [
      "Lo chef Sébastien Geay vi accoglie nel suo ristorante dedicato ai piaceri dei laghi e dei mari. La sua passione per i tesori dei laghi e dei mari lo ha portato a stabilire una partnership speciale con la prestigiosa pescheria di Evian-les-Bains."
    ],
    "fr": [
      "Le chef Sébastien Geay vous accueille dans son restaurant dédié aux plaisirs des lacs et des mers. Sa passion pour les trésors des lacs et des mers l'a conduit à établir un partenariat privilégié avec la prestigieuse poissonnerie d’Evian-les-Bains."
    ],
    "es": [
      "El Chef Sébastien Geay le da la bienvenida a su restaurante dedicado a los placeres de los lagos y los mares. Su pasión por los tesoros de los lagos y los mares le ha llevado a establecer una colaboración especial con la prestigiosa pescadería de Evian-les-Bains."
    ],
    "nl": [
      "Chef Sébastien Geay heet u welkom in zijn restaurant gewijd aan de geneugten van meren en zeeën. Zijn passie voor de schatten van de meren en zeeën heeft hem ertoe aangezet een speciaal partnerschap aan te gaan met de prestigieuze visboer van Evian-les-Bains."
    ]
  },
