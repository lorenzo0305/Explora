  "rdfs:comment": {
    "de": [
      "Unser Lokal bietet Ihnen eine köstliche traditionelle hausgemachte Küche (Hechtquenelle, Frösche in Persillade, Geflügel mit Morcheln, ...) sowie einen familiären und herzlichen Empfang."
    ],
    "en": [
      "Our restaurant offers delicious traditional home cooking (quenelle de brochet, grenouilles en persillade, volaille aux morilles,...) and a warm family welcome."
    ],
    "it": [
      "La nostra struttura offre una deliziosa cucina casalinga tradizionale (quenelle di luccio, rane in salsa di prezzemolo, pollame con spugnole,...) e una calda accoglienza familiare."
    ],
    "fr": [
      "Notre établissement vous propose une délicieuse cuisine traditionnelle maison (quenelle de brochet, grenouilles en persillade, volaille aux morilles,...) ainsi qu'un accueil familial et chaleureux."
    ],
    "nl": [
      "Ons etablissement biedt u een heerlijke traditionele keuken (quenelle van snoek, kikkers in peterseliesaus, gevogelte met morilles,...) en een warm onthaal."
    ],
    "es": [
      "Nuestro establecimiento ofrece una deliciosa cocina casera tradicional (quenelle de lucio, ranas en salsa de perejil, aves de corral con morillas,...) así como una cálida acogida familiar."
    ]
  },
  "rdfs:label": {
    "en": [
      "La Tablée Médiévale Restaurant"
    ],
    "fr": [
      "Restaurant la Tablée Médiévale"
    ]
  },
