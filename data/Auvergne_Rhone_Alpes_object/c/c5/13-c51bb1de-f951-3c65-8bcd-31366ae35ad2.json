  "rdfs:comment": {
    "de": [
      "Die Stadtbibliothek von Saint Martin d'Uriage befindet sich in den Räumlichkeiten des Belvédère.\r\nSie nimmt an zahlreichen Veranstaltungen und Workshops teil, die mit dem Programm des Belvédère in Verbindung stehen oder in Partnerschaft mit lokalen Vereinen durchgeführt werden."
    ],
    "en": [
      "The Saint Martin d'Uriage Municipal Library service is located on the Belvedere premises.\r\nIt takes part in many events linked to the Belvedere's programme or in partnership with local associations."
    ],
    "it": [
      "La biblioteca comunale di Saint Martin d'Uriage si trova nei locali di Belvédère.\r\nPartecipa a un'ampia gamma di eventi e laboratori legati al programma Belvédère o in collaborazione con associazioni locali."
    ],
    "fr": [
      "Le service de Bibliothèque municipale de Saint Martin d’Uriage est situé dans les locaux du Belvédère.\r\nIl participe à de nombreuses animations et ateliers en lien avec la programmation du Belvédère ou en partenariat avec des associations locales."
    ],
    "es": [
      "La biblioteca municipal de Saint Martin d'Uriage se encuentra en los locales de Belvédère.\r\nParticipa en numerosos actos y talleres relacionados con el programa Belvédère o en colaboración con asociaciones locales."
    ],
    "nl": [
      "De gemeentelijke bibliotheek van Saint Martin d'Uriage is gevestigd in de gebouwen van Belvédère.\r\nZe neemt deel aan een hele reeks evenementen en workshops in het kader van het Belvédère-programma of in partnerschap met lokale verenigingen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Médiathèque de Saint-Martin-d'Uriage"
    ]
  },
