  "rdfs:comment": {
    "de": [
      "Über 30 Jahre lang haben Isabelle und Jean-Conrad Lemaître eine außergewöhnliche Sammlung von Videokunst aufgebaut, die zu den bedeutendsten in Privatbesitz befindlichen Sammlungen in Frankreich gehört."
    ],
    "en": [
      "For over 30 years, Isabelle and Jean-Conrad Lemaître have built up an exceptional collection of video art, one of the largest in private hands in France."
    ],
    "it": [
      "Per oltre 30 anni, Isabelle e Jean-Conrad Lemaître hanno costruito una collezione eccezionale di videoarte, una delle più grandi in mani private in Francia."
    ],
    "fr": [
      "Pendant plus de 30 ans, Isabelle et Jean-Conrad Lemaître ont constitué une collection exceptionnelle d'art vidéo, l’une des plus importantes en mains privées en France."
    ],
    "es": [
      "Desde hace más de 30 años, Isabelle y Jean-Conrad Lemaître han reunido una excepcional colección de videoarte, una de las más importantes de Francia en manos privadas."
    ],
    "nl": [
      "Al meer dan 30 jaar hebben Isabelle en Jean-Conrad Lemaître een uitzonderlijke collectie videokunst opgebouwd, een van de grootste in privébezit in Frankrijk."
    ]
  },
  "rdfs:label": {
