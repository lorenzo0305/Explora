  "rdfs:comment": {
    "de": [
      "Mit Blick auf das Mont-Blanc-Massiv und im Hyperzentrum von Chamonix gelegen, bietet Ihnen La Folie Douce Hotels einen maßgeschneiderten Aufenthalt, der für jeden Geschmack, jede Lust und jede Jahreszeit geeignet ist."
    ],
    "en": [
      "Facing the Mont Blanc massif, located in the heart of Chamonix, La Folie Douce Hotels offers you a tailor-made stay, adapted to all tastes, all desires and all seasons."
    ],
    "it": [
      "Di fronte al massiccio del Monte Bianco, nel cuore di Chamonix, La Folie Douce Hotels offre un soggiorno su misura, adatto a tutti i gusti, a tutti i desideri e a tutte le stagioni."
    ],
    "fr": [
      "Face au massif du Mont-Blanc, situé dans l’hypercentre de Chamonix, La Folie Douce Hotels vous propose un séjour sur mesure, adapté à tous les goûts, toutes les envies et toutes les saisons."
    ],
    "nl": [
      "Met uitzicht op het Mont Blanc-massief, gelegen in het hart van Chamonix, biedt La Folie Douce Hotels een verblijf op maat, aangepast aan alle smaken, alle wensen en alle seizoenen."
    ],
    "es": [
      "Frente al macizo del Mont Blanc, situado en el corazón de Chamonix, La Folie Douce Hotels ofrece una estancia a medida, adaptada a todos los gustos, a todos los deseos y a todas las estaciones."
    ]
  },
