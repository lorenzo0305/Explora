  "rdfs:comment": {
    "de": [
      "Tauchen Sie bei Les Ateliers Grenadine et Menthe à l'Eau in die fesselnde Welt der Fäden und Nadeln ein.\r\nEntdecken Sie die Kunst des Strickens, Häkelns und Stickens in einer warmen und kreativen Atmosphäre."
    ],
    "en": [
      "Immerse yourself in the captivating world of yarn and needles at Les Ateliers Grenadine et Menthe à l'Eau.\r\nDiscover the art of knitting, crochet and embroidery in a warm and creative atmosphere."
    ],
    "it": [
      "Immergetevi nell'affascinante mondo dei filati e dei ferri presso Les Ateliers Grenadine et Menthe à l'Eau.\r\nScoprite l'arte della maglia, dell'uncinetto e del ricamo in un'atmosfera calda e creativa."
    ],
    "fr": [
      "Plongez dans l'univers captivant des fils et des aiguilles chez Les Ateliers Grenadine et Menthe à l'Eau. \r\nDécouvrez l'art du tricot, du crochet et de la broderie dans une ambiance chaleureuse et créative."
    ],
    "es": [
      "Sumérjase en el cautivador mundo del hilo y las agujas en Les Ateliers Grenadine et Menthe à l'Eau.\r\nDescubra el arte del punto, el ganchillo y el bordado en un ambiente cálido y creativo."
    ],
    "nl": [
      "Dompel jezelf onder in de fascinerende wereld van garen en naalden bij Les Ateliers Grenadine et Menthe à l'Eau.\r\nOntdek de kunst van het breien, haken en borduren in een warme en creatieve sfeer."
    ]
  },
  "rdfs:label": {
