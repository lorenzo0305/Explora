  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/5e25292d-58e8-3002-ba6c-3455129d2006",
      "dc:description": {
        "de": [
          "Mc Donald's ist eine große, international bekannte Fast-Food-Restaurantkette, die Groß und Klein in einer freundlichen Atmosphäre empfängt. Jedes Restaurant verfügt über eine Klimaanlage, WIFI-Zugang und einen Kinderspielplatz."
        ],
        "en": [
          "Large chain of restaurants - Fast Food of international renown, Mc Donald's welcomes young and old in a friendly atmosphere. Each restaurant has air conditioning, WIFI access, children's playground."
        ],
        "it": [
          "Grande catena di fast food di fama internazionale, McDonald's accoglie giovani e meno giovani in un'atmosfera amichevole. Ogni ristorante dispone di aria condizionata, accesso WIFI e parco giochi per bambini."
        ],
        "fr": [
          "Grande chaîne de restaurants - Fast Food de renommée Internationale, Mc Donald's accueille petits et grands dans une ambiance conviviale. Chaque restaurant possède climatisation, accès WIFI, aire de jeux pour enfants."
        ],
        "es": [
          "McDonald's, una gran cadena de restaurantes de comida rápida de renombre internacional, acoge a jóvenes y mayores en un ambiente agradable. Todos los restaurantes tienen aire acondicionado, acceso a WIFI y un parque infantil."
        ],
        "nl": [
          "McDonald's, een grote keten van internationaal bekende fastfoodrestaurants, verwelkomt jong en oud in een vriendelijke sfeer. Elk restaurant heeft airconditioning, WIFI en een kinderspeelplaats."
        ]
      },
