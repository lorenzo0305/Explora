  "rdfs:comment": {
    "de": [
      "Kommen Sie und malen Sie das Thema Ihrer Wahl auf ein Holzobjekt und nehmen Sie ein einzigartiges Stück mit nach Hause, das Schritt für Schritt in einer freundlichen Atmosphäre hergestellt wurde."
    ],
    "en": [
      "Come and paint the subject of your choice on a wooden object and leave with a unique piece, created step by step in a friendly atmosphere."
    ],
    "it": [
      "Venite a dipingere un soggetto a vostra scelta su un oggetto di legno e lasciate un pezzo unico, creato passo dopo passo in un'atmosfera amichevole."
    ],
    "fr": [
      "Venez peindre le sujet de votre choix sur un objet en bois et repartez avec une pièce unique, réalisée pas à pas dans une ambiance conviviale."
    ],
    "es": [
      "Venga a pintar el tema de su elección sobre un objeto de madera y salga con una pieza única, creada paso a paso en un ambiente agradable."
    ],
    "nl": [
      "Kom het onderwerp van je keuze schilderen op een houten voorwerp en vertrek met een uniek stuk, stap voor stap gemaakt in een gezellige sfeer."
    ]
  },
  "rdfs:label": {
    "fr": [
