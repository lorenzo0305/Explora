  "rdfs:comment": {
    "de": [
      "Taxis Bournier Serre-Barret, Taxis de Peyrins, AB Taxis, Rs Taxi, Taxi Marsannais, Taxi Tom schließen sich zusammen, um Ihnen besser dienen zu können.\r\n\r\nWir stehen Ihnen für alle Ihre Fahrten in der Region Romanaise und der Region Montélimar zur Verfügung."
    ],
    "en": [
      "Cabs Bournier Serre-Barret, Taxis de Peyrins, AB Taxis, Rs Taxi, Taxi Marsannais, Taxi Tom join forces to serve you better.\r\n\r\nWe are at your disposal for all your travel needs in the Romanaise and Montélimar regions."
    ],
    "it": [
      "Taxis Bournier Serre-Barret, Taxis de Peyrins, AB Taxis, Rs Taxi, Taxi Marsannais, Taxi Tom si sono uniti per servirvi meglio.\r\n\r\nSiamo a vostra disposizione per tutti i vostri spostamenti nelle regioni Romanaise e Montélimar."
    ],
    "fr": [
      "Taxis Bournier Serre-Barret, Taxis de Peyrins, AB Taxis, Rs Taxi, Taxi Marsannais, Taxi Tom se réunissent pour mieux vous servir.\r\n\r\nNous sommes à votre disposition pour tous vos déplacements sur la région Romanaise et la régions de Montélimar."
    ],
    "es": [
      "Taxis Bournier Serre-Barret, Taxis de Peyrins, AB Taxis, Rs Taxi, Taxi Marsannais, Taxi Tom se han unido para servirle mejor.\r\n\r\nEstamos a su disposición para todos sus viajes en las regiones de Romanaise y Montélimar."
    ],
    "nl": [
      "Taxis Bournier Serre-Barret, Taxis de Peyrins, AB Taxis, Rs Taxi, Taxi Marsannais, Taxi Tom hebben hun krachten gebundeld om je beter van dienst te kunnen zijn.\r\n\r\nWij staan tot uw beschikking voor al uw reisbehoeften in de regio Romanaise en Montélimar."
    ]
  },
