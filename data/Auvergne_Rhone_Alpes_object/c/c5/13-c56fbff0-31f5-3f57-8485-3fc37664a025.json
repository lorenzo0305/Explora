  "rdfs:comment": {
    "de": [
      "Dies ist ein festlicher Komplex am oberen Rand des Dorfes La Clusaz. Bar, Terrasse, Restaurant und Privatclub. Wir heißen unsere Gäste das ganze Jahr über willkommen, ab 16 Uhr zum Aperitif, gefolgt von einem Gourmet-Dinner, bevor die Feierlichkeiten bis zum Morgengrauen fortgesetzt werden."
    ],
    "en": [
      "It's a festive complex at the top of the village of La Clusaz. Bar, terrace, restaurant and private club, we welcome our guests all year round, from 4pm for an aperitif, followed by a gourmet dinner, before continuing the festivities until dawn."
    ],
    "it": [
      "Si tratta di un complesso festivo in cima al villaggio di La Clusaz. Con un bar, una terrazza, un ristorante e un club privato, accogliamo i nostri ospiti tutto l'anno, dalle 16:00 per un aperitivo, seguito da una cena gourmet, per poi continuare i festeggiamenti fino all'alba."
    ],
    "fr": [
      "C'est un complexe festif, sur le haut du village de la Clusaz. Bar, terrasse, restaurant et club privé, nous accueillons nos clients toute l'année, dès 16h pour l'apéritif, suivi d'un dîner gourmand, avant de poursuivre les festivités jusqu'à l'aube."
    ],
    "es": [
      "Se trata de un complejo festivo en lo alto del pueblo de La Clusaz. Con bar, terraza, restaurante y club privado, recibimos a nuestros huéspedes todo el año, a partir de las 16 h para un aperitivo, seguido de una cena gastronómica, antes de continuar la fiesta hasta el amanecer."
    ],
    "nl": [
      "Dit is een feestelijk complex aan de top van het dorp La Clusaz. Bar, terras, restaurant en privéclub, we verwelkomen onze gasten het hele jaar door, vanaf 16.00 uur voor een aperitief, gevolgd door een gastronomisch diner, om daarna door te gaan met de festiviteiten tot het ochtendgloren."
    ]
  },
