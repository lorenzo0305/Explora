  "rdfs:comment": {
    "de": [
      "In diesem wunderschönen und wilden Abschnitt des Flusses Allier hat die AAPPMA von Moulins einen innovativen Parcours mit dem Titel Parcours randofishing geschaffen, der über das Label Parcours Passion verfügt."
    ],
    "en": [
      "On this wild and beautiful stretch of the Allier River, Moulins AAPPMA has created an innovative course called Parcours randofishing, which has been awarded the Parcours Passion label."
    ],
    "it": [
      "Su questo magnifico e selvaggio tratto del fiume Allier, Moulins AAPPMA ha creato un percorso innovativo chiamato Parcours Randofishing, che ha ottenuto il marchio Parcours Passion."
    ],
    "fr": [
      "Sur ce secteur magnifique et sauvage de la rivière Allier, l’AAPPMA de Moulins a créé un parcours novateur intitulé Parcours randofishing disposant du label Parcours Passion."
    ],
    "nl": [
      "Op dit prachtige, wilde stuk van de rivier de Allier heeft Moulins AAPPMA een innovatief parcours aangelegd met de naam Parcours Randofishing, dat het label Parcours Passion heeft gekregen."
    ],
    "es": [
      "En este magnífico y salvaje tramo del río Allier, Moulins AAPPMA ha creado un recorrido innovador llamado Parcours Randofishing, que ha obtenido la etiqueta Parcours Passion."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parcours rando-fishing entre Moulins et Bressolles"
    ]
  },
