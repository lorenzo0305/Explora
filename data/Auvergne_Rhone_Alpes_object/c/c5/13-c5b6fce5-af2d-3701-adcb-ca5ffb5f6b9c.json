  "rdfs:comment": {
    "de": [
      "Lassen Sie sich von der nüchternen Fassade nicht täuschen: Das Innere der sogenannten Kapelle des Grünen Kreuzes ist ein wahres Juwel mit reichen, farbenfrohen Malereien..."
    ],
    "en": [
      "Don't be fooled by its sober façade: the interior of the chapel known as the Chapel of the Green Cross is a real gem with rich and colourful paintings..."
    ],
    "it": [
      "Non lasciatevi ingannare dalla sobrietà della facciata: l'interno della cappella nota come Croce Verde è un vero gioiello con dipinti riccamente colorati..."
    ],
    "fr": [
      "Ne vous fiez pas à sa façade sobre : l'intérieur de la chapelle dite de la Croix Verte est un véritable joyaux aux riches peintures colorées..."
    ],
    "es": [
      "No se deje engañar por su sobria fachada: el interior de la capilla conocida como la Cruz Verde es una verdadera joya con pinturas ricamente coloreadas..."
    ],
    "nl": [
      "Laat u niet misleiden door de sobere gevel: het interieur van de kapel die bekend staat als het Groene Kruis is een waar juweeltje met rijkelijk gekleurde schilderingen..."
    ]
  },
  "rdfs:label": {
