  "rdfs:comment": {
    "de": [
      "Wenn Sie die Tür des Parks des gestiefelten Katers öffnen, werden Sie zu einem Abenteurer, der in einer wunderbaren Gegend im Land der Bestie von Gévaudan eine Fülle von Freizeitaktivitäten und Animationen bietet."
    ],
    "en": [
      "Pushing open the door of the Parc du Chat Botté is to become an adventurer in a concentrate of leisure activities and entertainment in a marvellous site in the land of the Beast of Gévaudan."
    ],
    "it": [
      "Spalancare la porta del Parc du Chat Botté è come diventare un avventuriero, con un concentrato di attività ed eventi per il tempo libero in una cornice meravigliosa nella terra della Bestia di Gévaudan."
    ],
    "fr": [
      "Pousser la porte du parc du Chat Botté c’est devenir un aventurier autour d’un concentré de loisirs et d’animations dans un site merveilleux au pays de la bête du Gévaudan."
    ],
    "nl": [
      "De deur van het Parc du Chat Botté openduwen is als een avonturier worden, met een concentratie van vrijetijdsactiviteiten en evenementen in een prachtige omgeving in het land van het Beest van Gévaudan."
    ],
    "es": [
      "Abrir la puerta del Parc du Chat Botté es como convertirse en un aventurero, con una concentración de actividades de ocio y eventos en un entorno maravilloso en la tierra de la Bestia de Gévaudan."
    ]
  },
