  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/1b0cd94d-415e-3520-b615-48704b044105",
      "dc:description": {
        "de": [
          "Sprechstunde nach Terminvereinbarung mit den Ärzten Schaeffer & Devred.\nGeöffnet montags bis freitags von 8:30 bis 12:30 Uhr und von 14:00 bis 19:00 Uhr.\nSamstags von 8:30 bis 12:30 Uhr und von 14:00 bis 17:00 Uhr geöffnet."
        ],
        "en": [
          "Consultation by appointment with Doctors Schaeffer & Devred.\nOpen Monday to Friday, 8:30am to 12:30pm and 2pm to 7pm.\nOpen Saturday 8.30am to 12.30pm and 2pm to 5pm."
        ],
        "it": [
          "Consultazione su appuntamento con i dottori Schaeffer e Devred.\nAperto dal lunedì al venerdì dalle 8.30 alle 12.30 e dalle 14.00 alle 19.00.\nIl sabato è aperto dalle 8.30 alle 12.30 e dalle 14.00 alle 17.00."
        ],
        "fr": [
          "Consultation sur rendez-vous avec les Docteurs Schaeffer & Devred.\nOuvert du lundi au vendredi de 8h30 à 12h30 et de 14h à 19h.\nOuvert le samedi de 8h30 à 12h30 et de 14h à 17h."
        ],
        "es": [
          "Consulta previa cita con los Dres. Schaeffer y Devred.\nAbierto de lunes a viernes de 8.30 a 12.30 y de 14 a 19 h.\nAbierto los sábados de 8.30 a 12.30 y de 14 a 17 h."
        ],
        "nl": [
          "Consult op afspraak met Drs. Schaeffer & Devred.\nGeopend van maandag tot vrijdag van 8.30 tot 12.30 uur en van 14.00 tot 19.00 uur.\nGeopend op zaterdag van 8.30 tot 12.30 uur en van 14.00 tot 17.00 uur."
        ]
      },
      "@type": [
        "Description"
