  "rdfs:comment": {
    "de": [
      "10? Ausgabe. Ein symbolischer Meilenstein für diese Veranstaltung, die sich zu einem der wichtigsten Treffpunkte für Reggae, Rap, World und Dub in Frankreich entwickelt hat. Donnerstag, 2. Juli: Dub Inc. Das vollständige Programm kommt bald."
    ],
    "en": [
      "ERVA Festival is back for its 10th edition in a brand new 3-day format! Full programme at: www.ervafestival.com"
    ],
    "it": [
      "10? edizione. Un traguardo simbolico per questo evento, che è diventato uno degli appuntamenti imperdibili per la musica reggae, rap, world e dub in Francia. Giovedì 2 luglio: Dub Inc. Il programma completo è in arrivo."
    ],
    "fr": [
      "10ᵉ édition. Un cap symbolique pour cet événement devenu l’un des rendez-vous incontournables des musiques reggae, rap, world et dub en France. Le jeudi 2 juillet: Dub Inc. La programmation complète arrive vite."
    ],
    "nl": [
      "10? editie. Een symbolische mijlpaal voor dit evenement, dat is uitgegroeid tot een van de niet te missen evenementen voor reggae, rap, world en dub muziek in Frankrijk. Donderdag 2 juli: Dub Inc. Het volledige programma volgt binnenkort."
    ],
    "es": [
      "10? edición. Un hito simbólico para este acontecimiento, que se ha convertido en una de las citas ineludibles de la música reggae, rap, world y dub en Francia. Jueves 2 de julio: Dub Inc. Próximamente el programa completo."
    ]
  },
