  "rdfs:comment": {
    "de": [
      "Roanne und seine Umgebung an Bord unseres Heißluftballons zu entdecken, wird Ihnen zweifellos ein unvergessliches Erlebnis bescheren. Machen Sie eine einzigartige Erfahrung und lassen Sie Ihren Blick so weit wie möglich schweifen! Es bietet sich Ihnen ein außergewöhnliches 360°-Panorama."
    ],
    "en": [
      "Discovering Roanne and the surrounding area on board our hot-air balloon is sure to leave you with unforgettable memories. Enjoy a unique experience and look as far as you can! An exceptional 360° panorama awaits you."
    ],
    "it": [
      "Scoprire Roanne e i suoi dintorni a bordo della nostra mongolfiera vi lascerà sicuramente dei ricordi indimenticabili. Godetevi un'esperienza unica e guardate il più lontano possibile! Vi aspetta un panorama eccezionale a 360°."
    ],
    "fr": [
      "Découvrir Roanne et sa région à bord de notre montgolfière vous laissera, sans aucun doute, un souvenir inoubliable. Vivez une expérience unique et portez votre regard aussi loin que possible ! Un panorama exceptionnel à 360° s'offre à vous."
    ],
    "nl": [
      "Het ontdekken van Roanne en de omgeving aan boord van onze heteluchtballon zal onvergetelijke herinneringen achterlaten. Geniet van een unieke ervaring en kijk zo ver als je kunt! Een uitzonderlijk 360° panorama wacht op je."
    ],
    "es": [
      "Descubrir Roanne y sus alrededores a bordo de nuestro globo aerostático le dejará recuerdos inolvidables. Disfrute de una experiencia única y mire tan lejos como pueda Le espera un panorama excepcional de 360°."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Roanne Montgolfières"
    ]
  },
