  "rdfs:comment": {
    "de": [
      "Verleih und Verkauf von Skiern, Snowboards, Skibobs, Schneeschuhen und Zubehör. Einführung und Verkauf von SKIBOB (Bikeski). Beheizte Schließfächer für Skier. Professioneller Skiberater."
    ],
    "en": [
      "Winter : shop at bottom of slopes, close to ski pass office and village centre car park.  Ski and after-ski service: equipment rental/sale (skis, snowboards, sports equipments, accessories, clothing). Summer: mountain bikes, road bikes, electric touring bikes, shop."
    ],
    "it": [
      "Inverno: Negozio ai piedi delle piste, vicino agli uffici degli skipass e al parcheggio nel centro del paese. Servizio sci e doposci: noleggio, vendita, sci, snowboard, articoli sportivi, accessori, tessuti\r\nEstate: mountain bike, VTC, VTTAE, ebike, negozio."
    ],
    "fr": [
      "Hiver : Magasin pied de piste, proximité caisses des forfaits et parking au centre village. Service ski et après-ski : location, vente, skis, surfs, articles de sports, accessoires, textiles. \r\nEté : VTT, VTC, VTTAE, ebike, boutique."
    ],
    "nl": [
      "Winter: Winkel aan de voet van de pistes, in de buurt van de skipasbureaus en de parkeerplaats in het dorpscentrum. Ski- en après-skiservice: verhuur, verkoop, ski's, snowboards, sportartikelen, accessoires, textiel\r\nZomer: mountainbikes, VTC, VTTAE, ebike, winkel."
    ],
    "es": [
      "Invierno: Tienda al pie de las pistas, cerca de las oficinas de los forfaits y del aparcamiento en el centro del pueblo. Servicio de esquí y après-ski: alquiler, venta, esquís, tablas de snowboard, artículos deportivos, accesorios, textiles\r\nVerano: bicicletas de montaña, VTC, VTTAE, ebike, tienda."
    ]
  },
