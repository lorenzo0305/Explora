  "rdfs:comment": {
    "de": [
      "Die Tactile Tour ist eine Wanderausstellung für alle Zielgruppen, insbesondere für Sehbehinderte, Blinde und Sehbehinderte. Die Ausstellung besteht aus drei Sammlungen mit jeweils 12 taktilen Werken."
    ],
    "en": [
      "The Tactile Tour is a traveling exhibition designed for all publics, and in particular for the visually impaired, blind and partially sighted. The exhibition comprises 3 collections of 12 tactile works."
    ],
    "it": [
      "Il Tactile Tour è una mostra itinerante rivolta a tutti i tipi di pubblico, in particolare agli ipovedenti, ai non vedenti e agli ipovedenti. La mostra comprende 3 collezioni di 12 opere tattili."
    ],
    "fr": [
      "Le Tactile Tour est une exposition itinérante à destination de tous les publics et en particulier aux déficients visuels, aveugles et malvoyants. L’exposition comporte 3 collections de 12 œuvres tactiles."
    ],
    "es": [
      "La Gira Táctil es una exposición itinerante dirigida a todos los públicos y, en particular, a los discapacitados visuales, ciegos y deficientes visuales. La exposición consta de 3 colecciones de 12 obras táctiles."
    ],
    "nl": [
      "De Tactile Tour is een reizende tentoonstelling gericht op alle doelgroepen, in het bijzonder slechtzienden, blinden en slechtzienden. De tentoonstelling bestaat uit 3 collecties van 12 tactiele werken."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Tactile Tour 2026 - L'art au bout des doigts"
    ]
  },
