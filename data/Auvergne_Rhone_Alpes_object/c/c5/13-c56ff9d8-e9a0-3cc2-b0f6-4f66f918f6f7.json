  "rdfs:comment": {
    "de": [
      "Ideal gelegen, nur 50m vom Vanoise Express entfernt, empfängt Sie das Le Joli Bois in seiner außergewöhnlichen Umgebung. Das Restaurant le Joli Bois befindet sich im Herzen des Skigebiets Paradiski®, im Wald von Montchavin / Les Coches (La Plagne)."
    ],
    "en": [
      "Ideally located 50m from the Vanoise Express, Le Joli Bois welcomes you to its exceptional setting. The Joli Bois restaurant is at the heart of the Paradiski® ski area, in the Montchavin / Les Coches forest (La Plagne)."
    ],
    "it": [
      "Situato in posizione ideale a 50 metri dal Vanoise Express, il Joli Bois vi accoglie in un ambiente eccezionale. Il ristorante Joli Bois si trova nel cuore del comprensorio sciistico Paradiski®, nella foresta di Montchavin / Les Coches (La Plagne)."
    ],
    "fr": [
      "Idéalement situé à 50m du Vanoise Express, le Joli Bois vous accueille dans son cadre exceptionnel. Le restaurant le Joli Bois est au coeur du domaine skiable Paradiski®, dans la forêt de Montchavin / Les Coches (La Plagne)."
    ],
    "nl": [
      "Le Joli Bois is ideaal gelegen op 50 meter van de Vanoise Express en verwelkomt u in een uitzonderlijke omgeving. Het restaurant Joli Bois ligt in het hart van het skigebied Paradiski®, in het bos van Montchavin / Les Coches (La Plagne)."
    ],
    "es": [
      "Idealmente situado a 50 m de la Vanoise Express, el Joli Bois le acoge en su marco excepcional. El restaurante Joli Bois se encuentra en el corazón del dominio esquiable Paradiski®, en el bosque de Montchavin / Les Coches (La Plagne)."
    ]
  },
