  "rdfs:comment": {
    "de": [
      "Gehen Sie mit Ihrer Karte auf Entdeckungsreise durch das Blaue Tal!\r\n Ziel des Orientierungslaufs ist es, sich anhand von natürlichen und künstlichen Elementen zu orientieren. 14 Markierungen müssen gefunden werden."
    ],
    "en": [
      "Armed with your map, set off to discover the Vallée Bleue!\r\n The aim of the orienteering race is to find your bearings using natural and man-made elements. there are 14 markers to find."
    ],
    "it": [
      "Armati di mappa, partite alla scoperta della Vallée Bleue!\r\n Lo scopo della gara di orienteering è quello di orientarsi utilizzando elementi naturali e artificiali. ci sono 14 marcatori da trovare."
    ],
    "fr": [
      "Muni de votre carte, partez à la découverte de la Vallée Bleue !\r\n L'objectif de la course d'orientation est de se repérer grâce aux éléments naturels et artificiels. 14 balises sont à retrouver."
    ],
    "nl": [
      "Gewapend met je kaart ga je op pad om de Vallée Bleue te ontdekken!\r\n Het doel van de oriëntatieloop is om je te oriënteren aan de hand van natuurlijke en kunstmatige elementen. er zijn 14 markeringen te vinden."
    ],
    "es": [
      "Armado con su mapa, ¡parta a descubrir la Vallée Bleue!\r\n El objetivo de la carrera de orientación es orientarse utilizando elementos naturales y artificiales. hay 14 balizas que encontrar."
    ]
  },
  "rdfs:label": {
    "en": [
      "Orienteering trail at the Vallée Bleue, 'Lac des Pêcheurs' Red Course"
    ],
    "fr": [
      "Parcours d'orientation adulte \"rouge\" - Vallée Bleue"
    ]
  },
