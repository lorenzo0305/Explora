  "rdfs:comment": {
    "de": [
      "Kashmir erschüttert unsere Knochen mit ätzenden Gitarren, knallenden Drums und ätzenden Texten.\r\nDie Texte sind immer noch bissig, klar, direkt und zeigen mit dem Finger auf unsere Fehler, Absurditäten und Ungeschicklichkeiten, ohne jemals eine Lektion zu erteilen."
    ],
    "en": [
      "Cachemire shakes our bones with corrosive guitars, slamming drums and caustic lyrics.\r\nThe lyrics are as biting, clear and direct as ever, pointing the finger at our shortcomings, absurdities and blunders, without ever teaching a lesson."
    ],
    "it": [
      "I Cachemire ci scuotono le ossa con chitarre corrosive, batterie schiaccianti e testi caustici.\r\nI testi sono graffianti, chiari e diretti come sempre, puntano il dito contro le nostre mancanze, assurdità e errori, senza mai impartire una lezione."
    ],
    "fr": [
      "Cachemire ébranle nos os à grands renforts de guitares corrosives, de batteries claquées et de textes caustiques.\r\nTextes toujours aussi mordants, clairs, directs, pointant du doigt nos travers, absurdités, maladresses, sans jamais donner de leçon."
    ],
    "nl": [
      "Cachemire schudt onze botten door elkaar met bijtende gitaren, beukende drums en bijtende teksten.\r\nDe teksten zijn bijtend, helder en direct als altijd, en wijzen met de vinger naar onze tekortkomingen, absurditeiten en blunders, zonder ooit een lesje te leren."
    ],
    "es": [
      "Cachemire nos sacude los huesos con guitarras corrosivas, baterías contundentes y letras cáusticas.\r\nLas letras son tan mordaces, claras y directas como siempre, señalando con el dedo nuestros defectos, absurdos y meteduras de pata, sin dar nunca una lección."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Concert : CACHEMIRE + ÆTERNA"
    ]
  },
