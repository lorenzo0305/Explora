  "rdfs:comment": {
    "de": [
      "Das Tourismusbüro befindet sich im Herzen des Ortes, im Alpinium, und steht Ihnen für alle Informationen über den Ort zur Verfügung: Unterkunft, Shopping, Restaurants, Skigebiet, Schneeverhältnisse, Wetter, Aktivitäten, Veranstaltungen, Animationen ..."
    ],
    "en": [
      "Located in the heart of the resort at the Alpinium, the Tourist Office is at your disposal for all information on the resort, accommodation, shopping, restaurants, the ski area, snow conditions, weather, activities, events, entertainment..."
    ],
    "it": [
      "Situato nel cuore della località presso l'Alpinium, l'Ufficio del Turismo è a vostra disposizione per tutte le informazioni sulla località, gli alloggi, lo shopping, i ristoranti, il comprensorio sciistico, le condizioni della neve, il meteo, le attività, gli eventi, l'intrattenimento, ecc."
    ],
    "fr": [
      "Situé au cœur de la station à l' Alpinium, l'Office de Tourisme est à votre disposition pour toute information sur la station, hébergement, shopping, restauration, domaine skiable, enneigement, météo, activités, évènements, animations ..."
    ],
    "es": [
      "Situada en el corazón de la estación, en el Alpinium, la Oficina de Turismo está a su disposición para cualquier información sobre la estación, alojamiento, compras, restaurantes, dominio esquiable, estado de la nieve, meteorología, actividades, eventos, animaciones, etc."
    ],
    "nl": [
      "Gelegen in het hart van het resort in het Alpinium, staat het VVV-kantoor tot je beschikking voor alle informatie over het resort, accommodatie, winkelen, restaurants, het skigebied, sneeuwcondities, weer, activiteiten, evenementen, entertainment, enz."
    ]
  },
