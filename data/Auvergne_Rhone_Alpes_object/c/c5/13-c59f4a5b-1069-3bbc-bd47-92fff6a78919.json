  "rdfs:comment": {
    "de": [
      "Mitten im Hafen von Evian, authentische Geschmackserlebnisse. Hausküche, Fisch aus dem Genfer See."
    ],
    "en": [
      "Located in the Evian marina for a taste of authenticity: Home cooking. Fishes of Geneva Lake"
    ],
    "it": [
      "Nel cuore del porto di Evian, ristorante-glacier per tutti i gusti e le tasche. Prodotti locali per una cucina tradizionale in ogni momento: pesce del lago di Ginevra, grigliate, insalate, frittelle, dolci fatti in casa..."
    ],
    "fr": [
      "Au coeur du port d'Evian, restaurant-glacier pour toutes les envies et tous les budgets. Des produits locaux pour une cuisine traditionnelle à toute heure : poissons du Léman, grillades, salades, crêpes, pâtisseries maison..."
    ],
    "nl": [
      "In het hart van de haven van Evian, een restaurant-glacier voor alle smaken en budgetten. Lokale producten voor een traditionele keuken op elk moment van de dag: vis uit het meer van Genève, gegrild vlees, salades, crêpes, huisgemaakt gebak..."
    ],
    "es": [
      "En el corazón del puerto de Evian, restaurante-glaciar para todos los gustos y presupuestos. Productos locales para una cocina tradicional a cualquier hora: pescado del lago Lemán, parrilladas, ensaladas, tortitas, repostería casera..."
    ]
  },
