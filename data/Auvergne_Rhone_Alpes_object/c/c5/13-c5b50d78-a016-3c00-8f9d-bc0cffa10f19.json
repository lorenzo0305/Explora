  "rdfs:comment": {
    "de": [
      "Traditionelle Hausmannskost und regionale Gerichte, Rinderkotelett im Menü (nur mittags) oder à la carte.\r\nGemütlicher Saal mit \"Cantou\" und Tischen im Landhausstil. Im Sommer profitieren Sie von einer schattigen Terrasse mit Blick auf das Schloss von Pesteils."
    ],
    "en": [
      "Traditional home cooking and regional dishes, prime rib on the menu (lunchtime only) or à la carte.\nCosy dining room with \"cantou\" and country-style tables. In summer, enjoy a shaded terrace overlooking the Château de Pesteils."
    ],
    "it": [
      "Cucina casalinga tradizionale e piatti regionali, costata di manzo nel menu (solo a pranzo) o à la carte.\r\nSala calda con \"cantou\" e tavoli di campagna. In estate potrete godere di una terrazza ombreggiata con vista sul castello di Pesteils."
    ],
    "fr": [
      "Restauration maison traditionnelle et plats régionaux, côte de bœuf au menu (le midi uniquement) ou à la carte.\r\nSalle chaleureuse avec \"cantou\" et tables campagnardes. En été vous profiterez d'une terrasse ombragée avec vue sur le château de Pesteils."
    ],
    "nl": [
      "Traditionele keuken en regionale gerechten, prime rib op het menu (alleen 's middags) of à la carte.\r\nWarme kamer met \"cantou\" en landelijke tafels. In de zomer kunt u genieten van een schaduwrijk terras met uitzicht op het kasteel van Pesteils."
    ],
    "es": [
      "Cocina casera tradicional y platos regionales, costilla en el menú (sólo a mediodía) o a la carta.\nCálido comedor con \"cantou\" y mesas de estilo campestre. En verano, terraza a la sombra con vistas al castillo de Pesteils."
    ]
  },
