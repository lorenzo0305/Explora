  "rdfs:comment": {
    "de": [
      "Weder Bar noch Restaurant, der Gastropub ist ein Hybrid, eine fröhliche Mischung aus Bier, Wein und gutem Essen. Weinbar-Ambiente mit Stehtischen, an denen man Wurstbretter und manchmal hochwertige Häppchen mit 100% lokalen Bieren genießen kann."
    ],
    "en": [
      "Neither bar nor restaurant, the gastropub is a hybrid, a joyful mix of beer, wine and good food. Ambiance wine bar with mangers to taste boards of delicatessen and bites sometimes upscale, with 100% local beers."
    ],
    "it": [
      "Né un bar né un ristorante, il gastropub è un ibrido, un felice mix di birra, vino e buon cibo. L'atmosfera è quella di un wine bar con tavoli in piedi dove si possono gustare taglieri di salumi e stuzzichini, alcuni dei quali di alta gamma, con birre 100% locali."
    ],
    "fr": [
      "Ni bar, ni restaurant, le gastropub est un hybride, un joyeux mix de bières, vins et bonne bouffe. Ambiance bar à vins avec des mange-debout pour déguster des planches de charcuteries et bouchées parfois haut de gamme, avec des bières 100% locales."
    ],
    "nl": [
      "Noch een bar, noch een restaurant, de gastropub is een hybride, een gelukkige mix van bier, wijn en lekker eten. De sfeer is die van een wijnbar, met statafels waar u kunt genieten van schotels vleeswaren en snacks, waarvan sommige van topkwaliteit, met 100% lokale bieren."
    ],
    "es": [
      "Ni bar ni restaurante, el gastropub es un híbrido, una feliz mezcla de cerveza, vino y buena comida. El ambiente es el de un bar de vinos con mesas de pie donde se pueden degustar bandejas de embutidos y aperitivos, algunos de ellos de alta gama, con cervezas 100% locales."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant Lyon's Gastro Pub"
    ]
  },
