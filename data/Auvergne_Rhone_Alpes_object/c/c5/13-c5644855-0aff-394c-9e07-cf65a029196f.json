  "rdfs:comment": {
    "de": [
      "Mit der ESF von La Norma lässt sich die Freude am Skifahren leicht erlernen!\r\nUnterrichtete Disziplinen: Alpinski, Snowboard, Skitaxi und Handiski, Freeride, Freestyle, Telemark, Veloski, Handiski, Schneeschuhe, Skitouren."
    ],
    "en": [
      "With the ESF La Norma, the pleasure of skiing is easy to learn!\r\nDisciplines taught: alpine skiing, snowboarding, ski and handiski taxi, freeride, freestyle, telemark, bicycle skiing, handiski, snowshoes, ski touring."
    ],
    "it": [
      "Con l'ESF di La Norma, il piacere dello sci è facile da imparare!\r\nDiscipline insegnate: sci alpino, snowboard, sci taxi e handiski, freeride, freestyle, telemark, sci in bicicletta, handiski, racchette da neve, sci alpinismo."
    ],
    "fr": [
      "Avec l'ESF de La Norma, le plaisir de la glisse s'apprend facilement !\r\nDisciplines enseignées : ski alpin, snowboard, taxi ski et handiski, freeride, freestyle, télémark, véloski, handiski, raquettes, ski de randonnée."
    ],
    "nl": [
      "Met de ESF La Norma is het plezier van skiën gemakkelijk te leren!\r\nGedoceerde disciplines: alpineskiën, snowboarden, ski- en handiskitaxi, freeride, freestyle, telemark, fietsskiën, handiski, sneeuwschoenen, toerskiën."
    ],
    "es": [
      "Con el FSE de La Norma, ¡el placer de esquiar es fácil de aprender!\r\nDisciplinas impartidas: esquí alpino, snowboard, esquí taxi y handiski, freeride, freestyle, telemark, esquí en bicicleta, handiski, raquetas de nieve, esquí de travesía."
    ]
  },
  "rdfs:label": {
