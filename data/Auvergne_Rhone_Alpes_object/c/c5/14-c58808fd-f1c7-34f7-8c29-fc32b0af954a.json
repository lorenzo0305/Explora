  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/78dc7676-16bb-3c31-920a-726830e74515",
      "dc:description": {
        "de": [
          "FAGUO wurde 2009 gegründet und ist eine französische Modemarke, die mit ihren Schuh-, Gepäck- und Prêt-à-porter-Kollektionen zeitlose Stücke der Garderobe kreiert."
        ],
        "en": [
          "Launched in 2009, FAGUO is a French fashion brand that creates timeless wardrobe pieces through its shoe, luggage and ready-to-wear collections."
        ],
        "it": [
          "Lanciato nel 2009, FAGUO è un marchio di moda francese che crea pezzi di guardaroba senza tempo attraverso le sue collezioni di calzature, valigeria e prêt-à-porter."
        ],
        "fr": [
          "Lancée en 2009, FAGUO est une marque de mode française qui crée des pièces intemporelles du vestiaire à travers des collections de chaussures, bagagerie et prêt-à-porter."
        ],
        "es": [
          "Lanzada en 2009, FAGUO es una marca de moda francesa que crea piezas de vestuario atemporales a través de sus colecciones de calzado, equipaje y prêt-à-porter."
        ],
        "nl": [
          "FAGUO, dat in 2009 werd gelanceerd, is een Frans modemerk dat tijdloze garderobestukken creëert met zijn schoenen-, bagage- en prêt-à-portercollecties."
        ]
      },
