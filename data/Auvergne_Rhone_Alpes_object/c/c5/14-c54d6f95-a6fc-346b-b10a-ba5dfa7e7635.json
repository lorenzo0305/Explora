      "@id": "https://data.datatourisme.fr/7c62c346-6c31-3f47-af6e-d1dd08e1bb68",
      "dc:description": {
        "de": [
          "Informationen :\n\nÖffnungstage :\n\nDienstag bis Freitag von 7:00 bis 19:00 Uhr, Samstag und Sonntag von 7:00 bis 12:30 Uhr.\n\nMontags geschlossen\n \nBestellung:\nTelefonische Bestellung unter 03 21 73 93 82 möglich\n "
        ],
        "en": [
          "Information :\n\nOpening days :\n\nTuesday to Friday 7am to 7pm, Saturday and Sunday 7am to 12:30pm.\n\nClosed on Mondays\n \nOrdering:\nOrder by phone 03 21 73 93 82\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura :\n\nDa martedì a venerdì dalle 7 alle 19, sabato e domenica dalle 7 alle 12.30.\n\nChiuso il lunedì\n \nCome ordinare :\nÈ possibile ordinare per telefono al numero 03 21 73 93 82\n "
        ],
        "fr": [
          "Informations :\n\nJours d'ouverture : \n\nDu mardi  au vendredi de 7h à 19h, le samedi et le dimanche de 7h à 12h30.\n\nFermeture le lundi\n \nCommande : \nPossibilité de commander par téléphone au 03 21 73 93 82\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen :\n\nDinsdag t/m vrijdag van 7.00 tot 19.00 uur, zaterdag en zondag van 7.00 tot 12.30 uur.\n\nGesloten op maandag\n \nHoe te bestellen :\nU kunt telefonisch bestellen op 03 21 73 93 82\n "
        ],
        "es": [
          "Más información :\n\nDías de apertura :\n\nDe martes a viernes de 7h a 19h, sábados y domingos de 7h a 12h30.\n\nCerrado los lunes\n \nCómo hacer un pedido :\nPuede hacer su pedido por teléfono llamando al 03 21 73 93 82\n "
        ]
      },
