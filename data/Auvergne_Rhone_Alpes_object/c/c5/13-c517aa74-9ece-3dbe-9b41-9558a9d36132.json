  "rdfs:comment": {
    "de": [
      "Die gemeindeübergreifende Mediathek Lis-Là in Saint-Quentin-sur-Isère empfängt Sie von Dienstag bis Samstag, um Sie in wunderbare Welten zu entführen, Sie über ein aktuelles Thema zu informieren oder sich einfach nur einen Moment lang zu entspannen."
    ],
    "en": [
      "The Lis-Là intercommunal media library in Saint-Quentin-sur-Isère welcomes you from Tuesday to Saturday, to help you discover wonderful worlds, find out about current affairs, or simply relax for a while."
    ],
    "it": [
      "La biblioteca multimediale intercomunale Lis-Là di Saint-Quentin-sur-Isère vi accoglie dal martedì al sabato per farvi scoprire mondi meravigliosi, informarvi sull'attualità o semplicemente rilassarvi un po'."
    ],
    "fr": [
      "La médiathèque intercommunale Lis-Là à Saint-Quentin-sur-Isère vous accueille du mardi au samedi pour vous faire découvrir des mondes merveilleux, vous renseigner sur un sujet d’actualité, ou simplement venir vous prélasser le temps d’un instant."
    ],
    "es": [
      "La biblioteca multimedia intermunicipal Lis-Là de Saint-Quentin-sur-Isère le acoge de martes a sábado para hacerle descubrir mundos maravillosos, informarse sobre la actualidad o simplemente relajarse un rato."
    ],
    "nl": [
      "De mediatheek van de intercommunale Lis-Là in Saint-Quentin-sur-Isère verwelkomt je van dinsdag tot zaterdag om je te helpen wondere werelden te ontdekken, de actualiteit te leren kennen of gewoon even te ontspannen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Médiathèque Lis là"
    ]
  },
