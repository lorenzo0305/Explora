  "rdfs:comment": {
    "de": [
      "Besuchen Sie den Honigraum, beobachten Sie die Bienen und entdecken Sie die verschiedenen Bienenprodukte und die Verkaufsstelle: Honig, Gelée Royale (GPGR), Propolis, frischer Pollen und Kerzen."
    ],
    "en": [
      "Discover the different products of the hive and the point of sale!\r\nHoneys, royal jelly (GPGR) and fresh pollen."
    ],
    "it": [
      "Venite a visitare la casa del miele, osservate le api e scoprite i diversi prodotti dell'alveare e del punto vendita: mieli, pappa reale (GPGR), propoli, polline fresco e candele."
    ],
    "fr": [
      "Venez visiter la miellerie, observer les abeilles et découvrir les différents produits de la ruche et le point de vente : miels, gelée royale (GPGR), propolis, pollen frais et bougies."
    ],
    "es": [
      "Venga a visitar la casa de la miel, observe a las abejas y descubra los diferentes productos de la colmena y el punto de venta: mieles, jalea real (GPGR), propóleos, polen fresco y velas."
    ],
    "nl": [
      "Kom het honinghuis bezoeken, bekijk de bijen en ontdek de verschillende producten uit de bijenkorf en het verkooppunt: honing, koninginnengelei (GPGR), propolis, verse pollen en kaarsen."
    ]
  },
  "rdfs:label": {
    "en": [
      "Honey house \"A Tire d'Aile\""
    ],
    "fr": [
      "Miellerie A Tire d'aile"
    ]
  },
