  "rdfs:comment": {
    "de": [
      "Willkommen im Relais Cyné in Chevrières. Wir können Sie für die Dauer eines Picknicks oder für eine Etappe in einem Biwak empfangen. Picknicktisch, Anbindestange für Pferde, Unterstand, Parkplatz stehen Ihnen zur Verfügung."
    ],
    "en": [
      "Welcome to Relais Cyné de Chevrières. We can welcome you for a picnic or a bivouac. Picnic tables, horse tie-downs, shelter and parking are all at your disposal."
    ],
    "it": [
      "Benvenuti al Relais Cyné de Chevrières. Possiamo ospitarvi per un picnic o un bivacco. Abbiamo un tavolo da picnic, una barra per legare i cavalli, un riparo e un parcheggio."
    ],
    "fr": [
      "Bienvenue au Relais Cyné de Chevrières. Nous pouvons vous accueillir le temps d'un pique nique ou pour une étape en bivouac. Table de pique-nique, barre d'attache pour chevaux, abri, parking sont mis à votre disposition."
    ],
    "nl": [
      "Welkom bij Relais Cyné de Chevrières. Je kunt bij ons terecht voor een picknick of een bivak. We hebben een picknicktafel, een tui voor paarden, een schuilhut en een parkeerplaats."
    ],
    "es": [
      "Bienvenido al Relais Cyné de Chevrières. Podemos acogerle para un picnic o un vivac. Disponemos de una mesa de picnic, una barra de amarre para caballos, un refugio y un aparcamiento."
    ]
  },
  "rdfs:label": {
