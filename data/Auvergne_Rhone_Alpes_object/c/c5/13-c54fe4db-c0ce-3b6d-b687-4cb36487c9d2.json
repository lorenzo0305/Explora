  "rdfs:comment": {
    "de": [
      "Das Hotel Restaurant befindet sich am Ufer des Sees Val d'Oignin, umgeben von einem grünen Tal, und genießt einen herrlichen Ausblick auf die wunderschöne Landschaft des Dorfes Samognat (Ain)."
    ],
    "en": [
      "The hotel-restaurant is set on the shores of the Val d'Oignin lake, surrounded by a green valley and boasting superb views over the magnificent scenery of the village of Samognat (Ain)."
    ],
    "it": [
      "Il ristorante dell'hotel si trova sulle rive del lago di Val d'Oignin, circondato da una valle verdeggiante e vanta una vista superba sul magnifico scenario del villaggio di Samognat (Ain)."
    ],
    "fr": [
      "L'hôtel Restaurant est installé sur les rives du lac val d'oignin, entouré d’une vallée verdoyante et bénéficie de superbes points de vue sur les paysages magnifiques du village de Samognat (Ain)."
    ],
    "nl": [
      "Het restaurant van het hotel ligt aan de oever van het meer van Val d'Oignin, omgeven door een weelderige groene vallei en biedt een prachtig uitzicht over het schitterende landschap van het dorp Samognat (Ain)."
    ],
    "es": [
      "El restaurante del hotel está situado a orillas del lago Val d'Oignin, rodeado de un frondoso valle verde y goza de magníficas vistas sobre el magnífico paisaje del pueblo de Samognat (Ain)."
    ]
  },
  "rdfs:label": {
