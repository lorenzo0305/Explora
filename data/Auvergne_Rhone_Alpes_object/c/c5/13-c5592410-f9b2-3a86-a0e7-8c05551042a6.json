  "rdfs:comment": {
    "de": [
      "Verkauf von Käse und Zickleinfleisch in der Chèvrerie du grand Rif am Samstagnachmittag. Möglichkeit außerhalb der Öffnungszeiten Telefon: 06 27 15 83 04\nBesichtigung nach Voranmeldung unter derselben Nummer."
    ],
    "en": [
      "Sale of goat cheese and goat kid meat at the Chèvrerie du Grand Rif, on Saturday afternoons.\nAvailable outside opening hours by phone: +33 6 27 15 83 04\nFarm visits by reservation, same numbers."
    ],
    "it": [
      "Vendita di formaggio e carne di capra presso la Chèvrerie du Grand Rif il sabato pomeriggio. Possibilità al di fuori degli orari di apertura telefono: 06 27 15 83 04\nVisite su prenotazione allo stesso numero."
    ],
    "fr": [
      "Vente de fromage et de viande de chevreaux à la Chèvrerie du grand Rif le samedi après midi. Possibilité en dehors des horaires d'ouverture téléphone : 06 27 15 83 04 \nVisite sur réservation même numéro."
    ],
    "nl": [
      "Verkoop van geitenkaas en -vlees bij de Chèvrerie du Grand Rif op zaterdagmiddag. Mogelijkheid buiten openingstijden telefoon: 06 27 15 83 04\nBezoek op reservering op hetzelfde nummer."
    ],
    "es": [
      "Venta de queso y carne de cabra en la Chèvrerie du Grand Rif los sábados por la tarde. Posibilidad fuera del horario de apertura teléfono: 06 27 15 83 04\nVisitas previa reserva en el mismo número."
    ]
  },
  "rdfs:label": {
