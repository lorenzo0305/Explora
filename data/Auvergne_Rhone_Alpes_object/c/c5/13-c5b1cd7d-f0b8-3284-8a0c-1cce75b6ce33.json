  "rdfs:comment": {
    "de": [
      "Auf dieser Wanderung können Sie die jurassischen Hochalmen entdecken. Spazieren Sie um die farbenfrohen Blumenfelder herum und genießen Sie jeden Moment!"
    ],
    "en": [
      "This walk takes you through the high alpine pastures of the Jura. Stroll around fields of multicolored flowers, and savor every moment!"
    ],
    "it": [
      "In questa passeggiata scoprirete i pascoli d'alta quota del Giura. Passeggiate tra i campi di fiori multicolori e assaporate ogni momento!"
    ],
    "fr": [
      "Cette balade vous permettra de découvrir les hauts alpages Jurassien. Promenez-vous autour des champs de fleurs multi couleurs, et savourez chaque moment !"
    ],
    "nl": [
      "Tijdens deze wandeling ontdek je de alpenweiden van de Jura. Wandel langs de veelkleurige bloemenvelden en geniet van elk moment!"
    ],
    "es": [
      "En este paseo, descubrirá los pastos alpinos del Jura. Pasee por los campos de flores multicolores y saboree cada momento"
    ]
  },
