  "rdfs:comment": {
    "de": [
      "Die kleine Galerie in Bas en Basset hat zum Ziel, Künstler und Kunsthandwerker auszustellen und zu fördern. Zögern Sie nicht, die Tür der kleinen Galerie aufzustoßen und sich mit den anwesenden Künstlern auszutauschen."
    ],
    "en": [
      "The purpose of the small gallery of Bas en Basset is to expose and promote artists and craftsmen. Do not hesitate to push the door of the small Gallery, you will be able to exchange with the present artists."
    ],
    "it": [
      "L'obiettivo della piccola galleria di Bas en Basset è quello di esporre e promuovere artisti e artigiani. Non esitate a spingere la porta della piccola galleria, potrete scambiare con gli artisti presenti."
    ],
    "fr": [
      "La petite galerie de Bas en Basset à pour but d’exposer et de promouvoir des artistes et artisans. N’hésitez pas à pousser la porte de la petite Galerie, vous pourrez échanger avec les artistes présents."
    ],
    "nl": [
      "Het doel van de kleine galerie in Bas en Basset is het tentoonstellen en promoten van kunstenaars en ambachtslieden. Aarzel niet om de deur van de kleine galerie open te doen, u kunt er van gedachten wisselen met de aanwezige kunstenaars."
    ],
    "es": [
      "El objetivo de la pequeña galería de Bas en Basset es exponer y promocionar a artistas y artesanos. No dude en empujar la puerta de la pequeña Galería, podrá intercambiar con los artistas presentes."
    ]
  },
  "rdfs:label": {
    "fr": [
