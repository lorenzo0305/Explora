  "rdfs:comment": {
    "de": [
      "Diese Hochburg der traditionellen Grenobler Küche vereint klassische und innovative Gerichte mit marktfrischen Produkten und Aromen, die das Geheimnis der großen Küchenchefs sind."
    ],
    "en": [
      "This hotspot of traditional Grenoble cuisine combines classic or innovative dishes with fresh market products and flavors that are the secret of great chefs."
    ],
    "it": [
      "Questa mecca della cucina tradizionale di Grenoble combina piatti classici o innovativi con prodotti freschi del mercato e sapori che sono il segreto dei grandi chef."
    ],
    "fr": [
      "Ce haut-lieu de la cuisine traditionnelle grenobloise conjugue les mets classiques ou innovants avec des produits frais du marché et des saveurs qui sont le secret des grands chefs."
    ],
    "es": [
      "Esta meca de la cocina tradicional de Grenoble combina platos clásicos e innovadores con productos frescos del mercado y sabores que son el secreto de los grandes chefs."
    ],
    "nl": [
      "Dit mekka van de traditionele keuken van Grenoble combineert klassieke of vernieuwende gerechten met verse marktproducten en smaken die het geheim zijn van grote chefs."
    ]
  },
