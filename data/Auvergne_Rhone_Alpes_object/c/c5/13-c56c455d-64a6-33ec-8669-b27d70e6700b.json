  "rdfs:comment": {
    "de": [
      "Dieser 800 m2 große Skatepark aus glattem Beton, der abends beleuchtet ist, wurde im November 2018 eröffnet\r\nEr befindet sich auf 1650 m Höhe am Fuße der großen Hänge, hinter dem Maison des 2 Alpes (Tourismusbüro).\r\nEr wird vom Verein 2 Alpes Skate Krew verwaltet."
    ],
    "en": [
      "A new 800m2 smooth concrete skatepark, lit in the evening, open since November 2018. \r\nIt is located at 1650m d'altitude at the foot of the big slopes, behind the Maison des 2 Alpes (Tourist Office).\r\nIt is managed by the association 2 Alpes Skate Krew."
    ],
    "it": [
      "Un nuovo skatepark di 800m2 in cemento liscio, illuminato di sera, aperto da novembre 2018. \r\nSi trova a 1650m di altitudine ai piedi dei grandi pendii, dietro la Maison des 2 Alpes (Ufficio del Turismo).\r\nÈ gestito dall'associazione 2 Alpes Skate Krew."
    ],
    "fr": [
      "Skatepark en béton lisse de 800m2 , éclairé le soir, ouvert depuis novembre 2018. \r\nIl est situé à 1650m d'altitude au pied des grandes pentes, derrière la Maison des 2 Alpes (Office de Tourisme).\r\nIl est géré par l'association 2 Alpes Skate Krew."
    ],
    "es": [
      "Skatepark de hormigón liso de 800m2, iluminado por la noche, abierto desde noviembre de 2018\r\nSe encuentra a 1650 m de altitud, al pie de las grandes pistas, detrás de la Maison des 2 Alpes (Oficina de Turismo).\r\nEstá gestionado por la asociación 2 Alpes Skate Krew."
    ],
    "nl": [
      "Glad betonnen skatepark van 800m2, 's nachts verlicht, open sinds november 2018\r\nHet ligt op 1650m hoogte aan de voet van de grote pistes, achter het Maison des 2 Alpes (VVV).\r\nHet wordt beheerd door de vereniging 2 Alpes Skate Krew."
    ]
  },
