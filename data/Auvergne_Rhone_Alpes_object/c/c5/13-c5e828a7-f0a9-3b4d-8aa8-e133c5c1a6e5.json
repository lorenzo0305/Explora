  "rdfs:comment": {
    "de": [
      "Sind Sie bereit für den festlichsten Hausverkauf in Bransat? Kommen Sie zum Stöbern, tanzen Sie zum Konzert von Ëamaë und genießen Sie die \"Gratruiterie\". Getränke und Snacks zugunsten des Vereins Inopiné. Geselligkeit von 8 bis 20 Uhr garantiert! Wir erwarten Sie!"
    ],
    "en": [
      "Ready for Bransat's most festive house sale? Come and browse, dance to Ëamaë's concert and enjoy the \"gratruiterie\". Refreshments & snacks in aid of Inopiné. Conviviality guaranteed from 8am to 8pm! We look forward to seeing you!"
    ],
    "it": [
      "Siete pronti per la vendita di case più festosa di Bransat? Venite a caccia di occasioni, ballate al concerto di Ëamaë e godetevi la \"gratruiterie\". Rinfreschi e spuntini a favore di Inopiné. Convivialità garantita dalle 8 alle 20! Vi aspettiamo!"
    ],
    "fr": [
      "Prêt pour le vide-maison le plus festif de Bransat ? Venez chiner, danser au concert d'Ëamaë et profiter de la \"gratruiterie\". Buvette & snacks au profit de l'asso Inopiné. Convivialité garantie de 8h à 20h ! On vous attend !"
    ],
    "es": [
      "¿Preparado para la venta de casas más festiva de Bransat? Ven a buscar gangas, baila al ritmo del concierto de Ëamaë y disfruta de la \"gratruiterie\". Refrescos y tentempiés a beneficio de Inopiné. Convivencia garantizada de 8.00 a 20.00 horas ¡Le esperamos!"
    ],
    "nl": [
      "Klaar voor de meest feestelijke huizenverkoop in Bransat? Kom op koopjesjacht, dans op het concert van Ëamaë en geniet van de \"gratruiterie\". Versnaperingen en hapjes ten voordele van Inopiné. Gezelligheid gegarandeerd van 8 tot 20 uur! We kijken uit naar je komst!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Vide-Maison inOpiné"
    ]
  },
