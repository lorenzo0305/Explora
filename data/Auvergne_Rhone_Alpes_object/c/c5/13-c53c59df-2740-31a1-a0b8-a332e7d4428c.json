  "rdfs:comment": {
    "de": [
      "Historisches, patrimoniales, kulturelles und touristisches Außenmuseum: Tafeln, die den Werdegang des Hauses Blanc seit 1872, alte Berufe, alte Postkarten, die Gastronomie der Bresse, den Tourismus des Departements... präsentieren."
    ],
    "en": [
      "Outdoor historical, heritage, cultural and tourist museum: panels presenting the history of Maison Blanc since 1872, old trades, old postcards, Bresse gastronomy, departmental tourism..."
    ],
    "it": [
      "Museo storico, patrimoniale, culturale e turistico all'aperto: pannelli che presentano la storia della Maison Blanc dal 1872, vecchi mestieri, vecchie cartoline, gastronomia della Bresse, turismo dipartimentale, ecc."
    ],
    "fr": [
      "Musée extérieur historique, patrimonial, culturel et touristique  : panneaux présentant  le cheminement de la maison Blanc depuis 1872, les vieux métiers, les vieilles cartes postales, la gastronomie bressane, le tourisme départemental..."
    ],
    "nl": [
      "Openluchtmuseum voor geschiedenis, erfgoed, cultuur en toerisme: panelen met de geschiedenis van het Maison Blanc sinds 1872, oude ambachten, oude ansichtkaarten, gastronomie van Bresse, departementaal toerisme, enz."
    ],
    "es": [
      "Museo histórico, patrimonial, cultural y turístico al aire libre: paneles que presentan la historia de la Maison Blanc desde 1872, antiguos oficios, antiguas postales, gastronomía de Bresse, turismo departamental, etc."
    ]
  },
