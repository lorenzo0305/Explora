  "rdfs:comment": {
    "de": [
      "Die Skischule Morillon und ihre leidenschaftlichen Skilehrer und Skilehrerinnen empfangen Sie für ein unvergessliches Erlebnis auf den verschneiten Pisten des wunderschönen Skigebiets Grand Massif!"
    ],
    "en": [
      "ESF Morillon, is a team of qualified instructors present on the entire season, happy to share with you their passion for winter sports whatever your level and your desires."
    ],
    "it": [
      "La scuola di sci di Morillon e i suoi appassionati maestri vi accolgono per un'esperienza indimenticabile sulle piste innevate del superbo comprensorio sciistico del Grand Massif!"
    ],
    "fr": [
      "L'école de ski Morillon et ses moniteurs et monitrices passionnés vous accueillent pour une expérience inoubliable sur les pistes enneigées  du superbe domaine de Grand Massif !"
    ],
    "es": [
      "La escuela de esquí de Morillon y sus apasionados monitores te dan la bienvenida para que vivas una experiencia inolvidable en las pistas nevadas del magnífico dominio esquiable del Grand Massif"
    ],
    "nl": [
      "De Morillon skischool en zijn gepassioneerde instructeurs verwelkomen je voor een onvergetelijke ervaring op de besneeuwde hellingen van het prachtige Grand Massif skigebied!"
    ]
  },
