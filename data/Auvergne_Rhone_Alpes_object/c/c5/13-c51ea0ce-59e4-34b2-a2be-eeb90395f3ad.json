  "rdfs:comment": {
    "de": [
      "La Culottée, handgemachte Limonade aus eigener Herstellung. Wenig süß, gut zitronig und voller Blasen! Genießen Sie sie auf den festlichen Veranstaltungen im Diois und im Barabock in Menglon."
    ],
    "en": [
      "La Culottée, handcrafted lemonade. Low in sugar, high in citrus and full of bubbles! Enjoy it at festive events in the Diois and at Barabock in Menglon."
    ],
    "it": [
      "La Culottée, limonata artigianale. Poco zucchero, molto limone e tante bollicine! Da gustare in occasione di eventi festivi nel Diois e alla spina al Barabock di Menglon."
    ],
    "fr": [
      "La Culottée, limonade artisanale faite à la main. Peu sucrée, bien citronnée et pleine de bulles ! À savourer sur les évènements festifs du Diois et en pression au Barabock à Menglon."
    ],
    "es": [
      "La Culottée, limonada artesanal. Con poco azúcar, mucho limón y muchas burbujas Disfrútela en los actos festivos de Diois y de barril en el Barabock de Menglon."
    ],
    "nl": [
      "La Culottée, handgemaakte limonade. Laag in suiker, hoog in citroen en vol bubbels! Geniet ervan op feestelijke evenementen in de Diois en in de Barabock in Menglon."
    ]
  },
  "rdfs:label": {
    "de": [
      "Handgemachte Limonade La Culottée"
    ],
    "en": [
      "La Culottée home-made lemonade"
    ],
    "fr": [
      "Limonade artisanale La Culottée"
    ],
    "nl": [
      "La Culottée zelfgemaakte limonade"
    ]
  },
