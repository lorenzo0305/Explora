  "rdfs:comment": {
    "de": [
      "Stoßen Sie die Tür zum Gewächshaus Sud Spiruline auf! Die Spirulina-Bauern Brice und Sébastien bauen Spirulina aus biologischem Anbau an. Sie zeigen Ihnen ihren Beruf und teilen ihre Leidenschaft für dieses Superfood, das Ihnen gut tut! Die Spirulina-Farm grenzt an Lavendelfelder, die während der Blütezeit spektakulär sind. Eine originelle Reise in das Herz der Provence."
    ],
    "en": [
      "Open the door to the Sud Spiruline greenhouse! Brice and Sébastien, spirulina growers, cultivate organic spirulina. They'll be delighted to show you what they do and share their passion for this super food that's good for you! The spiru-farm rubs shoulders with lavender fields, spectacular when in flower. An original journey to the heart of Provence."
    ],
    "it": [
      "Aprite la porta della serra Sud Spiruline! Brice e Sébastien, coltivatori di spirulina, coltivano spirulina biologica. Saranno lieti di mostrarvi cosa fanno e di condividere la loro passione per questo super alimento che fa bene!"
    ],
    "fr": [
      "Poussez la porte de la serre Sud Spiruline ! Brice et Sébastien, spiruliniers, cultivent la spiruline BIO. Ils vous feront découvrir leur métier et partager leur passion pour ce super aliment qui vous veut du bien !"
    ],
    "es": [
      "¡Abra la puerta del invernadero de Sud Spiruline! Brice y Sébastien, cultivadores de espirulina, cultivan espirulina biológica. Estarán encantados de enseñarte lo que hacen y compartir su pasión por este superalimento tan bueno para la salud"
    ],
    "nl": [
      "Open de deur van de kas van Sud Spiruline! Brice en Sébastien, spirulina kwekers, kweken biologische spirulina. Ze laten je graag zien wat ze doen en delen hun passie voor dit supervoedsel dat goed voor je is! De spiru-boerderij grenst aan lavendelvelden, spectaculair als ze in bloei staan. Een originele reis naar het hart van de Provence."
    ]
  },
