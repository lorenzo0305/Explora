  "rdfs:comment": {
    "de": [
      "La villa, das größte Show-Dinner-Kabarett in Rhône-Alpes, Themenabende von Dienstag- bis Samstagabend. Traditionelles Restaurant von Montag bis Freitag zum Mittagessen."
    ],
    "en": [
      "La Villa, the biggest cabaret dinner show in the Rhone-Alpes region, themed night parties Tuesday and Saturday nights."
    ],
    "it": [
      "La villa, la più grande cena-spettacolo della regione Rodano-Alpi, serate a tema su prenotazione dal martedì al sabato sera. Ristorante tradizionale dal lunedì al venerdì a pranzo."
    ],
    "fr": [
      "La villa, le plus grand dîner spectacle de Rhône-Alpes, soirées à thème sur réservation du mardi au samedi soir. Restaurant traditionnel du lundi au vendredi midi."
    ],
    "es": [
      "La villa, el mayor cabaret con cena y espectáculo de Rhône-Alpes, veladas temáticas de martes a sábado. Restaurante tradicional de lunes a viernes al mediodía."
    ],
    "nl": [
      "La Villa, het grootste diner en spektakel in de regio Rhône-Alpes, thema-avonden op afspraak van dinsdag tot zaterdagavond. Traditioneel restaurant van maandag tot vrijdag lunchtijd."
    ]
  },
