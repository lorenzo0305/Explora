  "rdfs:comment": {
    "de": [
      "Die Cie Lilaho lädt sehr junge Zuschauer in das Herz ihres Traumwaldes ein, um musikalisch und sensorisch in die Pflanzenwelt einzutauchen!"
    ],
    "en": [
      "Cie Lilaho invites young spectators into the heart of its dreamlike forest for a musical and sensory immersion in the world of plants!"
    ],
    "it": [
      "Cie Lilaho invita i giovanissimi spettatori nel cuore della sua foresta da sogno per un'immersione musicale e sensoriale nel mondo delle piante!"
    ],
    "fr": [
      "La Cie Lilaho invite le très jeune spectateur au cœur de sa forêt onirique pour une immersion musicale et sensorielle dans le monde végétal !"
    ],
    "es": [
      "La Cie Lilaho invita a los espectadores más jóvenes al corazón de su bosque de ensueño para una inmersión musical y sensorial en el mundo de las plantas"
    ],
    "nl": [
      "Cie Lilaho nodigt de allerkleinsten uit in het hart van haar droombos voor een muzikale en zintuiglijke onderdompeling in de plantenwereld!"
    ]
  },
