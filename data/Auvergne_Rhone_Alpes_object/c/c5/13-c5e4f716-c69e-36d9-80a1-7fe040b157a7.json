  "rdfs:comment": {
    "de": [
      "Jérôme bietet Ihnen verschiedene Menüs mit saisonalen Speisen. Eine harmonische Mischung der Aromen und Farben und eine gepflegte regionale Küche."
    ],
    "en": [
      "Jérôme Baron-Pélossier, offers you different menus composed according to the seasons. A harmonious mix of flavors, colors and a careful cooking of the soil."
    ],
    "it": [
      "Jérôme Baron-Pélossier, vi propone diversi menu composti in base alle stagioni. Un mix armonioso di sapori, colori e un'attenta cucina locale."
    ],
    "fr": [
      "Jérôme Baron-Pélossier, vous propose différents menus composés au fil des saisons. Un mélange harmonieux de saveurs, de couleurs et une cuisine soignée du terroir."
    ],
    "es": [
      "Jérôme Baron-Pélossier, le propone diferentes menús compuestos según las estaciones. Una armoniosa mezcla de sabores, colores y una cuidada cocina local."
    ],
    "nl": [
      "Jérôme Baron-Pélossier, biedt u verschillende menu's samengesteld volgens de seizoenen. Een harmonieuze mix van smaken, kleuren en een zorgvuldige lokale keuken."
    ]
  },
