  "rdfs:comment": {
    "de": [
      "Es gibt einen Ort in Saint-Etienne, an dem man hyperleicht einen kleinen Sprung um einige zehn Millionen Jahre in die Vergangenheit machen kann."
    ],
    "en": [
      "There's one place in Saint-Étienne where you can take a little leap a few tens of millions of years back in time dead easily."
    ],
    "it": [
      "A Saint-Etienne c'è un luogo in cui è possibile saltare indietro di diverse decine di milioni di anni con estrema facilità."
    ],
    "fr": [
      "Il existe un endroit à Saint-Etienne où l'on peut faire un petit bond de quelques dizaines de millions d’années en arrière hyper facilement."
    ],
    "es": [
      "Hay un lugar en Saint-Etienne donde se puede retroceder en el tiempo unas decenas de millones de años muy fácilmente."
    ],
    "nl": [
      "Er is een plek in Saint-Etienne waar je heel gemakkelijk enkele tientallen miljoenen jaren terug in de tijd kunt stappen."
    ]
