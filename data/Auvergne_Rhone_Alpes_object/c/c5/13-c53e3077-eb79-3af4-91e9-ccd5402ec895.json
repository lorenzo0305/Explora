  "rdfs:comment": {
    "de": [
      "Restaurant Bar Karaoké le Why Not, eine gesellige und leckere Gastronomie vor Ort oder zum Mitnehmen: Spezialitäten aus den Bergen, Pizzas, schmackhafte Burger, Pierrades, dazu eine große Auswahl an Weinen und Cocktails, die jeden Appetit anregen werden."
    ],
    "en": [
      "Restaurant, Bar & Karaoke Why Not: enjoy a friendly and gourmet dining experience on-site or to take away. Mountain specialties, pizzas, delicious burgers and pierrades, accompanied by a fine selection of wines and cocktails to satisfy every appetite."
    ],
    "it": [
      "Why Not Restaurant and Karaoke Bar, un accogliente ristorante gourmet da mangiare o da portare via: specialità di montagna, pizze, gustosi hamburger, pierrades e una raffinata selezione di vini e cocktail per tutti gli appetiti."
    ],
    "fr": [
      "Restaurant Bar Karaoké le Why Not, une restauration conviviale et gourmande sur place ou à emporter : spécialités montagnardes, pizzas, burgers savoureux, pierrades accompagnés d’une belle sélection de vins et de cocktails qui raviront tous les appétits."
    ],
    "es": [
      "Why Not Restaurant and Karaoke Bar, un acogedor restaurante gourmet para comer en casa o para llevar: especialidades de montaña, pizzas, sabrosas hamburguesas, pierrades y una exquisita selección de vinos y cócteles para todos los gustos."
    ],
    "nl": [
      "Restaurant, Bar & Karaoke Why Not: geniet van een gezellige en smakelijke keuken ter plaatse of om mee te nemen. Bergspecialiteiten, pizza’s, heerlijke burgers en pierrades, vergezeld van een mooie selectie wijnen en cocktails die alle eetlust zullen verrukken."
    ]
  },
  "rdfs:label": {
    "en": [
