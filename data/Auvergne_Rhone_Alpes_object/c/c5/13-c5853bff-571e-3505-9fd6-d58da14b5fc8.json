  "rdfs:comment": {
    "de": [
      "Crêpes, Galettes und Spezialitäten aus den Bergen, die aus biologischen und regionalen Zutaten hergestellt werden, in einem zeitlosen Dekor.\r\nVollständig hausgemachte Küche. Wir sind Maître Restaurateur und mit dem Ecotable-Label ausgezeichnet."
    ],
    "en": [
      "Crêpes, savoury buckwheat galettes, and mountain specialities made from organic and locally sourced ingredients, all in a timeless setting.\r\nA fully homemade cuisine. We are Maître Restaurateur and certified Ecotable."
    ],
    "it": [
      "Crêpes, galettes bretoni e specialità di montagna preparate con ingredienti biologici e locali, in un ambiente senza tempo.\r\nUna cucina completamente fatta in casa. Siamo Maître Restaurateur e certificati Ecotable."
    ],
    "fr": [
      "Des crêpes, des galettes et des spécialités montagnardes fabriquées à partir d'ingrédients bio et régionaux dans un décor intemporel.\r\nCuisine entièrement maison. Nous sommes Maître Restaurateur et labellisés Ecotable."
    ],
    "es": [
      "Tortitas, galettes y especialidades de montaña elaboradas con ingredientes ecológicos y regionales en un marco intemporal.\r\nCocina totalmente casera. Somos Maître Restaurateur y tenemos la etiqueta Ecotable."
    ],
    "nl": [
      "Pannenkoeken, galetten en bergspecialiteiten gemaakt met biologische en regionale ingrediënten in een tijdloze omgeving.\r\nVolledig huisgemaakt. We zijn een Maître Restaurateur en hebben het Ecotable label."
    ]
  },
  "rdfs:label": {
