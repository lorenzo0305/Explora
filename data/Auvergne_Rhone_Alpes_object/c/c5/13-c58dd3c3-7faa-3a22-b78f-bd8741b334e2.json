  "rdfs:comment": {
    "de": [
      "Die Auberge du moulin de Charrier befindet sich in einer Mühle aus dem 18. Jahrhundert und bietet Ihnen eine authentische Küche, die aus lokalen, gesunden und natürlichen Produkten zubereitet wird, sowie Getränke und Eis aus der Region. Dienstags Pizzaabend mit im Holzofen gebackener Pizza"
    ],
    "en": [
      "Located in an 18th-century mill, the Charrier Mill Inn serves authentic cuisine prepared with local, healthy and natural products, as well as local drinks and ice creams. Wood-fired pizza evenings on Tuesdays"
    ],
    "it": [
      "Situata accanto a un mulino del XVIII secolo, la locanda Moulin de Charrier serve una cucina autentica preparata con prodotti locali, sani e naturali, oltre a bevande e gelati in stile Ardèche."
    ],
    "fr": [
      "Située près d'un moulin du 18ème siècle, l'auberge du moulin de Charrier vous propose une cuisine authentique préparée avec des produits locaux, sains et naturels, ainsi que des boissons et glaces ardéchoises."
    ],
    "es": [
      "Situada junto a un molino del siglo XVIII, la posada Moulin de Charrier sirve auténtica cocina elaborada con productos locales, sanos y naturales, así como bebidas y helados al estilo de Ardèche."
    ],
    "nl": [
      "De Charrier Mill Inn is gevestigd in een 18e-eeuwse molen en serveert authentieke gerechten bereid met lokale, gezonde en natuurlijke producten, evenals lokale dranken en ijs. Houtgestookte pizza-avonden op dinsdag"
    ]
  },
