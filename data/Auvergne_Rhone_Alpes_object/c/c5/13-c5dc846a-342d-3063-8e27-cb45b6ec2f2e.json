  "rdfs:comment": {
    "de": [
      "Entdecken Sie auf dem Gelände eines alten Schlosses einen außergewöhnlichen Aussichtspunkt über Vic-sur-Cère und das Tal! In diesem Schloss wurde Pierre de Vic geboren, der auch als Mönch von Montaudon bekannt ist und ein Troubadour mit humorvoller Poesie war."
    ],
    "en": [
      "On the site of an ancient castle, discover an exceptional view of Vic-sur-Cère and the valley! This castle was the birthplace of Pierre de Vic, also known as the Moine de Montaudon, a troubadour of humorous poetry."
    ],
    "it": [
      "Sul sito di un antico castello, scoprite una vista eccezionale su Vic-sur-Cère e sulla valle! Questo castello ha dato i natali a Pierre de Vic, noto anche come il Monaco di Montaudon, un trovatore dalla poesia umoristica."
    ],
    "fr": [
      "Sur le site d'un ancien château, découvrez un point de vue exceptionnel sur Vic-sur-Cère et la vallée! C'est dans ce château qu'est né Pierre de Vic, connu également comme le Moine de Montaudon, un troubadour à la poésie humoristique."
    ],
    "nl": [
      "Ontdek op de plaats van een oud kasteel een uitzonderlijk uitzicht op Vic-sur-Cère en de vallei! Dit kasteel was de geboorteplaats van Pierre de Vic, ook bekend als de Monnik van Montaudon, een troubadour met een humoristische poëzie."
    ],
    "es": [
      "En el emplazamiento de un antiguo castillo, descubra un mirador excepcional sobre Vic-sur-Cère y el valle. Este castillo fue el lugar de nacimiento de Pierre de Vic, también conocido como el Monje de Montaudon, trovador de poesía humorística."
    ]
  },
  "rdfs:label": {
