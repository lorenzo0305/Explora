  "rdfs:comment": {
    "de": [
      "Das Radisson Blu Lyon Hotel befindet sich im oberen Teil des Part-Dieu-Turms und bietet einen atemberaubenden Blick auf Lyon und die Alpen. Mit seiner zeitgenössischen Architektur und dem anspruchsvollen Design bietet das kürzlich renovierte Hotel ein ausgezeichnetes Serviceniveau."
    ],
    "en": [
      "Located in the upper part of the Part-Dieu tower, the Radisson Blu Lyon hotel offers a breathtaking view of Lyon and the Alps. With its contemporary architecture and sophisticated design, the recently renovated hotel offers an excellent level of service."
    ],
    "it": [
      "Situato nella parte superiore della torre Part-Dieu, l'hotel Radisson Blu Lyon offre una vista mozzafiato su Lione e sulle Alpi. Con la sua architettura contemporanea e il suo design sofisticato, l'hotel, recentemente rinnovato, offre un eccellente livello di servizio."
    ],
    "fr": [
      "Situé dans la partie supérieure de la tour de la Part-Dieu, l'hôtel Radisson Blu Lyon offre une vue imprenable sur Lyon et les Alpes. A l'architecture contemporaine et au design sophistiqué, l'hôtel, récemment rénové, offre un excellent niveau de service."
    ],
    "es": [
      "Situado en la parte superior de la torre Part-Dieu, el hotel Radisson Blu Lyon ofrece una vista impresionante de Lyon y los Alpes. Con su arquitectura contemporánea y su diseño sofisticado, el hotel, recientemente renovado, ofrece un excelente nivel de servicio."
    ],
    "nl": [
      "Het Radisson Blu Lyon hotel ligt in het bovenste deel van de Part-Dieu toren en biedt een adembenemend uitzicht over Lyon en de Alpen. Met zijn eigentijdse architectuur en verfijnde design biedt het onlangs gerenoveerde hotel een uitstekend serviceniveau."
    ]
  },
