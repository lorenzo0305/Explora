  "rdfs:comment": {
    "de": [
      "Vortrag über Isabeau VINCENT, genannt \"die Hirtin von SAOU\", und die Bewegung der \"kleinen Propheten\". Der Vortrag wird von der Association Comps historique organisiert und von Bernard FORAY-ROUX, Schriftsteller, Referent und Geograf, geleitet."
    ],
    "en": [
      "Conference on Isabeau VINCENT, known as \"the shepherdess of SAOU\", and the \"Little Prophets\" movement. Organized by the Comps historique association and hosted by Bernard FORAY-ROUX, writer, lecturer and geographer."
    ],
    "it": [
      "Conferenza su Isabeau VINCENT, conosciuta come \"la pastora di SAOU e il movimento dei \"piccoli profeti\"\". Organizzata dall'associazione Comps historique e condotta da Bernard FORAY-ROUX, scrittore, docente e geografo."
    ],
    "fr": [
      "Conférence sur Isabeau VINCENT, dite \"la bergère de SAOU et le mouvement des \"petits prophètes\". Conférence organisée par l’association Comps historique et animée par Bernard FORAY-ROUX, écrivain, conférencier et géographe."
    ],
    "nl": [
      "Conferentie over Isabeau VINCENT, bekend als \"de herderin van SAOU en de beweging van de \"kleine profeten\". Georganiseerd door de vereniging Comps historique en geleid door Bernard FORAY-ROUX, schrijver, docent en geograaf."
    ],
    "es": [
      "Conferencia sobre Isabeau VINCENT, conocida como \"la pastora de SAOU y el movimiento de los \"pequeños profetas\". Organizada por la asociación Comps historique y dirigida por Bernard FORAY-ROUX, escritor, conferenciante y geógrafo."
    ]
  },
  "rdfs:label": {
