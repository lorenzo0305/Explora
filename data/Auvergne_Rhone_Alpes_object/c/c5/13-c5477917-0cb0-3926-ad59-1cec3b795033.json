  "rdfs:comment": {
    "de": [
      "Französische Küche mit Einflüssen aus aller Welt, serviert in einer Bar/Restaurant mit zwei Sälen sowie einer sehr schönen Terrasse: eine gemütliche Atmosphäre im Saal und eine festlichere Stimmung in der Bar und auf der Veranda !"
    ],
    "en": [
      "French cuisine with world influences served in a bar/restaurant with two dining rooms and a beautiful terrace: a cosy atmosphere in the dining room and a more festive atmosphere in the bar and veranda !"
    ],
    "it": [
      "Cucina francese da bistrot con influenze mondiali servita in un bar/ristorante con due sale da pranzo e una bella terrazza: un'atmosfera accogliente nella sala da pranzo e un'atmosfera più festosa nel bar e nella veranda!"
    ],
    "fr": [
      "Cuisine française bistronomique aux influences du monde servi dans un bar/restaurant avec deux salles ainsi qu'une très belle terrasse : une ambiance cosy côté salle et une ambiance plus festive côté bar et véranda !"
    ],
    "nl": [
      "Franse bistrokeuken met wereldinvloeden geserveerd in een bar/restaurant met twee eetzalen en een prachtig terras: een gezellige sfeer in de eetzaal en een meer feestelijke sfeer in de bar en veranda!"
    ],
    "es": [
      "Cocina francesa de bistró con influencias del mundo servida en un bar/restaurante con dos comedores y una bonita terraza: ¡un ambiente acogedor en el comedor y un ambiente más festivo en el bar y la terraza!"
    ]
  },
  "rdfs:label": {
