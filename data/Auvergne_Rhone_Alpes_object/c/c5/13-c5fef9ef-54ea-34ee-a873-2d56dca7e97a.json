  "rdfs:comment": {
    "de": [
      "Am Ufer des Flusses Senouire lädt Sie Michel, der sich seit 1980 niedergelassen hat, dazu ein, seine Leidenschaft für Holz zu teilen. Verkaufsausstellung ganzjährig geöffnet, in der Nebensaison nach Vereinbarung."
    ],
    "en": [
      "On the banks of the Senouire, Michel has been working since 1980, and invites you to share his passion for wood. Exhibition and sale open all year round, by appointment out of season."
    ],
    "it": [
      "Situato sulle rive del Senouire, Michel è in attività dal 1980 e vi invita a condividere la sua passione per il legno. Esposizione e vendita aperte tutto l'anno, su appuntamento fuori stagione."
    ],
    "fr": [
      "Au bord de la Senouire, installé depuis 1980, Michel vous invite à partager sa passion du bois. Exposition-vente ouverte toute l'année, sur RDV en hors saison."
    ],
    "es": [
      "Situado a orillas del Senouire, Michel ejerce su oficio desde 1980 y le invita a compartir su pasión por la madera. Exposición y venta abiertas todo el año, con cita previa fuera de temporada."
    ],
    "nl": [
      "Michel is gevestigd aan de oevers van de Senouire en bestaat sinds 1980. Hij nodigt je uit om zijn passie voor hout te delen. Tentoonstelling en verkoop het hele jaar geopend, buiten het seizoen op afspraak."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Michell Estienne | Tourneur sur bois"
    ]
  },
