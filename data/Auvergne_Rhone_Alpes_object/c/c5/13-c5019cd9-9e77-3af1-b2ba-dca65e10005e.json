  "rdfs:comment": {
    "de": [
      "In unmittelbarer Nähe des Sees befindet sich das Restaurant des Campingplatzes Saint-Disdille: In gemütlichem Ambiente ist hier jeder willkommen. Neben den klassischen Grillgerichten können Sie gegrilltes Barschfilet, eine savoyische Spezialität genießen."
    ],
    "en": [
      "Saint-Disdille campsite’s restaurant is just steps from the lake and a friendly place where all are welcome. You can sample the great classics such as grilled meats, pizzas and the Savoie speciality of grilled perch fillets."
    ],
    "it": [
      "A pochi passi dal lago, ritrovate il ristorante del campeggio Saint-Disdille: un vero luogo di convivialità aperto a tutti. Potrete gustare grandi classici come grigliate e pizze, una specialità della Savoia, il filetto di persico alla griglia."
    ],
    "fr": [
      "A quelques pas du lac, retrouvez le restaurant du camping Saint-Disdille: un véritable lieu de convivialité ouvert à tous.\r\nVous pourrez y déguster en plus des grands classiques grillades et pizzas, une spécialité de la Savoie, le filet de perche grillé."
    ],
    "nl": [
      "Op enkele stappen van het meer vindt u het restaurant van camping Saint-Disdille: een echte plek van gezelligheid die voor iedereen toegankelijk is.\r\nNaast de grote klassieke grills en pizza's kunt u genieten van een specialiteit van Savoye, gegrilde baarsfilet."
    ],
    "es": [
      "A pocos pasos del lago, encontrará el restaurante del camping Saint-Disdille: un verdadero lugar de convivencia abierto a todos.\r\nAdemás de las estupendas parrilladas y pizzas clásicas, podrá disfrutar de una especialidad de Saboya, el filete de perca a la parrilla."
    ]
  },
  "rdfs:label": {
    "en": [
      "Restaurant du Camping Le Saint-Disdille"
    ],
    "fr": [
      "Restaurant du Camping Saint-Disdille"
    ]
  },
