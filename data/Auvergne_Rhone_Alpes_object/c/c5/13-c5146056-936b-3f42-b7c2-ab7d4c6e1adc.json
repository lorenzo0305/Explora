  "rdfs:comment": {
    "de": [
      "Qualitativ hochwertiger Unterricht für Männer, Frauen und Kinder.\r\nMethode ohne Wettkampf, Training von Körper und Geist.\r\nProgressionen, Techniken, die an das Alter und die Möglichkeiten der Praktizierenden angepasst sind."
    ],
    "en": [
      "Quality teaching for men, women and children.\r\nNon-competitive method, training the body and mind.\r\nProgressions and techniques adapted to age and ability."
    ],
    "it": [
      "Insegnamento di qualità per uomini, donne e bambini.\r\nMetodo non competitivo, allenamento del corpo e della mente.\r\nProgressioni, tecniche adattate all'età e alle possibilità dei praticanti."
    ],
    "fr": [
      "Enseignement de qualité pour hommes, femmes, enfants.\r\nMéthode sans compétition, entrainement du corps et de l'esprit.\r\nProgressions, techniques adaptées à l'âge et aux possibilités des pratiquants."
    ],
    "nl": [
      "Kwaliteitslessen voor mannen, vrouwen en kinderen.\r\nNiet-competitieve methode, training van lichaam en geest.\r\nProgressies en technieken aangepast aan de leeftijd en vaardigheden van de deelnemers."
    ],
    "es": [
      "Enseñanza de calidad para hombres, mujeres y niños.\r\nMétodo no competitivo, entrenamiento del cuerpo y la mente.\r\nProgresiones, técnicas adaptadas a la edad y posibilidades de los practicantes."
    ]
  },
