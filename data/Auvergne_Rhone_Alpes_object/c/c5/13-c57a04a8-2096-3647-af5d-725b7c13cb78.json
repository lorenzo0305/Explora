  "rdfs:comment": {
    "de": [
      "Im Rahmen der Europäischen Tage der Kunsthandwerke öffnet der Kunsttischler Julien Filhol, der sich vor kurzem in Romans niedergelassen hat, die Türen seiner Werkstatt.\r\nFreier Zugang ohne Voranmeldung."
    ],
    "en": [
      "As part of the Journées Européennes des Métiers d'Art, cabinetmaker Julien Filhol, recently settled in Romans, opens the doors of his workshop.\r\nFree access without appointment."
    ],
    "it": [
      "Nell'ambito delle Giornate europee dell'artigianato, l'ebanista Julien Filhol, recentemente trasferitosi a Roma, apre le porte del suo laboratorio.\r\nAccesso libero senza appuntamento."
    ],
    "fr": [
      "Dans le cadre des Journées Européennes des Métiers d'Art, l’ébéniste Julien Filhol, récemment installé sur Romans, vous ouvre les portes de son atelier.\r\nAccès libre sans rendez-vous."
    ],
    "nl": [
      "In het kader van de Europese Ambachtsdagen opent meubelmaker Julien Filhol, die onlangs naar Rome is verhuisd, de deuren van zijn werkplaats.\r\nVrije toegang zonder afspraak."
    ],
    "es": [
      "En el marco de los Días Europeos de la Artesanía, el ebanista Julien Filhol, recientemente instalado en Roma, abre las puertas de su taller.\r\nAcceso libre sin cita previa."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Portes ouvertes de l'atelier d'ébénisterie de Julien Filhol - Journées Européennes des Métiers d'Art"
    ]
  },
