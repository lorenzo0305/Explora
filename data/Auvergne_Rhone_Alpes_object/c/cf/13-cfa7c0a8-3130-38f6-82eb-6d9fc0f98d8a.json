  "rdfs:comment": {
    "de": [
      "Wir sind seit 1963 eine Familienkäserei und stellen aus der Milch unserer partnereigenen Züchter Ziegenkäse aus Rohmilch her und bieten ein spezielles Ziegensortiment vom Faisselle bis zum reifsten Käse an."
    ],
    "en": [
      "Goat's milk cheese: Tommes, picodons (AOC Picodons) …  \r\nFarm-gate sales from Monday to Saturday from 9am to midday.  \r\nOn leaving the village, follow the road signs for Ferme Capra."
    ],
    "it": [
      "Caseificio a conduzione familiare dal 1963, produciamo formaggi di capra a latte crudo con il latte dei nostri allevatori partner e offriamo una gamma speciale di formaggi di capra, dalle faisselle ai più stagionati."
    ],
    "fr": [
      "Fromagerie familiale depuis 1963, nous élaborons, à partir de lait de nos éleveurs partanaires, des fromages de chèvre au lait cru et proposons une gamme spéciale chèvre de la faisselle au plus affiné."
    ],
    "es": [
      "Quesería familiar desde 1963, elaboramos quesos de leche cruda de cabra a partir de la leche de nuestros ganaderos asociados, y ofrecemos una gama especial de quesos de cabra, desde el faisselle hasta el más curado."
    ],
    "nl": [
      "Geitenkaas: tomme (kortgerijpte kaas), picodon (AOC Picodon), etc.\r\nVerkoop bij de boerderij van maandag tot zaterdag, 9.00-12.00 u.\r\nVanaf het dorp volgt u de borden Ferme Capra."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Tomme Capra"
    ]
  },
