  "rdfs:comment": {
    "de": [
      "Entdecken Sie den roten Parcours der Base de Lavalette: 1 km Orientierungslauf inmitten einer geschützten Naturlandschaft. Dieser leicht zugängliche und spielerische Weg lädt Sie dazu ein, 13 Markierungen in 45 Minuten zu erkunden. Er ist perfekt für einen Ausflug mit der Familie oder mit Freunden."
    ],
    "en": [
      "Discover the red course at Base de Lavalette: 1 km of orienteering in the heart of a preserved natural setting. Accessible and fun, it invites you to explore 13 markers in 45 minutes, perfect for a getaway with family or friends."
    ],
    "it": [
      "Scoprite il percorso rosso della Base de Lavalette: 1 km di orienteering nel cuore di una natura protetta. Accessibile e divertente, invita a esplorare 13 punti in 45 minuti, perfetto per una fuga in famiglia o con gli amici."
    ],
    "fr": [
      "Découvrez le parcours rouge de la Base de Lavalette : 1 km d’orientation au cœur d’un cadre naturel préservé. Accessible et ludique, il vous invite à explorer 13 balises en 45 minutes, parfait pour une escapade en famille ou entre amis."
    ],
    "nl": [
      "Ontdek het rode parcours van de Base de Lavalette: 1 km oriëntatieloop in het hart van een beschermd natuurgebied. Toegankelijk en leuk, het nodigt je uit om 13 markers te verkennen in 45 minuten, perfect voor een uitje met familie of vrienden."
    ],
    "es": [
      "Descubra el sendero rojo de la Base de Lavalette: 1 km de orientación en el corazón de un entorno natural protegido. Accesible y divertido, invita a explorar 13 balizas en 45 minutos, perfecto para una escapada en familia o con amigos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parcours rouge d'orientation de Lavalette"
    ]
  },
