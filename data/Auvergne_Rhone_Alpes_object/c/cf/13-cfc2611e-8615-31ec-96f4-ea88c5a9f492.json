  "rdfs:comment": {
    "de": [
      "Schließen Sie sich Climbing for Life 2026 in Alpe d'Huez an und erleben Sie einzigartige sportliche Herausforderungen! Ob Radfahrer, Trailrunner oder Wanderer, testen Sie Ihre Ausdauer auf unvergesslichen Strecken. Ein intensives nationales Abenteuer wartet auf Sie!"
    ],
    "en": [
      "Join Climbing for Life 2026 at Alpe d'Huez for unique sporting challenges! Cyclists, trail runners and hikers, test your endurance on unforgettable routes. An intense national adventure awaits you!"
    ],
    "it": [
      "Unitevi a Climbing for Life 2026 all'Alpe d'Huez per sfide sportive uniche! Ciclisti, trail runner ed escursionisti, mettete alla prova la vostra resistenza su percorsi indimenticabili. Un'intensa avventura nazionale vi aspetta!"
    ],
    "fr": [
      "Rejoignez Climbing for Life 2026 à l'Alpe d'Huez pour des défis sportifs uniques! Cyclistes, coureurs de trail et randonneurs, testez votre endurance sur des parcours inoubliables. Une aventure nationale intense vous attend!"
    ],
    "es": [
      "Únete a Climbing for Life 2026 en Alpe d'Huez y participa en desafíos deportivos únicos Ciclistas, corredores de trail y senderistas, pongan a prueba su resistencia en rutas inolvidables. ¡Te espera una intensa aventura nacional!"
    ],
    "nl": [
      "Doe mee met Climbing for Life 2026 in Alpe d'Huez voor een aantal unieke sportieve uitdagingen! Fietsers, trailrunners en wandelaars, test je uithoudingsvermogen op onvergetelijke routes. Er staat je een intens nationaal avontuur te wachten!"
    ]
  },
