  "rdfs:comment": {
    "de": [
      "Machen Sie eine Schlemmerpause am schönsten Süßwasserweg Frankreichs und genießen Sie die hausgemachten Qualitätsburger zum Mitnehmen oder vor Ort dank unserer geschützten Panoramaterrasse."
    ],
    "en": [
      "Take a gourmet break along France's most beautiful greenway and enjoy high-quality homemade burgers to take away or eat in on our sheltered panoramic terrace."
    ],
    "it": [
      "Concedetevi una pausa gourmet sulle rive della più bella autostrada della Francia e gustate i nostri hamburger fatti in casa di qualità da portare via o in loco sulla nostra terrazza panoramica riparata."
    ],
    "fr": [
      "Faites une pause gourmande au bord de la plus belle voie douce de France et dégustez les burgers de qualité fait maison à emporter ou sur place grâce à notre terrasse panoramique abritée."
    ],
    "nl": [
      "Neem een gastronomische pauze aan de oevers van de mooiste weg van Frankrijk en geniet van onze zelfgemaakte kwaliteitsburgers om mee te nemen of ter plekke op ons beschutte panoramische terras."
    ],
    "es": [
      "Disfrute de una pausa gastronómica a orillas de la autopista más bella de Francia y saboree nuestras hamburguesas caseras de calidad para llevar o en nuestra terraza panorámica protegida."
    ]
  },
