  "rdfs:comment": {
    "de": [
      "Die Association Tricastine pour le Respect de l'Enfant soll Kindern helfen, sexuelle, physische oder psychologische Angriffe zu erkennen und darauf zu reagieren."
    ],
    "en": [
      "The Association Tricastine pour le Respect de l'Enfant aims to help children identify and react to sexual, physical or psychological aggression."
    ],
    "it": [
      "L'Associazione Tricastina per il Rispetto dei Bambini si propone di aiutare i bambini a identificare e reagire alle aggressioni sessuali, fisiche o psicologiche."
    ],
    "fr": [
      "L'Association Tricastine pour le Respect de l'Enfant a pour but d'aider les enfants à identifier et réagir face aux agressions sexuelles, physiques ou psychologiques."
    ],
    "es": [
      "La Asociación Tricastina para el Respeto de los Niños tiene como objetivo ayudar a los niños a identificar y reaccionar ante las agresiones sexuales, físicas o psicológicas."
    ],
    "nl": [
      "De Tricastine Association for the Respect of Children wil kinderen helpen om seksuele, fysieke of psychologische agressie te herkennen en erop te reageren."
    ]
  },
