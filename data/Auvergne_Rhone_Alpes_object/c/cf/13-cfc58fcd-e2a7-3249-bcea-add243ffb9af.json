  "rdfs:comment": {
    "de": [
      "Entdecken Sie eines der schönsten Panoramen der Alpen vom Gipfel des Mont-Jovet (2558 m) aus. Ein Orientierungstisch am Ziel hilft Ihnen, die umliegenden Gipfel zu identifizieren!"
    ],
    "en": [
      "Discover one of the most beautiful panoramas of the Alps from the summit of Mont-Jovet (2558 m), an orientation table on arrival facilitate the identification of the surrounding peaks!"
    ],
    "it": [
      "Scoprite uno dei più bei panorami delle Alpi dalla cima del Mont-Jovet (2558 m). Una tabella di orientamento all'arrivo vi aiuterà a individuare le cime circostanti!"
    ],
    "fr": [
      "Découvrez l'un des plus beaux panorama des Alpes depuis la cime du Mont-Jovet (2558 m), une table d'orientation à l'arrivée vous permettra d'identifier les sommets alentours !"
    ],
    "nl": [
      "Ontdek een van de mooiste panorama's in de Alpen vanaf de top van de Mont-Jovet (2558 m). Een oriëntatietafel bij de finish helpt je de omliggende bergtoppen te identificeren!"
    ],
    "es": [
      "Descubra uno de los panoramas más bellos de los Alpes desde la cima del Mont-Jovet (2558 m). ¡Una tabla de orientación en la meta le ayudará a identificar las cumbres circundantes!"
    ]
  },
  "rdfs:label": {
    "en": [
      "Mont-Jovet Summit"
    ],
    "fr": [
      "Sommet du Mont Jovet (Notre Dame du Pré)"
    ]
  },
