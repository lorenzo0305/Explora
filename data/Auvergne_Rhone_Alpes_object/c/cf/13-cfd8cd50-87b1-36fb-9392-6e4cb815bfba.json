  "rdfs:comment": {
    "de": [
      "Ich bin Jézabel, eine Lederwarenhändlerin aus Chabeuil in der Drôme.\r\nIch engagiere mich sehr für die Ökologie und die Sache der Tiere und habe Sac'Étik, ein pflanzliches Lederwarengeschäft, das zu 100% vegan ist, gegründet."
    ],
    "en": [
      "100% vegan plant-based leather goods. Unique creations designed in an eco-responsible manner using materials derived from agricultural waste (pineapple, apple, cactus, etc.).\r\nBags, accessories, bracelets.\r\nSales only online and at designer markets."
    ],
    "it": [
      "Sono Jézabel, un artigiano pellettiere con il mio laboratorio a Romans-sur-Isère\r\nMolto impegnata sul fronte dell'ecologia e della causa animale, ho creato Sac?Étik, una pelletteria 100% vegana a base vegetale."
    ],
    "fr": [
      "Je suis Jézabel artisane maroquinière, j'ai ma boutique atelier à Romans-sur-Isère\r\nTrès engagée pour l’écologie et la cause animale, j’ai créé Sac’Étik maroquinerie végétale 100% vegan."
    ],
    "es": [
      "Soy Jézabel, marroquinera artesana con taller propio en Romans-sur-Isère\r\nMuy comprometida con la ecología y la causa animal, he creado Sac'Étik, una marroquinería vegetal 100% vegana."
    ],
    "nl": [
      "100% veganistische lederwaren op plantaardige basis. Unieke creaties ontworpen op een ecologisch verantwoorde manier met materialen afkomstig van landbouwafval (ananas, appel, cactus, enz.).\r\nTassen, accessoires, armbanden.\r\nAlleen online en op designermarkten verkrijgbaar."
    ]
  },
  "rdfs:label": {
