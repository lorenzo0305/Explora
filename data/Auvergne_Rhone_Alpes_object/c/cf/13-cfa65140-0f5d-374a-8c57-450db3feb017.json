  "rdfs:comment": {
    "de": [
      "Thierry bietet Ihnen am Freitag- und Samstagabend in Boën sur-Lignon traditionelle Pizzas an. Außerdem können Sie ihn mit seinen Brathähnchen dienstagmorgens in Feurs,mittwochmorgens in Moingt und donnerstagmorgens in Boën-sur-Lignon finden."
    ],
    "en": [
      "Thierry proposes traditional pizzas on Friday and Saturday evenings in Boën-sur-Lignon. You’ll also find him selling whole roast chicken on Tuesday mornings in Feurs, Wednesday mornings in Moingt and Thursday mornings in Boën-sur-Lignon."
    ],
    "it": [
      "Thierry vi propone le sue pizze tradizionali e il suo pollo arrosto sui diversi mercati della regione\r\nPossibilità di ordinare per telefono."
    ],
    "fr": [
      "Thierry vous propose ses pizzas traditionnelles ainsi que ses poulets rôtis sur les différents marchés de la région. \r\nPossibilité de commander par téléphone."
    ],
    "es": [
      "Thierry le ofrece sus pizzas tradicionales así como su pollo asado en los diferentes mercados de la región\r\nPosibilidad de hacer pedidos por teléfono."
    ],
    "nl": [
      "Thierry biedt u zijn traditionele pizza's en zijn gebraden kip op de verschillende markten van de regio\r\nMogelijkheid om per telefoon te bestellen."
    ]
  },
