  "rdfs:comment": {
    "de": [
      "Möchten Sie sich in einem eintägigen Workshop im Theaterspielen versuchen? Entdecken Sie diese Spiele und Herausforderungen mit Alexandre Moutet, Schauspieler, Regisseur und Leiter von Tryd'Art! Kommen Sie zahlreich!"
    ],
    "en": [
      "Would you like to try your hand at theater during a one-day workshop? Discover these games and challenges with Alexandre Moutet, actor, director and director of Tryd'Art! Come one, come all!"
    ],
    "it": [
      "Volete cimentarvi con il teatro durante un corso di un giorno? Scoprite questi giochi e problemi con Alexandre Moutet, attore, regista e direttore di Tryd'Art! Venite uno, venite tutti!"
    ],
    "fr": [
      "Vous souhaitez vous essayer au théâtre lors d'un stage d'une journée ? Découvrez ces jeux et enjeux avec par Alexandre Moutet, comédien, metteur en scène et directeur de Tryd'Art ! Venez nombreux !"
    ],
    "es": [
      "¿Le gustaría probar suerte en el teatro durante un curso de un día? ¡Descubre estos juegos y cuestiones con Alexandre Moutet, actor, director y realizador de Tryd'Art! ¡Venga uno, vengan todos!"
    ],
    "nl": [
      "Wil je graag theater spelen tijdens een eendaagse cursus? Ontdek deze spelletjes en thema's met Alexandre Moutet, acteur, regisseur en directeur van Tryd'Art! Komt allen!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Stage journée : découverte théâtre"
    ]
  },
