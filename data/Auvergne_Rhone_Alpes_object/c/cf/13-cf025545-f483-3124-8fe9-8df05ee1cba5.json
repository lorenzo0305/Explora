  "rdfs:comment": {
    "de": [
      "Genießen Sie in einer warmen und freundlichen Umgebung eine traditionelle und einfallsreiche Küche mit frischen Produkten, die auf den Märkten ausgewählt und zu 100 % hausgemacht sind."
    ],
    "en": [
      "In a warm and friendly atmosphere, come and enjoy traditional and inventive cuisine with fresh products selected on the markets, and cooked 100% homemade."
    ],
    "it": [
      "In un ambiente caldo e accogliente, venite a gustare una cucina tradizionale e inventiva con prodotti freschi selezionati dai mercati e cucinati al 100% in casa."
    ],
    "fr": [
      "Dans un cadre chaleureux et convivial, venez savourer une cuisine traditionnelle et inventive avec des produits frais sélectionnés sur les marchés, et cuisinés 100% maison."
    ],
    "nl": [
      "Kom in een warm en vriendelijk kader genieten van een traditionele en inventieve keuken met verse producten van de markt en 100% zelf gekookt."
    ],
    "es": [
      "En un ambiente cálido y acogedor, venga a disfrutar de una cocina tradicional e inventiva con productos frescos seleccionados en los mercados y cocinados 100% en casa."
    ]
  },
