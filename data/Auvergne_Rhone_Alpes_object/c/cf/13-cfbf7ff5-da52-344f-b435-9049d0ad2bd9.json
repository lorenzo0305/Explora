  "rdfs:comment": {
    "de": [
      "Seit 2016 züchten wir Angora-Ziegen.  Wir haben uns in diese zahmen und liebevollen Tiere verliebt und geben diesem Tier den Platz, der ihm zusteht, indem wir seine Wolle aufwerten: MOHAIR.\r\n\r\nBesuchen Sie unseren Hof und lernen Sie unsere Ziegen kennen!"
    ],
    "en": [
      "We've been breeding Angora goats since 2016.  We fell in love with these docile, affectionate animals and we give this animal its rightful place, by valorizing its wool: MOHAIR.\r\n\r\nCome and visit the farm and meet our goats!"
    ],
    "it": [
      "Alleviamo capre d'angora dal 2016.  Ci siamo innamorati di questi animali docili e affettuosi e stiamo dando a questo animale il posto che gli spetta promuovendo la sua lana: la MOHAIR.\r\n\r\nVenite a visitare la fattoria e a conoscere le nostre capre!"
    ],
    "fr": [
      "Nous élevons depuis 2016 des chèvres Angora.  Nous sommes tombés amoureux de ces animaux dociles et affectueux et nous donnons à cet animal  la place qui lui revient, en valorisant sa laine : le MOHAIR.\r\n\r\nVenez visiter la ferme et rencontrer nos chèvres !"
    ],
    "nl": [
      "Sinds 2016 fokken we Angorageiten.  We zijn verliefd geworden op deze volgzame, aanhankelijke dieren en we geven dit dier zijn rechtmatige plaats door zijn wol te promoten: MOHAIR.\r\n\r\nKom langs op de boerderij en ontmoet onze geiten!"
    ],
    "es": [
      "Llevamos criando cabras de Angora desde 2016.  Nos hemos enamorado de estos animales dóciles y cariñosos y estamos dando a este animal el lugar que le corresponde mediante la promoción de su lana: MOHAIR.\r\n\r\n¡Ven a visitar la granja y conoce a nuestras cabras!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Lou Pagora"
    ]
  },
