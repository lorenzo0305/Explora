  "rdfs:comment": {
    "de": [
      "Das Sully bietet Ihnen eine einfache, großzügige Küche, die mit ausgewählten Produkten von Erzeugern aus der Umgebung zubereitet wird.\r\nKommen Sie also so, wie Sie sind, nehmen Sie Platz und lassen Sie sich von dieser herzlichen Atmosphäre tragen."
    ],
    "en": [
      "Le Sully offers simple, generous cuisine prepared with products selected from local producers.\r\nSo come as you are, take a seat and let yourself be carried away by the warm atmosphere."
    ],
    "it": [
      "Le Sully offre una cucina semplice e generosa, preparata con prodotti selezionati da produttori locali.\r\nVenite come siete, accomodatevi e lasciatevi trasportare dalla calda atmosfera."
    ],
    "fr": [
      "Le Sully vous propose une cuisine simple, généreuse et préparée avec des produits choisis chez les producteurs du coin.\r\nAlors venez comme vous êtes, installez vous, et laissez vous porter par cette ambiance chaleureuse."
    ],
    "es": [
      "Le Sully ofrece una cocina sencilla y generosa elaborada con productos seleccionados entre los productores locales.\r\nAsí que venga como sea, tome asiento y déjese llevar por el cálido ambiente."
    ],
    "nl": [
      "Le Sully biedt een eenvoudige, gulle keuken bereid met producten van lokale producenten.\r\nDus kom zoals je bent, neem plaats en laat je meevoeren door de warme sfeer."
    ]
  },
