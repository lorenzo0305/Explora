  "rdfs:comment": {
    "de": [
      "Willkommen bei Chez Bidule! Eine gesellige Adresse, an der man sich trifft, um gemeinsam einen Moment an einem guten Tisch zu verbringen. Chefkoch Johnny Halidi bereitet eine Küche zu, die Tradition und Moderne miteinander verbindet und auf frischen, saisonalen und möglichst lokalen Produkten basiert."
    ],
    "en": [
      "Welcome to Chez Bidule! A convivial address where you can share a moment around a good table. Chef Johnny Halidi's cuisine blends tradition and modernity, using fresh, seasonal and local produce."
    ],
    "it": [
      "Benvenuti a Chez Bidule! Un luogo accogliente in cui condividere un momento di relax davanti a un buon piatto. Lo chef Johnny Halidi prepara una cucina che fonde tradizione e modernità, utilizzando prodotti freschi, di stagione e, per quanto possibile, locali."
    ],
    "fr": [
      "Bienvenue Chez Bidule ! Une adresse conviviale où l’on se retrouve pour partager un moment autour d’une bonne table. Le chef Johnny Halidi élabore une cuisine mêlant tradition et modernité, à base de produits frais, de saison et au maximum locaux."
    ],
    "es": [
      "¡Bienvenido a Chez Bidule! Un lugar acogedor donde compartir un momento en torno a una buena comida. El Chef Johnny Halidi elabora una cocina que mezcla tradición y modernidad, utilizando productos frescos, de temporada y, en la medida de lo posible, locales."
    ],
    "nl": [
      "Welkom bij Chez Bidule! Een gezellige plek waar je een moment kunt delen onder het genot van lekker eten. Chef-kok Johnny Halidi bereidt een keuken die traditie en moderniteit combineert, met verse, seizoensgebonden en, voor zover mogelijk, lokale producten."
    ]
  },
