  "rdfs:comment": {
    "de": [
      "Die Wassersportbasis des Sees\r\n\r\nGenießen Sie Ihren Aufenthalt inmitten der Natur an den Ufern des Lac de Montriond in vollen Zügen, indem Sie mit dem Paddel oder dem Kanu über das türkisfarbene Wasser fahren."
    ],
    "en": [
      "The lake's water sports centre\r\n\r\nMake the most of your stay in the heart of nature on the shores of Lake Montriond by paddling or canoeing on the turquoise waters."
    ],
    "it": [
      "La base nautica del lago\r\n\r\nApprofittate del vostro soggiorno nel cuore della natura sulle rive del Lago di Montriond per pagaiare o andare in canoa sulle acque turchesi."
    ],
    "fr": [
      "La base nautique du Lac\r\n\r\nProfitez pleinement de votre séjour en pleine nature sur les bords du Lac de Montriond en naviguant en paddle et en canoé sur des eaux turquoises."
    ],
    "es": [
      "La base náutica del Lago\r\n\r\nAproveche su estancia en plena naturaleza, a orillas del lago de Montriond, para practicar remo o piragüismo en sus aguas turquesas."
    ],
    "nl": [
      "De nautische basis van het meer\r\n\r\nGeniet optimaal van je verblijf in het hart van de natuur aan de oevers van het meer van Montriond door te peddelen of kanoën op het turquoise water."
    ]
  },
