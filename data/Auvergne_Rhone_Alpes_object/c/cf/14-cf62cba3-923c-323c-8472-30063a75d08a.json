      "@id": "https://data.datatourisme.fr/d2c5d24c-96d0-308a-81e7-10d8839c30e8",
      "dc:description": {
        "de": [
          "Boutique für Prêt-à-porter, Accessoires, Lederwaren und Schuhe für Männer, Frauen und Kinder.\n\nTäglich von 10:00 bis 13:00 Uhr und von 14:00 bis 19:00 Uhr geöffnet."
        ],
        "en": [
          "Ready-to-wear boutique, accessories, leather goods and shoes for men, women and children.\n\nOpen daily from 10am to 1pm and from 2pm to 7pm."
        ],
        "it": [
          "Negozio di prêt-à-porter, accessori, pelletteria e scarpe per uomo, donna e bambino.\n\nAperto tutti i giorni dalle 10.00 alle 13.00 e dalle 14.00 alle 19.00."
        ],
        "fr": [
          "Boutique prêt-à-porter, accessoires, maroquinerie et chaussures pour hommes, femmes et enfants.\n\nOuvert tous les jours de 10h à 13h et de 14h à 19h."
        ],
        "es": [
          "Tienda de prêt-à-porter, accesorios, marroquinería y calzado para hombre, mujer y niño.\n\nAbierto todos los días de 10.00 a 13.00 y de 14.00 a 19.00."
        ],
        "nl": [
          "Confectiewinkel, accessoires, lederwaren en schoenen voor mannen, vrouwen en kinderen.\n\nElke dag geopend van 10.00 tot 13.00 uur en van 14.00 tot 19.00 uur."
        ]
      },
