  "rdfs:comment": {
    "de": [
      "Dieses kleine Restaurant im Herzen des Dorfes empfängt Sie in einer familiären Atmosphäre."
    ],
    "en": [
      "This small restaurant, located in the heart of the village, boasts a friendly family atmosphere. In summer, enjoy lunch or dinner on the terrace. Traditional\r\ncuisine and speciality cheese dishes."
    ],
    "it": [
      "Questo piccolo ristorante situato nel cuore del villaggio vi accoglie in un ambiente familiare. In estate approittate di una piacevole terrazza per i vostri pranzi e cene. La cucina è tradizionale, impreziosita da specialità casearie.Piatti da asporto."
    ],
    "fr": [
      "Ce petit restaurant situé au cœur du village vous accueille dans une ambiance familiale."
    ],
    "es": [
      "Este pequeño restaurante en el corazón del pueblo le da la bienvenida en un ambiente familiar."
    ],
    "nl": [
      "Dit kleine restaurant in het hart van het dorp verwelkomt je in een familiale sfeer."
    ]
  },
