  "rdfs:comment": {
    "de": [
      "Im Herzen des Dorfes empfängt Sie die Gemeindebibliothek von Châtel das ganze Jahr über."
    ],
    "en": [
      "The municipal library is in the village centre, next to Place de l’Église on the ground floor of the Maison de Vallets."
    ],
    "it": [
      "Nel cuore del villaggio, la biblioteca comunale di Châtel vi accoglie tutto l'anno."
    ],
    "fr": [
      "Au cœur du village, la bibliothèque municipale de Châtel vous accueille tout au long de l’année."
    ],
    "nl": [
      "In het hart van het dorp heet de gemeentebibliotheek u welkom, tegenover het kerkplein, op de benedenverdieping van het huis Les Vallets."
    ],
    "es": [
      "En el corazón del pueblo, la biblioteca municipal de Châtel le da la bienvenida durante todo el año."
    ]
  },
