  "rdfs:comment": {
    "de": [
      "Verlassen Sie die klassischen Routen mit diesem schönen Rundweg um die Tournette, den symbolträchtigen Berg des Beckens von Ancona. Die Ruhe und die zahlreichen Aussichtspunkte auf die Bauges und die Aravis werden Sie begeistern!"
    ],
    "en": [
      "Take a break from the classic itineraries with this beautiful loop around La Tournette, the emblematic mountain of the Annecy region. You'll enjoy the peace and quiet and the many views of the Bauges and Aravis mountains!"
    ],
    "it": [
      "Prendete una pausa dagli itinerari classici con questo bellissimo giro intorno a La Tournette, la montagna emblematica della regione di Annecy. Godrete della pace e della tranquillità e dei numerosi punti panoramici sui monti Bauges e Aravis!"
    ],
    "fr": [
      "Sortez des itinéraires classiques avec cette belle boucle autour de la Tournette, montagne emblématique du bassin annécien. La tranquillité et les nombreux points de vue sur les Bauges et les Aravis seront au rendez-vous !"
    ],
    "nl": [
      "Neem even afstand van de klassieke routes met deze prachtige lus rond La Tournette, de emblematische berg van de regio Annecy. Je zult genieten van de rust en de vele uitzichtpunten over de Bauges en het Aravisgebergte!"
    ],
    "es": [
      "Aléjese de los itinerarios clásicos con este hermoso bucle alrededor de La Tournette, la montaña emblemática de la región de Annecy. ¡Disfrutará de la tranquilidad y de los numerosos miradores sobre los montes Bauges y Aravis!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Tour Gravel Tournette - Itinéraire cyclo"
    ]
  },
