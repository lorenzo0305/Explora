  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/afca0a2a-0db2-3973-b409-057e458945db",
      "dc:description": {
        "de": [
          "Dieser Verein hat folgende Ziele\n- unterstützung des Museums, Ausstellungen, Konferenzen, kulturelle Veranstaltungen.\n- zur Bereicherung der Sammlungen des Museums durch Ankäufe beitragen.\n- beitrag zum Dokumentationsbestand durch Ankäufe, Beitrag zu Veröffentlichungen, in Zusammenarbeit mit dem Museumsteam."
        ],
        "en": [
          "This association aims to\n- support the museum with exhibitions, conferences and cultural events.\n- contribute to the enrichment of the Museum?s collections through acquisitions.\n- contribute to the documentary holdings through acquisitions, contribute to publications, in collaboration with the museum team."
        ],
        "it": [
          "Questa associazione ha lo scopo di\n- sostenere il museo con mostre, conferenze ed eventi culturali.\n- contribuire all'arricchimento delle collezioni del Museo attraverso acquisizioni.\n- contribuire al patrimonio documentario attraverso acquisizioni, contribuire alle pubblicazioni, in collaborazione con il team del museo."
        ],
        "fr": [
          "Cette association vise à \n- apporter son appui au musée, expositions, conférences, animations culturelles. \n- contribuer à l’enrichissement des collections du Musée par des acquisitions.\n- contribuer au fonds documentaire par des acquisitions, contribuer aux publications, en collaboration avec l’équipe du musée."
        ],
        "es": [
          "Esta asociación tiene por objeto\n- apoyar al museo con exposiciones, conferencias y actos culturales.\n- contribuir al enriquecimiento de las colecciones del museo mediante adquisiciones.\n- contribuir al fondo documental mediante adquisiciones, contribuir a las publicaciones, en colaboración con el equipo del museo."
        ],
        "nl": [
          "Deze vereniging heeft als doel\n- het museum te ondersteunen met tentoonstellingen, lezingen en culturele evenementen.\n- bijdragen aan de verrijking van de collecties van het museum door middel van aankopen.\n- bijdragen aan het documentaire bezit door middel van aankopen, bijdragen aan publicaties, in samenwerking met het team van het museum."
        ]
      },
      "@type": [
        "Description"
      ],
