  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Welt der Bienen und der Heil- und Gewürzpflanzen. Der Laden ist von fünf Gärten umgeben, darunter: der Garten des Glaubens und der Garten der Giftpflanzen."
    ],
    "en": [
      "Come and discover the world of bees and medicinal and aromatic plants. The store is surrounded by 5 gardens, including the Garden of Beliefs and the Garden of Poisonous Plants."
    ],
    "it": [
      "Venite a scoprire il mondo delle api e delle piante medicinali e aromatiche. Il negozio è circondato da 5 giardini, tra cui il Giardino delle Credenze e il Giardino delle Piante Velenose."
    ],
    "fr": [
      "Venez découvrir le monde des abeilles et des plantes médicinales et aromatiques. La boutique est entourée par 5 jardins dont : le jardin des croyances et le jardin des plantes toxiques."
    ],
    "es": [
      "Venga a descubrir el mundo de las abejas y las plantas medicinales y aromáticas. La tienda está rodeada de 5 jardines, entre ellos el Jardín de las Creencias y el Jardín de las Plantas Venenosas."
    ],
    "nl": [
      "Kom en ontdek de wereld van bijen en geneeskrachtige en aromatische planten. De winkel wordt omringd door 5 tuinen, waaronder de Tuin der Overtuigingen en de Tuin der Giftige Planten."
    ]
  },
  "rdfs:label": {
    "en": [
      "The house of honey and plants"
    ],
    "fr": [
      "La maison du miel et des plantes"
    ]
  },
