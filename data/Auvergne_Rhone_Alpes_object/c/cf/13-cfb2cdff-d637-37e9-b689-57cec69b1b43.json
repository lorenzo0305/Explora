  "rdfs:comment": {
    "de": [
      "Dorf Blassac: Alte Kirche mit Wandmalereien aus dem 14. Jh., Pietà aus dem 15. Jh. und einem schönen Schrank aus dem 15. Bronzekreuz auf dem Platz. Häuser der Weinbauern. Vulkan von Pié Rouge. Panoramablick auf den Allier."
    ],
    "en": [
      "Village of Blassac: Old church with 14th-century murals, 15th-century Pietà and beautiful 15th-century armoire. Bronze cross in the square. Winegrowers' houses. Pié Rouge volcano. Panoramic view of the Allier."
    ],
    "it": [
      "Villaggio di Blassac: antica chiesa con dipinti murali del XIV secolo, Pietà del XV secolo e bellissimo armadio del XV secolo. Croce di bronzo nella piazza. Case di viticoltori. Vulcano Pié Rouge. Vista panoramica sull'Allier."
    ],
    "fr": [
      "Village de Blassac : Église ancienne avec peintures murales du XIVe siècle, Pietà du XVe siècle et belle armoire du XVe siècle. Croix en bronze sur la place. Maisons vigneronnes. Volcan du Pié Rouge. Vue panoramique sur l’Allier."
    ],
    "es": [
      "Pueblo de Blassac: Antigua iglesia con pinturas murales del siglo XIV, Piedad del siglo XV y hermoso armario del siglo XV. Cruz de bronce en la plaza. Casas de viticultores. Volcán Pié Rouge. Vista panorámica del Allier."
    ],
    "nl": [
      "Dorp Blassac: Oude kerk met 14e-eeuwse muurschilderingen, 15e-eeuwse Pietà en prachtige 15e-eeuwse garderobe. Bronzen kruis op het plein. Huizen van wijnboeren. Vulkaan Pié Rouge. Panoramisch uitzicht op de Allier."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Village | Blassac"
    ]
  },
