  "rdfs:comment": {
    "de": [
      "Restaurant am Fuße der Pisten. Entdecken Sie Les Premières Loges: Frühstück ab 9 Uhr, Brasserie am Mittag mit hausgemachten Gerichten, Snacks, Non-Stop-Getränken, Goûter und Après-Ski in einer herzlichen und freundlichen Atmosphäre."
    ],
    "en": [
      "Restaurant located at the foot of the slopes, come and discover Les Premières Loges: breakfast from 9am, lunchtime brasserie with home-made dishes, snacking, non-stop drinks, snacks and après-ski in a warm, friendly atmosphere."
    ],
    "it": [
      "Ristorante ai piedi delle piste, venite a scoprire Les Premières Loges: colazione dalle 9, brasserie a pranzo con piatti fatti in casa, spuntini, bevande non-stop, snack e après-ski in un'atmosfera calda e accogliente."
    ],
    "fr": [
      "Restaurant situé au pied des pistes, venez découvrir les Premières Loges : petit-déjeuner dès 9h, brasserie le midi avec plats faits maison, snacking, boissons non stop, gouter et après-ski dans une ambiance chaleureuse et conviviale."
    ],
    "es": [
      "Restaurante a pie de pistas, venga a descubrir Les Premières Loges: desayuno desde las 9 h, brasserie al mediodía con platos caseros, picoteo, bebidas sin parar, aperitivos y après-ski en un ambiente cálido y acogedor."
    ],
    "nl": [
      "Restaurant aan de voet van de pistes, kom en ontdek Les Premières Loges: ontbijt vanaf 9u, brasserie 's middags met huisbereide gerechten, snacking, non-stop drankjes, snacks en après-ski in een warme en vriendelijke sfeer."
    ]
  },
