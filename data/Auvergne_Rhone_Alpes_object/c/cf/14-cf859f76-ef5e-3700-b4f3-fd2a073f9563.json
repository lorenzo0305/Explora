  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/057f8f32-3f41-3869-8fba-887a2bd1762a",
      "dc:description": {
        "de": [
          "Informationen :\n\nProdukte: Sandwiches, Brot, Gebäck\n\nTage der Öffnung:\n\nMontag bis Freitag von 7:00 bis 14:00 Uhr.\n\nSamstag und Sonntag geschlossen\n\nAbholung :\n\nZum Mitnehmen während der Ladenöffnungszeiten\n\nBestellungen:\nBestellungen über die Website möglich\n\n "
        ],
        "en": [
          "Information :\n\nProducts: sandwiches, breads, pastries\n\nOpening days:\n\nMonday to Friday, 7am to 2pm.\n\nClosed on Saturday and Sunday\n\nCollection:\n\nTakeaway during store opening hours\n\nOrdering:\nPossibility of ordering via the website\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nProdotti: panini, pane, pasticceria\n\nGiorni di apertura:\n\nDal lunedì al venerdì dalle 7.00 alle 14.00.\n\nChiuso il sabato e la domenica\n\nRaccolta:\n\nDa asporto durante gli orari di apertura del negozio\n\nOrdini :\nPossibilità di ordinare tramite il sito web\n\n "
        ],
        "fr": [
          "Informations :\n\nProduits : sandwichs, pains, pâtisseries\n\nJours d'ouverture:\n\nDu lundi au vendredi de 7h à 14h.\n\nFemeture le samedi et le dimanche\n\nRetrait :\n\nÀ emporter aux horaires d'ouverture du magasin\n\nCommandes :\nPossibilité de commander par le site internet \n\n "
        ],
        "nl": [
          "Meer informatie :\n\nProducten: broodjes, broden, gebak\n\nOpeningsdagen:\n\nMaandag tot vrijdag van 7u tot 14u.\n\nGesloten op zaterdag en zondag\n\nOphalen:\n\nAfhalen tijdens openingstijden winkel\n\nBestellen :\nMogelijkheid tot bestellen via de website\n\n "
        ],
        "es": [
          "Más información :\n\nProductos: bocadillos, panes, bollería\n\nDías de apertura:\n\nDe lunes a viernes de 7h a 14h.\n\nCerrado sábados y domingos\n\nRecogida:\n\nPara llevar durante el horario de apertura de la tienda\n\nPedidos :\nPosibilidad de hacer pedidos a través de la página web\n\n "
        ]
      },
