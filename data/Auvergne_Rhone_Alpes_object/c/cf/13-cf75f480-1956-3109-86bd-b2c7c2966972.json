  "rdfs:comment": {
    "de": [
      "Das Casino entführt Sie in seinen 5 Spielsälen in Zeit und Raum: Ein Konzept mit einer in Frankreich EINMALIGEN Dekoration, die den amerikanischen Casinos würdig ist: Jeder Saal ist ein Zwischenstopp auf Ihrer Reise."
    ],
    "en": [
      "The Casino takes you back in time and space through its 5 gaming rooms: a concept with a unique decoration in France worthy of American casinos: each room is a stopover in your journey."
    ],
    "it": [
      "Il Casinò vi porta indietro nel tempo e nello spazio attraverso le sue 5 sale da gioco: un concetto con una decorazione UNICA in Francia, degna dei casinò americani: ogni sala è una tappa del vostro viaggio."
    ],
    "fr": [
      "Le Casino vous transporte dans le temps et dans l’espace au fil de ses 5 salles de jeux : un concept à la décoration UNIQUE en France digne des casinos américains : chaque salle est une escale dans votre périple."
    ],
    "nl": [
      "Het Casino neemt u mee terug in tijd en ruimte door zijn 5 speelzalen: een concept met een inrichting UNIEK in Frankrijk, waardig aan Amerikaanse casino's: elke zaal is een tussenstop in uw reis."
    ],
    "es": [
      "El Casino le transporta en el tiempo y en el espacio a través de sus 5 salas de juego: un concepto con una decoración ÚNICA en Francia, digna de los casinos americanos: cada sala es una escala en su viaje."
    ]
  },
