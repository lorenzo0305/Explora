  "rdfs:comment": {
    "de": [
      "Entdecken Sie die schönsten Canyons der Haute-Savoie. Auf dem Programm: Sprünge in wunderschönen Naturbecken, Rutschen und herrliche Abseilabfahrt…"
    ],
    "en": [
      "Discover the most beautiful canyons in Haute-Savoie. On the program: jumps in beautiful natural pools, slides and superb rappelling descent…"
    ],
    "it": [
      "Con Evasion Canyoning, venite a scoprire i più bei canyon dell'Alta Savoia, tra Chamonix, Passy, Megève e Sallanches.\r\nIn programma: salti in splendide piscine naturali, scivoli e superbe discese in corda doppia?"
    ],
    "fr": [
      "Avec Evasion Canyoning, venez découvrir les plus beaux canyons de Haute-Savoie, entre Chamonix, Passy, Megève et Sallanches. \r\nAu programme : des sauts dans de belles piscines naturelles, des toboggans et de superbes descentes en rappel…"
    ],
    "nl": [
      "Kom met Evasion Canyoning de mooiste canyons van de Haute-Savoie ontdekken, tussen Chamonix, Passy, Megève en Sallanches.\r\nOp het programma: sprongen in prachtige natuurlijke poelen, glijbanen en schitterende abseils?"
    ],
    "es": [
      "Con Evasion Canyoning, venga a descubrir los cañones más bellos de la Alta Saboya, entre Chamonix, Passy, Megève y Sallanches.\r\nEn el programa: saltos en hermosas piscinas naturales, toboganes y magníficos rápeles.."
    ]
  },
