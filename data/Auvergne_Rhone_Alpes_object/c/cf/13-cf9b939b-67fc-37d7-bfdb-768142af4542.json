  "rdfs:comment": {
    "de": [
      "Diese Kirche aus dem 15. Jahrhundert, die auf einem romanischen Fundament ruht, verbirgt einen Schatz: ihre Jungfrau in Majestät, zweifellos eine der schönsten und geheimnisvollsten der Auvergne."
    ],
    "en": [
      "The church from the 15th century is built on a Romanesque basis and is worth the journey for one of the most beautiful and mysterious Virgin in Majesty of Auvergne."
    ],
    "it": [
      "Questa chiesa del XV secolo, costruita su una base romanica, nasconde un tesoro: la sua Vergine in Maestà, senza dubbio una delle più belle e misteriose dell'Alvernia."
    ],
    "fr": [
      "Cette église du 15ème siècle qui s'appuie sur une base romane cache un trésor : sa vierge en Majesté, sans doute l'une des plus belles et mystérieuses d'Auvergne."
    ],
    "es": [
      "Esta iglesia del siglo XV, construida sobre una base románica, esconde un tesoro: su Virgen en Majestad, sin duda una de las más bellas y misteriosas de Auvernia."
    ],
    "nl": [
      "Deze kerk uit de 15e eeuw, gebouwd op een Romaanse basis, verbergt een schat: de Maagd in Majesteit, ongetwijfeld een van de mooiste en meest mysterieuze van de Auvergne."
    ]
  },
  "rdfs:label": {
