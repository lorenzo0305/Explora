  "rdfs:comment": {
    "de": [
      "Himmelsbeobachtung und Projektionen per Video oder Diashow.\r\nGanzjährig, nach Vereinbarung, von 21.00 bis 24.00 Uhr, für stündliche Sonnenbeobachtung auf Anfrage."
    ],
    "en": [
      "Observation of the sky and projections by video or slide show.\r\nAll year round, by appointment, from 9pm to midnight, for hourly sun observation on demand."
    ],
    "it": [
      "Osservazione del cielo e proiezioni di video o diapositive, a seconda del tempo.\r\nTutto l'anno, su appuntamento, dalle 21.00 alle 24.00, per l'osservazione oraria del sole su richiesta. Possibilità di viaggiare con gli strumenti."
    ],
    "fr": [
      "Observation du ciel et projections par vidéo ou diaporama, selon la météo.\r\nToute l'année, sur rendez-vous, de 21h à minuit, pour l'observation du soleil horaire à la demande. Possibilité de déplacement avec des instruments."
    ],
    "es": [
      "Observación del cielo y proyección de vídeos o diapositivas, según el tiempo.\r\nTodo el año, con cita previa, de 21.00 a 24.00 horas, para observación horaria del sol previa petición. Posibilidad de viajar con instrumentos."
    ],
    "nl": [
      "Luchtobservatie en video- of diavoorstelling, afhankelijk van het weer.\r\nHet hele jaar door, op afspraak, van 21.00 tot 24.00 uur, voor observatie van de zon per uur op aanvraag. Mogelijkheid tot reizen met instrumenten."
    ]
  },
  "rdfs:label": {
    "en": [
      "Astronomical Observatory Les Pléiades"
