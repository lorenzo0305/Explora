  "rdfs:comment": {
    "de": [
      "Unterhalb des Startpunkts der Gleitschirmflieger verbindet der Vierer-Sessellift von Zore die Ankunft der Gondelbahn von Super-Morzine mit dem Gipfel und ermöglicht so die Verbindung mit Avoriaz."
    ],
    "en": [
      "Underneath the Paragliding launch site the Zore 4 seater chairlift links the arrival of the Super Morzine Gondola to Avoriaz"
    ],
    "it": [
      "Sotto il punto di partenza del parapendio, la seggiovia quadriposto Zore collega l'arrivo della telecabina Super-Morzine alla vetta, offrendo un collegamento con Avoriaz."
    ],
    "fr": [
      "En dessous du départ des parapentes, le télésiège quatre places de Zore relit l'arrivé du télécabine de Super-Morzine au sommet permettant ainsi la liaison avec Avoriaz."
    ],
    "es": [
      "Por debajo del punto de partida del parapente, el telesilla cuatripartito de Zore conecta la llegada del telecabina de Super-Morzine con la cima, proporcionando un enlace con Avoriaz."
    ],
    "nl": [
      "Onder het vertrekpunt voor paragliding verbindt de vierpersoonsstoeltjeslift Zore de aankomst van de gondel Super-Morzine met de top, die een verbinding vormt met Avoriaz."
    ]
  },
  "rdfs:label": {
    "en": [
