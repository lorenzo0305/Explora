  "rdfs:comment": {
    "de": [
      "Für Geschäfte oder Annehmlichkeiten werden Sie den Komfort der Zimmer, die Freundlichkeit der Mitarbeiter und die Modernität der Seminarräume schätzen."
    ],
    "en": [
      "Located in the heart of Lyon, this hotel offers top quality services and accommodation: modernity and tradition are the symbols of this establishment."
    ],
    "it": [
      "Per il lavoro o per il piacere, apprezzerai il comfort delle camere, l'ospitalità dello staff e la modernità delle sale riunioni."
    ],
    "fr": [
      "Pour affaire ou agrément, vous apprécierez le confort des chambres, l'hospitalité des équipes et la modernité des salles de séminaires."
    ],
    "es": [
      "Ya se trate de un viaje de negocios o de placer, disfrutará de la comodidad de las habitaciones, la hospitalidad del equipo y la modernidad de las salas de seminarios."
    ],
    "nl": [
      "Voor zaken of plezier zult u het comfort van de kamers, de gastvrijheid van het personeel en de moderniteit van de seminariezalen op prijs stellen."
    ]
  },
