  "rdfs:comment": {
    "de": [
      "Die Ställe Sermet Quarter Horse empfangen Sie in einem sympathischen Rahmen, der mit neuen und funktionellen Einrichtungen ausgestattet ist. Pferdepension (kollektiv und privat). Tauchen Sie ein in eine 100%ige Westernatmosphäre. Familienausflüge, Ponyverleih..."
    ],
    "en": [
      "The Sermet Quarter Horse stables welcome you in a friendly setting equipped with recent and functional facilities. Horse boarding (collective and private). Dive into a 100% Western atmosphere. Family rides, pony rental..."
    ],
    "it": [
      "Il Sermet Quarter Horse Stables vi accoglie in un ambiente amichevole dotato di strutture recenti e funzionali. Pensione equestre (di gruppo e privata). Immergetevi in un'atmosfera 100% occidentale. Giri per famiglie, noleggio di pony..."
    ],
    "fr": [
      "Les écuries Sermet Quarter Horse vous accueillent dans un cadre sympathique équipé d’installations récentes et fonctionnelles. Pension équestre (collectif et particuliers). Plongez dans une ambiance 100% Western. Balades familiales, location de poneys..."
    ],
    "es": [
      "Los establos Sermet Quarter Horse le dan la bienvenida en un ambiente acogedor, equipado con instalaciones recientes y funcionales. Pensión ecuestre (grupal y privada). Sumérjase en un ambiente 100% occidental. Paseos familiares, alquiler de ponis..."
    ],
    "nl": [
      "De Sermet Quarter Horse Stables verwelkomen u in een vriendelijke omgeving uitgerust met recente en functionele faciliteiten. Paardenpension (groep en privé). Dompel jezelf onder in een 100% westerse sfeer. Familie ritjes, pony verhuur..."
    ]
