  "rdfs:comment": {
    "de": [
      "Dieses japanische Spezialitätenrestaurant bietet Ihnen Maki, Temaki, California, Sashimi, Sushi und Chirashi, aber auch eine große Auswahl an Beilagen, warmen Gerichten und Desserts. Es gibt zahlreiche Menüs.\r\nVor Ort oder zum Mitnehmen."
    ],
    "en": [
      "This Japanese specialty restaurant offers maki, temaki, california, sashimi, sushi or chirashi, but also a wide choice of side dishes, hot dishes and desserts. Many menus.\r\nOn site or to take away."
    ],
    "it": [
      "Questo ristorante di specialità giapponesi offre maki, temaki, california, sashimi, sushi e chirashi, oltre a un'ampia scelta di contorni, piatti caldi e dessert. Numerosi menu.\r\nIn loco o da asporto."
    ],
    "fr": [
      "Ce restaurant de spécialités japonaises vous propose maki, temaki, california, sashimi, sushi ou encore chirashi, mais aussi un large choix d’accompagnements, plats chauds et desserts. Nombreux menus.\r\nSur place ou à emporter."
    ],
    "es": [
      "Este restaurante de especialidades japonesas ofrece maki, temaki, california, sashimi, sushi y chirashi, así como una amplia selección de guarniciones, platos calientes y postres. Numerosos menús.\r\nEn el local o para llevar."
    ],
    "nl": [
      "Dit Japanse specialiteitenrestaurant biedt maki, temaki, california, sashimi, sushi en chirashi, evenals een ruime keuze aan bijgerechten, warme gerechten en desserts. Talrijke menu's.\r\nTer plaatse of om mee te nemen."
    ]
  },
  "rdfs:label": {
    "en": [
