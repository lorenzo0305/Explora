  "rdfs:comment": {
    "de": [
      "Traditioneller landwirtschaftlicher Familienbetrieb: Herstellung und Verkauf von\r\nSaint-Nectaire."
    ],
    "en": [
      "A traditional family-owned farm. Come and find out how a farm of today has retained its authenticity in making traditional St-Nectaire cheese."
    ],
    "it": [
      "Azienda agricola tradizionale a conduzione familiare. Venite a scoprire una fattoria moderna che ha mantenuto tutta la sua autenticità per produrre il tradizionale formaggio St Nectaire. Vendita di formaggio St-Nectaire e di miele locale."
    ],
    "fr": [
      "Exploitation familiale et traditionnelle. Venez découvrir une ferme d'aujourd'hui qui a su garder toute son authenticité pour fabriquer un St Nectaire de grande tradition. Vente de St-Nectaire et miel de pays."
    ],
    "nl": [
      "Traditionele familieboerderij. Kom en ontdek een moderne boerderij die al zijn authenticiteit heeft behouden om een traditionele St Nectaire kaas te produceren. Verkoop van St-Nectaire kaas en lokale honing."
    ],
    "es": [
      "Granja familiar tradicional. Venga a descubrir una granja moderna que ha conservado toda su autenticidad para producir un queso tradicional de St Nectaire. Venta de queso St-Nectaire y miel local."
    ]
  },
