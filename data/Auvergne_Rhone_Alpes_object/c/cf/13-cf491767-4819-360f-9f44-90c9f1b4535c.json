  "rdfs:comment": {
    "de": [
      "Entdecken Sie Spa und Cryo, Ihr Wohlfühl-Refugium in Grenoble. Tauchen Sie ein in die Entspannung mit der kalifornischen Massage, erleben Sie Kryolipolyse und Radiofrequenz, um Ihren Körper zu formen. Genießen Sie unsere Saunen, unser Hamam."
    ],
    "en": [
      "Discover Spa and Cryo, your well-being refuge in Grenoble. Immerse yourself in relaxation with the Californian massage, experience cryolipolysis and radiofrequency to sculpt your body. Enjoy our saunas, hammam, swimming pool."
    ],
    "it": [
      "Scopri Spa and Cryo, il tuo rifugio di benessere a Grenoble. Immergiti nel relax con il massaggio californiano, sperimenta la criolipolisi e la radiofrequenza per scolpire il tuo corpo. Godetevi le nostre saune, hammam e piscina."
    ],
    "fr": [
      "Découvrez Spa et Cryo, votre refuge de bien-être à Grenoble. Plongez dans la relaxation avec le massage Californien, faites l'expérience de la cryolipolyse et de la radiofréquence pour sculpter votre corps. Profitez de nos saunas, hammam piscine."
    ],
    "nl": [
      "Ontdek Spa en Cryo, uw toevluchtsoord voor welzijn in Grenoble. Dompel jezelf onder in ontspanning met de Californische massage, ervaar cryolipolyse en radiofrequentie om je lichaam vorm te geven. Profiteer van onze sauna's, hamamzwembad."
    ],
    "es": [
      "Descubra Spa et Cryo, su paraíso de bienestar en Grenoble. Sumérjase en la relajación con un masaje californiano, experimente la criolipólisis y la radiofrecuencia para esculpir su cuerpo. Disfrute de nuestras saunas y de la piscina hammam."
    ]
  },
