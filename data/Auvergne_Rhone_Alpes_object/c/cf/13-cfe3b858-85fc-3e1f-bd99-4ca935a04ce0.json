  "rdfs:comment": {
    "de": [
      "Entspannen Sie sich im Herzen unseres SPA mit Panoramablick auf die Berge des Vercors und gönnen Sie sich einen Moment der Entspannung, des Wohlbefindens und der Gelassenheit in aller Ruhe.\r\nAuf Reservierung"
    ],
    "en": [
      "Come and relax in the heart of our SPA with panoramic view on the Vercors mountains and treat yourself peacefully with a soothing, well-being and serenity moment.\r\nOn reservation."
    ],
    "it": [
      "Venite a rilassarvi nel cuore della nostra SPA, con vista panoramica sulle montagne del Vercors, e regalatevi un momento di relax, benessere e serenità.\r\nSolo su prenotazione"
    ],
    "fr": [
      "Venez vous relaxer au cœur de notre SPA avec vue panoramique sur les monts du Vercors et offrez-vous un moment de détente, de bien-être et de sérénité en toute tranquillité.\r\nSur réservation"
    ],
    "es": [
      "Venga a relajarse en el corazón de nuestro SPA, con su vista panorámica de las montañas del Vercors, y regálese un momento de relajación, bienestar y serenidad.\r\nSólo con reserva"
    ],
    "nl": [
      "Kom ontspannen in het hart van onze SPA, met panoramisch uitzicht op de bergen van de Vercors, en trakteer jezelf op een moment van ontspanning, welzijn en sereniteit.\r\nAlleen op reservering"
    ]
  },
  "rdfs:label": {
    "de": [
      "Spa Les Bains de Chamrousse"
    ],
    "en": [
      "\"Les Bains de Chamrousse\" Spa"
    ],
    "fr": [
      "Spa Les Bains de Chamrousse"
    ]
  },
