  "rdfs:comment": {
    "de": [
      "Belote-Wettbewerb zugunsten der Schulen von Félines und Sembadel am Samstag, den 4. April ab 20 Uhr im Festsaal: Alle Doubletten werden prämiert. Tombola, Leckereien. 16?/Doublette."
    ],
    "en": [
      "Belote competition to benefit Félines and Sembadel schools on Saturday April 4 from 8pm at the salle des fêtes: all doublettes will win prizes. Tombola, delicacies. 16 per double."
    ],
    "it": [
      "Gara di belote a favore delle scuole di Félines e Sembadel sabato 4 aprile dalle 20.00 nella sala del villaggio: tutti i doppi vinceranno dei premi. Tombola, dolci. 16 per ogni doppio."
    ],
    "fr": [
      "Concours de belote au profit des écoles de Félines et Sembadel le samedi 4 avril à partir de 20h à la salle des fêtes : toutes les doublettes seront primées. Tombola, gourmandises. 16€/doublette."
    ],
    "es": [
      "Concurso de belote a beneficio de las escuelas de Félines y Sembadel el sábado 4 de abril a partir de las 20.00 h en la sala del pueblo: todos los dobles ganarán premios. Tómbola, golosinas. 16 por doble."
    ],
    "nl": [
      "Belote-wedstrijd ten voordele van de scholen van Félines en Sembadel op zaterdag 4 april vanaf 20u in het dorpshuis: alle dubbelspelers winnen prijzen. Tombola, snoep. 16 per dubbel."
    ]
  },
  "rdfs:label": {
