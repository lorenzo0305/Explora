  "rdfs:comment": {
    "de": [
      "In einem Chalet befindet sich eine Dauerausstellung über die Biodiversität der Waldlebensräume und die Umwelt der Monts de la Madeleine, die für alle Zielgruppen bestimmt ist. Möglichkeit einer geführten Besichtigung des Arboretums (Dauer: ca. 45 Min.)."
    ],
    "en": [
      "A chalet houses a permanent exhibition on forest biodiversity and the environment of the Monts de la Madeleine for the general public. Guided tours of the arboretum are available (approx. 45 min.)."
    ],
    "it": [
      "Uno chalet ospita una mostra permanente sulla biodiversità forestale e sull'ambiente dei Monts de la Madeleine per tutte le età. Sono disponibili visite guidate all'arboreto (circa 45 minuti)."
    ],
    "fr": [
      "Un chalet abrite une exposition permanente sur la biodiversité des milieux forestiers et l'environnement des Monts de la Madeleine à destination de tous les publics. Possibilité de visite guidée de l'arboretum (durée : 45 min. environ)."
    ],
    "es": [
      "Un chalet alberga una exposición permanente sobre la biodiversidad forestal y el medio ambiente de los Montes de la Madeleine para todas las edades. Se ofrecen visitas guiadas al arboreto (aprox. 45 minutos)."
    ],
    "nl": [
      "Een chalet huisvest een permanente tentoonstelling over de biodiversiteit van bosomgevingen en de omgeving van de Monts de la Madeleine voor het grote publiek. Rondleidingen door het arboretum zijn mogelijk (ongeveer 45 minuten)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Chalet pédagogique les Grands Murcins"
    ]
  },
