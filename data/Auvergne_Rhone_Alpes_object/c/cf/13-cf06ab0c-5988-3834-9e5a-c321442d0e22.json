  "rdfs:comment": {
    "de": [
      "Ihr neues italienisches Restaurant in Valence!\r\nAuf der Speisekarte stehen Antipasti, Pizza, Pasta, gemischte Salate, Wurstwaren und Dolci! Ob Fertigprodukte oder Getränke, alles wird so weit wie möglich aus Italien importiert und die Karte wird sich mit den Jahreszeiten verändern."
    ],
    "en": [
      "Your new Italian restaurant in Valence!\r\nOn the menu: antipasti, pizza, pasta, mixed salads, cold cuts and dolci! Whether it's cooked products or drinks, everything is imported from Italy as much as possible, and the menu will evolve with the seasons."
    ],
    "it": [
      "Il vostro nuovo ristorante italiano a Valencia!\r\nNel menu: antipasti, pizza, pasta, insalate miste, salumi e dolci! Che si tratti di prodotti cucinati o di bevande, tutto è importato dall'Italia al massimo e il menu si evolverà con le stagioni."
    ],
    "fr": [
      "Votre nouveau restaurant italien sur Valence !\r\nAu menu : antipasti, pizza, pâtes, salades composées, charcuterie et dolci ! Que ce soient les produits cuisinés ou les boissons, tout est importé d'Italie au maximum et la carte évoluera au fil des saisons."
    ],
    "es": [
      "¡Tu nuevo restaurante italiano en Valencia!\r\nEn el menú: ¡antipasti, pizza, pasta, ensaladas mixtas, embutidos y dolci! Ya sean los productos cocinados o las bebidas, todo se importa de Italia al máximo y el menú evolucionará con las estaciones."
    ],
    "nl": [
      "Uw nieuwe Italiaanse restaurant in Valence!\r\nOp het menu: antipasti, pizza, pasta, gemengde salades, vleeswaren en dolci! Alles wordt zoveel mogelijk uit Italië geïmporteerd, van de bereide producten tot de dranken, en het menu zal met de seizoenen meegaan."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Gigi - Ristorante italiano"
    ]
  },
