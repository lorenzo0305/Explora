  "rdfs:comment": {
    "de": [
      "Die Kirche Saint-Marcel de Propiac ist ein religiöses Gebäude, das schon von weitem an seinem Glockenturm zu erkennen ist."
    ],
    "en": [
      "The church of Saint-Marcel de Propiac is a religious building that can be recognized from afar by its bell tower."
    ],
    "it": [
      "La chiesa di Saint Marcel a Propiac è un edificio religioso riconoscibile da lontano per il suo campanile."
    ],
    "fr": [
      "L'église Saint-Marcel de Propiac est un édifice religieux reconnaissable au loin à son clocher."
    ],
    "es": [
      "La iglesia de Saint Marcel de Propiac es un edificio religioso que se reconoce desde lejos por su campanario."
    ],
