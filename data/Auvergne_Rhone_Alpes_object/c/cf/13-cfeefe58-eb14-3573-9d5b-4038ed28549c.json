  "rdfs:comment": {
    "de": [
      "Jeden Tag und das ganze Jahr über stellen wir in der Käserei von Lanslebourg den berühmten Beaufort AOP her.\r\nKommen Sie und entdecken Sie unser Know-how und teilen Sie unsere Werte."
    ],
    "en": [
      "Every day, all year round, at the Lanslebourg cheese dairy, we make the famous Beaufort PDO.\r\nCome and discover our know-how and share our values."
    ],
    "it": [
      "Ogni giorno, tutto l'anno, produciamo il famoso formaggio Beaufort DOP nel caseificio di Lanslebourg.\r\nVenite a scoprire la nostra esperienza e a condividere i nostri valori."
    ],
    "fr": [
      "Chaque jour, et ce toute l'année, nous fabriquons à la fromagerie de Lanslebourg le fameux Beaufort AOP.\r\nVenez découvrir notre savoir-faire et partager nos valeurs."
    ],
    "es": [
      "Todos los días del año, en la quesería de Lanslebourg, elaboramos el famoso queso Beaufort DOP.\r\nVenga a descubrir nuestro saber hacer y a compartir nuestros valores."
    ],
    "nl": [
      "Elke dag, het hele jaar door, maken we in de zuivelfabriek van Lanslebourg de beroemde Beaufort BOB kaas.\r\nKom en ontdek onze expertise en deel onze waarden."
    ]
  },
  "rdfs:label": {
    "en": [
      "Self-guided tour of the Haute Maurienne Vanoise dairy cooperative"
    ],
    "fr": [
      "Visite (en autonomie) de la Coopérative Laitière Haute-Maurienne Vanoise"
    ],
    "nl": [
      "Zelfgeleide rondleiding door de zuivelcoöperatie Haute Maurienne Vanoise"
    ]
  },
