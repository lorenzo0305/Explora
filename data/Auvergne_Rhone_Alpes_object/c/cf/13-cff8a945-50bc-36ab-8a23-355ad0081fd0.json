  "rdfs:comment": {
    "de": [
      "MOB HOTEL Lyon versteht sich als eine kreative Blase, in der Sie vom Badezimmer bis zum Büro flanieren und dabei mit der Welt verbunden bleiben können. Es bietet Ihnen außerdem gesunde und biologische Speisen aus frischen und lokalen Produkten."
    ],
    "en": [
      "MOB HOTEL Lyon wants to be a creative bubble where you can walk from the bathroom to the office, while staying connected to the world. It also offers a healthy and organic food based on fresh and local products."
    ],
    "it": [
      "Il MOB HOTEL di Lione è una bolla creativa dove è possibile passare dal bagno all'ufficio, rimanendo connessi al mondo. Offre inoltre cibi sani e biologici preparati con prodotti freschi e locali."
    ],
    "fr": [
      "MOB HOTEL Lyon se veut être une bulle créative où vous pourrez déambuler de la salle de bain au bureau, tout en restant connecté au monde. Il vous propose également une restauration saine et bio à base de produits frais et locaux."
    ],
    "nl": [
      "MOB HOTEL Lyon is een creatieve bubbel waar je van de badkamer naar kantoor kunt lopen, terwijl je verbonden blijft met de wereld. Het biedt ook gezonde en biologische voeding gemaakt van verse en lokale producten."
    ],
    "es": [
      "MOB HOTEL Lyon es una burbuja creativa en la que se puede ir del baño a la oficina, sin dejar de estar conectado con el mundo. También ofrece comida sana y ecológica elaborada con productos frescos y locales."
    ]
  },
