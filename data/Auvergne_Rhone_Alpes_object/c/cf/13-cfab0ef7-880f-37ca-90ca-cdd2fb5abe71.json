  "rdfs:comment": {
    "de": [
      "Entdecken Sie nur wenige Schritte von den Thermen entfernt La Chocolaterie Sébastien Fautrelle, einen unumgänglichen Ort für Leckereien und sein fast 30-jähriges Know-how."
    ],
    "en": [
      "Discover Sébastien Fautrelle's chocolate shop just a stone's throw from the thermal baths, a must-see place for gourmet products made by someone with nearly 30 years of experience and expertise."
    ],
    "it": [
      "A due passi dalle Terme, scoprite La Cioccolateria Sébastien Fautrelle, luogo imperdibile della gastronomia e del savoir-faire da circa 30 anni."
    ],
    "fr": [
      "Découvrez à deux pas des Thermes La Chocolaterie Sébastien Fautrelle, lieu incontournable de la gourmandise et son savoir-faire de près de 30 ans."
    ],
    "nl": [
      "Ontdek de chocoladefabriek Sébastien Fautrelle, een plek waar u de lekkernijen en zijn 30-jarige knowhow niet mag missen, op een steenworp afstand van de thermen."
    ],
    "es": [
      "Descubra la chocolatería Sébastien Fautrelle, un lugar en el que no se puede perder las delicias gourmet y sus 30 años de saber hacer, a un paso de las termas."
    ]
  },
