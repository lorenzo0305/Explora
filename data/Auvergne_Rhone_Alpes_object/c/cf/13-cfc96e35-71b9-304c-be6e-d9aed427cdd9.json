  "rdfs:comment": {
    "de": [
      "Good Grief\r\nStimmen aus aller Welt, Frankreich, England\r\n\r\nDer britische Sänger kehrt zwischen den Schatten mit einem Strauß persönlicher und sensibler Lieder zurück, deren Folk zart von Blues und Jazz gefärbt ist und die den Glanz der Erneuerung tragen."
    ],
    "en": [
      "Good Grief\r\nVoix du monde, France, England\r\n\r\nThe British singer returns from the shadows with a bouquet of personal, sensitive songs, with folk delicately tinged with blues and jazz, bearing the glow of renewal."
    ],
    "it": [
      "Buon dolore\r\nVoix du monde, Francia, Inghilterra\r\n\r\nLa cantante britannica torna dall'ombra con un bouquet di canzoni personali e sensibili, con un folk delicatamente tinto di blues e jazz, che porta con sé il bagliore del rinnovamento."
    ],
    "fr": [
      "Good Grief\r\nVoix du monde, France, Angleterre\r\n\r\nLe chanteur britannique revient d’entre les ombres avec un bouquet de chansons personnelles et sensibles, au folk délicatement teinté de blues et de jazz, porteuses de l’éclat du renouveau."
    ],
    "nl": [
      "Goed Verdriet\r\nVoix du monde, Frankrijk, Engeland\r\n\r\nDe Britse zangeres keert terug uit de schaduw met een boeket persoonlijke, gevoelige liedjes, met folk die subtiel getint is met blues en jazz, die de gloed van vernieuwing met zich meedragen."
    ],
    "es": [
      "Buen duelo\r\nVoix du monde, Francia, Inglaterra\r\n\r\nLa cantante británica vuelve de las sombras con un ramillete de canciones personales y sensibles, con un folk delicadamente teñido de blues y jazz, que llevan el brillo de la renovación."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Concert: Hugh Coltman"
    ]
  },
