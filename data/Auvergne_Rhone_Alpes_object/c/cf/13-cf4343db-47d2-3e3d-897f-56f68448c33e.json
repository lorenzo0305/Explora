  "rdfs:comment": {
    "de": [
      "Genießen Sie die 7. Kunst in einem der beiden Säle des Kinos Bel'Donne. Das Kino von Allevard steht für einen qualitativ hochwertigen Empfang und stets saubere und komfortable Säle. Es ist ein kultureller Ort, der aus dem kulturellen Leben von Allevard nicht wegzudenken ist."
    ],
    "en": [
      "Enjoy films in one of Bel'Donne's 2 cinemas. The Allevard cinema guarantees a high quality welcome and screen rooms which are always clean, comfortable. It's a key venue in Allevard's cultural life."
    ],
    "it": [
      "Godetevi la settima arte in una delle 2 sale del cinema Bel'Donne. Il cinema di Allevard garantisce un'accoglienza di qualità e sale pulite e confortevoli. È una parte essenziale della vita culturale di Allevard."
    ],
    "fr": [
      "Appréciez le 7ème art dans l'une des 2 salles du cinéma Bel'Donne . Le cinéma d'Allevard c'est l'assurance d'un accueil de qualité et de salles toujours propres et confortables. C'est un lieu culturel incontournable de la vie culturelle d'Allevard."
    ],
    "nl": [
      "Geniet van de 7e kunst in een van de 2 bioscopen van Bel'Donne. De Allevard-bioscoop staat garant voor een hoogwaardige ontvangst en schone, comfortabele bioscopen. Het is een belangrijke culturele plek in het culturele leven van Allevard."
    ],
    "es": [
      "Disfrute del séptimo arte en una de las 2 salas del cine Bel'Donne. El cine de Allevard le garantiza una acogida de calidad y unas salas limpias y confortables. Es una parte esencial de la vida cultural de Allevard."
    ]
  },
