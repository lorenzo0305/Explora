  "rdfs:comment": {
    "de": [
      "Eine öffentliche Einrichtung, die einem breiten Publikum offen steht und verschiedene Sammlungen zur Ausleihe und zum Austausch anbietet. Der Katalog umfasst Werke sowohl für Jugendliche als auch für Erwachsene und deckt somit alle Lesebedürfnisse ab."
    ],
    "en": [
      "A public service open to a wide audience, offering diverse collections available for borrowing and exchanging. The catalog includes materials catering to both young readers and adults, thereby meeting all reading needs."
    ],
    "it": [
      "Un servizio pubblico aperto a un vasto pubblico, che offre diverse collezioni da prendere in prestito e scambiare. Il catalogo comprende libri per giovani e adulti, per soddisfare tutte le esigenze di lettura."
    ],
    "fr": [
      "Un service public ouvert à un large public, offrant des collections variées à emprunter et à échanger. Le catalogue comprend des ouvrages aussi bien pour la jeunesse que pour les adultes, répondant ainsi à tous les besoins de lecture."
    ],
    "es": [
      "Un servicio público abierto a un amplio público, que ofrece colecciones variadas para préstamo e intercambio. El catálogo incluye libros para jóvenes y adultos, para satisfacer todas las necesidades de lectura."
    ],
    "nl": [
      "Een openbare dienst voor iedereen, met boeken voor jong en oud."
    ]
  },
