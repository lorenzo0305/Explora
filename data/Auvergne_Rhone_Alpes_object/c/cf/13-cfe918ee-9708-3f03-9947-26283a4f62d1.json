  "rdfs:comment": {
    "de": [
      "Traditionelle Küche, die ausschließlich auf frischen und saisonalen Produkten basiert, hausgemachtes Brot. Erfahrener Küchenchef und herzlicher Empfang.\r\nAusstellung von Bildern von Künstlern aus der Region."
    ],
    "en": [
      "Traditional cuisine based on seasonal fresh local products. Homemade bread. Experienced Chef and friendly welcome. Exhibitions of local painters."
    ],
    "it": [
      "Cucina tradizionale basata esclusivamente su prodotti freschi e di stagione, pane fatto in casa. Chef esperto e accoglienza calorosa.\r\nMostra di dipinti di artisti locali."
    ],
    "fr": [
      "Cuisine traditionnelle uniquement basée sur des produits frais et de saison, pain maison. Chef expérimenté et accueil chaleureux.\r\nExposition de tableaux d'artistes de la région."
    ],
    "nl": [
      "Traditionele keuken uitsluitend op basis van verse seizoensproducten, brood van het huis. Innovatieve chef en hartelijke ontvangst. Expositie met schilderijen van kunstenaars uit de regio."
    ],
    "es": [
      "Cocina tradicional basada únicamente en productos frescos de temporada, pan casero. Un chef experimentado y una cálida bienvenida.\r\nExposición de pinturas de artistas locales."
    ]
  },
