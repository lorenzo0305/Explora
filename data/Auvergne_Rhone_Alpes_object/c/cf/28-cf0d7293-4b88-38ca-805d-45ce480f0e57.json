  "rdfs:comment": {
    "de": [
      "Sorgfältig ausgewählte Produkte, eine innovative und leckere Küche, eine wöchentlich geänderte Speisekarte, eine bistronomische Gastronomie.\nDas Plus: außergewöhnliche Fleischsorten und Garen im Kohleofen!"
    ],
    "en": [
      "Carefully selected products, innovative and gourmet cuisine, a weekly changing menu, bistronomic dining.\nBonus: exceptional meats, cooked in a charcoal oven!"
    ],
    "it": [
      "Prodotti accuratamente selezionati, cucina innovativa e gourmet, menù che cambia ogni settimana, cucina bistronomica.\nBonus: carni eccezionali, cotte nel forno a carbone!"
    ],
    "fr": [
      "Des produits sélectionnés avec soin, une cuisine novatrice et gourmande, une carte modifiée chaque semaine, une restauration bistronomique.\nLe + : des viandes d'exception, et une cuisson au four à charbon !"
    ],
    "nl": [
      "Zorgvuldig geselecteerde producten, innovatieve en gastronomische keuken, een menu dat elke week verandert, bistronomisch dineren.\nBonus: uitzonderlijk vlees, bereid in een houtskooloven!"
    ],
    "es": [
      "Productos cuidadosamente seleccionados, cocina innovadora y gastronómica, un menú que cambia cada semana, comida bistronómica.\nBonus: carnes excepcionales, ¡cocinadas en horno de carbón!"
    ]
  },
