  "rdfs:comment": {
    "de": [
      "Der POP \"du Pre? O Plat\" ist für Sie als Caterer oder Foodtruck unterwegs, um Ihnen eine einfache Küche mit Produkten aus der Region zu bieten, die zu 100 % auf dem kurzen Weg und hausgemacht sind."
    ],
    "en": [
      "A simple cuisine based on local products.\r\n100% short circuit and homemade.\r\nIn Food Truck mode, caterer or Rotisserie service."
    ],
    "it": [
      "Il POP \"du Pre? O Plat\" viene da voi come catering o food truck per un pasto semplice a base di prodotti locali 100% fatti in casa."
    ],
    "fr": [
      "Le POP « du Pré O Plat » se déplace pour vous en tant que traiteur ou en food truck  pour une cuisine simple à base de produits du terroir en 100% circuit court et fait maison."
    ],
    "es": [
      "El POP \"du Pre? O Plat\" acude a ti como servicio de catering o food truck para ofrecerte una comida sencilla a base de productos locales 100% caseros."
    ],
    "nl": [
      "De POP \"du Pre? O Plat\" komt naar je toe als traiteur of foodtruck voor een eenvoudige maaltijd op basis van 100% zelfgemaakte lokale producten."
    ]
  },
  "rdfs:label": {
