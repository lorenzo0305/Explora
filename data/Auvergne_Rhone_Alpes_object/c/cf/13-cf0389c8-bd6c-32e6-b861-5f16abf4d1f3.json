  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Tougnette-Gondelbahn in Méribel, Ihre Brücke zu außergewöhnlichen Sommer- und Winterabenteuern. Erreichen Sie bequem die Gipfel zum Wandern, Mountainbiken oder Skifahren und genießen Sie das ganze Jahr über ein unvergessliches Alpenpanorama."
    ],
    "en": [
      "Discover the Tougnette gondola in Méribel, your gateway to exceptional summer and winter adventures. Easy access to the summits for hiking, mountain biking or skiing, and unforgettable alpine panoramas all year round."
    ],
    "it": [
      "Scoprite la funivia della Tougnette a Méribel, la vostra porta d'accesso a eccezionali avventure estive e invernali. Accedete facilmente alle cime per fare escursioni a piedi, in mountain bike o con gli sci, e godetevi tutto l'anno panorami alpini indimenticabili."
    ],
    "fr": [
      "Découvrez la télécabine de Tougnette à Méribel, votre passerelle vers des aventures estivales et hivernales exceptionnelles. Accédez facilement aux sommets pour des randonnées, du VTT ou du ski, et profitez de panoramas alpins inoubliables toute l’année."
    ],
    "nl": [
      "Ontdek de Tougnette kabelbaan in Méribel, jouw toegangspoort tot uitzonderlijke zomer- en winteravonturen. Krijg gemakkelijk toegang tot de toppen om te wandelen, mountainbiken of skiën, en geniet het hele jaar door van onvergetelijke Alpenpanorama's."
    ],
    "es": [
      "Descubra el teleférico de la Tougnette en Méribel, su puerta de entrada a excepcionales aventuras de verano e invierno. Acceda fácilmente a las cumbres para practicar senderismo, bicicleta de montaña o esquí, y disfrute de inolvidables panorámicas alpinas durante todo el año."
    ]
  },
  "rdfs:label": {
    "en": [
      "Tougnète gondola"
    ],
    "fr": [
      "Télécabine de Tougnète"
    ],
    "nl": [
      "Tougnète kabelbaan"
    ]
  },
