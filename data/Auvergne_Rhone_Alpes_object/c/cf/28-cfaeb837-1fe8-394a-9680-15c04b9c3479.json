  "rdfs:comment": {
    "de": [
      "Der Paraclet-Laden bietet lokale Bauernprodukte aus der Region und aus der Produktion französischer Landwirtschaftsschulen an. Fleisch, Milchprodukte, Eier, Feinkost, Kekse, Obst, Gemüse, Getränke, Weine, ... Vielfältige und qualitativ hochwertige Produkte!"
    ],
    "en": [
      "The Paraclet store offers local farm products and products from French agricultural high schools. Meat, dairy products, eggs, delicatessen, biscuits, fruits, vegetables, drinks, wines,... A variety of quality products!"
    ],
    "it": [
      "Il negozio Paraclet offre prodotti agricoli locali e prodotti delle scuole agrarie francesi. Carne, latticini, uova, gastronomia, biscotti, frutta, verdura, bevande, vini, ecc. Una varietà di prodotti di qualità!"
    ],
    "fr": [
      "Le magasin du Paraclet propose des produits fermiers locaux et issus de la production de lycées agricoles français. Viandes, produits laitiers, œufs, épicerie fine, biscuits, fruits, légumes, boissons, vins,... Des produits variés et de qualité !"
    ],
    "es": [
      "La tienda de Paraclet ofrece productos agrícolas locales y de las escuelas agrícolas francesas. Carne, productos lácteos, huevos, charcutería, galletas, fruta, verduras, bebidas, vinos, etc. ¡Una variedad de productos de calidad!"
    ],
    "nl": [
      "In de winkel van Paraclet worden streekproducten en producten van Franse landbouwscholen aangeboden. Vlees, zuivelproducten, eieren, delicatessen, koekjes, fruit, groenten, dranken, wijnen, enz. Een verscheidenheid aan kwaliteitsproducten!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Ferme du Paraclet"
    ]
  },
