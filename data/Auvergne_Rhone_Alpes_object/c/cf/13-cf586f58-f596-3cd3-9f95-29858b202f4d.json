  "rdfs:comment": {
    "de": [
      "Entdecken Sie die neuesten Filme, die vom Kino Le Fanny angeboten werden. Das Kino befindet sich im Maison du Tourisme, Ortszentrum, 1650m.\r\nDie Filmvorführungen finden Sie auf dem Programm."
    ],
    "en": [
      "Come and discover the latest films on offer at Le Fanny cinema, located in the Maison du Tourisme, resort centre, 1650m. \r\nFind the film screenings on the programme."
    ],
    "it": [
      "Venite a scoprire le ultime pellicole proposte dal cinema Le Fanny, situato nella Maison du Tourisme, centro della località, a 1650m.\r\nConsultare il programma delle proiezioni."
    ],
    "fr": [
      "Venez découvrir les films les plus récents, proposés par le cinéma Le Fanny, situé dans la Maison du Tourisme, centre station, 1650m.\r\nRetrouvez les séances de cinéma sur le programme."
    ],
    "es": [
      "Venga a descubrir las últimas películas propuestas en el cine Le Fanny, situado en la Maison du Tourisme, centro de la estación, 1650 m.\r\nConsulte el programa de proyecciones."
    ],
    "nl": [
      "Kom de nieuwste films ontdekken in de bioscoop Le Fanny, gelegen in het Maison du Tourisme, in het centrum van de badplaats, op 1650 m. \r\nBekijk de filmvoorstellingen op het programma."
    ]
  },
