  "rdfs:comment": {
    "de": [
      "Spezialität: außergewöhnliches Fleisch und Produkte aus der Region, Bistronomische Küche. Empfang von Gruppen. Abgelegener Raum für Geschäftsessen. Gerichte aus regionalen Produkten: Crique Ardéchoise, Ravioles, Wurstwaren aus dem Pilat...Sehr schöne Weinkarte."
    ],
    "en": [
      "Specialities are exceptional meats and local products, bistro-style cuisine. Groups welcome. Private room for business events. Dishes with regional products such as crique ardèchoise, ravioles, Pilat pork-meats…. Large fine wine selection."
    ],
    "it": [
      "Prodotti locali, cucina bistronomica. Accoglienza gruppi. Sala appartata per pranzi di lavoro. Piatti a base di prodotti regionali: Ravioles, charcuterie du Pilat, ecc. Ottima carta dei vini."
    ],
    "fr": [
      "Produits du terroir, Cuisine Bistronomique. Accueil de groupes. Salle isolée pour repas d'affaire. Plats à base de produits régionaux : Ravioles, charcuterie du Pilat...Trés belle carte de vins."
    ],
    "es": [
      "Productos locales, cocina bistronómica. Acogida de grupos. Sala reservada para comidas de negocios. Platos a base de productos regionales: ravioles, charcuterie du Pilat, etc. Excelente carta de vinos."
    ],
    "nl": [
      "Gespecialiseerd in uitzonderlijk vlees en lokale producten, Bistronomische keuken. Groepen zijn welkom. Afgezonderde ruimte voor zakendiners. Gerechten op basis van regionale producten: crique ardéchoise, ravioli, charcuterie du Pilat, etc. Uitstekende wijnkaart."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Villa Champagnère"
    ]
  },
