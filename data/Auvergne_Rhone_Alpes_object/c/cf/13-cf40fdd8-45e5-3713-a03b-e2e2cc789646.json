  "rdfs:comment": {
    "de": [
      "Diese kleine rustikale Hütte liegt im Herzen einer wild gebliebenen Natur und empfängt Sie für eine Nacht, eine Mahlzeit, einen Snack oder einen Zwischenstopp!"
    ],
    "en": [
      "Set in the heart of unspoilt countryside, this small rustic lodge welcomes you for a night, a meal, a snack, or a stopover!"
    ],
    "it": [
      "Situato nel cuore di una natura selvaggia, questo piccolo rifugio rustico vi accoglie per una notte, un pasto, uno spuntino, una sosta!"
    ],
    "fr": [
      "Situé au cœur d’une nature restée sauvage, ce petit refuge rustique vous accueille, pour une nuit, un repas, un goûter, une halte !"
    ],
    "es": [
      "Situado en el corazón de una naturaleza salvaje, este pequeño refugio rústico le acoge para pasar una noche, una comida, un tentempié, ¡una parada!"
    ],
    "nl": [
      "Gelegen in het hart van een wilde natuur, verwelkomt dit kleine rustieke toevluchtsoord u voor een nacht, een maaltijd, een snack, een tussenstop!"
    ]
  },
