  "rdfs:comment": {
    "de": [
      "Wir bieten eine breite Palette an frischem Ziegenkäse in Fässchen, halbfrisch, traditionell nach Picodon de la Drôme-Art mit verschiedenen Reifungsgraden."
    ],
    "en": [
      "We offer a wide range of fresh goat cheeses in faisselle, semi-fresh and traditional Picodon de la Drôme style, with different levels of ripening."
    ],
    "it": [
      "Offriamo un'ampia gamma di formaggi freschi di capra in stile faisselle, semi-fresco e tradizionale Drôme Picodon, con diversi livelli di maturazione."
    ],
    "fr": [
      "Nous proposons une large gamme de fromages de chèvre frais en faisselle, demi-frais, traditionnels à la façon Picodon de la Drôme avec différents niveaux d'affinage. "
    ],
    "nl": [
      "We bieden een breed assortiment verse geitenkazen in faisselle, semi-vers en traditionele Drôme Picodon stijl, met verschillende rijpingsgraden."
    ],
    "es": [
      "Ofrecemos una amplia gama de quesos de cabra frescos de estilo faisselle, semicurado y Picodon tradicional de Drôme, con diferentes niveles de maduración."
    ]
  },
