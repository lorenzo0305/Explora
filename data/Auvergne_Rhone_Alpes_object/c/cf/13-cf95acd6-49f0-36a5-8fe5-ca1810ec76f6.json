      "schema:openingHoursSpecification": [
        {
          "@id": "https://data.datatourisme.fr/fe9d6f62-ad14-3dc4-ac51-8bb4b7b92f60",
          "schema:validFrom": "2026-06-02T00:00:00",
          "schema:validThrough": "2026-09-22T23:59:59",
          "@type": [
            "schema:OpeningHoursSpecification"
          ],
          "additionalInformation": {
            "de": [
              "Vom 1. bis 30. Juni und vom 1. bis 21. September: täglich (außer samstags.) von 14:30-18:00 Uhr.\r\nJuli und August: täglich (außer samstags) von 10.00-12.30 Uhr und von 14.30-18.30 Uhr Selbstständige Besuche ohne Anmeldung.\r\n\r\n\r\nFür Gruppen sind die 4 Standorte das ganze Jahr über nach vorheriger Anmeldung geöffnet."
            ],
            "en": [
              "June 1 to 30 and September 1 to 21: daily (except Saturday) 2:30-6:00 pm.\r\nJuly and August: daily (except Saturday) 10am-12.30pm and 2.30pm-6.30pm Self-guided tours, no registration required.\r\n\r\n\r\nFor groups, the 4 sites are open all year round on reservation."
            ],
            "it": [
              "Dal 1° al 30 giugno e dal 1° al 21 settembre: tutti i giorni (tranne il sabato) dalle 14:30 alle 18:00.\r\nLuglio e agosto: tutti i giorni (tranne il sabato) dalle 10.00 alle 12.30 e dalle 14.30 alle 18.30 Visite autoguidate senza registrazione.\r\n\r\n\r\nPer i gruppi, i 4 siti sono aperti tutto l'anno su prenotazione."
            ],
            "fr": [
              "Du 1 au 30 juin et du 1er au 21 septembre : tous les jours (sauf le samedi.) de 14h30-18h00.\r\nJuillet et Août : tous les jours (sauf le samedi) de 10h-12h30 et de 14h30-18h30 Visites en autonomie sans inscription.\r\n\r\n\r\nPour les groupes, les 4 sites sont ouverts toute l'année sur réservation."
            ],
            "nl": [
              "Van 1 t/m 30 juni en van 1 t/m 21 september: dagelijks (behalve zaterdag) van 14:30-18:00 uur.\r\nJuli en augustus: dagelijks (behalve zaterdag) van 10.00-12.30 en 14.30-18.30 Zelf rondleidingen zonder registratie.\r\n\r\n\r\nVoor groepen zijn de 4 locaties het hele jaar door op reservering geopend."
            ],
            "es": [
              "Del 1 al 30 de junio y del 1 al 21 de septiembre: todos los días (excepto sábados) de 14.30 a 18.00 h.\r\nJulio y agosto: todos los días (excepto sábados) de 10:00 a 12:30 y de 14:30 a 18:30. Visitas autoguiadas sin inscripción.\r\n\r\n\r\nPara los grupos, los 4 sitios están abiertos todo el año previa reserva."
            ]
          },
