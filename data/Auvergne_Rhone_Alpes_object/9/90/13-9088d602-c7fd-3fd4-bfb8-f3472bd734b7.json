  "rdfs:comment": {
    "de": [
      "Angelstrecke in einem Fluss der ersten Kategorie, die eine natürliche Umgebung bietet, die für Liebhaber des Wildwasserangelns geeignet ist. Vorkommen von Bachforelle, Äsche, Groppe, Schmerle und Weißfisch."
    ],
    "en": [
      "First-class river fishing course, offering a natural environment suited to whitewater fishing enthusiasts. Fish include brown trout, grayling, sculpin, brown loche and whitefish."
    ],
    "it": [
      "Un corso di pesca fluviale di prima classe, che offre un ambiente naturale adatto agli appassionati di pesca in acque bianche. La fauna ittica comprende trote fario, temoli, sculpin, loche fario e coregoni."
    ],
    "fr": [
      "Parcours de pêche en rivière de première catégorie, offrant un environnement naturel adapté aux amateurs de pêche en eau vive. Présence de truite fario, ombre commun, chabot, loche franche et poissons blancs."
    ],
    "es": [
      "Un curso de pesca fluvial de primera clase, que ofrece un entorno natural adecuado para los entusiastas de la pesca en aguas bravas. Entre los peces se incluyen la trucha común, el tímalo, el eslizón, la loche común y el pescado blanco."
    ],
    "nl": [
      "Een eersteklas rivierviscursus die een natuurlijke omgeving biedt die geschikt is voor liefhebbers van wildwatervissen. Vissen zijn onder andere beekforel, vlagzalm, schartong, bruine loche en witvis."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parcours pêche \"Le Chéran\" - Boussy"
    ]
  },
