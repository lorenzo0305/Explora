  "rdfs:comment": {
    "de": [
      "Bei den Einheimischen beliebte, historische Einrichtung gegenüber dem Tourismusbüro und dem Theater von Annecy. Einzigartiger Ort, um sich ein Gläschen zu genehmigen oder mit den hausgemachten Speisen aus frischen Produkten zu stärken."
    ],
    "en": [
      "Historic establishment well known to the inhabitants of Annecy, located opposite the Tourism Office and the Annecy Theatre. With a menu of homemade products, this is a superb place to have a drink or a meal."
    ],
    "it": [
      "Edificio storico molto noto agli abitanti di Annecy, situato di fronte all'Ufficio del Turismo e al Teatro di Annecy. Un luogo stupendo per bere un bicchiere o rifocillarsi con prodotti fatti in casa."
    ],
    "fr": [
      "Etablissement historique bien connu des annéciens, situé face à l'Office du Tourisme et au Théâtre d'Annecy. Un endroit exceptionnel pour boire un verre ou se restaurer avec une carte de produits faits maison."
    ],
    "es": [
      "Un establecimiento histórico muy conocido por los habitantes de Annecy, situado frente a la Oficina de Turismo y el Teatro de Annecy. Un lugar excepcional para tomar una copa o comer con una carta de productos caseros."
    ],
    "nl": [
      "Historisch gebouw dat bij vele Annéciens bekend is, tegenover het VVV-kantoor en het Theater van Annecy. Een bijzondere plek om iets te drinken of te eten met een kaart vol huisgemaakte producten."
    ]
  },
