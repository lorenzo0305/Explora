  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/2dd79531-b8f9-31e0-83d4-0a7f60281dbe",
      "dc:description": {
        "de": [
          "Athlétique Club de Tubersent Fußball\nSenioren: Distrikt Cote d'opale Promotion deuxième Sieger der Meisterschaft der 3 E Division Finalist Coupe Canche\nTraining auf dem städtischen Platz in Tubersent jeden Mittwoch von 17:00 bis 18:30 Uhr"
        ],
        "en": [
          "Athlétique Club de Tubersent Football\nSeniors : District Cote d'opale Promotion runner-up Winner of 3 E division championship finalist Coupe canche\nTraining sessions at the Tubersent municipal field every Wednesday from 5pm to 6:30pm"
        ],
        "it": [
          "Club Atletico di Tubersent Calcio\nSeniores : Distretto della Cote d'opale Seconda classificata in Promozione Vincitrice della coppa delle 3 E finaliste di divisione canche\nAllenamento al campo comunale di Tubersent ogni mercoledì dalle 17.00 alle 18.30"
        ],
        "fr": [
          "Athlétique Club de Tubersent Football \nSeniors : District Cote d'opale Promotion deuxième Vainqueur du championnat de 3 E division finaliste coupe canche\nEntraînements au terrain municipal de Tubersent tous les mercredis de 17h à 18h30"
        ],
        "nl": [
          "Sportclub de Tubersent Voetbal\nSenioren : District Cote d'opale Promotie tweede plaats Winnaar van de 3 E divisie finalist beker canche\nTraining op het gemeentegrond van Tubersent elke woensdag van 17u tot 18u30"
        ],
        "es": [
          "Athlétique Club de Tubersent Fútbol\nSeniors : Distrito Cote d'opale Subcampeón de promoción Ganador de la 3 E división finalista copa canche\nEntrenamiento en el campo municipal de Tubersent todos los miércoles de 17:00 a 18:30"
        ]
      },
