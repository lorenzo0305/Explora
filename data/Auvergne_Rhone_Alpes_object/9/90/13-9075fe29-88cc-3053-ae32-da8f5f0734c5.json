  "rdfs:comment": {
    "de": [
      "Das Fasthôtel de Montmarault empfängt Sie für einen Zwischenstopp auf dem Weg in den Urlaub oder für eine Geschäftsreise an 7 Tagen in der Woche."
    ],
    "en": [
      "The Fasthôtel de Montmarault welcomes you for a stopover on your way to your holidays or for a business trip 7 days a week."
    ],
    "it": [
      "Il Fasthôtel de Montmarault vi accoglie per una sosta durante le vostre vacanze o per un viaggio d'affari, 7 giorni su 7."
    ],
    "fr": [
      "Le Fasthôtel de Montmarault vous accueille pour une étape sur la route des vacances ou pour un déplacement professionnel 7j/7."
    ],
    "nl": [
      "Fasthôtel de Montmarault verwelkomt u 7 dagen per week voor een tussenstop op weg naar uw vakantie of voor een zakenreis."
    ],
    "es": [
      "El Fasthôtel de Montmarault le da la bienvenida para una parada en el camino de sus vacaciones o para un viaje de negocios los 7 días de la semana."
    ]
  },
