  "rdfs:comment": {
    "de": [
      "Machen Sie sich auf den Weg, um die Landschaften des Saône-Tals kennenzulernen.\r\nVon der natürlichen Umgebung der Flussufer bis zu den Wegen des Dombes-Plateaus entdecken Sie zwischen grünen Inseln Panoramablicke auf das Beaujolais."
    ],
    "en": [
      "Discover the landscapes of the Saône valley.\r\nFrom the natural setting of the river banks to the paths of the Dombes plateau, you'll discover panoramic views of the Beaujolais between islands of greenery."
    ],
    "it": [
      "Scoprite i paesaggi della Val de Saône.\r\nDallo scenario naturale delle rive del fiume ai sentieri dell'altopiano di Dombes, scoprirete viste panoramiche sul Beaujolais tra isole di verde."
    ],
    "fr": [
      "Partez à la rencontre des paysages du val de Saône. \r\nDepuis le cadre naturel des berges de la rivière jusqu’au chemins du plateau de Dombes, vous découvrirez des panoramas sur le Beaujolais entre des îlôts de verdure."
    ],
    "nl": [
      "Ontdek de landschappen van de Val de Saône.\r\nVan de natuurlijke omgeving van de rivieroevers tot de paden van het plateau van Dombes, ontdek je panoramische uitzichten over de Beaujolais tussen eilanden van groen."
    ],
    "es": [
      "Descubra los paisajes del Val de Saône.\r\nDesde el marco natural de las orillas del río hasta los senderos de la meseta de Dombes, descubrirá vistas panorámicas del Beaujolais entre islas de verdor."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Boucle gravel au départ de Trévoux"
    ]
  },
