  "rdfs:comment": {
    "de": [
      "Hausgemachte Pizzas, herzhafte Fladen aus 100% Buchweizen, Gerichte aus lokalen Produkten (Ravioles...), Entdeckung von Sch'ti-Gerichten... Vor Ort und zum Mitnehmen. Gesellige und familiäre Atmosphäre."
    ],
    "en": [
      "Traditional and local cuisine, home-made pizzas to eat in or take away, discovery of Ch'ti dishes from Hauts de France."
    ],
    "it": [
      "Pizze fatte in casa, galette al 100% di grano saraceno, piatti a base di prodotti locali (ravioles...), scoperta dei piatti Ch'ti... Da mangiare o da portare via. Atmosfera amichevole e familiare."
    ],
    "fr": [
      "Pizzas maison, galettes salées 100% blé noir, plats issus de produits locaux ( ravioles...), découverte de plats ch'ti... Sur place et à emporter. Ambiance conviviale et familiale."
    ],
    "es": [
      "Pizzas caseras, galettes 100% trigo sarraceno, platos elaborados con productos locales (ravioles...), descubrimiento de platos ch'ti... Para comer o llevar. Ambiente acogedor y familiar."
    ],
    "nl": [
      "Huisgemaakte pizza's, 100% boekweit galettes, gerechten gemaakt met lokale producten (ravioli...), ontdekking van Ch'ti gerechten... Om te eten of om mee te nemen. Vriendelijke, familiale sfeer."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Tentations d'Antoine"
    ]
  },
