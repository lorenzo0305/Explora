  "rdfs:comment": {
    "de": [
      "Im Vallée des Belleville gibt es zahlreiche natürliche Bergseen, von denen einige Sie unberührte Bereiche der Trois Vallées entdecken lassen."
    ],
    "en": [
      "The Belleville Valley is full of natural mountain lakes, some of which will allow you to discover the unspoilt areas of the Three Valleys."
    ],
    "it": [
      "La Valle di Belleville è ricca di laghi naturali di montagna, alcuni dei quali vi porteranno in zone incontaminate delle Tre Valli."
    ],
    "fr": [
      "La Vallée des Belleville regorge de nombreux lacs naturels de montagne dont certains vous feront découvrir des secteurs préservés des Trois Vallées."
    ],
    "es": [
      "El valle de Belleville está lleno de lagos naturales de montaña, algunos de los cuales le llevarán a zonas vírgenes de los Tres Valles."
    ],
    "nl": [
      "De Belleville vallei is vol natuurlijke bergmeren, waarvan sommige u naar ongerepte gebieden van de Drie Valleien brengen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les lacs de la Vallée des Belleville"
    ]
  },
