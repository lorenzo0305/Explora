  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/b779daff-2dd2-30f6-a3a1-c7e268e72420",
      "dc:description": {
        "de": [
          "Straßenrennen\n\n5km-Lauf - Rundkurs auf der Straße - Start um 16:00 Uhr - 5?\n10km-Lauf - 2 Runden à 5km - Start um 16:00 Uhr - 6?\n\nAnmeldung und Startnummernausgabe von 14.00 bis 15.30 Uhr im Saal Edith Piaf\nAnmeldung über Chronopale oder Service événementiel bis zum 03. März 2026 oder vor Ort von 14.00 bis 15.30 Uhr (Aufschlag von 3?)\n\nOrganisiert von der Stadtverwaltung mit der Beteiligung des COSEC und der Unterstützung des BACO"
        ],
        "en": [
          "Road racing\n\n5km race - road circuit - start at 16h00 - 5?\n10km race - 2 loops of 5km - start at 16h00 - 6?\n\nRegistration and bib collection from 2:00 pm to 3:30 pm at the Edith Piaf hall\nRegistration on Chronopale or Service événementiel until March 03, 2026 or possible on site from 2:00 pm to 3:30 pm (3? surcharge)\n\nOrganized by the Municipality with the participation of the COSEC and the support of the BACO"
        ],
        "it": [
          "Gare su strada\n\nGara di 5 km - circuito stradale - partenza alle 16:00 - 5?\nGara di 10 km - 2 giri di 5 km - partenza alle 16:00 - 6?\n\nIscrizioni e ritiro dei numeri dalle 14.00 alle 15.30 nella Salle Edith Piaf\nIscrizione su Chronopale o Service événementiel fino al 03 marzo 2026 o possibile sul posto dalle 14:00 alle 15:30 (supplemento 3?)\n\nOrganizzato dal Municipio con la partecipazione della COSEC e il sostegno del BACO"
        ],
        "fr": [
          "Course sur route\n\nCourse 5km - circuit sur route - départ à 16h00 - 5€\nCourse 10km - 2 boucles de 5km - départ 16h00 - 6€\n\nInscriptions et retrait des dossards de 14h00 à 15h30 salle Edith Piaf\nInscriptions sur Chronopale ou Service événementiel jusqu'au 03 mars 2026 ou possibles sur place de 14h00 à 15h30 (majoration de 3€)\n\nOrganisé par la Municipalité avec la participation du COSEC et le soutien du BACO"
        ],
        "nl": [
          "Wegwedstrijden\n\n5km wedstrijd - wegcircuit - start om 16:00 - 5?\n10km wedstrijd - 2 lussen van 5km - start om 16u00 - 6?\n\nInschrijving en nummerafhaling van 14u00 tot 15u30 in de Salle Edith Piaf\nInschrijving op Chronopale of Service événementiel tot 03 maart 2026 of ter plaatse mogelijk van 14u00 tot 15u30 (toeslag 3?)\n\nGeorganiseerd door het Stadhuis met de deelname van de COSEC en de steun van de BACO"
        ],
        "es": [
          "Carreras por carretera\n\nCarrera de 5 km - circuito de carretera - salida a las 16h00 - 5?\nCarrera de 10 km - 2 vueltas de 5 km - salida a las 16h00 - 6?\n\nInscripción y recogida de dorsales de 14h00 a 15h30 en la Salle Edith Piaf\nInscripción en Chronopale o Service événementiel hasta el 03 de marzo de 2026 o posible in situ de 14h00 a 15h30 (suplemento de 3?)\n\nOrganizado por el Ayuntamiento con la participación de la COSEC y el apoyo de la BACO"
        ]
      },
