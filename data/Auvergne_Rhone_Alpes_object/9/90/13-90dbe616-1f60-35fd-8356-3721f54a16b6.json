  "rdfs:comment": {
    "de": [
      "Team Break Grenoble, die immersivste Agentur für Gruppenspiele!\r\nBegeben Sie sich mit Ihrem Team in eine Welt voller Szenarien und versuchen Sie, die zahlreichen Rätsel zu lösen, die sich Ihnen stellen, um in weniger als 60 Minuten aus einem Escape Room zu entkommen!"
    ],
    "en": [
      "Team Break Grenoble, the most immersive agency for group games!\r\nEnter a scripted universe with your team and try to solve the many enigmas you'll encounter to escape from an escape room in under 60 minutes!"
    ],
    "it": [
      "Team Break Grenoble, l'agenzia più coinvolgente per i giochi di gruppo!\r\nEntrate in un universo programmato con la vostra squadra e cercate di risolvere i numerosi enigmi che vi costringeranno a fuggire da una escape room in meno di 60 minuti!"
    ],
    "fr": [
      "Team Break Grenoble, l’agence la plus immersive en jeux de groupe ! \r\nEntrez dans un univers scénarisé avec votre équipe et tentez de résoudre les multiples énigmes qui s’imposeront à vous afin de vous échapper d’une escape room en moins de 60 minutes !"
    ],
    "nl": [
      "Team Break Grenoble, het meest meeslepende bureau voor groepsspellen!\r\nBetreed met je team een gescript universum en probeer de vele raadsels op te lossen die jullie dwingen om in minder dan 60 minuten uit een ontsnappingskamer te ontsnappen!"
    ],
    "es": [
      "Team Break Grenoble, ¡la agencia de juegos en grupo más inmersiva!\r\n¡Entra en un universo guionizado con tu equipo e intenta resolver los numerosos enigmas que os obligarán a escapar de una escape room en menos de 60 minutos!"
    ]
  },
