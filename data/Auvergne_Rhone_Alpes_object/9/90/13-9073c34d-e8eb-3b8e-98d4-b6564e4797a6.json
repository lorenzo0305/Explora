  "rdfs:comment": {
    "de": [
      "Die Bienenhäuser von Cordon zeugen von einer Bienenzuchttradition im Dorf. Diese Bienenstöcke, die von lokalen Imkern gepflegt werden, können noch immer einen Berghonig produzieren."
    ],
    "en": [
      "Cordon's apiaries bear witness to the village's beekeeping tradition. Maintained by local beekeepers, these apiaries can still produce mountain honey."
    ],
    "it": [
      "Gli alveari di Cordon testimoniano la tradizione apistica del villaggio. Questi alveari, curati dagli apicoltori locali, producono ancora miele di montagna."
    ],
    "fr": [
      "Les ruchers de Cordon témoignent d'une tradition apicole dans le village. Ces ruchers entretenues par des apiculteur locaux peuvent encore produire un miel de montagne."
    ],
    "es": [
      "Las colmenas de Cordon atestiguan la tradición apícola del pueblo. Estas colmenas, cuidadas por apicultores locales, siguen produciendo miel de montaña."
    ],
    "nl": [
      "De bijenkorven in Cordon getuigen van de bijenteelttraditie van het dorp. Deze bijenkorven worden onderhouden door plaatselijke imkers en produceren nog steeds berghoning."
    ]
  },
