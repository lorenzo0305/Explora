  "rdfs:comment": {
    "de": [
      "Zu Tisch! Raffinierte und großzügige Küche aus frischen Zutaten. Die Menüs werden zu jeder Jahreszeit gewechselt. Der Käse- und Dessertwagen wird Sie nicht gleichgültig lassen!"
    ],
    "en": [
      "At the table! Refined and generous cuisine based on fresh products. The menus are changed every season. The cheese and dessert cart will not leave you indifferent!"
    ],
    "it": [
      "A tavola! Cucina raffinata e generosa a base di prodotti freschi. I menu vengono cambiati ogni stagione. Il carrello dei formaggi e dei dessert non vi lascerà indifferenti!"
    ],
    "fr": [
      "À table ! Cuisine raffinée et généreuse à base de produits frais. Les menus sont changés à chaque saison. Le chariot de fromages et de desserts ne vous laisseront pas indifférents !"
    ],
    "es": [
      "¡A la mesa! Cocina refinada y generosa basada en productos frescos. Los menús cambian cada temporada. ¡El carrito de quesos y postres no le dejará indiferente!"
    ],
    "nl": [
      "Aan tafel! Een verfijnde en genereuze keuken op basis van verse producten. De menu's worden elk seizoen gewijzigd. De kaas- en dessertwagen zal u niet onverschillig laten!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant de la Poste"
    ]
  },
