  "rdfs:comment": {
    "de": [
      "Seit mehreren Jahrzehnten bündeln Winzer aus ganz Frankreich ihre Kräfte und legen ihre Mittel zusammen, um die Weine zu produzieren, die Sie jeden Tag auf Ihren Tischen finden."
    ],
    "en": [
      "For several decades now, winegrowers from all over France have been pooling their strengths and resources to produce the wines you find on your tables every day."
    ],
    "it": [
      "Per diversi decenni, i viticoltori di tutta la Francia hanno unito le forze e messo in comune le loro risorse per produrre i vini che trovate ogni giorno sulla vostra tavola."
    ],
    "fr": [
      "Depuis plusieurs décennies des vignerons de toute la France unissent leur force et mettent en commun leurs moyens pour produire les vins que vous retrouvez chaque jour sur vos tables."
    ],
    "es": [
      "Desde hace varias décadas, viticultores de toda Francia unen sus fuerzas y ponen en común sus recursos para producir los vinos que usted encuentra cada día en su mesa."
    ],
    "nl": [
      "Al tientallen jaren bundelen wijnboeren uit heel Frankrijk hun krachten en middelen om de wijnen te produceren die je elke dag op tafel vindt."
    ]
  },
