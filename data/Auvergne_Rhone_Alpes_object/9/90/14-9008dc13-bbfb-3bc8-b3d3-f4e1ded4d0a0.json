      "dc:description": {
        "de": [
          "An jedem Tag der Schulferien können die Kinder verschiedene Aktivitäten unternehmen: Lesen, Spielzeug an Holzspielen..."
        ],
        "en": [
          "Every day during the school vacations, children can take part in a variety of activities: reading, playing with wooden toys..."
        ],
        "it": [
          "Ogni giorno, durante le vacanze scolastiche, i bambini possono partecipare a diverse attività: leggere, giocare con giocattoli di legno, ecc."
        ],
        "fr": [
          "Chaque jour des vacances scolaires, les enfants pourront faire diverses activités : lecture, jouets aux jeux en bois..."
        ],
        "es": [
          "Todos los días durante las vacaciones escolares, los niños pueden participar en diversas actividades: leer, jugar con juguetes de madera, etc."
        ],
        "nl": [
          "Elke dag tijdens de schoolvakanties kunnen kinderen deelnemen aan verschillende activiteiten: lezen, spelen met houten speelgoed, enz."
        ]
