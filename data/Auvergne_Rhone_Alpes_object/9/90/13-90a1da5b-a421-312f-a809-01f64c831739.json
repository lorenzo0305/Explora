  "rdfs:comment": {
    "de": [
      "Willkommen im Tourismusbüro von Hautes Terres in Le Lioran, im Herzen des Ortes. Ein professionelles Team wird Ihnen alle guten Ratschläge für einen gelungenen Aufenthalt geben!"
    ],
    "en": [
      "Welcome to the Hautes Terres tourist office located in Le Lioran, in the heart of the resort, a team of professionals will give you all the right advice for a successful stay!"
    ],
    "it": [
      "Benvenuti all'ufficio turistico delle Hautes Terres, situato a Le Lioran, nel cuore della località. Un team di professionisti vi darà tutti i consigli necessari per un soggiorno di successo!"
    ],
    "fr": [
      "Bienvenue au bureau de tourisme de Hautes Terres situé au Lioran, au cœur de la station, une équipe de professionnels ne manquera de vous donner tous les bons conseils pour un séjour réussi !"
    ],
    "nl": [
      "Welkom bij het toeristenbureau van de Hautes Terres, gelegen in Le Lioran, in het hart van de badplaats. Een team van professionals geeft u al het nodige advies voor een geslaagd verblijf!"
    ],
    "es": [
      "Bienvenido a la oficina de turismo de Hautes Terres, situada en Le Lioran, en el corazón de la estación, donde un equipo de profesionales le asesorará para que su estancia sea un éxito"
    ]
  },
  "rdfs:label": {
