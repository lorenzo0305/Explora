  "rdfs:comment": {
    "de": [
      "Verkauf: Briefmarken, Pakete, postfertige Umschläge. Post: Weiterleitung oder Verwahrung, Abholung von Einschreiben und Paketen. Finanzielle Nothilfe: Bargeldabhebung und -einzahlung, Antrag auf Ausstellung oder Zahlung einer Baranweisung."
    ],
    "en": [
      "Sales: stamps, parcels, ready-to-post envelopes. Mail: forwarding or safekeeping, registered mail and parcels. Emergency financial operations: cash withdrawals and deposits, requests for issuance or payment of money orders."
    ],
    "it": [
      "Vendite: francobolli, pacchi, buste pronte per l'invio. Posta: inoltro o custodia, raccomandate e pacchi. Operazioni finanziarie: prelievi e pagamenti in contanti, richieste di emissione o pagamento di vaglia."
    ],
    "fr": [
      "Vente : timbres, colis, enveloppes prêt à poster. Courrier : réexpédition ou garde, retrait recommandé et colis. Opérations financières de dépannage : retrait et versement espèce, demande émission ou paiement mandat cash."
    ],
    "nl": [
      "Verkoop: postzegels, pakketten, kant-en-klare enveloppen. Post: doorsturen of in bewaring nemen, ophalen van aangetekende zendingen en pakketten. Dringende financiële transacties: geldopnames en -betalingen, verzoeken om uitgifte of betaling van kasopdrachten."
    ],
    "es": [
      "Venta: sellos, paquetes, sobres listos para enviar. Correo: reenvío o custodia, correo certificado y paquetes. Operaciones financieras: retiros y pagos en efectivo, solicitudes de emisión o pago de giros postales."
    ]
  },
