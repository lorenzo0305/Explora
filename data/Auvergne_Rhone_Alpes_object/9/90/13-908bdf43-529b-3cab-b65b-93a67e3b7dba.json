  "rdfs:comment": {
    "de": [
      "Im Herzen von Avoriaz empfängt Sie das Le Fantastic auf seiner großen Sonnenterrasse zu einer Mahlzeit, einer Crêpes-Pause oder einem festlichen Aperitif. Hausgemachte Küche, Sportübertragungen, Cocktails und gute Stimmung sind den ganzen Tag über garantiert."
    ],
    "en": [
      "In the heart of Avoriaz, Le Fantastic welcomes you on its large sunny terrace for a meal, a crêpe break, or a festive aperitif. Homemade cuisine, live sports broadcasts, cocktails, and a great atmosphere all day long — guaranteed."
    ],
    "it": [
      "Nel cuore di Avoriaz, Le Fantastic vi accoglie nella sua grande terrazza soleggiata per un pasto, una pausa crêpe o un aperitivo festivo. Cucina casalinga, trasmissioni sportive, cocktail e una grande atmosfera garantita per tutto il giorno."
    ],
    "fr": [
      "Au cœur d’Avoriaz, Le Fantastic vous accueille sur sa grande terrasse ensoleillée pour un repas, une pause crêpes ou un apéro festif. Cuisine maison, retransmissions sportives, cocktails et bonne ambiance garantis toute la journée."
    ],
    "nl": [
      "In het hart van Avoriaz heet Le Fantastic je welkom op zijn grote, zonnige terras voor een maaltijd, een crêpe-pauze of een feestelijk aperitief. Huisgemaakte gerechten, live sportuitzendingen, cocktails en de hele dag door een gezellige sfeer — gegarandeerd."
    ],
    "es": [
      "En el corazón de Avoriaz, Le Fantastic le acoge en su gran terraza soleada para una comida, una pausa para crêpes o un aperitivo festivo. Cocina casera, retransmisiones deportivas, cócteles y un gran ambiente garantizados durante todo el día."
    ]
  },
  "rdfs:label": {
    "en": [
      "Le Fantastic Bar"
    ],
