  "rdfs:comment": {
    "de": [
      "Dorf Chassagnes: Alte Kirche. Kapelle aus dem 19. Jahrhundert mit polychromer Jungfrau. Schloss aus dem 19. Jahrhundert (privat). Lehmhäuser in L'Hermet, La Croix, Faveyrolles und Chassagnes."
    ],
    "en": [
      "Village of Chassagnes: Old church. 19th-century chapel with polychrome Virgin Mary. 19th-century château (private). Adobe houses in L'Hermet, La Croix, Faveyrolles and Chassagnes."
    ],
    "it": [
      "Villaggio di Chassagnes: antica chiesa. Cappella del XIX secolo con Madonna policroma. Castello del XIX secolo (privato). Case di Adobe a l'Hermet, La Croix, Faveyrolles e Chassagnes."
    ],
    "fr": [
      "Village de Chassagnes : Église ancienne. Chapelle du XIXe siècle avec vierge polychrome. Château du XIXe siècle (privé). Maisons en pisé à l’Hermet, La Croix, Faveyrolles et Chassagnes."
    ],
    "es": [
      "Pueblo de Chassagnes: Antigua iglesia. Capilla del siglo XIX con la Virgen María policromada. Castillo del siglo XIX (privado). Casas de adobe en l'Hermet, La Croix, Faveyrolles y Chassagnes."
    ],
    "nl": [
      "Dorp Chassagnes: Oude kerk. 19e-eeuwse kapel met polychrome Maagd Maria. Kasteel uit de 19e eeuw (privé). Adobe huizen in l'Hermet, La Croix, Faveyrolles en Chassagnes."
    ]
  },
