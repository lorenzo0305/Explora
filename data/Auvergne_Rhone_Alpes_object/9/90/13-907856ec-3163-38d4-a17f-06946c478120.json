  "rdfs:comment": {
    "de": [
      "Als Imker vom Vater auf die Tochter ist die Familie Coudert für ihren Honig und ihre hochwertigen Produkte bekannt. Isabelle Coudert verarbeitet und formt Produkte aus ihrem Honig."
    ],
    "en": [
      "Beekeepers from father to daughter, the Coudert family is renowned for its honey and quality products. Isabelle Coudert transforms and shapes products from her honey."
    ],
    "it": [
      "Apicoltori di padre in figlia, la famiglia Coudert è rinomata per il suo miele e i suoi prodotti di qualità. Isabelle Coudert trasforma e realizza prodotti a partire dal suo miele."
    ],
    "fr": [
      "Apiculteurs de père en fille, la famille Coudert  est renommée pour son miel et ses produits de qualité. Isabelle Coudert  transforme et façonne les produits à partir de son miel."
    ],
    "nl": [
      "De familie Coudert, imker van vader op dochter, staat bekend om haar honing en haar kwaliteitsproducten. Isabelle Coudert verwerkt en maakt producten van haar honing."
    ],
    "es": [
      "Apicultores de padre a hija, la familia Coudert es conocida por su miel y sus productos de calidad. Isabelle Coudert transforma y elabora productos a partir de su miel."
    ]
  },
