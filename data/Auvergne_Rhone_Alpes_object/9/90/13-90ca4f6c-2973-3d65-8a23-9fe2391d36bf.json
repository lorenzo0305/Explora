  "rdfs:comment": {
    "de": [
      "Hotel** - Familienrestaurant, ruhig und abseits der Straße gelegen mit außergewöhnlichem Blick auf den Lac Chambon und das Massif du Sancy."
    ],
    "en": [
      "Family hotel - restaurant, quiet and set back from the road with an exceptional view of the Lac Chambon and the Massif du Sancy."
    ],
    "it": [
