  "rdfs:comment": {
    "de": [
      "Willkommen an unserer unumgänglichen Adresse für eine angenehme Zeit in Pont-de-Vaux! Ob Sie nun auf der Suche nach einem schnellen und köstlichen Mittagessen oder einem unvergesslichen Abendessen sind, unser Lokal ist der ideale Ort, um Ihre Geschmacksnerven zu befriedigen."
    ],
    "en": [
      "Welcome to our must-visit address for a great time in Pont-de-Vaux! Whether you're looking for a quick, delicious lunch or a memorable dinner, our establishment is the ideal place to satisfy your taste buds."
    ],
    "it": [
      "Benvenuti al nostro indirizzo imperdibile per divertirvi a Pont-de-Vaux! Che siate alla ricerca di un pranzo veloce e delizioso o di una cena memorabile, il nostro locale è il luogo ideale per soddisfare il vostro palato."
    ],
    "fr": [
      "Bienvenue dans notre adresse incontournable pour un agréable moment à Pont-de-Vaux ! Que vous soyez à la recherche d'un déjeuner rapide et délicieux ou d'un dîner mémorable, notre établissement est l'endroit idéal pour satisfaire vos papilles gustatives."
    ],
    "nl": [
      "Welkom bij ons must-visit adres voor een geweldige tijd in Pont-de-Vaux! Of je nu op zoek bent naar een snelle en heerlijke lunch of een onvergetelijk diner, ons etablissement is de ideale plek om je smaakpapillen te bevredigen."
    ],
    "es": [
      "Bienvenido a nuestra dirección de visita obligada para pasarlo en grande en Pont-de-Vaux Tanto si busca un almuerzo rápido y delicioso como una cena memorable, nuestro establecimiento es el lugar ideal para satisfacer sus papilas gustativas."
    ]
  },
