  "rdfs:comment": {
    "de": [
      "Ein lebensgroßes Escape Game mit dem Thema \"Überleben\", bei dem Ihre individuellen und kollektiven Fähigkeiten auf die Probe gestellt werden. Ab 5 Teilnehmern ist der Start gesichert."
    ],
    "en": [
      "A life-size Escape Game on the theme of \"survival\", where your individual and collective skills will be put to the test. Departure guaranteed from 5 participants."
    ],
    "it": [
      "Un Escape Game a grandezza naturale sul tema della \"sopravvivenza\" in cui le vostre abilità individuali e collettive saranno messe alla prova. Garantito a partire da 5 partecipanti."
    ],
    "fr": [
      "Un Escape Game grandeur nature avec pour thématique la \"survie\" où vos compétences individuelles et collectives seront misent à l'épreuve. Départ assuré à partir de 5 participants."
    ],
    "es": [
      "Un Juego de Escape a tamaño real sobre el tema de la \"supervivencia\" en el que se pondrán a prueba vuestras habilidades individuales y colectivas. Garantizado a partir de 5 participantes."
    ],
    "nl": [
      "Een levensgroot Escape Game met als thema \"overleven\" waar jullie individuele en collectieve vaardigheden op de proef worden gesteld. Gegarandeerd vanaf 5 deelnemers."
    ]
  },
