  "rdfs:comment": {
    "de": [
      "Kommen Sie und genießen Sie unsere 6 Tennisplätze im Freien mit einem atemberaubenden Blick auf die Berge! Ob Sie nun Sand (4 Plätze) oder Quick (2 Plätze) bevorzugen, treten Sie mit der Familie oder mit Freunden gegeneinander an."
    ],
    "en": [
      "Come and enjoy our 6 open-air tennis courts with a breathtaking view of the mountains! Whether you prefer clay (4 courts) or quick (2 courts), come and play with your family or friends."
    ],
    "it": [
      "Venite a godervi i nostri 6 campi da tennis all'aperto con una vista mozzafiato sulle montagne! Che preferiate la terra battuta (4 campi) o il veloce (2 campi), venite a giocare con la vostra famiglia o i vostri amici."
    ],
    "fr": [
      "Venez profiter de nos 6 courts de tennis en plein air avec une vue imprenable sur les montagnes ! Que vous préfériez la terre battue (4 courts) ou le quick (2 courts), venez vous affronter en famille ou entre amis."
    ],
    "es": [
      "Venga a disfrutar de nuestras 6 pistas de tenis al aire libre con una impresionante vista de las montañas Tanto si prefiere la tierra batida (4 pistas) como la pista rápida (2 pistas), venga a jugar con su familia o sus amigos."
    ],
    "nl": [
      "Kom genieten van onze 6 openlucht tennisbanen met een adembenemend uitzicht op de bergen! Of je nu van gravel (4 banen) of snel (2 banen) houdt, kom spelen met je familie of vrienden."
    ]
  },
