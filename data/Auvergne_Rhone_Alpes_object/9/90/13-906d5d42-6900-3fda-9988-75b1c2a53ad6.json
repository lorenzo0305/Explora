  "rdfs:comment": {
    "de": [
      "Das Maté in Vézeronce-Curtin ist ein Gourmet-Tisch, an dem sich lokale Produkte, argentinische Inspiration und französisches Know-how vereinen. Eine sensible und kreative Küche an einem gemütlichen Ort in den Balcons du Dauphiné."
    ],
    "en": [
      "Located in Vézeronce-Curtin, Le Maté is a fine dining restaurant where local produce, Argentine inspiration and French culinary expertise come together. A thoughtful and creative cuisine in a warm, welcoming setting in the Balcons du Dauphiné."
    ],
    "it": [
      "Situato a Vézeronce-Curtin, Le Maté è un ristorante gourmet che unisce prodotti locali, ispirazione argentina e savoir-faire francese. Una cucina sensibile e creativa in un ambiente accogliente nei Balcons du Dauphiné."
    ],
    "fr": [
      "Situé à Vézeronce-Curtin, le Maté est une table gastronomique où s’unissent produits locaux, inspiration argentine et savoir-faire français. Une cuisine sensible et créative dans un lieu chaleureux aux Balcons du Dauphiné."
    ],
    "es": [
      "Situado en Vézeronce-Curtin, Le Maté es un restaurante gastronómico que combina productos locales, inspiración argentina y savoir-faire francés. Cocina sensible y creativa en un entorno cálido en los Balcons du Dauphiné."
    ],
    "nl": [
      "Le Maté, gelegen in Vézeronce-Curtin, is een gastronomisch restaurant dat lokale producten, Argentijnse inspiratie en Franse savoir-faire combineert. Een gevoelige, creatieve keuken in een warme omgeving in de Balcons du Dauphiné."
    ]
  },
