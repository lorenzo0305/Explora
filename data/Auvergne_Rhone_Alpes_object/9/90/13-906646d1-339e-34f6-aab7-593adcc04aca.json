  "rdfs:comment": {
    "de": [
      "DIE 70ER JAHRE - MIKE BRANT SHOW mit Claude ARENA Doppelgänger von Mike Brant\r\n2 Stunden Live-Show mit einer außergewöhnlichen Inszenierung zu den besten Hits der letzten 15 Jahre.\r\n15 Künstler auf der Bühne mit Musikern, Sängerinnen und Sängern."
    ],
    "en": [
      "THE 70S - MIKE BRANT SHOW with Mike Brant look-alike Claude ARENA\r\na 2 h 00 live show with an exceptional staging of the best hits of the last 15 years.\r\n15 artists on stage with musicians and singers."
    ],
    "it": [
      "THE 70S - MIKE BRANT SHOW con il sosia di Mike Brant Claude ARENA\r\nuno spettacolo dal vivo di 2 ore con una messa in scena eccezionale dei migliori successi degli ultimi 15 anni.\r\n15 artisti sul palco con musicisti e cantanti."
    ],
    "fr": [
      "LES ANNEES 70 - SHOW MIKE BRANT avec Claude ARENA sosie de Mike Brant\r\n2 h 00 de spectacle en direct avec une mise en scène exceptionnelle sur les meilleurs succès de ces 15 dernières années.\r\n15 artistes sur scène avec musiciens, chanteuses et chanteurs."
    ],
    "nl": [
      "THE 70S - MIKE BRANT SHOW met Mike Brant lookalike Claude ARENA\r\neen 2 uur durende liveshow met een uitzonderlijke enscenering van de beste hits van de afgelopen 15 jaar.\r\n15 artiesten op het podium met muzikanten en zangers."
    ],
    "es": [
      "THE 70S - MIKE BRANT SHOW con el doble de Mike Brant Claude ARENA\r\nun espectáculo en directo de 2 h 00 con una excepcional puesta en escena de los mejores éxitos de los últimos 15 años.\r\n15 artistas en escena con músicos y cantantes."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Compagnie Péricard présente : Les Années 70 + Show Mike Brant"
    ]
  },
