  "rdfs:comment": {
    "de": [
      "Brauchen Sie einen Moment der Selbstreflexion? Wir haben genau das Richtige für Sie!\r\nWer hat gesagt, dass \"Liebesgeschichten meistens schlecht enden\"?"
    ],
    "en": [
      "Need a moment of introspection? We've got just the thing!\nWho said that \"love stories usually end badly\"?"
    ],
    "it": [
      "Avete bisogno di un momento di introspezione? Abbiamo quello che fa per voi!\r\nChi ha detto che \"le storie d'amore di solito finiscono male\"?"
    ],
    "fr": [
      "Besoin d’un moment d’introspection ? On a ce qu’il vous faut !\r\nQui a dit que « les histoires d’amour finissent mal, en général » ?"
    ],
    "es": [
      "¿Necesita un momento de introspección? Tenemos justo lo que necesita\r\n¿Quién dijo que \"las historias de amor suelen acabar mal\"?"
    ],
