  "rdfs:comment": {
    "de": [
      "Entdecken Sie meine Welt zwischen Holz und Metall, wo sich Schmiedekunst und Hammer mit der Feinheit eines geschliffenen Stechbeitels vereinen. Hier finden Sie Kunstbesteck, Geigenbau und Gießerei."
    ],
    "en": [
      "Come and discover my universe between wood and metals, where the forge and the hammer blend with the finesse of a sharp wood chisel. You will find art cutlery, violin making and foundry there."
    ],
    "it": [
      "Venite a scoprire il mio mondo tra legno e metallo, dove la forgia e il martello si combinano con la finezza di uno scalpello affilato. Troverete posateria, liuteria e fonderia."
    ],
    "fr": [
      "Venez découvrir mon univers entre bois et métaux, où la forge et le marteau se marient avec la finesse d'un ciseau à bois affûté. Vous y trouverez coutellerie d'art, lutherie et fonderie ."
    ],
    "es": [
      "Venga a descubrir mi mundo entre la madera y el metal, donde la forja y el martillo se combinan con la delicadeza de un cincel de madera afilado. Encontrará cuchillería, fabricación de violines y fundición."
    ],
    "nl": [
      "Kom en ontdek mijn wereld tussen hout en metaal, waar de smederij en de hamer worden gecombineerd met de finesse van een geslepen houtbeitel. U vindt er bestek, vioolbouw en gieterij."
    ]
  },
