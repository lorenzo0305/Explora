  "rdfs:comment": {
    "de": [
      "Installation von elektrischen Anlagen und elektronischen Geräten.\r\nKauf und Pacht aller technischen Anlagen, die erneuerbare Energien nutzen, insbesondere im Bereich der Photovoltaik."
    ],
    "en": [
      "Installation of electrical and electronic equipment.\r\nPurchase and leasing of all technical installations using renewable energies, particularly photovoltaic energy."
    ],
    "it": [
      "Installazione di apparecchiature elettriche ed elettroniche.\r\nAcquisto e noleggio di tutte le installazioni tecniche che utilizzano fonti di energia rinnovabili, in particolare l'energia fotovoltaica."
    ],
    "fr": [
      "Installation d'équipements électriques, de matériels électroniques.\r\nAchat et prise à bail de toutes installations technique utilisant des énergies renouvelables et plus particulièrement dans le domaine de l'énergie photovoltaique."
    ],
    "nl": [
      "Installatie van elektrische en elektronische apparatuur.\r\nAankoop en verhuur van alle technische installaties die gebruikmaken van hernieuwbare energiebronnen, met name fotovoltaïsche energie."
    ],
    "es": [
      "Instalación de equipos eléctricos y electrónicos.\r\nCompra y alquiler de todas las instalaciones técnicas que utilicen fuentes de energía renovables, en particular energía fotovoltaica."
    ]
  },
  "rdfs:label": {
