  "rdfs:comment": {
    "de": [
      "Traditionelles Restaurant mit einer großen Auswahl an Fleisch- und Fischgerichten sowie Berg- und lokalen Spezialitäten.\r\nSchöne Weinkarte\r\nFür Genießer und Liebhaber eines großzügigen und schmackhaften Essens"
    ],
    "en": [
      "Traditional restaurant, offering a wide choice of exceptional wood-fired meats, freshwater fish, mountain and local specialities.\r\nRich wine list \r\nFor epicureans, lovers of rich and generous food"
    ],
    "it": [
      "Ristorante tradizionale che offre un'ampia scelta di carni eccezionali cotte a legna, pesce d'acqua dolce, specialità di montagna e locali.\r\nRicca carta dei vini \r\nPer gli epicurei, gli amanti del cibo ricco e generoso"
    ],
    "fr": [
      "Restaurant traditionnel, proposant un large choix de viandes , de poissons, de spécialités montagnardes et locales.\r\nBelle carte des vins\r\nPour les épicuriens, les amateurs de table gourmande  et généreuse"
    ],
    "nl": [
      "Traditioneel restaurant met een ruime keuze aan vlees, vis, berg- en lokale specialiteiten.\r\nEen fijne wijnkaart\r\nVoor levensgenieters en liefhebbers van een gulle, gastronomische keuken"
    ],
    "es": [
      "Restaurante tradicional que ofrece una amplia selección de carnes, pescados, especialidades de montaña y locales.\r\nUna excelente carta de vinos\r\nPara epicúreos y amantes de la cocina generosa y gourmet"
    ]
  },
