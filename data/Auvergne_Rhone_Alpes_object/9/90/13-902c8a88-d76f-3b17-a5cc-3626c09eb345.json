  "rdfs:comment": {
    "de": [
      "Gutes, günstige Preise und Frankreich. Wer ein Restaurant La Pataterie betritt, entdeckt eine gemütliche Welt in ländlicher Atmosphäre. Mit der Familie oder mit Freunden lassen Sie sich inmitten unserer rustikalen Gegenstände nieder, die Sie an die gute alte Zeit erinnern werden."
    ],
    "en": [
      "Good food, good prices and a French touch. When you enter a La Pataterie restaurant, you'll discover a warm, country atmosphere. Whether you're with family or friends, you'll find yourself surrounded by rustic objects that will remind you of the good old days."
    ],
    "it": [
      "Buon cibo, buoni prezzi e Francia. Entrare in un ristorante La Pataterie significa scoprire un universo caldo in un'atmosfera di campagna. Con la famiglia o gli amici, sedetevi tra i nostri oggetti rustici che vi ricorderanno i bei tempi andati."
    ],
    "fr": [
      "Du bon, des prix et de la France. Entrer dans un restaurant La Pataterie, c'est découvrir un univers chaleureux dans une ambiance champêtre. En famille, entre amis, installez-vous au milieu de nos objets rustiques qui vous rappelleront le bon vieux temps."
    ],
    "nl": [
      "Lekker eten, goede prijzen en de Franse keuken. Als je een restaurant van La Pataterie binnenstapt, ontdek je een warme, landelijke sfeer. Of je nu met familie of vrienden bent, neem plaats tussen onze rustieke voorwerpen die je doen denken aan de goede oude tijd."
    ],
    "es": [
      "Buena comida, buenos precios y Francia. Entrar en un restaurante La Pataterie es descubrir un universo cálido en un ambiente campestre. En familia o con amigos, siéntese entre nuestros objetos rústicos que le recordarán los buenos tiempos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Pataterie"
    ]
  },
