  "rdfs:comment": {
    "de": [
      "Empfang und Verkauf von Angelscheinen für Erwachsene. Angelschule für 8- bis 15-Jährige (Mittwochnachmittag von 14:00 bis 17:30 Uhr). Fliegenfischer sind herzlich willkommen."
    ],
    "en": [
      "Fishing license to purchase for adults. Fishing school for children from 8 to 15 (Wednesday afternoons from 2pm to 5:30pm). Fly fishers welcome."
    ],
    "it": [
      "Ricezione e vendita di licenze di pesca per adulti. Scuola di pesca per ragazzi dagli 8 ai 15 anni (mercoledì pomeriggio dalle 14.00 alle 17.30). I pescatori a mosca sono i benvenuti."
    ],
    "fr": [
      "Accueil et vente de permis de pêche pour les adultes. Ecole de pêche pour les 8-15 ans (mercredi après-midi de 14h à 17h30). Les pêcheurs à la mouche sont les bienvenus."
    ],
    "es": [
      "Recepción y venta de licencias de pesca para adultos. Escuela de pesca para jóvenes de 8 a 15 años (miércoles por la tarde, de 14 a 17.30 horas). Los pescadores con mosca son bienvenidos."
    ],
    "nl": [
      "Ontvangst en verkoop van visvergunningen voor volwassenen. Visserijschool voor 8-15 jaar (woensdagmiddag van 14.00 tot 17.30 uur). Vliegvissers zijn welkom."
    ]
  },
