  "rdfs:comment": {
    "de": [
      "Die Mediathek in Bourgoin-Jallieu empfängt Sie von Dienstag bis Samstag.\r\nHier finden Sie eine große Auswahl an Sammlungen: Bücher, CDs, DVDs, Abonnements und Zeitschriften."
    ],
    "en": [
      "The Bourgoin-Jallieu media library welcomes you from Tuesday to Saturday.\r\nYou will find a wide choice of collections: books, CDs, DVDs, subscriptions and magazines."
    ],
    "it": [
      "La mediateca Bourgoin-Jallieu vi accoglie dal martedì al sabato.\r\nTroverete un'ampia scelta di collezioni: libri, CD, DVD, abbonamenti e riviste."
    ],
    "fr": [
      "La médiathèque de Bourgoin-Jallieu vous accueille du mardi au samedi.\r\nVous trouverez un large choix de collections : livres, CD, DVD, abonnements et revues."
    ],
    "es": [
      "La mediateca de Bourgoin-Jallieu le acoge de martes a sábado.\r\nEncontrará una gran variedad de colecciones: libros, CDs, DVDs, suscripciones y revistas."
    ],
    "nl": [
      "De mediatheek van Bourgoin-Jallieu verwelkomt u van dinsdag tot zaterdag.\r\nU vindt er een ruime keuze aan collecties: boeken, cd's, dvd's, abonnementen en tijdschriften."
    ]
  },
