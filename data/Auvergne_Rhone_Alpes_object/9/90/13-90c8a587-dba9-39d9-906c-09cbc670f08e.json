  "rdfs:comment": {
    "de": [
      "Echter 18-Loch-Golfplatz in den Bergen.\r\nSpielen Sie Golf in einer einzigartigen Umgebung mit Greens, Fairways, Wasserbecken und Bunkern.\r\nDieser Golfplatz wird sowohl Amateure als auch Profis begeistern."
    ],
    "en": [
      "A true 18-hole mountain course.\r\nCome and play golf in a unique setting with its greens , fairways , bunkers and water basins.\r\nThis course will appeal to enthusiasts and golf professionals ."
    ],
    "it": [
      "Un autentico campo di montagna a 18 buche.\r\nVenite a giocare a golf in un ambiente unico con i suoi green, fairway, bacini d'acqua e bunker.\r\nQuesto campo piacerà sia agli appassionati di golf che ai professionisti."
    ],
    "fr": [
      "Véritable parcours de 18 trous en montagne.\r\nVenez jouer au golf dans un cadre unique avec ses greens, fairways, bassins d’eau et bunkers.\r\nCe parcours séduira les amateurs et les professionnels du golf."
    ],
    "es": [
      "Un auténtico campo de montaña de 18 hoyos.\r\nVenga a jugar al golf en un entorno único con sus greens, calles, balsas de agua y búnkers.\r\nEste campo gustará tanto a los aficionados al golf como a los profesionales."
    ],
    "nl": [
      "Een echte 18-holes baan in de bergen.\r\nKom golfen in een unieke omgeving met zijn greens, fairways, waterbekkens en bunkers.\r\nDeze baan zal zowel amateurs als professionals aanspreken."
    ]
  },
