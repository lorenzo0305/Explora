  "rdfs:comment": {
    "de": [
      "Das Dorf Chanteuges: Abtei aus dem 12. Jahrhundert, die im 15. Jahrhundert umgebaut wurde, romanische Kapitelle, Chorgestühl. Kapelle Sainte-Anne, genannt Chapelle de l'Abbé, aus dem 15. Überreste des Kreuzgangs. Verschiedenes kleines Kulturerbe. La Gravière: Baden, Wandern, Gesundheitsparcours."
    ],
    "en": [
      "The village of Chanteuges: 12th-century abbey, modified in the 15th century, with Romanesque capitals and stalls. 15th-century Chapelle Sainte-Anne, known as the Abbot?s Chapel. Remains of cloister. Various small heritage sites. La Gravière: swimming, walking, fitness trail."
    ],
    "it": [
      "Il villaggio di Chanteuges: abbazia del XII secolo modificata nel XV secolo, capitelli romanici, stalli. Cappella di Sainte-Anne del XV secolo, nota come Cappella dell'Abate. Resti del chiostro. Vari piccoli siti del patrimonio. La Gravière: nuoto, passeggiate, percorso fitness."
    ],
    "fr": [
      "Le village de Chanteuges : Abbaye du XIIe siècle remaniée au XVe siècle, chapiteaux romans, stalles. Chapelle Sainte-Anne, dite de l’Abbé, du XVe siècle. Vestiges du cloître. Petit patrimoine divers. La Gravière : baignade, promenade, parcours de santé."
    ],
    "nl": [
      "Het dorp Chanteuges: 12e-eeuwse abdij gewijzigd in de 15e eeuw, Romaanse kapitelen, koorstoelen. 15e-eeuwse kapel van Sainte-Anne, bekend als de kapel van de abt. Overblijfselen van het klooster. Verschillende kleine erfgoedsites. La Gravière: zwemmen, wandelingen, fitness parcours."
    ],
    "es": [
      "El pueblo de Chanteuges: abadía del siglo XII modificada en el siglo XV, capiteles románicos, sillería. Capilla Sainte-Anne del siglo XV, llamada Capilla del Abad. Restos del claustro. Varios pequeños lugares patrimoniales. La Gravière: baño, paseos, pista de fitness."
    ]
  },
