  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/59678292-58c6-3f13-b59f-82a585a2c00d",
      "dc:description": {
        "de": [
          "Informationen :\n\nÖffnungstage:\n\nMontags von 8:00 bis 13:00 Uhr und von 14:00 bis 19:00 Uhr.\nDienstag bis Freitag von 7:30 bis 13:00 Uhr und von 14:00 bis 19:00 Uhr.\nSamstags von 7:30 bis 13:00 Uhr und von 14:00 bis 18:00 Uhr.\nSonntags und an Feiertagen geschlossen.\n\nBestellungen:\nBestellungen können nur telefonisch unter der Nummer 03 21 47 35 75 getätigt werden.\nSie können Ihre Bestellung während der Öffnungszeiten des Geschäfts abholen.\n\n "
        ],
        "en": [
          "Information :\n\nOpening days:\n\nMonday, 8am to 1pm and 2pm to 7pm.\nTuesday to Friday, 7.30am to 1pm and 2pm to 7pm.\nSaturday 7.30am to 1pm and 2pm to 6pm.\nClosed on Sundays and public holidays.\n\nOrdering :\nOrders can only be placed by telephone on 03 21 47 35 75.\nYou can pick up your order during store opening hours.\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura:\n\nLunedì dalle 8.00 alle 13.00 e dalle 14.00 alle 19.00.\nDa martedì a venerdì dalle 7.30 alle 13.00 e dalle 14.00 alle 19.00.\nSabato dalle 7.30 alle 13.00 e dalle 14.00 alle 18.00.\nChiuso la domenica e i giorni festivi.\n\nOrdini:\nLe ordinazioni possono essere effettuate solo per telefono al numero 03 21 47 35 75.\nÈ possibile ritirare l'ordine durante gli orari di apertura del negozio.\n\n "
        ],
        "fr": [
          "Informations : \n\nJours d'ouverture: \n\nLe lundi de 8h à 13h et de 14h à 19h.\nDu mardi au vendredi de 7h30 à 13h et de 14h à 19h.\nLe samedi de 7h30 à 13h et de 14h à 18h.\nFermeture le dimanche et les jours fériés.\n\nCommandes :\nLes commandes se font uniquement par téléphone au 03 21 47 35 75.\nVous pouvez venir retirer votre commande aux horaires d'ouverture du magasin.\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen:\n\nMaandag van 8.00 tot 13.00 uur en van 14.00 tot 19.00 uur.\nDinsdag t/m vrijdag van 7.30 tot 13.00 en van 14.00 tot 19.00.\nZaterdag van 7.30 tot 13.00 en van 14.00 tot 18.00.\nGesloten op zon- en feestdagen.\n\nBestellen:\nBestellingen kunnen alleen telefonisch worden doorgegeven op 03 21 47 35 75.\nJe kunt je bestelling afhalen tijdens de openingsuren van de winkel.\n\n "
        ],
        "es": [
          "Más información :\n\nDías de apertura:\n\nLunes de 8h a 13h y de 14h a 19h.\nDe martes a viernes de 7h30 a 13h00 y de 14h00 a 19h00.\nSábados de 7.30 a 13.00 y de 14.00 a 18.00 horas.\nDomingos y festivos cerrado.\n\nPedidos:\nLos pedidos sólo pueden realizarse por teléfono llamando al 03 21 47 35 75.\nPuede recoger su pedido durante el horario de apertura de la tienda.\n\n "
        ]
      },
