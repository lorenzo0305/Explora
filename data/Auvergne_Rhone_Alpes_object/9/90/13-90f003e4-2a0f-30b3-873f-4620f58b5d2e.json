  "rdfs:comment": {
    "de": [
      "Am Fuße der alpinen Skipisten und in der Nähe der Auberge Du Praz gibt es eine sichere und kostenlose Rodelbahn für Kinder und Erwachsene."
    ],
    "en": [
      "At the foot of the downhill slopes and close to the Auberge Du Praz, a free, secure toboggan run is available for children and adults."
    ],
    "it": [
      "Ai piedi delle piste da discesa e vicino all'Auberge Du Praz, è disponibile una pista da slittino sicura e gratuita per bambini e adulti."
    ],
    "fr": [
      "Au pied des pistes de ski alpin et à proximité de l'Auberge Du Praz, une piste de luge sécurisée et gratuite est mise à disposition pour les enfants et les plus grands."
    ],
    "es": [
      "Al pie de las pistas de descenso y cerca del Auberge Du Praz, hay una pista de trineo segura y gratuita para niños y adultos."
    ],
    "nl": [
      "Aan de voet van de afdaling en vlakbij Auberge Du Praz is een gratis, beveiligde rodelbaan beschikbaar voor kinderen en volwassenen."
    ]
  },
