  "rdfs:comment": {
    "de": [
      "Ideal am Dorfplatz von Vertrieu gelegen, lädt das Restaurant-Bar „Les Platanes“ dazu ein, ein täglich wechselndes Menü vor Ort oder zum Mitnehmen sowie jeden Donnerstag ein Themenmenü zu genießen. Die schattige Terrasse, der Gastraum und die Veranda bieten einen warmen, geselligen und authentischen Rahmen."
    ],
    "en": [
      "Located on the village square of Vertrieu, the restaurant-bar \"Les Platanes\" offers a daily set menu to enjoy on-site or take away, and a themed menu every Thursday. The shaded terrace, dining room, and veranda provide a friendly and authentic setting."
    ],
    "it": [
      "Situato sulla piazza del paese di Vertrieu, il ristorante-bar \"Les Platanes\" offre un menu da asporto giornaliero e un menu a tema ogni giovedì. La terrazza ombreggiata, la sala da pranzo e la veranda offrono un ambiente accogliente e autentico."
    ],
    "fr": [
      "Situé sur la place du village de Vertrieu, le restaurant-bar \"Les Platanes\" propose une formule du jour à emporter ou sur place et un menu thématique chaque jeudi. La terrasse ombragée, salle et véranda offrent un cadre convivial et authentique."
    ],
    "es": [
      "Situado en la plaza del pueblo de Vertrieu, el restaurante-bar \"Les Platanes\" ofrece un menú diario para llevar y un menú temático todos los jueves. La terraza a la sombra, el comedor y el porche ofrecen un ambiente acogedor y auténtico."
    ],
    "nl": [
      "Het restaurant-bar \"Les Platanes\" ligt op het dorpsplein in Vertrieu en biedt een dagelijks afhaalmenu en elke donderdag een themamenu. Het schaduwrijke terras, de eetzaal en de veranda bieden een gezellige, authentieke omgeving."
    ]
  },
