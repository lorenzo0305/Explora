  "rdfs:comment": {
    "de": [
      "Da oben ist alles schöner! Großes Weiß im Winter, großes Grün im Sommer... Das Bergrestaurant La Porte des Aravis, besser bekannt als Chez Bruno, bietet einen herrlichen Panoramablick auf den Mont-Blanc."
    ],
    "en": [
      "Everything's better up there! Great white in winter, great green in summer... The high-altitude restaurant La Porte des Aravis, better known as Chez Bruno, offers a superb panoramic view on the Mont Blanc."
    ],
    "it": [
      "Tutto è più bello lassù! Grande bianco in inverno, grande verde in estate? Il ristorante d'alta quota La Porte des Aravis, meglio conosciuto come Chez Bruno, offre una superba vista panoramica sul Monte Bianco."
    ],
    "fr": [
      "Tout est plus beau là-haut ! Grand blanc l’hiver, grand vert l’été… Le restaurant d’altitude la Porte des Aravis, plus connu sous le nom de Chez Bruno, offre une superbe vue panoramique sur le Mont-Blanc."
    ],
    "es": [
      "Todo es más bonito allí arriba ¿Gran blanco en invierno, gran verde en verano? El restaurante de altura La Porte des Aravis, más conocido como Chez Bruno, ofrece una magnífica vista panorámica del Mont Blanc."
    ],
    "nl": [
      "Alles is beter daarboven! Groot wit in de winter, groot groen in de zomer... Het restaurant La Porte des Aravis, beter bekend als Chez Bruno, biedt een prachtig panoramisch uitzicht over de Mont Blanc."
    ]
  },
