  "rdfs:comment": {
    "de": [
      "Anfänger oder schnelle Fortschritte in aller Sicherheit mit einem staatlich geprüften Lehrer, nur auf Skiern. Möglichkeit von Ausflügen mit familiärem oder sportlichem Charakter auf den Varianten abseits der Pisten des Skigebiets."
    ],
    "en": [
      "Start or progress quickly and safely with a state-qualified instructor, on skis only. Possibility of family or sporting outings on the off-piste variants of the ski area."
    ],
    "it": [
      "Iniziare o progredire rapidamente in tutta sicurezza con un istruttore certificato dallo Stato, solo con gli sci. Possibilità di uscite in famiglia o sportive sulle varianti fuori pista del comprensorio."
    ],
    "fr": [
      "Débuter ou progresser rapidement en toute sécurité avec un moniteur diplômé d'état, uniquement à ski. Possibilité de sorties à caractère familiale ou sportif sur les variantes hors-pistes du domaine."
    ],
    "nl": [
      "Start of boek snel vooruitgang in alle veiligheid met een door de staat gecertificeerde instructeur, alleen op ski's. Mogelijkheid voor gezinsuitstapjes of sportieve uitstapjes op de off-piste varianten van het skigebied."
    ],
    "es": [
      "Iniciarse o progresar rápidamente con total seguridad con un monitor diplomado, sólo con esquís. Posibilidad de salidas familiares o deportivas en las variantes fuera de pista de la estación."
    ]
  },
  "rdfs:label": {
    "en": [
