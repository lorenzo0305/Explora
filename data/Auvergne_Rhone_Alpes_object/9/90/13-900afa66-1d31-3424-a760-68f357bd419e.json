  "rdfs:comment": {
    "de": [
      "Wir sind seit vier Generationen Winzer auf dem Weingut Chignard und bearbeiten die berühmten Terroirs von Fleurie, der führenden Appellation der Region Süd-Burgund / Beaujolais. Wir begrüßen Sie auf dem Weingut, um unsere Cuvées zu verkosten."
    ],
    "en": [
      "Wine growers since four generations, we welcome you in the estate to taste our two vintages."
    ],
    "it": [
      "Viticoltori da quattro generazioni nella tenuta Chignard, lavoriamo i rinomati terroir di Fleurie, la denominazione di punta della regione meridionale della Borgogna/Beaujolais. Vi diamo il benvenuto nella tenuta per degustare i nostri vini."
    ],
    "fr": [
      "Vignerons depuis quatre générations sur le domaine Chignard, nous travaillons des terroirs réputés de Fleurie, appellation phare de la région sud-Bourgogne / Beaujolais. Nous vous accueillons au domaine pour déguster nos cuvées."
    ],
    "es": [
      "Viticultores desde hace cuatro generaciones en la finca Chignard, trabajamos los renombrados terruños de Fleurie, la denominación emblemática del sur de Borgoña / Beaujolais. Le damos la bienvenida a la finca para que pruebe nuestros vinos."
    ],
    "nl": [
      "Al vier generaties lang zijn wij wijnbouwers op het landgoed Chignard. Wij bewerken de beroemde terroirs van Fleurie, de vlaggenschip-appellation van de zuidelijke Bourgogne / Beaujolais-streek. Wij heten u welkom op het landgoed om onze wijnen te proeven."
    ]
  },
  "rdfs:label": {
