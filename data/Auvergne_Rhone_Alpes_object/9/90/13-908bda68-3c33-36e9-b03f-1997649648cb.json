  "rdfs:comment": {
    "de": [
      "Erzählter Spaziergang und Kulturerbe. Montag bis Freitag von 9:00 bis 12:30 Uhr im Juli und August. Jeden Tag eine andere Wanderung (2 bis 4 km). Auf Anfrage das ganze Jahr über."
    ],
    "en": [
      "Storytelling and heritage walks. Monday to Friday, 9 a.m. to 12:30 p.m. in July and August. A different walk every day (2 to 4 km). On request all year round."
    ],
    "it": [
      "Racconto di storie e passeggiate sul patrimonio. Dal lunedì al venerdì, dalle 9.00 alle 12.30 in luglio e agosto. Ogni giorno una passeggiata diversa (da 2 a 4 km). Su richiesta tutto l'anno."
    ],
    "fr": [
      "Balade contée et patrimoine. Du lundi au vendredi de 9 h à 12 h 30 en juillet et août. Chaque jour une balade différente (2 à 4 km). Sur demande toute l'année."
    ],
    "nl": [
      "Verhalen vertellen en erfgoedwandelingen. Maandag t/m vrijdag van 9.00 tot 12.30 uur in juli en augustus. Elke dag een andere wandeling (2 tot 4 km). Op aanvraag het hele jaar door."
    ],
    "es": [
      "Cuentacuentos y paseos por el patrimonio. De lunes a viernes, de 9.00 a 12.30 h en julio y agosto. Un paseo diferente cada día (de 2 a 4 km). A petición todo el año."
    ]
  },
