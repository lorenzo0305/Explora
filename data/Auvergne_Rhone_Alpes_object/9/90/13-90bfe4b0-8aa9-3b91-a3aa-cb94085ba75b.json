  "rdfs:comment": {
    "de": [
      "Am Anfang des 11 km langen Radwegs von Aime nach Bourg Saint Maurice (Hin- und Rückfahrt 22 km), am Ufer des Flusses Isère, entdecken Sie bei AN Rafting einen Fahrradverleih: Es gibt Fahrräder für Groß und Klein."
    ],
    "en": [
      "At the start of the 11 km cycle path from Aime to Bourg Saint Maurice (22 km there and back), on the banks of the river Isère, you will find a bike rental service at AN Rafting with bikes for cyclists of all ages."
    ],
    "it": [
      "All'inizio della pista ciclabile di 11 km che collega Aime a Bourg Saint Maurice (andata e ritorno 22 km), sulle rive del fiume Isère, scoprite il servizio di noleggio biciclette di AN Rafting: ce ne sono per grandi e piccini."
    ],
    "fr": [
      "Au départ de la piste cyclable de 11 km reliant Aime à Bourg Saint Maurice (A/R 22 km), au bord de la rivière de l'Isère, découvrez un service de location de vélos chez AN Rafting : il y a des vélos pour les petits et les grands."
    ],
    "nl": [
      "Ontdek aan het begin van het 11 km lange fietspad dat Aime met Bourg Saint Maurice verbindt (heen en terug 22 km), aan de oever van de Isère, de fietsverhuur van AN Rafting: er zijn fietsen voor groot en klein."
    ],
    "es": [
      "Al comienzo del carril bici de 11 km que une Aime con Bourg Saint Maurice (ida y vuelta 22 km), a orillas del río Isère, descubra el servicio de alquiler de bicicletas de AN Rafting: hay bicicletas para grandes y pequeños."
    ]
  },
  "rdfs:label": {
    "de": [
      "Fahrradverleih - An Rafting"
    ],
