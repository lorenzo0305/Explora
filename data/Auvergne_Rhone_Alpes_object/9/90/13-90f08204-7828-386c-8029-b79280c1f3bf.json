  "rdfs:comment": {
    "de": [
      "Das ideal im Herzen von Le Puy-en-Velay gelegene Le Régina bietet Ihnen einen privilegierten Zugang zu den emblematischen historischen Stätten und befindet sich in unmittelbarer Nähe des Bahnhofs."
    ],
    "en": [
      "Ideally located in the heart of Le Puy-en-Velay, Le Régina offers privileged access to emblematic historic sites and is right next to the train station."
    ],
    "it": [
      "Situato in posizione ideale nel cuore di Le Puy-en-Velay, Le Régina offre un accesso privilegiato a siti storici emblematici e si trova proprio accanto alla stazione ferroviaria."
    ],
    "fr": [
      "Idéalement situé en plein cœur du Puy-en-Velay, Le Régina vous offre un accès privilégié aux sites historiques emblématiques et se trouve à proximité immédiate de la gare."
    ],
    "nl": [
      "Le Régina is ideaal gelegen in het hart van Le Puy-en-Velay en biedt een bevoorrechte toegang tot emblematische historische bezienswaardigheden en ligt vlak naast het treinstation."
    ],
    "es": [
      "Idealmente situado en el corazón de Le Puy-en-Velay, Le Régina ofrece un acceso privilegiado a lugares históricos emblemáticos y está justo al lado de la estación de tren."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Régina Séminaires & Réceptions"
    ]
  },
