  "rdfs:comment": {
    "de": [
      "In einem schicken und trendigen Dekor ist das Comptoir du Croque der Spezialist für Croque Monsieur mit einer originellen Speisekarte, die vom Bougnat über den italienischen bis hin zum Croque à la Comtesse de Vichy reicht."
    ],
    "en": [
      "In a chic and trendy decor, the Comptoir du Croque is the specialist in croque-monsieur, with an original menu, from bougnat to Italian and Comtesse de Vichy."
    ],
    "it": [
      "In un ambiente chic e di tendenza, il Comptoir du Croque è lo specialista del croque-monsieur, con un menu originale, dal bougnat all'italiano e alla Comtesse de Vichy."
    ],
    "fr": [
      "Dans un décor chic et branché, le Comptoir du Croque est le spécialiste de croque-monsieur, avec une carte originale, depuis le bougnat, en passant par l'italien et celui à la Comtesse de Vichy."
    ],
    "nl": [
      "In een chic en trendy kader is de Comptoir du Croque de croque-monsieur specialist, met een originele kaart, van de bougnat tot de Italiaanse en de Comtesse de Vichy."
    ],
    "es": [
      "En un entorno elegante y de moda, el Comptoir du Croque es el especialista en croque-monsieur, con una carta original, desde el bougnat hasta el italiano y el Comtesse de Vichy."
    ]
  },
  "rdfs:label": {
