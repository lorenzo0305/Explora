  "rdfs:comment": {
    "de": [
      "Der 26 Hektar große Park liegt auf 486 m Höhe in einem städtebaulichen Schutzgebiet und bietet einen privilegierten Blick auf die Stadt und ihre Umgebung."
    ],
    "en": [
      "Situated at an altitude of 486 m, in a protected urban zone, this 26-hectare park offers a privileged view of the city and its region."
    ],
