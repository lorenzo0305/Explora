  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/74f7b543-312b-3a68-9e9c-c9cc2147d93a",
      "dc:description": {
        "de": [
          "Mikro-Kindertagesstätte.\nKinderbetreuung für Kinder von 2 Monaten bis 3 Jahren.\n\n7.00 Uhr / 19.00 Uhr\n\n\n4 Wochen im Sommer und 1 Woche an Weihnachten geschlossen."
        ],
        "en": [
          "Micro-Crèche.\nChildcare from 2 months to 3 years.\n\n7am / 7pm\n\n\nClosed 4 weeks in summer and 1 week at Christmas."
        ],
        "it": [
          "Micro-nido.\nAssistenza ai bambini dai 2 mesi ai 3 anni.\n\n7.00 / 19.00\n\n\nChiuso 4 settimane in estate e 1 settimana a Natale."
        ],
        "fr": [
          "Micro-Crèche.\nGarde d'enfants de 2 mois à 3 ans.\n\n7h00 / 19h00\n\n\nFermeture 4 semaines l'été et 1 semaine a Noël."
        ],
        "es": [
          "Micro-guardería.\nGuardería para niños de 2 meses a 3 años.\n\n7h / 19h\n\n\nCerrado 4 semanas en verano y 1 semana en Navidad."
        ],
        "nl": [
          "Micro-Crèche.\nKinderopvang voor kinderen van 2 maanden tot 3 jaar.\n\n7 uur 's ochtends / 7 uur 's avonds\n\n\nGesloten 4 weken in de zomer en 1 week met Kerstmis."
        ]
      },
