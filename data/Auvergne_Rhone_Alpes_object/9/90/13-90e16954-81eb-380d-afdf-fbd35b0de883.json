  "rdfs:comment": {
    "de": [
      "Dorf Saint-Cirgues: Türme und Überreste des ehemaligen Schlosses der Mercoeur. Kirche aus dem 13. Jahrhundert mit Wandmalereien aus dem 14. und 15. Jahrhundert. Achteckiger Glockenturm."
    ],
    "en": [
      "Village of Saint-Cirgues: Towers and remains of the former Mercoeur château. 13th-century church with 14th- and 15th-century murals. Octagonal bell tower."
    ],
    "it": [
      "Villaggio di Saint-Cirgues: torri e resti dell'antico castello di Mercoeur. Chiesa del XIII secolo con dipinti murali del XIV e XV secolo. Campanile ottagonale."
    ],
    "fr": [
      "Village de Saint-Cirgues : Tours et vestiges de l’ancien château des Mercoeur. Église du XIIIe siècle avec peintures murales des XIVe et XVe siècles. Clocher octogonal."
    ],
    "es": [
      "Pueblo de Saint-Cirgues: torres y restos del antiguo castillo de Mercoeur. Iglesia del siglo XIII con pinturas murales de los siglos XIV y XV. Campanario octogonal."
    ],
    "nl": [
      "Dorp Saint-Cirgues: torens en overblijfselen van het voormalige kasteel Mercoeur. Kerk uit de 13e eeuw met muurschilderingen uit de 14e en 15e eeuw. Achthoekige klokkentoren."
    ]
  },
  "rdfs:label": {
