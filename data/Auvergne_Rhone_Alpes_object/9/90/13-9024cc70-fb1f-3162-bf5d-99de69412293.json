  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Auvergne durch die Vielfalt ihrer Weiß-, Rosé- und Rotweine und genießen Sie großzügige und unterschiedliche Weine.\r\nBesuchen Sie die Weinkellerei Saint-Verny Vignobles und entdecken Sie ihre Côtes d'Auvergne-Weine."
    ],
    "en": [
      "Discover Auvergne through the diversity of its white, rosé and red wines and enjoy generous and different wines.\r\nVisit the Saint-Verny wineries and discover their Côtes d'Auvergne wines."
    ],
    "it": [
      "Scoprite l'Alvernia attraverso la diversità dei suoi vini bianchi, rosati e rossi e assaporate vini generosi e diversi.\r\nVisitate le cantine di Saint-Verny Vignobles e scoprite i loro vini Côtes d'Auvergne."
    ],
    "fr": [
      "Découvrez l'Auvergne à travers la diversité de ses vins blancs, rosés et rouges et appréciez des vins généreux et différents.\r\nVisitez les caves Saint-Verny Vignobles et découvrez leurs vins Côtes d'Auvergne."
    ],
    "nl": [
      "Ontdek de Auvergne door de diversiteit van zijn witte, rosé en rode wijnen en geniet van gulle en verschillende wijnen.\r\nBezoek de kelders van Saint-Verny Vignobles en ontdek hun Côtes d'Auvergne wijnen."
    ],
    "es": [
      "Descubra la Auvernia a través de la diversidad de sus vinos blancos, rosados y tintos y disfrute de vinos generosos y diferentes.\r\nVisite las bodegas de Saint-Verny Vignobles y descubra sus vinos Côtes d'Auvergne."
    ]
  },
  "rdfs:label": {
    "en": [
      "Desprat - Saint-Verny vineyards"
    ],
    "fr": [
      "Desprat - Saint-Verny vignobles"
    ]
  },
