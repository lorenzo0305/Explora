  "rdfs:comment": {
    "de": [
      "An der Stelle von Soyons wurde bereits Ende des 19. Jahrhunderts ein außergewöhnliches Ensemble von Höhlen entdeckt. Derzeit sind zwei prähistorische Höhlen und Konkretionshöhlen für die Öffentlichkeit zugänglich."
    ],
    "en": [
      "On the Soyons site, an exceptional group of caves was discovered in the late 19th century. Today, two prehistoric and concretion caves are open to the public."
    ],
    "it": [
      "Sul sito di Soyons, alla fine del XIX secolo è stato scoperto un eccezionale gruppo di grotte. Attualmente sono aperte al pubblico due grotte preistoriche e di concrezione."
    ],
    "fr": [
      "Sur le site de Soyons, un ensemble exceptionnel de cavités a été découvert dès la fin du XIXe siècle. Actuellement deux grottes préhistoriques et à concrétions sont ouvertes au public."
    ],
    "nl": [
      "Het gebied rondom Soyons getuigt van 150.000 geschiedenis met de verschillende fasen in de ontwikkeling van de mens. Tijdens de rondleiding in de grotten en het museum wordt u meegenomen in de fascinerende  wereld van de préhistorie en de geschiedenis."
    ],
    "es": [
      "En el emplazamiento de Soyons se descubrió a finales del siglo XIX un excepcional conjunto de cuevas. Actualmente, dos cuevas prehistóricas y de concreción están abiertas al público."
    ]
  },
