  "rdfs:comment": {
    "de": [
      "La Trame 26 (Die) richtet sich an die am stärksten ausgegrenzten Menschen und bietet Unterkunft, solidarische Aktivitäten und eine auf ihre Bedürfnisse zugeschnittene administrative und soziale Betreuung."
    ],
    "en": [
      "La Trame 26 (Die) is aimed at the most excluded people and offers accommodation, solidarity activities and administrative and social support tailored to their needs."
    ],
    "it": [
      "La Trame 26 (Die) si rivolge alle persone più escluse e offre alloggio, attività comunitarie e supporto amministrativo e sociale su misura per le loro esigenze."
    ],
    "fr": [
      "La Trame 26 (Die) s’adresse aux personnes les plus exclues et propose un hébergement, des activités solidaires et un accompagnement administratif et social adapté à leurs besoins."
    ],
    "es": [
      "La Trame 26 (Die) se dirige a las personas más excluidas y ofrece alojamiento, actividades comunitarias y apoyo administrativo y social adaptado a sus necesidades."
    ],
    "nl": [
      "La Trame 26 (Die) richt zich op de meest uitgesloten mensen en biedt huisvesting, sociale activiteiten en administratieve en sociale ondersteuning op maat."
    ]
  },
