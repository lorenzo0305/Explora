  "rdfs:comment": {
    "de": [
      "Ein Team-Abenteuer, das von den beliebtesten TV-Herausforderungen inspiriert wurde! Die Spieler müssen zusammenarbeiten, um 27 Zellen zu lösen: Denken, Beweglichkeit und Strategie."
    ],
    "en": [
      "A team adventure inspired by the most popular TV challenges! Players must work together to solve 27 cells: thinking, agility and strategy."
    ],
    "it": [
      "Un'avventura a squadre ispirata alle più popolari sfide televisive! I giocatori devono collaborare per risolvere 27 celle: pensiero, agilità e strategia."
    ],
    "fr": [
      "Une aventure en équipe inspirée des défis télévisés les plus populaire ! Les joueurs doivent travailler ensemble pour résoudre 27 cellules : réflexion, agilité et stratégie."
    ],
    "es": [
      "¡Una aventura en equipo inspirada en los retos televisivos más populares! Los jugadores deben trabajar juntos para resolver 27 celdas: pensamiento, agilidad y estrategia."
    ],
    "nl": [
      "Een teamavontuur geïnspireerd op de populairste tv-uitdagingen! Spelers moeten samenwerken om 27 cellen op te lossen: denkvermogen, behendigheid en strategie."
    ]
