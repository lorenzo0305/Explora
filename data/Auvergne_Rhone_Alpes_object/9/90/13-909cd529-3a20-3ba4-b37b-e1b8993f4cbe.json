  "rdfs:comment": {
    "de": [
      "Das Restaurant des Hotels Eliova l'Eau Vive*** liegt 100 m von den Linga-Skiliften entfernt und bietet Ihnen eine traditionelle Küche (Tagesmenü) sowie eine Karte mit regionalen Spezialitäten."
    ],
    "en": [
      "Located at 100m from the Linga ski lifts, the restaurant of the hotel Eliova L'Eau Vive*** offers traditional menu (daily menu) and local specialities."
    ],
    "it": [
      "A soli 100 metri dagli impianti di risalita di Linga, il ristorante dell'hotel Eliova l'Eau Vive*** propone una cucina tradizionale (menù del giorno) e un menù di specialità regionali."
    ],
    "fr": [
      "A 100m des remontées mécaniques du Linga, le restaurant de l'hôtel Eliova l'Eau Vive*** vous propose une cuisine traditionnelle (menu du jour) ainsi qu'une carte de spécialités régionales."
    ],
    "nl": [
      "Op slechts 100 meter van de Linga skiliften biedt het restaurant van hotel Eliova l'Eau Vive*** een traditionele keuken (dagmenu) en een menu met regionale specialiteiten."
    ],
    "es": [
      "A 100 m de los remontes de Linga, el restaurante del hotel Eliova l'Eau Vive*** sirve cocina tradicional (menú del día), así como una carta de especialidades regionales."
    ]
  },
