  "rdfs:comment": {
    "de": [
      "Der Pflege- und Entspannungsbereich des Vertigo Spa ist ein Schmuckkästchen des Wohlbefindens und der Sanftheit, wo Innovation und individuelle Pflege Emotionen und Sinnlichkeit verbreiten."
    ],
    "en": [
      "The Vertigo Spa treatment and relaxation area is a haven of well-being and softness, where innovative and personalized treatments radiate emotion and sensoriality."
    ],
    "it": [
      "L'area trattamenti e relax della Vertigo Spa è un'oasi di benessere e indulgenza, dove trattamenti innovativi e personalizzati emanano emozioni e sensualità."
    ],
    "fr": [
      "L'Espace de soin et de détente du Vertigo Spa est un écrin de bien-être et de douceur, où innovation et personnalisation des soins diffusent émotion et sensorialité."
    ],
    "es": [
      "La zona de tratamientos y relajación Vertigo Spa es un remanso de bienestar e indulgencia, donde los tratamientos innovadores y personalizados irradian emoción y sensualidad."
    ],
    "nl": [
      "De behandel- en ontspanningsruimte van de Vertigo Spa is een oase van welzijn en verwennerij, waar innovatieve en gepersonaliseerde behandelingen emotie en sensualiteit uitstralen."
    ]
  },
