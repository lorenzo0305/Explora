  "rdfs:comment": {
    "de": [
      "Die Dichterin Awicha Agoulmine empfängt Sie zu einem poetischen Schreibworkshop im Rahmen des Printemps des poètes 2026, dessen Themen \"Liberté, force vive déployée\" & \"Le printemps\" lauten. Freier Workshop, für jedes Publikum."
    ],
    "en": [
      "Poet Awicha Agoulmine welcomes you to a poetry-writing workshop as part of the Printemps des poètes 2026 festival, whose themes are \"Liberté, force vive déployée\" & \"Le printemps\". Free workshop, open to all."
    ],
    "it": [
      "Il poeta Awicha Agoulmine vi invita a partecipare a un laboratorio di scrittura poetica nell'ambito del festival Printemps des poètes 2026, i cui temi sono \"Libertà, forza viva dispiegata\" e \"Primavera\".\r\nLaboratorio gratuito, aperto a tutti."
    ],
    "fr": [
      "La poétesse Awicha Agoulmine vous accueille pour un atelier d'écriture poétique dans le cadre du Printemps des poètes 2026 dont les thèmes sont \"Liberté, force vive déployée\" & \"Le printemps\". \r\nAtelier libre, tout public."
    ],
    "es": [
      "La poetisa Awicha Agoulmine le da la bienvenida a un taller de escritura poética en el marco del festival Printemps des poètes 2026, cuyos temas son \"La libertad, la fuerza viva desplegada\" y \"La primavera\".\r\nTaller gratuito y abierto a todos."
    ],
    "nl": [
      "Dichter Awicha Agoulmine verwelkomt je op een workshop poëzie schrijven in het kader van het Printemps des poètes 2026 festival, met als thema's \"Vrijheid, de levende kracht ingezet\" & \"Lente\".\r\nGratis workshop, open voor iedereen."
    ]
  },
