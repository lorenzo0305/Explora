  "rdfs:comment": {
    "de": [
      "Sie haben Lust, Schlittschuh zu laufen? Ihre Eltern oder Kinder zu beeindrucken ... dann zögern Sie nicht länger! Kommen Sie und genießen Sie die Eisbahn :-)"
    ],
    "en": [
      "If you want to go skating and amaze your parents, or your children, don't hesitate any longer! Come and have fun at the skating rink :)"
    ],
    "it": [
      "Volete pattinare? Per impressionare i vostri genitori, i vostri figli? Allora non esitate più! Venite a godervi la pista di ghiaccio :-)"
    ],
    "fr": [
      "Vous avez envie de patiner ? d'épater vos parents, vos enfants … alors n'hésitez plus ! Venez profiter de la patinoire :-)"
    ],
    "es": [
      "¿Quieres patinar? para impresionar a tus padres, a tus hijos... ¡entonces no lo dudes más! Venga a disfrutar de la pista de hielo :-)"
    ],
    "nl": [
      "Heeft U zin in schaatsen?  zin in indruk maken op uw ouders, uw kinderen...\r\nAarzel dan niet!  Kom van de schaatsbaan genieten -)"
    ]
  },
