  "rdfs:comment": {
    "de": [
      "Nicht therapeutische Wohlfühlmassage.\r\nGenießen Sie bei mir oder bei Ihnen zu Hause (20 km um Montverdun) einen Moment der Massage außerhalb des Alltags, die Zeit einer besonderen Pflege für Ihren Körper und Ihren Geist."
    ],
    "en": [
      "Non-therapeutic wellness massage.\r\nEnjoy a moment of massage away from your daily routine, at my home or at yours (20 km around Montverdun), for a special treatment for your body and mind."
    ],
    "it": [
      "Massaggio benessere non terapeutico.\r\nGodetevi un momento di massaggio lontano dalla vita quotidiana, a casa mia o a casa vostra (a 20 km da Montverdun), per un trattamento speciale per il vostro corpo e la vostra mente."
    ],
    "fr": [
      "Massage de bien être non thérapeutique.\r\nProfitez chez moi ou à votre domicile (20 km autour de Montverdun) d'un moment de massage hors du quotidien, le temps d'un soin privilégié pour votre corps et votre esprit."
    ],
    "nl": [
      "Niet-therapeutische welzijnsmassage.\r\nGeniet van een massagemoment weg van het dagelijkse leven, bij mij thuis of bij jou (20 km rond Montverdun), voor een speciale behandeling voor je lichaam en geest."
    ],
    "es": [
      "Masaje de bienestar no terapéutico.\r\nDisfrute de un momento de masaje lejos de la vida cotidiana, en mi casa o en la suya (20 km alrededor de Montverdun), para un tratamiento especial para su cuerpo y su mente."
    ]
  },
