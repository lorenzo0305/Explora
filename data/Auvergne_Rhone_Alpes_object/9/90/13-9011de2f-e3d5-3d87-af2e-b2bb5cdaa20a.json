  "rdfs:comment": {
    "de": [
      "Foodtruck, der sich speziell den salzigen und süßen Croque Monsieurs mit frischen und lokalen Produkten widmet. Eine Vielzahl von Croques je nach Jahreszeit, um mit gesunden und schmackhaften Produkten zu schlemmen."
    ],
    "en": [
      "Foodtruck specially dedicated to sweet and savory croque monsieur made with fresh, local produce. A multitude of seasonal croques to fill your sweet tooth with healthy, tasty products."
    ],
    "it": [
      "Foodtruck dedicato ai croque monsieur dolci e salati con prodotti freschi e locali. Una moltitudine di croque stagionali per saziare la vostra voglia di dolce con prodotti sani e gustosi."
    ],
    "fr": [
      "Foodtruck spécialement dédié aux croque monsieur salés et sucrés avec des produits frais et locaux. Une multitude de croques suivant les saisons pour faire le plein de gourmandise avec des produits sains et savoureux."
    ],
    "nl": [
      "Foodtruck speciaal gewijd aan zoete en hartige croque monsieur met verse, lokale producten. Een veelheid aan seizoensgebonden croques om je zoetekauwen te vullen met gezonde, smakelijke producten."
    ],
    "es": [
      "Foodtruck especialmente dedicado al croque monsieur dulce y salado con productos frescos y locales. Una multitud de croques de temporada para llenar su paladar de dulces con productos sanos y sabrosos."
    ]
  },
