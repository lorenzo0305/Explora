  "rdfs:comment": {
    "de": [
      "Kommentierte Besichtigungen und Führungen von Pierre Ribeyre, der Ihnen die Geschichte des Wildlachses erzählt. Reservierung das ganze Jahr über für Gruppen und Schulklassen unter 06 63 49 59 55. Besichtigungen im Juli/August dienstags und donnerstags um 15 Uhr."
    ],
    "en": [
      "Guided tours with Pierre Ribeyre to tell the story of wild salmon. Reservations all year round for groups and schools: 06 63 49 59 55. Visits in July and August on Tuesdays and Thursdays at 3pm."
    ],
    "it": [
      "Visite guidate da Pierre Ribeyre, che vi racconterà la storia del salmone selvatico. Prenotazioni tutto l'anno per gruppi e scuole al numero 06 63 49 59 55. Visite in luglio e agosto il martedì e il giovedì alle 15.00."
    ],
    "fr": [
      "Visites commentées et guidées par Pierre Ribeyre pour vous conter l'histoire du saumon sauvage. Réservation toute l'année pour les groupes et les scolaires au 06 63 49 59 55. Visites juillet/août les mardis et jeudis à 15h."
    ],
    "es": [
      "Visitas guiadas por Pierre Ribeyre, que le contará la historia del salmón salvaje. Reservas todo el año para grupos y escuelas en el 06 63 49 59 55. Visitas en julio y agosto los martes y jueves a las 15:00 h."
    ],
    "nl": [
      "Rondleidingen door Pierre Ribeyre, die je alles vertelt over de geschiedenis van wilde zalm. Het hele jaar door te boeken voor groepen en scholen op 06 63 49 59 55. Bezoeken in juli en augustus op dinsdag en donderdag om 15.00 uur."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Conservatoire National du Saumon Sauvage"
    ]
  },
