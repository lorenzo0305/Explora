  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/6b475fd9-882b-3962-8a6c-5a2d028a0aac",
      "dc:description": {
        "de": [
          "Informationen :\n\nProdukte :\n\nIn Selbstbedienung werden Ihnen Saisongemüse und Eier von lokalen Produzenten angeboten.\n\nÖffnungstage:\n\n24 Stunden am Tag, 7 Tage die Woche.\n\n "
        ],
        "en": [
          "Information :\n\nProducts :\n\nSelf-service seasonal vegetables and eggs from local producers.\n\nOpening days:\n\nOpen 24/7.\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nProdotti :\n\nSelf-service di verdure di stagione e uova di produttori locali.\n\nGiorni di apertura:\n\nAperto 24 ore su 24, 7 giorni su 7.\n\n "
        ],
        "fr": [
          "Informations : \n\nProduits :\n\nEn libre service vous sont proposés des légumes de saison et des oeufs des producteurs locaux.\n\nJours d'ouverture: \n\nAccessible 24h/24 et 7 jours/7.\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nProducten :\n\nZelfbediening seizoensgroenten en eieren van lokale producenten.\n\nOpeningsdagen:\n\n24 uur per dag, 7 dagen per week geopend.\n\n "
        ],
        "es": [
          "Más información :\n\nProductos :\n\nAutoservicio de verduras de temporada y huevos de productores locales.\n\nDías de apertura:\n\nAbierto 24 horas al día, 7 días a la semana.\n\n "
        ]
      },
