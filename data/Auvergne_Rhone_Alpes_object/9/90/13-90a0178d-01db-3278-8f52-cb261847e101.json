  "rdfs:comment": {
    "de": [
      "Bar mit Weinen und Tapas.\r\nAm Fuße der romanischen Brücke nehmen Sie sich die Zeit, unsere Sonnenterrasse mit ihren schattigen Plätzen zu entdecken. Probieren Sie unsere Weine und provenzalischen Tapas, essen Sie ein Eis oder trinken Sie ein Glas an diesem magischen Ort am Flussufer."
    ],
    "en": [
      "Wine bar serving tapas.\r\nAt the foot of the Roman bridge, take time to discover our sunny terrace and shady spaces and taste our wines and Provençal tapas, eat some ice cream or just enjoy a glass of wine in this magical setting on the banks of the river."
    ],
    "it": [
      "Selezione di prodotti locali\r\nTerrazza bar"
    ],
    "fr": [
      "Sélection de produits locaux\r\nBar en terrasse"
    ],
    "nl": [
      "Wijn-tapasbar\r\nAan de voet van de Romaanse brug kunt u op ons zonnige terras met genoeg schaduwplekken onze wijnen en Provençaalse tapas proeven, een ijsje eten of gewoon een glaasje drinken op deze magische plek langs de rivier"
    ],
    "es": [
      "Selección de productos locales\r\nTerraza bar"
    ]
  },
