  "rdfs:comment": {
    "de": [
      "Die Auberge forestière du Mont Mouchet empfängt Sie zum Mittagessen, für ein Getränk, für eine \"Snackpause\"...\r\nAuf Anfrage können Sie auch abends essen | Hochzeiten, Taufen, Geburtstage auf Anfrage 15 Tage im Voraus.\r\nReservierung 06 29 71 36 48"
    ],
    "en": [
      "The Auberge forestière du Mont Mouchet welcomes you for lunch, a drink or a snack...\r\nEvening meals available on request | Weddings - christenings - birthdays on request 15 days in advance.\r\nReservations 06 29 71 36 48"
    ],
    "it": [
      "L'Auberge forestière du Mont Mouchet vi accoglie per un pranzo, un drink o uno spuntino...\r\nCene su richiesta | Matrimoni - battesimi - compleanni su richiesta con 15 giorni di anticipo.\r\nPrenotazione 06 29 71 36 48"
    ],
    "fr": [
      "L‘Auberge forestière du Mont Mouchet vous accueille pour déjeuner, pour boire un verre, pour une \"pause goûter\"...\r\nPossibilité de repas le soir sur demande | Mariage - baptême - anniversaire sur demande 15j à l'avance.\r\nRéservation 06 29 71 36 48"
    ],
    "es": [
      "El Auberge forestière du Mont Mouchet le recibe para almorzar, tomar una copa o un aperitivo...\r\nCenas a petición | Bodas - bautizos - cumpleaños a petición con 15 días de antelación.\r\nReservas 06 29 71 36 48"
    ],
    "nl": [
      "De Auberge forestière du Mont Mouchet heet u welkom voor de lunch, een drankje of een hapje...\r\nAvondmaaltijden op aanvraag beschikbaar | Bruiloften - doopfeesten - verjaardagen op aanvraag 15 dagen van tevoren.\r\nReservering 06 29 71 36 48"
    ]
  },
  "rdfs:label": {
