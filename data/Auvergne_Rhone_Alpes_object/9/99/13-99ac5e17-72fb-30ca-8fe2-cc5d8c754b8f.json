  "rdfs:comment": {
    "de": [
      "Die Apotheke in Bourg-en-Bresse besteht aus drei Räumen: einem intakt gebliebenen Labor, einem Hinterzimmer und einer Offizin, die mit wunderschönen Holzvertäfelungen im Stil von Louis XV ausgestattet ist und eine beeindruckende Sammlung von Fayencen und Flakons beherbergt."
    ],
    "en": [
      "The Bourg-en-Bresse apothecary consists of three rooms: an intact laboratory, a back store and a dispensary, with magnificent Louis XV woodwork housing an impressive collection of earthenware and flasks."
    ],
    "it": [
      "La spezieria di Bourg-en-Bresse è composta da tre stanze: un laboratorio rimasto intatto, un retrobottega e un dispensario, con una magnifica boiserie Luigi XV che ospita un'impressionante collezione di terrecotte e bottiglie."
    ],
    "fr": [
      "L'apothicairerie de Bourg-en-Bresse est composée de trois pièces : un laboratoire resté intact, une arrière-boutique et une officine, dotée de magnifiques boiseries Louis XV abritant une impressionnante collection de faïences et de flacons."
    ],
    "es": [
      "La botica de Bourg-en-Bresse consta de tres salas: un laboratorio que ha permanecido intacto, una trastienda y un dispensario, con una magnífica carpintería Luis XV que alberga una impresionante colección de loza y frascos."
    ],
    "nl": [
      "De apotheek van Bourg-en-Bresse bestaat uit drie zalen: een intact gebleven laboratorium, een achterkamer en een apotheek, met prachtig Louis XV houtwerk waarin een indrukwekkende collectie aardewerk en flessen is ondergebracht."
    ]
  },
