  "rdfs:comment": {
    "de": [
      "Das gefällt Ihnen: Biere, die lokale Helden wie Lafleur, Jules Verne oder Sehenswürdigkeiten wie die Kathedrale in den Mittelpunkt stellen Jedes schmeckt anders!"
    ],
    "en": [
      "You'll love the beers that feature local heroes: Lafleur, Jules Verne or monuments like the cathedral, each with a different taste!"
    ],
    "it": [
      "Vi piaceranno: le birre che mettono in risalto gli eroi locali: Lafleur, Jules Verne o monumenti come la cattedrale, ognuno con un gusto diverso!"
    ],
    "fr": [
      "Vous aimerez : les bières qui mettent en valeur des héros locaux : Lafleur, Jules Verne ou des monuments comme la cathédrale chacune au goût différent !"
    ],
    "nl": [
      "U zult het leuk vinden: bieren die lokale helden in de schijnwerpers zetten: Lafleur, Jules Verne of monumenten zoals de kathedraal, elk met een andere smaak!"
    ],
    "es": [
      "Le gustarán: las cervezas que destacan a los héroes locales: Lafleur, Julio Verne o monumentos como la catedral, ¡cada una con un sabor diferente!"
    ]
  },
