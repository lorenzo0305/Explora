  "rdfs:comment": {
    "de": [
      "Entdecken Sie einen schwindelerregenden Baumklettergarten!\r\nWillkommen inmitten der Natur, im Schatten, im kühlen Nass von zwei Gebirgsbächen. Klettern Sie bis zu den Wipfeln majestätischer Fichten und genießen Sie die Aussicht auf 1650 m Höhe."
    ],
    "en": [
      "Discover a vertiginous accrobranche!\r\nWelcome to the middle of nature, in the cool shade of two torrents. Climb to the top of majestic spruce trees and enjoy the view at 1650m altitude."
    ],
    "it": [
      "Scoprite una vertiginosa avventura di arrampicata sugli alberi!\r\nBenvenuti nel cuore della natura, all'ombra fresca di due torrenti. Salite in cima a maestosi abeti rossi e godetevi il panorama a 1650 m di altitudine."
    ],
    "fr": [
      "Découvrez un accrobranche vertigineux  !\r\nBienvenue au milieu de la nature, à l'ombre, dans la fraîcheur de deux torrents. Montez jusqu’à la cime de majestueux épicéas et profitez de la vue à 1650m d’altitude."
    ],
    "es": [
      "¡Descubra una vertiginosa aventura de escalada de árboles!\r\nBienvenido al corazón de la naturaleza, a la fresca sombra de dos torrentes. Suba a lo alto de majestuosos abetos y disfrute de las vistas a 1650 m de altitud."
    ],
    "nl": [
      "Ontdek een duizelingwekkend boomklimavontuur!\r\nWelkom in het hart van de natuur, in de koele schaduw van twee bergstromen. Klim naar de top van majestueuze sparren en geniet van het uitzicht op 1650m hoogte."
    ]
  },
  "rdfs:label": {
    "fr": [
