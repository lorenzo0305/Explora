  "rdfs:comment": {
    "de": [
      "\"Ich habe meine Eurydike verloren\"? Eine der erschütterndsten Melodien der Operngeschichte, ein Meisterwerk des Opernrepertoires, an dem kein Weg vorbeiführt."
    ],
    "en": [
      "\"I have lost my Eurydice? One of the most moving arias in all of opera, at the heart of an essential masterpiece of the operatic repertoire."
    ],
    "it": [
      "\"Ho perso la mia Euridice? Una delle arie più commoventi di tutta l'opera, al centro di un capolavoro che non può essere ignorato nel repertorio operistico."
    ],
    "fr": [
      "« J’ai perdu mon Eurydice »… L’un des airs les plus bouleversants de tout l’opéra, au cœur d’un chef-d'œuvre incontournable du répertoire lyrique."
    ],
    "nl": [
      "\"Ik ben mijn Eurydice kwijt? Een van de meest ontroerende aria's in de opera, in het hart van een meesterwerk dat niet meer weg te denken is uit het operarepertoire."
    ],
    "es": [
      "\"He perdido a mi Eurídice? Una de las arias más conmovedoras de toda la ópera, en el corazón de una obra maestra esencial del repertorio operístico."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Orphée et Eurydice - Christophe Willibald Gluck"
    ]
  },
