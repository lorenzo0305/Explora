  "rdfs:comment": {
    "de": [
      "Das Château Vareppe ist ein familiengeführtes Weingut in Groslée-Saint-Benoît. Es vereint Kulturerbe, regionale Weine und Geselligkeit und lädt Sie zu einer großen Tafelrunde mit einem Schwein am Spieß ein!"
    ],
    "en": [
      "Château Vareppe is a family-run wine estate in Groslée-Saint-Benoît. Combining heritage, local wines and conviviality, it welcomes large tables around a pig on a spit!"
    ],
    "it": [
      "Château Vareppe è un'azienda vinicola a conduzione familiare a Groslée-Saint-Benoît. Combinando patrimonio, vini locali e convivialità, accoglie grandi tavolate intorno a un maiale allo spiedo!"
    ],
    "fr": [
      "Le Château Vareppe est un domaine viticole familial situé à Groslée-Saint-Benoît. Alliant patrimoine, vins de terroir et convivialité, il accueille de grande tablée autour d'un cochon à la broche!"
    ],
    "nl": [
      "Château Vareppe is een familiaal wijndomein in Groslée-Saint-Benoît. Het combineert erfgoed, lokale wijnen en gezelligheid en verwelkomt grote tafels rond een varken van het spit!"
    ],
    "es": [
      "Château Vareppe es un viñedo familiar situado en Groslée-Saint-Benoît. Combinando patrimonio, vinos de la tierra y convivencia, acoge grandes mesas en torno a un cochinillo asado"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Salle de réception du Château de Vareppe"
    ]
  },
