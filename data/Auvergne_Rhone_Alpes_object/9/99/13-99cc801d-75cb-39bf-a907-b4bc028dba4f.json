  "rdfs:comment": {
    "de": [
      "XTREM VALENCE ist 6000 m2 Indoor-Freizeit mit einem KARTING, einem 16-Bahnen-BOWLING, einem LASERGAME, einem SNACK und einer Außenterrasse\r\nKommen Sie vorbei, haben Sie Spaß und verbringen Sie das ganze Jahr über unvergessliche Momente."
    ],
    "en": [
      "XTREM VALENCE is 6000 m2 of indoor leisure with a KARTING, a 16-track BOWLING, a LASERGAME, a SNACK and an outdoor terrace\r\nCome have fun and spend unforgettable moments all year round."
    ],
    "it": [
      "XTREM VALENCE è 6000 m2 di svago al coperto con un KARTING, un BOWLING a 16 piste, un LASERGAME, uno SNACK e una terrazza all'aperto\r\nVieni a divertirti e a trascorrere momenti indimenticabili tutto l'anno."
    ],
    "fr": [
      "Xtrem VALENCE c'est 6000 m2 de loisirs indoor avec : \r\nKARTING\r\nBOWLING 16 pistes \r\nLASERGAME\r\nKARAOKE\r\nSANCK\r\nTERRASSE EXTERIEURE \r\nVenez vous amuser et passer des moments forts toute l’année."
    ],
    "es": [
      "Xtrem VALENCE son 6000 m2 de actividades de ocio cubiertas con :\r\nKARTING\r\nBOWLING 16 pistas\r\nLASERGAME\r\nKARAOKE\r\nSANCK\r\nTERRAZA EXTERIOR\r\nVen a divertirte todo el año."
    ],
    "nl": [
      "XTREM VALENCE is 6000 m2 indoor recreatie met een KARTING, een 16-track BOWLING, een LASERGAME, een SNACK en een buitenterras\r\nKom plezier maken en onvergetelijke momenten beleven het hele jaar door."
    ]
  },
