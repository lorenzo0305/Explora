  "rdfs:comment": {
    "de": [
      "Das Café-Restaurant Ess'Folie steht für Geselligkeit und lädt Sie zu einer außergewöhnlichen Zeitreise ein. Genießen Sie ein Essen zu zweit oder zu mehreren an einem Tisch in einer schicken Retro-Atmosphäre, wie sie in den 20er Jahren populär war."
    ],
    "en": [
      "The Ess’Folie café & restaurant is all about sharing and invites you for an extraordinary journey through time. Relish a romantic dinner or a meal with friends or family, in the chic vintage atmosphere of the roaring twenties."
    ],
    "it": [
      "Sinonimo di condivisione, il caffè-ristorante Ess'Folie vi invita a uno straordinario viaggio nel tempo. Gustate un pasto per due o più persone intorno a un tavolo, in un'atmosfera retro chic popolare degli anni '20.\r\nNon è previsto il servizio al tavolo."
    ],
    "fr": [
      "Synonyme de partage, le café-restaurant Ess'Folie vous invite à un voyage dans le temps hors du commun. Savourez un repas en amoureux ou à plusieurs autour d'une table, dans une atmosphère rétro chic populaire des années 20.\r\nPas de service à table."
    ],
    "es": [
      "Sinónimo de compartir, el café-restaurante Ess'Folie le invita a un extraordinario viaje en el tiempo. Disfrute de una comida para dos o más personas alrededor de una mesa, en un ambiente retro chic popular de los años 20.\r\nNo hay servicio de mesa."
    ],
    "nl": [
      "Het café-restaurant Ess'Folie, synoniem voor delen, nodigt je uit voor een buitengewone reis terug in de tijd. Geniet van een maaltijd voor twee of meer rond een tafel, in een populaire retro chique sfeer van de jaren 20.\r\nGeen bediening aan tafel."
    ]
  },
