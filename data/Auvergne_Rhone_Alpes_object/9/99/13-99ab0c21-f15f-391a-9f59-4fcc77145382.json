  "rdfs:comment": {
    "de": [
      "Das Theater Silvia Monfort ist ein Amphitheater mit 443 Sitzplätzen, in dem jedes Jahr von September bis Juni eine sehr eklektische Kultursaison angeboten wird. (Musik, Theater, Tanz, Humor, junges Publikum, Zirkus ...) zahlreiche Termine, die es zu entdecken gilt."
    ],
    "en": [
      "The Silvia Monfort theater is an amphitheater with 443 seats where each year a very eclectic cultural season is offered from September to June. (Music, theater, dance, humor, young audience, circus ...) many appointments to discover."
    ],
    "it": [
      "Il teatro Silvia Monfort è un anfiteatro con 443 posti a sedere dove ogni anno, da settembre a giugno, viene proposta una stagione culturale molto eclettica. (Musica, teatro, danza, commedia, pubblico giovane, circo...) tanti eventi da scoprire."
    ],
    "fr": [
      "Le théâtre Silvia Monfort est un amphithéâtre de 443 places assises où chaque année une saison culturelle très éclectique est proposée de septembre à juin. (Musique, théâtre, danse, humour, jeune public, cirque ...) de nombreux rendez-vous à découvrir."
    ],
    "nl": [
      "Het Silvia Monfort theater is een amfitheater met 443 plaatsen waar elk jaar van september tot juni een zeer eclectisch cultureel seizoen wordt aangeboden. (Muziek, theater, dans, komedie, jong publiek, circus...) vele evenementen te ontdekken."
    ],
    "es": [
      "El teatro Silvia Monfort es un anfiteatro de 443 localidades donde cada año se ofrece una temporada cultural muy ecléctica de septiembre a junio. (Música, teatro, danza, comedia, público joven, circo...) muchos eventos por descubrir."
    ]
  },
