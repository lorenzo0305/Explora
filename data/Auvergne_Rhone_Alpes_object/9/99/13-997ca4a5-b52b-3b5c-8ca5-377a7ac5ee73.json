  "rdfs:comment": {
    "de": [
      "Kulturelles Vereinszentrum mit verschiedenen Aktivitäten, die dort organisiert werden: Kreative Workshops, Themenabende, Ausstellungen, Spielothek?\r\nDas Vereins- und Kulturzentrum soll vor allem ein Ort der Begegnung und Geselligkeit sein."
    ],
    "en": [
      "Associative cultural center with different activities that will be organized there: Creative workshops, theme evenings, exhibitions, toy library....\r\nThe associative and cultural space that is being set up will above all be a place for meetings and conviviality."
    ],
    "it": [
      "Un centro culturale associativo con una varietà di attività organizzate: Laboratori creativi, serate a tema, mostre, ludoteca, ecc.\r\nLo spazio associativo e culturale che sta nascendo sarà soprattutto un luogo dove le persone potranno incontrarsi e stare in compagnia."
    ],
    "fr": [
      "Centre culturel associatif avec des activités différentes qui y seront organisées : Ateliers créatifs, soirées à thème, expositions, ludothèque….\r\nL'espace associatif et culturel qui se met en place sera surtout un lieu de rencontres et de convivialité."
    ],
    "es": [
      "Un centro cultural asociativo con diversas actividades organizadas: Talleres creativos, veladas temáticas, exposiciones, ludoteca, etc.\r\nEl espacio asociativo y cultural que se está creando será ante todo un lugar donde la gente pueda reunirse y disfrutar de la compañía de los demás."
    ],
    "nl": [
      "Een associatief cultureel centrum met een verscheidenheid aan georganiseerde activiteiten: Creatieve workshops, thema-avonden, tentoonstellingen, spelotheek, enz.\r\nDe associatieve en culturele ruimte die wordt opgezet, zal vooral een plek zijn waar mensen elkaar kunnen ontmoeten en van elkaars gezelschap kunnen genieten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Café associatif La Coccinelle"
    ]
  },
