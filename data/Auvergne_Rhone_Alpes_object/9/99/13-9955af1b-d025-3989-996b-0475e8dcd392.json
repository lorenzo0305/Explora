  "rdfs:comment": {
    "de": [
      "Praktische Freizeitaktivitäten: Wandern, Schneeschuhwandern, Wandertouren.\r\nBergschulungen: Lawinengefahr bewältigen, sich orientieren, GPS verwenden, sichern und retten.\r\nFirmenseminare"
    ],
    "en": [
      "Leisure activities: hiking, snowshoeing, touring.\r\nMountain training: avalanche risk management, orienteering, GPS use, safety and rescue.\r\nCompany seminars"
    ],
    "it": [
      "Attività per il tempo libero: escursioni, ciaspolate, tour.\r\nFormazione in montagna: gestione del rischio valanghe, orienteering, uso del GPS, sicurezza e soccorso\r\nSeminari aziendali"
    ],
    "fr": [
      "Pratique Loisirs : Randonnée pédestre, randonnée en raquettes, randonnée itinérante.\r\nFormations montagne : gerer les risques d'avalanche, savoir s'orienter, utiliser un GPS, sécuriser et secourir\r\nSéminaires d'entreprise"
    ],
    "nl": [
      "Vrijetijdsactiviteiten: wandelen, sneeuwschoenwandelen, toertochten.\r\nBergtraining: lawinegevaar, oriëntatieloop, GPS-gebruik, veiligheid en redding.\r\nBedrijfsseminars"
    ],
    "es": [
      "Actividades de ocio: senderismo, raquetas de nieve, turismo.\r\nFormación en montaña: gestión del riesgo de aludes, orientación, uso de GPS, seguridad y rescate\r\nSeminarios de empresa"
    ]
  },
