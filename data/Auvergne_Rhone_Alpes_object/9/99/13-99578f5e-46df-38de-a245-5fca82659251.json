  "rdfs:comment": {
    "de": [
      "Entdecken Sie den Vercors mit einer passionierten Begleiterin: Familienwanderungen, Sportausflüge, Tierbeobachtungen, Biwaks unter dem Sternenhimmel. Eine gesellige und für alle zugängliche Erfahrung zu jeder Jahreszeit im Herzen der Berge."
    ],
    "en": [
      "Discover the Vercors with a passionate guide: family hikes, sports outings, wildlife observation, bivouacs under the stars. A friendly experience accessible to all, in all seasons, in the heart of the mountains."
    ],
    "it": [
      "Scoprite il Vercors con una guida appassionata: escursioni in famiglia, uscite sportive, osservazione della fauna, bivacchi sotto le stelle. Un'esperienza conviviale accessibile a tutti, in qualsiasi stagione, nel cuore delle montagne."
    ],
    "fr": [
      "Partez à la découverte du Vercors avec une accompagnatrice passionnée : randonnées familiales, sorties sportives, observation de la faune, bivouacs sous les étoiles. Une expérience conviviale et accessible à tous, en toutes saisons, au cœur des montagnes."
    ],
    "nl": [
      "Ontdek de Vercors met een gepassioneerde gids: gezinswandelingen, sportieve uitstapjes, wild spotten, bivak onder de sterrenhemel. Een gezellige ervaring, toegankelijk voor iedereen, het hele jaar door, in het hart van de bergen."
    ],
    "es": [
      "Descubra el Vercors con un guía apasionado: excursiones en familia, salidas deportivas, observación de la fauna, vivaques bajo las estrellas. Una experiencia agradable, accesible a todos, todo el año, en el corazón de las montañas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "C'est ta nature"
    ]
  },
