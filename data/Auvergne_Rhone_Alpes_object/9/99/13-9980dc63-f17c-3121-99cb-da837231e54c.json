  "rdfs:comment": {
    "de": [
      "Die Bibliothek in Jarrier bietet eine kostenlose Ausleihe von Jugend- und Erwachsenenbüchern: Romane (verschiedene, Krimis, Savoyen...) Comics, Sachbücher (Tourismus und Wandern, Medizin, Geschichte) usw.\r\nEin Bereich für Kleinkinder ist vor Ort vorhanden."
    ],
    "en": [
      "The Jarrier library offers free lending of books for young people and adults: novels (miscellaneous, detective, Savoyard...), comics, documentaries (tourism and hiking, medicine, history), etc.\r\nA children's area is available on site."
    ],
    "it": [
      "La biblioteca di Jarrier offre il prestito gratuito di libri per giovani e adulti: romanzi (vari, polizieschi, savoiardi, ecc.), fumetti, documentari (turismo ed escursionismo, medicina, storia, ecc.) e altro ancora.\r\nIn loco è presente anche un'area per bambini."
    ],
    "fr": [
      "La bibliothèque de Jarrier propose un prêt gratuit de livres jeunesse et adulte : romans (divers, policiers, savoyards...) BD, documentaires (tourisme et randonnée, médecine, histoire) etc.\r\nUn espace pour les petits est présent sur place."
    ],
    "es": [
      "La biblioteca Jarrier ofrece préstamo gratuito de libros para jóvenes y adultos: novelas (misceláneas, policíacas, saboyanas, etc.), cómics, documentales (turismo y senderismo, medicina, historia, etc.) y mucho más.\r\nTambién hay una zona infantil."
    ],
    "nl": [
      "De bibliotheek van Jarrier biedt gratis uitleen van boeken voor jongeren en volwassenen: romans (diverse, detective, Savoyard, enz.), strips, documentaires (toerisme en wandelen, geneeskunde, geschiedenis), enz.\r\nEr is ook een ruimte voor kinderen."
    ]
  },
