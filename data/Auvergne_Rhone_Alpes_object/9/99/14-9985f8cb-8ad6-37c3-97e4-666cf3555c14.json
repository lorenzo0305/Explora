      "@id": "https://data.datatourisme.fr/6f0e3ce3-9cd9-3d76-b87c-e54b886dd054",
      "dc:description": {
        "de": [
          "Verkauf von Sportartikeln und -ausrüstung. Textilien und Schuhe. Verkauf und Reparatur von Fahrrädern. INTERSPORT begleitet Sie beim Kauf, der Reparatur und der Wartung Ihres Fahrrads."
        ],
        "en": [
          "Sale of sports articles and equipment. Textiles and footwear. Cycle sales and repairs. INTERSPORT helps you buy, repair and maintain your bike."
        ],
        "it": [
          "Vendita di articoli e attrezzature sportive. Tessili e calzature. Vendita e riparazione di biciclette. INTERSPORT può aiutarvi ad acquistare, riparare e mantenere la vostra bicicletta."
        ],
        "fr": [
          "Vente articles et matériel de sports. Textile et chaussures. Vente et réparation cycle. INTERSPORT vous accompagne dans l'achat, la réparation et l'entretien de votre vélo."
        ],
        "nl": [
          "Verkoop van sportartikelen en -uitrusting. Textiel en schoeisel. Fietsverkoop en -reparatie. INTERSPORT kan je helpen bij het kopen, repareren en onderhouden van je fiets."
        ],
        "es": [
          "Venta de artículos y material deportivo. Textil y calzado. Venta y reparación de bicicletas. INTERSPORT puede ayudarle a comprar, reparar y mantener su bicicleta."
        ]
      },
