  "rdfs:comment": {
    "de": [
      "Das Croix de Sasseigne liegt an der Grenze von drei Departements und bietet einen außergewöhnlichen Panoramablick auf die Rhône und die Berge von Bugey. Das Croix de Sasseigne befindet sich in der Gemeinde Champagneux und überragt den unterhalb gelegenen Hauptort des Dorfes."
    ],
    "en": [
      "This site offers an exceptional viewing point over the Rhône and the Monts du Bugey."
    ],
    "it": [
      "Ai confini di tre dipartimenti, la Croix de Sasseigne offre una vista panoramica eccezionale sul Rodano e sulle montagne del Bugey. Situata nel comune di Champagneux, la Croix de Sasseigne domina il villaggio sottostante."
    ],
    "fr": [
      "Aux frontières de trois départements, la Croix de Sasseigne permet de jouir d'un panorama exceptionnel sur le Rhône et les monts du Bugey. Installée sur la commune de Champagneux, la Croix de Sasseigne domine le chef-lieu du village situé en contrebas."
    ],
    "es": [
      "En la frontera de tres departamentos, la Croix de Sasseigne ofrece una vista panorámica excepcional del Ródano y del macizo del Bugey. Situada en el municipio de Champagneux, la Croix de Sasseigne domina el pueblo."
    ],
    "nl": [
      "Deze plaats biedt een uitzonderlijk uit zicht over de Rhône en de bergen van Bugey."
    ]
  },
  "rdfs:label": {
