  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/27cc54d0-f828-3792-95db-65e6dd4be04b",
      "dc:description": {
        "de": [
          "Besuch der Neugierde\nKommentierte Verkostung von Tees und Kräutertees, die zu Werken aus den Sammlungen des Museums passen.\n\nEintrittspreis für das Museum 4 Euro.\nAuf Reservierung\n\nDauer: 1,5 Std\nMelden Sie sich 5 Minuten vor Beginn der Führung.\n\nTermine:\nMittwochs 09/07, 23/07 und 06/08 von 16:30 bis 18:00 Uhr."
        ],
        "en": [
          "Curiosity tour\nGuided tasting of teas and infusions to match the works in the Museum's collections.\n\nMuseum admission 4 euros.\nBy reservation only\n\nDuration: 1h30\nPlease arrive 5 minutes before the tour begins.\n\nDates:\nWednesdays 09/07, 23/07 and 06/08 from 4:30pm to 6pm."
        ],
        "it": [
          "Visita di curiosità\nDegustazione guidata di tè e infusi abbinati alle opere delle collezioni del Museo.\n\nIngresso al museo 4 euro.\nSolo su prenotazione\n\nDurata: 1h30\nSi prega di arrivare 5 minuti prima dell'inizio della visita.\n\nAppuntamenti:\nMercoledì 09/07, 23/07 e 06/08 dalle 16:30 alle 18:00."
        ],
        "fr": [
          "Visite curiosité\nDégustation commentée de thés et infusions en adéquation avec les œuvres des collections du Musée.\n\nPrix d'entrée au musée 4 euros. \nSur réservation \n\nDurée : 1h30\nSe présenter 5 minutes avant le début de la visite.\n\nRendez-vous :\nMercredis 09/07, 23/07 et 06/08 de 16h30 à 18h."
        ],
        "es": [
          "Visita curiosa\nDegustación guiada de tés e infusiones a juego con las obras de las colecciones del Museo.\n\nEntrada al Museo: 4 euros.\nSólo con reserva\n\nDuración: 1h30\nSe ruega llegar 5 minutos antes del inicio de la visita.\n\nCitas previas:\nMiércoles 09/07, 23/07 y 06/08 de 16:30 a 18:00."
        ],
        "nl": [
          "Nieuwsgierigheidstocht\nBegeleid proeven van thee en infusies die passen bij de werken in de collecties van het museum.\n\nToegang museum €4.\nAlleen op reservering\n\nDuur: 1u30\nGelieve 5 minuten voor het begin van de rondleiding aanwezig te zijn.\n\nAfspraken:\nWoensdag 09/07, 23/07 en 06/08 van 16:30 tot 18:00."
        ]
      },
