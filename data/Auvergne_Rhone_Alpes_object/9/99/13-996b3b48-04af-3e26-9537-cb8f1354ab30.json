  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Driving Range der Domaine de Valinches mit einer 300 m langen Driving Range, einem Wedging- und Pitching-Bereich sowie einem Putting-Green-Bereich (ca. 10 Übungslöcher).\r\nDie Ausrüstung kann zur Verfügung gestellt werden."
    ],
    "en": [
      "Come and discover the Domaine de Valinches golf practice facility, with a 300 m driving range, a wedging and pitching area and a putting green (ten or so practice holes).\r\nEquipment can be provided."
    ],
    "it": [
      "Venite a scoprire il campo da golf del Domaine de Valinches, con un driving range di 300 m, un'area di wedging e pitching e un putting green (circa dieci buche di pratica).\r\nL'attrezzatura può essere fornita."
    ],
    "fr": [
      "Venez découvrir le practice de golf du Domaine de Valinches avec un practice de 300 m, une zone de wedging et de pitching ainsi qu’une zone de putting green (une dizaine de trous d’entrainement).\r\nLe matériel peut-être fourni."
    ],
    "es": [
      "Venga a descubrir el campo de prácticas de golf del Domaine de Valinches, con un driving range de 300 m, una zona de wedging y pitching y un putting green (una decena de hoyos de prácticas).\r\nSe puede proporcionar material."
    ],
    "nl": [
      "Kom en ontdek de golf driving range van Domaine de Valinches, met een driving range van 300 m, een wedging en pitching area en een putting green (ongeveer tien oefenholes).\r\nMateriaal kan worden verstrekt."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Golf à Valinches"
    ]
  },
