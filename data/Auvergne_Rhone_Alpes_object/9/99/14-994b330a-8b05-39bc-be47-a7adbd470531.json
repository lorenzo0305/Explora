      "dc:description": {
        "de": [
          "Große Eierjagd Am Sonntag, den 20. April 2025\nPlace de France in Boulogne-sur-Mer\nVon 15 Uhr bis 17 Uhr\nOrganisiert und finanziert von der Bar L'Espace. Nur mit Reservierungen in der Bar L'Espace."
        ],
        "en": [
          "Big Egg Hunt Sunday, April 20, 2025\nPlace de France, Boulogne-sur-Mer\nFrom 3pm to 5pm\nOrganized and financed by Bar L'Espace. Reservations only at Bar L'Espace."
        ],
        "it": [
          "Caccia alle uova domenica 20 aprile 2025\nPiazza di Francia, Boulogne-sur-Mer\nDalle 15.00 alle 17.00\nOrganizzata e finanziata dal Bar L'Espace. Solo su prenotazione presso il Bar L'Espace."
        ],
        "fr": [
          "Grande Chasse aux Œufs Le Dimanche 20 Avril 2025\nPlace de France à Boulogne-sur-Mer\nDe 15h à 17h\nOrganisée et financée par le Bar L'Espace. Sur réservations uniquement au Bar L'Espace."
        ],
        "nl": [
          "Grote Eierenjacht zondag 20 april 2025\nPlace de France, Boulogne-sur-Mer\nVan 15.00 tot 17.00 uur\nGeorganiseerd en gefinancierd door de Bar L'Espace. Alleen op reservering bij Bar L'Espace."
        ],
        "es": [
          "Gran Caza del Huevo Domingo 20 de abril de 2025\nPlaza de Francia, Boulogne-sur-Mer\nDe 15.00 a 17.00 h\nOrganizado y financiado por el Bar L'Espace. Con reserva previa en el Bar L'Espace."
        ]
      },
