  "rdfs:comment": {
    "de": [
      "Die Mediathek bietet Ihnen Musik, Bücher (Romane, Dokumentarfilme aus allen Bereichen, Wörterbücher und Enzyklopädien, Zeitschriften, Comics, Alben für Kinder, Kassettenbücher), Multimedia, Ausstellungen und Veranstaltungen das ganze Jahr über."
    ],
    "en": [
      "The library offers you music, books, digital, exhibitions all year long."
    ],
    "it": [
      "La mediateca offre tutto l'anno musica, libri (romanzi, documentari di tutte le discipline, dizionari ed enciclopedie, riviste, fumetti, album per bambini, cassette), multimedia, mostre ed eventi."
    ],
    "fr": [
      "La médiathèque vous propose de la musique, des livres (romans, documentaires dans toutes les disciplines, dictionnaires et encyclopédies, revues, BD, albums pour les enfants, livres cassettes), du multimédia, des expositions et animations toute l'année."
    ],
    "es": [
      "La mediateca ofrece música, libros (novelas, documentales de todas las disciplinas, diccionarios y enciclopedias, revistas, cómics, álbumes para niños, libros en casete), multimedia, exposiciones y eventos durante todo el año."
    ],
    "nl": [
      "De mediatheek biedt muziek, boeken (romans, documentaires in alle disciplines, woordenboeken en encyclopedieën, tijdschriften, stripboeken, albums voor kinderen, cassetteboeken), multimedia, tentoonstellingen en evenementen gedurende het hele jaar."
    ]
  },
