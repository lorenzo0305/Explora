  "rdfs:comment": {
    "de": [
      "Virginie empfängt Sie das ganze Jahr über, um Ihnen eine kreative, hausgemachte und saisonale Küche zu präsentieren.\r\nAlle unsere Gerichte sind mit Leidenschaft konzipiert und verwenden überwiegend lokale Produkte."
    ],
    "en": [
      "De la Cuche à l'Assiette welcomes you at the entrance of the village on its brand new terrace. \r\nVirginie prepares specialities from Chartreuse and elsewhere."
    ],
    "it": [
      "Virginie vi accoglie tutto l'anno per farvi scoprire la nostra cucina creativa, casalinga e stagionale.\r\nTutti i nostri piatti sono creati con passione e utilizzano prevalentemente prodotti locali."
    ],
    "fr": [
      "Virginie vous accueille toute l'année pour vous faire découvrir une cuisine créative, maison et de saison. \r\nTous nos plats sont conçus avec passion et utilisent en majorité des produits locaux."
    ],
    "nl": [
      "Virginie verwelkomt je het hele jaar door om je onze creatieve, huisgemaakte, seizoensgebonden keuken te laten ontdekken.\r\nAl onze gerechten zijn met passie gemaakt en gebruiken voornamelijk lokale producten."
    ],
    "es": [
      "Virginie le recibe todo el año para hacerle descubrir nuestra cocina creativa, casera y de temporada.\r\nTodos nuestros platos se crean con pasión y utilizan principalmente productos locales."
    ]
  },
