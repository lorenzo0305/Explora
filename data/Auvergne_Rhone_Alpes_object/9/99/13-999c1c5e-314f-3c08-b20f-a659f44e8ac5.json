  "rdfs:comment": {
    "de": [
      "Auf der Reise von einem Werk zu einem Jugendbuch werden Sie die üppige Welt von Hubert Robert & Jean-Honoré Fragonard entdecken, die voller tausend und einem Naturwunder ist!"
    ],
    "en": [
      "As you travel from a work of art to a children?s album, you?ll discover the abundant universe of Hubert Robert & Jean-Honoré Fragonard, filled with a thousand and one natural wonders!"
    ],
    "it": [
      "Passando da un'opera d'arte a un album per bambini, scoprirete il brulicante universo di Hubert Robert & Jean-Honoré Fragonard, ricco di mille e una meraviglia naturale!"
    ],
    "fr": [
      "En voyageant d’une oeuvre à un album jeunesse, vous découvrirez l’univers foisonnant de Hubert Robert & Jean-Honoré Fragonard, rempli de mille et une merveilles naturelles !"
    ],
    "nl": [
      "Terwijl je van een kunstwerk naar een kinderalbum reist, ontdek je het krioelende universum van Hubert Robert & Jean-Honoré Fragonard, gevuld met duizend en één natuurlijke wonderen!"
    ],
    "es": [
      "Al pasar de una obra de arte a un álbum infantil, descubrirá el universo rebosante de Hubert Robert & Jean-Honoré Fragonard, ¡lleno de mil y una maravillas naturales!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite en famille « Ecoutez-voir : Hubert Robert & Fragonard » - Les mercredis en famille"
    ]
  },
