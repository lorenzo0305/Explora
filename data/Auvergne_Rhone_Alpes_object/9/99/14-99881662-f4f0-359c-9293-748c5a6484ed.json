  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/49920dc6-e1fb-3f5f-b1c9-c433c9b4f3e7",
      "dc:description": {
        "de": [
          "Informationen :\n\nÖffnungstage:\n\nMontag bis Samstag von 8:00 bis 19:30 Uhr. Sonntags geschlossen.\n\n\nBestellungen :\n\nKontaktieren Sie den Laden telefonisch unter 03 21 47 37 25 und holen Sie sie zu den Öffnungszeiten im Laden ab\n\n\n\n "
        ],
        "en": [
          "Information :\n\nOpening days:\n\nMonday to Saturday, 8am to 7.30pm. Closed on Sunday.\n\n\nTo order :\n\nContact the store by telephone on 03 21 47 37 25 and collect at the store during opening hours\n\n\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura:\n\nDal lunedì al sabato dalle 8.00 alle 19.30. Chiuso la domenica.\n\n\nPer ordinare :\n\nContattare il negozio telefonicamente al numero 03 21 47 37 25 e ritirare in negozio durante gli orari di apertura\n\n\n\n "
        ],
        "fr": [
          "Informations : \n\nJours d'ouverture: \n\nDu lundi au samedi de 8h à 19h30. Fermeture le dimanche.\n\n\nCommandes :\n\nContacter le magasin par téléphone au 03 21 47 37 25 et à venir retirer au magasin aux horaires d'ouverture\n\n\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen:\n\nMaandag t/m zaterdag van 8.00 tot 19.30 uur. Gesloten op zondag.\n\n\nOm te bestellen :\n\nNeem telefonisch contact op met de winkel op 03 21 47 37 25 en haal af in de winkel tijdens de openingsuren\n\n\n\n "
        ],
        "es": [
          "Más información :\n\nDías de apertura:\n\nDe lunes a sábado de 8h a 19h30. Domingos cerrado.\n\n\nPara pedir :\n\nPóngase en contacto con la tienda por teléfono llamando al 03 21 47 37 25 y recójalo en la tienda durante el horario de apertura\n\n\n\n "
        ]
      },
