  "rdfs:comment": {
    "de": [
      "Mariline und Sébastien Jacquemin begrüßen Sie in einem gemütlichen Speisesaal oder auf einer schönen Terrasse, wo Sie eine authentische Gourmetküche mit lokalen Produkten entdecken können."
    ],
    "en": [
      "In a friendly restaurant or on a nice terrace, Mariline and Sebastien Jacquemin welcome you to discover a tasty and authentic cuisine made with local products."
    ],
    "it": [
      "In un'accogliente sala ristorante o su una splendida terrazza, Mariline e Sébastien Jacquemin vi accolgono per farvi scoprire una cucina gourmet e autentica preparata con prodotti locali."
    ],
    "fr": [
      "Dans une salle de restaurant conviviale ou sur une belle terrasse, Mariline et Sébastien Jacquemin vous accueillent pour venir y découvrir une cuisine gourmande et authentique élaborée avec des produits locaux."
    ],
    "nl": [
      "In een gezellige restaurantzaal of op een prachtig terras verwelkomen Mariline en Sébastien Jacquemin u om een gastronomische en authentieke keuken te ontdekken, bereid met lokale producten."
    ],
    "es": [
      "En una acogedora sala de restaurante o en una hermosa terraza, Mariline y Sébastien Jacquemin le dan la bienvenida para que descubra una cocina gourmet y auténtica elaborada con productos locales."
    ]
  },
