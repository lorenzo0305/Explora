  "rdfs:comment": {
    "de": [
      "Sakura, das ist Asien zum Anfassen, und das alles mit Respekt vor Ihren Überzeugungen. Besuchen Sie uns in Montluel, bestellen Sie zum Mitnehmen oder lassen Sie sich in die Umgebung liefern und genießen Sie die besten halal-authentischen asiatischen Gerichte."
    ],
    "en": [
      "Sakura is Asia at your fingertips, while respecting your beliefs. Come and see us in Montluel, order takeaway or have it delivered to your door, and treat yourself to the best authentic halal Asian dishes."
    ],
    "it": [
      "Sakura è l'Asia a portata di mano, nel rispetto delle vostre convinzioni. Venite a trovarci a Montluel, ordinate da asporto o fatevi consegnare a domicilio, e concedetevi i migliori piatti asiatici autentici e halal."
    ],
    "fr": [
      "Sakura, c’est l’Asie à portée de main, le tout dans le respect de vos convictions. Passez nous voir à Montluel, commandez à emporter, ou faites-vous livrer dans les alentours, et régalez-vous avec les meilleurs plats asiatiques halals et authentiques."
    ],
    "nl": [
      "Sakura is Azië binnen handbereik, met respect voor je geloof. Kom bij ons langs in Montluel, bestel afhaalmaaltijden of laat het thuisbezorgen, en trakteer jezelf op de beste authentieke halal Aziatische gerechten."
    ],
    "es": [
      "Sakura es Asia a tu alcance, respetando tus creencias. Ven a vernos a Montluel, pide comida para llevar o que te la traigan a casa, y deléitate con los mejores y auténticos platos asiáticos halal."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Sakura"
    ]
  },
