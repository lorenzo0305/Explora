  "rdfs:comment": {
    "de": [
      "Dieser Freiluftbereich vereint ein 25 m langes Sportbecken mit 5 Wasserlinien sowie ein Lernbecken, das allen Besuchern offen steht. Dieses Sommerbad verbindet Modernität, Ökologie und Anpassungsfähigkeit."
    ],
    "en": [
      "This open-air space combines a 25-meter sports pool with 5 lanes and a learning pool open to all. This summer pool combines modernity, ecology and adaptability."
    ],
    "it": [
      "Questo spazio all'aperto combina una piscina sportiva di 25 metri con 5 corsie e una piscina didattica aperta a tutti. Questa piscina estiva combina modernità, ecologia e adattabilità."
    ],
    "fr": [
      "Cet espace en plein air allie un bassin sportif de 25 mètres et 5 lignes d’eau ainsi qu’un bassin d’apprentissage ouvert à tout public. Cette piscine d’été combine modernité, écologie et adaptabilité."
    ],
    "es": [
      "Este espacio al aire libre combina una piscina deportiva de 25 metros con 5 calles y una piscina de aprendizaje abierta a todos. Esta piscina de verano combina modernidad, ecología y adaptabilidad."
    ],
    "nl": [
      "Deze openluchtruimte combineert een 25-meter sportbad met 5 banen en een leerbad dat voor iedereen toegankelijk is. Dit zomerzwembad combineert moderniteit, ecologie en aanpassingsvermogen."
    ]
  },
