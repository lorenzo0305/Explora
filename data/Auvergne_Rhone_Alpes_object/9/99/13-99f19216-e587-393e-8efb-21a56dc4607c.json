  "rdfs:comment": {
    "de": [
      "Diese Präsentation soll die Schlüssel zum Verständnis der Geschichte der beeindruckenden Zisterzienserabtei von Léoncel vermitteln, und zwar anhand einer historischen Darstellung, die den Orden von Cîteaux vorstellt,"
    ],
    "en": [
      "The aim of this presentation is to provide the keys to understanding the history of the impressive Cistercian abbey of Léoncel, through a historical account of the Cîteaux order,"
    ],
    "it": [
      "L'obiettivo di questa presentazione è fornire le chiavi di lettura della storia dell'imponente abbazia cistercense di Léoncel attraverso un racconto storico dell'ordine di Cîteaux,"
    ],
    "fr": [
      "Cette présentation a pour objectif de donner les clés pour comprendre l'histoire de l'impressionnante abbaye cistercienne de Léoncel à travers un exposé historique qui présente l'ordre de Cîteaux,"
    ],
    "nl": [
      "Het doel van deze presentatie is om je de sleutels te geven om de geschiedenis van de indrukwekkende cisterciënzerabdij van Léoncel te begrijpen aan de hand van een historisch verslag van de orde van Cîteaux,"
    ],
    "es": [
      "El objetivo de esta presentación es darle las claves para comprender la historia de la impresionante abadía cisterciense de Léoncel a través de un relato histórico de la orden de Cîteaux,"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Conférence : L'Abbaye cistercienne de Léoncel"
    ]
  },
