  "rdfs:comment": {
    "de": [
      "Die Compagnie Haut les Mains erkundet das Werk von Jacques Prévert in einer poetischen Aufführung, die Marionetten und Kontrabass miteinander verbindet. Paroles stellt unsere Menschlichkeit und unsere Welt in Frage, in einer sensiblen Form, die für alle Zuschauer zugänglich ist."
    ],
    "en": [
      "The Haut les Mains company explores the work of Jacques Prévert in a poetic show combining puppets and double bass. Paroles questions our humanity and our world, in a sensitive form accessible to all audiences."
    ],
    "it": [
      "Haut les Mains esplora l'opera di Jacques Prévert in uno spettacolo poetico che combina marionette e contrabbasso. Paroles mette in discussione la nostra umanità e il nostro mondo, in una forma sensibile e accessibile a tutti i pubblici."
    ],
    "fr": [
      "La compagnie Haut les Mains explore l’œuvre de Jacques Prévert dans un spectacle poétique mêlant marionnettes et contrebasse. Paroles interroge notre humanité et notre monde, dans une forme sensible accessible à tous les publics."
    ],
    "nl": [
      "Haut les Mains verkent het werk van Jacques Prévert in een poëtische voorstelling met poppen en contrabas. Paroles stelt onze menselijkheid en onze wereld in vraag, in een gevoelige vorm die toegankelijk is voor elk publiek."
    ],
    "es": [
      "Haut les Mains explora la obra de Jacques Prévert en un espectáculo poético que combina marionetas y contrabajo. Paroles cuestiona nuestra humanidad y nuestro mundo, de una forma sensible y accesible a todos los públicos."
    ]
  },
  "rdfs:label": {
    "fr": [
