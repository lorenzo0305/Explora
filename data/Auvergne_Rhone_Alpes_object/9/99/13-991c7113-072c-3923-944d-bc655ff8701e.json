  "rdfs:comment": {
    "de": [
      "Sportclub mit unbegrenztem Zugang, Gruppenkurse, Cardio-Trainingsbereich, Muskelaufbau, diplomierte Trainer Alexis, Fabio und Boris, persönliche Betreuung inklusive. Hochwertige Ausstattung zur selbstständigen Nutzung, ohne Termin und ohne Verpflichtung!"
    ],
    "en": [
      "Sports club with unlimited access, group classes, cardio training, muscle strengthening, qualified coaches Alexis, Fabio and Boris, personalized follow-up included. Top-of-the-range equipment to use on your own, without appointment or commitment!"
    ],
    "it": [
      "Accesso illimitato al club sportivo, lezioni di gruppo, area cardio training, potenziamento muscolare, allenatori qualificati Alexis, Fabio e Boris, follow-up personalizzato incluso. Attrezzature di alta gamma da utilizzare autonomamente, senza appuntamento e senza impegno!"
    ],
    "fr": [
      "Club de sport en accès illimité, cours collectifs, espace cardio training, renforcement musculaire, coachs diplômés Alexis, Fabio et Boris, suivi personnalisé inclus. Équipement haut de gamme à utiliser en autonomie, sans rendez-vous et sans engagement !"
    ],
    "nl": [
      "Onbeperkt toegang tot de sportclub, groepslessen, cardiotraining, spierversterking, gediplomeerde coaches Alexis, Fabio en Boris, persoonlijke begeleiding inbegrepen. Topmateriaal om zelf te gebruiken, zonder afspraak en zonder verplichtingen!"
    ],
    "es": [
      "Acceso ilimitado al club deportivo, clases colectivas, zona de entrenamiento cardiovascular, refuerzo muscular, entrenadores cualificados Alexis, Fabio y Boris, seguimiento personalizado incluido. Material de alta gama para utilizar por su cuenta, sin cita previa y sin compromiso"
    ]
  },
