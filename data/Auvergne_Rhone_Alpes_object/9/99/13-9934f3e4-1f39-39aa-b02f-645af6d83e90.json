  "rdfs:comment": {
    "de": [
      "Überqueren Sie das Tal auf einer Zipline mit Ihren Skiern von der Spitze der Planchamp-Gondelbahn aus.\r\nFliegen Sie parallel und teilen Sie ein Erlebnis zu zweit auf der größten Doppel-Tirolerin Frankreichs.\r\nOnline-Buchung unter www.magicadventure.org"
    ],
    "en": [
      "Experience the thrill of a zip-line descent from the top of the Planchamp gondola!\r\nFly in parallel and share the experience for two!\r\nIt's the biggest double zip line in France!"
    ],
    "it": [
      "Attraversate la valle con gli sci dalla cima della cabinovia di Planchamp.\r\nVolate in parallelo e condividete un'esperienza a due sulla più grande zip line doppia della Francia.\r\nPrenotate online su www.magicadventure.org"
    ],
    "fr": [
      "Traversez la vallée en tyrolienne avec vos skis depuis le sommet de la télécabine de Planchamp.\r\nVolez en parallèle et partagez une expérience à deux sur la plus grande double tyrolienne de France.\r\nRéservation en ligne sur www.magicadventure.org"
    ],
    "nl": [
      "Beleef de sensatie van een zip-line afdaling vanaf de top van de Planchamp gondel!\r\nVlieg parallel en deel de ervaring voor twee!\r\nHet is de grootste dubbele tokkelbaan in Frankrijk!"
    ],
    "es": [
      "Atraviese el valle en tirolina sobre sus esquís desde lo alto del telecabina de Planchamp.\r\nVuele en paralelo y comparta una experiencia para dos en la tirolina doble más grande de Francia.\r\nReserva en línea en www.magicadventure.org"
    ]
  },
  "rdfs:label": {
    "en": [
