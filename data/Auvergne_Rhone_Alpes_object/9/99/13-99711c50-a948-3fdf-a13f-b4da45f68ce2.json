  "rdfs:comment": {
    "de": [
      "Nur wenige Schritte vom Zentrum von Megève entfernt empfängt Sie das Spa des Hotels***** L'Alpaga für einen Moment der Entspannung. Zwischen einer Ruhepause am Kamin und einer kontemplativen Pause, um die umliegenden Gipfel zu bewundern, genießen Sie einen Moment für sich, außerhalb der Zeit."
    ],
    "en": [
      "Want a tonic massage after a day of intense skiing ? Need a moment of pampering before meeting with friends for lunch? Or what about our signature massage ? Trust our spa therapists, they will adapt their treatments to your current mood."
    ],
    "it": [
      "La Spa dell'Alpaga vi aspetta per un momento fuori dal tempo. Avete voglia di un massaggio tonificante dopo una giornata di sci o di provare il nostro massaggio d'autore? Lasciatevi guidare, i nostri terapisti termali adatteranno i loro trattamenti ai vostri desideri del momento."
    ],
    "fr": [
      "À quelques pas du centre de Megève, le Spa de l'hôtel***** L'Alpaga vous reçoit pour un moment de détente. Entre repos auprès de la cheminée et pause contemplative pour admirer les sommets environnants, profitez d’un instant pour vous, hors du temps."
    ],
    "nl": [
      "Op een steenworp afstand van het centrum van Megève heet Spa***** L'Alpaga van het hotel je welkom voor een moment van ontspanning. Ontspan bij de open haard of neem een contemplatieve pauze om de omliggende bergtoppen te bewonderen, en geniet van een moment voor jezelf, buiten de tijd."
    ],
    "es": [
      "A dos pasos del centro de Megève, el Spa***** L'Alpaga del hotel le da la bienvenida para un momento de relajación. Relájese junto a la chimenea o haga una pausa contemplativa para admirar las cumbres de los alrededores, y disfrute de un momento para usted, fuera del tiempo."
    ]
  },
