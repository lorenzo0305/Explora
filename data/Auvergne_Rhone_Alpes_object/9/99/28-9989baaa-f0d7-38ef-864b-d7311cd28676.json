  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/b3e5fdb9-58b4-3506-af4b-5662a01d4070",
      "dc:description": {
        "de": [
          "Sie wurde von der Gemeinde nach den Plänen des Pariser Architekten Félix Paumier gebaut und am 9. Juli 1893 eingeweiht. Holden-Orgel bei Brandstiftung in der Nacht vom 21. auf den 22. Januar 1992 zerstört."
        ],
        "en": [
          "Built by the commune to plans by Parisian architect Félix Paumier, it was inaugurated on July 9, 1893. The Holden organ was destroyed by arson on the night of January 21-22, 1992."
        ],
        "it": [
          "Costruito dal comune su progetto dell'architetto parigino Félix Paumier, fu inaugurato il 9 luglio 1893. L'organo Holden è stato distrutto da un incendio doloso nella notte tra il 21 e il 22 gennaio 1992."
        ],
        "fr": [
          "Construit par la commune sur les plans de l'architecte parisien Félix Paumier, il est inauguré le 9 juillet 1893. Orgue Holden détruit lors de l'incendie criminel de la nuit du 21 au 22 janvier 1992."
        ],
        "nl": [
          "Het werd gebouwd door de gemeente naar een ontwerp van de Parijse architect Félix Paumier en werd ingehuldigd op 9 juli 1893. Het Holden-orgel werd in de nacht van 21 op 22 januari 1992 door brandstichting verwoest."
        ],
        "es": [
          "Construido por el ayuntamiento según los planos del arquitecto parisino Félix Paumier, fue inaugurado el 9 de julio de 1893. El órgano Holden fue destruido por un incendio provocado la noche del 21 al 22 de enero de 1992."
        ]
      },
