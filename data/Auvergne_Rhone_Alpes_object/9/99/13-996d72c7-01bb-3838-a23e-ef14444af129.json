  "rdfs:comment": {
    "de": [
      "Dorf Vissac-Auteyrac: Überreste des feudalen Schlosses. Kirche\r\naus dem 13. Jahrhundert mit geschnitztem Portal und Wandmalereien. Alte Kreuze in Vissac und Vissaguet. In Auteyrac: Kirche und Kapelle Notre-Dame d'Auteyrac\r\nmit Jungfrau aus dem 14."
    ],
    "en": [
      "Village of Vissac-Auteyrac: Remains of feudal castle. Church\r\n13th-century church with sculpted portal and murals. Old crosses at Vissac and Vissaguet. In Auteyrac, church and chapel of Notre-Dame d?Auteyrac\r\nwith 14th-century Virgin Mary."
    ],
    "it": [
      "Villaggio di Vissac-Auteyrac: resti del castello feudale. Chiesa\r\nchiesa del XIII secolo con portale scolpito e dipinti murali. Antiche croci a Vissac e Vissaguet. A Auteyrac, chiesa e cappella di Notre-Dame d'Auteyrac\r\ncon la Vergine Maria del XIV secolo."
    ],
    "fr": [
      "Village de Vissac-Auteyrac : Vestiges du château féodal. Église\r\ndu XIIIe siècle avec portail sculpté et peintures murales. Croix anciennes à Vissac et Vissaguet. À Auteyrac, église et chapelle de Notre-Dame d’Auteyrac\r\navec Vierge du XIVe siècle."
    ],
    "es": [
      "Pueblo de Vissac-Auteyrac: Restos del castillo feudal. Iglesia\r\niglesia del siglo XIII con portal esculpido y pinturas murales. Antiguas cruces en Vissac y Vissaguet. En Auteyrac, iglesia y capilla de Notre-Dame d'Auteyrac\r\ncon la Virgen María del siglo XIV."
    ],
    "nl": [
      "Dorp Vissac-Auteyrac: overblijfselen van het feodale kasteel. Kerk\r\nkerk uit de 13e eeuw met gebeeldhouwd portaal en muurschilderingen. Oude kruizen in Vissac en Vissaguet. In Auteyrac, kerk en kapel van Notre-Dame d'Auteyrac\r\nmet 14e eeuwse Maagd Maria."
    ]
  },
