  "rdfs:comment": {
    "de": [
      "Repariere Haushaltsgeräte in den Gemeinden Dieulefit-Bourdeaux und Umgebung. Ich repariere bei Ihnen zu Hause alle Arten von Elektrohaushaltsgeräten (Waschmaschine, Trockner, Geschirrspüler, Kühlschrank, Backofen, Gefrierschrank, Kaffeemaschine usw.)."
    ],
    "en": [
      "Appliance repairer in Dieulefit-Bourdeaux and surrounding areas. I repair all types of household appliances (washing machines, tumble dryers, dishwashers, fridges, ovens, freezers, coffee makers, etc.)."
    ],
    "it": [
      "Sono un riparatore di elettrodomestici nella zona di Dieulefit-Bourdeaux e dintorni. Riparo a domicilio tutti i tipi di elettrodomestici (lavatrice, asciugatrice, lavastoviglie, frigorifero, forno, congelatore, macchina per il caffè, ecc.)"
    ],
    "fr": [
      "Réparateur d'électro-ménager sur les communes de Dieulefit-Bourdeaux et ses alentours. Je répare à domicile tous types d'électro-ménagers (machine à laver, sèche-linge, lave-vaisselle, frigo, four, congélateur, cafetière, etc...)."
    ],
    "es": [
      "Soy reparador de electrodomésticos en la zona de Dieulefit-Bourdeaux y alrededores. Reparo en casa todo tipo de electrodomésticos (lavadora, secadora, lavavajillas, nevera, horno, congelador, cafetera, etc...)."
    ],
    "nl": [
      "Reparateur van huishoudelijke apparaten in Dieulefit-Bourdeaux en omgeving. Ik repareer alle soorten huishoudelijke apparaten aan huis (wasmachines, wasdrogers, vaatwassers, koelkasten, ovens, diepvriezers, koffiezetapparaten, enz.)"
    ]
  },
