  "rdfs:comment": {
    "de": [
      "2 Squashplätze zum Mieten. Schläger und Bälle können an der Rezeption von Le Signal ausgeliehen werden.\r\nAktivität nur für Personen ab 14 Jahren mit elterlicher Erlaubnis für Minderjährige.\r\nReservierung erforderlich."
    ],
    "en": [
      "2 squash courts available for hire. Rackets and balls available for hire at the Signal reception desk.\r\nActivity reserved for ages 14 and over, with parental authorisation for minors.\r\nReservation required."
    ],
    "it": [
      "2 campi da squash in affitto. Racchette e palline in affitto alla reception del Signal.\r\nAttività riservata ai maggiori di 14 anni con autorizzazione dei genitori per i minorenni.\r\nPrenotazione obbligatoria."
    ],
    "fr": [
      "2 courts de squash en location. Raquettes et balles en location à l'accueil du Signal.\r\nActivité réservée aux 14 ans et + avec autorisation parentale pour les mineurs.\r\nSur réservation obligatoire."
    ],
    "nl": [
      "2 squashbanen te huur. Rackets en ballen te huur bij de receptie van Le Signal.\r\nActiviteit voorbehouden aan personen van 14 jaar en ouder, met toestemming van de ouders voor minderjarigen.\r\nReserveren verplicht."
    ],
    "es": [
      "2 pistas de squash de alquiler. Se pueden alquilar raquetas y pelotas en la recepción de Le Signal.\r\nPara menores a partir de 14 años, se requiere autorización paterna.\r\nDebe reservarse con antelación."
    ]
  },
