  "rdfs:comment": {
    "de": [
      "Im \"Maison Saint Bénilde\" können die Besucher in einem Diorama aus dreizehn Bildern das Leben des Heiligen Bénilde und seinen Platz in der Geschichte der Sauguains entdecken."
    ],
    "en": [
      "In the \"Maison Saint Bénilde\", a diorama of thirteen paintings allows visitors to discover the life of Saint Bénilde and his place in the history of the Sauguans."
    ],
    "it": [
      "Nella \"Maison Saint Bénilde\", un diorama di tredici dipinti permette ai visitatori di scoprire la vita di Santa Bénilde e il suo posto nella storia dei Sauguani."
    ],
    "fr": [
      "Dans la « Maison Saint Bénilde », un diorama composé de treize tableaux permet aux visiteurs de découvrir la vie de Saint Bénilde et sa place dans l’histoire des Sauguains."
    ],
    "nl": [
      "In het \"Maison Saint Bénilde\" kunnen bezoekers aan de hand van een diorama met dertien schilderijen het leven van Saint Bénilde en zijn plaats in de geschiedenis van de Sauguans ontdekken."
    ],
    "es": [
      "En la \"Maison Saint Bénilde\", un diorama de trece cuadros permite descubrir la vida de Santa Benilde y su lugar en la historia de los sauguenses."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Diorama Saint-Bénilde"
    ]
  },
