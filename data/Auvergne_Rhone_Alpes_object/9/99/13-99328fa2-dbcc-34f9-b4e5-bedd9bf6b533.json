  "rdfs:comment": {
    "de": [
      "Tauchen Sie ein in ein Klanguniversum, in dem die Feinheit der Blechbläser auf die Magie des Kinos trifft.\r\nIn Zusammenarbeit mit dem Conservatoire André Messager und dem Lycée Madame de Staël (Spezialisierung auf Film)"
    ],
    "en": [
      "Immerse yourself in a world of sound where the finesse of brass meets the magic of cinema.\r\nIn partnership with the Conservatoire André Messager and the Lycée Madame de Staël (cinema specialization)"
    ],
    "it": [
      "Immergetevi in un mondo sonoro dove la finezza degli ottoni incontra la magia del cinema.\r\nIn collaborazione con il Conservatorio André Messager e il Lycée Madame de Staël (specialità cinema)"
    ],
    "fr": [
      "Plongez dans un univers sonore où la finesse des cuivres rencontre la magie du cinéma.\r\nEn partenariat avec le Conservatoire André Messager et le Lycée Madame de Staël (spécialité cinéma)"
    ],
    "es": [
      "Sumérjase en un universo sonoro en el que la delicadeza de los instrumentos de metal se une a la magia del cine.\r\nEn colaboración con el Conservatorio André Messager y el Liceo Madame de Staël (especialidad cine)"
    ],
    "nl": [
      "Dompel jezelf onder in een wereld van geluid waar de finesse van koperinstrumenten en de magie van cinema elkaar ontmoeten.\r\nIn samenwerking met het Conservatoire André Messager en het Lycée Madame de Staël (specialiteit film)"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Concert avant dîner : Les cuivres font leur cinéma !"
    ]
  },
