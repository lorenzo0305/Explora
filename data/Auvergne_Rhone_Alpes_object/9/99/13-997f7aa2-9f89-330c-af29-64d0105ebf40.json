  "rdfs:comment": {
    "de": [
      "Die Burg von Vieillevie, deren Ursprünge um das Jahr 1000 zurückreichen, überragt mit ihren hohen Türmen das Tal des Lot."
    ],
    "en": [
      "Visit of the medieval fortress of Vieillevie (11th-13th centuries) in July and August.\r\nStorytelling tours (in French): Tuesdays, Wednesdays and Thursdays at 5pm.\r\nPlaces are limited, so bookings must be made by text message or e-mail."
    ],
    "it": [
      "Il castello fortificato di Vieillevie, le cui origini risalgono all'anno 1000 circa, domina la valle del Lot dalle sue alte torri."
    ],
    "fr": [
      "Le château fort de Vieillevie, dont les origines remontent autour de l'an mil, domine de ses hautes tours la vallée du Lot."
    ],
    "es": [
      "El castillo fortificado de Vieillevie, cuyos orígenes se remontan aproximadamente al año 1000, domina el valle del Lot desde sus altas torres."
    ],
    "nl": [
      "Bezoek aan het versterkte kasteel van Vieillevie (11e-13e eeuw) in juli en augustus.\r\nRondleidingen met verhalen (in het Frans): dinsdag, woensdag en donderdag om 17 uur.\r\nHet aantal plaatsen is beperkt, dus boekingen moeten per sms of e-mail worden gedaan."
    ]
  },
