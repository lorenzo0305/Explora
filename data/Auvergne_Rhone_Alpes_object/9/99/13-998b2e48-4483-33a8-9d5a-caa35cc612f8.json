  "rdfs:comment": {
    "de": [
      "Workshop Modellieren Ton von 14.00 bis 16.00 Uhr Modellieren . Jeder Teilnehmer fertigt sein Werkstück an. Nach dem Brennen und Glasieren werden die Stücke 3 Wochen später abgeholt.\r\n20? - von 5 bis 13 Jahren\r\nReservierung 04 71 59 95 73"
    ],
    "en": [
      "Clay modeling workshop from 2pm to 4pm. Each participant creates his or her own piece. After firing and glazing, the pieces will be collected 3 weeks later.\r\n20? - ages 5 to 13\r\nBooking 04 71 59 95 73"
    ],
    "it": [
      "Laboratorio di modellazione dell'argilla dalle 14.00 alle 16.00. Ogni partecipante crea il proprio pezzo. Dopo la cottura e la smaltatura, i pezzi saranno ritirati 3 settimane dopo.\r\n20? - età compresa tra i 5 e i 13 anni\r\nPrenotazioni 04 71 59 95 73"
    ],
    "fr": [
      "Atelier modelage argile de 14h à 16h modelage . Chaque participant réalise sa pièce. Après cuisson et émaillage les pièces seront récupérées 3 semaines plus tard.\r\n20€ - de 5 à 13 ans \r\nRéservation 04 71 59 95 73"
    ],
    "es": [
      "Taller de modelado en arcilla de 14.00 a 16.00 horas. Cada participante crea su propia pieza. Tras la cocción y el esmaltado, las piezas se recogerán 3 semanas después.\r\n20? - de 5 a 13 años\r\nReservas 04 71 59 95 73"
    ],
    "nl": [
      "Klei boetseerworkshop van 14.00 tot 16.00 uur. Elke deelnemer maakt zijn eigen stuk. Na het bakken en glazuren worden de stukken 3 weken later opgehaald.\r\n20? - leeftijd 5 tot 13 jaar\r\nBoekingen 04 71 59 95 73"
    ]
  },
