  "rdfs:comment": {
    "de": [
      "Anschließend gemeinsames Essen für diejenigen, die es wünschen\r\nIn Anwesenheit der Autorin Isabelle Cachera.\r\nEmpreintes ist eine sinnliche Fibel, eine intime Reise, die das Universelle erreicht, die man wie ein Album durchblättert, zerbrechlich und vibrierend."
    ],
    "en": [
      "Followed by a shared meal for those who wish\r\nIn the presence of author Isabelle Cachera.\r\nEmpreintes is a sensory alphabet book, an intimate journey that reaches out to the universal, to be read as if leafing through a fragile, vibrant album."
    ],
    "it": [
      "Seguirà un pasto condiviso per coloro che desiderano partecipare\r\nIn presenza dell'autrice Isabelle Cachera.\r\nEmpreintes è un libro di alfabeto sensoriale, un viaggio intimo che raggiunge l'universale, da leggere come sfogliando un album fragile e vibrante."
    ],
    "fr": [
      "Suivi d’un repas partagé pour celles et ceux qui le souhaitent\r\nEn présence de l'autrice Isabelle Cachera.\r\nEmpreintes est un abécédaire sensoriel, un voyage intime qui rejoint l’universel, à lire comme on feuillette un album, fragile et vibrant."
    ],
    "es": [
      "Seguido de una comida compartida para los que deseen participar\r\nEn presencia de la autora Isabelle Cachera.\r\nEmpreintes es un abecedario sensorial, un viaje íntimo hacia lo universal, que se lee como si se hojeara un álbum frágil y vibrante."
    ],
    "nl": [
      "Gevolgd door een gezamenlijke maaltijd voor wie wil aanschuiven\r\nIn aanwezigheid van auteur Isabelle Cachera.\r\nEmpreintes is een zintuiglijk alfabetboek, een intieme reis die reikt naar het universele, om gelezen te worden als bladeren in een fragiel, levendig album."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Echanges et lectures autour de « Empreintes » de Isabelle Cachera"
    ]
  },
