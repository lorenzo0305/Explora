  "rdfs:comment": {
    "de": [
      "Éclats d'Lire erwartet Sie zahlreich anlässlich der Jazznacht! Und damit Sie das Beste daraus machen können, haben Sie die Chance, die Gruppe renaiz'jazz zu entdecken oder wiederzuentdecken!"
    ],
    "en": [
      "Éclats d'Lire looks forward to welcoming you to the jazz night! And to make the most of it, you'll have the chance to discover or rediscover the renaiz'jazz band!"
    ],
    "it": [
      "Éclats d'Lire è lieta di accogliervi alla serata jazz! E per approfittarne, avrete la possibilità di scoprire o riscoprire il gruppo Renaiz'jazz!"
    ],
    "fr": [
      "Éclats d'Lire vous attend nombreux à l'occasion de la nuit du jazz ! Et pour profiter au maximum, vous aurez la chance de découvrir ou de redécouvrir le groupe renaiz'jazz !"
    ],
    "es": [
      "Éclats d'Lire le da la bienvenida a la noche de jazz Y para aprovecharla al máximo, ¡tendrá la oportunidad de descubrir o redescubrir al grupo Renaiz'jazz!"
    ],
    "nl": [
      "Éclats d'Lire heet u van harte welkom op de jazzavond! En om er het beste van te maken, krijgt u de kans om de groep Renaiz'jazz te ontdekken of te herontdekken!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "La nuit du jazz"
    ]
  },
