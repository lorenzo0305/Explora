  "rdfs:comment": {
    "de": [
      "Jo Harman ist eine aufstrebende Figur des britischen Soul und Blues und besticht durch ihre kraftvolle und nuancierte Stimme, die emotionale Intensität und zeitlose Eleganz miteinander verbindet."
    ],
    "en": [
      "A rising star of British soul and blues, Jo Harman's powerful, nuanced voice combines emotional intensity with timeless elegance."
    ],
    "it": [
      "Stella nascente del soul e del blues britannico, Jo Harman ha una voce potente e ricca di sfumature che combina intensità emotiva ed eleganza senza tempo."
    ],
    "fr": [
      "Figure montante de la soul et du blues britannique, Jo Harman s’impose par une voix puissante et nuancée, mêlant intensité émotionnelle et élégance intemporelle."
    ],
    "es": [
      "Jo Harman, estrella emergente del soul y el blues británicos, posee una voz poderosa y llena de matices que combina la intensidad emocional con una elegancia atemporal."
    ],
    "nl": [
      "Jo Harman, de rijzende ster van de Britse soul en blues, heeft een krachtige, genuanceerde stem die emotionele intensiteit combineert met tijdloze elegantie."
    ]
  },
