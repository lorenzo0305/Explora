  "rdfs:comment": {
    "de": [
      "Nutzen Sie das gute Wetter für eine schöne Partie Pétanque!\r\nDer Bouleplatz ist das ganze Jahr über geöffnet, außer im Winter."
    ],
    "en": [
      "Enjoy the good weather and go for a nice pétanque game!\r\nThe petanque court is open all year round, except in winter."
    ],
    "it": [
      "Approfittate del bel tempo per fare una bella partita a pétanque!\r\nIl campo da bocce è aperto tutto l'anno, tranne in inverno."
    ],
    "fr": [
      "Profitez du beau temps pour faire une belle partie de pétanque !\r\nLe terrain de pétanque est ouvert toute l'année, sauf l'hiver."
    ],
    "nl": [
      "Geniet van het mooie weer voor een mooi partijtje petanque! \r\nPetanquebaan geopend het ganse jaar, behalve 's winters."
    ],
    "es": [
      "Aproveche el buen tiempo para jugar una buena partida de petanca\r\nLa pista de petanca está abierta todo el año, excepto en invierno."
    ]
  },
