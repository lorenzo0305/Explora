  "rdfs:comment": {
    "de": [
      "Der Verein \"cinéma et spiritualité\" organisiert in Lyon (3. Bezirk) und in Dieulefit für alle offene Debatten über Filme, die aufgrund ihrer ästhetischen und humanistischen Qualitäten ausgewählt wurden."
    ],
    "en": [
      "The \"cinéma et spiritualité\" association organizes debates in Lyon (3rd) and Dieulefit, open to all, around films selected for their aesthetic and humanist qualities."
    ],
    "it": [
      "L'associazione \"Cinema e spiritualità\" organizza a Lione (3a) e a Dieulefit dibattiti aperti a tutti su film selezionati per le loro qualità estetiche e umanistiche."
    ],
    "fr": [
      "L'association \"cinéma et spiritualité\" organise à Lyon (3ème) et à Dieulefit, des débats ouverts à tous autour de films sélectionnés pour leurs qualités esthétiques et humanistes."
    ],
    "es": [
      "La asociación \"Cine y Espiritualidad\" organiza debates en Lyon (3º) y Dieulefit, abiertos a todos, en torno a películas seleccionadas por sus cualidades estéticas y humanistas."
    ],
    "nl": [
      "De vereniging \"cinema en spiritualiteit\" organiseert voor iedereen toegankelijke debatten in Lyon (3e arrondissement) en Dieulefit over films die geselecteerd zijn op hun esthetische en humanistische kwaliteiten."
    ]
  },
  "rdfs:label": {
