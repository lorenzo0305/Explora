  "rdfs:comment": {
    "de": [
      "Das Schloss Valprivas wurde im 14. Jahrhundert anstelle eines alten \"castellum et oppidum\" errichtet, dessen Spuren bis ins 10. Jahrhundert zurückreichen. Führungen nur nach vorheriger Anmeldung per E-Mail."
    ],
    "en": [
      "The castle of Valprivas was built in the 14th century in place of an ancient \"castellum and oppidum\" whose traces go back to the 10th century. Guided tour only by appointment by email."
    ],
    "it": [
      "Il castello di Valprivas è stato costruito nel XIV secolo sul sito di un antico \"castellum e oppidum\" le cui tracce risalgono al X secolo. Visita guidata solo su prenotazione via e-mail."
    ],
    "fr": [
      "Le château de Valprivas a été érigé au XIVe siècle au lieu et place d'un ancien \"castellum et oppidum\" dont les traces remontent au Xe siècle. Visite guidée uniquement sur rendez vous par email."
    ],
    "nl": [
      "Het kasteel van Valprivas werd in de 14e eeuw gebouwd op de plaats van een oud \"castellum en oppidum\" waarvan de sporen teruggaan tot de 10e eeuw. Rondleiding alleen op afspraak per e-mail."
    ],
    "es": [
      "El castillo de Valprivas se construyó en el siglo XIV en el emplazamiento de un antiguo \"castellum y oppidum\" cuyos vestigios se remontan al siglo X. Visita guiada solo con cita previa por correo electrónico."
    ]
  },
