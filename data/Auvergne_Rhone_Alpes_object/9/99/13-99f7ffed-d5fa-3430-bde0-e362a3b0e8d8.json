  "rdfs:comment": {
    "de": [
      "Mountainbike-, E-bike-, Enduro-, Mountainbike-Abfahrt: Wir begleiten Sie seit 2012. Mit dem MTB machen wir mehr Spass! Ob Anfänger oder Profis, ob Gruppen oder Einzelpersonen - wir passen uns Ihren Wünschen an."
    ],
    "en": [
      "Downhill mountain biking, e-bike, enduro, mountain biking: we have been with you since 2012. The more you progress, the more you enjoy it! Beginners and confirmed, groups or individuals: we adapt to your wishes."
    ],
    "it": [
      "Istruttori di ciclismo francesi. Downhill, e-bike, enduro, rando VTT: siamo con voi dal 2012. Nella mountain bike, più si progredisce, più ci si diverte! Che siate principianti o esperti, gruppi o singoli, ci adatteremo alle vostre esigenze."
    ],
    "fr": [
      "Moniteurs Cyclistes Français. Descente VTT, e-bike, enduro, rando VTT : nous vous accompagnons depuis 2012. En VTT, plus on progresse, plus on se fait plaisir ! Débutants et confirmés, groupes ou particuliers : nous nous adaptons à vos souhaits."
    ],
    "es": [
      "Monitores de ciclismo franceses. Descenso, e-bike, enduro, rando VTT: estamos contigo desde 2012. En BTT, cuanto más progresas, ¡más te diviertes! Tanto si eres principiante como experimentado, en grupo o individual, nos adaptamos a tus necesidades."
    ],
    "nl": [
      "Franse fietsinstructeurs. Downhill, e-bike, enduro, rando VTT: we staan voor je klaar sinds 2012. Bij mountainbiken geldt: hoe meer vooruitgang, hoe meer plezier! Of je nu een beginner bent of een ervaren rijder, een groep of een individu, wij passen ons aan jouw behoeften aan."
    ]
  },
