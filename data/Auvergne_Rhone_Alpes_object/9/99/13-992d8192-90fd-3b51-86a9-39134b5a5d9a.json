  "rdfs:comment": {
    "de": [
      "In St Genix-les-Villages, das für seinen \"Gâteau de St Genix\" bekannt ist, betreten Sie die Welt des Kochs und Sommeliers Christophe Boudier. Seine kühne Küche, die mit lokalen Produkten zubereitet wird, bietet überraschende Kombinationen von Wein und Speisen."
    ],
    "en": [
      "In St Genix-les-Villages, famous for its \"Gâteau de St Genix\", enter the world of Christophe Boudier, chef and Sommelier. His daring cuisine, prepared with local produce, offers surprising food and wine pairings."
    ],
    "it": [
      "A St Genix-les-Villages, famosa per il suo \"Gâteau de St Genix\", entrate nel mondo di Christophe Boudier, chef e sommelier. La sua cucina audace, preparata con prodotti locali, offre sorprendenti abbinamenti cibo-vino."
    ],
    "fr": [
      "A St Genix-les-Villages, connu pour son « Gâteau de St Genix », entrez dans l'univers de Christophe Boudier, cuisinier et Sommelier. Sa cuisine, audacieuse et préparée avec des produits locaux, propose des accords mets-vins surprenants."
    ],
    "nl": [
      "In St Genix-les-Villages, beroemd om zijn \"Gâteau de St Genix\", betreedt u de wereld van Christophe Boudier, chef-kok en sommelier. Zijn gedurfde keuken, bereid met lokale producten, biedt verrassende wijn-spijs combinaties."
    ],
    "es": [
      "En St Genix-les-Villages, famoso por su \"Gâteau de St Genix\", entre en el mundo de Christophe Boudier, chef y sumiller. Su cocina atrevida, elaborada con productos locales, ofrece sorprendentes maridajes."
    ]
  },
  "rdfs:label": {
