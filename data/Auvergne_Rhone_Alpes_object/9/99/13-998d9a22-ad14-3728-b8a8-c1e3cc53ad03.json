  "rdfs:comment": {
    "de": [
      "In den Gärten von St. Julien kümmert man sich um die Erde. Gemüseanbau in biologischem Anbau, Produktion von frischem Saisongemüse und Vermarktung über Kurzstrecken."
    ],
    "en": [
      "Louis-Abel is a market gardener in biologic agriculture. He produces fresh seasonal vegetables, that he sells in local distribution channels."
    ],
    "it": [
      "Nei giardini di St Julien ci prendiamo cura della terra. Orto biologico, produzione di ortaggi freschi di stagione e commercializzazione in circuiti brevi."
    ],
    "fr": [
      "Aux jardins de St Julien, on prend soin de la terre. Maraîchage en Agriculture Biologique, production de légumes frais de saison et commercialisation en circuit-court."
    ],
    "nl": [
      "In de tuinen van St. Julien zorgen we voor de aarde. Biologische tuinbouw, productie van verse groenten in het seizoen en marketing in korte circuits."
    ],
    "es": [
      "En los jardines de St Julien, cuidamos la tierra. Huerta ecológica, producción de hortalizas frescas de temporada y comercialización en circuitos cortos."
    ]
  },
