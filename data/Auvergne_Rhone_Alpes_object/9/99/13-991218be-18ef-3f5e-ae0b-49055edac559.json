  "rdfs:comment": {
    "de": [
      "Das Museum ist der Sammlung von Skulpturen und Wandteppichen der heiligen Kunst von Esther und Felix Oudin gewidmet. Die Werke überraschen durch ihre Modernität und ermöglichen einen intimen Zugang zur sakralen Kunst, der auch für die Jüngsten geeignet ist."
    ],
    "en": [
      "The museum is dedicated to Esther and Félix Oudin's collection of sacred art sculptures and tapestries. The works are astonishingly modern, offering an intimate approach to sacred art that is suitable even for the youngest visitors."
    ],
    "it": [
      "Il museo è dedicato alla collezione di sculture e arazzi di arte sacra di Esther e Félix Oudin. Le opere sono sorprendentemente moderne e offrono un approccio intimo all'arte sacra, adatto anche ai visitatori più giovani."
    ],
    "fr": [
      "Le musée est dédié à la collection de sculptures et tapisseries d'arts sacrés d'Esther et Félix Oudin. Les œuvres étonnent par leur modernité et permettent une approche de l'art sacré intimiste et adaptée même aux plus jeunes."
    ],
    "nl": [
      "Het museum is gewijd aan de collectie heilige kunstbeelden en wandtapijten van Esther en Félix Oudin. De werken zijn verbazingwekkend modern en bieden een intieme benadering van heilige kunst die zelfs voor de jongste bezoekers geschikt is."
    ],
    "es": [
      "El museo está dedicado a la colección de esculturas y tapices de arte sacro de Esther y Félix Oudin. Las obras sorprenden por su modernidad y ofrecen un acercamiento íntimo al arte sacro apto incluso para los visitantes más jóvenes."
    ]
  },
