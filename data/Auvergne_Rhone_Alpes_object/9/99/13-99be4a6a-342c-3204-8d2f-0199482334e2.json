  "rdfs:comment": {
    "de": [
      "Die Comédie Triomphe empfängt Sie das ganze Jahr über von Freitag bis Sonntag. Komödien für alle Altersgruppen und Aufführungen für Kinder stehen auf dem Programm, in einer entspannten und geselligen Atmosphäre."
    ],
    "en": [
      "The Comédie Triomphe welcomes you all year round, from Friday to Sunday. Comedies for all audiences and shows for children are on the program, in a relaxed and friendly atmosphere."
    ],
    "it": [
      "La Comédie Triomphe è aperta tutto l'anno, dal venerdì alla domenica. Sono in programma commedie per tutti i pubblici e spettacoli per bambini, in un'atmosfera rilassata e amichevole."
    ],
    "fr": [
      "La Comédie Triomphe vous accueille toute l'année du vendredi au dimanche. Comédies tout public et spectacles pour enfants sont au programme, dans une ambiance détendue et conviviale."
    ],
    "es": [
      "La Comédie Triomphe está abierta todo el año, de viernes a domingo. Comedias para todos los públicos y espectáculos para niños forman parte de la programación, en un ambiente distendido y acogedor."
    ],
    "nl": [
      "De Comédie Triomphe is het hele jaar geopend, van vrijdag tot zondag. Er staan komedies voor alle doelgroepen en voorstellingen voor kinderen op het programma, in een ontspannen en vriendelijke sfeer."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Café-théâtre la Comédie Triomphe"
    ]
  },
