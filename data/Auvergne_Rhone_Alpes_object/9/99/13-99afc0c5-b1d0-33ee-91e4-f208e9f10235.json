  "rdfs:comment": {
    "de": [
      "Ihr Motto: Kurze Wege aufwerten und gleichzeitig eine kreative, leckere, verantwortungsvolle und saisonale Küche anbieten - das ist das Motto von Nadège und Laurent Hoarau."
    ],
    "en": [
      "Nadège and Laurent Hoarau?s motto is to promote short-distance distribution while offering creative, gourmet, responsible and seasonal cuisine."
    ],
    "it": [
      "Il loro motto: il motto di Nadège e Laurent Hoarau è quello di promuovere i canali di distribuzione brevi offrendo una cucina creativa, gustosa, responsabile e stagionale."
    ],
    "fr": [
      "Leur devise : Valoriser les circuits courts tout en proposant une cuisine créative, gourmande, responsable et de saison, c’est la devise de Nadège et Laurent Hoarau."
    ],
    "es": [
      "Su lema: El lema de Nadège y Laurent Hoarau es promover los canales cortos de distribución ofreciendo al mismo tiempo una cocina creativa, sabrosa, responsable y de temporada."
    ],
    "nl": [
      "Hun motto: Nadège en Laurent Hoarau's motto is om korte distributiekanalen te promoten en tegelijkertijd creatieve, smakelijke, verantwoorde en seizoensgebonden gerechten aan te bieden."
    ]
  },
  "rdfs:label": {
