  "rdfs:comment": {
    "de": [
      "Das Café des Allées ist eine Brauerei auf den Allées Provençales mitten in der Innenstadt von Montélimar. Carlo und Esteban begrüssen Sie in einem gemütlichen und gemütlichen Rahmen, für Ihr Abendessen in Liebe, Profi oder Freunde."
    ],
    "en": [
      "Le café des Allées is a brasserie on the Allées Provençales,in Montélimar town centre. You will get a warm reception from carlo and Esteban in a friendly setting, for an intimate dinner for two, a professional meeting or a meal with friends."
    ],
    "it": [
      "Il Café des Allées è una brasserie situata sulle Allées Provençales, proprio nel centro di Montélimar. Carlo e Nadège vi accolgono in un'atmosfera calda e amichevole, per le vostre cene romantiche o professionali, o per un incontro tra amici."
    ],
    "fr": [
      "Le Café des Allées est une brasserie située sur les allées provençales, en plein centre ville de Montélimar. Carlo et Nadège vous accueillent dans un cadre convivial et chaleureux, pour vos dîners en amoureux, professionnels ou entre amis."
    ],
    "nl": [
      "Het Café des Allées is een brasserie aan de Allées Provenales, in het centrum van Montélimar. Carlo en Esteban heten u welkom in een gezellige en hartelijke omgeving, voor een maaltijd met geliefden, met relaties of met vrienden."
    ],
    "es": [
      "El Café des Allées es una brasserie situada en las Allées Provençales, en pleno centro de Montélimar. Carlo y Nadège le dan la bienvenida en un ambiente cálido y acogedor, para sus cenas románticas o profesionales, o para una reunión con amigos."
    ]
  },
