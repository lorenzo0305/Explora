  "rdfs:comment": {
    "de": [
      "Bauernhof mit Mischkultur und Viehzucht in Noirétable.\r\nViehzucht (Schafe und Rinder), Pflanzenproduktion (Gemüse- und Getreideanbau), Verarbeitung von geernteten Produkten und bäuerliche Gastronomie, Unterkünfte (Gruppenunterkunft und Gite rural)."
    ],
    "en": [
      "Mixed-crop farm in Noirétable.\r\nAnimal husbandry (sheep and cattle), vegetable production (market gardening and cereals), processing of harvested produce and farm catering, accommodation (group gite and country gite)."
    ],
    "it": [
      "Azienda agricola mista a Noirétable.\r\nAllevamento di bestiame (ovini e bovini), produzione di ortaggi (ortaggi e cereali), trasformazione di frutta e verdura e ristorazione in azienda, alloggio (gite di gruppo e gite di campagna)."
    ],
    "fr": [
      "Ferme en polyculture élevage à Noirétable.\r\nActivité d'élevage (ovins et bovins), production végétale (maraichage et céréales), transformation de cueillette et activité de restauration paysanne, hébergements (gite de groupe et gite rural)."
    ],
    "nl": [
      "Gemengd landbouwbedrijf in Noirétable.\r\nVeehouderij (schapen en runderen), groenteteelt (tuinbouw en granen), verwerking van groenten en fruit en boerderijcatering, accommodatie (groepsgite en plattelandsgite)."
    ],
    "es": [
      "Explotación agrícola mixta en Noirétable.\r\nGanadería (ovina y bovina), producción hortícola (huerta y cereales), transformación de frutas y verduras y restauración en granja, alojamiento (casa rural y casa rural para grupos)."
    ]
  },
