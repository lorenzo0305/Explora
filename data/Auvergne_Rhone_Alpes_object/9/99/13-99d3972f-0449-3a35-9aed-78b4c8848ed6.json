  "rdfs:comment": {
    "de": [
      "Eltern-Kind-Workshop mit dem Chefkoch Gilles Roux: Kreieren Sie gemeinsam Cakes und kleine Kuchen! Von 15:00 bis 18:00 Uhr teilen Sie einen komplizierten und leckeren Moment. Ideal, um die Freude am Kochen zu vermitteln. 70? pro Duo. Reservierung: 04 71 66 86 66."
    ],
    "en": [
      "Parent-child workshop with Chef Gilles Roux: create cakes and cupcakes together! From 3pm to 6pm, share a moment of complicity and indulgence. Ideal for passing on the pleasure of cooking. 70? per duo. Booking: 04 71 66 86 66."
    ],
    "it": [
      "Laboratorio per genitori e figli con lo chef Gilles Roux: create insieme torte e cupcake! Dalle 15.00 alle 18.00, condividete un momento di divertimento e piacere. Ideale per trasmettere il piacere della cucina. 70? a coppia. Prenotazioni: 04 71 66 86 66."
    ],
    "fr": [
      "Atelier parent-enfant avec le Chef Gilles Roux : créez ensemble cakes et petits gâteaux ! De 15h à 18h, partagez un moment complice et gourmand. Idéal pour transmettre le plaisir de cuisiner. 70€ le duo. Réservation : 04 71 66 86 66."
    ],
    "nl": [
      "Workshop voor ouders en kinderen met chef-kok Gilles Roux: maak samen taarten en cupcakes! Van 15.00 tot 18.00 uur, deel een moment van plezier en genot. Ideaal om het plezier van koken door te geven. 70? per duo. Reserveren: 04 71 66 86 66."
    ],
    "es": [
      "Taller para padres e hijos con el Chef Gilles Roux: ¡cread pasteles y cupcakes juntos! De 15:00 a 18:00, comparta un momento de diversión y placer. Ideal para transmitir el placer de cocinar. 70? por dúo. Reservas: 04 71 66 86 66."
    ]
  },
  "rdfs:label": {
    "fr": [
