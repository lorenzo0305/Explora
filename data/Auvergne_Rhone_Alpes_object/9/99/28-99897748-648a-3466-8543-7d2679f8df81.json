  "rdfs:comment": {
    "de": [
      "Entlang des Ufers des Flusses \"Thérain\" wurden Wege für Fußgänger und Radfahrer angelegt, die den Kreisverkehr \"Les Forges\" mit dem Park \"Le Prieuré\" verbinden."
    ],
    "en": [
      "Paths have been created for pedestrians and cyclists along the banks of the river \"Thérain\", linking the Forges roundabout to the Priory Park."
    ],
    "it": [
      "Sono stati creati percorsi pedonali e ciclabili lungo le rive del fiume \"Thérain\", che collegano la rotatoria di Forges al Priory Park."
    ],
    "fr": [
      "Des sentiers ont été aménagés pour les piétons et les cyclistes le long des berges de la rivière \"Thérain\", reliant le rond-point des Forges au parc du Prieuré."
    ],
    "es": [
      "Se han creado senderos para peatones y ciclistas a lo largo de las orillas del río \"Thérain\", que unen la rotonda de Forges con el parque del Priorato."
    ],
    "nl": [
      "Er zijn voetpaden aangelegd voor voetgangers en fietsers langs de oevers van de \"Thérain\", die de rotonde van de Smederijen verbinden met het Priorij Park."
    ]
  },
