  "rdfs:comment": {
    "de": [
      "Tauchen Sie zwischen Sport, Entspannung und Wellness in die entspannende Atmosphäre von Forme d'O ein. Das im Zentrum des Dorfes gelegene Wassersportzentrum empfängt Sie das ganze Jahr über und lädt Sie ein, seine drei Bereiche zu entdecken."
    ],
    "en": [
      "Enjoy the relaxing ambience of Forme d’O, between sport and well-being. Located in the centre of the village, the water park is open all year round and invites you to discover its three areas."
    ],
    "it": [
      "Tra sport, relax e benessere, immergetevi nella rilassante atmosfera di Forme d'O. Situato nel centro del paese, il centro acquatico vi accoglie tutto l'anno e vi invita a scoprire le sue tre aree."
    ],
    "fr": [
      "Entre sport, détente et bien-être, immergez-vous dans l’ambiance relaxante de Forme d’O. Situé au centre du village, le centre aquatique vous accueille toute l'année et vous invite à découvrir ses trois espaces."
    ],
    "es": [
      "Entre el deporte, la relajación y el bienestar, sumérjase en el ambiente relajante de Forme d'O. Situado en el centro del pueblo, el centro acuático le da la bienvenida todo el año y le invita a descubrir sus tres áreas."
    ],
    "nl": [
      "Een mix van sport, ontspanning en welzijn, dompel u onder in de ontspannen sfeer van Forme d'O. Gelegen in het centrum van het dorp, verwelkomt het zwembad u het hele jaar door en nodigt u uit om de drie verschillende ruimtes te ontdekken."
    ]
  },
  "rdfs:label": {
    "de": [
      "Das Schwimmbad Forme d'O"
    ],
    "en": [
      "The aquatic centre Forme d'O"
    ],
    "fr": [
      "Le centre aquatique Forme d'O"
    ],
    "nl": [
      "Het zwembad Forme d'O"
    ]
  },
