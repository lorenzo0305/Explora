  "rdfs:comment": {
    "de": [
      "Der Lions Club Valence Deux Rives organisiert eine Ausstellung für bildende Künstler zugunsten der Kinderkrebshilfe. Die Ausstellung ist offen für 15 Künstler, die Gemälde und Skulpturen verschiedener Stilrichtungen und Persönlichkeiten präsentieren."
    ],
    "en": [
      "Lions Club Valence Deux Rives is organizing an exhibition dedicated to visual artists, in aid of childhood cancer. The exhibition is open to some fifteen artists, combining paintings and sculptures in a variety of styles and personalities."
    ],
    "it": [
      "Il Lions Club Valence Deux Rives organizza una mostra dedicata agli artisti visivi, a favore del cancro infantile. Vi parteciperanno una quindicina di artisti, che combineranno dipinti e sculture in una varietà di stili e con diverse personalità."
    ],
    "fr": [
      "Lions Club Valence Deux Rives organise une exposition dédiée aux artistes plasticiens, au profit de du cancer infantile. Elle est ouverte à une quinzaine d’artistes mêlant toiles et sculptures de styles et de personnalités diverses."
    ],
    "nl": [
      "Lions Club Valence Deux Rives organiseert een tentoonstelling gewijd aan beeldende kunstenaars, ten voordele van kanker bij kinderen. Zo'n vijftien kunstenaars doen mee en combineren schilderijen en beeldhouwwerken in verschillende stijlen en met verschillende persoonlijkheden."
    ],
    "es": [
      "El Lions Club Valence Deux Rives organiza una exposición dedicada a los artistas plásticos, en beneficio del cáncer infantil. Participarán una quincena de artistas que combinarán pinturas y esculturas de estilos variados y personalidades diferentes."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Exposition de peintures et de sculptures - Arts Trocs et Passions"
    ]
  },
