  "rdfs:comment": {
    "de": [
      "Technische Enduro-Route, die von der Route des Narces zum Eingang der Méaudret-Schlucht führt. Achtung, von dieser technischen Route wird bei nassen Bedingungen dringend abgeraten."
    ],
    "en": [
      "Technical enduro route leading from the Narces road to the entrance to the Méaudret gorges. Caution: this technical route is not recommended in wet conditions."
    ],
    "it": [
      "Un percorso tecnico di enduro che conduce dalla strada di Narces all'ingresso delle gole di Méaudret. Attenzione: questo percorso tecnico è sconsigliato in caso di pioggia."
    ],
    "fr": [
      "Itinéraire enduro technique qui permet de rejoindre l'entrée des gorges du Méaudret à partir de la route des Narces. Attention, cet itinéraire technique est fortement déconseillé en conditions humides."
    ],
    "es": [
      "Recorrido técnico de enduro que va desde la carretera de Narces hasta la entrada de las gargantas de Méaudret. Atención: este recorrido técnico no se recomienda en condiciones de humedad."
    ],
    "nl": [
      "Een technische enduro-route die van de Narces-weg naar de ingang van de Méaudret-kloven leidt. Waarschuwing: deze technische route wordt niet aanbevolen in natte omstandigheden."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Picasso - Spéciale VTT Enduro - Rouge"
    ]
  },
