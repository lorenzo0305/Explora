  "rdfs:comment": {
    "de": [
      "Professioneller Angeltrainer/-führer seit 1999. Ich biete Einführungskurse, Fortgeschrittenenkurse und geführte Aufenthalte zum Fliegenfischen auf Strecken an, die aufgrund ihrer fischereilichen und fischökologischen Qualitäten ausgewählt wurden."
    ],
    "en": [
      "Professional fishing instructor/guide since 1999. I offer introductory, advanced and guided fly-fishing courses, on courses selected for their halieutic and piscicultural qualities."
    ],
    "it": [
      "Istruttore/guida di pesca professionista dal 1999. Offro corsi introduttivi, corsi avanzati e vacanze guidate di pesca a mosca, su itinerari selezionati per le loro qualità ittiche e piscicole."
    ],
    "fr": [
      "Moniteur/ guide de pêche professionnel depuis 1999. Je propose des stages d'initiation, de perfectionnement et des séjours guidés de pêche à la mouche, sur des parcours sélectionnés pour leurs qualités halieutiques et piscicoles."
    ],
    "nl": [
      "Professionele visinstructeur/gids sinds 1999. Ik bied cursussen voor beginners en gevorderden en vliegvisvakanties met gids, op routes die zijn uitgekozen vanwege hun vis- en vangstkwaliteiten."
    ],
    "es": [
      "Monitor/guía de pesca profesional desde 1999. Ofrezco cursos de iniciación, perfeccionamiento y vacaciones guiadas de pesca con mosca, en rutas seleccionadas por sus cualidades pesqueras y piscícolas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Moniteur-Guide de pêche à la mouche | Thierry Millot"
    ]
  },
