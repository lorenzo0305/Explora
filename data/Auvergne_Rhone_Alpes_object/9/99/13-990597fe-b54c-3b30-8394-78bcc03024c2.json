  "rdfs:comment": {
    "de": [
      "Nehmen Sie sich eine Auszeit und genießen Sie eine Küche, in der die Produkte der Region im Mittelpunkt stehen und mit Sorgfalt zur Geltung gebracht werden."
    ],
    "en": [
      "Take the time to take a break and come enjoy a cuisine where the products of the region are honored and highlighted with care."
    ],
    "it": [
      "Fate una pausa e godetevi una cucina in cui i prodotti della regione sono valorizzati e messi in risalto con cura."
    ],
    "fr": [
      "Prenez le temps de faire une pause et venez profiter d’une cuisine où les produits de la région sont à l’honneur et mis en valeur avec soin."
    ],
    "es": [
      "Tómese un respiro y disfrute de una cocina en la que los productos de la región son honrados y destacados con esmero."
    ],
    "nl": [
      "Neem een pauze en geniet van een keuken waarin regionale producten in ere worden gehouden en zorgvuldig worden belicht."
    ]
  },
