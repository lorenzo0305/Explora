  "rdfs:comment": {
    "de": [
      "Das ist neu! Fachleute, Therapeuten, verschiedene Anbieter benötigen einen Ort, um Ihre Sitzungen oder Gruppenaktivitäten durchzuführen? La Vie d'Ance stellt Ihnen einen 100 m2 großen Raum zur Verfügung."
    ],
    "en": [
      "New! Professionals, therapists, various service providers, need a place to hold your meetings or group activities? La Vie d'Ance offers you 100 m2 of space."
    ],
    "it": [
      "Nuovo! Professionisti, terapeuti, fornitori di servizi vari, avete bisogno di un luogo dove tenere le vostre riunioni o attività di gruppo? La Vie d'Ance vi offre 100 m2 di spazio."
    ],
    "fr": [
      "Nouveauté ! Professionnels, thérapeutes, prestataires divers, besoin d'un lieu pour réaliser vos réunions ou activités de groupe ? La Vie d'Ance met à votre disposition un espace de 100 m2."
    ],
    "es": [
      "Novedad Profesionales, terapeutas, proveedores de servicios diversos, ¿necesitan un lugar para celebrar sus reuniones o actividades de grupo? La Vie d'Ance le ofrece 100 m2 de espacio."
    ],
    "nl": [
      "Nieuw! Professionals, therapeuten, diverse dienstverleners, een plek nodig om je vergaderingen of groepsactiviteiten te houden? La Vie d'Ance biedt je 100 m2 ruimte."
    ]
  },
  "rdfs:label": {
