  "rdfs:comment": {
    "de": [
      "Traditionelle Küche… hausgemacht!\r\n\r\nMit einer Speisekarte, die je nach Jahreszeit variiert"
    ],
    "en": [
      "At Jeanne's kitchen, we offer top-quality dishes made with local, seasonal produce every day from Tuesday lunchtime to Saturday evening.\r\n\r\nTraditional cuisine... homemade!\r\nWith a seasonal menu."
    ],
    "it": [
      "La Cuisine de Jeanne propone ogni giorno, dal martedì a pranzo al sabato sera, piatti di alta qualità preparati con prodotti locali e di stagione.\r\nCucina tradizionale? Fatta in casa!\r\nIl nostro menu cambia con le stagioni."
    ],
    "fr": [
      "Chez la cuisine de Jeanne, nous proposons des plats d'excellente qualité avec des produits locaux et de saison chaque jour du mardi midi au samedi soir.\r\nCuisine traditionnelle… Fait maison !\r\nAvec une carte variant selon les saisons."
    ],
    "es": [
      "En La Cuisine de Jeanne, servimos platos de calidad elaborados con productos locales de temporada todos los días, de martes a mediodía a sábado por la noche.\r\n¿Cocina tradicional? ¡Casera!\r\nNuestra carta cambia con las estaciones."
    ],
    "nl": [
      "Bij La Cuisine de Jeanne serveren we elke dag van dinsdagmiddag tot zaterdagavond gerechten van topkwaliteit met lokale, seizoensgebonden producten.\r\n\r\nTraditionele keuken... huisgemaakt!\r\nOns menu verandert met de seizoenen."
    ]
  },
