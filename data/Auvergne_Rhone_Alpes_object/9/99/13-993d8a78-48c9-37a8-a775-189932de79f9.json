  "rdfs:comment": {
    "de": [
      "Sophie Rabot, Keramikhandwerkerin, begrüßt Sie in der Poterie de Queuille.\r\nSie können den Laden entdecken, in dem Gebrauchs-, Koch- und Dekorationskeramik ausgestellt wird."
    ],
    "en": [
      "Sophie Rabot, artisan ceramist potter, welcomes you to the Poterie de Queuille. \r\nYou will be able to discover the shop where utilitarian, culinary and decorative pottery is exposed."
    ],
    "it": [
      "Sophie Rabot, artigiana ceramista, vi dà il benvenuto alla Poterie de Queuille. È possibile visitare il negozio, dove sono esposte ceramiche utilitarie, culinarie e decorative.\r\n\r\nLaboratori introduttivi alla modellazione e alla lavorazione. Lezioni di tornitura."
    ],
    "fr": [
      "Sophie Rabot, artisan céramiste, vous accueille à la Poterie de Queuille. Vous pourrez découvrir la boutique où sont exposées les poteries utilitaires, culinaires et décoratives.\r\n\r\nAteliers initiation modelage et tournage. Cours de tournage."
    ],
    "es": [
      "Sophie Rabot, ceramista artesana, le da la bienvenida a la Poterie de Queuille. Puede visitar la tienda, donde se expone la cerámica utilitaria, culinaria y decorativa.\r\n\r\nTalleres de iniciación al modelado y a la fundición. Clases de torneado."
    ],
    "nl": [
      "Sophie Rabot, ambachtelijk keramiste, heet je welkom in de Poterie de Queuille. Je kunt de winkel bezoeken, waar het gebruiks-, culinaire en decoratieve aardewerk wordt tentoongesteld.\r\n\r\nInleidende workshops boetseren en gooien. Draailessen."
    ]
  },
  "rdfs:label": {
    "en": [
      "Poterie de Queuille"
    ],
    "fr": [
      "Poterie de Queuille"
    ]
  },
