  "rdfs:comment": {
    "de": [
      "Das Restaurant Au Pré du Lac liegt am Ufer des majestätischen großen Sees von Laffrey und lädt Sie dazu ein, eine traditionelle und authentische Küche mit Aromen aus allen vier Ecken der Welt auf der Grundlage lokaler Produkte wiederzuentdecken."
    ],
    "en": [
      "By Laffrey's lake, with a breathtaking view over the Grand Serre, cooking with fresh and local products, home made and traditional cuisine."
    ],
    "it": [
      "Situato sul bordo del maestoso grande lago di Laffrey, il ristorante \"Au Pré du Lac\" vi invitta a riscoprire la cucina tradizionale e autentica con i sapori dei 4 angoli del mondo, a base di prodotti locali."
    ],
    "fr": [
      "Situé en bordure du majestueux grand lac de Laffrey, le restaurant Au Pré du Lac vous invite à redécouvrir une cuisine traditionnelle et authentique aux saveurs des 4 coins du monde, à base de produits locaux."
    ],
    "es": [
      "Situado a orillas del majestuoso Lac de Laffrey, el restaurante Au Pré du Lac le invita a redescubrir la cocina tradicional y auténtica con sabores de los 4 rincones del mundo, utilizando productos locales."
    ],
    "nl": [
      "Op de oever van het meer van Laffrey met een prachtig zich op de bergtop van de \"Grand Serre\". Huisbereide, traditionele, streekgerechten."
    ]
  },
