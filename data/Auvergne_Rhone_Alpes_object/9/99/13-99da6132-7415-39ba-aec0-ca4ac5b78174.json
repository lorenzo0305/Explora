  "rdfs:comment": {
    "de": [
      "La Belle Epoque besticht durch ein Pariser Brasserieambiente und einen nostalgischen und zugleich modernen Stil. Nutzen Sie unsere sonnige, schattige und beheizte Terrasse für Frühstück, Mittagessen oder Apertif mit Freunden oder der Familie von 7 bis 20 Uhr. Der Küchenchef Thierry Buttay und sein Team verwöhnen Sie mit einer traditionellen und kreativen Küche, hausgemachten Speisen und Desserts."
    ],
    "en": [
      "La Belle Epoque welcomes you into a Parisian brasserie atmosphere, in a retro and contemporary style. Enjoy its sunny terrace, shaded and heated during breakfast, lunch and evening drinks, among family or friends from 7am to 8pm. The chef Thierry Buttay and his team have the pleasure of offering you traditional and creative cuisine, with home-made dishes and puddings."
    ],
    "it": [
      "La Belle Epoque vi accoglie in un'atmosfera da Brasserie parigina, in uno stile retrò e contemporaneo. Lo chef Thierry Buttay e il suo team sono lieti di offrirvi una cucina tradizionale e creativa, piatti e dessert fatti in casa."
    ],
    "fr": [
      "La Belle Epoque vous accueille dans une ambiance Brasserie Parisienne, un style rétro et contemporain. Le Chef Thierry Buttay et son équipe ont le plaisir de vous faire déguster sa cuisine traditionnelle et créative, ses plats et desserts fait maison."
    ],
    "nl": [
      "La Belle Epoque verwelkomt u in een Parijse Brasserie sfeer, een retro en hedendaagse stijl. Chef Thierry Buttay en zijn team bieden u graag hun traditionele en creatieve keuken, huisgemaakte gerechten en desserts."
    ],
    "es": [
      "La Belle Epoque le acoge en un ambiente de brasserie parisina, de estilo retro y contemporáneo. El chef Thierry Buttay y su equipo se complacen en ofrecerle una cocina tradicional y creativa, platos caseros y postres."
    ]
  },
