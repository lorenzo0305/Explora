  "rdfs:comment": {
    "de": [
      "Entdecken Sie die erste Ausgabe der Europäischen Tage des Kunsthandwerks in den Baronnies in der Drôme Provençale! Eine Begegnung mit dem lokalen Kunsthandwerk zwischen Tradition und Innovation."
    ],
    "en": [
      "Discover the first edition of the Journées européennes des métiers d?art in the Baronnies region of Drôme Provençale! An encounter with local craftsmanship, between tradition and innovation."
    ],
    "it": [
      "Scoprite la prima edizione delle Journées européennes des métiers d'art nelle Baronnies, nella Drôme Provençale! Un'occasione per incontrare gli artigiani locali, coniugando tradizione e innovazione."
    ],
    "fr": [
      "Découvrez la première édition des Journées européennes des métiers d’art dans les Baronnies en Drôme Provençale ! Une rencontre avec l’artisanat local, entre tradition et innovation."
    ],
    "nl": [
      "Ontdek de eerste editie van de Journées européennes des métiers d'art in de Baronnies in Drôme Provençale! Een kans om lokale ambachtslieden te ontmoeten, die traditie en innovatie combineren."
    ],
    "es": [
      "Descubra la primera edición de las Journées européennes des métiers d'art en las Baronnies, en Drôme Provençale Una oportunidad para conocer a los artesanos locales, que combinan tradición e innovación."
    ]
  },
