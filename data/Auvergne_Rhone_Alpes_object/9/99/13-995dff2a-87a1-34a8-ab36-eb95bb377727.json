  "rdfs:comment": {
    "de": [
      "La Grange à Gaby ist ein Etappenquartier für 19 Personen, ein Spielcafé/Kulturbistro (jeden Freitagabend Unterhaltung/Show), kreative Küche (50 Gedecke), Lebensmittelgeschäft für Notfälle, lokale Produkte, Brotverkauf, Bereich für lokales Kunsthandwerk."
    ],
    "en": [
      "La Grange à Gaby is a gite d'étape with a capacity of 19 people, a café des jeux/cultural bistro (entertainment/show every Friday evening), creative cuisine (50 covers), convenience store, local products, bread depot, local crafts area."
    ],
    "it": [
      "La Grange à Gaby è una casa vacanze con una capacità di 19 persone, un caffè-gioco/bistrot culturale (intrattenimento/spettacolo ogni venerdì sera), cucina creativa (50 coperti), minimarket, prodotti locali, deposito di pane, area di artigianato locale."
    ],
    "fr": [
      "La Grange à Gaby est un gite d'étape d'une capacité de 19 pers, un café des jeux/bistrot culturel (animation/spectacle tous les vendredis soir), cuisine créative (50 couverts), épicerie de dépannage, produits locaux, dépôt de pain, espace artisanat local."
    ],
    "nl": [
      "La Grange à Gaby is een gite met een capaciteit van 19 personen, een spelletjescafé/culturele bistro (animatie/voorstelling elke vrijdagavond), creatieve keuken (50 couverts), buurtwinkel, streekproducten, brooddepot, lokale ambachtsruimte."
    ],
    "es": [
      "La Grange à Gaby es una casa rural con capacidad para 19 personas, un café de juegos/bistro cultural (entretenimiento/espectáculo todos los viernes por la noche), cocina creativa (50 cubiertos), tienda de comestibles, productos locales, depósito de pan, zona de artesanía local."
    ]
  },
  "rdfs:label": {
    "fr": [
      "\"La Grange à Gaby\" Café des jeux - Bistrot culturel - Gite d'étape - Epicerie de dépannage - Cuisine créative et brunch"
    ]
  },
