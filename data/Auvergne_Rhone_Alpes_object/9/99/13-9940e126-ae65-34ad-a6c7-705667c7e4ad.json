  "rdfs:comment": {
    "de": [
      "Nunayak öffnet seine Türen im Haut-Giffre-Tal in Sixt-Fer-à-Cheval. Entdecken Sie unsere Aktivitäten im Wasser und in der Natur, im Sommer wie im Winter: Rafting, Canyoning, Klettersteig, Hydrospeed, Canoraft, Schneeschuhwandern, E-Fat-Scooter"
    ],
    "en": [
      "Nunayak opens its doors to you in the Haut-Giffre valley at Sixt-Fer-à-Cheval. Discover our white-water and outdoor activities, summer and winter alike: rafting, canyoning, via ferrata, hydrospeed, canoraft, snowshoeing, e-fat scoot..."
    ],
    "it": [
      "Nunayak vi apre le sue porte nella valle dell'Haut-Giffre a Sixt-Fer-à-Cheval. Scoprite le nostre attività in acqua bianca e all'aperto in estate e in inverno: rafting, canyoning, via ferrata, hydrospeed, canoraft, racchette da neve, e-fat scooter, ecc"
    ],
    "fr": [
      "Nunayak vous ouvre ses portes dans la vallée du Haut-Giffre à Sixt-Fer-à-Cheval. Découvrez nos activités d’eau-vive et de pleine nature, été comme hiver : rafting, canyoning, via ferrata, hydrospeed, canoraft, raquettes, e-fat scoot"
    ],
    "nl": [
      "Nunayak opent haar deuren voor jou in de vallei van de Haut-Giffre in Sixt-Fer-à-Cheval. Ontdek onze wildwater- en outdooractiviteiten in zomer en winter: raften, canyoning, via ferrata, hydrospeed, canoraft, sneeuwschoenwandelen, e-fatscooters, enz."
    ],
    "es": [
      "Nunayak le abre sus puertas en el valle del Haut-Giffre, en Sixt-Fer-à-Cheval. Descubra nuestras actividades en aguas bravas y al aire libre en verano e invierno: rafting, barranquismo, vía ferrata, hidrospeed, canoraft, raquetas de nieve, e-fat scooters, etc"
    ]
  },
