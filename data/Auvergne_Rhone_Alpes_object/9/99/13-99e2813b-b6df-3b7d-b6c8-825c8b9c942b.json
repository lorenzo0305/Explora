  "rdfs:comment": {
    "de": [
      "Ihre Mediathek Césaire empfängt Sie im Herzen des Viertels Reyssouze, nur wenige Schritte vom Kino L'Amphi und dem Champ de foire entfernt, in einer warmen und freundlichen Umgebung."
    ],
    "en": [
      "Your Césaire multimedia library is located in the heart of the Reyssouze district, a stone's throw from the L'Amphi cinema and the Champ de foire, in a warm and friendly setting."
    ],
    "it": [
      "La vostra mediateca Césaire vi accoglie nel cuore del quartiere Reyssouze, a due passi dal cinema L'Amphi e dal Champ de Foire, in un ambiente caldo e accogliente."
    ],
    "fr": [
      "Votre médiathèque Césaire vous accueille en plein cœur du quartier de la Reyssouze, à deux pas du cinéma L'Amphi et du Champ de foire, dans un cadre chaleureux et convivial."
    ],
    "nl": [
      "Uw mediatheek Césaire ontvangt u in het hart van de wijk Reyssouze, op een steenworp afstand van de bioscoop L'Amphi en de Champ de Foire, in een warm en vriendelijk kader."
    ],
    "es": [
      "Su mediateca Césaire le acoge en el corazón del barrio de Reyssouze, a dos pasos del cine L'Amphi y del Champ de Foire, en un ambiente cálido y acogedor."
    ]
  },
