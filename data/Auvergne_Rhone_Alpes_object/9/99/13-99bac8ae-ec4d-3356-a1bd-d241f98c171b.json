  "rdfs:comment": {
    "de": [
      "Eine biologische Seifenfabrik im Herzen der Drôme. Gaiia befreit die Haut und die Natur mit ihren natürlichen und biologischen Kaltseifen und Balsamen von jeglichen petrochemischen Stoffen. Machen Sie bei Ihrem Besuch einen kurzen Besuch ohne Reservierung in der Seifenfabrik."
    ],
    "en": [
      "An organic soap factory in the heart of the Drôme. Gaiia frees skin and nature from petrochemicals with natural, organic cold process soaps and balms. Take a quick, no-reservations tour of the soap factory when you visit."
    ],
    "it": [
      "Un saponificio biologico nel cuore della Drôme. Gaiia libera la pelle e la natura dai prodotti petrolchimici con i suoi saponi e balsami naturali e biologici lavorati a freddo. Fate una rapida visita al saponificio senza prenotazione."
    ],
    "fr": [
      "Une savonnerie biologique en plein cœur de la Drôme. Gaiia libère la peau et la nature de toute présence pétrochimique avec des savons à froid et des baumes naturels et bio. Faites une visite rapide sans réservation de la savonnerie lors de votre passage."
    ],
    "es": [
      "Una fábrica de jabón ecológico en el corazón de la Drôme. Gaiia libera la piel y la naturaleza de la petroquímica con sus jabones y bálsamos naturales y ecológicos elaborados en frío. Visite la fábrica de jabón sin reserva previa."
    ],
    "nl": [
      "Een biologische zeepfabriek in het hart van de Drôme. Gaiia bevrijdt de huid en de natuur van petrochemische stoffen met haar natuurlijke, biologische koud verwerkte zepen en balsems. Neem een snelle rondleiding door de zeepfabriek zonder te reserveren wanneer je langskomt."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Savonnerie Gaiia – Visite de l’entreprise"
    ]
  },
