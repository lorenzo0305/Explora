  "rdfs:comment": {
    "de": [
      "Le Dôme, im Herzen der Bistronomie. Bistronomisches Restaurant, Cocktailbar und Teesalon. Privatisierung, Veranstaltungen und Seminare. Neuheit 2026: Le Dôme öffnet seine Brasserie, großzügige und gesellige Küche."
    ],
    "en": [
      "Le Dôme, at the heart of bistronomy. Bistronomic restaurant, cocktail bar and tea room. Private events and seminars. New in 2026: Le Dôme opens its brasserie, offering generous, convivial cuisine."
    ],
    "it": [
      "Le Dôme, nel cuore della bistronomia. Ristorante bistronomico, cocktail bar e sala da tè. Noleggio privato, eventi e seminari. Novità 2026: Le Dôme apre la sua brasserie, che offre una cucina generosa e conviviale."
    ],
    "fr": [
      "Le Dôme, au cœur de la bistronomie. Restaurant bistronomique, bar à cocktails et salon de thé. Privatisation, évènements et séminaires. Nouveauté 2026 : Le Dôme ouvre sa brasserie, cuisine généreuse et conviviale."
    ],
    "nl": [
      "Le Dôme, in het hart van de bistronomie. Bistronomisch restaurant, cocktailbar en tearoom. Privéverhuur, evenementen en seminars. Nieuw in 2026: Le Dôme opent zijn brasserie met een royale en gezellige keuken."
    ],
    "es": [
      "Le Dôme, en el corazón de la bistronomía. Restaurante bistronómico, bar de cócteles y salón de té. Alquiler privado, eventos y seminarios. Novedad para 2026: Le Dôme abre su brasserie, que ofrece una cocina generosa y acogedora."
    ]
