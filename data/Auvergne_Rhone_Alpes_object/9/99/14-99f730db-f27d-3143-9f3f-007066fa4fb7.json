  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/18321baf-75b3-3295-9af5-b138c7f252ea",
      "dc:description": {
        "de": [
          "Butter, Käse, Ziegenkäse, Quark & Fässer.\nFinden Sie die Produkte im Direktverkauf auf dem Bauernhof und auf den Märkten von Le Touquet-Paris-Plage und Montreuil-sur-Mer."
        ],
        "en": [
          "Butter, cheeses, goat's cheeses, fromage blanc & faisselles.\nYou can buy our products direct from the farm and at markets in Le Touquet-Paris-Plage and Montreuil-sur-Mer."
        ],
        "it": [
          "Burro, formaggi, formaggi di capra, fromage frais e faisselles.\nPotete acquistare i nostri prodotti direttamente in azienda e nei mercati di Le Touquet-Paris-Plage e Montreuil-sur-Mer."
        ],
        "fr": [
          "Beurre, fromages, fromages de chèvre, fromages blancs & faisselles.\nRetrouvez les produits en vente directe à la ferme et sur les marchés du Touquet-Paris-Plage et de Montreuil-sur-Mer."
        ],
        "es": [
          "Mantequilla, quesos, quesos de cabra, fromage frais & faisselles.\nPuede comprar nuestros productos directamente en la granja y en los mercados de Le Touquet-Paris-Plage y Montreuil-sur-Mer."
        ],
        "nl": [
          "Boter, kazen, geitenkazen, fromage frais & faisselles.\nJe kunt deze producten rechtstreeks van de boerderij kopen en op de markten in Le Touquet-Paris-Plage en Montreuil-sur-Mer."
        ]
      },
      "@type": [
        "Description"
