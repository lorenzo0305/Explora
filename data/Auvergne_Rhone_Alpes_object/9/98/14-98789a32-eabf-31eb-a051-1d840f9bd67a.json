      "@id": "https://data.datatourisme.fr/0e8eb576-c581-3d58-af7e-516ae8866835",
      "dc:description": {
        "de": [
          "Concept-Store, Dekorationsgegenstände, Wäsche, Geschenkideen, Damenbekleidung, Accessoires und Modeschmuck.\n\nGeöffnet von 10:30 bis 12:30 Uhr und von 15:00 bis 19:00 Uhr."
        ],
        "en": [
          "Concept-store, decorative objects, linens, gift ideas, women's clothing, accessories and costume jewelry.\n\nOpen from 10.30am to 12.30pm and from 3pm to 7pm."
        ],
        "it": [
          "Concept store, oggetti decorativi, biancheria, idee regalo, abbigliamento femminile, accessori e bigiotteria.\n\nAperto dalle 10.30 alle 12.30 e dalle 15.00 alle 19.00."
        ],
        "fr": [
          "Concept-store, objets de décoration, linge, idées cadeaux, vêtements femme, accessoires et bijoux fantaisie.\n\nOuvert de 10h30 à 12h30 et de 15h00 à 19h00."
        ],
        "nl": [
          "Conceptwinkel, decoratieve objecten, linnengoed, cadeau-ideeën, dameskleding, accessoires en kostuumjuwelen.\n\nOpen van 10.30 tot 12.30 uur en van 15.00 tot 19.00 uur."
        ],
        "es": [
          "Concept store, objetos de decoración, ropa blanca, ideas para regalos, ropa de mujer, accesorios y bisutería.\n\nAbierto de 10.30 a 12.30 y de 15.00 a 19.00 h."
        ]
      },
