  "rdfs:comment": {
    "de": [
      "Traditionelle und familiäre Küche. Alles hausgemacht. Mittags bietet Ihnen Brigitte ein Tagesmenü an, bei dem möglichst viele frische Produkte verwendet werden. Geselligkeit und gute Laune sind Pflicht."
    ],
    "en": [
      "Local and traditionnal cooking."
    ],
    "it": [
      "Cucina tradizionale e familiare. Fatto in casa. A pranzo, Brigitte propone un menu del giorno con un massimo di prodotti freschi. Convivialità e buon umore sono d'obbligo."
    ],
    "fr": [
      "Cuisine traditionnelle et familiale. Fait maison. Le midi Brigitte vous propose sa formule menu du jour avec comme charte un maximum de produits frais. Convivialité et bonne humeur sont de rigueur."
    ],
    "nl": [
      "Traditionele en familiale keuken. Zelfgemaakt. Tussen de middag biedt Brigitte een dagmenu met een maximum aan verse producten. Gezelligheid en een goed humeur zijn een must."
    ],
    "es": [
      "Cocina tradicional familiar. Casera. A mediodía, Brigitte le propone un menú del día, con un máximo de productos frescos. La convivencia y el buen humor están a la orden del día."
    ]
  },
  "rdfs:label": {
