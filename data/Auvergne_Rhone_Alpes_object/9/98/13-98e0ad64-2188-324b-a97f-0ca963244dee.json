  "rdfs:comment": {
    "de": [
      "Der Golf de la Valette liegt perfekt auf 1000 m Höhe mit idealer Sonneneinstrahlung und empfängt Sie das ganze Jahr über, damit Sie sich in der einzigartigen Umgebung einer authentischen und geschützten Natur im Herzen des Cantal und des Aubrac entspannen können."
    ],
    "en": [
      "Perfectly situated, at 1000 metres altitude, with ideal sunshine, the Golf de la Valette welcomes you all year round, to relax in the unique setting of an authentic and protected nature in the heart of the Cantal and Aubrac."
    ],
    "it": [
      "Perfettamente situato a 1.000 metri di altitudine, con un'insolazione ideale, il Golf de la Valette vi accoglie tutto l'anno per rilassarvi in un contesto unico di campagna autentica e protetta, nel cuore delle regioni del Cantal e dell'Aubrac."
    ],
    "fr": [
      "Parfaitement situé, à 1000 mètres d’altitude, avec un ensoleillement  idéal, le Golf de la Valette vous accueille toute l’année, pour se détendre dans le cadre unique d’une nature authentique et  protégée au cœur du Cantal et de l’Aubrac."
    ],
    "es": [
      "Perfectamente situado a 1.000 metros de altitud, con una insolación ideal, el Golf de la Valette le acoge todo el año para relajarse en un marco único de auténtico campo protegido, en el corazón de las regiones de Cantal y Aubrac."
    ],
    "nl": [
      "Perfect gelegen op 1000 meter hoogte, met ideale zonneschijn, verwelkomt Golf de la Valette je het hele jaar door om te ontspannen in de unieke omgeving van authentiek, beschermd platteland in het hart van de Cantal en Aubrac regio's."
    ]
  },
  "rdfs:label": {
    "en": [
      "La Valette's golf practice"
    ],
    "fr": [
      "Golf practice de la Valette"
    ],
    "nl": [
      "Golfen van la Valette"
    ]
  },
