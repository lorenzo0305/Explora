  "rdfs:comment": {
    "de": [
      "Im Parc des Bruyères, wo sich Fauna und Flora in Harmonie entwickeln, ist Abwechslung garantiert. Sie können sich sogar niederlassen, um in dieser herrlichen Natur zu angeln. Entspannung garantiert!"
    ],
    "en": [
      "A change of scenery is guaranteed at the Parc des Bruyères where fauna and flora thrive in harmony. You can even go fishing in this magnificent natural setting. Relaxation guaranteed!"
    ],
    "it": [
      "Un cambiamento di scenario è garantito al Parc des Bruyères, dove flora e fauna prosperano in armonia. È possibile anche pescare in questo magnifico ambiente naturale. Relax garantito!"
    ],
    "fr": [
      "Dépaysement garanti au Parc des Bruyères où faune et flore se développent en toute harmonie. Vous pourrez même vous installer pour pêcher au sein de ce magnifique écrin naturel. Détente assurée !"
    ],
    "es": [
      "El cambio de escenario está garantizado en el Parque de Bruyères, donde la flora y la fauna prosperan en armonía. Incluso podrá pescar en este magnífico entorno natural. Relajación garantizada"
    ],
    "nl": [
      "Een verandering van omgeving is gegarandeerd in het Parc des Bruyères waar flora en fauna in harmonie gedijen. U kunt zelfs gaan vissen in deze prachtige natuurlijke omgeving. Ontspanning gegarandeerd!"
    ]
  },
