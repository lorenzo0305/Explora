  "rdfs:comment": {
    "de": [
      "Hinterlassen Sie Ihre Spuren auf Schneeschuhen oder Langlaufskiern im nordischen Raum von Côte d'Aime Valezan! Ein ruhiger Ort abseits des Wahnsinns des modernen Lebens."
    ],
    "en": [
      "Make your mark on snowshoes or cross-country skis in the La Côte d'Aime Valezan nordic area, a tranquil spot away from the madness of modern life."
    ],
    "it": [
      "Lasciate il segno con le racchette da neve o gli sci di fondo nell'area nordica di Côte d'Aime Valezan! Un luogo tranquillo, lontano dalla follia della vita moderna."
    ],
    "fr": [
      "Laisser votre trace à raquettes ou en ski de fond sur l'espace nordique de la Côte d'Aime Valezan ! Un endroit tranquille, hors de la folie de la vie moderne."
    ],
    "nl": [
      "Laat je sporen achter op sneeuwschoenen of langlaufski's in het Nordic gebied Côte d'Aime Valezan! Een vredige plek, ver weg van de waanzin van het moderne leven."
    ],
    "es": [
      "Deja tu huella con las raquetas de nieve o los esquís de fondo en la zona nórdica de Côte d'Aime Valezan Un lugar tranquilo, lejos de la locura de la vida moderna."
    ]
  },
