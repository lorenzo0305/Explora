  "rdfs:comment": {
    "de": [
      "Wilde Seiden in schillernden Farben, ein origineller Lyoner Modeschöpfer: Sie befinden sich bei CathAm Soie in Vieux-Lyon."
    ],
    "en": [
      "An original Lyon fashion house, wild silks in shimmering colors. The CathAm line is unique, bold, and easy to wear, whether worn chic or casual. The whimsical shapes and ease of use bring joy and confidence."
    ],
    "it": [
      "Stoffe di seta selvatiche dai colori cangianti, più un creatore di moda lionese originale: vi trovate da CathAm Concept, nel quartiere medievale della Vieux-Lyon."
    ],
    "fr": [
      "Une Maison de mode lyonnaise originale, des soies sauvages aux couleurs chatoyantes. La ligne CathAm est inédite, audacieuse, facile à vivre, en tenue chic ou décontractée. La fantaisie des formes, la facilité d'utilisation apportent joie et confiance."
    ],
    "es": [
      "Sedas salvajes de colores llamativos y un creador de moda lionés que se basa en la originalidad: así es CathAm Soie, en el barrio de Vieux-Lyon."
    ],
    "nl": [
      "Een origineel modehuis uit Lyon, met wilde zijde in glinsterende kleuren. De CathAm-lijn is origineel, gedurfd en gemakkelijk te dragen, voor chique of casual outfits. De grillige vormen en het gebruiksgemak brengen plezier en zelfvertrouwen."
    ]
  },
