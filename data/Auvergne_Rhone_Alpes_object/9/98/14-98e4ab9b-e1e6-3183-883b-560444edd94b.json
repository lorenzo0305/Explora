  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/e1e9e9e4-3c8c-3b11-8b28-250e3d232cb9",
      "dc:description": {
        "de": [
          "Die Société Générale ist eine der führenden europäischen Finanzdienstleistungsgruppen. Die Gruppe verfügt über ein diversifiziertes und integriertes Geschäftsmodell, das finanzielle Stärke, Innovationsdynamik und eine nachhaltige und verantwortungsvolle Wachstumsstrategie vereint."
        ],
        "en": [
          "Société Générale is one of Europe's leading financial services groups. Backed by a diversified, integrated business model, the Group combines financial strength, dynamic innovation and a strategy of sustainable, responsible growth."
        ],
        "it": [
          "Société Générale è uno dei principali gruppi europei di servizi finanziari. Sostenuto da un modello di business diversificato e integrato, il Gruppo combina forza finanziaria, innovazione dinamica e una strategia di crescita sostenibile e responsabile."
        ],
        "fr": [
          "Société Générale est l'un des tout premiers groupes européens de services financiers. S'appuyant sur un modèle diversifié et intégré, le Groupe allie solidité financière, dynamique d'innovation et stratégie de croissance durable et responsable."
        ],
        "nl": [
          "Société Générale is een van de grootste financiële dienstengroepen in Europa. Gesteund door een gediversifieerd en geïntegreerd bedrijfsmodel combineert de Groep financiële kracht, dynamische innovatie en een strategie van duurzame en verantwoorde groei."
        ],
        "es": [
          "Société Générale es uno de los principales grupos europeos de servicios financieros. Respaldado por un modelo de negocio diversificado e integrado, el Grupo combina solidez financiera, innovación dinámica y una estrategia de crecimiento sostenible y responsable."
        ]
      },
