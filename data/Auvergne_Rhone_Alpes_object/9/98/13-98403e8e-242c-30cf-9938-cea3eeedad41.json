  "rdfs:comment": {
    "de": [
      "Mit L?Odyssée de la voix nimmt uns Michaël Gregorio, begleitet von seinen Musikern, mit auf eine grandiose Show, die Humor, stimmliche Leistungen und Emotionen miteinander verbindet.\r\n\r\nKartenverkauf in den Tourismusbüros von Romans und Valence"
    ],
    "en": [
      "With L?Odyssée de la voix, Michaël Gregorio, accompanied by his musicians, takes us on a grandiose show combining humor, vocal performance and emotion.\r\n\r\nTickets on sale at Romans and Valence tourist offices"
    ],
    "it": [
      "Con L'Odyssée de la voix, Michaël Gregorio, accompagnato dai suoi musicisti, ci accompagna in uno spettacolo grandioso che unisce umorismo, performance vocale ed emozione.\r\n\r\nBiglietti in vendita presso gli Uffici del Turismo di Romans e Valence"
    ],
    "fr": [
      "Avec L’Odyssée de la voix, Michaël Gregorio, accompagné de ses musiciens, nous embarque dans un spectacle grandiose mêlant humour, performances vocales et émotions.\r\n\r\nBilletterie en vente à l'office de tourisme de Romans et Valence"
    ],
    "nl": [
      "Met L'Odyssée de la voix neemt Michaël Gregorio, begeleid door zijn muzikanten, ons mee in een grandioze show waarin humor, vocale prestaties en emotie gecombineerd worden.\r\n\r\nTickets te koop bij de toeristenbureaus van Rome en Valence"
    ],
    "es": [
      "Con L'Odyssée de la voix, Michaël Gregorio, acompañado por sus músicos, nos embarca en un grandioso espectáculo que combina humor, interpretación vocal y emoción.\r\n\r\nVenta de entradas en las oficinas de turismo de Romans y Valence"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Concert : Michael Gregorio \"L'Odyssée de la voix\""
    ]
  },
