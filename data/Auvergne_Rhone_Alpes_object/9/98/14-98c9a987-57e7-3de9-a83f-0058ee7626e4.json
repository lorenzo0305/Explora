  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/7c4aca98-c1c1-34d3-aced-10861f816fb6",
      "dc:description": {
        "de": [
          "Capieda am Samstag, den 14. Oktober 2023.\nRosa Wanderung für die Forschung - Einheitspreis 5?\nAnmeldung im Rathaus von Camiers ab 10 Uhr.\nAbfahrt um 14 Uhr. Zwei mögliche Strecken"
        ],
        "en": [
          "Capieda on Saturday, October 14, 2023.\nPink walk for research - single price 5?\nRegistration at Camiers Town Hall from 10am.\nDeparture at 14. Two possible routes"
        ],
        "it": [
          "Capieda sabato 14 ottobre 2023.\nCamminata rosa per la ricerca - prezzo unico 5?\nIscrizioni presso il municipio di Camiers a partire dalle 10.00.\nPartenza alle 14.00. Due possibili percorsi"
        ],
        "fr": [
          "Capieda le samedi 14 octobre 2023.\nMarche rose pour la recherche - tarif unique 5€.\nInscription en Mairie de Camiers dès 10h.\nDépart à 14. Deux parcours possibles"
        ],
        "nl": [
          "Capieda op zaterdag 14 oktober 2023.\nRoze wandeling voor onderzoek - enkele prijs 5?\nRegistratie bij het gemeentehuis van Camiers vanaf 10 uur.\nVertrek om 14.00 uur. Twee mogelijke routes"
        ],
        "es": [
          "Capieda el sábado 14 de octubre de 2023.\nCaminata rosa por la investigación - precio único 5?\nInscripciones en el Ayuntamiento de Camiers a partir de las 10h.\nSalida a las 14h. Dos rutas posibles"
        ]
      },
      "@type": [
        "Description"
