  "rdfs:comment": {
    "de": [
      "Elevatio-Escalade bietet Ihnen Sophrologie-Sitzungen an. Gönnen Sie sich Zeit nur für sich selbst mit Entspannungsübungen, Atemübungen, Visualisierungen und Zeit zum Austausch"
    ],
    "en": [
      "Elevatio-Escalade offers sophrology sessions. Take time out for yourself with relaxation exercises, breathing methods, visualization and sharing."
    ],
    "it": [
      "Elevatio-Escalade offre sessioni di sofrologia. Concedetevi un po' di tempo per voi stessi con esercizi di rilassamento, metodi di respirazione, visualizzazione e momenti di condivisione"
    ],
    "fr": [
      "Elevatio-Escalade vous propose des séances de sophrologie. Accordez-vous un temps rien que pour vous grâce à des exercices de relaxation, des méthodes de respiration, de la visualisation et des temps de partage"
    ],
    "es": [
      "Elevatio-Escalade ofrece sesiones de sofrología. Regálate un tiempo para ti con ejercicios de relajación, métodos de respiración, visualización y tiempo para compartir"
    ],
    "nl": [
      "Elevatio-Escalade biedt sofrologiesessies aan. Gun jezelf wat tijd voor jezelf met ontspanningsoefeningen, ademhalingsmethodes, visualisatie en tijd om te delen."
    ]
  },
