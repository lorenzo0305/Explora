  "rdfs:comment": {
    "de": [
      "Wir bieten Bücher, Alben, Cds, Comics, Dokumentarfilme für Kinder, Jugendliche, Teenager und Erwachsene zur kostenlosen Einsichtnahme vor Ort oder gegen eine Mitgliedschaft an."
    ],
    "en": [
      "We offer books, albums, cds, bds, documentaries for toddlers, children, young people, teenagers and adults for free consultation on site or for a membership."
    ],
    "it": [
      "Offriamo libri, album, CD, fumetti e documentari per bambini, giovani, adolescenti e adulti, che possono essere consultati gratuitamente sul posto o a pagamento."
    ],
    "fr": [
      "Nous proposons des livres, albums, cds, bds, documentaires tout petits, enfants, jeunes, ados et adultes en consultation gratuite sur place ou moyennant une adhésion."
