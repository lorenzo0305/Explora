  "rdfs:comment": {
    "de": [
      "Für die März-Ausgabe lädt La Loco Sie zu einem speziellen Kurzfilmfest am Sonntag, den 29. März um 15 Uhr im Gemeindesaal des Viertels Emile ZOLA in Brioude ein (siehe beigefügte Karte)."
    ],
    "en": [
      "For the March edition, La Loco invites you to a special Short Film Festival on Sunday March 29 at 3pm at the municipal hall in the Emile ZOLA district of Brioude (see attached map)."
    ],
    "it": [
      "Per l'edizione di marzo, La Loco vi invita a partecipare a uno speciale Festival di cortometraggi domenica 29 marzo alle 15.00 presso la sala comunale nel quartiere Emile Zola di Brioude (vedi mappa allegata)."
    ],
    "fr": [
      "Pour l'édition de mars, La Loco vous invite à un spécial Fête du court-métrage le dimanche 29 mars à 15h à la salle municipale du quartier Emile ZOLA à Brioude (voire carte ci-joint)."
    ],
    "nl": [
      "Voor de editie van maart nodigt La Loco je uit voor een speciaal kortfilmfestival op zondag 29 maart om 15.00 uur in het gemeentehuis in de wijk Emile Zola in Brioude (zie bijgevoegd kaartje)."
    ],
    "es": [
      "Para la edición de marzo, La Loco le invita a un festival especial de cortometrajes el domingo 29 de marzo a las 15.00 horas en la sala municipal del barrio Emile Zola de Brioude (ver mapa adjunto)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Dimanche on sort \"Spécial courts-métrages\""
    ]
  },
