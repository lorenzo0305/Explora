  "rdfs:comment": {
    "de": [
      "Pépit ist eine kostenlose App, die auf dem Prinzip des Geocaching basiert und Ihnen die Reichtümer von Montluçon, Ainay, Hérisson, Isle-et-Bardais, Meaulne-Vitray, dem Canal de Berry und dem Wald von Tronçais enthüllt. Laden Sie die App \"PÉPIT\" herunter."
    ],
    "en": [
      "Based on the principle of geocaching, Pépit is a free application that will reveal the treasures of Montluçon, Ainay, Hérisson, Isle-et-Bardais, Meaulne-Vitray, the Berry canal and the Tronçais forest. Download the \"PÉPIT\" application."
    ],
    "it": [
      "Basata sul principio del geocaching, Pépit è un'applicazione gratuita che svela i tesori di Montluçon, Ainay, Hérisson, Isle-et-Bardais, Meaulne-Vitray, del canale del Berry e della foresta di Tronçais. Scaricate l'applicazione \"PÉPIT\"."
    ],
    "fr": [
      "Basée sur le principe du géocaching, Pépit est une application gratuite qui vous révèlera les richesses de Montluçon, Ainay, Hérisson, Isle-et-Bardais, Meaulne-Vitray, du canal de Berry et de la forêt de Tronçais. Téléchargez l’application \"PÉPIT\"."
    ],
    "nl": [
      "Pépit, gebaseerd op het principe van geocaching, is een gratis applicatie die de schatten van Montluçon, Ainay, Hérisson, Isle-et-Bardais, Meaulne-Vitray, het Berry-kanaal en het bos van Tronçais zal onthullen. Download de applicatie \"PÉPIT\"."
    ],
    "es": [
      "Basada en el principio del geocaching, Pépit es una aplicación gratuita que le descubrirá los tesoros de Montluçon, Ainay, Hérisson, Isle-et-Bardais, Meaulne-Vitray, el canal de Berry y el bosque de Tronçais. Descargue la aplicación \"PÉPIT\"."
    ]
  },
