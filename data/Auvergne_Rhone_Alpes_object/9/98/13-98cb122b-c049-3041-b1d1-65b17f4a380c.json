  "rdfs:comment": {
    "de": [
      "Das interkommunale Fremdenverkehrsamt Saint-Marcellin Vercors Isère empfängt Sie in seiner Touristeninformation in Pont-en-Royans, damit Sie die Reichtümer der Region entdecken oder wiederentdecken können"
    ],
    "en": [
      "The Saint-Marcellin Vercors Isère Tourist Office welcomes you to its tourist information office in Pont-en-Royans to help you discover or rediscover the richness of the territory"
    ],
    "it": [
      "L'Ufficio intercomunale del turismo di Saint-Marcellin Vercors Isère vi accoglie nel suo ufficio di informazioni turistiche di Pont-en-Royans per farvi scoprire o riscoprire le ricchezze della regione"
    ],
    "fr": [
      "L'Office de Tourisme intercommunal Saint-Marcellin Vercors Isère vous accueille dans son bureau d'information touristique de Pont-en-Royans pour vous faire découvrir ou redécouvrir les richesses du territoire"
    ],
    "es": [
      "La Oficina de Turismo Intercomunal de Saint-Marcellin Vercors Isère le da la bienvenida a su oficina de información turística de Pont-en-Royans para ayudarle a descubrir o redescubrir las riquezas de la región"
    ],
    "nl": [
      "Het Intercommunaal Bureau voor Toerisme van Saint-Marcellin Vercors Isère heet u welkom in zijn VVV-kantoor in Pont-en-Royans om u te helpen de rijkdommen van de streek te ontdekken of te herontdekken"
    ]
  },
