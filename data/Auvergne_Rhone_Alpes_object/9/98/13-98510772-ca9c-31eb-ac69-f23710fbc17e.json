  "rdfs:comment": {
    "de": [
      "Das im Februar 2020 eröffnete Mittelaltermuseum \"Le temps de Vagnas\" zeigt die Sammlung außergewöhnlicher mittelalterlicher liturgischer Möbel, die aus den 17 Jahre lang durchgeführten Ausgrabungen im Priorat Saint-Pierre im Ortsteil Le Monastier hervorgegangen sind."
    ],
    "en": [
      "Inaugurated in February 2020, the medieval museum \"Le temps de Vagnas\" presents the collection of exceptional medieval liturgical furniture from excavations carried out for 17 years in the Saint-Pierre priory, at a place called Le Monastier."
    ],
    "it": [
      "Inaugurato nel febbraio 2020, il Museo medievale \"Il tempo di Vagnas\" presenta la collezione di eccezionali arredi liturgici medievali frutto di 17 anni di scavi nel priorato di Saint-Pierre, a Le Monastier."
    ],
    "fr": [
      "Inauguré en février 2020, le Musée médiéval « Le temps de Vagnas » présente la collection de l’exceptionnel mobilier liturgique médiéval issu des fouilles opérées pendant 17 ans dans le prieuré Saint-Pierre, au lieu-dit Le Monastier."
    ],
    "es": [
      "Inaugurado en febrero de 2020, el Museo Medieval \"El tiempo de Vagnas\" presenta la colección de excepcionales muebles litúrgicos medievales fruto de 17 años de excavaciones en el priorato de Saint-Pierre, en Le Monastier."
    ],
    "nl": [
      "Het middeleeuws museum \"Le temps de Vagnas\", ingehuldigd in februari 2020, presenteert de collectie uitzonderlijk middeleeuws liturgisch meubilair die het resultaat is van 17 jaar opgravingen in de priorij Saint-Pierre in Le Monastier."
    ]
  },
  "rdfs:label": {
    "de": [
      "Mittelalterliches Museum von Vagnas \" Die Zeit von Vagnas \"."
    ],
    "ru": [
      "Musée Médiéval de Vagnas « Le temps de Vagnas »"
    ],
    "en": [
      "Musée Médiéval de Vagnas \"The time of Vagnas"
    ],
    "it": [
      "Musée Médiéval de Vagnas « Le temps de Vagnas »"
