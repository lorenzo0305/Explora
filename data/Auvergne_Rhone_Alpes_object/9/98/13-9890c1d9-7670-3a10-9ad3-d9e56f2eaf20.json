  "rdfs:comment": {
    "de": [
      "In einer ländlichen und herzlichen Atmosphäre empfängt Sie das Team, um traditionelle Gerichte aus 6 Kontinenten zu genießen, die aus frischen Produkten entsprechend den Farben der Jahreszeiten zubereitet werden."
    ],
    "en": [
      "In a warm, country atmosphere, the team welcomes you to enjoy traditional dishes from 6 continents, made from fresh produce in keeping with the colors of the seasons."
    ],
    "it": [
      "In una calda atmosfera di campagna, il team vi accoglie per farvi assaggiare i piatti tradizionali dei 6 continenti, preparati con prodotti freschi secondo i colori delle stagioni."
    ],
    "fr": [
      "Dans une ambiance champêtre et chaleureuse, l'équipe vous accueille pour déguster des plats traditionnels des 6 continents élaborés à partir de produits frais en fonction des couleurs des saisons."
    ],
    "nl": [
      "In een warme landelijke sfeer heet het team je welkom om traditionele gerechten uit de 6 continenten te proeven, bereid met verse producten volgens de kleuren van de seizoenen."
    ],
    "es": [
      "En un cálido ambiente campestre, el equipo le da la bienvenida para degustar platos tradicionales de los 6 continentes, elaborados con productos frescos según los colores de las estaciones."
    ]
  },
  "rdfs:label": {
