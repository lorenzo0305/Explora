  "rdfs:comment": {
    "de": [
      "Gaspard Destre ist ein Buchmaler, der in Le Coteau lebt und Werke nach den Prinzipien der mittelalterlichen Buchmalerei herstellt. Er vermittelt diese Kunst in Kursen und Workshops."
    ],
    "en": [
      "An illuminator based in Le Coteau, Gaspard Destre creates works based on the principles of medieval illumination. He passes on this art through courses and workshops."
    ],
    "it": [
      "Miniatore di Le Coteau, Gaspard Destre crea opere basate sui principi della miniatura medievale. Trasmette quest'arte attraverso corsi e laboratori."
    ],
    "fr": [
      "Artiste enlumineur installé à Le Coteau, Gaspard Destre crée des œuvres selon les principes de l'enluminure médiévale. Il transmet cet art à travers des cours et des ateliers."
    ],
    "es": [
      "Iluminador afincado en Le Coteau, Gaspard Destre crea obras basadas en los principios de la iluminación medieval. Transmite este arte a través de cursos y talleres."
    ],
    "nl": [
      "Gaspard Destre is een verluchter uit Le Coteau die werken maakt gebaseerd op de principes van middeleeuwse verluchting. Hij geeft deze kunst door via cursussen en workshops."
    ]
  },
