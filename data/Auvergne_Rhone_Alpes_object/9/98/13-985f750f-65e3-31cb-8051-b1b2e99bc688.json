  "rdfs:comment": {
    "de": [
      "Theater, Tanz, Musik, Zirkus, Oper: Die Nächte von Fourvière sind für die Bühnenkunst bestimmt und bemühen sich seit 1946 die verschiedenen Disziplinen koexistieren zu lassen."
    ],
    "en": [
      "Theatre, music, dance, opera, circus... Les Nuits de Fourvière is devoted to the performing arts, and since 1946 has been committed to ensuring that different disciplines coexist."
    ],
    "it": [
      "Teatro, danza, musica, circo, opera: Le Notti di Fourvière sono dedicate alle arti di scena e dal 1946 si impegnano a far coesistere diverse discipline."
    ],
    "fr": [
      "Théâtre, musique, danse, opéra, cirque... Les Nuits de Fourvière sont dévolues aux arts de la scène et s’attachent, depuis 1946, à faire coexister les disciplines."
    ],
    "nl": [
      "Theater, muziek, dans, opera, circus... Les Nuits de Fourvière zijn gewijd aan de podiumkunsten en zetten zich sinds 1946 in om disciplines naast elkaar te laten bestaan."
    ],
    "es": [
      "Teatro, baile, música, circo, ópera... El festival Les Nuits de Fourvière está consagrado a las artes escénicas y, desde 1946, se afana por que coexistan totas las disciplinas."
    ]
  },
