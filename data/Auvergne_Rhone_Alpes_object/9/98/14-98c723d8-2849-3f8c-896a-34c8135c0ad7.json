      "dc:description": {
        "de": [
          "Gemütliche Crêperie und Tapas am Eingang des Waldes in La Capelle les Boulogne.\nGeöffnet von Mittwoch bis Sonntag.\nTel.: 06 08 71 65 47"
        ],
        "en": [
          "Cosy creperie and tapas at the entrance to the forest in La Capelle les Boulogne.\nOpen Wednesday to Sunday.\nTel: 06 08 71 65 47"
        ],
        "it": [
          "Accogliente creperia e tapas all'ingresso della foresta a La Capelle les Boulogne.\nAperto da mercoledì a domenica.\nTel: 06 08 71 65 47"
        ],
        "fr": [
          "Crêperie cosy et tapas à l'entrée de la forêt à La Capelle les Boulogne.\nOuverte du mercredi au dimanche.\nTel.: 06 08 71 65 47"
        ],
        "nl": [
          "Gezellige crêperie en tapas bij de ingang van het bos in La Capelle les Boulogne.\nGeopend van woensdag tot zondag.\nTel: 06 08 71 65 47"
        ],
        "es": [
          "Acogedora crepería y tapas a la entrada del bosque en La Capelle les Boulogne.\nAbierto de miércoles a domingo.\nTeléfono: 06 08 71 65 47"
        ]
      },
