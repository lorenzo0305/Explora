  "rdfs:comment": {
    "de": [
      "Aufenthalte in der Natur oder Themenwanderungen mit Alexis, Bergführer, Physiotherapeut und Yogalehrer. Die Ausflüge werden nach Ihren Wünschen zusammengestellt. Tauchen Sie mit der Familie oder mit Freunden ein!"
    ],
    "en": [
      "Themed vacations or hikes in the great outdoors with Alexis, mountain guide, physiologist and yoga teacher. Our activities are taylor made according to your wishes. Immerse yourself in a natural setting with family and friends !"
    ],
    "it": [
      "Soggiorni nel cuore della natura o escursioni a tema con Alexis, guida alpina, fisioterapista e insegnante di yoga. Le uscite sono personalizzate in base ai vostri desideri. Immergetevi con la vostra famiglia o con gli amici!"
    ],
    "fr": [
      "Séjours pleine nature ou randonnées à thème avec Alexis, accompagnateur en montagne, kiné et enseignant yoga. Les sorties sont construites sur mesure selon vos envies. S'immerger en famille ou entre amis!"
    ],
    "nl": [
      "Natuurtochten of themawandelingen met Alexis, bergleider, fysiotherapeut en yogaleraar. Uitstapjes worden op maat gemaakt om aan je wensen te voldoen. Dompel jezelf onder met familie of vrienden!"
    ],
    "es": [
      "Estancias en plena naturaleza o excursiones temáticas con Alexis, guía de montaña, fisioterapeuta y profesor de yoga. Las salidas se hacen a medida según sus deseos. ¡Sumérjase con su familia o amigos!"
    ]
  },
