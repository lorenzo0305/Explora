  "rdfs:comment": {
    "de": [
      "Lust, in Büchern zu schmökern? Die Bibliothek heißt Sie herzlich willkommen!\r\nEin Bestand von 3000 Büchern steht Ihnen im kostenlosen Abonnement zur Verfügung.\r\nProfitieren Sie von den Lesetipps der passionierten Bibliothekarinnen an einem gemütlichen Ort."
    ],
    "en": [
      "Looking for a good book? The library welcomes you!\r\nA collection of 3,000 books is available free of charge.\r\nCome and benefit from the reading advice of passionate librarians in a warm and welcoming environment."
    ],
    "it": [
      "Cercate un buon libro? La biblioteca vi accoglie!\r\nUna collezione di 3.000 libri è disponibile gratuitamente.\r\nVenite ad approfittare dei consigli di lettura dei nostri entusiasti bibliotecari in un ambiente caldo e accogliente."
    ],
    "fr": [
      "Envie de bouquiner ? La bibliothèque vous accueille !\r\nUn fonds de 3000 livres à disposition sur abonnement gratuit.\r\nVenez bénéficier des conseils de lecture de bibliothécaires passionnées dans un lieu chaleureux."
    ],
    "es": [
      "¿Busca un buen libro? La biblioteca le da la bienvenida\r\nDisponemos de una colección de 3.000 libros gratuitos.\r\nVenga y aproveche los consejos de lectura de nuestros entusiastas bibliotecarios en un ambiente cálido y acogedor."
    ],
    "nl": [
      "Op zoek naar een goed boek? De bibliotheek heet je van harte welkom!\r\nEen collectie van 3000 boeken is gratis beschikbaar.\r\nKom en profiteer van leesadvies van onze enthousiaste bibliothecarissen in een warme en vriendelijke omgeving."
    ]
  },
  "rdfs:label": {
