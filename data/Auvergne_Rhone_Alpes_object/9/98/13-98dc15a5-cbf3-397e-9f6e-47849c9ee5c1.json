  "rdfs:comment": {
    "de": [
      "Vertrauen Sie auf eine Skischule mit 30 Jahren Erfahrung, die Ihnen das Beste von Val d'Isère zeigt. Ob mit der Familie oder mit Freunden, machen Sie sich auf den Weg zu den Gipfeln für einen unvergesslichen Aufenthalt."
    ],
    "en": [
      "Trust a ski school with 30 years of experience to help you discover the best of Val d'Isère. With family or friends, reach the summits for an unforgettable stay."
    ],
    "it": [
      "Affidatevi a una scuola di sci con 30 anni di esperienza per scoprire il meglio della Val d'Isère. Con la famiglia o con gli amici, raggiungete le vette per un soggiorno indimenticabile."
    ],
    "fr": [
      "Faîtes confiance à une école de ski forte de 30 ans d’expérience pour vous faire découvrir le meilleur de Val d’Isère. En famille ou entre amis, rejoignez les sommets pour un séjour inoubliable."
    ],
    "nl": [
      "Vertrouw op een skischool met 30 jaar ervaring om je het beste van Val d'Isère te laten ontdekken. Trek met je gezin of met vrienden naar de toppen voor een onvergetelijke vakantie."
    ],
    "es": [
      "Confíe en una escuela de esquí con 30 años de experiencia para descubrir lo mejor de Val d'Isère. En familia o entre amigos, sube a las cumbres para pasar unas vacaciones inolvidables."
    ]
  },
  "rdfs:label": {
