  "rdfs:comment": {
    "de": [
      "Die Drogerie empfängt Sie in einem gemütlichen, industriell inspirierten Rahmen.\r\nOriginelle Rezepte aus den lokalen Traditionen und der französischen Küche.\r\nAusschließlich frische Produkte.\r\nRegelmäßiger Kartenwechsel."
    ],
    "en": [
      "The drugstore welcomes you in a warm, industrial-inspired setting.\r\nOriginal recipes drawn from local traditions and French cuisine.\r\nFresh produce only.\r\nRegular menu changes."
    ],
    "it": [
      "La farmacia vi accoglie in un ambiente caldo e di ispirazione industriale.\r\nRicette originali tratte dalla tradizione locale e dalla cucina francese.\r\nSolo prodotti freschi.\r\nVariazione regolare del menu."
    ],
    "fr": [
      "Le drugstore vous accueille dans un cadre chaleureux d'inspiration industrielle.\r\nRecettes originales tirées des traditions locales et de la cuisine Française.\r\nProduits frais exclusivement.\r\nChangement de carte régulièrement."
    ],
    "es": [
      "La droguería le da la bienvenida en un ambiente cálido de inspiración industrial.\r\nRecetas originales extraídas de las tradiciones locales y de la cocina francesa.\r\nSólo productos frescos.\r\nCambios regulares de menú."
    ],
    "nl": [
      "De drogisterij verwelkomt je in een warme, industrieel geïnspireerde omgeving.\r\nOriginele recepten gebaseerd op lokale tradities en de Franse keuken.\r\nAlleen verse producten.\r\nRegelmatig wisselend menu."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Drugstore"
    ]
  },
