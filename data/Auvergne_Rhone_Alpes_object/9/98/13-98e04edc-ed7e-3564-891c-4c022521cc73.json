  "rdfs:comment": {
    "de": [
      "Dank der Broschüre kann dieser Rundgang das ganze Jahr über völlig unabhängig unternommen werden."
    ],
    "en": [
      "Visit this commune : short 1-hour walks to enjoy with your family or friends."
    ],
    "it": [
      "Venite a scoprire il villaggio di Bellegarde-en-Forez: in 45 minuti, passeggiate in questo villaggio collinare e godetevi le sue attrazioni.\r\nOpuscolo disponibile presso gli uffici informazioni di Forez-Est o scaricabile qui."
    ],
    "fr": [
      "Venez découvrir le village de Bellegarde-en-Forez : en 45 min, baladez-vous dans ce village à flanc de colline en appréciant ses curiosités.\r\nDépliant disponible dans les bureaux d'information de Forez-Est ou téléchargeable ici."
    ],
    "es": [
      "Venga a descubrir el pueblo de Bellegarde-en-Forez: en 45 minutos, pasee por este pueblo de montaña y disfrute de sus vistas.\r\nFolleto disponible en las oficinas de información de Forez-Est o descargable aquí."
    ],
    "nl": [
      "Kom en ontdek het dorp Bellegarde-en-Forez: wandel in 45 minuten door dit heuveldorp en geniet van de bezienswaardigheden.\r\nFolder verkrijgbaar in de informatiekantoren van Forez-Est of hier te downloaden."
    ]
  },
