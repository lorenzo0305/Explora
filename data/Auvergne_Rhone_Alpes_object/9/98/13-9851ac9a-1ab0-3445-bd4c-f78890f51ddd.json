  "rdfs:comment": {
    "de": [
      "Begegnen Sie der Belledonne und ihrem Zauber mit einer passionierten Begleiterin: Familienwanderungen, sportliche Ausflüge, Tierbeobachtungen, Biwaks unter den Sternen. Eine gesellige Erfahrung, die für alle zugänglich ist, zu jeder Jahreszeit."
    ],
    "en": [
      "Discover the magic of the Belledonne with a passionate guide: family hikes, sports outings, wildlife observation, bivouacs under the stars. A friendly experience accessible to all, whatever the season."
    ],
    "it": [
      "Venite a scoprire la magia della Belledonne con una guida appassionata: escursioni in famiglia, uscite sportive, osservazione della fauna, bivacchi sotto le stelle. Un'esperienza amichevole e accessibile a tutti, in qualsiasi stagione."
    ],
    "fr": [
      "Partez à la rencontre de Belledonne et de sa magie avec une accompagnatrice passionnée : randonnées familiales, sorties sportives, observation de la faune, bivouacs sous les étoiles. Une expérience conviviale et accessible à tous, en toutes saisons."
    ],
    "es": [
      "Venga a descubrir la magia de la Belledonne con un guía apasionado: excursiones en familia, salidas deportivas, observación de la fauna, vivaques bajo las estrellas. Una experiencia agradable y accesible para todos, en cualquier estación."
    ],
    "nl": [
      "Kom de magie van de Belledonne ontdekken met een gepassioneerde gids: wandelingen voor het hele gezin, sportieve uitstapjes, wild spotten, bivak onder de sterrenhemel. Een gezellige ervaring die voor iedereen toegankelijk is, ongeacht het seizoen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "C'est ta nature - accompagnateur en montagne"
    ]
  },
