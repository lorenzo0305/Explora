  "rdfs:comment": {
    "de": [
      "Wir brauen unsere Biere mit hochwertigen Zutaten. Wir arbeiten mit modernen Hopfensorten, die unseren Bieren eine Fülle von Aromen verleihen."
    ],
    "en": [
      "We brew our beers with high-quality ingredients. We work with modern hop varieties that give our beers an abundance of flavor."
    ],
    "it": [
      "Produciamo le nostre birre con ingredienti di alta qualità. Lavoriamo con varietà di luppolo moderne che danno alle nostre birre un'abbondanza di sapore."
    ],
    "fr": [
      "Nous brassons nos bières avec des ingrédients de haute qualité. Nous travaillons avec des variétés de houblons modernes qui donnent à nos bières une abondance de saveurs."
    ],
    "nl": [
      "Wij brouwen onze bieren met ingrediënten van hoge kwaliteit. Wij werken met moderne hopsoorten die onze bieren een overvloed aan smaak geven."
    ],
    "es": [
      "Elaboramos nuestras cervezas con ingredientes de alta calidad. Trabajamos con variedades de lúpulo modernas que aportan a nuestras cervezas una gran cantidad de sabor."
    ]
