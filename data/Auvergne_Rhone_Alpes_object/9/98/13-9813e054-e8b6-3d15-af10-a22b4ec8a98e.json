  "rdfs:comment": {
    "de": [
      "Zwischen Bouchon und Bistronomie, im Herzen der Halbinsel, im Viertel Cordeliers, bietet Ihnen das Atelier du Square eine aufrichtige und verantwortungsbewusste Küche. Alles ist hausgemacht."
    ],
    "en": [
      "Between Bouchon and Bistronomy, in the heart of Presqu’ile, Cordeliers district, l'Atelier du Square concocts you a sincere and responsive cuisine. Everything is homemade."
    ],
    "it": [
      "Tra Bouchon e Bistronomy, nel cuore della Presqu'ile, nel quartiere dei Cordeliers, l'Atelier du Square propone una cucina sincera e responsabile. Tutto è fatto in casa."
    ],
    "fr": [
      "Entre Bouchon et Bistronomie, en plein coeur de la Presqu’ile, dans le quartier des Cordeliers, l'Atelier du Square vous concocte une cuisine sincère et responsable. Tout est fait maison."
    ],
    "nl": [
      "Tussen Bouchon en Bistronomy, in het hart van Presqu?ile, in de wijk Cordeliers, brouwt l'Atelier du Square een eerlijke en verantwoorde keuken. Alles is huisgemaakt."
    ],
    "es": [
      "Entre Bouchon y Bistronomy, en el corazón de la Presqu'ile, en el barrio de Cordeliers, l'Atelier du Square elabora una cocina sincera y responsable. Todo es casero."
    ]
  },
