  "rdfs:comment": {
    "de": [
      "Hinweis an alle Neugierigen. Kleine und große übrigens. Auf der Seite von Chamboeuf findet man architektonische und landschaftliche Nuggets. Da trifft es sich gut, dass wir eine Schnitzeljagd für Kinder ab 4 Jahren anbieten."
    ],
    "en": [
      "Notice to all the curious. Young and old alike. In the Chamboeuf area, you'll find architectural and landscaping nuggets. Just the thing, we're offering a treasure hunt for children aged 4 and over."
    ],
    "it": [
      "Ai curiosi. Giovani e meno giovani. Nella zona di Chamboeuf si trovano alcuni gioielli architettonici e paesaggistici. Proprio per questo, proponiamo una caccia al tesoro per i bambini dai 4 anni in su."
    ],
    "fr": [
      "Avis à tous les curieux. Petits et grands d’ailleurs. Du côté de Chamboeuf on trouve des pépites architecturales et paysagères. Ça tombe bien, on propose un jeu de piste jeune public dès 4 ans."
    ],
    "es": [
      "Por los curiosos. Para grandes y pequeños. En la zona de Chamboeuf encontrará algunas joyas arquitectónicas y paisajísticas. Le proponemos una búsqueda del tesoro para niños a partir de 4 años."
    ],
    "nl": [
      "Op de nieuwsgierigen. Jong en oud. In de buurt van Chamboeuf vind je enkele architecturale en landschappelijke juweeltjes. Voor kinderen vanaf 4 jaar bieden we een schattenjacht aan."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Jeu de piste Graine d'Explorateur - Chamboeuf"
    ]
  },
