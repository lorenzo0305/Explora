  "rdfs:comment": {
    "de": [
      "Verleih von Mountainbikes, E-Mountainbikes und E-Mountainbikes für Erwachsene und Kinder mit Strecken und GPS-Tracks, die Sie auf Ihr Handy herunterladen können, für tolle Ausflüge, auf denen Sie die Pracht des Diois selbstständig entdecken können."
    ],
    "en": [
      "Rental of mountain bikes, mountain bikes and electric mountain bikes for adults and children, with routes and GPS tracks that can be downloaded to your phone for superb rides to discover the splendors of the Diois region on your own."
    ],
    "it": [
      "Noleggio di mountain bike, mountain bike e mountain bike elettriche per adulti e bambini, con percorsi e tracciati GPS da scaricare sul proprio cellulare, per splendide pedalate alla scoperta degli splendori del Diois in autonomia."
    ],
    "fr": [
      "Location de VTT, VTT et VTC électriques adultes et enfants avec parcours et traces GPS téléchargeables sur votre téléphone pour de superbes balades pour découvrir les splendeurs du Diois en toute autonomie."
    ],
    "nl": [
      "Huur mountainbikes, mountainbikes en elektrische mountainbikes voor volwassenen en kinderen, met routes en GPS-tracks die je kunt downloaden op je mobiele telefoon voor prachtige tochten om de pracht van de Diois op eigen houtje te ontdekken."
    ],
    "es": [
      "Alquile bicicletas de montaña, BTT y BTT eléctricas para adultos y niños, con rutas y tracks GPS que podrá descargar en su teléfono móvil para realizar magníficos paseos y descubrir los esplendores del Diois a su aire."
    ]
  },
  "rdfs:label": {
