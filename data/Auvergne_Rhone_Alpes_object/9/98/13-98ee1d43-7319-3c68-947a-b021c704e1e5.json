  "rdfs:comment": {
    "de": [
      "Kreationen von dekorativen Gegenständen aus Holz: Schneidebretter, Wanddekorationen und sogar Nähkästchen. \"Au Bois de Seb\" kann seine Objekte individuell und nach Maß anfertigen."
    ],
    "en": [
      "Creation of decorative wooden objects: cutting boards, wall decorations and even sewing boxes. \"Au Bois de Seb\" can make its objects in a personalized and custom way."
    ],
    "it": [
      "Creazione di oggetti decorativi in legno: taglieri, decorazioni murali e persino scatole per il cucito. \"Au Bois de Seb\" può realizzare i suoi oggetti in modo personalizzato e su misura."
    ],
    "fr": [
      "Créations d'objets décoratifs en bois : planches à découper, décorations murales et même boites de couture. \"Au Bois de Seb\" peut fabriquer ses objets de façon personnalisée et sur mesure."
    ],
    "nl": [
      "Creatie van decoratieve houten voorwerpen: snijplanken, wanddecoraties en zelfs naaidozen. \"Au Bois de Seb\" kan zijn voorwerpen gepersonaliseerd en op maat maken."
    ],
    "es": [
      "Creación de objetos decorativos de madera: tablas de cortar, adornos de pared e incluso cajas de costura. \"Au Bois de Seb\" puede fabricar sus objetos de forma personalizada y a medida."
    ]
  },
