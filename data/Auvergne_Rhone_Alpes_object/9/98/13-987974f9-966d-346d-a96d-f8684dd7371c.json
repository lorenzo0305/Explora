  "rdfs:comment": {
    "de": [
      "Im Herzen der Putting-Golf-Anlage von Tence, inmitten einer wilden und großzügigen Natur, können Sie das Restaurant L'Ours Maçon und seine Terrassen genießen, mit Blick auf den Pic du Lizieux, einen ehemaligen schlafenden Vulkan.\r\nAkzeptiert T'CAP-Schecks."
    ],
    "en": [
      "In the heart of the Putting-Golf de Tence site, in a setting of wild and generous nature, you can enjoy the restaurant of the Mason Bear and its terraces, facing the Pic du Lizieux, an ancient sleeping volcano.\r\nAccepts T'CAP cheques."
    ],
    "it": [
      "Nel cuore del sito del Putting-Golf de Tence, in un ambiente naturale selvaggio e generoso, potrete gustare il ristorante Ours Maçon e le sue terrazze, di fronte al Pic du Lizieux, un antico vulcano addormentato.\r\nAccetta gli assegni T'CAP."
    ],
    "fr": [
      "Au cœur du site du Putting-Golf de Tence, dans un  écrin de nature sauvage et généreuse, vous pourrez profiter du restaurant de l'Ours Maçon et de ses terrasses, face au Pic du Lizieux, ancien volcan endormi.\r\nAccepte les chèques T'CAP."
    ],
    "nl": [
      "In het hart van de Putting-Golf site van Tence, in een omgeving van wilde en genereuze natuur, kunt u genieten van het restaurant Ours Maçon en zijn terrassen, met uitzicht op de Pic du Lizieux, een oude slapende vulkaan.\r\nAccepteert T'CAP cheques."
    ],
    "es": [
      "En el corazón del recinto del Putting-Golf de Tence, en un entorno natural salvaje y generoso, podrá disfrutar del restaurante Ours Maçon y sus terrazas, frente al Pic du Lizieux, un antiguo volcán dormido.\r\nAcepta cheques T'CAP."
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'Ours Maçon"
    ]
  },
