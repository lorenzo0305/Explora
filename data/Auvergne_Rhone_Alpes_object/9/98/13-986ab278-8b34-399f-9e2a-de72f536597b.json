  "rdfs:comment": {
    "de": [
      "Die Avoriaz Alpine Ski School ist eine Schule, die sich auf dem Plateau von Avoriaz befindet. Seit 1992 bieten wir Ihnen die besten Möglichkeiten zum Skifahren und Snowboarden. Wir bieten Kurse für jedes Alter und jedes Niveau an, sowohl im Privatunterricht als auch in kleinen Gruppen."
    ],
    "en": [
      "The Avoriaz Alpine Ski School is a school located on the Avoriaz plateau. We have been offering the best in skiing and snowboarding since 1992. We provide lessons suited to all ages and skill levels, in private sessions or small groups."
    ],
    "it": [
      "La Scuola di sci alpino Avoriaz si trova sull'altopiano di Avoriaz. Dal 1992 offriamo il meglio dello sci e dello snowboard. Offriamo lezioni adatte a tutte le età e a tutti i livelli, in lezioni private o in piccoli gruppi."
    ],
    "fr": [
      "L’Avoriaz Alpine Ski School est une école située sur le plateau d’Avoriaz. Nous vous offrons le meilleur du ski et du snowboard depuis 1992. Nous proposons des cours adaptés à tous les âges et à tous les niveaux, en cours privées ou en petits groupes."
    ],
    "es": [
      "La escuela de esquí alpino de Avoriaz está situada en la meseta de Avoriaz. Desde 1992 le ofrecemos lo mejor en esquí y snowboard. Ofrecemos cursos para todas las edades y niveles, en clases particulares o en pequeños grupos."
    ],
    "nl": [
      "De Avoriaz Alpine Ski School is een skischool gelegen op het plateau van Avoriaz. Wij bieden sinds 1992 het beste op het gebied van skiën en snowboarden. We verzorgen lessen voor alle leeftijden en niveaus, in privélessen of in kleine groepen."
    ]
  },
