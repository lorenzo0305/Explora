  "rdfs:comment": {
    "de": [
      "Die Leser können vor Ort verschiedene Bücher konsultieren (kostenloser Service); sie können auch mehrere Bücher für eine bestimmte Zeit ausleihen (kostenpflichtiger Service)."
    ],
    "en": [
      "Readers can consult a variety of books on site (free service); they can also borrow several of them for a set period of time (paid service)."
    ],
    "it": [
      "I lettori possono consultare una serie di libri sul posto (servizio gratuito); possono anche prendere in prestito diversi libri per un periodo determinato (servizio a pagamento)."
    ],
    "fr": [
      "Les lecteurs peuvent consulter sur place des ouvrages divers et variés (service gratuit) ; ils peuvent aussi en emprunter plusieurs pour une durée déterminée (service payant)."
    ],
    "es": [
      "Los lectores pueden consultar diversos libros in situ (servicio gratuito); también pueden tomar prestados varios libros durante un periodo de tiempo determinado (servicio de pago)."
    ],
    "nl": [
      "De lezers kunnen ter plaatse verschillende boeken raadplegen (gratis dienst); zij kunnen ook verschillende boeken lenen voor een bepaalde periode (betalende dienst)."
    ]
  },
