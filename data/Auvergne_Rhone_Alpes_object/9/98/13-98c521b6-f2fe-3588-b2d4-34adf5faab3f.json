  "rdfs:comment": {
    "de": [
      "Das Saint Gervais Hôtel & Spa Handwritten Collection, ein 4-Sterne-Hotel mit 75 Zimmern, heißt Sie das ganze Jahr über willkommen. Das Hotel liegt gegenüber der Tramway du Mont-Blanc und verbindet historischen Charme mit Jugendstil. Es ist perfekt für Ihre Freizeit- und Geschäftsaufenthalte."
    ],
    "en": [
      "The Saint Gervais Hôtel & Spa Handwritten Collection is open all year round for your leisure and business stays.\r\nSituated opposite the Mont-Blanc tramway, this hotel brings an old historic residence back to life with a chic, arty decor."
    ],
    "it": [
      "Il Saint Gervais Hôtel & Spa Handwritten Collection, un hotel 4 stelle con 75 camere, vi accoglie tutto l'anno. Situato di fronte al tram del Monte Bianco, unisce il fascino storico all'art nouveau, perfetto per soggiorni di piacere e d'affari."
    ],
    "fr": [
      "Le Saint Gervais Hôtel & Spa Handwritten Collection, hôtel 4 étoiles de 75 chambres, vous accueille toute l'année. Situé face au Tramway du Mont-Blanc, il allie charme historique et art nouveau, parfait pour vos séjours loisirs et professionnels."
    ],
    "nl": [
      "Het Saint Gervais Hôtel & Spa Handwritten Collection, een 4-sterrenhotel met 75 kamers, verwelkomt je het hele jaar door. Het ligt tegenover de Mont Blanc Tramway en combineert historische charme met art nouveau, perfect voor zowel een toeristisch als zakelijk verblijf."
    ],
    "es": [
      "El Saint Gervais Hôtel & Spa Handwritten Collection, hotel de 4 estrellas y 75 habitaciones, le da la bienvenida todo el año. Situado frente al tranvía del Mont Blanc, combina el encanto histórico con el art nouveau, perfecto tanto para estancias de ocio como de negocios."
    ]
  },
