  "rdfs:comment": {
    "de": [
      "Das Restaurant Le Cin5 in La Clusaz, 1 Stern im Guide Michelin. Während der Wintersaison öffnet dieses gemütliche und leckere Kleinod seine Türen für einige Monate voller kreativer und schmackhafter Küche."
    ],
    "en": [
      "Restaurant Le Cin5 in La Clusaz, 1 Michelin star. During the winter season, this cosy, gourmet gem opens its doors to you for a few months of creative, tasty cuisine."
    ],
    "it": [
      "Ristorante Le Cin5 a La Clusaz, 1 stella della Guida Michelin. Durante la stagione invernale, questo accogliente gioiello gastronomico vi apre le porte per alcuni mesi di cucina creativa e gustosa."
    ],
    "fr": [
      "Le Restaurant Le Cin5 à La Clusaz, 1 étoile au Guide Michelin. Pendant les saisons d'hiver, ce petit bijou cosy et gourmand vous ouvre ses portes pour quelques mois de cuisine créative et savoureuse."
    ],
    "es": [
      "Restaurante Le Cin5 en La Clusaz, 1 estrella en la Guía Michelin. Durante la temporada de invierno, esta acogedora joya gastronómica le abre sus puertas durante unos meses de cocina creativa y sabrosa."
    ],
    "nl": [
      "Restaurant Le Cin5 in La Clusaz, 1 ster in de Michelingids. Tijdens het winterseizoen opent dit gezellige, gastronomische juweeltje zijn deuren voor je voor een paar maanden creatieve, smakelijke gerechten."
    ]
  },
