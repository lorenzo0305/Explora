  "rdfs:comment": {
    "de": [
      "Das Restaurant kehrt mit einer neuen Speisekarte zu seinen Wurzeln zurück, die die Freuden des Essens und die Großzügigkeit der wärmenden Gerichte aus den Bergen feiert. Eine intime und authentische Adresse am Fuße der Skilifte des Mont d'Arbois."
    ],
    "en": [
      "The restaurant is returning to its roots with a new menu celebrating the pleasures of the table and the generosity of comforting mountain dishes. An intimate and authentic spot at the foot of the Mont d'Arbois ski lifts."
    ],
    "it": [
      "Il ristorante torna alle sue radici con un nuovo menu che celebra i piaceri della tavola e la generosità dei piatti di montagna. Un indirizzo intimo e autentico ai piedi degli impianti di risalita del Mont d'Arbois."
    ],
    "fr": [
      "Le restaurant opère un retour aux sources avec une nouvelle carte célébrant les plaisirs de la table et la générosité des plats réconfortants de la montagne. Une adresse intimiste et authentique au pied des remontées mécaniques du Mont d’Arbois."
    ],
    "nl": [
      "Het restaurant keert terug naar zijn wortels met een nieuwe kaart die het plezier van de tafel en de gulheid van comfortabele berggerechten viert. Een intiem en authentiek adres aan de voet van de skiliften van de Mont d'Arbois."
    ],
    "es": [
      "El restaurante vuelve a sus raíces con una nueva carta que celebra los placeres de la mesa y la generosidad de los reconfortantes platos de montaña. Una dirección íntima y auténtica a los pies de los remontes del Mont d'Arbois."
    ]
  },
  "rdfs:label": {
