  "rdfs:comment": {
    "de": [
      "Lust auf einen Ausflug in die Natur?\r\nEntdecken Sie Epicur?Van, Ihren Mietservice für umgebaute Vans in Coubon!\r\nBegeben Sie sich auf ein Abenteuer in aller Freiheit, allein, zu zweit oder mit der Familie."
    ],
    "en": [
      "Looking for an escape to the heart of nature?\r\nDiscover Epicur?Van, your converted van rental service in Coubon!\r\nEnjoy the freedom of adventure, alone, as a couple or with the whole family."
    ],
    "it": [
      "Cercate una fuga nel cuore della natura?\r\nScoprite Epicur?Van, il vostro servizio di noleggio di furgoni trasformati a Coubon!\r\nPartite all'avventura in piena libertà, da soli, in coppia o in famiglia."
    ],
    "fr": [
      "Envie d’évasion au cœur de la nature ?\r\nDécouvrez Epicur’Van, votre service de location de vans aménagés à Coubon !\r\nPartez à l’aventure en toute liberté, en solo, en couple ou en famille."
    ],
    "es": [
      "¿Busca una escapada al corazón de la naturaleza?\r\nDescubra Epicur Van, su servicio de alquiler de furgonetas transformadas en Coubon\r\nEmprenda una aventura en total libertad, solo, en pareja o en familia."
    ],
    "nl": [
      "Op zoek naar een ontsnapping naar het hart van de natuur?\r\nOntdek Epicur?Van, uw verhuurservice voor omgebouwde bestelwagens in Coubon!\r\nGa in alle vrijheid op avontuur, alleen, met z'n tweeën of met het gezin."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Epicur'Van"
    ]
  },
