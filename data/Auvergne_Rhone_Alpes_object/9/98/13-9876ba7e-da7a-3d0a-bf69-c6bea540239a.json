  "rdfs:comment": {
    "de": [
      "Wenn Sie das Keramikmuseum verlassen, müssen Sie nur 30 m gehen, um in mein Atelier zu gelangen, in dem ich Krüge, Vasen, Schalen, Teller und persönliche Gegenstände aus Steingut herstelle."
    ],
    "en": [
      "On leaving the ceramics museum, you will only have to walk 30 m to enter the workshop where I make pitchers, vases, bowls, dishes and personal objects in stoneware."
    ],
    "it": [
      "Quando si esce dal museo della ceramica, basta camminare per 30 metri per entrare nel laboratorio dove realizzo brocche, vasi, ciotole, piatti e oggetti personali in gres."
    ],
    "fr": [
      "En sortant du musée de la céramique, vous n’aurez que 30 m à parcourir pour pénétrer dans l’atelier où je fabrique pichets, vases, bols, plats et objets personnels en grès."
    ],
    "nl": [
      "Als u het keramiekmuseum verlaat, hoeft u maar 30 meter te lopen om het atelier binnen te gaan waar ik kannen, vazen, kommen, schalen en persoonlijke voorwerpen in steengoed maak."
    ],
    "es": [
      "Al salir del museo de cerámica, sólo hay que caminar 30 metros para entrar en el taller donde hago jarras, jarrones, cuencos, platos y objetos personales de gres."
    ]
  },
  "rdfs:label": {
