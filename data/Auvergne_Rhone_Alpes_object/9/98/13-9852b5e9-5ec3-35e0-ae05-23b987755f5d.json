  "rdfs:comment": {
    "de": [
      "In Moulins bietet das L?Aparté hausgemachte Gerichte an, die je nach Jahreszeit regelmäßig wechseln. Man findet hier gut ausgeführte französische Rezepte und eine abwechslungsreiche Schiefertafel."
    ],
    "en": [
      "In Moulins, L'Aparté offers homemade dishes that change regularly with the seasons. The menu features well-executed French recipes and a varied slate of dishes."
    ],
    "it": [
      "A Moulins, L'Aparté offre piatti casalinghi che cambiano regolarmente con le stagioni. Il menu presenta ricette francesi ben eseguite e una varietà di piatti."
    ],
    "fr": [
      "À Moulins, L’Aparté propose des plats faits maison qui changent régulièrement selon les saisons. On y retrouve des recettes françaises bien exécutées et des ardoises variées."
    ],
    "nl": [
      "In Moulins biedt L'Aparté huisgemaakte gerechten die regelmatig veranderen met de seizoenen. Op het menu staan goed uitgevoerde Franse recepten en een gevarieerd aanbod van gerechten."
    ],
    "es": [
      "En Moulins, L'Aparté ofrece platos caseros que cambian regularmente con las estaciones. La carta ofrece recetas francesas bien ejecutadas y una pizarra variada de platos."
    ]
  },
  "rdfs:label": {
