  "rdfs:comment": {
    "de": [
      "Freizeitzentrum in Vallon Pont d'Arc (07150) am Flussufer, geöffnet 7T/7T von Ostern bis Anfang Oktober. Flussabfahrten auf der Ardèche in Eigenregie oder mit BEES-Betreuung."
    ],
    "en": [
      "Leisure center located in Vallon Pont d'Arc (07150) on the banks of the river, open 7 days a week from Easter to early October. Descents of the Ardèche on your own or with BEES supervision."
    ],
    "it": [
      "Centro ricreativo situato a Vallon Pont d'Arc (07150) sulle rive del fiume, aperto 7 giorni su 7 da Pasqua a inizio ottobre. Discesa dell'Ardèche da soli o con un supervisore BEES."
    ],
    "fr": [
      "Base de loisirs située à Vallon Pont d'Arc (07150) en bord de rivière, ouverte 7J/7J de Pâques à début Octobre. Descentes de l'Ardèche en autonomie ou avec un encadrement BEES."
    ],
    "es": [
      "Centro de ocio situado en Vallon Pont d'Arc (07150), a orillas del río, abierto los 7 días de la semana desde Semana Santa hasta principios de octubre. Descenso del Ardèche por su cuenta o con un supervisor de BEES."
    ],
    "nl": [
      "Afdaling met begeleider,  strand"
    ]
