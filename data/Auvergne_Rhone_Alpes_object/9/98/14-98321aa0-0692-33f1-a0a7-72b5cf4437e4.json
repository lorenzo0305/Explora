  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/07d4b316-eda1-367e-b39c-d0305034a5b5",
      "dc:description": {
        "de": [
          "Die 1963 gegründete und auf Immobilientransaktionen spezialisierte Agence du Golf hat sich im Laufe der Jahre ihr Know-how und ihren Bekanntheitsgrad angeeignet, um Ihnen den besten Service zu bieten."
        ],
        "en": [
          "Founded in 1963, Agence du Golf specializes in real estate transactions and has built up its know-how and reputation over the years to provide you with the very best service."
        ],
        "it": [
          "Fondata nel 1963, l'Agence du Golf è specializzata in transazioni immobiliari e ha costruito la sua esperienza e la sua reputazione nel corso degli anni per offrirvi il miglior servizio."
        ],
        "fr": [
          "Fondée en 1963, l'Agence du Golf spécialisée en transactions immobilières a acquis son savoir-faire et sa notoriété au fil des années pour vous apporter le meilleur des services."
        ],
        "es": [
          "Fundada en 1963, la Agence du Golf está especializada en transacciones inmobiliarias y ha ido acumulando su experiencia y reputación a lo largo de los años para ofrecerle el mejor servicio."
        ],
        "nl": [
          "Agence du Golf, opgericht in 1963, is gespecialiseerd in vastgoedtransacties en heeft in de loop der jaren haar expertise en reputatie opgebouwd om je de allerbeste service te kunnen bieden."
        ]
      },
      "@type": [
        "Description"
