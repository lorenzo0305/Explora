  "rdfs:comment": {
    "de": [
      "Community Work ist ein Geschäftszentrum, das schlüsselfertige Dienstleistungen für Unternehmen anbietet. Hier finden Sie Arbeitsräume (Büros, Besprechungsräume, Schulungen, Veranstaltungen), aber auch spezielle Dienstleistungen wie Domizilierung."
    ],
    "en": [
      "Community Work is a business center offering turnkey services to companies. You'll find workspaces (offices, meeting rooms, training, events), as well as specific services such as domiciliation."
    ],
    "it": [
      "Community Work è un business center che offre servizi \"chiavi in mano\" alle aziende. Troverete spazi di lavoro (uffici, sale riunioni, formazione, eventi), oltre a servizi specifici come la domiciliazione."
    ],
    "fr": [
      "Community Work est un centre d'affaires qui offre des services clés en main aux entreprises. Vous y trouverez des espaces de travail (bureaux, salles de réunion, formations, événementiels), mais aussi des services spécifiques comme la domiciliation."
    ],
    "nl": [
      "Community Work is een bedrijvencentrum dat kant-en-klare diensten aanbiedt aan bedrijven. Je vindt er werkruimtes (kantoren, vergaderzalen, opleidingen, evenementen), maar ook specifieke diensten zoals domiciliëring."
    ],
    "es": [
      "Community Work es un centro de negocios que ofrece servicios llave en mano a las empresas. Encontrarás espacios de trabajo (despachos, salas de reuniones, formación, eventos), así como servicios específicos como la domiciliación."
    ]
  },
  "rdfs:label": {
