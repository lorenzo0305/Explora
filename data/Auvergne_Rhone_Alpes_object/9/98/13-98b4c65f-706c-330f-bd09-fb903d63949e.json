  "rdfs:comment": {
    "de": [
      "Das Château de Goutelas bietet Catering für Gruppen ab 8 Personen und nur nach vorheriger Reservierung. Die Küche ist traditionell mit lokalen Produkten."
    ],
    "en": [
      "For your seminars, stays or events, Goutelas offers traditional, convivial cuisine, prepared on site using local produce. Catering for groups, by reservation only."
    ],
    "it": [
      "Per i vostri seminari, vacanze o eventi, Goutelas offre una cucina tradizionale e accogliente, preparata in loco con prodotti locali. Catering per gruppi, solo su prenotazione."
    ],
    "fr": [
      "Pour vos séminaires, séjours ou événements, Goutelas propose une cuisine traditionnelle et conviviale, préparée sur place avec des produits locaux. Restauration pour groupes, uniquement sur réservation."
    ],
    "nl": [
      "Voor uw seminars, vakanties of evenementen biedt Goutelas een traditionele, vriendelijke keuken, ter plaatse bereid met lokale producten. Catering voor groepen, alleen op reservering."
    ],
    "es": [
      "Para sus seminarios, vacaciones o eventos, Goutelas le propone una cocina tradicional y acogedora elaborada in situ con productos locales. Catering para grupos, previa reserva."
    ]
  },
