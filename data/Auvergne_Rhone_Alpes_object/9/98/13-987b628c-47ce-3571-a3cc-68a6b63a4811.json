  "rdfs:comment": {
    "de": [
      "Familien-Chalet seit 1974 auf dem Gipfel des Pléney, 200m nach der Ankunft der Seilbahn.\r\nHausgemachte Küche aus den Bergen.\r\nSpezialitäten: hausgemachte Quiche, vegetarische Gerichte."
    ],
    "en": [
      "Family chalet since 1974 at the top of Pléney, 200m after the arrival of the cable cars.\r\nSpecialities : Home-made quiche, Vegetarian dishes.\r\nMountain home-made cuisine."
    ],
    "it": [
      "Chalet familiare dal 1974 in cima al Pléney, 200 m dopo l'arrivo delle funivie.\r\nCucina casalinga di montagna.\r\nSpecialità: quiche fatte in casa, piatti vegetariani."
    ],
    "fr": [
      "Chalet familial depuis 1974 au sommet du Pléney, 200m après l'arrivée des télécabines.\r\nCuisine montagnarde faite maison.\r\nSpécialités : Quiche maison, plats végétariens."
    ],
    "nl": [
      "Familie gerund chalet sinds 1974 op de top van Le Pléney, 200m na de aankomst van de kabelbanen.\r\nHuisgemaakte bergkeuken.\r\nSpecialiteiten: huisgemaakte quiche, vegetarische gerechten."
    ],
    "es": [
      "Chalet familiar desde 1974 en la cima del Pléney, 200 m después de la llegada de los teleféricos.\r\nCocina casera de montaña.\r\nEspecialidades: quiche casera, platos vegetarianos."
    ]
  },
