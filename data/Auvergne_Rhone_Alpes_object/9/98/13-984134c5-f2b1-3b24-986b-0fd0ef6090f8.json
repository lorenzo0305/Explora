  "rdfs:comment": {
    "de": [
      "Seit 2009 bietet dieser Betrieb Setzlinge und verarbeitete Produkte aus handwerklich hergestelltem Bio-Eisenkraut an. Außerdem verkauft er eine große Auswahl an Bio-Gemüse-, Blumen- und Obstpflanzen."
    ],
    "en": [
      "Since 2009, this farm has been selling plants and processed products made from artisanal organic verbena. It also sells a wide range of organic vegetable, flower and fruit plants."
    ],
    "it": [
      "Dal 2009, questa azienda agricola vende piante di verbena biologiche e prodotti trasformati. Vende anche un'ampia gamma di piante biologiche di ortaggi, fiori e frutta."
    ],
    "fr": [
      "Depuis 2009, cette exploitation propose des plants et produits transformés à base de verveine bio artisanale. Elle vends aussi un large choix de plants de légumes, de fleurs et de fruits bio."
    ],
    "nl": [
      "Sinds 2009 verkoopt deze boerderij biologische verbenaplanten en verwerkte producten. Het verkoopt ook een breed scala aan biologische groente-, bloemen- en fruitplanten."
    ],
    "es": [
      "Desde 2009, esta granja vende plantas de verbena ecológicas y productos elaborados. También vende una amplia gama de plantas ecológicas de hortalizas, flores y frutas."
    ]
  },
  "rdfs:label": {
