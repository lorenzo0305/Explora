  "rdfs:comment": {
    "de": [
      "Der RANDOLAND-Parcours ist eine Schnitzeljagd, die für Kinder von 4 bis 12 Jahren konzipiert wurde. Lösen Sie mit Hilfe des Inspektors Rando die Rätsel im Maison du terroir beaujolais!"
    ],
    "en": [
      "The RANDOLAND course is a treasure-hunting game designed for children from 4 to 12 years old. With the help of Inspector Rando, come and solve the riddles of the Maison du terroir Beaujolais!"
    ],
    "it": [
      "Il percorso RANDOLAND è una caccia al tesoro pensata per i bambini dai 4 ai 12 anni. Con l'aiuto dell'ispettore Rando, venite a risolvere gli enigmi della Maison du Terroir Beaujolais!"
    ],
    "fr": [
      "Le parcours RANDOLAND est un jeu de piste conçu pour les enfants de 4 à 12 ans. Avec l'aide de l'inspecteur Rando, venez résoudre les énigmes de la Maison du terroir beaujolais !"
    ],
    "es": [
      "La ruta RANDOLAND es una búsqueda del tesoro diseñada para niños de 4 a 12 años. Con la ayuda del inspector Rando, ven a resolver los enigmas de la Maison du Terroir Beaujolais"
    ],
    "nl": [
      "Het RANDOLAND-pad is een speurtocht voor kinderen van 4 tot 12 jaar. Kom met de hulp van inspecteur Rando de raadsels oplossen in het Maison du Terroir Beaujolais!"
    ]
  },
