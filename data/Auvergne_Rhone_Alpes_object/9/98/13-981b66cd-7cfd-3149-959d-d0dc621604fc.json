  "rdfs:comment": {
    "de": [
      "Anaïs und Romain, die sich für die Natur, die Berge und gutes Essen begeistern, haben den Dorfgasthof in Saint Jean d'Arvey übernommen. Sie bieten Ihnen leckere und moderne Gerichte, die mit hochwertigen lokalen Produkten zubereitet werden."
    ],
    "en": [
      "Lovers of nature, mountains and good food, Anaïs and Romain took over the inn of the village of Saint Jean d'Arvey. They offer gourmet and modern dishes prepared with quality local products."
    ],
    "it": [
      "Anaïs e Romain, appassionati di natura, montagna e buona cucina, hanno rilevato la locanda del villaggio di Saint Jean d'Arvey. Offrono piatti moderni e gourmet, preparati con prodotti locali di qualità."
    ],
    "fr": [
      "Anaïs et Romain, passionnés par la nature, les montagnes et le bien manger, ont repris l’auberge du village de Saint Jean d’Arvey. Ils vous proposent des plats gourmands et modernes, préparés avec des produits locaux de qualité."
    ],
    "es": [
      "Anaïs y Romain, apasionados por la naturaleza, la montaña y la buena comida, se han hecho cargo de la posada del pueblo de Saint Jean d'Arvey. Le ofrecen platos modernos y gourmet, preparados con productos locales de calidad."
    ],
    "nl": [
      "Anaïs en Romain, gepassioneerd door de natuur, de bergen en lekker eten, hebben de dorpsherberg in Saint Jean d'Arvey overgenomen. Zij bieden u moderne en gastronomische gerechten, bereid met lokale kwaliteitsproducten."
    ]
  },
