  "rdfs:comment": {
    "de": [
      "Justine und Bastien halten etwa 60 Ziegen in biologischem Anbau auf den Hochebenen des Cézallier. Sie verarbeiten die Milch zu Käse, Milchprodukten, Joghurt, Camemberts und Tomes. Der Großteil der Produktion wird direkt vermarktet."
    ],
    "en": [
      "Justine and Bastien raise around sixty organically-farmed goats on the Cézallier high plateaux. They transform the milk into cheeses, dairy products, yoghurts, camemberts and tomes. Most of their production is sold directly."
    ],
    "it": [
      "Justine e Bastien allevano una sessantina di capre con metodi biologici sugli altipiani del Cézallier. Il latte viene trasformato in formaggi, latticini, yogurt, camembert e tome. La maggior parte della produzione viene venduta direttamente."
    ],
    "fr": [
      "Justine et Bastien élèvent une soixantaine de chèvres en Agriculture Biologique sur les hauts plateaux du Cézallier. Ils transforment le lait en fromages, produits laitiers, yaourts, camemberts et tomes. L’essentiel de la production est vendu en direct."
    ],
    "es": [
      "Justine y Bastien crían unas sesenta cabras con métodos ecológicos en las altas mesetas del Cézallier. Transforman la leche en quesos, productos lácteos, yogures, camemberts y tomates. La mayor parte de su producción se vende directamente."
    ],
    "nl": [
      "Justine en Bastien houden ongeveer zestig geiten met biologische landbouwmethoden op de hoogvlakten van de Cézallier. Ze verwerken de melk tot kazen, zuivelproducten, yoghurts, camemberts en tomes. Het grootste deel van hun productie wordt rechtstreeks verkocht."
    ]
  },
  "rdfs:label": {
