  "rdfs:comment": {
    "de": [
      "Profitieren Sie von vielfältigen Reitangeboten. Als echter Stall bieten wir Ihnen eine Pension für Ihr Pferd: Strohboxen mit Fenster, Möglichkeit zum Paddock-Ausgang, Pferdearbeit, Unterricht ..."
    ],
    "en": [
      "Take advantage of a variety of equestrian services. A real stable, we offer you a boarding house for your horse: straw box with window, possibility to leave the paddock, work on the horse, lessons. ..."
    ],
    "it": [
      "Godetevi una varietà di servizi equestri. Come una vera e propria scuderia, vi offriamo una pensione per il vostro cavallo: box di paglia con finestra, possibilità di lasciare il paddock, lavoro a cavallo, lezioni..."
    ],
    "fr": [
      "Profitez de prestations équestres variées. Véritable écurie, nous vous proposons une pension pour votre cheval : box paille avec fenêtre, possibilité de sortie de paddock, travail du cheval, cours. .."
    ],
    "nl": [
      "Geniet van een verscheidenheid aan paardensport diensten. Als een echte stal bieden wij u een pension voor uw paard: strobox met raam, mogelijkheid om de paddock te verlaten, paardenwerk, lessen..."
    ],
    "es": [
      "Disfrute de una variedad de servicios ecuestres. Como un verdadero establo, le ofrecemos una pensión para su caballo: box de paja con ventana, posibilidad de dejar el paddock, trabajo del caballo, lecciones..."
    ]
  },
  "rdfs:label": {
