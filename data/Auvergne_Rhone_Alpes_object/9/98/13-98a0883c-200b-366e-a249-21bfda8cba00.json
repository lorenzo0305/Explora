  "rdfs:comment": {
    "de": [
      "Nur wenige Schritte von der Basilika Fourvière entfernt bietet dieses Restaurant im ehemaligen Kloster Couvent des Visitandines im historischen Zentrum von Lyon ein einzigartiges und individuelles Erlebnis, ideal für Geschäftsessen sowie private und geschäftliche Veranstaltungen."
    ],
    "en": [
      "Just a stone's throw from the Basilica of Fourvière, this restaurant, located in the former Couvent des Visitandines in the historic heart of Lyon, offers a unique and personalized experience, ideal for business meals as well as private and corporate events."
    ],
    "it": [
      "A due passi dalla Basilica di Fourvière, questo ristorante, situato nell'antico convento delle Visitandine nel cuore storico di Lione, offre un'esperienza unica e personalizzata, ideale per pranzi di lavoro, eventi privati e aziendali."
    ],
    "fr": [
      "À deux pas de la Basilique de Fourvière, ce restaurant, dans l’ancien Couvent des Visitandines en plein cœur historique de Lyon, offre une expérience unique et personnalisée, idéale pour les repas d’affaires ainsi que les événements privés et d’entreprise"
    ],
    "nl": [
      "Op een steenworp afstand van de Basiliek van Fourvière biedt dit restaurant in het voormalige klooster van de Visitandines in het historische hart van Lyon een unieke en persoonlijke ervaring, ideaal voor zakendiners en privé- en bedrijfsevenementen"
    ],
    "es": [
      "A pocos pasos de la basílica de Fourvière, este restaurante, situado en el antiguo convento de las Visitandinas, en pleno centro histórico de Lyon, ofrece una experiencia única y personalizada, ideal para comidas de negocios, así como para eventos privados y de empresa."
    ]
  },
