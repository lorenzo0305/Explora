  "rdfs:comment": {
    "de": [
      "Grafikdesign ? Illustration ? Motion Design - Made in Haut-Lignon\r\nIch begleite Handwerker, Händler, kleine und mittelständische Unternehmen und Vereine der Region, um ihre Kommunikation anzukurbeln, sowohl im Print- als auch im Digitalbereich."
    ],
    "en": [
      "Graphic design ? Illustration ? Motion Design - Made in Haut-Lignon\r\nI help local craftsmen, shopkeepers, SMEs and associations boost their communications, both in print and digital."
    ],
    "it": [
      "Design grafico? Illustrazione? Motion Design - Made in Haut-Lignon\r\nCollaboro con artigiani, negozianti, PMI e associazioni locali per potenziare la loro comunicazione, sia cartacea che digitale."
    ],
    "fr": [
      "Graphisme • Illustration • Motion Design - Made in Haut-Lignon\r\nJ’accompagne les artisans, commerçants, PME et associations du territoire pour booster leur communication, en print comme en digital."
    ],
    "es": [
      "¿Diseño gráfico? Ilustración ? Motion Design - Made in Haut-Lignon\r\nTrabajo con artesanos, comerciantes, PYME y asociaciones locales para impulsar su comunicación, tanto impresa como digital."
    ],
    "nl": [
      "Grafisch ontwerp? Illustratie ? Motion Design - Gemaakt in Haut-Lignon\r\nIk werk samen met lokale ambachtslieden, winkeliers, KMO's en verenigingen om hun communicatie een boost te geven, zowel in print als digitaal."
    ]
  },
  "rdfs:label": {
