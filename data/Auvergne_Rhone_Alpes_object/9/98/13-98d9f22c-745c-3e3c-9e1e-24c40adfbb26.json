  "rdfs:comment": {
    "de": [
      "Wir befinden uns in einer Kirche aus dem 11. Jahrhundert, die unter Denkmalschutz steht und in eine Weinkellerei umgewandelt wurde."
    ],
    "en": [
      "The abbey wine cellars in Sainte Ma- rie Church and is now a winery, in the heart of Chauriat, a pretty wine produ- cing village in Auvergne. Discover our traditional methods, using Gamay and Chardonnay wine varieties."
    ],
    "it": [
      "Ci troviamo in una chiesa dell'XI secolo, classificata come monumento storico e trasformata in deposito di vino."
    ],
    "fr": [
      "Nous sommes situés dans une église du XIe siècle, inscrite aux Monuments Historiques et transformée en chais."
    ],
    "nl": [
      "Wij zijn gevestigd in een kerk uit de 11e eeuw, die op de monumentenlijst staat en is omgebouwd tot wijnpakhuis."
    ],
    "es": [
      "Nos encontramos en una iglesia del siglo XI, catalogada como monumento histórico y convertida en almacén de vinos."
    ]
  },
