  "rdfs:comment": {
    "de": [
      "Entdecken Sie meine kreative und experimentelle Welt. Mir liegt es am Herzen, Objekte zu schaffen, die sowohl nützlich als auch sinnstiftend sind und Sie glücklich machen."
    ],
    "en": [
      "Come and discover my creative and experimental world. My aim is to create objects that are useful, meaningful and make you happy."
    ],
    "it": [
      "Venite a scoprire il mio mondo creativo e sperimentale. Il mio obiettivo è creare oggetti utili, significativi e che rendano felici."
    ],
    "fr": [
      "Venez découvrir mon univers créatif et expérimental. J’ai à cœur de créer des objets à la fois utiles, porteurs de sens et qui vous rendent heureux."
    ],
    "es": [
      "Ven a descubrir mi mundo creativo y experimental. Mi objetivo es crear objetos que sean útiles, tengan sentido y te hagan feliz."
    ],
    "nl": [
      "Kom en ontdek mijn creatieve en experimentele wereld. Mijn doel is om objecten te maken die nuttig en betekenisvol zijn en je blij maken."
    ]
  },
