  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/b5f91e76-8594-3021-ae87-25b2a04fc4f6",
      "dc:description": {
        "de": [
          "Hunde- und Katzenpflegesalon.\n\nIhr vierbeiniger Freund verdient nur das Beste! Nutzen Sie unseren Hundesalon für einen Moment der Entspannung und Schönheit für Ihren Hund."
        ],
        "en": [
          "Canine and feline grooming salon.\n\nYour four-legged friend deserves the best! Take advantage of our grooming salon for a moment of relaxation and beauty for your dog."
        ],
        "it": [
          "Salone di toelettatura per cani e gatti.\n\nIl vostro amico a quattro zampe merita il meglio! Approfittate del nostro salone di toelettatura per un momento di relax e bellezza per il vostro cane."
        ],
        "fr": [
          "Salon de toilettage canin et félin.\n\nVotre compagnon à quatre pattes mérite le meilleur ! Profitez de notre salon de toilettage pour un moment de détente et de beauté pour votre chien."
        ],
        "es": [
          "Peluquería canina y felina.\n\n¡Su amigo de cuatro patas se merece lo mejor! Aproveche nuestro salón de peluquería para un momento de relajación y belleza para su perro."
        ],
        "nl": [
          "Honden- en kattentrimsalon.\n\nJe viervoeter verdient het beste! Maak gebruik van onze trimsalon voor een moment van ontspanning en schoonheid voor je hond."
        ]
      },
