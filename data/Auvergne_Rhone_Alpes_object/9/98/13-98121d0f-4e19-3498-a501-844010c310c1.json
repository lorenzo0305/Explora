  "rdfs:comment": {
    "de": [
      "In 3400 m Höhe, an der Ankunft der Standseilbahn, befindet sich die Eishöhle von 2 Alpes, die von den beiden Bergführern Bernard Lambolez und Bruno Gardent gestaltet wurde. Unter 30 m jahrtausendealtem Eis können Sie eine wunderbare Welt der Skulpturen entdecken."
    ],
    "en": [
      "At 3400 m of altitude, at the arrival of the Jandri Express, the ice cave of Les 2 Alpes shaped by 2 high mountain guides, Bernard Lambolez and Bruno Gardent, allows you to discover under 30 m of thousand-year-old ice a marvellous world of sculptures."
    ],
    "it": [
      "A 3400 m di altitudine, all'arrivo del Jandri Express, la grotta di ghiaccio di Les 2 Alpes, modellata da 2 guide d'alta montagna, Bernard Lambolez e Bruno Gardent, permette di scoprire sotto i 30 m di ghiaccio secolare un meraviglioso mondo di sculture."
    ],
    "fr": [
      "A 3400 m d'altitude, à l'arrivée du Funiculaire, la grotte de glace des 2 Alpes façonnée par 2 guides de haute montagne, Bernard Lambolez et Bruno Gardent, vous permet de découvrir sous 30 m de glaces millénaires un monde merveilleux de sculptures."
    ],
    "nl": [
      "Op 3400 m hoogte, bij de aankomst van de kabelbaan, kunt u in de ijsgrot van Les 2 Alpes, gecreëerd door twee gidsen uit het hooggebergte, Bernard Lambolez en Bruno Gardent, een wonderlijke wereld van sculpturen onder 30 meter ijs ontdekken."
    ],
    "es": [
      "A 3400 m de altitud, a la llegada del Funicular, la cueva de hielo de Les 2 Alpes, creada por dos guías de alta montaña, Bernard Lambolez y Bruno Gardent, permite descubrir un maravilloso mundo de esculturas bajo 30 metros de hielo."
    ]
  },
  "rdfs:label": {
    "en": [
      "Ice Cave 3400m"
    ],
    "it": [
      "Grotta di ghiaccio 3400m"
    ],
    "fr": [
      "Grotte de Glace 3400m"
    ]
  },
