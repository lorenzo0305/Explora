  "rdfs:comment": {
    "de": [
      "Die Bergführer nehmen Sie mit auf Wanderungen, zur Entdeckung des Kulturerbes, zum Klettern oder Mountainbiken, von den Ufern des Genfer Sees bis in die Berge, vom Plateau de Gavot bis ins Vallée d'Abondance. Aktivitäten für jedes Alter und jedes Niveau."
    ],
    "en": [
      "Our mountain guides will take you hiking, climbing, mountain biking or discovering our heritage, from the shores of Lake Geneva to the mountains, from the Gavot plateau to the Abondance valley. Activities for all ages and abilities."
    ],
    "it": [
      "Le nostre guide alpine vi accompagneranno in escursioni, passeggiate nel patrimonio, arrampicate o gite in mountain bike, dalle rive del Lago di Ginevra alle montagne, dall'altopiano del Gavot alla valle dell'Abondance. Attività per tutte le età e capacità."
    ],
    "fr": [
      "Les Guides en Montagne vous emmènent en randonnée, à la découverte du patrimoine, en grimpe ou en VTT, des bords du lac Léman à la montagne, du plateau de Gavot à la vallée d'Abondance. Des activités pour tous les âges et tous les niveaux."
    ],
    "nl": [
      "Onze berggidsen nemen je mee op trektochten, erfgoedwandelingen, klimmen of mountainbiken, van de oevers van het meer van Genève tot de bergen, van het plateau van Gavot tot de vallei van Abondance. Activiteiten voor alle leeftijden en niveaus."
    ],
    "es": [
      "Nuestros guías de montaña le llevarán a practicar senderismo, paseos por el patrimonio, escalada o bicicleta de montaña, desde las orillas del lago Lemán hasta las montañas, desde la meseta de Gavot hasta el valle de Abondance. Actividades para todas las edades y capacidades."
    ]
  },
  "rdfs:label": {
    "de": [
      "Alp'Evianature - Büro der Bergführer"
    ],
