  "rdfs:comment": {
    "de": [
      "Produzent von Saint-Nectaire fermier, Milchkonfitüre und Weizenmehl. Keksfabrik auf dem Bauernhof.\r\nDirektverkauf auf dem Bauernhof - Vom Erzeuger zum Verbraucher / pädagogischer Bauernhof (Kälber, Kühe, Ponys, Ziegen, Kaninchen)."
    ],
    "en": [
      "Producer of farmhouse Saint-Nectaire, milk jam and wheat flour. Cookie factory on the farm.\r\nDirect farm sales - From producer to consumer / educational farm (calves, cows, ponies, goats, rabbits)."
    ],
    "it": [
      "Produttore di formaggio di fattoria Saint-Nectaire, marmellata di latte e farina di grano. Biscottificio in azienda.\r\nVendita diretta in azienda - Dal produttore al consumatore / fattoria didattica (vitelli, mucche, pony, capre, conigli)."
    ],
    "fr": [
      "Producteur de Saint-Nectaire fermier, confiture de lait et farine de blé. Biscuiterie à la ferme.\r\nVente directe à la ferme - Du producteur au consommateur / ferme pédagogique (veaux, vaches, poneys, chèvres, lapins)."
    ],
    "es": [
      "Productor de queso de granja Saint-Nectaire, mermelada de leche y harina de trigo. Fábrica de galletas en la granja.\r\nVenta directa en granja - Del productor al consumidor / granja educativa (terneros, vacas, ponis, cabras, conejos)."
    ],
    "nl": [
      "Producent van boerenkaas Saint-Nectaire, melkjam en tarwemeel. Koekjesfabriek op de boerderij.\r\nDirecte boerderijverkoop - Van producent naar consument / educatieve boerderij (kalveren, koeien, pony's, geiten, konijnen)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ferme de la vallée de l'avenir"
    ]
  },
