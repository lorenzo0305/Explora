  "rdfs:comment": {
    "de": [
      "Charmante Wasserfläche zum Schwimmen, allein, mit Freunden oder der Familie. \r\nVerschiedene Aktivitäten sorgen für einen erholsamen Aufenthalt. Tretboote können vor Ort gemietet werden.\r\n\r\nVORÜBERGEHEND GESCHLOSSEN – AUS GESUNDHEITLICHEN GRÜNDEN"
    ],
    "en": [
      "Charming lake for swimming, alone, with friends or family. \r\nA range of activities to help you relax and unwind. Pedalos for hire on site.\r\n\r\nTEMPORARILY CLOSED FOR HEALTH REASONS"
    ],
    "it": [
      "Un delizioso specchio d'acqua per nuotare da soli, con gli amici o con la famiglia.\r\nUna serie di attività per rilassarsi e distendersi. Noleggio di pedalò in loco."
    ],
    "fr": [
      "Charmant plan d'eau pour une baignade, seul, entre amis ou en famille. \r\nDiverses activités vous permettront de passer un excellent moment de détente. Location de pédalos sur place."
    ],
    "es": [
      "Una agradable extensión de agua para nadar, solo, con amigos o en familia.\r\nNumerosas actividades para relajarse y desconectar. Alquiler de pedales in situ."
    ],
    "nl": [
      "Een heerlijk stuk water om in te zwemmen, alleen, met vrienden of familie.\r\nVerschillende activiteiten om te ontspannen en tot rust te komen. Waterfietsen te huur ter plaatse."
    ]
  },
  "rdfs:label": {
    "de": [
      "Baden – Plan d'Eau de la Loge"
    ],
    "en": [
      "Swimming - La Loge Lake"
    ],
    "fr": [
      "Baignade - Plan d'Eau de la Loge"
    ]
  },
