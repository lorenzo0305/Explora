  "rdfs:comment": {
    "de": [
      "Die Gemeinde Satolas-et-Bonce hat seit Juli 2021 mehrere Spielanlagen für alle zur Verfügung gestellt! Verbringen Sie mit Ihrer Familie oder Ihren Freunden eine schöne Zeit im \"Parc des Lurons\" und entdecken Sie diesen schönen Ort und seine Einrichtungen."
    ],
    "en": [
      "Since July 2021, the commune of Satolas-et-Bonce has made several play facilities available for everyone! Come and spend a good time at the \"Parc des Lurons\" with family or friends to discover this beautiful space and its facilities."
    ],
    "it": [
      "Dal luglio 2021, il Comune di Satolas-et-Bonce ha messo a disposizione una serie di strutture ludiche per tutti! Venite a trascorrere un po' di tempo al \"Parc des Lurons\" con la vostra famiglia o i vostri amici per scoprire questa bellissima zona e le sue strutture."
    ],
    "fr": [
      "La commune de Satolas-et-Bonce a mis à disposition depuis juillet 2021 plusieurs équipements ludiques destinés à tous! Venez passer un bon moment au \"Parc des Lurons\" en famille ou entre amis pour découvrir ce bel espace et ses installations."
    ],
    "nl": [
      "Sinds juli 2021 heeft de gemeente Satolas-et-Bonce een aantal speelvoorzieningen beschikbaar gesteld voor iedereen! Kom met je gezin of vrienden naar het \"Parc des Lurons\" om dit prachtige gebied en zijn faciliteiten te ontdekken."
    ],
    "es": [
      "Desde julio de 2021, el municipio de Satolas-et-Bonce pone a disposición de todos numerosas instalaciones lúdicas Venga a pasar un rato en el \"Parc des Lurons\" con su familia o amigos para descubrir esta hermosa zona y sus instalaciones."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Parc des Lurons"
    ]
  },
