  "rdfs:comment": {
    "de": [
      "Unsere Weinkeller befinden sich in Beaujeu, der historischen Hauptstadt des Beaujolais.\r\n\r\nWir bieten ein komplettes Sortiment an Rot-, Weiß- und Roséweinen aus den Crus der Region an."
    ],
    "en": [
      "Owner and wine merchant from father to son since 1820, our cellars are located in Beaujeu, the historic capital of the Beaujolais region.\r\n\r\nWe offer a complete range of the region's Crus in red, white and rosé wines."
    ],
    "it": [
      "Proprietario e commerciante di vini da padre in figlio dal 1820, le nostre cantine si trovano a Beaujeu, la capitale storica della regione del Beaujolais.\r\n\r\nOffriamo una gamma completa di vini rossi, bianchi e rosati della regione."
    ],
    "fr": [
      "Propriétaire et négociant en vins de père en fils depuis 1820, nos caves sont situées à Beaujeu capitale historique du Beaujolais.\r\n\r\nNous proposons une gamme complète des Crus de la région en vins rouges, blancs et rosés."
    ],
    "es": [
      "Propietario y comerciante de vinos de padre a hijo desde 1820, nuestras bodegas están situadas en Beaujeu, la capital histórica de la región del Beaujolais.\r\n\r\nOfrecemos una gama completa de vinos tintos, blancos y rosados de la región."
    ],
    "nl": [
      "Eigenaar en wijnhandelaar van vader op zoon sinds 1820, onze kelders bevinden zich in Beaujeu, de historische hoofdstad van de Beaujolais streek.\r\n\r\nWij bieden een compleet assortiment rode, witte en rosé wijnen uit de regio."
    ]
  },
  "rdfs:label": {
