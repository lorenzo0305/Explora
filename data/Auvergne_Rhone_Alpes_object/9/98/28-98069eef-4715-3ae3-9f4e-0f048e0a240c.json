      "@id": "https://data.datatourisme.fr/95b24be1-c6e1-3700-8c94-97bc1ef93541",
      "dc:description": {
        "de": [
          "Das Le Bracelet d'Argent im Stadtzentrum bietet Ihnen orientalische und französische Küche, die Sie mit der Familie, mit Freunden oder Kollegen genießen können."
        ],
        "en": [
          "Le Bracelet d'Argent, located in the city center, offers Oriental and French cuisine to enjoy with family, friends or colleagues."
        ],
        "it": [
          "Le Bracelet d'Argent, situato nel centro della città, offre cucina orientale e francese da gustare con la famiglia, gli amici o i colleghi."
        ],
        "fr": [
          "Le Bracelet d'Argent, situé dans le centre-ville, vous propose une cuisine orientale et française à déguster en famille, entre amis ou entre collègues."
        ],
        "es": [
          "Le Bracelet d'Argent, situado en el centro de la ciudad, ofrece cocina oriental y francesa para disfrutar con la familia, los amigos o los colegas."
        ],
        "nl": [
          "Le Bracelet d'Argent, gelegen in het stadscentrum, biedt Oosterse en Franse gerechten om van te genieten met familie, vrienden of collega's."
        ]
      },
