  "rdfs:comment": {
    "de": [
      "Das Restaurant Bikube ist eine Klammer in den Farben des Mittelmeers, sonnig von Natur aus und ein Feinschmeckerlokal par excellence. Hier reiht sich ein kulinarisches Ziel an das andere, und die mediterranen Traditionen werden mit zeitgenössischen Elementen neu interpretiert. Willkommen an Bord!"
    ],
    "en": [
      "The Bikube restaurant is a Mediterranean escape, naturally sunlit and exceptionally gourmet. Culinary destinations follow one another, and Mediterranean traditions are revisited with a contemporary twist. Welcome aboard!"
    ],
    "it": [
      "Il ristorante Bikube è una parentesi nei colori del Mediterraneo, solare per natura e gourmet per eccellenza. Una destinazione culinaria si sussegue all'altra, e le tradizioni mediterranee vengono rivisitate in chiave contemporanea. Benvenuti a bordo!"
    ],
    "fr": [
      "Le restaurant Bikube est une parenthèse aux couleurs de la Méditerranée, ensoleillée par nature, gourmande par excellence. Les destinations culinaires s’enchaînent et les traditions méditerranéennes sont revues à la sauce contemporaine. Bienvenue à bord !"
    ],
    "nl": [
      "Het restaurant Bikube is een intermezzo in de kleuren van de Middellandse Zee, zonnig van aard en gastronomisch bij uitstek. De ene culinaire bestemming volgt op de andere en mediterrane tradities krijgen een eigentijdse draai. Welkom aan boord!"
    ],
    "es": [
      "El restaurante Bikube es un paréntesis en los colores del Mediterráneo, soleado por naturaleza y gastronómico por excelencia. Un destino culinario tras otro, y las tradiciones mediterráneas con un toque contemporáneo. ¡Bienvenido a bordo!"
    ]
  },
