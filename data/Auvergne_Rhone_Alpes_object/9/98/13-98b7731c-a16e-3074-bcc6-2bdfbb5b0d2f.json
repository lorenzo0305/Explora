  "rdfs:comment": {
    "de": [
      "Das TMG, drei Orte der künstlerischen und kulturellen Kreation und Verbreitung in der Stadt Grenoble. Ein Programm in drei Einrichtungen (Grand Théâtre, Théâtre 145 und Théâtre de Poche) mit Theater-, Tanz-, Zirkus- und Straßenkunstaufführungen."
    ],
    "en": [
      "The TMG, 3 venues for artistic and cultural creation and dissemination in Grenoble. 3 venues (the Grand Théâtre, Théâtre 145 and Théâtre de Poche) program theater, dance, circus and street arts."
    ],
    "it": [
      "Il TMG, 3 luoghi di creazione e diffusione artistica e culturale a Grenoble. Un programma di spettacoli di teatro, danza e circo in tre sedi (il Grand Théâtre, il Théâtre 145 e il Théâtre de Poche)."
    ],
    "fr": [
      "Le TMG, 3 lieux de création et de diffusion artistiques et culturelles de la ville de Grenoble. Une programmation dans trois salles (le Grand Théâtre, le Théâtre 145 et le Théâtre de Poche) de spectacles de théâtre, de danse et de cirque ."
    ],
    "nl": [
      "Het TMG, 3 podia voor artistieke en culturele creatie en verspreiding in Grenoble. Een programma met theater-, dans- en circusvoorstellingen in drie zalen (het Grand Théâtre, het Théâtre 145 en het Théâtre de Poche)."
    ],
    "es": [
      "El TMG, 3 espacios de creación y difusión artística y cultural en Grenoble. 3 salas (Grand Théâtre, Théâtre 145 y Théâtre de Poche) de teatro, danza, circo y artes de calle."
    ]
  },
