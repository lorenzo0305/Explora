  "rdfs:comment": {
    "de": [
      "Montagne Sensation mit Sitz in Faverges-Seythenex ist ein echter Schöpfer von Bergerlebnissen mit mehr als 20 Jahren Erfahrung in Outdoor-Aktivitäten und der Begleitung von begeisterten Menschen."
    ],
    "en": [
      "Montagne Sensation, based in Faverges-Seythenex, is a true creator of mountain experiences, with over 20 years of expertise in outdoor activities and guiding enthusiasts."
    ],
    "it": [
      "Montagne Sensation, con sede a Faverges-Seythenex, è un vero e proprio creatore di esperienze in montagna, con oltre 20 anni di esperienza nelle attività all'aperto e nella guida degli appassionati."
    ],
    "fr": [
      "Montagne Sensation, implanté à Faverges-Seythenex, est un véritable créateur d’expériences de montagne, avec plus de 20 ans d’expertise dans les activités outdoor et l’accompagnement de passionnés."
    ],
    "nl": [
      "Montagne Sensation, gevestigd in Faverges-Seythenex, is een echte schepper van bergervaringen, met meer dan 20 jaar ervaring in outdooractiviteiten en het gidsen van liefhebbers."
    ],
    "es": [
      "Montagne Sensation, con sede en Faverges-Seythenex, es un auténtico creador de experiencias de montaña, con más de 20 años de experiencia en actividades al aire libre y guiando a los aficionados."
    ]
  },
