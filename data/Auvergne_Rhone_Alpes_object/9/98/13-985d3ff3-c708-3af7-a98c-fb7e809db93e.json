  "rdfs:comment": {
    "de": [
      "Erleben Sie das Außergewöhnliche! Skifahren abseits der Pisten, Skitouren, Eisklettern, Schneeschuhwandern mit Bergführern, die auf ihre Disziplinen spezialisiert sind."
    ],
    "en": [
      "Experience the exceptional! Off-piste skiing, ski touring, ice climbing, snowshoeing with mountain guides specialized in their disciplines."
    ],
    "it": [
      "Vivete un'esperienza eccezionale! Sci fuori pista, sci alpinismo, arrampicata su ghiaccio, escursioni con le racchette da neve con guide alpine specializzate nelle loro discipline."
    ],
    "fr": [
      "Vivez l’exceptionnel ! Ski hors-piste, ski de randonnée, cascade de glace, raquettes avec des guides de haute montagne spécialisés dans leurs disciplines."
    ],
    "es": [
      "¡Viva una experiencia excepcional! Esquí fuera de pista, esquí de travesía, escalada en hielo, raquetas de nieve con guías de montaña especializados en sus disciplinas."
    ],
    "nl": [
      "Beleef het uitzonderlijke! Skiën buiten de pistes, toerskiën, ijsklimmen, sneeuwschoenwandelen... Dankzij het gidsenbureau van Méribel, in het hart van de 3 Valleien in de Savoie, het grootste skigebied ter wereld!"
    ]
  },
  "rdfs:label": {
    "en": [
