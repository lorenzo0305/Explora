  "rdfs:comment": {
    "de": [
      "Yogastellungen dehnen die Muskeln, lockern die Gelenke, beleben den Körper, regen die Verdauung an, verbessern die Blutzirkulation und die Atmung, bringen eine bessere Konzentration und eine bessere körperliche und psychische Gesundheit."
    ],
    "en": [
      "Yoga poses stretch the muscles, loosen the joints, invigorate the body, stimulate digestion, improve blood circulation and breathing, bring better concentration, physical and psychological health."
    ],
    "it": [
      "Le posizioni di yoga stirano i muscoli, sbloccano le articolazioni, rigenerano il corpo, stimolano la digestione, migliorano la circolazione sanguigna e la respirazione, offrono una maggiore concentrazione, una migliore salute fisica e psicologica."
    ],
    "fr": [
      "Les postures de yoga étirent les muscles, débloquent les articulations, vivifient le corps, stimulent la digestion, améliorent la circulation sanguine et la respiration, apporte une meilleure concentration, une meilleure santé physique et psychologique."
    ],
    "nl": [
      "Yoga houdingen rekken de spieren, deblokkeren de gewrichten, stimuleren het lichaam, stimuleren de spijsvertering, verbeteren de bloedsomloop en ademhaling, brengen een betere concentratie, een betere fysieke en psychische gezondheid."
    ],
    "es": [
      "Las posturas de yoga estiran los músculos, desbloquean las articulaciones, vigorizan el cuerpo, estimulan la digestión, mejoran la circulación sanguínea y la respiración, aportan mayor concentración y mejoran la salud física y psicológica."
    ]
  },
