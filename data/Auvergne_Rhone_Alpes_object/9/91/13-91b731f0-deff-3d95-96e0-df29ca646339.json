  "rdfs:comment": {
    "de": [
      "Eine akustische, visuelle, immersive, sensible und mit unveröffentlichten Archiven gespickte Erfahrung, um die Geschichte des Widerstands im Vercors zu entdecken."
    ],
    "en": [
      "This memorial, above Vassieux, is the centre piece of a circuit which encourages  the discovery of sites of events involving Resistance fighters took place, and to understand what occurred here 50 years ago."
    ],
    "it": [
      "Un'esperienza immersiva, sensibile, sonora e visiva, punteggiata da archivi inediti, per scoprire la storia della resistenza nel Vercors."
    ],
    "fr": [
      "Une expérience sonore, visuelle, immersive, sensible et ponctuée d'archives inédites, à la découverte de l'histoire de la résistance dans le Vercors."
    ],
    "es": [
      "Una experiencia inmersiva, sensitiva, sonora y visual, salpicada de archivos inéditos, para descubrir la historia de la resistencia en el Vercors."
    ],
    "nl": [
      "Treed binnen in de vesting (architecturaal werk dat erg tot de verbeelding spreekt). Maak kennis met het dagelijks leven van de maquisards (regie, beeld, geluid en licht). Een symbolisch parcours van schaduw naar licht (codes die te ontcijferen zijn tot de uitzichttoren)."
    ]
  },
