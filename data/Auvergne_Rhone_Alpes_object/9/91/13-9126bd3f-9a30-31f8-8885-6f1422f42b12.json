  "rdfs:comment": {
    "de": [
      "Die Stadt Roanne liegt im Norden des Departements Loire und bildet einen strategischen Knotenpunkt zwischen Lyon, Saint-Etienne und Clermont-Ferrand."
    ],
    "en": [
      "Located in the north of the Loire department, the city of Roanne is a strategic crossroads between Lyon, Saint-Etienne and Clermont-Ferrand."
    ],
    "it": [
      "Situata nel nord del dipartimento della Loira, la città di Roanne è un crocevia strategico tra Lione, Saint-Etienne e Clermont-Ferrand."
    ],
    "fr": [
      "Située au nord du département de la Loire, la ville de Roanne constitue un carrefour stratégique entre Lyon, Saint-Etienne et Clermont-Ferrand."
    ],
    "es": [
      "Situada al norte del departamento del Loira, la ciudad de Roanne es un cruce estratégico entre Lyon, Saint-Etienne y Clermont-Ferrand."
    ],
    "nl": [
      "De stad Roanne, gelegen in het noorden van het departement Loire, is een strategisch kruispunt tussen Lyon, Saint-Etienne en Clermont-Ferrand."
