  "rdfs:comment": {
    "de": [
      "Ihr Experte für Bienenzucht und Bienenprodukte.\nEntdecken Sie unser umfassendes Angebot an Imkereiausrüstung und genießen Sie den besten Honig,\ndirekt aus unseren ökologischen Bienenstöcken.\nTaufe in der Imkerei nach Vereinbarung."
    ],
    "en": [
      "Your expert in beekeeping and hive products.\nDiscover our full range of beekeeping equipment and enjoy the best of honey,\ndirectly from our ecological hives.\nIntroduction to beekeeping by appointment."
    ],
    "it": [
      "Il vostro esperto in apicoltura e prodotti per alveari.\nScoprite la nostra gamma completa di attrezzature per l'apicoltura e godetevi il miglior miele,\ndirettamente dalle nostre arnie ecologiche.\nIntroduzione all'apicoltura su appuntamento."
    ],
    "fr": [
      "Votre expert en apiculture et produits de la ruche.\nDécouvrez notre gamme complète d'équipements d'apiculture et savourez le meilleur du miel,\ndirectement issu de nos ruches écologiques.\nBaptême d'apiculture sur RDV."
    ],
    "nl": [
      "Uw expert in bijenteelt en bijenkorfproducten.\nOntdek ons volledige assortiment bijenteeltmateriaal en geniet van de beste honing,\nrechtstreeks uit onze ecologische bijenkasten.\nIntroductie tot bijenteelt op afspraak."
    ],
    "es": [
      "Su experto en apicultura y productos para colmenas.\nDescubra toda nuestra gama de material apícola y disfrute de la mejor miel\ndirectamente de nuestras colmenas ecológicas.\nIntroducción a la apicultura con cita previa."
    ]
  },
