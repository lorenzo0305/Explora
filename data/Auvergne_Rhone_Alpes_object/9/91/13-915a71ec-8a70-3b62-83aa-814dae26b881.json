  "rdfs:comment": {
    "de": [
      "Herzliche und familiäre Atmosphäre!!!\r\nIn der gemütlichen Umgebung von St Bonnet Les Oules empfängt Sie die Auberge du Château und bereitet Ihnen nette kleine Gerichte wie zu Hause zu und lässt Sie an geselligen Momenten teilhaben."
    ],
    "en": [
      "It is in the warm setting of their inn in St Bonnet Les Oules that Philippe and Florence welcome you to enjoy some delicious authentic dishes and share in some moments of conviviality."
    ],
    "it": [
      "Atmosfera calda e familiare!\r\nNella calda cornice di St Bonnet Les Oules, L'Auberge du Château vi accoglie e prepara piatti piacevoli come se foste a casa vostra e condivide momenti di convivialità."
    ],
    "fr": [
      "Ambiance chaleureuse et familiale !! \r\nDans le cadre chaleureux de St Bonnet Les Oules, L'Auberge du Château vous accueille et vous mitonne des petits plats sympas comme à la maison et vous faire partager des moments de convivialité."
    ],
    "es": [
      "¡Ambiente cálido y familiar!\r\nEn el cálido entorno de St Bonnet Les Oules, L'Auberge du Château le da la bienvenida y le prepara agradables platos como si estuviera en casa y comparte momentos de convivencia."
    ],
    "nl": [
      "Warme en familiale sfeer!\r\nIn het warme kader van St Bonnet Les Oules ontvangt L'Auberge du Château u en bereidt lekkere gerechten alsof u thuis bent en deelt momenten van gezelligheid."
    ]
  },
