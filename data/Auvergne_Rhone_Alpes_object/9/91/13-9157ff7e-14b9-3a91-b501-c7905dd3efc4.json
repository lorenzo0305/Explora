  "rdfs:comment": {
    "de": [
      "Es liegt auf der Tour du Beaufortain, in der Nähe des Lac des fées. Brigitte bietet Getränke, Snacks und kleine savoyische Gerichte an. Ruhe, Schönheit der Almen, Beratung zu Wanderungen."
    ],
    "en": [
      "Located on the Tour du Beaufortain, near the Lac des Fées. Brigitte offers drinks, snacks and snacks Savoyard. Tranquility, beauty of the pastures, advice on hiking."
    ],
    "it": [
      "Situato sul tour del Beaufortain, vicino al Lac des Fées. Brigitte propone bevande, spuntini e merende savoiarde. Pace e tranquillità, bellezza degli alpeggi, consigli per le escursioni."
    ],
    "fr": [
      "Situé sur le tour du Beaufortain, à proximité du lac des fées. Brigitte propose des boissons, casse croûte et petite restauration savoyarde. Tranquillité, beauté des alpages, conseil sur les randonnées."
    ],
    "es": [
      "Situado en el recorrido de Beaufortain, cerca del Lac des Fées. Brigitte ofrece bebidas, aperitivos y tentempiés saboyanos. Tranquilidad, la belleza de los pastos de montaña, consejos sobre senderismo."
    ],
    "nl": [
      "Gelegen aan de rondleiding door Beaufortain, vlakbij het meer van feeën. Brigitte biedt drankjes, snacks en kleine Savoyaardse catering. Rust, schoonheid van de bergweiden, advies over wandelen."
    ]
  },
  "rdfs:label": {
