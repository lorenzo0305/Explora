  "rdfs:comment": {
    "de": [
      "Eine kürzlich gemachte archäologische Entdeckung hat ein Manuskript aus dem 19. Jahrhundert ans Licht gebracht, in dem der \"Heilige Birnbaum von Valloire\" erwähnt wird. Ermitteln Sie fast 200 Jahre später und versuchen Sie herauszufinden, wo sich der berühmte heilige Birnbaum verbirgt!"
    ],
    "en": [
      "A recent archaeological find has unearthed a 19th-century manuscript which mentions the \"Sacred Pear Tree of Valloire\". Nearly 200 years later, take part in an investigation to find out where the famous sacred pear tree is hidden!"
    ],
    "it": [
      "Un recente ritrovamento archeologico ha portato alla luce un manoscritto risalente al XIX secolo che menziona il \"Sacro Pero di Valloire\". Quasi 200 anni dopo, partecipate a un'indagine per scoprire dove si nasconde il famoso pero sacro!"
    ],
    "fr": [
      "Une découverte archéologique récente a mis au jour un manuscrit datant du 19e siècle dans lequel il est mentionné le “Poirier sacré de la Valloire”. Près de 200 ans plus tard, menez l’enquête pour tenter découvrir où se cache le fameux poirier sacré !"
    ],
    "es": [
      "Un reciente hallazgo arqueológico ha desenterrado un manuscrito del siglo XIX que menciona el \"Peral sagrado de Valloire\". Casi 200 años después, ¡participa en una investigación para descubrir dónde se esconde el famoso peral sagrado!"
    ],
    "nl": [
      "Een recente archeologische ontdekking heeft een manuscript uit de 19e eeuw aan het licht gebracht waarin de \"Heilige perenboom van Valloire\" wordt genoemd. Bijna 200 jaar later, neem deel aan een onderzoek om uit te vinden waar de beroemde heilige perenboom verborgen is!"
    ]
  },
  "rdfs:label": {
    "de": [
      "Interaktives Suchspiel \"Auf der Suche nach dem heiligen Birnbaum\"."
    ],
    "ru": [
      "Интерактивный поиск сокровищ \"В поисках священного грушевого дерева\"."
    ],
    "en": [
      "Interactive treasure hunt \"In search of the sacred pear tree\"."
    ],
    "it": [
      "Caccia al tesoro interattiva \"Alla ricerca del pero sacro\"."
    ],
    "fr": [
      "Jeu de piste interactif \"A la recherche du poirier sacré\""
    ],
    "zh": [
      "互动寻宝游戏 \"寻找神圣的梨树\"。"
    ],
    "nl": [
      "Interactieve schattenjacht \"Op zoek naar de heilige perenboom\"."
    ],
    "es": [
      "Búsqueda del tesoro interactiva \"En busca del peral sagrado\"."
    ]
  },
