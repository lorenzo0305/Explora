  "rdfs:comment": {
    "de": [
      "2 neue Escape-Game-Räume in Valence! Die \"Super Alpha World\" (familienfreundlicher Raum, Retrogaming-Atmosphäre und Arcade-Spiele) und \"Le Manoir des Sœurs Aubépine\" (komplexer und beängstigender Raum, erst ab 15 Jahren freigegeben) warten nur auf Sie!"
    ],
    "en": [
      "2 new escape game rooms in Valence! The \"Super Alpha World\" (family room, retrogaming atmosphere and arcade games) and \"Le Manoir des Sœurs Aubépine\" (complex and frightening room, forbidden to under 15s) are waiting for you!"
    ],
    "it": [
      "2 nuove sale giochi a Valence! Il \"Super Alpha World\" (sala per famiglie, atmosfera retrogaming e giochi arcade) e \"Le Manoir des S?urs Aubépine\" (sala complessa e spaventosa, vietata ai minori di 15 anni) vi aspettano!"
    ],
    "fr": [
      "2 nouvelles salles d'escape game à Valence ! La \"Super Alpha World\" (salle familiale, ambiance rétrogaming et jeux d'arcade) et \"Le Manoir des Sœurs Aubépine\" (salle complexe et angoissante, interdite au moins de 15 ans) n'attendent plus que vous !"
    ],
    "es": [
      "¡2 nuevas salas de juegos de escape en Valence! Le esperan \"Super Alpha World\" (sala familiar, ambiente retro y juegos arcade) y \"Le Manoir des Sœurs Aubépine\" (sala compleja y terrorífica, prohibida a menores de 15 años)"
    ],
    "nl": [
      "2 nieuwe escape game rooms in Valence! De \"Super Alpha World\" (familiekamer, retrogaming sfeer en arcade games) en \"Le Manoir des Sœurs Aubépine\" (complexe en angstaanjagende kamer, verboden voor jongeren onder de 15 jaar) wachten op jullie!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Escape Time"
    ]
  },
