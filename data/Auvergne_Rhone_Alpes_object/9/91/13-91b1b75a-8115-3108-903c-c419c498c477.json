  "rdfs:comment": {
    "de": [
      "In diesem Hotel**** können Sie sich in unserem Restaurant entspannen. Mittags gibt es eine Formel für einen einfachen Snack. Abends gibt es traditionelle und gesellige Küche, ohne die unumgänglichen Savoyer Spezialitäten zu vergessen."
    ],
    "en": [
      "Come and relax in our restaurant at ****. At lunchtime, you can enjoy a light snack. In the evening, traditional, convivial cuisine, not forgetting the unmissable Savoyard specialties."
    ],
    "it": [
      "Venite a rilassarvi nel nostro ristorante all'indirizzo ****. A pranzo potrete gustare un semplice spuntino. La sera, cucina tradizionale e conviviale, senza dimenticare le imperdibili specialità savoiarde."
    ],
    "fr": [
      "Dans cet hôtel****, venez vous détendre dans notre restaurant. A midi, formule pour grignoter en toute simplicité. Le soir, cuisine traditionnelle et conviviale, sans oublier les incontournable spécialités savoyardes."
    ],
    "es": [
      "Venga a relajarse a nuestro restaurante en ****. Al mediodía, podrá disfrutar de un sencillo tentempié. Por la noche, cocina tradicional y acogedora, sin olvidar las imperdibles especialidades saboyanas."
    ],
    "nl": [
      "Kom ontspannen in ons restaurant op ****. s Middags kunt u genieten van een eenvoudige snack. s Avonds traditionele, gezellige gerechten en niet te vergeten de niet te missen specialiteiten uit de Savoie."
    ]
  },
