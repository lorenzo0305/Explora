  "rdfs:comment": {
    "de": [
      "Das Krankenhauszentrum Roanne (das zu den sechs größten öffentlichen Einrichtungen außerhalb des CHU in der Region zählt) umfasst dank der Mobilisierung von mehr als 2300 Fachkräften, darunter über 200 Ärzte, alle medizinischen und chirurgischen Fachgebiete."
    ],
    "en": [
      "The Roanne hospital (ranked among the six largest public establishments outside the region's university hospital) includes all medical and surgical specialties thanks to the mobilization of more than 2,300 professionals, including more than 200 physicians."
    ],
    "it": [
      "L'ospedale di Roanne (classificato tra le sei più grandi strutture pubbliche al di fuori dell'ospedale universitario della regione) copre tutte le specialità mediche e chirurgiche grazie alla mobilitazione di più di 2.300 professionisti, tra cui oltre 200 medici."
    ],
    "fr": [
      "Le centre hospitalier de Roanne (classé parmi les six plus grands établissements publics hors CHU de la région) regroupe toutes les spécialités médicales et chirurgicales grâce à la mobilisation de plus de 2 300 professionnels, dont plus de 200 médecins."
    ],
    "nl": [
      "Het ziekenhuis van Roanne (gerangschikt onder de zes grootste openbare instellingen buiten het universitaire ziekenhuis van de regio) bestrijkt alle medische en chirurgische specialiteiten dankzij de inzet van meer dan 2300 professionals, waaronder meer dan 200 artsen."
    ],
    "es": [
      "El hospital de Roanne (clasificado entre los seis mayores establecimientos públicos fuera del hospital universitario de la región) cubre todas las especialidades médicas y quirúrgicas gracias a la movilización de más de 2.300 profesionales, entre ellos más de 200 médicos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Centre Hospitalier de Roanne"
    ]
  },
