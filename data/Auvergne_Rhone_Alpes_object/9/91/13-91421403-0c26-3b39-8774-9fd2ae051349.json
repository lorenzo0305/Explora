  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Mont-Blanc-Massiv aus dem Flugzeug und fliegen Sie über seine Gletscher - ein unvergesslicher Moment allein, zu zweit oder mit der Familie."
    ],
    "en": [
      "Discover the Mont Blanc mountain range by plane, fly over the glaciers for an unforgettable moment alone, with your partner or with your family."
    ],
    "it": [
      "Scoprite il massiccio del Monte Bianco in aereo e sorvolate i suoi ghiacciai per un momento indimenticabile da trascorrere da soli, in coppia o in famiglia."
    ],
    "fr": [
      "Découvrez le massif du Mont Blanc en avion et survolez ses glaciers pour un moment inoubliable seul, à deux ou en famille."
    ],
    "nl": [
      "Ontdek het Mont Blanc-massief per vliegtuig en vlieg over de gletsjers voor een onvergetelijk moment alleen, met uw partner of met uw gezin."
    ],
    "es": [
      "Descubra el macizo del Mont Blanc en avión y sobrevuele sus glaciares para vivir un momento inolvidable solo, en pareja o en familia."
    ]
  },
