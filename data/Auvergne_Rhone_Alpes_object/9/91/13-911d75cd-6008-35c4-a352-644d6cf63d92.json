  "rdfs:comment": {
    "de": [
      "Das Projekt der Villa Tunisienne wurde kurz vor 1900 von Gilbert Décoret, dem ehemaligen Sekretär und Historiker der Hospize von Vichy, ins Leben gerufen."
    ],
    "en": [
      "The Villa Tunisienne project was launched by Gilbert Décoret, former secretary and historian of the Hospices de Vichy, shortly before 1900."
    ],
    "it": [
      "Il progetto della Villa Tunisienne è stato lanciato da Gilbert Décoret, ex segretario e storico degli ospizi di Vichy, poco prima del 1900."
    ],
    "fr": [
      "Le projet de la villa Tunisienne est lancé par Gilbert Décoret, ancien secrétaire et historien des hospices de Vichy, peu avant 1900."
    ],
    "nl": [
      "Het project Villa Tunisienne werd kort voor 1900 gelanceerd door Gilbert Décoret, een voormalig secretaris en historicus van de hospitalen van Vichy."
    ],
    "es": [
      "El proyecto de la Villa Tunecina fue lanzado por Gilbert Décoret, antiguo secretario e historiador de los hospicios de Vichy, poco antes de 1900."
    ]
