  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/c1b6226d-a6eb-3435-8325-6a18df704017",
      "dc:description": {
        "de": [
          "\"Von unserer Plantage Beussent Lachelle bis zu Ihrem Gaumen gibt es Männer und Frauen, die von ihren Berufen begeistert sind und von demselben Wunsch nach Exzellenz angetrieben werden.\""
        ],
        "en": [
          "\"From our Beussent Lachelle plantation to your palate, there are men and women passionate about their craft, driven by the same desire for excellence.\""
        ],
        "it": [
          "\"Dalla nostra piantagione di Beussent Lachelle al vostro palato, ci sono uomini e donne appassionati del loro lavoro e animati dallo stesso desiderio di eccellenza"
        ],
        "fr": [
          "\"De notre plantation Beussent Lachelle à votre palais, il y a des hommes et des femmes passionnés par leur métiers, animés d'un même désir d'excellence.\""
        ],
        "nl": [
          "\"Van onze plantage in Beussent Lachelle tot uw smaakpapillen zijn er mannen en vrouwen die gepassioneerd zijn over hun werk en gedreven worden door hetzelfde verlangen naar uitmuntendheid"
        ],
        "es": [
          "\"Desde nuestra plantación de Beussent Lachelle hasta su paladar, hay hombres y mujeres apasionados por su trabajo e impulsados por el mismo deseo de excelencia"
        ]
      },
      "@type": [
        "Description"
      ],
