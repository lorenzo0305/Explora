  "rdfs:comment": {
    "de": [
      "Eine Etappe oder ein Aufenthalt gegenüber dem Viadukt von Garabit.\r\nEin 3*-Hotel und ein Gourmetrestaurant, 10 Minuten von der A75 entfernt. Unverbaubarer Blick auf das Viadukt von Gustave Eiffel, das abends beleuchtet wird. Label Restaurant Savoureux.\r\nKomfort- und Superior-Zimmer sowie Junior-Suiten."
    ],
    "en": [
      "A stopover or stay opposite the Viaduc de Garabit.\r\nA 3-star hotel and gourmet restaurant 10 minutes from the A75 motorway. Breathtaking view of Gustave Eiffel's viaduct, illuminated in the evening. Restaurant Savoureux label.\r\nComfort rooms, superior rooms and junior suites."
    ],
    "it": [
      "Una sosta o una vacanza di fronte al Viaduc de Garabit.\r\nHotel 3 stelle e ristorante gourmet a 10 minuti dall'autostrada A75. Vista ininterrotta sul viadotto di Gustave Eiffel, illuminato di sera. Ristorante con etichetta Savoureux.\r\nCamere comfort, camere superior e junior suite."
    ],
    "fr": [
      "Une étape ou séjour face au Viaduc de Garabit.\r\nUn hôtel 3 * et un restaurant gastronomique à 10 min de l'A 75. Vue imprenable sur le viaduc de Gustave Eiffel, illuminé en soirée. Label Restaurant Savoureux.\r\nChambres confort, supérieure et suites junior."
    ],
    "es": [
      "Una parada o unas vacaciones frente al Viaduc de Garabit.\r\nHotel de 3 estrellas y restaurante gastronómico a 10 minutos de la autopista A75. Vista ininterrumpida del viaducto de Gustave Eiffel, iluminado por la noche. Etiqueta Restaurante Savoureux.\r\nHabitaciones confort, superiores y junior suites."
    ],
    "nl": [
      "Een tussenstop of vakantie tegenover het Viaduc de Garabit.\r\nEen 3-sterrenhotel en gastronomisch restaurant op slechts 10 minuten van de snelweg A75. Ononderbroken uitzicht op het viaduct van Gustave Eiffel, 's avonds verlicht. Label restaurant Savoureux.\r\nComfortkamers, superior kamers en junior suites."
    ]
  },
