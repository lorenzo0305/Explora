  "rdfs:comment": {
    "de": [
      "Flug mit einem Gleitschirm. 2-Sitzer. Entdecken Sie die herrlichen Panoramen der provenzalischen Drôme aus der Luft (Flugplätze: Vesc, Roynac...). Erleben Sie eine einzigartige Erfahrung und neue Eindrücke mit erfahrenen, patentierten und qualifizierten Tandemlehrern."
    ],
    "en": [
      "Paragliding. Tandem. Discover the magnificent panoramas of the Drôme provençale from the air (take-off sites: Vesc, Roynac...). Enjoy a unique experience and new sensations with experienced instructors who are both certified and qualified tandem pilots."
    ],
    "it": [
      "Volo in parapendio. Volo in tandem. Scoprite i magnifici panorami della Drôme provenzale dal cielo (siti di decollo: Vesc, Roynac...). Godetevi un'esperienza unica e nuove sensazioni con istruttori esperti, brevettati e qualificati come piloti tandem."
    ],
    "fr": [
      "Vol en parapente. Biplace. Découvrez les magnifiques panoramas de la Drôme provençale vu du ciel (sites d'envol : Vesc, Roynac...). Vivez une expérience unique et des sensations nouvelles avec des moniteurs expérimentés brevetés et qualifiés biplaces."
    ],
    "es": [
      "Vuelo en parapente. Vuelo biplaza. Descubra los magníficos panoramas de la Drôme provenzal desde el cielo (lugares de despegue: Vesc, Roynac...). Disfrute de una experiencia única y de nuevas sensaciones con instructores experimentados, pilotos biplaza titulados y patentados."
    ],
    "nl": [
      "Paragliding. Tandemvlucht. Ontdek de prachtige panorama's van de Drôme provençale vanuit de lucht (opstijgplaatsen: Vesc, Roynac...). Geniet van een unieke ervaring en nieuwe sensaties met ervaren instructeurs die gediplomeerde tandempiloten zijn."
    ]
  },
