  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/7feff999-91e6-3b18-adf0-8e618fc03023",
      "dc:description": {
        "de": [
          "Alexandra bietet Ihnen Obst, Gemüse, lokale und saisonale Produkte, aber auch ein Kühlregal mit einer großen Auswahl an regionalen Käsesorten, Biere aus der Region, lose Ware und ökologische Reinigungsmittel.\nGeöffnet von Montag bis Samstag von 8:30 bis 12:30 Uhr und von 13:30 bis 17:45 Uhr."
        ],
        "en": [
          "Alexandra offers fruit, vegetables, local and seasonal produce, as well as a fresh produce section with a wide selection of regional cheeses, local beers, bulk goods and ecological cleaning products.\nOpen Monday to Saturday, 8.30am to 12.30pm and 1.30pm to 5.45pm."
        ],
        "it": [
          "Alexandra offre frutta, verdura, prodotti locali e di stagione, oltre a una sezione di prodotti freschi con un'ampia selezione di formaggi regionali, birre locali, prodotti sfusi e prodotti ecologici per la pulizia.\nAperto dal lunedì al sabato, dalle 8.30 alle 12.30 e dalle 13.30 alle 17.45."
        ],
        "fr": [
          "Alexandra vous propose des fruits, des légumes, des produits locaux et de saison mais aussi un rayon frais avec une large sélection de fromages régionaux, des bières du coin, du vrac et des produits d'entretien écologiques.\nOuvert du lundi au samedi de 8h30 à 12h30 et de 13h30 à 17h45."
        ],
        "es": [
          "Alexandra ofrece fruta, verdura, productos locales y de temporada, así como una sección de productos frescos con una amplia selección de quesos regionales, cervezas locales, productos a granel y productos de limpieza ecológicos.\nAbierto de lunes a sábado, de 8.30 a 12.30 y de 13.30 a 17.45."
        ],
        "nl": [
          "Alexandra biedt fruit, groenten, lokale en seizoensproducten en een versafdeling met een ruime keuze aan regionale kazen, lokale bieren, bulkproducten en milieuvriendelijke schoonmaakproducten.\nGeopend van maandag tot zaterdag van 8.30 tot 12.30 uur en van 13.30 tot 17.45 uur."
        ]
      },
