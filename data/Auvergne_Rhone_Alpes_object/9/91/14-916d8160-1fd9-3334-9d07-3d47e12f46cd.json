  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/95deb79e-03e2-3618-96fb-4994cc845f41",
      "dc:description": {
        "de": [
          "Pannenhilfe/Abschleppdienst rund um die Uhr und an allen Tagen der Woche -\nWerkstatt für mechanische Reparaturen aller Marken.\nÖffnungszeiten:\nmontag bis Freitag: 8.30 Uhr 12.00 Uhr und 14.00 Uhr 18.00 Uhr"
        ],
        "en": [
          "Breakdown and towing service 24 hours a day, 7 days a week\nAll-makes mechanical repair workshop.\nOpening hours :\nmonday to Friday: 8:30 a.m. to 12:00 p.m. and 2:00 p.m. to 6:00 p.m"
        ],
        "it": [
          "Servizio di soccorso e traino 24 ore su 24, 7 giorni su 7\nOfficina di riparazione meccanica di tutte le marche.\nOrari di apertura:\ndal lunedì al venerdì: dalle 8.30 alle 12.00 e dalle 14.00 alle 18.00"
        ],
        "fr": [
          "Dépannage/remorquage 24h/24h et 7j/7 -\nAtelier de réparation mécanique toutes marques.\nHoraires : \nlundi au vendredi : 8 h 30 12 h 00 et 14 h 00 18 h 00"
        ],
        "es": [
          "Servicio de asistencia en carretera y grúa 24 horas al día, 7 días a la semana\nTaller de reparación mecánica de todas las marcas.\nHorario de apertura :\nde lunes a viernes: de 8.30 a 12.00 h. y de 14.00 a 18.00 h"
        ],
        "nl": [
          "Pech- en sleepdienst 24 uur per dag, 7 dagen per week\nMechanische reparatiewerkplaats voor alle merken.\nOpeningstijden :\nmaandag tot vrijdag: 8.30 tot 12.00 uur en 14.00 tot 18.00 uur"
        ]
      },
