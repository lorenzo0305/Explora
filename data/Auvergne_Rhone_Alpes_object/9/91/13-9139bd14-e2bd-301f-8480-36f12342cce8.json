  "rdfs:comment": {
    "de": [
      "Um Sie zufrieden zu stellen und Ihnen einen angenehmen Urlaub zu ermöglichen, empfangen Sie unsere Aufenthaltsberater (-innen) mit Freundlichkeit und Wohlwollen, um Ihnen ein Maximum an persönlichen Informationen zu geben"
    ],
    "en": [
      "To ensure your satisfaction and make your vacation a pleasant one, our holiday advisors welcome you in a friendly and helpful way to provide you with as much personalized information as possible."
    ],
    "it": [
      "Per soddisfarvi e farvi trascorrere una piacevole vacanza, i nostri consulenti turistici vi accoglieranno con cordialità e gentilezza per darvi il massimo delle informazioni personalizzate"
    ],
    "fr": [
      "Pour vous satisfaire et vous faire passer d'agréables vacances, nos conseillers (ères) en séjour vous accueillent avec convivialité et bienveillance afin de vous donner un maximum d'informations personnalisés"
    ],
    "es": [
      "Para satisfacerle y hacerle pasar unas vacaciones agradables, nuestros asesores de vacaciones le recibirán con simpatía y amabilidad para ofrecerle un máximo de información personalizada"
    ],
    "nl": [
      "Om u tevreden te stellen en u een aangename vakantie te bezorgen, ontvangen onze vakantieadviseurs u met vriendelijkheid en vriendelijkheid om u een maximum aan gepersonaliseerde informatie te geven"
    ]
  },
  "rdfs:label": {
