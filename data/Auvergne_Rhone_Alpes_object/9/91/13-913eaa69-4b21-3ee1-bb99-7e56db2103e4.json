  "rdfs:comment": {
    "de": [
      "Kunsthandwerker Coutelier d'Art, 6. Generation seit 1847. Überlieferte, traditionelle und vollständige Herstellung in unserem Atelier. Exklusives Sortiment an Einzelstücken und hochwertigen Kleinserien."
    ],
    "en": [
      "Artisan Coutelier d'Art, 6th generation since 1847. Ancestral, traditional production entirely in our workshop. Exclusive range of one-off pieces and high-end small series."
    ],
    "it": [
      "Coltelleria artigianale, 6a generazione dal 1847. Produzione ancestrale e tradizionale interamente nel nostro laboratorio. Gamma esclusiva di pezzi unici e piccole serie di alta gamma."
    ],
    "fr": [
      "Artisan Coutelier d'Art, 6ème générations depuis 1847. Fabrication ancestrale, traditionnelle et intégralement dans notre atelier. Gamme exclusive en pièce unique et petites séries haut de gamme."
    ],
    "es": [
      "Cuchillería de Arte Artesano, 6ª generación desde 1847. Fabricación ancestral y tradicional íntegramente en nuestro taller. Gama exclusiva de piezas únicas y pequeñas series de alta gama."
    ],
    "nl": [
      "Artisan Art bestek, 6e generatie sinds 1847. Voorouderlijke, traditionele productie volledig in eigen atelier. Exclusief assortiment van eenmalige stukken en kleine series van topklasse."
    ]
  },
