  "rdfs:comment": {
    "de": [
      "Machen Sie sich auf den Pisten von Chamrousse auf die Suche nach Dinosauriern!\nBeantworten Sie eine Reihe von Fragen zum Namen des Dinos, seiner Ernährung oder auch seiner Größe und holen Sie sich am Ende Ihres Rundgangs Ihr Geschenk in den Touristeninformationen ab."
    ],
    "en": [
      "Set off in search of dinosaurs on the slopes of Chamrousse!\nAnswer a series of questions about the dino's name, diet and size, and at the end of the trail, collect your gift from the Tourist Offices."
    ],
    "it": [
      "Partite alla ricerca dei dinosauri sulle piste di Chamrousse!\r\nRispondete a una serie di domande sul nome del dinosauro, sulla sua dieta e sulle sue dimensioni. Alla fine del percorso, ritirate il vostro regalo presso l'Ufficio del Turismo."
    ],
    "fr": [
      "Partez à la recherche des dinosaures sur les pistes de Chamrousse !\r\nRépondez à une série de questions sur le nom du dino, son régime alimentaire ou encore sa taille et à la fin de votre parcours, venez récupérer votre cadeau aux Offices de Tourisme."
    ],
    "es": [
      "Salga en busca de dinosaurios por las laderas de Chamrousse\r\nResponda a una serie de preguntas sobre el nombre del dinosaurio, su alimentación y su tamaño. Al final del recorrido, recoja su regalo en las Oficinas de Turismo."
    ],
    "nl": [
      "Ga op zoek naar dinosaurussen op de hellingen van Chamrousse!\r\nBeantwoord een reeks vragen over de naam van de dino, zijn dieet en zijn grootte. Haal aan het einde van het parcours je cadeau op bij het Office du Tourisme."
    ]
  },
  "rdfs:label": {
    "de": [
      "Jagd auf Dinos"
    ],
    "en": [
      "Dino hunt"
    ],
    "fr": [
      "Chasse aux dinos"
    ]
  },
