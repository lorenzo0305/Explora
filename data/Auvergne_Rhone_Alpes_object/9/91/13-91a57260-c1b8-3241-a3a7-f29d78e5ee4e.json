  "rdfs:comment": {
    "de": [
      "Die Roannaise de l'Eau schlägt Ihnen vor, sich auf die Suche nach den Regentropfen zu begeben, die sich in Roanne verirrt haben. Auf diesem Spaziergang begleiten Sie Margaux und André, ihren Großvater."
    ],
    "en": [
      "La Roannaise de l'Eau invites you to go in search of the raindrops that have been lost in Roanne. Join Margaux and André, her grandfather, on this walk."
    ],
    "it": [
      "La Roannaise de l'Eau vi invita a partire alla ricerca delle gocce di pioggia che si sono perse a Roanne. Unitevi a Margaux e a suo nonno André in questa passeggiata."
    ],
    "fr": [
      "La Roannaise de l'Eau vous propose de partir à la recherche des gouttes de pluie qui se sont perdues dans Roanne. Dans cette balade vous accompagnerez Margaux et André, son grand-père."
    ],
    "nl": [
      "La Roannaise de l'Eau nodigt je uit om op zoek te gaan naar de regendruppels die verloren zijn gegaan in Roanne. Ga mee met Margaux en haar grootvader André op deze wandeling."
    ],
    "es": [
      "La Roannaise de l'Eau le invita a partir en busca de las gotas de lluvia que se han perdido en Roanne. Acompaña a Margaux y a su abuelo André en este paseo."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Baludik - Promenade sous la pluie"
    ]
  },
