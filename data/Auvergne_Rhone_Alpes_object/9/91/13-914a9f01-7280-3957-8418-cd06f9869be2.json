  "rdfs:comment": {
    "de": [
      "Weingut, das biologischen Anbau betreibt. Seine Einzigartigkeit: ein Weißwein aus Pinot Gris, ein Rotwein, der in Barriques vinifiziert und ausgebaut wird, ein Rosé-Schaumwein nach althergebrachter Methode und ein Likörwein. Einige Cuvées werden in Amphoren vinifiziert. Biodyvin-zertifiziert."
    ],
    "en": [
      "Organic winegrowing estate. Its distinctive features include a Pinot Gris white, a barrel-aged red, an ancestral-method sparkling rosé and a sweet wine. Some cuvées are vinified in amphorae. Biodyvin certified."
    ],
    "it": [
      "Azienda vitivinicola biologica. È unica nel suo genere in quanto produce un Pinot grigio bianco, un vino rosso vinificato e maturato in barrique, un rosé frizzante secondo il metodo ancestrale e un vino dolce. Alcune annate sono vinificate in anfore. Certificato Biodyvin."
    ],
    "fr": [
      "Domaine viticole en Agriculture Biologique. Sa singularité : un blanc de Pinot Gris, un rouge vinifié et élevé en barrique, un rosé effervescent en méthode ancestrale et un liquoreux. Certaines cuvées sont vinifiées en amphores. Certifié Biodyvin."
    ],
    "es": [
      "Explotación vitícola ecológica. Es única porque produce un Pinot Gris blanco, un vino tinto vinificado y criado en barrica, un rosado espumoso según el método ancestral y un vino dulce. Algunas cosechas se vinifican en ánforas. Certificado Biodyvin."
    ],
    "nl": [
      "Biologisch wijnbouwbedrijf. Het is uniek omdat het een witte Pinot Gris produceert, een rode wijn die wordt gevinifieerd en gerijpt in vaten, een mousserende rosé volgens de voorouderlijke methode en een zoete wijn. Sommige jaargangen worden gevinifieerd in amfora's. Biodyvin gecertificeerd."
    ]
  },
  "rdfs:label": {
