  "rdfs:comment": {
    "de": [
      "Bestaunen Sie über 500 Krippen aus allen fünf Kontinenten.\r\nDiese Krippen, deren Größe je nach Land und verwendetem Material variiert, sind auf der 400 m² großen Ausstellungsfläche verteilt."
    ],
    "en": [
      "Come and admire over 500 nativity scenes from all five continents.\r\nThe cribs, which vary in size depending on the country and materials used, are scattered across the 400m² of exhibition space."
    ],
    "it": [
      "Venite ad ammirare oltre 500 presepi provenienti dai cinque continenti. Quest'anno i riflettori sono puntati sul Québec\r\nI presepi, di dimensioni diverse a seconda del Paese e dei materiali utilizzati, sono sparsi nei 400 m² di spazio espositivo"
    ],
    "fr": [
      "Venez admirer plus de 500 crèches en provenance des cinq continents. Cette année le Québec est mis à l'honneur \r\nCes crèches, dont la taille varie en fonction des pays et matériaux utilisés, sont disséminés sur les 400m² de surface exposée"
    ],
    "es": [
      "Venga a admirar más de 500 belenes procedentes de los cinco continentes. Este año, la atención se centra en Quebec\r\nEstos belenes, que varían de tamaño según el país y los materiales utilizados, están repartidos por los 400 m² de exposición"
    ],
    "nl": [
      "Kom en bewonder meer dan 500 kerststallen uit alle vijf continenten.\r\nDe kerststallen, die in grootte variëren afhankelijk van het land en de gebruikte materialen, staan verspreid over de 400m² grote tentoonstellingsruimte."
    ]
  },
  "rdfs:label": {
