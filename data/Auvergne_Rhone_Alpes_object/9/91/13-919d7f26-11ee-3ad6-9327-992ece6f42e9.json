  "rdfs:comment": {
    "de": [
      "Passionierte Designerin von Lederwaren und Prêt-à-porter. Jedes entworfene Stück ist ein Unikat, das in der Werkstatt und Boutique im Herzen von Montbrison von Hand gefertigt wird. Hier finden Sie originelle Modelle, die mit ihrem eigenen Stil und ihrer Persönlichkeit übereinstimmen."
    ],
    "en": [
      "Passionate designer of leather goods and ready-to-wear. Each piece is unique, hand-crafted in the atelier-boutique in the heart of Montbrison. You'll find original designs that resonate with their own style and personality."
    ],
    "it": [
      "Un'appassionata designer di pelletteria e prêt-à-porter. Ogni pezzo è unico, realizzato a mano nel laboratorio-boutique nel cuore di Montbrison. Troverete modelli originali che risuonano con il loro stile e la loro personalità."
    ],
    "fr": [
      "Créatrice passionnée de maroquinerie et de prêt-à-porter. Chaque pièce conçue est unique, façonnée à la main dans l'atelier-boutique, situé au cœur de Montbrison. Vous trouverez des modèles originaux qui résonnent avec leur propre style et personnalité."
    ],
    "nl": [
      "Een gepassioneerd ontwerper van lederwaren en prêt-à-porter. Elk stuk is uniek en wordt met de hand gemaakt in de atelier-winkel in het hart van Montbrison. Je vindt er originele ontwerpen met hun eigen stijl en persoonlijkheid."
    ],
    "es": [
      "Diseñador apasionado de marroquinería y prêt-à-porter. Cada pieza es única, elaborada artesanalmente en el taller-boutique situado en el corazón de Montbrison. Encontrará diseños originales que resuenan con su propio estilo y personalidad."
    ]
  },
