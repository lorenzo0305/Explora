  "rdfs:comment": {
    "de": [
      "Ein gewagtes Spektakel, um einen Teil der Geschichte des Wilden Westens wieder aufleben zu lassen.\r\nHistorische Szenen, Duelle, Kämpfe, Stunts und Pferdevoltigieren, um das Leben im amerikanischen Westen zu entdecken"
    ],
    "en": [
      "A daring show to relive part of the history of the Far West.\r\nHistorical scenes, duels, fights, stunts and equestrian acrobatics to discover the life of the American West"
    ],
    "it": [
      "Un audace spettacolo per rivivere parte della storia del selvaggio West.\r\nScene storiche, duelli, combattimenti, acrobazie e acrobazie equestri per scoprire la vita del West americano"
    ],
    "fr": [
      "Un spectacle audacieux pour revivre une partie de l'histoire du far west.\r\nDes scènes historiques, duels, combats, cascades et voltiges équestres pour découvrir la vie de l'ouest Américain"
    ],
    "es": [
      "Un espectáculo audaz para revivir parte de la historia del Salvaje Oeste.\r\nEscenas históricas, duelos, peleas, acrobacias y acrobacias ecuestres para descubrir la vida del Oeste americano"
    ],
    "nl": [
      "Een gedurfde show om een deel van de geschiedenis van het Wilde Westen opnieuw te beleven.\r\nHistorische scènes, duels, gevechten, stunts en ruiteracrobatiek om het leven van het Amerikaanse Westen te ontdekken"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Spectacle nocturne équestre \"Western\""
    ]
  },
