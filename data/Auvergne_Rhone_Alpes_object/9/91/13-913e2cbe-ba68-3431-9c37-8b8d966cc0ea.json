  "rdfs:comment": {
    "de": [
      "Entdecken Sie mit Ihrer Familie die Abenteuerlust beim Geocaching wieder: Dank einer App finden Sie mehrere Verstecke! Eine spielerische Art, die Gemeinde zu entdecken, die Groß und Klein gefallen wird..."
    ],
    "en": [
      "Rediscover a taste for family adventure with geocaching: thanks to an application, you'll find several caches! It's a fun way to discover the commune that's sure to please young and old alike..."
    ],
    "it": [
      "Riscoprite il gusto dell'avventura in famiglia con il geocaching: grazie a un'applicazione, potrete trovare diverse cache! È un modo divertente per scoprire il territorio locale che piacerà a grandi e piccini..."
    ],
    "fr": [
      "Redécouvrez  le goût de l'aventure en famille avec le géocaching : grâce a une application, vous trouverez plusieurs caches ! Une façon ludique de découvrir la commune, qui plaira aux petits comme aux grands..."
    ],
    "es": [
      "Redescubra el gusto de su familia por la aventura con el geocaching: gracias a una aplicación, ¡podrá encontrar varios cachés! Es una forma divertida de descubrir la zona que gustará a grandes y pequeños..."
    ],
    "nl": [
      "Herontdek de zin in avontuur voor je gezin met geocaching: dankzij een applicatie kun je verschillende caches vinden! Het is een leuke manier om de omgeving te ontdekken die zeker in de smaak zal vallen bij jong en oud..."
    ]
  },
  "rdfs:label": {
