  "rdfs:comment": {
    "de": [
      "Auf der Domaine de Rochasson, in einem 8 Hektar großen bewaldeten Park, hat sich das CINE niedergelassen und bietet pädagogische Aktivitäten für die breite Öffentlichkeit sowie für Schulklassen an. Vom Zentrum aus werden zwei Wanderrouten angeboten."
    ],
    "en": [
      "It's on the Rochasson domaine, among a wooded park of 8 acres, that the CINE has been settled and offers now pedagogic activities to the public, as well as the pupils. Two pedestrian tours are available from the centre."
    ],
    "it": [
      "Il CINE si trova nella tenuta di Rochasson, in un parco alberato di 8 ettari, e offre attività educative per il pubblico e per le scolaresche. Dal centro partono due percorsi a piedi."
    ],
    "fr": [
      "C'est sur le domaine de Rochasson, au sein d'un parc boisé de 8 hectares, que le CINE s'est installé et propose des activités pédagogiques au grand public ainsi qu'aux scolaires. Deux circuits pédestres sont proposés à partir du centre."
    ],
    "nl": [
      "Het CINE ligt op het landgoed van Rochasson, in een bebost park van 8 hectare, en biedt educatieve activiteiten voor het grote publiek en voor schoolkinderen. Er zijn twee wandelroutes vanuit het centrum."
    ],
    "es": [
      "El CINE está situado en la finca de Rochasson, en un parque arbolado de 8 hectáreas, y ofrece actividades educativas para el público en general y los escolares. Hay dos rutas de senderismo desde el centro."
    ]
  },
  "rdfs:label": {
    "en": [
      "Centre d'Initiation à la nature et à l'environnement"
    ],
    "fr": [
      "CINE - Centre d'Initiation à la nature et à l'environnement"
    ]
  },
