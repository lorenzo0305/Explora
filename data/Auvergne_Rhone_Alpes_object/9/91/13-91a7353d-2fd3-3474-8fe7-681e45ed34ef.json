  "rdfs:comment": {
    "de": [
      "Massagen und Entspannung im Herzen des Vercors:\r\nAmma im Liegen (exklusiv), Amma im Sitzen, VerKobido und Klangentspannung.\r\nGönnen Sie sich eine einzigartige Sinneserfahrung, um Spannungen zu lösen und Vitalität und Gelassenheit wiederzufinden."
    ],
    "en": [
      "Massages and relaxation in the heart of the Vercors:\r\nLying Amma (exclusive), seated Amma, VerKobido and sound relaxation.\r\nTreat yourself to a unique sensory escape to release tension and regain vitality and serenity."
    ],
    "it": [
      "Massaggi e relax nel cuore del Vercors:\r\nAmma sdraiato (esclusivo), Amma seduto, VerKobido e rilassamento sonoro.\r\nConcedetevi una fuga sensoriale unica per sciogliere le tensioni e ritrovare vitalità e serenità."
    ],
    "fr": [
      "Massages et relaxation au cœur du Vercors :\r\nAmma allongé (exclusivité), Amma assis, VerKobido et relaxation sonore.\r\nOffrez-vous une évasion sensorielle unique pour libérer les tensions et retrouver vitalité et sérénité."
    ],
    "nl": [
      "Massages en ontspanning in het hart van de Vercors:\r\nLiggende Amma (exclusief), zittende Amma, VerKobido en klankontspanning.\r\nTrakteer jezelf op een unieke zintuiglijke ontsnapping om spanningen los te laten en vitaliteit en sereniteit te hervinden."
    ],
    "es": [
      "Masajes y relajación en el corazón del Vercors:\r\nAmma tumbado (exclusivo), Amma sentado, VerKobido y relajación sonora.\r\nRegálese una escapada sensorial única para liberar tensiones y recuperar vitalidad y serenidad."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Évasion Sensorielle & Bien-Être exclusif en Vercors avec Edwige"
    ]
  },
