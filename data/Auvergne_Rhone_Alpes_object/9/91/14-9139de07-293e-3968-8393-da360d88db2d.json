  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/89d2a3e2-df2d-31af-9122-1243174ed5c3",
      "dc:description": {
        "de": [
          "Tauchen Sie ein in eine Führung der besonderen Art! Begleitet von den talentierten Schauspielern der Improvisationsliga von Marcq-en-Bar?ul, lassen Sie sich von einer schrägen und humorvollen Erkundung der Galerie der Zeit überraschen..."
        ],
        "en": [
          "Immerse yourself in a guided tour unlike any other! Accompanied by talented actors from the Ligue d?Improvisation de Marcq-en-Bar?ul, let us surprise you with an offbeat, humorous exploration of the Galerie du Temps..."
        ],
        "it": [
          "Immergetevi in una visita guidata senza precedenti! Accompagnati da attori di talento della Ligue d'Improvisation de Marcq-en-Bar?ul, lasciatevi sorprendere da un'esplorazione stravagante e umoristica della Galerie du Temps..."
        ],
        "fr": [
          "Plongez dans une visite guidée pas comme les autres ! Accompagnés des comédiens talentueux de la Ligue d’Improvisation de Marcq-en-Barœul, laissez-vous surprendre par une exploration décalée et pleine d’humour de la Galerie du Temps.."
        ],
        "es": [
          "Sumérjase en una visita guiada sin igual Acompañado por talentosos actores de la Ligue d'Improvisation de Marcq-en-Barœul, déjese sorprender por una exploración estrafalaria y llena de humor de la Galerie du Temps..."
        ],
        "nl": [
          "Dompel jezelf onder in een rondleiding als geen ander! Laat je, begeleid door getalenteerde acteurs van de Ligue d'Improvisation de Marcq-en-Bar?ul, verrassen door een eigenzinnige en humoristische verkenning van de Galerie du Temps..."
        ]
      },
