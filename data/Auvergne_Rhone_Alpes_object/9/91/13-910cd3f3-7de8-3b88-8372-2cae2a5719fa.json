  "rdfs:comment": {
    "de": [
      "Produzenten von Parfüm-, Aroma- und Medizinalpflanzen. Wir haben eine Reihe von Bio-Teebeuteln entwickelt, die aus unseren eigenen Pflanzen aus Anbau oder Ernte stammen und ein Qualitätsprodukt sowie einen kurzen Verbrauchskreislauf garantieren."
    ],
    "en": [
      "Organic herbal teas."
    ],
    "it": [
      "Produttori di piante profumate, aromatiche e medicinali. Abbiamo sviluppato una gamma di infusi biologici, realizzati con le nostre piante coltivate o raccolte, garantendo un prodotto di qualità e un circuito di consumo breve."
    ],
    "fr": [
      "Producteurs de plantes à parfum, aromatiques et médicinales. Nous avons développé une gamme d'infusettes bio, issues de nos propres plantes de culture ou cueillette, garantissant un produit de qualité et un circuit de consommation court."
    ],
    "es": [
      "Productores de plantas perfumadas, aromáticas y medicinales. Hemos desarrollado una gama de infusorios ecológicos, elaborados a partir de nuestras propias plantas cultivadas o recolectadas, garantizando un producto de calidad y un circuito de consumo corto."
    ],
    "nl": [
      "Assortiment organische kruidenthee, van eigengekweekte of geplukte planten."
    ]
  },
  "rdfs:label": {
    "en": [
      "The Beautiful Plant"
    ],
    "fr": [
      "La Belle Plante"
    ]
  },
