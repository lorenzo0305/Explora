  "rdfs:comment": {
    "de": [
      "Entdecken Sie das neue Freizeitgebiet von St-Anthème inmitten einer grünen Oase: Spielplatz, City-Stadion, Picknicktische; Strand, Badebereich und Verleih von Kanus und Tretbooten oder Spaziergänge rund um den Wasserspiegel sind zugänglich."
    ],
    "en": [
      "Plenty of activities on offer at Saint-Anthème Lake: picnic areas, games, pedalos,\r\ncanoeing and more. Swimming is supervised in July and August and the water\r\nquality is exceptional. Shaded campsite and campervan area nearby. Open all year. No snack for 2024."
    ],
    "it": [
      "Venite a scoprire la nuova area ricreativa di St-Anthème nel cuore di un ambiente verde: area giochi, stadio cittadino, tavoli da picnic; spiaggia, area balneare e noleggio di canoe e pedalò o passeggiate intorno al lago sono tutti accessibili."
    ],
    "fr": [
      "Venez découvrir la nouvelle zone de loisirs de St-Anthème au cœur d'un écrin de verdure : aire de jeux, city stade, tables de pique-nique ; plage, zone de baignade et location de canoés et pédalos ou promenade autour du plan d'eau sont accessibles."
    ],
    "es": [
      "Venga a descubrir la nueva zona de ocio de St-Anthème en pleno corazón de un entorno verde: zona de juegos, estadio urbano, mesas de picnic; playa, zona de baño y alquiler de canoas y pedalós o paseos por el lago son accesibles."
    ],
    "nl": [
      "Kom en ontdek de nieuwe recreatiezone van St-Anthème in het hart van een groene omgeving: speeltuin, stadsstadion, picknicktafels; strand, zwemzone en verhuur van kano's en waterfietsen of wandelingen rond het meer zijn allemaal toegankelijk."
    ]
  },
  "rdfs:label": {
    "en": [
      "Saint Antheme’s small lake"
    ],
    "fr": [
      "Plan d'eau de Saint-Anthème"
    ]
  },
