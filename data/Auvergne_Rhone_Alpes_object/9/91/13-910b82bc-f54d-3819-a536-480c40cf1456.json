  "rdfs:comment": {
    "de": [
      "Die Délicion Bar - Restaurant empfängt Sie von Montag bis Freitag mittags und bietet Ihnen die Möglichkeit, ihre portugiesischen Spezialitäten zu probieren: große Auswahl an Kabeljau-Spezialitäten und Steak a moda da casa. Verschiedene Tagesangebote."
    ],
    "en": [
      "The Délicion bar - restaurant welcomes you from Monday to Friday lunchtime and offers you to taste their Portuguese specialities: a large choice of cod specialities and steak a moda da casa. Different formulas of the day."
    ],
    "it": [
      "Il bar-ristorante Délicion vi accoglie dal lunedì al venerdì per il pranzo e vi propone di assaggiare le sue specialità portoghesi: un'ampia scelta di specialità di baccalà e bistecca a moda da casa. Formule giornaliere diverse."
    ],
    "fr": [
      "Le Délicion bar - restaurant vous accueille du lundi au vendredi midi et vous propose de déguster leurs spécialités portugaises : grand choix de spécialités de morues et de steak a moda da casa. Différentes formules du jour."
    ],
    "nl": [
      "Het bar-restaurant Délicion verwelkomt u van maandag tot vrijdag voor de lunch en biedt u de Portugese specialiteiten: een ruime keuze aan kabeljauwspecialiteiten en steak a moda da casa. Verschillende dagelijkse formules."
    ],
    "es": [
      "El bar-restaurante Délicion le da la bienvenida de lunes a viernes para el almuerzo y le ofrece degustar sus especialidades portuguesas: una amplia selección de especialidades de bacalao y filete a la moda da casa. Diferentes fórmulas diarias."
    ]
  },
  "rdfs:label": {
