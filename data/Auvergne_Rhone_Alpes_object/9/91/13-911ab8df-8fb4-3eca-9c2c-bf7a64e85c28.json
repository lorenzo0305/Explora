  "rdfs:comment": {
    "de": [
      "Aufzucht von Kühen, Schafen und Ziegen. Herstellung und Veredelung von Saint-Nectaire fermier AB, Lammfleisch AB und ab diesem Sommer Ziegenkäse.\r\nBauernhof in 1100 m Höhe mit Blick auf die Puys-Kette."
    ],
    "en": [
      "Cows, sheep and goats. Production and maturing of farmhouse Saint-Nectaire AB, lamb AB and, starting this summer, goat cheese.\r\nFarm located at 1100m altitude, overlooking the Chaîne des Puys."
    ],
    "it": [
      "Mucche, pecore e capre. Produzione e stagionatura di Saint-Nectaire AB, agnello AB e, a partire da quest'estate, formaggio di capra.\r\nFattoria situata a 1100 m di altitudine con vista sulla Chaîne des Puys."
    ],
    "fr": [
      "Élevage de vaches, d'ovins et de caprins. Fabrication et affinage de Saint-Nectaire fermier AB, viande d'agneau AB et à partir de cette été fromage de chèvre. \r\nFerme située à 1100m d'altitude avec vu sur la chaîne des Puys."
    ],
    "es": [
      "Vacas, ovejas y cabras. Producción y maduración de AB de granja Saint-Nectaire, AB de cordero y, a partir de este verano, queso de cabra.\r\nGranja situada a 1100 m de altitud con vistas a la Chaîne des Puys."
    ],
    "nl": [
      "Koeien, schapen en geiten. Productie en rijping van boerderij Saint-Nectaire AB, lam AB en, vanaf deze zomer, geitenkaas.\r\nBoerderij gelegen op 1100m hoogte met uitzicht op de Chaîne des Puys."
    ]
  },
  "rdfs:label": {
