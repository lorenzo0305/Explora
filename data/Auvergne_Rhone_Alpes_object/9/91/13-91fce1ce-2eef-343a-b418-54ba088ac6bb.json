  "rdfs:comment": {
    "de": [
      "Aqua Sports Péronnas ist ein Wasser-Fitnesscenter. Wir bieten Aquabike-, Aquafitness- und Aquasundheitskurse für alle Niveaus an. Der Ort für Gesundheitssport, den Sie brauchen!\r\nProfessionalität und Geselligkeit\r\nSchwimmunterricht (6 Jahre)."
    ],
    "en": [
      "Aqua Sports Péronnas is an aquatic fitness center. We offer aquabike, aquafitness and aquasanté classes for all levels. The Sport Santé place for you!\r\nProfessional and friendly.\r\nSwimming lessons (6 years)."
    ],
    "it": [
      "Aqua Sports Péronnas è un centro fitness acquatico. Offriamo corsi di aquabike, aquafitness e aquahealth per tutti i livelli. Il luogo Sport Santé di cui avete bisogno!\r\nProfessionalità e convivialità\r\nCorsi di nuoto (6 anni)."
    ],
    "fr": [
      "Aqua Sports Péronnas est un centre de remise en forme aquatique. Nous proposons des cours d'aquabike, d'aquafitness, d'aquasanté, pour tous les niveaux. Le lieu Sport Santé qu'il vous faut ! \r\nProfessionnalisme et convivialité. \r\nLeçons de natation (6 ans)."
    ],
    "nl": [
      "Aqua Sports Péronnas is een aquatisch fitnesscentrum. Wij bieden cursussen aquabike, aquafitness en aquahealth voor alle niveaus. De plaats Sport Santé die je nodig hebt!\r\nProfessionaliteit en gezelligheid\r\nZwemlessen (6 jaar)."
    ],
    "es": [
      "Aqua Sports Péronnas es un centro de fitness acuático. Ofrecemos cursos de aquabike, aquafitness y aquahealth para todos los niveles. El lugar Sport Santé que necesita\r\nProfesionalidad y cordialidad\r\nClases de natación (6 años)."
    ]
  },
