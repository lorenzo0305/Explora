  "rdfs:comment": {
    "de": [
      "Die Kirche Saint Georges gehört zu den 11 Kirchen der Pfarrei Saint-Jean-Baptiste. Das unter dem Patronat des Heiligen Georg stehende barocke Gebäude entstand 1795, als die beiden Pfarreien Veigy und Foncenex wiedervereinigt wurden."
    ],
    "en": [
      "Saint Georges church is one of the 11 churches of the Saint-Jean-Baptiste parish. Placed under the patronage of Saint Georges, this Baroque-style edifice really came into being in 1795, when the two parishes of Veigy and Foncenex were reunited."
    ],
    "it": [
      "La chiesa di Saint Georges è una delle 11 chiese della parrocchia di Saint-Jean-Baptiste. Posto sotto il patronato di Saint Georges, questo edificio in stile barocco è nato nel 1795, quando le due parrocchie di Veigy e Foncenex sono state riunite."
    ],
    "fr": [
      "L'église Saint Georges fait partie des 11 églises de la paroisse Saint-Jean-Baptiste. Placée sous le patronage de Saint Georges, cet édifice de type baroque est véritablement  né en 1795 lors de la réunification des deux paroisses de Veigy et de Foncenex."
    ],
    "es": [
      "La iglesia de Saint Georges es una de las 11 iglesias de la parroquia de Saint-Jean-Baptiste. Situado bajo la advocación de Saint Georges, este edificio barroco nació realmente en 1795 durante la reunificación de las dos parroquias de Veigy y Foncenex."
    ],
    "nl": [
      "De Saint-Georges kerk is een van de 11 kerken van de parochie Saint-Jean-Baptiste. Dit gebouw in barokstijl, dat onder het beschermheerschap van Saint-Georges werd geplaatst, ontstond pas echt in 1795 toen de twee parochies van Veigy en Foncenex werden herenigd."
    ]
  },
