  "rdfs:comment": {
    "de": [
      "Das Physalis empfängt Sie herzlich in einem schlichten und modernen Rahmen, um leckere Gerichte zu genießen, die sowohl traditionell als auch erfinderisch sind."
    ],
    "en": [
      "The Physalis welcomes you warmly in a sober and modern setting, to enjoy tasty dishes that are both traditional and inventive."
    ],
    "it": [
      "Il Physalis vi accoglie calorosamente in un ambiente sobrio e moderno, per gustare piatti gustosi sia tradizionali che inventivi."
    ],
    "fr": [
      "Le Physalis vous reçoit chaleureusement dans un cadre sobre et moderne, pour déguster de savoureux plats à la fois traditionnels et inventifs."
    ],
    "es": [
      "El Physalis le da una cálida bienvenida en un ambiente sobrio y moderno, para disfrutar de sabrosos platos a la vez tradicionales e inventivos."
    ],
    "nl": [
      "De Physalis ontvangt u hartelijk in een sober en modern kader, om te genieten van smakelijke gerechten die zowel traditioneel als inventief zijn."
    ]
