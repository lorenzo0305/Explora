  "rdfs:comment": {
    "de": [
      "Mit Ihrer Karte ausgestattet, machen Sie sich auf, das Blaue Tal zu entdecken!\r\nZiel des Orientierungslaufs ist es, sich anhand von natürlichen und künstlichen Elementen zu orientieren. 8 Markierungen müssen gefunden werden."
    ],
    "en": [
      "8 posts. The aim of orienteering is to find your bearings using natural and artificial elements (trees, rocks, symbols, signs,...).\r\nAt each post, punch your card using the red clip at the top."
    ],
    "it": [
      "Armati di mappa, partite alla scoperta della Vallée Bleue!\r\nLo scopo della gara di orienteering è quello di orientarsi utilizzando elementi naturali e artificiali. ci sono 8 marcatori da trovare."
    ],
    "fr": [
      "Muni de votre carte, partez à la découverte de la Vallée Bleue !\r\nL'objectif de la Course d'orientation est de se repérer grâce aux éléments naturels et artificiels. 8 balises sont à retrouver."
    ],
    "nl": [
      "Gewapend met je kaart ga je op pad om de Vallée Bleue te ontdekken!\r\nHet doel van de oriëntatieloop is om je te oriënteren met behulp van natuurlijke en kunstmatige elementen. er zijn 8 markeringen te vinden."
    ],
    "es": [
      "Armado con su mapa, ¡parta a descubrir la Vallée Bleue!\r\nEl objetivo de la carrera de orientación es orientarse utilizando elementos naturales y artificiales. hay 8 balizas que encontrar."
    ]
  },
  "rdfs:label": {
    "en": [
      "Orienteering trail at the Vallée Bleue - Blue Course"
    ],
    "fr": [
      "Parcours d'orientation adulte \"bleu\" - Vallée Bleue"
    ]
  },
