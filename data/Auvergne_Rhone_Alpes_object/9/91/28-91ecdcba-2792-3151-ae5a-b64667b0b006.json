      "@id": "https://data.datatourisme.fr/eb1203ac-30f9-39f1-8ef4-da1899a7ffc8",
      "dc:description": {
        "de": [
          "Der Friedhof \"Ligny-en-Cambrésis Communal Cemetery \" ist ein Militärfriedhof aus dem Ersten Weltkrieg auf dem Gebiet der Gemeinde Ligny-en-Cambrésis, Nord.\nwww.cwgc.org/"
        ],
        "en": [
          "The \"Ligny-en-Cambrésis Communal Cemetery\" is a First World War military cemetery located in the commune of Ligny-en-Cambrésis, Nord.\nwww.cwgc.org/"
        ],
        "it": [
          "Il cimitero comunale di Ligny-en-Cambrésis è un cimitero militare della Prima Guerra Mondiale situato nel comune di Ligny-en-Cambrésis, nel Nord.\nwww.cwgc.org/"
        ],
        "fr": [
          "Le cimetière «Ligny-en-Cambrésis Communal Cemetery » est un cimetière militaire de la Première Guerre mondiale situé sur le territoire de la commune de Ligny-en-Cambrésis, Nord.\nwww.cwgc.org/"
        ],
        "nl": [
          "Ligny-en-Cambrésis Communal Cemetery is een militaire begraafplaats uit de Eerste Wereldoorlog in de gemeente Ligny-en-Cambrésis, Nord.\nwww.cwgc.org/"
        ],
        "es": [
          "El Cementerio Comunal de Ligny-en-Cambrésis es un cementerio militar de la Primera Guerra Mundial situado en la comuna de Ligny-en-Cambrésis, Norte.\nwww.cwgc.org/"
        ]
      },
