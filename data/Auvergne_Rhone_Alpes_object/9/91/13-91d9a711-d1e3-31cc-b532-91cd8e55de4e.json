  "rdfs:comment": {
    "de": [
      "Wellness-Massage, Thai-Massage und Training im Salon oder zu Hause, bei Ihnen zu Hause oder an Ihrem Urlaubsort. Für einen Moment der Entspannung auf einer bequemen Massageliege mit biologischen pflanzlichen & ätherischen Ölen."
    ],
    "en": [
      "Wellness massage, Thai massage and training at the salon or at home, at your home or vacation destination. For a moment of relaxation on a comfortable massage table with organic vegetable & essential oils."
    ],
    "it": [
      "Massaggio benessere, massaggio thailandese e formazione in salone o a domicilio, a casa vostra o in vacanza. Per un momento di relax su un comodo lettino da massaggio con oli vegetali ed essenziali biologici."
    ],
    "fr": [
      "Massage bien-être, thaï massage et formation au salon ou à domicile, chez vous ou sur votre lieu de vacances. Pour un moment de détente sur une table de massage confortable avec des huiles végétales & essentielles biologiques."
    ],
    "nl": [
      "Welzijnsmassage, Thaise massage en training in de salon of thuis, bij jou thuis of op je vakantiebestemming. Voor een moment van ontspanning op een comfortabele massagetafel met biologische plantaardige en essentiële oliën."
    ],
    "es": [
      "Masaje de bienestar, masaje tailandés y formación en el salón o a domicilio, en su casa o en sus vacaciones. Para un momento de relajación en una cómoda camilla de masaje con aceites vegetales y esenciales orgánicos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Massage bien-être des Baronnies"
    ]
  },
