  "rdfs:comment": {
    "de": [
      "Diese Adresse bietet eine Auswahl an französischen Antiquitäten und alten Gegenständen, die Liebhabern schöner Dinge gewidmet ist. In der gemütlichen Atmosphäre des Galeriebereichs werden Werke von Lyoner Künstlern ausgestellt."
    ],
    "en": [
      "This boutique offers a selection of French antiques and vintage objects, dedicated to lovers of beautiful things. In a warm atmosphere, discover the gallery space, where works by Lyon artists are exhibited."
    ],
    "it": [
      "Questo indirizzo offre una selezione di oggetti d'antiquariato francese, dedicata agli amanti delle cose belle. In un'atmosfera accogliente, scoprite l'area della galleria, dove sono esposte opere di artisti lionesi."
    ],
    "fr": [
      "Cette adresse propose une sélection d’antiquités françaises et d’objets anciens, dédiée aux amateurs de belles choses. Dans une atmosphère chaleureuse, découvrez l’espace galerie, où sont exposées les œuvres d’artistes lyonnais."
    ],
    "es": [
      "Esta dirección ofrece una selección de antigüedades y objetos antiguos franceses, dedicada a los amantes de las cosas bellas. En un ambiente cálido, descubra la zona de galerías, donde se exponen obras de artistas lioneses."
    ],
    "nl": [
      "Dit adres biedt een selectie Franse antiquiteiten en antieke voorwerpen, gewijd aan liefhebbers van mooie dingen. Ontdek in een warme sfeer de galerieruimte, waar werken van kunstenaars uit Lyon worden tentoongesteld."
    ]
  },
  "rdfs:label": {
