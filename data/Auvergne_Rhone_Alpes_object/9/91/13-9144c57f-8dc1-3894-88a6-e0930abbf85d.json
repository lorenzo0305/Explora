  "rdfs:comment": {
    "de": [
      "Jahrhundert umgebaut wurde. Diese mittelalterliche Burg kontrolliert den Jakobsweg, der durch die Margeride führt."
    ],
    "en": [
      "A former stronghold of the Merc?ur, comprising a circular keep dating from 1252 and a main building, remodeled in the 16th and 18th centuries, this medieval castle controls the route to Santiago de Compostela, which crosses the Margeride."
    ],
    "it": [
      "Antico baluardo del Merc?ur, composto da un mastio circolare del 1252 e da un edificio principale, rimaneggiato nei secoli XVI e XVIII, questo castello medievale controlla il percorso verso Santiago de Compostela, che attraversa la Margeride."
    ],
    "fr": [
      "Ancienne place forte des Mercœur constituée d'un donjon circulaire de 1252 et d'un corps de logis, remanié aux XVIe et XVIIIe siècles, ce Château du Moyen-Age contrôle le chemin de Saint Jacques de Compostelle qui franchit la Margeride."
    ],
    "nl": [
      "Dit middeleeuwse kasteel, een voormalig bolwerk van de Mercur, bestaat uit een ronde donjon uit 1252 en een hoofdgebouw dat in de 16e en 18e eeuw is verbouwd. Het beheerst de route naar Santiago de Compostela, die over de Margeride loopt."
    ],
    "es": [
      "Antiguo baluarte de los Merc?ur, compuesto por una torre del homenaje circular de 1252 y un edificio principal, remodelado en los siglos XVI y XVIII, este castillo medieval controla la ruta hacia Santiago de Compostela, que atraviesa el Margeride."
    ]
  },
