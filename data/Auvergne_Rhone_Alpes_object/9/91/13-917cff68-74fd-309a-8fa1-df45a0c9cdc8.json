  "rdfs:comment": {
    "de": [
      "Lamastre verfügt über 2 Tennisplätze, die sich hinter der Sporthalle befinden. Reservieren Sie die Plätze online auf der Website anybuddy.com.\r\n\r\nKostenloser Verleih von Schlägern und Bällen im Restaurant \"chez Mag\" place Seignobos während der Öffnungszeiten."
    ],
    "en": [
      "Lamastre has 2 tennis courts located behind the gymnasium. Reservations can be made online at anybuddy.com.\r\n\r\nFree loan of rackets and balls at the restaurant \"chez Mag\" place Seignobos during opening hours."
    ],
    "it": [
      "Lamastre dispone di 2 campi da tennis situati dietro la palestra. Le prenotazioni possono essere effettuate online su anybuddy.com.\r\n\r\nRacchette e palline possono essere prese in prestito gratuitamente presso il ristorante \"chez Mag\" in Place Seignobos durante gli orari di apertura."
    ],
    "fr": [
      "Lamastre dispose de 2 courts de tennis situés derrière le gymnase. Réservation des courts en ligne sur le site anybuddy.com.\r\n\r\nPrêt de raquettes et de balles gratuitement au restaurant \"chez Mag\" place Seignobos aux heures d'ouverture."
    ],
    "nl": [
      "Lamastre heeft 2 tennisbanen achter de sporthal. Reserveren kan online op anybuddy.com.\r\n\r\nRackets en ballen kunnen gratis worden geleend bij het restaurant \"chez Mag\" op Place Seignobos tijdens de openingsuren."
    ],
    "es": [
      "Lamastre dispone de 2 pistas de tenis situadas detrás del gimnasio. Las reservas se pueden hacer en línea en anybuddy.com.\r\n\r\nLas raquetas y pelotas se pueden tomar prestadas gratuitamente en el restaurante \"chez Mag\" de la plaza Seignobos durante las horas de apertura."
    ]
  },
  "rdfs:label": {
