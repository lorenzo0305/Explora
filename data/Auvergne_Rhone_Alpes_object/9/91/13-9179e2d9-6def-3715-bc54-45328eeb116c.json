  "rdfs:comment": {
    "de": [
      "Traditionelle Küche aus der Ardèche, der Provence und von anderswo auf dem Gelände des Pont d'Arc. Schattige Terrassen mit Aussicht, Parkplatz, Strand 100 m entfernt. Neuer Souvenirbereich im Jahr 2025. Empfang von Gruppen, Zugang für Behinderte, Haustiere erlaubt, kostenloser Busparkplatz."
    ],
    "en": [
      "Traditional cuisine from the Ardèche, Provence and elsewhere, on the Pont d'Arc site. Shaded terraces with views, parking, beach 100 m away. New souvenir area in 2025. Groups welcome, disabled access, pets accepted, free bus parking."
    ],
    "it": [
      "Cucina tradizionale dell'Ardèche, provenzale e non, sul sito di Pont d'Arc. Terrazze ombreggiate con vista, parcheggio, spiaggia a 100 m. Nuova area souvenir nel 2025. Accoglienza gruppi, accesso disabili, animali ammessi, parcheggio bus gratuito."
    ],
    "fr": [
      "Cuisine traditionnelle ardéchoise, provençale et d’ailleurs, sur le site du Pont d’Arc. Terrasses ombragées avec vue, parking, plage à 100 m. Nouvel espace souvenirs en 2025. Accueil groupes, accès handicapés, animaux acceptés, parking bus gratuit."
    ],
    "nl": [
      "Traditionele Ardèche, Provençaalse en andere keuken, op het terrein van Pont d'Arc. Schaduwrijke terrassen met uitzicht, parkeerplaats, strand op 100 m. Nieuw souvenirgebied in 2025. Groepen welkom, toegang voor gehandicapten, huisdieren toegestaan, gratis parkeerplaats voor bussen."
    ],
    "es": [
      "Cocina tradicional de Ardèche, provenzal y otras, en el sitio de Pont d'Arc. Terrazas sombreadas con vistas, aparcamiento, playa a 100 m. Nueva zona de recuerdos en 2025. Admite grupos, acceso para minusválidos, admite animales, aparcamiento gratuito para autobuses."
    ]
  },
