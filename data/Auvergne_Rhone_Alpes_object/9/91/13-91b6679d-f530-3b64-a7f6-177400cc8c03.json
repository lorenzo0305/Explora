  "rdfs:comment": {
    "de": [
      "Im Restaurant le Rieussec verwöhnen Sie Claude und Sébastien mit einer traditionellen Feinschmeckerküche aus frischen und lokalen Produkten.  Parkplatz gegenüber dem Bahnhof, schöne Terrasse mit Blick auf das Dorf Saillans und den Fluss."
    ],
    "en": [
      "The Rieussec restaurant, Claude and Sébastien delight you with gourmet and traditional cuisine, fresh and local produce, car park opposite the station, terrace with views of Saillans and the river."
    ],
    "it": [
      "Al ristorante Rieussec, Claude e Sébastien vi delizieranno con una cucina gourmet tradizionale a base di prodotti freschi locali.  Parcheggio di fronte alla stazione, bella terrazza con vista sul villaggio di Saillans e sul fiume."
    ],
    "fr": [
      "Au restaurant le Rieussec, Claude et Sébastien vous régalent avec une cuisine gourmande et traditionnelle, des produits frais et locaux.  Parking face à la gare, belle terrasse avec vue sur le village de Saillans et la rivière."
    ],
    "nl": [
      "In het restaurant Rieussec verwennen Claude en Sébastien je met traditionele gastronomische gerechten met verse streekproducten.  Parkeerplaats tegenover het station, mooi terras met uitzicht op het dorp Saillans en de rivier."
    ],
    "es": [
      "En el restaurante Rieussec, Claude y Sébastien le deleitarán con una cocina gastronómica tradicional elaborada con productos frescos de la región.  Aparcamiento frente a la estación, bonita terraza con vistas al pueblo de Saillans y al río."
    ]
  },
