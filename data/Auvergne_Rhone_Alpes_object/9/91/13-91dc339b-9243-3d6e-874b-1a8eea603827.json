  "rdfs:comment": {
    "de": [
      "Entdecken Sie Bauernkäse vom Bauernhof, darunter Bleu du Vercors-Sassenage AOP und Cimarain. Seien Sie um 18 Uhr beim Melken der \"Villard de Lans\"-Kühe dabei und profitieren Sie vom Direktverkauf. Ein authentisches Bauernerlebnis!"
    ],
    "en": [
      "Discover farmhouse cheeses, including Bleu du Vercors-Sassenage PDO and Cimarain. Watch the \"Villard de Lans\" cows being milked at 6pm, and take advantage of direct sales. An authentic farming experience!"
    ],
    "it": [
      "Scoprite i formaggi di fattoria, tra cui il Bleu du Vercors-Sassenage DOP e il Cimarain. Assistete alla mungitura delle mucche \"Villard de Lans\" alle 18.00 e approfittate della vendita diretta. Un'autentica esperienza agricola!"
    ],
    "fr": [
      "Découvrez des fromages fermiers de la ferme, dont le Bleu du Vercors-Sassenage AOP et le Cimarain. Assistez à la traite des vaches \"Villard de Lans\" à 18h et profitez de la vente directe. Une expérience paysanne authentique !"
    ],
    "nl": [
      "Ontdek de boerenkazen, waaronder Bleu du Vercors-Sassenage BOB en Cimarain. Kijk hoe de koeien van Villard de Lans om 18.00 uur worden gemolken en profiteer van de directe verkoop. Een authentieke boerenervaring!"
    ],
    "es": [
      "Descubra los quesos de granja, como el Bleu du Vercors-Sassenage DOP y el Cimarain. Observe cómo se ordeñan las vacas \"Villard de Lans\" a las 18 h y aproveche la venta directa. Una auténtica experiencia agrícola"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ferme de la Cîme du Mas"
    ]
  },
