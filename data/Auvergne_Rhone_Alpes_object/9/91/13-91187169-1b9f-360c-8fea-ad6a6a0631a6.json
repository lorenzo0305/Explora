  "rdfs:comment": {
    "de": [
      "Bouillon Baratte ist eine Adresse auf der Halbinsel mit Brasserie-Codes zwischen Authentizität und Modernität. Eine hausgemachte, leckere und originelle Speisekarte, die sich an den Jahreszeiten orientiert. In einem einzigartigen Rahmen werden Sie einen geselligen Moment erleben."
    ],
    "en": [
      "Bouillon Baratte is the Presqu’île’s place-to-be and has an authentic but modern brasserie feel. A freshly-made, tasty and original menu inspired by the seasons. Have a great time together in a unique setting."
    ],
    "it": [
      "Il Bouillon Baratte è un indirizzo della Presqu'île con uno stile da brasserie che unisce autenticità e modernità. Un menu casalingo, gourmet e originale ispirato alle stagioni. Un ambiente unico in cui condividere un momento di convivialità."
    ],
    "fr": [
      "Bouillon Baratte est une adresse de la Presqu’île aux codes brasserie entre authenticité et modernité. Une carte faite maison, gourmande et originale inspirée par les saisons. Dans un cadre unique vous partagerez un moment convivial."
    ],
    "nl": [
      "Bouillon Baratte is een adres op het Presqu?île met een brasserie die authenticiteit en moderniteit combineert. Een huisgemaakte, gastronomische en originele kaart geïnspireerd door de seizoenen. Een uniek kader voor een gezellig moment."
    ],
    "es": [
      "Bouillon Baratte es una dirección en la Presqu'île con un estilo brasserie que combina autenticidad y modernidad. Una carta casera, gastronómica y original inspirada en las estaciones. Un marco único en el que compartir un momento de convivencia."
    ]
  },
