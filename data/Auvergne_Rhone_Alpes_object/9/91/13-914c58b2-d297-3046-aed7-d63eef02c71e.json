  "rdfs:comment": {
    "de": [
      "Galerie café / Notre-Dame: Ein festlicher Platz, der vor Restaurants und Terrassen überquillt, die durch den zentralen Brunnen gemäßigt werden.  La Vina steht im Kontrast dazu mit seiner diskreten Terrasse. Hier erwarten Sie Bio-/Fairtrade-Getränke, Bücher, Kunstfotografien und Konzerte."
    ],
    "en": [
      "Galerie café / Notre-Dame: a festive square overflowing with restaurants and terraces tempered by the central fountain.  La Vina contrasts with its discreet terrace. Organic/fair trade drinks, books, art photography and concerts await you there."
    ],
    "it": [
      "Galerie café / Notre-Dame: una piazza festosa, ricca di ristoranti e terrazze mitigate dalla fontana centrale.  La Vina contrasta con la sua terrazza discreta. Vi aspettano bevande biologiche, libri, fotografie, dipinti, sculture e concerti."
    ],
    "fr": [
      "Galerie café / Notre-Dame : une place festive débordant de restaurants et de terrasses tempérées par la fontaine centrale.  La Vina contraste avec sa terrasse discrète. Boissons bio, livres, photographies, peintures, sculptures, concerts vous y attendent."
    ],
    "es": [
      "Galerie café / Notre-Dame: una plaza festiva rebosante de restaurantes y terrazas atemperadas por la fuente central.  La Viña contrasta con su discreta terraza. Bebidas ecológicas/de comercio justo, libros, fotografía artística y conciertos le esperan."
    ],
    "nl": [
      "Galerie café / Notre-Dame: een feestelijk plein vol restaurants en terrassen getemperd door de centrale fontein.  La Vina contrasteert met zijn discrete terras. Biologische drankjes, boeken, foto's, schilderijen, beeldhouwwerken en concerten wachten op je."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Vina - Galerie Café"
    ]
  },
