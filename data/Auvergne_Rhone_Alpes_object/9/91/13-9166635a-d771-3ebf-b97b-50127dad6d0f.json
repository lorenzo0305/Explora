  "rdfs:comment": {
    "de": [
      "Neu: Wiedereröffnung des symbolträchtigen Restaurants des Ortes \"Malamute\", das zum ''Croisette'' wird, renoviert und mit einer großen Terrasse, auf den Pisten in Chamrousse 1750 - Roche Béranger."
    ],
    "en": [
      "New: reopening of the resort's emblematic restaurant, the \"Malamute\", which becomes the \"Croisette\", renovated and with a large terrace, on the slopes at Chamrousse 1750 - Roche Béranger."
    ],
    "it": [
      "Novità: riapertura del ristorante emblematico del resort, il \"Malamute\", che è diventato il \"Croisette\", rinnovato e con un'ampia terrazza, sulle piste di Chamrousse 1750 - Roche Béranger."
    ],
    "fr": [
      "Nouveauté : réouverture du restaurant emblématique de la station le \"Malamute\" qui devient la \"Croisette\", rénové et avec une grande terrasse, sur les pistes à Chamrousse 1750 - Roche Béranger."
    ],
    "es": [
      "Novedad: reapertura del restaurante emblemático de la estación, el \"Malamute\", convertido en la \"Croisette\", renovado y con una gran terraza, en las pistas de Chamrousse 1750 - Roche Béranger."
    ],
    "nl": [
      "Nieuw: heropening van het emblematische restaurant van het skioord, de \"Malamute\", dat nu de \"Croisette\" is geworden, gerenoveerd en met een groot terras, op de pistes van Chamrousse 1750 - Roche Béranger."
    ]
  },
  "rdfs:label": {
