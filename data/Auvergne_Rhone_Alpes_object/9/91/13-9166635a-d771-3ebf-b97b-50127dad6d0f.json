          "@type": [
            "schema:OpeningHoursSpecification"
          ],
          "additionalInformation": {
            "de": [
              "Täglich bis zur Schließung der Pisten und freitags und samstags in der gesamten Saison bis 20:30 Uhr geöffnet.\r\n\r\nWährend der Schulferien donnerstags, freitags und samstags bis 23 Uhr geöffnet."
            ],
            "en": [
              "Open every day until the slopes close, and until 8.30pm on Fridays and Saturdays throughout the season.\r\n\r\nDuring school vacations, open until 11pm on Thursdays, Fridays and Saturdays."
            ],
            "it": [
              "Aperto tutti i giorni fino alla chiusura delle piste e fino alle 20.30 il venerdì e il sabato per tutta la stagione.\r\n\r\nDurante le vacanze scolastiche, aperto fino alle 23.00 il giovedì, il venerdì e il sabato."
            ],
            "fr": [
              "Ouvert tous les jours jusqu'à la fermeture des pistes et jusqu'à 20h30 les vendredis et samedis de toutes la saison.\r\n\r\nPendant les vacances scolaires, ouverture jusqu'à 23h les jeudis, vendredis et samedis."
            ],
            "nl": [
              "Elke dag geopend tot de pistes sluiten en tot 20.30 uur op vrijdag en zaterdag tijdens het hele seizoen.\r\n\r\nTijdens de schoolvakanties geopend tot 23.00 uur op donderdag, vrijdag en zaterdag."
            ],
            "es": [
              "Abierto todos los días hasta el cierre de las pistas y hasta las 20.30 horas los viernes y sábados durante toda la temporada.\r\n\r\nDurante las vacaciones escolares, abierto hasta las 23 h los jueves, viernes y sábados."
            ]
          },
