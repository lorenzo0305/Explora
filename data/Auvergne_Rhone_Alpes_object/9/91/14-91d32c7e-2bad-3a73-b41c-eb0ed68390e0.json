  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/5b4b1e6c-d6f0-3bb4-a193-d34e5969da2b",
      "dc:description": {
        "de": [
          "Nehmen Sie an der 6-8 km langen Wanderung teil, die von der Fédération Française de Cardiologie am Samstag, den 12. April 2025 um 14:30 Uhr organisiert wird. Treffpunkt ist der Parkplatz des Rathauses von Coupelle Neuve. Weitere Informationen entnehmen Sie bitte dem Plakat."
        ],
        "en": [
          "Come and take part in the 6-8 km hike organized by the French Federation of Cardiology on Saturday April 12, 2025 at 2.30pm, meeting point at the Coupelle Neuve town hall parking lot. For further information, please consult the poster."
        ],
        "it": [
          "Partecipate alla camminata di 6-8 km organizzata dalla Federazione Francese di Cardiologia sabato 12 aprile 2025 alle 14.30, con ritrovo al parcheggio del municipio di Coupelle Neuve. Per maggiori informazioni, consultare la locandina."
        ],
        "fr": [
          "Venez participer à la randonnée pédestre de 6 à 8 km organisée par la Fédération Française de Cardiologie le samedi 12 avril 2025 à 14h30, rdv sur le parking de la mairie de Coupelle Neuve. Pour plus d'informations, veuillez consulter l'affiche."
        ],
        "es": [
          "Participe en la marcha de 6-8 km organizada por la Federación Francesa de Cardiología el sábado 12 de abril de 2025 a las 14.30 h, punto de encuentro en el aparcamiento del ayuntamiento de Coupelle Neuve. Para más información, consulte el cartel."
        ],
        "nl": [
          "Kom meedoen aan de 6-8 km lange wandeling georganiseerd door de Franse Federatie voor Cardiologie op zaterdag 12 april 2025 om 14.30 uur, verzamelpunt op de parkeerplaats van het gemeentehuis van Coupelle Neuve. Raadpleeg de poster voor meer informatie."
        ]
      },
