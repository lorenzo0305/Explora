            "en": [
              "Visit the Chocolate Factory Gateway from Tuesday to Friday at 1pm and 2pm. No free visit of the workshops. Shop and Coffee-Shop open to the public (except for consumption) during opening hours."
            ],
            "it": [
              "Visita alla Fabbrica di Cioccolato Gateway dal martedì al venerdì alle 13.00 e alle 14.00. Nessuna visita gratuita dei laboratori. Negozio e Coffee-Shop aperti al pubblico (bevande escluse) durante gli orari di apertura."
            ],
            "fr": [
              "Visite de la Passerelle de la Chocolaterie du mardi au vendredi à 13h et à 14h. Pas de visite libre des Ateliers. Espace Boutique et Coffee-Shop en accès libre (hors consommation) aux horaires d'ouverture."
            ],
            "es": [
              "Visite el Portal de la Fábrica de Chocolate de martes a viernes a las 13:00 y 14:00 horas. No hay visita gratuita de los talleres. Tienda y cafetería abiertas al público (sin bebidas) durante el horario de apertura."
            ],
            "nl": [
              "Bezoek de Chocoladefabriek Gateway van dinsdag tot vrijdag om 13.00 en 14.00 uur. Geen gratis bezoek van de werkplaatsen. Winkel en Coffee-Shop open voor het publiek (behalve voor consumptie) tijdens de openingsuren."
            ]
          },
