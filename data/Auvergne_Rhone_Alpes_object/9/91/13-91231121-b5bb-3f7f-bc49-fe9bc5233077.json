  "rdfs:comment": {
    "de": [
      "Sie lieben die Natur, schillernde Farbtöne und Erfahrungen, die nach Chlorophyll riechen? Dann ist dieses Praktikum genau das Richtige für Sie!"
    ],
    "en": [
      "If you love nature, shimmering hues and chlorophyll-scented experiences, this workshop is for you!"
    ],
    "it": [
      "Se amate la natura, le tonalità scintillanti e le esperienze che profumano di clorofilla, questo corso fa per voi!"
    ],
    "fr": [
      "Amoureux de la nature, des nuances chatoyantes et des expériences qui sentent bon la chlorophylle, ce stage est pour vous !"
    ],
    "es": [
