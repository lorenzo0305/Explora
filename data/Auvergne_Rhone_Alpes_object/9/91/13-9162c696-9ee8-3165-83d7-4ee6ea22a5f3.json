  "rdfs:comment": {
    "de": [
      "Betreuung und Verleih von Fahrrädern / Mountainbikes / Fahrrädern mit elektrischer Unterstützung.Profis, die Sie auf den Pfaden von Albanais führen und Ihnen die Möglichkeit geben, diese Gegend auf andere Weise zu entdecken - mit dem Fahrrad!"
    ],
    "en": [
      "Bicycle, mountain bike and mountain Ebike rentals and supervised excursions. Professional guides to accompany you on the cycle paths and mountain bike trails for an alternative tour of the Albanais region!"
    ],
    "it": [
      "Guide professioniste per accompagnarvi sui sentieri dell'Albanais e farvi scoprire questo territorio in modo diverso, in bicicletta!"
    ],
    "fr": [
      "Encadrement et location vélo / VTT / Vélo à assistance électrique.Des professionnels pour vous guider sur les sentiers de l'Albanais, et vous faire découvrir ce territoire autrement, à vélo !"
    ],
    "nl": [
      "Professionele gidsen begeleiden u op de paden van de Albanais, en helpen u dit gebied op een andere manier te ontdekken, per fiets!"
    ],
    "es": [
      "Guías profesionales para guiarte por los senderos del Albanais, y ayudarte a descubrir este territorio de una forma diferente, ¡en bicicleta!"
    ]
  },
  "rdfs:label": {
