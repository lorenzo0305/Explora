  "rdfs:comment": {
    "de": [
      "Die Route führt Sie auf Wege oberhalb der Autobahn. Schönes Panorama auf das Tal und den Genfer See."
    ],
    "en": [
      "A route allowing you to access paths over motorways and discover a lovely view of the valley and of Lake Geneva;"
    ],
    "it": [
      "Questo percorso consente di accedere a sentieri al di sopra delle autostrade e di godere di un piacevole panorama sulla valle e sul lago di Ginevra;"
    ],
    "fr": [
      "Itinéraire  permettant d'accéder à des chemins au dessus des autoroutes et de découvrir un panorama agréable de la vallée et du lac Léman;"
    ],
    "es": [
      "Esta ruta permite acceder a caminos por encima de las autopistas y disfrutar de una agradable panorámica del valle y del lago Lemán;"
    ],
    "nl": [
      "Deze route biedt toegang tot paden boven de snelwegen en een aangenaam panorama op de vallei en het meer van Genève;"
    ]
  },
