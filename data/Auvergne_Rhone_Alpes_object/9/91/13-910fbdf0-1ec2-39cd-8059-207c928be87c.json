  "rdfs:comment": {
    "de": [
      "Eine süße Lesezeit für Kleinkinder, die von ihren Eltern oder Großeltern begleitet werden. Auf dem Programm stehen Kinderalben, Reime und erste Buchentdeckungen im Animationsraum der Bibliothek. Nach Anmeldung."
    ],
    "en": [
      "A gentle moment of reading for toddlers, accompanied by their parents or grandparents. On the program: children?s books, nursery rhymes and first book discoveries, in the library?s activity room. Registration required."
    ],
    "it": [
      "Un dolce momento di lettura per i più piccoli, accompagnati dai genitori o dai nonni. In programma: libri per bambini, filastrocche e prime scoperte di libri, nella sala attività della biblioteca. Iscrizione obbligatoria."
    ],
    "fr": [
      "Un doux moment de lecture pour les tout-petits, accompagnés de leurs parents ou grands-parents. Au programme : Albums jeunesse, comptines et premières découvertes du livre, dans la salle d’animation de la bibliothèque. Sur inscription."
    ],
    "es": [
      "Un momento dulce de lectura para los más pequeños, acompañados de sus padres o abuelos. En el programa: libros infantiles, canciones infantiles y primeros descubrimientos de libros, en la sala de actividades de la biblioteca. Inscripción obligatoria."
    ],
    "nl": [
      "Een ontspannend voorleesmoment voor de allerkleinsten onder begeleiding van hun ouders of grootouders. Op het programma: kinderboeken, kinderliedjes en eerste boekontdekkingen in de activiteitenruimte van de bibliotheek. Inschrijven verplicht."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ateliers jeunesse : Crocs'Livres"
    ]
  },
