  "rdfs:comment": {
    "de": [
      "Das Reitzentrum von ValJoly bietet eine breite Palette an Aktivitäten, die Sie à la carte, in Kursen oder in Gruppenangeboten ausüben können. Ausritte und Reittouren für Anfänger und Fortgeschrittene."
    ],
    "en": [
      "The ValJoly equestrian center offers a wide range of activities that can be practiced à la carte, in courses or in group formulas. Rides and horseback riding for beginners and the more experienced."
    ],
    "it": [
      "Il centro equestre ValJoly offre un'ampia gamma di attività che possono essere praticate à la carte, in corsi o in pacchetti di gruppo. Cavalcate ed escursioni per principianti e per i più esperti."
    ],
    "fr": [
      "Le centre équestre du ValJoly offre une large gamme d’activités praticables à la carte, en stage ou en formules groupes. Des promenades et randonnées équestres pour les débutants et les plus expérimentés."
    ],
    "es": [
      "El centro ecuestre ValJoly ofrece una amplia gama de actividades que se pueden practicar a la carta, en cursos o en paquetes de grupo. Paseos y excursiones para los principiantes y los más experimentados."
    ],
    "nl": [
      "De manege ValJoly biedt een breed scala aan activiteiten die à la carte, in cursussen of in groepsarrangementen kunnen worden gedaan. Ritten en excursies voor beginners en meer ervaren ruiters."
    ]
  },
