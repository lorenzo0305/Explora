  "rdfs:comment": {
    "de": [
      "Hotel Campanile Montélimar liegt direkt vor den Toren der Drôme Provençale, nahe der Ardèche, mitten im Rhonetal."
    ],
    "en": [
      "Need a hotel in Drôme Provençale? Our Campanile is located at exit no. 17 from the A7, 10 minutes north of Montélimar ! We welcome you 7 days a week all year round with a smile. Do not hesitate to come and visit us."
    ],
    "it": [
      "Avete bisogno di un hotel in Drôme Provençale? Il nostro Campanile si trova all'uscita 17 della A7, a 10 minuti a nord di Montélimar! Vi accogliamo con un sorriso 7 giorni su 7, tutto l'anno. Non esitate a venirci a trovare!"
    ],
    "fr": [
      "Besoin d'un hôtel en Drôme Provençale ? Notre Campanile est situé à la sortie n°17 depuis l'A7 à 10 minutes au nord de Montélimar  ! Nous vous accueillons 7j/7 toute l'année avec sourire. N'hésitez pas à venir nous rendre visite !"
    ],
    "es": [
      "¿Necesita un hotel en Drôme Provençale? Nuestro Campanile está situado en la salida 17 de la A7, a 10 minutos al norte de Montélimar Le damos la bienvenida 7 días a la semana durante todo el año con una sonrisa. ¡No dude en venir a visitarnos!"
    ],
    "nl": [
      "Uw hotel-restaurant Campanile Montélimar ligt aan de poort van de Drôme Provençale, buurvrouw van de Ardèche, in het midden van de Rhône-vallei."
    ]
  },
