  "rdfs:comment": {
    "de": [
      "Als Komplizen bei der Arbeit und im Leben bieten Maxime und Myriam Ihnen verschiedene Massagetechniken zu Hause an, die auf Ihre Bedürfnisse zugeschnitten sind, um Ihnen sofortiges Wohlbefinden zu verschaffen."
    ],
    "en": [
      "Maxime and Myriam are partners in life as well as in the workplace, offering you a range of home massage techniques tailored to your needs, to bring you instant well-being."
    ],
    "it": [
      "Maxime e Myriam sono partner nella vita e nel lavoro e vi propongono una gamma di tecniche di massaggio a domicilio adattate alle vostre esigenze, per portarvi un benessere immediato."
    ],
    "fr": [
      "Complices au travail comme dans la vie, Maxime et Myriam vous offrent différentes techniques de massages à domicile adaptés sur mesure pour vous apporter un bien-être immédiat."
    ],
    "nl": [
      "Natuurgeneeskundige, opgeleide kruidendokter, reflexoloog en masseuse.\r\n\r\nOpgeleid in natuurgeneeskunde, geneeskrachtige planten en welzijnsmassages, help ik je stap voor stap je gezondheid in eigen handen te nemen."
    ],
    "es": [
      "Maxime y Myriam son compañeros tanto en la vida como en el trabajo, y le ofrecen una gama de técnicas de masaje a domicilio adaptadas a sus necesidades, para aportarle un bienestar instantáneo."
    ]
  },
  "rdfs:label": {
