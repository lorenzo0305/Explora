  "rdfs:comment": {
    "de": [
      "Willkommen auf der Echo-Domäne des Château du Mazel. Hier finden Sie einen Bauernhof mit Merino-Schafen und Angora-Ziegen.\r\nDie Unterkünfte befinden sich im Herzen des Bauernhofs auf dem Gelände des Château du Mazel."
    ],
    "en": [
      "Welcome to the echo domaine du château du Mazel. You'll find a farm with Merino sheep and Angora goats.\r\nAccommodation is in the heart of the farm within the grounds of Château du Mazel."
    ],
    "it": [
      "Benvenuti nella tenuta Château du Mazel. Troverete una fattoria con pecore Merino e capre d'Angora.\r\nL'alloggio si trova nel cuore della fattoria, nel parco dello Château du Mazel."
    ],
    "fr": [
      "Bienvenue à l'écho domaine du château du Mazel. Vous trouverez une ferme avec des brebis mérinos et des chèvres angora.\r\nLes hébergements sont au coeur de la ferme dans l'enceinte du château du Mazel."
    ],
    "nl": [
      "Welkom op het landgoed van Château du Mazel. Je vindt hier een boerderij met Merino ooien en Angora geiten.\r\nDe accommodatie ligt in het hart van de boerderij op het terrein van het Château du Mazel."
    ],
    "es": [
      "Bienvenido a la finca del Château du Mazel. Encontrará una granja con ovejas Merino y cabras Angora.\r\nEl alojamiento se encuentra en el corazón de la granja, en los terrenos del Château du Mazel."
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'écho-domaine du château du Mazel"
    ]
  },
