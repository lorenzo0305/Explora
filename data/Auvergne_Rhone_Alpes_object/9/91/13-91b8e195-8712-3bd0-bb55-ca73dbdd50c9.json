  "rdfs:comment": {
    "de": [
      "Diese Route ist in dieser Saison 2025 ausnahmsweise geschlossen.\r\nEin kurzer Hin- und Rückweg auf einem grünen Pfad, der Sie bis zur Mine von Lappiaz führt."
    ],
    "en": [
      "This trail is exceptionally closed for the 2025 season.\r\nIt’s a short out-and-back on a green trail that takes you to the Lappiaz mine."
    ],
    "it": [
      "Questo percorso è eccezionalmente chiuso per la stagione 2025.\r\nUn breve percorso ad anello su un sentiero verde che porta fino alla miniera di Lappiaz."
    ],
    "fr": [
      "Cet itinéraire est exceptionnellement fermé pour cette saison 2025.\r\nUn petit aller-retour sur une piste verte qui vous mène jusqu’à la mine de la Lappiaz."
    ],
    "es": [
      "Esta ruta está excepcionalmente cerrada durante la temporada de 2025.\r\nUn corto recorrido de ida y vuelta por una pista verde que te lleva hasta la mina de Lappiaz."
    ],
    "nl": [
      "Dit parcours is dit seizoen 2025 uitzonderlijk gesloten.\r\nHet is een korte heen-en-terugroute op een groene piste die je naar de Lappiaz-mijn brengt."
    ]
  },
