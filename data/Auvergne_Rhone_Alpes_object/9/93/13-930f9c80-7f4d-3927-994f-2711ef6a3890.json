  "rdfs:comment": {
    "de": [
      "Kleines Restaurant Pizzeria, sehr sympathisch und gut gelegen (am Rande der Nationalstraße). Es gibt einen Parkplatz. Schattige Terrasse in der warmen Jahreszeit, auf der es sich gut essen lässt. Die Menüs sind reichhaltig und die Speisekarte abwechslungsreich. Der Empfang ist freundlich."
    ],
    "en": [
      "Small and pleasant restaurant pizzeria located next to the national road. Car park. Shaded terrace during the summer months where you can enjoy your meal. \r\nMenus are wide and copious. The reception is likeable."
    ],
    "it": [
      "Piccolo e accogliente ristorante pizzeria in una buona posizione (ai margini del parco nazionale). Parcheggio. Terrazza ombreggiata nella bella stagione dove è piacevole mangiare. I menu sono abbondanti e variegati e l'accoglienza è cordiale."
    ],
    "fr": [
      "Petit restaurant pizzeria fort sympathique et bien située (en bord de nationale). Parking. Terrasse ombragée à la belle saison ou il est agréable d'y manger. Les menus sont copieux et la carte variée. l'accueil est  sympathique."
    ],
    "es": [
      "Pequeña y acogedora pizzería restaurante en una buena ubicación (al borde del parque nacional). Aparcamiento. Terraza a la sombra cuando hace buen tiempo, donde es agradable comer. Los menús son copiosos y la carta variada. La acogida es amable."
    ],
    "nl": [
      "Klein, vriendelijk pizzeria-restaurant op een goede locatie (aan de rand van het nationale park). Parkeerplaats. Schaduwrijk terras bij mooi weer waar het aangenaam eten is. De menu's zijn uitgebreid en gevarieerd. De ontvangst is vriendelijk."
    ]
  },
