  "rdfs:comment": {
    "de": [
      "Das ROC SEVEN liegt ideal direkt an der Piste und neben der Gondelbahn ROC 1 auf 2300 m Höhe und wird das höchstgelegene italienische Restaurant im Skigebiet Les Trois Vallées sein. Die Inneneinrichtung ist von der umliegenden Natur und den Bergwäldern inspiriert."
    ],
    "en": [
      "Ideally located right on the piste and next to the ROC 1 bubble at 2300m, ROC SEVEN will become the highest Italian restaurant in the 3 Valleys ski area. The interior draws its influences from the surrounding nature and mountain forests."
    ],
    "it": [
      "Pizze, paste e piatti della tradizione italiana saranno serviti dalla nostra brigata 100% transalpina. La carta dei vini presenta vini italiani e una raffinata selezione dei nostri terroir."
    ],
    "fr": [
      "Pizzas, Pastas & plats traditionnels italiens vous seront proposés par notre brigade 100% transalpine. Sur la carte des vins, des flacons venus d’Italie mais aussi une belle sélection de nos terroirs."
    ],
    "nl": [
      "ROC SEVEN is ideaal gelegen direct aan de piste en naast de ROC 1-koepel op 2300 meter hoogte, en wordt daarmee het hoogstgelegen Italiaanse restaurant in het skigebied Les Trois Vallées. Het interieur is geïnspireerd op de omringende natuur en de bergbossen."
    ],
    "es": [
      "Pizzas, pastas y platos tradicionales italianos serán servidos por nuestra brigada 100% transalpina. La carta de vinos incluye vinos italianos y una cuidada selección de nuestros terruños."
    ]
  },
