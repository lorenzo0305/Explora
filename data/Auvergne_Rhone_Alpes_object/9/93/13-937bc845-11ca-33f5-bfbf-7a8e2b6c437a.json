  "rdfs:comment": {
    "de": [
      "Das Kyriad Clermont-Ferrand-Nord Riom und sein Restaurant Anemotel heißen Sie im Herzen der Auvergne herzlich willkommen.\r\nUnser 3*-Hotel bietet Ihnen das ganze Jahr über eine warme und komfortable Umgebung."
    ],
    "en": [
      "The Kyriad Clermont-Ferrand-Nord Riom and its restaurant Anemotel welcomes you in the heart of Auvergne.\r\nOur 3* hotel offers a warm and comfortable setting all year round."
    ],
    "it": [
      "Il Kyriad Clermont-Ferrand-Nord Riom e il suo ristorante Anemotel vi danno il benvenuto nel cuore dell'Alvernia.\r\nIl nostro hotel 3 stelle offre un ambiente caldo e confortevole tutto l'anno."
    ],
    "fr": [
      "Le Kyriad Clermont-Ferrand-Nord Riom  et son restaurant Anemotel vous accueille au cœur de l’Auvergne.\r\nNotre hôtel 3* offre un cadre chaleureux et confortable tout au long de l'année."
    ],
    "nl": [
      "Het Kyriad Clermont-Ferrand-Nord Riom en zijn restaurant Anemotel heten u welkom in het hart van de Auvergne.\r\nOns 3-sterrenhotel biedt het hele jaar door een warm en comfortabel kader."
    ],
    "es": [
      "El Kyriad Clermont-Ferrand-Nord Riom y su restaurante Anemotel le dan la bienvenida al corazón de Auvernia.\r\nNuestro hotel de 3 estrellas le ofrece un marco cálido y confortable durante todo el año."
    ]
  },
