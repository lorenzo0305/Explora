  "rdfs:comment": {
    "de": [
      "Gleitsportfans....Mountainbike, BMX, Inline-Skates, Roller, Skateboard....Genießen Sie diesen Rundkurs, der aus mehreren aufeinanderfolgenden Buckeln und Steilkurven besteht!\r\n Die Strecke ist für alle Altersgruppen und jedes Niveau geeignet."
    ],
    "en": [
      "Snow sports enthusiasts....Bike, BMX, Rollerblades, Scooter, Skateboard....Come and have fun on this closed loop course, made up of several consecutive bumps and sharp turns!\r\n Accessible to all ages and all levels."
    ],
    "it": [
      "Appassionati di sport sulla neve....Bike, BMX, rollerblade, monopattini, skateboard....Venite a divertirvi su questo percorso ad anello chiuso, composto da diversi dossi consecutivi e curve a gomito!\r\n Adatto a tutte le età e capacità."
    ],
    "fr": [
      "Amateurs de sports de glisse....En VTT, BMX, Rollers, Trottinette, skateboard....Venez vous faire plaisir sur ce parcours en boucle fermée, constitué de plusieurs bosses consécutives et de virages relevés!\r\n Accessible à tous les âges et à tous niveaux."
    ],
    "nl": [
      "Sneeuwsporters....Fiets, BMX, skeelers, steps, skateboards....Kom en beleef plezier op dit parcours met gesloten lus, bestaande uit verschillende opeenvolgende hobbels en scherpe bochten!\r\n Geschikt voor alle leeftijden en niveaus."
    ],
    "es": [
      "Aficionados a los deportes de nieve....Bicicleta, BMX, patines, patinetes, monopatines....¡Ven a divertirte en este circuito cerrado, compuesto por varios baches consecutivos y curvas cerradas!\r\n Apto para todas las edades y niveles."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Pumptrack de Champfleuri/Bourgoin-Jallieu"
    ]
  },
