  "rdfs:comment": {
    "de": [
      "Ihr Restaurant PHAN'X bietet Ihnen ein Menü, das Jahrzehnte der von Müttern an Töchter weitergegebenen Familienküche widerspiegelt und traditionelle, innovative und neu interpretierte Gerichte anbietet."
    ],
    "en": [
      "Your PHAN'X restaurant offers a menu that reflects decades of family cooking handed down from mother to daughter, offering traditional, innovative and revisited dishes."
    ],
    "it": [
      "Il vostro ristorante PHAN'X offre un menu che riflette decenni di cucina familiare tramandata di madre in figlia, proponendo piatti tradizionali, innovativi e rivisitati."
    ],
    "fr": [
      "Votre restaurant  PHAN'X vous propose un  menu qui reflète des décennies  de cuisine familiale transmise de mères en filles, offrant des plats traditionnels, innovants et revisités."
    ],
    "nl": [
      "Uw PHAN'X restaurant biedt een menu dat een weerspiegeling is van tientallen jaren familiekoken, doorgegeven van moeder op dochter, met traditionele, innovatieve en vernieuwde gerechten."
    ],
    "es": [
      "Su restaurante PHAN'X ofrece un menú que refleja décadas de cocina familiar transmitida de madre a hija, ofreciendo platos tradicionales, innovadores y revisitados."
    ]
  },
  "rdfs:label": {
