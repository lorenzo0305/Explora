  "rdfs:comment": {
    "de": [
      "Das vor den Toren von Chamonix in Les Houches gelegene RockyPop entstaubt die Codes der traditionellen Hotellerie, indem es ein Hotelkonzept anbietet, das die Welten Pop, Fun und Rock miteinander vermischt."
    ],
    "en": [
      "Located at the gates of Chamonix, in Les Houches, the RockyPop is taking the traditional hotel codes out of the equation by offering a hotel concept that mixes the worlds of pop, fun and rock."
    ],
    "it": [
      "Situato alle porte di Chamonix, a Les Houches, il RockyPop rompe gli schemi dell'industria alberghiera tradizionale proponendo un concetto di hotel che unisce il mondo del pop, del divertimento e del rock."
    ],
    "fr": [
      "Situé aux portes de Chamonix, aux Houches, le RockyPop dépoussière les codes de l’hôtellerie traditionnelle en proposant un concept hôtelier mixant les univers pop, fun et rock."
    ],
    "es": [
      "Situado a las puertas de Chamonix, en Les Houches, el RockyPop rompe los moldes de la hostelería tradicional al ofrecer un concepto de hotel que combina el mundo del pop, la diversión y el rock."
    ],
    "nl": [
      "Het RockyPop, gelegen aan de poorten van Chamonix, in Les Houches, doorbreekt de traditionele hotelindustrie met een hotelconcept dat de werelden van pop, fun en rock combineert."
    ]
  },
  "rdfs:label": {
    "en": [
