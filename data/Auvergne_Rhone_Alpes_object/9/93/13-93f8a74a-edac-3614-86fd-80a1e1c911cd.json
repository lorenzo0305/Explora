  "rdfs:comment": {
    "de": [
      "Le Barillon befindet sich gegenüber dem Tourismusbüro auf dem Place du Centre in Champagny und ist eine Pizzeria-Crêperie, die Ihnen auch savoyische Spezialitäten anbietet."
    ],
    "en": [
      "Restaurant located in front of the tourist office on the centre square.\r\nSouth facing terrace. Pizzeria & pancake, Savoyard specialties."
    ],
    "it": [
      "Situato di fronte all'Ufficio del Turismo, sulla piazza di Champagny, il Barillon è una pizzeria-crêperie che offre anche specialità savoiarde."
    ],
    "fr": [
      "Situé en face de l'Office du tourisme, sur la place du centre à Champagny, le Barillon est une pizzeria-crêperie qui vous propose aussi des spécialités savoyardes."
    ],
    "es": [
      "Situado frente a la Oficina de Turismo, en la plaza de Champagny, el Barillon es una pizzería-crêperie que también ofrece especialidades saboyanas."
    ],
    "nl": [
      "Het restaurant is gelegen tegenover het Office du Tourisme, op het centrale plein te Champany.  Le Barillon is een pizzeria crêperie, die ook specialteiten van Savoie aanbiedt.\r\nHet terras is Zuidwaards gericht."
    ]
  },
