  "rdfs:comment": {
    "de": [
      "Im Herzen der Crus du Beaujolais empfängt Sie Nathalie Fauvin auf ihrem Weingut, um Ihnen den Reichtum ihres Terroirs zu zeigen. Besuchen Sie die alte Cuverie, die Weinbauanlagen und das Museum."
    ],
    "en": [
      "In the heart of the Beaujolais vineyard, Nathalie Fauvin welcomes you to her estate to share with you the wealth of her soil."
    ],
    "it": [
      "Nel cuore dei crus del Beaujolais, Nathalie Fauvin vi accoglie nella sua tenuta per farvi scoprire le ricchezze del suo terroir. Visitate l'antica tinaia, gli impianti di vinificazione e il museo."
    ],
    "fr": [
      "Au coeur des crus du Beaujolais, Nathalie Fauvin vous accueille dans son domaine pour vous faire découvrir les richesses de son terroir. Visite de l'ancienne cuverie, des installations vinicoles et du musée."
    ],
    "nl": [
      "In het hart van de crus Beaujolais heet Nathalie Fauvin u welkom op haar landgoed om u de rijkdom van haar terroir te laten ontdekken. Bezoek het oude vathuis, de wijnmakerij en het museum."
    ],
    "es": [
      "En el corazón de los crus del Beaujolais, Nathalie Fauvin le recibe en su finca para hacerle descubrir las riquezas de su terruño. Visite la antigua casa de cubas, las instalaciones de producción de vino y el museo."
    ]
  },
  "rdfs:label": {
