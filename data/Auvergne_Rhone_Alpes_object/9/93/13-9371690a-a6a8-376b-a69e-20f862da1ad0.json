  "rdfs:comment": {
    "de": [
      "Jennifer empfängt Sie in einem gemütlichen Rahmen und bietet Ihnen eine gepflegte regionale Küche, rhônealpine und korsische Spezialitäten, frische Frösche, hausgemachte Gänseleber sowie eine schöne Weinkarte mit Weinen aus Bugey und anderen Regionen."
    ],
    "en": [
      "Jennifer welcomes you in a warm setting and offers you carefully prepared local cuisine, Rhône-Alpes and Corsican specialities, fresh frogs, homemade foie gras as well as a fine wine list from Bugey and elsewhere."
    ],
    "it": [
      "Jennifer vi accoglie in un ambiente caloroso e vi offre una cucina locale accuratamente preparata, specialità del Rodano-Alpi e della Corsica, rane fresche, foie gras fatto in casa e un'ottima carta dei vini di Bugey e non solo."
    ],
    "fr": [
      "Jennifer vous accueille dans un cadre chaleureux et vous propose une cuisine de terroir soignée, des spécialités rhônealpines et corses, des grenouilles fraîches, un foie gras maison ainsi qu'une belle carte des vins du Bugey et d'ailleurs."
    ],
    "nl": [
      "Jennifer ontvangt u in een warm kader en biedt u een zorgvuldig bereide lokale keuken, specialiteiten uit de Rhône-Alpes en Corsica, verse kikkers, huisgemaakte foie gras en een fijne wijnkaart uit Bugey en elders."
    ],
    "es": [
      "Jennifer le da la bienvenida en un ambiente cálido y le ofrece una cocina local cuidadosamente preparada, especialidades del Ródano-Alpes y de Córcega, ranas frescas, foie gras casero, así como una excelente carta de vinos de Bugey y otros lugares."
    ]
  },
  "rdfs:label": {
