  "rdfs:comment": {
    "de": [
      "Eine an die Jahreszeiten angepasste Speisekarte, die je nach Ankunft, Wetter und Inspirationen variiert. Eine Küche, die kreiert wurde, um verschiedene Stile zu vereinen, von der französischen Küche über die lokale Savoyer Küche bis hin zu ausländischen Gerichten. Ein Geschmackslabor."
    ],
    "en": [
      "A menu adapted to the seasons, varying according to arrivals, weather and inspiration. A cuisine designed to combine different styles, from French to foreign to local Savoyard. A taste laboratory."
    ],
    "it": [
      "Un menu stagionale che varia a seconda della disponibilità, del tempo e dell'ispirazione. Una cucina pensata per combinare diversi stili, da quello francese a quello straniero e a quello locale savoiardo. Un laboratorio del gusto."
    ],
    "fr": [
      "Une carte adaptée aux saisons, qui varie selon les arrivages, le temps, les inspirations. Cuisine créée pour allier différents styles, de la cuisine française à la cuisine étrangère en passant par la cuisine savoyarde locale. Un laboratoire du goût."
    ],
    "es": [
      "Un menú de temporada que varía en función de las disponibilidades, el tiempo y la inspiración. Una cocina concebida para combinar diferentes estilos, desde el francés al extranjero, pasando por el local saboyano. Un laboratorio del gusto."
    ],
    "nl": [
      "Een seizoensmenu dat varieert afhankelijk van wat er beschikbaar is, het weer en inspiratie. Een keuken die verschillende stijlen combineert, van Frans tot buitenlands en Savoyaards. Een smaaklaboratorium."
    ]
  },
  "rdfs:label": {
