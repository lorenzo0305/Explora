  "rdfs:comment": {
    "de": [
      "Haben Sie Lust auf eine Pizza nach einem anstrengenden Ski- oder Wandertag? Dann sind Sie hier genau richtig. Speedza bietet Ihnen klassische Pizzen und Kreationen zum Mitnehmen an."
    ],
    "en": [
      "You want a pizza after a day spend skiing or hiking ? You are ar the right place. Speedza will propose classic and original pizzas in takeout."
    ],
    "it": [
      "Avete voglia di una pizza dopo una bella giornata di sci o di escursioni? Siete nel posto giusto. Speedza offre pizze classiche e creative da asporto."
    ],
    "fr": [
      "Une envie d’une pizza après une bonne journée de ski ou de randonnée? Vous êtes au bon endroit. Speedza vous proposera des pizzas classiques et créations à emporter."
    ],
    "es": [
      "¿Te apetece una pizza después de un buen día de esquí o senderismo? Estás en el lugar adecuado. Speedza ofrece pizzas clásicas y creativas para llevar."
    ],
    "nl": [
      "Zin in pizza na een dag skiën of wandelen? Dan ben je hier aan het juiste adres. Speedza biedt klassieke en creatieve pizza's om mee te nemen."
    ]
  },
