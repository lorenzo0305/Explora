  "rdfs:comment": {
    "de": [
      "Der Gesundheitsparcours verläuft von Valloire in Richtung Les Verneys entlang des Flusses. Er kann das ganze Jahr über benutzt werden und ist sowohl bei Familien mit Kleinkindern als auch bei Sportlern beliebt."
    ],
    "en": [
      "The fitness trail runs from Valloire along the river towards Les Verneys. It can be used all year round, and is popular with families with young children and sports enthusiasts alike."
    ],
    "it": [
      "Il percorso fitness si snoda da Valloire lungo il fiume verso Les Verneys. Può essere utilizzato tutto l'anno ed è molto apprezzato dalle famiglie con bambini piccoli e dagli sportivi."
    ],
    "fr": [
      "Le parcours de santé part de Valloire en direction des Verneys en longeant la rivière. Il est empruntable toute l'année et est aussi bien apprécié des familles avec des enfants en bas âge comme des sportifs."
    ],
    "es": [
      "La pista de fitness discurre desde Valloire a lo largo del río en dirección a Les Verneys. Se puede utilizar todo el año y es muy popular entre familias con niños pequeños y aficionados al deporte."
    ],
    "nl": [
      "Het trimparcours loopt van Valloire langs de rivier naar Les Verneys. Het kan het hele jaar door gebruikt worden en is populair bij gezinnen met jonge kinderen en sportievelingen."
    ]
  },
