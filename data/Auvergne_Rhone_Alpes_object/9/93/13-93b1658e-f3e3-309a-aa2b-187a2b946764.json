  "rdfs:comment": {
    "de": [
      "Herr Staffan Helleberg ist ein zeitgenössischer Maler und bietet Sticker und Postkarten mit schönen Darstellungen des charaktervollen Dorfes Alba-La-Romaine an. Entdecken Sie ihn in den Geschäften des Office de Tourisme Porte Sud Ardèche."
    ],
    "en": [
      "Mr. Staffan Helleberg is a contemporary painter offering stickers and postcards with beautiful representations of the village of Alba-La-Romaine . Available in the Porte Sud Ardèche Tourist Office stores."
    ],
    "it": [
      "Staffan Helleberg è un pittore contemporaneo che propone adesivi e cartoline con belle rappresentazioni del caratteristico villaggio di Alba-La-Romaine. Disponibili presso i negozi dell'Ufficio del Turismo Porte Sud Ardèche."
    ],
    "fr": [
      "M. Staffan Helleberg est artiste peintre contemporain propose des stickers et cartes postales avec de belles représentations du village de caractère Alba-La-Romaine . A découvrir dans les boutiques de l'Office de Tourisme Porte Sud Ardèche.."
    ],
    "nl": [
      "Staffan Helleberg is een hedendaagse schilder die stickers en ansichtkaarten aanbiedt met prachtige voorstellingen van het karaktervolle dorp Alba-La-Romaine. Verkrijgbaar in de winkels van het toeristenbureau Porte Sud Ardèche."
    ],
    "es": [
      "El Sr. Staffan Helleberg es un pintor contemporáneo que ofrece pegatinas y postales con bellas representaciones del característico pueblo de Alba-La-Romaine. Disponibles en las tiendas de la Oficina de Turismo de Porte Sud Ardèche."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Créateur de cartes postales et stickers"
    ]
  },
