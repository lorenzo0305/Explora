  "rdfs:comment": {
    "de": [
      "Anim'Nature bietet Animationen zur Entdeckung der Natur für Kinder und Erwachsene an. Ideal, um Geburtstage im Freien zu organisieren, vor Ort oder zum Mitnehmen!"
    ],
    "en": [
      "Anim'Nature offers nature discovery activities for both children and adults. Ideal for outdoor birthday parties, on-site or takeaway!"
    ],
    "it": [
      "Anim'Nature propone attività di scoperta della natura per bambini e adulti. Ideale per organizzare compleanni all'aperto, in loco o da portare via!"
    ],
    "fr": [
      "Anim'Nature propose des animations de découverte de la nature aux enfants et aux adultes. Idéal pour organiser les anniversaires en plein air, sur place ou à emporter !"
    ],
    "es": [
      "Anim'Nature ofrece a niños y adultos múltiples actividades para descubrir la naturaleza. Ideal para organizar cumpleaños al aire libre, para tomar o para llevar."
    ],
    "nl": [
      "Anim'Nature biedt natuurontdekkingsactiviteiten voor kinderen en volwassenen. Ideaal voor het organiseren van verjaardagen in de open lucht, ter plaatse of om mee te nemen!"
    ]
  },
