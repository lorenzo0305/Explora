  "rdfs:comment": {
    "de": [
      "Das Hotel liegt vor den Toren Genfs und empfängt Sie inmitten eines 45 Hektar großen Privatgrundstücks mit Blick auf den Mont-Blanc."
    ],
    "en": [
      "Located at the gateway to Geneva, the hotel welcomes you to the heart of a 45-hectare private estate facing Mont Blanc."
    ],
    "it": [
      "Situato alla periferia di Ginevra, l'hotel vi accoglie nel cuore di una tenuta privata di 45 ettari affacciata sul Monte Bianco."
    ],
    "fr": [
      "Situé aux portes de Genève, l’hôtel vous accueille au cœur d’un domaine privé de 45 hectares, face au Mont-Blanc."
    ],
    "es": [
      "Situado en las afueras de Ginebra, el hotel le da la bienvenida en el corazón de una finca privada de 45 hectáreas frente al Mont Blanc."
    ],
    "nl": [
      "Het hotel ligt aan de rand van Genève en verwelkomt je in het hart van een privélandgoed van 45 hectare met uitzicht op de Mont Blanc."
    ]
  },
