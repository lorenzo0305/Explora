  "rdfs:comment": {
    "de": [
      "Gesundheitsparcours mit fünf Modulen, um sich zu dehnen, die Beweglichkeit zu trainieren, das Gleichgewicht zu testen oder einfach nur ein bisschen Spaß zu haben! Für Sportler und weniger Sportliche."
    ],
    "en": [
      "A five-module fitness trail for stretching, improving flexibility, testing balance or just having a bit of fun! For the sporty and less sporty alike."
    ],
    "it": [
      "Un percorso fitness composto da cinque moduli per fare stretching, lavorare sulla flessibilità, testare l'equilibrio o semplicemente divertirsi! Per gli sportivi e i meno sportivi."
    ],
    "fr": [
      "Parcours de santé composé de cinq modules pour s'étirer, travailler sa souplesse, tester son équilibre ou pour tout simplement pour s'amuser un peu ! Pour les sportifs et les moins sportifs."
    ],
    "es": [
      "Un recorrido de fitness compuesto por cinco módulos para estirarse, trabajar la flexibilidad, poner a prueba el equilibrio o simplemente divertirse Para deportistas y menos deportistas."
    ],
    "nl": [
      "Een fitnessparcours bestaande uit vijf modules om te stretchen, aan je lenigheid te werken, je evenwicht te testen of gewoon een beetje plezier te hebben! Voor sportievelingen en minder sportievelingen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parcours de santé"
    ]
  },
