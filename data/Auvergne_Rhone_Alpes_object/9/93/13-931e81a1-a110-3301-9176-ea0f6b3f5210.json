  "rdfs:comment": {
    "de": [
      "Anne-Laurie, Designerin von handgefertigten Broschen aus Glasperlen und bestickten Broschen.\r\nAußerdem Leiterin von Kreativ-Workshops in Annecy: Stickerei, Punch Needle.\r\nIndividuelle Stickereibestellungen, Workshops für Junggesellinnenabschiede, Geburtstage."
    ],
    "en": [
      "Anne-Laurie, designer of hand-woven glass bead brooches and embroidered brooches.\r\nAlso runs creative workshops in Annecy: embroidery, punch needle.\r\nCustom embroidery orders, hen party workshops, birthday workshops, etc."
    ],
    "it": [
      "Anne-Laurie, designer di spille con perle di vetro Miyuki e di spille ricamate.\r\nGestisce anche laboratori creativi ad Annecy: ricamo, ago da punzone, ecc.\r\nOrdini di ricamo personalizzati, laboratori per occasioni speciali, compleanni..."
    ],
    "fr": [
      "Anne-Laurie, créatrice de broches en perles de verre tissées main et broches brodées.\r\nEgalement animatrice d'ateliers créatifs sur Annecy : broderie, punch needle.\r\nCommandes de broderie personnalisées, ateliers EVJF, anniversaire."
    ],
    "nl": [
      "Anne-Laurie, ontwerpster van handgeweven broches met glazen kralen en geborduurde broches.\r\nZe geeft ook creatieve workshops in Annecy: borduren, punchnaald.\r\nBorduuropdrachten op maat, workshops voor speciale gelegenheden en verjaardagen."
    ],
    "es": [
      "Anne-Laurie, diseñadora de broches de cuentas de vidrio tejidas a mano y broches bordados.\r\nTambién imparte talleres creativos en Annecy: bordado, aguja punzón.\r\nEncargos de bordados personalizados, talleres para ocasiones especiales y cumpleaños."
    ]
  },
