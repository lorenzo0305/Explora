  "rdfs:comment": {
    "de": [
      "Die AAPPMA (Association Agréée de Pêche et de Protection du Milieu Aquatique) ist ein Fischereiverein in den Gemeinden Le Chambon/Ligno, Mazet-St-Voy und Fay-sur-Lignon. Der Verein ist nicht reziprok. Angelschein vor Ort erforderlich."
    ],
    "en": [
      "The AAPPMA (Association Agréée de Pêche et de Protection du Milieu Aquatique) is a fishing society in the communes of Chambon/Ligno, Mazet-St-Voy and Fay-sur-Lignon. Non-reciprocal society. Fishing card required on site."
    ],
    "it": [
      "L'AAPPMA (Association Agréée de Pêche et de Protection du Milieu Aquatique) è una società di pesca dei comuni di Chambon/Ligno, Mazet-St-Voy e Fay-sur-Lignon. Società non reciproca. È richiesta la tessera di pesca in loco."
    ],
    "fr": [
      "L’AAPPMA (Association Agréée de Pêche et de Protection du Milieu Aquatique) est une société de pêche sur les communes du Chambon/Ligno, Mazet-St-Voy et Fay-sur-Lignon. Société non réciprocitaire. Carte de pêche obligatoire sur place."
    ],
    "es": [
      "La AAPPMA (Association Agréée de Pêche et de Protection du Milieu Aquatique) es una sociedad de pesca de los municipios de Chambon/Ligno, Mazet-St-Voy y Fay-sur-Lignon. Sociedad no recíproca. Se requiere tarjeta de pesca in situ."
    ],
    "nl": [
      "De AAPPMA (Association Agréée de Pêche et de Protection du Milieu Aquatique) is een visserijvereniging in de gemeenten Chambon/Ligno, Mazet-St-Voy en Fay-sur-Lignon. Niet-wederkerige samenleving. Viskaart ter plaatse verplicht."
    ]
  },
  "rdfs:label": {
