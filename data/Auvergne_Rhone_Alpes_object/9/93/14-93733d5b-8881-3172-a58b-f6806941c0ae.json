  "rdfs:comment": {
    "de": [
      "Im Rahmen des Contrat Local d'Education Artistique, einer Maßnahme, die von der Communauté d'agglomération Lens-Liévin in Partnerschaft mit der Direction régionale des affaires culturelles Hauts-de-France, dem Rectorat de l'académie de Lille und der Direction des services départementaux de l'éducation nationale getragen wird."
    ],
    "en": [
      "As part of the Contrat Local d'Education Artistique, a program run by the Lens-Liévin agglomeration community in partnership with the Hauts-de-France regional directorate of cultural affairs, the Lille education authority and the departmental directorate of national education."
    ],
    "it": [
      "Nell'ambito del Contratto locale di educazione artistica, un programma gestito dalla comunità urbana di Lens-Liévin in collaborazione con la Direzione regionale degli affari culturali dell'Hauts-de-France, l'autorità educativa di Lille e la Direzione dipartimentale dell'educazione nazionale."
    ],
    "fr": [
      "Dans le cadre du Contrat Local d'Education Artistique, dispositif porté par la communauté d'agglomération Lens-Liévin en partenariat avec la direction régionale des affaires culturelles Hauts-de-France, le rectorat de l'académie de Lille, la direction des services départementaux de l'éducation nationale."
    ],
    "nl": [
      "In het kader van het Lokaal Contract Kunsteducatie, een project van de stedelijke gemeenschap Lens-Liévin in samenwerking met de regionale directie voor culturele zaken van de Hauts-de-France, de onderwijsinstantie van Lille en de departementale directie voor nationaal onderwijs."
    ],
    "es": [
      "En el marco del Contrato Local de Educación Artística, una iniciativa de la comunidad urbana de Lens-Liévin en colaboración con la Dirección Regional de Asuntos Culturales de Hauts-de-France, la Autoridad Educativa de Lille y la Dirección Departamental de Educación Nacional."
    ]
  },
  "rdfs:label": {
