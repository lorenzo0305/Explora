  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Terroir durch einen Spaziergang durch die Weinberge mit erklärenden Etappen und Verkostungspausen, um mit einem Picknick aus dem Rucksack zu enden!"
    ],
    "en": [
      "Discover the terroir through a walk in the vineyards with explanatory stops and tasting breaks, ending with a picnic lunch!"
    ],
    "it": [
      "Scoprite il terroir durante una passeggiata tra i vigneti, con soste esplicative e degustazioni, per finire con un pranzo al sacco!"
    ],
    "fr": [
      "Découvrir le terroir à travers une balade dans les vignes avec des étapes explicatives et des pauses dégustation pour terminer par un pique nique tiré du sac !"
    ],
    "nl": [
      "Ontdek het terroir tijdens een wandeling door de wijngaarden, met uitleg en proefpauzes, en eindig met een picknicklunch!"
    ],
    "es": [
      "Descubra el terruño durante un paseo por los viñedos, con paradas explicativas y degustaciones, y finalice con un almuerzo campestre"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Lundi de Pentecôte, Balade dans les vignes avec le Domaine Dupasquier"
    ]
  },
