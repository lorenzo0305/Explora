  "rdfs:comment": {
    "de": [
      "Die Pokebowl ist ein gesundes, abwechslungsreiches Gericht, das direkt aus Hawaii kommt. Sie werden vor Ort aus frischen Zutaten zubereitet."
    ],
    "en": [
      "The pokebowl is a healthy, varied dish that comes to us straight from Hawaii. They are prepared on site with fresh products."
    ],
    "it": [
      "Il pokebowl è un piatto sano e vario che ci arriva dalle Hawaii. Vengono preparati sul posto con prodotti freschi."
    ],
    "fr": [
      "Le pokebowl est un plat sain, varié qui nous vient tout droit d'Hawaii. Ils sont préparés sur place avec des produits frais."
    ],
    "es": [
      "El pokebowl es un plato sano y variado que nos llega de Hawai. Se preparan al momento con productos frescos."
    ],
    "nl": [
      "De pokebowl is een gezond, gevarieerd gerecht dat afkomstig is van Hawaï. Ze worden ter plekke bereid met verse producten."
    ]
  },
