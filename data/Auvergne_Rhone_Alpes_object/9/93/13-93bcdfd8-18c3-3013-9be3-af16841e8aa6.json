  "rdfs:comment": {
    "de": [
      "Der Fahrradverleih für alle Ihre Fahrten. Wir bieten einen Fahrradverleih für alle Zwecke an: klassische Fahrräder, Kinderfahrräder und Fahrräder mit Elektrounterstützung."
    ],
    "en": [
      "Bicycle rental for all your travel needs. We offer a bicycle rental service suitable for all uses: classic bicycles, children's bicycles, and electric-assist bicycles."
    ],
    "it": [
      "Noleggio biciclette per tutti i vostri spostamenti. Offriamo un servizio di noleggio biciclette adatto a tutti gli usi: biciclette classiche, biciclette per bambini e biciclette a pedalata assistita."
    ],
    "fr": [
      "La location de vélos pour tous vos déplacements. Nous proposons un service de location de vélos adapté à tous les usages : vélos classiques, vélos enfants et vélos à assistance électrique."
    ],
    "nl": [
      "Fietsverhuur voor al je reisbehoeften. We bieden een fietsverhuurservice voor alle behoeften: klassieke fietsen, kinderfietsen en elektrisch ondersteunde fietsen."
    ],
    "es": [
      "Alquiler de bicicletas para todos sus desplazamientos. Ofrecemos un servicio de alquiler de bicicletas que se adapta a todas las necesidades: bicicletas clásicas, bicicletas para niños y bicicletas con asistencia eléctrica."
    ]
  },
