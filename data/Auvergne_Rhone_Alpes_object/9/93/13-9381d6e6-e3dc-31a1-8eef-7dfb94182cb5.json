  "rdfs:comment": {
    "de": [
      "Entdecken Sie unsere Kunsthandwerker in der Boutique das ganze Jahr über 7 Tage\r\nan sieben Tagen in der Woche. Treffen Sie Künstler, leidenschaftliche Schöpfer und\r\nprobieren Sie regionale Produkte und Käse vom Bauernhof.\r\nZögern Sie nicht, sie für weitere Informationen zu kontaktieren."
    ],
    "en": [
      "Discover our artisans at the boutique all year round 7 days\r\n7 days a week. Meet artists, passionate creators and taste local\r\nand taste local produce and farmhouse cheeses.\r\nDon't hesitate to contact them for more information."
    ],
    "it": [
      "Scoprite i nostri artigiani nella boutique tutto l'anno, 7 giorni su 7\r\n7 giorni su 7. Incontrate artisti, creatori appassionati e assaggiate prodotti locali\r\ne degustare prodotti locali e formaggi di fattoria.\r\nNon esitate a contattarli per maggiori informazioni."
    ],
    "fr": [
      "Découvrez nos artisans à la boutique toute l’année 7 jours\r\nsur 7. Rencontrez des artistes, des créateurs passionnés et\r\ndégustez des produits du terroir, des fromages fermiers.\r\nN’hésitez pas à les joindre pour plus d'informations."
    ],
    "nl": [
      "Ontdek onze ambachtslieden in de winkel het hele jaar door, 7 dagen\r\n7 dagen per week. Ontmoet kunstenaars, gepassioneerde makers en proef lokale producten\r\nen proef lokale producten en boerenkazen.\r\nAarzel niet om contact met hen op te nemen voor meer informatie."
    ],
    "es": [
      "Descubra a nuestros artesanos en la boutique todo el año, 7 días\r\n7 días a la semana. Conozca a artistas, creadores apasionados y deguste productos locales\r\ny deguste productos locales y quesos de granja.\r\nNo dude en ponerse en contacto con ellos para obtener más información."
    ]
  },
  "rdfs:label": {
