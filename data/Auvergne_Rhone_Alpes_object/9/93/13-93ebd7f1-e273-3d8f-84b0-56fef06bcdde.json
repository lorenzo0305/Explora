  "rdfs:comment": {
    "de": [
      "Unser moderner und gut ausgestatteter Bereich bietet Ihnen das Beste des Bowlingspiels in einer herzlichen Atmosphäre und garantiert Ihnen eine gute Zeit der Entspannung."
    ],
    "en": [
      "Enjoy the best of the bowling and relax in our modern bowling, with a friendly atmosphere."
    ],
    "it": [
      "La nostra moderna pista da bowling, completamente attrezzata, offre il meglio del bowling in un'atmosfera calda e amichevole, assicurandovi un grande divertimento."
    ],
    "fr": [
      "Moderne et équipé, notre espace vous offre le meilleur du bowling dans une ambiance chaleureuse et vous assure de bons moments de détente."
    ],
    "es": [
      "Nuestra moderna bolera, totalmente equipada, le ofrece lo mejor en bolos en un ambiente agradable, para que se lo pase en grande."
    ],
    "nl": [
      "Modern en goed uitgerust, onze bowling biedt de beste condities in een warme sfeer en zorgt voor een moment van ontspanning."
    ]
