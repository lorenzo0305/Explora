  "rdfs:comment": {
    "de": [
      "Ein Familienausflug, den Sie in den Weilern Thairy und Crache (St-Julien en Genevois) entdecken können. Dieser Spaziergang führt Sie auf die Spuren der Soldaten Napoleons, die sich Anfang 1814 daran machten, die Länder Savoyens zu befreien."
    ],
    "en": [
      "A family outing to discover the hamlets of Thairy and Crache (St-Julien en Genevois). This walk follows in the footsteps of Napoleon's soldiers, who set out in early 1814 to liberate the Savoy region."
    ],
    "it": [
      "Una gita in famiglia alla scoperta delle frazioni di Thairy e Crache (St-Julien en Genevois). Questa passeggiata vi porta sulle tracce dei soldati napoleonici che all'inizio del 1814 partirono per liberare la Savoia."
    ],
    "fr": [
      "Une sortie familiale à découvrir sur les hameaux de Thairy et Crache  (St-Julien en Genevois). Cette balade vous entraîne sur les traces des soldats de Napoléon, qui entreprennent au début de 1814 de libérer les pays de Savoie."
    ],
    "es": [
      "Un paseo familiar para descubrir las aldeas de Thairy y Crache (St-Julien en Genevois). Este paseo le llevará tras las huellas de los soldados de Napoleón, que partieron a principios de 1814 para liberar la región de Saboya."
    ],
    "nl": [
      "Een gezinsuitstapje om de gehuchten Thairy en Crache (St-Julien en Genevois) te ontdekken. Deze wandeling neemt je mee in de voetsporen van de soldaten van Napoleon, die begin 1814 op pad gingen om de Savoie te bevrijden."
    ]
  },
  "rdfs:label": {
    "de": [
      "Verbundener Spaziergang : Le combat de Thairy"
    ],
    "en": [
      "Connected walk: The battle of Thairy"
    ],
    "it": [
      "Passeggiata collegata: La battaglia di Thairy"
    ],
    "fr": [
      "Balade connectée : Le combat de Thairy"
    ],
    "es": [
      "Paseo conectado: La batalla de Thairy"
    ]
  },
