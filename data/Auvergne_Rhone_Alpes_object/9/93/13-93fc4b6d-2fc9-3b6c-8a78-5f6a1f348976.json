  "rdfs:comment": {
    "de": [
      "Einheitsmenü Vorspeise + Hauptgericht, Dessert und Kaffee nach Wahl.\r\nTäglich wechselnde, hausgemachte Verpflegung mit saisonalen und lokalen Produkten. Vegetarisches Gericht erhältlich. Verpflegung vor Ort und zum Mitnehmen.\r\nGroßer Saal im Inneren, Terrasse an schönen Tagen."
    ],
    "en": [
      "Choice of starter + main course, dessert and coffee.\r\nHome-cooked meals with seasonal and local produce. Vegetarian dishes available. On-site and takeaway catering.\r\nLarge indoor dining room, terrace in fine weather."
    ],
    "it": [
      "Scelta di antipasto, piatto principale, dessert e caffè.\r\nPiatti cucinati in casa con prodotti di stagione e locali. Sono disponibili piatti vegetariani. Ristorazione in loco e da asporto.\r\nAmpia sala da pranzo interna, terrazza nella bella stagione."
    ],
    "fr": [
      "Menu unique entrée + plat, dessert et café au choix.\r\nRestauration maison qui change chaque jour avec produits de saison et locaux. Plat végétarien disponible. Restauration sur place et à emporter. \r\nGrande salle intérieur, terrasse aux beaux jours."
    ],
    "nl": [
      "Keuze uit voorgerecht, hoofdgerecht, dessert en koffie.\r\nHuisgemaakte maaltijden met seizoensgebonden en lokale producten. Vegetarische gerechten beschikbaar. Catering ter plaatse en afhaalmaaltijden.\r\nGrote eetzaal binnen, terras bij mooi weer."
    ],
    "es": [
      "Entrante, plato principal, postre y café a elegir.\r\nComida casera con productos de temporada y locales. Platos vegetarianos. Restauración in situ y para llevar.\r\nAmplio comedor interior, terraza cuando hace buen tiempo."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Basilico"
    ]
  },
