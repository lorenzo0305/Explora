  "rdfs:comment": {
    "de": [
      "Erliegen Sie den Köstlichkeiten des Saint-Laurent in Moulins, wo traditionelle Küche auf kulinarische Innovation trifft. Tauchen Sie ein in die gemütliche und warme Atmosphäre unseres Lokals, das nur wenige Schritte von der Kirche Sacré-C?ur und dem Place d'Allier entfernt liegt."
    ],
    "en": [
      "Succumb to the delights of the Saint-Laurent in Moulins, where traditional cuisine meets culinary innovation. Immerse yourself in the cosy and warm atmosphere of our establishment located just a few steps from the Sacré-C?ur church and the Place d'Allier."
    ],
    "it": [
      "Lasciatevi conquistare dalle delizie del Saint-Laurent di Moulins, dove la cucina tradizionale incontra l'innovazione culinaria. Immergetevi nell'atmosfera accogliente e calorosa del nostro locale, situato a pochi passi dalla chiesa del Sacro Cuore e dalla Place d'Allier."
    ],
    "fr": [
      "Succombez aux délices du Saint-Laurent à Moulins, où la cuisine traditionnelle rencontre l'innovation culinaire. Plongez dans l'ambiance cosy et chaleureuse de notre établissement situé à deux pas de l'église du Sacré-Cœur et de la place d'Allier."
    ],
    "es": [
      "Sucumba a las delicias del Saint-Laurent de Moulins, donde la cocina tradicional se une a la innovación culinaria. Sumérjase en el ambiente acogedor y cálido de nuestro establecimiento situado a dos pasos de la iglesia del Sacré-Cœur y de la plaza de Allier."
    ],
    "nl": [
      "Geef u over aan de geneugten van de Saint-Laurent in Moulins, waar traditionele keuken en culinaire innovatie elkaar ontmoeten. Dompel uzelf onder in de gezellige en warme sfeer van ons etablissement, gelegen op een steenworp afstand van de kerk Sacré-Cé ur en de Place d'Allier."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Saint-Laurent"
    ]
  },
