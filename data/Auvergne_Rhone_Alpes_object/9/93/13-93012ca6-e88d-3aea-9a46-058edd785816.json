  "rdfs:comment": {
    "de": [
      "Das Café du Quai ist jeden Montag und Mittwoch von 14 bis 17 Uhr für gesellige Treffen, Spiele, Plaudereien... und auch etwa zweimal im Monat für verschiedene künstlerische Veranstaltungen (Musik, Tanz, Theater, Konferenz, Filmvorführung...) geöffnet"
    ],
    "en": [
      "The Café du Quai is open every Monday and Wednesday from 2 to 5 p.m. for friendly get-togethers, games, chats... and also twice a month for various artistic events (music, dance, theater, conferences, screenings...)"
    ],
    "it": [
      "Il Café du Quai è aperto ogni lunedì e mercoledì dalle 14.00 alle 17.00 per incontri conviviali, giochi, chiacchiere, ecc. e due volte al mese per una serie di eventi artistici (musica, danza, teatro, conferenze, proiezioni, ecc.)"
    ],
    "fr": [
      "Le Café du Quai est ouvert tous les lundis et mercredis de 14h à 17h pour des moments conviviaux de rencontre, jeux, papote... et aussi deux fois par mois environ pour des événements artistiques variés (musique, danse, théâtre, conférence, projection...)"
    ],
    "nl": [
      "Het Café du Quai is elke maandag en woensdag van 14.00 tot 17.00 uur geopend voor gezellige bijeenkomsten, spelletjes, kletsen, enzovoort, en twee keer per maand voor verschillende artistieke evenementen (muziek, dans, theater, lezingen, filmvertoningen, enzovoort)"
    ],
    "es": [
      "El Café du Quai está abierto todos los lunes y miércoles de 14.00 a 17.00 horas para encuentros amistosos, juegos, charlas, etc., así como dos veces al mes para diversas manifestaciones artísticas (música, danza, teatro, conferencias, proyecciones, etc.)"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Bar associatif le Quai"
    ]
  },
