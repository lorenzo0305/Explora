  "rdfs:comment": {
    "de": [
      "Der Verein Écran Village betreibt ein gemeindeübergreifendes, assoziatives Wanderkino. Jede Woche werden mehrere Filmvorführungen angeboten, in Vernoux-en-Vivarais, Lamastre, Chalencon, aber auch in anderen Städten und Dörfern in der Region Centre-Ardèche."
    ],
    "en": [
      "The Écran Village association runs an inter-municipal, travelling community cinema. Several film screenings are offered each week in Vernoux-en-Vivarais, Lamastre, Chalencon, and other towns and villages in the Centre-Ardèche region."
    ],
    "it": [
      "L'associazione Écran Village gestisce un cinema mobile intercomunale. Ogni settimana vengono proiettati diversi film a Vernoux-en-Vivarais, Lamastre e Chalencon, oltre che in altre città e villaggi della regione Centre-Ardèche."
    ],
    "fr": [
      "L'association Écran Village gère un cinéma associatif intercommunal et itinérant. Plusieurs projections de films sont proposées chaque semaine, à Vernoux-en-Vivarais, à Lamastre, à Chalencon, mais aussi dans d'autres villes et villages du Centre-Ardèche."
    ],
    "es": [
      "La asociación Écran Village gestiona un cine ambulante intercomunal. Cada semana se proyectan varias películas en Vernoux-en-Vivarais, Lamastre y Chalencon, así como en otras ciudades y pueblos de la región de Centre-Ardèche."
    ],
    "nl": [
      "De vereniging Écran Village beheert een intercommunale mobiele bioscoop. Elke week worden er verschillende films vertoond in Vernoux-en-Vivarais, Lamastre en Chalencon, maar ook in andere steden en dorpen in de regio Centre-Ardèche."
    ]
  },
