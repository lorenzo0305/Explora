  "rdfs:comment": {
    "de": [
      "Nicolas baut Freilandkartoffeln an. Viele Sorten werden als Rohware verkauft oder vakuumverarbeitet, kochfertig (Pommes frites, Würfel...)."
    ],
    "en": [
      "Nicolas produit des pommes de terre de grande culture. De nombreuses variétés sont vendues en cru ou sous vide, prêtes à cuire (frites, cubes...)."
    ],
    "it": [
      "Nicolas produce patate da campo. Molte varietà sono vendute come prodotti crudi o lavorati sottovuoto, pronti per la cottura (patatine, cubetti, ecc.)."
    ],
    "fr": [
      "Nicolas produit des pommes de terre de plein champ. De nombreuses variétés sont vendues en produits bruts ou transformés sous-vide, prêtes à cuire (frites, cubes...)."
    ],
    "nl": [
      "Nicolas produceert veldaardappelen. Veel soorten worden verkocht als rauw product of verwerkt in vacuümverpakking, klaar om te koken (chips, blokjes, enz.)."
    ],
    "es": [
      "Nicolas produce patatas de campo. Muchas variedades se venden como productos crudos o procesados y envasados al vacío, listos para cocinar (chips, cubos, etc.)."
    ]
  },
  "rdfs:label": {
