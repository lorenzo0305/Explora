  "rdfs:comment": {
    "de": [
      "Vom Anfänger bis zum erfahrenen Skifahrer: Fahren Sie auf den Pisten von Aillons-Margériaz mit den ESF-Lehrern, die Ihnen in einer geschützten natürlichen Umgebung Fortschritte ermöglichen."
    ],
    "en": [
      "From beginners to more experienced skiers, take to the slopes of Aillons-Margériaz with ESF instructors who will help you progress in a protected natural environment."
    ],
    "it": [
      "Dai principianti agli sciatori più esperti, scendete sulle piste di Aillons-Margériaz con gli istruttori ESF che vi aiuteranno a progredire in un ambiente naturale protetto."
    ],
    "fr": [
      "Du débutant au skieur plus aguerri, partez sur les pistes d'Aillons-Margériaz avec les moniteurs ESF qui vous feront progresser dans un environnement naturel préservé."
    ],
    "nl": [
      "Van beginner tot zeer ervaren skiër, de skileraren zorgen ervoor \r\ndat elke skiër bijleert op de pistes van Aillons-Margériaz in een prachtige, ongerepte natuurlijke omgeving."
    ],
    "es": [
      "Desde principiantes hasta esquiadores más experimentados, adéntrese en las pistas de Aillons-Margériaz con monitores de ESF que le ayudarán a progresar en un entorno natural protegido."
    ]
  },
  "rdfs:label": {
    "fr": [
