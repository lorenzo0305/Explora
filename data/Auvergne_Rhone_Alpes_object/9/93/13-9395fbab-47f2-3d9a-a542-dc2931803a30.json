  "rdfs:comment": {
    "de": [
      "Regionales Menü, Feinschmeckermenü, Pizzas.\r\nDie Terrasse im Schatten der hundertjährigen Linden und der klimatisierte Saal des Restaurants Domaine Arleblanc sind der richtige Ort, um die schmackhaften Menüs zu genießen."
    ],
    "en": [
      "Local specialties, gourmet menus, and pizzas: enjoy delicious dishes on the shaded terrace under century-old lime trees or in the comfort of our air-conditioned dining room. We offer the perfect setting for a relaxed and flavorful experience."
    ],
    "it": [
      "Cucina locale rivisitata dal nostro chef, piatti gourmet a base di prodotti di qualità e pizze fatte in casa. Terrazza ombreggiata o sala da pranzo climatizzata. Serate musicali. Ideale per un pasto conviviale, per i vostri eventi privati o professionali."
    ],
    "fr": [
      "Cuisine du terroir revisitée par notre chef, plats gourmands à base de produits de qualité et pizzas artisanales. Terrasse ombragée ou salle climatisée. Soirées musicales. Idéal pour un repas convivial, vos événements privés ou professionnels."
    ],
    "nl": [
      "Lokale keuken opnieuw bekeken door onze chef-kok, gastronomische gerechten op basis van kwaliteitsproducten en zelfgemaakte pizza's. Schaduwrijk terras of eetzaal met airconditioning. Muzikale avonden. Ideaal voor een gezellige maaltijd, uw privé- of professionele evenementen."
    ],
    "es": [
      "Cocina local revisitada por nuestro chef, platos gastronómicos a base de productos de calidad y pizzas caseras. Terraza a la sombra o comedor climatizado. Veladas musicales. Ideal para una comida de convivencia, sus eventos privados o profesionales."
    ]
  },
