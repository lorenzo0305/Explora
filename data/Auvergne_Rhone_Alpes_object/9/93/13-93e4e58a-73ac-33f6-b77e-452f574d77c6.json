  "rdfs:comment": {
    "de": [
      "Entdecken Sie Pizz'amore in Massongy! Treffen Sie sich am Parkplatz des alten Rathauses und genießen Sie hausgemachte Pizzas zum Mitnehmen."
    ],
    "en": [
      "Discover Pizz'amore in Massongy! Meet up at the old town hall parking lot to enjoy home-made pizzas to take away."
    ],
    "it": [
      "Scoprite il Pizz'amore a Massongy! Appuntamento al parcheggio del vecchio municipio per una pizza fatta in casa da portare via."
    ],
    "fr": [
      "Découvrez Pizz'amore à Massongy ! Rendez-vous au parking de l'ancienne mairie pour savourer des pizzas faites maison, à emporter."
    ],
    "es": [
      "¡Descubra Pizz'amore en Massongy! Quedamos en el aparcamiento del antiguo ayuntamiento para comer pizzas caseras para llevar."
    ],
    "nl": [
      "Ontdek Pizz'amore in Massongy! Kom samen op de parkeerplaats van het oude stadhuis voor zelfgemaakte pizza's om mee te nemen."
    ]
  },
