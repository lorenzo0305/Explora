  "rdfs:comment": {
    "de": [
      "Züchterin von Tieren, die für die Tiervermittlung, Öko-Weidehaltung und Wanderungen ausgebildet sind, Rasthof, Tierschutzverein, der auf Lamas und Alpakas spezialisiert ist. Besuche nach vorheriger Anmeldung."
    ],
    "en": [
      "Breeder of animals trained for animal mediation, eco-pasturing and hiking, respite farm, animal protection association specializing in llamas and alpacas. Visits by prior arrangement."
    ],
    "it": [
      "Allevatore di animali addestrati per la mediazione animale, eco-pascolo ed escursionismo, fattoria di soccorso, associazione di protezione degli animali specializzata in lama e alpaca. Visite su prenotazione."
    ],
    "fr": [
      "Éleveuse d'animaux dressés pour la médiation animale, l'éco pâturage et la randonnée, ferme de répit, association de protection animale spécialisée pour les lamas et alpagas. Visites sur réservation."
    ],
    "nl": [
      "Fokker van dieren getraind voor dierenbemiddeling, eco-weide en wandelen, respijtboerderij, dierenbeschermingsvereniging gespecialiseerd in lama's en alpaca's. Bezoeken op afspraak."
    ],
    "es": [
      "Criador de animales adiestrados para la mediación animal, eco-pasto y senderismo, granja de respiro, asociación protectora de animales especializada en llamas y alpacas. Visitas concertadas."
    ]
  },
  "rdfs:label": {
    "fr": [
