  "rdfs:comment": {
    "de": [
      "Dieses Dorf mit 273 Einwohnern im Herzen des Pays d'Urfé liegt auf 679 m Höhe und ist nur 15 Minuten von der Ausfahrt Nr. 31 der Autobahn A89 entfernt."
    ],
    "en": [
      "In the heart of the Pays d'Urfé, this village of 273 inhabitants is situated at an altitude of 679m, 15 minutes from exit 31 of the A89 freeway."
    ],
    "it": [
      "Nel cuore del Pays d'Urfé, questo villaggio di 273 abitanti è situato a 679 metri di altitudine e dista 15 minuti dall'uscita 31 dell'autostrada A89."
    ],
    "fr": [
      "Au cœur du Pays d’Urfé, ce village de 273 habitants situé à 679m d’altitude est à 15 min de la sortie n°31 de l’autoroute A89."
    ],
    "nl": [
      "In het hart van het Pays d'Urfé ligt dit dorp met 273 inwoners op een hoogte van 679 meter en op 15 minuten van afrit 31 van de snelweg A89."
    ],
    "es": [
      "En el corazón del Pays d'Urfé, este pueblo de 273 habitantes está situado a 679 metros de altitud y a 15 minutos de la salida 31 de la autopista A89."
