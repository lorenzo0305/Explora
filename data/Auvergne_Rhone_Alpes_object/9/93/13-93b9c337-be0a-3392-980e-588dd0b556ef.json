  "rdfs:comment": {
    "de": [
      "Wein- und Tapasbar ab Freitagabend. Restaurant von Dienstag bis Freitag mittags.\r\nSamstag: Bar, Weinbar und Menü.\r\nReservierung vorzugsweise per Telefon."
    ],
    "en": [
      "Wine and tapas bar from Friday evening. \r\nRestaurant from Tuesday to Friday lunchtime.\r\nSaturday: bar, wine bar and menu.\r\nReservations preferably by telephone."
    ],
    "it": [
      "Wine and tapas bar dal venerdì sera. Ristorante da martedì a venerdì a pranzo.\r\nSabato: bar, enoteca e menu.\r\nPrenotazioni preferibilmente telefoniche."
    ],
    "fr": [
      "Bar à vin et tapas à partir du vendredi soir. Restaurant du mardi au vendredi midi.\r\nSamedi : bar, bar à vin et menu.\r\nRéservation de préférence par téléphone."
    ],
    "nl": [
      "Wijn- en tapasbar vanaf vrijdagavond. Restaurant van dinsdag tot vrijdag lunchtijd.\r\nZaterdag: bar, wijnbar en menu.\r\nReserveren bij voorkeur telefonisch."
    ],
    "es": [
      "Bar de vinos y tapas a partir del viernes por la noche. Restaurante de martes a viernes al mediodía.\r\nSábado: bar, vinoteca y menú.\r\nReservas preferentemente por teléfono."
    ]
  },
