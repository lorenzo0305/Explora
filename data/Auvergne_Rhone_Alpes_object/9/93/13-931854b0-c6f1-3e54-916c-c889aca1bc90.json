  "rdfs:comment": {
    "de": [
      "Die ACCA La Diane du Vercors hat die Aufgabe, eine gute Jagdverwaltung in einem bestimmten Gebiet innerhalb von La Chapelle-en-Vercors zu gewährleisten."
    ],
    "en": [
      "The mission of the ACCA La Diane du Vercors is to ensure good hunting management on a given territory within La Chapelle-en-Vercors."
    ],
    "it": [
      "La missione dell'ACCA La Diane du Vercors è quella di garantire una buona gestione della caccia su un determinato territorio all'interno di La Chapelle-en-Vercors."
    ],
    "fr": [
      "L'ACCA La Diane du Vercors a pour mission de s'assurer d'une bonne gestion de la chasse sur un territoire donné, au sein de la Chapelle-en-Vercors."
    ],
    "es": [
      "La misión del ACCA La Diane du Vercors es velar por la buena gestión de la caza en un territorio determinado dentro de La Chapelle-en-Vercors."
    ],
    "nl": [
      "De missie van de ACCA La Diane du Vercors is ervoor te zorgen dat de jacht goed wordt beheerd op een bepaald grondgebied binnen La Chapelle-en-Vercors."
    ]
  },
