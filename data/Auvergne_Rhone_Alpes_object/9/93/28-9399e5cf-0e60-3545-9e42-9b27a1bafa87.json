  "rdfs:comment": {
    "de": [
      "Täglich von 8:00 bis 22:00 Uhr am Automaten!\nDer Automat bietet Ihnen auch saisonales Obst und Gemüse aus lokaler Produktion an."
    ],
    "en": [
      "Visit the distributor every day from 8am to 10pm!\nThe distributor also offers seasonal fruits and vegetables from local production."
    ],
    "it": [
      "Visitate il distributore automatico tutti i giorni dalle 8 alle 22!\nIl distributore automatico offre anche frutta e verdura di stagione di produzione locale."
    ],
    "fr": [
      "RDV au distributeur tous les jours de 8h à 22h!\nLe distributeur vous propose également des fruits et légumes de saison, issus de productions locales."
    ],
    "es": [
      "Visite la máquina expendedora todos los días de 8 a 22 h\nLa máquina expendedora también ofrece fruta y verdura de temporada de producción local."
    ],
    "nl": [
