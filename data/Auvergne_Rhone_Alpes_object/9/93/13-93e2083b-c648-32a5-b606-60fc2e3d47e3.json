  "rdfs:comment": {
    "de": [
      "In 1670 m Höhe mit einem 360°-Panoramablick und einer Südlage genießen Sie unsere Savoyer Spezialitäten, Burger, Crêpes und vieles mehr.\r\nUnser Lokal verfügt auch über einen Snackbereich für kleine Zwischenmahlzeiten."
    ],
    "en": [
      "At an altitude of 1670m with a 360 degree panoramic view and a southern exposure come and taste our Savoyard specialities, burgers, crepes and much more. Our establishment includes a snack bar with a selection of quick bites to eat, covering all of your catering needs."
    ],
    "it": [
      "A 1670 m di altitudine, con una vista panoramica a 360° e un'esposizione a sud, venite a gustare le nostre specialità savoiarde, hamburger, crêpes e molto altro.\r\nLa nostra struttura dispone anche di un'area snack per piccoli spuntini."
    ],
    "fr": [
      "A 1670m d'altitude avec une vue panoramique à 360° et une exposition plein sud venez déguster nos spécialités Savoyardes, burgers, crêpes et bien plus.\r\nNotre établissement dispose également d'une partie snack pour les petits encas."
    ],
    "nl": [
      "Kom op 1670m hoogte, met een panoramisch uitzicht van 360° en een zuidelijke ligging, genieten van onze Savoyaardse specialiteiten, hamburgers, crêpes en nog veel meer.\r\nOns restaurant heeft ook een snackbar."
    ],
    "es": [
      "A 1670 m de altitud, con una vista panorámica de 360° y orientación sur, venga a degustar nuestras especialidades saboyanas, hamburguesas, crepes y mucho más.\r\nNuestro establecimiento también dispone de una zona de aperitivos para pequeños tentempiés."
    ]
  },
  "rdfs:label": {
    "en": [
      "Les Lhottys"
    ],
