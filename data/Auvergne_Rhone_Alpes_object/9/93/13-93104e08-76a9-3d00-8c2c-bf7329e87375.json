  "rdfs:comment": {
    "de": [
      "Diese Route führt Sie auf eine Entdeckungsreise durch den Osten von Roannais. Weit entfernt von hohen Gipfeln ist diese Strecke dennoch hügelig und bietet schöne Ausblicke auf die Ebene von Roannaise."
    ],
    "en": [
      "This trail takes you on a discovery tour of the East Roannais. Far from the high peaks, this route is nevertheless undulating and offers beautiful views over the Roannais plain."
    ],
    "it": [
      "Questo percorso vi porta alla scoperta del Roannais orientale. Lontano dalle alte vette, questo percorso è comunque ondulato e offre una bella vista sulla pianura del Roannais."
    ],
    "fr": [
      "Ce circuit vous emmène à la découverte de l'Est Roannais. Loin des hauts sommets, ce parcours est pourtant vallonnée et offre de belles vues sur la plaine roannaise."
    ],
    "es": [
      "Este sendero le llevará a descubrir la Roannais oriental. Lejos de las altas cumbres, esta ruta es sin embargo ondulada y ofrece hermosas vistas de la llanura de Roannais."
    ],
    "nl": [
      "Deze route neemt je mee op ontdekkingstocht door de Oost-Roannais. Ver van de hoge toppen is deze route toch heuvelachtig en biedt hij mooie uitzichten over de Roannais-vlakte."
    ]
  },
  "rdfs:label": {
    "fr": [
      "N°G - Circuit Gravel Autour du Rhodon"
    ]
  },
