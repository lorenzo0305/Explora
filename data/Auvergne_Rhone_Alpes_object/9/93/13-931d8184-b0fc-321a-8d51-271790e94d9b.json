  "rdfs:comment": {
    "de": [
      "Entdecken Sie die zwei neuen Padel-Bahnen in Courchevel 1850!\r\n\r\n \r\n\r\nDie neuen Padel-Plätze mit zwei Außenbahnen befinden sich gegenüber dem Ineos-Gebäude in Courchevel 1850."
    ],
    "en": [
      "Discover the two new Padel courts at Courchevel 1850!\r\n\r\n \r\n\r\nThe new padel courts, featuring two outdoor courts, are located opposite the Ineos building in Courchevel 1850."
    ],
    "it": [
      "Scoprite i due nuovi campi da padel a Courchevel 1850!\r\n\r\n \r\n\r\nI nuovi campi da padel, con due campi all'aperto, si trovano di fronte all'edificio Ineos di Courchevel 1850."
    ],
    "fr": [
      "Découvrez les deux nouvelles pistes de Padel à Courchevel 1850 !\r\n\r\n \r\n\r\nLes nouveaux terrains de padel, comprenant deux pistes extérieures, sont situés face au bâtiment Ineos de Courchevel 1850."
    ],
    "es": [
      "¡Descubra las dos nuevas pistas de pádel de Courchevel 1850!\r\n\r\n \r\n\r\nLas nuevas pistas de pádel, con dos pistas exteriores, están situadas frente al edificio Ineos de Courchevel 1850."
    ],
    "nl": [
      "Ontdek de twee nieuwe padelbanen in Courchevel 1850!\r\n\r\n \r\n\r\nDe nieuwe padelbanen, met twee buitenbanen, liggen tegenover het Ineos-gebouw in Courchevel 1850."
    ]
  },
