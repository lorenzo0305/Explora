  "rdfs:comment": {
    "de": [
      "Unser 14. Brauereistandort wurde in der Isère, in Tignieu, eröffnet! Wir verpflichten uns, unsere Werte zu respektieren: gute Biere, die in Tarare gebraut werden, lokale Zutaten für unsere Burger und garantiert 100% kostenlose Konzerte von Künstlern aus der Region."
    ],
    "en": [
      "Our 14th brewery opened in Isère, in Tignieu! We are committed to respecting our values: good beers brewed in Tarare, local ingredients for our burgers and guaranteed 100% free concerts by local artists."
    ],
    "it": [
      "Il nostro 14° brewpub è stato aperto a Tignieu, nell'Isère! Ci impegniamo a rispettare i nostri valori: buone birre prodotte a Tarare, ingredienti locali per i nostri hamburger e concerti garantiti 100% gratuiti di artisti locali."
    ],
    "fr": [
      "Notre 14e lieu de brassage a ouvert en Isère, à Tignieu ! Nous nous engageons à respecter nos valeurs : de bonnes bières brassées à Tarare, des ingrédients locaux pour nos burgers et des concerts garantis 100% gratuits d'artistes du cru."
    ],
    "nl": [
      "Onze 14e brouwerij is geopend in Tignieu, Isère! We zijn toegewijd aan onze waarden: goede bieren gebrouwen in Tarare, lokale ingrediënten voor onze hamburgers en gegarandeerd 100% gratis concerten van lokale artiesten."
    ],
    "es": [
      "Nuestro decimocuarto brewpub ha abierto en Tignieu, Isère Estamos comprometidos con nuestros valores: buenas cervezas elaboradas en Tarare, ingredientes locales para nuestras hamburguesas y conciertos 100% gratuitos garantizados por artistas locales."
    ]
  },
