  "rdfs:comment": {
    "de": [
      "Als Teil des Natura 2000-Schutzgebiets empfängt Sie der Plan d'eau de Boistray an seinen Ufern, um Ihnen die außergewöhnliche Artenvielfalt zu zeigen, die er beherbergt."
    ],
    "en": [
      "On the banks of the Saône is the carnivorous fish and other carps of the magnificent 14 ha lake of Boistray, classified in 2nd category."
    ],
    "it": [
      "Parte integrante dell'area protetta Natura 2000, il lago di Boistray vi accoglie sulle sue sponde per scoprire la sua eccezionale biodiversità."
    ],
    "fr": [
      "Parti intégrante de l’espace protégé Natura 2000, le plan d’eau de Boistray vous accueille sur ses rives pour vous faire découvrir la biodiversité exceptionnelle qu’il abrite."
    ],
    "es": [
      "Parte integrante de la zona protegida Natura 2000, el lago de Boistray le da la bienvenida a sus orillas para descubrir su excepcional biodiversidad."
    ],
    "nl": [
      "Het meer van Boistray, dat deel uitmaakt van het beschermde Natura 2000-gebied, verwelkomt je aan zijn oevers om zijn uitzonderlijke biodiversiteit te ontdekken."
    ]
  },
