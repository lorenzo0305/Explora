  "rdfs:comment": {
    "de": [
      "Besuchen Sie das Atelier der Keramikerin Myriam (zeitgenössische Keramik). Besichtigung des Arbeitsplatzes und Entdeckung der persönlichen Arbeit an keramischen Kreationen. Möglichkeit von Kursen für Erwachsene und Kinder."
    ],
    "en": [
      "Visit Myriam's workshop (contemporary ceramics). Take a tour of the studio and discover her personal ceramic creations. Classes available for adults and children."
    ],
    "it": [
      "Visita al laboratorio di Myriam (ceramica contemporanea). Visitate l'atelier e scoprite le sue creazioni personali in ceramica. Corsi disponibili per adulti e bambini."
    ],
    "fr": [
      "Visitez l'atelier de Myriam céramiste (céramique contemporaine). Visite du lieu de travail et découverte du travail personnel de créations céramiques. Possibilité de cours adultes et enfants."
    ],
    "es": [
      "Visite el taller de Myriam (cerámica contemporánea). Recorra el taller y descubra sus creaciones cerámicas personales. Cursos para adultos y niños."
    ],
    "nl": [
      "Bezoek het atelier van Myriam (hedendaagse keramiek). Volg een rondleiding door het atelier en ontdek haar persoonlijke keramische creaties. Cursussen beschikbaar voor volwassenen en kinderen."
    ]
  },
  "rdfs:label": {
