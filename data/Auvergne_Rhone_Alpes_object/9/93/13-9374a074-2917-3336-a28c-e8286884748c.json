  "rdfs:comment": {
    "de": [
      "Ein Geschäftsessen oder eine Familienfeier? Das Team des Petit Boudoir bietet Ihnen ein authentisches Erlebnis in einer entspannten Atmosphäre. Unsere Gerichte sind hausgemacht und werden aus ausgewählten Produkten zubereitet, die vorwiegend aus der Region stammen.\r\nTagesgericht: 12,90?"
    ],
    "en": [
      "A business lunch or a family event? The team at the Petit Boudoir offers an authentic experience in a relaxed atmosphere. Our dishes are homemade and locally sourced."
    ],
    "it": [
      "Un pranzo di lavoro o un evento familiare? Il team del Petit Boudoir vi offre un'esperienza autentica in un'atmosfera rilassata. I nostri piatti sono fatti in casa, utilizzando principalmente prodotti di provenienza locale.\r\nPiatto del giorno: € 12,90"
    ],
    "fr": [
      "Un repas d'affaires ou un événement familial? L'équipe du Petit Boudoir vous propose une expérience authentique dans un esprit décontracté. Nos plats sont faits maison à partir de produits sélectionnés principalement en circuit court.\r\nPlat du jour: 12,90€"
    ],
    "es": [
      "¿Una comida de negocios o un evento familiar? El equipo de Petit Boudoir le ofrece una experiencia auténtica en un ambiente relajado. Nuestros platos son caseros y se elaboran principalmente con productos locales.\r\nPlato del día: 12,90"
    ],
    "nl": [
      "Een zakendiner of een familiefeest? Het Petit Boudoir team biedt u een authentieke ervaring in een ontspannen sfeer. Onze gerechten zijn huisgemaakt, met voornamelijk lokale producten.\r\nDagschotel: € 12,90"
    ]
  },
