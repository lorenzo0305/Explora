  "rdfs:comment": {
    "de": [
      "Pierre empfängt Sie inmitten einer Maulbeerbaumplantage. Hier können Sie in familiärer Atmosphäre traditionelle Gerichte genießen."
    ],
    "en": [
      "Pierre welcome you to the heart of a plantation of over 500 mulberry trees. You can enjoy traditional cuisine in a family atmosphere."
    ],
    "it": [
      "Pierre vi accoglie nel cuore di una piantagione di gelsi. Assaporate la cucina tradizionale in un'atmosfera familiare."
    ],
    "fr": [
      "Pierre vous accueille au cœur d'une plantation de mûriers. Vous pourrez déguster une cuisine traditionnelle dans une ambiance familiale."
    ],
    "es": [
      "Pierre le da la bienvenida al corazón de una plantación de moreras. Disfrute de la cocina tradicional en un ambiente familiar."
    ],
    "nl": [
      "Pierre heet je welkom in het hart van een moerbeiplantage. Geniet van de traditionele keuken in een familiale sfeer."
    ]
  },
