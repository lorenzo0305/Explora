  "rdfs:comment": {
    "de": [
      "Am Fuße des Saint-Sorlin-Gletschers und des Pic de l'Étendard ist Saint-Sorlin-d'Arves ein charaktervolles Dorf, das sich nach und nach auf den Sommer-Winter-Tourismus ausgerichtet hat."
    ],
    "en": [
      "At the foot of the Saint-Sorlin glacier and the Étendard peak, Saint-Sorlin-d'Arves is a village with character that has gradually turned towards summer-winter tourism."
    ],
    "it": [
      "Ai piedi del ghiacciaio di Saint-Sorlin e della vetta dell'Étendard, Saint-Sorlin-d'Arves è un villaggio pieno di carattere che si è gradualmente orientato verso il turismo estivo e invernale."
    ],
    "fr": [
      "Au pied du glacier de Saint-Sorlin et du pic de l’Étendard, Saint-Sorlin-d’Arves est un village de caractère qui s’est progressivement orienté vers le tourisme été-hiver."
    ],
    "es": [
      "Al pie del glaciar de Saint-Sorlin y del pico Étendard, Saint-Sorlin-d'Arves es un pueblo con carácter que se ha ido orientando hacia el turismo de verano-invierno."
    ],
    "nl": [
      "Aan de voet van de gletsjer van Saint-Sorlin en de top van Étendard ligt Saint-Sorlin-d'Arves, een karaktervol dorp dat zich geleidelijk heeft gericht op zomer- en wintertoerisme."
    ]
  },
