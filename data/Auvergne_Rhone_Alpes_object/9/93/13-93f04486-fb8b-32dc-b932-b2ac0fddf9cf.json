  "rdfs:comment": {
    "de": [
      "Mit seiner rockigen Stimme führt uns Nasser ins Herz des Blues, dorthin, wo alles begann: vom Mississippi bis nach Chicago."
    ],
    "en": [
      "With his gravelly voice, Nasser plunges us into the heart of the blues, where it all began: from Mississippi to Chicago."
    ],
    "it": [
      "Con la sua voce roca, Nasser ci porta nel cuore del blues, dove tutto è cominciato: dal Mississippi a Chicago."
    ],
    "fr": [
      "Avec sa voix rocailleuse, Nasser nous plonge au coeur du blues, là où tout a commencé : du Mississipi à Chicago."
    ],
    "nl": [
      "Met zijn gruizige stem neemt Nasser ons mee naar het hart van de blues, waar het allemaal begon: van Mississippi tot Chicago."
    ],
    "es": [
      "Con su voz rasposa, Nasser nos lleva al corazón del blues, donde todo empezó: de Mississippi a Chicago."
    ]
  },
