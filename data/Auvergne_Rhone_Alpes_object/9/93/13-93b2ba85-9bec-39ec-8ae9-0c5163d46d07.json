  "rdfs:comment": {
    "de": [
      "Clémence , Kunsthandwerkerin, fertigt Artikel für den Reitsport (Califourchon und Amazone), die Jagd, Lederwaren und Schmuck sowie alle Reparaturen an. Die Artikel werden hauptsächlich nach Maß angefertigt."
    ],
    "en": [
      "Clémence , Artisan d'Art makes articles for riding (straddle and amazon), hunting, leather goods and jewelry, as well as all kinds of repairs. Most items are made-to-measure."
    ],
    "it": [
      "Clémence, artigiana d'arte, realizza articoli per l'equitazione (cavallerizza e amazzone), la caccia, la pelletteria e la gioielleria, oltre a tutti i tipi di riparazioni. La maggior parte dei suoi lavori è realizzata su misura."
    ],
    "fr": [
      "Clémence , Artisan d'Art réalise des articles pour l’équitation (califourchon et amazone), la chasse, la maroquinerie et la bijouterie ainsi que toutes réparations. La fabrication des articles est principalement réalisée sur mesure."
    ],
    "es": [
      "Clémence , Artisan d'Art realiza artículos para equitación (a horcajadas y amazonas), caza, marroquinería y joyería, así como todo tipo de reparaciones. La mayoría de sus trabajos se realizan a medida."
    ],
    "nl": [
      "Clémence , Artisan d'Art maakt artikelen voor paardrijden (straddle en amazone), jacht, lederwaren en sieraden, maar ook allerlei reparaties. Het meeste werk wordt op maat gemaakt."
    ]
  },
