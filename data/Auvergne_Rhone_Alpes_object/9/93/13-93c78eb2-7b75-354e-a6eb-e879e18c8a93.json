  "rdfs:comment": {
    "de": [
      "Ehemalige Poststation aus Stein, 7 km von Nyons entfernt, Richtung Gap. Kreative, hausgemachte regionale Küche. Vegetarische Gourmetgerichte, Lammbraten, Taube, Kalbsbries. Schattiger Parkplatz, blumengeschmückte Terrasse im Schatten von Schilfrohr. Blick auf die Landschaft."
    ],
    "en": [
      "Ancient stone-walled Post Office, totally renovated and turned into a restaurant ; 7km from Nyons. Creative and regional cooking, everything is home made. Goat cheese specialities ; roasted loin of lamb ; Pigeon ; Sweetbread. Both parking and terrace are flowered and shaded."
    ],
    "it": [
      "Antica locanda in pietra a 7 km da Nyons, sulla strada per Gap. Cucina regionale creativa e casalinga. Piatti vegetariani gourmet, agnello arrosto, piccione, animelle di vitello. Parcheggio ombreggiato, terrazza fiorita e ombreggiata da canisses. Vista sulla campagna."
    ],
    "fr": [
      "Ancien relais de poste en pierres à 7 km de Nyons, direction Gap. Cuisine régionale créative faite maison. Plats Végétariens gastronomiques, Agneau rôti, Pigeon, Ris de Veau. Parking ombragé, terrasse fleurie à l’ombre des canisses. Vue sur la campagne."
    ],
    "nl": [
      "Voormalig postkantoor opgetrokken uit mooie kalksteen op 7 km van Nyons, richting Gap. Regionale en creatieve huisgemaakte gerechten. Specialiteiten met lokale geitenkaas en gegrilde lamsrib met knoflook en tijm. Bloemrijk en schaduwrijk terras. Uitzicht op het platteland,"
    ],
    "es": [
      "Antigua posada de piedra a 7 km de Nyons, camino de Gap. Cocina regional casera y creativa. Platos vegetarianos gastronómicos, cordero asado, pichón, mollejas de ternera. Aparcamiento sombreado, terraza florida a la sombra de canisses. Vistas sobre el campo."
    ]
  },
