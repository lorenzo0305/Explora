  "rdfs:comment": {
    "de": [
      "Maison Excellia ist ein Schönheitsinstitut in Bellerive-sur-Allier, das individuelle Gesichtsbehandlungen, Wellness-Massagen, Sinnesrituale und Haarentfernungen anbietet. Jede Behandlung ist auf jeden Hauttyp abgestimmt, um eine maßgeschneiderte Erfahrung in einem esp"
    ],
    "en": [
      "Maison Excellia is a beauty salon in Bellerive-sur-Allier offering personalized facial treatments, well-being massages, sensory rituals and waxing. Each treatment is adapted to each skin type, to offer a tailor-made experience in a relaxing environment"
    ],
    "it": [
      "La Maison Excellia è un salone di bellezza di Bellerive-sur-Allier che offre trattamenti viso personalizzati, massaggi benessere, rituali sensoriali e cerette. Ogni trattamento è adattato a ciascun tipo di pelle per offrire un'esperienza su misura in un ambiente rilassante"
    ],
    "fr": [
      "Maison Excellia est un institut de beauté à Bellerive-sur-Allier proposant des soins visage personnalisés, massages bien-être, rituels sensoriels et épilations. Chaque soin est adapté à chaque type de peau pour offrir une expérience sur-mesure dans un esp"
    ],
    "nl": [
      "Maison Excellia is een schoonheidssalon in Bellerive-sur-Allier dat gepersonaliseerde gezichtsbehandelingen, welzijnsmassages, zintuiglijke rituelen en harsen aanbiedt. Elke behandeling wordt aangepast aan elk huidtype om een ervaring op maat te bieden in een ontspannende omgeving"
    ],
    "es": [
      "Maison Excellia es un salón de belleza de Bellerive-sur-Allier que ofrece tratamientos faciales personalizados, masajes de bienestar, rituales sensoriales y depilación. Cada tratamiento se adapta a cada tipo de piel para ofrecer una experiencia a medida en un entorno relajante"
    ]
  },
