  "rdfs:comment": {
    "de": [
      "Kleine Geschichte von Cabanes ...\r\nDie Beobachtung, Wertschätzung und Befragung unseres baulichen oder natürlichen Erbes ist ein Anliegen der Bürgerbildung und ein Beitrag zur Erhaltung dieses gemeinsamen Reichtums."
    ],
    "en": [
      "A short history of Cabanes ...\r\nObserving, appreciating and questioning our heritage, whether built or natural, is an important part of our civic education and our contribution to preserving this shared wealth."
    ],
    "it": [
      "Breve storia di Cabanes...\r\nOsservare, apprezzare e interrogare il nostro patrimonio, sia esso costruito o naturale, è una parte importante dell'educazione civica e della conservazione della nostra ricchezza comune."
    ],
    "fr": [
      "Petite histoire de Cabanes ...\r\nObserver, apprécier et interroger notre patrimoine, bâti ou naturel, est un enjeu d'éducation citoyenne et de contribution à la préservation de cette richesse commune."
    ],
    "nl": [
      "Een korte geschiedenis van Cabanes...\r\nOns erfgoed observeren, waarderen en in vraag stellen, of het nu gebouwd of natuurlijk is, is een belangrijk onderdeel van burgereducatie en helpt onze gedeelde rijkdom te bewaren."
    ],
    "es": [
      "Breve historia de Cabanes...\r\nObservar, apreciar y cuestionar nuestro patrimonio, construido o natural, es una parte importante de la educación cívica y contribuye a preservar nuestra riqueza común."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Projet Cabane"
    ]
  },
