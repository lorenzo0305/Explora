  "rdfs:comment": {
    "de": [
      "Les Écuries d'Usson sind ideal gelegen, nur 10 Minuten von der Autobahn A75 (Ausfahrt 13 Richtung Sauxillanges) entfernt, in einer ruhigen und angenehmen Umgebung."
    ],
    "en": [
      "The Écuries d'Usson are ideally located 10 minutes from the A75 freeway (exit 13 towards Sauxillanges) in a quiet, pleasant setting."
    ],
