  "rdfs:comment": {
    "de": [
      "Poudre d'Escampette ist eine Reiseagentur im Herzen der französischen Alpen, die sich einem umweltbewussten Ansatz verschrieben hat. Wir bieten Ihnen unsere Palette an Elektrofahrrädern (VTCAE) zum Verleih an!"
    ],
    "en": [
      "Poudre d'Escampette is an eco-responsible travel agency in the heart of the French Alps. We offer our range of electric bikes (VTCAE) for hire!"
    ],
    "it": [
      "Poudre d'Escampette è un'agenzia di viaggi eco-responsabile nel cuore delle Alpi francesi. Offriamo una gamma di biciclette elettriche (VTCAE) a noleggio!"
    ],
    "fr": [
      "Poudre d'Escampette est une agence de voyage au cœur des Alpes françaises, inscrite dans une démarche écoresponsable. Nous vous proposons notre gamme de vélos électriques (VTCAE) à la location !"
    ],
    "nl": [
      "Poudre d'Escampette is een ecologisch verantwoord reisbureau in het hart van de Franse Alpen. Wij verhuren elektrische fietsen (VTCAE)!"
    ],
    "es": [
      "Poudre d'Escampette es una agencia de viajes eco-responsable en el corazón de los Alpes franceses. ¡Ofrecemos una gama de bicicletas eléctricas (VTCAE) de alquiler!"
    ]
  },
  "rdfs:label": {
    "en": [
      "Electrically assisted mountain bike hire - Poudre d'Escampette"
    ],
    "fr": [
      "Location VTT à assistance électrique - Poudre d'Escampette"
    ]
  },
