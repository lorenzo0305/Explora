  "rdfs:comment": {
    "de": [
      "Ihre Reiseberaterinnen empfangen Sie jeden Tag in der Touristeninformation, um alle Ihre Fragen zu beantworten und so Ihren Aufenthalt so angenehm wie möglich zu gestalten."
    ],
    "en": [
      "Your tourist advisors are on hand every day at the tourist office to answer all your questions and make your stay as pleasant as possible."
    ],
    "it": [
      "I vostri consulenti turistici sono a disposizione ogni giorno presso l'Ufficio del Turismo per rispondere a tutte le vostre domande e rendere il vostro soggiorno il più piacevole possibile."
    ],
    "fr": [
      "Vos conseillères en séjour vous accueillent tous les jours à l'office de tourisme pour répondre à toutes vos questions et rendre ainsi votre séjour le plus agréable possible."
    ],
    "es": [
      "Sus asesores turísticos están a su disposición todos los días en la Oficina de Turismo para responder a todas sus preguntas y hacer que su estancia sea lo más agradable posible."
    ],
    "nl": [
      "Je toeristische adviseurs staan elke dag klaar bij het VVV-kantoor om al je vragen te beantwoorden en je verblijf zo aangenaam mogelijk te maken."
    ]
  },
