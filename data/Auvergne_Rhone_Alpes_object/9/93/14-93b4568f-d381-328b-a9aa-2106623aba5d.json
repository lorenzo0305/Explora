  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/0c94e291-5180-3898-a794-eb68c309c177",
      "dc:description": {
        "de": [
          "Workshop Recovery: Entdecke in Begleitung eines Mediators die verschiedenen Meeresknotenpunkte und stelle dir dann dein eigenes Bild vor und kreiere es!"
        ],
        "en": [
          "Atelier récup': accompanied by a mediator, discover the different marine knots, then imagine and create your own painting!"
        ],
        "it": [
          "Laboratorio \"Recupero\": accompagnati da un mediatore, scoprite i diversi nodi marini e poi immaginate e create il vostro quadro!"
        ],
        "fr": [
          "Atelier récup' : accompagné d'un médiateur, découvre les différents nœuds marins puis imagine et crée ton propre tableau !"
        ],
        "es": [
          "Taller \"Recuperar\": acompañado por un mediador, descubra los diferentes nudos marinos y, después, ¡imagine y cree su propio cuadro!"
        ],
        "nl": [
          "Herstel' workshop: ontdek onder begeleiding van een mediator de verschillende zeeknopen en bedenk en maak daarna je eigen schilderij!"
        ]
      },
