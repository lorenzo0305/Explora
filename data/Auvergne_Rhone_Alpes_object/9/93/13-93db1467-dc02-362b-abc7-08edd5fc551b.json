  "rdfs:comment": {
    "de": [
      "Nach einer Umschulung arbeitet Fanny seit vier Jahren als Schneckenzüchterin auf dem Bauernhof ihrer Familie in Bézaudun-sur-Bîne. Sie züchtet etwa 100 000 Schnecken im Freigehege, die auf dem Hof verarbeitet werden."
    ],
    "en": [
      "Following a career change, Fanny has been a snail farmer for 4 years on the family farm in Bézaudun-sur-Bîne. She raises around 100,000 snails in outdoor pens, which are then processed on the farm."
    ],
    "it": [
      "Dopo una riconversione professionale, Fanny è stata per 4 anni coltivatrice di lumache nell'azienda agricola di famiglia a Bézaudun-sur-Bîne. Alleva circa 100.000 lumache in un parco all'aperto che vengono lavorate in azienda."
    ],
    "fr": [
      "Suite à une reconversion professionnelle, Fanny est hélicicultrice  depuis 4 ans  sur la ferme familiale à Bézaudun-sur-Bîne. Elle élève environ 100 000 escargots en parc exterieur qui sont transformés sur la ferme."
    ],
    "es": [
      "Tras una reconversión profesional, Fanny se dedica a la cría de caracoles desde hace 4 años en la granja familiar de Bézaudun-sur-Bîne. Cría unos 100.000 caracoles en un parque al aire libre que se procesan en la granja."
    ],
    "nl": [
      "Na een carrièreswitch is Fanny sinds 4 jaar slakkenkweker op de familieboerderij in Bézaudun-sur-Bîne. Ze kweekt ongeveer 100.000 slakken in buitenkooien, die vervolgens op de boerderij worden verwerkt."
    ]
  },
