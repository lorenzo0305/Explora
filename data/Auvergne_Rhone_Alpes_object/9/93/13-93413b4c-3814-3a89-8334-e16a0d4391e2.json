  "rdfs:comment": {
    "de": [
      "Die Kirche Saint-Arnoux in Montguers wurde 1688 errichtet. Sie gehörte zur Diözese Gap. Sie steht isoliert von jeglicher Bebauung und ist in der Ebene postiert."
    ],
    "en": [
      "Saint-Arnoux church in Montguers was built in 1688. It belonged to the diocese of Gap. Isolated from any habitation, it stands on a plain."
    ],
    "it": [
      "La chiesa di Saint Arnoux de Montguers fu costruita nel 1688. Apparteneva alla diocesi di Gap. È isolata da qualsiasi abitazione e si trova in pianura."
    ],
    "fr": [
      "L’église Saint-Arnoux de Montguers est élevée en 1688. Elle appartenait au diocèse de Gap. Elle est isolée de toute habitation, postée dans la plaine."
    ],
    "es": [
      "La iglesia de Saint Arnoux de Montguers fue construida en 1688. Pertenecía a la diócesis de Gap. Está aislada de cualquier vivienda y se encuentra en la llanura."
    ],
    "nl": [
      "De kerk Saint-Arnoux in Montguers werd gebouwd in 1688. Ze behoorde toe aan het bisdom Gap. Het is geïsoleerd van elke bewoning en staat op de vlakte."
    ]
  },
