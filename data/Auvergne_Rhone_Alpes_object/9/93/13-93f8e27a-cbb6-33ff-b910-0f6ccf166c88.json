  "rdfs:comment": {
    "de": [
      "Entweder im Saal oder auf der Terrasse können Sie abwechslungsreiche, großzügige und traditionelle Gerichte mit asiatischem Flair genießen: Sushi, Maki, Spieße, Suppen..."
    ],
    "en": [
      "Either in the dining room or on the terrace, come and taste varied, generous and traditional dishes with an Asian flavour: sushi, makis, brochettes, soups..."
    ],
    "it": [
      "Nella sala da pranzo o sulla terrazza, venite a gustare piatti variegati, generosi e tradizionali dal sapore asiatico: sushi, maki, brochette, zuppe..."
    ],
    "fr": [
      "Soit en salle soit en terrasse, venez déguster des mets variés, généreux et traditionnels au parfum asiatique : sushis, makis, brochettes, soupes..."
    ],
    "nl": [
      "Kom in de eetzaal of op het terras proeven van gevarieerde, gulle en traditionele gerechten met een Aziatisch tintje: sushi, maki's, brochettes, soepen..."
    ],
    "es": [
      "En el comedor o en la terraza, venga a degustar platos variados, generosos y tradicionales con sabor asiático: sushi, makis, brochetas, sopas..."
    ]
  },
