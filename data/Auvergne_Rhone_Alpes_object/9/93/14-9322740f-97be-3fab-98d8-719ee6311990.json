  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/15c6e24a-de34-3672-b3bb-0bae1eacbf35",
      "dc:description": {
        "de": [
          "Folk-Konzert\nDonnerstag, den 19. Februar um 20:30 Uhr\n5 place de la Gare ? Montreuil Ville-Basse (Unterstadt)\n-------------------------------\nTimshel - aus Rouen stammend präsentiert ein Konzert zwischen zerbrechlichem Folk und den Schreien der Geschundenen.\nDie Band wird anlässlich der Veröffentlichung ihres ersten Albums auf Tournee gehen.\n\nCredit: Timshel - La Maison des Faiseurs"
        ],
        "en": [
          "Folk concert\nThursday, February 19 at 8:30pm\n5 place de la Gare ? Montreuil Ville-Basse\n-------------------------------\nTimshel - from Rouen, France - present a concert of fragile folk and ecorché cries.\nThe band will be touring for the release of their debut album.\n\nCredit: Timshel - La Maison des Faiseurs"
        ],
        "it": [
          "Concerto folk\nGiovedì 19 febbraio alle 20.30\n5 place de la Gare ? Montreuil Ville-Basse\n-------------------------------\nI Timshel - da Rouen, Francia - presentano un concerto di folk fragile e urla crude.\nIl gruppo sarà in tour per celebrare l'uscita del suo album di debutto.\n\nCredit: Timshel - La Maison des Faiseurs"
        ],
        "fr": [
          "Concert Folk \nJeudi 19 février à 20h30\n5 place de la Gare – Montreuil Ville-Basse\n-------------------------------\nTimshel - originaire de Rouen présente un concert entre folk fragile et cris d’écorchés.\nLe groupe sera en tournée pour la sortie de son premier album.\n\nCrédit : Timshel - La Maison des Faiseurs"
        ],
        "nl": [
          "Folkconcert\nDonderdag 19 februari om 20.30 uur\n5 place de la Gare ? Montreuil Ville-Basse\n-------------------------------\nTimshel - uit Rouen, Frankrijk - presenteert een concert van breekbare folk en rauw geschreeuw.\nDe band is op tournee om de release van hun debuutalbum te vieren.\n\nKrediet: Timshel - La Maison des Faiseurs"
        ],
        "es": [
          "Concierto folk\nJueves 19 de febrero a las 20.30 h\n5 place de la Gare ? Montreuil Ville-Basse\n-------------------------------\nTimshel -de Rouen, Francia- presenta un concierto de folk frágil y gritos crudos.\nEl grupo estará de gira para celebrar el lanzamiento de su álbum de debut.\n\nCrédito: Timshel - La Maison des Faiseurs"
        ]
      },
