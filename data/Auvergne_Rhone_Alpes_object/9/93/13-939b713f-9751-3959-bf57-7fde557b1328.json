  "rdfs:comment": {
    "de": [
      "Neben der Kirche Saint-Nicolas befindet sich das Museum für sakrale Kunst, in dem etwa fünfzig Objekte aus dem 18. bis 19. Jahrhundert ausgestellt sind, die die Geschichte des Dorfes erzählen!"
    ],
    "en": [
      "Next to the church of Saint-Nicolas, the Musée d'Art Sacré (Sacred Art Museum) displays some 50 objects dating from the 18th to the 19th centuries, retracing the history of the village."
    ],
    "it": [
      "Accanto alla chiesa di Saint-Nicolas, il Museo d'Arte Sacra espone una cinquantina di oggetti risalenti al XVIII-XIX secolo, ripercorrendo la storia del villaggio!"
    ],
    "fr": [
      "A côté de l'église de Saint-Nicolas, le musée d’art Sacré présente une collection permanente avec une cinquantaine d’objets, allant du 18è au 19è siècle, retraçant l’histoire du village et une exposition temporaire annuelle sur différentes thématiques."
    ],
    "nl": [
      "Naast de kerk Saint-Nicolas toont het Museum voor Heilige Kunst een vijftigtal voorwerpen uit de 18e tot 19e eeuw, die de geschiedenis van het dorp vertellen!"
    ],
    "es": [
      "Junto a la iglesia de Saint-Nicolas, el Museo de Arte Sacro cuenta con una colección permanente de unos cincuenta objetos de los siglos XVIII al XIX, que recorren la historia del pueblo, y una exposición temporal anual sobre diversos temas."
    ]
  },
