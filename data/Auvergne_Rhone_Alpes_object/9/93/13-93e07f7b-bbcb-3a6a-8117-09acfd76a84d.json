  "rdfs:comment": {
    "de": [
      "Geführte Besichtigung unseres Ziegenhofs, Streicheln der Zicklein, Besuch bei den Hühnern, Kaninchen...\r\nAnschließend Verkostung unseres Käsesortiments."
    ],
    "en": [
      "Guided tour of our goat farm, petting the goats, visiting the chickens, rabbits...\r\nFollowed by a tasting of our range of cheeses."
    ],
    "it": [
      "Visita guidata alla nostra fattoria, accarezzando le capre, visitando le galline e i conigli...\r\nPoi assaggiate la nostra gamma di formaggi."
    ],
    "fr": [
      "Visite guidée de notre chèvrerie, caresses aux chevrettes, visite aux poules, lapin...\r\nPuis dégustation de notre gamme de fromages."
    ],
    "es": [
      "Visita guiada a nuestra granja de cabras, acariciando las cabras, visitando las gallinas y los conejos...\r\nA continuación, deguste nuestra gama de quesos."
    ],
    "nl": [
      "Rondleiding over onze geitenboerderij, de geiten aaien, de kippen en konijnen bezoeken...\r\nProef daarna onze kazen."
    ]
