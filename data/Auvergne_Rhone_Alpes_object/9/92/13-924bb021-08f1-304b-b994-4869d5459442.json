  "rdfs:comment": {
    "de": [
      "Acht Künstler öffnen die Türen ihrer Ateliers und Boutiquen Chabad'Arts für Sie!\r\nEntdecken Sie ihre Werke oder nehmen Sie an ihren Workshops teil."
    ],
    "en": [
      "Eight artists open the doors of their Chabad'Arts studio-boutique!\r\nCome and discover their works or take part in their workshops."
    ],
    "it": [
      "Chabad'Arts è uno studio-boutique comunitario che offre arte locale accessibile a tutti.\nVenite a scoprire le opere o a partecipare ai numerosi laboratori creativi."
    ],
    "fr": [
      "Chabad'Arts est un atelier-boutique associatif proposant un art à proximité et accessible à toutes et tous.\nVenez découvrir les œuvres ou encore participer aux nombreux ateliers créatifs."
    ],
    "es": [
      "Chabad'Arts es un estudio-boutique comunitario que ofrece arte local al alcance de todos.\nVenga a descubrir las obras o participe en los numerosos talleres creativos."
    ],
    "nl": [
      "Acht kunstenaars openen de deuren van hun Chabad'Arts studio-boutique!\r\nKom hun werk ontdekken of neem deel aan hun workshops."
    ]
  },
