  "rdfs:comment": {
    "de": [
      "Mademoiselle Simone bietet ein einzigartiges Erlebnis in Lyon: kreative saisonale Küche, Gourmetbuffet, Signature-Cocktails und intime Live-Konzerte. Eine elegante und gesellige Adresse, an der Gastronomie und Jazz im Einklang vibrieren."
    ],
    "en": [
      "Mademoiselle Simone offers a unique Dining in Jazz experience in Lyon, blending creative seasonal cuisine, a generous buffet, signature cocktails and intimate live concerts in an elegant, warm atmosphere."
    ],
    "it": [
      "Mademoiselle Simone offre un'esperienza unica a Lione: cucina creativa di stagione, buffet gourmet, cocktail d'autore e intimi concerti dal vivo. Un indirizzo elegante e accogliente dove gastronomia e jazz vibrano all'unisono."
    ],
    "fr": [
      "Mademoiselle Simone propose une expérience unique à Lyon : cuisine créative de saison, buffet gourmand, cocktails signature et concerts live intimistes. Une adresse élégante et conviviale où gastronomie et jazz vibrent à l’unisson."
    ],
    "es": [
      "Mademoiselle Simone ofrece una experiencia única en Lyon: cocina creativa de temporada, bufés gourmet, cócteles de autor y conciertos íntimos en directo. Una dirección elegante y acogedora donde la gastronomía y el jazz vibran al unísono."
    ],
    "nl": [
      "Mademoiselle Simone biedt een unieke ervaring in Lyon: creatieve seizoensgerechten, gastronomische buffetten, kenmerkende cocktails en intieme liveconcerten. Een elegant en vriendelijk adres waar gastronomie en jazz één worden."
    ]
  },
