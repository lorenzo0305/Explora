      "dc:description": {
        "de": [
          "Um 20.30 Uhr\nEintritt: 20 ? zugunsten der Augenforschung Retina France.\n\nBegleitet von :\nDavid Dufossé (Bassgitarre)\nLaurent Binda (Perkussion)\nSimon Libert (Gitarren)"
        ],
        "en": [
          "At 8:30pm\nAdmission: 20? to benefit Retina France ophthalmology research.\n\nAccompanied by :\nDavid Dufossé (bass guitar)\nLaurent Binda (percussion)\nSimon Libert (guitars)"
        ],
        "it": [
          "Alle 20.30\nIngresso: 20 euro a favore della ricerca oftalmologica di Retina France.\n\nAccompagnato da :\nDavid Dufossé (basso)\nLaurent Binda (percussioni)\nSimon Libert (chitarra)"
        ],
        "fr": [
          "A 20h30\nEntrée : 20 € au profit de la recherche en ophtalmologie Retina France.\n\nAccompagné par :\nDavid Dufossé (guitare basse)\nLaurent Binda (percussions)\nSimon Libert (guitares)"
        ],
        "nl": [
          "Om 20.30 uur\nEntree: 20? ten bate van Retina France oogheelkundig onderzoek.\n\nBegeleid door :\nDavid Dufossé (basgitaar)\nLaurent Binda (percussie)\nSimon Libert (gitaren)"
        ],
        "es": [
          "A las 20.30 h\nEntrada: 20? a beneficio de la investigación oftalmológica de Retina France.\n\nAcompañado por :\nDavid Dufossé (bajo)\nLaurent Binda (percusión)\nSimon Libert (guitarras)"
        ]
      },
