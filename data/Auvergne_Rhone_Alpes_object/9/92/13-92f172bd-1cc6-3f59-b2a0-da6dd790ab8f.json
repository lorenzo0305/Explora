  "rdfs:comment": {
    "de": [
      "Die Kirche Saint-Paul ist neben der Kirche in Le Vésinet eine der beiden Kirchen in Frankreich, die von dem großen Architekten Louis Boileau erbaut wurde. Auguste Boileau, der als erster die Ressourcen der Metallkonstruktion in der religiösen Architektur zu nutzen wusste."
    ],
    "en": [
      "Saint-Paul is one of only 2 churches in France, the other being Le Vésinet, built by the great architect Louis. Auguste Boileau, who was the 1st to exploit the resources of metal construction in religious architecture."
    ],
    "it": [
      "Saint-Paul è una delle due sole chiese in Francia, l'altra è Le Vésinet, costruita dal grande architetto Louis. Auguste Boileau fu il primo a sfruttare le risorse della costruzione metallica nell'architettura religiosa."
    ],
    "fr": [
      "L'église Saint-Paul est l'une des 2 églises de France avec celle du Vésinet construite par le grand architecte Louis. Auguste Boileau qui sut exploiter le 1er les ressources de la construction métallique dans l'architecture religieuse."
    ],
    "nl": [
      "Saint-Paul is een van slechts 2 kerken in Frankrijk, de andere is Le Vésinet, gebouwd door de grote architect Louis. Auguste Boileau was de eerste die de mogelijkheden van metaalconstructies gebruikte in de religieuze architectuur."
    ],
    "es": [
      "Saint-Paul es una de las 2 únicas iglesias de Francia, la otra es Le Vésinet, construida por el gran arquitecto Louis. Auguste Boileau fue el primero en explotar los recursos de la construcción metálica en la arquitectura religiosa."
    ]
  },
