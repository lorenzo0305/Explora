  "rdfs:comment": {
    "de": [
      "Die Communauté de communes Ardèche Rhône Coiron, die Gemeinde Le Teil und die SMAC 07 haben 2019 ein Projekt zur Sanierung der alten Schlachthöfe von Le Teil gestartet, um sie in einen zukünftigen Ort für aktuelle Musik in Le Teil zu verwandeln!"
    ],
    "en": [
      "The Communauté de communes Ardèche Rhône Coiron, the commune of Le Teil and SMAC 07 have launched a project to rehabilitate the former abattoirs in Le Teil in 2019 in order to transform them into a future venue for contemporary music in Le Teil!"
    ],
    "it": [
      "La Communauté de communes Ardèche Rhône Coiron, il comune di Le Teil e lo SMAC 07 hanno lanciato un progetto per ristrutturare gli ex mattatoi di Le Teil nel 2019, trasformandoli in un futuro spazio per la musica contemporanea a Le Teil!"
    ],
    "fr": [
      "La Communauté de communes Ardèche Rhône Coiron, la commune du Teil et la SMAC 07 ont lancé en 2019 un projet de réhabilitation des anciens abattoirs du Teil afin de les transformer en un futur lieu de musiques actuelles au Teil !"
    ],
    "es": [
      "La Communauté de communes Ardèche Rhône Coiron, el municipio de Le Teil y la SMAC 07 han puesto en marcha un proyecto para renovar los antiguos mataderos de Le Teil en 2019, ¡transformándolos en un futuro espacio para la música contemporánea en Le Teil!"
    ],
    "nl": [
      "De Communauté de communes Ardèche Rhône Coiron, de gemeente Le Teil en SMAC 07 hebben een project gelanceerd om de voormalige slachthuizen in Le Teil in 2019 te renoveren en om te vormen tot een toekomstige locatie voor hedendaagse muziek in Le Teil!"
    ]
  },
  "rdfs:label": {
