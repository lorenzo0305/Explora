  "rdfs:comment": {
    "de": [
      "Chatuzange-le-Goubet bewahrt ein äußerst reiches und vielfältiges Kulturerbe, dessen wichtigste Sehenswürdigkeiten das Schloss von Pizançon, der Weiler Part-Dieu und das befestigte Haus von Cizeranne sind."
    ],
    "en": [
      "Chatuzange-le-Goubet boasts an extremely rich and diverse heritage, with major sites including the Château de Pizançon, the hamlet of La Part-Dieu and the fortified house of La Cizeranne."
    ],
    "it": [
      "Chatuzange-le-Goubet possiede un patrimonio estremamente ricco e diversificato, i cui siti principali sono il castello di Pizançon, il borgo di Part-Dieu e la casa fortificata di Cizeranne."
    ],
    "fr": [
      "Chatuzange-le-Goubet conserve un patrimoine extrêmement riche et diversifié dont les sites majeurs sont le château de Pizançon, le hameau de la Part-Dieu et la maison forte de la Cizeranne."
    ],
    "nl": [
      "Deze gemeente bestaat uit vier dorpen: Chatuzange, Le Goubet, Pizançon en Papelissier. Het 50 km lange kanaal van de Bourne dat door de gemeente loopt, werd eind 19e eeuw aangelegd voor de irrigatie van het dal van Valence en telt talrijke sluizen en bruggen."
    ],
    "es": [
      "Chatuzange-le-Goubet posee un patrimonio muy rico y diversificado, cuyos principales lugares son el castillo de Pizançon, la aldea de Part-Dieu y la casa fortificada de Cizeranne."
    ]
  },
