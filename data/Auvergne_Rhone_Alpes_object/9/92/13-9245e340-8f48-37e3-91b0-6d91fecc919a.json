    "de": [
      "Wir begrüßen Sie in unserem familiären, gemütlichen Restaurant, wo Sie eine gute Zeit verbringen können, im Sommer auf unserer Terrasse."
    ],
    "en": [
      "We welcome you to our warm and cosy family restaurant, so that you can enjoy a pleasant time, in summer on our terrace."
    ],
    "it": [
