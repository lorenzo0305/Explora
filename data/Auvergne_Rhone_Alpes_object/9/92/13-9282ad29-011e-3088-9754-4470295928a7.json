  "rdfs:comment": {
    "de": [
      "Kommen Sie nach Châtillon-Saint-Jean, um den St. Patrick's Day zu feiern! Auf dem Programm stehen ein Live-Konzert von Men in Ska, Essen und Trinken und die Übertragung des Spiels Frankreich-England! Kommen Sie zahlreich!"
    ],
    "en": [
      "Come and celebrate St. Patrick's Day in Châtillon-Saint-Jean! On the program: live concert by Men in Ska, catering and broadcast of the France-England match! Come one, come all!"
    ],
    "it": [
      "Venite a festeggiare il giorno di San Patrizio a Châtillon-Saint-Jean! Il programma prevede un concerto dal vivo dei Men in Ska, cibo e bevande e la proiezione della partita Francia-Inghilterra! Venite tutti!"
    ],
    "fr": [
      "Venez fêter la Saint-Patrick à Châtillon-Saint-Jean à l'occasion de la Saint-Jean Patrick ! Au programme : concert live de Men in Ska, restauration et diffusion du match France-Angleterre ! Venez nombreux !"
    ],
    "es": [
      "Venga a celebrar el día de San Patricio en Châtillon-Saint-Jean El programa incluye un concierto en directo de Men in Ska, comida y bebida y la proyección del partido Francia-Inglaterra Vengan todos"
    ],
    "nl": [
      "Kom St Patrick's Day vieren in Châtillon-Saint-Jean! Op het programma staan een live concert van Men in Ska, eten en drinken en een vertoning van de wedstrijd Frankrijk-Engeland! Komt allen!"
    ]
  },
  "rdfs:label": {
