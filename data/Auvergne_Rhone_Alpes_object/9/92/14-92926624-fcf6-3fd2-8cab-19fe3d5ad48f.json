  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/c3d88269-1e72-3436-b663-044b3c529cc1",
      "dc:description": {
        "de": [
          "Man nehme eine hungrige Schäferin und eine Herde frecher und ungeduldiger Schafe... Setzen Sie das Ganze auf eine grüne Wiese, fügen Sie einen gierigen Wolf, die Sonne und, warum nicht, Sterne hinzu!"
        ],
        "en": [
          "Take a hungry shepherdess and a flock of naughty, impatient sheep... Put it all in a green meadow, add a greedy wolf, some sunshine and why not some stars!"
        ],
        "it": [
          "Prendete una pastorella affamata e un gregge di pecore dispettose e impazienti... Mettete tutto in un prato verde, aggiungete un lupo avido, un po' di sole e, perché no, qualche stella!"
        ],
        "fr": [
          "Prenez une bergère affamée et un troupeau de moutons coquins et impatients... Mettez le tout dans une prairie verdoyante, ajoutez-y un loup gourmand, du soleil et pourquoi pas des étoiles !"
        ],
        "nl": [
          "Neem een hongerige herderin en een kudde ondeugende, ongeduldige schapen... Zet alles in een groene weide, voeg een gulzige wolf toe, wat zonneschijn en waarom niet wat sterren!"
        ],
        "es": [
          "Coge una pastora hambrienta y un rebaño de ovejas traviesas e impacientes... Ponlo todo en un prado verde, añade un lobo glotón, un poco de sol y, por qué no, ¡algunas estrellas!"
        ]
      },
      "@type": [
        "Description"
