  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Ardèche mit einem Hauch von Fantasie! Begleitung mit geländegängigen elektrischen Tretrollern.\r\nSpaziergänge zur Entdeckung des Kulturerbes, Wege in der Natur, kleine Straßen und Besuche von \"kaladierten\" Dörfern. Die Spaziergänge sind nicht sportlich."
    ],
    "en": [
      "Discover the Ardèche with a touch of fantasy! Accompaniment on electric all-terrain scooters.\r\nHeritage walks, nature trails, small roads and visits to \"caladés\" villages. All rides are non-sporty."
    ],
    "it": [
      "Scoprite l'Ardèche con un tocco di fantasia! Accompagnamento su scooter elettrici.\r\nPasseggiate alla scoperta del patrimonio, percorsi naturalistici, piccole strade e visite ai villaggi \"caladés\". Le corse non sono sportive."
    ],
    "fr": [
      "Découvrez l'Ardèche avec un brin de fantaisie ! Accompagnement en trottinettes tout terrain électrique.\r\nPromenades à la découverte du patrimoine, chemins dans la nature, petites routes et visites de villages \"caladés\". Les balades sont non sportives."
    ],
    "es": [
      "¡Descubra la Ardèche con un toque de fantasía! Acompañamiento en patinetes eléctricos.\r\nPaseos para descubrir el patrimonio, rutas naturales, pequeños caminos y visitas a pueblos caladés. Los paseos no son deportivos."
    ],
    "nl": [
      "Ontdek de Ardèche met een twist! Begeleiding op elektrische all-terrain scooters.\r\nWandelingen om het erfgoed van de streek te ontdekken, natuurpaden, binnenwegen en bezoeken aan 'caladés'-dorpjes. De ritten zijn niet sportief."
    ]
  },
  "rdfs:label": {
    "de": [
      "Frank Rivière und Josée Grégoire: Begleitung von geländegängigen Elektrotrottinetts"
    ],
    "ru": [
      "Frank Rivière et Josée Grégoire : Accompagnement trottinettes électriques tout terrain"
    ],
    "en": [
