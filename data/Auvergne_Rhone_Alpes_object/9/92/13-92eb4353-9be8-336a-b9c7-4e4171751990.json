  "rdfs:comment": {
    "de": [
      "Biologisch bewirtschafteter Milchviehbetrieb mit Kirsch- und Mirabellenproduktion in nachhaltiger Landwirtschaft. Empfang von Familien, und verschiedenen Strukturen das ganze Jahr über mit Workshops im Rhythmus der Jahreszeiten"
    ],
    "en": [
      "Dairy farm in organic production mode with production of cherries and mirabelle plums in integrated agriculture. Reception of families, and various structures throughout the year with workshops at the rhythm of the seasons"
    ],
    "it": [
      "Azienda lattiero-casearia in regime di produzione biologica con produzione di ciliegie e prugne mirabelle in agricoltura integrata. Accogliamo famiglie e organizzazioni varie durante tutto l'anno con laboratori in linea con le stagioni"
    ],
    "fr": [
      "Exploitation laitière en mode de production biologique avec des productions de cerises et mirabelles en agriculture raisonnée. Accueil de familles, et de différentes structures tout au long de l'année avec des ateliers au rythme des saisons"
    ],
    "es": [
      "Granja lechera en régimen de producción ecológica con producción de cerezas y ciruelas mirabel en agricultura integrada. Acogemos a las familias y a diversas organizaciones durante todo el año con talleres acordes con las estaciones"
    ],
    "nl": [
      "Biologisch melkveebedrijf met productie van kersen en mirabelpruimen in geïntegreerde landbouw. Wij verwelkomen families en verschillende organisaties het hele jaar door met workshops in overeenstemming met de seizoenen"
    ]
  },
  "rdfs:label": {
