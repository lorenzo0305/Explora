  "rdfs:comment": {
    "de": [
      "Individuelle Wellness-Massagen in Vichy. Eine sanfte Auszeit, um Stress abzubauen, Verspannungen zu lindern und Ihren Thermalaufenthalt perfekt abzurunden. In der Praxis nach Terminvereinbarung."
    ],
    "en": [
      "Personalized wellness massages in Vichy. A gentle interlude to relieve stress, ease tension and perfectly complement your spa stay. In the office by appointment."
    ],
    "it": [
      "Massaggi benessere personalizzati a Vichy. Un dolce intermezzo per alleviare lo stress, sciogliere le tensioni e completare perfettamente il vostro soggiorno termale. In ufficio su appuntamento."
    ],
    "fr": [
      "Massages de bien-être personnalisés à Vichy. Une parenthèse de douceur pour relâcher le stress, apaiser les tensions et compléter parfaitement votre séjour thermal. En cabinet sur rendez-vous."
    ],
    "nl": [
      "Persoonlijke welzijnsmassages in Vichy. Een zacht intermezzo om stress te verlichten, spanningen te verlichten en je spavakantie perfect af te ronden. Op kantoor op afspraak."
    ],
    "es": [
      "Masajes de bienestar personalizados en Vichy. Un paréntesis de dulzura para aliviar el estrés, relajar las tensiones y poner el broche de oro a sus vacaciones termales. En el consultorio con cita previa."
    ]
  },
