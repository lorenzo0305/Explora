  "rdfs:comment": {
    "de": [
      "Der Trail du Mézenc ist eine Sport- und Familienveranstaltung, die die Teilnehmer für Kinderkrebs sensibilisiert. Alle Einnahmen werden dafür verwendet.\r\nTreffpunkt: ab 14 Uhr in Les Estables."
    ],
    "en": [
      "The Trail du Mézenc is a sporting and family event that raises awareness of childhood cancer. All proceeds go to this cause.\r\nStart at 2pm in Les Estables."
    ],
    "it": [
      "Il Trail du Mézenc è un evento sportivo adatto alle famiglie che ha lo scopo di sensibilizzare l'opinione pubblica sul cancro infantile. Tutti i proventi sono destinati a questa causa.\r\nInizio alle 14:00 a Les Estables."
    ],
    "fr": [
      "Le trail du Mézenc est une manifestation sportive et familiale sensibilisant les participants aux cancers de l'enfant. Tous les bénéfices y sont consacrés.\r\nRDV dès 14h aux Estables."
    ],
    "es": [
      "El Trail du Mézenc es un acontecimiento deportivo familiar destinado a sensibilizar sobre el cáncer infantil. Todos los beneficios se destinan a esta causa.\r\nSalida a las 14:00 en Les Estables."
    ],
    "nl": [
      "De Trail du Mézenc is een gezinsvriendelijk sportevenement om aandacht te vragen voor kinderkanker. Alle opbrengsten gaan naar dit goede doel.\r\nStart om 14.00 uur in Les Estables."
    ]
  },
