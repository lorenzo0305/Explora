  "rdfs:comment": {
    "de": [
      "Altitude Biathlon ist eine Biathlonschule, die das ganze Jahr über im Vercors für alle offen ist. Spielerische Herausforderungen und halbtägige Einführungen in das Pelletschießen auf 10m oder personalisierte Kurse mit dem 22LR-Gewehr und 50m-Schießen wie im Fernsehen."
    ],
    "en": [
      "Altitude Biathlon is a biathlon school open to all, all year round in the Vercors. Fun challenges and half-day introductions to pellets at 10m or personalised lessons with a 22 long rifle and 50m shooting as seen on TV"
    ],
    "it": [
      "Altitude Biathlon è una scuola di biathlon aperta a tutti, tutto l'anno, nel Vercors. Sfide divertenti e accessibili, corsi introduttivi di mezza giornata di tiro a 10m con pallini o corsi personalizzati di tiro a 22LR e 50m, come in TV!"
    ],
    "fr": [
      "Altitude Biathlon est une école de biathlon ouverte à tous, toute l'année dans le Vercors. Des challenges ludiques, accessible, des initiations demi-journée tir à 10m à plomb ou des stages personnalisés à la carabine 22LR et tir à 50m comme à la télé !"
    ],
    "nl": [
      "Altitude Biathlon is een biatlonschool die het hele jaar door voor iedereen toegankelijk is in de Vercors. Leuke, toegankelijke uitdagingen, kennismakingscursussen van een halve dag in 10m luchtkogel schieten of gepersonaliseerde cursussen in 22LR geweer en 50m schieten, net als op TV!"
    ],
    "es": [
      "Altitude Biathlon es una escuela de biatlón abierta a todos, todo el año en el Vercors. Desafíos lúdicos y accesibles, cursillos de iniciación de media jornada al tiro con perdigones a 10 m o cursillos personalizados de rifle 22LR y tiro a 50 m, ¡como en la tele!"
    ]
  },
