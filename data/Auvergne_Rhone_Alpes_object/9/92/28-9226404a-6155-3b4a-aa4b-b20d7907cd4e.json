      "rdfs:comment": {
        "de": [
          "SAS Les Compagnons du Légume - MARAICHER BIO\nVerkauf von Saisongemüse direkt vom Erzeuger an den Verbraucher in unserem Verkaufsautomaten 7 Tage die Woche rund um die Uhr - Hier finden Sie auch die guten Produkte des GAEC de la Chapelle Saint Jean, und des Bauernhofs Houet."
        ],
        "en": [
          "SAS Les Compagnons du Légume - ORGANIC MARAICHER\nSales of seasonal vegetables direct from producer to consumer, in our vending machine 7 days a week, 24 hours a day - You'll also find great products from the GAEC de la Chapelle Saint Jean, and the Houet farm."
        ],
        "it": [
          "SAS Les Compagnons du Légume - MARAICER BIOLOGICO\nVendita di verdure di stagione direttamente dal produttore al consumatore, nel nostro distributore automatico 7 giorni su 7, 24 ore su 24 - Troverete anche ottimi prodotti del GAEC de la Chapelle Saint Jean e della fattoria Houet."
        ],
        "fr": [
          "SAS Les Compagnons du Légume - MARAICHER BIO\nVentes de légumes de saison en direct du producteur au consommateur, dans notre distributeur automatique 7j/7 24h/24 - Vous y trouverez également les bons produits du GAEC de la Chapelle Saint Jean, et de la ferme Houet."
        ],
        "nl": [
          "SAS Les Compagnons du Légume - ORGANISCHE MARAIKER\nVerkoop van seizoensgroenten rechtstreeks van de producent aan de consument, in onze verkoopautomaat 7 dagen per week, 24 uur per dag - U vindt er ook goede producten van de GAEC de la Chapelle Saint Jean, en de boerderij van Houet."
        ],
        "es": [
          "SAS Les Compagnons du Légume - MARAICER BIO\nVenta de verduras de temporada directamente del productor al consumidor, en nuestra máquina expendedora 7 días a la semana, 24 horas al día - También encontrará buenos productos del GAEC de la Chapelle Saint Jean, y de la granja Houet."
        ]
      },
