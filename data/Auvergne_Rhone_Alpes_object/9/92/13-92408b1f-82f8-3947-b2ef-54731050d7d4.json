  "rdfs:comment": {
    "de": [
      "Dieses echte \"Bouchon\" bietet Ihnen eine Küche in reiner Tradition an. Das Team steht Ihnen zur Verfügung, um Sie bei der Wahl Ihrer Gerichte und Beilagen zu leiten."
    ],
    "en": [
      "This authentic bouchon proposes delicious traditional cuisine. The team is on hand to help and advise you in your choice of dishes and accompaniments."
    ],
    "it": [
      "Questo bouchon autentico ti propone una cucina nel solco della più pura tradizione. Lo staff è al tuo servizio per orientarti nella scelta dei piatti e dei contorni."
    ],
    "fr": [
      "Ce véritable bouchon vous propose une cuisine dans la pure tradition. L’équipe est à votre service pour vous aiguiller dans le choix de vos plats et de leurs accompagnements."
    ],
    "es": [
      "Este verdadero “bouchon” propone una cocina puramente tradicional. El equipo está al servicio de los clientes para aconsejarles en la elección de los platos y acompañamientos."
    ],
    "nl": [
      "Deze echte \"bouchon\" biedt u een traditionele keuken. Het team staat voor u klaar om u te helpen bij de keuze van uw gerechten en hun bijgerechten."
    ]
  },
