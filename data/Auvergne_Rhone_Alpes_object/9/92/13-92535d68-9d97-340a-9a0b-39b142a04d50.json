  "rdfs:comment": {
    "de": [
      "Snack / Bar angrenzend an das Feriendorf APAS-BTP du Col de Voza. Schnellrestaurant inmitten der Skipisten. Gegenüber dem Mont-Blanc-Massiv und 50m vom TMB entfernt: großer beheizter Saal und Terrasse mit Panoramablick."
    ],
    "en": [
      "This snack bar is part of the APAS-BTP holiday centre in Col de Voza, just 50 metres from the Tramway station. Fast food on the slopes. Large heated dining room and terrace with panoramic views."
    ],
    "it": [
      "Fast food al centro delle piste da sci. Di fronte al massiccio del Monte Bianco e accanto al TMB (50m): grande sala riscaldata e terrazza con sedie a sdraio."
    ],
    "fr": [
      "Snack / Bar attenant au Village vacances APAS-BTP du Col de Voza. Restauration rapide au milieu des pistes de ski. Face au massif du Mont Blanc et à 50m du TMB : grande salle chauffée et terrasse avec vue panoramique."
    ],
    "nl": [
      "Snackbar / Bar grenzend aan het APAS-BTP vakantiedorp op de Col de Voza. Fast food midden op de skipistes. Met uitzicht op het Mont Blanc-massief en op 50m van de TMB: grote verwarmde zaal en terras met panoramisch uitzicht."
    ],
    "es": [
      "Snack bar / Bar adyacente al pueblo de vacaciones APAS-BTP en el Col de Voza. Comida rápida en medio de las pistas de esquí. Frente al macizo del Mont Blanc y a 50 m del TMB: gran sala climatizada y terraza con vista panorámica."
    ]
  },
