  "rdfs:comment": {
    "de": [
      "Das Atelier du Vin bietet hausgemachte Speisen an: jede Woche einen Teller und ein aktuelles Dessert, das zu Wein und Speisen passt. Möglichkeit eines Caterings für Ihre Familien- oder sonstigen Veranstaltungen. Verkostungstipps auf Anfrage."
    ],
    "en": [
      "L'Atelier du Vin offers in-house catering: every week, a plate and a dessert of the moment with a wine pairing. Catering available for family and other events. Tasting advice available on request."
    ],
    "it": [
      "L'Atelier du Vin offre un servizio di catering interno: ogni settimana, un piatto e un dessert del momento da abbinare al cibo e al vino. Possibilità di catering per eventi familiari e altre occasioni. Consulenza per la degustazione su richiesta."
    ],
    "fr": [
      "L'Atelier du Vin propose une restauration maison : chaque semaine, une assiette et un dessert du moment en accord met / vin. Possibilité de traiteur pour vos événements familiaux ou autres. Conseils de dégustation sur demande."
    ],
    "es": [
      "L'Atelier du Vin ofrece catering interno: cada semana, un plato y un postre del momento para maridar la comida y el vino. Catering disponible para eventos familiares y otras ocasiones. Consejos de degustación a petición."
    ],
    "nl": [
      "L'Atelier du Vin biedt catering in huis: elke week een gerecht en een dessert van het moment, passend bij het eten en de wijn. Catering beschikbaar voor familiefeesten en andere gelegenheden. Proefadvies beschikbaar op aanvraag."
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'Atelier du vin, caviste et cave à manger"
    ]
  },
