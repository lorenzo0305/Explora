  "rdfs:comment": {
    "de": [
      "Ehemalige Komturei des Ordens der Ritter des Heiligen Johannes von Jerusalem, der späteren Malteserritter, aus dem 17. Jahrhundert. Gegenüber den Arkaden aus derselben Epoche (denkmalgeschützt)."
    ],
    "en": [
      "Former Commandery of the Order of the knights of St John of Jerusalem, future Knights of Malta in the 17th century. Facing the arcades from the same age (heritage site)."
    ],
    "it": [
      "Ex commenda dell'Ordine dei Cavalieri di San Giovanni di Gerusalemme, poi Cavalieri di Malta, dal XVII secolo. Di fronte alle Arcate dello stesso periodo (elencate)."
    ],
    "fr": [
      "Ancienne Commanderie de l'Ordre des chevaliers de Saint Jean de Jérusalem, futurs Chevaliers de Malte, du 17e siècle. Face aux Arcades de la même époque (classées)."
    ],
    "nl": [
      "Voormalige Commanderij van de Orde van de Ridders van Sint Jan van Jeruzalem, later Ridders van Malta, uit de 17e eeuw. Tegenover de Arcades uit dezelfde periode (vermeld)."
    ],
    "es": [
      "Antigua Comandancia de la Orden de los Caballeros de San Juan de Jerusalén, posteriormente Caballeros de Malta, del siglo XVII. Frente a los Arcades de la misma época (catalogados)."
    ]
  },
