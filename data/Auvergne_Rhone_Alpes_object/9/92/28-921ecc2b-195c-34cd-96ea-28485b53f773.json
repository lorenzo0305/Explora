  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/e7a8dd23-8f20-32a7-8fd1-cadee369a0a8",
      "dc:description": {
        "de": [
          "Ein Outdoor-Escape-Game zur Entdeckung der Somme-Bucht und von Saint-Valery-sur-Somme. Sie bündeln Ihre Fähigkeiten und Ihr Denken, um auf einem reizvollen Parcours Rätsel zu lösen. Für die ganze Familie."
        ],
        "en": [
          "An outdoor escape game to discover the Baie de Somme and Saint-Valery-sur-Somme. You combine your skills and thoughts to solve enigmas along a charming course. For the whole family."
        ],
        "it": [
          "Un gioco di fuga all'aperto per scoprire la Baie de Somme e Saint-Valery-sur-Somme. Combinate le vostre abilità e i vostri pensieri per risolvere gli enigmi lungo un percorso affascinante. Per tutta la famiglia."
        ],
        "fr": [
          "Un escape game outdoor à la découverte de la Baie de Somme et de Saint-Valery-sur-Somme. Vous regroupez vos compétences et vos réflexions pour résoudre des énigmes tout au long d'un charmant parcours. Pour toute la famille."
        ],
        "es": [
          "Un juego de escape al aire libre para descubrir la Bahía de Somme y Saint-Valery-sur-Somme. Combine sus habilidades y pensamientos para resolver enigmas a lo largo de un encantador sendero. Para toda la familia."
        ],
        "nl": [
          "Een outdoor ontsnappingsspel om de Baie de Somme en Saint-Valery-sur-Somme te ontdekken. Combineer je vaardigheden en gedachten om raadsels op te lossen langs een charmant parcours. Voor het hele gezin."
        ]
      },
