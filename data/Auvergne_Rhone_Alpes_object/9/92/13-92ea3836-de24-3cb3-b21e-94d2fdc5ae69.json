  "rdfs:comment": {
    "de": [
      "Freizeitkomplex, der zwischen dem Dorf und dem Campingplatz zusammengefasst ist. Verbringen Sie schöne Momente mit der Familie und üben Sie Aktivitäten aus, bei denen Sie sich austoben können. Viele Beschäftigungen sind frei zugänglich, sodass Groß und Klein auf ihre Kosten kommen!"
    ],
    "en": [
      "Leisure complex grouped between the village and the campsite. Spend beautiful moments with your family and practice activities to have fun. Lots of open-access occupations, enough to satisfy young and old!"
    ],
    "it": [
      "Complesso ricreativo tra il villaggio e il campeggio. Trascorrere del tempo di qualità con la famiglia e praticare attività per divertirsi. Tante attività gratuite, per tutte le età!"
    ],
    "fr": [
      "Complexe de loisirs regroupés entre le village et le camping. Passez de beaux moments en famille et pratiquez des activités pour vous éclater. Plein d'occupations en libre accès, de quoi satisfaire petits et grands !"
    ],
    "nl": [
      "Recreatiecomplex gegroepeerd tussen het dorp en de camping. Breng mooie momenten door met uw gezin en oefen activiteiten om plezier te hebben. Veel vrije beroepen, genoeg om jong en oud tevreden te stellen!"
    ],
    "es": [
      "Complejo de ocio entre el pueblo y el camping. Pase tiempo de calidad con su familia y disfrute de actividades para divertirse. Muchas actividades gratuitas, algo para todas las edades"
    ]
  },
  "rdfs:label": {
    "en": [
      "Leisure park of la Buidonnière"
    ],
    "fr": [
      "Base de loisirs de la Buidonnière"
    ],
    "nl": [
      "Recreatiegebied van La Buidonnière"
    ]
  },
