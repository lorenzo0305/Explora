  "rdfs:comment": {
    "de": [
      "In einem modernen, zeitgemäßen und gemütlichen Ambiente steht Ihnen das ganze Team zu Diensten, um Ihnen eine Küche mit frischen Zutaten und regionalen Spezialitäten zu servieren."
    ],
    "en": [
      "In a friendly, contemporary setting, our team will be delighted to have you taste our dishes made from fresh produce and regional specialities."
    ],
    "it": [
      "In un ambiente moderno, contemporaneo e accogliente, l'intero team della Conciergerie è al vostro servizio per offrirvi la sua cucina a base di prodotti freschi e specialità regionali."
    ],
    "fr": [
      "Dans un cadre moderne, contemporain et chaleureux, toute l'équipe de la Conciergerie est à votre service pour vous faire déguster sa cuisine de produits frais et de spécialités régionales."
    ],
    "nl": [
      "In een modern, eigentijds en warm kader staat het hele team van de Conciergerie klaar om u zijn keuken van verse producten en regionale specialiteiten aan te bieden."
    ],
    "es": [
      "En un ambiente moderno, contemporáneo y cálido, todo el equipo de la Conciergerie está a su servicio para ofrecerle su cocina de productos frescos y especialidades regionales."
    ]
  },
