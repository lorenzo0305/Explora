  "rdfs:comment": {
    "de": [
      "Das Restaurant La Ferme de Reberty ist täglich geöffnet, mittags und abends. Apres-Ski, Solarium, Musik und Cocktails. Zugang zum Skigebiet über die Piste Les Boyes, zu Fuß und mit dem Auto. Traditionelle Küche, Spezialitäten aus Savoyen und den Bergen in neuem Gewand."
    ],
    "en": [
      "La Ferme de Reberty restaurant is open daily for lunch and dinner. Apres-Ski, solarium Music and cocktails. Ski access via the Boyes piste, pedestrian and road access. Traditional cuisine, Savoyard and mountain specialities revisited."
    ],
    "it": [
      "Il ristorante Ferme de Reberty è aperto tutti i giorni per pranzo e cena. Apres-Ski, solarium Musica e cocktail. Accesso agli sci attraverso la pista Boyes, accesso pedonale e stradale. Cucina tradizionale, specialità savoiarde e di montagna rivisitate"
    ],
    "fr": [
      "Le restaurant La Ferme de Reberty est ouvert tous les jours , midi et soir. Apres-Ski, solarium Musique et cocktails. Accès ski par la piste des Boyes, piétons et routier. Cuisine traditionnelle, spécialités savoyardes et de montagne revisitée"
    ],
    "nl": [
      "Het restaurant Ferme de Reberty is elke dag geopend voor lunch en diner. Apres-Ski, solarium, muziek en cocktails. Skitoegang via de Boyes-piste, toegang voor voetgangers en over de weg. Traditionele keuken, specialiteiten uit de Savoie en uit de bergen."
    ],
    "es": [
      "El restaurante Ferme de Reberty abre todos los días para el almuerzo y la cena. Apres-Ski, solarium Música y cócteles. Acceso a los esquís por la pista de Boyes, acceso peatonal y por carretera. Cocina tradicional, especialidades saboyanas y de montaña revisitadas"
    ]
  },
