  "rdfs:comment": {
    "de": [
      "Der Küchenchef lädt Sie unter der Woche ein, eine traditionelle und authentische Küche zu entdecken, in der die Produkte der Region im Vordergrund stehen. Das Tagesmenü wird jeden Tag neu zusammengestellt."
    ],
    "en": [
      "During the week, the chef invites you to discover traditional, authentic cuisine, featuring local produce. The daily menu is renewed daily."
    ],
    "it": [
      "Durante la settimana, lo chef vi invita a scoprire una cucina tradizionale e autentica con prodotti locali. Il menu giornaliero cambia ogni giorno."
    ],
    "fr": [
      "Le chef vous invite à découvrir, en semaine, une cuisine traditionnelle et authentique, mettant à l'honneur les produits du terroir. Le menu du jour est renouvelé chaque jour."
    ],
    "es": [
      "Durante la semana, el chef le invita a descubrir la cocina tradicional y auténtica con productos locales. El menú diario cambia todos los días."
    ],
    "nl": [
      "Doordeweeks nodigt de chef je uit om de traditionele, authentieke keuken met lokale producten te ontdekken. Het dagmenu verandert dagelijks."
    ]
  },
  "rdfs:label": {
