  "rdfs:comment": {
    "de": [
      "Die Auberge des Aqueducs liegt am Fuße des Aqueduc du Gier und bietet Ihnen ihre Formeln mit einer Struktur an, die für alle Arten von Mahlzeiten geeignet ist (Hochzeiten, Taufen, Geburtstage, Geschäftsessen, Gruppenessen usw.)."
    ],
    "en": [
      "At the foot of the Gier aqueduct, the Auberge des Aqueducs offers menus with a structure adapted to all types of functions (weddings, christenings, birthdays, business meetings, groups, etc.)."
    ],
    "it": [
      "Situato ai piedi dell'Aqueduc du Gier, l'Auberge des Aqueducs vi propone le sue formule con una struttura adatta a tutti i tipi di pasti (matrimoni, battesimi, compleanni, pranzi di lavoro, pranzi di gruppo, ecc.)"
    ],
    "fr": [
      "Située aux pieds de l'Aqueduc du Gier, l'Auberge des Aqueducs vous propose ses formules avec une structure adaptée à toutes sortes de repas (mariages, baptêmes, anniversaires, repas d'affaires, repas de groupes, etc)."
    ],
    "es": [
      "Situado al pie del Aqueduc du Gier, el Auberge des Aqueducs le ofrece sus fórmulas con una estructura adaptada a todo tipo de comidas (bodas, bautizos, cumpleaños, comidas de empresa, comidas de grupo, etc.)."
    ],
    "nl": [
      "Gelegen aan de voet van het Aqueduc du Gier, biedt de Auberge des Aqueducs u haar formules met een structuur aangepast aan alle soorten maaltijden (bruiloften, doopfeesten, verjaardagen, zakendiners, groepsmaaltijden...)."
    ]
  },
