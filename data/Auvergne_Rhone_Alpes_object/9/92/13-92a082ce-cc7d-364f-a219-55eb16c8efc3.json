  "rdfs:comment": {
    "de": [
      "Ein zweistündiger Fotospaziergang, bei dem Sie den Charme der Straßen und Sehenswürdigkeiten von Montluçon einfangen und lernen, wie Sie Ihre Kamera besser nutzen können."
    ],
    "en": [
      "A 2-hour photo tour to capture the charm of the streets and monuments of Montluçon and learn how to better use your camera."
    ],
    "it": [
      "Una passeggiata fotografica di 2 ore per catturare il fascino delle strade e dei monumenti di Montluçon e imparare a usare meglio la macchina fotografica."
    ],
    "fr": [
      "Une balade photo de 2 heures pour capturer le charme des rues et des monuments de Montluçon et apprendre à mieux utiliser votre appareil photo."
    ],
    "es": [
      "Un paseo fotográfico de 2 horas para captar el encanto de las calles y los monumentos de Montluçon y aprender a utilizar mejor su cámara."
    ],
    "nl": [
      "Een fotowandeling van 2 uur om de charme van de straten en monumenten van Montluçon vast te leggen en uw camera beter te leren gebruiken."
    ]
  },
  "rdfs:label": {
