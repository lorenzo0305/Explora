      "dc:description": {
        "de": [
          "Turnier im Beachvolleyball.\nUm 10 Uhr am Strand, Beginn der Spiele um 11 Uhr.\nKostenlos, nur mit Anmeldung.\nInformationen im Familienzentrum"
        ],
        "en": [
          "Beach Volley tournament.\nAt 10am on the beach, matches start at 11am.\nFree, registration required.\nInformation at the Family Center"
        ],
        "it": [
          "Torneo di beach volley.\nAlle 10.00 sulla spiaggia, le partite iniziano alle 11.00.\nGratuito, iscrizione obbligatoria.\nInformazioni presso il Centro per le famiglie"
        ],
        "fr": [
          "Tournoi de Beach Volley. \nA 10h à la plage, début des matchs à 11H. \nGratuit, sur inscription. \nRenseignements au Pôle famille"
        ],
        "es": [
          "Torneo de voley playa.\nA las 10 h en la playa, los partidos comienzan a las 11 h.\nGratuito, inscripción obligatoria.\nInformación en el Centro Familiar"
        ],
        "nl": [
          "Beachvolleybaltoernooi.\nOm 10 uur op het strand, de wedstrijden beginnen om 11 uur.\nGratis, inschrijven verplicht.\nInformatie bij het Familiecentrum"
        ]
      },
