  "rdfs:comment": {
    "de": [
      "Als Bergbegleiterin mit Yoga-Diplom biete ich im Sommer und Winter in Chamrousse Themenwanderungen rund um die Natur, Kunst und Wellness an."
    ],
    "en": [
      "A mountain guide with a yoga diploma, I offer themed walks around nature, art and well-being in summer and winter in Chamrousse."
    ],
    "it": [
      "Guida alpina e istruttrice di yoga, propongo passeggiate tematiche a Chamrousse in estate e in inverno, incentrate sulla natura, l'arte e il benessere."
    ],
    "fr": [
      "Accompagnatrice en montagne, diplômée de Yoga, je propose des balades à thèmes autour de la nature, de l’art et du bien-être en été et en hiver à Chamrousse."
    ],
    "es": [
      "Guiadora de montaña titulada e instructora de yoga, propongo paseos temáticos en Chamrousse en verano y en invierno, centrados en la naturaleza, el arte y el bienestar."
    ],
    "nl": [
      "Als gediplomeerd bergleider en yoga-instructeur bied ik in de zomer en winter themawandelingen aan in Chamrousse, gericht op natuur, kunst en welzijn."
    ]
  },
