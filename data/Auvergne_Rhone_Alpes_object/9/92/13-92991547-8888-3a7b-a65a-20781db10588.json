  "rdfs:comment": {
    "de": [
      "Historische Überreste in einem Dorf, das als \"Les plus beaux villages de France\" und \"Village Auvergnat de caractère\" klassifiziert ist. Geführte Besichtigungen vom 1. Juli bis 31. August von 12 bis 18 Uhr\r\n (außer Sonntag und Montag)"
    ],
    "en": [
      "Historic remains in a village listed as one of France's most beautiful villages and an Auvergne village of character. Guided tours from July 1 to August 31, from 12 to 6 pm\r\n (except Sunday and Monday)"
    ],
    "it": [
      "Resti storici in un villaggio classificato come uno dei \"Borghi più belli di Francia\" e un \"Villaggio di carattere dell'Alvernia\". Visite guidate dal 1° luglio al 31 agosto, dalle 12.00 alle 18.00\r\n (tranne domenica e lunedì)"
    ],
    "fr": [
      "Vestiges historiques dans un village classé parmi \"Les plus beaux villages de France\" et \"Village Auvergnat de caractère\". Visites guidées du 1er juillet au 31 août de 12h à 18h\r\n (sauf dimanche et lundi)"
    ],
    "es": [
      "Restos históricos en un pueblo catalogado como uno de los \"Pueblos más bonitos de Francia\" y \"Pueblo con carácter de Auvernia\". Visitas guiadas del 1 de julio al 31 de agosto, de 12.00 a 18.00 h\r\n (excepto domingos y lunes)"
    ],
    "nl": [
      "Historische overblijfselen in een dorp dat is geklasseerd als een van de \"Mooiste Dorpen van Frankrijk\" en een \"Karaktervol Dorp in de Auvergne\". Rondleidingen van 1 juli tot 31 augustus, 12 tot 18 uur\r\n (behalve zondag en maandag)"
    ]
  },
