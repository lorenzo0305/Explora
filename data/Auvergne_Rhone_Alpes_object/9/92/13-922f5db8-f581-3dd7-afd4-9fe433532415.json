  "rdfs:comment": {
    "de": [
      "Dicke Vorhänge, einladend geschwungene Sessel, gedämpftes Licht: Die Bar erscheint wie eine gemalte Kulisse. Ein Raum, der im Rhythmus des Tages lebt, zwischen gedämpfter Sanftheit und lebhaften Abenden."
    ],
    "en": [
      "Thick curtains, invitingly curved armchairs, soft lighting: the bar looks like something out of a movie set. A space that moves to the rhythm of the day, between hushed tranquility and lively evenings."
    ],
    "it": [
      "Tende pesanti, poltrone dalle curve accoglienti, luci soffuse: il bar sembra un set cinematografico. Uno spazio che vive al ritmo della giornata, tra atmosfera ovattata e serate animate."
    ],
    "fr": [
      "Des rideaux épais, des fauteuils aux courbes accueillantes, une lumière tamisée : le bar apparaît comme un décor peint. Un espace qui vit au rythme de la journée, entre douceur feutrée et soirées animées."
    ],
    "nl": [
      "Dikke gordijnen, uitnodigend gebogen fauteuils en gedempte verlichting: de bar ziet eruit als een geschilderd decor. Het is een ruimte die leeft op het ritme van de dag, van gedempte zachtheid tot levendige avonden."
    ],
    "es": [
      "Cortinas gruesas, sillones de curvas acogedoras e iluminación tenue: el bar parece un decorado pintado. Es un espacio que vive al ritmo del día, de la suavidad apagada a las noches animadas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le piano bar du Saint Georges"
    ]
  },
