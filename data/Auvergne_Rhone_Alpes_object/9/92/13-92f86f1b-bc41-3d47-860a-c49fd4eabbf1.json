  "rdfs:comment": {
    "de": [
      "Restaurant im Stadtzentrum, das einen angenehmen Rahmen mit einem Speisesaal aus Naturstein und einem Brunnen bietet. Eine raffinierte Küche wird Ihnen für einen garantierten Tapetenwechsel angeboten."
    ],
    "en": [
      "Restaurant in the city center offering a pleasant atmosphere and a dining room with exposed stones and a fountain. Refined cuisine is offered guaranteeing  a change of scenery."
    ],
    "it": [
      "Ristorante nel centro della città che offre un ambiente piacevole con una sala da pranzo in pietra a vista e una fontana. Una cucina raffinata viene offerta per un cambio di scenario."
    ],
    "fr": [
      "Restaurant en plein centre ville offrant un cadre agréable avec une salle de restauration en pierres apparentes et une fontaine. Une cuisine raffinée vous est proposée pour un dépaysement assuré."
    ],
    "es": [
      "Restaurante en el centro de la ciudad que ofrece un entorno agradable con un comedor de piedra vista y una fuente. Para cambiar de aires, se ofrece una cocina refinada."
    ],
    "nl": [
      "Restaurant in het centrum van de stad dat een aangename omgeving biedt met een eetzaal in zichtbare stenen en een fontein. Voor de afwisseling wordt een verfijnde keuken aangeboden."
    ]
  },
