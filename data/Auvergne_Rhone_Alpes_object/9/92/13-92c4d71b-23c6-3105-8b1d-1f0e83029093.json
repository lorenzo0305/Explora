  "rdfs:comment": {
    "de": [
      "Familiäre und herzliche Atmosphäre. Renovierte, helle und sonnige Zimmer. Traditionelle und ausgewogene Küche.\r\nHotel-Restaurant**, das den Valvital-Thermen am nächsten liegt."
    ],
    "en": [
      "Warm, family atmosphere. Traditional and balanced cuisine. Bright and sunny rooms. \r\nClosest hotel-restaurant** to the thermal baths."
    ],
    "it": [
      "Atmosfera familiare e calorosa. Cucina tradizionale ed equilibrata. Camere e luminose e soleggiate.\r\nHotel ristorante** vicino alle Terme."
    ],
    "fr": [
      "Ambiance familiale et chaleureuse. Chambres rénovées lumineuses et ensoleillées. Cuisine traditionnelle et équilibrée.\r\nHôtel restaurant** le plus proche des Thermes Valvital."
    ],
    "nl": [
      "Warme, familiale sfeer. Lichte, zonnige gerenoveerde kamers. Traditionele, uitgebalanceerde keuken.\r\nHet dichtstbijzijnde hotelrestaurant** bij de thermale baden van Valvital."
    ],
    "es": [
      "Ambiente cálido y familiar. Habitaciones renovadas, luminosas y soleadas. Cocina tradicional y equilibrada.\r\nEl hotel restaurante** más cercano a las termas de Valvital."
    ]
  },
