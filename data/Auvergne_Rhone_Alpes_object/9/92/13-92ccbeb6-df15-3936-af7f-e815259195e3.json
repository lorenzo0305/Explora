  "rdfs:comment": {
    "de": [
      "Pinocchio ist ein warmes und gemütliches italienisches Restaurant, das köstliche Gourmetküche und Pizza aus dem Holzofen anbietet. Genießen Sie traditionelle Gerichte, die mit frischen Zutaten aus Italien und von lokalen Produzenten zubereitet werden."
    ],
    "en": [
      "Pinocchio is a warm and friendly Italian restaurant, offering delicious gourmet cuisine and wood-fired pizza. Enjoy traditional dishes prepared with fresh ingredients from Italy and local producers."
    ],
    "it": [
      "Pinocchio è un ristorante italiano caldo e accogliente che offre una deliziosa cucina gourmet e una pizza cotta a legna. Gustate i piatti tradizionali preparati con ingredienti freschi provenienti dall'Italia e dai produttori locali."
    ],
    "fr": [
      "Pinocchio est un restaurant italien chaleureux et convivial, offrant une délicieuse cuisine gourmande et pizza au feu de bois. Dégustez des plats traditionnels préparés avec des ingrédients frais en provenance d’Italie et producteurs locaux."
    ],
    "nl": [
      "Pinocchio is een warm en vriendelijk Italiaans restaurant met een heerlijke gastronomische keuken en houtovenpizza. Geniet van traditionele gerechten bereid met verse ingrediënten uit Italië en van lokale producenten."
    ],
    "es": [
      "Pinocchio es un cálido y acogedor restaurante italiano que ofrece deliciosa cocina gourmet y pizza al horno de leña. Disfrute de platos tradicionales preparados con ingredientes frescos de Italia y productores locales."
    ]
  },
