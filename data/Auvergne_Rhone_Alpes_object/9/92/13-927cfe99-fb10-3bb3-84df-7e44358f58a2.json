  "rdfs:comment": {
    "de": [
      "Marie und Loïc besitzen eine Mutterkuhherde der Rasse Aubrac.\r\nSie bieten den Verkauf von Kisten mit Rind- und Kalbfleisch auf Vorbestellung an."
    ],
    "en": [
      "Marie and Loïc own a herd of Aubrac suckler cows.\r\nThey sell boxes of beef and veal by reservation."
    ],
    "it": [
      "Marie e Loïc hanno una mandria di vacche nutrici di razza Aubrac.\r\nVendono box di carne di manzo e di vitello su prenotazione."
    ],
    "fr": [
      "Marie et Loïc possèdent un troupeau de vaches allaitantes de race Aubrac.\r\nIls proposent la vente de caissettes de viande de bœuf et de veau sur réservation."
    ],
    "es": [
      "Marie y Loïc tienen un rebaño de vacas nodrizas Aubrac.\r\nVenden cajas de carne de vacuno previo acuerdo."
    ],
    "nl": [
      "Marie en Loïc hebben een kudde Aubrac zoogkoeien.\r\nZe verkopen dozen rund- en kalfsvlees op afspraak."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Elevage Brutus"
    ]
  },
