  "rdfs:comment": {
    "de": [
      "Die schönsten Canyons rund um Chamonix! Um das Canyoning mit der Familie zu entdecken oder um ein sportliches Abenteuer zu erleben. Stürzen Sie sich diesen Sommer ins Wasser!"
    ],
    "en": [
      "The most beautiful canyons around Chamonix! Discover canyoning with the whole family or enjoy a sporting adventure. Take the plunge this summer!"
    ],
    "it": [
      "I più bei canyon nei dintorni di Chamonix! Scoprite il canyoning in famiglia o vivete un'avventura sportiva. Quest'estate andate in acqua!"
    ],
    "fr": [
      "Les plus beaux canyons autour de Chamonix ! Pour découvrir le canyoning en famille ou pour vivre une aventure sportive. Cet été, jetez-vous à l'eau !"
    ],
    "es": [
      "¡Los cañones más bellos de los alrededores de Chamonix! Descubra el barranquismo en familia o disfrute de una aventura deportiva. Este verano, ¡al agua!"
    ],
    "nl": [
      "De mooiste canyons rond Chamonix! Ontdek canyoning met het hele gezin of geniet van een sportief avontuur. Ga deze zomer het water op!"
    ]
  },
