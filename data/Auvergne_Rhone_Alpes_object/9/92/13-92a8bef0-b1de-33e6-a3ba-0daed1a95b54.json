  "rdfs:comment": {
    "de": [
      "Hier finden Sie alle touristischen Informationen über die Combrailles sowie unseren Shop-Bereich.\r\nInformationsrelais zum Parc des Volcans d'Auvergne."
    ],
    "en": [
      "Find all the tourist information on the Combrailles, as well as our shop area.\r\nInformation relay on the Parc des Volcans d'Auvergne."
    ],
    "it": [
      "Ai piedi dei vulcani dell'Alvernia, l'ufficio turistico di Pontgibaud vi accoglie tutto l'anno per farvi scoprire la nostra magnifica regione. Trovate tutte le informazioni turistiche sulle Combrailles e il nostro negozio."
    ],
    "fr": [
      "Au pied des volcans d'Auvergne, le bureau de tourisme de Pontgibaud vous accueille tout au long de l'année pour découvrir notre magnifique région. Retrouvez toutes les informations touristiques sur les Combrailles, ainsi que notre espace boutique."
    ],
    "es": [
      "Al pie de los volcanes de Auvernia, la oficina de turismo de Pontgibaud le da la bienvenida todo el año para descubrir nuestra magnífica región. Encuentre toda la información turística necesaria sobre las Combrailles, así como nuestra tienda."
    ],
    "nl": [
      "Aan de voet van de vulkanen van de Auvergne verwelkomt het toeristenbureau van Pontgibaud u het hele jaar door om onze prachtige streek te ontdekken. Hier vindt u alle toeristische informatie over de Combrailles en onze winkel."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Bureau de Tourisme Combrailles Auvergne à Pontgibaud"
    ]
  },
