  "rdfs:comment": {
    "de": [
      "Bei Good Time entdecken Sie die Welt der Burger und Pommes frites. Der Chefkoch bietet Ihnen die besten Geschmacksrichtungen, die aus frischen und lokalen Produkten ausgewählt werden.\r\nAber auch gegrilltes Fleisch, Hotdogs, frische Salate, Fondue, Aperitifbretter und Desserts."
    ],
    "en": [
      "At Good Time you'll discover the world of Burgers and Fries. The chef offers you the best flavors selected from fresh, local produce.\r\nBut also grilled meats, hot dogs, fresh salads, fondues, aperitif platters and desserts."
    ],
    "it": [
      "Al Good Time scoprirete il mondo degli hamburger e delle patatine fritte. Lo chef vi offre i migliori sapori selezionati da prodotti freschi e locali.\r\nMa anche carni alla griglia, hot dog, insalate fresche, fondute, aperitivi e dessert."
    ],
    "fr": [
      "Chez Good Time vous découvrirez le monde des Burgers et Frites. Le chef vous propose les meilleures saveurs sélectionnées avec des produits frais et locaux. \r\nMais aussi viandes grillées, hot-dogs, salades fraîcheurs, fondue, planches apéro et desserts."
    ],
    "es": [
      "En Good Time descubrirá el mundo de las hamburguesas y las patatas fritas. El chef le ofrece los mejores sabores seleccionados a partir de productos frescos y locales.\r\nPero también carnes a la parrilla, perritos calientes, ensaladas frescas, fondues, platos de aperitivo y postres."
    ],
    "nl": [
      "Bij Good Time ontdek je de wereld van Burgers en Friet. De chef biedt je de beste smaken geselecteerd uit verse, lokale producten.\r\nMaar ook gegrild vlees, hotdogs, verse salades, fondues, aperitiefschotels en desserts."
    ]
  },
  "rdfs:label": {
