  "rdfs:comment": {
    "de": [
      "Nehmen Sie an einem geselligen Lunch mit Tanz teil, der Gastronomie und Musik miteinander verbindet. Ein festlicher und herzlicher Moment, um eine Gourmet-Mahlzeit zu genießen, zu tanzen und von einem Live-Orchester unterhalten zu werden."
    ],
    "en": [
      "Join us for a convivial lunch-dance combining gastronomy and music. A warm and festive moment to share a gourmet meal, dance and enjoy the lively atmosphere provided by a live orchestra."
    ],
    "it": [
      "Unitevi a noi per un pranzo conviviale che unisce cibo e musica. Un'occasione calda e festosa per condividere un pasto gourmet, ballare e godere dell'atmosfera vivace offerta da un'orchestra dal vivo."
    ],
    "fr": [
      "Participez à un déjeuner dansant convivial mêlant gastronomie et musique. Un moment festif et chaleureux pour partager un repas gourmand, danser et profiter d’une ambiance animée portée par un orchestre en live."
    ],
    "es": [
      "Únase a nosotros para un baile de convivencia a la hora del almuerzo que combina comida y música. Una ocasión cálida y festiva para compartir una comida gourmet, bailar y disfrutar del animado ambiente que ofrece una orquesta en directo."
    ],
    "nl": [
      "Doe mee aan een gezellige lunchdans waarbij eten en muziek worden gecombineerd. Een warme en feestelijke gelegenheid om een gastronomische maaltijd te delen, te dansen en te genieten van de levendige sfeer van een live orkest."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Déjeuner dansant"
    ]
  },
