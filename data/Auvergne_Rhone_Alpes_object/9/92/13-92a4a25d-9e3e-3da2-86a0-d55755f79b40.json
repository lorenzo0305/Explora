  "rdfs:comment": {
    "de": [
      "Burg aus dem 15. bis 15. Jahrhundert, die Ende des 17. Jahrhunderts in eine Residenz umgewandelt und restauriert wurde. Jahrhundert umgebaut. Zu entdecken gibt es neben der Geschichte des Ortes auch die Küche, die Bäckerei, die Adelsetage und andere Räume, die je nach Besetzung genutzt wurden, sowie den Park, den Eiskeller und den Teich."
    ],
    "en": [
      "Fortified castle from the 15th-15th century, transformed into a residence from the end of the 17th century, restored. To discover, in addition to the history of the place: kitchens, bakery, the noble floor and other rooms depending on the occupation, ending with the park, the ice house and the pond."
    ],
    "it": [
      "Castello fortificato restaurato del XV secolo, trasformato in residenza alla fine del XVII secolo. Oltre alla storia del sito, sono presenti le cucine, il forno, il piano nobile e altre stanze a seconda dell'occupazione, il parco, la ghiacciaia e lo stagno."
    ],
    "fr": [
      "Château fort du XV-XVième siècle, transformé en résidence dès la fin XVIIème, restauré. A découvrir, outre l'histoire des lieux: cuisines, boulangerie, l'étage noble et autres pièces suivant l'occupation, en terminant par le parc, la glacière et l'étang."
    ],
    "nl": [
      "Gerestaureerd 15e-eeuws versterkt kasteel, eind 17e eeuw omgebouwd tot woonhuis. Naast de geschiedenis van de locatie zijn er keukens, een bakkerij, de hoofdverdieping en andere kamers afhankelijk van de bezetting, en het park, het ijshuis en de vijver."
    ],
    "es": [
      "Castillo fortificado del siglo XV restaurado, convertido en residencia a finales del siglo XVII. Además de la historia del lugar, se conservan cocinas, una panadería, el piso principal y otras estancias según la ocupación, así como el parque, la casa de hielo y el estanque."
    ]
  },
  "rdfs:label": {
    "fr": [
