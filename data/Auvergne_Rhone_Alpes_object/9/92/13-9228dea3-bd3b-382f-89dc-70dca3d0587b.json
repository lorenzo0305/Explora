  "rdfs:comment": {
    "de": [
      "Im Dekor einer Almhütte, einer typisch warmen Bergatmosphäre mit einem Erkerfenster mit Blick auf die atemberaubenden Gipfel."
    ],
    "en": [
      "Decorated like an alpine chalet with the welcoming atmosphere of traditional mountain restaurants and a bay window offering a breathtaking view of the mountain peaks."
    ],
    "it": [
      "In un ambiente da chalet alpino, un'atmosfera tipicamente montana con un bovindo che si affaccia sulle cime mozzafiato."
    ],
    "fr": [
      "Dans un décor de chalet d'alpage, une ambiance typiquement montagne chaleureuse avec une baie vitrée donnant vue sur les cimes imprenables."
    ],
    "nl": [
      "In een bergchalet, een typisch warme bergsfeer met een erker die uitkijkt op de adembenemende bergtoppen."
    ],
    "es": [
      "En un entorno de chalet alpino, un ambiente típicamente montañés con un mirador con vistas a las impresionantes cumbres."
    ]
  },
