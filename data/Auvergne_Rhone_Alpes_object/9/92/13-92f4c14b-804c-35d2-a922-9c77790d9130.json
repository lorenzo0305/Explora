  "rdfs:comment": {
    "de": [
      "Die Alpakas und Lamas auf der Farm produzieren hochwertige Wolle, die vor Ort gesponnen und im Werkstattladen verkauft wird."
    ],
    "en": [
      "The farm's alpacas and llamas produce high-quality wool, which is spun on site and sold in the workshop store."
    ],
    "it": [
      "Gli alpaca e i lama della fattoria producono lana di alta qualità, che viene filata in loco e venduta nel negozio del laboratorio."
    ],
    "fr": [
      "Les alpagas et les lamas de l'élevage produisent une laine de haute qualité, filée sur place et vendue dans le magasin d'atelier."
    ],
    "es": [
      "Las alpacas y llamas de la granja producen lana de alta calidad, que se hila in situ y se vende en la tienda del taller."
    ],
    "nl": [
      "De alpaca's en lama's van de boerderij produceren wol van hoge kwaliteit, die ter plekke wordt gesponnen en verkocht in de werkplaatswinkel."
    ]
  },
