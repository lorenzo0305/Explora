  "rdfs:comment": {
    "de": [
      "Zwischen den Seen von Annecy und Aix-les-Bains gelegen.\r\nKostenloses WLAN, Canal+, Bein Sport, National Geographie.\r\n2 Seminarräume mit Video- und Audiomaterial ausgestattet.\r\nRegionale und traditionelle Küche."
    ],
    "en": [
      "Located between the lakes of Annecy and Aix-les-Bains. \r\n38 Air-conditioned rooms with bathroom, WC & télévision.\r\nFree WiFI, Canal+, Bein Sport and National Geographic.\r\n2 seminar rooms fitted with video and audio equipment.\r\nLocal and traditional cuisine."
    ],
    "it": [
      "Situato tra il lago di Annecy e il lago di Aix-les-Bains.\r\nWiFi gratuito, Canal+, Bein Sport, National Géographie.\r\n2 sale per seminari dotate di attrezzature video e audio.\r\nCucina locale e tradizionale."
    ],
    "fr": [
      "Situé entre les lacs d'Annecy et d'Aix-les-Bains. \r\nWifi gratuit, Canal+, Bein Sport, National Géographie.\r\n2 salles séminaires équipées en matériel vidéo et audio.\r\nCuisine du terroir et traditionnelle."
    ],
    "es": [
      "Situado entre el lago de Annecy y el lago de Aix-les-Bains.\r\nWiFi gratuito, Canal+, Bein Sport, National Géographie.\r\n2 salas de seminarios equipadas con material de vídeo y audio.\r\nCocina local y tradicional."
    ],
    "nl": [
      "Gelegen tussen het meer van Annecy en het meer van Aix-les-Bains.\r\nGratis WiFi, Canal+, Bein Sport, National Géographie.\r\n2 seminariezalen uitgerust met video- en audioapparatuur.\r\nLokale en traditionele keuken."
    ]
  },
