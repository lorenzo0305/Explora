  "rdfs:comment": {
    "de": [
      "Ein verspielter Minigolfplatz mit 17 Bahnen im Vallée Bleue, ideal für einen geselligen Moment mit Familie oder Freunden. Für alle zugänglich, Material wird vor Ort bereitgestellt."
    ],
    "en": [
      "A mini-golf course of 17 playful tracks in the Blue Valley, ideal for a friendly moment with family or friends. Accessible to all, equipment provided on site."
    ],
    "it": [
      "Un campo da minigolf a 17 corsie a Vallée Bleue, ideale per una giornata all'insegna del divertimento con la famiglia e gli amici. Accessibile a tutti, attrezzatura fornita in loco."
    ],
    "fr": [
      "Un parcours de mini-golf de 17 pistes ludique à la Vallée Bleue, idéal pour un moment convivial en famille ou entre amis. Accessible à tous, matériel fourni sur place."
    ],
    "es": [
      "Un minigolf de 17 pistas en Vallée Bleue, ideal para pasar un día divertido en familia o con amigos. Accesible para todos, el equipo se proporciona in situ."
    ],
    "nl": [
      "Midgetgolfbaan met 17 banen in Vallée Bleue, ideaal voor een gezellig dagje uit met familie en vrienden. Toegankelijk voor iedereen, materiaal ter plaatse aanwezig."
    ]
  },
