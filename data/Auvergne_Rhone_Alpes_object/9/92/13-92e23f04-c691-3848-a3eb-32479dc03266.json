  "rdfs:comment": {
    "de": [
      "Seit 2021 bietet Ihnen die Station Super-Besse ein Escape Game in den Kabinen der Perdrix-Seilbahn an. Sie haben 45 Minuten Zeit, um die Zerstörung der Station durch einen Lavastrom zu verhindern: Jetzt sind Sie dran!"
    ],
    "en": [
      "NEW in 2021: the Super-Besse resort offers you an escape game in the cabins of the Perdrix cable car. Your turn to play! You have 45 minutes to avoid the destruction of the station by a lava flow."
    ],
    "it": [
      "Dal 2021, il resort Super-Besse propone un gioco di fuga nelle cabine della funivia Perdrix. Avete 45 minuti per evitare la distruzione del resort a causa di una colata lavica: sta a voi!"
    ],
    "fr": [
      "Depuis 2021, la station de Super-Besse vous propose un escape game dans les cabines du téléphérique de la Perdrix. Vous avez 45 min pour éviter la destruction de la station par une coulée de lave : à vous de jouer !"
    ],
    "nl": [
      "Sinds 2021 biedt het resort Super-Besse een ontsnappingsspel aan in de cabines van de Perdrix-kabelbaan. Je hebt 45 minuten om de vernietiging van het resort door een lavastroom te voorkomen: aan jou de keuze!"
    ],
    "es": [
      "Desde 2021, la estación de Super-Besse ofrece un juego de escape en las cabinas del teleférico de Perdrix. Tienes 45 minutos para evitar la destrucción de la estación por una colada de lava: ¡depende de ti!"
    ]
  },
  "rdfs:label": {
