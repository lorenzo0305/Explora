      "@id": "https://data.datatourisme.fr/79bf6383-fbb7-3874-8c6b-5f405754abc8",
      "dc:description": {
        "de": [
          "Kaffeerösterei und Vertrieb der Tees Dammann/Mariages Frères und Kusmi\n\nMittwoch bis Samstag von 10:00 bis 13:30 Uhr und von 15:00 bis 19:00 Uhr.\nSonntags von 10:00 bis 14:00 Uhr."
        ],
        "en": [
          "Roaster and distributor of Dammann/Mariages Frères and Kusmi teas\n\nWednesday to Saturday, 10am to 1:30pm and 3pm to 7pm.\nSunday from 10am to 2pm."
        ],
        "it": [
          "Torrefazione e distribuzione di tè Dammann/Mariages Frères e Kusmi\n\nDa mercoledì a sabato, dalle 10.00 alle 13.30 e dalle 15.00 alle 19.00.\nDomenica dalle 10.00 alle 14.00."
        ],
        "fr": [
          "Torréfacteur et Distributeur des Thés Dammann/Mariages Frères et Kusmi \n\nDu mercredi au samedi de 10h à 13h30 et de 15h à 19h.\nLe dimanche de 10h à 14h."
        ],
        "es": [
          "Tostador y distribuidor de tés Dammann/Mariages Frères y Kusmi\n\nDe miércoles a sábado, de 10.00 a 13.30 h. y de 15.00 a 19.00 h.\nDomingo de 10.00 a 14.00 h."
        ],
        "nl": [
          "Brander en distributeur van Dammann/Mariages Frères en Kusmi theeën\n\nWoensdag tot zaterdag van 10 tot 13.30 en van 15 tot 19 uur.\nZondag van 10 tot 14 uur."
        ]
      },
