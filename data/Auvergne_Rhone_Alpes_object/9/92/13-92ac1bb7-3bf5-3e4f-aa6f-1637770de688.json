  "rdfs:comment": {
    "de": [
      "Die 200 m2 große Eisbahn befindet sich im Herzen des Dorfes und wird Groß und Klein begeistern."
    ],
    "en": [
      "The ice rink, with a surface area of 200m2, is located in the heart of the village and will delight young and old alike."
    ],
    "it": [
      "La pista di ghiaccio di 200 m2 si trova nel cuore del villaggio e farà la gioia di grandi e piccini."
    ],
    "fr": [
      "La patinoire de glace, d'une superficie de 200m2, se situe en plein cœur du village et fera le bonheur des petits comme des grands."
    ],
    "es": [
      "La pista de hielo de 200 m2 está situada en el corazón del pueblo y hará las delicias de grandes y pequeños."
    ],
    "nl": [
      "Deze schaatsbaan, met een oppervlakte van 200m2, bevindt zich midden in centrum van het dorp en zorgt voor plezier voor klein en groot."
    ]
