          "@type": [
            "schema:OpeningHoursSpecification"
          ],
          "additionalInformation": {
            "de": [
              "Restaurant mittwochs geschlossen .\r\nMontag, Freitag, Samstag und Sonntag von 12:00 bis 14:00 Uhr und von 19:00 bis 21:00 Uhr (letzte Bestellungen) geöffnet.\r\nFür die Ruhe der Nutzer ist der Zugang zum Hotel nach Mitternacht nicht mehr möglich. Letzter Check-in um 20 Uhr."
            ],
            "en": [
              "Restaurant closed on Wednesdays.\r\nOpen Monday, Friday, Saturday and Sunday from 12pm to 2pm and from 7pm to 9pm (last orders).\r\nFor the peace of mind of our guests, access to the hotel after midnight is no longer possible. Last check-in at 8pm."
            ],
            "it": [
              "Ristorante chiuso il mercoledì.\r\nAperto lunedì, venerdì, sabato e domenica dalle 12:00 alle 14:00 e dalle 19:00 alle 21:00 (ultime ordinazioni).\r\nPer la tranquillità dei nostri ospiti, non è più possibile accedere all'hotel dopo la mezzanotte. Ultimo check-in alle 20:00."
            ],
            "fr": [
              "Restaurant fermé le mercredi .\r\nOuvert lundi, vendredi, samedi et dimanche de 12h à 14h et de 19h à 21h (dernières commandes).\r\nPour la sérénité des usagers, l'accès à l'hôtel après minuit n'est plus possible. Dernier enregistrement à 20h."
            ],
            "nl": [
              "Restaurant gesloten op woensdag.\r\nGeopend op maandag, vrijdag, zaterdag en zondag van 12.00 tot 14.00 uur en van 19.00 tot 21.00 uur (laatste bestellingen).\r\nVoor de gemoedsrust van onze gasten is toegang tot het hotel na middernacht niet meer mogelijk. Laatste check-in om 20.00 uur."
            ],
            "es": [
              "El restaurante cierra los miércoles.\r\nAbierto lunes, viernes, sábado y domingo de 12h a 14h y de 19h a 21h (últimos pedidos).\r\nPara tranquilidad de nuestros huéspedes, ya no es posible acceder al hotel después de medianoche. Último registro a las 20 h."
            ]
          },
