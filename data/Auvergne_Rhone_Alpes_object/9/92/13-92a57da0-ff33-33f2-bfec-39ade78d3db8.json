  "rdfs:comment": {
    "de": [
      "Entdecken Sie den Beruf des Landwirts und besuchen Sie einen Bauernhof in voller Aktivität: Pflegen und streicheln Sie die Tiere (Esel, Ziegen, Kaninchen, Hühner). Füttern Sie die Kälber mit der Flasche und helfen Sie beim Melken der Kühe!"
    ],
    "en": [
      "Explore the job of a farmer and visit a working farm: look after and pet the animals (donkeys, goats, rabbits, chickens). Bottle-feed the calves and help milk the cows!"
    ],
    "it": [
      "Scoprite il mestiere dell'agricoltore e visitate una fattoria in attività: accudite e accarezzate gli animali (asini, capre, conigli, galline). Date il biberon ai vitelli e aiutate a mungere le mucche!"
    ],
    "fr": [
      "Découverte du métier d'agriculteur et visite d'une ferme en pleine activité : soignez et caressez les animaux (ânes, chèvres, lapins, poules). Nourrissez les veaux au biberon et participez à la traite des vaches !"
    ],
    "nl": [
      "Ontdek het boerenvak en bezoek een werkende boerderij: verzorg en aai de dieren (ezels, geiten, konijnen, kippen). Geef de kalfjes flesvoeding en help de koeien melken!"
    ],
    "es": [
      "Descubra la profesión de granjero y visite una granja en funcionamiento: cuide y acaricie a los animales (burros, cabras, conejos, gallinas). Da el biberón a los terneros y ayuda a ordeñar a las vacas"
    ]
  },
