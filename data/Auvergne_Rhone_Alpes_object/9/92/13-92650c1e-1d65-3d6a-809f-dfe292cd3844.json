  "rdfs:comment": {
    "de": [
      "In diesem Park, der über einen Musikpavillon verfügt, können Sie gesellige Momente im Freien verbringen.\r\nEin Kriegerdenkmal, ein Ort der Erinnerung an den Zweiten Weltkrieg, sitzt in der Mitte des Perimeters."
    ],
    "en": [
      "This park, with its bandstand, is the perfect place to share convivial outdoor moments.\r\nA war memorial from the Second World War sits at the center of the perimeter."
    ],
    "it": [
      "Questo parco, con la sua tribuna, è un luogo ideale per godersi la vita all'aria aperta.\r\nAl centro del perimetro si trova un monumento ai caduti della Seconda Guerra Mondiale."
    ],
    "fr": [
      "Des moments conviviaux en plein air à partager dans ce parc qui possède son kiosque à musique.\r\nUn monument aux morts, lieu de mémoire de la Seconde Guerre mondiale siège au centre du périmètre."
    ],
    "es": [
      "Este parque, con su quiosco de música, es un lugar ideal para disfrutar del aire libre.\r\nEn el centro del perímetro hay un monumento conmemorativo de la Segunda Guerra Mundial."
    ],
    "nl": [
      "Dit park, met zijn muziektent, is een geweldige plek om van de buitenlucht te genieten.\r\nIn het midden van het park staat een oorlogsmonument uit de Tweede Wereldoorlog."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Jardin du 8 mai 1945"
    ]
  },
