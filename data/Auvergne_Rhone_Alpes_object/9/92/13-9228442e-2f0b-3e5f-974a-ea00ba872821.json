  "rdfs:comment": {
    "de": [
      "Bergrestaurant, traditionelle und bodenständige Küche, aber nicht nur das ... ! Frische Produkte der Saison. Im L'Avalanche machen Sie eine Pause mit Blick auf den Hang!  Große Terrasse und gemütliches Interieur am Fuße der Pisten von La Sambuy."
    ],
    "en": [
      "A genuine mountain restaurant offering traditional and local cuisine and much more! Fresh seasonal produce and other products. At L'Avalanche, stop for a quick break and enjoy the slope-side views! Enjoy the vast outdoor patio and warm indoor dining room at the foot of the La Sambuy ski resort."
    ],
    "it": [
      "Ristorante di montagna, cucina tradizionale e locale ma non solo... ! Prodotti freschi di stagione. Presso l'Avalanche, fate una pausa di fronte alla pista!  Ampia terrazza e interni accoglienti ai piedi delle piste di Sambuy."
    ],
    "fr": [
      "Restaurant de montagne, cuisine traditionnelle et de terroir mais pas que cela... ! Produits frais de saison. A l'Avalanche, faites une pause face à la pente !  Grande terrasse et intérieur chaleureux au pied des pistes de la Sambuy."
    ],
    "es": [
      "Restaurante de montaña, cocina tradicional y local, pero no sólo eso... ¡! Productos frescos de temporada. En el Avalanche, ¡toma un descanso frente a la pendiente!  Amplia terraza y cálido interior a los pies de las pistas de Sambuy."
    ],
    "nl": [
      "Bergrestaurant, traditionele en lokale keuken... ! Verse seizoensproducten. Bij de Avalanche, neem een pauze met uitzicht op de helling!  Groot terras en warm interieur aan de voet van de Sambuy-pistes."
    ]
  },
  "rdfs:label": {
    "en": [
      "L'Avalanche"
    ],
