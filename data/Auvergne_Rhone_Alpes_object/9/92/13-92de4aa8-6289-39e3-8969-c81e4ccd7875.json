  "rdfs:comment": {
    "de": [
      "Das Geschäft Mustang 1550 Skimium bietet Ihnen eine große Auswahl an Skiern, Snowboards, Schlitten, Schneeschuhen, Fahrrädern und sogar Kinderwagen zur Miete oder zum Kauf an. Außerdem gibt es einen Wartungs- und Bootfitting-Service, Presse, Kaffee, Souvenirs und regionale Produkte."
    ],
    "en": [
      "The Mustang 1550 Skimium store offers a wide range of skis, snowboards, sledges, snowshoes, bikes and even baby carriages for hire or sale. As well as a maintenance and bootfitting service, press, coffee, souvenirs and regional products."
    ],
    "it": [
      "Il negozio Mustang 1550 Skimium offre un'ampia gamma di sci, snowboard, slitte, racchette da neve, biciclette e persino passeggini a noleggio o in vendita. Inoltre, offre un servizio di manutenzione e adattamento degli scarponi, stampa, caffè, souvenir e prodotti regionali."
    ],
    "fr": [
      "Le magasin Mustang 1550 Skimium vous propose à la location ou à la vente, un large choix de skis, snowboards, luges, raquettes, vélos ou même poussette. Ainsi qu'un service entretien et bootfitting, la presse, le café, des souvenirs et produits régionaux."
    ],
    "es": [
      "La tienda Mustang 1550 Skimium ofrece una amplia gama de esquís, snowboards, trineos, raquetas de nieve, bicicletas e incluso cochecitos para alquilar o vender. Además de un servicio de mantenimiento y reparación de botas, prensa, café, recuerdos y productos regionales."
    ],
    "nl": [
      "In de Mustang 1550 Skimium winkel kun je ski's, snowboards, sleeën, sneeuwschoenen, fietsen en zelfs kinderwagens huren of kopen. Je vindt er ook een onderhouds- en schoenservice, pers, koffie, souvenirs en regionale producten."
    ]
  },
  "rdfs:label": {
