  "rdfs:comment": {
    "de": [
      "In Saint-Sorlin-en-Valloire findet die sechste Ausgabe des Festivals Électrolapse statt.\r\nDieses unumgängliche Ereignis der internationalen elektronischen Szene kehrt mit einem hochkarätigen Programm zurück."
    ],
    "en": [
      "Saint-Sorlin-en-Valloire plays host to the sixth edition of the Électrolapse Festival.\r\nThis not-to-be-missed event on the international electronic scene returns with a top-flight line-up."
    ],
    "it": [
      "Saint-Sorlin-en-Valloire ospiterà la sesta edizione dell'Électrolapse Festival.\r\nQuesto imperdibile evento della scena elettronica internazionale torna con una line-up di prim'ordine."
    ],
    "fr": [
      "Saint-Sorlin-en-Valloire accueillera la sixième édition du Festival Électrolapse.\r\nCet événement incontournable de la scène électronique internationale revient avec une programmation de haut vol."
    ],
    "nl": [
      "Saint-Sorlin-en-Valloire organiseert de zesde editie van het Électrolapse Festival.\r\nDit niet te missen evenement in de internationale elektronische scene is terug met een top line-up."
    ],
    "es": [
      "Saint-Sorlin-en-Valloire acogerá la sexta edición del Festival Électrolapse.\r\nEsta cita ineludible de la electrónica internacional vuelve con un cartel de lujo."
    ]
  },
