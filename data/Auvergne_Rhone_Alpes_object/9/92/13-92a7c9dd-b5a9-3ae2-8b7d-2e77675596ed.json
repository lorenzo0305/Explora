  "rdfs:comment": {
    "de": [
      "Fliegen Sie mit Air Forez: Privatflug im Copilotensitz über die Monts et plaines du Forez. 360°-Ansicht, garantierte Emotionen.\r\nSobald Sie abheben, öffnet sich die Ebene, die Teiche glitzern, die Berge zeichnen sich ab: ein Festival der Reliefs und der Gefühle"
    ],
    "en": [
      "Take to the skies with Air Forez: private co-pilot flight over the Monts et plaines du Forez. 360° views, emotions guaranteed.\r\nAs soon as you take off, the plain opens up, the ponds sparkle and the mountains take shape: a festival of relief and sensations"
    ],
    "it": [
      "Prendete il volo con Air Forez: un volo privato in copilota sopra i monti e le pianure del Forez. Vista a 360°, emozioni garantite.\r\nAppena decollati, la pianura si apre, gli stagni brillano e le montagne prendono forma: un festival di paesaggi e sensazioni"
    ],
    "fr": [
      "Envolez-vous avec Air Forez : vol privé en place copilote au-dessus des Monts et plaines du Forez. Vues 360°, émotions garanties.\r\nDès le décollage, la plaine s’ouvre, les étangs scintillent, les monts se dessinent : un festival de reliefs et de sensations"
    ],
    "es": [
      "Surque los cielos con Air Forez: un vuelo privado en el asiento del copiloto sobre los montes y llanuras de Forez. Vistas de 360°, emociones garantizadas.\r\nNada más despegar, la llanura se abre, los estanques centellean y las montañas toman forma: un festival de paisajes y sensaciones"
    ],
    "nl": [
      "Ga de lucht in met Air Forez: een privévlucht in de stoel van de copiloot over de Monts en vlaktes van Forez. 360° uitzicht, gegarandeerd sensatie.\r\nZodra je opstijgt, opent de vlakte zich, glinsteren de vijvers en krijgen de bergen vorm: een festival van landschappen en sensaties"
    ]
  },
