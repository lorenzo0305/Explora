  "rdfs:comment": {
    "de": [
      "Das Diabolo oder Guinguette du Pont du Diable empfängt Sie täglich von Anfang April bis Ende September von 10:00 bis 19:00 Uhr mit durchgehendem Service. Vor Ort: Verleih von Ausrüstung für die Via Ferrata."
    ],
    "en": [
      "Le Diabolo or Guinguette du Pont du Diable welcomes you every day from early April to late September, from 10am to 7pm with continuous service. On-site: Via Ferrata equipment hire."
    ],
    "it": [
      "Le Diabolo o Guinguette du Pont du Diable vi accoglie tutti i giorni dall'inizio di aprile alla fine di settembre, dalle 10 alle 19 con servizio continuo. Sul posto: noleggio di attrezzature per la Via Ferrata."
    ],
    "fr": [
      "Le Diabolo ou Guinguette du Pont du Diable vous accueille tous les jours de début Avril à fin Septembre, de 10h à 19h avec un service en continu. Sur place : location de matériel pour la Via Ferrata."
    ],
    "nl": [
      "Le Diabolo of Guinguette du Pont du Diable verwelkomt je elke dag van begin april tot eind september, van 10u tot 19u met doorlopende bediening. Ter plaatse: verhuur van Via Ferrata uitrusting."
    ],
    "es": [
      "Le Diabolo o Guinguette du Pont du Diable le da la bienvenida todos los días desde principios de abril hasta finales de septiembre, de 10:00 a 19:00 horas con servicio continuo. In situ: alquiler de material de Via Ferrata."
    ]
  },
