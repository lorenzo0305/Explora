  "rdfs:comment": {
    "de": [
      "Das Hotelrestaurant ist eine Einladung zum Schlemmen und Genießen der regionalen Aromen. Es wurde mit den Labels \"Goûtez l'Ardèche\" und \"Les Étapes savoureuses\" ausgezeichnet und bietet Ihnen eine saisonale, hausgemachte Küche, in der die Produkte der Ardèche im Vordergrund stehen."
    ],
    "en": [
      "The hotel restaurant is a gourmet invitation to local flavors. Awarded the 'Goûtez l'Ardèche' and 'Les étapes savoureuses' labels, it serves seasonal, home-cooked cuisine featuring Ardèche produce."
    ],
    "it": [
      "Il ristorante dell'hotel è un invito gastronomico ai sapori locali. Premiato con i marchi \"Goûtez l'Ardèche\" e \"Les Étapes savoureuses\", propone una cucina stagionale e casalinga a base di prodotti locali."
    ],
    "fr": [
      "Le restaurant de l’hôtel est une invitation gourmande aux saveurs du terroir. Labellisé « Goûtez l’Ardèche » et « Les Étapes savoureuses », il vous propose une cuisine de saison faite maison, mettant à l’honneur les produits ardéchois."
    ],
    "nl": [
      "Het restaurant van het hotel is een gastronomische uitnodiging voor lokale smaken. Het is bekroond met de labels \"Goûtez l'Ardèche\" en \"Les Étapes savoureuses\" en serveert seizoensgebonden, huisgemaakte gerechten met lokale producten."
    ],
    "es": [
      "El restaurante del hotel es una invitación gastronómica a los sabores locales. Galardonado con las etiquetas \"Goûtez l'Ardèche\" y \"Les Étapes savoureuses\", sirve cocina casera de temporada elaborada con productos locales."
    ]
  },
  "rdfs:label": {
    "en": [
      "Restaurant at the Hotel Les Cèdres"
    ],
