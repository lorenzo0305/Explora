  "rdfs:comment": {
    "de": [
      "Bijouterie Rafael bietet Ihnen eine große Auswahl an Schmuckstücken aus Gold, Silber, vergoldetem Stahl oder Stahl 316L.\r\nAußerdem finden Sie hier eine große Auswahl an Uhren großer Marken zu günstigen Preisen: Lotus, Candino, Calypso, etc....."
    ],
    "en": [
      "Bijouterie Rafael offers you a wide choice of gold, silver, gold-plated and 316L steel jewelry.\r\nAs well as a wide choice of watches from top brands at low prices: Lotus, Candino , Calypso, etc...."
    ],
    "it": [
      "La Bijouterie Rafael vi offre un'ampia scelta di gioielli in oro, argento, placcati in oro o in acciaio 316L.\r\nOltre ad un'ampia scelta di orologi di grandi marche a piccoli prezzi: Lotus, Candino, Calypso, ecc?"
    ],
    "fr": [
      "Bijouterie Rafael vous offre un large choix en matière de bijoux en Or en Argent en Plaqué Or ou en Acier  316L.\r\nAinsi qu’ un large choix de montres de grandes marques à petit prix : Lotus, Candino , Calypso, etc…."
    ],
    "es": [
      "Bijouterie Rafael le ofrece una amplia selección de joyas de oro, plata, chapado en oro o acero 316L.\r\nAsí como una gran selección de relojes de grandes marcas a pequeños precios: Lotus, Candino, Calypso, etc..."
    ],
    "nl": [
      "Bijouterie Rafael biedt je een ruime keuze aan gouden, zilveren, vergulde en 316L stalen sieraden.\r\nOok een ruime keuze aan horloges van topmerken tegen lage prijzen: Lotus, Candino , Calypso, etc...."
    ]
  },
  "rdfs:label": {
    "fr": [
