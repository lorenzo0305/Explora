  "rdfs:comment": {
    "de": [
      "Die Vereinigung Le Sou des Écoles d'Oriol-en-Royans unterstützt Schulprojekte und außerschulische Aktivitäten. Sie organisiert Veranstaltungen und Animationen, um Ausrüstungen zu finanzieren und den Kindern eine bereichernde Lernumgebung zu bieten."
    ],
    "en": [
      "Le Sou des Écoles d'Oriol-en-Royans supports school projects and extracurricular activities. It organizes events and activities to finance equipment and provide children with an enriching learning environment."
    ],
    "it": [
      "Le Sou des Écoles d'Oriol-en-Royans sostiene progetti scolastici e attività extrascolastiche. Organizza eventi e attività per finanziare le attrezzature e offrire ai bambini un ambiente di apprendimento arricchente."
    ],
    "fr": [
      "L'association Le Sou des Écoles d'Oriol-en-Royans soutient les projets scolaires et les activités périscolaires. Elle organise des événements et des animations pour financer des équipements et offrir aux enfants un cadre d'apprentissage enrichissant."
    ],
    "nl": [
      "Le Sou des Écoles d'Oriol-en-Royans ondersteunt schoolprojecten en buitenschoolse activiteiten. Het organiseert evenementen en activiteiten om apparatuur te financieren en kinderen een verrijkende leeromgeving te bieden."
    ],
    "es": [
      "Le Sou des Écoles d'Oriol-en-Royans apoya proyectos escolares y actividades extraescolares. Organiza eventos y actividades para financiar equipos y ofrecer a los niños un entorno de aprendizaje enriquecedor."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le sou des écoles"
    ]
  },
