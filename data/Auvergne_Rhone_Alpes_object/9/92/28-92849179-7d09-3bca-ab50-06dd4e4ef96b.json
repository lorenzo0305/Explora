  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/b88e7074-c218-34f7-a1c6-ab4bdc4716f6",
      "dc:description": {
        "de": [
          "Willkommen in Hergnies: Ein charmantes ländliches Dorf an den Ufern der Schelde. Hergnies profitiert von der Dynamik des regionalen Naturparks Scarpe-Escaut und ist eines der grünen und flussorientierten Tourismuszentren des Valenciennois."
        ],
        "en": [
          "Welcome to Hergnies: a charming rural village on the banks of the Scheldt. Benefiting from the dynamics of the Scarpe-Escaut Regional Nature Park, Hergnies has established itself as one of the green and river tourist centers of the Valenciennois."
        ],
        "it": [
          "Benvenuti a Hergnies: un'affascinante cittadina rurale sulle rive dell'Escaut. Beneficiando della dinamica del Parco Naturale Regionale Scarpe-Escaut, Hergnies si è affermata come uno dei centri turistici verdi e fluviali del Valenciennois."
        ],
        "fr": [
          "Bienvenue à Hergnies: Charmant bourg rural sur les rives de l'Escaut. Profitant de la dynamique du parc naturel régional Scarpe-Escaut, Hergnies s'affirme comme l'un des centres touristiques verts et fluviaux du Valenciennois."
        ],
        "nl": [
          "Welkom in Hergnies: een charmant plattelandsstadje aan de oevers van de Schelde. Hergnies profiteert van de dynamiek van het regionale natuurpark Scarpe-Escaut en heeft zich gevestigd als een van de groene en riviertoeristische centra van de Valenciennois."
        ],
        "es": [
          "Bienvenido a Hergnies: una encantadora ciudad rural a orillas del Escaut. Beneficiándose de la dinámica del Parque Natural Regional de Scarpe-Escaut, Hergnies se ha consolidado como uno de los centros turísticos verdes y fluviales del Valenciennois."
        ]
      },
