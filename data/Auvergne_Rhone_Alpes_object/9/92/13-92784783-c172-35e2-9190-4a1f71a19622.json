  "rdfs:comment": {
    "de": [
      "Franck und Myriam leiten dieses Multiservice-Geschäft: Bar, Snacks, Lebensmittel, Post- und Bankdienstleistungen? und nicht zu vergessen die regelmäßigen Veranstaltungen, die organisiert werden.\r\nDie meisten der angebotenen Produkte stammen aus der Region."
    ],
    "en": [
      "Franck and Myriam are the managers of this multi-service business: bar, snack bar, grocery store, postal and banking services? not forgetting the regular events organized.\r\nMost of the products on offer are local."
    ],
    "it": [
      "Franck e Myriam gestiscono questa attività multiservizi, che comprende un bar, uno snack bar, un negozio di alimentari, servizi postali e bancari, oltre a eventi regolari.\r\nLa maggior parte dei prodotti offerti sono locali."
    ],
    "fr": [
      "Franck et Myriam sont les gérants de ce commerce multi-services : bar, snacking, épicerie, services postaux et bancaires… sans oublier les évènements réguliers organisés.\r\nLa majorité des produits proposés sont locaux."
    ],
    "es": [
      "Franck y Myriam dirigen este negocio multiservicios, que incluye bar, cafetería, tienda de comestibles, servicios postales y bancarios, sin olvidar los eventos periódicos.\r\nLa mayoría de los productos que se ofrecen son locales."
    ],
    "nl": [
      "Franck en Myriam runnen deze multiservicezaak met een bar, snackbar, kruidenierswinkel, post- en bankdiensten en niet te vergeten regelmatige evenementen.\r\nDe meeste aangeboden producten zijn lokaal."
    ]
  },
