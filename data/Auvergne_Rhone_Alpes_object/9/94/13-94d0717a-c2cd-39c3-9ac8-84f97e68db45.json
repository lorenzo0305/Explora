  "rdfs:comment": {
    "de": [
      "Coutellia, das internationale Festival des Kunst- und Traditionsmessers, kehrt am 16. und 17. Mai zu seiner 35. Dieses Jahr werden 300 Aussteller aus aller Welt ihr Können in Thiers, der Welthauptstadt der Messerschmiedekunst, präsentieren."
    ],
    "en": [
      "Coutellia is Europe’s leading knife festival. Every year in Thiers, it brings together professionals and amateurs from France and around the world. Over the course of a weekend, the entire cutlery industry assembles in the heart of its world capital: 300 art cutlers and cutlery manufacturers from 22 different countries, as well as some twenty suppliers of raw materials and equipment for the cutlery industry."
    ],
    "it": [
      "Coutellia, il Festival Internazionale del Coltello d'Arte e Tradizionale, torna il 16 e 17 maggio per la sua 35a edizione. Quest'anno, 300 espositori provenienti da tutto il mondo metteranno in mostra le loro competenze a Thiers, la capitale mondiale della coltelleria."
    ],
    "fr": [
      "Coutellia, le Festival International du Couteau d’Art et de Tradition, revient les 16 & 17 mai pour sa 35ème édition. Cette année, 300 exposants venus du monde entier viendront présenter leur savoir-faire à Thiers, capitale mondiale de la coutellerie."
    ],
    "nl": [
      "Coutellia, het Internationale Festival van Kunst en Ambachtelijke Messen, keert op 16 en 17 mei terug voor zijn 35e editie. Dit jaar zullen 300 exposanten van over de hele wereld hun expertise tonen in Thiers, de wereldhoofdstad van het bestek."
    ],
    "es": [
      "Coutellia, Festival Internacional del Arte y la Cuchillería Tradicional, vuelve los días 16 y 17 de mayo en su 35ª edición. Este año, 300 expositores de todo el mundo mostrarán su saber hacer en Thiers, capital mundial de la cuchillería."
    ]
  },
