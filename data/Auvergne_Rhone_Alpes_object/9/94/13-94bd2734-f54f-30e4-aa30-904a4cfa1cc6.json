  "rdfs:comment": {
    "de": [
      "Am Fuße des Roc d'Enfer, auf der Alm von Graydon, können Sie unsere berühmten Kartoffelkrapfen und zahlreiche Savoyer Spezialitäten probieren: Tartiflette, Fondue, Heidelbeerkuchen, Eisbecher usw....."
    ],
    "en": [
      "At the foot of the Roc d'Enfer mountain, in beautiful Graydon hamlet, come and taste our famous potato fritters and Savoyard specialities: tartiflette, cheese fondue, blueberry tart, ice cream, etc.."
    ],
    "it": [
      "Ai piedi del Roc d'Enfer, nell'alpeggio Graydon, potrete gustare le nostre famose frittelle di patate e molte specialità savoiarde: tartiflette, fonduta, crostata di mirtilli, coppe di gelato, ecc...."
    ],
    "fr": [
      "Au pied du Roc d'Enfer, dans l'alpage de Graydon, vous pourrez déguster nos fameux beignets de pommes de terre et de nombreuses spécialités savoyardes : tartiflette, fondue, tarte aux myrtilles, coupes glacées, etc...."
    ],
    "nl": [
      "Aan de voet van de Roc d'Enfer, in de Graydon bergweide, kunt u genieten van onze beroemde aardappelbeignets en vele Savoyaardse specialiteiten: tartiflette, fondue, bosbessentaart, ijscoupes, etc...."
    ],
    "es": [
      "A los pies del Roc d'Enfer, en los pastos de la montaña de Graydon, podrá degustar nuestros famosos buñuelos de patata y muchas especialidades saboyanas: tartiflette, fondue, tarta de arándanos, helados, etc...."
    ]
  },
  "rdfs:label": {
    "en": [
      "Buvette du Roc d'Enfer"
    ],
    "fr": [
      "Buvette du Roc d'Enfer"
    ]
  },
