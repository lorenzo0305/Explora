  "rdfs:comment": {
    "de": [
      "Auf dem Programm stehen zwei Abende, die dem künstlerischen Schaffen der Studentinnen und Studenten des Campus UGA Valence Drôme Ardèche gewidmet sind. Es gibt 13 Darbietungen, die mit der Unterstützung von professionellen Künstlern realisiert werden. Mehr als dreißig Studentinnen und Studenten."
    ],
    "en": [
      "On the program: two evenings dedicated to the artistic creations of students from the UGA Valence Drôme Ardèche Campus, with 13 performances, produced with the complicity of professional artists. More than thirty students."
    ],
    "it": [
      "In programma: due serate dedicate alle creazioni artistiche degli studenti del Campus UGA Valence Drôme Ardèche, con 13 spettacoli di artisti professionisti. Parteciperanno più di trenta studenti."
    ],
    "fr": [
      "Au programme : deux soirées dédiées aux créations artistiques des étudiants et des étudiantes du Campus UGA Valence Drôme Ardèche, avec 13 prestations, réalisées avec la complicité d’artistes professionnels. Plus d’une trentaine d’étudiantes et étudiants."
    ],
    "nl": [
      "Op het programma: twee avonden gewijd aan de artistieke creaties van studenten van de UGA Valence Drôme Ardèche Campus, met 13 optredens van professionele artiesten. Meer dan dertig studenten zullen deelnemen."
    ],
    "es": [
      "En el programa: dos veladas dedicadas a las creaciones artísticas de los estudiantes del Campus UGA Valence Drôme Ardèche, con 13 actuaciones de artistas profesionales. Participarán más de treinta estudiantes."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Arts & Facs, édition anniversaire 25e édition !"
    ]
  },
