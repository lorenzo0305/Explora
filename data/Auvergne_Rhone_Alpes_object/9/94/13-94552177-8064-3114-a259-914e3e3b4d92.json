  "rdfs:comment": {
    "de": [
      "Die Kombination aus einer traditionellen Blockhütte und einem zeitgenössischen, gemütlichen Interieur mit einer sehr gepflegten Dekoration an einem privilegierten Ort am Rande des 18-Loch-Golfplatzes, nur wenige Minuten vom Stadtzentrum entfernt."
    ],
    "en": [
      "The combination of a traditional log cabin and a contemporary and warm interior with a very careful decoration, in a privileged place at the edge of the 18-hole golf course, a few minutes from the city center."
    ],
    "it": [
      "La combinazione di una tradizionale casetta di legno e di interni contemporanei, caldi e ben decorati, in una posizione privilegiata ai margini del campo da golf a 18 buche, a pochi minuti dal centro della città."
    ],
    "fr": [
      "La combinaison d'une cabane en rondins de bois traditionnelle et d'un intérieur contemporain et chaleureux avec une décoration très soignée, dans un lieu privilégié au bord du golf 18 trous, à quelques minutes du centre ville."
    ],
    "es": [
      "La combinación de una cabaña de madera tradicional y un interior contemporáneo, cálido y bien decorado, en una ubicación privilegiada en el borde del campo de golf de 18 hoyos, a pocos minutos del centro de la ciudad."
    ],
    "nl": [
      "De combinatie van een traditionele blokhut en een eigentijds, warm en goed ingericht interieur, op een bevoorrechte locatie aan de rand van de 18-holes golfbaan, op slechts enkele minuten van het stadscentrum."
    ]
  },
  "rdfs:label": {
    "en": [
      "Cabane des Praz restaurant"
    ],
    "fr": [
      "Restaurant Cabane des Praz"
    ]
  },
