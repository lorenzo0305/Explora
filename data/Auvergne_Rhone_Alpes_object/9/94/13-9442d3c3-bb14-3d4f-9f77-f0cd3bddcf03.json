  "rdfs:comment": {
    "de": [
      "Erster Raum in Grenoble, der ausschließlich dem Axtwerfen gewidmet ist, mit sechs Wurfbahnen, die 18 Werfer über eine Stunde aufnehmen können.\r\n Getränke und Aperitifplatten sorgen für Ihr leibliches Wohl."
    ],
    "en": [
      "Grenoble's first hall dedicated exclusively to axe throwing, with six throwing lanes accommodating 18 throwers for an hour.\r\n Drinks and appetizers to keep you full."
    ],
    "it": [
      "La prima sala di Grenoble dedicata esclusivamente al lancio dell'ascia, con sei corsie di lancio che possono ospitare 18 lanciatori per un'ora.\r\n Sono disponibili bevande e stuzzichini per saziarvi."
    ],
    "fr": [
      "Première salle à Grenoble, exclusivement dédiée au lancer de haches, avec six couloirs de lancer pouvant accueillir 18 lanceurs sur une heure.\r\n Boissons et plateaux apéritifs pour vous rassasier."
    ],
    "es": [
      "El primer lugar de Grenoble dedicado exclusivamente al lanzamiento de hachas, con seis calles de lanzamiento para 18 lanzadores durante una hora.\r\n Bebidas y tentempiés para saciarse."
    ],
    "nl": [
      "De eerste hal in Grenoble die uitsluitend gewijd is aan het bijlwerpen, met zes werpbanen die plaats bieden aan 18 werpers gedurende een uur.\r\n Drankjes en hapjes zijn beschikbaar om u te vullen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "LES HACHES DE GRENOBLE"
    ]
  },
