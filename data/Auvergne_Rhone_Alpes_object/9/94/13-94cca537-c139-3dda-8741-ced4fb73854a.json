  "rdfs:comment": {
    "de": [
      "Eine 350 m² große ehemalige Textilfabrik, die von dem Architekten Philippe Domas und dem Kunstdirektor Anthony Comte in vier Lofts umgewandelt wurde. Vier Räume werden zur Kurzzeitmiete angeboten, mit einem Concierge-Service, der einem Grand Hotel würdig ist."
    ],
    "en": [
      "Former 350 m² textile factory transformed into four lofts by architect Philippe Domas and artistic director Anthony Comte. Four spaces are available for short term rentals with a concierge service worthy of a grand hotel."
    ],
    "it": [
      "Un'ex fabbrica tessile di 350 m² trasformata in quattro loft dall'architetto Philippe Domas e dal direttore artistico Anthony Comte. Quattro spazi sono disponibili per affitti a breve termine con un servizio di portineria degno di un grande albergo."
    ],
    "fr": [
      "Ancienne usine textile de 350 m² transformée en quatre lofts par l’architecte Philippe Domas et le directeur artistique Anthony Comte. Quatre espaces sont proposés à la location de courte durée avec une conciergerie digne d’un grand hôtel."
    ],
    "es": [
      "Una antigua fábrica textil de 350 m² transformada en cuatro lofts por el arquitecto Philippe Domas y el director artístico Anthony Comte. Hay cuatro espacios disponibles para alquiler a corto plazo con un servicio de conserjería digno de un gran hotel."
    ],
    "nl": [
      "Een voormalige textielfabriek van 350 m² omgebouwd tot vier lofts door architect Philippe Domas en artistiek directeur Anthony Comte. Vier ruimtes zijn beschikbaar voor korte termijn verhuur met een conciërgeservice die een groot hotel waardig is."
    ]
  },
  "rdfs:label": {
