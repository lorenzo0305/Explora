  "rdfs:comment": {
    "de": [
      "Tl Prod ist ein Event-Verein, der von Christophe geleitet wird, und eine Aktivität, die von Virginie geleitet wird.\r\n\"Les Matinales Sophro\" sind eine Einladung, sich auf sich selbst zu besinnen, sich besser kennenzulernen und gleichzeitig zu lernen, wie man sich im Alltag in einer natürlichen Umgebung entspannen kann."
    ],
    "en": [
      "Tl Prod is an events association managed by Christophe and an activity managed by Virginie.\r\n\"Les Matinales Sophro\" are an invitation to refocus on oneself, to get to know oneself better while learning to relax on a daily basis in a natural setting."
    ],
    "it": [
      "Tl Prod è un'associazione di eventi gestita da Christophe e un'attività gestita da Virginie\r\ni \"Matinales Sophro\" sono un invito a concentrarsi su se stessi, a conoscersi meglio imparando a rilassarsi in un ambiente naturale."
    ],
    "fr": [
      "Tl Prod est une association événementielle gérée par Christophe et une activité gérée par Virginie. \r\n\"Les Matinales Sophro\" sont une invitation à se recentrer sur soi, mieux se connaître tout en apprenant à se détendre au quotidien dans un cadre naturel."
    ],
    "nl": [
      "Tl Prod is een evenementenvereniging geleid door Christophe en een activiteit geleid door Virginie.\r\n\"Les Matinales Sophro\" is een uitnodiging om zich opnieuw op zichzelf te concentreren, zichzelf beter te leren kennen en te leren ontspannen in een natuurlijke omgeving."
    ],
    "es": [
      "Tl Prod es una asociación de eventos dirigida por Christophe y una actividad gestionada por Virginie\r\nlos \"Matinales Sophro\" son una invitación a volver a centrarse en uno mismo, a conocerse mejor mientras se aprende a relajarse en un entorno natural."
    ]
  },
