  "rdfs:comment": {
    "de": [
      "Ideal zum Entspannen: Gönnen Sie sich eine Pause in der Weinbar, wo traditionelle Brettchen oder Tapas wunderbar mit den französischen Weinen aus unserem Keller harmonieren."
    ],
    "en": [
      "Ideal for relaxing, enjoy a break at the wine bar where small snacks go great with French wines."
    ],
    "it": [
      "Ideale per rilassarsi, concedetevi una pausa al wine bar, dove piatti tradizionali o tapas sono perfettamente abbinati ai vini francesi della nostra cantina."
    ],
    "fr": [
      "Idéal pour se détendre, offrez-vous une pause au bar à vin où les planchettes traditionnelles ou tapas se marient à merveille avec les vins français de notre cave."
    ],
    "es": [
      "Ideal para relajarse, regálese una pausa en el bar de vinos, donde los platos tradicionales o las tapas se maridan perfectamente con los vinos franceses de nuestra bodega."
    ],
    "nl": [
      "Ideaal om te ontspannen, trakteer uzelf op een pauze in de wijnbar waar traditionele schotels of tapas perfect samengaan met de Franse wijnen uit onze kelder."
    ]
