  "rdfs:comment": {
    "de": [
      "Die Domaine Christophe Savoye im Herzen von Chiroubles ist seit sechs Generationen in Familienbesitz. Sie bewirtschaftet 15 Hektar und vinifiziert die AOP-Crus des Beaujolais (Chiroubles, Morgon, Régnié), die Terroir, Tradition und regelmäßig mit Medaillen ausgezeichnete Weine vereinen."
    ],
    "en": [
      "In the heart of Chiroubles, Domaine Christophe Savoye is a family estate passed down through six generations. Spanning 15 hectares, it produces Beaujolais AOP wines (Chiroubles, Morgon, Régnié), combining terroir, tradition, and regularly award-winning wines."
    ],
    "it": [
      "Nel cuore di Chiroubles, il Domaine Christophe Savoye, azienda familiare da sei generazioni, coltiva 15 ettari e produce annate di Beaujolais AOP (Chiroubles, Morgon, Régnié), combinando terroir, tradizione e vini pluripremiati."
    ],
    "fr": [
      "Au cœur de Chiroubles, le Domaine Christophe Savoye, domaine familial depuis six générations, cultive 15 ha et vinifie des crus AOP du Beaujolais (Chiroubles, Morgon, Régnié), alliant terroir, tradition et vins régulièrement médaillés."
    ],
    "nl": [
      "In het hart van Chiroubles cultiveert Domaine Christophe Savoye, al zes generaties lang een familiebedrijf, 15 hectare en produceert AOP Beaujolais-wijnen (Chiroubles, Morgon, Régnié), een combinatie van terroir, traditie en bekroonde wijnen."
    ],
    "es": [
      "En el corazón de Chiroubles, el Domaine Christophe Savoye, propiedad familiar desde hace seis generaciones, cultiva 15 hectáreas y produce cosechas de Beaujolais AOP (Chiroubles, Morgon, Régnié), combinando terruño, tradición y vinos premiados."
    ]
  },
