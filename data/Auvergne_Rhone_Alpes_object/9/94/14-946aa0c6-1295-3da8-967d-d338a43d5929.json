      "dc:description": {
        "de": [
          "Als Begründer des Discounts bietet ALDI Ihnen Qualitätsprodukte zum besten Preis.\n\nÖffnungszeiten:\n- montag bis Samstag von 08:30 bis 19:00 Uhr."
        ],
        "en": [
          "The creator of discount, ALDI offers you quality products at the best prices.\n\nOpening hours :\n- monday to Saturday, 08:30 to 19:00."
        ],
        "it": [
          "Creatore di sconti, ALDI vi offre prodotti di qualità al miglior prezzo.\n\nOrari di apertura :\n- dal lunedì al sabato dalle 08:30 alle 19:00."
        ],
        "fr": [
          "Créateur du discount, ALDI vous propose des produits de qualité au meilleur prix.\n\nHoraires :\n- du lundi au samedi de 08h30 à 19h00."
        ],
        "es": [
          "Creador del descuento, ALDI te ofrece productos de calidad a los mejores precios.\n\nHorario de apertura :\n- de lunes a sábado de 08h30 a 19h00."
        ],
        "nl": [
          "ALDI, de bedenker van kortingen, biedt je kwaliteitsproducten tegen de beste prijzen.\n\nOpeningstijden :\n- maandag tot zaterdag van 08.30 tot 19.00 uur."
        ]
      },
