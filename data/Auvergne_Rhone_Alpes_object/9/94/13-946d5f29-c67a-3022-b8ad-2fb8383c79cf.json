            "en": [
              "\"Open all year round\r\ntuesday to Thursday, 11:30 to 13:30 and 18:00 to 21:30\r\nfridays and Saturdays from 11:30 to 13:30 and 18:00 to 22:00\r\nsundays and Mondays evenings only from 18:00 to 21:30\""
            ],
            "it": [
              "\"Aperto tutto l'anno\r\nda martedì a giovedì, dalle 11:30 alle 13:30 e dalle 18:00 alle 21:30\r\nvenerdì e sabato dalle 11:30 alle 13:30 e dalle 18:00 alle 22:00\r\ndomenica e lunedì solo la sera dalle 18:00 alle 21:30\""
            ],
            "fr": [
              "\"Ouvert toute l'année\r\ndu mardi au jeudi de 11:30 à 13:30 et 18:00 à 21:30\r\nles vendredis et samedis de 11:30 à 13:30 et 18:00 à 22:00\r\nles dimanches et lundis le soir uniquement de 18:00 à 21h30\""
            ],
            "nl": [
              "\"Het hele jaar geopend\r\ndinsdag tot donderdag van 11:30 tot 13:30 en 18:00 tot 21:30\r\nvrijdag en zaterdag van 11.30 tot 13.30 uur en van 18.00 tot 22.00 uur\r\nzondag en maandag alleen 's avonds van 18.00 tot 21.30 uur\""
            ],
            "es": [
              "\" Abierto todo el año\r\nde martes a jueves de 11:30 a 13:30 y de 18:00 a 21:30\r\nviernes y sábados de 11:30 a 13:30 y de 18:00 a 22:00\r\ndomingos y lunes sólo por la tarde, de 18.00 a 21.30\""
            ]
