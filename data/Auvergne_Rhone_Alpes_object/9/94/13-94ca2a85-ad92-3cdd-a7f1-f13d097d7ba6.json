  "rdfs:comment": {
    "de": [
      "Auf einem Felsvorsprung gelegen, ist Allex ein mittelalterliches Dorf im Département Drôme mit einem reichen Kulturerbe. Entdecken Sie seine Ruinen, Geheimgänge und die unberührte Natur der Drôme."
    ],
    "en": [
      "Nestled on a rocky outcrop, Allex is a medieval village in the Drôme department with a rich heritage. Discover its ruins, secret passages, and the unspoiled nature of the Drôme."
    ],
    "it": [
      "Adagiato su uno sperone roccioso, Allex è un villaggio medievale della Drôme con un ricco patrimonio. Scoprite le sue rovine, i suoi passaggi segreti e la natura incontaminata della Drôme."
    ],
    "fr": [
      "Nichée sur un éperon rocheux, Allex est un village médiéval de la Drôme au riche patrimoine. Découvrez ses vestiges, ses passages secrets  et la nature préservée de la Drôme."
    ],
    "es": [
      "Enclavado en un promontorio rocoso, Allex es un pueblo medieval de la Drôme con un rico patrimonio. Descubra sus ruinas, sus pasadizos secretos y la naturaleza virgen de la Drôme."
    ],
    "nl": [
      "Allex, gelegen op een rotspunt, is een middeleeuws dorp in het departement Drôme met een rijk erfgoed. Ontdek de ruïnes, geheime doorgangen en de ongerepte natuur van de Drôme."
    ]
  },
