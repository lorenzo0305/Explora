  "rdfs:comment": {
    "de": [
      "Kleines Familienhotel, 5 Zimmer, mit Restaurant, das eine große Auswahl an traditionellen und europäischen Rezepten anbietet. Bar mit toller Atmosphäre. 3 Sonnenterrassen im Sommer. In einigen Monaten außerhalb der Saison geöffnet."
    ],
    "en": [
      "Small family-run hotel, 5 rooms, with a restaurant offering a wide range of traditional and European recipes. Bar with a great atmosphere. 3 sunny terraces in summer. Open some months out of season."
    ],
    "it": [
      "Piccolo hotel a conduzione familiare, 5 camere, con ristorante che offre una vasta gamma di ricette tradizionali ed europee. Bar con un'ottima atmosfera. 3 terrazze soleggiate in estate. Aperto alcuni mesi fuori stagione."
    ],
    "fr": [
      "Petit hôtel familial, 5 chambres, avec restaurant proposant un large choix de recettes traditionnelles et européennes. Bar avec une super ambiance. 3 terrasses ensoleillées l'été. Ouvert certains mois hors saison."
    ],
    "es": [
      "Pequeño hotel familiar, 5 habitaciones, con restaurante que ofrece una amplia gama de recetas tradicionales y europeas. Bar con un gran ambiente. 3 terrazas soleadas en verano. Abierto algunos meses fuera de temporada."
    ],
    "nl": [
      "Klein familiehotel, 5 kamers, met een restaurant met een breed scala aan traditionele en Europese recepten. Bar met een geweldige sfeer. 3 zonnige terrassen in de zomer. Buiten het seizoen enkele maanden geopend."
    ]
  },
