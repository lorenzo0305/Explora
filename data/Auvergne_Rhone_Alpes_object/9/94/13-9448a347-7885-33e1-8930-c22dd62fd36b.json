  "rdfs:comment": {
    "de": [
      "Bald ist es soweit: Bulle Café eröffnet am 13. Dezember! Bereiten Sie Ihre Skier und Ihren Gaumen auf eine Saison voller Geschmackserlebnisse und Sensationen in Les Arcs vor. Treffen Sie uns im Herzen der Pisten, um einen einzigartigen Moment mit Meeresfrüchten, Pizzen, Tapas und Weinen zu teilen"
    ],
    "en": [
      "Bulle Café opening soon on December 13! Get your skis and taste buds ready for a season full of flavors and sensations in Les Arcs. Meet us at the heart of the slopes to share a unique moment, between seafood, pizzas, tapas and wines."
    ],
    "it": [
      "Il Bulle Café aprirà presto, il 13 dicembre! Preparate gli sci e le papille gustative per una stagione ricca di sapori e sensazioni a Les Arcs. Incontriamoci nel cuore delle piste per condividere un momento unico, con frutti di mare, pizze, tapas e vini"
    ],
    "fr": [
      "Bientôt l’ouverture de Bulle Café le 13 décembre ! Préparez vos skis et vos papilles pour une saison pleine de saveurs et de sensations aux Arcs. Retrouvez-nous au cœur des pistes pour partager un moment unique, entre fruits de mer, pizzas, tapas, et vins"
    ],
    "nl": [
      "Bulle Café opent binnenkort, op 13 december! Maak je ski's en je smaakpapillen klaar voor een seizoen vol smaken en sensaties in Les Arcs. Ontmoet ons in het hart van de pistes om een uniek moment te delen, met zeevruchten, pizza's, tapas en wijnen"
    ],
    "es": [
      "Bulle Café abre pronto, ¡el 13 de diciembre! Prepare sus esquís y su paladar para una temporada llena de sabores y sensaciones en Les Arcs. Reúnase con nosotros en el corazón de las pistas para compartir un momento único, con mariscos, pizzas, tapas y vinos"
    ]
  },
