  "rdfs:comment": {
    "de": [
      "Im Rahmen des Vichy-Vitalitätsprogramms bietet Vichy Rando kostenlose Schnupperkurse an: Mini Rando.\r\nInformationen und Anmeldung per Telefon."
    ],
    "en": [
      "As part of the Vichy Vitality program, Vichy Rando offers free discovery sessions: Mini Rando.\r\nInformation and registration by telephone."
    ],
    "it": [
      "Nell'ambito del programma Vichy Vitality, Vichy Rando propone delle sedute gratuite di scoperta: Mini Rando.\r\nInformazioni e iscrizioni telefoniche."
    ],
    "fr": [
      "Dans le cadre du programme Vichy Vitalité, Vichy Rando propose des séances gratuites de découverte :     Mini Rando.\r\nRenseignements et inscription par téléphone."
    ],
    "es": [
      "En el marco del programa Vichy Vitalidad, Vichy Rando propone sesiones gratuitas de descubrimiento: Mini Rando.\r\nInformación e inscripciones por teléfono."
    ],
    "nl": [
      "Als onderdeel van het Vichy Vitaliteitsprogramma biedt Vichy Rando gratis ontdeksessies aan: Mini Rando.\r\nInformatie en inschrijving per telefoon."
    ]
  },
