  "rdfs:comment": {
    "de": [
      "Dieses \"Enquête Game\", das von einem auf Randoland spezialisierten Dienstleister entwickelt wurde, ist ein investigatives Spiel, das auf einer Wanderung ab dem Ökomuseum der Moulin des Massons gespielt wird."
    ],
    "en": [
      "This investigative game, created by a specialist service provider, Randoland, is played while roaming from the Moulin des Massons ecomuseum."
    ],
    "it": [
      "Questo gioco investigativo, creato da un fornitore di servizi specializzato, Randoland, può essere giocato durante il percorso dall'Ecomuseo Moulin des Massons."
    ],
    "fr": [
      "Jeu d’investigation, cet « Enquête Game » créé par un prestataire spécialiste Randoland, se pratique en itinérance à partir de l’écomusée du Moulin des Massons."
    ],
    "es": [
      "Este juego de investigación, creado por un proveedor de servicios especializado, Randoland, puede jugarse mientras se recorre el Ecomuseo del Moulin des Massons."
    ],
    "nl": [
      "Dit onderzoeksspel, gemaakt door een gespecialiseerde dienstverlener, Randoland, kan worden gespeeld tijdens een zwerftocht door het ecomuseum Moulin des Massons."
    ]
  },
