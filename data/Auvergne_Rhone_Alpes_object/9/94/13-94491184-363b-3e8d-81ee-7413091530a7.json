  "rdfs:comment": {
    "de": [
      "Paroles de Récup'! das ist die Überzeugung, dass man Gegenständen ein zweites Leben geben kann, um sie zu dekorieren und nützlich zu machen, und das zu geringen Kosten für die Umwelt!"
    ],
    "en": [
      "Paroles de Récup'! is the conviction that you can give a second life to objects to make them decorative and useful at low cost to the environment!"
    ],
    "it": [
      "Paroles de Récup\"! è la convinzione che si possa dare una seconda vita agli oggetti per renderli decorativi e utili a basso costo per l'ambiente!"
    ],
    "fr": [
      "Paroles de Récup'! , c'est la conviction qu'on peut donner une seconde vie aux objets pour faire de la déco et de l'utile à faible coût pour l'environnement !"
    ],
    "es": [
      "¡Paroles de Récup'! es la convicción de que se puede dar una segunda vida a los objetos para hacerlos decorativos y útiles ¡a bajo coste para el medio ambiente!"
    ],
    "nl": [
      "Paroles de Récup'! is de overtuiging dat je voorwerpen een tweede leven kunt geven om ze decoratief en nuttig te maken tegen lage kosten voor het milieu!"
    ]
  },
