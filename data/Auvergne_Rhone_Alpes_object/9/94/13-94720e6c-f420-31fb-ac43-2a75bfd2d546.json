  "rdfs:comment": {
    "de": [
      "Entdecken Sie die spannende Geschichte der ersten weiblichen Punkband Englands, The Slits, den kleinen Schwestern der Sex Pistols und The Clash\r\nSie waren zu viert und kamen aus den unterschiedlichsten sozialen Schichten."
    ],
    "en": [
      "Discover the thrilling story of England?s first female punk band, The Slits, little sisters of the Sex Pistols and the Clash\r\nThere were four of them, from extremely diverse social backgrounds."
    ],
    "it": [
      "Scoprite l'avvincente storia della prima punk band femminile inglese, The Slits, sorelle minori dei Sex Pistols e dei Clash\r\nErano in quattro e provenivano da ambienti sociali estremamente diversi."
    ],
    "fr": [
      "Découvrez l’histoire palpitante du premier groupe de punk féminin anglais, The Slits, petites sœurs des Sex Pistols et des Clash\r\nElles étaient quatre et venaient d’univers sociaux extrêmement variés."
    ],
    "nl": [
      "Ontdek het aangrijpende verhaal van de eerste vrouwelijke punkband van Engeland, The Slits, kleine zusjes van de Sex Pistols en de Clash\r\nZe waren met z'n vieren en ze kwamen uit zeer verschillende sociale milieus."
    ],
    "es": [
      "Descubra la apasionante historia de la primera banda punk femenina de Inglaterra, The Slits, hermanas pequeñas de los Sex Pistols y los Clash\r\nEran cuatro y procedían de entornos sociales muy variados."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Spectacle Musical - PUNK.E.S"
    ]
  },
