  "rdfs:comment": {
    "de": [
      "Lust auf eine Feinschmeckerpause? Willkommen im Eismuseum, einer in Europa einzigartigen Eisdiele, in der Sie einen hausgemachten Eisbecher des Eisweltmeisters Rémi Montagne genießen können."
    ],
    "en": [
      "Fancy a gourmet break, welcome to the ice museum, a unique ice cream parlor in Europe where you can taste a homemade ice cream cup from world ice cream champion Rémi Montagne."
    ],
    "it": [
      "Se avete voglia di una pausa golosa, benvenuti al Musée de la Glace, una gelateria unica in Europa, dove potrete assaggiare una coppa di gelato fatto in casa dal campione mondiale di gelateria Rémi Montagne."
    ],
    "fr": [
      "Envie d'une pause gourmande, bienvenue au musée de la glace, un glacier unique en Europe où vous pourrez déguster une coupe de glace maison du champion du monde des glaces Rémi Montagne."
    ],
    "nl": [
      "Zin in een gastronomische pauze, welkom in het ijsmuseum, een unieke ijssalon in Europa waar je een huisgemaakte ijsbeker van wereldkampioen ijs Rémi Montagne kunt proeven."
    ],
    "es": [
      "Si le apetece una pausa gourmet, bienvenido al Musée de la Glace, una heladería única en Europa, donde podrá degustar una copa de helado artesanal del campeón mundial de heladería Rémi Montagne."
    ]
  },
