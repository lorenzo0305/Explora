  "rdfs:comment": {
    "de": [
      "Entdecken Sie die echte Pizza nach neapolitanischer Art im Herzen von Lyon im belebten Viertel Masséna, in der Nähe von Brotteaux, indem Sie die Pizzeria NO.900 Lyon Vitton betreten, die ein einzigartiges Erlebnis bietet, bei dem italienische Authentizität und Modernität aufeinandertreffen."
    ],
    "en": [
      "Discover authentic Neapolitan pizza in the heart of Lyon, in the lively Masséna district near Les Brotteaux, by visiting NO.900 Lyon Vitton pizzeria, which offers a unique experience combining Italian authenticity and modernity."
    ],
    "it": [
      "Scoprite la vera pizza alla napoletana nel cuore di Lione, nel vivace quartiere di Masséna, vicino ai Brotteaux, entrando nella pizzeria NO.900 Lyon Vitton, che offre un'esperienza unica in cui si incontrano l'autenticità italiana e la modernità."
    ],
    "fr": [
      "Découvrez la vraie pizza à la napolitaine au cœur de Lyon dans le quartier animé de Masséna, proche des Brotteaux, en entrant dans la pizzeria NO.900 Lyon Vitton qui propose une expérience unique où authenticité et modernité italiennes se rencontrent."
    ],
    "nl": [
      "Ontdek echte Napolitaanse pizza in het hart van Lyon, in de levendige wijk Masséna, dicht bij de Brotteaux, door binnen te lopen bij pizzeria NO.900 Lyon Vitton, die een unieke ervaring biedt waar Italiaanse authenticiteit en moderniteit elkaar ontmoeten."
    ],
    "es": [
      "Descubra la auténtica pizza a la napolitana en pleno centro de Lyon, en el animado barrio de Masséna, cerca de Brotteaux, entrando en la pizzería NO.900 Lyon Vitton, que le ofrece una experiencia única donde se dan cita la autenticidad italiana y la modernidad."
    ]
  },
