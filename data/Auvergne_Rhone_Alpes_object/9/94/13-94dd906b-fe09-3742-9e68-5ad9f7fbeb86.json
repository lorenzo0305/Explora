  "rdfs:comment": {
    "de": [
      "Die Vignerons d'Alba heißen Sie in ihrem Geschäft willkommen, um Ihnen ihre Arbeit und ihre Leidenschaft näherzubringen. Ein Team von Fachleuten wird Sie aufmerksam empfangen, damit Sie die Cuvées unseres Terroirs und diese emblematischen Rebsorten probieren können."
    ],
    "en": [
      "Visit the cooperative shop and see how Alba-la-Romaine’s passionate winegrowers work. Our team of professionals are ready waiting to give you a taste of their varied range of vintages, each one reflecting the characteristics of its own particular terroir and grape variety."
    ],
    "it": [
      "I Vignerons d'Alba vi danno il benvenuto nel loro negozio per scoprire il loro lavoro e la loro passione. Un team di professionisti vi accoglierà con attenzione per farvi degustare le annate della nostra terra e questi vitigni emblematici."
    ],
    "fr": [
      "Les Vignerons d’Alba vous accueillent dans leur boutique pour vous faire découvrir leur travail et leur passion. Une équipe de professionnels vous recevra avec attention pour vous faire déguster les cuvées de notre terroir et ces cépages emblématiques."
    ],
    "es": [
      "Los Vignerons d'Alba le dan la bienvenida a su tienda para descubrir su trabajo y su pasión. Un equipo de profesionales le acogerá con atención para que pueda degustar las cosechas de nuestra tierra y estas emblemáticas variedades de uva."
    ],
    "nl": [
      "De Vignerons d'Alba heten u welkom in hun winkel om hun werk en hun passie te ontdekken. Een team van professionals zal u met aandacht ontvangen om u de wijnen van ons land en deze emblematische druivenrassen te laten proeven."
    ]
  },
  "rdfs:label": {
    "en": [
      "Alba-La-Romaine wine cooperative"
    ],
    "fr": [
      "Caveau d'Alba"
    ]
  },
