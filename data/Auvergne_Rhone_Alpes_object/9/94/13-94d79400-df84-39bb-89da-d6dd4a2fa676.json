  "rdfs:comment": {
    "de": [
      "Entdecken oder wiederentdecken Sie Black Soil, eine Modern Hard Rock-Band aus Le Puy-en-Velay, bei einem Konzert in der Brasserie Motueka am Mittwoch, den 13. Mai ab 20 Uhr."
    ],
    "en": [
      "Come and discover or re-discover Black Soil, a Modern Hard Rock band from Le Puy-en-Velay, in concert at Brasserie Motueka on Wednesday May 13 from 8pm."
    ],
    "it": [
      "Venite a scoprire o a riscoprire i Black Soil, una band di Hard Rock moderno di Le Puy-en-Velay, in concerto alla Brasserie Motueka mercoledì 13 maggio dalle 20.00."
    ],
    "fr": [
      "Venez découvrir ou re-découvrir Black Soil, un groupe de Modern Hard Rock du Puy-en-Velay, en concert à la Brasserie Motueka le mercredi 13 mai à partir de 20h."
    ],
    "es": [
      "Venga a descubrir o redescubrir a Black Soil, grupo de Hard Rock moderno de Le Puy-en-Velay, en concierto en la Brasserie Motueka el miércoles 13 de mayo a partir de las 20:00 h."
    ],
    "nl": [
      "Kom Black Soil, een moderne hardrockband uit Le Puy-en-Velay, ontdekken of herontdekken tijdens een concert in Brasserie Motueka op woensdag 13 mei vanaf 20.00 uur."
    ]
  },
