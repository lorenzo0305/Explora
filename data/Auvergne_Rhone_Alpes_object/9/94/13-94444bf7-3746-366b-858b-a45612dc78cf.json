  "rdfs:comment": {
    "de": [
      "Das alte Dorf wird von der romanischen Kirche Saint-Marcel und den Ruinen des Schlosses dominiert. Es war von einer Stadtmauer umgeben, die von zwei Toren durchbrochen wurde. Heute gibt es noch die einzige Straße des außerhalb der Mauern gelegenen Dorfes mit einigen Überresten."
    ],
    "en": [
      "The old village is dominated by the Romanesque church Saint-Marcel and the ruins of the castle. It was surrounded by ramparts pierced by two doors. Today, it remains the unique street of the town located outside the walls with some vestiges."
    ],
    "it": [
      "Il borgo antico è dominato dalla chiesa romanica di Saint Marcel e dalle rovine del castello. Era circondata da bastioni con due porte. Oggi l'unica strada rimasta del villaggio si trova fuori dalle mura, con alcuni resti."
    ],
    "fr": [
      "Le vieux village est dominé par l'Eglise romane Saint-Marcel et les ruines du château. Il était entouré de remparts percés de deux portes. Aujourd'hui, il reste la rue unique du bourg situé à l'extérieur des murailles avec quelques vestiges."
    ],
    "nl": [
      "Het oude dorp wordt gedomineerd door de Romaanse kerk Saint-Marcel en de ruïnes van het kasteel. Het was omringd door vestingmuren met twee poorten. Vandaag de dag is de enige overgebleven straat in het dorp buiten de muren, met een paar overblijfselen."
    ],
    "es": [
      "El antiguo pueblo está dominado por la iglesia románica de San Marcel y las ruinas del castillo. Estaba rodeada de murallas con dos puertas. Hoy en día, la única calle del pueblo fuera de las murallas permanece, con algunos restos."
    ]
  },
