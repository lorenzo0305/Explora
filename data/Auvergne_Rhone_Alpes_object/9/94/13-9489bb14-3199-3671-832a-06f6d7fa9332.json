  "rdfs:comment": {
    "de": [
      "Wir bieten über 40 verschiedene Pizzasorten , Calzone und Lasagne an, die mindestens am Vortag für den nächsten Tag bestellt werden müssen.\r\nWir bieten auch Pizzableche für Veranstaltungen an."
    ],
    "en": [
      "We offer over 40 types of pizza, calzones and lasagne, ordered at least the day before for the following day.\r\nWe also offer pizza plates for events."
    ],
    "it": [
      "Offriamo oltre 40 tipi di pizza, calzoni e lasagne, ordinati almeno il giorno prima per il giorno successivo.\r\nOffriamo anche piatti di pizza per eventi."
    ],
    "fr": [
      "Nous proposons plus de 40 sortes de pizzas , des calzones, et des lasagnes sur commandes au moins la veille pour le lendemain.\r\nNous proposons également des plaques de pizza pour les événements."
    ],
    "nl": [
      "We bieden meer dan 40 soorten pizza, calzones en lasagne, ten minste de dag van tevoren besteld voor de volgende dag.\r\nWe bieden ook pizzaborden voor evenementen."
    ],
    "es": [
      "Ofrecemos más de 40 tipos de pizza, calzones y lasaña, encargados al menos el día anterior para el día siguiente.\r\nTambién ofrecemos platos de pizza para eventos."
    ]
