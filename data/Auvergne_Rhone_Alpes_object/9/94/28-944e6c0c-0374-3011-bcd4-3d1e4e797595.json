  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/68dc7269-879e-34bc-b1bd-e3d08e20d10d",
      "dc:description": {
        "de": [
          "Das Restaurant des Oliviers liegt im Herzen des Dorfes und bietet Ihnen schnelle Gerichte, die Sie vor Ort genießen oder mitnehmen können.\nGeöffnet von Dienstag bis Sonntag."
        ],
        "en": [
          "Located in the heart of the village, Restaurant des Oliviers offers fast food to eat in or take away.\nOpen Tuesday to Sunday."
        ],
        "it": [
          "Situato nel cuore del villaggio, il Restaurant des Oliviers offre piatti veloci da mangiare o da portare via.\nAperto da martedì a domenica."
        ],
        "fr": [
          "Situé au cœur du village, le Restaurant des Oliviers vous propose de la restauration rapide à déguster sur place ou à emporter. \nOuvert du mardi au dimanche."
        ],
        "es": [
          "Situado en el corazón del pueblo, el Restaurant des Oliviers ofrece comida rápida para comer en el restaurante o para llevar.\nAbierto de martes a domingo."
        ],
        "nl": [
          "Restaurant des Oliviers ligt in het hart van het dorp en biedt fastfood om te eten of mee te nemen.\nGeopend van dinsdag tot zondag."
        ]
      },
