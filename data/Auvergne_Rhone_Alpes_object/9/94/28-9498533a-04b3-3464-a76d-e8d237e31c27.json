  "rdfs:comment": {
    "de": [
      "Entdecken Sie die versteckte Terrasse dieses Estaminets im Herzen von Lille und probieren Sie die regionalen Spezialitäten.\n\nDas Restaurant ist in den folgenden Reiseführern verzeichnet: Guide du Routard, Lonely Planet, Le Ch'ti sowie in ausländischen Führern."
    ],
    "en": [
      "Come and discover the hidden terrace of this estaminet in the heart of Lille and enjoy regional specialties.\n\nRestaurant listed in the following guides: Guide du Routard, Lonely Planet, Le Ch'ti and foreign guidebooks."
    ],
    "it": [
      "Venite a scoprire la terrazza nascosta di questo estaminet nel cuore di Lille e assaggiate le specialità regionali.\n\nRistorante segnalato nelle seguenti guide: Guide du Routard, Lonely Planet, Le Ch'ti e guide straniere."
    ],
    "fr": [
      "Venez découvrir la terrasse cachée de cet estaminet en plein cœur de Lille et déguster les spécialités régionales.\n\nRestaurant référencé dans les guides suivants : Guide du Routard, Lonely Planet, Le Ch'ti ainsi que les guides étrangers."
    ],
    "es": [
      "Venga a descubrir la terraza escondida de este estaminet en pleno centro de Lille y deguste las especialidades regionales.\n\nRestaurante incluido en las siguientes guías: Guide du Routard, Lonely Planet, Le Ch'ti y guías extranjeras."
    ],
    "nl": [
      "Kom en ontdek het verborgen terras van dit estaminet in het hart van Lille en proef de regionale specialiteiten.\n\nRestaurant opgenomen in de volgende gidsen: Guide du Routard, Lonely Planet, Le Ch'ti en buitenlandse gidsen."
    ]
  },
