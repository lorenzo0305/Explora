  "rdfs:comment": {
    "de": [
      "Französische Mont-Blanc-Freiflugschule in Plaine-Joux. Es bietet viele Aktivitäten, um die Freuden des freien Fluges zu entdecken: Einführungs- und Verbesserungskurs, Bergflugkurs, Tandemtaufe in Passy."
    ],
    "en": [
      "Paragliding school located in Plaine-Joux. From introduction session to improvement courses and tandem flight Discovery flights in Passy as well as in the whole Mont-Blanc region."
    ],
    "it": [
      "La Scuola francese di volo libero del Monte Bianco si trova a Plaine-Joux. Offre un'ampia gamma di attività per scoprire le gioie del volo libero: corsi introduttivi e avanzati, voli in tandem a Passy."
    ],
    "fr": [
      "Ecole française de vol libre du Mont-Blanc située à Plaine-Joux. Elle propose de multiples activités pour découvrir les joies du vol libre : stage d'initiation et de perfectionnement, baptême biplace à Passy."
    ],
    "es": [
      "La Escuela Francesa de Vuelo Libre del Mont-Blanc se encuentra en Plaine-Joux. Ofrece una amplia gama de actividades para descubrir los placeres del vuelo libre: cursos de iniciación y perfeccionamiento, vuelos en tándem en Passy."
    ],
    "nl": [
      "De Mont-Blanc French Free Flight School is gevestigd in Plaine-Joux. Het biedt een breed scala aan activiteiten om het plezier van de vrije vlucht te ontdekken: cursussen voor beginners en gevorderden, tandemvluchten in Passy."
    ]
  },
