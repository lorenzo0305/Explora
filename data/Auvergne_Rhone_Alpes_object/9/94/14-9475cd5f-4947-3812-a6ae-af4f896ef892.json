  "rdfs:comment": {
    "de": [
      "Atmen Sie im Rhythmus der Werke von Caroline le Méhauté, lassen Sie sich von der Installation von Pinaffo-Pluvinage hypnotisieren oder tauchen Sie ein in die Werke von Clément Lesaffre?"
    ],
    "en": [
      "Breathe in the rhythm of Caroline le Méhauté?s work, let yourself be hypnotized by the installation by Pinaffo-Pluvinage or immerse yourself in the work of Clément Lesaffre?"
    ],
    "it": [
      "Respirate il ritmo dell'opera di Caroline le Méhauté, lasciatevi ipnotizzare dall'installazione di Pinaffo-Pluvinage o immergetevi nel lavoro di Clément Lesaffre?"
    ],
    "fr": [
      "Respirez au rythme de l’œuvre de Caroline le Méhauté, laissez-vous hypnotiser par l’installation de Pinaffo-Pluvinage ou plongez dans l’œuvre de Clément Lesaffre…"
    ],
    "es": [
      "Respire el ritmo de la obra de Caroline le Méhauté, déjese hipnotizar por la instalación de Pinaffo-Pluvinage o sumérjase en la obra de Clément Lesaffre?"
    ],
    "nl": [
      "Adem het ritme in van het werk van Caroline le Méhauté, laat je hypnotiseren door de installatie van Pinaffo-Pluvinage of dompel je onder in het werk van Clément Lesaffre?"
    ]
  },
