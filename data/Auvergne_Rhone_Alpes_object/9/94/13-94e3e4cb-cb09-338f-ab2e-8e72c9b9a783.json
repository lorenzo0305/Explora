  "rdfs:comment": {
    "de": [
      "Im Herzen von Saint-Christophe, nur wenige Schritte vom bewegenden Friedhof entfernt, auf dem die berühmten Bergführer von La Bérarde und Vénéon begraben sind, richtet sich das Museum an alle, die die Berge lieben."
    ],
    "en": [
      "Located in the centre of Saint-Christophe, just a stone's throw from the moving cemetery where the famous mountain guides from La Bérarde and the Vénéon are buried, the Museum is a must-see for all mountain lovers."
    ],
    "it": [
      "Nel cuore di Saint-Christophe, a due passi dal commovente cimitero dove sono sepolte le famose guide alpine di La Bérarde e Vénéon, il museo è dedicato a tutti gli amanti della montagna."
    ],
    "fr": [
      "Au cœur de Saint-Christophe, à deux pas de l’émouvant cimetière où sont enterrés les célèbres guides-montagnards de la Bérarde et du Vénéon, le musée s’adresse à tous les amoureux de la montagne."
    ],
    "es": [
      "En el corazón de Saint-Christophe, a dos pasos del conmovedor cementerio donde están enterrados los famosos guías de montaña de La Bérarde y Vénéon, el museo es para todos los amantes de la montaña."
    ],
    "nl": [
      "Dit museum ligt in het hartje van Saint-Christophe, op enkele stappen van het kerkhof waar de beroemde hooggebergtegidsen van La Bérarde en de Vénéon hun laatste rustplaats hebben. Het museum richt zich tot alle bergliefhebbers."
    ]
  },
  "rdfs:label": {
    "en": [
      "Museum \" mountaineering Memory\""
    ],
    "fr": [
      "Musée \"Mémoires d'Alpinismes\""
    ],
    "nl": [
      "Museum \"Mémoires d'Alpinismes\""
    ]
  },
