  "rdfs:comment": {
    "de": [
      "Verleih und Lieferung von Fahrrädern: elektrische VTCs, klassische VTCs, Mountainbikes, Juniorräder.\r\nLieferung inklusive bis zu 25 km von Grignan entfernt.\r\nEin lokaler und flexibler Service für Ihre Ausflüge in die Provence. Reservieren Sie online, telefonisch oder per E-Mail."
    ],
    "en": [
      "Bike rental and delivery: electric VTC, classic VTC, mountain bikes, junior bikes.\r\nDelivery included up to 25 km from Grignan.\r\nA local, flexible service for your rides in Provence. Book online, by phone or e-mail."
    ],
    "it": [
      "Noleggio e consegna di biciclette: mountain bike elettriche, mountain bike classiche, mountain bike, junior bike.\r\nConsegna inclusa fino a 25 km da Grignan.\r\nUn servizio locale e flessibile per le vostre gite in Provenza. Prenotate online, per telefono o per e-mail."
    ],
    "fr": [
      "Location et livraison de vélos : VTC électriques, VTC classiques, VTT, vélos juniors.\r\nLivraison incluse jusqu’à 25 km de Grignan.\r\nUn service local et flexible pour vos balades en Provence. Réservation en ligne, par téléphone ou par mail."
    ],
    "nl": [
      "Verhuur en levering van fietsen: elektrische mountainbikes, klassieke mountainbikes, mountainbikes, juniorfietsen.\r\nLevering inbegrepen tot 25 km van Grignan.\r\nEen lokale, flexibele service voor uw uitstapjes in de Provence. Reserveer online, per telefoon of per e-mail."
    ],
    "es": [
      "Alquiler y entrega de bicicletas: bicicletas de montaña eléctricas, bicicletas de montaña clásicas, bicicletas de montaña, bicicletas junior.\r\nEntrega incluida hasta 25 km de Grignan.\r\nUn servicio local y flexible para sus salidas en Provenza. Reserve en línea, por teléfono o por correo electrónico."
    ]
  },
