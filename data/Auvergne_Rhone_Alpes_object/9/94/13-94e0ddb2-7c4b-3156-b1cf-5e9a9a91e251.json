  "rdfs:comment": {
    "de": [
      "Getreideanbau, Herstellung von Mehl, Produktion von Sauerteigbrot, das über dem Holzfeuer gebacken wird.....\r\nEmpfang auf dem Bauernhof mit dem Verein Bionheur en herbe (Imbiss auf dem Bauernhof, halbtägige Animationen, Praktika und Ausbildungen)"
    ],
    "en": [
      "Cultivation of cereals, production of flour, production of sourdough bread cooked in a wood fire....\r\nWelcome at the farm with the association Bionheur en herbe (snacks at the farm, half-day activities, training courses)"
    ],
    "it": [
      "Coltivazione di cereali, produzione di farina, produzione di pane a lievitazione naturale cotto in un camino a legna....\r\nAccoglienza in fattoria con l'associazione Bionheur en herbe (merende in fattoria, eventi di mezza giornata, corsi di formazione)"
    ],
    "fr": [
      "Cultures de céréales, fabrication de farine, production de pain au levain cuit au feu de bois....\r\nAccueil à la ferme avec l'association Bionheur en herbe (goûter à la ferme, animations à la demi-journée, stages et formations)"
    ],
    "nl": [
      "Graanteelt, meelproductie, productie van zuurdesembrood gekookt in een houtvuur....\r\nWelkom op de boerderij met de vereniging Bionheur en herbe (hapjes op de boerderij, evenementen van een halve dag, opleidingen)"
    ],
    "es": [
      "Cultivo de cereales, fabricación de harina, producción de pan de masa madre cocido en fuego de leña....\r\nBienvenida a la granja con la asociación Bionheur en herbe (aperitivos en la granja, medias jornadas, cursos de formación)"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ferme  les Fromentaux"
    ]
  },
