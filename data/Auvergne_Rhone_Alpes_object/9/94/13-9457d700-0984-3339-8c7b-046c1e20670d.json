  "rdfs:comment": {
    "de": [
      "Ein Empfang mit saisonalen Menüs zu verschiedenen Preisen, à la carte, Pizzas und Spezialitäten aus Savoyen. Gegrilltes Fleisch und Pizzas zum Mitnehmen."
    ],
    "en": [
      "A reception organized around at various prices seasons menus, input board , salads , entrees and desserts , local specialties . Grilled meat over a wood fire in the summer on some days , various pizzas in the winter and summer seasons . Takeaway pizza in winter and summer season."
    ],
    "it": [
      "Accoglienza organizzata con menù stagionali a prezzi diversi, à la carte, pizze e specialità savoiarde. Carni alla griglia e pizze da asporto."
    ],
    "fr": [
      "Un accueil organisé autour de menus de saisons à prix variés, à la carte, pizzas et spécialités savoyardes. Viandes grillés et pizzas à emporter."
    ],
    "es": [
      "Una acogida organizada en torno a menús de temporada a distintos precios, a la carta, pizzas y especialidades saboyanas. Carnes a la brasa y pizzas para llevar."
    ],
    "nl": [
      "Onthaal georganiseerd rond seizoensmenu's tegen gevarieerde prijzen, à la carte, pizza's en Savoyaardse specialiteiten. Gegrild vlees en pizza's om mee te nemen."
    ]
  },
