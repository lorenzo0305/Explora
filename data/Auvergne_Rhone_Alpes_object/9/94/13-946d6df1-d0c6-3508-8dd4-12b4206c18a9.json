  "rdfs:comment": {
    "de": [
      "La Robe Rouge, das Restaurant von Chefkoch Thomas Guignier, liegt im Herzen der Weinberge des Beaujolais. Alle zwei Wochen bietet er ein kreatives und raffiniertes Menü an, bei dem die Pflanzenwelt im Vordergrund steht und das durch die Kombination von Speisen und Weinen verfeinert wird. Das Ganze mit Blick auf die Weinberge."
    ],
    "en": [
      "La Robe Rouge, the restaurant of the Chef Thomas Guignier, is nestled in the heart of the Beaujolais vineyards. Every two weeks, the chef offers a creative and refined menu, highlighting plant-based cuisine and enhanced by carefully selected food and wine pairings, all with a view over the vines."
    ],
    "it": [
      "La Robe Rouge, il ristorante dello chef Thomas Guignier, è immerso nel cuore dei vigneti del Beaujolais. Ogni quindici giorni, lo chef propone un menu creativo e raffinato, che mette in risalto le piante e viene sublimato da abbinamenti enogastronomici. Il tutto con vista sulle vigne."
    ],
    "fr": [
      "La Robe Rouge, restaurant du Chef Thomas Guignier, est niché au coeur du vignoble du Beaujolais. Tous les quinze jours, il propose un menu créatif et raffiné, mettant en valeur le végétal et sublimé par des accords mets et vins. Le tout, face aux vignes."
    ],
    "nl": [
      "La Robe Rouge, het restaurant van chef-kok Thomas Guignier, ligt in het hart van de wijngaarden van de Beaujolais. Om de twee weken stelt hij een creatief en verfijnd menu voor, met de nadruk op planten en gesublimeerd door combinaties van eten en wijn. Dit alles met uitzicht op de wijngaarden."
    ],
    "es": [
      "La Robe Rouge, el restaurante del Chef Thomas Guignier, está enclavado en el corazón de los viñedos del Beaujolais. Cada quince días, propone un menú creativo y refinado, destacando las plantas y sublimado por maridajes. Todo ello con vistas a los viñedos."
    ]
  },
