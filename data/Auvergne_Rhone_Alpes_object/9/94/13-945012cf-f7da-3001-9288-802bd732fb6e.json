  "rdfs:comment": {
    "de": [
      "Das Ziel des Vereins Commune Libre du Sert ist es, Spenden zu sammeln, um Veranstaltungen zu organisieren, die den Bewohnern des Viertels zugutekommen. Ihr zweites Ziel ist es, die Folklore der Region durch die Organisation verschiedener Feste wiederzubeleben."
    ],
    "en": [
      "The Commune Libre du Sert association aims to collect donations in order to organize events for the benefit of local residents. Their second aim is to revive local folklore by organizing various festivals."
    ],
    "it": [
      "L'associazione Commune Libre du Sert si propone di raccogliere donazioni per organizzare eventi a beneficio dei residenti locali. Il loro secondo obiettivo è quello di far rivivere il folklore locale organizzando varie feste."
    ],
    "fr": [
      "L'association Commune Libre du Sert a pour objectif de collecter des dons afin d'organiser des événements au bénéfice des habitants du quartier. Leur second objectif est de faire revivre le folklore de la région par l'organisation de fêtes diverses."
    ],
    "es": [
      "La asociación Commune Libre du Sert tiene como objetivo recaudar donativos para organizar actos en beneficio de los vecinos. Su segundo objetivo es revivir el folclore local organizando diversos festivales."
    ],
    "nl": [
      "De vereniging Commune Libre du Sert heeft als doel donaties in te zamelen om evenementen te organiseren ten behoeve van de plaatselijke bewoners. Hun tweede doel is om de lokale folklore nieuw leven in te blazen door verschillende festivals te organiseren."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Association Commune Libre du Sert"
    ]
  },
