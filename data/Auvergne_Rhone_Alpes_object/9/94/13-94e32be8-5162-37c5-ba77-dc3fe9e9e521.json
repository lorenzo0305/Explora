  "rdfs:comment": {
    "de": [
      "Genießen Sie unseren Innenbereich mit 14 Sitzplätzen oder setzen Sie sich in der warmen Jahreszeit auf die Terrasse mit bis zu 60 Außenplätzen, um unsere Gerichte in einem gemütlichen Rahmen zu genießen.\r\n\r\nEin Menü pro Tag, das von Claude vorgeschlagen wird."
    ],
    "en": [
      "Enjoy our 14-cover indoor dining room, or sit out on the terrace in summer, with up to 60 outdoor seats, to savor our dishes in a warm and welcoming setting.\r\n\r\nClaude proposes a daily menu."
    ],
    "it": [
      "Godetevi la nostra sala da pranzo interna da 14 posti o, nella bella stagione, sedetevi sulla terrazza con 60 posti a sedere all'aperto per assaporare i nostri piatti in un ambiente caldo e accogliente.\r\n\r\nClaude propone un menu giornaliero."
    ],
    "fr": [
      "Profitez de notre salle intérieure de 14 couverts, ou installez-vous en terrasse à la belle saison, avec jusqu’à 60 places extérieures pour savourer nos plats dans un cadre chaleureux.\r\n\r\nUn menu par jour proposé par Claude."
    ],
    "nl": [
      "Geniet van onze eetzaal met 14 zitplaatsen binnen, of ga bij mooi weer op het terras zitten, met tot 60 zitplaatsen buiten, om van onze gerechten te genieten in een warme en gastvrije omgeving.\r\n\r\nClaude stelt een dagmenu voor."
    ],
    "es": [
      "Disfrute de nuestro comedor interior de 14 plazas, o siéntese en la terraza cuando haga buen tiempo, con hasta 60 plazas al aire libre, para saborear nuestros platos en un ambiente cálido y acogedor.\r\n\r\nClaude le propone un menú diario."
    ]
  },
  "rdfs:label": {
    "en": [
