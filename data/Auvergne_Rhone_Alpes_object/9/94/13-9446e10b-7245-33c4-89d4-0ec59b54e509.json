  "rdfs:comment": {
    "de": [
      "Kunst- und Kunsthandwerksladen im Stadtzentrum von Crest. Lampenschirme, Stofftaschen, Täschchen, Lampen, Töpferwaren, personalisierte Schallplatten, Girlanden, einige Kinderkleider - ein Ort, der voller sympathischer Fundstücke steckt."
    ],
    "en": [
      "Arts and crafts boutique in downtown Crest. Lampshades, fabric bags, clutches and lamps sit side by side with pottery, personalized vinyl records, garlands and a few items of children's clothing - a place brimming with delightful finds."
    ],
    "it": [
      "Negozio di arte e artigianato nel centro di Crest. Paralumi, borse di stoffa, sacchetti, lampade, ceramiche, dischi in vinile personalizzati, ghirlande, alcuni vestiti per bambini, un luogo pieno di belle scoperte."
    ],
    "fr": [
      "Boutique d’art et d’artisanat dans le centre ville de Crest. Abat-jours, sacs en tissus, pochettes, lampes voisinent avec poteries, disques vinyle personnalisés,  guirlandes, quelques vêtements pour enfants, un lieu qui regorge de sympathique trouvailles."
    ],
    "es": [
      "Tienda de arte y artesanía en el centro de Crest. Pantallas, bolsas de tela, bolsas, lámparas, cerámica, discos de vinilo personalizados, guirnaldas, algo de ropa para niños, un lugar lleno de bonitos hallazgos."
    ],
    "nl": [
      "Kunstnijverheidswinkel in het centrum van Crest. Lampenkappen, stoffen tassen, zakjes en lampen staan zij aan zij met aardewerk, gepersonaliseerde vinylplaten, slingers en een paar kinderkledingstukken. Het is een plek vol heerlijke vondsten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Petites Mains"
    ]
  },
