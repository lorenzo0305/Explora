  "rdfs:comment": {
    "de": [
      "Restaurant - Bar - Terrasse\r\nGastronomie: reunionesische, exotische und traditionelle Küche. Möglichkeit, etwas zum Mitnehmen zu machen.\r\nFrühstücksservice (auch ohne im Hotel zu übernachten)."
    ],
    "en": [
      "Restaurant - bar - terrace\r\nRestaurant: Reunion cuisine, exotic and traditional. Possibility of take-away. \r\nBreakfast service (even without sleeping in the hotel)."
    ],
    "it": [
      "Ristorante - bar - terrazza\r\nRistorazione: cucina riunionese, esotica e tradizionale. Servizio d'asporto disponibile.\r\nServizio di prima colazione (anche se non soggiornate in hotel)."
    ],
    "fr": [
      "Restaurant - bar - terrasse\r\nLa restauration : cuisine Réunionnaise, exotique et traditionnelle. Possibilité de faire à emporter. \r\nService petit déjeuner (même sans dormir à l'hôtel)."
    ],
    "es": [
      "Restaurante - bar - terraza\r\nRestauración: cocina de La Reunión, exótica y tradicional. Servicio de comida para llevar.\r\nServicio de desayuno (incluso si no se aloja en el hotel)."
    ],
    "nl": [
      "Restaurant - bar - terras\r\nCatering: Reunionese, exotische en traditionele keuken. Afhaalservice beschikbaar.\r\nOntbijtservice (ook als je niet in het hotel verblijft)."
    ]
  },
