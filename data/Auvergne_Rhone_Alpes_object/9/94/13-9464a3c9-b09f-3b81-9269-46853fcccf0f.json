  "rdfs:comment": {
    "de": [
      "Die Auberge des Myrtilles, ein renovierter ehemaliger Bauernhof am Waldrand, bietet Ihnen eine Auszeit in der Natur im Herzen der Hochebenen der Auvergne. Authentizität, Gelassenheit und frische Luft: eine Oase der Ruhe, in der Tradition und Komfort zu Ihrem Wohlbefinden zusammenkommen."
    ],
    "en": [
      "A renovated former farmhouse on the edge of a forest, the Auberge des Myrtilles offers a natural interlude in the heart of the Auvergne plateaux. Authenticity, serenity and fresh air: a haven of peace where tradition and comfort come together for your well-being."
    ],
    "it": [
      "Un'antica casa colonica ristrutturata ai margini di una foresta, l'Auberge des Myrtilles offre una parentesi naturale nel cuore degli altopiani dell'Alvernia. Autenticità, serenità e aria fresca: un'oasi di pace dove tradizione e comfort si fondono per il vostro benessere."
    ],
    "fr": [
      "Ancienne ferme rénovée en lisière de forêt, l'Auberge des Myrtilles vous offre une parenthèse nature au coeur des plateaux auvergnats. Authenticité, sérénité et grand air : un havre de paix où tradition et confort se rejoignent pour votre bien-être."
    ],
    "es": [
      "El Auberge des Myrtilles, una antigua granja restaurada en la linde de un bosque, ofrece un paréntesis natural en el corazón de las mesetas de Auvernia. Autenticidad, serenidad y aire puro: un remanso de paz donde tradición y confort se unen para su bienestar."
    ],
    "nl": [
      "De Auberge des Myrtilles, een gerenoveerde voormalige boerderij aan de rand van een bos, biedt een natuurlijk intermezzo in het hart van de hoogvlakten van de Auvergne. Authenticiteit, sereniteit en frisse lucht: een oase van rust waar traditie en comfort samenkomen voor uw welzijn."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Auberge des Myrtilles"
    ]
  },
