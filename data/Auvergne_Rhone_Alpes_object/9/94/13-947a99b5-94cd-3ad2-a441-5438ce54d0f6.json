  "rdfs:comment": {
    "de": [
      "Die Auberge des 7 merveilles ist das traditionelle Restaurant, in dem man essen, trinken und sich amüsieren kann. Unsere Speisekarte umfasst hausgemachte Gerichte, die mit frischen, lokalen Zutaten zubereitet werden, um Ihren Gaumen zu erfreuen und zu überraschen."
    ],
    "en": [
      "L'auberge des 7 merveilles is the traditional restaurant where to eat, drink and be entertained. Our menu includes homemade dishes made with fresh, local ingredients to delight and amaze your taste buds."
    ],
    "it": [
      "Il 7 Wonders Inn è il ristorante tradizionale per mangiare, bere e divertirsi. Il nostro menu comprende piatti fatti in casa con ingredienti freschi e locali per deliziare e stupire il vostro palato."
    ],
    "fr": [
      "L'auberge des 7 merveilles est le restaurant traditionnel où manger, boire et se divertir. Notre carte comprend des plats maison réalisés avec des ingrédients frais, et locaux pour le plus grand plaisir et l'étonnement de vos papilles."
    ],
    "es": [
      "El 7 Wonders Inn es el restaurante tradicional para comer, beber y entretenerse. Nuestro menú incluye platos caseros elaborados con ingredientes frescos y locales para deleitar y sorprender a su paladar."
    ],
    "nl": [
      "De 7 Wonders Inn is het traditionele restaurant voor eten, drinken en vermaak. Op ons menu staan huisgemaakte gerechten met verse, lokale ingrediënten om uw smaakpapillen te verrukken en te verbazen."
    ]
  },
