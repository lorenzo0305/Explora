  "rdfs:comment": {
    "de": [
      "Genießen Sie die freundliche Atmosphäre am Kamin oder um die Braseros herum auf der Terrasse im Stadtzentrum.\r\nGroße Auswahl an Bieren, Cocktails und anderen Getränken, um einen schönen Abend in Les 2 alpes zu verbringen!"
    ],
    "en": [
      "Enjoy the friendly atmosphere around the fireplace or around the braziers on the terrace right in the centre of town.\r\nGreat choice of craft beers, cocktails and more to share a great evening in Les 2 Alpes!"
    ],
    "it": [
      "Godetevi un'atmosfera amichevole intorno al camino o ai bracieri della terrazza, proprio nel centro della città.\r\nGrande scelta di birre artigianali, cocktail e altro ancora per condividere una grande serata a Les 2 Alpes!"
    ],
    "fr": [
      "Profitez d'une amicale atmosphère autour de la cheminée ou autour des braseros sur la terrasse en plein centre ville.\r\nGrand choix de crafts bières, des cocktails et autres pour partager une bonne soirée aux 2 alpes !"
    ],
    "nl": [
      "Geniet van een gezellige sfeer rond de open haard of rond de vuurpotten op het terras midden in het centrum.\r\nGrote keuze aan ambachtelijke bieren, cocktails en meer om een geweldige avond in Les 2 Alpes te delen!"
    ],
    "es": [
      "Disfrute de un ambiente agradable alrededor de la chimenea o alrededor de los braseros en la terraza, en pleno centro de la ciudad.\r\n¡Gran selección de cervezas artesanales, cócteles y mucho más para compartir una gran velada en Les 2 Alpes!"
    ]
  },
