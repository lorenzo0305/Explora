  "rdfs:comment": {
    "de": [
      "Als Handwerksbäcker bietet Mathéo Chastel hochwertiges Brot und Gebäck an. Alle Rohstoffe stammen von lokalen Erzeugern und aus biologischem Anbau"
    ],
    "en": [
      "Craft production of organic Viennoiseries, cakes and pastries and savoury products in a kitchen workshop opening out into the shop."
    ],
    "it": [
      "Mathéo Chastel è un panettiere artigianale che offre pane e pasticceria viennese di qualità. Tutte le materie prime provengono da produttori locali e da agricoltura biologica"
    ],
    "fr": [
      "Artisan boulanger, Mathéo Chastel propose du pain et des viennoiseries de qualité. Toutes les matières premières sont issues de producteurs locaux et de l'agriculture biologique"
    ],
    "es": [
      "Mathéo Chastel es un panadero artesano que ofrece pan y bollería vienesa de calidad. Todas las materias primas proceden de productores locales y de la agricultura ecológica"
    ],
    "nl": [
      "Ambachtelijke vervaardiging van biologische viennoiseries, pâtisserie en hartige hapjes in een werkplaats die grenst aan de winkel."
    ]
  },
  "rdfs:label": {
