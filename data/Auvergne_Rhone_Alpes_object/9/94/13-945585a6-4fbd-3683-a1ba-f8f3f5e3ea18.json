  "rdfs:comment": {
    "de": [
      "Städtisches Museum: Reise in die Geschichte und das lokale Erbe. Seine reichen Sammlungen machen es auch zu einem Museum in Frankreich.\r\nPersönlicher Empfang, freie oder geführte Besichtigungen, regelmäßig geplante spielerische und interaktive Animationen für die Jüngsten."
    ],
    "en": [
      "Municipal Museum : history and local heritage. Its rich collections also make it a museum of France.\r\nPersonalized welcome, free or guided tours, fun and interactive activities for young people scheduled regularly."
    ],
    "it": [
      "Museo municipale: un viaggio nella storia e nel patrimonio locale. Le sue ricche collezioni lo rendono anche un Musée de France. Accoglienza personalizzata, visite guidate o autoguidate e attività ludiche e interattive regolarmente programmate per i visitatori più giovani."
    ],
    "fr": [
      "Musée municipal : voyage dans l'histoire et le patrimoine local. Ses riches collections en font aussi un musée de France. Accueil personnalisé, visites libres ou guidées, animations ludiques et interactives pour les plus jeunes programmées régulièrement."
    ],
    "es": [
      "Museo municipal: un recorrido por la historia y el patrimonio locales. Sus ricas colecciones lo convierten también en Museo de Francia. Acogida personalizada, visitas autoguiadas o guiadas y actividades lúdicas e interactivas programadas regularmente para los más jóvenes."
    ],
    "nl": [
      "Gemeentelijk museum: een reis door de plaatselijke geschiedenis en het erfgoed. De rijke collecties maken het ook tot een Musée de France. Een persoonlijk onthaal, rondleidingen op eigen gelegenheid of met een gids, en regelmatig geplande leuke en interactieve activiteiten voor jongere bezoekers."
    ]
  },
  "rdfs:label": {
    "en": [
      "Thônes heritage museum"
    ],
    "fr": [
      "Musée Patrimonial du Pays de Thônes - Fondateurs : François et Lucien Cochat"
    ]
  },
