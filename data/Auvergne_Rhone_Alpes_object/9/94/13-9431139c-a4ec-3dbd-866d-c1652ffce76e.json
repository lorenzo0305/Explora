  "rdfs:comment": {
    "de": [
      "Der Gittaz-Stausee, der nicht weit vom Roselend-Stausee entfernt ist, ist kleiner als dieser. Das hindert ihn jedoch nicht daran, sich mit Regenbogenforellen und Saiblingen zu überhäufen."
    ],
    "en": [
      "The Gittaz reservoir, not far from the Roselend reservoir, is smaller than the latter. That doesn't prevent it from teeming with rainbow trout and Arctic char."
    ],
    "it": [
      "Il lago artificiale di Gittaz, non lontano da quello di Roselend, è più piccolo di quest'ultimo. Ciò non impedisce che pulluli di trote iridee e salmerini alpini."
    ],
    "fr": [
      "La retenue de la Gittaz, non loin de celle de Roselend, est plus petite que cette dernière. Cela ne l'empêche pas de regorger de truites arc-en-ciel et d'ombles chevalier."
    ],
    "nl": [
      "Het Gittaz stuwmeer, niet ver van het Roselend stuwmeer, is kleiner dan het laatstgenoemde. Dit belet niet dat het er wemelt van de regenboogforellen en ridderforellen."
    ],
    "es": [
      "El embalse de Gittaz, no lejos del de Roselend, es más pequeño que este último. Esto no impide que esté repleto de truchas arco iris y salvelinos árticos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La retenue de la Gittaz"
    ]
  },
