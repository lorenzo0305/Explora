  "rdfs:comment": {
    "de": [
      "Verein zur Verteidigung der provenzalischen Sprache.\r\nLesung von provenzalischen Texten.\r\nÜbersetzung Provenzalisch-Französisch und Französisch-Provenzalisch.\r\nRegelmäßige Treffen auf Einladung (Ort je nach Verfügbarkeit der Gemeinderäume)"
    ],
    "en": [
      "Association for the defense of the Provençal language.\r\nReading of Provençal texts\r\nProvençal-French and French-Provençal translation\r\nRegular meetings by invitation (venue subject to availability of community halls)."
    ],
    "it": [
      "Associazione per la difesa della lingua provenzale.\r\nLettura di testi provenzali\r\nTraduzione dal provenzale al francese e dal francese al provenzale\r\nRiunioni periodiche su invito (la sede dipende dalla disponibilità delle sale locali)"
    ],
    "fr": [
      "Association pour la défense de la langue provençale.\r\nLecture de textes provençaux\r\nTraduction provençal-français et français-provençal\r\nRéunions régulières sur invitation (lieu en fonction des disponibilités des salles communales)"
    ],
    "nl": [
      "Vereniging voor de verdediging van de Provençaalse taal.\r\nLezen van Provençaalse teksten\r\nVertaling Provençaals-Frans en Frans-Provençaals\r\nRegelmatige bijeenkomsten op uitnodiging (plaats afhankelijk van beschikbaarheid gemeenschapszalen)"
    ],
    "es": [
      "Asociación para la defensa de la lengua provenzal.\r\nLectura de textos provenzales\r\nTraducción del provenzal al francés y del francés al provenzal\r\nReuniones periódicas por invitación (el lugar de celebración depende de la disponibilidad de las salas locales)"
    ]
  },
  "rdfs:label": {
