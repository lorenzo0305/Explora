  "rdfs:comment": {
    "de": [
      "In einem freundlichen industriellen Retro-Rahmen können Sie hier Bagels und amerikanisches Gebäck genießen. Unser Geheimnis: hausgemacht mit frischen Produkten! Sie werden von einem herzlichen und dynamischen Team empfangen."
    ],
    "en": [
      "In a friendly retro industrial setting, come and enjoy bagels and American pastries. Our secret: homemade with fresh products! You will be welcomed by a warm and dynamic team."
    ],
    "it": [
      "In un accogliente ambiente industriale retrò, venite a gustare bagel e dolci americani. Il nostro segreto: fatto in casa con prodotti freschi! Sarete accolti da un team caloroso e dinamico."
    ],
    "fr": [
      "Dans un cadre rétro industriel convivial, venez savourer bagels et pâtisseries américaines. Notre secret : du fait maison avec des produits frais ! Vous serez accueillis par une équipe chaleureuse et dynamique."
    ],
    "nl": [
      "In een gezellig retro-industrieel kader kunt u genieten van bagels en Amerikaans gebak. Ons geheim: zelfgemaakt met verse producten! U wordt ontvangen door een warm en dynamisch team."
    ],
    "es": [
      "En un acogedor entorno industrial retro, venga a disfrutar de bagels y bollería americana. Nuestro secreto: ¡hacerlo en casa con productos frescos! Será recibido por un equipo cálido y dinámico."
    ]
  },
  "rdfs:label": {
    "en": [
      "Instant Rétro - Bagel restaurant"
    ],
    "fr": [
      "Instant Rétro"
    ]
  },
