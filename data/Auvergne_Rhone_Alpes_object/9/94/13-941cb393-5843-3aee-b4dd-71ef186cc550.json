  "rdfs:comment": {
    "de": [
      "Zugang zum Internet-Cybercafé. Informatik: Installation, Fehlerbehebung, Verkauf von Hardware. Erstellung von Internetseiten. Kopien in Farbe. Versenden von Faxen. Alle Computerarbeiten: Retuschieren und Drucken von Fotos, Scannen, Erstellen von Dokumenten."
    ],
    "en": [
      "Internet access-Cybercafé. IT: installation, troubleshooting, hardware sales. Website creation. Color copying. Sending faxes. All computer work: photo retouching and printing, scanning, document creation."
    ],
    "it": [
      "Accesso a Internet - Cybercafé. Informatica: installazione, risoluzione di problemi, vendita di hardware. Creazione di siti web. Copiatura a colori. Invio di fax. Tutti i lavori al computer: fotoritocco e stampa, scansione, creazione di documenti."
    ],
    "fr": [
      "Accès Internet-Cybercafé. Informatique : installation, dépannage, vente de matériel. Création sites Internet. Copies couleurs. Envoi de fax. Tous travaux informatiques : retouche et impression photos, numérisation, création de document."
    ],
    "nl": [
      "Internettoegang - Cybercafé. IT: installatie, reparatie, verkoop van hardware. Maken van website. Kopiëren in kleur. Faxen versturen. Alle computerwerkzaamheden: foto's retoucheren en afdrukken, scannen, documenten maken."
    ],
    "es": [
      "Acceso a Internet - Cibercafé. Informática: instalación, resolución de problemas, venta de hardware. Creación de páginas web. Copias en color. Envío de faxes. Todos los trabajos informáticos: retoque e impresión de fotos, escaneado, creación de documentos."
    ]
  },
