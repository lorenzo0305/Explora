  "rdfs:comment": {
    "de": [
      "Ethologie (zertifizierte Happy Horse-Instruktorin von Linda Parelli): Einzel- , Gruppen- und Praktikumsunterricht, Pferdepension-Arbeitsplatz\r\nSpaziergänge und Ausritte von 1 Stunde bis 1 Woche\r\nKurse für alle Niveaus , alle Altersgruppen\r\nKinderkurse während der Schulferien"
    ],
    "en": [
      "Ethology (certified Happy Horse instructor by Linda Parelli): private lessons, group lessons and training courses, boarding and working with horses\r\nRides and trail rides from 1 hour to 1 week\r\nLessons for all levels and ages\r\nChildren's courses during school vacations"
    ],
    "it": [
      "Etologia (istruttore certificato Happy Horse da Linda Parelli): lezioni private, lezioni e corsi di gruppo, pensione e lavoro del cavallo\r\nPasseggiate e cavalcate da 1 ora a 1 settimana\r\nLezioni per tutti i livelli e le età\r\nCorsi per bambini durante le vacanze scolastiche"
    ],
    "fr": [
      "Ethologie (instructrice certifiée Happy Horse par Linda Parelli) : cours particuliers , collectifs et stages, pension-travail du cheval\r\nPromenades et randonnées de 1h à 1 semaine\r\nCours tous niveaux , tous âges\r\nStages enfants pendant les vacances scolaires"
    ],
    "es": [
      "Etología (instructora certificada Happy Horse por Linda Parelli): clases particulares, clases y cursos en grupo, pupilaje y trabajo del caballo\r\nPaseos y cabalgatas de 1 hora a 1 semana\r\nClases para todos los niveles y edades\r\nCursos para niños durante las vacaciones escolares"
    ],
    "nl": [
      "Ethologie (gecertificeerd Happy Horse-instructeur door Linda Parelli): privélessen, groepslessen en cursussen, pensionstalling en werken met het paard\r\nWandelingen en ritten van 1 uur tot 1 week\r\nLessen voor alle niveaus en leeftijden\r\nKindercursussen tijdens de schoolvakanties"
    ]
  },
