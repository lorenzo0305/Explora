  "rdfs:comment": {
    "de": [
      "Le Pont de Champ ist ein familiengeführtes Hotel und Restaurant: geräumige und helle Räume, einzigartiges Panorama auf die Bergmassive Vercors und Chartreuse. Genießen Sie die Spezialitäten des Küchenchefs: Gänseleberpastete, Ravioli, Kalbskopf, Froschschenkel."
    ],
    "en": [
      "The Pont de Champ is a family run restaurant  with large and bright restaurant rooms boasting panoramic views over the Vercors and the Chartreuse mountain ranges. You will enjoy the chef's specialities such as foie gras, ravioles (local cheesy raviolis), fondues, entrecote with St Marcellin cheese."
    ],
    "it": [
      "Le Pont de Champ è un hotel-ristorante a conduzione familiare con camere ampie e luminose e una vista panoramica unica sulle catene montuose del Vercors e della Chartreuse. Assaggiate le specialità dello chef: foie gras, ravioles, testa di vitello, cosce di rana."
    ],
    "fr": [
      "Le Pont de Champ est un hôtel restaurant familial : salles spacieuses et lumineuses, panorama unique sur les massifs du Vercors et de la Chartreuse. Vous pourrez savourer les spécialités du chef :  foie gras, ravioles, tête de veau, cuisses de grenouille."
    ],
    "nl": [
      "Le Pont de Champ is een familierestaurant met ruime, lichte kamers en een uniek panoramisch uitzicht op de Vercors en de Chartreuse. Geniet van de specialiteiten van de chef: foie gras, ravioli, kalfskop en kikkerbilletjes."
    ],
    "es": [
      "Le Pont de Champ es un hotel-restaurante familiar con habitaciones amplias y luminosas y una vista panorámica única de las cordilleras de Vercors y Chartreuse. Disfrute de las especialidades del chef: foie gras, ravioles, cabeza de ternera, ancas de rana."
    ]
  },
