  "rdfs:comment": {
    "de": [
      "Jeden Dienstag im Sommer, vom 7. Juli bis zum 18. August 2026\r\nfinden Sie unsere kulturellen Ausflüge am späten Nachmittag\r\nvon 16.00 bis 18.00 Uhr\r\nLeidenschaft, Humor, Emotionen und Geselligkeit stehen auf dem Programm!"
    ],
    "en": [
      "Every Tuesday this summer, from July 7 to August 18, 2026\r\nenjoy our late-afternoon cultural escapades\r\nfrom 4:00 pm to 6:00 pm\r\nPassion, humor, emotion and conviviality will be the order of the day!"
    ],
    "it": [
      "Tutti i martedì di quest'estate, dal 7 luglio al 18 agosto 2026\r\ngodetevi le nostre escursioni culturali nel tardo pomeriggio\r\ndalle 16.00 alle 18.00\r\nPassione, umorismo, emozione e convivialità saranno all'ordine del giorno!"
    ],
    "fr": [
      "Tous les mardis de l'été, du 7 juillet au 18 août 2026\r\nretrouvez nos escapades culturelles de fin d'après-midi\r\nde 16h00 à 18h00\r\nPassion, humour, émotion et convivialité seront au rendez-vous !"
    ],
    "es": [
      "Todos los martes de este verano, del 7 de julio al 18 de agosto de 2026\r\ndisfrute de nuestras escapadas culturales al final de la tarde\r\nde 16:00 a 18:00\r\nPasión, humor, emoción y convivencia estarán a la orden del día"
    ],
    "nl": [
      "Elke dinsdag deze zomer, van 7 juli tot 18 augustus 2026\r\ngeniet van onze late namiddag culturele escapades\r\nvan 16u tot 18u\r\nPassie, humor, ontroering en gezelligheid zijn aan de orde van de dag!"
    ]
  },
