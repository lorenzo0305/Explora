  "rdfs:comment": {
    "de": [
      "Die Miellerie des Monts du Forez wurde 1985 eröffnet. Sie befindet sich auf 1000 m Höhe in der Gemeinde Verrières en Forez im Departement Loire."
    ],
    "en": [
      "Miellerie des Monts du Forez is a honey farm where you can sample the different honeys harvested and try other quality products such as pollen, propolis, mead, etc. "
    ],
    "it": [
      "La Miellerie des Monts du Forez ha aperto le sue porte nel 1985. Si trova a 1000 metri di altitudine nel comune di Verrières en Forez, nel dipartimento della Loira."
    ],
    "fr": [
      "La Miellerie des Monts du Forez a ouvert ses portes en 1985. Elle est située à 1000m d'altitude sur la commune de Verrières en Forez, dans le département de la Loire."
    ],
    "es": [
      "La Miellerie des Monts du Forez abrió sus puertas en 1985. Está situada a 1000 m de altitud en la comuna de Verrières en Forez, en el departamento del Loira."
    ],
    "nl": [
      "De Miellerie des Monts du Forez opende haar deuren in 1985. Het ligt op 1000 meter hoogte in de gemeente Verrières en Forez, in het departement Loire."
    ]
  },
