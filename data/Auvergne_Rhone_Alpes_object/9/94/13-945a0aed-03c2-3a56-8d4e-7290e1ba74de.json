  "rdfs:comment": {
    "de": [
      "Fanny Delvallée, eine 2011 diplomierte Osteopathin, wird Ihre akuten oder chronischen Schmerzen behandeln (Wirbelsäulenschmerzen, Gelenkschmerzen, Ischiasschmerzen, Verdauungsprobleme, Kopfschmerzen...)."
    ],
    "en": [
      "Qualified osteopath Fanny Delvallée will treat your pain (rachialgia, joint pain, sciatica, digestive problems, headaches...)"
    ],
    "it": [
      "Fanny Delvallée, osteopata diplomata nel 2011, tratterà i vostri dolori acuti o cronici (dolori alla colonna vertebrale, dolori articolari, sciatica, problemi digestivi, mal di testa, ecc.)"
    ],
    "fr": [
      "Fanny Delvallée, ostéopathe diplômée en 2011, traitera vos douleurs aiguës ou chroniques (rachialgies, douleurs articulaires, sciatalgies, problèmes digestifs, céphalées...)."
    ],
    "es": [
      "Fanny Delvallée, osteópata titulada en 2011, tratará sus dolores agudos o crónicos (dolores de columna, dolores articulares, ciática, problemas digestivos, dolores de cabeza, etc.)."
    ],
    "nl": [
      "Fanny Delvallée, gediplomeerd osteopaat, zal uw pijnen behandelen (rugpijn, gewrichtspijn, ischias, spijsverteringsproblemen, hoofdpijn ...)."
    ]
  },
