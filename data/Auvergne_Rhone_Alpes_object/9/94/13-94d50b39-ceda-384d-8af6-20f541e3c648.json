  "rdfs:comment": {
    "de": [
      "Nutzen Sie den historischen Bahnhof, in dem sich heute die Boutique L'Office de Tourisme befindet. Der Bahnhof ist die Endstation des Mastrou, des einzigen Dampfzuges in der Ardèche. (Tagesrundfahrt mehrmals pro Woche in der schönen Jahreszeit)."
    ],
    "en": [
      "Enjoy the historic train station, now home to the L'Office de Tourisme store. The station is the terminus of the Mastrou, the only steam train in the Ardèche. (day trip several times a week in summer)."
    ],
    "it": [
      "Approfittate della stazione storica, oggi sede del negozio dell'Ufficio del Turismo. La stazione è il capolinea del Mastrou, l'unico treno a vapore dell'Ardèche. (corse giornaliere più volte alla settimana con il bel tempo)."
    ],
    "fr": [
      "Profitez de la gare historique qui accueil aujourd'hui la boutique L'Office de Tourisme. La gare est le terminus du Mastrou, unique train à vapeur en Ardèche. (circuit à la journée plusieurs fois par semaine à la belle saison)."
    ],
    "nl": [
      "Geniet van het historische station, waar nu de winkel van het Office du Tourisme is gevestigd. Het station is het eindpunt van de Mastrou, de enige stoomtrein in de Ardèche. (dagtochten meerdere keren per week bij mooi weer)."
    ],
    "es": [
      "Disfrute de la histórica estación, que alberga la tienda de la Oficina de Turismo. En la estación termina el Mastrou, el único tren de vapor de Ardèche. (excursiones de un día varias veces por semana con buen tiempo)."
    ]
  },
