  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/f57c5262-346d-3bfe-aca3-7fca04073f4f",
      "dc:description": {
        "de": [
          "Informationen :\n\nLiefertage :\n\nUm die Liefertage für Ihre Gemeinde zu erfahren, kontaktieren Sie den Handwerker entweder per privater Facebook-Nachricht oder telefonisch unter 07 86 71 67 52.\n\nBestellungen:\n\nKontaktieren Sie den Handwerker per Telefon unter 07 86 71 67 52.\n\n\n \n \n "
        ],
        "en": [
          "Information :\n\nDelivery days :\n\nTo find out the delivery days for your commune, contact the craftsman either by private Facebook message or by phone on 07 86 71 67 52.\n\nOrders :\n\nContact the craftsman by phone on 07 86 71 67 52.\n\n\n \n \n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di consegna :\n\nPer conoscere i giorni di consegna per il vostro comune, contattate l'artigiano tramite messaggio privato su Facebook o telefonicamente al numero 07 86 71 67 52.\n\nOrdini :\n\nContattare l'artigiano telefonicamente al numero 07 86 71 67 52.\n\n\n \n \n "
        ],
        "fr": [
          "Informations : \n\nJours de livraison : \n\nPour connaître les jours de livraison pour votre commune, contactez l'artisan soit par message privé Facebook soit par téléphone au 07 86 71 67 52.\n\nCommandes :\n\nContacter l'artisan par téléphone au 07 86 71 67 52.\n\n\n \n \n "
        ],
        "nl": [
          "Meer informatie :\n\nLeveringsdagen :\n\nNeem contact op met de vakman via een privébericht op Facebook of per telefoon op 07 86 71 67 52 om de leveringsdagen voor jouw gemeente te weten te komen.\n\nBestellingen :\n\nNeem telefonisch contact op met de ambachtsman op 07 86 71 67 52.\n\n\n \n \n "
        ],
        "es": [
          "Más información :\n\nDías de entrega :\n\nPara conocer los días de entrega para su municipio, póngase en contacto con el artesano por mensaje privado de Facebook o por teléfono en el 07 86 71 67 52.\n\nPedidos :\n\nPóngase en contacto con el artesano por teléfono en el 07 86 71 67 52.\n\n\n \n \n "
        ]
      },
