  "rdfs:comment": {
    "de": [
      "Handwerkliche Bäckerei im Zentrum des Dorfes Beaufort sur Gervanne. Sauerteigbrote mit lokalem Bio-Mehl auf Mühlsteinen, Gebäck, Pizzas und Quiches... Hier wird alles hausgemacht."
    ],
    "en": [
      "Artisanal bakery in the village center of Beaufort sur Gervanne. Sourdough breads made with local organic flours, pastries, pizzas and quiches... Here, everything is homemade."
    ],
    "it": [
      "Panificio artigianale nel centro del villaggio di Beaufort sur Gervanne. Pane a lievitazione naturale prodotto con farine biologiche locali, dolci, pizze e quiche... Tutto è fatto in casa."
    ],
    "fr": [
      "Boulangerie  artisanale au centre du village de Beaufort sur Gervanne. Pains au levain avec des farines locales bio sur meule, pâtisseries, pizzas et quiches... Ici, tout est fait maison."
    ],
    "es": [
      "Panadería artesanal en el centro del pueblo de Beaufort sur Gervanne. Panes de masa madre elaborados con harinas ecológicas locales, bollería, pizzas y quiches... Aquí todo es casero."
    ],
    "nl": [
      "Ambachtelijke bakkerij in het centrum van het dorp Beaufort sur Gervanne. Zuurdeegbroden gemaakt met lokaal biologisch meel, gebak, pizza's en quiches... Alles is hier huisgemaakt."
    ]
  },
  "rdfs:label": {
