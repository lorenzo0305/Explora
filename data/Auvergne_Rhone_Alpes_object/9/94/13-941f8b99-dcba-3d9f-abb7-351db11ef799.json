  "rdfs:comment": {
    "de": [
      "Der Club Motonautique, der auf einer Wasserfläche am Cher 20 km flussaufwärts von Montluçon liegt, empfängt Sie zur Einführung oder Verbesserung der Disziplinen des Wasserskisports."
    ],
    "en": [
      "The motonautical club, based on a stretch of water located on the Cher 20 km upstream from Montluçon, welcomes you for initiation or improvement of water skiing disciplines."
    ],
    "it": [
      "Il club motonautico, basato su uno specchio d'acqua situato sullo Cher a 20 km a monte di Montluçon, vi accoglie per l'iniziazione o il perfezionamento nelle discipline dello sci nautico."
    ],
    "fr": [
      "Le club motonautique, basé sur un plan d'eau situé sur le Cher à 20 km en amont de Montluçon, vous accueille pour l'initiation ou le perfectionnement aux disciplines du ski nautique."
    ],
    "es": [
      "El club de motonáutica, con sede en un tramo de agua situado en el Cher a 20 km aguas arriba de Montluçon, le acoge para iniciarse o perfeccionarse en las disciplinas del esquí acuático."
    ],
    "nl": [
      "De motorclub, gevestigd op een stuk water gelegen aan de Cher 20 km stroomopwaarts van Montluçon, verwelkomt u voor initiatie of verbetering in de disciplines van het waterskiën."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Club motonautique de Rochebut"
    ]
  },
