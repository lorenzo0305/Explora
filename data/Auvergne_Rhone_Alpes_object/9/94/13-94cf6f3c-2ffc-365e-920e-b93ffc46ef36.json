  "rdfs:comment": {
    "de": [
      "Restaurant, täglich abends geöffnet, samstags und sonntags auch mittags. Saisonale und marktfrische Küche. Freitags und samstags bis spät abends geöffnet. Mitglied von Maîtres Restaurateurs, Toques Blanches Lyonnaises und dem Collège Culinaire de France."
    ],
    "en": [
      "Restaurant, open every evening 7 days a week, Saturday & Sunday lunchtimes. Seasonal and market-fresh cuisine. Late service Friday and Saturday evenings. Member of Maîtres Restaurateurs, Toques Blanches Lyonnaises, and Collège Culinaire de France."
    ],
    "it": [
      "Ristorante aperto tutte le sere, 7 giorni su 7, sabato e domenica a pranzo. Cucina stagionale con prodotti freschi di mercato. Servizio fino a tardi il venerdì e il sabato sera. Membro dei Maîtres Restaurateurs, dei Toques Blanches Lyonnaises e del Collège Culinaire de France."
    ],
    "fr": [
      "Restaurant, ouvert tous les soirs 7/7, les Samedi & Dimanche Midi . Cuisine de saison et du marché. Service tardif vendredi et samedi soir. Membre des Maitres Restaurateurs, Toques blanches lyonnaises et Collège culinaire de France."
    ],
    "es": [
      "Restaurante abierto todas las noches 7/7, sábados y domingos al mediodía. Cocina de temporada y de mercado. Servicio nocturno los viernes y sábados por la noche. Miembro de Maitres Restaurateurs, Toques blanches lyonnaises y Collège culinaire de France."
    ],
    "nl": [
      "Restaurant, zeven dagen per week 's avonds geopend, ook op zaterdag en zondag voor de lunch. Seizoensgebonden gerechten met verse ingrediënten van de markt. Vrijdag- en zaterdagavond is er ook een late service. Lid van Maîtres Restaurateurs, Toques Blanches Lyonnaises en Collège Culinaire de France."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Café de Lyon"
    ]
  },
