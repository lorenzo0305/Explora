  "rdfs:comment": {
    "de": [
      "In Brune Aventure werden Sie zu echten Abenteurern! Der Park bietet Ihnen verschiedene Aktivitäten, um mit der Familie oder mit Freunden Spaß zu haben: Baumklettern, Trampolinparcours, Schatzsuche und Entdeckerspiele... Außerdem: freier und unbegrenzter Zugang!"
    ],
    "en": [
      "Become a real adventurer at Brune Aventure! The park offers a wide range of activities for you to enjoy with family and friends: accrobranche, trampoline courses, treasure hunts and exploration games... Plus: free, unlimited access!"
    ],
    "it": [
      "Diventate dei veri avventurieri a Brune Aventure! Il parco offre un'ampia gamma di attività da svolgere in famiglia o con gli amici: arrampicate sugli alberi, percorsi sul trampolino, cacce al tesoro e giochi di esplorazione... In più: accesso gratuito e illimitato!"
    ],
    "fr": [
      "A Brune Aventure devenez de vrais aventuriers ! Le parc vous propose diverses activités pour vous amuser en famille ou entre amis : accrobranche, parcours trampofilets, chasses au trésor et jeux d'exploration... En plus : accès libre et illimité !"
    ],
    "es": [
      "¡Conviértete en un auténtico aventurero en Brune Aventure! El parque ofrece un amplio abanico de actividades para disfrutar en familia o con amigos: escalada de árboles, recorridos en cama elástica, búsqueda del tesoro y juegos de exploración... Además: ¡acceso gratuito e ilimitado!"
    ],
    "nl": [
      "Word een echte avonturier bij Brune Aventure! Het park biedt een breed scala aan activiteiten om samen met je familie of vrienden van te genieten: boomklimmen, trampolineparcours, speurtochten en ontdekkingsspelletjes... Plus: gratis en onbeperkt toegang!"
    ]
  },
