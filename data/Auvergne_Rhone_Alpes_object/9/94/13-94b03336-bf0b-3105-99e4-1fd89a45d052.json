  "rdfs:comment": {
    "de": [
      "Seit über 25 Jahren organisiert Oxygène Organisation Ihre Teambuilding-/Incentive-Aktivitäten sowie Ihre Abendveranstaltungen in La Clusaz. Zählen Sie auf unser professionelles Team, um Ihr Seminar in den Bergen zu verschönern."
    ],
    "en": [
      "For over 25 years, Oxygène Organisation has been organizing team-building and incentive activities, as well as evening events in La Clusaz. Rely on our team of professionals to enhance your mountain seminar."
    ],
    "it": [
      "Da oltre 25 anni, Oxygène Organisation organizza le vostre attività di team building/incentive ed eventi serali a La Clusaz. Potete contare sul nostro team di professionisti per rendere il vostro seminario in montagna un'esperienza indimenticabile."
    ],
    "fr": [
      "Depuis plus de 25 ans, Oxygène Organisation organise vos activités team building/incentive ainsi que vos soirées à la Clusaz. Comptez sur notre équipe de professionnels pour agrémenter votre séminaire à la montagne."
    ],
    "es": [
      "Desde hace más de 25 años, Oxygène Organisation organiza sus actividades de team-building/incentivos y eventos nocturnos en La Clusaz. Puede contar con nuestro equipo de profesionales para hacer de su seminario en la montaña una experiencia inolvidable."
    ],
    "nl": [
      "Al meer dan 25 jaar organiseert Oxygène Organisation team-building- en incentiveactiviteiten, evenals avondfeesten in La Clusaz. Vertrouw op ons team van professionals om uw seminar in de bergen te verrijken"
    ]
  },
