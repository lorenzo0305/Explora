  "rdfs:comment": {
    "de": [
      "Fruchtige und biologische Produkte!\r\nAprikosen- und Kirschnektar, Konfitüren, Trockenfrüchte, aber auch Honig oder Dinkel, Mandeln und Lindenblüten ... um ein wenig Süße zu bringen."
    ],
    "en": [
      "Fruity, organic products!\r\nApricot and cherry nectars, jams, dried fruit, honey or small spelt, almonds and lime blossom... enough to bring a little sweetness."
    ],
    "it": [
      "Prodotti fruttati e biologici!\r\nNettari di albicocca e ciliegia, marmellate, frutta secca ma anche miele o piccoli farri, mandorle e tiglio ... sufficiente per apportare un po' di dolcezza."
    ],
    "fr": [
      "Produits fruités et bio !\r\nNectars d'abricots et de cerise, confitures, fruits séchés mais aussi miel ou petit épeautre, amandes et tilleul ... de quoi apporter un peu de douceur."
    ],
    "es": [
      "Productos afrutados y ecológicos\r\nNéctares de albaricoque y de cereza, mermeladas, frutos secos, pero también miel o pequeños ... suficiente para aportar un poco de dulzura."
    ],
    "nl": [
      "Fruitige, biologische producten!\r\nAbrikozen- en kersennectar, jam, gedroogd fruit, honing of kleine spelt, amandelen en lindebloesem ... alles wat je nodig hebt voor een zoete traktatie."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ferme la Gardiole"
    ]
  },
