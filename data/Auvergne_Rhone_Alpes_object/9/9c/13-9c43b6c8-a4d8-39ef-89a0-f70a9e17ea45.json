  "rdfs:comment": {
    "de": [
      "Der Parc République ist ein 2,7 Hektar großer Erholungsraum im Herzen der Stadt: Wege mit Bäumen, ein Springbrunnen, ein speziell für Kinder eingerichteter Bereich und ein grünes Theater, in dem verschiedene Veranstaltungen wie das Musikfest organisiert werden."
    ],
    "en": [
      "The Parc République is a 2.7 hectare area for relaxing in the heart of the city: tree-lined paths, fountain, special children’s area and outdoor theatre used for a range of events such as the annual music festival."
    ],
    "it": [
      "Il Parco della République è un'area ricreativa di 2,7 ettari situata nel cuore della città: viali alberati, una fontana, un'area speciale per i bambini e un teatro all'aperto dove vengono organizzati vari eventi come il festival musicale."
    ],
    "fr": [
      "Le parc République est un espace de détente de 2,7 hectares situé au cœur de la ville : chemins arborés, fontaine, aire spécialement aménagée pour les enfants, théâtre de verdure où sont organisées diverses manifestations telles que la fête de la musique."
    ],
    "nl": [
      "Het République Park is een recreatiegebied van 2,7 hectare in het hart van de stad: met bomen omzoomde paden, een fontein, een speciale ruimte voor kinderen en een openluchttheater waar verschillende evenementen zoals het muziekfestival worden georganiseerd."
    ],
    "es": [
      "El Parque de la República es una zona recreativa de 2,7 hectáreas situada en el corazón de la ciudad: senderos arbolados, una fuente, una zona especial para niños y un teatro al aire libre donde se organizan diversos eventos, como el festival de música."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parc République"
    ]
  },
