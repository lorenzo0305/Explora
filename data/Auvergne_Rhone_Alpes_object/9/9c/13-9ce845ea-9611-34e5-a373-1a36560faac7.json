  "rdfs:comment": {
    "de": [
      "Traditionelle Küche, hausgemachte Gerichte. Fred hat zwei Spezialitäten: Andouillette und Kartoffelpastete.\r\nJährlich wechselnde Speisekarte."
    ],
    "en": [
      "Traditional and homemade cooking. Véro and Fred have two specialities: the andouillette and the pâtés with potatoes. New menu."
    ],
    "it": [
      "Cucina tradizionale, piatti fatti in casa. Fred ha due specialità: l'andouillette e il tortino di patate.\r\nIl menu cambia ogni anno."
    ],
    "fr": [
      "Cuisine traditionnelle, plats faits maison. Fred a deux spécialités : l'andouillette et le pâté aux pommes de terre.\r\nCarte qui change tous les ans."
    ],
    "nl": [
      "Traditionele keuken en huisgemaakte producent. Véro en Fred hebben twee specialiteiten: andouillette en paté met aardappels."
    ],
    "es": [
      "Cocina tradicional, platos caseros. Fred tiene dos especialidades: la andouillette y el pastel de patatas.\r\nEl menú cambia cada año."
    ]
