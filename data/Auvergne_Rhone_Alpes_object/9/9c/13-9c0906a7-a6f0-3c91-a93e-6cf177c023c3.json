          "@type": [
            "schema:OpeningHoursSpecification"
          ],
          "additionalInformation": {
            "de": [
              "Osterferien bis Allerheiligen: Dienstag bis Sonntag mittags von 8:30 bis 15:00 Uhr - abends von 18:00 bis 23:00 Uhr: dienstags, mittwochs und donnerstags, aber nur auf dem Aperitif-Brett).\r\n- Juli und August: Dienstag bis Sonntag von 8.30 bis 23 Uhr durchgehend mittags und abends\r\n- Von November bis zu den Osterferien: Dienstag bis Sonntag mittags von 8.30 bis 15 Uhr (abends: nur freitags und sonntags von 18 bis 23 Uhr)"
            ],
            "en": [
              "Easter to All Saints' vacations: Tuesday to Sunday lunchtime from 8.30am to 3pm - evening from 6pm to 11pm: Tuesdays, Wednesdays and Thursdays (aperitif only).\r\n- July and August: Tuesday to Sunday, 8:30 a.m. to 11 p.m. non-stop lunch and dinner\r\n- November to Easter vacations: Tuesday to Sunday lunchtime 8.30am to 3pm (evenings: Fridays and Sundays only, 6pm to 11pm)"
            ],
            "it": [
              "Festività da Pasqua a Ognissanti: da martedì a domenica a pranzo dalle 8.30 alle 15.00 - la sera dalle 18.00 alle 23.00: martedì, mercoledì e giovedì (solo aperitivo).\r\n- Luglio e agosto: da martedì a domenica, dalle 8.30 alle 23.00, pranzo e cena non-stop\r\n- Da novembre alle vacanze di Pasqua: da martedì a domenica a pranzo dalle 8.30 alle 15.00 (la sera: solo venerdì e domenica, dalle 18.00 alle 23.00)"
            ],
            "fr": [
              "Vacances de Pâques aux vacances de Toussaint :  Du mardi au dimanche midi  de 8h30 à 15h - le soir de 18h à 23h: les mardis mercredis et jeudis  mais que planche apéro uniquement  ).\r\n- Juillet août : du mardi au dimanche de 8h30 à 23h en continu midi et soir\r\n- De novembre aux vacances de Pâques : du mardi au dimanche midi 8h30 à 15h ( le soir : que le vendredi et dimanche de 18h à 23h )"
            ],
            "es": [
              "Vacaciones de Semana Santa a Todos los Santos: de martes a domingo, almuerzo de 8.30 a 15.00 h - noche de 18.00 a 23.00 h: martes, miércoles y jueves (sólo aperitivo).\r\n- Julio y agosto: de martes a domingo, de 8.30 h a 23 h, almuerzo y cena sin interrupción\r\n- De noviembre a Semana Santa: de martes a domingo, de 8.30 h a 15 h (por la noche: viernes y domingo únicamente, de 18 h a 23 h)"
            ],
            "nl": [
              "Pasen tot Allerheiligen: dinsdag tot zondag lunchtijd van 8.30 tot 15.00 uur - 's avonds van 18.00 tot 23.00 uur: dinsdag, woensdag en donderdag (alleen aperitief).\r\n- Juli en augustus: dinsdag t/m zondag van 8.30 tot 23.00 uur, lunch en diner non-stop\r\n- November tot paasvakantie: dinsdag tot zondag lunchtijd 8.30 tot 15.00 uur ('s avonds: alleen vrijdag en zondag, 18.00 tot 23.00 uur)"
            ]
          },
