  "rdfs:comment": {
    "de": [
      "Vermietung von 2CVs oder Mopeds für alle Anlässe.\r\nHochzeiten, Seminare, Teambuilding, Firmenrallyes oder Ausflüge mit der Familie oder mit Freunden? Forez'Cursion hat die richtige Option für Sie!\r\nTauchen Sie ein in das Herz des Forez."
    ],
    "en": [
      "2CV or moped rental for all occasions.\r\nWeddings, seminars, team-building events, corporate rallies or getaways with family and friends? Forez'Cursion has the right option for you!\r\nImmerse yourself in the heart of Forez."
    ],
    "it": [
      "Noleggio di 2CV o ciclomotori per tutte le occasioni.\r\nMatrimoni, seminari, eventi di team building, raduni aziendali o fughe con la famiglia e gli amici? Forez'Cursion ha l'opzione che fa per voi!\r\nImmergetevi nel cuore di Forez."
    ],
    "fr": [
      "Location de 2CV ou de mobylettes pour toutes occasions. \r\nMariage, séminaire, team building, rallye d’entreprise ou escapade en famille ou entre amis… Forez'Cursion a l’option qu’il vous faut !\r\nUne immersion au cœur du Forez."
    ],
    "es": [
      "Alquiler de 2CV o ciclomotores para todas las ocasiones.\r\n¿Bodas, seminarios, eventos de formación de equipos, concentraciones corporativas o escapadas con la familia y los amigos? ¡Forez'Cursion tiene la opción para usted!\r\nSumérjase en el corazón de Forez."
    ],
    "nl": [
      "2CV of bromfietsverhuur voor alle gelegenheden.\r\nBruiloften, seminars, teambuildingevenementen, bedrijfsrally's of uitjes met familie en vrienden? Forez'Cursion heeft de optie voor jou!\r\nDompel jezelf onder in het hart van Forez."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Forez’Cursion Retro - Location véhicules anciens 2CV et Mobylettes"
    ]
  },
