  "rdfs:comment": {
    "de": [
      "Wir produzieren eine große Vielfalt an Saatgut, Setzlingen und Gemüse aus bäuerlichen Sorten: Gemüsepflanzen, Kräuter, Blumen, Getreide, Gründünger..."
    ],
    "en": [
      "Artisan seed growers in the Drôme, we produce a wide range of seeds, seedlings and vegetables from farmers' varieties: vegetables, herbs, flowers, cereals, green manures..."
    ],
    "it": [
      "Come piccola azienda sementiera della Drôme, produciamo un'ampia gamma di semi, piantine e ortaggi di varietà locali: verdure, erbe, fiori, cereali, concimi verdi, ecc"
    ],
    "fr": [
      "Artisan semencier dans la Drôme, nous produisons une grande diversité de semences, plants et légumes issus de variétés paysannes : plantes potagères, aromatiques, fleurs, céréales, engrais verts…"
    ],
    "es": [
      "Como pequeña empresa de semillas de la Drôme, producimos una amplia gama de semillas, plantones y hortalizas a partir de variedades locales: hortalizas, hierbas aromáticas, flores, cereales, abonos verdes, etc"
    ],
    "nl": [
      "Als ambachtelijke zaadproducent in de Drôme produceren we een breed assortiment zaden, zaailingen en groenten van boerenvariëteiten: groenten, kruiden, bloemen, granen, groenbemesters, enz."
    ]
  },
  "rdfs:label": {
    "fr": [
