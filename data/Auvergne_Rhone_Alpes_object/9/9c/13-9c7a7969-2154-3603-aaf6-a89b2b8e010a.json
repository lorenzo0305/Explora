  "rdfs:comment": {
    "de": [
      "Cîmes Aventure, das sind 100 Spiele in den Bäumen, die Spaß machen und sportlich sind. Unvergleichliche Sensationen erwarten Sie zwischen Roanne und Vichy, 1,5 km vom Croix du Sud entfernt. Ein herrlicher Ort, um einen unvergesslichen Tag zu genießen."
    ],
    "en": [
      "Cimes Aventure 100 % adventure, 100% thrills, 100% pure air \r\nTotally safe challenge for children supervised by professionals\r\nSix adult challenges: 1 discovery, 1 excitement, 1 sporting and three thrills, 70-metre long and high rope bridges."
    ],
    "it": [
      "Cîmes Aventure offre 100 giochi da albero divertenti e sportivi. Tra Roanne e Vichy, a soli 1,5 km da La Croix du Sud, vi aspettano emozioni ineguagliabili. Un sito magnifico per una giornata indimenticabile."
    ],
    "fr": [
      "Cîmes Aventure, c'est 100 jeux dans les arbres, ludiques et sportifs. Des sensations inégalées vous attendent entre Roanne et Vichy, à 1,5 km de la Croix du Sud. Un site magnifique pour profiter d'une journée inoubliable."
    ],
    "es": [
      "Cîmes Aventure ofrece 100 juegos de árbol divertidos y deportivos. Entre Roanne y Vichy, a sólo 1,5 km de La Croix du Sud, le esperan emociones inigualables. Un lugar magnífico para pasar un día inolvidable."
    ],
    "nl": [
      "Cîmes Aventure biedt 100 leuke en sportieve boomspellen. Er wachten je ongeëvenaarde sensaties tussen Roanne en Vichy, op slechts 1,5 km van La Croix du Sud. Een prachtige plek voor een onvergetelijk dagje uit."
    ]
  },
  "rdfs:label": {
