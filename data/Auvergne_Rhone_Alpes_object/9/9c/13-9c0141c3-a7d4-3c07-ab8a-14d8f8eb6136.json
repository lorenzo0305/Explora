  "rdfs:comment": {
    "de": [
      "GUÊPES, GRENOUILLES ET MONSTRES ist eine burleske und utopische Performance für eine sprechende Harfenistin, die von Aristophanes inspiriert ist und von der Harfenistin Aurélie Saraf mit Musik von Alexandros Markeas kreiert wurde."
    ],
    "en": [
      "A musical and digital creation by harpist Aurélie Saraf, with music by Alexandros Markeas, GUESTS, FROGS AND MONSTERS is a burlesque, utopian performance for a talking harpist inspired by Aristophanes."
    ],
    "it": [
      "Creazione musicale e digitale dell'arpista Aurélie Saraf, con musiche di Alexandros Markeas, GUESTS, FROGS AND MONSTERS è una performance burlesca e utopica per un'arpista parlante ispirata ad Aristofane."
    ],
    "fr": [
      "Création musicale et numérique, par la harpiste Aurélie Saraf, sur une musique d’Alexandros Markeas, GUÊPES, GRENOUILLES ET MONSTRES est une performance burlesque et utopique pour harpiste parlante inspirée d’Aristophane."
    ],
    "nl": [
      "Een muzikale en digitale creatie van harpiste Aurélie Saraf, met muziek van Alexandros Markeas. GUESTS, FROGS AND MONSTERS is een burleske, utopische voorstelling voor een pratende harpist, geïnspireerd door Aristophanes."
    ],
    "es": [
      "Creación musical y digital de la arpista Aurélie Saraf, con música de Alexandros Markeas, INVITADOS, RANAS Y MONSTRUOS es un espectáculo burlesco y utópico para arpista parlante inspirado en Aristófanes."
    ]
  },
  "rdfs:label": {
