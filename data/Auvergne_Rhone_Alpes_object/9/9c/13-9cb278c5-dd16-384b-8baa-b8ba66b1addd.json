  "rdfs:comment": {
    "de": [
      "Einzigartig in Europa mit 502 m² Fahrbahn für jedes Niveau. Nervenkitzel garantiert, weniger als 20 min von Lyon entfernt! Angepasste Angebote auf jedes Publikum und alle Niveaus: Geburtstage, Abende unter Freunden, mit der Familie... Kinder ab 11 Jahren."
    ],
    "en": [
      "Unique in Europe with 502m of multi-level tracks. Thrill seekers are guaranteed a good time less than 20 minutes away from Lyon ! Open to all age groups from 11 up, and to anyone regardless of their level of expertise. Great for birthdays, boys/girls nights out, family outings…"
    ],
    "it": [
      "A Dagneux (20 minuti da Lione), un complesso multi-tempo unico in Europa!\r\nUna gamma di attività a partire dai 3 anni: go-kart elettrici al coperto o go-kart a bio-etanolo all'aperto per adulti e bambini, bowling, laser game, realtà virtuale, karaoke, blind test, quiz e altro ancora..."
    ],
    "fr": [
      "Complexe multi-loisirs à Dagneux (20 min de Lyon) unique en Europe ! \r\nPlusieurs activités dès 3 ans : Karting électrique indoor ou bio-éthanol outdoor adultes et enfants, bowling, laser game, réalité virtuelle, karaoké, blind test, quiz game, et autres..."
    ],
    "es": [
      "Una pista de karts única en Europa, con 502 m de diferentes niveles. ¡Sensaciones fuertes aseguradas a menos de 20 minutos de Lyon! Packs adaptados a todos los públicos y niveles: cumpleaños, reuniones de amigos, en familia... Niños a partir de 11 años."
    ],
    "nl": [
      "Een multi-leisure complex in Dagneux (20 min van Lyon) dat uniek is in Europa!\r\nEen waaier aan activiteiten vanaf 3 jaar: indoor elektrisch karten of outdoor bio-ethanol karten voor volwassenen en kinderen, bowling, lasergame, virtual reality, karaoke, blind test, quiz en nog veel meer..."
    ]
  },
