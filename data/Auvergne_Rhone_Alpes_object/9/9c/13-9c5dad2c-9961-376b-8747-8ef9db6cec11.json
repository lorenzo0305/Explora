  "rdfs:comment": {
    "de": [
      "Das Pépé &amp; Cie lädt Sie ein, seine neue Speisekarte und sein neues Ambiente zu entdecken!\r\nEntscheiden Sie sich mittags und abends für eine traditionelle Küche mit frischen und qualitativ hochwertigen Produkten. Entdecken Sie unsere Pizzen und unser im Holzofen gegrilltes Fleisch."
    ],
    "en": [
      "Pépé & Cie invites you to discover its new menu and new decor!\r\nOpt for traditional cuisine made with quality fresh products at lunchtime and in the evening. Come and discover our pizzas and meat dishes grilled over the wood fire."
    ],
    "it": [
      "Le Pépé & Cie vi invita a scoprire il suo nuovo menu e la sua atmosfera!\r\nA pranzo e alla sera, scegliete una cucina tradizionale a base di prodotti freschi e di qualità. Venite a scoprire le nostre pizze e le nostre carni alla griglia."
    ],
    "fr": [
      "Le Pépé & Cie vous invite a découvrir sa nouvelle carte ainsi que sa nouvelle ambiance !\r\nOptez pour une cuisine traditionnelle le midi et  le soir avec des produits frais et de qualités. Venez découvrir nos pizzas et nos viandes grillées au feu de bois."
    ],
    "nl": [
      "Le Pépé & Cie nodigt u uit om zijn nieuwe menu en sfeer te ontdekken!\r\nKies 's middags en 's avonds voor een traditionele keuken met verse kwaliteitsproducten. Ontdek onze pizza's en op hout gegrild vlees."
    ],
    "es": [
      "Le Pépé & Cie le invita a descubrir su nueva carta y su nuevo ambiente\r\nOpte por la cocina tradicional al mediodía y por la noche, con productos frescos y de calidad. Descubra nuestras pizzas y carnes a la parrilla."
    ]
  },
