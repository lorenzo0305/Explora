  "rdfs:comment": {
    "de": [
      "Die Eislaufbahn in Saint-Étienne befindet sich am 45 Boulevard Jules-Janin und ist für alle zugänglich. Gleiten Sie, Jugend!"
    ],
    "en": [
      "Come and practice your ice skating, figure skating and synchronised ice skating on the Plaine Achille. Bring your friends and family (3 and up)."
    ],
    "it": [
      "Situata al 45 di boulevard Jules-Janin, la pista di ghiaccio di Saint-Étienne è aperta a tutti. Scivolate, giovani!"
    ],
    "fr": [
      "Située au 45 boulevard Jules-Janin, la patinoire de Saint-Étienne est ouverte à tous. Glissez, jeunesse !"
    ],
    "es": [
      "Situada en el 45 del bulevar Jules-Janin, la pista de hielo de Saint-Étienne está abierta a todos. ¡A deslizarse, jóvenes!"
    ],
    "nl": [
      "De ijsbaan van Saint-Étienne, gelegen aan de boulevard Jules-Janin 45, is voor iedereen toegankelijk. Glijden maar, jongelui!"
    ]
