  "rdfs:comment": {
    "de": [
      "Viele Bücher werden von der Médiathèque du Rhône ausgeliehen und drei- bis viermal im Jahr durch den Bibliobus ausgetauscht."
    ],
    "en": [
      "A good number of books are loaned by the Médiathèque du Rhône, they are renewed, by department, three to four times a year when the bookmobile passes by."
    ],
    "it": [
      "Un buon numero di libri è prestato dalla Médiathèque du Rhône e viene rinnovato, per dipartimento, tre o quattro volte all'anno in occasione delle visite della biblioteca mobile."
    ],
    "fr": [
      "Un bon nombre de livres sont prêtés par la Médiathèque du Rhône, ils sont renouvelés, par rayon, trois à quatre fois par an lors du passage du bibliobus."
    ],
    "es": [
      "La Mediateca del Ródano presta un buen número de libros, que se renuevan, por departamentos, tres o cuatro veces al año con motivo de la visita de la biblioteca móvil."
    ],
    "nl": [
      "Een groot aantal boeken wordt uitgeleend door de Médiathèque du Rhône, en per afdeling drie of vier keer per jaar vernieuwd wanneer de mobiele bibliotheek langskomt."
    ]
  },
