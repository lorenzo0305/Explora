  "rdfs:comment": {
    "de": [
      "Die faszinierende japanische Mahlzeit, die vor Ort erhältlich ist/zum Mitnehmen/zum Liefern in St. Etienne.\r\nLe Bento ist eine gesunde, authentische, nahrhafte und schnelle Küche, die von unseren beiden japanischen Chefköchinnen zusammengestellt wurde"
    ],
    "en": [
      "The fascinating Japanese meal available to eat in/take away/deliver in St Etienne. \r\nBento is a healthy, authentic, nourishing and fast cuisine concocted by our 2 Japanese chefs."
    ],
    "it": [
      "L'affascinante pasto giapponese disponibile in loco/da asporto/da consegnare a St Etienne.\r\nIl Bento è una cucina sana, autentica, nutriente e veloce elaborata dai nostri 2 chef giapponesi"
    ],
    "fr": [
      "Le fascinant repas japonais disponible sur place/à emporter/ livraison sur St Etienne. \r\nLe Bento c'est une cuisine saine, authentique, nourrissante et rapide concoctée par nos 2 cheffes japonaises"
    ],
    "es": [
      "La fascinante comida japonesa disponible in situ/para llevar/para llevar en St Etienne.\r\nBento es una cocina sana, auténtica, nutritiva y rápida elaborada por nuestros 2 chefs japoneses"
    ],
    "nl": [
      "De fascinerende Japanse maaltijd ter plaatse/afhalen/bezorgen in St Etienne.\r\nBento is een gezonde, authentieke, voedzame en snelle keuken samengesteld door onze 2 Japanse chefs"
    ]
  },
  "rdfs:label": {
    "en": [
      "Wa Bento Japanese canteen"
    ],
    "fr": [
      "Wa Bento Cantine japonaise"
    ]
  },
