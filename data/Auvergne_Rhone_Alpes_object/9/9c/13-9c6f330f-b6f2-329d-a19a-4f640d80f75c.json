  "rdfs:comment": {
    "de": [
      "Der Velorail von Pradelles bietet Ihnen verschiedene Strecken auf einer alten Bahntrasse.\r\nDie Velorails sind mit elektrischer Unterstützung ausgestattet, die wahlweise aktiviert oder deaktiviert werden kann."
    ],
    "en": [
      "The Pradelles velorail offers a range of different routes along an old railroad line.\r\nThe velorails are equipped with electric assistance, which can be activated or deactivated as required."
    ],
    "it": [
      "La velorotaia di Pradelles offre una varietà di percorsi lungo un'ex linea ferroviaria.\r\nI vélorail sono dotati di assistenza elettrica, che può essere attivata o disattivata a seconda delle necessità."
    ],
    "fr": [
      "Le vélorail de Pradelles vous propose différents parcours sur une ancienne voie ferrée.\r\nLes vélorails sont équipés d’assistance électrique, activable ou non, au choix."
    ],
    "es": [
      "El vélorail de Pradelles ofrece diversos recorridos a lo largo de una antigua vía férrea.\r\nLos vélorails están equipados con asistencia eléctrica, que puede activarse o desactivarse según las necesidades."
    ],
    "nl": [
      "De velorail van Pradelles biedt verschillende routes langs een voormalige spoorlijn.\r\nDe vélorails zijn uitgerust met elektrische ondersteuning die naar wens kan worden in- of uitgeschakeld."
    ]
  },
