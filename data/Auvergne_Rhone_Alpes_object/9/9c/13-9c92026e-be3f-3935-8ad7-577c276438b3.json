  "rdfs:comment": {
    "de": [
      "Game Center befindet sich nur 3 Minuten vom Stadtzentrum Wiens entfernt. Es verfügt über einen großen Parkplatz mit 160 Plätzen und ist der ideale Ort, um mit der Familie oder mit Freunden eine schöne Zeit zu verbringen!"
    ],
    "en": [
      "Game Center is located just 3 minutes from downtown Vienna. Equipped with a large 160-space parking lot, it's the place to be for a good time with family and friends!"
    ],
    "it": [
      "Il Game Center si trova a soli 3 minuti dal centro di Vienna. Con un ampio parcheggio da 160 posti, è il luogo perfetto per trascorrere del tempo di qualità con la famiglia e gli amici!"
    ],
    "fr": [
      "Game Center est situé à 3 seulement minutes du centre-ville de Vienne. Equipé d'un grand parking de 160 places, c'est le lieu incontournable pour passer de bons moments en famille ou entre amis !"
    ],
    "nl": [
      "Game Center ligt op slechts 3 minuten van het centrum van Wenen. Met een grote parkeerplaats van 160 plaatsen is het de perfecte plek om wat quality time door te brengen met familie en vrienden!"
    ],
    "es": [
      "Game Center está situado a sólo 3 minutos del centro de Viena. Con un amplio aparcamiento de 160 plazas, es el lugar perfecto para pasar un buen rato con la familia y los amigos"
    ]
  },
