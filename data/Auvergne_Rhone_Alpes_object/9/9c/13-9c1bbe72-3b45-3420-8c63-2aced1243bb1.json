  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Hôtel Beau Rivage und seine privilegierte Lage \"mit den Füßen im Wasser\". Mit Blick auf den Lac du Bourget laden unsere Zimmer mit allem Komfort zu einer Flucht aus dem Alltag ein und garantieren einen erfrischenden Tapetenwechsel."
    ],
    "en": [
      "Discover the Hôtel Beau Rivage and its privileged \"feet in the water\" location. Facing Lac du Bourget, our comfortable rooms are an invitation to escape, guaranteeing a rejuvenating change of scenery."
    ],
    "it": [
      "Scoprite l'Hôtel Beau Rivage e la sua posizione privilegiata \"con i piedi nell'acqua\". Affacciate sul Lac du Bourget, le nostre confortevoli camere sono un invito all'evasione e garantiscono un cambio di scenario rigenerante."
    ],
    "fr": [
      "Découvrez l'Hôtel Beau Rivage et sa situation privilégiée \"les pieds dans l'eau\". Face au lac du Bourget, nos chambres tout confort sont une invitation à l'évasion, garantissant un dépaysement ressourçant."
    ],
    "nl": [
      "Ontdek Hôtel Beau Rivage en zijn bevoorrechte locatie \"met de voeten in het water\". Onze comfortabele kamers kijken uit op het Lac du Bourget en nodigen uit om te ontsnappen, voor een verjongende verandering van omgeving."
    ],
    "es": [
      "Descubra el Hôtel Beau Rivage y su ubicación privilegiada \"con los pies en el agua\". Frente al lago Bourget, nuestras confortables habitaciones invitan a la evasión y garantizan un cambio de aires rejuvenecedor."
    ]
  },
  "rdfs:label": {
