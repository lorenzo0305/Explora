  "rdfs:comment": {
    "de": [
      "Der Club de Randonnées de Saint-Nazaire-en-Royans organisiert abwechslungsreiche Wanderungen, wertet das lokale Kulturerbe auf, fördert Geselligkeit und Umweltbewusstsein und bietet Aktivitäten an, die für alle zugänglich sind."
    ],
    "en": [
      "The Club de Randonnées de Saint-Nazaire-en-Royans organizes a variety of hikes, promotes the local heritage, fosters conviviality and respect for the environment, and offers activities accessible to all."
    ],
    "it": [
      "Il Club de Randonnées di Saint-Nazaire-en-Royans organizza una serie di escursioni, mette in mostra il patrimonio locale, promuove la convivialità e il rispetto dell'ambiente e propone attività accessibili a tutti."
    ],
    "fr": [
      "Le Club de Randonnées de Saint-Nazaire-en-Royans organise des randonnées variées, valorise le patrimoine local, promeut la convivialité et le respect de l'environnement, et propose des activités accessibles à tous."
    ],
    "es": [
      "El Club de Randonnées de Saint-Nazaire-en-Royans organiza excursiones variadas, da a conocer el patrimonio local, fomenta la convivencia y el respeto por el medio ambiente y propone actividades accesibles a todos."
    ],
    "nl": [
      "De Club de Randonnées de Saint-Nazaire-en-Royans organiseert verschillende wandeltochten, laat het lokale erfgoed zien, bevordert gezelligheid en respect voor het milieu en biedt activiteiten die voor iedereen toegankelijk zijn."
    ]
  },
