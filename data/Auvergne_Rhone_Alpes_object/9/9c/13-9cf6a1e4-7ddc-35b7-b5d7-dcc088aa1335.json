  "rdfs:comment": {
    "de": [
      "Eine hausgemachte Snackpause mit frischen und leckeren Produkten. Von Montag bis Freitag bieten wir Ihnen eine große Auswahl an Sandwiches, Quiches, Pizzas und anderen herzhaften Snacks, die alle vor Ort und mit frischen Zutaten zubereitet werden."
    ],
    "en": [
      "A home-made snacking break with fresh, gourmet products. From Monday to Friday, we offer a wide variety of sandwiches, quiches, pizzas and other savoury snacks, all made fresh on the premises."
    ],
    "it": [
      "Uno spuntino fatto in casa con prodotti freschi e gustosi. Dal lunedì al venerdì, offriamo un'ampia varietà di panini, quiche, pizze e altri snack salati, tutti prodotti freschi in loco."
    ],
    "fr": [
      "Une pause snacking faite maison avec des produits frais et gourmands. Du lundi au vendredi, nous vous proposons une large variété de sandwiches, quiches, pizzas et autres encas salés, tous préparés sur place et avec des produits frais."
    ],
    "es": [
      "Un tentempié casero con productos frescos y sabrosos. De lunes a viernes, ofrecemos una amplia variedad de bocadillos, quiches, pizzas y otros aperitivos salados, todos ellos recién hechos en el local."
    ],
    "nl": [
      "Een huisgemaakte snack met verse, smakelijke producten. Van maandag tot en met vrijdag bieden we een grote verscheidenheid aan broodjes, quiches, pizza's en andere hartige snacks, allemaal ter plekke vers gemaakt."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Maison Hodapp"
    ]
  },
