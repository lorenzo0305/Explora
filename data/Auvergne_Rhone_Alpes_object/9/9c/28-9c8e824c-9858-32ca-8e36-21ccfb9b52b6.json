  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/fbbb5480-ed0c-31ed-a506-dfc7469410e5",
      "dc:description": {
        "de": [
          "Café-Brasserie im Stadtzentrum von Lambres-lez-Douai, unweit des Wanderwegs \"Le Chemin des Eaux\" (Wasserweg).\nFabien und sein Team empfangen Sie in einer familiären und herzlichen Atmosphäre. Sie bieten Ihnen eine kleine Speisekarte mit frischen und hausgemachten Produkten!"
        ],
        "en": [
          "Café-brasserie in downtown Lambres-lez-Douai, not far from the \"Le Chemin des Eaux\" hiking trail.\nFabien and his team welcome you in a warm, family atmosphere. They offer a small menu of fresh, home-made products!"
        ],
        "it": [
          "Café-brasserie nel centro di Lambres-lez-Douai, non lontano dal sentiero escursionistico \"Le Chemin des Eaux\".\nFabien e il suo team vi accolgono in un'atmosfera calda e familiare. Offrono un piccolo menu con prodotti freschi e fatti in casa!"
        ],
        "fr": [
          "Café-brasserie en centre-ville de Lambres-lez-Douai, non loin du chemin de randonnée \"Le Chemin des Eaux\".\nFabien et son équipe vous accueille dans une ambiance familiale et chaleureuse. Ils vous proposent une petite carte avec produits frais et maison !"
        ],
        "nl": [
          "Café-brasserie in het centrum van Lambres-lez-Douai, niet ver van de wandelroute \"Le Chemin des Eaux\".\nFabien en zijn team verwelkomen je in een warme, familiale sfeer. Ze bieden een kleine kaart met verse, zelfgemaakte producten!"
        ],
        "es": [
          "Café-brasserie en el centro de Lambres-lez-Douai, cerca de la ruta de senderismo \"Le Chemin des Eaux\".\nFabien y su equipo le dan la bienvenida en un ambiente cálido y familiar. Ofrecen una pequeña carta con productos frescos y caseros"
        ]
      },
      "@type": [
        "Description"
      ],
