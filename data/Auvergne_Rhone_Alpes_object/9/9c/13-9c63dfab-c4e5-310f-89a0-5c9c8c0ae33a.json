  "rdfs:comment": {
    "de": [
      "L'Annexe in La Norma: ein einzigartiger Ort, an dem man sich den ganzen Tag über treffen kann! Genießen Sie mittags ein gemütliches Fastfood-Restaurant, nach dem Skifahren eine Happy Hour und entspannen Sie sich abends beim Billard mit Musik!"
    ],
    "en": [
      "L'Annexe at La Norma: a unique place to meet all day long! Enjoy a friendly fast-food restaurant at lunchtime, happy hour after skiing, and in the evening, relax with a game of billiards and live music!"
    ],
    "it": [
      "L'Annexe a La Norma: un luogo unico per incontrarsi tutto il giorno! Godetevi un accogliente fast-food a pranzo, l'happy hour dopo lo sci e la sera rilassatevi con una partita a biliardo con musica dal vivo!"
    ],
    "fr": [
      "L’Annexe à La Norma : un lieu unique pour se retrouver toute la journée ! Le midi, profitez d’un fast-food convivial, l’après-ski en happy hour, et le soir détendez-vous autour d’un billard en musique !"
    ],
    "nl": [
      "The Annexe at La Norma: een unieke plek om elkaar de hele dag te ontmoeten! Geniet van een gezellig fastfoodrestaurant tijdens de lunch, happy hour na het skiën en ontspan 's avonds tijdens een spelletje pool met livemuziek!"
    ],
    "es": [
      "El Anexo de La Norma: ¡un lugar único para reunirse durante todo el día! Disfrute de un agradable restaurante de comida rápida al mediodía, de la hora feliz después de esquiar y, por la noche, relájese jugando al billar con música en directo"
    ]
  },
