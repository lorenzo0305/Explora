  "rdfs:comment": {
    "de": [
      "Seit 2020 produziert Geoffrey in Arcon Honig aus dem Roannais, der aus 200 Bienenstöcken stammt: Frühling, Akazie, Sommerblumen und Berge. Entdecken Sie den echten lokalen Geschmack, direkt vom Bienenstock auf Ihren Tisch!"
    ],
    "en": [
      "Since 2020 in Arcon, Geoffrey has been producing Roannais honeys from 200 hives: spring, acacia, summer flower and mountain. Get the real local taste, straight from the hive to your table!"
    ],
    "it": [
      "Dal 2020 Geoffrey produce i mieli di Roannais da 200 alveari ad Arcon: mieli di primavera, di acacia, di fiori estivi e di montagna. Assaporate il vero gusto locale, direttamente dall'alveare alla vostra tavola!"
    ],
    "fr": [
      "Depuis 2020 à Arcon, Geoffrey produit des miels du Roannais issus de 200 ruches : printemps, acacia, fleurs d’été et montagne. Retrouvez le vrai goût local, directement de la ruche à votre table !"
    ],
    "nl": [
      "Geoffrey produceert sinds 2020 honing van Roannais uit 200 bijenkorven in Arcon: lente-, acacia-, zomerbloemen- en berghoning. Proef de echte lokale smaak, rechtstreeks van de bijenkorf naar uw tafel!"
    ],
    "es": [
      "Geoffrey produce mieles Roannais a partir de 200 colmenas en Arcon desde 2020: mieles de primavera, de acacia, de flores de verano y de montaña. Disfrute del auténtico sabor local, ¡directo de la colmena a su mesa!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Miellerie des Gorges du Désert"
    ]
  },
