  "rdfs:comment": {
    "de": [
      "Marine und Tony, seit 2018 Biobauern, züchten auf 60 ha Cou Nu Rouge-Geflügel mit weißen Beinen, das für sein zartes Fleisch bekannt ist. Sie bieten in einem umweltfreundlichen Betrieb küchenfertige oder zerlegte Hähnchen an."
    ],
    "en": [
      "Marine and Tony, organic farmers since 2018, rear Cou Nu Rouge white legged poultry on 60 hectares, renowned for their tender meat. They offer ready-to-cook or cut-up chickens from a sustainable, environmentally-friendly farm."
    ],
    "it": [
      "Marine e Tony, agricoltori biologici dal 2018, allevano su 60 ettari il pollame a zampe bianche Cou Nu Rouge, rinomato per la sua carne tenera. Offrono polli pronti da cuocere o tagliati, provenienti da un allevamento ecologico."
    ],
    "fr": [
      "Marine et Tony, agriculteurs bio depuis 2018, élèvent sur 60 ha des volailles Cou Nu Rouge à pattes blanches, réputées pour leur chair tendre. Ils proposent des poulets prêts à cuire ou découpés, dans une exploitation respectueuse de l’environnement."
    ],
    "es": [
      "Marine y Tony, granjeros ecológicos desde 2018, crían en 60 hectáreas aves de pata blanca Cou Nu Rouge, famosas por su carne tierna. Ofrecen pollos listos para cocinar o despiezados procedentes de una granja respetuosa con el medio ambiente."
    ],
    "nl": [
      "Marine en Tony, biologische boeren sinds 2018, fokken Cou Nu Rouge witpootpluimvee op 60 hectare, bekend om hun malse vlees. Ze bieden kant-en-klare of versneden kippen van een milieuvriendelijke boerderij."
    ]
  },
  "rdfs:label": {
    "en": [
      "Les Poulets des Templiers"
    ],
    "fr": [
      "Les Poulets des Templiers"
    ]
