  "rdfs:comment": {
    "de": [
      "Diese charmante Boutique im Herzen der Stadt bietet Ihnen schöne Geschenkideen und Innendekorationen (Designerkissen), Modeaccessoires (Taschen, Stolen) und Kunstkarten (u. a. von Gaëlle Boissonnard) sowie Keramiken von Kunsthandwerkern."
    ],
    "en": [
      "This charming boutique in the heart of town offers great ideas for gifts and home decor (designer cushions), fashion accessories (bag, stole) and art cards (notably by Gaëlle Boissonnard), as well as artisan ceramics."
    ],
    "it": [
      "Questa affascinante boutique nel cuore della città offre ottime idee per regali e decorazioni per la casa (cuscini di design), accessori di moda (borse, stole) e carte d'arte (in particolare di Gaëlle Boissonnard), oltre a ceramiche di artigiani."
    ],
    "fr": [
      "Cette charmante boutique en cœur de ville vous propose de belles idées cadeaux et de décoration d'intérieur (coussins de créateurs), d'accessoires de mode (sac, étole) et de carterie d'art (notamment de Gaëlle Boissonnard) et des céramiques d'artisans."
    ],
    "es": [
      "Esta encantadora boutique situada en el corazón de la ciudad ofrece estupendas ideas para regalar y decorar el hogar (cojines de diseño), accesorios de moda (bolsos, estolas) y tarjetas artísticas (de Gaëlle Boissonnard en particular), así como cerámicas de artesanos."
    ],
    "nl": [
      "Deze charmante boetiek in het hart van de stad biedt leuke ideeën voor cadeaus en woondecoratie (designerkussens), modeaccessoires (tassen, stola's) en kunstkaarten (vooral van Gaëlle Boissonnard), maar ook keramiek van ambachtslieden."
    ]
  },
  "rdfs:label": {
    "fr": [
      "A l'ombre du Tilleul"
    ]
  },
