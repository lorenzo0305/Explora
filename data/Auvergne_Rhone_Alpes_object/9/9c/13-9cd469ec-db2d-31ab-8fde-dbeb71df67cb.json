  "rdfs:comment": {
    "de": [
      "Le Galop des Allinges ist ein vereinseigenes Reitzentrum, das sich in der Gemeinde Saint-Quentin-Fallavier im Nord-Isère befindet, etwa 30 km südöstlich von Lyon und 15 km westlich von Bourgoin-Jallieu."
    ],
    "en": [
      "Le Galop des Allinges is an associative equestrian centre located in the commune of Saint-Quentin-Fallavier, in Nord-Isère, about thirty kilometres south-east of Lyon and about fifteen kilometres west of Bourgoin-Jallieu."
    ],
    "it": [
      "Il Galop des Allinges è un centro ippico situato nel comune di Saint-Quentin-Fallavier, nella regione Nord-Isère, a circa trenta chilometri a sud-est di Lione e a quindici chilometri a ovest di Bourgoin-Jallieu."
    ],
    "fr": [
      "Le Galop des Allinges est un centre équestre associatif qui se trouve sur la commune de Saint-Quentin-Fallavier, dans le Nord-Isère, à une trentaine de kilomètres au sud-est de Lyon et à une quinzaine à l'ouest de Bourgoin-Jallieu."
    ],
    "es": [
      "El Galop des Allinges es un centro ecuestre situado en el municipio de Saint-Quentin-Fallavier, en la región de Nord-Isère, a unos treinta kilómetros al sureste de Lyon y quince kilómetros al oeste de Bourgoin-Jallieu."
    ],
    "nl": [
      "De Galop des Allinges is een ruitercentrum in de gemeente Saint-Quentin-Fallavier, in de regio Nord-Isère, ongeveer dertig kilometer ten zuidoosten van Lyon en vijftien kilometer ten westen van Bourgoin-Jallieu."
    ]
  },
  "rdfs:label": {
