  "rdfs:comment": {
    "de": [
      "Die im 6. oder 7. Jahrhundert gegründete Abtei Saint-André-le-Bas war im Mittelalter eins der wichtigsten Klöster der Diözese von Vienne."
    ],
    "en": [
      "Saint-André-le-Bas Abbey was founded in the 6th or 7th century. It was one of the most important monasteries in the diocese of Vienne during the Middle Ages."
    ],
    "it": [
      "Fondata nel VI o VII secolo, l'Abbazia di Saint-André-le-Bas fu uno dei monasteri più importanti della diocesi di Vienne durante il Medioevo."
    ],
    "fr": [
      "Fondée au VIème ou VIIème siècle, l'abbaye de Saint-André-le-Bas était l'un des monastères les plus importants du diocèse de Vienne durant le Moyen-Age."
    ],
    "es": [
      "Fundada en el siglo VI o VII, la abadía de Saint-André-le-Bas fue uno de los monasterios más importantes de la diócesis de Vienne durante la Edad Media."
    ],
    "nl": [
      "De abdij van Saint-André-le-Bas, gesticht in de 6e of 7e eeuw, was in de Middeleeuwen een van de belangrijkste kloosters in het bisdom Vienne."
    ]
  },
