  "rdfs:comment": {
    "de": [
      "Das Bistrot City bietet Ihnen eine bistronomische Küche, die sowohl traditionelle als auch moderne Gerichte aus frischen und saisonalen Produkten umfasst."
    ],
    "en": [
      "The Bistrot City proposes a cuisine with that delicious home-cooked taste comprised of both traditional and contemporary dishes produced from fresh, seasonal products."
    ],
    "it": [
      "Il Bistrot City offre una cucina bistronomica, con piatti tradizionali e contemporanei preparati con prodotti freschi di stagione."
    ],
    "fr": [
      "Le Bistrot City vous propose une cuisine bistronomique, qui se compose à la fois de plats traditionnels et contemporains, élaborés à partir de produits frais et de saison."
    ],
    "es": [
      "El Bistrot City ofrece cocina bistronómica, con platos tradicionales y contemporáneos elaborados con productos frescos de temporada."
    ],
    "nl": [
      "Bistrot City biedt een bistronomische keuken, met zowel traditionele als eigentijdse gerechten bereid met verse seizoensproducten."
    ]
