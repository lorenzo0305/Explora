  "rdfs:comment": {
    "de": [
      "Hier werden unsere Gerichte täglich mit Sorgfalt gekocht und am Wochenende gibt es auf Vorbestellung frische Frösche."
    ],
    "en": [
      "Here, we carefully prepare our daily dishes and offer fresh frogs at weekends by prior arrangement."
    ],
    "it": [
      "Qui prepariamo con cura i nostri piatti ogni giorno e offriamo rane fresche nei fine settimana su prenotazione."
    ],
    "fr": [
      "Ici on cuisine avec soin nos plats au quotidien et on vous propose des grenouilles fraîches le weekend sur réservation."
    ],
    "nl": [
      "Hier bereiden we elke dag met zorg onze gerechten en bieden we in het weekend op afspraak verse kikkers aan."
    ],
    "es": [
      "Aquí preparamos cuidadosamente nuestros platos todos los días y ofrecemos ranas frescas los fines de semana previa reserva."
