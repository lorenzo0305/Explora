  "rdfs:comment": {
    "de": [
      "Winter: Bar/Crêpes/Waffeln - Selbstbedienung (mittags)\r\nTraditionelles savoyisches Restaurant, in dem jeden Abend savoyische Spezialitäten nach Belieben serviert werden. Kostenloser Pendelbus.\r\n\r\nSommer: Bar - Brasserie - Waffeln. Sonnenterrasse."
    ],
    "en": [
      "Winter : Bar/pancakes/waffles - Self-service (lunchtime) \r\nTraditional Savoyard restaurant, with all-you-can-eat Savoyard specialties every evening. Free shuttle bus.\r\n\r\nSummer : Bar - brewery - waffles. Sun terrace."
    ],
    "it": [
      "Inverno: Bar/crepes/waffles - Self-service (a pranzo)\r\nRistorante tradizionale savoiardo, con specialità savoiarde a volontà ogni sera. Servizio navetta gratuito.\r\n\r\nEstate: Bar - brasserie - waffles. Terrazza solarium."
    ],
    "fr": [
      "Hiver : Bar/crêpes/gaufres - Self service (le midi) \r\nRestaurant traditionnel savoyard, avec spécialités savoyardes à volonté tous les soirs. Navette gratuite.\r\n\r\nEté : Bar - brasserie - gaufres. Terrasse solarium."
    ],
    "nl": [
      "Winter : Bar/pannenkoeken/wafels - Zelfbediening (lunch) \r\nTraditioneel Savoyaards restaurant, met elke avond onbeperkt Savoyaardse specialiteiten. Gratis pendelbus.\r\n\r\nZomer : Bar - brouwerij - wafels. Zonneterras."
    ],
    "es": [
      "Invierno: Bar/crepes/waffles - Autoservicio (mediodía)\r\nRestaurante tradicional saboyano, con especialidades saboyanas todas las noches. Servicio de transporte gratuito.\r\n\r\nVerano: Bar - brasserie - gofres. Terraza solarium."
    ]
  },
