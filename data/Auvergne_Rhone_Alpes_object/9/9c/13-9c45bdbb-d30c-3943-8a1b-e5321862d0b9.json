  "rdfs:comment": {
    "de": [
      "Traditionelle Küche.\r\nPizzas vor Ort oder zum Mitnehmen\r\nTagesmenü von Mittwoch bis Freitag mittags. Menü an Abenden und Wochenenden mit 2 Vorspeisen nach Wahl, 2 Hauptgerichten nach Wahl und 2 Desserts nach Wahl"
    ],
    "en": [
      "Traditional cuisine.\r\nPizzas to eat in or take away\r\nDaily menu from Wednesday to Friday lunchtime. Menu evenings and weekends with choice of 2 starters, 2 main courses and 2 desserts"
    ],
    "it": [
      "Cucina tradizionale.\r\nPizze da mangiare o da portare via\r\nMenu giornaliero da mercoledì a venerdì a pranzo. Menù serale e del fine settimana con scelta di 2 antipasti, 2 secondi e 2 dessert"
    ],
    "fr": [
      "Cuisine traditionnelle.\r\nPizzas sur place ou à emporter\r\nMenu du jour du mercredi au vendredi midi. Menu les soirs et week-ends avec 2 entrées au choix, 2 plats au choix et 2 desserts au choix"
    ],
    "nl": [
      "Traditionele keuken.\r\nPizza's om te eten of mee te nemen\r\nDagmenu van woensdag tot vrijdag lunchtijd. Menu 's avonds en in het weekend met keuze uit 2 voorgerechten, 2 hoofdgerechten en 2 desserts"
    ],
    "es": [
      "Cocina tradicional.\r\nPizzas para comer o llevar\r\nMenú diario de miércoles a viernes al mediodía. Menú noches y fines de semana a elegir entre 2 entrantes, 2 platos principales y 2 postres"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Tableau Gourmand"
    ]
  },
