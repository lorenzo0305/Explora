  "rdfs:comment": {
    "de": [
      "Nachdem die Funken eine Woche lang die Kohlen ausgeblasen haben, machen sie ab Freitagabend, dem 2. Dezember, Platz für die Feux de la Sainte Barbe (Feuer der Heiligen Barbara)."
    ],
    "en": [
      "After having blown on the embers for a week, the Sparks will give way to the St. Barbara's Day Fires starting Friday evening, December 2."
    ],
    "it": [
      "Dopo aver soffiato sulle braci per una settimana, le scintille lasceranno il posto ai fuochi d'artificio di Santa Barbara a partire dalla sera di venerdì 2 dicembre."
    ],
    "fr": [
      "Après avoir soufflé sur les braises pendant une semaine, les Étincelles laissent place aux Feux de la Sainte Barbe dès le vendredi 2 décembre au soir."
    ],
    "nl": [
      "Na een week op de sintels te hebben geblazen, zullen de Sparks vanaf vrijdagavond 2 december plaatsmaken voor het Sint-Barbaravuurwerk."
    ],
    "es": [
      "Después de soplar las brasas durante una semana, las chispas darán paso a los fuegos artificiales de Santa Bárbara a partir de la noche del viernes 2 de diciembre."
    ]
  },
  "rdfs:label": {
