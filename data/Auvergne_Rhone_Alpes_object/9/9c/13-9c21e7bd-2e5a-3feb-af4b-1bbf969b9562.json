  "rdfs:comment": {
    "de": [
      "Entstanden aus einer Leidenschaft für die Natur und die Gebiete der Ardèche Verte, des Pilat und des Velay,\r\nDiversion Nature, eine junge lokale Reiseagentur, bietet Radreisen in Freiheit an.\r\nRadeln, atmen, genießen? und erleben Sie den Slow-Tourismus auf eine andere Art und Weise"
    ],
    "en": [
      "Born of a passion for nature and the Ardèche Verte, Pilat and Velay regions,\r\nDiversion Nature, a young local travel agency, designs free cycling holidays.\r\nPedal, breathe, enjoy? and experience slow tourism in a different way"
    ],
    "it": [
      "Diversion Nature è nata dalla passione per la natura e per le regioni dell'Ardèche Verte, Pilat e Velay,\r\nDiversion Nature, una giovane agenzia di viaggi locale, progetta vacanze gratuite in bicicletta.\r\nPedalate, respirate, divertitevi e vivete il turismo lento in modo diverso"
    ],
    "fr": [
      "Née d’une passion pour la nature et les territoires d’Ardèche Verte, du Pilat et du Velay,\r\nDiversion Nature, une jeune agence de voyages locale, conçoit des séjours à vélo en liberté.\r\nPédalez, respirez, savourez… et vivez le slow tourisme autrement"
    ],
    "es": [
      "Diversion Nature nació de la pasión por la naturaleza y las regiones de Ardèche Verte, Pilat y Velay,\r\nDiversion Nature, una joven agencia de viajes local, diseña vacaciones gratuitas en bicicleta.\r\nPedalee, respire, disfrute... y viva el turismo slow de otra manera"
    ],
    "nl": [
      "Diversion Nature is ontstaan uit een passie voor de natuur en de regio's Ardèche Verte, Pilat en Velay,\r\nDiversion Nature, een jong lokaal reisbureau, ontwerpt gratis fietsvakanties.\r\nTrap, adem, geniet en ervaar slow tourism op een andere manier"
    ]
  },
  "rdfs:label": {
