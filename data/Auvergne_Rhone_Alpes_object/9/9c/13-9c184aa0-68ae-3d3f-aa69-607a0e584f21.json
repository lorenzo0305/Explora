  "rdfs:comment": {
    "de": [
      "Nicolas Guilloton, Chefkoch Thomas Belval-Sana und das Team des Atelier des Augustins heißen Sie im Herzen einer natürlichen und engagierten Gastronomie willkommen. Sie laden Sie ein, eine kreative und großzügige Erfahrung zu machen."
    ],
    "en": [
      "Nicolas Guilloton, Chef Thomas Belval-Sana and the team at l'Atelier des Augustins welcome you to the heart of natural, committed gastronomy. In keeping with their new setting, they invite you to enjoy a creative and generous experience."
    ],
    "it": [
      "Nicolas Guilloton, lo chef Thomas Belval-Sana e il team dell'Atelier des Augustins vi danno il benvenuto nel cuore di una gastronomia naturale e impegnata. In linea con il nuovo ambiente, vi invitano a vivere un'esperienza creativa e generosa."
    ],
    "fr": [
      "Nicolas Guilloton, le Chef Thomas Belval-Sana et l’équipe de l’Atelier des Augustins vous accueillent au coeur d'une gastronomie nature et engagée. En toute cohérence avec leur nouvel écrin, ils vous invitent à vivre une expérience créative et généreuse."
    ],
    "es": [
      "Nicolas Guilloton, el Chef Thomas Belval-Sana y el equipo del Atelier des Augustins le dan la bienvenida al corazón de la gastronomía natural y comprometida. En consonancia con su nuevo marco, le invitan a disfrutar de una experiencia creativa y generosa."
    ],
    "nl": [
      "Nicolas Guilloton, Chef Thomas Belval-Sana en het team van Atelier des Augustins heten u welkom in het hart van de natuurlijke, geëngageerde gastronomie. In overeenstemming met hun nieuwe omgeving nodigen ze u uit om te genieten van een creatieve en genereuze ervaring."
    ]
  },
