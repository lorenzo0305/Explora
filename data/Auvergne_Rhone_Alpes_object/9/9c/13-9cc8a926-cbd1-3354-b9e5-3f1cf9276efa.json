  "rdfs:comment": {
    "de": [
      "Das Château du Bost befindet sich in einem Gebäude aus dem 19. Jahrhundert und bietet einen angenehmen Rahmen für alle, die in einer grünen Umgebung abschalten möchten."
    ],
    "en": [
      "The Château du Bost, housed in a building dating from the 19th century, offers a pleasant setting for all those who wish to relax in a green setting."
    ],
    "it": [
      "Lo Château du Bost, ospitato in un edificio del XIX secolo, offre un ambiente piacevole per chi desidera rilassarsi in un contesto verde."
    ],
    "fr": [
      "Le Château du Bost, installé dans une bâtisse datant du XIXe siècle, propose un cadre agréable à tous ceux qui désirent décompresser dans un écrin de verdure."
    ],
    "nl": [
      "Het Château du Bost, gehuisvest in een gebouw uit de 19e eeuw, biedt een aangenaam kader voor wie zich wil ontspannen in een groene omgeving."
    ],
    "es": [
      "El Château du Bost, ubicado en un edificio del siglo XIX, ofrece un entorno agradable para quienes deseen relajarse en un entorno verde."
    ]
  },
