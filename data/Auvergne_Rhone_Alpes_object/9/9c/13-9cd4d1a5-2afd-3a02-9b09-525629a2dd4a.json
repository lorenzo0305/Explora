  "rdfs:comment": {
    "de": [
      "Herstellung von Wein (rot, weiß, rosé). Ökologisch verantwortungsvoller Weinbau und Weinbereitung. Verkostung und Besichtigung nach Vereinbarung. Domaine zertifiziert nach HVE 3 (Haute Valeur Environnementale) und Mitglied der Vignerons Indépendants de France (VIF)."
    ],
    "en": [
      "Production of wines (red, white, rosé). Eco-responsible viticulture and vinification. Tasting and visit by appointment. Domain certified HVE 3 (High Environmental Value) and member of the Vignerons Indépendants de France (VIF)."
    ],
    "it": [
      "Produzione di vino (rosso, bianco, rosato). Viticoltura e vinificazione eco-responsabili. Degustazioni e visite su appuntamento. Tenuta certificata HVE 3 (Alto Valore Ambientale) e membro del Vignerons Indépendants de France (VIF)."
    ],
    "fr": [
      "Production de vins (rouge, blanc, rosé). Viticulture et vinification éco-responsables. Dégustation et visite sur rendez-vous. Domaine certifié HVE 3 (Haute Valeur Environnementale) et membre des Vignerons Indépendants de France (VIF)."
    ],
    "nl": [
      "Wijnproductie (rood, wit, rosé). Milieuvriendelijke wijnbouw en vinificatie. Proeven en bezoeken op afspraak. HVE 3 (Hoge Milieuwaarde) gecertificeerd landgoed en lid van de Vignerons Indépendants de France (VIF)."
    ],
    "es": [
      "Producción de vino (tinto, blanco, rosado). Viticultura y vinificación ecorresponsables. Degustaciones y visitas con cita previa. Finca certificada HVE 3 (Alto Valor Medioambiental) y miembro de Vignerons Indépendants de France (VIF)."
    ]
  },
