  "rdfs:comment": {
    "de": [
      "Saisonverkauf von Nüssen und Walnussöl aus kontrolliert biologischem Anbau"
    ],
    "en": [
      "Our small, family-run organic farm offers you certified organic walnuts and walnut oil. Our aim is to offer you quality products that benefit your health while respecting the environment."
    ],
    "it": [
      "La nostra piccola azienda agricola a conduzione familiare, gestita secondo criteri biologici, vi offre noci e olio di noci biologici certificati. Il nostro obiettivo è quello di offrirvi prodotti di qualità per un beneficio alla salute nel rispetto dell'ambiente."
    ],
    "fr": [
      "Notre petite exploitation familiale menée en agriculture biologique, vous propose des noix et de l’huile de noix certifiées bio. Notre volonté est de vous proposer des produits de qualité pour un bénéfice santé tout en respectant l’environnement."
    ],
    "nl": [
      "Onze kleine biologische familieboerderij biedt u gecertificeerde biologische walnoten en walnootolie. Ons doel is u kwaliteitsproducten aan te bieden die goed zijn voor de gezondheid en tegelijkertijd het milieu respecteren."
    ],
    "es": [
      "Nuestra pequeña explotación familiar, gestionada de forma ecológica, le ofrece nueces y aceite de nuez ecológicos certificados. Nuestro objetivo es ofrecerle productos de calidad para un beneficio de la salud respetando el medio ambiente."
    ]
  },
