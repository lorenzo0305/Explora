  "rdfs:comment": {
    "de": [
      "Dieser interaktive Museumsbereich gibt einen Rückblick auf die Geschichte des Ortes und seiner Umgebung des Passes von der Antike bis zur Gegenwart."
    ],
    "en": [
      "This interactive museographic space provides a retrospective of the history of the site and its surroundings from ancient times to the present day."
    ],
    "it": [
      "Questo spazio museografico interattivo offre una retrospettiva della storia del sito e dei suoi dintorni dal Col, dall'antichità ai giorni nostri."
    ],
    "fr": [
      "Cet espace muséographique interactif donne une rétrospective de l’histoire des lieux et de son environnement du Col depuis l’antiquité jusqu’à nos jours."
    ],
    "es": [
      "Este espacio museográfico interactivo ofrece una retrospectiva de la historia del yacimiento y sus alrededores desde el Col de la Antigüedad hasta nuestros días."
    ],
    "nl": [
      "Deze interactieve museografische ruimte geeft een overzicht van de geschiedenis van de site en de omgeving van de Col van de oudheid tot nu."
    ]
