  "rdfs:comment": {
    "de": [
      "Unweit des Viertels Châteaucreux befand sich die Giron-Fabrik. Jetzt ist es das L'Absinthe. Ja, man hat die Band- und Samtfabrik Giron Frères gegen ein Restaurant mit großzügiger Küche eingetauscht."
    ],
    "en": [
      "Not far from the Châteaucreux district, there used to be the Giron factory. Now it's L'Absinthe. Yes, we've swapped the Giron Frères ribbon and velvet factory for a restaurant offering generous cuisine."
    ],
    "it": [
      "Non lontano dal quartiere Châteaucreux, c'era la fabbrica Giron. Ora c'è L'Absinthe. Sì, abbiamo scambiato la fabbrica di nastri e velluti Giron Frères con un ristorante che offre una cucina generosa."
    ],
    "fr": [
      "Non loin du quartier Châteaucreux, il y avait, l’usine Giron. Maintenant, c’est L'Absinthe. Oui, on a troqué la manufacture de rubans et velours Giron Frères contre un restaurant avec une cuisine généreuse."
    ],
    "es": [
      "No lejos del barrio de Châteaucreux, antes estaba la fábrica Giron. Ahora es L'Absinthe. Sí, hemos cambiado la fábrica de cintas y terciopelos Giron Frères por un restaurante de cocina generosa."
    ],
    "nl": [
      "Niet ver van de wijk Châteaucreux stond vroeger de fabriek van Giron. Nu is het L'Absinthe. Ja, we hebben de linten- en fluwelen fabriek van Giron Frères ingeruild voor een restaurant met een royale keuken."
    ]
  },
