  "rdfs:comment": {
    "de": [
      "Mit dem Ziel, keinen Abfall zu produzieren, bietet Ihnen My Eco House lose Taschen, Furoshiki-Geschenkverpackungen, feste Kosmetika, Tawashi-Schwämme, Bentos (Lunchboxen), Edelstahlstrohhalme, waschbare Windeln, Babyartikel..."
    ],
    "en": [
      "Aiming for zero waste, My Eco House offers bulk bags, Furoshiki gift wrapping, solid cosmetics, Tawashi sponges, bentos (lunch boxes), stainless steel straws, cloth diapers, childcare items..."
    ],
    "it": [
      "My Eco House offre sacchetti sfusi, confezioni regalo Furoshiki, cosmetici solidi, spugne Tawashi, bento (scatole per il pranzo), cannucce in acciaio inossidabile, pannolini lavabili, articoli per l'infanzia..."
    ],
    "fr": [
      "Objectif zéro déchet, My Eco House vous propose des sacs en vrac, des emballages cadeaux Furoshiki, de la cosmétique solide, des éponges Tawashi, des bentos (lunch box), des pailles inox, des couches lavables, des articles de puériculture..."
    ],
    "es": [
      "My Eco House ofrece bolsas a granel, envoltorios de regalo Furoshiki, cosméticos sólidos, esponjas Tawashi, bentos (fiambreras), pajitas de acero inoxidable, pañales lavables, artículos de puericultura..."
    ],
    "nl": [
      "My Eco House biedt bulkzakken, Furoshiki geschenkverpakkingen, vaste cosmetica, Tawashi sponzen, bento's (lunchboxen), roestvrijstalen rietjes, wasbare luiers, kinderverzorgingsartikelen..."
    ]
  },
