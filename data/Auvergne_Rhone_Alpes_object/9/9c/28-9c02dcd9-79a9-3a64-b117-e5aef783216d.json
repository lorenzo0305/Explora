  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/5041731a-ee8a-330f-9141-8da9ce4efb09",
      "dc:description": {
        "de": [
          "Familienbrauerei, die 2025 im Vintage-Stil am Ufer des Flusses gegründet wurde. Unsere Küche besteht aus frischen und saisonalen Produkten, die alle 14 Tage wechseln. Für Bierliebhaber wird unsere Karte Sie begeistern."
        ],
        "en": [
          "Family-run brasserie created in 2025 in a vintage spirit by the river. Our cuisine is made with fresh, seasonal produce, changing every 15 days. For beer lovers, our menu will delight you."
        ],
        "it": [
          "Brasserie a conduzione familiare creata nel 2025 in stile vintage sulle rive del fiume. La nostra cucina si basa su prodotti freschi e di stagione che cambiano ogni quindici giorni. Per gli amanti della birra, il nostro menu vi delizierà."
        ],
        "fr": [
          "Brasserie familiale créée en 2025 dans un esprit vintage au bord de la riviere. Notre cuisine est faite de produits frais et de saison changeant tous les 15 jours. Pour les amateurs de bières, notre carte sera vous ravir."
        ],
        "nl": [
          "Familiale brasserie gecreëerd in 2025 in een vintage stijl aan de oevers van de rivier. Onze keuken is gebaseerd op verse seizoensproducten die om de twee weken veranderen. Bierliefhebbers kunnen hun hart ophalen bij ons menu."
        ],
        "es": [
          "Brasserie familiar creada en 2025 con un estilo vintage a orillas del río. Nuestra cocina se basa en productos frescos de temporada que cambian cada quince días. Para los amantes de la cerveza, nuestra carta les encantará."
        ]
      },
      "@type": [
        "Description"
      ],
