  "rdfs:comment": {
    "de": [
      "In ihrem Mosaikatelier fertigt Marie maßgeschneiderte Kreationen an: Fresken, Spiegel, Möbel, Bilder usw. Sie teilt ihre Leidenschaft im Rahmen von Animationen und führt Schulklassen in diese delikate Kunst ein, die Know-how und Kreativität vereint."
    ],
    "en": [
      "In her mosaic workshop, Marie makes bespoke creations: frescoes, mirrors, furniture, paintings... She shares her passion through events and introduces schoolchildren to this delicate art, combining expertise and creativity."
    ],
    "it": [
      "Nel suo laboratorio di mosaico, Marie realizza creazioni su misura: affreschi, specchi, mobili, dipinti... Condivide la sua passione attraverso eventi e introduce i ragazzi delle scuole a questa delicata arte, unendo competenza e creatività."
    ],
    "fr": [
      "Dans son atelier de mosaïque, Marie façonne des créations sur mesure : fresques, miroirs, mobilier, tableaux... Elle partage sa passion à travers des animations et initie les scolaires à cet art délicat, alliant savoir-faire et créativité."
    ],
    "nl": [
      "In haar mozaïekatelier maakt Marie creaties op maat: fresco's, spiegels, meubels, schilderijen... Ze deelt haar passie via evenementen en laat schoolkinderen kennismaken met deze delicate kunst door expertise en creativiteit te combineren."
    ],
    "es": [
      "En su taller de mosaicos, Marie realiza creaciones a medida: frescos, espejos, muebles, cuadros... Comparte su pasión a través de eventos e introduce a los escolares en este delicado arte, combinando experiencia y creatividad."
    ]
  },
