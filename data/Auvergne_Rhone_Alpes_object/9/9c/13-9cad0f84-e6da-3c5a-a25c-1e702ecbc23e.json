  "rdfs:comment": {
    "de": [
      "Das Lizieux-Massiv ist als Natura 2000-Gebiet und als \"Volcans en liberté\" (Vulkane in Freiheit) klassifiziert. Hier gibt es Rehe, Wildschweine, Marder, Hermeline und über 100 Vogelarten sowie seltene Arten."
    ],
    "en": [
      "The Lizieux massif is classified as a Natura 2000 area and as a \"Volcanoes in Freedom\" site. It is home to roe deer, wild boar, marten, ermine and over 100 species of birds, as well as rare species."
    ],
    "it": [
      "Il massiccio del Lizieux è classificato come sito Natura 2000 e come sito \"Vulcani in libertà\". Ospita caprioli, cinghiali, martore, ermellini e oltre 100 specie di uccelli, oltre ad alcune specie rare."
    ],
    "fr": [
      "Le massif du Lizieux est classé Espaces Natura 2000 et « Volcans en liberté » . On y rencontre chevreuil, sanglier, martre, hermine et plus de 100 espèces d’oiseaux ainsi que des espèces rares."
    ],
    "nl": [
      "Het massief van Lizieux is geclassificeerd als Natura 2000-gebied en als \"Vulkanen in vrijheid\"-gebied. Er leven reeën, wilde zwijnen, marterachtigen, hermelijnen en meer dan 100 vogelsoorten, waaronder enkele zeldzame soorten."
    ],
    "es": [
      "El macizo de Lizieux está clasificado como lugar Natura 2000 y como lugar \"Volcanes en libertad\". Alberga corzos, jabalíes, martas, armiños y más de 100 especies de aves, así como algunas especies raras."
    ]
  },
