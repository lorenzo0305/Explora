  "rdfs:comment": {
    "de": [
      "Das Restaurant des Cheval Blanc ist ein kleiner, ländlicher Ort, an dem man gerne vorbeischaut, um für nur ein paar Euro einen Happen zu essen. Überwiegend frische Produkte, Buffets, Käse - hier isst man gut und großzügig."
    ],
    "en": [
      "The Cheval Blanc restaurant is a small country place, where it is good to come and have a bite to eat for only a few euros. Mostly fresh products, buffets, cheese, we eat well and generously."
    ],
    "it": [
      "Il ristorante Cheval Blanc è un piccolo locale di campagna, dove è piacevole fare un salto per mangiare un boccone a pochi euro. Prodotti per lo più freschi, buffet, formaggi, si mangia bene e con generosità."
    ],
    "fr": [
      "Le restaurant du Cheval Blanc, c'est un petit endroit champêtre, où il fait bon passer pour manger un morceau pour seulement quelques euros. Des produits majoritairement frais, des buffets, du fromage, on y mange bien et généreusement."
    ],
    "nl": [
      "Het restaurant Cheval Blanc is een kleine landelijke plek, waar het leuk is om voor een paar euro een hapje te eten. Veelal verse producten, buffetten, kaas, je eet er goed en royaal."
    ],
    "es": [
      "El restaurante Cheval Blanc es un pequeño local campestre, donde es agradable dejarse caer para comer algo por sólo unos euros. Mayoritariamente productos frescos, buffets, quesos, se come bien y generosamente."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Cheval Blanc"
    ]
  },
