  "rdfs:comment": {
    "de": [
      "Begeben Sie sich mit Ihrem Fremdenführer, einem echten Fenotte, auf eine Bambane, bei der Sie das Viertel Croix-Rousse auf andere Weise kennenlernen werden."
    ],
    "en": [
      "Take off for a bambane with your guide, a real fenotte who will help you discover the Croix-Rousse district in a whole new way."
    ],
    "it": [
      "Partite per una bambagia con la vostra guida, una vera fenotte che vi farà scoprire il quartiere della Croix-Rousse in modo del tutto nuovo."
    ],
    "fr": [
      "Partez pour une bambane avec votre guide conférencière, vraie fenotte qui vous fera découvrir le quartier de la Croix-Rousse autrement."
    ],
    "nl": [
      "Vertrek voor een bambane met je gids, een echte fenotte die je de Croix-Rousse op een heel nieuwe manier laat ontdekken."
    ],
    "es": [
      "Embárquese en una bambane con su guía, un auténtico fenotte que le hará descubrir el barrio de la Croix-Rousse de una forma totalmente nueva."
    ]
  },
