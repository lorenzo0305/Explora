  "rdfs:comment": {
    "de": [
      "Eine traditionelle und familiäre Küche, die nach Reisen duftet. Tandoori-Huhn, Schweinefleisch mit kandierter Zitrone und typische armenische Zubereitungen auf Anfrage. Tagesgerichte zum Mitnehmen."
    ],
    "en": [
      "A traditional and family cuisine with the flavours of travel. Tandoori chicken, pork stir-fry with lemon confit and typical Armenian preparations on request. Dishes of the day to take away."
    ],
    "it": [
      "Una cucina tradizionale e familiare dal sapore di viaggio. Pollo tandoori, maiale saltato con limone conservato e piatti tipici armeni su richiesta. Piatti da asporto giornalieri."
    ],
    "fr": [
      "Une cuisine traditionnelle et familiale aux parfums de voyage. Poulet tandoori, sauté de porc au citron confit et préparations typiques arméniennes sur demande. Plats du jour à emporter."
    ],
    "es": [
      "Una cocina tradicional y familiar con sabor a viaje. Pollo tandoori, cerdo salteado con limón en conserva y platos típicos armenios por encargo. Platos del día para llevar."
    ],
    "nl": [
      "Een traditionele, familiale keuken met een reissmaak. Tandoori kip, varkensvlees sauté met geconserveerde citroen en typisch Armeense gerechten op aanvraag. Dagelijkse afhaalmaaltijden."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant \"Au Four à Bois\""
    ]
  },
