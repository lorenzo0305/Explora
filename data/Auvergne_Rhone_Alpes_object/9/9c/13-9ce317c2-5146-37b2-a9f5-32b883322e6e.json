  "rdfs:comment": {
    "de": [
      "Familiärer und herzlicher Empfang in einem überschaubaren Restaurant. Die \"Chefin\" Valérie arbeitet mit saisonalen Produkten von lokalen oder regionalen Erzeugern und legt, wann immer sie kann, Wert auf Bio-Produkte."
    ],
    "en": [
      "A warm family welcome in a modestly sized restaurant, \"chef\" Valérie works with seasonal produce from local or regional producers, and whenever possible, promotes organic produce."
    ],
    "it": [
      "Accoglienza familiare in un ristorante di dimensioni modeste, la \"chef\" Valérie lavora con prodotti di stagione provenienti da produttori locali o regionali e, quando può, pone l'accento sui prodotti biologici."
    ],
    "fr": [
      "Accueil familial et chaleureux, dans un restaurant de taille modeste, la \"cheffe\" Valérie travaille des produits de saison avec des producteurs locaux ou régionaux, et à chaque fois qu'elle le peut, met en avant le bio."
    ],
    "es": [
      "El chef Valérie trabaja con productos de temporada de productores locales o regionales y, siempre que puede, hace hincapié en los productos ecológicos."
    ],
    "nl": [
      "Een warm familie-ontvangst in een bescheiden restaurant. Chef-kok Valérie werkt met seizoensproducten van lokale of regionale producenten en legt waar mogelijk de nadruk op biologische producten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restô'bar les 2 ponts"
    ]
  },
