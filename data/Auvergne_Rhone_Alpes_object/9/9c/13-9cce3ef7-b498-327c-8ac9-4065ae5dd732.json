  "rdfs:comment": {
    "de": [
      "Als mobile Wellness-Praktikerin zu Hause oder an Ihrem Urlaubsort in den Bergen des Bourbonnaise und seiner Umgebung begleitet Sie Les Mains de Laurielle mit Wellness-Massagen, Entspannung oder Fuß- und Handreflexzonenmassage zum Wohlfühlen."
    ],
    "en": [
      "Les Mains de Laurielle is an itinerant well-being practitioner who can visit you at home or at your vacation destination in and around the Bourbonnais mountains, offering well-being massages, relaxation, foot reflexology and palm reflexology."
    ],
    "it": [
      "Les Mains de Laurielle è un operatore del benessere itinerante che può venire a trovarvi a casa o nel vostro luogo di villeggiatura sulle montagne del Bourbonnais e dintorni, proponendovi massaggi benessere, relax, riflessologia plantare e riflessologia palmare."
    ],
    "fr": [
      "Praticienne bien-être itinérante à domicile ou sur votre lieu de vacances en montagne bourbonnaise et ses alentours, Les Mains de Laurielle vous accompagnent avec des massages bien-être, la relaxation ou la réflexologie plantaire, palmaire de bien-être."
    ],
    "nl": [
      "Les Mains de Laurielle is een rondreizende schoonheidsspecialist die je thuis of op je vakantiebestemming in de bergen van Bourbonnais en omgeving kan bezoeken voor welzijnsmassages, ontspanning, voetreflexologie en palmreflexologie."
    ],
    "es": [
      "Les Mains de Laurielle es una profesional del bienestar itinerante que puede visitarle en su domicilio o en su lugar de vacaciones en las montañas de Bourbonnais y alrededores, para ofrecerle masajes de bienestar, relajación, reflexología podal y reflexología palmar."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Mains de Laurielle 03"
    ]
  },
