  "rdfs:comment": {
    "de": [
      "Ich bin seit über 30 Jahren Skilehrer und komme aus Sainte-Foy-Tarentaise. Ich biete Privatunterricht in Sainte-Foy und den umliegenden Orten an, auf und abseits der Pisten, alle Niveaus ab 3 Jahren."
    ],
    "en": [
      "Ski instructor for over 30 years, originally from Sainte-Foy-Tarentaise, I offer private lessons in Sainte-Foy and surrounding resorts, on and off piste, all levels from 3 years old."
    ],
    "it": [
      "Maestro di sci da oltre 30 anni, originario di Sainte-Foy-Tarentaise, offro lezioni private a Sainte-Foy e nelle località circostanti, su pista e fuori pista, per tutti i livelli dai 3 anni in su."
    ],
    "fr": [
      "Moniteur de ski depuis plus de 30 ans, originaire de Sainte-Foy-Tarentaise, je propose des cours privés sur Sainte-Foy et stations alentours, pistes et hors pistes, tous niveaux à partir de 3 ans."
    ],
    "es": [
      "Profesor de esquí desde hace más de 30 años, originario de Sainte-Foy-Tarentaise, ofrezco clases particulares en Sainte-Foy y las estaciones de los alrededores, dentro y fuera de pista, para todos los niveles a partir de 3 años."
    ],
    "nl": [
      "Ik ben al meer dan 30 jaar skileraar en kom oorspronkelijk uit Sainte-Foy-Tarentaise. Ik geef privélessen in Sainte-Foy en de omliggende skigebieden, op en buiten de piste, voor alle niveaus vanaf 3 jaar."
    ]
  },
  "rdfs:label": {
    "en": [
      "Olivier Empereur - Ski instructor"
    ],
    "fr": [
      "Olivier Empereur - Moniteur de ski"
    ],
    "nl": [
      "Olivier Empereur - Skileraar"
    ]
  },
