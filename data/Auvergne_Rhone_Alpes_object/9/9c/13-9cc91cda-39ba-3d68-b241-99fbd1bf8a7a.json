  "rdfs:comment": {
    "de": [
      "Is'Air Parapente ist das ganze Jahr über geöffnet, um Ihnen das Gleitschirmfliegen rund um Grenoble in der wunderschönen Landschaft des Trièves Vercors näher zu bringen."
    ],
    "en": [
      "Is'Air Parapente is open all year round to help you discover paragliding around Grenoble, in the magnificent landscapes of the Trièves Vercors."
    ],
    "it": [
      "Is'Air Parapente è aperto tutto l'anno per farvi scoprire il parapendio nei dintorni di Grenoble, nei magnifici paesaggi del Trièves Vercors."
    ],
    "fr": [
      "Is'Air Parapente est ouvert toute l'année pour vous faire découvrir le parapente autour de Grenoble, dans les magnifiques paysages du Trièves Vercors."
    ],
    "nl": [
      "Is'Air Parapente is het hele jaar geopend om u het paragliden rond Grenoble, in de prachtige landschappen van de Trièves Vercors, te laten ontdekken."
    ],
    "es": [
      "Is'Air Parapente está abierto todo el año para hacerle descubrir el parapente en los alrededores de Grenoble, en los magníficos paisajes del Vercors de Trièves."
    ]
  },
