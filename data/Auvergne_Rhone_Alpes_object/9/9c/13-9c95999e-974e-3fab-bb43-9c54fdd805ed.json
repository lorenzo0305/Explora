  "rdfs:comment": {
    "de": [
      "Besichtigung des Bauernhofs und der Produktionsbereiche mit dem Naturführer. Garten- und Gemüsegewächshäuser. Begegnung mit den Eseln und den anderen Tieren des Bauernhofs."
    ],
    "en": [
      "Farm visit and discovery of food produced by Mother Nature. Horticultural and kitchen garden greenhouses. Meet donkeys and other farm animals."
    ],
    "it": [
      "ESAT (lavoratori disabili) e fattoria didattica. Incontro con gli asini e altri animali della fattoria. Attività per bambini (mini-laboratori, feste di compleanno). Vendita di cesti di verdure, fiori e piantine. Percorso a piedi nudi. Percorso di land-art."
    ],
    "fr": [
      "ESAT (travailleurs handicapés) et ferme pédagogique. Rencontre avec les ânes et autres animaux de la ferme. Activités pour les enfants (mini-stages, anniversaires). Vente de paniers légumes, fleurs et plantons. Parcours pieds nus. Sentier Land-art."
    ],
    "es": [
      "ESAT (trabajadores discapacitados) y granja educativa. Conozca a los burros y otros animales de la granja. Actividades para niños (minitalleres, fiestas de cumpleaños). Venta de cestas de verduras, flores y plantones. Ruta de los pies descalzos. Recorrido de land-art."
    ],
    "nl": [
      "ESAT (gehandicapte werknemers) en onderwijsboerderij. Ontmoeting met de ezels en andere boerderijdieren. Activiteiten voor kinderen (mini-workshops, verjaardagen). Verkoop van groentemanden, bloemen en zaailingen. Blotevoetenpad. Land-art trail."
    ]
  },
