  "rdfs:comment": {
    "de": [
      "Als Produzenten von Gemüse aus biologischem Anbau kochen wir unsere Produkte und bieten Ihnen Burger mit Pommes frites vor Ort oder zum Mitnehmen an, begleitet von biologischen und lokalen Getränken."
    ],
    "en": [
      "As organic vegetable growers, we cook our own produce and offer fried burgers on the premises or to take away, accompanied by organic, local drinks."
    ],
    "it": [
      "In qualità di coltivatori di ortaggi biologici, cuciniamo i nostri prodotti e offriamo hamburger e patatine da consumare all'interno o da portare via, accompagnati da bevande biologiche e locali."
    ],
    "fr": [
      "Producteurs de légumes en agriculture biologique, nous cuisinons nos produits et vous proposons des burger frites sur place ou à emporter accompagnées de boissons bio et locales."
    ],
    "es": [
      "Como productores de verduras ecológicas, cocinamos nuestros propios productos y ofrecemos hamburguesas y patatas fritas para comer en casa o para llevar, acompañadas de bebidas ecológicas y locales."
    ],
    "nl": [
      "Als biologische groentetelers koken we onze eigen producten en bieden we hamburger en friet om in te eten of mee te nemen, vergezeld van biologische en lokale drankjes."
    ]
  },
  "rdfs:label": {
