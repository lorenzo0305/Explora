  "rdfs:comment": {
    "de": [
      "15 Minuten von Bourg-en-Bresse entfernt empfangen Sie Angélique und Nicolas Raquin unter der Woche. Selbstbedienungsrestaurant am Mittag, einfache und großzügige hausgemachte Küche. Formeln mit Kaffee inbegriffen. Schattige Terrasse, kostenloser Parkplatz, PMR. Schnelle Pause oder gemütliches Mittagessen."
    ],
    "en": [
      "15 min from Bourg-en-Bresse, Angélique and Nicolas Raquin welcome you on weekdays. Self-service lunchtime restaurant, simple, generous home cooking. Formulas with coffee included. Shaded terrace, free parking, PRM. Quick break or quiet lunch."
    ],
    "it": [
      "A 15 minuti da Bourg-en-Bresse, Angélique e Nicolas Raquin vi accolgono nei giorni feriali. Ristorante self-service per il pranzo, cucina casalinga semplice e generosa. Formule con caffè incluse. Terrazza ombreggiata, parcheggio gratuito, PRM. Pausa veloce o pranzo tranquillo."
    ],
    "fr": [
      "A 15 min de Bourg-en-Bresse, Angélique et Nicolas Raquin vous accueillent en semaine. Restaurant self du midi, cuisine maison simple et généreuse. Formules avec café inclus. Terrasse ombragée, parking gratuit, PMR. Pause rapide ou déjeuner tranquille."
    ],
    "nl": [
      "Op 15 minuten van Bourg-en-Bresse heten Angélique en Nicolas Raquin je welkom op werkdagen. Zelfbedieningsrestaurant voor de lunch, eenvoudige en royale keuken. Formules met koffie inbegrepen. Schaduwrijk terras, gratis parkeren, PRM. Snelle pauze of rustige lunch."
    ],
    "es": [
      "A 15 minutos de Bourg-en-Bresse, Angélique y Nicolas Raquin le dan la bienvenida entre semana. Restaurante autoservicio para el almuerzo, cocina casera sencilla y generosa. Fórmulas con café incluido. Terraza sombreada, aparcamiento gratuito, PMR. Pausa rápida o almuerzo tranquilo."
    ]
  },
  "rdfs:label": {
    "en": [
      "La Cantine des 4 chemins"
    ],
