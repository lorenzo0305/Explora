  "rdfs:comment": {
    "de": [
      "Cyclo-Ausgänge von 5 0 167 km, mit den Inhabern des BE Radfahrens und Unterstützung, Verpflegung, Begleitfahrzeug, Massage (Teilnehmer Woche) ... Alles ist geplant für geht ruhig auf den schönsten Alpen Col zu bewegen."
    ],
    "en": [
      "Cycle tours of between 50 and 167 km, accompanied by qualified instructors and with back-up, refreshment stops,  follow car, massage (weekly participants)… Everything has been well planned to ensure safe passage over some of the most beautiful mountain passes in the Alps."
    ],
    "it": [
      "Gite in bicicletta da 50 a 167 km, accompagnati da titolari del BE Cycling con assistenza, ristoro, auto al seguito, massaggio (partecipanti nei giorni feriali)... Tutto ciò di cui avete bisogno per godervi i più bei passi alpini in tutta tranquillità."
    ],
    "fr": [
      "Sorties cyclo de 50 à 167 km, accompagnées par des titulaires du BE Cyclisme avec assistance, ravitaillement, voiture suiveuse, massage (participants semaine)... Tout est prévu pour évoluer sereinement sur les plus beaux cols alpins."
    ],
    "es": [
      "Salidas ciclistas de 50 a 167 km, acompañados por titulares de la BE Cycling con asistencia, refrescos, coche de seguimiento, masajes (participantes semanales)... Todo lo que necesita para disfrutar de los más bellos puertos alpinos con total tranquilidad."
    ],
    "nl": [
      "Fietstochten van 50 tot 167 km, begeleid door houders van het BE Cycling met assistentie, versnaperingen, volgauto, massage (weekdagdeelnemers)... Alles wat je nodig hebt om met een gerust hart van de mooiste Alpenpassen te genieten."
    ]
  },
