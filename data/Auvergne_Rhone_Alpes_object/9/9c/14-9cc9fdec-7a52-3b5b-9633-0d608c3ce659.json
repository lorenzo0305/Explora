  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/8d1e9df4-d7d7-36fa-ba6a-83ceb7ae0fbe",
      "dc:description": {
        "de": [
          "Weihnachtsmarkt 2025\n- Samstag, 29. November von 12:00 bis 18:00 Uhr\n- Sonntag, 30. November von 10:00 bis 17:00 Uhr\nSchulhof - Rue de la Mairie (Straße des Rathauses)\n-----------------------------------\n-Mit 22 Ausstellern in einem Zelt - Kleine Imbisse (Pommes frites, Desserts, Getränke)\n-Besuch des Weihnachtsmanns Samstag und Sonntag von 15:00 bis 16:00 Uhr (Verteilung von Süßigkeiten)\n- Weihnachtskonzert von SWEET AND SOUL am Sonntag von 12:00 bis 15:00 Uhr.\n\nDer Eintritt ist frei\nKredite :"
        ],
        "en": [
          "Christmas Market 2025\n- Saturday, November 29, 12pm to 6pm\n- Sunday, November 30, 10am to 5pm\nSchoolyard - Rue de la Mairie\n-----------------------------------\n-With 22 exhibitors under big top - Snacks (French fries, desserts, drinks)\n-Visit from Santa Claus on Saturday and Sunday from 3pm to 4pm (distribution of sweets)\n- Christmas concert by SWEET AND SOUL on Sunday from 12pm to 3pm.\n\nFree admission\nCredits"
        ],
        "it": [
          "Mercatino di Natale 2025\n- Sabato 29 novembre dalle 12.00 alle 18.00\n- Domenica 30 novembre dalle 10.00 alle 17.00\nCortile della scuola - Rue de la Mairie\n-----------------------------------\n-Con 22 espositori sotto un tendone - Spuntini (patatine, dolci, bevande)\n-Visita di Babbo Natale sabato e domenica dalle 15.00 alle 16.00 (distribuzione di dolciumi)\n- Concerto di Natale di SWEET AND SOUL domenica dalle 12.00 alle 15.00.\n\nIngresso libero\nCrediti"
        ],
        "fr": [
          "Marché de Noël 2025\n- Samedi  29 novembre de 12h à 18h \n- Dimanche 30 novelbre de 10h à 17h\nCour de l'école - Rue de la Mairie\n-----------------------------------\n-Avec 22 exposants sous chapiteau - Petite restauration (frites, desserts, boissons)\n-Visite du Père Noël samedi et dimanche de 15h à 16h (distribution de friandises)\n- Concert de Noël par SWEET AND SOUL le dimanche de 12h à 15h.\n\nEntrée gratuite\nCrédit :"
        ],
        "es": [
          "Mercado de Navidad 2025\n- Sábado 29 de noviembre de 12.00 a 18.00 horas\n- Domingo 30 de noviembre de 10h a 17h\nPatio de la escuela - Rue de la Mairie\n-----------------------------------\n-Con 22 expositores bajo una carpa - Aperitivos (patatas fritas, postres, bebidas)\n-Visita de Papá Noel el sábado y el domingo de 15:00 a 16:00 (reparto de caramelos)\n- Concierto de Navidad de SWEET AND SOUL el domingo de 12h a 15h.\n\nEntrada gratuita\nCréditos"
        ],
        "nl": [
          "Kerstmarkt 2025\n- Zaterdag 29 november van 12 tot 18 uur\n- Zondag 30 november van 10 tot 17 uur\nBinnenplaats van de school - Rue de la Mairie\n-----------------------------------\n-Met 22 exposanten in een tent - Snacks (frietjes, desserts, drankjes)\n-Bezoek van de kerstman op zaterdag en zondag van 15 tot 16 uur (uitdelen van snoep)\n- Kerstconcert door SWEET AND SOUL op zondag van 12 tot 15 uur.\n\nGratis toegang\nCredits"
        ]
      },
