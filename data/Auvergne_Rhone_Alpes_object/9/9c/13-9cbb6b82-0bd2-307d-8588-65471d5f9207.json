  "rdfs:comment": {
    "de": [
      "Freie Besichtigung, oder Führung auf Anfrage. Dieses lebendige und sich ständig weiterentwickelnde Museum befasst sich mit dem Widerstand und den Repressionen in Montluçon und seiner Region zwischen 1939 und 1945."
    ],
    "en": [
      "Self-guided or guided tours on request. Lively and constantly evolving, this museum deals with resistance and repression in Montluçon and the surrounding area between 1939 and 1945."
    ],
    "it": [
      "Visite autogestite o guidate su richiesta. Questo museo, vivace e in continua evoluzione, tratta della Resistenza e della repressione a Montluçon e dintorni tra il 1939 e il 1945."
    ],
    "fr": [
      "Visite libre, ou guidée sur demande. Vivant et en constante évolution, ce musée traite de la résistance et des répressions à Montluçon et sa région entre 1939 et 1945."
    ],
    "es": [
      "Visitas autoguiadas o guiadas previa petición. Este museo, vivo y en constante evolución, trata sobre la Resistencia y la represión en Montluçon y sus alrededores entre 1939 y 1945."
    ],
    "nl": [
      "Rondleidingen met of zonder gids op aanvraag. Dit levendige, voortdurend veranderende museum gaat over het verzet en de onderdrukking in Montluçon en omgeving tussen 1939 en 1945."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Musée de la Résistance et de la Déportation de Montluçon et du Bourbonnais"
    ]
  },
