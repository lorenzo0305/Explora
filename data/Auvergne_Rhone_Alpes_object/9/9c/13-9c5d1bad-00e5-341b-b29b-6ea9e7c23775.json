  "rdfs:comment": {
    "de": [
      "Künstlerische Praktiken für alle!\r\nESAAA p.a. ist die Schule für Amateurpraktiken der ESAAA. Sie bietet Kindern, Jugendlichen und Erwachsenen künstlerische Aktivitäten an, unabhängig von ihren Erfahrungen und Fähigkeiten."
    ],
    "en": [
      "Artistic practice for all!\r\nESAAA p.a. is ESAAA's amateur art school. It offers artistic activities for children, teenagers and adults, whatever their level of experience and skills."
    ],
    "it": [
      "Pratica artistica per tutti!\r\nESAAA p.a. è la scuola d'arte amatoriale di ESAAA. Offre attività artistiche a bambini, adolescenti e adulti, indipendentemente dal loro livello di esperienza e capacità."
    ],
    "fr": [
      "Pratiques artistiques pour tous ! \r\nESAAA p.a. est l'école des pratiques amateurs de l'ESAAA. Elle propose aux enfants, aux adolescents et aux adultes des activités artistiques, quelque soit leur niveau d'expérience et de compétences."
    ],
    "es": [
      "Práctica artística para todos\r\nESAAA p.a. es la escuela de arte para aficionados de ESAAA. Ofrece actividades artísticas a niños, adolescentes y adultos, sea cual sea su nivel de experiencia y habilidades."
    ],
    "nl": [
      "Kunstbeoefening voor iedereen!\r\nESAAA p.a. is de amateurkunstschool van ESAAA. Ze biedt artistieke activiteiten aan kinderen, tieners en volwassenen, ongeacht hun niveau van ervaring en vaardigheden."
    ]
  },
