  "rdfs:comment": {
    "de": [
      "Die Töpferin und Keramikerin Hélène Mouton-Simonet lädt Sie ein, ihr Universum zu erkunden, das von den zugleich wilden und zarten Landschaften des Cantal und der Auvergne inspiriert ist."
    ],
    "en": [
      "Hélène Mouton-Simonet, potter and ceramist, invites you to explore her world inspired by the wild and delicate landscapes of Cantal and Auvergne."
    ],
    "it": [
      "Hélène Mouton-Simonet, ceramista, vi invita a esplorare il suo universo ispirato ai paesaggi selvaggi e delicati del Cantal e dell'Alvernia."
    ],
    "fr": [
      "Hélène Mouton-Simonet, potière-céramiste, vous invite à explorer son univers inspiré des paysages à la fois sauvages et délicats du Cantal et de l'Auvergne."
    ],
    "nl": [
      "Hélène Mouton-Simonet, pottenbakker en keramist, nodigt u uit om haar wereld te ontdekken, geïnspireerd door de wilde en delicate landschappen van de Cantal en de Auvergne."
    ],
    "es": [
      "Hélène Mouton-Simonet, ceramista, le invita a explorar su universo inspirado en los paisajes salvajes y delicados del Cantal y de Auvernia."
    ]
  },
  "rdfs:label": {
