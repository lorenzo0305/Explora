  "rdfs:comment": {
    "de": [
      "Neues Hotel in der Nähe der Hauptverkehrsachsen und auch in der Nähe des Stadtzentrums.\r\nTraditionelles Qualitätsrestaurant mit hausgemachten Produkten.\r\nBar, Roof-top im 7. Stock mit herrlichem Blick auf die Kette der Puys."
    ],
    "en": [
      "Recent hotel located close to main roads and also close to town center.\r\nTraditional quality restaurant with home-made products.\r\nBar, roof-top on the 7th floor with magnificent view of the Chaîne des Puys."
    ],
    "it": [
      "Hotel recente situato vicino alle strade principali e al centro città.\r\nRistorante tradizionale di qualità con prodotti fatti in casa.\r\nBar, roof-top al 7° piano con magnifica vista sulla catena del Puy."
    ],
    "fr": [
      "Hôtel récent situé à proximité des principaux axes routiers et également proche du centre ville.\r\nRestaurant traditionnel de qualité, produit fait-maison.\r\nBar, roof-top au 7ème étage avec magnifique vue sur la chaîne des puys."
    ],
    "nl": [
      "Recent hotel dicht bij de hoofdwegen en ook dicht bij het stadscentrum.\r\nTraditioneel kwaliteitsrestaurant met huisgemaakte producten.\r\nBar, dak op de 7e verdieping met prachtig uitzicht op het Puy-gebergte."
    ],
    "es": [
      "Hotel reciente situado cerca de las carreteras principales y también del centro de la ciudad.\r\nRestaurante tradicional de calidad con productos caseros.\r\nBar, azotea en la 7ª planta con magníficas vistas del macizo del Puy."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Roof events B&B Hôtel Clermont-Fd Centre"
    ]
  },
