  "rdfs:comment": {
    "de": [
      "Laden für lokale & solidarische Produkte mit einer Produktion und Verarbeitung von Biogemüse, der als Träger eines lernenden Sozialunternehmens dient und mehr als 30 Personen eine Brücke in die Beschäftigung ermöglicht."
    ],
    "en": [
      "A local produce and solidarity store, producing and processing organic vegetables, which supports a learning social enterprise approach, giving over 30 people access to a gateway to employment."
    ],
    "it": [
      "Un negozio di prodotti locali e di solidarietà che produce e trasforma ortaggi biologici e sostiene un approccio di impresa sociale di apprendimento, dando a più di 30 persone la possibilità di accedere a un posto di lavoro."
    ],
    "fr": [
      "Magasin de produits locaux & solidaires avec une production et une transformation de légumes bio qui sert de support à une démarche d’entreprise sociale apprenante, permettant à plus de 30 personnes d’accéder à une passerelle vers l’emploi."
    ],
    "es": [
      "Una tienda de productos locales y solidaria que produce y procesa verduras ecológicas y apoya un enfoque de empresa social de aprendizaje, dando acceso a más de 30 personas a una puerta de entrada al empleo."
    ],
    "nl": [
      "Een lokale producten- en solidariteitswinkel die biologische groenten produceert en verwerkt en een lerende sociale onderneming ondersteunt, waardoor meer dan 30 mensen toegang krijgen tot een baan."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Ateliers de la Bruyère | Magasin"
    ]
  },
