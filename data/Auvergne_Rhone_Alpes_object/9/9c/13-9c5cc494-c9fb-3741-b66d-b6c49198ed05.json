  "rdfs:comment": {
    "de": [
      "Unser Restaurant „Les Cerisiers“ bietet ein raffiniertes Tagesmenü mit einer gekonnten Mischung aus Aromen der Region, Köstlichkeiten der Saison, einer ausgewogenen Schlemmerküche und savoyischen Spezialitäten an."
    ],
    "ru": [
      "Наш ресторан Les Cerisiers изысканные и сбалансированные блюда дня, в которых объединяются ароматы местных продуктов, сезонные лакомства и савойские специалитеты."
    ],
    "en": [
      "Our restaurant \"Les Cerisiers\" offers a refined daily slate, combining a mix of flavors of the soil, seasonal delights, and Savoyard specialties."
    ],
    "it": [
      "Il nostro ristorante \"Les Cerisiers\" propone un raffinato menu giornaliero, che combina un sapiente mix di sapori locali, prelibatezze di stagione, cucina \"Equilibre Gourmand\" e specialità savoiarde"
    ],
    "fr": [
      "Notre restaurant \"les Cerisiers\" propose une ardoise journalière raffinée, alliant un savant mélange entre saveurs du terroir, délices de saison, cuisine \"Equilibre Gourmand\" et spécialités savoyardes"
    ],
    "nl": [
      "Ons restaurant \"les Cerisiers\" biedt een verfijnd dagmenu, een combinatie van lokale smaken, seizoensgebonden delicatessen, de \"Equilibre Gourmand\" keuken en Savoyaardse specialiteiten"
    ],
    "es": [
      "Nuestro restaurante \"Les Cerisiers\" ofrece un refinado menú diario que combina una inteligente mezcla de sabores locales, delicias de temporada, cocina \"Equilibre Gourmand\" y especialidades saboyanas"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Bar Les Cerisiers"
    ]
  },
