  "rdfs:comment": {
    "de": [
      "Das Hôtel Saphir ist eine wertvolle Adresse im Herzen des 9. Arrondissements. Es bietet 110 komfortable und geräumige Zimmer, ein gemütliches Restaurant, einen Fitnessraum und Tagungsräume. Ein idealer Ort für Geschäftsreisende und Städtereisende."
    ],
    "en": [
      "The Hôtel Saphir is a precious address in the heart of the 9th arrondissement, with 110 comfortable and spacious rooms, a friendly restaurant, a fitness room and meeting facilities. An ideal place for business travellers and city breaks."
    ],
    "it": [
      "L'Hôtel Saphir è un indirizzo prezioso nel cuore del 9° arrondissement, con 110 camere confortevoli e spaziose, un ristorante accogliente, una sala fitness e sale riunioni. Un luogo ideale per i viaggiatori d'affari e per le vacanze in città."
    ],
    "fr": [
      "L'Hôtel Saphir est une adresse précieuse au coeur du 9ème arrondissement, 110 chambres confortables et spacieuses, un restaurant convivial, une salle de fitness et des espaces de réunion. Un lieu idéal pour les voyageurs d'affaires et séjours urbains."
    ],
    "nl": [
      "Hôtel Saphir is een waardevol adres in het hart van het 9e arrondissement, met 110 comfortabele en ruime kamers, een gezellig restaurant, een fitnessruimte en vergaderfaciliteiten. Een ideale plek voor zakenreizigers en stedentrippers."
    ],
    "es": [
      "El Hôtel Saphir es una dirección preciosa en el corazón del distrito 9, con 110 habitaciones cómodas y espaciosas, un restaurante acogedor, una sala de fitness e instalaciones para reuniones. Un lugar ideal para viajeros de negocios y escapadas urbanas."
    ]
  },
