  "rdfs:comment": {
    "de": [
      "Inspiriert von der Weltküche (Curry Thai, Pad Thai, Butter Chicken...) und verschiedenen Einflüssen, bietet das Restaurant Bambou eine frische und schmackhafte Küche in einem gemütlichen und warmen Rahmen."
    ],
    "en": [
      "Inspired by world cuisines (Thai curry, pad Thai, butter chicken...) and a variety of influences, the restaurant Bambou offers fresh and flavourful dishes in a cozy, warm setting."
    ],
    "it": [
      "Ispirato alle cucine del mondo (Curry Thai, pad Thai, butter chicken...) e a varie influenze, il ristorante Bambou propone una cucina fresca e gustosa, in un ambiente accogliente e caldo."
    ],
    "fr": [
      "Inspiré des cuisines monde (Curry Thai, pad Thai, butter chicken...) et d'influences variées, le restaurant Bambou propose une cuisine fraîche et savoureuse, dans un cadre cosy et chaleureux."
    ],
    "es": [
      "Inspirado en las cocinas del mundo (curry tailandés, pad thai, pollo a la mantequilla...) y con influencias variadas, el restaurante Bambou ofrece una cocina fresca y sabrosa en un ambiente cálido y acogedor."
    ],
    "nl": [
      "Geïnspireerd door wereldkeukens (Thaise curry, pad Thai, boterkip...) en verschillende invloeden biedt restaurant Bambou verse, smakelijke gerechten in een warme, gezellige omgeving."
    ]
  },
