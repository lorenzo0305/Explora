  "rdfs:comment": {
    "de": [
      "Für eine hausgemachte und lokale Küche in unmittelbarer Nähe des Jachthafens Flandre Lys öffnen Sie die Tür dieses charmanten Restaurants, um regionale Gerichte zu genießen."
    ],
    "en": [
      "For homemade, local cuisine just a stone's throw from the Flandre Lys marina, push open the door of this charming restaurant to enjoy regional dishes."
    ],
    "it": [
      "Per una cucina casalinga e locale a due passi dal porto turistico di Flandre Lys, aprite la porta di questo affascinante ristorante per assaggiare i piatti regionali."
    ],
    "fr": [
      "Pour une cuisine maison et locale à deux pas du port de plaisance Flandre Lys, poussez la porte de ce charmant restaurant pour déguster des plats régionaux."
    ],
    "nl": [
      "Voor huisgemaakte, lokale gerechten op een steenworp afstand van de jachthaven Flandre Lys, duw je de deur van dit charmante restaurant open om regionale gerechten te proeven."
    ],
    "es": [
      "Para degustar una cocina casera y local a dos pasos del puerto deportivo de Flandre Lys, abra la puerta de este encantador restaurante y pruebe los platos regionales."
    ]
  },
