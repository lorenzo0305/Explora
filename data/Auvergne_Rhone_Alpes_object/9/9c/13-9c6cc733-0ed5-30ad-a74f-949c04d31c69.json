  "rdfs:comment": {
    "de": [
      "In Les Gets driven Sie mit Blick auf den Mont-Blanc!\r\nDer 18-Loch-Golfplatz Les Gets in Frankreich, 55 Minuten von Genf und 30 Minuten von der Evian Championship entfernt, bietet einen Parcours mit außergewöhnlichen Panoramen.\r\n18-Loch-Golfplatz mit 5156 Metern/ Par 70"
    ],
    "en": [
      "In Les Gets, play golf facing the Mont-Blanc!\r\nThe 18 holes Les Gets golf course is located in France at 55 min from Geneva and 30 min from Evian Championship.\r\n18-hole course of 5,156 meters / par 70"
    ],
    "it": [
      "A Les Gets, alla deriva davanti al Monte Bianco!\r\nIl campo da golf a 18 buche di Les Gets, situato in Francia a 55 minuti da Ginevra e a 30 minuti dal campionato di Evian, offre un percorso con panorami eccezionali.\r\nCampo a 18 buche di 5156 metri/par 70"
    ],
    "fr": [
      "Aux Gets, drivez face au Mont-Blanc !\r\nLe Golf 18 trous des Gets, situé en France à 55 minutes de Genève et à 30 minutes de l'Evian Championship, propose un parcours avec des panoramas exceptionnels.\r\nParcours de 18 trous de 5156 mètres/par 70"
    ],
    "nl": [
      "In Les Gets, golfen met uitzicht op de Mont-Blanc!\r\nDe 18-holes golfbaan van Les Gets, gelegen in Frankrijk op 55 minuten van Genève en op 30 minuten van de kampioenschappen in Evian, biedt een parcours met uitzonderlijke panorama's.\r\n18-holes baan van 5156 meter/ 70 par"
    ],
    "es": [
      "En Les Gets, ¡a la deriva frente al Mont-Blanc!\r\nEl campo de golf de 18 hoyos de Les Gets, situado en Francia a 55 minutos de Ginebra y a 30 minutos del campeonato de Evian, ofrece un recorrido con panoramas excepcionales.\r\nCampo de 18 hoyos de 5156 metros/par 70"
    ]
  },
