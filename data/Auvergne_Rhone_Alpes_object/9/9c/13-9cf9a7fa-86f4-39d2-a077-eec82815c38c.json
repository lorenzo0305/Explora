  "rdfs:comment": {
    "de": [
      "Ein kurzer Unterschlupf für Pilger auf dem Weg nach Santiago de Compostela. Das Werk besteht aus monolithischen Blöcken aus erratischem Granit, die an Ort und Stelle gefunden, behauen und trocken zusammengefügt wurden, um den Sockel zu bilden."
    ],
    "en": [
      "Brief shelter for pilgrims on their way to Santiago de Compostela. The work is made up of monolithic blocks of erratic granite found on site, cut and dry-fitted to form the base."
    ],
    "it": [
      "Un riparo grezzo per i pellegrini in cammino verso Santiago de Compostela. L'opera è composta da blocchi monolitici di granito erratico trovati sul posto, tagliati e montati a secco per formare la base."
    ],
    "fr": [
      "Abri sommaire pour les pèlerins, en chemin sur Saint-Jacques de Compostelle. L’œuvre est constitué de blocs monolithiques de granites erratiques trouvés sur place, taillés et appareillés à sec pour constituer le socle."
    ],
    "es": [
      "Un tosco refugio para los peregrinos que se dirigen a Santiago de Compostela. La obra se compone de bloques monolíticos de granito errático encontrados in situ, cortados y encajados en seco para formar la base."
    ],
    "nl": [
      "Een ruwe schuilplaats voor pelgrims op weg naar Santiago de Compostela. Het werk is opgebouwd uit monolithische blokken grillig graniet die ter plekke zijn gevonden, gezaagd en droog gemonteerd om de basis te vormen."
    ]
  },
