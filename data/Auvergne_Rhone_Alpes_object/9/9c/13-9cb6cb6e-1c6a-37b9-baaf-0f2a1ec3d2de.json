  "rdfs:comment": {
    "de": [
      "Es handelt sich um die kleinste Bibliothek des Netzwerks Bièvre Isère.\r\nDas ausschließlich ehrenamtliche Team verwaltet auf 32m² ca. 2500 Bücher.\r\nDie Bibliothek bietet einen regelmäßigen Empfang für Kindergartenklassen."
    ],
    "en": [
      "This is the smallest library in the Bièvre Isère network.\r\nThe all-volunteer team manages around 2,500 books in a 32m² space.\r\nIt regularly welcomes kindergarten classes."
    ],
    "it": [
      "È la biblioteca più piccola della rete Bièvre Isère.\r\nIl team di volontari gestisce circa 2.500 libri in uno spazio di 32 m².\r\nAccoglie regolarmente classi di asili nido."
    ],
    "fr": [
      "Il s’agit de la plus petite bibliothèque du réseau Bièvre Isère.\r\nL'équipe entièrement bénévole gère dans 32m² environ 2500 ouvrages.\r\nElle assure un accueil régulier des classes de maternelle."
    ],
    "nl": [
      "Het is de kleinste bibliotheek van het Bièvre Isère-netwerk.\r\nHet vrijwilligersteam beheert ongeveer 2.500 boeken in een ruimte van 32 m².\r\nEr worden regelmatig kleuterklassen ontvangen."
    ],
    "es": [
      "Es la biblioteca más pequeña de la red Bièvre Isère.\r\nEl equipo de voluntarios gestiona unos 2.500 libros en un espacio de 32 m².\r\nAcoge regularmente clases de parvulario."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Bibliothèque \"PenoLire\""
    ]
  },
