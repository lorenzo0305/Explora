          "additionalInformation": {
            "de": [
              "Montag von 17:00 bis 18:30 Uhr\r\nMittwoch von 15:30 bis 18:00 Uhr\r\nAn Feiertagen geschlossen\r\nDen ganzen August über geschlossen\r\nEine Woche zwischen Weihnachten und Neujahr geschlossen.\r\n(Der gesamte Kalender ist in der PenoLire-Bibliothek erhältlich)."
            ],
            "en": [
              "Monday, 5 to 6:30 p.m\r\nWednesday from 3:30 pm to 6:00 pm\r\nClosed on public holidays\r\nClosed all of August\r\nClosed for one week between Christmas and New Year's Day.\r\n(Full calendar available at the PenoLire Library)."
            ],
            "it": [
              "Lunedì dalle 17.00 alle 18.30\r\nMercoledì dalle 15.30 alle 18.00\r\nChiuso nei giorni festivi\r\nChiuso per tutto il mese di agosto\r\nChiuso per una settimana tra Natale e Capodanno.\r\n(Il calendario completo è disponibile presso la Biblioteca PenoLire)."
            ],
            "fr": [
              "Lundi de 17h à 18h30\r\nMercredi de 15h30 à 18h\r\nFermé les jours fériés\r\nFermeture tout le mois d'août \r\nFermeture une semaine entre Noël et le jour de l'an.\r\n(Calendrier entier disponible à la Bibliothèque PenoLire)."
            ],
            "nl": [
              "Maandag van 17u tot 18u30\r\nWoensdag van 15.30 tot 18.00 uur\r\nGesloten op feestdagen\r\nDe hele maand augustus gesloten\r\nTussen Kerstmis en Nieuwjaar een week gesloten.\r\n(Volledige kalender beschikbaar in de PenoLire Bibliotheek)."
            ],
            "es": [
              "Lunes de 17.00 a 18.30\r\nMiércoles de 15h30 a 18h00\r\nCerrado los días festivos\r\nCerrado en agosto\r\nCerrado una semana entre Navidad y Año Nuevo.\r\n(Calendario completo disponible en la Biblioteca PenoLire)."
            ]
          },
