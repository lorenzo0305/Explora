  "rdfs:comment": {
    "de": [
      "Büro des Fremdenverkehrsamts des Val d´Arly in La Giettaz en Aravis.\r\nPublikumsempfang, Auskünfte, Dokumentation, Reservierungen und Buchungen, Shop, Ticketverkauf, Kundenservice.\r\nZögern Sie nicht, bei uns vorbeizuschauen!\r\nGeldautomat in der Eingangshalle."
    ],
    "en": [
      "Tourist Office of Val d'Arly bureau in La Giettaz en Aravis. Welcome of the public, information, documentation, booking, ticket office, shop, service. Do not hesitate to come and visit us! ATM in the lobby."
    ],
    "it": [
      "Ufficio dell'Ufficio del Turismo della Val d'Arly a La Giettaz en Aravis.\r\nAccoglienza del pubblico, informazioni, documentazione, prenotazioni, biglietteria, negozio, servizio.\r\nNon esitate a venirci a trovare.\r\nBancomat all'ingresso."
    ],
    "fr": [
      "Bureau de l'Office de Tourisme du Val d'Arly à la Giettaz en Aravis.\r\nAccueil du public, renseignements, documentation, réservations, billetterie, boutique, service.\r\nN'hésitez pas à venir nous rendre visite.\r\nDistributeur d'argent dans le hall d'entrée."
    ],
    "es": [
      "Oficina de Turismo de Val d'Arly en La Giettaz en Aravis.\r\nRecepción del público, información, documentación, reservas, venta de entradas, tienda, servicio.\r\nNo dude en venir a visitarnos.\r\nCajero automático en el vestíbulo."
    ],
    "nl": [
      "Kantoor van het toeristenbureau van Val d'Arly in La Giettaz en Aravis.\r\nOntvangst van het publiek, informatie, documentatie, reserveringen, kaartverkoop, winkel, service.\r\nAarzel niet om ons te komen bezoeken.\r\nGeldautomaat in de hal."
    ]
  },
