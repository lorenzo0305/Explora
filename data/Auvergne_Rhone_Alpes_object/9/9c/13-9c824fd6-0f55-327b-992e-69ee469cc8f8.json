  "rdfs:comment": {
    "de": [
      "Nach zwei ausverkauften Veranstaltungen und einer Arenatour kehrt die BLACKLINER FREESTYLE SHOW in den Zénith d'Auvergne zurück! Erleben Sie eine atemberaubende Show, die Extremsportarten, Pyrotechnik, Licht und Ton zu einem intensiven und unvergesslichen Moment vereint, den Sie mit anderen teilen können."
    ],
    "en": [
      "After 2 sold-out dates and a tour of the Arenas, the BLACKLINER FREESTYLE SHOW returns to the Zénith d?Auvergne! Experience a breathtaking show combining extreme sports, pyrotechnics, sound and light, for an intense and unforgettable moment to share."
    ],
    "it": [
      "Dopo 2 date di tutto esaurito e un tour delle arene, il BLACKLINER FREESTYLE SHOW torna allo Zénith d'Auvergne! Vivete uno spettacolo mozzafiato che combina sport estremi, pirotecnica, suoni e luci, per un'esperienza intensa e indimenticabile."
    ],
    "fr": [
      "Après 2 dates complètes et une tournée des Arenas, le BLACKLINER FREESTYLE SHOW revient au Zénith d’Auvergne ! Vivez un spectacle époustouflant mêlant sports extrêmes, pyrotechnie, sons et lumières, pour un moment intense et inoubliable à partager."
    ],
    "es": [
      "Tras 2 fechas con entradas agotadas y una gira por las Arenas, ¡el BLACKLINER FREESTYLE SHOW vuelve al Zénith d'Auvergne! Disfrute de un espectáculo impresionante que combina deportes extremos, pirotecnia, sonido y luz, para vivir una experiencia intensa e inolvidable."
    ],
    "nl": [
      "Na 2 uitverkochte data en een tournee langs de Arenas keert de BLACKLINER FREESTYLE SHOW terug naar de Zénith d'Auvergne! Beleef een adembenemende show die extreme sporten, pyrotechniek, geluid en licht combineert voor een intense en onvergetelijke ervaring."
    ]
  },
  "rdfs:label": {
