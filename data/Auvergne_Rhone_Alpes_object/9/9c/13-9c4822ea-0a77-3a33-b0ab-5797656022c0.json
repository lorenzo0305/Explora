  "rdfs:comment": {
    "de": [
      "Von Hostun aus, einem Dorf im Departement Drôme am Fuße des Vercors und im Herzen der Monts du Matin, können Sie die technischen Wege zur Pré de la Sophie oder zur Pré de Cinq Sous alleine, in einer Staffel oder im Duo begehen."
    ],
    "en": [
      "From Hostun, a Drôme village at the foot of the Vercors and in the heart of the Monts du Matin, come and tread the technical paths that will take you to the Pré de la Sophie or the Pré de Cinq Sous, solo, in a relay or in a duo."
    ],
    "it": [
      "Da Hostun, villaggio della Drôme situato ai piedi del Vercors e nel cuore dei Monts du Matin, venite a percorrere i sentieri tecnici che vi porteranno al Pré de la Sophie o al Pré de Cinq Sous, in solitaria, in staffetta o in duo."
    ],
    "fr": [
      "Depuis Hostun, village de la Drôme situé au pied du Vercors et au cœur des Monts du Matin, venez fouler les chemins techniques qui vous mèneront au pré de la Sophie ou au pré de Cinq Sous, en solo, en relais ou en duo."
    ],
    "nl": [
      "Kom vanuit Hostun, een dorpje in de Drôme aan de voet van de Vercors en in het hart van de Monts du Matin, de technische paden bewandelen die je naar de Pré de la Sophie of de Pré de Cinq Sous brengen, solo, in estafette of in duo."
    ],
    "es": [
      "Desde Hostun, pueblo de la Drôme situado a los pies del Vercors y en el corazón de los Monts du Matin, ven a recorrer los senderos técnicos que te llevarán al Pré de la Sophie o al Pré de Cinq Sous, en solitario, en relevos o en dúo."
    ]
  },
  "rdfs:label": {
    "fr": [
