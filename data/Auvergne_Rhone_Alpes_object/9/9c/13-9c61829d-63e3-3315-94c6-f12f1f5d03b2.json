  "rdfs:comment": {
    "de": [
      "Das Kloster in Salles-Arbuissonnas, Juwel des Beaujolais am Kreuzungspunkt von Kunst und Geschichte. Ein permanenter Ausstellungsbereich lässt den Besucher das letzte römische Kloster im Departement Rhône entdecken."
    ],
    "en": [
      "This 12th century cloister of golden stones, Benedictine monks, canonesses-comttesses etc. is a magnificent site rich in fascinating history worth discovering or re-discovering."
    ],
    "it": [
      "Un chiostro in pietra dorata del XII secolo, monaci benedettini, canonichesse e principesse? Un sito magnifico e una storia affascinante da scoprire o riscoprire."
    ],
    "fr": [
      "Un cloître en pierres dorées du XIIe siècle, des moines bénédictins, des chanoinesses-comtesses… Un magnifique site et une histoire passionnante à découvrir ou à-redécouvrir."
    ],
    "es": [
      "¿Un claustro de piedra dorada del siglo XII, monjes benedictinos, canónigos y princesas? Un sitio magnífico y una historia fascinante para descubrir o redescubrir."
    ],
    "nl": [
      "Een gouden stenen klooster uit de 12e eeuw, benedictijner monniken, kanunniken en prinsessen... Een prachtige plek met een fascinerende geschiedenis om te (her)ontdekken."
    ]
  },
