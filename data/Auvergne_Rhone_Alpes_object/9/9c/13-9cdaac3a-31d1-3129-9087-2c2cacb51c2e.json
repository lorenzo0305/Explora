  "rdfs:comment": {
    "de": [
      "In het hart van de Presqu'île de Lyon, in een eigentijdse setting en een vriendelijke sfeer, kunt u elke dag van 12.00 tot 14.30 uur genieten van een traditionele kwaliteitskeuken, bereid met verse producten. Aperitiefplanken en tapas in de avond."
    ],
    "en": [
      "In the heart of the Presqu'île of Lyon, in a contemporary setting and a friendly atmosphere, come and enjoy traditional quality cuisine, prepared with fresh produce every day from 12 p.m. to 2.30 p.m. Aperitif boards and tapas in the evening."
    ],
    "it": [
      "Nel cuore della Presqu'île de Lyon, in un ambiente contemporaneo e un'atmosfera amichevole, venite a gustare una cucina tradizionale di qualità, preparata con prodotti freschi tutti i giorni dalle 12:00 alle 14:30. Aperitivi e tapas la sera."
    ],
    "fr": [
      "Au cœur de la Presqu’île de Lyon, dans un cadre contemporain et une ambiance conviviale, venez déguster une cuisine traditionnelle de qualité, élaborée à base de produits frais tous les jours de 12h à 14h30. Planches apéro et tapas en soirée."
    ],
    "nl": [
      "In het hart van het Presqu?île van Lyon, in een eigentijds kader en een gezellige sfeer, kunt u elke dag van 12.00 tot 14.30 uur genieten van een traditionele kwaliteitskeuken, bereid met verse producten. Aperitief en tapas 's avonds."
    ],
    "es": [
      "En el corazón de la Presqu’île de Lyon, en un marco contemporáneo y un ambiente agradable, venga a disfrutar de una cocina tradicional de calidad, elaborada con productos frescos todos los días de 12:00 a 14:30 horas. Tablas de aperitivos y tapas por la noche."
    ]
  },
