      "rdfs:comment": {
        "de": [
          "Die Familie Piron, seit sieben Generationen Webexperten in Godewaersvelde, stellt Stoffe made in France her, sowohl für dekorative als auch für technische Zwecke. Entdecken Sie im Fabrikladen ihre Produktionen und importierte Stoffe."
        ],
        "en": [
          "The Piron family, weaving experts for 7 generations in Godewaersvelde, manufactures fabric made in France, for decorative or technical use. Discover their productions and imported fabrics in the factory store."
        ],
        "it": [
          "La famiglia Piron, esperta di tessitura da 7 generazioni a Godewaersvelde, produce tessuti made in France, per uso decorativo o tecnico. Scoprite i loro prodotti e i tessuti importati nel negozio della fabbrica."
        ],
        "fr": [
          "La famille Piron, experte en tissage depuis 7 générations à Godewaersvelde, fabrique du tissu made in France, à usage décoratif ou technique. Découvrez dans le magasin d’usine ses productions et des tissus d’importation."
        ],
        "es": [
          "La familia Piron, experta en tejer desde hace 7 generaciones en Godewaersvelde, fabrica tejidos made in France, para uso decorativo o técnico. Descubre sus productos y tejidos importados en la tienda de la fábrica."
        ],
        "nl": [
          "De familie Piron, al 7 generaties lang experts in weven in Godewaersvelde, vervaardigt stoffen van Franse makelij, voor decoratief of technisch gebruik. Ontdek hun producten en geïmporteerde stoffen in de fabriekswinkel."
        ]
      },
