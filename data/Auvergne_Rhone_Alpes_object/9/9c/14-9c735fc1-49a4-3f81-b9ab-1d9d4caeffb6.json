  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/ef7d111d-823d-3301-a05b-ce7cd7cedca9",
      "dc:description": {
        "de": [
          "Das Team der Agence de l'Étoile steht Ihnen für die Schätzung, den Kauf und den Verkauf von Häusern, Wohnungen oder Grundstücken in Stella-plage, Cucq, Merlimont und Umgebung zur Verfügung."
        ],
        "en": [
          "The Agence de l'Étoile team is at your service for the valuation, purchase and sale of houses, apartments or land in the Stella-plage, Cucq, Merlimont and surrounding areas."
        ],
        "it": [
          "Il team dell'Agence de l'Étoile è al vostro servizio per la valutazione, l'acquisto e la vendita di case, appartamenti e terreni nelle zone di Stella-plage, Cucq, Merlimont e dintorni."
        ],
        "fr": [
          "L'équipe de l'Agence de l'Étoile est à votre service pour l'estimation, l'achat et la vente de maisons, appartements ou terrains dans les secteurs de Stella-plage, Cucq, Merlimont et leurs alentours."
        ],
        "nl": [
          "Het team van Agence de l'Étoile staat tot uw dienst voor de taxatie, aankoop en verkoop van huizen, appartementen en grond in de gebieden Stella-plage, Cucq, Merlimont en omgeving."
        ],
        "es": [
          "El equipo de la Agence de l'Étoile está a su servicio para la valoración, compra y venta de casas, pisos y terrenos en las zonas de Stella-plage, Cucq, Merlimont y alrededores."
        ]
      },
