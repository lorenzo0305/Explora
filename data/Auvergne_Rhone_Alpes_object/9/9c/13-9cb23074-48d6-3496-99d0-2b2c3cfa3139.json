  "rdfs:comment": {
    "de": [
      "OUPS l'Echoppe Créative vereint 17 Designerinnen aus der Region Drôme Ardèche, deren Vereinsladen dem lokalen Kunsthandwerk gewidmet ist. Alle angebotenen Stücke sind einzigartig, handgefertigt und lokal."
    ],
    "en": [
      "OUPS l'Echoppe Créative brings together 17 designers from the Drôme Ardèche region, with a boutique dedicated to local crafts. All the items on offer are unique, handmade and local."
    ],
    "it": [
      "OUPS l'Echoppe Créative riunisce 17 designer della regione Drôme Ardèche e gestisce una boutique dedicata all'artigianato locale. Tutti gli articoli offerti sono unici, fatti a mano e locali."
    ],
    "fr": [
      "OUPS l'Echoppe Créative réunit 17 créatrices de Drôme Ardèche, dont la boutique associative est dédiée à l'artisanat local. Toutes les pièces proposées sont uniques, faites main et locales."
    ],
    "nl": [
      "OUPS l'Echoppe Créative verenigt 17 ontwerpers uit de Drôme Ardèche en heeft een boetiek gewijd aan lokale ambachten. Alle aangeboden artikelen zijn uniek, handgemaakt en lokaal."
    ],
    "es": [
      "OUPS l'Echoppe Créative reúne a 17 diseñadores de la región de Drôme Ardèche y gestiona una boutique dedicada a la artesanía local. Todos los artículos que se ofrecen son únicos, hechos a mano y locales."
    ]
  },
