  "rdfs:comment": {
    "de": [
      "Wir, Homo sapiens, weiser Mensch\r\n\r\nAusstellung mit zehn Tafeln, die ab dem 2. Mai 2025 außerhalb des Museums im Unterholz zu sehen ist.\r\n\r\nProduktion Double Helix."
    ],
    "en": [
      "We, Homo sapiens, wise man\r\n\r\nTen-panel exhibition to be seen outside the Museum, in the undergrowth, from May 2, 2025.\r\n\r\nProduced by Double Hélice."
    ],
    "it": [
      "Noi, Homo sapiens, l'uomo saggio\r\n\r\nMostra di dieci pannelli da vedere all'esterno del Museo, nel sottobosco, dal 2 maggio 2025.\r\n\r\nProdotta da Double Hélice."
    ],
    "fr": [
      "Nous, Homo sapiens, Homme sage\r\n\r\nExposition en dix panneaux à voir à l'extérieur du Musée, dans le sous bois, à partir du 2 mai 2025.\r\n\r\nProduction Double Hélice."
    ],
    "nl": [
      "Wij, Homo sapiens, de wijze mens\r\n\r\nTentoonstelling met tien panelen, te zien buiten het museum, in het kreupelhout, vanaf 2 mei 2025.\r\n\r\nGeproduceerd door Double Hélice."
    ],
    "es": [
      "Nosotros, Homo sapiens, el sabio\r\n\r\nExposición de diez paneles que podrá verse en el exterior del Museo, entre la maleza, a partir del 2 de mayo de 2025.\r\n\r\nProducida por Double Hélice."
    ]
  },
