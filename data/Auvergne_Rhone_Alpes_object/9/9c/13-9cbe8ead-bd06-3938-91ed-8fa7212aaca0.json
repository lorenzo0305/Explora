  "rdfs:comment": {
    "de": [
      "Der Skatepark verfügt über eine Rampen-Rutschbahn, einen Doppelbuckel, eine Pyramide und eine Treppe. Er ermöglicht es Anfängern, sich gefahrlos auszuprobieren, und Fortgeschrittenen, spektakuläre Tricks zu zeigen."
    ],
    "en": [
      "The Skate Park features a slide ramp, double moguls, pyramid and staircase. It's a safe place for beginners to express themselves, and for more experienced skaters to perform spectacular tricks."
    ],
    "it": [
      "Lo Skate Park dispone di una rampa per scivoli, un doppio mogul, una piramide e una scala. Permette ai principianti di esprimersi senza pericoli e ai più esperti di fare trucchi spettacolari."
    ],
    "fr": [
      "Le Skate Park dispose d'une rampe-glissière, d'une double bosses, d'une pyramide, et d'un escalier. Il permet aux débutants de s'exprimer sans danger et aux plus expérimentés de faire des figures spectaculaires."
    ],
    "nl": [
      "Het skatepark heeft een glijbaan, dubbele bulten, een piramide en een trap. Het is een veilige plek voor beginners om zich te uiten en voor meer ervaren skaters om spectaculaire trucs uit te voeren."
    ],
    "es": [
      "El Skate Park cuenta con una rampa de deslizamiento, un doble mogul, una pirámide y una escalera. Permite a los principiantes expresarse sin peligro y a los más experimentados hacer trucos espectaculares."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Skate parc"
    ]
  },
