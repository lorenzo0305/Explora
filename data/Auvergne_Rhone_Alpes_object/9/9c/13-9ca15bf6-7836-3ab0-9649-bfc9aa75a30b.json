  "rdfs:comment": {
    "de": [
      "Neuheit 2024 :\r\nStellen Sie sich der Herausforderung: Begeben Sie sich auf ein Abenteuer in der Natur, zwischen Teichen und Tierparks.\r\n\r\nFolgen Sie mit Freunden oder der Familie den Hinweisen und beantworten Sie die Rätsel auf Ihrer Reise, um den letzten Schatz zu gewinnen!"
    ],
    "en": [
      "New for 2024:\r\nCome and take up the challenge: set off on an adventure in the heart of nature, between ponds and animal parks.\r\n\r\nWith friends or family, follow the clues and answer the riddles along the way, to win the final treasure!"
    ],
    "it": [
      "Novità 2024:\r\nVenite a raccogliere la sfida: partite per un'avventura nel cuore della natura, tra uno stagno e un parco animali.\r\n\r\nCon gli amici o la famiglia, seguite gli indizi e rispondete agli indovinelli lungo il percorso per vincere il tesoro finale!"
    ],
    "fr": [
      "Nouveauté 2024 :\r\nVenez relever le défi : partez à l’aventure en pleine nature, entre étang et parc animaliers.\r\n\r\nEntre amis ou en famille,  suivez les indices et répondez aux énigmes durant votre périple, pour remporter le trésor final !"
    ],
    "es": [
      "Novedad para 2024 :\r\nVen y acepta el reto: lánzate a la aventura en plena naturaleza, entre un estanque y un parque de animales.\r\n\r\nCon amigos o en familia, ¡sigue las pistas y responde a los acertijos por el camino para ganar el tesoro final!"
    ],
    "nl": [
      "Nieuw in 2024:\r\nGa de uitdaging aan: ga op avontuur midden in de natuur, tussen een vijver en een dierenpark.\r\n\r\nVolg met vrienden of familie de aanwijzingen en beantwoord de raadsels onderweg om de uiteindelijke schat te winnen!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Escape Quest"
    ]
  },
