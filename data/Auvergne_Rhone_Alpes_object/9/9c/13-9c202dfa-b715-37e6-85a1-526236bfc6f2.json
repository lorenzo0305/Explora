  "rdfs:comment": {
    "de": [
      "Nur 7 Minuten von Eurexpo und 10 Minuten vom Flughafen Saint-Exupéry entfernt, profitieren Sie von einem angenehmen Rahmen, der die Vorteile des Landes mit der Nähe zur Stadt vereint."
    ],
    "en": [
      "At only 7 minutes to Eurexpo and 10 minutes to Saint-Exupéry Airport, enjoy\r\na pleasant combining advantages of the country and near the city."
    ],
    "it": [
      "A soli 7 minuti da Eurexpo e a 10 minuti dall'aeroporto Saint-Exupéry, approfitta di una gradevole ambientazione che unisce i vantaggi della campagna e la vicinanza alla città."
    ],
    "fr": [
      "A seulement 7 minutes d'Eurexpo et 10 minutes de l'aéroport Saint-Exupéry, profitez d'un cadre agréable alliant avantages de la campagne et proximité de la ville."
    ],
    "nl": [
      "Op slechts 7 minuten van Eurexpo en 10 minuten van de luchthaven Saint-Exupéry, geniet u van een aangename omgeving die de voordelen van het platteland combineert met de nabijheid van de stad."
    ],
    "es": [
      "A tan solo 7 minutos de Eurexpo y 10 minutos del aeropuerto Saint-Exupéry, disfrute de un marco agradable que alía las ventajas del campo y la cercanía a la ciudad."
    ]
  },
