  "rdfs:comment": {
    "de": [
      "Im Herzen des Dorfes La Chèvrerie befindet sich La Tête au Moine, eine Bar und ein Restaurant.\r\nAm Fuße der Skipisten und am Ausgangspunkt für Wanderungen."
    ],
    "en": [
      "In the heart of La Chèvrerie resort at the foot of the mountain awaits the Tête au Moine team for a warming drink, delicious meal or boogie in the pub(weekends)."
    ],
    "it": [
      "Nel cuore del villaggio di La Chèvrerie, La Tête au Moine è un bar e ristorante.\r\nAi piedi delle piste da sci e all'inizio dei sentieri escursionistici."
    ],
    "fr": [
      "Au cœur du village de la Chèvrerie, La Tête au Moine est un bar, restaurant.\r\nAu pied des pistes de ski et au départ des randonnées pédestres."
    ],
    "nl": [
      "In het hart van het dorp La Chèvrerie ligt La Tête au Moine, een bar en restaurant.\r\nAan de voet van de skipistes en aan het begin van wandelpaden."
    ],
    "es": [
      "En el corazón del pueblo de La Chèvrerie, La Tête au Moine es un bar y restaurante.\r\nAl pie de las pistas de esquí y al inicio de las rutas de senderismo."
    ]
  },
