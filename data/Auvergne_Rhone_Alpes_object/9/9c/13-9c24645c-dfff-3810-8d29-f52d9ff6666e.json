  "rdfs:comment": {
    "de": [
      "Vereinsladen, der vor allem regionale und lokale Produkte anbietet, aber auch touristische Dokumentationen über die Montagne bourbonnaise. Er wird von begeisterten Freiwilligen betrieben."
    ],
    "en": [
      "A community-run grocery store primarily offering regional and local products, as well as tourist information about the Montagne Bourbonnaise. Managed by dedicated and passionate volunteers."
    ],
    "it": [
      "Un negozio di alimentari comunitario che vende principalmente prodotti regionali e locali, oltre a letteratura turistica sulla Montagne Bourbonnaise. È gestito da volontari entusiasti."
    ],
    "fr": [
      "Epicerie associative proposant majoritairement des produits régionaux et locaux mais aussi de la documentation touristique sur la Montagne bourbonnaise. Elle est gérée par des bénévoles passionnés."
    ],
    "es": [
      "Una tienda de comestibles comunitaria que vende principalmente productos regionales y locales, así como literatura turística sobre la Montagne Bourbonnaise. Está gestionada por voluntarios entusiastas."
    ],
    "nl": [
      "Een kruidenierswinkel die voornamelijk regionale en lokale producten verkoopt, evenals toeristische literatuur over de Montagne Bourbonnaise. De winkel wordt gerund door enthousiaste vrijwilligers."
    ]
  },
