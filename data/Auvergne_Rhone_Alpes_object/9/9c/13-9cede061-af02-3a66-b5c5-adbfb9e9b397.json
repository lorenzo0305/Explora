  "rdfs:comment": {
    "de": [
      "Besuchen Sie die Kirche auf eigene Faust. Dieses Gebäude aus dem 12. Jahrhundert wurde in der Neuzeit extrem umgebaut. Nur die Teile aus dem 12. Jahrhundert sind ISMH."
    ],
    "en": [
      "Self-guided tour. This 12th-century building underwent extensive alterations in modern times. Only the 12th-century parts are ISMH listed."
    ],
    "it": [
      "Ingresso libero. Questo edificio del XII secolo ha subito ampie modifiche in epoca moderna. Solo le parti del XII secolo sono classificate come ISMH."
    ],
    "fr": [
      "Visite libre. Cet édifice du XIIe siècle a été extrêmement remanié à l'époque moderne. Seules les parties du XIIe siècle sont ISMH."
    ],
    "nl": [
      "Gratis toegang. Dit 12e-eeuwse gebouw onderging ingrijpende verbouwingen in de moderne tijd. Alleen de 12e-eeuwse delen staan op de ISMH-lijst."
    ],
    "es": [
      "Entrada gratuita. Este edificio del siglo XII sufrió grandes reformas en la época moderna. Sólo las partes del siglo XII están catalogadas como ISMH."
    ]
  },
