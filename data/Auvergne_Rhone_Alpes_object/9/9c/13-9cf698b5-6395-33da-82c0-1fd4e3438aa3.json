  "rdfs:comment": {
    "de": [
      "Willkommen im Restaurant Le Florian, das sich in der charmanten Stadt Avermes befindet. Unser Lokal ist auf italienische Spezialitäten spezialisiert, wobei wir besonderen Wert auf die Qualität der Zutaten und die Zubereitung unserer Gerichte legen."
    ],
    "en": [
      "Welcome to the restaurant Le Florian, located in the charming town of Avermes. Our establishment is specialized in Italian specialties, with a particular attention to the quality of the ingredients and the preparation of our dishes."
    ],
    "it": [
      "Benvenuti al ristorante Le Florian, situato nell'incantevole cittadina di Avermes. Il nostro ristorante è specializzato in specialità italiane, con particolare attenzione alla qualità degli ingredienti e alla preparazione dei piatti."
    ],
    "fr": [
      "Bienvenue au restaurant Le Florian, situé dans la charmante ville d'Avermes. Notre établissement est spécialisé dans les spécialités italiennes, avec une attention particulière portée à la qualité des ingrédients et à la préparation de nos plats."
    ],
    "nl": [
      "Welkom bij restaurant Le Florian, gelegen in het charmante stadje Avermes. Ons restaurant is gespecialiseerd in Italiaanse specialiteiten, met bijzondere aandacht voor de kwaliteit van de ingrediënten en de bereiding van onze gerechten."
    ],
    "es": [
      "Bienvenido al restaurante Le Florian, situado en la encantadora localidad de Avermes. Nuestro restaurante está especializado en especialidades italianas, prestando especial atención a la calidad de los ingredientes y a la preparación de nuestros platos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Florian"
    ]
  },
