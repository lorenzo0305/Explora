  "rdfs:comment": {
    "de": [
      "Vor den Toren von Bourg-en-Bresse liegt das Restaurant Racines im Herzen der Domaine du Lac in Saint-Denis-lès-Bourg. Eine grüne Oase, in der sich Natur, Ruhe und Gastronomie vereinen. Teller und BIB Gourmand im Guide Michelin!"
    ],
    "en": [
      "At the gateway to Bourg-en-Bresse, discover the Racines restaurant in the heart of the Domaine du Lac at Saint-Denis-lès-Bourg. A green setting combining nature, tranquillity and gastronomy. Assiette and BIB Gourmand in the Michelin Guide!"
    ],
    "it": [
      "Alle porte di Bourg-en-Bresse, venite a scoprire il ristorante Racines nel cuore del Domaine du Lac a Saint-Denis-lès-Bourg. Un ambiente verde dove natura, tranquillità e gastronomia si fondono. Assiette e BIB Gourmand nella Guida Michelin!"
    ],
    "fr": [
      "Aux portes de Bourg-en-Bresse, venez découvrir le restaurant Racines situé au coeur du domaine du lac à Saint-Denis-lès-Bourg. Un écrin de verdure où se conjuguent nature, tranquillité et gastronomie. Assiette et BIB Gourmand au Guide Michelin!"
    ],
    "nl": [
      "Kom net buiten Bourg-en-Bresse het restaurant Racines ontdekken in het hart van het Domaine du Lac in Saint-Denis-lès-Bourg. Een groene omgeving waar natuur, rust en gastronomie samenkomen. Assiette en BIB Gourmand in de Michelingids!"
    ],
    "es": [
      "A las afueras de Bourg-en-Bresse, venga a descubrir el restaurante Racines en el corazón del Domaine du Lac en Saint-Denis-lès-Bourg. Un entorno verde donde se unen naturaleza, tranquilidad y gastronomía. ¡Assiette y BIB Gourmand en la Guía Michelin!"
    ]
  },
