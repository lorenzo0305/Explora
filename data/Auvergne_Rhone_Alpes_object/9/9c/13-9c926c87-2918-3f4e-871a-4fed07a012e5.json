  "rdfs:comment": {
    "de": [
      "Das Chalet de l'Esplanade liegt auf den Anhöhen von Bourgoin-Jallieu, umgeben von Grün und Wald, und empfängt Sie in einer friedlichen Umgebung inmitten der Natur."
    ],
    "en": [
      "Perched on the heights of Bourgoin-Jallieu, surrounded by greenery and bordered by the forest, Le Chalet de l'Esplanade welcomes you to a peaceful setting in the heart of nature."
    ],
    "it": [
      "Arroccato sulle alture di Bourgoin-Jallieu, circondato dal verde e delimitato dalla foresta, Le Chalet de l'Esplanade vi accoglie in un ambiente tranquillo nel cuore della natura."
    ],
    "fr": [
      "Perché sur les hauteurs de Bourgoin-Jallieu, entouré de verdure et bordé par la forêt, Le Chalet de l’Esplanade vous accueille dans un cadre paisible, en pleine nature."
    ],
    "nl": [
      "Gelegen op de hoogten van Bourgoin-Jallieu, omgeven door groen en grenzend aan het bos, verwelkomt Le Chalet de l'Esplanade je in een rustige omgeving in het hart van de natuur."
    ],
    "es": [
      "Encaramado en las alturas de Bourgoin-Jallieu, rodeado de vegetación y bordeado por el bosque, Le Chalet de l'Esplanade le da la bienvenida a un entorno tranquilo en plena naturaleza."
    ]
  },
