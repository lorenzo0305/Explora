  "rdfs:comment": {
    "de": [
      "Das Restaurant „A la Table des Lys“ empfängt Sie in einem gemütlichen, trendigen und raffinierten Ambiente. Marc LECROISEY, ausgezeichnet mit dem Titel „Maître Restaurateur“, lässt Sie seine Kochkunst entdecken, eine Mischung aus Gastronomie und Tradition mit einem Hauch von Modernität. Die Gerichte werden aus frischen, saisonalen Produkten von höchster Qualität zubereitet."
    ],
    "en": [
      "At the \"À la Table des Lys\" restaurant you'll dine in comfort in trendy, elegant surroundings. Marc LECROISEY, holder of the \"Maître Restaurateur\" title, will introduce you to his own blend of gourmet dishes and traditional cuisine with a modern twist, all prepared using top quality, fresh, seasonal ingredients."
    ],
    "it": [
      "Il ristorante À la Table des Lys vi accoglie in un ambiente accogliente, trendy e raffinato, con vista sul campo da golf di Saint-Etienne. Parcheggio gratuito di fronte al ristorante."
    ],
    "fr": [
      "Le restaurant À la Table des Lys vous accueille dans un cadre cosy, tendance et raffiné, avec vue sur le golf de Saint-Etienne. Parking gratuit devant le restaurant."
    ],
    "nl": [
      "Het restaurant À la Table des Lys ontvangt u in een gezellige, trendy en verfijnde omgeving, met uitzicht op de golfbaan van Saint-Etienne. Gratis parkeren voor het restaurant."
    ],
    "es": [
      "El restaurante À la Table des Lys le da la bienvenida en un ambiente acogedor, moderno y refinado, con vistas al campo de golf de Saint-Etienne. Aparcamiento gratuito frente al restaurante."
    ]
  },
