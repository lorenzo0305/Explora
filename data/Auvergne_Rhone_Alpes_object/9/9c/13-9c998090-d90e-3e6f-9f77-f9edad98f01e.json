  "rdfs:comment": {
    "de": [
      "Sylvie stellt Gelees, Konfitüren und Fruchtpasten aus Früchten aus dem Garten oder aus Wildsammlungen in den Monts de la Margeride her.\r\nZüchtet sardische Schafe für die Herstellung von Bio-Joghurt.\r\nVerkauf: Markt in Saugues, Jardins du Gévaudan"
    ],
    "en": [
      "Sylvie makes jellies, jams and fruit jellies from fruits grown in the garden or picked in the wild in the Monts de la Margeride.\r\nBreeding of Sardinian ewes to make organic yogurts.\r\nSales: Saugues market, Jardins du Gévaudan"
    ],
    "it": [
      "Sylvie produce gelatine, marmellate e gelatine di frutta con la frutta coltivata in giardino o raccolta in natura nei Monts de la Margeride.\r\nAlleva pecore sarde per produrre yogurt biologici.\r\nVendite: mercato di Saugues, Jardins du Gévaudan"
    ],
    "fr": [
      "Sylvie confectionne des gelées, confitures et pâtes de fruits à partir de fruits du jardin ou de la cueillette sauvage des Monts de la Margeride.\r\nElevage de brebis Sardes pour la fabrique de yaourts bio.\r\nVente : marché de Saugues, Jardins du Gévaudan"
    ],
    "nl": [
      "Sylvie maakt gelei, jam en vruchtengelei van fruit dat in de tuin is gekweekt of in het wild is geplukt in de Monts de la Margeride.\r\nZe fokt Sardijnse ooien om biologische yoghurt te maken.\r\nVerkoop: Saugues markt, Jardins du Gévaudan"
    ],
    "es": [
      "Sylvie elabora jaleas, mermeladas y gelatinas de frutas a partir de frutas cultivadas en el huerto o recogidas en la naturaleza en los Montes de la Margeride.\r\nCría ovejas sardas para elaborar yogures ecológicos.\r\nVentas: mercado de Saugues, Jardins du Gévaudan"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Redon Sylvie"
    ]
  },
