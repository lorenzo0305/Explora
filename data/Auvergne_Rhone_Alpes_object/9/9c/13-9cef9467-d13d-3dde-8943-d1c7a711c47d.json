  "rdfs:comment": {
    "de": [
      "Die Stätte Polignac ist Teil des vulkanischen Beckens von Le Puy-en-Velay, das sich von Chaspinhac im Osten bis zum vulkanischen Devès-Massiv im Westen erstreckt."
    ],
    "en": [
      "Polignac volcanoes at liberty\r\nAbout 3 million years ago, when Auvergne mastodons roamed the region, a volcano erupted. The lava solidified when it made contact with the water, giving rise to the rock that was used as a pedestal for the fortress."
    ],
    "it": [
      "Il sito di Polignac fa parte del bacino vulcanico di Puy-en-Velay, che si estende da Chaspinhac a est al massiccio vulcanico di Devès a ovest."
    ],
    "fr": [
      "Le site de Polignac fait partie du bassin volcanique du Puy-en-Velay qui s’étend depuis Chaspinhac, à l’est, jusqu’au massif volcanique du Devès, à l’ouest."
    ],
    "es": [
      "El emplazamiento de Polignac forma parte de la cuenca volcánica del Puy-en-Velay, que se extiende desde Chaspinhac, al este, hasta el macizo volcánico de Devès, al oeste."
    ],
    "nl": [
      "De site van Polignac maakt deel uit van het vulkanische bekken van Puy-en-Velay dat zich uitstrekt van Chaspinhac in het oosten tot het vulkanische massief van Devès in het westen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Forteresse de Polignac - Volcanisme"
    ]
  },
