  "rdfs:comment": {
    "de": [
      "Vom Yachthafen in Pont-de-Vaux aus Mittagsfahrt auf dem Kanal von Pont-de-Vaux und der Saône bis nach Mâcon. Passieren Sie die Schleuse von Pont-de-Vaux. Mahlzeit an Bord."
    ],
    "en": [
      "Departing from the Pont-de-Vaux marina, lunch cruise on the Canal de Pont-de-Vaux and the Saône to Mâcon. Passage of the Pont-de-Vaux lock. Lunch on board."
    ],
    "it": [
      "Partenza dal porto turistico di Pont-de-Vaux, pranzo in crociera sul canale di Pont-de-Vaux e sulla Saona fino a Mâcon. Passaggio attraverso la chiusa di Pont-de-Vaux. Pranzo a bordo."
    ],
    "fr": [
      "Au départ du port de plaisance de Pont-de-Vaux, croisière déjeuner sur le Canal de Pont-de-Vaux et la Saône jusqu'à Mâcon. Passage de l'écluse de Pont-de-Vaux. Repas à bord."
    ],
    "nl": [
      "Vertrek uit de jachthaven van Pont-de-Vaux, lunch op het kanaal van Pont-de-Vaux en de Saône tot Mâcon. Passage door de sluis van Pont-de-Vaux. Lunch aan boord."
    ],
    "es": [
      "Salida del puerto deportivo de Pont-de-Vaux, almuerzo crucero por el canal de Pont-de-Vaux y el Saona hasta Mâcon. Paso por la esclusa de Pont-de-Vaux. Almuerzo a bordo."
    ]
  },
  "rdfs:label": {
    "de": [
