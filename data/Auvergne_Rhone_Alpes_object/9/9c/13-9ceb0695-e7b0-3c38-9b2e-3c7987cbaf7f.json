  "rdfs:comment": {
    "de": [
      "Die Skischule Prosneige Les Menuires bietet Gruppenkurse für Ski und Snowboard sowie Privatunterricht an. Die Skikurse beginnen alle auf La Croisette."
    ],
    "en": [
      "Prosneige Les Menuires ski school offers group ski and snowboard lessons as well as private lessons. All ski lessons start at La Croisette."
    ],
    "it": [
      "La scuola di sci Prosneige Les Menuires offre lezioni di gruppo di sci e snowboard e lezioni private. Tutte le lezioni di sci iniziano sulla Croisette."
    ],
    "fr": [
      "L’école de ski Prosneige Les Menuires propose des cours collectifs en ski et snowboard ainsi que des leçons privées. Les cours de ski commencent tous sur La Croisette."
    ],
    "es": [
      "La escuela de esquí Prosneige Les Menuires ofrece clases de esquí y snowboard en grupo, así como clases particulares. Todas las clases de esquí comienzan en La Croisette."
    ],
    "nl": [
      "De Prosneige Les Menuires skischool biedt ski- en snowboardlessen in groepsverband en privélessen. Alle skilessen beginnen op La Croisette."
    ]
  },
