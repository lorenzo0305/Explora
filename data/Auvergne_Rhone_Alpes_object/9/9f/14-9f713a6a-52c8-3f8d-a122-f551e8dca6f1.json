  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/141bddd4-f480-3a16-8ced-41f95d92ce4f",
      "dc:description": {
        "de": [
          "Bully-les-Mines lädt Sie zu seiner Eröffnung der Kultursaison mit den Konzerten von Daphne Swan und Maia ein!\nGenießen Sie in der Pause eine Zeit des Austauschs und der Geselligkeit rund um das neue Programm."
        ],
        "en": [
          "Bully-les-Mines invites you to the opening of its cultural season with concerts by Daphné Swan and Maia!\nAt the interval, enjoy a time of exchange and conviviality around the new program."
        ],
        "it": [
          "Bully-les-Mines vi invita all'apertura della sua stagione culturale con i concerti di Daphné Swan e Maia!\nDurante l'intervallo, ci sarà tempo per chiacchierare del nuovo programma."
        ],
        "fr": [
          "Bully-les-Mines vous convie à son ouverture de saison culturelle avec les concerts de Daphné Swan et Maia !\nProfitez à l'entracte d'un temps d'échange et de convivialité autour de la nouvelle programmation."
        ],
        "es": [
          "¡Bully-les-Mines le invita a la inauguración de su temporada cultural con los conciertos de Daphné Swan y Maia!\nDurante el descanso, habrá tiempo para charlar sobre la nueva programación."
        ],
        "nl": [
          "Bully-les-Mines nodigt je uit voor de opening van haar culturele seizoen met concerten van Daphné Swan en Maia!\nTijdens de pauze is er tijd om na te praten over het nieuwe programma."
        ]
      },
