  "rdfs:comment": {
    "de": [
      "Das Nouvel liebt die einfachen, ehrlichen und praktischen Dinge. Wir haben unser Hotel so gestaltet, dass es den Erwartungen der Reisenden von heute entspricht. Mit direktem Zugang, nur 5 Minuten von der Ausfahrt Valence Sud der Autobahn A7 entfernt. Idealer Zwischenstopp zwischen Nord und Süd."
    ],
    "en": [
      "Discover this charming Hotel and Restaurant, entirely renovated with 27 bedrooms, with all mod cons. As the nicer days arrive, you will be able to enjoy your meal outdoors, on our shady terrace, rocked by the sound of our fountain."
    ],
    "it": [
      "A Le Nouvel piacciono le cose semplici, oneste e pratiche. Abbiamo progettato il nostro hotel per soddisfare le aspettative dei viaggiatori di oggi. Con accesso diretto a 5 minuti dall'uscita Valence Sud dell'autostrada A7. Una tappa ideale tra nord e sud."
    ],
    "fr": [
      "Le Nouvel aime les choses simples, honnêtes et pratiques. Nous avons conçu notre hôtel afin de répondre aux attentes des voyageurs d'aujourd'hui. Avec un accès direct à 5 minutes de la sortie Valence Sud de l'autoroute A7. Étape idéale entre nord et sud."
    ],
    "nl": [
      "Le Nouvel houdt van eenvoudig, eerlijk en praktisch. We hebben ons hotel zo ontworpen dat het voldoet aan de verwachtingen van de hedendaagse reiziger. Met directe toegang op slechts 5 minuten van de afslag Valence Sud op de snelweg A7. Een ideale tussenstop tussen noord en zuid."
    ],
    "es": [
      "A Le Nouvel le gustan las cosas sencillas, honestas y prácticas. Hemos diseñado nuestro hotel para satisfacer las expectativas de los viajeros de hoy en día. Con acceso directo a 5 minutos de la salida Valence Sud de la autopista A7. Una escala ideal entre el norte y el sur."
    ]
  },
