  "rdfs:comment": {
    "de": [
      "Mein Name ist Sylvie, Spitzname Sissi. Ich stelle Objekte und Spielzeuge aus geschnittenem Holz her, die entweder bemalt oder naturbelassen sind. Ich beschränke mich nicht nur auf Holzobjekte, sondern stelle auch gehäkelte Plüschtiere her.\r\nAlle diese Artikel sind in meinem Online-Shop zu sehen."
    ],
    "en": [
      "My name is Sylvie, nicknamed Sissi. I create wooden objects and toys that are either painted or left natural. I don't stop at wooden objects; I also create crocheted stuffed animals.\r\nAll of these items can be viewed in my online store."
    ],
    "it": [
      "Mi chiamo Sylvie, soprannominata Sissi. Creo oggetti e giocattoli in legno ritagliato, dipinto o naturale. Non creo solo oggetti in legno, ma anche peluche all'uncinetto.\r\nTutti questi oggetti sono visibili nel mio negozio online."
    ],
    "fr": [
      "Je m'appelle Sylvie, surnomée Sissi. Je crée des objets et jouets en bois découpés soit peints soit naturels. Je ne m'arrête pas à des objets en bois, je créé des peluches au crochet.\r\nTous ces articles sont visibles dans ma boutique en ligne."
    ],
    "nl": [
      "Mijn naam is Sylvie, bijgenaamd Sissi. Ik maak objecten en speelgoed van uitgesneden hout, geverfd of natuurlijk. Ik maak niet alleen houten objecten, ik haak ook knuffels.\r\nAl deze items zijn te zien in mijn online shop."
    ],
    "es": [
      "Me llamo Sylvie, apodada Sissi. Creo objetos y juguetes de madera recortada, pintada o natural. No sólo hago objetos de madera, también hago peluches de ganchillo.\r\nTodos estos artículos pueden verse en mi tienda en línea."
    ]
  },
  "rdfs:label": {
