  "rdfs:comment": {
    "de": [
      "Saint-Benoît, das auf dem Grat eines Felsvorsprungs liegt, ist eines unserer schönsten hochgelegenen Dörfer. Versäumen Sie nicht, die schönen Häuser des Dorfes mit ihren datierten oder mit geheimnisvollen Symbolen verzierten Türstürzen und die wunderschön restaurierte Kirche zu bewundern."
    ],
    "en": [
      "Resting on the edge of a rocky spur, Saint-Benoît is one of our most beautiful hilltop villages. Be sure to admire the village's beautiful houses, adorned with dated lintels or decorated with mysterious symbols, and the magnificently restored church."
    ],
    "it": [
      "Situato sul bordo di uno sperone roccioso, Saint-Benoît è uno dei nostri più bei villaggi arroccati. Non perdete le belle case del villaggio, decorate con architravi datati o simboli misteriosi, e la chiesa splendidamente restaurata."
    ],
    "fr": [
      "Posé sur l'arête d'un éperon rocheux, Saint-Benoît est l’un de nos plus beaux villages perchés. Ne manquez pas d'admirer les belles maisons du village, ornées de linteaux datés ou décorés de mystérieux symboles et l’église, magnifiquement restaurée."
    ],
    "es": [
      "Situado al borde de un espolón rocoso, Saint-Benoît es uno de nuestros pueblos encaramados más bellos. No se pierda las hermosas casas del pueblo, decoradas con dinteles fechados o símbolos misteriosos, y la iglesia bellamente restaurada."
    ],
    "nl": [
      "Saint-Benoît ligt op de rand van een rotsachtige uitloper en is een van onze mooiste heuveldorpen. Bewonder zeker de mooie huizen van het dorp, versierd met gedateerde lateien of mysterieuze symbolen, en de prachtig gerestaureerde kerk."
    ]
  },
