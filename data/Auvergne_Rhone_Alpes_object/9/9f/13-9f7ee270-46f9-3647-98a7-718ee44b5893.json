  "rdfs:comment": {
    "de": [
      "Nehmen Sie an verschiedenen erlebnisreichen Aktivitäten an der Spitze des Sessellifts teil: Auf in die Höhe!"
    ],
    "en": [
      "The Falaise chairlift gives you access to: the start of the Tyrolean traverse and the Biche Xtrem Adventure. It is also the starting point for the red and slalom runs, boarder cross and the Bois Joli run (return to the residence)."
    ],
    "it": [
      "Partecipate a una serie di attività emozionanti in cima alla seggiovia: l'altezza è vostra!"
    ],
    "fr": [
      "Rejoignez diverses activités riches en sensations au sommet du télésiège : à vous les hauteurs !"
    ],
    "es": [
      "Participe en una serie de emocionantes actividades en lo alto del telesilla: ¡las alturas son suyas!"
    ],
