  "rdfs:comment": {
    "de": [
      "Seit 30 Jahren freuen sich Laurent und sein Team darauf, Sie zu begrüßen und Ihnen in einer entspannten Atmosphäre und einem gemütlichen Rahmen eine marktfrische Küche vorzustellen, die lokale Produkte und Produkte aus unserer Region bevorzugt."
    ],
    "en": [
      "For the past 30 years, Laurent and his team have been delighted to welcome you to discover a market cuisine based on local produce in a relaxed atmosphere and warm setting."
    ],
    "it": [
      "Da 30 anni Laurent e il suo team sono lieti di accogliervi nel loro ristorante, dove potrete gustare una cucina di mercato a base di prodotti locali in un'atmosfera rilassata e in un ambiente caldo."
    ],
    "fr": [
      "Depuis 30 ans, Laurent et son équipe ont le plaisir de vous accueillir pour vous faire découvrir une cuisine du marché qui privilégie des produits locaux et de notre terroir dans une ambiance décontractée et un cadre chaleureux."
    ],
    "es": [
      "Desde hace 30 años, Laurent y su equipo están encantados de recibirle en su restaurante, donde podrá disfrutar de una cocina de mercado basada en productos locales en un ambiente relajado y un entorno cálido."
    ],
    "nl": [
      "Al 30 jaar verwelkomen Laurent en zijn team je graag in hun restaurant, waar je kunt genieten van de marktkeuken op basis van lokale producten in een ontspannen sfeer en warme omgeving."
    ]
  },
