  "rdfs:comment": {
    "de": [
      "Bootsfahrt auf dem Kanal von Pont-de-Vaux und der Saône bis nach Tournus und zurück. Passieren der Schleuse von Pont-de-Vaux. Mahlzeiten an Bord."
    ],
    "en": [
      "Departing from the Port de Pont-de-Vaux, lunch cruise on the Canal de Pont-de-Vaux and the Saône to Tournus and back. Passage of the Pont-de-Vaux lock. Lunch on board."
    ],
    "it": [
      "Partenza dal porto di Pont-de-Vaux, pranzo in crociera sul canale di Pont-de-Vaux e sulla Saona fino a Tournus e ritorno. Passaggio della chiusa di Pont-de-Vaux. Pranzo a bordo."
    ],
    "fr": [
      "Au départ du Port de Pont-de-Vaux, croisière déjeuner sur le Canal de Pont-de-Vaux et la Saône jusqu'à Tournus aller et retour. Passage de l'écluse de Pont-de-Vaux. Repas à bord."
    ],
    "nl": [
      "Vertrek uit de haven van Pont-de-Vaux, lunch op het kanaal van Pont-de-Vaux en de Saône naar Tournus en terug. Doorvaart van de sluis van Pont-de-Vaux. Lunch aan boord."
    ],
    "es": [
      "Salida del puerto de Pont-de-Vaux, almuerzo crucero por el canal de Pont-de-Vaux y el Saona hasta Tournus y regreso. Paso de la esclusa de Pont-de-Vaux. Almuerzo a bordo."
    ]
  },
