  "rdfs:comment": {
    "de": [
      "Handwerkliche Herstellung von Messern, Eisenwaren und Accessoires (erhältlich in der Boutique La Horde des créateurs in Vernoux-en-Vivarais).\r\nHerstellung von personalisierten Stücken auf Bestellung.\r\nSchärfen der Messer in der Werkstatt donnerstags von 9 bis 12 Uhr."
    ],
    "en": [
      "Handcrafted knives, metalwork and accessories (on sale at the La Horde des créateurs shop in Vernoux-en-Vivarais).\r\nCustomised pieces made to order.\r\nKnife sharpening in the workshop on Thursdays from 9am to 12pm."
    ],
    "it": [
      "Coltelli, oggetti in metallo e accessori realizzati a mano (in vendita presso il negozio La Horde des créateurs di Vernoux-en-Vivarais).\r\nPezzi personalizzati su ordinazione.\r\nAffilatura dei coltelli nel laboratorio il giovedì dalle 9.00 alle 12.00."
    ],
    "fr": [
      "Réalisation artisanale de couteaux, ferronneries et accessoires (en vente à la boutique La Horde des créateurs à Vernoux-en-Vivarais).\r\nRéalisation de pièces personnalisées sur commande.\r\nAiguisage des couteaux à l'atelier le jeudi de 9h à 12h."
    ],
    "nl": [
      "Handgemaakte messen, metaalwerk en accessoires (te koop in de winkel La Horde des créateurs in Vernoux-en-Vivarais).\r\nOp bestelling gemaakte stukken.\r\nMessen slijpen in het atelier op donderdag van 9 tot 12 uur."
    ],
    "es": [
      "Cuchillería, metalistería y accesorios artesanales (a la venta en la tienda La Horde des créateurs de Vernoux-en-Vivarais).\r\nPiezas personalizadas por encargo.\r\nAfilado de cuchillos en el taller los jueves de 9:00 a 12:00."
    ]
  },
