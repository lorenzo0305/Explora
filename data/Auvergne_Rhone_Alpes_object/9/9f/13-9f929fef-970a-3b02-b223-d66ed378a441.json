  "rdfs:comment": {
    "de": [
      "Wenn Sie direkt von Prabouré aus wandern möchten, finden Sie hier die drei Dahu-Rundwege, auf denen Sie die wunderschöne Landschaft der Hautes Chaumes entdecken und die Jasserie du Coq Noir erreichen können!"
    ],
    "en": [
      "To walk directly from Prabouré, you will find the three circuits of the dahu to discover the magnificent landscapes of the Hautes Chaumes and join the Jasserie du Coq Noir!"
    ],
    "it": [
      "Se volete fare una passeggiata direttamente da Prabouré, troverete i tre circuiti della dahu per scoprire i magnifici paesaggi delle Hautes Chaumes e per raggiungere la Jasserie du Coq Noir!"
    ],
    "fr": [
      "Pour vous balader directement depuis Prabouré, vous trouverez les trois circuits du dahu pour découvrir les magnifiques paysages des Hautes Chaumes et rallier la Jasserie du Coq Noir !"
    ],
    "es": [
      "Si quiere dar un paseo directamente desde Prabouré, encontrará los tres circuitos del dahu para descubrir los magníficos paisajes de las Hautes Chaumes y llegar a la Jasserie du Coq Noir"
    ],
    "nl": [
      "Als u direct vanuit Prabouré wilt gaan wandelen, vindt u de drie circuits van de dahu om de prachtige landschappen van de Hautes Chaumes te ontdekken en de Jasserie du Coq Noir te bereiken!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Balade de Prabouré, sur les traces du Coq Noir"
    ]
  },
