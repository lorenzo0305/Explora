  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/0edbaa79-5c19-303f-acbc-fa0185004cd4",
      "dc:description": {
        "de": [
          "Der Karneval der fantastischen Tiere! Entdecken Sie eine völlig neue Version von Saint-Saëns' Karneval der Tiere in einer vierhändigen Version. Hemiones, Schildkröten, Kängurus und Elefanten ermöglichen die Entdeckung des Klaviers, der Virtuosität und des Humors in der Musik."
        ],
        "en": [
          "Carnival of the Fantastic Animals! Discover an original 4-hand version of Saint-Saëns?s Carnival of the Animals. Hemiones, turtles, kangaroos and elephants introduce you to piano virtuosity and musical humor."
        ],
        "it": [
          "Il Carnevale degli animali fantastici! Scoprite una nuovissima versione a 4 mani del Carnevale degli animali di Saint-Saëns. Emioni, tartarughe, canguri ed elefanti vi faranno scoprire il pianoforte, il virtuosismo e l'umorismo in musica."
        ],
        "fr": [
          "Le Carnaval des animaux fantastiques ! Découvrez une version inédite du Carnaval des animaux de Saint-Saëns en version 4 mains. Hémiones, tortues, kangourous et éléphants permettent de découvrir le piano, la virtuosité et l’humour en musique."
        ],
        "nl": [
          "Het carnaval van de fantastische dieren! Ontdek een gloednieuwe 4-hands versie van Saint-Saëns' Carnival of the Animals. Hemiones, schildpadden, kangoeroes en olifanten geven je de kans om de piano, virtuositeit en humor in de muziek te ontdekken."
        ],
        "es": [
          "El carnaval de los animales fantásticos Descubra una nueva versión a 4 manos del Carnaval de los animales de Saint-Saëns. Hemiones, tortugas, canguros y elefantes le harán descubrir el piano, el virtuosismo y el humor en la música."
        ]
      },
      "@type": [
        "Description"
