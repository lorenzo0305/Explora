  "rdfs:comment": {
    "de": [
      "Ort, der für kleine Gruppen von maximal 12 Personen für Schulungen/Praktika/Workshops zu mieten ist\r\nUmliegende Natur, die zu Ruhe und Spaziergängen einlädt."
    ],
    "en": [
      "\"Le Temps d'une Pause\", a resource/well-being centre. Location available to rent for small groups of up to 12 people for training courses/internships/workshops\r\nSurrounding countryside ideal for relaxation and walks."
    ],
    "it": [
      "Sede da affittare per piccoli gruppi fino a 12 persone per corsi di formazione/laboratori\r\nLa campagna circostante è ideale per passeggiate tranquille."
    ],
    "fr": [
      "Lieu à louer pour des petits groupes de 12 personnes maximum en formations/stages/ateliers\r\nNature environnante propice au calme, aux balades."
    ],
    "es": [
      "Lugar de alquiler para pequeños grupos de hasta 12 personas para cursos de formación/talleres\r\nLa campiña circundante es ideal para dar tranquilos paseos."
    ],
    "nl": [
      "Locatie te huur voor kleine groepen van maximaal 12 personen voor trainingen/workshops\r\nHet omliggende platteland is ideaal voor rustige wandelingen."
    ]
  },
