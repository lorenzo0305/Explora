  "rdfs:comment": {
    "de": [
      "Manon Cherpe ist eine Bildhauerin mit einem ungewöhnlichen Werdegang (Lascaux 4, monumentale Kunst). Sie arbeitet mit zahlreichen Materialien und schafft einzigartige Werke. Ihre Kunst vermittelt sie mit Leidenschaft in Kursen für Bildhauerei, Modellieren und Raku. Für alle Niveaus, Erholung garantiert!"
    ],
    "en": [
      "A sculptor with an unusual career path (Lascaux 4, monumental art), Manon Cherpe works with many materials and creates unique pieces. She passionately shares her art through sculpture, modelling and raku workshops. All levels welcome, rejuvenation guaranteed!"
    ],
    "it": [
      "Scultrice con un background atipico (Lascaux 4, arte monumentale), Manon Cherpe lavora con una vasta gamma di materiali per creare opere uniche. Condivide con passione la sua arte attraverso corsi di scultura, modellazione e raku. Tutti i livelli, ringiovanimento garantito!"
    ],
    "fr": [
      "Sculptrice au parcours atypique (Lascaux 4, art monumental), Manon Cherpe travaille de nombreux matériaux et crée des œuvres uniques. Elle transmet son art avec passion lors de stages de sculpture, modelage, raku. Tous niveaux, ressourcement garanti !"
    ],
    "es": [
      "Escultora con una formación atípica (Lascaux 4, arte monumental), Manon Cherpe trabaja con una amplia gama de materiales para crear obras únicas. Le apasiona compartir su arte a través de cursos de escultura, modelado y rakú. Todos los niveles, ¡rejuvenecimiento garantizado!"
    ],
    "nl": [
      "Als beeldhouwer met een atypische achtergrond (Lascaux 4, monumentale kunst) werkt Manon Cherpe met een breed scala aan materialen om unieke werken te creëren. Ze deelt haar kunst met passie door middel van beeldhouw-, boetseer- en raku-cursussen. Alle niveaus, verjonging gegarandeerd!"
    ]
  },
