  "rdfs:comment": {
    "de": [
      "Sushi Shop Valence bietet kreatives und raffiniertes Sushi, das Sie vor Ort genießen, mitnehmen oder sich liefern lassen können. Ein modernes japanisches Erlebnis im Herzen der Stadt, das Frische, Qualität und Originalität vereint."
    ],
    "en": [
      "Sushi Shop Valence offers creative and refined sushi, to eat in, take away or deliver. A modern Japanese experience in the heart of the city, combining freshness, quality and originality."
    ],
    "it": [
      "Sushi Shop Valence offre un sushi creativo e raffinato, da mangiare, da portare via o da consegnare. Un'esperienza giapponese moderna nel cuore della città, che unisce freschezza, qualità e originalità."
    ],
    "fr": [
      "Sushi Shop Valence propose des sushis créatifs et raffinés, à déguster sur place, à emporter ou en livraison. Une expérience japonaise moderne au cœur de la ville, alliant fraîcheur, qualité et originalité."
    ],
    "es": [
      "Sushi Shop Valence ofrece sushi creativo y refinado, para comer en casa, para llevar o a domicilio. Una experiencia japonesa moderna en el corazón de la ciudad, que combina frescura, calidad y originalidad."
    ],
    "nl": [
      "Sushi Shop Valence biedt creatieve en verfijnde sushi, om te eten, mee te nemen of te bezorgen. Een moderne Japanse ervaring in het hart van de stad, met een combinatie van versheid, kwaliteit en originaliteit."
    ]
  },
  "rdfs:label": {
