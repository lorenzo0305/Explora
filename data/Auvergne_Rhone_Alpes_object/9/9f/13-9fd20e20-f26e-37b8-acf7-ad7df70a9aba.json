  "rdfs:comment": {
    "de": [
      "Etwa 50 Pizzen, die mit einem Maximum an lokalen Produkten und einem von uns zubereiteten Teig hergestellt werden. Wir bieten Ihnen unseren Automaten an, in dem Sie 16 Pizzen zur Auswahl finden, die immer von uns zubereitet werden, um Ihren Gaumen zu verwöhnen."
    ],
    "en": [
      "Around fifty pizzas made with a maximum of local produce and dough prepared by us. Our vending machine offers a choice of 16 pizzas, all prepared by us to delight your taste buds."
    ],
    "it": [
      "Una cinquantina di pizze realizzate con un massimo di prodotti locali e impasto preparato da noi. Il nostro distributore automatico offre una scelta di 16 pizze, tutte preparate da noi per deliziare il vostro palato."
    ],
    "fr": [
      "Une cinquantaine de Pizzas faites avec le maximum de produits locaux et une pâte préparée par nos soins. Nous vous proposons notre distributeur automatique où vous trouverez 16 pizzas au choix et toujours préparées par nos soins pour régaler vos papilles."
    ],
    "es": [
      "Unas cincuenta pizzas elaboradas con un máximo de productos locales y masa preparada por nosotros. Nuestra máquina expendedora ofrece una selección de 16 pizzas, todas preparadas por nosotros para deleitar su paladar."
    ],
    "nl": [
      "Een vijftigtal pizza's gemaakt met een maximum aan lokale producten en deeg door ons bereid. Onze automaat biedt keuze uit 16 pizza's, allemaal door ons bereid om je smaakpapillen te verwennen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Cabane à Pizzas"
    ]
  },
