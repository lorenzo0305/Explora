  "rdfs:comment": {
    "de": [
      "Dieser Empfangsraum im Herzen des Schlosses ist ideal für die Feier Ihrer wertvollsten privaten oder beruflichen Momente: Hochzeiten, Familienfeiern. Es ist auch ein geeigneter Ort für Ihre Seminare und Geschäftstreffen."
    ],
    "en": [
      "Located in the heart of the Château, this reception room is ideal for celebrating your most precious private or professional moments: weddings, family gatherings. It's also a great venue for your residential seminars and business meetings."
    ],
    "it": [
      "Situata nel cuore dello Château, questa sala è ideale per celebrare i vostri momenti più preziosi, privati o professionali: matrimoni, riunioni di famiglia. È anche un luogo ideale per seminari residenziali e riunioni di lavoro."
    ],
    "fr": [
      "Situé au cœur du Château, cette salle de réception est idéale pour fêter vos moments privés ou professionnrels les plus précieux : mariages, rassemblements de famille. C'est aussi un lieu propice pour vos séminaires résidentiels et réunions d'affaires."
    ],
    "es": [
      "Situado en el corazón del Château, este salón de actos es ideal para celebrar sus momentos privados o profesionales más preciados: bodas, reuniones familiares. También es el lugar ideal para sus seminarios residenciales y reuniones de negocios."
    ],
    "nl": [
      "Deze zaal ligt in het hart van het kasteel en is ideaal voor het vieren van uw meest waardevolle privé- of professionele momenten: bruiloften, familiebijeenkomsten. Het is ook een ideale locatie voor uw residentiële seminars en zakelijke bijeenkomsten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Salle de réception : Le domaine du Très Haut au château de Montanges"
    ]
  },
