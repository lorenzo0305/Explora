  "rdfs:comment": {
    "de": [
      "Frei zugänglich (außerhalb der Kurse) oder Kletterkurse mit Bergführern, alle Niveaus, ab 5 Jahren. Dauer 1h bis 2h je nach Niveau. Telefonische Anmeldung bei der Sekretärin des Bergführerbüros von Méribel."
    ],
    "en": [
      "Free access (outside lessons) or climbing lessons by mountain guides, all levels, from 5 years upwards. Duration: 1 to 2 hours, depending on level. Registration by telephone with the secretary at the Méribel guide office."
    ],
    "it": [
      "Accesso libero (lezioni esterne) o lezioni di arrampicata tenute da guide alpine, per tutti i livelli, dai 5 anni in su. Durata da 1h a 2h a seconda del livello. Iscrizione telefonica presso la segreteria dell'ufficio delle guide alpine di Méribel."
    ],
    "fr": [
      "En accès libre (en dehors des cours) ou cours d'escalade par les guides de haute montagne, tous niveaux, à partir de 5 ans. Durée 1h à 2h suivant niveau. Inscription par téléphone auprès de la secrétaire du bureau des guides de Méribel."
    ],
    "nl": [
      "Vrije toegang (buitenlessen) of klimlessen gegeven door berggidsen, alle niveaus, vanaf 5 jaar. Duur 1 tot 2 uur, afhankelijk van het niveau. Telefonische aanmelding bij het secretariaat van het berggidsenbureau van Méribel."
    ],
    "es": [
      "Acceso libre (clases externas) o clases de escalada impartidas por guías de montaña, todos los niveles, a partir de 5 años. Duración de 1h a 2h según el nivel. Inscripciones por teléfono en la secretaría de la oficina de guías de montaña de Méribel."
    ]
  },
