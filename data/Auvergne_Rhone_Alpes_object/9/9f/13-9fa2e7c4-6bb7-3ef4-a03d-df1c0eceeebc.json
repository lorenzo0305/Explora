  "rdfs:comment": {
    "de": [
      "Gegenüber der Seilbahn von Arrondaz gelegen, durchgehend geöffnetes Restaurant, Savoyer Spezialitäten (nicht verpassen: la Potence), Brasserie, Bar, Snacks, Glühwein und Aperitif, in einer freundlichen und herzlichen Atmosphäre... kurz La P'tite Famille!"
    ],
    "en": [
      "In front of the Arrondaz cable car, the restaurant is open all day, offering Savoyard specialities (don't miss La Potence), brasserie, bar, snacks, mulled wine and aperitifs in a warm and friendly atmosphere... in short, La P'tite Famille!"
    ],
    "it": [
      "Situato di fronte alla funivia di Arrondaz, il ristorante è aperto tutto il giorno e offre specialità savoiarde (da non perdere la Potence), brasserie, bar, snack, vin brulé e aperitivi in un'atmosfera calda e accogliente... insomma, La P'tite Famille!"
    ],
    "fr": [
      "Situé en face de la télécabine d'Arrondaz, restaurant ouvert en continu, spécialités savoyardes (à ne pas manquer : la Potence), brasserie, bar, goûters, vin chaud et apéro, dans une ambiance conviviale et chaleureuse... bref La P'tite Famille !"
    ],
    "es": [
      "Situado frente al teleférico de Arrondaz, el restaurante está abierto todo el día y ofrece especialidades saboyanas (no se pierda el Potence), brasserie, bar, snacks, vino caliente y aperitivos en un ambiente cálido y acogedor... en resumen, ¡La P'tite Famille!"
    ],
    "nl": [
      "Het restaurant, gelegen tegenover de kabelbaan van Arrondaz, is de hele dag geopend en biedt Savoyaardse specialiteiten (mis La Potence niet), brasserie, bar, snacks, glühwein en aperitieven in een warme en vriendelijke sfeer... kortom, La P'tite Famille!"
    ]
  },
