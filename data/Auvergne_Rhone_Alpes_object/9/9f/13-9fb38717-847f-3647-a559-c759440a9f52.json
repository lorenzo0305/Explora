  "rdfs:comment": {
    "de": [
      "Zwei Tage lang wird im Herzen von Auteyrac gefeiert. Am 14. August, kostenloser Jugendball, Fluo-Abend à gogo. 15. August: 14 Uhr Boule-Wettbewerb, 17.30 Uhr Aperitif-Konzert mit Band Amidos, gefolgt von Mechoui um 20 Uhr und Volksball um 21.30 Uhr (kostenlos) & Feuerwerk."
    ],
    "en": [
      "Two days of festivities in the heart of Auteyrac. August 14, free youth ball, fluo party galore. August 15, 2 p.m. pétanque competition, 5:30 p.m. aperitif concert with Band Amidos, followed by the méchoui at 8 p.m. and the popular ball at 9:30 p.m. (free) & fireworks."
    ],
    "it": [
      "Due giorni di festa nel cuore di Auteyrac. Il 14 agosto, ballo gratuito dei giovani e festa fluorescente a volontà. Il 15 agosto, gara di bocce alle 14.00, concerto aperitivo alle 17.30 con la Band Amidos, seguito dal méchoui alle 20.00 e dal ballo popolare alle 21.30 (gratuito) e fuochi d'artificio."
    ],
    "fr": [
      "Deux jours de festivités au cœur d'Auteyrac. Le 14 août, bal gratuit des jeunes, soirée fluo à gogo. Le 15 août, 14h concours de pétanque, 17h30 apéro concert avec Band Amidos suivi du méchoui à 20h et du bal populaire à 21h30 (gratuit) & feu d'artifice."
    ],
    "nl": [
      "Twee dagen feest in het hart van Auteyrac. Op 14 augustus is er een gratis jeugdbal en een fluorescerend feest in overvloed. Op 15 augustus, 14u petanquewedstrijd, 17u30 aperitiefconcert met Band Amidos gevolgd door de méchoui om 20u en de volksdans om 21u30 (gratis) & vuurwerk."
    ],
    "es": [
      "Dos días de fiesta en el corazón de Auteyrac. El 14 de agosto, baile joven gratuito y fiesta fluorescente por todo lo alto. El 15 de agosto, competición de petanca a las 14:00 h, concierto de aperitivo a las 17:30 h con el grupo Amidos, seguido del méchoui a las 20:00 h y del baile popular a las 21:30 h (gratuito) y fuegos artificiales."
    ]
  },
  "rdfs:label": {
