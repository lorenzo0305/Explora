  "rdfs:comment": {
    "de": [
      "Während der Saison empfangen wir Sie im Herzen des Dorfes Yzeron. Hier finden Sie touristische Unterlagen, Ideen für Wanderungen, Veranstaltungen... für einen schönen Ausflug in die Monts du Lyonnais!"
    ],
    "en": [
      "We welcome you to the heart of the village of Yzeron in season. Find tourist information, ideas for walks, events... for a great getaway in the Monts du Lyonnais!"
    ],
    "it": [
      "Vi diamo il benvenuto nel cuore del villaggio di Yzeron in stagione. Troverete informazioni turistiche, idee per passeggiate, eventi... per una bella fuga nei Monts du Lyonnais!"
    ],
    "fr": [
      "Nous vous accueillons au cœur du village d'Yzeron en saison. Retrouvez la documentation touristique, des idées de randonnées, les manifestations... pour une belle escapade dans les Monts du Lyonnais !"
    ],
    "nl": [
      "Wij heten u welkom in het hart van het dorp Yzeron in het seizoen. Hier vindt u toeristische informatie, ideeën voor wandelingen, evenementen... voor een heerlijk verblijf in de Monts du Lyonnais!"
    ],
    "es": [
      "Le damos la bienvenida al corazón del pueblo de Yzeron en temporada. Encuentre información turística, ideas para pasear, eventos... ¡para una gran escapada en los Monts du Lyonnais!"
    ]
  },
