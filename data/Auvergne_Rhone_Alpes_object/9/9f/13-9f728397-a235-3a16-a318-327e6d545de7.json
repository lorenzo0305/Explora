  "rdfs:comment": {
    "de": [
      "Wir bauen aromatische, medizinische und wilde Pflanzen an, sammeln, destillieren und verarbeiten sie zu Lebensmitteln und Kosmetika: ätherische Öle, getrocknete Pflanzen, Sirup mit Honig, Blütenwasser, Massageöle, Cremes, Lotionen."
    ],
    "en": [
      "We cultivate, gather, distill and transform aromatic, medicinal and wild plants into a range of food and cosmetic products: essential oils, dry plants, honey syrups, floral waters, massage oils, creams, lotions."
    ],
    "it": [
      "Coltiviamo, raccogliamo, distilliamo e trasformiamo piante aromatiche, medicinali e selvatiche in una gamma di prodotti alimentari e cosmetici: oli essenziali, piante essiccate, sciroppi di miele, acque floreali, oli da massaggio, creme e lozioni."
    ],
    "fr": [
      "Nous cultivons, cueillons, distillons et transformons des plantes aromatiques, médicinales et sauvages en gamme alimentaire et cosmétique : huiles essentielles, plantes sèches, sirops au miel, eaux florales, huiles de massage, crèmes, lotions."
    ],
    "nl": [
      "Wij kweken, verzamelen, destilleren en verwerken aromatische, geneeskrachtige en wilde planten tot een reeks voedingsmiddelen en cosmetische producten: essentiële oliën, gedroogde planten, honingsiropen, bloemenwaters, massageoliën, crèmes en lotions."
    ],
    "es": [
      "Cultivamos, recolectamos, destilamos y transformamos plantas aromáticas, medicinales y silvestres en una gama de productos alimentarios y cosméticos: aceites esenciales, plantas secas, jarabes de miel, aguas florales, aceites de masaje, cremas y lociones."
    ]
  },
