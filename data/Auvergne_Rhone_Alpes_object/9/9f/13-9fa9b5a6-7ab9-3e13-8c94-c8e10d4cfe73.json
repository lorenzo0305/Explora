  "rdfs:comment": {
    "de": [
      "L'Eterle ist die Geschichte von 3 Freunden: Raph, Mel und Max, ihre Liebe zu gutem Essen und guter Laune!\r\nHausgemachte Pizzen, Pasta und Burger in einer entspannten Atmosphäre."
    ],
    "en": [
      "L'Eterle is the story of 3 friends: Raph, Mel and Max, their love of good food and good times!\r\nHomemade pizzas, pasta and burgers served in a relaxed atmosphere."
    ],
    "it": [
      "L'Eterle è la storia di 3 amici: Raph, Mel e Max, il loro amore per il buon cibo e i bei momenti!\r\nPizze, pasta e hamburger fatti in casa serviti in un'atmosfera rilassata."
    ],
    "fr": [
      "L'Eterle, c'est l'histoire de 3 copains : Raph, Mel et Max, amateurs de bons produits et de bons moments ! Pizzas, Pasta et Burgers : chez nous, tout est fait maison! Avec une touche de générosité et une ambiance décontractée."
    ],
    "nl": [
      "L'Eterle is het verhaal van 3 vrienden: Raph, Mel en Max, hun liefde voor lekker eten en goede tijden!\r\nHuisgemaakte pizza's, pasta en hamburgers geserveerd in een ontspannen sfeer."
    ],
    "es": [
      "L'Eterle es la historia de 3 amigos: Raph, Mel y Max, su amor por la buena comida y los buenos momentos.\r\nPizzas caseras, pasta y hamburguesas servidas en un ambiente relajado."
    ]
  },
