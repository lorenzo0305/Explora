  "rdfs:comment": {
    "de": [
      "La table des maquignons ist ein Bergrestaurant mit Raclette und Pierrade.\r\nBar tagsüber, Nachmittagssnack, Abendessen am Abend\r\nWährend der Ferien 6/7 geöffnet- In der Nebensaison von Freitag bis Samstag mittags und abends. + sonntags mittags"
    ],
    "en": [
      "La table des maquignons is a mountain restaurant with raclette and pierrade.\r\nDaytime bar, afternoon snack, evening dinner\r\nOpen 6/7 during vacations - In low season Friday to Saturday lunch and dinner + Sunday lunch"
    ],
    "it": [
      "La table des maquignons è un ristorante di montagna con raclette e pierrade.\r\nBar diurno, spuntino pomeridiano, cena serale\r\nAperto 6/7 durante le vacanze - In bassa stagione da venerdì a sabato a pranzo e sera + domenica a pranzo"
    ],
    "fr": [
      "La table des maquignons est un restaurant de montagne avec raclette et pierrade.\r\nBar en journée, gouter l'après-midi, Diner le soir\r\nOuvert 6/7 pendant les vacances- En basse saison du vendredi au samedi midi et soir. + le dimanche midi"
    ],
    "nl": [
      "La table des maquignons is een bergrestaurant met raclette en pierrade.\r\nOverdag bar, 's middags snack, 's avonds diner\r\nOpen 6/7 tijdens de vakantie - In het laagseizoen vrijdag tot zaterdag 's middags en 's avonds + zondag 's middags"
    ],
    "es": [
      "La table des maquignons es un restaurante de montaña con raclette y pierrade.\r\nBar diurno, merienda, cena\r\nAbierto 6/7 durante las vacaciones - En temporada baja de viernes a sábado a mediodía y por la noche + domingo a mediodía"
    ]
  },
