  "rdfs:comment": {
    "de": [
      "Das Lesen für alle zugänglich machen. Ort der Geselligkeit und des Austauschs, Animation rund um das Buch. Mitglied des Netzes der Bibliotheken und Mediatheken, das von den Gemeinden und dem Gemeindeverband Pays Beaume-Drobie organisiert wird."
    ],
    "en": [
      "To make reading accessible to all. Place of conviviality and exchanges, animation around the book. Member of the network of libraries and media libraries organized by the communes and the community of communes of the Pays Beaume-Drobie."
    ],
    "it": [
      "Rendere la lettura accessibile a tutti. Un luogo di convivialità e scambio, attività legate al libro. Membro della rete di biblioteche e mediateche organizzate dai comuni e dalla comunità dei comuni del Pays Beaume-Drobie."
    ],
    "fr": [
      "Rendre la lecture accessible à tous. Lieu de convivialité et d'échanges, animation autour du livre. Membre du réseau des bibliothèques et médiathèques organisé par les communes et la communauté de communes du Pays Beaume-Drobie."
    ],
    "es": [
      "Hacer que la lectura sea accesible para todos. Un lugar de convivencia e intercambio, actividades relacionadas con el libro. Miembro de la red de bibliotecas y mediatecas organizadas por los municipios y la comunidad de municipios del Pays Beaume-Drobie."
    ],
    "nl": [
      "Doel: lezen toegankelijk maken voor elk publiek. Uitleen van boeken, ontmoetingsplek, activiteiten rondom het thema boeken."
    ]
  },
