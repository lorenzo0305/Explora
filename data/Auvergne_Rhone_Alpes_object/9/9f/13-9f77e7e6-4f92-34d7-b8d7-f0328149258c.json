  "rdfs:comment": {
    "de": [
      "Le Cuvage by RAISIN ROSE, ein Empfangsraum im Herzen der Beaujolais-Weine mit einem 80m² großen Gewölbekeller und freiliegenden Steinen. Eine Gîte mit 15 Schlafplätzen vervollständigt diesen Ort, um von Teamabenden zu profitieren."
    ],
    "en": [
      "Le Cuvage by RAISIN ROSE, a reception room in the heart of the Beaujolais crus, with its 80m² vaulted cellar and exposed stonework. A 15-bed gîte completes the setting for team-building evenings."
    ],
    "it": [
      "Le Cuvage by RAISIN ROSE, una sala ricevimenti nel cuore dei crus del Beaujolais, con la sua cantina a volta di 80 m² e la pietra a vista. Un gîte da 15 posti letto completa l'ambiente per le serate di team-building."
    ],
    "fr": [
      "Le Cuvage by RAISIN ROSE, salle de réception en plein cœur des crus du Beaujolais avec sa cave voûtée de 80m² et ses pierres apparentes. Un gîte de 15 couchages complète ce lieu pour profiter de soirées en équipes."
    ],
    "es": [
      "Le Cuvage by RAISIN ROSE, una sala de recepción en el corazón de los crus del Beaujolais, con su bodega abovedada de 80 m² y su piedra vista. Una casa rural de 15 camas completa el marco para veladas de team-building."
    ],
    "nl": [
      "Le Cuvage by RAISIN ROSE, een ontvangstruimte in het hart van de crus Beaujolais, met een gewelfde kelder van 80 m² en zichtbare stenen. Een gîte met 15 bedden vervolledigt het kader voor teambuildingavonden."
    ]
  },
  "rdfs:label": {
