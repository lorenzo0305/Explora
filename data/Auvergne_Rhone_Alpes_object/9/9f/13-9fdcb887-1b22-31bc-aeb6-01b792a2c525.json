  "rdfs:comment": {
    "de": [
      "Der Vereinsraum ist ein Mehrzweckraum, der dem lokalen, sozialen und kulturellen Leben gewidmet ist. Er steht allen Vereinen der Region offen und dient verschiedenen Aktivitäten wie Versammlungen, Workshops und Schulungen."
    ],
    "en": [
      "The community hall is a multipurpose space dedicated to local, social and cultural life. Open to all local associations, it is designed to host various activities such as meetings, workshops and training courses."
    ],
    "it": [
      "La sala della comunità è uno spazio polivalente dedicato alla vita locale, sociale e culturale. È aperta a tutte le associazioni locali e può essere utilizzata per diverse attività come riunioni, laboratori e corsi di formazione."
    ],
    "fr": [
      "La salle associative est un espace polyvalent dédié à la vie locale, sociale et culturelle. Ouverte à l’ensemble des associations du territoire, elle a pour vocation d’accueillir diverses activités telles que des réunions, ateliers, formations."
    ],
    "es": [
      "El salón comunitario es un espacio polivalente dedicado a la vida local, social y cultural. Está abierto a todas las asociaciones locales y puede utilizarse para diversas actividades, como reuniones, talleres y cursos de formación."
    ],
    "nl": [
      "De gemeenschapsruimte is een multifunctionele ruimte die gewijd is aan het lokale, sociale en culturele leven. Het staat open voor alle lokale verenigingen en kan worden gebruikt voor verschillende activiteiten zoals vergaderingen, workshops en trainingen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Salle associative"
    ]
  },
