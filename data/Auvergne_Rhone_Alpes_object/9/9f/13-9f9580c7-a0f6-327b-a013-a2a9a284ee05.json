  "rdfs:comment": {
    "de": [
      "Emeric Duclaux produziert kleine rote Beeren, die mit ihren Wurzeln fest im vulkanischen Boden des Altiligériens auf 1000 m Höhe angebaut werden!\r\nEr bietet an, seine Himbeeren, schwarzen Johannisbeeren und Stachelbeeren selbst zu pflücken."
    ],
    "en": [
      "Emeric Duclaux grows red berries with roots firmly planted in the volcanic soil of the Altiligérien at an altitude of 1000m!\r\nYou can pick your own raspberries, blackcurrants and redcurrants."
    ],
    "it": [
      "Emeric Duclaux coltiva frutti rossi con le radici ben piantate nel terreno vulcanico dell'Allier, a 1.000 metri di altitudine!\r\nPotete venire a raccogliere i vostri lamponi, ribes nero e ribes rosso."
    ],
    "fr": [
      "Emeric Duclaux produit des petits fruits rouges cultivés aux racines bien ancrées dans le sol volcanique altiligérien à 1000m d'altitude ! \r\nIl propose de venir cueillir soi-même ses framboises, cassis, groseille."
    ],
    "nl": [
      "Emeric Duclaux kweekt rode bessen met hun wortels stevig verankerd in de vulkanische grond van de Allier op 1000 meter hoogte!\r\nJe kunt je eigen frambozen, zwarte bessen en rode bessen komen plukken."
    ],
    "es": [
      "Emeric Duclaux cultiva bayas rojas con las raíces bien plantadas en el suelo volcánico del Allier, ¡a 1.000 metros de altitud!\r\nPuede venir a recoger sus propias frambuesas, grosellas negras y rojas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Mont-Gros Fruits Rouges"
    ]
  },
