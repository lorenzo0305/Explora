  "rdfs:comment": {
    "de": [
      "Das Château Les Oliviers de Salettes begrüßt Sie auf einem Anwesen von außergewöhnlicher Schönheit im Herzen der einzigartigen Landschaft der Drôme Provençale."
    ],
    "en": [
      "Located on an area of exceptional beauty, Château Les Oliviers de Salettes ***** welcomes you in the heart of the unique landscapes of the Drôme Provençale."
    ],
    "it": [
      "Situato in una tenuta di eccezionale bellezza, lo Château Les Oliviers de Salettes ***** vi accoglie nel cuore dei paesaggi unici della Drôme Provençale."
    ],
    "fr": [
      "Implanté sur un domaine d’une beauté exceptionnelle, Le Château Les Oliviers de Salettes ***** vous accueille au cœur des paysages uniques de la Drôme Provençale."
    ],
    "es": [
      "Situado en una finca de excepcional belleza, el Château Les Oliviers de Salettes ***** le da la bienvenida al corazón de los paisajes únicos de la Drôme provenzal."
    ],
    "nl": [
      "Château Les Oliviers de Salettes ligt op een gebied van uitzonderlijke schoonheid en heet u welkom in het hart van de unieke landschappen van de Drôme Provençale."
    ]
  },
