  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/84bd7eba-2623-3e5e-b6ba-d4f91de67173",
      "dc:description": {
        "de": [
          "Die Guinguette au bord de l'eau in Enquin-sur-Baillons kommt dieses Jahr wieder!!!\nTreffpunkt ist am Sonntag, den 27. Juli\nProgramm ab 8 Uhr Inter-Dorf mit Animationen + Verpflegung vor Ort"
        ],
        "en": [
          "La Guinguette au bord de l'eau d'Enquin-sur-Baillons is back again this year!\nSee you on Sunday, July 27\nOn the program from 8 a.m.: inter-village entertainment + on-site catering"
        ],
        "it": [
          "La Guinguette au bord de l'eau d'Enquin-sur-Baillons torna anche quest'anno!\nCi vediamo domenica 27 luglio\nIn programma a partire dalle 8.00: animazione inter-villaggio + ristorazione in loco"
        ],
        "fr": [
          "La Guinguette au bord de l'eau d'Enquin-sur-Baillons revient pour cette année !!\nRendez-vous le dimanche 27 juillet\nAu programme dès 8h inter-village avec animations + restauration sur place"
        ],
        "es": [
          "La Guinguette au bord de l'eau d'Enquin-sur-Baillons vuelve un año más\nNos vemos el domingo 27 de julio\nEn el programa, a partir de las 8.00 h: animaciones entre los pueblos + catering in situ"
        ],
        "nl": [
          "La Guinguette au bord de l'eau d'Enquin-sur-Baillons is dit jaar weer terug!\nTot ziens op zondag 27 juli\nOp het programma vanaf 8 uur: dorpsanimatie + catering ter plaatse"
        ]
      },
