  "rdfs:comment": {
    "de": [
      "Es ist im Sommer geöffnet und empfängt Sie mit seinen zwei Außenbecken. Sessel zum Einsetzen ins Wasser für Personen mit eingeschränkter Mobilität. Im Sommer besteht die Möglichkeit, Schwimmunterricht für Kinder zu nehmen."
    ],
    "en": [
      "Open in summer, it welcomes you with its two outdoor pools. Wheelchair access for the disabled. Children's swimming lessons available in summer."
    ],
    "it": [
      "Aperto in estate, vi accoglie con le sue due piscine all'aperto. Accesso all'acqua con sedia a rotelle per le persone a mobilità ridotta. Possibilità di lezioni di nuoto per bambini in estate."
    ],
    "fr": [
      "Ouverte l'été, elle vous accueille avec ses deux bassins en plein air. Fauteuil de mise à l'eau pour les personnes à mobilité réduite. Possibilité de leçons de natation pour enfants l'été."
    ],
    "nl": [
      "Open in de zomer, het verwelkomt u met zijn twee buitenzwembaden. Toegang tot het water voor mensen met beperkte mobiliteit. Mogelijkheid van zwemlessen voor kinderen in de zomer."
    ],
    "es": [
      "Abierto en verano, le da la bienvenida con sus dos piscinas al aire libre. Acceso al agua en silla de ruedas para personas con movilidad reducida. Posibilidad de clases de natación para niños en verano."
    ]
  },
