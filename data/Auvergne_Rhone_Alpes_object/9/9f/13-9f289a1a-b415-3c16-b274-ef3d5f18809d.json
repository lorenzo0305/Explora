  "rdfs:comment": {
    "de": [
      "Im Herzen des Beaujolais, in der Nähe des Mont Brouilly, stellt Yan Sanchez vom Atelier Sy Töpferwaren und Keramiken aus Steinzeug für den täglichen Gebrauch her."
    ],
    "en": [
      "In the heart of the Beaujolais region, near Mont Brouilly, Yan Sanchez of the Sy workshop creates stoneware pottery and ceramics for everyday use."
    ],
    "it": [
      "Nel cuore della regione del Beaujolais, vicino a Mont Brouilly, Yan Sanchez del laboratorio Sy crea vasellame in gres e ceramiche di uso quotidiano."
    ],
    "fr": [
      "Au cœur du Beaujolais, près du Mont Brouilly, Yan Sanchez de l'atelier Sy crée des poteries et céramiques en grès pour un usage quotidien."
    ],
    "nl": [
      "In het hart van de Beaujolais, vlakbij de Mont Brouilly, maakt Yan Sanchez van het atelier Sy aardewerk en keramiek voor dagelijks gebruik."
    ],
    "es": [
      "En el corazón de la región del Beaujolais, cerca de Mont Brouilly, Yan Sánchez, del taller Sy, crea alfarería de gres y cerámica de uso cotidiano."
    ]
  },
