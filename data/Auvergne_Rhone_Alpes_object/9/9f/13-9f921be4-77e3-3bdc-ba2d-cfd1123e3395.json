  "rdfs:comment": {
    "de": [
      "Das Hotel Mont Blanc Val d'Isère****, eine neue Oase der Ruhe in einer gemütlichen und warmen Atmosphäre.\r\nKommen Sie und tanken Sie neue Energie, wir kümmern uns um alles, um Ihren Aufenthalt unvergesslich zu machen."
    ],
    "en": [
      "The Mont Blanc Val d'Isère**** hotel, a new haven of peace with a cozy and welcoming atmosphere.\r\nCome and recharge your batteries, we will take care of everything to make your stay unforgettable."
    ],
    "it": [
      "L'hotel Mont Blanc Val d'Isère****, un nuovo rifugio di pace in un'atmosfera accogliente e calorosa.\r\nVenite a ricaricare le batterie, penseremo noi a tutto per rendere indimenticabile il vostro soggiorno."
    ],
    "fr": [
      "L'hôtel Mont Blanc Val d'Isère****, un nouvel havre de paix dans une ambiance cosy et chaleureuse.\r\nVenez vous ressourcer, nous nous occupons de tout pour rendre inoubliable votre séjour."
    ],
    "es": [
      "L'hôtel Mont Blanc Val d'Isère****, un nuevo remanso de paz en un ambiente acogedor y cálido.\r\nVenga a recargar las pilas, nos ocuparemos de todo para que su estancia sea inolvidable."
    ],
    "nl": [
      "L'hôtel Mont Blanc Val d'Isère****, een nieuwe oase van rust in een gezellige en warme sfeer.\r\nKom nieuwe energie opdoen en wij zorgen ervoor dat uw verblijf onvergetelijk wordt."
    ]
  },
