  "rdfs:comment": {
    "de": [
      "Italienisches Restaurant mit Charakter. Les Quatre Gourmets befindet sich im Herzen dieser Hochburg der Gastronomie, die heute die Hauptstadt Annecy-le-Vieux ist, zwischen renommierten Michelin-Sternen und charaktervollen Cafés und Brasserien."
    ],
    "en": [
      "Italian restaurant with character. Les Quatre Gourmets is at the heart of the gastronomic stronghold that is today Annecy-le-Vieux, between prestigious Michelin-starred restaurants and characterful cafés and brasseries."
    ],
    "it": [
      "Ristorante italiano di carattere. Les Quatre Gourmets si trova nel cuore della roccaforte gastronomica di Annecy-le-Vieux, con i suoi prestigiosi ristoranti, caffè e brasserie stellati Michelin."
    ],
    "fr": [
      "Restaurant italien de caractère. Les Quatre Gourmets est au cœur de cette place forte de la gastronomie qu’est aujourd’hui le chef-lieu d’Annecy-le-Vieux, entre étoilé Michelin prestigieux et cafés et brasseries de caractère."
    ],
    "es": [
      "Restaurante italiano con carácter. Les Quatre Gourmets se encuentra en el corazón del bastión gastronómico que es Annecy-le-Vieux, con sus prestigiosos restaurantes, cafés y brasseries galardonados con estrellas Michelin."
    ],
    "nl": [
      "Italiaans restaurant met karakter. Les Quatre Gourmets ligt in het hart van het gastronomische bolwerk dat Annecy-le-Vieux is, met zijn prestigieuze restaurants, cafés en brasserieën met Michelinsterren."
    ]
  },
