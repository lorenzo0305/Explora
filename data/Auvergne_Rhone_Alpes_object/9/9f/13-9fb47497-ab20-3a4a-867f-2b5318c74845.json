  "rdfs:comment": {
    "de": [
      "Arrondissement, am Ufer der Saône, entdecken Sie das Hotel Spark by Hilton Lyon Park Saone: ein zeitgenössisches Hotel, ideal für Ihren Geschäfts- oder Freizeitaufenthalt."
    ],
    "en": [
      "Along the banks of the river Saône, discover Spark by Hilton Lyon Park Saone, a contemporary hotel, ideal for your business or leisure stays."
    ],
    "it": [
      "Nel 9° arrondissement, sulle rive della Saona, scoprite l'hotel Spark by Hilton Lyon Park Saone: una struttura contemporanea, ideale per i vostri soggiorni di lavoro o di piacere."
    ],
    "fr": [
      "Dans le 9e arrondissement, en bord de Saône, découvrez l'hôtel Spark by Hilton Lyon Park Saone : un établissement contemporain, idéal pour votre séjour d’affaires ou loisirs."
    ],
    "nl": [
      "Ontdek in het 9e arrondissement, aan de oevers van de Saône, het Spark by Hilton Lyon Park Saone hotel: een eigentijds etablissement, ideaal voor uw zaken- of vakantieverblijf."
    ],
    "es": [
      "En el distrito 9, a orillas del Saona, descubra el hotel Spark by Hilton Lyon Park Saone: un establecimiento contemporáneo, ideal para su estancia de negocios o de ocio."
    ]
  },
