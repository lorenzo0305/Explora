  "rdfs:comment": {
    "de": [
      "Die Kapelle von Les Chazes liegt im Herzen des Allier-Tals und war bis zur Revolution von der benachbarten Abtei Saint-Pierre des Chazes abhängig. Sie ist eines der architektonischen Glanzstücke des Haut-Allier."
    ],
    "en": [
      "Nestling in the heart of the Allier valley, the chapel at Les Chazes depended on the neighboring Abbey of Saint-Pierre des Chazes until the French Revolution. It is one of the architectural jewels of the Haut-Allier region."
    ],
    "it": [
      "Immersa nel cuore della valle dell'Allier, la cappella di Les Chazes apparteneva alla vicina abbazia di Saint-Pierre des Chazes fino alla Rivoluzione. È uno dei gioielli architettonici dell'Haut-Allier."
    ],
    "fr": [
      "Nichée au coeur de la vallée de l'Allier, la chapelle des Chazes dépend jusque la Révolution de l'Abbaye voisine de Saint-Pierre des Chazes. Elle est un des fleurons architectural du Haut-Allier."
    ],
    "es": [
      "Enclavada en el corazón del valle del Allier, la capilla de Les Chazes perteneció a la vecina abadía de Saint-Pierre des Chazes hasta la Revolución. Es una de las joyas arquitectónicas del Haut-Allier."
    ],
    "nl": [
      "De kapel van Les Chazes, gelegen in het hart van de Alliervallei, behoorde tot de Revolutie toe aan de naburige abdij Saint-Pierre des Chazes. Het is een van de architectonische juwelen van de Haut-Allier."
    ]
  },
  "rdfs:label": {
