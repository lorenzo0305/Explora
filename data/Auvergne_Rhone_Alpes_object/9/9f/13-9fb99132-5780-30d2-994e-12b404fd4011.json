  "rdfs:comment": {
    "de": [
      "Das Fremdenverkehrsamt befindet sich in Mornant. Vor Ort finden Sie Ratschläge, touristische Dokumentationen und praktische Dienstleistungen für Ihren Aufenthalt und Ihre Ausflüge in die Monts du Lyonnais!"
    ],
    "en": [
      "Tourist Office located in Mornant. On the spot, you will find advice, tourist documentation, practical services for your stays and escapades in the Monts du Lyonnais!"
    ],
    "it": [
      "Ufficio del turismo situato a Mornant. Sul posto, troverete consigli, documentazione turistica, servizi pratici per i vostri soggiorni e le vostre fughe nei Monts du Lyonnais!"
    ],
    "fr": [
      "Office de Tourisme situé à Mornant. Sur place, vous trouverez conseils, documentation touristique, services pratiques pour vos séjours et escapades dans les Monts du Lyonnais !"
    ],
    "nl": [
      "Toeristenbureau in Mornant. Ter plaatse vindt u advies, toeristische documentatie, praktische diensten voor uw verblijf en escapades in de Monts du Lyonnais!"
