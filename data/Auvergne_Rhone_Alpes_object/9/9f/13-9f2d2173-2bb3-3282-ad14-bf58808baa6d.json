  "rdfs:comment": {
    "de": [
      "Eric Charrière erwartet Sie den ganzen Sommer über im Hafen von Sciez, um Ihnen das Gefühl des Gleitens auf dem Genfersee zu vermitteln und Ihnen die Ausübung verschiedener Wassersportaktivitäten (Wakesurfen, Wakeboarding, Bi-Ski, Monoski, Barefoot und Schleppboje) zu lehren."
    ],
    "en": [
      "Eric Charrière awaits you all summer long at the Port de Sciez to help you discover the sensations of gliding on Lake Geneva and teach you how to practice various water sports (wakesurfing, wakeboarding, bi-skiing, monoskiing, barefoot and towed buoys)."
    ],
    "it": [
      "Eric Charrière vi aspetta tutta l'estate al Port de Sciez per farvi scoprire le emozioni del volo a vela sul Lago di Ginevra e insegnarvi a praticare diversi sport acquatici (wakesurf, wakeboard, bi-ski, monosci, boe a piedi nudi e trainati)."
    ],
    "fr": [
      "Eric Charrière vous attend tout l’été au Port de Sciez pour vous faire découvrir les sensations de la glisse sur le Léman et vous enseigner la pratique de différentes activités nautiques  (wakesurf, wakeboard, bi-ski, monoski, barefoot et bouée tractée)."
    ],
    "nl": [
      "Eric Charrière wacht de hele zomer op je in de Port de Sciez om je de sensaties van het zweefvliegen op het meer van Genève te laten ontdekken en je verschillende watersporten te leren (wakesurfen, wakeboarden, bi-ski, monoski, barefoot en sleepboeien)."
    ],
    "es": [
      "Eric Charrière le espera todo el verano en el Port de Sciez para hacerle descubrir las emociones del deslizamiento por el lago Lemán y enseñarle a practicar diversos deportes náuticos (wakesurf, wakeboard, bi-esquí, monoesquí, boyas descalzas y remolcadas)."
    ]
  },
