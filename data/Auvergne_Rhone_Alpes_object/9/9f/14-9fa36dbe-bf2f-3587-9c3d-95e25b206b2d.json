  "rdfs:comment": {
    "de": [
      "Fassaden in Meurchin und Sains-en-Gohelle werden am 4. und 5. Oktober 2024 im Rahmen des VideoMapping Festivals, das durch die Region Hauts-de-France führt, beleuchtet."
    ],
    "en": [
      "Facades in Meurchin and Sains-en-Gohelle will be illuminated on October 4 and 5, 2024, as part of the VideoMapping Festival, which crosses the Hauts-de-France region."
    ],
    "it": [
      "Le facciate di Meurchin e Sains-en-Gohelle saranno illuminate il 4 e 5 ottobre 2024 nell'ambito del VideoMapping Festival, che sta facendo il giro della regione Hauts-de-France."
    ],
    "fr": [
      "Des façades de Meurchin et Sains-en-Gohelle s'illumineront les 4 et 5 octobre 2024 dans le cadre du VideoMapping Festival, qui traverse les Hauts-de-France."
    ],
    "es": [
      "Las fachadas de Meurchin y Sains-en-Gohelle se iluminarán los días 4 y 5 de octubre de 2024 en el marco del Festival VideoMapping, que recorre la región de Hauts-de-France."
    ],
    "nl": [
      "Gevels in Meurchin en Sains-en-Gohelle worden op 4 en 5 oktober 2024 verlicht als onderdeel van het VideoMapping Festival, dat door de regio Hauts-de-France toert."
    ]
  },
