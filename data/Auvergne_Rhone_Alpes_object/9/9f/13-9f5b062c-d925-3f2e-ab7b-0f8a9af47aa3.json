  "rdfs:comment": {
    "de": [
      "In einem 25 ha großen Park mitten in der Natur bietet Ihnen Jas Sport das ganze Jahr über zahlreiche Aktivitäten: Reiten, Mountainbiken, Kletterpark, Bogenschießen, Kanu … für alle Besucher (sportlich oder nicht, ob Groß oder Klein), auch für Gruppen (Freizeitzentren, Klubs, Unternehmen)"
    ],
    "en": [
      "In a 25-hectare natural park, JAS Sport offers you a range of activities throughout the year: horseback riding, mountain biking, rope course park, archery, canoe, and more, suitable for all (large and small, sporty or not), including groups and professionals (leisure centre, clubs, companies)."
    ],
    "it": [
      "Centro sportivo all'aperto multiattività: equitazione, tree climbing, ciclismo su strada, mountain bike, orienteering, tiro con l'arco, canoa, escursionismo."
    ],
    "fr": [
      "Centre de plein air sportif multi-activité : équitation, accrobranche, vélo de route, VTT, course d'orientation, tir à l'arc, canoë, randonnée pédestre."
    ],
    "nl": [
      "Multisportcentrum: paardrijden, boomklimmen, wielrennen, mountainbiken, oriëntatieloop, boogschieten, kanoën, wandelen."
    ],
    "es": [
      "Centro deportivo multiactividad al aire libre: equitación, arborismo, ciclismo de carretera, bicicleta de montaña, orientación, tiro con arco, piragüismo, senderismo."
    ]
  },
