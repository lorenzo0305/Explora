  "rdfs:comment": {
    "de": [
      "Sorgfältig ausgewählte Produkte, köstliche und großzügige Gerichte, eine schöne Weinkarte und eine freundliche Atmosphäre - Roliko ist das Restaurant für Genießer."
    ],
    "en": [
      "Carefully selected products, generous gourmet dishes, an excellent wine list and a friendly atmosphere: Roliko is the restaurant for bon vivants."
    ],
    "it": [
      "Con prodotti accuratamente selezionati, generosi piatti gourmet, un'ottima carta dei vini e un'atmosfera amichevole, il Roliko è il ristorante per i bon vivants."
    ],
    "fr": [
      "Produits rigoureusement sélectionnés, plats gourmands et généreux, belle carte des vins, ambiance conviviale, Roliko c’est le restaurant des bons vivants."
    ],
    "nl": [
      "Met zorgvuldig geselecteerde producten, royale gastronomische gerechten, een fijne wijnkaart en een vriendelijke sfeer is Roliko hét restaurant voor levensgenieters."
    ],
    "es": [
      "Con productos cuidadosamente seleccionados, generosos platos gourmet, una excelente carta de vinos y un ambiente agradable, Roliko es el restaurante de los bon vivants."
    ]
  },
