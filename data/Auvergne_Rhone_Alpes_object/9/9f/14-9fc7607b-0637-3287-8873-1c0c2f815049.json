      "dc:description": {
        "de": [
          "Geöffnet Dienstag bis Freitag von 9 bis 14 Uhr, Samstag von 9 bis 13 Uhr und von 14 bis 18.30 Uhr. Bestellung per Telefon unter 03.21.31.94.74. Eine Lieferung ist möglich. Website: www.philippeolivier.fr"
        ],
        "en": [
          "Open Tuesday to Friday 9am to 2pm, Saturday 9am to 1pm and 2pm to 6.30pm. Order by phone 03.21.31.94.74. Delivery available. Website: www.philippeolivier.fr"
        ],
        "it": [
          "Aperto da martedì a venerdì dalle 9.00 alle 14.00, sabato dalle 9.00 alle 13.00 e dalle 14.00 alle 18.30. Ordinare per telefono al numero 03.21.31.94.74. Possibilità di consegna. Sito web: www.philippeolivier.fr"
        ],
        "fr": [
          "Ouvert du mardi au vendredi de 9h à 14h, le samedi de 9h à 13h et de 14h à 18h30. Commande par téléphone au 03.21.31.94.74. Livraison possible. Site Internet : www.philippeolivier.fr"
        ],
        "nl": [
          "Open van dinsdag tot vrijdag van 9 tot 14 uur, op zaterdag van 9 tot 13 uur en van 14 tot 18.30 uur. Telefonisch te bestellen op 03.21.31.94.74. Levering mogelijk. Website: www.philippeolivier.fr"
        ],
        "es": [
          "Abierto de martes a viernes de 9.00 a 14.00 h., sábados de 9.00 a 13.00 h. y de 14.00 a 18.30 h. Pedidos por teléfono al 03.21.31.94.74. Entrega a domicilio. Página web: www.philippeolivier.fr"
        ]
      },
