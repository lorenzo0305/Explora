  "rdfs:comment": {
    "de": [
      "Automat mit frischen Pizzen zum Mitnehmen rund um die Uhr: Die Pizzen werden in 3 Minuten gebacken oder in 30 Sekunden kalt geliefert, um sie zu Hause zu backen. 100% Originalrezepte, die mit Qualitätsprodukten hergestellt werden."
    ],
    "en": [
      "Fresh pizzas to take away 24/7: pizzas are delivered baked in 3 minutes or cold in 30 seconds to cook at home. 100% original recipes made with quality products."
    ],
    "it": [
      "Pizze fresche da asporto 24 ore su 24, 7 giorni su 7: le pizze vengono consegnate cotte in 3 minuti o fredde in 30 secondi per essere cucinate a casa. Ricette 100% originali realizzate con prodotti di qualità."
    ],
    "fr": [
      "Distributeur de pizzas fraiches à emporter 24h/24 et 7j/7 : Les pizzas sont délivrées cuites en 3 min ou froides en 30 secondes à cuire chez soi. Recettes 100% originales réalisées avec des produits de qualité."
    ],
    "es": [
      "Pizzas frescas para llevar 24 horas al día, 7 días a la semana: las pizzas se entregan cocinadas en 3 minutos o frías en 30 segundos para cocinar en casa. Recetas 100% originales elaboradas con productos de calidad."
    ],
    "nl": [
      "24/7 verse pizza's om mee te nemen: pizza's worden in 3 minuten gaar geleverd of in 30 seconden koud om thuis te bereiden. 100% originele recepten gemaakt met kwaliteitsproducten."
    ]
  },
  "rdfs:label": {
