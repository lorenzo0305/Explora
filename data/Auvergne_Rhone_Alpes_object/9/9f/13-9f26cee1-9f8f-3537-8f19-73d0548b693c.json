  "rdfs:comment": {
    "de": [
      "Bewegen Sie sich mithilfe Ihrer Karte durch diesen eher unbekannten Teil des Naturparks Vercors und entdecken Sie das Natur- und Kulturerbe von Gresse-en-Vercors."
    ],
    "en": [
      "Use your map to explore this lesser-known part of the Vercors Natural Park and discover the natural and cultural heritage of Gresse-en-Vercors."
    ],
    "it": [
      "Con l'aiuto della vostra mappa, muovetevi in questa parte meno conosciuta del Parco Naturale del Vercors per scoprire il patrimonio naturale e culturale di Gresse-en-Vercors."
    ],
    "fr": [
      "A l'aide de votre carte, déplacez-vous dans cette partie plus méconnue du Parc Naturel du Vercors pour découvrir la patrimoine naturel et culturel de Gresse-en-Vercors."
    ],
    "nl": [
      "Trek met behulp van uw kaart door dit minder bekende deel van het Natuurpark van de Vercors om het natuurlijke en culturele erfgoed van Gresse-en-Vercors te ontdekken."
    ],
    "es": [
      "Con la ayuda de su mapa, muévase por esta parte menos conocida del Parque Natural de Vercors para descubrir el patrimonio natural y cultural de Gresse-en-Vercors."
    ]
  },
  "rdfs:label": {
