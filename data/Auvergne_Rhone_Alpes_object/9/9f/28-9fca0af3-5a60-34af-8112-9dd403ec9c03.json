  "rdfs:comment": {
    "de": [
      "Zubereitung von Mahlzeiten für Feierlichkeiten. Zubereitung von Produkten aus der Region Picardie unter Verwendung von Pflanzen aus der Sommebucht, aber auch von Früchten."
    ],
    "en": [
      "Elaboration of meals for ceremonies. Preparation of products from the Picardy region, combining plants from the Baie de Somme and fruits."
    ],
    "it": [
      "Preparazione di pasti per cerimonie. Preparazione di prodotti della regione della Piccardia, combinando piante della Baie de Somme e frutta."
    ],
    "fr": [
      "Élaboration de repas pour cérémonies. Préparation de produits provenant du terroir picard en associant les plantes de la Baie de Somme mais aussi les fruits."
    ],
    "es": [
      "Preparación de comidas para ceremonias. Preparación de productos de la región de Picardía, combinando plantas de la Bahía de Somme y frutas."
    ],
    "nl": [
      "Bereiding van maaltijden voor ceremonies. Bereiding van producten uit de Picardische streek, met planten uit de Baie de Somme en fruit."
    ]
