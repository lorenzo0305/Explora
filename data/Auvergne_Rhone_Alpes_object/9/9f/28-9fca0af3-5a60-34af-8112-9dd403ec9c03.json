  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/fa1c509c-8eb5-3f28-b3ea-4cfc93d44908",
      "dc:description": {
        "de": [
          "Ihr Caterer in Saint-Valery bietet Ihnen seine Spezialitäten an: Pâté en croute, Bigalan, Boudin Noir, Goûteux, Terrine d'agneau de Pré-Salé & andere regionale Produkte.\nWir erarbeiten gemeinsam Ihre Mahlzeiten für Ihre Feier.\n\nVor Ort hergestellte Konserven"
        ],
        "en": [
          "Your caterer in Saint-Valery offers its specialities: pâté en croute, Bigalan, Boudin Noir, Goûteux, Terrine d'agneau de Pré-Salé & other regional products.\nWe prepare your meals together for your ceremony.\n\nCanned food produced on site"
        ],
        "it": [
          "Il vostro catering a Saint-Valery vi offre le sue specialità: pâté en croute, Bigalan, Boudin Noir, Goûteux, Terrine d'agneau de Pré-Salé e altri prodotti regionali.\nPrepareremo insieme i pasti per la vostra cerimonia.\n\nConserve prodotte in loco"
        ],
        "fr": [
          "Votre traiteur sur Saint-Valery vous propose ses spécialités : pâté en croute, Bigalan, Boudin Noir, Goûteux, Terrine d'agneau de Pré-Salé & autres produits régionaux.\nNous élaborons vos repas ensemble pour votre cérémonie.\n\nConserves produites sur place"
        ],
        "nl": [
          "Uw traiteur in Saint-Valery biedt u zijn specialiteiten: paté en croute, Bigalan, Boudin Noir, Goûteux, Terrine d'agneau de Pré-Salé en andere streekproducten.\nWe zullen samen uw maaltijden bereiden voor uw ceremonie.\n\nTer plaatse geproduceerde conserven"
        ],
        "es": [
          "Su servicio de catering en Saint-Valery le ofrece sus especialidades: paté en croute, Bigalan, Boudin Noir, Goûteux, Terrine d'agneau de Pré-Salé y otros productos regionales.\nPrepararemos juntos las comidas para su ceremonia.\n\nConservas producidas in situ"
        ]
      },
      "@type": [
        "Description"
      ],
