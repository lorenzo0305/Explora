  "rdfs:comment": {
    "de": [
      "Der Reitclub und das Reittourismuszentrum Les écuries de Grand-c?ur befinden sich in der Gemeinde Aigueblanche im Herzen der Tarentaise, 5 km von Moûtiers und 25 km von Albertville entfernt."
    ],
    "en": [
      "Les écuries de Grand-cœur riding club and equestrian tourism centre is located in the commune of Aigueblanche in the heart of the Tarentaise region, 5 km from Moûtiers and 25 km from Albertville."
    ],
    "it": [
      "Il club di equitazione e centro di turismo equestre Les écuries de Grand-c?ur si trova nel comune di Aigueblanche, nel cuore della regione della Tarentaise, a 5 km da Moûtiers e a 25 km da Albertville."
    ],
    "fr": [
      "Le club hippique et centre de tourisme équestre Les écuries de Grand-cœur est situé sur la commune d'Aigueblanche en plein coeur de la Tarentaise, à 5 km de Moûtiers et 25 km d'Albertville."
    ],
    "nl": [
      "Les écuries de Grand-cœur paardrijclub en centrum voor paardentoerisme ligt in de gemeente Aigueblanche in het hart van de Tarentaise regio, op 5 km van Moûtiers en 25 km van Albertville."
    ],
    "es": [
      "El club hípico y centro de turismo ecuestre Les écuries de Grand-cœur está situado en el municipio de Aigueblanche, en el corazón de la Tarentaise, a 5 km de Moûtiers y a 25 km de Albertville."
    ]
