  "rdfs:comment": {
    "de": [
      "Die MPT des Stadtzentrums schlägt eine festliche Zeit vor, die für alle offen ist! Wecken Sie Ihre Sinne im Rhythmus des Frühlings mit Mitmach-Animationen!"
    ],
    "en": [
      "The MPT downtown offers a festive time open to all! Awaken your senses to the rhythms of spring with participatory activities!"
    ],
    "it": [
      "L'MPT del centro città organizza un evento festivo aperto a tutti! Risvegliate i vostri sensi ai ritmi della primavera con una serie di attività partecipative!"
    ],
    "fr": [
      "La MPT du centre-ville propose un temps festifs ouvert à tous ! Réveillez vos sens au rythme du printemps avec des animations participatives !"
    ],
    "nl": [
      "Het MPT in het stadscentrum organiseert een feestelijk evenement dat voor iedereen toegankelijk is! Prikkel je zintuigen voor de ritmes van de lente met een reeks participatieve activiteiten!"
    ],
    "es": [
      "El MPT del centro de la ciudad organiza un evento festivo abierto a todos Despierte sus sentidos a los ritmos de la primavera con una serie de actividades participativas"
    ]
  },
  "rdfs:label": {
    "fr": [
