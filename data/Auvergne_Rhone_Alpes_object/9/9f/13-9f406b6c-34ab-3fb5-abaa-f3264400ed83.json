  "rdfs:comment": {
    "de": [
      "Das Grand Café im Quartier de l'Amara in Avoriaz empfängt Sie abends in einem modernen und gemütlichen Rahmen. Genießen Sie Brasserie-Küche, savoyische Spezialitäten und Pizza (vor Ort oder zum Mitnehmen), mit einem atemberaubenden Blick auf die Berge."
    ],
    "en": [
      "Le Grand Café, located in L'Amara district, is open every day for lunch and dinner. Modern décor combined with traditional brasserie menu serving Savoyard specialities and pizzas (eat in or take away)."
    ],
    "it": [
      "Le Grand Café, nel quartiere Amara di Avoriaz, vi accoglie la sera in un ambiente caldo e moderno. Godetevi la cucina in stile brasserie, le specialità savoiarde e le pizze (sul posto o da asporto), con una vista mozzafiato sulle montagne."
    ],
    "fr": [
      "Le Grand Café, au quartier de l’Amara à Avoriaz, vous accueille le soir dans un cadre moderne et chaleureux. Dégustez une cuisine de brasserie, des spécialités savoyardes et des pizzas (sur place ou à emporter), avec une vue imprenable sur les montagnes."
    ],
    "nl": [
      "Le Grand Café, midden in de wijk L'Amara heet u elke dag voor lunch of diner welkom in een moderne stijl met traditionele brasserie-gerechten, specialiteiten uit de Savoie en pizza's (ter plaatse of afhaal)."
    ],
    "es": [
      "Le Grand Café, en el barrio Amara de Avoriaz, le da la bienvenida por la noche en un ambiente cálido y moderno. Disfrute de la cocina de brasserie, las especialidades de Saboya y las pizzas (en el local o para llevar), con una vista impresionante de las montañas."
    ]
  },
  "rdfs:label": {
    "en": [
      "Le Grand Café Restaurant"
    ],
    "fr": [
      "Restaurant Le Grand Café"
    ],
    "nl": [
      "Restaurant Le Grand Café"
    ]
  },
