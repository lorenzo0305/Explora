  "rdfs:comment": {
    "de": [
      "Handwerker und Holzbauer, der auf die Unterstützung beim Selbstbau spezialisiert ist, vom Häuschen bis zum kleinen Haus, über einen Tierunterstand, eine Terrasse oder einen Anbau... Ich fertige auch Außenmöbel aus Holz nach Maß an."
    ],
    "en": [
      "Artisan wood builder specializing in self-build projects, from garden sheds to small houses, from animal shelters to decks and extensions... I also make custom outdoor wooden furniture."
    ],
    "it": [
      "Artigiano costruttore di legname specializzato in progetti di autocostruzione, da capanni da giardino a piccole case, compresi rifugi per animali, terrazze e ampliamenti... Realizzo anche mobili da esterno in legno su misura."
    ],
    "fr": [
      "Artisan constructeur bois spécialisé dans l'accompagnement à l'auto-construction, du cabanon à la petite maison, en passant par un abri pour animaux une terrasse ou une extension... Je fais aussi du mobilier extérieur en bois sur mesure."
    ],
    "es": [
      "Constructor artesano de madera especializado en proyectos de autoconstrucción, desde casetas de jardín a pequeñas casas, pasando por refugios para animales, terrazas y ampliaciones... También fabrico muebles de exterior de madera a medida."
    ],
    "nl": [
      "Ambachtelijke houtbouwer gespecialiseerd in zelfbouwprojecten, van tuinhuisjes tot kleine huizen, inclusief dierenverblijven, terrassen en uitbreidingen... Ik maak ook houten buitenmeubilair op maat."
    ]
  },
