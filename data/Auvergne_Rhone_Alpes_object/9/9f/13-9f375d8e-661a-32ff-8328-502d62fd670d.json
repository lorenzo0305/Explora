  "rdfs:comment": {
    "de": [
      "Der Verein La Boule du Vercors vereint die Pétanque-Begeisterten der Region. Er organisiert das ganze Jahr über Turniere, gesellige Treffen und Veranstaltungen und fördert dabei den Sportgeist und die Kameradschaft."
    ],
    "en": [
      "The association La Boule du Vercors brings together local pétanque enthusiasts. It organizes tournaments, get-togethers and events throughout the year, promoting sportsmanship and camaraderie."
    ],
    "it": [
      "L'associazione Boule du Vercors riunisce gli appassionati di pétanque di tutta la regione. Organizza tornei, incontri ed eventi durante tutto l'anno, promuovendo lo spirito sportivo e il cameratismo."
    ],
    "fr": [
      "L'association La Boule du Vercors rassemble les passionnés de pétanque de la région. Elle organise des tournois, rencontres conviviales et événements tout au long de l'année, promouvant l'esprit sportif et la camaraderie."
    ],
    "es": [
      "La asociación Boule du Vercors reúne a los aficionados a la petanca de toda la región. Organiza torneos, encuentros y eventos a lo largo de todo el año, fomentando la deportividad y la camaradería."
    ],
    "nl": [
      "De vereniging Boule du Vercors verenigt jeu de boules-liefhebbers uit de hele regio. Ze organiseert het hele jaar door toernooien, ontmoetingen en evenementen om sportiviteit en kameraadschap te promoten."
    ]
  },
