  "rdfs:comment": {
    "de": [
      "Montélimar Couleur Lavande kehrt am Samstag, den 11. und Sonntag, den 12. Juli 2026 zurück! Der berühmte Markt, der der emblematischen Pflanze der Drôme Provençale (aber nicht nur!) gewidmet ist, wird auch Animationen und Konferenzen für zwei gesellige Tage anbieten!"
    ],
    "en": [
      "Montélimar Couleur Lavande returns on Saturday July 11 and Sunday July 12, 2026! The famous market dedicated to the emblematic plant of the Drôme Provençale (but not only!) will also feature events and conferences for 2 convivial days!"
    ],
    "it": [
      "Montélimar Couleur Lavande torna sabato 11 e domenica 12 luglio 2026! Il famoso mercato dedicato alla pianta emblematica della Drôme Provençale (ma non solo!) sarà caratterizzato anche da eventi e conferenze per 2 giorni all'insegna del divertimento!"
    ],
    "fr": [
      "Montélimar Couleur Lavande revient les samedi 11 et dimanche 12 juillet 2026 ! Le fameux marché dédié à la plante emblématique de la Drôme Provençale (mais pas que !) proposera également des animations et conférences pour 2 journées conviviales !"
    ],
    "es": [
      "Montélimar Couleur Lavande vuelve el sábado 11 y el domingo 12 de julio de 2026 El famoso mercado dedicado a la planta emblemática de la Drôme provenzal (¡pero no sólo!) también contará con eventos y conferencias durante 2 días llenos de diversión"
    ],
    "nl": [
      "Montélimar Couleur Lavande keert terug op zaterdag 11 en zondag 12 juli 2026! De beroemde markt gewijd aan de emblematische plant van de Drôme Provençale (maar niet alleen!) zal ook worden gekenmerkt door evenementen en conferenties voor 2 leuke dagen!"
    ]
  },
