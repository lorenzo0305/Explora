  "rdfs:comment": {
    "de": [
      "Sehr Allier ! Bauernladen in Saint-Pourçain: gut, lokal, direkt von den Erzeugern! Ein Laden, der seinen Erzeugern gehört und Ihnen alles bietet, was Sie brauchen!"
    ],
    "en": [
      "Very Allier! Producers' store in Saint-Pourçain: good, local, direct from the producers! A store that belongs to its producers and offers you everything you need!"
    ],
    "it": [
      "Molto Allier! Negozio di produttori a Saint-Pourçain: buono, locale, direttamente dai produttori! Un negozio che appartiene ai suoi produttori e che vi offre tutto ciò di cui avete bisogno!"
    ],
    "fr": [
      "Très Allier ! Magasin de producteurs à Saint-Pourçain : bon, local, direct producteurs ! Un magasin qui appartient à ses producteurs et qui vous propose tout ce dont vous avez besoin !"
