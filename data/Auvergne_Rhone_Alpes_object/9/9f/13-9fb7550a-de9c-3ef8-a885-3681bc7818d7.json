  "rdfs:comment": {
    "de": [
      "Im Rahmen der nationalen Woche der frühen Kindheit findet eine Konferenz und Debatte unter der Leitung von Clémence Court, einer Praktikerin für archaische Reflexe, statt, bei der es um Emotionen und den Schlaf von Kleinkindern geht."
    ],
    "en": [
      "As part of National Childcare Week, Clémence Court, archaic reflexes practitioner, will lead a conference-debate on emotions and sleep in young children."
    ],
    "it": [
      "Nell'ambito della Settimana Nazionale dell'Infanzia, Clémence Court, operatrice del riflesso arcaico, condurrà una conferenza e un dibattito sulle emozioni e il sonno nei bambini piccoli."
    ],
    "fr": [
      "Dans le cadre de la semaine nationale de la petite enfance, une conférence-débat sera animée par Clémence Court, praticienne e réflexes archaïques, autour des émotions et du sommeil des jeunes enfants."
    ],
    "es": [
      "En el marco de la Semana Nacional de la Puericultura, Clémence Court, practicante de reflejos arcaicos, dirigirá una conferencia y un debate sobre las emociones y el sueño en los niños pequeños."
    ],
    "nl": [
      "Als onderdeel van de Nationale Week van de Kinderbescherming zal Clémence Court, een archaïsche reflextherapeute, een conferentie en debat leiden over emoties en slaap bij jonge kinderen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Conférence Sommeil et émotions - Semaine nationale de la petite enfance"
    ]
  },
