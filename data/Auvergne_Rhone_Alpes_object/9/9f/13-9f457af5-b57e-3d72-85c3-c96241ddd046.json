  "rdfs:comment": {
    "de": [
      "Elisabeth und Hervé, die das Hotel-Restaurant du Parc in der fünften Generation betreiben, empfangen Sie im Herzen des Ortes in einem gemütlichen Rahmen. Der Restaurantservice im Saal und unsere schattige Terrasse werden ein Pluspunkt für Ihren Komfort sein."
    ],
    "en": [
      "Elisabeth and Hervé, the 5th generation of operators of the Hôtel-restaurant du Parc, welcome you to the heart of the village in a warm setting. The indoor restaurant service and our shaded terrace will be a plus for your comfort."
    ],
    "it": [
      "Elisabeth e Hervé, quinta generazione nella gestione dell'Hôtel-restaurant du Parc, vi danno il benvenuto in un ambiente caldo e accogliente nel cuore del villaggio. Il servizio in sala da pranzo e la terrazza ombreggiata saranno un plus per il vostro comfort."
    ],
    "fr": [
      "Elisabeth et Hervé, 5ème génération d'exploitants de l'Hôtel-restaurant du Parc, vous accueillent au coeur du bourg dans un cadre chaleureux. Le service restauration en salle et notre terrasse ombragée seront un plus pour votre confort."
    ],
    "es": [
      "Elisabeth y Hervé, 5ª generación al frente del Hôtel-restaurant du Parc, le dan la bienvenida en un marco cálido y acogedor en el corazón del pueblo. Nuestro servicio de comedor y nuestra terraza a la sombra serán un plus para su comodidad."
    ],
    "nl": [
      "Elisabeth en Hervé, de 5e generatie die het Hôtel-restaurant du Parc runt, heten u welkom in een warme en vriendelijke omgeving in het hart van het dorp. Onze bediening in de eetzaal en het schaduwrijke terras zijn een pluspunt voor uw comfort."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Parc"
    ]
  },
