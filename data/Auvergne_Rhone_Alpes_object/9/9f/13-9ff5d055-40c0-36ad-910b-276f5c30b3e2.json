  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Berge auf andere Weise.\r\nMit Montagne Évasion zu wandern bedeutet, zu staunen, zu entdecken und sich inmitten einer grandiosen und geschützten Bergwelt zu erholen."
    ],
    "en": [
      "Discover the mountain differently. \r\nChoosing to hike with Montagne Evasion means marveling, discovering and recharging your batteries in the heart of an imposing and reserved mountain."
    ],
    "it": [
      "Scoprire la montagna in modo diverso. \r\nScegliere di fare un'escursione con Montagne Évasion significa meravigliarsi, scoprire e ricaricarsi nel cuore di una montagna grandiosa e preservata."
    ],
    "fr": [
      "Découvrez la montagne autrement. \r\nChoisir de randonner avec Montagne Évasion c’est s’émerveiller, découvrir, se ressourcer au cœur d’une montagne grandiose et préservée."
    ],
    "nl": [
      "Ontdek de bergen op een andere manier.\r\nKiezen voor een trektocht met Montagne Évasion betekent je verwonderen, ontdekken en nieuwe energie opdoen in het hart van een grandioze, ongerepte berg."
    ],
    "es": [
      "Descubra la montaña de otra manera.\r\nElegir el senderismo con Montagne Évasion significa maravillarse, descubrir y recargar las pilas en el corazón de una montaña grandiosa y virgen."
    ]
  },
