  "rdfs:comment": {
    "de": [
      "Seine Fassade in der Rue du Courreau besitzt noch eine schöne Fenstergruppe und eine für die Skulpturen der Region typische Modenatur (gedrehte profilierte Bänder) sowie Kragsteine mit Figuren."
    ],
    "en": [
      "Its façade on rue du Courreau still features a fine set of windows and modenature typical of the region's sculptures (twisted molded bands), as well as corbels with figures."
    ],
    "it": [
      "La sua facciata su rue du Courreau presenta ancora una bella serie di finestre e una modenatura tipica delle sculture della regione (fasce tortili modellate), oltre a mensole con figure."
    ],
    "fr": [
      "Sa façade, rue du Courreau, possède encore un bel ensemble de fenêtres et une modenature typique des sculptures de la région (bandeaux moulurés en torsade), ainsi que des corbeaux à personnages."
    ],
    "es": [
      "Su fachada de la calle Courreau conserva un bonito conjunto de ventanas y una modenatura típica de las esculturas de la región (bandas torcidas moldeadas), así como ménsulas con figuras."
    ],
    "nl": [
      "De gevel aan de rue du Courreau heeft nog steeds een mooi stel ramen en modenatuur die typerend is voor de beeldhouwkunst uit de streek (gedraaide gegoten banden), evenals kraagstenen met figuren."
    ]
  },
