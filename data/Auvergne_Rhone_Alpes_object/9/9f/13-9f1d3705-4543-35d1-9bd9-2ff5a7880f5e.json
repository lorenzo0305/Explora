  "rdfs:comment": {
    "de": [
      "Unser Brewpub ist ein echter Ort des Lebens und empfängt Sie im Herzen des Regionalen Naturparks zu geselligen Momenten! Es erwarten Sie Unterhaltungsprogramme, Konzerte, hausgemachte Speisen und vor Ort gebraute Craft-Biere."
    ],
    "en": [
      "A real hub of activity, our brewpub welcomes you to the heart of the Regional Nature Park for a convivial atmosphere! Entertainment, concerts, home-cooked food and craft beers brewed on site await you."
    ],
    "it": [
      "Nel cuore del Parc Naturel Régional, il nostro brewpub è un vero e proprio luogo in cui trascorrere dei bei momenti in compagnia! Vi attendono intrattenimento, musica dal vivo, cucina casalinga e birre artigianali prodotte in loco."
    ],
    "fr": [
      "Véritable lieu de vie, notre brewpub vous accueille au cœur du Parc Naturel Régional pour des moments de convivialité ! Animations, concerts, restauration maison et bières artisanales brassées sur place sont au rendez-vous."
    ],
    "nl": [
      "In het hart van het Parc Naturel Régional is onze brewpub een echte plek waar je samen kunt genieten! Entertainment, livemuziek, huisgemaakte gerechten en ambachtelijke bieren die ter plekke worden gebrouwen zijn allemaal aanwezig."
    ],
    "es": [
      "En el corazón del Parc Naturel Régional, nuestro brewpub es un auténtico lugar donde pasar un buen rato todos juntos Animación, música en directo, comida casera y cervezas artesanales elaboradas in situ."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant Brewpub Dark Lab"
    ]
  },
