  "rdfs:comment": {
    "de": [
      "Geschlossenes Gewässer mit dem Status einer Fischzucht mit touristischer Aufwertung. \r\nHecht, Zander, Blackbass und Schleie in vollständiger No-Kill-Behandlung. \r\nPrivate Verwaltung"
    ],
    "en": [
      "Closed water with fish farm status for tourism purposes. \r\nFull no-kill on pike, zander, black-bass and tench. \r\nPrivate management"
    ],
    "it": [
      "Acqua chiusa con status di allevamento ittico a scopo turistico.\r\nNo-kill totale per luccio, lucioperca, black bass e tinca.\r\nGestione privata"
    ],
    "fr": [
      "Eau close avec un statut de pisciculture à valorisation touristique. \r\nBrochet, sandre, black-bass et tanche en no-kill intégral. \r\nGestion privée"
    ],
    "nl": [
      "Gesloten water met de status van viskwekerij voor toeristische doeleinden.\r\nVolledig no-kill voor snoek, snoekbaars, black bass en zeelt.\r\nParticulier beheer"
    ],
    "es": [
      "Aguas cerradas con estatus de piscifactoría con fines turísticos.\r\nProhibición total de muerte de lucios, luciopercas, black bass y tencas.\r\nGestión privada"
    ]
  },
