  "rdfs:comment": {
    "de": [
      "Genießen Sie die lebendige und herzliche Atmosphäre des Club 72, während Sie gemütlich ein Glas trinken oder sich kulinarisch verwöhnen lassen."
    ],
    "en": [
      "Comfortably seated to share a drink or to enjoy a delicious meal, you will enjoy the lively and warm atmosphere of the Club 72."
    ],
    "it": [
      "Comodamente seduti per sorseggiare un drink o trascorrere un momento piacevole, apprezzerete l’atmosfera vivace e accogliente del Club 72."
    ],
    "fr": [
      "Confortablement installés pour partager un verre ou vous régaler, venez apprécier l’ambiance vivante et chaleureuse du Club 72."
    ],
    "nl": [
      "Kom de levendige en gezellige sfeer opsnuiven van de Club 72. Ga knus zitten en geniet van een drankje of een hapje."
    ],
    "es": [
      "En el Club 72 podrá disfrutar de un ambiente animado y cálido cómodamente instalado para compartir una copa o deleitar su paladar."
    ]
  },
