  "rdfs:comment": {
    "de": [
      "In einem kleinen Raum im australischen Old-School-Look empfängt Sie ein junges, dynamisches Team mit kleinen, einfachen und schmackhaften Gerichten wie Burgern, Fleischgerichten und Tagesmenüs."
    ],
    "en": [
      "In a small room with an old school Australian look, a young and dynamic team welcomes you with simple and tasty dishes such as burgers, meats and daily menus."
    ],
    "it": [
      "In una piccola sala dall'aspetto australiano old school, un team giovane e dinamico vi accoglie con piatti semplici e gustosi come hamburger, carne e menù del giorno."
    ],
    "fr": [
      "Dans une petite salle au look old school australien, une équipe jeune et dynamique vous accueille avec des petits plats simples et goûteux tels que burgers, viandes et menus du jour."
    ],
    "nl": [
      "In een kleine ruimte met een old school Australische uitstraling verwelkomt een jong en dynamisch team u met eenvoudige en smakelijke gerechten zoals hamburgers, vlees en dagmenu's."
    ],
    "es": [
      "En una pequeña sala de aspecto australiano de la vieja escuela, un equipo joven y dinámico le da la bienvenida con platos sencillos y sabrosos como hamburguesas, carnes y menús del día."
    ]
  },
  "rdfs:label": {
    "fr": [
