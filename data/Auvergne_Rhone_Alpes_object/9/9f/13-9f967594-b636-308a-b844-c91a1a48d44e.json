  "rdfs:comment": {
    "de": [
      "Alles strahlt Authentizität und ein gutes Leben aus, wie der Dorfkern mit seinen schönen Häusern, die sich um die Grenette und die Kirche gruppieren."
    ],
    "en": [
      "Everything here exudes authenticity and good living, just like the village centre with its beautiful houses clustered around the Grenette and its church."
    ],
    "it": [
      "Tutto qui trasuda autenticità e buon vivere, proprio come il cuore del villaggio con le sue belle case raggruppate intorno al granaio e alla sua chiesa."
    ],
    "fr": [
      "Tout y respire l'authenticité, le bien-vivre, à l'image de son cœur de village aux belles maisons massées autour de la grenette et son église."
    ],
    "es": [
      "Todo aquí rezuma autenticidad y buen vivir, al igual que el corazón del pueblo, con sus hermosas casas agrupadas en torno al granero y su iglesia."
    ],
    "nl": [
      "Alles straalt hier authenticiteit en goed leven uit, net als het hart van het dorp met zijn mooie huizen rond de graanschuur en de kerk."
    ]
  },
