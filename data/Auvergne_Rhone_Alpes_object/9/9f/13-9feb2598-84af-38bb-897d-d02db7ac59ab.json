  "rdfs:comment": {
    "de": [
      "Einzigartige, handgefertigte Anfertigungen.\r\nStücke, die die Vorstellungswelt der Berge widerspiegeln. Reines Weiß für den Schnee, den Wald und seine wunderbare Welt. Inspiration kombiniert mit der Suche nach klaren, einfachen und nüchternen Formen."
    ],
    "en": [
      "Unique pieces, made by hand, inspired by the mountain environement pure white similar to snow, forests for their mystical atmosphere. Imagined and then created using soft, simple, elegant designs."
    ],
    "it": [
      "Creazioni uniche e fatte a mano.\r\nPezzi che riflettono il mondo immaginario delle montagne. Bianco puro per la neve, la foresta e il suo mondo meraviglioso. Ispirazione unita alla ricerca di forme pure, semplici e sobrie."
    ],
    "fr": [
      "Réalisations uniques, faites main.\r\nPièces reflétant l’imaginaire de la montagne. Le blanc pur pour la neige, la forêt et son univers merveilleux. Inspiration combinée à la recherche des formes épurées, simples et sobres."
    ],
    "nl": [
      "Unieke, handgemaakte creaties.\r\nStukken die de denkbeeldige wereld van de bergen weerspiegelen. Puur wit voor de sneeuw, het bos en zijn wonderlijke wereld. Inspiratie gecombineerd met de zoektocht naar pure, eenvoudige en sobere vormen."
    ],
    "es": [
      "Creaciones únicas hechas a mano.\r\nPiezas que reflejan el mundo imaginario de las montañas. Blanco puro para la nieve, el bosque y su maravilloso mundo. Inspiración combinada con la búsqueda de formas puras, sencillas y sobrias."
    ]
  },
  "rdfs:label": {
    "en": [
      "Ceramic workshop AM"
    ],
    "fr": [
      "Atelier Céramique AM"
    ],
    "nl": [
      "Atelier Céramique AM"
    ]
  },
