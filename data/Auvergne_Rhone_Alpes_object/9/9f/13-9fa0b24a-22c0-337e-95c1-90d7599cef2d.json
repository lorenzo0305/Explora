  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Beaujolais Vert durch ein spielerisches und kostenloses Geocaching-Erlebnis: eine Schatzsuche für die ganze Familie!\r\nIn Claveisolles begeben Sie sich auf die Jagd nach Bêtâ, der über die kleinen und großen Tiere unserer Landschaft Bescheid weiß."
    ],
    "en": [
      "Discover the Beaujolais Vert region through a free geocaching experience: a treasure hunt for the whole family!\r\nIn Claveisolles, go on a hunt for Bêtâ, who knows all about the big and small beasts of the countryside."
    ],
    "it": [
      "Scoprite la regione del Beaujolais Vert attraverso un'esperienza di geocaching divertente e gratuita: una caccia al tesoro per tutta la famiglia!\r\nA Claveisolles, andate a caccia di Bêtâ, che sa tutto sugli animali grandi e piccoli della campagna."
    ],
    "fr": [
      "Découvrez le Beaujolais Vert à travers une expérience ludique et gratuite de géocaching : une chasse aux trésors à vivre en famille !\r\nÀ Claveisolles, partez à la chasse de Bêtâ, incollable sur les petites et grosses bêtes de nos campagnes."
    ],
    "nl": [
      "Ontdek de Beaujolais Vert via een leuke, gratis geocaching-ervaring: een schattenjacht voor het hele gezin!\r\nGa in Claveisolles op jacht naar Bêtâ, die alles weet over de grote en kleine dieren van het platteland."
    ],
    "es": [
      "Descubra la región del Beaujolais Vert a través de una divertida experiencia gratuita de geocaching: ¡una búsqueda del tesoro para toda la familia!\r\nEn Claveisolles, vaya a la caza de Bêtâ, que lo sabe todo sobre los grandes y pequeños animales del campo."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Gnolus - SOS : ruchers en détresse !"
    ]
  },
