  "rdfs:comment": {
    "de": [
      "Das Luso Festival ist das erste portugiesische Festival in Rhône-Alpes. Bekannte portugiesische Sänger, traditionelle Gastronomie und typische Tänze: Portugal steht im Mittelpunkt einer einzigartigen Fest- und Kulturveranstaltung"
    ],
    "en": [
      "The Luso Festival is the premier Portuguese festival in the Rhône-Alpes region. Renowned Portuguese singers, traditional gastronomy and typical dances: Portugal takes center stage for a unique festive and cultural event"
    ],
    "it": [
      "Il Festival di Luso è il principale festival portoghese della regione Rodano-Alpi. Cantanti portoghesi di fama, gastronomia tradizionale e danze tipiche: il Portogallo è sotto i riflettori per un evento festivo e culturale unico"
    ],
    "fr": [
      "Le Luso Festival est le premier festival portugais de Rhône-Alpes. Chanteurs portugais de renom, gastronomie traditionnelle et danses typiques : le Portugal est à l’honneur pour un événement festif et culturel unique"
    ],
    "nl": [
      "Het Luso Festival is het belangrijkste Portugese festival in de regio Rhône-Alpes. Gerenommeerde Portugese zangers, traditionele gastronomie en typische dansen: Portugal staat in de schijnwerpers voor een uniek feestelijk en cultureel evenement"
    ],
    "es": [
      "El Festival Luso es el principal festival portugués de la región de Ródano-Alpes. Cantantes portugueses de renombre, gastronomía tradicional y bailes típicos: Portugal es el centro de atención de un acontecimiento festivo y cultural único"
    ]
  },
  "rdfs:label": {
