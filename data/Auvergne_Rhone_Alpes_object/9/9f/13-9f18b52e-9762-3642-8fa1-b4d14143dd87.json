  "rdfs:comment": {
    "de": [
      "Die Kathedrale Saint-Jean-Baptiste wurde im 6. Jahrhundert erbaut, im 11. Jahrhundert umgebaut und im 15. Jahrhundert erweitert. Sie besitzt in ihrem Chor ein wunderschönes gotisches Chorgestühl aus Walnussholz, das alle unterschiedlich sind, sowie einen Kreuzgang und eine Krypta."
    ],
    "en": [
      "Built in the 6th century, rebuilt in the 11th and enlarged in the 15th, the Cathédrale Saint-Jean-Baptiste features magnificent Gothic walnut choir stalls, all different from one another, as well as a cloister and crypt."
    ],
    "it": [
      "Costruita nel VI secolo, ricostruita nell'XI secolo e ampliata nel XV secolo, la Cattedrale di San Giovanni Battista presenta magnifici stalli del coro gotico in noce, tutti diversi tra loro, oltre a un chiostro e a una cripta."
    ],
    "fr": [
      "Édifiée au VIème siècle, reconstruite au XIème et agrandie au XVème siècle, la Cathédrale Saint-Jean-Baptiste a en son chœur de magnifiques stalles gothiques en noyer, toutes différentes, ainsi qu'un cloître et une crypte."
    ],
    "nl": [
      "Gebouwd in de 6e eeuw, herbouwd in de 11e eeuw en vergroot in de 15e eeuw, heeft de kathedraal van Sint Jan de Doper prachtige gotische notenhouten koorbanken, allemaal verschillend van elkaar, evenals een kloostergang en een crypte."
    ],
    "es": [
      "Construida en el siglo VI, reconstruida en el siglo XI y ampliada en el siglo XV, la catedral de San Juan Bautista posee una magnífica sillería gótica de nogal, todas diferentes entre sí, así como un claustro y una cripta."
    ]
  },
