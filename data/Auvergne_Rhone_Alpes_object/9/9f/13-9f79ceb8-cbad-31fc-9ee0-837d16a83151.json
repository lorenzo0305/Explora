  "rdfs:comment": {
    "de": [
      "Der im Herzen der Chartreuse gelegene Cozon ist nicht nur ein Nebenfluss des Guiers, sondern vor allem ein hübscher Fluss, der reich an Forellen ist."
    ],
    "en": [
      "Located in the heart of the Chartreuse, the Cozon is not only a tributary of the Guiers, but above all a pretty river rich in trout."
    ],
    "it": [
      "Situato nel cuore della Chartreuse, il Cozon non è solo un affluente del Guiers, ma soprattutto un bel fiume ricco di trote."
    ],
    "fr": [
      "Situé au coeur de la Chartreuse, le Cozon est non seulement un affluent du Guiers, mais surtout une jolie rivière riche en truites."
    ],
    "es": [
      "Situado en el corazón de la Chartreuse, el Cozón no es sólo un afluente del Guiers, sino sobre todo un bonito río rico en truchas."
    ],
    "nl": [
      "De Cozon, gelegen in het hart van de Chartreuse, is niet alleen een zijrivier van de Guiers, maar vooral een mooie rivier die rijk is aan forel."
    ]
  },
