  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Departement Rhône durch ein spielerisches und kostenloses Geocaching-Erlebnis. In Yzeron begeben Sie sich auf die Jagd nach Sooshi, einer Wasserexpertin. Sie und die anderen Gnolus werden Ihnen das Dorf und seine Umgebung zeigen."
    ],
    "en": [
      "Discover the Rhône department through a fun and free geocaching experience. In Yzeron, go hunting for Sooshi, a water specialist. She and the other Gnolus will make you discover the village and its surroundings."
    ],
    "it": [
      "Scoprite il dipartimento del Rodano attraverso un'esperienza di geocaching divertente e gratuita. A Yzeron, andate a caccia di Sooshi, uno specialista dell'acqua. Lei e gli altri Gnolus vi aiuteranno a scoprire il villaggio e i suoi dintorni."
    ],
    "fr": [
      "Découvrez le département du Rhône à travers une expérience ludique et gratuite de géocaching. A Yzeron, partez à la chasse de Sooshi, spécialiste de l'eau. Elle et les autres Gnolus vous feront découvrir le village et ses environs."
    ],
    "nl": [
      "Ontdek het departement Rhône via een leuke en gratis geocaching-ervaring. Ga in Yzeron op jacht naar Sooshi, een waterspecialist. Zij en de andere Gnolus zullen je helpen het dorp en de omgeving te ontdekken."
    ],
    "es": [
      "Descubra el departamento del Ródano a través de una experiencia de geocaching divertida y gratuita. En Yzeron, ve a la caza de Sooshi, un especialista en agua. Ella y los otros Gnolus te ayudarán a descubrir el pueblo y sus alrededores."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Gnolus : L’arroseur à Ronzey"
    ]
  },
