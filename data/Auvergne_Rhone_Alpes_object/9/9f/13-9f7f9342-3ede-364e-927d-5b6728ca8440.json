  "rdfs:comment": {
    "de": [
      "In La Caboche auf dem Rochebrune-Massiv gelegen, bietet Ihnen diese Berghütte typische Gerichte aus dem Alpenraum. Ein idealer Ort für Familien, der auch für Fußgänger zugänglich ist!"
    ],
    "en": [
      "Nestling in La Caboche in the Rochebrune massif, this mountain restaurant serves typical dishes from the Alps. Accessible even on foot, it is ideal for families!"
    ],
    "it": [
      "Situato a La Caboche, sul massiccio di Rochebrune, questo rifugio di montagna serve piatti tipici alpini. Un luogo ideale per le famiglie, accessibile anche a chi è a piedi!"
    ],
    "fr": [
      "Niché à la Caboche sur le massif de Rochebrune, ce repaire de montagne vous propose des plats typiques de l’arc alpin. Un lieu idéal pour les familles, accessible même aux piétons !"
    ],
    "es": [
      "Enclavado en La Caboche, en el macizo de Rochebrune, este restaurante de montaña sirve platos típicos alpinos. Un lugar ideal para familias, ¡incluso para peatones!"
    ],
    "nl": [
      "Dit bergrestaurant ligt in La Caboche op het massief van Rochebrune en serveert typische Alpengerechten. Een ideale plek voor gezinnen, zelfs voor voetgangers!"
    ]
  },
