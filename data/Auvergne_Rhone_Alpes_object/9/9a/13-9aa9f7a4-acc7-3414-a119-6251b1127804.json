  "rdfs:comment": {
    "de": [
      "Am südlichen Ausgang der Stadt Aubenas, auf der Straße nach Montélimar. Angenehme Lounge-Bar und Frühstücksraum mit schönem Dachgebälk, 2019 renoviert. Restaurant Albert's Place. Terrasse, Pool und sehr angenehme Räumlichkeiten."
    ],
    "en": [
      "South exit of Aubenas on the road to Montélimar. Lovely bar lounge and breakfast room with a beautiful framework. Restaurant serving coffee, pizza, pasta, local food. Wonderful terrace, swimming pool and spaces."
    ],
    "it": [
      "All'uscita sud della città di Aubenas, sulla strada per Montélimar. Piacevole lounge bar e sala colazioni con una bella struttura sul tetto rinnovata nel 2019. Ristorante Albert's Place. Terrazza, piscina e spazi molto piacevoli."
    ],
    "fr": [
      "A la sortie Sud de la ville d’Aubenas, sur la route de Montélimar. Agréable bar lounge et salle petit déjeuner coiffée d’une belle charpente rénové en 2019. Restaurant Albert's Place. Terrasse, piscine et espaces très agréables."
    ],
    "nl": [
      "Net ten zuiden van Aubenas, op de weg naar Montélimar. Aangename loungebar en ontbijtzaal met daarbovenop een mooie dakstructuur die in 2019 werd gerenoveerd. Restaurant Albert's Place. Terras, zwembad en zeer aangename ruimtes."
    ],
    "es": [
      "En la salida sur de la ciudad de Aubenas, en la carretera de Montélimar. Agradable salón bar y sala de desayunos con una hermosa estructura de techo renovada en 2019. Restaurante Albert's Place. Terraza, piscina y espacios muy agradables."
    ]
  },
