  "rdfs:comment": {
    "de": [
      "Kanu-Kajakverleih, Stand Up Paddel und Bootsfahrten. Begleitete Themenausflüge für Nachtausflüge \"Entdeckung des Bodens, der Flora und Fauna\" im Kanu und Boot."
    ],
    "en": [
      "Canoe, kayak and stand-up paddleboard rentals plus boat trips. Ardèche river trips from short/beginner to long/experienced trips. Paddleboarding. Guided themed evening trips to discover the region and its flora and fauna by canoe or boat."
    ],
    "it": [
      "E se veniste a scoprire l'Ardèche in canoa, da soli o con una guida?\r\nE se si programmasse un'attività tranquilla in mezzo alla natura: andare in canoa e pagaiare sull'acqua?\r\nE se andaste alla scoperta dei castori in barca?"
    ],
    "fr": [
      "Et si vous veniez découvrir l'Ardèche en canoë parcours libre ou accompagné ?\r\nEt si vous programmiez une activité tranquille sur l'eau en pleine nature : le canoë et le paddle sur plan d'eau?\r\nEt si vous embarquiez pour la découverte des castors en barque?"
    ],
    "es": [
      "¿Y si viene a descubrir la Ardèche en canoa, por su cuenta o con un guía?\r\n¿Y si planificas una actividad tranquila en el agua en plena naturaleza: hacer piragüismo y remar en el agua?\r\n¿Y si se va a descubrir el castor en un barco?"
    ],
    "nl": [
      "Verhuur van Kano en Kayak."
    ]
  },
