  "rdfs:comment": {
    "de": [
      "Spart Xtrem ist ein permanenter, fußläufiger Hindernisparcours, der in der Region Roannais neu ist. 100% integrativ und 100% umweltfreundlich. Neu: Escape Games, Koh Lanta w-9228 und unsere maßgeschneiderten Aufenthalte in der Natur, die von den Bildschirmen losgelöst sind und ein Biwak von 24 bis 130 Stunden beinhalten."
    ],
    "en": [
      "Spart Xtrem is a new permanent pedestrian obstacle course in the Roannais region. 100% inclusive and 100% eco-responsible. New: escape game, Koh lanta w-9228 and our tailor-made nature holidays, disconnected from the screens with bivouac from 24h to 130h."
    ],
    "it": [
      "Spart Xtrem è un percorso pedonale permanente a ostacoli mai realizzato prima nella regione del Roannais. 100% inclusivo e 100% eco-responsabile. Novità: gioco di evasione, Koh lanta w-9228 e le nostre pause natura su misura, scollegate dagli schermi con bivacco dalle 24 alle 130 ore."
    ],
    "fr": [
      "Spart Xtrem est un parcours d’obstacles pédestre permanent inédit en Roannais. 100% inclusif et 100% éco-responsable. Nouveautés : escape game,  Koh lanta w-9228 et nos séjours pleine nature sur mesure, déconnectés des écrans avec bivouac de 24h à 130h."
    ],
    "nl": [
      "Spart Xtrem is een permanente hindernisbaan voor voetgangers die nog nooit eerder is gedaan in de regio Roannais. 100% inclusief en 100% eco-verantwoord. Nieuw: escape game, Koh lanta w-9228 en onze op maat gemaakte natuur pauzes, losgekoppeld van de schermen met bivak van 24u tot 130u."
    ],
    "es": [
      "Spart Xtrem es una carrera permanente de obstáculos para peatones que nunca antes se había hecho en la región de Roannais. 100% inclusivo y 100% eco-responsable. Novedad: juego de escape, Koh lanta w-9228 y nuestras escapadas a la naturaleza a medida, desconectados de las pantallas con vivac de 24h a 130h."
    ]
  },
