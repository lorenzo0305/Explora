  "rdfs:comment": {
    "de": [
      "L'ENVOL\r\nAn der Grenze zwischen Realismus und Absurdität ist L'Envol\r\nstellt satirisch eine überbordende Gesellschaft fest\r\nvon Geschlechterzuweisungen, in der sowohl Frauen als auch Männer\r\nmänner nicht verschont bleiben.\r\nAb 10 Jahren\r\nDauer 1h45"
    ],
    "en": [
      "L?ENVOL\r\nStraddling the line between realism and the absurd, L'Envol\r\nsatirizes a society overflowing with gender\r\noverflowing with gender injunctions, where women and\r\nmen are not spared.\r\nAges 10 and up\r\nRunning time 1h45"
    ],
    "it": [
      "L'ENVOL\r\nA cavallo tra il realismo e l'assurdo, L'Envol\r\nè un resoconto satirico di una società traboccante di\r\ndi ingiunzioni di genere, in cui donne e uomini non sono risparmiati\r\nuomini non vengono risparmiati.\r\nDai 10 anni in su\r\nDurata: 1 ora e 45 minuti"
    ],
    "fr": [
      "L’ENVOL\r\nA la frontière entre réalisme et absurde, l’Envol\r\ndresse le constat satirique d’une société débordante\r\nd’injonctions de genre, où les femmes comme les\r\nhommes ne sont pas épargné-es.\r\nA partir de 10 ans \r\nDurée 1h45"
    ],
    "nl": [
      "L'ENVOL\r\nL'Envol houdt het midden tussen realisme en absurdisme\r\nis een satirisch verslag van een samenleving die overloopt\r\novervol met genderverordeningen, waarin vrouwen en\r\nmannen niet gespaard worden.\r\nLeeftijd vanaf 10 jaar\r\nSpeelduur: 1 uur en 45 minuten"
    ],
    "es": [
      "L'ENVOL\r\nA caballo entre el realismo y el absurdo, L'Envol\r\nes un relato satírico de una sociedad rebosante\r\ndesbordante de mandatos de género, en la que mujeres y\r\nhombres no se salvan.\r\nA partir de 10 años\r\nDuración: 1 hora 45 minutos"
    ]
  },
