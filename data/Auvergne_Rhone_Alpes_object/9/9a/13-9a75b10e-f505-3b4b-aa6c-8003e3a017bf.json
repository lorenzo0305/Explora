  "rdfs:comment": {
    "de": [
      "La Ferme des Routes ist ein Gemeinschaftsbauernhof in biologischer Landwirtschaft, der sich für bäuerliche und ökologische Werte einsetzt.\r\n Produktion: Getreide wird gelagert und vor Ort zu Mehl und dann zu Brot verarbeitet."
    ],
    "en": [
      "La Ferme des Routes is a collective farm in Organic Agriculture which defends peasant and environmental values. Production: cereals stored and transformed on site into flours then into sourdough bread cooked in a wood fire."
    ],
    "it": [
      "La Ferme des Routes è un'azienda agricola collettiva biologica che promuove i valori rurali e ambientali.\r\n Produzione: cereali immagazzinati e trasformati in loco in farina e pane"
    ],
    "fr": [
      "La Ferme des Routes est une ferme collective en Agriculture Biologique qui défend les valeurs paysannes et environnementales.\r\n Production : céréales stockées et transformées sur place en farines puis en pain"
    ],
    "nl": [
      "La Ferme des Routes is een biologische collectieve boerderij die de landelijke waarden verdedigt.\r\n\r\nDe boerderij ligt in de gemeente Bésayes, aan de voet van het Vercors-gebergte, en bestaat uit twee werkplaatsen: schapenfokkerij-zuivelfabriek en graanbakkerij."
    ],
    "es": [
      "La Ferme des Routes es una granja ecológica colectiva que promueve los valores rurales y medioambientales.\r\n Producción: cereales almacenados y transformados in situ en harina y pan"
    ]
  },
