  "rdfs:comment": {
    "de": [
      "Hausmeisterservice, um Ihr Haus während Ihrer Abwesenheit zu vermieten, zu pflegen und zu beaufsichtigen.\r\nVorbereitung Ihres Aufenthalts (Öffnen, Schließen und Reinigen der Unterkunft), damit Sie Ihren Urlaub in vollen Zügen genießen können."
    ],
    "en": [
      "Concierge service to rent, maintain and monitor your home in your absence.\r\nPreparing your stay (opening, closing and cleaning) to make the most of your vacation."
    ],
    "it": [
      "Servizio di portineria per l'affitto, la manutenzione e la cura della vostra casa durante la vostra assenza.\r\nPreparazione del soggiorno (apertura, chiusura e pulizia della casa) per farvi godere al massimo della vostra vacanza."
    ],
    "fr": [
      "Service de conciergerie pour louer, entretenir et surveiller votre maison en votre absence.\r\nPréparation de vos séjours (ouverture, fermeture et nettoyage du logement) pour profiter pleinement de vos vacances."
    ],
    "es": [
      "Servicio de conserjería para alquilar, mantener y cuidar su casa durante su ausencia.\r\nPreparación de su estancia (apertura, cierre y limpieza de su vivienda) para que pueda disfrutar al máximo de sus vacaciones."
    ],
    "nl": [
      "Conciërgeservice voor het huren, onderhouden en verzorgen van je huis terwijl je weg bent.\r\nVoorbereiding van je verblijf (openen, sluiten en schoonmaken van je huis) zodat je optimaal van je vakantie kunt genieten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Conciergerie Eouard Kuhn"
    ]
  },
