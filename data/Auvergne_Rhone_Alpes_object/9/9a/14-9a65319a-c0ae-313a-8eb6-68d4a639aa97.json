  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/70901bdb-3a3c-37c2-b493-33610acb2c45",
      "dc:description": {
        "de": [
          " Informationen :\n\n\nÖffnungstage :\n\nMontag bis Samstag von 7:00 bis 12:30 Uhr und von 15:30 bis 19:00 Uhr\nSonntag und Feiertage von 7:00 bis 13:00 Uhr\n\nMittwochs geschlossen\n \n Abholung :\n\nZum Mitnehmen während der Ladenöffnungszeiten\n\n\nBestellungen:\n\nPer Telefon unter 03 21 23 36 74\n\n "
        ],
        "en": [
          " Information :\n\n\nOpening days :\n\nMonday to Saturday, 7am to 12:30pm and 3:30pm to 7pm\nSundays and public holidays from 7am to 1pm\n\nClosed on Wednesday\n \n Collection:\n\nTakeaway during store opening hours\n\n\nOrdering :\n\nBy telephone on 03 21 23 36 74\n\n "
        ],
        "it": [
          " Ulteriori informazioni :\n\n\nGiorni di apertura :\n\nDal lunedì al sabato, dalle 7.00 alle 12.30 e dalle 15.30 alle 19.00\nDomenica e festivi dalle 7.00 alle 13.00\n\nChiuso il mercoledì\n \n Ritiro:\n\nDa asporto durante gli orari di apertura del negozio\n\n\nOrdini :\n\nPer telefono al numero 03 21 23 36 74\n\n "
        ],
        "fr": [
          " Informations :\n\n\nJours d'ouverture :\n\nDu lundi au samedi de 7h à 12h30 et de 15h30 à 19h\nDimanche et jours fériés de 7h à 13h\n\nFermeture le mercredi\n \n Retrait :\n\nÀ emporter au horaires d'ouverture du magasin\n\n\nCommandes :\n\nPar téléphone au 03 21 23 36 74\n\n "
        ],
        "nl": [
          " Meer informatie :\n\n\nOpeningsdagen :\n\nMaandag tot zaterdag van 7u tot 12u30 en van 15u30 tot 19u\nZon- en feestdagen van 7 tot 13 uur\n\nGesloten op woensdag\n \n Ophalen:\n\nAfhalen tijdens openingstijden winkel\n\n\nBestellen :\n\nTelefonisch op 03 21 23 36 74\n\n "
        ],
        "es": [
          " Más información :\n\n\nDías de apertura :\n\nDe lunes a sábado, de 7h00 a 12h30 y de 15h30 a 19h00\nDomingos y días festivos, de 7.00 a 13.00 h\n\nMiércoles cerrado\n \n Recogida:\n\nPara llevar durante el horario de apertura de la tienda\n\n\nPedidos :\n\nPor teléfono al 03 21 23 36 74\n\n "
        ]
      },
