  "rdfs:comment": {
    "de": [
      "ZEN NIWA (Meditationsgarten) Architektonische Kopie von Ryoan-ji.\r\nBotanische Umgebung 100 fernöstliche und einheimische Pflanzen auf 2000 Quadratmetern.\r\n\r\nUnterlagen am Eingang stehen Ihnen zur Verfügung."
    ],
    "en": [
      "ZEN NIWA (Meditation Garden) Architectural copy of Ryoan-ji.\r\nBotanical entourage of 100 Far Eastern and local plants over 2,000 square meters.\r\n\r\nDocumentation available at entrance."
    ],
    "it": [
      "ZEN NIWA (giardino di meditazione) Copia architettonica del Ryoan-ji.\r\nUn parco botanico di 100 piante dell'Estremo Oriente e locali su una superficie di 2000 metri quadrati\r\n\r\nDocumento disponibile all'ingresso."
    ],
    "fr": [
      "ZEN NIWA (Jardin de méditation) Copie architecturale de Ryoan-ji.\r\nEntourage botanique 100 plantes d'extrême-orient et plantes locales sur 2000 mètres carrés. \r\n\r\nDocument à l'entrée à votre disposition."
    ],
    "nl": [
      "ZEN NIWA (meditatietuin) Architectonische kopie van Ryoan-ji.\r\nBotanische tuin met 100 oosterse en lokale planten op 2000 vierkante meter.\r\n\r\nDocumenten verkrijgbaar bij de ingang."
    ],
    "es": [
      "ZEN NIWA (Jardín de Meditación) Copia arquitectónica de Ryoan-ji.\r\nEntorno botánico de 100 plantas de Extremo Oriente y locales en 2000 metros cuadrados\r\n\r\nDocumento disponible en la entrada."
    ]
  },
