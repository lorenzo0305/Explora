  "rdfs:comment": {
    "de": [
      "Das Reitzentrum Le Kavalkada am Col du Mollard bietet Ihnen im Sommer Ausritte auf Ponys, Ponys an der Hand oder auf Pferden, von 1 bis 5 Stunden. Entdecken Sie die Wege von Albiez mit Ihrem Kind im Sattel, es sei denn, Sie möchten lieber alle auf dem Pferd sein..."
    ],
    "en": [
      "The Kavalkada equestrian center at Col du Mollard offers pony trekking in summer, pony in hand or on horseback, from 1 to 5 hours. Discover the trails of Albiez with your child in the saddle, unless you'd rather all be on horseback..."
    ],
    "it": [
      "Il centro di equitazione Kavalkada al Col du Mollard propone in estate trekking su pony, con pony in mano o a cavallo, da 1 a 5 ore. Scoprite i sentieri di Albiez con il vostro bambino in sella, a meno che non preferiate essere tutti a cavallo..."
    ],
    "fr": [
      "Le centre équestre le Kavalkada situé au Col du Mollard vous propose en été des balades à poney, poney en main ou à cheval, de 1h à 5h. Partez découvrir les sentiers d'Albiez avec votre enfant sur selle, à moins que vous ne préfériez être tous à cheval..."
    ],
    "es": [
      "El centro ecuestre de Kavalkada, en el Col du Mollard, ofrece en verano paseos en poni, poni en mano o a caballo, de 1 a 5 horas. Descubra los senderos de Albiez con su hijo en la silla, a menos que prefiera ir todo a caballo..."
    ],
    "nl": [
      "De manege Kavalkada op de Col du Mollard biedt in de zomer ponytochten aan, pony aan de hand of te paard, van 1 tot 5 uur. Ontdek de paden van Albiez met je kind in het zadel, tenzij je liever helemaal te paard bent..."
    ]
  },
  "rdfs:label": {
    "en": [
      "Kavalkada Equestrian Centre - Activities"
    ],
    "fr": [
      "Centre équestre Kavalkada - Activités"
    ]
  },
