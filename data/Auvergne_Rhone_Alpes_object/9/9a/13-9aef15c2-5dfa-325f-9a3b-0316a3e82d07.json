  "rdfs:comment": {
    "de": [
      "Sébastien Bournac, der neue Künstler und Direktor des CDN, wählt einen Text des australischen Dramatikers Daniel Keene, den er gut kennt, und lädt ihn zu einer Lesung mit weißer Karte ein."
    ],
    "en": [
      "Invited for a carte blanche reading, Sébastien Bournac - the CDN?s new artist-director - chooses a text he knows well by Australian playwright Daniel Keene."
    ],
    "it": [
      "Invitato a dare una lettura \"carta bianca\", Sébastien Bournac - il nuovo artista-regista del CDN - sceglie un testo che conosce bene del drammaturgo australiano Daniel Keene."
    ],
    "fr": [
      "Invité pour une lecture-carte blanche, Sébastien Bournac – nouvel artiste-directeur du CDN – choisit un texte qu’il connaît bien du dramaturge australien Daniel Keene."
    ],
    "es": [
      "Sébastien Bournac, nuevo director artístico del CDN, elige un texto del dramaturgo australiano Daniel Keene que conoce bien."
    ],
    "nl": [
      "Sébastien Bournac, de nieuwe artist-director van het CDN, is uitgenodigd om een lezing te geven die hij goed kent. Hij kiest een tekst van de Australische toneelschrijver Daniel Keene."
    ]
  },
