  "rdfs:comment": {
    "de": [
      "Auf dem Klettersteig der Felsen von Miramande können Sie an Höhe gewinnen, um die Schluchten des Allier auf andere Weise zu entdecken. In der Bar des Dorfes kann man die spezielle Ausrüstung ausleihen."
    ],
    "en": [
      "The via ferrata on the Miramande rocks is a great way to gain altitude and discover the Allier gorges from a different angle. The village bar offers special equipment for hire."
    ],
    "it": [
      "La via ferrata sulle rocce di Miramande è un ottimo modo per scoprire le gole dell'Allier da una prospettiva diversa. È possibile noleggiare l'attrezzatura speciale presso il bar del villaggio."
    ],
    "fr": [
      "La via ferrata des rochers de la Miramande permet de prendre de l’altitude pour découvrir autrement les gorges de l’Allier. Le bar du village propose la location du matériel spécifique."
    ],
    "es": [
      "La vía ferrata de las rocas de Miramande es una buena manera de conocer las gargantas del Allier desde otro ángulo. Puede alquilar material especial en el bar del pueblo."
    ],
    "nl": [
      "De via ferrata op de rotsen van Miramande is een geweldige manier om de kloven van de Allier vanuit een andere hoek te leren kennen. In de bar van het dorp kun je een speciale uitrusting huren."
    ]
  },
  "rdfs:label": {
