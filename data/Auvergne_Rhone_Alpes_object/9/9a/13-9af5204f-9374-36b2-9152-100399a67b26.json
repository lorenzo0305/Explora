  "rdfs:comment": {
    "de": [
      "Les Livres Nomades haben sich zum Ziel gesetzt, zu reisen. Jeder hat Zugang zu den Büchern, vor Ort oder zum Mitnehmen. Lesen Sie sie und schicken Sie sie auf Reisen!"
    ],
    "en": [
      "The purpose of nomadic books is to travel. Everyone has access to the books, on site or to take away. Read them and make them travel!"
    ],
    "it": [
      "Lo scopo dei libri nomadi è quello di viaggiare. Tutti hanno accesso ai libri, sul posto o da portare via. Leggeteli e fateli viaggiare!"
    ],
    "fr": [
      "Les Livres Nomades ont pour vocation de voyager. Tout le monde a accès aux livres, sur place ou à emporter. Lisez-les et faites les voyager !"
    ],
    "nl": [
      "Nomadische boeken zijn bedoeld om te reizen. Iedereen heeft toegang tot de boeken, ter plaatse of om mee te nemen. Lees ze en laat ze reizen!"
    ],
    "es": [
      "Los libros nómadas están pensados para viajar. Todo el mundo tiene acceso a los libros, in situ o para llevar. ¡Léalos y hágalos viajar!"
    ]
  },
