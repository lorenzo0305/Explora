      "schema:openingHoursSpecification": [
        {
          "@id": "https://data.datatourisme.fr/18aaada0-baa4-38df-b946-44c9f0559956",
          "schema:validFrom": "2026-11-26T00:00:00",
          "schema:validThrough": "2026-12-31T23:59:59",
          "@type": [
            "schema:OpeningHoursSpecification"
          ],
          "additionalInformation": {
            "de": [
              "Montag, Dienstag, Mittwoch, Donnerstag, Freitag, Samstag, Sonntag: offen\r\n\r\nDas Restaurant ist am Sonntagabend, Montag und Dienstag geschlossen.\r\n\r\nReservierungen für das Hotel sind für jeden Abend möglich, müssen aber zwischen Mittwochmorgen und Sonntagmorgen vorgenommen werden."
            ],
            "en": [
              "Monday, Tuesday, Wednesday, Thursday, Friday, Saturday, Sunday: open\r\n\r\nThe restaurant is closed on Sunday evening, Monday and Tuesday.\r\n\r\nReservations for the hotel are possible for all evenings, but must be made between Wednesday morning and Sunday morning."
            ],
            "it": [
              "Lunedì, martedì, mercoledì, giovedì, venerdì, sabato, domenica: aperto\r\n\r\nIl ristorante è chiuso la domenica sera, il lunedì e il martedì.\r\n\r\nLe prenotazioni per l'hotel sono possibili per tutte le sere, ma devono essere effettuate tra il mercoledì mattina e la domenica mattina."
            ],
            "fr": [
              "Lundi, Mardi, Mercredi, Jeudi, Vendredi, Samedi, Dimanche : ouvert\r\n\r\nLe restaurant est fermé dimanche soir, lundi et mardi. \r\n\r\nLes réservations pour l'hôtel sont possible pour tous les soirs mais doivent être effectuées entre le mercredi matin et le dimanche matin."
            ],
            "nl": [
              "Maandag, dinsdag, woensdag, donderdag, vrijdag, zaterdag, zondag: open\r\n\r\nHet restaurant is gesloten op zondagavond, maandag en dinsdag.\r\n\r\nReserveringen voor het hotel zijn mogelijk voor alle avonden, maar moeten worden gemaakt tussen woensdagochtend en zondagochtend."
            ],
            "es": [
              "Lunes, martes, miércoles, jueves, viernes, sábado y domingo: abierto\r\n\r\nEl restaurante cierra los domingos por la noche, los lunes y los martes.\r\n\r\nEs posible reservar en el hotel para todas las noches, pero debe hacerse entre el miércoles por la mañana y el domingo por la mañana."
            ]
          },
