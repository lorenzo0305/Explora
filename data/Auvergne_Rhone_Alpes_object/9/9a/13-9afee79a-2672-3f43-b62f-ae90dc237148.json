  "rdfs:comment": {
    "de": [
      "Starten Sie vom Plan d'eau du Mas aus zu einer 123 km langen Van-Tour, um das Cézallier zu entdecken!\r\nAuf dieser Strecke können Sie einige Nuggets des Pays d'Issoire entdecken."
    ],
    "en": [
      "From the Plan d'eau du Mas, embark on a 123km van tour to discover the Cézallier!\r\nThis tour will allow you to discover some of the best spots of the Issoire area."
    ],
    "it": [
      "Partendo dal Plan d'eau du Mas, partite per un tour in furgone di 123 km alla scoperta del Cézallier!\r\nQuesto itinerario vi permetterà di scoprire alcune delle gemme del Pays d'Issoire."
    ],
    "fr": [
      "Au départ du Plan d'eau du Mas, embarquez pour un circuit van de 123km à la découverte du Cézallier ! \r\nCe parcours vous permettra de découvrir certaines pépites du Pays d'Issoire."
    ],
    "nl": [
      "Vanuit het Plan d'eau du Mas vertrekt u voor een tocht van 123 km met een busje om de Cézallier te ontdekken!\r\nDeze route zal u toelaten om enkele pareltjes van het Pays d'Issoire te ontdekken."
    ],
    "es": [
      "Partiendo del Plan d'eau du Mas, embárquese en un recorrido de 123 km en furgoneta para descubrir el Cézallier\r\nEsta ruta le permitirá descubrir algunas de las pepitas del Pays d'Issoire."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Circuit van - A la découverte du Cézallier"
    ]
  },
