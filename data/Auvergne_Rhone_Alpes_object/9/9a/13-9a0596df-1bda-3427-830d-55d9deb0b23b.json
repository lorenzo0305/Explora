  "rdfs:comment": {
    "de": [
      "Wir bieten Ihnen in Reignier eine Reihe von Produkten direkt ab Hof: Fleisch, Gemüse, Obst, Käse, Joghurt sowie weitere Qualitätsprodukte von heimischen Erzeugern."
    ],
    "en": [
      "Direct from our farm in Reignier, we offer a selection of meats, vegetables, fruit, cheeses, yogurts, and other quality products from local producers."
    ],
    "it": [
      "Frutta e verdura, formaggi e latticini freschi, carne e salumi... un'ampia varietà di prodotti coltivati, allevati e prodotti da La Ferme des 4 Saisons. Venduti direttamente e localmente nei mercati o nel nostro negozio in fattoria!"
    ],
    "fr": [
      "Fruits & légumes, Fromages et Produits laitiers frais, Viande et Charcuterie ... une grande diversité de produits cultivés, élevés et fabriqués à La Ferme des 4 Saisons. Vendus directement et localement sur les marchés ou dans notre magasin à la ferme !"
    ],
    "nl": [
      "Groenten en fruit, kaas en verse zuivelproducten, vlees en vleeswaren ... een grote verscheidenheid aan producten die op La Ferme des 4 Saisons worden geteeld, geteeld en geproduceerd. Rechtstreeks en lokaal verkocht op de markten of in onze boerderijwinkel!"
    ],
    "es": [
      "Directos del productor, en Reignier le proponen una selección de productos: carne, fruta y verdura, quesos, yogures y otros artículos con gran calidad y de producción local."
    ]
  },
