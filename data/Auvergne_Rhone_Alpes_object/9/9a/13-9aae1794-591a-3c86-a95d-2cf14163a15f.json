  "rdfs:comment": {
    "de": [
      "Im Mustang 1650 Skiset können Sie eine große Auswahl an Skiern, Snowboards, Schlitten, Schneeschuhen und Mountainbikes mieten oder verkaufen. Außerdem gibt es einen Wartungs- und Bootfitting-Service, Presse, Kaffee und Souvenirs. Entdecken Sie auch sein Angebot an Outdoor-Aktivitäten!"
    ],
    "en": [
      "At Mustang 1650 Skiset, you'll find a wide selection of skis, snowboards, sledges, snowshoes, mountain bikes, maintenance and bootfitting services, press, coffee and souvenirs for rent or sale. And discover our range of outdoor activities!"
    ],
    "it": [
      "Al Mustang 1650 Skiset troverete un'ampia gamma di sci, snowboard, slitte, racchette da neve e mountain bike a noleggio o in vendita, oltre a un servizio di manutenzione e adattamento degli scarponi, stampa, caffè e souvenir. E date un'occhiata alla nostra gamma di attività all'aperto!"
    ],
    "fr": [
      "Au Mustang 1650 Skiset, vous trouverez à la location ou à la vente, un large choix de skis, snowboards, luges, raquettes, VTT, un service entretien et bootfitting, la presse, le café et les souvenirs. Découvrez également son offre d'activités outdoor !"
    ],
    "es": [
      "En Mustang 1650 Skiset, encontrará una amplia gama de esquís, snowboards, trineos, raquetas de nieve y bicicletas de montaña para alquilar o vender, así como un servicio de mantenimiento y reparación de botas, prensa, café y recuerdos. Y echa un vistazo a nuestra oferta de actividades al aire libre"
    ],
    "nl": [
      "Bij Mustang 1650 Skiset vind je een ruim aanbod aan ski's, snowboards, sleeën, sneeuwschoenen en mountainbikes te huur of te koop, evenals een onderhouds- en schoenservice, pers, koffie en souvenirs. En bekijk ons aanbod aan outdooractiviteiten!"
    ]
  },
