  "rdfs:comment": {
    "de": [
      "Das Festival lädt dazu ein, sich an zwei Abenden unter freiem Himmel im Park neben La Cartoucherie zu treffen. Filmvorführung, Konzert, Besichtigung des Geländes, Workshop, Fenster zu den laufenden Produktionen im Pôle de l'image Animée..."
    ],
    "en": [
      "The Festival invites you to enjoy two open-air evenings in the park adjacent to La Cartoucherie. Screening, concert, heritage tour of the site, workshop, window on current productions at the Pôle de l'image Animée..."
    ],
    "it": [
      "Il Festival vi invita a trascorrere due serate all'aria aperta, nel parco adiacente a La Cartoucherie. Proiezioni, concerti, visite al patrimonio del sito, laboratori, una finestra sulle produzioni attuali del Pôle de l'image Animée..."
    ],
    "fr": [
      "Le Festival invite à se retrouver autour de deux soirées en plein air, dans le parc qui jouxte La Cartoucherie. Projection, concert, visite patrimoniale du site, atelier, fenêtre sur les productions en cours sur le Pôle de l'image Animée..."
    ],
    "nl": [
      "Het Festival nodigt je uit om twee avonden in de open lucht te genieten, in het park naast La Cartoucherie. Voorstellingen, concerten, erfgoedrondleidingen op de site, workshops, een blik op actuele producties in de Pôle de l'image Animée..."
    ],
    "es": [
      "El Festival le invita a disfrutar de dos veladas al aire libre, en el parque contiguo a La Cartoucherie. Proyecciones, conciertos, visitas patrimoniales del lugar, talleres, una ventana a las producciones actuales del Pôle de l'image Animée..."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Festival Deux Nuits"
    ]
  },
