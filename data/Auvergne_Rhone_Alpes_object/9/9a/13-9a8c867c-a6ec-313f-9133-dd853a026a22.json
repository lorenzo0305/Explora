  "rdfs:comment": {
    "de": [
      "In meinem Lederwarenatelier fertige ich für Sie Einzelstücke nach Maß oder nach Inspiration an,\r\ndabei verleihe ich Stoffen und Materialien, die mit Geschichten beladen sind, ein zweites Leben."
    ],
    "en": [
      "In my leather goods workshop, I create one-of-a-kind pieces for you, made-to-measure or by inspiration,\r\ngiving a second life to fabrics and materials steeped in history."
    ],
    "it": [
      "Nel mio laboratorio di pelletteria, creo per voi pezzi unici, su misura o ispirati,\r\ndando una seconda vita a tessuti e materiali ricchi di storia."
    ],
    "fr": [
      "Dans mon atelier de maroquinerie, je confectionne pour vous des pièces uniques, sur mesure ou à l’inspiration,\r\nen donnant une seconde vie à des tissus et matériaux chargés d’histoires."
    ],
    "nl": [
      "In mijn lederwarenatelier maak ik unieke stukken voor jou, op maat of geïnspireerd,\r\nik geef stoffen en materialen met een rijke geschiedenis een tweede leven."
    ],
    "es": [
      "En mi taller de marroquinería, confecciono para usted piezas únicas, a medida o inspiradas,\r\ndando una segunda vida a tejidos y materiales cargados de historia."
    ]
  },
  "rdfs:label": {
