  "rdfs:comment": {
    "de": [
      "Der Wasserfall von Charabotte gehört zu den höchsten Frankreichs. Diese beeindruckende 115 Meter hohe Kaskade ist zwischen Chaley und dem Plateau von Hauteville im Albarine-Tal zu sehen, benannt nach dem Fluss, der von der Klippe stürzt."
    ],
    "en": [
      "The Charabotte Waterfall is one of the tallest in France. This impressive 115-meter-high cascade can be seen between Chaley and the Hauteville Plateau, in the Albarine Valley, named after the river that plunges off the cliff."
    ],
    "it": [
      "La cascata di Charabotte è una delle più alte della Francia. Un'impressionante cataratta alta 115 metri, visibile tra Chaley e Plateau d'Hauteville, nella valle dell'Albarine, che prende il nome dal fiume che nasce dalla falesia."
    ],
    "fr": [
      "La cascade de la Charabotte est l’une des plus hautes de France. Impressionnante cataracte de 115 mètres de haut, elle s’observe entre Chaley et Plateau d’Hauteville, dans la vallée de l’Albarine, du nom de la rivière qui se jette de la falaise."
    ],
    "es": [
      "La cascada de Charabotte es una de las más altas de Francia. Impresionante catarata de 115 metros de altura, se puede contemplar entre Chaley y Plateau d'Hauteville, en el valle de Albarine, llamado así por el río que nace en el acantilado."
    ],
    "nl": [
      "De Charabotte waterval is een van de hoogste van Frankrijk. Deze indrukwekkende kataract van 115 meter hoog is te zien tussen Chaley en Plateau d'Hauteville, in de Albarine vallei, genoemd naar de rivier die uit de klif ontspringt."
    ]
  },
  "rdfs:label": {
