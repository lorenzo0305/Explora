  "rdfs:comment": {
    "de": [
      "Die Schönheit des Sees von Annecy bei Mondschein kombiniert mit der Herausforderung eines echten Marathons: Das ist es, was Ihnen der Clair de Lune Marathon bietet!"
    ],
    "en": [
      "The beauty of the moonlit lake Annecy combined with the challenge of a genuine marathon: here's what the Marathon du Clair de Lune has to offer."
    ],
    "it": [
      "La bellezza del lago di Annecy al chiaro di luna unita alla sfida di una vera maratona: ecco cosa offre la Moonlight Marathon!"
    ],
    "fr": [
      "La beauté du lac d'Annecy au clair de lune combinée au challenge d'un véritable marathon : c'est ce que vous offre le Marathon du Clair de Lune !"
    ],
    "es": [
      "La belleza del lago de Annecy a la luz de la luna combinada con el reto de un auténtico maratón: ¡eso es lo que ofrece el Maratón Moonlight!"
    ],
    "nl": [
      "De schoonheid van het meer van Annecy in het maanlicht gecombineerd met de uitdaging van een echte marathon: dat is wat de Moonlight Marathon te bieden heeft!"
    ]
  },
