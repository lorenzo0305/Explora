  "rdfs:comment": {
    "de": [
      "Pierre Bonnieu, Nougatier seit 1988 in Montélimar, stellt seine Nougats in der Tradition her: im Kessel gekocht. Weicher Nougat und harter Nougat, Spezialitäten."
    ],
    "en": [
      "Pierre Bonnieu, traditional nougat maker in Montelimar uses the time-honour traditions of copper vats to make his delicious nougat. Soft and hard nougat and other specialities."
    ],
    "it": [
      "Pierre Bonnieu, produttore di torrone artigianale dal 1988 a Montélimar, produce i suoi torroni secondo la pura tradizione: la cottura in un calderone. Torrone morbido e torrone duro, specialità..."
    ],
    "fr": [
      "Pierre Bonnieu, Artisan Nougatier depuis 1988 à Montélimar, fabrique ses Nougats dans la pure tradition : cuisson au chaudron. Nougat tendre et nougat dur, spécialités..."
    ],
    "es": [
      "Pierre Bonnieu, turronero artesano desde 1988 en Montélimar, elabora sus turrones en la más pura tradición: la cocción en caldera. Turrón blando y turrón duro, especialidades..."
    ],
    "nl": [
      "Pierre Bonnieu, ambachtelijk nogamaker in Montélimar, vervaardigt noga volgens de echte traditie: gekookt in de ketel. Zachte en harde noga, specialiteiten…"
    ]
  },
