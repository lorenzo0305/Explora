  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Monts du Lyonnais durch ein spielerisches und kostenloses Geocaching-Erlebnis! Im Weiler Lamure (Gemeinde Larajasse) begeben Sie sich auf die Jagd nach Kloche, einer Expertin für Märchen und Legenden. Sie wird Ihnen die Geschichte des Dorfes näher bringen."
    ],
    "en": [
      "Discover the Monts du Lyonnais through a fun and free geocaching experience! In the hamlet of Lamure (commune of Larajasse), go on a hunt for Kloche, a specialist in tales and legends. She will make you discover the history of the village."
    ],
    "it": [
      "Scoprite i Monts du Lyonnais attraverso un'esperienza di geocaching divertente e gratuita! Nella frazione di Lamure (comune di Larajasse), andate a caccia di Kloche, uno specialista di racconti e leggende. Vi farà scoprire la storia del villaggio."
    ],
    "fr": [
      "Découvrez les Monts du Lyonnais à travers une expérience ludique et gratuite de géocaching ! Au hameau de Lamure (commune de Larajasse), partez à la chasse de Kloche,spécialiste des contes et légendes. Elle vous fera découvrir l'histoire du village."
    ],
    "nl": [
      "Ontdek de Monts du Lyonnais via een leuke en gratis geocaching-ervaring! Ga in het gehucht Lamure (gemeente Larajasse) op jacht naar Kloche, een specialist in verhalen en legenden. Zij zal u de geschiedenis van het dorp laten ontdekken."
    ],
    "es": [
      "Descubra los Montes del Lyonnais a través de una experiencia de geocaching divertida y gratuita En la aldea de Lamure (municipio de Larajasse), vaya a la caza de Kloche, especialista en cuentos y leyendas. Le hará descubrir la historia del pueblo."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Gnolus - Opération \"Vinaigrette\""
    ]
  },
