  "rdfs:comment": {
    "de": [
      "Yellow Jump, das sind 700 m², die dem Trampolinspringen gewidmet sind!\n6 verschiedene Bereiche für Kinder ab 6 Jahren und Erwachsene: Trampolintuch, Tumbling, Wall Run, Slackline, 2 Schaumstoffgruben, Basketballtrampolin und 1 Bereich für Kinder unter 6 Jahren"
    ],
    "en": [
      "Yellow Jump is 700m² dedicated to trampolining!\n6 different zones cater for children aged 6 and over, and adults: trampoline canvas, tumbling, wall run, slackline, 2 foam pits, trampo basket and 1 zone for children under 6"
    ],
    "it": [
      "Yellow Jump è un parco di 700 m² dedicato al trampolino elastico!\nci sono 6 aree diverse per i bambini dai 6 anni in su: trampolino, tumbling, wall run, slackline, 2 box di schiuma, trampo basket e 1 area per i minori di 6 anni"
    ],
    "fr": [
      "Yellow Jump,  c'est 700m² dédié au trampoline!\n6 zones différentes accueillent les enfants à partir de 6 ans, et les grands : toiles de trampoline, tumbling, , wall run, slackline, 2 fosses à mousse, trampo basket et 1 zone pour les moins de 6 ANS"
    ],
    "es": [
      "Yellow Jump tiene 700 m² dedicados a la cama elástica\nhay 6 áreas diferentes para niños a partir de 6 años: cama elástica, volteretas, pista de muro, slackline, 2 fosos de espuma, baloncesto trampo y 1 área para menores de 6 años"
    ],
    "nl": [
      "Yellow Jump is 700m² gewijd aan trampolinespringen!\ner zijn 6 verschillende gebieden voor kinderen vanaf 6 jaar: trampoline, tumbling, wall run, slackline, 2 foam pits, trampo basketbal en 1 gebied voor kinderen onder de 6 jaar"
    ]
  },
