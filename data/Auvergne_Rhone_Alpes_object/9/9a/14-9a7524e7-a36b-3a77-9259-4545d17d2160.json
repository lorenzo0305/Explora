      "dc:description": {
        "de": [
          "Elektronische Zigaretten.\n\nÖffnungszeiten:\n- dienstag, Mittwoch, Freitag und Samstag von 10:00 bis 12:00 Uhr und von 13:30 bis 19:00 Uhr.\n- montag und Donnerstag von 14:00 bis 19:00 Uhr."
        ],
        "en": [
          "Electronic cigarettes.\n\nOpening hours:\n- tuesday, Wednesday, Friday and Saturday from 10:00 to 12:00 and from 13:30 to 19:00.\n- monday and Thursday from 14:00 to 19:00."
        ],
        "it": [
          "Sigarette elettroniche.\n\nOrari di apertura:\n- martedì, mercoledì, venerdì e sabato dalle 10:00 alle 12:00 e dalle 13:30 alle 19:00.\n- lunedì e giovedì dalle 14:00 alle 19:00."
        ],
        "fr": [
          "Cigarettes électroniques.\n\nHoraires : \n- mardi, mercredi, vendredi et samedi de 10h00 à 12h00 et de 13h30 à 19h00.\n- lundi et jeudi de 14h00 à 19h00."
        ],
        "nl": [
          "Elektronische sigaretten.\n\nOpeningstijden:\n- dinsdag, woensdag, vrijdag en zaterdag van 10.00 tot 12.00 uur en van 13.30 tot 19.00 uur.\n- maandag en donderdag van 14.00 tot 19.00 uur."
        ],
        "es": [
          "Cigarrillos electrónicos.\n\nHorario de apertura:\n- martes, miércoles, viernes y sábado de 10.00 a 12.00 y de 13.30 a 19.00 horas.\n- lunes y jueves de 14:00 a 19:00."
        ]
      },
