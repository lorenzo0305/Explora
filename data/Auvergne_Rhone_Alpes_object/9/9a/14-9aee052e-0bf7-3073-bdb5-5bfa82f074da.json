  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/7d8c75b7-eda5-3640-a1cb-75eec868a080",
      "dc:description": {
        "de": [
          "Verwandeln Sie Ihre Aufenthalte in unvergessliche Erlebnisse. Vermietung von Villen, Cottages und Appartements mit Meerblick.\nEigentümer: Vertrauen Sie uns Ihre Immobilie für eine maßgeschneiderte Verwaltung in aller Ruhe an."
        ],
        "en": [
          "Turn your stay into an unforgettable experience. Villa, cottage and sea view apartment rentals.\nOwners: Entrust your property to us for customized, worry-free management."
        ],
        "it": [
          "Trasformate le vostre vacanze in esperienze indimenticabili. Affitti di ville, cottage e appartamenti vista mare.\nProprietari: affidateci la vostra proprietà per una gestione su misura in tutta tranquillità."
        ],
        "fr": [
          "Transformez vos séjours en expériences inoubliables. Location villa, cottage et appartement vue mer. \nPropriétaires : Confiez-nous votre bien pour une gestion sur-mesure en toute sérénité."
        ],
        "nl": [
          "Maak van je vakantie een onvergetelijke ervaring. Verhuur van villa's, vakantiehuisjes en appartementen met uitzicht op zee.\nEigenaars: Vertrouw ons uw eigendom toe voor een beheer op maat met volledige gemoedsrust."
        ],
        "es": [
          "Convierta sus vacaciones en experiencias inolvidables. Alquiler de chalets, casas rurales y apartamentos con vistas al mar.\nPropietarios: confíenos su propiedad para una gestión a medida con total tranquilidad."
        ]
      },
      "@type": [
        "Description"
      ],
