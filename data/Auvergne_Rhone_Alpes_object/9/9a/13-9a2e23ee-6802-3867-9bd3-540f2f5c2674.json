  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Spa by Sothys in der Domaine de Dolomieu: ein 700 m² großer Bereich, der ganz dem Wohlbefinden gewidmet ist. Genießen Sie außergewöhnliche Behandlungen, einen sensorischen Bereich, einen Außenpool und vieles mehr, alles eingebettet in einen wunderschönen grünen Park."
    ],
    "en": [
      "Discover the Spa by Sothys at the Domaine de Dolomieu: a 700 m2 space entirely dedicated to well-being. Enjoy exceptional treatments, a sensory space, an outdoor pool and much more, all nestled in the heart of a beautiful green park."
    ],
    "it": [
      "Scoprite la Spa by Sothys al Domaine de Dolomieu: uno spazio di 700 m² interamente dedicato al benessere. Godetevi trattamenti eccezionali, un'area sensoriale, una piscina all'aperto e molto altro ancora, il tutto immerso nel cuore di uno splendido parco verde."
    ],
    "fr": [
      "Découvrez le Spa by Sothys du Domaine de Dolomieu : un espace de 700 m² entièrement dédié au bien-être. Profitez de soins d’exception, d’un espace sensoriel, d’une piscine extérieure et bien plus encore, le tout niché au cœur d'un superbe parc verdoyant."
    ],
    "nl": [
      "Ontdek de Spa by Sothys op Domaine de Dolomieu: een ruimte van 700 m² helemaal gewijd aan welzijn. Geniet van uitzonderlijke behandelingen, een zintuiglijke ruimte, een buitenzwembad en nog veel meer, allemaal genesteld in het hart van een prachtig groen park."
    ],
    "es": [
      "Descubra el Spa by Sothys del Domaine de Dolomieu: un espacio de 700 m² totalmente dedicado al bienestar. Disfrute de tratamientos excepcionales, un espacio sensorial, una piscina exterior y mucho más, todo ello enclavado en el corazón de un magnífico parque verde."
    ]
  },
  "rdfs:label": {
    "en": [
