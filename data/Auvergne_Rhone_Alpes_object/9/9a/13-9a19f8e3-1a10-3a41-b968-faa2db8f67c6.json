  "rdfs:comment": {
    "de": [
      "Produzentin von Beerenfrüchten (Erdbeeren, Himbeeren, schwarze Johannisbeeren, Johannisbeeren, Brombeeren ....)\r\nAuch Verarbeiterin von Konfitüren und Fruchtpasten\r\nPädagogischer Bauernhof"
    ],
    "en": [
      "Berry producer (strawberries, raspberries, blackcurrants, redcurrants, blackberries ....)\r\nAlso makes jams and fruit jellies\r\nEducational farm"
    ],
    "it": [
      "Coltivatore di bacche (fragole, lamponi, ribes nero, ribes rosso, more ....)\r\nProduce anche marmellate e gelatine di frutta\r\nFattoria didattica"
    ],
    "fr": [
      "Productrice de petits fruits (fraises, framboises, cassis, groseille, mûres ....)\r\nEgalement transformatrice de confitures et pâtes de fruits\r\nFerme pédagogique"
    ],
    "es": [
      "Cultivador de bayas (fresas, frambuesas, grosellas negras, grosellas rojas, moras ....)\r\nTambién elabora mermeladas y jaleas de frutas\r\nGranja educativa"
    ],
    "nl": [
      "Bessenteler (aardbeien, frambozen, zwarte bessen, rode bessen, bramen ....)\r\nMaakt ook jam en vruchtengelei\r\nEducatieve boerderij"
    ]
  },
