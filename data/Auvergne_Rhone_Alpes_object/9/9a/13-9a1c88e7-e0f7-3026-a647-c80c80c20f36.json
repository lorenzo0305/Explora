  "rdfs:comment": {
    "de": [
      "Ich bin Auszubildender zum Bergbegleiter und befinde mich derzeit in der Ausbildung. Ich habe jedoch den Berufsstatus, um im Sommer Bergwanderungen und im Winter Schneeschuhwanderungen zu betreuen."
    ],
    "en": [
      "I am a mountain guide leader, I am in training. Nevertheless, I have the professional status to supervise hiking in the mountains in summer, and snowshoeing during winter."
    ],
    "it": [
      "Sono un'apprendista guida alpina e sono in fase di formazione. Tuttavia, ho lo status professionale per condurre passeggiate in montagna in estate ed escursioni con le racchette da neve in inverno."
    ],
    "fr": [
      "Je suis accompagnateur en montagne stagiaire, je suis en cours de formation. J'ai néanmoins le statut professionnel pour encadrer des randonnées pédestres en montagne en période estivale, et en raquettes l'hiver."
    ],
    "es": [
      "Soy monitor de montaña en prácticas y estoy en proceso de formación. Sin embargo, tengo categoría profesional para dirigir paseos por la montaña en verano y excursiones con raquetas de nieve en invierno."
    ],
    "nl": [
      "Ik ben een bergleider in opleiding en ik ben nog bezig met de opleiding. Ik heb echter een professionele status om bergwandelingen te leiden in de zomer en sneeuwschoenwandelingen in de winter."
    ]
  },
  "rdfs:label": {
    "en": [
      "Richard Chervet - Mountain leader"
    ],
    "fr": [
      "Richard Chervet - Accompagnateur en montagne"
    ]
  },
