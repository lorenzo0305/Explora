  "rdfs:comment": {
    "de": [
      "Das Bistrot des Saveurs in Arandon-Passins bietet eine lokale und saisonale Küche mit 2 bis 3 Vorschlägen, die jedes Wochenende variieren. Gesellige Atmosphäre bei einem Glas oder an einem gemeinsam genutzten Tisch. Privatisierung für Ihre Veranstaltungen möglich."
    ],
    "en": [
      "The Bistrot des Saveurs in Arandon-Passins offers local, seasonal cuisine, with 2 or 3 suggestions that change every weekend. A friendly atmosphere around a glass of wine or a shared table. Private hire available for your events."
    ],
    "it": [
      "Il Bistrot des Saveurs di Arandon-Passins propone una cucina locale e stagionale, con 2 o 3 proposte che cambiano ogni fine settimana. Un'atmosfera amichevole attorno a un bicchiere di vino o a un tavolo condiviso. Possibilità di affitto privato per eventi."
    ],
    "fr": [
      "Le Bistrot des Saveurs à Arandon-Passins propose une cuisine locale et de saison, avec 2 à 3 suggestions qui varient chaque week-end. Ambiance conviviale autour d’un verre ou d’une table partagée. Privatisation possible pour vos événements."
    ],
    "es": [
      "El Bistrot des Saveurs de Arandon-Passins sirve cocina local de temporada, con 2 ó 3 sugerencias que cambian cada fin de semana. Ambiente agradable en torno a una copa de vino o una mesa compartida. Alquiler privado para eventos."
    ],
    "nl": [
      "De Bistrot des Saveurs in Arandon-Passins serveert lokale, seizoensgebonden gerechten, met 2 of 3 suggesties die elk weekend veranderen. Een gezellige sfeer rond een glas wijn of een gedeelde tafel. Privéverhuur mogelijk voor evenementen."
    ]
  },
