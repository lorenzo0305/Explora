  "rdfs:comment": {
    "de": [
      "Der Flugplatz La Cote 2000 liegt 7 km südöstlich von Megève und bietet Flug- und Hubschrauberverbindungen nach Megève.\r\nEr ist der ideale Ausgangspunkt, um das Mont-Blanc-Massiv und seine Gletscher zu entdecken."
    ],
    "en": [
      "Located 7km south-east of the centre of Megève, the Cote 2000 altitude airport serves Megève for airplane and helicopter transport.\r\nIt is the ideal base to set out from to discover the Mont-Blanc massif and its glaciers."
    ],
    "it": [
      "Situato 7 km a sud-est di Megève, l'altiporto a quota 2000 permette di raggiungere Megève con aerei o elicotteri.\r\nÈ la base ideale per partire alla scoperta del massiccio del Monte Bianco e dei suoi ghiacciai."
    ],
    "fr": [
      "Situé à 7 km au Sud-est de Megève l'altiport de la Cote 2000 permet de desservir Megève par avion ou hélicoptère.\r\nIl est la base idéale pour aller découvrir le Massif du Mont Blanc et ses glaciers."
    ],
    "es": [
      "Situado a 7 km al sureste de Megève, el altipuerto Cote 2000 permite acceder a Megève en avión o helicóptero.\r\nEs el punto de partida ideal para descubrir el macizo del Mont Blanc y sus glaciares."
    ],
    "nl": [
      "De altiport Cote 2000 ligt 7 km ten zuidoosten van Megève en biedt toegang tot Megève per vliegtuig of helikopter.\r\nHet is de ideale uitvalsbasis om het Mont Blanc-massief en de gletsjers te ontdekken."
    ]
  },
