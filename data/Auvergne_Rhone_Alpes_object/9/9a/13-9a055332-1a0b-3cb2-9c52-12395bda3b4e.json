  "rdfs:comment": {
    "de": [
      "Kunstatelier, in dem Sie die verschiedenen Facetten der Arbeit der Künstlerin Béatrice Pécout entdecken oder wiedersehen können: Skulptur, Zeichnung, Gravur, Malerei und andere Erkundungen."
    ],
    "en": [
      "An art studio where you can discover or revisit the different facets of artist Béatrice Pécout's work: sculpture, drawing, engraving, painting and other explorations."
    ],
    "it": [
      "Laboratorio d'arte in cui è possibile scoprire o rivedere le diverse sfaccettature del lavoro dell'artista Béatrice Pécout: scultura, disegno, incisione, pittura e altre esplorazioni."
    ],
    "fr": [
      "Atelier d'art dans lequel vous pourrez découvrir ou revoir les différentes facettes du travail de l'artiste Béatrice Pécout : sculpture, dessin, gravure, peinture et autres explorations."
    ],
    "es": [
      "Taller de arte donde podrá descubrir o repasar las diferentes facetas de la obra de la artista Béatrice Pécout: escultura, dibujo, grabado, pintura y otras exploraciones."
    ],
    "nl": [
      "Een kunstatelier waar je de verschillende facetten van het werk van kunstenares Béatrice Pécout kunt ontdekken of herontdekken: beeldhouwen, tekenen, graveren, schilderen en andere verkenningen."
    ]
  },
