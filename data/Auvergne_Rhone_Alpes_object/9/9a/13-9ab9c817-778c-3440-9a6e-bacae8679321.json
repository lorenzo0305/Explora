  "rdfs:comment": {
    "de": [
      "Gemäß seinem Entwicklungsplan organisiert das Comité Départemental Handisport Isère Kurse für Minderjährige mit motorischen oder sensorischen Behinderungen: Winter Ski alpin oder Ski nordisch, wie in Chamrousse."
    ],
    "en": [
      "In line with its development plan, the Comité Départemental Handisport Isère organizes courses for minors with motor or sensory disabilities: winter downhill or Nordic skiing, as in Chamrousse."
    ],
    "it": [
      "Nell'ambito del suo piano di sviluppo, il Comité Départemental Handisport Isère organizza corsi per minori con disabilità motorie o sensoriali: discesa invernale o sci di fondo, come a Chamrousse."
    ],
    "fr": [
      "Conformément à son plan de développement, le Comité Départemental Handisport Isère organise des stages à destination des mineurs en situation de handicap moteur ou sensoriel : hiver ski alpin ou ski nordique, comme à Chamrousse."
    ],
    "es": [
      "En el marco de su plan de desarrollo, el Comité Départemental Handisport Isère organiza cursillos para menores con discapacidad motriz o sensorial: esquí alpino o de fondo de invierno, como en Chamrousse."
    ],
    "nl": [
      "Als onderdeel van zijn ontwikkelingsplan organiseert het Comité Départemental Handisport Isère cursussen voor minderjarigen met motorische of zintuiglijke handicaps: winterafdaling of langlaufen, zoals in Chamrousse."
    ]
  },
