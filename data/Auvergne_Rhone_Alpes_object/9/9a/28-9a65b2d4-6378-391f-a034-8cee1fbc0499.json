    "de": [
      "Doullens, Wiege des Sieges dank des britisch-französischen Einheitskommandos, das General Foch am 26. März 1918 im Rathaus anvertraut wurde."
    ],
    "en": [
      "Doullens, cradle of victory, thanks to the Franco-British Single Command entrusted to General Foch on March 26, 1918 at the Hôtel de Ville."
    ],
    "it": [
      "Doullens, culla della vittoria, grazie al comando unico franco-britannico affidato al generale Foch il 26 marzo 1918 all'Hôtel de Ville."
    ],
    "fr": [
      "Doullens, berceau de la victoire, grâce au Commandement Unique franco-britannique confié au Général Foch le 26 mars 1918 à l'Hôtel de Ville."
    ],
    "es": [
      "Doullens, cuna de la victoria, gracias al Mando Único franco-británico confiado al general Foch el 26 de marzo de 1918 en el Hôtel de Ville."
