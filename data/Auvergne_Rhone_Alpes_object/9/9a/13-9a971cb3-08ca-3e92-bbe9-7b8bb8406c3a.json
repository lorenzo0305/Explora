  "rdfs:comment": {
    "de": [
      "Der Glockenturm von Saint-Martin liegt auf halbem Hang und bietet einen weiten Blick über das Savasse-Tal. Verfolgen Sie die Geschichte von Geyssans und seiner Kirche von der alten Pfarrei und Herrschaft bis zum heutigen Dorf."
    ],
    "en": [
      "Situated halfway up the hillside, the bell tower of Saint-Martin offers a vast view over the Savasse valley. Trace the history of Geyssans and its church, from the ancient parish and seigneury to the present-day village."
    ],
    "it": [
      "Situato a metà collina, il campanile di Saint-Martin offre una vasta vista sulla valle della Savasse. Ripercorrete la storia di Geyssans e della sua chiesa, dall'antica parrocchia e signoria all'attuale villaggio."
    ],
    "fr": [
      "Situé à mi-coteau, le clocher de Saint-Martin offre une vaste vue sur la vallée de la Savasse. De l’ancienne paroisse et seigneurie au village actuel, retracez l’histoire de Geyssans et de son église."
    ],
    "es": [
      "Situado a media ladera, el campanario de Saint-Martin ofrece una amplia vista sobre el valle de la Savasse. Recorra la historia de Geyssans y de su iglesia, desde la antigua parroquia y señorío hasta el pueblo actual."
    ],
    "nl": [
      "De klokkentoren van Saint-Martin ligt halverwege de heuvel en biedt een weids uitzicht over de vallei van de Savasse. Volg de geschiedenis van Geyssans en zijn kerk, van de oude parochie en heerlijkheid tot het huidige dorp."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite Guidée : Autour de l'église Saint-Martin à Geyssans"
    ]
  },
