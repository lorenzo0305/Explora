  "rdfs:comment": {
    "de": [
      "Es ist der 14. Juli in La Chapelle en Vercors. Feuerwerk auf dem Dorfplatz, gefolgt von einem Volksball.\r\nUnd von 9 bis 12 Uhr: Boule-Wettbewerb, Einführung in den Biathlon, Präsentation der Fahrzeuge der Kaserne, Feuerwehrparcours."
    ],
    "en": [
      "July 14th at La Chapelle en Vercors. Fireworks in the village square, followed by a popular ball.\r\nAnd from 9 a.m. to 12 p.m., pétanque competition, biathlon initiation, presentation of fire station vehicles, firemen's course."
    ],
    "it": [
      "14 luglio a La Chapelle en Vercors. Fuochi d'artificio nella piazza del villaggio seguiti da una danza popolare.\r\nDalle 9.00 alle 12.00, gara di bocce, iniziazione al biathlon, presentazione dei veicoli della stazione dei pompieri, corso per pompieri."
    ],
    "fr": [
      "C'est le 14 juillet à la Chapelle en Vercors. Feu d'artifice sur la place du village suivi du bal populaire.\r\nEt de 9h à 12h, concours de pétanque, initiation au biathlon, présentation des véhicules de la caserne, parcours pompiers."
    ],
    "nl": [
      "14 juli in La Chapelle en Vercors. Vuurwerk op het dorpsplein gevolgd door een volksdans.\r\nEn van 9.00 tot 12.00 uur jeu de boules-wedstrijd, biatlon-initiatie, presentatie van brandweervoertuigen, brandweerparcours."
    ],
    "es": [
      "14 de julio en La Chapelle en Vercors. Fuegos artificiales en la plaza del pueblo seguidos de un baile popular.\r\nY de 9 a 12 h, competición de petanca, iniciación al biatlón, presentación de los vehículos del parque de bomberos, recorrido de los bomberos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Fête du 14 Juillet"
    ]
  },
