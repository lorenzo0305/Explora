      "dc:description": {
        "de": [
          "Zumba von 18:00 bis 19:00 Uhr.\n Treffen Sie sich mit Ihrer Wasserflasche auf der Esplanade.\nFür alle offen und kostenlos."
        ],
        "en": [
          "Zumba from 6pm to 7pm.\n Meet on the esplanade with your water bottle.\nOpen to all, free of charge."
        ],
        "it": [
          "Zumba dalle 18.00 alle 19.00.\n Appuntamento sulla spianata con la borraccia.\nAperto a tutti e gratuito."
        ],
        "fr": [
          "Zumba de 18h à 19h.\n Rendez-vous sur l'esplanade avec votre bouteille d'eau. \nOuvert à tous et gratuit."
        ],
        "nl": [
          "Zumba van 18.00 tot 19.00 uur.\n Verzamelen op de esplanade met je fles water.\nVoor iedereen en gratis."
        ],
        "es": [
          "Zumba de 18:00 a 19:00 horas.\n Reúnase en la explanada con su botella de agua.\nAbierto a todos y gratuito."
        ]
      },
