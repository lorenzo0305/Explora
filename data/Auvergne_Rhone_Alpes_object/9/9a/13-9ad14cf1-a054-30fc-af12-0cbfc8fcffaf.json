  "rdfs:comment": {
    "de": [
      "18h45 ? Zaperokonte\r\n20h ? Abend Clérieuzité :\r\nMit dem Appetit von 1000 Leben, Ernest AFRIYIÉ, anschließend werden wir gemeinsam die 10 Kerzen des Dromeau ausblasen!"
    ],
    "en": [
      "18h45 ? Zaperoconte\r\n20h ? Soirée Clérieuzité :\r\nAvec l?appétit de 1000 vies, Ernest AFRIYIÉ, then we'll blow out the 10 candles of the dromeau together!"
    ],
    "it": [
      "18h45 ? Zaperoconte\r\n20h ? Serata Clérieuzité:\r\nCon l'appetito di 1000 vite, Ernest AFRIYIÉ, poi spegneremo insieme le 10 candele del dromeau!"
    ],
    "fr": [
      "18h45 — Zapéroconte\r\n20h — Soirée Clérieuzité  :\r\nAvec l’appétit de 1000 vies, Ernest AFRIYIÉ, puis nous soufflerons ensemble les 10 bougies du dromeau !"
    ],
    "es": [
      "18h45 ? Zaperoconte\r\n20h ? Clérieuzité noche :\r\n¡Con el apetito de 1000 vidas, Ernest AFRIYIÉ, luego soplaremos juntos las 10 velas del dromeau!"
