  "rdfs:comment": {
    "de": [
      "Am Seeufer, mit den Füßen im Wasser... Lassen Sie sich von unserer bistronomischen Küche, die aus lokalen Produkten besteht, während eines entspannenden Moments in einem Feinschmeckergeist entführen. Karte im Laufe der Jahreszeiten."
    ],
    "en": [
      "At the edge of the lake, discover our original cooking. Enjoy a relaxing spot while treating yourself with one of our gourmet menus."
    ],
    "it": [
      "In riva al lago, con i piedi nell'acqua... lasciatevi trasportare dalla nostra cucina bistronomica, a base di prodotti locali, per un momento di relax in pieno spirito gourmet. Menu stagionale."
    ],
    "fr": [
      "Au bord du lac, les pieds dans l'eau... laissez-vous transporter par notre cuisine bistronomique, composée de produits locaux lors d'un moment de détente dans un esprit gourmand. Carte au fil des saisons."
    ],
    "es": [
      "Junto al lago, con los pies en el agua... déjese transportar por nuestra cocina bistronómica, elaborada con productos locales, durante un momento de relajación con espíritu gourmet. Menú de temporada."
    ],
    "nl": [
      "Aan het meer, met uw voeten in het water... laat u meevoeren door onze bistronomische keuken, samengesteld uit lokale producten tijdens een moment van ontspanning in een gastronomische geest. Seizoensmenu."
    ]
  },
  "rdfs:label": {
    "en": [
      "Chez ma Cousine"
    ],
    "fr": [
      "Chez Ma Cousine"
    ]
  },
