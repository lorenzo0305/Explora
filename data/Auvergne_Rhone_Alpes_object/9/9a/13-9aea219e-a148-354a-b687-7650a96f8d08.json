  "rdfs:comment": {
    "de": [
      "Das Copiña ist von der spanischen Region Galicien inspiriert und ein einzigartiger Treffpunkt in den Alpen, der Fusion"
    ],
    "en": [
      "Inspired by the Galician region of Spain, Copiña is a unique venue in the alps serving fusion tapas and unique cocktails designed for sharing."
    ],
    "it": [
      "Ispirato alla regione spagnola della Galizia, Copiña è un locale unico sulle Alpi che serve tapas fusion e cocktail unici pensati per la condivisione."
    ],
    "fr": [
      "Inspiré par la région galicienne de l'Espagne, Copiña est un lieu unique dans les Alpes qui sert des tapas fusion et des cocktails uniques conçus pour être partagés."
    ],
    "es": [
      "Inspirado en la región gallega de España, Copiña es un local único en los Alpes que sirve tapas de fusión y cócteles únicos diseñados para compartir."
    ],
    "nl": [
      "Copiña, geïnspireerd door de Spaanse regio Galicië, is een unieke locatie in de Alpen waar fusion tapas en unieke cocktails worden geserveerd om te delen."
