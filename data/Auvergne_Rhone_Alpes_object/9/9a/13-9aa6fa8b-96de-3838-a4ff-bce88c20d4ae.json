  "rdfs:comment": {
    "de": [
      "Ein Restaurant in einem kleinen Dorf in der Region Haut Forez, auf einer Höhe von 1000m und nur 9 Kilometer von Saint-Bonnet-le-Château entfernt. Séverine und Fabien Cizeron empfangen Sie in einem alten Bauernhaus, das unter Wahrung der Authentizität des Ortes vollständig renoviert wurde."
    ],
    "en": [
      "Restaurant suggesting a traditional cooking. Located at the entrance of La Chapelle en Lafaye in an old restored farm. Terrace, take-away meals (on request)."
    ],
    "it": [
      "Un ristorante situato in un piccolo villaggio dell'Haut Forez a 1000 metri di altitudine, a 9 km da Saint-Bonnet-le-Château.\r\nSéverine e Fabien Cizeron vi accolgono in un'antica casa colonica completamente ristrutturata, nel rispetto dell'autenticità del luogo."
    ],
    "fr": [
      "Un restaurant situé dans un petit village du Haut Forez à 1000 mètres d'altitude à 9 km de Saint-Bonnet-le-Château.\r\nSéverine et Fabien Cizeron vous accueillent dans une ancienne ferme entièrement rénovée, en respectant l'authenticité du lieu."
    ],
    "es": [
      "Restaurante situado en un pequeño pueblo del Haut Forez a 1000 metros de altitud, a 9 km de Saint-Bonnet-le-Château.\r\nSéverine y Fabien Cizeron le dan la bienvenida a una antigua granja completamente renovada, respetando la autenticidad del lugar."
    ],
    "nl": [
      "Een restaurant gelegen in een klein dorp in de Haut Forez op 1000 meter hoogte, op 9 km van Saint-Bonnet-le-Château.\r\nSéverine en Fabien Cizeron heten u welkom in een oude boerderij die volledig is gerenoveerd, met respect voor de authenticiteit van de plek."
    ]
  },
