  "rdfs:comment": {
    "de": [
      "Hundeerzieherin und Verhaltensforscherin in Saint-Jean-de-Maurienne, Canischool bietet Ihnen ihre Dienste an, um Ihre vierbeinigen Freunde auf privatem Grund oder zu Hause in Gruppen- oder Einzelkursen zu erziehen oder umzuerziehen."
    ],
    "en": [
      "Canine educator and behaviorist in Saint-Jean-de-Maurienne, Canischool offers you its services to educate or re-educate your 4-legged companions on private land or at home and in group or individual lessons."
    ],
    "it": [
      "Educatore e comportamentista canino a Saint-Jean-de-Maurienne, Canischool vi offre i suoi servizi per educare o rieducare i vostri compagni a 4 zampe su terreni privati o a casa, in lezioni di gruppo o individuali."
    ],
    "fr": [
      "Éducatrice canine et comportementaliste sur Saint-Jean-de-Maurienne, Canischool vous propose ses services pour éduquer ou rééduquer vos compagnons à 4 pattes sur terrain privé ou à domicile, en cours collectifs ou individuels."
    ],
    "es": [
      "Educador y conductista canino en Saint-Jean-de-Maurienne, Canischool le ofrece sus servicios para educar o reeducar a sus compañeros de 4 patas en terrenos privados o a domicilio, en clases colectivas o individuales."
    ],
    "nl": [
      "De Canischool, hondenopvoeder en gedragsdeskundige in Saint-Jean-de-Maurienne, biedt u zijn diensten aan om uw viervoeters op te voeden of te heropvoeden op privéterrein of thuis, in groeps- of individuele lessen."
    ]
  },
