  "rdfs:comment": {
    "de": [
      "Diese Einführung in die Kunst für die Jüngsten bis 5 Jahre ermöglicht es, eine Auswahl von Werken, aber auch Formen, Farben und vieles mehr zu entdecken.\r\nNach Anmeldung."
    ],
    "en": [
      "This introduction to art for children up to 5 years old introduces them to a selection of works, shapes, colors and much more.\r\nRegistration required."
    ],
    "it": [
      "Questa introduzione all'arte per bambini fino a 5 anni li introduce a una selezione di opere, oltre che a forme, colori e molto altro.\r\nIscrizione obbligatoria."
    ],
    "fr": [
      "Cette initiation à l'art pour les plus jeunes jusqu'à 5 ans permet de découvrir une sélection d'œuvre mais aussi les formes, les couleurs et bien d'autre choses.\r\nSur inscription."
    ],
    "es": [
      "Esta introducción al arte para niños de hasta 5 años les introduce en una selección de obras, así como en las formas, los colores y mucho más.\r\nInscripción obligatoria."
    ],
    "nl": [
      "Deze introductie tot kunst voor jongeren tot 5 jaar laat hen kennismaken met een selectie werken, vormen, kleuren en nog veel meer.\r\nRegistratie verplicht."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Micro-Folie : Mini Kid's Art"
    ]
  },
