  "rdfs:comment": {
    "de": [
      "Restaurant an der Promenade mit Blick auf die Somme-Bucht. Sehr angenehme Terrasse gegenüber dem Strand von Crotoy. Spezialitäten: Fisch, Meeresfrüchte, Kräuter aus der Bucht, hausgemachte Desserts, saisonale und regionale Produkte,.\nAuf der Grundlage ihrer lokalen und saisonalen Küche genießen Sie ihre besten Rezepte zum Mitnehmen"
    ],
    "en": [
      "Restaurant located on the promenade overlooking the bay of the Somme. Very pleasant terrace in front of the Crotoy beach. Specialities: fish, seafood, herbs from the bay, homemade desserts, seasonal and local products.\nBased on their local and seasonal cuisine, enjoy their best takeaway recipes"
    ],
    "it": [
      "Ristorante situato sul lungomare con vista sulla baia della Somme. Terrazza molto piacevole di fronte alla spiaggia di Le Crotoy. Specialità: pesce, frutti di mare, erbe della baia, dolci fatti in casa, prodotti stagionali e locali.\nSulla base della loro cucina locale e stagionale, gustate le loro migliori ricette da asporto"
    ],
    "fr": [
      "Restaurant situé sur la promenade avec vue sur la baie de Somme. Terrasse très agréable face à la plage du Crotoy. Spécialités : poissons, fruits de mer, herbes de la baie, desserts maison, produits de saison et du terroir,.\nSur la base de leur cuisine locale et de saison, profitez de leurs meilleures recettes à emporter"
    ],
    "es": [
      "Restaurante situado en el paseo marítimo con vistas a la bahía del Somme. Terraza muy agradable frente a la playa de Le Crotoy. Especialidades: pescado, marisco, hierbas de la bahía, postres caseros, productos de temporada y locales.\nBasándose en su cocina local y de temporada, disfrute de sus mejores recetas para llevar"
    ],
    "nl": [
      "Restaurant gelegen aan de promenade met uitzicht op de Baai van de Somme. Zeer aangenaam terras met uitzicht op het strand van Le Crotoy. Specialiteiten: vis, zeevruchten, kruiden uit de baai, huisgemaakte desserts, seizoensgebonden en lokale producten.\nOp basis van hun lokale en seizoensgebonden keuken, genieten van hun beste recepten om mee te nemen"
    ]
  },
