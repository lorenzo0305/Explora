  "rdfs:comment": {
    "de": [
      "Die am Hang des Vercors gelegene Gemeinde Barbières ist besonders bemerkenswert aufgrund ihrer spektakulären geografischen Lage in der Barberolle-Schlucht, die von den Ruinen der Festung Pellafol dominiert wird. Das Dorf entwickelte sich im 19."
    ],
    "en": [
      "Situated on the slopes of the Vercors mountains, the commune of Barbières is particularly noteworthy for its spectacular geographical location in the Barberolle gorge, dominated by the ruins of the Pellafol fortified castle. The village grew in the 19th century."
    ],
    "it": [
      "Situato sulle pendici del Vercors, il comune di Barbières si distingue soprattutto per la sua spettacolare posizione geografica nella gola di Barberolle, dominata dalle rovine del castello di Pellafol. Il villaggio si è sviluppato nel XIX secolo."
    ],
    "fr": [
      "Etablie au flanc du Vercors, la commune de Barbières est particulièrement remarquable pour son site géographique spectaculaire dans le défilé de la Barberolle, dominé par les ruines du château-fort de Pellafol. Le village se développe au 19e siècle."
    ],
    "es": [
      "Establecido en las laderas del Vercors, el municipio de Barbières destaca especialmente por su espectacular emplazamiento geográfico en el desfiladero de Barberolle, dominado por las ruinas del castillo de Pellafol. El pueblo se desarrolló en el siglo XIX."
    ],
    "nl": [
      "Barbières ligt op de hellingen van de Vercors en valt vooral op door zijn spectaculaire ligging in de kloof van Barberolle, die wordt gedomineerd door de ruïnes van het versterkte kasteel van Pellafol. Het dorp ontwikkelde zich in de 19e eeuw."
    ]
  },
