  "rdfs:comment": {
    "de": [
      "Genießen Sie die frische Luft in vollen Zügen und verlängern Sie Ihre Entspannung im Spa Deep Nature. Inspiriert vom Besten der Natur, genießen Sie hier maßgeschneiderte Gesichts- und Körperbehandlungen sowie Massagen, die individuell und einzigartig sind."
    ],
    "en": [
      "Make the most of the great outdoors and extend your relaxation at the Deep Nature Spa. Inspired by the very best of nature, come and enjoy bespoke, customizable, and unique facial treatments, body care, and massages."
    ],
    "it": [
      "Approfittate dell'aria fresca e prolungate il vostro relax nella Deep Nature Spa. Ispirati dal meglio della natura, venite a godervi trattamenti su misura, personalizzati e unici per il viso, il corpo e i massaggi."
    ],
    "fr": [
      "Profitez pleinement du grand air, et prolongez votre détente dans le Spa Deep Nature. Inspirés du meilleur de la nature, venez profiter de soins visage, corps et massage sur-mesure, personnalisables et uniques."
    ],
    "nl": [
      "Profiteer optimaal van de frisse lucht en ontspan in de Deep Nature Spa. Geïnspireerd door het allerbeste uit de natuur kun je hier genieten van op maat gemaakte, persoonlijke en unieke gezichts-, lichaams- en massagebehandelingen."
    ],
    "es": [
      "Aproveche al máximo el aire fresco y amplíe su relajación en el Deep Nature Spa. Inspirado en lo mejor de la naturaleza, venga y disfrute de tratamientos faciales, corporales y masajes a medida, personalizados y únicos."
    ]
  },
  "rdfs:label": {
    "en": [
      "Spa by Deep Nature"
    ],
    "fr": [
      "Soins corps et visage Spa by Deep Nature"
    ],
    "nl": [
      "Spa by Deep Nature"
    ]
  },
