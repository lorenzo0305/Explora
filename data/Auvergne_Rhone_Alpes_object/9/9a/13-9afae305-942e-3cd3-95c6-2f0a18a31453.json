  "rdfs:comment": {
    "de": [
      "Schweine aus Freilandhaltung und Mutterkuhhaltung der Aubrac-Rasse\r\nAuf dem Hof zubereitetes AB-Fleisch: Schweinefleisch, Trockenwürste, Wurstwaren, Rindfleischpakete, Hacksteakpakete\r\nApfelsaft\r\nEier"
    ],
    "en": [
      "Free-range pigs and Aubrac suckling cattle\r\nAB meats prepared on the farm: pork, dry sausages, charcuterie, beef parcels, minced steak parcels\r\nApple juice\r\nEggs"
    ],
    "it": [
      "Maiali allevati all'aperto e bovini da latte di razza Aubrac\r\nCarni AB preparate in azienda: maiale, salsicce secche, salumi, pacchi di manzo, pacchi di bistecca macinata\r\nSucco di mela\r\nUova"
    ],
    "fr": [
      "Porcs élevés en plein air et bovins allaitants de race Aubrac\r\nViandes AB préparées à la ferme : viande de porc, saucisses et saucissons secs, charcuteries, colis de boeuf, colis de steaks hachés\r\nJus de pomme\r\nOeufs"
    ],
    "nl": [
      "Varkens met vrije uitloop en Aubrac zoogvee\r\nVleeswaren bereid op de boerderij: varkensvlees, droge worsten, vleeswaren, rundvleespakketten, gehaktpakketten\r\nAppelsap\r\nEieren"
    ],
    "es": [
      "Cerdos camperos y vacas nodrizas de Aubrac\r\nCarnes AB preparadas en la granja: cerdo, salchichas secas, embutidos, paquetes de ternera, paquetes de carne picada\r\nZumo de manzana\r\nHuevos"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ferme du Perroux"
    ]
  },
