  "rdfs:comment": {
    "de": [
      "Genießen Sie Ihre Sommerabende in La Paillote: Bar-Restaurant des Campingplatzes Domaine de Senaud.\r\nSie befindet sich auf einem wunderschönen Gelände mit Bäumen und Kinderspielplatz, wo Sie angenehme Momente mit der Familie oder mit Freunden verbringen können.\r\nUrlaubsfeeling garantiert!"
    ],
    "en": [
      "Come and enjoy your summer evenings at the snack bar of the Domaine de Senaud campsite!\r\nLocated on a magnificent wooded estate with children's playground, you'll have a great time with family and friends! \r\nVacation spirit and a change of scenery guaranteed!"
    ],
    "it": [
      "Venite a godervi le vostre serate estive a La Paillote: il bar-ristorante del campeggio Domaine de Senaud.\r\nImmerso in una magnifica area boschiva con attrezzature per bambini, vi farà divertire con la famiglia e gli amici.\r\nMenù in stile brasserie/snacking"
    ],
    "fr": [
      "Venez profiter de vos soirées d’été à La Paillote : bar restaurant du camping Domaine de Senaud.\r\nSituée sur un magnifique domaine arboré avec jeux pour enfants, vous passerez d’agréables moments en famille ou entre amis. \r\nCarte de type brasserie/snacking"
    ],
    "es": [
      "Venga a disfrutar de sus veladas estivales en La Paillote: el bar-restaurante del camping Domaine de Senaud.\r\nSituado en un magnífico espacio arbolado con juegos infantiles, lo pasará en grande en familia o entre amigos.\r\nMenú tipo brasserie/snacking"
    ],
    "nl": [
      "Kom genieten van je zomeravonden in La Paillote: het bar-restaurant op camping Domaine de Senaud.\r\nGelegen op een prachtig bebost domein met speeltuin, zul je je hier prima vermaken met je gezin of met vrienden.\r\nVakantiegevoel gegarandeerd!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Paillote : bar-restaurant au camping Domaine de Senaud"
    ]
  },
