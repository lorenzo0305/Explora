  "rdfs:comment": {
    "de": [
      "Mitten im Dorf gelegen, bietet dieser Ort unvergessliche Momente. Im Winter in einem hübschen Gewölbezimmer am Kamin. Bei schönem Wetter im Garten oder auf der Terrasse mit Blick aufs Dorf. Das Restaurant wird in vielen Reiseführern erwähnt."
    ],
    "en": [
      "In the heart of the village, this place offers rare moments. In winter, in a pretty vaulted room near the fireplace. In fine weather, in the garden or on the terrace on the village side. The restaurant is mentioned in many guides"
    ],
    "it": [
      "Nel cuore del villaggio. In inverno, in una graziosa sala a volta accanto al camino. Nella bella stagione, nel giardino o sulla terrazza del villaggio. Il ristorante è citato in numerose guide"
    ],
    "fr": [
      "Au cœur du village. En hiver, dans une jolie salle voutée près de la cheminée. Aux beaux jours, dans le jardin ou sur la terrasse côté village. Le restaurant est cité dans de nombreux guides"
    ],
    "nl": [
      "In het hart van het dorp biedt deze plek zeldzame momenten. In de winter in een mooie gewelfde ruimte bij de open haard. Bij mooi weer in de tuin of op het terras aan de dorpszijde. Het restaurant wordt in vele gidsen vermeld."
    ],
    "es": [
      "En el corazón del pueblo. En invierno, en una bonita sala abovedada junto a la chimenea. Cuando hace buen tiempo, en el jardín o en la terraza del pueblo. El restaurante se menciona en numerosas guías"
    ]
  },
