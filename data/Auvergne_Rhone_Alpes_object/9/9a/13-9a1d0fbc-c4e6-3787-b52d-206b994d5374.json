  "rdfs:comment": {
    "de": [
      "Romanische und gotische Kirche aus dem 11. Jahrhundert. Glasmalereien von Luc Barbier, einschiffig mit Holzdecke. Vor der Kirche: Linde, die unter Heinrich IV. gepflanzt wurde."
    ],
    "en": [
      "11th century Gothic and Romanesque church. Stained glass windows by Luc Barbier, single nave with wooden ceiling. In front of the church: linden tree planted during the reign of King Henry IV."
    ],
    "it": [
      "Chiesa romanica e gotica dell'XI secolo. Vetrate di Luc Barbier, navata unica con soffitto in legno. Davanti alla chiesa: tiglio piantato sotto Enrico IV."
    ],
    "fr": [
      "Eglise roman et gothique du XIe. Vitraux de Luc Barbier, nef unique avec plafond en bois. Devant l'église : tilleul planté sous Henri IV."
    ],
    "nl": [
      "Romaanse en gotische kerk uit de 11e eeuw. Gebrandschilderde ramen van Luc Barbier, eenbeukig schip met houten plafond. Voor de kerk: lindeboom geplant onder Henri IV."
    ],
    "es": [
      "Iglesia románica y gótica del siglo XI. Vidrieras de Luc Barbier, nave única con techo de madera. Delante de la iglesia: tilo plantado bajo Enrique IV."
    ]
  },
