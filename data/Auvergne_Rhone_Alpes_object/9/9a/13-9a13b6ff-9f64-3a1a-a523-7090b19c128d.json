  "rdfs:comment": {
    "de": [
      "Das Hotel Ibis Centre*** befindet sich in der Nähe des Stadtzentrums (Geschäfte, Theater und Kino), der wichtigsten Sehenswürdigkeiten und des Beginns des Jakobswegs, 900 m vom SNCF-Bahnhof, 5 min von den Hauptverkehrsstraßen und 15 min vom Flughafen entfernt."
    ],
    "en": [
      "The Ibis Centre*** hotel is located near the town center (stores, theater and cinema), the main monuments and the start of the St Jacques pilgrimage route, 900 m from the SNCF train station, 5 min from the main roads and 15 min from the airport."
    ],
    "it": [
      "L'hotel Ibis Centre*** è situato vicino al centro città (negozi, teatro e cinema), ai principali monumenti e all'inizio del Cammino di Santiago, a 900 m dalla stazione ferroviaria SNCF, a 5 minuti dalle strade principali e a 15 minuti dall'aeroporto."
    ],
    "fr": [
      "L’hôtel Ibis Centre*** est situé à proximité du centre ville (magasins, théâtre et cinéma), des principaux monuments et du départ du chemin de St Jacques, à 900 m de la gare SNCF, à 5 min des principaux axes routiers et à 15 min de l’aéroport."
    ],
    "nl": [
      "Het Ibis Centre*** hotel ligt dicht bij het stadscentrum (winkels, theater en bioscoop), de belangrijkste monumenten en het begin van de Camino de Santiago, 900 m van het SNCF treinstation, 5 min van de hoofdwegen en 15 min van de luchthaven."
    ],
    "es": [
      "El hotel Ibis Centre*** está situado cerca del centro de la ciudad (tiendas, teatro y cine), de los principales monumentos y del inicio del Camino de Santiago, a 900 m de la estación de tren SNCF, a 5 min de las principales carreteras y a 15 min del aeropuerto."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Hôtel Ibis Centre"
    ]
  },
