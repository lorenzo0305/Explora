  "rdfs:comment": {
    "de": [
      "L'Ain de Ferme en Ferme ist eine Veranstaltung, bei der Sie an einem Wochenende Landwirten begegnen können, die Ihnen ihren Beruf und ihre Umgebung näher bringen. Sie werden Ihnen alles über ihr Know-how erklären."
    ],
    "en": [
      "The Ain de Ferme en Ferme is a weekend-long event where you can meet farmers and find out more about their work and their environment. They'll tell you all about their know-how."
    ],
    "it": [
      "L'Ain de Ferme en Ferme è un evento della durata di un weekend in cui è possibile incontrare gli agricoltori e scoprire di più sul loro lavoro e sul loro ambiente. Vi racconteranno tutto il loro know-how."
    ],
    "fr": [
      "L'Ain de Ferme en Ferme est une manifestation qui permet, le temps d'un week-end,  de partir à la rencontre d'agriculteurs qui vous feront découvrir leur métier et leur environnement. Ils vous expliqueront tout de leurs savoir-faire."
    ],
    "es": [
      "El Ain de Ferme en Ferme es un evento de un fin de semana en el que podrá conocer a los agricultores y saber más sobre su trabajo y su entorno. Le contarán todo sobre su saber hacer."
    ],
    "nl": [
      "De Ain de Ferme en Ferme is een weekend lang evenement waar je boeren kunt ontmoeten en meer te weten kunt komen over hun werk en hun omgeving. Ze vertellen je alles over hun knowhow."
    ]
  },
  "rdfs:label": {
    "en": [
