  "rdfs:comment": {
    "de": [
      "Dieses atypische, charmante Hotel empfängt Sie im Zentrum von Villefranche-sur-Saône in der Region Beaujolais in einer Umgebung, die Sie nach Irland reisen lässt."
    ],
    "en": [
      "This charming, atypical hotel welcomes you to the centre of Villefranche-sur-Saône, in the Beaujolais region, in a setting that will take you on a journey to Ireland."
    ],
    "it": [
      "Questo hotel affascinante e atipico vi accoglie nel centro di Villefranche-sur-Saône, nella regione del Beaujolais, in un ambiente che vi farà viaggiare in Irlanda."
    ],
    "fr": [
      "Cet hôtel de charme atypique vous accueille au centre de Villefranche-sur-Saône, dans la région du Beaujolais, dans un cadre qui vous fera voyager en Irlande."
    ],
    "es": [
      "Este encantador y atípico hotel le da la bienvenida en el centro de Villefranche-sur-Saône, en la región del Beaujolais, en un entorno que le hará viajar a Irlanda."
    ],
    "nl": [
      "Dit charmante en atypische hotel verwelkomt u in het centrum van Villefranche-sur-Saône, in de Beaujolais, in een omgeving die u naar Ierland doet reizen."
    ]
  },
