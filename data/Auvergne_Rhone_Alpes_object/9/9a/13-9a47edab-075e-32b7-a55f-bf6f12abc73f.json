  "rdfs:comment": {
    "de": [
      "Die Bibliothek in Saint-Julien-Montdenis ist ein Ort, an dem man lesen und sich treffen kann. Hier findet man Jugend- und Erwachsenenbücher: Romane (verschiedene, Krimis, Savoyen...) Comics, Dokumentarfilme (Tourismus und Wandern, Medizin, Geschichte) usw."
    ],
    "en": [
      "The Saint-Julien-Montdenis library is a place for reading and socializing. You'll find books for young people and adults: novels (miscellaneous, detective, Savoyard...), comics, documentaries (tourism and hiking, medicine, history) and more."
    ],
    "it": [
      "La biblioteca di Saint-Julien-Montdenis è un luogo di lettura e di socializzazione. Ci sono libri per giovani e adulti: romanzi (vari, polizieschi, savoiardi, ecc.), fumetti, documentari (turismo ed escursionismo, medicina, storia), ecc."
    ],
    "fr": [
      "La bibliothèque de Saint-Julien-Montdenis est un lieu pour lire et se retrouver. On y trouve des livres jeunesse et adulte : romans (divers, policiers, savoyards...) BD, documentaires (tourisme et randonnée, médecine, histoire) etc."
    ],
    "es": [
      "La biblioteca de Saint-Julien-Montdenis es un lugar de lectura y convivencia. Hay libros para jóvenes y adultos: novelas (misceláneas, policíacas, saboyanas, etc.), cómics, documentales (turismo y senderismo, medicina, historia), etc."
    ],
    "nl": [
      "De bibliotheek van Saint-Julien-Montdenis is een plek om te lezen en te socializen. Er zijn boeken voor jongeren en volwassenen: romans (divers, detective, Savoyard, enz.), strips, documentaires (toerisme en wandelen, geneeskunde, geschiedenis), enz."
    ]
  },
