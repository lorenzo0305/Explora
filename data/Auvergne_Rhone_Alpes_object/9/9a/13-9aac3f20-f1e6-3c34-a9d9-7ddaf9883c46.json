  "rdfs:comment": {
    "de": [
      "Die Karawane der Berufe macht sich auf den Weg, um Jugendliche und Arbeitssuchende zu treffen! Vom 23. März bis zum 4. April 2026 wird die Karawane der Berufe in 12 Etappen durch die Gebiete der Auvergne-Rhône-Alpes ziehen."
    ],
    "en": [
      "The Caravane des métiers sets off to meet young people and jobseekers! From March 23 to April 4, 2026, the Caravane des métiers will criss-cross the Auvergne-Rhône-Alpes region in 12 stages."
    ],
    "it": [
      "La Caravane des métiers parte per incontrare i giovani e le persone in cerca di lavoro! Dal 23 marzo al 4 aprile 2026, la Caravane des métiers attraverserà la regione Alvernia-Rodano-Alpi in 12 tappe."
    ],
    "fr": [
      "La Caravane des métiers s’élance à la rencontre des jeunes et des demandeurs d’emploi ! Du 23 mars au 4 avril 2026, la Caravane des métiers va sillonner les territoires d’Auvergne-Rhône-Alpes en 12 étapes."
    ],
    "es": [
      "La Caravana de las Oportunidades sale al encuentro de los jóvenes y los solicitantes de empleo Del 23 de marzo al 4 de abril de 2026, la Caravana de los Oficios recorrerá la región de Auvernia-Ródano-Alpes en 12 etapas."
    ],
    "nl": [
      "De Caravane des métiers gaat op weg om jongeren en werkzoekenden te ontmoeten! Van 23 maart tot 4 april 2026 zal de Caravane des métiers in 12 etappes door de regio Auvergne-Rhône-Alpes trekken."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Caravane des métiers 2026 • Cusset"
    ]
  },
