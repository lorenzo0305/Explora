  "rdfs:comment": {
    "de": [
      "Traditionelle Küche mit lokalen Produkten und ausschließlich\r\nmit saisonalen Produkten zubereitet. Vollständig hausgemachte Gerichte.\r\nRegionale Gerichte à la carte.\r\nNach vorheriger Reservierung.\r\nNeu: Terrasse."
    ],
    "en": [
      "Traditional cuisine using local produce and exclusively\r\nwith seasonal produce. Entirely homemade dishes.\r\nRegional dishes à la carte. \r\n\r\nReservations required."
    ],
    "it": [
      "Cucina tradizionale con prodotti locali ed esclusivamente\r\ncon prodotti di stagione. Piatti interamente fatti in casa.\r\nPiatti regionali alla carta.\r\nPrenotazione obbligatoria.\r\nNovità: terrazza."
    ],
    "fr": [
      "Cuisine traditionnelle avec des produits locaux et exclusivement\r\navec des produits de saison. Plats entièrement faits maison.\r\nPlats régionaux à la carte. \r\nSur réservation.\r\nNouveauté : Terrasse."
    ],
    "nl": [
      "Traditionele keuken met lokale producten en uitsluitend\r\nmet seizoensproducten. Volledig huisgemaakte gerechten.\r\nRegionale gerechten à la carte. \r\n\r\nReserveren noodzakelijk."
    ],
    "es": [
      "Cocina tradicional con productos locales y exclusivamente\r\ncon productos de temporada. Platos totalmente caseros.\r\nPlatos regionales a la carta.\r\nReserva previa.\r\nNovedad: Terraza."
    ]
  },
