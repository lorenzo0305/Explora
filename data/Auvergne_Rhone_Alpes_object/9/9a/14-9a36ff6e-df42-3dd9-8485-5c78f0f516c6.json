  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/9d35b557-7e44-346d-9357-3ac8da637d60",
      "dc:description": {
        "de": [
          "Entdecken Sie die Ausstellung 100% Bricks in der Salle Bertinchamps in Lens. Entdecken Sie auf über 2300m² zahlreiche Lego©-Welten, ein Muss für alle Fans der berühmten Bausteine"
        ],
        "en": [
          "Come and discover the 100% bricks exhibition at the Salle Bertinchamps in Lens. Discover a wide range of Lego© universes over 2300m², an unmissable event for fans of the famous bricks"
        ],
        "it": [
          "Venite a scoprire la mostra 100% mattoncini alla Salle Bertinchamps di Lens. Scoprite i tanti mondi di Lego© su 2300 m², un evento imperdibile per gli appassionati dei famosi mattoncini"
        ],
        "fr": [
          "Venez découvrir l’exposition 100% briques à la salle Bertinchamps à Lens. Découvrez de nombreux univers Lego© sur plus de 2300m², un RDV incontournable pour les fans des fameuses briques"
        ],
        "es": [
          "Venga a descubrir la exposición 100% ladrillos en la Salle Bertinchamps de Lens. Descubra los múltiples mundos de Lego© en 2.300 m², una cita ineludible para los fans de los famosos ladrillos"
        ],
        "nl": [
          "Kom en ontdek de 100% stenen tentoonstelling in de Salle Bertinchamps in Lens. Ontdek de vele werelden van Lego© op 2300m², een must voor fans van de beroemde stenen"
        ]
      },
