  "rdfs:comment": {
    "de": [
      "Die Kalksteinkuppen von Cesset sind ein idealer Aussichtspunkt, um das Land zu überblicken:\r\ndie weite Ebene in Richtung Saint-Pourçain, die Bocage in Richtung Fleurie und am Horizont die Vulkane der Auvergne!"
    ],
    "en": [
      "The limestone ridges of Cesset are an ideal vantage point from which to contemplate the countryside:\r\nits wide plain towards Saint-Pourçain, its bocage towards Fleurie! and, on the horizon, the Auvergne volcanoes!"
    ],
    "it": [
      "Le creste calcaree di Cesset sono un punto di osservazione ideale per contemplare la regione:\r\nl'ampia pianura verso Saint-Pourçain, i campi coltivati a siepe verso Fleurie e, all'orizzonte, i vulcani dell'Alvernia!"
    ],
    "fr": [
      "Les crêtes calcaires de Cesset sont un poste d'observation idéal pour contempler le pays :\r\nsa grande plaine vers Saint-Pourçain, son bocage vers Fleurie! et, à l'horizon, les volcans d'Auvergne !"
    ],
    "es": [
      "Las crestas calcáreas de Cesset son un mirador ideal para contemplar la región:\r\nsu amplia llanura hacia Saint-Pourçain, sus tierras de labranza cercadas hacia Fleurie y, en el horizonte, ¡los volcanes de Auvernia!"
    ],
    "nl": [
      "De kalksteenrichels van Cesset zijn een ideaal uitkijkpunt om de streek te bekijken:\r\nde uitgestrekte vlakte richting Saint-Pourçain, de omheinde landbouwgronden richting Fleurie en aan de horizon de vulkanen van de Auvergne!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les crêtes de Cesset - 7.5 km"
    ]
  },
