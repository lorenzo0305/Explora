  "rdfs:comment": {
    "de": [
      "Le Brize-Glace bietet einen Ort zum Teilen: mehrere Gruppen- oder Einzelbüros, einen Aktivitätsraum für Versammlungen oder Seminare. Es handelt sich um eine echte gemeinsame Nutzung von Arbeitsräumen."
    ],
    "en": [
      "Le Brize-Glace offers a place to share: several group or individual offices, an activity room for meetings or seminars. Genuine workspace sharing."
    ],
    "it": [
      "Le Brize-Glace offre uno spazio da condividere: diversi uffici collettivi o individuali, una sala attività per riunioni o seminari. Una vera e propria condivisione dello spazio di lavoro."
    ],
    "fr": [
      "Le Brize-Glace offre un lieu à partager: plusieurs bureaux collectifs ou individuels, une salle d'activité pour réunion ou séminaires . Véritable partage d'espaces de travail."
    ],
    "es": [
      "Le Brize-Glace ofrece un lugar para compartir: varios despachos colectivos o individuales, una sala de actividades para reuniones o seminarios. Un auténtico espacio de trabajo compartido."
    ],
    "nl": [
      "Le Brize-Glace biedt een plek om te delen: meerdere groeps- of individuele kantoren, een activiteitenruimte voor vergaderingen of seminars. Werkruimte delen."
    ]
  },
