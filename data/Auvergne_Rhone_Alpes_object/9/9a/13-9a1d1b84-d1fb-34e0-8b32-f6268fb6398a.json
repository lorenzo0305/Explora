  "rdfs:comment": {
    "de": [
      "Als Kunsthandwerker für Glasmalerei in Chouvigny biete ich Kreationen nach Maß (Verkleidung von Türen, Fenstern...), dekorative Kreationen und künstlerische Stücke (3D-Objekte, Rahmen, Hängeleuchten, Windlichter...) und auch Schnupperkurse an."
    ],
    "en": [
      "Stained-glass artist in Chouvigny, I offer custom-made creations (door and window coverings, transoms, etc.), decorative creations (lanterns, frames, hanging baskets, photophores, etc.) and I also offer introductory courses."
    ],
    "it": [
      "Artista del vetro colorato con sede a Chouvigny, propongo creazioni su misura (rivestimenti di porte e finestre, ecc.), creazioni decorative e pezzi artistici (oggetti 3D, cornici, cesti appesi, fotofore, ecc.), nonché corsi di introduzione."
    ],
    "fr": [
      "Artisan d'art vitrailliste sur Chouvigny, je propose des créations sur mesures (habillage de portes, fenêtres...) des créations décoratives et pièces artistique  (objets en 3D, cadres, suspensions, photophores...) et également des stages découverte."
    ],
    "es": [
      "Vidriero afincado en Chouvigny, ofrezco creaciones a medida (revestimientos de puertas y ventanas, etc.), creaciones decorativas y piezas artísticas (objetos 3D, marcos, cestas colgantes, fotóforos, etc.), así como cursos de iniciación."
    ],
    "nl": [
      "Als glas-in-loodkunstenaar gevestigd in Chouvigny, bied ik creaties op maat (deur- en raambekleding, enz.), decoratieve creaties en artistieke stukken (3D-objecten, kaders, hanging baskets, fotoforen, enz.), evenals inleidende cursussen."
    ]
  },
