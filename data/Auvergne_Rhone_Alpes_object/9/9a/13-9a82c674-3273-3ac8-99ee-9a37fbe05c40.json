  "rdfs:comment": {
    "de": [
      "Paragliding-Standort, Startbahn an der Loge des Gardes, Ankunft in La Chabanne.\r\nFür Menschen mit Behinderungen als autonomer Pilot zugänglich.\r\nAnerkannt vom französischen Freiflugverband.\r\nTaufe auf Reservierung."
    ],
    "ru": [
      "Площадка для парапланеризма, взлетная полоса у ложа Гард, прилет в Ла-Шабанн.\r\nДоступно для пилотов с ограниченными возможностями.\r\nПризнано Французской федерацией свободных полетов.\r\nНачало занятий по предварительной договоренности."
    ],
    "en": [
      "Paragliding site, take-off runway at the loge des gardes, arrival at La Chabanne\r\nAccessible to disabled pilots.\r\nRecognized by the French Free Flight Federation.\r\nBaptism on reservation."
    ],
    "it": [
      "Sito di parapendio, pista di decollo alla loge des gardes, arrivo a la Chabanne.\r\nAccessibile ai piloti disabili.\r\nRiconosciuto dalla Federazione francese di volo libero.\r\nIniziazione su prenotazione."
    ],
    "fr": [
      "Site de parapente, piste de décollage à la loge des gardes, arrivée à la Chabanne\r\nAccessible aux personnes handicapées en pilote autonome.\r\nReconnu par la fédération française de vol libre.\r\nBaptéme sur réservation obligatoire 48h avant."
    ],
    "zh": [
      "滑翔伞场地，起飞跑道位于 loge des gardes，抵达地点位于 la Chabanne。\r\n残疾飞行员也可使用。\r\n法国自由飞行联盟认可。\r\n事先安排启动。"
    ],
    "es": [
      "Sitio de parapente, pista de despegue en el loge des gardes, llegada en la Chabanne.\r\nAccesible a pilotos discapacitados.\r\nReconocido por la Federación Francesa de Vuelo Libre.\r\nIniciación previa concertación."
    ],
    "nl": [
      "Paraglidingterrein, startbaan bij de loge des gardes, aankomst bij la Chabanne\r\nToegankelijk voor gehandicapte piloten.\r\nErkend door de Franse federatie voor vrije vluchten.\r\nInitiatie op afspraak."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Laprugne vol libre"
    ]
  },
