  "rdfs:comment": {
    "de": [
      "Geführte Tour durch die Barockkirche in Les Allues. Architektur und Kunst des Barock, europäischer und lokaler historischer Kontext, polychrome und vergoldete Altarbilder, Gemälde und Fresken, die dargestellten Heiligen und ihre Geschichte, Restaurierungen."
    ],
    "en": [
      "Guided tour of the baroque church in Les Allues. Architecture and Baroque art, local and European historical context, polychrome and gilded altarpieces, paintings and frescoes, saints and their history, restorations."
    ],
    "it": [
      "Visita guidata alla chiesa barocca di Les Allues. Architettura e arte barocca, contesto storico locale ed europeo, pale d'altare policrome e dorate, dipinti e affreschi, santi rappresentati e loro storia, restauri."
    ],
    "fr": [
      "Visite guidée de l'eglise baroque des Allues. Architecture et art baroque, contexte historique européen et local,  retables polychromes et dorés, peintures et fresques, les saints representés et leur histoire, les restaurations."
    ],
    "es": [
      "Visita guiada a la iglesia barroca de Les Allues. Arquitectura y arte barrocos, contexto histórico local y europeo, retablos policromados y dorados, pinturas y frescos, los santos representados y su historia, restauraciones."
    ],
    "nl": [
      "Rondleiding door de barokkerk in Allues. Barokke architectuur en kunst, Europese en lokale historische context, polychrome en vergulde altaarstukken, schilderijen en fresco's, de vertegenwoordigde heiligen en hun geschiedenis, restauraties."
    ]
  },
  "rdfs:label": {
    "en": [
      "Visit the church in Les Allues"
    ],
    "fr": [
      "Visite de l'église des Allues"
    ],
    "nl": [
      "Bezoek aan de kerk in Les Allues"
    ]
  },
