  "rdfs:comment": {
    "de": [
      "Das Stadttheater liegt im Herzen des Dorfes. Es dient auch als Gemeindesaal, der den Vereinen der Gemeinde zur Verfügung steht."
    ],
    "en": [
      "Municipal theater nestled in the heart of the village. It hosts all live art shows but also serves as a municipal hall available to the associations of the town."
    ],
    "it": [
      "Teatro comunale situato nel cuore del paese. Ospita ogni tipo di spettacolo dal vivo ed è anche utilizzata come sala comunale dalle associazioni cittadine."
    ],
    "fr": [
      "Théâtre municipal niché au coeur du village. Il accueille tous spectacles d'art vivant mais fait aussi office de salle municipale à la disposition des associations de la commune."
    ],
    "es": [
      "Teatro municipal enclavado en el corazón del pueblo. Acoge todo tipo de actuaciones en directo y también es utilizado como sala municipal por las asociaciones de la ciudad."
    ],
    "nl": [
      "Stadsschouwburg in het hart van het dorp. Er vinden allerlei live optredens plaats en het wordt ook gebruikt als gemeentehuis door de verenigingen van de stad."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Théâtre l'Arbre en Scène"
