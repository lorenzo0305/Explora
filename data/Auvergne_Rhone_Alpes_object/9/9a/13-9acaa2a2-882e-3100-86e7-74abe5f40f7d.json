  "rdfs:comment": {
    "de": [
      "Entdecken Sie den See von Annecy und das Aravis-Massiv in aller Ruhe und Sicherheit von oben mit den Heißluftballons der Compagnie des Ballons."
    ],
    "en": [
      "Discover Lake Annecy and the Aravis massif from the air, in complete peace and safety, thanks to the hot-air balloons of Compagnie des Ballons."
    ],
    "it": [
      "Scoprite il lago di Annecy e il massiccio degli Aravis dall'alto, in tutta tranquillità e sicurezza, grazie alle mongolfiere della Compagnie des Ballons."
    ],
    "fr": [
      "Découvrez d'en haut le lac d'Annecy et le massif des Aravis en toute tranquillité et en toute sécurité grâce aux montgolfières de la Compagnie des Ballons."
    ],
    "nl": [
      "Ontdek het meer van Annecy en het Aravismassief in alle rust en veiligheid vanuit de lucht dankzij de luchtballonnen van de Compagnie des Ballons."
    ],
    "es": [
      "Descubra el lago de Annecy y el macizo de Aravis desde las alturas, con toda tranquilidad y seguridad, gracias a los globos aerostáticos de la Compagnie des Ballons."
    ]
  },
