  "rdfs:comment": {
    "de": [
      "Nach dem Erfolg von Julien Santini am vergangenen Wochenende setzt die Stadt Wingles ihr Kulturprogramm fort und begrüßt einen weiteren national bekannten Künstler auf der Bühne von Les Baladins."
    ],
    "en": [
      "Following the success of Julien Santini last weekend, the town of Wingles continues its cultural program by welcoming a new nationally-renowned artist to the Baladins stage."
    ],
    "it": [
      "Dopo il successo di Julien Santini lo scorso fine settimana, Wingles prosegue il suo programma culturale accogliendo sul palco del Baladins un nuovo artista di fama nazionale."
    ],
    "fr": [
      "Après le succès de Julien Santini le week-end dernier, la Ville de Wingles poursuit sa programmation culturelle en accueillant un nouvel artiste de renommée nationale sur la scène des Baladins."
    ],
    "es": [
      "Tras el éxito de Julien Santini el pasado fin de semana, Wingles prosigue su programa cultural acogiendo en el escenario de Baladins a un nuevo artista de renombre nacional."
    ],
    "nl": [
      "Na het succes van Julien Santini afgelopen weekend zet Wingles zijn culturele programma voort door een nieuwe artiest van nationale faam te verwelkomen op het podium van Baladins."
    ]
  },
