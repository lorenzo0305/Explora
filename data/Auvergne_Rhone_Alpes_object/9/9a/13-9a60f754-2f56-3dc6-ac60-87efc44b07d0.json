  "rdfs:comment": {
    "de": [
      "In der Fotografie können unterschiedliche Blickwinkel die Quelle malerischer oder skulpturaler Illusionen sein, indem sie die Anhaltspunkte und Grenzen zwischen innen und außen, zwischen Inhalt und Behältnis verwischen."
    ],
    "en": [
      "In photography, variations in viewing angles can be the source of pictorial or sculptural illusions, blurring the boundaries between inside and outside, between contents and containers."
    ],
    "it": [
      "In fotografia, le variazioni degli angoli di osservazione possono essere fonte di illusioni pittoriche o scultoree, confondendo i segni e i confini tra interno ed esterno, tra contenuto e contenitore."
    ],
    "fr": [
      "En photographie, les variations d'angles de vue peuvent être à la source d'illusions picturales ou sculpturales, en effaçant les repères et les limites entre intérieur et extérieur, entre contenus et contenants."
    ],
    "nl": [
      "In de fotografie kunnen variaties in kijkhoeken de bron zijn van picturale of sculpturale illusies, waarbij de markeringen en grenzen tussen binnen en buiten, tussen inhoud en containers vervagen."
    ],
    "es": [
      "En fotografía, las variaciones en los ángulos de visión pueden ser fuente de ilusiones pictóricas o escultóricas, difuminando las marcas y los límites entre interior y exterior, entre contenidos y contenedores."
    ]
  },
