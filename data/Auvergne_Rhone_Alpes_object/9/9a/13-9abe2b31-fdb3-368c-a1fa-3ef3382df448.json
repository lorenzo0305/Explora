  "rdfs:comment": {
    "de": [
      "Das Team des Saint Jo empfängt Sie in einem warmen und freundlichen Rahmen und bietet Ihnen eine traditionelle Savoyer Küche, die auf lokale Produzenten setzt."
    ],
    "en": [
      "Frédérique and Slo will welcome you in a cosy and friendly atmosphere. They will propose their tasty local cuisine."
    ],
    "it": [
      "Il team del Saint Jo vi dà il benvenuto in un ambiente caldo e accogliente, che serve una cucina tradizionale savoiarda con un'attenzione particolare ai produttori locali."
    ],
    "fr": [
      "L'équipe du Saint Jo vous accueille dans un cadre chaleureux et convivial et vous propose une cuisine traditionnelle Savoyarde qui fait la part belle aux producteurs locaux."
    ],
    "nl": [
      "Het Saint Jo team verwelkomt je in een warme en vriendelijke omgeving, waar traditionele Savoyaardse gerechten worden geserveerd met de nadruk op lokale producenten."
    ],
    "es": [
      "El equipo de Saint Jo le da la bienvenida en un ambiente cálido y acogedor, donde se sirve cocina tradicional saboyana centrada en los productores locales."
    ]
  },
