  "rdfs:comment": {
    "de": [
      "Gönnen Sie sich eine Wellness-Pause, allein oder zu zweit, mit einer Vielzahl von Behandlungen, die von Fachleuten durchgeführt werden, die Ihnen einen Moment der absoluten Flucht aus dem Alltag garantieren."
    ],
    "en": [
      "Treat yourself to a wellness break, alone or in pairs, with a variety of treatments provided by professionals who guarantee you the ultimate moment of escape."
    ],
    "it": [
      "Concedetevi una pausa di benessere, da soli o in coppia, grazie a una varietà di trattamenti forniti da professionisti che vi garantiscono il massimo momento di evasione."
    ],
    "fr": [
      "Accordez-vous une pause bien-être, seul ou à deux, grâce à une variété de soins prodigués par des professionnels qui vous garantissent un moment d’évasion le plus absolu."
    ],
    "nl": [
      "Trakteer jezelf op een wellnessvakantie, alleen of met een partner, dankzij de verschillende behandelingen door professionals die je het ultieme moment van ontsnapping garanderen."
    ],
    "es": [
      "Regálese una escapada de bienestar, solo o en pareja, con una variedad de tratamientos proporcionados por profesionales que le garantizan el más absoluto momento de evasión."
    ]
  },
