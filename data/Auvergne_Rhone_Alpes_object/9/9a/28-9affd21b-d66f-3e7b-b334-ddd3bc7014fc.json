  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/32abb795-5f91-3726-9f51-0c94cc8239d2",
      "dc:description": {
        "de": [
          "Karnevalskünstlerin, Aquarellistin, Pastellistin, Malerin.\nErzählen von Lebensabschnitten, Momenten der Begegnung, des Austauschs oder der Kontemplation, von Stimmungen, Landschaften und Lichtern."
        ],
        "en": [
          "Carnetist, watercolorist, pastelist, painter.\nTelling slices of life, moments of encounters, sharing or contemplation, atmospheres, landscapes and lights."
        ],
        "it": [
          "Carnettista, acquerellista, pastellista, pittore.\nRaccontare spaccati di vita, momenti di incontro, condivisione o contemplazione, atmosfere, paesaggi e luci."
        ],
        "fr": [
          "Carnetiste, aquarelliste, pastelliste, peintre.\nRaconter des tranches de vies, des moments de rencontres, de partages ou de contemplations, des ambiances, des paysages et des lumières."
        ],
        "es": [
          "Carnetista, acuarelista, pastelista, pintor.\nRelato de retazos de vida, momentos de encuentro, convivencia o contemplación, atmósferas, paisajes y luces."
        ],
        "nl": [
          "Carnetist, aquarellist, pastellist, schilder.\nHet vertellen van stukjes leven, momenten van ontmoeting, delen of overdenken, sferen, landschappen en licht."
        ]
      },
