  "rdfs:comment": {
    "de": [
      "Die GAEC du Velay 2 verkauft Linsen und Freilandeier direkt auf dem Hof\r\naber auch auf den Märkten von Saugues am Freitag und Langeac am Donnerstag"
    ],
    "en": [
      "The GAEC du Velay 2 sells lentils and free-range eggs direct from the farm\r\nbut also at the Saugues market on Fridays and the Langeac market on Thursdays"
    ],
    "it": [
      "Il GAEC du Velay 2 vende lenticchie e uova di fattoria direttamente dall'azienda agricola\r\nma anche al mercato di Saugues il venerdì e al mercato di Langeac il giovedì"
    ],
    "fr": [
      "Le GAEC du Velay 2  vend en direct à la ferme des lentilles et des œufs fermier\r\nmais aussi sur les marchés de Saugues le vendredi et Langeac le jeudi"
    ],
    "es": [
      "El GAEC du Velay 2 vende lentejas y huevos de granja directamente en la granja\r\npero también en el mercado de Saugues los viernes y en el de Langeac los jueves"
    ],
    "nl": [
      "De GAEC du Velay 2 verkoopt linzen en eieren rechtstreeks van de boerderij\r\nmaar ook op de markt van Saugues op vrijdag en de markt van Langeac op donderdag"
    ]
  },
  "rdfs:label": {
    "fr": [
      "GAEC Du Velay 2 | Cayres"
    ]
  },
