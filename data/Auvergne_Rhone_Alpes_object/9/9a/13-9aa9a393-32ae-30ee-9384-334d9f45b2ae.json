  "rdfs:comment": {
    "de": [
      "Diese Kapelle im neuromanischen Stil wurde zwischen 1867 und 1868 von dem Vichyser Architekten Hugues Batilliat parallel zum Bau der neuen Pfarrkirche Saint-Saturnin errichtet."
    ],
    "en": [
      "This neo-Romanesque style chapel was built between 1867 and 1868 by the Vichyssois architect Hugues Batilliat in parallel with the construction of the new parish church of Saint-Saturnin."
    ],
    "it": [
      "Questa cappella neoromanica fu costruita tra il 1867 e il 1868 dall'architetto di Vichy Hugues Batilliat, parallelamente alla costruzione della nuova chiesa parrocchiale di Saint-Saturnin."
    ],
    "fr": [
      "Cette chapelle  de style néo-roman a été construite entre 1867 et 1868 par l’architecte vichyssois Hugues Batilliat en parallèle de la construction de la nouvelle église paroissiale Saint-Saturnin."
    ],
    "es": [
      "Esta capilla neorrománica fue construida entre 1867 y 1868 por el arquitecto de Vichy Hugues Batilliat en paralelo a la construcción de la nueva iglesia parroquial de Saint-Saturnin."
    ],
    "nl": [
      "Deze neoromaanse kapel werd tussen 1867 en 1868 gebouwd door de Vichy-architect Hugues Batilliat, tegelijk met de bouw van de nieuwe parochiekerk van Saint-Saturnin."
    ]
  },
  "rdfs:label": {
