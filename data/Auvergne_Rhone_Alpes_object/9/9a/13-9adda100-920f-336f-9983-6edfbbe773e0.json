  "rdfs:comment": {
    "de": [
      "Im Herzen von La Norma bieten wir Ihnen hausgemachte Speisen, Burger, Suppen, Salate, savoyische Spezialitäten, Sandwiches mit frischen und lokalen Produkten, vor Ort oder zum Mitnehmen."
    ],
    "en": [
      "In the heart of La Norma, we offer home-cooked meals, burgers, soups, salads, Savoyard specialities and sandwiches made with fresh, local produce, on the premises or to take away."
    ],
    "it": [
      "Nel cuore di La Norma, offriamo pasti casalinghi, hamburger, zuppe, insalate, specialità savoiarde e panini preparati con prodotti freschi e locali, da mangiare o da portare via."
    ],
    "fr": [
      "En plein cœur de La Norma, nous vous proposons une restauration maison, burgers, soupes, salades, spécialités savoyardes, sandwichs avec des produits frais et locaux, sur place ou à emporter."
    ],
    "nl": [
      "In het hart van La Norma bieden we huisgemaakte maaltijden, hamburgers, soepen, salades, Savoyaardse specialiteiten en sandwiches gemaakt met verse, lokale producten, om te eten of mee te nemen."
    ],
    "es": [
      "En pleno corazón de La Norma, le ofrecemos comida casera, hamburguesas, sopas, ensaladas, especialidades de Saboya y bocadillos elaborados con productos frescos y locales, para comer en casa o para llevar."
    ]
  },
  "rdfs:label": {
