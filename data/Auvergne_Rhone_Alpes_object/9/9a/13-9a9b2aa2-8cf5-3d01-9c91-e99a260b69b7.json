  "rdfs:comment": {
    "de": [
      "Genießen Sie in einem außergewöhnlichen Rahmen, drinnen oder auf der Terrasse, die bistronomische Küche des Restaurants Le Clos Syrah in Valence, das nur 5 Minuten vom Stadtzentrum von Valence entfernt liegt."
    ],
    "en": [
      "In an exceptional setting, indoors or on the terrace, enjoy the bistronomic cuisine of the restaurant Le Clos Syrah in Valence, located just 5 minutes from the city center of Valence."
    ],
    "it": [
      "In un ambiente eccezionale, all'interno o sulla terrazza, assaporate la cucina bistronomica del ristorante Le Clos Syrah di Valence, a soli 5 minuti dal centro di Valence."
    ],
    "fr": [
      "Dans un cadre exceptionnel, à l’intérieur ou en terrasse, savourez la cuisine bistronomique du restaurant Le Clos Syrah à Valence, situé à 5 minutes seulement du centre ville de Valence."
    ],
    "nl": [
      "Geniet in een uitzonderlijke omgeving, binnen of op het terras, van de bistronomische keuken van restaurant Le Clos Syrah in Valence, op slechts 5 minuten van het centrum van Valence."
    ],
    "es": [
      "En un marco excepcional, en el interior o en la terraza, saboree la cocina bistronómica del restaurante Le Clos Syrah en Valence, a 5 minutos del centro de la ciudad de Valence."
    ]
  },
  "rdfs:label": {
