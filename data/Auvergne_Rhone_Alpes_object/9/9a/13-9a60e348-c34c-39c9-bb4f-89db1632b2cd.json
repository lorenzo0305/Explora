  "rdfs:comment": {
    "de": [
      "In einem charmanten Gebäude befindet sich ein Saal mit Bar und eine 2019 renovierte Einbauküche. Großer geschlossener Hof mit Vorplatz, der es ermöglicht, an schönen Tagen einen Aperitif im Freien zu genießen, Parkplatz in der Nähe."
    ],
    "en": [
      "In a charming building, a room with bar and a fully equipped kitchen renovated in 2019. Large enclosed courtyard with covered area for outdoor aperitifs on sunny days, parking nearby."
    ],
    "it": [
      "In un edificio di charme, locale con bar e cucina attrezzata ristrutturata nel 2019. Ampio cortile recintato con area coperta per aperitivi all'aperto nelle giornate di sole, parcheggio nelle vicinanze."
    ],
    "fr": [
      "Dans un bâtiment de charme, une salle avec bar et une cuisine équipée rénovée en 2019. Grande cour fermée avec préau permettant de faire un apéro à l'extérieur aux beaux jours, parking à proximité."
    ],
    "nl": [
      "In een charmant gebouw, een zaal met een bar en een ingerichte keuken gerenoveerd in 2019. Grote afgesloten binnenplaats met overdekte ruimte om buiten te aperitieven op zonnige dagen, parkeerplaats in de buurt."
    ],
    "es": [
      "En un edificio con encanto, una sala con bar y cocina equipada renovada en 2019. Gran patio cerrado con zona cubierta para aperitivos al aire libre en los días soleados, aparcamiento cercano."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Salle à louer - Salle des fêtes"
    ]
  },
