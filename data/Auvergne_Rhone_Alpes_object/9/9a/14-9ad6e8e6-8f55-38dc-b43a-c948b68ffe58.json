  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/086166a1-1f61-3c77-b334-0730f5e2f515",
      "dc:description": {
        "de": [
          "Ausstellung von Skulpturen, die von Jocelyne Vaunaize Dupuis entworfen wurden, vom 17. Mai bis zum 2. Juni 2024 bei Causettes (50 rue Carnot)\nVernissage am 17. Mai um 18 Uhr in der Designerboutique / Teestube Causettes.\n\nWeitere Informationen über die Künstlerin Jocelyne Vaunaize Dupuis :auf ihrer Facebook-Seite"
        ],
        "en": [
          "Exhibition of sculptures designed by Jocelyne Vaunaize Dupuis from May 17 to June 2, 2024 at Causettes (50 rue Carnot)\nOpening May 17 at 6pm at the Causettes designer boutique/tea room.\n\nMore information on artist Jocelyne Vaunaize Dupuis: on her facebook page"
        ],
        "it": [
          "Mostra di sculture progettate da Jocelyne Vaunaize Dupuis dal 17 maggio al 2 giugno 2024 presso Causettes (50 rue Carnot)\nInaugurazione il 17 maggio alle 18.00 presso la boutique/tea Causettes.\n\nMaggiori informazioni sull'artista Jocelyne Vaunaize Dupuis: sulla sua pagina facebook"
        ],
        "fr": [
          "Exposition de sculptures conçues par Jocelyne Vaunaize Dupuis du 17 mai au 2 juin 2024 chez Causettes (50 rue Carnot)\nVernissage le 17 mai à 18h à la boutique de créateurs / salon de thé Causettes.\n\nPlus d'informations sur l'artiste Jocelyne Vaunaize Dupuis :sur sa page facebook"
        ],
        "nl": [
          "Tentoonstelling van beeldhouwwerken ontworpen door Jocelyne Vaunaize Dupuis van 17 mei tot 2 juni 2024 bij Causettes (50 rue Carnot)\nOpening op 17 mei om 18.00 uur in de Causettes designer boutique/tea room.\n\nMeer informatie over de kunstenaar Jocelyne Vaunaize Dupuis: op haar facebook pagina"
        ],
        "es": [
          "Exposición de esculturas diseñadas por Jocelyne Vaunaize Dupuis del 17 de mayo al 2 de junio de 2024 en Causettes (50 rue Carnot)\nInauguración el 17 de mayo a las 18.00 h en la boutique de diseño/salón de té Causettes.\n\nMás información sobre la artista Jocelyne Vaunaize Dupuis: en su página de facebook"
        ]
      },
