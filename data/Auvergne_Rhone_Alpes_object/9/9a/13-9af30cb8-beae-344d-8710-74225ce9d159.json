  "rdfs:comment": {
    "de": [
      "Legen Sie sich in dieses bequeme Seil, um bei Einbruch der Dunkelheit die Sterne zu beobachten, und lassen Sie sich von einer bezaubernden Stimme den Himmel erzählen."
    ],
    "en": [
      "Stretch out in this comfortable rope to watch the stars at nightfall, and let a spellbinding voice tell you all about the sky."
    ],
    "it": [
      "Stendetevi in questa comoda corda per osservare le stelle al calar del sole e lasciate che una voce incantata vi racconti tutto sul cielo."
    ],
    "fr": [
      "Allongez-vous dans ce cordage confortable pour observer les étoiles à la nuit tombée, et laissez-vous conter le ciel par une voie envoutante."
    ],
    "es": [
      "Túmbate en esta cómoda cuerda para contemplar las estrellas al anochecer y deja que una voz hechizante te lo cuente todo sobre el cielo."
    ],
    "nl": [
      "Strek je uit in dit comfortabele touw om naar de sterren te kijken bij het vallen van de avond en laat een betoverende stem je alles vertellen over de hemel."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Astronomie - Un hamac sous les étoiles"
    ]
  },
