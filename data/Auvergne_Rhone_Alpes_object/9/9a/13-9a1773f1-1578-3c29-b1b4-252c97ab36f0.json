  "rdfs:comment": {
    "de": [
      "Entspannungen und Meditationen, Klangtherapie mit individuellen Klangmassagen und Klangreisen, individuelle Reiki-Sitzungen, kollektives Wellness-Wochenende und Qi Gong-Kurse für Anfänger bis Fortgeschrittene, FFAEMC-zertifiziert."
    ],
    "en": [
      "Relaxation and meditation, sound therapy with individual sound massages and sound journeys, individual Reiki sessions, group wellness weekends and FFAEMC-certified Qi Gong courses for beginners to advanced."
    ],
    "it": [
      "Rilassamento e meditazione, terapia del suono con massaggi sonori individuali e viaggi sonori, sessioni individuali di Reiki, weekend di benessere di gruppo e corsi di Qi Gong certificati FFAEMC per principianti e avanzati."
    ],
    "fr": [
      "Relaxations et méditations, sonothérapie avec massages sonores individuels et voyages sonores, séances individuelles de Reiki, week-end bien-être collectif et cours de Qi Gong débutants à confirmés, certifiés FFAEMC."
    ],
    "es": [
      "Relajación y meditación, terapia de sonido con masajes sonoros individuales y viajes sonoros, sesiones individuales de Reiki, fines de semana de bienestar en grupo y cursos de Qi Gong certificados por la FFAEMC para principiantes y avanzados."
    ],
    "nl": [
      "Ontspanning en meditatie, klanktherapie met individuele klankmassages en klankreizen, individuele Reiki sessies, welzijnsweekenden in groepsverband en FFAEMC-gecertificeerde Qi Gong cursussen voor beginners tot gevorderden."
    ]
  },
