  "rdfs:comment": {
    "de": [
      "Der Espace Vauban liegt in der Gemeinde Le Coteau, 1 Stunde von Lyon, 1 Stunde von Clermont-Ferrand und 45 Minuten von Saint-Étienne entfernt, und ist der ideale Ort für Ihre Veranstaltungen. Heller und angenehmer Saal von 150 m² mit einem Außenbereich von 250 m²."
    ],
    "en": [
      "Located in the commune of Le Coteau, 1h from Lyon, 1h from Clermont-Ferrand and 45 min from Saint-Étienne, Espace Vauban is the ideal venue for your events. Bright, pleasant 150 m² room with 250 m² outdoor space."
    ],
    "it": [
      "Situato a Le Coteau, a 1 ora da Lione, 1 ora da Clermont-Ferrand e 45 minuti da Saint-Étienne, l'Espace Vauban è il luogo ideale per i vostri eventi. Una sala luminosa e piacevole di 150 m² con uno spazio esterno di 250 m²."
    ],
    "fr": [
      "Situé sur la commune du Coteau à 1h de Lyon, 1h de Clermont-Ferrand et 45 min de Saint-Étienne, l'espace Vauban est le lieu idéal pour vos évènements. Salle lumineuse et agréable de 150 m² avec un espace extérieur de 250 m²."
    ],
    "es": [
      "Situado en Le Coteau, a 1 hora de Lyon, 1 hora de Clermont-Ferrand y 45 minutos de Saint-Étienne, el Espace Vauban es el lugar ideal para sus eventos. Una sala luminosa y agradable de 150 m² con un espacio exterior de 250 m²."
    ],
    "nl": [
      "Gelegen in Le Coteau, op 1 uur van Lyon, 1 uur van Clermont-Ferrand en 45 minuten van Saint-Étienne, is Espace Vauban de ideale locatie voor uw evenementen. Een lichte, aangename ruimte van 150 m² met een buitenruimte van 250 m²."
    ]
  },
