  "rdfs:comment": {
    "de": [
      "Café-Theater, das sich seit 1990 auf den Hängen des Croix-Rousse befindet. In seinen zwei Sälen tanken die Zuschauer Lachen und gehen entspannt und verzaubert von der Gastfreundschaft der ansässigen Theatergruppe nach Hause."
    ],
    "en": [
      "A theatre-café located on the slopes of Croix-Rousse since 1990. It boasts two theatres where spectators can laugh to their heart's content and come away feeling relaxed, having been captivated by the resident theatre group's performance."
    ],
    "it": [
      "Café-théâtre alle pendici della Croix-Rousse dal 1990. Nei suoi due teatri, gli spettatori fanno il pieno di risate e se ne vanno rilassati e affascinati dall'accoglienza della troupe residente."
    ],
    "fr": [
      "Café-théâtre situé sur les pentes de la Croix-Rousse depuis 1990. Dans ses deux salles, les spectateurs font le plein de rire et repartent détendus et charmés par l'accueil de la troupe résidente."
    ],
    "nl": [
      "Café-théâtre op de hellingen van de Croix-Rousse sinds 1990. In de twee zalen komen de toeschouwers aan hun trekken en vertrekken ze ontspannen en gecharmeerd door de ontvangst van het gezelschap."
    ],
    "es": [
      "Café teatro en las laderas de la Croix-Rousse desde 1990. En sus dos teatros, los espectadores se ríen a carcajadas y se van relajados y encantados por la acogida de la compañía residente."
    ]
  },
