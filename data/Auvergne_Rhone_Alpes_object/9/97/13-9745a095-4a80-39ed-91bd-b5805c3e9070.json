  "rdfs:comment": {
    "de": [
      "Céline und Nicolas sind Eigentümer und Winzer und bewirtschaften 5,5 ha in den Crus Chénas, Juliénas und Moulin-à-Vent. Sie lieben das Beaujolais und sind leidenschaftliche Weinliebhaber. Bei einer Weinprobe auf dem Weingut können Sie den Reichtum der großen Terroirs entdecken."
    ],
    "en": [
      "Owner-vinegrower-winemakers, Céline and Nicolas work 5,5 ha in the Cru areas of Chénas, Juliénas and Moulin-à-Vent. They work their vines in respect for the environment. Their wines are the reflection of their exceptional terroirs and bring you a wide palette of aromas and flavours; from fruity and lip-smacking to well-built and spicy. Passionate about Beaujolais, a tasting in their cellar will unveil the wealth of great terroirs to you."
    ],
    "it": [
      "Céline e Nicolas, proprietari-coltivatori, coltivano 5,5 ettari nei cru Chénas, Juliénas e Moulin-à-Vent. Appassionati del Beaujolais, la degustazione presso la tenuta vi permetterà di scoprire la ricchezza dei grandi terroir."
    ],
    "fr": [
      "Céline et Nicolas, propriétaires-récoltants, exploitent 5,5 ha sur les crus de Chénas, Juliénas et Moulin-à-Vent. Amoureux du Beaujolais et passionnés, la dégustation au domaine vous permettra de découvrir la richesse de grands terroirs."
    ],
    "es": [
      "Céline y Nicolas, propietarios-cosechadores, cultivan 5,5 hectáreas en los crus Chénas, Juliénas y Moulin-à-Vent. Apasionados del Beaujolais, la degustación en la finca le permitirá descubrir la riqueza de los grandes terruños."
    ],
    "nl": [
      "Céline en Nicolas, eigenaars-oogsters, bewerken 5,5 hectare in de crus Chénas, Juliénas en Moulin-à-Vent. Liefhebbers van de Beaujolais kunnen tijdens de proeverij op het domein de rijkdom van de grote terroirs ontdekken."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Domaine Hirsch"
    ]
  },
