  "rdfs:comment": {
    "de": [
      "Granith, die gastronomische Übereinstimmung ohne Alkohol.\r\nGlückliche Nüchternheit in der Gastronomie.\r\nUnsere Mission ist es, diejenigen, die keinen Alkohol wünschen, wieder in den Mittelpunkt des Tisches zu stellen."
    ],
    "en": [
      "Happy sobriety in gastronomy"
    ],
    "it": [
      "Granith, l'abbinamento gastronomico senza alcol.\r\nBuona sobrietà in gastronomia.\r\nLa nostra missione è quella di rimettere al centro della tavola chi non vuole l'alcol."
    ],
    "fr": [
      "Granith, l'accord gastronomique sans l'alcool. \r\nLa sobriété heureuse en gastronomie.\r\nNotre mission est de replacer au centre de la table, celles et ceux qui ne souhaitent pas d'alcool."
    ],
    "es": [
      "Granith, el maridaje gastronómico sin alcohol.\r\nFeliz sobriedad en la gastronomía.\r\nNuestra misión es volver a poner en el centro de la mesa a los que no quieren alcohol."
    ],
    "nl": [
      "Granith, de gastronomische wedstrijd zonder alcohol.\r\nGelukkige soberheid in de gastronomie.\r\nOnze missie is om mensen die geen alcohol willen weer centraal te stellen aan tafel."
    ]
  },
