  "rdfs:comment": {
    "de": [
      "Anlässlich der Europäischen Tage der Kunsthandwerke 2026 lädt die Stadt Romans die Öffentlichkeit ein, an einem symbolträchtigen Ort, dem Schuhmuseum, in das Herz der handwerklichen Kreation einzutauchen."
    ],
    "en": [
      "On the occasion of the Journées Européennes des Métiers d?Art 2026 , the City of Romans invites the public to experience a unique immersion in the heart of artisan creation, in an emblematic venue: the Musée de la Chaussure."
    ],
    "it": [
      "In occasione delle Giornate europee dell'artigianato 2026, la città di Romans invita il pubblico a vivere un'immersione unica nel cuore della creazione artigianale, in un luogo emblematico: il Musée de la Chaussure."
    ],
    "fr": [
      "À l’occasion des Journées Européennes des Métiers d’Art 2026 , la Ville de Romans invite le public à vivre une immersion unique au cœur de la création artisanale, dans un lieu emblématique : le Musée de la Chaussure."
    ],
    "nl": [
      "Ter gelegenheid van de Europese Dagen van het Ambacht 2026 nodigt de stad Rome het publiek uit voor een unieke onderdompeling in het hart van de ambachtelijke creatie, op een emblematische locatie: het Musée de la Chaussure."
    ],
    "es": [
      "Con motivo de los Días Europeos de la Artesanía 2026, la ciudad de Romans invita al público a vivir una inmersión única en el corazón de la creación artesanal, en un lugar emblemático: el Museo de la Chaussure."
    ]
  },
