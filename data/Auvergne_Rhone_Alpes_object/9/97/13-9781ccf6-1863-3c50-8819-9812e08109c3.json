  "rdfs:comment": {
    "de": [
      "Das Künstlerdorf Marols lädt Sie ein, das Know-how von Malern, Plastik Künstlern und Bildhauern zu entdecken, die ihre Werkstätten für Demonstrationen und Ausstellungen."
    ],
    "en": [
      "The artists' village of Marols invites you to discover the know-how of painters, plastic artists and sculptors who open their workshops for demonstrations and exhibitions."
    ],
    "it": [
      "Pittori, scultori, artisti visivi, fotografi e gioiellieri vivono e lavorano nel cuore di questo magnifico villaggio di carattere. Aprono le porte dei loro studi e vi accolgono durante tutto l'anno, su richiesta."
    ],
    "fr": [
      "Au cœur de ce magnifique village de caractère, vivent et travaillent des peintres, sculpteurs, plasticiens, photographes, bijoutiers. Ils vous ouvrent les portes de leurs ateliers et vous accueillent tout au long de l'année, et sur simple demande."
    ],
    "es": [
      "Pintores, escultores, artistas plásticos, fotógrafos y joyeros viven y trabajan en el corazón de este magnífico pueblo con carácter. Le abren las puertas de sus estudios y le reciben durante todo el año, previa petición."
    ],
    "nl": [
      "In het hart van dit prachtige karaktervolle dorp wonen en werken schilders, beeldhouwers, beeldend kunstenaars, fotografen en juweliers. Ze openen de deuren van hun ateliers en verwelkomen je het hele jaar door, op aanvraag."
    ]
  },
