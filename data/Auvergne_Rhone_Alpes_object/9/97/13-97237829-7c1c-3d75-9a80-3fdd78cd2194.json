  "rdfs:comment": {
    "de": [
      "Direkt am Strand von Sougey am Ufer des Lac d'Aiguebelette können Sie ein Tretboot mit Rutsche, ein Kajak oder Kanu oder ein Stand up Paddle einfach, duo oder big paddle (6-8 Plätze) mieten."
    ],
    "en": [
      "Directly on the Sougey Beach, on the edge of the lake of Aiguebelette, rent your pedalo with slide, kayak, canoë, paddleboard (simple, duo or big paddle (6-8 places))."
    ],
    "it": [
      "Direttamente sulla spiaggia di Sougey, sulle rive del lago di Aiguebelette, noleggiate un pedalò con scivolo, un kayak o una canoa, oppure uno stand-up paddle singolo, doppio o grande (6-8 posti)."
    ],
    "fr": [
      "Directement sur la plage du Sougey, au bord du lac d'Aiguebelette, louez un pédalo avec toboggan, un kayak ou un canoë, ou un stand up paddle simple, duo ou big paddle (6-8 places)."
    ],
    "es": [
      "Directamente en la playa de Sougey, a orillas del lago Aiguebelette, alquile un pedaló con tobogán, un kayak o una canoa, o un stand-up paddle individual, dúo o grande (6-8 plazas)."
    ],
    "nl": [
      "Direct aan het strand van Sougey, aan de oevers van het meer van Aiguebelette, kun je een waterfiets met glijbaan, een kajak of kano, of een enkele, dubbele of grote stand-up paddle huren (6-8 plaatsen)."
    ]
  },
