  "rdfs:comment": {
    "de": [
      "Der Grand Temple, der heutige Tempel von Bourdeaux, der größte des Departements, wurde 1806 fertiggestellt. Es handelt sich um eine alte Kirche, die im 18. Jahrhundert begonnen und nie fertiggestellt wurde, was zeigt, wie schwierig die katholische Rückeroberung in diesem Tal war."
    ],
    "en": [
      "The Great Temple is the actual temple of Bourdeaux. It is the largest temple of the department. Completed in 1806, it is a former church started started during the 18th century and never finished which proves the difficulty for Catholics to win back the valley."
    ],
    "it": [
      "Il Grand Temple, l'attuale tempio di Bourdeaux, il più grande del dipartimento, completato nel 1806, è un'antica chiesa iniziata nel XVIII secolo e mai terminata, a dimostrazione delle difficoltà che la riconquista cattolica incontrò in questa valle."
    ],
    "fr": [
      "Le Grand Temple, actuel temple de Bourdeaux, le plus vaste du département, achevé en 1806, est une ancienne église commencée au 18ème siècle et jamais terminée, ce qui montre bien la difficulté qu'a rencontrée la reconquête catholique dans cette vallée."
    ],
    "es": [
      "El Gran Templo, actual templo de Burdeos, el más grande del departamento, terminado en 1806, es una antigua iglesia iniciada en el siglo XVIII y nunca terminada, lo que demuestra la dificultad que encontró la reconquista católica en este valle."
    ],
    "nl": [
      "De Grand Temple, de huidige tempel in Bourdeaux, de grootste van het departement, voltooid in 1806, is een oude kerk waaraan in de 18e eeuw werd begonnen maar die nooit werd afgebouwd, wat duidelijk de moeilijkheden laat zien die de katholieke herovering in deze vallei ondervond."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Temple de Bourdeaux"
    ]
