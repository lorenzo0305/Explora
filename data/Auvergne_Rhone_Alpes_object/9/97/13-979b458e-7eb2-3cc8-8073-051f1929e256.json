  "rdfs:comment": {
    "de": [
      "Entdecken Sie unser neues Indoor-Zentrum! Paintball und Laser Game für die ganze Familie. Kinder ab 7 Jahren sind willkommen. Partys, EVG/EVJF, Seminare. Spielen Sie bei jedem Wetter!"
    ],
    "en": [
      "Discover our new indoor center! Paintball and Laser Game for the whole family. Children aged 7 and over welcome. Parties, EVG/EVJF, seminars. Play in all weathers!"
    ],
