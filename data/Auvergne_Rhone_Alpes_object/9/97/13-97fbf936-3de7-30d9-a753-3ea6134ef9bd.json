  "rdfs:comment": {
    "de": [
      "Achtung, ein Ereignis! Le Carton Comedy, der größte fahrende Comedy-Club Frankreichs, kommt endlich nach Cusset, um einen verrückten Stand-up-Abend mit der Crème de la Crème der Humoristen aus dem ganzen Land zu veranstalten."
    ],
    "en": [
      "Attention, event! Le Carton Comedy, France's biggest traveling comedy club, is finally coming to Cusset for an evening of stand-up madness featuring the cream of the country's comedians."
    ],
    "it": [
      "Attenzione, evento! Le Carton Comedy, il più grande club comico itinerante di Francia, arriva finalmente a Cusset per una folle serata di stand-up con i migliori comici di tutto il paese."
    ],
    "fr": [
      "Attention, événement ! Le Carton Comedy, le plus grand comedy club itinérant de France, débarque enfin à Cusset pour une soirée stand-up de folie avec la crème des humoristes de tout le pays."
    ],
    "es": [
      "¡Atención, evento! Le Carton Comedy, el club de la comedia itinerante más grande de Francia, llega por fin a Cusset para una noche loca de stand-up con los mejores cómicos de todo el país."
    ],
    "nl": [
      "Attentie, evenement! Le Carton Comedy, de grootste reizende comedyclub van Frankrijk, komt eindelijk naar Cusset voor een knotsgekke stand-upavond met de beste komieken uit het hele land."
    ]
  },
  "rdfs:label": {
