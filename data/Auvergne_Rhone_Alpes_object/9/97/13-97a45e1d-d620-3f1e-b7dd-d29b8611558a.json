  "rdfs:comment": {
    "de": [
      "Legen Sie Ihre Stollenschuhe unter den Tisch und probieren Sie die Inbrunst des Chaudron.\r\nDie Brasserie Geoffroy-Guichard bietet ein einzigartiges Erlebnis für Fußballfans und Nicht-Fußballfans."
    ],
    "en": [
      "This brasserie was born in the heart of the legendary Geoffroy-Guichard stadium. \r\nWith a surface area of 450 m², the restaurant has a terrace of hundreds of m² and a large bay window overlooking the stadium... enough to delight fans!"
    ],
    "it": [
      "Mettete gli scarpini sotto il tavolo e godetevi il fervore dello Chaudron.\r\nLa Brasserie Geoffroy-Guichard offre un'esperienza unica per gli appassionati di calcio e non."
    ],
    "fr": [
      "Posez vos crampons sous la table et goûtez à la ferveur du Chaudron.\r\nLa Brasserie Geoffroy-Guichard offre une expérience unique, pour les fans de foot ou non."
    ],
    "nl": [
      "Zet je schoenen onder tafel en geniet van het elan van de Chaudron.\r\nDe Brasserie Geoffroy-Guichard biedt een unieke ervaring voor zowel voetbalfans als niet-fans."
    ],
    "es": [
      "Ponga las botas debajo de la mesa y disfrute del fervor del Chaudron.\r\nLa Brasserie Geoffroy-Guichard ofrece una experiencia única a los aficionados y no aficionados al fútbol."
    ]
  },
  "rdfs:label": {
    "en": [
      "Brasserie Geoffroy-Guichard"
    ],
    "fr": [
      "Brasserie Geoffroy-Guichard"
    ]
  },
