  "rdfs:comment": {
    "de": [
      "De juin à septembre, notre food truck vous propose une petite restauration forézienne les midis et des planches apéritif en soirée.\r\nVenez entre amis, en famille, entre collègues, la pause est ici."
    ],
    "en": [
      "From June to September, La Caravane de Goutelas welcomes you to its terraces, offering light meals from the Forez region, sharing platters, drinks and homemade ice cream. A 100% local bistro, accessible with or without a reservation."
    ],
    "it": [
      "Da giugno a settembre, La Caravane de Goutelas vi accoglie sulle sue terrazze, dove potrete gustare spuntini in stile Forézienne, taglieri da condividere, bevande e gelati fatti in casa. Un bistrot 100% locale, disponibile con o senza prenotazione."
    ],
    "fr": [
      "De juin à septembre, La Caravane de Goutelas vous accueille sur les terrasses : petite restauration forézienne, planches à partager, boissons et glaces artisanales. Un bistrot 100% local, accessible avec ou sans réservation."
    ],
    "nl": [
      "Van juni tot september verwelkomt La Caravane de Goutelas je op zijn terrassen, waar je kunt genieten van hapjes in Forézienne-stijl, planken om te delen, drankjes en huisgemaakt ijs. Een 100% lokale bistro, beschikbaar met of zonder reservering."
    ],
    "es": [
      "De junio a septiembre, La Caravane de Goutelas le da la bienvenida en sus terrazas, donde podrá degustar aperitivos al estilo forezienne, tablas para compartir, bebidas y helados caseros. Un bistró 100% local, disponible con o sin reserva."
    ]
  },
  "rdfs:label": {
    "de": [
      "La Caravane - Bistrot d'été et food truck du Château de Goutelas"
    ],
    "en": [
      "La Caravane de Goutelas — food truck & bistro in Forez"
    ],
    "fr": [
      "La Caravane de Goutelas — food truck & bistrot forézien"
    ]
  },
