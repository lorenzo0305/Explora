  "rdfs:comment": {
    "de": [
      "Verweilen Sie in unserer Einrichtung \"Teritoria\", die mit 11 schicken, zeitgenössischen, eleganten und geräumigen Zimmern ausgestattet ist und einen Panoramablick auf die Monts du Sancy, du Forez und du Cézallier oder auf die Ruinen des feudalen Schlosses bietet."
    ],
    "en": [
      "Stay in our \"Teritoria\" establishment with 11 chic, contemporary, elegant and spacious rooms with panoramic views of the Monts du Sancy, Forez and Cézallier or the ruins of the feudal castle."
    ],
    "it": [
      "Soggiornate nella nostra struttura \"Teritoria\" con le sue 11 camere chic, contemporanee, eleganti e spaziose con vista panoramica sui Monts du Sancy, Forez e Cézallier o sulle rovine del castello feudale."
    ],
    "fr": [
      "Séjournez dans notre établissement « Teritoria » équipé de 11 chambres chics et contemporaines, élégantes et spacieuses avec une vue panoramique sur les Monts du Sancy, du Forez et du Cézallier ou sur les ruines du château féodal."
    ],
    "nl": [
      "Verblijf in ons etablissement \"Teritoria\" met zijn 11 chique, eigentijdse, elegante en ruime kamers met panoramisch uitzicht op de Monts du Sancy, Forez en Cézallier of de ruïnes van het feodale kasteel."
    ],
    "es": [
      "Alójese en nuestro establecimiento \"Teritoria\" con sus 11 habitaciones chic, contemporáneas, elegantes y espaciosas con vistas panorámicas a los Montes del Sancy, Forez y Cézallier o a las ruinas del castillo feudal."
    ]
  },
  "rdfs:label": {
    "fr": [
