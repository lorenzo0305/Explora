  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Domaine du Viaduc in Garabit, ihre Bar, ihr Restaurant und ihre Ferienwohnung erwarten Sie in einem ruhigen, geschichtsträchtigen Ort."
    ],
    "en": [
      "Come and discover the Domaine du Viaduc in Garabit, where a bar, restaurant and gite await you in a peaceful setting steeped in history."
    ],
    "it": [
      "Venite a scoprire il Domaine du Viaduc a Garabit, con il suo bar, il ristorante e gli alloggi con angolo cottura in un ambiente tranquillo e ricco di storia."
    ],
    "fr": [
      "Venez découvrir le Domaine du Viaduc à Garabit, son Bar, son restaurant et gite vous attendent dans un lieu calme chargé d'histoire."
    ],
    "es": [
      "Venga a descubrir el Domaine du Viaduc en Garabit, con su bar, restaurante y alojamiento con cocina en un entorno tranquilo y cargado de historia."
    ],
    "nl": [
      "Kom en ontdek het Domaine du Viaduc in Garabit, met zijn bar, restaurant en zelfstandige accommodatie in een rustige omgeving vol geschiedenis."
    ]
