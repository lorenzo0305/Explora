  "rdfs:comment": {
    "de": [
      "Baieta ist ein Ort, an dem man sich wohlfühlt, ein lichtdurchfluteter Raum, eine mediterrane Einrichtung mit industriellen Akzenten, bequeme Sofas und Tische, die auf den Pool und den Außenbereich ausgerichtet sind."
    ],
    "en": [
      "Baieta is a place where you feel good, a space bathed in light, a Mediterranean decor with industrial accents, comfortable sofas and tables facing the pool and the outdoors."
    ],
    "it": [
      "Baieta è un luogo dove ci si sente bene, uno spazio immerso nella luce, un arredamento mediterraneo con accenti industriali, comodi divani e tavoli affacciati sulla piscina e sull'esterno."
    ],
    "fr": [
      "Baieta, c'est un lieu où l'on se sent bien, un espace baigné de lumière, un décor méditerranéen aux accents industriels, des canapés confortables et des tables tournées vers la piscine et l'extérieur."
    ],
    "nl": [
      "Baieta is een plek waar je je goed voelt, een ruimte badend in het licht, een mediterrane inrichting met industriële accenten, comfortabele banken en tafels met uitzicht op het zwembad en de buitenlucht."
    ],
    "es": [
      "Baieta es un lugar donde uno se siente bien, un espacio bañado de luz, una decoración mediterránea con acentos industriales, cómodos sofás y mesas frente a la piscina y al aire libre."
    ]
  },
  "rdfs:label": {
