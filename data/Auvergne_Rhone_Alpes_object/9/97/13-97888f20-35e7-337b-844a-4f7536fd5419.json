  "rdfs:comment": {
    "de": [
      "Fabrice Vaccari ist Bergführer in der Region Vercors-Trièves.\r\nEr bietet das ganze Jahr über Naturentdeckungstouren für Kinder und Erwachsene an. Mit Freude und Geselligkeit wird er Ihnen seine geheimsten Ecken zeigen."
    ],
    "en": [
      "Fabrice Vaccari is a mountain leader in Vercors-Trièves.\r\nHe proposes all year round nature discovery outings for children and adults, and it is with pleasure and conviviality that he will make you discover his most secret corners."
    ],
    "it": [
      "Fabrice Vaccari è una guida alpina del Vercors-Trièves.\r\nPropone tutto l'anno uscite alla scoperta della natura per bambini e adulti, ed è con piacere e convivialità che vi farà scoprire i suoi angoli più segreti."
    ],
    "fr": [
      "Fabrice Vaccari est accompagnateur en montagne dans le Vercors-Trièves.\r\nIl propose toute l’année des sorties découverte nature pour les enfants et les plus grands, et c’est avec plaisir et convivialité qu’il vous fera découvrir ses coins les plus secrets."
    ],
    "nl": [
      "Fabrice Vaccari is berggids in de Vercors-Trièves.\r\nHij biedt het hele jaar door natuurontdekkingsreizen aan voor kinderen en volwassenen en laat u met plezier en gezelligheid zijn meest geheime hoekjes ontdekken."
    ],
    "es": [
      "Fabrice Vaccari es guía de montaña en el Vercors-Trièves.\r\nOfrece durante todo el año salidas de descubrimiento de la naturaleza para niños y adultos, y le hará descubrir sus rincones más secretos con mucho gusto y convivencia."
    ]
  },
  "rdfs:label": {
