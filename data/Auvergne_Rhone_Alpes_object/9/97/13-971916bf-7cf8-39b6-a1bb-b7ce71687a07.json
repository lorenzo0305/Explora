  "rdfs:comment": {
    "de": [
      "Der Club Alpin Français du Vercors Sud ist ein Bergverein. Sein Hauptanliegen ist es, die im Vercors praktizierbaren Bergaktivitäten zu vermitteln: Höhlenforschung, Schneeschuhwandern, Nordic Skitouren, Canyoning, Klettern...."
    ],
    "en": [
      "The Club Alpin Français du Vercors Sud is a mountain club. Its main aim is to help people discover the mountain activities available in the Vercors: caving, snowshoeing, Nordic ski touring, canyoning, climbing...."
    ],
    "it": [
      "Il Club Alpin Français du Vercors Sud è un club di montagna. Il suo obiettivo principale è quello di far scoprire le attività di montagna disponibili nel Vercors: speleologia, racchette da neve, sci alpinismo nordico, canyoning, arrampicata...."
    ],
    "fr": [
      "Le Club Alpin Français du Vercors Sud est un club de montagne. Sa volonté première est de faire découvrir les activités de la montagne praticables sur le Vercors : spéléologie, raquette à neige, ski de randonnée nordique, canyoning, escalade...."
    ],
    "es": [
      "El Club Alpin Français du Vercors Sud es un club de montaña. Su principal objetivo es ayudar a descubrir las actividades de montaña disponibles en el Vercors: espeleología, raquetas de nieve, esquí nórdico de travesía, barranquismo, escalada...."
    ],
    "nl": [
      "De Club Alpin Français du Vercors Sud is een bergclub. Haar belangrijkste doel is om mensen de bergactiviteiten in de Vercors te laten ontdekken: speleologie, sneeuwschoenwandelen, nordic skitochten, canyoning, klimmen ...."
    ]
  },
