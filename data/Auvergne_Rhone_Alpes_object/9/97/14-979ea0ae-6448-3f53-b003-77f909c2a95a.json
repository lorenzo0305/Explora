  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/840fedde-dc41-3384-a142-db58e0c36abd",
      "dc:description": {
        "de": [
          "Verwandeln wir die Umgebung von Aquaterra in ein echtes Naturmuseum. In diesem Workshop werden Sie zu kleinen Künstlern. Sie werden sammeln, was die Natur im Herbst zu bieten hat, und daraus einzigartige Kunstwerke herstellen."
        ],
        "en": [
          "Let's transform the area around Aquaterra into a natural museum. In this workshop, you'll become budding artists. You'll harvest what nature has to offer in autumn to create unique works of art."
        ],
        "it": [
          "Trasformiamo l'area intorno ad Aquaterra in un vero e proprio museo naturale. Durante questo laboratorio, diventerete artisti in erba. Raccoglierete ciò che la natura offre in autunno per creare opere d'arte uniche."
        ],
        "fr": [
          "Transformons les abords d’Aquaterra en un véritable musée au naturel. Au cours de cet atelier, vous deviendrez des artistes en herbe. Vous récolterez ce que nous offre la nature en automne pour confectionner des œuvres uniques."
        ],
        "es": [
          "Transformemos los alrededores de Aquaterra en un auténtico museo natural. Durante este taller, os convertiréis en artistas en ciernes. Recogeréis lo que la naturaleza nos ofrece en otoño para crear obras de arte únicas."
        ],
        "nl": [
          "Laten we het gebied rond Aquaterra omtoveren tot een echt natuurmuseum. Tijdens deze workshop worden jullie ontluikende kunstenaars. Je verzamelt wat de natuur in de herfst te bieden heeft om unieke kunstwerken te maken."
        ]
      },
      "@type": [
        "Description"
