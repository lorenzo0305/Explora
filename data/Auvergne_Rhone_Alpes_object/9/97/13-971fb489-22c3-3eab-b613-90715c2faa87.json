  "rdfs:comment": {
    "de": [
      "Verkauf von küchenfertigem Geflügel auf dem Bauernhof: Hühner, Perlhühner, Truthähne, Kapaune, Gänse (vorzugsweise auf Bestellung)."
    ],
    "en": [
      "Direct sales of poultry (chickens, Guinea fowl, turkeys and capons) at the farm. Please place an order beforehand. Cherries during the season. You can find us at the Producers Market in Le Teil every Friday from May to October between 4.30 and 7pm."
    ],
    "it": [
      "Vendita in azienda di pollame pronto per la cottura: polli, faraone, tacchini, capponi e poulard (preferibilmente su ordinazione)."
    ],
    "fr": [
      "Vente à la Ferme de volailles prêtes a cuire: Poulets, Pintades, Dindes, Chapons, Poulardes (sur commande de préférence)."
    ],
    "es": [
      "Venta en granja de aves de corral listas para cocinar: pollos, pintadas, pavos, capones y poulards (preferentemente por encargo)."
    ],
    "nl": [
      "Boerderijverkoop van kant-en-klaar gevogelte: kippen, parelhoenders, kalkoenen, kapoenen en poelies (bij voorkeur op bestelling)."
    ]
  },
