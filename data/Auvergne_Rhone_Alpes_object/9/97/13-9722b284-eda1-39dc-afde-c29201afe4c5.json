  "rdfs:comment": {
    "de": [
      "Das Grand Café, eine Café-Brasserie an der Place d'Allier, ist eines der schönsten Cafés Frankreichs. Es steht auf der Liste der historischen Monumente und hat seine Dekoration aus dem Jahr 1899 behalten."
    ],
    "en": [
      "Le Grand Café, a café-brasserie on Place d'Allier, is one of the most beautiful in France. Listed as a Historical Monument, it has retained its 1899 decoration."
    ],
    "it": [
      "Il Grand Café, caffè-brasserie di Place d'Allier, è uno dei più belli di Francia. Classificato come Monumento Storico, ha conservato la decorazione del 1899."
    ],
    "fr": [
      "Le Grand Café, café brasserie sis place d'Allier, est l'un des plus beaux de France. Inscrit à l'Inventaire des Monuments Historiques, il a conservé sa décoration de 1899."
    ],
    "nl": [
      "Het Grand Café, een café-brasserie aan de Place d'Allier, is een van de mooiste van Frankrijk. Het staat op de monumentenlijst en heeft zijn decoratie uit 1899 behouden."
    ],
    "es": [
      "El Grand Café, café-brasserie de la Place d'Allier, es uno de los más bellos de Francia. Catalogado como Monumento Histórico, conserva su decoración de 1899."
    ]
  },
