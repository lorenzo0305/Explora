  "rdfs:comment": {
    "de": [
      "Eine Neuheit in der Gemeinde! Ein alter, vergessener Dry-Tooling-Standort, der wieder in Betrieb genommen wurde, um ein Sportklettern mit atypischer Atmosphäre anzubieten."
    ],
    "en": [
      "Something new for the Commune! An old, forgotten dry tooling site has been reclaimed to offer a sport climbing experience in an atypical atmosphere."
    ],
    "it": [
      "Una novità per il Comune! Un vecchio sito di dry tooling dimenticato è stato recuperato per offrire un'esperienza di arrampicata sportiva in un'atmosfera atipica."
    ],
    "fr": [
      "Une nouveauté sur la Commune ! Un ancien site de dry tooling oublié et repris pour offrir une escalade sportive à l’ambiance atypique."
    ],
    "es": [
      "¡Algo nuevo para la Comuna! Se ha recuperado un antiguo y olvidado emplazamiento de herramientas en seco para ofrecer una experiencia de escalada deportiva en un ambiente atípico."
    ],
    "nl": [
      "Iets nieuws voor de gemeente! Een oude, vergeten plek voor droog gereedschap is teruggewonnen om een sportieve klimervaring te bieden in een atypische sfeer."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Falaise d'escalade du Parc Thermal - Secteur des Naufragés"
    ]
  },
