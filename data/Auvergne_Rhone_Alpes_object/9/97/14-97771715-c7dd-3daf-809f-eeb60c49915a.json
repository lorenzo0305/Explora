      "@id": "https://data.datatourisme.fr/f8e0cdee-c35e-3803-b738-5b9794d6c9f7",
      "dc:description": {
        "de": [
          "Wassersportartikel, Strandsegeln, Marken- und Surftextilien, Neoprenanzüge\nAnsatz \"Null Plastik\", \"Null Abfall\", \"Anti-Verschwendung\"\nrückgewinnung von Neoprenanzügen, um sie zu recyceln"
        ],
        "en": [
          "Nautical items, sand yachts, branded and surf textiles, neoprene wetsuits\nZero plastic\", \"Zero waste\", \"Anti-gaspi\" approach\nrecovery of neoprene combianisons, for recycling"
        ],
        "it": [
          "Articoli nautici, sand yacht, abbigliamento di marca e da surf, mute in neoprene\nApproccio \"plastica zero\", \"rifiuti zero\", \"anti-gaspi\"\nrecupero delle mute in neoprene per il riciclo"
        ],
        "fr": [
          "Articles de nautisme, char à voile, textile de marque et de surf, combinaisons néoprène\nDémarche \"Zéro plastique\", \"Zéro déchet\", \"Anti-gaspi\"\nrécupération de combianisons néoprène, pour recyclage"
        ],
        "nl": [
          "Nautische artikelen, zandjachten, merk- en surfkleding, neopreen wetsuits\nZero plastic\", \"Zero afval\", \"Anti-gaspi\" benadering\nterugwinning van neopreenpakken voor recycling"
        ],
        "es": [
          "Artículos náuticos, yates de arena, ropa de marca y de surf, trajes de neopreno\nPlástico cero\", \"Residuos cero\", \"Antigaspi\nrecuperación de trajes de neopreno para su reciclaje"
        ]
      },
