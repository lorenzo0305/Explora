  "rdfs:comment": {
    "de": [
      "Au panier des marmottes, ein VIVAL-Supermarkt und Nahversorger, bietet eine Auswahl an regionalen Produkten: Konfitüren, Ziegen- und Kuhkäse, Geflügel, Weine, Biere, Liköre? Honig und Pasteten von Erzeugern aus dem Mézenc."
    ],
    "en": [
      "Au panier des marmottes, a VIVAL mini-market and local food store, offers a selection of regional products: jams, goat's and cow's cheeses, poultry, wines, beers, liqueurs? Honeys and pâtés from Mezenc producers."
    ],
    "it": [
      "Au panier des marmottes, mini-market VIVAL e negozio di prodotti alimentari locali, offre una selezione di prodotti regionali: marmellate, formaggi di capra e di mucca, pollame, vini, birre, liquori? Miele e paté dei produttori di Mezenc."
    ],
    "fr": [
      "Au panier des marmottes, supérette VIVAL et alimentation de proximité, propose une sélection de produits régionaux : confitures, fromages de chèvre ou de vache, volailles, vins, bières, liqueurs… Miels et pâtés des producteurs du Mézenc."
    ],
    "es": [
      "Au panier des marmottes, minimercado VIVAL y tienda de alimentación local, ofrece una selección de productos regionales: mermeladas, quesos de cabra y vaca, aves, vinos, cervezas, licores? Miel y patés de los productores de Mezenc."
    ],
    "nl": [
      "Au panier des marmottes, een VIVAL-minimarkt en lokale levensmiddelenwinkel, biedt een selectie regionale producten: jam, geiten- en koeienkazen, gevogelte, wijnen, bieren, likeuren? Honing en patés van Mezenc producenten."
    ]
  },
