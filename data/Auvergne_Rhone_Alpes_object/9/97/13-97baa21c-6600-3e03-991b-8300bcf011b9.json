  "rdfs:comment": {
    "de": [
      "Hast du Lust auf eine Aktivität im Freien, die mit Tieren zu tun hat? Dann ist Ponyreiten genau das Richtige für dich!\r\nDie Kurse sind für alle Niveaus und auch für Anfänger geeignet."
    ],
    "en": [
      "Looking for an outdoor activity with animals? Pony riding courses are ideal!\r\nOpen to all levels, including beginners."
    ],
    "it": [
      "Cercate un'attività all'aria aperta con gli animali? I corsi di pony trekking sono l'ideale!\r\nAperti a tutti i livelli e ai principianti."
    ],
    "fr": [
      "Envie d'une activité en extérieur en lien avec les animaux? Les stages de poney, c'est idéal!\r\nOuvert à tous les niveaux, ainsi qu'aux débutants."
    ],
    "es": [
      "¿Busca una actividad al aire libre con animales? ¡Los cursos de paseo en poni son ideales!\r\nAbiertos a todos los niveles, así como a principiantes."
    ],
    "nl": [
      "Op zoek naar een buitenactiviteit met dieren? Pony trekking cursussen zijn ideaal!\r\nOpen voor alle niveaus, maar ook voor beginners."
    ]
  },
