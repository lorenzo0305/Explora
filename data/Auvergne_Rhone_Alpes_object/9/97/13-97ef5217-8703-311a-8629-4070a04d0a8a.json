  "rdfs:comment": {
    "de": [
      "An jedem Wochenende bringt der DJ den Dancefloor im JOA zum Glühen ... Die modern eingerichtete und mit Soundsystem ausgestattete Lounge-Bar verfügt über eine Bühne für Aufführungen oder Konzerte."
    ],
    "en": [
      "All weekends, the resident DJ ignites the JOA dance floor... The lounge bar with contemporary furnishings, fully fitted out with a sound system, has a stage to accommodate dinner shows or concerts."
    ],
    "it": [
      "Ogni fine settimana, il DJ residente infiamma la pista da ballo dello JOA... Il lounge bar, arredato in stile contemporaneo e dotato di impianto audio, dispone di un palcoscenico per cene e concerti."
    ],
    "fr": [
      "Tous les week-ends, Le DJ résident enflamme la piste de danse du Dancefloor JOA... Le bar lounge au mobilier contemporain, entièrement sonorisé, dispose d’une scène pour accueillir des dîners spectacles ou concerts."
    ],
    "es": [
      "Todos los fines de semana, el DJ residente hace arder la pista de baile de JOA... El bar salón, con su mobiliario contemporáneo, totalmente equipado con sonido, dispone de un escenario para cenas-espectáculo o conciertos."
    ],
    "nl": [
      "Elk weekend zet de vaste DJ de JOA-dansvloer in vuur en vlam... De loungebar met eigentijds meubilair, volledig uitgerust met geluid, heeft een podium voor dinershows of concerten."
    ]
  },
