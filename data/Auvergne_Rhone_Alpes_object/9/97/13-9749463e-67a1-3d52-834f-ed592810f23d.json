  "rdfs:comment": {
    "de": [
      "Die Ausleihe ist für alle kostenlos (nach Anmeldung). Die Bibliothek ist Teil des Savoie-Biblio-Netzwerks (Leihbibliothek des Departements Savoie und Haute-Savoie) und hat daher Zugang zu allen Dokumenten (Bücher, CDs, CDRs und DVDs) des Netzwerks."
    ],
    "en": [
      "Lending is free for all (after registration). The library is part of the Savoie-Biblio network (Savoie and Haute-Savoie departmental lending library), and therefore has access to all the network's documents (books, CDs, CDRs and DVDs)."
    ],
    "it": [
      "Il prestito è gratuito per tutti (previa iscrizione). La biblioteca fa parte della rete Savoia-Biblio (biblioteca dipartimentale di prestito della Savoia e dell'Alta Savoia) e ha quindi accesso a tutti i documenti (libri, CD, CDR e DVD) della rete."
    ],
    "fr": [
      "Le prêt est gratuit pour tous (après inscription). La bibliothèque fait partie du réseau Savoie-Biblio (bibliothèque départementale de prêt de Savoie et Haute-Savoie) et de ce fait, a accès à tous les documents (livres, CD, CDR et DVD) du réseau."
    ],
    "nl": [
      "Lenen is gratis voor iedereen (na inschrijving). De bibliotheek maakt deel uit van het Savoie-Biblio netwerk (departementale uitleenbibliotheek voor Savoie en Haute-Savoie) en heeft daarom toegang tot alle documenten (boeken, cd's, cdr's en dvd's) in het netwerk."
    ],
    "es": [
      "El préstamo es gratuito para todos (previa inscripción). La biblioteca forma parte de la red Savoie-Biblio (biblioteca departamental de préstamo de Saboya y Alta Saboya) y, por tanto, tiene acceso a todos los documentos (libros, CD, CDR y DVD) de la red."
    ]
  },
  "rdfs:label": {
