  "rdfs:comment": {
    "de": [
      "Connecting Bourbon ist ein Verein, der die kollektive Intelligenz fördert, indem er sich für die Entwicklung der kollaborativen Wirtschaft, Innovation und Digitalisierung auf lokaler, regionaler, nationaler und internationaler Ebene einsetzt."
    ],
    "en": [
      "Connecting Bourbon is an association that fosters collective intelligence by contributing to the development of the collaborative economy, innovation and digital technology at local, regional, national and international levels."
    ],
    "it": [
      "Connecting Bourbon è un'associazione che promuove l'intelligenza collettiva come parte dello sviluppo dell'economia collaborativa, dell'innovazione e della tecnologia digitale a livello locale, regionale, nazionale e internazionale."
    ],
    "fr": [
      "Connecting Bourbon est une association qui favorise l’intelligence collective en s’inscrivant dans le développement de l’économie collaborative, de l’innovation et du numérique au niveau local, régional, national et international."
    ],
    "nl": [
      "Connecting Bourbon is een vereniging die collectieve intelligentie promoot als onderdeel van de ontwikkeling van de collaboratieve economie, innovatie en digitale technologie op lokaal, regionaal, nationaal en internationaal niveau."
    ],
    "es": [
      "Connecting Bourbon es una asociación que promueve la inteligencia colectiva como parte del desarrollo de la economía colaborativa, la innovación y la tecnología digital a nivel local, regional, nacional e internacional."
    ]
  },
