  "rdfs:comment": {
    "de": [
      "Sobald Sie Le Cheylard verlassen, wechselt die Radroute die Szenerie: Die Dolce Via, mit dem Eyrieux als rotem Faden, stürzt sich nun in die tief eingeschnittenen Täler der Boutières."
    ],
    "en": [
      "As soon as it leaves Le Cheylard, the cycle route changes its scenery: the Dolce Via, with the Eyrieux as its main thread, now runs into the steep valleys of the Boutières."
    ],
    "it": [
      "Appena lasciato Le Cheylard, il percorso ciclistico cambia scenario: la Dolce Via, che ha come filo conduttore l'Eyrieux, si snoda ora attraverso le valli scoscese delle Boutières."
    ],
    "fr": [
      "Sitôt quitté Le Cheylard, l'itinéraire vélo change de décor : la Dolce Via, avec l'Eyrieux comme fil conducteur, s'engouffre désormais dans les vallées encaissées des Boutières."
    ],
    "nl": [
      "Zodra je Le Cheylard verlaat, verandert de fietsroute van landschap: de Dolce Via, met de Eyrieux als rode draad, slingert zich nu door de steile valleien van de Boutières."
    ],
    "es": [
      "Nada más salir de Le Cheylard, la ruta ciclista cambia de escenario: la Dolce Via, con el Eyrieux como hilo conductor, serpentea ahora por los escarpados valles de las Boutières."
    ]
  },
  "rdfs:label": {
    "en": [
      "Dolce Via - Le Cheylard to Saint-Agrève"
    ],
    "fr": [
      "Dolce Via de Le Cheylard à Saint-Agrève"
    ]
  },
