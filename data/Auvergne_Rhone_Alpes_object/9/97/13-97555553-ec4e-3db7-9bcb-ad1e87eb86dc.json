  "rdfs:comment": {
    "de": [
      "Die Touristeninformation von Courpière befindet sich im Herzen der Altstadt in einem Haus aus dem 14. Jahrhundert und empfängt Sie das ganze Jahr über, um Sie vor und während Ihres Aufenthalts zu begleiten."
    ],
    "en": [
      "Located in the heart of the old town, in a house dating back to the 14th century, Courpière's tourist information office welcomes you all year round to help you before and during your stay."
    ],
    "it": [
      "Situato nel cuore della città vecchia, in una casa del XIV secolo, l'ufficio informazioni turistiche della Courpière vi accoglie tutto l'anno per aiutarvi prima e durante il vostro soggiorno."
    ],
    "fr": [
      "Situé au cœur de la vieille ville, dans une maison datée du XIVe siècle, le bureau d'information touristique de Courpière  vous accueille toute l'année pour vous accompagner avant et pendant votre séjour."
    ],
    "es": [
      "Situada en el corazón del casco antiguo, en una casa del siglo XIV, la oficina de turismo de Courpière le recibe todo el año para ayudarle antes y durante su estancia."
    ],
    "nl": [
      "In het hart van de oude stad, in een huis uit de 14e eeuw, verwelkomt het VVV-kantoor van Courpière je het hele jaar door om je te helpen voor en tijdens je verblijf."
    ]
  },
  "rdfs:label": {
    "fr": [
