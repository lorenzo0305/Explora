  "rdfs:comment": {
    "de": [
      "Ein kleiner Hunger auf Entdeckungen, ein großer Appetit auf Kultur - die Mediathek von Le Coteau bereitet Ihnen ihre besten Gerichte in einem freundlichen und einladenden Raum zu, der allen offen steht."
    ],
    "en": [
      "If you're hungry for new discoveries, or have a big appetite for culture, the Coteau multimedia library is ready to serve you its best dishes in a friendly, welcoming space open to all."
    ],
    "it": [
      "Se siete affamati di nuove scoperte o avete un grande appetito per la cultura, la biblioteca multimediale Coteau cucinerà alcuni dei suoi piatti migliori in uno spazio amichevole e accogliente aperto a tutti."
    ],
    "fr": [
      "Une petite faim de découvertes, un gros appétit culturel, la médiathèque du Coteau vous mitonne ses meilleurs plats dans un espace convivial et accueillant ouvert à tous."
    ],
    "es": [
      "Si le apetecen nuevos descubrimientos o tiene un gran apetito cultural, la mediateca Coteau cocinará algunos de sus mejores platos en un espacio acogedor y abierto a todos."
    ],
    "nl": [
      "Als je hongerig bent naar nieuwe ontdekkingen of een grote honger hebt naar cultuur, zal de Coteau mediatheek een aantal van zijn beste gerechten bereiden in een vriendelijke, gastvrije ruimte die open staat voor iedereen."
    ]
  },
