  "rdfs:comment": {
    "de": [
      "Summit Bike bietet Mountainbike-, E-Mountainbike-, Gravelbike- und Rennradtouren in der Haute Tarentaise sowie Trainingskurse und All-inclusive-Pakete zur Entdeckung traumhafter alpiner Routen an.\r\nIm Winter können Sie Fatbiking im Schnee erleben!"
    ],
    "en": [
      "Summit Bike offers mountain biking, e-mountain biking, gravel biking, and road cycling excursions in the Haute Tarentaise region, as well as training courses and all-inclusive packages to discover fantastic alpine routes.\r\nIn winter, discover Fat Biking on snow!"
    ],
    "it": [
      "Nella Haute Tarentaise, Summit Bike propone mountain bike, mountain bike, gravel e road bike, corsi di formazione e soggiorni all-inclusive per scoprire i grandi itinerari alpini.\r\nIn inverno, scoprite la Fat Bike sulla neve!"
    ],
    "fr": [
      "Summit Bike propose en Haute Tarentaise des sorties VTT, VTTAE, gravel et route, des stages et des séjours tout compris pour découvrir de super itinéraires alpins. \r\nL’hiver, découvrez aussi le Fat Bike sur neige !"
    ],
    "es": [
      "Summit Bike, en la Haute Tarentaise, le ofrece BTT, bicicletas de montaña, de gravilla y de carretera, cursos de formación y escapadas con todo incluido para descubrir las grandes rutas alpinas.\r\nEn invierno, ¡descubra el Fat Bike sobre nieve!"
    ],
    "nl": [
      "In de Haute Tarentaise biedt Summit Bike mountainbiken, mountainbiken, gravel- en racefietsen, trainingen en all-inclusive vakanties om geweldige alpiene routes te ontdekken.\r\nOntdek in de winter Fat Bike op sneeuw!"
    ]
  },
