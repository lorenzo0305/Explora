  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/1c3a4514-7f67-336a-9c1a-010fd978f0d7",
      "dc:description": {
        "de": [
          "In Mers-les-Bains. Gegenüber dem Meer, auf der Esplanade, bietet Chaud et Froid Sandwiches, Amerikaner, Paninis, Eis, italienisches Eis, Getränke. Von April bis Ende Oktober ab 11 Uhr geöffnet."
        ],
        "en": [
          "In Mers-les-Bains. Facing the sea, on the esplanade, Chaud et Froid offers sandwiches, american sandwiches, paninis, ice creams, italian ice creams, drinks. Open from 11 am from April to the end of October."
        ],
        "it": [
          "A Mers-les-Bains. Di fronte al mare, sulla spianata, Chaud et Froid offre panini, americani, panini, gelati, gelati italiani, bevande. Aperto dalle 11 da aprile a fine ottobre."
        ],
        "fr": [
          "A Mers-les-Bains. Face à la mer, sur l'esplanade, Chaud et Froid propose sandwichs, américains, paninis, glaces, glaces italiennes, boissons. Ouvert dès 11 h d'avril à fin octobre."
        ],
        "nl": [
          "In Mers-les-Bains. Met uitzicht op zee, op de esplanade, biedt Chaud et Froid broodjes, Amerikanen, panini's, ijs, Italiaans ijs, drankjes. Open vanaf 11 uur van april tot eind oktober."
        ],
        "es": [
          "En Mers-les-Bains. Frente al mar, en la explanada, Chaud et Froid ofrece sándwiches, comida americana, paninis, helados, helados italianos, bebidas. Abierto desde las 11 de la mañana de abril a finales de octubre."
        ]
      },
