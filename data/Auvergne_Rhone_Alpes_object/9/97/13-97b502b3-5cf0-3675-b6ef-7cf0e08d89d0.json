  "rdfs:comment": {
    "de": [
      "Die Kirche Notre-Dame de Lourdes ist eine katholische Kirche, die in der zweiten Hälfte des 20. Jahrhunderts (1965) auf dem Gebiet der Gemeinde Thonon-les-Bains (Haute-Savoie) von dem savoyischen Architekten Maurice Novarina erbaut wurde."
    ],
    "en": [
      "The Church of Our Lady of Lourdes is a Catholic church built in the second half of the 20th century (in 1965) in the municipality of Thonon-les-Bains (Haute-Savoie) by Savoyard architect Maurice Novarina."
    ],
    "it": [
      "La Chiesa di Nostra Signora di Lourdes è una chiesa cattolica costruita nella seconda metà del XX secolo (nel 1965) nel comune di Thonon-les-Bains (Alta Savoia), dall'architetto savoiardo Maurice Novarina."
    ],
    "fr": [
      "L'Église Notre-Dame de Lourdes est une église de confession catholique construite dans la deuxième moitié du XXe siècle (en 1965) sur le territoire de la commune de Thonon-les-Bains (Haute-Savoie), par l’architecte savoyard Maurice Novarina."
    ],
    "es": [
      "La iglesia de Nuestra Señora de Lourdes es una iglesia católica construida en la segunda mitad del siglo XX (en 1965) en el municipio de Thonon-les-Bains (Alta Saboya), por el arquitecto saboyano Maurice Novarina."
    ],
    "nl": [
      "De kerk van Onze-Lieve-Vrouw van Lourdes is een katholieke kerk gebouwd in de tweede helft van de 20e eeuw (in 1965) in de gemeente Thonon-les-Bains (Haute-Savoie), door de Savoyaardse architect Maurice Novarina."
    ]
  },
