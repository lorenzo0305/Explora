  "rdfs:comment": {
    "de": [
      "Möchten Sie das Haut-Diois auf einer Wanderung entdecken? Mit einem Esel? Begleitet oder selbstständig, alles ist möglich, von einem halben Tag bis zu einer mehrtägigen Wanderung. Das Plus: Zugang zu Bergwanderungen für Personen mit eingeschränkter Mobilität."
    ],
    "en": [
      "Would you like to discover the Haut-Diois on foot? With a donkey? Accompanied or on your own, anything is possible, from 1/2 day to multi-day itineraries. The + access to mountain hiking for people with reduced mobility."
    ],
    "it": [
      "Volete scoprire l'Haut-Diois a piedi? Con un asino? Accompagnati o da soli, tutto è possibile, da 1/2 giornata a più giorni di cammino. In più, accesso alle passeggiate in montagna per le persone a mobilità ridotta."
    ],
    "fr": [
      "Vous voulez découvrir le Haut-Diois en randonnée ? Avec un âne? Accompagnés ou en autonomie, tout est imaginable, de la 1/2 journée à l'itinérance sur plusieurs jours. Le + accès à la rando en montagne pour les Personnes à Mobilité Réduite."
    ],
    "es": [
      "¿Desea descubrir el Haut-Diois a pie? ¿Con un burro? Acompañado o por su cuenta, todo es concebible, desde 1/2 día hasta varios días de itinerancia. Además, acceso a paseos de montaña para personas con movilidad reducida."
    ],
    "nl": [
      "Wil je de Haut-Diois te voet ontdekken? Met een ezel? Onder begeleiding of alleen, alles is mogelijk, van een 1/2 dag tot meerdere dagen zwerven. Plus toegang tot bergwandelingen voor mensen met beperkte mobiliteit."
    ]
  },
  "rdfs:label": {
    "de": [
      "Sébatien Vernier - Accompagnateur en montagne"
    ],
    "en": [
      "Sébatien Vernier - Mountain Guide"
    ],
    "fr": [
      "Sébatien Vernier - Accompagnateur en montagne"
    ],
