  "rdfs:comment": {
    "de": [
      "Artisan chocolatier au service de vos papilles. Originelle und vor allem sehr gute Schokolade! Vor Ort von A bis Z mit Liebe hergestellt. 2 Geschäfte, um Sie besser bedienen zu können: Stadtzentrum von Roanne und Industriegebiet Le Coteau."
    ],
    "en": [
      "Artisan chocolatier serving your taste buds. Original chocolates that taste great! Made on site from A to Z with love. 2 stores to serve you better: Roanne town center and Coteau industrial zone."
    ],
    "it": [
      "Cioccolateria artigianale al servizio delle vostre papille gustative. Cioccolatini originali e soprattutto deliziosi! Prodotti in loco dalla A alla Z con amore. 2 negozi per servirvi meglio: il centro di Roanne e la zona industriale di Coteau."
    ],
    "fr": [
      "Artisan chocolatier au service de vos papilles. Des chocolats originaux et surtout très bons ! Fabriqués sur place de A à Z avec amour. 2 boutiques pour mieux vous servir : Centre-ville de Roanne et zone industrielle du Coteau."
    ],
    "es": [
      "Chocolatero artesano al servicio de su paladar. Chocolates originales y, sobre todo, deliciosos Elaborados in situ de la A a la Z con amor. 2 tiendas para servirle mejor: centro de Roanne y polígono industrial de Coteau."
    ],
    "nl": [
      "Ambachtelijke chocolatier in dienst van uw smaakpapillen. Originele en vooral lekkere pralines! Ter plaatse gemaakt van A tot Z met liefde. 2 winkels om u beter van dienst te zijn: Roanne centrum en Coteau industrieterrein."
    ]
  },
  "rdfs:label": {
