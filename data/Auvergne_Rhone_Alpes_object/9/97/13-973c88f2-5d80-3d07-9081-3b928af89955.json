  "rdfs:comment": {
    "de": [
      "In Saint-Bonnet-Tronçais können Sie sich in dieser Einrichtung erholen, die entspannende Massagen, Gesichtsbehandlungen, Schönheitsleistungen und einen Wellnessbereich mit Sauna, Hammam und Jacuzzi anbietet."
    ],
    "en": [
      "In Saint-Bonnet-Tronçais, recharge your batteries in this establishment offering relaxing massages, facials, beauty services and a SPA area with sauna, hammam and jacuzzi."
    ],
    "it": [
      "A Saint-Bonnet-Tronçais, fate il pieno di energia in questa struttura che offre massaggi rilassanti, trattamenti viso, trattamenti di bellezza e un'area SPA con sauna, hammam e jacuzzi."
    ],
    "fr": [
      "À Saint-Bonnet-Tronçais, ressourcez vous au sein de cet établissement proposant des massages détentes, des soins visages, des prestations esthétiques ou encore un espace SPA avec sauna, hammam et jacuzzi."
    ],
    "nl": [
      "In Saint-Bonnet-Tronçais kunt u nieuwe energie opdoen in dit etablissement met ontspannende massages, gezichtsbehandelingen, schoonheidsbehandelingen en een SPA-ruimte met sauna, hammam en jacuzzi."
    ],
    "es": [
      "En Saint-Bonnet-Tronçais, recargue las pilas en este establecimiento que ofrece masajes relajantes, tratamientos faciales y de belleza y una zona SPA con sauna, hammam y jacuzzi."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Centre de bien-être Les Sources de Tronçais"
    ]
  },
