  "rdfs:comment": {
    "de": [
      "Mit Blick auf die Weinberge und die Rhône ist das Hôtel Restaurant Le Bellevue eine Rebsorte inmitten der Grands Crus.\r\nEntdecken Sie eine Küche, die Ihre Geschmacksknospen zum Leuchten bringt. Lokale Spezialitäten, frische Produkte, hausgemachte Gerichte."
    ],
    "en": [
      "Traditional cuisine made with fresh products. The restaurant has a beautiful view overlooking the Rhône River and the vineyard of Condrieu."
    ],
    "it": [
      "Affacciato sui vigneti e con vista sul Rodano, l'Hôtel Restaurant Le Bellevue è un vitigno in mezzo ai Grands Crus.\r\nVenite a scoprire una cucina che delizierà il vostro palato. Specialità locali, prodotti freschi, cucina casalinga."
    ],
    "fr": [
      "Face aux vignes et surplombant le Rhône, l’Hôtel Restaurant Le Bellevue est un cépage au milieu des Grands Crus.\r\nVenez découvrir une cuisine qui illuminera vos papilles . Spécialités locales, produits frais, cuisine faite-maison."
    ],
    "nl": [
      "Met uitzicht op de wijngaarden en de Rhône is Hôtel Restaurant Le Bellevue een druivensoort te midden van de Grands Crus.\r\nKom en ontdek een keuken die uw smaakpapillen zal verrukken. Lokale specialiteiten, verse producten, huisgemaakte gerechten."
    ],
    "es": [
      "Frente a los viñedos y con vistas al Ródano, el Hôtel Restaurant Le Bellevue se encuentra en medio de los Grands Crus.\r\nVenga a descubrir una cocina que deleitará su paladar. Especialidades locales, productos frescos, cocina casera."
    ]
  },
  "rdfs:label": {
    "en": [
      "Hotel-restaurant le Bellevue"
    ],
    "fr": [
      "Hôtel-restaurant le Bellevue"
    ]
  },
