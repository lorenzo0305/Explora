  "rdfs:comment": {
    "de": [
      "Keramikwerkstatt in der Nähe des Dorfes Les Vans, wir arbeiten mit Steingut. Zwei Welten, die sich bei Gebrauchs- und Dekorationsgegenständen vereinen."
    ],
    "en": [
      "A ceramists' workshop near the village of Les Vans, we work in stoneware. Two worlds that come together around utilitarian and decorative objects."
    ],
    "it": [
      "Laboratorio di ceramisti vicino al villaggio di Les Vans, lavoriamo il gres. Due universi che si incontrano intorno a oggetti utilitari e decorativi."
    ],
    "fr": [
      "Atelier de céramistes près du village des Vans, nous travaillons le gré. Deux univers qui se rejoignent autour d'objets utilitaires et décoratifs."
    ],
    "es": [
      "Taller de ceramistas cerca del pueblo de Les Vans, trabajamos con gres. Dos universos que se unen en torno a objetos utilitarios y decorativos."
    ],
    "nl": [
      "Keramisten atelier in de buurt van het dorp Les Vans, wij werken met steengoed. Twee universums die samenkomen rond gebruiks- en siervoorwerpen."
    ]
  },
