  "rdfs:comment": {
    "de": [
      "Diese Bar wurde kürzlich übernommen und liegt ideal im Herzen des Dorfes. Sie ist 7 Tage die Woche geöffnet und bietet neben traditionellen Getränken auch kleine Speisen an"
    ],
    "en": [
      "Recently taken over, this bar, ideally located in the heart of the village, is open 7 days a week and offers snacks as well as traditional drinks"
    ],
    "it": [
      "Recentemente rilevato, questo bar, situato in posizione ideale nel cuore del villaggio, è aperto 7 giorni su 7 e offre una gamma di snack e bevande tradizionali"
    ],
    "fr": [
      "Récemment repris, ce bar idéalement situé au cœur du village est ouvert 7 jours sur 7 et propose de la petite restauration en plus des consommations traditionnelles"
    ],
    "es": [
      "Este bar, situado en el centro del pueblo, abre los 7 días de la semana y ofrece aperitivos y bebidas tradicionales"
    ],
    "nl": [
      "Deze bar, ideaal gelegen in het hart van het dorp, is onlangs overgenomen en is 7 dagen per week geopend. Je kunt er terecht voor snacks en traditionele dranken"
    ]
