  "rdfs:comment": {
    "de": [
      "Gehen Sie auf Entdeckungsreise durch das historische Zentrum von Valencia! Finden Sie diese emblematischen Sehenswürdigkeiten: die Kathedrale Saint-Apollinaire, das Maison des Têtes, das Maison Dupré-Latour, den Tempel St-Ruf, das maurische Haus und den malerischen Place Saint-Jean."
    ],
    "en": [
      "Discover the historic center of Valence! Discover these emblematic monuments: the Saint-Apollinaire cathedral, the Maison des Têtes, the Maison Dupré-Latour, the St-Ruf temple, the Maison mauresque and the picturesque Place Saint-Jean."
    ],
    "it": [
      "Scoprite il centro storico di Valence! Ammirate alcuni dei monumenti più emblematici della città: la cattedrale Saint-Apollinaire, la Maison des Têtes, la Maison Dupré-Latour, il tempio St-Ruf, la casa moresca e la pittoresca Place Saint-Jean."
    ],
    "fr": [
      "Partez à la découverte du centre historique de Valence ! Retrouvez ces monuments emblématiques : la cathédrale Saint-Apollinaire, la Maison des Têtes, la Maison Dupré-Latour, le temple St-Ruf, la Maison mauresque et la pittoresque place Saint-Jean."
    ],
    "nl": [
      "Ontdek het historische centrum van Valence! Bekijk enkele van de meest karakteristieke monumenten van de stad: de kathedraal Saint-Apollinaire, het Maison des Têtes, het Maison Dupré-Latour, de tempel St-Ruf, het Moorse huis en de schilderachtige Place Saint-Jean."
    ],
    "es": [
      "Descubra el centro histórico de Valence Contemple algunos de los monumentos más emblemáticos de la ciudad: la catedral Saint-Apollinaire, la Maison des Têtes, la Maison Dupré-Latour, el templo de St-Ruf, la casa morisca y la pintoresca plaza Saint-Jean."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite guidée : Le coeur historique de Valence"
    ]
  },
