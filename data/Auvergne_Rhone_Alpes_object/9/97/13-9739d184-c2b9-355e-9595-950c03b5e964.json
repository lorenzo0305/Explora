  "rdfs:comment": {
    "de": [
      "Landwirtschaftlicher Betrieb in BIO. Verkauf auf dem Bauernhof. Verarbeitung von über 30 alten französischen Mostapfelsorten.\r\nKühe pflegen den Obstgarten und tragen zum Ökosystem bei, das für eine leistungsfähige AB-Produktion eingerichtet wurde."
    ],
    "en": [
      "Organic farm. Farm sales. Processing of over 30 ancient varieties of French cider apples.\r\nCows tend the orchard, contributing to the ecosystem set up for high-performance AB production."
    ],
    "it": [
      "Azienda agricola biologica. Vendita in azienda. Lavorazione di oltre 30 varietà antiche di mele da sidro francesi.\r\nLe mucche si occupano del frutteto, contribuendo all'ecosistema creato per una produzione biologica ad alto rendimento."
    ],
    "fr": [
      "Exploitation agricole en BIO. Vente à la ferme. Transformation de plus de 30 variétés anciennes de pommes à cidre françaises.\r\nDes vaches entretiennent le verger participant à l'écosystème mis en place pour une production AB performante."
    ],
    "es": [
      "Granja ecológica. Venta a domicilio. Transformación de más de 30 variedades antiguas de manzanas de sidra francesas.\r\nLas vacas cuidan el huerto, contribuyendo al ecosistema creado para la producción ecológica de alto rendimiento."
    ],
    "nl": [
      "Biologische boerderij. Verkoop op de boerderij. Verwerking van meer dan 30 oude Franse ciderappelvariëteiten.\r\nKoeien verzorgen de boomgaard en dragen bij aan het ecosysteem dat is opgezet voor een hoogwaardige biologische productie."
    ]
  },
  "rdfs:label": {
