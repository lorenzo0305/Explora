  "rdfs:comment": {
    "de": [
      "Der Trail von Dieulefit kehrt ein weiteres Jahr zurück, um noch mehr Herausforderung und Spaß zu bieten. Ab sofort können Sie Ihr Wochenende buchen. Es erwarten Sie drei anspruchsvolle Strecken auf technischen Waldpfaden"
    ],
    "en": [
      "The Dieulefit Trail is back for another year of challenge and pleasure. You can now book your weekend. Three demanding courses await you on technical forest trails"
    ],
    "it": [
      "Il sentiero Dieulefit torna per un altro anno, offrendo ancora più sfide e piacere. Potete prenotare subito il vostro weekend. Tre percorsi impegnativi vi aspettano su sentieri forestali tecnici"
    ],
    "fr": [
      "Le trail de Dieulefit revient une année de plus pour toujours plus de défi et de plaisir. Vous pouvez dès maintenant réserver votre week-end. Trois parcours exigeants vous attendent sur des sentiers forestiers techniques"
    ],
    "es": [
      "El Dieulefit Trail vuelve un año más para ofrecerte aún más desafíos y placeres. Ya puede reservar su fin de semana. Le esperan tres recorridos exigentes por senderos forestales técnicos"
    ],
    "nl": [
      "De Dieulefit Trail is terug voor een nieuw jaar en biedt nog meer uitdaging en plezier. Je kunt nu je weekend boeken. Drie veeleisende parcoursen wachten op je op technische bospaden"
    ]
  },
  "rdfs:label": {
    "fr": [
      "10ème édition Trail de Dieulefit"
    ]
  },
