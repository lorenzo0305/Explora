  "rdfs:comment": {
    "de": [
      "Im Skigebiet Aillons-Margériaz 1400 befindet sich der Rodelbereich rechts vom Teppich le P'tiou, neben dem nordischen Bereich."
    ],
    "en": [
      "The toboggan run is completely free!\r\n\r\nAt Aillons-Margeriaz 1400, the toboggan run is at the right of the P'tiou ski lift."
    ],
    "it": [
      "Nel comprensorio sciistico Aillons-Margériaz 1400, l'area slittino si trova a destra del tappeto P'tiou, accanto all'area nordica."
    ],
    "fr": [
      "Sur le domaine d'Aillons-Margériaz 1400, l'espace luge se situe à droite du tapis le P'tiou, à côté de l'espace nordique."
    ],
    "es": [
      "En el dominio esquiable de Aillons-Margériaz 1400, la zona de trineos se encuentra a la derecha de la alfombra P'tiou, junto a la zona nórdica."
    ],
    "nl": [
      "De sleebaan in het gebied Aillons-Margériaz 1400 bevindt zich rechts naast het nieuwe tapijt."
    ]
  },
