  "rdfs:comment": {
    "de": [
      "Das Bureau d'Information Touristique Bastille heißt Sie auf der Bastille-Festung herzlich willkommen! Hier finden Sie Tipps, Ideen für Spaziergänge, Informationsmaterial über Grenoble und seine Region sowie Souvenirs zum Mitnehmen...\r\nViel Spaß beim Besuch!"
    ],
    "en": [
      "The Tourist Information Office Bastille welcomes you to the Fort de la Bastille! Find advice, ideas for walks, documentation on Grenoble and its region as well as souvenirs to take away...\r\nEnjoy your visit!"
    ],
    "it": [
      "L'Ufficio del Turismo della Bastiglia vi dà il benvenuto al Forte della Bastiglia! Troverete consigli, idee per passeggiate, documentazione su Grenoble e la sua regione e souvenir da portare via...\r\nBuona visita!"
    ],
    "fr": [
      "Le Bureau d'Information Touristique Bastille vous souhaite la bienvenue sur le Fort de la Bastille ! Retrouvez des conseils, des idées balades, de la documentation sur Grenoble et sa région ainsi que des souvenirs à emporter...\r\nBonne visite !"
    ],
    "es": [
      "La Oficina de Turismo de la Bastilla le da la bienvenida al Fuerte de la Bastilla. Encontrará consejos, ideas para pasear, documentación sobre Grenoble y su región, así como recuerdos para llevar...\r\nDisfrute de su visita."
    ],
    "nl": [
      "Het VVV-kantoor van Bastille heet u welkom in het Fort van Bastille! Advies, ideeën voor wandelingen, documentatie over Grenoble en de regio en souvenirs om mee te nemen...\r\nGeniet van uw bezoek!"
    ]
  },
