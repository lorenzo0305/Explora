  "rdfs:comment": {
    "de": [
      "Die Küche des Restaurants im Hotel Les Roches Fleuries ist traditionell, raffiniert und lecker mit savoyischen Einflüssen. Auf der Speisekarte finden Sie auch eine \"Fruitière\"-Ecke, in der lokale Spezialitäten im Mittelpunkt stehen."
    ],
    "en": [
      "The cuisine at the Hôtel Les Roches Fleuries restaurant is traditional, refined and gourmet, with Savoyard influences. You'll also find a \"Fruitière\" corner on the menu, featuring local specialties."
    ],
    "it": [
      "La cucina del ristorante dell'Hôtel Les Roches Fleuries è tradizionale, raffinata e gourmet, con influenze savoiarde. Nel menu troverete anche un angolo \"Fruitière\", dove le specialità locali hanno un posto d'onore."
    ],
    "fr": [
      "La cuisine du restaurant de l'Hôtel Les Roches Fleuries se veut traditionnelle, raffinée et gourmande aux influences savoyardes. Vous trouverez également un coin « Fruitière » sur la carte où les spécialités locales sont mises à l’honneur."
    ],
    "es": [
      "La cocina del restaurante del Hotel Les Roches Fleuries es tradicional, refinada y gourmet con influencias saboyanas. También encontrará un rincón \"Fruitière\" en la carta, donde las especialidades locales ocupan un lugar destacado."
    ],
    "nl": [
      "De keuken van het restaurant van Hotel Les Roches Fleuries is traditioneel, verfijnd en gastronomisch met Savoyaardse invloeden. Op de kaart vindt u ook een \"Fruitière\"-hoek waar lokale specialiteiten centraal staan."
    ]
  },
