  "rdfs:comment": {
    "de": [
      "Der Spielplatz besteht aus zwei Bereichen: Minibagger, Hindernisparcours, Schaukel, Tischfußball, Tischtennisplatte... (ganzjährig geöffnet) und einem Bereich mit aufblasbaren Spielen, die während der Sommerferien dem Wetter unterliegen."
    ],
    "en": [
      "The playground comprises 2 areas: mini diggers, obstacle course, swing, table soccer, ping pong table... (open all year round) and an area with inflatable games subject to weather conditions during the summer vacations."
    ],
    "it": [
      "Il parco giochi dispone di 2 aree: mini scavatori, percorso a ostacoli, altalena, calcio balilla, ping pong... (aperto tutto l'anno) e un'area con giochi gonfiabili soggetta al tempo durante le vacanze estive."
    ],
    "fr": [
      "L'aire de jeux est composé de 2 espaces : mini pelleteuses, parcours d'obstacles, balançoire, babyfoot, table de ping pong... (ouvert à l'année) et un espace avec des jeux gonflables soumis à la météo durant les vacances d'été."
    ],
    "es": [
      "El parque infantil dispone de 2 zonas: miniexcavadoras, pista de obstáculos, columpio, futbolín, ping-pong... (abierto todo el año) y una zona con juegos hinchables sujeta a las condiciones meteorológicas durante las vacaciones de verano."
    ],
    "nl": [
      "De speeltuin heeft 2 zones: minigravers, hindernisbaan, schommel, tafelvoetbal, tafeltennis... (het hele jaar geopend) en een zone met opblaasbare speeltoestellen afhankelijk van het weer tijdens de zomervakantie."
    ]
  },
