  "rdfs:comment": {
    "de": [
      "Eine Lufttaufe in einem Heißluftballon ist ein einzigartiges Erlebnis, bei dem Sie sanft abheben und die Welt aus einer völlig neuen Perspektive betrachten können."
    ],
    "en": [
      "A first flight in a hot-air balloon is a unique experience that lets you soar gently and contemplate the world from a totally new point of view."
    ],
    "it": [
      "Il primo volo in mongolfiera è un'esperienza unica che permette di alzarsi in volo dolcemente e di contemplare il mondo da una prospettiva totalmente nuova."
    ],
    "fr": [
      "Un baptême de l’air en montgolfière est une expérience unique qui vous permet de vous envoler en douceur et de contempler le monde d’un point de vue totalement nouveau."
    ],
    "es": [
      "Un primer vuelo en globo aerostático es una experiencia única que le permite surcar los cielos suavemente y contemplar el mundo desde una perspectiva totalmente nueva."
    ],
    "nl": [
      "Een eerste vlucht in een heteluchtballon is een unieke ervaring waarbij je zachtjes het luchtruim kiest en de wereld vanuit een totaal nieuw perspectief bekijkt."
    ]
  },
  "rdfs:label": {
