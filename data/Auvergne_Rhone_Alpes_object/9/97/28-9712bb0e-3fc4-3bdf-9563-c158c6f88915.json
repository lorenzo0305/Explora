  "rdfs:comment": {
    "de": [
      "Das gefällt Ihnen: Der Blick zum Glasdach, das einen Blick auf das Labor gewährt, in dem alle Leckereien hergestellt werden, und die sehr leckeren Kuchen..."
    ],
    "en": [
      "You'll love the view through the glass roof to the laboratory where all the delicacies are made, and the gourmet cakes..."
    ],
    "it": [
      "Vi piacerà: la vista attraverso il tetto di vetro sul laboratorio dove vengono prodotte tutte le prelibatezze, e le torte da leccarsi i baffi..."
    ],
    "fr": [
      "Vous aimerez : la vue vers la verrière qui donne vue sur le laboratoire de fabrication de toutes les gourmandises et les gâteaux très gourmands..."
    ],
    "es": [
      "Le encantarán: las vistas a través del techo de cristal al laboratorio donde se elaboran todos los manjares, y los apetitosos pasteles..."
    ],
    "nl": [
      "Je zult genieten van: het uitzicht door het glazen dak op het laboratorium waar alle lekkernijen worden gemaakt, en de verrukkelijke taarten..."
    ]
  },
