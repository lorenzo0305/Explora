  "rdfs:comment": {
    "de": [
      "Sie wurde zwischen 1535 und 1543 von Louis Adhémar de Monteil, dem Herrn von Grignan, erbaut und beherbergte ursprünglich ein Kanoniker-Kolleg. Madame de Sévigné wurde hier 1696 beigesetzt. In der Kapelle der Jungfrau Maria beherbergt sie zum Jahresende eine wunderschöne Krippe."
    ],
    "en": [
      "Built between 1535 and 1543 by Louis Adhémar de Monteil, Seigneur de Grignan, it originally housed a college of canons. Madame de Sévigné was buried here in 1696. At the end of the year, a magnificent nativity scene is displayed in the Chapelle de la Vierge."
    ],
    "it": [
      "Costruito tra il 1535 e il 1543 da Louis Adhémar de Monteil, signore di Grignan, ospitava originariamente un collegio di canonici. Madame de Sévigné fu sepolta qui nel 1696. Alla fine dell'anno, un magnifico lettino viene esposto nella Cappella della Vergine."
    ],
    "fr": [
      "Construite de 1535 à 1543 par Louis Adhémar de Monteil, seigneur de Grignan, elle abrite à l'origine un collège de chanoines. Madame de Sévigné y sera enterrée en 1696. Elle accueille dans la Chapelle de la Vierge une magnifique crèche en fin d'année."
    ],
    "nl": [
      "Het werd tussen 1535 en 1543 gebouwd door Louis Adhémar de Monteil, heer van Grignan, en huisvestte oorspronkelijk een college van kanunniken. Madame de Sévigné werd hier in 1696 begraven. Aan het einde van het jaar staat er in de kapel van de Maagd Maria een prachtige kerststal."
    ],
    "es": [
      "Construido entre 1535 y 1543 por Louis Adhémar de Monteil, señor de Grignan, albergaba originalmente un colegio de canónigos. Madame de Sévigné fue enterrada aquí en 1696. Al final del año, se expone una magnífica cuna en la capilla de la Virgen."
    ]
  },
