  "rdfs:comment": {
    "de": [
      "Plaisians ist ein kleines, abgelegenes Dorf, das 11 km von Buis-les-Baronnies entfernt in einer Sackgasse liegt. Gegenüber von ihm und seinem grünen Land erhebt sich der Mont Ventoux."
    ],
    "en": [
      "Plaisians is a small, isolated village in a cul de sac, 11 km from Buis-les-Baronnies. Facing it and its lush green lands is Mont Ventoux."
    ],
    "it": [
      "Plaisians è un piccolo villaggio isolato, situato in un cul de sac a 11 km da Buis-les-Baronnies. Di fronte ad esso e alle sue verdi terre, si erge il Mont Ventoux."
    ],
    "fr": [
      "Plaisians est un petit village à part, isolé, situé dans un cul de sac à 11Km de Buis-les-Baronnies. Face à lui et ses terres verdoyantes se hisse le Mont Ventoux."
    ],
    "nl": [
      "Plaisians is een afgelegen dorpje in een doodlopende straat, 11 km van Buis-les-Baronnies. Tegenover het dorp en zijn weelderige groene landschap ligt de Mont Ventoux."
    ],
    "es": [
      "Plaisians es un pequeño pueblo aislado, situado en un callejón sin salida a 11 km de Buis-les-Baronnies. Frente a ella y sus verdes tierras, se alza el Mont Ventoux."
    ]
  },
