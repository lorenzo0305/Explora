  "rdfs:comment": {
    "de": [
      "Kirche-Tempel von Sainte Croix 11. bis 13. Jahrhundert ehemalige Kirche eines Priorats. Im Jahr 1562 wurde die reformierte Kirche in Sainte Croix \"aufgerichtet\" und ein Tempel oberhalb des Dorfes errichtet."
    ],
    "en": [
      "Church and temple of Sainte Croix XI-XIII century, old church from a priory. In 1562, the reformed church is set up at Sainte Croix and a temple is installed at the top of the village."
    ],
    "it": [
      "Chiesa-Tempio di Sainte Croix 11°-13° secolo, ex chiesa di un priorato. Nel 1562, la chiesa riformata fu \"eretta\" a Sainte Croix e un tempio fu installato in cima al villaggio."
    ],
    "fr": [
      "Eglise-Temple de Sainte Croix 11ème - 13ème siècle ancienne église d'un prieuré. En 1562,  l'église réformée est \"dressée\" à Sainte Croix et un  temple est installé en haut du village."
    ],
    "nl": [
      "Kerk-Tempel van Sainte Croix 11e-13e eeuwse voormalige priorijkerk. In 1562 werd de gereformeerde kerk \"opgericht\" in Sainte Croix en werd er een tempel gebouwd op de top van het dorp."
    ],
    "es": [
      "Iglesia-Templo de Sainte Croix Siglo XI - XIII antigua iglesia de un priorato. En 1562, se \"erigió\" la iglesia reformada en Sainte Croix y se instaló un templo en lo alto del pueblo."
    ]
  },
