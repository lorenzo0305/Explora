  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/897f2966-f79e-3866-b23c-7b99bd4f2e85",
      "dc:description": {
        "de": [
          "Sie empfangen Ihren Vierbeiner in einer gemütlichen Umgebung auf dem Land. Ihr Tier wird einzeln in einem komfortabel eingerichteten Raum untergebracht, der seinem Wohlbefinden gewidmet ist."
        ],
        "en": [
          "They welcome your companion in a warm country setting. Your pet will be accommodated individually in a comfortably furnished space dedicated to its well-being."
        ],
        "it": [
          "Accolgono il vostro compagno in un caldo ambiente di campagna. Il vostro animale sarà ospitato individualmente in uno spazio arredato in modo confortevole e dedicato al suo benessere."
        ],
        "fr": [
          "Ils accueillent votre compagnon dans un cadre chaleureux à la campagne. Votre animal sera logé individuellement dans un espace confortablement aménagé et dédié à son bien-être."
        ],
        "nl": [
          "Ze verwelkomen je metgezel in een warme, landelijke omgeving. Je huisdier wordt individueel opgevangen in een comfortabel ingerichte ruimte die helemaal is gericht op zijn welzijn."
        ],
        "es": [
          "Acogen a su compañero en un cálido entorno campestre. Su mascota será alojada individualmente en un espacio confortablemente amueblado y dedicado a su bienestar."
        ]
      },
      "@type": [
        "Description"
