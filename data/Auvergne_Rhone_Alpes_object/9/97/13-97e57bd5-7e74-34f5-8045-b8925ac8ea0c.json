  "rdfs:comment": {
    "de": [
      "Lust auf einen geselligen und landschaftlich reizvollen Ort in Seynod? In Seynod? Le Duplex empfängt Sie in einer tropischen und gemütlichen Umgebung, mit zwei Ebenen, einer Terrasse und einer exklusiven Bar, die ideal für Afterworks oder Partys mit Freunden ist."
    ],
    "en": [
      "Looking for a friendly, welcoming place in? Seynod? Le Duplex welcomes you in a tropical and cosy setting, with two levels, a terrace and an exclusive bar ideal for afterworks or evenings with friends."
    ],
    "it": [
      "Cercate un posto accogliente e amichevole a? Seynod? Le Duplex vi accoglie in un ambiente tropicale e accogliente, con due livelli, una terrazza e un bar esclusivo ideale per il dopo lavoro o le serate con gli amici."
    ],
    "fr": [
      "Envie d’un lieu convivial et dépaysant à Seynod ? Le Duplex vous accueille dans un cadre tropical et cosy, avec deux niveaux, une terrasse  et un bar extérieur idéal pour vos afterworks ou soirées entre amis."
    ],
    "es": [
      "¿Busca un lugar agradable y acogedor en? Seynod? Le Duplex le da la bienvenida en un ambiente tropical y acogedor, con dos niveles, una terraza y un bar exclusivo ideal para afterworks o veladas con amigos."
    ],
    "nl": [
      "Op zoek naar een vriendelijke, gastvrije plek in? Seynod? Le Duplex verwelkomt je in een tropische en gezellige omgeving, met twee verdiepingen, een terras en een exclusieve bar, ideaal voor na het werk of een avondje uit met vrienden."
    ]
  },
