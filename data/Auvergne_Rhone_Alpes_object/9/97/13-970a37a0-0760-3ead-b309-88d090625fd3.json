  "rdfs:comment": {
    "de": [
      "Zeit für sich selbst in der römischen Ära, weit weg von der Hektik der Stadt. Les Thermes erwartet Sie, um sich zu erholen."
    ],
    "en": [
      "Time for yourself in the Roman era... far from the hustle and bustle of the city, Les Thermes awaits you to recharge your batteries."
    ],
    "it": [
      "Tempo per se stessi in epoca romana, lontano dal trambusto della città, Les Thermes vi aspettano per fare il pieno di energia."
    ],
    "fr": [
      "Du temps pour soi à l’ère romaine, loin de l’agitation de la ville, Les Thermes vous attendent pour vous ressourcer."
    ],
    "nl": [
      "Tijd voor jezelf in de Romeinse tijd, ver van de drukte van de stad, wachten de Thermen op je om nieuwe energie op te doen."
    ],
    "es": [
      "Tiempo para usted en la época romana, lejos del bullicio de la ciudad, Les Thermes le esperan para recargar las pilas."
    ]
  },
