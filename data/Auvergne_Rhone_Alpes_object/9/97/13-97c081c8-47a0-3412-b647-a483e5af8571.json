  "rdfs:comment": {
    "de": [
      "Das Bar-Restaurant \"O'Poivre & Seb\" empfängt Sie im Herzen des Dorfes Périgneux und bietet Ihnen eine Küche mit frischen, lokalen und vor allem hausgemachten Produkten ..."
    ],
    "en": [
      "The bar-restaurant \"O'Poivre & Seb\" welcomes you in the heart of the village of Périgneux and offers you a cuisine based on fresh, local products and especially \"home-made\" ..."
    ],
    "it": [
      "Il bar-ristorante \"O'Poivre & Seb\" vi accoglie nel cuore del villaggio di Périgneux e vi propone una cucina a base di prodotti freschi e locali e soprattutto \"fatti in casa\" ..."
    ],
    "fr": [
      "Le bar restaurant \"O'Poivre & Seb\" vous accueille au cœur du village de Périgneux et vous propose une cuisine à base de produits frais, locaux et surtout du fait \"maison\" ..."
    ],
    "es": [
      "El bar-restaurante \"O'Poivre & Seb\" le da la bienvenida en el corazón del pueblo de Périgneux y le ofrece una cocina basada en productos frescos, locales y sobre todo \"caseros\" ..."
    ],
    "nl": [
      "De bar-restaurant \"O'Poivre & Seb\" verwelkomt u in het hart van het dorp Périgneux en biedt u een keuken op basis van verse, lokale producten en vooral \"home-made\" ..."
    ]
  },
