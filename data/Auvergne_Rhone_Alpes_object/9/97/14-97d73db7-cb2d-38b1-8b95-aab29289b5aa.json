  "rdfs:comment": {
    "de": [
      "Schnallen Sie sich an: Unsere Abschlussaufführung wird Sie zu den Sternen führen, auf den Wellen segeln und fantastische Welten mit Musik erkunden lassen!"
    ],
    "en": [
      "Fasten your seatbelts: our end-of-year show will take you across the stars, across the waves and into fantastic worlds of music!"
    ],
    "it": [
      "Allacciate le cinture: il nostro spettacolo di fine anno vi porterà oltre le stelle, oltre le onde e in fantastici mondi musicali!"
    ],
    "fr": [
      "Attachez vos ceintures : notre spectacle de fin d'année vous fera traverser les étoiles, voguer sur les flots et explorer des mondes fantastiques en musique !"
    ],
    "nl": [
      "Fasten your seatbelts: onze eindejaarsshow neemt je mee over de sterren, over de golven en naar fantastische muzikale werelden!"
    ],
    "es": [
      "Abróchense los cinturones: nuestro espectáculo de fin de curso les llevará a través de las estrellas, las olas y fantásticos mundos musicales"
    ]
  },
  "rdfs:label": {
