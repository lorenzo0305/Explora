  "rdfs:comment": {
    "de": [
      "Die 1406 als ruiniert beschriebene Prioratskirche ist ein Wiederaufbau aus dem 15. Jahrhundert, der von Vénérand und Barthélemy de la Farge, den Prioren von Lavoûte-Chilhac, in Auftrag gegeben wurde."
    ],
    "en": [
      "Described as ruined in 1406, the prioral church is a 15th-century reconstruction commissioned by Vénérand and Barthélemy de la Farge, prioresses of Lavoûte-Chilhac."
    ],
    "it": [
      "Descritta come diroccata nel 1406, la chiesa priorale è una ricostruzione del XV secolo commissionata da Vénérand e Barthélemy de la Farge, prioresse di Lavoûte-Chilhac."
    ],
    "fr": [
      "Décrite comme ruinée en 1406, l'église priorale est une reconstruction du XVème siècle commanditée par Vénérand et Barthélemy de la Farge, prieurs de Lavoûte-Chilhac."
    ],
    "es": [
      "Descrita como arruinada en 1406, la iglesia prioral es una reconstrucción del siglo XV encargada por Vénérand y Barthélemy de la Farge, prioras de Lavoûte-Chilhac."
    ],
    "nl": [
      "De priorijkerk, die in 1406 als ruïne werd beschreven, is een reconstructie uit de 15e eeuw in opdracht van Vénérand en Barthélemy de la Farge, prioressen van Lavoûte-Chilhac."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Église Sainte-Croix"
    ]
  },
