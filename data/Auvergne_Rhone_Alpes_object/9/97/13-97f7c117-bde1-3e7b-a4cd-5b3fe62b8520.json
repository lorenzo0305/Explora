  "rdfs:comment": {
    "de": [
      "Das Relais du Serre liegt in einer grünen, ruhigen Umgebung, 3 km von Dieulefit entfernt, und empfängt Sie in einer freundlichen Atmosphäre."
    ],
    "en": [
      "Situated in the peaceful countryside only 3 km away from Dieulefit, the Relais du Serre welcomes you in a warm and friendly atmosphere."
    ],
    "it": [
      "Situato in un ambiente verde, in una zona tranquilla, a 3 km da Dieulefit, il Relais du Serre vi accoglie in un'atmosfera amichevole."
    ],
    "fr": [
      "Situé dans un cadre de verdure, au calme, à 3 km de Dieulefit, le Relais du Serre vous accueillera dans une ambiance sympathique."
    ],
    "es": [
      "Situado en un entorno verde, en una zona tranquila, a 3 km de Dieulefit, el Relais du Serre le acoge en un ambiente acogedor."
    ],
    "nl": [
      "Le Relais du Serre, gelegen in een groen rustig landschap, op 3 km van Dieulefit, heet u welkom in een sympathieke ambiance."
    ]
  },
