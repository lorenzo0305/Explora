  "rdfs:comment": {
    "de": [
      "Entdecken Sie die pure Aufregung des Boardercross und einer inszenierten Piste in den Farben von Blanchot d'Aillons-Margériaz! Diese spannende Strecke, die über den Skilift La Bergerie erreichbar ist, bietet Ihnen ein einzigartiges Erlebnis."
    ],
    "en": [
      "Discover the pure excitement of boardercross and a scenic run in the colors of Blanchot d'Aillons-Margériaz! This thrilling course, accessible by the Bergerie ski lift, offers you a unique experience."
    ],
    "it": [
      "Scoprite l'emozione pura del boardercross e una pista panoramica nei colori di Blanchot d'Aillons-Margériaz! Questo percorso emozionante, accessibile con l'impianto di risalita della Bergerie, vi offre un'esperienza unica."
    ],
    "fr": [
      "Découvrez l'excitation pure du boardercross et d'une piste scénarisée aux couleurs de Blanchot d'Aillons-Margériaz ! Ce parcours palpitant, accessible par le téléski de la Bergerie, vous offre une expérience unique."
    ],
    "nl": [
      "Ontdek de pure spanning van boardercross en een schilderachtige afdaling in de kleuren van Blanchot d'Aillons-Margériaz! Dit spannende parcours, toegankelijk via de Bergerie skilift, biedt je een unieke ervaring."
    ],
    "es": [
      "Descubra la emoción pura del boardercross y un recorrido panorámico con los colores de Blanchot d'Aillons-Margériaz Este emocionante recorrido, accesible por el remonte de Bergerie, le ofrece una experiencia única."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Blanchot, le rebelle de la glisse - piste ludique"
    ]
  },
