  "rdfs:comment": {
    "de": [
      "Wir bieten kollektive schamanische Behandlungen in Form von Meditationen, schamanischen Gesängen, Kakaozeremonien und Schwitzhütten an.\r\nIdeal für Menschen, die sich wieder mit der Natur verbinden, Emotionen verarbeiten und Körper und Geist beruhigen wollen."
    ],
    "en": [
      "We offer group shamanic healing in the form of meditations, shamanic chanting, cocoa ceremonies and sweat lodges.\r\nIdeal for people who want to reconnect with nature, manage emotions, soothe body and mind."
    ],
    "it": [
      "Offriamo trattamenti sciamanici di gruppo sotto forma di meditazioni, canti sciamanici, cerimonie del cacao e capanne sudatorie.\r\nIdeale per chi vuole riconnettersi con la natura, affrontare le proprie emozioni e calmare il corpo e la mente."
    ],
    "fr": [
      "Nous proposons des soins chamaniques collectifs sous forme de méditations, chants chamaniques, cérémonies de cacao et huttes de sudation.\r\nIdéal pour les personnes qui veulent se reconnecter à la nature, gérer les émotions, apaiser le corps et l’esprit."
    ],
    "nl": [
      "Wij bieden sjamanistische healing in groep in de vorm van meditaties, sjamanistische zang, cacaoceremonies en zweethutten.\r\nIdeaal voor mensen die weer in contact willen komen met de natuur, emoties willen beheersen, lichaam en geest willen kalmeren."
    ],
    "es": [
      "Ofrecemos tratamientos chamánicos en grupo en forma de meditaciones, cantos chamánicos, ceremonias de cacao y cabañas de sudación.\r\nIdeal para personas que desean reconectar con la naturaleza, tratar sus emociones y calmar su cuerpo y su mente."
    ]
  },
  "rdfs:label": {
    "en": [
      "Hakena Shamanic Center"
    ],
    "fr": [
      "Centre chamanique Hakena"
    ],
    "nl": [
      "Hakena Sjamanistisch Centrum"
    ]
  },
