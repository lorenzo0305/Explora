        ],
        "en": [
          "Departure at 10 am from the Capitainerie.\nArrival at 12 noon at Le Touquet town hall (return by shuttle possible)."
        ],
        "it": [
          "Partenza alle ore 10 dalla Capitainerie.\nArrivo alle 12.00 al municipio di Le Touquet (possibilità di ritorno con bus navetta)."
        ],
        "fr": [
          "Départ à 10 h à la Capitainerie.\nArrivée à 12 h à l'hôtel de ville de Le Touquet (possibilité de retour par navette)."
