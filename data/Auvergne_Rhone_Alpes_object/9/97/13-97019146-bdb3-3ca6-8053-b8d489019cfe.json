  "rdfs:comment": {
    "de": [
      "Das Bureau des Moniteurs, Syndicat Local, bietet Ihnen für alle geeignete Outdoor-Ausflüge mit Fachleuten aus der Region an. Unser Markenzeichen ist das Abenteuer auf dem nachhaltigen Weg."
    ],
    "en": [
      "The Bureau des Moniteurs, a local association, offers outdoor excursions suitable for all with professional local guides. Our trademark: sustainable adventures."
    ],
    "it": [
      "Il Bureau des Moniteurs, Unione Locale, vi propone attività all'aria aperta adatte a tutti con i professionisti del territorio. Il nostro marchio, l'avventura sulla via sostenibile"
    ],
    "fr": [
      "Le Bureau des Moniteurs, Syndicat Local, vous propose des sorties de plein air adaptées à tous avec des professionnels du territoire.Notre marque de fabrique, l'aventure sur la voie durable"
    ],
    "nl": [
      "Het Bureau des Moniteurs, Syndicat Local, biedt u outdoor activiteiten aangepast aan iedereen met lokale professionals. Ons handelsmerk, avontuur op het duurzame pad."
    ],
    "es": [
      "El Bureau des Moniteurs, Unión Local, le propone actividades al aire libre adaptadas a todos con profesionales del territorio. Nuestra marca, la aventura en el camino sostenible"
    ]
  },
