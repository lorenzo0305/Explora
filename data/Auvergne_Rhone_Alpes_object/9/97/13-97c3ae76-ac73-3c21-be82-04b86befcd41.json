  "rdfs:comment": {
    "de": [
      "Fahren Sie die 2 km lange Piste zwischen Courchevel 1850 und Courchevel Village hinunter: Bereiten Sie sich auf einen echten Nervenkitzel im Herzen des Waldes vor, tagsüber oder nachts (denn die Piste ist vom Start bis zum Ziel vollständig beleuchtet!)"
    ],
    "en": [
      "Descend the 2km-long run between Courchevel 1850 and Courchevel Village: get ready to experience real thrills in the heart of the forest, during the day or at night (as the run is fully lit from start to finish!)."
    ],
    "it": [
      "Percorrete i 2 km di pista tra Courchevel 1850 e Courchevel Village: preparatevi a provare emozioni forti nel cuore della foresta, di giorno o di notte (la pista è completamente illuminata dall'inizio alla fine)"
    ],
    "fr": [
      "Dévalez les 2km de long de la piste entre Courchevel 1850 et Courchevel Village : préparez-vous à vivre de véritables sensations fortes au cœur de la forêt, en journée ou en nocturne (car la piste est entièrement éclairée du départ à l'arrivée !)"
    ],
    "es": [
      "Descienda por la pista de 2 km de longitud entre Courchevel 1850 y Courchevel Village: prepárese para vivir auténticas emociones en pleno bosque, de día o de noche (¡ya que la pista está totalmente iluminada de principio a fin!)"
    ],
    "nl": [
      "Daal het 2 km lange parcours af tussen Courchevel 1850 en Courchevel Village: maak je klaar voor echte sensatie in het hart van het bos, overdag of 's nachts (want het parcours is van begin tot eind volledig verlicht!)"
    ]
  },
  "rdfs:label": {
    "en": [
      "Sledge slope (Courchevel 1850 - Courchevel Village)"
    ],
    "fr": [
      "Piste de luge (Courchevel 1850 - Courchevel Village)"
    ]
  },
