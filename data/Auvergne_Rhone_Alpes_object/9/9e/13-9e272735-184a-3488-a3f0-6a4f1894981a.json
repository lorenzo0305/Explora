  "rdfs:comment": {
    "de": [
      "Im Jarjatte-Tal gelegener Ort, an dem traditionelle und familiäre Küche, hausgemachte Desserts, Gerichte zum Mitnehmen und gelegentliche Familienveranstaltungen tagsüber oder festliche Veranstaltungen am Abend angeboten werden. Möglichkeit der privaten Vermietung für Veranstaltungen mit verschiedenen Formeln."
    ],
    "en": [
      "A lively place in the Jarjatte valley, offering traditional family cuisine, homemade desserts, takeaways and occasional family events during the day or festive evenings. Possibility of private hire for events with various formulas."
    ],
    "it": [
      "La Jarjatte è un locale vivace che offre una cucina tradizionale in stile familiare, dolci fatti in casa, piatti da asporto e occasionali eventi per famiglie durante il giorno o nelle serate di festa. Possibilità di noleggio privato per vari eventi."
    ],
    "fr": [
      "Lieu de vie de la Jarjatte autour d'une cuisine traditionnelle et familiale, desserts maisons, plats à emporter et d'animations ponctuelles familiales en journée ou festives en soirée. Possibilité de location privée pour événements avec divers formules."
    ],
    "es": [
      "La Jarjatte es un lugar animado que ofrece cocina tradicional familiar, postres caseros, platos para llevar y eventos familiares ocasionales durante el día o las noches festivas. Alquiler privado disponible para diversos eventos."
    ],
    "nl": [
      "Een levendige plek in de Jarjatte-vallei, waar traditionele gerechten in familiestijl, huisgemaakte desserts, afhaalgerechten en af en toe familie-evenementen overdag of feestelijke avonden worden geserveerd. Privéverhuur mogelijk voor verschillende evenementen."
    ]
  },
  "rdfs:label": {
