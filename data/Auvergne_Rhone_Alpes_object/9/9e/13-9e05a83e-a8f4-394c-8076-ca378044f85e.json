  "rdfs:comment": {
    "de": [
      "Brasserie ab 7:30 Uhr morgens geöffnet. Mittagessen bis 16:30 Uhr im Sommer. Gruppen für Ihre Partys oder Geburtstage am Abend sind auf Reservierung willkommen."
    ],
    "en": [
      "Brasserie open from 7:30 in the morning. Lunch at noon until 4:30 in the summer. Welcome to groups for your parties or evening birthdays by reservation."
    ],
    "it": [
      "Brasserie aperta dalle 7.30. Pranzo fino alle 16.30 in estate. Su prenotazione, si accettano gruppi per feste o compleanni la sera."
    ],
    "fr": [
      "Brasserie ouverte dès 7h30 le matin. Repas à midi juqu'à 16h30 l'été. Bienvenue aux groupes pour vos fêtes ou anniversaires en soirée sur réservation."
    ],
    "nl": [
      "Brasserie open vanaf 7.30 uur. Lunch tot 16.30 uur in de zomer. Groepen zijn welkom voor feestjes of verjaardagen in de avond, op afspraak."
    ],
    "es": [
      "Brasserie abierta a partir de las 7.30 h. Almuerzo hasta las 16.30 en verano. Se aceptan grupos para fiestas o cumpleaños por la noche, previo acuerdo."
    ]
  },
