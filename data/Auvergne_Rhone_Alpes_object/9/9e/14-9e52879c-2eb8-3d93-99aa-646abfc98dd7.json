  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/7c79b2ba-85a8-3dad-a866-b9cf2737974d",
      "dc:description": {
        "de": [
          "\"Für die Fitness und das Wohlbefinden von Senioren\"\nWorkshops, Animationen, Vorführungen, Vorträge.\nVon 9.30 bis 18 Uhr, Salle des 4 Saisons.\n\nDer Eintritt ist frei.\nVerpflegung vor Ort durch das Café heureux."
        ],
        "en": [
          "\"For the fitness and well-being of seniors\"\nWorkshops, activities, demonstrations, conferences.\nFrom 9:30 am to 6 pm, salle des 4 Saisons.\n\nFree admission.\nOn-site catering by Café heureux."
        ],
        "it": [
          "\"Per la forma fisica e il benessere degli anziani\"\nWorkshop, eventi, dimostrazioni, conferenze.\nDalle 9.30 alle 18.00, sala delle 4 Saisons.\n\nIngresso libero.\nRistorazione a cura del Café heureux."
        ],
        "fr": [
          "\"Pour la forme et le bien-être des séniors\"\nAteliers, animations, démonstrations, conférences.\nDe 9h30 à 18h, salle des 4 Saisons.\n\nEntrée gratuite.\nRestauration sur place par le Café heureux."
        ],
        "nl": [
          "\"Voor de fitheid en het welzijn van senioren\"\nWorkshops, evenementen, demonstraties, lezingen.\nVan 9.30 tot 18.00 uur, salle des 4 Saisons.\n\nGratis toegang.\nVerzorgd door Café Heureux."
        ],
        "es": [
          "\"Por la forma física y el bienestar de las personas mayores\"\nTalleres, actos, demostraciones, conferencias.\nDe 9.30 a 18.00 horas, sala des 4 Saisons.\n\nEntrada gratuita.\nCatering a cargo del Café Heureux."
        ]
      },
