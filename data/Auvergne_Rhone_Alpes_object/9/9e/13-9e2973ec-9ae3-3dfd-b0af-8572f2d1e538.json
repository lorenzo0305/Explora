  "rdfs:comment": {
    "de": [
      "Küche des Marktes, lokale und saisonale Produkte. Herzliche und ungezwungene Atmosphäre. Bistronomisches Restaurant und naturbelassene Weine. Vor Ort: 2 Zimmer \r\nGästezimmer und auch ein Weinkeller"
    ],
    "en": [
      "Market cuisine, local and seasonal produce. Warm, relaxed atmosphere. Bistronomic restaurant and natural wines. On site: 2 guest rooms \r\nguest rooms and also a wine cellar."
    ],
    "it": [
      "Cucina di mercato, prodotti locali e di stagione. Ristorante bistronomico e vini naturali. In loco: 3 camere per gli ospiti e una cantina."
    ],
    "fr": [
      "Cuisine du Marché, produits locaux et de saison. Restaurant bistronomique et vins nature. Sur place : 3 chambres d'hôtes et une cave à vins."
    ],
    "nl": [
      "Marktkeuken, lokale en seizoensgebonden producten. Warme, ontspannen sfeer. Bistronomisch restaurant en natuurlijke wijnen. Ter plaatse: 2 gastenkamers \r\ngastenkamers, en ook een wijnkelder"
    ],
    "es": [
      "Cocina de mercado, productos locales y de temporada. Restaurante bistronómico y vinos naturales. En el establecimiento: 3 habitaciones y bodega."
    ]
  },
