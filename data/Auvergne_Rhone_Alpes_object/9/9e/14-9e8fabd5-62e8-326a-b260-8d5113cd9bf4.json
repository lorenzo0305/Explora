  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/1a692617-9dd8-39db-90ae-61942b6dbc69",
      "dc:description": {
        "de": [
          "Informationen :\n\nÖffnungszeiten:\nMontag bis Freitag von 9:00 bis 12:00 Uhr und von 14:00 bis 19:00 Uhr\nSamstags von 9:00 bis 12:00 Uhr\n\nSonntag geschlossen\n \n Abholung:\nZu den Öffnungszeiten der Apotheke\n\n\n "
        ],
        "en": [
          "Information :\n\nOpening days :\nMonday to Friday, 9am to 12pm and 2pm to 7pm\nSaturday from 9h to 12h\n\nClosed on Sunday\n \n Pick-up :\nDuring pharmacy opening hours\n\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nOrari di apertura :\nDal lunedì al venerdì, dalle 9.00 alle 12.00 e dalle 14.00 alle 19.00\nSabato dalle 9.00 alle 12.00\n\nChiuso la domenica\n \n Ritiro:\nDurante gli orari di apertura della farmacia\n\n\n "
        ],
        "fr": [
          "Informations :\n\nJours d'ouverture : \nDu lundi au vendredi de 9h à 12h et de 14h à 19h\nLe samedi de 9h à 12h\n\nFermeture le dimanche\n \n Retrait :\nAux horaires d'ouverture de l'officine\n\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningstijden :\nMaandag tot vrijdag van 9u tot 12u en van 14u tot 19u\nZaterdag van 9 tot 12 uur\n\nZondag gesloten\n \n Afhalen:\nTijdens openingsuren van de apotheek\n\n\n "
        ],
        "es": [
          "Más información :\n\nHorarios de apertura :\nDe lunes a viernes de 9h a 12h y de 14h a 19h\nSábado de 9h a 12h\n\nDomingo cerrado\n \n Recogida:\nDurante el horario de apertura de la farmacia\n\n\n "
        ]
      },
