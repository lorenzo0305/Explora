  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/76d51907-5bd6-3e86-ade8-4d9a051ce054",
      "dc:description": {
        "de": [
          "Die Brasserie des Campingplatzes L?Orée du Bois empfängt Sie in einer geselligen Atmosphäre mit einer Schiefertafelkarte, frischen Produkten und einer Sonnenterrasse\n\nGeöffnet von April bis Oktober"
        ],
        "en": [
          "The brasserie at Camping L'Orée du Bois welcomes you in a friendly atmosphere with its à la carte menu, fresh produce and sunny terrace\n\nOpen from April to October"
        ],
        "it": [
          "La brasserie del campeggio L'Orée du Bois vi accoglie in un'atmosfera amichevole con il suo menu à la carte, i prodotti freschi e la terrazza soleggiata\n\nAperto da aprile a ottobre"
        ],
        "fr": [
          "La brasserie du Camping L’Orée du Bois vous accueille dans une ambiance conviviale avec sa carte à l’ardoise, ses produits frais, et sa terrasse ensoleillée\n\nOuvert d’avril à octobre"
        ],
        "es": [
          "La brasserie del camping L'Orée du Bois le da la bienvenida en un ambiente acogedor con su menú a la carta, sus productos frescos y su soleada terraza\n\nAbierto de abril a octubre"
        ],
        "nl": [
          "De brasserie van camping L'Orée du Bois verwelkomt je in een gezellige sfeer met een à la carte menu, verse producten en een zonnig terras\n\nGeopend van april tot oktober"
        ]
      },
