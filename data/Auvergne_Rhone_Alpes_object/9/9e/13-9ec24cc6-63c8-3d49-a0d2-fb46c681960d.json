  "rdfs:comment": {
    "de": [
      "Unser Küchenchef bietet Ihnen die abwechslungsreiche Speisekarte in einem angenehmen Rahmen, im Saal und auf der Terrasse. Die Qualität der Produkte und der Empfang sind die Garantie für angenehme Momente in unserem Lokal."
    ],
    "en": [
      "Our head cook offers you a wide menu in a pleasant atmosphere (in the restaurant and on the terrace). The quality of our products and our hospitality are the guarantee of pleasant moments in our restaurant."
    ],
    "it": [
      "Il nostro chef vi offre un menu vario in un ambiente piacevole, nella sala da pranzo e sulla terrazza. La qualità dei prodotti e l'accoglienza garantiscono momenti piacevoli nella nostra struttura."
    ],
    "fr": [
      "Notre chef cuisinier vous propose la carte variée dans un cadre agréable, en salle et en terrasse. La qualité des produits et de l’accueil seront la garantie d’agréables moments dans notre établissement."
    ],
    "nl": [
      "Onze chef biedt u een gevarieerd menu in een aangenaam kader, in de eetzaal en op het terras. De kwaliteit van de producten en de ontvangst staan garant voor aangename momenten in ons etablissement."
    ],
    "es": [
      "Nuestro chef le ofrece un menú variado en un entorno agradable, en el comedor y en la terraza. La calidad de los productos y la acogida garantizan momentos agradables en nuestro establecimiento."
    ]
  },
  "rdfs:label": {
    "en": [
      "Chalet du Verney"
    ],
