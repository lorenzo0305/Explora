  "rdfs:comment": {
    "de": [
      "Die Auberge du Savel bietet verschiedene Speisen und Getränke an, mit denen Sie sich bei einem Besuch oder einem längeren Aufenthalt in Clavans en Haut Oisans erholen können."
    ],
    "en": [
      "L'Auberge du Savel offers a wide range of food and drink to help you recharge your batteries during a visit or extended stay in Clavans en Haut Oisans."
    ],
    "it": [
      "L'Auberge du Savel offre una gamma di cibi e bevande per aiutarvi a ricaricare le batterie durante una visita o un soggiorno prolungato a Clavans en Haut Oisans."
    ],
    "fr": [
      "L'Auberge du Savel propose plusieurs mets et boissons permettant de se ressourcer lors d'un passage ou d'un séjour prolongé à Clavans en Haut Oisans."
    ],
    "es": [
      "El Auberge du Savel ofrece una gama de alimentos y bebidas para ayudarle a recargar las pilas durante una visita o una estancia prolongada en Clavans en Haut Oisans."
    ],
    "nl": [
      "De Auberge du Savel biedt een scala aan eten en drinken om je te helpen nieuwe energie op te doen tijdens een bezoek of een langer verblijf in Clavans en Haut Oisans."
    ]
  },
  "rdfs:label": {
