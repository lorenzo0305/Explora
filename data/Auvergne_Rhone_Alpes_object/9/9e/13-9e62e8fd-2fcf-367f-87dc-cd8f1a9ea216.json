  "rdfs:comment": {
    "de": [
      "Inspiriert von den Gewohnheiten der Afterwork-Branche, vereint My Beers an einem Ort eine riesige Auswahl an Craft-Bieren und Street-Food, zu den Klängen von DJs und Themenabenden, die den Alltag in unserer Bar bestimmen."
    ],
    "en": [
      "Inspired by afterwork habits, My Beers brings together a huge selection of craft beers and street-food in one place, to the sound of DJs and themed evenings that punctuate the daily life of our bar."
    ],
    "it": [
      "Ispirato alle abitudini del dopolavoro, My Beers riunisce in un unico luogo una vasta scelta di birre artigianali e street food, al suono di DJ e serate a tema che scandiscono la vita quotidiana del nostro bar."
    ],
    "fr": [
      "Inspirée des habitudes de l’afterwork, My Beers réunit dans un même lieu un énorme choix de bières craft et de street-food, au son des DJs et des soirées à thèmes qui rythment le quotidien de notre bar."
    ],
    "nl": [
      "My Beers, geïnspireerd door gewoontes na het werk, brengt op één plek een enorme keuze aan ambachtelijke bieren en streetfood samen, op de klanken van dj's en thema-avonden die het dagelijkse leven van onze bar opluisteren."
    ],
    "es": [
      "Inspirado en los hábitos afterwork, My Beers reúne en un solo lugar una enorme selección de cervezas artesanales y comida callejera, al son de DJs y veladas temáticas que jalonan la vida diaria de nuestro bar."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Bar My Beers"
    ]
  },
