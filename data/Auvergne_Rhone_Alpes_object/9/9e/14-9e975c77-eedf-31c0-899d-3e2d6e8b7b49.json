  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/f54f7962-fdbe-3799-9f68-2fbbe3f55b00",
      "dc:description": {
        "de": [
          "Feiern wir die Feiertage!\nProgramm vom 4. Dez. 2025 bis Freitag, 2. Jan. 2026\nÜberall in der Gemeinde Montreuil\n-------------------------------\nWeihnachtsmärkte, Konzerte, Theater, Aufführungen, Animationen?\n\nUm alle Veranstaltungen zu sehen, können Sie das Dokument herunterladen, indem Sie auf die Schaltfläche auf der rechten Seite Ihres Bildschirms klicken.\nWir wünschen Ihnen ein frohes Weihnachtsfest und ein gutes neues Jahr!\n \nCredit: Manon Herdier"
        ],
        "en": [
          "Celebrate the holiday season!\nProgram from Dec. 4, 2025 to Friday, Jan. 2, 2026\nThroughout Montreuil\n-------------------------------\nChristmas markets, concerts, theater, shows, entertainment...\n\nTo see all the events, you can download the document by clicking on the button on the right of your screen.\nWe wish you a merry Christmas and a happy New Year!\n \nCredit: Manon Herdier"
        ],
        "it": [
          "Festeggiate le festività!\nProgramma dal 4 dicembre 2025 a venerdì 2 gennaio 2026\nIn tutta Montreuil\n-------------------------------\nMercatini di Natale, concerti, teatro, spettacoli, intrattenimento, ecc.\n\nPer vedere tutti gli eventi, potete scaricare il documento cliccando sul pulsante a destra dello schermo.\nVi auguriamo buon Natale!\n \nCredito: Manon Herdier"
        ],
        "fr": [
          "Fêtons les fêtes de fin d’année !\nProgramme du 4 déc. 2025 au vendredi 2 janv. 2026\nPartout dans la commune de Montreuil\n-------------------------------\nMarchés de Noël, concerts, théâtre, spectacles, animations….\n\nPour apprécier l’ensemble des événements, vous pouvez télécharger le document en cliquant sur le bouton à droite de votre écran.\nBonne lecture et… Nous vous souhaitons de joyeuses fêtes de fin d’année !\n \nCrédit : Manon Herdier"
        ],
        "nl": [
          "Vier de feestdagen!\nProgramma van 4 dec. 2025 tot vrijdag 2 jan. 2026\nIn heel Montreuil\n-------------------------------\nKerstmarkten, concerten, theater, shows, entertainment, enz.\n\nOm alle evenementen te zien, kun je het document downloaden door op de knop rechts op je scherm te klikken.\nWe wensen u veel plezier tijdens de feestdagen!\n \nKrediet: Manon Herdier"
        ],
        "es": [
          "Celebra las fiestas\nPrograma del 4 de diciembre de 2025 al viernes 2 de enero de 2026\nEn todo Montreuil\n-------------------------------\nMercados navideños, conciertos, teatro, espectáculos, animaciones, etc.\n\nPara ver todos los eventos, puede descargar el documento haciendo clic en el botón de la derecha de su pantalla.\nEsperamos que disfrute de estas fiestas\n \nCrédito: Manon Herdier"
        ]
      },
