  "rdfs:comment": {
    "de": [
      "Food-Truck, der sich auf hausgemachte asiatische Küche spezialisiert hat und von einer saisonalen, von Woche zu Woche wechselnden Speisekarte geleitet wird."
    ],
    "en": [
      "A food truck specializing in homemade Asian cuisine, led by a seasonal menu that changes from week to week."
    ],
    "it": [
      "Food-Truck specializzato in cucina asiatica casalinga, con un menu stagionale che cambia di settimana in settimana."
    ],
    "fr": [
      "Food-Truck spécialisé en cuisine asiatique maison dont la direction est assurée par une carte de saison, changeante d'une semaine à l'autre."
    ],
    "es": [
      "Food-Truck especializado en cocina asiática casera, dirigido por un menú de temporada que cambia de semana en semana."
    ],
    "nl": [
