  "rdfs:comment": {
    "de": [
      "Diese Boutique in den malerischen Gassen von Crémieu ist ein Muss für Liebhaber von handgefertigtem Schmuck und Lithotherapie. Eine große Auswahl an einzigartigen Kreationen aus Halbedelsteinen, gibt es hier zu entdecken."
    ],
    "en": [
      "Set in the picturesque streets of Crémieu, this boutique is a must for lovers of handcrafted jewellery and lithotherapy. Discover a wide range of unique creations in semi-precious stones."
    ],
    "it": [
      "Situata nelle pittoresche strade di Crémieu, questa boutique è una tappa obbligata per gli amanti della gioielleria artigianale e della litoterapia. Scoprite un'ampia gamma di creazioni uniche in pietre semipreziose."
    ],
    "fr": [
      "Installée dans les ruelles pittoresques de Crémieu, cette boutique est un lieu incontournable pour les amateurs de bijoux artisanaux et de lithothérapie. Une large gamme de créations uniques en pierres semi-précieuses, sont à y découvrir."
    ],
    "es": [
      "Situada en las pintorescas calles de Crémieu, esta boutique es una visita obligada para los amantes de la joyería artesanal y la litoterapia. Descubra una amplia gama de creaciones únicas en piedras semipreciosas."
    ],
    "nl": [
      "Deze boetiek ligt in de pittoreske straatjes van Crémieu en is een must voor liefhebbers van handgemaakte sieraden en lithotherapie. Ontdek een breed scala aan unieke creaties van halfedelstenen."
    ]
  },
  "rdfs:label": {
    "en": [
