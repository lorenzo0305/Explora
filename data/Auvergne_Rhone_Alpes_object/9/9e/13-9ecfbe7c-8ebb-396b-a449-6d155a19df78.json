  "rdfs:comment": {
    "de": [
      "Frische, hausgemachte Produkte, unter der Woche mittags ein Tagesmenü, abends und am Wochenende eine aufwendigere, der Jahreszeit angepasste Speisekarte.\r\nEmpfohlen vom Guide du Routard seit 2017 und vom Petit Futé 2021/2022."
    ],
    "en": [
      "Fresh and homemade products, midday during the day a daily menu, and evenings and weekends with a more elaborate menu, adapted to the season."
    ],
    "it": [
      "Prodotti freschi e fatti in casa, un menu giornaliero a pranzo durante la settimana e un menu più elaborato la sera e nei fine settimana, adattato alla stagione.\r\nRaccomandato dalla Guide du Routard dal 2017 e dal Petit Futé 2021/2022."
    ],
    "fr": [
      "Produits frais et fait maison, les midis en semaine un menu du jour, et les soirs et week-end avec une carte plus élaborée, adaptée à la saison.\r\nRecommandé par le guide du Routard depuis 2017 et le Petit Futé 2021/2022."
    ],
    "nl": [
      "Verse, zelfgemaakte producten, een dagmenu tijdens de lunch tijdens de week, en een uitgebreider menu 's avonds en in het weekend, aangepast aan het seizoen.\r\nAanbevolen door de Guide du Routard sinds 2017 en de Petit Futé 2021/2022."
    ],
    "es": [
      "Productos frescos y caseros, un menú diario al mediodía durante la semana, y un menú más elaborado por las noches y los fines de semana, adaptado a la temporada.\r\nRecomendado por la Guide du Routard desde 2017 y el Petit Futé 2021/2022."
    ]
  },
