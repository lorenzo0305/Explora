      "schema:openingHoursSpecification": [
        {
          "@id": "https://data.datatourisme.fr/3c0fd427-2826-3585-ac60-19676bab6287",
          "schema:validFrom": "2026-01-01T00:00:00",
          "schema:validThrough": "2026-12-31T23:59:59",
          "@type": [
            "schema:OpeningHoursSpecification"
          ],
          "additionalInformation": {
            "de": [
              "Vom 1. Juli bis zum 31. August :\r\nTäglich geöffnet von 10:00 bis 19:00 Uhr\r\n\r\nVom 1. September bis zum 30. Juni :\r\nTäglich von 10:00 bis 18:00 Uhr geöffnet\r\nAußerhalb der Schulferien und an Feiertagen: Montagmorgen bis 13 Uhr geschlossen\r\nAn Wochenenden und Feiertagen von 10 bis 13 Uhr und von 14 bis 18 Uhr\r\nGeschlossen am 25. Dezember und am 1\r\nAn Sonntagen im Januar und November geschlossen."
            ],
            "en": [
              "From July 1st to August 31st :\r\nOpen every day from 10am to 7pm\r\n\r\nFrom September 1st to June 30th :\r\nOpen every day from 10am to 6pm\r\nClosed on Monday mornings until 1 pm except during school and public holidays\r\nWeek-ends and holidays from 10am to 1pm and 2pm to 6pm\r\nClosed on December 25 and January 1\r\nClosed on Sundays in January and November."
            ],
            "it": [
              "Dal 1° luglio al 31 agosto :\r\nAperto tutti i giorni dalle 10.00 alle 19.00\r\n\r\nDal 1° settembre al 30 giugno:\r\nAperto tutti i giorni dalle 10.00 alle 18.00\r\nChiuso il lunedì mattina fino alle 13.00, tranne durante le vacanze scolastiche e i giorni festivi\r\nFine settimana e giorni festivi dalle 10.00 alle 13.00 e dalle 14.00 alle 18.00\r\nChiuso il 25 dicembre e il 1° gennaio\r\nChiuso la domenica in gennaio e novembre."
            ],
            "fr": [
              "Du 1er juillet au 31 août :\r\nOuvert tous les jours de 10h à 19h\r\n\r\nDu 1er septembre au 30 juin :\r\nOuvert tous les jours de 10h à 18h\r\nFermé le lundi matin jusqu’à 13 heures hors vacances scolaires et jours fériés\r\nWeek-ends et jours fériés de 10h à 13h et de 14h à 18h\r\nFermeture le 25 décembre et le 1er janvier\r\nFermé les dimanches de janvier et novembre."
            ],
            "nl": [
              "Van 1 juli tot 31 augustus :\r\nDagelijks geopend van 10 tot 19 uur\r\n\r\nVan 1 september tot 30 juni:\r\nElke dag geopend van 10 tot 18 uur\r\nGesloten op maandagochtend tot 13.00 uur behalve tijdens schoolvakanties en feestdagen\r\nWeekends en feestdagen van 10 tot 13 uur en van 14 tot 18 uur\r\nGesloten op 25 december en 1 januari\r\nGesloten op zondag in januari en november."
            ],
            "es": [
              "Del 1 de julio al 31 de agosto :\r\nAbierto todos los días de 10 a 19 horas\r\n\r\nDel 1 de septiembre al 30 de junio:\r\nAbierto todos los días de 10 a 18 horas\r\nCerrado los lunes por la mañana hasta las 13:00 horas, excepto durante las vacaciones escolares y los días festivos\r\nFines de semana y festivos de 10 a 13 y de 14 a 18 horas\r\nCerrado el 25 de diciembre y el 1 de enero\r\nCerrado los domingos de enero y noviembre."
            ]
          },
