  "rdfs:comment": {
    "de": [
      "Das Hill Club Restaurant bietet ein innovatives Konzept, das auf \"Californian vibes & food\" basiert. Auf dem Programm steht eine gesunde und wärmende kalifornische Küche, die sich vom Frühstück bis zum Abendessen entwickelt. Außerdem gibt es ein Coffee-Shop-Angebot, in dem Sie zu jeder Tageszeit einen Snack zu sich nehmen können."
    ],
    "en": [
      "The Hill Club restaurant offers an innovative concept based on Californian vibes & food. On the menu: healthy, comforting Californian cuisine from breakfast to dinner. There's also a coffee shop for snacks at any time."
    ],
    "it": [
      "Il ristorante Hill Club offre un concetto innovativo basato sulle vibrazioni e sul cibo californiano. In programma: una cucina californiana sana e confortevole, dalla colazione alla cena. E anche una caffetteria per uno spuntino in qualsiasi momento."
    ],
    "fr": [
      "Le Hill Club restaurant propose un concept novateur basé sur la « Californian vibes & food ». Au programme, une cuisine californienne saine et réconfortante qui évolue du petit-déjeuner au dîner. Et aussi une offre coffee shop pour snacker à toute heure."
    ],
    "nl": [
      "Het Hill Club restaurant biedt een innovatief concept gebaseerd op Californische vibes & eten. Op het programma: gezonde en comfortabele Californische gerechten van ontbijt tot diner. En ook een koffieshop voor snacks op elk moment."
    ],
    "es": [
      "El restaurante Hill Club ofrece un concepto innovador basado en las \"vibraciones y la comida californianas\". En el programa: cocina californiana sana y reconfortante desde el desayuno hasta la cena. Y también una cafetería para merendar a cualquier hora."
    ]
  },
