  "rdfs:comment": {
    "de": [
      "Ehemaliges Jagdhaus und Nebengebäude des Schlosses Mareste, das von den Rittern des Hospitalordens vom Heiligen Johannes von Jerusalem erbaut wurde. Einige Teile sollen aus dem 11. oder 12. Jahrhundert stammen (Privatbesitz)."
    ],
    "en": [
      "Former hunting lodge and outbuildings of Château de Mareste, built by the Knights of the Hospitaller Order of Saint John of Jerusalem. Some parts date back to the 11th or 12th century (private property)."
    ],
    "it": [
      "Ex residenza di caccia e annessi del Castello di Mareste, costruito dai Cavalieri dell'Ordine Ospedaliero di San Giovanni di Gerusalemme. Alcune parti risalgono all'XI o al XII secolo (proprietà privata)."
    ],
    "fr": [
      "Ancien pavillon de chasse et dépendances du château de Mareste construit par les chevaliers de l'ordre hospitalier de Saint-Jean de Jérusalem. Certaines parties remonteraient au XIème ou XIIème siècle (propriété privée)."
    ],
    "nl": [
      "Voormalig jachtslot en bijgebouwen van het Château de Mareste gebouwd door de Hospitaalridders van Sint Jan van Jeruzalem. Sommige delen dateren uit de 11e of 12e eeuw (privé-eigendom)."
    ],
    "es": [
      "Antiguo pabellón de caza y dependencias del castillo de Mareste construido por los Caballeros de la Orden Hospitalaria de San Juan de Jerusalén. Algunas partes datan de los siglos XI o XII (propiedad privada)."
    ]
  },
