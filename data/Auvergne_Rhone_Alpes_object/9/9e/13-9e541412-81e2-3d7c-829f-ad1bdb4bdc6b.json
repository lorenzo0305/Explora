  "rdfs:comment": {
    "de": [
      "Die interkommunale Mediathek befindet sich seit 1988 im Centre Culturel Louis Jannel, einer öffentlichen Kultureinrichtung von Grand Bourg Agglomération, in der auch die interkommunale Musikschule untergebracht ist."
    ],
    "en": [
      "Since 1988, the Intercommunal Media Library has been located in the Centre Culturel Louis Jannel, a public cultural facility owned by Grand Bourg Agglomération, which also houses the Intercommunal Music School."
    ],
    "it": [
      "Dal 1988, la Mediateca Intercomunale si trova nel Centre Culturel Louis Jannel, una struttura culturale pubblica di proprietà della Grand Bourg Agglomération, che ospita anche la Scuola Intercomunale di Musica."
    ],
    "fr": [
      "La Médiathèque Intercommunale est implantée depuis 1988 dans le Centre Culturel Louis Jannel, équipement public culturel de Grand Bourg Agglomération, qui accueille également l’Ecole de Musique Intercommunale."
    ],
    "nl": [
      "Sinds 1988 is de Intercommunale Mediatheek gevestigd in het Centre Culturel Louis Jannel, een openbare culturele voorziening die eigendom is van Grand Bourg Agglomération, waar ook de Intercommunale Muziekschool is gehuisvest."
    ],
    "es": [
      "Desde 1988, la Mediateca Intercomunal se encuentra en el Centre Culturel Louis Jannel, un equipamiento cultural público propiedad de Grand Bourg Agglomération, que también alberga la Escuela de Música Intercomunal."
    ]
  },
  "rdfs:label": {
