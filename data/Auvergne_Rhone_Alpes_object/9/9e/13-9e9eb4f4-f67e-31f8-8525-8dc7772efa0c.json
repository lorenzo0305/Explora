  "rdfs:comment": {
    "de": [
      "Produzent von Weinen aus dem Bugey, unsere Weinberge befinden sich in Andert & Condon in der Nähe von Belley\r\nWir haben uns dafür entschieden, unseren Verkostungskeller auf dem Plateau d'Hauteville, wo wir wohnen, einzurichten."
    ],
    "en": [
      "Producer of Bugey wines, our vineyards are located in Andert & Condon near Belley.\r\nWe have chosen to set up our tasting cellar on the Plateau d'Hauteville, where we live."
    ],
    "it": [
      "Produttore dei vini Bugey, i nostri vigneti si trovano ad Andert e Condon, vicino a Belley\r\nAbbiamo scelto di allestire la nostra cantina di degustazione sul Plateau d'Hauteville, dove viviamo."
    ],
    "fr": [
      "Producteur de vins du Bugey, nos vignes sont situées à Andert & Condon à côté de Belley. \r\nNous avons fait le choix d'installer notre caveau de dégustation sur le Plateau d'Hauteville, où nous résidons."
    ],
    "es": [
      "Productor de vinos Bugey, nuestros viñedos están situados en Andert y Condon, cerca de Belley\r\nHemos elegido instalar nuestra bodega de degustación en el Plateau d'Hauteville, donde vivimos."
    ],
    "nl": [
      "Producent van Bugey wijnen, onze wijngaarden liggen in Andert & Condon bij Belley\r\nWij hebben ervoor gekozen onze proefkelder in te richten op het Plateau d'Hauteville, waar wij wonen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Caveau Pelillo"
    ]
  },
