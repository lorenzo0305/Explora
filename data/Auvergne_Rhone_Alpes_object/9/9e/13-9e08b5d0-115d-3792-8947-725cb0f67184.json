  "rdfs:comment": {
    "de": [
      "Das ganzjährig geöffnete Hotel ist nicht nur ein Ort für Urlauber, sondern ein echter lokaler Akteur, der am Dorfleben teilnimmt."
    ],
    "en": [
      "Open all year round, the hotel is not only a place for holidaymakers, but a real local actor who participates in the life of the village."
    ],
    "it": [
      "Aperto tutto l'anno, l'hotel non è solo un luogo di villeggiatura, ma un vero e proprio protagonista della vita del villaggio."
    ],
    "fr": [
      "Ouvert toute l’année, l’hôtel n’est pas seulement un lieu pour les vacanciers, mais un réel acteur local qui participe à la vie du village."
    ],
    "nl": [
      "Het hotel is het hele jaar geopend en is niet alleen een plek voor vakantiegangers, maar ook een echte lokale acteur die deelneemt aan het leven van het dorp."
    ],
    "es": [
      "Abierto todo el año, el hotel no es sólo un lugar para veraneantes, sino un auténtico protagonista de la vida del pueblo."
    ]
  },
