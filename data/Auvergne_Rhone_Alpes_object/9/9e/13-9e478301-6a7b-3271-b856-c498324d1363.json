  "rdfs:comment": {
    "de": [
      "Der Verein 106Snowscoot und der Skiort Super Besse freuen sich, am 21. und 22. März 2026 eine Etappe der Snowscoot Tour 2026 ausrichten zu dürfen."
    ],
    "en": [
      "The 106Snowscoot association and the Super Besse resort are delighted to host a stage of the Snowscoot Tour 2026 on March 21 & 22, 2026."
    ],
    "it": [
      "L'associazione 106Snowscoot e il resort Super Besse sono lieti di ospitare una tappa dello Snowscoot Tour 2026 il 21 e 22 marzo 2026."
    ],
    "fr": [
      "L'association 106Snowscoot et la station Super Besse sont heureux d’accueillir une étape du Snowscoot Tour 2026 les 21 & 22 Mars 2026."
    ],
    "es": [
      "La asociación 106Snowscoot y la estación de Super Besse se complacen en acoger una etapa del Snowscoot Tour 2026 los días 21 y 22 de marzo de 2026."
    ],
    "nl": [
      "De 106Snowscoot vereniging en het Super Besse resort zijn verheugd om gastheer te zijn van een etappe van de Snowscoot Tour 2026 op 21 & 22 maart 2026."
    ]
