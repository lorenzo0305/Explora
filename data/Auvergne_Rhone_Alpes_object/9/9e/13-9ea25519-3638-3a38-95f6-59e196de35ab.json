  "rdfs:comment": {
    "de": [
      "Pierre-Alexis Badoux, der 2005 mit der Goldmedaille des besten Lehrlings Frankreichs ausgezeichnet wurde, bietet Folgendes an: Aufarbeitung von Sitzmöbeln aller alten und modernen Stilrichtungen. Verkauf von Möbeln und Teppichen. Anfertigung von Vorhängen und Doppelvorhängen, Stoffen, Gardinen, Gestänge."
    ],
    "en": [
      "Gold Medal of the Best Apprentice in France in 2005, Pierre-Alexis Badoux offers: repair of seats in any style, old or modern. Sale of furniture and carpets. Making of curtains and double curtains, fabrics, veiling, rods."
    ],
    "it": [
      "Pierre-Alexis Badoux ha vinto la medaglia d'oro come miglior apprendista in Francia nel 2005. Vendita di mobili e tappeti. Produzione di tende e tende doppie, tessuti, teli, tondini."
    ],
    "fr": [
      "Médaille d'Or du Meilleur apprenti de France en 2005, Pierre-Alexis Badoux propose : réfection de sièges de tout style ancien ou moderne. Vente de mobilier et tapis. Confection de rideaux et de double-rideaux, tissus, voilage, tringlerie."
    ],
    "nl": [
      "Pierre-Alexis Badoux won in 2005 de gouden medaille voor beste leerling in Frankrijk. Verkoop van meubels en tapijten. Vervaardiging van gordijnen en dubbele gordijnen, stoffen, gordijnen, roedewerk."
    ],
    "es": [
      "Pierre-Alexis Badoux ganó la Medalla de Oro al Mejor Aprendiz de Francia en 2005. Venta de muebles y alfombras. Fabricación de cortinas y visillos, telas, visillos, varillas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Pierre-Alexis BADOUX - Tapissier-Décorateur"
    ]
  },
