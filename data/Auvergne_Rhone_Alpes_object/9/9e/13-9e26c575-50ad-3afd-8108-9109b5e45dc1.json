  "rdfs:comment": {
    "de": [
      "Ihr Pasta-, Pizza- und Eisrestaurant, das Sie auf dem schönsten Platz von Privas entdecken können. Je nach Jahreszeit wechselnde Angebote sowie achtzehn verschiedene Eissorten und Sorbets, die Sie von Montag bis Samstag entdecken können."
    ],
    "en": [
      "Restaurant offering pastas, pizzas and ice creams on the nicest place of the town. Food changes according to season. Taste our 18 ice creams and sorberts flavours from Monday to Saturday."
    ],
    "it": [
      "Il vostro ristorante di pasta, pizza e gelato nella piazza più bella di Privas. Il menu cambia a seconda delle stagioni, con diciotto gusti di gelato e sorbetto disponibili dal lunedì al sabato."
    ],
    "fr": [
      "Votre restaurant de pâtes, pizzas et glaces à découvrir sur la plus belle place de Privas. Des propositions qui changent au fil des saisons ainsi que dix-huit parfums de glaces et sorbets à découvrir du lundi au samedi."
    ],
    "nl": [
      "Uw pasta-, pizza- en ijsrestaurant op het mooiste plein van Privas. Het menu verandert met de seizoenen, met achttien smaken ijs en sorbet van maandag tot zaterdag."
    ],
    "es": [
      "Su restaurante de pasta, pizza y helados en la plaza más bonita de Privas. El menú cambia con las estaciones, con dieciocho sabores de helados y sorbetes disponibles de lunes a sábado."
    ]
  },
