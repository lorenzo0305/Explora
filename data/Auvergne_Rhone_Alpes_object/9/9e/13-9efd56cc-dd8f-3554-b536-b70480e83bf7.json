  "rdfs:comment": {
    "de": [
      "Ein 60 m² großer Ausstellungsbereich, der den Aktivitäten der EDF im Drac-Tal gewidmet ist. Hier können Sie anhand von Filmen, Tafeln und Fotos alles über den Monteynard-Avignonet-Staudamm und die drei anderen großen Staudämme im Tal erfahren."
    ],
    "en": [
      "A 60 m² exhibition space dedicated to EDF's activities in the Drac valley. Find out all about the Monteynard-Avignonet dam and the valley's 3 other major dams, through films, panels and photos."
    ],
    "it": [
      "Uno spazio espositivo di 60 m² dedicato alle attività di EDF nella valle del Drac. Vi permetterà di conoscere tutto ciò che riguarda la diga di Monteynard-Avignonet e le altre 3 grandi dighe della valle, attraverso filmati, pannelli e foto."
    ],
    "fr": [
      "Un espace d'exposition de 60 m² consacré aux activités d'EDF sur la vallée du Drac. Il vous permettra de tout savoir sur le barrage de Monteynard-Avignonet et sur les 3 autres grands barrages de la vallée, au travers de films, panneau et photos."
    ],
    "es": [
      "Un espacio de exposición de 60 m² dedicado a las actividades de EDF en el valle del Drac. Le permitirá conocer todo sobre la presa de Monteynard-Avignonet y las otras 3 grandes presas del valle, a través de películas, paneles y fotos."
    ],
    "nl": [
      "Een tentoonstellingsruimte van 60 m² gewijd aan de activiteiten van EDF in de Drac-vallei. Aan de hand van films, panelen en foto's komt u alles te weten over de stuwdam van Monteynard-Avignonet en de 3 andere grote stuwdammen in de vallei."
    ]
  },
