  "rdfs:comment": {
    "de": [
      "Rendezvous von Donnerstag, den 9. bis Sonntag, den 12. Juli 2026 am Ufer des Sees von Aix-les-bains"
    ],
    "en": [
      "Musilac, the story of a rapid success owing to exceptional artists who, each in their own way, world stars or emerging talents, great singers or sacred monsters, have transformed the Esplanade du Lac into a dream-machine."
    ],
    "it": [
      "Musilac, la storia di un successo cresciuto rapidamente grazie ad artisti eccezionali che, ciascuno a modo suo, star internazionali o fuoriclasse, big della musica o mostri sacri, hanno reso l'Esplanade du lac una macchina da sogno."
    ],
    "fr": [
      "Rendez-vous du Du jeudi 9 au dimanche 12 juillet 2026 sur les bords du lac d'Aix-les-bains"
    ],
