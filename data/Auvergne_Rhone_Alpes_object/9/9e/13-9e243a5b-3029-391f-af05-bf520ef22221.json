  "rdfs:comment": {
    "de": [
      "Das Zigzag-Café in der Nähe der VéloRoute voie verte (BelleVia) empfängt Sie montags bis freitags mittags mit seinem Restaurantteil.\r\nVerkauf von Sandwiches außerhalb der Öffnungszeiten\r\nBrot und Gebäck, lokale Produkte, Tabakwaren..."
    ],
    "en": [
      "The Zigzag café, located near the VéloRoute voie verte (BelleVia), welcomes you for lunch from Monday to Friday.\r\nSandwiches and takeaways.\r\nBread and pastries, a range of local products, tobacco..."
    ],
    "it": [
      "La caffetteria Zigzag, situata vicino alla pista ciclabile BelleVia, vi accoglie a pranzo dal lunedì al venerdì\r\nPane e dolci, una gamma di prodotti locali, tabacco...\r\nAmpio parcheggio, terrazza, piatti fatti in casa"
    ],
    "fr": [
      "Le Zigzag café situé à proximité de la VéloRoute voie verte (BelleVia) vous accueille pour sa partie restauration les midis du lundi au vendredi\r\nDépôt de pain et viennoiseries, gamme de produits locaux, tabac...\r\nGrand parking, terrasse, plats faits maison"
    ],
    "es": [
      "La cafetería Zigzag, situada cerca de la ruta ciclista BelleVia, le da la bienvenida para almorzar de lunes a viernes\r\nPan y bollería, gama de productos locales, tabaco...\r\nAmplio aparcamiento, terraza, platos caseros"
    ],
    "nl": [
      "Het Zigzag café, vlakbij de BelleVia fietsroute, is van maandag tot vrijdag geopend voor de lunch.\r\nVerkoop van broodjes en meeneemgerechten.\r\nBrood en gebak, een assortiment streekproducten, tabak..."
    ]
  },
