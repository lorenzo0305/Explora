  "rdfs:comment": {
    "de": [
      "Atelier eines kreativen Künstlers, der plastische Malerei betreibt, ein Ort der Arbeit, der der Öffentlichkeit nach Vereinbarung zugänglich ist, mit Ausstellung der Arbeiten.  Atelier und Außenbereich in einem exotischen Garten: Bilder, Skulpturen, Restaurierung alter Bilder in Arbeit."
    ],
    "en": [
      "Workshop of artist painter, creator, place of work which opens with the public on rdv with exposure of the achievements.  Workshop and outside in an exotic garden: paintings, sculptures, restoration of old paintings in progress."
    ],
    "it": [
      "Laboratorio di un pittore e artista plastico, un luogo di lavoro aperto al pubblico su appuntamento con una mostra delle sue opere.  Laboratorio ed esterno in un giardino esotico: dipinti, sculture, restauro di vecchi dipinti in corso."
    ],
    "fr": [
      "Atelier d'artiste peintre plasticien créateur,  lieu de travail qui s'ouvre au public sur rdv avec exposition des réalisations.  Atelier et extérieur dans un jardin exotique : tableaux, sculptures, restauration de tableaux anciens en cours  ."
    ],
    "nl": [
      "Werkplaats van een schilder en plastisch kunstenaar, een werkplaats die op afspraak open is voor het publiek met een tentoonstelling van zijn werk.  Werkplaats en buiten in een exotische tuin: schilderijen, beeldhouwwerken, restauratie van oude schilderijen in uitvoering."
    ],
    "es": [
      "Taller de un pintor y artista plástico, lugar de trabajo abierto al público con cita previa con exposición de su obra.  Taller y exterior en un jardín exótico: pinturas, esculturas, restauración de cuadros antiguos en curso."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Atelier de Peinture"
    ]
