  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/d76bb1cb-1f36-310a-828d-db8eb2a3e62a",
      "dc:description": {
        "de": [
          "Verkauf von Schmuck und Halbedelsteinen, Lithotherapie, Energiestäben, Pendeln und Räucherstäbchen.\nGeöffnet in der Nebensaison: Mittwoch, Freitag, Samstag:10:30-12h/14:30-18h, Sonntagmorgen: 10:30-12h.\nin der Hochsaison: Dienstag, Mittwoch, Freitag, Samstag 10:30-12 Uhr/14:30-18:30 Uhr, Donnerstag:14:30-18:30 Uhr, Sonntag: 10:30-12 Uhr."
        ],
        "en": [
          "Sale of jewelry and semi-precious stones, lithotherapy, energy wands, pendulums and incense.\nOpen in low season: Wednesday, Friday, Saturday: 10:30am-12pm/14:30pm-6pm, Sunday morning: 10:30am-12pm.\nhigh season: Tuesday, Wednesday, Friday, Saturday 10:30am-12pm/14:30pm-6:30pm, Thursday: 2:30pm-6:30pm, Sunday: 10:30am-12pm."
        ],
        "it": [
          "Vendita di gioielli e pietre semipreziose, litoterapia, bacchette energetiche, pendoli e incensi.\nApertura in bassa stagione: mercoledì, venerdì, sabato: 10.30-12.00/14.30-18.00, domenica mattina: 10.30-12.00.\nin alta stagione: martedì, mercoledì, venerdì, sabato: 10.30-12.00/14.30-18.30, giovedì: 14.30-18.30, domenica: 10.30-12.00."
        ],
        "fr": [
          "Vente de bijoux et pierres semi-précieuses, lithothérapie, baguettes énergétiques, pendules et encens.\nOuvert en basse saison : le mercredi, vendredi, samedi :10h30-12h/14h30-18h, dimanche matin : 10h30-12h.\nen haute saison : mardi, mercredi, vendredi, samedi 10h30-12h/14h30-18h30, jeudi :14h30-18h30, dimanche : 10h30-12h."
        ],
        "nl": [
          "Verkoop van sieraden en halfedelstenen, lithotherapie, energiewingers, pendels en wierook.\nGeopend in het laagseizoen: woensdag, vrijdag, zaterdag: 10.30-12 uur/14.30-18 uur, zondagochtend: 10.30-12 uur.\nin het hoogseizoen: dinsdag, woensdag, vrijdag, zaterdag: 10u30-12u/14u30-18u30, donderdag: 14u30-18u30, zondag: 10u30-12u00."
        ],
        "es": [
          "Venta de joyas y piedras semipreciosas, litoterapia, varitas energéticas, péndulos e incienso.\nAbierto en temporada baja: miércoles, viernes y sábado: de 10.30 a 12.00 h. y de 14.30 a 18.00 h., domingo por la mañana: de 10.30 a 12.00 h.\nen temporada alta: martes, miércoles, viernes y sábado: de 10.30 h a 12 h, de 14.30 h a 18.30 h, jueves: de 14.30 h a 18.30 h, domingo: de 10.30 h a 12 h."
        ]
      },
