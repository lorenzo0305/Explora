  "rdfs:comment": {
    "de": [
      "Im Herzen von Les Estables bietet die Boutique Les Noisetiers die Bio-Bauernhofprodukte der GAEC des Noisetiers an: Wurstwaren, Käse, AOP-Linsen, Marmeladen, Mehl, Öle? Ein kurzer Kreislauf, der zu 100 % lokal ist und in direkter Verbindung mit dem Bauernhof der Familie steht."
    ],
    "en": [
      "In the heart of Les Estables, Les Noisetiers boutique offers organic farm produce from the GAEC des Noisetiers: charcuterie, cheeses, PDO lentils, jams, flours, oils? A 100% local short circuit, with a direct link to the family farm."
    ],
    "it": [
      "Nel cuore di Les Estables, il negozio Les Noisetiers vende i prodotti biologici dell'azienda agricola GAEC des Noisetiers, tra cui salumi, formaggi, lenticchie DOP, marmellate, farine e oli Un cortocircuito 100% locale, con un legame diretto con l'azienda agricola di famiglia."
    ],
    "fr": [
      "Au cœur des Estables, la boutique Les Noisetiers propose les produits fermiers bio du GAEC des Noisetiers : charcuteries, fromages, lentilles AOP, confitures, farines, huiles… Un circuit court 100 % local, en lien direct avec la ferme familiale."
    ],
    "nl": [
      "In het hart van Les Estables verkoopt de winkel Les Noisetiers biologische boerderijproducten van de GAEC des Noisetiers, zoals vleeswaren, kazen, linzen met BOB, jam, meel en oliën Een 100% lokaal circuit, met een directe link naar de familieboerderij."
    ],
    "es": [
      "En el corazón de Les Estables, la tienda Les Noisetiers vende productos de la granja ecológica del GAEC des Noisetiers, como charcutería, quesos, lentejas DOP, mermeladas, harinas y aceites Un circuito corto 100% local, con un vínculo directo con la granja familiar."
    ]
  },
  "rdfs:label": {
