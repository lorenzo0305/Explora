  "rdfs:comment": {
    "de": [
      "Schule für Hundeschlittenfahrten.\r\nPädagogischer Zwinger von Mai bis Oktober jeden Jahres.\r\nSommer: Cani-Wanderungen, Sulki für die Kleinen, Bike-Board, Kinderkurs Mini-Musher ab 10 Jahren\r\nWinter: Hundeschlittenfahrten, Fahrten und Taufen, skandinavische Pulka"
    ],
    "en": [
      "Sleighdogs school\r\nAll year round the kennels are to be visited\r\nDuring the summer : dog trekking, sulki for children, bikeboard and go-kart\r\nDuring the winter : sleighdriving or a ride as a passenger, scandinavian pulka"
    ],
    "it": [
      "Scuola di sleddog.\r\nCanile didattico da maggio a ottobre di ogni anno.\r\nEstate: cani-escursionismo, sulki per i più piccoli, bike-boarding, corso di mini-musher per bambini a partire dai 10 anni\r\nInverno: slitta trainata da cani, guida e battesimi, pulka scandinava"
    ],
    "fr": [
      "Ecole de traîneaux à chiens.\r\nChenil pédagogique de mai à octobre chaque année .\r\nL’été :  cani-randonnée , sulki pour les petits, 'bike-board, stage enfant mini-musher à partir de 10 ans\r\nL’hiver : traîneaux à chiens, conduite et baptêmes, pulka scandinave"
    ],
    "nl": [
      "Hondensleeën school.\r\nEducatieve kennel van mei tot oktober van elk jaar.\r\nZomer: cani-hiking, sulkiing voor de kleintjes, bike-boarding, mini-musher cursus voor kinderen vanaf 10 jaar\r\nWinter: hondensleeën, rijden en dopen, Scandinavische pulka"
    ],
    "es": [
      "Escuela de trineos tirados por perros.\r\nPerrera educativa de mayo a octubre todos los años.\r\nVerano: cani-senderismo, sulki para los más pequeños, bike-board, curso de mini-musher para niños a partir de 10 años\r\nInvierno: trineos tirados por perros, conducción y bautismos, pulka escandinava"
    ]
  },
