  "rdfs:comment": {
    "de": [
      "Das Restaurant \"Le Carrefour\", das sich von der Stadt zurückgezogen hat und mitten auf dem Land liegt, empfängt Sie in einer familiären Atmosphäre zu einer traditionellen Mahlzeit. Es werden Ihnen Reibeplätzchen und Pizzas aus dem Holzofen angeboten."
    ],
    "en": [
      "Set away from the city, in the heart of the countryside, the \"Le Carrefour\" restaurant welcomes you in a family atmosphere to enjoy a traditional meal. We offer wood-fired pizzas and grates."
    ],
    "it": [
      "Lontano dalla città, nel cuore della campagna, il ristorante \"Le Carrefour\" vi accoglie in un'atmosfera familiare per gustare un pasto tradizionale. Vi offre carne alla griglia cotta al forno a legna e pizze."
    ],
    "fr": [
      "Retiré de la ville, au cœur de la campagne, le restaurant \"Le Carrefour\" vous accueille dans une ambiance familiale autour d'un repas traditionnel. Des râpées et pizzas au feu de bois vous sont proposées."
    ],
    "nl": [
      "Het restaurant \"Le Carrefour\" ligt ver van de stad, in het hart van het platteland, en verwelkomt je in een familiale sfeer om te genieten van een traditionele maaltijd. Op houtvuur gegrild vlees en pizza's worden aangeboden."
    ],
    "es": [
      "Alejado de la ciudad, en pleno campo, el restaurante \"Le Carrefour\" le recibe en un ambiente familiar para disfrutar de una comida tradicional. Se ofrecen carnes a la brasa y pizzas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Carrefour"
    ]
  },
