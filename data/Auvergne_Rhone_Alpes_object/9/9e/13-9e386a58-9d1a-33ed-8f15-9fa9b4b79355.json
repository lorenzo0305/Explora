  "rdfs:comment": {
    "de": [
      "Durchstreifen Sie die Vellave-Stadt, eine wahre Zeitmaschine, von der Renaissance-Unterstadt bis zur mittelalterlichen Oberstadt und ihrer Kathedrale.\r\nTreffpunkt: vor dem Office de Tourisme, Place du Breuil. Kostenpflichtige Besichtigung, Anmeldung erforderlich."
    ],
    "en": [
      "Take a tour of the Vellave town, a veritable time machine, from the Renaissance lower town to the medieval upper town and its cathedral.\r\nMeet in front of the Tourist Office, place du Breuil. Registration required."
    ],
    "it": [
      "Visita della città di Vellave, una vera e propria macchina del tempo, dalla città bassa rinascimentale alla città alta medievale e alla sua cattedrale.\r\nRitrovo davanti all'Ufficio del Turismo, place du Breuil. La visita è a pagamento e l'iscrizione è obbligatoria."
    ],
    "fr": [
      "Parcourez la cité vellave, véritable machine à remonter le temps, depuis la basse ville Renaissance jusqu’à la haute ville du Moyen Âge et sa cathédrale.\r\nRendez-vous devant l'Office de Tourisme, place du Breuil. Visite payante, sur inscription."
    ],
    "es": [
      "Recorra la ciudad de Vellave, una auténtica máquina del tiempo, desde la ciudad baja renacentista hasta la ciudad alta medieval y su catedral.\r\nEncuentro frente a la Oficina de Turismo, place du Breuil. La visita es gratuita, previa inscripción."
    ],
    "nl": [
      "Maak een rondleiding door de stad Vellave, een echte tijdmachine, van de renaissance benedenstad tot de middeleeuwse bovenstad en de kathedraal.\r\nAfspraak voor het Office du Tourisme, place du Breuil. Kosten voor de rondleiding, registratie verplicht."
    ]
  },
  "rdfs:label": {
