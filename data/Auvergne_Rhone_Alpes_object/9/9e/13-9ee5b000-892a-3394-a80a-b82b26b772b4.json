  "rdfs:comment": {
    "de": [
      "Lassen Sie sich von einer Küche überraschen, die Großzügigkeit und Finesse vereint und aus frischen, lokalen Produkten zubereitet wird. Unser Küchenchef Patrik interpretiert die Aromen der Region mit Kreativität neu, um raffinierte und charaktervolle Teller anzubieten."
    ],
    "en": [
      "Let us surprise you with a cuisine that combines generosity and finesse, made from fresh, local produce. Our chef Patrik creatively revisits local flavors to create refined dishes full of character."
    ],
    "it": [
      "Lasciatevi sorprendere da una cucina che unisce generosità e finezza, utilizzando prodotti freschi locali. Il nostro chef Patrik rivisita in modo creativo i sapori locali per creare piatti raffinati e pieni di carattere."
    ],
    "fr": [
      "Laissez-vous surprendre par une cuisine qui allie générosité et finesse, élaborée à partir de produits frais et locaux. Notre chef Patrik revisite avec créativité les saveurs du terroir pour offrir des assiettes raffinées et pleines de caractère."
    ],
    "nl": [
      "Laat je verrassen door een keuken die vrijgevigheid en finesse combineert, met verse lokale producten. Onze chef-kok Patrik herontdekt op creatieve wijze lokale smaken om verfijnde gerechten vol karakter te creëren."
    ],
    "es": [
      "Déjese sorprender por una cocina que combina generosidad y delicadeza, utilizando productos locales frescos. Nuestro chef Patrik revisita creativamente los sabores locales para crear platos refinados llenos de carácter."
    ]
  },
  "rdfs:label": {
