  "rdfs:comment": {
    "de": [
      "Seit 2016 bietet Ihnen das Restaurant La Bocca eine Speisekarte mit hausgemachten Gerichten! Entdecken Sie unsere großzügigen Pizzen, unsere frischen Nudeln, aber auch einige Spezialitäten, alles auf der Grundlage von Rohprodukten, die sorgfältig nach ihrer Qualität ausgewählt werden."
    ],
    "en": [
      "Since 2016, La Bocca restaurant has been offering you a menu of home-made dishes! Come and discover our generous pizzas and fresh pastas, as well as some specialities, all made with raw ingredients carefully selected for their quality."
    ],
    "it": [
      "Dal 2016, il ristorante La Bocca vi offre un menu di piatti fatti in casa! Venite a scoprire le nostre generose pizze e paste fresche, oltre a numerose specialità, tutte realizzate con ingredienti crudi accuratamente selezionati per la loro qualità."
    ],
    "fr": [
      "Depuis 2016, le restaurant La Bocca vous propose une carte de plats maison ! Venez découvrir nos pizzas généreuses, nos pâtes fraîches, mais aussi quelques spécialités le tout à base de produits bruts sélectionnés avec soin pour leur qualité."
    ],
    "es": [
      "¡Desde 2016, el restaurante La Bocca le ofrece una carta de platos caseros! Venga a descubrir nuestras generosas pizzas y pastas frescas, así como numerosas especialidades, todas ellas elaboradas con ingredientes crudos cuidadosamente seleccionados por su calidad."
    ],
    "nl": [
      "Sinds 2016 biedt restaurant La Bocca u een menu van huisgemaakte gerechten! Kom en ontdek onze rijkelijk gevulde pizza's en verse pasta's, evenals enkele specialiteiten, allemaal op basis van onbewerkte producten die zorgvuldig zijn geselecteerd op hun kwaliteit."
    ]
  },
  "rdfs:label": {
