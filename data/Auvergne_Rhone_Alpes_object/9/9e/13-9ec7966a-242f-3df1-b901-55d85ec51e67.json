  "rdfs:comment": {
    "de": [
      "Dieses 1500 m² große Spa ist das größte Thermalspa in Savoyen. Er wird vollständig mit Thermalwasser versorgt.\r\n5 Becken: Innen- und Außen-Jacuzzi, Entspannungsbecken, Gegenstromschwimmen."
    ],
    "en": [
      "This 1500 m² Spa is the largest thermal spa in Savoie. It is entirely supplied with thermal water.\r\n5 pools: indoor and outdoor Jacuzzi, relaxation pool, counter-current swimming pool."
    ],
    "it": [
      "Questa Spa di 1500 m² è il più grande centro termale della Savoia. È interamente alimentato con acqua termale.\r\n5 piscine: Jacuzzi interna ed esterna, piscina relax, piscina controcorrente."
    ],
    "fr": [
      "Ce Spa de 1500 m² est le plus grand spa thermal de Savoie. Il est entièrement alimenté en eau thermale.\r\n5 bassins : Jacuzzi intérieur et extérieur, bassin de relaxation, de nage à contre-courant."
    ],
    "es": [
      "Este balneario de 1500 m² es el mayor balneario termal de Saboya. Se abastece totalmente de agua termal.\r\n5 piscinas: jacuzzi interior y exterior, piscina de relajación, piscina a contracorriente."
    ],
    "nl": [
      "Dit kuuroord van 1500 m² is het grootste in de Savoie. Het is volledig voorzien van thermaal water.\r\n5 zwembaden: binnen- en buitenjacuzzi, ontspanningsbad, tegenstroomzwembad."
    ]
  },
