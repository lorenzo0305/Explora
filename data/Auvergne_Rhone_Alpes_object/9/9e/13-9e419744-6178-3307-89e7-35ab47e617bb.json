  "rdfs:comment": {
    "de": [
      "La Mangoune ist eine Brasserie, deren Thema die Küche, die Geschmäcker und die Spezialitäten der Auvergne sind. Wir bevorzugen eine einfache, ehrliche, schmackhafte und hausgemachte Küche, die lokale Produkte in den Vordergrund stellt."
    ],
    "en": [
      "The Mangoune is a brasserie-style restaurant and home to the cuisine, flavours and specialities of the Auvergne region. We favour simple, authentic, tasty and home-made cuisine that showcases local produce."
    ],
    "it": [
      "La Mangoune è una brasserie il cui tema è la cucina, i sapori e le specialità della regione dell'Alvernia. La nostra cucina è semplice, sincera, gustosa e casalinga, con particolare attenzione ai prodotti locali."
    ],
    "fr": [
      "La Mangoune est une brasserie ayant pour thème la cuisine, les saveurs et les spécialités du terroir auvergnat. Nous privilégions une cuisine simple, sincère, goûteuse et faite maison qui met en avant les produits locaux."
    ],
    "nl": [
      "La Mangoune is een brasserie die in het teken staat van de keuken, de smaken en de specialiteiten van de Auvergne. Onze keuken is eenvoudig, oprecht, lekker en huisgemaakt, met de nadruk op lokale producten."
    ],
    "es": [
      "La Mangoune es una brasserie cuyo tema es la cocina, los sabores y las especialidades de la región de Auvernia. Nuestra cocina es sencilla, sincera, sabrosa y casera, y se centra en los productos locales."
    ]
  },
