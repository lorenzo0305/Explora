  "rdfs:comment": {
    "de": [
      "In einer Bocage-Landschaft inmitten eines Netzes von Teichen ist der hügelige Neun-Loch-Parcours sowohl für Anfänger als auch für erfahrene Golfer geeignet."
    ],
    "en": [
      "In a bocage setting at the heart of a network of ponds, the nine hole undulating course is suitable for beginners and experienced golfers alike."
    ],
    "it": [
      "In un contesto di bocage nel cuore di una rete di stagni, il percorso ondulato a nove buche è adatto sia ai principianti che ai golfisti esperti."
    ],
    "fr": [
      "Dans un cadre bocager au coeur d'un réseau d'étangs, le parcours vallonné de neuf trous est adapté aux débutants comme aux golfeurs chevronnés."
    ],
    "nl": [
      "In een bocage setting in het hart van een netwerk van vijvers, is de golvende negen-holes baan geschikt voor zowel beginners als ervaren golfers."
    ],
    "es": [
      "En un entorno de bocage en el corazón de una red de estanques, el campo ondulado de nueve hoyos es adecuado tanto para los principiantes como para los golfistas experimentados."
    ]
  },
  "rdfs:label": {
