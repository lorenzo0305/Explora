  "rdfs:comment": {
    "de": [
      "Qualitativ hochwertiges und schnelles Essen \"hausgemacht\" auf den Pisten. Große Auswahl an Burgern, Salaten, Gratins, Pasta, Desserts? Eine My little warung-Ecke mit asiatischer Küche."
    ],
    "en": [
      "High-end fast food offering innovative and quality products. \"Home made\". Large selection of burgers, salads, pasta gratins, all \"homemade\" dessert. New: a My little Warung corner, Asian cuisine"
    ],
    "it": [
      "Cibo veloce e di qualità \"fatto in casa\" sulle piste. Ampia scelta di hamburger, insalate, gratin, pasta, dessert? Il mio piccolo angolo warung, cucina asiatica."
    ],
    "fr": [
      "Restauration qualitative et rapide \"fait maison » sur les pistes. Grand choix de burgers , salades, gratins, pâtes, desserts… Un corner My little warung, cuisine asiatique."
    ],
    "nl": [
      "High-end fastfood met innovatieve en kwaliteitsproducten. \"Eigengemaakt\". Grote selectie van hamburgers, salades, pastagratins, allemaal \"zelfgemaakt\" dessert. Nieuw: een My little Warung corner, Aziatische keuken"
    ],
    "es": [
      "Comida rápida y de calidad \"casera\" en las pistas. Gran variedad de hamburguesas, ensaladas, gratinados, pasta, postres.. Un Mi pequeño rincón warung, cocina asiática."
    ]
  },
