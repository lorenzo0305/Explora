  "rdfs:comment": {
    "de": [
      "Die Farm l'Abeille & la Blette hat Anfang 2018 Wurzeln geschlagen und gedeiht in ihrem eigenen Tempo. Das Herzstück ihrer Tätigkeit ist der biologische Gemüseanbau ."
    ],
    "en": [
      "The Farm L'abeille et la Blette took root in early 2018 and develops at its own pace. The heart of the activity is the organic market gardening."
    ],
    "it": [
      "L'azienda agricola Abeille & la Blette ha messo radici all'inizio del 2018 e sta fiorendo al suo ritmo. Il cuore della loro attività è l'orticoltura biologica."
    ],
    "fr": [
      "La ferme l'Abeille & la Blette a pris racine au début de l'année 2018 et s'épanouit à son rythme. Le cœur de leur activité est le maraîchage biologique ."
    ],
    "es": [
      "La granja Abeille & la Blette echó raíces a principios de 2018 y florece a su ritmo. El núcleo de su negocio es la horticultura ecológica."
    ],
    "nl": [
      "De boerderij l'Abeille & la Blette is begin 2018 ontstaan en bloeit op zijn eigen tempo. De kern van hun bedrijf is biologisch tuinieren."
    ]
  },
