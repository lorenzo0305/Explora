  "rdfs:comment": {
    "de": [
      "Sandwiches, Kebab, Burger, Tacos, Salate und Teller...aber auch und vor allem das Marache-Eis, hausgemachtes Eis aus Milch von lokalen Bauernhöfen."
    ],
    "en": [
      "Sandwiches, Kebabs, Burgers, Tacos, Salads and Plates...but also and above all Marache ice cream, homemade artisanal ice cream made with milk from local farms."
    ],
    "it": [
      "Panini, kebab, hamburger, tacos, insalate e piatti... ma anche e soprattutto il gelato Marache, gelato artigianale prodotto con latte proveniente da fattorie locali."
    ],
    "fr": [
      "Sandwichs, Kebabs, Burgers, Tacos, Salades et Assiettes...mais aussi et surtout la glace Marache, glace artisanale faite maison à base de lait issu de fermes locales."
    ],
    "nl": [
      "Sandwiches, Kebabs, Burgers, Tacos, Salades en Plates...maar ook en vooral het Marache-ijs, huisgemaakt ijs gemaakt met melk van lokale boerderijen."
    ],
    "es": [
      "Sándwiches, Kebabs, Hamburguesas, Tacos, Ensaladas y Platos... pero también y sobre todo el helado de Marache, helado artesanal elaborado con leche de granjas locales."
    ]
  },
