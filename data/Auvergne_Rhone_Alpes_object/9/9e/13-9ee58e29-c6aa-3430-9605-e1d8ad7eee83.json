  "rdfs:comment": {
    "de": [
      "Haben Sie Lust, in einer geselligen Atmosphäre und in einem natürlichen Rahmen Triathlon zu erlernen oder zu perfektionieren?\r\nDie Domaine de la Chouette empfängt Sie zu maßgeschneiderten Kursen, die Sport, Entspannung und Austausch miteinander verbinden."
    ],
    "en": [
      "Would you like to learn or improve your triathlon skills in a friendly, natural setting?\r\nThe Domaine de la Chouette welcomes you for tailor-made courses combining sport, relaxation and sharing."
    ],
    "it": [
      "Volete imparare o migliorare le vostre abilità nel triathlon in un ambiente naturale e accogliente?\r\nIl Domaine de la Chouette offre corsi su misura che combinano sport, relax e condivisione."
    ],
    "fr": [
      "Envie de vous initier ou de vous perfectionner en triathlon dans une ambiance conviviale et un cadre naturel ?\r\nLe Domaine de la Chouette vous accueille pour des stages sur mesure, alliant sport, détente et partage."
    ],
    "es": [
      "¿Desea aprender o perfeccionar sus técnicas de triatlón en un entorno natural y agradable?\r\nEl Domaine de la Chouette ofrece cursos a medida que combinan deporte, relajación y convivencia."
    ],
    "nl": [
      "Wil je je triatlonvaardigheden leren of verbeteren in een vriendelijke, natuurlijke omgeving?\r\nDomaine de la Chouette biedt cursussen op maat die sport, ontspanning en samen delen combineren."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Stage de triathlon - stage sportif"
    ]
  },
