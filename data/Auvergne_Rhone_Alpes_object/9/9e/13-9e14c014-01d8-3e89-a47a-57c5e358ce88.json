  "rdfs:comment": {
    "de": [
      "Eine Entdeckungsreise durch die schönsten Landschaften der Margeride bis zum Signal, wo Sie Kiefernwälder, Buchenwälder, Heidelandschaften und Torfmoore erreichen.."
    ],
    "en": [
      "Discover the most beautiful landscapes of Margeride as far as Le Signal and reach pine forests, beech coppices, moors, peat bogs?"
    ],
    "it": [
      "Scoprite i paesaggi più belli della Margeride fino a Le Signal, tra pinete, faggete, brughiere, torbiere e altro ancora"
    ],
    "fr": [
      "Une découverte des plus beaux paysages de Margeride jusqu'au Signal et atteindre ainsi les forêts de pins, les taillis de hêtres, les landes, des tourbières…"
    ],
    "nl": [
      "Ontdek de mooiste landschappen van de Margeride tot aan Le Signal, langs dennenbossen, beukenbossen, veengebieden en nog veel meer"
    ],
    "es": [
      "Descubra los paisajes más bellos de la Margeride hasta Le Signal, pasando por pinares, hayedos, páramos, turberas y mucho más"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Circuit VAE n°34 - Le Signal"
    ]
  },
