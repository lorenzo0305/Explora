  "rdfs:comment": {
    "de": [
      "Die Kirche Saint Marcel de Félines wurde im 19. Jahrhundert an der Stelle eines Gebäudes errichtet, das bereits 997 erwähnt wurde und als Burgkapelle diente."
    ],
    "en": [
      "The church of Saint Marcel de Félines was built in the 19th century, on the site of a building mentioned as early as 997, which served as a castral chapel."
    ],
    "it": [
      "La chiesa di Saint Marcel de Félines è stata costruita nel XIX secolo, sul sito di un edificio menzionato già nel 997, che fungeva da cappella castrale."
    ],
    "fr": [
      "L’église de Saint Marcel de Félines a été construite au XIXe siècle, à l’emplacement d’un édifice mentionné dès 997, qui faisait fonction de chapelle castrale."
    ],
    "es": [
      "La iglesia de Saint Marcel de Félines se construyó en el siglo XIX, en el emplazamiento de un edificio mencionado ya en 997, que servía de capilla castral."
    ],
    "nl": [
      "De kerk Saint Marcel de Félines werd gebouwd in de 19e eeuw, op de plek van een gebouw dat al in 997 werd genoemd en dat dienst deed als castrale kapel."
    ]
  },
