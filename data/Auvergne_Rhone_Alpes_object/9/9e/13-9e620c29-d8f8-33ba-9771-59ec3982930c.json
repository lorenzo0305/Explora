  "rdfs:comment": {
    "de": [
      "Im Dorf Chenereilles liegt der Kinderspielplatz und Picknickplatz gegenüber dem Fluss Lizieux. Genießen Sie die Ruhe des Dorfes.\r\nBrotverkauf direkt nebenan für das Picknick!"
    ],
    "en": [
      "In the village of Chenereilles, the children's playground and picnic area faces the Lizieux river. Enjoy the peace and quiet of the village.\r\nBread and picnic facilities right next door!"
    ],
    "it": [
      "Nel villaggio di Chenereilles, il parco giochi per bambini e l'area picnic si affacciano sul fiume Lizieux. Godetevi la pace e la tranquillità del villaggio.\r\nAccanto c'è un negozio di pane per i picnic!"
    ],
    "fr": [
      "Dans le village de Chenereilles, l'aire de jeux pour enfants et de pique-nique fait face au Lizieux. Profitez de la tranquillité du village.\r\nDépôt de pain juste à côté pour le pique-nique !"
    ],
    "nl": [
      "In het dorp Chenereilles kijken de speeltuin en de picknickplaats uit op de rivier de Lizieux. Geniet van de rust en stilte van het dorp.\r\nEr is een broodwinkel naast de deur voor een picknick!"
    ],
    "es": [
      "En el pueblo de Chenereilles, el parque infantil y la zona de picnic dan al río Lizieux. Disfrute de la tranquilidad del pueblo.\r\n¡Hay una panadería al lado para hacer picnic!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Aire de jeux et de pique-nique"
    ]
  },
