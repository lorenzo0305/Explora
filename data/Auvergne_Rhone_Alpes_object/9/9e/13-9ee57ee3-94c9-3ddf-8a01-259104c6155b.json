  "rdfs:comment": {
    "de": [
      "RDV ciné in der Mediathek, von Ihnen programmiert und animiert!\r\n\r\nEin Film der berühmten Coen-Brüder steht im Mittelpunkt dieser Veranstaltung, die Sie nicht verpassen sollten!"
    ],
    "en": [
      "RDV ciné at the mediatheque, programmed and hosted by you!\r\n\r\nA film by the famous Coen brothers will be featured at this not-to-be-missed screening!"
    ],
    "it": [
      "Un evento cinematografico presso la biblioteca multimediale, programmato e ospitato da voi!\r\n\r\nUn film dei famosi fratelli Coen sarà presentato in questa proiezione da non perdere!"
    ],
    "fr": [
      "RDV ciné à la médiathèque, programmé et animé par vous !\r\n\r\nUn film des célèbres frères Coen sera mit à l'honneur pour cette séance, à ne pas rater!"
    ],
    "es": [
      "Un evento cinematográfico en la biblioteca multimedia, ¡programado y presentado por usted!\r\n\r\nUna película de los famosos hermanos Coen será la protagonista de esta proyección que no te puedes perder"
    ],
    "nl": [
      "Een filmevenement in de mediatheek, geprogrammeerd en georganiseerd door jou!\r\n\r\nEen film van de beroemde gebroeders Coen zal te zien zijn tijdens deze niet te missen vertoning!"
    ]
  },
