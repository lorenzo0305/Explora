  "rdfs:comment": {
    "de": [
      "Gegenüber dem Maison de la Danse gelegen, empfängt Sie La Fabryk zu allen Anlässen rund um seine Veranstaltungen (Live-Konzerte, Partys) in Gruppen, als Paar oder mit der Familie... Eine gute Gelegenheit, unsere breite Palette an Gerichten zu probieren."
    ],
    "en": [
      "Located opposite the Maison de la Danse, La Fabryk welcomes you in all circumstances around its activities (Live Concerts, evenings) in groups, couples or families... A great opportunity to taste our wide range of dishes."
    ],
    "it": [
      "Situata di fronte alla Maison de la Danse, La Fabryk vi accoglie in ogni circostanza intorno alle sue animazioni (concerti dal vivo, serate) in gruppo, in coppia o in famiglia? Un'ottima occasione per assaggiare la nostra vasta gamma di piatti."
    ],
    "fr": [
      "Situé face à la Maison de la Danse, La Fabryk vous accueille en toutes circonstances autour de ses animations (Concerts Live, soirées) en groupe, en couple ou en famille… Une belle occasion de goûter à notre large gamme de plats."
    ],
    "es": [
      "Situada frente a la Maison de la Danse, La Fabryk le acoge en todas las circunstancias en torno a sus animaciones (Conciertos en vivo, veladas) en grupo, en pareja o en familia.. Una gran oportunidad para degustar nuestra amplia gama de platos."
    ],
    "nl": [
      "Gelegen tegenover het Maison de la Danse, verwelkomt La Fabryk u in alle omstandigheden rond haar animaties (Live concerten, avonden) in groep, in koppel of in familie... Een mooie gelegenheid om onze brede waaier aan gerechten te proeven."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant La Fabryk"
    ]
  },
