  "rdfs:comment": {
    "de": [
      "Bei einem Ausflug ins Pays d'Arlanc können Sie in der Pizzeria/Restaurant l'ESCALE ARLANC einen Zwischenstopp einlegen. Hier finden Sie Pizzas, Burger und Shawarmas, aber nicht nur!"
    ],
    "en": [
      "For a getaway in the Pays d'Arlanc, you can stop off at the Pizzeria/Restaurant l'ESCALE ARLANC. You'll discover our Pizzas, Burgers and Shawarmas, but that's not all!"
    ],
    "it": [
      "Per una pausa nella regione dell'Arlanc, potete fermarvi alla Pizzeria/Ristorante l'ESCALE ARLANC. Scoprirete le nostre pizze, gli hamburger e gli scialatielli, ma non solo!"
    ],
    "fr": [
      "Pour une escapade en pays d'Arlanc, vous pouvez faire une halte à la Pizzeria/Restaurant l'ESCALE ARLANC. Vous découvrirez nos Pizzas, nos Burgers, nos Shawarmas mais pas que !!!"
    ],
    "nl": [
      "Voor een pauze in de regio Arlanc kun je stoppen bij Pizzeria/Restaurant l'ESCALE ARLANC. Je ontdekt er onze pizza's, hamburgers en shawarmas, maar dat is nog niet alles!"
    ],
    "es": [
      "Para una pausa en la región de Arlanc, puede hacer una parada en la Pizzería/Restaurante l'ESCALE ARLANC. Descubrirá nuestras pizzas, hamburguesas y shawarmas, ¡pero eso no es todo!"
    ]
  },
