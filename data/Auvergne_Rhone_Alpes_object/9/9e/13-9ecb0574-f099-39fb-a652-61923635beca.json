  "rdfs:comment": {
    "de": [
      "Das 5-Sterne-Hotel in Megève, Les Chalets du Mont d'Arbois, bietet eine Klammer alpiner Eleganz und Authentizität, zwischen Lebenskunst, Wellness und Gastronomie, inmitten einer außergewöhnlichen Naturlandschaft."
    ],
    "en": [
      "A 5-star hotel in Megève, Les Chalets du Mont d’Arbois offers a haven of alpine elegance and authenticity, combining art de vivre, wellness, and fine dining in an exceptional natural setting."
    ],
    "it": [
      "A cinque minuti dal centro di Megève, gli Chalet del Monte d'Arbois riflettono l'eredità della famiglia Edmond de Rothschild, che quasi un secolo fa ha trasformato il paese in una destinazione di montagna da non perdere."
    ],
    "fr": [
      "Hôtel 5 étoiles à Megève, Les Chalets du Mont d’Arbois offrent une parenthèse d’élégance alpine et d’authenticité, entre art de vivre, bien-être et gastronomie, au cœur d’un cadre naturel exceptionnel."
    ],
    "nl": [
      "Les Chalets du Mont d'Arbois, een 5-sterrenhotel in Megève, biedt een oase van elegantie en authenticiteit in de Alpen en combineert lifestyle, welzijn en gastronomie in het hart van een uitzonderlijke natuurlijke omgeving."
    ],
    "es": [
      "Hotel de 5 estrellas en Megève, Les Chalets du Mont d'Arbois ofrecen un remanso de elegancia y autenticidad alpinas, combinando estilo de vida, bienestar y gastronomía en el corazón de un entorno natural excepcional."
    ]
  },
