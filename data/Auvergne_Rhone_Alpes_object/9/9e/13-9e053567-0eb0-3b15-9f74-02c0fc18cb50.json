  "rdfs:comment": {
    "de": [
      "Willkommen in La Ferme de César, dem ältesten Restaurant am Fuße der Pisten des alten Dorfes Montchavin in einem authentischen Bauernhaus, in dem noch der Duft vergangener Zeiten weht."
    ],
    "en": [
      "Welcome to La Ferme de César, the oldest restaurant at the foot of the slopes in the old village of Montchavin, in an authentic farmhouse that still smells of yesteryear."
    ],
    "it": [
      "Benvenuti a La Ferme de César, il più antico ristorante situato ai piedi delle piste nell'antico villaggio di Montchavin, in un'autentica casa colonica dove il profumo di un tempo è ancora vivo."
    ],
    "fr": [
      "Bienvenue à La Ferme de César, le plus ancien restaurant situé au pied des pistes du vieux village de Montchavin dans une ferme authentique où il flotte encore un parfum d’antan."
    ],
    "nl": [
      "Welkom bij La Ferme de César, het oudste restaurant aan de voet van de pistes in het oude dorp Montchavin, in een authentieke boerderij waar de smaak van weleer nog steeds hangt."
    ],
    "es": [
      "Bienvenido a La Ferme de César, el restaurante más antiguo situado a pie de pistas en el antiguo pueblo de Montchavin, en una auténtica granja donde el aroma de antaño sigue vivo."
    ]
  },
