  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/a902d516-4708-3639-b968-e2a656b686e9",
      "dc:description": {
        "de": [
          "Picknickplatz, der sich neben dem Rathaus und dem Fußballstadion der Gemeinde befindet. Angenehmer Platz. Verschiedene Ausstattungen: 2 Picknicktische, Kinderspiele, Bouleplatz und Mülleimer."
        ],
        "en": [
          "Picnic area located next to the town hall and the football stadium. Pleasant area. Various equipment: 2 picnic tables, children's games, boules pitch and rubbish bins."
        ],
        "it": [
          "Area picnic vicino al municipio e allo stadio di calcio locale. Area piacevole. Varie strutture: 2 tavoli da picnic, giochi per bambini, campo da bocce e cestini per i rifiuti."
        ],
        "fr": [
          "Aire de pique-nique se situant à côté de la mairie et du stade de football de la commune. Espace agréable. Divers équipement : 2 tables de pique-nique, jeux pour enfant, terrain de boules et poubelles."
        ],
        "es": [
          "Zona de picnic junto al ayuntamiento y el estadio de fútbol local. Zona agradable. Diversas instalaciones: 2 mesas de picnic, juegos infantiles, bolera y papeleras."
        ],
        "nl": [
          "Picknickplaats naast het gemeentehuis en het plaatselijke voetbalstadion. Aangenaam gebied. Diverse voorzieningen: 2 picknicktafels, kinderspelen, jeu de boules baan en afvalbakken."
        ]
      },
