  "rdfs:comment": {
    "de": [
      "Mitten im Zentrum des Dorfes Pradelles, das zu den schönsten Dörfern Frankreichs zählt. Das Restaurant le Renaissance, das sich unter den Arkaden des Platzes befindet, bietet Ihnen schnelle und traditionelle Gerichte."
    ],
    "en": [
      "Right in the center of Pradelles, one of France's most beautiful villages. The Renaissance restaurant, located under the arcades of the square, offers traditional and fast food."
    ],
    "it": [
      "Proprio nel centro del villaggio di Pradelles, annoverato tra i più bei villaggi di Francia. Il ristorante Renaissance, situato sotto i portici della piazza, offre una cucina tradizionale veloce."
    ],
    "fr": [
      "En plein centre du village de Pradelles classé parmi les plus beaux villages de France. Le restaurant le Renaissance, situé sous les arcades de la place, vous propose une restauration rapide et traditionnelle."
    ],
    "nl": [
      "Midden in het dorp Pradelles, dat bekend staat als een van de mooiste dorpen van Frankrijk. Het Renaissance restaurant, gelegen onder de arcades van het plein, biedt traditionele fastfood."
    ],
    "es": [
      "En pleno centro del pueblo de Pradelles, catalogado como uno de los pueblos más bonitos de Francia. El restaurante Renaissance, situado bajo los soportales de la plaza, ofrece comida rápida tradicional."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Renaissance"
    ]
  },
