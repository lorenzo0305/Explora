  "rdfs:comment": {
    "de": [
      "Das Restaurant bietet Ihnen eine großzügige bodenständige Küche aus der Auvergne. Zart schmelzende Trüffel, cremiger Aligot, charaktervolle Käsesorten und Weine aus der Auvergne bilden die Speisekarte."
    ],
    "en": [
      "The restaurant offers generous local Auvergne cuisine. Melt-in-the-mouth truffade, creamy aligot, characterful cheeses and Auvergne wines make up the menu."
    ],
    "it": [
      "Il ristorante serve una generosa cucina locale dell'Alvernia. Tartufi fondenti, aligot cremoso, formaggi particolari e vini d'Alvernia compongono il menu."
    ],
    "fr": [
      "Le restaurant vous propose une cuisine de terroir auvergnat généreuse. Truffade fondante, aligot crémeux, fromages de caractère et vins auvergnat composent la carte."
    ],
    "nl": [
      "Het restaurant serveert royale lokale gerechten uit de Auvergne. Smeltende truffels, romige aligot, bijzondere kazen en wijnen uit de Auvergne vormen het menu."
    ],
    "es": [
      "El restaurante sirve una generosa cocina local de Auvernia. Trufas que se deshacen en la boca, aligot cremoso, quesos característicos y vinos de Auvernia componen la carta."
    ]
  },
  "rdfs:label": {
