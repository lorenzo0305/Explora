  "rdfs:comment": {
    "de": [
      "Das Team der Snackbar empfängt Sie im Hof des Château d'Hauterives, neben dem Schwimmbad."
    ],
    "en": [
      "The restaurant team is happy to welcome you on the shaded terrace in the courtyard of the Château d 'Hauterives"
    ],
    "it": [
      "Il team dello snack-bar vi accoglie nel cortile dello Château d'Hauterives, accanto alla piscina."
    ],
    "fr": [
      "L'équipe du snack-bar vous accueille dans la cour du Château d'Hauterives, à côté de la piscine."
    ],
    "nl": [
      "Traditioneel restaurant met groot terras in het park bij het kasteel. U vindt er o.a.: huisgemaakte hamburgers, maaltijdsalades, raviolegratins en pizza's, ter plaatse of om mee te nemen."
    ],
    "es": [
      "El equipo del snack-bar le da la bienvenida en el patio del Château d'Hauterives, junto a la piscina."
    ]
