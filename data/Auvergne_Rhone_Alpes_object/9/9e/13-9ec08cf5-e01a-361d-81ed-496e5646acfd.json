  "rdfs:comment": {
    "de": [
      "Am Fuße des Grand Pomerolle zwischen Saoû und Bourdeaux gelegen, wurde der Familienbetrieb im Jahr 2009 übernommen. Hier finden Sie eine Auswahl an Gemüse, wobei Sie dank der Produktion im Gewächshaus und im Freiland dem Rhythmus der Jahreszeiten folgen können."
    ],
    "en": [
      "Located at the foot of Grand Pomerolle between Saoû and Bourdeaux, we took over the family farm in 2009. Here you'll find a range of vegetables that follow the rhythm of the seasons, thanks to greenhouse and open-field production."
    ],
    "it": [
      "Situata ai piedi del Grand Pomerolle, tra Saoû e Bourdeaux, l'azienda agricola di famiglia è stata rilevata nel 2009. Troverete una gamma di ortaggi che segue il ritmo delle stagioni grazie a una produzione in serra e in campo aperto."
    ],
    "fr": [
      "Situé au pied du Grand Pomerolle entre Saoû et Bourdeaux la reprise de l'exploitation familiale s'est faite en 2009. Vous y trouverez une gamme de légumes tout en suivant le rythme des saisons grâce à une production sous serre et en plein champ."
    ],
    "es": [
      "Situada al pie del Grand Pomerolle, entre Saoû y Bourdeaux, la explotación familiar fue adquirida en 2009. Encontrará una gama de verduras que sigue el ritmo de las estaciones gracias a una producción en invernadero y en campo abierto."
    ],
    "nl": [
      "Gelegen aan de voet van Grand Pomerolle tussen Saoû en Bourdeaux, namen we de familieboerderij over in 2009. Je vindt er een assortiment groenten die het ritme van de seizoenen volgen, dankzij de kas- en vollegrondsteelt."
    ]
  },
  "rdfs:label": {
