  "rdfs:comment": {
    "de": [
      "David Pussier züchtet Charolais-Kühe und Freilandgeflügel. Er bietet Frischfleischpakete, tiefgefrorene Hacksteaks, Freilandgeflügel (Hühner, Perlhühner) und für Ihre Jahresendmahlzeiten Festtagsgeflügel zum Verkauf an."
    ],
    "en": [
      "David Pussier raises Charolais cows and free-range poultry. He sells fresh meat parcels, frozen hamburgers, free-range poultry (chickens, guinea fowl) and festive poultry for your end-of-year meals."
    ],
    "it": [
      "David Pussier alleva vacche Charolais e pollame da cortile. Vende pacchi di carne fresca, bistecche macinate surgelate, pollame ruspante (polli, faraone) e pollame da festa per i vostri pranzi di fine anno."
    ],
    "fr": [
      "David Pussier élève des vaches charolaises et des volailles fermières. Il propose à la vente des colis de viande fraîche, des steacks hachés surgelés, des volailles fermières (poulets, pintades) et pour vos repas de fin d'année des volailles festives."
    ],
    "nl": [
      "David Pussier fokt Charolais-koeien en scharrelpluimvee. Hij verkoopt pakketten vers vlees, diepvriesgehakt, scharrelpluimvee (kippen, parelhoenders) en feestpluimvee voor je eindejaarsmaaltijden."
    ],
    "es": [
      "David Pussier cría vacas Charolais y aves de corral. Vende paquetes de carne fresca, filetes picados congelados, aves de corral (pollos, pintadas) y aves de fiesta para sus comidas de fin de año."
    ]
  },
  "rdfs:label": {
    "fr": [
      "David Pussier, producteur de viande"
    ]
  },
