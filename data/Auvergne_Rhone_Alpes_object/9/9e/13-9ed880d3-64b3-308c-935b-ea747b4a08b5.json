  "rdfs:comment": {
    "de": [
      "Diese Route ist ideal für einen Tag, um die Gemeinde Louroux-Hodement - Haut-Bocage zu erkunden. Sie richtet sich an geübte Wanderer, die eine große, aber ruhige Wanderung unternehmen möchten."
    ],
    "en": [
      "Ideal for a day out exploring the commune of Louroux-Hodement - Haut-Bocage, this itinerary is ideal for regular hikers looking for a large-scale but peaceful stroll."
    ],
    "it": [
      "Ideale per una giornata alla scoperta del comune di Louroux-Hodement - Haut-Bocage, questo percorso si rivolge agli escursionisti abituali alla ricerca di un'uscita su larga scala ma tranquilla."
    ],
    "fr": [
      "Idéale pour une journée de découverte de la commune de Louroux-Hodement - Haut-Bocage, cet itinéraire s’adresse aux randonneurs habitués qui souhaitent une balade d’envergure mais paisible."
    ],
    "es": [
      "Ideal para pasar un día explorando la comuna de Louroux-Hodement - Haut-Bocage, esta ruta está dirigida a senderistas habituales que buscan una salida de gran envergadura pero tranquila."
    ],
    "nl": [
      "Deze route is ideaal voor een dagje uit in de gemeente Louroux-Hodement - Haut-Bocage en is bedoeld voor regelmatige wandelaars die op zoek zijn naar een grootschalige maar rustige tocht."
    ]
  },
  "rdfs:label": {
    "fr": [
      "PR3 Circuit des Carrières"
    ]
  },
