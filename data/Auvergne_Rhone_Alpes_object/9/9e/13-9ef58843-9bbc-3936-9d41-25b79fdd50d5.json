  "rdfs:comment": {
    "de": [
      "Entdecken Sie diesen einzigartigen Ort der Entspannung, der Einfachheit und Geselligkeit, in dem das Spiel, die Restaurierung und die Animation täglich kombiniert werden."
    ],
    "en": [
      "Discover this unique place of relaxation, made of simplicity and friendliness where game, catering and animation are combined daily."
    ],
    "it": [
      "Il Casinò Golden Palace Noirétable vi accoglie tutti i giorni dell'anno! È situato in posizione ideale tra Saint-Etienne e Clermont-Ferrand, a 5 minuti dall'uscita 31 dell'autostrada A89."
    ],
    "fr": [
      "Le Casino Golden Palace Noirétable vous accueille tous les jours de l'année ! Il est idéalement situé entre Saint-Etienne et Clermont-Ferrand, à 5 minutes de la sortie 31 de l'autoroute A89."
    ],
    "nl": [
      "Het Golden Palace Noirétable Casino verwelkomt u elke dag van het jaar! Het is ideaal gelegen tussen Saint-Etienne en Clermont-Ferrand, op 5 minuten van afrit 31 van de snelweg A89."
    ],
    "es": [
      "El Casino Golden Palace Noirétable le da la bienvenida todos los días del año Está idealmente situado entre Saint-Etienne y Clermont-Ferrand, a 5 minutos de la salida 31 de la autopista A89."
    ]
