  "rdfs:comment": {
    "de": [
      "Entdecken Sie das K-DOX, ein außergewöhnliches Restaurant in Chamrousse, das Sie in einer herzlichen Atmosphäre empfängt und Ihnen unvergessliche Abende mit leckeren Spezialitäten aus den Bergen beschert."
    ],
    "en": [
      "Discover K-DOX, an exceptional restaurant in Chamrousse, welcoming you in a warm atmosphere for unforgettable evenings of tasty mountain specialities."
    ],
    "it": [
      "Scoprite il K-DOX, un ristorante d'eccezione a Chamrousse, che vi accoglie in una calda atmosfera per serate indimenticabili a base di gustose specialità di montagna."
    ],
    "fr": [
      "Découvrez le K-DOX, restaurant d'exception à Chamrousse, qui vous accueille dans une ambiance chaleureuse, pour des soirées inoubliables autour de savoureuses spécialités montagnardes."
    ],
    "nl": [
      "Ontdek K-DOX, een uitzonderlijk restaurant in Chamrousse, dat je in een warme sfeer verwelkomt voor onvergetelijke avonden met smakelijke bergspecialiteiten."
    ],
    "es": [
      "Descubra el K-DOX, un restaurante excepcional en Chamrousse, que le acoge en un ambiente cálido para veladas inolvidables de sabrosas especialidades de montaña."
    ]
  },
  "rdfs:label": {
    "de": [
      "Das K-DOX - Restaurant"
    ],
    "en": [
      "Le K-DOX - Restaurant"
    ],
    "fr": [
      "Le K-DOX - Restaurant"
    ]
  },
