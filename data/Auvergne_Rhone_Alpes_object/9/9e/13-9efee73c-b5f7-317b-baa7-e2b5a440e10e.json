  "rdfs:comment": {
    "de": [
      "Das 1968 in der wilden Landschaft der Monne-Schlucht gegründete Benediktinerkloster Randol wurde 1985 fertiggestellt, was dem Komplex eine bemerkenswerte architektonische Einheit verleiht."
    ],
    "en": [
      "Founded in 1968 in the wild site of the Gorges de la Monne, the construction of the Benedictine monastery of Randol was completed in 1985, giving the complex a remarkable architectural unity."
    ],
    "it": [
      "Fondato nel 1968 nella natura selvaggia delle Gorges de la Monne, la costruzione del monastero benedettino di Randol è stata completata nel 1985, conferendo al complesso una notevole unità architettonica."
    ],
    "fr": [
      "Fondée en 1968 dans le site sauvage des Gorges de la Monne, la construction du monastère bénédictin de Randol a été achevée en 1985, ce qui donne à l'ensemble une remarquable unité architecturale."
    ],
    "nl": [
      "Gesticht in 1968 in de wildernis van de Gorges de la Monne, werd de bouw van het benedictijnenklooster van Randol voltooid in 1985, waardoor het complex een opmerkelijke architectonische eenheid kreeg."
    ],
    "es": [
      "Fundado en 1968 en el desierto de las Gorges de la Monne, la construcción del monasterio benedictino de Randol finalizó en 1985, dando al conjunto una notable unidad arquitectónica."
    ]
  },
