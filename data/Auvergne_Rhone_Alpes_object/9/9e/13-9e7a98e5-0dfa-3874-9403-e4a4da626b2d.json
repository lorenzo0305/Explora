  "rdfs:comment": {
    "de": [
      "Gemütliches Bar-Restaurant, in dem das \"Hausgemachte\" König ist, bis hin zu den Wurstwaren. Chefkoch Benoît ist nämlich ausgebildeter Metzger und Traiteur."
    ],
    "en": [
      "A cosy bar-restaurant where homemade food is king, right down to the charcuterie. Chef Benoît trained as a pork butcher and caterer."
    ],
    "it": [
      "Un accogliente bar-ristorante dove il cibo fatto in casa la fa da padrone, fino ai salumi. Lo chef Benoît si è formato come macellaio e ristoratore di maiali."
    ],
    "fr": [
      "Bar-restaurant chaleureux où le \"fait maison\" est roi, jusqu'à la charcuterie. En effet, le chef Benoît est charcutier traiteur de formation."
    ],
    "es": [
      "Un acogedor bar-restaurante donde la comida casera es la reina, hasta en la charcutería. El chef Benoît se formó como charcutero y restaurador."
    ],
    "nl": [
      "Een gezellig bar-restaurant waar huisgemaakt eten koning is, tot aan de vleeswaren toe. Chef Benoît is opgeleid als varkensslager en traiteur."
    ]
  },
  "rdfs:label": {
