  "rdfs:comment": {
    "de": [
      "Dieser streng mineralische Brunnen aus Ziegelstein befindet sich auf dem Bürgersteig an der Grundstücksgrenze. Poix du Nord besitzt zahlreiche Quellen, früher gab es viele Brunnen dieser Konfiguration in der Gemeinde."
    ],
    "en": [
      "This strictly mineral, brick fountain is located on the sidewalk at the edge of the property. Poix du Nord has many springs, and there used to be many fountains of this configuration in the commune."
    ],
    "it": [
      "Questa fontana, rigorosamente in mattoni minerali, si trova sul marciapiede ai margini della proprietà. Poix du Nord ha molte sorgenti e un tempo nel comune c'erano molte fontane di questa configurazione."
    ],
    "fr": [
      "Cette fontaine strictement minérale en brique se trouve sur le trottoir, en limite de propriété. Poix du Nord possède de nombreuses sources, il y avait avant de nombreuses fontaines de cette configuration dans la commune."
    ],
    "es": [
      "Esta fuente de ladrillo estrictamente mineral se encuentra en la acera, en el límite de la propiedad. Poix du Nord tiene muchos manantiales, y solía haber muchas fuentes de esta configuración en la comuna."
    ],
    "nl": [
      "Deze strikt minerale fontein van baksteen staat op de stoep aan de rand van het domein. Poix du Nord heeft veel bronnen en er waren vroeger veel fonteinen van deze configuratie in de gemeente."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Fontaine"
    ]
  },
