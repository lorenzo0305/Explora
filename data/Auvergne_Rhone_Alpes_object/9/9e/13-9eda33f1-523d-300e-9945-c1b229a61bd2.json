  "rdfs:comment": {
    "de": [
      "Im Norden des Departements Allier, in Lurcy-Lévis, befindet sich Street Art City, der 1. Themenpark der Welt, in dem man die Street Art so intensiv wie nirgendwo sonst erleben kann. Ein originelles und unumgängliches Reiseziel."
    ],
    "en": [
      "STREET ART CITY : an experience unique to live absolutely!\r\nStreet Art City, this unique site in the world dedicated to the Urban design, welcomes in residence of the Artists from 5 continents which come to realize mural paintings to offer to the visitors an unexpected architectural and artistic discovery in total dumping at the heart of the artistic creation.\r\nMore than 22000 m2 of walls to be painted, mural paintings quite more impressive the some than the others. Outside / inside."
    ],
    "it": [
      "A Lurcy-Lévis, nel nord della regione dell'Allier, si trova Street Art City, il 1° parco tematico al mondo dove è possibile scoprire la Street Art come in nessun altro luogo. Una destinazione turistica originale da non perdere."
    ],
    "fr": [
      "Au nord de l'Allier, à Lurcy-Lévis, Street Art City, 1er parc thématique au monde où découvrir le Street Art en immersion comme nulle part ailleurs. Une destination touristique originale et incontournable."
    ],
    "nl": [
      "In Lurcy-Lévis, in het noorden van de Allier, ligt Street Art City, het 1e themapark ter wereld waar je Street Art kunt ontdekken zoals nergens anders. Een originele toeristische bestemming die je niet mag missen."
    ],
    "es": [
      "En Lurcy-Lévis, al norte del departamento de Allier, se encuentra Street Art City, el 1er parque temático del mundo donde podrá descubrir el Street Art como en ningún otro lugar. Un destino turístico original que no debe perderse."
    ]
  },
