  "rdfs:comment": {
    "de": [
      "Spielen Sie mit Cindy Chavana mit der Natur.\r\n\r\nDer Frühling ist nun eingezogen, lassen Sie uns den Traum der Natur genießen... so schön anzusehen... so angenehm zu betreten... und sie hat uns so viel zu bieten!"
    ],
    "en": [
      "Come and play with nature with Cindy Chavana.\r\n\r\nSpring is here and let's enjoy the dream of nature... so beautiful to look at... so pleasant to walk on... and it has so much to offer us!"
    ],
    "it": [
      "Venite a giocare con la natura con Cindy Chavana.\r\n\r\nLa primavera è arrivata e godiamoci il sogno della natura... così bella da guardare... così piacevole da percorrere... e ha così tanto da offrirci!"
    ],
    "fr": [
      "Venez jouer avec la nature avec Cindy Chavana. \r\n\r\nLe printemps est désormais installé, profitons du rêve de la nature... si belle à regarder... si agréable à fouler... ette a tant à nous offrir !"
    ],
    "es": [
      "Ven a jugar con la naturaleza con Cindy Chavana.\r\n\r\nLa primavera ya está aquí y vamos a disfrutar del sueño de la naturaleza... tan bonita de ver... tan agradable para pasear... ¡y tiene tanto que ofrecernos!"
    ],
    "nl": [
      "Kom spelen met de natuur met Cindy Chavana.\r\n\r\nHet is lente en laten we genieten van de droom van de natuur... zo mooi om naar te kijken... zo aangenaam om in te wandelen... en het heeft ons zoveel te bieden!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Balade Natur'à Pattes"
    ]
  },
