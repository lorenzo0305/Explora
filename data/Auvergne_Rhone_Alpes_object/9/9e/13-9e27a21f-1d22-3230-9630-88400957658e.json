  "rdfs:comment": {
    "de": [
      "Seit Juni 2018 ist unser neues Team geöffnet und empfängt Sie montags bis mittwochs von 12 bis 14 Uhr und donnerstags bis samstags von 12 bis 14 Uhr und von 19 bis 22 Uhr."
    ],
    "en": [
      "Open since June 2018, our new team welcomes you from Monday to Wednesday from 12h to 14h and from Thursday to Saturday from 12h to 14h and from 19h to 22h."
    ],
    "it": [
      "Aperto da giugno 2018, il nostro nuovo team vi accoglie dal lunedì al mercoledì dalle 12.00 alle 14.00 e dal giovedì al sabato dalle 12.00 alle 14.00 e dalle 19.00 alle 22.00."
    ],
    "fr": [
      "Ouvert depuis juin 2018, notre nouvelle équipe vous accueille, du lundi au mercredi de 12h à 14h et du jeudi au samedi, de 12h à 14h et de 19h à 22h."
    ],
    "nl": [
      "Open sinds juni 2018, ons nieuwe team verwelkomt u van maandag tot woensdag van 12u tot 14u en van donderdag tot zaterdag van 12u tot 14u en van 19u tot 22u."
    ],
    "es": [
      "Abierto desde junio de 2018, nuestro nuevo equipo le da la bienvenida de lunes a miércoles de 12 a 14 horas y de jueves a sábado de 12 a 14 y de 19 a 22 horas."
    ]
  },
