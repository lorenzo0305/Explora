  "rdfs:comment": {
    "de": [
      "Seit sehr langer Zeit wurden in Pampailly silberhaltige Bleiminen betrieben. Jacques COEUR erwarb sie und sie wurden zu den größten und modernsten des Königreichs."
    ],
    "en": [
      "Silver-lead mines had long been exploited in Pampailly. Jacques COEUR acquired them, and they became the largest and most modern in the kingdom."
    ],
    "it": [
      "Le miniere di piombo argentato erano sfruttate a Pampailly da molto tempo. Jacques COEUR le acquistò e divennero le più grandi e moderne del regno."
    ],
    "fr": [
      "Depuis très longtemps des mines de plomb argentifère ont été exploitées à Pampailly. Jacques COEUR les acquiert, elles deviennent les plus importantes et modernes du royaume."
    ],
    "es": [
      "Las minas de plata y plomo se explotaban en Pampailly desde hacía mucho tiempo. Jacques COEUR las adquiere y se convierten en las más grandes y modernas del reino."
    ],
    "nl": [
      "In Pampailly werden al heel lang zilverloodmijnen geëxploiteerd. Jacques COEUR kocht ze en ze werden de grootste en modernste van het koninkrijk."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les mines d'argent Jacques Coeur"
    ]
  },
