  "rdfs:comment": {
    "de": [
      "Die Gemeinde St Christophe en Oisans liegt im Herzen des Nationalparks Écrins und verfügt über ein bemerkenswertes Naturerbe. Jedes Tal ist einzigartig und bietet prächtige Panoramen auf mythische Gipfel wie La Meije, Les Écrins oder La Dibona."
    ],
    "en": [
      "Located in the heart of the Ecrins National Park, the village of St Christophe en Oisans has a remarkable natural heritage. Each valley is original and offers magnificent views of the mythical summits such as La Meije, Les Écrins or La Dibona."
    ],
    "it": [
      "Situato nel cuore del Parco Nazionale degli Ecrins, il comune di St Christophe en Oisans vanta un notevole patrimonio naturale. Ogni valle è originale e offre sontuosi panorami su cime mitiche come la Meije, gli Écrins o il Dibona."
    ],
    "fr": [
      "Située au cœur du Parc National des Écrins, la commune de St Christophe en Oisans possède un patrimoine naturel remarquable. Chaque vallon est original et offre des panoramas somptueux sur des sommets mythiques tel que la Meije, les Écrins ou la Dibona."
    ],
    "es": [
      "Situado en el corazón del Parque Nacional de los Ecrins, el municipio de St Christophe en Oisans cuenta con un notable patrimonio natural. Cada valle es original y ofrece suntuosos panoramas de picos míticos como el Meije, los Écrins o la Dibona."
    ],
    "nl": [
      "De gemeente St Christophe en Oisans is gelegen in het hartje van het nationaal park van de Ecrins en bezit een uitzonderlijk natuurerfgoed. Elke vallei is origineel en biedt prachtige uitzichten over de legendarische toppen van de Meije, de Ecrins of de Dibona."
    ]
  },
  "rdfs:label": {
    "en": [
