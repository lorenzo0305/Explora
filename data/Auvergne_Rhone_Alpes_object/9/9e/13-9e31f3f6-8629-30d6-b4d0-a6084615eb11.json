  "rdfs:comment": {
    "de": [
      "Erreichen Sie wie im Winter die Gipfel ohne Ermüdung und gelangen Sie zu den prächtigen Panoramen der Alpen, während Sie die Berge in Ihrem eigenen Rhythmus erkunden. Dieser Sessellift, der in Montchavin startet, bringt Sie nach Le Sauget."
    ],
    "en": [
      "Just like in winter, reach the summits without tiring and enjoy the sumptuous panoramas of the Alps while discovering the mountains at your own pace. This chairlift from Montchavin takes you to Le Sauget."
    ],
    "it": [
      "Come in inverno, raggiungete le cime senza fatica e accedete ai sontuosi panorami delle Alpi scoprendo la montagna al vostro ritmo. Questa seggiovia, da Montchavin, vi porta a Le Sauget."
    ],
    "fr": [
      "Comme en hiver, gagnez les sommets sans fatigue et accédez aux somptueux panoramas des Alpes tout en découvrant la montagne à votre rythme. Ce télésiège, au départ de Montchavin, vous emmène au Sauget."
    ],
    "nl": [
      "Net als in de winter bereik je de toppen zonder moe te worden en geniet je van de weidse panorama's van de Alpen terwijl je de bergen in je eigen tempo ontdekt. Deze stoeltjeslift van Montchavin brengt je naar Le Sauget."
    ],
    "es": [
      "Como en invierno, alcance las cumbres sin fatiga y acceda a los suntuosos panoramas de los Alpes mientras descubre la montaña a su ritmo. Este telesilla, desde Montchavin, le lleva a Le Sauget."
    ]
  },
  "rdfs:label": {
    "en": [
      "Montchavin chairlift"
    ],
    "fr": [
      "Télésiège de Montchavin"
    ],
    "nl": [
      "Stoeltjeslift van Montchavin"
    ]
  },
