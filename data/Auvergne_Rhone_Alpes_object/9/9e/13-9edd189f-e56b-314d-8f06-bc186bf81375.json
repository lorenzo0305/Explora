  "rdfs:comment": {
    "de": [
      "Wellness-Massagen und holistische Behandlungen nach Vereinbarung.\r\nIndividuelle Angebote für Privatpersonen, Sportler und Berufstätige, die Entspannung, Erholung und Ausgeglichenheit fördern.\r\nInterventionen zu Hause, vor Ort oder in Unternehmen."
    ],
    "en": [
      "Wellness massages and holistic treatments by appointment.\r\nPersonalized services for individuals, athletes and professionals, promoting relaxation, recovery and balance.\r\nAt home, on site or in the workplace."
    ],
    "it": [
      "Massaggi benessere e trattamenti olistici su appuntamento.\r\nServizi personalizzati per privati, sportivi e professionisti, che favoriscono il rilassamento, il recupero e l'equilibrio.\r\nLavoro a domicilio, in sede o in azienda."
    ],
    "fr": [
      "Massages bien-être et soins holistiques sur rendez-vous.\r\nPrestations personnalisées pour particuliers, sportifs et professionnels, favorisant détente, récupération et équilibre.\r\nInterventions à domicile, sur site ou en entreprise."
    ],
    "nl": [
      "Wellnessmassages en holistische behandelingen op afspraak.\r\nPersoonlijke diensten voor particulieren, sporters en professionals, ter bevordering van ontspanning, herstel en balans.\r\nThuis, op locatie of in bedrijven."
    ],
    "es": [
      "Masajes de bienestar y tratamientos holísticos con cita previa.\r\nServicios personalizados para particulares, deportistas y profesionales, que favorecen la relajación, la recuperación y el equilibrio.\r\nTrabajo a domicilio, in situ o en empresas."
    ]
  },
