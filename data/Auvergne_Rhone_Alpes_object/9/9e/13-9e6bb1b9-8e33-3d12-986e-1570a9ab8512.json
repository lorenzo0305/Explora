  "rdfs:comment": {
    "de": [
      "Entdecken Sie die von Marie Pouget zusammengestellte Ausstellung, aber auch die einzigartigen Räume dieses Klosters mit dem Speisesaal und der Apotheke."
    ],
    "en": [
      "Come and discover the exhibition curated by Marie Pouget, as well as the convent's unique dining room and apothecary."
    ],
    "it": [
