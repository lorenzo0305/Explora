  "rdfs:comment": {
    "de": [
      "Das Restaurant Le Val d'Amby bietet zwei Gourmet-Atmosphären: einen bistronomischen Mittagstisch unter der Woche und eine Gourmetküche, die mittags und abends serviert wird. \r\nIn der Küche sorgt Dominique Grisoni, Maître Restaurateur, für eine kreative Speisekarte, die sich nach den Jahreszeiten richtet."
    ],
    "en": [
      "The Le Val d'Amby restaurant offers 2 gourmet settings: a bistronomic table for lunch during the week and gastronomic cuisine for lunch and dinner. \r\nIn the kitchen, Dominique Grisoni, Maître Restaurateur, creates a creative menu that reflects the seasons."
    ],
    "it": [
      "Il ristorante Le Val d'Amby offre 2 ambienti gourmet: una tavola bistronomica per il pranzo durante la settimana e una cucina gastronomica per il pranzo e la cena.\r\nIn cucina, Dominique Grisoni, Maître Restaurateur, crea un menu creativo che rispecchia le stagioni."
    ],
    "fr": [
      "Le restaurant Le Val d’Amby offre 2 ambiances gourmandes : une table bistronomique le midi en semaine et une cuisine gastronomique servie midi et soir. \r\nEn cuisine, Dominique Grisoni, Maître restaurateur signe une carte créative rythmée par les saisons."
    ],
    "nl": [
      "Het restaurant Le Val d'Amby biedt 2 gastronomische settings: een bistronomische tafel voor de lunch tijdens de week en een gastronomische keuken voor lunch en diner.\r\nIn de keuken creëert Dominique Grisoni, Maître Restaurateur, een creatief menu dat de seizoenen weerspiegelt."
    ],
    "es": [
      "El restaurante Le Val d'Amby ofrece 2 ambientes gastronómicos: una mesa bistronómica para almorzar entre semana y cocina gastronómica para comer y cenar.\r\nEn la cocina, Dominique Grisoni, Maître Restaurateur, crea un menú creativo que refleja las estaciones."
    ]
  },
