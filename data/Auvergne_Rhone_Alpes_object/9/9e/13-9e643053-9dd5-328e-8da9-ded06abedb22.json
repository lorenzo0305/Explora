  "rdfs:comment": {
    "de": [
      "Im Schein einer Laterne folgen Sie dem Führer auf eine originelle, immersive Tour, um in die Nacht der Ausstellung einzutauchen."
    ],
    "en": [
      "By the light of a lantern, follow the guide on an original immersive tour, plunging you into the night of the exhibition."
    ],
    "it": [
      "Alla luce di una lanterna, seguite la guida in un'originale visita immersiva, che vi farà immergere nella notte della mostra."
    ],
    "fr": [
      "À la lueur d’une lanterne, suivez le guide pour une visite immersive originale, pour plonger dans la nuit de l’exposition."
    ],
    "nl": [
      "Volg de gids bij het licht van een lantaarn voor een originele, meeslepende rondleiding die je onderdompelt in de nacht van de tentoonstelling."
    ],
    "es": [
      "A la luz de una linterna, siga al guía en una original visita inmersiva que le sumergirá en la noche de la exposición."
    ]
  },
