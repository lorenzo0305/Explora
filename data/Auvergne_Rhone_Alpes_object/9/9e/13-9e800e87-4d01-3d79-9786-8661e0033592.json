  "rdfs:comment": {
    "de": [
      "Nehmen Sie am Sonntag, den 22. März, am Puzzlewettbewerb in Saint-Christophe-sur-Dolaizon teil! Ob Junior, Amateur oder Experte: Nehmen Sie die Herausforderung allein oder mit der Familie an. Puzzles werden den Teilnehmern geschenkt. Begrenzte Plätze, Anmeldung erforderlich!"
    ],
    "en": [
      "Take part in the Puzzle Contest on Sunday March 22 in Saint-Christophe-sur-Dolaizon! Whether you're a junior, an amateur or an expert, take up the challenge alone or with your family. Puzzles offered to participants. Places limited, registration required!"
    ],
    "it": [
      "Partecipate alla gara di puzzle domenica 22 marzo a Saint-Christophe-sur-Dolaizon! Che siate giovani, dilettanti o esperti, accettate la sfida da soli o con la vostra famiglia. I puzzle sono gratuiti per i partecipanti. I posti sono limitati, quindi iscrivetevi subito!"
    ],
    "fr": [
      "Participez au Concours de Puzzle le dimanche 22 mars à Saint-Christophe-sur-Dolaizon ! Junior, amateur ou expert : relevez le défi en solo ou en famille. Puzzles offerts aux participants. Places limitées, inscription obligatoire !"
    ],
    "es": [
      "Participe en el Concurso de Puzzles el domingo 22 de marzo en Saint-Christophe-sur-Dolaizon Tanto si es un principiante, un aficionado o un experto, acepte el reto solo o en familia. Puzzles gratuitos para los participantes. Las plazas son limitadas, ¡inscríbase ya!"
    ],
    "nl": [
      "Doe mee aan de puzzelwedstrijd op zondag 22 maart in Saint-Christophe-sur-Dolaizon! Of je nu een junior, amateur of expert bent, ga de uitdaging aan, alleen of met je gezin. Gratis puzzels voor deelnemers. De plaatsen zijn beperkt, dus schrijf je nu in!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Concours de puzzles"
    ]
  },
