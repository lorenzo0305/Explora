  "rdfs:comment": {
    "de": [
      "Strecke von 6, 12 oder 20 Km zwischen Vogüé und Ruoms oder durch die Ardèche-Schlucht."
    ],
    "en": [
      "Come on an amazing canoe or kayak trip on the Ardèche in Ruoms near Vallon Pont d'Arc. The entire Argonautes team is here to meet you at the canoe base in Ruoms on the banks of the Ardèche River."
    ],
    "it": [
      "Venite a fare una gita in canoa o kayak sull'Ardèche da Vogüé a Ruoms, vicino a Vallon Pont d'Arc. Il team Argonautes vi accoglie nella sua base di canoa a Ruoms, sulle rive dell'Ardèche."
    ],
    "fr": [
      "Venez réaliser une belle balade en canoë ou en kayak sur l’Ardèche de Vogüé à Ruoms près de Vallon Pont d'Arc. Toute l'équipe des Argonautes vous accueille à sa base de canoë située à Ruoms en bordure de la rivière Ardèche."
    ],
    "es": [
      "Venga a disfrutar de una excursión en canoa o kayak por el Ardèche desde Vogüé hasta Ruoms, cerca de Vallon Pont d'Arc. El equipo de los Argonautas le da la bienvenida en su base de canoas de Ruoms, a orillas del río Ardèche."
    ],
    "nl": [
      "Kom een mooie afvaart maken per kano of kajak op de rivier Ardèche in Ruoms, dicht bij Vallon Pont d'Arc gelegen. Heel het team van \"Les Argonautes\" ontvangt u aan de kano-basis aan de oever van de rivier."
    ]
  },
  "rdfs:label": {
    "de": [
      "Kanu-Kajak - Argonautes"
    ],
    "en": [
      "Location Canoe Kayak - Argonautes"
    ],
    "fr": [
      "Location Canoë Kayak - Argonautes"
    ],
    "nl": [
      "Kano-kayak - Argonautes"
    ]
  },
