  "rdfs:comment": {
    "de": [
      "Öko-Weideflächen, Erholungsgebiete, Spielplätze, City-Stadion, Turngeräte?und das alles mit einem atemberaubenden Blick auf die Halden von Loos-en-Gohelle."
    ],
    "en": [
      "Eco-pasture areas, relaxation areas, playgrounds, city stadium, apparatus? all with a breathtaking view of the Loos-en-Gohelle slag heaps."
    ],
    "it": [
      "Aree di pascolo ecologico, aree relax, parchi giochi, stadio cittadino, apparati, il tutto con una vista mozzafiato sui cumuli di scorie di Loos-en-Gohelle."
    ],
    "fr": [
      "Espaces d’éco-pâturage, de détente, aires de jeux, city stade, agrès…le tout avec une vue imprenable sur les terrils de Loos-en-Gohelle."
    ],
    "es": [
      "Zonas de ecopasto, áreas de descanso, parques infantiles, estadio municipal, aparatos... todo ello con una impresionante vista de los escoriales de Loos-en-Gohelle."
    ],
    "nl": [
      "Eco-weiden, ontspanningsgebieden, speeltuinen, stadsstadion, toestellen? allemaal met een adembenemend uitzicht op de terrils van Loos-en-Gohelle."
    ]
  },
