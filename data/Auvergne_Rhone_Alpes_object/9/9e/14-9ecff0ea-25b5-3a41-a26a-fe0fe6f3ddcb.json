  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/a0d683c2-1874-33b5-be0a-1e6afab7bbd9",
      "dc:description": {
        "de": [
          "Treffpunkt ab 19.30 Uhr in der Salle des Fêtes von Bourthes für einen verrückten Abend\nFreier Eintritt - offene Bühne ab 19.30 Uhr\nKleine Speisen und Getränke vor Ort"
        ],
        "en": [
          "Join us from 7.30pm at the Salle des Fêtes in Bourthes for a wild evening\nFree admission - open stage from 7.30pm\nSnacks and refreshments on site"
        ],
        "it": [
          "Unitevi a noi dalle 19.30 presso la Salle des Fêtes di Bourthes per una serata di follia\nIngresso libero - palco aperto dalle 19.30\nSnack e rinfreschi in loco"
        ],
        "fr": [
          "Rendez-vous à partir de 19h30 à la Salle des Fêtes de Bourthes pour une soirée de folie\nEntrée libre - scène ouverte à partir de 19h30\nPetite restauration et buvette sur place"
        ],
        "es": [
          "Únete a nosotros a partir de las 19.30 en la Salle des Fêtes en Bourthes para una noche de locura\nEntrada gratuita - escenario abierto a partir de las 19.30 h\nAperitivos y refrescos in situ"
        ],
        "nl": [
          "Kom vanaf 19.30 uur naar de Salle des Fêtes in Bourthes voor een avond vol waanzin\nGratis toegang - open podium vanaf 19.30 uur\nSnacks en drankjes ter plaatse"
        ]
      },
