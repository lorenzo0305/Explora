  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/6655546d-f334-3dd9-ae26-2081cf929d64",
      "dc:description": {
        "de": [
          "Große Auswahl an Produkten :\n-Spirituosen\n-Weine\n-Champagner\n-Crémant\n-regionale Produkte\n-biere\n-fut Bier 6L, 20L und 30L\n-vermietung von Bierzapfanlagen\n-wasser\n-Soft\n-getränke Glas Pfand"
        ],
        "en": [
          "Wide range of products :\n-Spirits\n-Wines\n-Champagne\n-Crémant\n-local products\n-beers\n-6L, 20L and 30L beer bottles\n-beer pump rental\n-water\n-Soft drinks\n-beverages glass deposits"
        ],
        "it": [
          "Ampia gamma di prodotti :\n-Liquori\n-Vini\n-Champagne\n-Crémant\n-prodotti locali\n-birre\n-bottiglie di birra da 6L, 20L e 30L\n-noleggio pompa birra\n-acqua\n-Bevande analcoliche\n-depositi di vetro per bevande"
        ],
        "fr": [
          "Large gamme de produits :\n-Spiritueux\n-Vins\n-Champagne\n-Crémant\n-produits du terroir\n-bières\n-fut bière 6L, 20L et 30L\n-location pompe à bière\n-eau\n-Soft\n-boissons verre consignes"
        ],
        "nl": [
          "Breed scala aan producten :\n-Gedistilleerde dranken\n-Wijnen\n-Champagne\n-Crémant\n-lokale producten\n-bieren\n-6L, 20L en 30L bierflessen\n-verhuur bierpompen\n-water\n-Frisdranken\n-statiegeld drankglas"
        ],
        "es": [
          "Amplia gama de productos :\n-Licores\n-Vinos\n-Champán\n-Crémant\n-productos locales\n-cervezas\n-botellas de cerveza de 6L, 20L y 30L\n-alquiler de surtidores de cerveza\n-agua\n-Refrescos\n-depósitos de vidrio para bebidas"
        ]
      },
