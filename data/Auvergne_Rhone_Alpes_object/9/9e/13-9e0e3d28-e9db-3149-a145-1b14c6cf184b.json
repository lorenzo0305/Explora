  "rdfs:comment": {
    "de": [
      "Das Restaurant \"La Boussole\" bietet Ihnen eine köstliche, raffinierte und saisonale Küche. Der Chefkoch, Thomas Streit, abeitet ausschließlich mit Erzeugnissen aus französischem Anbau und kurzen Transportwegen."
    ],
    "en": [
      "The restaurant \"La Boussole\" boasts a menu of delicious and elegant seasonal cuisine. The Chef, Thomas Streit uses only French-sourced products, mainly from local producers."
    ],
    "it": [
      "Il ristorante \"La Boussole\" offre una cucina gustosa e raffinata che segue il ritmo delle stagioni. Lo chef, Stéphane Cadillon, lavora esclusivamente con prodotti di fattoria francesi, provenienti soprattutto da canali di distribuzione brevi."
    ],
    "fr": [
      "Le restaurant \"la Boussole\" vous propose une cuisine savoureuse et raffinée élaborée au rythme des saisons. Le Chef, Stéphane Cadillon, travaille uniquement des produits de l'agriculture française et principalement de circuits courts."
    ],
    "nl": [
      "Het restaurant \"La Boussole\" biedt een smakelijke, verfijnde keuken die het ritme van de seizoenen volgt. De chef-kok, Stéphane Cadillon, werkt uitsluitend met producten van de Franse landbouw en voornamelijk van korte distributiekanalen."
    ],
    "es": [
      "El restaurante \"La Boussole\" ofrece una cocina sabrosa y refinada que sigue el ritmo de las estaciones. El chef, Stéphane Cadillon, trabaja exclusivamente con productos procedentes de la agricultura francesa y principalmente de cadenas de suministro cortas."
    ]
  },
