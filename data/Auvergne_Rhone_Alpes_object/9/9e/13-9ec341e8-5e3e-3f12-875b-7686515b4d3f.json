  "rdfs:comment": {
    "de": [
      "Durch Kreativität werde ich Sie dazu bringen, sich selbst zu entdecken, sich auszudrücken (allein, in der Gruppe, Team-Building, ...) über die Malerei, die Land-Art für Ihr Wohlbefinden."
    ],
    "en": [
      "Through creativity, I'll help you discover yourself, express yourself (alone, in a group, team-building, ...) through painting, land-art for your well-being."
    ],
    "it": [
      "Attraverso la creatività, vi aiuterò a scoprire voi stessi e ad esprimervi (da soli, in gruppo, in team building, ecc.) attraverso la pittura e la land-art per migliorare il vostro benessere."
    ],
    "fr": [
      "Par la créativité, je vous emmènerai à vous découvrir, vous exprimer (seul, en groupe, team-building, ..) via la peinture, le land-art pour votre mieux-être."
    ],
    "nl": [
      "Door middel van creativiteit help ik je jezelf te ontdekken en uit te drukken (alleen, in een groep, teambuilding, enz.) door middel van schilderen en land-art om je welzijn te verbeteren."
    ],
    "es": [
      "A través de la creatividad, te ayudaré a descubrirte a ti mismo y a expresarte (solo, en grupo, en equipo, etc.) mediante la pintura y el land-art para mejorar tu bienestar."
    ]
  },
