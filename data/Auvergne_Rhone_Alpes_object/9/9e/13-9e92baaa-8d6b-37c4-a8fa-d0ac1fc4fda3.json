  "rdfs:comment": {
    "de": [
      "Familiengeführtes, traditionelles Restaurant mit Bergspezialitäten, das das ganze Jahr über geöffnet ist. Im Gault et Millau und Petit Futé gelistet.\r\nHausgemachte Küche mit frischen und saisonalen Produkten.\r\nWeinkarte, glas- und flaschenweise serviert, darunter auch Bio-Weine."
    ],
    "en": [
      "Family and traditional restaurant with mountain specialities, open all year round. Listed in Gault et Millau and Petit Futé.\r\nHome cooking with fresh seasonal produce.\r\nWine list, served by the glass and by the bottle, including organic wines."
    ],
    "it": [
      "Ristorante familiare e tradizionale e specialità di montagna aperto tutto l'anno. Riferito a Gault et Millau e Petit Futé.\r\nCucina casalinga con prodotti freschi e di stagione.\r\nCarta dei vini, servita al bicchiere e alla bottiglia, compresi i suoi vini biologici."
    ],
    "fr": [
      "Restaurant familial, traditionnel et spécialités de montagne ouvert à l’année. Référencé au Gault et Millau et Petit Futé.\r\nCuisine maison avec ses produits frais et de saison.\r\nCarte des vins, servi au verre et à la bouteille, dont ses vins bio."
    ],
    "nl": [
      "Traditioneel familierestaurant met specialiteiten uit de bergen, het hele jaar geopend. Opgenomen in Gault et Millau en Petit Futé.\r\nHuisgemaakte keuken met verse seizoensproducten.\r\nWijnkaart, geserveerd per glas en per fles, inclusief biologische wijnen."
    ],
    "es": [
      "Restaurante familiar tradicional con especialidades de montaña, abierto todo el año. Clasificado en Gault et Millau y Petit Futé.\r\nCocina casera con productos frescos de temporada.\r\nCarta de vinos, servidos por copas y botellas, incluidos vinos ecológicos."
    ]
  },
  "rdfs:label": {
