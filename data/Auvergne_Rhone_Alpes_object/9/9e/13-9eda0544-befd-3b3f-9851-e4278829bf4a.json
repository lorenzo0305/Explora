  "rdfs:comment": {
    "de": [
      "Den Sommer mit einem gemütlichen Familienausflug beginnen!\r\nEine sommerliche Auszeit, um das große Abenteuer des Festivals Les Petits Baroudeurs am Ufer des Flusses Dunière in der idyllischen Umgebung des Campingplatzes von Vaubarlet**** zu erleben."
    ],
    "en": [
      "Start the summer by taking it easy with your family!\r\nA summer break to experience the great adventure of the Festival Les Petits Baroudeurs on the banks of the Dunière in the idyllic setting of the Vaubarlet campsite****."
    ],
    "it": [
      "Iniziare l'estate con calma in famiglia!\r\nUna pausa estiva per vivere la grande avventura del Festival Les Petits Baroudeurs sulle rive della Dunière nell'idilliaca cornice del campeggio Vaubarlet****."
    ],
    "fr": [
      "Commencer l'été par se la couler douce en famille !\r\nUne parenthèse estivale pour vivre la grande aventure du Festival Les Petits Baroudeurs au bord de la Dunière dans le cadre idyllique du camping de Vaubarlet****."
    ],
    "es": [
      "¡Empiece el verano descansando en familia!\r\nUna escapada estival para vivir la gran aventura del Festival Les Petits Baroudeurs a orillas del Dunière en el idílico entorno del camping Vaubarlet****."
    ],
    "nl": [
      "Begin de zomer door het rustig aan te doen met het gezin!\r\nEen zomervakantie om het grote avontuur van het Festival Les Petits Baroudeurs te beleven aan de oevers van de Dunière in de idyllische omgeving van camping Vaubarlet****."
    ]
  },
  "rdfs:label": {
    "fr": [
