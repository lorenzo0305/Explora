  "rdfs:comment": {
    "de": [
      "Die Via Ferrata von Fort l?Écluse in der Gemeinde Léaz im Departement Ain bietet einen herrlichen Blick auf die Rhône und die Schlucht von l'Écluse. Der Ausstieg auf Höhe des Forts macht den Weg noch interessanter."
    ],
    "en": [
      "The Fort l'Écluse Via Ferrata, located in the municipality of Léaz in the Ain department, offers a splendid view of the Rhône River and the Écluse Gorge. The exit at the Fort adds even more interest to the route."
    ],
    "it": [
      "La via ferrata del Fort l'Écluse, situato nel comune di Léaz nel dipartimento dell'Ain, offre una splendida vista sul Rodano e sulle gole dell'Écluse. L'uscita al Forte aggiunge ulteriore interesse al percorso."
    ],
    "fr": [
      "La Via Ferrata de Fort l’Écluse, située sur la commune de Léaz dans l'Ain, offre une vue splendide sur le Rhône et le défilé de l’Écluse. La sortie au niveau du Fort ajoute encore de l'intérêt au parcours."
    ],
    "es": [
      "La vía ferrata de Fort l'Écluse, situado en el municipio de Léaz, en el departamento de Ain, ofrece una espléndida vista del Ródano y del desfiladero de l'Écluse. La salida del Fuerte añade aún más interés a la ruta."
    ],
    "nl": [
      "De Via Ferrata bij Fort l?Écluse, gelegen in de gemeente Léaz in het departement Ain, biedt een prachtig uitzicht op de Rhône en de Écluse-kloof. De afslag bij het Fort maakt de route nog interessanter."
    ]
  },
