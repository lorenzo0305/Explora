  "rdfs:comment": {
    "de": [
      "Die Mediathek empfängt ihre Besucher von Dienstag bis Samstag im Herzen von Montbrun les Bains. Tarif für Kurgäste und Urlauber für die gesamte Dauer des Aufenthalts angeboten."
    ],
    "en": [
      "The multi-media library of Montbrun les Bains welcomes you from tuesday to saturday in the centre of the village. Three weeks' special price for the curists."
    ],
    "it": [
      "La mediateca accoglie i visitatori dal martedì al sabato nel cuore di Montbrun les Bains. Curisti e villeggianti pagano 5? per tutta la durata del loro soggiorno"
    ],
    "fr": [
      "La médiathèque accueille ses visiteurs du mardi au samedi au cœur de Montbrun les Bains. Tarif curistes et vacanciers proposé pour toute la durée du séjour (5€)"
    ],
    "es": [
      "La mediateca recibe visitantes de martes a sábado en pleno centro de Montbrun les Bains. Los turistas y veraneantes pagan 5? por la duración de su estancia"
    ],
    "nl": [
      "De mediatheek van Montbrun les Bains verwelkomt zijn bezoekers van dinsdag tot zaterdag in het centrum van Montbrun les Bains. Tarieven voor curisten en vakantiegangers zijn beschikbaar voor de duur van het verblijf."
    ]
  },
