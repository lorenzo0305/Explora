  "rdfs:comment": {
    "de": [
      "Machen Sie sich mithilfe Ihrer Karte auf die Suche nach den zehn Markierungen, die diesen permanenten Orientierungsparcours bilden, und beantworten Sie Fragen, um mehr über das Kulturerbe von Les Contamines zu erfahren."
    ],
    "en": [
      "Use your map to find the ten markers that make up this permanent orienteering course, and answer questions to learn more about the heritage of Les Contamines."
    ],
    "it": [
      "Utilizzate la vostra mappa per trovare i dieci punti che compongono questo percorso di orientamento permanente e rispondete alle domande per saperne di più sul patrimonio di Les Contamines."
    ],
    "fr": [
      "A l'aide de votre carte, partez à la recherche des dix balises qui composent ce parcours permanent d'orientation, et répondez aux questions pour en apprendre plus sur le patrimoine des Contamines."
    ],
    "es": [
      "Utiliza tu mapa para encontrar las diez balizas que componen este recorrido permanente de orientación y responde a las preguntas para saber más sobre el patrimonio de Les Contamines."
    ],
    "nl": [
      "Gebruik je kaart om de tien markeringen te vinden die deel uitmaken van dit permanente oriëntatieparcours en beantwoord de vragen om meer te weten te komen over het erfgoed van Les Contamines."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parcours d'orientation - parcours patrimoine"
    ]
  },
