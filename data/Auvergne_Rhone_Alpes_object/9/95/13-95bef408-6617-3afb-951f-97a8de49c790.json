  "rdfs:comment": {
    "de": [
      "In diesem wunderschönen Ort mit seiner angenehmen und raffinierten Dekoration ist das Restaurant Mar Y Sol eine Einladung zum Reisen und Schlemmen und bietet eine großzügige und originelle Küche."
    ],
    "en": [
      "The Mar Y Sol restaurant is an invitation to travel and indulge in generous, original cuisine in a superb setting with a pleasant, refined decor."
    ],
    "it": [
      "Il ristorante Mar Y Sol, in questo superbo ambiente dall'arredamento piacevole e raffinato, è un invito a viaggiare e a concedersi una cucina generosa e originale."
    ],
    "fr": [
      "Dans ce superbe lieu à la décoration agréable et raffinée, le restaurant Mar Y Sol est une invitation au voyage et à la gourmandise qui propose une cuisine généreuse et originale."
    ],
    "nl": [
      "Het restaurant Mar Y Sol, in deze prachtige omgeving met zijn aangename, verfijnde inrichting, nodigt uit tot een reis en een gulle, originele keuken."
    ],
    "es": [
      "El restaurante Mar Y Sol, en este magnífico marco de decoración agradable y refinada, invita a viajar y a deleitarse con una cocina generosa y original."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Mar Y Sol Restaurant"
    ]
  },
