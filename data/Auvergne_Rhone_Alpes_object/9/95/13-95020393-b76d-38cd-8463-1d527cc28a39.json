  "rdfs:comment": {
    "de": [
      "Das gemeindeübergreifende Maison des Arts ist ein Ausstellungsraum, der Künstlern und Kunsthandwerkern aus der Tarentaise, aber auch Gästen aus aller Welt bei wechselnden Ausstellungen gewidmet ist."
    ],
    "en": [
      "La Maison des Arts intercommunal is an exhibition space dedicated to Tarentaise artists and artisans as well as to guests from all walks of life during temporary exhibitions."
    ],
    "it": [
      "La Maison des Arts intercommunale è uno spazio espositivo dedicato agli artisti e agli artigiani tarentaise, ma anche agli ospiti di tutti gli orizzonti durante le mostre temporanee."
    ],
    "fr": [
      "La Maison des Arts intercommunale est un espace d’exposition dédié aux artistes et artisans d’art de Tarentaise mais également aux invités de tous les horizons lors d’expositions temporaires."
    ],
    "es": [
      "La Maison des Arts intercommunale es un espacio de exposición dedicado a los artistas y artesanos de Tarentaise, pero también a invitados de todos los horizontes durante las exposiciones temporales."
    ],
    "nl": [
      "Het Maison des Arts intercommunale is een tentoonstellingsruimte gewijd aan Tarentaise kunstenaars en ambachtslieden, maar ook aan gasten van alle horizonten tijdens tijdelijke tentoonstellingen."
    ]
  },
