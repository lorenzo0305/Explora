  "rdfs:comment": {
    "de": [
      "Amandine und Adrien freuen sich, Sie in ihrem Restaurant am Ufer der Ardèche begrüßen zu dürfen. Das Restaurant befindet sich in einer alten Mühle mit einem wunderschönen Gewölbesaal und einem schattigen Garten."
    ],
    "en": [
      "Amandine and Adrien would love to welcome you to their restaurant Les Coloquintes on the banks of the Ardèche in a former mill with a fabulous vaulted room and a garden in the shade of the lime trees."
    ],
    "it": [
      "Amandine e Adrien sono lieti di accogliervi nel loro ristorante sulle rive del fiume Ardèche, situato in un antico mulino con una magnifica sala a volta e un giardino ombreggiato."
    ],
    "fr": [
      "Amandine et Adrien sont heureux de vous accueillir dans leur restaurant au bord du quai de l’Ardèche situé dans un ancien moulinage avec magnifique salle voûtée et jardin ombragé."
    ],
    "es": [
      "Amandine y Adrien están encantados de recibirle en su restaurante a orillas del río Ardèche, situado en un antiguo molino con una magnífica sala abovedada y un jardín sombreado."
    ],
    "nl": [
      "Amandine en Adrien heten u van harte welkom in hun restaurant aan de oever van de rivier de Ardèche, gevestigd in een oude molen met een prachtige gewelfde zaal en schaduwrijke tuin."
    ]
  },
