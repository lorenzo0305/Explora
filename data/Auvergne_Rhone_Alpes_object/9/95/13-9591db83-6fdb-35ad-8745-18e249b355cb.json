  "rdfs:comment": {
    "de": [
      "In der Prioratskirche von Souvigny findet eine Lesung des Gedichts Ils me cloueront sur le bois von Jean-Pierre Siméon statt, die von Sprechern vorgetragen und von Cello und Flöte begleitet wird. Ein intensiver Moment zwischen Poesie, Musik und Spiritualität."
    ],
    "en": [
      "Souvigny?s priory church hosts a reading of Jean-Pierre Siméon?s poem Ils me cloueront sur le bois, performed by reciters and accompanied by cello and flute. An intense moment of poetry, music and spirituality."
    ],
    "it": [
      "La chiesa del priorato di Souvigny ospita la lettura del poema di Jean-Pierre Siméon Ils me cloueront sur le bois, interpretato da narratori e accompagnato da violoncello e flauto. Un momento intenso di poesia, musica e spiritualità."
    ],
    "fr": [
      "L’église prieurale de Souvigny accueille une lecture du poème Ils me cloueront sur le bois de Jean-Pierre Siméon, portée par des récitants et accompagnée au violoncelle et à la flûte. Un moment intense entre poésie, musique et spiritualité."
    ],
    "es": [
      "La iglesia prioral de Souvigny acoge la lectura del poema Ils me cloueront sur le bois, de Jean-Pierre Siméon, interpretado por recitadores y acompañado de violonchelo y flauta. Un momento intenso de poesía, música y espiritualidad."
    ],
    "nl": [
      "In de priorij in Souvigny wordt het gedicht Ils me cloueront sur le bois van Jean-Pierre Siméon voorgelezen door vertellers en begeleid door cello en fluit. Een intens moment van poëzie, muziek en spiritualiteit."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Musique et poème"
    ]
  },
