  "rdfs:comment": {
    "de": [
      "Die Laiterie du Mont Aiguille tritt dem Maison Dicina bei!\r\nUnion von Bauern, Züchtern, Käsern und Metzgern durch eine Mission: züchten, verarbeiten und den Geschmack des Guten weitergeben.\r\nTreffen Sie uns am Fuße des Mont Aiguille und genießen Sie die Qualität unserer Produkte."
    ],
    "en": [
      "Laiterie du Mont Aiguille joins Maison Dicina!\r\nA union of farmers, breeders, cheesemakers and butchers with one mission: to raise, transform and pass on the taste for good food.\r\nJoin us at the foot of Mont Aiguille and savour the quality of our products."
    ],
    "it": [
      "La Laiterie du Mont Aiguille si unisce alla Maison Dicina!\r\nUn'unione di agricoltori, allevatori, casari e macellai con un'unica missione: crescere, trasformare e trasmettere il gusto per il buon cibo.\r\nVenite a trovarci ai piedi del Mont Aiguille e assaporate la qualità dei nostri prodotti."
    ],
    "fr": [
      "La Laiterie du Mont Aiguille rejoint la Maison Dicina !\r\nUnion de fermiers, éleveurs, fromagers et bouchers par une mission : élever, transformer et transmettre le goût du bon.\r\nRetrouvez nous au pied du Mont Aiguille et savourez la qualité de nos produits."
    ],
    "es": [
      "¡Laiterie du Mont Aiguille se une a la Maison Dicina!\r\nUna unión de agricultores, ganaderos, queseros y carniceros con una misión: criar, transformar y transmitir el gusto por la buena mesa.\r\nÚnase a nosotros al pie del Mont Aiguille y saboree la calidad de nuestros productos."
    ],
    "nl": [
      "Laiterie du Mont Aiguille sluit zich aan bij Maison Dicina!\r\nEen unie van boeren, kwekers, kaasmakers en slagers met één missie: de smaak voor lekker eten opwekken, transformeren en doorgeven.\r\nOntmoet ons aan de voet van de Mont Aiguille en proef de kwaliteit van onze producten."
    ]
  },
