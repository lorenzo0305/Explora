  "rdfs:comment": {
    "de": [
      "Seit 2005 bietet Ihnen dieses traditionelle Restaurant mit Bergcharme eine hausgemachte, großzügige und raffinierte Küche."
    ],
    "en": [
      "Since 2005, this traditional charming mountain restaurant welcomes you to indulge in our homemade cuisine that’s both sophisticated and generous."
    ],
    "it": [
      "Dal 2005, questo ristorante tradizionale dal tipico fascino montano propone una cucina casereccia, generosa e raffinata."
    ],
    "fr": [
      "Depuis 2005, ce restaurant traditionnel au charme montagnard vous propose une cuisine maison, généreuse et raffinée."
    ],
    "nl": [
      "Sinds 2005 serveert dit traditionele restaurant met zijn charme van de bergen een royale, verfijnde thuiskeuken."
    ],
    "es": [
      "Desde 2005, este restaurante tradicional con encanto de montaña sirve una cocina casera, generosa y refinada."
    ]
  },
