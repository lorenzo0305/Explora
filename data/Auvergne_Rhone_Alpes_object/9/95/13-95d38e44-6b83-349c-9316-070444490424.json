  "rdfs:comment": {
    "de": [
      "Haben Sie Lust auf Nervenkitzel, Leichtigkeit, Ruhe und Zenit?\r\nDann testen Sie das Gleitschirmfliegen!\r\nFliegen Sie vom Gipfel des Saulire und entdecken Sie die 3 Vallées aus der Vogelperspektive."
    ],
    "en": [
      "Meet us at the top of Saulire.\r\nIn ski or snowboard, discover the amazing feelings provided by the free fly.\r\n3 valleys from the sky."
    ],
    "it": [
      "Avete voglia di emozioni, leggerezza, pace e tranquillità?\r\nAllora venite a provare il parapendio!\r\nAlzate i tacchi dalla cima di La Saulire e scoprite le 3 Vallées dall'alto."
    ],
    "fr": [
      "Envie de sensations, de légèreté, de calme et de zénitude ? \r\nAlors venez tester le parapente ! \r\nEnvolez vous du sommet de la Saulire et découvrez les 3 Vallées vue du ciel."
    ],
    "es": [
      "¿Le apetece un poco de emoción, ligereza, paz y tranquilidad?\r\nVen a probar el parapente\r\nSurque los cielos desde la cima de La Saulire y descubra los 3 Vallées desde el aire."
    ],
    "nl": [
      "Zin in spanning, lichtheid, rust en stilte?\r\nKom dan paragliden!\r\nGa de lucht in vanaf de top van La Saulire en ontdek de 3 Vallées vanuit de lucht."
    ]
  },
  "rdfs:label": {
