  "rdfs:comment": {
    "de": [
      "Rêv'Olution ist eine assoziative Galerie. Unsere Aufgabe ist es, die Kreativität von Künstlern, Kunsthandwerkern und Kunsthandwerkerinnen sowie ihr Know-how in der Region Grenoble zu fördern, zu verbreiten, zu unterstützen und bekannt zu machen."
    ],
    "en": [
      "Rêv'Olution is an associative gallery. Our mission is to promote, disseminate, support and publicize the creativity and know-how of artists, artisans and craftspeople in the Grenoble region."
    ],
    "it": [
      "Rêv?Olution è una galleria associativa. La nostra missione è quella di promuovere, diffondere, sostenere e far conoscere la creatività degli artisti, degli artigiani e del loro know-how nella regione di Grenoble."
    ],
    "fr": [
      "Rêv’Olution est une galerie associative. Notre mission est de promouvoir, diffuser, soutenir, et faire connaître la créativité des artistes, artisans, artisans d’art, ainsi que leur savoir-faire, de la région grenobloise."
    ],
    "nl": [
      "Rêv'Olution is een associatieve galerie. Onze missie is het promoten, verspreiden, ondersteunen en bekend maken van de creativiteit van kunstenaars, ambachtslieden en handwerkslieden en hun knowhow in de regio Grenoble."
    ],
    "es": [
      "Rêv'Olution es una galería asociativa. Nuestra misión es promover, difundir, apoyar y dar a conocer la creatividad y el saber hacer de los artistas, artesanos y artesanos de la región de Grenoble."
    ]
  },
  "rdfs:label": {
