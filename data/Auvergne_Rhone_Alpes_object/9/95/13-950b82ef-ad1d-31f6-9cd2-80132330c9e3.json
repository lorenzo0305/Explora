  "rdfs:comment": {
    "de": [
      "Fahren Sie im Herzen des Waldes eine fast 3000 m lange Rodelbahn vom Gipfel des Mont d'Arbois bis zur Zwischenstation Princesse hinunter. Lachen und Spaß sind garantiert!"
    ],
    "en": [
      "Run the nearly 3,000m long toboggan run through the heart of the forest from the summit of Mont d'Arbois to the Princess Station. Laughter and fun guaranteed!"
    ],
    "it": [
      "Nel cuore del bosco, la pista da slittino lunga 3000 metri va dalla cima del Mont d'Arbois alla stazione intermedia Princesse. Risate e divertimento garantiti!"
    ],
    "fr": [
      "Dévalez au cœur de la forêt une piste de luge de près de 3000m de long du sommet du Mont d’Arbois jusqu’à la gare intermédiaire de la Princesse. Rire et amusement garantis !"
    ],
    "nl": [
      "In het hart van het bos, een bijna 3000 meter lange rodelbaan vanaf de top van de Mont d'Arbois naar het tussenstation Princesse. Lachen en plezier gegarandeerd!"
    ],
    "es": [
      "En pleno bosque, una pista de trineo de casi 3000 m de longitud desde la cima del Mont d'Arbois hasta la estación intermedia Princesse. ¡Risas y diversión garantizadas!"
    ]
  },
