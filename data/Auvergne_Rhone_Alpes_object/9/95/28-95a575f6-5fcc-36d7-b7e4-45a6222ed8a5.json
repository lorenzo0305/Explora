  "rdfs:comment": {
    "de": [
      "Die Rohstoffe stammen hauptsächlich aus Frankreich, und die Verzierungen, die ihre Kreationen schmücken, werden ebenfalls von kreativen Handwerkern geliefert."
    ],
    "en": [
      "The raw materials are mainly French, and the accessories that decorate his creations are also supplied by creative craftsmen."
    ],
    "it": [
      "Le materie prime sono principalmente francesi e anche gli accessori utilizzati per decorare le creazioni sono forniti da artigiani creativi."
    ],
    "fr": [
      "La matière 1ère est principalement française, des agréments qui décorent ses créations sont fournis par des artisans créateurs également."
    ],
    "es": [
      "Las materias primas son principalmente francesas, y los accesorios utilizados para decorar las creaciones también proceden de artesanos creativos."
    ],
    "nl": [
