  "rdfs:comment": {
    "de": [
      "Ein geführter Rundgang ermöglicht Ihnen einen Blick hinter die Kulissen der Ausstellung: Aussagen von Künstlern, Erforschung der verwendeten Techniken, historische und pädagogische Dokumente."
    ],
    "en": [
      "A guided tour will give you access to the backstage of the exhibition: testimonies of the artists, exploration of the techniques used, historical and educational documents."
    ],
    "it": [
      "Una visita guidata vi porterà dietro le quinte della mostra: testimonianze degli artisti, esplorazione delle tecniche utilizzate, documenti storici e didattici."
    ],
    "fr": [
      "Une visite guidée vous permettra d’accéder aux coulisses de l’exposition : témoignages des artistes, explorations des techniques employées, documents historiques et pédagogiques."
    ],
    "es": [
      "Una visita guiada le llevará entre los bastidores de la exposición: testimonios de los artistas, exploración de las técnicas utilizadas, documentos históricos y didácticos."
    ],
    "nl": [
      "Een rondleiding neemt u mee achter de schermen van de tentoonstelling: getuigenissen van de kunstenaars, verkenning van de gebruikte technieken, historische en educatieve documenten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite guidée les 1er dimanche du mois au CACL"
    ]
  },
