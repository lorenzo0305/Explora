  "rdfs:comment": {
    "de": [
      "St Priest la Roche wurde auf einem Hügel erbaut und überragt im Südwesten einen der schönsten Orte am Villerest-See, das Château de la Roche, dem die Gemeinde ihre Bekanntheit verdankt."
    ],
    "en": [
      "Built on a hill, St Priest la Roche overlooks one of the most beautiful sites on Lac de Villerest to the south-west, the Château de la Roche, to which the commune owes its fame."
    ],
    "it": [
      "Costruita su una collina, St Priest la Roche domina uno dei siti più belli del lago di Villerest a sud-ovest, il Château de la Roche, a cui la città deve la sua fama."
    ],
    "fr": [
      "Construit sur une colline, St Priest la Roche surplombe au sud-ouest un des plus beaux sites du Lac de Villerest, le Château de la Roche, à qui la commune doit sa notoriété."
    ],
    "nl": [
      "St Priest la Roche is gebouwd op een heuvel en kijkt uit over een van de mooiste plekjes aan het meer van Villerest in het zuidwesten, het Château de la Roche, waaraan de stad zijn faam dankt."
    ],
    "es": [
      "Construida sobre una colina, St Priest la Roche domina al suroeste uno de los lugares más bellos del lago Villerest, el castillo de la Roche, al que la ciudad debe su fama."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Village de Saint-Priest-la-Roche"
    ]
  },
