  "rdfs:comment": {
    "de": [
      "Vor den Toren der Gorges de l'Ardèche: Erkunden Sie den Olivenhain des Domaine des Gorges bei einer geselligen Führung. Entdecken Sie unser Handwerk und verkosten Sie unser biologisches natives Olivenöl extra."
    ],
    "en": [
      "At the gateway to the Gorges de l'Ardèche, explore the Domaine des Gorges olive grove during a friendly guided tour. Discover our expertise and taste our organic extra virgin olive oil."
    ],
    "it": [
      "Alle porte delle Gorges de l'Ardèche, esplorate l'oliveto del Domaine des Gorges durante una visita guidata conviviale. Scoprite il nostro saper fare e degustate il nostro olio extra vergine di oliva biologico."
    ],
    "fr": [
      "Aux portes des Gorges de l’Ardèche, explorez l'oliveraie du Domaine des Gorges lors d’une visite guidée conviviale. Découvrez notre savoir-faire et dégustez notre huile d’olive vierge extra biologique."
    ],
    "nl": [
      "Aan de poort van de Gorges de l'Ardèche, verken de olijfgaard van Domaine des Gorges tijdens een gezellige rondleiding. Ontdek ons vakmanschap en proef onze biologische extra vierge olijfolie."
    ],
    "es": [
      "A las puertas de las Gargantas del Ardèche, descubra el olivar del Domaine des Gorges en una agradable visita guiada. Descubra nuestro saber hacer y deguste nuestro aceite de oliva virgen extra ecológico."
    ]
  },
  "rdfs:label": {
    "de": [
      "Domaine des Gorges - Olivenöl"
