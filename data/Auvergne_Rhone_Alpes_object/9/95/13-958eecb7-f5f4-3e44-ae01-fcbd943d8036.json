  "rdfs:comment": {
    "de": [
      "Bauernhof mit biologischem Gemüseanbau. Gemüse in der Saison. Direktverkauf auf dem Hof freitags nachmittags auf Bestellung, Online-Shop, Markt in Tence, Chambon-sur-Lignon.\r\nAurélien baut Biogemüse der Saison an."
    ],
    "en": [
      "Organic market gardening farm. Seasonal vegetables. Direct sales at the farm on Friday afternoons to order, online store, Tence and Le Chambon-sur-Lignon markets.\r\nAurélien grows seasonal organic vegetables."
    ],
    "it": [
      "Fattoria biologica per l'orticoltura. Ortaggi di stagione. Vendita diretta in fattoria il venerdì pomeriggio su ordinazione, negozio online, mercati di Tence e Le Chambon-sur-Lignon.\r\nAurélien coltiva ortaggi biologici di stagione."
    ],
    "fr": [
      "Ferme en maraîchage Biologique. Légumes de saison. Vente directe à la ferme les vendredis après-midi sur commande, boutique en ligne, marché de Tence, du Chambon-sur-Lignon.\r\nAurélien cultive des légumes bio de saison."
    ],
    "es": [
      "Granja de horticultura ecológica. Verduras de temporada. Venta directa en la granja los viernes por la tarde por encargo, tienda en línea, mercados de Tence y Le Chambon-sur-Lignon.\r\nAurélien cultiva verduras ecológicas de temporada."
    ],
    "nl": [
      "Biologische tuinderij. Seizoensgroenten. Directe verkoop op de boerderij op vrijdagmiddag op bestelling, online winkel, Tence en Le Chambon-sur-Lignon markten.\r\nAurélien teelt biologische seizoensgroenten."
    ]
  },
