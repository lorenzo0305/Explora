  "rdfs:comment": {
    "de": [
      "Dorf der Mobilität ? Die Rotunde\r\nAm Ufer des Allier entdecken Sie unseren Bereich, der der sanften Mobilität gewidmet ist.\r\nEin kompletter Fahrradpark steht Ihnen zur Verfügung, um all Ihren Bedürfnissen gerecht zu werden: AE-Fahrräder, Mountainbikes und Kinderfahrräder."
    ],
    "en": [
      "Mobility Village ? La Rotonde\r\nOn the banks of the Allier, discover our space dedicated to soft mobility.\r\nA full range of bicycles is available to meet all your needs: VTC AE, mountain bikes and children?s bikes."
    ],
    "it": [
      "Villaggio della mobilità? La Rotonde\r\nSulle rive dell'Allier, scoprite il nostro spazio dedicato alla mobilità dolce.\r\nÈ disponibile una gamma completa di biciclette per soddisfare tutte le vostre esigenze: mountain bike AE, mountain bike e biciclette per bambini."
    ],
    "fr": [
      "Village Mobilité – La Rotonde\r\nAu bord de l’Allier, découvrez notre espace dédié à la mobilité douce.\r\nUn parc complet de vélos est à votre disposition pour répondre à tous vos besoins : VTC AE, VTT et vélos enfant."
    ],
    "es": [
      "Mobility Village ? La Rotonde\r\nA orillas del Allier, descubra nuestro espacio dedicado a la movilidad suave.\r\nDisponemos de una completa gama de bicicletas para satisfacer todas sus necesidades: bicicletas de montaña AE, bicicletas de montaña y bicicletas para niños."
    ],
    "nl": [
      "Mobiliteit dorp ? De Rotonde\r\nOntdek aan de oevers van de Allier onze ruimte gewijd aan zachte mobiliteit.\r\nEr is een volledig assortiment fietsen beschikbaar om aan al je behoeften te voldoen: AE mountainbikes, mountainbikes en kinderfietsen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Village Vélo à la Rotonde"
    ]
  },
