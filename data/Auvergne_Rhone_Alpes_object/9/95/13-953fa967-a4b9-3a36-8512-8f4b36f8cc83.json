  "rdfs:comment": {
    "de": [
      "Dieses Tor, das sich zur Rue de la Boucherie hin öffnet, ist das einzige Tor, das von der mittelalterlichen Stadtmauer der Stadt Saint-Gal übrig geblieben ist."
    ],
    "en": [
      "This gateway to the rue de la Boucherie is the only surviving gateway to the medieval walls of the cité Saint-Gal."
    ],
    "it": [
      "Questa porta di rue de la Boucherie è l'unica porta superstite delle mura medievali della città di Saint-Gal."
    ],
    "fr": [
      "Cette porte ouvrant sur la rue de la Boucherie est la seule porte qui subsiste de l'enceinte médiévale de la cité Saint-Gal."
    ],
    "es": [
      "Esta puerta de la calle de la Boucherie es la única que se conserva de las murallas medievales de la ciudad Saint-Gal."
    ],
    "nl": [
      "Deze toegangspoort tot de rue de la Boucherie is de enige overgebleven toegangspoort tot de middeleeuwse muren van de cité Saint-Gal."
    ]
  },
