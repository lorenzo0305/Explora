  "rdfs:comment": {
    "de": [
      "Nehmen Sie an der Schatzsuche in Nyons teil! Entdecken Sie mit Ihrer Familie das historische Zentrum von Nyons und lüften Sie die Geheimnisse der alten Steine! Wenn Sie die verschiedenen Rätsel lösen, gewinnen Sie ein kleines Geschenk!"
    ],
    "en": [
      "Discover the Tresur Hunt  with your family, visit the  history center of Nyons .\r\nIf you answer to the differents puzzles, you will win a little gift!"
    ],
    "it": [
      "Partecipate alla caccia al tesoro di Nyons! Scoprite il centro storico di Nyons in famiglia e scoprite i segreti delle vecchie pietre! Rispondendo ai vari indovinelli, vincerete un distintivo da collezionare!"
    ],
    "fr": [
      "Participez à la chasse aux trésors de Nyons ! Découvrez en famille le centre historique de Nyons, venez percer les secrets des vieilles pierres ! En répondant aux différentes énigmes, vous gagnerez un badge à collectionner !"
    ],
    "es": [
      "¡Participe en la búsqueda del tesoro de Nyons! Descubra en familia el centro histórico de Nyons y descubra los secretos de las viejas piedras Respondiendo a las distintas adivinanzas, ¡ganarás una insignia para coleccionar!"
    ],
    "nl": [
      "Ontdek met de hele familie het historisch stadscentrum met onze schattenjacht !\r\nDoor te antwoorden op enkele vragen, winnen de kinderen een klein kado !"
    ]
  },
  "rdfs:label": {
    "en": [
      "Tresur Hunt in Nyons"
    ],
    "fr": [
      "Jeu de piste : balade ludique pour petits et grands à Nyons"
    ],
    "nl": [
      "Schattenjacht en Nyons"
    ]
  },
