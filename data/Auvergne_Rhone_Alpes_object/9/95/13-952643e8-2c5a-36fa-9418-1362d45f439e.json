  "rdfs:comment": {
    "de": [
      "1500 m2 Kletterfläche für alle Niveaus, mit einer großen Vielfalt an Profilen: vertikal, Platte, Überhang. Jede Woche neue Boulder, sorgfältig ausgewählte neue Griffe und erfahrene Vorsteiger."
    ],
    "en": [
      "1500 m2 of climbing space for all levels, with a wide variety of profiles: vertical, slab, overhang. New boulders every week, carefully selected holds and experienced openers."
    ],
    "it": [
      "1500 m2 di spazio per l'arrampicata per tutti i livelli, con un'ampia varietà di profili: verticali, a placca, a strapiombo. Nuovi massi ogni settimana, prese accuratamente selezionate e apritori esperti."
    ],
    "fr": [
      "1500 m2 d’espace de grimpe pour tous les niveaux, avec une grande variété de profils : vertical, dalle, dévers. De nouveaux blocs toutes les semaines, des prises récentes sélectionnées avec soin et des ouvreurs expérimentés."
    ],
    "nl": [
      "1500 m2 klimruimte voor alle niveaus, met een grote verscheidenheid aan profielen: verticaal, slab, overhang. Elke week nieuwe boulders, zorgvuldig geselecteerde grepen en ervaren openers."
    ],
    "es": [
      "1500 m2 de espacio de escalada para todos los niveles, con una gran variedad de perfiles: vertical, losa, voladizo. Boulders nuevos cada semana, presas cuidadosamente seleccionadas y aperturistas experimentados."
    ]
  },
