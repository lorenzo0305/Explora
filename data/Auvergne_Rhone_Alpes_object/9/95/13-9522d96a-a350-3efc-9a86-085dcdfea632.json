  "rdfs:comment": {
    "de": [
      "Das Iglu empfängt Sie, wenn die Skilifte öffnen, um Sie den ganzen Tag über zu bedienen. In einer außergewöhnlichen Umgebung auf 1600 m Höhe können Sie hier ein Frühstück, eine Mahlzeit oder ein Getränk auf den Pisten genießen."
    ],
    "en": [
      "The Igloo welcomes you from the opening of the ski lifts and serves you throughout the day. Set in an exceptional location at an altitude of 1,600 metres, it’s the perfect place to enjoy breakfast, a meal, or a drink right on the slopes."
    ],
    "it": [
      "L'Igloo vi accoglie all'apertura degli impianti di risalita e vi serve per tutto il giorno. In un ambiente eccezionale a 1600 m di altitudine, potrete gustare la colazione, un pasto o un drink sulle piste."
    ],
    "fr": [
      "L’Igloo vous accueille à l’ouverture des remontées mécaniques pour vous servir tout au long de la journée. Dans un cadre exceptionnel à 1600m d’altitude, pour partager un petit-déjeuner, un repas ou une boisson sur les pistes."
    ],
    "es": [
      "El Iglú le da la bienvenida cuando se abren los remontes y le sirve durante todo el día. En un marco excepcional a 1.600 m de altitud, disfrute de un desayuno, una comida o una copa a pie de pista."
    ],
    "nl": [
      "De Iglo verwelkomt je wanneer de skiliften opengaan en bedient je de hele dag door. In een uitzonderlijke omgeving op 1600 meter hoogte kun je genieten van een ontbijt, een maaltijd of een drankje op de piste."
    ]
  },
  "rdfs:label": {
