  "rdfs:comment": {
    "de": [
      "Ein atypisches Gebäude mit einer grandiosen Innenarchitektur ganz aus Holz und einer einzigartigen ländlichen Dekoration. Hier können Sie mit der Familie, mit Freunden oder in der Gruppe eine traditionelle, hausgemachte Küche genießen."
    ],
    "en": [
      "An atypical building with grandiose wooden interior architecture and a unique country decor, where you can enjoy traditional, home-cooked cuisine with family, friends or groups."
    ],
    "it": [
      "Un edificio atipico con grandiosi interni in legno e un arredamento rustico unico, dove si possono gustare piatti tradizionali fatti in casa con la famiglia, gli amici o i gruppi."
    ],
    "fr": [
      "Un bâtiment atypique avec une architecture intérieure grandiose toute en bois et une décoration campagnarde unique, pour déguster en famille, entre amis ou en groupe une cuisine traditionnelle faite maison."
    ],
    "es": [
      "Un edificio atípico con un grandioso interior de madera y una decoración campestre única, donde podrá disfrutar de comida casera tradicional en familia, con amigos o en grupo."
    ],
    "nl": [
      "Een atypisch gebouw met een grandioos houten interieur en een unieke landelijke inrichting, waar je met familie, vrienden of groepen kunt genieten van traditionele huisgemaakte gerechten."
    ]
  },
