  "rdfs:comment": {
    "de": [
      "Auf dieser abwechslungsreichen Strecke, die manchmal durch Wälder und manchmal über Almen führt, können Sie herrliche Ausblicke auf die umliegenden Bergmassive und insbesondere auf die Aiguille Noire auf der Höhe der Diseurs genießen."
    ],
    "en": [
      "This varied route, sometimes in forest, sometimes in alpine pastures, offers magnificent views of the surrounding massifs, particularly the Aiguille Noire at Les Diseurs."
    ],
    "it": [
      "Questo percorso vario, a volte nella foresta, a volte negli alpeggi, offre magnifiche viste sulle montagne circostanti, in particolare sull'Aiguille Noire a Les Diseurs."
    ],
    "fr": [
      "Ce parcours varié, parfois en forêt, parfois en alpage, vous permettra de profiter de magnifiques points de vue sur les massifs environnants et plus particulièrement sur l'Aiguille Noire, au niveau des Diseurs."
    ],
    "es": [
      "Este recorrido variado, a veces en el bosque, a veces en los pastos de montaña, ofrece magníficas vistas de las montañas circundantes, en particular de la Aiguille Noire en Les Diseurs."
    ],
    "nl": [
      "Deze gevarieerde route, soms in het bos, soms in de bergweiden, biedt prachtige uitzichten op de omliggende bergen, met name de Aiguille Noire bij Les Diseurs."
    ]
  },
  "rdfs:label": {
