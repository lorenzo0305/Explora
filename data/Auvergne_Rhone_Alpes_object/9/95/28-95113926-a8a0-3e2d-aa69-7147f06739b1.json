  "rdfs:comment": {
    "de": [
      "Seit 1974 bietet Hubert Goetgheluck eine Reihe von Antiquitäten, Möbeln, Sitzmöbeln, Schränken, Bibliotheken, Sitzmöbeln, Beleuchtungskörpern, Bildern, Skulpturen und Kunstgegenständen aus dem 17. und 18. Jahrhundert. Es gibt auch einen Trödelmarkt."
    ],
    "en": [
      "Since 1974, Hubert Goetgheluck has been selling a wide range of antiques, furniture, chairs, wardrobes, bookcases, seats, lighting, paintings, sculptures and 17th and 18th century objets d'art. There is also a secondhand goods section."
    ],
    "it": [
      "Dal 1974 Hubert Goetgheluck vende una serie di oggetti d'antiquariato, mobili, sedie, armadi, librerie, sedute, illuminazione, dipinti, sculture e oggetti d'arte del XVII e XVIII secolo. È presente anche una sezione di articoli di seconda mano."
    ],
    "fr": [
      "Depuis 1974, Hubert Goetgheluck propose un éventail d'antiquités, meubles, sièges, armoires, bibliothèques, sièges, luminaires, tableaux, sculptures et objets d'arts XVIIe et XVIIIe siècles. Il existe également une partie brocante."
    ],
    "nl": [
      "Hubert Goetgheluck verkoopt sinds 1974 een assortiment antiek, meubelen, stoelen, kasten, boekenkasten, zetels, verlichting, schilderijen, beeldhouwwerken en 17e en 18e eeuwse objets d'art. Er is ook een afdeling tweedehands goederen."
    ],
    "es": [
      "Desde 1974, Hubert Goetgheluck vende antigüedades, muebles, sillas, armarios, librerías, asientos, iluminación, cuadros, esculturas y objetos de arte de los siglos XVII y XVIII. También hay una sección de artículos de segunda mano."
    ]
  },
