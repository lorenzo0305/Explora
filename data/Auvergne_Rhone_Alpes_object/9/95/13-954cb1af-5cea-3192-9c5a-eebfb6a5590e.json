  "rdfs:comment": {
    "de": [
      "Die GAEC Petit Nice züchtet seit über 30 Jahren Limousin-Kühe und bietet Ihnen Rind- und Kalbfleisch in Paketen oder im Einzelhandel an, das zerlegt und vakuumverpackt ist. Auch Eier von Freilandhühnern. Qualitätsprodukte vom Bauernhof."
    ],
    "en": [
      "Breeders of Limousin cows for over 30 years, GAEC Petit Nice offers beef and veal by the package or retail, cut up and vacuum-packed. Also free-range chicken eggs. Quality farm products."
    ],
    "it": [
      "Allevatore di vacche di razza Limousin da oltre 30 anni, il GAEC Petit Nice offre carni bovine in pacchi o al dettaglio, tagliate e confezionate sotto vuoto. Anche uova di galline allevate all'aperto. Prodotti agricoli di qualità."
    ],
    "fr": [
      "Éleveurs de vaches limousines depuis plus de 30 ans, le GAEC Petit Nice vous propose viande de bœuf et veau en colis ou au détail, découpée et conditionnée sous vide. Également œufs de poules élevées en plein air. Produits fermiers de qualité."
    ],
    "es": [
      "Criadores de vacas Limousin desde hace más de 30 años, GAEC Petit Nice ofrece carne de vacuno en paquetes o al por menor, despiezada y envasada al vacío. También huevos de gallinas camperas. Productos de granja de calidad."
    ],
    "nl": [
      "Al meer dan 30 jaar fokkers van Limousin-koeien, biedt GAEC Petit Nice rund- en kalfsvlees in pakketten of detailhandel, gesneden en vacuüm verpakt. Ook kippeneieren met vrije uitloop. Kwaliteitsproducten van de boerderij."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ferme du Petit Nice"
    ]
  },
