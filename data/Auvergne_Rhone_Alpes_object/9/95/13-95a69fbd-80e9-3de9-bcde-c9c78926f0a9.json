  "rdfs:comment": {
    "de": [
      "Am Eingang von Bellevaux, am Rande des Brevon-Tals, liegt das Hotel Les Moineaux, das sich leidenschaftlich um die Gastfreundschaft und das Wohlbefinden seiner Gäste bemüht."
    ],
    "en": [
      "Hôtel les Moineaux provides wellbeing and relaxaton in Brevon Valley. In winter, get your skis on and glide down Bellevaux's 21 mountains. In summer, swimming and hiking awaits."
    ],
    "it": [
      "All'ingresso di Bellevaux, ai margini della Valle del Brevon, l'Hotel Les Moineaux è dedicato alla convivialità e al benessere dei suoi ospiti."
    ],
    "fr": [
      "A l'entrée de Bellevaux, dans les confins de la Vallée du Brevon, l'hôtel Les Moineaux se passionne à la convivialité et au bien-être de ses hôtes."
    ],
    "nl": [
      "Aan de ingang van Bellevaux, aan de rand van de Brevon-vallei, is Hotel Les Moineaux gewijd aan de gezelligheid en het welzijn van zijn gasten."
    ],
    "es": [
      "A la entrada de Bellevaux, en el borde del Valle de Brevon, el Hotel Les Moineaux se dedica a la convivencia y el bienestar de sus huéspedes."
    ]
  },
