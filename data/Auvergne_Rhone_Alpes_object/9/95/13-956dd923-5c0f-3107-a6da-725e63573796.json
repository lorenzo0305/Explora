  "rdfs:comment": {
    "de": [
      "Erleben Sie die Mad-Jacques 2024 auf dieser sportlichen Radroute. Sie fahren auf der Route des Vins Forez-Roannais en Loire Volcanique entlang der Loire, vorbei an Landschaften am Ufer der Loire und emblematischen Stätten des Kulturerbes"
    ],
    "en": [
      "Relive the Mad-Jacques 2024 by following this cyclo-sport itinerary. You'll follow the Forez-Roannais en Loire Volcanique wine route, following the Loire as it flows through riverside landscapes and emblematic heritage sites"
    ],
    "it": [
      "Rivivete il Mad-Jacques 2024 seguendo questo percorso ciclosportivo. Seguirete la strada del vino Forez-Roannais en Loire Volcanique, seguendo la Loira che scorre tra paesaggi fluviali e siti emblematici del patrimonio"
    ],
    "fr": [
      "Revivez la Mad-Jacques 2024 en suivant cet itinéraire cyclo-sportif. Vous empruntez la Route des Vins Forez-Roannais en Loire Volcanique en suivant la Loire au fil de l'eau au détours de paysages en bord et de Loire et de sites du patrimoine emblématiques"
    ],
    "es": [
      "Reviva el Mad-Jacques 2024 siguiendo esta ruta ciclodeportiva. Recorrerás la ruta del vino Forez-Roannais en Loire Volcanique, siguiendo el Loira a su paso por paisajes ribereños y lugares emblemáticos del patrimonio"
    ],
    "nl": [
      "Beleef de Mad-Jacques 2024 opnieuw door deze cyclo-sportroute te volgen. U volgt de wijnroute Forez-Roannais en Loire Volcanique en volgt de Loire langs rivierlandschappen en emblematisch erfgoed"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Itinéraire cyclo - Mad Jacques Entre Véloire et route des vins"
    ]
  },
