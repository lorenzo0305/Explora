  "rdfs:comment": {
    "de": [
      "Die in der Auvergne einzigartige kurvenreiche Seilrutsche von Mont-Dore wird Ihnen einen einzigartigen Moment bescheren! Halten Sie sich gut fest: 2,5 Minuten Abfahrt sorgen für den ultimativen Nervenkitzel."
    ],
    "en": [
      "Unique in Auvergne, the zip line of Le Mont-Dore will make you live a unique moment! Hold on tight: 2 minutes 30 of descent to fill up with strong sensations."
    ],
    "it": [
      "Unica nel suo genere in Alvernia, la traversata tirolese del Mont-Dore vi farà vivere un momento unico! Tenetevi forte: una discesa di 2,5 minuti per godere al massimo delle emozioni."
    ],
    "fr": [
      "Unique en Auvergne, la tyrolienne à virages du Mont-Dore va vous faire vivre un moment unique ! Accrochez-vous bien : 2 minutes 30 de descente pour faire le plein de sensations fortes."
    ],
    "es": [
      "Única en Auvernia, la tirolina de Mont-Dore le hará vivir un momento único Agárrate fuerte: un descenso de 2,5 minutos para disfrutar al máximo de las emociones."
    ],
    "nl": [
      "Uniek in de Auvergne, de Mont-Dore Tiroolse traverse laat u een uniek moment beleven! Hou je vast: een afdaling van 2,5 minuut voor een spannende rit."
    ]
  },
  "rdfs:label": {
    "de": [
      "Die kurvenreiche Seilrutsche von Mont-Dore"
    ],
    "en": [
      "Le Mont-Dore Tyrolienne with curves"
    ],
    "fr": [
      "La Tyrolienne à virages du Mont-Dore"
    ]
  },
