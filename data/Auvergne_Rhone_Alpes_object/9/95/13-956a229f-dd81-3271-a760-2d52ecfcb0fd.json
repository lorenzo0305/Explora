  "rdfs:comment": {
    "de": [
      "Der Snoot Parc vereint Spiel- und Freizeitaktivitäten für jeden Geschmack und jedes Alter.\r\nKinder können sich auf zwei Hüpfburgen (eine Rutsche und ein Baumhaus) oder auf vier Trampolinen vergnügen, um neue Energie zu tanken."
    ],
    "en": [
      "Snoot Parc offers fun and recreational activities for all tastes and ages.\r\nChildren can have fun on two inflatable structures (a slide and a cabin) or on four trampolines to burn off some energy."
    ],
    "it": [
      "Lo Snoot Parc offre attività ludiche e ricreative per tutti i gusti e tutte le età.\r\nI bambini possono divertirsi su 2 strutture gonfiabili (uno scivolo e una capanna) o su 4 trampolini per fare il pieno di energia."
    ],
    "fr": [
      "Le Snoot Parc réunit des activités ludiques et récréatives pour toutes les envies et tous les âges.\r\nLes enfants peuvent s’amuser sur 2 structures gonflables (un toboggan et une cabane) ou sur 4 trampolines pour faire le plein d’énergie."
    ],
    "es": [
      "Snoot Parc ofrece actividades lúdicas y recreativas para todas las edades y gustos.\r\nLos niños pueden divertirse en 2 estructuras hinchables (un tobogán y una casa en el árbol) o en 4 camas elásticas para recargar las pilas."
    ],
    "nl": [
      "Het Snoot Parc biedt leuke en recreatieve activiteiten voor alle leeftijden en voor elk wat wils.\r\nKinderen kunnen zich uitleven op 2 opblaasbare structuren (een glijbaan en een hut) of op 4 trampolines om hun energie kwijt te raken."
    ]
  },
  "rdfs:label": {
