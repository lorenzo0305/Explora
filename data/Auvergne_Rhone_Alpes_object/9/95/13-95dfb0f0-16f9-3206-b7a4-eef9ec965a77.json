  "rdfs:comment": {
    "de": [
      "Als Töpferin von Steingut in der Landschaft der Drôme arbeite ich in einem von Natur umgebenen Atelier in Upie. Ich entwerfe Stücke für den Tisch und für das Haus, für Privatpersonen und Fachleute, insbesondere für Restaurants."
    ],
    "en": [
      "Potter\r\nWheelthrown stoneware tableware and unique pieces, for homes and restaurants.\r\nWheelthrowing and clay modelling lessons, for beginners or advanced levels."
    ],
    "it": [
      "Ceramista in gres con sede nella campagna della Drôme, lavoro in un laboratorio immerso nella natura, a Upie. Creo pezzi per la tavola e per la casa, per privati e professionisti, in particolare per i ristoranti."
    ],
    "fr": [
      "Potière de grès installée dans la campagne Drômoise, je travaille dans un atelier entouré de nature, à Upie. Je crée des pièces pour la table et pour la maison, pour les particuliers et professionnels, en particulier les restaurants."
    ],
    "es": [
      "Alfarero de gres afincado en la campiña de la Drôme, trabajo en un taller rodeado de naturaleza, en Upie. Creo piezas para la mesa y el hogar, para particulares y profesionales, en particular restaurantes."
    ],
    "nl": [
      "Aardewerk van steengoed\r\nStukken voor tafel en huis, voor particulieren en restaurants.\r\nCursussen in gooien en boetseren, alle niveaus."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Malen Perret - Atelier céramique"
    ]
  },
