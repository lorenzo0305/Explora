  "rdfs:comment": {
    "de": [
      "Die Burg Montségur-sur-Lauzon, die auf einem felsigen Hügel in 185 Metern Höhe die Landschaft dominiert, stammt aus dem Mittelalter (10. Jahrhundert). Es steht isoliert inmitten mehrerer Kilometer Natur und bietet ein echtes Gefühl der Geborgenheit."
    ],
    "en": [
      "Dominating the landscape from the top of a rocky hillside at an altitude of 185 meters, the castle of Montségur-sur-Lauzon dates back to the Middle Ages (10th century). It stands isolated amidst several kilometers of nature, offering a real sense of security."
    ],
    "it": [
      "Dominando il paesaggio dalla cima di una collina rocciosa a 185 metri sul livello del mare, il castello di Montségur-sur-Lauzon risale al Medioevo (X secolo). Si erge isolato in mezzo a diversi chilometri di natura, offrendo un vero senso di sicurezza."
    ],
    "fr": [
      "Dominant le paysage du haut d’un coteau rocheux à 185 mètres d’altitude, le château de Montségur-sur-Lauzon remonte au Moyen Âge (Xe siècle). Il se dresse isolé au milieu de plusieurs kilomètres de nature, offrant une véritable impression de sécurité."
    ],
    "nl": [
      "Het kasteel van Montségur-sur-Lauzon dateert uit de middeleeuwen (10e eeuw) en domineert het landschap vanaf de top van een rotsachtige heuvel op een hoogte van 185 meter. Het ligt afgelegen, te midden van kilometerslange natuur, en biedt een echt gevoel van veiligheid."
    ],
    "es": [
      "Dominando el paisaje desde lo alto de una ladera rocosa a 185 metros sobre el nivel del mar, el castillo de Montségur-sur-Lauzon data de la Edad Media (siglo X). Se alza aislado en medio de varios kilómetros de naturaleza, ofreciendo una auténtica sensación de seguridad."
    ]
  },
