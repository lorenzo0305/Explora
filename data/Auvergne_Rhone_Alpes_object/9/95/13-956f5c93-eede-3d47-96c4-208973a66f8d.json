  "rdfs:comment": {
    "de": [
      "Empfangs- und Informationsstelle für Touristen.\r\n\r\nPostagentur unterscheidet sich von Poststationen (nicht die gleichen Dienstleistungen)\r\n\r\nAusstellungsraum, der Ausstellungen verschiedener Künstler aus dem Vercors und darüber hinaus gewidmet ist"
    ],
    "en": [
      "Reception and tourist information point.\r\n\r\nRelay station.\r\n\r\nShowroom dedicated to the Resistance in Vercors."
    ],
    "it": [
      "Punto di informazione turistica.\r\n\r\nAgenzia postale diversa dall'ufficio postale (non sono gli stessi servizi)\r\n\r\nSala espositiva dedicata alle mostre di vari artisti del Vercors e non solo"
    ],
    "fr": [
      "Point accueil et information touristique.\r\n\r\nAgence postale différent des relais postaux (pas les mêmes services)\r\n\r\nSalle d'exposition dédiée à des expositions de divers artistes du Vercors et d'ailleurs"
    ],
    "nl": [
      "Toeristisch informatiepunt.\r\n\r\nPostagentschap anders dan postkantoor (niet dezelfde diensten)\r\n\r\nTentoonstellingsruimte gewijd aan exposities van verschillende kunstenaars uit de Vercors en elders"
    ],
    "es": [
      "Punto de información turística.\r\n\r\nAgencia postal diferente de la oficina de correos (no son los mismos servicios)\r\n\r\nSala de exposiciones dedicada a exposiciones de diversos artistas del Vercors y de otros lugares"
    ]
  },
