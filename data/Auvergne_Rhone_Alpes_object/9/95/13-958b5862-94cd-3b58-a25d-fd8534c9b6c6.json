  "rdfs:comment": {
    "de": [
      "? Erleben Sie eine einzigartige Gospel-Erfahrung in Aix-les-Bains, am Ufer des Lac du Bourget! Eine Woche, die Musik, Austausch und Tourismus miteinander verbindet, mit Vokalworkshops, amerikanischen Chorsängern und einem Abschlusskonzert für Anfänger oder Fortgeschrittene."
    ],
    "en": [
      "? Enjoy a unique gospel experience in Aix-les-Bains, on the shores of Lac du Bourget! A week combining music, sharing and tourism, with vocal workshops, American choristers and a final concert for beginners or advanced."
    ],
    "it": [
      "? Godetevi un'esperienza gospel unica ad Aix-les-Bains, sulle rive del Lac du Bourget! Una settimana che unisce musica, condivisione e turismo, con laboratori vocali, cantanti americani e un concerto finale per principianti e avanzati."
    ],
    "fr": [
      "✨ Vivez une expérience gospel unique à Aix-les-Bains, au bord du lac du Bourget ! Une semaine mêlant musique, partage et tourisme avec ateliers vocaux, choristes américains, concert final pour débutant ou confirmé."
    ],
    "nl": [
      "? Geniet van een unieke gospelervaring in Aix-les-Bains, aan de oever van het Lac du Bourget! Een week die muziek, uitwisseling en toerisme combineert, met zangworkshops, Amerikaanse zangers en een slotconcert voor beginners en gevorderden."
    ],
    "es": [
      "? Disfrute de una experiencia gospel única en Aix-les-Bains, a orillas del lago Bourget Una semana que combina música, intercambio y turismo, con talleres vocales, cantantes estadounidenses y un concierto final para principiantes y avanzados."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Gospelcation Workshop Gospel"
    ]
  },
