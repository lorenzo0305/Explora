  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Arbeit der Schüler der Theateroption des Lycée Charles Poncet!\r\nAuch in diesem Jahr wird unsere große Truppe von etwa 40 Schülern ihre ganze Energie einsetzen, um Ihnen eine fabelhafte Aufführung zusammenzustellen."
    ],
    "en": [
      "Come and discover the work of the Lycée Charles Poncet's theater option students!\r\nOnce again this year, our large troupe of some forty students will be putting all their energy into putting on a fabulous show for you."
    ],
    "it": [
      "Venite a scoprire il lavoro degli studenti dell'opzione teatro del Liceo Charles Poncet!\r\nAnche quest'anno, la nostra numerosa troupe, composta da una quarantina di studenti, metterà tutta la sua energia per mettere in scena un favoloso spettacolo per voi."
    ],
    "fr": [
      "Venez découvrir le travail des élèves de l’option théâtre du Lycée Charles Poncet !\r\nCette année encore notre grande troupe d’une quarantaine d’élèves va déployer toute son énergie pour vous concocter un fabuleux spectacle."
    ],
    "es": [
      "¡Vengan a descubrir el trabajo de los alumnos de la opción teatro del liceo Charles Poncet!\r\nUn año más, nuestra gran compañía, formada por unos cuarenta alumnos, pondrá toda su energía en la puesta en escena de un fabuloso espectáculo para ti."
    ],
    "nl": [
      "Kom kennismaken met het werk van de leerlingen van de optie drama van het Lycée Charles Poncet!\r\nOok dit jaar zal onze grote groep van ongeveer veertig studenten al hun energie steken in het opvoeren van een fantastische show voor jou."
    ]
  },
  "rdfs:label": {
    "en": [
      "Theater option at Lycée Ch.Poncet"
    ],
    "fr": [
      "Option théâtre du lycée Ch.Poncet"
    ]
  },
