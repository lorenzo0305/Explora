  "rdfs:comment": {
    "de": [
      "Das Tierheim Les Bérauds ist Mitglied der Confédération Nationale Défense de l'Animal.\r\nEs nimmt Hunde und Katzen auf, betreibt ein Tierheim und führt Untersuchungen zu Misshandlungen durch."
    ],
    "en": [
      "The Bérauds shelter is a member of the Confédération Nationale Défense de l'Animal.\r\nIt takes in dogs and cats, operates a pound and investigates mistreatment."
    ],
    "it": [
      "Il rifugio di Bérauds è membro della Confédération Nationale Défense de l'Animal.\r\nAccoglie cani e gatti, gestisce un canile e indaga sui maltrattamenti."
    ],
    "fr": [
      "Le refuge des Bérauds est membre de la Confédération Nationale Défense de l'Animal.\r\nIl recueille des chiens et chats, a une activité de fourrière et fait des enquêtes de maltraitance."
    ],
    "nl": [
      "Het asiel van Bérauds is lid van de Confédération Nationale Défense de l'Animal.\r\nHet vangt honden en katten op, heeft een asiel en onderzoekt mishandeling."
    ],
    "es": [
      "El refugio Bérauds es miembro de la Confédération Nationale Défense de l'Animal.\r\nAcoge a perros y gatos, gestiona una perrera e investiga el maltrato."
    ]
  },
  "rdfs:label": {
