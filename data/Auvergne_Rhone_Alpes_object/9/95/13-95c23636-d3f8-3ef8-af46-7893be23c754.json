  "rdfs:comment": {
    "de": [
      "La Rouge de le fesse ist eine Abfahrt, die von einheimischen Mountainbike-Fans geshapt wird. Hier finden Sie Module, Sprünge und Steilkurven - ein wahres Meisterwerk für Bikepark-Fans. Zögern Sie nicht länger und kommen Sie hierher, um sich auf die Räder zu stellen."
    ],
    "en": [
      "The Rouge de le fesse is a downhill shapely for local mountain bikers. You'll find modules, jumps and banked turns, a real masterpiece for Bike Park enthusiasts. Don't wait any longer and get your wheels on."
    ],
    "it": [
      "La Rouge de le fesse è una discesa adatta agli appassionati di mountain bike locali. Troverete moduli, salti e curve a gomito: un vero capolavoro per gli appassionati di Bike Park. Non aspettate oltre e mettete le ruote."
    ],
    "fr": [
      "La Rouge de le fesse est une descente shapée par les amateurs locaux de VTT. Vous y trouverez modules, sauts et virages relevés, un vrai chef d'œuvre pour les mordus de Bike Park. Ne tardez plus et venez y mettre vos roues."
    ],
    "es": [
      "La Rouge de le fesse es un descenso en forma para los ciclistas de montaña locales. Encontrarás módulos, saltos y curvas peraltadas: una auténtica obra maestra para los aficionados al Bike Park. No esperes más y ponte a rodar."
    ],
    "nl": [
      "De Rouge de le fesse is een downhill voor lokale mountainbikers. Je vindt er modules, sprongen en schuine bochten - een echt meesterwerk voor Bike Park-fans. Wacht niet langer en zet je wielen op."
    ]
  },
  "rdfs:label": {
    "en": [
      "Red buttock"
    ],
    "fr": [
      "Rouge de la fesse"
    ]
  },
