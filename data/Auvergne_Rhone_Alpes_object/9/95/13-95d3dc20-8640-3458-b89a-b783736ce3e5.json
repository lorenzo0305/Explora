  "rdfs:comment": {
    "de": [
      "Die Freunde der Stiftskirche Saint-Barnard und des Kalvarienbergs der Récollets bieten Ihnen den ganzen Sommer über nächtliche Führungen durch die Stiftskirche Saint-Barnard an. Kommen Sie zahlreich, um diese Angebote zu nutzen!"
    ],
    "en": [
      "Les Amis de la Collégiale Saint-Barnard et du Calvaire des Récollets (Friends of the Collegiate Church of Saint-Barnard and the Calvary of the Récollets) are offering night-time guided tours of the Collegiate Church of Saint-Barnard throughout the summer. Come one, come all!"
    ],
    "it": [
      "Gli Amici della Collegiata di Saint-Barnard e del Calvario dei Récollets propongono per tutta l'estate visite guidate notturne alla Collegiata di Saint-Barnard. Venite tutti!"
    ],
    "fr": [
      "Les Amis de la Collégiale Saint-Barnard et du Calvaire des Récollets vous propose des visites guidées nocturnes de la Collégiale Saint-Barnard tout au long de l'été, venez nombreux pour en profiter !"
    ],
    "es": [
      "Los Amigos de la Colegiata de Saint-Barnard y del Calvario de los Récollets proponen durante todo el verano visitas nocturnas guiadas a la Colegiata de Saint-Barnard ¡Vengan todos!"
    ],
    "nl": [
      "De Vrienden van de collegiale kerk Saint-Barnard en de Calvarieberg van de Récollets bieden de hele zomer lang nachtelijke rondleidingen aan in de collegiale kerk Saint-Barnard. Komt allen!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite guidée nocturne : la Collégiale Saint-Barnard"
    ]
  },
