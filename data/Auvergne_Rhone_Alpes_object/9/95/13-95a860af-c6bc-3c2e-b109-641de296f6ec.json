  "rdfs:comment": {
    "de": [
      "Die Auberge du Plat ist eine solidarische Herberge, die von der humanitären Organisation \"ÉquiLibre Solidarité\" gegründet wurde. Sie empfängt Sie in der außergewöhnlichen Umgebung eines authentischen Bauernhofs in den Monts du Lyonnais. Alle Produkte sind überwiegend biologisch und lokal."
    ],
    "en": [
      "L'Auberge du Pla is a solidarity restaurant created by the humanitarian association \"EquiLibre Solidarité\". It welcomes you in the exceptional location of an authentic Monts du Lyonnais farm."
    ],
    "it": [
      "L'Auberge du Plat è un ostello solidale creato dall'associazione umanitaria ÉquiLibre Solidarité. Vi accoglie nella cornice eccezionale di un'autentica fattoria dei Monts du Lyonnais. La maggior parte dei prodotti è biologica e locale."
    ],
    "fr": [
      "L’Auberge du Plat est une auberge solidaire créée par l’association humanitaire « ÉquiLibre Solidarité ». Elle vous accueille dans le site exceptionnel d'une ferme authentique des Monts du Lyonnais. Tous les produits sont majoritairement bios et locaux."
    ],
    "es": [
      "El Auberge du Plat es un albergue solidario creado por la asociación humanitaria ÉquiLibre Solidarité. Le acoge en el marco excepcional de una auténtica granja de los Montes del Lyonnais. La mayoría de los productos son ecológicos y locales."
    ],
    "nl": [
      "De Auberge du Plat is een solidariteitsherberg opgericht door de humanitaire vereniging ÉquiLibre Solidarité. Het verwelkomt je in de uitzonderlijke omgeving van een authentieke boerderij in de Monts du Lyonnais. De meeste producten zijn biologisch en lokaal."
    ]
  },
  "rdfs:label": {
    "en": [
