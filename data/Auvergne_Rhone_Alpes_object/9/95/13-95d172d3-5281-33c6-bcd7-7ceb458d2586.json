  "rdfs:comment": {
    "de": [
      "Die Mühle von Aurouze ist an jedem ersten Samstag im Monat für Besucher geöffnet. Verkauf der Mehlproduktion vor Ort & kleiner Bauernmarkt."
    ],
    "en": [
      "The Moulin d'Aurouze is open to visitors every first Saturday of the month. Flour production sold on site & small farmers' market."
    ],
    "it": [
      "Il Moulin d'Aurouze è aperto ai visitatori ogni primo sabato del mese. La farina viene venduta sul posto e c'è un piccolo mercato agricolo."
    ],
    "fr": [
      "Le Moulin d'Aurouze est ouvert à la visite tous les premiers samedis du mois. Vente de la production de farines sur place & petit marché de producteurs."
    ],
    "es": [
      "El Moulin d'Aurouze está abierto a los visitantes todos los primeros sábados de mes. La harina se vende in situ y hay un pequeño mercado de agricultores."
    ],
    "nl": [
      "De Moulin d'Aurouze is elke eerste zaterdag van de maand open voor bezoekers. Er wordt ter plekke meel verkocht en er is een kleine boerenmarkt."
    ]
  },
