  "rdfs:comment": {
    "de": [
      "Das Fremdenverkehrsamt Sources & volcans empfängt Sie in seinen 3 Büros in den 3 charaktervollen Dörfern. Besuchen Sie unsere Beraterinnen, um mit ihnen Ihren Aufenthalt zur Entdeckung von Jaujac und seiner Umgebung in der Ardèche vorzubereiten."
    ],
    "en": [
      "The Sources & Volcans Tourist Office welcomes you to its 3 offices in the 3 villages of character. Visit our advisors to help you plan your stay and discover Jaujac and the surrounding area in the Ardèche."
    ],
    "it": [
      "L'Ufficio del Turismo Sources & Volcans vi accoglie nei suoi 3 uffici nei 3 villaggi di carattere. Visitate i nostri consulenti per pianificare il vostro soggiorno e scoprire Jaujac e i dintorni dell'Ardèche."
    ],
    "fr": [
      "L'Office de Tourisme Sources & volcans vous reçoit dans ses 3 bureaux dans les 3 villages de caractère. Rendez visite à nos conseillères pour préparer avec elle votre séjour à la découverte de Jaujac et de ses alentours en Ardèche."
    ],
    "es": [
      "La Oficina de Turismo de Sources & Volcans le da la bienvenida en sus 3 oficinas situadas en 3 pueblos con carácter. Visite a nuestros asesores para planificar su estancia y descubrir Jaujac y sus alrededores en Ardèche."
    ],
    "nl": [
      "Het Office du Tourisme des Sources & Volcans heet u welkom in zijn 3 kantoren in de 3 karaktervolle dorpen. Bezoek onze adviseurs om u te helpen uw verblijf te plannen en Jaujac en de omgeving in de Ardèche te ontdekken."
    ]
  },
  "rdfs:label": {
    "de": [
