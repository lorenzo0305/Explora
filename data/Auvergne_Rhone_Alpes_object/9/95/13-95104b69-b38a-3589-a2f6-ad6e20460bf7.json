  "rdfs:comment": {
    "de": [
      "Mickaël Rollet bietet Ihnen seine Produktion in biologischer Landwirtschaft an: Saisongemüse und Lammfleisch in Kisten. Verkauf ab Hof montags und donnerstags von 16.30 bis 19 Uhr und auf dem Markt in Roanne (Place du Marché) dienstags und freitags vormittags."
    ],
    "en": [
      "Mickaël Rollet offers you his organic production: seasonal vegetables and boxed lamb. Sales at the farm on Mondays and Thursdays from 4:30pm to 7pm, and at the Roanne market (Place du Marché) on Tuesday and Friday mornings."
    ],
    "it": [
      "Mickaël Rollet vi offre i prodotti della sua agricoltura biologica: verdure di stagione e agnello in cassetta. Vendita in fattoria il lunedì e il giovedì dalle 16.30 alle 19.00 e al mercato di Roanne (Place du Marché) il martedì e il venerdì mattina."
    ],
    "fr": [
      "Mickaël Rollet vous propose sa production en Agriculture Biologique : légumes de saison et viande d'agneau en caissette. Vente à la ferme le lundi et le jeudi de 16h30 à 19h et sur le marché de Roanne (place du Marché) le mardi et le vendredi matin."
    ],
    "es": [
      "Mickaël Rollet le ofrece sus productos de agricultura ecológica: verduras de temporada y cordero en cajas. Ventas en la granja los lunes y jueves de 16:30 a 19:00 y en el mercado de Roanne (Place du Marché) los martes y viernes por la mañana."
    ],
    "nl": [
      "Mickaël Rollet biedt je zijn biologische landbouwproducten aan: seizoensgroenten en lamsvlees in dozen. Verkoop op de boerderij op maandag en donderdag van 16.30 tot 19.00 uur en op de markt van Roanne (Place du Marché) op dinsdag- en vrijdagochtend."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Mickaël Rollet Maraîcher Bio"
    ]
  },
