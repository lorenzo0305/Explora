  "rdfs:comment": {
    "de": [
      "Der Mountainbike-Airbag ermöglicht es Fahrern und Anfängern, Sprünge mit weicher Landung zu üben. Er ist das ideale Hilfsmittel, um endlich zu lernen, wie man den Backflip wirft!"
    ],
    "en": [
      "The MTB airbag allows riders and beginners to practice jumps with a smooth landing. It is the ideal tool to finally learn how to throw the backflip !"
    ],
    "it": [
      "L'airbag per MTB consente a ciclisti e principianti di esercitarsi nei salti con un atterraggio morbido. È lo strumento ideale per imparare a fare un backflip!"
    ],
    "fr": [
      "L'airbag VTT permet aux riders et aux débutants de s'entrainer sur des sauts avec une réception en douceur. C'est l'outil idéal pour enfin apprendre à lancer le backflip !"
    ],
    "nl": [
      "Met de MTB airbag kunnen rijders en beginners sprongen oefenen met een soepele landing. Het is het ideale hulpmiddel om eindelijk de backflip te leren gooien!"
    ],
    "es": [
      "El airbag MTB permite a los riders y principiantes practicar saltos con un aterrizaje suave. ¡Es la herramienta ideal para aprender a lanzar un backflip!"
    ]
  },
