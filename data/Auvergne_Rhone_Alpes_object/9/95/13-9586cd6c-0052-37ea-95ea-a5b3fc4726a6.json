  "rdfs:comment": {
    "de": [
      "Wellnesszentrum mit Sitz im Stadtzentrum, das eine einzigartige Floating-Leistung anbietet, um sich in einer privaten und beruhigenden Umgebung vollkommen zu entspannen. Floaten Sie in einer warmen Salzwasserlösung und befreien Sie sich von allen äußeren Ablenkungen."
    ],
    "en": [
      "Downtown wellness center offering a unique floating service for total relaxation in a private and soothing environment. Float in a warm salt water solution and free yourself from all external distractions."
    ],
    "it": [
      "Centro benessere in centro città che offre un servizio di galleggiamento unico per un relax totale in un ambiente privato e rilassante. Galleggiate in una soluzione di acqua salata calda e liberatevi da tutte le distrazioni esterne."
    ],
    "fr": [
      "Centre de bien-être basé en centre ville, proposant une prestation flottaison unique, pour une relaxation totale dans un environnement privé et apaisant. Flottez dans une solution d'eau chaude salée et libérez-vous de toutes les distractions externes."
    ],
    "nl": [
      "Wellnesscentrum in het stadscentrum biedt een unieke floatservice voor totale ontspanning in een privé en rustgevende omgeving. Drijf in een warme zoutwateroplossing en bevrijd uzelf van alle externe afleidingen."
    ],
    "es": [
      "Centro de bienestar situado en el centro de la ciudad que ofrece un servicio único de flotación para una relajación total en un entorno privado y relajante. Flote en una solución tibia de agua salada y libérese de todas las distracciones externas."
    ]
  },
  "rdfs:label": {
