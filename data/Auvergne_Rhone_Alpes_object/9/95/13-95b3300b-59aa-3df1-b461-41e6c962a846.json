  "rdfs:comment": {
    "de": [
      "Das Haus sammelt Briefe, Zeichnungen und Fotos, die das tägliche Leben in der Kolonie vom Frühjahr 1943 bis zur Razzia am 6. April 1944 bezeugen. Bei Ihrem Besuch werden Sie von einem Mediator durch die verschiedenen Räume des Hauses geführt."
    ],
    "en": [
      "The house contains letters, drawings and photos that bear witness to daily life in the Colony from the spring of 1943 to the roundup on 6 April 1944. During your visit, you will go through the different rooms of the house guided by a mediator."
    ],
    "it": [
      "La casa contiene lettere, disegni e foto che testimoniano la vita quotidiana nella Colonia dalla primavera del 1943 al rastrellamento del 6 aprile 1944. Durante la visita, si attraverseranno le diverse stanze della casa guidati da un mediatore."
    ],
    "fr": [
      "La maison rassemble les lettres, dessins et photos, témoins de la vie quotidienne à la Colonie du printemps 1943 à la rafle du 6 avril 1944. Lors de votre visite, vous parcourrez les différentes pièces de la maison guidé par un médiateur."
    ],
    "es": [
      "La casa contiene cartas, dibujos y fotos que dan testimonio de la vida cotidiana en la Colonia desde la primavera de 1943 hasta la redada del 6 de abril de 1944. Durante su visita, recorrerá las diferentes estancias de la casa guiado por un mediador."
    ],
    "nl": [
      "Het huis bevat brieven, tekeningen en foto's die getuigen van het dagelijks leven in de kolonie vanaf het voorjaar van 1943 tot de razzia op 6 april 1944. Tijdens uw bezoek doorloopt u de verschillende kamers van het huis onder leiding van een bemiddelaar."
    ]
  },
  "rdfs:label": {
    "en": [
      "Guided tours of the Maison d'Izieu"
    ],
    "fr": [
      "Visites guidées de la Maison d'Izieu"
    ]
  },
