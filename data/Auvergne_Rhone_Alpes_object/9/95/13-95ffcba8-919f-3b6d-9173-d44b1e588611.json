  "rdfs:comment": {
    "de": [
      "Der größte Paintball-Park in der Ardèche, ab 9 Jahren.\r\nKommen Sie und spielen Sie auf angelegten und schattigen Feldern inmitten der Natur."
    ],
    "en": [
      "The largest paintball park in the Ardèche, from age 9.\r\nCome and play on shaded, landscaped fields in the heart of nature."
    ],
    "it": [
      "Il più grande parco di paintball dell'Ardèche, a partire dai 9 anni.\r\nVenite a giocare su campi ombreggiati e paesaggistici nel cuore della natura."
    ],
    "fr": [
      "Le plus grand parc de Paintball en Ardèche, dès 9 ans.\r\nVenez jouez sur des terrains en pleine nature, aménagé et ombragé."
    ],
    "nl": [
      "Het grootste paintballpark in de Ardèche, vanaf 9 jaar.\r\nKom spelen op schaduwrijke, aangelegde velden midden in de natuur."
    ],
    "es": [
      "El mayor parque de paintball de Ardèche, a partir de 9 años.\r\nVen a jugar en campos sombreados y ajardinados en plena naturaleza."
    ]
  },
