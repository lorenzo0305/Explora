  "rdfs:comment": {
    "de": [
      "Nell ist Ihr Cani-Wanderführer, der sich dem Abenteuer in der Natur verschrieben hat.\r\nEntdecken Sie in ihrer Begleitung einzigartige Landschaften und erleben Sie unvergessliche Erlebnisse mit Ihrem Hund!"
    ],
    "en": [
      "Nell is your canine trekking guide dedicated to wilderness adventure.\r\nIn her company, discover unique landscapes and enjoy unforgettable experiences with your dog!"
    ],
    "it": [
      "Nell è la vostra guida canina per il trekking, dedicata all'avventura all'aria aperta.\r\nIn sua compagnia, scoprite paesaggi unici e vivete esperienze indimenticabili con il vostro cane!"
    ],
    "fr": [
      "Nell est votre guide de cani-randonnée dédié à l'aventure en pleine nature.\r\nEn sa compagnie, découvrez des paysages uniques et vivez des expériences inoubliables avec votre chien !"
    ],
    "nl": [
      "Nell is je hondentrekgids, toegewijd aan avontuur in de vrije natuur.\r\nOntdek in haar gezelschap unieke landschappen en geniet van onvergetelijke ervaringen met je hond!"
    ],
    "es": [
      "Nell es tu guía canina de trekking, dedicada a la aventura en plena naturaleza.\r\nEn su compañía, descubra paisajes únicos y disfrute de experiencias inolvidables con su perro"
    ]
  },
  "rdfs:label": {
