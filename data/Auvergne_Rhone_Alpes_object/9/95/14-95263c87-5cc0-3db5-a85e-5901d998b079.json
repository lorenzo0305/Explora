  "rdfs:comment": {
    "de": [
      "Die Aufführung findet im Rahmen des Festivals Qu'est-ce-qu'on fabrique en famille? #12.\nEin Eintauchen in die Falten und Faltungen des Papiers... Tauchen Sie ein in Strukturen aus Papier, die ebenso spektakulär wie einladend sind."
    ],
    "en": [
      "Programmed as part of the Festival Qu'est-ce-qu'on fabrique en famille? #12.\nA plunge into the folds and folds of paper... Immerse yourself in paper structures as spectacular as they are inviting."
    ],
    "it": [
      "Parte del Festival Qu'est-ce-qu'on fabrique en famille? #12.\nUn tuffo nelle pieghe della carta... Immergetevi in strutture di carta tanto spettacolari quanto invitanti."
    ],
    "fr": [
      "Spectacle programmé dans le cadre du Festival Qu'est-ce-qu'on fabrique en famille ? #12.\nUne plongée dans les plis et déplis du papier... Immergez-vous dans des structures de papier, aussi spectaculaires qu'accueillantes."
    ],
    "es": [
      "Parte del Festival Qu'est-ce-qu'on fabrique en famille? #12.\nUna inmersión en los pliegues y repliegues del papel... Sumérjase en estructuras de papel tan espectaculares como sugerentes."
    ],
    "nl": [
      "Onderdeel van het Festival Qu'est-ce-qu'on fabrique en famille? #12.\nEen duik in de vouwen en plooien van papier... Dompel je onder in papierstructuren die even spectaculair als uitnodigend zijn."
    ]
  },
  "rdfs:label": {
    "fr": [
