  "rdfs:comment": {
    "de": [
      "Begleiten Sie uns zu einem einzigartigen Moment rund um das Violoncello. Lassen Sie sich in einer warmen und intimen Atmosphäre von einem Programm mitreißen, das den ganzen Reichtum und die Tiefe dieses Instruments hervorhebt."
    ],
    "en": [
      "Join us for a unique cello experience. In a warm and intimate atmosphere, let yourself be transported by a program that highlights the richness and depth of this instrument."
    ],
    "it": [
      "Unitevi a noi per un'esperienza unica con il violoncello. In un'atmosfera calda e intima, lasciatevi trasportare da un programma che mette in luce la ricchezza e la profondità di questo strumento."
    ],
    "fr": [
      "Rejoignez-nous pour un moment unique autour du violoncelle. Dans une ambiance chaleureuse et intimiste, laissez-vous transporter par un programme qui met en valeur toute la richesse et la profondeur de cet instrument."
    ],
    "es": [
      "Únase a nosotros para vivir una experiencia única con el violonchelo. En un ambiente cálido e íntimo, déjese transportar por un programa que pone de relieve la riqueza y la profundidad de este instrumento."
    ],
    "nl": [
      "Doe met ons mee voor een unieke cello-ervaring. Laat je in een warme en intieme sfeer meevoeren door een programma dat de rijkdom en diepgang van dit instrument benadrukt."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Concert de l'Orchestre de violoncelles Vercheznous"
    ]
  },
