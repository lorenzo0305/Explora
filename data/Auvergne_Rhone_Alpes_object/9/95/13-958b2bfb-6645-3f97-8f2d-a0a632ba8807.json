  "rdfs:comment": {
    "de": [
      "Hochseilgarten in Ébreuil am Ufer der Sioule.  Sechs Parcours für Kinder ab 2,5 Jahren bis 12/13 Jahren. Seilrutsche, die über den Fluss führt."
    ],
    "en": [
      "Tree-climbing park at Ébreuil on the banks of the Sioule.\r\nSix courses for children aged 2 1/2 to 12/13."
    ],
    "it": [
      "Parco di arrampicata sugli alberi a Ébreuil, sulle rive della Sioule.  Sei percorsi per bambini dai 2 anni e mezzo ai 12/13 anni. Traversata tirolese attraverso il fiume."
    ],
    "fr": [
      "Parc accrobranche à Ébreuil en bord de Sioule.  Six parcours pour les enfants dès 2 ans et demi et jusqu'à 12/13 ans. Tyrolienne qui traverse la rivière."
    ],
    "es": [
      "Parque de escalada en Ébreuil, a orillas del Sioule.  Seis recorridos para niños de 2 años y medio a 12/13 años. Tirolina a través del río."
    ],
    "nl": [
      "Boomklimpark in Ébreuil aan de oever van de Sioule.  Zes parcours voor kinderen van 2,5 tot 12/13 jaar. Tiroolse oversteek over de rivier."
    ]
  },
