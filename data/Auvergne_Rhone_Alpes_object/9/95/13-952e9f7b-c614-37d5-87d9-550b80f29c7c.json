  "rdfs:comment": {
    "de": [
      "Chee is Thaï bietet Ihnen im Zentrum von Lyon eine authentische thailändische Küche mit einem Mittagsbuffet unter der Woche und Menüs und à la carte am Abend und am Samstag."
    ],
    "en": [
      "Located in the centre of Lyon, Chee is Thaï serves up authentic Thai cuisine, with a lunch buffet during the week and à la carte and set menus during the evenings and on Saturdays."
    ],
    "it": [
      "Chee is Thaï offre un'autentica cucina tailandese nel centro di Lione con un pranzo a buffet durante la settimana e menù à la carte la sera e il sabato."
    ],
    "fr": [
      "Chee is Thaï vous propose au centre de Lyon une cuisine thaïe authentique avec un buffet le midi en semaine et des menus et à la carte le soir et le samedi."
    ],
    "es": [
      "Chee is Thaï ofrece auténtica cocina tailandesa en el centro de Lyon, con un almuerzo buffet durante la semana y menús a la carta por la noche y los sábados."
    ],
    "nl": [
      "Chee is Thaï biedt authentieke Thaise gerechten in het centrum van Lyon met een lunchbuffet tijdens de week en à la carte menu's 's avonds en op zaterdag."
    ]
  },
