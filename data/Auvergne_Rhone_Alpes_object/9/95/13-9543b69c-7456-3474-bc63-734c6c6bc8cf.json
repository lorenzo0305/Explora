  "rdfs:comment": {
    "de": [
      "Stürzen Sie sich in das Abenteuer! Eine Zeitreise mit der Familie oder mit Freunden, um die unterirdische Welt zu entdecken. Tauchen Sie ein in die Vorgeschichte und lernen Sie die Handgriffe unserer Vorfahren kennen!"
    ],
    "en": [
      "Enter the adventure! Take a trip back in time with family and friends to discover the underground world. Immerse yourself in prehistory and learn how our ancestors did it!"
    ],
    "it": [
      "Entrate nell'avventura! Un viaggio nel tempo con la famiglia o gli amici alla scoperta del mondo sotterraneo. Immergetevi nella preistoria e imparate a conoscere le abilità dei nostri antenati!"
    ],
    "fr": [
      "Entrez dans l'aventure ! Un voyage dans le temps en famille ou entre amis à la découverte du monde souterrain. Plongez dans la Préhistoire et initiez-vous aux gestes de nos ancêtres !"
    ],
    "es": [
      "¡Aventúrate! Un viaje en el tiempo con tu familia o amigos para descubrir el mundo subterráneo. Sumérjase en la prehistoria y conozca las habilidades de nuestros antepasados"
    ],
    "nl": [
      "Ga het avontuur aan! Een reis door de tijd met je familie of vrienden om de ondergrondse wereld te ontdekken. Dompel je onder in de prehistorie en leer over de vaardigheden van onze voorouders!"
    ]
  },
  "rdfs:label": {
    "de": [
      "Grotten von Cerdon - Prähistorischer Freizeitpark"
    ],
    "en": [
      "Grottes du Cerdon - Prehistoric Leisure Park"
    ],
    "fr": [
      "Grottes du Cerdon – Parc de Loisirs Préhistoriques"
    ]
  },
