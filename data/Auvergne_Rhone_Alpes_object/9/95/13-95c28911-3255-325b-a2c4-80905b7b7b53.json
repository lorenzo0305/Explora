  "rdfs:comment": {
    "de": [
      "Die Kirsche auf dem Kaffee ist eine Kaffeerösterei / Teestube, in der Sie einen schönen Verkostungsraum für heiße oder kalte Getränke, im Sommer Eis sowie hausgemachtes Gebäck vorfinden. Im Großhandel finden Sie Tee, Kaffee und Zubehör."
    ],
    "en": [
      "La cerise sur le café is a roastery/tea room where you'll find a beautiful tasting area for hot or cold drinks, ice cream in summer and home-made cookies. Bulk sales of tea, coffee and accessories."
    ],
    "it": [
      "La ciliegina sul caffè è una torrefazione/sala da tè dove troverete una bella area di degustazione per bevande calde o fredde, gelati in estate e biscotti fatti in casa. Troverete anche tè, caffè e accessori in vendita all'ingrosso."
    ],
    "fr": [
      "La cerise sur le café est une torréfaction / salon de thé où vous trouverez un bel espace de dégustation pour boissons chaudes ou fraîches, des glaces l'été ainsi que de la biscuiterie maison. En vente en vrac vous trouverez thé, café et accessoires."
    ],
    "es": [
      "La guinda del café es una tostaduría/sala de té donde encontrará una encantadora zona de degustación de bebidas frías o calientes, helados en verano y galletas caseras. También encontrará té, café y accesorios a la venta a granel."
    ],
    "nl": [
      "De kers op de koffie is een branderij/theeruimte waar je een heerlijke proefruimte vindt voor warme of koude dranken, ijs in de zomer en zelfgemaakte koekjes. Je vindt er ook thee, koffie en accessoires die in bulk te koop zijn."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La cerise sur le café"
    ]
  },
