  "rdfs:comment": {
    "de": [
      "Der Marathon du Mont-Blanc ist ein Sportereignis, bei dem 8 Trailruns mit 10 000 Läufern drei Tage lang im Tal von Chamonix-Mont-Blanc stattfinden."
    ],
    "en": [
      "The Mont-Blanc Marathon is a sporting event bringing together 8 trail races involving 10,000 runners over 3 days in the Chamonix-Mont-Blanc valley."
    ],
    "it": [
      "La Maratona del Monte Bianco è un evento sportivo che riunisce 8 gare di trail che coinvolgono 10.000 corridori per 3 giorni nella Valle di Chamonix-Mont-Blanc."
    ],
    "fr": [
      "Le Marathon du Mont-Blanc, est un événement sportif rassemblant 8 courses de trail auxquelles participent 10 000 coureurs pendant 3 jours dans la Vallée de Chamonix-Mont-Blanc."
    ],
    "es": [
      "El Maratón del Mont-Blanc es un acontecimiento deportivo que reúne 8 carreras de trail en las que participan 10.000 corredores a lo largo de 3 días en el valle de Chamonix-Mont-Blanc."
    ],
    "nl": [
      "De Mont-Blanc Marathon is een sportevenement dat 8 trailwedstrijden met 10.000 lopers over 3 dagen in de vallei van Chamonix-Mont-Blanc samenbrengt."
