  "rdfs:comment": {
    "de": [
      "Im Herzen von Moulins erwartet Sie eine angenehme gastronomische Etappe in einem Hotel-Restaurant Logis de France, wo Ihnen der beste Empfang bereitet wird.\r\nRaffinierte regionale Küche, traditionelle Küche mit persönlicher Note und Kreativität."
    ],
    "en": [
      "In the heart of Moulins, a pleasant gastronomic stopover in a Logis de France hotel-restaurant where the best welcome is reserved for you.\r\nRefined local cuisine, traditional, personalized and creative cuisine."
    ],
    "it": [
      "Nel cuore di Moulins, una piacevole sosta gastronomica in un hotel-ristorante Logis de France dove vi è riservata la migliore accoglienza.\r\nCucina locale raffinata, cucina tradizionale personalizzata e creativa."
    ],
    "fr": [
      "Au cœur de Moulins, une agréable étape gastronomique dans un hôtel-restaurant Logis de France où le meilleur accueil vous est réservé.\r\nCuisine de terroir raffinée, cuisine de tradition personnalisée et créative."
    ],
    "nl": [
      "In het hart van Moulins, een aangename gastronomische tussenstop in een Logis de France hotel-restaurant waar de beste ontvangst voor u is gereserveerd.\r\nVerfijnde lokale keuken, gepersonaliseerde en creatieve traditionele keuken."
    ],
    "es": [
      "En el corazón de Moulins, una agradable parada gastronómica en un hotel-restaurante Logis de France donde se le reserva la mejor acogida.\r\nCocina local refinada, cocina tradicional personalizada y creativa."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Parc"
    ]
  },
