  "rdfs:comment": {
    "de": [
      "Der Druise-Wasserfall, ein beeindruckender Wasserfall mit einer Höhe von 72 Metern, ist zweifellos einer der schönsten im Vercors.\r\nDieses empfindliche Gebiet befindet sich auf einem Privatgrundstück. Beachten Sie die Hinweise."
    ],
    "en": [
      "The waterfall of the Druise, an impressive 72 meter high waterfall, is without a doubt one of the most beautiful waterfalls in Vercors."
    ],
    "it": [
      "La cascata della Druise, alta ben 72 metri, è senza dubbio una delle più belle del Vercors.\r\nQuest'area fragile si trova in una proprietà privata. Assicuratevi di seguire la segnaletica."
    ],
    "fr": [
      "La chute de la Druise, cascade impressionnante de 72 mètres de hauteur, est sans aucun doute une des plus belles du Vercors.\r\nCette zone fragile est située sur une propriété privée. Respectez bien les indications."
    ],
    "es": [
      "La cascada de Druise, con sus impresionantes 72 metros de altura, es sin duda una de las más bellas del Vercors.\r\nEsta frágil zona se encuentra en una propiedad privada. Asegúrese de seguir las señales."
    ],
    "nl": [
      "De Druise waterval, een indrukwekkende 72 meter hoog, is ongetwijfeld een van de mooiste in de Vercors.\r\nDit kwetsbare gebied ligt op privéterrein. Zorg ervoor dat je de borden volgt."
    ]
  },
