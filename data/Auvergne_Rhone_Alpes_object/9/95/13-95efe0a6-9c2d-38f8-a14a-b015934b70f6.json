  "rdfs:comment": {
    "de": [
      "Der Lebensmittelladen „The Perched“ in Haut Livron – klein, aber oho! Entdecken Sie diesen Genossenschaftsladen und sein Café – das „Perched Café“ – mit seiner herrlichen Lage über dem Drôme-Tal und der Rhône-Ebene."
    ],
    "en": [
      "The Perched Grocery Store of Haut Livron – very small but richly diversified! Come and discover this cooperative store and its café - the Perched Café - with its magnificent setting overlooking the Drôme Valley and the Rhône plain."
    ],
    "it": [
      "L'Epicerie Perchée du Haut Livron? piccolissima ma riccamente diversificata! Venite a scoprire questo negozio di comunità e il suo caffè - il Café Perché - con la sua magnifica cornice che domina la Valle della Drôme e la pianura del Rodano."
    ],
    "fr": [
      "L'Epicerie Perchée du Haut Livron – toute petite mais richement diversifiée ! Venez découvrir ce magasin associatif et son café - le Café Perché - avec son environnement magnifique surplombant la Vallée de la Drôme et la plaine du Rhône."
    ],
    "es": [
      "L'Epicerie Perchée du Haut Livron... ¡muy pequeña pero ricamente diversificada! Venga a descubrir esta tienda de barrio y su cafetería, el Café Perché, con su magnífico marco que domina el valle del Drôme y la llanura del Ródano."
    ],
    "nl": [
      "De Perched kruidenierswinkel van Haut Livron – klein maar rijk aan variatie! Kom deze coöperatieve winkel en het bijbehorende café – het Perched Café – ontdekken, met zijn prachtige ligging en uitzicht over de Drômevallei en de Rhônevlakte."
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'Epicerie Perchée et son Café"
    ]
  },
