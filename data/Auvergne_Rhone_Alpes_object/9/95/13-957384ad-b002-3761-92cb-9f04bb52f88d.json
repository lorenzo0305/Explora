  "rdfs:comment": {
    "de": [
      "Probieren Sie sich in der Keramikmalerei (1-2 Stunden) und wählen Sie das Fayence-Stück aus, das Sie dekorieren möchten. Frist von einer Woche, bevor Sie Ihr gebranntes Stück abholen."
    ],
    "en": [
      "Come and try your hand at ceramic painting (1 to 2 hours), choosing the piece of earthenware you wish to decorate. Please allow one week for delivery."
    ],
    "it": [
      "Venite a cimentarvi nella pittura su ceramica (da 1 a 2 ore) scegliendo il pezzo di terracotta che desiderate decorare. Il tempo di attesa per il ritiro del pezzo è di una settimana."
    ],
    "fr": [
      "Venez vous essayer à la peinture sur céramique (1 à 2h) en choisissant la pièce de faïence que vous désirez décorer. Délai d'une semaine avant de récupérer votre pièce cuite."
    ],
    "es": [
      "Venga y pruebe a pintar cerámica (de 1 a 2 horas) eligiendo la pieza de barro que desee decorar. La pieza estará lista para su recogida en una semana."
    ],
    "nl": [
      "Kom keramiek schilderen (1 tot 2 uur) en kies een stuk aardewerk dat je wilt versieren. Het duurt een week voordat je werkstuk klaar is om opgehaald te worden."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Décore ta poterie"
    ]
  },
