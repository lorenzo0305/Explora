  "rdfs:comment": {
    "de": [
      "Armelle und Marion freuen sich, Sie in dieser neuen Einrichtung begrüßen zu dürfen, die zur Belebung der Gemeinde und zur Förderung der Kultur für möglichst viele Menschen beitragen wird."
    ],
    "en": [
      "Armelle and Marion will be happy to welcome you in this new facility which will contribute to animate the Commune and to promote culture to the greatest number."
    ],
    "it": [
      "Armelle e Marion saranno liete di accogliervi in questa nuova struttura che contribuirà ad animare il Comune e a promuovere la cultura presso il maggior numero di persone possibile."
    ],
    "fr": [
      "Armelle et Marion seront heureuses de vous accueillir dans ce nouvel équipement qui contribuera à animer la Commune et à promouvoir la culture au plus grand nombre."
    ],
    "es": [
      "Armelle y Marion estarán encantadas de recibirle en esta nueva instalación que contribuirá a animar la Comuna y a promover la cultura entre el mayor número de personas posible."
    ],
    "nl": [
      "Armelle en Marion heten u van harte welkom in deze nieuwe voorziening die de gemeente zal helpen animeren en de cultuur bij zoveel mogelijk mensen zal promoten."
    ]
  },
