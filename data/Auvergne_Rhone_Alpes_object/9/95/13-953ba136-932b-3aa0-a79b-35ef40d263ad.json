  "rdfs:comment": {
    "de": [
      "Genießen Sie köstliche Kebabs, knusprige Tacos und großzügige Teller, die so zubereitet werden, dass sie all Ihren Wünschen entsprechen. Kommen Sie schnell und genießen Sie ein leckeres und geselliges Essen, zu jeder Tageszeit in Thoissey!"
    ],
    "en": [
      "Come and enjoy a good kebab in Thoissey!"
    ],
    "it": [
      "Gustate deliziosi kebab, croccanti tacos e piatti abbondanti, preparati per soddisfare ogni gusto. Venite a gustare un pasto delizioso e conviviale, in qualsiasi momento a Thoissey!"
    ],
    "fr": [
      "Savourez de délicieux kebabs, tacos croustillants, et assiettes généreuses, préparés pour satisfaire toutes vos envies. Venez vite profiter d’un repas gourmand et convivial, à toute heure à Thoissey !"
    ],
    "nl": [
      "Geniet van heerlijke kebabs, knapperige taco's en royale borden, bereid om elke smaak te bevredigen. Kom genieten van een heerlijke en gezellige maaltijd, op elk moment in Thoissey!"
    ],
    "es": [
      "Disfrute de deliciosos kebabs, crujientes tacos y generosos platos, preparados para satisfacer todos los gustos. Venga a disfrutar de una comida deliciosa y cordial, ¡a cualquier hora en Thoissey!"
    ]
  },
  "rdfs:label": {
    "en": [
      "Melis Kebab"
    ],
    "fr": [
      "Melis Kebab"
    ]
  },
