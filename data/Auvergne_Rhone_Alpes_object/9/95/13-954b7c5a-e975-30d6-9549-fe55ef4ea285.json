  "rdfs:comment": {
    "de": [
      "Messerschmied, der DAS Uissan-Messer herstellt, & Besteck aller Marken (nur französische und europäische). Verkauf von Produkten für den gedeckten Tisch, Dekoartikel und Kleinlederwaren. Schlüsselservice und Gravur."
    ],
    "en": [
      "Artisan cutler who makes THE uissan knife, & cutlery for all brands (French and European only). Sale of products dedicated to the art of the table, decoration, small leather goods. Minute key service and engraving."
    ],
    "it": [
      "Coltellinaio artigiano che realizza IL coltello uissan e posate per tutte le marche (solo francesi ed europee). Vendita di prodotti dedicati all'arte della tavola, alla decorazione, alla piccola pelletteria. Servizio di duplicazione e incisione di chiavi."
    ],
    "fr": [
      "Artisan coutelier qui façonne LE couteau uissan, & coutellerie toutes marques (Française et européenne uniquement). Vente de produits dédiés à l'art de la table, déco, petite maroquinerie. Service de clés minute et gravure."
    ],
    "es": [
      "Cuchillero artesano que fabrica la navaja uissan, y la cubertería de todas las marcas (sólo francesa y europea). Venta de productos dedicados al arte de la mesa, decoración, pequeña marroquinería. Servicio de corte y grabado de llaves."
    ],
    "nl": [
      "Ambachtelijke messenmaker die HET uissan mes maakt, & bestek voor alle merken (alleen Franse en Europese). Verkoop van serviesgoed, decoratieve artikelen en kleine lederwaren. Minuut sleutelservice en graveren."
    ]
  },
  "rdfs:label": {
    "fr": [
      "L' Atelier Uissan 800"
    ]
  },
