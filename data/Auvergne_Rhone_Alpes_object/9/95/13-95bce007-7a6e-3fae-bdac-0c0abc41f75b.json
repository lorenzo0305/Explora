  "rdfs:comment": {
    "de": [
      "Claudio Capéo ist ein mehrfach ausgezeichneter Künstler und Rekordhalter mit über 1,5 Millionen verkauften Alben. Er ist einer der beliebtesten Künstler der französischen Szene der 2020er Jahre."
    ],
    "en": [
      "Multi-award-winning artist and record-breaker with over one and a half million albums sold, Claudio Capéo is one of the most popular artists on the French scene in the 2020s."
    ],
    "it": [
      "Pluripremiato e detentore di record con oltre un milione e mezzo di album venduti, Claudio Capéo è uno degli artisti più popolari della scena francese degli anni 2020."
    ],
    "fr": [
      "Artiste multi-récompensé et recordman des ventes de disques avec plus d’un million et demi d’albums vendus, Claudio Capéo est l’un des artistes les plus plébiscités de la scène française des années 2020."
    ],
    "nl": [
      "Claudio Capéo is een meermaals bekroonde artiest en recordbreker met meer dan anderhalf miljoen verkochte albums. Hij is een van de populairste artiesten van de Franse scene in de jaren 2020."
    ],
    "es": [
      "Artista multipremiado y batidor de récords con más de un millón y medio de álbumes vendidos, Claudio Capéo es uno de los artistas más populares de la escena francesa en la década de 2020."
    ]
  },
  "rdfs:label": {
