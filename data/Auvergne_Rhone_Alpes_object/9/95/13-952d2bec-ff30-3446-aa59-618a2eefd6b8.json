  "rdfs:comment": {
    "de": [
      "Bewegen Sie sich mithilfe Ihrer Karte durch diesen unbekannten Teil des Naturparks Vercors, um das Natur- und Kulturerbe von Château-Bernard zu entdecken."
    ],
    "en": [
      "Use your map to explore this little-known part of the Vercors Natural Park and discover Château-Bernard's natural and cultural heritage."
    ],
    "it": [
      "Con l'aiuto della vostra mappa, muovetevi in questa parte poco conosciuta del Parco Naturale del Vercors per scoprire il patrimonio naturale e culturale di Château-Bernard."
    ],
    "fr": [
      "A l'aide de votre carte, déplacez-vous dans cette partie méconnue du Parc Naturel du Vercors pour découvrir le patrimoine naturel et culturel de Château-Bernard."
    ],
    "nl": [
      "Trek met behulp van uw kaart door dit weinig bekende deel van het Natuurpark van de Vercors om het natuurlijke en culturele erfgoed van Château-Bernard te ontdekken."
    ],
    "es": [
      "Con la ayuda de su mapa, muévase por esta parte poco conocida del Parque Natural de Vercors para descubrir el patrimonio natural y cultural de Château-Bernard."
    ]
  },
  "rdfs:label": {
