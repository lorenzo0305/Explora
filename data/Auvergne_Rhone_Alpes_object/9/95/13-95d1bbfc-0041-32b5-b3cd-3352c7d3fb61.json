  "rdfs:comment": {
    "de": [
      "12 Bahnen für Turniere, Billard, Airhockey, Virtuelle Realität usw. Bar, Restaurant mit 2 Terrassen, Bühne und Multifunktionssaal. Konzertabende und Karaoke."
    ],
    "en": [
      "We have 12 tournament-approved bowling lanes, multiple pool tables, a full arcade complete with retro video games, air hockey tables, pinball machines & more, a full bar with a large selection of drinks, restaurant, a large outdoor terrace with a desert zen garden, concert stage, conference room for all of your professional needs."
    ],
    "it": [
      "Centro in stile californiano decorato con rock'n'roll, arte moderna, UFO e auto d'epoca.\r\nBar/lounge d'atmosfera, pista da bowling a 12 corsie, giochi arcade, biliardo, sala privata per karaoke/quiz."
    ],
    "fr": [
      "Centre style Californien décoré de rock 'n' roll, art moderne, ovnis et automobiles classiques. \r\nBar/lounge d'ambiance, bowling équipé de 12 pistes, jeux d'arcade, billards, salle de karaoké/quiz game privée."
    ],
    "nl": [
      "Twaalf erkende competitie bowlingbanen, biljart, air hockey, Virtual Reality, arcades, enz. Tevens vindt u er een bar-restaurant met 2 terrassen, een podium en een polyvalente zaal! Concertavonden, karaoke."
    ],
    "es": [
      "Centro de estilo californiano decorado con rock 'n' roll, arte moderno, ovnis y coches clásicos.\r\nBar/salón de ambiente, bolera de 12 pistas, juegos arcade, billar, sala privada de karaoke/juegos de ingenio."
    ]
  },
