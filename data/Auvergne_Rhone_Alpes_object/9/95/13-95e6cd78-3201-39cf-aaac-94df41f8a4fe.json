  "rdfs:comment": {
    "de": [
      "Restaurant und Pizzeria.\r\nIn einem renovierten und angenehmen Rahmen bietet Ihnen der Chefkoch seine traditionelle Küche aus Süditalien: Kalabrien. (mediterrane und vegetarische Küche)"
    ],
    "en": [
      "Restaurant-pizzeria.\r\nIn a renovated and pleasant setting, the chef offers you his traditional southern Italian cuisine: Calabria. (Mediterranean and vegetarian cuisine)"
    ],
    "it": [
      "Ristorante-pizzeria.\r\nIn un ambiente rinnovato e piacevole, lo chef vi propone la sua cucina tradizionale del Sud Italia: la Calabria (cucina mediterranea e vegetariana)"
    ],
    "fr": [
      "Restaurant-pizzéria.\r\nDans un cadre rénové et agréable, le chef vous propose sa cuisine traditionnelle du sud de l'Italie : la Calabre. (cuisine méditerranéenne et végétarienne)"
    ],
    "es": [
      "Restaurante-pizzería.\r\nEn un entorno renovado y agradable, el chef le ofrece su cocina tradicional del sur de Italia: Calabria (cocina mediterránea y vegetariana)"
    ],
    "nl": [
      "Restaurant-pizzeria.\r\nIn een gerenoveerd en aangenaam kader biedt de chef u zijn traditionele Zuid-Italiaanse keuken: Calabrië (mediterrane en vegetarische keuken)"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Pizzéria La Gloria"
    ]
  },
