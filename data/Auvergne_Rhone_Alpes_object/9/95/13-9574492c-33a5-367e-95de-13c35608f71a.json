  "rdfs:comment": {
    "de": [
      "Um mit Freunden oder der Familie in einer gemütlichen und modernen Einrichtung eine gute Zeit zu verbringen, ist das 4'47 der perfekte Ort! Es bietet eine Speisekarte zum Teilen oder Nicht-Teilen, die aus frischen Produkten und hausgemachten Gerichten besteht und für jeden Geschmack etwas bereithält!"
    ],
    "en": [
      "If you want to spend a good time with friends or family in a cosy and modern decor, le 4'47 is the perfect place! This restaurant offers plates to share or not, made with fresh products and homemade dishes, to please all tastes!"
    ],
    "it": [
      "Per divertirsi con gli amici o la famiglia in un ambiente accogliente e moderno, il 4'47 è il luogo perfetto! Offre un menu da condividere o meno, composto da prodotti freschi e piatti fatti in casa, e per tutti i gusti!"
    ],
    "fr": [
      "Pour passer un bon moment entre amis ou en famille dans un décor cosy et moderne, le 4'47 est l'endroit parfait ! Il propose une carte à partager ou pas, composées de produits frais et de plats faits maison, et pour tous les goûts !"
    ],
    "nl": [
      "Voor een leuke tijd met vrienden of familie in een gezellig en modern kader is de 4'47 de perfecte plek! Het biedt een menu om te delen of niet, samengesteld uit verse producten en huisgemaakte gerechten, en voor alle smaken!"
    ],
    "es": [
      "Para pasar un buen rato con los amigos o la familia en un ambiente acogedor y moderno, el 4'47 es el lugar perfecto Ofrece un menú para compartir o no, compuesto por productos frescos y platos caseros, ¡y para todos los gustos!"
    ]
  },
  "rdfs:label": {
    "de": [
      "Le 4'47 - restaurant"
    ],
    "en": [
      "Le 4'47 - restaurant"
    ],
    "fr": [
      "Le 4'47 - restaurant"
    ]
  },
