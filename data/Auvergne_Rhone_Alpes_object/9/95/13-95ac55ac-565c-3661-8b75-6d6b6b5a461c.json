  "rdfs:comment": {
    "de": [
      "La Neuvache ist ein Wildbach, der Sportfischerei erfordert: Interessant in seinem Oberlauf, ist er voll von Fischen, die man sich verdienen muss."
    ],
    "en": [
      "The Neuvache is a torrent that requires sport fishing: interesting in its upstream part, it abounds in fishes that are deserved."
    ],
    "it": [
      "La Neuvache è un torrente che richiede la pesca sportiva: interessante nella sua parte a monte, abbonda di pesci che meritano di essere catturati."
    ],
    "fr": [
      "La Neuvache est un torrent qui nécessite une pêche sportive : intéressant dans sa partie amont, il regorge de poissons qui se méritent."
    ],
    "es": [
      "El Neuvache es un torrente que requiere pesca deportiva: interesante en su parte alta, abunda en peces que merecen ser pescados."
    ],
    "nl": [
      "De Neuvache is een stroom die om sportvissen vraagt: interessant in zijn stroomopwaarts deel, zit hij vol met vissen die het verdienen om gevangen te worden."
    ]
  },
