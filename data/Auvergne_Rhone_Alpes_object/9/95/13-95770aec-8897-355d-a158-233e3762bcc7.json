  "rdfs:comment": {
    "de": [
      "Clarisse und Laurent Four, Vater und Tochter, Bio-Gemüseanbau in Colombier le Vieux.  Auf dem Hof produziertes Bio-Gemüse, aber auch Gemüse- und Obstkonserven sowie Fruchtsäfte."
    ],
    "en": [
      "Clarisse and Laurent Four, father and daughter, organic market gardening in Colombier le Vieux.  Organic vegetables grown on the farm, as well as canned vegetables, fruit and fruit juices."
    ],
    "it": [
      "Clarisse e Laurent Four, padre e figlia, si occupano di orticoltura biologica a Colombier le Vieux.  Verdure biologiche coltivate in azienda, oltre a conserve di verdure, frutta e succhi di frutta."
    ],
    "fr": [
      "Clarisse et Laurent Four, père et fille, maraichage bio à Colombier le Vieux.  Légumes bio produits sur la ferme, mais également conserves de légumes, de fruits et jus de fruit."
    ],
    "es": [
      "Clarisse y Laurent Four, padre e hija, horticultores ecológicos en Colombier le Vieux.  Verduras ecológicas cultivadas en la granja, así como conservas vegetales, frutas y zumos de frutas."
    ],
    "nl": [
      "Clarisse en Laurent Four, vader en dochter, biologisch tuinieren op Colombier le Vieux.  Op de boerderij geteelde biologische groenten, groenteconserven, fruit en vruchtensappen."
    ]
  },
  "rdfs:label": {
    "de": [
      "Ferme \"Les Serres de Bargay\""
    ],
    "en": [
      "Ferme Les Serres du Bargay"
    ],
    "fr": [
      "Ferme \"Les Serres de Bargay\""
    ],
    "nl": [
      "Ferme \"Les Serres de Bargay\""
    ]
  },
