  "rdfs:comment": {
    "de": [
      "Einfaches, familiäres Restaurant mit traditioneller, savoyardischer Küche. Hausgemachtes Gebäck, Bewirtung von Familien und Gruppen vor Ort oder auf Bestellung zum Mitnehmen."
    ],
    "en": [
      "Simple family setting, traditional and Savoy cuisine. Home made pastries, family meals, groups on the spot or to take away with prior demand."
    ],
    "it": [
      "In un'atmosfera semplice e familiare, cucina tradizionale e savoiarda. Pasticceria fatta in casa, pasti in famiglia, gruppi in loco o da asporto su ordinazione."
    ],
    "fr": [
      "En toute simplicité, cadre familial, cuisine traditionnelle et savoyarde. Pâtisserie maison, repas de famille, groupes sur place ou à emporter sur commande."
    ],
    "nl": [
      "In een eenvoudige, familiale sfeer, traditionele en Savoyaardse keuken. Huisgemaakt gebak, gezinsmaaltijden, groepen ter plaatse of om mee te nemen op bestelling."
    ],
    "es": [
      "En un ambiente sencillo y familiar, cocina tradicional y saboyana. Pastelería casera, comidas familiares, grupos in situ o para llevar por encargo."
    ]
  },
