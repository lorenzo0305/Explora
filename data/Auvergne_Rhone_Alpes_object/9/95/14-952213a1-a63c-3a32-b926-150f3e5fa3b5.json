  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/cbba72a7-3c1f-35c4-8565-9ff993ffa952",
      "dc:description": {
        "de": [
          "Familienfreundliche Einrichtung an der Côte d'Opale.\nIdealer Standort für Familien, da er gegenüber von Nausicaá liegt.\nLa Matelote wird Entspannung durch seinen Entspannungsbereich und Gastronomie mit seinem Restaurant verbinden"
        ],
        "en": [
          "Family-run establishment on the Côte d'Opale.\nIdeal location for families, opposite Nausicaá.\nLa Matelote combines relaxation with gastronomy in its restaurant"
        ],
        "it": [
          "Struttura a conduzione familiare situata sulla Côte d'Opale.\nPosizione ideale per le famiglie, di fronte a Nausicaá.\nLa Matelote unisce il relax alla gastronomia nel suo ristorante"
        ],
        "fr": [
          "Établissement familial, situé sur la Côte d'Opale.\nEmplacement idéal pour les familles car en face de Nausicaá.\nLa Matelote saura allier détente de par son espace détente et gastronomie avec son restaurant"
        ],
        "nl": [
          "Familiebedrijf aan de Côte d'Opale.\nIdeale locatie voor gezinnen, tegenover Nausicaá.\nLa Matelote combineert ontspanning met gastronomie in het restaurant"
        ],
        "es": [
          "Establecimiento familiar situado en la Côte d'Opale.\nUbicación ideal para familias, frente a Nausicaá.\nLa Matelote combina relax y gastronomía en su restaurante"
        ]
      },
