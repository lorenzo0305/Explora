  "rdfs:comment": {
    "de": [
      "Das ganze Jahr über empfängt Sie das Fremdenverkehrsamt im Herzen von Val d'Isère, um Sie zu beraten und zu inspirieren: gute Pläne, Animationen, Souvenirs, Ideen für Aktivitäten... Ihr Aufenthalt beginnt hier!"
    ],
    "en": [
      "Open year-round in the heart of Val d’Isère, the Tourist Office welcomes you with tips, events, souvenirs and activity ideas — your holiday starts here!"
    ],
    "it": [
      "Aperto tutto l’anno nel cuore di Val d’Isère, l’Ufficio del Turismo ti accoglie con consigli, eventi, souvenir e idee per vivere al meglio il tuo soggiorno!"
    ],
    "fr": [
      "Toute l’année, l’Office de Tourisme vous accueille au cœur de Val d’Isère pour vous guider et vous inspirer : bons plans, animations, souvenirs, idées d’activités… votre séjour commence ici !"
    ],
    "nl": [
      "Het hele jaar door verwelkomt het Office du Tourisme je in het hart van Val d'Isère om je te begeleiden en te inspireren: leuke aanbiedingen, evenementen, souvenirs, ideeën voor activiteiten? Je verblijf begint hier!"
    ],
    "es": [
      "Durante todo el año, la Oficina de Turismo le da la bienvenida al corazón de Val d'Isère para guiarle e inspirarle: buenas ofertas, eventos, recuerdos, ideas para actividades... ¡su estancia empieza aquí!"
    ]
  },
