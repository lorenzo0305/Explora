  "rdfs:comment": {
    "de": [
      "Die Mediathek bietet Ihnen eine Auswahl von über 8000 Erwachsenen- und Jugendbüchern und etwa 15 Zeitschriften, CDs und DVDs. Ein Computer mit Internetzugang steht Ihnen zur Verfügung."
    ],
    "en": [
      "The media library offers a choice of over 8,000 books for adults and young people, plus around 15 magazines, CDs and DVDs. A computer with Internet access is at your disposal."
    ],
    "it": [
      "La mediateca offre una scelta di oltre 8.000 libri per adulti e giovani, oltre a circa 15 riviste, CD e DVD. È disponibile un computer con accesso a Internet."
    ],
    "fr": [
      "La médiathèque vous propose un choix de plus de 8000 ouvrages adultes et jeunesse et une quinzaine de magazines, des CD et DVD. Un ordinateur avec accès internet est à votre disposition."
    ],
    "es": [
      "La mediateca ofrece una selección de más de 8.000 libros para adultos y jóvenes, además de unas 15 revistas, CD y DVD. También hay un ordenador con acceso a Internet."
    ],
    "nl": [
      "De mediatheek biedt een keuze uit meer dan 8000 boeken voor volwassenen en jongeren, plus ongeveer 15 tijdschriften, cd's en dvd's. Er is een computer met internettoegang beschikbaar."
    ]
  },
