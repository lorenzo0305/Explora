  "rdfs:comment": {
    "de": [
      "In einer freundlichen Atmosphäre bieten wir Ihnen den ganzen Tag über: Frühstück, savoyische Spezialitäten und seine traditionellen Crêpes für den Nachmittagssnack."
    ],
    "en": [
      "In a friendly atmosphere, throughout the day we offer breakfast, Savoyard specialities and traditional crêpes for a quick snack."
    ],
    "it": [
      "In un'atmosfera amichevole, durante tutto il giorno offriamo la prima colazione, le specialità savoiarde e le tradizionali crêpes per il tè del pomeriggio."
    ],
    "fr": [
      "Dans une ambiance conviviale, nous vous proposons tout au long de la journée : petits déjeuner, spécialités savoyardes et ses crêpes traditionnelles pour le goûter."
    ],
    "nl": [
      "In een gezellige sfeer bieden we de hele dag door ontbijt, Savoyaardse specialiteiten en traditionele crêpes voor een snelle hap."
    ],
    "es": [
      "En un ambiente acogedor, durante todo el día ofrecemos desayunos, especialidades saboyanas y crepes tradicionales para el té de la tarde."
    ]
  },
