  "rdfs:comment": {
    "de": [
      "Computerbetreuung, Basis für Webverbindungen, Wifi-Zugang. Angebotene Workshops: Anfänger, Office, Internet, Foto/Video, Natur-Blog, Grafikdesign, Webseitenerstellung, Workshops je nach Bedarf. Workshop der lokalen Mission an einem Donnerstagnachmittag."
    ],
    "en": [
      "Computer reception, basic web connection, wifi access. Workshops available: beginners, office automation, internet, photo/video, nature blog, graphic design, website creation, jumble workshop as required. Local mission workshop one Thursday afternoon."
    ],
    "it": [
      "Ricezione computer, base di connessione web, accesso wifi. Laboratori offerti: principianti, office automation, internet, foto/video, blog-natura, creazione di grafici, creazione di siti web, laboratorio di jumble a seconda delle necessità. Laboratorio missionario locale il giovedì pomeriggio."
    ],
    "fr": [
      "Accueil informatique, base de connexion web, accès wifi. Ateliers proposés : débutants, bureautique, internet, photo/vidéo, blog-nature, création graphique création site web, atelier pêle-mêle suivant besoin. Atelier mission locale un jeudi après midi."
    ],
    "es": [
      "Recepción de ordenadores, base de conexión a la red, acceso wifi. Talleres ofrecidos: iniciación, ofimática, internet, foto/vídeo, blog-naturaleza, creación de gráficos, creación de páginas web, taller de jumble según necesidad. Taller de misión local el jueves por la tarde."
    ],
    "nl": [
      "Computercentrum, basis voor webverbinding, wifi-toegang. Workshops beschikbaar: beginners, kantoorautomatisering, internet, foto/video, natuurblog, grafisch ontwerp, website maken, rommelworkshop naar behoefte. Lokale zendingsworkshop op donderdagmiddag."
    ]
  },
