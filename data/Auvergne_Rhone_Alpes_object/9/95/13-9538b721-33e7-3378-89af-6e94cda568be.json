  "rdfs:comment": {
    "de": [
      "Hotel mit 9 Zimmern in idealer Lage, 500 m von Bourg St. Andéol und 3,5 km von Pierrelatte entfernt in einer grünen Umgebung."
    ],
    "en": [
      "9 bedrooms hotels ideally located 500 m away from Bourg St Andéol and at 3,5 km from Pierrelatte in lush greenery."
    ],
    "it": [
      "Stella e Guillaume vi accolgono tutto l'anno nel loro hotel con 9 camere, tra cui una master suite. Nella bella stagione, potrete gustare la colazione sulla terrazza e rilassarvi a bordo piscina."
    ],
    "fr": [
      "Stella et Guillaume vous accueillent toute l'année dans leur hôtel comptant 9 chambres, dont une suite parentale. Aux beaux jours, vous apprécierez de prendre votre petit-déjeuner sur la terrasse et de vous détendre au bord de la piscine."
    ],
    "es": [
      "Stella y Guillaume le dan la bienvenida todo el año a su hotel de 9 habitaciones, incluida una suite principal. Cuando hace buen tiempo, se puede desayunar en la terraza y relajarse junto a la piscina."
    ],
    "nl": [
      "Hotel met 9 kamers ideaal gelegen in het groene landschap, op 500 m van Bourg St Andéol en 3,5 km van Pierrelatte."
    ]
  },
