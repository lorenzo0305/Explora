  "rdfs:comment": {
    "de": [
      "Atelier-Galerie, seit 1962 in La Garde Adhémar ansässig.\r\nHerstellung von Schmuck, Dekorationsgegenständen und Bildern aus silbernem Cloisonné-Email auf Kupfer, das mit einer Silberfolie bedeckt ist."
    ],
    "en": [
      "Enamelling art and jewelry."
    ],
    "it": [
      "Laboratorio-galleria aperto dal 1962 a La Garde Adhémar.\r\nProduzione di gioielli, oggetti decorativi, dipinti in smalto cloisonne d'argento su rame ricoperto di foglia d'argento."
    ],
    "fr": [
      "Atelier-galerie installé depuis 1962 à La Garde Adhémar.\r\nRéalisation de bijoux, d'objets décoratifs, de tableaux en émail cloisonné en argent sur cuivre recouvert d'une feuille d'argent."
    ],
    "es": [
      "Taller-galería establecido desde 1962 en La Garde Adhémar.\r\nProducción de joyas, objetos decorativos, pinturas en esmalte cloisonné de plata sobre cobre recubierto de pan de plata."
    ],
    "nl": [
      "Studio-galerie gevestigd in La Garde Adhémar sinds 1962.\r\nCreatie van sieraden, decoratieve objecten en schilderijen in zilver cloisonne-emaille op koper bedekt met bladzilver."
    ]
  },
