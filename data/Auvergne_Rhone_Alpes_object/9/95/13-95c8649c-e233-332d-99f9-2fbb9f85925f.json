  "rdfs:comment": {
    "de": [
      "- Belebung und Leben in der Ortschaft und Aufrechterhaltung der Dienstleistungen für die Einwohner\r\n    ? Austausch zwischen den Generationen,\r\n    - förderung und Aufwertung der Dörfer des Pays d'HURIEL\r\n- organisation von festlichen und spielerischen Veranstaltungen für jedes Publikum"
    ],
    "en": [
      "- Animation and life in the village and maintaining services for residents\r\n    ? inter-generational exchanges,\r\n    - promotion and enhancement of HURIEL villages\r\n- organization of festive and fun events for the general public"
    ],
    "it": [
      "- Animazione e vita nel villaggio e mantenimento dei servizi per i residenti\r\n    scambi intergenerazionali,\r\n    - promozione e valorizzazione dei villaggi della regione HURIEL\r\n- l'organizzazione di eventi di festa e divertimento per la popolazione"
    ],
    "fr": [
      "- Animation et vie dans le bourg et maintien des services aux habitants\r\n    • échanges inter générationnels, \r\n    - promotion et la valorisation des villages du pays d’HURIEL\r\n- organisation manifestations festives et ludiques tout public"
    ],
    "nl": [
      "- Animatie en leven in het dorp en behoud van diensten voor de bewoners\r\n    intergenerationele uitwisselingen,\r\n    - promotie en opwaardering van de dorpen in de regio HURIEL\r\n- het organiseren van feestelijke en ludieke evenementen voor het grote publiek"
    ],
    "es": [
      "- Animación y vida en el pueblo y mantenimiento de los servicios para los residentes\r\n    intercambios intergeneracionales\r\n    - promoción y valorización de los pueblos de la región de HURIEL\r\n- organización de actos festivos y lúdicos para el público en general"
    ]
  },
