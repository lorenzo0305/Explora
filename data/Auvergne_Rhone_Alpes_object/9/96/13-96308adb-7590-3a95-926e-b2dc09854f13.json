  "rdfs:comment": {
    "de": [
      "Der Verein Interdance Donzère und ADSD freuen sich, Ihnen den 2. offenen Tanzsportwettbewerb präsentieren zu können.\r\nFamilien, Freunde und Wettkämpfer treffen sich am Samstag, den 21. März 2026 in der Sporthalle von Donzère."
    ],
    "en": [
      "The Interdance Donzère association, in collaboration with ADSD, is delighted to present its 2nd Open Dance Sport Competition.\r\nFamilies, friends and competitors, we look forward to seeing you on Saturday March 21, 2026 at the Halle des Sports in Donzère."
    ],
    "it": [
      "L'associazione Interdance Donzère, in collaborazione con l'ADSD, è lieta di presentare il suo 2° Concorso di Danza Sportiva Open.\r\nFamiglie, amici e concorrenti, vi aspettiamo sabato 21 marzo 2026 alla Halle des Sports di Donzère."
    ],
    "fr": [
      "L'association Interdance Donzère en collaboration avec ADSD sont heureux de vous présenter leur 2eme compétition Open de danse sportive.\r\nFamilles, amis et compétiteurs, nous vous donnons rendez-vous le Samedi 21 Mars 2026 à la Halle des Sports de Donzère."
    ],
    "es": [
      "La asociación Interdance Donzère, en colaboración con la ADSD, se complace en presentar su 2ª Competición Abierta de Danza Deportiva.\r\nFamilias, amigos y competidores, os esperamos el sábado 21 de marzo de 2026 en la Halle des Sports de Donzère."
    ],
    "nl": [
      "De vereniging Interdance Donzère presenteert in samenwerking met ADSD met veel plezier haar 2e Open Danssportwedstrijd.\r\nFamilies, vrienden en deelnemers, we zien jullie graag op zaterdag 21 maart 2026 in de Halle des Sports in Donzère."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Open Danse Sportive Donzère"
    ]
  },
