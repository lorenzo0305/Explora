  "rdfs:comment": {
    "de": [
      "Nicolas hat eine Leidenschaft für Kunst in all ihren Formen und zeichnet sich durch die Schaffung von Tätowierungen aus, die Elemente aus verschiedenen Kunstdisziplinen beinhalten.\r\n\r\nEinführung in Tätowierungen"
    ],
    "en": [
      "Passionate about art in all its forms, Nicolas excels in creating tattoos that incorporate elements from different artistic disciplines.\r\n\r\nIntroduction to tattoos"
    ],
    "it": [
      "Appassionato di arte in tutte le sue forme, Nicolas eccelle nella creazione di tatuaggi che incorporano elementi di diverse discipline artistiche.\r\n\r\nIntroduzione ai tatuaggi"
    ],
    "fr": [
      "Passionné par l'art sous toutes ses formes, Nicolas excelle dans la création de tatouages qui intègrent des éléments de différentes disciplines artistiques.\r\n\r\nInitiation aux tatouages"
    ],
    "nl": [
      "Nicolas is gepassioneerd door kunst in al zijn vormen en blinkt uit in het creëren van tatoeages die elementen uit verschillende kunstdisciplines bevatten.\r\n\r\nInleiding tot tatoeages"
    ],
    "es": [
      "Apasionado del arte en todas sus formas, Nicolas destaca en la creación de tatuajes que incorporan elementos de diferentes disciplinas artísticas.\r\n\r\nIntroducción a los tatuajes"
    ]
  },
