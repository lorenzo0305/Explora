  "rdfs:comment": {
    "de": [
      "Yves, ein Bergbegleiter, lässt Sie die Berge in Ihrem eigenen Rhythmus entdecken. Gehen Sie auf Entdeckungsreise und erkunden Sie unsere Almen und Gipfel. Mit Yves können Sie einen Bauernhof besuchen, Qi Gong und Waldtherapie praktizieren, Gämsen und Blumen beobachten..."
    ],
    "en": [
      "Yves, a mountain guide, will help you discover the mountains at your own pace. Discover our mountain pastures and peaks. With Yves, you can visit a farm, practice Qi gong, sylvotherapy, observe chamois and flowers..."
    ],
    "it": [
      "Yves, guida alpina, vi aiuterà a scoprire le montagne al vostro ritmo. Scoprite i nostri alpeggi e le nostre cime. Con Yves, potrete visitare una fattoria, praticare il Qi gong, la silvoterapia, osservare camosci e fiori..."
    ],
    "fr": [
      "Yves, accompagnateur en montagne, vous fera découvrir la montagne à votre rythme. Partez à la découverte de nos alpages et de nos sommets. Avec Yves, vous pourrez visiter une ferme, pratiquer le Qi gong, la sylvothérapie, observer chamois et fleurs..."
    ],
    "es": [
      "Yves, guía de montaña, te ayudará a descubrir las montañas a tu ritmo. Descubra nuestros pastos de montaña y nuestras cumbres. Con Yves, podrás visitar una granja, practicar Qi gong, silvoterapia, observar gamuzas y flores..."
    ],
    "nl": [
      "Yves, een bergleider, helpt je de bergen op je eigen tempo te ontdekken. Ontdek onze bergweiden en bergtoppen. Met Yves kun je een boerderij bezoeken, Qi gong en sylvotherapie beoefenen, gemzen en bloemen observeren..."
    ]
  },
  "rdfs:label": {
