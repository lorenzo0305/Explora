  "rdfs:comment": {
    "de": [
      "In der Nähe des Waldes von Giverzat und des Tals der Bouble, Angeln in einem 3,5 ha großen Teich, in dem sich Karpfen, Rotaugen, Schleien und Hechte tummeln. Angeln mit Tageskarten. Campingplatz in der Nähe."
    ],
    "en": [
      "Near the Giverzat forest and the Bouble valley, fishing in a 3-hectare pond with carp, roach, tench and pike. Fishing with day passes. Campsite nearby."
    ],
    "it": [
      "Vicino alla foresta di Giverzat e alla valle di Bouble, pesca in uno stagno di 3,5 ettari con carpe, lasche, tinche e lucci. Disponibili biglietti giornalieri. Campeggio nelle vicinanze."
    ],
    "fr": [
      "Près de la forêt de Giverzat et de la vallée de la Bouble, pêche en étang de 3,5 ha où évoluent carpes, gardons, tanches, brochets. Pêche avec cartes journée. Camping à proximité."
    ],
    "nl": [
      "Vlakbij het bos van Giverzat en de Boublevallei, vissen in een vijver van 3,5 ha met karper, voorn, zeelt en snoek. Dagkaarten verkrijgbaar. Camping in de buurt."
    ],
    "es": [
      "Cerca del bosque de Giverzat y del valle del Bouble, pesca en un estanque de 3,5 ha con carpas, cucarachas, tencas y lucios. Posibilidad de entradas de un día. Camping cercano."
    ]
  },
