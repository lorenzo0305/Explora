  "rdfs:comment": {
    "de": [
      "Das Restaurant \"La Galoche\" empfängt Sie das ganze Jahr über mit einer großzügigen Familienküche aus der Pizzakarte und anderen Spezialitäten des Hauses. Vermietung von Fahrrädern mit elektrischer Unterstützung."
    ],
    "en": [
      "The \"La Galoche\" restaurant welcomes you all year round, serving generous family-style cuisine, pizzas and other house specialities. Electric-assist bicycles for hire."
    ],
    "it": [
      "Il ristorante \"La Galoche\" vi accoglie tutto l'anno, servendo una generosa cucina familiare, pizze e altre specialità. Noleggio di biciclette elettriche."
    ],
    "fr": [
      "Le restaurant « la Galoche » vous accueille toute l'année, pour une cuisine familiale et généreuse, de la carte des pizzas et des autres spécialités de la maison. Location de vélos a assistance électrique."
    ],
    "nl": [
      "Het restaurant \"La Galoche\" verwelkomt je het hele jaar door en serveert een royale keuken in familiestijl, pizza's en andere specialiteiten. Verhuur van elektrisch ondersteunde fietsen."
    ],
    "es": [
      "El restaurante \"La Galoche\" le da la bienvenida todo el año, sirviendo una generosa cocina familiar, pizzas y otras especialidades. Alquiler de bicicletas con asistencia eléctrica."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Galoche - Restaurant Pizzeria"
    ]
  },
