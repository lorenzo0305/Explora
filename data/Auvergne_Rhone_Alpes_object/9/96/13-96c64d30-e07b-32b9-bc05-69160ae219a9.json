  "rdfs:comment": {
    "de": [
      "In einem modernen Rahmen serviert Ihnen das Team des Restaurants Versaud eine regionale Küche.\r\n\r\nDas Restaurant befindet sich im Herzen von Viriat, einem kleinen Dorf mit 6000 Einwohnern, fünf Minuten vom Zentrum von Bourg-en-Bresse entfernt."
    ],
    "en": [
      "In a modern setting, the Versaud restaurant team serves regional cuisine.\r\n\r\nLocated in the heart of Viriat, a small village of 6,000 inhabitants, five minutes from the center of Bourg-en-Bresse."
    ],
    "it": [
      "In un ambiente moderno, il team del ristorante Versaud propone una cucina regionale.\r\n\r\nSituato nel cuore di Viriat, un piccolo villaggio di 6.000 abitanti, a soli cinque minuti dal centro di Bourg-en-Bresse."
    ],
    "fr": [
      "Dans un cadre moderne, l’équipe du restaurant Versaud vous propose une cuisine de région.\r\n\r\nInstallé au cœur de Viriat, petit village de 6 000 habitants, à cinq minutes du centre de Bourg-en-Bresse."
    ],
    "nl": [
      "In een moderne omgeving serveert het team van restaurant Versaud regionale gerechten.\r\n\r\nGelegen in het hart van Viriat, een klein dorp van 6000 inwoners, op slechts vijf minuten van het centrum van Bourg-en-Bresse."
    ],
    "es": [
      "En un ambiente moderno, el equipo del restaurante Versaud sirve cocina regional.\r\n\r\nSituado en el corazón de Viriat, un pequeño pueblo de 6.000 habitantes, a sólo cinco minutos del centro de Bourg-en-Bresse."
    ]
  },
