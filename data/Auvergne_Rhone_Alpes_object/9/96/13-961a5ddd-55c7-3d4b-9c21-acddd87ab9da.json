  "rdfs:comment": {
    "de": [
      "Entdeckung und Verbesserung des Fußballspiels, offen für alle. Montag und Donnerstag für 5-8-Jährige. Dienstag und Freitag für 9-13-Jährige. Kostenlos für Mitglieder von Haut-Lignon Foot."
    ],
    "en": [
      "Discovery and improvement of soccer open to all. Monday and Thursday for 5-8 year-olds. Tuesday and Friday for 9-13 year-olds. Free for Haut-Lignon Foot members."
    ],
    "it": [
      "Scoprire e migliorare il calcio, aperto a tutti. Lunedì e giovedì per i bambini dai 5 agli 8 anni. Martedì e venerdì per i ragazzi dai 9 ai 13 anni. Gratuito per i soci dell'Haut-Lignon Foot."
    ],
    "fr": [
      "Découverte et perfectionnement du foot ouvert à tous et toutes. Lundi et jeudi pour les 5-8 ans. Mardi et vendredi pour les 9-13 ans. Gratuits pour les licenciés Haut-Lignon Foot."
    ],
    "nl": [
      "Ontdek en verbeter voetbal, open voor iedereen. Maandag en donderdag voor 5- tot 8-jarigen. Dinsdag en vrijdag voor 9-13 jaar. Gratis voor leden van Haut-Lignon Foot."
    ],
    "es": [
      "Descubrir y mejorar el fútbol, abierto a todos. Lunes y jueves para niños de 5 a 8 años. Martes y viernes para niños de 9 a 13 años. Gratuito para los socios de Haut-Lignon Foot."
    ]
  },
