  "rdfs:comment": {
    "de": [
      "Lily und Victorien heißen Sie an den Wochenenden in Usson en Forez willkommen und bieten Ihnen köstliche Pizzen zum Mitnehmen an, die aus frischen und hochwertigen Zutaten bestehen und auf Holzfeuer gebacken werden."
    ],
    "en": [
      "Lily and Victorien welcome you on weekends in Usson en Forez and offer you delicious takeaway pizzas made with fresh, quality ingredients and cooked over a wood fire."
    ],
    "it": [
      "Lily e Victorien vi accolgono nei fine settimana a Usson en Forez e vi offrono deliziose pizze da asporto preparate con ingredienti freschi e di qualità e cotte sul fuoco a legna."
    ],
    "fr": [
      "Lily et Victorien vous accueillent les fins de semaine à Usson en Forez et vous proposent de déguster de délicieuses pizzas à emporter à base d'ingrédients frais et de qualité et cuisson au feu de bois."
    ],
    "es": [
      "Lily y Victorien le dan la bienvenida los fines de semana a Usson en Forez y le ofrecen deliciosas pizzas para llevar elaboradas con ingredientes frescos y de calidad y cocinadas al fuego de leña."
    ],
    "nl": [
      "Lily en Victorien verwelkomen je in het weekend in Usson en Forez en bieden je heerlijke afhaalpizza's gemaakt met verse kwaliteitsingrediënten en bereid boven een houtvuur."
    ]
  },
