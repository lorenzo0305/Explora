  "rdfs:comment": {
    "de": [
      "Eine Region, ein Terroir?das gute Zusammenleben. Während der gesamten Tourismussaison finden zahlreiche kulturelle Veranstaltungen statt (Regionalmesse am ersten Augustwochenende, Ausstellungen, Entdeckungsausflüge, Konzerte, Vorträge, ...)."
    ],
    "en": [
      "A territory, a terroir?good living together. Numerous cultural events take place throughout the tourist season (local produce fair on the first weekend in August, exhibitions, outings, concerts, conferences, etc.)."
    ],
    "it": [
      "Una regione, una terra: vivere bene insieme. Numerosi eventi culturali si svolgono durante la stagione turistica (fiera dei prodotti locali il primo fine settimana di agosto, mostre, gite, concerti, conferenze, ecc.)"
    ],
    "fr": [
      "Un territoire, un terroir…le bon-vivre ensemble. De nombreuses manifestations culturelles se déroulent tout au long de la saison touristique (foire du terroir le premier week-end d’août, expositions, sorties découvertes, concerts, conférences, …)."
    ],
    "es": [
      "Una región, una tierra... vivir bien juntos. A lo largo de la temporada turística se celebran numerosos actos culturales (feria de productos locales el primer fin de semana de agosto, exposiciones, excursiones, conciertos, conferencias, etc.)."
    ],
    "nl": [
      "Eén regio, één land? Goed samenleven. Tijdens het toeristische seizoen vinden er talrijke culturele evenementen plaats (streekproductenbeurs tijdens het eerste weekend van augustus, tentoonstellingen, uitstapjes, concerten, conferenties, enz.)"
    ]
  },
