  "rdfs:comment": {
    "de": [
      "Dieses schöne Bürgerhaus aus den 1930er Jahren, das in einem Wohnviertel in der Nähe des Bahnhofs liegt, empfängt Sie in einem hübschen, zeitgenössischen Dekor und serviert Ihnen eine köstliche Marktküche aus frischen Zutaten. Teller, die man in einem Augenblick verschlingen kann!"
    ],
    "en": [
      "Off-center in a residential neighborhood close to the train station, this beautiful bourgeois house - dating from the 1930s - welcomes you in a lovely contemporary decor, serving delicious market cuisine made with fresh produce. Plates that can be swallowed... in an instant!"
    ],
    "it": [
      "Fuori dal centro, in una zona residenziale vicino alla stazione, questa bella casa borghese degli anni '30 vi accoglie in un attraente arredamento contemporaneo, servendo una deliziosa cucina di mercato a base di prodotti freschi."
    ],
    "fr": [
      "Excentrée dans un quartier résidentiel proche de la gare, cette belle maison bourgeoise – datant des années 1930 – vous accueille dans un joli décor contemporain ; on vous sert une délicieuse cuisine du marché, réalisée à partir de bons produits frais."
    ],
    "es": [
      "Fuera del centro, en una zona residencial cerca de la estación, esta hermosa casa burguesa de los años 30 le da la bienvenida en una atractiva decoración contemporánea, sirviendo deliciosa cocina de mercado elaborada con productos frescos."
    ],
    "nl": [
      "Dit mooie burgerhuis uit de jaren 1930 ligt in een woonwijk vlakbij het station. Het verwelkomt je in een aantrekkelijk hedendaags decor en serveert heerlijke marktgerechten op basis van verse producten. Borden die in een oogwenk kunnen worden verorberd!"
    ]
  },
