  "rdfs:comment": {
    "de": [
      "Modistin: Kreation von Hüten, allen Kopfbedeckungen für Frauen und Männer und Modeaccessoires. Textilveredlerin: Pflanzenfärbung mit Pflanzen aus der Ardèche auf Bio-Seide und -Baumwolle.\r\nKollektionen für Winter und Sommer. Kreationen auf Bestellung bei Bedarf."
    ],
    "en": [
      "Milliner: creation of hats, all types of headgear for women and men and fashion accessories. Textile ennobler: vegetable dyeing with Ardèche plants on silk and organic cotton.\r\nWinter and summer collections. Creations to order if required."
    ],
    "it": [
      "Modista: creazione di cappelli, di tutti i tipi di copricapo per donna e uomo e di accessori moda. Nobilitatore tessile: tintura vegetale con piante dell'Ardèche su seta e cotone biologico.\r\nCollezioni invernali ed estive. Creazioni su ordinazione, se necessario."
    ],
    "fr": [
      "Modiste : création chapeaux, toutes coiffes pour femme et homme et accessoires de mode. Ennoblisseur textile : teinture végétale aux plantes d'Ardèche sur soie et coton bio.\r\nCollections hiver et été. Créations sur commande si besoin."
    ],
    "es": [
      "Sombrerero: creación de sombreros, todo tipo de tocados para mujer y hombre y accesorios de moda. Ennoblecedor textil: teñido vegetal con plantas de Ardèche sobre seda y algodón orgánico.\r\nColecciones de invierno y verano. Creaciones por encargo si es necesario."
    ],
    "nl": [
      "Milliner: creatie van hoeden, alle soorten hoofddeksels voor vrouwen en mannen en modeaccessoires. Textielveredelaar: plantaardig verven met planten uit de Ardèche op zijde en biologisch katoen.\r\nWinter- en zomercollecties. Creaties op bestelling indien gewenst."
    ]
  },
