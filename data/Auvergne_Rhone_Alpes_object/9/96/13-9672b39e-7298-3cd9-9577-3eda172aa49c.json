  "rdfs:comment": {
    "de": [
      "Kleinbrauerei - Hochwertige Bio-Biere. \r\nWir haben ein einzigartiges Know-how im Brauen mit Vulkangestein entwickelt."
    ],
    "en": [
      "Organic micro-brewery :\r\n- brewing with Volvic volcanic rock\r\n- beers to take away\r\n- meeting with the brewers"
    ],
    "it": [
      "Microbirrificio biologico e Nature et Progrès.\r\nSpecialità unica prodotta con roccia vulcanica.\r\nVendita da asporto nel negozio in loco, bottiglie e confezioni regalo."
    ],
    "fr": [
      "Micro-Brasserie BIO et Nature et Progrès.\r\nSpécialité unique de brassage à la roche volcanique.\r\nVente à emporter à la boutique sur place, bouteilles et coffrets cadeaux."
    ],
    "es": [
      "Microcervecería ecológica y Nature et Progrès.\r\nEspecialidad única elaborada con roca volcánica.\r\nVenta para llevar en la tienda, botellas y cajas de regalo."
    ],
    "nl": [
      "Biologische en Nature et Progrès microbrouwerij.\r\nUnieke specialiteit: brouwen met vulkanisch gesteente.\r\nAfhaalverkoop in de winkel ter plaatse, flessen en geschenkdozen."
    ]
  },
