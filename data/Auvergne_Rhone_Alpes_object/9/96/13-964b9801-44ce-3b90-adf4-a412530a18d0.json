  "rdfs:comment": {
    "de": [
      "Entdecken und bestaunen Sie den Reichtum der unberührten Bergwelt der Monts du Cantal.\r\nLassen Sie uns abseits der Spuren an den Hängen des Vulkans Cantal wandeln, wandern und spielen!"
    ],
    "en": [
      "Come and discover and marvel at the richness of the unspoilt mountains of the Monts du Cantal.\r\nLet's survey, explore and play off the beaten track, on the slopes of the Cantal Volcano!"
    ],
    "it": [
      "Venite a scoprire e a stupirvi della ricchezza delle montagne incontaminate dei Monts du Cantal.\r\nPasseggiate, escursioni e giochi fuori dai sentieri battuti, alle pendici del Vulcano del Cantal!"
    ],
    "fr": [
      "Venez découvrir et vous émerveiller devant la richesse des montagnes préservées des Monts du Cantal.\r\nArpentons, parcourons, jouons en dehors des traces, sur les pentes du Volcan Cantal !"
    ],
    "es": [
      "Venga a descubrir y maravillarse con la riqueza de las montañas vírgenes de los Montes del Cantal.\r\nCaminemos, hagamos senderismo y juguemos fuera de los caminos trillados, ¡en las laderas del volcán del Cantal!"
    ],
    "nl": [
      "Kom en ontdek en bewonder de rijkdom van de ongerepte bergen van de Monts du Cantal.\r\nLaten we wandelen, hiken en spelen buiten de gebaande paden, op de hellingen van de vulkaan van de Cantal!"
    ]
  },
  "rdfs:label": {
    "en": [
      "Gilles Guilloteau -Gil Rando"
    ],
    "fr": [
      "Gilles Guilloteau - La Table des Randos"
    ]
  },
