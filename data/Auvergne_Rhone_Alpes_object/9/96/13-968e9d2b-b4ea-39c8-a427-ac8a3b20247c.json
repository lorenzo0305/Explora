  "rdfs:comment": {
    "de": [
      "Restaurant im Herzen des Dorfes, das für seine Bouthéran-Weinberge bekannt ist. Feine und großzügige Küche im Einklang mit den Jahreszeiten. Spezialitäten: hausgemachte Foie gras, Frösche, Gerichte zum Mitnehmen, Geschäftsessen und Gruppen."
    ],
    "en": [
      "Situated in the heart of the village famous for its Boutheran vignoble. Fine cuisine. Specialities : foie gras, frogs' legs, crispy red mullet fillet. Take away dishes, business and group meals."
    ],
    "it": [
      "Ristorante nel cuore di un villaggio famoso per i suoi vigneti di Bouthéran. Cucina stagionale raffinata e generosa. Specialità: foie gras fatto in casa, rane, piatti da asporto, pranzi di lavoro e gruppi."
    ],
    "fr": [
      "Restaurant situé au cœur du village connu pour son vignoble du Bouthéran. Cuisine fine et généreuse au gré des saisons. Spécialités : foie gras maison, grenouilles, plats à emporter, repas d'affaires et groupes."
    ],
    "es": [
      "Restaurante en el corazón de un pueblo famoso por sus viñedos de Bouthéran. Cocina de temporada fina y generosa. Especialidades: foie gras casero, ranas, platos para llevar, comidas de negocios y grupos."
    ],
    "nl": [
      "Restaurant in het hart van een dorp dat beroemd is om de wijngaarden van Bouthéran. Fijne, gulle seizoenskeuken. Specialiteiten: huisgemaakte foie gras, kikkers, afhaalmaaltijden, zakendiners en groepen."
    ]
  },
