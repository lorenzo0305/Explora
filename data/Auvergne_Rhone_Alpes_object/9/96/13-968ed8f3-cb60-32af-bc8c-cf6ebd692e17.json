  "rdfs:comment": {
    "de": [
      "Das Restaurant Borrely: ein herzlicher Empfang für eine üppige Mahlzeit. Mit einem Service nur am Mittag bieten unsere Kellner und Köche verschiedene Menüs und Gerichte à la carte für die Feinschmecker unter Ihnen an."
    ],
    "en": [
      "The Borrely restaurant: a warm welcome for a hearty meal. Served only at lunchtime, our waiters and cooks offer a range of menus and à la carte dishes to suit all tastes."
    ],
    "it": [
      "Il ristorante Borrely: un'accoglienza calorosa per un pasto sostanzioso. Servito solo a pranzo, i nostri camerieri e cuochi propongono una gamma di menu e piatti à la carte per tutti i gusti."
    ],
    "fr": [
      "Le restaurant Borrely : un accueil chaleureux pour un repas copieux. Avec un service uniquement le midi, nos serveurs et cuisiniers proposent différents menus et plats à la carte pour les plus gourmands d'entre vous."
    ],
    "nl": [
      "Restaurant Borrely: een warm welkom voor een stevige maaltijd. Onze obers en koks serveren alleen 's middags en bieden een keuze aan menu's en à la carte gerechten voor elke smaak."
    ],
    "es": [
      "El restaurante Borrely: una cálida bienvenida para una comida abundante. Servido sólo a mediodía, nuestros camareros y cocineros proponen menús y platos a la carta para todos los gustos."
    ]
  },
