  "rdfs:comment": {
    "de": [
      "Martine und Jacques Decoret laden Sie ein, das Maison Decoret, ein 4*-Hotel und Relais et Châteaux, zu entdecken; gegenüber dem Quellenpark von Vichy, in einem unter Napoleon III. erbauten Backsteinchalet."
    ],
    "en": [
      "Martine and Jacques Decoret invite you to discover the Maison Decoret, a 4* hotel and Relais et Châteaux; facing the Vichy springs park, in a brick chalet built under Napoleon III."
    ],
    "it": [
      "Martine e Jacques Decoret vi invitano a scoprire la Maison Decoret, hotel 4* e Relais et Châteaux; di fronte al parco delle sorgenti di Vichy, in uno chalet in mattoni costruito sotto Napoleone III."
    ],
    "fr": [
      "Martine et Jacques Decoret vous invitent à découvrir la Maison Decoret, hôtel 4* et Relais et Châteaux ; face au parc des sources de Vichy, dans un chalet de briques construit sous Napoléon III."
    ],
    "es": [
      "Martine y Jacques Decoret le invitan a descubrir la Maison Decoret, un hotel de 4* y Relais et Châteaux; frente al parque de los manantiales de Vichy, en un chalet de ladrillo construido en tiempos de Napoleón III."
    ],
    "nl": [
      "Martine en Jacques Decoret nodigen u uit om het Maison Decoret te ontdekken, een 4* hotel en Relais et Châteaux; tegenover het bronnenpark van Vichy, in een bakstenen chalet gebouwd onder Napoleon III."
    ]
  },
