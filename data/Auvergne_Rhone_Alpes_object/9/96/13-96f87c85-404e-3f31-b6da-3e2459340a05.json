  "rdfs:comment": {
    "de": [
      "Campanile Findrol Savoie Léman, empfängt Sie im Herzen der Haute-Savoie, mit einfachem Zugang zum kostenlosen Privatparkplatz, 1km von den Hauptverkehrsachsen entfernt, zwischen Chamonix, den Skigebieten, Annecy und seinem See, Genf und dem Genfer See, Yvoire, Thonon."
    ],
    "en": [
      "Campanile Findrol Savoie Léman welcomes you to the heart of Haute-Savoie, with easy access to free private parking, 1 km from major roads, between Chamonix, the ski resorts, Annecy and its lake, Geneva and Lake Geneva, Yvoire and Thonon."
    ],
    "it": [
      "Il Campanile Findrol Savoie Léman vi accoglie nel cuore dell'Alta Savoia, con un facile accesso al parcheggio privato gratuito, a 1 km dalle strade principali, tra Chamonix, le stazioni sciistiche, Annecy e il suo lago, Ginevra e il lago Lemano, Yvoire, Thonon."
    ],
    "fr": [
      "Campanile Findrol Savoie Léman, vous accueille au cœur de la Haute-Savoie, avec un accès simple au parking privé gratuit, à 1km des axes routiers majeurs, entre Chamonix, les stations de ski, Annecy et son lac, Genève et le lac Léman, Yvoire, Thonon."
    ],
    "nl": [
      "Campanile Findrol Savoie Léman, verwelkomt u in het hart van de Haute-Savoie, met gemakkelijke toegang tot de gratis privéparkeerplaats, op 1 km van de grote wegen, tussen Chamonix, de skigebieden, Annecy en zijn meer, Genève en het meer van Genève, Yvoire, Thonon."
    ],
    "es": [
      "Campanile Findrol Savoie Léman, le da la bienvenida en el corazón de la Alta Saboya, con fácil acceso al aparcamiento privado gratuito, a 1 km de las principales carreteras, entre Chamonix, las estaciones de esquí, Annecy y su lago, Ginebra y el lago Lemán, Yvoire, Thonon."
    ]
  },
  "rdfs:label": {
