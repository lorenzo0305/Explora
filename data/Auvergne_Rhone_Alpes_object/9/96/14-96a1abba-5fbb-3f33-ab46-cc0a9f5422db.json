  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/934f64a9-dc97-3fe4-b1d7-9d8bde750e31",
      "dc:description": {
        "de": [
          "Spaziergang und Picknick bei Sonnenuntergang, betreut von der Sportabteilung. Treffpunkt an der Kirche von Camiers um 19:30 Uhr (Picknick, Wanderschuhe, geeignete Kleidung und Wasser mitbringen). Kostenlos."
        ],
        "en": [
          "Walk and picnic at sunset, supervised by the sports department. Meet at Camiers Church at 7.30pm (bring your own picnic, walking shoes, suitable clothing and water). Free admission."
        ],
        "it": [
          "Passeggiata e picnic al tramonto, sotto la supervisione del dipartimento sportivo. Ritrovo presso la chiesa di Camiers alle 19.30 (portare un picnic, scarpe da trekking, abbigliamento adatto e acqua). Ingresso libero."
        ],
        "fr": [
          "Balade et pique-nique au coucher de soleil, encadrés par le service des sports. Rendez-vous à l'Eglise de Camiers à 19h30 (prévoir votre pique-nique, vos chaussures de marche, des vêtements adaptés ainsi que de l'eau). Gratuit."
        ],
        "nl": [
          "Wandeling en picknick bij zonsondergang onder begeleiding van de sportafdeling. Verzamelen bij de kerk van Camiers om 19.30 uur (neem een picknick, wandelschoenen, geschikte kleding en water mee). Gratis toegang."
        ],
        "es": [
          "Paseo y picnic al atardecer, supervisado por el departamento de deportes. Encuentro en la iglesia de Camiers a las 19.30 (traiga su picnic, calzado para caminar, ropa adecuada y agua). Entrada gratuita."
        ]
      },
      "@type": [
        "Description"
      ],
