  "rdfs:comment": {
    "de": [
      "Ehemaliges befestigtes Haus aus dem 13. Jh., das Ende des 19. Jh. zu einem neugotischen Schloss umgebaut wurde, mit Blick auf den Fluss Monne.\r\nEs befindet sich in Privatbesitz. In die Liste der historischen Monumente eingetragen.\r\nDas Schloss kann von Mai bis Oktober gemietet werden."
    ],
    "en": [
      "Former 13th-century fortified house, converted into a neo-Gothic château in the late 19th century, overlooking the River Monne.\r\nPrivately owned. Listed as a Historic Monument.\r\nThe château is open for rental from May to October."
    ],
    "it": [
      "Antica casa fortificata del XIII secolo, trasformata in castello neogotico alla fine del XIX secolo, con vista sul fiume Monne.\r\nDi proprietà privata. È classificato come monumento storico.\r\nIl castello è aperto per il noleggio da maggio a ottobre."
    ],
    "fr": [
      "Ancienne maison forte du 13e s., remaniée en château néo-gothique à la fin du 19e, il surplombe la rivière de la Monne.\r\nPropriété privée. Inscrit aux Monuments Historiques.\r\nLe château est ouvert à la location de mai à octobre."
    ],
    "nl": [
      "Een voormalig versterkt huis uit de 13e eeuw, aan het eind van de 19e eeuw omgebouwd tot een neogotisch kasteel, met uitzicht op de rivier de Monne.\r\nPrivébezit. Staat op de lijst van historische monumenten.\r\nHet kasteel is te huur van mei tot oktober."
    ],
    "es": [
      "Antigua casa fortificada del siglo XIII, convertida en castillo neogótico a finales del siglo XIX, con vistas al río Monne.\r\nPropiedad privada. Declarado Monumento Histórico.\r\nEl castillo puede alquilarse de mayo a octubre."
    ]
  },
  "rdfs:label": {
