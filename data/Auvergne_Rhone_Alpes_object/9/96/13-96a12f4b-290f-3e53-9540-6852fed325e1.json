  "rdfs:comment": {
    "de": [
      "Das Vox ist eine Veranstaltungshalle mit einer Bühne und Logen, die eine Fläche von 240 m² hat. Außerdem gibt es eine 60m² große Eingangshalle mit einer kleinen Teeküche. Der Saal verfügt über 220 Sitzplätze sowie 6 Plätze für Personen mit eingeschränkter Mobilität."
    ],
    "en": [
      "Le Vox is a 240m² performance hall with stage and dressing rooms. There's also a 60m² entrance hall with a small kitchenette. The auditorium has 220 seats and 6 PRM places."
    ],
    "it": [
      "Il Vox è un teatro di 240 m² con palcoscenico e camerini. C'è anche una sala d'ingresso di 60 m² con un piccolo angolo cottura. La sala dispone di 220 posti a sedere e 6 posti PRM."
    ],
    "fr": [
      "Le Vox est une salle de spectacle comprenant une scène et des loges, d'une surface de 240 m². Il y a également un hall d'entrée de 60m² avec une petite kitchenette. La salle possède 220 places assises ainsi que 6 places PMR."
    ],
    "es": [
      "El Vox es un teatro de 240 m² con escenario y camerinos. También hay un vestíbulo de 60 m² con una pequeña cocina. Dispone de 220 butacas y 6 plazas PMR."
    ],
    "nl": [
      "De Vox is een theater van 240 m² met een podium en kleedkamers. Er is ook een inkomhal van 60m² met een kleine kitchenette. De zaal heeft 220 zitplaatsen en 6 PBM-plaatsen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Salle du Vox"
    ]
  },
