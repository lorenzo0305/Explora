  "rdfs:comment": {
    "de": [
      "Das Geschäftszentrum Polypouss bietet die Vermietung von privaten Büros ab einem halben Tag und eines für max. 15 Personen ausgestatteten Konferenzraums. Wir befinden uns im Quartier de la Gare, 4 Minuten zu Fuß vom Bahnhof Valence TGV entfernt."
    ],
    "en": [
      "The Polypouss business center offers private office rental from half a day upwards, as well as a meeting room equipped to accommodate up to 15 people. We are located in Quartier de la Gare, 4 minutes' walk from Valence TGV station."
    ],
    "it": [
      "Il centro direzionale Polypouss offre uffici privati a partire da mezza giornata e una sala riunioni in grado di ospitare fino a 15 persone. Ci troviamo nel Quartier de la Gare, a 4 minuti a piedi dalla stazione TGV di Valence."
    ],
    "fr": [
      "Le centre d'affaires Polypouss propose la location de bureaux privés à partir de la demi-journée et d'une salle de réunion équipée pour accueillir 15 personnes max. Nous sommes situés Quartier de la Gare, à 4 minutes à pied de la Gare de Valence TGV."
    ],
    "nl": [
      "Het Polypouss businesscentrum biedt privékantoren te huur vanaf een halve dag en een vergaderzaal die geschikt is voor maximaal 15 personen. We zijn gevestigd in het Quartier de la Gare, op 4 minuten lopen van het TGV-station van Valence."
    ],
    "es": [
      "El centro de negocios Polypouss ofrece despachos privados en alquiler a partir de media jornada y una sala de reuniones equipada para acoger hasta 15 personas. Estamos situados en el Quartier de la Gare, a 4 minutos a pie de la estación de TGV de Valence."
    ]
  },
