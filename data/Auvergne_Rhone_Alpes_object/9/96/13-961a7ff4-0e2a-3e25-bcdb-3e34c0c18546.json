  "rdfs:comment": {
    "de": [
      "Der Aquaparc de la Vallée Bleue ist ein 1200 m² großes, beheiztes Freiluftbecken mit einer Riesenrutsche und einem Planschbecken. Dieser Wasserpark ist ideal für einen Tag mit der Familie oder mit Freunden. Er verfügt über schattige Bereiche und einen Imbiss vor Ort."
    ],
    "en": [
      "The Vallée Bleue aquapark is a 1200 m² heated outdoor pool, with a giant slide and a paddling pool. Ideal for a day out with family or friends, this water park has shaded areas and an on-site snack bar."
    ],
    "it": [
      "L'acquapark Vallée Bleue è una piscina riscaldata all'aperto di 1200 m² con scivolo gigante e vasca per bambini. Ideale per una giornata in famiglia o con gli amici, questo parco acquatico dispone di aree ombreggiate e di uno snack bar in loco."
    ],
    "fr": [
      "L’aquaparc de la Vallée Bleue est un bassin chauffé de 1200 m², en plein air, équipé d'un toboggan géant et d'une pataugeoire. Idéal pour une journée en famille ou entre amis, cet espace aquatique dispose de zones ombragées et d'un snack sur place."
    ],
    "nl": [
      "Het aquapark Vallée Bleue is een verwarmd buitenzwembad van 1200 m² met een reuzenglijbaan en een peuterbad. Dit waterpark is ideaal voor een dagje uit met familie of vrienden en heeft schaduwrijke plekken en een eigen snackbar."
    ],
    "es": [
      "El parque acuático Vallée Bleue es una piscina exterior climatizada de 1.200 m² con un tobogán gigante y una piscina infantil. Ideal para pasar un día en familia o con amigos, este parque acuático cuenta con zonas de sombra y un bar."
    ]
  },
  "rdfs:label": {
    "en": [
      "Aquaparc, open-air swimming pool"
    ],
    "fr": [
      "Aquaparc, piscine en plein air"
    ]
  },
