  "rdfs:comment": {
    "de": [
      "Die Kirche Saint-Léger de Montfermy beherbergt außergewöhnliche Wandmalereien. Der Chor ist der am stärksten dekorierte Teil mit einem Fries aus musizierenden Engeln, dem Apostelkollegium und zwei erzählenden Tafeln."
    ],
    "en": [
      "Saint-Léger church of Montfermy contains exception murals, the most decorated part being the choir with a frieze of angelic musciens, the college of apostles and 2 naratif panels."
    ],
    "it": [
      "La chiesa di Saint-Léger de Montfermy contiene eccezionali dipinti murali. Il coro è la parte più decorata, con un fregio di angeli musicanti, il Collegio degli Apostoli e due pannelli narrativi."
    ],
    "fr": [
      "L'église Saint-Léger de Montfermy renferme des peintures murales exceptionnelles. Le chœur est la partie la plus décorée avec une frise d'anges musiciens, le collège des Apôtres et deux panneaux narratifs."
    ],
    "es": [
      "La iglesia de Saint-Léger de Montfermy contiene excepcionales pinturas murales. El coro es la parte más decorada con un friso de ángeles músicos, el Colegio de los Apóstoles y dos paneles narrativos."
    ],
    "nl": [
      "De kerk Saint-Léger de Montfermy bevat uitzonderlijke muurschilderingen. Het koor is het meest versierde deel met een fries van musicerende engelen, het college van apostelen en twee verhalende panelen."
    ]
  },
  "rdfs:label": {
    "en": [
      "Saint Léger Church"
    ],
    "fr": [
      "Église Saint-Léger"
    ]
  },
