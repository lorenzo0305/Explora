  "rdfs:comment": {
    "de": [
      "VYP CHAMONIX REAL ESTATE befindet sich im Stadtzentrum von Chamonix und bietet Ihnen einen umfassenden Transaktionsservice für den Kauf/Verkauf von Studios, Wohnungen, Chalets, Grundstücken und Geschäftsräumen im gesamten Tal von Chamonix, von Servoz bis Vallorcine."
    ],
    "en": [
      "Located in downtown Chamonix, VYP CHAMONIX REAL ESTATE offers a full transaction service for the purchase and for sale of studios, apartments, chalets, land and commercial premises throughout the Chamonix Valley, from Servoz to Vallorcine."
    ],
    "it": [
      "Situato nel centro di Chamonix, VYP CHAMONIX REAL ESTATE offre un servizio completo di transazione per l'acquisto e la vendita di monolocali, appartamenti, chalet, terreni e locali commerciali in tutta la valle di Chamonix, da Servoz a Vallorcine."
    ],
    "fr": [
      "Installé au centre-ville de Chamonix, VYP CHAMONIX REAL ESTATE vous propose un service complet de transaction pour l’achat / vente de studios, appartements, chalets, terrains et locaux commerciaux dans toute la vallée de Chamonix, de Servoz à Vallorcine."
    ],
    "nl": [
      "VYP CHAMONIX REAL ESTATE, gevestigd in het centrum van Chamonix, biedt een complete transactiedienst voor de aan- en verkoop van studio's, appartementen, chalets, terreinen en bedrijfsruimten in het hele dal van Chamonix, van Servoz tot Vallorcine."
    ],
    "es": [
      "Situada en el centro de Chamonix, VYP CHAMONIX REAL ESTATE ofrece un servicio completo de transacción para la compra / venta de estudios, pisos, chalets, terrenos y locales comerciales en todo el valle de Chamonix, desde Servoz hasta Vallorcine."
    ]
  },
