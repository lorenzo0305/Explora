  "rdfs:comment": {
    "de": [
      "Len'k ist die Bistroseite des La Maison Bonnet in Grâne im Drôme-Tal. Für Sébastien und Julie besteht ihre Geschichte darin, immer wieder die besten Produkte jeder Saison zu erfinden und zu entdecken."
    ],
    "en": [
      "Len'k is the bistro side of La Maison Bonnet in Grâne in the Drôme Valley. For Sébastien and Julie, their story is to constantly invent and discover the best products of each season."
    ],
    "it": [
      "Len'k è il lato bistrot de La Maison Bonnet a Grâne, nella Valle della Drôme. Per Sébastien e Julie, la loro storia è inventare e scoprire costantemente i migliori prodotti di ogni stagione."
    ],
    "fr": [
      "Len'k, c'est le côté bistrot de La Maison Bonnet à Grâne dans la Vallée de la Drôme. Pour Sébastien et Julie, leur histoire, c'est d'inventer et de faire découvrir sans cesse les meilleurs produits de chaque saison."
    ],
    "nl": [
      "Len'k is de bistrokant van La Maison Bonnet in Grâne in de Drômevallei. Voor Sébastien en Julie is hun verhaal er een van voortdurend uitvinden en ontdekken van de beste producten van elk seizoen."
    ],
    "es": [
      "Len'k es la parte de bistró de La Maison Bonnet en Grâne, en el valle de la Drôme. Para Sébastien y Julie, su historia es inventar y descubrir constantemente los mejores productos de cada temporada."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant Len’K – Côté Bistrot"
    ]
  },
