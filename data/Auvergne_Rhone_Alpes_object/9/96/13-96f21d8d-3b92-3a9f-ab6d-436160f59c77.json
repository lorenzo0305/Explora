  "rdfs:comment": {
    "de": [
      "Überdachte Mehrzweckhalle, genannt \"Ausstellungshalle\", besteht aus einer großen Ausstellungshalle von 1553 m², einem Veranstaltungssaal von 300 m², Lagerräumen und Sanitäranlagen von 110 m²."
    ],
    "en": [
      "Multi-purpose covered hall, called \"exhibition hall\" is made up of a large exhibition hall of 1,553 m², an auditorium of 300 m², storage and sanitary facilities for 110 m²."
    ],
    "it": [
      "La sala coperta polivalente, nota come \"sala espositiva\", è composta da una grande sala espositiva di 1.553 m², da un auditorium di 300 m² e da aree di stoccaggio e sanitarie di 110 m²."
    ],
    "fr": [
      "Halle couverte polyvalente, dénommée « halle d’exposition » est formée d’une grande halle d’exposition de 1 553 m², d’une Salle de spectacles de 300 m², des espaces de rangement et sanitaires pour 110 m²."
    ],
    "nl": [
      "Multifunctionele overdekte hal, bekend als de \"tentoonstellingshal\", bestaande uit een grote tentoonstellingszaal van 1.553 m², een auditorium van 300 m², opslagruimten en sanitaire voorzieningen voor 110 m²."
    ],
    "es": [
      "El pabellón cubierto polivalente, conocido como \"sala de exposiciones\", consta de una gran sala de exposiciones de 1.553 m², un auditorio de 300 m² y zonas de almacenamiento y sanitarias de 110 m²."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Halle d'exposition"
    ]
  },
