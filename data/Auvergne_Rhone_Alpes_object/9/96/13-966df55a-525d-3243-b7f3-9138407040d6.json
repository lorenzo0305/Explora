          "@type": [
            "schema:OpeningHoursSpecification"
          ],
          "additionalInformation": {
            "de": [
              "Nebensaison: 1. April bis 18. April / 12. Mai bis 31. Mai / 1. Oktober bis 31. Oktober: Täglich geöffnet / Restaurant dienstags und mittwochs geschlossen / vereinfachte Speisekarte an den anderen Tagen\r\n\r\nMittelsaison: 19. April bis 11. Mai / 1. Juni bis 20. Juni / 1. September bis 30. September: Täglich geöffnet / Restaurant dienstags und mittwochs geschlossen und jeden Tag vereinfachte Speisekarte\r\n\r\nHochsaison (Wochenende, Feiertage, Juli und August) jeden Tag geöffnet."
            ],
            "en": [
              "Low season: April 1 to April 18 / May 12 to May 31 / October 1 to October 31: Open every day / restaurant closed on Tuesdays and Wednesdays / simplified menu on other days\r\n\r\nMid-season: April 19 to May 11 / June 1 to June 20 / September 1 to September 30: Open every day / restaurant closed on Tuesdays and Wednesdays and simplified menu every day\r\n\r\nHigh season (weekends, public holidays, July and August) open every day."
            ],
            "it": [
              "Bassa stagione: dal 1° aprile al 18 aprile / dal 12 maggio al 31 maggio / dal 1° ottobre al 31 ottobre: aperto tutti i giorni / ristorante chiuso il martedì e il mercoledì / menu semplificato negli altri giorni\r\n\r\nMedia stagione: dal 19 aprile all'11 maggio / dal 1° giugno al 20 giugno / dal 1° settembre al 30 settembre: aperto tutti i giorni / ristorante chiuso il martedì e il mercoledì e menù semplificato tutti i giorni\r\n\r\nAlta stagione (fine settimana, festività, luglio e agosto) aperto tutti i giorni."
            ],
            "fr": [
              "Basse saison: Du 1 avril au 18 avril / du 12 mai au 31 mai / Du 1er octobre au 31 octobre  : Ouverture tous les jours / restaurant fermé le mardi et mercredi / proposition simplifiée de la carte les autres jours \r\n\r\nMoyenne saison : du 19 avril au 11 mai / du 1er juin au 20 juin / du 1er septembre au 30 septembre :Ouverture tous les jours / restaurant fermé le mardi et mercredi et carte simplifiée tous les jours \r\n\r\nHaute saison (Week end, jours fériés, juillet et août) ouvert tous les jours."
            ],
            "es": [
              "Temporada baja: del 1 de abril al 18 de abril / del 12 de mayo al 31 de mayo / del 1 de octubre al 31 de octubre: Abierto todos los días / restaurante cerrado los martes y miércoles / menú simplificado los demás días\r\n\r\nTemporada media: del 19 de abril al 11 de mayo / del 1 de junio al 20 de junio / del 1 de septiembre al 30 de septiembre: Abierto todos los días / restaurante cerrado los martes y miércoles y menú simplificado todos los días\r\n\r\nTemporada alta (fines de semana, puentes, julio y agosto): abierto todos los días."
            ],
            "nl": [
              "Laagseizoen: 1 april tot 18 april / 12 mei tot 31 mei / 1 oktober tot 31 oktober: elke dag geopend / restaurant gesloten op dinsdag en woensdag / vereenvoudigd menu op andere dagen\r\n\r\nMiddenseizoen: van 19 april tot 11 mei / van 1 juni tot 20 juni / van 1 september tot 30 september: elke dag open / restaurant gesloten op dinsdag en woensdag en elke dag vereenvoudigd menu\r\n\r\nHoogseizoen (weekenden, feestdagen, juli en augustus) elke dag geopend."
            ]
          },
