  "rdfs:comment": {
    "de": [
      "3-Sterne-Hotel in den Gorges d’Omblèze, in einem einzigartigen geschützten Naturgebiet. Komfortable Zimmer, hausgemachte, regional geprägte Küche, Terrasse an der Gervanne und eine warme Atmosphäre für einen erholsamen Aufenthalt in der Natur."
    ],
    "en": [
      "3-star hotel in the Gorges d’Omblèze, set in a unique protected natural site. Comfortable rooms, homemade locavore cuisine, a terrace by the Gervanne and a warm atmosphere for a refreshing and restorative stay in nature."
    ],
    "it": [
      "Hotel 3 stelle nel cuore delle gole dell'Omblèze, offre camere confortevoli in un sito unico classificato. Cucina casalinga locale, terrazza sulle rive della Gervanne e un'atmosfera accogliente per un soggiorno rigenerante nel cuore della natura."
    ],
    "fr": [
      "Hôtel 3 étoiles au cœur des gorges d’Omblèze, offrant des chambres confortables dans un site classé unique. Cuisine maison locavore, terrasse au bord de la Gervanne et ambiance chaleureuse pour un séjour ressourçant en pleine nature."
    ],
    "es": [
      "Hotel de 3 estrellas en el corazón de las gargantas de Omblèze, que ofrece habitaciones confortables en un lugar protegido único. Cocina local casera, terraza a orillas del Gervanne y un ambiente cálido para una estancia rejuvenecedora en plena naturaleza."
    ],
    "nl": [
      "3-sterrenhotel in de Gorges d’Omblèze, midden in een uniek beschermd natuurgebied. Comfortabele kamers, huisgemaakte en lokale keuken, terras aan de Gervanne en een warme sfeer voor een rustgevend verblijf in de natuur."
    ]
  },
