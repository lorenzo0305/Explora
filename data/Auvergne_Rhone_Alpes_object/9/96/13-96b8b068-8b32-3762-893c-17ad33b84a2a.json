  "rdfs:comment": {
    "de": [
      "Als engagierter Akteur in der Kreislaufwirtschaft bietet MDD Ihren Geräten ein zweites Leben.\r\nSpezialist für die Reparatur und den Verkauf von Smartphones, Tablets, PCs, Macs und Connected Watches."
    ],
    "en": [
      "A committed player in the circular economy, MDD offers a second life to your devices.\r\nSpecialized in the repair and sale of smartphones, tablets, PCs, Macs, and smartwatches."
    ],
    "it": [
      "Come attore impegnato nell'economia circolare, MDD offre una seconda vita ai vostri dispositivi.\r\nSpecializzata nella riparazione e nella vendita di smartphone, tablet, PC, Mac e orologi connessi."
    ],
    "fr": [
      "Acteur engagé dans l'économie circulaire, MDD propose une seconde vie à vos appareils. \r\nSpécialiste dans la réparation et la vente de smartphone, tablette, PC, mac et montre connectée."
    ],
    "es": [
      "Como actor comprometido con la economía circular, MDD ofrece una segunda vida a tus dispositivos.\r\nEspecializada en la reparación y venta de smartphones, tabletas, PC, mac y relojes conectados."
    ],
    "nl": [
      "Als speler die zich inzet voor de circulaire economie, biedt MDD een tweede leven voor je apparaten.\r\nGespecialiseerd in de reparatie en verkoop van smartphones, tablets, pc's, mac's en connected horloges."
    ]
  },
