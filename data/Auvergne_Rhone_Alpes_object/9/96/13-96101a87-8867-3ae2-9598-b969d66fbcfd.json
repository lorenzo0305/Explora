  "rdfs:comment": {
    "de": [
      "In der Nähe des Dorfes Ruynes, ein Ausflug in die Margeride mit einem schönen Panorama auf die Planèze von Saint-Flour und die Berge des Cantal."
    ],
    "en": [
      "Just a stone's throw from the village of Ruynes, an incursion into the Margeride region, with panoramic views over the Saint-Flour planèze and the Cantal mountains."
    ],
    "it": [
      "A due passi dal villaggio di Ruynes, un'incursione nella regione della Margeride con un bellissimo panorama sulla planèze di Saint-Flour e sulle montagne del Cantal."
    ],
    "fr": [
      "A deux pas du village de Ruynes, une incursion en Margeride avec un beau panorama sur la planèze de Saint-Flour et les monts du Cantal."
    ],
    "nl": [
      "Op een steenworp afstand van het dorp Ruynes, een uitstapje naar de Margeride streek met een prachtig panorama op de Saint-Flour planèze en de bergen van de Cantal."
    ],
    "es": [
      "A dos pasos del pueblo de Ruynes, una incursión en la región de Margeride con un hermoso panorama de la planèze de Saint-Flour y los montes del Cantal."
    ]
  },
  "rdfs:label": {
    "fr": [
