  "rdfs:comment": {
    "de": [
      "Es liegt auf einem Hügel, und der lateinische Ursprung seines Namens bedeutet \"Höhe\".  Das Gebiet, durch das der antike Weg von Sayette führt, weist zahlreiche Überreste aus der Römerzeit auf."
    ],
    "en": [
      "Perched on a hill, the Latin origin of its name means \"height\".  The area, crossed by the ancient Sayette road, has yielded numerous remains from Roman times."
    ],
    "it": [
      "Arroccata su una collina, l'origine latina del suo nome significa \"altezza\".  La zona, attraversata dall'antica strada Sayette, ha restituito numerosi resti di epoca romana."
    ],
    "fr": [
      "Perché sur une colline, en effet, l’origine latine de son nom signifierait « hauteur ».  Le territoire, traversé par le chemin antique de Sayette, a livré de nombreux vestiges de l’époque romaine."
    ],
    "nl": [
      "Het ligt op een heuvel en de Latijnse naam betekent \"hoogte\".  Het gebied, dat doorkruist wordt door de oude weg Sayette, heeft talrijke overblijfselen uit de Romeinse tijd opgeleverd."
    ],
    "es": [
      "Encaramada sobre una colina, el origen latino de su nombre significa \"altura\".  La zona, atravesada por la antigua calzada Sayette, ha conservado numerosos vestigios de la época romana."
    ]
  },
  "rdfs:label": {
