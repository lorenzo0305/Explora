  "rdfs:comment": {
    "de": [
      "Eine einfache und schmackhafte Küche, die mit saisonalen Produkten zubereitet und regelmäßig erneuert wird, um unsere Gäste das ganze Jahr über zu überraschen und zufriedenzustellen."
    ],
    "en": [
      "Everything is homemade, with local and seasonal products."
    ],
    "it": [
      "Una cucina semplice e gustosa, preparata con prodotti di stagione e rinnovata regolarmente per sorprendere e soddisfare i nostri clienti tutto l'anno."
    ],
    "fr": [
      "Une cuisine simple et savoureuse, élaborée avec des produits de saison et renouvelée régulièrement pour surprendre et satisfaire nos clients tout au long de l’année."
    ],
    "nl": [
      "Eenvoudige, smakelijke gerechten, bereid met seizoensproducten en regelmatig vernieuwd om onze klanten het hele jaar door te verrassen en tevreden te stellen."
    ],
    "es": [
      "Cocina sencilla y sabrosa, elaborada con productos de temporada y renovada periódicamente para sorprender y satisfacer a nuestros clientes durante todo el año."
    ]
  },
