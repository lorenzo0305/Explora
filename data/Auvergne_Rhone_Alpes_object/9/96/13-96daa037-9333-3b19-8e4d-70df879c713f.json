  "rdfs:comment": {
    "de": [
      "Das Atelier Padgom ist ein Atelier einer professionellen Illustratorin und bietet Zeichen- und Malkurse für Erwachsene und Kinder ab 6 Jahren an. Hier finden auch wechselnde Ausstellungen statt."
    ],
    "en": [
      "The Padgom workshop is a professional illustrator's workshop and offers drawing and painting courses for adults and children from 6 years old. Temporary exhibitions are organized there."
    ],
    "it": [
      "Lo studio Padgom è gestito da un illustratore professionista e offre lezioni di disegno e pittura per adulti e bambini dai 6 anni in su. Qui vengono organizzate mostre temporanee."
    ],
    "fr": [
      "L'atelier Padgom est un atelier d'artiste illustratrice professionnelle et propose des cours de dessin et de peinture pour les adultes et les enfants à partir de 6 ans. Des expositions temporaires y sont organisées."
    ],
    "es": [
      "El estudio Padgom está dirigido por un ilustrador profesional y ofrece clases de dibujo y pintura para adultos y niños a partir de 6 años. Aquí se organizan exposiciones temporales."
    ],
    "nl": [
      "De Padgom studio wordt gerund door een professionele illustrator en biedt teken- en schilderlessen voor volwassenen en kinderen vanaf 6 jaar. Hier worden tijdelijke tentoonstellingen georganiseerd."
    ]
  },
