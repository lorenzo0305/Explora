  "rdfs:comment": {
    "de": [
      "Das Fürstentum Oberbreda hilft Ihnen bei der Organisation Ihres Urlaubs in Le Pleynet. Ob Sommer oder Winter, Eigentümer oder Mieter, Urlauber oder Saisonarbeiter: Wir sind da, um Ihnen zu helfen!"
    ],
    "en": [
      "La Principauté du Haut Breda will help you organise your holiday in Le Pleynet. Summer or winter, owner or tenant, holidaymaker or seasonal worker: we're here to help you!"
    ],
    "it": [
      "Il Principato dell'Alta Breda vi aiuta a organizzare le vostre vacanze a Le Pleynet. Estate o inverno, proprietario o affittuario, vacanziere o stagionale: siamo qui per aiutarvi!"
    ],
    "fr": [
      "La Principauté du Haut Breda vous aide à organiser vos vacances au Pleynet. Eté comme hiver, propriétaire ou locataire, vacancier ou saisonnier : nous sommes là pour vous aider !"
    ],
    "nl": [
      "Het Prinsdom Haut Breda kan je helpen bij het organiseren van je vakantie op Le Pleynet. Zomer of winter, eigenaar of huurder, vakantieganger of seizoenswerker: wij zijn er om je te helpen!"
    ],
    "es": [
      "El Principado de Alta Breda le ayuda a organizar sus vacaciones en Le Pleynet. Verano o invierno, propietario o inquilino, veraneante o temporero: ¡estamos aquí para ayudarle!"
    ]
  },
