  "rdfs:comment": {
    "de": [
      "Der Food Truck La Note Gourmande ist die Geschichte von leidenschaftlichen ambulanten Gastronomen, die Ihnen auf den Straßen der Drôme ihre Vision von der Küche näher bringen: frische, lokale und hochwertige Produkte. Boutique-Catering in Allex zu entdecken!"
    ],
    "en": [
      "The La Note Gourmande food truck is the story of two passionate travelling restaurateurs who share their vision of cuisine on the roads of the Drôme: fresh, local, quality products. Store and caterer in Allex to discover!"
    ],
    "it": [
      "Il Food Truck La Note Gourmande è la storia di due persone appassionate di ristorazione mobile che vi mostreranno la loro visione della cucina sulle strade della Drôme: prodotti freschi, locali e di qualità. Negozio e catering ad Allex da scoprire!"
    ],
    "fr": [
      "Le Food Truck La Note Gourmande, c'est l'histoire de passionnés de la restauration ambulante qui vous font découvrir leur vision de la cuisine sur les routes de la Drôme : produits frais, locaux et de qualité. Boutique-traiteur à Allex à découvrir !"
    ],
    "es": [
      "El Food Truck La Note Gourmande es la historia de dos personas apasionadas por la restauración móvil que le mostrarán su visión de la cocina en las carreteras de la Drôme: productos frescos, locales y de calidad. ¡Tienda y servicio de catering en Allex para descubrir!"
    ],
    "nl": [
      "De foodtruck La Note Gourmande is het verhaal van een groep reizende horecatoppers die jou hun visie op de keuken op de wegen van de Drôme willen laten ontdekken: verse, lokale kwaliteitsproducten. Winkel en traiteur in Allex om te ontdekken!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Food truck La Note Gourmande"
    ]
  },
