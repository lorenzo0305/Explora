  "rdfs:comment": {
    "de": [
      "Der Étang de pêche du Buya ist ein Wasserrückhaltebecken, das von der Association de pêche messimoise verwaltet wird. Er befindet sich an der Route de Quinsonnas in der Gemeinde Messimy. Er ist mit Picknicktischen ausgestattet."
    ],
    "en": [
      "The Buya fishing pond is a water retention basin managed by the Messimy fishing association. It is located on the route de Quinsonnas, in the commune of Messimy. It is equipped with picnic tables."
    ],
    "it": [
      "Lo stagno di pesca di Buya è un bacino di ritenzione idrica gestito dall'associazione dei pescatori di Messimy. Si trova sulla strada di Quinsonnas, nel comune di Messimy. È attrezzato con tavoli da picnic."
    ],
    "fr": [
      "L'étang de pêche du Buya est un bassin de rétention des eaux géré par l'association de pêche messimoise. Il est situé sur la route de Quinsonnas, commune de Messimy. Il est équipé de tables de pique-nique."
    ],
    "es": [
      "El estanque de pesca de Buya es una cuenca de retención de agua gestionada por la asociación de pesca de Messimy. Se encuentra en la ruta de Quinsonnas, en el municipio de Messimy. Está equipado con mesas de picnic."
    ],
    "nl": [
      "De visvijver van Buya is een waterbekken dat wordt beheerd door de visvereniging van Messimy. Het ligt op de route de Quinsonnas, in de gemeente Messimy. Er staan picknicktafels."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Étang du Buya"
    ]
  },
