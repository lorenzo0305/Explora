  "rdfs:comment": {
    "de": [
      "Le Repère, ein Bergrestaurant in Megève, bietet Ihnen eine lokale und gesellige Küche mit frischen Produkten. Herzlicher Empfang, Familiengeist und Verkauf zum Mitnehmen mit Le Petit Repère. Auf Anfrage auch abends für Gruppen geöffnet."
    ],
    "en": [
      "Le Repère, a high-altitude restaurant in Megève, offers friendly, local cuisine made with fresh produce. A warm welcome, family spirit and takeaway sales with Le Petit Repère. Evening opening for groups on request."
    ],
    "it": [
      "Le Repère, ristorante d'alta quota a Megève, offre una cucina locale accogliente con prodotti freschi. Accoglienza calorosa, atmosfera familiare e vendita da asporto con Le Petit Repère. Apertura serale per gruppi su richiesta."
    ],
    "fr": [
      "Le Repère, restaurant d’altitude à Megève, vous propose une cuisine locale et conviviale avec des produits frais. Accueil chaleureux, esprit famille et vente à emporter avec Le Petit Repère. Ouverture possible en soirée pour les groupes sur demande."
    ],
    "es": [
      "Le Repère, restaurante de altura en Megève, ofrece una cocina local y acogedora elaborada con productos frescos. Acogida calurosa, ambiente familiar y venta para llevar con Le Petit Repère. Apertura nocturna para grupos previa petición."
    ],
    "nl": [
      "Le Repère, een restaurant op grote hoogte in Megève, biedt een vriendelijke lokale keuken met verse producten. Een warm onthaal, een familiale sfeer en afhaalmaaltijden bij Le Petit Repère. Avondopenstelling voor groepen op aanvraag."
    ]
  },
