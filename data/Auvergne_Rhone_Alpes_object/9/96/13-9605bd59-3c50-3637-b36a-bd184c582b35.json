  "rdfs:comment": {
    "de": [
      "Der Restaurant-, Unterhaltungs-, Veranstaltungs- und Schickimicki-Bereich. Er verfügt über eine 700 Quadratmeter große Außenterrasse, eine Gesamtfläche von 1600 Quadratmetern und einen Panoramablick auf drei Alpenmassive."
    ],
    "en": [
      "The dining, entertainment, events & chic area. It features a 700? outdoor terrace, a total surface area of 1600? and a panoramic view of 3 Alpine mountain ranges."
    ],
    "it": [
      "Il ristorante, l'intrattenimento, gli eventi e l'area chic. Dispone di una terrazza esterna di 700 metri, una superficie totale di 1600 metri e una vista panoramica su 3 catene montuose alpine."
    ],
    "fr": [
      "L'espace restauration, divertissement, évènementiel & chic. Il comporte une terrasse extérieure de 700㎡, une superficie totale de 1600㎡ et une vue panoramique sur 3 massifs des Alpes."
    ],
    "nl": [
      "Het restaurant, entertainment, evenementen en chique ruimte. Het heeft een buitenterras van 700 m2, een totale oppervlakte van 1600 m2 en een panoramisch uitzicht op 3 bergketens in de Alpen."
    ],
    "es": [
      "El restaurante, entretenimiento, eventos y zona chic. Cuenta con una terraza exterior de 700?, una superficie total de 1600? y una vista panorámica de 3 cordilleras alpinas."
    ]
  },
