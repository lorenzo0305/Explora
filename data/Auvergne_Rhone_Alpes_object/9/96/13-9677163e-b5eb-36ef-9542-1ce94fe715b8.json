  "rdfs:comment": {
    "de": [
      "Sie werden den Aufstieg auf den Mont Mézenc erleben, um die ersten Sonnenstrahlen auf dem Dach der Region zu genießen, begleitet von einem Bergführer! Kostenpflichtiger Besuch, Anmeldung erforderlich."
    ],
    "en": [
      "Join a mountain guide as you climb Mount Mézenc to enjoy the first rays of sunshine on the roof of the region! Visit subject to charge and registration."
    ],
    "it": [
      "Salirete sul Monte Mézenc per godere dei primi raggi di sole sul tetto della regione, accompagnati da una guida alpina! Visita a pagamento e soggetta a registrazione."
    ],
    "fr": [
      "Vous allez vivre l'ascension du mont Mézenc afin de profiter des premiers rayons du soleil sur le toit du territoire, encadrés par un accompagnateur en montagne ! Visite payante, sur inscription."
    ],
    "es": [
      "Subirá al monte Mézenc para disfrutar de los primeros rayos de sol en el techo de la región, ¡acompañado por un guía de montaña! Visita sujeta a pago e inscripción."
    ],
    "nl": [
      "Je beklimt de berg Mézenc om te genieten van de eerste zonnestralen op het dak van de regio, onder begeleiding van een berggids! Bezoek tegen betaling en registratie."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite guidée : Lever de soleil gourmand au Mézenc"
    ]
  },
