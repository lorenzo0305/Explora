  "rdfs:comment": {
    "de": [
      "Vom Opinel-Platz aus erreichen Sie über einen Waldweg den Weiler La Cochette. Auf Ihrer Abfahrt können Sie das Dorf Albiez-le-Jeune sowie den Moine de Champlan (geologisches Bauwerk: Feenkamine) bewundern"
    ],
    "en": [
      "From Place Opinel, take a forest trail to the hamlet of La Cochette. On your way down, you can admire the village of Albiez-le-Jeune and the Moine de Champlan (geological structure: fairy chimney)."
    ],
    "it": [
      "Da Place Opinel, si prende un sentiero forestale fino alla frazione di La Cochette. In discesa, si può ammirare il villaggio di Albiez-le-Jeune e il Moine de Champlan (struttura geologica: camino delle fate)"
    ],
    "fr": [
      "Au départ de la place Opinel, rejoignez le hameau de la Cochette par une piste forestière. Vous pourrez admirer sur votre descente le village d'Albiez-le-Jeune ainsi que le Moine de Champlan (édifice géologique : cheminée de fées)"
    ],
    "nl": [
      "Neem vanaf de Place Opinel een bospad naar het gehucht La Cochette. Onderweg naar beneden kun je het dorp Albiez-le-Jeune en de Moine de Champlan (geologische structuur: sprookjesschoorsteen) bewonderen"
    ],
    "es": [
      "Desde la Place Opinel, tome una pista forestal hasta la aldea de La Cochette. Al bajar, podrá admirar el pueblo de Albiez-le-Jeune y el Moine de Champlan (estructura geológica: chimenea de hadas)"
    ]
  },
  "rdfs:label": {
    "en": [
      "Mills"
    ],
    "fr": [
      "Moulins"
    ]
  },
