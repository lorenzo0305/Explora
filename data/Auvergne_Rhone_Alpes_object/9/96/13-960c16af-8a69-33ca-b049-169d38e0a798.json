  "rdfs:comment": {
    "de": [
      "Christophe und sein Team werden Sie mit außergewöhnlichen Weinen auf eine Reise schicken! Wir befinden uns auf einem 4 Hektar großen Weinbaubetrieb Saint Joseph an den Hängen der Ardèche. Kommen Sie zu uns und tanken Sie neue Energie!"
    ],
    "en": [
      "Christophe and his team will make you travel through exceptional wines!"
    ],
    "it": [
      "Christophe e il suo team vi accompagneranno in un viaggio attraverso vini eccezionali! Situato in un vigneto Saint Joseph di 4 ettari, sulle colline dell'Ardèche. Venite a fare il pieno di energia con noi!"
    ],
    "fr": [
      "Christophe et son équipe vont vous faire voyager au travers de vins d'exception ! Situé sur une exploitation de terroir viticole Saint Joseph de 4 Ha, sur les coteaux d'Ardèche. Venez vous ressourcer chez nous !"
    ],
    "es": [
      "Christophe y su equipo le harán viajar a través de unos vinos excepcionales Situado en un viñedo Saint Joseph de 4 hectáreas, en las laderas de Ardèche. ¡Venga a recargar las pilas con nosotros!"
    ],
    "nl": [
      "Christophe en zijn team nemen je mee op een reis van uitzonderlijke wijnen! Gelegen op een Saint Joseph wijngaard van 4 hectare op de hellingen van de Ardèche. Kom bij ons nieuwe energie opdoen!"
    ]
  },
