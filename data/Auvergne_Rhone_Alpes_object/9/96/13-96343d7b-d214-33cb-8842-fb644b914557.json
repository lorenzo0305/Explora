  "rdfs:comment": {
    "de": [
      "Eine der 12 markierten Skitourenrouten im gesamten Gebiet der Portes du Mont-Blanc\r\n2h30 (geschätzte Zeit ohne Gewähr)\r\n737m Höhenunterschied\r\n5.6 km Länge\r\nStart am Parkplatz von Le Bouchet bis zum Gipfel von Les Salles"
    ],
    "en": [
      "Come and escape...Put on your touring skis and discover the Combloux part of \"Les Portes du Mont-Blanc\" ski area!"
    ],
    "it": [
      "Fuga a \"COMBLOUX - Le Portes du Mont-Blanc\" in sci alpinismo!"
    ],
    "fr": [
      "L'un des 12 itinéraires ski de randonnée balisés sur l’ensemble du domaine des Portes du Mont-Blanc. \r\n2h30 (temps estimatif donné à titre indicatif)\r\n737m de dénivelé\r\n5.6km de long\r\nDépart du parking du Bouchet jusqu'au sommet des Salles"
    ],
    "es": [
      "¡Escápate a \"COMBLOUX - Les Portes du Mont-Blanc\" en esquí de senderismo!"
    ],
    "nl": [
      "Een van de 12 uitgestippelde skitochten in het gebied van de Portes du Mont-Blanc\r\n2u30 (geschatte tijd ter indicatie)\r\n737m hoogteverschil\r\n5.6km lang\r\nVertrek vanaf de parkeerplaats van Bouchet naar de top van Les Salles"
    ]
  },
