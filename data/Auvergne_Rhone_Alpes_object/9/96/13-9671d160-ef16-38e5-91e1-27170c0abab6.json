  "rdfs:comment": {
    "de": [
      "Willkommen in Siccieu-Saint-Julien-et-Carizieu im Westen der Balcons du Dauphiné, im Norden der Isère. Lassen Sie sich vor allem von seinen beiden Kirchen und dem Espace Naturel Sensible de l'Étang de Bas et des Falaises des Ravières beeindrucken."
    ],
    "en": [
      "Welcome to Siccieu-Saint-Julien-et-Carizieu in the western part of the Balcons du Dauphiné, in northern Isère. Let yourself be dazzled by its two churches and the Sensitive Natural Area of Étang de Bas and Falaises des Ravières."
    ],
    "it": [
      "Benvenuti a Siccieu-Saint-Julien-et-Carizieu, nella parte occidentale dei Balcons du Dauphiné, nell'Isère settentrionale. Lasciatevi abbagliare dalle sue due chiese e dall'Area Naturale Sensibile dell'Étang de Bas e delle Falaises des Ravières."
    ],
    "fr": [
      "Bienvenue à Siccieu-Saint-Julien-et-Carizieu à l’ouest des Balcons du Dauphiné, en nord Isère. Laissez-vous éblouir notamment par ses deux églises et par l’Espace Naturel Sensible de l'Étang de Bas et des Falaises des Ravières."
    ],
    "nl": [
      "Welkom in Siccieu-Saint-Julien-et-Carizieu in het westen van de Balcons du Dauphiné, in het noorden van de Isère. Laat je verblinden door de twee kerken en door het kwetsbare natuurgebied van de Étang de Bas en de Falaises des Ravières."
    ],
    "es": [
      "Bienvenido a Siccieu-Saint-Julien-et-Carizieu, al oeste de los Balcones del Dauphiné, en el norte de Isère. Déjese deslumbrar por sus dos iglesias y por el Espacio Natural Sensible del Étang de Bas y las Falaises des Ravières."
    ]
  },
