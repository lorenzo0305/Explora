  "rdfs:comment": {
    "de": [
      "Küche mit traditionellen, mediterranen Aromen aus Korsika und der Welt. Steakhouse mit schönen Fleischstücken. Bar Lounge, Abende Konzerte, Veranstaltungen."
    ],
    "en": [
      "Cuisine with traditional Mediterranean, Corsican and world flavours. Steakhouse with magnificent cuts of meat. Bar lounge, musical evenings, events."
    ],
    "it": [
      "Il vostro ristorante Le Polisson.\r\nD'ora in poi, il ristorante, la steakhouse e il lounge bar vi accoglieranno con tutte le loro specialità, i nuovi prodotti, la musica e molte altre sorprese ed eventi."
    ],
    "fr": [
      "Votre restaurant  Le Polisson. \r\nDorénavant, restaurant, steakhouse, bar Lounge  vous accueille avec toutes ses spécialités, nouveautés, dans une ambiance musicale, et bien d autres surprises et événements."
    ],
    "nl": [
      "Traditionele mediterrane, Corsicaanse en wereldkeuken. Steakhouse met prachtige stukken vlees. Lounge bar, concertavonden, evenementen."
    ],
    "es": [
      "Su restaurante Le Polisson.\r\nA partir de ahora, el restaurante, asador y lounge bar le acogerá con todas sus especialidades, novedades, música y muchas otras sorpresas y eventos."
    ]
  },
