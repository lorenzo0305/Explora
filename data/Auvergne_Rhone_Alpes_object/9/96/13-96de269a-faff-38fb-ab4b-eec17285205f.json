  "rdfs:comment": {
    "de": [
      "\"Le Poulailler, théâtre de proximité internationale\" verteidigt die künstlerische Vielfalt durch ein Dispositiv, das eine gerechte und ländliche kulturelle Vitalität respektiert.  Aufführungen das ganze Jahr über von Donnerstag bis Samstag am Abend."
    ],
    "en": [
      "\"Le Poulailler, théâtre de proximité internationale\" defends artistic diversity through a system that respects equitable and rural cultural vitality.  Performances all year round, Thursday to Saturday evenings."
    ],
    "it": [
      "\"Le Poulailler, théâtre de proximité internationale\" difende la diversità artistica attraverso un sistema che rispetta la vitalità culturale equa e rurale.  Spettacoli tutto l'anno dal giovedì al sabato sera."
    ],
    "fr": [
      "\"Le Poulailler, théâtre de proximité internationale\" défend la diversité artistique à travers un dispositif respectueux d’une vitalité culturelle équitable et rurale.  Spectacles toute l'année du jeudi au samedi en soirée."
    ],
    "nl": [
      "\"Le Poulailler, théâtre de proximité internationale\" verdedigt de artistieke diversiteit door middel van een systeem dat de eerlijke en landelijke culturele vitaliteit respecteert.  Het hele jaar door optredens van donderdag- tot zaterdagavond."
    ],
    "es": [
      "\"Le Poulailler, théâtre de proximité internationale\" defiende la diversidad artística mediante un sistema que respeta la vitalidad cultural justa y rural.  Actuaciones todo el año de jueves a sábado por la noche."
    ]
  },
  "rdfs:label": {
