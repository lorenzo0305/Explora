  "rdfs:comment": {
    "de": [
      "Les Bois Noirs Spa empfängt Sie inmitten der Natur in einem 350 m² großen Bereich, der dem Wohlbefinden und der Entspannung gewidmet ist. Dank unseres Qualitätsansatzes haben wir das Label \"Spa de France\" erhalten, das die Qualität unseres Zentrums und unserer Leistungen belohnt!"
    ],
    "en": [
      "\"les bois noirs\" welcomes you to a natural setting ... an area of 350 m2 dedicated to well-being and relaxation."
    ],
    "it": [
      "La Spa Les Bois Noirs vi accoglie in mezzo alla natura in uno spazio di 350 m² dedicato al benessere e al relax. Il nostro approccio alla qualità ci ha permesso di ottenere il marchio \"Spa de France\", che premia la qualità del nostro centro e dei nostri servizi!"
    ],
    "fr": [
      "Les Bois Noirs Spa vous accueille en pleine nature dans un espace de 350 m² dédiés au bien-être et à la relaxation. Notre démarche de qualité nous a permis d'obtenir le Label \"Spa de France\", récompensant la qualité de notre centre et de nos prestations !"
    ],
    "nl": [
      "Les Bois Noirs Spa verwelkomt u midden in de natuur in een ruimte van 350 m² gewijd aan welzijn en ontspanning. Dankzij onze kwaliteitsaanpak hebben wij het label \"Spa de France\" verkregen, een beloning voor de kwaliteit van ons centrum en onze diensten!"
    ],
    "es": [
      "El Spa Les Bois Noirs le acoge en plena naturaleza en un espacio de 350 m² dedicado al bienestar y la relajación. Nuestro enfoque de calidad nos ha permitido obtener el sello \"Spa de France\", que premia la calidad de nuestro centro y de nuestros servicios"
    ]
  },
  "rdfs:label": {
