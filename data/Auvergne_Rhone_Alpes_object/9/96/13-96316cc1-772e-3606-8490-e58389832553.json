  "rdfs:comment": {
    "de": [
      "In einem zeitgenössischen Bistro-Ambiente entdecken Sie eine Bistronomie-Küche, die Weltküche und regionale Küche miteinander vermischt. Schöne schattige Terrasse.\r\n2 Säle mit Platz für 40 und 30 Personen."
    ],
    "en": [
      "In a contemporary bistro atmosphere, you'll discover bistronomic cuisine combining world and local dishes. Beautiful shaded terrace.\r\n2 rooms for 40 and 30 people."
    ],
    "it": [
      "In un'atmosfera da bistrot contemporaneo, scoprirete una cucina bistronomica che combina piatti del mondo e locali. Bella terrazza ombreggiata.\r\n2 sale per 40 e 30 persone."
    ],
    "fr": [
      "Dans une ambiance bistrot contemporain vous découvrirez une cuisine bistronomique mélangeant cuisine du monde et cuisine du terroir. Belle terrasse ombragée.\r\n2 salles pouvant contenir 40 et 30 personnes."
    ],
    "nl": [
      "In een eigentijdse bistrosfeer ontdek je de bistronomische keuken met een combinatie van wereld- en streekgerechten. Mooi schaduwrijk terras.\r\n2 zalen voor 40 en 30 personen."
    ],
    "es": [
      "En un ambiente de bistró contemporáneo, descubrirá una cocina bistronómica que combina platos del mundo y locales. Hermosa terraza sombreada.\r\n2 salas para 40 y 30 personas."
    ]
  },
  "rdfs:label": {
    "en": [
      "Le Petit Bourg"
    ],
    "fr": [
      "Le Petit Bourg"
    ]
  },
