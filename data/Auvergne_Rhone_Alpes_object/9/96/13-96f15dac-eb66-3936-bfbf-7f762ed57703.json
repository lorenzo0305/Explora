  "rdfs:comment": {
    "de": [
      "Restaurant in einer ländlichen Umgebung. Traditionelle und regionale Küche.\r\nLassen Sie sich von den köstlichen Fröschen verführen, Sie werden die ganze Großzügigkeit des Küchenchefs auf Ihrem Teller finden oder das berühmte Karpfenfilet!"
    ],
    "ru": [
      "Ресторан в сельской местности. Традиционная и региональная кухня.\r\nПозвольте себе соблазниться восхитительными лягушками - на вашей тарелке вы найдете все щедрости шеф-повара - или знаменитым филе карпа!"
    ],
    "en": [
      "Restaurant in a country setting. Traditional and regional cuisine.\r\nLet yourself be tempted by the delicious frogs - you'll find all the chef's generosity on your plate - or the famous carp fillet!"
    ],
    "it": [
      "Ristorante immerso nella campagna. Cucina tradizionale e regionale.\r\nProvate le deliziose rane - troverete nel piatto tutta la generosità dello chef - o il famoso filetto di carpa!"
    ],
    "fr": [
      "Restaurant situé dans un cadre campagnard. Cuisine traditionnelle et régionale.\r\nLaissez-vous tenter par les délicieuses grenouilles, vous trouverez toute la  générosité du chef dans votre assiette ou le fameux filet de carpe !"
    ],
    "zh": [
      "餐厅位于乡间。提供传统和地方美食。\r\n您可以品尝美味的青蛙--在您的盘子里可以找到厨师的所有慷慨之举--或者著名的鲤鱼片！"
    ],
    "es": [
      "Restaurante situado en el campo. Cocina tradicional y regional.\r\nDéjese tentar por las deliciosas ranas -en su plato encontrará toda la generosidad del chef- o el famoso filete de carpa."
    ],
    "nl": [
      "Restaurant op het platteland. Traditionele en regionale keuken.\r\nLaat je verleiden door de heerlijke kikkers - je vindt alle gulheid van de chef op je bord - of de beroemde karperfilet!"
    ]
  },
