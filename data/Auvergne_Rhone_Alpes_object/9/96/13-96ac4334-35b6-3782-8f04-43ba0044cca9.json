  "rdfs:comment": {
    "de": [
      "Produzent von Ziegenkäse, Honig, Walnussöl, Lavendel, Ziegenwurstwaren, Ziegenfertiggerichten, Ziegenmilchkosmetik.\r\nMitglied des Netzwerks Bienvenue à la Ferme (Willkommen auf dem Bauernhof)."
    ],
    "en": [
      "Producer of goat cheese, honey, walnut oil, lavender, goat meat cold cuts ready meals, goat milk beauty products. Member of the network 'Bienvenue à la Ferme'."
    ],
    "it": [
      "Produttore di formaggio di capra, miele, olio di noci, lavanda, salsicce di capra, piatti di capra, cosmetici a base di latte di capra.\r\nMembro della rete Bienvenue à la Ferme."
    ],
    "fr": [
      "Producteur de fromages de chèvre, miel, huile de noix, lavande, charcuterie caprine, plats cuisinés caprins, cosmétique au lait de chèvre.\r\nAdhérent au réseau Bienvenue à la Ferme."
    ],
    "es": [
      "Productor de queso de cabra, miel, aceite de nuez, lavanda, embutidos de cabra, platos de cabra, cosméticos de leche de cabra.\r\nMiembro de la red Bienvenue à la Ferme."
    ],
    "nl": [
      "Maker van geitenkaas, honing, notenolie, jam, lavendel, vleeswaren van geitenvlees, kant-en-klare schotel met geitenvlees, cosmetica van geitenmelk. \r\nAangesloten bij het netwerk Bienvenue à la Ferme."
    ]
