  "rdfs:comment": {
    "de": [
      "Hausgemachte Küche, lokale Produkte, hauptsächlich aus biologischem Anbau: Buchweizenpfannkuchen, herzhafte Kuchen, Tartines, Salate, Gratins. Zum Mitnehmen oder vor Ort. Teestube, Crêpes und Eis"
    ],
    "en": [
      "Home cooking, local produce, mainly organic: buckwheat pancakes, savoury tarts, tartines, salads, gratins. To take away or on site. Tearoom, crêpes and ice creams"
    ],
    "it": [
      "Cucina casalinga, prodotti locali, prevalentemente biologici: frittelle di grano saraceno, torte salate, insalate, gratin. Da asporto o da mangiare in casa. Sala da tè, crêpe e gelati"
    ],
    "fr": [
      "Cuisine maison, produits locaux, essentiellement bio : galettes de sarrasin, tartes salées, salades, gratins. À emporter ou sur place. Salon de thé, crêpes, et glaces"
    ],
    "nl": [
      "Thuisbereiding, lokale producten, voornamelijk biologisch: boekweitpannenkoeken, hartige taarten, smeersels, salades, gratins. Om mee te nemen of om te eten. Theesalon, crêpes en ijsjes"
    ],
    "es": [
      "Cocina casera, productos locales, principalmente ecológicos: tortitas de trigo sarraceno, tartas saladas, ensaladas, gratinados. Para llevar o comer en casa. Salón de té, crepes y helados"
    ]
  },
