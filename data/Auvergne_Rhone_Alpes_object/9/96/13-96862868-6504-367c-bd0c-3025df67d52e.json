  "rdfs:comment": {
    "de": [
      "B'up bietet ein einzigartiges Erlebnis in der Vertikalen mit Routen-, Block- und Speedklettern, spielerischem Clip?n Climb und einem B'fun-Bereich. Alle Aktivitäten sind für alle zugänglich, unabhängig von Alter und Niveau."
    ],
    "en": [
      "B'up offers a unique vertical experience, with route climbing, bouldering, speed climbing, Clip'n Climb and a B'fun area. All activities are accessible to everyone, whatever their age or level."
    ],
    "it": [
      "B'up offre un'esperienza unica di arrampicata verticale, con percorsi di arrampicata, boulder, speed climbing, divertenti Clip'n Climb e un'area B'fun. Tutte le attività sono accessibili a tutti, indipendentemente dall'età e dal livello."
    ],
    "fr": [
      "B'up propose une expérience unique de la verticalité avec de l'escalade de voies, de bloc, de vitesse, ludique Clip’n Climb et un espace B'fun. Toutes les activités sont accessibles à toutes et tous, quels que soient l’âge, le niveau."
    ],
    "es": [
      "B'up ofrece una experiencia única de escalada vertical, con escalada en ruta, boulder, escalada de velocidad, Clip?n Climb divertido y una zona B'fun. Todas las actividades son accesibles para todos, sea cual sea su edad o nivel."
    ],
    "nl": [
      "B'up biedt een unieke verticale klimervaring, met routeklimmen, boulderen, speedklimmen, leuke Clip?n Climb en een B'fun-zone. Alle activiteiten zijn toegankelijk voor iedereen, ongeacht leeftijd of niveau."
    ]
  },
