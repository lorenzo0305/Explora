      "schema:openingHoursSpecification": [
        {
          "@id": "https://data.datatourisme.fr/f4b3352c-0214-3b49-baa0-5622f1ea06ab",
          "schema:validFrom": "2026-01-01T00:00:00",
          "schema:validThrough": "2026-12-31T23:59:59",
          "@type": [
            "schema:OpeningHoursSpecification"
          ],
          "additionalInformation": {
            "de": [
              "JULI UND AUGUST\r\nVon der Öffnung bis 12.00 Uhr: Niedrige Geschwindigkeit (26km/h)\r\nVon 12.00 bis 18.00 Uhr: An die Kunden angepasste Geschwindigkeit (Zwischen 28 und 30 km/h)\r\nVon 18 Uhr bis zur Schließung: Schnelle Geschwindigkeit (30km/h)\r\n\r\nREST DER SAISON\r\nWochenende und Feiertage :\r\nVon der Öffnung bis 12.00 Uhr: Niedrige Geschwindigkeit (26km/h)\r\n12.00 Uhr bis 18.00 Uhr: An die Kunden angepasste Geschwindigkeit (Zwischen 28 und 30km/h)\r\n18.00 Uhr bis Betriebsschluss: Schnelle Geschwindigkeit (30km/h)\r\nAlle anderen Tage:\r\n\r\nVon der Öffnung bis 18.00 Uhr: Kundenfreundliche Geschwindigkeit (Zwischen 28 und 30km/h)\r\nVon 18 Uhr bis zur Schließung: Schnelle Geschwindigkeit (30km/h)"
            ],
            "en": [
              "JULY AND AUGUST\r\nFrom opening to 12h00: Reduced speed (26km/h)\r\nFrom 12:00 to 18:00: Speed adapted to customers (between 28 and 30km/h)\r\nFrom 6pm to close: Fast speed (30km/h)\r\n\r\nREST OF THE SEASON\r\nWeekends and public holidays :\r\nFrom opening to 12:00 pm: Reduced speed (26km/h)\r\n12:00 to 18:00: Speed adapted to customers (between 28 and 30km/h)\r\n6pm to close: Fast speed (30km/h)\r\nAll other days:\r\n\r\nFrom opening to 6:00 pm: Speed adapted to customers (Between 28 and 30km/h)\r\nFrom 6pm to close: Fast speed (30km/h)"
            ],
            "it": [
              "LUGLIO E AGOSTO\r\nDall'apertura alle 12:00: velocità ridotta (26 km/h)\r\nDalle 12:00 alle 18:00: velocità adattata ai clienti (tra 28 e 30km/h)\r\nDalle 18:00 alla chiusura: Velocità veloce (30km/h)\r\n\r\nRESTO DELLA STAGIONE\r\nFine settimana e giorni festivi:\r\nDall'apertura alle 12: velocità ridotta (26 km/h)\r\ndalle 12:00 alle 18:00: velocità adattata alla clientela (tra 28 e 30km/h)\r\nDalle 18:00 alla chiusura: Velocità veloce (30km/h)\r\nTutti gli altri giorni:\r\n\r\nDall'apertura alle 18: Velocità adattata alla clientela (tra 28 e 30 km/h)\r\nDalle 18:00 alla chiusura: Velocità veloce (30km/h)"
            ],
            "fr": [
              "JUILLET ET AOÜT\r\nDe l’ouverture à 12h00 : Vitesse réduite (26km/h)\r\nDe 12h00 à 18h00 : Vitesse adaptée à la clientèle (Entre 28 et 30km/h) \r\nDe 18h à la fermeture : Vitesse rapide (30km/h)\r\n\r\nRESTE DE LA SAISON\r\nWeek end et jours fériés :\r\nDe l’ouverture à 12h00 : Vitesse réduite (26km/h)\r\n12h00 à 18h00 : Vitesse adaptée à la clientèle (Entre 28 et 30km/h) \r\nDe 18h à la fermeture : Vitesse rapide (30km/h)\r\nTous les autres jours :\r\n\r\nDe l’ouverture à 18h00 : Vitesse adaptée à la clientèle (Entre 28 et 30km/h)\r\nDe 18h à la fermeture : Vitesse rapide (30km/h)"
            ],
            "es": [
              "JULIO Y AGOSTO\r\nDe apertura a 12:00: Velocidad reducida (26km/h)\r\nDe 12:00 a 18:00: Velocidad adaptada a los clientes (entre 28 y 30km/h)\r\nDe 18:00 a cierre: Velocidad rápida (30km/h)\r\n\r\nRESTO DE LA TEMPORADA\r\nFines de semana y festivos\r\nDe apertura a 12h00: Velocidad reducida (26km/h)\r\nde 12:00 a 18:00: Velocidad adaptada a la clientela (entre 28 y 30km/h)\r\nDe 18:00 a cierre: Velocidad rápida (30km/h)\r\nTodos los demás días:\r\n\r\nDe apertura a 18h: Velocidad adaptada a la clientela (entre 28 y 30km/h)\r\nDe 18:00 a cierre: Velocidad rápida (30 km/h)"
            ],
            "nl": [
              "JULI EN AUGUSTUS\r\nVan opening tot 12:00: Verminderde snelheid (26km/u)\r\nVan 12u tot 18u: Aangepaste snelheid (tussen 28 en 30km/u)\r\nVan 18:00 tot sluiting: Hoge snelheid (30km/u)\r\n\r\nREST VAN HET SEIZOEN\r\nWeekends en feestdagen:\r\nVan opening tot 12u00: Verminderde snelheid (26km/u)\r\n12u tot 18u: Aangepaste snelheid (tussen 28 en 30km/u)\r\nVan 18u tot sluitingstijd: Hoge snelheid (30km/u)\r\nAlle andere dagen:\r\n\r\nVan opening tot 18u: Snelheid aangepast aan de klanten (tussen 28 en 30km/u)\r\nVan 18u tot sluitingstijd: hoge snelheid (30km/u)"
            ]
          },
