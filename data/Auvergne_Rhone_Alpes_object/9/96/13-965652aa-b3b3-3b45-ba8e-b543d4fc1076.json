  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Fresken von Aurec-sur-Loire!\r\nAls echtes Freilichtmuseum bietet das Ensemble einen historischen, poetischen, künstlerischen und spielerischen Spaziergang, der in seiner Art einzigartig ist."
    ],
    "en": [
      "Come and discover the frescoes of Aurec-sur-Loire !\r\nA real open-air museum, enjoy a historic, poetic, artistic and joyful walk."
    ],
    "it": [
      "Venite a scoprire gli affreschi di Aurec-sur-Loire!\r\nVero e proprio museo a cielo aperto, l'insieme offre una passeggiata storica, poetica, artistica e divertente unica nel suo genere."
    ],
    "fr": [
      "Venez découvrir les fresques d'Aurec-sur-Loire ! \r\nVéritable musée en plein air, l'ensemble offre une promenade historique, poétique, artistique et ludique, unique en son genre."
    ],
    "es": [
      "¡Venga a descubrir los frescos de Aurec-sur-Loire!\r\nVerdadero museo al aire libre, el conjunto ofrece un paseo histórico, poético, artístico y lúdico único."
    ],
    "nl": [
      "Kom en ontdek de fresco's van Aurec-sur-Loire!\r\nHet ensemble is een echt openluchtmuseum en biedt een unieke historische, poëtische, artistieke en ludieke wandeling."
    ]
  },
  "rdfs:label": {
    "en": [
      "\"Hors les murs\" Circuits"
    ],
    "fr": [
      "Parcours \"Hors les murs\""
    ]
  },
