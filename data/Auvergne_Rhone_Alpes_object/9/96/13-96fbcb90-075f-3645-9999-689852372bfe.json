  "rdfs:comment": {
    "de": [
      "Dieses Geschäft befindet sich auf dem Place Grenette, wo früher Getreide in Hülle und Fülle gehandelt wurde (daher der Name Grenette), und ist das Schweizer Taschenmesser für kulinarische Genüsse."
    ],
    "en": [
      "Cuiz’in sur Cours was designed as a social space by Piermic with the aim of facilitating discussions in small groups. As he likes to say, food and gastronomic cooking are meant to be experienced and shared around a table."
    ],
    "it": [
      "Situato in Place Grenette, dove un tempo si commerciava grano in abbondanza (da cui il nome Grenette), questo negozio è il coltellino svizzero delle delizie culinarie."
    ],
    "fr": [
      "Situé sur la place Grenette, là où, avant, les grains s’échangeaient à foison (d’où le nom Grenette), cette boutique est le couteau suisse des plaisirs culinaires."
    ],
    "es": [
      "Situada en la plaza Grenette, donde antiguamente se comerciaba con cereales en abundancia (de ahí el nombre de Grenette), esta tienda es la navaja suiza de las delicias culinarias."
    ],
    "nl": [
      "Deze winkel ligt op de Place Grenette, waar vroeger graan in overvloed werd verhandeld (vandaar de naam Grenette) en is het Zwitserse zakmes van culinaire hoogstandjes."
    ]
  },
