  "rdfs:comment": {
    "de": [
      "Gehen Sie auf Entdeckungsreise durch die Weinberge des nördlichen Rhône-Tals, mit Weinprobe im Weinkeller oder in den Weinbergen."
    ],
    "en": [
      "Discover the vineyards of the Northern Rhône Valley, with tastings in the cellar or in the vineyards."
    ],
    "it": [
      "Scoprite i vigneti della Valle del Rodano settentrionale, con degustazioni in cantina o nei vigneti."
    ],
    "fr": [
      "Partez à la découverte des vignobles de la Vallée du Rhône Nord, avec dégustation à la cave ou dans les vignes."
    ],
    "nl": [
      "Ontdek de wijngaarden van de Noordelijke Rhônevallei, met proeverijen in de kelder of in de wijngaarden."
    ],
    "es": [
