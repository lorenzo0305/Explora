  "rdfs:comment": {
    "de": [
      "Das über der Loire thronende Château du Moine-Sacristain war vom 15. bis zum 18. Jahrhundert das Privathaus des Intendanten des Priors."
    ],
    "en": [
      "Overlooking the Loire, the Château du Moine-Sacristain was the private residence of the Prior's Intendant from the 15th to 18th centuries."
    ],
    "it": [
      "Affacciato sulla Loira, lo Château du Moine-Sacristain fu la residenza privata dell'Intendente del Priore dal XV al XVIII secolo."
    ],
    "fr": [
      "Dominant la Loire, le Château du Moine-Sacristain était l'hôtel particulier de l'Intendant du prieur du XVe au XVIIIe siècle."
    ],
    "nl": [
      "Het Château du Moine-Sacristain keek uit over de Loire en was van de 15e tot de 18e eeuw de privéresidentie van de intendant van de Prior."
    ],
    "es": [
      "Con vistas al Loira, el castillo de Moine-Sacristain fue la residencia privada del intendente del Prior entre los siglos XV y XVIII."
    ]
  },
