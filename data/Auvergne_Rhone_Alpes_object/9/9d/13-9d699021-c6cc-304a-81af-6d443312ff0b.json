  "rdfs:comment": {
    "de": [
      "Das Ibis Lyon Villefranche-sur-Saône empfängt Sie in seinem 3-Sterne-Hotel. Profitieren Sie von seiner Lage in der Nähe der Ausfahrt 31.2 der A6 (Autoroute du Soleil) für einen entspannten Aufenthalt in seiner privilegierten Umgebung."
    ],
    "en": [
      "The Ibis Lyon Villefranche-sur-Saône welcomes you to its fully-renovated and modern hotel. Make the most of its location near junction 31.2 on the A6 motorway for a relaxing break in a stunning setting."
    ],
    "it": [
      "L'Ibis Lyon Villefranche-sur-Saône vi dà il benvenuto nel suo hotel 3 stelle. Approfittate della sua posizione, vicino all'uscita 31.2 dell'A6 (Autostrada del Sole) per un soggiorno rilassante in un ambiente privilegiato."
    ],
    "fr": [
      "L'Ibis Lyon Villefranche-sur-Saône vous accueille dans son hôtel 3 *. Bénéficiez de son emplacement, proche de la sortie 31.2 de l'A6 (autoroute  du Soleil) pour un séjour détente dans son cadre privilégié."
    ],
    "nl": [
      "Het Ibis Lyon Villefranche-sur-Saône verwelkomt u in zijn 3-sterrenhotel. Profiteer van de ligging, vlakbij afslag 31.2 van de A6 (Autoroute du Soleil) voor een ontspannen verblijf in de bevoorrechte omgeving."
    ],
    "es": [
      "El Ibis Lyon Villefranche-sur-Saône le da la bienvenida a su hotel de 3 estrellas. Aproveche su ubicación, cerca de la salida 31.2 de la A6 (Autoroute du Soleil) para una estancia relajante en su entorno privilegiado."
    ]
  },
  "rdfs:label": {
    "en": [
      "Ibis Hotel"
    ],
    "fr": [
      "Ibis Lyon Villefranche sur Sâone"
    ]
  },
