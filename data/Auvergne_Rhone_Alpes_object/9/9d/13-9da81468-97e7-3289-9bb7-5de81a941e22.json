  "rdfs:comment": {
    "de": [
      "Die Hauptkirche des Dorfes Coise ist dem Heiligen Stephanus geweiht. Sie ist Teil der Pfarrei Sainte Thérèse des Hauts du Lyonnais (Diözese Lyon)."
    ],
    "en": [
      "The main church in the village of Coise is dedicated to Saint Étienne. It is part of the Sainte Thérèse des Hauts du Lyonnais parish (Lyon diocese)."
    ],
    "it": [
      "La chiesa principale del villaggio di Coise è dedicata a Saint Étienne. Fa parte della parrocchia di Sainte Thérèse des Hauts du Lyonnais (diocesi di Lione)."
    ],
    "fr": [
      "L’église principale du village de Coise est dédiée à Saint Étienne. Elle fait partie de la paroisse Sainte Thérèse des Hauts du Lyonnais (Diocèse de Lyon)."
    ],
    "es": [
      "La iglesia principal del pueblo de Coise está dedicada a Saint Étienne. Pertenece a la parroquia de Sainte Thérèse des Hauts du Lyonnais (diócesis de Lyon)."
    ],
    "nl": [
      "De belangrijkste kerk in het dorp Coise is gewijd aan Saint Étienne. Ze maakt deel uit van de parochie Sainte Thérèse des Hauts du Lyonnais (Bisdom Lyon)."
    ]
  },
  "rdfs:label": {
