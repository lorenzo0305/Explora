  "rdfs:comment": {
    "de": [
      "Der Verein Stimul'Usses bietet Ihnen jeden Freitag um 20:30 Uhr eine Filmvorführung an. Eine Vorstellung für Kinder an einem Freitag alle vier Wochen um 17 Uhr. Zusätzliche Vorstellungen können auch an einem anderen Tag angesetzt werden: Informieren Sie sich auf der Website."
    ],
    "en": [
      "The Stimul'Usses association organises a film screening every Friday at 8.30pm. A screening for children every 4th Friday at 5pm. Additional screenings may be scheduled on other days: check the website."
    ],
    "it": [
      "L'associazione Stimul'Usses propone una proiezione di film ogni venerdì alle 20.30. Una proiezione per bambini ogni quarto venerdì alle 17.00. Altre proiezioni possono essere programmate in altri giorni: controllate il sito web."
    ],
    "fr": [
      "L'association Stimul'Usses vous propose une projection de film chaque vendredi à 20h30. Une séance pour les enfants un vendredi toutes les 4 semaines à 17h. Des séances supplémentaires peuvent être programmées un autre jour : consultez le site Internet."
    ],
    "es": [
      "La asociación Stimul'Usses ofrece una proyección de películas todos los viernes a las 20.30 horas. Una proyección para niños cada cuarto viernes a las 17 horas. Se pueden programar proyecciones adicionales en otros días: consulte el sitio web."
    ],
    "nl": [
      "De vereniging Stimul'Usses biedt elke vrijdag om 20.30 uur een filmvoorstelling aan. Een voorstelling voor kinderen elke vierde vrijdag om 17 uur. Extra voorstellingen kunnen op andere dagen worden gepland: kijk op de website."
    ]
  },
  "rdfs:label": {
    "en": [
