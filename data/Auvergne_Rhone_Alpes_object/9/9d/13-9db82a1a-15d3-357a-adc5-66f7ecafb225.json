  "rdfs:comment": {
    "de": [
      "Vorführung der Höhlenforschung und Direktverkauf auf dem Bauernhof. Telefonische Reservierung erforderlich."
    ],
    "en": [
      "Demonstration of truffle hunting techniques followed by product tasting and sales at the farm shop. Visitors welcome by appointment only (please phone in advance)"
    ],
    "it": [
      "Tartufi freschi di stagione e altri prodotti aziendali venduti direttamente in azienda. È indispensabile la prenotazione telefonica."
    ],
    "fr": [
      "Vente directe à la ferme, de truffes fraîches en saison, et des produits de la ferme. Réservation par téléphone indispensable."
    ],
    "es": [
      "Venta directa de trufas frescas de temporada y otros productos de la granja. Imprescindible reservar por teléfono."
    ],
    "nl": [
      "Geopend voor bezoek op afspraak. Ontdek onze producten en koop onze verse truffels, olijfolie en walnotenolie met truffel, zout van de Camargue met truffel, etherische lavandinolie."
    ]
  },
