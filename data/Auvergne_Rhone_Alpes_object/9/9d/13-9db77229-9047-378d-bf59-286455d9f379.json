  "rdfs:comment": {
    "de": [
      "Lassen Sie Ihr Fahrrad in den Räumlichkeiten von Pont et Pignons von einem Experten reparieren.\r\nIn den Räumlichkeiten befindet sich auch eine Verkaufsstelle für gebrauchte Fahrräder."
    ],
    "en": [
      "Come and have your bike repaired on the Pont et Pignons premises by an expert.\r\nThe premises also host a second-hand bike sales outlet."
    ],
    "it": [
      "Venite a far riparare la vostra bicicletta da un esperto a Pont et Pignons.\r\nI locali ospitano anche un punto vendita di biciclette di seconda mano."
    ],
    "fr": [
      "Venez faire réparer votre vélo dans les locaux de Pont et Pignons grâce à un expert.\r\nLes  locaux accueillent aussi un point de vente de vélos d'occasion."
    ],
    "es": [
      "Venga a que un experto repare su bicicleta en Pont et Pignons.\r\nEl local también alberga un punto de venta de bicicletas de segunda mano."
    ],
    "nl": [
      "Kom je fiets laten repareren door een expert bij Pont et Pignons.\r\nJe kunt er ook tweedehands fietsen kopen."
    ]
  },
  "rdfs:label": {
    "fr": [
