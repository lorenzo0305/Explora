  "rdfs:comment": {
    "de": [
      "Der Parc Animalier d'Auvergne ist ein einzigartiges Reservat für seltene und bedrohte Tierarten, das sich auf europäischer Ebene auszeichnet. Auf 45 ha werden Sie für die Artenvielfalt sensibilisiert und entdecken fast 350 seltene und bedrohte Tiere aus 60 verschiedenen Arten."
    ],
    "en": [
      "The Parc Animalier d'Auvergne is a unique reserve for rare and endangered species, with a European reputation. Over a 45-hectare area, you can learn about biodiversity and discover almost 350 rare and endangered animals of 60 different species."
    ],
    "it": [
      "Il Parc Animalier d'Auvergne è una riserva unica per le specie rare e minacciate, con una reputazione europea di eccellenza. In un'area di 45 ettari, è possibile imparare a conoscere la biodiversità e scoprire quasi 350 animali rari e minacciati di 60 specie diverse."
    ],
    "fr": [
      "Le Parc Animalier d’Auvergne est une réserve unique pour les espèces rares et menacées, qui se distingue au niveau européen. Sur 45 ha, vous êtes sensibilisés à la biodiversité et découvrez près de 350 animaux rares et menacés de 60 espèces différentes."
    ],
    "nl": [
      "Het Parc Animalier d'Auvergne is een uniek reservaat voor zeldzame en bedreigde diersoorten, met een Europese reputatie van uitmuntendheid. In een gebied van 45 hectare kun je leren over biodiversiteit en bijna 350 zeldzame en bedreigde dieren van 60 verschillende soorten ontdekken."
    ],
    "es": [
      "El Parc Animalier d'Auvergne es una reserva única de especies raras y en peligro de extinción, con reputación europea de excelencia. En una superficie de 45 hectáreas, podrá aprender sobre biodiversidad y descubrir casi 350 animales raros y en peligro de extinción de 60 especies diferentes."
    ]
  },
  "rdfs:label": {
