  "rdfs:comment": {
    "de": [
      "Cateringservice für Käseplatten mit selbst gereiftem Käse, dazu sorgfältig ausgewählte Wurstwaren und Feinkostprodukte. Jede Zusammenstellung wird nach Ihren Wünschen und Ihrem Anlass maßgeschneidert."
    ],
    "en": [
      "Catering service offering platters of cheeses aged in our own cellar, accompanied by carefully selected charcuterie and fine grocery products. Each platter is prepared to order according to your preferences and the nature of your event."
    ],
    "it": [
      "Servizio di catering con taglieri di formaggi stagionati da noi, accompagnati da salumi e prodotti di gastronomia accuratamente selezionati. Ogni composizione è fatta su misura per soddisfare i vostri desideri e il vostro evento."
    ],
    "fr": [
      "Service traiteur de plateaux de fromages affinés par nos soins, accompagnés de charcuteries et produits d’épicerie fine soigneusement sélectionnés. Chaque composition est réalisée sur mesure selon vos envies et votre événement."
    ],
    "es": [
      "Servicio de catering con tablas de quesos madurados por nosotros, acompañados de charcutería y productos delicatessen cuidadosamente seleccionados. Cada composición está hecha a la medida de sus deseos y de su evento."
    ],
    "nl": [
      "Cateringservice met door ons gerijpte kaasplateaus, vergezeld van zorgvuldig geselecteerde vleeswaren en delicatessen. Elke samenstelling wordt op maat gemaakt om aan je wensen en je evenement te voldoen."
    ]
  },
  "rdfs:label": {
    "en": [
      "Crèmerie du Salève - Customized platters and caterers"
    ],
    "fr": [
      "Crèmerie du Salève - Plateau et traiteur sur mesure"
    ]
  },
