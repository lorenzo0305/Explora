  "rdfs:comment": {
    "de": [
      "Begleitete Besichtigung des Dorfes Chanteuges und seiner Calades sowie der Abtei Saint-Marcellin und des Konservatoriums für wilden Lachs, montags bis freitags von Mitte Juni bis Mitte September ab 10:30 Uhr."
    ],
    "en": [
      "Guided tour of the village of Chanteuges and its calades, as well as the Abbaye Saint-Marcellin and the Conservatoire du Saumon Sauvage, Monday to Friday from mid-June to mid-September, starting at 10:30 am."
    ],
    "it": [
      "Visita guidata del villaggio di Chanteuges e delle sue calades, nonché dell'Abbaye Saint-Marcellin e del Conservatoire du Saumon Sauvage, dal lunedì al venerdì da metà giugno a metà settembre dalle 10.30."
    ],
    "fr": [
      "Visite accompagnée du village de Chanteuges et de ses calades, ainsi que de l'Abbaye Saint-Marcellin et du Conservatoire du Saumon Sauvage, du lundi au vendredi de mi-juin à mi-septembre à partir de 10h30."
    ],
    "es": [
      "Visita guiada del pueblo de Chanteuges y sus calades, así como de la Abadía Saint-Marcellin y el Conservatorio del Saumon Sauvage, de lunes a viernes de mediados de junio a mediados de septiembre a partir de las 10.30 h."
    ],
    "nl": [
      "Rondleiding door het dorp Chanteuges en de calades, evenals de Abbaye Saint-Marcellin en het Conservatoire du Saumon Sauvage, maandag t/m vrijdag van half juni tot half september vanaf 10.30 uur."
    ]
  },
  "rdfs:label": {
