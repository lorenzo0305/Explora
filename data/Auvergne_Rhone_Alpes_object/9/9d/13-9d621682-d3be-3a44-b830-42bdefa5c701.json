  "rdfs:comment": {
    "de": [
      "Die Mountainbike-Schule Châtel mit dem Gütesiegel \"Moniteur Cycliste Français\" ist ein Zusammenschluss von staatlich geprüften Mountainbike-Lehrern, die in den Bergen Fahrrad fahren."
    ],
    "en": [
      "The Ecole VTT Châtel is a group of state qualified MTB instructors."
    ],
    "it": [
      "La scuola di mountain bike di Châtel, che ha il marchio \"Moniteur Cycliste Français\", è un gruppo di istruttori di mountain bike con qualifiche statali che insegnano la mountain bike."
    ],
    "fr": [
      "L'école VTT Châtel labellisée \"Moniteur Cycliste Français\"est un regroupement de moniteurs de vtt titulaire de diplôme d'état enseignant le vélo en montagne."
    ],
    "es": [
      "La escuela de bicicleta de montaña de Châtel, que cuenta con la etiqueta \"Moniteur Cycliste Français\", es un grupo de monitores de bicicleta de montaña con titulación estatal que imparten clases de ciclismo de montaña."
    ],
    "nl": [
      "De mountainbikeschool van Châtel is een groep mountainbike-instructeurs met staatsdiploma's die lesgeven in mountainbiken."
    ]
  },
