  "rdfs:comment": {
    "de": [
      "In einem Rahmen, der die Traditionen des Himalaya mit der Wärme der edlen Materialien der savoyischen Berge verbindet, genießen Sie entspannende Massagen, Gesichtsbehandlungen in Zusammenarbeit mit Avril ©, Ayurveda-Therapien und All-Inclusive-Angebote."
    ],
    "en": [
      "In a setting that combines Himalayan traditions with the warmth of fine materials from the Savoyard mountains, come and enjoy relaxing massages, facial treatments in collaboration with Avril ©, Ayurvedic therapies and all-inclusive packages."
    ],
    "it": [
      "In un ambiente che unisce le tradizioni himalayane al calore dei materiali nobili delle montagne savoiarde, venite a godervi massaggi rilassanti, trattamenti viso in collaborazione con Avril ©, terapie ayurvediche e pacchetti all-inclusive."
    ],
    "fr": [
      "Dans un cadre alliant les traditions himalayennes à la chaleur des matériaux nobles des montagnes savoyardes, venez profitez  de massages relaxants, de soins de visage en collaboration avec Avril ©, de thérapies ayurvédiques et de formules tout inclus."
    ],
    "nl": [
      "Kom genieten van ontspannende massages, gezichtsbehandelingen in samenwerking met Avril ©, ayurvedische therapieën en all-inclusive arrangementen in een omgeving die de Himalaya-tradities combineert met de warmte van de edele materialen uit de Savoyaardse bergen."
    ],
    "es": [
      "En un marco que combina las tradiciones del Himalaya con la calidez de los materiales nobles de las montañas saboyanas, venga a disfrutar de masajes relajantes, tratamientos faciales en colaboración con Avril ©, terapias ayurvédicas y paquetes todo incluido."
    ]
  },
  "rdfs:label": {
    "en": [
      "Ayur Om Spa - Les Cornettes"
    ],
    "fr": [
      "Ayur Om Spa - Les Cornettes"
    ],
