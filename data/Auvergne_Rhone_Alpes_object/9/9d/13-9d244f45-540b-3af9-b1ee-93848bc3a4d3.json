  "rdfs:comment": {
    "de": [
      "Bei der Besichtigung der Eselfarm erfahren Sie mehr über den Alltag auf dem Bauernhof und das Leben unserer Tiere, die Schritte der Milchverarbeitung und natürlich über unsere Kosmetika."
    ],
    "en": [
      "During a visit to the asinery, you'll discover the daily life of the farm and our animals, the stages of milk processing and, of course, our cosmetics."
    ],
    "it": [
      "Visitando l'asineria, scoprirete la vita quotidiana della fattoria e quella dei nostri animali, le fasi di lavorazione del latte e, naturalmente, i nostri cosmetici."
    ],
    "fr": [
      "Lors de la visite de l’asinerie, vous découvrirez le quotidien de la ferme et la vie de nos animaux, les étapes de la transformation du lait et bien sur nos cosmétiques."
    ],
    "es": [
      "Cuando visite la asería, conocerá la vida cotidiana en la granja y la vida de nuestros animales, las etapas de la transformación de la leche y, por supuesto, nuestros cosméticos."
    ],
    "nl": [
      "Als je de fabriek bezoekt, kom je meer te weten over het dagelijks leven op de boerderij en het leven van onze dieren, de stappen in de melkverwerking en natuurlijk onze cosmetica."
    ]
  },
  "rdfs:label": {
