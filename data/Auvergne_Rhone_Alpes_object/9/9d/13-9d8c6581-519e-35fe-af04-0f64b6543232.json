  "rdfs:comment": {
    "de": [
      "Dieser kleine Rundweg ist für alle zugänglich. Er führt durch den Wald von Védrines, bevor er nach Rioussalat-Haut (schöner Bauernhof mit Charakter) hinaufsteigt."
    ],
    "en": [
      "This short circuit is accessible to all, in the Védrines forest, before heading up to Rioussalat-Haut (a beautiful farmhouse full of character)."
    ],
    "it": [
      "Questo breve circuito è accessibile a tutti, nella foresta di Védrines, prima di salire a Rioussalat-Haut (una bella fattoria piena di carattere)."
    ],
    "fr": [
      "Ce petit circuit est accessible à tous, dans la forêt de Védrines, avant de remonter vers Rioussalat-Haut (belle ferme de caractère)."
    ],
    "es": [
      "Este corto circuito es accesible para todos, en el bosque de Védrines, antes de subir a Rioussalat-Haut (una hermosa granja llena de carácter)."
    ],
    "nl": [
      "Dit korte circuit is toegankelijk voor iedereen, in het bos van Védrines, voordat je verder gaat naar Rioussalat-Haut (een prachtige karaktervolle boerderij)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Circuit VAE - La croix de Védrines"
    ]
  },
