  "rdfs:comment": {
    "de": [
      "Martine Dupont ist eine staatlich geprüfte Mittelgebirgswanderin und führt Sie auf geselligen und thematischen Wanderungen oder Schneeschuhwanderungen zur Entdeckung der Fauna, der Flora und der Naturschätze."
    ],
    "en": [
      "Martine Dupont is a state-qualified mountain leader who guides you on hikes or snowshoe hikes to discover the fauna, flora and natural riches of the area, on friendly, themed outings."
    ],
    "it": [
      "Martine Dupont è un'accompagnatrice di montagna qualificata che vi guiderà in passeggiate o escursioni con le racchette da neve alla scoperta della fauna, della flora e delle ricchezze naturali della regione, in gite simpatiche e a tema."
    ],
    "fr": [
      "Accompagnatrice en moyenne montagne diplômée d’État, Martine Dupont vous guide en randonnée pédestre ou en raquettes, à la découverte de la faune, de la flore et des richesses naturelles, au fil de sorties conviviales et thématiques."
    ],
    "nl": [
      "Martine Dupont is een door de staat gediplomeerde bergleidster die je kan begeleiden op wandelingen of sneeuwschoenwandelingen om de fauna, flora en natuurlijke rijkdommen van het gebied te ontdekken, tijdens gezellige, thematische uitstapjes."
    ],
    "es": [
      "Martine Dupont es monitora de montaña diplomada por el Estado, que le guiará en paseos o excursiones con raquetas de nieve para descubrir la fauna, la flora y las riquezas naturales de la región en salidas amistosas y temáticas."
    ]
  },
  "rdfs:label": {
    "en": [
      "Martine Dupont - Mountain Leader"
    ],
    "fr": [
      "Martine Dupont - Accompagnatrice en Moyenne Montagne"
    ],
    "nl": [
      "Martine Dupont - Berggids"
    ]
  },
