  "rdfs:comment": {
    "de": [
      "Nicolas Dallet freut sich, Sie in seinem Hofladen begrüßen zu dürfen. Dort finden Sie eine feine Auswahl an Bio-Honig aus der Region sowie Bienenwachskerzen, Met und weitere Bienenprodukte. Freier und offener Zugang zum Lehrgarten."
    ],
    "en": [
      "Nicolas Dallet will be delighted to welcome you to his honey farm shop. You will find there a beautiful selection of organic local honeys, as well as beeswax candles, meads and other hive products. Free and open access to the educational garden."
    ],
    "it": [
      "Nicolas Dallet sarà lieto di accogliervi nel suo negozio di miele. Troverete una raffinata gamma biologica di mieli locali, oltre a candele di cera, idromele e altri prodotti dell'alveare. Accesso gratuito all'orto didattico."
    ],
    "fr": [
      "Nicolas Dallet se fera une joie de vous accueillir à la boutique de sa miellerie. Vous y trouverez une belle gamme Bio de miels locaux ainsi que des bougies en cire, hydromels et autres produits de la ruche. Accès libre et gratuit au jardin pédagogique."
    ],
    "nl": [
      "Nicolas Dallet verwelkomt u graag in zijn honingboerderijwinkel. U vindt er een prachtige selectie biologische, lokale honingsoorten, maar ook bijenwas kaarsen, mede en andere bijenproducten. Vrije en onbeperkte toegang tot de educatieve tuin."
    ],
    "es": [
      "Nicolas Dallet estará encantado de recibirle en su tienda de miel. Encontrará una excelente gama ecológica de mieles locales, así como velas de cera, hidromieles y otros productos de la colmena. Acceso gratuito al jardín didáctico."
    ]
  },
  "rdfs:label": {
