  "rdfs:comment": {
    "de": [
      "Mahlzeiten direkt vom Bauernhof in der Herberge.\r\nQualitativ hochwertiges Essen, das hauptsächlich aus saisonalen Produkten vom Bauernhof besteht. Nur auf Reservierung, ab 8 Pers., um die Ruhe unserer Gäste und der Tiere zu wahren."
    ],
    "en": [
      "Meals directly from the farm to the inn\r\nQuality food based on seasonal farm produce. Reservations required for 8 people or more, to preserve the peace and quiet of our guests and the animals."
    ],
    "it": [
      "Pasti direttamente dalla fattoria all'ostello\r\nCibo di qualità, principalmente a base di prodotti agricoli di stagione. Solo su prenotazione, a partire da 8 persone, per preservare la tranquillità dei nostri ospiti e degli animali."
    ],
    "fr": [
      "Des repas directement de la ferme à l’auberge\r\nUne nourriture de qualité essentiellement à base de produits de la ferme de saison. Uniquement sur réservation, à partir de 8 pers., afin de préserver la tranquillité de nos convives et des animaux."
    ],
    "nl": [
      "Maaltijden rechtstreeks van de boerderij naar de herberg\r\nKwaliteitsvoeding, voornamelijk op basis van seizoensgebonden producten van de boerderij. Alleen op reservering, vanaf 8 personen, om de rust van onze gasten en de dieren te bewaren."
    ],
    "es": [
      "Comidas directamente de la granja al albergue\r\nComida de calidad basada principalmente en productos de temporada de la granja. Sólo con reserva, a partir de 8 personas, para preservar la tranquilidad de nuestros huéspedes y animales."
    ]
  },
