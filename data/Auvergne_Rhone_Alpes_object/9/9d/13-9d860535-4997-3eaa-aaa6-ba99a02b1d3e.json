  "rdfs:comment": {
    "de": [
      "Erleben Sie eine kreative und entspannende Erfahrung in unseren gemeinsamen Töpferei-Workshops in Giez, inmitten einer warmen und geselligen Umgebung. Einführungskurse, selbstständige Praxis, Steingut, Raku, Drehen, Modellieren..."
    ],
    "en": [
      "Come and enjoy a creative and relaxing experience at our shared pottery workshops in Giez, in the heart of a warm and friendly setting. Introductory courses, independent practice, stoneware, Raku, throwing, modeling..."
    ],
    "it": [
      "Venite a vivere un'esperienza creativa e rilassante nei nostri laboratori di ceramica condivisi a Giez, nel cuore di un ambiente caldo e accogliente. Corsi introduttivi, pratica indipendente, gres, Raku, lavorazione, modellazione..."
    ],
    "fr": [
      "Venez vivre une expérience créative et relaxante lors de nos ateliers de poterie partagés à Giez, au cœur d'un cadre chaleureux et convivial. Cours d'initiation, pratique en autonomie, grès, Raku, tournage, modelage.."
    ],
    "es": [
      "Venga a disfrutar de una experiencia creativa y relajante en nuestros talleres compartidos de alfarería de Giez, en el corazón de un entorno cálido y acogedor. Clases de iniciación, prácticas independientes, gres, Raku, lanzamiento, modelado..."
    ],
    "nl": [
      "Kom genieten van een creatieve en ontspannende ervaring in onze gemeenschappelijke pottenbakkersateliers in Giez, in een warme en gezellige omgeving. Inleidende cursussen, zelfstandige praktijk, steengoed, Raku, werpen, boetseren..."
    ]
  },
