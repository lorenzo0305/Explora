  "rdfs:comment": {
    "de": [
      "Die Keramikerin Raphaële Gallet empfängt Sie in ihrem Geschäft, in dem sie ihre aus Steinzeug gefertigten und modellierten oder gedrehten Stücke ausstellt und verkauft. Ihr Atelier befindet sich gleich nebenan, wo sie Animationen, Praktika und Drehvorführungen anbietet."
    ],
    "en": [
      "Raphaële Gallet, ceramist artisan, welcomes you in his shop where she exposes and sells its pieces in sandstone in modeling or on the wheel. Her worskhop is next to the place where she propones animations, learning sessions and demos of wheeling."
    ],
    "it": [
      "Raphaële Gallet, ceramista artigiano, vi accoglie nel suo negozio dove espone e vende i suoi pezzi in gres modellato o tornito. Il suo studio si trova proprio accanto dove propone animazioni, stage e dimostrazioni di riprese."
    ],
    "fr": [
      "Raphaële Gallet, artisan céramiste, vous accueille dans sa boutique où elle expose et vend ses pièces faites en grès en modelage ou au tour. Son atelier se trouve juste à côté où elle propose des animations, des stages et des démonstrations de tournage."
    ],
    "es": [
      "Raphaële Gallet, ceramista artesana, le da la bienvenida a su tienda, donde expone y vende sus piezas de gres modelado y de torno. Su taller se encuentra al lado, donde organiza eventos, cursos y demostraciones de torno."
    ],
    "nl": [
      "Raphaële Gallet, ambachtelijk keramiste, heet je welkom in haar winkel, waar ze haar gemodelleerde en op de draaischijf gegoten stukken steengoed tentoonstelt en verkoopt. Haar atelier ligt ernaast, waar ze evenementen, cursussen en demonstraties raddraaien organiseert."
    ]
  },
