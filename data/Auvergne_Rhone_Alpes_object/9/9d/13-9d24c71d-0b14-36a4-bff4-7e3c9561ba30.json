  "rdfs:comment": {
    "de": [
      "Ganz oben im Dorf, im Espace Nature & Loisirs du Collet, genießt dieses Restaurant einen außergewöhnlichen Rahmen mit freiem Blick auf die umliegende Natur."
    ],
    "en": [
      "Situated in the \"Espace Nature & Loisirs du Collet,\",  in a wonderful environment, this restaurant welcome all the day."
    ],
    "it": [
      "In cima al villaggio, nell'Espace Nature & Loisirs du Collet, questo ristorante gode di un ambiente eccezionale con una vista ininterrotta sulla campagna circostante."
    ],
    "fr": [
      "Tout en haut du village, à l'Espace Nature & Loisirs du Collet, ce restaurant bénéficie d'un cadre exceptionnel avec une vue dégagée sur la nature environnante."
    ],
    "nl": [
      "Op de top van het dorp, in het \"Espace Nature & Loisirs du Collet\", geniet dit restaurant van een uitzonderlijke omgeving met een onbelemmerd uitzicht op de omliggende natuur. Charlotte zal je verwelkomen tijdens je rit of na een potje petanque of tennis."
    ],
    "es": [
      "En lo alto del pueblo, en el Espace Nature & Loisirs du Collet, este restaurante goza de un marco excepcional con una vista ininterrumpida de la campiña circundante."
    ]
  },
