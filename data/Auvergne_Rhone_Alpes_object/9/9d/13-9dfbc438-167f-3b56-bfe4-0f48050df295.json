  "rdfs:comment": {
    "de": [
      "Sie haben es sich verdient, sich einen Moment der Freude zu gönnen, indem Sie eine Fußreflexzonensitzung bei Nadia buchen. Es gibt nichts Besseres, um emotionale und körperliche Spannungen zu lösen, die sich im Laufe Ihres Jahres angesammelt haben."
    ],
    "en": [
      "You have earned a moment of pleasure by booking a foot reflexology session with Nadia. What better way to release the emotional and physical tensions accumulated during your year."
    ],
    "it": [
      "Prenotando una seduta di riflessologia plantare con Nadia vi siete guadagnati un momento di piacere. Quale modo migliore per scaricare le tensioni emotive e fisiche accumulate durante l'anno?"
    ],
    "fr": [
      "Vous avez bien mérité de vous octroyer un moment de plaisir en réservant une séance de réflexologie plantaire avec Nadia. Quoi de mieux pour dénouer les tensions émotionnelles et physiques accumulées durant votre année."
    ],
    "es": [
      "Te has ganado un momento de placer reservando una sesión de reflexología podal con Nadia. Qué mejor manera de liberar las tensiones emocionales y físicas acumuladas durante el año."
    ],
    "nl": [
      "Je hebt een moment van plezier verdiend door een voetreflexsessie met Nadia te boeken. Wat is een betere manier om de emotionele en fysieke spanning te verlichten die je in de loop van het jaar hebt opgebouwd."
    ]
  },
  "rdfs:label": {
    "de": [
      "Fuß- und Gesichtsreflexzonenmassage von Nadia Montmayeur"
    ],
    "fr": [
      "Réflexologie plantaire et faciale par Nadia Montmayeur"
    ],
    "nl": [
      "Voet- en gezichtsreflexologie door Nadia Montmayeur"
    ]
  },
