  "rdfs:comment": {
    "de": [
      "Der Club Nautique de Doussard mit Sitz im Hafen von Doussard am See von Annecy ist ein Segelverein, der seinen Mitgliedern das ganze Jahr über eine große Auswahl an Ausrüstung (Katamarane, Windsurfbretter, Kajaks, Paddles usw.) zur Verfügung stellt."
    ],
    "en": [
      "The Club Nautique de Doussard, based at the port of Doussard on Lake Annecy, is a sailing association offering its members a wide choice of equipment (catamarans, windsurfers, kayaks, paddles, etc.) all year round."
    ],
    "it": [
      "Il Club Nautique de Doussard, con sede nel porto di Doussard sul lago di Annecy, è un club velico che offre ai suoi membri un'ampia gamma di attrezzature (catamarani, windsurf, kayak, pagaie, ecc.) tutto l'anno."
    ],
    "fr": [
      "Le Club Nautique de Doussard, basé au port de Doussard sur le lac d’Annecy, est une association voile qui offre à ses membres la mise à disposition d’un large choix d’équipements (catamarans, planches à voile, kayaks, paddles…) tout au long de l’année."
    ],
    "es": [
      "El Club Nautique de Doussard, con sede en el puerto de Doussard, en el lago de Annecy, es un club náutico que ofrece a sus socios una amplia gama de equipos (catamaranes, windsurf, kayaks, remos, etc.) durante todo el año."
    ],
    "nl": [
      "De Club Nautique de Doussard, gevestigd in de haven van Doussard aan het meer van Annecy, is een zeilclub die haar leden het hele jaar door een ruim aanbod aan materiaal biedt (catamarans, windsurfers, kajaks, peddels, enz.)."
    ]
  },
  "rdfs:label": {
    "en": [
      "Provision of kayak/paddle board/surf board/catamaran/sailing dinghy - Club Nautique Doussard"
    ],
    "fr": [
      "Mise à disposition kayak / paddle / surf / catamaran / dériveur - Club Nautique Doussard"
    ]
  },
