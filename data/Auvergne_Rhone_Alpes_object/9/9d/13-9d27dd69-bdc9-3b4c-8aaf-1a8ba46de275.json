  "rdfs:comment": {
    "de": [
      "Willkommen bei Monster Burger, dem ultimativen Ziel für Burger-Liebhaber in Flaine! Jeder Burger wird mit sorgfältig ausgewählten Zutaten zubereitet, von handwerklich hergestellten Brötchen vom Bäcker bis hin zu hausgemachten Pommes frites."
    ],
    "en": [
      "Welcome to Monster Burger, the must-visit destination for burger lovers in Flaine! Each burger is prepared with meticulously chosen ingredients, from artisan breads from the baker to home-made fries."
    ],
    "it": [
      "Benvenuti da Monster Burger, la meta obbligata per gli amanti degli hamburger a Flaine! Ogni hamburger è preparato con ingredienti scelti con cura, dal pane artigianale del fornaio alle patatine fritte fatte in casa."
    ],
    "fr": [
      "Bienvenue chez Monster Burger, la destination incontournable pour les amateurs de burgers à Flaine ! Chaque burger est préparé avec des ingrédients minutieusement choisis, allant des pains artisanaux du boulanger aux frites faites maison."
    ],
    "nl": [
      "Welkom bij Monster Burger, de must-visit bestemming voor hamburgerliefhebbers in Flaine! Elke burger wordt bereid met zorgvuldig gekozen ingrediënten, van ambachtelijk brood van de bakker tot zelfgemaakte frietjes."
    ],
    "es": [
      "Bienvenido a Monster Burger, ¡el destino obligado para los amantes de las hamburguesas en Flaine! Cada hamburguesa se prepara con ingredientes meticulosamente seleccionados, desde panes artesanos del panadero hasta patatas fritas caseras."
    ]
  },
