  "rdfs:comment": {
    "de": [
      "Ayurv?Aidez-Vous ist eine gemütliche und individuelle Behandlungskabine im Herzen des alten Dorfes: Ayurvedische Behandlungen und Massagen, ganzheitliche Signatur-Massagen und Energiebehandlungen."
    ],
    "en": [
      "Ayurv'Aidez-Vous is a cosy, individual treatment room in the heart of the old village: Ayurvedic treatment and massage consultations, signature holistic massage and energy treatments."
    ],
    "it": [
      "Ayurv?Aidez-Vous è un'accogliente sala per trattamenti individuali nel cuore dell'antico villaggio: consulenze per trattamenti e massaggi ayurvedici, massaggi olistici d'autore e trattamenti energetici."
    ],
    "fr": [
      "Ayurv’Aidez-Vous, c'est une cabine de soin cosy et individuelle au cœur du vieux village : Consultations soins et massages ayurvédique, massage holistique signature et soins énergétiques."
    ],
    "es": [
      "Ayurv?Aidez-Vous es una acogedora sala de tratamientos individuales en el corazón del antiguo pueblo: consultas de tratamientos y masajes ayurvédicos, masajes holísticos de autor y tratamientos energéticos."
    ],
    "nl": [
      "Ayurv'Aidez-Vous is een gezellige, individuele behandelkamer in het hart van het oude dorp: Ayurvedische behandelingen en massageconsulten, kenmerkende holistische massage en energiebehandelingen."
    ]
  },
