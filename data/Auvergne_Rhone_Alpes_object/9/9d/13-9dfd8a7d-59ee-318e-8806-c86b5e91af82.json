  "rdfs:comment": {
    "de": [
      "GREEN KART empfängt Kinder ab 7 Jahren. Testen Sie Ihre Fahrkünste mit der Familie oder mit Freunden auf dieser 500 m langen überdachten Piste, die von der Präfektur des Departements Isère und der FFSA zugelassen ist."
    ],
    "en": [
      "GREEN KART  is accessible for children from 7 years old. Come and try your pilot skills in family or between friends, over this 500 metres-long indoor racetrack, whose norms are approved by the prefecture of Isère and the FFSA."
    ],
    "it": [
      "GREEN KART accoglie i bambini a partire dai 7 anni. Venite a testare le vostre abilità di guida con la famiglia o con gli amici su questa pista coperta di 500 metri approvata dalla prefettura dell'Isère e dalla FFSA."
    ],
    "fr": [
      "GREEN KART  accueille les enfants à partir de 7 ans. Venez tester vos talents de pilote en famille ou entre amis sur cette piste couverte de 500m homologuée par la préfecture de l’Isère et la FFSA."
    ],
    "nl": [
      "GREEN KART verwelkomt kinderen vanaf 7 jaar. Kom met uw gezin of vrienden uw rijvaardigheid testen op dit door de prefectuur Isère en de FFSA goedgekeurde overdekte circuit van 500 m."
    ],
    "es": [
      "GREEN KART acoge a niños a partir de 7 años. Ven a probar tus habilidades de conducción con la familia y los amigos en esta pista cubierta de 500 metros homologada por la Prefectura de Isère y la FFSA."
    ]
  },
