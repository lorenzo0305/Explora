  "rdfs:comment": {
    "de": [
      "Atout Pom ist eine 30 ha große Obstplantage am Fuße des Vuache, die von einem Boden mit einem speziellen Mikroklima profitiert. Wir arbeiten mit dem Konzept der integrierten Obstproduktion und biologischem Anbau und unterstützen so den Schutz der Natur."
    ],
    "en": [
      "Atout Pom has 75 acres of orchards on the slopes of the Vuache mountain and benefits from a specific microclimate. We favour natural protection for our crops, which are organic and are produced using integrated fruit production methods."
    ],
    "it": [
      "Atout Pom dispone di 30 ettari di frutteti incastonati tra le montagne di Vuache, beneficiando di un terroir con un microclima speciale. La produzione integrata di frutta e l'agricoltura biologica favoriscono la protezione della natura."
    ],
    "fr": [
      "Atout Pom c'est 30 ha de vergers adossés au Vuache, bénéficiant d'un terroir au microclimat particulier. En production fruitière intégrée et en agriculture biologique, nous favorisons la protection naturelle."
    ],
    "nl": [
      "Atout Pom is 30 hectare boomgaarden op de hellingen van de Vuache, met een bijzonder microklimaat. In de geïntegreerde fruitteelt en de biologische landbouw geven wij de voorkeur aan natuurlijke bescherming."
    ],
    "es": [
      "Atout Pom cuenta con 30 hectáreas de huertos situados frente a las montañas de Vuache, beneficiándose de un terruño con un microclima especial. Con la producción integrada de fruta y la agricultura ecológica, favorecemos la protección natural."
    ]
  },
