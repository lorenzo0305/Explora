  "rdfs:comment": {
    "de": [
      "Rund, eckig, herzförmig - Ellie-Marie Bourgeois personalisiert Kekse für jeden Anlass, ob privat oder geschäftlich, mit natürlichen Aromen, ohne Konservierungs- oder Farbstoffe."
    ],
    "en": [
      "Round, square, heart-shaped, Ellie-Marie Bourgeois customizes cookies for any event, private or professional, with natural flavors, no preservatives or colorants."
    ],
    "it": [
      "Rotondi, quadrati, a forma di cuore, Ellie-Marie Bourgeois personalizza i biscotti per qualsiasi evento, privato o professionale, con aromi naturali, senza conservanti né coloranti."
    ],
    "fr": [
      "Rond, carré, en forme de cœur, Ellie-Marie Bourgeois personnalise des biscuits pour tout événement, privé ou professionnel, avec des parfums naturels, sans conservateurs ni colorants."
    ],
    "nl": [
      "Rond, vierkant, hartvormig, Ellie-Marie Bourgeois maakt koekjes op maat voor elk evenement, privé of professioneel, met natuurlijke smaken, zonder bewaarmiddelen of kleurstoffen."
    ],
    "es": [
      "Redondas, cuadradas, en forma de corazón, Ellie-Marie Bourgeois personaliza las galletas para cualquier evento, privado o profesional, con sabores naturales, sin conservantes ni colorantes."
    ]
  },
