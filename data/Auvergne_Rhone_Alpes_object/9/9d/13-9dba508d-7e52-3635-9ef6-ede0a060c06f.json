  "rdfs:comment": {
    "de": [
      "Raffinierte französische Gourmetküche im Restaurant l'Orangerie du Château d'Origny. Ruhige Momente inmitten der Natur und mit Blick auf den Park. Lokale Produkte und Lieferanten. Menüs der Saison. 3 km vom Stadtzentrum entfernt. Parkplatz mit Ladesäulen"
    ],
    "en": [
      "Refined, gourmet French cuisine at the restaurant l'Orangerie du Château d'Origny. Moments of calm, nature and escape while admiring the view of the park. Local products and suppliers. Seasonal menus. 3 km from town center. Charging station parking"
    ],
    "it": [
      "Cucina francese raffinata e gourmet al ristorante l'Orangerie du Château d'Origny. Godetevi la pace e la tranquillità, la campagna e la vista sul parco. Prodotti e fornitori locali. Menù stagionali. a 3 km dal centro città. Parcheggio con punto di ricarica"
    ],
    "fr": [
      "Cuisine française raffinée, gastronomique du restaurant l'Orangerie du Château d'Origny. Moments de calme, pleine nature et évasion en admirant vue sur le parc. Produits et fournisseurs locaux. Menus de saison. 3 km centre ville. Parking bornes recharges"
    ],
    "nl": [
      "Verfijnde, gastronomische Franse gerechten in restaurant l'Orangerie du Château d'Origny. Geniet van de rust, het platteland en het uitzicht over het park. Lokale producten en leveranciers. Seizoensgebonden menu's. op 3 km van het stadscentrum. Oplaadpunt parkeerplaats"
    ],
    "es": [
      "Cocina francesa refinada y gastronómica en el restaurante l'Orangerie du Château d'Origny. Disfrute de la tranquilidad, el campo y las vistas al parque. Productos y proveedores locales. Menús de temporada. a 3 km del centro de la ciudad. Aparcamiento con punto de carga"
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'Orangerie du Château d'Origny"
    ]
  },
