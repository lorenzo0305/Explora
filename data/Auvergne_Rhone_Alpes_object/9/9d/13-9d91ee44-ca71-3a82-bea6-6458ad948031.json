  "rdfs:comment": {
    "de": [
      "Ein einzigartiger Moment, den Sie nicht verpassen sollten. Nach einer intensiven und inspirierenden Masterclass, die von Rémi Geniet geleitet wird, geben Ihnen die Teilnehmer die Früchte ihrer Arbeit wieder."
    ],
    "en": [
      "A unique moment not to be missed: after an intense and inspiring Masterclass led by Rémi Geniet, the participants present the fruits of their labor."
    ],
    "it": [
      "Dopo un'intensa e stimolante Masterclass guidata da Rémi Geniet, i partecipanti presenteranno i frutti del loro lavoro."
    ],
    "fr": [
      "Un moment unique à ne pas manquer, après une Masterclasse intense et inspirante dirigée par Rémi Geniet, les participants vous restituent le fruit de leur travail."
    ],
    "es": [
      "Tras una intensa e inspiradora clase magistral dirigida por Rémi Geniet, los participantes presentarán los frutos de su trabajo."
    ],
    "nl": [
      "Een uniek moment dat je niet mag missen: na een intense en inspirerende Masterclass onder leiding van Rémi Geniet zullen de deelnemers je de vruchten van hun werk laten zien."
    ]
  },
