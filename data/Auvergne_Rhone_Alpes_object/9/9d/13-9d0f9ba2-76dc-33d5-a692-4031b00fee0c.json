  "rdfs:comment": {
    "de": [
      "Le Wood ist eine gemütliche Snackbar in unmittelbarer Nähe der Pisten, wo Sie eine sonnige und ruhige Terrasse genießen können, die ideal für eine Pause in den Bergen ist. Einfache und leckere Küche für jeden Geschmack, zum Genießen vor Ort oder zum Mitnehmen."
    ],
    "en": [
      "Le Wood is a cosy snack bar just a stone's throw from the slopes, where you can enjoy a quiet, sunny terrace ideal for a break in the mountains. Simple, gourmet cuisine to suit all tastes, to eat in or take away."
    ],
    "it": [
      "Le Wood è un accogliente snack bar a due passi dalle piste, dove si può godere di una terrazza soleggiata e tranquilla, ideale per una pausa in montagna. Cucina semplice e gourmet per tutti i gusti, da mangiare o da portare via."
    ],
    "fr": [
      "Le Wood est un snack-bar chaleureux à deux pas des pistes où vous pourrez profiter d’une terrasse ensoleillée et calme, idéale pour une pause en montagne. Cuisine simple et gourmande pour tous les goûts, à déguster sur place ou à emporter."
    ],
    "nl": [
      "Le Wood is een gezellige snackbar op een steenworp afstand van de pistes, waar je kunt genieten van een rustig, zonnig terras, ideaal voor een pauze in de bergen. Eenvoudige, gastronomische keuken naar ieders smaak, om te eten of om mee te nemen."
    ],
    "es": [
      "Le Wood es un snack bar acogedor a dos pasos de las pistas, donde podrá disfrutar de una terraza soleada y tranquila, ideal para una escapada a la montaña. Cocina sencilla y gastronómica para todos los gustos, para comer en el restaurante o para llevar."
    ]
  },
  "rdfs:label": {
    "en": [
      "Snack Bar Le Wood"
    ],
    "fr": [
      "Snack Bar Le Wood"
    ],
    "nl": [
      "Snackbar Le Wood"
    ]
  },
