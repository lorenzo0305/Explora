  "rdfs:comment": {
    "de": [
      "Frédéric ist ein Bauer, der alte landwirtschaftliche Terrassen (\"échamps\") auf den Anhöhen des Dorfes Chalencon bewirtschaftet. Er bearbeitet kleine Flächen von Hand. Es wird biologischer Landbau betrieben. Direktverkauf."
    ],
    "en": [
      "Frédéric farms the narrow terraces (\"échamps\") up on the high ground around Chalencon village, using traditional, manual, agricultural methods. Organic farming. Direct sale."
    ],
    "it": [
      "Frédéric è un contadino che mantiene in vita le antiche terrazze agricole (\"échamps\") sulle alture del villaggio di Chalencon. Lavora manualmente su piccole aree. Agricoltura biologica. Vendita diretta."
    ],
    "fr": [
      "Frédéric est un paysan qui fait vivre de vieilles terrasses agricoles (\"échamps\") sur les hauteurs du village de Chalencon. Il travaille manuellement sur de petites surfaces. Agriculture biologique. Vente directe."
    ],
    "nl": [
      "Frédéric is een boer die de oude landbouwterrassen (\"échamps\") op de hoogten van het dorp Chalencon in leven houdt. Hij werkt handmatig aan kleine gebieden. Biologische landbouw. Directe verkoop."
    ],
    "es": [
      "Frédéric es un agricultor que mantiene vivas las antiguas terrazas agrícolas (\"échamps\") en las alturas del pueblo de Chalencon. Trabaja manualmente en áreas pequeñas. La agricultura ecológica. Venta directa."
    ]
  },
