  "rdfs:comment": {
    "de": [
      "Der Grill Côté Jardin bietet Ihnen Salate, Burger und Grillgerichte an. \r\n Das alles in einer grünen Umgebung, in ruhiger Lage und im Schatten eines hundertjährigen Walnussbaums auf einem Familiengut.\r\nSie können sich auch bei einer Partie Minigolf entspannen."
    ],
    "en": [
      "The Grill Côté Jardin offers salads, burgers, grilled meats...\n All in a green, peaceful setting in the shade of a hundred-year-old walnut tree on a family estate.\nYou can also relax with a game of mini golf."
    ],
    "it": [
      "Il Grill Côté Jardin serve insalate, hamburger e carni alla griglia?\r\n Il tutto in un ambiente verde e tranquillo, all'ombra di un noce centenario in una tenuta di famiglia.\r\nPotete anche rilassarvi con una partita a mini golf."
    ],
    "fr": [
      "Le Grill Côté Jardin vous propose des salades, des burgers, des grillades… \r\n Le tout dans un cadre de verdure, au calme et à l'ombre d'un noyer centenaire sur un domaine familial.\r\nVous pouvez également vous détendre avec une partie de mini golf."
    ],
    "nl": [
      "Grill Côté Jardin serveert salades, hamburgers en gegrild vlees?\r\n Alles in een groene, vredige omgeving in de schaduw van een honderd jaar oude walnotenboom op een familielandgoed.\r\nJe kunt ook ontspannen met een potje minigolf."
    ],
    "es": [
      "El Grill Côté Jardin sirve ensaladas, hamburguesas y carnes a la parrilla?\r\n Todo ello en un entorno verde y tranquilo, a la sombra de un nogal centenario en una finca familiar.\r\nTambién puede relajarse con una partida de minigolf."
    ]
  },
