          ],
          "additionalInformation": {
            "de": [
              "Besichtigung des Schlosses (nur geführte Besichtigungen)\r\nGanzjährig (außer Juli und August): jeden ersten Sonntag im Monat um 10.30 Uhr, mit Reservierung\r\nSommerferien: von Sonntag bis Donnerstag, Abfahrt um 15:00, 16:00 und 17:00 Uhr (dienstags um 15:00 Uhr sind Kinderführungen vorbehalten)"
            ],
            "en": [
              "Visit the Château (guided tours only)\r\nYear-round (except July and August): every first Sunday of the month at 10:30 am, by appointment only\r\nSummer vacations: Sunday to Thursday, departures at 3, 4 and 5 p.m. (Tuesdays at 3 p.m. are reserved for children's tours)"
            ],
            "it": [
              "Visita del castello (solo visite guidate)\r\nTutto l'anno (tranne luglio e agosto): ogni prima domenica del mese alle 10.30, su prenotazione\r\nVacanze estive: dalla domenica al giovedì, con partenze alle 15.00, 16.00 e 17.00 (il martedì alle 15.00 è riservato alle visite per bambini)"
            ],
            "fr": [
              "Visite du Château (visites guidées uniquement) \r\nToute l'année (hormis juillet et août) : chaque premier dimanche du mois à 10h30, sur réservation\r\nVacances d'été  : du dimanche au jeudi, départs à 15h, 16h et 17h (les mardis à 15h sont réservés aux visites enfants)"
            ],
            "es": [
              "Visita del castillo (sólo visitas guiadas)\r\nTodo el año (excepto julio y agosto): el primer domingo de cada mes a las 10.30 h, con cita previa\r\nVacaciones de verano: de domingo a jueves, salidas a las 15:00, 16:00 y 17:00 (los martes a las 15:00 están reservados a las visitas para niños)"
            ],
            "nl": [
              "Bezoek het kasteel (alleen rondleidingen)\r\nHet hele jaar door (behalve juli en augustus): elke eerste zondag van de maand om 10.30 uur, op afspraak\r\nZomervakantie: zondag tot donderdag, vertrek om 15u, 16u en 17u (dinsdag om 15u is gereserveerd voor kinderrondleidingen)"
            ]
          },
