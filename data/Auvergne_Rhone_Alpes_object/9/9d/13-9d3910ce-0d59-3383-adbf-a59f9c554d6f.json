  "rdfs:comment": {
    "de": [
      "Imbiss/Bar mit Terrasse am Ufer des Sees Grenouillère und des Wake Board-Bereichs.\r\nVor Ort oder zum Mitnehmen. Möglichkeit, den ganzen Tag über zu essen."
    ],
    "en": [
      "Snack bar with terrace on the edge of the Grenouillère lake and the Wake Board area. \r\nOn the spot or to take away. Possibility to eat all day long."
    ],
    "it": [
      "Snack bar con terrazza sulle rive del Lac de la Grenouillère e dell'area Wake Board.\r\nSul posto o da asporto. Possibilità di mangiare tutto il giorno."
    ],
    "fr": [
      "Snack/bar avec terrasse au bord du lac de la Grenouillère et de l'espace Wake Board. \r\nSur place ou à emporter. Possibilité de manger toute la journée."
    ],
    "nl": [
      "Snackbar met terras aan de oever van het Lac de la Grenouillère en het Wake Board gebied.\r\nTer plekke of om mee te nemen. De hele dag door dineren mogelijk."
    ],
    "es": [
      "Snack bar con terraza a orillas del lago de la Grenouillère y la zona de Wake Board.\r\nEn el lugar o para llevar. Posibilidad de comer todo el día."
    ]
  },
  "rdfs:label": {
