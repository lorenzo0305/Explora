  "rdfs:comment": {
    "de": [
      "In der mittelalterlichen Stadt empfängt Sie unsere Crêperie in einer herzlichen Atmosphäre, in der Sie hausgemachte herzhafte Galettes und süße Crêpes genießen können. Ein Erlebnis, das Sie sich nicht entgehen lassen sollten."
    ],
    "en": [
      "In the medieval city, our crêperie welcomes you in a warm atmosphere to enjoy home-made savory galettes and sweet crêpes. An experience not to be missed."
    ],
    "it": [
      "Nel centro medievale della città, la nostra crêperie vi accoglie in un'atmosfera calda per gustare galette salate e crêpes dolci fatte in casa. Un'esperienza da non perdere."
    ],
    "fr": [
      "Dans la cité médiévale, notre crêperie vous accueille dans une ambiance chaleureuse pour savourer des galettes salées et crêpes sucrées, faites maison. Une expérience à ne pas manquer."
    ],
    "nl": [
      "In het middeleeuwse stadscentrum verwelkomt onze crêperie je in een warme sfeer om te genieten van huisgemaakte hartige galettes en zoete crêpes. Een ervaring die je niet mag missen."
    ],
    "es": [
      "En el centro de la ciudad medieval, nuestra crepería le da la bienvenida en un ambiente cálido para disfrutar de galettes saladas caseras y crepes dulces. Una experiencia que no debe perderse."
    ]
  },
  "rdfs:label": {
