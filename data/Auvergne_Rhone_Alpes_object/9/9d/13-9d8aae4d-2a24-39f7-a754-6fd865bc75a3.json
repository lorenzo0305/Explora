  "rdfs:comment": {
    "de": [
      "Der FC Paulhaguet organisiert ein Essen im Festsaal mit Aligot - Würstchen und der Übertragung des 6-Nationen-Turniers (Frankreich/England). Reservierung spätestens bis zum 8. März unter 06 59 51 81 17."
    ],
    "en": [
      "Meal organized by FC Paulhaguet at the Salle des Fêtes, with a menu of aligot and sausages, and broadcast of the 6 Nations tournament (France/England). Reservations by March 8 at 06 59 51 81 17."
    ],
    "it": [
      "Pranzo organizzato dal FC Paulhaguet presso la Salle des Fêtes, con menù a base di aligot e salsicce e trasmissione del torneo 6 Nazioni (Francia-Inghilterra). Le prenotazioni devono essere effettuate entro l'8 marzo, chiamando il numero 06 59 51 81 17."
    ],
    "fr": [
      "Repas organisé par le FC Paulhaguet à la salle des fêtes avec au menu aligot - saucisses et retransmission du tournoi des 6 Nations (France/Angleterre) . Réservation à plus tard avant le 8 mars au 06 59 51 81 17."
    ],
    "nl": [
      "Maaltijd georganiseerd door FC Paulhaguet in de Salle des Fêtes, met een menu van aligot en worstjes en uitzending van het 6 Nations toernooi (Frankrijk/Engeland). Reserveringen moeten uiterlijk 8 maart worden gemaakt door te bellen naar 06 59 51 81 17."
    ],
    "es": [
      "Comida organizada por el FC Paulhaguet en la Salle des Fêtes, con menú de aligot y salchichas y retransmisión del torneo 6 Naciones (Francia/Inglaterra). Las reservas deben hacerse antes del 8 de marzo llamando al 06 59 51 81 17."
    ]
  },
