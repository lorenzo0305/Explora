  "rdfs:comment": {
    "de": [
      "In unserem Atelier stellen wir künstlerische Werke aus Bronze her, wobei wir die Technik des Wachsausschmelzverfahrens anwenden, um Stücke von zeitloser Schönheit zum Leben zu erwecken."
    ],
    "en": [
      "In our workshop we create artistic bronze works, using the lost-wax technique to give life to pieces of timeless beauty."
    ],
    "it": [
      "Nel nostro laboratorio creiamo opere artistiche in bronzo, utilizzando la tecnica della cera persa per dare vita a pezzi di una bellezza senza tempo."
    ],
    "fr": [
      "Dans notre atelier nous créons des œuvres artistique en bronze, utilisant la technique de la cire perdue pour donner vie à des pièces d’une beauté intemporelle."
    ],
    "nl": [
      "In ons atelier creëren we artistieke werken in brons, waarbij we de verloren wastechniek gebruiken om stukken van tijdloze schoonheid tot leven te wekken."
    ],
    "es": [
      "En nuestro taller creamos obras artísticas en bronce, utilizando la técnica de la cera perdida para dar vida a piezas de belleza intemporal."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Adobati fondeur - Fonderie dart"
    ]
  },
