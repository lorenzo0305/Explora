  "rdfs:comment": {
    "de": [
      "Les bêtes de Céline, das ist zunächst die Geschichte einer Mutter, die Stoffe, Knöpfe und Kordeln sammelte, zusammenfügte und Tiere für ihre Kinder herstellte. Im Laufe der Zeit entstanden im Atelier Accessoires, Taschen und Schals."
    ],
    "en": [
      "Les bêtes de Céline started out as the story of a mother who gathered fabrics, buttons, cords... and made animals for her children. Over time, accessories, bags and scarves took their place in the workshop."
    ],
    "it": [
      "Les bêtes de Céline nasce come storia di una madre che raccoglieva e assemblava tessuti, bottoni e corde per creare animali per i suoi figli. Con il tempo, accessori, borse e sciarpe hanno preso posto nel laboratorio."
    ],
    "fr": [
      "Les bêtes de Céline, c'est au départ une histoire de maman récupérant, assemblant tissus, boutons, cordons... et confectionnant des animaux pour ses enfants. Au fil du temps, les accessoires, sacs, écharpes ont pris place à l'atelier."
    ],
    "es": [
      "Les bêtes de Céline empezó como la historia de una madre que coleccionaba y ensamblaba telas, botones y cordones para hacer animales para sus hijos. Con el tiempo, accesorios, bolsos y bufandas ocuparon su lugar en el taller."
    ],
    "nl": [
      "Les bêtes de Céline begon als het verhaal van een moeder die stoffen, knopen en koorden verzamelde en samenvoegde om dieren voor haar kinderen te maken. Na verloop van tijd namen accessoires, tassen en sjaals hun plaats in het atelier in."
    ]
  },
  "rdfs:label": {
