  "rdfs:comment": {
    "de": [
      "In seiner Werkstatt arbeitet Stéphane mit Leder. Er hat sich vor kurzem in Mayres niedergelassen und wird dieses Jahr auf mehreren Märkten in der Gegend vertreten sein."
    ],
    "en": [
      "Stéphane works with leather in his workshop. Recently settled in Mayres, this year he will be present at several local markets."
    ],
    "it": [
      "Stéphane lavora il cuoio nel suo laboratorio. Trasferitosi di recente a Mayres, quest'anno esporrà in diversi mercati locali."
    ],
    "fr": [
      "Dans son atelier, Stéphane travaille le cuir. Récemment installé à Mayres, cette année, il sera présent sur plusieurs marchés du secteur."
    ],
    "nl": [
      "Stéphane werkt met leer in zijn atelier. Hij is onlangs naar Mayres verhuisd en zal dit jaar op een aantal lokale markten exposeren."
    ],
    "es": [
      "Stéphane trabaja el cuero en su taller. Tras mudarse recientemente a Mayres, este año expondrá en varios mercados locales."
    ]
  },
