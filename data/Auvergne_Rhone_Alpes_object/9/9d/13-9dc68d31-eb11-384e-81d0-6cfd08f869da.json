  "rdfs:comment": {
    "de": [
      "Produktion von Beerenfrüchten (Himbeeren, Erdbeeren, Johannisbeeren, Cassis), Kastanien AOP d'Ardèche, Mandeln und Nüssen. Landwirtschaft mit AB-Zertifizierung. Honig aus unseren Bienenstöcken. Entdecken Sie die verarbeiteten Köstlichkeiten: Konfitüren und Fruchtsäfte."
    ],
    "en": [
      "Cultivation of small red fruits (raspberries, strawberries, redcurrants, blackcurrants), chestnuts, and walnuts, including Ardèche PDO chestnuts. Certified organic for chestnuts, raspberries, and walnuts. Discover transformed delights: jams & juices."
    ],
    "it": [
      "Produzione di frutti rossi (lamponi, fragole, ribes, ribes nero), castagne d'Ardèche DOP, mandorle e noci. Agricoltura certificata AB. Miele proveniente dai nostri alveari. Scoprite le nostre delizie lavorate: marmellate e succhi di frutta."
    ],
    "fr": [
      "Production de petits fruits rouges (framboises, fraises, groseilles, cassis), de châtaignes AOP d'Ardèche, d'amandes et de noix. Agriculture certifiée AB. Miel de nos ruches. Découvrez les délices transformés : confitures et jus de fruits."
    ],
    "nl": [
      "Teelt van rode vruchten (frambozen, aardbeien, rode & zwarte bessen), kastanjes en noten, incl. AOP Ardèche-kastanjes. Biologisch gecertificeerd voor productie van kastanjes, frambozen en noten. Ontdek onze jams en sappen."
    ],
    "es": [
      "Producción de bayas rojas (frambuesas, fresas, grosellas rojas, grosellas negras), castañas DOP Ardèche, almendras y nueces. Agricultura certificada AB. Miel de nuestras propias colmenas. Descubra nuestras delicias transformadas: mermeladas y zumos de frutas."
    ]
  },
