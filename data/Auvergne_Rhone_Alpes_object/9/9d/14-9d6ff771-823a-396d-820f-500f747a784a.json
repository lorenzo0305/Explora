  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/3f83f244-4c8f-3ace-b371-f24d3f0d9809",
      "dc:description": {
        "de": [
          "Diese 15-minütigen Kurzkonzerte entführen Sie in ferne musikalische Gefilde. Exilierte Komponisten, unter außergewöhnlichen Bedingungen geschriebene Werke, von der Politik bis zum Wahnsinn - hier findet die Ausgrenzung ihre Partiturblüte."
        ],
        "en": [
          "These short, fifteen-minute concerts take you on a journey to faraway musical lands. Exiled composers, works written under exceptional conditions, from politics to madness, exclusion finds here its anthology of scores."
        ],
        "it": [
          "Questi brevi concerti di quindici minuti vi porteranno in un viaggio musicale in terre lontane. Compositori in esilio, opere scritte in condizioni eccezionali, dalla politica alla follia, l'esclusione trova qui la sua antologia di partiture."
        ],
        "fr": [
          "Ces concerts courts de quinze minutes vous font voyager dans des contrées musicales lointaines. Compositeurs exilés, œuvres écrites dans des conditions exceptionnelles, de la politique à la folie, l’exclusion trouve ici son florilège de partitions."
        ],
        "es": [
          "Estos breves conciertos de quince minutos le llevarán en un viaje musical a tierras lejanas. Compositores en el exilio, obras escritas en condiciones excepcionales, de la política a la locura, la exclusión encuentra aquí su antología de partituras."
        ],
        "nl": [
          "Deze korte concerten van vijftien minuten nemen je mee op een muzikale reis naar verre landen. Componisten in ballingschap, werken geschreven onder uitzonderlijke omstandigheden, van politiek tot waanzin, uitsluiting vindt hier zijn bloemlezing van partituren."
        ]
      },
