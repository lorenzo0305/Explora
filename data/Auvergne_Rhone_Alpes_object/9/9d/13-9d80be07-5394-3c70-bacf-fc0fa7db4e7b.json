  "rdfs:comment": {
    "de": [
      "Der Sport- und Kulturverein Amicale Sportive et Culturelle de Saint Julien belebt das Dorf mit Boule- und Coinche-Wettbewerben. Der Verein hat auch das Ziel, die zur Verfügung gestellten Grundstücke zu pflegen, am Gemeindeleben teilzunehmen und mit der Gemeindeverwaltung zusammenzuarbeiten"
    ],
    "en": [
      "The Amicale Sportive et Culturelle de Saint Julien livens up the village with boules and coinches competitions. The association also aims to maintain the playing fields and participate in the life of the commune in collaboration with the town council"
    ],
    "it": [
      "L'Amicale Sportive et Culturelle de Saint Julien anima il villaggio con gare di bocce e coinches. Gli altri obiettivi dell'associazione sono la manutenzione dei campi da gioco e la partecipazione alla vita del villaggio in collaborazione con il municipio"
    ],
    "fr": [
      "L'Amicale Sportive et Culturelle de Saint Julien anime le village avec des concours de boules et de coinches. L'association a aussi pour objectif d'entretenir les terrains mis à disposition, participer a la vie de la commune en collaborant avec la mairie"
    ],
    "es": [
      "La Amicale Sportive et Culturelle de Saint Julien anima el pueblo con competiciones de petanca y coinches. Además, la asociación se encarga del mantenimiento de los terrenos de juego y participa en la vida del pueblo colaborando con el ayuntamiento"
    ],
    "nl": [
      "De Amicale Sportive et Culturelle de Saint Julien verlevendigt het dorp met jeu de boules en coinches wedstrijden. Andere doelen van de vereniging zijn het onderhouden van de speelvelden en deelnemen aan het dorpsleven door samen te werken met het gemeentehuis"
    ]
  },
