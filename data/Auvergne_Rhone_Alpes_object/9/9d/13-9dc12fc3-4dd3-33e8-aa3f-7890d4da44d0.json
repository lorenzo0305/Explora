  "rdfs:comment": {
    "de": [
      "Exklusives Angebot ! Ein Flug über die Landschaften der Auvergne im Ultraleichtflugzeug!\r\nGönnen Sie sich einen unvergesslichen Moment in einem Ultraleichtflugzeug mit Paramotor/Hängegleiter. Volc?Envol bietet Ihnen atemberaubende Lufttaufen an!"
    ],
    "en": [
      "Exclusive! Fly over the Auvergne countryside in a microlight!\r\nTreat yourself to an unforgettable experience in a paramotor/pendulum microlight. Volc'Envol offers first flights and ultralight pilot training."
    ],
    "it": [
      "Esclusivo! Sorvolate la campagna dell'Alvernia in ultraleggero!\r\nRegalatevi un'esperienza indimenticabile a bordo di un ultraleggero paramotore/pendolo. Volc'Envol vi offre primi voli mozzafiato!"
    ],
    "fr": [
      "Exclusif ! Le survol des paysages Auvergnat en ULM !\r\nOffrez-vous un moment inoubliable en ULM paramoteur/Pendulaire. Volc’Envol vous propose des baptêmes de l'air époustouflants !!!"
    ],
    "nl": [
      "Exclusief! Vlieg over het platteland van de Auvergne in een microlight!\r\nTrakteer jezelf op een onvergetelijke ervaring in een paramotor/slinger microlight. Volc'Envol biedt u adembenemende eerste vluchten!"
    ],
    "es": [
      "En exclusiva Sobrevuele la campiña de Auvernia en ultraligero\r\nRegálese una experiencia inolvidable en un ultraligero paramotor/pendular. Volc'Envol le ofrece impresionantes primeros vuelos"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Volc'Envol ULM"
    ]
  },
