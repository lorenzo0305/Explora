  "rdfs:comment": {
    "de": [
      "Eine zeitgenössische, neue Küche mit dem einzigen Ziel, Freude zu bereiten und zu teilen. Diese von Reisen inspirierte Küche voller Nuancen und Aromen bewahrt die Grundlagen der französischen Gastronomie."
    ],
    "en": [
      "A contemporary, new cuisine with the sole aim of pleasing and sharing. Inspired by travels, this cuisine is full of nuances and flavors, while retaining the basics of French gastronomy."
    ],
    "it": [
      "Una cucina contemporanea e nuova con l'unico obiettivo di piacere e condividere. Ispirata dai viaggi, questa cucina, ricca di sfumature e sapori, mantiene le basi della gastronomia francese."
    ],
    "fr": [
      "Une cuisine contemporaine, nouvelle avec pour seul objectif faire plaisir et partager. Inspirée de voyages, cette cuisine toute en nuances et saveurs sait garder les bases de la gastronomie française."
    ],
    "es": [
      "Una cocina contemporánea y nueva con el único objetivo de agradar y compartir. Inspirada en los viajes, esta cocina, llena de matices y sabores, mantiene los fundamentos de la gastronomía francesa."
    ],
    "nl": [
      "Een eigentijdse, nieuwe keuken met als enige doel te plezieren en te delen. Deze keuken is geïnspireerd door reizen en zit vol nuances en smaken, terwijl de basis van de Franse gastronomie behouden blijft."
    ]
  },
