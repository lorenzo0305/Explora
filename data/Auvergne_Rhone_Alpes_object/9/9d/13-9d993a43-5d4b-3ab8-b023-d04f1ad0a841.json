  "rdfs:comment": {
    "de": [
      "Entdecken Sie den See von Champagnac-Le-Vieux ein 3,5 ha großes Gebiet inmitten der Natur mit einem bewachten Badeplatz. Der Strand trägt das Label Pavillon Bleu für einen Moment mit der Familie oder mit Freunden mit seinen verschiedenen Aktivitäten und Dienstleistungen."
    ],
    "en": [
      "Discover the Champagnac-Le-Vieux lake, a 3.5-hectare area in the heart of nature, with supervised swimming. The beach has been awarded the \"Pavillon Bleu\" label, and offers a wide range of activities and services for families and friends."
    ],
    "it": [
      "Scoprite il lago di Champagnac-Le-Vieux, un'area di 3,5 ettari di campagna incontaminata con un'area balneare sorvegliata. La spiaggia è stata premiata con la Bandiera Blu per le attività e i servizi dedicati alle famiglie e agli amici."
    ],
    "fr": [
      "Découvrez le plan d'eau de Champagnac-Le-Vieux un espace de 3,5 ha en pleine nature avec sa baignade surveillée, la plage est labellisée Pavillon Bleu pour un moment en famille ou entre amis avec ses différentes activités et services."
    ],
    "nl": [
      "Ontdek het meer van Champagnac-Le-Vieux, een ongerept natuurgebied van 3,5 hectare met een bewaakt zwemgedeelte. Het strand is bekroond met de Blauwe Vlag voor activiteiten en diensten voor familie en vrienden."
    ],
    "es": [
      "Descubra el lago de Champagnac-Le-Vieux, un espacio natural de 3,5 hectáreas con zona de baño vigilada. La playa ha sido galardonada con la Bandera Azul por sus actividades y servicios para familias y amigos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Baignade surveillée à Champagnac-Le-Vieux"
    ]
  },
