  "rdfs:comment": {
    "de": [
      "Elsa Ohana, eine Graveurin und Inhaberin der Staatsprüfung „Agrégation“ in der Kunst, übt zeitgenössische Kunst und Gravur aus. Reisenderin, ausgebildet und von Tintenflecken fasziniert, sie studierte an der Schule für Kunst und Design in Valence."
    ],
    "en": [
      "Engraver and holder of an agrégation of arts, Elsa Ohana practices contemporary art and engraving. Traveller, trained, and fascinated by ink stains, she went to the art and design school in Valence."
    ],
    "it": [
      "Elsa Ohana, laureata in arti plastiche, pratica il disegno contemporaneo e la stampa. Viaggiatrice di formazione e affascinata dalle macchie d'inchiostro, si è formata presso i laboratori ESAD di Valence."
    ],
    "fr": [
      "Artiste graveuse et agrégée d'Arts plastiques, Elsa Ohana pratique le dessin contemporain et la gravure. Voyageuse, de formation et fascinée par les taches d'encres, elle se forma aux ateliers de l'ESAD à Valence."
    ],
    "nl": [
      "Elsa Ohana is graficus en afgestudeerd in plastische kunsten. Ze beoefent hedendaagse tekenkunst en grafiek. Als reizigster van opleiding en gefascineerd door inktvlekken, volgde ze een opleiding aan de ESAD-ateliers in Valence."
    ],
    "es": [
      "Elsa Ohana es grabadora y licenciada en artes plásticas. Practica el dibujo y el grabado contemporáneos. Viajera de formación y fascinada por las manchas de tinta, se formó en los talleres de la ESAD en Valence."
    ]
  },
