  "rdfs:comment": {
    "de": [
      "La Luge ist ein unumgänglicher Ort in Val d'Isère, um Spezialitäten aus Savoyen zu genießen,\r\ndie in einem gemütlichen und authentischen Altholzrahmen serviert werden."
    ],
    "en": [
      "La Luge is a must-see place in Val d'Isère to enjoy Savoyard specialities, \r\nserved in a warm and authentic old-wood setting."
    ],
    "it": [
      "Lo slittino è un luogo imperdibile in Val d'Isère per gustare le specialità savoiarde, \r\nservito in un ambiente caldo e autentico in legno antico."
    ],
    "fr": [
      "La Luge est un lieu incontournable à Val d’Isère pour déguster des spécialités savoyardes, \r\nservies dans un cadre vieux-bois, chaleureux et authentique."
    ],
    "nl": [
      "La Luge is dé plek in Val d'Isère voor Savoyaardse specialiteiten,\r\ngeserveerd in een warme en authentieke omgeving van oud hout."
    ],
    "es": [
      "En Val d'Isère, La Luge es el lugar ideal para degustar las especialidades de Saboya,\r\nservidas en un ambiente cálido y auténtico de madera antigua."
    ]
  },
