  "rdfs:comment": {
    "de": [
      "200 m² großer Veranstaltungsraum \"La Grande Étable\", der früher als Kuhstall, Pferdestall und Schweinestall diente und nun in einen Veranstaltungsraum umgewandelt wurde."
    ],
    "en": [
      "La Grande Étable\" reception hall, 200 m², once used as a cow shed, horse stable and pigsty, now transformed into an event space."
    ],
    "it": [
      "La sala funzioni \"La Grande Étable\", di 200 m², un tempo adibita a stalla delle mucche, stalla dei cavalli e porcile, è stata trasformata in uno spazio per eventi."
    ],
    "fr": [
      "Salle de réception \" La Grande Étable\" de 200 m², servant autrefois d'étable à vaches, d'écurie à chevaux et de porcherie transformée en espace événementiel."
    ],
    "es": [
      "El salón de actos \"La Grande Étable\", de 200 m², antiguamente utilizado como cobertizo para vacas, establo de caballos y pocilga, se ha reconvertido en un lugar para eventos."
    ],
    "nl": [
      "De 200 m² grote feestzaal \"La Grande Étable\", die vroeger werd gebruikt als koeienstal, paardenstal en varkensstal, is omgebouwd tot evenementenlocatie."
    ]
  },
