  "rdfs:comment": {
    "de": [
      "Florence und Geoffroy sind Beaujolais-Winzer, die biologischen und biodynamischen Landbau betreiben. Sie begrüßen Sie zur Verkostung ihrer Weine, die ihren Granitboden zum Ausdruck bringen, und bieten Spaziergänge für Gruppen auf dem Weingut an."
    ],
    "en": [
      "Florence et Geoffroy, Beaujolais wine producers who are currently completing the changeover to organic, welcome you to taste their wines and for group walks on the \"domaine\" and in the Pays des Pierres Dorées."
    ],
    "it": [
      "Florence e Geoffroy, viticoltori del Beaujolais, praticano un'agricoltura biologica e biodinamica. Vi accoglieranno per degustare i loro vini, che esprimono il loro terroir granitico, e offriranno visite di gruppo alla tenuta."
    ],
    "fr": [
      "Florence et Geoffroy, vignerons beaujolais, pratiquent l'agriculture bio et la biodynamie. Ils vous accueillent pour déguster leurs vins qui expriment leur terroir granitique, et proposent des balades pour groupes sur le domaine."
    ],
    "es": [
      "Florence y Geoffroy, viticultores de Beaujolais, practican la agricultura ecológica y biodinámica. Le invitan a degustar sus vinos, que expresan su terruño de granito, y ofrecen visitas en grupo a la finca."
    ],
    "nl": [
      "Florence en Geoffroy, wijnbouwers uit de Beaujolais, passen biologische en biodynamische landbouw toe. Ze verwelkomen u om hun wijnen te proeven, die hun granieten terroir tot uitdrukking brengen, en bieden groepsrondleidingen over het landgoed."
    ]
  },
  "rdfs:label": {
