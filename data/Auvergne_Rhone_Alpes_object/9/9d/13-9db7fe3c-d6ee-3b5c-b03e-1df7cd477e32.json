  "rdfs:comment": {
    "de": [
      "Die Piste befindet sich in Pré la Joux, inmitten von Fichtenwäldern... Ihr Vergnügen beginnt schon beim Aufstieg, den Sie dank eines integrierten Lifts bewältigen können."
    ],
    "en": [
      "Set among the spruce trees at Pré la Joux, the fun starts as soon as you begin the ascent in the built-in lift."
    ],
    "it": [
      "La pista si trova a Pré la Joux, in mezzo agli abeti rossi... Il vostro piacere inizia con la salita, resa possibile da un impianto di risalita integrato."
    ],
    "fr": [
      "La piste est située à Pré la Joux, au milieu des épicéas... Votre plaisir commence dès la montée qui s’effectue grâce à une remontée mécanique intégrée."
    ],
    "es": [
      "La pista está situada en Pré la Joux, en medio de abetos... Su placer comienza con el ascenso, que es posible gracias a un remonte integrado."
    ],
    "nl": [
      "De baan bevindt zich bij Pré la Joux, tussen de sparren. Het plezier begint al bij het ritje met de ingebouwde sleeplift."
    ]
  },
  "rdfs:label": {
