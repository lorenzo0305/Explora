  "rdfs:comment": {
    "de": [
      "Die Comédie de Grenoble empfängt Sie jeden Abend von Mittwoch bis Sonntag. Entdecken Sie köstliche Komödien in einer geselligen Atmosphäre."
    ],
    "en": [
      "The Comédie de Grenoble welcomes you every evenings, from Tuesday to Sunday. Come and discover delighful comedies in a friendly atmosphere ! You will also find there performances for children aged of 1 or more !"
    ],
    "it": [
      "La Comédie de Grenoble vi accoglie ogni sera dal mercoledì alla domenica. Venite a scoprire commedie gustose in un'atmosfera amichevole."
    ],
    "fr": [
      "La Comédie de Grenoble vous accueille tous les soirs du mercredi au dimanche. Venez découvrir des comédies savoureuses dans une ambiance conviviale."
    ],
    "es": [
      "La Comédie de Grenoble le da la bienvenida todas las noches de miércoles a domingo. Venga a descubrir sabrosas comedias en un ambiente agradable."
    ],
    "nl": [
      "De Comédie de Grenoble ontvangt u elke avond van woensdag tot zondag. Kom lekkere komedies ontdekken in een gezellige sfeer."
    ]
  },
