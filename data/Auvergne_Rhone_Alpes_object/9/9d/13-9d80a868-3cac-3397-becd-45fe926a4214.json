  "rdfs:comment": {
    "de": [
      "Von Albiez-Montrond aus können Sie auf einer wenig bekannten Route in Richtung der Aiguilles d'Arves aufbrechen. Auf dem Plateau von Montrond angekommen, bietet sich Ihnen ein atemberaubender Blick auf das Tal und die Aiguilles."
    ],
    "en": [
      "Leaving Albiez-Montrond, head for the Aiguilles d'Arves via a little-known itinerary. Once on the Montrond plateau, the view over the valley and the Aiguilles is breathtaking."
    ],
    "it": [
      "Partendo da Albiez-Montrond, ci si dirige verso le Aiguilles d'Arves lungo un percorso poco conosciuto. Una volta raggiunto l'altopiano di Montrond, la vista sulla valle e sulle Aiguilles è mozzafiato."
    ],
    "fr": [
      "Au départ d'Albiez-Montrond, partez en direction des Aiguilles d'Arves par un itinéraire peu connu. Arrivé sur la plateau de Montrond la vue sur la vallée et les Aiguilles est imprenable."
    ],
    "nl": [
      "Verlaat Albiez-Montrond en rijd langs een weinig bekende route naar de Aiguilles d'Arves. Zodra je het plateau van Montrond bereikt, is het uitzicht over de vallei en de Aiguilles adembenemend."
    ],
    "es": [
      "Saliendo de Albiez-Montrond, diríjase a las Aiguilles d'Arves por una ruta poco conocida. Una vez alcanzada la meseta de Montrond, la vista sobre el valle y las Aiguilles es impresionante."
    ]
  },
  "rdfs:label": {
    "en": [
      "Ascent to the foot of the Aiguilles d'Arves"
    ],
    "fr": [
      "Montée au Pied des Aiguilles d'Arves"
    ]
  },
