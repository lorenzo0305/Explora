  "rdfs:comment": {
    "de": [
      "Eröffnungsabend des Montlu Comedy Festivals!\r\nDas Versprechen eines festlichen und musikalischen Abends mit dem unglaublichen Didier Super!\r\nBegleitet von seiner Rockband und seinen Sängerinnen wird dieser Abend die Feierlichkeiten auf die schönste Art und Weise einleiten!"
    ],
    "en": [
      "Opening night of the Montlu Comedy Festival!\r\nThe promise of a festive, musical evening with the incredible Didier Super!\r\nAccompanied by his rock band and his female singers, this evening will kick off the festivities in the best possible way!"
    ],
    "it": [
      "Serata di apertura del Montlu Comedy Festival!\r\nLa promessa di una serata festosa e musicale con l'incredibile Didier Super!\r\nAccompagnato dalla sua rock band e dalle sue cantanti, questa serata darà il via ai festeggiamenti nel migliore dei modi!"
    ],
    "fr": [
      "Soirée d'ouverture du Montlu Comedy Festival ! \r\nLa promesse d'une soirée festive et musicale avec l'incroyable Didier Super ! \r\nAccompagné de son groupe de rock et de ses chanteuses, cette soirée lancera les festivités de la plus belle des manières !"
    ],
    "es": [
      "¡Noche inaugural del Festival de Comedia de Montlu!\r\n¡La promesa de una velada festiva y musical con el increíble Didier Super!\r\nAcompañado por su banda de rock y sus cantantes femeninas, esta velada dará el pistoletazo de salida a las fiestas de la mejor manera posible"
    ],
    "nl": [
      "Openingsavond van het Montlu Comedy Festival!\r\nDe belofte van een feestelijke en muzikale avond met de ongelooflijke Didier Super!\r\nBegeleid door zijn rockband en zijn zangeressen zal deze avond de feestelijkheden op de best mogelijke manier aftrappen!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Montlu Comedy Festival 2026 : Soirée d'ouverture"
    ]
  },
