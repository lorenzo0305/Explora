  "rdfs:comment": {
    "de": [
      "Jeden zweiten Freitag im Monat bietet Ihnen das Samsonnet einen Karaoke-Abend an. Sind Sie bereit, Ihre Stimme zu erheben?"
    ],
    "en": [
      "On the second Friday of every month, Samsonnet organizes a karaoke evening. Ready to sing along?"
    ],
    "it": [
      "Il secondo venerdì di ogni mese, Samsonnet vi invita a una serata di karaoke. Siete pronti a cantare?"
    ],
    "fr": [
      "Le second vendredi de chaque mois, le Samsonnet vous propose une soirée karaoké. Prêt à pousser la chansonnette?"
    ],
    "nl": [
      "Elke tweede vrijdag van de maand nodigt Samsonnet je uit voor een karaokeavond. Klaar om mee te zingen?"
    ],
