  "rdfs:comment": {
    "de": [
      "Durch ihre unverfälschte Schönheit ist die Bucht von Talloires eine Art Spiegel der Freiheit und der überragenden Qualität, die dem Chefkoch Jean Sulpice so am Herzen liegen."
    ],
    "en": [
      "With its purity, the Bay of Talloires is a kind of mirror of the freedom and excellence that are so dear to Chef Jean Sulpice."
    ],
    "it": [
      "Grazie alla sua purezza, la baia di Talloires riflette la libertà e l'eccellenza care allo chef Jean Sulpice."
    ],
    "fr": [
      "Par sa pureté, la baie de Talloires est une sorte de miroir de la liberté et de l'excellence chères au chef Jean Sulpice."
    ],
    "es": [
      "Por su pureza, la bahía de Talloires es una especie de espejo de la libertad y la excelencia apreciadas por el chef Jean Sulpice."
    ],
    "nl": [
      "De vredige baai van Talloires weerspiegelt de kostbare vrijheid en perfectie van chef-kok Jean Sulpice."
    ]
  },
