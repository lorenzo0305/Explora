  "rdfs:comment": {
    "de": [
      "Gesicherte und angelegte Schlittenpiste \"Rosay\", an der Bergstation der Gondelbahn \"Rosay\" in Le Grand-Bornand Chinaillon."
    ],
    "en": [
      "Sledging area Le Rosay (2600 m2) at the top of the gondola,\r\nat the heart of the beginners' area."
    ],
    "it": [
      "Una pista da slittino di 2600 m2, ristrutturata e messa in sicurezza nel cuore dell'area per principianti in cima alla funivia del Rosay, accessibile dal villaggio di Le Grand-Bornand."
    ],
    "fr": [
      "Piste de luge de 2600 m2 réaménagée et sécurisée au cœur de l'espace débutant au sommet de la télécabine du Rosay, accessible depuis Le Grand-Bornand Village."
    ],
    "es": [
      "Una pista de trineo de 2600 m2, reformada y asegurada en el corazón de la zona de principiantes en la parte superior del teleférico de Rosay, accesible desde Le Grand-Bornand Village."
    ],
    "nl": [
      "Een gerenoveerde en beveiligde rodelbaan van 2600 m2 in het hart van het beginnersgebied bovenaan de Rosay-kabelbaan, bereikbaar vanuit Le Grand-Bornand Village."
    ]
  },
  "rdfs:label": {
