  "rdfs:comment": {
    "de": [
      "Angenehmer Rahmen - Herzlicher und freundlicher Empfang - Gepflegter Tischservice - Vielfältige Auswahl an Qualitätsprodukten (Fleisch, Fisch, Pizzen, große Salate, Eis, gute Weinkarte)."
    ],
    "en": [
      "Brasserie. \r\nPleasant setting. Warm and convivial welcome.\r\nQuality of service. \r\nStarter buffet and wide choice of meat, fish, pizzas, mixed salads and ice-creams. Fine selection of wines. English spoken."
    ],
    "it": [
      "Ambiente piacevole - Accoglienza calorosa e cordiale - Servizio al tavolo accurato - Scelta varia di prodotti di qualità (carne, pesce, pizze, insalatone, gelati, buona carta dei vini)."
    ],
    "fr": [
      "Cadre agréable - Accueil chaleureux et convivial - Service à table soigné - Un choix varié de produits de qualité (viandes, poissons, pizzas, grandes salades, glaces, une bonne carte de vins)."
    ],
    "es": [
      "Entorno agradable - Acogida cálida y amable - Servicio de mesa esmerado - Oferta variada de productos de calidad (carne, pescado, pizzas, grandes ensaladas, helados, una buena carta de vinos)."
    ],
    "nl": [
      "Aangename omgeving - Warm en vriendelijk onthaal - Zorgvuldige bediening aan tafel - Een gevarieerde keuze aan kwaliteitsproducten (vlees, vis, pizza's, grote salades, ijs, een goede wijnkaart)."
    ]
  },
