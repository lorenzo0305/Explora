  "rdfs:comment": {
    "de": [
      "Expérience Vélo et Outdoor bietet geführte Fahrrad- und E-Fatbike-Touren sowie die Organisation von Aktivitäten für Geburtstage, EVG/EVJF, Seminare und Teambuilding: Olympiaden, Multiaktivitätsherausforderungen, Orientierungslauf oder immersive Spiele."
    ],
    "en": [
      "Expérience Vélo et Outdoor offers supervised bike and E-fatbike tours, as well as activities for birthdays, EVG/EVJF, seminars and team building: Olympiads, multi-activity challenges, orienteering or immersive games."
    ],
    "it": [
      "Expérience Vélo et Outdoor offre gite in bicicletta supervisionate e E-fatbike, oltre ad attività per compleanni, EVG/EVJF, seminari e team building: olimpiadi, sfide multi-attività, orienteering o giochi immersivi."
    ],
    "fr": [
      "Expérience Vélo et Outdoor propose des randonnées encadrées à vélo et E-fatbike ainsi que l'organisation d'activités pour les anniversaires, EVG/EVJF, séminaires et team building : Olympiades, Défis multiactivités, course d'orientation ou jeux immerssifs."
    ],
    "es": [
      "Expérience Vélo et Outdoor ofrece paseos supervisados en bicicleta y E-fatbikes, así como actividades para cumpleaños, EVG/EVJF, seminarios y team building: olimpiadas, retos multiactividad, orientación o juegos de inmersión."
    ],
    "nl": [
      "Expérience Vélo et Outdoor biedt begeleide fietstochten en E-fatbikes, maar ook activiteiten voor verjaardagen, EVG/EVJF's, seminars en teambuilding: Olympiades, uitdagingen met meerdere activiteiten, oriëntatieloop of immersieve spelen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Expérience Vélo, randonnée en VTT électrique et activités de groupe et team building"
    ]
  },
