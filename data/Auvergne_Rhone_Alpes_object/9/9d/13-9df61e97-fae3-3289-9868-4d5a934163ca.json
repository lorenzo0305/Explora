  "rdfs:comment": {
    "de": [
      "Fliegenfischen in den Wildwassern des Flusses Oron in der Nähe von Beaurepaire. Angeln in Flüssen und Gewässern (Regenbogenforellen, Farios, Brunnenlachs). Einführung in das Fliegenfischen nach Vereinbarung mit einem diplomierten Angelführer"
    ],
    "en": [
      "You can enjoy a spot of fly fishing in the whitewater of the Oron stream between the town of Beaurepaire and Beaufort. Fly fishing tuition with an instructor is available by appointment. Also farm trout and salmon fishing"
    ],
    "it": [
      "Pesca a mosca nelle acque bianche dell'Oron, vicino a Beaurepaire. Pesca in fiumi e laghi (trota iridea, trota fario, salmone). Introduzione alla pesca a mosca su appuntamento con una guida di pesca qualificata"
    ],
    "fr": [
      "Pratique de la pêche à la mouche dans les eaux vives de l'Oron, proche de Beaurepaire. Pêche en rivières,plans d'eau (truites arc en ciel,farios, saumons de fontaine). Initiation à la pêche à la mouche sur rendez vous avec un guide de pêche diplomé"
    ],
    "nl": [
      "Vliegvissen in de witte wateren van de Oron, nabij Beaurepaire. Vissen in rivieren en meren (regenboogforel, beekforel, zalm). Kennismaking met vliegvissen op afspraak met een gediplomeerde visgids"
    ],
    "es": [
      "Pesca con mosca en las aguas blancas del Oron, cerca de Beaurepaire. Pesca en ríos y lagos (trucha arco iris, trucha marrón, salmón). Introducción a la pesca con mosca con cita previa con un guía de pesca cualificado"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parcours de pêche des Fontaines"
    ]
  },
