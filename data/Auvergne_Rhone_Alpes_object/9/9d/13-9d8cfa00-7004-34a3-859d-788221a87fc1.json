  "rdfs:comment": {
    "de": [
      "Viehzucht und Direktverkauf von Rind- und Schaffleisch: Aubrac-Rind, Milchkalb, Agneau Noir du Velay sowie Eier und Hühner aus Freilandhaltung."
    ],
    "en": [
      "Breeding and direct sales of beef and sheep: Aubrac beef, milk-fed veal, Agneau Noir du Velay lamb, as well as free-range eggs and chickens."
    ],
    "it": [
      "Allevamento e vendita diretta di carne bovina e ovina: manzo di Aubrac, vitello da latte, agnello di Agneau Noir du Velay, uova e polli allevati all'aperto."
    ],
    "fr": [
      "Élevage et vente directe de viandes bovines et ovines: boeuf Aubrac, veau de lait, Agneau Noir du Velay ainsi que des œufs et des poulets fermiers."
    ],
    "nl": [
      "Fokken en directe verkoop van rund- en schapenvlees: rundvlees uit Aubrac, kalfsvlees van melk, lam uit Agneau Noir du Velay, evenals scharreleieren en kippen."
    ],
    "es": [
      "Cría y venta directa de carne de vacuno y ovino: vacuno de Aubrac, ternera lechal, cordero Agneau Noir du Velay, así como huevos y pollos camperos."
    ]
  },
