  "rdfs:comment": {
    "de": [
      "Organisiert Konferenzen und Vorträge.\r\nVerbreitet eine künstlerische und archäologische Kultur rund um das Museum von Valencia.\r\nErhöht die Ausstrahlung des Museums auf die Stadt, die Region und darüber hinaus.\r\nWirkt als Mäzen für das Museum.\r\nSchafft freundschaftliche Beziehungen zwischen unseren Mitgliedern."
    ],
    "en": [
      "Organizes conferences.\r\nDisseminates artistic and archaeological culture around the Musée de Valence.\r\nIncreases the museum's influence in the city, the region and beyond.\r\nPatronize the museum.\r\nCreates friendly links between our members."
    ],
    "it": [
      "Organizza conferenze.\r\nDiffonde la cultura artistica e archeologica intorno al Museo di Valence.\r\nAumenta l'influenza del museo sulla città, sulla regione e oltre.\r\nLavora come mecenate del museo.\r\nCreare legami di amicizia tra i nostri membri."
    ],
    "fr": [
      "Organise des conférences.\r\nDiffuse une culture artistique et archéologique autour du musée de Valence.\r\nAccroît le rayonnement du musée sur la ville, la région et au-delà.\r\nFait œuvre de mécénat pour le musée.\r\nCrée des liens amicaux entre nos adhérents."
    ],
    "es": [
      "Organiza conferencias.\r\nDifunde la cultura artística y arqueológica en torno al Museo de Valence.\r\nAumenta la influencia del museo en la ciudad, la región y más allá.\r\nTrabaja como mecenas del museo.\r\nCrear vínculos amistosos entre nuestros miembros."
    ],
    "nl": [
      "Organiseert conferenties.\r\nVerspreidt de artistieke en archeologische cultuur rond het Musée de Valence.\r\nVergroot de invloed van het museum in de stad, de regio en daarbuiten.\r\nTreedt op als mecenas van het museum.\r\nCreëert vriendschappelijke banden tussen onze leden."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Amis du Musée de Valence"
    ]
  },
