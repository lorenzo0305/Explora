  "rdfs:comment": {
    "de": [
      "Restaurant in einem authentischen und gemütlichen Rahmen einer Alphütte im Skigebiet Balme le Tour/ Vallorcine in der Nähe des Skilifts Aiguillette. Es bietet einen außergewöhnlichen Blick auf die Bergkette des Mont-Blanc."
    ],
    "en": [
      "Restaurant set in an authentic, welcoming mountain chalet in the Balme le Tour/Vallorcine ski area, close to the Aiguillette ski lift, with exceptional views of the Mont Blanc chain."
    ],
    "it": [
      "Questo ristorante si trova nell'ambiente autentico e accogliente di uno chalet di montagna nel comprensorio sciistico di Balme le Tour/Vallorcine, vicino all'impianto di risalita dell'Aiguillette, e offre una vista eccezionale sulla catena del Monte Bianco."
    ],
    "fr": [
      "Restaurant situé dans un cadre authentique et chaleureux de chalet d’alpage sur le domaine skiable de Balme le Tour/ Vallorcine proche du téléski de l’Aiguillette il offre une vue exceptionnelle sur la chaîne du Mont-Blanc."
    ],
    "nl": [
      "Het restaurant is gevestigd in een authentiek, gezellig bergchalet in het skigebied Balme le Tour/Vallorcine, dicht bij de skilift Aiguillette en met een uitzonderlijk uitzicht op de Mont Blanc-keten."
    ],
    "es": [
      "Este restaurante, situado en el auténtico y acogedor entorno de un chalet de montaña en la zona de esquí de Balme le Tour/Vallorcine, cerca del remonte de Aiguillette, ofrece una vista excepcional de la cadena del Mont Blanc."
    ]
  },
