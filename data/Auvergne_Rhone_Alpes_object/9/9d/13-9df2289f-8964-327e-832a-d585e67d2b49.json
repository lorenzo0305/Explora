  "rdfs:comment": {
    "de": [
      "Kathedrale im romanisch-provenzalischen Stil Ende des 12. Jahrhunderts Anfang des 13. Jahrhundert. Unter Denkmalschutz gestellt.\r\nBesichtigungen durch Fremdenführer nach Vereinbarung das ganze Jahr über hauptsächlich für Gruppen. Dauer: 1 Stunde"
    ],
    "en": [
      "Late 12th-early 13th-century Provencal Romanesque cathedral. Listed as a historic monument.\r\nVisits by guide by appointment all year round, mainly for groups. Duration: 1 hr."
    ],
    "it": [
      "Cattedrale in stile romanico provenzale della fine del XII e dell'inizio del XIII secolo. È stata dichiarata monumento storico da Mérimée nel 1840.\r\nVisite con guida su appuntamento tutto l'anno, soprattutto per gruppi. Durata: 1 ora"
    ],
    "fr": [
      "Cathédrale de style roman provençal fin XII ème début XIII ème. Classée monument historique par Mérimée en 1840.\r\nVisites effectuées par des guides conférenciers sur rendez-vous toute l'année pour les groupes essentiellement. Durée : 1 h"
    ],
    "nl": [
      "Kathedraal in Provençaalse Romaanse stijl, eind 12e eeuw, begin 13e eeuw. Staat op de lijst van historische monumenten.\r\nBezoeken met gids op afspraak het hele jaar door, voornamelijk voor groepen. Duur: 1 uur"
    ],
    "es": [
      "Catedral de estilo románico provenzal de finales del siglo XII y principios del XIII. Declarada monumento histórico por Mérimée en 1840.\r\nVisitas guiadas con cita previa todo el año, principalmente para grupos. Duración: 1 hora"
    ]
  },
