  "rdfs:comment": {
    "de": [
      "Traditionelles Restaurant mit hausgemachten Pizzas und Spezialitäten aus Savoie. Jeden Abend geöffnet in Peisey Dorf. Reservierung erforderlich. Winter und Sommer-saison geöffnet."
    ],
    "en": [
      "Traditionnal restaurant with home made pizzas and Savoie specialities. Open every night, in Peisey village. Booking necessary. Open winter and summer."
    ],
    "it": [
      "Ristorante tradizionale, specialità savoiarde e pizze fatte in casa. Situato nel cuore del villaggio di Peisey, a 150 metri dal Télévillage au Villaret. Si consiglia la prenotazione. Aperto in inverno e in estate."
    ],
    "fr": [
      "Restaurant traditionnel, spécialités savoyardes et pizzas maison. Situé au Cœur du village de Peisey, à 150 mètres du Télévillage au Villaret. Réservation conseillée. Ouvert en saison hivernale et estivale."
    ],
    "nl": [
      "Traditioneel restaurant, Savoyaardse specialiteiten en huisgemaakte pizza's. Gelegen in het hart van het dorp Peisey, op 150 meter van het Télévillage au Villaret. Reservering aanbevolen. Geopend in winter en zomer."
    ],
    "es": [
      "Restaurante tradicional, especialidades saboyanas y pizzas caseras. Situado en el corazón del pueblo de Peisey, a 150 metros del Télévillage au Villaret. Se recomienda reservar. Abierto en invierno y verano."
    ]
  },
