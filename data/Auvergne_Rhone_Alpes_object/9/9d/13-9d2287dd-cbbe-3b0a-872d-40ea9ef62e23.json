  "rdfs:comment": {
    "de": [
      "Sensations Nordiques befindet sich in La Chapelle-en-Vercors und bietet Ihnen ein Treffen mit ihrem Rudel nordischer Hunde an!\r\nBesuchen Sie www.sensations-nordiques.com"
    ],
    "en": [
      "‘Sensations Nordiques’: Dog sled school\r\n‘Sensations Nordiques’ offers a complete range of snow related and non-snow related activities throughout the whole year, whether it be during the summer or, of course, during the winter!"
    ],
    "it": [
      "Situato a La Chapelle-en-Vercors, Sensations Nordiques vi invita a conoscere la sua muta di cani nordici!\r\nVisitate www.sensations-nordiques.com"
    ],
    "fr": [
      "Situé à La Chapelle-en-Vercors, Sensations Nordiques vous propose une rencontre avec leur meute de chiens nordiques !\r\nConsulter www.sensations-nordiques.com"
    ],
    "es": [
      "Situada en La Chapelle-en-Vercors, Sensations Nordiques le invita a conocer a su jauría de perros nórdicos\r\nVisite www.sensations-nordiques.com"
    ],
    "nl": [
      "Sensations Nordiques, gevestigd in La Chapelle-en-Vercors, nodigt je uit om kennis te maken met hun roedel Scandinavische honden!\r\nBezoek www.sensations-nordiques.com"
    ]
  },
  "rdfs:label": {
