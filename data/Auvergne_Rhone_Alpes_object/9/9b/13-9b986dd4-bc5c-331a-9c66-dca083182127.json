  "rdfs:comment": {
    "de": [
      "Die Mediathek von Allègre bietet am Samstag, den 28. März um 18 Uhr in ihren Räumlichkeiten im Rathaus ein außergewöhnliches literarisches Rendezvous an.\r\nDer Dichter Armand Dupuy wird anwesend sein, um über sein Werk zu diskutieren."
    ],
    "en": [
      "The Allègre media library will be hosting a special literary event on Saturday March 28 at 6pm, at the town hall.\r\nPoet Armand Dupuy will be on hand to discuss his work."
    ],
    "it": [
      "La mediateca di Allègre ospita un evento letterario speciale sabato 28 marzo alle 18.00 nel municipio.\r\nIl poeta Armand Dupuy parlerà della sua opera."
    ],
    "fr": [
      "La médiathèque d’Allègre propose un rendez‑vous littéraire exceptionnel le samedi 28 mars à 18h, dans ses locaux à la mairie. \r\nLe poète Armand Dupuy sera présent pour échanger autour de son œuvre."
    ],
    "es": [
      "La mediateca de Allègre organiza un acto literario especial el sábado 28 de marzo a las 18.00 horas en el ayuntamiento.\r\nEl poeta Armand Dupuy hablará de su obra."
    ],
    "nl": [
      "De mediatheek van Allègre organiseert op zaterdag 28 maart om 18.00 uur een speciaal literair evenement in het gemeentehuis.\r\nDichter Armand Dupuy zal er zijn werk bespreken."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Rencontre avec le poète Armand Dupuy"
    ]
  },
