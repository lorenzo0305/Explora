  "rdfs:comment": {
    "de": [
      "Traditionelles Restaurant in einem authentischen und gemütlichen Rahmen, das Ihnen eine hausgemachte Küche bietet. Unser kleines Team wird alles tun, um Ihnen einen echten Moment der Gemeinsamkeit mit viel Geschmack zu bieten!"
    ],
    "en": [
      "A traditional restaurant offering home cooking in a warm, authentic setting. Our small team will do everything in their power to offer you a real moment of sharing, full of flavour!"
    ],
    "it": [
      "Ristorante tradizionale, in un ambiente autentico e accogliente, che vi offre una cucina casalinga. Il nostro piccolo team farà il possibile per offrirvi un vero e proprio momento di condivisione, pieno di gusto!"
    ],
    "fr": [
      "Restaurant traditionnel, dans un cadre authentique et chaleureux, qui vous propose une cuisine maison. Notre petite équipe fera tout pour vous offrir un vrai moment de partage tout en saveur !"
    ],
    "es": [
      "Restaurante tradicional, en un entorno auténtico y cálido, que le ofrece cocina casera. Nuestro pequeño equipo hará todo lo posible para ofrecerle un verdadero momento de convivencia, ¡lleno de sabor!"
    ],
    "nl": [
      "Een traditioneel restaurant met een huiselijke keuken in een warme, authentieke omgeving. Ons kleine team zal zijn uiterste best doen om u een echt moment van delen te bieden, vol van smaak!"
    ]
  },
