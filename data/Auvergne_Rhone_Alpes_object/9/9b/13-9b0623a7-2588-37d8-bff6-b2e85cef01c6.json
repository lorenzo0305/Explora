  "rdfs:comment": {
    "de": [
      "Gegenüber dem TNP (Théâtre de Villeurbanne) gelegen, bietet Ihnen die Brasserie du Théâtre traditionelle und schmackhafte Speisen in einem gemütlichen Ambiente mit einer Terrasse, die bei schönem Wetter sehr angenehm ist."
    ],
    "en": [
      "Situated opposite the TNP (Théâtre de Villeurbanne), the Brasserie du Théâtre offers traditional and tasty food in a cosy atmosphere with a very pleasant terrace on sunny days."
    ],
    "it": [
      "Situata di fronte al TNP (Théâtre de Villeurbanne), la Brasserie du Théâtre offre una cucina tradizionale e gustosa in un'atmosfera accogliente con una terrazza molto piacevole nella bella stagione."
    ],
    "fr": [
      "SItué face au TNP (Théâtre de Villeurbanne), la Brasserie du Théâtre vous propose une restauration traditionnelle et savoureuse dans une ambiance cosy avec une terrasse très agréable aux beaux jours."
    ],
    "es": [
      "Situada frente al TNP (Teatro de Villeurbanne), la Brasserie du Théâtre ofrece comida tradicional y sabrosa en un ambiente acogedor con una terraza muy agradable cuando hace buen tiempo."
    ],
    "nl": [
      "De tegenover het TNP (Théâtre de Villeurbanne) gelegen Brasserie du Théâtre biedt traditionele en smakelijke gerechten in een gezellige sfeer met een zeer aangenaam terras bij mooi weer."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Brasserie du Théâtre"
    ]
  },
