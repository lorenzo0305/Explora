  "rdfs:comment": {
    "de": [
      "Cristalynne.J entwirft personalisierbare Artikel aus zertifizierter Biobaumwolle für die ganze Familie. Gesunde und sanfte Kreationen für alle, die Umwelt und die Menschen. Die Kreationen werden in Savoyen handgefertigt."
    ],
    "en": [
      "Cristalynne.J creates personalized items in certified organic cotton for the whole family. Healthy and gentle creations for everyone, the environment and people, handmade in Savoie."
    ],
    "it": [
      "Cristalynne.J crea articoli personalizzati in cotone biologico certificato per tutta la famiglia. Creazioni sane e delicate per tutti, per l'ambiente e per le persone, realizzate a mano in Savoia."
    ],
    "fr": [
      "Cristalynne.J crée pour toute la famille des articles en coton biologique certifié personnalisables. Créations saines et douces pour tous, l'environnement et les Hommes, créations réalisées à la main en Savoie."
    ],
    "nl": [
      "Cristalynne.J maakt gepersonaliseerde artikelen van gecertificeerd biologisch katoen voor het hele gezin. Gezonde en zachte creaties voor iedereen, het milieu en de mensen, met de hand gemaakt in Savoie."
    ],
    "es": [
      "Cristalynne.J crea artículos personalizados en algodón orgánico certificado para toda la familia. Creaciones sanas y suaves para todos, el medio ambiente y las personas, hechas a mano en Saboya."
    ]
  },
