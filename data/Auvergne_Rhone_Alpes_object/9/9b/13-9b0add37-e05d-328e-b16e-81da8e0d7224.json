  "rdfs:comment": {
    "de": [
      "Der Gilbert-Gaillard-Saal im historischen Zentrum von Clermont-Ferrand ist ein multidisziplinärer Ausstellungsraum, der seit 2014 ein Programm mit temporären Ausstellungen anbietet:"
    ],
    "en": [
      "The Salle Gilbert-Gaillard, located in the historic heart of Clermont-Ferrand, is a multidisciplinary exhibition space that has offered a program of temporary exhibitions since 2014:"
    ],
    "it": [
      "La Salle Gilbert-Gaillard, situata nel cuore storico di Clermont-Ferrand, è uno spazio espositivo multidisciplinare che dal 2014 propone un programma di mostre temporanee:"
    ],
    "fr": [
      "La salle Gilbert-Gaillard, située en plein cœur historique de Clermont-Ferrand, est un espace d'exposition pluridisciplinaire qui propose depuis 2014 une programmation d'expositions temporaires :"
    ],
    "es": [
      "La Salle Gilbert-Gaillard, situada en el centro histórico de Clermont-Ferrand, es un espacio de exposición multidisciplinar que ofrece un programa de exposiciones temporales desde 2014:"
    ],
