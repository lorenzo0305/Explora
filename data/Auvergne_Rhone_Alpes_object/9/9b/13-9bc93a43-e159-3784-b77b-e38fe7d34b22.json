  "rdfs:comment": {
    "de": [
      "Zwischen zwei Bowl- oder Pumptrack-Sessions können Sie sich am Kletterblock versuchen!\r\nDie Struktur ist für alle ab 8 Jahren zugänglich und befindet sich im Herzen des Espace-Loisirs des Loyers."
    ],
    "en": [
      "Between two sessions of bowl or pumptrack, try the climbing boulder!\r\nThe structure is accessible to everyone aged 8 and over, in the heart of the Espace-Loisirs des Loyers."
    ],
    "it": [
      "Tra due sessioni di bowl o di pumptrack, cimentatevi nel bouldering!\r\nLa struttura è aperta a tutti a partire dagli 8 anni, nel cuore dell'Espace-Loisirs des Loyers."
    ],
    "fr": [
      "Entre deux sessions de bowl ou de pumptrack, tenter le bloc d'escalade !\r\nLa structure est accessible à tous à partir de 8 ans, au cœur de l'Espace-Loisirs des Loyers."
    ],
    "nl": [
      "Probeer tussen twee bowl- of pumptrack-sessies door eens te boulderen!\r\nDe structuur is toegankelijk voor iedereen vanaf 8 jaar, in het hart van de Espace-Loisirs des Loyers."
    ],
    "es": [
      "Entre dos sesiones de bowl o pumptrack, ¡pruebe el boulder!\r\nLa estructura está abierta a todos a partir de 8 años, en el corazón del Espace-Loisirs des Loyers."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Bloc d'escalade des Loyers"
    ]
  },
