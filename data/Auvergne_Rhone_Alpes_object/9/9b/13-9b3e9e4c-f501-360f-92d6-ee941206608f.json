  "rdfs:comment": {
    "de": [
      "Corinne und Christophe, Konfitürenhersteller und Bienenzüchter, freuen sich, Sie in Le Chaudron begrüßen zu dürfen, um Ihnen ihre Produkte aus ihrem Betrieb mit roten Früchten und süßen Leckereien vorzustellen."
    ],
    "en": [
      "Meet Corinne the jam maker and Christophe the apiarist. On the fruit side : jams, jellies, syrups, coulis and alcohols.\r\nOn the honey side: honeys, spiced breads, hazelnut sweets. After the visit, don’t forget the tasting !"
    ],
    "it": [
      "Corinne e Christophe, produttori di marmellate e apicoltori, sono lieti di accogliervi a Le Chaudron per mostrarvi i prodotti della loro fattoria di frutti rossi e dolciumi."
    ],
    "fr": [
      "Corinne et Christophe, confiturier et apiculteur, sont heureux de vous accueillir au Chaudron pour vous faire découvrir leurs produits issus de leur exploitation de fruits rouges et gourmandises sucrées."
    ],
    "es": [
      "Corinne y Christophe, fabricantes de mermeladas y apicultores, están encantados de recibirle en Le Chaudron para mostrarle los productos de su granja de frutos rojos y golosinas."
    ],
    "nl": [
      "Corinne en Christophe, confituurmakers en imkers, heten je van harte welkom in Le Chaudron om je de producten van hun boerderij met rode vruchten en zoete lekkernijen te laten zien."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le chaudron du Fournioux"
    ]
  },
