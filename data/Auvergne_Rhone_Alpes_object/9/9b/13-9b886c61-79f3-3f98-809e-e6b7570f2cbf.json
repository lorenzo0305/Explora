  "rdfs:comment": {
    "de": [
      "Der Chefkoch und sein Team definieren die Codes der mediterranen Küche neu, um Ihnen gute Zubereitungen zu bieten. Halal- und alkoholfreies italienisches Restaurant."
    ],
    "en": [
      "The chef and his team redefine the codes of Mediterranean cuisine to bring you the very best. Halal and alcohol-free Italian restaurant."
    ],
    "it": [
      "Lo chef e il suo team ridefiniscono i codici della cucina mediterranea per offrirvi i piatti migliori. Ristorante italiano Halal e senza alcol."
    ],
    "fr": [
      "Le chef et son équipe redéfinissent les codes de la cuisine méditerranéenne pour vous offrir de bonnes préparations. Restaurant italien halal et sans alcool."
    ],
    "es": [
      "El chef y su equipo redefinen los códigos de la cocina mediterránea para ofrecerle los mejores platos. Restaurante italiano halal y sin alcohol."
    ],
