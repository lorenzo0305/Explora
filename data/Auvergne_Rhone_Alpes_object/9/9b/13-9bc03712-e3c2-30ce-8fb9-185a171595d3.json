  "rdfs:comment": {
    "de": [
      "Die Foulées Vichyssoises bieten drei Distanzen an: 5km, 10km und 21km sowie Kinderläufe. Wie jedes Jahr werden die Foulées durch das Herz von Vichy führen, insbesondere durch den Parc des Sources!"
    ],
    "en": [
      "Les Foulées Vichyssoises offers 3 distances: 5km, 10km and 21km, plus children's races. As in previous years, the Foulées will pass through the heart of Vichy, notably the Parc des Sources!"
    ],
    "it": [
      "Le Foulées Vichyssoises propongono 3 distanze: 5 km, 10 km e 21 km, oltre a gare per bambini. Come negli anni precedenti, le Foulées attraverseranno il cuore di Vichy, in particolare il Parc des Sources!"
    ],
    "fr": [
      "Les Foulées Vichyssoises proposent 3 distances , 5km, 10 km et 21 km plus des courses enfants . Comme chaque années les Foulées passeront par le cœur de Vichy et notamment le parc des Sources !"
    ],
    "es": [
      "Les Foulées Vichyssoises ofrecen 3 distancias: 5 km, 10 km y 21 km, además de carreras infantiles. Como en años anteriores, las Foulées pasarán por el corazón de Vichy, en concreto por el Parc des Sources"
    ],
    "nl": [
      "Les Foulées Vichyssoises biedt 3 afstanden: 5km, 10km en 21km, plus kinderraces. Net als voorgaande jaren zullen de Foulées door het hart van Vichy lopen, in het bijzonder door het Parc des Sources!"
    ]
  },
  "rdfs:label": {
