  "rdfs:comment": {
    "de": [
      "Das Höhenrestaurant Chez Gaston liegt eingebettet zwischen Savoyen und Hochsavoyen und bietet Ihnen im Sommer und Winter einen herrlichen 360°-Blick auf den Mont Blanc und Beaufortain.  Skigebiet Les Contamines."
    ],
    "en": [
      "Restaurant d'altitude chez Gaston nestled between Savoie and Haute Savoie, offers a magnificent 360° view of Mont Blanc and Beaufortain Eté/ Hiver."
    ],
    "it": [
      "Ristorante d'altitudine a Gaston incastonato tra Savoia e Alta Savoia, vi offre una magnifica vista a 360º sul Monte Bianco e il Beaufortain Estate/ Inverno."
    ],
    "fr": [
      "Restaurant d'altitude chez Gaston niché entre Savoie et Haute Savoie, vous offre une magnifique vue en 360° sur le Mont Blanc et le Beaufortain Eté / Hiver.  Domaine skiable des Contamines."
    ],
    "nl": [
      "Restaurant d'Altitude chez Gaston ligt tussen de Savoie en de Haute Savoie en biedt een prachtig uitzicht van 360° op de Mont Blanc en Beaufortain Eté/Hiver."
    ],
    "es": [
      "Chez Gaston, restaurante de altura situado entre Saboya y Alta Saboya, ofrece una magnífica vista de 360° del Mont Blanc y del Beaufortain en verano y en invierno.  Zona de esquí de Les Contamines."
    ]
  },
