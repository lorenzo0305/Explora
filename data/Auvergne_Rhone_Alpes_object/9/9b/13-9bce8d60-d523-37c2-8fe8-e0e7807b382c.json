  "rdfs:comment": {
    "de": [
      "Im Weiler La Diat beginnt ein Parcours mit 11 Markierungen, der sich ideal für den Einstieg in den Orientierungslauf mit der ganzen Familie eignet. Die Broschüre enthält zu jeder Markierung eine Frage oder ein kleines Quiz über das Kulturerbe von La Diat."
    ],
    "en": [
      "Starting from the hamlet of La Diat, an 11-marker trail ideal for families getting started in orienteering. Each marker is accompanied by a question or quiz on the heritage of La Diat."
    ],
    "it": [
      "Con partenza dalla frazione di La Diat, questo percorso di 11 punti è ideale per iniziare l'orienteering in famiglia. Ogni punto è accompagnato da una domanda o un quiz sul patrimonio di La Diat."
    ],
    "fr": [
      "Au départ du hameau de La Diat, un parcours de 11 balises idéal pour débuter la course d’orientation en famille. A chaque balise le dépliant est agrémenté d’une question ou d’un petit quizz sur le patrimoine de La Diat."
    ],
    "es": [
      "Partiendo de la aldea de La Diat, este recorrido de 11 balizas es ideal para iniciarse en la orientación en familia. Cada baliza va acompañada de una pregunta o un cuestionario sobre el patrimonio de La Diat."
    ],
    "nl": [
      "Deze route met 11 markeringen vertrekt vanuit het gehucht La Diat en is ideaal om met het hele gezin te beginnen met oriëntatielopen. Bij elke markering hoort een vraag of quiz over het erfgoed van La Diat."
    ]
  },
  "rdfs:label": {
    "fr": [
      "A la découverte de La Diat - parcours d'orientation ludique"
    ]
  },
