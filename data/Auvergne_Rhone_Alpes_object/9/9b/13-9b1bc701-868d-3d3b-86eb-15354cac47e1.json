  "rdfs:comment": {
    "de": [
      "Der Verein A.M.B. hat sich zum Ziel gesetzt, die Qualität der Arbeit von Handwerkern und Künstlern aus der Region Auvergne / Rhône Alpes zu fördern und in den Vordergrund zu stellen."
    ],
    "en": [
      "The objectives of the A.M.B. Association are to promote and highlight the know-how and quality of the work of craftsmen and artists in the Auvergne / Rhône Alpes region."
    ],
    "it": [
      "Uno degli obiettivi dell'Associazione A.M.B. è quello di promuovere e valorizzare la competenza e la qualità del lavoro degli artigiani e degli artisti della regione Auvergne/Rhône Alpes."
    ],
    "fr": [
      "L'Association A.M.B. a dans ses objectifs, de promouvoir et mettre en avant le savoir faire qualité du travail des artisans et des artistes de la Région Auvergne / Rhône Alpes."
    ],
    "es": [
      "Uno de los objetivos de la Asociación A.M.B. es promover y destacar el saber hacer y la calidad del trabajo de los artesanos y artistas de la región de Auvernia/Ródano-Alpes."
    ],
    "nl": [
      "Een van de doelstellingen van de vereniging A.M.B. is het promoten en onder de aandacht brengen van de expertise en de kwaliteit van het werk van ambachtslieden en kunstenaars in de regio Auvergne/Rhône Alpes."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Maison de l'Artisanat"
    ]
  },
