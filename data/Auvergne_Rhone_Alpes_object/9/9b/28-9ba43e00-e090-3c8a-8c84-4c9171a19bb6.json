  "rdfs:comment": {
    "de": [
      "Geführte Wanderung vom Abend bis zum Beginn der Nacht durch den Verein AFORETZ. Denken Sie daran, Ihr Abendessen mitzunehmen!\nTreffpunkt: Parkplatz am Bahnhof von Villers-Cotterêts, Abfahrt um 18 Uhr."
    ],
    "en": [
      "Guided stroll from evening to early evening by the AFORETZ association. Don't forget to bring your dinner!\nMeet at the Villers-Cotterêts station parking lot for a 6pm departure."
    ],
    "it": [
      "Passeggiata guidata dalla sera alla sera presto a cura dell'associazione AFORETZ. Non dimenticate di portare la cena!\nRitrovo al parcheggio della stazione di Villers-Cotterêts per la partenza alle 18.00."
    ],
    "fr": [
      "Balade guidée de la soirée au début de la nuit par l’association AFORETZ. Pensez à emporter votre dîner  ! \nRendez-vous sur le parking de la gare de Villers-Cotterêts pour un départ à 18h."
    ],
    "es": [
      "Paseo guiado desde la tarde hasta primera hora de la noche por la asociación AFORETZ. No olvide traer la cena\nCita en el aparcamiento de la estación de Villers-Cotterêts para una salida a las 18h."
    ],
    "nl": [
      "Begeleide wandeling van 's avonds vroeg tot 's avonds laat door de AFORETZ vereniging. Vergeet je avondeten niet!\nVerzamelen op de parkeerplaats van het station van Villers-Cotterêts voor een vertrek om 18.00 uur."
    ]
  },
