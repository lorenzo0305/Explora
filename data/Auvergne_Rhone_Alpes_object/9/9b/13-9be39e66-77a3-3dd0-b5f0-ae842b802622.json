  "rdfs:comment": {
    "de": [
      "Neue musikalische Show des legendären Kabaretts von Pigalle. Vier Drag-Künstler begeistern ganz Frankreich mit einer originellen Gesangstour, die die größten Klassiker des französischen Chansons neu interpretiert."
    ],
    "en": [
      "New musical show from the legendary Pigalle cabaret. Four drag artists set the whole of France alight with an original singing tour revisiting the greatest classics of French chanson."
    ],
    "it": [
      "Nuovo spettacolo musicale del leggendario cabaret di Pigalle. Quattro drag artist infiammano l'intera Francia con un originale tour canoro che rivisita i più grandi classici della chanson francese."
    ],
    "fr": [
      "Nouveau spectacle musical du cabaret mythique de Pigalle. Quatre artistes drag enflamment la France entière avec un tour de chant original qui revisite les plus grands classiques de la chanson française."
    ],
    "es": [
      "Nuevo espectáculo musical del legendario cabaret Pigalle. Cuatro artistas travestidos incendian toda Francia con una original gira de canto que repasa los grandes clásicos de la chanson francesa."
    ],
    "nl": [
      "Nieuwe muzikale show van het legendarische cabaret van Pigalle. Vier drag artiesten zetten heel Frankrijk in vuur en vlam met een originele zangtournee langs de grootste klassiekers van het Franse chanson."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Spectacle: Madame Arthur enflamme Bourg Lès Valence"
    ]
  },
