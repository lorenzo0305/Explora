  "rdfs:comment": {
    "de": [
      "Genießen Sie in diesem für alle Generationen offenen Ort eine Tagesküche aus lokalen Produkten zu moderaten Preisen! Das Restaurant bietet auch einen durchgehenden Teestubenservice an."
    ],
    "en": [
      "Come and enjoy a daily cuisine based on local products at moderate prices in this place open to all generations! The restaurant also offers a continuous tea room service."
    ],
    "it": [
      "Venite a gustare la cucina quotidiana a base di prodotti locali a prezzi moderati in questo luogo aperto a tutte le generazioni! Il ristorante offre anche un servizio continuo di sala da tè."
    ],
    "fr": [
      "Venez déguster une cuisine du jour à base de produits locaux et à des prix modérés dans ce lieu ouvert à toutes les générations ! Le restaurant propose aussi un service de salon de thé en continu."
    ],
    "es": [
      "¡Venga a disfrutar de la cocina diaria elaborada con productos locales a precios moderados en este lugar abierto a todas las generaciones! El restaurante también ofrece un servicio de salón de té continuo."
    ],
    "nl": [
      "Kom en geniet van de dagelijkse keuken gemaakt met lokale producten tegen gematigde prijzen in deze plaats open voor alle generaties! Het restaurant biedt ook een doorlopende tea room service."
    ]
  },
  "rdfs:label": {
