  "rdfs:comment": {
    "de": [
      "Im Herzen des charmanten Dorfes Marsanne versammelt der Terra Potiers-Markt professionelle Töpfer aus dem Südosten Frankreichs.\r\n \r\nIm Laufe des Tages finden Modellier- und Drechselvorführungen statt"
    ],
    "en": [
      "In the heart of the charming village of Marsanne, the Terra Potiers market brings together professional potters from the south-east of France.\r\n \r\nModelling activities open to all, and throwing demonstrations throughout the day!"
    ],
    "it": [
      "Nel cuore dell'incantevole villaggio di Marsanne, il mercato Terra Potiers riunisce i ceramisti professionisti del sud-est della Francia.\r\n \r\nAttività di modellazione aperte a tutti e dimostrazioni di lancio durante tutta la giornata!"
    ],
    "fr": [
      "Au cœur du charmant village de Marsanne, le marché Terra Potiers rassemble des potiers professionnels venus du Sud-Est de la France.\r\n \r\nAnimation modelage ouvert à tous et démonstration de tournage au cours de la journée !"
    ],
    "nl": [
      "In het hart van het charmante dorpje Marsanne brengt de Terra Potiers markt professionele pottenbakkers uit het zuidoosten van Frankrijk samen.\r\n \r\nBoetseeractiviteiten voor iedereen en de hele dag door werpdemonstraties!"
    ],
    "es": [
      "En el corazón del encantador pueblo de Marsanne, el mercado Terra Potiers reúne a alfareros profesionales del sureste de Francia.\r\n \r\nActividades de modelado abiertas a todos y demostraciones de lanzamiento durante todo el día"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Marsanne Terra Potiers"
    ]
  },
