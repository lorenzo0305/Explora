  "rdfs:comment": {
    "de": [
      "In der Altstadt bietet Ihnen dieses 100m² große Geschäft, das der Töpferei gewidmet ist, zwischen seinen verschiedenen Räumen handdekoriertes Geschirr, dekorative Keramik und Seifen aus Marseille an."
    ],
    "en": [
      "In the old city centre, this 100m² shop dedicated to pottery proposes hand made decorated crockery, decorative ceramics and soaps from Marseille."
    ],
    "it": [
      "Nel centro storico della città, questo negozio di 100 m² dedicato alla ceramica offre, tra le sue diverse sale, servizi da tavola decorati a mano, ceramiche decorative e saponi di Marsiglia."
    ],
    "fr": [
      "Dans le centre ancien, ce magasin de 100m² dédié à la poterie vous propose, entre ses différentes salles, de la vaisselle décorée main, de la céramique décorative et des savons de Marseille."
    ],
    "es": [
      "En el centro histórico, esta tienda de 100 m² dedicada a la alfarería ofrece, entre sus diferentes salas, vajillas decoradas a mano, cerámicas decorativas y jabones marselleses."
    ],
    "nl": [
      "Deze winkel van 100m², in het oude centrum, is gewijd aan aardewerk, in verschillende ruimtes bieden wij u servies gedecoreerd met de hand, ceramiek en zepen uit Marseille."
    ]
  },
