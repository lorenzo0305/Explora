  "rdfs:comment": {
    "de": [
      "Erleben Sie die Mad-Jacques 2024 auf dieser Fahrradroute noch einmal. Diese Route führt Sie auf die Weinstraße Forez-Roannais in der vulkanischen Loire und bietet Ihnen die Möglichkeit, der Loire entlang des Wassers zu folgen und von abwechslungsreichen Landschaften zu unumgänglichen Sehenswürdigkeiten zu gelangen."
    ],
    "en": [
      "Relive the Mad-Jacques 2024 by following this cycling route. This itinerary takes you along the Forez-Roannais Wine Route in the Volcanic Loire, following the Loire as it flows by, passing through varied landscapes and must-see sites."
    ],
    "it": [
      "Rivivete il Mad-Jacques 2024 seguendo questo itinerario ciclistico. L'itinerario si snoda lungo la Strada del Vino Forez-Roannais nella Loira vulcanica, seguendo la Loira che scorre accanto a una varietà di paesaggi e siti imperdibili."
    ],
    "fr": [
      "Revivez la Mad-Jacques 2024 en suivant ce parcours vélo. Cet itinéraire vous emmène sur la Route des Vins Forez-Roannais en Loire Volcanique et vous propose de suivre la Loire au fil de l'eau et de passer de paysages variés en sites incontournables."
    ],
    "es": [
      "Reviva el Mad-Jacques de 2024 siguiendo esta ruta en bicicleta. Este itinerario le llevará por la Ruta del Vino de Forez-Roannais, en el Loira volcánico, siguiendo el curso del Loira a su paso por una gran variedad de paisajes y lugares de visita obligada."
    ],
    "nl": [
      "Beleef de Mad-Jacques 2024 opnieuw door deze fietsroute te volgen. Deze route neemt je mee langs de Forez-Roannais wijnroute in de Vulkaan Loire, waarbij je de Loire volgt langs verschillende landschappen en bezienswaardigheden."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Itinéraire cyclo-sportif - Mad Jacques Entre Véloire et route des vins"
    ]
  },
