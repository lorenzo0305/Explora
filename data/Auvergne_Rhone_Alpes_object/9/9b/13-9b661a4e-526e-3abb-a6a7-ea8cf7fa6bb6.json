  "rdfs:comment": {
    "de": [
      "Im Weiler St Hugues beginnt ein Parcours mit 12 Markierungen, der sich ideal für den Einstieg in den Orientierungslauf eignet. Zu jeder Markierung gibt es eine Frage oder ein kleines Quiz über das Kulturerbe von Saint Hugues en Chartreuse."
    ],
    "en": [
      "Starting from the hamlet of St Hugues, a 12-marker course ideal for beginners in orienteering. Each marker is accompanied by a question or quiz on the heritage of Saint Hugues en Chartreuse."
    ],
    "it": [
      "Partendo dal borgo di St Hugues, questo percorso di 12 punti è il modo ideale per iniziare a praticare l'orienteering. Ogni punto è accompagnato da una domanda o un quiz sul patrimonio di Saint Hugues en Chartreuse."
    ],
    "fr": [
      "Au départ du hameau de St Hugues, un parcours de 12 balises idéal pour débuter la course d’orientation. A chaque balise le dépliant est agrémenté d’une question ou d’un petit quizz sur le patrimoine de Saint Hugues en Chartreuse."
    ],
    "es": [
      "Partiendo de la aldea de St Hugues, este recorrido de 12 balizas es ideal para iniciarse en la orientación. Cada baliza va acompañada de una pregunta o un cuestionario sobre el patrimonio de Saint Hugues en Chartreuse."
    ],
    "nl": [
      "Deze route met 12 markeringen vertrekt vanuit het gehucht St Hugues en is een ideale manier om te beginnen met oriëntatielopen. Bij elke markering hoort een vraag of quiz over het erfgoed van Saint Hugues en Chartreuse."
    ]
  },
  "rdfs:label": {
    "fr": [
      "A la découverte de St Hugues de Chartreuse - parcours d'orientation"
    ]
  },
