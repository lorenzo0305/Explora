  "rdfs:comment": {
    "de": [
      "Die Domaine Saint Jean de Chépy öffnet die Türen ihres Restaurants mit einem Angebot, das ausschließlich aus lokalen Produkten besteht, in der einzigartigen Kulisse des Parks der Domaine, zwischen Kulturerbe und zeitgenössischer Kunst."
    ],
    "en": [
      "The Domaine Saint Jean de Chépy opens the doors of its restaurant with a menu based exclusively on local produce, in the unique setting of the Domaine?s park, between heritage and contemporary art."
    ],
    "it": [
      "Il Domaine Saint Jean de Chépy apre le porte del suo ristorante con un menu basato esclusivamente su prodotti locali, nella cornice unica del parco del Domaine, un mix di patrimonio e arte contemporanea."
    ],
    "fr": [
      "Le Domaine Saint Jean de Chépy ouvre les portes de son restaurant avec une offre uniquement à partir de produits locaux, dans l’écrin unique du parc du Domaine, entre patrimoine et art contemporain."
    ],
    "nl": [
      "Het Domaine Saint Jean de Chépy opent de deuren van zijn restaurant met een menu op basis van uitsluitend lokale producten, in de unieke setting van het park van het Domaine, een mix van erfgoed en hedendaagse kunst."
    ],
    "es": [
      "El Domaine Saint Jean de Chépy abre las puertas de su restaurante con un menú basado exclusivamente en productos locales, en el marco único del parque del Domaine, mezcla de patrimonio y arte contemporáneo."
    ]
  },
  "rdfs:label": {
