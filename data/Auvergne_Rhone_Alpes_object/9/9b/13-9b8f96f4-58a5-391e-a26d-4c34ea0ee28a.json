  "rdfs:comment": {
    "de": [
      "Die Mediathek von Espaly-Saint-Marcel beherbergt die Ausstellung \"Encre de Chine\" der Künstlerin Clothilde Anty. Vom 28. März bis zum 22. Mai 2026 sind zarte Werke zu sehen, in denen das Spiel mit Strichen und Nuancen die ganze Poesie der Tinte offenbart."
    ],
    "en": [
      "The Espaly-Saint-Marcel media library is hosting the \"Encre de Chine\" exhibition by artist Clothilde Anty. On view from March 28 to May 22 2026: delicate works in which the interplay of strokes and nuances reveals all the poetry of ink."
    ],
    "it": [
      "La mediateca di Espaly-Saint-Marcel ospita la mostra \"Encre de Chine\" dell'artista Clothilde Anty. In mostra dal 28 marzo al 22 maggio 2026: opere delicate in cui il gioco di tratti e sfumature rivela tutta la poesia dell'inchiostro."
    ],
    "fr": [
      "La médiathèque d’Espaly-Saint-Marcel accueille l’exposition « Encre de Chine » de l’artiste Clothilde Anty. À découvrir du 28 mars au 22 mai 2026 : des œuvres délicates où le jeu des traits et des nuances révèle toute la poésie de l’encre."
    ],
    "es": [
      "La mediateca de Espaly-Saint-Marcel acoge la exposición \"Encre de Chine\" de la artista Clothilde Anty. Del 28 de marzo al 22 de mayo de 2026: obras delicadas en las que el juego de trazos y matices revela toda la poesía de la tinta."
    ],
    "nl": [
      "In de mediatheek van Espaly-Saint-Marcel loopt de tentoonstelling \"Encre de Chine\" van kunstenares Clothilde Anty. Te zien van 28 maart tot 22 mei 2026: delicate werken waarin het samenspel van streken en nuances alle poëzie van inkt onthult."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Exposition d'œuvres à l'encre de Chine"
    ]
  },
