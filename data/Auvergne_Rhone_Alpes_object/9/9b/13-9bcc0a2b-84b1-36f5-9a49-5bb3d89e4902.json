  "rdfs:comment": {
    "de": [
      "Reifungskeller für Saint-Nectaire und Verkauf vor Ort in der Boutique von Jassy. Die auf dem Betrieb erzeugte Milch wird zu Saint Nectaire fermier AOP verarbeitet. Der Käse bleibt mindestens 4 Wochen im Keller, der Geschmack ist jedoch nach 6 Wochen am ausgeprägtesten."
    ],
    "en": [
      "Saint-Nectaire ripening cellar and on-site sales in the Jassy store. The milk produced on the farm is transformed into Saint Nectaire fermier AOP, and the cheeses are kept in the cellar for a minimum of 4 weeks, although the taste is more pronounced after 6 weeks."
    ],
    "it": [
      "Cantina di stagionatura di Saint-Nectaire e vendita sul posto nel negozio di Jassy. Il latte prodotto in azienda viene trasformato in formaggio di fattoria DOP Saint-Nectaire. I formaggi vengono tenuti in cantina per un minimo di 4 settimane, ma il sapore diventa più pronunciato dopo 6 settimane."
    ],
    "fr": [
      "Cave d'affinage de Saint-Nectaire et vente sur place dans la boutique de Jassy. Le lait produit sur l'exploitation est transformé en Saint Nectaire fermier AOP, les fromages restent en cave minimum4 semaines mais le goût est plus prononcé vers 6 semaines."
    ],
    "nl": [
      "Rijpingskelder Saint-Nectaire en verkoop ter plaatse in de winkel van Jassy. De melk die op de boerderij wordt geproduceerd, wordt verwerkt tot boerderij BOB Saint-Nectaire. De kazen worden minimaal 4 weken in de kelder bewaard, maar de smaak komt beter tot zijn recht na 6 weken."
    ],
    "es": [
      "Bodega de maduración Saint-Nectaire y venta in situ en la tienda Jassy. La leche producida en la granja se transforma en queso de granja DOP Saint-Nectaire. Los quesos se conservan en bodega un mínimo de 4 semanas, pero el sabor se acentúa a partir de las 6 semanas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ferme du Fayet"
    ]
  },
