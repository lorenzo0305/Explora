  "rdfs:comment": {
    "de": [
      "Dieser Open-Space-Coworking-Raum bietet Ihnen zahlreiche Vorteile, darunter einen unbegrenzten Highspeed-Glasfaser-Internetanschluss (300 Mbps), einen Farblaser-Scanner-Drucker und eine Küchenzeile - und das alles in einer freundlichen Atmosphäre."
    ],
    "en": [
      "This open-space coworking space allows you to take advantage of many benefits, including unlimited high-speed fiber internet connection (300Mbps), a color laser printer-scanner and a kitchenette, all in a friendly atmosphere."
    ],
    "it": [
      "Questo spazio di coworking open-space offre molti vantaggi, tra cui una connessione internet illimitata in fibra ad alta velocità (300Mbps), una stampante-scanner laser a colori e un angolo cottura, il tutto in un'atmosfera amichevole."
    ],
    "fr": [
      "Cet espace de coworking en open-space vous permet de profiter de nombreux avantages, notamment une connexion Internet fibre haut débit (300Mbps) en illimitée, une imprimante laser couleur-scanner et une kitchenette, tout cela dans une ambiance conviviale."
    ],
    "es": [
      "Este espacio abierto de coworking ofrece muchas ventajas, como conexión ilimitada a Internet de fibra de alta velocidad (300 Mbps), una impresora-escáner láser en color y una cocina americana, todo ello en un ambiente agradable."
    ],
    "nl": [
      "Deze open coworkingruimte biedt vele voordelen, waaronder een onbeperkte snelle glasvezelinternetverbinding (300Mbps), een kleurenlaserprinter-scanner en een kitchenette, en dat alles in een vriendelijke sfeer."
    ]
  },
  "rdfs:label": {
