  "rdfs:comment": {
    "de": [
      "Dieses Geschäft in Yssingelais bietet das ganze Jahr über Eis an und hat sich diversifiziert, indem es auch süße Crêpes, Eisscheiterhaufen und Eis-Entremets herstellt. Sie werden begeistert sein!"
    ],
    "en": [
      "Yssingel-based business offering ice creams all year round, is now diversifying by concocting sweet crepes, frozen logs and frozen entremets. You'll love it!"
    ],
    "it": [
      "Questa azienda di Yssingel offre gelati tutto l'anno e ora si sta diversificando in crepes dolci, tronchetti di ghiaccio e dessert surgelati. Vi piacerà!"
    ],
    "fr": [
      "Commerce yssingelais proposant des glaces toute l’année, se diversifie en concoctant aussi des crêpes sucrées, des bûches glacées, des entremets glacés. Vous allez adorer !"
    ],
    "es": [
      "Este negocio de Yssingel ofrece helados todo el año, y ahora se está diversificando en crepes dulces, troncos de hielo y postres helados. ¡Le va a encantar!"
    ],
    "nl": [
      "Dit bedrijf aan de Yssingel biedt het hele jaar door ijs aan en breidt nu uit met zoete crêpes, ijsblokken en diepvriesdesserts. Je zult er dol op zijn!"
    ]
  },
