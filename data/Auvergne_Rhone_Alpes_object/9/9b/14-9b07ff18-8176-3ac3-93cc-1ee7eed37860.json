  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/e032a742-8dea-3478-9635-fa54a656bce1",
      "dc:description": {
        "de": [
          "Accessoires für Frauen und Kinder.\nZubehör Haarspange Haargummi Stirnbänder.\nAccessoires Pochette Tasche Reisetasche Und Strandtasche.\n\nTäglich außer Montag und Dienstag (außer in den Schulferien) von 10:30 bis 13:00 Uhr und von 14:30 bis 19:00 Uhr geöffnet."
        ],
        "en": [
          "Women's and children's accessories.\nHair accessories barrette chouchou headbands.\nAccessories clutch bag travel bag and beach bag.\n\nOpen every day except Monday and Tuesday (except school holidays) from 10.30am to 1pm and from 2.30pm to 7pm."
        ],
        "it": [
          "Accessori per donna e bambino.\nAccessori per capelli: fermagli, scrunchies, fasce.\nAccessori pochette, borse da viaggio e borse da spiaggia.\n\nAperto tutti i giorni tranne il lunedì e il martedì (escluse le vacanze scolastiche) dalle 10.30 alle 13.00 e dalle 14.30 alle 19.00."
        ],
        "fr": [
          "Accessoires femme et enfant.\nAccessoire cheveux barrette chouchou bandeaux.\nAccessoires pochette sac sac de voyage Et de plage.\n\nOuvert tous les jours sauf lundi et mardi (hors vacance scolaires) de 10h30 à 13h et de 14h30 à 19h."
        ],
        "nl": [
          "Accessoires voor dames en kinderen.\nHaaraccessoires: haarclips, scrunchies, hoofdbanden.\nAccessoires koppeltas reistas en strandtas.\n\nElke dag geopend behalve maandag en dinsdag (behalve schoolvakanties) van 10.30 tot 13.00 uur en van 14.30 tot 19.00 uur."
        ],
        "es": [
          "Accesorios para mujeres y niños.\nAccesorios para el pelo: pinzas, coleteros, diademas.\nAccesorios bolso de mano bolso de viaje y bolso de playa.\n\nAbierto todos los días excepto lunes y martes (salvo vacaciones escolares) de 10.30 a 13.00 h y de 14.30 a 19.00 h."
        ]
      },
