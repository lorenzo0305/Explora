  "rdfs:comment": {
    "de": [
      "Der kleine Zug führt Sie durch die Straßen von Aurec, die von der Semène\r\nbis zur Freizeitanlage zur Freude aller.\r\n\r\nKein Verkehr am Sonntag, den 7. Juli und am Wochenende vom 13. bis 14. Juli 2024."
    ],
    "en": [
      "The little train takes you through the streets of Aurec from Semène\r\nto the leisure center for all to enjoy.\r\n\r\nNo traffic on Sunday July 7 and the weekend of July 13-14, 2024."
    ],
    "it": [
      "Il trenino attraversa le strade dell'Aurec, da Semène\r\nfino al centro ricreativo per il divertimento di tutti.\r\n\r\nDomenica 7 luglio e il fine settimana del 13-14 luglio 2024 non c'è traffico."
    ],
    "fr": [
      "Le petit train vous fait visiter les rues d'Aurec allant de Semène\r\njusqu'à la base de loisirs pour le plaisir de tous.\r\n\r\nPas de circulation le dimanche 7 juillet et le week-end du 13-14 juillet 2024."
    ],
    "nl": [
      "Het treintje rijdt door de straten van Aurec van Semène\r\nnaar het recreatiecentrum waar iedereen kan genieten.\r\n\r\nGeen verkeer op zondag 7 juli en het weekend van 13-14 juli 2024."
    ],
    "es": [
      "El trenecito te lleva por las calles de Aurec desde Semène\r\nhasta el centro de ocio para disfrute de todos.\r\n\r\nSin tráfico el domingo 7 de julio y el fin de semana del 13-14 de julio de 2024."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Petit train touristique"
    ]
  },
