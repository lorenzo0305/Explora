  "rdfs:comment": {
    "de": [
      "Seit mehr als zwanzig Jahren ist der in Die ansässige Cirque Trottola mit seinen poetischen Shows voller fröhlicher Nostalgie auf den Straßen unterwegs."
    ],
    "en": [
      "For over twenty years, Die-based Cirque Trottola has been criss-crossing the roads with its poetic, joyfully nostalgic shows."
    ],
    "it": [
      "Il Cirque Trottola, con sede a Die, gira il mondo con i suoi spettacoli gioiosamente nostalgici e poetici da oltre vent'anni."
    ],
    "fr": [
      "Voilà plus de vingt ans que le Cirque Trottola, basé à Die, sillonne les routes avec ses spectacles poétiques à la nostalgie joyeuse."
    ],
    "es": [
      "El Cirque Trottola, con sede en Die, lleva más de veinte años recorriendo el mundo con sus espectáculos alegremente nostálgicos y poéticos."
    ],
    "nl": [
      "Cirque Trottola, gevestigd in Die, toert al meer dan twintig jaar de wereld rond met zijn nostalgische, poëtische shows."
    ]
  },
