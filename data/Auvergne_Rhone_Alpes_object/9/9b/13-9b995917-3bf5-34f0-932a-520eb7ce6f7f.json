  "rdfs:comment": {
    "de": [
      "Die im Herzen des Dorfes gelegene Metzgerei Trinquet hat eine Spezialität: \"die Wurst\", die in einem natürlichen Keller hergestellt wird. Hier finden Sie auch \"hausgemachte\" Fertiggerichte, Wurstwaren, Geflügel und Fleisch von Erzeugern aus der Region."
    ],
    "en": [
      "Located in the heart of the village, the Trinquet butcher's speciality is sausages made in a natural cellar. You'll also find home-cooked meals, charcuterie, poultry and meats from local producers."
    ],
    "it": [
      "Situata nel cuore del villaggio, la macelleria Trinquet ha una specialità: \"le saucisson\" prodotto in una cantina naturale. Troverete anche piatti fatti in casa, salumi, pollame e carne di produttori locali."
    ],
    "fr": [
      "Située au cœur du village, la boucherie Trinquet a une spécialité : « le saucisson » fait dans une cave naturelle. Retrouvez également des plats cuisinés « fait maison », charcuteries, volailles et viandes des producteurs de la région."
    ],
    "es": [
      "Situada en el corazón del pueblo, la carnicería Trinquet tiene una especialidad: \"le saucisson\" elaborado en una bodega natural. También encontrará platos caseros, embutidos, aves y carnes de productores locales."
    ],
    "nl": [
      "De slagerij van Trinquet ligt in het hart van het dorp en is gespecialiseerd in worsten die in een natuurlijke kelder worden gemaakt. Je vindt er ook huisgemaakte kant-en-klaarmaaltijden, vleeswaren, gevogelte en vlees van lokale producenten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Boucherie Trinquet"
    ]
  },
