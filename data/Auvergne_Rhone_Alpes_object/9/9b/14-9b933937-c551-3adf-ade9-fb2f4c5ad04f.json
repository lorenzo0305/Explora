  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/57a79106-99c6-34f3-8caf-e6430871c7d6",
      "dc:description": {
        "de": [
          "Die Association Berckoise des Amis du Cinéma organisiert ihren A.B.A.C.-Abend.\n\nVorführung des Films \"Rêves, Amour, Désir\" (Träume, Liebe, Verlangen) mit anschließender Animation im Saal.\n\nUm 20 Uhr im CINOS.\n\nDer Eintritt kostet nur 6? Infos und Reservierungen unter www.cinos.fr"
        ],
        "en": [
          "The Association Berckoise des Amis du Cinéma organizes its A.B.A.C. evening.\n\nScreening of the film \"Rêves, Amour, Désir\" followed by an animation in the theater.\n\nAt 8pm at CINOS.\n\nPrice: 6? Information and reservations at www.cinos.fr"
        ],
        "it": [
          "L'Association Berckoise des Amis du Cinéma organizza la sua serata A.B.A.C.\n\nProiezione del film \"Rêves, Amour, Désir\" (Sogni, Amore, Desiderio) seguita da intrattenimento in sala.\n\nAlle 20.00 al CINOS.\n\nBiglietto unico di 6 euro. Informazioni e prenotazioni su www.cinos.fr"
        ],
        "fr": [
          "L’Association Berckoise des Amis du Cinéma organise sa soirée A.B.A.C.\n\nProjection du film « Rêves, Amour, Désir » suivie d’une animation en en salle.\n\nA 20h au CINOS.\n\nTarif unique de 6€. Infos et réservations sur www.cinos.fr"
        ],
        "es": [
          "La Association Berckoise des Amis du Cinéma organiza su velada A.B.A.C.\n\nProyección de la película \"Rêves, Amour, Désir\" (Sueños, Amor, Deseo) seguida de animación en el cine.\n\nA las 20.00 h en CINOS.\n\nPrecio de la entrada única: 6 euros. Información y reservas en www.cinos.fr"
        ],
        "nl": [
          "De Association Berckoise des Amis du Cinéma organiseert haar A.B.A.C. avond.\n\nVertoning van de film \"Rêves, Amour, Désir\" (Dromen, Liefde, Verlangen) gevolgd door entertainment in de bioscoop.\n\nOm 20.00 uur in CINOS.\n\nPrijs voor één kaartje: 6 euro. Informatie en reserveringen op www.cinos.fr"
        ]
      },
