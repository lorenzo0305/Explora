  "rdfs:comment": {
    "de": [
      "Solérieux ist das Schaufenster eines außergewöhnlichen Terroirs aus Lavendel, Trüffeleichen und Weinreben. Das Dorf liegt inmitten einer Ebene, umgeben von Bauernhöfen und trug früher den Namen des Heiligen Raphael."
    ],
    "en": [
      "This village once went by the name of Saint Raphaël. Lying amidst a plain of farmland displaying lavender fields, truffle oaks and vineyards, it showcases what is best in the terroir of Provence."
    ],
    "it": [
      "Solèrieux è il più piccolo villaggio della Drôme Sud Provence. Si può scoprire la cappella di Saint Raphaël, costruita dai Templari nel XII secolo, e poi, durante la visita, un mulino del XVI secolo sopra un lago."
    ],
    "fr": [
      "Solèrieux est le plus petit village du territoire de Drôme Sud Provence. On peut y découvrir la chapelle Saint Raphaël, édifiée par les Templiers au XIIè siècle puis au gré de la visite, au-dessus d'un plan d'eau, un moulin datant du XVIè siècle."
    ],
    "es": [
      "Solèrieux es el pueblo más pequeño de la zona de Drôme Sud Provence. Podrá descubrir la capilla de Saint Raphaël, construida por los templarios en el siglo XII, y luego, al visitarla, un molino del siglo XVI sobre un lago."
    ],
    "nl": [
      "Gelegen in het hart van de open vlakte, en omringd door boerderijen, heette deze “vitrine” van een bijzonder landschap getint door lavendel, truffeleiken en wijnstokken, vroeger Saint Raphaël."
    ]
  },
