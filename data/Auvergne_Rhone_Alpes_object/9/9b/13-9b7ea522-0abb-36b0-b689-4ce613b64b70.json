  "rdfs:comment": {
    "de": [
      "Die Brasserie \"Le Manago\" lädt Sie ein, ihre traditionelle Küche zu entdecken. Mittagskarte und Tagesmenü von Montag bis Samstag. Freitagabend Burger vor Ort oder zum Mitnehmen."
    ],
    "en": [
      "The Brasserie \"Le Manago\" invites you to discover its traditional cuisine. Menu of the day and lunchtime menu from Monday to Saturday. Friday evening burgers on the spot or to take away."
    ],
    "it": [
      "La Brasserie \"Le Manago\" vi invita a scoprire la sua cucina tradizionale. Menu del giorno e menu a pranzo dal lunedì al sabato. Il venerdì sera hamburger sul posto o da asporto."
    ],
    "fr": [
      "La Brasserie \"Le Manago\" vous invite à découvrir sa cuisine traditionnelle. Carte et menu du jour le midi du Lundi au Samedi. Vendredi soir burgers sur place ou à emporter."
    ],
    "es": [
      "La Brasserie \"Le Manago\" le invita a descubrir su cocina tradicional. Menú del día y menú de mediodía de lunes a sábado. Las hamburguesas de los viernes por la noche en el lugar o para llevar."
    ],
    "nl": [
      "De Brasserie \"Le Manago\" nodigt u uit om zijn traditionele keuken te ontdekken. Dagmenu en lunchmenu van maandag tot zaterdag. Vrijdagavond hamburgers ter plaatse of om mee te nemen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Brasserie le Manago"
    ]
  },
