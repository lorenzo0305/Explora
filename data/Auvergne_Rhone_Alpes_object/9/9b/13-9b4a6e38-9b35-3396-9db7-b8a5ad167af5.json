  "rdfs:comment": {
    "de": [
      "Entdecken Sie in einer herzlichen und entspannten Atmosphäre die abwechslungsreiche Speisekarte des Restaurants La Carbonara mit zahlreichen italienischen Spezialitäten und köstlichen Tagesgerichten."
    ],
    "en": [
      "Typical italian restaurant."
    ],
    "it": [
      "In un'atmosfera calda e rilassata, venite a scoprire il variegato menu del ristorante Carbonara, con le sue numerose specialità italiane e i deliziosi piatti del giorno."
    ],
    "fr": [
      "Dans une ambiance chaleureuse et décontractée, venez découvrir la carte très variée du restaurant la Carbonara, avec ses nombreuses spécialités italiennes et ses délicieux plats du jour."
    ],
    "nl": [
      "Kom in een warme en ontspannen sfeer het gevarieerde menu van restaurant Carbonara ontdekken, met zijn vele Italiaanse specialiteiten en heerlijke dagschotels."
    ],
    "es": [
      "En un ambiente cálido y relajado, venga a descubrir la variada carta del restaurante Carbonara, con sus numerosas especialidades italianas y sus deliciosos platos del día."
    ]
  },
