  "rdfs:comment": {
    "de": [
      "In der Nähe des Kinos und zwischen dem Espace Saint-Germain und dem öffentlichen Garten gelegen, können Sie hier Ihren Geschmack mit trendigen japanischen Spezialitäten erweitern, die Sie vor Ort verzehren, mitnehmen oder sich sogar liefern lassen können."
    ],
    "en": [
      "Located near the cinema and between the Espace Saint-Germain and the public garden, here's something to broaden your tastes with trendy Japanese specialities to eat on the spot to take away or even to have delivered."
    ],
    "it": [
      "Situato vicino al cinema e tra l'Espace Saint-Germain e il giardino pubblico, questo locale è in grado di soddisfare i vostri gusti con specialità giapponesi alla moda da mangiare, da portare via o da farvi consegnare."
    ],
    "fr": [
      "Situé près du cinéma et entre l'Espace Saint-Germain et le jardin public, voici de quoi élargir vos goûts avec des spécialités tendance japonaises à consommer sur place à emporter ou même à se faire livrer."
    ],
    "es": [
      "Situado cerca del cine y entre el Espace Saint-Germain y el jardín público, aquí podrá ampliar sus gustos con especialidades japonesas de moda para comer en casa, para llevar o incluso para pedir que le lleven."
    ],
    "nl": [
      "In de buurt van de bioscoop en tussen het Espace Saint-Germain en de openbare tuin vindt u hier iets om uw smaak te verbreden met trendy Japanse specialiteiten om te eten, mee te nemen of zelfs te laten bezorgen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Sushi Smile"
    ]
  },
