  "rdfs:comment": {
    "de": [
      "Entdecken Sie auf dem Gelände einer alten Burg die Produkte unseres Bauernhofs: Naturweine (Le Grand Raymond), prickelnder Rosé, in Eichenfässern gereifter Rotwein, Cidre. Besuchen Sie die Außenanlagen der Anlage, eine außergewöhnliche Sonnenuhr auf einem Turm."
    ],
    "en": [
      "On the site of an ancient fortified castle, discover the products of our farm: natural wines (Le Grand Raymond), sparkling rosé, oak-aged reds, ciders. Visit the exterior of the site, featuring an exceptional sundial on a tower."
    ],
    "it": [
      "Sul sito di un antico castello fortificato, scoprite i prodotti della nostra azienda agricola: vini naturali (Le Grand Raymond), rosé frizzanti, rossi invecchiati in rovere e sidri. Visitate l'esterno del sito, con la sua eccezionale meridiana su una torre."
    ],
    "fr": [
      "Sur le site d'un ancien château fort, découvrez les produits de notre ferme : vins naturels (Le Grand Raymond), rosé pétillant, rouge vieilli en fut de chêne, cidres. Visitez les extérieurs du site, cadran solaire exceptionnel sur une tour."
    ],
    "nl": [
      "Ontdek op de plek van een oud versterkt kasteel de producten van onze boerderij: natuurlijke wijnen (Le Grand Raymond), mousserende rosé, rode wijnen van eikenhout en ciders. Bezoek de buitenkant van de site, met zijn uitzonderlijke zonnewijzer op een toren."
    ],
    "es": [
      "En el emplazamiento de un antiguo castillo fortificado, descubra los productos de nuestra granja: vinos naturales (Le Grand Raymond), rosado espumoso, tintos envejecidos en roble y sidras. Visite el exterior del recinto, con su excepcional reloj de sol sobre una torre."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les gourmandises du château de Péchot"
    ]
  },
