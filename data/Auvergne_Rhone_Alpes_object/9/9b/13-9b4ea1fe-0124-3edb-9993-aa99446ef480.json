  "rdfs:comment": {
    "de": [
      "Die Freizeitanlage Val Dore liegt 200 m vom Bahnhof Ambert entfernt und somit ganz in der Nähe des Stadtzentrums. Sie erstreckt sich rund um einen See mit Strand.\r\nBADEN VERBOTEN."
    ],
    "en": [
      "Tree-covered park with a lake, playgrounds, fitness path, picnic area, aquapark, fishing pond. In summer, enjoy a supervised swimming with the attractions of a leisure park: bouncy castles, trampoline, power boats. Swimming is forbidden."
    ],
    "it": [
      "Situato a 200 m dalla stazione di Ambert e quindi molto vicino al centro città, il centro ricreativo di Val Dore si estende intorno a uno specchio d'acqua con spiaggia attrezzata.\r\nDIVIETO DI BALNEAZIONE."
    ],
    "fr": [
      "Située à 200m de la gare d’Ambert et donc toute proche du centre-ville, la base de loisirs Val Dore s’étend tout autour d’un plan d’eau avec plage aménagée.\r\nBAIGNADE INTERDITE."
    ],
    "es": [
      "Situado a 200 m de la estación de Ambert y, por tanto, muy cerca del centro de la ciudad, el centro de ocio Val Dore se extiende alrededor de una extensión de agua con playa equipada.\r\nPROHIBIDO BAÑARSE."
    ],
    "nl": [
      "Het recreatiecentrum van Val Dore, gelegen op 200 m van het station van Ambert en dus heel dicht bij het stadscentrum, strekt zich uit rond een stuk water met een uitgerust strand.\r\nZWEMMEN VERBODEN."
    ]
  },
