  "rdfs:comment": {
    "de": [
      "Das Hébert-Museum, das im Sommerhaus des Malers Ernest Hébert (1817-1908) untergebracht ist, bietet die Möglichkeit, die Atmosphäre eines Künstlerhauses aus dem 19. Jahrhundert nachzuempfinden und die Karriere dieses virtuosen Porträtmalers zu entdecken."
    ],
    "en": [
      "The renovated property of painter Ernest Hébert invites visitors to step into the artist's 19th century world and to discover his work through the presentation of his collections."
    ],
    "it": [
      "Ospitato nella casa estiva del pittore Ernest Hébert (1817-1908), il Museo Hébert offre la possibilità di ritrovare l'atmosfera di una casa d'artista del XIX secolo e di scoprire la carriera di questo virtuoso ritrattista."
    ],
    "fr": [
      "Installé dans la maison d’été du peintre Ernest Hébert (1817-1908), le musée Hébert offre la possibilité de retrouver l'atmosphère d'une maison d'artiste du 19e siècle et de découvrir la carrière de ce portraitiste virtuose."
    ],
    "es": [
      "La antigua residencia del pintor Ernest Hébert (1817-1908), calificado como \"Casa de los ilustres\", es un testimonio raro de casa de artista en la región Rhône-Alpes."
    ],
    "nl": [
      "Het Museum Hébert, gevestigd in het zomerhuis van de schilder Ernest Hébert (1817-1908), biedt de mogelijkheid om de sfeer van een 19e-eeuws kunstenaarshuis te herontdekken en de carrière van deze virtuoze portrettist te ontdekken."
    ]
  },
