  "rdfs:comment": {
    "de": [
      "Die Kirche Saint-Barthélemy ist ein romanisch-byzantinisches Kirchengebäude in der Gemeinde Grézieu-le-Marché im Département Rhône in der Region Auvergne-Rhône-Alpes."
    ],
    "en": [
      "The Saint-Barthélemy church is a Romanesque-Byzantine religious building located in the commune of Grézieu-le-Marché in the Rhône department, in the Auvergne-Rhône-Alpes region."
    ],
    "it": [
      "La chiesa di Saint-Barthélemy è un edificio religioso romanico-bizantino situato nel comune di Grézieu-le-Marché, nel dipartimento del Rodano, nella regione dell'Alvernia-Rodano-Alpi."
    ],
    "fr": [
      "L'église Saint-Barthélemy est un édifice religieux romano-byzantin situé dans la commune de Grézieu-le-Marché dans le département du Rhône, en région Auvergne-Rhône-Alpes."
    ],
    "es": [
      "La iglesia de Saint-Barthélemy es un edificio religioso románico-bizantino situado en la comuna de Grézieu-le-Marché, en el departamento del Ródano, en la región de Auvernia-Ródano-Alpes."
    ],
    "nl": [
      "De kerk Saint-Barthélemy is een Romaans-Byzantijns religieus gebouw in de gemeente Grézieu-le-Marché in het departement Rhône, in de regio Auvergne-Rhône-Alpes."
    ]
