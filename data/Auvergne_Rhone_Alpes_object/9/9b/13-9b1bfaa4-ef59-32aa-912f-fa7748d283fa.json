  "rdfs:comment": {
    "de": [
      "Wir sind ein kleiner Bauernhof in den Vallons du Lyonnais und bieten eine breite Palette an Milchprodukten aus reiner Ziegenmilch an, die von frisch bis zu mehreren Monaten gereift reichen."
    ],
    "en": [
      "A small farm located in the Vallons du Lyonnais, we offer a wide range of pure farm goat dairy products, from fresh to matured for several months."
    ],
    "it": [
      "Piccola azienda agricola situata nei Vallons du Lyonnais, offriamo un'ampia gamma di prodotti lattiero-caseari di pura capra di fattoria, da freschi a stagionati per diversi mesi."
    ],
    "fr": [
      "Ferme de petite taille située dans les Vallons du Lyonnais, nous proposons une gamme variée de produits laitiers  pur chèvre fermier se déclinant du frais à l’affiné de plusieurs mois."
    ],
    "es": [
      "Pequeña granja situada en los Vallons du Lyonnais, ofrecemos una amplia gama de productos lácteos puros de cabra de granja, desde frescos hasta madurados durante varios meses."
    ],
    "nl": [
      "Als kleine boerderij in de Vallons du Lyonnais bieden we een breed assortiment pure boerderijgeitenmelkproducten, van vers tot gerijpt voor meerdere maanden."
    ]
  },
  "rdfs:label": {
