  "rdfs:comment": {
    "de": [
      "Der Bob Park ist eine 2 km lange Rodelbahn mit Steilkurven, Tunneln, Westernatmosphäre und ist je nach Bedingungen geöffnet. Kinder von 5 bis 10 Jahren in Begleitung eines Erwachsenen auf dem Schlitten. Es besteht die Möglichkeit, den eigenen Skihelm zu benutzen."
    ],
    "en": [
      "The Bob Park is a 2 km toboggan run with banked turns, tunnels, western atmosphere and opening depending on conditions. Children from 5 to 10 years old accompanied by one adult in the sled. Possibility to use your own ski helmet."
    ],
    "it": [
      "Il Bob Park è una pista per slittini di 2 km con curve a gomito, tunnel, atmosfera western ed è aperto a seconda delle condizioni. I bambini dai 5 ai 10 anni sono accompagnati da un adulto sulla slitta. È possibile utilizzare il proprio casco da sci."
    ],
    "fr": [
      "Le Bob Park est une piste de luge sur 2 km avec virages relevés, tunnels, ambiance western et ouverture selon conditions. Enfants de 5 à 10 ans accompagnés d'un adulte dans la luge. Possibilité d’utiliser son propre casque de ski."
    ],
    "nl": [
      "Het Bob Park is een 2 km lange rodelbaan met scherpe bochten, tunnels, een westernsfeer en is geopend afhankelijk van de omstandigheden. Kinderen van 5 tot 10 jaar mogen onder begeleiding van een volwassene op de slee. Je kunt je eigen skihelm gebruiken."
    ],
    "es": [
      "El Bob Park es una pista de trineo de 2 km con curvas peraltadas, túneles, ambiente del oeste y abierta según las condiciones. Niños de 5 a 10 años acompañados de un adulto en el trineo. Pueden utilizar su propio casco de esquí."
    ]
  },
