  "rdfs:comment": {
    "de": [
      "In Siaugues-Sainte-Marie befinden sich die Ruinen eines feudalen Schlosses aus dem 14. Jahrhundert (privat). Vom Gipfel des La Durande auf 1299 m hat man einen weiten Rundblick (Orientierungstisch) sowie das Maar de Limagne, ein ehemaliges Torfmoor in einem Vulkankrater."
    ],
    "en": [
      "Siaugues-Sainte-Marie boasts the ruins of a 14th-century feudal castle (privately owned). The summit of La Durande, at 1,299 m, offers a vast panorama (orientation table) and the Limagne maar, an ancient peat bog in a volcano crater."
    ],
    "it": [
      "Siaugues-Sainte-Marie ospita le rovine di un castello feudale del XIV secolo (di proprietà privata). Dalla cima di La Durande, a 1.299 m, si gode di una vista panoramica (tabella di orientamento) e del Limagne maar, un'antica torbiera nel cratere di un vulcano."
    ],
    "fr": [
      "A Siaugues-Sainte-Marie se trouvent les ruines d’un château féodal du XIVe siècle (privé). Au sommet de La Durande, à 1 299 m, on observe un vaste panorama (table d'orientation) ainsi que le maar de Limagne, ancienne tourbière dans un cratère de volcan."
    ],
    "es": [
      "Siaugues-Sainte-Marie alberga las ruinas de un castillo feudal del siglo XIV (de propiedad privada). En la cima de La Durande, a 1.299 m, hay una vista panorámica (tabla de orientación), así como el maar de Limagne, una antigua turbera en el cráter de un volcán."
    ],
    "nl": [
      "In Siaugues-Sainte-Marie vind je de ruïnes van een feodaal kasteel uit de 14e eeuw (privébezit). Op de top van La Durande, op 1.299 m, heb je een panoramisch uitzicht (oriëntatietafel) en de Limagne maar, een oud veenmoeras in een vulkaankrater."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Village | Siaugues-Sainte-Marie"
    ]
  },
