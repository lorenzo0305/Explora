  "rdfs:comment": {
    "de": [
      "Wir bieten verschiedene Arten von alkoholfreien Getränken (Säfte, Smoothies, Kaffee, Tee usw.) und Gebäck an, alles selbstgemacht, mit frischen, saisonalen, überwiegend biologischen und lokalen Produkten.\r\nWir bieten auch veganes Catering an."
    ],
    "en": [
      "We offer different types of non-alcoholic drinks (juices, smoothies, coffees, teas, etc.) pastries, all homemade, with fresh, seasonal, mostly organic and local products.\r\nWe also offer plant-based catering services."
    ],
    "it": [
      "Offriamo una gamma di bevande analcoliche (succhi, frullati, caffè, tè, ecc.) e dolci, tutti fatti in casa con prodotti freschi, di stagione, per lo più biologici e locali.\r\nOffriamo anche servizi di catering a base vegetale."
    ],
    "fr": [
      "Nous proposons différents types de boissons sans alcool (jus, smoothies, cafés, thés, etc.) des pâtisseries, le tout fait-maison, avec des produits frais, de saison, majoritairement bio et locaux.\r\nNous proposons aussi des services de traiteur végétal."
    ],
    "es": [
      "Ofrecemos una gama de bebidas sin alcohol (zumos, batidos, cafés, tés, etc.) y bollería, todo hecho en casa con productos frescos, de temporada, en su mayoría ecológicos y locales.\r\nTambién ofrecemos servicios de catering a base de plantas."
    ],
    "nl": [
      "La Baravane à Jus is een Eriba-caravan uit 1978 die is omgetoverd tot een sap- en smoothiebar. Het serveert zelfgemaakte drankjes en gebak, met verse, seizoensgebonden, biologische en voornamelijk lokale producten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Baravane à Jus - Bar à boissons sans alcool itinérant"
    ]
  },
