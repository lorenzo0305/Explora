  "rdfs:comment": {
    "de": [
      "Entdecken Sie einen authentischen Ort mit traditioneller und berühmter Handwerkskunst. Hier finden Sie eine große Auswahl an Brotsorten, die in einer geschichtsträchtigen Mühle hergestellt werden, und können so den Geschmack des Brotes von früher wiederentdecken!"
    ],
    "en": [
      "Discover an authentic place with traditional and renowned know-how. Rediscover the taste of bread from days gone by with a wide range of breads made in a mill steeped in history!"
    ],
    "it": [
      "Scoprite un luogo autentico con un'esperienza tradizionale e rinomata. Riscoprite il gusto del pane di una volta con un'ampia selezione di pani prodotti in un mulino ricco di storia!"
    ],
    "fr": [
      "Découvrez un lieu authentique au savoir-faire traditionnel et réputé. Retrouvez le goût du pain d’autrefois à travers une large sélection de pains confectionnés dans un moulin chargé d’histoire !"
    ],
    "nl": [
      "Ontdek een authentieke plek met traditionele en gerenommeerde expertise. Herontdek de smaak van brood uit vervlogen tijden met een ruime keuze aan broden gemaakt in een molen met een rijke geschiedenis!"
    ],
    "es": [
      "Descubra un lugar auténtico con un saber hacer tradicional y reconocido. Redescubra el sabor del pan de antaño con una amplia selección de panes elaborados en un molino cargado de historia"
    ]
  },
  "rdfs:label": {
    "en": [
      "Au Four et au Moulin d'Arche bakery"
    ],
    "fr": [
      "Au Four et au Moulin d'Arche"
    ]
  },
