  "rdfs:comment": {
    "de": [
      "Die Gemeinde Lans en Vercors bietet zwei offene Tennisplätze sowie eine Trainingswand.\r\nDer Boden der Trainingswand verfügt über Pickleball-Routen.\r\nDie Plätze wurden im Mai 2025 renoviert."
    ],
    "en": [
      "The commune of Lans en Vercors offers 2 open tennis courts and a training wall.\r\nThe training wall features Pickleball tracks.\r\nRefurbished in May 2025."
    ],
    "it": [
      "Lans en Vercors dispone di 2 campi da tennis aperti e di un muro di allenamento.\r\nIl pavimento del muro di allenamento è dotato di piste per il Pickleball.\r\nI campi sono stati ristrutturati nel maggio 2025."
    ],
    "fr": [
      "La commune de Lans en Vercors propose 2 courts de tennis découverts, ainsi qu'un mur d'entrainement.\r\nLe sol du mur d'entrainement dispose de tracés de Pickleball. \r\nTerrains remis à neuf en mai 2025."
    ],
    "nl": [
      "Lans en Vercors heeft 2 open tennisbanen en een trainingsmuur.\r\nOp de vloer van de trainingsmuur liggen Pickleballbanen.\r\nDe banen zijn in mei 2025 gerenoveerd."
    ],
    "es": [
      "Lans en Vercors cuenta con 2 pistas de tenis abiertas y un muro de entrenamiento.\r\nEl suelo del muro de entrenamiento tiene pistas de Pickleball.\r\nLas pistas se renovaron en mayo de 2025."
    ]
  },
