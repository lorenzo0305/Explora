          "additionalInformation": {
            "de": [
              "Öffnung der Tennisplätze außerhalb der winterlichen Schneeperiode. Vermietung der Tennisplätze beim Fremdenverkehrsamt von Lans en Vercors. Schlüsselübergabe zu den Öffnungszeiten des Fremdenverkehrsamts von Lans-en-Vercors."
            ],
            "en": [
              "Tennis courts open outside the winter snow season. Courts can be hired from the Lans-en-Vercors Tourist Office. Keys handed over during Lans-en-Vercors Tourist Office opening hours."
            ],
            "it": [
              "Campi da tennis aperti al di fuori della stagione invernale della neve. I campi possono essere noleggiati presso l'Ufficio del Turismo di Lans-en-Vercors. Consegna delle chiavi durante gli orari di apertura dell'Ufficio del Turismo di Lans-en-Vercors."
            ],
            "fr": [
              "Ouverture des tennis en dehors de la période hivernale de neige. Location des courts à l'Office de Tourisme de Lans en Vercors. Remise des clés sur les horaires de l'Office de Tourisme de Lans-en-Vercors."
            ],
            "nl": [
              "Tennisbanen geopend buiten het winterse sneeuwseizoen. Banen kunnen worden gehuurd bij het toeristenbureau van Lans-en-Vercors. Sleutels afgeven tijdens openingstijden bij het toeristenbureau van Lans-en-Vercors."
            ],
            "es": [
              "Pistas de tenis abiertas fuera de la temporada de nieve invernal. Las pistas pueden alquilarse en la Oficina de Turismo de Lans-en-Vercors. Entrega de llaves en horario de apertura en la Oficina de Turismo de Lans-en-Vercors."
            ]
          },
