  "rdfs:comment": {
    "de": [
      "Odile und Franck GAUBERT sowie ihr Team freuen sich, Sie in ihrem Haus in Cayres begrüßen zu dürfen, das nur 2 Minuten vom See von Bouchet entfernt liegt."
    ],
    "en": [
      "Odile and Franck GAUBERT and their team are delighted to welcome you to their establishment in Cayres, 2 minutes from Lac du Bouchet."
    ],
