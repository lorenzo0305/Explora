  "rdfs:comment": {
    "de": [
      "Mit seinen von Malern geschätzten Orten, seinem Bahnhof, seinen Sportanlagen und seinem historischen Reichtum liegt St Victor sur Rhins in einem wunderschönen, engen und steilen Tal in der Nähe von Amplepuis, Thizy und Roanne."
    ],
    "en": [
      "With its famous painting sites, railway station, sports facilities and historical treasures, St Victor sur Rhins is located in a magnificent, steep, narrow valley, close to Amplepuis, Thizy and Roanne."
    ],
    "it": [
      "Con i suoi famosi siti pittorici, la stazione ferroviaria, le strutture sportive e i tesori storici, St Victor sur Rhins si trova in una magnifica valle stretta e ripida, vicino ad Amplepuis, Thizy e Roanne."
    ],
    "fr": [
      "Avec ses sites appréciés des peintres, sa gare, ses équipements sportifs et ses richesses historiques, St Victor sur Rhins est situé dans une magnifique vallée resserrée et escarpée, à proximité d’Amplepuis, de Thizy et de Roanne."
    ],
    "nl": [
      "Met zijn beroemde schilderplaatsen, station, sportfaciliteiten en historische schatten ligt St Victor sur Rhins in een prachtige, steile, smalle vallei, dicht bij Amplepuis, Thizy en Roanne."
    ],
    "es": [
      "Con sus famosos lugares de pintura, su estación de ferrocarril, sus instalaciones deportivas y sus tesoros históricos, St Victor sur Rhins está enclavado en un magnífico valle estrecho y escarpado, cerca de Amplepuis, Thizy y Roanne."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Village de Saint Victor Sur Rhins"
    ]
  },
