  "rdfs:comment": {
    "de": [
      "Inaltérable entwirft hochwertige Möbel aus Edelstahl, die für eine lange Lebensdauer konzipiert sind.\r\n\r\nDas schlichte Design, der echte Komfort und die Widerstandsfähigkeit gegen äußere Einflüsse bestimmen die zeitlosen, individuell gestaltbaren Stücke, die sich an Orte des Lebens und der Geselligkeit richten."
    ],
    "en": [
      "Is it in the volutes created for his beautiful stone house that Clément Ferrari, ironmonger and furniture designer, finds his inspiration? He transforms metal into a work of art with creativity, skill and the passion of a master craftsman."
    ],
    "it": [
      "Inaltérable progetta mobili in acciaio inossidabile di alta gamma costruiti per durare nel tempo.\r\n\r\nDesign elegante, comfort reale e resistenza all'uso esterno definiscono pezzi personalizzabili e senza tempo, dedicati ai luoghi di vita e di socializzazione."
    ],
    "fr": [
      "Inaltérable conçoit du mobilier haut de gamme en inox pensé pour durer. \r\n\r\nDesign épuré, confort réel et résistance aux usages extérieurs définissent des pièces intemporelles, personnalisables, dédiées aux lieux de vie et de convivialité."
    ],
    "nl": [
      "Inaltérable ontwerpt roestvrijstalen meubelen van topkwaliteit die gemaakt zijn om lang mee te gaan.\r\n\r\nStrak design, echt comfort en weerstand tegen gebruik buitenshuis definiëren tijdloze, aanpasbare stukken die speciaal bestemd zijn voor plaatsen waar mensen wonen en samenzijn."
    ],
    "es": [
      "Inaltérable diseña muebles de acero inoxidable de alta gama fabricados para durar.\r\n\r\nDiseño depurado, confort real y resistencia a la intemperie definen piezas atemporales y personalizables dedicadas a los lugares donde se vive y se socializa."
    ]
  },
  "rdfs:label": {
