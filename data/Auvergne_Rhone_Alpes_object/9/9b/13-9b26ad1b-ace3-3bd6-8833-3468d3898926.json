  "rdfs:comment": {
    "de": [
      "In einer schicken und natürlichen Umgebung können Sie eine Küche mit frischen und saisonalen Produkten genießen.\r\nVon der Vorspeise bis zum Dessert werden Sie von den Köchen überrascht."
    ],
    "en": [
      "In a  natural but stylish and tranquil  setting, discover traditional cuisine prepared with fresh, seasonal products. Situated in an old refurbished barn  only 7 km from the famous Postman Cheval's Ideal Palace in Hauterives."
    ],
    "it": [
      "In un ambiente elegante e naturale, gustate una cucina a base di prodotti freschi e di stagione.\r\nDagli antipasti ai dessert, i nostri chef vi sorprenderanno."
    ],
    "fr": [
      "Dans un cadre chic et naturel, dégustez une cuisine à base de produits frais et de saison.\r\nDe l'entrée au dessert, les chefs vous surprendront."
    ],
    "nl": [
      "Traditionele keuken op basis van verse seizoensproducten, in een rustige, natuurlijke, stijlvolle omgeving. Op 7 km van Hauterives en het Palais Idéal du facteur Cheval is het restaurant gevestigd in een oude gerestaureerde schuur."
    ],
    "es": [
      "En un entorno elegante y natural, disfrute de una cocina basada en productos frescos de temporada.\r\nDesde los entrantes hasta los postres, nuestros chefs le sorprenderán."
    ]
  },
