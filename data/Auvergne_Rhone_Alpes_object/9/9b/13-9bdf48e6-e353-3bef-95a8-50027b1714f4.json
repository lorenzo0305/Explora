  "rdfs:comment": {
    "de": [
      "Im Zentrum des Skigebiets gelegen, qualitativ hochwertiges Fast Food, geöffnet von 9 bis 22 Uhr\r\nMenüs vor Ort oder zum Mitnehmen: klassische Hamburger und Berghamburger, Wraps, Sandwiches, Bowls, Brunch, hausgemachte Desserts, Getränke, Flaschenbier und Fassbier"
    ],
    "en": [
      "Located in the centre of the resort, warm Anglo-Saxon atmosphere.\r\nMenus on the spot or to take away: hamburgers, pizzas, pasta, pancakes, cakes, drinks, salad, draught beer."
    ],
    "it": [
      "Situato nel centro del resort, caldo ambiente anglosassone.\r\nMenu in loco o da asporto: hamburger, pizze, pasta, frittelle, torte, dolci, bevande, insalata, birra alla spina."
    ],
    "fr": [
      "Situé au centre de la station, fast food de qualité ouvert de 9h à 22h \r\nMenus sur place où à emporter : hamburgers classiques et montagnard , wraps , sandwichs, bowls,, brunch, desserts maison ,boisson, bières bouteilles et pression"
    ],
    "es": [
      "Situado en el centro de la estación, este restaurante de comida rápida de calidad abre de 9.00 a 22.00 horas\r\nMenús para comer o llevar: hamburguesas clásicas y de montaña, wraps, sándwiches, bowls, brunch, postres caseros, bebidas, cervezas embotelladas y de barril"
    ],
    "nl": [
      "Dit fastfoodrestaurant van hoge kwaliteit ligt in het centrum van het resort en is geopend van 9.00 tot 22.00 uur\r\nMenu's om te eten of mee te nemen: klassieke en bergburgers, wraps, sandwiches, bowls, brunch, huisgemaakte desserts, drankjes, flessenbier en tapbier"
    ]
  },
