  "rdfs:comment": {
    "de": [
      "Im Herzen von Chinaillon gelegen, finden Sie hier alle Informationen, die Sie für einen reibungslosen Ablauf Ihres Aufenthalts benötigen, mit verschiedenen Serviceleistungen: Wickel- und Kinderecke, verlorene Gegenstände, ..."
    ],
    "en": [
      "Located in the heart of Chinaillon, you will find all the information you need for a smooth stay with different services: changing and children's corner, lost and found, ..."
    ],
    "it": [
      "Situato nel cuore di Chinaillon, troverete tutte le informazioni necessarie per rendere il vostro soggiorno un successo, con vari servizi: angolo cambio e bambini, oggetti smarriti, ecc."
    ],
    "fr": [
      "Situé au coeur du Chinaillon, vous y trouverez toutes les informations nécessaires au bon déroulement de votre séjour avec différents services : coin change et enfant, objets perdus, ..."
    ],
    "es": [
      "Situado en el corazón de Chinaillon, encontrará toda la información necesaria para que su estancia sea un éxito, con varios servicios: rincón para cambiar y para niños, objetos perdidos, etc."
    ],
    "nl": [
      "In het hart van Chinaillon vindt u alle informatie om uw verblijf tot een succes te maken, met verschillende diensten: verkleedhoek en kinderhoek, verloren voorwerpen, enz."
    ]
  },
