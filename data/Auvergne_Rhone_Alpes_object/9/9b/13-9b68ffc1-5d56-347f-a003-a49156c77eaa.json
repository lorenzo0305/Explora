  "rdfs:comment": {
    "de": [
      "Frische, hausgemachte Produkte. Regionale Küche.\r\nEs wird mit Schiefertafel gearbeitet, die Karte, wechselt regelmäßig.\r\nAusgewählt und empfohlen von Gault et Millau 2025.\r\nReservierung empfohlen."
    ],
    "en": [
      "Fresh, home-made products. Regional cuisine.\r\nThe menu changes regularly.\r\nSelected and recommended by Gault et Millau 2025.\r\nBooking recommended."
    ],
    "it": [
      "Prodotti freschi e fatti in casa. Cucina regionale.\r\nIl menu cambia regolarmente.\r\nSelezionato e raccomandato da Gault et Millau 2025.\r\nSi consiglia la prenotazione."
    ],
    "fr": [
      "Produits frais, fait maison. Cuisine régionale.\r\nOn travaille à l'ardoise, la carte, change régulièrement.\r\nSélectionné et recommandé Gault et Millau 2025.\r\nRéservation conseillée."
    ],
    "nl": [
      "Verse, zelfgemaakte producten. Regionale keuken.\r\nHet menu verandert regelmatig.\r\nGeselecteerd en aanbevolen door Gault et Millau 2025.\r\nReserveren aanbevolen."
    ],
    "es": [
      "Productos frescos y caseros. Cocina regional.\r\nEl menú cambia regularmente.\r\nSeleccionado y recomendado por Gault et Millau 2025.\r\nSe recomienda reservar."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Relais de La Toinette"
    ]
  },
