  "rdfs:comment": {
    "de": [
      "Von \"Les étapes savoureuses Ardèche\" und \"Goûtez l'Ardèche®\" ausgewähltes Unternehmen. Vinaigrerie Handwerkliche Senfmühle, die eine althergebrachte Methode anwendet, um hochwertige Produkte aus ausschließlich lokalen Rohstoffen herzustellen. Limonade. Senföl und Senfflocken."
    ],
    "en": [
      "Vinegar manufacturer since 2009.\r\nHigh-quality vinegar made the traditional way using exclusively local ingredients.\r\nFrench quality label \"Goûtez l'Ardèche\". Lemonade. Mustard oil and mustard flakes."
    ],
    "it": [
      "Azienda selezionata da \"Les étapes savoureuses Ardèche\" e \"Goûtez l'Ardèche®\". Vinaigrerie Fabbrica di senape artigianale che utilizza un metodo ancestrale per produrre prodotti di alta gamma utilizzando solo materie prime locali. Limonata"
    ],
    "fr": [
      "Entreprise sélectionnée par « Les étapes savoureuses Ardèche » et « Goûtez l'Ardèche® ». Vinaigrerie Moutarderie artisanale utilisant une méthode ancestrale pour fabriquer des produits haut de gamme avec des matières premières uniquement locales. Limonade"
    ],
    "nl": [
      "Onderneming geselecteerd door \"Les étapes savoureuses Ardèche\" en \"Goûtez l'Ardèche®\". Ambachtelijke mosterd- en azijnfabriek die met behulp van een ouderwetse methode een topgamma producten maakt, met alleen lokale grondstoffen. Limonade. Mosterdolie en mosterdvlokken."
    ],
    "es": [
      "Empresa seleccionada por \"Les étapes savoureuses Ardèche\" y \"Goûtez l'Ardèche®\". Vinaigrerie Fábrica artesanal de mostaza que utiliza un método ancestral para elaborar productos de gama alta utilizando únicamente materias primas locales. Limonada"
    ]
  },
