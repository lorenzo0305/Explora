  "rdfs:comment": {
    "de": [
      "Eine herrliche Luftwanderung um den See (1000 m senkrecht über ihm), um die unglaubliche Landschaft und den Panoramablick auf die Alpen und die Haute Savoie zu genießen."
    ],
    "en": [
      "A wonderful air trip around the lake (1000 metres above it) to enjoy incredible landscapes and a panomaric view of the Alps and Haute Savoie."
    ],
    "it": [
      "Una magnifica escursione aerea intorno al lago (1000 m di dislivello) per godere dell'incredibile scenario e della vista panoramica sulle Alpi e sull'Alta Savoia."
    ],
    "fr": [
      "Une magnifique randonnée aérienne autour du lac (1000 m à sa verticale) afin de profiter des paysages incroyables et d’une vue panoramique des Alpes et de la Haute Savoie."
    ],
    "es": [
      "Una magnífica caminata aérea alrededor del lago (1000 m de verticalidad) para disfrutar del increíble paisaje y la vista panorámica de los Alpes y la Alta Saboya."
    ],
    "nl": [
      "Een prachtige luchtwandeling rond het meer (1000 m verticaal) om te genieten van het ongelooflijke landschap en het panoramische uitzicht op de Alpen en de Haute Savoie."
    ]
  },
  "rdfs:label": {
    "en": [
      "Air hike by helicopter microlight - 30min"
    ],
    "fr": [
      "Randonnée aérienne en hélico ulm - 30min"
    ]
  },
