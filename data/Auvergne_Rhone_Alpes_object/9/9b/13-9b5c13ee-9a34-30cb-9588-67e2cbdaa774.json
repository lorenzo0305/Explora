  "rdfs:comment": {
    "de": [
      "In der Sonne oder am Kamin, unten auf den Pisten von La Daille, OK oder Diebold, empfängt Sie das Bar-Restaurant \"Les Equinoxes\" vom Frühstück bis zum Abendessen."
    ],
    "en": [
      "In the sun or by the fireside, at the bottom of the slopes of La Daille, OK or Diebold, the Bar-Restaurant \"Les Equinoxes\" welcomes you from breakfast to dinner."
    ],
    "it": [
      "Al sole o accanto al camino, ai piedi delle piste della Daille, OK o Diebold, il Bar-Ristorante \"Les Equinoxes\" vi accoglie dalla colazione alla cena."
    ],
    "fr": [
      "Au soleil ou au coin du feu, en bas des pistes de la Daille, OK ou Diebold, le Bar-Restaurant \"Les Equinoxes\" vous accueille du petit-déjeuner au dîner."
    ],
    "nl": [
      "In de zon of bij het vuur, aan de voet van de Daille, OK of Diebold pistes, de Bar-Restaurant \"Les Equinoxes\" heet u welkom van ontbijt tot diner."
    ],
    "es": [
      "Al sol o junto al fuego, a los pies de las pistas de Daille, OK o Diebold, el Bar-Restaurante \"Les Equinoxes\" le da la bienvenida desde el desayuno hasta la cena."
    ]
  },
