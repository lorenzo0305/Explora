  "rdfs:comment": {
    "de": [
      "100% vitaminisierte Improvisation: Schreiben Sie Ihre verrücktesten Themen auf, sie improvisieren für Sie!\r\nVitamin Impro Show ist ein belebendes Impro-Kabarett, getragen von Improvisationskünstlern mit exotischen Hemden und einigen magischen Ukulele-Akkorden."
    ],
    "en": [
      "100% vitamin-packed improv: write down your wildest themes, and they'll improvise for you!\r\nVitamine Improv Show is an invigorating improv cabaret, featuring improvisers in exotic shirts and a few magical ukulele chords."
    ],
    "it": [
      "Improvvisazione 100% vitaminica: scrivete i vostri temi più selvaggi e loro improvviseranno per voi!\r\nVitamine impro show è un cabaret di improvvisazione vivace, eseguito da improvvisatori in camicie esotiche e qualche magico accordo di ukulele."
    ],
    "fr": [
      "De l’impro 100% vitaminée : écrivez vos thèmes les plus fous, ils improvisent pour vous !\r\nVitamine impro show c’est un cabaret d’impro tonique, portés par des improvisateurs aux chemises exotiques et quelques accords de ukulélé magiques."
    ],
    "es": [
      "Improvisación 100% vitaminada: ¡escribe tus temas más locos y ellos improvisarán por ti!\r\nVitamine impro show es un cabaret de improvisación animada, interpretada por improvisadores con camisas exóticas y unos cuantos acordes mágicos de ukelele."
    ],
    "nl": [
      "100% improvisatie boordevol vitaminen: schrijf je wildste thema's op en zij improviseren voor je!\r\nVitamine impro show is een cabaret van levendige improvisatie, uitgevoerd door improvisatoren in exotische shirts en een paar magische ukelele akkoorden."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Théâtre d'impro : Vitamine impro show"
    ]
  },
