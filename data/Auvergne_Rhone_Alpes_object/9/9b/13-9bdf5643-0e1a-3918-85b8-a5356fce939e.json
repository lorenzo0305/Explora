  "rdfs:comment": {
    "de": [
      "Die Brasserie Lyon Plage empfängt Sie in einem eleganten, nautischen Rahmen, der für Abwechslung sorgt. Chefkoch Clément Lopez und sein gesamtes Team bereiten Ihnen jeden Tag eine gesunde Küche mit mediterranen Akzenten zu, die mit saisonalen Produkten zubereitet wird."
    ],
    "en": [
      "The Brasserie Lyon Plage welcomes you to an elegant and exotic nautical setting. Chef Clément Lopez and his team prepare healthy cuisine with Mediterranean influences every day, using seasonal produce."
    ],
    "it": [
      "La Brasserie Lyon Plage vi accoglie in un ambiente nautico elegante ed esotico. Ogni giorno, lo chef Clément Lopez e il suo team preparano una sana cucina mediterranea con prodotti di stagione."
    ],
    "fr": [
      "La Brasserie Lyon Plage vous accueille dans un cadre nautique élégant et dépaysant. Le Chef Clément Lopez et toute son équipe vous concoctent chaque jour une cuisine saine aux accents méditerranéens, réalisée avec des produits de saison."
    ],
    "es": [
      "La Brasserie Lyon Plage le da la bienvenida en un ambiente náutico elegante y exótico. Cada día, el Chef Clément Lopez y su equipo preparan una cocina mediterránea saludable con productos de temporada."
    ],
    "nl": [
      "De Brasserie Lyon Plage heet u welkom in een elegante en exotische nautische omgeving. Chef-kok Clément Lopez en zijn team bereiden elke dag gezonde mediterrane gerechten met seizoensproducten."
    ]
  },
