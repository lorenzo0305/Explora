  "rdfs:comment": {
    "de": [
      "Le Spot Mont-Blanc - Restaurant & Bar: ein einzigartiges kulinarisches Erlebnis auf den Pisten. \r\nEingebettet in das Hotel Arbois Bettex bietet Ihnen unser Restaurant & Bar einen atemberaubenden Blick auf den Mont Blanc, ideal für eine Gourmet-Pause."
    ],
    "en": [
      "Le Spot Mont-Blanc - Restaurant & Bar: a unique culinary experience on the slopes. \r\nNested in the Hôtel Arbois Bettex ***, our Restaurant & Bar offers an impregnable view of the Mont Blanc, ideal for a gourmet break."
    ],
    "it": [
      "Le Spot Mont-Blanc - Restaurant & Bar: un'esperienza culinaria unica sulle piste. \r\nSituato all'interno dell'Hôtel Arbois Bettex, il nostro Restaurant & Bar offre una vista mozzafiato sul Monte Bianco, ideale per una pausa gourmet."
    ],
    "fr": [
      "Le Spot Mont-Blanc - Restaurant & Bar : une expérience culinaire unique sur des pistes. \r\nNiché dans l’Hôtel Arbois Bettex, notre Restaurant & Bar vous offre une vue imprenable sur le Mont Blanc, idéal pour une pause gourmande."
    ],
    "es": [
      "Le Spot Mont-Blanc - Restaurante & Bar: una experiencia culinaria única en las pistas. \r\nUbicado en el Hôtel Arbois Bettex, nuestro Restaurante & Bar ofrece una vista impresionante del Mont Blanc, ideal para una escapada gourmet."
    ],
    "nl": [
      "Le Spot Mont-Blanc - Restaurant & Bar: een unieke culinaire ervaring op de piste. \r\nOns Restaurant & Bar, genesteld in Hôtel Arbois Bettex, biedt een adembenemend uitzicht op de Mont Blanc, ideaal voor een gastronomische pauze."
    ]
  },
