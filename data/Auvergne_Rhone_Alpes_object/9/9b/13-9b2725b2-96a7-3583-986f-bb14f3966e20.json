  "rdfs:comment": {
    "de": [
      "In der Nähe des Bahnhofs bietet Ihnen das Hotel Ô p'tit Bouillon einen herzlichen Empfang in neuem Rahmen."
    ],
    "en": [
      "Near the station, Hotel Ô p'tit Bouillon offers you a warm welcome in a brand new setting."
    ],
    "it": [
      "Situato di fronte alla stazione ferroviaria, in una zona residenziale, l'hotel Ô p'tit Bouillon dispone di 6 camere calde e moderne, tra cui una per ospiti disabili. Per la cena, il ristorante offre un vassoio caldo o freddo da portare in camera."
    ],
    "fr": [
      "Situé face à la gare, dans un quartier résidentiel, l'hôtel Ô p'tit Bouillon dispose de 6 chambres chaleureuses et modernes  dont une PMR. Pour le dîner, le restaurant vous propose un plateau repas froid ou chaud à prendre en chambre."
    ],
    "es": [
      "Situado frente a la estación de tren, en una zona residencial, el hotel Ô p'tit Bouillon dispone de 6 habitaciones cálidas y modernas, incluida una para minusválidos. Para cenar, el restaurante ofrece una bandeja caliente o fría para llevar a la habitación."
    ],
    "nl": [
      "Hotel Ô p'tit Bouillon ligt tegenover het treinstation in een woonwijk en beschikt over 6 warme en moderne kamers, waaronder een kamer voor mindervaliden. Voor het diner biedt het restaurant een warm of koud dienblad dat u op uw kamer kunt nuttigen."
    ]
  },
