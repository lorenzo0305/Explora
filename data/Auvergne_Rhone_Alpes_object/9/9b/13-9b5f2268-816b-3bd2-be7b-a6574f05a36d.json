  "rdfs:comment": {
    "de": [
      "Dieses Museum der neuen Generation befindet sich auf dem Plateau von Gergovia und lässt Groß und Klein anhand von archäologischen Objekten und Multimedia-Geräten in den Gallischen Krieg zwischen Vercingetorix und Cäsar eintauchen."
    ],
    "en": [
      "Located on the Gergovie plateau, this new-generation museum plunges young and old alike into the Gallic War between Vercingetorix and Caesar, with archaeological artifacts and multimedia displays."
    ],
    "it": [
      "Situato sull'altopiano di Gergovie, questo museo di nuova generazione immerge grandi e piccini nella guerra gallica tra Vercingetorige e Cesare, grazie a oggetti archeologici e allestimenti multimediali."
    ],
    "fr": [
      "Situé sur le plateau de Gergovie, ce musée nouvelle génération plonge petits et grands dans la Guerre des Gaules entre Vercingétorix et César, grâce à des objets archéologiques et des dispositifs multimédias."
    ],
    "es": [
      "Situado en la meseta de Gergovie, este museo de nueva generación sumerge a grandes y pequeños en la Guerra de las Galias entre Vercingetórix y César, gracias a objetos arqueológicos y exposiciones multimedia."
    ],
    "nl": [
      "Dit museum van de nieuwe generatie ligt op het plateau van Gergovie en dompelt jong en oud onder in de Gallische oorlog tussen Vercingetorix en Caesar dankzij archeologische voorwerpen en multimediapresentaties."
    ]
  },
