  "rdfs:comment": {
    "de": [
      "Als Handelsvertreterin für das Netzwerk 3G IMMO-CONSULTANT, ein Netzwerk von erfahrenen Fachleuten, die auf die Vermittlung von Immobilien spezialisiert sind, stelle ich meine Professionalität in den Dienst unserer Verkäufer und Käufer."
    ],
    "en": [
      "Sales representative for the 3G IMMO-CONSULTANT network; a network of experienced professionals specialising in property transactions, I put my professionalism at the service of our sellers and buyers."
    ],
    "it": [
      "Agente commerciale della rete 3G IMMO-CONSULTANT, una rete di professionisti esperti specializzati in transazioni immobiliari, metto la mia professionalità al servizio dei nostri venditori e acquirenti."
    ],
    "fr": [
      "Agent Commercial pour le réseau 3G IMMO-CONSULTANT,  réseau de professionnels expérimentés et  spécialistes dans la transaction de biens immobiliers, je mets mon professionnalisme au service de nos vendeurs et acquéreurs."
    ],
    "nl": [
      "Kopen? Makelaar Legget, uw expert in lokaal vastgoed, agent FNAIM, verkozen tot beste internationale agent in Frankrijk sinds 4 jaar. \r\nVerkopen? Toegang tot 5.4 miljoen kopers van over heel de wereld dankzij onze Marketing International."
    ],
    "es": [
      "Agente comercial de la red 3G IMMO-CONSULTANT, una red de profesionales experimentados especializados en transacciones inmobiliarias, pongo mi profesionalidad al servicio de nuestros vendedores y compradores."
    ]
  },
