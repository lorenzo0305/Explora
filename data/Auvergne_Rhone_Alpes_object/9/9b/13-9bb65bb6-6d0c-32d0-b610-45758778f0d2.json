  "rdfs:comment": {
    "de": [
      "Unsere Region ist ein Paradies für Angler und verfügt über zahlreiche Wasserläufe ( l'Arve, le Borne, le Foron, le Foron en 1ère catégorie...) oder Seen für Familien- oder Sportfischerei."
    ],
    "en": [
      "A fisherman's paradise, our region boasts numerous rivers (the Arve, the Borne, the Foron, the 1st category Foron...) and lakes for family or sport fishing."
    ],
    "it": [
      "Paradiso dei pescatori, la nostra regione offre numerosi fiumi (l'Arve, il Borne, il Foron, il Foron di 1ª categoria...) o laghi per la pesca familiare o sportiva."
    ],
    "fr": [
      "Paradis des pêcheurs, notre région possède de nombreux cours d'eau ( l'Arve, le Borne, le Foron, le Foron en 1ère catégorie...) ou lacs pour une pêche familiale ou sportive."
    ],
    "es": [
      "Paraíso de los pescadores, nuestra región cuenta con numerosos ríos (el Arve, el Borne, el Foron, el Foron de 1ª categoría...) o lagos para la pesca familiar o deportiva."
    ],
    "nl": [
      "Onze regio is een paradijs voor vissers en heeft vele rivieren (de Arve, de Borne, de Foron, de Foron in 1e categorie...) of meren om met het gezin of sportief te vissen."
    ]
  },
