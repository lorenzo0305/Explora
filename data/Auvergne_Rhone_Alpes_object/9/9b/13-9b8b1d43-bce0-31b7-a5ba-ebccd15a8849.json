  "rdfs:comment": {
    "de": [
      "Ein idyllischer Ort für Spaziergänge mit einem zentralen Teich in der Nähe des Schwimmbads und des Campingplatzes.\r\nEine 1,2 km lange Strecke verläuft entlang des Flusses Chalaronne und schlängelt sich durch einen kleinen schattigen Erlenhain."
    ],
    "en": [
      "A bucolic walk with a central pond near the swimming pool and campsite.\r\nA 1.2 km path winds along the Chalaronne through a shady alder grove."
    ],
    "it": [
      "Una passeggiata bucolica con uno stagno centrale vicino alla piscina e al campeggio.\r\nUn sentiero di 1,2 km si snoda lungo le rive della Chalaronne attraverso un piccolo e ombroso ontaneto."
    ],
    "fr": [
      "Lieu de promenade bucolique avec un étang central situé à proximité de la piscine et du camping. \r\nUn parcours de 1,2 km chemine le long de la Chalaronne et serpente dans une petite aulnaie ombragée."
    ],
    "es": [
      "Un paseo bucólico con un estanque central cerca de la piscina y el camping.\r\nUn sendero de 1,2 km serpentea a orillas del Chalaronne por un pequeño bosquecillo de alisos sombreado."
    ],
    "nl": [
      "Een landelijke wandeling met een centrale vijver in de buurt van het zwembad en de camping.\r\nEen pad van 1,2 km slingert langs de oevers van de Chalaronne door een klein schaduwrijk elzenbosje."
    ]
  },
