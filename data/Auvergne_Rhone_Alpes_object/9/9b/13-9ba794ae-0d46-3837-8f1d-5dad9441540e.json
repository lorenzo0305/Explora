  "rdfs:comment": {
    "de": [
      "Verkauf von biodynamischem Gemüse und Setzlingen.\r\nKeine Behandlungen, manuelles Sammeln und Pflanzen.\r\nKein Kauf von Setzlingen, wir machen sie alle selbst.\r\nAnbau auf Stroh, mit sehr wenig Bewässerung.\r\nErhalt der Biodiversität."
    ],
    "en": [
      "Market gardening"
    ],
    "it": [
      "Vendita di ortaggi e piante biodinamiche.\r\nNessun trattamento, raccolta manuale e messa a dimora.\r\nNessun acquisto di piante, le produciamo tutte noi.\r\nColtivazione su paglia, con pochissime annaffiature.\r\nMantenere la biodiversità."
    ],
    "fr": [
      "Vente de légumes et plants en Biodynamie.\r\nAucun traitement, ramassage et plantation manuel.\r\nAucun achat de plants, nous les faisons tous nous même.\r\nCulture sur paille, avec très peu d'arrosage.\r\nMaintient de la biodiversité."
    ],
    "nl": [
      "Verkoop van biodynamische groenten en planten.\r\nGeen behandeling, handmatig verzamelen en planten.\r\nGeen aankoop van planten, we maken ze allemaal zelf.\r\nTeelt op stro, met zeer weinig water.\r\nHoudt de biodiversiteit in stand."
    ],
    "es": [
      "Venta de verduras y plantas biodinámicas.\r\nSin tratamiento, recogida y plantación manual.\r\nNo se compran plantas, las hacemos todas nosotros.\r\nCultivo sobre paja, con muy poco riego.\r\nMantiene la biodiversidad."
    ]
  },
