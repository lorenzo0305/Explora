  "rdfs:comment": {
    "de": [
      "La Grange de Pépé ist vor allem eine Geschichte, die einer Familie, die von den Traditionen und dem Terroir der Nord-Isère geprägt ist. Wir haben uns entschieden, unsere Geschichte mit den Geschmäckern der Menschen zu erzählen, die wir kennen..."
    ],
    "en": [
      "La Grange de Pépé is above all a story, the story of a family steeped in the traditions and terroir of the Nord-Isère region. Often, stories are told in words, and we've chosen to tell ours with tastes..."
    ],
    "it": [
      "La Grange de Pépé è soprattutto una storia, la storia di una famiglia immersa nelle tradizioni e nel terroir della regione Nord-Isère. Spesso le storie si raccontano con le parole, e noi abbiamo scelto di raccontare la nostra con i sapori..."
    ],
    "fr": [
      "La Grange de Pépé, c’est avant tout une histoire, celle d’une famille bercée par les traditions et le terroir du Nord-Isère. Souvent, les histoires se racontent avec des mots, nous avons choisi de narrer la notre avec les goûts..."
    ],
    "nl": [
      "La Grange de Pépé is vooral een verhaal, het verhaal van een familie die doordrenkt is van de tradities en het terroir van de regio Nord-Isère. Verhalen worden vaak verteld in woorden, en wij hebben ervoor gekozen om het onze te vertellen met smaken..."
    ],
    "es": [
      "La Grange de Pépé es ante todo una historia, la historia de una familia impregnada de las tradiciones y el terruño de la región de Nord-Isère. A menudo, las historias se cuentan con palabras, y nosotros hemos elegido contar la nuestra con sabores..."
    ]
  },
  "rdfs:label": {
