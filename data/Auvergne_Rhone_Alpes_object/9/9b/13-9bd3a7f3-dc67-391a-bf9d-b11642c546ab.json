  "rdfs:comment": {
    "de": [
      "Boutique-Werkstatt von Kunsthandwerkerinnen: Huit cents grammes, Mlle Aubergine, Sous les yeux de Jeanne und Sur le balcon.\r\nSchmuck, Deko, Illustration, Töpferei, Lederwaren, Seife, Kosmetik...\r\nVerkauf von Kunsthandwerk und zahlreiche angebotene Workshops."
    ],
    "en": [
      "Boutique-atelier d'artisanes: Huit cents grammes, Mlle Aubergine, Sous les yeux de Jeanne and Sur le balcon.\r\nJewelry, home decor, illustration, pottery, leather goods, soap, cosmetics...\r\nCraft sales, and many workshops on offer."
    ],
    "it": [
      "Boutique-laboratorio artigianale: Huit cents grammes, Mlle Aubergine, Sous les yeux de Jeanne e Sur le balcon.\r\nGioielleria, decorazione, illustrazione, ceramica, pelletteria, sapone, cosmetici...\r\nArtigianato in vendita e molti laboratori in offerta."
    ],
    "fr": [
      "Boutique-atelier d'artisanes : Huit cents grammes, Mlle Aubergine, Sous les yeux de Jeanne et Sur le balcon.\r\nBijoux, déco, illustration, poterie, maroquinerie, savon, cosmétique...\r\nVente d'artisanat, et de nombreux ateliers proposés."
    ],
    "es": [
      "Taller boutique-artesanal: Huit cents grammes, Mlle Aubergine, Sous les yeux de Jeanne y Sur le balcon.\r\nJoyería, decoración, ilustración, cerámica, marroquinería, jabón, cosmética...\r\nVenta de artesanía y numerosos talleres en oferta."
    ],
    "nl": [
      "Boetiek-artisanale werkplaats: Huit cents grammes, Mlle Aubergine, Sous les yeux de Jeanne en Sur le balcon.\r\nSieraden, decoratie, illustraties, aardewerk, lederwaren, zeep, cosmetica...\r\nHandwerk te koop en veel workshops in de aanbieding."
    ]
  },
