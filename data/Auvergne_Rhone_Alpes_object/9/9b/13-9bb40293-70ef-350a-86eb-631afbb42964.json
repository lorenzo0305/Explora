  "rdfs:comment": {
    "de": [
      "Tanzen Sie bei diesem großen Musikfest im Freien! Nehmen Sie teil an der Begegnung Frankreich / England von DJs, die sich gegenseitig herausfordern und von einem Ende des Platzes zum anderen antworten. Ein unumgängliches Fest im Herzen von Méribel."
    ],
    "en": [
      "Come and dance the night away! Join DJs from France and England as they challenge and respond to each other from one end of the square to the other. A festive event not to be missed in the heart of Méribel."
    ],
    "it": [
      "Venite a ballare tutta la notte! Unitevi ai DJ di Francia e Inghilterra che si sfidano e si rispondono da un capo all'altro della piazza. Una festa da non perdere nel cuore di Méribel."
    ],
    "fr": [
      "Venez danser lors de cette grande fête musicale en extérieure ! Participez à la rencontre France / Angleterre de DJ's qui se défient et se répondent d'un bout à l'autre de la place. Le rendez-vous festif incontournable au cœur de Méribel."
    ],
    "es": [
      "¡Ven a bailar toda la noche! Únase a los DJ's de Francia e Inglaterra que se desafían y responden de un extremo a otro de la plaza. Una fiesta ineludible en el corazón de Méribel."
    ],
    "nl": [
      "Kom en dans de hele nacht door op deze grote openlucht Disco Party! En neem deel aan de ontmoeting tussen de DJ's van Frankrijk en Engeland terwijl ze elkaar uitdagen en van de ene kant van het plein naar de andere reageren! Een niet te missen feest. Voor iedereen toegankelijk. Komt allen, komt allen"
    ]
  },
  "rdfs:label": {
    "en": [
