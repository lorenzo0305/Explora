  "rdfs:comment": {
    "de": [
      "Entdecken Sie mit Familie oder Freunden inmitten der Natur die Guinguette de la ferme de Samson (10 Min. vom Zentrum von Saint-Péray entfernt). Lokale Produkte Kochen Braséro zu entdecken..."
    ],
    "en": [
      "With family or friends, come and discover the Guinguette de la ferme de Samson (10 mins from the centre of Saint-Péray).\r\nShop and café 100% local produce, children's games, natural swimming pool and farm animals.\r\nWood-fired Braséro plancha on summer evenings."
    ],
    "it": [
      "In famiglia o con gli amici, venite a scoprire la Guinguette de la ferme de Samson (a 10 minuti dal centro di Saint-Péray). Scoprite i prodotti locali cucinati in un braciere..."
    ],
    "fr": [
      "En famille ou entre amis, venez découvrir en pleine nature la Guinguette de la ferme de Samson (à 10 mn du centre de Saint-Péray). Produits locaux cuisson braséro à découvrir..."
    ],
    "nl": [
      "Kom met familie of vrienden de Guinguette de la ferme de Samson ontdekken (op 10 minuten van het centrum van Saint-Péray). Lokale producten bereid in een..."
    ],
    "es": [
      "En familia o entre amigos, venga a descubrir la Guinguette de la ferme de Samson (a 10 minutos del centro de Saint-Péray). Descubra los productos locales cocinados en brasero..."
    ]
  },
