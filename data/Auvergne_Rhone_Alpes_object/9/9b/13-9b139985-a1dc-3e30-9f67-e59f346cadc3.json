  "rdfs:comment": {
    "de": [
      "Entdecken Sie Guillaume Fichet, ein Kind von Petit-Bornand und Pionier der Druckerei, in einer interaktiven Schnitzeljagd, die Rätsel, Humor und Abenteuer miteinander verbindet!\r\nErkunden Sie mithilfe der Baludik-App die Straßen des Dorfes und lösen Sie die Rätsel."
    ],
    "en": [
      "Discover Guillaume Fichet, a child of Petit-Bornand and pioneer of the printing industry, through an interactive treasure hunt combining riddles, humor and adventure!\r\nUsing the Baludik app, explore the village streets and solve the riddles."
    ],
    "it": [
      "Scoprite Guillaume Fichet, figlio di Petit-Bornand e pioniere dell'industria della stampa, attraverso una caccia al tesoro interattiva che unisce indovinelli, umorismo e avventura!\r\nUtilizzate l'app Baludik per esplorare le strade del villaggio e risolvere gli indovinelli."
    ],
    "fr": [
      "Partez à la découverte de Guillaume Fichet, enfant du Petit-Bornand et pionnier de l’imprimerie, à travers un jeu de piste interactif mêlant énigmes, humour et aventures!\r\nGrâce à l’application Baludik, explorez les rues du village et résolvez les énigmes."
    ],
    "nl": [
      "Ontdek Guillaume Fichet, kind van Petit-Bornand en pionier van de grafische industrie, via een interactieve schattenjacht die raadsels, humor en avontuur combineert!\r\nGebruik de Baludik-app om de straten van het dorp te verkennen en de raadsels op te lossen."
    ],
    "es": [
      "Descubre a Guillaume Fichet, niño de Petit-Bornand y pionero de la imprenta, a través de una búsqueda del tesoro interactiva que combina acertijos, humor y aventura\r\nUtilice la aplicación Baludik para explorar las calles del pueblo y resolver los enigmas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Jeu de piste - L'encre secrète de Guillaume Fichet"
    ]
  },
