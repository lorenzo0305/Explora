  "rdfs:comment": {
    "de": [
      "Führungen in Museen und an Kulturerbestätten, ein- oder zweistündige Stadtspaziergänge oder kombinierte Tagestouren, aber auch Familienveranstaltungen wie Schatzsuchen, Kreativworkshops..."
    ],
    "en": [
      "Guided tours in museums or historical sites, 1 or 2 hours urban walks, or for a whole day tour, but also family animations such as treasure hunts or cyanotype workshops."
    ],
    "it": [
      "Visite guidate a musei e siti del patrimonio, passeggiate in città della durata di 1 o 2 ore o tour giornalieri combinati, nonché attività per famiglie come cacce al tesoro e laboratori creativi..."
    ],
    "fr": [
      "Visites guidées dans les musées et sur les sites patrimoniaux, balades urbaines d'1 ou 2 heures ou combinées en circuit à la journée, mais aussi des animations familiales telles que chasses au trésor, ateliers créatifs..."
    ],
    "es": [
      "Visitas guiadas a museos y sitios patrimoniales, paseos por la ciudad de 1 ó 2 horas de duración o visitas combinadas de un día, así como actividades familiares como búsquedas del tesoro y talleres creativos..."
    ],
    "nl": [
      "Rondleidingen door musea en erfgoedlocaties, stadswandelingen van 1 of 2 uur of gecombineerde dagtochten, maar ook gezinsactiviteiten zoals speurtochten en creatieve workshops..."
    ]
  },
  "rdfs:label": {
    "en": [
      "Gin’Steve, your pocket guide !"
    ],
    "fr": [
      "GIN'Steve, votre guide de poche !"
    ]
  },
