  "rdfs:comment": {
    "de": [
      "In diesem Pavillon, der oberhalb von mittelalterlichen Gewölbekellern errichtet wurde, befinden sich der Hochzeitssaal und der Gemeinderatssaal. Gelegentlich werden hier Ausstellungen gezeigt."
    ],
    "en": [
      "The suburban building was built above vaulted caves dating back to the Middle Ages. It is used today as an annex to the town hall and hosts occasional exhibitions."
    ],
    "it": [
      "Costruito su cantine a volta risalenti al Medioevo, questo padiglione ospita la sala matrimoni e la sala del consiglio comunale, e occasionalmente ospita mostre."
    ],
    "fr": [
      "Construit au-dessus de caves voûtées datant du Moyen-Âge, ce pavillon abrite la salle des mariages et la salle du conseil municipal et accueille ponctuellement des expositions."
    ],
    "es": [
      "Este pabellón se construyó sobre bóvedas de la Edad Media. Hoy en día es utilizado como anexo de la alcaldía y presenta puntualmente exposiciones."
    ],
    "nl": [
      "Dit paviljoen, gebouwd op gewelfde kelders uit de Middeleeuwen, herbergt de trouwzaal en de gemeenteraadszaal en organiseert af en toe tentoonstellingen."
    ]
  },
