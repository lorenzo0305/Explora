  "rdfs:comment": {
    "de": [
      "Bereiten Sie sich auf eine außergewöhnliche musikalische Reise in einer außergewöhnlichen Umgebung vor!\r\nGrandiose klassische Konzerte, intime Liederabende, kostenlose Musikveranstaltungen und Lernangebote bestimmen den Tagesablauf."
    ],
    "en": [
      "Get ready for an extraordinary musical journey in an exceptional setting!\r\nThe day will be punctuated by grandiose classical music concerts, intimate recitals, free musical events and learning sessions."
    ],
    "it": [
      "Preparatevi a un viaggio musicale straordinario in un ambiente eccezionale!\r\nLa giornata sarà scandita da grandiosi concerti di musica classica, recital intimi, eventi musicali gratuiti e sessioni di apprendimento."
    ],
    "fr": [
      "Préparez-vous à vivre un voyage musical hors du commun dans un cadre exceptionnel !\r\nDes concerts de musique classique grandioses, des récitals intimistes, des événements musicaux gratuits, des séances d’apprentissage rythmeront la journée."
    ],
    "es": [
      "Prepárese para un extraordinario viaje musical en un marco excepcional\r\nEl día estará salpicado de grandiosos conciertos de música clásica, recitales íntimos, eventos musicales gratuitos y sesiones de aprendizaje."
    ],
    "nl": [
      "Bereid je voor op een buitengewone muzikale reis in een uitzonderlijke omgeving!\r\nDe dag wordt onderbroken door grootse klassieke muziekconcerten, intieme recitals, gratis muzikale evenementen en leersessies."
    ]
  },
