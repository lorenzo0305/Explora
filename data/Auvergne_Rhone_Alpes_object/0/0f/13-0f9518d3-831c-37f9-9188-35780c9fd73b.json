  "rdfs:comment": {
    "de": [
      "Eine handwerkliche Küche, eine gemütliche Bar am Fuße der Pisten und eine Sonnenterrasse mit atemberaubendem Blick auf die Aiguilles d'Arves.\r\nNew ! AFTER SKI-Ambiente (Montag und Donnerstag ab 16 Uhr): Elektro-Musik, Cocktails, Bier und kleine Snacks."
    ],
    "en": [
      "A cozy bar, homemade cooking right at the foot of the slopes, and a sunny terrace with stunning views of the Aiguilles d’Arves.\r\nNew! After-ski vibes with electro music, cocktails, beers and snacks every Monday and Thursday from 4 p.m."
    ],
    "it": [
      "Cucina tradizionale, bar accogliente ai piedi delle piste e terrazza soleggiata con vista ininterrotta sulle Aiguilles d'Arves.\r\nNuovo! Atmosfera AFTER SKI (lunedì e giovedì dalle 16:00): musica electro, cocktail, birre e snack."
    ],
    "fr": [
      "Une cuisine artisanale, un bar chaleureux au pied des pistes, et une terrasse ensoleillée avec vue imprenable sur les Aiguilles d’Arves.\r\nNew ! Ambiance AFTER SKI (lundi et jeudi à partir de 16h) : musique électro, cocktails, bières et petite restauration."
    ],
    "nl": [
      "Een ambachtelijke keuken, een gezellige bar aan de voet van de pistes en een zonnig terras met een adembenemend uitzicht op de Aiguilles d'Arves.\r\nNieuw! AFTER SKI-sfeer (maandag en donderdag vanaf 16.00 uur): elektronische muziek, cocktails, bier en kleine hapjes."
    ],
    "es": [
      "Cocina tradicional, un bar acogedor a pie de pistas y una terraza soleada con vistas ininterrumpidas a las Aiguilles d'Arves.\r\nNovedad Ambiente AFTER SKI (lunes y jueves a partir de las 16 h): música electro, cócteles, cervezas y aperitivos."
    ]
  },
