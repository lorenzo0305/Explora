  "rdfs:comment": {
    "de": [
      "Der Chéran, der als wilder, breiter und reißender Fluss ausgezeichnet wurde, bietet Ihnen hier ideale Bedingungen für das Fliegenfischen im Herzen des regionalen Naturparks Les Bauges."
    ],
    "en": [
      "The Chéran, labelled a wild, wide and torrential river, offers you ideal conditions for fly fishing in the heart of the Bauges Regional Natural Park."
    ],
    "it": [
      "Il Chéran, un fiume selvaggio, ampio e torrentizio, offre le condizioni ideali per la pesca a mosca nel cuore del Parco Naturale Regionale di Bauges."
    ],
    "fr": [
      "Le Chéran, labellisé rivière sauvage, large et torrentueuse, vous offre ici des conditions idéales pour la pêche à la mouche en plein cœur du Parc naturel régional des Bauges."
    ],
    "es": [
      "El Chéran, río salvaje, ancho y torrentoso, ofrece condiciones ideales para la pesca con mosca en pleno Parque Natural Regional de Bauges."
    ],
    "nl": [
      "De Chéran, een wilde, brede en woeste rivier, biedt ideale omstandigheden voor vliegvissen in het hart van het Regionale Natuurpark van de Bauges."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parcours de pêche « Prendre et relâcher » sur le Chéran et le Nant d’Aillon à leur confluence"
    ]
  },
