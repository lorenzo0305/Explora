  "rdfs:comment": {
    "de": [
      "Sylviane und Noémie züchten eine Herde von 80 Alpenziegen und empfangen Sie zum Direktverkauf ihrer Produkte. Chevrotin AOP, Käse und Milchprodukte. Kisten und Wurstwaren aus Schweinefleisch, Kalb- und Rindfleisch."
    ],
    "en": [
      "Slyviane and Noemie look after a flock of 80 Alpine goats and look forward to showing you their range of products on sale: AOP Chevrotin and other cheeses, as well as dairy products. Assorted cuts of pork, beef and veal available."
    ],
    "it": [
      "Sylviane e Noémie allevano una mandria di 80 capre alpine e vi invitano a vendere direttamente i loro prodotti. Chevrotin DOP, formaggi e prodotti caseari. Prodotti di maiale, vitello e manzo."
    ],
    "fr": [
      "Sylviane et Noémie élèvent un troupeau de 80 chèvres Alpines et vous accueillent pour la vente directe de leurs produits. Chevrotin AOP, fromages et produits laitiers. Caissette et charcuterie de porc, viande de veau et boeuf."
    ],
    "es": [
      "Sylviane y Noémie crían un rebaño de 80 cabras alpinas y le invitan a vender directamente sus productos. Chevrotin DOP, quesos y productos lácteos. Productos de cerdo, ternera y buey."
    ],
    "nl": [
      "Sylviane en Noémie houden een kudde van 80 alpengeiten en heten u welkom om hun producten rechtstreeks te verkopen. Chevrotin BOB, kazen en zuivelproducten. Varkens-, kalfs- en rundvleesproducten."
    ]
  },
  "rdfs:label": {
    "en": [
      "Le Clos aux chèvres"
    ],
    "fr": [
      "Le Clos aux chèvres"
    ]
  },
