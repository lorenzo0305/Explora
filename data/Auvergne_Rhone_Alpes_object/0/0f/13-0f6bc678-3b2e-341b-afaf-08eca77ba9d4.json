  "rdfs:comment": {
    "de": [
      "Der Allier zählt zu den letzten wilden Flüssen Europas. Sein Ökosystem ist aufgrund seiner Form und seiner Vielfalt außergewöhnlich. An Bord Ihres Kanus können Sie das Naturschauspiel auf sich wirken lassen."
    ],
    "en": [
      "The Allier is one of the last wild rivers in Europe. Its ecosystem is exceptional for its shape and diversity. On board your canoe, let the spectacle of nature overwhelm you."
    ],
    "it": [
      "L'Allier è uno degli ultimi fiumi selvaggi d'Europa. Il suo ecosistema è eccezionale per forma e diversità. A bordo della vostra canoa, lasciatevi avvolgere dallo spettacolo della natura."
    ],
    "fr": [
      "L'Allier compte parmi les dernières rivières sauvages d'Europe. Son écosystème est exceptionnel par sa forme et sa diversité. À bord de votre canoë, laissez le spectacle de la nature vous envahir."
    ],
    "es": [
      "El Allier es uno de los últimos ríos salvajes de Europa. Su ecosistema es excepcional por su forma y diversidad. A bordo de su canoa, déjese bañar por el espectáculo de la naturaleza."
    ],
    "nl": [
      "De Allier is een van de laatste wilde rivieren in Europa. Zijn ecosysteem is uitzonderlijk in zijn vorm en diversiteit. Aan boord van uw kano, laat u het spektakel van de natuur over u heen komen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Canoë en Terre d'Allier"
    ]
  },
