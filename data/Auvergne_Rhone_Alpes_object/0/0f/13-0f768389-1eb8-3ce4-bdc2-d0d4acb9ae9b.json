  "rdfs:comment": {
    "de": [
      "Im historischen Zentrum von Châtillon, gegenüber den Markthallen, empfängt Sie das \"comptoir des halles\" zu einem Burger, einer Pizza oder einem Stück Fleisch.\r\nEinfache und großzügige Küche in einem raffinierten Rahmen."
    ],
    "en": [
      "In the historical heart of Châtillon, located in front of the market hall, the comptoir des halles welcomes you for a burger, pizza or a piece of meat.\r\nSimple and generous cuisine in a refined setting."
    ],
    "it": [
      "Nel cuore storico di Châtillon, di fronte al mercato, il comptoir des halles vi accoglie per un hamburger, una pizza o un pezzo di carne.\r\nCucina semplice e generosa in un ambiente raffinato."
    ],
    "fr": [
      "Au cœur historique de Châtillon, situé en face des halles, le comptoir des halles vous accueille autour d'un  burger, pizza ou d'une pièce de viande.\r\nCuisine simple et généreuse dans un cadre raffiné."
    ],
    "nl": [
      "In het historische hart van Châtillon, tegenover de markthal, heet de comptoir des halles u welkom voor een hamburger, pizza of een stuk vlees.\r\nEenvoudige en gulle keuken in een verfijnd kader."
    ],
    "es": [
      "En el centro histórico de Châtillon, frente al mercado, el comptoir des halles le da la bienvenida para comer una hamburguesa, una pizza o un trozo de carne.\r\nCocina sencilla y generosa en un entorno refinado."
    ]
  },
  "rdfs:label": {
