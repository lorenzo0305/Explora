  "rdfs:comment": {
    "de": [
      "Heute Nacht schläft Little John nicht gut, und während er aufwacht, stellt er fest, dass seine Spielsachen zum Leben erwachen."
    ],
    "en": [
      "Tonight, Petit Jean doesn't sleep well and as he wakes up, he notices that his toys are coming to life."
    ],
    "it": [
      "La scorsa notte Petit Jean non ha dormito molto bene e quando si è svegliato ha notato che i suoi giocattoli avevano preso vita."
    ],
    "fr": [
      "Cette nuit, Petit Jean ne dort pas bien et tout en se réveillant, il constate que ses jouets prennent vie."
    ],
    "nl": [
      "Vannacht heeft Petit Jean niet zo goed geslapen en toen hij wakker werd, merkte hij dat zijn speelgoed tot leven was gekomen."
    ],
    "es": [
      "Anoche, Petit Jean no durmió muy bien y, cuando se despertó, se dio cuenta de que sus juguetes habían cobrado vida."
    ]
  },
  "rdfs:label": {
