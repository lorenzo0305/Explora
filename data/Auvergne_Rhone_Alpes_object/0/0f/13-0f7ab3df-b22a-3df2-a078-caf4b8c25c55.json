  "rdfs:comment": {
    "de": [
      "Was für ein atemberaubender Ausblick von der Panoramaterrasse... und was für ein Erlebnis auf dem Teller! Das GCC zieht eine Klientel leidenschaftlicher Genießer an, die alpine Spezialitäten und eine gemütliche Brasserieküche lieben."
    ],
    "en": [
      "What a breathtaking view from the panoramic terrace... and what an experience on the plate! The GCC attracts a clientele of passionate epicureans, lovers of Alpine specialties and warm brasserie cuisine."
    ],
    "it": [
      "Che vista mozzafiato dalla terrazza panoramica... E che esperienza nel piatto! \r\nIl GCC attira una clientela di epicurei appassionati, amanti delle specialità alpine e della calda cucina da brasserie."
    ],
    "fr": [
      "Quelle vue imprenable depuis la terrasse panoramique... et quelle expérience dans l'assiette ! Le GCC attire une clientèle d'épicuriens passionnés, amateurs de spécialités alpines et de cuisine de brasserie chaleureuse."
    ],
    "nl": [
      "Wat een uitzicht vanaf het panoramaterras... en wat een ervaring op het bord! De GCC trekt een enthousiaste klantenkring van levensgenieters, liefhebbers van alpiene specialiteiten en de warme brasseriekeuken."
    ],
    "es": [
      "Qué vista desde la terraza panorámica... ¡y qué experiencia en el plato! El CCG atrae a una clientela entusiasta de epicúreos, amantes de las especialidades alpinas y de la cálida cocina de brasserie."
    ]
  },
  "rdfs:label": {
    "en": [
      "Le GCC (Le Grand Cocor)"
    ],
    "it": [
      "Le GCC (Le Grand Cocor)"
    ],
    "fr": [
