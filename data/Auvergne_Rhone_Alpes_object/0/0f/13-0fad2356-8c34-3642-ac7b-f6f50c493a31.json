  "rdfs:comment": {
    "de": [
      "Von der Entdeckung des Reitens bis zur Perfektionierung. Reitschule auf Pferden und Ponys, Ausritte, Praktika, Ponytaufen, Pferdepension. Ethologisches Reiten: Praktikum, Prüfung der Kenntnisse von 1 bis 5."
    ],
    "en": [
      "From beginners to advanced riding levels, this riding school offers trekking, courses, first time rides as well as a livery service."
    ],
    "it": [
      "Dalla scoperta dell'equitazione al suo perfezionamento. Scuola di equitazione e pony, passeggiate, corsi, battesimi di pony, pensione per cavalli. Equitazione etologica: corsi, trasferimento di conoscenze da 1 a 5."
    ],
    "fr": [
      "De la découverte de l’équitation au perfectionnement. Ecole d’équitation sur cheval et poney, promenades, stages, baptême poney, pension chevaux. Equitation éthologique : stage, passage des savoirs de 1 à 5."
    ],
    "nl": [
      "Van ontdekken tot perfectioneren. Manege voor paarden en pony's, ritten, cursussen, dopen van pony's, paardenpension. Ethologisch paardrijden: cursussen, kennisoverdracht van 1 tot 5."
    ],
    "es": [
      "Desde descubrir la equitación hasta perfeccionarla. Picadero de caballos y ponis, paseos, cursos, bautizos de ponis, pupilaje de caballos. Equitación etológica: cursos, transmisión de conocimientos de 1 a 5."
    ]
  },
