  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/1b2f5e56-0f8f-3ac8-8c8c-3e5acefae739",
      "dc:description": {
        "de": [
          "Feine Lebensmittel - CAVE - GASTRONOMISCHE KORBE - Salzige Lebensmittel: Gewürze, Chutneys, Öle, Essig, Senf, Stopfleber, feine Konserven, regionale Gastronomie. - Süße Lebensmittel: Kekse, Schokolade, Dragees, Konfitüren, Tees, Fruchtsäfte, Kräutertees, Honig, Sirup.- Der Weinkeller: Weine, Biere, Liköre, Champagner, Cremes, Cognac, Calvados, Armagnac, Aperitifs, Rum, Portwein, Branntwein, Whisky.- Zusammenstellung von Gastronomiekörben.- Weine für Empfänge. Weinpakete für Unternehmen. Gekühlte Weine."
        ],
        "en": [
          "FINE GROCERIES - CELLAR - GASTRONOMIC BASKETS - Savoury: Spices, Chutneys, Oils, Vinegars, Mustards, Foie gras, Fine preserves, Regional gastronomy. - Sweet grocery: Biscuits, Chocolates, Sugared almonds, Jams, Teas, Fruit juices, Infusions, Honey, Syrup.- Cellar: Wines, Beers, Liqueurs, Champagne, Creams, Cognac, Calvados, Armagnac, Aperitifs, Rums, Ports, Eaux de Vie, Whisky.- Composition of Gastronomic Baskets.- Wines for receptions. Company parcels. Chilled wines."
        ],
        "it": [
          "GROCERIE FINI - CANTINE - CESTINI GASTRONOMICI - Salato: Spezie, Chutney, Oli, Aceti, Mostarde, Foie gras, Conserve fini, Gastronomia regionale. - Drogheria dolce: Biscotti, Cioccolatini, Confetti, Marmellate, Tè, Succhi di frutta, Infusi, Miele, Sciroppo - Cantina: Vini, Birre, Liquori, Champagne, Creme, Cognac, Calvados, Armagnac, Aperitivi, Rum, Porto, Eaux de Vie, Whisky - Composizione di cesti gastronomici - Vini per ricevimenti. Pacchi aziendali. Vini refrigerati."
        ],
        "fr": [
          "EPICERIE FINE - CAVE - PANIERS GASTRONOMIQUES - Epicerie Salée : Epices, Chutneys, Huiles, Vinaigres, Moutardes, Foie gras, Conserves fines, Gastronomie régionale. - Epicerie Sucrée : Biscuits, Chocolats, Dragées, Confitures, Thés, Jus de Fruits, Infusions, Miel, Sirop.- La Cave : Vins, Bières, Liqueurs, Champagne, Crèmes, Cognac, Calvados, Armagnac, Apéritifs, Rhums, Portos, Eaux de Vie, Whisky.- Composition de Paniers Gastronomiques.- Vins pour réception. Colis d'entreprises. Vins au Frais."
        ],
        "nl": [
          "FINE GROCERIES - KELDER - GASTRONOMISCHE MANDELEN - Hartig: Specerijen, Chutneys, Oliën, Azijn, Mosterd, Foie gras, Fijne conserven, Regionale gastronomie. - Zoete kruidenierswaren: Koekjes, bonbons, gesuikerde amandelen, jam, thee, vruchtensap, kruidenthee, honing, siroop - Kelder: Wijnen, bieren, likeuren, champagne, crèmes, cognac, calvados, armagnac, aperitieven, rum, ports, eau de vie, whisky - Samenstelling van gastronomische manden - Wijnen voor recepties. Bedrijfspakketten. Gekoelde wijnen."
        ],
        "es": [
          "FINE GROCERIES - CELLAR - GASTRONOMIC BASKETS - Savoury: Especias, Chutneys, Aceites, Vinagres, Mostazas, Foie gras, Conservas finas, Gastronomía regional. - Comestibles dulces: Galletas, Chocolates, Almendras azucaradas, Mermeladas, Tés, Zumos de frutas, Infusiones, Miel, Almíbar - Bodega: Vinos, Cervezas, Licores, Champagne, Cremas, Coñac, Calvados, Armagnac, Aperitivos, Rones, Puertos, Brandies, Whisky - Composición de Cestas Gastronómicas - Vinos para recepciones. Paquetes de empresa. Vinos refrigerados."
        ]
      },
