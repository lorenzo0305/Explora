  "rdfs:comment": {
    "de": [
      "Das Atelier Mosaïque Chante Pierre erstellt Wandmosaike (Bilder) in flacher oder reliefartiger Form, Skulpturen für den Innen- und Außenbereich. Sowie dekorative Gebrauchsgegenstände. Unter der Leitung von Frau Desbouit Magali."
    ],
    "en": [
      "Mosaic workshops and sales. Adult and children's classes from age 8. Has been practicing mosaic since 1999 and teaching since 2004."
    ],
    "it": [
      "L'Atelier Mosaïque Chante Pierre crea mosaici murali (dipinti), piani o in rilievo, e sculture per interni o esterni. Oltre a oggetti decorativi utilitari. Sotto la direzione di Mme Desbouit Magali."
    ],
    "fr": [
      "L'Atelier Mosaïque Chante Pierre crée des mosaïques murales (tableaux) à plat ou en relief, des sculptures intérieures ou extérieures. Ainsi que des objets décoratifs utilitaires. Sous la direction de Mme Desbouit Magali."
    ],
    "nl": [
      "Mozaïekworkshops en verkoop. Lessen voor volwassenen en kinderen vanaf 8 jaar. Maakt mozaïek sinds 1999 en geeft er les in sinds 2004."
    ],
    "es": [
      "El Atelier Mosaïque Chante Pierre crea mosaicos murales (pinturas), planos o en relieve, y esculturas de interior o exterior. Así como objetos decorativos utilitarios. Bajo la dirección de Mme Desbouit Magali."
    ]
  },
