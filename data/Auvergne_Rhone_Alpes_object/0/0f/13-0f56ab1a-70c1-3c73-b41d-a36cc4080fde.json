  "rdfs:comment": {
    "de": [
      "Die Kirche von Colamine steht einsam inmitten von Feldern am Rande einer Schlucht mit Blick auf das Lembron-Tal und ist ein typisches Beispiel für die romanische Kunst in der Auvergne. Kostenlose Führungen (einzeln oder in Gruppen) nach vorheriger Anmeldung."
    ],
    "en": [
      "It is a modest but typical example of the Romanesque art. This original church, with a square bell tower, is covered with corbelled vaulting. Isolated at the centre of the cemetery, it is the vestige of the initial core of the village of Vodable and has interesting statuary."
    ],
    "it": [
      "Situata in mezzo ai campi, ai margini di una combe che domina la valle del Lembron, la chiesa di Colamine è un tipico esempio di arte romanica alverniate. Visite guidate gratuite (individuali o di gruppo) su prenotazione."
    ],
    "fr": [
      "Solitaire au milieu des champs, sur le rebord d’une combe dominant la vallée du Lembron, l’église de Colamine est un exemple typique de l’Art Roman Auvergnat. Visites guidées gratuites (individuelles ou en groupe) sur réservation."
    ],
    "es": [
      "La iglesia de Colamine, aislada en medio de los campos, al borde de una combe que domina el valle del Lembron, es un ejemplo típico del arte románico de Auvernia. Visitas guiadas gratuitas (individuales o en grupo) con cita previa."
    ],
    "nl": [
      "De kerk van Colamine staat alleen in het midden van de velden, aan de rand van een combe die uitkijkt over de vallei van Lembron. Het is een typisch voorbeeld van Romaanse kunst uit de Auvergne. Gratis rondleidingen (individueel of in groep) op afspraak."
    ]
  },
  "rdfs:label": {
    "en": [
      "The Church Saint-Mary"
    ],
    "fr": [
      "Église Saint-Mary de Colamine-sous-Vodable"
    ]
  },
