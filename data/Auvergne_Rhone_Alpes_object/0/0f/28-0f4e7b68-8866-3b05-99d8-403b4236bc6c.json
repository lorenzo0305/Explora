  "rdfs:comment": {
    "de": [
      "Sie mögen Kresse als Salat oder Suppe, dann holen Sie sie im Lebensmittelgeschäft Roussel ab - sie wird vom Erzeuger direkt verkauft"
    ],
    "en": [
      "You like watercress in salad, in soup, come and get it at the Roussel grocery store - it is sold by the live producer"
    ],
    "it": [
      "Se vi piace il crescione nelle insalate o nelle zuppe, venite a prenderlo al negozio di alimentari Roussel: è venduto direttamente dal produttore"
    ],
    "fr": [
      "Vous aimez le cresson en salade, en soupe, venez le chercher à l'épicerie Roussel - il est vendu par le producteur en direct"
    ],
    "es": [
      "Si le gustan los berros en ensalada o en sopa, venga a buscarlos a la tienda de comestibles Roussel: los vende directamente el productor"
    ],
    "nl": [
      "Als u van waterkers houdt in salades of soepen, kom het dan halen in de kruidenierswinkel van Roussel - het wordt rechtstreeks door de producent verkocht"
    ]
  },
