  "rdfs:comment": {
    "de": [
      "Als Kunsthandwerkerin und Juwelierin ist Mademoiselle SF Schöpferin der Poesie der Seele. Sie entwirft maßgeschneiderte und personalisierte Schmuckstücke aus Edelmetallen, die von der Natur, der Fauna und Flora bis hin zum unendlich Kleinen inspiriert sind."
    ],
    "en": [
      "An artisan jeweler, Mademoiselle SF is a creator of the poetry of the soul, and imagines bespoke, personalized jewelry in precious metals, inspired by nature, flora and fauna down to the infinitely small."
    ],
    "it": [
      "Gioielliera artigiana, Mademoiselle SF è una creatrice della poesia dell'anima, che crea gioielli su misura e personalizzati in metalli preziosi, ispirandosi alla natura, alla flora e alla fauna fino all'infinitamente piccolo."
    ],
    "fr": [
      "Artisan d'art bijoutière joaillière, Mademoiselle SF est créatrice de la poésie de l'âme et imagine des bijoux sur-mesure et personnalisés en métaux précieux, inspirés de la nature, de la faune et de la flore jusqu'à l'infiniment petit."
    ],
    "nl": [
      "Mademoiselle SF is een ambachtelijke juwelier die poëzie van de ziel creëert. Ze creëert op maat gemaakte, gepersonaliseerde juwelen in edele metalen, geïnspireerd door de natuur, flora en fauna tot in het oneindige."
    ],
    "es": [
      "Joyera artesana, Mademoiselle SF es una creadora de la poesía del alma, que crea joyas a medida y personalizadas en metales preciosos, inspiradas en la naturaleza, la flora y la fauna hasta lo infinitamente pequeño."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Atelier de Mademoiselle SF - Artisan bijoutière joaillère"
    ]
  },
