  "rdfs:comment": {
    "de": [
      "Förderung der darstellenden Kunst und lokaler Künstler, Profis und Amateure, in einem Theater mit 49 Plätzen. Programmgestaltung von Aufführungen, Festival du Rire, Schulvorstellungen. Animation von Gruppen für Theaterkreationen. Kreation von Aufführungen."
    ],
    "en": [
      "Promote vivid show and local artists, professional and amateur, in a theater of 49 seat. Show's programme, Festival du Rire, school showing. Group animation of stage's creation. Show's creation."
    ],
    "it": [
      "Promuovere spettacoli dal vivo e artisti locali, professionisti e non, in un teatro da 49 posti. Programmazione di spettacoli, Festival du Rire, sessioni scolastiche. Animazione di gruppi di creazione teatrale. Creazione di spettacoli."
    ],
    "fr": [
      "Promouvoir le spectacle vivant et les artistes locaux, professionnels et amateurs, au sein d'un théâtre de 49 places. Programmation de spectacles, Festival du Rire, séances scolaires. Animation de groupes de création théâtrale. Création de spectacles."
    ],
    "es": [
      "Promover las actuaciones en directo y los artistas locales, tanto profesionales como aficionados, en un teatro de 49 plazas. Programación de espectáculos, Festival du Rire, sesiones escolares. Animación de grupos de creación teatral. Creación de espectáculos."
    ],
    "nl": [
      "Het promoten van live optredens en lokale artiesten, zowel professioneel als amateur, in een theater met 49 plaatsen. Programmering van voorstellingen, Festival du Rire, schoolsessies. Animatie van theatrale creatiegroepen. Creatie van shows."
    ]
  },
