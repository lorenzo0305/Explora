  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/31b6da70-ec89-32ef-a852-7bb39b974d10",
      "dc:description": {
        "de": [
          "Samstag, 8. und Sonntag, 9. Juli\n\nCoupe de Frande de Cardiogoal (Französischer Kardiogoal-Pokal)\n\nOrganisiert von der Ligue Française de Cardiogoal im Chaudron ab 10 Uhr\nBreakdance-Show, 3D-Mapping, Pyrotechnik. Der Eintritt ist frei.\nInformationen unter www.cardiogoal.fr oder scannen Sie den QR-Code."
        ],
        "en": [
          "Saturday 8th and Sunday 9th July\n\nCoupe de Frande de Cardiogoal\n\nOrganized by the Ligue Française de Cardiogoal at Le Chaudron from 10 a.m\nBreakdance show, 3D mapping, pyrotechnics. Free admission.\nInformation at www.cardiogoal.fr or scan the QR Code."
        ],
        "it": [
          "Sabato 8 e domenica 9 luglio\n\nCoppa di Francia Cardiogoal\n\nOrganizzata dalla Ligue Française de Cardiogoal presso Le Chaudron dalle ore 10.00\nSpettacolo di breakdance, mapping 3D, spettacoli pirotecnici. Ingresso libero.\nInformazioni su www.cardiogoal.fr o scansione del QR Code."
        ],
        "fr": [
          "Samedi 8 et dimanche 9 juillet\n\nCoupe de Frande de Cardiogoal\n\nOrganisée par la Ligue Française de Cardiogoal au Chaudron dès 10h\nShow de breakdance, 3D mapping, pyrotechnie. Entrée gratuite.\nRenseignements sur www.cardiogoal.fr ou scannez le QR Code."
        ],
        "nl": [
          "Zaterdag 8 en zondag 9 juli\n\nFranse Cardiogoal Beker\n\nGeorganiseerd door de Ligue Française de Cardiogoal in Le Chaudron vanaf 10 uur\nBreakdance show, 3D mapping, vuurwerk. Gratis toegang.\nInformatie op www.cardiogoal.fr of scan de QR-code."
        ],
        "es": [
          "Sábado 8 y domingo 9 de julio\n\nCopa de Francia Cardiogoal\n\nOrganizada por la Ligue Française de Cardiogoal en Le Chaudron a partir de las 10 h\nEspectáculo de breakdance, mapping 3D, pirotecnia. Entrada gratuita.\nInformación en www.cardiogoal.fr o escanee el código QR."
        ]
      },
