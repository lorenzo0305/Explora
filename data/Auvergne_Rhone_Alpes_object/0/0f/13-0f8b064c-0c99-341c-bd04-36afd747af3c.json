  "rdfs:comment": {
    "de": [
      "Bresse-Geflügel (küchenfertig oder zerfasert) jede Woche auf dem Bauernhof und auf den Märkten. Poularde am Ende des Jahres für die Feiertage. Frische Eier von weißen gallischen Freilandhühnern"
    ],
    "en": [
      "Bresse poultry (ready-to-cook or shredded) every week on the farm and at markets. Poularde at the end of the year for the festive season. Fresh eggs from free-range white Gallic hens."
    ],
    "it": [
      "Pollame di Bresse (pronto per la cottura o tritato) ogni settimana in fattoria e sui mercati. Poularde alla fine dell'anno per le vacanze. Uova fresche di galline galliche allevate all'aperto"
    ],
    "fr": [
      "Volaille de Bresse (prête à cuire ou effilée) chaque semaine à la ferme et sur les marchés. Poularde en fin d'année pour les fêtes. Oeufs frais des poules gauloises blanches en plein air"
    ],
    "nl": [
      "Bresse gevogelte (klaar om te koken of versnipperd) elke week op de boerderij en op de markten. Poularde aan het eind van het jaar voor de feestdagen. Verse eieren van Gallische kippen met vrije uitloop"
    ],
    "es": [
      "Aves de corral de Bresse (listas para cocinar o desmenuzadas) cada semana en la granja y en los mercados. Poularde a finales de año para las vacaciones. Huevos frescos de gallinas galas criadas en libertad"
    ]
  },
