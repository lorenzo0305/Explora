  "rdfs:comment": {
    "de": [
      "Jacques Mansuy zeigt uns die Kollisionen, die entstehen, wenn sich zwei Bilder zufällig in seinen Fotomontagen begegnen. Unwahrscheinliche Dialoge, wie Brücken zwischen Universen, denen auf den ersten Blick alles entgegensteht...\r\nEröffnung am 13.03. um 18 Uhr."
    ],
    "en": [
      "Jacques Mansuy shows us the collisions that occur when two images meet in his photographic montages. Improbable dialogues, like bridges between universes that, on the face of it, are opposed...\r\nOpening on 13/03 at 6pm."
    ],
    "it": [
      "Jacques Mansuy ci mostra le collisioni che avvengono quando due immagini si incontrano nei suoi montaggi fotografici. Dialoghi improbabili, come ponti tra universi che si oppongono a prima vista...\r\nInaugurazione il 13/03 alle 18.00."
    ],
    "fr": [
      "Jacques Mansuy nous donne à voir les collisions qui se créent quand deux images se rencontrent au hasard de ses montages photographiques. Des dialogues improbables, comme des ponts entre des univers que tout oppose à priori...\r\nInauguration le 13/03 à 18h."
    ],
    "nl": [
      "Jacques Mansuy toont ons de botsingen die ontstaan wanneer twee beelden elkaar ontmoeten in zijn fotografische montages. Onwaarschijnlijke dialogen, als bruggen tussen universums die alles op het eerste gezicht tegenspreken...\r\nOpening op 13/03 om 18u."
    ],
    "es": [
      "Jacques Mansuy nos muestra las colisiones que se producen cuando dos imágenes se encuentran en sus montajes fotográficos. Diálogos improbables, como puentes entre universos a los que todo se opone a primera vista...\r\nInauguración el 13/03 a las 18h."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Exposition : Voyage en photographie"
    ]
  },
