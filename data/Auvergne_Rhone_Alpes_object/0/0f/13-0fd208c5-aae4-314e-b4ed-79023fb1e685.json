  "rdfs:comment": {
    "de": [
      "Das im Herzen des Dorfes Vourles gelegene Restaurant Goût?T klingt wie eine Sehnsucht nach der Kindheit und dem wiedergefundenen Geschmack guter Dinge. Julie und Bénédicte bieten Ihnen traditionelle Gerichte aus frischen und lokalen Produkten an."
    ],
    "en": [
      "Set in the heart of the village of Vourles, the Goût?T restaurant sounds like a nostalgia for childhood and a rediscovered taste for good things. Julie and Bénédicte offer traditional fare based on fresh local produce."
    ],
    "it": [
      "Situato nel cuore del villaggio di Vourles, il ristorante Goût?T suona come una nostalgia dell'infanzia e un gusto ritrovato per le cose buone. Julie e Bénédicte propongono un menu tradizionale a base di prodotti freschi e locali."
    ],
    "fr": [
      "Installé au cœur du village de Vourles, le restaurant Goût’T sonne comme une nostalgie à l’enfance et au goût retrouvé des bonnes choses. Julie et Bénédicte vous proposent une restauration traditionnelle faite de produits frais et locaux."
    ],
    "es": [
      "Situado en el corazón del pueblo de Vourles, el restaurante Goût'T suena a nostalgia de la infancia y a redescubrimiento del gusto por las cosas buenas. Julie y Bénédicte proponen un menú tradicional a base de productos frescos y locales."
    ],
    "nl": [
      "Het restaurant Goût?T ligt in het hart van het dorp Vourles en klinkt als een nostalgie naar de kindertijd en een herontdekte smaak voor goede dingen. Julie en Bénédicte bieden een traditioneel menu op basis van verse, lokale producten."
    ]
  },
