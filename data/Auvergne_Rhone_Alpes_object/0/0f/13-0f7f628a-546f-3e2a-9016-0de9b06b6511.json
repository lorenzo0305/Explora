  "rdfs:comment": {
    "de": [
      "Seit 2019 in Le Percy in Mischkultur mit Viehzucht und biologischer Landwirtschaft niedergelassen. La Ferme Sauvageonne bietet Ihnen ?eier, Hanfprodukte (cbd) und Nebenprodukte aus Obst an."
    ],
    "en": [
      "Established in polyculture-livestock, organic farming, since 2019 in Le Percy. La Ferme Sauvageonne offers eggs, hemp-based products (cbd) and fruit-based by-products."
    ],
    "it": [
      "Azienda agricola mista, biologica, dal 2019 a Le Percy. La Ferme Sauvageonne offre uova, prodotti a base di canapa (cbd) e sottoprodotti a base di frutta."
    ],
    "fr": [
      "Installé en polyculture-élevage, en agriculture biologique, depuis 2019 au Percy. La Ferme Sauvageonne vous propose des œufs, des produits à base de chanvre (cbd) et des produits dérivés à base de fruits."
    ],
    "nl": [
      "Gevestigd in gemengd bedrijf, biologisch bedrijf, sinds 2019 in Le Percy. La Ferme Sauvageonne biedt eieren, producten op basis van hennep (cbd) en bijproducten op basis van fruit."
    ],
    "es": [
      "Establecida en agricultura mixta, agricultura ecológica, desde 2019 en Le Percy. La Ferme Sauvageonne ofrece huevos, productos a base de cáñamo (cbd) y subproductos a base de frutas."
    ]
  },
  "rdfs:label": {
