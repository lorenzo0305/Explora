  "rdfs:comment": {
    "de": [
      "Dieser 4 ha große Teich liegt im Herzen der Stadt Pont de Vaux, am Ufer des Flusses Reyssouze. Er bietet schöne Möglichkeiten für Angeltouren mit der Familie oder mit Freunden. Hechte, Blackbass, Zander, Karpfen und andere Fische bevölkern den Teich."
    ],
    "en": [
      "This 4 ha pond is located in the heart of the town of Pont de Vaux, on the banks of the Reyssouze. It offers excellent facilities for fishing with family or friends. Pike, black bass, pike-perch, carp and other fish populate the pond."
    ],
    "it": [
      "Questo stagno di 4 ettari si trova nel cuore della città di Pont de Vaux, sulle rive della Reyssouze. Offre ottime strutture per la pesca in famiglia o con gli amici. Nel laghetto si trovano lucci, black-bass, luccioperca, carpe e altri pesci."
    ],
    "fr": [
      "Cet étang de 4 ha est situé au cœur de la ville de Pont de Vaux, en bordure de la Reyssouze. Il offre de belles prestations pour des parties de pêche en famille ou entre amis. Brochets, black-bass, sandres, carpes et poissons peuplent l'étang."
    ],
    "es": [
      "Este estanque de 4 hectáreas está situado en el corazón de la ciudad de Pont de Vaux, a orillas del Reyssouze. Ofrece grandes instalaciones para pescar con la familia o los amigos. En el estanque se pueden encontrar lucios, black-bass, luciopercas, carpas y otros peces."
    ],
    "nl": [
      "Dit meer van 4 hectare ligt in het hart van de stad Pont de Vaux, aan de oever van de Reyssouze. Het biedt geweldige faciliteiten om te vissen met familie of vrienden. Snoek, zwarte baars, snoekbaars, karper en andere vissen bevolken de vijver."
    ]
  },
  "rdfs:label": {
    "en": [
      "Lake of Pont-de-Vaux"
    ],
    "fr": [
      "Etang de pêche de Pont-de-Vaux"
    ],
    "nl": [
      "Visvijver Pont-de-Vaux"
    ]
  },
