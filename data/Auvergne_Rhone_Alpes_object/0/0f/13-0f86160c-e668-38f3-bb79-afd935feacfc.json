  "rdfs:comment": {
    "de": [
      "Einzigartiges Konzept in der Ardèche, Vermietung von Vintage-Elektrofahrrädern.\r\nReichweite 90 km, mit der Sie unsere schöne Region entdecken können.\r\n3 Arten von Fahrrädern verfügbar:\r\nSodas: Bmx-Stil ab 1,45 m.\r\nOutsider: Motorrad-Stil\r\nVacay Lady: weiblicher Look"
    ],
    "en": [
      "Hire by the day to enjoy the area around Saint Martin d'Ardèche.\r\n3 types of bike available: \r\nSodas: from age 7\r\nOutsider: motorbike style\r\nVacay Lady: feminine look"
    ],
    "it": [
      "Un concetto unico nell'Ardèche, il noleggio di biciclette elettriche vintage\r\n110 km di autonomia per esplorare la zona del Vallon Pont d'Arc\r\n3 tipi di bici disponibili:\r\nSodas: stile Bmx da 1m50 in su\r\nOutsider: stile moto\r\nVacay Lady: look femminile"
    ],
    "fr": [
      "Concept unique en Ardèche, Location de vélos électriques vintage \r\nAutonomie 110km qui permet de découvrir  les alentour de Vallon Pont d'Arc\r\n3 types de vélos disponibles : \r\nSodas : style Bmx à partir de 1m50\r\nOutsider : style moto\r\nVacay Lady : look féminin"
    ],
    "nl": [
      "Een uniek concept in de Ardèche, verhuur van vintage elektrische fietsen\r\n90 km bereik om onze prachtige streek te ontdekken\r\n3 soorten fietsen beschikbaar:\r\nSodas: Bmx stijl vanaf 1,45 m\r\nOutsider: motorfiets stijl\r\nVacay Lady: vrouwelijke look"
    ],
    "es": [
      "Concepto único en Ardèche, alquiler de bicicletas eléctricas vintage\r\n110 km de autonomía para explorar los alrededores de Vallon Pont d'Arc\r\n3 tipos de bicicletas disponibles:\r\nSodas: estilo Bmx a partir de 1m50\r\nOutsider: estilo moto\r\nVacay Lady: estilo femenino"
    ]
  },
  "rdfs:label": {
