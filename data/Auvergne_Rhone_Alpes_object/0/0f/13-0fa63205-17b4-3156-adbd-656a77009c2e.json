  "rdfs:comment": {
    "de": [
      "Die GAEC Birin-Puthinier bietet Ihnen Milchprodukte (Joghurt, Butter, Tomme,...) sowie Fleischprodukte wie Hühner-Rillettes oder Lammterrine, Lamm-Rillettes."
    ],
    "en": [
      "GAEC Birin-Puthinier offers dairy products (yogurt, butter, tomme, etc.) as well as meat products such as chicken rillettes or lamb terrine, lamb rillettes."
    ],
    "it": [
      "Il GAEC Birin-Puthinier offre prodotti lattiero-caseari (yogurt, burro, tomme, ecc.) e prodotti a base di carne come rillettes di pollo o terrine di agnello, rillettes di agnello."
    ],
    "fr": [
      "La GAEC Birin-Puthinier vous propose des produits laitiers (yaourt, beurre, tomme,...)  ainsi que des produits à base de viande comme des rillettes de poulet ou de la terrine d’agneau, rillettes d’agneau."
    ],
    "es": [
      "GAEC Birin-Puthinier ofrece productos lácteos (yogur, mantequilla, tomme, etc.), así como productos cárnicos como rillettes de pollo o terrina de cordero, rillettes de cordero."
    ],
    "nl": [
      "GAEC Birin-Puthinier biedt zowel zuivelproducten (yoghurt, boter, tomme, enz.) als vleesproducten zoals kip rillettes of lam terrine, lam rillettes."
    ]
  },
