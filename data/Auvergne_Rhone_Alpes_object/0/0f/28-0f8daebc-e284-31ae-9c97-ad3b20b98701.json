      "dc:description": {
        "de": [
          "Kommen Sie und kaufen Sie Ihr rotes Obst (Erdbeeren, Himbeeren, Johannisbeeren) und Saisongemüse auf der Ferme Penon!"
        ],
        "en": [
          "Come and buy your red fruits (strawberries, raspberries, redcurrants) and seasonal vegetables at the Penon Farm!"
        ],
        "it": [
          "Venite a comprare i vostri frutti rossi (fragole, lamponi, ribes) e le verdure di stagione alla fattoria Penon!"
        ],
        "fr": [
          "Venez acheter vos fruits rouges (fraises, framboises, groseilles) et légumes de saisons à la Ferme Penon !"
        ],
        "es": [
          "Venga a comprar sus frutos rojos (fresas, frambuesas, grosellas) y verduras de temporada en la granja Penon"
        ],
        "nl": [
          "Kom uw rode vruchten (aardbeien, frambozen, rode bessen) en seizoensgroenten kopen op de Penon Farm!"
        ]
      },
