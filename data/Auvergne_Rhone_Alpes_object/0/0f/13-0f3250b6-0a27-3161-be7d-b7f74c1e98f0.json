  "rdfs:comment": {
    "de": [
      "Das Hotel Campanile Aix-les-Bains befindet sich 2 km vom Stadtzentrum entfernt und genießt eine privilegierte Lage zwischen dem Golfplatz und der Pferderennbahn. Es verfügt über klimatisierte und renovierte Zimmer. Das gesamte Team erwartet Sie für Ihren nächsten Aufenthalt."
    ],
    "en": [
      "Welcoming staff, relaxed and friendly communal areas, comfortable rooms equipped with top of the range bedding, functional bathrooms, free Wi-Fi and varied and balanced cuisine."
    ],
    "it": [
      "Personale accogliente, spazi conviviali e calorosi, camere confortevoli dotate di letti di alta gamma, bagni funzionali, accesso wifi gratuito, una cucina varia ed equilibrata."
    ],
    "fr": [
      "Localisé à 2 km du centre-ville, l'hôtel Campanile Aix-les-Bains bénéficie d'une situation géographique privilégiée entre le golf et l'hippodrome. Il dispose de chambres climatisées et rénovées. Toute l'équipe vous attend pour votre prochain séjour."
    ],
    "es": [
      "Situado a 2 km del centro de la ciudad, el hotel Campanile Aix-les-Bains goza de una ubicación privilegiada entre el campo de golf y el hipódromo. Cuenta con habitaciones renovadas y con aire acondicionado. Todo el equipo está deseando darle la bienvenida en su próxima estancia."
    ],
    "nl": [
      "Het hotel Campanile Aix-les-Bains ligt op 2 km van het stadscentrum en heeft een bevoorrechte ligging tussen de golfbaan en het circuit. Het beschikt over gerenoveerde kamers met airconditioning. Het hele team kijkt ernaar uit u te verwelkomen voor uw volgende verblijf."
    ]
  },
  "rdfs:label": {
    "en": [
      "Campanile Hotel"
    ],
