  "rdfs:comment": {
    "de": [
      "Unabhängiger Skilehrer bietet privaten Skiunterricht in Chamrousse an!\nFür das Vergnügen, etwas zu entdecken oder zu verbessern, damit das Skifahren einfach Spaß macht, betreut von einem staatlich geprüften Skilehrer."
    ],
    "en": [
      "Independent ski instructor offering private ski lessons in Chamrousse!\nFor the pleasure of discovering or perfecting your technique, so that skiing is simply a pleasure, supervised by a state-certified ski instructor."
    ],
    "it": [
      "Maestro di sci indipendente che offre lezioni private di sci a Chamrousse!\r\nSia che vogliate scoprire nuove cose o migliorare le vostre capacità sciistiche, i nostri maestri di sci qualificati garantiranno che vi divertiate sulle piste."
    ],
    "fr": [
      "Moniteur indépendant proposant des cours de ski particuliers à Chamrousse !\r\nPour le plaisir de la découverte ou du perfectionnement, pour que la glisse soit tout simplement un plaisir, encadré par un moniteur de ski diplômé d'état."
    ],
    "es": [
      "¡Profesor de esquí independiente que ofrece clases particulares de esquí en Chamrousse!\r\nTanto si quieres descubrir cosas nuevas como perfeccionar tu técnica de esquí, nuestros monitores de esquí titulados por el Estado se encargarán de que te lo pases en grande en las pistas."
    ],
    "nl": [
      "Onafhankelijke skileraar die privéles geeft in Chamrousse!\r\nOf je nu nieuwe dingen wilt ontdekken of je skivaardigheden wilt verbeteren, je vindt altijd de juiste skileraar."
    ]
  },
