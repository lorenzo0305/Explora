  "rdfs:comment": {
    "de": [
      "Das permanente Trainingszentrum ist eines der höchstgelegenen in Europa. Es ist ideal gelegen und ermöglicht die Ausübung von Trainings- oder Freizeitaktivitäten unter optimalen Bedingungen. Biathlonstadion: 30 Ziele für das Schießen auf 10 m und 50 m."
    ],
    "en": [
      "The permanent training centre is one of the highest in Europe. Ideally located, it allows the practice of training or leisure activities in optimal conditions. Biathlon stadium: 30 targets for shooting at 10 m and 50 m."
    ],
    "it": [
      "Il centro di formazione permanente è uno dei più alti d'Europa. Situato in posizione ideale, offre condizioni ottimali per l'allenamento e le attività del tempo libero. Stadio del biathlon: 30 bersagli per il tiro a 10 m e 50 m."
    ],
    "fr": [
      "Le centre permanent d'entrainement est l'un des plus hauts d'Europe. Idéalement situé, il permet la pratique des activités d'entrainement ou de loisirs dans des conditions optimales. Stade de biathlon : 30 cibles pour la pratique du tir à 10 m et 50 m."
    ],
    "nl": [
      "Het permanente opleidingscentrum is een van de hoogste in Europa. Ideaal gelegen, maakt het mogelijk om in optimale omstandigheden trainingen of vrijetijdsactiviteiten te beoefenen. Biatlonstadion: 30 doelen voor schieten op 10 m en 50 m."
    ],
    "es": [
      "El centro de formación permanente es uno de los más altos de Europa. Idealmente situado, ofrece condiciones óptimas para el entrenamiento y las actividades de ocio. Estadio de biatlón: 30 dianas para tiro a 10 m y 50 m."
    ]
  },
  "rdfs:label": {
    "en": [
      "International Biathlon Stadium"
    ],
    "fr": [
      "Stade international de biathlon"
    ],
    "nl": [
      "Internationaal biatlonstadion"
    ]
  },
