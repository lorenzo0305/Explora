  "rdfs:comment": {
    "de": [
      "Produkte des Bauernhofs: Öl und Oliven AOP aus Nyons, Tapenade, Olivenpaste, Fruchtnektar, Konfitüren, Sommerobst und -gemüse, Lindenblüten, Lamm (ausschließlich auf Bestellung) sowie regionale Produkte: Ziegenkäse, Honig, Wein..."
    ],
    "en": [
      "Farm products: olives and olive oil, tapenade, fruit juice, jam, fruits and vegetables, lime, lamb (to order only), local produces: goat cheese, honey, wine..."
    ],
    "it": [
      "Prodotti della fattoria: olio e olive DOP di Nyons, tapenade, pasta di olive, nettari di frutta, marmellate, frutta e verdura estiva, fiori di tiglio, agnello (solo su ordinazione) e prodotti locali: formaggio di capra, miele, vino..."
    ],
    "fr": [
      "Produits de la Ferme : huile et olives AOP de Nyons, tapenade, pâte d'olive, nectars de fruits, confitures, fruits et légumes d'été, tilleul, agneau (sur commande exclusivement), et produits du terroir : fromage de chèvre, miel, vin..."
    ],
    "es": [
      "Productos de la granja: aceite y aceitunas DOP de Nyons, tapenade, pasta de aceitunas, néctares de frutas, mermeladas, frutas y verduras de verano, tila, cordero (sólo por encargo), y productos locales: queso de cabra, miel, vino..."
    ],
    "nl": [
      "Bij de boerderij. Streekproducten en directe verkoop: olie en olijven AOP Nyons BIO, olijvenpasta en -tapenade BIO, abrikozenjam en -pasta, nectar, fruit (zomer). Schapenkuddes (lam). Boerderij-herberg en gîtes."
    ]
  },
  "rdfs:label": {
