  "rdfs:comment": {
    "de": [
      "Das im Laufe der Jahrhunderte errichtete und im 15. Jahrhundert von Ludwig II. von Bourbon und seinen Söhnen vollendete Schloss der Herzöge von Bourbon überragt Montluçon wie ein Symbol seiner Geschichte."
    ],
    "en": [
      "Built over the centuries and completed in the 15th century by Louis II de Bourbon and his sons, the Château des Ducs de Bourbon dominates Montluçon as a symbol of its history."
    ],
    "it": [
      "Costruito nel corso dei secoli e completato nel XV secolo da Luigi II di Borbone e dai suoi figli, il Castello dei Duchi di Borbone domina Montluçon come simbolo della sua storia."
    ],
    "fr": [
      "Édifié au fil des siècles et achevé au XVe siècle par Louis II de Bourbon et ses fils, le Château des ducs de Bourbon domine Montluçon comme un symbole de son histoire."
    ],
    "nl": [
      "Het Château des Ducs de Bourbon, door de eeuwen heen gebouwd en in de 15e eeuw voltooid door Lodewijk II van Bourbon en zijn zonen, domineert Montluçon als symbool van zijn geschiedenis."
    ],
    "es": [
      "Construido a lo largo de los siglos y terminado en el siglo XV por Luis II de Borbón y sus hijos, el castillo de los Duques de Borbón domina Montluçon como símbolo de su historia."
    ]
  },
  "rdfs:label": {
