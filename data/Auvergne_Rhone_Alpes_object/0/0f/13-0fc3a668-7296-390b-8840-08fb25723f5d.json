  "rdfs:comment": {
    "de": [
      "Emmanuel Herbulot ist ein 1950 geborener bildender Künstler, der an der Ecole nationale supérieure des beaux-arts in Paris und am Institut d'histoire de l'art in Lyon studiert hat. Er lebt und arbeitet seit 2015 in Charlieu.\r\nBesichtigung des Ateliers nach Vereinbarung."
    ],
    "en": [
      "Emmanuel Herbulot is a visual artist born in 1950, a graduate of the Ecole nationale supérieure des beaux-arts in Paris and the Institut d'histoire de l'art in Lyon. He has lived and worked in Charlieu since 2015.\r\nStudio visit by appointment."
    ],
    "it": [
      "Emmanuel Herbulot è un artista visivo nato nel 1950, diplomato all'Ecole nationale supérieure des beaux-arts di Parigi e all'Institut d'histoire de l'art di Lione. Dal 2015 vive e lavora a Charlieu.\r\nVisita allo studio su appuntamento."
    ],
    "fr": [
      "Emmanuel Herbulot est un plasticien né en 1950, diplômé de l'Ecole nationale supérieure des beaux-arts de Paris et de l'Institut d'histoire de l'art à Lyon. Il vit et travaille à Charlieu depuis 2015. \r\nVisite de l'atelier sur rendez-vous."
    ],
    "nl": [
      "Emmanuel Herbulot is een beeldend kunstenaar geboren in 1950 en afgestudeerd aan de Ecole nationale supérieure des beaux-arts in Parijs en het Institut d'histoire de l'art in Lyon. Sinds 2015 woont en werkt hij in Charlieu.\r\nBezoek de studio op afspraak."
    ],
    "es": [
      "Emmanuel Herbulot es un artista visual nacido en 1950 y graduado por la Escuela Nacional Superior de Bellas Artes de París y el Instituto de Historia del Arte de Lyon. Vive y trabaja en Charlieu desde 2015.\r\nVisita el estudio con cita previa."
    ]
  },
