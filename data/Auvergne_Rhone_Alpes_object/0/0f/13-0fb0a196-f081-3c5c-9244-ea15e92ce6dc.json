  "rdfs:comment": {
    "de": [
      "Dieses Café/Bar/Restaurant am Eingang der mittelalterlichen Stadt Ainay le Château bietet Ihnen unter der Woche mittags ein Arbeitermenü und eine schattige Terrasse zum Mittagessen."
    ],
    "en": [
      "At the entrance to the medieval town of Ainay le Château, this café/bar/restaurant offers \"ouvrier\" menus at lunchtime on weekdays, with a pleasant shaded terrace for lunch."
    ],
    "it": [
      "All'ingresso della città medievale di Ainay-le-Château, questo caffè/bar/ristorante offre menu \"ouvrier\" a pranzo nei giorni feriali, con una piacevole terrazza ombreggiata per il pranzo."
    ],
    "fr": [
      "À l'entrée de la cité médiévale d'Ainay le Château, ce café/Bar/Restaurant vous propose des menus “ouvrier” le midi en semaine; avec une agréable terrasse ombragée pour déjeuner."
    ],
    "nl": [
      "Bij de ingang van de middeleeuwse stad Ainay-le-Château biedt dit café/bar/restaurant 'ouvrier'-menu's tijdens de lunch op doordeweekse dagen, met een aangenaam schaduwrijk terras voor de lunch."
    ],
    "es": [
      "A la entrada de la ciudad medieval de Ainay-le-Château, este café/bar/restaurante ofrece menús \"ouvrier\" al mediodía los días laborables, con una agradable terraza a la sombra para comer."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant Les Trois Marches d'Ainay"
    ]
  },
