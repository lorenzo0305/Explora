  "rdfs:comment": {
    "de": [
      "Kommen Sie und verbringen Sie eine schöne Zeit in einer angenehmen und gemütlichen Umgebung. Entdecken Sie eine Küche, die von einem Chef mit frischen Produkten zubereitet wird, jeden Mittag außer sonntags! Handgemachtes Eis im Sommer."
    ],
    "en": [
      "Come and enjoy a good time in a friendly and welcoming setting. Discover cuisine prepared by a chef with fresh ingredients every day at lunchtime except Sunday! Homemade ice cream in the summer."
    ],
    "it": [
      "Venite a divertirvi in un'atmosfera calda e amichevole. Scoprite una cucina preparata da uno chef con prodotti freschi tutti i giorni tranne la domenica! Gelati artigianali in estate."
    ],
    "fr": [
      "Venez passer un bon moment dans un cadre sympathique et chaleureux. Découvrez une cuisine préparée par un chef avec des produits frais tous les midis sauf le dimanche ! Glaces artisanales en été."
    ],
    "es": [
      "Venga a pasar un buen rato en un ambiente cálido y agradable. Descubra una cocina preparada por un chef con productos frescos todos los días excepto el domingo Helados caseros en verano."
    ],
    "nl": [
      "Kom en heb een leuke tijd in een warme en vriendelijke sfeer. Ontdek een keuken bereid door een chef-kok met verse producten elke middag behalve zondag! Zelfgemaakt ijs in de zomer."
    ]
  },
