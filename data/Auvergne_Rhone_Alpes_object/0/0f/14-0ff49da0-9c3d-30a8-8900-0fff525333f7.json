      "dc:description": {
        "de": [
          "Informationen :\n \nÖffnungstage:\n\nDienstag bis Freitag: 9h - 13h / 14h30 - 18h\nSamstag: 9h - 13h\nSonntag: 9:00 - 12:00 Uhr\n\n\nAbholung :\n\nZum Mitnehmen während der Ladenöffnungszeiten\n\n\n "
        ],
        "en": [
          "Information :\n \nOpening days:\n\nTuesday to Friday: 9am - 1pm / 2:30pm - 6pm\nSaturday: 9am - 1pm\nSunday: 9am - 12pm\n\n\nCollection:\n\nTakeaway during store opening hours\n\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n \nGiorni di apertura:\n\nDal martedì al venerdì: 9.00-13.00 / 14.30-18.00\nSabato: dalle 9.00 alle 13.00\nDomenica: 9.00 - 12.00\n\n\nRitiro:\n\nDa asporto durante gli orari di apertura del negozio\n\n\n "
        ],
        "fr": [
          "Informations :\n \nJours d'ouverture:\n\nDu mardi au vendredi : 9h - 13h / 14h30 - 18h\nLe samedi : 9h - 13h\nLe dimanche : 9h - 12h\n\n\nRetrait :\n\nÀ emporter aux horaires d'ouverture du magasin\n\n\n "
        ],
        "nl": [
          "Meer informatie :\n \nOpeningsdagen:\n\nDinsdag tot vrijdag: 9u - 13u / 14u30 - 18u\nZaterdag: 9 - 13u\nZondag: 9.00 - 12.00\n\n\nOphalen:\n\nAfhalen tijdens openingstijden van de winkel\n\n\n "
        ],
        "es": [
          "Más información :\n \nDías de apertura:\n\nDe martes a viernes: de 9.00 a 13.00 h. / de 14.30 a 18.00 h\nSábado: de 9.00 h. a 13.00 h\nDomingo: de 9.00 a 12.00 horas\n\n\nRecogida:\n\nPara llevar durante el horario de apertura de la tienda\n\n\n "
        ]
      },
