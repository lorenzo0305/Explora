  "rdfs:comment": {
    "de": [
      "Auf dem Place de l'Hôtel de Ville kann man unter den Arkaden in die Welt der Kunstdruckereien eintauchen\r\nEstampille sérigraphie ist ein Showroom, in dem 350 zeitgenössische Drucke ausgestellt werden."
    ],
    "en": [
      "Estampille is a large Showroom/Gallery of prints in serigraphy, etching and lithography. It's also an art publishing workshop equipped with printing presses. Right in the heart of the city, Estampille offers you a luminous and creative stroll."
    ],
    "it": [
      "In Place de l'Hôtel de Ville, passeggiate sotto i portici ed entrate nel mondo delle stampanti d'arte..\r\nEstampille sérigraphie è uno showroom che espone 350 stampe contemporanee."
    ],
    "fr": [
      "Place de l’Hôtel de ville, on se faufile sous les arcades et on entre dans l’univers des imprimeurs d’art.  \r\nEstampille sérigraphie est un show-room qui présente 350 estampes contemporaines."
    ],
    "nl": [
      "Wandel op de Place de l'Hôtel de Ville onder de arcades en betreed de wereld van de kunstdrukkers..\r\nEstampille sérigraphie is een showroom met 350 hedendaagse prenten."
    ],
    "es": [
      "En la Place de l'Hôtel de Ville, pasee bajo los soportales y entre en el mundo de las imprentas de arte..\r\nEstampille sérigraphie es una sala de exposiciones con 350 grabados contemporáneos."
    ]
  },
  "rdfs:label": {
    "en": [
      "Showroom Estampille Art screen printing"
    ],
    "fr": [
      "Showroom Estampille Sérigraphie d'art"
    ]
  },
